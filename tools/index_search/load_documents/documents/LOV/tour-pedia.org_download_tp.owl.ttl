@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://www.w3.org/2006/vcard/ns#> .
@prefix onto: <http://tour-pedia.org/download/tp.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<http://dbpedia.org/ontology/address> a owl:DatatypeProperty ;
    rdfs:domain <http://tour-pedia.org/download/tp.owl#Place> .

<http://dbpedia.org/ontology/location> a owl:ObjectProperty ;
    rdfs:domain <http://tour-pedia.org/download/tp.owl#Place> .

<http://dbpedia.org/ontology/wikiPageExternalLink> a owl:ObjectProperty ;
    rdfs:domain <http://tour-pedia.org/download/tp.owl#Place> .

<http://purl.org/acco/ns#Accommodation> owl:equivalentClass <http://tour-pedia.org/download/tp.owl#Accommodation> .

<http://purl.org/marl/0.2/ns#hasPolarity> a owl:ObjectProperty ;
    rdfs:domain prov:Entity .

<http://schema.org/CivicStructure> owl:equivalentClass <http://tour-pedia.org/download/tp.owl#POI> .

<http://schema.org/LodgingBusiness> owl:equivalentClass <http://tour-pedia.org/download/tp.owl#Accommodation> .

<http://schema.org/Restaurant> owl:equivalentClass <http://tour-pedia.org/download/tp.owl#Restaurant> .

<http://schema.org/TouristAttraction> a owl:Class ;
    owl:equivalentClass <http://tour-pedia.org/download/tp.owl#Attraction> .

<http://schema.org/sameAs> rdfs:domain <http://tour-pedia.org/download/tp.owl#Place> .

onto: a owl:Ontology ;
    rdfs:label "Tourpedia Ontology" ;
    dc:creator "Angelica Lo Duca" ;
    dc:title "Tourpedia Ontology" ;
    dcterms:description "A vocabulary to describe touristic places: accommodations, points of interest, restaurants and attractions." ;
    dcterms:issued "2014-06-08" ;
    dcterms:license "http://creativecommons.org/licenses/by/1.0/" ;
    dcterms:modified "2015-06-08" ;
    dcterms:rights "Copyright Â© 2015 Tourpedia" ;
    vann:preferredNamespacePrefix "tp" ;
    rdfs:comment "A vocabulary to describe touristic places: accommodations, points of interest, restaurants and attractions." ;
    rdfs:isDefinedBy "http://tour-pedia.org/download/tp.owl" ;
    owl:imports <http://purl.org/acco/ns#>,
        <http://purl.org/vocommons/voaf>,
        <http://schema.rdfs.org/all>,
        <http://www.semanticweb.org/ontologies/2012/4/accommodation-17042012.owl>,
        prov: ;
    owl:versionInfo "1.0" ;
    ns1:term_status "testing" .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty ;
    rdfs:domain <http://tour-pedia.org/download/tp.owl#Place> .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a owl:DatatypeProperty ;
    rdfs:domain <http://tour-pedia.org/download/tp.owl#Place> .

skos:related a owl:ObjectProperty ;
    rdfs:domain <http://tour-pedia.org/download/tp.owl#Accommodation> .

ns2:fn a owl:DatatypeProperty ;
    rdfs:domain <http://tour-pedia.org/download/tp.owl#Place> .

ns2:hasPhoto a owl:DatatypeProperty ;
    rdfs:domain <http://tour-pedia.org/download/tp.owl#Place> .

ns2:hasTelephone a owl:DatatypeProperty ;
    rdfs:domain <http://tour-pedia.org/download/tp.owl#Place> .

<http://tour-pedia.org/download/tp.owl#Attraction> a owl:Class ;
    rdfs:subClassOf <http://tour-pedia.org/download/tp.owl#Place> .

<http://tour-pedia.org/download/tp.owl#POI> a owl:Class ;
    rdfs:subClassOf <http://tour-pedia.org/download/tp.owl#Place> .

<http://tour-pedia.org/download/tp.owl#Restaurant> a owl:Class ;
    rdfs:subClassOf <http://tour-pedia.org/download/tp.owl#Place> .

<http://tour-pedia.org/download/tp.owl#Accommodation> a owl:Class ;
    rdfs:subClassOf <http://tour-pedia.org/download/tp.owl#Place> ;
    owl:equivalentClass <http://www.semanticweb.org/ontologies/2010/3/hotel-15072010.owl#Accommodation> .

<http://tour-pedia.org/download/tp.owl#Place> a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "The generic class for a touristic place." ;
    owl:equivalentClass prov:Entity .

[] ns2:fn "" .

