@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:subject a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://w3id.org/rv-ontology#Model> a owl:Class ;
    rdfs:subClassOf <http://purl.org/wf4ever/ro#Resource> .

foaf:homepage a owl:AnnotationProperty .

<https://w3id.org/survey-ontology#> a owl:NamedIndividual,
        owl:Ontology ;
    rdfs:label "Survey Ontology"@en ;
    dc:contributor "Work on the Survey Ontology and Coney (https://survey.actionproject.eu/coney/) was partially supported by the ACTION project (grant agreement number 824603), co-funded by the European Commission under the Horizon 2020 Framework Programme."@en ;
    dc:creator "Damiano Scandolari"@en,
        "Gloria Re Calegari"@en,
        "Irene Celino"@en,
        "Mario Scrocca"@en ;
    dc:rights "The Survey Ontology is available under the Creative Commons Attribution 3.0 Unported license; see http://creativecommons.org/licenses/by/3.0/. In a nutshell, you are free to copy, distribute and transmit the work; to remix/adapt the work (e.g. to import the ontology and create specializations of its elements), as long as you attribute the work in the manner specified by the author or licensor (but not in any way that suggests that they endorse you or your use of the work). Proper Attribution: Simply include the statement \"This work is based on the Survey Ontology, developed by the Knowledge Technologies group at Cefriel, Milan\" and link back to https://w3id.org/survey-ontology"@en ;
    dc:subject "Survey, Question, Answer, Variable"@en ;
    dc:title "The Survey Ontology"@en ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    vann:preferredNamespacePrefix "sur" ;
    vann:preferredNamespaceUri "https://w3id.org/survey-ontology#" ;
    rdfs:comment "Ontology for surveys based on the Coney data model."@en ;
    owl:imports qb:,
        <http://purl.org/wf4ever/ro#>,
        <http://purl.org/wf4ever/wfdesc#>,
        <http://purl.org/wf4ever/wfprov#>,
        <http://w3id.org/rv-ontology#>,
        prov: ;
    owl:versionInfo "V 1.0, Release 2020"@en ;
    foaf:homepage <https://w3id.org/survey-ontology> .

<https://w3id.org/survey-ontology#CheckboxQuestion> a owl:Class ;
    rdfs:label "Checkbox Question" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#ClosedQuestion> .

<https://w3id.org/survey-ontology#CompletedSurvey> a owl:Class ;
    rdfs:label "Completed Survey" ;
    rdfs:subClassOf qb:Slice,
        <http://purl.org/wf4ever/wfprov#Artifact> .

<https://w3id.org/survey-ontology#Dropdown> a owl:NamedIndividual,
        <https://w3id.org/survey-ontology#QuestionVisualization> ;
    rdfs:label "Dropdown" .

<https://w3id.org/survey-ontology#Emoji> a owl:NamedIndividual,
        <https://w3id.org/survey-ontology#QuestionVisualization> ;
    rdfs:label "Emoji" .

<https://w3id.org/survey-ontology#MutipleInputQuestion> a owl:Class ;
    rdfs:label "Multiple Input Question" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#OpenQuestion> .

<https://w3id.org/survey-ontology#OpenAnswer> a owl:Class ;
    rdfs:label "Open Answer" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#Answer> .

<https://w3id.org/survey-ontology#Option> a owl:NamedIndividual,
        <https://w3id.org/survey-ontology#QuestionVisualization> ;
    rdfs:label "Option" .

<https://w3id.org/survey-ontology#Scale> a owl:NamedIndividual,
        <https://w3id.org/survey-ontology#QuestionVisualization> ;
    rdfs:label "Scale" .

<https://w3id.org/survey-ontology#SingleInputQuestion> a owl:Class ;
    rdfs:label "Single Input Question" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#OpenQuestion> .

<https://w3id.org/survey-ontology#Slider> a owl:NamedIndividual,
        <https://w3id.org/survey-ontology#QuestionVisualization> ;
    rdfs:label "Slider" .

<https://w3id.org/survey-ontology#Survey> a owl:Class ;
    rdfs:label "Survey" ;
    rdfs:subClassOf <http://purl.org/wf4ever/ro#ResearchObject> .

<https://w3id.org/survey-ontology#SurveyDataSet> a owl:Class ;
    rdfs:label "Survey Dataset" ;
    rdfs:subClassOf qb:DataSet,
        <http://purl.org/wf4ever/ro#Resource> .

<https://w3id.org/survey-ontology#answeredIn> a owl:ObjectProperty ;
    rdfs:label "answered in" ;
    rdfs:domain <https://w3id.org/survey-ontology#CompletedQuestion> ;
    rdfs:range <https://w3id.org/survey-ontology#SurveyCompletionTask> .

<https://w3id.org/survey-ontology#completedFor> a owl:ObjectProperty ;
    rdfs:label "completed for" ;
    rdfs:domain <https://w3id.org/survey-ontology#SurveyCompletionTask> ;
    rdfs:range <https://w3id.org/survey-ontology#SurveyTarget> .

<https://w3id.org/survey-ontology#completesQuestion> a owl:ObjectProperty ;
    rdfs:label "completes question" ;
    rdfs:domain <https://w3id.org/survey-ontology#CompletedQuestion> ;
    rdfs:range <https://w3id.org/survey-ontology#Question> .

<https://w3id.org/survey-ontology#hasAnswer> a owl:ObjectProperty ;
    rdfs:label "has answer" ;
    rdfs:domain <https://w3id.org/survey-ontology#CompletedQuestion> ;
    rdfs:range <https://w3id.org/survey-ontology#Answer> .

<https://w3id.org/survey-ontology#hasAnswerText> a owl:DatatypeProperty ;
    rdfs:label "has answer text" ;
    rdfs:domain <https://w3id.org/survey-ontology#CompletedQuestion> ;
    rdfs:range xsd:string .

<https://w3id.org/survey-ontology#hasCompletionTimestamp> a owl:DatatypeProperty ;
    rdfs:label "has completion timestamp" ;
    rdfs:domain <https://w3id.org/survey-ontology#CompletedQuestion> ;
    rdfs:range xsd:dateTime .

<https://w3id.org/survey-ontology#hasLatentVariable> a owl:ObjectProperty ;
    rdfs:label "has latent variable" ;
    rdfs:domain <https://w3id.org/survey-ontology#Question> ;
    rdfs:range <https://w3id.org/survey-ontology#LatentVariable> .

<https://w3id.org/survey-ontology#hasLink> a owl:DatatypeProperty ;
    rdfs:label "has link" ;
    rdfs:domain <https://w3id.org/survey-ontology#Talk> ;
    rdfs:range xsd:anyURI .

<https://w3id.org/survey-ontology#hasObservableVariable> a owl:ObjectProperty ;
    rdfs:label "has observable variable" ;
    rdfs:domain <https://w3id.org/survey-ontology#Question> ;
    rdfs:range <https://w3id.org/survey-ontology#ObservableVariable> .

<https://w3id.org/survey-ontology#hasOrderNumber> a owl:DatatypeProperty ;
    rdfs:label "has order number" ;
    rdfs:domain <https://w3id.org/survey-ontology#ClosedAnswer> ;
    rdfs:range xsd:integer .

<https://w3id.org/survey-ontology#hasPoints> a owl:DatatypeProperty ;
    rdfs:label "has points" ;
    rdfs:domain <https://w3id.org/survey-ontology#ClosedAnswer> ;
    rdfs:range xsd:float .

<https://w3id.org/survey-ontology#hasStatus> a owl:DatatypeProperty ;
    rdfs:label "has status" ;
    rdfs:domain <https://w3id.org/survey-ontology#SurveyProcedure> ;
    rdfs:range xsd:string .

<https://w3id.org/survey-ontology#hasText> a owl:DatatypeProperty ;
    rdfs:label "has text" ;
    rdfs:domain <https://w3id.org/survey-ontology#SurveyElement> ;
    rdfs:range xsd:string .

<https://w3id.org/survey-ontology#hasTitle> a owl:DatatypeProperty ;
    rdfs:label "has title" ;
    rdfs:domain <https://w3id.org/survey-ontology#SurveyProcedure> ;
    rdfs:range xsd:string .

<https://w3id.org/survey-ontology#hasValue> a owl:DatatypeProperty ;
    rdfs:label "has value" ;
    rdfs:domain <https://w3id.org/survey-ontology#ClosedAnswer> ;
    rdfs:range xsd:float .

<https://w3id.org/survey-ontology#hasVisualization> a owl:ObjectProperty ;
    rdfs:label "has visualization" ;
    rdfs:domain <https://w3id.org/survey-ontology#MultipleChoiceQuestion> ;
    rdfs:range <https://w3id.org/survey-ontology#QuestionVisualization> .

<https://w3id.org/survey-ontology#inSurveyProcedure> a owl:ObjectProperty ;
    rdfs:label "in survey procedure" ;
    rdfs:domain <https://w3id.org/survey-ontology#SurveyElement> ;
    rdfs:range <https://w3id.org/survey-ontology#SurveyProcedure> .

<https://w3id.org/survey-ontology#leadsTo> a owl:ObjectProperty ;
    rdfs:label "leads to" ;
    rdfs:domain <https://w3id.org/survey-ontology#SurveyElement> ;
    rdfs:range <https://w3id.org/survey-ontology#SurveyElement> .

<https://w3id.org/survey-ontology#participantId> a owl:DatatypeProperty ;
    rdfs:label "participant id" ;
    rdfs:domain <https://w3id.org/survey-ontology#Participant> ;
    rdfs:range xsd:string .

<https://w3id.org/survey-ontology#sessionId> a owl:DatatypeProperty ;
    rdfs:label "session id" ;
    rdfs:domain <https://w3id.org/survey-ontology#SurveyCompletionTask> ;
    rdfs:range xsd:string .

<https://w3id.org/survey-ontology#startsWith> a owl:ObjectProperty ;
    rdfs:label "starts with" ;
    rdfs:domain <https://w3id.org/survey-ontology#SurveyProcedure> ;
    rdfs:range <https://w3id.org/survey-ontology#SurveyElement> .

<https://w3id.org/survey-ontology> a owl:NamedIndividual .

<https://w3id.org/survey-ontology#LatentVariable> a owl:Class ;
    rdfs:label "Latent Variable" ;
    rdfs:subClassOf <http://w3id.org/rv-ontology#Variable> .

<https://w3id.org/survey-ontology#MultipleChoiceQuestion> a owl:Class ;
    rdfs:label "Multiple Choice Question" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#ClosedQuestion> .

<https://w3id.org/survey-ontology#ObservableVariable> a owl:Class ;
    rdfs:label "Observable Variable" ;
    rdfs:subClassOf <http://w3id.org/rv-ontology#Variable> .

<https://w3id.org/survey-ontology#Participant> a owl:Class ;
    rdfs:label "Participant" ;
    rdfs:subClassOf prov:Agent .

<https://w3id.org/survey-ontology#SurveyTarget> a owl:Class ;
    rdfs:label "Survey Target" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/rv-ontology#Variable> a owl:Class .

<https://w3id.org/survey-ontology#ClosedQuestion> a owl:Class ;
    rdfs:label "Closed Question" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#Question> .

<https://w3id.org/survey-ontology#OpenQuestion> a owl:Class ;
    rdfs:label "Open Question" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#Question> .

<https://w3id.org/survey-ontology#Answer> a owl:Class ;
    rdfs:label "Answer" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#SurveyElement> ;
    owl:disjointWith <https://w3id.org/survey-ontology#Question>,
        <https://w3id.org/survey-ontology#Talk> .

<https://w3id.org/survey-ontology#ClosedAnswer> a owl:Class ;
    rdfs:label "Closed Answer" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#Answer> .

<https://w3id.org/survey-ontology#SurveyCompletionTask> a owl:Class ;
    rdfs:label "Survey Completion Task" ;
    rdfs:subClassOf <http://purl.org/wf4ever/wfprov#ProcessRun> .

<https://w3id.org/survey-ontology#Talk> a owl:Class ;
    rdfs:label "Talk" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#SurveyElement> .

<https://w3id.org/survey-ontology#SurveyProcedure> a owl:Class ;
    rdfs:label "Survey Procedure" ;
    rdfs:subClassOf <http://purl.org/wf4ever/ro#Resource>,
        <http://purl.org/wf4ever/wfdesc#Process> .

<https://w3id.org/survey-ontology#CompletedQuestion> a owl:Class ;
    rdfs:label "Completed Question" ;
    rdfs:subClassOf qb:Observation,
        <http://purl.org/wf4ever/wfdesc#Output>,
        prov:Entity .

<https://w3id.org/survey-ontology#Question> a owl:Class ;
    rdfs:label "Question" ;
    rdfs:subClassOf <https://w3id.org/survey-ontology#SurveyElement> ;
    owl:disjointWith <https://w3id.org/survey-ontology#Talk> .

<https://w3id.org/survey-ontology#QuestionVisualization> a owl:Class ;
    rdfs:label "Question Visualization" ;
    rdfs:subClassOf owl:Thing .

<https://w3id.org/survey-ontology#SurveyElement> a owl:Class ;
    rdfs:label "Survey Element" ;
    rdfs:subClassOf owl:Thing .

