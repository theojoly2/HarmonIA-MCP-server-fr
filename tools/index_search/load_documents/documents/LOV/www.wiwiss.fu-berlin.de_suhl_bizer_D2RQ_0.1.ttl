    rdfs:range <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#Translation> .

<http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#uriColumn> a rdf:Property ;
    rdfs:label "URI column" ;
    rdfs:comment "Database column which contains URIs." ;
    rdfs:domain <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#ResourceMap> .

<http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#uriPattern> a rdf:Property ;
    rdfs:label "URI pattern" ;
    rdfs:comment "URI pattern with placeholders that will be filled with values from a database column." ;
    rdfs:domain <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#ResourceMap> .

<http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#uriSqlExpression> a rdf:Property ;
    rdfs:label "URI SQL expression" ;
    rdfs:comment "An SQL expression whose result will be the URI value of this property bridge." ;
    rdfs:domain <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#PropertyBridge> .

<http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#useAllOptimizations> a rdf:Property ;
    rdfs:label "Use all optimizations" ;
    rdfs:comment "Whether to use bleeding edge optimizations" ;
    rdfs:domain <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#Configuration> .

<http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#username> a rdf:Property ;
    rdfs:label "User name" ;
    rdfs:domain <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#Database> .

<http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#valueContains> a rdf:Property ;
    rdfs:label "Value contains" ;
    rdfs:comment "Optimizing hint: a string contained in every value of this resource map." ;
    rdfs:domain <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#ResourceMap> .

<http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#valueMaxLength> a rdf:Property ;
    rdfs:label "Value max length" ;
    rdfs:comment "Optimizing hint: the maximum length of values of this resource map." ;
    rdfs:domain <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#ResourceMap> ;
    rdfs:range xsd:decimal .

<http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#valueRegex> a rdf:Property ;
    rdfs:label "Value regex" ;
    rdfs:comment "Optimizing hint: a regular expression matching every value of this resource map." ;
    rdfs:domain <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#ResourceMap> .

<http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#class> a rdf:Property ;
