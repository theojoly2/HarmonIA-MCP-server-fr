@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <https://w3id.org/mdo/structure/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://emmo.info/domains/emmo-material.owl#EMMO_4207e895_8b83_4318_996a_72cfb32acd94> a owl:Class .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

rdf:List a rdfs:Datatype .

onto: a owl:Ontology ;
    dcterms:contributor "Patrick Lambrix"^^xsd:string,
        "Rickard Armiento"^^xsd:string ;
    dcterms:created "2019-11-07" ;
    dcterms:creator "Huanyu Li"^^xsd:string ;
    dcterms:license "https://github.com/huanyu-li/Materials-Design-Ontology/blob/master/LICENSE" ;
    dcterms:title "Materials Design Ontology - Structure Module"@en ;
    vann:preferredNamespacePrefix "structure" ;
    vann:preferredNamespaceUri "https://w3id.org/mdo/structure/1.0/" ;
    rdfs:comment "This is the structure module in Materials Design Ontology."@en ;
    rdfs:seeAlso "https://github.com/huanyu-li/Materials-Design-Ontology" ;
    owl:imports <https://w3id.org/mdo/core/1.0/> ;
    owl:versionIRI <https://w3id.org/mdo/structure/1.0/> ;
    owl:versionInfo "1.0"^^xsd:string .

onto:AnonymousFormula a owl:DatatypeProperty ;
    rdfs:label "anonymous formula"@en ;
    rdfs:comment "AnonymousFormula represents that a composition has the anonymous formula in a string."@en ;
    rdfs:domain onto:Composition ;
    rdfs:range xsd:string .

onto:DescriptiveFormula a owl:DatatypeProperty ;
    rdfs:label "descriptive formula"@en ;
    rdfs:comment "DescriptiveFormula represents that a composition has the descriptive formula in a string."@en ;
    rdfs:domain onto:Composition ;
    rdfs:range xsd:string .

onto:ElementRatio a owl:DatatypeProperty ;
    rdfs:label "element ratio"@en ;
    rdfs:comment "ElementRatio represents that a species has the ratio in a double."@en ;
    rdfs:domain onto:Species ;
    rdfs:range xsd:double .

onto:HillFormula a owl:DatatypeProperty ;
    rdfs:label "hill formula"@en ;
    rdfs:comment "HillFormula represents that a composition has the hill formula in a string."@en ;
    rdfs:domain onto:Composition ;
    rdfs:range xsd:string .

onto:LatticeType a owl:DatatypeProperty ;
    rdfs:label "lattice type"@en ;
    rdfs:comment "LatticeType represents that a lattice has the type in a string."@en ;
    rdfs:domain onto:Lattice ;
    rdfs:range xsd:string .

onto:LatticeVolume a owl:DatatypeProperty ;
    rdfs:label "lattice volume"@en ;
    rdfs:comment "LatticeVolume represents that a lattice has the volume in a double."@en ;
    rdfs:domain onto:Lattice ;
    rdfs:range xsd:double .

onto:ReducedFormula a owl:DatatypeProperty ;
    rdfs:label "reduced formula"@en ;
    rdfs:comment "ReducedFormula represents that a composition has the reduced formula in a string."@en ;
    rdfs:domain onto:Composition ;
    rdfs:range xsd:string .

<http://purl.obolibrary.org/obo/chebi/formula> a owl:DatatypeProperty .

onto:Angle_alpha a owl:DatatypeProperty ;
    rdfs:label "Angle_alpha"@en ;
    rdfs:comment "Angle_alpha represents that an angle triple has the alpha angle's value in a double."@en ;
    rdfs:domain onto:AngleTriple ;
    rdfs:range xsd:double .

onto:Angle_beta a owl:DatatypeProperty ;
    rdfs:label "Angle_beta"@en ;
    rdfs:comment "Angle_beta represents that an angle triple has the beta angle's value in a double."@en ;
    rdfs:domain onto:AngleTriple ;
    rdfs:range xsd:double .

onto:Angle_gamma a owl:DatatypeProperty ;
    rdfs:label "Angle_gamma"@en ;
    rdfs:comment "Angle_gamma represents that an angle triple has the gamma angle's value in a double."@en ;
    rdfs:domain onto:AngleTriple ;
    rdfs:range xsd:double .

onto:Length_a a owl:DatatypeProperty ;
    rdfs:label "Length_a"@en ;
    rdfs:comment "Length_a represents that a length triple has the 'a' value in a double."@en ;
    rdfs:domain onto:LengthTriple ;
    rdfs:range xsd:double .

onto:Length_b a owl:DatatypeProperty ;
    rdfs:label "Length_b"@en ;
    rdfs:comment "Length_b represents that a length triple has the 'b' value in a double."@en ;
    rdfs:domain onto:LengthTriple ;
    rdfs:range xsd:double .

onto:Length_c a owl:DatatypeProperty ;
    rdfs:label "Length_c"@en ;
    rdfs:comment "Length_c represents that a length triple has the 'c' value in a double."@en ;
    rdfs:domain onto:LengthTriple ;
    rdfs:range xsd:double .

onto:PointGroupHMName a owl:DatatypeProperty ;
    rdfs:label "point group Hermann-Mauguin name"@en ;
    rdfs:comment "PointGroupHMName represents that a point group has the Hermann-Mauguin in a string."@en ;
    rdfs:domain onto:PointGroup ;
    rdfs:range xsd:string .

onto:SpaceGroupID a owl:DatatypeProperty ;
    rdfs:label "space group ID"@en ;
    rdfs:comment "SpaceGroupID represents that a space group has the unique ID in an integer."@en ;
    rdfs:domain onto:SpaceGroup ;
    rdfs:range xsd:integer .

onto:SpaceGroupSymbol a owl:DatatypeProperty ;
    rdfs:label "space group symbol"@en ;
    rdfs:comment "SpaceGroupSymbol represents that a space group has the symbol in a string."@en ;
    rdfs:domain onto:SpaceGroup ;
    rdfs:range xsd:string .

onto:X_axisCoordinate a owl:DatatypeProperty ;
    rdfs:label "X_axis coordinate"@en ;
    rdfs:comment "X_axisCoordinate represents that a coordinate vector has the value of a coordinate in a double in X axis."@en ;
    rdfs:domain onto:CoordinateVector ;
    rdfs:range xsd:double .

onto:Y_axisCoordinate a owl:DatatypeProperty ;
    rdfs:label "Y_axis coordinate"@en ;
    rdfs:comment "Y_axisCoordinate represents that a coordinate vector has the value of a coordinate in a double in Y axis."@en ;
    rdfs:domain onto:CoordinateVector ;
    rdfs:range xsd:double .

onto:Z_axisCoordinate a owl:DatatypeProperty ;
    rdfs:label "Z_axis coordinate"@en ;
    rdfs:comment "Z_axisCoordinate represents that a coordinate vector has the value of a coordinate in a double in Z axis."@en ;
    rdfs:domain onto:CoordinateVector ;
    rdfs:range xsd:double .

onto:hasElement a owl:ObjectProperty ;
    rdfs:label "has element"@en ;
    rdfs:comment "hasElement represents the relationship between a species and atoms it has."@en ;
    rdfs:domain onto:Species ;
    rdfs:range <http://purl.obolibrary.org/obo/CHEBI_33250> .

onto:hasLattice a owl:ObjectProperty ;
    rdfs:label "has lattice"@en ;
    rdfs:comment "hasLattice represents the relationship between a structure and lattices in it has."@en ;
    rdfs:domain <https://w3id.org/mdo/core/Structure> ;
    rdfs:range onto:Lattice .

onto:has_a_axisVector a owl:ObjectProperty ;
    rdfs:label "has a_axis vector"@en ;
    rdfs:comment "has_a_axisVector represents the relationship between an axis-vectors and a coordinate vector to define the coordiantes of the translation vector (a)."@en ;
    rdfs:domain onto:AxisVectors ;
    rdfs:range onto:CoordinateVector .

onto:has_b_axisVector a owl:ObjectProperty ;
    rdfs:label "has b_axis vector"@en ;
    rdfs:comment "has_b_axisVector represents the relationship between an axis-vectors and a coordinate vector to define the coordiantes of the translation vector (b)."@en ;
    rdfs:domain onto:AxisVectors ;
    rdfs:range onto:CoordinateVector .

onto:has_c_axisVector a owl:ObjectProperty ;
    rdfs:label "has c_axis vector"@en ;
    rdfs:comment "has_c_axisVector represents the relationship between an axis-vectors and a coordinate vector to define the coordiantes of the translation vector (c)."@en ;
    rdfs:domain onto:AxisVectors ;
    rdfs:range onto:CoordinateVector .

<http://purl.obolibrary.org/obo/CHEBI_33250> a owl:Class ;
    rdfs:label "Atom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://purl.obolibrary.org/obo/chebi/formula> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

onto:hasAngleVector a owl:ObjectProperty ;
    rdfs:label "has angle vector"@en ;
    rdfs:comment "hasAngleVector represents the relationship between a basis or a lattice and an angle triple it has."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Basis onto:Lattice ) ] ;
    rdfs:range onto:AngleTriple .

onto:hasAxisVectors a owl:ObjectProperty ;
    rdfs:label "has axis vectors"@en ;
    rdfs:comment "hasAxisVectors represents the relationship between a basis or a lattice and a axis-vectors it has."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Basis onto:Lattice ) ] ;
    rdfs:range onto:AxisVectors .

onto:hasBasis a owl:ObjectProperty ;
    rdfs:label "has basis"@en ;
    rdfs:comment "hasBasis represents the relationship between a structure and the bases it has."@en ;
    rdfs:domain <https://w3id.org/mdo/core/Structure> ;
    rdfs:range onto:Basis .

onto:hasCartesianCoordinates a owl:ObjectProperty ;
    rdfs:label "has cartesian coordinates"@en ;
    rdfs:comment "hasCartesianCoordinates represents the relationship between a site and coordinates in cartesian format it has."@en ;
    rdfs:domain onto:Site ;
    rdfs:range onto:CoordinateVector .

onto:hasComposition a owl:ObjectProperty ;
    rdfs:label "has composition"@en ;
    rdfs:comment "hasComposition represents the relationship between a structure and a a composition it has."@en ;
    rdfs:domain <https://w3id.org/mdo/core/Structure> ;
    rdfs:range onto:Composition .

onto:hasFractionalCoordinates a owl:ObjectProperty ;
    rdfs:label "has fractional coordinates"@en ;
    rdfs:comment "hasFractionalCoordinates represents the relationship between a site and coordinates in fractional format it has."@en ;
    rdfs:domain onto:Site ;
    rdfs:range onto:CoordinateVector .

onto:hasLengthVector a owl:ObjectProperty ;
    rdfs:label "has length vector"@en ;
    rdfs:comment "hasLengthVector represents the relationship between a basis or a lattice and a length triple it has."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Basis onto:Lattice ) ] ;
    rdfs:range onto:LengthTriple .

onto:hasOccupancy a owl:ObjectProperty ;
    rdfs:label "has occupancy"@en ;
    rdfs:comment "hasOccupancy represents the relationship between a structure and occupancies it has."@en ;
    rdfs:domain <https://w3id.org/mdo/core/Structure> ;
    rdfs:range onto:Occupancy .

onto:hasPointGroup a owl:ObjectProperty ;
    rdfs:label "has point group"@en ;
    rdfs:comment "hasPointGroup represents the relationship between a space group and point groups it corresponds to."@en ;
    rdfs:domain onto:SpaceGroup ;
    rdfs:range onto:PointGroup .

onto:hasSite a owl:ObjectProperty ;
    rdfs:label "has site"@en ;
    rdfs:comment "hasSite represents the relationship between an occupancy and sites it ties."@en ;
    rdfs:domain onto:Occupancy ;
    rdfs:range onto:Site .

onto:hasSpaceGroup a owl:ObjectProperty ;
    rdfs:label "has space group"@en ;
    rdfs:comment "hasSpaceGroup represents the relationship between a structure and a space group it corresponds to."@en ;
    rdfs:domain <https://w3id.org/mdo/core/Structure> ;
    rdfs:range onto:SpaceGroup .

onto:hasSpecies a owl:ObjectProperty ;
    rdfs:label "has species"@en ;
    rdfs:comment "hasSpecies represents the relationship between an occupancy and species it ties."@en ;
    rdfs:domain onto:Occupancy ;
    rdfs:range onto:Species .

onto:PointGroup a owl:Class ;
    rdfs:label "Point Group"@en ;
    rdfs:comment "A group of linear mappings of vector space, which is corresonpond to the group of motions in point space determining the symmetry of the macroscopic crystal, is called the point group of the crystal, furthermore of the crystal structure, and is also called the point group of its space group."@en ;
    rdfs:seeAlso "International Tables for Crystallography, Volume A, Fourth, revised edition, Section 8.1.5."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty onto:PointGroupHMName ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

<https://w3id.org/mdo/core/Structure> a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty onto:hasBasis ;
                        owl:someValuesFrom onto:Basis ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:Basis ;
                        owl:onProperty onto:hasBasis ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:Lattice ;
                        owl:onProperty onto:hasLattice ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom onto:SpaceGroup ;
                        owl:onProperty onto:hasSpaceGroup ] [ a owl:Restriction ;
                        owl:onClass onto:SpaceGroup ;
                        owl:onProperty onto:hasSpaceGroup ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty onto:hasOccupancy ;
                        owl:someValuesFrom onto:Occupancy ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:Occupancy ;
                        owl:onProperty onto:hasOccupancy ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom onto:Composition ;
                        owl:onProperty onto:hasComposition ] [ a owl:Restriction ;
                        owl:onClass onto:Composition ;
                        owl:onProperty onto:hasComposition ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

onto:Occupancy a owl:Class ;
    rdfs:label "Occupancy"@en ;
    rdfs:comment "An occupancy ties a specific species to a site."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty onto:hasSite ;
                        owl:someValuesFrom onto:Site ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:Site ;
                        owl:onProperty onto:hasSite ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty onto:hasSpecies ;
                        owl:someValuesFrom onto:Species ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:Species ;
                        owl:onProperty onto:hasSpecies ] ) ] .

onto:Site a owl:Class ;
    rdfs:label "Site"@en ;
    rdfs:comment "A site is a point in a lattice."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom onto:CoordinateVector ;
                        owl:onProperty onto:hasFractionalCoordinates ] [ a owl:Restriction ;
                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass onto:CoordinateVector ;
                        owl:onProperty onto:hasFractionalCoordinates ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom onto:CoordinateVector ;
                        owl:onProperty onto:hasCartesianCoordinates ] [ a owl:Restriction ;
                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass onto:CoordinateVector ;
                        owl:onProperty onto:hasCartesianCoordinates ] ) ] .

onto:Species a owl:Class ;
    rdfs:label "Species"@en ;
    rdfs:comment "A species is the combination of atoms on each site."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://purl.obolibrary.org/obo/CHEBI_33250> ;
            owl:onProperty onto:hasElement ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

onto:AngleTriple a owl:Class ;
    rdfs:label "Angle Triple"@en ;
    rdfs:comment "A angle triple is a vector of three angles which represent the angles among three bases in a cell."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty onto:Angle_alpha ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty onto:Angle_beta ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty onto:Angle_gamma ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

onto:AxisVectors a owl:Class ;
    rdfs:label "Axis Vectors"@en ;
    rdfs:comment "An axis-vectors is the three vectors which represent the bases of cell."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onClass onto:CoordinateVector ;
                        owl:onProperty onto:has_a_axisVector ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass onto:CoordinateVector ;
                        owl:onProperty onto:has_b_axisVector ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass onto:CoordinateVector ;
                        owl:onProperty onto:has_c_axisVector ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

onto:Basis a owl:Class ;
    rdfs:label "Basis"@en ;
    rdfs:comment "A basis defines a spatial unit used to express fractional coordinates."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass onto:AngleTriple ;
                                    owl:onProperty onto:hasAngleVector ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:onClass onto:LengthTriple ;
                                    owl:onProperty onto:hasLengthVector ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] [ a owl:Restriction ;
                        owl:onClass onto:AxisVectors ;
                        owl:onProperty onto:hasAxisVectors ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

onto:LengthTriple a owl:Class ;
    rdfs:label "Length Triple"@en ;
    rdfs:comment "A length triple defines the three parameters (a, b, c) that represent the lengths in three axes respectively."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty onto:Length_b ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty onto:Length_c ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty onto:Length_a ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

onto:SpaceGroup a owl:Class ;
    rdfs:label "Space Group"@en ;
    rdfs:comment "A space group is the symmetry group of a three-dimensional crystal pattern is called its space group."@en ;
    rdfs:seeAlso "International Tables for Crystallography, Volume !, Fourth, revised edition, Section 8.1.5."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty onto:hasPointGroup ;
                        owl:someValuesFrom onto:PointGroup ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:PointGroup ;
                        owl:onProperty onto:hasPointGroup ] ) ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty onto:SpaceGroupSymbol ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty onto:SpaceGroupID ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

onto:Composition a owl:Class ;
    rdfs:label "Composition"@en ;
    rdfs:comment "A composition is used to represent what chemical elements composing a structure and the ratio of the chemical elements."@en .

onto:Lattice a owl:Class ;
    rdfs:label "Lattice"@en ;
    rdfs:comment "A lattice defines a peroidic arrangement of one or more atoms."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass onto:AngleTriple ;
                                    owl:onProperty onto:hasAngleVector ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:onClass onto:LengthTriple ;
                                    owl:onProperty onto:hasLengthVector ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] [ a owl:Restriction ;
                        owl:onClass onto:AxisVectors ;
                        owl:onProperty onto:hasAxisVectors ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

onto:CoordinateVector a owl:Class ;
    rdfs:label "Coordinate Vector"@en ;
    rdfs:comment "A coordinate vector is the coordinates of a point in space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty onto:X_axisCoordinate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty onto:Y_axisCoordinate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty onto:Z_axisCoordinate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

