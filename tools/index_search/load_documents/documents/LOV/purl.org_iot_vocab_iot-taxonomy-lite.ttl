    rdfs:seeAlso <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementMNotification>,
        <http://openiot.eu/ontology/ns/AtmosphereHumidity>,
        <http://paul.staroch.name/thesis/SmartHomeWeather.owl#Humidity> ;
    rdfs:subClassOf sosa:ObservableProperty .

onto:Hydrophone a owl:Class ;
    rdfs:label "Hydrophone"@en ;
    rdfs:comment "A hydrophone is a microphone designed to be used underwater for recording or listening to underwater sound."@en ;
    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#> ;
    rdfs:subClassOf sosa:Sensor .

onto:IEEE802154InterfaceEnergyMeter a owl:Class ;
    rdfs:label "IEEE802.15.4 Interface Energy Meter"@en ;
    rdfs:comment "Sensor that measures the power consumption of the IEEE802.15.4 interface nodes."@en ;
    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#> ;
    rdfs:subClassOf onto:EnergyMeter .

onto:INR a owl:Class ;
    rdfs:label "International Normalized Ratio"@en ;
    dc:description "A system established by the World Health Organization (WHO) and the International Committee on Thrombosis and Hemostasis for reporting the results of blood coagulation (clotting) tests. Abbreviated INR. Under the INR system, all results are standardized. For example, a person taking the anticoagulant warfarin (brand name: Coumadin) would regularly have blood tested to measure the INR. The INR permits patients on anticoagulants to travel and obtain comparable test results wherever they are.\\n        Medical Definition of International normalized ratio, MedicineNet"@en ;
    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#> ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/qu/qu#Unit> .

onto:IdentifyOutlierObservsations a owl:Class ;
    rdfs:label "Identify Outlier Observsations"@en ;
    rdfs:comment "Purpose to identify if an observation is outlier or not."@en ;
    rdfs:subClassOf <http://purl.org/adaptcentre/openscience/ontologies/consent#Purpose> .

onto:ImageSensor a owl:Class ;
    rdfs:label "Image Sensor"@en ;
    rdfs:comment "Sensor that detects and conveys the information that constitutes an image."@en ;
    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#> ;
    rdfs:subClassOf sosa:Sensor .

onto:Inch a owl:Class ;
    rdfs:label "Inch"@en ;
    rdfs:comment "Length in inches."@en ;
    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#> ;
    rdfs:subClassOf onto:Metre .

onto:Index a owl:Class ;
    rdfs:label "Index"@en ;
