onto:H2SSensor a owl:Class ;
    rdfs:label "H2S Sensor"@en ;
    rdfs:comment "Device used to measure of hydrogen sulphide in the environment."@en ;
    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#> ;
    rdfs:subClassOf onto:GaseousPollutantSensor .

onto:HDOP a owl:Class ;
