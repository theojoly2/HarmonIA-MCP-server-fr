@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <https://w3id.org/TRO> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dcterms:abstract a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

<http://purl.org/goodrelations/v1#valueAddedTaxIncluded> a owl:DatatypeProperty ;
    rdfs:label "Value added tax included"@en ;
    rdfs:domain <http://purl.org/goodrelations/v1#PriceSpecification> ;
    rdfs:range xsd:boolean .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<https://dbpedia.org/ontology/PoliticalParty> a owl:Class ;
    rdfs:label "Political Party"@en ;
    rdfs:comment "organized group of individuals who share similar political beliefs, ideologies, and policy goals, and they work together to gain political power and influence within a government system"@en ;
    rdfs:isDefinedBy "http://dbpedia.org/ontology/"^^xsd:anyURI ;
    rdfs:subClassOf <https://ontologies.semanticarts.com/gist/Organization> .

schema:Corporation a owl:Class ;
    rdfs:label "Corporation"@en ;
    rdfs:comment "A business corporation"@en ;
    rdfs:isDefinedBy "https://schema.org"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty schema:identifier ],
        <https://ontologies.semanticarts.com/gist/Organization> .

schema:GovernmentOrganization a owl:Class ;
    rdfs:label "GovernmentOrganization"@en ;
    rdfs:comment "A governmental organization or agency"@en ;
    rdfs:isDefinedBy "https://schema.org"^^xsd:anyURI ;
    rdfs:subClassOf <https://ontologies.semanticarts.com/gist/Organization> .

schema:NGO a owl:Class ;
    rdfs:label "NGO"@en ;
    rdfs:comment "Non-governmental Organization"@en ;
    rdfs:isDefinedBy "https://schema.org"^^xsd:anyURI ;
    rdfs:subClassOf <https://ontologies.semanticarts.com/gist/Organization> .

schema:NewsArticle a owl:Class ;
    rdfs:label "NewsArticle"@en ;
    rdfs:comment "A NewsArticle is an article whose content reports news, or provides background context and supporting materials for understanding the news"@en ;
    rdfs:isDefinedBy "https://schema.org"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Evidence> .

schema:SportsOrganization a owl:Class ;
    rdfs:label "Sports Organization"@en ;
    rdfs:comment "all sports organizations, including sports teams, governing bodies, and sports associations"@en ;
    rdfs:isDefinedBy "https://schema.org"^^xsd:anyURI ;
    rdfs:subClassOf <https://ontologies.semanticarts.com/gist/Organization> .

schema:WorkersUnion a owl:Class ;
    rdfs:label "Workers Union"@en ;
    rdfs:comment "A Workers Union (also known as a Labor Union, Labour Union, or Trade Union) is an organization that promotes the interests of its worker members by collectively bargaining with management, organizing, and political lobbying"@en ;
    rdfs:isDefinedBy "https://schema.org"^^xsd:anyURI ;
    rdfs:subClassOf <https://ontologies.semanticarts.com/gist/Organization> .

schema:parent a owl:ObjectProperty ;
    rdfs:label "Parent"@en ;
    rdfs:subPropertyOf schema:knows .

schema:schemaVersion a owl:AnnotationProperty .

schema:spouse a owl:ObjectProperty ;
    rdfs:label "Spouse"@en ;
    rdfs:subPropertyOf schema:knows .

onto: a owl:Ontology ;
    dc:contributor "Off-shore leaks DataBase (https://offshoreleaks.icij.org/)"@en ;
    dcterms:abstract "Transparent Relations Ontology (TRO) offers a vocabulary to publish information about relations that should be more transparent, usually between powerful parties, to detect potential conflicts of interests: for example, governments and their providers, or politicians and their personal relationships. Research journalism and Open Data are two areas in which this sort of data is growing, and new methods and standards are needed to cope with the FAIR publication and consumption of such data."@en ;
    dcterms:created "2022-04-01T00:00:01"^^xsd:dateTime ;
    dcterms:description "A vocabulary to represent relations that should be more transparent, usually between powerfull people or institutions"@en ;
    dcterms:issued "2022-04-01T00:00:01"^^xsd:dateTime ;
    dcterms:license "https://apache.org/licenses/LICENSE-2.0"^^xsd:anyURI ;
    dcterms:modified "2023-06-06T00:00:01"^^xsd:dateTime ;
    dcterms:title "Transparent Relations Ontology"@en ;
    vann:preferredNamespacePrefix "tro"@en ;
    vann:preferredNamespaceUri "https://w3id.org/TRO#"^^xsd:anyURI ;
    owl:priorVersion "0.1.2" ;
    owl:versionIRI <https://w3id.org/TRO/0.1.3> ;
    owl:versionInfo "0.1.3" ;
    schema:schemaVersion "https://w3id.org/TRO/0.1.3" .

<https://w3id.org/TRO#Associate> a owl:Class ;
    rdfs:label "Associate"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-08T21:12:46+00:00"^^xsd:dateTime ;
    rdfs:comment "A person who is connected to another organization in a relationship that is less close or committed than a partnership"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Role> .

<https://w3id.org/TRO#Director> a owl:Class ;
    rdfs:label "Director"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-09T08:50:19+00:00"^^xsd:dateTime ;
    rdfs:comment "The director of an organization"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Role> .

<https://w3id.org/TRO#Employee> a owl:Class ;
    rdfs:label "Employee"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-08T21:13:05+00:00"^^xsd:dateTime ;
    rdfs:comment "A person hired by an organization"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Role> .

<https://w3id.org/TRO#Manager> a owl:Class ;
    rdfs:label "Manager"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-09T10:33:21+00:00"^^xsd:dateTime ;
    rdfs:comment "A person within an organization who is responsible for planning, coordinating, and overseeing various activities and resources to achieve specific goals and objectives"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Role> .

<https://w3id.org/TRO#Member> a owl:Class ;
    rdfs:label "Member"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-27T15:32:50+00:00"^^xsd:dateTime ;
    rdfs:comment "A person is a member of an organization"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Role> .

<https://w3id.org/TRO#Minor_contract> a owl:Class ;
    rdfs:label "Minor contract"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-05-19T08:10:50+00:00"^^xsd:dateTime ;
    rdfs:comment "In some administrations minor contracts do not have to be justified"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:seeAlso "http://contsem.unizar.es/def/sector-publico/pproc#Minor",
        "https://www.boe.es/boe/dias/2019/03/07/pdfs/BOE-A-2019-3281.pdf" ;
    rdfs:subClassOf <http://data.europa.eu/a4g/ontology#Contract> .

<https://w3id.org/TRO#Officer> a owl:Class ;
    rdfs:label "Officer"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-09T08:51:05+00:00"^^xsd:dateTime ;
    rdfs:comment "An officer usually belongs to a publica organization"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Role> .

<https://w3id.org/TRO#OpenData> a owl:Class ;
    rdfs:label "Open data"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-27T15:36:32+00:00"^^xsd:dateTime ;
    rdfs:comment "Data available at an Open Data portal, usually developed by a public administration"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Evidence> .

<https://w3id.org/TRO#Owner> a owl:Class ;
    rdfs:label "Owner"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-08T21:12:53+00:00"^^xsd:dateTime ;
    rdfs:comment "The owner of a company"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Role> .

<https://w3id.org/TRO#President> a owl:Class ;
    rdfs:label "President"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-09T08:50:34+00:00"^^xsd:dateTime ;
    rdfs:comment "The president of an organization"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Role> .

<https://w3id.org/TRO#PublicProfile> a owl:Class ;
    rdfs:label "Public Profile"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-10T19:19:00+00:00"^^xsd:dateTime ;
    rdfs:comment "A public profile in the web (e.g. LinkedIn)"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Evidence> .

<https://w3id.org/TRO#has_bank_account_in> a owl:ObjectProperty ;
    rdfs:label "Has bank account in"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2022-02-21T14:25:46+00:00"^^xsd:dateTime .

<https://w3id.org/TRO#pays_to> a owl:ObjectProperty ;
    rdfs:label "Pays to"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2022-02-21T14:24:12+00:00"^^xsd:dateTime .

<https://w3id.org/TRO#provider_of> a owl:ObjectProperty ;
    rdfs:label "Provider of"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2022-02-15T11:23:05+00:00"^^xsd:dateTime ;
    rdfs:comment "A company or and individual provides services or products to an institution"@en .

<https://w3id.org/TRO#registered_in> a owl:ObjectProperty ;
    rdfs:label "Registered in"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2022-02-21T14:30:10+00:00"^^xsd:dateTime .

<https://w3id.org/TRO#represents> a owl:ObjectProperty ;
    rdfs:label "Represents"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2022-02-21T14:21:32+00:00"^^xsd:dateTime .

<https://w3id.org/TRO#sibling> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Sibling"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-27T15:34:21+00:00"^^xsd:dateTime ;
    rdfs:subPropertyOf schema:knows .

<https://w3id.org/TRO#takes_place_in> a owl:ObjectProperty ;
    rdfs:label "Takes place in"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2022-02-21T14:35:58+00:00"^^xsd:dateTime .

<https://w3id.org/TRO#with_evidence> a owl:ObjectProperty ;
    rdfs:label "With evidence"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-08T21:27:00+00:00"^^xsd:dateTime ;
    rdfs:domain <https://w3id.org/TRO#Role> ;
    rdfs:range <https://w3id.org/TRO#Evidence> .

<https://w3id.org/TRO/IndividualContractor> a owl:Class ;
    rdfs:label "Individual contractor"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2024-01-27T10:23:30+00:00"^^xsd:dateTime ;
    rdfs:comment "A person that acts as a single contractor to other organizations, usually government organizations"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf <https://w3id.org/TRO#Role> .

<http://data.europa.eu/a4g/ontology#bindsContractor> a owl:ObjectProperty ;
    rdfs:label "Binds Contractor"@en ;
    rdfs:domain <http://data.europa.eu/a4g/ontology#Contract> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://ontologies.semanticarts.com/gist/Organization> schema:Person ) ] .

<http://purl.org/goodrelations/v1#hasCurrency> a owl:DatatypeProperty ;
    rdfs:label "Has currency"@en ;
    rdfs:domain <http://purl.org/goodrelations/v1#PriceSpecification> ;
    rdfs:range xsd:string .

<http://purl.org/goodrelations/v1#hasCurrencyValue> a owl:DatatypeProperty ;
    rdfs:label "Has currency value"@en ;
    rdfs:domain <http://purl.org/goodrelations/v1#PriceSpecification> ;
    rdfs:range xsd:double .

<http://purl.org/goodrelations/v1#hasPriceSpecification> a owl:ObjectProperty ;
    rdfs:label "Has price specification"@en .

time:months a owl:DatatypeProperty ;
    rdfs:label "Months"@en .

time:years a owl:DatatypeProperty ;
    rdfs:label "Years"@en .

<http://www.w3.org/ns/person#name> a owl:DatatypeProperty ;
    rdfs:label "Name"@en ;
    rdfs:domain schema:Person ;
    rdfs:range xsd:string .

schema:email a owl:DatatypeProperty ;
    rdfs:label "Email"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://ontologies.semanticarts.com/gist/Organization> schema:Person ) ] ;
    rdfs:range xsd:string .

<https://w3id.org/TRO#cpv_code> a owl:DatatypeProperty ;
    rdfs:label "CPV code"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-05-19T07:51:57+00:00"^^xsd:dateTime ;
    rdfs:domain <http://data.europa.eu/a4g/ontology#Contract> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://single-market-economy.ec.europa.eu/single-market/public-procurement/digital-procurement/common-procurement-vocabulary_en" .

<https://w3id.org/TRO#has_role> a owl:ObjectProperty ;
    rdfs:label "Has role"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-08T21:10:19+00:00"^^xsd:dateTime ;
    rdfs:domain schema:Person ;
    rdfs:range <https://w3id.org/TRO#Role> .

<https://w3id.org/TRO#in_entity> a owl:ObjectProperty ;
    rdfs:label "In entity"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-08T21:13:36+00:00"^^xsd:dateTime ;
    rdfs:domain <https://w3id.org/TRO#Role> ;
    rdfs:range <https://ontologies.semanticarts.com/gist/Organization> .

<https://w3id.org/TRO#profile_url> a owl:DatatypeProperty ;
    rdfs:label "Profile URL"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-09T09:04:41+00:00"^^xsd:dateTime ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( schema:Person <https://w3id.org/TRO#Role> ) ] ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf <https://w3id.org/TRO#url> .

schema:identifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Identifier"@en ;
    rdfs:range xsd:string .

<https://w3id.org/TRO#end_date> a owl:DatatypeProperty ;
    rdfs:label "End date"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-09T09:02:35+00:00"^^xsd:dateTime ;
    rdfs:domain <https://w3id.org/TRO#Role> ;
    rdfs:range xsd:dateTime .

<https://w3id.org/TRO#start_date> a owl:DatatypeProperty ;
    rdfs:label "Start date"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-09T09:02:16+00:00"^^xsd:dateTime ;
    rdfs:domain <https://w3id.org/TRO#Role> ;
    rdfs:range xsd:dateTime .

<http://data.europa.eu/a4g/ontology#Contract> a owl:Class ;
    rdfs:label "Contract"@en ;
    rdfs:comment "A voluntary, deliberate, and legally binding agreement between two or more competent parties. Additional information: This includes concession contracts. (WG approval 01/06/2018)"@en ;
    rdfs:isDefinedBy "http://data.europa.eu/a4g/ontology"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/TRO#url> ;
            owl:someValuesFrom xsd:anyURI ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/goodrelations/v1#hasPriceSpecification> ;
            owl:someValuesFrom <http://purl.org/goodrelations/v1#PriceSpecification> ],
        [ a owl:Restriction ;
            owl:onProperty schema:identifier ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/TRO#end_date> ],
        [ a owl:Restriction ;
            owl:onProperty <http://data.europa.eu/a4g/ontology#bindsContractor> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://ontologies.semanticarts.com/gist/Organization> schema:Person ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/TRO#cpv_code> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/TRO#start_date> ],
        <https://ontologies.semanticarts.com/gist/Commitment> .

schema:knows a owl:ObjectProperty ;
    rdfs:label "Knows"@en ;
    rdfs:domain schema:Person ;
    rdfs:range schema:Person .

<https://w3id.org/TRO#url> a owl:DatatypeProperty ;
    rdfs:label "URL"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-10T19:19:41+00:00"^^xsd:dateTime .

<http://purl.org/goodrelations/v1#PriceSpecification> a owl:Class ;
    rdfs:label "Price specification"@en ;
    rdfs:comment "The superclass of all price specifications"@en ;
    rdfs:isDefinedBy "http://purl.org/goodrelations/v1"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/goodrelations/v1#hasCurrencyValue> ;
            owl:someValuesFrom xsd:double ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/goodrelations/v1#hasCurrency> ;
            owl:someValuesFrom xsd:string ],
        <https://ontologies.semanticarts.com/gist/Commitment> .

<https://ontologies.semanticarts.com/gist/Commitment> a owl:Class ;
    rdfs:label "Commitment"@en ;
    rdfs:comment "An obligation (possibly unilateral)"@en ;
    rdfs:isDefinedBy "https://ontologies.semanticarts.com/gist/"^^xsd:anyURI .

<https://w3id.org/TRO#Evidence> a owl:Class ;
    rdfs:label "Evidence"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2022-02-15T11:19:58+00:00"^^xsd:dateTime ;
    rdfs:comment "The evidence of a relation. Normally an evidence will be a source of news. This is not legal evidence"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/TRO#url> ;
            owl:someValuesFrom xsd:anyURI ] .

schema:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A person (alive, dead, undead, or fictional)."@en ;
    rdfs:isDefinedBy "https://schema.org"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/TRO#profile_url> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://www.w3.org/ns/person#name> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/TRO#has_role> ;
            owl:someValuesFrom <https://w3id.org/TRO#Role> ] .

<https://ontologies.semanticarts.com/gist/Organization> a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "A generic organization that can be formal or informal, legal or non-legal. It can have members, or not"@en ;
    rdfs:isDefinedBy "https://ontologies.semanticarts.com/gist/"^^xsd:anyURI .

<https://w3id.org/TRO#Role> a owl:Class ;
    rdfs:label "Role"@en ;
    dc:creator "Mikel Egaña Aranguren (https://orcid.org/0000-0001-8081-1839)" ;
    dc:date "2023-03-08T21:06:06+00:00"^^xsd:dateTime ;
    rdfs:comment "The role of a person in a en entity during a given time period, provided in months or years"@en ;
    rdfs:isDefinedBy "https://w3id.org/TRO"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/TRO#in_entity> ;
            owl:someValuesFrom <https://ontologies.semanticarts.com/gist/Organization> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:months ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/TRO#end_date> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/TRO#start_date> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty time:years ],
        <https://ontologies.semanticarts.com/gist/Commitment> .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://ontologies.semanticarts.com/gist/Commitment> <https://ontologies.semanticarts.com/gist/Organization> schema:Person <https://w3id.org/TRO#Evidence> ) .

