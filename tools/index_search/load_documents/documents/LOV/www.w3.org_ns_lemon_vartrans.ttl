@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://www.w3.org/ns/lemon/vartrans#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix onto: <http://www.w3.org/ns/lemon/vartrans> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:term_status a owl:AnnotationProperty .

ns2:ConceptualRelation a owl:Class ;
    rdfs:label "conceptual relation"@en ;
    rdfs:comment "A relationship between two concepts"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://www.w3.org/ns/lemon/ontolex#LexicalConcept> ;
            owl:onProperty ns2:relates ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        ns2:LexicoSemanticRelation .

ns2:LexicalRelation a owl:Class ;
    rdfs:label "lexical relation"@en,
        "relation lexicale"@fr ;
    rdfs:comment "A 'lexical relation' is a lexico-semantic relation that represents the relation between two lexical entries the surface forms of which are related grammatically, stylistically or by some operation motivated by linguistic economy."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://www.w3.org/ns/lemon/ontolex#LexicalEntry> ;
            owl:onProperty ns2:relates ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        ns2:LexicoSemanticRelation ;
    ns1:term_status "stable" .

ns2:TerminologicalRelation a owl:Class ;
    rdfs:label "terminological relation"@en,
        "variante terminologique"@fr ;
    rdfs:comment "A 'terminological relation' is a sense relation that relates two lexical senses of terms that are semantically related in the sense that they can be exchanged in most contexts, but their surface forms are not directly related. The variants vary along dimensions that are not captured by the given ontology and are intentionally (pragmatically) caused."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns2:SenseRelation ;
    ns1:term_status "stable" .

ns2:category a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "category"@en,
        "contexte"@fr ;
    rdfs:comment "The 'category' property indicates the specific type of relation by which two lexical entries or two lexical senses are related."@en ;
    rdfs:domain ns2:LexicoSemanticRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    ns1:term_status "stable" .

ns2:conceptRel a owl:ObjectProperty ;
    rdfs:label "concept relation"@en ;
    rdfs:comment "A relationship between two concepts"@en ;
    rdfs:domain <http://www.w3.org/ns/lemon/ontolex#LexicalConcept> ;
    rdfs:range <http://www.w3.org/ns/lemon/ontolex#LexicalConcept> .

ns2:source a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "source"@en,
        "source"@fr ;
    rdfs:comment "The 'source' property indicates the lexical sense or lexical entry involved in a lexico-semantic relation as a 'source'."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns2:relates ;
    ns1:term_status "stable" .

ns2:trans a owl:ObjectProperty ;
    rdfs:label "translation"@en,
        "traduction"@fr ;
    rdfs:comment "The property 'trans' relates a TranslationSet to one of its translations."@en ;
    rdfs:domain ns2:TranslationSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns2:Translation ;
    ns1:term_status "stable" .

ns2:translatableAs a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "translatable as"@en,
        "traduisible par"@fr ;
    rdfs:comment "The 'translatableAs' property relates a lexical entry in some language to a lexical entry in another language that it can be translated as depending on the particular context and specific senses of the involved lexical entries."@en ;
    rdfs:domain <http://www.w3.org/ns/lemon/ontolex#LexicalEntry> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/ns/lemon/ontolex#LexicalEntry> ;
    rdfs:subPropertyOf ns2:lexicalRel ;
    owl:propertyChainAxiom ( <http://www.w3.org/ns/lemon/ontolex#isSenseOf> ns2:translation <http://www.w3.org/ns/lemon/ontolex#sense> ) ;
    ns1:term_status "stable" .

owl:topObjectProperty a owl:ObjectProperty .

ns2:Translation a owl:Class ;
    rdfs:label "translation"@en,
        "traduction"@fr ;
    rdfs:comment "A 'translation' is a 'sense relation' expressing that two lexical senses corresponding to two lexical entries in different languages can be translated to each other without any major meaning shifts."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://www.w3.org/ns/lemon/ontolex#LexicalSense> ;
            owl:onProperty ns2:target ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns2:SenseRelation ;
    ns1:term_status "stable" .

ns2:TranslationSet a owl:Class ;
    rdfs:label "translation set"@en,
        "banque de traductions"@fr ;
    rdfs:comment "A 'translation set' is a set of translations that have some common source."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

ns2:lexicalRel a owl:ObjectProperty ;
    rdfs:label "lexical relation"@en,
        "relation lexicale"@fr ;
    rdfs:comment "The 'lexicalRel' property relates two lexical entries that stand in some lexical relation."@en ;
    rdfs:domain <http://www.w3.org/ns/lemon/ontolex#LexicalEntry> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/ns/lemon/ontolex#LexicalEntry> ;
    ns1:term_status "stable" .

ns2:senseRel a owl:ObjectProperty ;
    rdfs:label "sense relation"@en,
        "relation sémantique"@fr ;
    rdfs:comment "The 'senseRel' property relates two lexical senses that stand in some sense relation."@en ;
    rdfs:domain <http://www.w3.org/ns/lemon/ontolex#LexicalSense> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/ns/lemon/ontolex#LexicalSense> ;
    ns1:term_status "stable" .

ns2:target a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "target"@en,
        "destination"@fr ;
    rdfs:comment "The 'target' property indicates the lexical sense or lexical entry involved in a lexico-semantic relation as a 'target'."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns2:relates ;
    ns1:term_status "stable" .

ns2:translation a owl:ObjectProperty ;
    rdfs:label "translation"@en,
        "traduction"@fr ;
    rdfs:comment "The 'translation' property relates two lexical senses of two lexical entries that stand in a translation relation to one another. "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns2:senseRel ;
    ns1:term_status "stable" .

ns2:SenseRelation a owl:Class ;
    rdfs:label "sense relation"@en,
        "relation sémantique"@fr ;
    rdfs:comment "A 'sense relation' is a lexico-semantic relation that represents the relation between two lexical senses the meanings of which are related."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://www.w3.org/ns/lemon/ontolex#LexicalSense> ;
            owl:onProperty ns2:relates ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        ns2:LexicoSemanticRelation ;
    ns1:term_status "stable" .

ns2:LexicoSemanticRelation a owl:Class ;
    rdfs:label "lexico-semantic relation"@en,
        "relation lexico-sémantique"@fr ;
    rdfs:comment "A 'lexico-semantic relation' represents the relation between two lexical entries or lexical senses that are related by some lexical or semantic relationship."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( <http://www.w3.org/ns/lemon/ontolex#LexicalConcept> <http://www.w3.org/ns/lemon/ontolex#LexicalEntry> <http://www.w3.org/ns/lemon/ontolex#LexicalSense> ) ] ;
            owl:onProperty ns2:relates ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ] ;
    ns1:term_status "stable" .

ns2:relates a owl:ObjectProperty ;
    rdfs:label "relates"@en,
        "relate"@fr ;
    rdfs:comment "The 'relates' property links a lexico-semantic relation to the two lexical entries or lexical senses between which it establishes the relation."@en ;
    rdfs:domain ns2:LexicoSemanticRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.w3.org/ns/lemon/ontolex#LexicalConcept> <http://www.w3.org/ns/lemon/ontolex#LexicalEntry> <http://www.w3.org/ns/lemon/ontolex#LexicalSense> ) ] ;
    ns1:term_status "stable" .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    ns3:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dc:contributor <http://art.uniroma2.it/fiorelli/>,
        <http://art.uniroma2.it/stellato/>,
        <http://jogracia.url.ph/web/>,
        <http://mayor2.dia.fi.upm.es/oeg-upm/index.php/en/teachers/52-emontiel>,
        <http://www.dfki.de/~declerck/>,
        <http://www.ilc.cnr.it/en/content/anas-fahad-khan>,
        <http://www.istc.cnr.it/people/aldo-gangemi>,
        <http://www.oeg-upm.net/index.php/teachers/53-lupe>,
        <http://www.paulbuitelaar.net/>,
        <https://sites.google.com/site/francescafrontini/> ;
    dc:creator <http://john.mccr.ae/>,
        <http://www.cimiano.de/> ;
    dc:description "A model for the representation of lexical information relative to ontologies. Variation and translation module."@en ;
    dc:issued "2016-01-10"^^xsd:date ;
    dc:modified "2016-01-10"^^xsd:date ;
    dc:publisher <http://www.w3.org/community/ontolex> ;
    dc:rights "CC-Zero" ;
    dc:title "Lexicon Model for Ontologies - Vartrans"@en ;
    vann:preferredNamespacePrefix "vartrans" ;
    vann:preferredNamespaceUri "http://www.w3.org/ns/lemon/vartrans#" ;
    rdfs:comment "-Version 1.0: depreciation with minor change in metadata for LOV publication\\n-Version 1.1: creation"@en ;
    owl:imports <http://www.w3.org/ns/lemon/ontolex> ;
    ns2:imports <http://www.w3.org/ns/lemon/ontolex> ;
    ns2:versionInfo 1.1 .

