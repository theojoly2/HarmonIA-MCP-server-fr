@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.w3.org/2003/11/swrl#> .
@prefix onto: <http://purl.org/co> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    dc:contributor "Marco Ocana"^^xsd:string,
        "Paolo Ciccarese"^^xsd:string,
        "Silvio Peroni"^^xsd:string ;
    dc:creator <http://www.paolociccarese.info> ;
    dc:date "March 19, 2012"^^xsd:string ;
    dc:format "application/rdf+xml"^^xsd:string ;
    dc:language "en" ;
    dc:title "The Collections Ontology\\n(CO)"@en ;
    owl:imports <http://www.essepuntato.it/2009/10/error> ;
    owl:versionInfo "2.0"^^xsd:string .

<http://purl.org/co/elementOf> a owl:ObjectProperty ;
    rdfs:label "is element of"@en ;
    rdfs:comment "The link to a collection in which the object is member."@en ;
    owl:inverseOf <http://purl.org/co/element> .

<http://purl.org/co/firstItemOf> a owl:ObjectProperty ;
    rdfs:label "is first item of"@en ;
    rdfs:comment "The link to a list in which the item is first item."@en ;
    rdfs:subPropertyOf <http://purl.org/co/itemOf> ;
    owl:inverseOf <http://purl.org/co/firstItem> .

<http://purl.org/co/itemContentOf> a owl:ObjectProperty ;
    rdfs:label "is item content of"@en ;
    rdfs:comment "The link to the item that refers to the resource."@en ;
    owl:inverseOf <http://purl.org/co/itemContent> .

<http://purl.org/co/lastItemOf> a owl:ObjectProperty ;
    rdfs:label "is last item of"@en ;
    rdfs:comment "The link to a list in which the item is last item."@en ;
    rdfs:subPropertyOf <http://purl.org/co/itemOf> ;
    owl:inverseOf <http://purl.org/co/lastItem> .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:format a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

<http://purl.org/co/Set> a owl:Class ;
    rdfs:label "set"@en ;
    rdfs:comment "A collection that cannot contain duplicate elements."@en ;
    rdfs:subClassOf <http://purl.org/co/Collection> .

<http://purl.org/co/previousItem> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has previous item"@en ;
    dc:description "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the previous item of I[i] is I[i-1]."@en ;
    rdfs:comment "The link to the previous item in a list."@en ;
    rdfs:subPropertyOf <http://purl.org/co/precededBy> ;
    owl:inverseOf <http://purl.org/co/nextItem> .

<http://purl.org/co/element> a owl:ObjectProperty ;
    rdfs:label "has element"@en ;
    rdfs:comment "The link to the members of a collection"@en ;
    rdfs:domain <http://purl.org/co/Collection> ;
    owl:propertyChainAxiom ( <http://purl.org/co/item> <http://purl.org/co/itemContent> ) .

<http://purl.org/co/itemContent> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has item content"@en ;
    rdfs:comment "The link to the actual resource to which the item refers."@en ;
    rdfs:domain <http://purl.org/co/Item> ;
    rdfs:range [ a owl:Class ;
            owl:complementOf <http://purl.org/co/Item> ] .

<http://purl.org/co/precededBy> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is preceded by"@en ;
    dc:description "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the item I[i] is preceded by I[i-1], ... , I[2] and I[1]."@en ;
    rdfs:comment "The link to the preceding item in a list."@en ;
    owl:inverseOf <http://purl.org/co/followedBy> .

<http://www.essepuntato.it/2009/10/error/hasError> a owl:DatatypeProperty .

<urn:swrl#current> a ns1:Variable .

<urn:swrl#last> a ns1:Variable .

<urn:swrl#list> a ns1:Variable .

<urn:swrl#next> a ns1:Variable .

<urn:swrl#nextR> a ns1:Variable .

<urn:swrl#r1> a ns1:Variable .

<urn:swrl#r2> a ns1:Variable .

<http://purl.org/co/Bag> a owl:Class ;
    rdfs:label "bag"@en ;
    rdfs:comment "Collection that can have a number of copies of each object"@en ;
    rdfs:subClassOf <http://purl.org/co/Collection> ;
    owl:disjointWith <http://purl.org/co/Set> .

<http://purl.org/co/followedBy> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is followed by"@en ;
    dc:description "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the item I[i] is followed by I[i+1], ... , I[n-1] and I[n]."@en ;
    rdfs:comment "The link to the following item in a list."@en ;
    rdfs:domain <http://purl.org/co/ListItem> ;
    rdfs:range <http://purl.org/co/ListItem> .

owl:Thing a owl:Class .

<urn:swrl#li> a ns1:Variable .

<urn:swrl#li1> a ns1:Variable .

<urn:swrl#li2> a ns1:Variable .

<http://purl.org/co/Collection> a owl:Class ;
    rdfs:label "collection"@en ;
    rdfs:comment "A group of objects that can be considered as a whole."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty <http://purl.org/co/element> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://purl.org/co/size> ],
        owl:Thing ;
    owl:disjointWith <http://purl.org/co/Item> .

<http://purl.org/co/List> a owl:Class ;
    rdfs:label "list"@en ;
    rdfs:comment "An ordered array of items, that can be present in multiple copies"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/co/Bag> [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/co/ListItem> ;
                        owl:onProperty <http://purl.org/co/item> ] ) ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://purl.org/co/firstItem> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://purl.org/co/lastItem> ] .

<http://purl.org/co/firstItem> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has first item"@en ;
    rdfs:comment "The link to the first item of the list."@en ;
    rdfs:domain <http://purl.org/co/List> ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/co/ListItem> [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://purl.org/co/previousItem> ] [ a owl:Restriction ;
                        owl:hasValue "1"^^xsd:positiveInteger ;
                        owl:onProperty <http://purl.org/co/index> ] ) ] ;
    rdfs:subPropertyOf <http://purl.org/co/item> .

<http://purl.org/co/size> a owl:DatatypeProperty ;
    rdfs:label "has size"@en ;
    dc:description "CO defines the size of a collection as the sum of the number of times entities that are part of the collection appear in it. This means that co:size considers how much each entity is involved by a particular collection, i.e.:\\n- the size of the set {a, b, c} is three\\n- the size of the bag [a, a, b, b, b, c] is five\\n- the size of the list (a, b, c, b, a, b, c, c) is seven"@en ;
    rdfs:comment "The number of item belonging to a collection."@en ;
    rdfs:domain <http://purl.org/co/Collection> ;
    rdfs:range xsd:nonNegativeInteger .

<urn:swrl#r> a ns1:Variable .

<urn:swrl#value> a ns1:Variable .

<http://purl.org/co/nextItem> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has next item"@en ;
    dc:description "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the next item of I[i] is I[i+1]."@en ;
    rdfs:comment "The link to the next item in a list."@en ;
    rdfs:subPropertyOf <http://purl.org/co/followedBy> .

<urn:swrl#i> a ns1:Variable .

<http://purl.org/co/itemOf> a owl:ObjectProperty ;
    rdfs:label "is item of"@en ;
    rdfs:comment "The link to a bag in which the item is member."@en ;
    owl:inverseOf <http://purl.org/co/item> .

<http://purl.org/co/lastItem> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has last item"@en ;
    rdfs:comment "The link to the last item of the list."@en ;
    rdfs:domain <http://purl.org/co/List> ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/co/ListItem> [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://purl.org/co/nextItem> ] ) ] ;
    rdfs:subPropertyOf <http://purl.org/co/item> .

<urn:swrl#x> a ns1:Variable .

<http://purl.org/co/Item> a owl:Class ;
    rdfs:label "item"@en ;
    rdfs:comment "Element belonging to a bag"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://purl.org/co/item> ] ;
            owl:someValuesFrom <http://purl.org/co/Bag> ],
        owl:Thing .

<http://purl.org/co/ListItem> a owl:Class ;
    rdfs:label "list item"@en ;
    rdfs:comment "element belonging to a list"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://purl.org/co/index> ],
        <http://purl.org/co/Item> .

<http://purl.org/co/item> a owl:ObjectProperty ;
    rdfs:label "has item"@en ;
    rdfs:comment "The link to every item of the bag"@en ;
    rdfs:domain <http://purl.org/co/Bag> ;
    rdfs:range <http://purl.org/co/Item> ;
    owl:propertyChainAxiom ( <http://purl.org/co/item> <http://purl.org/co/nextItem> ) .

<urn:swrl#l> a ns1:Variable .

<http://purl.org/co/index> a owl:DatatypeProperty ;
    rdfs:label "has index"@en ;
    rdfs:comment "A number identifying the position, starting from 1, of a particular list item within a list."@en ;
    rdfs:domain <http://purl.org/co/ListItem> ;
    rdfs:range xsd:positiveInteger .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#x> ;
                    ns1:argument2 <urn:swrl#x> ;
                    ns1:propertyPredicate <http://purl.org/co/followedBy> ] ;
            rdf:rest () ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <urn:swrl#x> ;
                    ns1:argument2 "A list item cannot be followed by itself" ;
                    ns1:propertyPredicate <http://www.essepuntato.it/2009/10/error/hasError> ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#x> ;
                    ns1:argument2 <urn:swrl#x> ;
                    ns1:propertyPredicate <http://purl.org/co/precededBy> ] ;
            rdf:rest () ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <urn:swrl#x> ;
                    ns1:argument2 "A list item cannot be preceded by itself" ;
                    ns1:propertyPredicate <http://www.essepuntato.it/2009/10/error/hasError> ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#i> ;
                    ns1:argument2 <urn:swrl#l> ;
                    ns1:propertyPredicate <http://purl.org/co/itemOf> ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <urn:swrl#i> ;
                            ns1:argument2 <urn:swrl#value> ;
                            ns1:propertyPredicate <http://purl.org/co/index> ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 <urn:swrl#l> ;
                                    ns1:argument2 <urn:swrl#value> ;
                                    ns1:propertyPredicate <http://purl.org/co/size> ] ;
                            rdf:rest () ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#l> ;
                    ns1:argument2 <urn:swrl#i> ;
                    ns1:propertyPredicate <http://purl.org/co/lastItem> ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#li1> ;
                    ns1:argument2 <urn:swrl#l> ;
                    ns1:propertyPredicate <http://purl.org/co/itemOf> ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:IndividualPropertyAtom ;
                            ns1:argument1 <urn:swrl#li2> ;
                            ns1:argument2 <urn:swrl#l> ;
                            ns1:propertyPredicate <http://purl.org/co/itemOf> ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 <urn:swrl#li1> ;
                                    ns1:argument2 <urn:swrl#r1> ;
                                    ns1:propertyPredicate <http://purl.org/co/index> ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 <urn:swrl#li2> ;
                                            ns1:argument2 <urn:swrl#r2> ;
                                            ns1:propertyPredicate <http://purl.org/co/index> ] ;
                                    rdf:rest [ a ns1:AtomList ;
                                            rdf:first [ a ns1:BuiltinAtom ;
                                                    ns1:arguments [ a rdf:List ;
                                                            rdf:first <urn:swrl#r2> ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first <urn:swrl#r1> ;
                                                                    rdf:rest [ a rdf:List ;
                                                                            rdf:first 1 ;
                                                                            rdf:rest () ] ] ] ;
                                                    ns1:builtin <http://www.w3.org/2003/11/swrlb#add> ] ;
                                            rdf:rest () ] ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#li1> ;
                    ns1:argument2 <urn:swrl#li2> ;
                    ns1:propertyPredicate <http://purl.org/co/nextItem> ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#current> ;
                    ns1:argument2 <urn:swrl#next> ;
                    ns1:propertyPredicate <http://purl.org/co/nextItem> ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <urn:swrl#current> ;
                            ns1:argument2 <urn:swrl#r> ;
                            ns1:propertyPredicate <http://purl.org/co/index> ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:BuiltinAtom ;
                                    ns1:arguments [ a rdf:List ;
                                            rdf:first <urn:swrl#nextR> ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first <urn:swrl#r> ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first 1 ;
                                                            rdf:rest () ] ] ] ;
                                    ns1:builtin <http://www.w3.org/2003/11/swrlb#add> ] ;
                            rdf:rest () ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <urn:swrl#next> ;
                    ns1:argument2 <urn:swrl#nextR> ;
                    ns1:propertyPredicate <http://purl.org/co/index> ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#li> ;
                    ns1:argument2 <urn:swrl#l> ;
                    ns1:propertyPredicate <http://purl.org/co/itemOf> ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <urn:swrl#li> ;
                            ns1:argument2 "1" ;
                            ns1:propertyPredicate <http://purl.org/co/index> ] ;
                    rdf:rest () ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#l> ;
                    ns1:argument2 <urn:swrl#li> ;
                    ns1:propertyPredicate <http://purl.org/co/firstItem> ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#l> ;
                    ns1:argument2 <urn:swrl#i> ;
                    ns1:propertyPredicate <http://purl.org/co/lastItem> ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <urn:swrl#l> ;
                            ns1:argument2 <urn:swrl#value> ;
                            ns1:propertyPredicate <http://purl.org/co/size> ] ;
                    rdf:rest () ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <urn:swrl#i> ;
                    ns1:argument2 <urn:swrl#value> ;
                    ns1:propertyPredicate <http://purl.org/co/index> ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 <urn:swrl#list> ;
                    ns1:argument2 <urn:swrl#last> ;
                    ns1:propertyPredicate <http://purl.org/co/lastItem> ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <urn:swrl#last> ;
                            ns1:argument2 <urn:swrl#r> ;
                            ns1:propertyPredicate <http://purl.org/co/index> ] ;
                    rdf:rest () ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <urn:swrl#list> ;
                    ns1:argument2 <urn:swrl#r> ;
                    ns1:propertyPredicate <http://purl.org/co/size> ] ;
            rdf:rest () ] .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/co/List> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/co/firstItem> ;
                        owl:someValuesFrom <http://purl.org/co/Item> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/co/lastItem> ;
                        owl:someValuesFrom <http://purl.org/co/Item> ] ) ] ;
    owl:intersectionOf ( <http://purl.org/co/List> [ a owl:Restriction ;
                owl:onProperty <http://purl.org/co/item> ;
                owl:someValuesFrom <http://purl.org/co/ListItem> ] ) .

