            dc:identifier ":arc758fb743" ;
            owl:onProperty ns1:SIO_000218 ;
            owl:someValuesFrom [ a owl:Class ;
                    dc:identifier ":arc758fb744" ;
                    owl:intersectionOf ( ns1:SIO_000004 [ a owl:Restriction ;
                                dc:identifier ":arc758fb746" ;
                                owl:onProperty ns1:SIO_000217 ;
                                owl:someValuesFrom ns1:SIO_000555 ] ) ] ],
        ns1:SIO_000475 .

ns1:SIO_010340 a owl:Class ;
    rdfs:label "to covalently modify"@en ;
    dc:identifier "SIO_010340" ;
    dcterms:description "to covalently modify is to materially change a molecule by adding or removing covalent bonds between atoms."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:SIO_000376 .

ns1:SIO_010363 a owl:Class ;
    rdfs:label "product"@en ;
    dc:identifier "SIO_010363" ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass [ a owl:Class ;
            dc:identifier ":arc758fb796" ;
            owl:intersectionOf ( ns1:SIO_011125 [ a owl:Restriction ;
                        dc:identifier ":arc758fb798" ;
                        owl:onProperty ns1:SIO_000232 ;
                        owl:someValuesFrom ns1:SIO_010345 ] [ a owl:Restriction ;
                        dc:identifier ":arc758fb800" ;
                        owl:onProperty ns1:SIO_000244 ;
                        owl:someValuesFrom ns1:SIO_010362 ] ) ] .

ns1:SIO_010376 a owl:Class ;
    rdfs:label "unicellular organism"@en ;
    dc:identifier "SIO_010376" ;
    dcterms:description "A unicellular organism is a organism that is composed of a single cell."@en ;
    rdfs:isDefinedBy onto: ;
