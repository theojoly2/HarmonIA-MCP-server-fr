ns1:SIO_010058 a owl:Class ;
    rdfs:label "alive"@en ;
    dc:identifier "SIO_010058" ;
    dcterms:description "alive is the state of a biological organism that exhibits biological functions."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:SIO_010057 ;
