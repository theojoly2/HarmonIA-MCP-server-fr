                                owl:someValuesFrom ns1:SIO_010008 ] ) ] ],
        ns1:SIO_000030 .

ns1:SIO_010019 a owl:Class ;
    rdfs:label "biological data"@en ;
    dc:identifier "SIO_010019" ;
    dcterms:description "biological data is scientific data relevant to biology."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:SIO_000472 .

ns1:SIO_010049 a owl:Class ;
