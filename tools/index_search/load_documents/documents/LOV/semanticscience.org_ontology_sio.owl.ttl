            dc:identifier ":arc758fb826" ;
            owl:onProperty ns1:SIO_000369 ;
            owl:someValuesFrom ns1:SIO_010044 ],
        ns1:SIO_010020 .

ns1:SIO_010442 a owl:Class ;
