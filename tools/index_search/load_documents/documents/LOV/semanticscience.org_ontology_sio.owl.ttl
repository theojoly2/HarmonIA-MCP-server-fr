                    dc:identifier ":arc758fb804" ;
                    owl:onProperty ns1:SIO_000093 ;
                    owl:someValuesFrom ns1:SIO_010046 ] ],
        ns1:SIO_010001,
        ns1:SIO_010377 .

ns1:SIO_010377 a owl:Class ;
    rdfs:label "cellular organism"@en ;
    dc:identifier "SIO_010377" ;
    dcterms:description "A cellular organism is an organism that contains one or more cells."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:SIO_010000 ;
    owl:disjointWith ns1:SIO_010378 ;
    owl:equivalentClass [ a owl:Class ;
            dc:identifier ":arc758fb805" ;
            owl:unionOf ( ns1:SIO_010375 ns1:SIO_010376 ) ] .

ns1:SIO_010441 a owl:Class ;
    rdfs:label "submolecule"@en ;
    dc:identifier "SIO_010441" ;
    dcterms:description "A submolecule is a mereological sum of covalently bonded atoms."@en ;
