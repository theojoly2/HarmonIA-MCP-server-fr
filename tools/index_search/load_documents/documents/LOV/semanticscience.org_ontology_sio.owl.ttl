            dc:identifier ":arc758fb405" ;
            owl:onProperty ns1:SIO_000338 ;
            owl:someValuesFrom [ a owl:Class ;
                    dc:identifier ":arc758fb406" ;
                    owl:intersectionOf ( ns1:SIO_000000 [ a owl:Restriction ;
                                dc:identifier ":arc758fb408" ;
                                owl:onProperty ns1:SIO_000300 ;
                                owl:someValuesFrom rdfs:Literal ] ) ] ],
        ns1:SIO_000912 .

ns1:SIO_000937 a owl:Class ;
    rdfs:label "textual chart"@en ;
    dc:identifier "SIO_000937" ;
    dcterms:description "A textual chart is a chart containing text."@en ;
    rdfs:isDefinedBy onto: ;
