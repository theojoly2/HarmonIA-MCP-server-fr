@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.ontologydesignpatterns.org/opla/> .
@prefix ns2: <https://w3id.org/arco/ontology/catalogue/> .
@prefix onto: <https://w3id.org/arco/ontology/cultural-event> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:language a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

ns1:reusesPatternAsTemplate a owl:AnnotationProperty .

ns2:iccdNormTag a owl:AnnotationProperty .

<https://w3id.org/arco/ontology/cultural-event/Exhibition> a owl:Class ;
    rdfs:label "Exhibition"@en ;
    rdfs:comment "This class represents an exhibition, as a particular type of cultural event."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://dati.beniculturali.it/cis/CulturalEvent> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/Hour> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> ;
    rdfs:label "Hour"@en .

<https://w3id.org/arco/ontology/cultural-event/Minute> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> ;
    rdfs:label "Minute"@en .

<https://w3id.org/arco/ontology/cultural-event/Month> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> ;
    rdfs:label "Month"@en .

<https://w3id.org/arco/ontology/cultural-event/Second> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> ;
    rdfs:label "Second"@en .

<https://w3id.org/arco/ontology/cultural-event/TimePeriod> a owl:Class ;
    rdfs:label "Time period"@en ;
    rdfs:comment "The class that represents a time period."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/italia/onto/TI/TimeInterval> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/Week> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> ;
    rdfs:label "Week"@en .

<https://w3id.org/arco/ontology/cultural-event/Year> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> ;
    rdfs:label "Year"@en .

<https://w3id.org/arco/ontology/cultural-event/eventTimeLocation> a owl:DatatypeProperty ;
    rdfs:label "event time and location"@en ;
    rdfs:comment "This property represents the time and location of a cultural event, when they are recorded together."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEvent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/hasEventOrganiser> a owl:ObjectProperty ;
    rdfs:label "has event organiser"@en ;
    rdfs:comment "This property relates a cultural evento to the agency or person that is the organiser of that event."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEvent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/cultural-event/hasAgentRelatedToCulturalEvent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/cultural-event/isEventOrganiserOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/hasImmediateNextEvent> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has immediate next event"@en ;
    rdfs:comment "This property relates an event that is member of a recurrent event, as a collection, to the immediate next event."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/cultural-event/hasNextEvent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/cultural-event/hasImmediatePreviousEvent> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/l0/Description> rdfs:subClassOf <https://w3id.org/italia/onto/l0/Entity> .

<https://w3id.org/italia/onto/l0/Location> rdfs:subClassOf <https://w3id.org/italia/onto/l0/Entity> .

<https://w3id.org/italia/onto/l0/Object> rdfs:subClassOf <https://w3id.org/italia/onto/l0/Entity> .

<https://w3id.org/arco/ontology/context-description/hasRelatedAgent> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/context-description/isAgentRelatedTo> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/Concept> a owl:Class .

<https://w3id.org/arco/ontology/core/Situation> a owl:Class .

<https://w3id.org/arco/ontology/core/hasCharacteristic> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/hasConcept> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/isCharacteristicOf> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/isConceptOf> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/cultural-event/hasAgentRelatedToCulturalEvent> a owl:ObjectProperty ;
    rdfs:label "has agent related to cultural event"@en ;
    rdfs:comment "This class relates a cultural event to an agent playing a role related to that cultural event."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEvent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/cultural-event/isAgentRelatedToCulturalEventOf> ;
    owl:propertyChainAxiom ( <https://w3id.org/italia/onto/RO/hasRiT> <https://w3id.org/italia/onto/RO/isRoleInTimeOf> ) ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/hasImmediatePreviousEvent> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has immediate previous event"@en ;
    rdfs:comment "This property relates an event that is member of a recurrent event, as a collection, to the immediate previous event."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/cultural-event/hasPreviousEvent> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/hasRecurrentTimePeriod> a owl:ObjectProperty ;
    rdfs:label "has recurrent time period"@en ;
    rdfs:comment "This property relates a recurrent event to the time period that elapses between one of its member events and the next one."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/cultural-event/RecurrentEvent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> ;
    owl:inverseOf <https://w3id.org/arco/ontology/cultural-event/isRecurrentTimePeriodOf> ;
    owl:propertyChainAxiom ( <https://w3id.org/arco/ontology/cultural-event/hasMemberEvent> <https://w3id.org/arco/ontology/cultural-event/hasTimePeriodBeforeNextEvent> ) ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/hasTimePeriodBeforeNextEvent> a owl:ObjectProperty ;
    rdfs:label "has time period before next event"@en ;
    rdfs:comment "This property relates an event, member of a recurrent event as a collection of events, to the time period that is between that event and the next one."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> ;
    owl:inverseOf <https://w3id.org/arco/ontology/cultural-event/isTimePeriodBeforeNextEventOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/hasTimePeriodMeasurementUnit> a owl:ObjectProperty ;
    rdfs:label "has time period measurement unit"@en ;
    rdfs:comment "This property relates the maximum time period that elapses between one of the member events of a recurrent event, as a collection of events, and the next one, to the unit of measurement associated to it."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCharacteristic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/cultural-event/isTimePeriodMeasurementUnitOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/hasUnifyingFactor> a owl:ObjectProperty ;
    rdfs:label "has unifying factor"@en ;
    rdfs:comment "This property relates a recurrent event to a unifying factor."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/cultural-event/RecurrentEvent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/cultural-event/UnifyingFactor> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasConcept> ;
    owl:inverseOf <https://w3id.org/arco/ontology/cultural-event/isUnifyingFactorOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/isEventMemberOf> a owl:ObjectProperty ;
    rdfs:label "is event member of"@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:isDefinedBy onto:,
        "This property relates an event, member of a recurrent event as a collection of events, to the recurrent event that is member of."@en ;
    rdfs:range <https://w3id.org/arco/ontology/cultural-event/RecurrentEvent> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/isMemberOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/isEventOrganiserOf> a owl:ObjectProperty ;
    rdfs:label "is event organiser of"@en ;
    rdfs:comment "This is the inverse property of \"has event organiser\"."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEvent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/cultural-event/isAgentRelatedToCulturalEventOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/isTimePeriodBeforeNextEventOf> a owl:ObjectProperty ;
    rdfs:label "is time period before next event of"@en ;
    rdfs:comment "This is the inverse property of \"has time period before next event\"."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/timePeriodValue> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "time period value"@en ;
    rdfs:comment "This property represents the value associated to the time period that elapses between one of the member events of a recurrent event, as a collection of events, and the next one."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/MU/MeasurementUnit> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/l0/Characteristic> .

<https://w3id.org/italia/onto/RO/hasRiT> a owl:ObjectProperty .

<https://w3id.org/italia/onto/RO/isRoleInTimeOf> a owl:ObjectProperty .

<https://w3id.org/italia/onto/TI/TimeInterval> rdfs:subClassOf <https://w3id.org/italia/onto/l0/Entity> .

<https://w3id.org/italia/onto/l0/Characteristic> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/l0/Entity> .

<https://w3id.org/italia/onto/l0/Collection> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/l0/Entity> .

<https://w3id.org/italia/onto/l0/follows> a owl:ObjectProperty .

<https://w3id.org/italia/onto/l0/hasMember> a owl:ObjectProperty .

<https://w3id.org/italia/onto/l0/isMemberOf> a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/italia/onto/l0/precedes> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/cultural-event/hasNextEvent> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has next event"@en ;
    rdfs:comment "This property relates an event that is member of a recurrent event, as a collection, to one of the next events."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/precedes> ;
    owl:inverseOf <https://w3id.org/arco/ontology/cultural-event/hasPreviousEvent> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/isAgentRelatedToCulturalEventOf> a owl:ObjectProperty ;
    rdfs:label "is agent related to cultural event of"@en ;
    rdfs:comment "This is the inverse property of \"has agent related to cultural event\"."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEvent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/isAgentRelatedTo> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/isRecurrentTimePeriodOf> a owl:ObjectProperty ;
    rdfs:label "is recurrent time period of"@en ;
    rdfs:comment "This property relates the maximum time period that elapses between one of the member events of a recurrent event and the next one."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/cultural-event/RecurrentEvent> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/isTimePeriodMeasurementUnitOf> a owl:ObjectProperty ;
    rdfs:label "is time period measurement unit of"@en ;
    rdfs:comment "This is the inverse property of \"has time period measurement unit\"."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isCharacteristicOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/isUnifyingFactorOf> a owl:ObjectProperty ;
    rdfs:label "is unifying factor of"@en ;
    rdfs:comment "This property relates a unifying factor to a recurrent event."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/cultural-event/UnifyingFactor> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/cultural-event/RecurrentEvent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isConceptOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/UnifyingFactor> a owl:Class ;
    rdfs:label "Unifying factor"@en ;
    rdfs:comment "This class represents a unifying factor, that is a factor that represents an invariant common to all the events that are members of the recurrent event."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/cultural-event/isUnifyingFactorOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/cultural-event/RecurrentEvent> ],
        <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/hasMemberEvent> a owl:ObjectProperty ;
    rdfs:label "has member event"@en ;
    rdfs:comment "This property relates a recurrent event, as a collection of events, to one of its member events."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/cultural-event/RecurrentEvent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasMember> ;
    owl:inverseOf <https://w3id.org/arco/ontology/cultural-event/isEventMemberOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/hasPreviousEvent> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has previous event"@en ;
    rdfs:comment "This property relates an event that is member of a recurrent event, as a collection, to one of the previous events."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/follows> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/l0/Agent> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/l0/Entity> .

<http://dati.beniculturali.it/cis/CulturalEvent> a owl:Class .

<https://w3id.org/arco/ontology/cultural-event/RecurrentEvent> a owl:Class ;
    rdfs:label "Recurrent event"@en ;
    rdfs:comment "This class represents a recurrent event, that is an event as a collection of sequential events and identified by at least one unifying factor (e.g.: topic, place)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/cultural-event/hasMemberEvent> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/l0/EventOrSituation> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/cultural-event/hasRecurrentTimePeriod> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> ],
        [ a owl:Class ;
            owl:intersectionOf ( <https://w3id.org/arco/ontology/core/Situation> <https://w3id.org/italia/onto/l0/Collection> ) ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/cultural-event/hasUnifyingFactor> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/cultural-event/UnifyingFactor> ] ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/cultural-event/hasMemberEvent> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( [ a owl:Restriction ;
                                owl:onProperty <https://w3id.org/arco/ontology/cultural-event/hasNextEvent> ;
                                owl:someValuesFrom <https://w3id.org/italia/onto/l0/EventOrSituation> ] [ a owl:Restriction ;
                                owl:onProperty <https://w3id.org/arco/ontology/cultural-event/hasPreviousEvent> ;
                                owl:someValuesFrom <https://w3id.org/italia/onto/l0/EventOrSituation> ] ) ] ] ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa BDI 4.00: RC" .

<https://w3id.org/italia/onto/l0/Entity> a owl:Class .

<https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> a owl:Class ;
    rdfs:label "Recurrent time period"@en ;
    rdfs:comment "This class represents the time period that elapses between one of the member events of a recurrent event, as a collection of events, and the next one."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/cultural-event/hasTimePeriodMeasurementUnit> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/cultural-event/isRecurrentTimePeriodOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/cultural-event/RecurrentEvent> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/cultural-event/timePeriodValue> ;
            owl:someValuesFrom xsd:integer ] ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/cultural-event/TimePeriodMeasurementUnit> a owl:Class ;
    rdfs:label "Time period measurement unit"@en ;
    rdfs:comment "This class represents the unit of measurement associated to the maximum time period that elapses between one of the member events of a recurrent event, as a collection of events, and the next one."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/cultural-event/isTimePeriodMeasurementUnitOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/cultural-event/RecurrentTimePeriod> ],
        <https://w3id.org/italia/onto/MU/MeasurementUnit> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/l0/EventOrSituation> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/l0/Entity> .

onto: a owl:Ontology ;
    rdfs:label "Cultural Event Ontology (ArCo network)"@en ;
    dc:creator "Aldo Gangemi (ISTC-CNR, STLab)",
        "Andrea Nuzzolese (ISTC-CNR, STLab)",
        "Chiara Veninata (MiBACT, ICCD)",
        "Ludovica Marinucci (ISTC-CNR, STLab)",
        "Marialetizia Mancinelli (MiBACT, ICCD)",
        "Valentina Carriero (ISTC-CNR, STLab)",
        "Valentina Presutti (ISTC-CNR, STLab)" ;
    dc:description "The Cultural Event module models cultural events, i.e. events involving cultural properties."@en ;
    dc:language <http://publications.europa.eu/resource/authority/language/ENG>,
        <http://publications.europa.eu/resource/authority/language/ITA> ;
    dc:title "Cultural Event Ontology (ArCo network)"@en ;
    dcterms:issued "2018-03-07" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/>,
        <https://w3id.org/italia/controlled-vocabulary/licences/A31_CCBYSA40> ;
    dcterms:modified "2019-06-01" ;
    ns1:reusesPatternAsTemplate <http://ontologydesignpatterns.org/cp/owl/sequence.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl> ;
    rdfs:comment "The Cultural Event module models cultural events, i.e. events involving cultural properties.\\nIn this module are used as template the following Ontology Design Patterns:\\n- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/sequence.owl"@en ;
    owl:imports <https://w3id.org/arco/ontology/catalogue>,
        <https://w3id.org/arco/ontology/core> ;
    owl:versionInfo "Version 1.0"@en .

