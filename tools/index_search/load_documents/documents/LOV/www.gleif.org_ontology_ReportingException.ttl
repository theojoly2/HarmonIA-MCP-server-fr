@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://www.gleif.org/ontology/Base/> .
@prefix onto: <https://www.gleif.org/ontology/ReportingException/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:DirectConsolidationReportingException a owl:Class ;
    rdfs:label "direct consolidation reporting exception" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ReportingException ;
    skos:definition "The legal entity has declined to report a direct accounting consolidation parent, based on applicable accounting standards." ;
    ns1:hasTag "DIRECT_ACCOUNTING_CONSOLIDATION_PARENT" .

onto:ExceptionReasonKindBindingLegalCommitments a owl:NamedIndividual,
        onto:ExceptionReasonKind ;
    rdfs:label "binding legal commitments" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Binding legal commitments (other than the laws or regulations of a jurisdiction), such as articles governing the legal entity or a contract, prevent providing or publishing this information. The LOU is not expected to verify or analyze whether the legal framework constitutes a legal obstacle." ;
    ns1:hasTag "BINDING_LEGAL_COMMITMENTS" .

onto:UltimateConsolidationReportingException a owl:Class ;
    rdfs:label "ultimate consolidation reporting exception" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ReportingException ;
    skos:definition "The legal entity has declined to report an ultimate accounting consolidation parent, based on applicable accounting standards." ;
    ns1:hasTag "ULTIMATE_ACCOUNTING_CONSOLIDATION_PARENT" .

onto:hasExceptionReason a owl:ObjectProperty ;
    rdfs:label "has exception reason" ;
    rdfs:domain onto:ReportingException ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ExceptionReasonKind ;
    skos:definition "A single reason provided by the legal entity for declining to provide the mandatory report of a specified type of information (beyond the minimum reference data needed purely for identification of the legal entity)." .

onto:hasExceptionReference a owl:DatatypeProperty ;
    rdfs:label "has exception reference" ;
    rdfs:domain onto:ReportingException ;
    rdfs:isDefinedBy onto: ;
    skos:definition "References of the law, regulation or other element of the legal framework to support reason(s) provided by the legal entity for declining to provide information on its parents." .

onto:hasReportingEntity a owl:ObjectProperty ;
    rdfs:label "has reporting entity" ;
    rdfs:domain onto:ReportingException ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://www.gleif.org/ontology/L1/RegisteredEntity> ;
    skos:definition "The LEI-registered legal entity which raised this exception." .

onto:ExceptionReasonKindConsentNotObtained a owl:NamedIndividual,
        onto:ExceptionReasonKind ;
    rdfs:label "consent not obtained" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "There is no parent according to the definition used, because there is no known person controlling the entity (e.g., diversified shareholding)." ;
    ns1:hasTag "CONSENT_NOT_OBTAINED" .

onto:ExceptionReasonKindDetrimentNotExcluded a owl:NamedIndividual,
        onto:ExceptionReasonKind ;
    rdfs:label "detriment not excluded" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "The child entity has sought to consult the parent entity about the reporting of the parent information to the GLEIS but could not confirm the absence of detriment in a way that can appropriately prevent liability risks for the child entity (or those acting on its behalf) under the applicable legal framework. The disclosure of this information would be detrimental to the legal entity or the relevant parent. This will include reasons generally accepted by public authorities in similar circumstances, based on a declaration by the entity. \\n  This reason may be used only when all following cumulative circumstances apply: [i) the parent could not be informed via the GLEIS and have the possibility to correct the relationship information before publication (including raising a cause for opt out, either because the parent does not have an LEI, or it has an LEI but the GLEIS has not yet implemented such system;] ii) the relationship is not already in the public domain (information being in the public domain assumes here that the way the information came into the public domain did not infringe the applicable legal framework); iii) the child entity has reasons to believe that the parent may consider disclosure to be detrimental; (iv) the child entity has sought to consult the parent entity of the reporting of the parent information to the GLEIS but could not confirm the absence of detriment in a way that can appropriately prevent liability risks for the child entity (or those acting on its behalf) under the applicable legal framework." ;
    ns1:hasTag "DETRIMENT_NOT_EXCLUDED" .

onto:ExceptionReasonKindDisclosureDetrimental a owl:NamedIndividual,
        onto:ExceptionReasonKind ;
    rdfs:label "disclosure detrimental" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "The disclosure of this information would be detrimental to the legal entity or the relevant parent. This will include reasons generally accepted by public authorities in similar circumstances, based on a declaration by the entity." ;
    ns1:hasTag "DISCLOSURE_DETRIMENTAL" .

onto:ExceptionReasonKindLegalObstacles a owl:NamedIndividual,
        onto:ExceptionReasonKind ;
    rdfs:label "legal obstacles" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Obstacles in the laws or regulations of a jurisdiction prevent providing or publishing this information. This does not include cases where, under the applicable legal framework disclosing the parent relationship would require the consent of one of the entities in the relationship, or both, and such consent could not be obtained (in these cases 'CONSENT_NOT_OBTAINED' is the applicable code). The LOU is not expected to verify or analyze whether the legal framework constitutes a legal obstacle." ;
    ns1:hasTag "LEGAL_OBSTACLES" .

onto:ExceptionReasonKindNaturalPersons a owl:NamedIndividual,
        onto:ExceptionReasonKind ;
    rdfs:label "natural persons" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "There is no parent according to the definition used, because the entity is controlled by natural person(s) without any intermediate legal entity meeting the definition of accounting consolidating parent." ;
    ns1:hasTag "NATURAL_PERSONS" .

onto:ExceptionReasonKindNoKnownPerson a owl:NamedIndividual,
        onto:ExceptionReasonKind ;
    rdfs:label "no known person" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "There is no parent according to the definition used, because there is no known person controlling the entity (e.g., diversified shareholding)." ;
    ns1:hasTag "NO_KNOWN_PERSON" .

onto:ExceptionReasonKindNoLEI a owl:NamedIndividual,
        onto:ExceptionReasonKind ;
    rdfs:label "no LEI" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "The parent does not consent to have an LEI." ;
    ns1:hasTag "NO_LEI" .

onto:ExceptionReasonKindNonConsolidating a owl:NamedIndividual,
        onto:ExceptionReasonKind ;
    rdfs:label "non consolidating" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "There is no parent according to the definition used, because the entity is controlled by legal entities not subject to preparing consolidated financial statements." ;
    ns1:hasTag "NON_CONSOLIDATING" .

onto:ReportingException a owl:Class ;
    rdfs:label "reporting exception" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:hasExceptionReference ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass onto:ExceptionReasonKind ;
            owl:onProperty onto:hasExceptionReason ],
        [ a owl:Restriction ;
            owl:onClass <https://www.gleif.org/ontology/L1/RegisteredEntity> ;
            owl:onProperty onto:hasReportingEntity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A single exception to a specified reporting requirement, giving reasons and references where applicable." .

onto:ExceptionReasonKind a owl:Class ;
    rdfs:label "exception reason" ;
    rdfs:isDefinedBy onto: ;
    owl:oneOf ( onto:ExceptionReasonKindNoLEI onto:ExceptionReasonKindNaturalPersons onto:ExceptionReasonKindNonConsolidating onto:ExceptionReasonKindNoKnownPerson onto:ExceptionReasonKindLegalObstacles onto:ExceptionReasonKindConsentNotObtained onto:ExceptionReasonKindLegalCommitments onto:ExceptionReasonKindDetrimentNotExcluded onto:ExceptionReasonKindDisclosureDetrimental ) ;
    skos:definition "A single reason provided by the legal entity for declining to provide the mandatory report of a specified type of information (beyond the minimum reference data needed purely for identification of the legal entity). " .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "GLEIF Reporting Exception Ontology" ;
    dcterms:abstract "Ontology for representing exceptions to reporting of parents, for entities registered with a Legal Entity Identifier. The Global Legal Identifier System (GLEIS) requires that legal entities with an LEI provide information on their ultimate and direct accounting consolidating parents. Relationship reporting is mandatory with exceptions allowed for certain well-defined reasons. This ontology provides a simple structure for recording reasons for each exception by LEI." ;
    dcterms:contributor <http://purl.org/bryon>,
        <http://www.workingontologist.com>,
        <https://www.linkedin.com/in/peterivett/> ;
    dcterms:creator ns1:GLEIF ;
    dcterms:issued "2019-02-01T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license "https://www.gleif.org/en/meta/lei-data-terms-of-use/"^^xsd:anyURI ;
    dcterms:rights "Copyright (c) 2019 Global Legal Entity Identifier Foundation (GLEIF)" ;
    dcterms:rightsHolder ns1:GLEIF ;
    dcterms:source "https://www.gleif.org/en/about-lei/common-data-file-format/level-2-data-reporting-exceptions-format"^^xsd:anyURI ;
    dcterms:title "Global Legal Entity Identifier Foundation Reporting Exception Ontology"@en ;
    vann:preferredNamespacePrefix "gleif-repex" ;
    vann:preferredNamespaceUri "https://www.gleif.org/ontology/ReportingException/" ;
    owl:imports <https://www.gleif.org/ontology/L1/>,
        <https://www.gleif.org/ontology/L2/> ;
    owl:versionIRI <https://www.gleif.org/ontology/ReportingException-v1.0/ReportingException/> .

[] a owl:AllDifferent ;
    owl:members ( onto:ExceptionReasonKindNoLEI onto:ExceptionReasonKindNaturalPersons onto:ExceptionReasonKindNonConsolidating onto:ExceptionReasonKindNoKnownPerson onto:ExceptionReasonKindLegalObstacles onto:ExceptionReasonKindConsentNotObtained onto:ExceptionReasonKindLegalCommitments onto:ExceptionReasonKindDetrimentNotExcluded onto:ExceptionReasonKindDisclosureDetrimental ) .

