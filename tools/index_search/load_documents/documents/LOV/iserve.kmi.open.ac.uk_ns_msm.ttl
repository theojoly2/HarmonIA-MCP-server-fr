@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix onto: <http://iserve.kmi.open.ac.uk/ns/msm> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://iserve.kmi.open.ac.uk/ns/msm#MessageContent> a rdfs:Class ;
    rdfs:label "Message Content"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://iserve.kmi.open.ac.uk/ns/msm#MessagePart> ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#MessagePart> a rdfs:Class ;
    rdfs:label "Message Part"@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#Operation> a rdfs:Class ;
    rdfs:label "Operation"@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#Service> a rdfs:Class ;
    rdfs:label "Service"@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasInput> a rdf:Property ;
    rdfs:label "has Input"@en ;
    rdfs:domain <http://iserve.kmi.open.ac.uk/ns/msm#Operation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iserve.kmi.open.ac.uk/ns/msm#MessageContent> ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasInputFault> rdfs:label "has Input Fault"@en ;
    rdfs:domain <http://iserve.kmi.open.ac.uk/ns/msm#Operation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iserve.kmi.open.ac.uk/ns/msm#MessageContent> ;
    rdfs:subPropertyOf <http://iserve.kmi.open.ac.uk/ns/msm#hasFault> ;
    ns1:term_status "archaic" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasMandatoryPart> a rdf:Property ;
    rdfs:label "has Mandatory Part"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://iserve.kmi.open.ac.uk/ns/msm#hasPart> ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasName> a rdf:Property ;
    rdfs:label "has Name"@en ;
    rdfs:domain <http://iserve.kmi.open.ac.uk/ns/msm#MessagePart> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasOperation> a rdf:Property ;
    rdfs:label "has Operation"@en ;
    rdfs:domain <http://iserve.kmi.open.ac.uk/ns/msm#Service> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iserve.kmi.open.ac.uk/ns/msm#Operation> ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasOptionalPart> a rdf:Property ;
    rdfs:label "has Optional Part"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://iserve.kmi.open.ac.uk/ns/msm#hasPart> ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasOutput> a rdf:Property ;
    rdfs:label "has Output"@en ;
    rdfs:domain <http://iserve.kmi.open.ac.uk/ns/msm#Operation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iserve.kmi.open.ac.uk/ns/msm#MessageContent> ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasOutputFault> rdfs:label "has Output Fault"@en ;
    rdfs:domain <http://iserve.kmi.open.ac.uk/ns/msm#Operation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iserve.kmi.open.ac.uk/ns/msm#MessageContent> ;
    rdfs:subPropertyOf <http://iserve.kmi.open.ac.uk/ns/msm#hasFault> ;
    ns1:term_status "archaic" .

<http://iserve.kmi.open.ac.uk/ns/msm#isGroundedIn> a rdf:Property ;
    rdfs:label "is grounded in"@en ;
    rdfs:domain <http://iserve.kmi.open.ac.uk/ns/msm#MessagePart>,
        <http://iserve.kmi.open.ac.uk/ns/msm#Operation>,
        <http://iserve.kmi.open.ac.uk/ns/msm#Service> ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasPartTransitive> a owl:TransitiveProperty ;
    rdfs:label "has Part Transitive"@en ;
    rdfs:domain <http://iserve.kmi.open.ac.uk/ns/msm#MessagePart> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iserve.kmi.open.ac.uk/ns/msm#MessagePart> ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasFault> a rdf:Property ;
    rdfs:label "has Fault"@en ;
    rdfs:domain <http://iserve.kmi.open.ac.uk/ns/msm#Operation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iserve.kmi.open.ac.uk/ns/msm#MessageContent> ;
    ns1:term_status "stable" .

<http://iserve.kmi.open.ac.uk/ns/msm#hasPart> a rdf:Property ;
    rdfs:label "has Part"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://iserve.kmi.open.ac.uk/ns/msm#hasPartTransitive> ;
    ns1:term_status "stable" .

onto: a owl:Ontology ;
    rdfs:label "Minimal Service Model"@en ;
    dcterms:created "2010-03-10"^^xsd:date ;
    dcterms:creator <http://identifiers.kmi.open.ac.uk/people/carlos-pedrinaci/>,
        <http://jacek.cz/#me>,
        <http://kmi.open.ac.uk/>,
        <http://kmi.open.ac.uk/people/member/luca-panziera> ;
    dcterms:description "This is a simple ontology that provides the core vocabulary for capturing service properties"@en ;
    dcterms:issued "2010-03-10"^^xsd:date ;
    dcterms:modified "2011-12-03"^^xsd:date,
        "2012-03-14"^^xsd:date,
        "2013-05-03"^^xsd:date,
        "2013-11-21"^^xsd:date,
        "2014-09-03"^^xsd:date ;
    owl:imports <http://www.w3.org/ns/sawsdl>,
        <http://www.wsmo.org/ns/wsmo-lite> ;
    owl:versionInfo "1.3" .

