    rdfs:label "GLP-1 Mimetics"^^xsd:string ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/NCIT_C29711> .

<http://purl.org/twc/dpo/ont/AntihyperglycemicTreatment> rdfs:label "Antihyperglycemic Treatment"^^xsd:string ;
    rdfs:comment "Treatment designed to lower blood sugar levels."^^xsd:string ;
    rdfs:subClassOf <http://purl.org/twc/dpo/ont/Therapy> ;
    owl:equivalentClass <http://purl.obolibrary.org/obo/CHEBI_35526> ;
    skos:definition "A drug which lowers the blood glucose level. [Definition Source: CHEBI]"^^xsd:string .

<http://purl.org/twc/dpo/ont/PatientCharacteristic> a owl:Class ;
