<http://purl.org/twc/dpo/ont/AtheroscleroticCardiovascularDiseaseRisk> rdfs:label "Atherosclerotic Cardiovascular Disease Risk" ;
    rdfs:comment "Risk of cardiovascular disease resulting from atherosclerosis."^^xsd:string ;
    rdfs:subClassOf <http://purl.org/twc/dpo/ont/CardiovascularEffect> ;
