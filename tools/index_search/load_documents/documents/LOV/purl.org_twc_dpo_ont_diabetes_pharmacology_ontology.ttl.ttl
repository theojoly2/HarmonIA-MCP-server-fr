    rdfs:subClassOf <http://purl.obolibrary.org/obo/NCIT_C29711> .

<http://purl.obolibrary.org/obo/NCIT_C98086> a owl:Class ;
    rdfs:label "Dipeptidyl Peptidase-4 Inhibitor"^^xsd:string ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/NCIT_C29711> .

<http://purl.org/twc/dpo/ont/CholesterolMeasurement> a owl:Class ;
    rdfs:label "Cholesterol Measurement"^^xsd:string ;
