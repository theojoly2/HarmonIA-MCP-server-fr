<http://data.lirmm.fr/ontologies/food#sugarsPer100g> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Nutrition data: sugars (in g) per 100g (or 100ml for liquids)" ;
    rdfs:range rdfs:Literal .

<http://data.lirmm.fr/ontologies/food#transFatPer100g> a rdf:Property,
