<http://data.lirmm.fr/ontologies/food#potassiumPer100g> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Nutrition data: potassium (in g) per 100g (or 100ml for liquids)" ;
    rdfs:domain <http://data.lirmm.fr/ontologies/food#Food> ;
    rdfs:range xsd:decimal .

<http://data.lirmm.fr/ontologies/food#proteinsPer100g> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Nutrition data: proteins (in g) per 100g (or 100ml for liquids)" ;
    rdfs:domain <http://data.lirmm.fr/ontologies/food#Food> ;
    rdfs:range xsd:decimal .

<http://data.lirmm.fr/ontologies/food#quantity> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "quantity of ingredient in any unit (unit specified in unit)" ;
    rdfs:comment "e.g. 1 clove of garlic -> quantity = 1, unit = clove, ingredient = garlic (or Food object for garlic)" ;
    rdfs:domain <http://data.lirmm.fr/ontologies/food#Ingredient> ;
    rdfs:range rdfs:Literal .

<http://data.lirmm.fr/ontologies/food#rank> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Rank of an ingredient in an ingredient list ordered by quantity (e.g. food products)" ;
    rdfs:domain <http://data.lirmm.fr/ontologies/food#Ingredient> ;
    rdfs:range xsd:integer .

<http://data.lirmm.fr/ontologies/food#rdf> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    ns1:accessURL "http://data.lirmm.fr/ontologies/food.rdf" ;
    ns1:status <http://purl.org/adms/status/Completed> .

