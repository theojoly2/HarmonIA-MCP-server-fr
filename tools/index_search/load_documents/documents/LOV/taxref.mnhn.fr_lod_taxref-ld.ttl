<http://taxref.mnhn.fr/lod/Catalog> a dcat:Catalog ;
    rdfs:label "Catalog of TAXREF-LD datasets"@en,
        "Catalogue des jeux de données TAXREF-LD"@fr ;
    dcterms:language <http://data.bnf.fr/ark:/12148/cb119308987>,
        <http://data.bnf.fr/ark:/12148/cb11935375d>,
        <http://id.loc.gov/vocabulary/iso639-1/en>,
        <http://id.loc.gov/vocabulary/iso639-1/fr> ;
    dcterms:publisher <http://taxref.mnhn.fr/lod/INPN>,
        <https://ror.org/02feahw73>,
        <https://ror.org/02kvxyf05>,
        <https://ror.org/03wkt5x30>,
        <https://ror.org/0496p8026> ;
    dcterms:title "Catalog of TAXREF-LD datasets"@en,
        "Catalogue des jeux de données TAXREF-LD"@fr ;
    dcat:dataset <http://taxref.mnhn.fr/lod/taxref>,
        onto: ;
    foaf:page <https://github.com/frmichel/taxref-ld/> .

