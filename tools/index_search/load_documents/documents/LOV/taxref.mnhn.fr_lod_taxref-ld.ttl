<http://taxref.mnhn.fr/lod/femelle_Organisms> rdfs:label "female oganisms"@en,
        "oganismes femelles"@fr ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://www.wikidata.org/entity/Q6581072> ;
            owl:onProperty ns6:hasSex ],
        <http://purl.obolibrary.org/obo/BILA_0000028>,
        <http://www.wikidata.org/entity/Q43445> .

<http://taxref.mnhn.fr/lod/habitat/Habitat> rdfs:label "Class of habitats"@en ;
    dcterms:description "Class of types of habitat (subclass of skos:Concept)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf skos:Concept ;
    owl:deprecated true ;
    owl:equivalentClass <http://lod.taxonconcept.org/ontology/txn.owl#Habitat> .

<http://taxref.mnhn.fr/lod/habitat/HabitatCollection> a skos:Collection ;
    rdfs:label "Collection of habitat concepts"@en ;
    rdfs:isDefinedBy onto: ;
    skos:member <http://taxref.mnhn.fr/lod/habitat/BrackishWater>,
        <http://taxref.mnhn.fr/lod/habitat/FreshWater>,
        <http://taxref.mnhn.fr/lod/habitat/Marine>,
        <http://taxref.mnhn.fr/lod/habitat/Terrestrial> .

<http://taxref.mnhn.fr/lod/loc/MaritimeArea> rdfs:label "Maritime area"@en ;
    dcterms:description "Maritime area different from seas, oceans, territorial waters and EEZ."@en ;
    rdfs:comment "A maritime area, generally surrounding a landmass, that does not correspond to any specific sea or ocean, nor to any internationally recognized administrative subdivision (i.e. territorial waters or EEZ)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.wikidata.org/entity/Q1496967>,
        <http://www.wikidata.org/entity/Q15324> .

<http://taxref.mnhn.fr/lod/mâle_Organisms> rdfs:label "male oganisms"@en,
        "oganismes mâles"@fr ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://www.wikidata.org/entity/Q6581097> ;
            owl:onProperty ns6:hasSex ],
        <http://purl.obolibrary.org/obo/BILA_0000027>,
        <http://www.wikidata.org/entity/Q44148> .

ns6:bioGeoStatusIn a owl:ObjectProperty ;
    rdfs:label "has biogeograpical status"@en ;
    dcterms:description "(deprecated). Relates a taxon to a biogeograpical status within a certain region. As of TAXREF v12, this property should no longer be used. Instead use class taxrefstatus:BioGeographicalStatus"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://taxref.mnhn.fr/lod/bioGeoStatus/BioGeographicalStatus> ;
    owl:deprecated true .

ns6:habitat a owl:AnnotationProperty ;
    rdfs:label "has habitat"@en ;
    dcterms:description "Relates a taxon to an habitat in which it lives"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://lod.taxonconcept.org/ontology/txn.owl#habitat>,
        <http://purl.obolibrary.org/obo/RO_0002303>,
        <http://rs.tdwg.org/dwc/iri/habitat> ;
    owl:equivalentProperty <http://www.wikidata.org/prop/direct/P2974> .

ns6:hasAuthority a owl:AnnotationProperty ;
    rdfs:label "has scientific name authority"@en ;
    dcterms:description "Provides the authorship information of a scientific name"@en ;
    rdfs:comment "TDWG ontology's property http://rs.tdwg.org/ontology/voc/TaxonName#authorship is preferably associated with a scientific name (http://rs.tdwg.org/ontology/voc/TaxonName#TaxonName), which is in line with TAXREF-LD's modelling. By contrast, DwC's scientificNameAuthorship property is associated with a taxon (dwc:Taxon), and its object shoud be a literal (DwC does not have a class for taxon names). Therefore, TAXREF-LD's hasAuthority property is not equivalent to the latter."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://rs.tdwg.org/dwc/terms/scientificNameAuthorship> ;
    owl:equivalentProperty <http://lod.taxonconcept.org/ontology/txn.owl#authority>,
        <http://rs.tdwg.org/ontology/voc/TaxonName#authorship> .

ns6:hasRank a owl:AnnotationProperty ;
    rdfs:label "has taxonomic rank"@en ;
    dcterms:description "Relates a scientific name or a taxon to a taxonimical rank"@en ;
    rdfs:comment "This property is not equivalent to dwc:taxonRank which is expected to be used only with literal values (see http://rs.tdwg.org/dwc/terms/guides/rdf/index.htm, section 3.5)"@en,
        "This property is not equivalent to http://rs.tdwg.org/ontology/voc/TaxonConcept#rank nor http://rs.tdwg.org/ontology/voc/TaxonName#rank whose domains are http://rs.tdwg.org/ontology/voc/TaxonConcept#TaxonConcept and http://rs.tdwg.org/ontology/voc/TaxonName#TaxonName respectively, whereas we want to use taxrefprop:hasRank with taxa implemented as owl:Class's as well as scientific names implemented as instances of skos:Concept. "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://rs.tdwg.org/dwc/terms/taxonRank>,
        <http://rs.tdwg.org/ontology/voc/TaxonConcept#rank>,
        <http://rs.tdwg.org/ontology/voc/TaxonName#rank> ;
    owl:equivalentProperty <http://purl.obolibrary.org/obo/ncbitaxon#has_rank>,
        <http://www.wikidata.org/prop/direct/P105> .

ns6:hasSpecificity a owl:ObjectProperty ;
    rdfs:label "has a specificity"@en ;
    dcterms:description "Specificity of the interaction"@en ;
    rdfs:isDefinedBy onto: .

ns6:hasStatus a owl:AnnotationProperty ;
    rdfs:label "has status"@en ;
    dcterms:description "Relates a taxon to one of its biogeographical, red list or legal statuses."@en ;
    rdfs:isDefinedBy onto: .

ns6:hasTrophicLevel a owl:AnnotationProperty ;
    rdfs:label "has trophic level"@en ;
    dcterms:description "Relates a taxon to its tophic level"@en ;
    rdfs:isDefinedBy onto: .

ns6:isReferenceNameOf a owl:AnnotationProperty ;
    rdfs:label "is the reference name of"@en ;
    dcterms:description "Relates a scientific name to the taxon for which it is the reference (valid) name"@en ;
    rdfs:isDefinedBy onto: ;
    owl:inverse ns6:hasReferenceName .

ns6:isSynonymOf a owl:AnnotationProperty ;
    rdfs:label "is a synonym of"@en ;
    dcterms:description "Relates a scientific name to a taxon for which it is a synonym"@en ;
    rdfs:isDefinedBy onto: ;
    owl:inverse ns6:hasSynonym .

ns6:statusType a owl:ObjectProperty ;
    rdfs:label "status type"@en ;
    dcterms:description "Relates a taxon status with the type of status which is a narrower concept of taxrefstatus:TaxonStatusType"@en ;
    rdfs:domain <http://taxref.mnhn.fr/lod/status/TaxonStatus> ;
    rdfs:isDefinedBy onto: .

ns6:statusValue a owl:ObjectProperty ;
    rdfs:label "status value"@en ;
    dcterms:description "Relates a taxon status with the actual status value"@en ;
    rdfs:domain <http://taxref.mnhn.fr/lod/status/TaxonStatus> ;
    rdfs:isDefinedBy onto: .

ns6:vernacularName a owl:AnnotationProperty ;
    rdfs:label "has vernacular name"@en ;
    dcterms:description "Relates a taxon to one of its vernacular (common) names"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://rdf.geospecies.org/ont/geospecies#hasVernacularName>,
        <http://rs.tdwg.org/dwc/terms/vernacularName> ;
    owl:equivalentProperty <http://www.wikidata.org/prop/direct/P1843> .

ns6:vernacularNameXL a owl:AnnotationProperty ;
    rdfs:label "has extended vernacular name"@en ;
    dcterms:description "Relates a taxon to one of its vernacular (common) names in the form of a SKOS extended label"@en ;
    rdfs:comment "This property was initially defined as a subPropertyOf skosxl:altLabel. However skosxl:altLabel is an owl:ObjectProperty and thus cannot apply to a class. Therefore, we instead define it a an owl:AnnotationProperty whose range is a skosxl:Label" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2008/05/skos-xl#Label> .

<http://taxref.mnhn.fr/lod/sparql-service> a dcat:DataService,
        ns2:Service ;
    rdfs:label "SPARQL endpoint serving the TAXREF-LD Knowledge Graph" ;
    dcat:endpointURL <http://taxref.mnhn.fr/sparql> ;
    dcat:servesDataset onto: ;
    ns2:availableGraphs [ a ns2:GraphCollection ;
            ns2:namedGraph <http://taxref.mnhn.fr/lod/graph/biblio>,
                <http://taxref.mnhn.fr/lod/graph/classes/15.0>,
                <http://taxref.mnhn.fr/lod/graph/concepts>,
                <http://taxref.mnhn.fr/lod/graph/dbxref/15.0>,
                <http://taxref.mnhn.fr/lod/graph/habitats/15.0>,
                <http://taxref.mnhn.fr/lod/graph/interactions/15.0>,
                <http://taxref.mnhn.fr/lod/graph/links-agrovoc>,
                <http://taxref.mnhn.fr/lod/graph/links-ncbi>,
                <http://taxref.mnhn.fr/lod/graph/links-worms>,
                <http://taxref.mnhn.fr/lod/graph/locations>,
                <http://taxref.mnhn.fr/lod/graph/media>,
                <http://taxref.mnhn.fr/lod/graph/metadata>,
                <http://taxref.mnhn.fr/lod/graph/statusCodes>,
                <http://taxref.mnhn.fr/lod/graph/statuses/15.0>,
                <http://taxref.mnhn.fr/lod/graph/vernacular/15.0> ] ;
    ns2:endpoint <http://taxref.mnhn.fr/sparql> ;
    ns2:supportedLanguage ns2:SPARQL10Query,
        ns2:SPARQL11Query .

<http://taxref.mnhn.fr/lod/specificity/SpecificityCollection> a skos:Collection ;
    rdfs:label "Collection of interaction specificities"@en ;
    rdfs:isDefinedBy onto: ;
    skos:member <http://taxref.mnhn.fr/lod/specificity/Mandatory>,
        <http://taxref.mnhn.fr/lod/specificity/Optional>,
        <http://taxref.mnhn.fr/lod/specificity/Principal>,
        <http://taxref.mnhn.fr/lod/specificity/Regular>,
        <http://taxref.mnhn.fr/lod/specificity/Sporadic> .

<http://taxref.mnhn.fr/lod/status/BioGeographicalStatus> rdfs:label "Biogeographical status of a taxon in a geographical area, according to a bibliographic source"@en ;
    rdfs:comment "The biogeographical status of a taxon with the geographical area where this status applies and the bibliographic source that assigned this status to that taxon"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://taxref.mnhn.fr/lod/status/TaxonStatus> .

<http://taxref.mnhn.fr/lod/status/EuropeanDirective> a skos:Concept ;
    skos:broader <http://taxref.mnhn.fr/lod/status/TaxonStatusType> ;
    skos:inScheme onto: ;
    skos:prefLabel "European Directive"@en,
        "Directive européenne"@fr .

<http://taxref.mnhn.fr/lod/status/InternationalConvention> a skos:Concept ;
    skos:broader <http://taxref.mnhn.fr/lod/status/TaxonStatusType> ;
    skos:inScheme onto: ;
    skos:prefLabel "International Convention"@en,
        "Convention internationale"@fr .

<http://taxref.mnhn.fr/lod/status/LegalStatus> rdfs:label "Status of a taxon attested by a legal document"@en ;
    rdfs:comment "To be used jointly with http://taxref.mnhn.fr/lod/status/TaxonStatusType whose narrower concepts represent directives, conventions, regulations or protections"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://taxref.mnhn.fr/lod/status/TaxonStatus> .

