        <http://taxref.mnhn.fr/lod/bioGeoStatus/B>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/C>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/D>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/E>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/I>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/J>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/M>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/P>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/Q>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/S>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/W>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/X>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/Y>,
        <http://taxref.mnhn.fr/lod/bioGeoStatus/Z> .

