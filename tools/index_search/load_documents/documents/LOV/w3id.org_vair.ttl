<https://w3id.org/vair#AdversarialAttack> a owl:Class,
        owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/vair#Concept> ;
    rdfs:label "Adversarial Attack"@en ;
    rdfs:comment "Inputs designed to cause the model to make a mistake"@en ;
