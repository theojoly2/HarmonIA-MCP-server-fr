onto: a owl:Ontology ;
    rdfs:label "Vocabulary of AI Risks"@en ;
    dcterms:bibliographicCitation "Delaram Golpayegani, Harshvardhan J. Pandit, and Dave Lewis. To Be High-Risk, or Not To Be—Semantic Specifications and Implications of the AI Act’s High-Risk AI Applications and Harmonised Standards. Proceedings of the 2023 ACM Conference on Fairness, Accountability, and Transparency. 2023" ;
    dcterms:contributor "Dave Lewis",
        "Harshvardhan J. Pandit" ;
    dcterms:created "2022-12-22"^^xsd:date ;
    dcterms:creator "Delaram Golpayegani" ;
    dcterms:description "VAIR is a taxonomy of AI and risk concepts."@en ;
    dcterms:issued "2023-01-01"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2024-07-18"^^xsd:date ;
    dcterms:publisher "ADAPT Centre, Trinity College Dublin" ;
    dcterms:source "EU AI Act"@en,
        "ISO 31000 series"@en,
        "ISO/IEC 22989:2023"@en ;
    dcterms:title "VAIR" ;
    ns1:doi "10.5281/zenodo.10894914"@en ;
    ns1:status "http://purl.org/ontology/bibo/status/published" ;
    vann:preferredNamespacePrefix "vair" ;
    vann:preferredNamespaceUri "https://w3id.org/vair#" ;
    owl:versionIRI <https://w3id.org/vair/1.0> ;
    owl:versionInfo "1.0"@en ;
    foaf:logo <https://github.com/DelaramGlp/airo/blob/main/figures/airo-logo.png?raw=true> .

<https://w3id.org/vair#AGI> a owl:Class,
        owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/vair#Concept> ;
    rdfs:label "Artificial General Intelligence"@en ;
    dcterms:source "ISO/IEC 22989, 3.1.14" ;
    rdfs:comment "Type of AI system that addresses a broad range of tasks with a satisfactory level of performance."@en ;
    rdfs:isDefinedBy <https://w3id.org/vair#> ;
    rdfs:subClassOf <https://w3id.org/airo#AISystem> ;
    skos:definition "Type of AI system that addresses a broad range of tasks with a satisfactory level of performance."@en ;
    skos:inScheme <https://w3id.org/vair#> ;
    skos:prefLabel "Artificial General Intelligence"@en ;
    skos:related <https://w3id.org/vair#GeneralAI> .

<https://w3id.org/vair#AICards> a owl:Class,
        owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/vair#Concept> ;
    rdfs:label "AI Cards"@en ;
    rdfs:comment "A form of AI documentation"@en ;
    rdfs:isDefinedBy <https://w3id.org/vair#> ;
    rdfs:subClassOf <https://w3id.org/airo#Documentation> ;
    skos:definition "A form of AI documentation"@en ;
    skos:inScheme <https://w3id.org/vair#> ;
    skos:prefLabel "AI Cards"@en .

<https://w3id.org/vair#AIComponent> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/vair#Concept> ;
    rdfs:isDefinedBy <https://w3id.org/vair#> ;
    skos:definition "functional element that constructs an AI system. [ISo/IEC 22989, 3.1.2]"@en ;
    skos:inScheme <https://w3id.org/vair#> ;
    skos:prefLabel "AI Component"@en .

<https://w3id.org/vair#Action> a owl:Class,
        owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/vair#Concept> ;
    rdfs:label "Action"@en ;
    rdfs:comment "Action performed by a system."@en ;
    rdfs:isDefinedBy <https://w3id.org/vair#> ;
    rdfs:subClassOf <https://w3id.org/airo#Output> ;
    skos:definition "Action performed by a system."@en ;
    skos:inScheme <https://w3id.org/vair#> ;
    skos:prefLabel "Action"@en .

<https://w3id.org/vair#ActionRecognition> a owl:Class,
        owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/vair#Concept> ;
    rdfs:label "Action Recognition"@en ;
    dcterms:source "AI Watch, Defining Artificial Intelligence 2.0" ;
    rdfs:comment "The capability to recognise actions"@en ;
    rdfs:isDefinedBy <https://w3id.org/vair#> ;
    rdfs:subClassOf <https://w3id.org/vair#ComputerVision> ;
    skos:definition "The capability to recognise actions"@en ;
    skos:inScheme <https://w3id.org/vair#> ;
    skos:prefLabel "Action Recognition"@en .

<https://w3id.org/vair#ActiveInvolvement> a owl:Class,
        owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/vair#Concept> ;
    rdfs:label "Active Involvement"@en ;
    rdfs:comment "Represents active interactation with an AI system."@en ;
    rdfs:isDefinedBy <https://w3id.org/vair#> ;
    rdfs:subClassOf <https://w3id.org/airo#HumanInvolvement> ;
    skos:definition "Represents active interactation with an AI system."@en ;
    skos:inScheme <https://w3id.org/vair#> ;
    skos:prefLabel "Active Involvement"@en .

<https://w3id.org/vair#AdministrationOfDemocraticProcesses> a owl:Class,
