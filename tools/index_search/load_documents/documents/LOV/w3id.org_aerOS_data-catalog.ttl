@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/mod#> .
@prefix onto: <https://w3id.org/aerOS/data-catalog#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:conformsTo a owl:DatatypeProperty ;
    rdfs:label "conforms to" ;
    rdfs:isDefinedBy dcterms: .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:isDefinedBy dcterms: .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:publisher a owl:ObjectProperty ;
    rdfs:label "publisher" ;
    rdfs:isDefinedBy dcterms: .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:example a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://w3id.org/rml/TriplesMap> a owl:Class ;
    rdfs:label "Triples Map" ;
    rdfs:isDefinedBy <http://w3id.org/rml/> .

xsd:date a rdfs:Datatype .

owl:versionInfo a owl:AnnotationProperty .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "in scheme" ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme .

dcat:accessService a owl:ObjectProperty ;
    rdfs:label "access service" ;
    rdfs:domain dcat:Distribution ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
    rdfs:range dcat:DataService .

dcat:accessURL a owl:DatatypeProperty ;
    rdfs:label "access url" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

dcat:catalog a owl:ObjectProperty ;
    rdfs:label "catalog" ;
    rdfs:domain dcat:Catalog ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
    rdfs:range dcat:Catalog .

dcat:distribution a owl:ObjectProperty ;
    rdfs:label "distribution" ;
    rdfs:domain dcat:Dataset ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
    rdfs:range dcat:Distribution .

dcat:endpointURL a owl:DatatypeProperty ;
    rdfs:label "endpoint url" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

dcat:keyword a owl:DatatypeProperty ;
    rdfs:label "keyword" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

dcat:mediaType a owl:DatatypeProperty ;
    rdfs:label "media type" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

dcat:theme a owl:ObjectProperty ;
    rdfs:label "theme" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

dcat:themeTaxonomy a owl:ObjectProperty ;
    rdfs:label "theme taxonomy" ;
    rdfs:domain dcat:Catalog ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

org:member a owl:ObjectProperty ;
    rdfs:label "member" ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy org: .

org:organization a owl:ObjectProperty ;
    rdfs:label "organization" ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy org: ;
    rdfs:range org:Organization .

org:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy org: ;
    rdfs:range org:Role .

<https://w3id.org/aerOS/continuum#User> a owl:Class ;
    rdfs:label "User" ;
    rdfs:isDefinedBy <https://w3id.org/aerOS/continuum> .

<https://w3id.org/aerOS/continuum#domain> a owl:ObjectProperty ;
    rdfs:label "domain" ;
    rdfs:isDefinedBy <https://w3id.org/aerOS/continuum> ;
    rdfs:range <https://w3id.org/aerOS/continuum#Domain> .

onto:DataProductOwner a owl:NamedIndividual,
        org:Role ;
    rdfs:label "Data Product Owner" ;
    rdfs:comment "Person responsible for the creation and publication of a data product." ;
    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog> .

onto:contextBroker a owl:ObjectProperty ;
    rdfs:label "context broker" ;
    rdfs:comment "Relation with a context broker." ;
    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog> ;
    rdfs:range onto:ContextBroker ;
    rdfs:subPropertyOf dcat:service .

onto:dataProduct a owl:ObjectProperty ;
    rdfs:label "data product" ;
    rdfs:comment "Relation with a data product." ;
    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog> ;
    rdfs:range onto:DataProduct ;
    rdfs:subPropertyOf dcat:dataset .

onto:servesDataProduct a owl:ObjectProperty ;
    rdfs:label "serves data product" ;
    rdfs:comment "Denotes a data product exposed by a data service." ;
    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog> ;
    rdfs:range onto:DataProduct ;
    rdfs:subPropertyOf dcat:servesDataset .

ns1:createdWith a owl:AnnotationProperty .

skos:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

dcat:dataset a owl:ObjectProperty ;
    rdfs:label "dataset" ;
    rdfs:domain dcat:Catalog ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
    rdfs:range dcat:Dataset .

dcat:servesDataset a owl:ObjectProperty ;
    rdfs:label "serves dataset" ;
    rdfs:domain dcat:DataService ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
    rdfs:range dcat:Dataset .

dcat:service a owl:ObjectProperty ;
    rdfs:label "service" ;
    rdfs:domain dcat:Catalog ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> ;
    rdfs:range dcat:DataService .

org:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:isDefinedBy org: .

<https://w3id.org/aerOS/continuum#Domain> a owl:Class ;
    rdfs:label "Domain" ;
    rdfs:isDefinedBy <https://w3id.org/aerOS/continuum> .

onto: a owl:Ontology ;
    rdfs:label "aerOS Data Catalog Ontology"@en ;
    dcterms:creator "Ignacio Dominguez Martinez-Casanueva" ;
    dcterms:description "\\n                                        Ontology that defines concepts for representing the aerOS Data Catalog\\n                                        " ;
    dcterms:license <http://purl.org/NET/rdflicense/APACHE2.0> ;
    dcterms:modified "2024-08-23"^^xsd:date ;
    dcterms:source <https://gitlab.aeros-project.eu/wp4/t4.1/data-catalog-ontology> ;
    dcterms:title "aerOS Data Catalog Ontology" ;
    vann:preferredNamespacePrefix "aerdcat" ;
    vann:preferredNamespaceUri onto: ;
    owl:versionIRI <https://w3id.org/aerOS/data-catalog> ;
    owl:versionInfo "1.0.0" ;
    ns1:createdWith <https://chowlk.linkeddata.es/> .

onto:ContextBroker a owl:Class ;
    rdfs:label "Context Broker" ;
    rdfs:comment "Represents an NGSI-LD Context Broker." ;
    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog> ;
    rdfs:subClassOf dcat:DataService .

dcat:Distribution a owl:Class ;
    rdfs:label "Distribution" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

org:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:isDefinedBy org: .

onto:DataProduct a owl:Class ;
    rdfs:label "Data Product" ;
    rdfs:comment "Representation of a data product as wrapper of a dataset." ;
    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog> ;
    rdfs:subClassOf dcat:Dataset .

org:Membership a owl:Class ;
    rdfs:label "Membership" ;
    rdfs:isDefinedBy org: .

dcat:DataService a owl:Class ;
    rdfs:label "Data Service" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

dcat:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

dcat:Catalog a owl:Class ;
    rdfs:label "Catalog" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dcat> .

