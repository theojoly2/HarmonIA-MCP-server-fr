onto:somokuSubID a rdfs:Datatype ;
    rdfs:label "Somoku SubID" ;
    dcterms:created "2011-12-01" ;
    dcterms:description "参加館の各館において一意には付与されない図書登録番号の記述に使用する。" ;
    rdfs:comment "総合目録参加館における図書登録番号" ;
    rdfs:isDefinedBy onto: .

onto:sourceIdentifier a rdf:Property ;
    rdfs:label "Source Identifier" ;
    dcterms:created "2011-12-01" ;
    dcterms:description "当該情報資源が複製資料である場合に、原資料の識別子をここに収める。" ;
    rdfs:comment "原資料の識別子" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier .

onto:subjectTranscription a rdf:Property ;
    rdfs:label "Subject Transcription" ;
    dcterms:created "2007-05-01" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "Subjectの読み又は翻字形" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:subject .

onto:titleTranscription a rdf:Property ;
    rdfs:label "Title Transcription" ;
    dcterms:created "2007-05-01" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "Titleの読み又は翻字形" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:title .

onto:transcription a rdf:Property ;
    rdfs:label "Transcription" ;
    dcterms:created "2010-06-21" ;
    dcterms:description "Title、Creator等の値とセットで表現できる場合に使用する。" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "読み又は翻字形" ;
    rdfs:range rdfs:Literal .

onto:uniformTitle a rdf:Property ;
    rdfs:label "Uniform Title" ;
    dcterms:created "2011-12-01" ;
    rdfs:comment "統一タイトル" ;
    rdfs:subPropertyOf dc:title .

onto:volume a rdf:Property ;
    rdfs:label "Volume" ;
    dcterms:created "2010-06-21" ;
    dcterms:description "PRISM（Publishing Requirements for Industry Standard Metadata）のプロパティprism:volumeでは、プロパティそのものにURIが付与されていないため、独自に設定した。" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "巻次又は部編番号" ;
    rdfs:subPropertyOf dc:title .

onto:volumeCreator a rdf:Property ;
    rdfs:label "Volume Creator" ;
    dcterms:created "2010-06-21" ;
    dcterms:description "URIを持つ場合は、一律DCTERMS Creatorに収め、対象リソースへのURI参照を行う。" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "当該情報資源の当該する巻又は部編に対し著作責任を持つ実体" ;
    rdfs:subPropertyOf dc:creator .

onto:volumeCreatorTranscription a rdf:Property ;
    rdfs:label "Volume Creator Transcription" ;
    dcterms:created "2010-06-21" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "Volume Creatorの読み又は翻字形" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:creator .

onto:volumeRange a rdf:Property ;
    rdfs:label "Volume Range" ;
    dcterms:created "2010-06-21" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "逐次刊行物の初号から終号までの巻次及び年月次" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dcterms:description .

onto:volumeTitle a rdf:Property ;
    rdfs:label "Volume Title" ;
    dcterms:created "2010-06-21" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "多巻ものの各巻タイトル又は逐次刊行物の部編名" ;
    rdfs:subPropertyOf dc:title .

onto:volumeTitleTranscription a rdf:Property ;
    rdfs:label "Volume Title Transcription" ;
    dcterms:created "2010-06-21" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "Volume Titleの読み又は翻字形" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:title .

onto:volumeTranscription a rdf:Property ;
    rdfs:label "Volume Transcription" ;
    dcterms:created "2010-06-21" ;
    dcterms:modified "2011-12-01" ;
    rdfs:comment "Volumeの読み又は翻字形" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:title .

onto: dcterms:creator [ a foaf:Agent ;
            onto:transcription "コクリツ　コッカイ　トショカン" ;
            rdf:value "国立国会図書館" ] ;
    dcterms:issued "2010-06-21" ;
    dcterms:modified "2011-12-01" ;
    dcterms:title "RDF Schemaによって定義したNDL Metadata Termsの語彙" ;

