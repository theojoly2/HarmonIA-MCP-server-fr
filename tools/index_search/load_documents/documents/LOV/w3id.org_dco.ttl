    rdfs:label "Gas meter" ;
    rdfs:subClassOf <https://w3id.org/dco#Meter> ;
    skos:definition "A gas meter is a specialized flow meter, used to measure the volume of fuel gases such as natural gas and liquefied petroleum gas. Gas meters are used at residential, commercial, and industrial buildings that consume fuel gas supplied by a gas utility" .

