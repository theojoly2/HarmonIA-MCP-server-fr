    rdfs:subClassOf <https://w3id.org/dco#Appliance> ;
    skos:definition "A solar panel, or photo-voltaic (PV) module, is an assembly of photo-voltaic cells mounted in a framework for installation. Solar panels use sunlight as a source of energy and generate direct current electricity." .

<https://w3id.org/dco#SquareMeter> a owl:Class ;
    rdfs:label "Square meter" ;
    rdfs:subClassOf <https://w3id.org/dco#AreaUnit> ;
    skos:definition "\"An area unit which is equal to an area enclosed by a square with sides each 1 meter long.\" [NIST:NIST]" .

<https://w3id.org/dco#StartState> a owl:Class ;
    rdfs:label "Start state" ;
    rdfs:subClassOf <https://w3id.org/dco#StartStopState> .

<https://w3id.org/dco#StopState> a owl:Class ;
    rdfs:label "Stop state" ;
    rdfs:subClassOf <https://w3id.org/dco#StartStopState> .

<https://w3id.org/dco#SupplyTemperatureSensor> a owl:Class ;
    rdfs:label "Supply temperature sensor" ;
    rdfs:subClassOf <https://w3id.org/dco#Sensor> ;
    skos:definition "This sensor measures the supplied temperature by a directly from the heater." .

<https://w3id.org/dco#TankTemperature> a owl:Class ;
    rdfs:label "Tank temperature" ;
    rdfs:subClassOf <https://w3id.org/dco#TemperatureProperty> ;
    skos:definition "Represent the temperature of a tank." .

<https://w3id.org/dco#TemperatureSensor> a owl:Class ;
    rdfs:label "Temperature Sensor" ;
    rdfs:subClassOf <https://w3id.org/dco#Sensor> ;
    skos:definition "A sensor that is used for the purpose of sensing the temperature property." .

<https://w3id.org/dco#TemperatureSetpoint> a owl:Class ;
    rdfs:label "Temperature setpoint" ;
    rdfs:subClassOf <https://w3id.org/dco#Setpoint>,
        <https://w3id.org/dco#TemperatureProperty> ;
    skos:definition "A setpoint is the desired target value of a property." .

<https://w3id.org/dco#TertiaryBuilding> a owl:Class ;
    rdfs:label "Tertiary building" ;
    rdfs:subClassOf <https://w3id.org/dco#BuildingMetadata> ;
    skos:definition "Tertiary sector buildings include all of the infrastructure occupied by public authorities, associations and companies providing services." .

<https://w3id.org/dco#Thermostat> a owl:Class ;
    rdfs:label "Thermostat" ;
    rdfs:subClassOf <https://w3id.org/dco#Sensor> ;
    skos:definition "An automatic control device used to maintain temperature at a fixed or adjustable setpoint." .

<https://w3id.org/dco#ThermostaticValveActuator> a owl:Class ;
    rdfs:label "Thermostatic valve actuator" ;
    rdfs:subClassOf <https://w3id.org/dco#Actuator> .

<https://w3id.org/dco#ToggleAction> a owl:Class ;
    rdfs:label "Toggle action" ;
    rdfs:subClassOf <https://w3id.org/dco#Action> .

<https://w3id.org/dco#ValveActuator> a owl:Class ;
    rdfs:label "Valve actuator" ;
    rdfs:subClassOf <https://w3id.org/dco#Actuator> ;
    skos:definition "Represent the actuator of the valve." .

<https://w3id.org/dco#ValveController> a owl:Class ;
    rdfs:label "Valve controller" ;
    rdfs:subClassOf <https://w3id.org/dco#Controller> ;
    skos:definition "Represent the controller of a valve." .

<https://w3id.org/dco#ValveMaximumOpening> a owl:Class ;
    rdfs:label "Valve maximum opening" ;
    rdfs:subClassOf <https://w3id.org/dco#ValveProperty> .

<https://w3id.org/dco#ValveMaximumTemperature> a owl:Class ;
    rdfs:label "Valve maximum temperature" ;
    rdfs:subClassOf <https://w3id.org/dco#ValveProperty> .

<https://w3id.org/dco#ValveMinimumOpening> a owl:Class ;
    rdfs:label "Valve minimum opening" ;
    rdfs:subClassOf <https://w3id.org/dco#ValveProperty> .

<https://w3id.org/dco#ValveMinimumTemperature> a owl:Class ;
    rdfs:label "Valve minimum temperature" ;
    rdfs:subClassOf <https://w3id.org/dco#ValveProperty> .

<https://w3id.org/dco#ValvePosition> a owl:Class ;
    rdfs:label "Valve position" ;
    rdfs:subClassOf <https://w3id.org/dco#ValveProperty> ;
    skos:definition "Represent the current position of a valve" .

<https://w3id.org/dco#Volt-ampereReactive> a owl:Class ;
    rdfs:label "Volt-ampere reactive" ;
    rdfs:subClassOf <https://w3id.org/dco#ElectricUnit> ;
    skos:definition "In electric power transmission and distribution, volt-ampere reactive (var) is a unit in which reactive power is expressed in an AC electric power system." .

<https://w3id.org/dco#Voltage> a owl:Class ;
    rdfs:label "Voltage" ;
    rdfs:subClassOf <https://w3id.org/dco#VoltageProperty> .

<https://w3id.org/dco#VoltageClamp1> a owl:Class ;
    rdfs:label "Voltage clamp 1" ;
    rdfs:subClassOf <https://w3id.org/dco#VoltageProperty> .

<https://w3id.org/dco#VoltageClamp2> a owl:Class ;
    rdfs:label "Voltage clamp 2" ;
    rdfs:subClassOf <https://w3id.org/dco#VoltageProperty> .

<https://w3id.org/dco#VoltageClamp3> a owl:Class ;
    rdfs:label "Voltage clamp 3" ;
    rdfs:subClassOf <https://w3id.org/dco#VoltageProperty> .

<https://w3id.org/dco#WaterFlow> a owl:Class ;
    rdfs:label "Water flow" ;
    rdfs:subClassOf <https://w3id.org/dco#WaterProperty> ;
    skos:definition "Water flow refers to the amount of water coming out of a hose, faucet or other pipe fixture in a certain amount of time." .

<https://w3id.org/dco#WaterFlowMeter> a owl:Class ;
    rdfs:label "Water flow meter" ;
    rdfs:subClassOf <https://w3id.org/dco#Meter> ;
    skos:definition "A water meter is an instrument intended to measure continuously, memorize, and display the volume of water passing through the meter." .

<https://w3id.org/dco#WaterTemperature> a owl:Class ;
    rdfs:label "Water temperature" ;
    rdfs:subClassOf <https://w3id.org/dco#TemperatureProperty> .

<https://w3id.org/dco#WaterTemperatureSensor> a owl:Class ;
    rdfs:label "Water temperature sensor" ;
    rdfs:subClassOf <https://w3id.org/dco#Sensor> ;
    skos:definition "This sensor measures the water temperature." .

<https://w3id.org/dco#WaterVolume> a owl:Class ;
    rdfs:label "Water volume" ;
    rdfs:subClassOf <https://w3id.org/dco#WaterProperty> ;
    skos:definition "Water volume means the quantity of water that can be measured in liters, cubic meters, gallons, milliliters, teaspoons, and ounces, though many other units exist." .

<https://w3id.org/dco#Watt> a owl:Class ;
    rdfs:label "Watt" ;
    rdfs:subClassOf <https://w3id.org/dco#PowerUnit> ;
    skos:definition "\"A power unit which is equal to the power used when work is done at the rate of 1 joule per second.\" [NIST:NIST]" .

<https://w3id.org/dco#Zone> a owl:Class ;
    rdfs:label "Zone" ;
    rdfs:subClassOf <https://w3id.org/dco#BuildingTopology> .

<https://w3id.org/dco#buildingZipCode> a owl:Class ;
    rdfs:label "building zip code" ;
    rdfs:subClassOf <https://w3id.org/dco#BuildingMetadata> ;
    skos:definition "Represent the zip code of the building" .

<https://w3id.org/dco#consitsOf> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "consitsOf" ;
    rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#containsDevice> a owl:ObjectProperty ;
    rdfs:label "contains device" ;
    rdfs:domain <https://w3id.org/dco#Space> ;
    rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#isLocatedAt> .

<https://w3id.org/dco#hasAddress> a owl:DatatypeProperty ;
    rdfs:label "hasAddress" ;
    rdfs:domain <https://w3id.org/dco#Building> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://w3id.org/dco#hasApartment> a owl:ObjectProperty ;
    rdfs:label "hasApartment" ;
    rdfs:domain <https://w3id.org/dco#Floor> ;
    rdfs:range <https://w3id.org/dco#Apartment> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#isApartmentOF> .

<https://w3id.org/dco#hasBuilding> a owl:ObjectProperty ;
    rdfs:label "hasBuilding" ;
    rdfs:domain <https://w3id.org/dco#Site> ;
    rdfs:range <https://w3id.org/dco#Building> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#hasSite> .

<https://w3id.org/dco#hasCity> a owl:DatatypeProperty ;
    rdfs:label "hasCity" ;
    rdfs:domain <https://w3id.org/dco#Building> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://w3id.org/dco#hasConstructionYear> a owl:DatatypeProperty ;
    rdfs:label "hasConstructionYear" ;
    rdfs:domain <https://w3id.org/dco#Building> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://w3id.org/dco#hasFloor> a owl:ObjectProperty ;
    rdfs:label "hasFloor" ;
    rdfs:domain <https://w3id.org/dco#Building> ;
    rdfs:range <https://w3id.org/dco#Floor> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#isFloorOf> .

<https://w3id.org/dco#hasID> a owl:DatatypeProperty ;
    rdfs:label "hasID" ;
    rdfs:domain <https://w3id.org/dco#WoTThing> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://w3id.org/dco#hasName> a owl:DatatypeProperty ;
    rdfs:label "hasName" ;
    rdfs:domain <https://w3id.org/dco#WoTThing> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://w3id.org/dco#hasNumberOfInhabitants> a owl:DatatypeProperty ;
    rdfs:label "hasNumberOfInhabitants" ;
    rdfs:domain <https://w3id.org/dco#Space> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://w3id.org/dco#hasRenovationDate> a owl:DatatypeProperty ;
    rdfs:label "hasRenovationDate" ;
    rdfs:domain <https://w3id.org/dco#Space> ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://w3id.org/dco#hasSpace> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "hasSpace" ;
    rdfs:domain <https://w3id.org/dco#Space> ;
    rdfs:range <https://w3id.org/dco#Space> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#hasThingDescriptionAction> a owl:ObjectProperty ;
    rdfs:label "hasThingDescriptionAction" ;
    rdfs:domain <https://w3id.org/dco#WoTThing> ;
    rdfs:range <https://w3id.org/dco#Action> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#isActionOf> .

<https://w3id.org/dco#hasThingDescriptionEvent> a owl:ObjectProperty ;
    rdfs:label "hasThingDescriptionEvent" ;
    rdfs:domain <https://w3id.org/dco#WoTThing> ;
    rdfs:range <https://w3id.org/dco#Event> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#isEventOf> .

<https://w3id.org/dco#hasThingDescriptionProperty> a owl:ObjectProperty ;
    rdfs:label "hasThingDescriptionProperty" ;
    rdfs:domain <https://w3id.org/dco#WoTThing> ;
    rdfs:range <https://w3id.org/dco#Property> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#isPropertyOf> .

<https://w3id.org/dco#hasTotalSpace> a owl:DatatypeProperty ;
    rdfs:label "hasTotalSpace" ;
    rdfs:domain <https://w3id.org/dco#Building> ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf owl:topDataProperty ;
    skos:definition "This defines the total surface of a dCO:Space measured in square meter" .

<https://w3id.org/dco#hasZipCode> a owl:DatatypeProperty ;
    rdfs:label "hasZipCode" ;
    rdfs:domain <https://w3id.org/dco#Building> ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://w3id.org/dco#isMeasuredIn> a owl:ObjectProperty ;
    rdfs:label "isMeasuredIn" ;
    rdfs:domain <https://saref.etsi.org/core/v3.1.1/#saref:Measurement> ;
    rdfs:range <https://w3id.org/dco#UnitsOfMeasurements> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#isUnitOfMeasurementOf> .

<https://w3id.org/dco#kilowatt-hour> a owl:Class ;
    rdfs:label "kilowatt-hour" ;
    rdfs:subClassOf <https://w3id.org/dco#WattHourBasedUnit> ;
    skos:definition "\"An energy unit which is equal to 1,000 watt-hours.\" [Wikipedia:Wikipedia]" .

<https://w3id.org/dco#makesMeasurement> a owl:ObjectProperty ;
    rdfs:label "makes measurement" ;
    rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    rdfs:range <https://saref.etsi.org/core/v3.1.1/#saref:Measurement> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#measurementMadeBy> .

<https://w3id.org/dco#offersService> a owl:ObjectProperty ;
    rdfs:label "offers service" ;
    rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    rdfs:range <https://saref.etsi.org/core/v3.1.1/#saref:Service> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <https://w3id.org/dco#serviceOfferedBy> .

<https://w3id.org/dco#watt-hour> a owl:Class ;
    rdfs:label "watt-hour" ;
    rdfs:subClassOf <https://w3id.org/dco#WattHourBasedUnit> .

onto: a owl:Ontology ;
    dc:description "domOS Common Ontology (dCO) represents a common information model to share a unified understanding for humans and machines and to ensure semantic interoperability in a heterogeneous IoT infrastructure. This ontology allows the decoupling of the infrastructure from the software services and applications."@en ;
    dc:title "domOS Common Ontology"@en ;
    dcterms:bibliographicCitation "Cite this vocabulary as: Amir Laadhar, Christian Thomsen, Aalborg University, domOS Common Ontology."@en ;
    dcterms:created "September 30, 2021"@en ;
    dcterms:creator "Christian Thomsen"@en ;
    dcterms:issued "2021-09-30"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/2.0/> ;
    dcterms:publisher <https://www.domos-project.eu/> ;
    dcterms:source <https://webprotege.stanford.edu/#projects/3dd8b2a0-f08c-4a9e-8e87-e8fb599ab464/sharing> ;
    vann:preferredNamespacePrefix "dco"@en ;
    vann:preferredNamespaceUri "https://w3id.org/dco" ;
    owl:versionIRI onto: ;
    owl:versionInfo "1.0"@en ;
    ns2:status "First version"@en ;
    ns1:logo <https://www.domos-project.eu/layout/logo.svg?v=2> .

<https://w3id.org/dco#AreaUnit> a owl:Class ;
    rdfs:label "Area unit" ;
    rdfs:subClassOf <https://w3id.org/dco#UnitsOfMeasurements> ;
    skos:definition "\"An area unit which is equal to an area enclosed by a square with sides each 1 meter long.\" [NIST:NIST]" .

<https://w3id.org/dco#BatteryProperty> a owl:Class ;
    rdfs:label "Battery Property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#CarbonDioxideProperty> a owl:Class ;
    rdfs:label "Carbon dioxide property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#Controller> a owl:Class ;
    rdfs:label "Controller" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    skos:definition "A controller is a device that monitors inputs and controls outputs within a building automation system. A controller may be physical (having placement within a spatial structure) or logical (a software interface or aggregated within a programmable physical controller)." .

<https://w3id.org/dco#EnergyUnit> a owl:Class ;
    rdfs:label "Energy unit" ;
    rdfs:subClassOf <https://w3id.org/dco#UnitsOfMeasurements> .

<https://w3id.org/dco#HumidityProperty> a owl:Class ;
    rdfs:label "Humidity property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#PartsPerNotationUnit> a owl:Class ;
    rdfs:label "Parts per notation unit" ;
    rdfs:subClassOf <https://w3id.org/dco#UnitsOfMeasurements> ;
    skos:definition "\"A dimensionless concentration notation which describes the amount of one substance in another. It is the ratio of the amount of the substance of interest to the amount of that substance plus the amount of the substance.\" [Wikipedia:Wikipedia]" .

<https://w3id.org/dco#PercentageUnit> a owl:Class ;
    rdfs:label "Percentage unit" ;
    rdfs:subClassOf <https://w3id.org/dco#UnitsOfMeasurements> .

<https://w3id.org/dco#PowerUnit> a owl:Class ;
    rdfs:label "Power unit" ;
    rdfs:subClassOf <https://w3id.org/dco#UnitsOfMeasurements> .

<https://w3id.org/dco#Setpoint> a owl:Class ;
    rdfs:label "Setpoint" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#TemperatureUnit> a owl:Class ;
    rdfs:label "Temperature unit" ;
    rdfs:subClassOf <https://w3id.org/dco#UnitsOfMeasurements> ;
    skos:definition "\"A unit which is a standard measure of the average kinetic energy of the particles in a sample of matter.\" [Wikipedia:Wikipedia]" .

<https://w3id.org/dco#isActionOf> a owl:ObjectProperty ;
    rdfs:label "is action of" ;
    rdfs:domain <https://w3id.org/dco#Action> ;
    rdfs:range <https://w3id.org/dco#WoTThing> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#isApartmentOF> a owl:ObjectProperty ;
    rdfs:label "is apartment of" ;
    rdfs:domain <https://w3id.org/dco#Apartment> ;
    rdfs:range <https://w3id.org/dco#Floor> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#isEventOf> a owl:ObjectProperty ;
    rdfs:label "is event of" ;
    rdfs:domain <https://w3id.org/dco#Event> ;
    rdfs:range <https://w3id.org/dco#WoTThing> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#isFloorOf> a owl:ObjectProperty ;
    rdfs:label "is floor of" ;
    rdfs:domain <https://w3id.org/dco#Floor> ;
    rdfs:range <https://w3id.org/dco#Building> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#isLocatedAt> a owl:ObjectProperty ;
    rdfs:label "is located at" ;
    rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    rdfs:range <https://w3id.org/dco#Space> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#isPropertyOf> a owl:ObjectProperty ;
    rdfs:label "is property of" ;
    rdfs:domain <https://w3id.org/dco#Property> ;
    rdfs:range <https://w3id.org/dco#WoTThing> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#isUnitOfMeasurementOf> a owl:ObjectProperty ;
    rdfs:label "is unit of measurement of" ;
    rdfs:domain <https://w3id.org/dco#UnitsOfMeasurements> ;
    rdfs:range <https://saref.etsi.org/core/v3.1.1/#saref:Measurement> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#measurementMadeBy> a owl:ObjectProperty ;
    rdfs:label "measurement made by" ;
    rdfs:domain <https://saref.etsi.org/core/v3.1.1/#saref:Measurement> ;
    rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#serviceOfferedBy> a owl:ObjectProperty ;
    rdfs:label "service offered by" ;
    rdfs:domain <https://saref.etsi.org/core/v3.1.1/#saref:Service> ;
    rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#ActiveEnergy> a owl:Class ;
    rdfs:label "Active energy" ;
    rdfs:subClassOf <https://w3id.org/dco#EnergyProperty> .

<https://w3id.org/dco#ActivePower> a owl:Class ;
    rdfs:label "Active power" ;
    rdfs:subClassOf <https://w3id.org/dco#PowerProperty> ;
    skos:definition "The power which is actually consumed or utilised in an AC Circuit is called True power or Active power or Real power. It is measured in kilowatt (kW) or MW. It is the actual outcomes of the electrical system which runs the electric circuits or load." .

<https://w3id.org/dco#Apartment> a owl:Class ;
    rdfs:label "Apartment" ;
    rdfs:subClassOf <https://w3id.org/dco#Space> .

<https://w3id.org/dco#BuildingModel> a owl:Class ;
    rdfs:label "Building model" ;
    rdfs:subClassOf owl:Thing .

<https://w3id.org/dco#BuildingTopology> a owl:Class ;
    rdfs:label "Building topology" ;
    rdfs:subClassOf <https://w3id.org/dco#BuildingModel> .

<https://w3id.org/dco#ElectricUnit> a owl:Class ;
    rdfs:label "Electric unit" ;
    rdfs:subClassOf <https://w3id.org/dco#UnitsOfMeasurements> .

<https://w3id.org/dco#Event> a owl:Class ;
    rdfs:label "Event" ;
    rdfs:subClassOf <https://w3id.org/dco#InteractionAffordance> ;
    skos:definition "An Interaction Affordance that describes an event source, which asynchronously pushes event data to Consumers (e.g., overheating alerts)." .

<https://w3id.org/dco#ExportedEnergy> a owl:Class ;
    rdfs:label "Exported energy" ;
    rdfs:subClassOf <https://w3id.org/dco#EnergyProperty> .

<https://w3id.org/dco#HouseholdType> a owl:Class ;
    rdfs:label "Household type" ;
    rdfs:subClassOf <https://w3id.org/dco#BuildingMetadata> .

<https://w3id.org/dco#ImportedEnergy> a owl:Class ;
    rdfs:label "Imported energy" ;
    rdfs:subClassOf <https://w3id.org/dco#EnergyProperty> .

<https://w3id.org/dco#OnOffState> a owl:Class ;
    rdfs:label "On Off state" ;
    rdfs:subClassOf <https://w3id.org/dco#State> ;
    skos:definition "A type of state" .

<https://w3id.org/dco#OpenCloseState> a owl:Class ;
    rdfs:label "Open Close State" ;
    rdfs:subClassOf <https://w3id.org/dco#State> .

<https://w3id.org/dco#ReactivePower> a owl:Class ;
    rdfs:label "Reactive power" ;
    rdfs:subClassOf <https://w3id.org/dco#PowerProperty> ;
    skos:definition "The power which flows back and forth that means it moves in both the directions in the circuit or reacts upon itself, is called Reactive Power. The reactive power is measured in kilo volt-ampere reactive (kVAR) or MVAR." .

<https://w3id.org/dco#Relay> a owl:Class ;
    rdfs:label "Relay" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device> .

<https://w3id.org/dco#Site> a owl:Class ;
    rdfs:label "Site" ;
    rdfs:subClassOf <https://w3id.org/dco#Space> ;
    skos:definition "A part of the physical world or a virtual world that is inherently both located in this world and having a 3D spatial extent. It is intended to contain or contains one or more buildings." .

<https://w3id.org/dco#StartStopState> a owl:Class ;
    rdfs:label "Start Stop state" ;
    rdfs:subClassOf <https://w3id.org/dco#State> .

<https://w3id.org/dco#ThingDescriptionModel> a owl:Class ;
    rdfs:label "Thing description model" ;
    rdfs:subClassOf owl:Thing .

<https://w3id.org/dco#VolumeUnit> a owl:Class ;
    rdfs:label "Volume unit" ;
    rdfs:subClassOf <https://w3id.org/dco#UnitsOfMeasurements> ;
    skos:definition "\"A unit which is a standard measure of the amount of space occupied by any substance, whether solid, liquid, or gas.\" [NIST:NIST]" .

<https://w3id.org/dco#WaterProperty> a owl:Class ;
    rdfs:label "Water property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#WattHourBasedUnit> a owl:Class ;
    rdfs:label "Watt hour based unit" ;
    rdfs:subClassOf <https://w3id.org/dco#EnergyUnit> .

<https://w3id.org/dco#hasSite> a owl:ObjectProperty ;
    rdfs:label "hasSite" ;
    rdfs:domain <https://w3id.org/dco#Building> ;
    rdfs:range <https://w3id.org/dco#Site> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/dco#InteractionAffordance> a owl:Class ;
    rdfs:label "Interaction Affordance" ;
    rdfs:subClassOf <https://w3id.org/dco#ThingDescriptionModel> .

<https://w3id.org/dco#State> a owl:Class ;
    rdfs:label "State" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> ;
    skos:definition "The state in which a device can be found, e.g, ON/OFF/STANDBY, or ONLINE/OFFLINE" .

<https://w3id.org/dco#Actuator> a owl:Class ;
    rdfs:label "Actuator" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    owl:disjointWith <https://w3id.org/dco#Relay> ;
    skos:definition "A device that is used by, or implements, an (Actuation) Procedure that changes the state of the world." .

<https://w3id.org/dco#AmperageProperty> a owl:Class ;
    rdfs:label "Amperage property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#Appliance> a owl:Class ;
    rdfs:label "Appliance" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    skos:definition "An electrical/mechanical machine that accomplish some household functions, such as cleaning or cooking." .

<https://w3id.org/dco#Floor> a owl:Class ;
    rdfs:label "Floor" ;
    rdfs:subClassOf <https://w3id.org/dco#Space> ;
    skos:definition "A part of the physical world or a virtual world that is inherently both located in this world and having a 3D spatial extent. A Storey is contained in one or more buildings, and is intended to contain one or more spaces that are horizontally connected. Storeys of a building are connected by means of vertical connections such as elevators and stairs. A bot:Storey encompasses both zones above and below ground, for example, a building with 21 floors above ground, one ground floor and 3 basements is equal to the sentence: A building has 25 instances of bot:Storey." .

<https://w3id.org/dco#VoltageProperty> a owl:Class ;
    rdfs:label "Voltage property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://saref.etsi.org/core/v3.1.1/#saref:Measurement> a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:subClassOf <https://w3id.org/dco#dCOCoreModel> .

<https://w3id.org/dco#PowerProperty> a owl:Class ;
    rdfs:label "Power property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#Room> a owl:Class ;
    rdfs:label "Room" ;
    rdfs:subClassOf <https://w3id.org/dco#Space> .

<https://w3id.org/dco#dCOCoreModel> a owl:Class ;
    rdfs:label "dCO core model" ;
    rdfs:subClassOf owl:Thing .

<https://saref.etsi.org/core/v3.1.1/#saref:Service> a owl:Class ;
    rdfs:label "Service" ;
    rdfs:subClassOf <https://w3id.org/dco#dCOCoreModel> ;
    skos:definition "A service is a representation of a function to a network that makes the function discoverable, registerable, remotely controllable by other devices in the network. A service can represent one or more functions. A Service is offered by a device that wants (a certain set of) its function(s) to be discoverable, registerable, remotely controllable by other devices in the network. A Service must specify the device that is offering the service and the function(s) to be represented." .

<https://w3id.org/dco#Meter> a owl:Class ;
    rdfs:label "Meter" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    skos:definition "A device that measure usage or consumption of some media --- typically a form energy or power." .

<https://w3id.org/dco#DeviceMetadata> a owl:Class ;
    rdfs:label "Device metadata" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device> .

<https://w3id.org/dco#TemperatureProperty> a owl:Class ;
    rdfs:label "Temperature Property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#ValveProperty> a owl:Class ;
    rdfs:label "Valve property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#Action> a owl:Class ;
    rdfs:label "Action" ;
    rdfs:subClassOf <https://w3id.org/dco#InteractionAffordance> ;
    skos:definition "An Interaction Affordance that allows to invoke a function of the Thing, which manipulates state (e.g., toggling a lamp on or off) or triggers a process on the Thing (e.g., dim a lamp over time)." .

<https://w3id.org/dco#Sensor> a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device> ;
    skos:definition "Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms." .

<https://w3id.org/dco#WoTThing> a owl:Class ;
    rdfs:label "WoT Thing" ;
    rdfs:subClassOf <https://w3id.org/dco#ThingDescriptionModel> ;
    skos:definition "An abstraction of a physical or a virtual entity whose metadata and interfaces are described by a WoT Thing Description, whereas a virtual entity is the composition of one or more Things." .

<https://w3id.org/dco#UnitsOfMeasurements> a owl:Class ;
    rdfs:label "Units of measurements" ;
    skos:definition "A unit of measurement is a definite magnitude of a quantity, defined and adopted by convention and/or by law. It is used as a standard for measurement of the same quantity, where any other value of the quantity can be expressed as a simple multiple of the unit of measure. For example, length is a quantity; the metre is a unit of length that represents a definite predetermined length. When we say 10 metre (or 10 m), we actually mean 10 times the definite predetermined length called \"metre\"." .

<https://w3id.org/dco#Space> a owl:Class ;
    rdfs:label "Space" ;
    rdfs:subClassOf <https://w3id.org/dco#BuildingTopology> ;
    skos:definition "A part of the physical world or a virtual world whose 3D spatial extent is bounded actually or theoretically, and provides for certain functions within the zone it is contained in." .

<https://w3id.org/dco#EnergyProperty> a owl:Class ;
    rdfs:label "Energy property" ;
    rdfs:subClassOf <https://w3id.org/dco#Property> .

<https://w3id.org/dco#Building> a owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf <https://w3id.org/dco#Space> ;
    skos:definition "A building represents a structure that provides shelter for its occupants or contents and stands in one place. The building is also used to provide a basic element within the spatial structure hierarchy for the components of a building project (together with site, storey, and space). The basement floor of a building is floor number 0." .

<https://w3id.org/dco#BuildingMetadata> a owl:Class ;
    rdfs:label "Building metadata" ;
    rdfs:subClassOf <https://w3id.org/dco#BuildingModel> .

<https://w3id.org/dco#Property> a owl:Class ;
    rdfs:label "Property" ;
    rdfs:subClassOf <https://w3id.org/dco#InteractionAffordance> .

<http://purl.oclc.org/NET/ssnx/ssn#Device> a owl:Class ;
    rdfs:label "Device" ;
    rdfs:subClassOf owl:Thing,
        <https://w3id.org/dco#dCOCoreModel> ;
    skos:definition "A tangible object designed to accomplish a particular task in households, common public buildings or offices. In order to accomplish this task, the device performs one or more functions. For example, a washing machine is designed to wash (task) and to accomplish this task it performs the start and stop function." .

[] a owl:AllDisjointProperties ;
    owl:members ( <https://w3id.org/dco#hasSite> ) .

