dcterms:created a rdf:Property ;
    rdfs:label "created" ;
    rdfs:range xsd:date .

dcterms:modified a rdf:Property ;
    rdfs:label "modified" ;
    rdfs:range xsd:date .

dcterms:rights a owl:AnnotationProperty ;
    rdfs:label "rights" ;
    rdfs:range xsd:string .

dcterms:source a owl:AnnotationProperty ;
    rdfs:label "source" ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range xsd:anyURI .

dcterms:subject a owl:AnnotationProperty ;
    rdfs:label "subject" ;
    rdfs:range xsd:string .

dcterms:title a owl:AnnotationProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string .

ns2:BaseUnit a owl:Class ;
    rdfs:label "Base Unit" ;
    ns2:informativeReference "http://aurora.regenstrief.org/~ucum/ucum.html#section-Base-Units"^^xsd:anyURI,
        "http://dbpedia.org/resource/Category:SI_base_units"^^xsd:anyURI ;
    rdfs:comment "A <em>Base Unit</em> is a unit adopted by convention for a base quantity."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Unit .

ns2:BinaryPrefixUnit a owl:Class ;
    rdfs:label "Binary Prefix Unit" ;
    ns2:dbpediaMatch "http://dbpedia.org/resource/Binary_prefix"^^xsd:anyURI ;
    ns2:informativeReference "https://en.wikipedia.org/wiki/Binary_prefix"^^xsd:anyURI ;
    rdfs:comment "A <em>Binary Prefix Unit</em> is a unit prefix for multiples of units in data processing, data transmission, and digital information, notably the bit and the byte, to indicate multiplication by a power of 2."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:PrefixUnit .

ns2:ByteEncodingType a owl:Class ;
    rdfs:label "Byte Encoding" ;
    dcterms:description "This class contains the various ways that information may be encoded into bytes." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Encoding .

ns2:CT_COUNTABLY-INFINITE a ns2:CardinalityType ;
    rdfs:label "Countably Infinite Cardinality Type" ;
    dcterms:description "A set of numbers is called countably infinite if there is a way to enumerate them.  Formally this is done with a bijection function that associates each number in the set with exactly one of the positive integers.  The set of all fractions is also countably infinite.  In other words, any set \\\\\\\\(X\\\\\\\\) that has the same cardinality as the set of the natural numbers, or \\\\\\\\(| X | \\\\\\\\; =  \\\\\\\\; | \\\\\\\\mathbb N | \\\\\\\\; = \\\\\\\\; \\\\\\\\aleph0\\\\\\\\), is said to be a countably infinite set."^^ns2:LatexString ;
    ns2:informativeReference "http://www.math.vanderbilt.edu/~schectex/courses/infinity.pdf"^^xsd:anyURI ;
    ns2:literal "countable" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:CT_FINITE a ns2:CardinalityType ;
    rdfs:label "Finite Cardinality Type" ;
    dcterms:description "Any set \\\\\\\\(X\\\\\\\\) with cardinality less than that of the natural numbers, or \\\\\\\\(| X | \\\\\\\\\\\\\\\\; <  \\\\\\\\; | \\\\\\\\\\\\\\\\mathbb N | \\\\\\\\), is said to be a finite set."^^ns2:LatexString ;
    ns2:literal "finite" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:CharEncodingType a owl:Class ;
    rdfs:label "Char Encoding Type" ;
    dcterms:description "The class of all character encoding schemes, each of which defines a rule or algorithm for encoding character data as a sequence of bits or bytes." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Encoding .

ns2:Comment a owl:Class ;
    rdfs:label "Comment" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:rationale ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns2:description ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty dcterms:description ],
        ns2:Verifiable,
        owl:Thing .

ns2:DateTimeStringEncodingType a owl:Class ;
    rdfs:label "Date Time String Encoding Type" ;
    dcterms:description "Date Time encodings are logical encodings for expressing date/time quantities as strings by applying unambiguous formatting and parsing rules." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:allowedPattern ],
        ns2:StringEncodingType .

ns2:DecimalPrefixUnit a owl:Class ;
    rdfs:label "Decimal Prefix Unit" ;
    rdfs:comment "A <em>Decimal Prefix Unit</em> is a unit prefix for multiples of units that are powers of 10."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:PrefixUnit .

ns2:Figure a owl:Class ;
    rdfs:label "Figure" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:width ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:landscape ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:imageLocation ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:image ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:figureLabel ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:height ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:figureCaption ],
        ns2:Concept .

ns2:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:url ],
        ns2:Concept .

ns2:PartiallyOrdered a ns2:OrderedType ;
    rdfs:label "Partially Ordered" ;
    ns2:literal "partial" ;
    ns2:plainTextDescription "Partial ordered structure." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:PhysicalConstant a owl:Class ;
    rdfs:label "Physical Constant" ;
    ns2:dbpediaMatch "http://dbpedia.org/resource/Physical_constant"^^xsd:anyURI ;
    rdfs:comment "A physical constant is a physical quantity that is generally believed to be both universal in nature and constant in time. It can be contrasted with a mathematical constant, which is a fixed numerical value but does not directly involve any physical measurement. There are many physical constants in science, some of the most widely recognized being the speed of light in vacuum c, Newton's gravitational constant G, Planck's constant h, the electric permittivity of free space Îµ0, and the elementary charge e. Physical constants can take many dimensional forms, or may be dimensionless depending on the system of quantities and units used."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Quantity .

ns2:Rule a owl:Class ;
    rdfs:label "Rule" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:RuleType ;
            owl:onProperty ns2:ruleType ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:example ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:rationale ],
        ns2:Concept,
        ns2:Verifiable .

ns2:RuleType a owl:Class ;
    rdfs:label "Rule Type" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:EnumeratedValue .

ns2:SIGNED a ns2:SignednessType ;
    rdfs:label "Signed" ;
    ns3:literal "signed" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:ScaleType a owl:Class ;
    rdfs:label "Scale type" ;
    ns2:plainTextDescription "Scales, or scales of measurement (or categorization) provide ways of quantifying measurements, values and other enumerated values according to a normative frame of reference.  Four different types of scales are typically used. These are interval, nominal, ordinal and ratio scales." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:TransformType ;
            owl:onProperty ns2:permissibleTransformation ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:dataStructure ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns2:MathsFunctionType ;
            owl:onProperty ns2:permissibleMaths ],
        ns2:EnumeratedValue .

ns2:TotallyOrdered a ns2:OrderedType ;
    rdfs:label "Totally Ordered" ;
    ns2:literal "total" ;
    ns2:plainTextDescription "Totally ordered structure." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:UCUMci-term a rdfs:Datatype ;
    rdfs:label "case-insensitive UCUM term" ;
    rdfs:comment "Lexical pattern for the terminal symbols in the case-insensitive version of UCUM code" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf rdfs:Resource ;
    owl:onDatatype xsd:string ;
    owl:withRestrictions ( [ xsd:pattern "[\\\\\\\\x21,\\\\\\\\x23-\\\\\\\\x27,\\\\\\\\x2a,\\\\\\\\x2c,\\\\\\\\x30-\\\\\\\\x3c,\\\\\\\\x3e-\\\\\\\\x5a,\\\\\\\\x5c,\\\\\\\\x5e-\\\\\\\\x60,\\\\\\\\x7c,\\\\\\\\x7e]+" ] ) .

ns2:UCUMcs-term a rdfs:Datatype ;
    rdfs:label "case-sensitive UCUM terminal" ;
    rdfs:comment "Lexical pattern for the terminal symbols in the case-sensitive version of UCUM code" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf rdfs:Resource ;
    owl:onDatatype xsd:string ;
    owl:withRestrictions ( [ xsd:pattern "[\\\\\\\\x21,\\\\\\\\x23-\\\\\\\\x27,\\\\\\\\x2a,\\\\\\\\x2c,\\\\\\\\x30-\\\\\\\\x3c,\\\\\\\\x3e-\\\\\\\\x5a,\\\\\\\\x5c,\\\\\\\\x5e-\\\\\\\\x7a,\\\\\\\\x7c,\\\\\\\\x7e]+" ] ) .

ns2:UNSIGNED a ns2:SignednessType ;
    rdfs:label "Unsigned" ;
    ns3:literal "unsigned" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:Unordered a ns2:OrderedType ;
    rdfs:label "Unordered" ;
    ns2:literal "unordered" ;
    ns2:plainTextDescription "Unordered structure." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:allowedPattern a rdf:Property ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:ansiSQLName a rdf:Property ;
    rdfs:label "ANSI SQL Name" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
