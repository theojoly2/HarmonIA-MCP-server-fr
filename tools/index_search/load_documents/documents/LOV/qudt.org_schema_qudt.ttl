@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.linkedmodel.org/schema/vaem#> .
@prefix ns2: <http://qudt.org/schema/qudt/> .
@prefix ns3: <http://www.linkedmodel.org/schema/dtype#> .
@prefix onto: <http://qudt.org/schema/qudt> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns2:Statement a rdfs:Class ;
    rdfs:label "Statement" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf rdf:Statement .

dcterms:creator a owl:AnnotationProperty ;
    rdfs:label "creator" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
    rdfs:range xsd:string .

ns2:BaseDimensionMagnitude a owl:Class ;
    rdfs:label "Base Dimension Magnitude" ;
    ns2:informativeReference "http://en.wikipedia.org/wiki/Dimensional_analysis"^^xsd:anyURI,
        "http://web.mit.edu/2.25/www/pdf/DA_unified.pdf"^^xsd:anyURI ;
    rdfs:comment "<p class=\"lm-para\">A <em>Dimension</em> expresses a magnitude for a base quantiy kind such as mass, length and time.</p>\\r\\n<p class=\"lm-para\">DEPRECATED - each exponent is expressed as a property. Keep until a validaiton of this has been done.</p>"^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty ns2:hasBaseQuantityKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns2:QuantityKind ;
            owl:onProperty ns2:hasBaseQuantityKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ns2:vectorMagnitude ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty ns2:vectorMagnitude ],
        ns2:Concept .

ns2:BigEndian a ns2:EndianType ;
    rdfs:label "Big Endian" ;
    ns3:literal "big" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:BinaryScaledUnit a owl:Class ;
    rdfs:label "Binary scaled unit" ;
    rdfs:comment "A <em>Binary Scaled Unit</em> specifies a binary multipler for scaling."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:hasPrefixUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns2:BinaryPrefixUnit ;
            owl:onProperty ns2:hasPrefixUnit ],
        ns2:ScaledUnit .

ns2:BitEncodingType a owl:Class ;
    rdfs:label "Bit Encoding" ;
    dcterms:description "A bit encoding is a correspondence between the two possible values of a bit, 0 or 1, and some interpretation. For example, in a boolean encoding, a bit denotes a truth value, where 0 corresponds to False and 1 corresponds to True." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Encoding .

ns2:BooleanEncoding a ns2:BooleanEncodingType ;
    rdfs:label "Boolean Encoding" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:CGS-Unit a owl:Class ;
    rdfs:label "CGS Unit" ;
    ns2:citation "http://scienceworld.wolfram.com/physics/cgs.html",
        "https://en.wikipedia.org/wiki/Centimetre%E2%80%93gram%E2%80%93second_system_of_units",
        "https://www.unc.edu/~rowlett/units/cgsmks.html" ;
    rdfs:comment "<p>The C.G.S. System of Units defined four units of measure as a basic set from which all otherC.G.S units are derived. These are: </p>\\r\\n<ol>\\r\\n<li>length: cm = centimetre; </li>\\r\\n<li>mass: g = gram;</li>\\r\\n<li> time: s = second; </li>\\r\\n<li> luminous intensity: cd = candela, originally new candle.</li>\\r\\n</ol>"^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:NonSI-Unit .

ns2:CT_UNCOUNTABLE a ns2:CardinalityType ;
    rdfs:label "Uncountable Cardinality Type" ;
    dcterms:description "Any set with cardinality greater than that of the natural numbers, or \\\\\\\\(| X | \\\\\\\\; >  \\\\\\\\; | \\\\\\\\mathbb N | \\\\\\\\),  for example \\\\\\\\(| R| \\\\\\\\; =  \\\\\\\\;  c  \\\\\\\\; > |\\\\\\\\mathbb N |\\\\\\\\), is said to be uncountable."^^ns2:LatexString ;
    ns2:literal "uncountable" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:CharEncoding a ns2:BooleanEncodingType,
        ns2:CharEncodingType ;
    rdfs:label "Char Encoding" ;
    dc:description "7 bits of 1 octet" ;
    ns2:bytes 1 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:Citation a owl:Class ;
    rdfs:label "Citation" ;
    rdfs:comment "Provides a simple way of making citations."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:url ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:description ],
        ns2:Concept .

ns2:ConstantValue a owl:Class ;
    rdfs:label "Constant value" ;
    rdfs:comment "Used to specify the values of a constant."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:exactConstant ],
        ns2:QuantityValue .

ns2:CountingUnit a owl:Class ;
    rdfs:label "Counting Unit" ;
    rdfs:comment "Used for all units that express counts. Examples are Atomic Number, Number, Number per Year, Percent and Sample per Second."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:DimensionlessUnit,
        ns2:ResourceUnit .

ns2:CurrencyUnit a owl:Class ;
    rdfs:label "Currency Unit" ;
    rdfs:comment "Currency Units have their own subclass of unit because: (a) they have additonal properites such as 'country' and (b) their URIs do not conform to the same rules as other units."^^rdf:HTML,
        "Used for all units that express currency."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:DimensionlessUnit,
        ns2:ResourceUnit,
        ns2:Unit .

ns2:DecimalScaledUnit a owl:Class ;
    rdfs:label "Decimal scaled unit" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:hasPrefixUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns2:DecimalPrefixUnit ;
            owl:onProperty ns2:hasPrefixUnit ],
        ns2:ScaledUnit .

ns2:Discipline a owl:Class ;
    rdfs:label "Discipline" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Concept .

ns2:DomainSpecificUnit a owl:Class ;
    rdfs:label "Domain-specific Unit" ;
    rdfs:comment "A domain-specific unit is a categorization of how units may be associated with an area of science, engineering or other discipline."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Unit .

ns2:DoublePrecisionEncoding a ns2:FloatingPointEncodingType ;
    rdfs:label "Single Precision Real Encoding" ;
    ns2:bytes 64 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:EnumerationScale a owl:Class ;
    rdfs:label "Enumeration scale" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Scale,
        ns3:Enumeration .

ns2:IEEE754_1985RealEncoding a ns2:FloatingPointEncodingType ;
    rdfs:label "IEEE 754 1985 Real Encoding" ;
    ns2:bytes 32 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:ISO8601-UTCDateTime-BasicFormat a ns2:DateTimeStringEncodingType ;
    rdfs:label "ISO 8601 UTC Date Time - Basic Format" ;
    ns2:allowedPattern "[0-9]{4}[0-9]{2}[0-9]{2}T[0-9]{2}[0-9]{2}[0-9]{2}.[0-9]+Z",
        "[0-9]{4}[0-9]{2}[0-9]{2}T[0-9]{2}[0-9]{2}[0-9]{2}Z" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:ImperialUnit a owl:Class ;
    rdfs:label "Imperial Unit" ;
    rdfs:comment "British/Imperial units where these are not aligned to international customary units." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:NonSI-Unit .

ns2:International-CustomaryUnit a owl:Class ;
    rdfs:label "Customary Unit" ;
    rdfs:comment "Customary units defined in terms of exact multiplers with SI metric units, as specified in the 1959 International Yard and Pound agreement." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:NonSI-Unit .

ns2:LittleEndian a ns2:EndianType ;
    rdfs:label "Little Endian" ;
    ns3:literal "little" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:LogarithmicUnit a owl:Class ;
    rdfs:label "Logarithmic Unit" ;
    rdfs:comment "Logarithmic units are abstract mathematical units that can be used to express any quantities (physical or mathematical) that are defined on a logarithmic scale, that is, as being proportional to the value of a logarithm function. Examples of logarithmic units include common units of information and entropy, such as the bit, and the byte, as well as units of relative signal strength magnitude such as the decibel."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Unit .

ns2:LongUnsignedIntegerEncoding a ns2:IntegerEncodingType ;
    rdfs:label "Long Unsigned Integer Encoding" ;
    ns2:bytes 8 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:MKS-Unit a owl:Class ;
    rdfs:label "MKS-Unit" ;
    ns2:citation "http://scienceworld.wolfram.com/physics/MKS.html",
        "https://en.wikipedia.org/wiki/MKS_system_of_units" ;
    rdfs:comment "The MKS system of units is a physical system of units that expresses any given measurement using fundamental units of the metre, kilogram, and/or second (MKS)."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:NonSI-Unit .

ns2:MathFunctionType a owl:Class ;
    rdfs:label "Math Function Type" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Concept .

ns2:NIST_SP811_Comment a owl:Class ;
    rdfs:label "NIST SP~811 Comment" ;
    dc:description "National Institute of Standards and Technology (NIST) Special Publication 811 Comments on some quantities and their units" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Comment .

ns2:OctetEncoding a ns2:BooleanEncodingType,
        ns2:ByteEncodingType ;
    rdfs:label "OCTET Encoding" ;
    ns2:bytes 1 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:QuantityKindDimensionVector_CGS-EMU a owl:Class ;
    rdfs:label "CGS EMU Dimension vector" ;
    rdfs:comment "A <em>CGS EMU Dimension Vector</em> is used to specify the dimensions for EMU C.G.S. quantity kind."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:QuantityKindDimensionVector_CGS .

ns2:QuantityKindDimensionVector_CGS-ESU a owl:Class ;
    rdfs:label "CGS ESU Dimension vector" ;
    rdfs:comment "A <em>CGS ESU Dimension Vector</em> is used to specify the dimensions for ESU C.G.S. quantity kind."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:QuantityKindDimensionVector_CGS .

ns2:QuantityKindDimensionVector_CGS-GAUSS a owl:Class ;
    rdfs:label "CGS GAUSS Dimension vector" ;
    rdfs:comment "A <em>CGS GAUSS Dimension Vector</em> is used to specify the dimensions for Gaussioan C.G.S. quantity kind."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:QuantityKindDimensionVector_CGS .

ns2:QuantityKindDimensionVector_CGS-LH a owl:Class ;
    rdfs:label "CGS LH Dimension vector" ;
    rdfs:comment "A <em>CGS LH Dimension Vector</em> is used to specify the dimensions for Lorentz-Heaviside C.G.S. quantity kind."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:QuantityKindDimensionVector_CGS .

ns2:QuantityKindDimensionVector_ISO a owl:Class ;
    rdfs:label "ISO Dimension vector" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:QuantityKindDimensionVector .

ns2:QuantityKindDimensionVector_Imperial a owl:Class ;
    rdfs:label "Imperial dimension vector" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:QuantityKindDimensionVector .

ns2:QuantityType a owl:Class ;
    rdfs:label "Quantity type" ;
    dcterms:description "\\\\\\\\(\\\\\\textit{Quantity Type}\\\\\\\\) is an enumeration of quanity kinds. It specializes \\\\\\\\(\\\\oxed{dtype:EnumeratedValue}\\\\\\\\) by constrinaing \\\\\\\\(\\\\oxed{dtype:value}\\\\\\\\) to instances of \\\\\\\\(\\\\oxed{qudt:QuantityKind}\\\\\\\\)."^^ns2:LatexString ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:QuantityKind ;
            owl:onProperty ns3:value ],
        ns2:EnumeratedValue .

ns2:SI-Unit a owl:Class ;
    rdfs:label "SI Unit" ;
    ns2:dbpediaMatch "http://dbpedia.org/resource/Category:SI_units"^^xsd:anyURI ;
    rdfs:comment "The International System of Units (SI) defines seven units of measure as a basic set from which all other SI units are derived. These SI base units and their physical quantities are: metre for length kilogram for mass second for time ampere for electric current kelvin for temperature candela for luminous intensity mole for the amount of substance. The SI base quantities form a set of mutually independent dimensions as required by dimensional analysis commonly employed in science and technology."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:StandardsUnit .

ns2:SOU_CGS a ns2:SystemOfUnits ;
    rdfs:label "CGS System of Units" ;
    ns2:informativeReference "https://en.wikipedia.org/wiki/Centimetreâ€“gramâ€“second_system_of_units"^^xsd:anyURI ;
    rdfs:isDefinedBy onto: .

ns2:SOU_IMPERIAL a ns2:SystemOfUnits ;
    rdfs:label "Imperial System of Units" ;
    ns2:informativeReference "https://en.wikipedia.org/wiki/Imperial_units"^^xsd:anyURI ;
    rdfs:isDefinedBy onto: .

ns2:SOU_NATURAL_UNITS a ns2:SystemOfUnits ;
    rdfs:label "System of Natural Units" ;
    ns2:dbpediaMatch "http://dbpedia.org/resource/Natural_units"^^xsd:anyURI ;
    rdfs:comment "<p>In physics, natural units are physical units of measurement based only on universal physical constants. For example the elementary charge e is a natural unit of electric charge, or the speed of light c is a natural unit of speed.</p>\\r\\n<p>A purely natural system of units is defined in such a way that some set of selected universal physical constants are normalized to unity; that is, their numerical values in terms of these units become exactly 1.</p>\\r\\n<p>Examples are Planck Units and Atomic Units. Atomic units (au or a.u.) form a system of natural units which is especially convenient for atomic physics calculations. There are two different kinds of atomic units, which one might name Hartree atomic units and Rydberg atomic units, which differ in the choice of the unit of mass and charge.</p>\\r\\n<p>Planck units are unique among systems of natural units, because they are not defined in terms of properties of any prototype, physical object, or even elementary particle.</p>"^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:SOU_SI a ns2:SystemOfUnits ;
    rdfs:label "SI International System of Units" ;
    ns2:informativeReference "https://en.wikipedia.org/wiki/International_System_of_Units"^^xsd:anyURI ;
    rdfs:isDefinedBy onto: .

ns2:SOU_USCS a ns2:SystemOfUnits ;
    rdfs:label "US Customary System of Units" ;
    ns2:informativeReference "https://en.wikipedia.org/wiki/United_States_customary_units"^^xsd:anyURI ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:ScalarDatatype a owl:Class ;
    rdfs:label "Scalar Datatype" ;
    dcterms:description "Scalar data types are those that have a single value. The permissible values are defined over a domain that may be integers, float, character or boolean. Often a scalar data type is referred to as a primitive data type." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:bits ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:minExclusive ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:maxExclusive ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Datatype ;
            owl:onProperty ns2:rdfsDatatype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:maxInclusive ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:minInclusive ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:rdfsDatatype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:bytes ],
        ns2:Datatype .

ns2:ShortSignedIntegerEncoding a ns2:IntegerEncodingType ;
    rdfs:label "Short Signed Integer Encoding" ;
    ns2:bytes 2 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:ShortUnsignedIntegerEncoding a ns2:BooleanEncodingType,
        ns2:IntegerEncodingType ;
    rdfs:label "Short Unsigned Integer Encoding" ;
    ns2:bytes 2 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:SignedIntegerEncoding a ns2:IntegerEncodingType ;
    rdfs:label "Signed Integer Encoding" ;
    ns2:bytes 4 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:SinglePrecisionRealEncoding a ns2:FloatingPointEncodingType ;
    rdfs:label "Single Precision Real Encoding" ;
    ns2:bytes 32 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:StructuredDatatype a owl:Class ;
    rdfs:label "Structured Data Type" ;
    dcterms:description "A \"Structured Datatype\", in contrast to scalar data types, is used to characterize classes of more complex data structures, such as linked or indexed lists, trees, ordered trees, and multi-dimensional file formats." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:elementType ],
        ns2:Datatype .

ns2:Symbol a owl:Class ;
    rdfs:label "Symbol" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:Concept .

ns2:UCUMci a rdfs:Datatype ;
    rdfs:label "case-insensitive UCUM code" ;
    rdfs:comment "Lexical pattern for the case-insensitive version of UCUM code" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf rdfs:Resource ;
    owl:onDatatype xsd:string ;
    owl:withRestrictions ( [ xsd:pattern "[\\\\\\\\x21-\\\\\\\\x60,\\\\\\\\x7b-\\\\\\\\x7e]+" ] ) .

ns2:UCUMcs a rdfs:Datatype ;
    rdfs:label "case-sensitive UCUM code" ;
    rdfs:comment "Lexical pattern for the case-sensitive version of UCUM code" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf rdfs:Resource ;
    owl:onDatatype xsd:string ;
    owl:withRestrictions ( [ xsd:pattern "[\\\\\\\\x21-\\\\\\\\x7e]+" ] ) .

ns2:US-CustomaryUnit a owl:Class ;
    rdfs:label "US-Customary unit" ;
    rdfs:comment "Customary units used in USA not including those aligned to the SI system as specified in the 1960 agreement" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:NonSI-Unit .

ns2:US-SurveyUnit a owl:Class ;
    rdfs:label "US-Survey unit" ;
    rdfs:comment "US survey units (length and area) are defined slightly different to the International Customary units agreed in 1960. They retain earlier multipliers relative to the metre: \\r\\n1 mile = 5280 feet\\r\\n1 foot = 1200/3297 metres\\r\\n1 inch = 1/12 foot" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf ns2:StandardsUnit .

ns2:UTF16-StringEncoding a ns2:StringEncodingType ;
    rdfs:label "UTF-16 String" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:UTF8-StringEncoding a ns2:StringEncodingType ;
    rdfs:label "UTF-8 Encoding" ;
    ns2:bytes 8 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:UnsignedIntegerEncoding a ns2:IntegerEncodingType ;
    rdfs:label "Unsigned Integer Encoding" ;
    ns2:bytes 4 ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:Wikipedia a ns2:Organization ;
    rdfs:label "Wikipedia" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:acronym a owl:DatatypeProperty ;
    rdfs:label "acronym" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:string .

ns2:applicablePlanckUnit a owl:ObjectProperty ;
    rdfs:label "applicable Planck unit" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range ns2:Unit ;
    rdfs:subPropertyOf ns2:applicableUnit .

ns2:belongsToSystemOfQuantities a owl:ObjectProperty ;
    rdfs:label "belongs to system of quantities" ;
    rdfs:domain ns2:QuantityKind ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range ns2:SystemOfQuantityKinds .

ns2:categorizedAs a owl:ObjectProperty ;
    rdfs:label "categorized as" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:citation a owl:AnnotationProperty ;
    rdfs:label "citation" ;
    ns2:plainTextDescription "Used to provide an annotation for an informative reference." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:string .

ns2:code a owl:DatatypeProperty ;
    rdfs:label "code" ;
    dcterms:description "A code is a string that uniquely identifies a QUDT concept.  The code is constructed from the designator."^^rdf:HTML ;
    rdfs:domain ns2:Concept ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:coherentUnitSystem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "coherent unit system" ;
    dcterms:description "<p>A system of units is coherent with respect to a system of quantities and equations if the system of units is chosen in such a way that the equations between numerical values have exactly the same form (including the numerical factors) as the corresponding equations between the quantities. In such a coherent system, no numerical factor other than the number 1 ever occurs in the expressions for the derived units in terms of the base units. For example, the \\\\\\\\(newton\\\\\\\\) and the \\\\\\\\(joule\\\\\\\\). These two are, respectively, the force that causes one kilogram to be accelerated at 1 metre per (1) second per (1) second, and the work done by 1 newton acting over 1 metre. Being coherent refers to this consistent use of 1. In the old c.g.s. system , with its base units the centimetre and the gram, the corresponding coherent units were the dyne and the erg, respectively the force that causes 1 gram to be accelerated at 1 centimetre per (1) second per (1) second, and the work done by 1 dyne acting over 1 centimetre. So \\\\\\\\(1\\\\\\\\,newton = 10^5 dyne\\\\\\\\), \\\\\\\\(1 joule = 10^7 erg\\\\\\\\), making each of the four compatible in a decimal sense within its respective other system, but not coherent therein.</p>"^^ns2:LatexString ;
    ns2:informativeReference "https://en.wikipedia.org/wiki/Coherence_(units_of_measurement)"^^xsd:anyURI ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subPropertyOf ns2:hasUnitSystem .

ns2:conversionCoefficient a owl:DatatypeProperty ;
    rdfs:label "conversion coefficient" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:double .

ns2:currencyExponent a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "currency exponent" ;
    dcterms:description "The currency exponent indicates the number of decimal places between a major currency unit and its minor currency unit. For example, the US dollar is the major currency unit of the United States, and the US cent is the minor currency unit. Since one cent is 1/100 of a dollar, the US dollar has a currency exponent of 2. However, the Japanese Yen has no minor currency units, so the yen has a currency exponent of 0."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:integer .

ns2:definitionReference a owl:ObjectProperty ;
    rdfs:label "definition reference" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:denominatorDimensionVector a owl:ObjectProperty ;
    rdfs:label "denominator dimension vector" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range ns2:QuantityKindDimensionVector .

ns2:elementKind a owl:ObjectProperty ;
    rdfs:label "element kind" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:exactMatch a owl:ObjectProperty ;
    rdfs:label "exact match" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range ns2:Unit .

ns2:fieldCode a owl:AnnotationProperty ;
    rdfs:label "field code" ;
    ns2:plainTextDescription "A field code is a generic property for representing unique codes that make up other identifers. For example each QuantityKind class caries a domain code as its field code." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:string .

ns2:figure a owl:AnnotationProperty ;
    rdfs:label "figure" ;
    dcterms:description "Provides a link to an image."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range ns2:Figure .

ns2:floatPercentage a rdfs:Datatype ;
    rdfs:label "float percentage" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf xsd:float ;
    owl:equivalentClass [ a rdfs:Datatype ;
            rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
            owl:onDatatype xsd:float ;
            owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] [ xsd:maxInclusive "100.0"^^xsd:float ] ) ] .

ns2:guidance a owl:AnnotationProperty ;
    rdfs:label "guidance" ;
    rdfs:domain ns2:Concept ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range rdf:HTML .

ns2:hasDenominatorPart a owl:ObjectProperty ;
    rdfs:label "has quantity kind dimension vector denominator part" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:hasDimension a owl:ObjectProperty ;
    rdfs:label "has dimension" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:hasNonCoherentUnit a owl:DeprecatedProperty,
        owl:ObjectProperty ;
    rdfs:label "has non-coherent unit" ;
    dcterms:description "A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers of the system's base units with the proportionality factor of one."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subPropertyOf ns2:hasDefinedUnit ;
    owl:inverseOf ns2:isCoherentUnitOfSystem .

ns2:hasNumeratorPart a owl:ObjectProperty ;
    rdfs:label "has quantity kind dimension vector numerator part" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:hasQuantity a owl:ObjectProperty ;
    rdfs:label "has quantity" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range ns2:Quantity .

ns2:hasReferenceQuantityKind a owl:ObjectProperty ;
    rdfs:label "has reference quantity kind" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:hasVocabulary a owl:AnnotationProperty ;
    rdfs:label "has vocabulary" ;
    ns2:plainTextDescription "Used to relate a class to one or more graphs where vocabularies for the class are defined." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range owl:Ontology .

ns2:integerPercentage a rdfs:Datatype ;
    rdfs:label "integer percentage" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subClassOf xsd:integer ;
    owl:equivalentClass [ a rdfs:Datatype ;
            rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 100 ] ) ] .

ns2:isAllowedUnitOfSystem a owl:ObjectProperty ;
    rdfs:label "allowed unit of system" ;
    dcterms:description "This property relates a unit of measure with a unit system that does not define the unit, but allows its use within the system. An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:subPropertyOf ns2:isUnitOfSystem ;
    owl:inverseOf ns2:hasAllowedUnit .

ns2:isDimensionInSystem a owl:ObjectProperty ;
    rdfs:label "is dimension in system" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:isMetricUnit a owl:DatatypeProperty ;
    rdfs:label "is metric unit" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:boolean .

ns2:negativeDeltaLimit a owl:DatatypeProperty ;
    rdfs:label "negative delta limit" ;
    dcterms:description "A negative change limit between consecutive sample values for a parameter. The Negative Delta may be the encoded value or engineering units value depending on whether or not a Calibrator is defined."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:string .

ns2:numeratorDimensionVector a owl:ObjectProperty ;
    rdfs:label "numerator dimension vector" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range ns2:QuantityKindDimensionVector .

ns2:numericValue a owl:DatatypeProperty ;
    rdfs:label "numeric value" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range ns3:numericUnion .

ns2:omUnit a owl:ObjectProperty ;
    rdfs:label "om unit" ;
    rdfs:domain ns2:Unit ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:onlineReference a owl:AnnotationProperty ;
    rdfs:label "online reference" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:anyURI .

ns2:outOfScope a owl:AnnotationProperty ;
    rdfs:label "out of scope" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:boolean .

ns2:positiveDeltaLimit a owl:DatatypeProperty ;
    rdfs:label "Positive delta limit" ;
    dcterms:description "A positive change limit between consecutive sample values for a parameter. The Positive Delta may be the encoded value or engineering units value depending on whether or not a Calibrator is defined."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range xsd:string .

ns2:quantity a owl:ObjectProperty ;
    rdfs:label "quantity" ;
    dcterms:description "a property to relate an observable thing with a quantity (qud:Quantity)"^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:reference a owl:ObjectProperty ;
    rdfs:label "reference" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:referenceUnit a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "reference unit" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:relevantQuantityKind a owl:ObjectProperty ;
    rdfs:label "relevant quantity kind" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    rdfs:range ns2:QuantityKind .

ns2:systemDefinition a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "system definition" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:systemDimension a owl:ObjectProperty ;
    rdfs:label "system dimension" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: .

ns2:valueQuantity a owl:ObjectProperty ;
    rdfs:label "value for quantity" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        onto: ;
    owl:inverseOf ns2:quantityValue .

<http://voag.linkedmodel.org/schema/voag#QUDT-SchemaCatalogEntry> a ns1:CatalogEntry ;
    rdfs:label "QUDT Schema Catalog Entry" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .

<http://voag.linkedmodel.org/schema/voag#supersededBy> a owl:ObjectProperty ;
    rdfs:label "superseded by" ;
    rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag> .

prov:wasDerivedFrom a rdf:Property ;
    rdfs:label "was derived from" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov> ;
    rdfs:range ns2:Concept .

dcterms:abstract a owl:AnnotationProperty ;
    rdfs:label "abstract" ;
