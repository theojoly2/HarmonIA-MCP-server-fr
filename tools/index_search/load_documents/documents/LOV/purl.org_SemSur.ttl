<http://purl.org/semsur/A_Tool_for_Generating_OWL_Ontologies_From_Relational_Database_Systems> a [ a owl:Restriction ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:author ],
        [ a owl:Restriction ;
