<http://purl.org/semsur/Treating_Non-RDF_Databases_as_Virtual_RDF_Graphs> a [ a owl:Restriction ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:author ],
        [ a owl:Restriction ;
