<http://www.hozo.jp/owl/EXPOApr19.xml/PhysicalExperiment> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://www.hozo.jp/owl/EXPOApr19.xml/AdminInfoExperiment> ;
            owl:onProperty <http://www.hozo.jp/owl/EXPOApr19.xml/has_admin_info> ],
        [ a owl:Class ;
