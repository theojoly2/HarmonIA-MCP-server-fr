[] a ns2:Imp ;
    rdfs:label "Semsur3"^^xsd:string ;
    ns4:isRuleEnabled true ;
    rdfs:comment "subproblem has the motivation of the problem"^^xsd:string ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:ClassAtom ;
                    ns2:argument1 <http://purl.org/SemSur/SemSur#x> ;
                    ns2:classPredicate <http://purl.org/semsur/Problem> ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:IndividualPropertyAtom ;
                            ns2:argument1 <http://purl.org/SemSur/SemSur#y> ;
                            ns2:argument2 <http://purl.org/SemSur/SemSur#m> ;
                            ns2:propertyPredicate <http://purl.org/semsur/hasMotivation> ] ;
                    rdf:rest [ a ns2:AtomList ;
                            rdf:first [ a ns2:ClassAtom ;
                                    ns2:argument1 <http://purl.org/SemSur/SemSur#y> ;
                                    ns2:classPredicate <http://purl.org/semsur/Problem> ] ;
                            rdf:rest [ a ns2:AtomList ;
                                    rdf:first [ a ns2:IndividualPropertyAtom ;
                                            ns2:argument1 <http://purl.org/SemSur/SemSur#x> ;
                                            ns2:argument2 <http://purl.org/SemSur/SemSur#y> ;
                                            ns2:propertyPredicate <http://purl.org/semsur/isSubproblem> ] ;
                                    rdf:rest () ] ] ] ] ;
    ns2:head [ a ns2:AtomList ;
            rdf:first [ a ns2:IndividualPropertyAtom ;
                    ns2:argument1 <http://purl.org/SemSur/SemSur#x> ;
                    ns2:argument2 <http://purl.org/SemSur/SemSur#m> ;
                    ns2:propertyPredicate <http://purl.org/semsur/hasMotivation> ] ;
            rdf:rest () ] .

