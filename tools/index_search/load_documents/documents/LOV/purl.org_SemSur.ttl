        <http://www.hozo.jp/owl/EXPOApr19.xml/Entity>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Proposition> ;
    rdfs:range <http://www.hozo.jp/owl/EXPOApr19.xml/Abstract>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Entity>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Proposition>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Requirements> .

<http://www.hozo.jp/owl/EXPOApr19.xml/has_organization> a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.hozo.jp/owl/EXPOApr19.xml/Human> <http://www.hozo.jp/owl/EXPOApr19.xml/Organization> ) ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.hozo.jp/owl/EXPOApr19.xml/AdminInfoSubjectOfExperiment> <http://www.hozo.jp/owl/EXPOApr19.xml/ExperimentalEquipment> <http://www.hozo.jp/owl/EXPOApr19.xml/Human> <http://www.hozo.jp/owl/EXPOApr19.xml/Organization> ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.hozo.jp/owl/EXPOApr19.xml/Number> ;
            owl:onProperty <http://www.hozo.jp/owl/EXPOApr19.xml/has_telephone_number> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.hozo.jp/owl/EXPOApr19.xml/Name> ;
