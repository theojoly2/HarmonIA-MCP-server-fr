        <http://www.hozo.jp/owl/EXPOApr19.xml/Agent>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Collection>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Group>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Object>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Physical> .

<http://www.hozo.jp/owl/EXPOApr19.xml/has_standard> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:allValuesFrom <http://www.hozo.jp/owl/EXPOApr19.xml/ExperimentalDesignStrategy> ;
            owl:onProperty <http://www.hozo.jp/owl/EXPOApr19.xml/has_strategy> ],
        [ a owl:Restriction ;
