<http://purl.org/spar/fabio/AnalogManifestation> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Expression> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#embodimentOf> ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Manifestation> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#part> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Manifestation> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ] ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Item> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#exemplar> ] .

<http://purl.org/spar/fabio/Entry> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Work> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#realizationOf> ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#part> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ] ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Manifestation> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#embodiment> ] .

<http://purl.org/spar/fabio/JournalIssue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
            owl:someValuesFrom <http://purl.org/spar/fabio/Periodical> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/spar/fabio/PeriodicalIssue> <http://purl.org/spar/fabio/PeriodicalVolume> ) ] ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#part> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ] ) ],
        [ a owl:Class ;
            owl:unionOf ( <http://purl.org/spar/fabio/PeriodicalIssue> <http://purl.org/spar/fabio/PeriodicalVolume> ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Work> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#realizationOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Manifestation> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#embodiment> ],
        <http://purl.org/spar/fabio/Expression> .

<http://purl.org/spar/fabio/MagazineIssue> a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( <http://purl.org/spar/fabio/PeriodicalIssue> <http://purl.org/spar/fabio/PeriodicalVolume> ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Work> ;
