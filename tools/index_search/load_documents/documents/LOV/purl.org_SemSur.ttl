[] a ns2:Imp ;
    rdfs:label "SemsurQ1"^^xsd:string ;
    ns4:isRuleEnabled true ;
    rdfs:comment ""^^xsd:string ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:IndividualPropertyAtom ;
                    ns2:argument1 <http://purl.org/SemSur/SemSur#x> ;
                    ns2:argument2 <http://purl.org/SemSur/SemSur#y> ;
                    ns2:propertyPredicate <http://purl.org/semsur/isCoAuthor> ] ;
            rdf:rest () ] ;
    ns2:head [ a ns2:AtomList ;
            rdf:first [ a ns2:BuiltinAtom ;
                    ns2:arguments ( <http://purl.org/SemSur/SemSur#x> <http://purl.org/SemSur/SemSur#y> ) ;
                    ns2:builtin <http://sqwrl.stanford.edu/ontologies/built-ins/3.4/sqwrl.owl#select> ] ;
            rdf:rest () ] .

