<http://www.hozo.jp/owl/EXPOApr19.xml/has_evaluation> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:allValuesFrom <http://www.hozo.jp/owl/EXPOApr19.xml/FactSupportResearchHypothesis> ;
            owl:onProperty <http://www.hozo.jp/owl/EXPOApr19.xml/has_fact> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.hozo.jp/owl/EXPOApr19.xml/FactRejectResearchHypothesis> ;
            owl:onProperty <http://www.hozo.jp/owl/EXPOApr19.xml/has_fact> ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.hozo.jp/owl/EXPOApr19.xml/ExperimentalObservation> <http://www.hozo.jp/owl/EXPOApr19.xml/ExperimentalResults> ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.hozo.jp/owl/EXPOApr19.xml/ResultError> ;
            owl:onProperty <http://www.hozo.jp/owl/EXPOApr19.xml/has_error> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.hozo.jp/owl/EXPOApr19.xml/ResultsEvaluation> ;
            owl:onProperty <http://www.hozo.jp/owl/EXPOApr19.xml/has_evaluation> ],
        <http://www.hozo.jp/owl/EXPOApr19.xml/Abstract>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Entity>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Predicate>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Process-relatedRole>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/ProductRole>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Relation>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Role> ;
    rdfs:range <http://www.hozo.jp/owl/EXPOApr19.xml/Abstract>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Entity>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Proposition>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/ScientificTask> .

<http://www.hozo.jp/owl/EXPOApr19.xml/has_experimental_requirements> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:allValuesFrom <http://www.hozo.jp/owl/EXPOApr19.xml/ExperimentalStandard> ;
            owl:onProperty <http://www.hozo.jp/owl/EXPOApr19.xml/has_standard> ],
        [ a owl:Restriction ;
