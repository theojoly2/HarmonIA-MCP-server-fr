<http://purl.org/semsur/Putting_the_spirit_of_the_web_back_into_semantic_web_querying> a [ a owl:Restriction ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:author ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Publication ;
            owl:onProperty ns1:cite ],
        <http://purl.org/semsur/SingleAuthorPublication>,
        ns1:Publication,
        owl:NamedIndividual .

<http://purl.org/semsur/Quang_Trinh> a dcterms:Agent,
        <http://schema.org/Person>,
        <http://www.w3.org/2000/10/swap/pim/contact#Person>,
        owl:NamedIndividual,
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>,
