[] a ns2:Imp ;
    rdfs:label "Semsur2"^^xsd:string ;
    ns4:isRuleEnabled true ;
    rdfs:comment ""^^xsd:string ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:IndividualPropertyAtom ;
                    ns2:argument1 <http://purl.org/SemSur/SemSur#p> ;
                    ns2:argument2 <http://purl.org/SemSur/SemSur#x> ;
                    ns2:propertyPredicate dc:creator ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:IndividualPropertyAtom ;
                            ns2:argument1 <http://purl.org/SemSur/SemSur#p> ;
                            ns2:argument2 <http://purl.org/SemSur/SemSur#y> ;
                            ns2:propertyPredicate dc:creator ] ;
                    rdf:rest [ a ns2:AtomList ;
                            rdf:first [ a ns2:ClassAtom ;
                                    ns2:argument1 <http://purl.org/SemSur/SemSur#p> ;
                                    ns2:classPredicate ns1:Publication ] ;
                            rdf:rest [ a ns2:AtomList ;
                                    rdf:first [ a ns2:DifferentIndividualsAtom ;
                                            ns2:argument1 <http://purl.org/SemSur/SemSur#x> ;
                                            ns2:argument2 <http://purl.org/SemSur/SemSur#y> ] ;
                                    rdf:rest () ] ] ] ] ;
    ns2:head [ a ns2:AtomList ;
            rdf:first [ a ns2:IndividualPropertyAtom ;
                    ns2:argument1 <http://purl.org/SemSur/SemSur#y> ;
                    ns2:argument2 <http://purl.org/SemSur/SemSur#x> ;
                    ns2:propertyPredicate <http://purl.org/semsur/isCoAuthor> ] ;
            rdf:rest () ] .

