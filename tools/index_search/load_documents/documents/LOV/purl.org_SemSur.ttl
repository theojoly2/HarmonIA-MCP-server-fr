        <http://www.hozo.jp/owl/EXPOApr19.xml/Entity>,
        <http://www.hozo.jp/owl/EXPOApr19.xml/Name> .

<http://www.hozo.jp/owl/EXPOApr19.xml/Variable> a owl:Class ;
