    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#PauseApplianceNotification> <http://elite.polito.it/ontologies/dogont.owl#StartApplianceNotification> <http://elite.polito.it/ontologies/dogont.owl#StopApplianceNotification> ) .

<http://elite.polito.it/ontologies/dogont.owl#Awning> a owl:Class ;
    rdfs:label "Awning"^^xsd:string ;
    rdfs:comment "A canopy made of canvas to shelter people or things from rain or sun."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#AwningActuator> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Bed>,
        <http://elite.polito.it/ontologies/dogont.owl#Chair>,
        <http://elite.polito.it/ontologies/dogont.owl#Closet>,
        <http://elite.polito.it/ontologies/dogont.owl#Cupboard>,
        <http://elite.polito.it/ontologies/dogont.owl#Desk>,
