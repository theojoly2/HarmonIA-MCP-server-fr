<http://elite.polito.it/ontologies/dogont.owl#DiscoveryState> a owl:Class ;
    dcterms:description "Describes the state of the device discovery process, i.e., of the process charged to discover new devices on a Home Area network. It can either be active, if the discovery process is on going, or idle, if not."@en ;
