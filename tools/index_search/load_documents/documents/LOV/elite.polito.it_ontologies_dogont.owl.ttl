@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://elite.polito.it/ontologies/dogont.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:license a owl:AnnotationProperty .

onto: a owl:Ontology ;
    ns1:license "Copyright (c) 2008-2014 Dario Bonino\\n\\nLicensed under the Apache License, Version 2.0 (the \"License\");\\nyou may not use this file except in compliance with the License.\\nYou may obtain a copy of the License at\\n\\n     http://www.apache.org/licenses/LICENSE-2.0\\n\\nUnless required by applicable law or agreed to in writing, software\\ndistributed under the License is distributed on an \"AS IS\" BASIS,\\nWITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\\nSee the License for the specific language governing permissions and\\nlimitations under the License"^^xsd:string ;
    dcterms:contributor "Luigi De Russis (luigi.derussis@polito.it, luigidr@gmail.com)"^^xsd:string ;
    dcterms:creator "Dario Bonino (dario.bonino@polito.it, dario.bonino@gmail.com)"^^xsd:string ;
    dcterms:description "DogOnt is a novel modeling language for IDEs (Intelligent Domotic Environment), based on Semantic Web technologies. By adopting well known representations such as ontologies and by providing suitable reasoning facilities, DogOnt is able to face interoperation issues allowing to describe:\\n\\n- where a domotic device is located;\\n- the set of capabilities of a domotic device;\\n- the technology-specific features needed to interface the device;\\n- the possible configurations that the device can assume;\\n- how the home environment is composed;\\n- what kind of architectural elements and furniture are placed inside the home.\\n\\nThis information can then be leveraged by inference-based intelligent systems to provide advanced functionality required in Intelligent Domotic Environments. DogOnt is composed of two elements: the DogOnt ontology, expressed in OWL, which allows to formalize all the aspects of a IDE, and the DogOnt rules, which ease the modeling process by automatically generating proper states and functionalities for domotic devices, and by automatically associating them to the corresponding device instances through semantic relationships. DogOnt is currently adopted to provide house modeling and reasoning capabilities to a domotic gateway called DOG (Domotic OSGi Gateway), which is under development in the authors’ research group and that will be distributed as open source toolkit for building IDEs running on low cost PCs. In this context, a third component of DogOnt, namely DogOnt queries, not presented in this paper, supports runtime control of the IDE."^^xsd:string ;
    dcterms:issued "2008-01-01"^^xsd:string ;
    dcterms:modified "2014-09-24"^^xsd:string ;
    dcterms:rights "Copyright(c) 2008-2014 Dario Bonino"^^xsd:string ;
    dcterms:title "DogOnt: Ontology Modeling for Intelligent Domotic Environments"^^xsd:string ;
    vann:preferredNamespacePrefix "dogont"^^xsd:string ;
    vann:preferredNamespaceUri "http://elite.polito.it/ontologies/dogont"^^xsd:string ;
    owl:imports <http://purl.oclc.org/NET/muo/ucum/> ;
    owl:priorVersion "3.2.10"^^xsd:string ;
    owl:versionInfo "3.2.11"^^xsd:string ;
    foaf:primaryTopic "Domotic Systems"^^xsd:string .

<http://elite.polito.it/ontologies/dogont.owl#AirConditioningSystem> a owl:Class ;
    rdfs:label "AirConditioningSystem"^^xsd:string ;
    rdfs:comment "A system that keeps air cool and dry"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThermostatControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HeatingAndCoolingUnit>,
        <http://elite.polito.it/ontologies/dogont.owl#HeatingSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#Pump>,
        <http://elite.polito.it/ontologies/dogont.owl#PumpController>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem> .

<http://elite.polito.it/ontologies/dogont.owl#AlarmClock> a owl:Class ;
    rdfs:label "AlarmClock"^^xsd:string ;
    rdfs:comment "A clock that wakes sleeper at preset time"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Clock> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#CoffeeMaker>,
        <http://elite.polito.it/ontologies/dogont.owl#Communication>,
        <http://elite.polito.it/ontologies/dogont.owl#Computer>,
        <http://elite.polito.it/ontologies/dogont.owl#Entertainment>,
        <http://elite.polito.it/ontologies/dogont.owl#Fan>,
        <http://elite.polito.it/ontologies/dogont.owl#Printer> .

<http://elite.polito.it/ontologies/dogont.owl#AnsweringMachine> a owl:Class ;
    rdfs:label "AnsweringMachine"^^xsd:string ;
    rdfs:comment "Electronic device that answers the telephone and records messages"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Communication> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Fax>,
        <http://elite.polito.it/ontologies/dogont.owl#Interphone>,
        <http://elite.polito.it/ontologies/dogont.owl#Phone> .

<http://elite.polito.it/ontologies/dogont.owl#Armchair> a owl:Class ;
    rdfs:label "Armchair"^^xsd:string ;
    rdfs:comment "Chair with a support on each side for arms"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Awning>,
        <http://elite.polito.it/ontologies/dogont.owl#Bed>,
        <http://elite.polito.it/ontologies/dogont.owl#Chair>,
        <http://elite.polito.it/ontologies/dogont.owl#Closet>,
        <http://elite.polito.it/ontologies/dogont.owl#Cupboard>,
        <http://elite.polito.it/ontologies/dogont.owl#Desk>,
        <http://elite.polito.it/ontologies/dogont.owl#Drawer>,
        <http://elite.polito.it/ontologies/dogont.owl#Nightstand>,
        <http://elite.polito.it/ontologies/dogont.owl#SanitaryFixtures>,
        <http://elite.polito.it/ontologies/dogont.owl#Shade>,
        <http://elite.polito.it/ontologies/dogont.owl#Shutter>,
        <http://elite.polito.it/ontologies/dogont.owl#Sofa>,
        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#Balcony> a owl:Class ;
    rdfs:label "Balcony"^^xsd:string ;
    rdfs:comment "A platform projecting from the wall of a building and surrounded by a balustrade or railing or parapet"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Horizontal> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Ceiling>,
        <http://elite.polito.it/ontologies/dogont.owl#Floor>,
        <http://elite.polito.it/ontologies/dogont.owl#Terrace> .

<http://elite.polito.it/ontologies/dogont.owl#BatteryLevelNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#BatteryLevelNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Boiler> a owl:Class ;
    rdfs:label "Boiler"^^xsd:string ;
    rdfs:comment "Sealed vessel where water is warm up"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperHeatingNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatingApplianceState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperHeatingFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#WhiteGoods> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Cooker>,
        <http://elite.polito.it/ontologies/dogont.owl#DeepFreezer>,
        <http://elite.polito.it/ontologies/dogont.owl#Dishwasher>,
        <http://elite.polito.it/ontologies/dogont.owl#Fridge>,
        <http://elite.polito.it/ontologies/dogont.owl#Oven>,
        <http://elite.polito.it/ontologies/dogont.owl#Stove>,
        <http://elite.polito.it/ontologies/dogont.owl#WashingMachine> .

<http://elite.polito.it/ontologies/dogont.owl#Building> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#contains> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Storey> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#contains> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#contains> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Flat> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#contains> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Garden> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#contains> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Garage> ],
        <http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Flat>,
        <http://elite.polito.it/ontologies/dogont.owl#Garage>,
        <http://elite.polito.it/ontologies/dogont.owl#Garden>,
        <http://elite.polito.it/ontologies/dogont.owl#Room> .

<http://elite.polito.it/ontologies/dogont.owl#Button> a owl:Class ;
    rdfs:label "Button"^^xsd:string ;
    rdfs:comment "A monostable electrical switch operated by pressing a button"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ButtonNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HeatingAndCoolingUnit>,
        <http://elite.polito.it/ontologies/dogont.owl#Knob>,
        <http://elite.polito.it/ontologies/dogont.owl#PumpController>,
        <http://elite.polito.it/ontologies/dogont.owl#RemoteControl>,
        <http://elite.polito.it/ontologies/dogont.owl#SceneSelector>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeController>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleScenarioControl>,
        <http://elite.polito.it/ontologies/dogont.owl#Switch>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay> .

<http://elite.polito.it/ontologies/dogont.owl#Buzzer> a owl:Class ;
    rdfs:label "Buzzer"^^xsd:string ;
    rdfs:comment "An electric signaling device, such as a doorbell, that makes a buzzing sound."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Acoustic> .

<http://elite.polito.it/ontologies/dogont.owl#Co2Sensor> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Co2MeasurementState> ],
        [ a owl:Restriction ;
            owl:onClass <http://elite.polito.it/ontologies/dogont.owl#Co2MeasurementState> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Co2MeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Co2MeasurementNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> .

<http://elite.polito.it/ontologies/dogont.owl#ColorDimmerSwitch> a owl:Class ;
    rdfs:comment "The Color Dimmer Switch device can turn a light on and off, and control the luminance, hue and saturation levels of a multicolor light, derives from ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ColorDimmableLight> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#controlledObject> ],
        <http://elite.polito.it/ontologies/dogont.owl#DimmerSwitch> .

<http://elite.polito.it/ontologies/dogont.owl#ColorStateHSB> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#BrightnessStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HueStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SaturationStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ColorState> .

<http://elite.polito.it/ontologies/dogont.owl#ColorStateRGB> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#BlueStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#RedStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GreenStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ColorState> .

<http://elite.polito.it/ontologies/dogont.owl#ConfigurationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GetConfigurationCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#CoolingApplianceState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperCoolingStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#GenericApplianceState> .

<http://elite.polito.it/ontologies/dogont.owl#DeviceAssociationState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#AssociatingStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#IdleStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DisassociatingStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedState> .

<http://elite.polito.it/ontologies/dogont.owl#DoubleBed> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Bed> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SingleBed> .

<http://elite.polito.it/ontologies/dogont.owl#Dvd> a owl:Class ;
    rdfs:label "Dvd"^^xsd:string ;
    rdfs:comment "Appliance thar read dvd"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PlayNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffStandByFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#VolumeRegulationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StandByOnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffStandbyNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PlayState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#VolumeLevelState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PlayFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Entertainment> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HiFi>,
        <http://elite.polito.it/ontologies/dogont.owl#Radio>,
        <http://elite.polito.it/ontologies/dogont.owl#Tv> .

<http://elite.polito.it/ontologies/dogont.owl#ElectricalCooker> a owl:Class ;
    rdfs:label "ElectricalCooker"^^xsd:string ;
    rdfs:comment "Electrical Cooker"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Cooker> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GasCooker>,
        <http://elite.polito.it/ontologies/dogont.owl#Hotplate> .

<http://elite.polito.it/ontologies/dogont.owl#ElectricalOven> a owl:Class ;
    rdfs:label "ElectricalOven"^^xsd:string ;
    rdfs:comment "Electrical oven"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Oven> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#MicrowaveOven> .

<http://elite.polito.it/ontologies/dogont.owl#EnergyAndPowerMeter> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActivePowerMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseEnergyMeter> .

<http://elite.polito.it/ontologies/dogont.owl#EnergyAndPowerMeteringLevelControllableOutput> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#LevelControllableOutput>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActiveEnergyMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActivePowerMeter> .

<http://elite.polito.it/ontologies/dogont.owl#Entrance> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Door> .

<http://elite.polito.it/ontologies/dogont.owl#EventsAndAlertsNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#MultipleAlertNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#MultipleEventNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Fence> a owl:Class ;
    rdfs:label "Fence"^^xsd:string ;
    rdfs:comment "A barrier that serves to enclose an area"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Vertical> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#FenceOpening>,
        <http://elite.polito.it/ontologies/dogont.owl#Wall>,
        <http://elite.polito.it/ontologies/dogont.owl#WallOpening> .

<http://elite.polito.it/ontologies/dogont.owl#FlashingLamp> a owl:Class ;
    rdfs:label "FlashingLamp"^^xsd:string ;
    rdfs:comment "Lamp that emits light in sudden short or intermittent bursts"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFlashingFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#SimpleLamp> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#OnOffLight> .

<http://elite.polito.it/ontologies/dogont.owl#GasHeater> a owl:Class ;
    rdfs:label "GasHeater"^^xsd:string ;
    rdfs:comment "Heater that combusts gas"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Heater> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GasoilHeater>,
        <http://elite.polito.it/ontologies/dogont.owl#PelletHeater> .

<http://elite.polito.it/ontologies/dogont.owl#GasMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GasMeasurementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GasMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GasMeasurementFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Meter> .

<http://elite.polito.it/ontologies/dogont.owl#HeatingEnergyMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatingEnergyMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatingEnergyMeasurementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatingEnergyMeasurementFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Meter> .

<http://elite.polito.it/ontologies/dogont.owl#HueBridge> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PushLinkFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PushLinkAuthenticationState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PushLinkNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ConnectionState> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#IPAddress> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://elite.polito.it/ontologies/dogont.owl#HueComponent> .

<http://elite.polito.it/ontologies/dogont.owl#HueManager> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DiscoveryNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DiscoveryState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DiscoveryFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#HueComponent> .

<http://elite.polito.it/ontologies/dogont.owl#Jacuzzi> a owl:Class ;
    rdfs:label "Jacuzzi"^^xsd:string ;
    rdfs:comment "A large whirlpool bathtub with underwater jets that massage the body"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Bathtub> .

<http://elite.polito.it/ontologies/dogont.owl#LampHolder> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#OnOffOutput> .

<http://elite.polito.it/ontologies/dogont.owl#MeteringPowerOutlet> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#EnergyMeteringPowerOutlet>,
        <http://elite.polito.it/ontologies/dogont.owl#PowerFactorMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#PowerMeteringPowerOutlet> .

<http://elite.polito.it/ontologies/dogont.owl#MovementAndTemperatureSensor> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#MovementSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleTemperatureSensor> .

<http://elite.polito.it/ontologies/dogont.owl#MovingUpDownState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#RaisingStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LoweringStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#MovementState> .

<http://elite.polito.it/ontologies/dogont.owl#MultiTariffSinglePhaseEnergyMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffSinglePhaseReactiveEnergyMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffSinglePhaseActiveEnergyState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffSinglePhaseActiveEnergyMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffSinglePhaseActiveEnergyMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffSinglePhaseReactiveEnergyState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffSinglePhaseReactiveEnergyMeasurementFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#MultiTariffEnergyMeter> .

<http://elite.polito.it/ontologies/dogont.owl#MultiTariffThreePhaseEnergyMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffThreePhaseActiveEnergyMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffThreePhaseActiveEnergyMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffThreePhaseReactiveEnergyMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffThreePhaseReactiveEnergyState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffThreePhaseActiveEnergyState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiTariffThreePhaseReactiveEnergyMeasurementFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#MultiTariffEnergyMeter> .

<http://elite.polito.it/ontologies/dogont.owl#MultipleFlowSensor> a owl:Class ;
    rdfs:comment "The Flow  Sensor device measures and periodically reports the flow rate of a liquid (typically water)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultipleFlowMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultipleFlowMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultipleFlowRateState> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        <http://elite.polito.it/ontologies/dogont.owl#FlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem> .

<http://elite.polito.it/ontologies/dogont.owl#MultipleHumidityMeasurementFunctionality> a owl:Class ;
    rdfs:comment "The capability of measuring the humidity of a room"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityMCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#MultipleHumidityMeasurementNotificationFunctionality> a owl:Class ;
    rdfs:comment "The notification for requesting humidity measurment..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementMNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#MultiplePressureSensor> a owl:Class ;
    rdfs:comment "The Pressure Sensor device measures and periodically reports the pressure of a liquid (typically water)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiplePressureMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiplePressureMeasurementNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> .

<http://elite.polito.it/ontologies/dogont.owl#MultiplePressureState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultiplePressureStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> .

<http://elite.polito.it/ontologies/dogont.owl#MultipleTemperatureSensor> a owl:Class ;
    rdfs:label "TemperatureSensor"^^xsd:string ;
    rdfs:comment "Sensor that detects the temperature of the atmosphere"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultipleTemperatureMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultipleTemperatureState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultipleTemperatureMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureSensor> .

<http://elite.polito.it/ontologies/dogont.owl#OnOffLightSwitch> a owl:Class ;
    rdfs:comment "OnOffSwitch for Lights only, derives from ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Lighting> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#controlledObject> ],
        <http://elite.polito.it/ontologies/dogont.owl#OnOffSwitch> .

<http://elite.polito.it/ontologies/dogont.owl#OverloadControlFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OverloadPauseResumeCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OverloadPauseCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OverloadWarningCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Partition> a owl:Class ;
    rdfs:label "Partition"^^xsd:string ;
    rdfs:comment "A vertical structure that divides or separates"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Wall> .

<http://elite.polito.it/ontologies/dogont.owl#PowerMeteringLevelControllableOutput> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#LevelControllableOutput>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActivePowerMeter> .

<http://elite.polito.it/ontologies/dogont.owl#PresenceAndMovementSensor> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#MovementSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#PresenceSensor> .

<http://elite.polito.it/ontologies/dogont.owl#QuadSensor> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#HumiditySensor>,
        <http://elite.polito.it/ontologies/dogont.owl#LightSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#MovementSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleTemperatureSensor> .

<http://elite.polito.it/ontologies/dogont.owl#SelfClosingDoorActuator> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TimedOnFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoorActuator> .

<http://elite.polito.it/ontologies/dogont.owl#ShutterButton> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#UpDownNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#UpDownRestState> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control> .

<http://elite.polito.it/ontologies/dogont.owl#SinglePhaseElectricityMeter> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#FrequencyMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#PowerFactorMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActivePowerMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseApparentPowerMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseCurrentMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseEnergyMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseReactivePowerMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseVoltageMeter> .

<http://elite.polito.it/ontologies/dogont.owl#Siren> a owl:Class ;
    rdfs:label "Siren"^^xsd:string ;
    rdfs:comment "A device in which compressed air or steam is driven against a rotating perforated disk to create a loud, often wailing sound as a signal or warning.\\n\\nAn electronic device producing a similar sound as a signal or warning: a police car siren."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Acoustic> .

<http://elite.polito.it/ontologies/dogont.owl#SnapshotCamera> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CameraPictureZoomPanControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CameraPictureQualityControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CameraPictureImageControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PictureGrabFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#SurveillanceCamera> .

<http://elite.polito.it/ontologies/dogont.owl#StepShutterActuator> a owl:Class ;
