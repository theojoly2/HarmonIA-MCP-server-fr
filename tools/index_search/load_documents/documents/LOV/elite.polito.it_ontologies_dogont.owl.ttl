<http://elite.polito.it/ontologies/dogont.owl#PushLinkAuthenticationState> a owl:Class ;
    dcterms:description "Describes the possible states in which the push-link authentication process can be, which are either active, i.e., the manager is registering access credentials on the bridge whose push-button has been pressed by the user, or idle, i.e., doing nothing"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ActivePushLinkAuthenticationStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#NeedingAuthenticationStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#AuthenticatedStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteState> .

