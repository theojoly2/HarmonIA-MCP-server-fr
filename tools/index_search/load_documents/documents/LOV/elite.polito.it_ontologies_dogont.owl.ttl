<http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> a owl:Class ;
    rdfs:label "OnOffNotificationFunctionality"^^xsd:string ;
    rdfs:comment "Notification: on - off"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OffNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#OpenCloseNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PresenceNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#UpDownNotificationFunctionality> .

