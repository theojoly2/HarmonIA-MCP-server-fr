<http://elite.polito.it/ontologies/dogont.owl#EndTimeChangedNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "endTime^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "changedEndTime"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        <http://elite.polito.it/ontologies/dogont.owl#ApplianceCycleTimingNotification> .

<http://elite.polito.it/ontologies/dogont.owl#EnergyMeasurementFunctionality> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#EnergyMeasurementNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#EnergyMeter> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ElectricityMeter> .

<http://elite.polito.it/ontologies/dogont.owl#FailureStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "failure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#FireSystem> a owl:Class ;
    rdfs:label "FireSystem"^^xsd:string ;
    rdfs:comment "System that detects the presence of fire"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#SecuritySystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#FloodSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#GasSystem> .

<http://elite.polito.it/ontologies/dogont.owl#FireUpStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "firingUp"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#FiringUpNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "firingUp"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#FlowMeasurementFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GetFlowRateCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#LightSensingFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#OccupancySensingFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PictureGrabFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#FlowRateState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FlowRateStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementState>,
        <http://elite.polito.it/ontologies/dogont.owl#LevelState>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureState>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeState>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureState>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerState> .

<http://elite.polito.it/ontologies/dogont.owl#FlowSensor> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Sensor> .

<http://elite.polito.it/ontologies/dogont.owl#ForwardNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "fwd"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#PlaybackNotification> .

<http://elite.polito.it/ontologies/dogont.owl#ForwardStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "forward"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#FreeStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "noPersonInside"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#FrequencyMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FrequencyMeasurementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FrequencyMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FrequencyMeasurementNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#ElectricityMeter> .

<http://elite.polito.it/ontologies/dogont.owl#GasSensor> a owl:Class ;
    rdfs:label "GasSensor"^^xsd:string ;
    rdfs:comment "Sensor that detects the presence of gas"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SensingState> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        <http://elite.polito.it/ontologies/dogont.owl#GasSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#InfraredSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#OccupancySensor>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SmokeSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> .

<http://elite.polito.it/ontologies/dogont.owl#HeatingAndCoolingUnit> a owl:Class ;
    rdfs:comment "The Heating and Cooling Unit device can heat or cool a space in a house. It is not mandatory to provide both functionalities. It may be an indoor air handler. Derives from ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThermostatControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SpeedNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelControlNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FanControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatingAndCoolingUnitState> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control>,
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HeatingSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#Knob>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#Pump>,
        <http://elite.polito.it/ontologies/dogont.owl#PumpController>,
        <http://elite.polito.it/ontologies/dogont.owl#RemoteControl>,
        <http://elite.polito.it/ontologies/dogont.owl#SceneSelector>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeController>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleScenarioControl>,
        <http://elite.polito.it/ontologies/dogont.owl#Switch>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay>,
        <http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem> .

<http://elite.polito.it/ontologies/dogont.owl#HeatingAndCoolingUnitState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OffStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#AutoRegulationStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CoolingStateValue> ],
        [ a owl:Restriction ;
            owl:minCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatingStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PlayState>,
        <http://elite.polito.it/ontologies/dogont.owl#SourceSelectionState>,
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedState> .

<http://elite.polito.it/ontologies/dogont.owl#Hotplate> a owl:Class ;
    rdfs:label "Hotplate"^^xsd:string ;
    rdfs:comment "A portable electric appliance for heating or cooking or keeping food warm"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Cooker> .

<http://elite.polito.it/ontologies/dogont.owl#HueComponent> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkComponent> .

<http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementFunctionality> a owl:Class ;
    rdfs:comment "The capability of measuring the humidity of a room"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#LightSensingFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#OccupancySensingFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PictureGrabFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "changedRelativeHumidity"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:hasValue "relativeHumidity^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#LevelStepDownNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#LevelStepUpNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#SimpleMovementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#SimpleNoMovementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotification> .

<http://elite.polito.it/ontologies/dogont.owl#HumiditySensor> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementState> ],
        [ a owl:Restriction ;
            owl:onClass <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementState> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> .

<http://elite.polito.it/ontologies/dogont.owl#IdentifyNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "identifyMe"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#Interphone> a owl:Class ;
    rdfs:label "Interphone"^^xsd:string ;
    rdfs:comment "A telephonic intercommunication system linking different rooms in a building"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Communication> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Phone> .

<http://elite.polito.it/ontologies/dogont.owl#IsPresentNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "isPresent"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#Knob> a owl:Class ;
    rdfs:label "Knob"^^xsd:string ;
    rdfs:comment "A round handle used to adjust continuous amplitude, e.g. volume"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PumpController>,
        <http://elite.polito.it/ontologies/dogont.owl#RemoteControl>,
        <http://elite.polito.it/ontologies/dogont.owl#SceneSelector>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeController>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleScenarioControl>,
        <http://elite.polito.it/ontologies/dogont.owl#Switch>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay> .

<http://elite.polito.it/ontologies/dogont.owl#Lamp> a owl:Class ;
    rdfs:label "Lamp"^^xsd:string ;
    rdfs:comment "An artificial source of visible illumination"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Lighting> .

<http://elite.polito.it/ontologies/dogont.owl#LevelControllableOutput> a owl:Class ;
    rdfs:comment "Output device whose output level can be controlled continuously, by means of a level-control command (notification), derives from ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:minCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ],
