        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#BTicinoComponent> a owl:Class ;
    rdfs:label "BTicinoComponent"^^xsd:string ;
    rdfs:comment "Components manufactured by Bticino"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
