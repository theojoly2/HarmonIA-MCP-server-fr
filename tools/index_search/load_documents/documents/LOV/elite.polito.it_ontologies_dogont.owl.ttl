<http://elite.polito.it/ontologies/dogont.owl#HVACSystem> a owl:Class ;
    rdfs:label "HVACSystem"^^xsd:string ;
    rdfs:comment "Heating Ventilating and Air Conditioning system"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#HousePlants> .

<http://elite.polito.it/ontologies/dogont.owl#SanitaryFixtures> a owl:Class ;
    rdfs:label "SanitaryFixtures"^^xsd:string ;
    rdfs:comment "All the fixtures of a bathroom"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Shade>,
        <http://elite.polito.it/ontologies/dogont.owl#Shutter>,
        <http://elite.polito.it/ontologies/dogont.owl#Sofa>,
        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#Shutter> a owl:Class ;
    rdfs:label "Shutter"@en ;
    rdfs:comment "A hinged cover or screen for a window, usually fitted with louvers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ShutterActuator> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        <http://elite.polito.it/ontologies/dogont.owl#WallOpening> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Sofa>,
        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality> a owl:Class ;
    rdfs:comment "Notification functionality for controlling continuously adjustable device, e.g. dimmers, derives from ZigBee Home Automation specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelControlNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#LevelNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Thermostat> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OccupancySensingFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SpeedNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThermostatControlFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control>,
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay>,
        <http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem> .

<http://elite.polito.it/ontologies/dogont.owl#Wardrobe> a owl:Class ;
    rdfs:label "Wardrobe"^^xsd:string ;
    rdfs:comment "A tall piece of furniture that provides storage space for clothes"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> .

<http://elite.polito.it/ontologies/dogont.owl#DoubleValuedNotificationFunctionality> a owl:Class ;
    rdfs:label "DoubleValuedNotificationFunctionality"^^xsd:string ;
    rdfs:comment "Discrete notification with exactly two values"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://elite.polito.it/ontologies/dogont.owl#Notification> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#NetworkNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleValuedNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "goToTrack"^^xsd:string ;
