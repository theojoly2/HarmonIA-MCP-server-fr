        <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopHeatingCoolingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopPlayingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#UpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> .

<http://elite.polito.it/ontologies/dogont.owl#Door> a owl:Class ;
    rdfs:label "Door"^^xsd:string ;
    rdfs:comment "A swinging or sliding barrier that will close the entrance to a room or building."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DoorActuator> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        [ a owl:Restriction ;
            owl:maxCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DoorSensor> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasSensor> ],
        <http://elite.polito.it/ontologies/dogont.owl#WallOpening> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Window> .

<http://elite.polito.it/ontologies/dogont.owl#EchelonNetworkComponent> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkComponent> .

<http://elite.polito.it/ontologies/dogont.owl#Fan> a owl:Class ;
    rdfs:label "Fan"^^xsd:string ;
    rdfs:comment "A device for creating a current of air"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#BrownGoods> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Printer> .

<http://elite.polito.it/ontologies/dogont.owl#GetFlowRateMCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "getFlowRateFrom"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        [ a owl:Restriction ;
            owl:hasValue "sensorURI^^String"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#commandParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#returnType> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonVoidCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ParametricCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GetLuminanceCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetOccupancyCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SelectSourceCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand> .

<http://elite.polito.it/ontologies/dogont.owl#HumidityStateValue> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#LevelStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#ReactiveEnergyStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureStateValue> .

<http://elite.polito.it/ontologies/dogont.owl#JoinGroupNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        [ a owl:Restriction ;
            owl:hasValue "joinedGroup"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:hasValue "groupNumber^^Integer"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#LeaveGroupNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#LevelControlNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementMNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementMNotification> .

<http://elite.polito.it/ontologies/dogont.owl#KonnexProperty> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#KNXNetIPComponent> <http://elite.polito.it/ontologies/dogont.owl#KonnexCommand> <http://elite.polito.it/ontologies/dogont.owl#KonnexComponent> <http://elite.polito.it/ontologies/dogont.owl#KonnexNotification> ) ] ;
    rdfs:range xsd:string .

<http://elite.polito.it/ontologies/dogont.owl#LevelNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> ;
    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#PlayNotificationFunctionality> <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality> <http://elite.polito.it/ontologies/dogont.owl#SpeedNotificationFunctionality> <http://elite.polito.it/ontologies/dogont.owl#TunerNotificationFunctionality> ) .

<http://elite.polito.it/ontologies/dogont.owl#LevelStepUpNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "stepUp"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricLevelNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#SimpleMovementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#SimpleNoMovementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotification> .

<http://elite.polito.it/ontologies/dogont.owl#ModBusProperty> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#ModBusStateValue> <http://elite.polito.it/ontologies/dogont.owl#ModbusCommand> <http://elite.polito.it/ontologies/dogont.owl#ModbusComponent> <http://elite.polito.it/ontologies/dogont.owl#ModbusNotification> ) ] ;
    rdfs:range rdfs:Literal .

<http://elite.polito.it/ontologies/dogont.owl#ModbusCommand> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificCommand> .

<http://elite.polito.it/ontologies/dogont.owl#ModbusComponent> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkComponent> .

<http://elite.polito.it/ontologies/dogont.owl#ModbusNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificNotification> .

<http://elite.polito.it/ontologies/dogont.owl#NetworkNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Notification> .

<http://elite.polito.it/ontologies/dogont.owl#NoMovementNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> ;
    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#RestDownNotification> <http://elite.polito.it/ontologies/dogont.owl#RestNotification> <http://elite.polito.it/ontologies/dogont.owl#RestUpNotification> <http://elite.polito.it/ontologies/dogont.owl#SimpleNoMovementNotification> ) .

<http://elite.polito.it/ontologies/dogont.owl#OccupancySensingFunctionality> a owl:Class ;
    rdfs:comment "Functionality for getting the occupancy state of a given room"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GetOccupancyCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PictureGrabFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#PictureGrabFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#PresenceNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#IsPresentNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#NotPresentNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#UpDownNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#PresenceState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#NotPresentState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PresentStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SensingState> .

<http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "pressureValue^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "newPressureValue"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SimpleMovementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#SimpleNoMovementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotification> .

<http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#SceneSelector> a owl:Class ;
    rdfs:comment "The Scene Selector device is capable of setting up and selecting scenes on other devices, including group of devices. It derives from ZigBee HA specifications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#NetworkNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ShadeController>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleScenarioControl>,
        <http://elite.polito.it/ontologies/dogont.owl#Switch>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay> .

<http://elite.polito.it/ontologies/dogont.owl#ShadeState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ShadeStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TemperatureState>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerState> .

<http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActivePowerMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActivePowerMeasurementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActivePowerMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActivePowerMeasurementFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#ActivePowerMeter> .

<http://elite.polito.it/ontologies/dogont.owl#State> a owl:Class ;
    rdfs:label "State"^^xsd:string ;
    rdfs:comment "Models the states of the controllable objects"^^xsd:string .

<http://elite.polito.it/ontologies/dogont.owl#TripleValuedNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://elite.polito.it/ontologies/dogont.owl#Notification> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#UpDownNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressedDownNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressedUpNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Vertical> a owl:Class ;
    rdfs:label "Vertical"^^xsd:string ;
    rdfs:comment "The vertical architectural component of a building"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Architectural> .

<http://elite.polito.it/ontologies/dogont.owl#VolumeLevelState> a owl:Class ;
    rdfs:label "VolumeLevel"^^xsd:string ;
    rdfs:comment "Models the volume value"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#LevelState> .

<http://elite.polito.it/ontologies/dogont.owl#VolumeRegulationFunctionality> a owl:Class ;
    rdfs:label "VolumeRegulationFunctionality"^^xsd:string ;
    rdfs:comment "Functionalities for the regulation of volume"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#IncreaseVolumeCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DecreaseVolumeCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousControlFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#WashingNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> ;
    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#StartedHeatingCycleNotification> <http://elite.polito.it/ontologies/dogont.owl#StartedWashingNotification> <http://elite.polito.it/ontologies/dogont.owl#StoppedHeatingCycleNotification> <http://elite.polito.it/ontologies/dogont.owl#StoppedWashingNotification> ) .

<http://elite.polito.it/ontologies/dogont.owl#Window> a owl:Class ;
    rdfs:label "Window"^^xsd:string ;
    rdfs:comment "A framework that contains a glass windowpane and is built into a wall or roof to admit light or air"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasSensor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#WindowActuator> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        <http://elite.polito.it/ontologies/dogont.owl#WallOpening> .

<http://elite.polito.it/ontologies/dogont.owl#controlledObject> a owl:ObjectProperty ;
    rdfs:label "controlledObject"^^xsd:string ;
    rdfs:comment "Association between a controller and the controlled object"^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Control> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#Acoustic> <http://elite.polito.it/ontologies/dogont.owl#Actuator> <http://elite.polito.it/ontologies/dogont.owl#Control> <http://elite.polito.it/ontologies/dogont.owl#Lighting> <http://elite.polito.it/ontologies/dogont.owl#PowerDelivery> ) ] .

<http://elite.polito.it/ontologies/dogont.owl#Appliances> a owl:Class ;
    rdfs:label "Appliances"^^xsd:string ;
    rdfs:comment "Durable goods for home or office use"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#isIn> ],
        <http://elite.polito.it/ontologies/dogont.owl#Controllable> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HousePlants> .

<http://elite.polito.it/ontologies/dogont.owl#BTicinoGateway> a owl:Class ;
    rdfs:label "BTicinoGateway"^^xsd:string ;
    rdfs:comment "A BTIcino Gateway"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#connectionTrials> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#port> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#connectionTimeOut> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#sleepTime> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#IPAddress> ],
        <http://elite.polito.it/ontologies/dogont.owl#BTicinoComponent> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#EliteGateway>,
        <http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> .

<http://elite.polito.it/ontologies/dogont.owl#Communication> a owl:Class ;
    rdfs:label "Communication"^^xsd:string ;
    rdfs:comment "Appliances for communicate"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#BrownGoods> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Computer>,
        <http://elite.polito.it/ontologies/dogont.owl#Entertainment>,
        <http://elite.polito.it/ontologies/dogont.owl#Fan>,
        <http://elite.polito.it/ontologies/dogont.owl#Printer> .

<http://elite.polito.it/ontologies/dogont.owl#DecreaseQualityCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "decreaseQuality"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#VoidCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#DeleteGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DeleteSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ForwardCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetFlowRateCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetOccupancyCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#HeatCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseColorCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseContrastCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseLuminosityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseQualityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#NextTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OpenCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanLeftCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanRightCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PauseCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PlayCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PreviousTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RestCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RewindCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StandBy>,
        <http://elite.polito.it/ontologies/dogont.owl#StepDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopHeatingCoolingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopPlayingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#UpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> .

<http://elite.polito.it/ontologies/dogont.owl#Desk> a owl:Class ;
    rdfs:label "Desk"^^xsd:string ;
    rdfs:comment "A piece of furniture with a writing surface and usually drawers or other compartments"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Drawer>,
        <http://elite.polito.it/ontologies/dogont.owl#Nightstand>,
        <http://elite.polito.it/ontologies/dogont.owl#SanitaryFixtures>,
        <http://elite.polito.it/ontologies/dogont.owl#Shade>,
        <http://elite.polito.it/ontologies/dogont.owl#Shutter>,
        <http://elite.polito.it/ontologies/dogont.owl#Sofa>,
        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#DiscreteNotificationFunctionality> a owl:Class ;
    rdfs:label "DiscreteNotificationFunctionality"^^xsd:string ;
    rdfs:comment "Notification of fixed values"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#ElectricityMeter> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Meter> .

<http://elite.polito.it/ontologies/dogont.owl#FanControlFunctionality> a owl:Class ;
    rdfs:comment "Models the capability of controlling the speed of a cooling/heating fan. Derives from ZigBee HA"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SpeedUpCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SpeedDownCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#LevelControlFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#ShutterRegulationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#ThermostatControlFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TimeRegulationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#GetLuminanceCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "getLuminance"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        [ a owl:Restriction ;
            owl:hasValue "Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#returnType> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#NonVoidCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GetOccupancyCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SelectSourceCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand> .

<http://elite.polito.it/ontologies/dogont.owl#HousePlants> a owl:Class ;
    rdfs:label "HousePlants"^^xsd:string ;
    rdfs:comment "All plants of the house, e.g. Electrical system, Hydraulic system"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Controllable> .

<http://elite.polito.it/ontologies/dogont.owl#IPAddress> a owl:DatatypeProperty ;
    rdfs:label "IPAddress"^^xsd:string ;
    rdfs:comment "The IP address of the gateway"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#BTicinoGateway> <http://elite.polito.it/ontologies/dogont.owl#EchelonIlon100Gateway> <http://elite.polito.it/ontologies/dogont.owl#KNXNetIPGateway> <http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> <http://elite.polito.it/ontologies/dogont.owl#ModbusGateway> ) ] ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:anyURI xsd:string ) ] .

<http://elite.polito.it/ontologies/dogont.owl#KonnexComponent> a owl:Class ;
    rdfs:label "KonnexComponent"^^xsd:string ;
    rdfs:comment "Components manufactured by Konnex"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#individualAddress> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkComponent> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ZigBeeComponent> .

<http://elite.polito.it/ontologies/dogont.owl#LeaveGroupNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "groupNumber^^Integer"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        [ a owl:Restriction ;
            owl:hasValue "leftGroup"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#LevelControlNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementMNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementMNotification> .

<http://elite.polito.it/ontologies/dogont.owl#LevelStateValue> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PressureStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#ReactiveEnergyStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureStateValue> .

<http://elite.polito.it/ontologies/dogont.owl#Meter> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ElectricalSystem> .

<http://elite.polito.it/ontologies/dogont.owl#MovementNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SimpleNoMovementNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SimpleMovementNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#OpenCloseNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PresenceNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#UpDownNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Notification> .

<http://elite.polito.it/ontologies/dogont.owl#NotificationFunctionality> a owl:Class ;
    rdfs:label "NotificationFunctionality"^^xsd:string ;
    rdfs:comment "Capability of a controllable building thing that notifies information,e.g.door sensor notifies \"open\"-\"close\""^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#Functionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#OnOffStandByFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OffCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StandBy> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#UpDownRestFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#OnOffStandbyNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StandByNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OffNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#OpenCloseFunctionality> a owl:Class ;
    rdfs:label "OpenCloseFunctionality"^^xsd:string ;
    rdfs:comment "Functionality: open - close"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CloseCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#StepFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#UpDownFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#PlaybackNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> ;
    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#ForwardNotification> <http://elite.polito.it/ontologies/dogont.owl#PausePlaybackNotification> <http://elite.polito.it/ontologies/dogont.owl#PlayNotification> <http://elite.polito.it/ontologies/dogont.owl#RewindNotification> <http://elite.polito.it/ontologies/dogont.owl#StopPlaybackNotification> ) .

<http://elite.polito.it/ontologies/dogont.owl#PressureState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ShadeState>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureState>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerState> .

<http://elite.polito.it/ontologies/dogont.owl#Printer> a owl:Class ;
    rdfs:label "Printer"^^xsd:string ;
    rdfs:comment "Output device that prints"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#BrownGoods> .

<http://elite.polito.it/ontologies/dogont.owl#ShadeController> a owl:Class ;
    rdfs:comment "The Shade Controller device can control the level of a shade, derives from ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#IdentificationNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SingleScenarioControl>,
        <http://elite.polito.it/ontologies/dogont.owl#Switch>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay> .

<http://elite.polito.it/ontologies/dogont.owl#ShutterRegulationFunctionality> a owl:Class ;
    rdfs:label "ShutterRegulationFunctionality"^^xsd:string ;
    rdfs:comment "Functionalities for the regulation of shutter"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#UpCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DownCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#RestCommand> ],
        [ a owl:Restriction ;
            owl:minCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ThermostatControlFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TimeRegulationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#SingleValuedFunctionality> a owl:Class ;
    rdfs:label "SingleValuedFunctionality"^^xsd:string ;
    rdfs:comment "Discrete functionalities with exactly one value"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TripleValuedFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#StandByOnOffState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StandByStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OffStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#UpDownRestState> .

<http://elite.polito.it/ontologies/dogont.owl#Stove> a owl:Class ;
    rdfs:label "Stove"^^xsd:string ;
    rdfs:comment "Heating apparatus"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatingApplianceState> ],
        <http://elite.polito.it/ontologies/dogont.owl#WhiteGoods> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#WashingMachine> .

<http://elite.polito.it/ontologies/dogont.owl#Wall> a owl:Class ;
    rdfs:label "Wall"^^xsd:string ;
    rdfs:comment "An architectural partition used to divide or enclose an area or to support another structure."^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Vertical> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#WallOpening> .

<http://elite.polito.it/ontologies/dogont.owl#actuatorOf> a owl:ObjectProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Actuator> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#Awning> <http://elite.polito.it/ontologies/dogont.owl#Door> <http://elite.polito.it/ontologies/dogont.owl#Gate> <http://elite.polito.it/ontologies/dogont.owl#Shutter> <http://elite.polito.it/ontologies/dogont.owl#Window> ) ] ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#hasActuator> .

<http://elite.polito.it/ontologies/dogont.owl#isIn> a owl:ObjectProperty ;
    rdfs:label "isIn"^^xsd:string ;
    rdfs:comment "Indicates in which building environment is contained an object, e.g. the lamp5 isIn Kitchen"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#Appliances> <http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment> <http://elite.polito.it/ontologies/dogont.owl#Furniture> <http://elite.polito.it/ontologies/dogont.owl#HousePlants> ) ] ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment> ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#contains> .

<http://elite.polito.it/ontologies/dogont.owl#port> a owl:DatatypeProperty ;
    rdfs:label "port"^^xsd:string ;
    rdfs:comment "The port of the gateway"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#BTicinoGateway> <http://elite.polito.it/ontologies/dogont.owl#EchelonIlon100Gateway> <http://elite.polito.it/ontologies/dogont.owl#KNXNetIPGateway> <http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> <http://elite.polito.it/ontologies/dogont.owl#ModbusGateway> ) ] ;
    rdfs:range xsd:int .

<http://elite.polito.it/ontologies/dogont.owl#BrownGoods> a owl:Class ;
    rdfs:label "BrownGoods"^^xsd:string ;
    rdfs:comment "Small household electrical entertainment appliances"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Appliances> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#WhiteGoods> .

<http://elite.polito.it/ontologies/dogont.owl#DeleteGroupCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "groupID^^Integer"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#commandParamName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        [ a owl:Restriction ;
            owl:hasValue "deleteGroup"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#VoidCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#DeleteSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetFlowRateMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetLuminanceCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#HeatCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseColorCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseContrastCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseLuminosityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseQualityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OpenCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanLeftCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanRightCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RestCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SelectSourceCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StepDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#UpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> .

<http://elite.polito.it/ontologies/dogont.owl#DiscreteControlFunctionality> a owl:Class ;
    rdfs:label "DiscreteFunctionality"^^xsd:string ;
    rdfs:comment "Functionalities not continuous, with fixed values"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#ControlFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Drawer> a owl:Class ;
    rdfs:label "Drawer"^^xsd:string ;
    rdfs:comment "A boxlike container in a piece of furniture; made so as to slide in and out"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Nightstand>,
        <http://elite.polito.it/ontologies/dogont.owl#SanitaryFixtures>,
        <http://elite.polito.it/ontologies/dogont.owl#Shade>,
        <http://elite.polito.it/ontologies/dogont.owl#Shutter>,
        <http://elite.polito.it/ontologies/dogont.owl#Sofa>,
        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#ElectricalSystem> a owl:Class ;
    rdfs:label "ElectricalSystem"^^xsd:string ;
    rdfs:comment "Utility that provides electricity"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#HousePlants> .

<http://elite.polito.it/ontologies/dogont.owl#Garage> a owl:Class ;
    rdfs:label "Garage"^^xsd:string ;
    rdfs:comment "The garage of the buinding"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFloor> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCeiling> ],
        <http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Garden>,
        <http://elite.polito.it/ontologies/dogont.owl#Room> .

<http://elite.polito.it/ontologies/dogont.owl#LevelState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PressureState>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeState>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureState>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerState> .

<http://elite.polito.it/ontologies/dogont.owl#Lighting> a owl:Class ;
    rdfs:label "Lighting"^^xsd:string ;
    rdfs:comment "System that provides artificial light"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#isIn> ],
        <http://elite.polito.it/ontologies/dogont.owl#ElectricalSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PowerDelivery>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> .

<http://elite.polito.it/ontologies/dogont.owl#MovementState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovingStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#NotMovingStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#OccupancyState>,
        <http://elite.polito.it/ontologies/dogont.owl#OnOffState>,
        <http://elite.polito.it/ontologies/dogont.owl#OpenCloseState>,
        <http://elite.polito.it/ontologies/dogont.owl#PresenceState>,
        <http://elite.polito.it/ontologies/dogont.owl#SensingState> .

<http://elite.polito.it/ontologies/dogont.owl#NonParametricLevelNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> ;
    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#LevelStepDownNotification> <http://elite.polito.it/ontologies/dogont.owl#LevelStepUpNotification> <http://elite.polito.it/ontologies/dogont.owl#SpeedStepDownNotification> <http://elite.polito.it/ontologies/dogont.owl#SpeedStepUpNotification> <http://elite.polito.it/ontologies/dogont.owl#TuningStepDownNotification> <http://elite.polito.it/ontologies/dogont.owl#TuningStepUpNotification> ) .

<http://elite.polito.it/ontologies/dogont.owl#Oven> a owl:Class ;
    rdfs:label "Oven"^^xsd:string ;
    rdfs:comment "Kitchen appliance used for baking or roasting"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StartStopPauseNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatingApplianceState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperHeatingFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StartStopPauseFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperHeatingNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#WhiteGoods> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Stove>,
        <http://elite.polito.it/ontologies/dogont.owl#WashingMachine> .

<http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#PressureStateValue> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ReactiveEnergyStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureStateValue> .

<http://elite.polito.it/ontologies/dogont.owl#Pump> a owl:Class ;
    rdfs:comment "The Pump device is a pump that may have variable speed. It may have optional built-in sensors and a regulation mechanism. It is typically used for pumping water. Derives from ZigBee HA specifications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FlowMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FlowRateState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FlowMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Actuator>,
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PumpController>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#ShutterActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowActuator> .

<http://elite.polito.it/ontologies/dogont.owl#PumpController> a owl:Class ;
    rdfs:comment "The Pump device controller can control a Pump device"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelControlNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FlowMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#IdentificationNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control>,
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#RemoteControl>,
        <http://elite.polito.it/ontologies/dogont.owl#SceneSelector>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeController>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleScenarioControl>,
        <http://elite.polito.it/ontologies/dogont.owl#Switch>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay>,
        <http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem> .

<http://elite.polito.it/ontologies/dogont.owl#ShutterActuator> a owl:Class ;
    rdfs:label "ShutterActuator"^^xsd:string ;
    rdfs:comment "A mechanism that allow automatic control about shutter"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#VerticalMovementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ShutterState> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Shutter> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#actuatorOf> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#VerticalNoMovementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#UpDownRestFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Actuator> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#WindowActuator> .

<http://elite.polito.it/ontologies/dogont.owl#SimpleMovementNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "startedMovement"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#MovementNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SimpleNoMovementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotification> .

<http://elite.polito.it/ontologies/dogont.owl#SingleScenarioControl> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Switch>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay> .

<http://elite.polito.it/ontologies/dogont.owl#SingleValuedNotificationFunctionality> a owl:Class ;
    rdfs:comment "Discrete notification with exactly one values"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#DiscreteNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#SmokeSensor> a owl:Class ;
    rdfs:label "SmokeSensor"^^xsd:string ;
    rdfs:comment "Sensor that detects the presence of smoke"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SensingState> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#FireSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> .

<http://elite.polito.it/ontologies/dogont.owl#StateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        owl:Thing .

<http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotificationFunctionality> a owl:Class ;
    rdfs:comment "Notifies the measurment of a temperature, through a proper temperature sensor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#WashingMachine> a owl:Class ;
    rdfs:label "WashingMachine"^^xsd:string ;
    rdfs:comment "A home appliance for washing clothes and linens automatically"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#WashingApplianceState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatingCycleNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#WashingCycleNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StartStopPauseFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StartStopPauseNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#WhiteGoods> .

<http://elite.polito.it/ontologies/dogont.owl#WindowActuator> a owl:Class ;
    rdfs:label "WindowActuator"^^xsd:string ;
    rdfs:comment "A mechanism that allow automatic opening and closing about window"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Window> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#actuatorOf> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseState> ],
        <http://elite.polito.it/ontologies/dogont.owl#Actuator> .

<http://elite.polito.it/ontologies/dogont.owl#DeleteSceneCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "deleteScene"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        [ a owl:Restriction ;
            owl:hasValue "sceneNumber^^Integer"^^xsd:string ;
