        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand> .

<http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> a owl:Class ;
    rdfs:comment "Derives from the general cluster functionalities defined in ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#JoinGroupNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LeaveGroupNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#IdentificationNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Table> a owl:Class ;
    rdfs:label "Table"^^xsd:string ;
    rdfs:comment "A piece of furniture having a smooth flat top that is usually supported by one or more vertical legs"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#returnType> ],
