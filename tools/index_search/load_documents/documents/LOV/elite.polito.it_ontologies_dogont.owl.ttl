        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#HeatCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseColorCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseContrastCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseLuminosityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseQualityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#NextTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OpenCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanLeftCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanRightCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PauseCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PlayCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PreviousTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RestCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RewindCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StandBy>,
        <http://elite.polito.it/ontologies/dogont.owl#StepDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopHeatingCoolingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopPlayingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#UpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> .

<http://elite.polito.it/ontologies/dogont.owl#EchelonIlon100Gateway> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#endpointAddress> ],
        <http://elite.polito.it/ontologies/dogont.owl#EchelonNetworkComponent> .

<http://elite.polito.it/ontologies/dogont.owl#FenceOpening> a owl:Class ;
    rdfs:label "FenceOpening"^^xsd:string ;
    rdfs:comment "An opening in a Fence"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Vertical> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Wall>,
        <http://elite.polito.it/ontologies/dogont.owl#WallOpening> .

<http://elite.polito.it/ontologies/dogont.owl#Floor> a owl:Class ;
    rdfs:label "Floor"^^xsd:string ;
    rdfs:comment "The inside lower horizontal surface of a room"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Horizontal> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Terrace> .

<http://elite.polito.it/ontologies/dogont.owl#FlowRateStateValue> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HumidityStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#LevelStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#ReactiveEnergyStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureStateValue> .

<http://elite.polito.it/ontologies/dogont.owl#Fridge> a owl:Class ;
    rdfs:label "Fridge"^^xsd:string ;
    rdfs:comment "A refrigerator in which the coolant is pumped around by an electric motor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThermostatControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperCoolingNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperCoolingFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#WhiteGoods> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Oven>,
        <http://elite.polito.it/ontologies/dogont.owl#Stove>,
        <http://elite.polito.it/ontologies/dogont.owl#WashingMachine> .

<http://elite.polito.it/ontologies/dogont.owl#Functionality> a owl:Class ;
    rdfs:label "Functionality"^^xsd:string ;
    rdfs:comment "Capability of a controllable building thing"^^xsd:string .

<http://elite.polito.it/ontologies/dogont.owl#Garden> a owl:Class ;
    rdfs:label "Garden"^^xsd:string ;
    rdfs:comment "The garden of the building"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Room> .

<http://elite.polito.it/ontologies/dogont.owl#GasSystem> a owl:Class ;
    rdfs:label "GasSystem"^^xsd:string ;
    rdfs:comment "System that detects the presence of gas"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#SecuritySystem> .

<http://elite.polito.it/ontologies/dogont.owl#GenericApplianceState> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#DiscreteState> .

<http://elite.polito.it/ontologies/dogont.owl#HeatingStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "heating"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#Horizontal> a owl:Class ;
    rdfs:label "Horizontal"^^xsd:string ;
    rdfs:comment "The horizontal architectural component of a building"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Architectural> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Vertical> .

<http://elite.polito.it/ontologies/dogont.owl#HueNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificNotification> .

<http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementMNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "changedRelativeHumidityAt"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:hasValue "sensorID^^String"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "relativeHumidity^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#JoinGroupNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#LeaveGroupNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#LevelControlNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementMNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementMNotification> .

<http://elite.polito.it/ontologies/dogont.owl#IdleStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "idle"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#LevelStepDownNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "stepDown"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricLevelNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#LevelStepUpNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#SimpleMovementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#SimpleNoMovementNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotification> .

<http://elite.polito.it/ontologies/dogont.owl#MovementNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> ;
    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#MovingDownNotification> <http://elite.polito.it/ontologies/dogont.owl#MovingUpNotification> <http://elite.polito.it/ontologies/dogont.owl#SimpleMovementNotification> ) .

<http://elite.polito.it/ontologies/dogont.owl#MovementSensor> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#AccessControlSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> .

<http://elite.polito.it/ontologies/dogont.owl#MovingStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "isMoving"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#OccupancySensor> a owl:Class ;
    rdfs:comment "The Occupancy Sensor device reports the occupancy state of an area. Derives from ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PresenceNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OccupancyState> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OccupancySensingFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PressureSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SmokeSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> .

<http://elite.polito.it/ontologies/dogont.owl#OffStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "off"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#OnStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "on"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#ParametricLevelNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#Phone> a owl:Class ;
    rdfs:label "Phone"^^xsd:string ;
    rdfs:comment "Appliance to comunicate with other person"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Communication> .

<http://elite.polito.it/ontologies/dogont.owl#PlayFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#NextTrackCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#RewindCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PauseCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PlayCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StopPlayingCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PreviousTrackCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ForwardCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SingleValuedFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#PlayState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ForwardStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PlayStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#RewindStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StopStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PauseStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SourceSelectionState>,
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedState> .

<http://elite.polito.it/ontologies/dogont.owl#ReactiveEnergyMeasurementFunctionality> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#EnergyMeasurementFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#ReactiveEnergyMeasurementNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#EnergyMeasurementNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#RemoteControl> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SceneSelector>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeController>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleScenarioControl>,
        <http://elite.polito.it/ontologies/dogont.owl#Switch>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay> .

<http://elite.polito.it/ontologies/dogont.owl#SecuritySystem> a owl:Class ;
    rdfs:label "SecuritySystem"^^xsd:string ;
    rdfs:comment "Security system for detecting dangerous situation and intrusion"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#HousePlants> .

<http://elite.polito.it/ontologies/dogont.owl#ShadeActuator> a owl:Class ;
    rdfs:label "Shade"@en ;
    rdfs:comment "The Shade Actuator device provides the ability to open or close window coverings, including setting partially open or partially closed states. This device type includes roller shades, drapes and tilt-only blinds actuators. Derives from ZigBee HA specifications (Shade device)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ShadeState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Shade> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#actuatorOf> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Actuator> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ShutterActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowActuator> .

<http://elite.polito.it/ontologies/dogont.owl#SinglePhaseEnergyMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseReactiveEnergyMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActiveEnergyMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseReactiveEnergyMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseReactiveEnergyState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActiveEnergyState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SinglePhaseActiveEnergyMeasurementFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#SingleTariffEnergyMeter> .

<http://elite.polito.it/ontologies/dogont.owl#SingleTemperatureSensor> a owl:Class ;
    rdfs:label "TemperatureSensor"^^xsd:string ;
    rdfs:comment "Sensor that detects the temperature of the atmosphere"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureState> ],
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureSensor> .

<http://elite.polito.it/ontologies/dogont.owl#SourceSelectionState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PhonoStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Tape2StateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CDStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#AuxStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TunerStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Tape1StateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TripleValuedState> .

<http://elite.polito.it/ontologies/dogont.owl#SpeedNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SpeedControlNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SpeedStepUpNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SpeedStepDownNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#LevelNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#StepFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StepDownCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#UpDownFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#TimedOnFunctionality> a owl:Class ;
    rdfs:label "TimedOnFunctionality"^^xsd:string ;
    rdfs:comment "Functionality to switch on an object for a given period of time"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#timeToOff> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#SingleValuedFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ToggleFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#TunerNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TuningStepDownNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TuningStepUpNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ChannelControlNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#LevelNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#UnControllable> a owl:Class ;
    rdfs:label "UnControllable"^^xsd:string ;
    rdfs:comment "All building things that can't be controlled by domotic system"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf <http://elite.polito.it/ontologies/dogont.owl#Controllable> ],
        <http://elite.polito.it/ontologies/dogont.owl#BuildingThing> .

<http://elite.polito.it/ontologies/dogont.owl#UpDownFunctionality> a owl:Class ;
    rdfs:label "UpDownFunctionality"^^xsd:string ;
    rdfs:comment "Functionality: up - down"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#UpCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DownCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#WaterCloset> a owl:Class ;
    rdfs:label "WaterCloset"^^xsd:string ;
    rdfs:comment "A plumbing fixture for defecation and urination"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#SanitaryFixtures> .

<http://elite.polito.it/ontologies/dogont.owl#ZWaveComponent> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkComponent> .

<http://elite.polito.it/ontologies/dogont.owl#ZigBeeComponent> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkComponent> .

<http://elite.polito.it/ontologies/dogont.owl#connectionTimeOut> a owl:DatatypeProperty ;
    rdfs:label "connectionTimeOut"^^xsd:string ;
    rdfs:comment "The time before the connection expires"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#BTicinoGateway> <http://elite.polito.it/ontologies/dogont.owl#KNXNetIPGateway> <http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> ) ] ;
    rdfs:range xsd:int .

<http://elite.polito.it/ontologies/dogont.owl#connectionTrials> a owl:DatatypeProperty ;
    rdfs:label "connectionTrials"^^xsd:string ;
    rdfs:comment "Number of connection trials before failure"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#BTicinoGateway> <http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> ) ] ;
    rdfs:range xsd:int .

<http://elite.polito.it/ontologies/dogont.owl#individualAddress> a owl:DatatypeProperty ;
    rdfs:label "individualAddress"^^xsd:string ;
    rdfs:comment "The individual address of the component"^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#KonnexComponent> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://elite.polito.it/ontologies/dogont.owl#KonnexProperty> .

<http://elite.polito.it/ontologies/dogont.owl#probeID> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#MultipleFlowRateStateValue> <http://elite.polito.it/ontologies/dogont.owl#MultiplePressureStateValue> <http://elite.polito.it/ontologies/dogont.owl#MultipleTemperatureStateValue> ) ] ;
    rdfs:range xsd:string .

<http://elite.polito.it/ontologies/dogont.owl#sensorOf> a owl:ObjectProperty ;
    rdfs:label "isSensorOf"^^xsd:string ;
    rdfs:comment "Association between a sensor and its sensed object"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#DoorSensor> <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#FenceOpening> <http://elite.polito.it/ontologies/dogont.owl#WallOpening> ) ] ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#hasSensor> .

owl:topObjectProperty a owl:ObjectProperty .

<http://elite.polito.it/ontologies/dogont.owl#Cupboard> a owl:Class ;
    rdfs:label "Cupboard"^^xsd:string ;
    rdfs:comment "A small room (or recess) or cabinet used for storage space"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Desk>,
        <http://elite.polito.it/ontologies/dogont.owl#Drawer>,
        <http://elite.polito.it/ontologies/dogont.owl#Nightstand>,
        <http://elite.polito.it/ontologies/dogont.owl#SanitaryFixtures>,
        <http://elite.polito.it/ontologies/dogont.owl#Shade>,
        <http://elite.polito.it/ontologies/dogont.owl#Shutter>,
        <http://elite.polito.it/ontologies/dogont.owl#Sofa>,
        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#CurrentStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#phaseID> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#FlowRateStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#HumidityStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#LevelStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#ReactiveEnergyStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureStateValue> .

<http://elite.polito.it/ontologies/dogont.owl#DecreaseLuminosityCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "decreaseLuminosity"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#VoidCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#DecreaseQualityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DeleteGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DeleteSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ForwardCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetFlowRateCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetOccupancyCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#HeatCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseColorCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseContrastCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseLuminosityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseQualityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#NextTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OpenCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanLeftCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanRightCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PauseCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PlayCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PreviousTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RestCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RewindCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StandBy>,
