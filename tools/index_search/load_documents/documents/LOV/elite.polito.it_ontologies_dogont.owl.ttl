            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StepFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#ShutterActuator> .

<http://elite.polito.it/ontologies/dogont.owl#TemperatureAndHumiditySensor> a owl:Class ;
