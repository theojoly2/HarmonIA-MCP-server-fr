<http://elite.polito.it/ontologies/dogont.owl#DeepFreezer> a owl:Class ;
    rdfs:label "DeepFreezer"^^xsd:string ;
    rdfs:comment "Electric refrigerator in which food is frozen and stored for long periods of time"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperFreezingFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FreezingApplianceState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperFreezingNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#WhiteGoods> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Dishwasher>,
        <http://elite.polito.it/ontologies/dogont.owl#Fridge>,
        <http://elite.polito.it/ontologies/dogont.owl#Oven>,
        <http://elite.polito.it/ontologies/dogont.owl#Stove>,
        <http://elite.polito.it/ontologies/dogont.owl#WashingMachine> .

<http://elite.polito.it/ontologies/dogont.owl#DeleteSceneNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        [ a owl:Restriction ;
            owl:hasValue "sceneNumber^^Integer"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "deletedScene"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#FlowRateMeasurementMNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementMNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#JoinGroupNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#LeaveGroupNotification>,
