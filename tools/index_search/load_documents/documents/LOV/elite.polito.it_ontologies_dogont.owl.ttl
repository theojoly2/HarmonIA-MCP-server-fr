            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        <http://elite.polito.it/ontologies/dogont.owl#Entertainment> .

<http://elite.polito.it/ontologies/dogont.owl#UpTripleStateValue> a owl:Class ;
