<http://elite.polito.it/ontologies/dogont.owl#LevelControlNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "changedLevel"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        [ a owl:Restriction ;
            owl:hasValue "newLevel^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricLevelNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementMNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementMNotification> .

<http://elite.polito.it/ontologies/dogont.owl#Nightstand> a owl:Class ;
    rdfs:label "Nightstand"^^xsd:string ;
    rdfs:comment "A small table or stand placed at a bedside."@en ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SanitaryFixtures>,
        <http://elite.polito.it/ontologies/dogont.owl#Shade>,
        <http://elite.polito.it/ontologies/dogont.owl#Shutter>,
        <http://elite.polito.it/ontologies/dogont.owl#Sofa>,
        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#OpenCloseNotificationFunctionality> a owl:Class ;
    rdfs:label "OpenCloseNotification"^^xsd:string ;
    rdfs:comment "Notification: open - close"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CloseNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PresenceNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#UpDownNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementMNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "changedPressureAt"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:hasValue "pressureValue^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "sensorID^^String"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#StoreSceneNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementMNotification> .

<http://elite.polito.it/ontologies/dogont.owl#PressureSensor> a owl:Class ;
    rdfs:comment "The Pressure Sensor device measures and periodically reports the pressure of a liquid (typically water)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Pump>,
        <http://elite.polito.it/ontologies/dogont.owl#PumpController>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SmokeSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> .

<http://elite.polito.it/ontologies/dogont.owl#SimpleNoMovementNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "ceasedMovement"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NoMovementNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotification> .

<http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "newTemperatureValue"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:hasValue "temperatureValue^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#TemperatureState> a owl:Class ;
    rdfs:label "TemperatureState"^^xsd:string ;
    rdfs:comment "Models the temperature value"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TemperatureStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TunerState> .

<http://elite.polito.it/ontologies/dogont.owl#TimeRegulationFunctionality> a owl:Class ;
    rdfs:label "TimeRegulationFunctionality"^^xsd:string ;
    rdfs:comment "Functionalities for the regulation of timer"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TunerFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Command> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
