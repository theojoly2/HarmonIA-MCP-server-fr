<http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> a owl:Class ;
    rdfs:label "OnOffFunctionality"^^xsd:string ;
    rdfs:comment "Functionality: turn on - turn off"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OffCommand> ],
