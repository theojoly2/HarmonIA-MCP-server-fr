<http://elite.polito.it/ontologies/dogont.owl#Control> a owl:Class ;
    rdfs:label "Control"^^xsd:string ;
    rdfs:comment "A mechanism that controls the interaction with the electrical system"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#controlledObject> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#NotificationFunctionality> ],
        [ a owl:Restriction ;
