    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#WaterCloset> .

<http://elite.polito.it/ontologies/dogont.owl#ZWaveNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificNotification> .

<http://elite.polito.it/ontologies/dogont.owl#ZWaveProperty> a owl:DatatypeProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#ZWaveComponent> ;
    rdfs:range xsd:int .

<http://elite.polito.it/ontologies/dogont.owl#hasFloor> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#Garage> <http://elite.polito.it/ontologies/dogont.owl#Room> ) ] ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#Floor> .

<http://elite.polito.it/ontologies/dogont.owl#hasSensor> a owl:ObjectProperty ;
    rdfs:label "hasSensor"^^xsd:string ;
    rdfs:comment "Association between an object and its sensor"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#FenceOpening> <http://elite.polito.it/ontologies/dogont.owl#WallOpening> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#DoorSensor> <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> ) ] .

<http://elite.polito.it/ontologies/dogont.owl#sleepTime> a owl:DatatypeProperty ;
    rdfs:label "sleepTime"^^xsd:string ;
    rdfs:comment "The time between connection trials"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#BTicinoGateway> <http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> ) ] ;
    rdfs:range xsd:int .

<http://elite.polito.it/ontologies/dogont.owl#tariffID> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#MultiTariffActiveEnergyStateValue> <http://elite.polito.it/ontologies/dogont.owl#MultiTariffReactiveEnergyStateValue> <http://elite.polito.it/ontologies/dogont.owl#MultiTariffSinglePhaseActiveEnergyMeasurementNotification> <http://elite.polito.it/ontologies/dogont.owl#MultiTariffSinglePhaseReactiveEnergyMeasurementNotification> <http://elite.polito.it/ontologies/dogont.owl#MultiTariffThreePhaseActiveEnergyMeasurementNotification> <http://elite.polito.it/ontologies/dogont.owl#MultiTariffThreePhaseReactiveEnergyMeasurementNotification> ) ] ;
    rdfs:range xsd:string .

owl:Thing a owl:Class .

<http://elite.polito.it/ontologies/dogont.owl#Acoustic> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#isIn> ],
