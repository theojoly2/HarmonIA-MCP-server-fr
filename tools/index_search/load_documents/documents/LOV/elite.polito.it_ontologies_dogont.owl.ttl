<http://elite.polito.it/ontologies/dogont.owl#flashingTime> a owl:DatatypeProperty ;
    rdfs:label "flashingTime"^^xsd:string ;
    rdfs:comment "The flashing period duration in seconds"^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#OnOffFlashingFunctionality> ;
    rdfs:range xsd:float .

<http://elite.polito.it/ontologies/dogont.owl#groupAddress> a owl:DatatypeProperty ;
    rdfs:label "groupAddress"^^xsd:string ;
    rdfs:comment "The address of the group of the component"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#KNXNetIPComponent> <http://elite.polito.it/ontologies/dogont.owl#KonnexCommand> <http://elite.polito.it/ontologies/dogont.owl#KonnexComponent> <http://elite.polito.it/ontologies/dogont.owl#KonnexNotification> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://elite.polito.it/ontologies/dogont.owl#KonnexProperty> .

<http://elite.polito.it/ontologies/dogont.owl#hasCeiling> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#Garage> <http://elite.polito.it/ontologies/dogont.owl#Room> ) ] ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#Ceiling> ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#ceilingOf> .

<http://elite.polito.it/ontologies/dogont.owl#hexValue> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#KonnexCommand> <http://elite.polito.it/ontologies/dogont.owl#KonnexNotification> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://elite.polito.it/ontologies/dogont.owl#KonnexProperty> .

<http://elite.polito.it/ontologies/dogont.owl#isInWall> a owl:ObjectProperty ;
    rdfs:label "isInWall"^^xsd:string ;
    rdfs:comment "Association between a wallopening(door or window) and the wall opening where it is"^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#WallOpening> ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#Wall> .

<http://elite.polito.it/ontologies/dogont.owl#multicastIP> a owl:DatatypeProperty ;
    rdfs:label "multicastIP"^^xsd:string ;
    rdfs:comment "The multicast address of the gateway"^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://elite.polito.it/ontologies/dogont.owl#KonnexProperty> .

<http://elite.polito.it/ontologies/dogont.owl#physicalType> a owl:DatatypeProperty ;
    rdfs:label "physicalType"^^xsd:string ;
    rdfs:comment "The category of the component"^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#BTicinoComponent> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://elite.polito.it/ontologies/dogont.owl#BTicinoProperty> .

<http://elite.polito.it/ontologies/dogont.owl#pollingInterval> a owl:DatatypeProperty ;
    rdfs:label "pollingInterval"^^xsd:string ;
    rdfs:comment "The interval between subsequent polls"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#EchelonIlon100Gateway> <http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> <http://elite.polito.it/ontologies/dogont.owl#ModbusGateway> <http://elite.polito.it/ontologies/dogont.owl#ZWaveGateway> <http://elite.polito.it/ontologies/dogont.owl#ZigBeeGateway> ) ] ;
    rdfs:range xsd:int .

<http://elite.polito.it/ontologies/dogont.owl#timeToOff> a owl:DatatypeProperty ;
    rdfs:label "timeToOff"^^xsd:string ;
    rdfs:comment "The time in seconds during which the object is turned on"^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#TimedOnFunctionality> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "0.5"^^xsd:float ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "120.0"^^xsd:float ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "180.0"^^xsd:float ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "240.0"^^xsd:float ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "30.0"^^xsd:float ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "300.0"^^xsd:float ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first "60.0"^^xsd:float ;
                                                                    rdf:rest [ a rdf:List ;
                                                                            rdf:first "900.0"^^xsd:float ;
                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] .

<http://elite.polito.it/ontologies/dogont.owl#unitOfMeasure> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ) ] ;
    rdfs:range <http://purl.oclc.org/NET/muo/muo#UnitOfMeasurement> ;
    owl:propertyDisjointWith <http://purl.oclc.org/NET/muo/muo#measuredIn> .

<http://elite.polito.it/ontologies/dogont.owl#weekDay> a owl:DatatypeProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#ClimateScheduleStateValue> ;
    rdfs:range xsd:string .

<http://elite.polito.it/ontologies/dogont.owl#AccessControlSystem> a owl:Class ;
    rdfs:label "AccessControlSystem"^^xsd:string ;
    rdfs:comment "System that provides security about access"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#SecuritySystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#FireSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#FloodSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#GasSystem> .

<http://elite.polito.it/ontologies/dogont.owl#ActivePowerStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#phaseID> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> .

<http://elite.polito.it/ontologies/dogont.owl#ApplianceCycleTimingNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#EndTimeChangedNotification> <http://elite.polito.it/ontologies/dogont.owl#RemainingTimeChangedNotification> <http://elite.polito.it/ontologies/dogont.owl#StartTimeChangedNotification> ) .

<http://elite.polito.it/ontologies/dogont.owl#BTicinoProperty> a owl:DatatypeProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#BTicinoComponent> ;
    rdfs:range xsd:string .

<http://elite.polito.it/ontologies/dogont.owl#CameraPictureZoomPanControlFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PanDownCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PanUpCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PanRightCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PanLeftCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ColorControlFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#FanControlFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#LevelControlFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#ShutterRegulationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#ThermostatControlFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TimeRegulationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Ceiling> a owl:Class ;
    rdfs:label "Ceiling"^^xsd:string ;
    rdfs:comment "The overhead upper surface of a room"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Horizontal> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Floor>,
        <http://elite.polito.it/ontologies/dogont.owl#Terrace> .

<http://elite.polito.it/ontologies/dogont.owl#Chair> a owl:Class ;
    rdfs:label "Chair"^^xsd:string ;
    rdfs:comment "A seat for one person, with a support for the back."^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Closet>,
        <http://elite.polito.it/ontologies/dogont.owl#Cupboard>,
        <http://elite.polito.it/ontologies/dogont.owl#Desk>,
        <http://elite.polito.it/ontologies/dogont.owl#Drawer>,
        <http://elite.polito.it/ontologies/dogont.owl#Nightstand>,
        <http://elite.polito.it/ontologies/dogont.owl#SanitaryFixtures>,
        <http://elite.polito.it/ontologies/dogont.owl#Shade>,
        <http://elite.polito.it/ontologies/dogont.owl#Shutter>,
        <http://elite.polito.it/ontologies/dogont.owl#Sofa>,
        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#CloseStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "close"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#ColorState> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> .

<http://elite.polito.it/ontologies/dogont.owl#Computer> a owl:Class ;
    rdfs:label "Computer"^^xsd:string ;
    rdfs:comment "A machine for performing calculations automatically, work and play"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#BrownGoods> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Entertainment>,
        <http://elite.polito.it/ontologies/dogont.owl#Fan>,
        <http://elite.polito.it/ontologies/dogont.owl#Printer> .

<http://elite.polito.it/ontologies/dogont.owl#CoolNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "cool"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#CoolingStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "cooling"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#DecreaseColorCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "decreaseColor"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#VoidCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#DecreaseContrastCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DecreaseLuminosityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DecreaseQualityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DeleteGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DeleteSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#DownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ForwardCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetFlowRateCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetOccupancyCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#HeatCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseColorCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseContrastCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseLuminosityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseQualityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#NextTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OpenCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanLeftCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanRightCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PauseCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PlayCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PreviousTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RestCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RewindCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StandBy>,
        <http://elite.polito.it/ontologies/dogont.owl#StepDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopHeatingCoolingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopPlayingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#UpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> .

<http://elite.polito.it/ontologies/dogont.owl#Dishwasher> a owl:Class ;
    rdfs:label "Dishwasher"^^xsd:string ;
    rdfs:comment "A machine for washing dishes"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StartStopPauseNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StartStopPauseFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#WhiteGoods> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Fridge>,
        <http://elite.polito.it/ontologies/dogont.owl#Oven>,
        <http://elite.polito.it/ontologies/dogont.owl#Stove>,
        <http://elite.polito.it/ontologies/dogont.owl#WashingMachine> .

<http://elite.polito.it/ontologies/dogont.owl#DoorActuator> a owl:Class ;
    rdfs:label "DoorActuator"^^xsd:string ;
    rdfs:comment "A mechanism that allow automatic opening and closing about door"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Door> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#actuatorOf> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Actuator> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GateActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#Pump>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#ShutterActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowActuator> .

<http://elite.polito.it/ontologies/dogont.owl#DoorSensor> a owl:Class ;
    rdfs:label "DoorSensor"^^xsd:string ;
    rdfs:comment "Sensor that controls if a door is closed"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Door> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#sensorOf> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseState> ],
        [ a owl:Restriction ;
            owl:cardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#sensorOf> ],
        <http://elite.polito.it/ontologies/dogont.owl#AntiIntrusionSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#FloodSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#GasSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#InfraredSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#OccupancySensor>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SmokeSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SurveillanceCamera>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> .

<http://elite.polito.it/ontologies/dogont.owl#DownTripleStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "down"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#EchelonCommand> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificCommand> .

<http://elite.polito.it/ontologies/dogont.owl#EchelonIlon100Property> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#EchelonCommand> <http://elite.polito.it/ontologies/dogont.owl#EchelonNetworkComponent> <http://elite.polito.it/ontologies/dogont.owl#EchelonNotification> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://elite.polito.it/ontologies/dogont.owl#EchelonProperty> .

<http://elite.polito.it/ontologies/dogont.owl#EchelonNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificNotification> .

<http://elite.polito.it/ontologies/dogont.owl#ElectricPowerMeasurementNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#ElectricPowerMeasurementState> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> .

<http://elite.polito.it/ontologies/dogont.owl#Flat> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#contains> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#contains> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Room> ],
        <http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Garage>,
        <http://elite.polito.it/ontologies/dogont.owl#Garden>,
        <http://elite.polito.it/ontologies/dogont.owl#Room> .

<http://elite.polito.it/ontologies/dogont.owl#FloodSystem> a owl:Class ;
    rdfs:label "FloodSystem"^^xsd:string ;
    rdfs:comment "System that detects the presence of flood"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#SecuritySystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GasSystem> .

<http://elite.polito.it/ontologies/dogont.owl#FlowMeasurementNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FlowRateMeasurementNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#FlowRateMeasurementMNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "flowRateValue^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "sensorID^^String"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "changedFlowRateAt"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementMNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#JoinGroupNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#LeaveGroupNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#LevelControlNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementMNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementMNotification> .

<http://elite.polito.it/ontologies/dogont.owl#Gate> a owl:Class ;
    rdfs:label "Gate"^^xsd:string ;
    rdfs:comment "A door-like movable barrier in a fence"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GateActuator> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        [ a owl:Restriction ;
            owl:maxCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasActuator> ],
        <http://elite.polito.it/ontologies/dogont.owl#FenceOpening> .

<http://elite.polito.it/ontologies/dogont.owl#GateActuator> a owl:Class ;
    rdfs:label "GateActuator"^^xsd:string ;
    rdfs:comment "A mechanism that allow automatic opening and closing about gate"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementState> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Gate> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#actuatorOf> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Actuator> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Pump>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#ShutterActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowActuator> .

<http://elite.polito.it/ontologies/dogont.owl#HeatNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "heat"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#Heater> a owl:Class ;
    rdfs:label "Heater"^^xsd:string ;
    rdfs:comment "Device that heats water or supplies warmth"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#HeatingSystem> .

<http://elite.polito.it/ontologies/dogont.owl#HeatingApplianceState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SuperHeatingStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#GenericApplianceState> .

<http://elite.polito.it/ontologies/dogont.owl#HeatingSystem> a owl:Class ;
    rdfs:label "HeatingSystem"^^xsd:string ;
    rdfs:comment "Utility to warm a building"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#HVACSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PressureSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#Pump>,
        <http://elite.polito.it/ontologies/dogont.owl#PumpController>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem> .

<http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementNotificationFunctionality> a owl:Class ;
    rdfs:comment "The notification for requesting humidity measurment..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#SimpleLevelNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementNotificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HumidityStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#LevelState>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureState>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeState>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureState>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerState> .

<http://elite.polito.it/ontologies/dogont.owl#IdentificationNotificationFunctionality> a owl:Class ;
    rdfs:comment "Derives from the general cluster functionalities defined in ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#IdentifyNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#InfraredSensor> a owl:Class ;
    rdfs:label "InfraredSensor"^^xsd:string ;
    rdfs:comment "Sensor that detects the presence of a living entity in the sensor's range"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SensingState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SensingNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#AntiIntrusionSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#OccupancySensor>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SmokeSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SurveillanceCamera>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> .

<http://elite.polito.it/ontologies/dogont.owl#KNXNetIPComponent> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#individualAddress> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkComponent> .

<http://elite.polito.it/ontologies/dogont.owl#KNXNetIPGateway> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#connectionTimeOut> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#port> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#IPAddress> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#connectionTrials> ],
        <http://elite.polito.it/ontologies/dogont.owl#KNXNetIPComponent> .

<http://elite.polito.it/ontologies/dogont.owl#KonnexCommand> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificCommand> .

<http://elite.polito.it/ontologies/dogont.owl#KonnexNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificNotification> .

<http://elite.polito.it/ontologies/dogont.owl#LevelControlNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelStepUpNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelControlNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#LevelStepDownNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#LevelNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#LightIntensityState> a owl:Class ;
    rdfs:label "LightIntensityState"^^xsd:string ;
    rdfs:comment "Models the state of the object that illuminates"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#LevelState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#VolumeLevelState> .

<http://elite.polito.it/ontologies/dogont.owl#LightSensingFunctionality> a owl:Class ;
    rdfs:comment "The capability of sensing the luminance of the environment in which a device is located accepts only the get command, with 1 parameter, i.e. the luminance value. Derives from ZigBee specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GetLuminanceCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#OccupancySensingFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PictureGrabFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PressureMeasurementFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#ModbusGateway> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#IPAddress> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#port> ],
        <http://elite.polito.it/ontologies/dogont.owl#ModbusComponent> .

<http://elite.polito.it/ontologies/dogont.owl#MultiTariffActiveEnergyStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#tariffID> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#phaseID> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> .

<http://elite.polito.it/ontologies/dogont.owl#MultiTariffReactiveEnergyStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#tariffID> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#phaseID> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> .

<http://elite.polito.it/ontologies/dogont.owl#NetworkSpecificCommand> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Command> .

<http://elite.polito.it/ontologies/dogont.owl#OffNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "off"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#OnNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "on"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#OnOffOutput> a owl:Class ;
    rdfs:comment "Models a binary output which can be only in on or off state (OnOffState), compatible with the ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GroupNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#PowerDelivery> .

<http://elite.polito.it/ontologies/dogont.owl#OpenStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "open"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#PauseStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "pause"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> .

<http://elite.polito.it/ontologies/dogont.owl#PlayNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ForwardNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#RewindNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TrackControlNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PlayNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StopPlaybackNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PausePlaybackNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#LevelNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#PowerFactorMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PowerFactorMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PowerFactorMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PowerFactorMeasurementState> ],
        <http://elite.polito.it/ontologies/dogont.owl#ElectricityMeter> .

<http://elite.polito.it/ontologies/dogont.owl#PowerMeasurementFunctionality> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#PowerMeter> a owl:Class ;
