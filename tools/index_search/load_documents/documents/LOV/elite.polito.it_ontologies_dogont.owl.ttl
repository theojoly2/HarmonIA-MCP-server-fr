            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SpeedNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FanControlFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem> .

<http://elite.polito.it/ontologies/dogont.owl#WaterMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#WaterMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#WaterMeasurementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#WaterMeasurementFuctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Meter> .

<http://elite.polito.it/ontologies/dogont.owl#WirelessPhone> a owl:Class ;
    rdfs:label "WirelessPhone"^^xsd:string ;
    rdfs:comment "Phone with no wire"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Phone> .

<http://elite.polito.it/ontologies/dogont.owl#commandOf> a owl:ObjectProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Command> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#ControlFunctionality> <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ) ] ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#hasCommand> .

<http://elite.polito.it/ontologies/dogont.owl#eZ430Chronos> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ButtonMNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#TridimensionalAccelerationNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DisplayFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SoundFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Clock> .

<http://elite.polito.it/ontologies/dogont.owl#floorOf> a owl:ObjectProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Floor> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#Garage> <http://elite.polito.it/ontologies/dogont.owl#Room> ) ] ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#hasFloor> .

<http://elite.polito.it/ontologies/dogont.owl#generateCommand> a owl:ObjectProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Notification> ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#Command> .

<http://elite.polito.it/ontologies/dogont.owl#hasControl> a owl:ObjectProperty ;
    rdfs:label "hasControl"^^xsd:string ;
    rdfs:comment "Association between an object and its controller,e.g.switch,button,knob"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#Acoustic> <http://elite.polito.it/ontologies/dogont.owl#Actuator> <http://elite.polito.it/ontologies/dogont.owl#Control> <http://elite.polito.it/ontologies/dogont.owl#Lighting> <http://elite.polito.it/ontologies/dogont.owl#PowerDelivery> ) ] ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#Control> ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#controlledObject> .

<http://elite.polito.it/ontologies/dogont.owl#hasGateway> a owl:ObjectProperty ;
    rdfs:comment "Relates a given domotic component with the network level gateway used to control it"@en ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Controllable> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#BTicinoGateway> <http://elite.polito.it/ontologies/dogont.owl#EliteGateway> <http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> ) ] .

<http://elite.polito.it/ontologies/dogont.owl#hasMeter> a owl:ObjectProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Controllable> ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#Meter> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#meterOf> .

<http://elite.polito.it/ontologies/dogont.owl#hasWall> a owl:ObjectProperty ;
    rdfs:label "hasWall"^^xsd:string ;
    rdfs:comment "Association between a room and its walls"^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Room> ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#Wall> .

<http://elite.polito.it/ontologies/dogont.owl#hasWallOpening> a owl:ObjectProperty ;
    rdfs:label "hasWallOpening"^^xsd:string ;
    rdfs:comment "Association between a wall and its opening like door,window"^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Wall> ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#WallOpening> ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#isInWall> .

<http://elite.polito.it/ontologies/dogont.owl#instanceId> a owl:DatatypeProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#ZWaveComponent> ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf <http://elite.polito.it/ontologies/dogont.owl#ZWaveProperty> ;
    owl:propertyDisjointWith <http://elite.polito.it/ontologies/dogont.owl#nodeId> .

<http://elite.polito.it/ontologies/dogont.owl#notificationOf> a owl:ObjectProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#Notification> ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#NotificationFunctionality> ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#hasNotification> .

<http://elite.polito.it/ontologies/dogont.owl#plugOf> a owl:ObjectProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#PowerDelivery> ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#Appliances> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#pluggedIn> .

<http://elite.polito.it/ontologies/dogont.owl#statevalueOf> a owl:ObjectProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#StateValue> ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#State> ;
    owl:inverseOf <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> .

dcterms:contributor a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

owl:topDataProperty a owl:DatatypeProperty .

owl:versionInfo a owl:AnnotationProperty .

foaf:primaryTopic a owl:AnnotationProperty .

<http://elite.polito.it/ontologies/dogont.owl#AlertNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "newAlert"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:hasValue "alert^^Object"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#AlertNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#AlertNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#SingleValuedNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#ApplianceManagementFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DeleteApplianceCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#InstallApplianceCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#AssociateCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "associate"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#VoidCommand> .

<http://elite.polito.it/ontologies/dogont.owl#AssociateFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#AssociateCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DisassociateCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#AssociatingDeviceNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "associating"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ZWaveNotification> .

<http://elite.polito.it/ontologies/dogont.owl#AssociationNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DisassociatingDeviceNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#AssociatingDeviceNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#IdleNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#AwningActuator> a owl:Class ;
    rdfs:label "AwningActuator"^^xsd:string ;
    rdfs:comment "A mechanism that allow automatic control about awning"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MovementState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseFunctionality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Awning> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#actuatorOf> ],
        <http://elite.polito.it/ontologies/dogont.owl#Actuator> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#DoorActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#GateActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#Pump>,
        <http://elite.polito.it/ontologies/dogont.owl#ShadeActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#ShutterActuator>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowActuator> .

<http://elite.polito.it/ontologies/dogont.owl#Bathroom> a owl:Class ;
    rdfs:label "Bathroom"^^xsd:string ;
    rdfs:comment "A room containing a bath or shower and usually a washbasin and toilet"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Room> .

<http://elite.polito.it/ontologies/dogont.owl#Bathtub> a owl:Class ;
    rdfs:label "Bathtub"^^xsd:string ;
    rdfs:comment "A relatively large open container that you fill with water and use to wash the body"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#SanitaryFixtures> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Bidet>,
        <http://elite.polito.it/ontologies/dogont.owl#Shower>,
        <http://elite.polito.it/ontologies/dogont.owl#Washbasin>,
        <http://elite.polito.it/ontologies/dogont.owl#WaterCloset> .

<http://elite.polito.it/ontologies/dogont.owl#BatteryLevelNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "batteryLevel^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "changedBatteryLevel"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
