        <http://elite.polito.it/ontologies/dogont.owl#PanDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanLeftCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanRightCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PauseCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PlayCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PreviousTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RestCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RewindCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StandBy>,
        <http://elite.polito.it/ontologies/dogont.owl#StepDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopHeatingCoolingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopPlayingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#UpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> .

<http://elite.polito.it/ontologies/dogont.owl#GetPressureMCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "sensorURI^^String"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#commandParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#returnType> ],
        [ a owl:Restriction ;
            owl:hasValue "getPressureFrom"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonVoidCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ParametricCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SelectSourceCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand> .

<http://elite.polito.it/ontologies/dogont.owl#OpenCloseState> a owl:Class ;
    rdfs:label "OpenCloseState"^^xsd:string ;
    rdfs:comment "State: open - close"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CloseStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PresenceState>,
        <http://elite.polito.it/ontologies/dogont.owl#SensingState> .

<http://elite.polito.it/ontologies/dogont.owl#SelectSourceCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "source^^String"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#commandParamName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        [ a owl:Restriction ;
            owl:hasValue "source"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand> .

<http://elite.polito.it/ontologies/dogont.owl#SensingState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#NotDetectedStateValue> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DetectedStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DoubleValuedState> .

<http://elite.polito.it/ontologies/dogont.owl#ShadeStateValue> a owl:Class ;
    rdfs:comment "Value for the Shade position state, the shade position can be expressed as position=closedLimitx(255-level)/255, where with level 0 the shade is closed and with level 255 the shade is completely open. Derives from ZigBee HA specifications."@en ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TemperatureStateValue> .

<http://elite.polito.it/ontologies/dogont.owl#StoreSceneNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "storedScene"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        [ a owl:Restriction ;
            owl:hasValue "sceneNumber^^Integer"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkNotification>,
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementMNotification> .

<http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementFunctionality> a owl:Class ;
    rdfs:comment "The capability of measuring temperatures"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#TripleValuedFunctionality> a owl:Class ;
    rdfs:label "TripleValuedFunctionality"^^xsd:string ;
    rdfs:comment "Discrete functionalities with exactly three values"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteControlFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#TripleValuedState> a owl:Class ;
    rdfs:label "TripleValuedState"^^xsd:string ;
    rdfs:comment "Discrete states with exactly three values"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteState> .

<http://elite.polito.it/ontologies/dogont.owl#TunerState> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ChannelStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> .

<http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#HVACSystem> .

<http://elite.polito.it/ontologies/dogont.owl#WhiteGoods> a owl:Class ;
    rdfs:label "WhiteGoods"^^xsd:string ;
    rdfs:comment "Major household appliances.\\n\\nIt mus be noticed that the functionality modeling uses existential quantifiers for functionalities that can be optional, this is only for the sake of easier interpretation and should be improved in future releases"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultipleAlertNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffStandByFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#AlertNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffStandbyNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FaultState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#EventsAndAlertsQueryFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#RunState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CycleTimingControlFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#EventNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ConnectionState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StandByOnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ProgramState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CycleTimingQueryFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#MultipleEventNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CycleTimingNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Appliances> .

<http://elite.polito.it/ontologies/dogont.owl#Controllable> a owl:Class ;
    rdfs:label "Controllable"^^xsd:string ;
    rdfs:comment "All building things that can be controlled by domotic system"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ],
        [ a owl:Class ;
            owl:complementOf <http://elite.polito.it/ontologies/dogont.owl#UnControllable> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#QueryFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#BuildingThing> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#UnControllable> ;
    owl:equivalentClass <http://purl.oclc.org/NET/ssnx/ssn#Device> .

<http://elite.polito.it/ontologies/dogont.owl#DoubleValuedFunctionality> a owl:Class ;
    rdfs:label "DoubleValuedFunctionality"^^xsd:string ;
    rdfs:comment "Discrete functionalities with exactly two values"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#NetworkFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#PlayFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleValuedFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#DoubleValuedState> a owl:Class ;
    rdfs:label "DoubleValuedState"^^xsd:string ;
    rdfs:comment "Discrete states with exactly two values"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#DiscreteState> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#HeatingAndCoolingUnitState>,
        <http://elite.polito.it/ontologies/dogont.owl#PlayState>,
        <http://elite.polito.it/ontologies/dogont.owl#SourceSelectionState>,
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedState> .

<http://elite.polito.it/ontologies/dogont.owl#GetFlowRateCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "getFlowRate"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        [ a owl:Restriction ;
            owl:hasValue "Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#returnType> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#NonVoidCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GetFlowRateMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetLuminanceCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetOccupancyCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#HeatCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseColorCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseContrastCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseLuminosityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseQualityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#NextTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OpenCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanLeftCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanRightCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PauseCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PlayCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PreviousTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RestCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RewindCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StandBy>,
        <http://elite.polito.it/ontologies/dogont.owl#StepDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopHeatingCoolingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopPlayingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#UpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> .

<http://elite.polito.it/ontologies/dogont.owl#KonnexGateway> a owl:Class ;
    rdfs:label "KonnexGateway"^^xsd:string ;
    rdfs:comment "A Konnex Gateway"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#connectionTrials> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#port> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#sleepTime> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#connectionTimeOut> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#IPAddress> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#multicastIP> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#pollingInterval> ],
        <http://elite.polito.it/ontologies/dogont.owl#KonnexComponent> .

<http://elite.polito.it/ontologies/dogont.owl#NetworkComponent> a owl:Class ;
    rdfs:label "NetworkComponent"^^xsd:string ;
    rdfs:comment "The manufacturers of the domotic component"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Controllable> .

<http://elite.polito.it/ontologies/dogont.owl#Notification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        owl:Thing .

<http://elite.polito.it/ontologies/dogont.owl#PowerDelivery> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ElectricalSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Sensor> .

<http://elite.polito.it/ontologies/dogont.owl#ReactiveEnergyStateValue> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#phaseID> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ShadeStateValue>,
        <http://elite.polito.it/ontologies/dogont.owl#TemperatureStateValue> .

<http://elite.polito.it/ontologies/dogont.owl#SceneFunctionality> a owl:Class ;
    rdfs:comment "Derives from the general cluster functionalities defined in ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DeleteSceneCommand> ],
        [ a owl:Restriction ;
            owl:cardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Switch> a owl:Class ;
    rdfs:label "Switch"^^xsd:string ;
    rdfs:comment "Bi-stable control consisting of a mechanical or electrical or electronic device for making or breaking or changing the connections in a circuit"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Control> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleRelay> .

<http://elite.polito.it/ontologies/dogont.owl#TemperatureMeasurementMNotification> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "temperatureValue^^Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "changedTemperatureAt"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationName> ],
        [ a owl:Restriction ;
            owl:hasValue "sensorID^^String"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#notificationParamName> ],
        <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> .

<http://elite.polito.it/ontologies/dogont.owl#TemperatureStateValue> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousValue> .

<http://elite.polito.it/ontologies/dogont.owl#ThermostatNotificationFunctionality> a owl:Class ;
    rdfs:comment "The thermostat request notification, requires a device having the thermostat control functionality to increase, set or decrease the current temperature. Derives from ZigBee HA (slightly modified...)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CoolNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ChangedDesiredTemperatureNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StopHeatingCoolingNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#ToggleRelay> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ToggleFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffNotificationFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#Control> .

<http://elite.polito.it/ontologies/dogont.owl#WallOpening> a owl:Class ;
    rdfs:label "WallOpening"^^xsd:string ;
    rdfs:comment "An opening in a Wall"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#isInWall> ],
        <http://elite.polito.it/ontologies/dogont.owl#Vertical> .

<http://elite.polito.it/ontologies/dogont.owl#contains> a owl:ObjectProperty ;
    rdfs:label "contains"^^xsd:string ;
    rdfs:comment "Indicates which object are contained in a building environment, e.g. the kitchen contains Lamp1,Lamp2..."^^xsd:string ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#Appliances> <http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment> <http://elite.polito.it/ontologies/dogont.owl#Furniture> <http://elite.polito.it/ontologies/dogont.owl#HousePlants> ) ] .

<http://elite.polito.it/ontologies/dogont.owl#phaseID> a owl:DatatypeProperty ;
    rdfs:domain <http://elite.polito.it/ontologies/dogont.owl#StateValue> ;
    rdfs:range xsd:string .

<http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment> a owl:Class ;
    rdfs:label "BuildingEnvironment"^^xsd:string ;
    rdfs:comment "A physical environment in which people lives, e.g. kitchen, bathroom"^^xsd:string .

<http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityMCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#nParams> ],
        [ a owl:Restriction ;
            owl:hasValue "getRelativeHumidityFrom"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        [ a owl:Restriction ;
            owl:hasValue "sensorURI^^String"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#commandParamName> ],
        [ a owl:Restriction ;
            owl:hasValue "Measure"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#returnType> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonVoidCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ParametricCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SelectSourceCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand> .

<http://elite.polito.it/ontologies/dogont.owl#LevelControlFunctionality> a owl:Class ;
    rdfs:comment "Level control functionality, used for allowing devices to be controlled in a continuous manner, derives from ZigBee Home Automation specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StepDownCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ShutterRegulationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#ThermostatControlFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TimeRegulationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#NetworkFunctionality> a owl:Class ;
    rdfs:comment "Derives from the general cluster functionalities defined in ZigBee HA specifications"@en ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#DiscreteControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#PlayFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleValuedFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#NetworkNotificationFunctionality> a owl:Class ;
    rdfs:comment "Derives from the general cluster functionalities defined in ZigBee HA specifications"@en ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#DiscreteNotificationFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SingleValuedNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#SceneNotificationFunctionality> a owl:Class ;
    rdfs:comment "Derives from the general cluster functionalities defined in ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DeleteSceneNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StoreSceneNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Shade> a owl:Class ;
    rdfs:comment "Shade object, the name includes an underscore sign only for distinguishing the name from the shade actuator, whose name is directly mapped from ZigBee"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Shutter>,
        <http://elite.polito.it/ontologies/dogont.owl#Sofa>,
        <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#SingleFlowSensor> a owl:Class ;
    rdfs:comment "The Flow  Sensor device measures and periodically reports the flow rate of a liquid (typically water)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FlowMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FlowRateState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#FlowMeasurementFunctionality> ],
        <http://elite.polito.it/ontologies/dogont.owl#FlowSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#HVACSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#SmokeSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#Thermostat>,
        <http://elite.polito.it/ontologies/dogont.owl#VentilatingSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#WindowSensor> .

<http://elite.polito.it/ontologies/dogont.owl#ContinuousControlFunctionality> a owl:Class ;
    rdfs:label "ContinuousFunctionality"^^xsd:string ;
    rdfs:comment "Functionalities continuous in time or space"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#DiscreteControlFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#DiscreteState> a owl:Class ;
    rdfs:label "DiscreteState"^^xsd:string ;
    rdfs:comment "States not continuous, with fixed values"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DiscreteValue> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasStateValue> ],
        <http://elite.polito.it/ontologies/dogont.owl#State> .

<http://elite.polito.it/ontologies/dogont.owl#DownCommand> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "down"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#VoidCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#ForwardCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetFlowRateCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetOccupancyCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GoToTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#HeatCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseColorCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseContrastCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseLuminosityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseQualityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#NextTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OffFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OnFlashingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#OpenCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanLeftCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanRightCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PanUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PauseCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PlayCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#PreviousTrackCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RestCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#RewindCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature>,
        <http://elite.polito.it/ontologies/dogont.owl#SetHourCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetMinutesCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSecondsCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetSpeedCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetTimeoutCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SetVolumeCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#SpeedUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StandBy>,
        <http://elite.polito.it/ontologies/dogont.owl#StepDownCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StepUpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopHeatingCoolingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StopPlayingCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#StoreSceneCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#TimedOnCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ToggleCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#UpCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> .

<http://elite.polito.it/ontologies/dogont.owl#GroupFunctionality> a owl:Class ;
    rdfs:comment "Derives from the general cluster functionalities defined in ZigBee HA specifications"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DeleteGroupCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StoreGroupCommand> ],
        [ a owl:Restriction ;
            owl:cardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#NetworkFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#IdentificationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#SceneFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Sofa> a owl:Class ;
    rdfs:label "Sofa"^^xsd:string ;
    rdfs:comment "An upholstered seat for more than one person"^^xsd:string ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#Furniture> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Table>,
        <http://elite.polito.it/ontologies/dogont.owl#Wardrobe> .

<http://elite.polito.it/ontologies/dogont.owl#ThermostatControlFunctionality> a owl:Class ;
    rdfs:label "TemperatureRegulationFunctionality"^^xsd:string ;
    rdfs:comment "Functionalities for the regulation of temperature"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StopHeatingCoolingCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#HeatCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetDesiredTemperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#CoolCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousControlFunctionality> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#TimeRegulationFunctionality>,
        <http://elite.polito.it/ontologies/dogont.owl#TunerFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#TunerFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#SetChannelCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#UpCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#DownCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#ContinuousControlFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#WindowSensor> a owl:Class ;
    rdfs:label "WindowSensor"^^xsd:string ;
    rdfs:comment "Sensor that controls if a window is closed"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#sensorOf> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OpenCloseNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:cardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://elite.polito.it/ontologies/dogont.owl#Window> ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#sensorOf> ],
        <http://elite.polito.it/ontologies/dogont.owl#AntiIntrusionSystem>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> .

<http://elite.polito.it/ontologies/dogont.owl#hasActuator> a owl:ObjectProperty ;
    rdfs:label "hasActuator"^^xsd:string ;
    rdfs:comment "Association between a mobile uncontrollable object and its actuator"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#Awning> <http://elite.polito.it/ontologies/dogont.owl#Door> <http://elite.polito.it/ontologies/dogont.owl#Gate> <http://elite.polito.it/ontologies/dogont.owl#Shutter> <http://elite.polito.it/ontologies/dogont.owl#Window> ) ] ;
    rdfs:range <http://elite.polito.it/ontologies/dogont.owl#Actuator> .

<http://elite.polito.it/ontologies/dogont.owl#Actuator> a owl:Class ;
    rdfs:label "Actuator"^^xsd:string ;
    rdfs:comment "A mechanism that puts something into automatic action"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#isIn> ],
        <http://elite.polito.it/ontologies/dogont.owl#ElectricalSystem> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#Lighting>,
        <http://elite.polito.it/ontologies/dogont.owl#PowerDelivery>,
        <http://elite.polito.it/ontologies/dogont.owl#Sensor> .

<http://elite.polito.it/ontologies/dogont.owl#GetOccupancyCommand> a owl:Class ;
    rdfs:comment "the command for getting the occupancy state of a given room/environment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "Boolean"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#returnType> ],
        [ a owl:Restriction ;
            owl:hasValue "getOccupancy"^^xsd:string ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#realCommandName> ],
        <http://elite.polito.it/ontologies/dogont.owl#NonParametricCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#NonVoidCommand> ;
    owl:disjointWith <http://elite.polito.it/ontologies/dogont.owl#GetPressureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetPressureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetRelativeHumidityMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GetTemperatureMCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#GrabPictureCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#HeatCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseColorCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseContrastCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#IncreaseLuminosityCommand>,
