        <http://elite.polito.it/ontologies/dogont.owl#ZoomInCommand>,
        <http://elite.polito.it/ontologies/dogont.owl#ZoomOutCommand> .

<http://elite.polito.it/ontologies/dogont.owl#EnergyMeasurementState> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#ContinuousState> .

<http://elite.polito.it/ontologies/dogont.owl#Entertainment> a owl:Class ;
    rdfs:label "Entertainment"^^xsd:string ;
    rdfs:comment "A diversion that holds the attention"^^xsd:string ;
