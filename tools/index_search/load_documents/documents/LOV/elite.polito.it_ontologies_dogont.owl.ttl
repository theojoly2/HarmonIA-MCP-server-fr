<http://elite.polito.it/ontologies/dogont.owl#StartStopPauseFunctionality> a owl:Class ;
    rdfs:comment "A functionality describing the ability of a device, tipically an appliance, to start, stop or pause its current cycle."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StopCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PauseCommand> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasCommand> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StartCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#StartStopPauseNotificationFunctionality> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StopApplianceNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#StartApplianceNotification> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasNotification> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#PauseApplianceNotification> ],
        <http://elite.polito.it/ontologies/dogont.owl#TripleValuedNotificationFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#SuperCoolingNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> ;
    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#StartedSuperCoolingNotification> <http://elite.polito.it/ontologies/dogont.owl#StoppedSuperCoolingNotification> ) .

<http://elite.polito.it/ontologies/dogont.owl#SuperFreezingNotification> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#NonParametricNotification> ;
    owl:disjointUnionOf ( <http://elite.polito.it/ontologies/dogont.owl#StartedSuperFreezingNotification> <http://elite.polito.it/ontologies/dogont.owl#StoppedSuperFreezingNotification> ) .

<http://elite.polito.it/ontologies/dogont.owl#SuperHeatingNotification> a owl:Class ;
