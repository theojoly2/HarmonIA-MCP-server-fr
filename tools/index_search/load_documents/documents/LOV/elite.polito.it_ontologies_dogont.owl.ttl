        <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseActivePowerMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseApparentPowerMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseCurrentMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseReactivePowerMeter>,
        <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseVoltageMeter> .

<http://elite.polito.it/ontologies/dogont.owl#ThreePhaseEnergyMeter> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseReactiveEnergyMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseActiveEnergyMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseActiveEnergyMeasurementNotificationFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasFunctionality> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseReactiveEnergyMeasurementFunctionality> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseActiveEnergyState> ],
        [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ThreePhaseReactiveEnergyState> ],
        <http://elite.polito.it/ontologies/dogont.owl#SingleTariffEnergyMeter> .

<http://elite.polito.it/ontologies/dogont.owl#TripleSensor> a owl:Class ;
    rdfs:subClassOf <http://elite.polito.it/ontologies/dogont.owl#LightSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#MovementSensor>,
        <http://elite.polito.it/ontologies/dogont.owl#SingleTemperatureSensor> .

<http://elite.polito.it/ontologies/dogont.owl#Ventilator> a owl:Class ;
    rdfs:label "Ventilator"^^xsd:string ;
    rdfs:comment "A device that circulates fresh air and expels stale or foul air."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://elite.polito.it/ontologies/dogont.owl#hasState> ;
            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#OnOffState> ],
