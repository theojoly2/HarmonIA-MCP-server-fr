<http://elite.polito.it/ontologies/dogont.owl#returnType> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://elite.polito.it/ontologies/dogont.owl#NonVoidCommand> <http://elite.polito.it/ontologies/dogont.owl#ParametricNotification> ) ] ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "Boolean"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "DeviceStatus"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Double"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "Float"^^xsd:string ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "Image"^^xsd:string ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "Integer"^^xsd:string ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first "Long"^^xsd:string ;
                                                                    rdf:rest [ a rdf:List ;
                                                                            rdf:first "Measure"^^xsd:string ;
                                                                            rdf:rest [ a rdf:List ;
                                                                                    rdf:first "Object"^^xsd:string ;
                                                                                    rdf:rest [ a rdf:List ;
                                                                                            rdf:first "Object[]"^^xsd:string ;
                                                                                            rdf:rest [ a rdf:List ;
                                                                                                    rdf:first "Set"^^xsd:string ;
                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] .

