            owl:someValuesFrom <http://elite.polito.it/ontologies/dogont.owl#ToggleCommand> ],
        <http://elite.polito.it/ontologies/dogont.owl#SingleValuedFunctionality> .

<http://elite.polito.it/ontologies/dogont.owl#Tv> a owl:Class ;
