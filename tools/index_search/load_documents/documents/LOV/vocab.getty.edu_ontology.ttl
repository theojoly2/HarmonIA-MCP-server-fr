<http://vocab.getty.edu/term/POS/PastParticiple> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Rarely used but if at all, is most likely to apply in Attributes and Properties.\\nExample: hand-painted" ;
    skos:example "hand-painted" ;
    skos:inScheme <http://vocab.getty.edu/term/POS/> ;
    skos:notation "PP" ;
    skos:prefLabel "Past Participle" ;
    skos:scopeNote "Rarely used but if at all, is most likely to apply in Attributes and Properties" .

<http://vocab.getty.edu/term/POS/PluralNoun> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "A term that is plural (the same word may be singular in another language).\\nExample: \"filigrane\" is the Italian plural for \"watermarks\"" ;
    skos:example "\"filigrane\" is the Italian plural for \"watermarks\"" ;
    skos:inScheme <http://vocab.getty.edu/term/POS/> ;
    skos:notation "PN" ;
    skos:prefLabel "Plural Noun" ;
    skos:scopeNote "A term that is plural (the same word may be singular in another language)" .

<http://vocab.getty.edu/term/POS/SingularNoun> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "A term that is singular (the same word may be plural in another language).\\nExample: \"filigrane\" is the French singular for \"watermark\"" ;
    skos:example "\"filigrane\" is the French singular for \"watermark\"" ;
    skos:inScheme <http://vocab.getty.edu/term/POS/> ;
    skos:notation "SN" ;
    skos:prefLabel "Singular Noun" ;
    skos:scopeNote "A term that is singular (the same word may be plural in another language)" .

<http://vocab.getty.edu/term/POS/VerbalNounGerund> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Term is a verbal noun or gerund.\\nExample: polishing" ;
    skos:example "polishing" ;
    skos:inScheme <http://vocab.getty.edu/term/POS/> ;
    skos:notation "VN" ;
    skos:prefLabel "Verbal Noun/Gerund" ;
    skos:scopeNote "Term is a verbal noun or gerund" .

<http://vocab.getty.edu/term/display/Display> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Use in displays where natural order is appropriate" ;
    skos:inScheme <http://vocab.getty.edu/term/display/> ;
    skos:notation "D",
        "Y" ;
    skos:prefLabel "Use for Display" ;
    skos:scopeNote "Use in displays where natural order is appropriate" .

<http://vocab.getty.edu/term/display/Indexing> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Use in indexes or permuted lists where inverted order is appropriate" ;
    skos:inScheme <http://vocab.getty.edu/term/display/> ;
    skos:notation "I" ;
    skos:prefLabel "Use in Indexes/lists" ;
    skos:scopeNote "Use in indexes or permuted lists where inverted order is appropriate" .

<http://vocab.getty.edu/term/flag/LiteralTranslation> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Literal translation of a name.  Defined for ULAN, but currently there are no examples of this" ;
    skos:inScheme <http://vocab.getty.edu/term/flag/> ;
    skos:notation "T" ;
    skos:prefLabel "Literal Translation" ;
    skos:scopeNote "Literal translation of a name.  Defined for ULAN, but currently there are no examples of this" .

<http://vocab.getty.edu/term/flag/LoanTerm> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Term borrowed from another language that has become naturalized in American English.\\nExample: papier mache" ;
    skos:example "papier mache" ;
    skos:inScheme <http://vocab.getty.edu/term/flag/> ;
    skos:notation "L" ;
    skos:prefLabel "Loan Term" ;
    skos:scopeNote "Term borrowed from another language that has become naturalized in American English" .

<http://vocab.getty.edu/term/flag/Vernacular> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Term is the vernacular for a certain place.\\nExample: \"kachoga\" is the Vernacular for 300266169 \"bird-and-flower paintings\" (AAT). \"Firenze\" is the vernacular in Italian (TGN)" ;
    skos:example "\"kachoga\" is the Vernacular for 300266169 \"bird-and-flower paintings\" (AAT). \"Firenze\" is the vernacular in Italian (TGN)" ;
    skos:inScheme <http://vocab.getty.edu/term/flag/> ;
    skos:notation "V" ;
    skos:prefLabel "Vernacular" ;
    skos:scopeNote "Term is the vernacular for a certain place" .

<http://vocab.getty.edu/term/kind/Abbreviation> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Term is an abbreviation, initialism, or acronym.\\nExample: \"FLIM\" is abbrevaition for \"fluorescence lifetime imaging microscopy\"" ;
    skos:example "\"FLIM\" is abbrevaition for \"fluorescence lifetime imaging microscopy\"" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "A" ;
    skos:prefLabel "Abbreviation" ;
    skos:scopeNote "Term is an abbreviation, initialism, or acronym" .

<http://vocab.getty.edu/term/kind/BirthName> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Birth Name of an ULAN agent.\\nExample: TODO" ;
    skos:example "TODO" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "BN" ;
    skos:prefLabel "Birth Name" ;
    skos:scopeNote "Birth Name of an ULAN agent" .

<http://vocab.getty.edu/term/kind/ChemicalName> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Term is the chemical name for the descriptor. Used in AAT only.\\nExample: \"sodium tetraborate decahydrate\" is chemical name for \"borax\"" ;
    skos:example "\"sodium tetraborate decahydrate\" is chemical name for \"borax\"" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "CN" ;
    skos:prefLabel "Chemical Name" ;
    skos:scopeNote "Term is the chemical name for the descriptor. Used in AAT only" .

<http://vocab.getty.edu/term/kind/CommonName> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Common Name of an ULAN agent.\\nExample: TODO" ;
    skos:example "TODO" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "CN" ;
    skos:prefLabel "Common Name" ;
    skos:scopeNote "Common Name of an ULAN agent" .

<http://vocab.getty.edu/term/kind/CommonTerm> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Preferred common language term. Used for subjects that also include a Scientific term. Used in AAT only.\\nExample: \"frankincense\" (species) is common term for \"Boswellia sacra\" (species)" ;
    skos:example "\"frankincense\" (species) is common term for \"Boswellia sacra\" (species)" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "C" ;
    skos:prefLabel "Common term" ;
    skos:scopeNote "Preferred common language term. Used for subjects that also include a Scientific term. Used in AAT only" .

<http://vocab.getty.edu/term/kind/FIPSCode> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "FIPS region code. Used in TGN.\\nExample: \"MX21\" for Puebla, Mexico" ;
    skos:example "\"MX21\" for Puebla, Mexico" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "FIPS" ;
    skos:prefLabel "FIPS Code" ;
    skos:scopeNote "FIPS region code. Used in TGN" .

<http://vocab.getty.edu/term/kind/FullName> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Full Name of an ULAN agent.\\nExample: TODO" ;
    skos:example "TODO" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "FN" ;
    skos:prefLabel "Full Name" ;
    skos:scopeNote "Full Name of an ULAN agent" .

<http://vocab.getty.edu/term/kind/FullTerm> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Full-form term. Used when the descriptor is a shorter form, or the subject also includes an Abbreviation. Used in AAT only.\\nExample: \"Extensible Markup Language\" is the full term for \"XML\" (which is preferred)" ;
    skos:example "\"Extensible Markup Language\" is the full term for \"XML\" (which is preferred)" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "F" ;
    skos:prefLabel "Full term" ;
    skos:scopeNote "Full-form term. Used when the descriptor is a shorter form, or the subject also includes an Abbreviation. Used in AAT only" .

<http://vocab.getty.edu/term/kind/ISOalpha2> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "ISO 3166-1 alpha-2 country code. Used in TGN.\\nExample: \"AQ\" for Antarctica" ;
    skos:example "\"AQ\" for Antarctica" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "ISO2L" ;
    skos:prefLabel "ISO alpha-2 code" ;
    skos:scopeNote "ISO 3166-1 alpha-2 country code. Used in TGN" .

<http://vocab.getty.edu/term/kind/ISOalpha3> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "ISO 3166-1 alpha-3 country code. Used in TGN.\\nExample: \"ATA\" for Antarctica" ;
    skos:example "\"ATA\" for Antarctica" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "ISO3L" ;
    skos:prefLabel "ISO alpha-3 code" ;
    skos:scopeNote "ISO 3166-1 alpha-3 country code. Used in TGN" .

<http://vocab.getty.edu/term/kind/ISOnumeric2> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "May be used in TGN, but no code of this kind is present" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "ISO2N" ;
    skos:prefLabel "ISO numeric-2 code" ;
    skos:scopeNote "May be used in TGN, but no code of this kind is present" .

<http://vocab.getty.edu/term/kind/ISOnumeric3> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "ISO 3166-1 numeric country code as \"ISOnnn\" (though ISO specifies only \"nnn\"). Used in TGN only.\\nExample: \"ISO414\" for Kuwait" ;
    skos:example "\"ISO414\" for Kuwait" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "ISO3N" ;
    skos:prefLabel "ISO numeric-3 code" ;
    skos:scopeNote "ISO 3166-1 numeric country code as \"ISOnnn\" (though ISO specifies only \"nnn\"). Used in TGN only" .

<http://vocab.getty.edu/term/kind/JargonOrSlang> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Slang or jargon term. Used in AAT only.\\nExample: \"fool's gold\" is slang for \"pyrite\"" ;
    skos:example "\"fool's gold\" is slang for \"pyrite\"" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "J" ;
    skos:prefLabel "Jargon or Slang" ;
    skos:scopeNote "Slang or jargon term. Used in AAT only" .

<http://vocab.getty.edu/term/kind/Neologism> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Term that is new to the language, generally having been coined due to new technology. Used in AAT only..\\nExample: \"folksonomy\", \"podcasting\"" ;
    skos:example "\"folksonomy\", \"podcasting\"" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "N" ;
    skos:prefLabel "Neologism" ;
    skos:scopeNote "Term that is new to the language, generally having been coined due to new technology. Used in AAT only." .

<http://vocab.getty.edu/term/kind/OfficialName> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Used in TGN and ULAN.\\nExample: \"Noyen-sur-Seine\" is official name of 7030197 \"Noyen\" (TGN)" ;
    skos:example "\"Noyen-sur-Seine\" is official name of 7030197 \"Noyen\" (TGN)" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "O" ;
    skos:prefLabel "Official Name" ;
    skos:scopeNote "Used in TGN and ULAN" .

<http://vocab.getty.edu/term/kind/ProvisionalName> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Used in TGN only.\\nExample: \"Rockton\" was provisional name considered before adoption of \"Kent\" (Ohio)" ;
    skos:example "\"Rockton\" was provisional name considered before adoption of \"Kent\" (Ohio)" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "PN" ;
    skos:prefLabel "Provisional Name" ;
    skos:scopeNote "Used in TGN only" .

<http://vocab.getty.edu/term/kind/Pseudonym> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Used in TGN and ULAN.\\nExample: \"Frisco\" is nickname for San Francisco (TGN)" ;
    skos:example "\"Frisco\" is nickname for San Francisco (TGN)" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "P" ;
    skos:prefLabel "Pseudonym" ;
    skos:scopeNote "Used in TGN and ULAN" .

<http://vocab.getty.edu/term/kind/ScientificOrTechnical> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Scientific taxon name (genus, species, etc). Used in AAT only. All such are emitted marked with English language, and most have the same string marked with Latin.\\nExample: \"Boswellia sacra\"@la, also emitted as \"Boswellia sacra\"@en, is scientific name of \"frankincense\"" ;
    skos:example "\"Boswellia sacra\"@la, also emitted as \"Boswellia sacra\"@en, is scientific name of \"frankincense\"" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "S" ;
    skos:prefLabel "Scientific or Technical term" ;
    skos:scopeNote "Scientific taxon name (genus, species, etc). Used in AAT only. All such are emitted marked with English language, and most have the same string marked with Latin" .

<http://vocab.getty.edu/term/kind/SiteName> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Used in TGN only.\\nExample: \"Flavia Solva\", a deserted settlement and archaeological site (TGN)" ;
    skos:example "\"Flavia Solva\", a deserted settlement and archaeological site (TGN)" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "S" ;
    skos:prefLabel "Site Name" ;
    skos:scopeNote "Used in TGN only" .

<http://vocab.getty.edu/term/kind/USPSCode> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Used in TGN only.\\nExample: \"CA\" for California" ;
    skos:example "\"CA\" for California" ;
    skos:inScheme <http://vocab.getty.edu/term/kind/> ;
    skos:notation "USPS" ;
    skos:prefLabel "US Postal Service Code" ;
    skos:scopeNote "Used in TGN only" .

<http://vocab.getty.edu/term/type/AlternateDescriptor> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "A lexical variant, eg singular.\\nExample: \"manuscript\" (English) instead of \"manuscripts\"" ;
    skos:example "\"manuscript\" (English) instead of \"manuscripts\"" ;
    skos:inScheme <http://vocab.getty.edu/term/type/> ;
    skos:notation "AD" ;
    skos:prefLabel "Alternate Descriptor" ;
    skos:scopeNote "A lexical variant, eg singular" .

<http://vocab.getty.edu/term/type/Descriptor> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Main term. Getty usually uses the plural.\\nExample: \"manuscripts\" (English)" ;
    skos:example "\"manuscripts\" (English)" ;
    skos:inScheme <http://vocab.getty.edu/term/type/> ;
    skos:notation "D" ;
    skos:prefLabel "Descriptor" ;
    skos:scopeNote "Main term. Getty usually uses the plural" .

<http://vocab.getty.edu/term/type/UsedForTerm> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "A synonym.\\nExample: \"handschriften\" (Dutch) instead of \"manuscripten\"" ;
    skos:example "\"handschriften\" (Dutch) instead of \"manuscripten\"" ;
    skos:inScheme <http://vocab.getty.edu/term/type/> ;
    skos:notation "UF" ;
    skos:prefLabel "Used for Term" ;
    skos:scopeNote "A synonym" .

