<http://vocab.getty.edu/ontology#placeTypePreferred> a owl:ObjectProperty ;
    rdfs:label "placeTypePreferred" ;
    dcterms:description "The primary type of a TGN Place. Domain is TGN concept, range is AAT concept.\\nExample: The preferred place type of Machupicchu, Peru is \"deserted settlement\" (current)" ;
