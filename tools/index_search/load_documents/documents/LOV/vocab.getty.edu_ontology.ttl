    skos:example "Iran (nation) is the successor of Persia" ;
    skos:prefLabel "tgn3411_successor_of" .

<http://vocab.getty.edu/ontology#tgn3510_historical_connection> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "3510" ;
    dc:title "historical connection - any" ;
    dcterms:description "any - historical connection - any.\\r\\nExample: Guyenne, France (historical region) has a historical connection to Gascogne (France) (historical region)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "Guyenne, France (historical region) has a historical connection to Gascogne (France) (historical region)" ;
    skos:prefLabel "tgn3510_historical_connection" .

<http://vocab.getty.edu/ontology#tgn3611_administrative_dependent_of> a owl:ObjectProperty ;
    dc:identifier "3611" ;
    dc:title "administrative dependent of - place" ;
    dcterms:description "place - administrative dependent of - place; New.\\r\\nExample: Luni (La Spezia province, Liguria, Italy) is the admisistrative dependent of Ortonovo (Massa-Carrara province, Tuscany, Italy)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
