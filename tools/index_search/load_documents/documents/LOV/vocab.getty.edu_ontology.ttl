<http://vocab.getty.edu/ontology#prefLabelLoC> a owl:ObjectProperty ;
    rdfs:label "prefLabelLoC" ;
    dcterms:description "Term preferred by Library of Congress, thus used for cataloging according to AACR2. Applicable to AAT and ULAN. Used with skosxl:prefLabel" ;
    rdfs:comment "Term preferred by Library of Congress, thus used for cataloging according to AACR2. Applicable to AAT and ULAN. Used with skosxl:prefLabel" ;
