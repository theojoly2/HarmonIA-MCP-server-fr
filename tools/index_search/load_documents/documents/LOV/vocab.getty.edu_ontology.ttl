ns1:conclusion a owl:AnnotationProperty .

ns1:premise a owl:AnnotationProperty .

ns1:premise1 a owl:AnnotationProperty .

ns1:premise2 a owl:AnnotationProperty .

ns1:restriction a owl:AnnotationProperty .

ns1:type1 a owl:AnnotationProperty .

ns1:type2 a owl:AnnotationProperty .

skos:altLabel a owl:ObjectProperty ;
    owl:propertyChainAxiom ( <http://www.w3.org/2008/05/skos-xl#altLabel> <http://www.w3.org/2008/05/skos-xl#literalForm> ) .

skos:hiddenLabel a owl:ObjectProperty ;
    owl:propertyChainAxiom ( <http://www.w3.org/2008/05/skos-xl#hiddenLabel> <http://www.w3.org/2008/05/skos-xl#literalForm> ) .

skos:prefLabel a owl:ObjectProperty ;
    owl:propertyChainAxiom ( <http://www.w3.org/2008/05/skos-xl#prefLabel> <http://www.w3.org/2008/05/skos-xl#literalForm> ) .

foaf:homepage a owl:AnnotationProperty .

foaf:name a owl:AnnotationProperty .

dcterms:replaces a owl:ObjectProperty .

