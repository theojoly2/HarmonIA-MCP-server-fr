<http://vocab.getty.edu/ontology#qualifier> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "qualifier" ;
    dcterms:description "Clarifies and disambiguates terms with the same spelling but different meaning.\\nAppended in parentheses to gvp:term, forming skosxsl:literalForm.\\nEvery qualifier is in the same language as the term.\\nExample: \"Rhea (vessels)\"=rhyta (a kind of drinking vessel) vs \"Rhea (species)\"=Boehmeria nivea (Chinese grass)" ;
    rdfs:comment "Clarifies and disambiguates terms with the same spelling but different meaning.\\nAppended in parentheses to gvp:term, forming skosxsl:literalForm.\\nEvery qualifier is in the same language as the term" ;
    rdfs:domain <http://www.w3.org/2008/05/skos-xl#Label> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:Literal ;
    skos:example "Rhea (vessels)=rhyta (a kind of drinking vessel) vs rhea (species)=Boehmeria nivea (Chinese grass)" .

<http://vocab.getty.edu/ontology#sourceAlternatePreferred> a owl:ObjectProperty ;
    rdfs:label "sourceAlternatePreferred" ;
    dcterms:description "Source for which the term is Alternate Preferred. Range is bibo:Document or bibo:DocumentPart.\\nExample: \"Kayseri\" is alternate preferred in Webster's New Geographical Dictionary (1988)" ;
