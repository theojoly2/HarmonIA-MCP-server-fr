    rdfs:domain <http://www.w3.org/2008/05/skos-xl#Label> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf dcterms:contributor ;
    skos:example "\"organza\" is preferred term for WHS" .

