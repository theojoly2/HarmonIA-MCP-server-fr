<http://vocab.getty.edu/ontology#parentString> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "parentString" ;
    dcterms:description "Preferred labels of *all* of the subject's preferred ancestors, listed bottom up. Useful to show the subject's full context.\\nDisplay version of gvp:broaderPreferredExtended.\\nExample for baking dishes [300226882]: bakeware, <vessels for cooking food>, <containers for cooking food>, <culinary containers>, <containers by function or context>, containers (receptacles), Containers (Hierarchy Name), Furnishings and Equipment (Hierarchy Name), Objects Facet" ;
    rdfs:comment "Preferred labels of *all* of the subject's preferred ancestors, listed bottom up. Useful to show the subject's full context" ;
    rdfs:domain <http://vocab.getty.edu/ontology#Subject> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:Literal ;
    skos:example "Example for baking dishes [300226882]: bakeware, <vessels for cooking food>, <containers for cooking food>, <culinary containers>, <containers by function or context>, containers (receptacles), Containers (Hierarchy Name), Furnishings and Equipment (Hierarchy Name), Objects Facet" ;
    skos:note "Display version of gvp:broaderPreferredExtended" .

<http://vocab.getty.edu/ontology#parentStringAbbrev> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "parentStringAbbrev" ;
    dcterms:description "Preferred labels of *some* of the subject's preferred ancestors, listed bottom up. Useful to show the subject's context.\\nShortened display version of gvp:broaderPreferredExtended.\\nExample for baking dishes [300226882]: bakeware, <vessels for cooking food>, ... Furnishings and Equipment (Hierarchy Name)" ;
    rdfs:comment "Preferred labels of *some* of the subject's preferred ancestors, listed bottom up. Useful to show the subject's context" ;
    rdfs:domain <http://vocab.getty.edu/ontology#Subject> ;
    rdfs:isDefinedBy onto: ;
