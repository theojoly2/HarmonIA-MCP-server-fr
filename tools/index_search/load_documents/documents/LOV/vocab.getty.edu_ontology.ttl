@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.ontotext.com/proton/protontop#> .
@prefix onto: <http://vocab.getty.edu/ontology> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:identifier a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:isReplacedBy a owl:ObjectProperty ;
    owl:inverseOf dcterms:replaces .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://schema.org/dissolutionLocation> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "dissolutionLocation" ;
    dcterms:description "The place where the Organization was dissolved.\\nSchema has properties foundationLocation and dissolutionDate but no dissolutionLocation. \\nIn contrast, for a person all 4 properties are present: birth/death place/date.\\nWe posted issue https://github.com/schemaorg/schemaorg/issues/302, which looks like it will have a positive outcome in the far future.\\nAnd we define the property here" ;
    rdfs:comment "The place where the Organization was dissolved" ;
    rdfs:domain <http://schema.org/Organization> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://schema.org/Place> ;
    rdfs:seeAlso <https://github.com/schemaorg/schemaorg/issues/302> .

<http://vocab.getty.edu/aat/> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Art and Architecture Thesaurus" ;
    dcterms:created "2014-02-20"^^xsd:date ;
    dcterms:creator <http://www.getty.edu/research/>,
        <http://www.ontotext.com> ;
    vann:preferredNamespacePrefix "aat" ;
    vann:preferredNamespaceUri "http://vocab.getty.edu/aat/" ;
    rdfs:comment "The Art and Architecture Thesaurus concept scheme" ;
    rdfs:seeAlso <http://vocab.getty.edu/>,
        <http://vocab.getty.edu/.well-known/void>,
        <http://www.getty.edu/research/tools/vocabularies/lod/> ;
    foaf:homepage <http://www.getty.edu/research/tools/vocabularies/aat/> .

<http://vocab.getty.edu/aat/300189557> a owl:NamedIndividual ;
    skos:exactMatch <http://rdaregistry.info/termList/gender/1001>,
        <http://www.wikidata.org/entity/Q6581072> .

<http://vocab.getty.edu/aat/300189559> a owl:NamedIndividual ;
    skos:exactMatch <http://rdaregistry.info/termList/gender/1002>,
        <http://www.wikidata.org/entity/Q6581097> .

<http://vocab.getty.edu/historic/current> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Valid/used currently" ;
    skos:inScheme <http://vocab.getty.edu/historic/> ;
    skos:notation "C" ;
    skos:prefLabel "Current" ;
    skos:scopeNote "Valid/used currently" .

<http://vocab.getty.edu/historic/currentAndHistoric> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Valid/used both in the past and currently.\\nExample: Saint Petersburg (TGN)" ;
    skos:example "Saint Petersburg (TGN)" ;
    skos:inScheme <http://vocab.getty.edu/historic/> ;
    skos:notation "B" ;
    skos:prefLabel "Both Current and Historic" ;
    skos:scopeNote "Valid/used both in the past and currently" .

<http://vocab.getty.edu/historic/historic> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Valid/used in the past but not currently.\\nExample: \"Lutetia\" is a historic name for \"Paris\" (TGN). \"weyneschot\" is a 16th-century spelling for \"wainscoting\" (AAT)" ;
    skos:example "\"Lutetia\" is a historic name for \"Paris\" (TGN). \"weyneschot\" is a 16th-century spelling for \"wainscoting\" (AAT)" ;
    skos:inScheme <http://vocab.getty.edu/historic/> ;
    skos:notation "H" ;
    skos:prefLabel "Historic" ;
    skos:scopeNote "Valid/used in the past but not currently" .

<http://vocab.getty.edu/historic/localUse> a owl:NamedIndividual,
        skos:Concept ;
    dcterms:description "Used locally for Unidentified Named People mentioned in some document (ULAN only).\\nExample: 500051176 Abinetti (ULAN) is an unknown artist mentioned in documentation of lot 209 of an auction held 29 Jan 1824 in London" ;
    skos:example "500051176 Abinetti (ULAN) is an unknown artist mentioned in documentation of lot 209 of an auction held 29 Jan 1824 in London" ;
    skos:inScheme <http://vocab.getty.edu/historic/> ;
    skos:notation "LU" ;
    skos:prefLabel "Local Use" ;
    skos:scopeNote "Used locally for Unidentified Named People mentioned in some document (ULAN only)" .

<http://vocab.getty.edu/ontology#AdminPlaceConcept> a owl:Class ;
    rdfs:label "AdminPlaceConcept" ;
    dcterms:description "Place defined by administrative boundaries and conditions, including inhabited places, nations, and empires. Used in TGN only.\\nExample: Burgundy region in France (TGN)" ;
    rdfs:comment "Place defined by administrative boundaries and conditions, including inhabited places, nations, and empires. Used in TGN only" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.getty.edu/ontology#Subject>,
        skos:Concept ;
    skos:example "Burgundy region in France (TGN)" .

<http://vocab.getty.edu/ontology#Concept> a owl:Class ;
    rdfs:label "Concept" ;
    dcterms:description "Proper concept. Used in AAT only; TGN & ULAN have their own, e.g. gvp:PhysPlaceConcept & gvp:PersonConcept. Used for indexing and cataloguing.\\nExample: rhyta (AAT)" ;
    rdfs:comment "Proper concept. Used in AAT only; TGN & ULAN have their own, e.g. gvp:PhysPlaceConcept & gvp:PersonConcept. Used for indexing and cataloguing" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.getty.edu/ontology#Subject>,
        skos:Concept ;
    skos:example "rhyta (AAT)" .

<http://vocab.getty.edu/ontology#Facet> a owl:Class ;
    rdfs:label "Facet" ;
    dcterms:description "One of the major divisions of a vocabulary.\\nExample: Objects Facet (AAT), World (TGN), Artists (ULAN)" ;
    rdfs:comment "One of the major divisions of a vocabulary" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/iso25964/skos-thes#ThesaurusArray>,
        <http://vocab.getty.edu/ontology#Subject> ;
    skos:example "Objects Facet (AAT), World (TGN), Artists (ULAN)" .

<http://vocab.getty.edu/ontology#GroupConcept> a owl:Class ;
    rdfs:label "GroupConcept" ;
    dcterms:description "Two or more people who generally worked together to collectively create art. Not necessarily legally incorporated. A family of artists may be considered a \"corporate body\". Corresponds to crm:E74_Group, not its subclass crm:E40_Legal_Body.\\nExample: 500356337 Albrecht Duerer Workshop (ULAN)" ;
    rdfs:comment "Two or more people who generally worked together to collectively create art. Not necessarily legally incorporated. A family of artists may be considered a \"corporate body\". Corresponds to crm:E74_Group, not its subclass crm:E40_Legal_Body" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.getty.edu/ontology#Subject>,
        skos:Concept ;
    skos:example "500356337 Albrecht Duerer Workshop (ULAN)" .

<http://vocab.getty.edu/ontology#Hierarchy> a owl:Class ;
    rdfs:label "Hierarchy" ;
    dcterms:description "Top of a hierarchy. Used in AAT only. Not used for indexing or cataloguing.\\nExample: Containers (Hierarchy Name) (AAT)" ;
    rdfs:comment "Top of a hierarchy. Used in AAT only. Not used for indexing or cataloguing" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/iso25964/skos-thes#ThesaurusArray>,
        <http://vocab.getty.edu/ontology#Subject> ;
    skos:example "Containers (Hierarchy Name) (AAT)" .

<http://vocab.getty.edu/ontology#Infer_broaderNonConcept_PropChainType2> a ns1:PropChainType2,
        owl:NamedIndividual ;
    ns1:conclusion <http://vocab.getty.edu/ontology#broaderNonConcept> ;
    ns1:premise1 <http://vocab.getty.edu/ontology#broaderNonConcept> ;
    ns1:premise2 <http://vocab.getty.edu/ontology#broader> ;
    ns1:type2 <http://vocab.getty.edu/ontology#GuideTerm> .

<http://vocab.getty.edu/ontology#Infer_broaderNonConcept_TypeRestr> a ns1:TypeRestr,
        owl:NamedIndividual ;
    ns1:conclusion <http://vocab.getty.edu/ontology#broaderNonConcept> ;
    ns1:premise <http://vocab.getty.edu/ontology#broader> ;
    ns1:type1 skos:Concept ;
    ns1:type2 <http://vocab.getty.edu/ontology#GuideTerm> .

<http://vocab.getty.edu/ontology#Infer_broaderPreferredExtended> a ns1:PropChainRestr,
        owl:NamedIndividual ;
    ns1:conclusion <http://vocab.getty.edu/ontology#broaderPreferredExtended> ;
    ns1:premise1 <http://vocab.getty.edu/ontology#broaderPreferredExtended> ;
    ns1:premise2 <http://vocab.getty.edu/ontology#broaderPreferred> ;
    ns1:restriction <http://vocab.getty.edu/ontology#broaderExtended> .

<http://vocab.getty.edu/ontology#Infer_isoBroaderGeneric> a ns1:PropRestr,
        owl:NamedIndividual ;
    ns1:conclusion <http://purl.org/iso25964/skos-thes#broaderGeneric> ;
    ns1:premise <http://vocab.getty.edu/ontology#broaderGenericExtended> ;
    ns1:restriction skos:broader .

<http://vocab.getty.edu/ontology#Infer_isoBroaderInstantial> a ns1:PropRestr,
        owl:NamedIndividual ;
    ns1:conclusion <http://purl.org/iso25964/skos-thes#broaderInstantial> ;
    ns1:premise <http://vocab.getty.edu/ontology#broaderInstantialExtended> ;
    ns1:restriction skos:broader .

<http://vocab.getty.edu/ontology#Infer_isoBroaderPartitive> a ns1:PropRestr,
        owl:NamedIndividual ;
    ns1:conclusion <http://purl.org/iso25964/skos-thes#broaderPartitive> ;
    ns1:premise <http://vocab.getty.edu/ontology#broaderPartitiveExtended> ;
    ns1:restriction skos:broader .

<http://vocab.getty.edu/ontology#Infer_skosBroader_PropChainType2> a ns1:PropChainType2,
        owl:NamedIndividual ;
    ns1:conclusion skos:broader ;
    ns1:premise1 <http://vocab.getty.edu/ontology#broaderNonConcept> ;
    ns1:premise2 <http://vocab.getty.edu/ontology#broader> ;
    ns1:type2 skos:Concept .

<http://vocab.getty.edu/ontology#Infer_skosBroader_TypeRestr> a ns1:TypeRestr,
        owl:NamedIndividual ;
    ns1:conclusion skos:broader ;
    ns1:premise <http://vocab.getty.edu/ontology#broader> ;
    ns1:type1 skos:Concept ;
    ns1:type2 skos:Concept .

<http://vocab.getty.edu/ontology#ObsoleteSubject> a owl:Class ;
    rdfs:label "ObsoleteSubject" ;
    dcterms:description "Obsolete subject: moved out of the publishable hierarchy, or merged to another (pointed by dct:isReplacedBy).\\nExample: 300375205 \"shranks\" (AAT) was merged to 300039264 \"schranks\" (AAT), so aat:300375205 dct:isReplacedBy aat:300039264" ;
    rdfs:comment "Obsolete subject: moved out of the publishable hierarchy, or merged to another (pointed by dct:isReplacedBy)" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.getty.edu/ontology#Subject> ;
    skos:example "300375205 \"shranks\" (AAT) was merged to 300039264 \"schranks\" (AAT), so aat:300375205 dct:isReplacedBy aat:300039264" .

<http://vocab.getty.edu/ontology#PersonConcept> a owl:Class ;
    rdfs:label "PersonConcept" ;
    dcterms:description "A single individual. Usually people engaged in the design or creation of art or architecture (\"Artists\"); but may also include donors, patrons, rulers, sitters, art historians, etc (\"Non-Artists\").\\nExample: 500115493 Duerer, Albrecht (ULAN)" ;
    rdfs:comment "A single individual. Usually people engaged in the design or creation of art or architecture (\"Artists\"); but may also include donors, patrons, rulers, sitters, art historians, etc (\"Non-Artists\")" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.getty.edu/ontology#Subject>,
        skos:Concept ;
    skos:example "500115493 Duerer, Albrecht (ULAN)" .

<http://vocab.getty.edu/ontology#PhysAdminPlaceConcept> a owl:Class ;
    rdfs:label "PhysAdminPlaceConcept" ;
    dcterms:description "Place that is both administrative and physical. Rarely used. Used in TGN only.\\nExample: 6003090 Kiik-Koba (TGN)" ;
    rdfs:comment "Place that is both administrative and physical. Rarely used. Used in TGN only" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.getty.edu/ontology#Subject>,
        skos:Concept ;
    skos:example "6003090 Kiik-Koba (TGN)" .

<http://vocab.getty.edu/ontology#PhysPlaceConcept> a owl:Class ;
    rdfs:label "PhysPlaceConcept" ;
    dcterms:description "Physical feature, defined by its physical characteristics on planet Earth, including mountains, rivers, and oceans. Used in TGN only.\\nExample: Amazon River (TGN)" ;
    rdfs:comment "Physical feature, defined by its physical characteristics on planet Earth, including mountains, rivers, and oceans. Used in TGN only" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.getty.edu/ontology#Subject>,
        skos:Concept ;
    skos:example "Amazon River (TGN)" .

<http://vocab.getty.edu/ontology#ScopeNote> a owl:Class ;
    dcterms:description "Defines a GVP subject or provides usage information. Has fields:\\n- dc:identifier: numeric ID, also used in the URL.\\n- rdf:value: the note itself (as per SKOS Primer: 4.2 Advanced Documentation Features) with language tag\\n- dct:language: matches the language tag\\n- gvp:displayOrder, order of this note amongst others\\n- gvp:historicFlag, vp:estStart, gvp:estEnd, rdfs:comment: Historic Information about applicability\\n- dct:source or subproperties thereof \\n- dct:contributor or subproperties thereof" ;
    rdfs:comment "Defines a GVP subject or provides usage information. Has fields:\\n- dc:identifier: numeric ID, also used in the URL.\\n- rdf:value: the note itself (as per SKOS Primer: 4.2 Advanced Documentation Features) with language tag\\n- dct:language: matches the language tag\\n- gvp:displayOrder, order of this note amongst others\\n- gvp:historicFlag, gvp:estStart, gvp:estEnd, rdfs:comment: Historic Information about applicability\\n- dct:source or subproperties thereof \\n- dct:contributor or subproperties thereof" ;
    rdfs:isDefinedBy onto: .

<http://vocab.getty.edu/ontology#UnknownPersonConcept> a owl:Class ;
    rdfs:label "UnknownPersonConcept" ;
    dcterms:description "Unknown person representing a nationality/culture (the Unknown People by Culture facet).\\nExample: 500355202 Unknown Bulgarian (modern) (ULAN)" ;
    rdfs:comment "Unknown person representing a nationality/culture (the Unknown People by Culture facet)" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.getty.edu/ontology#Subject>,
        skos:Concept ;
    skos:example "500355202 Unknown Bulgarian (modern) (ULAN)" .

<http://vocab.getty.edu/ontology#aat2000_related_to> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "2000" ;
    dc:title "related to - any" ;
    dcterms:description "any - related to - any; generic relationship, not explained.\\r\\nExample: gulf red is related to light red (pigment)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "gulf red is related to light red (pigment)" ;
    skos:prefLabel "aat2000_related_to" ;
    skos:scopeNote "generic relationship, not explained" .

<http://vocab.getty.edu/ontology#aat2001_formerly_referred_to> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "2001" ;
    dc:title "formerly referred to - any" ;
    dcterms:description "any - formerly referred - any.\\r\\nExample: gigues formerly referred to fiddles" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "gigues formerly referred to fiddles" ;
    skos:prefLabel "aat2001_formerly_referred_to" .

<http://vocab.getty.edu/ontology#aat2100_distinguished_from> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "2100" ;
    dc:title "distinguished from - any" ;
    dcterms:description "any - distinguished from - any.\\r\\nExample: historic farms are distinguished from abandoned farms; naive art is distinguished from outsider art" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "historic farms are distinguished from abandoned farms",
        "naive art is distinguished from outsider art" ;
    skos:prefLabel "aat2100_distinguished_from" .

<http://vocab.getty.edu/ontology#aat2110_meaning-usage_overlaps_with> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "2110" ;
    dc:title "meaning/usage overlaps with - any" ;
    dcterms:description "any - meaning/usage overlaps with - any.\\r\\nExample: chimney hoods has meaning/usage that overlaps with chimney caps; scribes has meaning/usage that overlaps with copyists" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "chimney hoods has meaning/usage that overlaps with chimney caps",
        "scribes has meaning/usage that overlaps with copyists" ;
    skos:prefLabel "aat2110_meaning-usage_overlaps_with" .

<http://vocab.getty.edu/ontology#aat2203_associated_with> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "2203" ;
    dc:title "associated with - activity/event" ;
    dcterms:description "activity/event/[process/function] - [is] associated with - activity/event/[process/function].\\r\\nExample: Easter is associated with Lent; cavalry exercises are associated with dressage" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "Easter is associated with Lent",
        "cavalry exercises are associated with dressage" ;
    skos:prefLabel "aat2203_associated_with" .

<http://vocab.getty.edu/ontology#aat2205_causes-is_required> a owl:ObjectProperty ;
    dc:identifier "2205" ;
    dc:title "causes/is required - activity/event" ;
    dcterms:description "activity/event/[process/function] - causes/is required for - activity/event/[process/function].\\r\\nExample: on-demand printing causes/is required for on-demand publishing;  preserving causes/is required for preservation" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#aat2206_caused_by-requires> ;
    skos:example "on-demand printing causes/is required for on-demand publishing",
        "preserving causes/is required for preservation" ;
    skos:prefLabel "aat2205_causes-is_required" .

<http://vocab.getty.edu/ontology#aat2208_locus-setting_for> a owl:ObjectProperty ;
    dc:identifier "2208" ;
    dc:title "locus/setting for - things" ;
    dcterms:description "locus/setting - [is] locus/setting for - things.\\r\\nExample: glassworks (buildings) are the locus/setting for glassware; caves are the locus/setting for cave paintings" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#aat2209_used-located_in> ;
    skos:example "caves are the locus/setting for cave paintings",
        "glassworks (buildings) are the locus/setting for glassware" ;
    skos:prefLabel "aat2208_locus-setting_for" .

<http://vocab.getty.edu/ontology#aat2211_produce> a owl:ObjectProperty ;
    dc:identifier "2211" ;
    dc:title "produce - things" ;
    dcterms:description "things/[equipment] - produce - things.\\r\\nExample: stereoscopic cameras produce stereoscopic photographs; punches (marking tools) produce punchwork" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#aat2212_produced_by> ;
    skos:example "punches (marking tools) produce punchwork",
        "stereoscopic cameras produce stereoscopic photographs" ;
    skos:prefLabel "aat2211_produce" .

<http://vocab.getty.edu/ontology#aat2215_required_for> a owl:ObjectProperty ;
    dc:identifier "2215" ;
    dc:title "required for - things" ;
    dcterms:description "things - [are] required for -  things.\\r\\nExample: eyelets are required for broderie anglaise; compact discs are required for compact disc players" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#aat2216_require> ;
    skos:example "compact discs are required for compact disc players",
        "eyelets are required for broderie anglaise" ;
    skos:prefLabel "aat2215_required_for" .

<http://vocab.getty.edu/ontology#aat2218_used-function_as> a owl:ObjectProperty ;
    dc:identifier "2218" ;
    dc:title "used/function as - things" ;
    dcterms:description "things - [are] used/function as - things.\\r\\nExample: arc lamps are used/function as lighthouse lamps;  toile peinte is used/function as cartoons (working drawings)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#aat2219_have_form> ;
    skos:example "arc lamps are used/function as lighthouse lamps",
        "toile peinte is used/function as cartoons (working drawings)" ;
    skos:prefLabel "aat2218_used-function_as" .

<http://vocab.getty.edu/ontology#aat2221_act_upon> a owl:ObjectProperty ;
    dc:identifier "2221" ;
    dc:title "act upon - genus/species" ;
    dcterms:description "[actors having] role - act upon - genus/species.\\r\\nExample: jockeys act upon Equus caballus(species); tappers act upon Acer saccharum(species)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#aat2222_are_acted_upon> ;
    skos:example "jockeys act upon Equus caballus(species)",
        "tappers act upon Acer saccharum(species)" ;
    skos:prefLabel "aat2221_act_upon" .

<http://vocab.getty.edu/ontology#aat2281_have_counterpart> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "2281" ;
    dc:title "have counterpart - role" ;
    dcterms:description "role -[is] counterpart to - role.\\r\\nExample: duchesses have counterpart dukes; godesses have counterpart gods" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "duchesses have counterpart dukes",
        "godesses have counterpart gods" ;
    skos:prefLabel "aat2281_have_counterpart" .

<http://vocab.getty.edu/ontology#aat2285_practiced-studied_by> a owl:ObjectProperty ;
    dc:identifier "2285" ;
    dc:title "practiced/studied by - role" ;
    dcterms:description "field [of study, genre]/discipline - [is] practiced/studied by - a role.\\r\\nExample: Egyptology is practiced/studied by Egyptologists; architectural history is practiced/studied by architectural historians" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#aat2286_practice-study> ;
