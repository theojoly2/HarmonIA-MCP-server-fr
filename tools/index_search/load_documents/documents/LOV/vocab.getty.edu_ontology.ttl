<http://vocab.getty.edu/ontology#Biography> a owl:Class ;
    rdfs:comment "Biography of a ULAN agent (schema:Person|Organization). Depending on the agent, has these fields:\\n- schema:description: one-line-biography\\n- gvp:estStart\\n- schema:birthPlace | foundationLocation, pointing to TGN\\n- gvp:estEnd\\n- schema:deathPlace | dissolutionLocation, pointing to TGN\\n- schema:gender, pointing to AAT (male, female, other)\\n- dct:contributor\\nThe fields of the preferred biogrpahy are also available in the agent." ;
    rdfs:isDefinedBy onto: .

<http://vocab.getty.edu/ontology#GuideTerm> a owl:Class ;
    rdfs:label "GuideTerm" ;
    dcterms:description "Guide Term: place holder to create a level in the hierarchy. Used in AAT and ULAN. Not used for indexing or cataloguing..\\nExample: <vessels for serving and consuming food> (AAT), ulan:500353455 <named animals> under facet Non-Artists (ULAN)" ;
    rdfs:comment "Guide Term: place holder to create a level in the hierarchy. Used in AAT and ULAN. Not used for indexing or cataloguing." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/iso25964/skos-thes#ThesaurusArray>,
        <http://vocab.getty.edu/ontology#Subject> ;
    skos:example "<vessels for serving and consuming food> (AAT), ulan:500353455 <named animals> under facet Non-Artists (ULAN)" .

<http://vocab.getty.edu/ontology#biography> a owl:ObjectProperty ;
    rdfs:label "biography" ;
    dcterms:description "Biography of an ULAN agent. Domain is schema:Person/Organization, range is gvp:Biography. The preferred biography fields are also directly available in the Person/Organization" ;
    rdfs:comment "Biography of an ULAN agent. Domain is schema:Person/Organization, range is gvp:Biography. The preferred biography fields are also directly available in the Person/Organization" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.getty.edu/ontology#Biography> ;
    rdfs:subPropertyOf <http://vocab.getty.edu/ontology#biography> .

<http://vocab.getty.edu/ontology#broaderGenericExtended> a owl:ObjectProperty ;
    rdfs:label "broaderGenericExtended" ;
    dcterms:description "Ancestors (Generic). Meaningful closure of gvp:broaderGeneric. Infers iso:broaderGeneric for pairs of directly related skos:Concepts.\\nExample: <anvils and anvil accessories> BTG <forging and metal-shaping tools> BTG <forging and metal-shaping equipment>,\\nso <anvils and anvil accessories> BTGE <forging and metal-shaping equipment>" ;
    rdfs:comment "Ancestors (Generic). Meaningful closure of gvp:broaderGeneric. Infers iso:broaderGeneric for pairs of directly related skos:Concepts" ;
    rdfs:domain <http://vocab.getty.edu/ontology#Subject> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.getty.edu/ontology#Subject> ;
    rdfs:subPropertyOf <http://vocab.getty.edu/ontology#broaderExtended> ;
    owl:propertyChainAxiom ( <http://vocab.getty.edu/ontology#broaderGenericExtended> <http://vocab.getty.edu/ontology#broaderGeneric> ) ;
    skos:example "<anvils and anvil accessories> BTG <forging and metal-shaping tools> BTG <forging and metal-shaping equipment>,\\nso <anvils and anvil accessories> BTGE <forging and metal-shaping equipment>" .

<http://vocab.getty.edu/ontology#broaderInstantialExtended> a owl:ObjectProperty ;
    rdfs:label "broaderInstantialExtended" ;
    dcterms:description "Ancestors (Instantial). Meaningful closure of gvp:broaderInstantial. Infers iso:broaderInstantial for pairs of directly related skos:Concepts." ;
    rdfs:domain <http://vocab.getty.edu/ontology#Subject> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.getty.edu/ontology#Subject> ;
    rdfs:subPropertyOf <http://vocab.getty.edu/ontology#broaderExtended> ;
    owl:propertyChainAxiom ( <http://vocab.getty.edu/ontology#broaderInstantialExtended> <http://vocab.getty.edu/ontology#broaderGeneric> ) ;
    skos:example "Mt Athos (TGN) BTI orthodox religious center (AAT) BTG Christian religious center (AAT),\\nso Mt Athos (TGN) BTIE Christian religious center (AAT)" .

<http://vocab.getty.edu/ontology#broaderPreferredExtended> a owl:ObjectProperty ;
    rdfs:label "broaderPreferredExtended" ;
    dcterms:description "Preferred Ancestors. Meaningful closure of gvp:broaderPreferred. Needed to display the hierarchy.\\nExample: Mt Athos has preferred ancestor places (BTPE) World, Europe, Greece, Macedonia, Pangaíon Óros regional division;\\nand prefererd place type (BTIE) inhabited place" ;
