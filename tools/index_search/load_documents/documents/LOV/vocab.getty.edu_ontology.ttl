<http://vocab.getty.edu/ontology#tgn3000_related_to> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "3000" ;
    dc:title "related to - any" ;
    dcterms:description "any - related to - any.\\r\\nExample: Fountains Abbey is related to Studley Royal; Austria-Hungary is related to Magyarorszag" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "Austria-Hungary is related to Magyarorszag",
        "Fountains Abbey is related to Studley Royal" ;
    skos:prefLabel "tgn3000_related_to" .

<http://vocab.getty.edu/ontology#tgn3001_distinguished_from> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "3001" ;
    dc:title "distinguished from - any" ;
    dcterms:description "any - distinguished from - any.\\r\\nExample: The Ancient Mesopotamian Kingdom 'Assyria' is distinguished from the Roman Province of the same name" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "The Ancient Mesopotamian Kingdom 'Assyria' is distinguished from the Roman Province of the same name" ;
    skos:prefLabel "tgn3001_distinguished_from" .

<http://vocab.getty.edu/ontology#tgn3005_possibly_identified_as> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "3005" ;
    dc:title "possibly identified as - place" ;
    dcterms:description "place - possibly identified as - place.\\r\\nExample: The lost settlement of Sharuhen is possibly identified as Tel el-Far'ah (As Suwayda', Syria) (deserted settlement)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "The lost settlement of Sharuhen is possibly identified as Tel el-Far'ah (As Suwayda', Syria) (deserted settlement)" ;
    skos:prefLabel "tgn3005_possibly_identified_as" .

<http://vocab.getty.edu/ontology#tgn3006_formerly_identified_as> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "3006" ;
    dc:title "formerly identified as - place" ;
    dcterms:description "place - formerly identified as - place; New.\\r\\nExample: The deserted settlement of Machupicchu was formerly identified as Tampu Tocco" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "The deserted settlement of Machupicchu was formerly identified as Tampu Tocco" ;
    skos:prefLabel "tgn3006_formerly_identified_as" ;
    skos:scopeNote "New" .

<http://vocab.getty.edu/ontology#tgn3101_near-adjacent_to> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "3101" ;
    dc:title "near/adjacent to - any" ;
    dcterms:description "any - near/adjacent to - any.\\r\\nExample: Saint Paul (Minnesota, USA), is linked to its 'Twin City' Minneapolis (Hennepin county, Minnesota, USA)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "Saint Paul (Minnesota, USA), is linked to its 'Twin City' Minneapolis (Hennepin county, Minnesota, USA)" ;
    skos:prefLabel "tgn3101_near-adjacent_to" .

<http://vocab.getty.edu/ontology#tgn3102_coextensive_with> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "3102" ;
    dc:title "coextensive with - place" ;
    dcterms:description "place - coextensive with - place.\\r\\nExample: Kings county (New York, USA) is coextensive with Brooklyn (New York, USA)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "Kings county (New York, USA) is coextensive with Brooklyn (New York, USA)" ;
    skos:prefLabel "tgn3102_coextensive_with" .

<http://vocab.getty.edu/ontology#tgn3110_meaning-usage_overlaps_with> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "3110" ;
    dc:title "meaning/usage overlaps with - any" ;
    dcterms:description "any - meaning/usage overlaps with - any.\\r\\nExample: Judaea (Israel) (historical region) meaning/usage overlaps with Holy Land (Asia) (historical region)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "Judaea (Israel) (historical region) meaning/usage overlaps with Holy Land (Asia) (historical region)" ;
    skos:prefLabel "tgn3110_meaning-usage_overlaps_with" .

<http://vocab.getty.edu/ontology#tgn3201_capital_of> a owl:ObjectProperty ;
    dc:identifier "3201" ;
    dc:title "capital of - nation" ;
    dcterms:description "city - capital of - nation.\\r\\nExample: Thecapital of Maxima Caesariensis from 296 to 800 CE was London" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#tgn3202_capital_is> ;
    skos:example "Thecapital of Maxima Caesariensis from 296 to 800 CE was London" ;
    skos:prefLabel "tgn3201_capital_of" .

<http://vocab.getty.edu/ontology#tgn3301_ally_of> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "3301" ;
    dc:title "ally of - nation" ;
    dcterms:description "nation - ally of - nation.\\r\\nExample: Siena, Arezzo, Pisa, and Pistoia were Ghibeline allies during the 13th and 14th centuries." ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "Siena, Arezzo, Pisa, and Pistoia were Ghibeline allies during the 13th and 14th centuries." ;
    skos:prefLabel "tgn3301_ally_of" .

<http://vocab.getty.edu/ontology#tgn3317_member_of> a owl:ObjectProperty ;
    dc:identifier "3317" ;
    dc:title "member of - union" ;
    dcterms:description "nation - member of - union.\\r\\nExample: Austria is a member of the European Union since 1915; Belgium is a member of the European Union since 1958" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#tgn3318_member_is> ;
    skos:example "Austria is a member of the European Union since 1915",
        "Belgium is a member of the European Union since 1958" ;
    skos:prefLabel "tgn3317_member_of" .

<http://vocab.getty.edu/ontology#tgn3401_moved_from> a owl:ObjectProperty ;
    dc:identifier "3401" ;
    dc:title "moved from - place" ;
    dcterms:description "place - moved from - place; Note: places that were physically moved from one location to another, often due to the threat or occurrence of natural disaster..\\r\\nExample: Troupville, Georgia, USA was moved to Valdosta (Lowndes county, Georgia, USA)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    owl:inverseOf <http://vocab.getty.edu/ontology#tgn3402_moved_to> ;
    skos:example "Troupville, Georgia, USA was moved to Valdosta (Lowndes county, Georgia, USA)" ;
    skos:prefLabel "tgn3401_moved_from" ;
    skos:scopeNote "Note: places that were physically moved from one location to another, often due to the threat or occurrence of natural disaster." .

<http://vocab.getty.edu/ontology#tgn3411_successor_of> a owl:ObjectProperty ;
    dc:identifier "3411" ;
    dc:title "successor of - nation" ;
    dcterms:description "nation - successor of - nation.\\r\\nExample: Iran (nation) is the successor of Persia" ;
