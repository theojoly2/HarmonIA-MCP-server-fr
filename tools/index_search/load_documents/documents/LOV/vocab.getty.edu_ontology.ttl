<http://rdaregistry.info/termList/gender/1001> a owl:NamedIndividual .

<http://rdaregistry.info/termList/gender/1002> a owl:NamedIndividual .

<http://schema.org/Place> a owl:Class .

<http://vocab.getty.edu/ontology#aat2206_caused_by-requires> a owl:ObjectProperty ;
    dc:identifier "2206" ;
    dc:title "caused by/requires - activity/event" ;
    dcterms:description "activity/event/[process/function] - [is] caused by/dependent upon - activity/event/[process/function].\\r\\nExample: on-demand publishing is caused by/requires on-demand printing; preservation is caused by/requires preserving" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "on-demand publishing is caused by/requires on-demand printing",
        "preservation is caused by/requires preserving" ;
    skos:prefLabel "aat2206_caused_by-requires" .

<http://vocab.getty.edu/ontology#aat2209_used-located_in> a owl:ObjectProperty ;
    dc:identifier "2209" ;
    dc:title "used/located in - locus/setting" ;
    dcterms:description "things -used/located in -  locus/setting.\\r\\nExample: glassware is used/located in glassworks (buildings); cave paintings are located in caves" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "cave paintings are located in caves",
        "glassware is used/located in glassworks (buildings)" ;
    skos:prefLabel "aat2209_used-located_in" .

<http://vocab.getty.edu/ontology#aat2212_produced_by> a owl:ObjectProperty ;
    dc:identifier "2212" ;
    dc:title "produced by - things" ;
    dcterms:description "things - [are] produced by - things/[equipment].\\r\\nExample: stereoscopic photographs are produced by stereoscopic cameras; punchwork is produced by punches (marking tools)" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "punchwork is produced by punches (marking tools)",
        "stereoscopic photographs are produced by stereoscopic cameras" ;
    skos:prefLabel "aat2212_produced_by" .

<http://vocab.getty.edu/ontology#aat2216_require> a owl:ObjectProperty ;
    dc:identifier "2216" ;
    dc:title "require - things" ;
    dcterms:description "things - require - things [in order to exist or work].\\r\\nExample: broderie anglaise requires eyelets; compact disc players require compact discs" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "broderie anglaise requires eyelets",
        "compact disc players require compact discs" ;
    skos:prefLabel "aat2216_require" .

<http://vocab.getty.edu/ontology#aat2219_have_form> a owl:ObjectProperty ;
    dc:identifier "2219" ;
    dc:title "have form - things" ;
    dcterms:description "things - have form [of] - things.\\r\\nExample: lighthouse lamps have the form of arc lamps; cartoons (working drawings) have the form of toile peinte" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "cartoons (working drawings) have the form of toile peinte",
        "lighthouse lamps have the form of arc lamps" ;
    skos:prefLabel "aat2219_have_form" .

<http://vocab.getty.edu/ontology#aat2222_are_acted_upon> a owl:ObjectProperty ;
    dc:identifier "2222" ;
    dc:title "are acted upon - role" ;
    dcterms:description "genus/species - is acted upon [by] - [actors having] role.\\r\\nExample: Equus caballus(species) is acted upon by jockeys; Acer saccharum(species) is acted upon by tappers" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "Acer saccharum(species) is acted upon by tappers",
        "Equus caballus(species) is acted upon by jockeys" ;
    skos:prefLabel "aat2222_are_acted_upon" .

<http://vocab.getty.edu/ontology#aat2286_practice-study> a owl:ObjectProperty ;
    dc:identifier "2286" ;
    dc:title "practice/study - field/discipline" ;
    dcterms:description "[actor having] role - practice/study - field [of study, genre]/discipline.\\r\\nExample: Egyptologists practice/study Egyptology; architectural historians practice/study architectural history" ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf skos:related ;
    skos:example "Egyptologists practice/study Egyptology",
        "architectural historians practice/study architectural history" ;
    skos:prefLabel "aat2286_practice-study" .

<http://vocab.getty.edu/ontology#aat2292_work-live_in> a owl:ObjectProperty ;
    dc:identifier "2292" ;
    dc:title "work/live in - locus/setting" ;
    dcterms:description "[actor or institution having] role - work/live/[exist] in - locus/setting.\\r\\nExample: rope-makers live/work in roperies; nuns live/work in convents (nunneries); libraries (institutions) live/work in libraries (buildings)" ;
    rdfs:domain skos:Concept ;
