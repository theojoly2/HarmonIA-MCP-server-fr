    skos:prefLabel "tgn3611_administrative_dependent_of" ;
    skos:scopeNote "New" .

<http://vocab.getty.edu/ontology#ulan1000_related_to> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dc:identifier "1000" ;
    dc:title "related to - any" ;
    dcterms:description "any - related to - any.\\r\\nExample: Frank Lloyd Wright is related to Francis Conroy Sullivan; Herman Miller, Inc. is related to Irving Harper; National Endowment for the Humanities is related to Connecticut Humanities Council" ;
