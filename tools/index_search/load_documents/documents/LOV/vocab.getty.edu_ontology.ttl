    rdfs:range <http://vocab.getty.edu/ontology#Subject> ;
    rdfs:subPropertyOf <http://vocab.getty.edu/ontology#broaderExtended> ;
    owl:propertyChainAxiom ( <http://vocab.getty.edu/ontology#broaderPartitiveExtended> <http://vocab.getty.edu/ontology#broaderPartitive> ),
        ( <http://vocab.getty.edu/ontology#broaderGeneric> <http://vocab.getty.edu/ontology#broaderPartitiveExtended> ),
        ( <http://vocab.getty.edu/ontology#broaderPartitiveExtended> <http://vocab.getty.edu/ontology#broaderGeneric> ) ;
    skos:example "anvil components BTP <anvils and anvil accessories> BTG <forging and metal-shaping tools>,\\nso anvil components BTPE <forging and metal-shaping tools>" .

<http://vocab.getty.edu/term/POS/> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Part of Speech concept scheme" ;
    dcterms:description "Part of Speech concept scheme" ;
    rdfs:isDefinedBy onto: .

<http://vocab.getty.edu/ontology#broader> a owl:ObjectProperty ;
    rdfs:label "broader" ;
    dcterms:description "Parents of a subject. Each broader is also Preferred|NonPreferred and Partitive|Instantial|Generic" ;
    rdfs:comment "Parents of a subject. Each broader is also Preferred|NonPreferred and Partitive|Instantial|Generic" ;
    rdfs:domain <http://vocab.getty.edu/ontology#Subject> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.getty.edu/ontology#Subject> .

<http://vocab.getty.edu/term/kind/> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Term Kind concept scheme" ;
    dcterms:description "Term Kind concept scheme" ;
    rdfs:isDefinedBy onto: .

<http://vocab.getty.edu/ontology#Subject> a owl:Class ;
    rdfs:label "Subject" ;
    dcterms:description "Node in a GVP vocabulary hierarchy. \\nMay be Facet, GuideTerm, Hierarchy, Concept, AdminPlaceConcept, PhysPlaceConcept, PhysAdminPlaceConcept, or ObsoleteSubject.\\nImplemented as skos:Concept or iso:ThesaurusArray and skos:Collection" ;
    rdfs:comment "Node in a GVP vocabulary hierarchy. \\nMay be Facet, GuideTerm, Hierarchy, Concept, AdminPlaceConcept, PhysPlaceConcept, PhysAdminPlaceConcept, or ObsoleteSubject.\\nImplemented as skos:Concept or iso:ThesaurusArray and skos:Collection" ;
    rdfs:isDefinedBy onto: .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual,
        owl:Ontology ;
    rdfs:label "Getty Vocabulary Program ontology" ;
    dcterms:created "2014-02-15"^^xsd:date ;
    dcterms:creator <http://www.getty.edu/research/>,
        <http://www.ontotext.com> ;
    dcterms:modified "2015-03-25"^^xsd:date ;
    vann:preferredNamespacePrefix "gvp" ;
    vann:preferredNamespaceUri "http://vocab.getty.edu/ontology#" ;
    rdfs:comment "The GVP Ontology defines classes, properties and values (skos:Concepts) used in GVP LOD.\\nAs of version 3.0, it is complete regarding AAT, TGN and ULAN, and will be extended in time with more elements needed for other GVP vocabularies (CONA).\\nIt uses the SKOS, SKOS-XL, ISO 25964; DC, DCT, BIBO, FOAF, BIO, Schema, PROV, WGS84 ontologies, but we import only the first 3" ;
    rdfs:seeAlso <http://lov.okfn.org/dataset/lov/details/vocabulary_gvp.html>,
        <http://vocab.getty.edu/.well-known/void>,
        <http://vocab.getty.edu/doc>,
        <http://vocab.getty.edu/doc/queries>,
        <http://www.getty.edu/research/tools/vocabularies/lod/> ;
    owl:imports <http://purl.org/iso25964/skos-thes>,
        <http://www.w3.org/2004/02/skos/core>,
        <http://www.w3.org/2008/05/skos-xl> ;
    owl:versionInfo "3.0" ;
    skos:changeNote <http://vocab.getty.edu/doc#Version_2.0>,
        <http://vocab.getty.edu/doc#Version_3.0>,
        "2.0 changes: replaced gvp:broaderTransitive with gvp:broaderExtended;\\n3.0 changes: replaced schema:startDate, endDate with gvp:estStart, estEnd; added ULAN). See details in referenced links" .

