<http://vocab.getty.edu/ontology#prefLabelGVP> a owl:ObjectProperty ;
    rdfs:label "prefLabelGVP" ;
    dcterms:description "Term preferred by the Getty Vocabulary Program. The language is usually English. Applicable to AAT, ULAN, TGN. Used with skosxl:prefLabel" ;
    rdfs:comment "Term preferred by the Getty Vocabulary Program. The language is usually English. Applicable to AAT, ULAN, TGN. Used with skosxl:prefLabel" ;
