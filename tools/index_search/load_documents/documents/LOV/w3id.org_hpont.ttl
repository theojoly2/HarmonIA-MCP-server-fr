@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://purl.org/ontology/bibo/> .
@prefix ns2: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix onto: <https://w3id.org/hpont> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns3:license a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

ns1:status a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

ns2:term_status a owl:AnnotationProperty .

onto: a owl:Ontology ;
    ns3:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:created "2021-08-04"^^xsd:string ;
    dcterms:creator "Iker Esnaola-Gonzalez <mailto:iker.esnaola@tekniker.es>"^^xsd:string ;
    dcterms:description "The Heat Pump Ontology"^^xsd:string,
        "The Heat Pump Ontology (HPOnt) aims to formalize and represent all the relevant information of Heat Pumps.\\n\\nThe HPOnt has been developed as part of the REACT project which has received funding from the European Union’s Horizon 2020 research and innovation programme under grant agreement no. 824395."@en ;
    dcterms:issued "2021-08-19"^^xsd:string ;
    dcterms:title "The Heat Pump Ontology (HPOnt)."@en ;
    ns1:status "Work in Progress"@en ;
    vann:preferredNamespacePrefix "hpont"^^xsd:string ;
    vann:preferredNamespaceUri <https://w3id.org/hpont#> ;
    owl:versionInfo 0.2 .

<https://w3id.org/hpont#dhwHeatingMode> a owl:NamedIndividual,
        <https://w3id.org/hpont#HeatPumpOperatingMode> ;
    rdfs:label "DHW heating mode"@en ;
    ns1:status "testing"^^xsd:string ;
    rdfs:comment "DHW heating operation mode of the Heat Pump"@en ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> .

<https://w3id.org/hpont#hasBufferStorageVolume> a owl:DatatypeProperty ;
    rdfs:label "has Buffer Storage Volume"@en ;
    rdfs:comment "Buffer storage volume of the Heat Pump. Buffer storage is thermal energy storage using a tank for the circulating heat transfer fluid of the Heat Pump"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasDHWStorageVolume> a owl:DatatypeProperty ;
    rdfs:label "has DHW Storage Volume"@en ;
    rdfs:comment "DHW (Domestic Hot Water) storage volume of the Heat Pump. DHW storage is a tank that contains clean potable water for household hot water consumption"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasNominalCoolingCapacity> a owl:DatatypeProperty ;
    rdfs:label "has Nominal Cooling Capacity"@en ;
    rdfs:comment "Nominal cooling capacity of the Heat Pump"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasNominalHeatingCapacity> a owl:DatatypeProperty ;
    rdfs:label "has Nominal Heating Capacity"@en ;
    rdfs:comment "Nominal heating capacity of the Heat Pump"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasNominalPowerConsumptionInCoolingMode> a owl:DatatypeProperty ;
    rdfs:label "has Nominal Power Consumption In Cooling Mode"@en ;
    rdfs:comment "Nominal power consumption of the Heat Pump when it is in cooling mode"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasNominalPowerConsumptionInHeatingMode> a owl:DatatypeProperty ;
    rdfs:label "has Nominal Power Consumption In Heating Mode"@en ;
    rdfs:comment "Nominal power consumption of the Heat Pump when it is in heating mode"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasNumberOfIndoorUnits> a owl:DatatypeProperty ;
    rdfs:label "has Number Of Indoor Units"@en ;
    rdfs:comment "Number of indoor units that the Heat Pump has"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    rdfs:range xsd:integer ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasNumberOfOutdoorUnits> a owl:DatatypeProperty ;
    rdfs:label "has Number Of Outdoor Units"@en ;
    rdfs:comment "Number of outdoor units that the Heat Pump has"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    rdfs:range xsd:integer ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasOutdoorModelUnitName> a owl:DatatypeProperty ;
    rdfs:label "has Outdoor Model Unit Name"@en ;
    rdfs:comment "Name of the oudoor model unit"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    rdfs:range xsd:string ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasPowerSupplyType> a owl:DatatypeProperty ;
    rdfs:label "has Power Supply Type"@en ;
    rdfs:comment "Electric power supply type of the Heat Pump System"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#spaceCoolingMode> a owl:NamedIndividual,
        <https://w3id.org/hpont#HeatPumpOperatingMode> ;
    rdfs:label "Space cooling mode"@en ;
    ns1:status "testing"^^xsd:string ;
    rdfs:comment "Space cooling operation mode of the Heat Pump"@en ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> .

<https://w3id.org/hpont#spaceHeatingMode> a owl:NamedIndividual,
        <https://w3id.org/hpont#HeatPumpOperatingMode> ;
    rdfs:label "Space heating mode"@en ;
    ns1:status "testing"^^xsd:string ;
    rdfs:comment "Space heating operation mode of the Heat Pump"@en ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

<https://w3id.org/hpont#ata> a owl:NamedIndividual,
        <https://w3id.org/hpont#HeatPumpTechnology> ;
    rdfs:label "air-to-air"@en ;
    ns1:status "testing"^^xsd:string ;
    rdfs:comment "Air-to-air Heat Pump technology."@en ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> .

<https://w3id.org/hpont#atw> a owl:NamedIndividual,
        <https://w3id.org/hpont#HeatPumpTechnology> ;
    rdfs:label "air-to-water"@en ;
    ns1:status "testing"^^xsd:string ;
    rdfs:comment "Air-to-water Heat Pump technology"@en ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> .

<https://w3id.org/hpont#hasOperatingModeAvailable> a owl:ObjectProperty ;
    rdfs:label "has Operating Mode Available"@en ;
    rdfs:comment "Operating modes available for the Heat Pump"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    rdfs:range <https://w3id.org/hpont#HeatPumpOperatingMode> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#hasTechnology> a owl:ObjectProperty ;
    rdfs:label "has Technology"@en ;
    rdfs:comment "Base technology of a given Heat Pump"@en ;
    rdfs:domain <https://w3id.org/hpont#HeatPumpSystem> ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    rdfs:range <https://w3id.org/hpont#HeatPumpTechnology> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#HeatPumpTechnology> a owl:Class ;
    rdfs:label "Heat Pump Technology"@en ;
    rdfs:comment "The base technology of a given Heat Pump system"@en ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#HeatPumpOperatingMode> a owl:Class ;
    rdfs:label "Heat Pump Operating Mode"@en ;
    rdfs:comment "The operating mode of a given Heat Pump system"@en ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <https://w3id.org/hpont#HeatPumpTechnology> ;
            owl:onProperty <https://w3id.org/hpont#hasTechnology> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/hpont#hasOperatingModeAvailable> ;
            owl:someValuesFrom <https://w3id.org/hpont#HeatPumpOperatingMode> ] ;
    ns2:term_status "testing"^^xsd:string .

<https://w3id.org/hpont#HeatPumpSystem> a owl:Class ;
    rdfs:label "Heat Pump System"@en ;
    rdfs:comment "A system composed of one or many devices that transfer heat from a colder area to a hotter area by using mechanical energy"@en ;
    rdfs:isDefinedBy <https://w3id.org/hpont#> ;
    ns2:term_status "stable"^^xsd:string .

<https://w3id.org/hpont#> a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual .

[] a owl:AllDifferent ;
    owl:distinctMembers ( <https://w3id.org/hpont#ata> <https://w3id.org/hpont#atw> ) .

