ns4:Ware a owl:Class ;
    rdfs:label "Ware"@en ;
    ns4:markdownDescription "The term \"Ware\" is used by archaeologists and collectors to identify any similar set of ceramic vessels, often by reference to some combination of the physical characteristics of the clay, surface treatment, overall shape, functional class, or place of manufacture. It is a common term in the field of archaeology. Usages include \"Halaf Ware\", a Sixth Millenium BC product of the Neolithic Halaf Culture of Northern Mesopotamia; \"Deptford Ware\" from England; \"African Red Slip\" a Roman period product from what is now the modern country of Tunisia; "@en ;
    ns1:plural "Wares"@en ;
    ns3:etag "\"7e358f56-84a8-4175-91d5-f4a62075c089\"" ;
    rdfs:comment "Generic term for category of ceramics that may be distinguished by function, surface treatment, distinguishing features of clay, or other set of criteria as defined by usage. Commonly used in the discipline of Archaeology."@en ;
    rdfs:isDefinedBy onto: ;
    ns2:term_status "unstable" ;
    ns2:userdocs ns4:Ware.html .

