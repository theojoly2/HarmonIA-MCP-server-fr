    ns1:plural "Compass Directions"@en ;
    ns3:etag "\"b2a1a580-f238-49af-95ca-fd0bb0798a67\"" ;
    rdfs:comment "The Compass Direction that a Thing faces."@en ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    ns2:term_status "unstable" ;
    ns2:userdocs ns4:compassDirection.html .

