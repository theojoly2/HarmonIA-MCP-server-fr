    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns4:OlympicGames ;
    owl:disjointWith ns4:SummerOlympicGames ;
    ns2:term_status "unstable" ;
    ns2:userdocs ns4:WinterOlympicGames.html .

