@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#valueAssignment> a owl:ObjectProperty ;
    rdfs:label "value assignment method"^^xsd:string ;
    rdfs:comment "property that can be attached to any statement to support a link to the evidence for the value"^^xsd:string ;
    rdfs:domain rdf:Statement .

<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> a rdfs:Datatype ;
    rdfs:label "ISO Class name"^^xsd:string ;
    rdfs:comment "A datatype for skos:notation annotations, used to indicate the original UML class name"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDataType xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[A-Z]\\\\w*"^^xsd:string ] ) ] .

<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#constraint> a owl:AnnotationProperty ;
    rdfs:label "UML constraint"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#isAbstract> a owl:AnnotationProperty ;
    rdfs:label "UML abstract class"^^xsd:string ;
    rdfs:comment "This property indicates whether the class was flagged 'abstract' in the UML model. Abstract classes cannot be instantiated directly. Concrete subclasses may be instantiated."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#isStereotype> a owl:AnnotationProperty ;
    rdfs:label "ISO stereotype flag"^^xsd:string ;
    rdfs:comment "This property indicates if the class corresponds to a UML stereotype "^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#tag> a owl:AnnotationProperty ;
    rdfs:label "UML tagged value"^^xsd:string ;
    rdfs:comment "OWL property that links to a tagged value"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#TaggedValue> .

<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ttag> a owl:DatatypeProperty ;
    rdfs:label "UML tagged value tag"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#TaggedValue> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#tvalue> a owl:DatatypeProperty ;
    rdfs:label "UML tagged value value"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#TaggedValue> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#TaggedValue> a owl:Class ;
    rdfs:label "UML tagged value structure"^^xsd:string ;
    rdfs:comment "Class for UML tagged values"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#tvalue> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ttag> ] .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    dc:contributor "ISO/TC 211 Project Team 19150-2"^^xsd:string ;
    dc:creator "Simon J D COX\\nCSIRO Australia"^^xsd:string ;
    dc:description "This ontology establishes classes corresponding to stereotypes used in ISO-conformant models, as used in the rules for conversion of the ISO TC 211 Harmonized Model from the UML to OWL representations"^^xsd:string ;
    dc:rights "Copyright © 2012-2013 CSIRO"^^xsd:string ;
    dc:title "Ontology elements required for conversion of ISO/TC 211 Harmonized Model to OWL"^^xsd:string ;
    dcterms:created "2012-06-04T00:00:00"^^xsd:dateTime ;
    dcterms:hasPart <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>,
        <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#TaggedValue>,
        <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#constraint>,
        <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#isAbstract>,
        <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#isStereotype>,
        <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#tag>,
        <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ttag>,
        <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#tvalue> ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:modified "2014-01-07T00:00:00"^^xsd:dateTime ;
    vann:preferredNamespacePrefix "h2o"^^xsd:string ;
    vann:preferredNamespaceUri <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#> ;
    rdfs:comment "This ontology establishes classes corresponding to stereotypes used in ISO-conformant models, as used in the rules for conversion of the ISO TC 211 Harmonized Model from the UML to OWL representations. \\n\\nThis vocabulary is provisional, pending finalization of ISO 19150-2.\\n\\nThe URI stem http://def.seegrid.csiro.au/isotc211/ is temporary. The vocabulary is expected to be ultimately published in the domain http://def.isotc211.org/ ."^^xsd:string ;
    owl:imports dc: ;
    owl:priorVersion <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201305/ISOTC211/HM/hm2owl.rdf> ;
    owl:versionIRI <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201311/ISOTC211/HM/iso19150/-2/2012/basic.rdf> .

