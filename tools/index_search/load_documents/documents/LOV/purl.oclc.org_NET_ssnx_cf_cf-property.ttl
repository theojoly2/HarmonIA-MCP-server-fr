<http://purl.oclc.org/NET/ssnx/cf/cf-property#thickness_of_rainfall_amount> a <http://purl.oclc.org/NET/ssnx/qu/dim#Distance> ;
    rdfs:label "thickness of rainfall amount" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#thickness> ;
    ns1:propertyType <http://purl.oclc.org/NET/ssnx/qu/quantity#scalar> ;
    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#rainfall> ;
