    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#ocean> ;
    dc:source "Climate and Forecast (CF)" ;
    rdfs:comment "The ocean meridional overturning streamfunction should not include not include \"bolus\" or Gent-McWilliams velocity." .

<http://purl.oclc.org/NET/ssnx/cf/cf-property#ocean_mixed_layer_thickness> a <http://purl.oclc.org/NET/ssnx/qu/dim#Distance> ;
    rdfs:label "ocean mixed layer thickness" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#thickness> ;
    ns1:propertyType <http://purl.oclc.org/NET/ssnx/qu/quantity#scalar> ;
    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#ocean_mixed_layer> ;
    dc:identifier "67" ;
    dc:source "Climate and Forecast (CF)" ;
    rdfs:comment "The ocean mixed layer is the upper part of the ocean, regarded as being well-mixed. Various criteria are used to define the mixed layer; this can be specified by using a standard name of ocean_mixed_layer_defined_byX." .

<http://purl.oclc.org/NET/ssnx/cf/cf-property#ocean_mixed_layer_thickness_defined_by_mixing_scheme> a <http://purl.oclc.org/NET/ssnx/qu/dim#Distance> ;
    rdfs:label "ocean mixed layer thickness defined by mixing scheme" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#thickness> ;
    ns1:propertyType <http://purl.oclc.org/NET/ssnx/qu/quantity#scalar_scalar> ;
    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#ocean_mixed_layer> ;
    dc:source "Climate and Forecast (CF)" ;
    rdfs:comment "The ocean mixed layer is the upper part of the ocean, regarded as being well-mixed. The base of the mixed layer defined by the mixing scheme is a diagnostic of ocean models." .

<http://purl.oclc.org/NET/ssnx/cf/cf-property#ocean_mixed_layer_thickness_defined_by_sigma_t> a <http://purl.oclc.org/NET/ssnx/qu/dim#Distance> ;
