    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#atmosphere> ;
    dc:source "Climate and Forecast (CF)" ;
    rdfs:comment "\"tendency_of_X\" means derivative of X with respect to time. \"X_area\" means the horizontal area occupied by X within the grid cell." .

<http://purl.oclc.org/NET/ssnx/cf/cf-property#tendency_of_atmosphere_mass_per_unit_area_due_to_advection> a <http://purl.oclc.org/NET/ssnx/qu/dim#MassPerTimePerArea> ;
