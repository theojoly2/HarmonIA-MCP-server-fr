<http://purl.oclc.org/NET/ssnx/cf/cf-property#atmosphere_ln_pressure_coordinate> a <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ;
    rdfs:label "atmosphere ln pressure coordinate" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#dimensionless> ;
