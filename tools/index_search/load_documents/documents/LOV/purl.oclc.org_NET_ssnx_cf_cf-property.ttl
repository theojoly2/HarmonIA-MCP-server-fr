<http://purl.oclc.org/NET/ssnx/cf/cf-property#surface_eastward_sea_water_velocity> a <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ;
    rdfs:label "surface eastward sea water velocity" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#velocity> ;
    ns1:propertyType <http://purl.oclc.org/NET/ssnx/qu/quantity#vector> ;
