    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#atmosphere> ;
    dc:source "Climate and Forecast (CF)" ;
    rdfs:comment "See Appendix D of the CF convention for information about dimensionless vertical coordinates." .

<http://purl.oclc.org/NET/ssnx/cf/cf-property#atmosphere_sleve_coordinate> a <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ;
    rdfs:label "atmosphere sleve coordinate" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#dimensionless> ;
