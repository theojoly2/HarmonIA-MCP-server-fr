<http://purl.oclc.org/NET/ssnx/cf/cf-property#mass_concentration_of_bromine_nitrate_in_air> a <http://purl.oclc.org/NET/ssnx/qu/dim#Density> ;
    rdfs:label "mass concentration of bromine nitrate in air" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#density> ;
    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#air> ;
