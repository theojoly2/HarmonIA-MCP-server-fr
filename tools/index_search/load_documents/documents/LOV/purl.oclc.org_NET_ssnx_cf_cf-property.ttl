<http://purl.oclc.org/NET/ssnx/cf/cf-property#atmosphere_moles_of_nitric_acid> a <http://purl.oclc.org/NET/ssnx/qu/dim#AmountOfSubstance> ;
    rdfs:label "atmosphere moles of nitric acid" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#amountOfSubstance> ;
    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#atmosphere> ;
