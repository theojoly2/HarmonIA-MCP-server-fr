<http://purl.oclc.org/NET/ssnx/cf/cf-property#atmosphere_horizontal_streamfunction> a <http://purl.oclc.org/NET/ssnx/qu/dim#DiffusionCoefficient> ;
    rdfs:label "atmosphere horizontal streamfunction" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#diffusionCoefficient> ;
    ns1:propertyType <http://purl.oclc.org/NET/ssnx/qu/quantity#scalar> ;
    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#atmosphere> ;
    dc:identifier "35" ;
    dc:source "Climate and Forecast (CF)" ;
    rdfs:comment "\"Horizontal\" indicates that the streamfunction applies to a horizontal velocity field on a particular vertical level." .

<http://purl.oclc.org/NET/ssnx/cf/cf-property#atmosphere_horizontal_velocity_potential> a <http://purl.oclc.org/NET/ssnx/qu/dim#DiffusionCoefficient> ;
    rdfs:label "atmosphere horizontal velocity potential" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#diffusionCoefficient> ;
    ns1:propertyType <http://purl.oclc.org/NET/ssnx/qu/quantity#scalar> ;
    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#atmosphere> ;
    dc:identifier "36" ;
    dc:source "Climate and Forecast (CF)" ;
    rdfs:comment "A velocity is a vector quantity. \"Horizontal\" indicates that the velocity potential applies to a horizontal velocity field on a particular vertical level." .

<http://purl.oclc.org/NET/ssnx/cf/cf-property#atmosphere_hybrid_height_coordinate> a <http://purl.oclc.org/NET/ssnx/qu/dim#Distance> ;
