<http://purl.oclc.org/NET/ssnx/cf/cf-property#northward_ocean_heat_transport_due_to_diffusion> a <http://purl.oclc.org/NET/ssnx/qu/dim#Power> ;
    rdfs:label "northward ocean heat transport due to diffusion" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#power> ;
