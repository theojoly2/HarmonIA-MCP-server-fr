<http://purl.oclc.org/NET/ssnx/cf/cf-property#ocean_volume_fraction> a <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ;
    rdfs:label "ocean volume fraction" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#dimensionless> ;
    ns1:propertyType <http://purl.oclc.org/NET/ssnx/qu/quantity#scalar> ;
