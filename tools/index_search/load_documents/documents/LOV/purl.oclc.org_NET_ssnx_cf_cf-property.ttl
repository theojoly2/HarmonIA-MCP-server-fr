    dc:identifier "48" ;
    dc:source "Climate and Forecast (CF)" ;
    rdfs:comment "Speed is the magnitude of velocity." .

<http://purl.oclc.org/NET/ssnx/cf/cf-property#sea_water_temperature> a <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ;
