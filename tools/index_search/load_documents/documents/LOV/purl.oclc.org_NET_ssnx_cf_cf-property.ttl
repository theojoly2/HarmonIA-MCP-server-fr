<http://purl.oclc.org/NET/ssnx/cf/cf-property#atmosphere_moles_of_hypochlorous_acid> a <http://purl.oclc.org/NET/ssnx/qu/dim#AmountOfSubstance> ;
    rdfs:label "atmosphere moles of hypochlorous acid" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#amountOfSubstance> ;
