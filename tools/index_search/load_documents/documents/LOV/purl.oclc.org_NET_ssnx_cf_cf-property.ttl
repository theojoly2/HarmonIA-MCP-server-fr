<http://purl.oclc.org/NET/ssnx/cf/cf-property#atmosphere_mass_content_of_bromine_monoxide> a <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ;
    rdfs:label "atmosphere mass content of bromine monoxide" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#surfaceDensity> ;
    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#atmosphere> ;
