<http://purl.oclc.org/NET/ssnx/cf/cf-property#atmosphere_mass_content_of_atomic_nitrogen> a <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ;
    rdfs:label "atmosphere mass content of atomic nitrogen" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#surfaceDensity> ;
