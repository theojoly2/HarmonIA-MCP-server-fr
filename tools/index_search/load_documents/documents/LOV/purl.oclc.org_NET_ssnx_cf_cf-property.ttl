    rdfs:label "tendency of middle atmosphere moles of methyl bromide" ;
    ns1:generalQuantityKind <http://purl.oclc.org/NET/ssnx/qu/quantity#molarFlux> ;
    ns2:isPropertyOf <http://purl.oclc.org/NET/ssnx/cf/cf-feature#middle_atmosphere> ;
