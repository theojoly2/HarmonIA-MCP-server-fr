            owl:someValuesFrom <http://mex.aksw.org/mex-algo#DecisionTrees> ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#LIONsolver> a owl:Class ;
