            owl:onClass <http://mex.aksw.org/mex-algo#DecisionTrees> ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#NN-BackPropagation> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

