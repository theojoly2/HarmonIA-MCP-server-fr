            owl:someValuesFrom <http://mex.aksw.org/mex-algo#DecisionTrees> ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#Linear> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#LinearRegression> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#RegressionAnalysis> .

<http://mex.aksw.org/mex-algo#Linear_Regression> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#Logistic_Regression> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

