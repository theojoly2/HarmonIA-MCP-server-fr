    rdfs:label "MOA"@en ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#Mathematica> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#MicrosoftAzureMachineLearning> a owl:Class ;
    rdfs:label "AZURE"@en ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#Microsoft_SQL_Server> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#MonteCarloMachineLearningLibrary> a owl:Class ;
