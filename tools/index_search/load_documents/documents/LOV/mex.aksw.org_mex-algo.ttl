<http://mex.aksw.org/mex-algo#PathKernel> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#Polynomial> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#PredictiveMethod> a owl:Class ;
    rdfs:comment "they are used to induce models or theories from class-labeled data"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://mex.aksw.org/mex-algo#Algorithm> [ a owl:Restriction ;
                        owl:onClass <http://mex.aksw.org/mex-algo#Supervised> ;
                        owl:onProperty <http://mex.aksw.org/mex-algo#hasLearningMethod> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

<http://mex.aksw.org/mex-algo#ProbabilisticSoftLogic> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#R-SVM> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
