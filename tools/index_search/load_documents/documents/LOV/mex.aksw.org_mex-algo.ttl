    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#Markov> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

