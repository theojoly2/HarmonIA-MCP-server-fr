@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix onto: <http://mex.aksw.org/mex-algo> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "The MEX Vocabulary (mex-algo)"@en ;
    dc:contributor "Diego Moussallem",
        "Jens Lehmann",
        "Julio Cesar Duarte",
        "Maria Claudia Cavalcanti Reis",
        "Markus Ackermann",
        "Ricardo Usbeck",
        "Sebastian Hellmann" ;
    dc:creator "Diego Esteves" ;
    dc:publisher "AKSW Research Group - Leipzig University"@en ;
    dcterms:created "2014-02-02"^^xsd:date ;
    dcterms:modified "2014-04-05"^^xsd:date ;
    dcterms:title "MEX Algorithm Ontology (mex-algo)"@en ;
    rdfs:comment "MEX is an RDF vocabulary designed to facilitate interoperability between published machine learning experiments results on the Web. The mex-algo layer represents the algorithm information existing into a basic machine learning experiment."@en ;
    owl:imports doap:,
        rdfs:,
        prov: ;
    owl:versionInfo "1.0.0" .

<http://mex.aksw.org/mex-algo#ADTree> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:someValuesFrom <http://mex.aksw.org/mex-algo#DecisionTrees> ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#AODE> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#AQ> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://mex.aksw.org/mex-algo#Rules> ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#AdaBoost> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#AdaptativeBoost> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:label "AdaBoost"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://mex.aksw.org/mex-algo#Boosting> ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#ApacheMahout> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#Apriori> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#AutoregressiveIntegratedMovingAverage> a owl:Class ;
    rdfs:label "ARIMA"@en ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#AutoregressiveMovingAverage> a owl:Class ;
    rdfs:label "ARMA"@en ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#AverageOneDependenceEstimators> a owl:Class ;
    rdfs:label "AODE"@en ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#BFTree> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:someValuesFrom <http://mex.aksw.org/mex-algo#DecisionTrees> ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#BIRCH> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#Baseline> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#Bayes> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#BayesTheoryAlgorithms> a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://mex.aksw.org/mex-algo#Algorithm> [ a owl:Restriction ;
                        owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
                        owl:someValuesFrom <http://mex.aksw.org/mex-algo#BayesTheory> ] ) ] .

<http://mex.aksw.org/mex-algo#Bootstrap> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#C-SVM> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://mex.aksw.org/mex-algo#Classification> ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasLearningProblem> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://mex.aksw.org/mex-algo#SupportVectorMachines> .

<http://mex.aksw.org/mex-algo#C45> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:someValuesFrom <http://mex.aksw.org/mex-algo#DecisionTrees> ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> ;
    owl:disjointWith <http://mex.aksw.org/mex-algo#BackPropagation>,
        <http://mex.aksw.org/mex-algo#Kmeans>,
        <http://mex.aksw.org/mex-algo#LogisticRegression>,
        <http://mex.aksw.org/mex-algo#NaiveBayes>,
        <http://mex.aksw.org/mex-algo#RandomForest>,
        <http://mex.aksw.org/mex-algo#RegressionAnalysis>,
        <http://mex.aksw.org/mex-algo#SupportVectorMachines> .

<http://mex.aksw.org/mex-algo#CART> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://mex.aksw.org/mex-algo#DecisionTrees> ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#CHAID> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#CHAMELEON> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#CLARA> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#CLARANS> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#CPlusPlus> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Library> .

<http://mex.aksw.org/mex-algo#CURE> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#Centura> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Library> .

<http://mex.aksw.org/mex-algo#CrossValidation> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#DL-Learner> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#DL-Learning> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#DecisionStump> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:someValuesFrom <http://mex.aksw.org/mex-algo#DecisionTrees> ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#DecisionTreesAlgorithms> a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://mex.aksw.org/mex-algo#Algorithm> [ a owl:Restriction ;
                        owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
                        owl:someValuesFrom <http://mex.aksw.org/mex-algo#DecisionTrees> ] ) ] .

<http://mex.aksw.org/mex-algo#DescriptiveMethod> a owl:Class ;
    rdfs:comment "are typically unsupervised and are used to induce interesting patterns (such as association rules) from unlabeled data. The induced patterns are useful in exploratory data analysis."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://mex.aksw.org/mex-algo#Algorithm> [ a owl:Restriction ;
                        owl:onClass <http://mex.aksw.org/mex-algo#Unsupervised> ;
                        owl:onProperty <http://mex.aksw.org/mex-algo#hasLearningMethod> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

<http://mex.aksw.org/mex-algo#ELKI> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#EViews> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#Encog> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#EnsambleTechnique> a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://mex.aksw.org/mex-algo#Algorithm> [ a owl:Restriction ;
                        owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
                        owl:someValuesFrom <http://mex.aksw.org/mex-algo#Bagging> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://mex.aksw.org/mex-algo#Algorithm> [ a owl:Restriction ;
                        owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
                        owl:someValuesFrom <http://mex.aksw.org/mex-algo#Boosting> ] ) ] .

<http://mex.aksw.org/mex-algo#FP> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:someValuesFrom <http://mex.aksw.org/mex-algo#DecisionTrees> ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#FP-growth> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#ForClassificationProblem> a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://mex.aksw.org/mex-algo#Algorithm> [ a owl:Restriction ;
                        owl:onClass <http://mex.aksw.org/mex-algo#Classification> ;
                        owl:onProperty <http://mex.aksw.org/mex-algo#hasLearningProblem> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

<http://mex.aksw.org/mex-algo#GA> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#GaussianRBF> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#GeneticAlgorithm> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#GraphKernel> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#H2O> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#Holdout> a <http://mex.aksw.org/mex-algo#NamedIndividual> .

<http://mex.aksw.org/mex-algo#HybridAlgorithm> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#IBMMiner> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#Implementation> .

<http://mex.aksw.org/mex-algo#ID3> a <http://mex.aksw.org/mex-algo#NamedIndividual>,
        owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://mex.aksw.org/mex-algo#DecisionTrees> ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#INDUCE> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://mex.aksw.org/mex-algo#Rules> ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#InductiveLogicProgramming> a owl:Class ;
    rdfs:label "ILP"@en ;
    rdfs:subClassOf <http://mex.aksw.org/mex-algo#AlgorithmClass> .

<http://mex.aksw.org/mex-algo#J48> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://mex.aksw.org/mex-algo#hasClass> ;
            owl:someValuesFrom <http://mex.aksw.org/mex-algo#DecisionTrees> ],
        <http://mex.aksw.org/mex-algo#NamedAlgorithm> .

<http://mex.aksw.org/mex-algo#J48Graft> a owl:Class ;
