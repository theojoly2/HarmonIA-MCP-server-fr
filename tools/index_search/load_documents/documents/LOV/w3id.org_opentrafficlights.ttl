@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <https://w3id.org/opentrafficlights> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/opentrafficlights#Connection> a rdfs:Class ;
    rdfs:label "Connection"@en ;
    rdfs:comment "Describes a departure at a certain lane and an arrival at a different lane"@en .

<https://w3id.org/opentrafficlights#Lane> a rdfs:Class ;
    rdfs:label "Lane"@en ;
    rdfs:comment "Describes a part of the road where a passenger departs or arrives from."@en .

<https://w3id.org/opentrafficlights#SignalGroup> a rdfs:Class ;
    rdfs:label "Signal group"@en ;
    rdfs:comment "Describes a group of traffic lights that have the same Signal state."@en .

<https://w3id.org/opentrafficlights#SignalState> a rdfs:Class ;
    rdfs:label "Signal state"@en ;
    rdfs:comment "Describes the state of a Signal group."@en .

onto: a foaf:Document ;
    dcterms:issued "2018-06-20"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:modified "2018-10-31"^^xsd:date ;
    foaf:primaryTopic <https://w3id.org/opentrafficlights#Ontology> .

<https://w3id.org/opentrafficlights#arrivalLane> a rdf:Property ;
    rdfs:label "Arrival lane"@en ;
    rdfs:comment "A road user will arrive here"@en ;
    rdfs:domain <https://w3id.org/opentrafficlights#Connection> .

<https://w3id.org/opentrafficlights#departureLane> a rdf:Property ;
    rdfs:label "Departure lane"@en ;
    rdfs:comment "A road user will depart from here"@en ;
    rdfs:domain <https://w3id.org/opentrafficlights#Connection> .

<https://w3id.org/opentrafficlights#maxEndTime> a rdf:Property ;
    rdfs:label "Maximum end time"@en ;
    rdfs:comment "The latest time possible at which the event state could change, except when unpredictable events relating to a pre-emption or priority call disrupt a currently active timing plan."@en ;
    rdfs:domain <https://w3id.org/opentrafficlights#SignalState> ;
    rdfs:range xsd:dateTime .

<https://w3id.org/opentrafficlights#minEndTime> a rdf:Property ;
    rdfs:label "Minimum end time"@en ;
    rdfs:comment "The earliest time possible at which the event state could change, except when unpredictable events relating to a pre-emption or priority call disrupt a currently active timing plan."@en ;
    rdfs:domain <https://w3id.org/opentrafficlights#SignalState> ;
    rdfs:range xsd:dateTime .

<https://w3id.org/opentrafficlights#signalPhase> a rdf:Property ;
    rdfs:label "Phase of a Signal state"@en ;
    rdfs:comment "Represents green, red etc. Adviced to use concept scheme https://w3id.org/opentrafficlights/thesauri/signalphase"@en ;
    rdfs:domain <https://w3id.org/opentrafficlights#SignalState> ;
    rdfs:range skos:Concept .

<https://w3id.org/opentrafficlights#signalState> a rdf:Property ;
    rdfs:label "Signal state"@en ;
    rdfs:comment "Signal state of a signal group."@en ;
    rdfs:domain <https://w3id.org/opentrafficlights#SignalGroup> ;
    rdfs:range <https://w3id.org/opentrafficlights#SignalState> .

<https://w3id.org/opentrafficlights#width> a rdf:Property ;
    rdfs:label "Width"@en ;
    rdfs:comment "The width of a lane expressed in centimeters."@en ;
    rdfs:domain <https://w3id.org/opentrafficlights#Lane> ;
    rdfs:range xsd:Integer .

<https://w3id.org/opentrafficlights#Ontology> a owl:Ontology ;
    rdfs:label "The Open Traffic Lights ontology"@en ;
    dcterms:creator <https://w3id.org/people/brechtvdv/#me> ;
    vann:preferredNamespacePrefix "otl" ;
    vann:preferredNamespaceUri "https://w3id.org/opentrafficlights#" ;
    rdfs:comment "This ontology provides the terms necessary to describe the status of traffic lights."@en .

