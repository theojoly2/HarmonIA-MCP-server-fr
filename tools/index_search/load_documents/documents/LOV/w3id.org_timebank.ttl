<https://w3id.org/timebank#MobilityProblem> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Mobility Problem" ;
    rdfs:comment "Difficulties with moving around physically such as having difficulties using toliet, dressing, walking and so on." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#PhysicalInconvenience> ;
    skos:broaderTransitive <https://w3id.org/timebank#PhysicalInconvenience> ;
    skos:relatedMatch <http://purl.bioontology.org/ontology/ICD10/Z74.0>,
        <http://snomed.info/id/102490005>,
        <http://who.int/icf#d4> .

<https://w3id.org/timebank#Supplies> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Supplies" ;
    rdfs:comment "Availability of specific supplies to complete a task." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Environment> ;
    skos:broaderTransitive <https://w3id.org/timebank#Environment> .

time:Instant a owl:Class .

<https://w3id.org/timebank#Environment> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Environment" ;
    rdfs:comment "The environment describes relevant environmental factors of a request." ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <https://w3id.org/timebank#Level>,
        <https://w3id.org/timebank#Limitation>,
        <https://w3id.org/timebank#Request>,
        <https://w3id.org/timebank#Skill>,
        <https://w3id.org/timebank#Status>,
        <https://w3id.org/timebank#User> .

<https://w3id.org/timebank#FoodAllergy> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Food Allergy" ;
    rdfs:comment "An allergy to food such as milk, peanuts, eggs, fish, tree nuts, and fruit." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Allergy> ;
    skos:broaderTransitive <https://w3id.org/timebank#Allergy> ;
    skos:exactMatch <http://dbpedia.org/resource/Food_allergy>,
        <http://snomed.info/id/157801005> .

<https://w3id.org/timebank#FoodService> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Food Service" ;
    rdfs:comment "The skill to provide services related to food products." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Skill> ;
    skos:broaderTransitive <https://w3id.org/timebank#Skill> ;
    skos:exactMatch <http://dbpedia.org/resource/Category:Food_and_drink_preparation> .

<https://w3id.org/timebank#OfficeWork> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Office Work" ;
    rdfs:comment "The skill to provide help with office related work." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Skill> ;
    skos:broaderTransitive <https://w3id.org/timebank#Skill> ;
    skos:closeMatch <http://dbpedia.org/resource/Category:Office_work> .

<https://w3id.org/timebank#PeopleCare> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Care for People" ;
    rdfs:comment "The skill to provide care for people." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Skill> ;
    skos:broaderTransitive <https://w3id.org/timebank#Skill> ;
    skos:exactMatch <http://dbpedia.org/resource/Category:Caregiving> .

<https://w3id.org/timebank#PhysicalInconvenience> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Physical Inconvenience" ;
    rdfs:comment "This is a collection of physical disorders that negatively affect a person's daily life." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Limitation> ;
    skos:broaderTransitive <https://w3id.org/timebank#Limitation> .

<https://w3id.org/timebank#Repair> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Repair" ;
    rdfs:comment "The Skill to repair equipment and facilities." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Skill> ;
    skos:broaderTransitive <https://w3id.org/timebank#Skill> ;
    skos:closeMatch <http://dbpedia.org/resource/Maintenance,_repair,_and_operations> .

<https://w3id.org/timebank#Status> a owl:Class ;
    rdfs:label "Status" ;
    rdfs:comment "The status of a request." ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <https://w3id.org/timebank#User> .

<https://w3id.org/timebank#CommonDisease> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Common Disease" ;
    rdfs:comment "A collection of diseases that are common, especially for elderly people" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Limitation> ;
    skos:broaderTransitive <https://w3id.org/timebank#Limitation> .

<https://w3id.org/timebank#Recreation> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Recreation" ;
    rdfs:comment "The skill to provide services related to recreation." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Skill> ;
    skos:broaderTransitive <https://w3id.org/timebank#Skill> .

<https://w3id.org/timebank#Accessibility> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Accessibility" ;
    rdfs:comment "Describes any revelant information regarding the accessibility of a location of a request." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Environment> ;
    owl:disjointWith <https://w3id.org/timebank#Supplies> ;
    skos:broaderTransitive <https://w3id.org/timebank#Environment> ;
    skos:exactMatch <http://dbpedia.org/resource/Accessibility> .

<https://w3id.org/timebank#Limitation> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Limitation" ;
    rdfs:comment "Limitations can be anything which prevents or limits the extent to which a user can help somebody else." ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <https://w3id.org/timebank#Request>,
        <https://w3id.org/timebank#Skill>,
        <https://w3id.org/timebank#Status>,
        <https://w3id.org/timebank#User> .

<https://w3id.org/timebank#User> a owl:Class ;
    rdfs:label "User" ;
    rdfs:comment "A user of the Timebank." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/timebank#hasTimeBalance> ],
        foaf:Person .

<https://w3id.org/timebank#AddressPart> a owl:Class ;
    rdfs:label "Address Part" ;
    rdfs:comment "An address part indicates part of an address like region, city, etc. If two places share the same address part, they also share the same environmental factors." ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <https://w3id.org/timebank#Environment>,
        <https://w3id.org/timebank#Level>,
        <https://w3id.org/timebank#Limitation>,
        <https://w3id.org/timebank#Request>,
        <https://w3id.org/timebank#Skill>,
        <https://w3id.org/timebank#Status> .

<https://w3id.org/timebank#Request> a owl:Class ;
    rdfs:label "Request" ;
    rdfs:comment "A request for help from a Timebank user." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/timebank#hasStatus> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/timebank#hasAccreditedDuration> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/timebank#hasOriginator> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/timebank#rating> ] ;
    owl:disjointWith <https://w3id.org/timebank#Skill>,
        <https://w3id.org/timebank#Status>,
        <https://w3id.org/timebank#User> .

<https://w3id.org/timebank#Skill> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Skill" ;
    rdfs:comment "Skills define the capabilities of a user. Users and Timebank requests can be associated to a certain skill (or multiple skills) to facilitate the matching of helper and requester." ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <https://w3id.org/timebank#Status>,
        <https://w3id.org/timebank#User> ;
    skos:closeMatch <http://dbpedia.org/resource/Category:Skills> .

onto: a owl:Ontology ;
    dc:title "Timebank Ontology" ;
    dcterms:created "2020-04-01" ;
    dcterms:creator "Ankit Tibrewal",
        "Subhayan Roy",
        "Tobias Grubenmann",
        "Xueer Li" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright © 2020 The University of Hong Kong" ;
    vann:preferredNamespacePrefix "tb" ;
    vann:preferredNamespaceUri "https://w3id.org/timebank" ;
    rdfs:comment "An ontology to describe poeple and requests for timebanks. This includes the poeple's skills, limitations, and environment." ;
    owl:imports skos:,
        time:,
        foaf: ;
    owl:versionIRI <https://w3id.org/timebank/0.2> ;
    owl:versionInfo 0.2 ;
    ns1:license <https://creativecommons.org/licenses/by/4.0/> .

[] a owl:AllDisjointClasses ;
    owl:members [ a rdf:List ;
            rdf:first <https://w3id.org/timebank#FearOfAnimals> ;
            rdf:rest [ a rdf:List ;
                    rdf:first <https://w3id.org/timebank#FearOfDark> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <https://w3id.org/timebank#FearOfHeights> ;
                            rdf:rest () ] ] ] .

