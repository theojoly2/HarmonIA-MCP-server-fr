                                                            rdf:first <https://w3id.org/timebank#PersonalService> ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first <https://w3id.org/timebank#Recreation> ;
                                                                    rdf:rest [ a rdf:List ;
                                                                            rdf:first <https://w3id.org/timebank#Repair> ;
                                                                            rdf:rest [ a rdf:List ;
                                                                                    rdf:first <https://w3id.org/timebank#SalesService> ;
                                                                                    rdf:rest [ a rdf:List ;
                                                                                            rdf:first <https://w3id.org/timebank#Transportation> ;
                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] .

