time:DayOfWeek a owl:Class .

<https://w3id.org/timebank#isSubPartOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is sub-part of" ;
    rdfs:comment onto:,
        "Indicates that the address part is a sub-part of another. A sub-part defines a place more precisely. A sub-part is always in the context of its super-part. For example, a streetnumber is a sub- part of the street." ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:range <https://w3id.org/timebank#AddressPart> .

<https://w3id.org/timebank#Pets> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pets" ;
    rdfs:comment "Indicates that pets might be present." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Environment> ;
    skos:broaderTransitive <https://w3id.org/timebank#Environment> ;
    skos:exactMatch <http://dbpedia.org/resource/Pet> .

<https://w3id.org/timebank#Cleaning> a owl:Class,
