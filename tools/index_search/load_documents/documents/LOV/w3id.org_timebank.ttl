    skos:broaderTransitive <https://w3id.org/timebank#Transportation> .

<https://w3id.org/timebank#FearOfAnimals> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Fear of Animals" ;
    rdfs:comment "Fear of animals. This can include dogs, cats, snakes, insects, etc." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#SpecificPhobia> ;
    skos:broaderTransitive <https://w3id.org/timebank#SpecificPhobia> ;
    skos:exactMatch <http://dbpedia.org/resource/Zoophobia>,
        <http://snomed.info/id/54307006> .

<https://w3id.org/timebank#SalesService> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sales Service" ;
    rdfs:comment "The skill to help with selling and buying products." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Skill> ;
    skos:broaderTransitive <https://w3id.org/timebank#Skill> ;
