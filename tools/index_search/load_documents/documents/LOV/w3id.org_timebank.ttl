    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Skill> ;
    skos:broaderTransitive <https://w3id.org/timebank#Skill> ;
    skos:relatedMatch <http://dbpedia.org/resource/Transport> .

<https://w3id.org/timebank#WeatherConstraint> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Weather Constraint" ;
    rdfs:comment "The place is difficult to access during bad weather (e.g. snow)." ;
    rdfs:isDefinedBy onto: ;
