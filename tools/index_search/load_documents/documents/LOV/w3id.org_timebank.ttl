    skos:exactMatch <http://dbpedia.org/resource/Category:Cleaning> .

<https://w3id.org/timebank#DrivingLightVehicles> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Driving Light Vehicles" ;
    rdfs:comment "Experience in driving light vehicles." ;
    rdfs:isDefinedBy onto: ;
