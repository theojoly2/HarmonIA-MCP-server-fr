    rdfs:label "Tailoring" ;
    rdfs:comment "Specialized in providing tailoring services." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#CraftingClothes> ;
    skos:broaderTransitive <https://w3id.org/timebank#CraftingClothes> ;
    skos:relatedMatch <http://dbpedia.org/resource/Tailor> .

<https://w3id.org/timebank#ToiletUsingProblem> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Toilet Using Problem" ;
    rdfs:comment "The person has difficulties using toilet." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#MobilityProblem> ;
    skos:broaderTransitive <https://w3id.org/timebank#MobilityProblem> ;
    skos:relatedMatch <http://snomed.info/id/129045003>,
        <http://who.int/icf#d530> .

<https://w3id.org/timebank#TransportationAvailable> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Transportation Available" ;
    rdfs:comment "Transportation necessary to complete the task can be provided." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Accessibility> ;
    skos:broaderTransitive <https://w3id.org/timebank#Accessibility> ;
    skos:relatedMatch <http://dbpedia.org/resource/Transport> .

<https://w3id.org/timebank#TravelCompanion> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Travel Companion" ;
    rdfs:comment "The ability to act as a travel companion." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Recreation> ;
    skos:broaderTransitive <https://w3id.org/timebank#Recreation> ;
    skos:relatedMatch <http://dbpedia.org/resource/Travel> .

<https://w3id.org/timebank#UnevenTerrain> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Uneven Terrain" ;
    rdfs:comment "The person needs equipment (e.g. shoes) suitable for uneven terrain." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Accessibility> ;
    skos:broaderTransitive <https://w3id.org/timebank#Accessibility> .

<https://w3id.org/timebank#WalkingProblem> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking Problem" ;
    rdfs:comment "The person has difficulties walking." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#MobilityProblem> ;
    skos:broaderTransitive <https://w3id.org/timebank#MobilityProblem> ;
    skos:exactMatch <http://snomed.info/id/156615004> ;
    skos:relatedMatch <http://purl.bioontology.org/ontology/ICD10/R26.2>,
        <http://who.int/icf#d450-d469> .

<https://w3id.org/timebank#WoodCarving> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Wood Carving" ;
    rdfs:comment "The skill to Carve items out of wood." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#WoodCrafting> ;
    skos:broaderTransitive <https://w3id.org/timebank#WoodCrafting> ;
    skos:exactMatch <http://dbpedia.org/resource/Category:Woodcarving> .

<https://w3id.org/timebank#Writing> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Writing" ;
    rdfs:comment "The skill to assist with written work, like writing or reading a letter." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#OfficeWork> ;
    skos:broaderTransitive <https://w3id.org/timebank#OfficeWork> ;
    skos:exactMatch <http://dbpedia.org/resource/Category:Writing> .

<https://w3id.org/timebank#excludesUserFrom> a owl:ObjectProperty ;
    rdfs:label "excludes user from" ;
    rdfs:comment "This property is used to describe that a certain limitation excludes certain helpers from the request." ;
    rdfs:domain <https://w3id.org/timebank#Limitation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> .

<https://w3id.org/timebank#hasAccreditedDuration> a owl:ObjectProperty ;
    rdfs:label "has accredited duration" ;
    rdfs:comment "The accredited duration of the request. This is the amount of time which will be transferred from the originator the the assigned helper of the request. Do not use this property to indicate the estimated duration of the task. Use hasExpectedDuration instead." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:DurationDescription ;
    owl:inverseOf <https://w3id.org/timebank#isAccreditedTo> .

<https://w3id.org/timebank#hasAddressPart> a owl:ObjectProperty ;
    rdfs:label "has address part" ;
    rdfs:comment "An address part that describes the location of a specific request." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#AddressPart> ;
    owl:inverseOf <https://w3id.org/timebank#isAdressPartOf> ;
    owl:propertyChainAxiom [ a rdf:List ;
            rdf:first <https://w3id.org/timebank#isSubPartOf> ;
            rdf:rest [ a rdf:List ;
                    rdf:first <https://w3id.org/timebank#hasAddressPart> ;
                    rdf:rest () ] ] .

<https://w3id.org/timebank#hasOriginator> a owl:ObjectProperty ;
    rdfs:label "has originator" ;
    rdfs:comment "Indicates that the request has the specific originator." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#User> ;
    owl:inverseOf <https://w3id.org/timebank#isOriginatorOf> .

<https://w3id.org/timebank#hasStatus> a owl:ObjectProperty ;
    rdfs:label "has status" ;
    rdfs:comment "Every request can have at most one status assigned to it." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Status> ;
    owl:inverseOf <https://w3id.org/timebank#isStatusOf> .

<https://w3id.org/timebank#hasTimeBalance> a owl:ObjectProperty ;
    rdfs:label "has time-balance" ;
    rdfs:comment "Indicates the current time-balance of a Timebank user." ;
    rdfs:domain <https://w3id.org/timebank#User> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:DurationDescription ;
    owl:inverseOf <https://w3id.org/timebank#isTimeBalanceOf> .

<https://w3id.org/timebank#isAcceptedBy> a owl:ObjectProperty ;
    rdfs:label "is accepted by" ;
    rdfs:comment "Indicates that a request is accepted by a user who is willing to help completing the request." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#User> .

<https://w3id.org/timebank#isAcceptedOn> a owl:ObjectProperty ;
    rdfs:label "is accepted on" ;
    rdfs:comment "Indicates the time and date when the Timebank request was accepted by the assigned helper." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:Instant .

<https://w3id.org/timebank#isAccreditedTo> a owl:ObjectProperty ;
    rdfs:label "is accredited to" ;
    rdfs:comment "The accredited duration of the request. This is the amount of time which will be transferred from the originator the the assigned helper of the request. Do not use this property to indicate the estimated duration of the task. Use hasExpectedDuration instead." ;
    rdfs:domain time:DurationDescription ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> .

<https://w3id.org/timebank#isAdressPartOf> a owl:ObjectProperty ;
    rdfs:label "is adress part of" ;
    rdfs:comment "An address part that describes the location of a specific request." ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> .

<https://w3id.org/timebank#isAvailableOn> a owl:ObjectProperty ;
    rdfs:label "is available on" ;
    rdfs:comment "Indicates the availability of a Timebank user to act as a helper for a Timebank request." ;
    rdfs:domain <https://w3id.org/timebank#User> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:ProperInterval .

<https://w3id.org/timebank#isCancelledOn> a owl:ObjectProperty ;
    rdfs:label "is cancelled on" ;
    rdfs:comment "Indicates the time and date when the Timebank request was cancelled." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:Instant .

<https://w3id.org/timebank#isCompletionDateOf> a owl:ObjectProperty ;
    rdfs:label "is completion date of" ;
    rdfs:comment "Indicates the time and date of the completion of a Timebank request." ;
    rdfs:domain time:Instant ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> .

<https://w3id.org/timebank#isEnvironmentOf> a owl:ObjectProperty ;
    rdfs:label "is environment of" ;
    rdfs:comment "Indicates that a certain Location Specifier has a specific environmental factor." ;
    rdfs:domain <https://w3id.org/timebank#Environment> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#AddressPart> .

<https://w3id.org/timebank#isExpectedDurationOf> a owl:ObjectProperty ;
    rdfs:label "is expected duration of" ;
    rdfs:comment "The expected duration indicates the duraction of the request estimated by the originator of the request. Do not use this property to assert the actual time credits associated to this request. Use hasAccreditedDuration instead." ;
    rdfs:domain time:DurationDescription ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> .

<https://w3id.org/timebank#isLimitationOf> a owl:ObjectProperty ;
    rdfs:label "is limitation of" ;
    rdfs:comment "Indicates that a certain limitation applies to the Timebank user." ;
    rdfs:domain <https://w3id.org/timebank#Limitation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#User> .

<https://w3id.org/timebank#isNotEnvironmentOf> a owl:ObjectProperty ;
    rdfs:label "is not environment of" ;
    rdfs:comment "Indicates that a certain Location Specifier has a specific environmental factor." ;
    rdfs:domain <https://w3id.org/timebank#Environment> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#AddressPart> .

<https://w3id.org/timebank#isOriginatorOf> a owl:ObjectProperty ;
    rdfs:label "is originator of" ;
    rdfs:comment "Indicates that the user is the originator of the request." ;
    rdfs:domain <https://w3id.org/timebank#User> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> .

<https://w3id.org/timebank#isPublishedOn> a owl:ObjectProperty ;
    rdfs:label "is published on" ;
    rdfs:comment "Indicates the time and date of the publication of a Timebank request." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:Instant .

<https://w3id.org/timebank#isRepeatingEndpointOf> a owl:ObjectProperty ;
    rdfs:label "is repeating endpoint of" ;
    rdfs:comment "Indicates that a specific time and date marks the end of a repetition of a time-interval." ;
    rdfs:domain time:Instant ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:ProperInterval .

<https://w3id.org/timebank#isSeverityOf> a owl:ObjectProperty ;
    rdfs:label "is severity of" ;
    rdfs:comment "Indicates the severity of a limitation." ;
    rdfs:domain <https://w3id.org/timebank#Level> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Limitation> .

<https://w3id.org/timebank#isSkillLevelOf> a owl:ObjectProperty ;
    rdfs:label "is skill level of" ;
    rdfs:comment "Describes the proficiency level of a skill." ;
    rdfs:domain <https://w3id.org/timebank#Level> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Skill> .

<https://w3id.org/timebank#isSkillOf> a owl:ObjectProperty ;
    rdfs:label "is skill of" ;
    rdfs:comment "Describes the Skill of a certain Timebank user." ;
    rdfs:domain <https://w3id.org/timebank#Skill> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#User> .

<https://w3id.org/timebank#isStatusOf> a owl:ObjectProperty ;
    rdfs:label "is status of" ;
    rdfs:comment "Every request can have at most one status assigned to it." ;
    rdfs:domain <https://w3id.org/timebank#Status> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> .

<https://w3id.org/timebank#isTimeBalanceOf> a owl:ObjectProperty ;
    rdfs:label "is time-balance of" ;
    rdfs:comment "Indicates the current time-balance of a Timebank user." ;
    rdfs:domain time:DurationDescription ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#User> .

<https://w3id.org/timebank#isTimeWindowOf> a owl:ObjectProperty ;
    rdfs:label "is time window of" ;
    rdfs:comment "Indicates the time window in which the request can/should be completed." ;
    rdfs:domain time:ProperInterval ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> .

<https://w3id.org/timebank#rating> a owl:DatatypeProperty ;
    rdfs:label "rating" ;
    rdfs:comment "The rating given by the originator of a request to the assigned helper for completing the specific request." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal .

<https://w3id.org/timebank#repeatsOn> a owl:ObjectProperty ;
    rdfs:label "repeats on" ;
    rdfs:comment "Indicates that a time interval repeats on the specified weekdays." ;
    rdfs:domain time:ProperInterval ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:DayOfWeek .

<https://w3id.org/timebank#requiresSkill> a owl:ObjectProperty ;
    rdfs:label "requires skill" ;
    rdfs:comment "The skill associated with a Timebank request." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Skill> .

