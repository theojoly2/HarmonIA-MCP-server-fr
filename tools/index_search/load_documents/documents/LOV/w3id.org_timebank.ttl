@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <https://creativecommons.org/ns#> .
@prefix onto: <https://w3id.org/timebank> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://linkedgeodata.org/ontology/addr%3Acity> a owl:DatatypeProperty ;
    rdfs:label "addr:city" ;
    rdfs:comment "May not be required if boundary=administrative is used correctly. May or may not be a clone of is_in:city=* (in some places the city in the address corresponds to the post office that serves the area rather than the actual city, if any, in which the building is located)! The name of the city as given in postal addresses of the building/area.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Aconscriptionnumber> a owl:DatatypeProperty ;
    rdfs:label "addr:conscriptionnumber" ;
    rdfs:comment "This special kind of housenumber relates to a settlement instead of a street. Conscription numbers were introduced in the Austrio-Hungarian Empire and are still in use in some parts of Europe, sometimes together with street-related housenumbers which are also called orientation numbers.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Acountry> a owl:DatatypeProperty ;
    rdfs:label "addr:country" ;
    rdfs:comment "May not be required if boundary=administrative is used correctly. The ISO 3166-1 alpha-2 two letter country code in upper case.\\nExample: \"DE\" for Germany, \"CH\" for Switzerland, \"AT\" for Austria, \"FR\" for France, \"IT\" for Italy.\\nCaveat: The ISO 3166-1 code for Great Britain is \"GB\" and not \"UK\". See also: is_in:country=*\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Adistrict> a owl:DatatypeProperty ;
    rdfs:label "addr:district" ;
    rdfs:comment "The district of the object.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Aflats> a owl:DatatypeProperty ;
    rdfs:label "addr:flats" ;
    rdfs:comment "The house numbers (range or list) of flats behind a door.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Afull> a owl:DatatypeProperty ;
    rdfs:label "addr:full" ;
    rdfs:comment "Use this for a full-text, often multi-line, address if you find the structured address fields unsuitable for denoting the address of this particular location. Examples: \"Fifth house on the left after the village oak, Smalltown, Smallcountry\", or addresses using special delivery names or codes (possibly via an unrelated city name and post code), or PO Boxes.\\nBeware that these strings can hardly be parsed by software: \"1200 West Sunset Boulevard Suite 110A\" is still better represented as addr:housenumber=1200 + addr:street=West Sunset Boulevard + addr:flats=Suite 110A.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Ahamlet> a owl:DatatypeProperty ;
    rdfs:label "addr:hamlet" ;
    rdfs:comment "The hamlet of the object.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Ahousename> a owl:DatatypeProperty ;
    rdfs:label "addr:housename" ;
    rdfs:comment "The name of a house.\\nThis is sometimes used in some countries like England instead of (or in addition to) a house number.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Ahousenumber> a owl:DatatypeProperty ;
    rdfs:label "addr:housenumber" ;
    rdfs:comment "The house number (may contain letters, dashes or other characters).\\nAddresses describes ways to tag a single building with multiple addresses.\\nPlease do not only tag addr:housenumber=*, but also add at least addr:street=* or addr:place=* for places without streets (or map the belonging to a street with a relation using associatedStreet relation or street relation.)\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Aplace> a owl:DatatypeProperty ;
    rdfs:label "addr:place" ;
    rdfs:comment "This is part of an address which refers to the name of some territorial zone (usually a place=* like island, square or very small village) instead of a street (highway=*). Should not be used together with addr:street=*.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Apostcode> a owl:DatatypeProperty ;
    rdfs:label "addr:postcode" ;
    rdfs:comment "The postal code of the building/area. Some mappers prefer to use boundary=postal_code\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Aprovince> a owl:DatatypeProperty ;
    rdfs:label "addr:province" ;
    rdfs:comment "The province of the object. For Canada, uppercase two-letter postal abbreviations (BC, AB, ON, QC, etc.) are used. In Russia a synonym addr:region is widely used\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Astate> a owl:DatatypeProperty ;
    rdfs:label "addr:state" ;
    rdfs:comment "The state of the object. For the US, uppercase two-letter postal abbreviations (AK, CA, HI, NY, TX, WY, etc.) are used.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Astreet> a owl:DatatypeProperty ;
    rdfs:label "addr:street" ;
    rdfs:comment "The name of the respective street.\\nA way with highway=* or a square with place=square and the corresponding name should be found nearby. The belonging to a street can alternatively be represented by a associatedStreet relation or street relation. The keys addr:housenumber=* and addr:street=* in principle are the only necessary ones if there are valid border polygons. If you are not sure if it is so, just add addr:city=*, addr:postcode=* and addr:country=*.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Asubdistrict> a owl:DatatypeProperty ;
    rdfs:label "addr:subdistrict" ;
    rdfs:comment "The subdistrict of the object.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://linkedgeodata.org/ontology/addr%3Asuburb> a owl:DatatypeProperty ;
    rdfs:label "addr:suburb" ;
    rdfs:comment "If an address exists several times in a city. You have to add the name of the settlement. See Australian definition of suburb.\\n(Source: https://wiki.openstreetmap.org/wiki/Map_Features, accessed on March 9, 2020)" ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy <http://linkedgeodata.org/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

dc:title a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

ns1:license a owl:AnnotationProperty .

<https://w3id.org/timebank#Carpeting> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Carpenting" ;
    rdfs:comment "The skill to do carpenting." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#WoodCrafting> ;
    owl:disjointWith <https://w3id.org/timebank#WoodCarving> ;
    skos:broaderTransitive <https://w3id.org/timebank#WoodCrafting> ;
    skos:exactMatch <http://dbpedia.org/resource/:Carpentry> .

<https://w3id.org/timebank#Cats> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Cats" ;
    rdfs:comment "Indicates that cats might be present." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Pets> ;
    skos:broaderTransitive <https://w3id.org/timebank#Pets> ;
    skos:exactMatch <http://dbpedia.org/resource/Cat> .

<https://w3id.org/timebank#ClothesWashing> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Clothes Washing" ;
    rdfs:comment "The skill to assist with washing clothes." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Cleaning> ;
    owl:disjointWith <https://w3id.org/timebank#Mopping> ;
    skos:broaderTransitive <https://w3id.org/timebank#Cleaning> ;
    skos:closeMatch <http://dbpedia.org/resource/Washing> .

<https://w3id.org/timebank#DrivingCars> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Driving Cars" ;
    rdfs:comment "Experience in driving cars." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#DrivingLightVehicles> ;
    owl:disjointWith <https://w3id.org/timebank#DrivingVans> ;
    skos:broaderTransitive <https://w3id.org/timebank#DrivingLightVehicles> ;
    skos:relatedMatch <http://dbpedia.org/resource/Automobile> .

<https://w3id.org/timebank#Electricity> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Electricity" ;
    rdfs:comment "Electric outlet available." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Supplies> ;
    skos:broaderTransitive <https://w3id.org/timebank#Supplies> ;
    skos:relatedMatch <http://dbpedia.org/resource/Electricity> .

<https://w3id.org/timebank#FearOfCats> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Fear of Cats" ;
    rdfs:comment "Fear of cats." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#FearOfAnimals> ;
    owl:disjointWith <https://w3id.org/timebank#FearOfDogs> ;
    skos:broaderTransitive <https://w3id.org/timebank#FearOfAnimals> ;
    skos:exactMatch <http://dbpedia.org/resource/Ailurophobia> .

<https://w3id.org/timebank#Groceries> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Groceries" ;
    rdfs:comment "The skill to help buying groceries." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#SalesService> ;
    owl:disjointWith <https://w3id.org/timebank#OnlineShopping> ;
    skos:broaderTransitive <https://w3id.org/timebank#SalesService> ;
    skos:relatedMatch <http://dbpedia.org/resource/Grocery_store> .

<https://w3id.org/timebank#Internet> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Internet" ;
    rdfs:comment "Internet is available." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Supplies> ;
    skos:broaderTransitive <https://w3id.org/timebank#Supplies> ;
    skos:exactMatch <http://dbpedia.org/resource/Internet> .

<https://w3id.org/timebank#LevelHigh> a owl:NamedIndividual,
        <https://w3id.org/timebank#Level> ;
    rdfs:label "Level: High" ;
    rdfs:comment "Used if a Limitation has a high severity or a Skill is on a high level." ;
    rdfs:isDefinedBy onto: .

<https://w3id.org/timebank#LevelLow> a owl:NamedIndividual,
        <https://w3id.org/timebank#Level> ;
    rdfs:label "Level: Low" ;
    rdfs:comment "Used if a Limitation only has a low severity or a Skill is on a low level." ;
    rdfs:isDefinedBy onto: .

<https://w3id.org/timebank#LevelMedium> a owl:NamedIndividual,
        <https://w3id.org/timebank#Level> ;
    rdfs:label "Level: Medium" ;
    rdfs:comment "Used if a Limitation has a medium severity or a Skill is on a medium level" ;
    rdfs:isDefinedBy onto: .

<https://w3id.org/timebank#LimitedAccessibilityRain> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Limited Accessibility: Rain" ;
    rdfs:comment "The place is difficult to access during rainfall." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#WeatherConstraint> ;
    owl:disjointWith <https://w3id.org/timebank#LimitedAccessibilitySnow> ;
    skos:broaderTransitive <https://w3id.org/timebank#WeatherConstraint> ;
    skos:relatedMatch <http://dbpedia.org/resource/Precipitation_(meteorology)> .

<https://w3id.org/timebank#StatusAssigned> a owl:NamedIndividual,
        <https://w3id.org/timebank#Status> ;
    rdfs:label "Status: Assigned" ;
    rdfs:comment "Indicates that a request is assigned to a helper but not yet completed." ;
    rdfs:isDefinedBy onto: .

<https://w3id.org/timebank#StatusCancelled> a owl:NamedIndividual,
        <https://w3id.org/timebank#Status> ;
    rdfs:label "Status: Cancelled" ;
    rdfs:comment "Indicates that a request is cancelled and no helper is needed anymore." ;
    rdfs:isDefinedBy onto: .

<https://w3id.org/timebank#StatusClosed> a owl:NamedIndividual,
        <https://w3id.org/timebank#Status> ;
    rdfs:label "Status: Closed" ;
    rdfs:comment "Indicates that a request is closed and that no helper is needed anymore." ;
    rdfs:isDefinedBy onto: .

<https://w3id.org/timebank#StatusOpen> a owl:NamedIndividual,
        <https://w3id.org/timebank#Status> ;
    rdfs:label "Status: Open" ;
    rdfs:comment "Indicates that a request is open and no helper is assigned to it." ;
    rdfs:isDefinedBy onto: .

<https://w3id.org/timebank#Tools> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tools" ;
    rdfs:comment "Tools can be provided." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Supplies> ;
    skos:broaderTransitive <https://w3id.org/timebank#Supplies> ;
    skos:relatedMatch <http://dbpedia.org/resource/Tool> .

<https://w3id.org/timebank#Water> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Water" ;
    rdfs:comment "Water outlet is available." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Supplies> ;
    skos:broaderTransitive <https://w3id.org/timebank#Supplies> ;
    skos:exactMatch <http://dbpedia.org/resource/Water_supply> .

<https://w3id.org/timebank#accepts> a owl:ObjectProperty ;
    rdfs:label "accepts" ;
    rdfs:comment "Indicates that a user who is willing to help accepted the request." ;
    rdfs:domain <https://w3id.org/timebank#User> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> ;
    owl:inverseOf <https://w3id.org/timebank#isAcceptedBy> .

<https://w3id.org/timebank#endsRepeatingOn> a owl:ObjectProperty ;
    rdfs:label "ends repeating on" ;
    rdfs:comment "Indicates that a time-interval is repeating until this time and date." ;
    rdfs:domain time:ProperInterval ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:Instant ;
    owl:inverseOf <https://w3id.org/timebank#isRepeatingEndpointOf> .

<https://w3id.org/timebank#excludesUserByLimitation> a owl:ObjectProperty ;
    rdfs:label "excludes user by limitation" ;
    rdfs:comment "This property is used to describe that a request exludes helpers having a certain limitation." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Limitation> ;
    owl:inverseOf <https://w3id.org/timebank#excludesUserFrom> .

<https://w3id.org/timebank#hasEnvironment> a owl:ObjectProperty ;
    rdfs:label "has environment" ;
    rdfs:comment "Indicates that a certain Location Specifier has a specific environmental factor." ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Environment> ;
    owl:inverseOf <https://w3id.org/timebank#isEnvironmentOf> .

<https://w3id.org/timebank#hasExpectedDuration> a owl:ObjectProperty ;
    rdfs:label "has expected duration" ;
    rdfs:comment "The expected duration indicates the duraction of the request estimated by the originator of the request. Do not use this property to assert the actual time credits associated to this request. Use hasAccreditedDuration instead." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:DurationDescription ;
    owl:inverseOf <https://w3id.org/timebank#isExpectedDurationOf> .

<https://w3id.org/timebank#hasLimitation> a owl:ObjectProperty ;
    rdfs:label "has limitation" ;
    rdfs:comment "Indicates that a Timebank user suffers from a certain limitation." ;
    rdfs:domain <https://w3id.org/timebank#User> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Limitation> ;
    owl:inverseOf <https://w3id.org/timebank#isLimitationOf> .

<https://w3id.org/timebank#hasNotEnvironment> a owl:ObjectProperty ;
    rdfs:label "has not environment" ;
    rdfs:comment "Indicates that a certain Location Specifier has a specific environmental factor." ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Environment> ;
    owl:inverseOf <https://w3id.org/timebank#isNotEnvironmentOf> .

<https://w3id.org/timebank#hasSeverity> a owl:ObjectProperty ;
    rdfs:label "has severity" ;
    rdfs:comment "Indicates the severity of a limitation." ;
    rdfs:domain <https://w3id.org/timebank#Limitation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Level> ;
    owl:inverseOf <https://w3id.org/timebank#isSeverityOf> .

<https://w3id.org/timebank#hasSkill> a owl:ObjectProperty ;
    rdfs:label "has skill" ;
    rdfs:comment "Describes the Skill of a certain Timebank user." ;
    rdfs:domain <https://w3id.org/timebank#User> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Skill> ;
    owl:inverseOf <https://w3id.org/timebank#isSkillOf> .

<https://w3id.org/timebank#hasSkillLevel> a owl:ObjectProperty ;
    rdfs:label "has skill level" ;
    rdfs:comment "Describes the proficiency level of a skill." ;
    rdfs:domain <https://w3id.org/timebank#Skill> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Level> ;
    owl:inverseOf <https://w3id.org/timebank#isSkillLevelOf> .

<https://w3id.org/timebank#hasSubPart> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has sub-part" ;
    rdfs:comment onto:,
        "Indicates that the address part is a sub-part of another. A sub-part defines a place more precisely. A sub-part is always in the context of its super-part. For example, a streetnumber is a sub- part of the street." ;
    rdfs:domain <https://w3id.org/timebank#AddressPart> ;
    rdfs:range <https://w3id.org/timebank#AddressPart> ;
    owl:inverseOf <https://w3id.org/timebank#isSubPartOf> .

<https://w3id.org/timebank#hasTimeWindow> a owl:ObjectProperty ;
    rdfs:label "has time window" ;
    rdfs:comment "Indicates the time window in which the request can/should be completed." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:ProperInterval ;
    owl:inverseOf <https://w3id.org/timebank#isTimeWindowOf> .

<https://w3id.org/timebank#isAcceptanceDateOf> a owl:ObjectProperty ;
    rdfs:label "is acceptance date of" ;
    rdfs:comment "Indicates the time and date when the Timebank request was accepted by the assigned helper." ;
    rdfs:domain time:Instant ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> ;
    owl:inverseOf <https://w3id.org/timebank#isAcceptedOn> .

<https://w3id.org/timebank#isAvailabilityOf> a owl:ObjectProperty ;
    rdfs:label "is availability of" ;
    rdfs:comment "Indicates the availability of a Timebank user to act as a helper for a Timebank request." ;
    rdfs:domain time:ProperInterval ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#User> ;
    owl:inverseOf <https://w3id.org/timebank#isAvailableOn> .

<https://w3id.org/timebank#isCancellationDateOf> a owl:ObjectProperty ;
    rdfs:label "is cancellation date of" ;
    rdfs:comment "Indicates the time and date when the Timebank request was cancelled." ;
    rdfs:domain time:Instant ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> ;
    owl:inverseOf <https://w3id.org/timebank#isCancelledOn> .

<https://w3id.org/timebank#isCompletedOn> a owl:ObjectProperty ;
    rdfs:label "is completed on" ;
    rdfs:comment "Indicates the time and date of the completion of a Timebank request." ;
    rdfs:domain <https://w3id.org/timebank#Request> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:Instant ;
    owl:inverseOf <https://w3id.org/timebank#isCompletionDateOf> .

<https://w3id.org/timebank#isPublicationDateOf> a owl:ObjectProperty ;
    rdfs:label "is publication date of" ;
    rdfs:comment "Indicates the time and date of the publication of a Timebank request." ;
    rdfs:domain time:Instant ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> ;
    owl:inverseOf <https://w3id.org/timebank#isPublishedOn> .

<https://w3id.org/timebank#isRepetitionDayOf> a owl:ObjectProperty ;
    rdfs:label "is repetition date of" ;
    rdfs:comment "Indicates that a time interval repeats on the specified weekdays." ;
    rdfs:domain time:DayOfWeek ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:ProperInterval ;
    owl:inverseOf <https://w3id.org/timebank#repeatsOn> .

<https://w3id.org/timebank#isRequiredBy> a owl:ObjectProperty ;
    rdfs:label "is required by" ;
    rdfs:comment "The skill associated with a Timebank request." ;
    rdfs:domain <https://w3id.org/timebank#Skill> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/timebank#Request> ;
    owl:inverseOf <https://w3id.org/timebank#requiresSkill> .

