    rdfs:label "Wood Crafting" ;
    rdfs:comment "Crafting skill with wood as base material." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/timebank#Crafting> ;
    skos:broaderTransitive <https://w3id.org/timebank#Crafting> ;
    skos:exactMatch <http://dbpedia.org/resource/Woodworking> .

time:DurationDescription a owl:Class .

<https://w3id.org/timebank#DrivingHeavyVehicles> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Driving Heavy Vehicles" ;
    rdfs:comment "Experience in driving heavy vehicles." ;
    rdfs:isDefinedBy onto: ;
