@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix onto: <http://purl.org/ontology/rec/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:RankedRecommendation a rdfs:Class,
        owl:Class ;
    rdfs:label "Ranked Recommendation"@en ;
    rdfs:comment "A ranked recommendation that includes an ordered list of recommendations."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/olo/core#OrderedList>,
        onto:Recommendation ;
    ns1:term_status "testing"@en .

onto:Recommendation a rdfs:Class,
        owl:Class ;
    rdfs:label "Recommendation"@en ;
    rdfs:comment "A recommendation of something for someone or a specific audience by a recommender."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/ao/core#LikeableAssociation> ;
    ns1:term_status "unstable"@en .

onto:for a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "for"@en ;
    rdfs:comment "Relates a recommendation to someone or something."@en ;
    rdfs:domain onto:Recommendation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    owl:inverseOf onto:recommendation ;
    ns1:term_status "unstable"@en .

onto:ranked_recommendation_object a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "ranked recommendation object"@en ;
    rdfs:comment "A ranked recommendation object in a ranked recommendation"@en ;
    rdfs:domain onto:RankedRecommendation ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://purl.org/ontology/olo/core#slot>,
        onto:recommendation_object ;
    ns1:term_status "testing"@en .

onto:recommendation_audience a rdf:Property ;
    rdfs:label "has recommendation audience"@en ;
    rdfs:comment "An audience for a specific recommendation."@en ;
    rdfs:domain onto:Recommendation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( dcterms:AgentClass foaf:Group ) ] ;
    ns1:term_status "unstable"@en .

onto:recommended_in a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "recommended in"@en ;
    rdfs:comment "A thing, which is recommended in a recommendation."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Recommendation ;
    owl:inverseOf onto:recommendation_object ;
    ns1:term_status "unstable"@en .

onto:recommends a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "recommends"@en ;
    rdfs:comment "An agent recommends a recommendation to someone or a recommendation audience."@en ;
    rdfs:domain dcterms:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Recommendation ;
    owl:inverseOf onto:recommender ;
    ns1:term_status "unstable"@en .

onto:recommendation a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has recommendation"@en ;
    rdfs:comment "A recommendation for someone or something."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Recommendation ;
    rdfs:subPropertyOf <http://purl.org/ontology/similarity/association> ;
    ns1:term_status "unstable"@en .

onto:recommender a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has recommender"@en ;
    rdfs:comment "An agent, which provided/calculated this recommendation."@en ;
    rdfs:domain onto:Recommendation ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dcterms:creator ;
    ns1:term_status "unstable"@en .

onto:recommendation_object a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has recommendation object"@en ;
    rdfs:comment "A recommendation object that is part of a specific recommendation."@en ;
    rdfs:domain onto:Recommendation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <http://purl.org/ontology/similarity/object> ;
    ns1:term_status "unstable"@en .

onto: a owl:Ontology ;
    dc:creator <http://foaf.me/zazi#me> ;
    dc:date "2010-08-02T09:31:52+01:00"^^xsd:dateTime ;
    dc:description "The Recommendation Ontology specification provides basic concepts and properties \\nfor describing recommendations on/ for the Semantic Web. This document contains a RDF description of the Recommendation Ontology."@en ;
    dc:title "The Recommendation Ontology"@en ;
    owl:imports dc:,
        dcterms:,
        <http://purl.org/ontology/ao/core>,
        <http://purl.org/ontology/olo/core#>,
        <http://purl.org/ontology/similarity/>,
        <http://www.w3.org/2003/06/sw-vocab-status/ns>,
        foaf: ;
    owl:versionInfo 0.3 .

