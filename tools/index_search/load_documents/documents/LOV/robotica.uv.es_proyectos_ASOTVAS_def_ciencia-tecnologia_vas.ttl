    rdfs:subClassOf ns2:AdministrativeArea .

<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Pais> a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "A country is a territory with its own geographical and cultural characteristics, which may or may not constitute a sovereign State or a political entity within a State. It is also used as a synonym for State, a set of political institutions endowed with territory, population and sovereignty."@en ;
    rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
    rdfs:subClassOf ns2:AdministrativeArea .

<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#codigoINE> a owl:DatatypeProperty ;
    rdfs:label "code INE"@en ;
    rdfs:comment "Coding assigned by the INE Nomenclature"@en ;
    rdfs:range rdfs:Literal .

geo:gmlLiteral a rdfs:Datatype ;
    rdfs:label "GML Literal"@en ;
    dc:contributor "Matthew Perry" ;
    dc:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dc:date "2011-06-16"^^xsd:date ;
    dc:description "\\n      A GML serialization of a geometry object.\\n    "@en ;
    rdfs:comment "\\n      A GML serialization of a geometry object.\\n    "@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    skos:definition "\\n      A GML serialization of a geometry object.\\n    "@en ;
    skos:prefLabel "GML Literal"@en .

geo:hasGeometry a owl:ObjectProperty ;
    rdfs:label "hasGeometry"@en ;
    dc:contributor "Matthew Perry" ;
    dc:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dc:date "2011-06-16"^^xsd:date ;
    dc:description "\\n      A spatial representation for a given feature.\\n    "@en ;
    rdfs:comment "\\n      A spatial representation for a given feature.\\n    "@en ;
    rdfs:domain geo:Feature ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    rdfs:range geo:Geometry ;
    skos:definition "\\n      A spatial representation for a given feature.\\n    "@en ;
    skos:prefLabel "hasGeometry"@en .

<http://www.opengis.net/ont/gml#AbstractParametricCurveSurface> a owl:Class ;
    rdfs:label "Abstract Parametric Curve Surface"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractSurfacePatch> .

<http://www.opengis.net/ont/gml#Arc> a owl:Class ;
    rdfs:label "Arc"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#ArcString> .

<http://www.opengis.net/ont/gml#ArcByCenterPoint> a owl:Class ;
    rdfs:label "Arc by Center Point"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#ArcString> a owl:Class ;
    rdfs:label "Arc String"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#ArcStringByBulge> a owl:Class ;
    rdfs:label "Arc String by Bulge"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#BSpline> a owl:Class ;
    rdfs:label "BSpline"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#SplineCurve> .

<http://www.opengis.net/ont/gml#CompositeCurve> a owl:Class ;
    rdfs:label "Composite Curve"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Composite>,
        <http://www.opengis.net/ont/gml#OrientableCurve> .

<http://www.opengis.net/ont/gml#CompositeSurface> a owl:Class ;
    rdfs:label "Composite Surface"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Composite>,
        <http://www.opengis.net/ont/gml#OrientableSurface> .

<http://www.opengis.net/ont/gml#GeodesicString> a owl:Class ;
    rdfs:label "Geodesic String"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#GeometricComplex> a owl:Class ;
    rdfs:label "Geometric Complex"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometry> .

<http://www.opengis.net/ont/gml#LineStringSegment> a owl:Class ;
    rdfs:label "Line String Segment"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#PolyhedralSurface> a owl:Class ;
    rdfs:label "Polyhedral Surface"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Surface> .

<http://www.opengis.net/ont/gml#PolynomialSpline> a owl:Class ;
    rdfs:label "Polynomial Spline"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#SplineCurve> .

<http://www.opengis.net/ont/gml#Ring> a owl:Class ;
    rdfs:label "Ring"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#CompositeCurve> .

<http://www.opengis.net/ont/gml#Solid> a owl:Class ;
    rdfs:label "Solid"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometricPrimitive> .

<http://www.opengis.net/ont/gml#TriangulatedSurface> a owl:Class ;
    rdfs:label "Triangulated Surface"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#PolyhedralSurface> .

rdf:List a owl:Class .

skos:OrderedCollection a owl:Class ;
    rdfs:label "Ordered Collection"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subClassOf skos:Collection ;
    skos:definition "An ordered collection of concepts, where both the grouping and the ordering are meaningful."@en ;
    skos:scopeNote "Ordered collections can be used where you would like a set of concepts to be displayed in a specific order, and optionally under a 'node label'."@en .

skos:broader a owl:ObjectProperty ;
    rdfs:label "has broader"@en ;
    rdfs:comment "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:broaderTransitive ;
    owl:inverseOf skos:narrower ;
    skos:definition "Relates a concept to a concept that is more general in meaning."@en ;
    skos:scopeNote "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en .

skos:broaderTransitive a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has broader transitive"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    owl:inverseOf skos:narrowerTransitive ;
    skos:definition "skos:broaderTransitive is a transitive superproperty of skos:broader." ;
    skos:scopeNote "By convention, skos:broaderTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."@en .

skos:closeMatch a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has close match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation ;
    skos:definition "skos:closeMatch is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications. In order to avoid the possibility of \"compound errors\" when combining mappings across more than two concept schemes, skos:closeMatch is not declared to be a transitive property."@en .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme ;
    skos:definition "Relates a resource (for example a concept) to a concept scheme in which it is included."@en ;
    skos:scopeNote "A concept may be a member of more than one concept scheme."@en .

skos:narrowMatch a owl:ObjectProperty ;
    rdfs:label "has narrower match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation,
        skos:narrower ;
    skos:definition "skos:narrowMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .

skos:related a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has related"@en ;
    rdfs:comment "skos:related is disjoint with skos:broaderTransitive"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    skos:definition "Relates a concept to a concept with which there is an associative semantic relationship."@en .

skos:topConceptOf a owl:ObjectProperty ;
    rdfs:label "is top concept in scheme"@en ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:ConceptScheme ;
    rdfs:subPropertyOf skos:inScheme ;
    skos:definition "Relates a concept to the concept scheme that it is a top level concept of."@en .

time:Interval a owl:Class .

sosa:Procedure rdfs:label "Procedure"@en ;
    rdfs:comment "A workflow, protocol, plan, algorithm, or computational method specifying how to make an Observation, create a Sample, or make a change to the state of the world (via an Actuator). A Procedure is re-usable, and might be involved in many Observations, Samplings, or Actuations. It explains the steps to be carried out to arrive at reproducible results."@en ;
    skos:definition "A workflow, protocol, plan, algorithm, or computational method specifying how to make an Observation, create a Sample, or make a change to the state of the world (via an Actuator). A Procedure is re-usable, and might be involved in many Observations, Samplings, or Actuations. It explains the steps to be carried out to arrive at reproducible results."@en ;
    skos:example "The measured wind speed differs depending on the height of the sensor above the surface, e.g., due to friction. Consequently, procedures for measuring wind speed define a standard height for anemometers above ground, typically 10m for meteorological measures and 2m in Agrometeorology. This definition of height, sensor placement, and so forth are defined by the Procedure."@en ;
    skos:note "Many observations may be created via the same Procedure, the same way as many tables are assembled using the same instructions (as information objects, not their concrete realization)."@en .

sosa:isActedOnBy a owl:ObjectProperty ;
    rdfs:label "is acted on by"@en ;
    ns2:domainIncludes sosa:ActuatableProperty ;
    ns2:rangeIncludes sosa:Actuation ;
    rdfs:comment "Relation between an ActuatableProperty of a FeatureOfInterest and an Actuation changing its state."@en ;
    skos:definition "Relation between an ActuatableProperty of a FeatureOfInterest and an Actuation changing its state."@en ;
    skos:example "In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property on which the Actuator acts upon is the state of the window as it changes from being open to being closed. "@en .

sosa:isFeatureOfInterestOf a owl:ObjectProperty ;
    rdfs:label "is feature of interest of"@en ;
    ns2:domainIncludes sosa:FeatureOfInterest,
        sosa:Sample ;
    ns2:rangeIncludes sosa:Actuation,
        sosa:Observation,
        sosa:Sampling ;
    rdfs:comment "A relation between a FeatureOfInterest and an Observation about it, an Actuation acting on it, or an act of Sampling that sampled it."@en ;
    skos:definition "A relation between a FeatureOfInterest and an Observation about it, an Actuation acting on it, or an act of Sampling that sampled it."@en .

sosa:isResultOf a owl:ObjectProperty ;
    rdfs:label "is result of"@en ;
    ns2:domainIncludes sosa:Result,
        sosa:Sample ;
    ns2:rangeIncludes sosa:Actuation,
        sosa:Observation,
        sosa:Sampling ;
    rdfs:comment "Relation linking a Result to the Observation or Actuation or act of Sampling that created or caused it."@en ;
    skos:definition "Relation linking a Result to the Observation or Actuation or act of Sampling that created or caused it."@en .

sosa:isSampleOf a owl:ObjectProperty ;
    rdfs:label "is sample of"@en ;
    ns2:domainIncludes sosa:Sample ;
    ns2:rangeIncludes sosa:FeatureOfInterest ;
    rdfs:comment "Relation from a Sample to the FeatureOfInterest that it is intended to be representative of."@en ;
    skos:definition "Relation from a Sample to the FeatureOfInterest that it is intended to be representative of."@en .

sosa:madeByActuator a owl:ObjectProperty ;
    rdfs:label "made by actuator"@en ;
    ns2:domainIncludes sosa:Actuation ;
    ns2:rangeIncludes sosa:Actuator ;
    rdfs:comment "Relation linking an Actuation to the Actuator that made that Actuation."@en ;
    skos:definition "Relation linking an Actuation to the Actuator that made that Actuation."@en .

sosa:madeObservation a owl:ObjectProperty ;
    rdfs:label "made observation"@en ;
    ns2:domainIncludes sosa:Sensor ;
    ns2:rangeIncludes sosa:Observation ;
    rdfs:comment "Relation between a Sensor and an Observation made by the Sensor."@en ;
    skos:definition "Relation between a Sensor and an Observation made by the Sensor."@en .

sosa:madeSampling a owl:ObjectProperty ;
    rdfs:label "made sampling"@en ;
    ns2:domainIncludes sosa:Sampler ;
    ns2:rangeIncludes sosa:Sampling ;
    rdfs:comment "Relation between a Sampler (sampling device or entity) and the Sampling act it performed."@en ;
    skos:definition "Relation between a Sampler (sampling device or entity) and the Sampling act it performed."@en .

ns3:AGB_Result a owl:Class ;
    rdfs:comment "Result that normally is obtained by AGB sensors. Unit of measure Unit of measure Mg/ha (Milligram per Hectare).."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/MilliGM-PER-HA> ;
            owl:onProperty ns1:unit ],
        [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        sosa:Result .

ns3:AGB_UAV_Hyperspectral_Sensor_1 a owl:NamedIndividual,
        ns3:RS_UAV_Hyperspectral ;
    rdfs:comment "Sensor AGB UAV Hyperspectral hosted by UAV Hyperspectral 1." ;
    sosa:isHostedBy ns3:UAV_Hyperspectral_1 ;
    sosa:observes <http://aims.fao.org/aos/agrovoc/c_1373987580598> .

ns3:AGB_UAV_LiDAR_Sensor_1 a owl:NamedIndividual,
    rdfs:comment "Sensor AGB UAV LiDAR  hosted by UAV LiDAR 1."@en ;
    sosa:isHostedBy ns3:UAV_LiDAR_1 ;
    sosa:observes <http://aims.fao.org/aos/agrovoc/c_1373987580598> .

ns3:Atmospheric_Humidity_Result a owl:Class ;
    rdfs:comment "Result that is normally obtained by Hygrometer sensors. Unit of measure Percent Relative Humidity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/PERCENT_RH> ;
            owl:onProperty ns1:unit ],
        [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        sosa:Result .

ns3:Atmospheric_Pressure_AEMET_Result a owl:Class ;
    rdfs:comment "Result that is normally obtained by Barometer sensors. Unit of measure Hectopascal (hPa)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/HectoPA> ;
            owl:onProperty ns1:unit ],
        [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        sosa:Result .

ns3:Atmospheric_Pressure_EddyCovariance_Result a owl:Class ;
    rdfs:comment "Result that is normally obtained by Barometer sensors. Unit of measure Kilopascal (kPa)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/KiloPA> ;
            owl:onProperty ns1:unit ],
        [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        sosa:Result .

ns3:CHM_Result a owl:Class ;
    rdfs:comment "Result that normally is obtained by CHM sensors. Unit of measure Metre."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/M> ;
            owl:onProperty ns1:unit ],
        [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        sosa:Result .

ns3:CHM_UAV_LiDAR_Sensor_1 a owl:NamedIndividual,
    rdfs:comment "Sensor CHM UAV LiDAR  hosted by UAV LiDAR 1."@en ;
    sosa:isHostedBy ns3:UAV_LiDAR_1 ;
    sosa:observes ns3:Canopy_Height_Model .

ns3:CRI_Result a owl:Class ;
    rdfs:comment "Result that normally is obtained by CRI sensors. Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/NUM> ;
            owl:onProperty ns1:unit ],
        sosa:Result .

ns3:CRI_UAV_Hyperspectral_Sensor_1 a owl:NamedIndividual,
        ns3:RS_UAV_Hyperspectral ;
    rdfs:comment "Sensor CRI UAV Hyperspectral hosted by UAV Hyperspectral 1." ;
    sosa:isHostedBy ns3:UAV_Hyperspectral_1 ;
    sosa:observes <http://aims.fao.org/aos/agrovoc/c_1333> .

ns3:Carbon_Dioxide_flux_Result a owl:Class ;
    rdfs:comment "Result that is normally obtained by CarbonDioxideFlux (carbon dioxide flux) sensors. Unit of measure Milligrams per Square Metre per Second,"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/MilliGM-PER-M2-SEC> ;
            owl:onProperty ns1:unit ],
        [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        sosa:Result .

ns3:Chl_Result a owl:Class ;
