@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ns1: <http://qudt.org/schema/qudt/> .
@prefix ns2: <http://schema.org/> .
@prefix ns3: <https://robotica.uv.es/proyectos/ASOTVAS/def/ciencia-tecnologia/vas#> .
@prefix ns4: <https://mmisw.org/ont/cf/parameter/> .
@prefix onto: <https://robotica.uv.es/proyectos/ASOTVAS/def/ciencia-tecnologia/vas> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://datos.gob.es/recurso/sector-publico/territorio/Autonomia/Comunitat-Valenciana> a <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#ComunidadAutonoma>,
        owl:NamedIndividual ;
    rdfs:label "Comunitat Valenciana" .

<http://dbpedia.org/resource/Humidity> a <http://dbpedia.org/resource/Meteorology_Property>,
        owl:NamedIndividual ;
    dc:description "The humidity of the air is due to the water vapor present in the atmosphere. This vapor comes from the evaporation of terrestrial water bodies. The amount of water vapor that air can hold depends on its temperature. Warm air can hold more water vapor than cold air. One way to measure atmospheric humidity is through a hygrometer"@en .

<http://khaos.uma.es/green-senti/earth-observation#baresoilpercentage> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Bare soil percentage"@en ;
    rdfs:comment "Bare soil percentage\\n\\nExample: 35.747452"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#cloudcover> a owl:DatatypeProperty ;
    rdfs:label "Cloud cover"@en ;
    rdfs:comment "Cloud coverage (percent) of a WRS scene.\\n\\nValues:\\n0.00 - 100.00\\n-1 = Cloud cover not calculated or assessed"@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#cloudcoverland> a owl:DatatypeProperty ;
    rdfs:label "Cloud cover land"@en ;
    rdfs:comment "All sensors = Cloud coverage over land (percent) assigned to a WRS scene.\\n\\nValues:\\n-1 = Cloud cover land not calculated or assessed."@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#collectioncategory> a owl:DatatypeProperty ;
    rdfs:label "Collection category"@en ;
    rdfs:comment "Landsat Collection 1 is organized by a tiered inventory structure to indicate the quality and level of processing of the data.\\n\\nValues:\\nT1 = Tier 1 is the highest available quality and processing level. This category is suitable for time-series analysis across the different Landsat sensors.\\n\\nT2 = Tier 2 scenes contain significant cloud cover and have insufficient ground control to generate precision and terrain corrected products.\\n\\nRT = Real-Time indicates initial processing with additional processing required to achieve Tier 1 or Tier 2."@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#dateacquired> a owl:DatatypeProperty ;
    rdfs:label "Date acquired"@en ;
    rdfs:comment "Year, month and day that this scene was imaged.\\n\\nFormat:\\nYYYY/MM/DD"@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#datum> a owl:DatatypeProperty ;
    rdfs:label "Datum"@en ;
    rdfs:comment "Datum used in creating the image.\\n\\nValues:\\nWGS84 = World Geodetic System 1984"@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#highprobacloudspercentage> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "High proba clouds percentage"@en ;
    rdfs:comment "High proba clouds percentage\\n\\nExample: 0.232073"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#identifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "Identifier\\n\\nExample: S2A_MSIL1C_20180603T110041_N0206_R094_T30SUF_20180603T130559"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#imagequalityoli> a owl:DatatypeProperty ;
    rdfs:label "Image quality OLI"@en ;
    rdfs:comment "Composite image quality for the bands. For Landsat 8 or 9, if scene is OLI or OLI_TIRS combined, value will reflect OLI quality score. If TIRS, the TIRS quality score will be used\\n\\nValues:\\n9 = Best\\n0 = Worst\\n-1 = Image quality not calculated or assessed"@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#imagequalitytirs> a owl:DatatypeProperty ;
    rdfs:label "Image quality TIRS"@en ;
    rdfs:comment "Composite image quality for the bands. For Landsat 8 or 9, if scene is OLI or OLI_TIRS combined, value will reflect OLI quality score. If TIRS, the TIRS quality score will be used\\n\\nValues:\\n9 = Best\\n0 = Worst\\n-1 = Image quality not calculated or assessed"@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#instrumentname> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Instrument name"@en ;
    rdfs:comment "The instrument name used for acquiring the data.\\n\\nExample: Multi-Spectral Instrument"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#landsatproductid> a owl:DatatypeProperty ;
    rdfs:label "Landsat product ID"@en ;
    rdfs:comment "The naming convention of each L7 ETM+ Collection 1 Level-1 image is based on acquisition and processing parameters.\\n\\nFormat:\\nLXSS_LLLL_PPPRRR_YYYYMMDD_yyyymmdd_CC_TX\\n\\nL = Landsat\\nX = Sensor (E = Enhanced Thematic Mapper Plus)\\nSS = Satellite (07 = Landsat 7)\\nLLLL = Processing Correction Level (L1TP = precision and terrain, L1GT = systematic terrain, L1GS = systematic)\\nPPP = WRS Path\\nRRR = WRS Row\\nYYYYMMDD = Acquisition Date expressed in Year, Month, Day\\nyyyymmdd = Processing Date expressed in Year, Month, Day\\nCC = Collection Number (01)\\nTX = Collection Category (RT = Real Time, T1 = Tier 1, T2 = Tier 2)\\n\\nExample: LE07_L1TP_029030_20140715_20140805_02_T1"@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#link> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Product download link"@en ;
    rdfs:comment "Download link for the product from https://scihub.copernicus.eu\\n\\nExample: https://scihub.copernicus.eu/dhus/odata/v1/Products('95bec4b4-a2d4-4b6f-a7cd-1de5cb3e85b7')/$value"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#link_alternative> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Link to product"@en ;
    rdfs:comment "Link to the product from https://scihub.copernicus.eu\\n\\nExample: https://scihub.copernicus.eu/dhus/odata/v1/Products('95bec4b4-a2d4-4b6f-a7cd-1de5cb3e85b7')/"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#mapprojection> a owl:DatatypeProperty ;
    rdfs:label "Map projection"@en ;
    rdfs:comment "L0Ra map projection selectively applied to HDTs based on geographic location. Used for processed archive data.\\n\\nValues:\\nHOM = Hotine Oblique Mercator\\nUTM = Universal Transverse Mercator"@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#orbitdirection> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Orbit direction"@en ;
    rdfs:comment "Orbit direccion while taking he product\\n\\nCan be either 'ASCENDING' or 'DESCENDING'\\n\\nExample: 'ASCENDING'"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#orientation> a owl:DatatypeProperty ;
    rdfs:label "Orientation"@en ;
    rdfs:comment "Orientation used in creating the image.\\n\\nValues:\\nNOMINAL = Nominal Path\\nNORTH_UP = North Up\\nTRUE_NORTH = True North\\nUSER = User"@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#origin> a owl:DatatypeProperty ;
    rdfs:label "Origin"@en ;
    rdfs:comment "Origin of the image\\n\\nValues:\\nExample: \"Image courtesy of the U.S. Geological Survey\""@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#platformname> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Platform name"@en ;
    rdfs:comment "The mission full name of the platform. This name is not a perfect identifier.\\n\\nExample:Sentinel-2"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#platformserialidentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Platform serial identifier"@en ;
    rdfs:comment "The platform serial identifier is the sequence number of the platform among the mission\\n\\nExample: Sentinel-2A"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#processinglevel> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Processing level"@en ;
    rdfs:comment "The level of the last processing\\n\\nExample: Level-2A"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#size> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Size"@en ;
    rdfs:comment "Size of the product\\n\\nExample: 634.50 MB"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#snowicepercentage> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Snow ice percentage"@en ;
    rdfs:comment "Percentage of snow ice\\n\\nExample: 0.00018899999999999999"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#title> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Title"@en ;
    rdfs:comment "Title\\n\\nExample: S2A_MSIL2A_20170628T105651_N0205_R094_T30SUF_20170628T110445"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#utmzone> a owl:DatatypeProperty ;
    rdfs:label "UTM zone"@en ;
    rdfs:comment "UTM (Universal Transverse Mercator) zone number in a map projection. A negative zone indicates that the false northing needs to be applied to the northing coordinate and a positive zone indicates that the false northing has been applied.\\n\\nValues:\\nNegative Zone = Indicates that the false northing needs to be applied.\\nPositive Zone = Indicates that the false northing has been applied."@en ;
    rdfs:domain ns3:Landsat-8_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:landsat8ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#vegetationpercentage> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Vegetation percentage"@en ;
    rdfs:comment "Percentage of vegetation\\n\\nExample: 10.589334000000001"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

<http://khaos.uma.es/green-senti/earth-observation#waterpercentage> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Water percentage"@en ;
    rdfs:comment "Water of percentage\\n\\nExample: 15.87375"@en ;
    rdfs:domain ns3:Sentinel-2_Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:sentinel2ProductProperties .

dc:contributor a owl:AnnotationProperty ;
    rdfs:label "Contributor"@en ;
    dcterms:description "The guidelines for using names of persons or organizations as creators also apply to contributors.  Typically, the name of a Contributor should be used to indicate the entity."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "An entity responsible for making contributions to the resource."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/contributor) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:coverage rdfs:label "Coverage"@en ;
    dcterms:description "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended practice is to use a controlled vocabulary such as the Getty Thesaurus of Geographic Names [[TGN](https://www.getty.edu/research/tools/vocabulary/tgn/index.html)]. Where appropriate, named places or time periods may be used in preference to numeric identifiers such as sets of coordinates or date ranges."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "The spatial or temporal topic of the resource, spatial applicability of the resource, or jurisdiction under which the resource is relevant."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/coverage) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:creator a owl:AnnotationProperty ;
    rdfs:label "Creator"@en ;
    dcterms:description "Examples of a Creator include a person, an organization, or a service. Typically, the name of a Creator should be used to indicate the entity."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "An entity primarily responsible for making the resource."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/creator) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:date a owl:AnnotationProperty ;
    rdfs:label "Date"@en ;
    dcterms:description "Date may be used to express temporal information at any level of granularity.  Recommended practice is to express the date, date/time, or period of time according to ISO 8601-1 [[ISO 8601-1](https://www.iso.org/iso-8601-date-and-time-format.html)] or a published profile of the ISO standard, such as the W3C Note on Date and Time Formats [[W3CDTF](https://www.w3.org/TR/NOTE-datetime)] or the Extended Date/Time Format Specification [[EDTF](http://www.loc.gov/standards/datetime/)].  If the full date is unknown, month and year (YYYY-MM) or just year (YYYY) may be used. Date ranges may be specified using ISO 8601 period of time specification in which start and end dates are separated by a '/' (slash) character.  Either the start or end date may be missing."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/date) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:description a owl:AnnotationProperty ;
    rdfs:label "Description"@en ;
    dcterms:description "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "An account of the resource."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/description) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:format rdfs:label "Format"@en ;
    dcterms:description "Recommended practice is to use a controlled vocabulary where available. For example, for file formats one could use the list of Internet Media Types [[MIME](https://www.iana.org/assignments/media-types/media-types.xhtml)]."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "The file format, physical medium, or dimensions of the resource."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/format) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:identifier rdfs:label "Identifier"@en ;
    dcterms:description "Recommended practice is to identify the resource by means of a string conforming to an identification system."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "An unambiguous reference to the resource within a given context."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/identifier) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:language rdfs:label "Language"@en ;
    dcterms:description "Recommended practice is to use either a non-literal value representing a language from a controlled vocabulary such as ISO 639-2 or ISO 639-3, or a literal value consisting of an IETF Best Current Practice 47 [[IETF-BCP47](https://tools.ietf.org/html/bcp47)] language tag."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "A language of the resource."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/language) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:publisher rdfs:label "Publisher"@en ;
    dcterms:description "Examples of a Publisher include a person, an organization, or a service. Typically, the name of a Publisher should be used to indicate the entity."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "An entity responsible for making the resource available."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/publisher) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:relation rdfs:label "Relation"@en ;
    dcterms:description "Recommended practice is to identify the related resource by means of a URI. If this is not possible or feasible, a string conforming to a formal identification system may be provided."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "A related resource."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/relation) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:rights rdfs:label "Rights"@en ;
    dcterms:description "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "Information about rights held in and over the resource."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/rights) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:source a owl:AnnotationProperty ;
    rdfs:label "Source"@en ;
    dcterms:description "The described resource may be derived from the related resource in whole or in part. Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "A related resource from which the described resource is derived."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/source) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:subject rdfs:label "Subject"@en ;
    dcterms:description "Typically, the subject will be represented using keywords, key phrases, or classification codes.  Recommended best practice is to use a controlled vocabulary."@en ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    rdfs:comment "The topic of the resource."@en ;
    skos:note "A [second property](/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/subject) with the same name as this property has been declared in the [dcterms: namespace](http://purl.org/dc/terms/).  See the Introduction to the document [DCMI Metadata Terms](/specifications/dublin-core/dcmi-terms/) for an explanation."@en .

dc:title a owl:AnnotationProperty ;
