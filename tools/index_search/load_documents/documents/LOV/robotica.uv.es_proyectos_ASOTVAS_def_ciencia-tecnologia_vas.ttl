geo:coordinateDimension a owl:DatatypeProperty ;
    rdfs:label "coordinateDimension"@en ;
    dc:contributor "Matthew Perry" ;
    dc:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dc:date "2011-06-16"^^xsd:date ;
    dc:description "\\n      The number of measurements or axes needed to describe the position of this\\n      geometry in a coordinate system.\\n    "@en ;
    rdfs:comment "\\n      The number of measurements or axes needed to describe the position of this\\n      geometry in a coordinate system.\\n    "@en ;
    rdfs:domain geo:Geometry ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    rdfs:range xsd:integer ;
    skos:definition "\\n      The number of measurements or axes needed to describe the position of this\\n      geometry in a coordinate system.\\n    "@en ;
    skos:prefLabel "coordinateDimension"@en .

geo:defaultGeometry a owl:ObjectProperty ;
    rdfs:label "defaultGeometry"@en ;
    dc:contributor "Matthew Perry" ;
    dc:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dc:date "2011-06-16"^^xsd:date ;
    dc:description "\\n      The default geometry to be used in spatial calculations.\\n      It is Usually the most detailed geometry.\\n    "@en ;
    rdfs:comment "\\n      The default geometry to be used in spatial calculations.\\n      It is Usually the most detailed geometry.\\n    "@en ;
    rdfs:domain geo:Feature ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    rdfs:range geo:Geometry ;
    rdfs:subPropertyOf geo:hasGeometry ;
    skos:definition "\\n      The default geometry to be used in spatial calculations.\\n      It is Usually the most detailed geometry.\\n    "@en ;
    skos:prefLabel "defaultGeometry"@en .

geo:dimension a owl:DatatypeProperty ;
    rdfs:label "dimension"@en ;
    dc:contributor "Matthew Perry" ;
    dc:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dc:date "2011-06-16"^^xsd:date ;
    dc:description "\\n      The topological dimension of this geometric object, which \\n      must be less than or equal to the coordinate dimension. \\n      In non-homogeneous collections, this will return the largest \\n      topological dimension of the contained objects.\\n    "@en ;
    rdfs:comment "\\n      The topological dimension of this geometric object, which \\n      must be less than or equal to the coordinate dimension. \\n      In non-homogeneous collections, this will return the largest \\n      topological dimension of the contained objects.\\n    "@en ;
    rdfs:domain geo:Geometry ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    rdfs:range xsd:integer ;
    skos:definition "\\n      The topological dimension of this geometric object, which \\n      must be less than or equal to the coordinate dimension. \\n      In non-homogeneous collections, this will return the largest \\n      topological dimension of the contained objects.\\n    "@en ;
    skos:prefLabel "dimension"@en .

