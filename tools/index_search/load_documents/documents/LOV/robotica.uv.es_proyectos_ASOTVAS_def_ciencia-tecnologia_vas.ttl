    rdfs:comment "Sensor WaterVapourFlux_g_EddyCovariance hosted by EddyCovariance_Station_1"@en ;
    sosa:isHostedBy ns3:EddyCovariance_Station_1 ;
    sosa:observes ns4:surface_water_evaporation_flux .

ns3:WindVane_AEMET_Sensor_UTIEL a owl:NamedIndividual,
        ns3:WindVane_AEMET ;
    rdfs:comment "Sensor WindVane_AEMET hosted by AEMET_UTIEL_Station"@en ;
    sosa:isHostedBy ns3:AEMET_UTIEL_Station ;
    sosa:observes ns4:wind_from_direction .

ns3:WindVane_EddyCovariance_Sensor_1 a owl:NamedIndividual,
        ns3:WindVane_EddyCovariance ;
    rdfs:comment "Sensor WindVane_EddyCovariance hosted by EddyCovariance_Station_1"@en ;
    sosa:isHostedBy ns3:EddyCovariance_Station_1 ;
    sosa:observes ns4:wind_from_direction .

ns3:Wind_Direction_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to wind direction. Angle Degree."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:wind_from_direction ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Air> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:onClass ns3:Wind_Direction_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns3:Ground_based_Observation .

ns3:Wind_Speed_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to wind speed. (m/s)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:wind_speed ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:onClass ns3:Wind_Speed_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Air> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        ns3:Ground_based_Observation .

ns3:acquisitionPeriod a owl:DatatypeProperty ;
    rdfs:label "Adquisition Period" ;
    rdfs:subPropertyOf ns3:sentinel3ProductProperties .

ns3:hasSatelliteSource a owl:ObjectProperty ;
    rdfs:comment "The satellite products have satellite sources"@en ;
    rdfs:domain ns3:Satellite_Product ;
    rdfs:range ns3:Satellite ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ns3:isSatelliteSourceOf .

ns3:hasTypeOfCover a owl:ObjectProperty ;
    rdfs:comment "The property indicates the type of cover classes."@en ;
    rdfs:range ns3:Land_Cover_Classes .

ns3:smosProductsProperties a owl:DatatypeProperty ;
    rdfs:comment "SMOS product properties"@en ;
    rdfs:domain ns3:SMOS_Product .

<http://aemet.linkeddata.es/ontology/Anemometer> a owl:Class ;
    rdfs:label "Anemometer_AEMET"@en ;
    rdfs:comment "Measures the intensity (m/s) of the wind"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/WeatherStation> ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Anemometer .

<http://aemet.linkeddata.es/ontology/Barometer> a owl:Class ;
    rdfs:label "Barometer_AEMET"@en ;
    rdfs:comment "Measures pressure in hPa. AEMET Station."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/WeatherStation> ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Barometer .

<http://aemet.linkeddata.es/ontology/Heliograph> a owl:Class ;
    rdfs:label "Heliograph_AEMET"@en ;
    rdfs:comment "Sensor belongs to AEMET Station.Measures the duration of sunshine in hours"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:duration_of_sunshine ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/WeatherStation> ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Ground_Based_Sensing .

<http://aemet.linkeddata.es/ontology/Hygrometer> a owl:Class ;
    rdfs:label "Hygrometer_AEMET"@en ;
    rdfs:comment "Sensor belongs to AEMET Station. Measures relative humidity in %"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/WeatherStation> ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Hygrometer .

<http://aemet.linkeddata.es/ontology/Pluviometer> a owl:Class ;
    rdfs:label "Pluviometer"@en,
        "Pluviometer_AEMET"@en,
        "Sensor belongs to AEMET Station. Measures precipitation in mm = l/m^2"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/WeatherStation> ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue <https://mmisw.org/ont/ioos/parameter/precipitation_amount> ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

<http://aemet.linkeddata.es/ontology/Thermometer> a owl:Class ;
    rdfs:label "Thermometer_AEMET"@en ;
    rdfs:comment "Sensor belongs to AEMET Station. Measures temperature in degrees Celsius both on Ground or in Air."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns3:temperature_in_ground_depth_05 ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/WeatherStation> ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns3:temperature_in_ground_next_ground ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns3:temperature_in_ground_depth_20 ;
            owl:onProperty sosa:observes ],
        ns3:Thermometer .

<http://aims.fao.org/aos/agrovoc/c_1333> a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "CRI"@en ;
    rdfs:comment "Carotenoid Reflectance Index 1 (CRI1) Carotenoids function in light absorption processes in plants, as well as in protecting plants from the harmful effects of too much light. Weakening vegetation contains higher concentrations of carotenoids, so this index is one measure of stressed vegetation. Higher CRI1 values mean greater carotenoid concentration relative to chlorophyll. The value of this index ranges from 0 to more than 15. The common range for green vegetation is 1 to 12. This index uses reflectance measurements in the visible spectrum to take advantage of the absorption signatures of stress-related pigments. See Narrowband Definitions for the allowable range of wavelengths."@en ;
    sosa:isObservedBy ns3:CRI_UAV_Hyperspectral_Sensor_1 .

<http://aims.fao.org/aos/agrovoc/c_34790> a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "DBH"@en ;
    rdfs:comment "Diameter at Breast Height (DBH). Diameter is generally measured 1.3 m. (4.5 feet) above the ground, which is roughly at breast height. DBH is measured on standing trees outside of the bark."@en ;
    sosa:isObservedBy ns3:DBH_UAV_LiDAR_Sensor_1 .

<http://dbpedia.org/resource/Diffuse_sky_radiation> a owl:NamedIndividual,
        ns3:Radiation_Property ;
    rdfs:label "diffuse_irradiance"@en ;
    rdfs:comment "Diffuse irradiation is the one that reaches the earth's surface from the sky except for the sun due to the scattering and reflection by the compositions of the atmosphere."@en ;
    sosa:isObservedBy ns3:I_dif_g_RAD_Sensor_1 .

<http://dbpedia.org/resource/Direct_insolation> a owl:NamedIndividual,
        ns3:Radiation_Property ;
    rdfs:label "direct_irradiance_at_the_surface"@en ;
    rdfs:comment "Direct radiation is the solar radiation which travels on a straight line from the sun down to the earth׳s surface"@en ;
    sosa:isObservedBy ns3:I_dir_g_RAD_Sensor_1 .

<http://dbpedia.org/resource/Orthophoto> a <http://dbpedia.org/resource/Soil_Property>,
        owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:comment "geometrically corrected aerial photograph"@en ;
    sosa:isObservedBy ns3:Orthophoto_UAV_RGB_Sensor_1 .

<http://dbpedia.org/resource/Plant_disease> a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "DiseaseStatus" ;
    rdfs:comment "Spectral indicator of plant disease or pathogen-induced stress."@en ;
    sosa:isObservedBy ns3:DiseaseStatus_UAV_Hyperspectral_Sensor_1 .

<http://qudt.org/vocab/quantitykind/Length> a owl:NamedIndividual ;
    rdfs:comment "Length" .

<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Autonomia> a owl:Class ;
    rdfs:label "Autonomy"@en ;
    rdfs:comment "Autonomy (Autonomous Community or Autonomous City) to which a geographical phenomenon or an administrative entity belongs"@en,
        "Uniprovincial or multiprovincial entity with specific territorial limits within the kingdom of Spain, which is endowed with legislative autonomy and executive powers in everything that is not common with the rest of the State."@en ;
    rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
    rdfs:subClassOf ns2:AdministrativeArea .

<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia> a owl:Class ;
    rdfs:label "Province"@en ;
    rdfs:comment "A province is a subnational entity of the State"@en,
        "In Spain, < regionName >  in Tpeg Location or < administrativeArea > in Location ReferencePoint"@en ;
    rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
    rdfs:subClassOf ns2:AdministrativeArea .

<http://www.opengis.net/ont/gml#AbstractGeometry> a owl:Class ;
    rdfs:label "Abstract Geometry"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf geo:Geometry .

<http://www.opengis.net/ont/gml#AbstractGriddedSurface> a owl:Class ;
    rdfs:label "Abstract Gridded Surface"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractParametricCurveSurface> .

<http://www.opengis.net/ont/gml#Composite> a owl:Class ;
    rdfs:label "Composite"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#GeometricComplex> .

<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a owl:Class ;
    rdfs:label "SpatialThing",
        "Spatial thing"@en ;
    rdfs:comment "Anything with spatial extent, i.e. size, shape, or position.\\n e.g. people, places, bowling balls, as well as abstract areas like cubes.",
        "Anything with spatial extent, i.e. size, shape, or position.\\n e.g. people, places, bowling balls, as well as abstract areas like cubes.\\n",
        "Spatial thing"@en ;
    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Geo_WGS84> .

<http://www.w3.org/2003/01/geo/wgs84_pos#location> a owl:ObjectProperty ;
    owl:equivalentProperty ns3:locatedIn .

skos:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    owl:disjointWith skos:Concept,
        skos:ConceptScheme ;
    skos:definition "A meaningful collection of concepts."@en ;
    skos:scopeNote "Labelled collections can be used where you would like a set of concepts to be displayed under a 'node label' in the hierarchy."@en .

ns4:duration_of_sunshine a owl:NamedIndividual,
        ns3:Atmosphere_Property ;
    dc:source "https://mmisw.org/ont/cf/parameter/"@en ;
    rdfs:comment "The WMO definition of sunshine is that the surface incident radiative flux from the solar beam (i.e. excluding diffuse skylight) exceeds 120 W m-2. 'Duration' is the length of time for which a condition holds."@en ;
    sosa:isObservedBy ns3:Heliograph_AEMET_Sensor_UTIEL .

ns4:land_cover_lccs a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "Landcover"@en ;
    dc:source "Climate and Forecast (CF) Standard Names (v.78). http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "A variable with the standard name of land_cover_lccs contains strings which indicate the nature of the surface, e.g. cropland_..., tree_... . Each string should represent a land cover class constructed using the Land Cover Classification System (LCCS; Di Gregorio A., 2005, UN Land Cover Classification System (LCCS) - Classification concepts and user manual for Software version 2; available at www.fao.org/DOCREP/003/X0596E/X0596e00.htm). String values should represent the classifiers used to define each class." ;
    sosa:isObservedBy ns3:LandCover_S2_Sensor_1 .

ns4:leaf_mass_content_of_nitrogen a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "Nitrogen_Concentration" ;
    dc:description "Nitrogen dioxide or nitrogen(IV) oxide (NO2) is a chemical compound composed of the elements nitrogen and oxygen, one of the major pollutants among the various nitrogen oxides. Nitrogen dioxide has a brownish-yellow color. It forms as a byproduct in high-temperature combustion processes, such as those in motor vehicles and power plants. Therefore, it is a common pollutant in urban areas."@en ;
    sosa:isObservedBy ns3:N2_g_Sensor_1 .

ns4:soil_albedo a owl:NamedIndividual,
        ns3:Radiation_Property ;
    dc:source "Climate and Forecast (CF) Standard Names (v.78). http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "Soil albedo is the albedo of the soil surface assuming no snow. Albedo is the ratio of outgoing to incoming shortwave irradiance, where 'shortwave irradiance' means that both the incoming and outgoing radiation are integrated across the solar spectrum." ;
    sosa:isObservedBy ns3:SurfaceAlbedo_g_RAD_Sensor_1 ;
    ns4:canonical_units "1" .

ns4:surface_downwelling_longwave_flux_in_air a owl:NamedIndividual,
        ns3:Radiation_Property ;
    dc:source "Climate and Forecast (CF) Standard Names. http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "The surface called surface means the lower boundary of the atmosphere. Downwelling radiation is radiation from above. It does not mean net downward. The sign convention is that upwelling is positive upwards and downwelling is positive downwards. The term longwave means longwave radiation. When thought of as being incident on a surface, a radiative flux is sometimes called irradiance. In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called vector irradiance. In accordance with common usage in geophysical disciplines, flux implies per unit area, called flux density in physics." ;
    sosa:isObservedBy ns3:LW_down_g_RAD_Sensor_1 ;
    ns4:canonical_units "W m-2" .

ns4:surface_downwelling_shortwave_flux_in_air a owl:NamedIndividual,
        ns3:Radiation_Property ;
    dc:source "Climate and Forecast (CF) Standard Names. http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "The surface called surface means the lower boundary of the atmosphere. Downwelling radiation is radiation from above. It does not mean net downward. The sign convention is that upwelling is positive upwards and downwelling is positive downwards. The term shortwave means shortwave radiation. Surface downwelling shortwave is the sum of direct and diffuse solar radiation incident on the surface, and is sometimes called global radiation. When thought of as being incident on a surface, a radiative flux is sometimes called irradiance. In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called vector irradiance. In accordance with common usage in geophysical disciplines, flux implies per unit area, called flux density in physics." ;
    sosa:isObservedBy ns3:SW_down_g_RAD_Sensor_1 ;
    ns4:canonical_units "W m-2" .

ns4:surface_water_evaporation_flux a owl:NamedIndividual,
        ns3:Land_Atmosphere_Interaction_Property ;
    dc:source "Climate and Forecast (CF) Standard Names (v.78). http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "The surface called surface means the lower boundary of the atmosphere. Water means water in all phases, including frozen i.e. ice and snow. Evaporation is the conversion of liquid or solid into vapor. (The conversion of solid alone into vapor is called sublimation). The quantity with standard name surface_water_evaporation_flux does not include transpiration from vegetation. In accordance with common usage in geophysical disciplines, flux implies per unit area, called flux density in physics. Unless indicated in the cell_methods attribute, a quantity is assumed to apply to the whole area of each horizontal grid box. Previously, the qualifier where_type was used to specify that the quantity applies only to the part of the grid box of the named type. Names containing the where_type qualifier are deprecated and newly created data should use the cell_methods attribute to indicate the horizontal area to which the quantity applies." ;
    sosa:isObservedBy ns3:WaterVapourFlux_g_EddyCovariance_Sensor_1 ;
    ns4:canonical_units "kg m-2 s-1" .

ns4:upward_latent_heat_flux_in_air a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    dc:source "https://mmisw.org/ont/cf/parameter/"@en ;
    rdfs:comment "\"Upward\" indicates a vector component which is positive when directed upward (negative downward). The latent heat flux is the exchange of heat across a surface on account of evaporation and condensation (including sublimation and deposition). In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en ;
    sosa:isObservedBy ns3:LE_g_EddyCovariance_Sensor_1 .

ns4:upwelling_longwave_flux_in_air a owl:NamedIndividual,
        ns3:Radiation_Property ;
    dc:source "Climate and Forecast (CF) Standard Names (v.78). http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "The term longwave means longwave radiation. Upwelling radiation is radiation from below. It does not mean net upward. The sign convention is that upwelling is positive upwards and downwelling is positive downwards. When thought of as being incident on a surface, a radiative flux is sometimes called irradiance. In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called vector irradiance. In accordance with common usage in geophysical disciplines, flux implies per unit area, called flux density in physics." ;
    sosa:isObservedBy ns3:LW_up_g_RAD_Sensor_1 ;
    ns4:canonical_units "W m-2" .

ns4:upwelling_shortwave_flux_in_air a owl:NamedIndividual,
        ns3:Radiation_Property ;
    dc:source "Climate and Forecast (CF) Standard Names (v.78). http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "The term shortwave means shortwave radiation. Upwelling radiation is radiation from below. It does not mean net upward. The sign convention is that upwelling is positive upwards and downwelling is positive downwards. When thought of as being incident on a surface, a radiative flux is sometimes called irradiance. In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called vector irradiance. In accordance with common usage in geophysical disciplines, flux implies per unit area, called flux density in physics." ;
    sosa:isObservedBy ns3:SW_up_g_RAD_Sensor_1 ;
    ns4:canonical_units "W m-2" .

<https://mmisw.org/ont/ioos/parameter/precipitation_amount> a owl:NamedIndividual,
        ns3:Atmosphere_Property ;
    dc:source "https://mmisw.org/ont/ioos/parameter/"@en ;
    rdfs:comment "The deposit of atmospheric moisture as rain, hail, sleet, snow, frost or dew. Precipition amount is often measured as depth of liquid equivalent moisture at a point but also can be expressed as liquid volume or mass per unit area."@en,
        "mm | ml | kg m-2"@en ;
    sosa:isObservedBy ns3:Pluviometer_AEMET_Sensor_UTIEL .

<https://mmisw.org/ont/mmi/usglobec/heat_flux_sens> a owl:NamedIndividual,
        ns3:Land_Atmosphere_Interaction_Property ;
    rdfs:label "sensible_heat_flux"@en ;
    rdfs:comment "Sensible heat flux refers to the transfer of heat energy between the Earth's surface and the atmosphere due to a difference in temperature. A positive sensible heat flux means heat is flowing from the atmosphere to the surface. A negative sensible heat flux means heat is flowing from the surface to the atmosphere."@en ;
    rdfs:seeAlso "https://codes.ecmwf.int/grib/param-db/?id=3122"@en,
        "https://lod.nal.usda.gov/nalt/325659"@en ;
    sosa:isObservedBy ns3:Hs_g_EddyCovariance_Sensor_1 .

<https://mmisw.org/ont/~mjuckes/cmip_variables_alpha/netAtmosLandCO2Flux> a owl:NamedIndividual,
        ns3:Land_Atmosphere_Interaction_Property ;
    rdfs:label "Carbon_Dioxide_Flux" ;
    rdfs:comment "Carbon dioxide (CO2) flux refers to the movement or exchange of carbon dioxide between different parts of the Earth's environment, such as the atmosphere, land, and oceans."@en ;
    sosa:isObservedBy ns3:CarbonDioxideFlux_g_EddyCovariance_Sensor_1 .

ns3:10km_x_10km a owl:NamedIndividual,
        ns3:ControlArea ;
    rdfs:label "10x10 Area" ;
    geo:hasGeometry ns3:GeoArea10x10 ;
    rdfs:comment "A Control Area is a spatially delimited region designated to enable consistent environmental observations, calibration activities, and cross-platform validation. It provides a reference zone where measurements can be collected under controlled or well-characterized conditions. Dimension 10 x10."@en ;
    ns3:locatedInProvince <http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia> .

ns3:Anemometer_EddyCovariance a owl:Class ;
    rdfs:comment "Measures the intensity (m/s) of the wind"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:EddyCovariance_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Anemometer .

ns3:Barometer_EddyCovariance a owl:Class ;
    rdfs:comment "Measures pressure in kPa. EddyCovariance Station."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:EddyCovariance_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Barometer .

ns3:Canopy_Height_Model a <http://dbpedia.org/resource/Soil_Property>,
        owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "CHM"@en ;
    rdfs:comment "Canopy Height Model (CHM)\\nThe CHM is a derived LiDAR product that represents vegetation height above ground, computed as the difference between the DSM and the DTM:\\n\\nCHM = DSM − DTM\\n\\nIt is delivered as a raster map in meters (m)."@en ;
    sosa:isObservedBy ns3:CHM_UAV_LiDAR_Sensor_1 .

ns3:CarbonDioxideFlux_g a owl:Class ;
    rdfs:comment "Sensor that takes carbon dioxide flow measurements"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://mmisw.org/ont/~mjuckes/cmip_variables_alpha/netAtmosLandCO2Flux> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:EddyCovariance_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Ground_Based_Sensing .

ns3:Chl_g a owl:Class ;
    rdfs:comment "Sensor that takes Chlorophyll measurements. From Chl Station."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Chlorophyll> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Chl_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Ground_Based_Sensing .

ns3:DHP_Station_1 a owl:NamedIndividual,
        ns3:DHP_Station ;
    geo:hasGeometry ns3:GeoDHPStation1 ;
    rdfs:comment "DHP Station number 1"@en ;
    sosa:hosts ns3:FAPAR_dhp_Sensor_1,
        ns3:FCOVER_dhp_Sensor_1,
        ns3:LAI_dhp_Sensor_1 ;
    ns3:controlArea ns3:1km_x_1km ;
    ns3:hasTypeOfCover ns3:Vineyards ;
    ns3:locatedInMunicipality <https://sws.geonames.org/6361960/> ;
    ns3:locatedInProvince <http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia> .

ns3:DHP_Station_2 a owl:NamedIndividual,
        ns3:DHP_Station ;
    geo:hasGeometry ns3:GeoDHPStation2 ;
    rdfs:comment "DHP Station number 2"@en ;
    sosa:hosts ns3:FAPAR_dhp_Sensor_2,
        ns3:FCOVER_dhp_Sensor_2,
        ns3:LAI_dhp_Sensor_2 ;
    ns3:controlArea ns3:1km_x_1km ;
    ns3:hasTypeOfCover <https://robotica.uv.es/proyectos/ASOTVAS/def/ciencia-tecnologia/vas#Fruit_trees_and_berry_plantations_(olive,_almond)> ;
    ns3:locatedInMunicipality <https://sws.geonames.org/6361960/> ;
    ns3:locatedInProvince <http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia> .

ns3:DHP_Station_3 a owl:NamedIndividual,
        ns3:DHP_Station ;
    geo:hasGeometry ns3:GeoDHPStation3 ;
    rdfs:comment "DHP Station number 3"@en ;
    sosa:hosts ns3:FAPAR_dhp_Sensor_3,
        ns3:FCOVER_dhp_Sensor_3,
        ns3:LAI_dhp_Sensor_3 ;
    ns3:controlArea ns3:10km_x_10km ;
    ns3:hasTypeOfCover ns3:Sclerophyllous_vegetation ;
    ns3:locatedInMunicipality <https://sws.geonames.org/6361960/> ;
    ns3:locatedInProvince <http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia> .

ns3:Digital_Surface_Model a <http://dbpedia.org/resource/Soil_Property>,
        owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "DSM"@en ;
    rdfs:comment "Digital Surface Model (DSM).\\nA DSM is a LiDAR-derived raster representing the elevation of the uppermost surfaces in the scene, including vegetation, buildings, and all above-ground objects. Pixel values correspond to absolute height in meters (m)."@en ;
    sosa:isObservedBy ns3:DSM_UAV_LiDAR_Sensor_1 .

ns3:Digital_Terrain_Model a <http://dbpedia.org/resource/Soil_Property>,
        owl:NamedIndividual ;
    rdfs:label "DTM"@en ;
    rdfs:comment "Digital Terrain Model (DTM).\\nA DTM is a LiDAR-derived raster representing the elevation of the bare ground surface, with vegetation and artificial structures removed. Each pixel stores the ground height expressed in meters (m)."@en ;
    sosa:isObservedBy ns3:DTM_UAV_LiDAR_Sensor_1 .

ns3:FAPAR_Result a owl:Class ;
    rdfs:comment "Result that normally is obtained by fraction of absorved photosynthetically active radiation (FAPAR) sensors. Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/NUM> ;
            owl:onProperty ns1:unit ],
        sosa:Result .

ns3:Hs_g a owl:Class ;
    rdfs:comment "Sensor that takes sensible heat flux measurements"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://mmisw.org/ont/mmi/usglobec/heat_flux_sens> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:EddyCovariance_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Ground_Based_Sensing .

ns3:Hygrometer_EddyCovariance a owl:Class ;
    rdfs:comment "Sensor belongs to EddyCovariance Station. Measures relative humidity in %"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:EddyCovariance_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Hygrometer .

ns3:I_dif_g a owl:Class ;
    rdfs:comment "Sensor that takes \"diffuse irradiance at the surface\" measurements in RAD Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Diffuse_sky_radiation> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RAD_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Ground_Based_Sensing .

ns3:I_dir_g a owl:Class ;
    rdfs:comment "Sensor that takes \"direct irradiance at the surface\" measurements in RAD Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RAD_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Direct_insolation> ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:LAI_Result a owl:Class ;
    rdfs:comment "Result that is normally obtained by Leaf Area Index (LAI) sensors. Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/NUM> ;
            owl:onProperty ns1:unit ],
        sosa:Result .

ns3:LAI_Satellite_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Leaf Area Index (LAI). Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:leaf_area_index ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:onClass ns3:LAI_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns3:Satellite_Observation .

ns3:LAI_Station a owl:Class ;
    rdfs:label "LAI_Station"@en ;
    rdfs:comment "Class that represents Leaf Aea Index (LAI) stations"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:LAI_g ;
            owl:onProperty sosa:hosts ],
        ns3:Ground_Station .

ns3:LE_g a owl:Class ;
    rdfs:comment "Sensor that takes evapotranspiration measurements"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:upward_latent_heat_flux_in_air ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:EddyCovariance_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Ground_Based_Sensing .

ns3:LST_Result a owl:Class ;
    rdfs:comment "Result that is normally obtained by Land Surface Temperature (LST) sensors.  Unit of measure Degree Celsius ."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
            owl:onProperty ns1:unit ],
        sosa:Result .

ns3:LST_g a owl:Class ;
    rdfs:comment "Sensor that takes Land Surface Temperature measurements"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:surface_temperature ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:LST_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Ground_Based_Sensing .

ns3:LW_down_g a owl:Class ;
    rdfs:comment "Sensor that takes \"surface downwelling longwave flux in air\" measurements in RAD Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:surface_downwelling_longwave_flux_in_air ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RAD_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Ground_Based_Sensing .

ns3:LW_up_g a owl:Class ;
    rdfs:comment "Sensor that takes \"upwelling longwave flux in air\" measurements in RAD Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RAD_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:upwelling_longwave_flux_in_air ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:METEOSAT_Product_1 a owl:NamedIndividual,
        ns3:METEOSAT_Product ;
    rdfs:comment "METEOSAT Station number 1"@en ;
    sosa:hosts ns3:CloudMask_METEOSAT_Sensor_1,
        ns3:CloudType_METEOSAT_Sensor_1,
        ns3:PWC_METEOSAT_Sensor_1 .

ns3:N2_g a owl:Class ;
    rdfs:comment "Sensor that takes nitrogen dioxide measurements. From N2 Station."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:N2_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:leaf_mass_content_of_nitrogen ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:Nitrogen_Reflectance_Index a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "NRI"@en ;
    rdfs:comment "The Nitrogen Reflectance Index (NRI) is a spectral index designed to estimate the nitrogen status of vegetation using reflectance measurements in the visible region. It exploits the sensitivity of chlorophyll‐related absorption features to nitrogen concentration."@en .

ns3:Normalized_Difference_Water_Index a <http://dbpedia.org/resource/Soil_Property>,
        owl:NamedIndividual ;
    rdfs:label "NDWI"@en ;
    rdfs:comment "NDWI – Normalized Difference Water Index\\nEstimates leaf water content and moisture conditions using narrowband reflectance in the NIR and SWIR (or Green–NIR). It is sensitive to vegetation water status and widely used in stress detection."@en ;
    sosa:isObservedBy ns3:NRI_UAV_Hyperspectral_Sensor_1 .

ns3:RN_g a owl:Class ;
    rdfs:comment "Sensor that takes \"surface net radiation\" measurements in RAD Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RAD_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns3:surface_net_radiation ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:RS_UAV_Microwave a owl:Class ;
    rdfs:comment "Represents the general sensorization of RS_UAV_Microwave. Observes SM."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Soil_moisture> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:UAV_Microwave ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Remote_Sensing_UAVs .

ns3:RS_UAV_RGB a owl:Class ;
    rdfs:comment "Represents the general sensorization of RS_UAV_RGB. Observes  ORTHOPHOTO"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Orthophoto> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:UAV_RGB ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Remote_Sensing_UAVs .

ns3:RS_UAV_Thermal a owl:Class ;
    rdfs:comment "Represents the general sensorization of RS_UAV_Thermal. Observes  LST."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:surface_temperature ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:UAV_Thermal ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Remote_Sensing_UAVs .

ns3:SAVI_Satellite_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Soil Adjusted Vegetation Index (SAVI). Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:onClass ns3:SAVI_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Soil-adjusted_vegetation_index> ;
            owl:onProperty sosa:observedProperty ],
        ns3:Satellite_Observation .

ns3:SMAP_Product_1 a owl:NamedIndividual,
        ns3:SMAP_Product ;
    rdfs:comment "SMAP Product number 1"@en ;
    sosa:hosts ns3:SM_SMAP-S1_3km_Sensor_1,
        ns3:SM_SMAP-S1_9km_Sensor_1,
        ns3:SM_SMAP_36km_Sensor_1 .

ns3:SM_Result a owl:Class ;
    rdfs:comment "Result that is normally obtained by SM (Soil Moisture) sensors. Unit of measure Cubic Metre per Cubic Metre."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/M3-PER-M3> ;
            owl:onProperty ns1:unit ],
        [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        sosa:Result .

ns3:SR_Satellite_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Simple Ratio (SR). Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns3:SR_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue ns3:simple_ratio ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        ns3:Satellite_Observation .

ns3:SW_down_g a owl:Class ;
    rdfs:comment "Sensor that takes \"surface downwelling shortwave flux in air\" measurements in RAD Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RAD_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:surface_downwelling_shortwave_flux_in_air ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:SW_up_g a owl:Class ;
    rdfs:comment "Sensor that takes \"upwelling shortwave flux in air\" measurements in RAD Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RAD_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:upwelling_shortwave_flux_in_air ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:Temperature_in_ground_AEMET_Observation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Soil> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        ns3:Temperature_AEMET_Observation ;
    skos:definition "Observation of the temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en .

ns3:Thermometer_EddyCovariance a owl:Class ;
    rdfs:comment "Sensor belongs to EddyCovariance Station. Measures temperature in degrees Celsius"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:EddyCovariance_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Thermometer .

ns3:WaterVapourFlux_g a owl:Class ;
    rdfs:comment "Sensor that takes water flow measurements"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:EddyCovariance_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:surface_water_evaporation_flux ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:cloud_mask a owl:NamedIndividual,
        ns3:Atmosphere_Property ;
    rdfs:comment "A 'cloud mask' in remote sensing refers to a technique or dataset used to identify and delineate areas covered by clouds in an image captured from a satellite or other observation platform. This technique is crucial in remote sensing as clouds can obstruct visibility of the Earth's surface, making it challenging to interpret images and analyze data.\""@en ;
    sosa:isObservedBy ns3:CloudMask_METEOSAT_Sensor_1 .

ns3:cloud_type a owl:NamedIndividual,
        ns3:Atmosphere_Property ;
    rdfs:comment "\"'Cloud type' in remote sensing refers to the classification or categorization of clouds based on their visual characteristics and structural features observed in satellite or aerial imagery."@en ;
    sosa:isObservedBy ns3:CloudType_METEOSAT_Sensor_1 .

ns3:geo_WGS84 a owl:DatatypeProperty .

ns3:hasProduct a owl:ObjectProperty ;
    rdfs:label "has product"@en ;
    rdfs:comment "Someting (usually a snapshot) has product."@en ;
    rdfs:domain ns3:Snapshot ;
    rdfs:range ns3:Satellite_Product .

ns3:precipitable_water_content a owl:NamedIndividual,
        ns3:Atmosphere_Property,
        ns3:Land_Atmosphere_Interaction_Property ;
    rdfs:label "PWC"@en ;
    rdfs:comment "Precipitable Water Content (PWC) refers to the amount of water vapor present in a vertical column of the Earth's atmosphere. It is typically expressed in terms of thickness or depth, such as millimeters (mm) or inches (inches), and represents the total depth of liquid water that would result if all the water vapor in the column were condensed and collected."@en ;
    sosa:isObservedBy ns3:PWC_METEOSAT_Sensor_1 .

ns3:surface_net_radiation a owl:NamedIndividual,
        ns3:Radiation_Property ;
    rdfs:comment "Earth's net radiation, sometimes called net flux, is the balance between incoming and outgoing energy at the top of the atmosphere."@en ;
    sosa:isObservedBy ns3:RN_g_RAD_Sensor_1 .

ns3:temperature_in_ground_depth_05 a <http://dbpedia.org/resource/Soil_Property>,
        owl:NamedIndividual ;
    skos:definition "Subsoil temperature at a depth of 5 cm and corresponding to the 10 minutes prior to the date given by 'fint' (degrees Celsius)"@en,
        "The temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en ;
    sosa:isObservedBy ns3:Thermometer_AEMET_Sensor_UTIEL .

ns3:temperature_in_ground_depth_20 a <http://dbpedia.org/resource/Soil_Property>,
        owl:NamedIndividual ;
    skos:definition "Subsoil temperature at a depth of 20 cm and corresponding to the 10 minutes prior to the date given by 'fint' (degrees Celsius)"@en,
        "The temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en ;
    sosa:isObservedBy ns3:Thermometer_AEMET_Sensor_UTIEL .

ns3:temperature_in_ground_next_ground a <http://dbpedia.org/resource/Soil_Property>,
        owl:NamedIndividual ;
    skos:definition "Ground temperature, instantaneous temperature next to the ground and corresponding to the 10 minutes prior to the date given by 'fint' (degrees Celsius)"@en,
        "The temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en ;
    sosa:isObservedBy ns3:Thermometer_AEMET_Sensor_UTIEL .

<https://www.w3.org/2005/Incubator/ssn/ssnx/meteo/aws#Albedometer> a owl:Class ;
    rdfs:label "SurfaceAlbedo_g" ;
    rdfs:comment "Sensor that takes \"soil albedo\" measurements in RAD Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RAD_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:soil_albedo ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

<http://qudt.org/vocab/unit/M> a ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Metre"@en,
        "Meter"@en-us ;
    dcterms:description "The metric and SI base unit of distance.  The 17th General Conference on Weights and Measures in 1983 defined the meter as that distance that makes the speed of light in a vacuum equal to exactly 299 792 458 meters per second. The speed of light in a vacuum, \\\\(c\\\\), is one of the fundamental constants of nature. The meter is equal to approximately 1.093 613 3 yards, 3.280 840 feet, or 39.370 079 inches."^^ns1:LatexString ;
    ns1:conversionMultiplier 1.0 ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Metre"^^xsd:anyURI ;
    ns1:definedUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Length> ;
    ns1:iec61360Code "0112/2///62720#UAA726" ;
    ns1:informativeReference "http://en.wikipedia.org/wiki/Metre?oldid=495145797"^^xsd:anyURI ;
    ns1:isUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> ;
    ns1:plainTextDescription "The metric and SI base unit of distance.   The meter is equal to approximately 1.093 613 3 yards, 3.280 840 feet, or 39.370 079 inches." ;
    ns1:symbol "m" ;
    ns1:ucumCode "m"^^ns1:UCUMcs ;
    ns1:udunitsCode "m" ;
    ns1:uneceCommonCode "MTR" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio> a owl:Class ;
    rdfs:label "Municipality"@en ;
    rdfs:comment "A municipality is an administrative entity that can group a single locality or several, it can refer to a city or a town."@en ;
    rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
    rdfs:subClassOf ns2:AdministrativeArea .

<http://www.opengis.net/ont/gml#MultiGeometry> a owl:Class ;
    rdfs:label "Multi-Geometry"@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/gml> ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometry> .

skos:mappingRelation a owl:ObjectProperty ;
    rdfs:label "is in mapping relation with"@en ;
    rdfs:comment "These concept mapping relations mirror semantic relations, and the data model defined below is similar (with the exception of skos:exactMatch) to the data model defined for semantic relations. A distinct vocabulary is provided for concept mapping relations, to provide a convenient way to differentiate links within a concept scheme from links between concept schemes. However, this pattern of usage is not a formal requirement of the SKOS data model, and relies on informal definitions of best practice."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    skos:definition "Relates two concepts coming, by convention, from different schemes, and that have comparable meanings"@en .

skos:semanticRelation a owl:ObjectProperty ;
    rdfs:label "is in semantic relation with"@en ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:Concept ;
    skos:definition "Links a concept to a concept related by meaning."@en ;
    skos:scopeNote "This property should not be used directly, but as a super-property for all properties denoting a relationship of meaning between concepts."@en .

sosa:Actuator rdfs:label "Actuator"@en ;
    rdfs:comment "A device that is used by, or implements, an (Actuation) Procedure that changes the state of the world."@en ;
    skos:definition "A device that is used by, or implements, an (Actuation) Procedure that changes the state of the world."@en ;
    skos:example "A window actuator for automatic window control, i.e., opening or closing the window."@en .

sosa:Sampler rdfs:label "Sampler"@en ;
    rdfs:comment "A device that is used by, or implements, a Sampling Procedure to create or transform one or more samples."@en ;
    skos:definition "A device that is used by, or implements, a Sampling Procedure to create or transform one or more samples."@en ;
    skos:example "A ball mill, diamond drill, hammer, hypodermic syringe and needle, image Sensor or a soil auger can all act as sampling devices (i.e., be Samplers). However, sometimes the distinction between the Sampler and the Sensor is not evident, as they are packaged as a unit. A Sampler need not be a physical device."@en .

ns4:air_pressure a <http://dbpedia.org/resource/Meteorology_Property>,
        owl:NamedIndividual ;
    dc:source "Climate and Forecast (CF) Standard Names. http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "Air pressure is the force per unit area which would be exerted when the moving gas molecules of which the air is composed strike a theoretical surface of any orientation." ;
    sosa:isObservedBy ns3:Barometer_AEMET_SENSOR_UTIEL,
        ns3:Barometer_EddyCovariance_Sensor_1 ;
    ns4:canonical_units "Hectopascal or Kilopascal" .

ns4:wind_from_direction a <http://dbpedia.org/resource/Meteorology_Property>,
        owl:NamedIndividual ;
    dc:source "Climate and Forecast (CF) Standard Names. http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.) In meteorological reports, the direction of the wind vector is usually (but not always) given as the direction from which it is blowing (wind_from_direction) (westerly, northerly, etc.). In other contexts, such as atmospheric modelling, it is often natural to give the direction in the usual manner of vectors as the heading or the direction to which it is blowing (wind_to_direction) (eastward, southward, etc.) from_direction is used in the construction X_from_direction and indicates the direction from which the velocity vector of X is coming." ;
    sosa:isObservedBy ns3:WindVane_AEMET_Sensor_UTIEL,
        ns3:WindVane_EddyCovariance_Sensor_1 ;
    ns4:canonical_units "degree" .

ns4:wind_speed a <http://dbpedia.org/resource/Meteorology_Property>,
        owl:NamedIndividual ;
    dc:source "Climate and Forecast (CF) Standard Names. http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "Speed is the magnitude of velocity. Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.) The wind speed is the magnitude of the wind velocity." ;
    sosa:isObservedBy ns3:Anemometer_AEMET_Sensor_UTIEL,
        ns3:Anemometer_EddyCovariance_Sensor_1 ;
    ns4:canonical_units "m s-1" .

<https://mmisw.org/ont/ioos/parameter/relative_humidity> a <http://dbpedia.org/resource/Meteorology_Property>,
        owl:NamedIndividual ;
    dc:source "https://mmisw.org/ont/ioos/parameter/"@en ;
    rdfs:comment "Amount of moisture in the air as vapor relative to how much it can possibly hold at the same temperature."@en ;
    sosa:isObservedBy ns3:Hygrometer_AEMET_Sensor_UTIEL,
        ns3:Hygrometer_EddyCovariance_Sensor_1 .

ns3:Bare_Soils a owl:NamedIndividual,
        ns3:Land_Cover_Classes ;
    rdfs:label "Bare Soils"@en ;
    rdfs:comment "A soil surface devoid of any plant material."@en ;
    ns3:code_CLC 331 .

ns3:Chl_Satellite_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Chlorophyll content. Micromoles of chlorophyll per square metre of leaf surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Chlorophyll> ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:onClass ns3:Chl_Satellite_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        ns3:Satellite_Observation .

ns3:LAI_g a owl:Class ;
    rdfs:comment "Leaf Area Index Sensor from Leaf Area Index (LAI) Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:LAI_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:leaf_area_index ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:RS_Sentinel-3_OLCI a owl:Class ;
    rdfs:comment "Represents the general sensorization of satellite Sentinel 3 ( S3)  OLCI. Observes FAPAR , Chl."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Sentinel-3_OLCI ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Chlorophyll> ;
            owl:onProperty sosa:observes ],
        ns3:Remote_Sensing_Satellites .

ns3:Sclerophyllous_vegetation a owl:NamedIndividual,
        ns3:Land_Cover_Classes ;
    rdfs:label "Sclerophyllous vegetation"@en ;
    rdfs:comment "Class Level 3 CORINE Land Cover - CLC"@en ;
    ns3:code_CLC 321 .

ns3:Snapshot a owl:Class ;
    rdfs:label "Snapshot"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns3:controlArea ;
                                    owl:someValuesFrom ns3:ControlArea ] [ a owl:Restriction ;
                                    owl:allValuesFrom ns3:ControlArea ;
                                    owl:onProperty ns3:controlArea ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns3:hasProduct ;
                                    owl:someValuesFrom ns3:Satellite_Product ] [ a owl:Restriction ;
                                    owl:allValuesFrom ns3:Satellite_Product ;
                                    owl:onProperty ns3:hasProduct ] ) ] ) ] .

ns3:commonProductProperties a owl:DatatypeProperty ;
    rdfs:label "CommonProperties"@en .

ns3:locatedIn a owl:ObjectProperty ;
    rdfs:label "Located in"@en ;
    rdfs:comment "Indicates the location of the stations."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( sosa:Platform ns3:ControlArea ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns2:AdministrativeArea <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ) ] .

ns3:smapProductProperties a owl:DatatypeProperty ;
    rdfs:comment "SMAP product properties"@en ;
    rdfs:domain ns3:SMAP_Product .

geo:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    dc:contributor "Matthew Perry" ;
    dc:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dc:date "2011-06-16"^^xsd:date ;
    dc:description "\\n      This class represents the top-level feature type. This class is \\n      equivalent to GFI_Feature defined in ISO 19156:2011, and it is \\n      superclass of all feature types.\\n    "@en ;
    rdfs:comment "\\n      This class represents the top-level feature type. This class is \\n      equivalent to GFI_Feature defined in ISO 19156:2011, and it is \\n      superclass of all feature types.\\n    "@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/ont/gml>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    rdfs:subClassOf geo:SpatialObject ;
    owl:disjointWith geo:Geometry ;
    skos:definition "\\n      This class represents the top-level feature type. This class is \\n      equivalent to GFI_Feature defined in ISO 19156:2011, and it is \\n      superclass of all feature types.\\n    "@en ;
    skos:prefLabel "Feature"@en .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A set of concepts, optionally including statements about semantic relationships between those concepts."@en ;
    skos:example "Thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', and other types of controlled vocabulary are all examples of concept schemes. Concept schemes are also embedded in glossaries and terminologies."@en ;
    skos:scopeNote "A concept scheme may be defined to include concepts from different sources."@en .

ns4:air_temperature a <http://dbpedia.org/resource/Meteorology_Property>,
        owl:NamedIndividual ;
    dc:source "Climate and Forecast (CF) Standard Names. http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "Air temperature is the bulk temperature of the air, not the surface (skin) temperature." ;
    sosa:isObservedBy ns3:Thermometer_AEMET_Sensor_UTIEL,
        ns3:Thermometer_EddyCovariance_Sensor_1 ;
    ns4:canonical_units "Celsius" .

ns4:vegetation_area_fraction a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    dc:source "Climate and Forecast (CF) Standard Names. http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "Area fraction is the fraction of a grid cell's horizontal area that has some characteristic of interest. It is evaluated as the area of interest divided by the grid cell area. It may be expressed as a fraction, a percentage, or any other dimensionless representation of a fraction. Vegetation means any plants e.g. trees, shrubs, grass. The term plants refers to the kingdom of plants in the modern classification which excludes fungi. Plants are autotrophs i.e. producers of biomass using carbon obtained from carbon dioxide." ;
    sosa:isObservedBy ns3:FCOVER_dhp_Sensor_1,
        ns3:FCOVER_dhp_Sensor_2,
        ns3:FCOVER_dhp_Sensor_3 ;
    ns4:canonical_units "1" .

ns3:Atmosphere_Property a owl:Class ;
    rdfs:comment "Class that represents all Atmosphere  properties"@en ;
    rdfs:subClassOf sosa:ObservableProperty .

ns3:EVI_Satellite_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Enhanced Vegetation Index (EVI). Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Enhanced_vegetation_index> ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:onClass ns3:EVI_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Soil> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] ) ],
        ns3:Satellite_Observation .

ns3:FAPAR_Satellite_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to fraction of absorved photosynthetically active radiation (FAPAR). Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:onClass ns3:FAPAR_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        ns3:Satellite_Observation .

ns3:FAPAR_Station a owl:Class ;
    rdfs:label "FAPAR_Station"@en ;
    rdfs:comment "Class that represents fraction of absorved photosynthetically active radiation stations"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:FAPAR_g ;
            owl:onProperty sosa:hosts ],
        ns3:Ground_Station .

ns3:FAPAR_dhp a owl:Class ;
    rdfs:comment "Sensor that takes fraction of surface downwelling photosynthetic radiative measurements. From Digital Hemispheric Picture (DHP) Station."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DHP_Station ;
            owl:onProperty sosa:isHostedBy ],
        ns3:Ground_Based_Sensing .

ns3:FCOVER_dhp a owl:Class ;
    rdfs:comment "Sensor that takes vegetation area fraction measurements. From Digital Hemispheric Picture (DHP) Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:DHP_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:vegetation_area_fraction ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:LAI_dhp a owl:Class ;
    rdfs:comment "Leaf Area Index Sensor from Digital Hemispheric Picture (DHP) Station"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:DHP_Station ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:leaf_area_index ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:Land_Atmosphere_Interaction_Property a owl:Class ;
    rdfs:comment "Class that represents all Land Atmosphere Interation properties"@en ;
    rdfs:subClassOf sosa:ObservableProperty .

ns3:MODIS-Aqua_Product a owl:Class ;
    rdfs:label "MODIS-Aqua_Product"@en ;
    rdfs:comment "Class that represents MODIS-Aqua Products"@en ;
    rdfs:subClassOf ns3:Satellite_Product .

ns3:MODIS-Terra_Product a owl:Class ;
    rdfs:label "MODIS-Terra_Product"@en ;
    rdfs:comment "Class that represents MODIS-Terra Products"@en ;
    rdfs:subClassOf ns3:Satellite_Product .

ns3:SMOS_Product a owl:Class ;
    rdfs:label "SMOS_Product"@en ;
    rdfs:comment "Class that represents SMOS satellite Products"@en ;
    rdfs:subClassOf ns3:Satellite_Product .

ns3:SM_Satellite_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Soil Moisture (SM). Unit of measure Cubic Metre per Cubic Metre."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Soil> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Soil_moisture> ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:onClass ns3:SM_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns3:Satellite_Observation .

ns3:Sentinel-3_Product a owl:Class ;
    rdfs:label "Sentinel-3_Product"@en ;
    rdfs:comment "Class that represents Sentinel-3 satellite Products"@en ;
    rdfs:subClassOf ns3:Satellite_Product .

