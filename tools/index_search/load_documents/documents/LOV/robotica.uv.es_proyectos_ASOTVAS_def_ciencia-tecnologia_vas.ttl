rdf:HTML a rdfs:Datatype .

xsd:date a rdfs:Datatype .

<http://www.w3.org/2003/01/geo/wgs84_pos#Point> a owl:Class ;
    rdfs:label "point",
        "Point"@en ;
    rdfs:comment " \\nUniquely identified by lat/long/alt. i.e.\\n\\nspaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),\\n  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).\\n\\nsameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).\\n  ",
        "A point, typically described using a coordinate system relative to Earth, such as WGS84.",
        "A point, typically described using a coordinate system relative to Earth, such as WGS84.\\n  ",
        "Uniquely identified by lat/long/alt. i.e.\\n\\nspaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),\\n  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).\\n\\nsameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2)." ;
    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#" ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

<http://www.w3.org/2003/01/geo/wgs84_pos#alt> a owl:DatatypeProperty ;
    rdfs:label "altitude"@en ;
    rdfs:comment "Altitude in WGS84"@en ;
    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en ;
    rdfs:subPropertyOf ns3:geo_WGS84 .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Latitude in WGS84"@en ;
    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf ns3:geo_WGS84 .

<http://www.w3.org/2003/01/geo/wgs84_pos#lon> a owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Longitude in WGS84"@en ;
    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf ns3:geo_WGS84 .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    rdfs:comment "The range of skos:altLabel is the class of RDF plain literals."@en,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "An alternative lexical label for a resource."@en ;
    skos:example "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)."@en .

skos:broadMatch a owl:ObjectProperty ;
    rdfs:label "has broader match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:broader,
        skos:mappingRelation ;
    owl:inverseOf skos:narrowMatch ;
    skos:definition "skos:broadMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .

skos:changeNote a owl:AnnotationProperty ;
    rdfs:label "change note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A note about a modification to a concept."@en .

skos:definition a owl:AnnotationProperty ;
    rdfs:label "definition"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A statement or formal explanation of the meaning of a concept."@en .

skos:editorialNote rdfs:label "editorial note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A note for an editor, translator or maintainer of the vocabulary."@en .

skos:exactMatch a owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "has exact match"@en ;
    rdfs:comment "skos:exactMatch is disjoint with each of the properties skos:broadMatch and skos:relatedMatch."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:closeMatch ;
    skos:definition "skos:exactMatch is used to link two concepts, indicating a high degree of confidence that the concepts can be used interchangeably across a wide range of information retrieval applications. skos:exactMatch is a transitive property, and is a sub-property of skos:closeMatch."@en .

skos:example a owl:AnnotationProperty ;
    rdfs:label "example"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "An example of the use of a concept."@en .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range skos:Concept ;
    owl:inverseOf skos:topConceptOf ;
    skos:definition "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies."@en .

skos:hiddenLabel rdfs:label "hidden label"@en ;
    rdfs:comment "The range of skos:hiddenLabel is the class of RDF plain literals."@en,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A lexical label for a resource that should be hidden when generating visual displays of the resource, but should still be accessible to free text search operations."@en .

skos:historyNote rdfs:label "history note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A note about the past state/use/meaning of a concept."@en .

skos:member a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:domain skos:Collection ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( skos:Collection skos:Concept ) ] ;
    skos:definition "Relates a collection to one of its members."@en .

skos:memberList a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has member list"@en ;
    rdfs:comment "For any resource, every item in the list given as the value of the\\n      skos:memberList property is also a value of the skos:member property."@en ;
    rdfs:domain skos:OrderedCollection ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range rdf:List ;
    skos:definition "Relates an ordered collection to the RDF list containing its members."@en .

skos:notation rdfs:label "notation"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A notation, also known as classification code, is a string of characters such as \"T58.5\" or \"303.4833\" used to uniquely identify a concept within the scope of a given concept scheme."@en ;
    skos:scopeNote "By convention, skos:notation is used with a typed literal in the object position of the triple."@en .

skos:note a owl:AnnotationProperty ;
    rdfs:label "note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A general note, for any purpose."@en ;
    skos:scopeNote "This property may be used directly, or as a super-property for more specific note types."@en .

skos:prefLabel a owl:AnnotationProperty ;
    rdfs:label "preferred label"@en ;
    rdfs:comment "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@en,
        "The range of skos:prefLabel is the class of RDF plain literals."@en,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise\\n      disjoint properties."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "The preferred lexical label for a resource, in a given language."@en .

skos:relatedMatch a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has related match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation,
        skos:related ;
    skos:definition "skos:relatedMatch is used to state an associative mapping link between two conceptual resources in different concept schemes."@en .

skos:scopeNote a owl:AnnotationProperty ;
    rdfs:label "scope note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A note that helps to clarify the meaning and/or the use of a concept."@en .

time:Instant a owl:Class .

time:hasBeginning a owl:AnnotationProperty .

time:hasEnd a owl:AnnotationProperty .

time:inXSDDateTimeStamp a owl:AnnotationProperty .

sosa:actsOnProperty a owl:ObjectProperty ;
    rdfs:label "acts on property"@en ;
    ns2:domainIncludes sosa:Actuation ;
    ns2:rangeIncludes sosa:ActuatableProperty ;
    rdfs:comment "Relation between an Actuation and the property of a FeatureOfInterest it is acting upon."@en ;
    owl:inverseOf sosa:isActedOnBy ;
    skos:definition "Relation between an Actuation and the property of a FeatureOfInterest it is acting upon."@en ;
    skos:example "In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property on which the Actuator acts upon is the state of the window as it changes from being open to being closed. "@en .

sosa:hasSample a owl:ObjectProperty ;
    rdfs:label "has sample"@en ;
    ns2:domainIncludes sosa:FeatureOfInterest ;
    ns2:rangeIncludes sosa:Sample ;
    rdfs:comment "Relation between a FeatureOfInterest and the Sample used to represent it."@en ;
    owl:inverseOf sosa:isSampleOf ;
    skos:definition "Relation between a FeatureOfInterest and the Sample used to represent it."@en .

sosa:hasSimpleResult rdfs:label "has simple result"@en ;
    ns2:domainIncludes sosa:Actuation,
        sosa:Observation,
        sosa:Sampling ;
    rdfs:comment "The simple value of an Observation or Actuation or act of Sampling."@en ;
    skos:definition "The simple value of an Observation or Actuation or act of Sampling."@en ;
    skos:example "For instance, the values 23 or true."@en .

sosa:isObservedBy a owl:ObjectProperty ;
    rdfs:label "is observed by"@en ;
    ns2:domainIncludes sosa:ObservableProperty ;
    ns2:rangeIncludes sosa:Sensor ;
    rdfs:comment "Relation between an ObservableProperty and the Sensor able to observe it."@en ;
    owl:inverseOf sosa:observes ;
    skos:definition "Relation between an ObservableProperty and the Sensor able to observe it."@en .

sosa:madeActuation a owl:ObjectProperty ;
    rdfs:label "made actuation"@en ;
    ns2:domainIncludes sosa:Actuator ;
    ns2:rangeIncludes sosa:Actuation ;
    rdfs:comment "Relation between an Actuator and the Actuation it has made."@en ;
    owl:inverseOf sosa:madeByActuator ;
    skos:definition "Relation between an Actuator and the Actuation it has made."@en .

sosa:madeBySampler a owl:ObjectProperty ;
    rdfs:label "made by sampler"@en ;
    ns2:domainIncludes sosa:Sampling ;
    ns2:rangeIncludes sosa:Sampler ;
    rdfs:comment "Relation linking an act of Sampling to the Sampler (sampling device or entity) that made it."@en ;
    owl:inverseOf sosa:madeSampling ;
    skos:definition "Relation linking an act of Sampling to the Sampler (sampling device or entity) that made it."@en .

sosa:phenomenonTime rdfs:label "phenomenon time"@en ;
    ns2:domainIncludes sosa:Actuation,
        sosa:Observation,
        sosa:Sampling ;
    ns2:rangeIncludes time:TemporalEntity ;
    rdfs:comment "The time that the Result of an Observation, Actuation or Sampling applies to the FeatureOfInterest. Not necessarily the same as the resultTime. May be an Interval or an Instant, or some other compound TemporalEntity."@en ;
    skos:definition "The time that the Result of an Observation, Actuation or Sampling applies to the FeatureOfInterest. Not necessarily the same as the resultTime. May be an Interval or an Instant, or some other compound TemporalEntity."@en .

sosa:usedProcedure rdfs:label "used procedure"@en ;
    ns2:domainIncludes sosa:Actuation,
        sosa:Observation,
        sosa:Sampling ;
    ns2:rangeIncludes sosa:Procedure ;
    rdfs:comment "A relation to link to a re-usable Procedure used in making an Observation, an Actuation, or a Sample, typically through a Sensor, Actuator or Sampler."@en ;
    skos:definition "A relation to link to a re-usable Procedure used in making an Observation, an Actuation, or a Sample, typically through a Sensor, Actuator or Sampler."@en .

foaf:name a owl:AnnotationProperty .

ns4:canonical_units a owl:DatatypeProperty ;
    rdfs:comment "canonical units"@en .

ns4:water_evapotranspiration_flux a owl:NamedIndividual,
        ns3:Land_Atmosphere_Interaction_Property ;
    dc:source "Climate and Forecast (CF) Standard Names. http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "Water means water in all phases. Evapotranspiration means all water vapor fluxes into the atmosphere from the surface: liquid evaporation, sublimation and transpiration. Evaporation is the conversion of liquid or solid into vapor. Transpiration is the process by which water is carried from the roots of plants and evaporates from the stomata. (The conversion of solid alone into vapor is called sublimation.) In accordance with common usage in geophysical disciplines, flux implies per unit area, called flux density in physics. Unless indicated in the cell_methods attribute, a quantity is assumed to apply to the whole area of each horizontal grid box." ;
    ns4:canonical_units "kg m-2 s-1" .

onto: a owl:NamedIndividual,
        owl:Ontology ;
    dc:title "VAS. A Semantic Model for Earth Observation Remote Sensing"@en ;
    dcterms:contributor "David Garcia-Rodriguez (https://orcid.org/0000-0002-1472-5497), Ernesto López-Baeza (https://orcid.org/0000-0002-2044-2194), Julián Gutiérrez-Moret (https://orcid.org/0000-0002-0817-7922)  & Juan José Martínez-Durá (https://orcid.org/0000-0002-7218-991X)"@en ;
    dcterms:creator "J. Javier Samper Zapater (https://orcid.org/0000-0002-9170-3080) \\n\\nIRTIC - (Instituto de Robótica y Tecnologías de la Información y la Comunicación)"@en ;
    dcterms:description "The VAS ontological model enables the semantic integration of the heterogeneous observations used in ASOTVAS project ( https://robotica.uv.es/proyectos/ASOTVAS/ ), including ground measurements, UAV acquisitions and satellite products. Built as an extension of the W3C SOSA ontology (Janowicz et al., 2018), it incorporates a domain-specific vocabulary tailored to the needs of the Valencia Anchor Station as a CEOS LPV supersite.\\nThe model provides additional classes and properties to represent, in a homogeneous way, the different observational platforms: field sensors installed at VAS stations, UAVs equipped with multispectral cameras, and satellite missions such as Sentinel-2 and Sentinel-3. All observations follow a common SOSA pattern and share the same structure for results, units and timestamps.\\nBy aligning field, UAV and satellite observations under a unified semantic framework, the VAS ontology supports interoperable data access, consistent representation across scales, and integrated analysis of the multi-source measurements collected in ASOTVAS."@en ;
    dcterms:issued "2024-10-10"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/" ;
    dcterms:modified "2025-11-28"@en ;
    dcterms:title "VAS. A Semantic Model for Earth Observation Remote Sensing"@en ;
    vann:preferredNamespacePrefix "vas"@en ;
    vann:preferredNamespaceUri "https://robotica.uv.es/proyectos/ASOTVAS/def/ciencia-tecnologia/vas#" ;
    rdfs:seeAlso "J. Javier Samper-Zapater, Juan J. Martinez-Dura, Javier Martinez-Plume, David García Rodríguez, Julian Gutiérrez Moret, and Ernesto López Baeza. 2025. VAS. A Semantic Model for Earth Observation data. In Proceedings of the 12th Euro American Conference on Telematics and Information Systems (EATIS 2024). Association for Computing Machinery, New York, NY, USA, Article 9, 1–8. https://doi.org/10.1145/3685243.3685295" ;
    owl:versionIRI <https://robotica.uv.es/proyectos/ASOTVAS/def/ciencia-tecnologia/vas/1.1.0> ;
    skos:changeNote "New revised and updated version of the ontology with information on data capture using UAVs. Ontology version 1.1 28th November 2025."@en .

ns3:Atmospheric_Humidity_AEMET_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Atmospheric humidity in AEMET Station.  Percent Relative Humidity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/Hygrometer> ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Atmospheric_Humidity_Observation .

ns3:Atmospheric_Humidity_EddyCovariance_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Atmospheric humidity in EddyCovariance Station (Gram Per Cubic Metre )"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:Hygrometer_EddyCovariance ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Atmospheric_Humidity_Observation .

ns3:Atmospheric_Pressure_AEMET_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Atmospheric pressure in AEMET Station. Unit of measure Hectopascal (hPa)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns3:Atmospheric_Pressure_AEMET_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/Barometer> ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Atmospheric_Pressure_Observation .

ns3:Atmospheric_Pressure_EddyCovariance_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Atmospheric pressure in EddyCovariance Station. Unit of measure Kilopascal (kPa)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:Barometer_EddyCovariance ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:onClass ns3:Atmospheric_Pressure_EddyCovariance_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns3:Atmospheric_Pressure_Observation .

ns3:CHM_UAV_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to CHM (Canopy Height Model). Unit of measure Metre."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns3:Canopy_Height_Model ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:onClass ns3:CHM_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_UAV_LiDAR ;
            owl:onProperty sosa:madeBySensor ],
        ns3:UAV_Observation .

ns3:CRI_UAV_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to CRI (Carotenoide). Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:onClass ns3:CRI_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://aims.fao.org/aos/agrovoc/c_1333> ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_UAV_Hyperspectral ;
            owl:onProperty sosa:madeBySensor ],
        ns3:UAV_Observation .

ns3:Carbon_Dioxide_Flux_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Carbon dioxide flux (mg / (m2s))"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://mmisw.org/ont/~mjuckes/cmip_variables_alpha/netAtmosLandCO2Flux> ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:onClass ns3:Carbon_Dioxide_flux_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:CarbonDioxideFlux_g ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Atmosphere_of_Earth> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Soil> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] ) ],
        ns3:Ground_based_Observation .

ns3:Chl_L8_Observation a owl:Class ;
    rdfs:comment "Sensor that takes Chl measurements from Landsat-8.",
        "Class that represents observations related to Chlorophyll content. Micromoles of chlorophyll per square metre of leaf surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_Landsat-8 ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Chl_Satellite_Observation .

ns3:Chl_L9_Observation a owl:Class ;
    rdfs:comment "Sensor that takes Chl measurements from Lamdsat-9.",
        "Class that represents observations related to Chlorophyll content. Micromoles of chlorophyll per square metre of leaf surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_Landsat-9 ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Chl_Satellite_Observation .

ns3:Chl_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Chlorophyll content. Micromoles of chlorophyll per square metre of leaf surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:Chl_g ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:onClass ns3:Chl_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Chlorophyll> ;
            owl:onProperty sosa:observedProperty ],
        ns3:Ground_based_Observation .

ns3:Chl_S2_Observation a owl:Class ;
    rdfs:comment "Sensor that takes Chlorophyll measurements from Sentinel-2.",
        "Class that represents observations related to Chlorophyll content. Micromoles of chlorophyll per square metre of leaf surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_Sentinel-2 ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Chl_Satellite_Observation .

ns3:CloudMask_METEOSAT_Observation a owl:Class ;
    rdfs:comment "Sensor that takes CloudMask measurements from METEOSAT.",
        "Class that represents observations related to cloud mask. Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns3:cloud_mask ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:onClass ns3:CloudMask_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_METEOSAT ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Atmosphere_of_Earth> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        ns3:Satellite_Observation .

ns3:CloudType_METEOSAT_Observation a owl:Class ;
    rdfs:comment "Sensor that takes CloudType measurements from METEOSAT.",
        "Class that represents observations related to cloud mask. Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns3:cloud_type ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Atmosphere_of_Earth> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_METEOSAT ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:onClass ns3:CloudType_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns3:Satellite_Observation .

ns3:DBH_UAV_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to DBH (Diameter at Breast Height). Unit of measure Centimetre"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:onClass ns3:DBH_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://aims.fao.org/aos/agrovoc/c_34790> ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_UAV_LiDAR ;
            owl:onProperty sosa:madeBySensor ],
        ns3:UAV_Observation .

ns3:DSM_UAV_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to DSM (Digital Surface Model).Unit of measure Metre."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns3:Digital_Surface_Model ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_UAV_LiDAR ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:onClass ns3:DSM_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns3:UAV_Observation .

ns3:DTM_UAV_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to DTM (Digital Terrain Model).Unit of measure Metre."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns3:Digital_Terrain_Model ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_UAV_LiDAR ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:onClass ns3:DTM_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns3:UAV_Observation .

ns3:Diffuse_Irradiance_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Diffuse radiation (W/m2)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns3:Diffuse_Irradiance_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Diffuse_sky_radiation> ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Radiation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:I_dif_g ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Ground_based_Observation .

ns3:Direct_Irradiance_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Direct solar radiation (W/m2)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Direct_insolation> ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:I_dir_g ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Radiation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:onClass ns3:Direct_Irradiance_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns3:Ground_based_Observation .

ns3:DiseaseStatus_UAV_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to DiseaseStatus. Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns3:DiseaseStatus_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_UAV_Hyperspectral ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Plant_disease> ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        ns3:UAV_Observation .

ns3:EVI_L8_Observation a owl:Class ;
    rdfs:comment "Sensor that takes EVI measurements from Landsat-8.",
        "Class that represents observations related to Enhanced Vegetation Index (EVI)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_Landsat-8 ;
            owl:onProperty sosa:madeBySensor ],
        ns3:EVI_Satellite_Observation .

ns3:EVI_L9_Observation a owl:Class ;
    rdfs:comment "Sensor that takes EVI measurements from  Landsat-9.",
        "Class that represents observations related to Enhanced Vegetation Index (EVI)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:RS_Landsat-9 ;
            owl:onProperty sosa:madeBySensor ],
        ns3:EVI_Satellite_Observation .

ns3:EVI_MODIS-Aqua_Observation a owl:Class ;
    rdfs:comment "Daily temporality, resolution 500 m, product MYD09GA_006_EVI",
        "Sensor that takes Enhanced Vegetation Index (EVI) measurements from MODIS-Aqua.",
