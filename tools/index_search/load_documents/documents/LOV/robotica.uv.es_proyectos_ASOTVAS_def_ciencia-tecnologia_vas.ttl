            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:onClass ns3:Upwelling_Longwave_Flux_In_Air__Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue ns4:upwelling_longwave_flux_in_air ;
            owl:onProperty sosa:observedProperty ],
        ns3:Ground_based_Observation .

ns3:Upwelling_Shortwave_Flux_In_Air_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Upwelling Shortwave Flux In Air (W/m2)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Radiation> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:onClass ns3:Upwelling_Shortwave_Flux_In_Air_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:SW_up_g ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:hasValue ns4:upwelling_shortwave_flux_in_air ;
            owl:onProperty sosa:observedProperty ],
        ns3:Ground_based_Observation .

ns3:Vegetation_Result a owl:Class ;
    rdfs:comment "Result that is normally obtained by Vegetation ( EVI. SAVI, TDVI ...) sensors. Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/NUM> ;
            owl:onProperty ns1:unit ],
        [ a owl:Restriction ;
            owl:onProperty ns1:numericValue ;
            owl:someValuesFrom xsd:double ],
        sosa:Result .

ns3:Water_Vapour_Flux_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to water vapour flux (W/m2)"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Atmosphere_of_Earth> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Soil> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] ) ],
        [ a owl:Restriction ;
            owl:onClass ns3:Water_Vapour_Flux_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:WaterVapourFlux_g ;
            owl:onProperty sosa:madeBySensor ],
        [ a owl:Restriction ;
            owl:hasValue ns4:surface_water_evaporation_flux ;
            owl:onProperty sosa:observedProperty ],
        ns3:Ground_based_Observation .

ns3:Wind_Direction_AEMET_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to wind direction. Angle Degree."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:WindVane_AEMET ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Wind_Direction_Observation .

ns3:Wind_Direction_EddyCovariance_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to wind direction. Angle Degree."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:WindVane_AEMET ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Wind_Direction_Observation .

ns3:Wind_Speed_AEMET_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to wind speed in AEMET Station. (m/s)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/Anemometer> ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Wind_Speed_Observation .

ns3:Wind_Speed_EddyCovariance_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to wind speed in EddyCovariance Station. (m/s)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:Anemometer_EddyCovariance ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Wind_Speed_Observation .

ns3:abbreviation a owl:DatatypeProperty ;
    rdfs:label "Abbreviation"@en ;
    rdfs:subPropertyOf <http://khaos.uma.es/green-senti/earth-observation#filename> .

ns3:cloudyPixels a owl:DatatypeProperty ;
    rdfs:label "Cloudy pixels" ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:sentinel3ProductProperties .

ns3:code_CLC a owl:DatatypeProperty ;
    rdfs:comment "Corine Land Cover (CLC) code."@en ;
    rdfs:domain ns3:Land_Cover_Classes ;
    rdfs:range xsd:integer .

ns3:coordinatesLocation a owl:ObjectProperty ;
    rdfs:label "Coordinates location"@en ;
    rdfs:comment "Indicates the coordinates in which the station is located."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( sosa:Platform ns3:ControlArea ) ] ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:subPropertyOf <http://www.w3.org/2003/01/geo/wgs84_pos#location>,
        ns3:locatedIn .

ns3:file_description a owl:DatatypeProperty ;
    rdfs:label "File Description" ;
    rdfs:domain ns3:SMOS_Product ;
    rdfs:subPropertyOf ns3:smosProductsProperties .

ns3:gridMapping a owl:DatatypeProperty ;
    rdfs:label "Grid Mapping"@en ;
    rdfs:domain ns3:SMAP_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:smapProductProperties .

ns3:groundTrackDirection a owl:DatatypeProperty ;
    rdfs:label "Ground Track Direction" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel3ProductProperties .

ns3:hasObservation a owl:ObjectProperty ;
    rdfs:comment "A Snapshot has a satellite observation"@en ;
    rdfs:domain ns3:Snapshot ;
    rdfs:range ns3:Satellite_Observation ;
    owl:inverseOf ns3:isObservationOf .

ns3:landPixels a owl:DatatypeProperty ;
    rdfs:label "Land pixels" ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns3:sentinel3ProductProperties .

ns3:locatedInMunicipality a owl:ObjectProperty ;
    rdfs:label "Located in municipality"@en ;
    rdfs:comment "Indicates the municipality in which a sensor is located."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( sosa:Platform ns3:ControlArea ) ] ;
    rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio> ;
    rdfs:subPropertyOf <http://www.w3.org/2003/01/geo/wgs84_pos#location>,
        ns3:locatedIn .

ns3:locatedInProvince a owl:ObjectProperty ;
    rdfs:label "Located in province"@en ;
    rdfs:comment "Indicates the province in which a sensor is located."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( sosa:Platform ns3:ControlArea ) ] ;
    rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia> ;
    rdfs:subPropertyOf <http://www.w3.org/2003/01/geo/wgs84_pos#location>,
        ns3:locatedIn .

ns3:longName a owl:DatatypeProperty ;
    rdfs:label "Longname"@en ;
    rdfs:domain ns3:MODIS-Aqua_Product,
        ns3:MODIS-Terra_Product,
        ns3:SMAP_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:commonProductProperties .

ns3:missingValue a owl:DatatypeProperty ;
    rdfs:label "Missing Value" ;
    rdfs:domain ns3:SMAP_Product ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf ns3:smapProductProperties .

ns3:mission a owl:DatatypeProperty ;
    rdfs:label "Mission"@en ;
    rdfs:domain ns3:SMOS_Product ;
    rdfs:subPropertyOf ns3:smosProductsProperties .

ns3:number a owl:DatatypeProperty ;
    rdfs:label "number" ;
    rdfs:subPropertyOf ns3:sentinel3ProductProperties .

ns3:postList a owl:DatatypeProperty ;
    rdfs:label "Post List"@en ;
    rdfs:subPropertyOf <http://khaos.uma.es/green-senti/earth-observation#footprint> .

ns3:productName a owl:DatatypeProperty ;
    rdfs:label "Product name" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel3ProductProperties .

ns3:productType a owl:DatatypeProperty ;
    rdfs:label "Product type" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel3ProductProperties .

ns3:relativeOrbitNumber a owl:DatatypeProperty ;
    rdfs:label "Relative Orbit Number" ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ns3:sentinel3ProductProperties .

ns3:scale_factor a owl:DatatypeProperty ;
    rdfs:label "Scale Factor"@en ;
    rdfs:domain ns3:MODIS-Aqua_Product,
        ns3:MODIS-Terra_Product ;
    rdfs:subPropertyOf ns3:modisProductProperties .

ns3:srsName a owl:DatatypeProperty ;
    rdfs:label "SRS Name"@en ;
    rdfs:subPropertyOf <http://khaos.uma.es/green-senti/earth-observation#footprint> .

ns3:startTime a owl:DatatypeProperty ;
    rdfs:label "Start time"@en ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf ns3:acquisitionPeriod .

ns3:stopTime a owl:DatatypeProperty ;
    rdfs:label "Stop time"@en ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf ns3:acquisitionPeriod .

ns3:timeliness a owl:DatatypeProperty ;
    rdfs:label "Timeliness" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:sentinel3ProductProperties .

ns3:unit a owl:DatatypeProperty ;
    rdfs:label "Unit"@en ;
    rdfs:domain ns3:MODIS-Aqua_Product,
        ns3:MODIS-Terra_Product,
        ns3:SMAP_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:commonProductProperties .

ns3:validMax a owl:DatatypeProperty ;
    rdfs:label "Valid Max"@en ;
    rdfs:domain ns3:SMAP_Product ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf ns3:smapProductProperties .

ns3:validMin a owl:DatatypeProperty ;
    rdfs:label "Valid Min"@en ;
    rdfs:domain ns3:SMAP_Product ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf ns3:smapProductProperties .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Geo_WGS84> a owl:Class .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#Poblacion> a owl:Class ;
    rdfs:label "Town"@en ;
    rdfs:comment "DGT Rules for TPEG Location \\ntownname: first see if the literal is in town, if not, search in municipality\\nother: first see if the literal is in towns, if not, search in province"@en ;
    rdfs:subClassOf ns2:AdministrativeArea .

<http://khaos.uma.es/green-senti/earth-observation#filename> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Filename"@en ;
    rdfs:comment "Package file name, with extension ‘.SAFE’.\\n\\nExample: S2B_MSIL2A_20180628T105619_N0208_R094_T30SUF_20180628T151421.SAFE"@en ;
    rdfs:domain ns3:SMOS_Product,
        ns3:Sentinel-2_Product,
        ns3:Sentinel-3_Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:commonProductProperties .

dcterms:title a owl:DatatypeProperty .

ns1:Concept a owl:Class .

ns1:CountingUnit a owl:Class .

ns1:Quantifiable a owl:Class ;
    rdfs:label "Quantifiable"@en ;
    rdfs:comment "Quantifiable ascribes to some thing the capability of being measured, observed, or counted."@en ;
    rdfs:isDefinedBy "<http://qudt.org/2.1/schema/shacl/qudt>\\n<http://qudt.org/2.1/schema/qudt>"@en .

ns1:QuantityValue a owl:Class ;
    rdfs:label "Quantity value" ;
    rdfs:comment "A <i>Quantity Value</i> expresses the magnitude and kind of a quantity and is given by the product of a numerical value <code>n</code> and a unit of measure <code>U</code>. The number multiplying the unit is referred to as the numerical value of the quantity expressed in that unit. Refer to <a href=http://physics.nist.gov/Pubs/SP811/sec07.html>NIST SP 811 section 7</a> for more on quantity values."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        <http://qudt.org/schema/qudt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:unit ],
        ns1:Concept,
        ns1:Quantifiable .

<http://qudt.org/vocab/unit/CentiM> a ns1:DerivedUnit,
        ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Centimetre"@en,
        "Centimeter"@en-us,
        "Centimètre"@fr ;
    dcterms:description "A centimetre is a unit of length in the metric system, equal to one hundredth of a metre, which is the SI base unit of length. Centi is the SI prefix for a factor of $10^{-2}$.  The centimetre is the base unit of length in the now deprecated centimetre-gram-second (CGS) system of units."^^ns1:LatexString ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:conversionMultiplier 0.01 ;
    ns1:conversionMultiplierSN 1e-02 ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Centimetre"^^xsd:anyURI ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Length> ;
    ns1:iec61360Code "0112/2///62720#UAA375" ;
    ns1:informativeReference "http://en.wikipedia.org/wiki/Centimetre?oldid=494931891"^^xsd:anyURI,
        "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA375"^^xsd:anyURI ;
    ns1:scalingOf <http://qudt.org/vocab/unit/M> ;
    ns1:symbol "cm" ;
    ns1:ucumCode "cm"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "CMT" ;
    ns1:wikidataMatch <http://www.wikidata.org/entity/Q174728> ;
    rdfs:comment "A centimetre is a unit of length in the metric system, equal to one hundredth of a metre, which is the SI base unit of length. Centi is the SI prefix for a factor of 10-2 . The centimetre is the base unit of length in the now deprecated centimetre-gram-second (CGS) system of units."@en ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/DEG> a ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Degree"@en ;
    dcterms:description "A degree (in full, a degree of arc, arc degree, or arcdegree), usually denoted by \\\\(^\\\\circ\\\\) (the degree symbol), is a measurement of plane angle, representing 1/360 of a full rotation; one degree is equivalent to  \\\\(2\\\\pi /360 rad\\\\), \\\\(0.017453 rad\\\\). It is not an SI unit, as the SI unit for angles is radian, but is an accepted SI unit."^^ns1:LatexString ;
    ns1:conversionMultiplier 0.0174532925 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Angle> ;
    ns1:iec61360Code "0112/2///62720#UAA024" ;
    ns1:informativeReference "http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-331"^^xsd:anyURI ;
    ns1:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/degree> ;
    ns1:symbol "°" ;
    ns1:ucumCode "deg"^^ns1:UCUMcs ;
    ns1:udunitsCode "°" ;
    ns1:uneceCommonCode "DD" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/HR> a ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Hour"@en ;
    dcterms:description "The hour (common symbol: h or hr) is a unit of measurement of time. In modern usage, an hour comprises 60 minutes, or 3,600 seconds. It is approximately 1/24 of a mean solar day. An hour in the Universal Coordinated Time (UTC) time standard can include a negative or positive leap second, and may therefore have a duration of 3,599 or 3,601 seconds for adjustment purposes. Although it is not a standard defined by the International System of Units, the hour is a unit accepted for use with SI, represented by the symbol h."^^rdf:HTML ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/SI>,
        <http://qudt.org/vocab/sou/USCS> ;
    ns1:conversionMultiplier 3600.0 ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Hour"^^xsd:anyURI ;
    ns1:definedUnitOfSystem <http://qudt.org/vocab/sou/USCS> ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/Time> ;
    ns1:iec61360Code "0112/2///62720#UAA525" ;
    ns1:informativeReference "http://en.wikipedia.org/wiki/Hour?oldid=495040268"^^xsd:anyURI ;
    ns1:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/hour> ;
    ns1:symbol "hr" ;
    ns1:ucumCode "h"^^ns1:UCUMcs ;
    ns1:udunitsCode "h" ;
    ns1:uneceCommonCode "HUR" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/HectoPA> a ns1:DerivedUnit,
        ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Hectopascal"@en ;
    dcterms:description "Hectopascal is a unit of pressure. 1 Pa is approximately the pressure exerted by a 10-g mass resting on a 1-cm2 area. 1013 hPa = 1 atm. There are 100 pascals in 1 hectopascal."^^rdf:HTML ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:conversionMultiplier 100.0 ;
    ns1:exactMatch <http://qudt.org/vocab/unit/MilliBAR> ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/ForcePerArea>,
        <http://qudt.org/vocab/quantitykind/ModulusOfElasticity>,
        <http://qudt.org/vocab/quantitykind/VaporPressure> ;
    ns1:iec61360Code "0112/2///62720#UAA527" ;
    ns1:symbol "hPa" ;
    ns1:ucumCode "hPa"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "A97" ;
    rdfs:comment "Hectopascal is commonly used in meteorology to report values for atmospheric pressure. It is equivalent to millibar." ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/KiloPA> a ns1:DerivedUnit,
        ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Kilopascal"@en ;
    dcterms:description "Kilopascal is a unit of pressure. 1 kPa is approximately the pressure exerted by a 10-g mass resting on a 1-cm2 area. 101.3 kPa = 1 atm. There are 1,000 pascals in 1 kilopascal."^^rdf:HTML ;
    ns1:allowedUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:conversionMultiplier 1000.0 ;
    ns1:dbpediaMatch "http://dbpedia.org/resource/Pascal_%28unit%29"^^xsd:anyURI ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/ForcePerArea>,
        <http://qudt.org/vocab/quantitykind/VaporPressure> ;
    ns1:iec61360Code "0112/2///62720#UAA575" ;
    ns1:isScalingOf <http://qudt.org/vocab/unit/PA> ;
    ns1:symbol "kPa" ;
    ns1:ucumCode "kPa"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "KPA" ;
    ns1:unitOfSystem <http://qudt.org/vocab/sou/SI> ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/M-PER-SEC> a ns1:DerivedUnit,
        ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Metre per Second"@en,
        "Meter per Second"@en-us ;
    dcterms:description "Metre per second is an SI derived unit of both speed (scalar) and velocity (vector quantity which specifies both magnitude and a specific direction), defined by distance in metres divided by time in seconds.\\nThe official SI symbolic abbreviation is mu00b7s-1, or equivalently either m/s."^^rdf:HTML ;
    ns1:conversionMultiplier 1.0 ;
    ns1:definedUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:expression "\\\\(m/s\\\\)"^^ns1:LatexString ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/ElectromagneticWavePhaseSpeed>,
        <http://qudt.org/vocab/quantitykind/Speed>,
        <http://qudt.org/vocab/quantitykind/Velocity> ;
    ns1:iec61360Code "0112/2///62720#UAA733" ;
    ns1:symbol "m/s" ;
    ns1:ucumCode "m.s-1"^^ns1:UCUMcs,
        "m/s"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "MTS" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/M3-PER-M3> a ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Cubic Metre Per Cubic Metre"@en,
        "Cubic Meter Per Cubic Meter"@en-us ;
    ns1:conversionMultiplier 1.0 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/VolumeFraction> ;
    ns1:iec61360Code "0112/2///62720#UAA767" ;
    ns1:isUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:plainTextDescription "power of the SI base unit metre with the exponent 3 divided by the power of the SI base unit metre with the exponent 3" ;
    ns1:symbol "m³/m³" ;
    ns1:ucumCode "m3.m-3"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "H60" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/MicroMOL-PER-M2> a ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Micromoles per square metre"@en ;
    dcterms:description "One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area."@en ;
    ns1:conversionMultiplier 0.000001 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A1E0L-2I0M0H0T0D0> ;
    ns1:symbol "µmol/m²" ;
    ns1:ucumCode "umol.m-2"^^ns1:UCUMcs,
        "umol/m2"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/MilliGM-PER-GM> a ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Milligram Per Gram"@en ;
    ns1:conversionMultiplier 0.001 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassRatio> ;
    ns1:iec61360Code "0112/2///62720#UAA822" ;
    ns1:isUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:plainTextDescription "0.000001-fold of the SI base unit kilogram divided by the 0.001-fold of the SI base unit kilogram" ;
    ns1:qkdvDenominator <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0> ;
    ns1:qkdvNumerator <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0> ;
    ns1:symbol "mg/gm" ;
    ns1:ucumCode "mg.g-1"^^ns1:UCUMcs,
        "mg/g"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "H64" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/MilliGM-PER-HA> a ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Milligram Per Hectare"@en ;
    ns1:conversionMultiplier 0.0000000001 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassPerArea> ;
    ns1:iec61360Code "0112/2///62720#UAA818" ;
    ns1:isUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:plainTextDescription "0.000001-fold of the SI base unit kilogram divided by the 10,0000-fold of the power of the SI base unit metre with the exponent 2" ;
    ns1:ucumCode "mg.har-1"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/MilliGM-PER-M2-SEC> a ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Milligrams per square metre per second"@en ;
    ns1:conversionMultiplier 0.000001 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassPerAreaTime> ;
    ns1:symbol "mg/(m²⋅s)" ;
    ns1:ucumCode "mg.m-2.s-1"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://qudt.org/vocab/unit/PERCENT_RH> a ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Percent Relative Humidity"@en ;
    dcterms:description "Percent relative humidity is the ratio of the partial pressure of water vapor to the equilibrium vapor pressure of water at a given temperature, expressed as a percentage."^^rdf:HTML ;
    ns1:applicableSystem <http://qudt.org/vocab/sou/ASU>,
        <http://qudt.org/vocab/sou/CGS-ESU>,
        <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/PLANCK>,
        <http://qudt.org/vocab/sou/SI> ;
    ns1:conversionMultiplier 0.01 ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/RelativeHumidity> ;
    ns1:plainTextDescription "Percent relative humidity is the ratio of the partial pressure of water vapor to the equilibrium vapor pressure of water at a given temperature, expressed as a percentage." ;
    ns1:symbol "%RH" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#ComunidadAutonoma> a owl:Class ;
    rdfs:label "Autonomous Community"@en ;
