<http://dbpedia.org/resource/Radiation> a owl:NamedIndividual,
        sosa:FeatureOfInterest ;
    dc:description "The phenomenon of radiation is the propagation of energy in the form of electromagnetic waves or subatomic particles through a vacuum or a material medium. There are different forms of radiation with distinct properties and effects."@en .

<http://dbpedia.org/resource/Soil-adjusted_vegetation_index> a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "SAVI"@en ;
    rdfs:comment "Empirically derived NDVI products have been shown to be unstable, varying with soil colour, soil moisture, and saturation effects from high density vegetation. In an attempt to improve NDVI, Huete developed a vegetation index that accounted for the differential red and near-infrared extinction through the vegetation canopy. The index is a transformation technique that minimizes soil brightness influences from spectral vegetation indices involving red and near-infrared (NIR) wavelengths. The index is given as: where L is a canopy background adjustment factor. An L value of 0.5 in reflectance space was found to minimize soil brightness variations and eliminate the need for additional calibration for different soils.The transformation was found to nearly eliminate soil-induced variations in vegetation indices. (en)"@en ;
    sosa:isObservedBy ns3:SAVI_L8_Sensor_1,
        ns3:SAVI_L9_Sensor_1,
        ns3:SAVI_S2_Sensor_1,
        ns3:SAVI_UAV_Multispectral_Sensor_1 .

<http://qudt.org/vocab/unit/W-PER-M2> a ns1:DerivedUnit,
        ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Watt per Square Metre"@en,
        "Watt per Square Meter"@en-us ;
    dcterms:description "Watt per Square Meter} is a unit of irradiance defined as the power received per area. This is a unit in the category of Energy flux. It is also known as watts per square meter, watt per square metre, watts per square metre, watt/square meter, watt/square metre. This unit is commonly used in the SI unit system. Watt Per Square Meter (\\\\(W/m^2\\\\)) has a dimension of \\\\(MT^{-3\\\\) where M is mass, and T is time. This unit is the standard SI unit in this category."^^ns1:LatexString ;
    ns1:conversionMultiplier 1.0 ;
    ns1:definedUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    ns1:expression "\\\\(W/m^2\\\\)"^^ns1:LatexString ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/PowerPerArea>,
        <http://qudt.org/vocab/quantitykind/PoyntingVector> ;
    ns1:iec61360Code "0112/2///62720#UAA310" ;
    ns1:informativeReference "http://www.efunda.com/glossary/units/units--energy_flux--watt_per_square_meter.cfm"^^xsd:anyURI ;
    ns1:symbol "W/m²" ;
    ns1:ucumCode "W.m-2"^^ns1:UCUMcs,
        "W/m2"^^ns1:UCUMcs ;
    ns1:uneceCommonCode "D54" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

sosa:FeatureOfInterest a owl:Class ;
    rdfs:label "Feature Of Interest"@en ;
    rdfs:comment "The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://dbpedia.org/resource/Air> <http://dbpedia.org/resource/Atmosphere_of_Earth> <http://dbpedia.org/resource/Land_surface> <http://dbpedia.org/resource/Radiation> <http://dbpedia.org/resource/Soil> <http://dbpedia.org/resource/Vegetation> ) ] ;
    skos:definition "The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling."@en ;
    skos:example "When measuring the height of a tree, the height is the observed ObservableProperty, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuator."@en .

sosa:Sampling rdfs:label "Sampling"@en ;
    rdfs:comment "An act of Sampling carries out a sampling Procedure to create or transform one or more samples."@en ;
    skos:definition "An act of Sampling carries out a sampling Procedure to create or transform one or more samples."@en ;
    skos:example "Crushing a rock sample in a ball mill."@en,
        "Digging a pit through a soil sequence."@en,
        "Dividing a field site into quadrants."@en,
        "Drawing blood from a patient."@en,
        "Drilling an observation well."@en,
        "Establishing a station for environmental monitoring."@en,
        "Registering an image of the landscape."@en,
        "Selecting a subset of a population."@en,
        "Sieving a powder to separate the subset finer than 100-mesh."@en,
        "Splitting a piece of drill-core to create two new samples."@en,
        "Taking a diamond-drill core from a rock outcrop."@en .

ns3:EddyCovariance_Station a owl:Class ;
    rdfs:label "EddyCovariance_Station"@en ;
    rdfs:comment "Eddy covariance systems measure the exchange of CO2, H2O, CH4 , and energy between the earth’s surface and the atmosphere, empowering researchers to advance scientific understanding of climate and ecosystem dynamics"@en ;
    rdfs:seeAlso "http://dbpedia.org/resource/Eddy_covariance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns3:Anemometer_EddyCovariance ns3:Barometer_EddyCovariance ns3:CarbonDioxideFlux_g ns3:Hs_g ns3:Hygrometer_EddyCovariance ns3:LE_g ns3:Thermometer_EddyCovariance ns3:WaterVapourFlux_g ns3:WindVane_AEMET ) ] ;
            owl:onProperty sosa:hosts ],
        ns3:Ground_Station .

ns3:simple_ratio a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "SR"@en ;
    dc:source "http://gsp.humboldt.edu/olm/Courses/GSP_216/lessons/Spectral-Enhancements/NDVI.html#:~:text=Simplest%20ratio-based%20index%20is,indicate%20soil%2C%20water%20or%20ice."@en ;
    rdfs:comment "Simplest ratio-based index is called the Simple Ratio (SR) or Ratio Vegetation Index (RVI). This index is simply the reflectance in the NIR band divided by the reflectance in the red band. A larger SR value indicates healthy vegetation, while lower values indicate soil, water or ice. SR = Near Infrared / Red"@en ;
    sosa:isObservedBy ns3:SR_L8_Sensor_1,
        ns3:SR_L9_Sensor_1,
        ns3:SR_S2_Sensor_1,
        ns3:SR_UAV_Multispectral_Sensor_1 .

<http://dbpedia.org/resource/Atmosphere_of_Earth> a owl:NamedIndividual,
        sosa:FeatureOfInterest ;
    dc:description "The Earth's atmosphere is the gaseous part of the Earth, making it the outermost and least dense layer of the planet. It consists of various gases that vary in quantity depending on altitude. This mixture of gases that forms the atmosphere is commonly referred to as air. Approximately 75% of the atmospheric mass is located within the first 11 kilometers from the sea surface. The primary gases that make up the atmosphere are oxygen (21%) and nitrogen (78%), followed by argon, carbon dioxide, and water vapor."@en .

<http://dbpedia.org/resource/Soil_Property> a owl:Class ;
    rdfs:comment "Class that represents all Soil properties"@en ;
    rdfs:subClassOf sosa:ObservableProperty .

sosa:ObservableProperty a owl:Class ;
    rdfs:label "Observable Property"@en ;
    rdfs:comment "An observable quality (property, characteristic) of a FeatureOfInterest."@en ;
    skos:definition "An observable quality (property, characteristic) of a FeatureOfInterest."@en ;
    skos:example "The height of a tree, the depth of a water body, or the temperature of a surface are examples of observable properties, while the value of a classic car is not (directly) observable but asserted."@en .

sosa:Platform a owl:Class ;
    rdfs:label "Platform"@en ;
    rdfs:comment "A Platform is an entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms."@en ;
    rdfs:subClassOf geo:Feature ;
    skos:definition "A Platform is an entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms."@en ;
    skos:example "A post, buoy, vehicle, ship, aircraft, satellite, cell-phone, human or animal may act as platforms for (technical or biological) sensors or actuators."@en .

ns3:Ground_Station a owl:Class ;
    rdfs:comment "A Ground Station is defined as a physical platform located on the Earth’s surface that hosts one or more sensors used to perform in-situ environmental observations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns3:Land_Cover_Classes ;
            owl:onProperty ns3:hasTypeOfCover ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns3:ControlArea ;
            owl:onProperty ns3:controlArea ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        sosa:Platform .

ns3:NDVI_Satellite_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to Normalized Difference Vegetation Index (NDVI). Dimensionless."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Soil> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] [ a owl:Restriction ;
                        owl:hasValue <http://dbpedia.org/resource/Vegetation> ;
                        owl:onProperty sosa:hasFeatureOfInterest ] ) ],
        [ a owl:Restriction ;
            owl:onClass ns3:NDVI_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue ns4:normalized_difference_vegetation_index ;
            owl:onProperty sosa:observedProperty ],
        ns3:Satellite_Observation .

ns3:RS_UAV_Hyperspectral a owl:Class ;
    rdfs:comment "Represents the general sensorization of RS_UAV_Hyperspectral. Observes  NRI,  CRI, NDWI, AGB. DiseaseStatus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Plant_disease> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://aims.fao.org/aos/agrovoc/c_1373987580598> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:UAV_Hyperspectral ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns3:Nitrogen_Reflectance_Index ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns3:Normalized_Difference_Water_Index ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://aims.fao.org/aos/agrovoc/c_1333> ;
            owl:onProperty sosa:observes ],
        ns3:Remote_Sensing_UAVs .

ns3:Remote_Sensing_Satellites a owl:Class ;
    rdfs:comment "Satellite  Sensors (remote sensing)."@en ;
    rdfs:subClassOf sosa:Sensor .

<http://dbpedia.org/resource/Chlorophyll> a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "Chl"@en ;
    dc:description "Chlorophylls (from the Greek words χλωρος, chloros, meaning 'green,' and φύλλον, fýlon, meaning 'leaf') are a family of green-colored pigments found in cyanobacteria and in all organisms that possess chloroplasts or thylakoid membranes in their cells, which includes plants and various types of algae. Chlorophyll is a highly essential biomolecule, critical in the process of photosynthesis, which enables plants and algae to store energy from sunlight."@en ;
    sosa:isObservedBy ns3:Chl_L8_Sensor_1,
        ns3:Chl_L9_Sensor_1,
        ns3:Chl_S2_Sensor_1,
        ns3:Chl_g_Sensor_1,
        ns3:OTCI_S3_Sensor_1 .

sosa:Actuation rdfs:label "Actuation"@en ;
    rdfs:comment "An Actuation carries out an (Actuation) Procedure to change the state of the world using an Actuator."@en ;
    skos:definition "An Actuation carries out an (Actuation) Procedure to change the state of the world using an Actuator."@en ;
    skos:example "The activity of automatically closing a window if the temperature in a room drops below 20 degree Celsius. The activity is the Actuation and the device that closes the window is the Actuator. The Procedure is the rule, plan, or specification that defines the conditions that triggers the Actuation, here a drop in temperature. "@en .

ns3:ControlArea a owl:Class ;
    rdfs:label "Control Area"@en ;
    rdfs:comment "A Control Area is a spatially delimited region designated to enable consistent environmental observations, calibration activities, and cross-platform validation. It provides a reference zone where measurements can be collected under controlled or well-characterized conditions."@en ;
    rdfs:subClassOf geo:Feature ;
    skos:example "Examples include small reference plots such as 1×1 m areas, or larger experimental regions such as 10×10 m areas, commonly used in field stations to support calibration and validation workflows"@en .

ns3:Land_Cover_Classes a owl:Class ;
    rdfs:label "Land Cover Classes"@en ;
    rdfs:comment "Land Cover Classes, Level 3"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns3:Artificial_Surfaces ns3:Bare_Soils ns3:Coniferous_Forest ns3:Non-irrigated_arable_land ns3:Permanently_irrigated_land ns3:Sclerophyllous_vegetation ns3:Vineyards <https://robotica.uv.es/proyectos/ASOTVAS/def/ciencia-tecnologia/vas#Fruit_trees_and_berry_plantations_(olive,_almond)> ) ] .

    rdfs:comment "Represents the general sensorization of RS_UAV_LiDAR. Observes  CHM, DTM, DSM. DBH, AGB."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://aims.fao.org/aos/agrovoc/c_34790> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns3:Digital_Terrain_Model ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:UAV_LiDAR ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue <http://aims.fao.org/aos/agrovoc/c_1373987580598> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns3:Canopy_Height_Model ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns3:Digital_Surface_Model ;
            owl:onProperty sosa:observes ],
        ns3:Remote_Sensing_UAVs .

ns3:landsat8ProductProperties a owl:DatatypeProperty ;
    rdfs:comment "Landsat 8 product properties"@en ;
    rdfs:domain ns3:Landsat-8_Product .

ns3:RS_UAV_Multispectral a owl:Class ;
    rdfs:comment "Represents the general sensorization of RS_UAV_Multispectral. Observes  EVI, FAPAR, LAI,  NDVI, ,SAVI y SR."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:UAV_Multispectral ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:normalized_difference_vegetation_index ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns3:simple_ratio ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Enhanced_vegetation_index> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Soil-adjusted_vegetation_index> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:leaf_area_index ;
            owl:onProperty sosa:observes ],
        ns3:Remote_Sensing_UAVs .

<http://dbpedia.org/resource/Enhanced_vegetation_index> a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "EVI"@en ;
    rdfs:comment "The enhanced vegetation index (EVI) is an 'optimized' vegetation index designed to enhance the vegetation signal with improved sensitivity in high biomass regions and improved vegetation monitoring through a de-coupling of the canopy background signal and a reduction in atmosphere influences. EVI is computed following this equation: where: * NIR/red/blue are atmospherically-corrected and partially atmosphere corrected (Rayleigh and ozone absorption) surface reflectances * L is the canopy background adjustment that addresses non-linear, differential NIR and red radiant transfer through a canopy, and * C1, C2 are the coefficients of the aerosol resistance term, which uses the blue band to correct for aerosol influences in the red band. The coefficients adopted in the MODIS-EVI algorithm are: L=1, C1 = 6, C2 = 7.5, and G (gain factor) = 2.5. Whereas the Normalized Difference Vegetation Index (NDVI) is chlorophyll sensitive, the EVI is more responsive to canopy structural variations, including leaf area index (LAI), canopy type, plant physiognomy, and canopy architecture. The two vegetation indices complement each other in global vegetation studies and improve upon the detection of vegetation changes and extraction of canopy biophysical parameters.. Another difference between Normalized Difference Vegetation Index (NDVI) and EVI is that in the presence of snow, NDVI decreases, while EVI increases (Huete, 2002). Starting 2000, and after the launch of the two MODIS sensors on Terra (satellite) and Aqua (satellite) by NASA, EVI was adopted as a standard product by NASA and became extremely popular with users due to its ability to eliminate background and atmosphere noises, as well as its non saturation, a typical NDVI problem. EVI is currently distributed for free by the USGS LP DAAC. (en)"@en ;
    sosa:isObservedBy ns3:EVI_L8_Sensor_1,
        ns3:EVI_L9_Sensor_1,
        ns3:EVI_S2_Sensor_1,
        ns3:EVI_UAV_Multispectral_Sensor_1,
        ns3:EVI_diary_500m_a_Sensor_1,
        ns3:EVI_diary_500m_t_Sensor_1 .

geo:Geometry a owl:Class ;
    rdfs:label "Geometry"@en ;
    dc:contributor "Matthew Perry" ;
    dc:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dc:date "2011-06-16"^^xsd:date ;
    dc:description "\\n      The class represents the top-level geometry type. This class is \\n      equivalent to the UML class GM_Object defined in ISO 19107, and \\n      it is superclass of all geometry types.\\n    "@en ;
    rdfs:comment "\\n      The class represents the top-level geometry type. This class is \\n      equivalent to the UML class GM_Object defined in ISO 19107, and \\n      it is superclass of all geometry types.\\n    "@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/ont/gml>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    rdfs:subClassOf geo:SpatialObject ;
    skos:definition "\\n      The class represents the top-level geometry type. This class is \\n      equivalent to the UML class GM_Object defined in ISO 19107, and \\n      it is superclass of all geometry types.\\n    "@en ;
    skos:prefLabel "Geometry"@en .

sosa:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en ;
    skos:definition "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en ;
    skos:example "The activity of estimating the intensity of an Earthquake using the Mercalli intensity scale is an Observation as is measuring the moment magnitude, i.e., the energy released by said earthquake."@en .

ns3:Landsat-8_Product a owl:Class ;
    rdfs:label "Landsat-8_Product"@en ;
    rdfs:comment "Class that represents Landsat-8 products"@en ;
    rdfs:subClassOf ns3:Satellite_Product .

ns3:Satellite a owl:Class ;
    rdfs:label "Satellite"@en ;
    rdfs:subClassOf sosa:Platform .

ns3:sentinel2ProductProperties a owl:DatatypeProperty ;
    rdfs:comment "Sentinel-2 product properties"@en ;
    rdfs:domain ns3:Sentinel-2_Product .

ns3:RS_Landsat-8 a owl:Class ;
    rdfs:comment "Represents the general sensorization of satellite Landsat-8. Observes Chl, EVI, FAPAR, LAI, LST, NDVI, ,SAVI, SR, TDVI ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Chlorophyll> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:surface_temperature ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Landsat-8 ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns3:simple_ratio ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:leaf_area_index ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Soil-adjusted_vegetation_index> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Enhanced_vegetation_index> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:normalized_difference_vegetation_index ;
            owl:onProperty sosa:observes ],
        ns3:Remote_Sensing_Satellites .

ns3:RS_Landsat-9 a owl:Class ;
    rdfs:comment "Represents the general sensorization of satellite Lansat-9.Observes Chl, EVI, FAPAR, LAI, LST, NDVI, ,SAVI, SR, TDVI ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:Landsat-9 ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:surface_temperature ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns3:simple_ratio ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:leaf_area_index ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Chlorophyll> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:normalized_difference_vegetation_index ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Enhanced_vegetation_index> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Soil-adjusted_vegetation_index> ;
            owl:onProperty sosa:observes ],
