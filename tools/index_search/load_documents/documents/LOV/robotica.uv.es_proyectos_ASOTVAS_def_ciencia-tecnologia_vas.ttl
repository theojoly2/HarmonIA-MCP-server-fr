ns3:RS_MODIS-Aqua a owl:Class ;
    rdfs:comment "Represents the general sensorization of satellite MODIS-Aqua. Observes EVI , FAPAR, LST, NDVI, ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Enhanced_vegetation_index> ;
