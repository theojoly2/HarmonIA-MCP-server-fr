            owl:allValuesFrom <http://aemet.linkeddata.es/ontology/Thermometer> ;
            owl:onProperty sosa:madeBySensor ],
        ns3:Temperature_Observation .

ns3:Temperature_Observation a owl:Class ;
    rdfs:comment "Class that represents observations related to temperature. Celsius Degree."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns3:Temperature_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns3:Ground_based_Observation .

ns3:Thermometer a owl:Class ;
    rdfs:comment "Measures temperature in degrees Celsius"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:air_temperature ;
            owl:onProperty sosa:observes ],
        ns3:Ground_Based_Sensing .

ns3:Thermometer_EddyCovariance_Sensor_1 a owl:NamedIndividual,
