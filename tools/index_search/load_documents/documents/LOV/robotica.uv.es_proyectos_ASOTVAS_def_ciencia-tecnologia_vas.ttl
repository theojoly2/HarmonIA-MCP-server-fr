ns3:Temperature_in_air_AEMET_Observation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Air> ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:hasValue ns4:air_temperature ;
            owl:onProperty sosa:observedProperty ],
        ns3:Temperature_AEMET_Observation ;
    skos:definition "Observation of Air Temperature. Air Temperature is a measure of the hotness or coldness of the air. It is also termed surface temperature in meteorology.  Air temperature is the temperature indicated by a thermometer exposed to the air but sheltered from direct sun exposure."@en .

ns3:Temperature_in_ground_depth_05_AEMET_Observation a owl:Class ;
