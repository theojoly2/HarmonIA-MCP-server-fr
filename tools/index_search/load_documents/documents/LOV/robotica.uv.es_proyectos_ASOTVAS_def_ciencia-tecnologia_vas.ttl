    owl:distinctMembers ( ns3:Artificial_Surfaces ns3:Bare_Soils ns3:Coniferous_Forest ns3:Non-irrigated_arable_land ns3:Permanently_irrigated_land ns3:Sclerophyllous_vegetation ns3:Vineyards <https://robotica.uv.es/proyectos/ASOTVAS/def/ciencia-tecnologia/vas#Fruit_trees_and_berry_plantations_(olive,_almond)> ) .

[] a time:Interval ;
    time:hasBeginning [ ] ;
    time:hasEnd [ ] .

