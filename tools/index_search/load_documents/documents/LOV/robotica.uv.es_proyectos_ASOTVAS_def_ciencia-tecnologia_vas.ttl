ns3:RS_Sentinel-2 a owl:Class ;
    rdfs:comment "Represents the general sensorization of satellite Sentinel 2 or  S2. Observes Chl, EVI, FAPAR, LAI, LandCover, NDVI, SAVI, SR ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns4:fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:land_cover_lccs ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Sentinel-2 ;
            owl:onProperty sosa:isHostedBy ],
        [ a owl:Restriction ;
            owl:hasValue ns4:normalized_difference_vegetation_index ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Soil-adjusted_vegetation_index> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Enhanced_vegetation_index> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue <http://dbpedia.org/resource/Chlorophyll> ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns3:simple_ratio ;
            owl:onProperty sosa:observes ],
        [ a owl:Restriction ;
            owl:hasValue ns4:leaf_area_index ;
            owl:onProperty sosa:observes ],
        ns3:Remote_Sensing_Satellites .

ns3:Satellite_Observation a owl:Class ;
    rdfs:comment "Observation collected by satellite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns3:Image_Result ;
            owl:onProperty sosa:hasResult ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        sosa:Observation .

ns3:Satellite_Product a owl:Class ;
    rdfs:label "Satellite Product"@en ;
    rdfs:comment "A Satellite Product is a processed dataset generated from raw satellite measurements, typically including radiometric, geometric, and atmospheric corrections. These products provide georeferenced environmental variables (e.g., reflectance, vegetation indices, land surface temperature, soil moisture) at defined spatial, temporal, and spectral resolutions, and serve as inputs for environmental monitoring, modelling, and validation workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:controlArea ;
            owl:someValuesFrom ns3:ControlArea ],
        geo:Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty sosa:resultTime ;
                        owl:someValuesFrom xsd:dateTime ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:dateTime ;
                        owl:onProperty sosa:resultTime ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns3:hasSatelliteSource ;
                        owl:someValuesFrom ns3:Satellite ] [ a owl:Restriction ;
                        owl:allValuesFrom ns3:Satellite ;
                        owl:onProperty ns3:hasSatelliteSource ] ) ] ;
    skos:example "Examples include NDVI, FAPAR, LST, or surface reflectance products obtained from Sentinel-2, Sentinel-3, Landsat, or other EO missions."@en .

sosa:hosts a owl:ObjectProperty ;
    rdfs:label "hosts"@en ;
    ns2:domainIncludes sosa:Platform ;
    ns2:rangeIncludes sosa:Actuator,
        sosa:Platform,
        sosa:Sampler,
        sosa:Sensor ;
    rdfs:comment "Relation between a Platform and a Sensor, Actuator, Sampler, or Platform, hosted or mounted on it."@en ;
    owl:inverseOf sosa:isHostedBy ;
    skos:definition "Relation between a Platform and a Sensor, Actuator, Sampler, or Platform, hosted or mounted on it."@en .

<http://qudt.org/vocab/sou/SI> a owl:NamedIndividual ;
    rdfs:comment "System International of measures."@en .

ns4:leaf_area_index a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "LAI" ;
    dc:source "Climate and Forecast (CF) Standard Names (v.78). http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "X_area means the horizontal area occupied by X within the grid cell." ;
    sosa:isObservedBy ns3:LAI_L8_Sensor_1,
        ns3:LAI_L9_Sensor_1,
        ns3:LAI_S2_Sensor_1,
        ns3:LAI_UAV_Multispectral_Sensor_1,
        ns3:LAI_dhp_Sensor_1,
        ns3:LAI_dhp_Sensor_2,
        ns3:LAI_dhp_Sensor_3,
        ns3:LAI_g_Sensor_1,
        ns3:LAI_g_Sensor_2 ;
    ns4:canonical_units "1" .

ns3:UAV_Observation a owl:Class ;
    rdfs:comment "Observation collected by dron engine."@en ;
    rdfs:subClassOf sosa:Observation .

ns4:surface_temperature a owl:NamedIndividual,
        ns3:Land_Surface_Property ;
    rdfs:label "LST"@en ;
    dc:source "Climate and Forecast (CF) Standard Names. http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "The surface called surface means the lower boundary of the atmosphere. The surface temperature is the temperature at the interface, not the bulk temperature of the medium above or below. Unless indicated in the cell_methods attribute, a quantity is assumed to apply to the whole area of each horizontal grid box. Previously, the qualifier where_type was used to specify that the quantity applies only to the part of the grid box of the named type.  Names containing the where_type qualifier are deprecated and newly created data should use the cell_methods attribute to indicate the horizontal area to which the quantity applies." ;
    sosa:isObservedBy ns3:LST_8days_1km_a_Sensor_1,
        ns3:LST_8days_1km_t_Sensor_1,
        ns3:LST_L8_Sensor_1,
        ns3:LST_L9_Sensor_1,
        ns3:LST_S3_Sensor_1,
        ns3:LST_UAV_Thermal_Sensor_1,
        ns3:LST_diary_1km_a_Sensor_1,
        ns3:LST_diary_1km_t_Sensor_1,
        ns3:LST_g_Sensor_1 ;
    ns4:canonical_units "Celsius" .

ns3:Sentinel-2_Product a owl:Class ;
    rdfs:label "Sentinel-2_Product"@en ;
    rdfs:comment "Class that represents Sentinel-2 satellite Products"@en ;
    rdfs:subClassOf ns3:Satellite_Product .

ns3:Vegetation_Property a owl:Class ;
    rdfs:comment "Class that represents all Vegetation properties"@en ;
    rdfs:subClassOf sosa:ObservableProperty .

<http://dbpedia.org/resource/Soil> a owl:NamedIndividual,
        sosa:FeatureOfInterest ;
    dc:description "The term 'soil' refers to the surface layer of the Earth's crust that is biologically active and originates from the physical or chemical disintegration or alteration of rocks, as well as from the residues of living organisms that settle upon it. Many processes can contribute to the formation of a specific type of soil, including aeolian deposition, sedimentation in watercourses, weathering, and the deposition of organic material"@en .

ns1:Unit a owl:Class .

ns4:normalized_difference_vegetation_index a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "NDVI"@en ;
    dc:source "Climate and Forecast (CF) Standard Names (v.78). http://mmisw.org/ont/cf/parameter"@en ;
    rdfs:comment "NDVI quantifies the liveliness of green vegetation in an area."@en ;
    rdfs:seeAlso "https://codes.wmo.int/grib2/codeflag/4.2/_2-0-31"@en ;
    skos:definition "Normalized_difference_vegetation_index, usually abbreviated to NDVI, is an index calculated from reflectances measured in the visible and near infrared channels.  It is calculated as NDVI = (NIR - R) / (NIR + R) where NIR is the reflectance in the near-infrared band and R is the reflectance in the red visible band.  Reflectance is the ratio of the reflected over the incoming radiation in each spectral band.  The calculated value of NDVI depends on the precise definitions of the spectral bands and these definitions may vary between different models and remote sensing instruments." ;
    sosa:isObservedBy ns3:NDVI_16days_1km_a_Sensor_1,
        ns3:NDVI_16days_1km_t_Sensor_1,
        ns3:NDVI_16days_250m_a_Sensor_1,
        ns3:NDVI_16days_250m_t_Sensor_1,
        ns3:NDVI_16days_500m_a_Sensor_1,
        ns3:NDVI_16days_500m_t_Sensor_1,
        ns3:NDVI_L8_Sensor_1,
        ns3:NDVI_L9_Sensor_1,
        ns3:NDVI_S2_Sensor_1,
        ns3:NDVI_UAV_Multispectral_Sensor_1,
        ns3:NDVI_diary_500m_a_Sensor_1,
        ns3:NDVI_diary_500m_t_Sensor_1 ;
    ns4:canonical_units "1" .

ns3:Vineyards a owl:NamedIndividual,
        ns3:Land_Cover_Classes ;
    rdfs:label "Vineyards"@en ;
    rdfs:comment "Class Level 3 CORINE Land Cover - CLC"@en ;
    ns3:code_CLC 221 .

<http://qudt.org/vocab/unit/NUM> a ns1:CountingUnit,
        ns1:Unit,
        owl:NamedIndividual ;
    rdfs:label "Number"@en ;
    dcterms:description "Number is a unit for  'Dimensionless' expressed as (\\\\#\\\\)."^^rdf:HTML ;
    ns1:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1> ;
    ns1:hasQuantityKind <http://qudt.org/vocab/quantitykind/ChargeNumber>,
        <http://qudt.org/vocab/quantitykind/Dimensionless>,
        <http://qudt.org/vocab/quantitykind/DimensionlessRatio>,
        <http://qudt.org/vocab/quantitykind/FrictionCoefficient>,
        <http://qudt.org/vocab/quantitykind/HyperfineStructureQuantumNumber>,
        <http://qudt.org/vocab/quantitykind/IonTransportNumber>,
        <http://qudt.org/vocab/quantitykind/Landau-GinzburgNumber>,
        <http://qudt.org/vocab/quantitykind/MagneticQuantumNumber>,
        <http://qudt.org/vocab/quantitykind/MassNumber>,
        <http://qudt.org/vocab/quantitykind/NeutronNumber>,
        <http://qudt.org/vocab/quantitykind/NuclearSpinQuantumNumber>,
        <http://qudt.org/vocab/quantitykind/NucleonNumber>,
        <http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber>,
        <http://qudt.org/vocab/quantitykind/Population>,
        <http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber>,
        <http://qudt.org/vocab/quantitykind/QuantumNumber>,
        <http://qudt.org/vocab/quantitykind/ReynoldsNumber>,
        <http://qudt.org/vocab/quantitykind/SpinQuantumNumber>,
        <http://qudt.org/vocab/quantitykind/StoichiometricNumber>,
        <http://qudt.org/vocab/quantitykind/TotalAngularMomentumQuantumNumber> ;
    ns1:symbol "#" ;
    ns1:ucumCode "1"^^ns1:UCUMcs,
        "{#}"^^ns1:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
        <http://qudt.org/vocab/unit> .

<http://dbpedia.org/resource/Soil_moisture> a <http://dbpedia.org/resource/Soil_Property>,
        owl:NamedIndividual ;
    rdfs:label "SM"@en ;
    rdfs:comment "Soil moisture is the water content of the soil. It can be expressed in terms of volume or weight. Soil moisture measurement can be based on in situ probes (e.g., capacitance probes, neutron probes) or remote sensing methods. Water that enters a field is removed from a field by runoff, drainage, evaporation or transpiration."@en ;
    sosa:isObservedBy ns3:SM_NRT_SMOS_ESA_Sensor_1,
        ns3:SM_S1_Sensor_1,
        ns3:SM_SMAP-S1_3km_Sensor_1,
        ns3:SM_SMAP-S1_9km_Sensor_1,
        ns3:SM_SMAP_36km_Sensor_1,
        ns3:SM_SMOS-IC_CATDS_Sensor_1,
        ns3:SM_SMOS_BEC_Sensor_1,
        ns3:SM_SMOS_ESA_Sensor_1,
        ns3:SM_UAV_Microwave_Sensor_1,
        ns3:SM_freeze_and_Thaw_SMOS_ESA_Sensor_1,
        ns3:SM_g_Sensor_1,
        ns3:SM_g_Sensor_2,
        ns3:SM_g_Sensor_3,
        ns3:SM_g_Sensor_4,
        ns3:SM_g_Sensor_5,
        ns3:SM_g_Sensor_6 .

ns3:1km_x_1km a owl:NamedIndividual,
        ns3:ControlArea ;
    rdfs:label "1x1 Area" ;
    geo:hasGeometry ns3:GeoArea1x1 ;
    rdfs:comment "A Control Area is a spatially delimited region designated to enable consistent environmental observations, calibration activities, and cross-platform validation. It provides a reference zone where measurements can be collected under controlled or well-characterized conditions. Dimension 1 x1."@en ;
    ns3:locatedInMunicipality <https://sws.geonames.org/6361960/> ;
    ns3:locatedInProvince <http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia> .

<http://www.opengis.net/ont/sf#Point> a owl:Class .

ns4:fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation a owl:NamedIndividual,
        ns3:Vegetation_Property ;
    rdfs:label "FAPAR"@en ;
    dc:source "Climate and Forecast (CF) Standard Names (v.78). http://mmisw.org/ont/cf/parameter"@en ;
    skos:definition "Downwelling radiation is radiation from above. It does not mean net downward. The sign convention is that upwelling is positive upwards and downwelling is positive downwards. The surface called surface means the lower boundary of the atmosphere. The quantity with standard name fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation, often called Fraction of Absorbed Photosynthetically Active Radiation (FAPAR), is the fraction of incoming solar radiation in the photosynthetically active radiation spectral region that is absorbed by a vegetation canopy. Photosynthetic radiation is the part of the spectrum which is used in photosynthesis e.g. 400-700 nm. The range of wavelengths could be specified precisely by the bounds of a coordinate of radiation_wavelength. When thought of as being incident on a surface, a radiative flux is sometimes called irradiance. In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called vector irradiance. In accordance with common usage in geophysical disciplines, flux implies per unit area, called flux density in physics. Vegetation means any plants e.g. trees, shrubs, grass. The term plants refers to the kingdom of plants in the modern classification which excludes fungi. Plants are autotrophs i.e. producers of biomass using carbon obtained from carbon dioxide." ;
    sosa:isObservedBy ns3:FAPAR_8days_500m_a_Sensor_1,
        ns3:FAPAR_8days_500m_t_Sensor_1,
        ns3:FAPAR_L8_Sensor_1,
        ns3:FAPAR_L9_Sensor_1,
        ns3:FAPAR_S2_Sensor_1,
        ns3:FAPAR_UAV_Multispectral_Sensor_1,
        ns3:FAPAR_dhp_Sensor_1,
        ns3:FAPAR_dhp_Sensor_2,
        ns3:FAPAR_dhp_Sensor_3,
        ns3:FAPAR_g_Sensor_1,
        ns3:FAPAR_g_Sensor_2,
        ns3:FAPAR_g_Sensor_3,
        ns3:FAPAR_g_Sensor_4,
        ns3:GIFAPAR_S3_Sensor_1 ;
    ns4:canonical_units "1" .

ns3:Ground_based_Observation a owl:Class ;
    rdfs:comment "Observation collected in situ."@en ;
    rdfs:subClassOf sosa:Observation .

<https://sws.geonames.org/6361960/> a <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio>,
        owl:NamedIndividual ;
    rdfs:label "Caudete de las Fuentes" ;
    dc:source "https://sws.geonames.org/" .

<http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia> a <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia>,
        owl:NamedIndividual ;
    rdfs:label "Valencia/València" ;
    dc:source "http://datos.gob.es/recurso/sector-publico/territorio/Provincia/" .

ns3:Ground_Based_Sensing a owl:Class ;
    rdfs:comment "Ground Base Sensors"@en ;
    rdfs:subClassOf sosa:Sensor .

<http://dbpedia.org/resource/Vegetation> a owl:NamedIndividual,
        sosa:FeatureOfInterest ;
    dc:description "Vegetation refers to the coverage of wild or cultivated plants (flora) that grow spontaneously in a geographic area, whether on the land surface or in an aquatic environment. It is also referred to as vegetation cover. Its distribution on Earth depends on climatic factors and soils. Vegetation is so important that climate types are even categorized based on the type of vegetation that grows in the areas where they dominate. This is why we talk about a jungle climate, a savanna climate, a taiga climate, among other rainy climates, etc."@en .

ns1:numericValue a owl:DatatypeProperty ;
    rdfs:label "numeric value" ;
    rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt>,
        <http://qudt.org/schema/qudt> .

geo:SpatialObject a owl:Class ;
    rdfs:label "SpatialObject"@en ;
    dc:contributor "Matthew Perry" ;
    dc:creator "OGC GeoSPARQL 1.0 Standard Working Group" ;
    dc:date "2011-06-16"^^xsd:date ;
    dc:description "\\n      The class spatial-object represents everything that can have \\n      a spatial representation. It is superclass of feature and geometry.\\n    "@en ;
    rdfs:comment "\\n      The class spatial-object represents everything that can have \\n      a spatial representation. It is superclass of feature and geometry.\\n    "@en ;
    rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>,
        <http://www.opengis.net/ont/gml>,
        <http://www.opengis.net/spec/geosparql/1.0> ;
    skos:definition "\\n      The class spatial-object represents everything that can have \\n      a spatial representation. It is superclass of feature and geometry.\\n    "@en ;
    skos:prefLabel "SpatialObject"@en .

ns1:unit a owl:ObjectProperty .

sosa:Result a owl:Class ;
    rdfs:label "Result"@en ;
    rdfs:comment "The Result of an Observation, Actuation, or act of Sampling. To store an observation's simple result value one can use the hasSimpleResult property."@en ;
    rdfs:subClassOf ns1:QuantityValue ;
    skos:definition "The Result of an Observation, Actuation, or act of Sampling. To store an observation's simple result value one can use the hasSimpleResult property."@en ;
    skos:example "The value 20 as the height of a certain tree together with the unit, e.g., Meter."@en .

sosa:isHostedBy a owl:ObjectProperty ;
    rdfs:label "is hosted by"@en ;
    ns2:domainIncludes sosa:Actuator,
        sosa:Platform,
        sosa:Sampler,
        sosa:Sensor ;
    ns2:rangeIncludes sosa:Platform ;
    rdfs:comment "Relation between a Sensor, Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by."@en ;
    skos:definition "Relation between a Sensor, Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by."@en .

sosa:hasResult a owl:ObjectProperty ;
    rdfs:label "has result"@en ;
    ns2:domainIncludes sosa:Actuation,
        sosa:Observation,
        sosa:Sampling ;
    ns2:rangeIncludes sosa:Result,
        sosa:Sample ;
    rdfs:comment "Relation linking an Observation or Actuation or act of Sampling and a Result or Sample."@en ;
    owl:inverseOf sosa:isResultOf ;
    skos:definition "Relation linking an Observation or Actuation or act of Sampling and a Result or Sample."@en .

sosa:observedProperty a owl:ObjectProperty ;
    rdfs:label "observed property"@en ;
    ns2:domainIncludes sosa:Observation ;
    ns2:rangeIncludes sosa:ObservableProperty ;
    rdfs:comment "Relation linking an Observation to the property that was observed. The ObservableProperty should be a property of the FeatureOfInterest (linked by hasFeatureOfInterest) of this Observation."@en ;
    skos:definition "Relation linking an Observation to the property that was observed. The ObservableProperty should be a property of the FeatureOfInterest (linked by hasFeatureOfInterest) of this Observation."@en .

sosa:hasFeatureOfInterest a owl:ObjectProperty ;
    rdfs:label "has feature of interest"@en ;
    ns2:domainIncludes sosa:Actuation,
        sosa:Observation,
        sosa:Sampling ;
    ns2:rangeIncludes sosa:FeatureOfInterest,
        sosa:Sample ;
    rdfs:comment "A relation between an Observation and the entity whose quality was observed, or between an Actuation and the entity whose property was modified, or between an act of Sampling and the entity that was sampled."@en ;
    owl:inverseOf sosa:isFeatureOfInterestOf ;
    skos:definition "A relation between an Observation and the entity whose quality was observed, or between an Actuation and the entity whose property was modified, or between an act of Sampling and the entity that was sampled."@en ;
    skos:example "For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight."@en .

sosa:observes a owl:ObjectProperty ;
    rdfs:label "observes"@en ;
    ns2:domainIncludes sosa:Sensor ;
    ns2:rangeIncludes sosa:ObservableProperty ;
    rdfs:comment "Relation between a Sensor and an ObservableProperty that it is capable of sensing."@en ;
    skos:definition "Relation between a Sensor and an ObservableProperty that it is capable of sensing."@en .

sosa:madeBySensor a owl:ObjectProperty ;
    rdfs:label "made by sensor"@en ;
    ns2:domainIncludes sosa:Observation ;
    ns2:rangeIncludes sosa:Sensor ;
    rdfs:comment "Relation between an Observation and the Sensor which made the Observation."@en ;
    owl:inverseOf sosa:madeObservation ;
    skos:definition "Relation between an Observation and the Sensor which made the Observation."@en .

[] ns1:numericValue "520" ;
    ns1:unit <http://qudt.org/vocab/unit/NUM> .

[] ns1:numericValue "40.0" .

