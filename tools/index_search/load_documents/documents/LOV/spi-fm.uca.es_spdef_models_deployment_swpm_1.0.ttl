@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#CodeWorkProduct> a rdfs:Class,
        owl:Class ;
    rdfs:label "The CodeWorkProduct entity" ;
    rdfs:comment "Clase que representa la base de código de un proyecto\\n   software." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#InternalProduct> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#DeliverableProduct> a rdfs:Class,
        owl:Class ;
    rdfs:label "The DeliverableProduct entity" ;
    rdfs:comment "Clase abstracta que representa un producto de trabajo\\n   desarrollado durante el transcurso de un proyecto software y con\\n   valor para terceros." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#WorkProduct> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#DocumentaryWorkProduct> a rdfs:Class,
        owl:Class ;
    rdfs:label "The DocumentaryWorkProduct entity" ;
    rdfs:comment "Clase que representa un documento técnico de trabajo." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#InternalProduct> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#InternalProduct> a rdfs:Class,
        owl:Class ;
    rdfs:label "The InternalProduct entity" ;
    rdfs:comment "Clase abstracta que representa un producto interno al\\n   desarrollo o mantenimiento de software. Puede ser de tipo documental\\n   o de código." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#WorkProduct> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Model> a rdfs:Class,
        owl:Class ;
    rdfs:label "The Model entity" ;
    rdfs:comment "Clase que representa un modelo diseñado haciendo uso un\\n   lenguaje de modelado." ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Project> a rdfs:Class,
        owl:Class ;
    rdfs:label "The Project entity" ;
    rdfs:comment "Clase contenedora de todos los productos de trabajo de\\n   un proyecto." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf doap:Project .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Section> a rdfs:Class,
        owl:Class ;
    rdfs:label "The Section entity" ;
    rdfs:comment "Clase que representa una sección dentro de un\\n   determinado documento generado durante el proyecto." ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#SourcePackage> a rdfs:Class,
        owl:Class ;
    rdfs:label "The SourcePackage entity" ;
    rdfs:comment "Clase que representa un determinado paquete de código\\n   fuente basado en algún lenguaje de programación." ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Specification> a rdfs:Class,
        owl:Class ;
    rdfs:label "The Specification entity" ;
    rdfs:comment "Clase que representa una especificación textual de algún\\n   aspecto del proyecto software." ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#WorkProduct> a rdfs:Class,
        owl:Class ;
    rdfs:label "The WorkProduct entity" ;
    rdfs:comment "Clase abstracta y similar al concepto de WorkProduct en\\n   SPEM que representa un determinado producto generado o\\n   mantenido durante el proceso software. Se distinguen entre productos\\n   entregables o internos." ;
    rdfs:isDefinedBy onto: .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#description> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "The description attribute" ;
    rdfs:comment "Descripción de un proyecto, producto de trabajo, sección, modelo, especificación o paquete de código fuente" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Model>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Project>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Section>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#SourcePackage>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Specification>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#WorkProduct> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:description .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#embeddedSections> a rdf:Property ;
    rdfs:label "The embeddedSections reference" ;
    rdfs:comment "Secciones incluidas dentro de una sección de un producto de trabajo documental" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Section> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Section> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#embeddedWorkproducts> a rdf:Property ;
    rdfs:label "The embeddedWorkproducts reference" ;
    rdfs:comment "Productos de trabajo incluidos dentro de un producto entregable" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#DeliverableProduct> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#WorkProduct> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#models> a rdf:Property ;
    rdfs:label "The models reference" ;
    rdfs:comment "Modelos de Ingeniería del Software incluidos dentro de una sección de un producto de trabajo documental" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Section> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Model> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#name> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "The name attribute" ;
    rdfs:comment "Descripción de un proyecto, producto de trabajo, sección, modelo, especificación o paquete de código fuente" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Model>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Project>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Section>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#SourcePackage>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Specification>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#WorkProduct> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:title .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#order> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "The order attribute" ;
    rdfs:comment "Orden de la sección dentro de un producto de trabajo de tipo documental" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Section> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:int .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#packages> a rdf:Property ;
    rdfs:label "The packages reference" ;
    rdfs:comment "Paquetes existentes en un producto de trabajo de código fuente" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#CodeWorkProduct> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#SourcePackage> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#sections> a rdf:Property ;
    rdfs:label "The sections reference" ;
    rdfs:comment "Secciones dentro de un producto de trabajo documental" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#DocumentaryWorkProduct> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Section> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#specifications> a rdf:Property ;
    rdfs:label "The specifications reference" ;
    rdfs:comment "Especificaciones, no basadas en modelos, incluidas dentro de una sección de un producto de trabajo documental" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Section> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Specification> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#type> a rdf:Property ;
    rdfs:label "The type attribute" ;
    rdfs:comment "Tipo de un modelo, especificación, producto entregable o paquete de código fuente" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#DeliverableProduct>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Model>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#SourcePackage>,
        <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Specification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf dc:subject .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#workproducts> a rdf:Property ;
    rdfs:label "The workproducts reference" ;
    rdfs:comment "Productos de trabajo asociados a un proyecto" ;
    rdfs:domain <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#Project> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#WorkProduct> .

<http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#ruizrube> a foaf:Person ;
    foaf:name "Iván Ruiz Rube" .

onto: a owl:Ontology ;
    dc:creator <http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#ruizrube> ;
    dc:description "<p>Tradicionalmente durante el modelado de los procesos software, los productos de trabajo son tratados como unidades atómicas, con nombre pero sin estructura, que se generan o modifican durante el transcurso de los proyectos. De hecho, en el lenguaje SPEM no se dispone de mecanismos para detallar la estructura de los productos de trabajo, permitiendo sólo distinguir si se trata de un artefacto (Artifact), un entregable (Deliverable) o un resultado (Outcome) del proyecto.</p>\\n\\n<p>Los productos de trabajo típicos en los procesos software suelen ser principalmente documentos o código fuente y suelen gestionarse desde herramientas especializadas o genéricas. Por ejemplo, las herramientas de modelado software, como Rational Rose, o los sistemas de control de versiones, como Git, son ejemplos de herramientas especializadas que ofrecen soporte a la gestión de ciertos tipos de productos de trabajo. Sin embargo, otras herramientas genéricas como los sistemas de gestión de contenidos, los sistemas de gestión documental o los sistemas de edición colaborativa o wiki también pueden utilizarse para albergar evidencias de los procesos.</p>\\n\\n<p>El diseño de modelos para ciertos tipos de productos de trabajo ha sido una aproximación utilizada en diversas metodologías web dirigidas por modelos. Sin embargo, es habitual la necesidad de adaptar y personalizar metodologías conocidas para su aplicación en organizaciones específicas y para situaciones concretas, lo que se conoce como process tailoring. Por ello, se propone un vocabulario que permita definir productos de trabajo flexibles en cuanto a la estructura y tipo de sus artefactos.</p>" ;
    dc:modified "2013-12-19"^^xsd:date ;
    dc:title "Software Work Product Model" ;
    vann:preferredNamespacePrefix "swpm" ;
    vann:preferredNamespaceUri "http://spi-fm.uca.es/spdef/models/deployment/swpm/1.0#" ;
    foaf:page onto:.html .

