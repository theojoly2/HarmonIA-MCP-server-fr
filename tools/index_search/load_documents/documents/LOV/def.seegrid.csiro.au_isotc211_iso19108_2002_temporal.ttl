@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#GeometricComplex> a owl:Class ;
    rdfs:label "Temporal geometric complex"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#primitive> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#GeometricPrimitive> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#primitive> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Complex> ;
    skos:notation "TM_GeometricComplex"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Coordinate> a owl:Class ;
    rdfs:label "Temporal Coordinate"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Number> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#CoordinateSystem> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#frame> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TemporalPosition> ;
    skos:notation "TM_Coordinate"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#CalDate> a owl:Class ;
    rdfs:label "Calendar date"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Calendar> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#frame> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TemporalPosition> ;
    skos:notation "TM_CalDate"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Calendar> a owl:Class ;
    rdfs:label "Calendar"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ReferenceSystem> ;
    skos:notation "TM_Calendar"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Clock> a owl:Class ;
    rdfs:label "Clock"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ReferenceSystem> ;
    skos:notation "TM_Clock"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ClockTime> a owl:Class ;
    rdfs:label "Clock time"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Clock> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#frame> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:time ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#value> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TemporalPosition> ;
    skos:notation "TM_ClockTime"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#CoordinateSystem> a owl:Class ;
    rdfs:label "Temporal Coordinate System"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ReferenceSystem> ;
    skos:notation "TM_CoordinateSystem"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalPosition> a owl:Class ;
    rdfs:label "Temporal ordinal position"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalReferenceSystem> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#frame> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalEra> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ordinalValue> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TemporalPosition> ;
    skos:notation "TM_OrdinalPosition"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TopologicalComplex> a owl:Class ;
    rdfs:label "Temporal topologic complex"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#primitive> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TopologicalPrimitive> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#primitive> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Complex> ;
    skos:notation "TM_TopologicalComplex"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#component> a owl:ObjectProperty ;
    rdfs:label "component era"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalReferenceSystem> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalEra> ;
    rdfs:subPropertyOf skos:hasTopConcept ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#system> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#date> a owl:ObjectProperty ;
    rdfs:label "calendar date"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#DateAndTime> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#CalDate> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#dateTimePosition> a owl:DatatypeProperty ;
    rdfs:label "date or dateTime position"^^xsd:string ;
    rdfs:comment "The value of this property is a time encoded as an xsd:dateTime"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Instant> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Date> <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#DateTime> ) ] .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#member> a owl:ObjectProperty ;
    rdfs:label "member era"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalEra> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalEra> ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#group> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#name> a owl:ObjectProperty ;
    rdfs:label "name"^^xsd:string ;
    rdfs:isDefinedBy onto: .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#nextEdge> a owl:ObjectProperty ;
    rdfs:label "next edge"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Edge> ;
    rdfs:subPropertyOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begunBy> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#previousEdge> a owl:ObjectProperty ;
    rdfs:label "previous edge"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Edge> ;
    rdfs:subPropertyOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#endedBy> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#system> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "parent reference system"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalEra> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalReferenceSystem> ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#component> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#temporalPosition> a owl:ObjectProperty ;
    rdfs:label "temporal position"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TemporalPosition> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#time> a owl:ObjectProperty ;
    rdfs:label "clock time"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#DateAndTime> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ClockTime> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#DateAndTime> a owl:Class ;
    rdfs:label "Date and time"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#time> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#date> ] ;
    skos:notation "TM_DateAndTime"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Object> a owl:Class ;
    rdfs:label "Temporal Object"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf owl:Thing ;
    skos:notation "TM_Object"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#domainOfValidity> a owl:ObjectProperty ;
    rdfs:label "domain of validity"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ReferenceSystem> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#Extent> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#group> a owl:ObjectProperty ;
    rdfs:label "parent era"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalEra> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalEra> ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#member> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ordinalValue> a owl:ObjectProperty ;
    rdfs:label "ordinal time position"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalPosition> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalEra> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalReferenceSystem> a owl:Class ;
    rdfs:label "Temporal Ordinal Reference System"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ReferenceSystem> ;
    skos:notation "TM_OrdinalReferenceSystem"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begunBy> a owl:ObjectProperty ;
    rdfs:label "begun by"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Instant> <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Period> <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Edge> ) ] ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begin> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#complex> a owl:ObjectProperty ;
    rdfs:label "complex"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Primitive> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Complex> ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#primitive> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#endedBy> a owl:ObjectProperty ;
    rdfs:label "ended by"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Instant> <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Period> <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Edge> ) ] ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#end> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Complex> a owl:Class ;
    rdfs:label "Temporal Complex"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#primitive> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Object> ;
    skos:notation "TM_Complex"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Primitive> a owl:Class ;
    rdfs:label "Temporal Primitive"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Object> ;
    skos:notation "TM_Primitive"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#value> a owl:DatatypeProperty ;
    rdfs:label "temporal position value"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TemporalPosition> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdf:value .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#GeometricPrimitive> a owl:Class ;
    rdfs:label "Temporal Geometric Primitive"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Primitive> ;
    skos:notation "TM_GeometricPrimitive"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Period> a owl:Class ;
    rdfs:label "Temporal Period"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#topology> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Edge> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#topology> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Instant> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begin> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#end> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begin> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Instant> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#end> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#GeometricPrimitive> ;
    skos:notation "TM_Period"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TopologicalPrimitive> a owl:Class ;
    rdfs:label "Temporal Topological Primitive"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TopologicalComplex> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#complex> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#complex> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Primitive> ;
    skos:notation "TM_TopologicalPrimitive"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begin> a owl:ObjectProperty ;
    rdfs:label "beginning instant or node"^^xsd:string ;
    rdfs:comment "The value of this property defines the beginning of a time period"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Period> <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Edge> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Instant> <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> ) ] ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begunBy> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#end> a owl:ObjectProperty ;
    rdfs:label "ending instant or node"^^xsd:string ;
    rdfs:comment "The value of this property defines the end of a time period"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Period> <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Edge> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Instant> <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> ) ] ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#endedBy> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#frame> a owl:ObjectProperty ;
    rdfs:label "temporal reference system or frame"^^xsd:string ;
    rdfs:comment "The value of this property indicates the temporal reference system for a time position"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TemporalPosition> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ReferenceSystem> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#geometry> a owl:ObjectProperty ;
    rdfs:label "temporal geometry"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TopologicalPrimitive> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#GeometricPrimitive> ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#topology> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#topology> a owl:ObjectProperty ;
    rdfs:label "temporal topology"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#GeometricPrimitive> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TopologicalPrimitive> ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#geometry> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ReferenceSystem> a owl:Class ;
    rdfs:label "Temporal Reference System"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#Extent> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#domainOfValidity> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#name> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#domainOfValidity> ] ;
    skos:notation "TM_ReferenceSystem"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#primitive> a owl:ObjectProperty ;
    rdfs:label "primitive member"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Complex> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Primitive> ;
    owl:inverseOf <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#complex> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Edge> a owl:Class ;
    rdfs:label "Temporal Edge"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#end> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#end> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begin> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begin> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Period> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#geometry> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#geometry> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TopologicalPrimitive> ;
    skos:notation "TM_Edge"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TemporalPosition> a owl:Class ;
    rdfs:label "Temporal position"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#frame> ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#value> ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#ordinalValue> ] ) ] ;
    skos:notation "TM_TemporalPosition"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Instant> a owl:Class ;
    rdfs:label "Temporal Instant"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#dateTimePosition> ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#temporalPosition> ] ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#topology> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#begunBy> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#topology> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#endedBy> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#GeometricPrimitive> ;
    skos:notation "TM_Instant"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#OrdinalEra> a owl:Class ;
    rdfs:label "Temporal ordinal era"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#group> ] ;
    skos:notation "TM_OrdinalEra"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Node> a owl:Class ;
    rdfs:label "Temporal Node"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#previousEdge> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#geometry> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Instant> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#geometry> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#nextEdge> ],
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#TopologicalPrimitive> ;
    skos:notation "TM_Node"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

