@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/goodrelations/v1#> .
@prefix ns2: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns3: <http://purl.org/vocab/whisky/terms/> .
@prefix ns4: <http://creativecommons.org/ns#> .
@prefix ns5: <http://www.w3.org/ns/adms#> .
@prefix onto: <http://rdfs.co/bevon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns3:Distillery rdfs:subClassOf onto:Distillery .

ns3:abv rdfs:subPropertyOf onto:abv .

ns3:distillery rdfs:subPropertyOf onto:distillery .

onto:0.8 a ns4:Work,
        <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology,
        ns5:SemanticAsset ;
    ns4:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <http://jayg.me/> ;
    dcterms:description "\\n    Beverage Ontology is a Web vocabulary for describing beverages, mainly\\n    alcoholic.\\n    "@en ;
    dcterms:hasFormat <http://rdfs.co/bevon/0.8/html>,
        <http://rdfs.co/bevon/0.8/rdf>,
        <http://rdfs.co/bevon/0.8/ttl> ;
    dcterms:identifier "http://rdfs.co/bevon/0.8" ;
    dcterms:isVersionOf onto: ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2015-07-23"^^xsd:date ;
    dcterms:publisher <http://jayg.me/> ;
    dcterms:replaces onto:0.7 ;
    dcterms:rights "Copyright © 2013-2015 James G. Kim Some Rights Reserved." ;
    dcterms:title "BEVON: Beverage Ontology"@en ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:example [ rdfs:label "Whisky & Soda"@en ;
            rdfs:comment "\\n    <pre><code>beverage:WhiskyAndSoda\\n  a owl:NamedIndividual, bevon:Highball , gr:ProductOrServiceModel ;\\n  bevon:name &quot;Whisky &amp; Soda&quot;@en , &quot;위스키 소다&quot;@ko ;\\n  bevon:description &quot;&quot;&quot;\\n    Whisky &amp; Soda is a kind of mixed drinks that are composed of whisky and\\n    carbonated water.\\n    &quot;&quot;&quot;@en ;\\n  bevon:ingredient [\\n    a food:Ingredient ;\\n    bevon:food [\\n      a bevon:Whisky ;\\n      owl:sameAs &lt;http://dbpedia.org/resource/Whisky&gt; ;\\n      dcterms:title &quot;Whisky&quot;@en\\n    ] ;\\n    bevon:quantity [\\n      a gr:QuantitativeValueInteger ;\\n      gr:hasUnitOfMeasurement &quot;OZA&quot; ;\\n      gr:hasValue &quot;2&quot;^^xsd:int\\n    ]\\n  ] , [\\n    a food:Ingredient ;\\n    bevon:food [\\n      a bevon:CarbonatedWater ;\\n      owl:sameAs &lt;http://dbpedia.org/resource/Carbonated_water&gt; ;\\n      dcterms:title &quot;Carbonated Water&quot;@en\\n    ]\\n  ] .</code></pre>\\n    "^^rdf:XMLLiteral ],
        [ rdfs:label "Glenfiddich 12 Year Old"@en ;
            rdfs:comment "\\n    <pre><code>beverage:Glenfiddich12YearOld\\n  a owl:NamedIndividual, bevon:SpeysideSingleMalt , gr:ProductOrServiceModel ;\\n  bevon:name &quot;Glenfiddich 12 Year Old&quot;@en , &quot;글렌피딕 12년&quot;@ko ;\\n  bevon:description &quot;&quot;&quot;\\n    Carefully matured in the finest American bourbon and Spanish sherry oak\\n    casks for at least 12 years. Married and mellowed in oak marrying tuns for\\n    complete harmony of aroma and flavor.\\n\\n    A single malt Scotch whisky with distinctive fresh pear, creamy with subtle\\n    oak flavors and a long smooth and mellow finish.\\n    &quot;&quot;&quot;@en ;\\n  bevon:origin &lt;http://dbpedia.org/resource/Strathspey,_Scotland&gt; ;\\n  bevon:launch &quot;1887&quot;^^xsd:gYear ;\\n  bevon:distillery [\\n    a bevon:Distillery ;\\n    owl:sameAs &lt;http://dbpedia.org/resource/Glenfiddich_distillery&gt; ;\\n    whisky:region &lt;http://dbpedia.org/resource/Strathspey,_Scotland&gt; ;\\n    whisky:owner &lt;http://dbpedia.org/resource/William_Grant_%26_Sons&gt; ;\\n    whisky:waterSource [\\n      a whisky:WaterSource ;\\n      dcterms:title &quot;Robbie Dhu Springs&quot;@en , &quot;로비 듀 수원지&quot;@ko\\n    ]\\n  ] ;\\n  bevon:manufacturer &lt;http://dbpedia.org/resource/William_Grant_%26_Sons&gt; ;\\n  bevon:fermentation_base &lt;http://dbpedia.org/resource/Barley&gt; ;\\n  bevon:aging [\\n    a bevon:Aging ;\\n    bevon:material &lt;http://dbpedia.org/resource/Oak&gt; ;\\n    bevon:previous_content\\n      &lt;http://dbpedia.org/resource/Bourbon_whiskey&gt; ,\\n      &lt;http://dbpedia.org/resource/Sherry&gt; ;\\n    bevon:duration [\\n      a time:DurationDescription ;\\n      time:years &quot;12&quot;^^xsd:decimal\\n    ]\\n  ] ;\\n  bevon:color [\\n    a dbpedia:Colour ;\\n    owl:sameAs &lt;http://dbpedia.org/resource/Gold_(color)&gt; ;\\n    owl:sameAs &lt;http://purl.org/colors/rgb/FFD700&gt; ;\\n    dcterms:title &quot;Gold&quot;@en\\n  ] ;\\n  bevon:abv &quot;40&quot;^^xsd:decimal ;\\n  bevon:container container:700mlGlassBottle .\\n\\ncontainer:700mlGlassBottle a owl:NamedIndividual, bevon:GlassBottle ;\\n  skos:prefLabel &quot;700ml Glass Bottle&quot;@en , &quot;700ml 유리병&quot;@ko ;\\n  skos:altLabel &quot;70cl Glass Bottle&quot;@en ;\\n  bevon:volume [\\n    a gr:QuantitativeValueInteger ;\\n    gr:hasUnitOfMeasurement &quot;MLT&quot; ;\\n    gr:hasValue &quot;700&quot;^^xsd:int\\n  ] .</code></pre>\\n    "^^rdf:XMLLiteral ] ;
    vann:preferredNamespacePrefix "bevon" ;
    vann:preferredNamespaceUri "http://rdfs.co/bevon/" ;
    vann:termGroup onto:BeerGroup,
        onto:CocktailGroup,
        onto:ContainerGroup,
        onto:CoreGroup,
        onto:RelationGroup,
        onto:WhiskyGroup,
        onto:WineGroup ;
    rdfs:comment "\\n    <div>\\n      The master version of this vocabulary is maintained in <a\\n      href=\"https://github.com/jgkim/bevon\">the GitHub repository</a> so others\\n      can contribute edits and improvements.\\n    </div>\\n    ",
        "\\n    Most of the descriptions given here are from Wikipedia or from the websites\\n    of the related products.\\n    "@en ;
    rdfs:seeAlso <https://github.com/jgkim/bevon> ;
    owl:versionInfo "0.8" ;
    skos:changeNote [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2015-07-27"^^xsd:date ;
            rdf:value "\\n      Made the vocabulary as a type of voaf:Vocabulary\\n      "@en ],
        [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2014-03-01"^^xsd:date ;
            rdf:value "\\n      Minor revisions for documentation\\n      "@en ],
        [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2014-03-03"^^xsd:date ;
            rdf:value "\\n      Added a link to the GitHub repository\\n      "@en ],
        [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2014-03-06"^^xsd:date ;
            rdf:value "\\n      Added term groups for core, relation, container, beer, whisky and\\n      cocktail terms\\n      "@en ] ;
    skos:historyNote [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2014-03-07"^^xsd:date ;
            rdf:value "\\n      Changed the semantics of bevon:Wine to be a superclass of wine:Wine\\n      "@en ],
        [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2015-07-23"^^xsd:date ;
            rdf:value "\\n      Fixed the sameAs relationship of bevon:Whisky\\n      "@en ],
        [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2014-03-07"^^xsd:date ;
            rdf:value "\\n      Added bevon:RedWine, bevon:WhiteWine and bevon:FruitWine\\n      "@en ],
        [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2014-03-06"^^xsd:date ;
            rdf:value "\\n      Changed bevon:FermentedBeverages to bevon:FermentedBeverage for the\\n      consistency\\n      "@en ] ;
    ns5:status <http://purl.org/adms/status/UnderDevelopment> .

onto:Cognac a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    It is produced in the wine-growing region surrounding the town from which\\n    it takes its name, in the French Departements of Charente and\\n    Charente-Maritime.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Cognac> ;
    rdfs:subClassOf onto:Brandy,
        <http://www.productontology.org/id/Cognac> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Cognac, named after the town of Cognac in France, is a variety of brandy.\\n    "@en ;
    skos:prefLabel "Cognac"@en .

onto:Gin a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Gin> ;
    rdfs:subClassOf onto:DistilledBeverage,
        <http://www.productontology.org/id/Gin> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Gin is a spirit which derives its predominant flavor from juniper berries\\n    (Juniperus communis).\\n    "@en ;
    skos:prefLabel "Gin"@en .

onto:Liqueur a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Liqueurs are typically quite sweet; they are usually not aged for long\\n    after the ingredients are mixed, but may have resting periods during their\\n    production to allow flavors to marry.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Liqueur> ;
    rdfs:subClassOf onto:DistilledBeverage,
        <http://www.productontology.org/id/Liqueur> ;
    ns2:term_status "testing"@en ;
    skos:altLabel "Cordials"@en,
        "Schnapps"@en ;
    skos:definition "\\n    A liqueur is an alcoholic beverage made from a distilled spirit that has\\n    been flavored with fruit, cream, herbs, spices, flowers or nuts and bottled\\n    with added sugar or other sweetener (such as high-fructose corn syrup).\\n    "@en ;
    skos:prefLabel "Liqueur"@en .

onto:MineralWater a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Mineral water may be sparkling due to contained gases.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Mineral_water> ;
    rdfs:subClassOf onto:Water,
        <http://www.productontology.org/id/Mineral_water> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Mineral water is water from a mineral spring containing various minerals\\n    such as salts and sulfur compounds.\\n    "@en ;
    skos:prefLabel "Mineral Water"@en .

onto:Pisco a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Pisco> ;
    rdfs:subClassOf onto:Brandy,
        <http://www.productontology.org/id/Pisco> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Pisco is a colorless or yellowish-to-amber colored grape brandy produced\\n    in winemaking regions of Peru and Chile.\\n    "@en ;
    skos:prefLabel "Pisco"@en .

onto:Rum a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    The distillate, a clear liquid, is then usually aged in\\n    oak barrels.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Rum> ;
    rdfs:subClassOf onto:DistilledBeverage,
        <http://www.productontology.org/id/Rum> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Rum is a distilled alcoholic beverage made from sugarcane byproducts, such\\n    as molasses, or directly from sugarcane juice, by a process of fermentation\\n    and distillation.\\n    "@en ;
    skos:prefLabel "Rum"@en .

onto:Sake a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Sake> ;
    rdfs:subClassOf onto:FermentedBeverage,
        <http://www.productontology.org/id/Sake> ;
    ns2:term_status "testing"@en ;
    skos:altLabel "Rice Wine"@en ;
    skos:definition "\\n    Sake or saké is an alcoholic beverage of Japanese origin that is made from\\n    fermented rice.\\n    "@en ;
    skos:prefLabel "Sake"@en,
        "Saké"@fr .

onto:Vodka a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Vodka is made by the distillation of fermented substances such as grains,\\n    potatoes, or sometimes fruits or sugar.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Vodka> ;
    rdfs:subClassOf onto:DistilledBeverage,
        <http://www.productontology.org/id/Vodka> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Vodka is a distilled beverage composed primarily of water and ethanol,\\n    sometimes with traces of impurities and flavorings.\\n    "@en ;
    skos:prefLabel "Vodka"@en .

<http://rdfs.co/bevon/beverage/Budweiser> a ns1:ProductOrServiceModel,
        onto:PaleLager,
        owl:NamedIndividual ;
    onto:abv 5.0 ;
    onto:container <http://rdfs.co/bevon/container/330mlLongneck>,
        <http://rdfs.co/bevon/container/355mlBeverageCan>,
        <http://rdfs.co/bevon/container/500mlBeverageCan> ;
    onto:description "\\n    Budweiser is a pale lager produced by Anheuser–Busch InBev. Introduced in\\n    1876 by Adolphus Busch it has grown to become one of the highest selling\\n    beers in the United States, and is available in over 80 markets worldwide.\\n    "@en ;
    onto:fermentation_base <http://dbpedia.org/resource/Barley> ;
    onto:ibu "12"^^xsd:nonNegativeInteger ;
    onto:launch "1876"^^xsd:gYear ;
    onto:manufacturer <http://dbpedia.org/resource/Anheuser–Busch_InBev> ;
    onto:name "Budweiser"@en ;
    onto:origin <http://dbpedia.org/resource/United_States> ;
    onto:srm "3"^^xsd:nonNegativeInteger ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Budweiser_(Anheuser-Busch)> .

<http://rdfs.co/bevon/beverage/Chamisul> a ns1:ProductOrServiceModel,
        onto:DilutedSoju,
        owl:NamedIndividual ;
    onto:abv 19.0 ;
    onto:color [ a <http://dbpedia.org/ontology/Colour> ;
            dcterms:title "Clear"@en ;
            owl:sameAs <http://dbpedia.org/resource/Clear_(color)> ] ;
    onto:container <http://rdfs.co/bevon/container/1_8lPlasticBottle>,
        <http://rdfs.co/bevon/container/200mlPlasticBottle>,
        <http://rdfs.co/bevon/container/360mlGlassBottle>,
        <http://rdfs.co/bevon/container/640mlPlasticBottle> ;
    onto:description "\\n    Chamisul is the diluted soju produced by HITEJiro.\\n    "@en ;
    onto:launch "1998"^^xsd:gYear ;
    onto:manufacturer <http://dbpedia.org/resource/Jinro> ;
    onto:name "Chamisul"@en ;
    onto:origin <http://dbpedia.org/resource/South_Korea> ;
    rdfs:seeAlso <http://ko.wikipedia.org/wiki/참이슬> .

<http://rdfs.co/bevon/beverage/Chum-Churum> a ns1:ProductOrServiceModel,
        onto:DilutedSoju,
        owl:NamedIndividual ;
    onto:abv 19.5 ;
    onto:color [ a <http://dbpedia.org/ontology/Colour> ;
            dcterms:title "Clear"@en ;
            owl:sameAs <http://dbpedia.org/resource/Clear_(color)> ] ;
    onto:container <http://rdfs.co/bevon/container/1_8lPlasticBottle>,
        <http://rdfs.co/bevon/container/200mlPlasticBottle>,
        <http://rdfs.co/bevon/container/360mlGlassBottle>,
        <http://rdfs.co/bevon/container/360mlPlasticBottle>,
        <http://rdfs.co/bevon/container/640mlPlasticBottle> ;
    onto:description "\\n    Chum-Churum is the diluted soju produced by Lotte Liquor.\\n    "@en ;
    onto:launch "2006"^^xsd:gYear ;
    onto:manufacturer [ a foaf:Organization ;
            rdfs:seeAlso <http://ko.wikipedia.org/wiki/롯데칠성음료> ;
            foaf:homepage <http://www.lotteliquor.com> ;
            foaf:name "Lotte Liquor"@en ] ;
    onto:name "Chum-Churum"@en ;
    onto:origin <http://dbpedia.org/resource/South_Korea> ;
    rdfs:seeAlso <http://ko.wikipedia.org/wiki/처음처럼_(주류)> ;
    owl:sameAs <http://dbpedia.org/resource/Chum-Churum> .

<http://rdfs.co/bevon/beverage/DonJulioBlanco> a ns1:ProductOrServiceModel,
        onto:TequilaBlanco,
        owl:NamedIndividual ;
    onto:abv 40.0 ;
    onto:color [ a <http://dbpedia.org/ontology/Colour> ;
            dcterms:title "Clear"@en ;
            owl:sameAs <http://dbpedia.org/resource/Clear_(color)> ] ;
    onto:container <http://rdfs.co/bevon/container/750mlGlassBottle> ;
    onto:description "\\n    Tequila Don Julio Blanco is the base from which all of our other variants\\n    are derived. Commonly referred to as \"silver\" tequila, its crisp agave\\n    flavor and hints of citrus make it an essential component to a variety of\\n    innovative drinks including margaritas. It can also be enjoyed neat or on\\n    the rocks.\\n    "@en ;
    onto:fermentation_base <http://dbpedia.org/resource/Agave> ;
    onto:launch "1942"^^xsd:gYear ;
    onto:manufacturer <http://dbpedia.org/resource/Diageo> ;
    onto:name "Don Julio Blanco"@en ;
    onto:origin <http://dbpedia.org/resource/Mexico> ;
    onto:proof 80.0 ;
    rdfs:seeAlso <http://www.donjulio.com/blanco.aspx> .

<http://rdfs.co/bevon/beverage/Glenfiddich12YearOld> a ns1:ProductOrServiceModel,
        onto:SpeysideSingleMalt,
        owl:NamedIndividual ;
    onto:abv 40.0 ;
    onto:aging [ a onto:Aging ;
            onto:duration [ a time:DurationDescription ;
                    time:years 12.0 ] ;
            onto:material <http://dbpedia.org/resource/Oak> ;
            onto:previous_content <http://dbpedia.org/resource/Bourbon_whiskey>,
                <http://dbpedia.org/resource/Sherry> ] ;
    onto:color [ a <http://dbpedia.org/ontology/Colour> ;
            dcterms:title "Gold"@en ;
            owl:sameAs <http://dbpedia.org/resource/Gold_(color)>,
                <http://purl.org/colors/rgb/FFD700> ] ;
    onto:container <http://rdfs.co/bevon/container/700mlGlassBottle> ;
    onto:description "\\n    Carefully matured in the finest American bourbon and Spanish sherry oak\\n    casks for at least 12 years. Married and mellowed in oak marrying tuns for\\n    complete harmony of aroma and flavor.\\n\\n    A single malt Scotch whisky with distinctive fresh pear, creamy with subtle\\n    oak flavors and a long smooth and mellow finish.\\n    "@en ;
    onto:distillery [ a onto:Distillery ;
            ns3:owner <http://dbpedia.org/resource/William_Grant_%26_Sons> ;
            ns3:region <http://dbpedia.org/resource/Strathspey,_Scotland> ;
            ns3:waterSource [ a ns3:WaterSource ;
                    dcterms:title "Robbie Dhu Springs"@en ] ;
            owl:sameAs <http://dbpedia.org/resource/Glenfiddich_distillery> ] ;
    onto:fermentation_base <http://dbpedia.org/resource/Barley> ;
    onto:launch "1887"^^xsd:gYear ;
    onto:manufacturer <http://dbpedia.org/resource/William_Grant_%26_Sons> ;
    onto:name "Glenfiddich 12 Year Old"@en ;
    onto:origin <http://dbpedia.org/resource/Strathspey,_Scotland> .

<http://rdfs.co/bevon/beverage/Guinness> a ns1:ProductOrServiceModel,
        onto:DryStout,
        owl:NamedIndividual ;
    onto:abv 4.2 ;
    onto:container <http://rdfs.co/bevon/container/15lBeerKeg>,
        <http://rdfs.co/bevon/container/30lBeerKeg>,
        <http://rdfs.co/bevon/container/330mlBeverageCan>,
        <http://rdfs.co/bevon/container/330mlLongneck> ;
    onto:description "\\n    Guinness is a popular Irish dry stout that originated in the brewery of\\n    Arthur Guinness (1725–1803) at St. James's Gate, Dublin. Guinness is one\\n    of the most successful beer brands worldwide.\\n    "@en ;
    onto:fermentation_base <http://dbpedia.org/resource/Barley> ;
    onto:ibu "37"^^xsd:nonNegativeInteger ;
    onto:launch "1759"^^xsd:gYear ;
    onto:manufacturer <http://dbpedia.org/resource/Diageo> ;
    onto:name "Guinness Draught"@en ;
    onto:origin <http://dbpedia.org/resource/Dublin> ;
    onto:srm "32"^^xsd:nonNegativeInteger ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Guinness> ;
    owl:sameAs <http://dbpedia.org/resource/Guinness> .

<http://rdfs.co/bevon/beverage/KozelDark> a ns1:ProductOrServiceModel,
        onto:Dunkel,
        owl:NamedIndividual ;
    onto:abv 3.8 ;
    onto:container <http://rdfs.co/bevon/container/500mlLongneck> ;
    onto:description "\\n    Velkopopovický Kozel Dark beer is brewed to the original recipe using a\\n    special mix of dark malts, clean water from our own well close to the\\n    brewery, and a selection of the best hops. The caramelized malt gives this\\n    beer a unique ruby color and sweet flavor, thanks to which it is\\n    appreciated and respected all over the world.\\n    "@en ;
    onto:fermentation_base <http://dbpedia.org/resource/Barley> ;
    onto:launch "1874"^^xsd:gYear ;
    onto:manufacturer <http://dbpedia.org/resource/SABMiller> ;
    onto:name "Velkopopovický Kozel Dark"@en ;
    onto:origin <http://dbpedia.org/resource/Velké_Popovice> .

<http://rdfs.co/bevon/beverage/Tsingtao> a ns1:ProductOrServiceModel,
        onto:Pilsner,
        owl:NamedIndividual ;
    onto:abv 4.7 ;
    onto:brewery <http://dbpedia.org/resource/Tsingtao_Brewery> ;
    onto:container <http://rdfs.co/bevon/container/330mlLongneck>,
        <http://rdfs.co/bevon/container/355mlBeverageCan>,
        <http://rdfs.co/bevon/container/500mlBeverageCan>,
        <http://rdfs.co/bevon/container/640mlLongneck> ;
    onto:description "\\n    Tsingtao Lager, a well-hopped standard pilsner of 4.7% alcohol, is the\\n    flagship brew, accounting for most of the brewery's production.\\n    "@en ;
    onto:fermentation_base <http://dbpedia.org/resource/Barley> ;
    onto:ibu "20"^^xsd:nonNegativeInteger ;
    onto:launch "1904"^^xsd:gYear ;
    onto:manufacturer <http://dbpedia.org/resource/Tsingtao_Brewery> ;
    onto:name "Tsingtao Lager"@en ;
    onto:origin <http://dbpedia.org/resource/Qingdao> ;
    onto:srm "4"^^xsd:nonNegativeInteger .

<http://rdfs.co/bevon/beverage/WhiskyAndSoda> a ns1:ProductOrServiceModel,
        onto:Highball,
        owl:NamedIndividual ;
    onto:description "\\n    Whisky & Soda is a kind of mixed drinks that are composed of whisky and\\n    carbonated water.\\n    "@en ;
    onto:ingredient [ a <http://data.lirmm.fr/ontologies/food#Ingredient> ;
            onto:food [ a onto:CarbonatedWater ;
                    dcterms:title "Carbonated Water"@en ;
                    owl:sameAs <http://dbpedia.org/resource/Carbonated_water> ] ],
        [ a <http://data.lirmm.fr/ontologies/food#Ingredient> ;
            onto:food [ a onto:Whisky ;
                    dcterms:title "Whisky"@en ;
                    owl:sameAs <http://dbpedia.org/resource/Whisky> ] ;
            onto:quantity [ a ns1:QuantitativeValueInteger ;
                    ns1:hasUnitOfMeasurement "OZA" ;
                    ns1:hasValue "2"^^xsd:int ] ] ;
    onto:name "Whisky & Soda"@en .

<http://rdfs.co/bevon/container/25lBeerKeg> a onto:BeerKeg,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "LTR" ;
            ns1:hasValue "25"^^xsd:int ] ;
    skos:prefLabel "25l Beer Keg"@en .

<http://rdfs.co/bevon/container/50lBeerKeg> a onto:BeerKeg,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "LTR" ;
            ns1:hasValue "50"^^xsd:int ] ;
    skos:prefLabel "50l Beer Keg"@en .

onto:duration a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Aging ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:DurationDescription ;
    rdfs:subPropertyOf time:hasDurationDescription ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property describes how long the beverage was aged in the cask.\\n    "@en ;
    skos:prefLabel "duration"@en .

onto:food a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain <http://data.lirmm.fr/ontologies/food#Ingredient> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://data.lirmm.fr/ontologies/food#Food> ;
    rdfs:subPropertyOf <http://data.lirmm.fr/ontologies/food#food> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property describes food that is an ingredient of a mixed drink.\\n    "@en ;
    skos:prefLabel "food"@en .

onto:material a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Aging ;
    rdfs:isDefinedBy onto: ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property specifies what the aging cask was made of.\\n    "@en ;
    skos:prefLabel "material"@en .

onto:previous_content a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Aging ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#PotableLiquid> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property specifies what as in the cask before the aging.\\n    "@en ;
    skos:prefLabel "previous content"@en .

onto:quantity a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain <http://data.lirmm.fr/ontologies/food#Ingredient> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:QuantitativeValue ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property specifies the quantity of the ingredient with a type\\n    in the UN/CEFACT Common Code.\\n    "@en ;
    skos:prefLabel "quantity"@en .

<http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#Wine> rdfs:subClassOf onto:Wine .

<http://rdfs.co/bevon/0.8/html> dcterms:format [ a dcterms:MediaType ;
            rdfs:label "HTML"@en ;
            dcam:memberOf dcterms:IMT ;
            rdf:value "text/html" ;
            rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/html> ] .

<http://rdfs.co/bevon/0.8/rdf> dcterms:format [ a dcterms:MediaType ;
            rdfs:label "RDF/XML"@en ;
            dcam:memberOf dcterms:IMT ;
            rdf:value "application/rdf+xml" ;
            rdfs:seeAlso <http://www.iana.org/assignments/media-types/application/rdf+xml> ] .

<http://rdfs.co/bevon/0.8/ttl> dcterms:format [ a dcterms:MediaType ;
            rdfs:label "Turtle"@en ;
