            rdf:value "text/turtle" ;
            rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/turtle> ] .

onto:AmericanWhiskey a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    The production and labeling of American whiskey are governed by Title 27 of\\n    the U.S. Code of Federal Regulations.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/American_whiskey> ;
    rdfs:subClassOf onto:Whisky,
        <http://www.productontology.org/id/American_whiskey> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "American Whisky"@en ;
    skos:definition "\\n    American whiskey is a distilled beverage produced in the United States from\\n    a fermented mash of cereal grain.\\n    "@en ;
    skos:prefLabel "American Whiskey"@en .

onto:BeerCocktail a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Beer_cocktail> ;
    rdfs:subClassOf onto:Cocktail,
        <http://www.productontology.org/id/Beer_cocktail> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A beer cocktail is a cocktail that is made by mixing beer with a distilled\\n    beverage. In this type of cocktail, the primary ingredient is beer.\\n    "@en ;
    skos:prefLabel "Beer Cocktail"@en .

onto:BeerGroup a rdf:Bag ;
    rdfs:label "Beer Terms"@en ;
    rdf:_1 onto:Beer ;
    rdf:_10 onto:PaleLager ;
    rdf:_11 onto:Pilsner ;
    rdf:_12 onto:NonAlcoholicBeer ;
    rdf:_13 onto:Brewery ;
    rdf:_14 onto:BeerBottle ;
    rdf:_15 onto:Longneck ;
    rdf:_16 onto:BeerKeg ;
    rdf:_17 onto:ibu ;
    rdf:_18 onto:srm ;
    rdf:_19 onto:brewery ;
    rdf:_2 onto:Ale ;
    rdf:_3 onto:PaleAle ;
    rdf:_4 onto:IrishRedAle ;
    rdf:_5 onto:Porter ;
    rdf:_6 onto:Stout ;
    rdf:_7 onto:DryStout ;
    rdf:_8 onto:Lager ;
    rdf:_9 onto:Dunkel ;
    rdfs:comment "\\n    In addition to the BEVON core terms, there are a number of terms for use\\n    when describing beverages categorized under Beer.\\n    "@en .

onto:BourbonWhiskey a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    The name of the spirit derives from its historical association with an area\\n    known as Old Bourbon, around what is now Bourbon County, Kentucky (which,\\n    in turn, was named after the French House of Bourbon royal family). It has\\n    been produced since the 18th century. While it may be made anywhere in the\\n    United States, it is strongly associated with the American South in\\n    general, and Kentucky in particular.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Bourbon_whiskey> ;
    rdfs:subClassOf onto:AmericanWhisky,
        <http://www.productontology.org/id/Bourbon_whiskey> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Bourbon Whisky"@en ;
    skos:definition "\\n    Bourbon whiskey is a type of American whiskey – a barrel-aged distilled\\n    spirit made primarily from corn.\\n    "@en ;
    skos:prefLabel "Bourbon Whiskey"@en .

onto:CanadianWhisky a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Most Canadian whiskies are blended multi-grain liquors containing a large\\n    percentage of corn spirits, and are typically lighter and smoother than\\n    other whisky styles.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Canadian_whisky> ;
    rdfs:subClassOf onto:Whisky,
        <http://www.productontology.org/id/Canadian_whisky> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Canadian Whiskey"@en ;
    skos:definition "\\n    Canadian whisky is a type of whisky produced in Canada.\\n    "@en ;
    skos:prefLabel "Canadian Whisky"@en .

onto:CarbonatedWater a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Carbonated_water> ;
    rdfs:subClassOf onto:Water,
        <http://www.productontology.org/id/Carbonated_water> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Club Soda"@en,
        "Fizzy Water"@en,
        "Seltzer Water"@en,
        "Soda Water"@en,
        "Sparkling Water"@en ;
    skos:definition "\\n    Carbonated water is water into which carbon dioxide gas under pressure has\\n    been dissolved.\\n    "@en ;
    skos:prefLabel "Carbonated Water"@en .

onto:CocktailGroup a rdf:Bag ;
    rdfs:label "Cocktail Terms"@en ;
    rdf:_1 onto:Cocktail ;
    rdf:_2 onto:Highball ;
    rdf:_3 onto:BeerCocktail ;
    rdf:_4 onto:Shandy ;
    rdf:_5 onto:Mocktail ;
    rdfs:comment "\\n    These classes and properties are for describing beverages categorized under\\n    Mixed Drink.\\n    "@en .

onto:ContainerGroup a rdf:Bag ;
    rdfs:label "Container Terms"@en ;
    rdf:_1 onto:Container ;
    rdf:_2 onto:BeverageCan ;
    rdf:_3 onto:GlassBottle ;
    rdf:_4 onto:PlasticBottle ;
    rdf:_5 onto:Keg ;
    rdf:_6 onto:volume ;
    rdfs:comment "\\n    These classes and properties are used to describe beverage containers.\\n    "@en .

onto:CoreGroup a rdf:Bag ;
    rdfs:label "Core Terms"@en ;
    rdf:_1 onto:Beverage ;
    rdf:_10 onto:Distillery ;
    rdf:_11 onto:name ;
    rdf:_12 onto:description ;
    rdf:_13 onto:origin ;
    rdf:_14 onto:manufacturer ;
    rdf:_15 onto:color ;
    rdf:_16 onto:launch ;
    rdf:_17 onto:abv ;
    rdf:_18 onto:proof ;
    rdf:_19 onto:container ;
    rdf:_2 onto:AlcoholicBeverage ;
    rdf:_20 onto:aging ;
    rdf:_21 onto:fermentation_base ;
    rdf:_22 onto:distillery ;
    rdf:_23 onto:ingredient ;
    rdf:_3 onto:FermentedBeverage ;
    rdf:_4 onto:DistilledBeverage ;
    rdf:_5 onto:NonAlcoholicBeverage ;
    rdf:_6 onto:MixedDrink ;
    rdf:_7 onto:Container ;
    rdf:_8 onto:Aging ;
    rdf:_9 onto:FermentationBase ;
    rdfs:comment "\\n    These classes and properties form the core of BEVON. They describe\\n    characteristics of beverages in relatively broad terms.\\n    "@en .

onto:DistilledSoju a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Soju ;
    owl:disjointWith onto:DilutedSoju ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Distilled Soju is manufactured traditionally by distillation from grains,\\n    mainly rice.\\n    "@en ;
    skos:prefLabel "Distilled Soju"@en .

onto:FruitWine a owl:Class ;
    dcterms:issued "2014-03-07"^^xsd:date ;
    dcterms:modified "2014-03-07"^^xsd:date ;
    rdfs:comment "\\n    This definition is sometimes broadened to include any fermented alcoholic\\n    beverage except beer. For historical reasons, mead, cider, and perry are\\n    also excluded from the definition of fruit wine.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Fruit_wine> ;
    rdfs:subClassOf onto:Wine,
        <http://www.productontology.org/id/Fruit_wine> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Fruit wines are fermented alcoholic beverages made from a variety of base\\n    ingredients (other than grapes); they may also have additional flavors\\n    taken from fruits, flowers, and herbs.\\n    "@en ;
    skos:prefLabel "Fruit Wine"@en,
        "Vin de Sureau"@fr .

onto:IrishWhiskey a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Key regulations defining Irish whiskey and its production are established\\n    by the Irish Whiskey Act of 1980.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Irish_whiskey> ;
    rdfs:subClassOf onto:Whisky,
        <http://www.productontology.org/id/Irish_whiskey> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Irish Whisky"@en ;
    skos:definition "\\n    Irish whiskey is whisky made in Ireland.\\n    "@en ;
    skos:prefLabel "Irish Whiskey"@en .

onto:JapaneseWhisky a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Whisky production in Japan began around 1870, but the first commercial\\n    production was in 1924 upon the opening of the country's first distillery,\\n    Yamazaki. Broadly speaking the style of Japanese whisky is more similar to\\n    that of Scotch whisky than Irish, American, or Canadian styles of whisky,\\n    and thus the spelling typically follows the Scottish convention (omitting\\n    the letter \"e\").\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Japanese_whisky> ;
    rdfs:subClassOf onto:Whisky,
        <http://www.productontology.org/id/Japanese_whisky> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Japanese Whiskey"@en ;
    skos:definition "\\n    Japanese whisky is whisky made in Japan.\\n    "@en ;
    skos:prefLabel "Japanese Whisky"@en .

onto:RedWine a owl:Class ;
    dcterms:issued "2014-03-07"^^xsd:date ;
    dcterms:modified "2014-03-07"^^xsd:date ;
    rdfs:comment "\\n    The actual colour of the wine can range from intense violet, typical of\\n    young wines, through to brick red for mature wines and brown for older red\\n    wines.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Red_wine> ;
    rdfs:subClassOf onto:Wine,
        <http://www.productontology.org/id/Red_wine> ;
    owl:sameAs <http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#RedWine> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Red wine is a type of wine made from dark-coloured (black) grape varieties.\\n    "@en ;
    skos:prefLabel "Red Wine"@en,
        "Vin Rouge"@fr .

onto:RelationGroup a rdf:Bag ;
    rdfs:label "Relation Terms"@en ;
    rdf:_1 onto:related ;
    rdf:_2 onto:similar ;
    rdf:_3 onto:variant ;
    rdf:_4 onto:variantOf ;
    rdf:_5 onto:non_alcoholic_version ;
    rdfs:comment "\\n    These properties are used for describing relations between beverages.\\n    "@en .

onto:Shandy a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    The proportions of the two ingredients are adjusted to taste, usually\\n    half-and-half.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Shandy> ;
    rdfs:subClassOf onto:Cocktail,
        <http://www.productontology.org/id/Shandy> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A shandy, or shandygaff, is beer mixed with a soft drink, carbonated\\n    lemonade, ginger beer, ginger ale, or apple juice.\\n    "@en ;
    skos:prefLabel "Shandy"@en .

onto:Tequila a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Tequila> ;
    rdfs:subClassOf onto:DistilledBeverage,
        <http://www.productontology.org/id/Tequila> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Tequila is a distilled beverage made from the blue agave plant, primarily\\n    in the area surrounding the city of Tequila, 65 kilometres (40 mi)\\n    northwest of Guadalajara, and in the highlands (Los Altos) of the western\\n    Mexican state of Jalisco.\\n    "@en ;
    skos:prefLabel "Tequila"@en .

onto:TequilaBlanco a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Tequila ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Tequila Plata"@en ;
    skos:definition "\\n    Tequila Blanco (\"white\") or Plata (\"silver\") is a white spirit, un-aged and\\n    bottled or stored immediately after distillation, or aged less than two\\n    months in stainless steel or neutral oak barrels.\\n    "@en ;
    skos:prefLabel "Tequila Blanco"@en .

onto:WhiskyGroup a rdf:Bag ;
    rdfs:label "Whisky Terms"@en ;
    rdf:_1 onto:Whisky ;
    rdf:_10 onto:SingleMaltScotch ;
    rdf:_11 onto:SpeysideSingleMalt ;
    rdf:_2 onto:AmericanWhiskey ;
    rdf:_3 onto:BourbonWhiskey ;
    rdf:_4 onto:CanadianWhisky ;
    rdf:_5 onto:IrishWhiskey ;
    rdf:_6 onto:JapaneseWhisky ;
    rdf:_7 onto:ScotchWhisky ;
    rdf:_8 onto:MaltWhisky ;
    rdf:_9 onto:SingleMaltWhisky ;
    rdfs:comment "\\n    These classes describe types of whiskies.\\n    "@en .

onto:WhiteWine a owl:Class ;
    dcterms:issued "2014-03-07"^^xsd:date ;
    dcterms:modified "2014-03-07"^^xsd:date ;
    rdfs:comment "\\n    It is produced by the alcoholic fermentation of the non-coloured pulp of\\n    grapes which may have a white or black skin. It is treated so as to\\n    maintain a yellow transparent colour in the final product.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/White_wine> ;
    rdfs:subClassOf onto:Wine,
        <http://www.productontology.org/id/White_wine> ;
    owl:sameAs <http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WhiteWine> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    White wine is a wine whose colour can be straw-yellow, yellow-green, or\\n    yellow-gold coloured.\\n    "@en ;
    skos:prefLabel "White Wine"@en,
        "Vin Blanc"@fr .

onto:WineGroup a rdf:Bag ;
    rdfs:label "Wine Terms"@en ;
    rdf:_1 onto:Wine ;
    rdf:_2 onto:RedWine ;
    rdf:_3 onto:WhiteWine ;
    rdf:_4 onto:FruitWine ;
    rdfs:comment "\\n    These classes describe types of wines.\\n    "@en .

onto:aging a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:AlcoholicBeverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Aging ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property specifies how the beverage has been aged.\\n    "@en ;
    skos:prefLabel "aging"@en .

<http://rdfs.co/bevon/beverage/Kilkenny> a ns1:ProductOrServiceModel,
        onto:IrishRedAle,
        owl:NamedIndividual ;
    onto:abv 4.3 ;
    onto:container <http://rdfs.co/bevon/container/30lBeerKeg>,
        <http://rdfs.co/bevon/container/440mlBeverageCan> ;
    onto:description "\\n    Kilkenny is a nitrogenated Irish cream ale from the makers of Guinness,\\n    which originated in Kilkenny, Ireland. The brand is managed and produced\\n    by Diageo. It is available in draught and cans. It is brewed in Ireland\\n    and its heritage dates back to the 14th century.\\n    "@en ;
    onto:fermentation_base <http://dbpedia.org/resource/Barley> ;
    onto:ibu "23"^^xsd:nonNegativeInteger ;
    onto:launch "1710"^^xsd:gYear ;
    onto:manufacturer <http://dbpedia.org/resource/Diageo> ;
    onto:name "Kilkenny Irish Cream Ale"@en ;
    onto:origin <http://dbpedia.org/resource/Kilkenny> ;
    onto:similar <http://rdfs.co/bevon/beverage/Smithwicks> ;
    onto:srm "14"^^xsd:nonNegativeInteger ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Kilkenny_(beer)> ;
    owl:sameAs <http://dbpedia.org/resource/Kilkenny_(beer)> .

<http://rdfs.co/bevon/beverage/Smithwicks> a ns1:ProductOrServiceModel,
        onto:IrishRedAle,
        owl:NamedIndividual ;
    onto:abv 3.8 ;
    onto:color [ a <http://dbpedia.org/ontology/Colour> ;
            dcterms:title "Ruby Red"@en ;
            owl:sameAs <http://dbpedia.org/resource/Ruby_(color)__Ruby_Red__1>,
                <http://purl.org/colors/rgb/9B111E> ] ;
    onto:container <http://rdfs.co/bevon/container/30lBeerKeg>,
        <http://rdfs.co/bevon/container/330mlLongneck>,
        <http://rdfs.co/bevon/container/440mlBeverageCan> ;
    onto:description "\\n    Smithwick's is an Irish red ale style beer from Kilkenny, Ireland. It is a\\n    clear beer with a rich ruby color and creamy head.\\n    "@en ;
    onto:fermentation_base <http://dbpedia.org/resource/Barley> ;
    onto:ibu "20"^^xsd:nonNegativeInteger ;
    onto:launch "1710"^^xsd:gYear ;
    onto:manufacturer <http://dbpedia.org/resource/Diageo> ;
    onto:name "Smithwick's Superior Irish Ale"@en ;
    onto:origin <http://dbpedia.org/resource/Kilkenny> ;
    onto:similar <http://rdfs.co/bevon/beverage/Kilkenny> ;
    onto:srm "14"^^xsd:nonNegativeInteger ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Smithwick%27s> ;
    owl:sameAs <http://dbpedia.org/resource/Smithwick%27s> .

onto:brewery a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beer ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Brewery ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Brewery> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property relates a beer to its brewery.\\n    "@en ;
    skos:prefLabel "Brewery"@en .

onto:color a owl:DatatypeProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dbpedia.org/ontology/Colour> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property specifies the color of the beverage.\\n    "@en ;
    skos:prefLabel "color"@en .

onto:container a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Container ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property can be used to indicate that the beverage is available in a\\n    type of container.\\n    "@en ;
    skos:prefLabel "container"@en .

<http://rdfs.co/bevon/container/15lBeerKeg> a onto:BeerKeg,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "LTR" ;
            ns1:hasValue "15"^^xsd:int ] ;
    skos:prefLabel "15l Beer Keg"@en .

<http://rdfs.co/bevon/container/330mlBeverageCan> a onto:BeverageCan,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "330"^^xsd:int ] ;
    skos:prefLabel "330ml Beverage Can"@en .

<http://rdfs.co/bevon/container/360mlPlasticBottle> a onto:PlasticBottle,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "360"^^xsd:int ] ;
    skos:prefLabel "360ml Plastic Bottle"@en .

<http://rdfs.co/bevon/container/500mlLongneck> a onto:Longneck,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "500"^^xsd:int ] ;
    skos:prefLabel "500ml Longneck Bottle"@en .

<http://rdfs.co/bevon/container/640mlLongneck> a onto:Longneck,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "640"^^xsd:int ] ;
    skos:prefLabel "640ml Longneck Bottle"@en .

<http://rdfs.co/bevon/container/700mlGlassBottle> a onto:GlassBottle,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "700"^^xsd:int ] ;
    skos:altLabel "70cl Glass Bottle"@en ;
    skos:prefLabel "700ml Glass Bottle"@en .

<http://rdfs.co/bevon/container/750mlGlassBottle> a onto:GlassBottle,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "750"^^xsd:int ] ;
    skos:altLabel "75cl Glass Bottle"@en ;
    skos:prefLabel "750ml Glass Bottle"@en .

onto:description a owl:DatatypeProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description,
        ns1:description ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    This property specifies the short text description of the beverage.\\n    "@en ;
    skos:prefLabel "description"@en .

onto:fermentation_base a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:AlcoholicBeverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:FermentationBase ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property indicates which fermentation base is used to make the\\n    alcoholic beverage.\\n    "@en ;
    skos:prefLabel "fermentation base"@en .

onto:ibu a owl:DatatypeProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beer ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/International_Bitterness_Units_scale> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "International Bitterness Unit scale"@en ;
    skos:definition "\\n    The International Bittering Units scale, or simply IBU scale, provides a\\n    measure of the bitterness of beer, which is provided by the hops used\\n    during brewing.\\n    "@en ;
    skos:prefLabel "IBU scale"@en .

onto:ingredient a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:MixedDrink ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://data.lirmm.fr/ontologies/food#Ingredient> ;
    rdfs:subPropertyOf <http://data.lirmm.fr/ontologies/food#containsIngredient> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property specifies an ingredient of the mixed drink.\\n    "@en ;
    skos:prefLabel "ingredient"@en .

onto:launch a owl:DatatypeProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:gYear ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property specifies the year when the beverage was first introduced to\\n    the market.\\n    "@en ;
    skos:prefLabel "launch"@en .

onto:manufacturer a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf ns1:hasManufacturer ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property specifies the manufacturer of the beverage.\\n    "@en ;
    skos:prefLabel "manufacturer"@en .

onto:name a owl:DatatypeProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title,
        ns1:name,
        foaf:name ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    This property indicates the name of the beverage.\\n    "@en ;
    skos:prefLabel "name"@en .

onto:non_alcoholic_version a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:AlcoholicBeverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:NonAlcoholicBeverage ;
    rdfs:subPropertyOf onto:related ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Some alcoholic beverages have non-alcoholic versions, such as non-alcoholic\\n    beer (\"near beer\") and cocktails (\"mocktails\").\\n    "@en ;
    skos:prefLabel "non-alcoholic version"@en .

onto:origin a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dbpedia.org/ontology/Place> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property indicates the place where the beverage was first invented.\\n    "@en ;
    skos:prefLabel "origin"@en .

onto:proof a owl:DatatypeProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    The term was originally used in the United Kingdom and was defined as 7/4\\n    times the alcohol by volume (ABV). The UK now uses the ABV standard instead\\n    of alcohol proof. In the United States, alcoholic proof is defined as twice\\n    the percentage of ABV.\\n    "@en ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Alcohol_proof> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "alcohol proof"@en ;
    skos:definition "\\n    Alcohol proof is a measure of how much alcohol (ethanol) is contained in an\\n    alcoholic beverage.\\n    "@en ;
    skos:prefLabel "proof"@en .

onto:similar a owl:SymmetricProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Beverage ;
    rdfs:subPropertyOf ns1:isSimilarTo,
        onto:related ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property states that a beverage is similar to another beverage.\\n    "@en ;
    skos:prefLabel "similar"@en .

onto:srm a owl:DatatypeProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beer ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Standard_Reference_Method> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Standard Reference Method"@en ;
    skos:definition "\\n    The Standard Reference Method or SRM is one of several systems modern\\n    brewers use to specify beer color.\\n    "@en ;
    skos:prefLabel "SRM"@en .

onto:volume a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Container ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:QuantitativeValue ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property specifies the volume of the container.\\n    "@en ;
    skos:prefLabel "volume"@en .

onto:BeerBottle a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Dark amber or brown glass greatly reduces UV light from spoiling the beer.\\n    However, lighter colored bottles are often used for marketing reasons.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Beer_bottle> ;
    rdfs:subClassOf onto:GlassBottle ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A beer bottle is a bottle made to contain beer, usually made of glass and\\n    come in various sizes, shapes and colors.\\n    "@en ;
    skos:prefLabel "Beer Bottle"@en .

onto:Brandy a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Brandy generally contains 35–60% alcohol by volume (70–120 US proof) and is\\n    typically taken as an after-dinner drink. Some brandies are aged in wooden\\n    casks, some are colored with caramel coloring to imitate the effect of\\n    aging, and some brandies are produced using a combination of both aging and\\n    coloring.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Brandy> ;
    rdfs:subClassOf onto:DistilledBeverage,
        <http://www.productontology.org/id/Brandy> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Brandy (from brandywine, derived from Dutch brandewijn—\"burnt wine\") is a\\n    spirit produced by distilling wine.\\n    "@en ;
    skos:prefLabel "Brandy"@en .

onto:Brewery a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    A company that makes beer is called either a brewery or a brewing company.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Brewery> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A brewery is a dedicated building for the making of beer, though beer can\\n    be made at home, and has been for much of beer's history.\\n    "@en ;
    skos:prefLabel "Brewery"@en .

onto:DryStout a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Stout ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Irish Stout"@en ;
    skos:definition "\\n    Irish stout or dry stout is very dark or rich in color and it often has a\\n    \"roasted\" or coffee-like taste.\\n    "@en ;
    skos:prefLabel "Dry Stout"@en .

onto:Dunkel a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Dunkel is the German word meaning dark, and dunkel beers typically range in\\n    color from amber to dark reddish brown. They are characterized by their\\n    smooth malty flavor.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Dunkel> ;
    rdfs:subClassOf onto:Lager,
        <http://www.productontology.org/id/Dunkel> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Dunkles"@en ;
    skos:definition "\\n    Dunkel, or Dunkles, is a word used for several types of dark German lager.\\n    "@en ;
    skos:prefLabel "Dunkel"@en .

onto:FermentationBase a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A fruit or grain which provides the sugar for fermentation from which a\\n    alcoholic beverage is made.\\n    "@en ;
    skos:prefLabel "Fermentation Base"@en .

onto:Highball a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Highball> ;
    rdfs:subClassOf onto:Cocktail,
        <http://www.productontology.org/id/Highball> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Highball is the name for a family of mixed drinks that are composed of an\\n    alcoholic base spirit and a larger proportion of a non-alcoholic mixer.\\n    "@en ;
    skos:prefLabel "Highball"@en .

onto:Keg a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Keg> ;
    rdfs:subClassOf onto:Container ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A keg is a small barrel.\\n    "@en ;
    skos:prefLabel "Keg"@en .

onto:MaltWhisky a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Malt_whisky> ;
    rdfs:subClassOf onto:Whisky,
        <http://www.productontology.org/id/Malt_whisky> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Malt Whiskey"@en ;
    skos:definition "\\n    Malt whisky is whisky that is made from a fermented mash produced primarily\\n    from a malted grain.\\n    "@en ;
    skos:prefLabel "Malt Whisky"@en .

onto:Mocktail a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:MixedDrink,
        onto:NonAlcoholicBeverage ;
    owl:disjointWith onto:Cocktail ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Mocktails are mock cocktails, or those that do not contain any alcohol.\\n    "@en ;
    skos:prefLabel "Mocktail"@en .

onto:NonAlcoholicBeer a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Low-alcohol_beer> ;
    rdfs:subClassOf onto:NonAlcoholicBeverage,
        <http://www.productontology.org/id/Low-alcohol_beer> ;
    owl:disjointWith onto:Beer ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Low-alcoholic Beer"@en ;
    skos:definition "\\n    Non-alcohol beer (also called light beer, low-alcoholic beer, small beer,\\n    small ale, or near-beer) is beer with low alcohol content or no alcohol,\\n    which aim to reproduce the taste of beer without the inebriating effects of\\n    standard alcoholic brews.\\n    "@en ;
    skos:prefLabel "Non-alcoholic Beer"@en .

onto:PaleAle a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    It is one of the world's major beer styles.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Pale_ale> ;
    rdfs:subClassOf onto:Ale,
        <http://www.productontology.org/id/Pale_ale> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Pale ale is a beer made by warm fermentation using predominantly pale malt.\\n    "@en ;
    skos:prefLabel "Pale Ale"@en .

onto:Pilsner a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    It took its name from the city of Pilsen (Plzeň, Bohemia, Czech Republic,\\n    where it was first produced in 1842).\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Pilsner> ;
    rdfs:subClassOf onto:PaleLager,
        <http://www.productontology.org/id/Pilsner> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Pils"@en,
        "Pilsener"@en ;
    skos:definition "\\n    Pilsner (also pilsener or simply pils) is a type of pale lager.\\n    "@en ;
    skos:prefLabel "Pilsner"@en .

onto:Porter a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    The name came about as a result of its popularity with street and river\\n    porters.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/English_porter> ;
    rdfs:subClassOf onto:Ale,
        <http://www.productontology.org/id/English_porter> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "English Porter"@en ;
    skos:definition "\\n    Porter is a dark style of beer originating in London in the 18th century,\\n    descended from brown beer, a well hopped beer made from brown malt.\\n    "@en ;
    skos:prefLabel "Porter"@en .

onto:ScotchWhisky a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    All Scotch whisky was originally made from malt barley. Commercial\\n    distilleries began introducing whisky made from wheat and rye in the late\\n    eighteenth century.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Scotch_whisky> ;
    rdfs:subClassOf onto:Whisky,
        <http://www.productontology.org/id/Scotch_whisky> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Scotch Whiskey"@en ;
    skos:definition "\\n    Scotch whisky (often referred to simply as \"Scotch\") is malt whisky or grain\\n    whisky made in Scotland.\\n    "@en ;
    skos:prefLabel "Scotch Whisky"@en .

onto:SingleMaltScotch a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    As with any Scotch whisky, a single malt Scotch must be distilled in\\n    Scotland and matured in oak casks in Scotland for at least three years\\n    (most single malts are matured longer).\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Single_malt_Scotch> ;
    rdfs:subClassOf onto:ScotchWhisky,
        onto:SingleMaltWhisky,
        <http://www.productontology.org/id/Single_malt_Scotch> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Single Malt Scotch is single malt whisky made in Scotland using a pot still\\n    distillation process at a single distillery, with malted barley as the only\\n    grain ingredient.\\n    "@en ;
    skos:prefLabel "Single Malt Scotch"@en .

onto:SingleMaltWhisky a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Single_malt_whisky> ;
    rdfs:subClassOf onto:MaltWhisky,
        <http://www.productontology.org/id/Single_malt_whisky> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Single Malt Whiskey"@en ;
    skos:definition "\\n    Single malt whisky is a whisky made at one particular distillery from a\\n    mash that uses only malted grain, ordinarily barley.\\n    "@en ;
    skos:prefLabel "Single Malt Whisky"@en .

onto:Soju a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Its taste is comparable to vodka, though often slightly sweeter due to\\n    sugars added in the manufacturing process.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Soju> ;
    rdfs:subClassOf onto:DistilledBeverage,
        <http://www.productontology.org/id/Soju> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Soju is a distilled beverage native to Korea.\\n    "@en ;
    skos:prefLabel "Soju"@en .

onto:SpeysideSingleMalt a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Speyside_single_malts> ;
    rdfs:subClassOf onto:SingleMaltScotch,
        <http://www.productontology.org/id/Speyside_single_malts> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Speyside single malts are single malt Scotch whiskies, distilled in\\n    Strathspey, the area around the River Spey in Moray and Badenoch and\\n    Strathspey, in northeastern Scotland.\\n    "@en ;
    skos:prefLabel "Speyside Single Malt"@en .

onto:Stout a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Stouts were traditionally the generic term for the strongest or stoutest\\n    porters, typically 7% or 8%, produced by a brewery.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Stout> ;
    rdfs:subClassOf onto:Porter,
        <http://www.productontology.org/id/Stout> ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Strong Porter"@en ;
    skos:definition "\\n    Stout is a dark beer made using roasted malt or roasted barley, hops, water\\n    and yeast.\\n    "@en ;
    skos:prefLabel "Stout"@en .

onto:Water a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Water> ;
    rdfs:subClassOf onto:NonAlcoholicBeverage,
        <http://www.productontology.org/id/Water> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    In the Beverage Ontology, Water means a drinking water.\\n    "@en ;
    skos:prefLabel "Water"@en .

onto:abv a owl:DatatypeProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Alcohol_by_volume> ;
    ns2:term_status "testing"@en ;
    skos:altLabel "alcohol by volume"@en ;
    skos:definition "\\n    ABV (Alcohol by Volume) is a standard measure of how much alcohol is\\n    contained in the drink.\\n    "@en ;
    skos:prefLabel "ABV"@en .

<http://rdfs.co/bevon/container/1_8lPlasticBottle> a onto:PlasticBottle,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueFloat ;
            ns1:hasUnitOfMeasurement "LTR" ;
            ns1:hasValue "1.8"^^xsd:float ] ;
    skos:prefLabel "1.8l Plastic Bottle"@en .

<http://rdfs.co/bevon/container/200mlPlasticBottle> a onto:PlasticBottle,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "200"^^xsd:int ] ;
    skos:prefLabel "200ml Plastic Bottle"@en .

<http://rdfs.co/bevon/container/355mlBeverageCan> a onto:BeverageCan,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "355"^^xsd:int ] ;
    skos:prefLabel "355ml Beverage Can"@en .

<http://rdfs.co/bevon/container/360mlGlassBottle> a onto:GlassBottle,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "360"^^xsd:int ] ;
    skos:prefLabel "360ml Glass Bottle"@en .

<http://rdfs.co/bevon/container/440mlBeverageCan> a onto:BeverageCan,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "440"^^xsd:int ] ;
    skos:prefLabel "440ml Beverage Can"@en .

<http://rdfs.co/bevon/container/500mlBeverageCan> a onto:BeverageCan,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "500"^^xsd:int ] ;
    skos:prefLabel "500ml Beverage Can"@en .

<http://rdfs.co/bevon/container/640mlPlasticBottle> a onto:PlasticBottle,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "640"^^xsd:int ] ;
    skos:prefLabel "640ml Plastic Bottle"@en .

onto:distillery a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:DistilledBeverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Distillery ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Distillation> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property relates a distilled beverage to its distillery.\\n    "@en ;
    skos:prefLabel "Distillery"@en .

onto:variant a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Beverage ;
    rdfs:subPropertyOf onto:related ;
    owl:inverseOf onto:variantOf ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property states that a beverage has a variant.\\n    "@en ;
    skos:prefLabel "variant"@en .

onto:variantOf a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Beverage ;
    rdfs:subPropertyOf <http://dbpedia.org/ontology/variantOf>,
        ns1:isVariantOf,
        onto:related ;
    owl:inverseOf onto:variant ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property states that a beverage is a variant of another beverage.\\n    "@en ;
    skos:prefLabel "variant of"@en .

onto:Ale a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    The yeast will ferment the beer quickly, giving it a sweet, full bodied and\\n    fruity taste.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Ale> ;
    rdfs:subClassOf onto:Beer,
        <http://www.productontology.org/id/Ale> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Ale is a type of beer brewed from malted barley using a warm-fermentation\\n    with a strain of brewers' yeast.\\n    "@en ;
    skos:prefLabel "Ale"@en .

onto:DilutedSoju a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Soju ;
    owl:disjointWith onto:DistilledSoju ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Diluted Soju is made by mixing pure ethanol distilled from various grains,\\n    such as potatoes, wheat, barley, sweet potatoes, or tapioca, with water and\\n    flavoring.\\n    "@en ;
    skos:prefLabel "Diluted Soju"@en .

onto:IrishRedAle a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Irish_red_ale> ;
    rdfs:subClassOf onto:PaleAle ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Irish red ale, red ale, or Irish ale is a name used by brewers in Ireland.\\n    "@en ;
    skos:prefLabel "Irish Red Ale"@en .

onto:Lager a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Lager> ;
    rdfs:subClassOf onto:Beer,
        <http://www.productontology.org/id/Lager> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Lager is a type of beer that is fermented and conditioned at low\\n    temperatures.\\n    "@en ;
    skos:prefLabel "Lager"@en .

onto:PaleLager a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Pale_lager> ;
    rdfs:subClassOf onto:Lager,
        <http://www.productontology.org/id/Pale_lager> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Pale lager is a very pale to golden-colored beer with a well attenuated\\n    body and a varying degree of noble hop bitterness.\\n    "@en ;
    skos:prefLabel "Pale Lager"@en .

<http://rdfs.co/bevon/container/30lBeerKeg> a onto:BeerKeg,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "LTR" ;
            ns1:hasValue "30"^^xsd:int ] ;
    skos:prefLabel "30l Beer Keg"@en .

onto:Distillery a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Distillation> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A distillery is a premise where distillation takes place, especially\\n    distillation of alcohol.\\n    "@en ;
    skos:prefLabel "Distillery"@en .

onto:FermentedBeverage a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:AlcoholicBeverage ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    A fermented beverage is a drink produced by fermenting grain, fruit, or\\n    vegetables.\\n    "@en ;
    skos:prefLabel "Fermented Beverage"@en .

onto:Longneck a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    It is known as the standard longneck bottle or industry standard bottle\\n    (ISB). The ISB longnecks have a uniform capacity, height, weight and\\n    diameter and can be reused on average 16 times. The long neck offers a long\\n    cushion of air to absorb the pressure of carbonation to reduce the risk of\\n    exploding. The longneck also provides a handle for drinking directly from\\n    the bottle without transferring body heat to the beer from one's hand.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:BeerBottle ;
    ns2:term_status "unstable"@en ;
    skos:altLabel "Industry Standard Bottle"@en,
        "North American Longneck"@en ;
    skos:definition "\\n    A longneck is a type of beer bottle with a long neck.\\n    "@en ;
    skos:prefLabel "Longneck"@en .

onto:MixedDrink a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Some mixed drinks are alcoholic beverages that contain liquor; others are\\n    non-alcoholic.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Mixed_drink> ;
    rdfs:subClassOf onto:Beverage,
        <http://www.productontology.org/id/Mixed_drink> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    A mixed drink is a beverage in which two or more ingredients are mixed.\\n    "@en ;
    skos:prefLabel "Mixed Drink"@en .

<http://rdfs.co/bevon/container/330mlLongneck> a onto:Longneck,
        owl:NamedIndividual ;
    onto:volume [ a ns1:QuantitativeValueInteger ;
            ns1:hasUnitOfMeasurement "MLT" ;
            ns1:hasValue "330"^^xsd:int ] ;
    skos:prefLabel "330ml Longneck Bottle"@en .

onto:BeerKeg a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Keg ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Beer kegs are made of stainless steel, or less commonly, of aluminium.\\n    "@en ;
    skos:prefLabel "Beer Keg"@en .

onto:BeverageCan a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Beverage cans are made of aluminium (75% of worldwide production) or\\n    tin-plated steel (25% worldwide production).\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Beverage_can> ;
    rdfs:subClassOf onto:Container ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A beverage can is a metal container designed to hold a fixed portion of\\n    liquid such as a carbonated soft drinks, alcoholic beverages, fruit juices,\\n    teas, tisanes, energy drinks, etc.\\n    "@en ;
    skos:prefLabel "Beverage Can"@en .

onto:Cocktail a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Cocktails were originally a mixture of spirits, sugar, water, and bitters.\\n    It is now often used for almost any mixed drink that contains alcohol,\\n    including mixers, mixed shots, etc. A cocktail today usually contains one\\n    or more kinds of spirit and one or more mixers, such as soda or fruit\\n    juice. Additional ingredients may be sugar, honey, milk, cream, and various\\n    herbs.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Cocktail> ;
    rdfs:subClassOf onto:AlcoholicBeverage,
        onto:MixedDrink,
        <http://www.productontology.org/id/Cocktail> ;
    owl:disjointWith onto:Mocktail ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A cocktail is a mixed drink that contains alcohol, including mixers, mixed\\n    shots, etc.\\n    "@en ;
    skos:prefLabel "Cocktail"@en .

onto:GlassBottle a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Glass bottles can vary in size considerably, but are most commonly found in\\n    sizes ranging between about 10ml and 5 litres.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Glass_bottle> ;
    rdfs:subClassOf onto:Container ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A glass bottle is a bottle created from glass.\\n    "@en ;
    skos:prefLabel "Glass Bottle"@en .

onto:PlasticBottle a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    Plastic bottles are typically used to store liquids such as water, soft\\n    drinks, motor oil, cooking oil, medicine, shampoo, milk, and ink.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Plastic_bottle> ;
    rdfs:subClassOf onto:Container ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A plastic bottle is a bottle constructed of plastic.\\n    "@en ;
    skos:prefLabel "Plastic Bottle"@en .

onto:Wine a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-07"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Wine> ;
    rdfs:subClassOf onto:FermentedBeverage,
        <http://www.productontology.org/id/Wine> ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Wine is an alcoholic beverage made from fermented grapes or other fruits.\\n    "@en ;
    skos:historyNote [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2014-03-07"^^xsd:date ;
            rdf:value "\\n      Changed the semantics of bevon:Wine not to be the same as wine:Wine\\n      "@en ] ;
    skos:prefLabel "Wine"@en,
        "Vin"@fr .

onto:related a owl:ObjectProperty ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:domain onto:Beverage ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Beverage ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    This property states that a beverage is related to another beverage.\\n    "@en ;
    skos:prefLabel "related"@en .

onto:Aging a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    Aging is the process of storing beverages in casks for a specific period of\\n    time to remove harsh flavors and add distinct characteristics found in the\\n    cask's wood.\\n    "@en ;
    skos:prefLabel "Aging"@en .

onto:NonAlcoholicBeverage a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Non-alcoholic_beverage> ;
    rdfs:subClassOf onto:Beverage,
        <http://www.productontology.org/id/Non-alcoholic_beverage> ;
    owl:disjointWith onto:AlcoholicBeverage ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n     A non-alcoholic beverage (also known as a virgin drink) is defined\\n     in the U.S. as a beverage that contains less than 0.5% alcohol by volume.\\n     "@en ;
    skos:prefLabel "Non-alcoholic Beverage"@en .

onto:Beer a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n    The starch and saccharification enzymes are often derived from malted\\n    cereal grains, most commonly malted barley and malted wheat.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Beer> ;
    rdfs:subClassOf onto:FermentedBeverage,
        <http://www.productontology.org/id/Beer> ;
    owl:disjointWith onto:NonAlcoholicBeer ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n    Beer is an alcoholic beverage produced by the saccharification of starch\\n    and fermentation of the resulting sugar.\\n    "@en ;
    skos:prefLabel "Beer"@en .

onto:AlcoholicBeverage a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Alcoholic_beverage> ;
    rdfs:subClassOf onto:Beverage,
        <http://www.productontology.org/id/Alcoholic_beverage> ;
    owl:disjointWith onto:NonAlcoholicBeverage ;
    ns2:term_status "testing"@en ;
    skos:definition "\\n     An alcoholic beverage is a drink and psychoactive drug containing\\n     ethyl alcohol which is commonly referred to as ethanol.\\n     "@en ;
    skos:prefLabel "Alcoholic Beverage"@en .

onto:Container a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Container> ;
    rdfs:subClassOf <http://dbpedia.org/class/yago/Containers> ;
    ns2:term_status "unstable"@en ;
    skos:definition "\\n    A container is an item used to contain, store, and transport a beverage.\\n    "@en ;
    skos:prefLabel "Container"@en .

onto:Whisky a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2015-07-23"^^xsd:date ;
    rdfs:comment "\\n    Different grains are used for different varieties, including barley, malted\\n    barley, rye, malted rye, wheat, and corn. Whisky is typically aged in\\n    wooden casks, made generally of charred white oak.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Whisky> ;
    rdfs:subClassOf onto:DistilledBeverage,
        <http://www.productontology.org/id/Whisky> ;
    owl:sameAs ns3:Whisky ;
    ns2:term_status "testing"@en ;
    skos:altLabel "Whiskey"@en ;
    skos:definition "\\n    Whisky or whiskey is a type of distilled alcoholic beverage made from\\n    fermented grain mash.\\n    "@en ;
    skos:prefLabel "Whisky"@en,
        "위스키"@en .

onto:DistilledBeverage a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:comment "\\n     This excludes undistilled fermented beverages such as beer, wine, and\\n     cider.\\n     "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Distilled_beverage> ;
    rdfs:subClassOf onto:AlcoholicBeverage,
        <http://www.productontology.org/id/Distilled_beverage> ;
    ns2:term_status "testing"@en ;
    skos:altLabel "Liquor"@en,
        "Spirit"@en ;
    skos:definition "\\n     A distilled beverage, spirit, or liquor is an alcoholic beverage\\n     containing ethanol that is produced by distilling (i.e., concentrating\\n     by distillation) ethanol produced by means of fermenting grain, fruit,\\n     or vegetables.\\n     "@en ;
    skos:prefLabel "Distilled Beverage"@en .

<http://jayg.me/> a foaf:Person ;
    foaf:homepage <http://jayg.org/> ;
    foaf:mbox_sha1sum "f03421e94730da58e8943d3a1d2c4c6b02898e14" ;
    foaf:name "James G. Kim"@en .

onto:Beverage a owl:Class ;
    dcterms:issued "2013-07-04"^^xsd:date ;
    dcterms:modified "2014-03-01"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Beverage> ;
    rdfs:subClassOf <http://data.lirmm.fr/ontologies/food#Food>,
        <http://www.productontology.org/id/Drink>,
        <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#PotableLiquid> ;
    ns2:term_status "testing"@en ;
    skos:altLabel "Drink"@en ;
    skos:definition "\\n    A beverage, or drink, is a kind of liquid which is specifically prepared\\n    for human consumption.\\n    "@en ;
    skos:prefLabel "Beverage"@en .

