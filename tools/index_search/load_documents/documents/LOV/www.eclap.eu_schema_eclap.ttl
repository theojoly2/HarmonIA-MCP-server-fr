onto:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:comment "A collection of other content"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:MediaObject .

onto:Crossmedia a owl:Class ;
    rdfs:label "Crossmedia"@en ;
    rdfs:comment "A cross media content"@en ;
    rdfs:isDefinedBy onto: ;
