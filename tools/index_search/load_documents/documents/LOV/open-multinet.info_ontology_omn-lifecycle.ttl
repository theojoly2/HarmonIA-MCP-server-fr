@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://open-multinet.info/ontology/omn-lifecycle> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "omn-lifecycle"@en ;
    ns1:license <http://creativecommons.org/licenses/by/4.0/> ;
    dc:contributor <http://www.commit-nl.nl/people/morsey>,
        <https://staff.fnwi.uva.nl/p.grosso>,
        <mailto:brecht.vermeulen@iminds.be>,
        <mailto:chrisap@noc.ntua.gr>,
        <mailto:ibaldin@renci.org>,
        <mailto:jorge.lopez_vergara@uam.es>,
        <mailto:loughnane@campus.tu-berlin.de>,
        <mailto:thijs.walcarius@intec.ugent.be>,
        <mailto:yahya.al-hazmi@tu-berlin.de>,
        <mailto:yxin@renci.org> ;
    dc:creator <http://alex.willner.ws/about#me> ;
    dc:description <https://raw.githubusercontent.com/open-multinet/playground-rspecs-ontology/master/ontologies/pics/omn-lifecycle.png>,
        "This ontology defines generic concepts related to the life cycle of resource or service."@en ;
    dc:publisher <http://open-multinet.org/> ;
    dc:rights "This ontology is distributed under a Creative Commons Attribute License - http://creativecommons.org/licenses/by/4.0/"@en ;
    dc:title "Open-Multinet Upper Lifecycle Ontology"@en ;
    dcterms:created "2014-11-11"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2015-04-08"^^xsd:date ;
    vann:preferredNamespacePrefix "omn-lifecycle"^^xsd:string ;
    vann:preferredNamespaceUri <http://open-multinet.info/ontology/omn-lifecycle#> ;
    owl:versionInfo "2015-04-08"^^xsd:string .

<http://open-multinet.info/ontology/omn-lifecycle#Active> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Active"@en ;
    rdfs:comment "The related resource/service is actively performing an action"@en ;
    rdfs:seeAlso "GENI geni_ready_busy operational state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Allocated> a <http://open-multinet.info/ontology/omn-lifecycle#ReservationState>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Allocated"@en ;
    rdfs:comment "The related resources/services are reserved"@en ;
    rdfs:seeAlso "GENI geni_allocated allocation state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#ReservationState> .

<http://open-multinet.info/ontology/omn-lifecycle#Cleaned> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Cleaned"@en ;
    rdfs:comment "The related resource/service has been cleaned"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Confirmation> a owl:Class ;
    rdfs:comment "A collection (group) of resources/services/groups confirmed to be allocated for the user."@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn#Topology> .

<http://open-multinet.info/ontology/omn-lifecycle#Error> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Error"@en ;
    rdfs:comment "The related resource/service is in an error state"@en ;
    rdfs:seeAlso "GENI geni_failed operational state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Initialized> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Initialized"@en ;
    rdfs:comment "The related resource/service has been initialized"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Installed> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Installed"@en ;
    rdfs:comment "The related resource/service has been installed"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Manifest> a owl:Class ;
    rdfs:comment "A collection (group) of resources/services/groups allocated for the user."@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn#Topology> .

<http://open-multinet.info/ontology/omn-lifecycle#NotYetInitialized> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "NotYetInitialized"@en ;
    rdfs:comment "The related resource/service are not yet active/ready"@en ;
    rdfs:seeAlso "GENI geni_instantiating operational state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Offering> a owl:Class ;
    rdfs:comment "A collection (group) of services and resources provided by an Infrastructure. The collection is the result of the application of Policies."@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn#Topology> .

<http://open-multinet.info/ontology/omn-lifecycle#Pending> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pending"@en ;
    rdfs:comment "The related resource/service is not yet provisioned"@en ;
    rdfs:seeAlso "GENI geni_pending_allocation operational state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Preinit> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Preinit"@en ;
    rdfs:comment "The related resource/service is currently configuring"@en ;
    rdfs:seeAlso "GENI geni_configuring operational state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Provisioned> a <http://open-multinet.info/ontology/omn-lifecycle#ReservationState>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Provisioned"@en ;
    rdfs:comment "The related resources/services are provisioned"@en ;
    rdfs:seeAlso "GENI geni_provisioned allocation state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#ReservationState> .

<http://open-multinet.info/ontology/omn-lifecycle#Ready> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Ready"@en ;
    rdfs:comment "The related resource/service is ready"@en ;
    rdfs:seeAlso "GENI geni_ready operational state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Removing> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Removing"@en ;
    rdfs:comment "The related resource/service gets removed"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Request> a owl:Class ;
    rdfs:comment "A collection (group) of resources/services/groups requested by the user"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn#Topology> .

<http://open-multinet.info/ontology/omn-lifecycle#Started> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Started"@en ;
    rdfs:comment "The related resource/service has been started"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Stopped> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Stopped"@en ;
    rdfs:comment "The related resource/service is stopped"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Stopping> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Stopping"@en ;
    rdfs:comment "The related resource/service is stopping"@en ;
    rdfs:seeAlso "GENI geni_stopping operational state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Unallocated> a <http://open-multinet.info/ontology/omn-lifecycle#ReservationState>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Unallocated"@en ;
    rdfs:comment "The related resources/services are not reserved"@en ;
    rdfs:seeAlso "GENI geni_unallocated allocation state"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#ReservationState> .

<http://open-multinet.info/ontology/omn-lifecycle#Uncompleted> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Uncompleted"@en ;
    rdfs:comment "The related resource/service is not complete"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#Updating> a <http://open-multinet.info/ontology/omn-lifecycle#State>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Updating"@en ;
    rdfs:comment "The related resource/service is getting updated"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn-lifecycle#State> .

<http://open-multinet.info/ontology/omn-lifecycle#hasAuthenticationInformation> a owl:DatatypeProperty ;
    rdfs:comment "A specific authentification information for the management system"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Resource>,
        <http://open-multinet.info/ontology/omn#Service> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "GENI Slice X.509 certificates"@en .

<http://open-multinet.info/ontology/omn-lifecycle#hasID> a owl:DatatypeProperty ;
    rdfs:comment "A unique identifier set by the management system"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Resource>,
        <http://open-multinet.info/ontology/omn#Service> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "GENI Manifest RSpec v3: component_id"@en .

<http://open-multinet.info/ontology/omn-lifecycle#hasReservationState> a owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Reservation> ;
    rdfs:range <http://open-multinet.info/ontology/omn-lifecycle#ReservationState> ;
    rdfs:subPropertyOf <http://open-multinet.info/ontology/omn-lifecycle#hasState> .

<http://open-multinet.info/ontology/omn-lifecycle#implements> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    owl:inverseOf <http://open-multinet.info/ontology/omn-lifecycle#implementedBy> .

<http://open-multinet.info/ontology/omn-lifecycle#isReservationStateOf> a owl:ObjectProperty ;
    rdfs:domain <http://open-multinet.info/ontology/omn-lifecycle#ReservationState> ;
    rdfs:range <http://open-multinet.info/ontology/omn#Reservation> ;
    rdfs:subPropertyOf <http://open-multinet.info/ontology/omn-lifecycle#isStateOf> .

<http://open-multinet.info/ontology/omn-lifecycle#parentTo> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    owl:inverseOf <http://open-multinet.info/ontology/omn-lifecycle#parentOf> .

<http://open-multinet.info/ontology/omn-lifecycle#usesService> a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range <http://open-multinet.info/ontology/omn#Service> .

owl:AllDisjointClasses a owl:Class .

<http://alex.willner.ws/about#me> a foaf:Person .

<http://open-multinet.info/ontology/omn-lifecycle#implementedBy> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] .

<http://open-multinet.info/ontology/omn-lifecycle#isStateOf> a owl:ObjectProperty ;
    rdfs:domain <http://open-multinet.info/ontology/omn-lifecycle#State> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    owl:inverseOf <http://open-multinet.info/ontology/omn-lifecycle#hasState> .

<http://open-multinet.info/ontology/omn-lifecycle#parentOf> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] .

<http://open-multinet.info/ontology/omn#Attribute> a owl:Class .

<http://open-multinet.info/ontology/omn#Reservation> a owl:Class .

<http://open-multinet.info/ontology/omn-lifecycle#hasState> a owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range <http://open-multinet.info/ontology/omn-lifecycle#State> .

owl:IrreflexiveProperty a owl:Class .

<http://open-multinet.info/ontology/omn#Topology> a owl:Class .

<http://open-multinet.info/ontology/omn-lifecycle#ReservationState> a owl:Class ;
    rdfs:label "Reservation State"@en ;
    rdfs:comment "The current state of a reservation"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn#Attribute> .

<http://open-multinet.info/ontology/omn#Component> a owl:Class .

<http://open-multinet.info/ontology/omn#Group> a owl:Class .

<http://open-multinet.info/ontology/omn#Resource> a owl:Class .

<http://open-multinet.info/ontology/omn#Service> a owl:Class .

owl:NamedIndividual a owl:Class .

<http://open-multinet.info/ontology/omn-lifecycle#State> a owl:Class ;
    rdfs:label "State"@en ;
    rdfs:comment "The current state of the resource, service or group"@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn#Attribute> .

