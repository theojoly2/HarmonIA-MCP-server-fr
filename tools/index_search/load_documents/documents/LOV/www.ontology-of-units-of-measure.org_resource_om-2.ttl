                        owl:onProperty onto:hasNumerator ] [ a owl:Restriction ;
                        owl:hasValue onto:second-Time ;
                        owl:onProperty onto:hasDenominator ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasDenominator ] ) ] .

onto:PrefixedMetrePerSecond-TimeSquared a owl:Class ;
    rdfs:label "prefixed metre per second (time) squared"@en ;
    rdfs:subClassOf onto:UnitDivision ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom onto:PrefixedMetre ;
                        owl:onProperty onto:hasNumerator ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasNumerator ] [ a owl:Restriction ;
                        owl:hasValue onto:second-TimeSquared ;
                        owl:onProperty onto:hasDenominator ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasDenominator ] ) ] .

onto:PrefixedMolePerLitre a owl:Class ;
    rdfs:label "prefixed mole per litre"@en ;
    rdfs:subClassOf onto:UnitDivision ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom onto:PrefixedMole ;
                        owl:onProperty onto:hasNumerator ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasNumerator ] [ a owl:Restriction ;
                        owl:hasValue onto:litre ;
                        owl:onProperty onto:hasDenominator ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasDenominator ] ) ] .

