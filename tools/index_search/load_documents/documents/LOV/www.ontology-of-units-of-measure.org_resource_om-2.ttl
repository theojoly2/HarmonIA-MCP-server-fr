onto:Length a owl:Class ;
    rdfs:label "length"@en ;
    onto:alternativeSymbol "L" ;
    onto:commonlyHasUnit onto:angstrom,
        onto:astronomicalUnit,
        onto:attometre,
        onto:centimetre,
        onto:chain,
        onto:cicero,
        onto:decametre,
        onto:decimetre,
        onto:exametre,
        onto:fathom-USSurvey,
        onto:femtometre,
        onto:fermi,
        onto:foot-International,
        onto:foot-USSurvey,
        onto:furlong-International,
        onto:gigametre,
        onto:gigaparsec,
        onto:hectometre,
        onto:inch-International,
        onto:kilometre,
        onto:kiloparsec,
        onto:lightYear,
        onto:megametre,
        onto:megaparsec,
        onto:metre,
        onto:micrometre,
        onto:micron,
        onto:mil-Length,
        onto:mile-Statute,
        onto:mile-USSurvey,
        onto:millimetre,
        onto:nanometre,
        onto:nauticalMile-International,
        onto:parsec,
        onto:petametre,
        onto:pica-ATA,
        onto:pica-Postscript,
        onto:pica-TeX,
        onto:picometre,
        onto:point-ATA,
        onto:point-Didot,
        onto:point-Postscript,
        onto:point-TeX,
        onto:rod-US,
        onto:solarRadius,
        onto:terametre,
        onto:yard-International ;
    onto:symbol "l" ;
    rdfs:comment "Length is the amount of space between two geographical points along a curve. It is a base quantity in the International System of Units and other systems of units. Length is speed times time. The metre, a base unit of length in the International System of Units, is defined in terms of speed of light during a certain time interval."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:length-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:LengthUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

