    rdfs:label "ratio unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one onto:percent onto:partsPerMillion ) ] .

onto:RayleighNumber a owl:Class ;
    rdfs:label "Rayleigh number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Ra" ;
    rdfs:comment "The Rayleigh number for a fluid is a dimensionless number associated with buoyancy driven flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:RayleighNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:RayleighNumberUnit a owl:Class ;
    rdfs:label "Rayleigh number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:ReaumurTemperature a owl:Class ;
    rdfs:label "Réaumur temperature"@en ;
    onto:commonlyHasUnit onto:degreeReaumur ;
    onto:symbol "T" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom [ a owl:Class ;
                            owl:unionOf ( onto:ReaumurTemperatureUnit onto:ReaumurTemperatureScale ) ] ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:ReaumurScale ;
            owl:onProperty onto:hasScale ],
        onto:Temperature .

onto:ReaumurTemperatureScale a owl:Class ;
    rdfs:label "Réaumur temperature scale"@en ;
    rdfs:subClassOf onto:Scale ;
    owl:equivalentClass onto:ReaumurScale .

onto:ReaumurTemperatureUnit a owl:Class ;
    rdfs:label "Réaumur temperature unit"@en ;
    rdfs:subClassOf onto:TemperatureUnit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:degreeReaumur ) ] ) ] .

onto:RedMagnitude a owl:Class ;
    rdfs:label "red magnitude"@en ;
    onto:alternativeSymbol "m_r" ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "r" ;
    rdfs:comment "A red magnitude not specified for a specific photometric system."@en ;
    rdfs:subClassOf onto:Magnitude .

onto:ReddeningB-V a owl:Class ;
    rdfs:label "reddening (B-V)"@en ;
    onto:LaTeXSymbol "E_{\\\\mathit{B-V}}" ;
    onto:alternativeLabel "colour excess (B-V)"@en,
        "wavelength-selective extinction (B-V)"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "E_B-V" ;
    rdfs:comment "Reddening causes the star to appear redder if more dust or gas is between the star and the observer. The standard reddening is measured using the B and V passbands."@en ;
    rdfs:subClassOf onto:Reddening .

onto:ReddeningU-B a owl:Class ;
    rdfs:label "reddening (U-B)"@en ;
    onto:LaTeXSymbol "E_{\\\\mathit{U-B}}" ;
    onto:alternativeLabel "colour excess (U-B)"@en,
        "wavelength-selective extinction (U-B)"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "E_U-B" ;
    rdfs:comment "Reddening measured with the U and B passbands."@en ;
    rdfs:subClassOf onto:Reddening .

onto:RelativeHumidityUnit a owl:Class ;
    rdfs:label "relative humidity unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one onto:percent ) ] .

onto:Reluctance a owl:Class ;
    rdfs:label "reluctance"@en ;
    onto:commonlyHasUnit onto:reciprocalHenry ;
    onto:symbol "τ" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ReluctanceUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:reluctance-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:ReluctanceUnit a owl:Class ;
    rdfs:label "reluctance unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:reciprocalHenry ) ] .

onto:ResonanceEnergy a owl:Class ;
    rdfs:label "resonance energy"@en ;
    onto:commonlyHasUnit onto:joulePerMole ;
    rdfs:subClassOf onto:MolarEnergy .

onto:Responsivity a owl:Class ;
    rdfs:label "responsivity"@en ;
    onto:commonlyHasUnit onto:amperePerWatt,
        onto:voltPerWatt ;
    onto:symbol "R" ;
    rdfs:comment "Detector output for unit intensity input. Units are usually volts per watt or amps per watt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ResponsivityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity ;
    ns2:reference ns2:Astrophysical_Techniques_chapter1 .

onto:ResponsivityUnit a owl:Class ;
    rdfs:label "responsivity unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:voltPerWatt onto:amperePerWatt ) ] ;
    ns2:reference ns2:Astrophysical_Techniques_chapter1 .

onto:ReynoldsNumber a owl:Class ;
    rdfs:label "Reynolds number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Re" ;
    rdfs:comment "The Reynolds number is a dimensionless number that gives a measure of the ratio of inertial forces to viscous forces and, consequently, quantifies the relative importance of these two types of forces for given flow conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ReynoldsNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:ReynoldsNumberUnit a owl:Class ;
    rdfs:label "Reynolds number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:RightAscension a owl:Class ;
    rdfs:label "right ascension"@en ;
    onto:alternativeSymbol "ra" ;
    onto:commonlyHasUnit onto:degree,
        onto:hour-HourAngle,
        onto:minute-HourAngle,
        onto:second-HourAngle ;
    onto:symbol "α" ;
    rdfs:comment "The angular distance on the celestial sphere measured eastward along the celestial equator from the equinox to the great circle passing through the celestial object and the celestial north pole."@en ;
    rdfs:subClassOf onto:Angle ;
    ns2:reference ns2:Glossary_Astronomical_Almanac .

onto:SaltStrength a owl:Class ;
    rdfs:label "salt strength"@en ;
    rdfs:subClassOf onto:Quantity .

onto:ScaleFactor a owl:Class ;
    rdfs:label "scale factor"@en ;
    rdfs:subClassOf onto:Quantity .

onto:ScaleHeight a owl:Class ;
    rdfs:label "scale height"@en ;
    onto:commonlyHasUnit onto:kiloparsec,
        onto:parsec ;
    onto:symbol "h_z" ;
    rdfs:comment "The scale height of a feature (such as the thin galactic disk) is the height (or position) at which the number density of the feature (for instance of the number of Population II stars) is equal to 1/e times the number density at the origin (for instance the Galactic Plane)."@en ;
    rdfs:subClassOf onto:Length .

onto:ScaleLength a owl:Class ;
    rdfs:label "scale length"@en ;
    onto:alternativeLabel "scale radius"@en ;
    onto:commonlyHasUnit onto:kiloparsec ;
    onto:symbol "r" ;
    rdfs:comment "The radial distance from a galaxy's core at which the average intensity has fallen to 1/e of the intensity at the centre of the galaxy."@en ;
    rdfs:subClassOf onto:Length .

onto:SchmidtNumber a owl:Class ;
    rdfs:label "Schmidt number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Sc" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:SchmidtNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:SchmidtNumberUnit a owl:Class ;
    rdfs:label "Schmidt number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:SecularAberration a owl:Class ;
    rdfs:label "secular aberration"@en ;
    onto:commonlyHasUnit onto:degree,
        onto:microsecond-Angle,
        onto:millisecond-Angle,
        onto:second-Anglee ;
    rdfs:comment "The component of the stellar abberation resulting from the motion of the solar system in space. This component is usually ignored. The abberation is the apparent angular displacement of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en ;
    rdfs:subClassOf onto:AngularDisplacement ;
    ns2:reference ns2:Glossary_Astronomical_Almanac .

