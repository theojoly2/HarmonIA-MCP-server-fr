onto:SpecificEntropy a owl:Class ;
    rdfs:label "specific entropy"@en ;
    onto:commonlyHasUnit onto:joulePerKelvinKilogram ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:SpecificEntropyUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:specificEntropyOrSpecificHeatCapacity-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:SpecificEntropyUnit a owl:Class ;
    rdfs:label "specific entropy unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:joulePerKelvinKilogram ) ] .

onto:SpecificHeatCapacityUnit a owl:Class ;
    rdfs:label "specific heat capacity unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:joulePerKelvinKilogram ) ] .

onto:SpecificProteaseActivity a owl:Class ;
    rdfs:label "specific protease activity"@en ;
    rdfs:subClassOf onto:SpecificCatalyticActivity .

onto:SpecificViableCountUnit a owl:Class ;
    rdfs:label "specific viable count unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:colonyFormingUnitPerGram ) ] .

onto:SpecificVolumeUnit a owl:Class ;
    rdfs:label "specific volume unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:cubicMetrePerKilogram ) ] .

onto:SpectralResponse a owl:Class ;
    rdfs:label "spectral response"@en ;
    rdfs:comment "The change in output signal as a function of changes in the wavelength of the input signal."@en ;
    rdfs:subClassOf onto:Quantity ;
    ns2:reference ns2:Astrophysical_Techniques_chapter1 .

onto:SpeedUnit a owl:Class ;
    rdfs:label "speed unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:knot-International onto:millimetrePerHour onto:kilometrePerHour onto:centimetrePerDay onto:metrePerDay onto:millimetrePerDay onto:metrePerSecond-Time onto:mile-StatutePerHour onto:nauticalMile-InternationalPerHour ) ] onto:PrefixedMetrePerSecond-Time onto:MetrePerPrefixedSecond-Time onto:PrefixedMetrePerPrefixedSecond-Time ) ] .

onto:StantonNumber a owl:Class ;
    rdfs:label "Stanton number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "St" ;
    rdfs:comment "The Stanton number is a dimensionless number that measures the ratio of heat transferred into a fluid to the thermal capacity of fluid."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:StantonNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:StantonNumberForMassTransfer a owl:Class ;
    rdfs:label "Stanton number for mass transfer"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "St*" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:StantonNumberForMassTransferUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:StantonNumberForMassTransferUnit a owl:Class ;
    rdfs:label "Stanton number for mass transfer unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:StantonNumberUnit a owl:Class ;
    rdfs:label "Stanton number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:StellarAberration a owl:Class ;
    rdfs:label "stellar aberration"@en ;
    onto:commonlyHasUnit onto:degree,
        onto:microsecond-Angle,
        onto:millisecond-Angle,
        onto:second-Angle ;
