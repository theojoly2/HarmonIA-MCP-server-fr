onto:LuminousFluxUnit a owl:Class ;
    rdfs:label "luminous flux unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:lumen onto:candelaSteradian ) ] onto:PrefixedLumen ) ] .

onto:LuminousIntensityUnit a owl:Class ;
    rdfs:label "luminous intensity unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:candela ) ] onto:PrefixedCandela ) ] .

onto:MachNumber a owl:Class ;
    rdfs:label "Mach number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Ma" ;
    rdfs:comment "The Mach number is the speed of an object that moves through air, or any fluid substance, divided by the speed of sound as it is in that substance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MachNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:MachNumberUnit a owl:Class ;
    rdfs:label "Mach number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:MagneticFieldUnit a owl:Class ;
    rdfs:label "magnetic field unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:oersted onto:amperePerMetre ) ] .

onto:MagneticFluxDensityUnit a owl:Class ;
    rdfs:label "magnetic flux density unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
