                    owl:allValuesFrom onto:DensityParameterUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:DoseEquivalent a owl:Class ;
    rdfs:label "dose equivalent"@en ;
    onto:commonlyHasUnit onto:attosievert,
        onto:centisievert,
        onto:decasievert,
        onto:decisievert,
        onto:exasievert,
        onto:femtosievert,
        onto:gigasievert,
