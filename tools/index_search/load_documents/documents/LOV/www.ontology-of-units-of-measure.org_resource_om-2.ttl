onto:ShearRateUnit a owl:Class ;
    rdfs:label "shear rate unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:reciprocalSecond-Time ) ] .

onto:ShearStorageModulus a owl:Class ;
    rdfs:label "shear storage modulus"@en ;
    onto:commonlyHasUnit onto:atmosphere-Standard,
