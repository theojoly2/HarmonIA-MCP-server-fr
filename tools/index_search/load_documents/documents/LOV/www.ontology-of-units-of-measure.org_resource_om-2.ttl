        onto:megapascal,
        onto:metreOfMercury,
        onto:microbar,
        onto:micropascal,
        onto:millibar,
        onto:millimetreOfMercury,
        onto:millipascal,
        onto:nanopascal,
        onto:newtonPerSquareMetre,
        onto:pascal,
        onto:petapascal,
        onto:picopascal,
        onto:terapascal,
        onto:torr ;
    onto:symbol "G'" ;
    rdfs:subClassOf onto:StorageModulus .

onto:ShearStrain a owl:Class ;
    rdfs:label "shear strain"@en ;
    onto:commonlyHasUnit onto:one,
        onto:percent ;
    rdfs:comment "Shear strain is a strain that acts parallel to the surface of a material that it acts on."@en ;
    rdfs:subClassOf onto:Strain .

onto:ShearStress a owl:Class ;
    rdfs:label "shear stress"@en ;
    onto:commonlyHasUnit onto:atmosphere-Standard,
        onto:atmosphere-Technical,
        onto:attopascal,
        onto:bar,
        onto:barye,
        onto:centimetreOfMercury,
        onto:centipascal,
        onto:decapascal,
        onto:decibar,
        onto:decipascal,
        onto:exapascal,
        onto:femtopascal,
        onto:gigapascal,
        onto:hectopascal,
        onto:kilogramSecond-TimeToThePower-2ReciprocalMetre,
        onto:kilopascal,
        onto:megapascal,
        onto:metreOfMercury,
        onto:microbar,
        onto:micropascal,
        onto:millibar,
        onto:millimetreOfMercury,
        onto:millipascal,
        onto:nanopascal,
