@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/ontology/bibo/> .
@prefix ns2: <http://www.wurvoc.org/bibliography/om-2/> .
@prefix ns3: <http://www.wurvoc.org/vocabularies/WV/> .
@prefix onto: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:identifier a owl:AnnotationProperty .

onto: a owl:Ontology ;
    rdfs:label "Ontology of units of Measure (OM)"@en ;
    dc:creator "Hajo Rijgersberg, Don Willems, Jan Top"@en ;
    dc:date "2020/06/06" ;
    dc:identifier "http://www.ontology-of-units-of-measure.org/vocabularies/om-2/" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "The Ontology of units of Measure (OM) 2.0 models concepts and relations important to scientific research. It has a strong focus on units, quantities, measurements, and dimensions."@en ;
    owl:versionInfo "2.0.22"@en ;
    ns2:reference <http://www.openisbn.com/isbn/9789462280618/> ;
    ns3:illustration "http://www.wurvoc.org/images/vocabularies/om-illustration.jpg" ;
    ns3:logo "http://www.wurvoc.org/images/vocabularies/om-logo.jpg" .

onto:AceticAcidMassFraction a owl:Class ;
    rdfs:label "acetic acid mass fraction"@en ;
    onto:commonlyHasUnit onto:gramPerGram,
        onto:one,
        onto:percent ;
    rdfs:comment "The fraction of the mass of acetic acid in a phenomenon"@en ;
    rdfs:subClassOf onto:MassFraction .

onto:AcousticFirmness a owl:Class ;
    rdfs:label "acoustic firmness"@en ;
    onto:alternativeLabel "firmness_ac"@en ;
    onto:commonlyHasUnit onto:AFS ;
    rdfs:subClassOf onto:Quantity .

onto:AngularVelocity a owl:Class ;
    rdfs:label "angular velocity"@en ;
    onto:commonlyHasUnit onto:radianPerSecond-Time ;
    onto:symbol "ω" ;
    rdfs:subClassOf onto:AngularSpeed .

onto:AreaDensity a owl:Class ;
    rdfs:label "area density"@en ;
    onto:commonlyHasUnit onto:gramPerSquareMetre,
        onto:kilogramPerHectare,
        onto:kilogramPerSquareMetre ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AreaDensityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:AreaDensityRate a owl:Class ;
    rdfs:label "area density rate"@en ;
    onto:commonlyHasUnit onto:kilogramPerHectareDay ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AreaDensityRateUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:AtomicMass a owl:Class ;
    rdfs:label "atomic mass"@en ;
    onto:commonlyHasUnit onto:nanounifiedAtomicMassUnit,
        onto:unifiedAtomicMassUnit ;
    onto:symbol "m_a" ;
    rdfs:subClassOf onto:Mass .

onto:AverageSpeed a owl:Class ;
    rdfs:label "average speed"@en ;
    onto:commonlyHasUnit onto:attometrePerSecond-Time,
        onto:centimetrePerDay,
        onto:centimetrePerSecond-Time,
        onto:decametrePerSecond-Time,
        onto:decimetrePerSecond-Time,
        onto:exametrePerSecond-Time,
        onto:femtometrePerSecond-Time,
        onto:gigametrePerSecond-Time,
        onto:hectometrePerSecond-Time,
        onto:kilometrePerHour,
        onto:kilometrePerSecond-Time,
        onto:knot-International,
        onto:megametrePerSecond-Time,
        onto:metrePerAttosecond-Time,
        onto:metrePerCentisecond-Time,
        onto:metrePerDay,
        onto:metrePerDecasecond-Time,
        onto:metrePerDecisecond-Time,
        onto:metrePerExasecond-Time,
        onto:metrePerFemtosecond-Time,
        onto:metrePerGigasecond-Time,
        onto:metrePerHectosecond-Time,
        onto:metrePerKilosecond-Time,
        onto:metrePerMegasecond-Time,
        onto:metrePerMicrosecond-Time,
        onto:metrePerMillisecond-Time,
        onto:metrePerNanosecond-Time,
        onto:metrePerPetasecond-Time,
        onto:metrePerPicosecond-Time,
        onto:metrePerSecond-Time,
        onto:metrePerTerasecond-Time,
        onto:micrometrePerSecond-Time,
        onto:mile-StatutePerHour,
        onto:millimetrePerDay,
        onto:millimetrePerHour,
        onto:millimetrePerSecond-Time,
        onto:nanometrePerSecond-Time,
        onto:nauticalMile-InternationalPerHour,
        onto:petametrePerSecond-Time,
        onto:picometrePerSecond-Time,
        onto:terametrePerSecond-Time ;
    onto:symbol "u" ;
    rdfs:subClassOf onto:Speed ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue onto:average ;
                        owl:onProperty onto:hasAggregateFunction ] ) ] .

onto:BodyLabelMass a owl:Class ;
    rdfs:label "body label mass"@en ;
    onto:commonlyHasUnit onto:gram,
        onto:kilogram,
        onto:tonne ;
    onto:unofficialLabel "body label weight" ;
    rdfs:subClassOf onto:LabelMass .

onto:BodyMass a owl:Class ;
