    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "A_V" ;
    rdfs:subClassOf onto:ExtinctionAtWaveband .

onto:FahrenheitTemperature a owl:Class ;
    rdfs:label "Fahrenheit temperature"@en ;
    onto:commonlyHasUnit onto:degreeFahrenheit ;
    onto:symbol "T" ;
