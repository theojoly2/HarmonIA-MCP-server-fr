        onto:nanovolt,
        onto:petavolt,
        onto:picovolt,
        onto:statvolt,
        onto:teravolt,
        onto:volt,
        onto:wattPerAmpere ;
    onto:symbol "E" ;
    rdfs:comment "Electromotive force is that which causes a flow of current."@en ;
    rdfs:subClassOf onto:ElectricPotential .

onto:ElectronTemperature a owl:Class ;
    rdfs:label "electron temperature"@en ;
    onto:alternativeLabel "kinetic temperature"@en ;
    onto:alternativeSymbol "T_k" ;
    onto:commonlyHasUnit onto:kelvin ;
    onto:symbol "T_e" ;
    rdfs:comment "The temperature determined by the mean kinetic energy of free electrons in a plasma; also known as kinetic temperature."@en ;
    rdfs:subClassOf onto:ThermodynamicTemperature .

onto:Ellipticity a owl:Class ;
    rdfs:label "ellipticity"@en ;
    onto:alternativeLabel "flattening"@en,
        "oblateness"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "f" ;
    rdfs:comment "A measure of the amount by which an object, such as a planet or a galaxy, deviates from a perfect sphere."@en ;
    rdfs:subClassOf onto:QuantityOfDimensionOne .

onto:EnergyDensityUnit a owl:Class ;
    rdfs:label "energy density unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:joulePerCubicmetre ) ] .

onto:EnergyUnit a owl:Class ;
    rdfs:label "energy unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:BritishThermalUnit-39F onto:BritishThermalUnit-59F onto:BritishThermalUnit-60F onto:BritishThermalUnit-InternationalTable onto:BritishThermalUnit-Mean onto:BritishThermalUnit-Thermochemical onto:calorie-15C onto:calorie-20C onto:calorie-InternationalTable onto:calorie-Mean onto:calorie-Thermochemical onto:electronvolt onto:erg onto:footPoundal onto:joule onto:quad onto:gigaelectronvolt onto:kiloelectronvolt onto:megaelectronvolt onto:wattHour onto:kilowattHour onto:terawattHour onto:therm-EC onto:therm-US onto:tonOfTNT onto:newtonMetre onto:micronewtonMetre onto:millinewtonMetre ) ] onto:PrefixedJoule onto:PrefixedElectronvolt onto:PrefixedCalorie-Mean ) ] .

onto:Enthalpy a owl:Class ;
    rdfs:label "enthalpy"@en ;
    onto:commonlyHasUnit onto:BritishThermalUnit-39F,
        onto:BritishThermalUnit-59F,
