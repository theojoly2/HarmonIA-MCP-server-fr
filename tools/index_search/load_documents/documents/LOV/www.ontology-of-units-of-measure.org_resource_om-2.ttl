                        owl:oneOf ( onto:gamma onto:gauss onto:stattesla onto:tesla onto:weberPerSquareMetre onto:milligauss ) ] onto:PrefixedTesla ) ] .

onto:MagneticFluxUnit a owl:Class ;
    rdfs:label "magnetic flux unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:maxwell onto:statweber onto:unitPole onto:weber onto:voltSecond-Time ) ] onto:PrefixedWeber ) ] .

onto:MagneticReynoldsNumber a owl:Class ;
    rdfs:label "magnetic Reynolds number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Rm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MagneticReynoldsNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:MagneticReynoldsNumberUnit a owl:Class ;
    rdfs:label "magnetic Reynolds number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:MagnetomotiveForceUnit a owl:Class ;
    rdfs:label "magnetomotive force unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:gilbert ) ] onto:PrefixedAmpere ) ] .

onto:MagnitudeUnit a owl:Class ;
    rdfs:label "magnitude unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one onto:magnitude onto:millimagnitude onto:micromagnitude ) ] .

onto:MassFlowUnit a owl:Class ;
    rdfs:label "mass flow unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:gramPerday onto:kilogramPerSecond-Time onto:milligramPerday ) ] .

onto:MassFractionUnit a owl:Class ;
    rdfs:label "mass fraction unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one onto:partsPerMillion onto:percent onto:gramPerGram onto:gramPerKilogram onto:gramPerHectogram onto:kilogramPerKilogram onto:milligramPerHectogram onto:milligramPerKilogram onto:microgramPerHectogram ) ] .

onto:MassUnit a owl:Class ;
    rdfs:label "mass unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:carat-Mass onto:grain onto:gram onto:hundredweight-British onto:hundredweight-US onto:InternationalUnit onto:milligramRAE onto:ounceAvoirdupois onto:ounceApothecaries onto:pennyweight-Troy onto:poundApothecaries onto:poundAvoirdupois onto:slug onto:solarMass onto:ton-ShortAssay onto:ton-Long onto:ton-Short onto:tonne onto:unifiedAtomicMassUnit ) ] onto:PrefixedGram onto:PrefixedTonne onto:PrefixedUnifiedAtomicMassUnit ) ] .

onto:Metallicity a owl:Class ;
    rdfs:label "metallicity"@en ;
    onto:commonlyHasUnit onto:one ;
    rdfs:comment "The log of the ratio between the ratios of the observed Fe and H quantities in a star and the same ratio in the Sun. This is a very important quantity that is often used in astronomy as an indicator of the age of a star."@en ;
    rdfs:subClassOf onto:QuantityOfDimensionOne .

onto:ModulusOfElasticity a owl:Class ;
    rdfs:label "modulus of elasticity"@en ;
    onto:alternativeLabel "Young's modulus"@en ;
