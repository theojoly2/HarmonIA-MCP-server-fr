    onto:hasDimension onto:speed-Dimension ;
    onto:hasNumerator onto:attometre ;
    onto:symbol "am/s" ;
    rdfs:comment "Attometre per second is a unit of speed defined as attometre divided by second."@en .

onto:centimetrePerDay a onto:UnitDivision ;
