        onto:decibar,
        onto:decipascal,
        onto:exapascal,
        onto:femtopascal,
        onto:gigapascal,
        onto:hectopascal,
        onto:kilogramSecond-TimeToThePower-2ReciprocalMetre,
        onto:kilopascal,
        onto:megapascal,
        onto:metreOfMercury,
        onto:microbar,
        onto:micropascal,
        onto:millibar,
        onto:millimetreOfMercury,
        onto:millipascal,
        onto:nanopascal,
        onto:newtonPerSquareMetre,
        onto:pascal,
        onto:petapascal,
        onto:picopascal,
        onto:terapascal,
        onto:torr ;
    onto:symbol "E" ;
    rdfs:subClassOf onto:DynamicModulus .

onto:Molality a owl:Class ;
    rdfs:label "molality"@en ;
    onto:alternativeLabel "molality of solution"@en ;
    onto:alternativeSymbol "m" ;
    onto:commonlyHasUnit onto:molePerKilogram ;
    onto:symbol "b" ;
    rdfs:comment "Molality is the number of moles of solute per kilogram of solvent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MolalityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:MolalityUnit a owl:Class ;
    rdfs:label "molality unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:molePerKilogram ) ] .

onto:MolarEnergyUnit a owl:Class ;
    rdfs:label "molar energy unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:joulePerMole ) ] .

onto:MolarEntropy a owl:Class ;
    rdfs:label "molar entropy"@en ;
    onto:commonlyHasUnit onto:joulePerKelvinMole ;
