onto:PeriodOfVariability a owl:Class ;
    rdfs:label "period of variability"@en ;
    onto:commonlyHasUnit onto:attosecond-Time,
        onto:centisecond-Time,
        onto:day,
        onto:day-Sidereal,
        onto:decasecond-Time,
        onto:decisecond-Time,
        onto:exasecond-Time,
        onto:femtosecond-Time,
        onto:gigasecond-Time,
        onto:gigayear,
