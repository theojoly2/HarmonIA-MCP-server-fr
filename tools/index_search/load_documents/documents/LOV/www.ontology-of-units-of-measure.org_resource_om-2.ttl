onto:CowlingNumber a owl:Class ;
    rdfs:label "Cowling number"@en ;
    onto:alternativeLabel "second Cowling number"@en ;
    onto:alternativeSymbol "Co2" ;
    onto:commonlyHasUnit onto:one ;
