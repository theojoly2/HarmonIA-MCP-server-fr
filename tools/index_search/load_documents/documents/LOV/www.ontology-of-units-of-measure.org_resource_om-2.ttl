        onto:gigaampere,
        onto:gilbert,
        onto:hectoampere,
        onto:kiloampere,
        onto:megaampere,
        onto:microampere,
        onto:milliampere,
        onto:nanoampere,
        onto:petaampere,
        onto:picoampere,
        onto:teraampere ;
    onto:symbol "F" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MagnetomotiveForceUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:electricCurrent-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:Prefix a owl:Class ;
    rdfs:label "prefix"@en ;
    rdfs:comment "A prefix is a name that precedes a basic unit of measure to indicate a decimal or binary multiple or fraction of the unit. Each prefix has a unique symbol that is prepended to the unit symbol. For example, an electric current of 0.000 000 001 ampere is written by using the SI-prefix nano as 1 nanoampere or 1 nA."@en .

onto:Strain a owl:Class ;
    rdfs:label "strain"@en ;
    onto:alternativeSymbol "γ" ;
    onto:commonlyHasUnit onto:one,
        onto:percent ;
    onto:symbol "ε" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:StrainUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:TemperatureUnit a owl:Class ;
    rdfs:label "temperature unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:degreeCelsius onto:degreeFahrenheit onto:degreeRankine onto:degreeReaumur onto:kelvin ) ] onto:PrefixedDegreeCelsius onto:PrefixedKelvin ) ] .

onto:attometrePerSecond-Time a onto:PrefixedMetrePerSecond-Time ;
