onto:ShearRate a owl:Class ;
    rdfs:label "shear rate"@en ;
    onto:commonlyHasUnit onto:reciprocalSecond-Time ;
    onto:symbol "S" ;
    rdfs:subClassOf [ a owl:Restriction ;
