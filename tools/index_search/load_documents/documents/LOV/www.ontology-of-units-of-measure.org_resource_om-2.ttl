            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:ElectricalResistance a owl:Class ;
    rdfs:label "electrical resistance"@en ;
    onto:alternativeLabel "electric resistance"@en,
        "resistance"@en ;
    onto:commonlyHasUnit onto:abohm,
        onto:attoohm,
        onto:centiohm,
        onto:decaohm,
