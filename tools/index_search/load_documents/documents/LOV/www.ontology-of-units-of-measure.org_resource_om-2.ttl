                    owl:allValuesFrom onto:MolarVolumeUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:MolarVolumeUnit a owl:Class ;
    rdfs:label "molar volume unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:cubicMetrePerMole onto:litrePerMole ) ] .

onto:MomentOfForceUnit a owl:Class ;
    rdfs:label "moment of force unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:newtonMetre onto:micronewtonMetre onto:millinewtonMetre ) ] .

onto:MomentOfInertia a owl:Class ;
    rdfs:label "moment of inertia"@en ;
    onto:alternativeSymbol "J" ;
    onto:commonlyHasUnit onto:kilogramSquareMetre ;
    onto:symbol "I" ;
    rdfs:comment "Moment of inertia is a measure of the effectiveness of mass in rotation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MomentOfInertiaUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:MomentOfInertiaUnit a owl:Class ;
    rdfs:label "moment of inertia unit"@en ;
    rdfs:subClassOf onto:Unit ;
