        onto:gigaelectronvolt,
        onto:gigajoule,
        onto:hectojoule,
        onto:joule,
        onto:kilocalorie-Mean,
        onto:kiloelectronvolt,
        onto:kilojoule,
        onto:kilowattHour,
        onto:megaelectronvolt,
        onto:megaerg,
        onto:megajoule,
        onto:microjoule,
        onto:micronewtonMetre,
        onto:millijoule,
        onto:millinewtonMetre,
        onto:nanojoule,
        onto:newtonMetre,
        onto:petajoule,
        onto:picojoule,
        onto:quad,
        onto:terajoule,
        onto:terawattHour,
        onto:therm-EC,
        onto:therm-US,
        onto:tonOfTNT,
        onto:wattHour ;
    onto:symbol "U" ;
    rdfs:comment "The internal energy of a thermodynamic system, or a body with well-defined boundaries is the total of the kinetic energy due to the motion of molecules (translational, rotational, vibrational) and the potential energy associated with the vibrational and electric energy of atoms within molecules or crystals."@en ;
    rdfs:subClassOf onto:Energy .

onto:IntrinsicColourIndex a owl:Class ;
    rdfs:label "intrinsic colour index"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    rdfs:comment "The colour index a star would have in the absence of interstellar extinction (reddening). It is assumed that all stars of the same spectral type and luminosity class have the same colour index."@en ;
    rdfs:subClassOf onto:ColourIndex .

onto:IonizationTemperature a owl:Class ;
    rdfs:label "ionization temperature"@en ;
    onto:commonlyHasUnit onto:kelvin ;
    onto:symbol "T_ion" ;
    rdfs:comment "The temperature of a gas or plasma derived from the relative numbers of neutral atoms and ions. Specifically, it is the temperature for which the Saha equations would predict these relative numbers, assuming the atoms and ions are in thermodynamic equilibrium."@en ;
    rdfs:subClassOf onto:ThermodynamicTemperature .

onto:JeansMass a owl:Class ;
    rdfs:label "Jeans mass"@en ;
    onto:commonlyHasUnit onto:kilogram,
        onto:solarMass ;
    onto:symbol "M_J" ;
    rdfs:comment "The critical mass of a molecular cloud, above which it will be unstable to collapse."@en ;
    rdfs:subClassOf onto:Mass .

onto:Kerma a owl:Class ;
    rdfs:label "kerma"@en ;
    onto:commonlyHasUnit onto:attogray,
        onto:centigray,
        onto:decagray,
        onto:decigray,
        onto:exagray,
        onto:femtogray,
        onto:gigagray,
        onto:gray,
        onto:hectogray,
        onto:joulePerKilogram,
        onto:kilogray,
        onto:megagray,
        onto:microgray,
        onto:milligray,
        onto:nanogray,
        onto:petagray,
        onto:picogray,
        onto:rad,
        onto:teragray ;
    rdfs:subClassOf onto:AbsorbedDose .

onto:KinematicViscosityUnit a owl:Class ;
