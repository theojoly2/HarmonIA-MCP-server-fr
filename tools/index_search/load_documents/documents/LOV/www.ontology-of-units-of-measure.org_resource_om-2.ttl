        [ a owl:Restriction ;
            owl:hasValue onto:exposureToXAndGammaRays-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:ExposureToXAndGammaRaysUnit a owl:Class ;
    rdfs:label "exposure to x and γ rays unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:röntgen onto:coulombPerKilogram ) ] .

onto:ExposureUnit a owl:Class ;
    rdfs:label "exposure unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:luxSecond-Time ) ] ) ] .

onto:ExtinctionAtWavelength a owl:Class ;
