                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:catalyticActivityConcentration-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:CatalyticActivityConcentrationUnit a owl:Class ;
    rdfs:label "catalytic activity concentration unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:katalPerCubicmetre ) ] .

onto:CatalyticActivityUnit a owl:Class ;
    rdfs:label "catalytic activity unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:amylaseUnit onto:katal onto:molePerSecond-Time onto:deltaA450PerSecond-Time ) ] onto:PrefixedKatal ) ] .

onto:CelsiusTemperature a owl:Class ;
    rdfs:label "Celsius temperature"@en ;
    onto:alternativeSymbol "θ" ;
    onto:commonlyHasUnit onto:attodegreeCelsius,
