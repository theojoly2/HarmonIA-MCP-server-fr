        onto:minute-Sidereal,
        onto:minute-Time,
        onto:nanosecond-Time,
        onto:petasecond-Time,
        onto:picosecond-Time,
        onto:second-Sidereal,
        onto:second-Time,
        onto:shake,
        onto:terasecond-Time,
        onto:year,
        onto:year-Sidereal,
        onto:year-Tropical ;
    onto:symbol "P" ;
    rdfs:comment "The duration of one cycle in a (semi) periodical star."@en ;
    rdfs:subClassOf onto:Time .

onto:Permeability-EarthScience a owl:Class ;
    rdfs:label "permeability (earth science)"@en ;
    onto:alternativeLabel "intrinsic permeability"@en ;
    onto:alternativeSymbol "k" ;
    onto:commonlyHasUnit onto:darcy,
        onto:squareAttometre,
        onto:squareCentimetre,
        onto:squareDecametre,
        onto:squareDecimetre,
        onto:squareExametre,
        onto:squareFemtometre,
        onto:squareGigametre,
        onto:squareHectometre,
        onto:squareKilometre,
        onto:squareMegametre,
        onto:squareMetre,
        onto:squareMicrometre,
        onto:squareMillimetre,
        onto:squareNanometre,
        onto:squarePetametre,
        onto:squarePicometre,
        onto:squareTerametre ;
    onto:symbol "κ" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:area-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
