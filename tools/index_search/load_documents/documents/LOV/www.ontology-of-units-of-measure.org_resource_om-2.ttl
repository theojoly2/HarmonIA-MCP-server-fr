onto:Point a owl:Class ;
    rdfs:label "point"@en ;
    rdfs:comment "A point is an element of an interval scale or a ratio scale, for example, 273.16 on the Kelvin scale indicates the triple point of water thermodynamic temperature."@en .

onto:PrefixedGram a owl:Class ;
    rdfs:label "prefixed gram"@en ;
    rdfs:subClassOf onto:PrefixedUnit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue onto:gram ;
                        owl:onProperty onto:hasUnit ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasUnit ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:SIPrefix ;
                        owl:onProperty onto:hasPrefix ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasPrefix ] ) ] .

onto:PrefixedSecond-Time a owl:Class ;
    rdfs:label "prefixed second (time)"@en ;
    rdfs:subClassOf onto:PrefixedUnit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue onto:second-Time ;
                        owl:onProperty onto:hasUnit ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasUnit ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:SIPrefix ;
                        owl:onProperty onto:hasPrefix ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasPrefix ] ) ] .

onto:QuantityOfDimensionOne a owl:Class ;
    rdfs:label "quantity of dimension one"@en ;
    onto:commonlyHasUnit onto:one,
        onto:partsPerMillion,
        onto:percent ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:QuantityOfDimensionOneUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

