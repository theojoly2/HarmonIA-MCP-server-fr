        onto:micropascal,
        onto:millibar,
        onto:millimetreOfMercury,
        onto:millipascal,
        onto:nanopascal,
        onto:newtonPerSquareMetre,
        onto:pascal,
        onto:petapascal,
        onto:picopascal,
        onto:terapascal,
        onto:torr ;
    rdfs:comment "Compressive stress is a stress that, when applied, acts towards the center of a material."@en ;
    rdfs:subClassOf onto:Stress .

onto:ContactAngle a owl:Class ;
    rdfs:label "contact angle"@en ;
    onto:commonlyHasUnit onto:attoradian,
