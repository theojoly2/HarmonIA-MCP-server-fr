onto:Mass a owl:Class ;
    rdfs:label "mass"@en ;
    onto:commonlyHasUnit onto:InternationalUnit,
        onto:attogram,
        onto:carat-Mass,
        onto:centigram,
        onto:decagram,
        onto:decigram,
        onto:exagram,
        onto:femtogram,
        onto:gigagram,
        onto:grain,
        onto:gram,
        onto:hectogram,
        onto:hundredweight-British,
        onto:hundredweight-US,
        onto:kilogram,
        onto:kilotonne,
        onto:megagram,
        onto:megatonne,
        onto:microgram,
        onto:milligram,
        onto:milligramRAE,
        onto:nanogram,
        onto:nanounifiedAtomicMassUnit,
        onto:ounceApothecaries,
        onto:ounceAvoirdupois,
        onto:pennyweight-Troy,
        onto:petagram,
        onto:picogram,
        onto:poundApothecaries,
        onto:poundAvoirdupois,
        onto:slug,
        onto:solarMass,
        onto:teragram,
        onto:ton-Long,
        onto:ton-Short,
        onto:ton-ShortAssay,
        onto:tonne,
        onto:unifiedAtomicMassUnit ;
    onto:symbol "m" ;
    onto:unofficialLabel "weight" ;
    rdfs:comment "Mass is the amount of matter of a phenomenon. It is a base quantity in the International System of Units. Mass is force divided by acceleration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MassUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:mass-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

