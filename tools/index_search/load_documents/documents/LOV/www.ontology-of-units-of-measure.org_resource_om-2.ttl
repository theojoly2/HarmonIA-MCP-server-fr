    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:gramPerCubicmetre onto:milligramPerCubicmetre onto:gramPerCubicCentimetre onto:microgramPerCubicCentimetre onto:kilogramPerCubicmetre onto:kilogramPerCubicDecimetre onto:gramPerLitre onto:solarMassPerCubicParsec ) ] onto:PrefixedGramPerLitre onto:GramPerPrefixedLitre onto:PrefixedGramPerPrefixedLitre ) ] .

onto:DetectiveQuantumEfficiency a owl:Class ;
    rdfs:label "detective quantum efficiency"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "DQE" ;
    rdfs:comment "Square of ratio between the output signal noise ratio and the input signal noise ratio."@en ;
