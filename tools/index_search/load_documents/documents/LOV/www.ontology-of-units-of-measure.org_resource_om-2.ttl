onto:PrefixedMetrePrefixedGram a owl:Class ;
    rdfs:label "prefixed metre prefixed gram"@en ;
    rdfs:subClassOf onto:UnitMultiplication ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom onto:PrefixedMetre ;
                        owl:onProperty onto:hasTerm1 ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasTerm1 ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:PrefixedGram ;
                        owl:onProperty onto:hasTerm2 ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasTerm2 ] ) ] .

onto:PrefixedMolePerPrefixedMetre a owl:Class ;
    rdfs:label "prefixed mole per prefixed metre"@en ;
    rdfs:subClassOf onto:UnitDivision ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom onto:PrefixedMole ;
                        owl:onProperty onto:hasNumerator ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasNumerator ] [ a owl:Restriction ;
                        owl:allValuesFrom onto:PrefixedMetre ;
                        owl:onProperty onto:hasDenominator ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:hasDenominator ] ) ] .

