        onto:microbar,
        onto:micropascal,
        onto:millibar,
        onto:millimetreOfMercury,
        onto:millipascal,
        onto:nanopascal,
        onto:newtonPerSquareMetre,
        onto:pascal,
        onto:petapascal,
        onto:picopascal,
        onto:terapascal,
        onto:torr ;
    onto:symbol "c_ijkl" ;
    rdfs:subClassOf onto:DynamicModulus .

onto:ElectricChargeDensity a owl:Class ;
    rdfs:label "electric charge density"@en ;
    onto:alternativeLabel "charge density"@en ;
    onto:commonlyHasUnit onto:coulombPerCubicmetre ;
    rdfs:comment "Electric charge density is the amount of electric charge in a volume. It is a derived quantity in the International System of Units. Electric charge density is electric charge divided by volume."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ElectricChargeDensityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:electricChargeDensity-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:ElectricChargeDensityUnit a owl:Class ;
    rdfs:label "electric charge density unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:coulombPerCubicmetre ) ] .

onto:ElectricChargeUnit a owl:Class ;
    rdfs:label "electric charge unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:abcoulomb onto:coulomb onto:faraday onto:franklin onto:statcoulomb onto:second-TimeAmpere ) ] onto:PrefixedCoulomb ) ] .

onto:ElectricCurrentUnit a owl:Class ;
    rdfs:label "electric current unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:abampere onto:ampere onto:biot onto:statampere ) ] onto:PrefixedAmpere ) ] .

onto:ElectricDipoleMoment a owl:Class ;
    rdfs:label "electric dipole moment"@en ;
    onto:commonlyHasUnit onto:coulombMetre,
        onto:debye ;
    onto:symbol "p" ;
    rdfs:comment "Electric dipole moment is a measure of the polarity of a system of electric charges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ElectricDipoleMomentUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:electricDipoleMoment-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:ElectricDipoleMomentUnit a owl:Class ;
    rdfs:label "electric dipole moment unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:debye onto:coulombMetre ) ] .

onto:ElectricField a owl:Class ;
    rdfs:label "electric field"@en ;
    onto:alternativeLabel "electric field strength"@en ;
    onto:commonlyHasUnit onto:newtonPerCoulomb,
        onto:voltPerMetre ;
    onto:symbol "E" ;
    rdfs:comment "Electric field is a property of the space surrounding an electric charge or in the presence of a time-varying magnetic field which exerts a forceon other electrically charged objects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:electricField-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ElectricFieldUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:ElectricFieldUnit a owl:Class ;
    rdfs:label "electric field unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:newtonPerCoulomb onto:voltPerMetre ) ] .

onto:ElectricFluxDensity a owl:Class ;
    rdfs:label "electric flux density"@en ;
    onto:commonlyHasUnit onto:coulombPerSquareMetre ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:electricFluxDensity-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ElectricFluxDensityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:ElectricFluxDensityUnit a owl:Class ;
    rdfs:label "electric flux density unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:coulombPerSquareMetre ) ] .

onto:ElectricPotentialUnit a owl:Class ;
    rdfs:label "electric potential unit"@en ;
    rdfs:subClassOf onto:Unit ;
