onto:ForceUnit a owl:Class ;
    rdfs:label "force unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:dyne onto:kip onto:newton onto:poundal onto:pound-Force onto:ton-Force-Short onto:metreKilogramPerSecond-TimeSquared ) ] onto:PrefixedNewton ) ] .

onto:FourierNumber a owl:Class ;
    rdfs:label "Fourier number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Fo" ;
    rdfs:comment "The Fourier number is a dimensionless number that characterises heat conduction. It is the ratio of heat conduction rate to rate of thermal energy storage. The Fourier number is a dimensionless time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:FourierNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:FourierNumberForMassTransfer a owl:Class ;
    rdfs:label "Fourier number for mass transfer"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Fo*" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:FourierNumberForMassTransferUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:FourierNumberForMassTransferUnit a owl:Class ;
    rdfs:label "Fourier number for mass transfer unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:FourierNumberUnit a owl:Class ;
    rdfs:label "Fourier number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:FrequencyUnit a owl:Class ;
    rdfs:label "frequency unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:hertz onto:reciprocalSecond-Time onto:reciprocalMinute-Time onto:reciprocalHour onto:reciprocalDay onto:reciprocalYear ) ] onto:PrefixedHertz ) ] .

onto:FroudeNumber a owl:Class ;
    rdfs:label "Froude number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Fr" ;
    rdfs:comment "The Froude number is a dimensionless number that compares inertial and gravitational forces. It may be used to quantify the resistance of an object moving through water, and compare objects of different sizes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:FroudeNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
