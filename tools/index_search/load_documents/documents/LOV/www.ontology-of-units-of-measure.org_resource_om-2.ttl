                        owl:oneOf ( onto:abfarad onto:farad onto:statfarad onto:coulombPerVolt ) ] onto:PrefixedFarad ) ] .

onto:CatalyticActivityConcentration a owl:Class ;
    rdfs:label "catalytic activity concentration"@en ;
    onto:alternativeLabel "catalytic concentration"@en ;
    onto:commonlyHasUnit onto:katalPerCubicmetre ;
    rdfs:subClassOf [ a owl:Restriction ;
