onto:ThermalConductivity a owl:Class ;
    rdfs:label "thermal conductivity"@en ;
    onto:alternativeSymbol "K",
        "k",
        "λ" ;
    onto:commonlyHasUnit onto:wattPerMetreKelvin ;
    onto:symbol "κ" ;
