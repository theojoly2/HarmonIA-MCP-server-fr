onto:DrainageSpeed a owl:Class ;
    rdfs:label "drainage speed"@en ;
    onto:commonlyHasUnit onto:attometrePerSecond-Time,
        onto:centimetrePerDay,
        onto:centimetrePerSecond-Time,
        onto:decametrePerSecond-Time,
        onto:decimetrePerSecond-Time,
        onto:exametrePerSecond-Time,
        onto:femtometrePerSecond-Time,
        onto:gigametrePerSecond-Time,
        onto:hectometrePerSecond-Time,
        onto:kilometrePerHour,
        onto:kilometrePerSecond-Time,
        onto:knot-International,
        onto:megametrePerSecond-Time,
        onto:metrePerAttosecond-Time,
        onto:metrePerCentisecond-Time,
        onto:metrePerDay,
        onto:metrePerDecasecond-Time,
        onto:metrePerDecisecond-Time,
        onto:metrePerExasecond-Time,
        onto:metrePerFemtosecond-Time,
        onto:metrePerGigasecond-Time,
        onto:metrePerHectosecond-Time,
        onto:metrePerKilosecond-Time,
        onto:metrePerMegasecond-Time,
        onto:metrePerMicrosecond-Time,
        onto:metrePerMillisecond-Time,
        onto:metrePerNanosecond-Time,
        onto:metrePerPetasecond-Time,
        onto:metrePerPicosecond-Time,
        onto:metrePerSecond-Time,
        onto:metrePerTerasecond-Time,
        onto:micrometrePerSecond-Time,
        onto:mile-StatutePerHour,
        onto:millimetrePerDay,
        onto:millimetrePerHour,
        onto:millimetrePerSecond-Time,
        onto:nanometrePerSecond-Time,
        onto:nauticalMile-InternationalPerHour,
        onto:petametrePerSecond-Time,
