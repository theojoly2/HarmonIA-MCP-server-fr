    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:stokes onto:squareMetrePerSecond-Time ) ] onto:PrefixedStokes ) ] .

onto:KineticEnergy a owl:Class ;
    rdfs:label "kinetic energy"@en ;
    onto:alternativeSymbol "K",
        "T" ;
    onto:commonlyHasUnit onto:BritishThermalUnit-39F,
        onto:BritishThermalUnit-59F,
        onto:BritishThermalUnit-60F,
        onto:BritishThermalUnit-InternationalTable,
        onto:BritishThermalUnit-Mean,
        onto:BritishThermalUnit-Thermochemical,
        onto:attojoule,
        onto:calorie-15C,
        onto:calorie-20C,
        onto:calorie-InternationalTable,
        onto:calorie-Mean,
        onto:calorie-Thermochemical,
        onto:centijoule,
        onto:decajoule,
        onto:decijoule,
        onto:electronvolt,
        onto:erg,
