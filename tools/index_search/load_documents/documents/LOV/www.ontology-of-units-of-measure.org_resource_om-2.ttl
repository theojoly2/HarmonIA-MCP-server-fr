onto:AbsorbedDoseRate a owl:Class ;
    rdfs:label "absorbed dose rate"@en ;
    onto:commonlyHasUnit onto:grayPerSecond-Time ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:absorbedDoseRate-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AbsorbedDoseRateUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:Action a owl:Class ;
    rdfs:label "action"@en ;
    onto:commonlyHasUnit onto:ergSecond-Time,
        onto:jouleSecond-Time ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:actionOrAngularMomentum-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ActionUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:Activity a owl:Class ;
    rdfs:label "activity"@en ;
    onto:alternativeLabel "activity (of a radionuclide)"@en,
        "activity of a radionuclide"@en ;
    onto:commonlyHasUnit onto:attobecquerel,
        onto:becquerel,
        onto:centibecquerel,
        onto:curie,
        onto:decabecquerel,
        onto:decibecquerel,
        onto:exabecquerel,
        onto:femtobecquerel,
        onto:gigabecquerel,
        onto:hectobecquerel,
        onto:kilobecquerel,
        onto:megabecquerel,
        onto:microbecquerel,
        onto:millibecquerel,
        onto:nanobecquerel,
        onto:petabecquerel,
        onto:picobecquerel,
        onto:reciprocalSecond-Time,
        onto:terabecquerel ;
    onto:symbol "A" ;
    rdfs:comment "Activity is the decay rate of a radioactive substance. It is a derived quantity in the International System of Units. Activity is 1 divided by time."@en ;
