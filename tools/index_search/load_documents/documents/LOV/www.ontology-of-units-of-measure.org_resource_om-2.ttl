ns2:reference a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "reference"@en ;
    rdfs:domain ns1:Document .

ns3:illustration a owl:AnnotationProperty .

ns3:logo a owl:AnnotationProperty .

<http://www.iau.org/static/resolutions/IAU2012_English.pdf> a ns1:Standard ;
    dc:creator ns2:IAUDiv1WG ;
    dc:date "2012" ;
    dc:publisher ns2:International_Astronomical_Union ;
    dc:title "IAU 2012" ;
    ns1:uri "http://www.iau.org/static/resolutions/IAU2012_English.pdf" .

onto:AFS a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "AFS"@en ;
    onto:hasDimension onto:dimensionOne .

onto:AberrationInLatitude a owl:Class ;
    rdfs:label "aberration in latitude"@en ;
    onto:commonlyHasUnit onto:degree,
        onto:microsecond-Angle,
        onto:millisecond-Angle,
        onto:second-Angle ;
    onto:symbol "Δβ" ;
    rdfs:comment "The apparent angular displacement in ecliptical latitude of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en ;
    rdfs:subClassOf onto:AngularDisplacement ;
    ns2:reference ns2:chapter23_Astronomical_Algorithms .

onto:AberrationInLongitude a owl:Class ;
    rdfs:label "aberration in longitude"@en ;
    onto:commonlyHasUnit onto:degree,
        onto:microsecond-Angle,
        onto:millisecond-Angle,
        onto:second-Anglee ;
    onto:symbol "Δλ" ;
    rdfs:comment "The apparent angular displacement in ecliptical longitude of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en ;
    rdfs:subClassOf onto:AngularDisplacement ;
    ns2:reference ns2:chapter23_Astronomical_Algorithms .

onto:AbsoluteBolometricMagnitude a owl:Class ;
    rdfs:label "absolute bolometric magnitude"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "M_bol" ;
    rdfs:comment "The absolute magnitude (see absolute magnitude) of a star is a measure of its total energy emission per second, or luminosity, i.e., the bolometric magnitude from a standard distance (10 pc)."@en ;
    rdfs:subClassOf onto:BolometricMagnitude .

onto:AbsoluteMagnitude a owl:Class ;
    rdfs:label "absolute magnitude"@en ;
    onto:commonlyHasUnit onto:magnitude,
        onto:micromagnitude,
        onto:millimagnitude,
        onto:one ;
    onto:symbol "M" ;
    rdfs:comment "Logarithmic measure of the brightness of an object as seen from a standard distance of 10 pc. Units usually not indicated (http://en.wikipedia.org/wiki/Magnitude_(astronomy)."@en ;
    rdfs:subClassOf onto:Magnitude .

onto:AbsorbedDoseRateUnit a owl:Class ;
    rdfs:label "absorbed dose rate unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:grayPerSecond-Time ) ] .

onto:AbsorbedDoseUnit a owl:Class ;
    rdfs:label "absorbed dose unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:gray onto:rad onto:joulePerKilogram onto:kilojoulePerHectogram ) ] onto:PrefixedGray ) ] .

onto:AccelerationUnit a owl:Class ;
    rdfs:label "acceleration unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:gal onto:metrePerSecond-TimeSquared ) ] onto:PrefixedMetrePerSecond-TimeSquared onto:MetrePerPrefixedSecond-TimeSquared onto:PrefixedMetrePerPrefixedSecond-TimeSquared ) ] .

onto:Acidity a owl:Class ;
    rdfs:label "acidity"@en ;
    onto:symbol "pH" ;
    rdfs:subClassOf onto:Quantity .

onto:ActionUnit a owl:Class ;
    rdfs:label "action unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:ergSecond-Time onto:jouleSecond-Time ) ] .

onto:ActivityUnit a owl:Class ;
    rdfs:label "activity unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:becquerel onto:curie onto:reciprocalSecond-Time ) ] onto:PrefixedBecquerel ) ] .

onto:Admittance a owl:Class ;
    rdfs:label "admittance"@en ;
    onto:symbol "Y" ;
    rdfs:comment "Admittance is a measure of how easily a circuit or device will allow a current to flow. It is electric current divided by electric potential."@en ;
    rdfs:subClassOf onto:Quantity .

onto:AlfvenNumber a owl:Class ;
    rdfs:label "Alfvén number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Al" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AlfvenNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:AlfvenNumberUnit a owl:Class ;
    rdfs:label "Alfvén number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:Altitude a owl:Class ;
    rdfs:label "altitude"@en ;
    onto:alternativeLabel "elevation"@en ;
    onto:alternativeSymbol "Alt" ;
    onto:commonlyHasUnit onto:degree,
        onto:minute-Angle,
        onto:second-Angle ;
    onto:symbol "h" ;
    rdfs:comment "The angular distance of a celestial body above or below the horizon, measured along the great circle passing through the body and the zenith."@en ;
    rdfs:subClassOf onto:Angle ;
    ns2:reference ns2:Glossary_Astronomical_Almanac .

onto:AmbientDoseEquivalent a owl:Class ;
    rdfs:label "ambient dose equivalent"@en ;
    onto:commonlyHasUnit onto:attosievert,
        onto:centisievert,
        onto:decasievert,
        onto:decisievert,
        onto:exasievert,
        onto:femtosievert,
        onto:gigasievert,
        onto:hectosievert,
        onto:kilosievert,
        onto:megasievert,
        onto:microsievert,
        onto:millisievert,
        onto:nanosievert,
        onto:petasievert,
        onto:picosievert,
        onto:rem,
        onto:sievert,
        onto:terasievert ;
    rdfs:subClassOf onto:DoseEquivalent .

onto:AmountOfMoneyUnit a owl:Class ;
    rdfs:label "amount of money unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:UnitedStatesDollar onto:euro onto:JapaneseYen onto:poundSterling onto:AustralianDollar onto:SwissFranc onto:CanadianDollar onto:MexicanPeso onto:ChineseYuan onto:NewZealandDollar onto:SwedishKrona onto:RussianRuble onto:HongKongDollar onto:NorwegianKrone onto:SingaporeDollar onto:TurkishLira onto:SouthKoreanWon onto:SouthAfricanRand onto:BrazilianReal onto:IndianRupee onto:megaeuro ) ] .

onto:AmountOfSubstanceConcentration a owl:Class ;
    rdfs:label "amount of substance concentration"@en ;
    onto:alternativeLabel "molar concentration"@en ;
    onto:commonlyHasUnit onto:attomolair,
        onto:attomolePerLitre,
        onto:centimolePerLitre,
        onto:decamolePerLitre,
        onto:decimolePerLitre,
        onto:examolePerLitre,
        onto:femtomolair,
        onto:femtomolePerLitre,
        onto:gigamolePerLitre,
        onto:hectomolePerLitre,
        onto:kilomolePerLitre,
        onto:megamolair,
        onto:megamolePerLitre,
        onto:micromolair,
        onto:micromolePerLitre,
        onto:millimolair,
        onto:millimolePerLitre,
        onto:molair,
        onto:molePerAttolitre,
        onto:molePerCentilitre,
        onto:molePerCubicmetre,
        onto:molePerDecalitre,
        onto:molePerDecilitre,
        onto:molePerExalitre,
        onto:molePerFemtolitre,
        onto:molePerGigalitre,
        onto:molePerHectolitre,
        onto:molePerKilolitre,
        onto:molePerLitre,
        onto:molePerMegalitre,
        onto:molePerMicrolitre,
        onto:molePerMillilitre,
        onto:molePerNanolitre,
        onto:molePerPetalitre,
        onto:molePerPicolitre,
        onto:molePerTeralitre,
        onto:nanomolair,
        onto:nanomolePerLitre,
        onto:petamolePerLitre,
        onto:picomolair,
        onto:picomolePerLitre,
        onto:teramolePerLitre ;
    onto:symbol "C" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AmountOfSubstanceConcentrationUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:amountOfSubstanceConcentration-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:AmountOfSubstanceConcentrationUnit a owl:Class ;
    rdfs:label "amount of substance concentration unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:molair onto:molePerCubicmetre onto:molePerLitre ) ] onto:PrefixedMolair onto:PrefixedMolePerLitre onto:MolePerPrefixedLitre onto:PrefixedMolePerPrefixedLitre ) ] .

onto:AmountOfSubstanceFlow a owl:Class ;
    rdfs:label "amount of substance flow"@en ;
    onto:alternativeLabel "amount-of-substance flow"@en,
        "molar flow"@en ;
    onto:commonlyHasUnit onto:micromolePerSecond-Time,
        onto:molePerSecond-Time ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AmountOfSubstanceFlowUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:AmountOfSubstanceFlowUnit a owl:Class ;
    rdfs:label "amount of substance flow unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:molePerSecond-Time onto:micromolePerSecond-Time ) ] .

onto:AmountOfSubstanceFraction a owl:Class ;
    rdfs:label "amount of substance fraction"@en ;
    onto:alternativeLabel "amount-of-substance fraction"@en,
        "mole fraction"@en ;
    onto:alternativeSymbol "y" ;
    onto:commonlyHasUnit onto:micromolePerMole,
        onto:molePerMole,
        onto:one,
        onto:partsPerMillion,
        onto:percent ;
    onto:symbol "x" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AmountOfSubstanceFractionUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:AmountOfSubstanceFractionFlow a owl:Class ;
    rdfs:label "amount of substance fraction flow"@en ;
    onto:alternativeLabel "amount-of-substance fraction flow"@en,
        "mole fraction flow"@en ;
    rdfs:subClassOf onto:Quantity .

onto:AmountOfSubstanceFractionUnit a owl:Class ;
    rdfs:label "amount of substance fraction unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one onto:partsPerMillion onto:percent onto:molePerMole onto:micromolePerMole ) ] .

onto:AmountOfSubstanceUnit a owl:Class ;
    rdfs:label "amount of substance unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:mole ) ] onto:PrefixedMole ) ] .

onto:Amphiphilicity a owl:Class ;
    rdfs:label "amphiphilicity"@en ;
    rdfs:subClassOf onto:Quantity .

onto:AngleUnit a owl:Class ;
    rdfs:label "angle unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:degree onto:gon onto:mil-Angle onto:minute-Angle onto:radian onto:revolution onto:second-Angle onto:millisecond-Angle onto:microsecond-Angle onto:metrePerMetre ) ] onto:PrefixedRadian ) ] .

onto:AngularAccelerationUnit a owl:Class ;
    rdfs:label "angular acceleration unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:radianPerSecond-TimeSquared ) ] .

onto:AngularMomentumUnit a owl:Class ;
    rdfs:label "angular momentum unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:ergSecond-Time onto:jouleSecond-Time ) ] .

onto:AngularSize a owl:Class ;
    rdfs:label "angular size"@en ;
    onto:commonlyHasUnit onto:degreeSquared,
        onto:second-AngleSquared ;
    rdfs:subClassOf onto:SolidAngle .

onto:AngularSpeedUnit a owl:Class ;
    rdfs:label "angular speed unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:millisecond-AnglePerYear onto:radianPerSecond-Time ) ] .

onto:AnnualAberration a owl:Class ;
    rdfs:label "annual aberration"@en ;
    onto:commonlyHasUnit onto:degree,
        onto:microsecond-Angle,
        onto:millisecond-Angle,
        onto:second-Angle ;
    rdfs:comment "The component of the stellar abberation resulting from the motion of the Earth about the Sun. The abberation is the apparent angular displacement of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en ;
    rdfs:subClassOf onto:AngularDisplacement ;
    ns2:reference ns2:Glossary_Astronomical_Almanac .

onto:ApparentDiameter a owl:Class ;
    rdfs:label "apparent diameter"@en ;
    onto:commonlyHasUnit onto:degree,
        onto:microsecond-Angle,
        onto:millisecond-Angle,
        onto:minute-Angle,
        onto:radian,
        onto:second-Angle ;
    rdfs:comment "The angle that the actual diameter of an object makes in the sky; also known as angular size. Most often small, so units are mostly arcminutes, arcseconds, or even milli- or microarcseconds."@en ;
    rdfs:subClassOf onto:Angle .

onto:ApparentDistanceModulus a owl:Class ;
    rdfs:label "apparent distance modulus"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    rdfs:subClassOf onto:DistanceModulus .

onto:ApparentMagnitude a owl:Class ;
    rdfs:label "apparent magnitude"@en ;
    onto:commonlyHasUnit onto:magnitude,
        onto:micromagnitude,
        onto:millimagnitude,
        onto:one ;
    onto:symbol "m" ;
    rdfs:comment "Logarithmic measure of the apparent brightness of an object. Units usually not indicated(http://en.wikipedia.org/wiki/Magnitude_(astronomy)."@en ;
    rdfs:subClassOf onto:Magnitude .

onto:AreaDensityRateUnit a owl:Class ;
    rdfs:label "area density rate unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:kilogramPerHectareDay ) ] ) ] .

onto:AreaDensityUnit a owl:Class ;
    rdfs:label "area density unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:gramPerSquareMetre onto:kilogramPerSquareMetre onto:kilogramPerHectare ) ] ) ] .

onto:AreaFractionUnit a owl:Class ;
    rdfs:label "area fraction unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one onto:partsPerMillion onto:percent onto:squareMetrePerSquareMetre ) ] .

onto:AreaUnit a owl:Class ;
    rdfs:label "area unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:acre-International onto:acre-USSurvey onto:are onto:barn onto:circularMil onto:squareMetre ) ] onto:PrefixedAre onto:SquarePrefixedMetre ) ] .

onto:Azimuth a owl:Class ;
    rdfs:label "azimuth"@en ;
    onto:alternativeSymbol "Az" ;
    onto:commonlyHasUnit onto:degree,
        onto:minute-Angle,
        onto:second-Angle ;
    onto:symbol "A" ;
    rdfs:comment "The angular distance measured clockwise along the horizon from a specified reference point (usually north) to the intersection with the great circle drawn from the zenith through a body on the celestial sphere."@en ;
    rdfs:subClassOf onto:Angle ;
    ns2:reference ns2:Glossary_Astronomical_Almanac .

onto:BMagnitudeAtMaximumBrightness a owl:Class ;
    rdfs:label "B magnitude at maximum brightness"@en ;
    onto:commonlyHasUnit onto:magnitude,
        onto:one ;
    onto:symbol "B_max" ;
    rdfs:comment "Johnson B magnitude at maximum brightness (i.e. for a variable star). The Johnson B band is a standard filter in the blue area. The central wavelength is 440nm and the bandwidth is 100nm.  The filter to be used is the Corning 5030 filter plus the Schott GG13 filter."@en ;
    rdfs:subClassOf onto:BMagnitude,
        onto:MagnitudeAtMaximumBrightness ;
    ns2:reference ns2:Astrophysical_Techniques_chapter3 .

onto:BMagnitudeAtMinimumBrightness a owl:Class ;
    rdfs:label "B magnitude at minimum brightness"@en ;
    onto:commonlyHasUnit onto:magnitude,
        onto:one ;
    onto:symbol "B_min" ;
    rdfs:comment "Johnson B magnitude at minimum brightness (i.e. for a variable star). The Johnson B band is a standard filter in the blue area. The central wavelength is 440nm and the bandwidth is 100nm.  The filter to be used is the Corning 5030 filter plus the Schott GG13 filter."@en ;
    rdfs:subClassOf onto:BMagnitude,
        onto:MagnitudeAtMinimumBrightness ;
    ns2:reference ns2:Astrophysical_Techniques_chapter3 .

onto:BetaNarrowMagnitude a owl:Class ;
    rdfs:label "β_narrow magnitude"@en ;
    onto:alternativeSymbol "β_narrow" ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "β_n" ;
    rdfs:comment "β_narrow  Magnitude in the Strömgren-Crawford photometric system with a peak wavelength at 485.8 nm and a peak-half-width of 2.9 nm."@en ;
    rdfs:subClassOf onto:StroemgrenMagnitude ;
    ns2:reference ns2:Astrophysical_Techniques_chapter3,
        ns2:Crawford1958 .

onto:BetaWideMagnitude a owl:Class ;
    rdfs:label "β_wide magnitude"@en ;
    onto:alternativeSymbol "β_wide" ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "β_w" ;
    rdfs:comment "β_wide  Magnitude in the Strömgren-Crawford photometric system with a peak wavelength at 485 nm and a peak-half-width of 12.9 nm."@en ;
    rdfs:subClassOf onto:StroemgrenMagnitude ;
    ns2:reference ns2:Astrophysical_Techniques_chapter3,
        ns2:Crawford1958 .

onto:BolometricCorrection a owl:Class ;
    rdfs:label "bolometric correction"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "BC" ;
    rdfs:comment "The visual magnitude of an object minus its bolometric magnitude."@en ;
