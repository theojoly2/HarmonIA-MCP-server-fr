onto:Aberration a owl:Class ;
    rdfs:label "aberration"@en ;
    onto:commonlyHasUnit onto:degree,
        onto:microsecond-Angle,
        onto:millisecond-Angle,
        onto:second-Angle ;
    rdfs:comment "The apparent angular displacement of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en ;
    rdfs:subClassOf onto:AngularDisplacement ;
    ns2:reference ns2:Glossary_Astronomical_Almanac .

onto:AmountOfSubstance a owl:Class ;
    rdfs:label "amount of substance"@en ;
    onto:commonlyHasUnit onto:attomole,
        onto:centimole,
        onto:decamole,
        onto:decimole,
        onto:examole,
        onto:femtomole,
        onto:gigamole,
        onto:hectomole,
        onto:kilomole,
        onto:megamole,
        onto:micromole,
        onto:millimole,
        onto:mole,
        onto:nanomole,
        onto:petamole,
        onto:picomole,
        onto:teramole ;
    onto:symbol "n" ;
    rdfs:comment "Amount of substance is the number of elementary entities such as atoms, molecules, electrons, particles, etc. present in a phenomenon. It is a base quantity in the International System of Units."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AmountOfSubstanceUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:amountOfSubstance-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:Amplitude a owl:Class ;
    rdfs:label "amplitude"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    rdfs:comment "The difference between the maximum and minimum magnitudes of a variable star, i.e., the total range of its brightness."@en ;
    rdfs:subClassOf onto:Quantity .

onto:AngularSpeed a owl:Class ;
    rdfs:label "angular speed"@en ;
    onto:alternativeLabel "angular frequency"@en ;
    onto:alternativeSymbol "Ω" ;
    onto:commonlyHasUnit onto:millisecond-AnglePerYear,
        onto:radianPerSecond-Time ;
    onto:symbol "ω" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AngularSpeedUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:angularSpeed-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:Area a owl:Class ;
    rdfs:label "area"@en ;
    onto:alternativeSymbol "S" ;
    onto:commonlyHasUnit onto:acre-International,
        onto:acre-USSurvey,
        onto:are,
        onto:barn,
        onto:centiare,
        onto:circularMil,
        onto:hectare,
        onto:squareAttometre,
        onto:squareCentimetre,
        onto:squareDecametre,
        onto:squareDecimetre,
        onto:squareExametre,
        onto:squareFemtometre,
        onto:squareGigametre,
        onto:squareHectometre,
        onto:squareKilometre,
        onto:squareMegametre,
        onto:squareMetre,
        onto:squareMicrometre,
        onto:squareMillimetre,
        onto:squareNanometre,
        onto:squarePetametre,
        onto:squarePicometre,
        onto:squareTerametre ;
    onto:symbol "A" ;
    rdfs:comment "Area expresses the two-dimensional size of a defined part of a surface, typically a region bounded by a closed curve. It is a derived quantity in the International System of Units. Area is length squared."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:area-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:AreaUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:BMagnitude a owl:Class ;
    rdfs:label "B magnitude"@en ;
    onto:alternativeSymbol "m_B" ;
    onto:commonlyHasUnit onto:magnitude,
        onto:micromagnitude,
        onto:millimagnitude,
        onto:one ;
    onto:symbol "B" ;
    rdfs:comment "Johnson B magnitude. The Johnson B band is a standard filter in the blue area. The central wavelength is 440nm and the bandwidth is 100nm.  The filter to be used is the Corning 5030 filter plus the Schott GG13 filter."@en ;
    rdfs:subClassOf onto:JohnsonMagnitude ;
    ns2:reference ns2:Astrophysical_Techniques_chapter3 .

onto:BudStadium a owl:Class ;
    rdfs:label "bud stadium"@en ;
    onto:commonlyHasUnit onto:_1-5 ;
    rdfs:subClassOf onto:Quantity .

onto:CompoundUnit a owl:Class ;
    rdfs:label "compound unit"@en ;
    rdfs:subClassOf onto:Unit .

onto:CousinsMagnitude a owl:Class ;
    rdfs:label "Cousins magnitude"@en ;
    rdfs:comment "A magnitude measured in one of Cousins standard passbands (using a standard filter, i.e. I or R)."@en ;
    rdfs:subClassOf onto:Magnitude .

onto:DistanceModulus a owl:Class ;
    rdfs:label "distance modulus"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "m-M" ;
    rdfs:comment "The difference between the apparent magnitude (m) of an astronomical object, such as a star, and its absolute magnitude (M), used as a distance measurement. Distances can be expressed in distance modulii as $$m-M = 5\\\\log d + 10 = 10-5 log \\\\varpi$$ where \\\\(d\\\\) is the distance in kiloparsec and \\\\(\\\\varpi\\\\) is the parallax in milliarcseconds.\\n    "@en ;
    rdfs:subClassOf onto:Distance .

onto:DynamicViscosity a owl:Class ;
    rdfs:label "dynamic viscosity"@en ;
    onto:alternativeSymbol "η" ;
    onto:commonlyHasUnit onto:centipoise,
        onto:pascalSecond-Time,
        onto:poise ;
    onto:symbol "μ" ;
    onto:unofficialLabel "viscosity" ;
    rdfs:comment "Viscosity is the definite resistance to change of form of many materials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:dynamicViscosity-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:DynamicViscosityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:Extinction a owl:Class ;
    rdfs:label "extinction"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "A" ;
    rdfs:comment "Total extinction at a specific wavelength. The extinction is caused by dust and gas between a star and the observer. It is the difference between the observed magnitude and the magnitude the source would have had if no extinction had taken place."@en ;
    rdfs:subClassOf onto:Quantity .

onto:Illuminance a owl:Class ;
    rdfs:label "illuminance"@en ;
    onto:alternativeLabel "illumination"@en ;
    onto:alternativeSymbol "Φ_v" ;
    onto:commonlyHasUnit onto:attolux,
        onto:centilux,
        onto:decalux,
        onto:decilux,
        onto:exalux,
        onto:femtolux,
        onto:footcandle,
        onto:gigalux,
        onto:hectolux,
        onto:kilolux,
        onto:lumenPerSquareMetre,
        onto:lux,
        onto:megalux,
        onto:microlux,
        onto:millilux,
        onto:nanolux,
        onto:petalux,
        onto:phot,
        onto:picolux,
        onto:teralux ;
    onto:symbol "Φ" ;
    rdfs:comment "Illuminance is the total luminous flux incident on a surface per unit area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:IlluminanceUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:illuminance-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:Luminance a owl:Class ;
    rdfs:label "luminance"@en ;
    onto:alternativeSymbol "L_v" ;
    onto:commonlyHasUnit onto:candelaPerSquareCentimetre,
        onto:candelaPerSquareMetre,
        onto:footlambert,
        onto:lambert,
        onto:stilb ;
    onto:symbol "L" ;
    rdfs:comment "Luminous flux is the total visible energy emitted by a source per unit time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:luminance-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:LuminanceUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:LuminousIntensity a owl:Class ;
    rdfs:label "luminous intensity"@en ;
    onto:alternativeSymbol "I_v" ;
    onto:commonlyHasUnit onto:attocandela,
        onto:candela,
        onto:centicandela,
        onto:decacandela,
        onto:decicandela,
        onto:exacandela,
        onto:femtocandela,
        onto:gigacandela,
        onto:hectocandela,
        onto:kilocandela,
        onto:megacandela,
        onto:microcandela,
