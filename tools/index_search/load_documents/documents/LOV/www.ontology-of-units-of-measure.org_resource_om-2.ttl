        onto:pascal,
        onto:petapascal,
        onto:picopascal,
        onto:terapascal,
        onto:torr ;
    onto:symbol "E''" ;
    rdfs:subClassOf onto:DynamicModulus .

onto:LuminanceUnit a owl:Class ;
    rdfs:label "luminance unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:footlambert onto:lambert onto:stilb onto:candelaPerSquareMetre onto:candelaPerSquareCentimetre ) ] .

onto:LuminosityFunction a owl:Class ;
    rdfs:label "luminosity function"@en ;
    onto:commonlyHasUnit onto:reciprocalCubicParsec ;
    rdfs:comment "The number of stars of absolute magnitudes between Mv and Mv+ΔMv per cubic parsec."@en ;
    rdfs:subClassOf onto:NumberDensity .

onto:LuminousEfficacyUnit a owl:Class ;
    rdfs:label "luminous efficacy unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
