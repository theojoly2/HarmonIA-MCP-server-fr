        onto:nanogray,
        onto:petagray,
        onto:picogray,
        onto:rad,
        onto:teragray ;
    rdfs:subClassOf onto:AbsorbedDose .

onto:SpecificEnergyUnit a owl:Class ;
    rdfs:label "specific energy unit"@en ;
    rdfs:subClassOf onto:Unit ;
