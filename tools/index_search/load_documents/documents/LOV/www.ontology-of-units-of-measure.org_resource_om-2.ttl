onto:ColorAreaFraction a owl:Class ;
    rdfs:label "color area fraction"@en ;
    onto:alternativeLabel "color%"@en ;
    onto:commonlyHasUnit onto:percent ;
    rdfs:subClassOf onto:AreaFraction .

onto:ColumnNumberDensity a owl:Class ;
    rdfs:label "column number density"@en ;
    onto:commonlyHasUnit onto:reciprocalSquareCentimetre,
        onto:reciprocalSquareMetre ;
    onto:unofficialLabel "density",
        "number density" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:columnNumberDensity-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ColumnNumberDensityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:Coverage a owl:Class ;
    rdfs:label "coverage"@en ;
    onto:commonlyHasUnit onto:one,
        onto:partsPerMillion,
        onto:percent,
        onto:squareMetrePerSquareMetre ;
    rdfs:subClassOf onto:AreaFraction .

onto:Depth a owl:Class ;
    rdfs:label "depth"@en ;
    onto:commonlyHasUnit onto:angstrom,
        onto:astronomicalUnit,
        onto:attometre,
        onto:centimetre,
        onto:chain,
        onto:cicero,
        onto:decametre,
        onto:decimetre,
        onto:exametre,
        onto:fathom-USSurvey,
        onto:femtometre,
        onto:fermi,
        onto:foot-International,
        onto:foot-USSurvey,
        onto:furlong-International,
        onto:gigametre,
        onto:gigaparsec,
        onto:hectometre,
        onto:inch-International,
        onto:kilometre,
        onto:kiloparsec,
        onto:lightYear,
        onto:megametre,
        onto:megaparsec,
        onto:metre,
        onto:micrometre,
        onto:micron,
        onto:mil-Length,
        onto:mile-Statute,
        onto:mile-USSurvey,
        onto:millimetre,
        onto:nanometre,
        onto:nauticalMile-International,
        onto:parsec,
        onto:petametre,
        onto:pica-ATA,
        onto:pica-Postscript,
        onto:pica-TeX,
        onto:picometre,
        onto:point-ATA,
        onto:point-Didot,
        onto:point-Postscript,
        onto:point-TeX,
        onto:rod-US,
        onto:solarRadius,
        onto:terametre,
        onto:yard-International ;
    onto:symbol "d" ;
    rdfs:subClassOf onto:Length .

