ns2:Stroemgren1956 a ns1:Article ;
    dc:creator ns2:Brengt_Stroemgren ;
    dc:date "1956" ;
    dc:isPartOf ns2:VistasAstronomy ;
    dc:subject "Astronomy",
        "Distance Measurement" ;
    dc:title "Two-dimensional spectral classification of F stars through photoelectric photometry with interference filters" ;
    ns1:authorList ns2:Stroemgren1956Authors ;
    ns1:pageEnd "1346" ;
    ns1:pageStart "1336" ;
    ns1:uri "http://www.sciencedirect.com/science/article/pii/0083665656900605" ;
    ns1:volume "2" .

onto:AngularDisplacement a owl:Class ;
    rdfs:label "angular displacement"@en ;
    onto:commonlyHasUnit onto:attoradian,
        onto:centiradian,
        onto:deciradian,
        onto:degree,
        onto:femtoradian,
        onto:gon,
        onto:metrePerMetre,
        onto:microradian,
        onto:microsecond-Angle,
        onto:mil-Angle,
        onto:milliradian,
        onto:millisecond-Angle,
        onto:minute-Angle,
        onto:nanoradian,
        onto:picoradian,
        onto:radian,
        onto:revolution,
        onto:second-Angle ;
    rdfs:subClassOf onto:Angle .

onto:Capacitance a owl:Class ;
    rdfs:label "capacitance"@en ;
    onto:alternativeLabel "electric capacitance"@en ;
    onto:commonlyHasUnit onto:abfarad,
        onto:attofarad,
        onto:centifarad,
        onto:coulombPerVolt,
        onto:decafarad,
        onto:decifarad,
        onto:exafarad,
        onto:farad,
        onto:femtofarad,
        onto:gigafarad,
        onto:hectofarad,
        onto:kilofarad,
        onto:megafarad,
        onto:microfarad,
        onto:millifarad,
        onto:nanofarad,
        onto:petafarad,
        onto:picofarad,
        onto:statfarad,
        onto:terafarad ;
    onto:symbol "C" ;
    rdfs:comment "Capacitance is the ability to hold electrical charge. It is a derived quantity in the International System of Units. Capacitance is electric charge divided by electric potential."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:CapacitanceUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:capacitance-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:DensityParameter a owl:Class ;
    rdfs:label "density parameter"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Ω" ;
    rdfs:comment "Ratio of the average density and the critical density."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
