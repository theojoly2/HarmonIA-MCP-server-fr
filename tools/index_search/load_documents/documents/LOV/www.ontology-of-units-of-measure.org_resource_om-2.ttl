    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent 1 ;
    onto:symbol "T" .

onto:milli a onto:SIPrefix ;
    rdfs:label "milli"@en ;
    onto:hasFactor "0.001"^^xsd:float ;
    onto:symbol "m" .

onto:pressure-Dimension a onto:Dimension ;
    rdfs:label "pressure dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent -1 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 1 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent -2 .

onto:volt a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "volt"@en ;
    onto:hasDimension onto:electricPotential-Dimension ;
    onto:hasUnit onto:wattPerAmpere ;
    onto:longcomment "The volt is a unit of electric potential defined as watt divided by ampere = joule divided by coulomb = newton times metre divided by ampere times second = kilogram times square metre divided by ampere times second to the power 3. The volt is a derived unit in the International System of Units." ;
    onto:symbol "V" ;
    rdfs:comment "The volt is a unit of electric potential defined as watt divided by ampere = joule divided by coulomb = newton times metre divided by ampere times second = kilogram times square metre divided by ampere times second to the power 3."@en .

onto:FixedPoint a owl:Class ;
    rdfs:label "fixed point"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( onto:FixedPoint ) ] ;
            owl:onProperty onto:hasPoint ],
        onto:Point .

onto:newton a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "newton"@en ;
    onto:hasDimension onto:force-Dimension ;
    onto:hasUnit onto:metreKilogramPerSecond-TimeSquared ;
    onto:longcomment "The newton is a unit of force defined as kilogram times metre divided by second squared. The newton is a derived unit in the International System of Units." ;
    onto:symbol "N" ;
    rdfs:comment "The newton is a unit of force defined as kilogram timesmetre divided by second squared."@en .

onto:squareMetre a onto:UnitExponentiation ;
    rdfs:label "square metre"@en ;
    onto:hasBase onto:metre ;
    onto:hasDimension onto:area-Dimension ;
    onto:hasExponent 2 ;
    onto:longcomment "Square metre is a unit of area defined as the area of a square whose sides measure exactly one metre. Square metre is a derived unit in the International System of Units." ;
    onto:symbol "m2" ;
    rdfs:comment "Square metre is a unit of area defined as the area of a square whose sides measure exactly one metre."@en .

onto:ampere a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "ampere"@en ;
    onto:hasDimension onto:electricCurrent-Dimension ;
    onto:hasQuantity onto:constantCurrentThatProducesAnAttractiveForceOf2e-7NewtonPerMetreOfLengthBetweenTwoStraightParallelConductorsOfInfiniteLengthAndNegligibleCircularCrossSectionPlacedOneMetreApartInAVacuum ;
    onto:longcomment "The ampere is a unit of electric current defined as the constant current that produces an attractive force of 2e–7 newton per metre of length between two straight, parallel conductors of infinite length and negligible circular cross section placed one metre apart in a vacuum. The ampere is a base unit in the International System of Units." ;
    onto:symbol "A" ;
    rdfs:comment "The ampere is a unit of electric current defined as the constant current that produces an attractive force of 2e–7 newton per metre of length between two straight, parallel conductors of infinite length and negligible circular cross section placed one metre apart in a vacuum."@en .

onto:thermodynamicTemperature-Dimension a onto:Dimension ;
    rdfs:label "thermodynamic temperature dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 0 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 0 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 1 ;
    onto:hasSITimeDimensionExponent 0 ;
    onto:symbol "Θ" .

onto:centimetre a onto:PrefixedUnit ;
    rdfs:label "centimetre"@en ;
    onto:hasDimension onto:length-Dimension ;
    onto:hasPrefix onto:centi ;
    onto:hasUnit onto:metre ;
    onto:symbol "cm" ;
    rdfs:comment "The centimetre is a unit of length defined as 1.0e-2 metre."@en .

onto:acceleration-Dmension a onto:Dimension ;
    rdfs:label "acceleration dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 1 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 0 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent -2 .

onto:mass-Dimension a onto:Dimension ;
    rdfs:label "mass dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 0 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 1 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent 0 ;
    onto:symbol "M" .

onto:cubicMetre a onto:UnitExponentiation ;
    rdfs:label "cubic metre"@en ;
    onto:hasBase onto:metre ;
    onto:hasDimension onto:volume-Dimension ;
    onto:hasExponent 3 ;
    onto:longcomment "Cubic metre is a unit of volume defined as the volume of a cube whose sides measure exactly one metre. Cubic metre is a derived unit in the International System of Units." ;
    onto:symbol "m3" ;
    rdfs:comment "Cubic metre is a unit of volume defined as the volume of a cube whose sides measure exactly one metre."@en .

onto:UnitMultiplication a owl:Class ;
    rdfs:label "unit multiplication"@en ;
    rdfs:subClassOf onto:CompoundUnit .

onto:kelvin a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "kelvin"@en ;
    onto:hasDimension onto:thermodynamicTemperature-Dimension ;
    onto:hasQuantity onto:_127316OfTheThermodynamicTemperatureOfTheTriplePointOfWater ;
    onto:longcomment "The kelvin is a unit of temperature defined as 1/273.16 of the thermodynamic temperature of the triple point of water. The kelvin is a base unit in the International System of Units." ;
    onto:symbol "K" ;
    rdfs:comment "The kelvin is a unit of temperature defined as 1/273.16 of the thermodynamic temperature of the triple point of water."@en .

onto:pascal a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "pascal"@en ;
    onto:hasDimension onto:pressure-Dimension ;
    onto:hasUnit onto:newtonPerSquareMetre ;
    onto:longcomment "The pascal is a unit of pressure and stress defined as newton divided by square metre = joule divided by cubic metre = kilogram divided by metre second squared. The pascal is a derived unit in the International System of Units." ;
    onto:symbol "Pa" ;
    rdfs:comment "The pascal is a unit of pressure and stress defined as newton divided by square metre = joule divided by cubic metre = kilogram divided by metre second squared."@en .

onto:speed-Dimension a onto:Dimension ;
    rdfs:label "speed dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 1 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 0 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent -1 .

onto:density-Dimension a onto:Dimension ;
    rdfs:label "density dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent -3 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 1 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent 0 .

onto:frequency-Dimension a onto:Dimension ;
    rdfs:label "frequency dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 0 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 0 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent -1 .

onto:specificEnergyOrAbsorbedDoseOrDoseEquivalent-Dimension a onto:Dimension ;
    rdfs:label "specific energy, absorbed dose, or dose equivalent dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 2 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 0 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent -2 .

onto:energy-Dimension a onto:Dimension ;
    rdfs:label "energy dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 2 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 1 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent -2 .

onto:length-Dimension a onto:Dimension ;
    rdfs:label "length dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 1 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 0 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent 0 ;
    onto:symbol "L" .

onto:kilogram a onto:PrefixedUnit ;
    rdfs:label "kilogram"@en ;
    onto:hasDimension onto:mass-Dimension ;
    onto:hasPrefix onto:kilo ;
    onto:hasQuantity onto:massOfTheInternationalPrototypeOfTheKilogram ;
    onto:hasUnit onto:gram ;
    onto:longcomment "The kilogram is a unit of mass defined as the mass of the international prototype of the kilogram. The kilogram is a base unit in the International System of Units." ;
    onto:symbol "kg" ;
    rdfs:comment "The kilogram is a unit of mass defined as the mass of the international prototype of the kilogram."@en .

onto:percent a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "percent"@en ;
    onto:LaTeXSymbol "\\\\%" ;
    onto:hasDimension onto:dimensionOne ;
    onto:hasFactor "0.01"^^xsd:float ;
    onto:hasUnit onto:one ;
    onto:symbol "%" ;
    rdfs:comment "The percent is a unit of dimension one defined as 1/100."@en .

onto:magnitude a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "magnitude"@en ;
    onto:hasDimension onto:dimensionOne ;
    onto:hasUnit onto:one ;
    onto:symbol "mag" ;
    rdfs:comment "Eenheid waarmee de helderheid van sterren wordt aangegeven. Meestal wordt het symbool niet aangeduid (http://en.wikipedia.org/wiki/Magnitude_(astronomy))."@en .

onto:SIPrefix a owl:Class ;
    rdfs:label "SI prefix"@en ;
    rdfs:subClassOf onto:Prefix .

onto:watt a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "watt"@en ;
    onto:hasDimension onto:power-Dimension ;
    onto:hasUnit onto:joulePerSecond-Time ;
    onto:longcomment "The watt is a unit of power defined as joule divided by second = newton times metre divided by second = volt times ampere = kilogram times square metre divided by second to the power 3. The watt is a derived unit in the International System of Units." ;
    onto:symbol "W" ;
    rdfs:comment "The watt is a unit of power defined as joule divided by second = newton times metre divided by second = volt times ampere = kilogram times square metre divided by second to the power 3."@en .

onto:amountOfSubstanceConcentration-Dimension a onto:Dimension ;
    rdfs:label "amount of substance concentration dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 1 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent -3 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 0 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent 0 .

onto:joule a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "joule"@en ;
    onto:hasDimension onto:energy-Dimension ;
    onto:hasUnit onto:newtonMetre ;
    onto:longcomment "The joule is a unit of energy defined as kilogram times square metre divided by second squared. The joule is a derived unit in the International System of Units." ;
    onto:symbol "J" ;
    rdfs:comment "The joule is a unit of energy defined as kilogram times square metre divided by second squared."@en .

onto:volume-Dimension a onto:Dimension ;
    rdfs:label "volume dimension"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 3 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 0 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent 0 .

onto:litre a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "litre"@en ;
    onto:alternativeLabel "liter"@en ;
    onto:alternativeSymbol "L" ;
    onto:hasDimension onto:volume-Dimension ;
    onto:hasFactor "0.001"^^xsd:float ;
    onto:hasUnit onto:cubicMetre ;
    onto:symbol "l" ;
    rdfs:comment "The litre is a unit of volume defined as 1.0e-3 cubic metre."@en .

onto:hasPrefix a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has prefix"@en ;
    rdfs:domain onto:PrefixedUnit ;
    rdfs:range onto:Prefix .

onto:mole a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "mole"@en ;
    onto:hasDimension onto:amountOfSubstance-Dimension ;
    onto:hasQuantity onto:amountOfSubstanceOfASystemThatContainsAsManyElementaryEntitiesAsThereAreAtomsIn0.012KilogramOfCarbon12 ;
    onto:longcomment "The mole is a unit of amount of substance defined as the amount of substance of a system that contains as many elementary entities as there are atoms in 0.012 kilogram of carbon 12. The mole is a base unit in the International System of Units." ;
    onto:symbol "mol" ;
    rdfs:comment "The mole is a unit of amount of substance defined as the amount of substance of a system that contains as many elementary entities as there are atoms in 0.012 kilogram of carbon 12."@en .

onto:gram a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "gram"@en ;
    onto:hasDimension onto:mass-Dimension ;
    onto:hasFactor "0.001"^^xsd:float ;
    onto:hasUnit onto:kilogram ;
    onto:symbol "g" ;
    rdfs:comment "The gram is a unit of mass defined as 1.0e-3 kilogram."@en .

onto:Dimension a owl:Class ;
    rdfs:label "dimension"@en ;
    rdfs:comment "Dimensions are abstract properties of units and quantities neglecting their vectorial or tensorial character and all numerical factors including their sign."@en .

onto:second-Time a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "second"@en ;
    onto:hasDimension onto:time-Dimension ;
    onto:hasQuantity onto:durationOf9192631770PeriodsOfTheRadiationCorrespondingToTheTransitionBetweenTheTwoHyperfineLevelsOfTheGroundStateOfTheCesium133Atom ;
    onto:longcomment "The second is a unit of time defined as the duration of 9 192 631 770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the cesium 133 atom. The second is a base unit in the International System of Units." ;
    onto:symbol "s" ;
    onto:unofficialAbbreviation "sec" ;
    rdfs:comment "The second is a unit of time defined as the duration of 9 192 631 770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the cesium 133 atom."@en .

onto:dimensionOne a onto:Dimension ;
    rdfs:label "dimensionOne"@en ;
    onto:hasSIAmountOfSubstanceDimensionExponent 0 ;
    onto:hasSIElectricCurrentDimensionExponent 0 ;
    onto:hasSILengthDimensionExponent 0 ;
    onto:hasSILuminousIntensityDimensionExponent 0 ;
    onto:hasSIMassDimensionExponent 0 ;
    onto:hasSIThermodynamicTemperatureDimensionExponent 0 ;
    onto:hasSITimeDimensionExponent 0 ;
    onto:symbol "1" .

onto:hasDimension a owl:ObjectProperty ;
    rdfs:label "has dimension"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Quantity onto:Unit onto:Scale ) ] ;
    rdfs:range onto:Dimension .

onto:metre a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "metre"@en ;
    onto:alternativeLabel "meter"@en ;
    onto:hasDimension onto:length-Dimension ;
    onto:hasQuantity onto:lengthOfThePathTravelledByLightInVacuumDuringATimeIntervalOf1299792458OfASecond ;
    onto:longcomment "The metre is a unit of length defined as the length of the path travelled by light in vacuum during a time interval of 1/299 792 458 of a second. The metre is a base unit in the International System of Units." ;
    onto:symbol "m" ;
    rdfs:comment "The metre is a unit of length defined as the length of the path travelled by light in vacuum during a time interval of 1/299 792 458 of a second."@en .

onto:hasValue a owl:ObjectProperty ;
    rdfs:label "has value"@en ;
    rdfs:domain onto:Quantity ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:Measure onto:Point ) ] .

onto:UnitDivision a owl:Class ;
    rdfs:label "unit division"@en ;
    rdfs:subClassOf onto:CompoundUnit .

onto:Quantity a owl:Class ;
    rdfs:label "quantity"@en ;
    rdfs:comment "A quantity is a representation of a quantifiable (standardised) aspect (such as length, mass, and time) of a phenomenon (e.g., a star, a molecule, or a food product). Quantities are classified according to similarity in their (implicit) metrological aspect, e.g. the length of my table and the length of my chair are both classified as length."@en .

onto:one a onto:SingularUnit,
        onto:Unit ;
    rdfs:label "one"@en ;
    onto:alternativeLabel "unit one"@en ;
    onto:hasDimension onto:dimensionOne ;
    onto:symbol "1" ;
    rdfs:comment "Unit one is a unit of dimension one."@en .

onto:hasUnit a owl:ObjectProperty ;
    rdfs:label "has unit"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PrefixedUnit onto:UnitMultiple onto:SingularUnit onto:IntervalScale onto:RatioScale onto:Measure ) ] ;
    rdfs:range onto:Unit .

onto:SingularUnit a owl:Class ;
    rdfs:label "singular unit"@en ;
    rdfs:subClassOf onto:Unit .

onto:Unit a owl:Class ;
    rdfs:label "unit"@en ;
    onto:alternativeLabel "unit of measure"@en,
        "unit of measurement"@en ;
    rdfs:comment "A unit of measure is a definite magnitude of a quantity, defined and adopted by convention or by law. It is used as a standard for measurement of the same quantity, where any other value of the quantity can be expressed as a simple multiple of the unit. For example, length is a quantity; the metre is a unit of length that represents a definite predetermined length. When we say 10 metre (or 10 m), we actually mean 10 times the definite predetermined length called \"metre\"."@en .

onto:PrefixedUnit a owl:Class ;
    rdfs:label "prefixed unit"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom onto:SingularUnit ;
            owl:onProperty onto:hasUnit ],
        onto:Unit .

