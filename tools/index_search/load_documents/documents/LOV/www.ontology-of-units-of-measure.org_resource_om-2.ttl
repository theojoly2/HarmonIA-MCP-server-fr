    rdfs:subClassOf onto:MagnitudeAtMaximumBrightness,
        onto:VMagnitude ;
    ns2:reference ns2:Astrophysical_Techniques_chapter3 .

onto:VMagnitudeAtMinimumBrightness a owl:Class ;
