    rdfs:subClassOf onto:Time .

onto:DynamicRange a owl:Class ;
    rdfs:label "dynamic range"@en ;
    onto:commonlyHasUnit onto:one ;
    rdfs:comment "Ratio between the saturation output and the dark signal, sometimes only over the region of linearity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:DynamicRangeUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
