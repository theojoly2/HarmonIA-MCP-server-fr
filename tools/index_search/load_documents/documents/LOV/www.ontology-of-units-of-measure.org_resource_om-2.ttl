    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:atmosphere-Standard onto:atmosphere-Technical onto:bar onto:barye onto:metreOfMercury onto:pascal onto:torr onto:decibar onto:microbar onto:millibar onto:centimetreOfMercury onto:millimetreOfMercury onto:kilogramSecond-TimeToThePower-2ReciprocalMetre onto:newtonPerSquareMetre ) ] onto:PrefixedPascal ) ] .

onto:SurfaceTension a owl:Class ;
    rdfs:label "surface tension"@en ;
    onto:alternativeSymbol "σ" ;
    onto:commonlyHasUnit onto:newtonPerMetre ;
    onto:symbol "γ" ;
    rdfs:comment "Surface tension is an attractive property of the surface of a liquid."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:surfaceTension-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:SurfaceTensionUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:SymbolRate a owl:Class ;
    rdfs:label "symbol rate"@en ;
    onto:alternativeLabel "baud rate"@en,
        "modulation rate"@en ;
    onto:commonlyHasUnit onto:baud ;
    rdfs:comment "Symbol rate is the number of symbol changes (signalling events) made to the transmission medium per second using a digitally modulated signal or a line code."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:SymbolRateUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:ThuanAndGunnMagnitude a owl:Class ;
    rdfs:label "Thuan and Gunn magnitude"@en ;
    rdfs:comment "A magnitude measured in one of Thuan and Gunn's standard passbands (using a standard filter, i.e. g)."@en ;
    rdfs:subClassOf onto:Magnitude .

onto:Torque a owl:Class ;
    rdfs:label "torque"@en ;
    onto:commonlyHasUnit onto:micronewtonMetre,
        onto:millinewtonMetre,
        onto:newtonMetre ;
    onto:symbol "T" ;
    rdfs:comment "Torque is the effectiveness of a force to produce rotation about an axis, measured by the product of the force and the perpendicular distance from the line of action of the force to the axis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:energy-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:TorqueUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:VolumeFraction a owl:Class ;
    rdfs:label "volume fraction"@en ;
    onto:alternativeLabel "concentration (v/v)"@en ;
    onto:commonlyHasUnit onto:cubicCentimetrePerCubicCentimetre,
        onto:cubicMetrePerCubicmetre,
        onto:cubicMillimetrePerCubicMillimetre,
        onto:one,
        onto:partsPerMillion,
        onto:percent ;
    onto:symbol "φ" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:VolumeFractionUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:Wavenumber a owl:Class ;
    rdfs:label "wavenumber"@en ;
    onto:commonlyHasUnit onto:kayser,
        onto:reciprocalMetre ;
    onto:symbol "σ" ;
    rdfs:comment "Wavenumber is the number of repeating units of a propagating wave (the number of times a wave has the same phase) per unit of space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:WavenumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:wavenumber-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

