        onto:terajoule,
        onto:terawattHour,
        onto:therm-EC,
        onto:therm-US,
        onto:tonOfTNT,
        onto:wattHour ;
    onto:symbol "E_k" ;
    rdfs:comment "Kinetic energy is energy due to motion."@en ;
    rdfs:subClassOf onto:Energy .

onto:KnudsenNumber a owl:Class ;
    rdfs:label "Knudsen number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Kn" ;
    rdfs:comment "The Knudsen number is a dimensionless number defined as the ratio of the molecular mean free path length to a representative physical length scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:KnudsenNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:KnudsenNumberUnit a owl:Class ;
    rdfs:label "Knudsen number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:LabelMass a owl:Class ;
    rdfs:label "label mass"@en ;
    onto:commonlyHasUnit onto:gram,
        onto:kilogram,
        onto:tonne ;
    onto:unofficialLabel "label weight" ;
    rdfs:subClassOf onto:Mass .

onto:LewisNumber a owl:Class ;
    rdfs:label "Lewis number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Le" ;
    rdfs:comment "The Lewis number is a dimensionless number defined as the ratio of thermal diffusivity to mass diffusivity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:LewisNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:LewisNumberUnit a owl:Class ;
    rdfs:label "Lewis number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:LightTime a owl:Class ;
    rdfs:label "light time"@en ;
    onto:commonlyHasUnit onto:second-Time ;
    onto:symbol "τ" ;
    rdfs:comment "The time electromagnetic radiation takes to reach Earth from a distant source. Often the correction in light time is needed to accurately calculate the apparent position of solar system objects or to calculate the period of variable stars (different times are observed when the Earth is at a different position in its orbit)."@en ;
    rdfs:subClassOf onto:Time .

onto:LimitingMagnitude a owl:Class ;
    rdfs:label "limiting magnitude"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    rdfs:comment "The magnitude of the faintest object (star) that can be detected by a telescope or other instrument. Depends not only on the telescope but also on the detector and on the observing method."@en ;
    rdfs:subClassOf onto:Magnitude .

onto:LinearStrain a owl:Class ;
    rdfs:label "linear strain"@en ;
    onto:alternativeSymbol "e" ;
    onto:commonlyHasUnit onto:one,
        onto:percent ;
    rdfs:subClassOf onto:Strain .

onto:Lipophilicity a owl:Class ;
    rdfs:label "lipophilicity"@en ;
    rdfs:subClassOf onto:Quantity .

onto:LossModulus a owl:Class ;
    rdfs:label "loss modulus"@en ;
    onto:commonlyHasUnit onto:atmosphere-Standard,
        onto:atmosphere-Technical,
        onto:attopascal,
