                        owl:oneOf ( onto:abohm onto:ohm onto:statohm onto:voltPerAmpere ) ] onto:PrefixedOhm ) ] .

onto:ElectricalResistivityUnit a owl:Class ;
    rdfs:label "electrical resistivity unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:ohmMetre ) ] .

onto:ElectromotiveForce a owl:Class ;
    rdfs:label "electromotive force"@en ;
    onto:alternativeSymbol "emf" ;
    onto:commonlyHasUnit onto:abvolt,
        onto:attovolt,
        onto:centivolt,
        onto:decavolt,
        onto:decivolt,
        onto:exavolt,
        onto:femtovolt,
        onto:gigavolt,
        onto:hectovolt,
        onto:kilovolt,
        onto:megavolt,
        onto:microvolt,
