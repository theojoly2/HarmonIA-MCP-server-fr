onto:BrightnessTemperature a owl:Class ;
    rdfs:label "brightness temperature"@en ;
    onto:commonlyHasUnit onto:kelvin ;
    rdfs:comment "The temperature that a blackbody would need to have in order to emit radiation of the observed intensity at a given wavelength (mostly used in radio astronomy)."@en ;
    rdfs:subClassOf onto:ThermodynamicTemperature .

onto:BulkModulus a owl:Class ;
    rdfs:label "bulk modulus"@en ;
    onto:alternativeSymbol "κ" ;
    onto:commonlyHasUnit onto:atmosphere-Standard,
