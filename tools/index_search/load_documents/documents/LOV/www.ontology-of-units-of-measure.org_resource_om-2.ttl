            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MolarEntropyUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:MolarEntropyUnit a owl:Class ;
    rdfs:label "molar entropy unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:joulePerKelvinMole ) ] .

onto:MolarHeatCapacityUnit a owl:Class ;
    rdfs:label "molar heat capacity unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:joulePerKelvinMole ) ] .

onto:MolarMassUnit a owl:Class ;
    rdfs:label "molar mass unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:kilogramPerMole ) ] .

onto:MolarVolume a owl:Class ;
    rdfs:label "molar volume"@en ;
    onto:commonlyHasUnit onto:cubicMetrePerMole,
        onto:litrePerMole ;
