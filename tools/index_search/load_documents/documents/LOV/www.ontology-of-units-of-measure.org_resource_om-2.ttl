        onto:pascal,
        onto:petapascal,
        onto:picopascal,
        onto:terapascal,
        onto:torr ;
    onto:symbol "τ" ;
    rdfs:comment "Shear stress is a stress that is applied parallel or tangential to a face of a material."@en ;
    rdfs:subClassOf onto:Stress .

onto:SolidAngleUnit a owl:Class ;
    rdfs:label "solid angle unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
