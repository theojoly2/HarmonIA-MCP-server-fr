        onto:hectojoule,
        onto:joule,
        onto:kilocalorie-Mean,
        onto:kiloelectronvolt,
        onto:kilojoule,
        onto:kilowattHour,
        onto:megaelectronvolt,
        onto:megaerg,
        onto:megajoule,
        onto:microjoule,
        onto:micronewtonMetre,
        onto:millijoule,
        onto:millinewtonMetre,
        onto:nanojoule,
        onto:newtonMetre,
        onto:petajoule,
        onto:picojoule,
        onto:quad,
        onto:terajoule,
        onto:terawattHour,
        onto:therm-EC,
        onto:therm-US,
        onto:tonOfTNT,
        onto:wattHour ;
    onto:symbol "H" ;
    rdfs:comment "Enthalpy is the sum of the internal energy of a system plus the product of the pressure-volume work done on the system."@en ;
    rdfs:subClassOf onto:Energy .

onto:Entropy a owl:Class ;
    rdfs:label "entropy"@en ;
    onto:commonlyHasUnit onto:joulePerKelvin ;
    onto:symbol "S" ;
    rdfs:comment "Entropy is a measure of the unavailability of a system’s energy to do work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:EntropyUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:entropyOrHeatCapacity-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:EntropyUnit a owl:Class ;
    rdfs:label "entropy unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:joulePerKelvin ) ] .

onto:EpochAtMaximumBrightness a owl:Class ;
    rdfs:label "epoch at maximum brightness"@en ;
    onto:commonlyHasUnit onto:second-Time,
        onto:year ;
    rdfs:comment "A moment when the object (i.e. a variable star) was at maximum brightness."@en ;
    rdfs:subClassOf onto:Epoch .

onto:EulerNumber a owl:Class ;
    rdfs:label "Euler number"@en ;
    onto:commonlyHasUnit onto:one ;
    onto:symbol "Eu" ;
    rdfs:comment "The Euler number is a dimensionless number that expresses the relationship between a local pressure drop e.g. over a restriction and the kinetic energy per unit volume."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:dimensionOne ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:EulerNumberUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:EulerNumberUnit a owl:Class ;
    rdfs:label "Euler number unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:one ) ] .

onto:ExposureToXAndGammaRays a owl:Class ;
    rdfs:label "exposure to x and γ rays"@en ;
    onto:alternativeLabel "exposure"@en,
        "exposure (to x and gamma rays)"@en,
        "exposure (to x and γ rays)"@en,
        "exposure to x and gamma rays"@en ;
    onto:commonlyHasUnit onto:coulombPerKilogram,
        onto:röntgen ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:ExposureToXAndGammaRaysUnit ;
                    owl:onProperty onto:hasUnit ] ;
