    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:rem onto:sievert onto:joulePerKilogram onto:kilojoulePerHectogram ) ] onto:PrefixedSievert ) ] .

onto:DryMass a owl:Class ;
    rdfs:label "dry mass"@en ;
    onto:commonlyHasUnit onto:gram,
        onto:kilogram,
        onto:tonne ;
    onto:unofficialLabel "dry weight" ;
    rdfs:subClassOf onto:Mass .

onto:Duration a owl:Class ;
    rdfs:label "duration"@en ;
    onto:commonlyHasUnit onto:attosecond-Time,
        onto:centisecond-Time,
