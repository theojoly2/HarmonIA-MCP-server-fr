        onto:decihenry,
        onto:exahenry,
        onto:femtohenry,
        onto:gigahenry,
        onto:hectohenry,
        onto:henry,
        onto:kilohenry,
        onto:megahenry,
        onto:microhenry,
        onto:millihenry,
        onto:nanohenry,
        onto:petahenry,
        onto:picohenry,
        onto:stathenry,
        onto:terahenry,
        onto:weberPerAmpere ;
    rdfs:comment "Inductance is that property in an electrical circuit where a change in the current flowing through that circuit induces an electromotive force that opposes the change in current."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:inductanceOrPermeance-Electromagnetic-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:InductanceUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:MagneticFlux a owl:Class ;
    rdfs:label "magnetic flux"@en ;
    onto:commonlyHasUnit onto:attoweber,
        onto:centiweber,
        onto:decaweber,
        onto:deciweber,
        onto:exaweber,
        onto:femtoweber,
        onto:gigaweber,
        onto:hectoweber,
        onto:kiloweber,
        onto:maxwell,
        onto:megaweber,
        onto:microweber,
        onto:milliweber,
        onto:nanoweber,
        onto:petaweber,
        onto:picoweber,
        onto:statweber,
        onto:teraweber,
        onto:unitPole,
        onto:voltSecond-Time,
        onto:weber ;
    onto:symbol "Φ" ;
    rdfs:comment "Magnetic flux through any area perpendicular to a magnetic field is the product of the area by the field strength."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:magneticFlux-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MagneticFluxUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:MagneticFluxDensity a owl:Class ;
    rdfs:label "magnetic flux density"@en ;
    onto:alternativeLabel "magnetic field"@en,
        "magnetic induction"@en ;
    onto:commonlyHasUnit onto:attotesla,
        onto:centitesla,
        onto:decatesla,
        onto:decitesla,
        onto:exatesla,
        onto:femtotesla,
        onto:gamma,
        onto:gauss,
        onto:gigatesla,
        onto:hectotesla,
        onto:kilotesla,
        onto:megatesla,
        onto:microtesla,
        onto:milligauss,
        onto:millitesla,
        onto:nanotesla,
        onto:petatesla,
        onto:picotesla,
        onto:stattesla,
        onto:teratesla,
        onto:tesla,
        onto:weberPerSquareMetre ;
    onto:symbol "B" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MagneticFluxDensityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:magneticFluxDensity-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:MagnetomotiveForce a owl:Class ;
    rdfs:label "magnetomotive force"@en ;
    onto:commonlyHasUnit onto:ampere,
        onto:attoampere,
        onto:centiampere,
        onto:decaampere,
        onto:deciampere,
        onto:exaampere,
