onto:HubbleConstantAtPresentEpoch a owl:Class ;
    rdfs:label "Hubble constant at present epoch"@en ;
    onto:commonlyHasUnit onto:kilometrePerSecond-TimePerMegaparsec,
        onto:metrePerSecond-TimePerMetre ;
    onto:symbol "H_0" ;
    rdfs:comment "The Hubble constant at the present epoch (a constant)."@en ;
    rdfs:subClassOf onto:HubbleConstant .

onto:HubbleConstantUnit a owl:Class ;
    rdfs:label "Hubble constant unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( onto:kilometrePerSecond-TimePerMegaparsec onto:metrePerSecond-TimePerMetre ) ] .

onto:Hydrophilicity a owl:Class ;
    rdfs:label "hydrophilicity"@en ;
    rdfs:subClassOf onto:Quantity .

onto:Hydrophobicity a owl:Class ;
    rdfs:label "hydrophobicity"@en ;
    rdfs:subClassOf onto:Quantity .

onto:IMagnitude a owl:Class ;
    rdfs:label "I magnitude"@en ;
    onto:alternativeSymbol "m_I" ;
    onto:commonlyHasUnit onto:magnitude ;
    onto:symbol "I" ;
    rdfs:comment "I magnitude in the Cousins photometric system."@en ;
    rdfs:subClassOf onto:CousinsMagnitude .

onto:IlluminanceUnit a owl:Class ;
    rdfs:label "illuminance unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:footcandle onto:lux onto:phot onto:lumenPerSquareMetre ) ] onto:PrefixedLux ) ] .

onto:Impulse a owl:Class ;
    rdfs:label "impulse"@en ;
    onto:symbol "I" ;
    rdfs:comment "Impulse is the integral of a force with respect to time."@en ;
    rdfs:subClassOf onto:Quantity .

onto:InductanceUnit a owl:Class ;
    rdfs:label "inductance unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:abhenry onto:henry onto:stathenry onto:weberPerAmpere ) ] onto:PrefixedHenry ) ] .

onto:InformationCapacityUnit a owl:Class ;
    rdfs:label "information capacity unit"@en ;
    rdfs:subClassOf onto:Unit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:bit onto:byte onto:hartley onto:shannon ) ] onto:PrefixedBit onto:PrefixedByte ) ] .

onto:InitialMassFunction a owl:Class ;
    rdfs:label "initial mass function"@en ;
    onto:commonlyHasUnit onto:reciprocalCubicParsec ;
    onto:symbol "IMF" ;
    rdfs:comment "The number of stars in mass fraction dM around mass M. Used in Salpeter's Initial Mass Function (IMF)."@en ;
    rdfs:subClassOf onto:NumberDensity .

onto:IntegratedMagnitude a owl:Class ;
    rdfs:label "integrated magnitude"@en ;
    onto:commonlyHasUnit onto:magnitude ;
    rdfs:comment "The apparent magnitude that an extended object, such as a nebula or galaxy, would have if all its light were concentrated at a starlike point."@en ;
    rdfs:subClassOf onto:Magnitude .

onto:InternalEnergy a owl:Class ;
    rdfs:label "internal energy"@en ;
    onto:commonlyHasUnit onto:BritishThermalUnit-39F,
        onto:BritishThermalUnit-59F,
        onto:BritishThermalUnit-60F,
        onto:BritishThermalUnit-InternationalTable,
        onto:BritishThermalUnit-Mean,
        onto:BritishThermalUnit-Thermochemical,
        onto:attojoule,
        onto:calorie-15C,
        onto:calorie-20C,
        onto:calorie-InternationalTable,
        onto:calorie-Mean,
        onto:calorie-Thermochemical,
        onto:centijoule,
        onto:decajoule,
        onto:decijoule,
        onto:electronvolt,
        onto:erg,
        onto:exajoule,
