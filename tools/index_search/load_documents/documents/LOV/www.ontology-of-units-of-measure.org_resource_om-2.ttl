onto:DryBodyMass a owl:Class ;
    rdfs:label "dry body mass"@en ;
    onto:commonlyHasUnit onto:gram,
        onto:kilogram,
        onto:tonne ;
    onto:unofficialLabel "dry body weight" ;
    rdfs:subClassOf onto:DryMass .

onto:DryMatterMassFraction a owl:Class ;
    rdfs:label "dry matter mass fraction"@en ;
    onto:commonlyHasUnit onto:gramPerGram,
        onto:one,
        onto:percent ;
    rdfs:comment "The fraction of the mass of dry matter in a phenomenon"@en ;
    rdfs:subClassOf onto:MassFraction .

onto:EggMassFraction a owl:Class ;
    rdfs:label "egg mass fraction"@en ;
    onto:commonlyHasUnit onto:gramPerGram,
        onto:one,
        onto:percent ;
    rdfs:comment "The fraction of the mass of egg in a phenomenon"@en ;
    rdfs:subClassOf onto:MassFraction .

onto:EnergyDensity a owl:Class ;
    rdfs:label "energy density"@en ;
    onto:commonlyHasUnit onto:joulePerCubicmetre ;
    rdfs:comment "Energy density is the amount of energy stored in a given system or region of space per unit volume."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:EnergyDensityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:energyDensity-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:ExternalBrowning a owl:Class ;
    rdfs:label "external browning"@en ;
    onto:alternativeLabel "ext_brown"@en ;
    onto:commonlyHasUnit onto:_1-5 ;
    rdfs:subClassOf onto:Quantity .

onto:FatMassFraction a owl:Class ;
    rdfs:label "fat mass fraction"@en ;
    onto:commonlyHasUnit onto:gramPerGram,
        onto:one,
        onto:percent ;
    rdfs:comment "The fraction of the mass of fat in a phenomenon"@en ;
    rdfs:subClassOf onto:MassFraction .

onto:Firmness-Penetrometer-Method1 a owl:Class ;
    rdfs:label "firmness (penetrometer) (method 1)"@en ;
    onto:alternativeLabel "firmness_pen_1"@en ;
    onto:commonlyHasUnit onto:kilogramPerSquareMetre ;
    rdfs:subClassOf onto:Quantity .

onto:Firmness-Penetrometer-Method2 a owl:Class ;
    rdfs:label "firmness (penetrometer) (method 2)"@en ;
    onto:alternativeLabel "firmness_pen_2"@en ;
    onto:commonlyHasUnit onto:kilogramPerSquareMetre ;
    rdfs:subClassOf onto:Quantity .

onto:FixedZeroPoint a owl:Class ;
    rdfs:label "fixed zero point"@en ;
    rdfs:subClassOf onto:FixedPoint .

onto:FlowpackMass a owl:Class ;
    rdfs:label "flowpack mass"@en ;
    onto:commonlyHasUnit onto:gram,
        onto:kilogram,
        onto:tonne ;
    onto:unofficialLabel "flowpack weight" ;
    rdfs:subClassOf onto:Mass .

onto:Fluidity a owl:Class ;
    rdfs:label "fluidity"@en ;
    onto:commonlyHasUnit onto:reciprocalPascalSecond-Time,
        onto:rhe ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:FluidityUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        [ a owl:Restriction ;
            owl:hasValue onto:fluidity-Dimension ;
            owl:onProperty onto:hasDimension ],
        onto:Quantity .

onto:Friction a owl:Class ;
    rdfs:label "friction"@en ;
    onto:commonlyHasUnit onto:attonewton,
        onto:centinewton,
        onto:decanewton,
        onto:decinewton,
        onto:dyne,
        onto:exanewton,
        onto:femtonewton,
        onto:giganewton,
        onto:hectonewton,
        onto:kilonewton,
        onto:kip,
        onto:meganewton,
        onto:metreKilogramPerSecond-TimeSquared,
        onto:micronewton,
        onto:millinewton,
        onto:nanonewton,
        onto:newton,
        onto:petanewton,
        onto:piconewton,
        onto:pound-Force,
        onto:poundal,
        onto:teranewton,
        onto:ton-Force-Short ;
    rdfs:comment "Friction is a force that resists the relative motion of solid surfaces, fluid layers, or material elements sliding against each other."@en ;
    rdfs:subClassOf onto:Force .

onto:GasConstant a owl:Class ;
    rdfs:label "gas constant"@en ;
    onto:alternativeLabel "universal gas constant"@en ;
    onto:commonlyHasUnit onto:joulePerKelvinMole ;
    onto:symbol "R" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:molarEntropyOrMolarHeatCapacityOrGasConstant-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:GasConstantUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:GaussianSystemOfUnits a onto:SystemOfUnits ;
    rdfs:label "Gaussian system of units"@en ;
    onto:alternativeLabel "Gaussian CGS system of units"@en,
        "mixed CGS system of units"@en,
        "symmetrised CGS system of units"@en ;
    onto:hasBaseQuantity onto:Length,
        onto:Mass,
        onto:Time ;
    onto:hasBaseUnit onto:centimetre,
        onto:gram,
        onto:second-Time ;
    onto:hasDerivedQuantity onto:Capacitance,
        onto:ElectricCharge,
        onto:ElectricCurrent,
        onto:ElectricPotential,
        onto:ElectricalConductance,
        onto:ElectricalResistance,
        onto:Inductance,
        onto:MagneticField,
        onto:MagneticFlux,
        onto:MagneticFluxDensity,
        onto:MagnetomotiveForce ;
    onto:hasDerivedUnit onto:abampere,
        onto:abcoulomb,
        onto:abfarad,
        onto:abhenry,
        onto:abmho,
        onto:abohm,
        onto:abvolt,
        onto:gauss,
        onto:gilbert,
        onto:maxwell,
        onto:oersted,
        onto:statampere,
        onto:statcoulomb,
        onto:statfarad,
        onto:stathenry,
        onto:statmho,
        onto:statohm,
        onto:stattesla,
        onto:statvolt,
        onto:statweber .

onto:GelatinMassFraction a owl:Class ;
    rdfs:label "gelatin mass fraction"@en ;
    onto:commonlyHasUnit onto:gramPerGram,
        onto:one,
        onto:percent ;
