        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom [ a owl:Class ;
                            owl:unionOf ( onto:CelsiusTemperatureUnit onto:CelsiusTemperatureScale ) ] ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Temperature .

onto:CelsiusTemperatureScale a owl:Class ;
    rdfs:label "Celsius temperature scale"@en ;
    rdfs:subClassOf onto:Scale ;
    owl:equivalentClass onto:CelsiusScale .

onto:CelsiusTemperatureUnit a owl:Class ;
    rdfs:label "Celsius temperature unit"@en ;
    rdfs:subClassOf onto:TemperatureUnit ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:oneOf ( onto:degreeCelsius ) ] onto:PrefixedDegreeCelsius ) ] .

onto:Circumference a owl:Class ;
    rdfs:label "circumference"@en ;
    onto:commonlyHasUnit onto:angstrom,
        onto:astronomicalUnit,
