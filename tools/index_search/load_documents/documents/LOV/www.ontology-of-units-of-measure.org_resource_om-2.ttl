onto:LaTeXCommand a owl:AnnotationProperty ;
    rdfs:label "LaTeX command"@en ;
    onto:alternativeLabel "typeset by LaTeX command"@en ;
    rdfs:comment "OMLaTeX command that can be used to render this quantity or unit."@en .

onto:LaTeXSymbol a owl:AnnotationProperty ;
    rdfs:label "LaTeX symbol"@en ;
    onto:alternativeLabel "LaTeX formatted symbol"@en,
        "has LaTeX symbol"@en ;
    rdfs:comment "OMLaTeX formatted symbol may include commands such as \\\\unit and \\\\E as defined in OMLaTeX."@en .

onto:LactoseMassFraction a owl:Class ;
    rdfs:label "lactose mass fraction"@en ;
    onto:commonlyHasUnit onto:gramPerGram,
        onto:one,
        onto:percent ;
    rdfs:comment "The fraction of the mass of lactose in a phenomenon"@en ;
    rdfs:subClassOf onto:MassFraction .

onto:LocustBeanGumMassFraction a owl:Class ;
    rdfs:label "locust bean gum mass fraction"@en ;
    onto:commonlyHasUnit onto:gramPerGram,
        onto:one,
        onto:percent ;
    rdfs:comment "The fraction of the mass of locust bean gum in a phenomenon"@en ;
    rdfs:subClassOf onto:MassFraction .

onto:ManualFirmness a owl:Class ;
    rdfs:label "manual firmness"@en ;
    onto:alternativeLabel "firmness_m"@en ;
    onto:commonlyHasUnit onto:_0-5 ;
    rdfs:subClassOf onto:Quantity .

onto:MassFlow a owl:Class ;
    rdfs:label "mass flow"@en ;
    onto:commonlyHasUnit onto:kilogramPerSecond-Time ;
    rdfs:comment "Mass flow is the movement of substances at equal rates or as a single body."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:massFlow-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MassFlowUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

onto:ModeratedStarchMassFraction a owl:Class ;
    rdfs:label "moderated starch mass fraction"@en ;
    onto:commonlyHasUnit onto:gramPerGram,
        onto:one,
        onto:percent ;
    rdfs:comment "The fraction of the mass of moderated starch in a phenomenon"@en ;
    rdfs:subClassOf onto:MassFraction .

onto:MomentOfForce a owl:Class ;
    rdfs:label "moment of force"@en ;
    onto:alternativeLabel "moment"@en ;
    onto:commonlyHasUnit onto:micronewtonMetre,
        onto:millinewtonMetre,
        onto:newtonMetre ;
    onto:symbol "M" ;
    rdfs:comment "Moment of force is the effectiveness of a force to produce rotation about an axis measured by the product of the force and the perpendicular distance from the line of action of the force to the axis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue onto:energy-Dimension ;
            owl:onProperty onto:hasDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom onto:MomentOfForceUnit ;
                    owl:onProperty onto:hasUnit ] ;
            owl:onProperty onto:hasValue ],
        onto:Quantity .

