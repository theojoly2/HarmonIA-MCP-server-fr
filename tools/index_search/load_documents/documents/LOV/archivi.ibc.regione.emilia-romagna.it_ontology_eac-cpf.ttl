@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:control a owl:ObjectProperty ;
    rdfs:label "Control"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e1944> ;
    rdfs:range onto:controlArea .

onto:description a owl:ObjectProperty ;
    rdfs:label "Description"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2138> ;
    rdfs:range onto:descriptionArea .

onto:eac-cpf.rdf a owl:Ontology ;
    dc:creator "Istituto per i beni artistici culturali e naturali della Regione Emilia-Romagna and Regesta.exe" ;
    dcterms:isReferencedBy <http://archivi.ibc.regione.emilia-romagna.it/ontology/semanticEnvironment/index.html> ;
    owl:imports dc:,
        dcterms: ;
    owl:versionInfo 1.2 ;
    skos:historyNote [ dc:creator "Silvia Mazzini" ;
            dc:date "2013-02-18" ;
            rdf:value "Creata la Object Property eac-cpf:hasPlace" ],
        [ dc:creator "Silvia Mazzini" ;
            dc:date "2013-02-18" ;
            rdf:value "Creata la Object Property eac-cpf:hasPlace" ],
        [ dc:creator "Silvia Mazzini" ;
            dc:date "2013-02-18" ;
            rdf:value "Creata la Datatype Property eac-cpf:placeRole" ],
        [ dc:creator "Silvia Mazzini" ;
            dc:date "2013-02-18" ;
            rdf:value "Creata la Datatype Property eac-cpf:placeRole" ] .

onto:family a owl:Class ;
    rdfs:label "family"^^xsd:string ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2773> ;
    rdfs:subClassOf onto:entity .

onto:function a owl:DatatypeProperty ;
    rdfs:label "Function"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:range xsd:string .

onto:generalContext a owl:DatatypeProperty ;
    rdfs:label "General Context"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:range xsd:string .

onto:hasMultipleIdentities a owl:ObjectProperty ;
    rdfs:label "Multiple Identities"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e4966> ;
    rdfs:range onto:entity .

onto:hasPlace a owl:ObjectProperty ;
    rdfs:label "Place"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e5820> ;
    rdfs:range onto:place ;
    owl:versionInfo "Questa proprietà è stata inserita nella versione del 18 febbraio 2013"^^xsd:string .

onto:languageDeclaration a owl:ObjectProperty ;
    rdfs:label "Language Declaration"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e3791> ;
    rdfs:range onto:language .

onto:languageUsed a owl:DatatypeProperty ;
    rdfs:label "Languages Used"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:range xsd:string .

onto:legalStatus a owl:DatatypeProperty ;
    rdfs:label "Legal Status"^^xsd:string ;
    rdfs:domain onto:corporateBody ;
    rdfs:range xsd:string .

onto:localControl a owl:DatatypeProperty ;
    rdfs:label "Local Control"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:range xsd:string .

onto:mandate a owl:DatatypeProperty ;
    rdfs:label "Mandate"^^xsd:string ;
    rdfs:domain onto:corporateBody ;
    rdfs:range xsd:string .

onto:occupation a owl:DatatypeProperty ;
    rdfs:label "Occupation"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:range xsd:string .

onto:person a owl:Class ;
    rdfs:label "person"^^xsd:string ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2773> ;
    rdfs:subClassOf onto:entity .

onto:placeRole a owl:DatatypeProperty ;
    rdfs:label "Place Role"^^xsd:string ;
    rdfs:domain onto:place ;
    rdfs:range xsd:string ;
    owl:versionInfo "Questa proprietà è stata inserita nella versione del 18 febbraio 2013"^^xsd:string .

onto:resourceRelationType a owl:DatatypeProperty ;
    rdfs:label "Resource Relation Type"^^xsd:string ;
    rdfs:domain onto:relation ;
    rdfs:range xsd:string .

onto:structureOrGenealogy a owl:DatatypeProperty ;
    rdfs:label "Structure or Genealogy"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:range xsd:string .

onto:controlArea a owl:Class ;
    rdfs:label "control area"^^xsd:string ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e1944> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onto:conventionDeclaration ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:maintenanceHistory ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:maintenanceStatus ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:maintenanceAgency ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:localTypeDeclaration ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:recordID ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:localTypeDeclaration ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:publicationStatus ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:source ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:maintenanceAgency ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:maintenanceHistory ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:maintenanceStatus ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:recordID ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:conventionDeclaration ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:source ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:publicationStatus ;
            owl:someValuesFrom rdfs:Literal ] .

onto:descriptionArea a owl:Class ;
    rdfs:label "description area"^^xsd:string ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2138> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onto:nameEntry ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:biogHist ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:existDates ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:cpfRelation ;
            owl:someValuesFrom onto:relation ],
        [ a owl:Restriction ;
            owl:onProperty onto:nameEntry ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:resourceRelation ;
            owl:someValuesFrom onto:relation ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/vocab/bio/0.1/Death> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/vocab/bio/0.1/Death> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:cpfRelation ;
            owl:someValuesFrom onto:relation ],
        [ a owl:Restriction ;
            owl:onProperty onto:existDates ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty onto:resourceRelation ;
            owl:someValuesFrom onto:relation ],
        [ a owl:Restriction ;
            owl:onProperty onto:biogHist ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/vocab/bio/0.1/Birth> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/vocab/bio/0.1/Birth> ;
            owl:someValuesFrom rdfs:Literal ] .

onto:language a owl:Class ;
    rdfs:label "language"^^xsd:string ;
    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e3737> ;
    owl:Restriction [ a owl:allValuesFrom ;
            owl:Class <http://id.loc.gov/vocabulary/iso639-1> ],
        [ a owl:allValuesFrom ;
            owl:Class <http://id.loc.gov/vocabulary/iso639-1> ] .

onto:nameArea a owl:Class ;
    rdfs:label "name area"^^xsd:string ;
    rdfs:isDefinedBy onto:dainserire ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty foaf:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty foaf:depiction ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty foaf:givenName ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty foaf:page ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty foaf:depiction ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty foaf:givenName ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty foaf:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty foaf:page ;
            owl:someValuesFrom rdfs:Literal ] .

onto:biogHist a owl:DatatypeProperty ;
    rdfs:label "Biographical or Historical Note"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:range xsd:string .

onto:conventionDeclaration a owl:DatatypeProperty ;
    rdfs:label "Convention Declaration"^^xsd:string ;
    rdfs:domain onto:entity ;
    rdfs:range xsd:string .

onto:corporateBody a owl:Class ;
