@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://vocab.data.gov/hosp> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://health.data.gov/def/hospital/Hospital> a rdfs:Class,
        owl:Class ;
    rdfs:label "Hospital" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf rdfs:Resource .

<http://health.data.gov/def/hospital/HospitalOwnershipType> a rdfs:Class,
        owl:Class ;
    rdfs:label "HospitalOwnershipType" ;
    rdfs:isDefinedBy onto: .

<http://health.data.gov/def/hospital/HospitalType> a rdfs:Class,
        owl:Class ;
    rdfs:label "HospitalType" ;
    rdfs:isDefinedBy onto: .

<http://health.data.gov/def/hospital/accreditation> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "accreditation" ;
    rdfs:domain <http://health.data.gov/def/hospital/Hospital> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://health.data.gov/def/hospital/cacProvider> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "cacProvider" ;
    rdfs:domain <http://health.data.gov/def/hospital/Hospital> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://health.data.gov/def/hospital/emergencyServices> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "emergencyServices" ;
    rdfs:domain <http://health.data.gov/def/hospital/Hospital> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://health.data.gov/def/hospital/mpvProvider> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "mpvProvider" ;
    rdfs:domain <http://health.data.gov/def/hospital/Hospital> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://health.data.gov/def/hospital/ownership> a rdf:Property ;
    rdfs:label "ownership" ;
    rdfs:domain <http://health.data.gov/def/hospital/Hospital> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://health.data.gov/def/hospital/HospitalOwnershipType> .

<http://health.data.gov/def/hospital/site> a rdf:Property ;
    rdfs:label "site" ;
    rdfs:domain <http://health.data.gov/def/hospital/Hospital> ;
    rdfs:isDefinedBy onto: .

<http://health.data.gov/def/hospital/treats> a rdf:Property ;
    rdfs:label "treats" ;
    rdfs:isDefinedBy onto: .

<http://health.data.gov/def/hospital/type> a rdf:Property ;
    rdfs:label "type" ;
    rdfs:domain <http://health.data.gov/def/hospital/Hospital> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://health.data.gov/def/hospital/HospitalType> .

<http://vocab.data.gov/hosp#Centers%20for%20Medicare%20and%20Medicaid%20Services> a foaf:Organization ;
    foaf:homepage <http://www.cms.gov/> ;
    foaf:member <http://vocab.data.gov/hosp#www.cms.gov> ;
    foaf:name "Centers for Medicare and Medicaid Services" .

<http://vocab.data.gov/hosp#www.cms.gov> a foaf:Person ;
    foaf:homepage <http://www.cms.gov/> ;
    foaf:nick "www.cms.gov" .

onto: a owl:Ontology ;
    dc:creator <http://vocab.data.gov/hosp#www.cms.gov> ;
    dc:description "A RDF Schema that defines concepts and relationships used for Hospital data." ;
    dc:modified "2015-09-30"^^xsd:date ;
    dc:title "Hospital Vocabulary" ;
    vann:preferredNamespacePrefix "hosp" ;
    vann:preferredNamespaceUri "http://health.data.gov/def/hospital/" ;
    foaf:page onto:.html .

