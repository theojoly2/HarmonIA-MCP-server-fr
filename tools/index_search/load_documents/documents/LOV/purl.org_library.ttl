@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix onto: <http://purl.org/library/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

onto:ArchiveMaterial a owl:Class ;
    rdfs:label "ArchiveMaterial"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://schema.org/CreativeWork> ;
    owl:equivalentClass <http://schema.org/CreativeWork/ArchiveMaterial> ;
    ns1:term_status "unstable" .

