@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/observation#Observation> a owl:Class ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#NotSamplingFeature> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingCurve> a owl:Class ;
    rdfs:label "Sampling curve"@en ;
    rdfs:comment "Spatial sampling feature whose shape is a 1-D manifold (Curve)"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#Curve> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#shape> ],
        <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SpatialSamplingFeature> ;
    skos:notation "SF_SamplingCurve"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeatureCollection> a owl:Class ;
    rdfs:label "Sampling feature collection"@en ;
    rdfs:comment "Collection of sampling features"^^xsd:string,
        "The class SF_SamplingFeatureCollection (Figure 9) is an instance of the «metaclass» GF_FeatureType (ISO 19109), which therefore represents a feature type. SF_SamplingFeatureCollection shall support one association."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#member> ],
        <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    skos:notation "SF_SamplingFeatureCollection"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingPoint> a owl:Class ;
    rdfs:label "Sampling point"@en ;
    rdfs:comment "Spatial sampling feature whose shape is a 0-D manifold (Point)"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#Point> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#shape> ],
        <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SpatialSamplingFeature> ;
    skos:notation "SF_SamplingPoint"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingSolid> a owl:Class ;
    rdfs:label "Sampling solid"@en ;
    rdfs:comment "Spatial sampling feature whose shape is a 3-D manifold (Solid)"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#Solid> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#shape> ],
        <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SpatialSamplingFeature> ;
    skos:notation "SF_SamplingSolid"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingSurface> a owl:Class ;
    rdfs:label "Sampling surface"@en ;
    rdfs:comment "Spatial sampling feature whose shape is a 2-D manifold (Surface)"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#Surface> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#shape> ],
        <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SpatialSamplingFeature> ;
    skos:notation "SF_SamplingSurface"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#Specimen> a owl:Class ;
    rdfs:label "Specimen"@en ;
    rdfs:comment "A Specimen is a physical sample, obtained for observation(s) normally carried out ex-situ, sometimes in a laboratory."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#samplingTime> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#samplingMethod> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#samplingLocation> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#currentLocation> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#size> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#materialClass> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#specimenType> ],
        <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeature> ;
    skos:notation "SF_Specimen"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#parameter> a owl:ObjectProperty ;
    rdfs:label "sampling feature parameter" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/observation#parameter> ;
    skos:definition "the attribute parameter:NamedValue shall describe an arbitrary parameter associated with the SF_SamplingFeature. This might be a parameter that qualifies the interaction with the sampled feature, or an environmental parameter associated with the sampling process."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#preparationStep> a owl:ObjectProperty ;
    rdfs:label "preparation step" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#PreparationStep> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/observation#Process> a owl:Class ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#NotSamplingFeature> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#Location> a owl:Class ;
    rdfs:label "Location"^^xsd:string ;
    rdfs:comment "Location, expressed as either a spatial object or geographic identifier"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:unionOf ( <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#Object> <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicDescription> ) ;
    skos:notation "Location"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#PreparationStep> a owl:Class ;
    rdfs:label "Preparation step"@en ;
    rdfs:comment "Discrete stage in specimen-preparation process"^^xsd:string,
        "In many applications, specimen preparation procedures are applied to the material prior to its use in an observation. The class PreparationStep (Figure 13) shall link an SF_Specimen to an SF_Process that describes a phase of the specimen preparation."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://def.seegrid.csiro.au/isotc211/iso19115/2003/citation#ResponsibleParty> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#processOperator> ],
        [ a owl:Restriction ;
            owl:onClass <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#Process> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#processingDetails> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Object> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#time> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        owl:Thing ;
    skos:notation "PreparationStep"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeatureComplex> a owl:Class ;
    rdfs:label "Sampling feature complex"@en ;
    rdfs:comment "Sampling features are frequently related to each other, as parts of complexes, through sub-sampling, and in other ways. If present, the association class SamplingFeatureComplex (Figure 9) shall link an SF_SamplingFeature to another SF_SamplingFeature."^^xsd:string,
        "Set of sampling features related to each other in a specific and deliberate way."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeature> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#relatedSamplingFeature> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#role> ],
        owl:Thing ;
    skos:notation "SamplingFeatureComplex"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#currentLocation> a owl:ObjectProperty ;
    rdfs:label "current location" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#Location> ;
    skos:definition "If present, the attribute currentLocation:Location shall describe the location of a physical specimen. This may be a storage location, such as a shelf in a warehouse or a drawer in a museum.\\n\\nNOTE If a specimen no longer exists, for example, it was destroyed in connection with an observation act, then the currentLocation should be omitted or carry a suitable null indicator."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#hostedProcedure> a owl:ObjectProperty ;
    rdfs:label "hosted procedure or instrument" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/observation#Process> ;
    skos:definition "A common role for a spatial sampling feature is to host instruments or procedures deployed repetitively or permanently. If present, the association Platform shall link the SF_SpatialSamplingFeature to an OM_Process deployed at it. The OM_Process has the role hostedProcedure with respect to the sampling feature."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#lineage> a owl:ObjectProperty ;
    rdfs:label "lineage" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/lineage#Lineage> ;
    skos:definition "If present, the attribute lineage:LI_Lineage shall describe the history and provenance of the SF_SamplingFeature. This might include information relating to the handling of the specimen, or details of the survey procedure of a spatial sampling feature."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#materialClass> a owl:ObjectProperty ;
    rdfs:label "material class" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "The attribute materialClass:GenericName shall provide a basic classification of the material type of the specimen.\\n\\nEXAMPLE Soil, water, rock, aqueous, liquid, tissue, vegetation, food."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#member> a owl:ObjectProperty ;
    rdfs:label "member sampling feature" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeature> ;
    skos:definition "The association Collection shall link an SF_SamplingFeatureCollection to member SF_SamplingFeatures."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#positionalAccuracy> a owl:ObjectProperty ;
    rdfs:label "positional accuracy" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataquality#PositionalAccuracy> ;
    skos:definition "Positioning metadata is commonly associated with sampling features defined in the context of field surveys. If present, positionalAccuracy:DQ_PositionalAccuracy shall describe the accuracy of the positioning of the sampling feature. Up to two instances of the attribute support the independent description of horizontal and vertical accuracy."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#processOperator> a owl:ObjectProperty ;
    rdfs:label "process operator" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "the attribute processOperator:CI_ResponsibleParty shall describe the operator of the process involved in the preparation step."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#processingDetails> a owl:ObjectProperty ;
    rdfs:label "processing details" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#Process> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#relatedObservation> a owl:ObjectProperty ;
    rdfs:label "related observation" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/observation#Observation> ;
    skos:definition "Sampling features are distinctive compared with other features from application domains by having navigable associations to observations. If present, the association Design shall link the SF_SamplingFeature to an OM_Observation that was made utilizing the sampling feature, and the description of the sampling feature provides an intrinsic element of the observation protocol, along with the observation procedure (7.2.2) and the decomposition of the domain geometry in the case of a coverage-valued result (8.3.2). The OM_Observation has the role relatedObservation with respect to the sampling feature. Multiple observations may be made on a single sampling feature."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#relatedSamplingFeature> a owl:ObjectProperty ;
    rdfs:label "related sampling feature" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeature> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#role> a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#sampledFeature> a owl:ObjectProperty ;
    rdfs:label "sampled feature" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#NotSamplingFeature> ;
    skos:definition "A sampling feature is established in order to make observations concerning some domain feature. The association Intention shall link the SF_SamplingFeature to the feature which the sampling feature was designed to sample. The target of this association has the role sampledFeature with respect to the sampling feature, and shall not be a sampling feature or observation. It is usually a real-world feature from an application domain (Figures 5 and 10).\\n\\nEXAMPLE A profile typically samples a water- or atmospheric-column; a well samples the water in an aquifer; a tissue specimen samples a part of an organism."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#samplingFeatureComplex> a owl:ObjectProperty ;
    rdfs:label "sampling feature complex" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeatureComplex> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#samplingLocation> a owl:ObjectProperty ;
    rdfs:label "sampling location" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#Object> ;
    skos:definition "If present, the attribute samplingLocation:GM_Object shall describe the location from where the specimen was obtained.\\n\\nNOTE Where a specimen has a relatedSamplingFeature whose location provides an unambiguous location then this attribute is not required. However, if the specific sampling location within the sampledFeature is important, then this attribute supports its description."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#samplingMethod> a owl:ObjectProperty ;
    rdfs:label "sampling method" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#Process> ;
    skos:definition "If present, the attribute samplingMethod:SF_Process shall describe the method used to obtain the specimen from its sampledFeature."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#samplingTime> a owl:ObjectProperty ;
    rdfs:label "sampling time" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Object> ;
    skos:definition "The attribute samplingTime:TM_Object shall record when the specimen was retrieved from the sampled feature."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#size> a owl:ObjectProperty ;
    rdfs:label "specimen size" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#measure> ;
    skos:definition "the attribute size:Measure shall describe a physical extent of the specimen. This may be length, mass, volume, etc., as appropriate for the specimen instance and its material class."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#specimenType> a owl:ObjectProperty ;
    rdfs:label "specimen type" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "the attribute specimenType:GenericName shall describe the basic form of the specimen. \\n\\nEXAMPLE Polished section; core; pulp; solution."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#time> a owl:ObjectProperty ;
    rdfs:label "preparation step time" ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Object> ;
    skos:definition "The attribute time:TM_Object shall describe the time that the SF_Process was applied to the SF_Specimen. It supports ordering of preparation steps."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#Process> a owl:Class ;
    rdfs:label "Sampling process"@en ;
    rdfs:comment "In many applications, specimen preparation procedures are applied to the material prior to its use in an observation. The class PreparationStep (Figure 13) shall link an SF_Specimen to an SF_Process that describes a phase of the specimen preparation."^^xsd:string,
        "Process involved in sampling. This may include specimen retrieval or processing, surveying a spatial sampling feature, excavation to provide access to a sampling feature, or any other process whose outcome is a new sampling feature."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature>,
        <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#NotSamplingFeature> ;
    owl:disjointWith <http://def.seegrid.csiro.au/isotc211/iso19156/2011/observation#Process> ;
    skos:notation "SF_Process"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SpatialSamplingFeature> a owl:Class ;
    rdfs:label "Spatial sampling feature"@en ;
    rdfs:comment "Sampling feature whose defining characteristic is that it samples the intended feature by geometric subsetting."^^xsd:string,
        "When observations are made to estimate properties of a geospatial feature, in particular where the value of a property varies within the scope of the feature, a spatial sampling feature is used. Depending on accessibility and on the nature of the expected property variation, the sampling feature may be extensive in one, two or three spatial dimensions. Processing and visualization methods are often dependent on the topological dimension of the sampling manifold, so this provides a natural classification system for sampling features.\\n\\nThis classification follows common practice in focussing on conventional spatial dimensions. Properties observed on sampling features may be time-dependent, but the temporal axis does not generally contribute to the classification of sampling feature classes. Sampling feature identity is usually less time-dependent than the property value."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#shape> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#hostedProcedure> ],
        [ a owl:Restriction ;
            owl:maxCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#positionalAccuracy> ],
        <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeature> ;
    skos:notation "SF_SpatialSamplingFeature"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#shape> a owl:ObjectProperty ;
    rdfs:label "spatial sampling feature shape" ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#Object> ;
    skos:definition "The association Geometry shall link an SF_SpatialSamplingFeature to a GM_Object that describes its shape."^^xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#NotSamplingFeature> a owl:Class ;
    rdfs:label "Not a sampling feature"^^xsd:string ;
    rdfs:comment "Complement of SamplingFeature"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    owl:disjointWith <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeature> .

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeature> a owl:Class ;
    rdfs:label "Sampling Feature"@en ;
    rdfs:comment "Feature on which observations may be made, that is intended to be representative of a different (usually larger) feature that is not fully accessible for some reason. "^^xsd:string,
        "Sampling features are artefacts of an observational strategy, and have no significant function outside of their role in the observation process. The physical characteristics of the features themselves are of little interest, except perhaps to the manager of a sampling campaign.\\n\\nEXAMPLE A “station” is essentially an identifiable locality where a sensor system or procedure may be deployed and an observation made. In the context of the observation model, it connotes the “world in the vicinity of the station”, so the observed properties relate to the physical medium at the station, and not to any physical artefact such as a mooring, buoy, benchmark, monument, well, etc.\\n\\nNOTE A transient sampling feature, such as a ships-track or flight-line, might be identified and described, but is unlikely to be revisited exactly.\\n\\nA sampling feature is intended to sample some feature-of-interest in an application domain. However, in some cases the identity, and even the exact type, of the sampled feature may not be known when observations are made using the sampling features."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#sampledFeature> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#samplingFeatureComplex> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#lineage> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#relatedObservation> ],
        <http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> ;
    owl:disjointWith <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#NotSamplingFeature> ;
    skos:notation "SF_SamplingFeature"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#AnyFeature> owl:disjointUnionOf ( <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#NotSamplingFeature> <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#SamplingFeature> ) .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    dc:creator "Simon Jonathan David COX\\nCSIRO"^^rdf:PlainLiteral ;
    dc:description "An OWL representation of the Sampling Features Schema described in clauses 8-10 of ISO 19156:2011 Geographic Information - Observations and Measurements"^^xsd:string ;
    dc:source "ISO 19156:2011"^^xsd:string ;
    dc:title "OWL representation of ISO 19156 Sampling Features model"^^xsd:string ;
    dcterms:created "2012-01-19T00:00:00"^^xsd:dateTime ;
    dcterms:hasPart <http://def.seegrid.csiro.au/isotc211/iso19156/2011/sampling#Location>,
