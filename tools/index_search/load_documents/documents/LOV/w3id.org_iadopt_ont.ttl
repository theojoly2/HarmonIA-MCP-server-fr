@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://omv.ontoware.org/2005/05/ontology#> .
@prefix onto: <https://w3id.org/iadopt/ont> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:conformsToKnowledgeRepresentationParadigm a owl:AnnotationProperty .

ns1:designedForOntologyTask a owl:AnnotationProperty .

ns1:hasFormalityLevel a owl:AnnotationProperty .

ns1:hasOntologyLanguage a owl:AnnotationProperty .

ns1:hasOntologySyntax a owl:AnnotationProperty .

ns1:usedOntologyEngineeringMethodology a owl:AnnotationProperty .

ns1:usedOntologyEngineeringTool a owl:AnnotationProperty .

dcterms:abstract a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:language a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

dcat:keyword a owl:AnnotationProperty .

foaf:primaryTopic a owl:AnnotationProperty .

onto: a owl:Ontology ;
    rdfs:label "I-ADOPT Framework ontology" ;
    ns1:conformsToKnowledgeRepresentationParadigm <https://www.isibang.ac.in/ns/mod/index.html#DescriptionLogics> ;
    ns1:designedForOntologyTask "semantically precise description and mapping of variables" ;
    ns1:hasFormalityLevel <https://www.isibang.ac.in/ns/mod/index.html#Schema> ;
    ns1:hasOntologyLanguage <https://www.isibang.ac.in/ns/mod/index.html#OWL-DL> ;
    ns1:hasOntologySyntax <https://www.isibang.ac.in/ns/mod/index.html#OWL/XML> ;
    ns1:usedOntologyEngineeringMethodology <https://www.isibang.ac.in/ns/mod/index.html#MethOntology> ;
    ns1:usedOntologyEngineeringTool "https://www.isibang.ac.in/ns/mod/index.html#Protege" ;
    dcterms:abstract "The I-ADOPT Framework ontology provides machine-readable variable descriptions in which the components are mapped to FAIR vocabulary terms." ;
    dcterms:contributor "John Graybeal, Stanford University, School of Medicine, USA, ORCID: 0000-0001-6875-5360",
        "Robert Huber, University Bremen, Germany",
        "Simon J D Cox , CSIRO Land and Water, Australia; ORCID: 0000-0002-3884-3420" ;
    dcterms:created "October 15, 2021" ;
    dcterms:creator "Alison Pamment, National Centre for Atmospheric Science / Centre for Environmental Data Analysis, STFC Rutherford Appleton Laboratory, UK, ORCID: 0000-0001-5040-4626",
        "Anusuriya Devaraju, Terrestrial Ecosystem Research Network (TERN), University of Queensland, Australia, ORCID: 0000-0003-0870-3192",
        "Barbara Magagna, Environment Agency Austria, ORCID: 0000-0003-2195-3997",
        "Gwenaelle Moncoiffe, National Oceanography Centre, British Oceanographic Data Centre, UK, ORCID: 0000-0001-6559-4178",
        "Maria Stoica, University of Colorado, Boulder , ORCID: 0000-0002-6612-3439",
        "Sirko Schindler, Institute of Data Science, German Aerospace Center (DLR), ORCID: 0000-0002-0964-4457" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng> ;
    dcterms:license "CC BY 4.0" ;
    dcterms:title "I-ADOPT Framework ontology" ;
    owl:versionIRI <https://w3id.org/iadopt/ont/0.9.1> ;
    owl:versionInfo "0.9.1" ;
    dcat:keyword "observable property",
        "variable" ;
    foaf:primaryTopic "Entity",
        "Property",
        "Variable" .

<https://w3id.org/iadopt/ont/constrains> a owl:ObjectProperty ;
    rdfs:label "constrains" ;
    rdfs:comment "A Constraint constrains an Entity having a role in the Variable description." ;
    rdfs:domain <https://w3id.org/iadopt/ont/Constraint> ;
    rdfs:range <https://w3id.org/iadopt/ont/Entity> .

<https://w3id.org/iadopt/ont/hasConstraint> a owl:ObjectProperty ;
    rdfs:label "hasConstraint" ;
    rdfs:comment "A Variable has a Constraint, that confines an Entity involved in the observation." ;
    rdfs:domain <https://w3id.org/iadopt/ont/Variable> ;
    rdfs:range <https://w3id.org/iadopt/ont/Constraint> .

<https://w3id.org/iadopt/ont/hasMatrix> a owl:ObjectProperty ;
    rdfs:label "hasMatrix" ;
    rdfs:comment "A Variable might have an Entity in which the ObjectOfInterest is contained." ;
    rdfs:domain <https://w3id.org/iadopt/ont/Variable> ;
    rdfs:range <https://w3id.org/iadopt/ont/Entity> ;
    rdfs:subPropertyOf <https://w3id.org/iadopt/ont/hasContextObject> .

<https://w3id.org/iadopt/ont/hasContextObject> a owl:ObjectProperty ;
    rdfs:label "hasContextObject" ;
    rdfs:comment "A Variable has an Entity that provides additional background information regarding the ObjectOfInterest." ;
    rdfs:domain <https://w3id.org/iadopt/ont/Variable> ;
    rdfs:range <https://w3id.org/iadopt/ont/Entity> .

<https://w3id.org/iadopt/ont/hasObjectOfInterest> a owl:ObjectProperty ;
    rdfs:label "hasObjectOfInterest" ;
    rdfs:comment "A Variable has an Entity whose Property is observed." ;
    rdfs:domain <https://w3id.org/iadopt/ont/Variable> ;
    rdfs:range <https://w3id.org/iadopt/ont/Entity> .

<https://w3id.org/iadopt/ont/hasProperty> a owl:ObjectProperty ;
    rdfs:label "hasProperty" ;
    rdfs:comment "A Variable has a Property that characterizes an Entity." ;
    rdfs:domain <https://w3id.org/iadopt/ont/Variable> ;
    rdfs:range <https://w3id.org/iadopt/ont/Property> .

<https://w3id.org/iadopt/ont/Constraint> a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A Constraint limits the scope of the observation and confines the context to a particular state. It describes properties of the involved entities that are relevant to the particular observation." .

<https://w3id.org/iadopt/ont/Property> a owl:Class ;
    rdfs:label "Property" ;
    rdfs:comment "A type of a characteristic of the ObjectOfInterest." .

<https://w3id.org/iadopt/ont/Entity> a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "An object or process that has a role in an observation. An Entity may play one of the following roles: ObjectOfInterest, ContextObject, Matrix. Whether the involvement of a particular entity is meaningful enough to include in the variable description depends on the specific context." .

<https://w3id.org/iadopt/ont/Variable> a owl:Class ;
    rdfs:label "Variable" ;
    rdfs:comment "A description of something observed or derived, minimally consisting of  an ObjectOfInterest and its Property." ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass <https://w3id.org/iadopt/ont/Entity> ;
            owl:onProperty <https://w3id.org/iadopt/ont/hasObjectOfInterest> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/iadopt/ont/Property> ;
            owl:onProperty <https://w3id.org/iadopt/ont/hasProperty> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

