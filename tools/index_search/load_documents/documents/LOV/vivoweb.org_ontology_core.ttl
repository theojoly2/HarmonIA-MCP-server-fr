            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:Credential ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeValue ;
            owl:onProperty ns6:dateIssued ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeValue ;
            owl:onProperty ns6:dateIssued ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeValue ;
            owl:onProperty ns6:expirationDate ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:Credential ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns6:validIn ],
        ns6:Relationship .

ns6:Student a owl:Class ;
    rdfs:label "Student" ;
    ns1:IAO_0000112 "Use only if no specific subclasses of core:Student describe the person."^^xsd:string ;
    ns1:IAO_0000115 "A person who is enrolled in an educational institution."^^xsd:string ;
    rdfs:subClassOf foaf:Person .

ns6:assigns a owl:ObjectProperty ;
    rdfs:label "assigns" ;
    owl:inverseOf ns6:assignedBy .

ns6:courseCredits a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "credits" .

ns6:eligibleFor a owl:ObjectProperty ;
    rdfs:label "credential eligibility attained" ;
    rdfs:range ns6:Credential .

ns6:expirationDate a owl:ObjectProperty ;
    rdfs:label "expiration date" ;
    rdfs:subPropertyOf ns6:dateTimeValue .

ns6:featuredIn a owl:ObjectProperty ;
    rdfs:label "featured in" ;
    ns5:descriptionAnnot "This is done through a restriction on the foaf:Person class."^^xsd:string ;
    rdfs:range ns1:IAO_0000030 ;
    owl:inverseOf ns6:features .

ns6:hasAssociatedConcept a owl:ObjectProperty ;
    rdfs:label "associated concept" ;
    owl:inverseOf ns6:conceptAssociatedWith .

ns6:hasResearchArea a owl:ObjectProperty ;
    rdfs:label "research areas" ;
    rdfs:subPropertyOf ns6:hasAssociatedConcept ;
    owl:inverseOf ns6:researchAreaOf .

ns6:rank a owl:DatatypeProperty ;
    rdfs:label "rank" ;
    ns1:IAO_0000112 "this number indicates a position in a list"^^xsd:string ;
    rdfs:range xsd:int .

ns6:supplementalInformation a owl:DatatypeProperty ;
    rdfs:label "supplemental information" .

<http://www.w3.org/2006/vcard/ns#CalendarBusy> a owl:Class ;
    rdfs:label "Calendar Busy" ;
    rdfs:comment "To specify the URI for the busy time associated with the object that the vCard represents.\\nWas called FBURI in vCard"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Calendar> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarBusy> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarBusy> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarBusy> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarBusy> ] ) ] .

<http://www.w3.org/2006/vcard/ns#CalendarLink> a owl:Class ;
    rdfs:label "Calendar Link" ;
    rdfs:comment "To specify the URI for a calendar associated with the object represented by the vCard.\\nWas called CALURI in vCard."^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Calendar> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarLink> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarLink> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarLink> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarLink> ] ) ] .

<http://www.w3.org/2006/vcard/ns#CalendarRequest> a owl:Class ;
    rdfs:label "Calendar Request" ;
    rdfs:comment "To specify the calendar user address [RFC5545] to which a scheduling request [RFC5546] should be sent for the object represented by the vCard. \\nWas called CALADRURI in vCard"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Calendar> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarRequest> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarRequest> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarRequest> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#calendarRequest> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Category> a owl:Class ;
    rdfs:label "Category" ;
    rdfs:comment "To specify application category information about the vCard, also known as tags. This was called CATEGORIES in vCard."^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Explanatory> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#category> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#category> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#category> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#category> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Geo> a owl:Class ;
    rdfs:label "Geo" ;
    rdfs:comment "Used to indicate global positioning  information that is specific to an address"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Geographical> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Geographical> a owl:Class ;
    rdfs:label "Geographical" ;
    rdfs:comment "These properties are concerned with information associated with  geographical positions or regions associated with the object the vCard represents"^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] .

<http://www.w3.org/2006/vcard/ns#InstantMessage> a owl:Class ;
    rdfs:label "Messaging" ;
    rdfs:comment "To specify the URI for instant messaging and presence protocol communications with the object the vCard represents. \\nWas called IMPP in vCard."^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Communication> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:anyURI ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#instantMessage> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#instantMessage> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:anyURI ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#instantMessage> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#instantMessage> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Key> a owl:Class ;
    rdfs:label "Key" ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Security> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#key> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#key> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#key> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#key> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Location> a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "Defines all the properties required to be a Location"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Kind> .

<http://www.w3.org/2006/vcard/ns#Logo> a owl:Class ;
    rdfs:label "Logo" ;
    rdfs:comment "To specify a graphic image of a logo associated with the  object the vCard represents"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Organizational> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#logo> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#logo> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#logo> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#logo> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Note> a owl:Class ;
    rdfs:label "Note" ;
    rdfs:comment "To specify supplemental information or a comment that is associated with the vCard"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Explanatory> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#note> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#note> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#note> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#note> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Organization> a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Defines all the properties required to be an  Organization"^^xsd:string,
        "To specify the organizational name  associated with the vCard"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Kind> .

<http://www.w3.org/2006/vcard/ns#OrganizationUnitName> a owl:Class ;
    rdfs:label "Organizational Unit Name" ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#OrganizationName> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#organizationalUnitName> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#organizationalUnitName> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#organizationalUnitName> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#organizationalUnitName> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Photo> a owl:Class ;
    rdfs:label "Photo" ;
    rdfs:comment "Specifies an image or photograph information that annotates some aspect of the object the vCard represents"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Identification> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#photo> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#photo> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#photo> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#photo> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Related> a owl:Class ;
    rdfs:label "Related" ;
    rdfs:comment "To specify a relationship between another entity and the entity represented by this vCard"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Organizational> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#related> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#related> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#related> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#related> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Sound> a owl:Class ;
    rdfs:label "Sound" ;
    rdfs:comment "To specify a digital sound content information that annotates some aspect of the vCard.  This property is often used to specify the proper pronunciation of the name property value of the vCard"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Explanatory> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:anyURI ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#sound> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#sound> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:anyURI ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#sound> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#sound> ] ) ] .

<http://www.w3.org/2006/vcard/ns#TimeZone> a owl:Class ;
    rdfs:label "Time Zone" ;
    rdfs:comment "Used to indicate time zone information that is specific to a location or address"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Geographical> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Type> a owl:Class ;
    rdfs:label "Type" ;
    rdfs:comment "This is called TYPE in vCard but renamed here to Context for less confusion (with types/class)"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Code> .

foaf:Group a owl:Class ;
    rdfs:label "Group" ;
    ns1:IAO_0000111 "group"^^xsd:string ;
    ns1:IAO_0000112 "A group can also be an organization but need not be; typically used for looser associations of people or organizations acting together in some fashion, not necessarily through formal agreement or on a long-term basis. Added to the VIVO ontology to be able to support informal and perhaps even private groups of people around an idea, funding opportunity, or event.\\n\\nsee: http://xmlns.com/foaf/spec/#term_Group"^^xsd:string ;
    ns1:IAO_0000115 "A collection of individual agents (and may itself play the role of a Agent, ie. something that can perform actions)."^^xsd:string,
        "A collection of individual agents."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Scott Hoffmann"^^xsd:string ;
    rdfs:comment "A group"^^xsd:string ;
    rdfs:subClassOf foaf:Agent .

ns1:BFO_0000029 a owl:Class ;
    rdfs:label "Site" ;
    rdfs:subClassOf ns1:BFO_0000141 .

ns1:ERO_0000776 a owl:Class ;
    rdfs:label "US Resident Role" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A role that inheres in a person who maintains residency in the United states."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:IAO_0000032 a owl:Class ;
    rdfs:label "Scalar Measurement Datum" ;
    ns1:IAO_0000112 "10 feet. 3 ml."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a scalar measurement datum is a measurement datum that is composed of two parts, numerals and a unit label."@en ;
    ns1:IAO_0000116 "2009-03-16: we decided to keep datum singular in scalar measurement datum, as in\\nthis case we explicitly refer to the singular form"@en,
        "Would write this as: has_part some 'measurement unit label' and has_part some numeral and has_part exactly 2, except for the fact that this won't let us take advantage of OWL reasoning over the numbers. Instead use has measurment value property to represent the same. Use has measurement unit label (subproperty of has_part) so we can easily say that there is only one of them."@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Melanie Courtot"@en ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:IAO_0000033 a owl:Class ;
    rdfs:label "Directive Information Entity" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An information content entity whose concretizations indicate to their bearer how to realize them in a process."@en ;
    ns1:IAO_0000116 "8/6/2009 Alan Ruttenberg: Changed label from \"information entity about a realizable\" after discussions at ICBO"@en,
        "Werner pushed back on calling it realizable information entity as it isn't realizable. However this name isn't right either. An example would be a recipe. The realizable entity would be a plan, but the information entity isn't about the plan, it, once concretized, *is* the plan. -Alan"@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Bjoern Peters"@en ;
    ns1:IAO_0000412 ns1:iao.owl ;
    rdfs:subClassOf ns1:IAO_0000030 .

<http://purl.org/ontology/bibo/Book> a owl:Class ;
    rdfs:label "Book" ;
    ns1:IAO_0000112 "Short Definition copied from bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "A written or printed work of fiction or nonfiction, usually on sheets of paper fastened or bound together within covers"^^xsd:string ;
    rdfs:comment "A written or printed work of fiction or nonfiction, usually on sheets of paper fastened or bound together within covers."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/edition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/edition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/lccn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/lccn> ],
        <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/CollectedDocument> a owl:Class ;
    rdfs:label "Collected Document" ;
    ns1:IAO_0000112 "Short Definition is the Medical Subject Heading (MeSH) definition"^^xsd:string ;
    ns1:IAO_0000115 "Work consisting of collections of previously published works"^^xsd:string ;
    rdfs:comment "A document that simultaneously contains other documents."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Collection> a owl:Class ;
    rdfs:label "Collection" ;
    ns1:IAO_0000112 "Collection of information resources that have a unified identity. Archives, museums and libraries often acquire collections on specific subjects and from distinguished authors or researchers. Also includes collections of resources bundled into a license."^^xsd:string,
        "Hill Ornithology Collection; Wiley Interscience Online Books Biochemisty Collection"^^xsd:string ;
    ns1:IAO_0000115 "Collection of information resources that have a unified identity"^^xsd:string ;
    rdfs:comment "A collection of Documents or Collections"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/oclcnum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/oclcnum> ],
        ns1:IAO_0000030 ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/presents> a owl:ObjectProperty ;
    rdfs:label "related documents" ;
    ns1:IAO_0000112 "Public Description from source: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html .  Bibo considers the bibo:presents and the bibo:presentedAt unstable terms.  It also indicates that bibo:presents is a sub-property of event:product."^^xsd:string ;
    rdfs:comment "Relates an event to associated documents; for example, conference to a paper."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "unstable" .

<http://purl.org/spar/cito/citesAsDataSource> a owl:ObjectProperty ;
    rdfs:label "cites as data source",
        "cites as data source"@en ;
    rdfs:comment "The citing entity cites the cited entity as source of data."@en .

ns6:EventSeries a owl:Class ;
    rdfs:label "Event Series" ;
    ns1:IAO_0000112 "A generic class which may include a conference series, a course section, a seminar series, or a workshop series. When possible, use one of these more specific classes."^^xsd:string,
        "Only use if no specific subclasses of core:EventSeries desribe the activity."^^xsd:string ;
    ns1:IAO_0000115 "Two or more events that occur at different times and are connected to each other."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:contactInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:contactInformation ],
        ns1:BFO_0000015 .

ns6:Room a owl:Class ;
    rdfs:label "Room" ;
    ns1:IAO_0000112 "100 Caldwell Hall; 114 Martha Van Rensselaer (Rushmore Conference Room)"^^xsd:string,
        "Enter room number of name."^^xsd:string ;
    ns1:IAO_0000115 "Room that provides a particular service or is used for a particular activity."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:Facility ;
            owl:onProperty ns1:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Facility ;
            owl:onProperty ns1:BFO_0000050 ],
        ns6:Facility .

ns6:conceptAssociatedWith rdfs:label "concept for" .

ns6:features a owl:ObjectProperty ;
    rdfs:label "features" ;
    ns1:IAO_0000112 "This is done through a restriction on the foaf:Person class."^^xsd:string ;
    rdfs:domain ns1:IAO_0000030 ;
    rdfs:range foaf:Agent .

ns6:hasFundingVehicle rdfs:label "funding provided via" ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ],
        [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ] .

ns6:hasGoverningAuthority rdfs:label "governing authority" ;
    rdfs:range foaf:Organization .

ns6:supports a owl:ObjectProperty ;
    rdfs:label "supports" ;
    ns5:descriptionAnnot "general relationship of support"^^xsd:string .

<http://www.w3.org/2006/vcard/ns#Calendar> a owl:Class ;
    rdfs:label "Calendar" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] ) ] .

<http://www.w3.org/2006/vcard/ns#OrganizationName> a owl:Class ;
    rdfs:label "Organization Name" ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Organizational> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#organizationName> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#organizationName> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#organizationName> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#organizationName> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Telephone> a owl:Class ;
    rdfs:label "Telephone" ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Communication> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:anyURI ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#telephone> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#telephone> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:anyURI ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#telephone> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#telephone> ] ) ] .

ns1:ARG_2000379 a owl:Class ;
    rdfs:label "Contact" ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:BFO_0000001 a owl:Class ;
    rdfs:label "Entity" .

ns1:BFO_0000003 a owl:Class ;
    rdfs:label "Occurrent" ;
    rdfs:subClassOf ns1:BFO_0000001 .

ns1:BFO_0000019 a owl:Class ;
    rdfs:label "Quality" ;
    rdfs:subClassOf ns1:BFO_0000020 .

ns1:ERO_0000595 a owl:Class ;
    rdfs:label "Research Opportunity" ;
    ns1:IAO_0000111 "student research opportunity"^^xsd:string ;
    ns1:IAO_0000112 "Training grant to perform post-doctoral research."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A planned process carried out by a person or organization with the objective of performing research."^^xsd:string,
        "An offering through an ongoing program or single request of research support: internships, positions, financial awards or other forms of tangible or intangible support"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:contactInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Grant ;
            owl:onProperty ns6:hasFundingVehicle ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Grant ;
            owl:onProperty ns6:hasFundingVehicle ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:contactInformation ],
        ns1:BFO_0000017 .

ns1:IAO_0000102 a owl:Class ;
    rdfs:label "Data about an Ontology Part" ;
    ns1:IAO_0000115 "data about an ontology part is a data item about a part of an ontology, for example a term"@en ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000027 .

ns1:IAO_0000136 a owl:ObjectProperty ;
    rdfs:label "is about" ;
    ns1:IAO_0000112 "This document is about information artifacts and their representations"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "is_about is a (currently) primitive relation that relates an information artifact to an entity."@en ;
    ns1:IAO_0000116 "7/6/2009 Alan Ruttenberg. Following discussion with Jonathan Rees, and introduction of \"mentions\" relation. Weaken the is_about relationship to be primitive. \\n\\nWe will try to build it back up by elaborating the various subproperties that are more precisely defined.\\n\\nSome currently missing phenomena that should be considered \"about\" are predications - \"The only person who knows the answer is sitting beside me\" , Allegory, Satire, and other literary forms that can be topical without explicitly mentioning the topic."@en ;
    ns1:IAO_0000117 "person:Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "Smith, Ceusters, Ruttenberg, 2000 years of philosophy"@en ;
    rdfs:domain ns1:IAO_0000030 .

<http://purl.org/ontology/bibo/Conference> a owl:Class ;
    rdfs:label "Conference" ;
    ns1:IAO_0000112 "2010 International Congress on Autoimmunity; American Libraries Association 2009"^^xsd:string,
        "core:Seminar and bibo:Conference are very similar."^^xsd:string ;
    ns1:IAO_0000115 "A meeting for consultation or discussion."^^xsd:string ;
    rdfs:comment "A meeting for consultation or discussion."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:abbreviation ],
        <http://purl.org/NET/c4dm/event.owl#Event> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/eissn> a owl:DatatypeProperty ;
    rdfs:label "Electronic International Standard Serial Number (EISSN)" ;
    ns1:IAO_0000112 "eissn stands for Electronic International Standard Serial Number.  source: http://www.definition-of.com/EISSN"^^xsd:string ;
    rdfs:comment "The electronic ISSN number of a periodical."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/issn> a owl:DatatypeProperty ;
    rdfs:label "International Standard Serial Number (ISSN)" ;
    ns1:IAO_0000112 "source: http://en.wikipedia.org/wiki/Issn"^^xsd:string ;
    rdfs:comment "International Standard Serial Number"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/oclcnum> a owl:DatatypeProperty ;
    rdfs:label "Online Computer Library Center (OCLC) number" ;
    ns1:IAO_0000112 "http://info-uri.info/registry/OAIHandler?verb=GetRecord&metadataPrefix=reg&identifier=info:oclcnum/. \\n\\n\\nbibo has the domain of this property set to the union of Collection and Document."^^xsd:string ;
    rdfs:comment "OCLC Identifier"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/pageEnd> a owl:DatatypeProperty ;
    rdfs:label "end page" ;
    rdfs:comment "Ending page number within a continuous page range."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/locator> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/pageStart> a owl:DatatypeProperty ;
    rdfs:label "start page" ;
    rdfs:comment "Starting page number within a continuous page range."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/locator> ;
    ns2:term_status "stable" .

ns6:AcademicDegree a owl:Class ;
    rdfs:label "Academic Degree" ;
    ns1:IAO_0000112 "B.A. Bachelor of Arts"^^xsd:string,
        "This list may have multiple abbreviations for some degrees."^^xsd:string ;
    ns1:IAO_0000115 "An academic degree at any level, both as reported by individuals for employment and as offered by academic degree programs."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns6:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:abbreviation ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns6:abbreviation ],
        skos:Concept .

ns6:Award a owl:Class ;
    rdfs:label "Award or Honor" ;
    ns1:IAO_0000112 "An Award or Honor"^^xsd:string,
        "Wiley Prize in Biomedical Sciences"^^xsd:string ;
    ns1:IAO_0000115 "An Award or Honor"^^xsd:string ;
    rdfs:subClassOf skos:Concept .

ns6:Course a owl:Class ;
    rdfs:label "Course" ;
    ns1:IAO_0000112 "A course as taught in one time period (such as a semester; although note that a course could consist of only one meeting (teaching session)) by one or more instructors, normally but not always for credit. Does not represent either each meeting of the course or the course offering such as Biology 101 taught every semester from 1980 to 2010"^^xsd:string ;
    ns1:IAO_0000115 "A course as taught in one time period by one or more instructors, normally but not always for credit. Does not represent either each meeting of the course or the course offering such as Biology 101 taught every semester from 1980 to 2010"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:courseCredits ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:courseCredits ],
        <http://purl.org/NET/c4dm/event.owl#Event> .

ns6:FundingOrganization a owl:Class ;
    rdfs:label "Funding Organization" ;
    ns1:IAO_0000112 "National Institute of Health (NIH)"^^xsd:string ;
    ns1:IAO_0000115 "A defined class of organizations that fund Grants"^^xsd:string,
        "An organization that provides financial support to individuals or organizations to carry out specified activities."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns6:assigns ;
            owl:someValuesFrom ns6:Grant ],
        [ a owl:Restriction ;
            owl:onProperty ns6:assigns ;
            owl:someValuesFrom ns6:Grant ] .

ns6:dateIssued a owl:ObjectProperty ;
    rdfs:label "date issued" ;
    rdfs:range ns6:DateTimeValue ;
    rdfs:subPropertyOf ns6:dateTimeValue .

ns6:freetextKeyword a owl:DatatypeProperty ;
    rdfs:label "keywords" ;
    ns1:IAO_0000112 "conservation\\n\\nuse one freetextKeyword assertion for each keyword or phrase."^^xsd:string,
        "one keyword or phrase per freetextKeyword assertion"^^xsd:string .

ns6:hasPublicationVenue a owl:ObjectProperty ;
    rdfs:label "published in" ;
    owl:inverseOf ns6:publicationVenueFor .

ns6:hideFromDisplay a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hide from display" ;
    rdfs:range xsd:boolean .

ns6:supportedInformationResource a owl:ObjectProperty ;
    rdfs:label "supported publications or other works" ;
    ns5:descriptionAnnot "an information resource (typically a publication) supported by (typically via funding) an agreement (such as a grant)"^^xsd:string ;
    rdfs:range ns1:IAO_0000030 ;
    rdfs:subPropertyOf ns6:supports ;
    owl:inverseOf ns6:informationResourceSupportedBy .

ns6:validIn a owl:ObjectProperty ;
    rdfs:label "valid in" ;
    rdfs:range ns6:GeographicLocation .

<http://www.w3.org/2006/vcard/ns#Code> a owl:Class ;
    rdfs:label "Code" ;
    rdfs:comment "Contains all the Code related Classes that are used to indicate vCard Types"^^xsd:string .

<http://www.w3.org/2006/vcard/ns#Communication> a owl:Class ;
    rdfs:label "Communication" ;
    rdfs:comment "These properties describe information about how to communicate with the object the vCard represents"^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ] .

<http://www.w3.org/2006/vcard/ns#Email> a owl:Class ;
    rdfs:label "Email" ;
    rdfs:comment "To specify the electronic mail address for communication with the object the vCard represents"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Communication> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#email> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#email> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#email> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#email> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Explanatory> a owl:Class ;
    rdfs:label "Explanatory" ;
    rdfs:comment "These properties are concerned with additional explanations, such as that related to informational notes or revisions specific to the  vCard"^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ] .

<http://www.w3.org/2006/vcard/ns#FormattedName> a owl:Class ;
    rdfs:label "Formatted Name" ;
    rdfs:comment "Specifies the formatted text corresponding to the name of the object the vCard represents"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Identification> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#formattedName> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#formattedName> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#formattedName> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#formattedName> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Identification> a owl:Class ;
    rdfs:label "Identification" ;
    rdfs:comment "These types are used to capture information associated with the identification and naming of the entity associated with the vCard"^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ] .

<http://www.w3.org/2006/vcard/ns#Nickname> a owl:Class ;
    rdfs:label "Nickname" ;
    rdfs:comment "Specifies the text corresponding to the nickname of the object the vCard represents"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Identification> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#nickName> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#nickName> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#nickName> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#nickName> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Organizational> a owl:Class ;
    rdfs:label "Organizational" ;
    rdfs:comment "These properties are concerned with information associated with characteristics of the organization or organizational units of the object that the vCard represents"^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ] .

<http://www.w3.org/2006/vcard/ns#Title> a owl:Class ;
    rdfs:label "Title" ;
    rdfs:comment "To specify the position or job of the object the vCard represents"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Organizational> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#title> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#title> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#title> ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#title> ] ) ] .

<http://www.w3.org/2006/vcard/ns#URL> a owl:Class ;
    rdfs:label "URL" ;
    rdfs:comment "To specify a uniform resource locator associated with the object to which the vCard refers.  Examples for individuals include personal web sites, blogs, and social networking site  identifiers."^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Explanatory> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:anyURI ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#url> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#url> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:anyURI ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#url> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#url> ] ) ] .

<http://www.w3.org/2006/vcard/ns#additionalName> a owl:DatatypeProperty ;
    rdfs:label "additional name" ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Name> ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#anniversary> a owl:DatatypeProperty ;
    rdfs:label "anniversary" ;
    rdfs:comment "The date of marriage, or equivalent, of the object the  vCard represents"^^xsd:string ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Individual> ;
    rdfs:range xsd:dateTime .

<http://www.w3.org/2006/vcard/ns#birthdate> a owl:DatatypeProperty ;
