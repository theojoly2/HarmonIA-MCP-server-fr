    rdfs:label "has URL" ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#URL> .

<http://www.w3.org/2006/vcard/ns#honorificPrefix> a owl:DatatypeProperty ;
    rdfs:label "honorific prefix" ;
    rdfs:comment "Called Honorific Prefix in vCard"^^xsd:string ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Name> ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#honorificSuffix> a owl:DatatypeProperty ;
    rdfs:label "honorific suffix" ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Name> ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#instantMessage> a owl:DatatypeProperty ;
