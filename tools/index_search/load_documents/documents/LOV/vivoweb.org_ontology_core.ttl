ns1:BFO_0000002 a owl:Class ;
    rdfs:label "Continuant" ;
    rdfs:subClassOf ns1:BFO_0000001 .

ns1:BFO_0000004 a owl:Class ;
    rdfs:label "Independent Continuant" ;
    rdfs:subClassOf ns1:BFO_0000002 .

ns1:BFO_0000017 a owl:Class ;
    rdfs:label "Realizable Entity" ;
    ns1:BFO_0000179 "realizable" ;
    ns1:BFO_0000180 "RealizableEntity" ;
    ns1:IAO_0000112 "the disposition of this piece of metal to conduct electricity."@en,
        "the disposition of your blood to coagulate"@en,
        "the function of your reproductive organs"@en,
        "the role of being a doctor"@en,
        "the role of this boundary to delineate where Utah and Colorado meet"@en ;
    ns1:IAO_0000600 "To say that b is a realizable entity is to say that b is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region and is of a type instances of which are realized in processes of a correlated type. (axiom label in BFO2 Reference: [058-002])"@en ;
    ns1:IAO_0000601 "All realizable dependent continuants have independent continuants that are not spatial regions as their bearers. (axiom label in BFO2 Reference: [060-002])"@en ;
    ns1:IAO_0000602 "(forall (x t) (if (RealizableEntity x) (exists (y) (and (IndependentContinuant y) (not (SpatialRegion y)) (bearerOfAt y x t))))) // axiom label in BFO2 CLIF: [060-002]",
        "(forall (x) (if (RealizableEntity x) (and (SpecificallyDependentContinuant x) (exists (y) (and (IndependentContinuant y) (not (SpatialRegion y)) (inheresIn x y)))))) // axiom label in BFO2 CLIF: [058-002]" ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000020 ;
    owl:disjointWith ns1:BFO_0000019 .

ns1:BFO_0000020 a owl:Class ;
    rdfs:label "Specifically Dependent Continuant" ;
    rdfs:subClassOf ns1:BFO_0000002 .

ns1:ERO_0000015 a owl:Class ;
    rdfs:label "Human Study" ;
    ns1:IAO_0000111 "human study"^^xsd:string ;
    ns1:IAO_0000112 "A clinical trial."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Research project that uses or collects measurements or assessments about humans."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000119 "OCRe"^^xsd:string ;
    rdfs:comment "This should be imported from OCRE- but they currently have no generic human study type. Def is modified."^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000014 .

ns1:ERO_0000783 a owl:Class ;
    rdfs:label "Student Role" ;
    ns1:IAO_0000112 "A college student."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A role inhering in a person that is realized when the bearer participates a course of study, as in a school, college, university, etc."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    ns1:IAO_0000119 "http://www.thefreedictionary.com/student"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:RO_0001025 a owl:ObjectProperty ;
    rdfs:label "located in" .

<http://purl.org/ontology/bibo/DocumentPart> a owl:Class ;
    rdfs:label "Document Part" ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "A distinct part of a larger document or collected document"^^xsd:string ;
    rdfs:comment "a distinct part of a larger document or collected document."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Document> ;
            owl:onProperty ns1:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Document> ;
            owl:onProperty ns1:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "unstable" .

ns6:AdvisingRelationship a owl:Class ;
    rdfs:label "Advising Relationship" ;
    ns1:IAO_0000115 "A dual relationship of one person being advised or mentored by another person, typically including start and end dates"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:AdvisorRole ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:AdvisorRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:AdviseeRole ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Person ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:AdviseeRole ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Person ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        ns6:Relationship .

ns6:DateTimeValuePrecision a owl:Class ;
    rdfs:label "Date/Time Value Precision" ;
    ns1:IAO_0000115 "Indicates the precision of the value of a DateTimeValue instance."^^xsd:string ;
    rdfs:subClassOf skos:Concept .

ns6:EducationalProcess a owl:Class ;
    rdfs:label "Educational Process" ;
    ns1:IAO_0000112 "Currently any abstract name is given to individuals of this class. This could change in the future."^^xsd:string ;
    ns1:IAO_0000115 "Represents educational training that has been received."^^xsd:string ;
    ns5:descriptionAnnot "This connects person to their academic degree through this educational training, but can also be used when the training does not result in a degree."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
