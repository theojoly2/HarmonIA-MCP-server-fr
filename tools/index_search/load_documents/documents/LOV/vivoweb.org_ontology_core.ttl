    rdfs:label "key" ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Key> ;
    rdfs:range xsd:anyURI .

<http://www.w3.org/2006/vcard/ns#locality> a owl:DatatypeProperty ;
    rdfs:label "locality" ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Address> ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#logo> a owl:DatatypeProperty ;
    rdfs:label "logo" ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Logo> ;
    rdfs:range xsd:anyURI .

<http://www.w3.org/2006/vcard/ns#nickName> a owl:DatatypeProperty ;
    rdfs:label "nickname" ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Nickname> ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#note> a owl:DatatypeProperty ;
    rdfs:label "note" ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Note> ;
