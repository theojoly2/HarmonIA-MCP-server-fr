<http://www.w3.org/2006/vcard/ns#Individual> a owl:Class ;
    rdfs:label "Individual" ;
    rdfs:comment "Defines all the properties required to be an Individual"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Kind> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasName> ;
                                    owl:someValuesFrom <http://www.w3.org/2006/vcard/ns#Name> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#anniversary> ;
                                    owl:someValuesFrom xsd:dateTime ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#anniversary> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#birthdate> ;
                                    owl:someValuesFrom xsd:dateTime ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#birthdate> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#gender> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#gender> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasName> ;
                                    owl:someValuesFrom <http://www.w3.org/2006/vcard/ns#Name> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#anniversary> ;
                                    owl:someValuesFrom xsd:dateTime ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#anniversary> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#birthdate> ;
                                    owl:someValuesFrom xsd:dateTime ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#birthdate> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#gender> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#gender> ] ) ] ) ] .

