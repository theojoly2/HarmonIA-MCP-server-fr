            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns6:supplementalInformation ],
