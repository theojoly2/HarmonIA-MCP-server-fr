ns3:self_governing a owl:Class ;
    rdfs:label "Self Governing" ;
    dcterms:source "United Nations Map Library http://www.un.org/depts/dhl/maplib/countinfo.htm"^^xsd:string ;
    rdfs:subClassOf ns3:territory,
        ns6:GeopoliticalEntity ;
    owl:equivalentClass ns6:Country .

ns3:validSince a owl:DatatypeProperty ;
    rdfs:label "valid since" ;
    rdfs:comment "The value of the datatype property *validSince* associated to a particular area (territory or group) indicates the area's  first year of validity.  The geopolitical ontology traces back historic changes only until 1985, therefore, if an area has a validSince = 1985, this indicates that the area is/was valid since 1985 or before."^^xsd:string .

ns3:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until" ;
    rdfs:comment "The value of the datatype property *validUntil* associated to a particular area (territory or group) indicates the area's last year of validity. In case the area is currently valid, this value is set by default to 9999."^^xsd:string .

ns1:BFO_0000008 a owl:Class ;
    rdfs:label "Temporal Region" ;
    rdfs:subClassOf ns1:BFO_0000003 .

ns1:BFO_0000141 a owl:Class ;
    rdfs:label "Immaterial Entity" ;
    rdfs:subClassOf ns1:BFO_0000004 .

ns1:ERO_0000392 a owl:Class ;
    rdfs:label "Storage Service" ;
    ns1:IAO_0000112 "A computer server."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A service offering that describes a service in which the consumer provides some material or data as input which a service provider stores and returns as output."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Matt Brush"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Matthew Brush"^^xsd:string ;
    rdfs:comment "coordinate with NIF. NIF ID:nlx_res_20090419"^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000005 .

ns1:ERO_0000394 a owl:Class ;
    rdfs:label "Material Processing Service" ;
    ns1:IAO_0000112 "Biopsy service."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A service offering that describes a service in which the provider makes physical changes to a specified input material entity with the objective of producing a new material entity form input materials, or modifying the input material entity, and returning this as output to the service consumer"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    ns1:IAO_0000119 "http://neurolex.org/wiki/Category:Production_service_resource"^^xsd:string ;
    rdfs:comment "Coordinate with NIF: NIF ID: nlx_res_20090416"^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000005 .

ns1:ERO_0000543 a owl:ObjectProperty ;
    rdfs:label "related technique" ;
    ns1:IAO_0000111 "related technique"^^xsd:string ;
    ns1:IAO_0000112 "Flow cytometry is a related technique for a flow cytometer instrument."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Method in which the resource can be used."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Melissa Haendel"^^xsd:string ;
    rdfs:range ns1:ERO_0000007 .

ns1:ERO_0000778 a owl:Class ;
    rdfs:label "Non-US Citizen" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A US resident role that inheres in an individual who is not a legally recognized subject or national of the United States."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    ns1:IAO_0000119 "https://www.google.com/search?q=residency+status&ie=utf-8&oe=utf-8&aq=t&rls=org.mozilla:en-US:official&client=firefox-a#hl=en&client=firefox-a&hs=Bcx&rls=org.mozilla:en-US:official&q=citizen&tbs=dfn:1&tbo=u&sa=X&ei=micXT_DwMIjUiAK15tDUDw&ved=0CCgQkQ4&bav=on.2,or.r_gc.r_pw.,cf.osb&fp=7b67128a22f602af&biw=1609&bih=794"^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000776 .

ns1:ERO_0000787 a owl:Class ;
    rdfs:label "Employee Role" ;
    ns1:IAO_0000112 "An employee at a university."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A role inhering in a person that is realized when the bearer participates in an occupation by which a person earns a living or spends their time."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    ns1:IAO_0000119 "http://dictionary.reference.com/browse/employment"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:ERO_0001258 a owl:Class ;
    rdfs:label "Maintenance Service" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A service offering that describes a service in which the provider actively maintains a material or data resource (e.g. a model organism colony or database) for the service consumer.  This may involved making physical alterations to the material or data with the goal of maintaining its integrity or features."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Matt Brush"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Matthew Brush"^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000005 .

ns1:ERO_0001261 a owl:Class ;
    rdfs:label "Analysis Service" ;
    ns1:IAO_0000112 "Flow cytometry analysis service."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A service offering that describes a service in which the consumer provides some input material or data and a service provider returns data about the input material or data."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Matt Brush"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Matthew Brush"^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000005 .

ns1:ERO_0001518 a owl:ObjectProperty ;
    rdfs:label "has phase" ;
    ns1:IAO_0000111 "has phase"^^xsd:string ;
    ns1:IAO_0000112 "Phase 1 clinical trial."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Phase of a clinical trial to evaluate risk and to clinically evaluate the efficacy of drugs or biologicals."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Melissa Haendel"^^xsd:string ;
    rdfs:domain ns1:ERO_0000016 ;
    rdfs:range <http://purl.org/net/OCRe/study_design.owl#OCRE100038> .

ns1:IAO_0000003 a owl:Class ;
    rdfs:label "Measurement Unit Label" ;
    ns1:IAO_0000111 "measurement unit label"@en ;
    ns1:IAO_0000112 "Examples of measurement unit labels are liters, inches, weight per volume."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A measurement unit label is as a label that is part of a scalar measurement datum and denotes a unit of measure."@en ;
    ns1:IAO_0000116 "2009-03-16: provenance: a term measurement unit was\\nproposed for OBI (OBI_0000176) , edited by Chris Stoeckert and\\nCristian Cocos, and subsequently moved to IAO where the objective for\\nwhich the original term was defined was satisfied with the definition\\nof this, different, term."@en,
        "2009-03-16: review of this term done during during the OBI workshop winter 2009 and the current definition was considered acceptable for use in OBI. If there is a need to modify this definition please notify OBI."@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Melanie Courtot"@en ;
    ns1:IAO_0000412 ns1:iao.owl ;
    rdfs:subClassOf ns1:IAO_0000009 .

ns1:IAO_0000005 a owl:Class ;
    rdfs:label "Objective Specification" ;
    ns1:IAO_0000111 "objective specification"@en ;
    ns1:IAO_0000112 "purpose of a study; support of hypothesis, discovery of new information"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a directive information entity that describes an intended process endpoint. When part of a plan specification the concretization is realized in a planned process in which the bearer tries to effect the world so that the process endpoint is achieved."@en ;
    ns1:IAO_0000116 "Answers the question, why did you do this experiment?"@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Barry Smith"@en,
        "PERSON: Bjoern Peters"@en,
        "PERSON: Jennifer Fostel"@en ;
    ns1:IAO_0000119 "OBI Plan and Planned Process/Roles Branch"@en,
        "OBI_0000217"@en ;
    ns1:IAO_0000412 ns1:iao.owl ;
    rdfs:subClassOf ns1:IAO_0000033 .

ns1:IAO_0000027 a owl:Class ;
    rdfs:label "Data Item" ;
    ns1:IAO_0000111 "data item"@en ;
    ns1:IAO_0000112 "Data items include counts of things, analyte concentrations, and statistical summaries."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a data item is an information content entity that is intended to be a truthful statement about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en ;
    ns1:IAO_0000116 "2/2/2009 Alan and Bjoern discussing FACS run output data. This is a data item because it is about the cell population. Each element records an event and is typically further composed a set of measurment data items that record the fluorescent intensity stimulated by one of the lasers."@en,
        "2009-03-16: data item deliberatly ambiguous: we merged data set and datum to be one entity, not knowing how to define singular versus plural. So data item is more general than datum."@en,
        "2009-03-16: removed datum as alternative term as datum specifically refers to singular form, and is thus not an exact synonym."@en,
        "JAR: datum     -- well, this will be very tricky to define, but maybe some \\ninformation-like stuff that might be put into a computer and that is \\nmeant, by someone, to denote and/or to be interpreted by some \\nprocess... I would include lists, tables, sentences... I think I might \\ndefer to Barry, or to Brian Cantwell Smith\\n\\nJAR: A data item is an approximately justified approximately true approximate belief"@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Chris Stoeckert"@en,
        "PERSON: Jonathan Rees"@en ;
    ns1:IAO_0000118 "data"@en ;
    ns1:IAO_0000412 ns1:iao.owl ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:IAO_0000109 a owl:Class ;
    rdfs:label "Measurement Datum" ;
    ns1:IAO_0000111 "measurement datum"@en ;
    ns1:IAO_0000112 "Examples of measurement data are the recoding of the weight of a mouse as {40,mass,\"grams\"}, the recording of an observation of the behavior of the mouse {,process,\"agitated\"}, the recording of the expression level of a gene as measured through the process of microarray experiment {3.4,luminosity,}."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device."@en ;
    ns1:IAO_0000116 "2/2/2009 is_specified_output of some assay?"@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000305"@en,
        "group:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000027 .

ns1:RO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in" ;
    rdfs:domain ns1:BFO_0000002 ;
    rdfs:range ns1:BFO_0000003 .

ns1:RO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant" ;
    rdfs:domain ns1:BFO_0000003 ;
    rdfs:range ns1:BFO_0000002 ;
    owl:inverseOf ns1:RO_0000056 .

ns1:RO_0001000 a owl:ObjectProperty ;
    rdfs:label "derives from" .

ns1:RO_0002353 a owl:ObjectProperty ;
    rdfs:label "output of" ;
    rdfs:subPropertyOf ns1:RO_0000056 .

dcterms:contributor rdfs:label "contributor" .

<http://purl.org/ontology/bibo/AudioVisualDocument> a owl:Class ;
    rdfs:label "Audio-Visual Document" ;
    ns1:IAO_0000112 "film; video; Blu-ray"^^xsd:string ;
    ns1:IAO_0000115 "Audiovisual recording in any format"^^xsd:string ;
    rdfs:comment "An audio-visual document; film, video, and so forth."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty <http://purl.org/ontology/bibo/distributor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty <http://purl.org/ontology/bibo/distributor> ],
        <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/BookSection> a owl:Class ;
    rdfs:label "Book Section" ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "A section of a book"^^xsd:string ;
    rdfs:comment "A section of a book."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/pageEnd> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/edition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/pageStart> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/pageStart> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/edition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/pageEnd> ],
        <http://purl.org/ontology/bibo/DocumentPart> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Journal> a owl:Class ;
    rdfs:label "Journal" ;
    ns1:IAO_0000112 "Articles usually contain abstracts and bibliographies. Includes peer-reviewed, non-peer-reviewed, and open access journals. Journals are usually indexed in the major academic databases such as PubMed and Web of Science."^^xsd:string,
        "Journal of Information Science; IEEE Intelligent System; Scientometrics"^^xsd:string ;
    ns1:IAO_0000115 "Contains original scholarly research or review articles by experts in the field"^^xsd:string ;
    rdfs:comment "A periodical of scholarly journal Articles."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns6:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns6:abbreviation ],
        <http://purl.org/ontology/bibo/Periodical> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/LegalCaseDocument> a owl:Class ;
    rdfs:label "Legal Case Document" ;
    ns1:IAO_0000115 "Official court  papers for a case"^^xsd:string ;
    rdfs:comment "A document accompanying a legal case."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/LegalDocument> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/LegalDocument> a owl:Class ;
    rdfs:label "Legal Document" ;
    ns1:IAO_0000115 "a document that states some contractual relationship or grants some right"^^xsd:string ;
    rdfs:comment "A legal document; for example, a court decision, a brief, and so forth."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Legislation> a owl:Class ;
    rdfs:label "Legislation" ;
    ns1:IAO_0000112 "From OCLC Input Standards, EntW"^^xsd:string ;
    ns1:IAO_0000115 "Enactments of legislative bodies, published in either statute or code form"^^xsd:string ;
    rdfs:comment "A legal document proposing or enacting a law or a group of laws."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/LegalDocument> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Proceedings> a owl:Class ;
    rdfs:label "Proceedings" ;
    ns1:IAO_0000112 "Short Definition copied from bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "A compilation of documents published from an event, such as a conference"^^xsd:string ;
    rdfs:comment "A compilation of documents published from an event, such as a conference."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Book> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/doi> a owl:DatatypeProperty ;
    rdfs:label "Digital Object Identifier (DOI)" ;
    rdfs:comment "Digital Object Identifier"@en ;
    rdfs:domain ns1:IAO_0000030 ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/eanucc13> a owl:DatatypeProperty ;
    rdfs:label "EAN International-Uniform Code Council (EAN-UCC) 13" ;
    ns1:IAO_0000112 "Definition source: http://en.wikipedia.org/wiki/European_Article_Numbering-Uniform_Code_Council.\\nThe Uniform Code Council (UCC) was the Numbering Organization in the USA to administer and manage the EAN.UCC System. In 2005 the UCC changed its name to GS1 US."^^xsd:string ;
    rdfs:comment "European Article Number/Uniform Commercier Code 13"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/lccn> a owl:DatatypeProperty ;
    rdfs:label "Library of Congress Control Number (LCCN)" ;
    ns1:IAO_0000112 "Source: http://en.wikipedia.org/wiki/Library_of_Congress_Control_Number."^^xsd:string ;
    rdfs:comment "Library of Congress Control Number"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/numPages> a owl:DatatypeProperty ;
    rdfs:label "number of pages" ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/locator> .

<http://purl.org/ontology/bibo/presentedAt> a owl:ObjectProperty ;
    rdfs:label "presented at event" ;
    ns5:descriptionAnnot "Public Description from source: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html .  Bibo considers the bibo:presents and the bibo:presentedAt unstable terms.  It also indicates that bibo:presents is a sub-property of event:product."^^xsd:string ;
    rdfs:comment "Relates a document to an event; for example, a paper to a conference."@en ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:range <http://purl.org/NET/c4dm/event.owl#Event> ;
    owl:inverseOf <http://purl.org/ontology/bibo/presents> ;
    ns2:term_status "unstable" .

<http://purl.org/spar/c4o/hasGlobalCitationFrequency> a owl:ObjectProperty ;
    rdfs:label "has global citation frequency" ;
    ns1:IAO_0000115 "A property linking a publication entity to an instance of c40:GlobalCitationCount that specifies how many times a work has been cited by others, according to a particular information source on a particular date."^^xsd:string ;
    ns5:descriptionAnnot "A property linking a publication entity to the property c40:GlobalCitationCount that specify how many times a work has been cited by others, according to a particular information source on a particular date."^^xsd:string ;
    rdfs:range <http://purl.org/spar/c4o/GlobalCitationCount> .

<http://purl.org/spar/cito/isCitedAsDataSourceBy> a owl:ObjectProperty ;
    rdfs:label "is cited as data source by",
        "is cited as data source by"@en ;
    rdfs:comment "The cited entity is cited as a data source by the citing entity."@en ;
    owl:inverseOf <http://purl.org/spar/cito/citesAsDataSource> .

ns6:AdviseeRole a owl:Class ;
    rdfs:label "Advisee Role" ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:AdvisorRole a owl:Class ;
    rdfs:label "Advisor Role" ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:Blog a owl:Class ;
    rdfs:label "Blog" ;
    ns1:IAO_0000112 "Blog is short for weblog."^^xsd:string,
        "Library of Congress Blog"^^xsd:string ;
    ns1:IAO_0000115 "Regularly updated online journal or newsletter by one or more writers, called bloggers, containing articles and commentary of interest to the blogger"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Website> .

ns6:Center a owl:Class ;
    rdfs:label "Center" ;
    ns1:IAO_0000112 "Alchohol Education Center; Center for Arts and Public Policy; Hearing Research Center"^^xsd:string,
        "Short Definition take from http://www.thefreedictionary.com/center."^^xsd:string ;
    ns1:IAO_0000115 "A place where a particular activity or service is concentrated."^^xsd:string,
        "An organization where a specified activity is concentrated."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    ns1:IAO_0000112 "US Patent Data; US Job Data"^^xsd:string ;
    ns1:IAO_0000115 "A named collection of data, usually containing only one type of data"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Document> ;
            owl:onProperty <http://purl.org/spar/cito/isCitedAsDataSourceBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Document> ;
            owl:onProperty <http://purl.org/spar/cito/isCitedAsDataSourceBy> ],
        <http://purl.org/ontology/bibo/Document> .

ns6:Equipment a owl:Class ;
    rdfs:label "Equipment" ;
    ns1:IAO_0000112 "A network server is one example. Medical schools and research laboratories can list professional equipment, such as microscopes."^^xsd:string,
        "server; Bruker Vector-33 FT-IR"^^xsd:string ;
    ns1:IAO_0000115 "A physical object provided for specific purpose, task or occupation."^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns6:InvestigatorRole a owl:Class ;
    rdfs:label "Investigator Role" ;
    ns1:IAO_0000115 "A role in an Agreement (for example, a grant) as a named investigator or key personnel."^^xsd:string ;
    rdfs:subClassOf ns6:ResearcherRole .

ns6:IssuedCredential a owl:Class ;
