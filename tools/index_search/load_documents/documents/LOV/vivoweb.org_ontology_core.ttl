ns1:ERO_0000016 a owl:Class ;
    rdfs:label "Clinical Trial" ;
    ns1:IAO_0000112 "A clinical trial to evaluate the efficacy of a new drug."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An interventional study that contains a set of procedures in medical research and drug development that are conducted to allow safety (or more specifically, information about adverse drug reactions and adverse effects of other treatments) and efficacy data to be collected for health interventions (e.g., drugs, diagnostics, devices, therapy protocols) that is performed over phases."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Clinical_trial"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/net/OCRe/research.owl#Interventional_study> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/net/OCRe/research.owl#Interventional_study> [ a owl:Restriction ;
                        owl:onProperty ns1:ERO_0001518 ;
                        owl:someValuesFrom <http://purl.org/net/OCRe/study_design.owl#OCRE100038> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/net/OCRe/research.owl#Interventional_study> [ a owl:Restriction ;
                        owl:onProperty ns1:ERO_0001518 ;
                        owl:someValuesFrom <http://purl.org/net/OCRe/study_design.owl#OCRE100038> ] ) ] .

ns1:OBI_0100026 a owl:Class ;
    rdfs:label "Organism" ;
    ns1:IAO_0000111 "organism"@en ;
    ns1:IAO_0000112 "animal"@en,
        "fungus"@en,
        "plant"@en,
        "virus"@en ;
    ns1:IAO_0000114 ns1:IAO_0000121 ;
    ns1:IAO_0000115 "A material entity that is an individual living system, such as animal, plant, bacteria or virus, that is capable of replicating or reproducing, growth and maintenance in the right environment. An organism may be unicellular or made up, like humans, of many billions of cells divided into specialized tissues and organs."@en ;
    ns1:IAO_0000117 "GROUP: OBI Biomaterial Branch"^^xsd:string ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Organism"@en ;
    ns1:IAO_0000412 ns1:obi.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

<http://purl.org/ontology/bibo/Patent> a owl:Class ;
    rdfs:label "Patent" ;
    ns1:IAO_0000112 "A patent is an exclusive right granted for an invention, which is a product or a process that provides, in general, a new way of doing something, or offers a new technical solution to a problem.  In order to be patentable, the invention must fulfill certain conditions. (http://www.wipo.int/patentscope/en/)"^^xsd:string ;
    ns1:IAO_0000115 "(from BIBO) A document describing the exclusive right granted by a government to an inventor to manufacture, use, or sell an invention for a certain number of years"^^xsd:string ;
    rdfs:comment "A document describing the exclusive right granted by a government to an inventor to manufacture, use, or sell an invention for a certain number of years."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeValue ;
            owl:onProperty ns6:dateIssued ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeValue ;
            owl:onProperty ns6:dateIssued ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Periodical> a owl:Class ;
    rdfs:label "Periodical" ;
    rdfs:comment "A group of related documents issued at regular intervals."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/eissn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/issn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/eissn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/issn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        <http://purl.org/ontology/bibo/Collection> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/abstract> a owl:DatatypeProperty ;
    rdfs:label "abstract" ;
    ns1:IAO_0000112 "http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html"^^xsd:string ;
    rdfs:comment "A summary of the resource." ;
    rdfs:domain ns1:IAO_0000030 ;
    rdfs:isDefinedBy "http://purl.org/dc/terms/"^^xsd:anyURI ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/edition> a owl:DatatypeProperty ;
    rdfs:label "edition" ;
    rdfs:comment "The name defining a special edition of a document. Normally its a literal value composed of a version number and words."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "stable" .

<http://purl.org/spar/c4o/GlobalCitationCount> a owl:Class ;
    rdfs:label "Global Citation Count" ;
    ns1:IAO_0000115 "The number of times a work has been cited globally, as determined from a particular bibliographic information source on a particular date."^^xsd:string ;
    ns5:descriptionAnnot "The number of times a work has been cited globally, as determined from a particular bibliographic information source on a particular date."^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000032 .

ns6:GeopoliticalEntity a owl:Class ;
    rdfs:label "Geopolitical Entity" ;
    ns1:IAO_0000112 "Short definition obtained here: http://en.wiktionary.org/wiki/geopolitical_entity."^^xsd:string,
        "Use subclasses of core:GeopoliticalEntity subclasses instead of this class if possible."^^xsd:string ;
    ns1:IAO_0000115 "A geographical area which is associated with some sort of political  structure."^^xsd:string ;
    rdfs:subClassOf ns6:GeographicRegion .

ns6:contactInformation rdfs:label "contact information" .

<http://www.w3.org/2006/vcard/ns#Kind> a owl:Class ;
    rdfs:label "VCard Kind" ;
    rdfs:comment "The parent class for all vCard Objects"^^xsd:string ;
    rdfs:subClassOf ns1:ARG_2000379 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Address> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasAddress> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasAddress> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Email> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasEmail> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasEmail> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#FormattedName> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasFormattedName> ] [ a owl:Restriction ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasFormattedName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Nickname> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasNickname> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasNickname> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Telephone> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasTelephone> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasTelephone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Title> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasTitle> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasTitle> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#URL> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasURL> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasURL> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Address> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasAddress> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasAddress> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Email> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasEmail> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasEmail> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#FormattedName> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasFormattedName> ] [ a owl:Restriction ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasFormattedName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Nickname> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasNickname> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasNickname> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Telephone> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasTelephone> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasTelephone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#Title> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasTitle> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasTitle> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom <http://www.w3.org/2006/vcard/ns#URL> ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasURL> ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#hasURL> ] ) ] ) ] .

<http://purl.org/ontology/bibo/distributor> a owl:ObjectProperty ;
    rdfs:label "distributor" ;
    ns5:descriptionAnnot "Public Description for bibo:distributor taken from here:  http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html ."^^xsd:string .

<http://purl.org/ontology/bibo/locator> a owl:DatatypeProperty ;
    rdfs:label "locator" ;
    ns1:IAO_0000112 "definition from: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html"^^xsd:string ;
    rdfs:comment "A description (often numeric) that locates an item within a containing document or collection."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "stable" .

ns6:Credential a owl:Class ;
    rdfs:label "Credential" ;
    ns1:IAO_0000112 "An attestation of qualification, competence, or authority issued to an individual by a third party with a relevant or  de facto authority or assumed competence to do so."^^xsd:string ;
    ns1:IAO_0000115 "An attestation of qualification, competence, or authority issued to an individual by a third party with a relevant or  de facto authority or assumed competence to do so."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns6:validIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:hasGoverningAuthority ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:hasGoverningAuthority ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns6:validIn ],
        skos:Concept .

ns6:Laboratory a owl:Class ;
    rdfs:label "Laboratory" ;
    ns1:IAO_0000115 "An organization unit that facilitates or conduits observation, testing, experimentation, or research in a field of study or practice."^^xsd:string,
        "An organizational unit (as opposed to the physical facility) that performs research, provides services, or processes materials"^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Position a owl:Class ;
    rdfs:label "Position" ;
    ns1:IAO_0000112 "An employment activity, whether compensated or not. Short definition comes from http://en.wikipedia.org/wiki/Position, and has been modified."^^xsd:string,
        "Director of Admissions and Placement; Associate University Librarian"^^xsd:string ;
    ns1:IAO_0000115 "Particular position in an organization, commonly identified by job title, and normally associated with a job description that details the tasks and responsibilities that go with the position."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Organization ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Person ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:int ;
            owl:onProperty ns6:rank ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:int ;
            owl:onProperty ns6:rank ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Organization ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Person ],
        ns6:Relationship .

ns6:assignedBy a owl:ObjectProperty ;
    rdfs:label "assigned by" ;
    ns1:IAO_0000115 "Relates a Relationship (as a predicate or n-ary relation over one or more Thing) to an Agent that defined or instantiated the predicate instance."@en .

xsd:boolean a rdfs:Datatype .

<http://www.w3.org/2006/vcard/ns#TelephoneType> a owl:Class ;
    rdfs:label "Telephone Type" ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Code> .

ns1:ERO_0000007 a owl:Class ;
    rdfs:label "Technique" ;
    ns1:IAO_0000112 "Flow cytometry is a technique."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A technique is a planned process used to accomplish a specific activity or task."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Technique"^^xsd:string ;
    rdfs:comment "Protocol is added to eagle-i temporarily until a relationship between the informatio entity \"protocol\" and these planned processes is created. This class refers to the axtual process not the document"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000011 .

<http://purl.org/net/OCRe/study_design.owl#OCRE100038> a owl:Class ;
    rdfs:label "Phase" ;
    ns1:IAO_0000115 "Phase describes the level of a trial required of drugs before (and after) they are routinely used in clinical practice: \\n- Phase I trials assess toxic effects on humans (not many people participate in them, and usually without controls); \\n- Phase ll trials assess therapeutic benefit (usually involving a few hundred people, usually with controls, but not always); \\n- Phase III trials compare the new treatment against standard (or placebo) treatment (usually a full randomised controlled trial). At this point, a drug can be approved for community use. \\n- Phase IV monitors a new treatment in the community, often to evaluate longterm safety and effectiveness. [Glossary of Terms in The Cochrane Collaboration]\\n\\nA trial can be of a combination phase (e.g., I/II).\\nThe concept of phase is not applicable to trials studying certain interventions (e.g., device, procedure, behavioral)"^^xsd:string ;
    ns1:IAO_0000117 "Simona"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000015 .

<http://purl.org/ontology/bibo/Article> a owl:Class ;
    rdfs:label "Article" ;
    ns1:IAO_0000112 "A specific journal article"^^xsd:string,
        "Short Definition modified from the bibo ontology."^^xsd:string ;
    ns1:IAO_0000115 "A written composition in prose, usually nonfiction, on a specific topic, forming an independent part of a periodical or book"^^xsd:string ;
    rdfs:comment "A written composition in prose, usually nonfiction, on a specific topic, forming an independent part of a book or other publication, as a newspaper or magazine."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/pageStart> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/pageEnd> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/doi> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/pageStart> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/doi> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/pageEnd> ],
        <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

ns6:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" .

<http://www.w3.org/2006/vcard/ns#Address> a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "To specify the components of the delivery address for the vCard object"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Addressing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#country> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#country> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#locality> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#locality> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#postalCode> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#postalCode> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#region> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#region> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#streetAddress> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#streetAddress> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#country> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#country> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#locality> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#locality> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#postalCode> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#postalCode> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#region> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#region> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#streetAddress> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#streetAddress> ] ) ] ) ] .

<http://www.w3.org/2006/vcard/ns#Name> a owl:Class ;
    rdfs:label "Name" ;
    rdfs:comment "Specifies the components of the name of the object the  vCard represents"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Identification> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#additionalName> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#additionalName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#familyName> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#familyName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#givenName> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#givenName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorificPrefix> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorificPrefix> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorificSuffix> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorificSuffix> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#additionalName> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#additionalName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#familyName> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#familyName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#givenName> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#givenName> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorificPrefix> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorificPrefix> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorificSuffix> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorificSuffix> ] ) ] ) ] .

ns1:OBI_0000011 a owl:Class ;
    rdfs:label "Planned Process" ;
    ns1:IAO_0000111 "planned process"^^xsd:string,
        "planned process"@en ;
    ns1:IAO_0000112 "Injecting mice with a vaccine in order to test its efficacy"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A processual entity that realizes a plan which is the concretization of a plan specification."@en ;
    ns1:IAO_0000116 "'Plan' includes a future direction sense. That can be problematic if plans are changed during their execution. There are however implicit contingencies for protocols that an agent has in his mind that can be considered part of the plan, even if the agent didn't have them in mind before. Therefore, a planned process can diverge from what the agent would have said the plan was before executing it, by adjusting to problems encountered during execution (e.g. choosing another reagent with equivalent properties, if the originally planned one has run out.)"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "branch derived"^^xsd:string ;
    ns1:IAO_0000412 ns1:obi.owl ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns1:OBI_0000272 a owl:Class ;
    rdfs:label "Protocol" ;
    ns1:IAO_0000111 "Protocol"@en,
        "protocol"@en ;
    ns1:IAO_0000112 "PMID: 18388943.Nat Protoc. 2008;3(4):612-8.Protocol for the induction of arthritis in C57BL/6 mice."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a protocol is a plan specification which has sufficient level of detail and quantitative information to communicate it between domain experts, so that different domain experts will reliably be able to independently reproduce the process."@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived + wikipedia (http://en.wikipedia.org/wiki/Protocol_%28natural_sciences%29)"@en ;
    ns1:IAO_0000412 ns1:obi.owl ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:Relationship a owl:Class ;
    rdfs:label "Relationship" ;
    ns1:IAO_0000112 "functions as an n-ary predicate"^^xsd:string ;
    ns1:IAO_0000115 "a reified relationship"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000020 .

ns6:geographicFocus a owl:ObjectProperty ;
    rdfs:label "geographic focus" ;
    rdfs:range ns6:GeographicRegion .

ns1:ERO_0000020 a owl:Class ;
    rdfs:label "Biological Specimen" ;
    ns1:IAO_0000111 "biological specimen"^^xsd:string ;
    ns1:IAO_0000112 "Heart tissue obtained from an organism."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Material entity that is a portion or quantity of a biological material for use in testing, examination, or study. A biological specimen can be an individual animal, a population of organisms, or is a part of or derived from an animal, plant, part of a plant, or microorganism. When a taxon is described, it is typically based on a single specimen and is referred to as the holotype."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000118 "biospecimen"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Specimen"^^xsd:string ;
    rdfs:comment "Should have relationship to Organism"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        ns1:BFO_0000040 .

<http://purl.org/ontology/bibo/DocumentStatus> a owl:Class ;
    rdfs:label "Document Status" ;
    ns1:IAO_0000112 "The status of a document with respect to its publication. The statuses are represented as individuals of this class. Use the \"show all individuals of this class\" button on the class control panel to see the currently defined statuses."^^xsd:string,
        "submitted; accepted; in-press; published; invited; refereed."^^xsd:string ;
    ns1:IAO_0000115 "The status of a document with respect to its publication."^^xsd:string ;
    rdfs:comment "The status of the publication of a document."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "stable" .

ns6:Contract a owl:Class ;
    rdfs:label "Contract" ;
    ns1:IAO_0000115 "An agreement involving specific deliverables and payment"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:assignedBy ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns1:BFO_0000023 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:IAO_0000030 ;
            owl:onProperty ns6:supportedInformationResource ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:IAO_0000030 ;
            owl:onProperty ns6:supportedInformationResource ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:assignedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/abstract> ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns1:BFO_0000023 ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/abstract> ],
        ns6:Relationship .

ns6:Facility a owl:Class ;
    rdfs:label "Facility" ;
    ns1:IAO_0000112 "Distinct from the organization that runs it; e.g., a laboratory may be an organization but may be run by another organization and only consist of facilities housing equipment or services. Can be a building or place that provides a particular service or is used for a particular activity. Use the specific Building or Room whenever possible. Short definition from http://dictionary.reference.com/browse/facility."^^xsd:string,
        "Use subclasses of core:Facility subclasses instead of this class if possible"^^xsd:string ;
    ns1:IAO_0000115 "Something designed, built, installed, etc., to serve a specific function or activity affording a convenience or service."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:Facility ;
            owl:onProperty ns1:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Facility ;
            owl:onProperty ns1:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:BFO_0000029 ;
            owl:onProperty ns1:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:BFO_0000029 ;
            owl:onProperty ns1:BFO_0000050 ],
        ns1:BFO_0000029 .

ns1:ERO_0000014 a owl:Class ;
    rdfs:label "Research Project" ;
    ns1:IAO_0000112 "A project to study the role of a specific protein in cell signaling."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A funded collection of investigations as described in a research proposal."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Melissa Haendel"^^xsd:string ;
    rdfs:comment "Maybe SameAs \"Investigation\" but is the subject of funding"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000011,
        ns6:Project .

<http://purl.org/NET/c4dm/event.owl#Event> a owl:Class ;
    rdfs:label "Event" ;
    ns1:IAO_0000112 "Only use if no specific subclasses of event:Event are appropriate."^^xsd:string,
        "This class will also display instances of subclasses under Event, e.g. Philosophy Department Discussion Club; 2009 Racker Lecture; screening of a documentary. In addition to a location in space and time, an event may have any or all the following qualities: actively participating agents, passive factors, work products. Also, it may be in a virtual space or part of a series such as a lecture series.\\n\\nThe previous short definition was: \"An arbitrary classification of a space/time region, by a cognitive agent.\""^^xsd:string ;
    ns1:IAO_0000115 "Something that happens at a given place and time."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:contactInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicRegion ;
            owl:onProperty ns6:geographicFocus ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns1:RO_0001025 ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns1:RO_0001025 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicRegion ;
            owl:onProperty ns6:geographicFocus ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Document> ;
            owl:onProperty <http://purl.org/ontology/bibo/presents> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Document> ;
            owl:onProperty <http://purl.org/ontology/bibo/presents> ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:contactInformation ],
        ns1:BFO_0000015 .

ns6:dateTimeValue a owl:ObjectProperty ;
    rdfs:label "date/time value" ;
    rdfs:range ns6:DateTimeValue .

skos:Concept a owl:Class ;
    rdfs:label "Concept" .

ns1:BFO_0000015 a owl:Class ;
    rdfs:label "Process" ;
    rdfs:subClassOf ns1:BFO_0000003 .

ns1:BFO_0000050 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of" .

ns1:ERO_0000006 a owl:Class ;
    rdfs:label "Reagent" ;
    ns1:IAO_0000111 "reagent"^^xsd:string ;
    ns1:IAO_0000112 "A plasmid can be used as a reagent."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Processed material that is used in a chemical reaction or other experimental process to detect, measure, examine, or produce other  substances."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000119 "http://www.yourdictionary.com/reagent"^^xsd:string ;
    rdfs:comment "Placeholder for class to be imported from the Reagent Ontology (ReO)."^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 ) ],
        [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 ) ] .

ns6:abbreviation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "abbreviation" ;
    ns1:IAO_0000112 "A short form for an longer title or name."^^xsd:string,
        "B.A."^^xsd:string .

ns6:hasSubjectArea a owl:ObjectProperty ;
    rdfs:label "has subject area" ;
    rdfs:subPropertyOf ns6:hasAssociatedConcept ;
    owl:inverseOf ns6:subjectAreaOf .

ns6:placeOfPublication a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "place of publication" .

ns1:BFO_0000040 a owl:Class ;
    rdfs:label "Material Entity" ;
    rdfs:subClassOf ns1:BFO_0000004 .

ns1:BFO_0000051 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has part" ;
    owl:inverseOf ns1:BFO_0000050 .

ns6:GeographicRegion a owl:Class ;
    rdfs:label "Geographic Region" ;
    ns1:IAO_0000112 "Removed the word \"stable\" because disputed territories from geopolitical.owl are included. This could imply that the geographic coordinates could change. This definition was originally in core:Geographic Location.  I simply copied the definition from there.  I think core:Geographic Location and core:Geographic Region are both the same and only one is needed. There is also geopolitical.owl:geographical_region which further causes confusion."^^xsd:string,
        "Use subclasses of core:Geographic Region subclasses instead of this class if possible."^^xsd:string ;
    ns1:IAO_0000115 "A location having coordinates in geographic space."^^xsd:string ;
    rdfs:subClassOf ns6:GeographicLocation .

ns6:description a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "description" .

ns1:ERO_0000004 a owl:Class ;
    rdfs:label "Instrument" ;
    ns1:IAO_0000111 "instrument"^^xsd:string ;
    ns1:IAO_0000112 "A flow cytometer."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Material entity that is designed to have a function and play a role in scientific investigation."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Scientific_instrument"^^xsd:string ;
    rdfs:comment "See OBI listserv discussion for considerations in defining instrument. http://sourceforge.net/tracker/index.php?func=detail&aid=2894801&group_id=177891&atid=886178"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:ERO_0000007 ;
            owl:onProperty ns1:ERO_0000543 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:ERO_0000007 ;
            owl:onProperty ns1:ERO_0000543 ],
        ns1:BFO_0000040 .

ns6:GeographicLocation a owl:Class ;
    rdfs:label "Geographic Location" ;
    ns1:IAO_0000112 "Removed the word \"stable\" because disputed territories from geopolitical.owl are included. This could imply that the geographic coordinates could change. I've also copied this definition to core:Geographic Location.  I think core:Geographic Location and core:Geographic Region are both the same and only one is needed. There is also geopolitical.owl:geographical_region which further causes confusion."^^xsd:string,
        "Use subclasses of core:Geographic Location subclasses instead of this class if possible."^^xsd:string ;
    ns1:IAO_0000115 "A location having coordinates in geographic space."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns1:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns1:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns1:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns1:BFO_0000051 ],
        ns6:Location .

ns6:Grant a owl:Class ;
    rdfs:label "Grant" ;
    ns1:IAO_0000112 "An intramural or extramural award to support scholarly work, such as UF09179 (VIVO)"^^xsd:string,
        "Short definition is from the Glossary of NIH Terms."^^xsd:string ;
    ns1:IAO_0000115 "Financial assistance mechanism providing money, property, or both to an eligible entity to carry out an approved project or activity"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:IAO_0000030 ;
            owl:onProperty ns6:supportedInformationResource ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/abstract> ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns1:BFO_0000023 ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:IAO_0000030 ;
            owl:onProperty ns6:supportedInformationResource ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:assignedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:assignedBy ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns1:BFO_0000023 ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/abstract> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        ns6:Relationship .

ns6:publisher a owl:ObjectProperty ;
    rdfs:label "publisher" ;
    ns1:IAO_0000112 "Public Definition source (http://www.answers.com/topic/publisher)."^^xsd:string ;
    rdfs:range foaf:Organization ;
    owl:inverseOf ns6:publisherOf .

ns1:ERO_0001716 a owl:Class ;
    rdfs:label "Database" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A database is an organized collection of data, today typically in digital form."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Carlo Torniai"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Database"^^xsd:string ;
    rdfs:comment "Just a place horder. It will probably be replaced by NIF term: http://ontology.neuinfo.org/NIF/DigitalEntities/NIF-Resource.owl#nlx_res_20090405"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

<http://purl.org/ontology/bibo/identifier> a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:subPropertyOf ns6:identifier .

ns6:DateTimeValue a owl:Class ;
    rdfs:label "Date/Time Value" ;
    ns1:IAO_0000115 "A date and/or time"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000148 .

<http://www.w3.org/2006/vcard/ns#RelatedType> a owl:Class ;
    rdfs:label "Relation Type" ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Code> .

ns1:ERO_0000071 a owl:Class ;
    rdfs:label "Software" ;
    ns1:IAO_0000111 "software"^^xsd:string ;
    ns1:IAO_0000112 "Microsoft Word is commonly used word processing software."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A general term primarily used for digitally stored data such as computer programs and other kinds of information read and written by computers."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Computer_software"^^xsd:string ;
    rdfs:comment "IAO is a planned specification, in SWO is an Information artifact. In eagle-i, we have a need to collect material instances and is it thus currently classified as a material entity."^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:ERO_0000005 a owl:Class ;
    rdfs:label "Service" ;
    ns1:IAO_0000111 "service"^^xsd:string ;
    ns1:IAO_0000112 "A DNA sequencing service performed by a core lab."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An information content entity that describes a service performed by a person or organization with the objective of performing a technique, providing training, providing storage of data or material entities, or providing access to resources for another person or organization"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Melissa Haendel"^^xsd:string ;
    rdfs:comment "Coordinate with NIF. NIF ID: nlx_res_20090105"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns6:dateTimeInterval a owl:ObjectProperty ;
    rdfs:label "date/time interval" ;
    rdfs:range ns6:DateTimeInterval .

<http://www.w3.org/2006/vcard/ns#language> a owl:DatatypeProperty ;
    rdfs:label "has language" ;
    rdfs:comment "Use 2 char language code from RFC5646"^^xsd:string ;
    rdfs:range xsd:string .

ns1:BFO_0000023 a owl:Class ;
    rdfs:label "Role" ;
    ns1:IAO_0000112 "Only use if no specific subclasses of core:Role describe the role."^^xsd:string ;
    ns1:IAO_0000115 "A person's, group's or organization's role in an endeavor"^^xsd:string ;
    ns5:descriptionAnnot "Only use this broad role class if no subclasses of role describe the item being classified."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ns6:hideFromDisplay ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ns6:hideFromDisplay ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        ns1:BFO_0000017 .

onto: a owl:Ontology ;
    rdfs:label "VIVO-ISF Ontology version 1.6" .

<http://www.w3.org/2006/vcard/ns#sortAs> a owl:DatatypeProperty ;
    rdfs:label "sort as" ;
    rdfs:range xsd:string .

ns1:IAO_0000030 a owl:Class ;
    rdfs:label "Information Content Entity" ;
    ns1:IAO_0000111 "information content entity"@en ;
    ns1:IAO_0000112 "Examples of information content entites include journal articles, data, graphical layouts, and graphs."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "The most general classification of an information resource"^^xsd:string,
        "an information content entity is an entity that is generically dependent on some artifact and stands in relation of aboutness to some entity"@en ;
    ns1:IAO_0000116 "information_content_entity 'is_encoded_in' some digital_entity in obi before split (040907). information_content_entity 'is_encoded_in' some physical_document in obi before split (040907).\\n\\nPrevious. An information content entity is a non-realizable information entity that 'is encoded in' some digital or physical entity."@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000142"@en ;
    ns1:IAO_0000412 ns1:iao.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeValue ;
            owl:onProperty ns6:dateTimeValue ],
        [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:BFO_0000001 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicRegion ;
            owl:onProperty ns6:geographicFocus ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:freetextKeyword ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeValue ;
            owl:onProperty ns6:dateTimeValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:freetextKeyword ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasSubjectArea ],
        [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:BFO_0000001 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicRegion ;
            owl:onProperty ns6:geographicFocus ],
        ns1:BFO_0000031 .

ns6:DateTimeInterval a owl:Class ;
    rdfs:label "Date/Time Interval" ;
    ns1:IAO_0000115 "a specific period or duration, defined by (optional) start and end date/times."^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000038 .

foaf:Agent a owl:Class ;
    rdfs:label "Agent" ;
    ns1:IAO_0000111 "agent"^^xsd:string ;
    ns1:IAO_0000112 "see: http://xmlns.com/foaf/spec/#term_Agent"^^xsd:string ;
    ns1:IAO_0000115 "Agents are things that do stuff"^^xsd:string,
        "Things that do stuff."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Scott Hoffmann"^^xsd:string ;
    ns1:IAO_0000118 ""^^xsd:string ;
    rdfs:comment "An agent"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:IAO_0000030 ;
            owl:onProperty ns6:featuredIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:freetextKeyword ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:IAO_0000030 ;
            owl:onProperty ns6:featuredIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:freetextKeyword ],
        ns1:BFO_0000004 ;
    skos:scopeNote "Used to describe any \"agent\" related to bibliographic items. Such agents can be persons, organizations or groups of any kind."@en .

<http://www.w3.org/2006/vcard/ns#geo> a owl:DatatypeProperty ;
    rdfs:label "geo" ;
    rdfs:comment "Must use the geo URI scheme RFC5870"^^xsd:string ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Geo> ;
    rdfs:range xsd:anyURI .

<http://www.w3.org/2006/vcard/ns#timeZone> a owl:DatatypeProperty ;
    rdfs:label "timezone" ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#TimeZone> ;
    rdfs:range xsd:string .

foaf:Person a owl:Class ;
    rdfs:label "Person" ;
    ns1:IAO_0000111 "person"^^xsd:string ;
    ns1:IAO_0000115 "An instance of a human being (Homo sapiens)"^^xsd:string,
        "The most general classification of a person"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Melissa Haendel"^^xsd:string ;
    ns1:IAO_0000118 ""^^xsd:string ;
    rdfs:comment "A person"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicRegion ;
            owl:onProperty ns6:geographicFocus ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Credential ;
            owl:onProperty ns6:eligibleFor ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Credential ;
            owl:onProperty ns6:eligibleFor ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicRegion ;
            owl:onProperty ns6:geographicFocus ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasResearchArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns6:hasResearchArea ],
        foaf:Agent .

ns6:relates a owl:ObjectProperty ;
    rdfs:label "relates" ;
    ns1:IAO_0000115 "Relates a Relationship instance to the one or more Thing of the Relationship. There is a separate property (assigned by) to relate to the Agent that defines the Relationship."@en ;
    owl:inverseOf ns6:relatedBy .

xsd:anyURI a rdfs:Datatype .

<http://purl.org/ontology/bibo/Document> a owl:Class ;
    rdfs:label "Document" ;
    ns1:IAO_0000111 "document"@en ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string,
        "A journal article, patent application, laboratory notebook, or a book"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A bounded physical representation of a body of information designed with the capacity (and usually intent) to communicate"^^xsd:string,
        "A collection of information content entities intended to be understood together as a whole"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    ns1:IAO_0000412 ns1:iao.owl ;
    rdfs:comment "A document (noun) is a bounded physical representation of body of information designed with the capacity (and usually intent) to communicate. A document may manifest symbolic, diagrammatic or sensory-representational information."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:Dataset ;
            owl:onProperty <http://purl.org/spar/cito/citesAsDataSource> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/abstract> ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Agent ;
            owl:onProperty ns6:features ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/c4o/GlobalCitationCount> ;
            owl:onProperty <http://purl.org/spar/c4o/hasGlobalCitationFrequency> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/c4o/GlobalCitationCount> ;
            owl:onProperty <http://purl.org/spar/c4o/hasGlobalCitationFrequency> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/oclcnum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/numPages> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/oclcnum> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/numPages> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/DocumentPart> ;
            owl:onProperty ns1:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/abstract> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/DocumentPart> ;
            owl:onProperty ns1:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Agent ;
            owl:onProperty ns6:features ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Dataset ;
            owl:onProperty <http://purl.org/spar/cito/citesAsDataSource> ],
        ns1:IAO_0000030 .

foaf:Organization a owl:Class ;
    rdfs:label "Organization" ;
    ns1:IAO_0000111 "organization"^^xsd:string ;
    ns1:IAO_0000112 "Only use if no specific subclasses of foaf:organization desribe the organization."^^xsd:string,
        "This class will display all the instances in the subclasses below it, as well as any organizations that were added as part of this generic class because there wasn't a specific class available."^^xsd:string ;
    ns1:IAO_0000115 "A generic class encompassing several types of organizations."^^xsd:string,
        "A kind of Agent corresponding to social instititutions such as companies, societies etc."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Scott Hoffmann"^^xsd:string ;
    ns1:IAO_0000118 ""^^xsd:string ;
    rdfs:comment "An organization"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns1:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns1:RO_0001025 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicLocation ;
            owl:onProperty ns1:RO_0001025 ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns1:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        foaf:Agent ;
    skos:scopeNote "Ued to describe an organization related to bibliographic items such as a publishing company, etc."@en .

rdfs:Literal a rdfs:Datatype .

xsd:string a rdfs:Datatype .

