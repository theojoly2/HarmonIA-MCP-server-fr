<http://www.w3.org/2006/vcard/ns#gender> a owl:DatatypeProperty ;
    rdfs:label "gender" ;
    rdfs:comment "To specify the components of the sex and gender identity of the object the vCard represents.\\nTo enable other Gender/Sex codes to be used, this dataproperty has range URI. The vCard gender code classes are defined under Code/Gender"^^xsd:string ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Individual> ;
    rdfs:range xsd:anyURI .

<http://www.w3.org/2006/vcard/ns#givenName> a owl:DatatypeProperty ;
    rdfs:label "first name" ;
    rdfs:comment "called Given Name invCard"^^xsd:string ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Name> ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#hasAddress> a owl:ObjectProperty ;
    rdfs:label "has address" ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Address> .

<http://www.w3.org/2006/vcard/ns#hasEmail> a owl:ObjectProperty ;
    rdfs:label "has email" ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Email> .

<http://www.w3.org/2006/vcard/ns#hasFormattedName> a owl:ObjectProperty ;
    rdfs:label "has formatted name" ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#FormattedName> .

<http://www.w3.org/2006/vcard/ns#hasMember> a owl:ObjectProperty ;
    rdfs:label "member" ;
    rdfs:comment "To include a member in the group this vCard represents"^^xsd:string ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Group> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.w3.org/2006/vcard/ns#Individual> <http://www.w3.org/2006/vcard/ns#Location> <http://www.w3.org/2006/vcard/ns#Organization> ) ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.w3.org/2006/vcard/ns#Individual> <http://www.w3.org/2006/vcard/ns#Location> <http://www.w3.org/2006/vcard/ns#Organization> ) ] .

<http://www.w3.org/2006/vcard/ns#hasName> a owl:ObjectProperty ;
    rdfs:label "has name" ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Name> .

<http://www.w3.org/2006/vcard/ns#hasNickname> a owl:ObjectProperty ;
    rdfs:label "has nickname" ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Nickname> .

<http://www.w3.org/2006/vcard/ns#hasTelephone> a owl:ObjectProperty ;
    rdfs:label "has telephone" ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Telephone> .

<http://www.w3.org/2006/vcard/ns#hasTitle> a owl:ObjectProperty ;
    rdfs:label "has title" ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Title> .

