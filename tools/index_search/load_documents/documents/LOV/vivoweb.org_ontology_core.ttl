<http://purl.org/ontology/bibo/AcademicArticle> a owl:Class ;
    rdfs:label "Academic Article" ;
    ns1:IAO_0000112 "A specific academic journal article"^^xsd:string ;
    ns1:IAO_0000115 "Written by scholars for other scholars, typically published in an academic journal with an abstract and bibliography"^^xsd:string ;
    rdfs:comment "A scholarly academic article, typically published in a journal."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/eanucc13> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Journal> ;
            owl:onProperty ns6:hasPublicationVenue ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/eanucc13> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Journal> ;
            owl:onProperty ns6:hasPublicationVenue ],
        <http://purl.org/ontology/bibo/Article> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Excerpt> a owl:Class ;
    rdfs:label "Excerpt" ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string ;
