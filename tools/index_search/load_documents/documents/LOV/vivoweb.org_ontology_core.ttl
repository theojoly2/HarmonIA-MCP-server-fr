ns1:BFO_0000055 a owl:ObjectProperty ;
    rdfs:label "realizes" ;
    ns1:BFO_0000179 "realizes" ;
    ns1:BFO_0000180 "realizes" ;
    ns1:IAO_0000600 "to say that b realizes c at t is to assert that there is some material entity d & b is a process which has participant d at t & c is a disposition or role of which d is bearer_of at t& the type instantiated by b is correlated with the type instantiated by c. (axiom label in BFO2 Reference: [059-003])"@en ;
    ns1:IAO_0000602 "(forall (x y t) (if (realizesAt x y t) (and (Process x) (or (Disposition y) (Role y)) (exists (z) (and (MaterialEntity z) (hasParticipantAt x z t) (bearerOfAt z y t)))))) // axiom label in BFO2 CLIF: [059-003]" ;
    rdfs:domain ns1:BFO_0000015 ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:range ns1:BFO_0000017 ;
    owl:inverseOf ns1:BFO_0000054 .

ns1:ERO_0000012 a owl:Class ;
    rdfs:label "Service Provider Role" ;
    ns1:IAO_0000112 "A technician in a core laboratory."^^xsd:string,
        "Member of the International Conference on Complex Systems Organizing Committee"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A role inhering in a person or organization that is realized when the bearer participates in providing a service to meet the need of another person or thing."^^xsd:string,
        "An role of an individual within his or her profession or institution; use outreach provider role for community service or other activities outside the profession."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Nicole Vasilevsky"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

