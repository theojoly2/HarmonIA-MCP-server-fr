    ns1:IAO_0000112 "that fucoidan has a small statistically significant effect on AT3 level but no useful clinical effect as in-vivo anticoagulant, a paraphrase of part of the last paragraph of the discussion section of the paper 'Pilot clinical study to evaluate the anticoagulant activity of fucoidan', by Lowenthal et. al.PMID:19696660"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A textual entity that expresses the results of reasoning about a problem, for instance as typically found towards the end of scientific papers."@en ;
    ns1:IAO_0000116 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"@en,
        "2009/10/23 Alan Ruttenberg: We need to work on the definition still"@en ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"@en ;
    ns1:IAO_0000412 ns1:iao.owl ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:IAO_0000227 rdfs:label "terms merged" .

ns1:IAO_0000231 a owl:AnnotationProperty .

ns1:IAO_0000232 a owl:AnnotationProperty ;
    rdfs:label "curator note" .

ns1:IAO_0000300 a owl:Class ;
    rdfs:label "Textual Entity" ;
    ns1:IAO_0000111 "textual entity"@en ;
    ns1:IAO_0000112 "Words, sentences, paragraphs, and the written (non-figure) parts of publications are all textual entities"@en ;
    ns1:IAO_0000115 "A textual entity is a part of a manifestation (FRBR sense), a generically dependent continuant whose concretizations are patterns of glyphs intended to be interpreted as words, formulas, etc."@en ;
    ns1:IAO_0000116 "AR, (IAO call 2009-09-01): a document as a whole is not typically a textual entity, because it has pictures in it - rather there are parts of it that are textual entities. Examples: The title, paragraph 2 sentence 7, etc."@en,
        "MC, 2009-09-14 (following IAO call 2009-09-01): textual entities live at the FRBR (http://en.wikipedia.org/wiki/Functional_Requirements_for_Bibliographic_Records) manifestation level. Everything is significant: line break, pdf and html versions of same document are different textual entities."@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    ns1:IAO_0000118 "text"@en ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:IAO_0000412 a owl:AnnotationProperty ;
    rdfs:label "imported from" .

ns1:IAO_0000417 a owl:ObjectProperty ;
    rdfs:label "is quality measured as" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "inverse of the relation of is quality measurement of"@en ;
    ns1:IAO_0000116 "2009/10/19 Alan Ruttenberg. Named 'junk' relation useful in restrictions, but not a real instance relationship"@en ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"@en ;
    owl:inverseOf ns1:IAO_0000221 .

ns1:OBI_0000017 a owl:Class ;
    rdfs:label "Regulatory Role" ;
    ns1:IAO_0000111 "regulatory role"@en ;
    ns1:IAO_0000112 "Regulatory agency, Ethics committee, Approval letter; example:  Browse these EPA Regulatory Role subtopics  http://www.epa.gov/ebtpages/enviregulatoryrole.html  Feb 29, 2008"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role which inheres in material entities and is realized in the processes of making, enforcing or being defined by legislation or orders issued by a governmental body."@en ;
    ns1:IAO_0000117 "GROUP:  Role branch"@en ;
    ns1:IAO_0000119 "OBI, CDISC"@en ;
    ns1:IAO_0000412 ns1:obi.owl ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_0000293 a owl:ObjectProperty ;
    rdfs:label "has specified input" ;
    ns1:IAO_0000111 "has_specified_input"^^xsd:string ;
    ns1:IAO_0000112 "see is_input_of example_of_usage"@en ;
    ns1:IAO_0000115 "A relation between a planned process and a continuant participating in that process that is not created during  the process. The presence of the continuant during the process is explicitly specified in the plan specification which the process realizes the concretization of."@en ;
    ns1:IAO_0000116 "8/17/09: specified inputs of one process are not necessarily specified inputs of a larger process that it is part of. This is in contrast to how 'has participant' works."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"^^xsd:string,
        "PERSON: Larry Hunter"^^xsd:string,
        "PERSON: Melanie Coutot"^^xsd:string,
        "PERSON: Alan Ruttenberg"@en ;
    rdfs:domain ns1:OBI_0000011 ;
    rdfs:subPropertyOf ns1:RO_0002233 .

ns1:OBI_0000299 a owl:ObjectProperty ;
    rdfs:label "has specified output" ;
    ns1:IAO_0000111 "has_specified_output"^^xsd:string ;
    ns1:IAO_0000115 "A relation between a planned process and a continuant participating in that process. The presence of the continuant at the end of the process is explicitly specified in the objective specification which the process realizes the concretization of."@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"^^xsd:string,
        "PERSON: Larry Hunter"^^xsd:string,
        "PERSON: Melanie Courtot"^^xsd:string,
        "PERSON: Alan Ruttenberg"@en ;
    rdfs:domain ns1:OBI_0000011 ;
    rdfs:subPropertyOf ns1:RO_0002234 ;
    owl:inverseOf ns1:OBI_0000312 .

ns1:OBI_0000304 a owl:ObjectProperty ;
    rdfs:label "manufactured by" ;
    ns1:IAO_0000111 "is_manufactured_by"@en ;
    ns1:IAO_0000112 "http://www.affymetrix.com/products/arrays/specific/hgu133.affx is_manufactered_by http://www.affymetrix.com/ (if we decide to use these URIs for the actual entities)"@en ;
    ns1:IAO_0000115 "c is_manufactured_by o means that there was a process p in which c was built in which a person, or set of people or machines did the work(bore the \"Manufacturer Role\", and those people/and or machines were members or of directed by the organization to do this."@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en,
        "Liju Fan"@en ;
    ns1:IAO_0000118 "has_make"@en,
        "has_manufacturer"@en ;
    rdfs:domain ns1:BFO_0000040 ;
    rdfs:range foaf:Organization .

ns1:OBI_0000643 a owl:ObjectProperty ;
    rdfs:label "has grain" ;
    ns1:IAO_0000111 "has grain"^^xsd:string ;
    ns1:IAO_0000115 "the relation of the cells in the finger of the skin to the finger, in which an indeterminate number of grains are parts of the whole by virtue of being grains in a collective that is part of the whole, and in which removing one granular part does not nec- essarily damage or diminish the whole. Ontological Whether there is a fixed, or nearly fixed number of parts - e.g. fingers of the hand, chambers of the heart, or wheels of a car - such that there can be a notion of a single one being missing, or whether, by contrast, the number of parts is indeterminate - e.g., cells in the skin of the hand, red cells in blood, or rubber molecules in the tread of the tire of the wheel of the car."^^xsd:string ;
    ns1:IAO_0000116 "Discussion in Karslruhe with, among others, Alan Rector, Stefan Schulz, Marijke Keet, Melanie Courtot, and Alan Ruttenberg. Definition take from the definition of granular parthood in the cited paper. Needs work to put into standard form"@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "PAPER: Granularity, scale and collectivity: When size does and does not matter, Alan Rector, Jeremy Rogers, Thomas Bittner, Journal of Biomedical Informatics 39 (2006) 333-349"^^xsd:string ;
    ns1:IAO_0000412 ns1:obi_webservice.owl ;
    rdfs:subPropertyOf ns1:BFO_0000051 .

ns1:OBI_0000833 a owl:ObjectProperty ;
    rdfs:label "objective achieved by" ;
    ns1:IAO_0000115 "This relation obtains between a a objective specification and a planned process when the criteria specified in the objective specification are met at the end of the planned process."^^xsd:string ;
    ns1:IAO_0000116 "definition needs clean up to indicate directionality"^^xsd:string ;
    rdfs:domain ns1:IAO_0000005 ;
    rdfs:range ns1:OBI_0000011 ;
    owl:inverseOf ns1:OBI_0000417 .

ns1:OBI_0001554 a owl:Class ;
    rdfs:label "Rate Measurement Datum" ;
    rdfs:subClassOf ns1:IAO_0000032 .

ns1:OBI_0500000 a owl:Class ;
    rdfs:label "Study Design" ;
    ns1:IAO_0000111 "study design"@en ;
    ns1:IAO_0000115 "A study design is a plan specification comprised of protocols (which may specify how and what kinds of data will be gathered) that are executed as part of an investigation and is realized during a study design execution."^^xsd:string ;
    ns1:IAO_0000412 ns1:obi.owl ;
    rdfs:subClassOf ns1:IAO_0000104 .

ns1:RO_0000052 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "inheres in" ;
    ns1:IAO_0000116 "This clarifies that only specifically dependent continuants inhere in (specifically) one independent continuant over all time. For GDCs, there in implicitly inherence to all the independent continuants in which the concretizations inhere. Should add a 'cardinality 1' restriction to the definition of specifically dependent continuant."^^xsd:string,
        "This relation belongs in BFO/RO, and will be in BFO 2"^^xsd:string ;
    rdfs:domain ns1:BFO_0000020 ;
    rdfs:range ns1:BFO_0000004 ;
    owl:inverseOf ns1:RO_0000053 .

ns1:RO_0001015 a owl:ObjectProperty ;
    rdfs:label "location of" ;
    owl:inverseOf ns1:RO_0001025 .

ns1:RO_0001018 a owl:ObjectProperty ;
    rdfs:label "contained in" ;
    owl:inverseOf ns1:RO_0001019 .

ns1:RO_0002220 a owl:ObjectProperty ;
    rdfs:label "adjacent to" .

ns1:RO_0002350 a owl:ObjectProperty ;
    rdfs:label "member of" ;
    owl:inverseOf ns1:RO_0002351 .

ns1:RO_0003001 a owl:ObjectProperty ;
    rdfs:label "produced by" ;
    rdfs:domain ns1:BFO_0000040 ;
    rdfs:range ns1:BFO_0000040 ;
    owl:inverseOf ns1:RO_0003000 .

<http://purl.org/NET/c4dm/event.owl> rdfs:label "Event Ontology" .

dcterms:description a owl:AnnotationProperty .

dcterms:relation rdfs:label "relation" .

dcterms:source a owl:AnnotationProperty .

<http://purl.org/net/OCRe/research.owl> rdfs:label "OCRe research" .

ns8:curator a owl:AnnotationProperty .

<http://purl.org/net/OCRe/study_design.owl> rdfs:label "OCRe study design" .

<http://purl.org/net/OCRe/study_design.owl#Phase_0> a owl:Class ;
    rdfs:label "Phase 0" ;
    ns1:IAO_0000115 "A Phase 0 trial is an exploratory trial involving very limited human exposure, with no therapeutic or diagnostic intent (e.g., screening study, microdose study). [http://prsinfo.clinicaltrials.gov/definitions.html]"^^xsd:string ;
    ns8:curator "Simona"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> .

<http://purl.org/net/OCRe/study_design.owl#Phase_1> a owl:Class ;
    rdfs:label "Phase 1" ;
    ns1:IAO_0000115 "A Phase I trial assesses toxic effects on humans (not many people participate, and usually without controls) [Glossary of Terms in The Cochrane Collaboration]"^^xsd:string ;
    ns8:curator "Simona"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> .

<http://purl.org/net/OCRe/study_design.owl#Phase_2> a owl:Class ;
    rdfs:label "Phase 2" ;
    ns1:IAO_0000115 "A Phase ll trial assesses therapeutic benefit (usually involving a few hundred people, usually with controls, but not always) [Glossary of Terms in The Cochrane Collaboration]"^^xsd:string ;
    ns8:curator "Simona"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> .

<http://purl.org/net/OCRe/study_design.owl#Phase_3> a owl:Class ;
    rdfs:label "Phase 3" ;
    ns1:IAO_0000115 "A Phase III trial compares the new treatment against standard (or placebo) treatment (usually a full\\nrandomised controlled trial). At this point, a drug can be approved for community use. [Glossary of Terms in The Cochrane Collaboration]"^^xsd:string ;
    ns8:curator "Simona"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> .

<http://purl.org/net/OCRe/study_design.owl#Phase_4> a owl:Class ;
    rdfs:label "Phase 4" ;
    ns1:IAO_0000115 "A Phase IV study monitors a new treatment in the community, often to evaluate longterm safety and effectiveness. [Glossary of Terms in The Cochrane Collaboration]"^^xsd:string ;
    ns8:curator "Simona"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/net/OCRe/study_design.owl#OCRE100038> .

<http://purl.org/net/OCRe/study_design.owl#Single_group_study> a owl:Class ;
    rdfs:label "Single Group Study" ;
    ns1:IAO_0000115 "A single group study is an interventional study that has only a single allocation group and no contemporaneuos comparison group.\\nA study in which an individual acts has his/her own comparison does not fall into this category, since an individual is not a group."^^xsd:string ;
    ns8:curator "Simona"^^xsd:string ;
    ns4:develop_comment "Simona: to be reviewed"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/net/OCRe/research.owl#Interventional_study> .

ns4:develop_comment a owl:AnnotationProperty .

<http://purl.org/ontology/bibo/> rdfs:label "Bibontology" .

<http://purl.org/ontology/bibo/AudioDocument> a owl:Class ;
    rdfs:label "Audio Document" ;
    ns1:IAO_0000112 "phonograph record; tape; CD; DVD; DAT"^^xsd:string ;
    ns1:IAO_0000115 "Recorded audio in any format"^^xsd:string ;
    rdfs:comment "An audio document; aka record."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty <http://purl.org/ontology/bibo/distributor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty <http://purl.org/ontology/bibo/distributor> ],
        <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Bill> a owl:Class ;
    rdfs:label "Bill" ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "Draft legislation presented for discussion to a legal body"^^xsd:string ;
    rdfs:comment "Draft legislation presented for discussion to a legal body."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Legislation> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Brief> a owl:Class ;
    rdfs:label "Brief" ;
    ns1:IAO_0000115 "A document stating the facts and points of law of a client's case"^^xsd:string ;
    rdfs:comment "A written argument submitted to a court."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/LegalCaseDocument> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Chapter> a owl:Class ;
    rdfs:label "Chapter" ;
    ns1:IAO_0000115 "A main division of a book"^^xsd:string ;
    rdfs:comment "A chapter of a book."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/BookSection> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Code> a owl:Class ;
    rdfs:label "Code" ;
    ns1:IAO_0000112 "Code of Federal Regulations"^^xsd:string,
        "Short Definition from OCLC Input Standards, EntW"^^xsd:string ;
    ns1:IAO_0000115 "A work consisting of texts of rules and regulations related to statutes issued by executive or administrative agencies"^^xsd:string ;
    rdfs:comment "A collection of statutes."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Periodical> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/CourtReporter> a owl:Class ;
    rdfs:label "Court Reporter" ;
    ns1:IAO_0000112 "Supreme Court Reporter"^^xsd:string ;
    ns1:IAO_0000115 "Collection of legal cases"^^xsd:string ;
    rdfs:comment "A collection of legal cases."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Periodical> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/EditedBook> a owl:Class ;
    rdfs:label "Edited Book" ;
    ns1:IAO_0000112 "Best American Science Writing 2009"^^xsd:string ;
    ns1:IAO_0000115 "An edited collection of stand-alone articles published as a book"^^xsd:string ;
    rdfs:comment "An edited book."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/edition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/edition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        <http://purl.org/ontology/bibo/CollectedDocument> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Film> a owl:Class ;
    rdfs:label "Film" ;
    ns1:IAO_0000115 "Audiovisual recording in film format"^^xsd:string ;
    rdfs:comment "aka movie."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/AudioVisualDocument> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Hearing> a owl:Class ;
    rdfs:label "Hearing" ;
    ns1:IAO_0000112 "Definiton from Bibo here: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html"^^xsd:string ;
    ns1:IAO_0000115 "An instance or a session in which testimony and arguments are presented, esp. before an official, as a judge in a lawsuit."^^xsd:string ;
    rdfs:comment "An instance or a session in which testimony and arguments are presented, esp. before an official, as a judge in a lawsuit."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Interview> a owl:Class ;
    rdfs:label "Interview" ;
    ns1:IAO_0000112 "radio or newspaper interview"^^xsd:string ;
    ns1:IAO_0000115 "A conversation between two or more people where questions are asked by the interviewer to obtain information from the interviewee."^^xsd:string ;
    rdfs:comment "A formalized discussion between two or more people."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Issue> a owl:Class ;
    rdfs:label "Issue" ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "something that is printed or published and distributed, esp. a given number of a periodical"^^xsd:string ;
    rdfs:comment "something that is printed or published and distributed, esp. a given number of a periodical"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/CollectedDocument> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/LegalDecision> a owl:Class ;
    rdfs:label "Decision" ;
    ns1:IAO_0000115 "The written determination of a case, motion or claim by a court or tribunal"^^xsd:string ;
    rdfs:comment "A document containing an authoritative determination (as a decree or judgment) made after consideration of facts or law."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/LegalCaseDocument> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Letter> a owl:Class ;
    rdfs:label "Letter" ;
    ns1:IAO_0000112 "A written or printed communication addressed to a person or organization and usually transmitted by mail"^^xsd:string ;
    ns1:IAO_0000115 "A written or printed communication addressed to a person or organization and usually transmitted by mail"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/PersonalCommunicationDocument> .

<http://purl.org/ontology/bibo/Magazine> a owl:Class ;
    rdfs:label "Magazine" ;
    ns1:IAO_0000112 "Abstracts and bibliographies are usually not included in magazines."^^xsd:string,
        "New Yorker"^^xsd:string ;
    ns1:IAO_0000115 "Contains articles of current events or general interest, geared to the reading public as being informative or recreational"^^xsd:string ;
    rdfs:comment "A periodical of magazine Articles. A magazine is a publication that is issued periodically, usually bound in a paper cover, and typically contains essays, stories, poems, etc., by many writers, and often photographs and drawings, frequently specializing in a particular subject or area, as hobbies, news, or sports."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Periodical> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Manual> a owl:Class ;
    rdfs:label "Manual" ;
    ns1:IAO_0000112 "SDB User Manual"^^xsd:string ;
    ns1:IAO_0000115 "A book of instructions or guide to a specific topic"^^xsd:string ;
    rdfs:comment "A small reference book, especially one giving instructions."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Manuscript> a owl:Class ;
    rdfs:label "Manuscript",
        "manuscript" ;
    ns1:IAO_0000112 "Short Definition is the Medical Subject Heading (MeSH) definition"^^xsd:string ;
    ns1:IAO_0000115 "Works prepared by hand including handwritten or typescript drafts of pre-publication papers or works not otherwise reproduced in multiple copies"^^xsd:string ;
    rdfs:comment "An unpublished Document, which may also be submitted to a publisher for publication."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Map> a owl:Class ;
    rdfs:label "Map" ;
    ns1:IAO_0000112 "The Short Definition is how the bibo ontology defines Map. It has been extended to include more broader concept of map which includes science maps, social network maps."^^xsd:string ;
    ns1:IAO_0000115 "A graphical depiction of geographic features, scientific discipline, scientific data analytical results"^^xsd:string ;
    rdfs:comment "A graphical depiction of geographic features."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Image> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Newspaper> a owl:Class ;
    rdfs:label "Newspaper" ;
    ns1:IAO_0000112 "USA Today"^^xsd:string ;
    ns1:IAO_0000115 "Contains news articles, opinions, features, advertising, and is usually issued daily or weekly"^^xsd:string ;
    rdfs:comment "A periodical of documents, usually issued daily or weekly, containing current news, editorials, feature articles, and usually advertising."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Periodical> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Note> a owl:Class ;
    rdfs:label "Note" ;
    ns1:IAO_0000112 "Short Definition from bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "Notes or annotations about a resource"^^xsd:string ;
    rdfs:comment "Notes or annotations about a resource."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Performance> a owl:Class ;
    rdfs:label "Performance" ;
    ns1:IAO_0000115 "Something carried out, acted or rendered."^^xsd:string ;
    rdfs:comment "A public performance."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Quote> a owl:Class ;
    rdfs:label "Quote" ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "An excerpted collection of words"^^xsd:string ;
    rdfs:comment "An excerpted collection of words."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Excerpt> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/ReferenceSource> a owl:Class ;
    rdfs:label "Reference Source" ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "A document that presents authoritative reference information, such as a dictionary or encylopedia"^^xsd:string ;
    rdfs:comment "A document that presents authoritative reference information, such as a dictionary or encylopedia ."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Series> a owl:Class ;
    rdfs:label "Series" ;
    ns1:IAO_0000112 "Methods in Molecular Biology"^^xsd:string ;
    ns1:IAO_0000115 "A thematic collection of documents, usually books, issued at regular or irregular intervals"^^xsd:string ;
    rdfs:comment "A loose, thematic, collection of Documents, often Books."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/eissn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/eissn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/issn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <http://purl.org/ontology/bibo/issn> ],
        <http://purl.org/ontology/bibo/Collection> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Slide> a owl:Class ;
    rdfs:label "Slide" ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "A slide in a slideshow"^^xsd:string ;
    rdfs:comment "A slide in a slideshow"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/DocumentPart> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Slideshow> a owl:Class ;
    rdfs:label "Slideshow" ;
    ns1:IAO_0000112 "Short Definition from the bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "A presentation of a series of slides, usually presented in front of an audience with written text and images"^^xsd:string ;
    rdfs:comment "A presentation of a series of slides, usually presented in front of an audience with written text and images."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Standard> a owl:Class ;
    rdfs:label "Standard" ;
    ns1:IAO_0000112 "Short Definition from OCLC Input Standards, EntW"^^xsd:string ;
    ns1:IAO_0000115 "A specification giving a precise statement of a process or a service requirement, often sanctioned by a nation or industry"^^xsd:string ;
    rdfs:comment "A document describing a standard"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Statute> a owl:Class ;
    rdfs:label "Statute" ;
    ns1:IAO_0000112 "Short Definition from bibo ontology"^^xsd:string ;
    ns1:IAO_0000115 "A bill enacted into law"^^xsd:string ;
    rdfs:comment "A bill enacted into law."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Legislation> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Thesis> a owl:Class ;
    rdfs:label "Thesis" ;
    ns1:IAO_0000112 "Short Definition from OCLC Input Standards, EntW"^^xsd:string ;
    ns1:IAO_0000115 "Works created to satisfy the requirements for an academic certification or degree; also called dissertation"^^xsd:string ;
    rdfs:comment "A document created to summarize research findings associated with the completion of an academic degree."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:abbreviation ],
        <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Webpage> a owl:Class ;
    rdfs:label "Webpage" ;
    ns1:IAO_0000115 "One section of a website that appears at a unique address within the parent site's address or URL on the World Wide Web"^^xsd:string ;
    rdfs:comment "A web page is an online document available (at least initially) on the world wide web. A web page is written first and foremost to appear on the web, as distinct from other online resources such as books, manuscripts or audio documents which use the web primarily as a distribution mechanism alongside other more traditional methods such as print."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/Workshop> a owl:Class ;
    rdfs:label "Workshop" ;
    ns1:IAO_0000115 "Bibo Definition: A seminar, discussion group, or the like, that emphasizes exchange of ideas and the demonstration and application of techniques, skills, etc."^^xsd:string ;
    rdfs:comment "A seminar, discussion group, or the like, that emphasizes zxchange of ideas and the demonstration and application of techniques, skills, etc."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/accepted> a <http://purl.org/ontology/bibo/DocumentStatus>,
        owl:NamedIndividual ;
    rdfs:label "accepted" ;
    ns1:IAO_0000115 "Accepted for publication after peer reviewing"^^xsd:string ;
    ns6:description "Accepted for publication after peer reviewing"^^xsd:string .

<http://purl.org/ontology/bibo/affirmedBy> a owl:ObjectProperty ;
    rdfs:label "affirmed by" ;
    ns1:IAO_0000112 "The public description was taken from here:  http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html"^^xsd:string ;
    rdfs:comment "A legal decision that affirms a ruling."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI .

<http://purl.org/ontology/bibo/annotates> a owl:ObjectProperty ;
    rdfs:label "annotates" ;
    ns1:IAO_0000112 "The public description source is: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html."^^xsd:string ;
    rdfs:comment "Critical or explanatory note for a Document."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/asin> a owl:DatatypeProperty ;
    rdfs:label "Amazon Standard Identification Number (ASIN)" ;
    ns1:IAO_0000112 "020530902X"^^xsd:string,
        "Amazon standard identification number. Source: http://en.wikipedia.org/wiki/Amazon_Standard_Identification_Number."^^xsd:string ;
    rdfs:comment "Amazon Standard Identification Number"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/chapter> a owl:DatatypeProperty ;
    rdfs:label "chapter number" ;
    rdfs:comment "An chapter number"@en ;
    rdfs:domain <http://purl.org/ontology/bibo/BookSection> ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/locator> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/citedBy> a owl:ObjectProperty ;
    rdfs:label "cited by" ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:range <http://purl.org/ontology/bibo/Document> ;
    owl:inverseOf <http://purl.org/ontology/bibo/cites> .

<http://purl.org/ontology/bibo/coden> a owl:DatatypeProperty ;
    rdfs:label "coden" ;
    ns1:IAO_0000112 "CODEN became particularly common in the scientific community as a citation system for periodicals cited in technical- as well in chemistry-related publications and as a search tool in many bibliographic catalogues.\\nDefinition and description came from Wikipedia here: http://en.wikipedia.org/wiki/CODEN"^^xsd:string ;
    rdfs:comment "An identifier of serials, still in use by libraries, but replaced by ISSN for any new work"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/court> a owl:ObjectProperty ;
    rdfs:label "Court" ;
    ns1:IAO_0000112 "Public description take from: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html.  Bibo considers this property \"unstable\"."^^xsd:string ;
    rdfs:comment "A court associated with a legal document; for example, that which issues a decision."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/degree> a owl:ObjectProperty ;
    rdfs:label "related degree" ;
    ns1:IAO_0000112 "The source of the public description and this info is found here:  http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html.  Bibo considers this term \"unstable\".  The bibo editorial note is: \"We are not defining, using an enumeration, the range of the bibo:degree to the defined list of bibo:ThesisDegree. We won't do it because we want people to be able to define new degress if needed by some special usecases. Creating such an enumeration would restrict this to happen.\""^^xsd:string ;
    rdfs:comment "The thesis degree."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:range <http://purl.org/ontology/bibo/ThesisDegree> ;
    ns2:term_status "unstable" ;
    ns7:editorialNote "We are not defining, using an enumeration, the range of the bibo:degree to the defined list of bibo:ThesisDegree. We won't do it because we want people to be able to define new degress if needed by some special usecases. Creating such an enumeration would restrict this to happen."@en .

<http://purl.org/ontology/bibo/director> a owl:ObjectProperty ;
    rdfs:label "director" ;
    ns1:IAO_0000112 "Definition take from this site: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html ."^^xsd:string ;
    rdfs:comment "A Film director."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/draft> a <http://purl.org/ontology/bibo/DocumentStatus>,
        owl:NamedIndividual ;
    rdfs:label "draft" .

<http://purl.org/ontology/bibo/gtin14> a owl:DatatypeProperty ;
    rdfs:label "Global Trade Item Number (GTIN-14)" ;
    ns1:IAO_0000112 "http://en.wikipedia.org/wiki/Global_Trade_Item_Number."^^xsd:string ;
    rdfs:comment "Global Trade Item Number 14"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/interviewee> a owl:ObjectProperty ;
    rdfs:label "interviewee" ;
    rdfs:comment "An agent that is interviewed by another agent."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/interviewer> a owl:ObjectProperty ;
    rdfs:label "interviewer" ;
    rdfs:comment "An agent that interview another agent."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/isbn10> a owl:DatatypeProperty ;
    rdfs:label "International Standard Book Number (ISBN) 10" ;
    ns1:IAO_0000112 "http://en.wikipedia.org/wiki/Isbn."^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Book> ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> .

<http://purl.org/ontology/bibo/isbn13> a owl:DatatypeProperty ;
    rdfs:label "International Standard Book Number (ISBN) 13" ;
    ns1:IAO_0000112 "source: http://en.wikipedia.org/wiki/Isbn."^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Book> ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> .

<http://purl.org/ontology/bibo/issue> a owl:DatatypeProperty ;
    rdfs:label "issue" ;
    ns1:IAO_0000112 "Bibo has the domain of bibo:issue as the class Issue, but an example on their site uses it with Article, referring to the issue number \"4\""^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Article> ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/locator> .

<http://purl.org/ontology/bibo/issuer> a owl:ObjectProperty ;
    rdfs:label "issuer" ;
    ns5:descriptionAnnot "An entity responsible for issuing often informally published documents such as press releases, reports, etc. This term is classified as unstable by bibo."^^xsd:string ;
    rdfs:comment "An entity responsible for issuing often informally published documents such as press releases, reports, etc." ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:range foaf:Agent ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/number> a owl:DatatypeProperty ;
    rdfs:label "number" ;
    ns1:IAO_0000112 "Definition from here: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html"^^xsd:string .

<http://purl.org/ontology/bibo/peerReviewed> a <http://purl.org/ontology/bibo/DocumentStatus>,
        owl:NamedIndividual ;
    rdfs:label "peer reviewed" ;
    ns1:IAO_0000115 "&nbsp;Peer review is the process by which articles are chosen to be included in a refereed journal. An editorial board consisting of experts in the same field as the author review the article and decide if it is authoritative enough for publication."^^xsd:string ;
    ns6:description "&nbsp;Peer review is the process by which articles are chosen to be included in a refereed journal. An editorial board consisting of experts in the same field as the author review the article and decide if it is authoritative enough for publication."^^xsd:string .

<http://purl.org/ontology/bibo/performer> a owl:ObjectProperty ;
    rdfs:label "performer" ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf dcterms:contributor ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/pmid> a owl:DatatypeProperty ;
    rdfs:label "PubMed ID" ;
    ns1:IAO_0000112 "The PubMed ID (PMID) identifies a citation record (rather than full-text) in the PubMed database. It is not evidence of compliance with the NIH Public Access Policy, because it does not identify a full-text submission of any kind."^^xsd:string ;
    rdfs:comment "PubMed Identifier"@en ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/prefixName> a owl:DatatypeProperty ;
    rdfs:label "name prefix" ;
    ns1:IAO_0000112 "Mr; Ms; Mrs"^^xsd:string,
        "http://dictionary.reference.com/browse/prefix"^^xsd:string ;
    rdfs:comment "The prefix of a name"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/published> a <http://purl.org/ontology/bibo/DocumentStatus>,
        owl:NamedIndividual ;
    rdfs:label "published" ;
    ns1:IAO_0000115 "Published document"^^xsd:string ;
    ns6:description "Published document"^^xsd:string .

<http://purl.org/ontology/bibo/recipient> a owl:ObjectProperty ;
    rdfs:label "recipient" ;
    rdfs:comment "An agent that receives a communication document."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/rejected> a <http://purl.org/ontology/bibo/DocumentStatus>,
        owl:NamedIndividual ;
    rdfs:label "rejected" .

<http://purl.org/ontology/bibo/reversedBy> a owl:ObjectProperty ;
    rdfs:label "reversed by" ;
    ns1:IAO_0000112 "The first sentence of the public description was taken from here: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html"^^xsd:string ;
    rdfs:comment "A legal decision that reverses a ruling."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI .

<http://purl.org/ontology/bibo/reviewOf> a owl:ObjectProperty ;
    rdfs:label "review of" ;
    ns1:IAO_0000112 "The bibo:reviewOf public description was found here: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html .  As of 26 May 2010, bibo:reviewOf is used with the class Review, but core:reviewIn doesn't seem to be being used."^^xsd:string ;
    owl:inverseOf ns6:reviewedIn .

<http://purl.org/ontology/bibo/section> a owl:DatatypeProperty ;
    rdfs:label "section" ;
    ns1:IAO_0000112 "Di Rado, Alicia. 1995. Trekking through college: Classes explore\\nmodern society using the world of Star trek. Los Angeles Times, March\\n15, sec. A, p. 3."@en ;
    rdfs:comment "An section number"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/locator> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/shortDescription> a owl:DatatypeProperty ;
    rdfs:label "short description" ;
    rdfs:comment "A short description of the resource." ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "unstable" ;
    skos:scopeNote "The idea here is that while dcterms:description may involve length descriptions, this for short (two or three word) descriptions that could go in a bibliographic entry."@en .

<http://purl.org/ontology/bibo/sici> a owl:DatatypeProperty ;
    rdfs:label "Serial Item and Contribution Identifier (SICI)" ;
    ns1:IAO_0000112 "A sub property of identifier (http://en.wikipedia.org/wiki/SICI)."^^xsd:string ;
    rdfs:comment "Serial Item and Contribution Identifier"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/status> a owl:ObjectProperty ;
    rdfs:label "status" ;
    ns1:IAO_0000112 "paraphrased editorial note from the bibo ontology: We are not defining, using an enumeration, the range of the bibo:status to be a defined list of bibo:DocumentStatus. This is because we want people to be able to define new statuses if needed; and creating such an enumeration would prevent this."^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:range <http://purl.org/ontology/bibo/DocumentStatus> .

<http://purl.org/ontology/bibo/subsequentLegalDecision> a owl:ObjectProperty ;
    rdfs:label "subsequent legal decision" ;
    ns1:IAO_0000112 "Public description is from comments of this object property in bibo ontology located here: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html"^^xsd:string ;
    rdfs:comment "A legal decision on appeal that takes action on a case (affirming it, reversing it, etc.)."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI .

<http://purl.org/ontology/bibo/transcriptOf> a owl:ObjectProperty ;
    rdfs:label "transcript of" ;
    ns1:IAO_0000112 "The bibo:transcriptOf public description was found here:  http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html .  Bibo considers this term unstable."^^xsd:string ;
    rdfs:comment "Relates a document to some transcribed original."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/translator> a owl:ObjectProperty ;
    rdfs:label "translator" ;
    rdfs:domain ns1:IAO_0000030,
        <http://purl.org/ontology/bibo/Document> ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf dcterms:contributor ;
    owl:inverseOf ns6:translatorOf .

<http://purl.org/ontology/bibo/unpublished> a <http://purl.org/ontology/bibo/DocumentStatus>,
        owl:NamedIndividual ;
    rdfs:label "unpublished" .

<http://purl.org/ontology/bibo/upc> a owl:DatatypeProperty ;
    rdfs:label "Universal Product Code (UPC)" ;
    ns1:IAO_0000112 "source for public description: http://en.wikipedia.org/wiki/Universal_Product_Code."^^xsd:string ;
    rdfs:comment "Universal Product Code"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/uri> a owl:DatatypeProperty ;
    rdfs:label "URI" ;
    ns1:IAO_0000112 "Definition from: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html"^^xsd:string ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> .

<http://purl.org/ontology/bibo/volume> a owl:DatatypeProperty ;
    rdfs:label "volume" ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/locator> .

<http://purl.org/spar/c4o/> rdfs:label "Citation Counting and Context Characterization Ontology" .

<http://purl.org/spar/c4o/hasGlobalCountDate> a owl:ObjectProperty ;
    rdfs:label "has global count date" ;
    ns1:IAO_0000115 "The date on which the global citation count of the cited entity was recorded from a named bibliographic information source."^^xsd:string ;
    rdfs:domain <http://purl.org/spar/c4o/GlobalCitationCount> ;
    rdfs:range ns6:DateTimeValue ;
    rdfs:subPropertyOf ns6:dateTimeValue .

<http://purl.org/spar/c4o/hasGlobalCountSource> a owl:ObjectProperty ;
    rdfs:label "has global count source" ;
    ns1:IAO_0000115 "A property linking an instance of c40:GlobalCitationCount to the bibliographic information source providing the global citation count information for a particular publication on a particular date."^^xsd:string ;
    ns5:descriptionAnnot "A property linking the property c40:GlobalCitationCount to the bibliographic information source providing the global citation count information for a particular publication on a particular date."^^xsd:string ;
    rdfs:domain <http://purl.org/spar/c4o/GlobalCitationCount> ;
    rdfs:range <http://purl.org/spar/c4o/BibliographicInformationSource> .

<http://purl.org/spar/c4o/hasGlobalCountValue> a owl:DatatypeProperty ;
    rdfs:label "has global count value" ;
    ns1:IAO_0000115 "An integer defining the value of the global citation count of a cited entity recorded from a named bibliographic information source on a particular date."^^xsd:string ;
    ns5:descriptionAnnot "An integer defining the value of the global citation count of a cited entity recorded from a named bibliographic information source on a particular date."^^xsd:string ;
    rdfs:domain <http://purl.org/spar/c4o/GlobalCitationCount> ;
    rdfs:range xsd:int .

<http://purl.org/spar/cito/> rdfs:label "CiTO (Citation Typing Ontology)" .

<http://purl.org/spar/fabio/> rdfs:label "FaBiO (FRBR-Aligned Bibliographic Ontology)" .

<http://purl.org/spar/fabio/ClinicalGuideline> a owl:Class ;
    rdfs:label "Clinical Guideline" ;
    ns1:IAO_0000115 "A recommendation on the appropriate treatment and care of people with a specific disease or condition, based on the best available evidence, designed to help healthcare professionals in their work."^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

<http://purl.org/spar/fabio/Comment> a owl:Class ;
    rdfs:label "Comment" ;
    ns1:IAO_0000115 "A verbal or written remark concerning some entity. In written form, a comment is often appended to that entity and termed an annotation. Within computer programs or ontologies, comments are added to enhance human understanding, and are usually prefaced by"^^xsd:string,
        "A verbal or written remark concerning some entity. In written form, a comment is often appended to that entity and termed an annotation. Within computer programs or ontologies, comments are added to enhance human understanding, and are usually prefaced by a special syntactic symbol that ensures they are ignored during execution of the program.\\n\\nhas super-classes"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

<http://purl.org/spar/fabio/Erratum> a owl:Class ;
    rdfs:label "Erratum" ;
    ns1:IAO_0000115 "A formal correction to an error introduced by the publisher into a previously published document."^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

vann:preferredNamespaceUri a owl:DatatypeProperty ;
    rdfs:label "preferred namespace URI" .

<http://vitro.mannlib.cornell.edu/ns/vitro/0.7> rdfs:label "Vitro internals"^^xsd:string .

ns5:descriptionAnnot a owl:AnnotationProperty .

ns5:moniker rdfs:label "moniker (deprecated)" .

<http://vitro.mannlib.cornell.edu/ns/vitro/public> rdfs:label "Vitro Public Ontology" .

<http://vitro.mannlib.cornell.edu/ns/vitro/public#File> rdfs:label "File" .

<http://vitro.mannlib.cornell.edu/ns/vitro/public#FileByteStream> rdfs:label "FileByteStream" .

ns6:Abstract a owl:Class ;
    rdfs:label "Abstract" ;
    ns1:IAO_0000115 "An abstract that is published as a standalone document or in a journal of abstracts"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:AcademicDepartment a owl:Class ;
    rdfs:label "Academic Department" ;
    ns1:IAO_0000112 "Endodontics (department within a College of Dentistry); English (department within a College of Liberal Arts)"^^xsd:string ;
    ns1:IAO_0000115 "A distinct, usually specialized educational unit within an educational organization."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf ns6:Department .

ns6:AcademicTerm a owl:Class ;
    rdfs:label "Academic Term" ;
    ns1:IAO_0000115 "An explicit individual academic term, quarter, or semester rather than the generic fall, spring or summer semester."^^xsd:string ;
    rdfs:subClassOf ns6:DateTimeInterval .

ns6:AcademicYear a owl:Class ;
    rdfs:label "Academic Year" ;
    ns1:IAO_0000115 "An explicit individual period considered by an academic institution to be its primary academic cycle."^^xsd:string ;
    rdfs:subClassOf ns6:DateTimeInterval .

ns6:AdministratorRole a owl:Class ;
    rdfs:label "Administrator Role" ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:AdvisingProcess a owl:Class ;
    rdfs:label "Advising Process" ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns6:Association a owl:Class ;
    rdfs:label "Association" ;
    ns1:IAO_0000112 "Special Libraries Association; Association for Computing Machinery(ACM); American Medical Informatics Association(AMIA)"^^xsd:string ;
    ns1:IAO_0000115 "A formal organization of people or groups of people around a subject or practice."^^xsd:string,
        "A group of persons or organizations organized for a common purpose."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:AttendeeRole a owl:Class ;
    rdfs:label "Attendee Role" ;
    ns1:IAO_0000115 "A role of attending an Event or EventSeries"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:AttendingProcess a owl:Class ;
    rdfs:label "Attending Process" ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns6:AwardReceipt a owl:Class ;
    rdfs:label "Award or Honor Receipt" ;
    ns1:IAO_0000112 "The award bestowed may be represented with the Award class."^^xsd:string ;
    ns1:IAO_0000115 "The bestowal of an award, honor, or distinction to a person or person's at a particular time."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:assignedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeValue ;
            owl:onProperty ns6:dateTimeValue ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:assignedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeValue ;
            owl:onProperty ns6:dateTimeValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:Award ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:Award ],
        ns6:Relationship .

ns6:AwardedDegree a owl:Class ;
    rdfs:label "Awarded Degree" ;
    ns1:IAO_0000115 "The awarding of a degree by an agent to another agent. It is mostly for academic degrees." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:AcademicDegree ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Person ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns6:AcademicDegree ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Person ],
        ns6:Relationship .

ns6:BlogPosting a owl:Class ;
    rdfs:label "Blog Posting" ;
    ns1:IAO_0000112 "A specific blog posting"^^xsd:string ;
    ns1:IAO_0000115 "An online article or commentary appearing on a blog"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:Blog ;
            owl:onProperty ns6:hasPublicationVenue ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Blog ;
            owl:onProperty ns6:hasPublicationVenue ],
        <http://purl.org/ontology/bibo/Article> .

ns6:Building a owl:Class ;
    rdfs:label "Building" ;
    ns1:IAO_0000112 "Enter building name. If the building's name is a number (as in many governmental organizations such as national laboratories and military bases), then enter it. Do not confuse with the number that appears in a postal address."^^xsd:string,
        "Martha Van Rensselaer Hall (VR); Caldwell Hall (CD); University Auditorium"^^xsd:string ;
    ns1:IAO_0000115 "Building that provides a particular service or is used for a particular activity."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns6:Room ;
            owl:onProperty ns1:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Facility ;
            owl:onProperty ns1:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Room ;
            owl:onProperty ns1:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:Facility ;
            owl:onProperty ns1:BFO_0000050 ],
        ns6:Facility .

ns6:Campus a owl:Class ;
    rdfs:label "Campus" ;
    ns1:IAO_0000112 "Cornell Ithaca; Cornell Geneva; Cornell New York City; Cornell Qatar"^^xsd:string,
        "Definition taken from dictionary.com (http://dictionary.reference.com/browse/campus)."^^xsd:string ;
    ns1:IAO_0000115 "The grounds of a school, college, university, or hospital. Or, a large, usually suburban, landscaped business or industrial site."^^xsd:string ;
    rdfs:subClassOf ns6:GeographicLocation .

ns6:CaseStudy a owl:Class ;
    rdfs:label "Case Study" ;
    ns1:IAO_0000112 "A form of qualitative descriptive research that is used to study individuals, a small group of participants, or a group as a whole. Medical usage (from MeSH): clinical presentations that may be followed by evaluative studies that eventually lead to a diagnosis."^^xsd:string ;
    ns1:IAO_0000115 "A qualitative descriptive research study of individuals or a group"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:Catalog a owl:Class ;
    rdfs:label "Catalog" ;
    ns1:IAO_0000112 "NLM Catalog"^^xsd:string,
        "Short Definition is the Medical Subject Heading (MeSH) definition"^^xsd:string ;
    ns1:IAO_0000115 "A list of items in a collection; an ordered compilation of item descriptions and sufficient information to afford access to them"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        <http://purl.org/ontology/bibo/Document> .

ns6:Certificate a owl:Class ;
    rdfs:label "Certificate" ;
    ns1:IAO_0000112 "A document confirming certain characteristics of a person or organization, usually provided by some form of external review, education, or assessment."^^xsd:string ;
    ns1:IAO_0000115 "A document confirming certain characteristics of a person or organization, usually provided by some form of external review, education, or assessment."^^xsd:string ;
    rdfs:subClassOf ns6:Credential .

ns6:Certification a owl:Class ;
    rdfs:label "Certification" ;
    ns1:IAO_0000112 "see also core:Certificate"^^xsd:string ;
    ns1:IAO_0000115 "An issued certificate"^^xsd:string ;
    rdfs:subClassOf ns6:IssuedCredential .

ns6:ClinicalOrganization a owl:Class ;
    rdfs:label "Clinical Organization" ;
    ns1:IAO_0000112 "In the future we may be able to make this a defined class that would not need to be directly asserted, but the consensus seems to be that some organizations \"are\" clinical and some \"are\" research organizations and that the distinction is important enough to warrant the additional class and class assertions"^^xsd:string ;
    ns1:IAO_0000115 "Any organization that offers significant health services or routinely provides medical care to patients."^^xsd:string,
        "Any organization with a significant clinical function as a matter of course and not just through occasional clinical roles"^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:ClinicalRole a owl:Class ;
    rdfs:label "Clinical Role" ;
    ns1:IAO_0000115 "A role of observing or treating patients"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:CoPrincipalInvestigatorRole a owl:Class ;
    rdfs:label "Co-Principal Investigator Role" ;
    ns1:IAO_0000115 "Role of co-principal investigator of an Agreement (for example, a grant), who devotes a specified percentage of time and is considered key personnel."^^xsd:string ;
    rdfs:subClassOf ns6:InvestigatorRole .

ns6:College a owl:Class ;
    rdfs:label "College" ;
    ns1:IAO_0000112 "College of Arts & Sciences; Ivy Tech Community College"^^xsd:string ;
    ns1:IAO_0000115 "A primary academic unit within a University or a free-standing higher education organization without graduate degree programs"^^xsd:string,
        "A primary academic unit within a University or a free-standing higher education organization without graduate degree programs."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Committee a owl:Class ;
    rdfs:label "Committee" ;
    ns1:IAO_0000112 "Curriculum Steering Committee; PhD Advisory Committee"^^xsd:string,
        "There could be many subclasses such as thesis committee or tenure committee, but these may typically be differentiated via the moniker unless distinct properties become important."^^xsd:string ;
    ns1:IAO_0000115 "A group of people organized for a specific purpose (e.g., a reporting or advisory role), often with a charge and for a specific duration"^^xsd:string,
        "A group of people organized for a specific purpose, whose members are often selected from a larger group to serve for designated periods of time."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Group .

ns6:Competition a owl:Class ;
    rdfs:label "Competition" ;
    ns1:IAO_0000112 "Intel Talent Search; poetry contest"^^xsd:string,
        "Not the same as an award or distinction."^^xsd:string ;
    ns1:IAO_0000115 "An occasion on which a winner is selected from among two or more contestants."^^xsd:string ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> .

ns6:ConferencePaper a owl:Class ;
    rdfs:label "Conference Paper" ;
    ns1:IAO_0000115 "A paper presented at a conference; optionally collected into a Proceedings or a special Journal issue"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Conference> ;
            owl:onProperty <http://purl.org/ontology/bibo/presentedAt> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/ontology/bibo/Conference> ;
            owl:onProperty <http://purl.org/ontology/bibo/presentedAt> ],
        <http://purl.org/ontology/bibo/Article> .

ns6:ConferencePoster a owl:Class ;
    rdfs:label "Conference Poster" ;
    ns1:IAO_0000115 "The digital file (or physical equivalent), if available after the conference, vs. the act of attending/presenting: use ConferencePresentation for information about date/time/location/name of the event where the poster was presented"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:ConferenceSeries a owl:Class ;
    rdfs:label "Conference Series" ;
    ns1:IAO_0000112 "For individual, separate conferences, use conference instead.  core:ConferenceSeries and core:SeminarSeries are very similar."^^xsd:string ;
    ns1:IAO_0000115 "An organized series of a meeting for consultation or discussion."^^xsd:string ;
    rdfs:subClassOf ns6:EventSeries .

ns6:Consortium a owl:Class ;
    rdfs:label "Consortium" ;
    ns1:IAO_0000112 "Committee on Institutional Cooperation (CIC); The Five Colleges of Ohio"^^xsd:string ;
    ns1:IAO_0000115 "A group  of independent organizations working together toward a common goal, under an expressed agreement."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Continent a owl:Class ;
    rdfs:label "Continent" ;
    ns1:IAO_0000112 "Short Definition take from http://en.wiktionary.org/wiki/continent."^^xsd:string,
        "The seven commonly recognized continents are Africa; Antarctica; Asia; Australia; Europe; North America; South America"^^xsd:string ;
    ns1:IAO_0000115 "A large contiguous landmass  that is at least partially surrounded by water, together with any islands on its continental shelf."^^xsd:string ;
    rdfs:subClassOf ns6:GeographicRegion .

ns6:CoreLaboratory a owl:Class ;
    rdfs:label "Core Laboratory" ;
    ns1:IAO_0000115 "A lab providing services such as training, protocols, or access to instruments or software"^^xsd:string ;
    rdfs:subClassOf ns6:ServiceProvidingLaboratory .

ns6:County a owl:Class ;
    rdfs:label "County" ;
    ns1:IAO_0000112 "Alachua; Baker; Bradford; Kenora; Ottawa; Waterloo"^^xsd:string,
        "Short Definition modified from the one found here: http://www.thefreedictionary.com/county."^^xsd:string ;
    ns1:IAO_0000115 "The largest administrative division of most states or provinces."^^xsd:string ;
    rdfs:subClassOf ns6:GeopoliticalEntity .

ns6:Database a owl:Class ;
    rdfs:label "Database" ;
    ns1:IAO_0000112 "PubMed"^^xsd:string,
        "Short Definition is the Medical Subject Heading (MeSH) definition"^^xsd:string ;
    ns1:IAO_0000115 "A structured file of information or a set of logically related data stored and retrieved using computer-based means"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty ns6:publisher ],
        <http://purl.org/ontology/bibo/CollectedDocument> .

ns6:Division a owl:Class ;
    rdfs:label "Division" ;
    ns1:IAO_0000112 "Cardiovascular Medicine (division within medicine)"^^xsd:string,
        "Definition modified from http://www.thefreedictionary.com/division.  It is difficult to tell the difference between a division and a department."^^xsd:string ;
    ns1:IAO_0000115 "A major unit or section within a larger organization."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf ns6:ExtensionUnit,
        foaf:Organization .

ns6:EditorRole a owl:Class ;
    rdfs:label "Editor Role" ;
    ns1:IAO_0000112 "An ongoing editorial responsibility for a bibo:Collection, such as a Journal or Series"^^xsd:string ;
    ns1:IAO_0000115 "An ongoing editorial responsibility for a bibo:Collection, such as a Journal or Series"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:EditorialArticle a owl:Class ;
    rdfs:label "Editorial Article" ;
    ns1:IAO_0000115 "An article of opinion, typically published in a newspaper. For academics, most commonly Op Ed pieces"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Article> .

ns6:Editorship a owl:Class ;
    rdfs:label "Editorship" ;
    ns1:IAO_0000115 "A relationship that represents the recognition of an agent as an editor." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        ns6:Relationship .

ns6:EmeritusLibrarian a owl:Class ;
    rdfs:label "Librarian Emeritus" ;
    ns1:IAO_0000115 "A retired librarian who has retained their rank, title and privileges."^^xsd:string ;
    rdfs:subClassOf foaf:Person .

ns6:EmeritusProfessor a owl:Class ;
    rdfs:label "Professor Emeritus" ;
    ns1:IAO_0000115 "A retired professor who has retained their rank, title and privileges."^^xsd:string ;
    rdfs:subClassOf ns6:EmeritusFaculty,
        foaf:Person .

ns6:Exhibit a owl:Class ;
    rdfs:label "Exhibit" ;
    ns1:IAO_0000115 "The showing of an object or a collection of objects, in an organized manner."^^xsd:string ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> .

ns6:F1000Link a owl:Class ;
    rdfs:label "F1000 Link" ;
    ns1:IAO_0000112 "F1000 is a place where faculty go to critique papers published in PubMed. Any given record in F1000 might have anywhere from one to dozens of reviews."^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#URL> .

ns6:FacultyAdministrativePosition a owl:Class ;
    rdfs:label "Faculty Administrative Position" ;
    ns1:IAO_0000112 "Associate Dean"^^xsd:string,
        "That is a position held by an academic faculty member who works for administration."^^xsd:string ;
    ns1:IAO_0000115 "An academic administrative position (associate dean, etc.) as distinct from a professional administrative position (non-academic)"^^xsd:string ;
    rdfs:subClassOf ns6:Position .

ns6:FacultyMember a owl:Class ;
    rdfs:label "Faculty Member" ;
    ns1:IAO_0000115 "A person with at least one academic appointment to a specific faculty of a university or institution of higher learning."^^xsd:string ;
    ns5:descriptionAnnot "Definition from here: http://research.carleton.ca/htr/defs.php."^^xsd:string ;
    rdfs:subClassOf foaf:Person .

ns6:FacultyMentoringRelationship a owl:Class ;
    rdfs:label "Faculty Mentoring Relationship" ;
    ns1:IAO_0000115 "An advisory relationship in which one faculty member mentors another faculty member."^^xsd:string ;
    rdfs:subClassOf ns6:AdvisingRelationship .

ns6:FacultyPosition a owl:Class ;
    rdfs:label "Faculty Position" ;
    ns1:IAO_0000112 "Professor, associate professor and assistant professor are common positions for academic faculty."^^xsd:string,
        "Professor; Associate Professor; Assistant Professor"^^xsd:string ;
    ns1:IAO_0000115 "Academic position in a university or institution"^^xsd:string ;
    rdfs:subClassOf ns6:Position .

ns6:Foundation a owl:Class ;
    rdfs:label "Foundation" ;
    ns1:IAO_0000112 "Definition take from: http://dictionary.reference.com/browse/foundation."^^xsd:string,
        "The Ford Foundation"^^xsd:string ;
    ns1:IAO_0000115 "An institution founded with an endowment to support educational, research, artistic or other charitable activities."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:GovernmentAgency a owl:Class ;
    rdfs:label "Government Agency" ;
    ns1:IAO_0000112 "Definition take from: http://en.wikipedia.org/wiki/Government_agency."^^xsd:string,
        "United States Library of Congress"^^xsd:string ;
    ns1:IAO_0000115 "A unit of government responsible for oversight and regulation of certain activities or the administration and provision of specific services."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:GraduateAdvisingRelationship a owl:Class ;
    rdfs:label "Graduate Advising Relationship" ;
    ns1:IAO_0000115 "An advisory relationship in which a professor advises a graduate student."^^xsd:string ;
    rdfs:subClassOf ns6:AdvisingRelationship .

ns6:GraduateStudent a owl:Class ;
    rdfs:label "Graduate Student" ;
    ns1:IAO_0000115 "A person who has already received a bachelor's degree and is working toward a Master's or Doctoral degree."^^xsd:string ;
    rdfs:subClassOf ns6:Student .

ns6:Hospital a owl:Class ;
    rdfs:label "Hospital" ;
    ns1:IAO_0000112 "Definition take from: http://dictionary.reference.com/browse/hospital."^^xsd:string,
        "Shands at the University of Florida"^^xsd:string ;
    ns1:IAO_0000115 "An institution that provides medical, surgical, psychiatric or nursing care."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Institute a owl:Class ;
    rdfs:label "Institute" ;
    ns1:IAO_0000112 "Institute for Fundamental Theory"^^xsd:string ;
    ns1:IAO_0000115 "An Institute normally has a research focus but may also fulfill instructional or outreach roles"^^xsd:string,
        "An organization founded to pursue or promote certain research, educational or public policy interests or activities."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Internship a owl:Class ;
    rdfs:label "Internship" ;
    ns1:IAO_0000115 "Typically a student or a recent graduate undergoing supervised practical training."^^xsd:string ;
    rdfs:subClassOf ns6:EducationalProcess .

ns6:InvitedTalk a owl:Class ;
    rdfs:label "Invited Talk" ;
    rdfs:subClassOf ns6:Presentation .

ns6:LeaderRole a owl:Class ;
    rdfs:label "Leader Role" ;
    ns1:IAO_0000112 "A broad-ranging leader concept, from leading a small temporary committee to head of a large international organization."^^xsd:string ;
    ns1:IAO_0000115 "A leadership role"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:Librarian a owl:Class ;
    rdfs:label "Librarian" ;
    ns1:IAO_0000115 "A person working in a position of librarian or information professional, or academic or technical expert in support of providing information services or materials."^^xsd:string ;
    rdfs:subClassOf foaf:Person .

ns6:LibrarianPosition a owl:Class ;
    rdfs:label "Librarian Position" ;
    ns1:IAO_0000112 "It is the common position in libraries."^^xsd:string,
        "Librarian; Library Systems Analyst; Music Bibliographer"^^xsd:string ;
    ns1:IAO_0000115 "A position held  by library and information science professionals, or academic or technical experts, in support of providing information services or materials"^^xsd:string ;
    rdfs:subClassOf ns6:Position .

ns6:Library a owl:Class ;
    rdfs:label "Library" ;
    ns1:IAO_0000112 "Marston Science Library"^^xsd:string,
        "Used information from this definition: http://dictionary.reference.com/browse/library."^^xsd:string ;
    ns1:IAO_0000115 "An organization maintaining one or more collections of physical and/or electronic information resources for access or lending."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:License a owl:Class ;
    rdfs:label "License" ;
    ns1:IAO_0000112 "Licenses are usually issued in order to regulate some activity that is deemed to be dangerous or a threat to the person or the public or which involves a high level of specialized skill.  See also core:Licensure."^^xsd:string ;
    ns1:IAO_0000115 "Official or legal permission to do something"^^xsd:string ;
    rdfs:subClassOf ns6:Credential .

ns6:MedicalResidency a owl:Class ;
    rdfs:label "Medical Residency" ;
    ns1:IAO_0000115 "Residency is a stage of graduate medical training."^^xsd:string ;
    rdfs:subClassOf ns6:EducationalProcess .

ns6:Meeting a owl:Class ;
    rdfs:label "Meeting" ;
    ns1:IAO_0000115 "A gathering of people for a defined purpose, not necessarily public or announced"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> .

ns6:MemberRole a owl:Class ;
    rdfs:label "Member Role" ;
    ns1:IAO_0000115 "A role of being a member in a Process or an Organization"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:Museum a owl:Class ;
    rdfs:label "Museum" ;
    ns1:IAO_0000112 "Definition was take from here:  http://dictionary.reference.com/browse/museum"^^xsd:string,
        "The Getty Museum"^^xsd:string ;
    ns1:IAO_0000115 "An organization devoted to the acquisition, conservation, study, exhibition, and educational interpretation of objects having scientific, historical, cultural or artistic value."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:NewsRelease a owl:Class ;
    rdfs:label "News Release" ;
    ns1:IAO_0000115 "A short written piece focused on an event or announcement of note, having a defined publication time and of less enduring interest than a news feature."^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:Newsletter a owl:Class ;
    rdfs:label "Newsletter" ;
    ns1:IAO_0000112 "The Ornithological Newsletter"^^xsd:string ;
    ns1:IAO_0000115 "Usually issued periodically, prepared by or for a group or institution to present information to a specific audience, often also made available to the press and public"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Periodical> .

ns6:NonAcademic a owl:Class ;
    rdfs:label "Non-Academic" ;
    ns1:IAO_0000115 "A person holding a position that is not considered to be an academic appointment."^^xsd:string ;
    rdfs:subClassOf foaf:Person .

ns6:NonAcademicPosition a owl:Class ;
    rdfs:label "Non-Academic Position" ;
    ns1:IAO_0000112 "Accounting & Research Services Assistant; Director of Information Technology"^^xsd:string,
        "Staff, support, and other non-academic positions."^^xsd:string ;
    ns1:IAO_0000115 "A position classified as professional, staff, support, or any other non-academic role"^^xsd:string ;
    rdfs:subClassOf ns6:Position .

ns6:OrganizerRole a owl:Class ;
    rdfs:label "Organizer Role" ;
    ns1:IAO_0000115 "A role of organizing"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:OrganizingProcess a owl:Class ;
    rdfs:label "Organizing Process" ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns6:OutreachProviderRole a owl:Class ;
    rdfs:label "Outreach Provider Role" ;
    ns1:IAO_0000112 "Communicating Astronomy to the Public"^^xsd:string,
        "The example is one outreach role required by US space agency NASA, which is related with one project in NASA. Name of the outreach role should be put here."^^xsd:string ;
    ns1:IAO_0000115 "An outreach or community service role directed outside a person's primary profession and institution"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:PeerReviewerRole a owl:Class ;
    rdfs:label "Peer Reviewer Role" ;
    ns1:IAO_0000112 "is a generic term for a process of self-regulation by a profession or a process of evaluation involving qualified individuals within the relevant field. Peer review methods are employed to maintain standards, improve performance and provide credibility. In academia  the term is often used to denote a prepublication review of academic papers; reviewing an academic paper is often called refereeing.\\nContents\\n[hide]"^^xsd:string ;
    ns1:IAO_0000115 "A role of peer reviewing"^^xsd:string ;
    rdfs:subClassOf ns6:ReviewerRole .

ns6:PopulatedPlace a owl:Class ;
    rdfs:label "Populated Place" ;
    ns1:IAO_0000115 "Either city or town - a thickly populated area having fixed boundaries and certain local powers of government."^^xsd:string ;
    rdfs:subClassOf ns6:GeopoliticalEntity .

ns6:Postdoc a owl:Class ;
    rdfs:label "Postdoc" ;
    ns1:IAO_0000115 "A Person holding an academic employment appointment focused on research rather than teaching; temporary (or for some defined term)"^^xsd:string ;
    rdfs:subClassOf ns6:NonFacultyAcademic .

ns6:PostdocOrFellowAdvisingRelationship a owl:Class ;
    rdfs:label "Postdoc or Fellow Advising Relationship" ;
    ns1:IAO_0000115 "An advisory relationship in which the advisee is a Postdoc or Fellow."^^xsd:string ;
    rdfs:subClassOf ns6:AdvisingRelationship .

ns6:PostdocPosition a owl:Class ;
    rdfs:label "Postdoctoral Position" ;
    ns1:IAO_0000115 "A postdoctoral training appointment (job)"^^xsd:string ;
    rdfs:subClassOf ns6:NonFacultyAcademicPosition .

ns6:PostdoctoralTraining a owl:Class ;
    rdfs:label "Postdoctoral Training" ;
    ns1:IAO_0000115 "Postdoctoral research is academic or scholarly research conducted by a person who has completed his or her doctoral studies, normally within the following five years. It is intended to further deepen expertise in a specialist subject."^^xsd:string ;
    rdfs:subClassOf ns6:EducationalProcess .

ns6:PresenterRole a owl:Class ;
    rdfs:label "Presenter Role" ;
    ns1:IAO_0000112 "Are we assuming that a PresenterRole is in a Presentation?  Or could you have a PresenterRole in, say, a committee?"^^xsd:string ;
    ns1:IAO_0000115 "A role of presenting information"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:PresentingProcess a owl:Class ;
    rdfs:label "Presenting Process" ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns6:PrimaryPosition a owl:Class ;
    rdfs:label "Primary Position" ;
    ns1:IAO_0000112 "A position designated as primary by the organization or group where it is held. This designation may be applied to zero or more of an agent's positions and may be asserted in conjunction with other subclasses of position."^^xsd:string ;
    ns1:IAO_0000115 "A position designated as primary by the organization where it is held."^^xsd:string ;
    rdfs:subClassOf ns6:Position .

ns6:PrincipalInvestigatorRole a owl:Class ;
    rdfs:label "Principal Investigator Role" ;
    ns1:IAO_0000115 "Role of a person to direct a project or activity being supported by an Agreement (for example, a grant), and who is accountable to the grantee for the proper conduct of the project or activity. Also known as Program Director or Project Director."^^xsd:string ;
    rdfs:subClassOf ns6:InvestigatorRole .

ns6:PrivateCompany a owl:Class ;
    rdfs:label "Private Company" ;
    ns1:IAO_0000112 "Definition obtained here: http://answers.ask.com/Business/Finance/what_is_a_private_company.  Examples of private companies found here: http://www.forbes.com/2008/11/03/largest-private-companies-biz-privates08-cx_sr_1103private_land.html"^^xsd:string,
        "Publix Super Markets; Ernst & Young; PricewaterhouseCoopers"^^xsd:string ;
    ns1:IAO_0000115 "A private company is one that is privately-owned, and thus, is not publicly-traded in the stock market. Members of the general public cannot purchase stock in a private company unless that company chooses to go public and become a public company."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf ns6:Company .

ns6:Program a owl:Class ;
    rdfs:label "Program" ;
    ns1:IAO_0000112 "A Cornell graduate field (http://vivo.cornell.edu/index.jsp?home=65535&collection=820)"^^xsd:string ;
    ns1:IAO_0000115 "An ongoing academic initiative not formalized with department or division status."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Publisher a owl:Class ;
    rdfs:label "Publisher" ;
    ns1:IAO_0000112 "Definition found here: http://dictionary.reference.com/browse/publisher"^^xsd:string,
        "Elsevier; Harper & Row; Indiana University Press"^^xsd:string ;
    ns1:IAO_0000115 "A person or company whose business is the publishing of books, periodicals, engravings, computer software, etc."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:ResearchOrganization a owl:Class ;
    rdfs:label "Research Organization" ;
    ns1:IAO_0000115 "Any organization (likely also asserted as another class of Organization) with a primary, ongoing research function, not just through occasional roles"^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:ResearchProposal a owl:Class ;
    rdfs:label "Research Proposal" ;
    ns1:IAO_0000115 "A proposal for a research grant that has been submitted but not approved; does not represent an existing activity"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:School a owl:Class ;
    rdfs:label "School" ;
    ns1:IAO_0000112 "Definition take from here: http://dictionary.reference.com/browse/school."^^xsd:string,
        "School of Architecture; School of Music"^^xsd:string ;
    ns1:IAO_0000115 "An institution for instruction in a particular skill or field."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Score a owl:Class ;
    rdfs:label "Score" ;
    ns1:IAO_0000115 "Written musical composition for voice or instruments or both"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:Screenplay a owl:Class ;
    rdfs:label "Screenplay" ;
    ns1:IAO_0000115 "Written script for a film production, including dialogue and descriptions of gestures, actions, shooting directions"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:SeminarSeries a owl:Class ;
    rdfs:label "Seminar Series" ;
    ns1:IAO_0000112 "Applied Microeconomics Seminars; Future of Rural New York Seminar Series"^^xsd:string,
        "For individual seminars, use seminar instead.  core:ConferenceSeries and core:SeminarSeries are very similar."^^xsd:string ;
    ns1:IAO_0000115 "An organized series of a meeting for an exchange of ideas, typically put on by a department or center."^^xsd:string ;
    rdfs:subClassOf ns6:EventSeries .

ns6:Speech a owl:Class ;
    rdfs:label "Speech" ;
    ns1:IAO_0000115 "Text of a speech written in preparation for delivery of the speech."^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:StateOrProvince a owl:Class ;
    rdfs:label "State or Province" ;
    ns1:IAO_0000112 "Minnesota; Michigan; Indiana; New York; Quebec; Manitoba; Ontario"^^xsd:string,
        "Source of the Short Definition: http://www.thefreedictionary.com/state."^^xsd:string ;
    ns1:IAO_0000115 "One of a number of areas or communities having their own governments and forming a federation under a sovereign government, as in the US."^^xsd:string ;
    rdfs:subClassOf ns6:GeopoliticalEntity .

ns6:StudentOrganization a owl:Class ;
    rdfs:label "Student Organization" ;
    ns1:IAO_0000112 "Dancin' Gators"^^xsd:string,
        "Definition take from here: http://en.wikipedia.org/wiki/Student_society"^^xsd:string ;
    ns1:IAO_0000115 "A student organization is an organization, operated by students at a university, whose membership normally consists only of students."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:SubnationalRegion a owl:Class ;
    rdfs:label "Subnational Region" ;
    ns1:IAO_0000112 "Boroughs; townships; districts; the Midwest"^^xsd:string,
        "Short definition was partially taken from http://en.wikipedia.org/wiki/Subnational_entity."^^xsd:string ;
    ns1:IAO_0000115 "Smaller administrative division into which a country may be divided."^^xsd:string ;
    rdfs:comment "For example, the Midwest, northeast U.S."^^xsd:string ;
    rdfs:subClassOf ns6:GeographicRegion .

ns6:TeacherRole a owl:Class ;
    rdfs:label "Teacher Role" ;
    ns1:IAO_0000115 "A role of serving as an educator"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:Team a owl:Class ;
    rdfs:label "Team" ;
    ns1:IAO_0000112 "VIVO Outreach Team; VIVO Ontology Team"^^xsd:string ;
    ns1:IAO_0000115 "A group of people working together."^^xsd:string,
        "An informal organization brought together for the purposes of a project or event"^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Group .

ns6:Translation a owl:Class ;
    rdfs:label "Translation" ;
    ns1:IAO_0000115 "The result of rendering a work from one language to another"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

ns6:UndergraduateAdvisingRelationship a owl:Class ;
    rdfs:label "Undergraduate Advising Relationship" ;
    ns1:IAO_0000115 "An advisory relationship in which a professor advises an undergraduate student."^^xsd:string ;
    rdfs:subClassOf ns6:AdvisingRelationship .

ns6:UndergraduateStudent a owl:Class ;
    rdfs:label "Undergraduate Student" ;
    ns1:IAO_0000115 "A person registered in an undergraduate program leading to a bachelor's degree or an undergraduate diploma or certificate."^^xsd:string ;
    rdfs:subClassOf ns6:Student .

ns6:University a owl:Class ;
    rdfs:label "University" ;
    ns1:IAO_0000112 "Definition taken from: http://en.wikipedia.org/wiki/University"^^xsd:string,
        "University of Florida; Washington University in St. Louis"^^xsd:string ;
    ns1:IAO_0000115 "An institution of higher education and research, which grants academic degrees in a variety of subjects, and provides both undergraduate education and postgraduate education."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Video a owl:Class ;
    rdfs:label "Video" ;
    ns1:IAO_0000115 "Audiovisual recording in video format"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/AudioVisualDocument> .

ns6:WorkingPaper a owl:Class ;
    rdfs:label "Working Paper" ;
    ns1:IAO_0000115 "A document created as a basis for discussion or a very early draft of a formal paper"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:placeOfPublication ],
        <http://purl.org/ontology/bibo/Document> .

ns6:WorkshopSeries a owl:Class ;
    rdfs:label "Workshop Series" ;
    ns1:IAO_0000112 "Use workshop for individual events."^^xsd:string ;
    ns1:IAO_0000115 "An organized series of workshop events, whether repetitions of the same workshop or multiple different workshops."^^xsd:string ;
    rdfs:subClassOf ns6:EventSeries .

ns6:affiliatedOrganization a owl:ObjectProperty ;
    rdfs:label "has affiliated organization" ;
    rdfs:domain foaf:Organization ;
    rdfs:range foaf:Organization .

ns6:assigneeFor a owl:ObjectProperty ;
    rdfs:label "assignee for patent" ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://purl.org/ontology/bibo/Patent> ;
    owl:inverseOf ns6:assignee .

ns6:cclCode a owl:DatatypeProperty ;
    rdfs:label "published US Classification Class/subclass (CCL) code" ;
    rdfs:domain <http://purl.org/ontology/bibo/Patent> .

ns6:dateFiled a owl:ObjectProperty ;
    rdfs:label "date filed" ;
    rdfs:domain <http://purl.org/ontology/bibo/Patent> ;
    rdfs:range ns6:DateTimeValue ;
    rdfs:subPropertyOf ns6:dateTimeValue .

ns6:dateTime a owl:ObjectProperty ;
    rdfs:label "date/time" ;
    rdfs:domain ns6:DateTimeValue ;
    rdfs:range ns6:DateTimeValue ;
    rdfs:subPropertyOf ns6:dateTimeValue .

ns6:dateTimePrecision a owl:ObjectProperty ;
    rdfs:label "date/time precision" ;
    rdfs:domain ns6:DateTimeValue ;
    rdfs:range ns6:DateTimeValuePrecision .

ns6:degreeCandidacy a owl:ObjectProperty ;
    rdfs:label "degree candidacy" ;
    rdfs:domain ns6:AdvisingRelationship ;
    rdfs:range ns6:AcademicDegree .

ns6:departmentOrSchool a owl:DatatypeProperty ;
    rdfs:label "department or school name within institution" ;
    ns5:descriptionAnnot "Not intended to be an institution name."^^xsd:string ;
    rdfs:domain ns6:EducationalProcess .

ns6:distributes a owl:ObjectProperty ;
    rdfs:label "distributes" ;
    ns5:descriptionAnnot "Public Description for bibo:distributor taken from here:  http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html ."^^xsd:string ;
    owl:inverseOf <http://purl.org/ontology/bibo/distributor> .

ns6:distributesFundingFrom a owl:ObjectProperty ;
    rdfs:label "distributes funding from" ;
    ns5:descriptionAnnot "For example, National Science Foundation providesFundingThrough Graduate Research Fellowship Program; National Institutes of Health providesFundingThrough National Center for Research Resources."^^xsd:string ;
    rdfs:domain ns6:FundingOrganization ;
    rdfs:range ns6:FundingOrganization ;
    owl:inverseOf ns6:providesFundingThrough .

ns6:eRACommonsId a owl:DatatypeProperty ;
    rdfs:label "eRA Commons ID" ;
    rdfs:domain foaf:Person ;
    rdfs:subPropertyOf ns6:identifier .

ns6:end a owl:ObjectProperty ;
    rdfs:label "end" ;
    rdfs:domain ns6:DateTimeInterval ;
    rdfs:range ns6:DateTimeValue ;
    rdfs:subPropertyOf ns6:dateTimeValue .

ns6:entryTerm a owl:DatatypeProperty ;
    rdfs:label "entry term" .

ns6:facilityFor a owl:ObjectProperty ;
    rdfs:domain ns6:Facility ;
    owl:inverseOf ns6:hasFacility .

ns6:fundingVehicleFor a owl:ObjectProperty ;
    rdfs:label "provides funding for" ;
    rdfs:domain ns6:Grant ;
    rdfs:subPropertyOf ns6:supports ;
    owl:inverseOf ns6:hasFundingVehicle .

ns6:geographicFocusOf a owl:ObjectProperty ;
    rdfs:label "geographic focus of" ;
    rdfs:domain ns6:GeographicRegion ;
    owl:inverseOf ns6:geographicFocus .

ns6:governingAuthorityFor a owl:ObjectProperty ;
    rdfs:label "governing authority for" ;
    rdfs:domain foaf:Organization ;
    owl:inverseOf ns6:hasGoverningAuthority .

ns6:grantDirectCosts a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "direct costs" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ],
        [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ],
        ns6:Grant .

ns6:hasCollaborator a owl:ObjectProperty ;
    rdfs:label "has collaborator" ;
    rdfs:domain foaf:Agent ;
    rdfs:range foaf:Agent .

ns6:hasEquipment a owl:ObjectProperty ;
    rdfs:label "has equipment" ;
    rdfs:domain foaf:Organization ;
    rdfs:range ns6:Equipment ;
    owl:inverseOf ns6:equipmentFor .

ns6:hasMonetaryAmount a owl:DatatypeProperty ;
    rdfs:label "has monetary amount" .

ns6:hasPredecessorOrganization a owl:ObjectProperty ;
    rdfs:label "predecessor organization" ;
    rdfs:domain foaf:Organization ;
    rdfs:range foaf:Organization ;
    owl:inverseOf ns6:hasSuccessorOrganization .

ns6:hasPrerequisite a owl:ObjectProperty ;
    rdfs:label "has prerequisite" ;
    rdfs:domain ns6:Course ;
    rdfs:range ns6:Course ;
    owl:inverseOf ns6:prerequisiteFor .

ns6:hasTranslation a owl:ObjectProperty ;
    rdfs:label "has translation" ;
    ns1:IAO_0000112 "Examples shows a book has French language version. Public description source: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html ."^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:range <http://purl.org/ontology/bibo/Document> ;
    owl:inverseOf <http://purl.org/ontology/bibo/translationOf> .

ns6:hasValue a owl:DatatypeProperty ;
    rdfs:label "has value" .

ns6:hrJobTitle a owl:DatatypeProperty ;
    rdfs:label "HR job title" ;
    ns5:descriptionAnnot "Definition http://en.wikipedia.org/wiki/Job_title#Job_title."^^xsd:string ;
    ns5:exampleAnnot "administrative secretary"^^xsd:string ;
    rdfs:domain ns6:Position .

ns6:iclCode a owl:DatatypeProperty ;
    rdfs:label "International Classification (ICL) code" ;
    ns1:IAO_0000112 "The International classification(s) to which the published application has been assigned."^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Patent> .

ns6:inPress a <http://purl.org/ontology/bibo/DocumentStatus>,
        owl:NamedIndividual ;
    rdfs:label "in press" ;
    ns1:IAO_0000115 "Document to be published"^^xsd:string ;
    ns6:description "Document to be published"^^xsd:string .

ns6:invited a <http://purl.org/ontology/bibo/DocumentStatus>,
        owl:NamedIndividual ;
    rdfs:label "invited" .

ns6:isCorrespondingAuthor a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Is this person a corresponding author?" ;
    ns5:exampleAnnot "True; False"^^xsd:string ;
    rdfs:domain ns6:Authorship ;
    rdfs:range xsd:boolean .

ns6:licenseNumber a owl:DatatypeProperty ;
    rdfs:label "license number" ;
    rdfs:domain ns6:Licensure .

ns6:localAwardId a owl:DatatypeProperty ;
    rdfs:label "local award ID" ;
    ns1:IAO_0000112 "core:localAwardId has a domain of core:Grant, and should be public since that's its public identifier for local use by OSP, accounting, department admins, and the PI"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ],
        [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ] ;
    rdfs:subPropertyOf ns6:identifier .

ns6:majorField a owl:DatatypeProperty ;
    rdfs:label "major field of degree" ;
    ns1:IAO_0000112 "Information Science; Computer Science; Anthropology"^^xsd:string ;
    rdfs:domain ns6:EducationalProcess .

ns6:middleName a owl:DatatypeProperty ;
    rdfs:label "middle name or initial" .

ns6:nihmsid a owl:DatatypeProperty ;
    rdfs:label "NIH Manuscript Submission System ID" ;
    rdfs:domain <http://purl.org/ontology/bibo/Article> ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> .

ns6:offers a owl:ObjectProperty ;
    rdfs:label "offers" ;
    owl:inverseOf ns6:offeredBy .

ns6:orcidId a owl:ObjectProperty ;
    rdfs:label "ORCID iD" ;
    ns1:IAO_0000112 "This is now an object property where the object value is a resource of the form <http://orcid.org/NNNN-NNNN-NNNN-NNNN>.  This is to support connecting VIVO and ORCID in the linked data web.   Note: a person can have multiple ORCID iDs."^^xsd:string ;
    rdfs:domain foaf:Person .

ns6:outreachOverview a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "outreach overview" ;
    ns1:IAO_0000112 "My extension program consists of developing and reporting disease management strategies that are both economically and environmentally sound for fresh market vegetable production. We hope that some of this testing will result in practices adaptable for organic production."^^xsd:string,
        "Used for a single narrative summary of outreach, typically covering a wide range of activities and time periods; use Outreach Provider Role for information on individual activities"^^xsd:string ;
    rdfs:domain foaf:Person .

ns6:overview a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "overview" ;
    rdfs:domain foaf:Agent .

ns6:patentNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "patent number" ;
    ns1:IAO_0000112 "source of definition: http://www.uspto.gov/main/glossary/#p . The following site has patent number formats: http://www.uspto.gov/patents/ebc/kindcodesum.jsp ."^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Patent> ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> .

ns6:pmcid a owl:DatatypeProperty ;
    rdfs:label "PubMed Central ID" ;
    ns1:IAO_0000112 "A PMCID is a unique PubMed Central reference number, which is assigned to each full-text record made available A PMCID is a unique PubMed Central reference number, which is assigned to each full-text record made available in PubMed Central. The PMCID is issued shortly after the PI or author approves the PubMed Central formatted web version of the submission."^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Article> ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> .

ns6:preferredDisplayOrder a owl:DatatypeProperty ;
    rdfs:label "preferred display order" .

ns6:proceedingsOf a owl:ObjectProperty ;
    rdfs:label "proceedings of" ;
    ns5:descriptionAnnot "A possible working example: The conference proceeding of the SPIE was generated from the conference - International Society for Optical Engineering."^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Proceedings> ;
    rdfs:range <http://purl.org/ontology/bibo/Conference> ;
    owl:inverseOf ns6:hasProceedings .

ns6:reportId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "report identifier" ;
    rdfs:domain <http://purl.org/ontology/bibo/Report> ;
    rdfs:subPropertyOf <http://purl.org/ontology/bibo/identifier> .

ns6:reproduces a owl:ObjectProperty ;
    rdfs:label "reproduces" ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:range <http://purl.org/ontology/bibo/Document> ;
    rdfs:subPropertyOf ns1:BFO_0000051 ;
    owl:inverseOf <http://purl.org/ontology/bibo/reproducedIn> .

ns6:researchOverview a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "research overview" ;
    ns1:IAO_0000112 "Used for a single narrative summary of research, typically covering a wide range of activities and time periods; use Researcher Role for information on individual activities"^^xsd:string ;
    rdfs:domain foaf:Person .

ns6:researcherId a owl:DatatypeProperty ;
    rdfs:label "ISI Researcher ID" ;
    ns1:IAO_0000112 "RearcherID is a Thomson Reuters project where researchers have a place to manage and share their professional information. It will allow them to solve author identity issues while simultaneously adding dynamic citation metrics and collaboration networks to your personal profile.\\nDefinition source: http://isiwebofknowledge.com/researcherid/"^^xsd:string ;
    rdfs:domain foaf:Person ;
    rdfs:subPropertyOf ns6:identifier .

ns6:scopusId a owl:DatatypeProperty ;
    rdfs:label "Scopus ID" ;
    ns1:IAO_0000112 "Home page for Scopus: http://www.scopus.com/home.url"^^xsd:string ;
    rdfs:domain foaf:Person ;
    rdfs:subPropertyOf ns6:identifier .

ns6:seatingCapacity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "seating capacity" ;
    ns1:IAO_0000112 "55"^^xsd:string,
        "definition modified from: source (http://en.wikipedia.org/wiki/Seating_capacity)."^^xsd:string ;
    rdfs:domain ns6:Room ;
    rdfs:range xsd:int .

ns6:sponsorAwardId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "sponsor award ID" ;
    ns1:IAO_0000112 "Has a domain of Grant. There is not a strong reason have this be publically visible, since most users would care more about the name of the sponsoring agency than its identifier, but it does no harm to be public.\\n\\n\\nSee also core:localAwardId."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ],
        [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ] ;
    rdfs:subPropertyOf ns6:identifier .

ns6:sponsors a owl:ObjectProperty ;
    rdfs:label "sponsors award or honor" ;
    rdfs:domain foaf:Organization ;
    rdfs:range ns6:Award ;
    owl:inverseOf ns6:sponsoredBy .

ns6:start a owl:ObjectProperty ;
    rdfs:label "start" ;
    rdfs:domain ns6:DateTimeInterval ;
    rdfs:range ns6:DateTimeValue ;
    rdfs:subPropertyOf ns6:dateTimeValue .

ns6:subcontractsGrant a owl:ObjectProperty ;
    rdfs:label "subcontracts grant" ;
    rdfs:domain foaf:Organization ;
    rdfs:range ns6:Grant ;
    owl:inverseOf ns6:grantSubcontractedThrough .

ns6:submitted a <http://purl.org/ontology/bibo/DocumentStatus>,
        owl:NamedIndividual ;
    rdfs:label "submitted" .

ns6:teachingOverview a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "teaching overview" ;
    ns1:IAO_0000112 "Used for a single narrative summary of teaching, typically covering a wide range of courses including for credit and non-credit teaching over multiple semesters; the \"teaches\" property links a person directly with an instance of a Semester Class, typically from an institutional database of record; then use Teacher Role for information about a person's role in non-credit teaching or their specific contribution to individual courses"^^xsd:string ;
    rdfs:domain foaf:Person .

ns6:termLabel a owl:DatatypeProperty ;
    rdfs:label "term label" .

ns6:termType a owl:DatatypeProperty ;
    rdfs:label "term type" .

ns6:totalAwardAmount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "total award amount" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ],
        [ a owl:Class ;
            owl:unionOf ( ns6:Contract ns6:Grant ) ] .

ns6:yearMonthDayPrecision a ns6:DateTimeValuePrecision,
        owl:NamedIndividual ;
    rdfs:label "year-month-day value",
        "yearMonthDayPrecision" .

ns6:yearMonthDayTimePrecision a ns6:DateTimeValuePrecision,
        owl:NamedIndividual ;
    rdfs:label "year-month-day-time value",
        "yearMonthDayTimePrecision" .

ns6:yearMonthPrecision a ns6:DateTimeValuePrecision,
        owl:NamedIndividual ;
    rdfs:label "year-month value",
        "yearMonthPrecision" .

ns6:yearPrecision a ns6:DateTimeValuePrecision,
        owl:NamedIndividual ;
    rdfs:label "year value",
        "yearPrecision" .

<http://vivoweb.org/ontology/scientific-research> rdfs:label "VIVO Scientific Research Ontology" .

<http://vivoweb.org/ontology/scientific-research#Phase0ClinicalTrial> a owl:Class ;
    rdfs:label "Phase 0 Clinical Trial" ;
    ns1:IAO_0000115 "Phase 0 Clinical Trial"^^xsd:string,
        "Phase 0 is a recent designation for exploratory, first-in-human trials  conducted in accordance with the United States Food and Drug Administration's (FDA) 2006 Guidance on Exploratory Investigational New Drug (IND) Studies.  Phase 0 trials are also known as human microdosing  studies and are designed to speed up the development of promising drugs or imaging agents by establishing very early on whether the drug or agent behaves in human subjects as was expected from preclinical studies."^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000016 .

<http://vivoweb.org/ontology/scientific-research#Phase1ClinicalTrial> a owl:Class ;
    rdfs:label "Phase 1 Clinical Trial" ;
    ns1:IAO_0000115 "In Phase I trials, researchers test an experimental drug or treatment in a small group of people (20-80) for the first time to evaluate its safety, determine a safe dosage range, and identify side effects"^^xsd:string,
        "Phase 1 Clinical Trial"^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000016 .

<http://vivoweb.org/ontology/scientific-research#Phase2ClinicalTrial> a owl:Class ;
    rdfs:label "Phase 2 Clinical Trial" ;
    ns1:IAO_0000115 "In Phase 2 trials, an experimental study drug or treatment is given to a larger group of people (100-300) to see if it is effective and to further evaluate its safety."^^xsd:string,
        "Phase 2 Clinical Trial"^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000016 .

<http://vivoweb.org/ontology/scientific-research#Phase3ClinicalTrial> a owl:Class ;
    rdfs:label "Phase 3 Clinical Trial" ;
    ns1:IAO_0000115 "In Phase 3 trials, an experimental study drug or treatment is given to large groups of people (1,000-3,000) to confirm its effectiveness, monitor side effects, compare it to commonly used treatments, and collect information that will allow the experimental drug or treatment to be used safely."^^xsd:string,
        "Phase 3 Clinical Trial"^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000016 .

<http://vivoweb.org/ontology/scientific-research#Phase4ClinicalTrial> a owl:Class ;
    rdfs:label "Phase 4 Clinical Trial" ;
    ns1:IAO_0000115 "In Phase 4 trials, post marketing studies delineate additional information including the drug's or treatment's risks, benefits, and optimal use."^^xsd:string,
        "Phase 4 Clinical Trial"^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0000016 .

<http://vivoweb.org/ontology/scientific-research#accessProvidedBy> a owl:ObjectProperty ;
    rdfs:label "access provided by" ;
    rdfs:range ns1:ERO_0000391 ;
    owl:inverseOf ns1:ERO_0000029 .

<http://vivoweb.org/ontology/scientific-research#documentationFor> a owl:ObjectProperty ;
    rdfs:label "documentation for project or resource" ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:ERO_0000004 ns1:ERO_0000005 ns1:ERO_0000006 ns1:ERO_0000014 ns1:ERO_0000020 ns1:ERO_0000071 ns1:ERO_0001716 ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:ERO_0000004 ns1:ERO_0000005 ns1:ERO_0000006 ns1:ERO_0000014 ns1:ERO_0000020 ns1:ERO_0000071 ns1:ERO_0001716 ) ] ;
    owl:inverseOf ns1:ERO_0000460 .

<http://vivoweb.org/ontology/scientific-research#irbNumber> a owl:DatatypeProperty ;
    rdfs:label "Institutional Review Board (IRB) number" ;
    ns1:IAO_0000115 "Every clinical trial in the United States must be approved and monitored by an Institutional Review Board (IRB). An IRB is an independent committee of physicians, statisticians, community advocates and others whose objective is to ensure that a clinical trial is ethical and the rights of study participants are protected."^^xsd:string .

<http://vivoweb.org/ontology/scientific-research#nctId> a owl:DatatypeProperty ;
    rdfs:label "National Clinical Trials (NCT) number" ;
    ns1:IAO_0000115 "ClinicalTrials.gov is an ICMJE-acceptable public registry, offering up-to-date information for locating clinical trials for a wide range of diseases and conditions. The U.S. National Institutes of Health (NIH), through its National Library of Medicine (NLM), developed this site in collaboration with the Food and Drug Administration (FDA), as a result of the FDA Modernization Act, which was passed into law in November 1997.   This property should be publically visible since it is one of the principal identifiers in a national registry of clinical trials"^^xsd:string ;
    ns5:exampleAnnot "NCT00000419"^^xsd:string .

<http://vivoweb.org/ontology/scientific-research#protocolRealizedBy> a owl:ObjectProperty ;
    rdfs:label "protocol realized by" ;
    rdfs:domain ns1:OBI_0000272 ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:ERO_0000005 ns1:ERO_0000014 ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:ERO_0000005 ns1:ERO_0000014 ) ] ;
    owl:inverseOf ns1:ERO_0000481 .

<http://vivoweb.org/ontology/scientific-research#studyPopulationCount> a owl:DatatypeProperty ;
    rdfs:label "study population count" ;
    ns1:IAO_0000115 "number of human participants in the study (trial)."^^xsd:string .

<http://www.ebi.ac.uk/efo/swo/SWO_0000740> a owl:ObjectProperty ;
    rdfs:label "implements" .

<http://www.ebi.ac.uk/efo/swo/SWO_0000741> a owl:ObjectProperty ;
    rdfs:label "is encoded in" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:ERO_0000071 ns1:ERO_0001716 ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:ERO_0000071 ns1:ERO_0001716 ) ] .

<http://www.geneontology.org/formats/oboInOwl#DbXref> a owl:Class ;
    rdfs:subClassOf ns1:IAO_0000102 .

