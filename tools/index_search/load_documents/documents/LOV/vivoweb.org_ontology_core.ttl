<http://purl.org/ontology/bibo/PersonalCommunicationDocument> a owl:Class ;
    rdfs:label "Personal Communication Document" ;
    ns1:IAO_0000112 "A personal communication manifested in some document."^^xsd:string ;
    ns1:IAO_0000115 "A personal communication manifested in some document."^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> .

<http://purl.org/ontology/bibo/Report> a owl:Class ;
    rdfs:label "Report" ;
    ns1:IAO_0000112 "Medical Subject Heading (MeSH) definition of Technical Report: Work consisting of a formal report giving details of the investigation and results of a medical or other scientific problem. When issued by a government agency or comparable official body, its contents may be classified, unclassified, or declassified with regard to security clearance. This publication type may also cover a scientific paper or article that records the current state or current position of scientific research and development. If so labeled by the editor or publisher, this publication type may be properly used for journal articles."^^xsd:string ;
    ns1:IAO_0000115 "A document describing an account or statement describing in detail an event, situation, or the like, usually as the result of observation, inquiry, etc."^^xsd:string ;
    rdfs:comment "A document describing an account or statement describing in detail an event, situation, or the like, usually as the result of observation, inquiry, etc.."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty <http://purl.org/ontology/bibo/distributor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty <http://purl.org/ontology/bibo/distributor> ],
        <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/ThesisDegree> a owl:Class ;
    rdfs:label "Thesis Degree" ;
    ns1:IAO_0000112 "Different from general academic degree, thesis degree is achieved through one's completed thesis. Thesis is a document submitted in support of candidature for a degree or professional qualification presenting the author's research and findings(http://en.wikipedia.org/wiki/Thesis_or_dissertation)."^^xsd:string,
        "Doctor of Philosophy (Ph.D.)"^^xsd:string ;
    ns1:IAO_0000115 "The academic degree of a Thesis."^^xsd:string ;
    rdfs:comment "The academic degree of a Thesis"@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf ns6:AcademicDegree ;
    ns2:term_status "stable" .

<http://purl.org/ontology/bibo/Website> a owl:Class ;
    rdfs:label "Website" ;
    ns1:IAO_0000112 "Facebook; VIVOweb.org; Flickr"^^xsd:string ;
    ns1:IAO_0000115 "A group of webpages available within a specific parent address or URL on the World Wide Web"^^xsd:string ;
    rdfs:comment "A group of Webpages accessible on the Web."@en ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom foaf:Agent ;
            owl:onProperty ns6:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Agent ;
            owl:onProperty ns6:publisher ],
        <http://purl.org/ontology/bibo/Collection> ;
    ns2:term_status "unstable" .

<http://purl.org/ontology/bibo/cites> a owl:ObjectProperty ;
    rdfs:label "cites" ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:range <http://purl.org/ontology/bibo/Document> .

<http://purl.org/ontology/bibo/reproducedIn> a owl:ObjectProperty ;
    rdfs:label "reproduced in" ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:range <http://purl.org/ontology/bibo/Document> ;
    rdfs:subPropertyOf ns1:BFO_0000050 .

<http://purl.org/ontology/bibo/translationOf> a owl:ObjectProperty ;
    rdfs:label "translation of" ;
    ns1:IAO_0000112 "Examples shows a book has French language version. Public description source: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html ."^^xsd:string ;
    rdfs:comment "Relates a translated document to the original document."@en ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
    rdfs:range <http://purl.org/ontology/bibo/Document> ;
    ns2:term_status "stable" .

<http://purl.org/spar/c4o/BibliographicInformationSource> a owl:Class ;
    rdfs:label "Bibliographic Information Source" ;
    ns1:IAO_0000115 "A source of information about bibliographic citations, such as Google Scholar, Web of Science or Scopus."^^xsd:string ;
    ns5:descriptionAnnot "A source of information about bibliographic citations, such as Google Scholar, Web of Science or Scopus."^^xsd:string ;
    rdfs:subClassOf ns1:ERO_0001716 .

ns6:Authorship a owl:Class ;
    rdfs:label "Authorship" ;
    ns1:IAO_0000112 "Authorship of journal articles, books and other original works is a means by which academics communicate the results of their scholarly work, establish priority for their discoveries, and build their reputation among their peers.\\nThis class allows for linking an author to a publication while indicating information about that author's authorship."^^xsd:string,
        "Currently any abstract name is given to members of this class. This could change in the future."^^xsd:string ;
    ns1:IAO_0000115 "Contains the authors name, their rank in the publication, and whether or not they are a corresponding author on the publication."^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ns6:hideFromDisplay ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ns6:hideFromDisplay ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        [ a owl:Restriction ;
            owl:onProperty ns6:relates ;
            owl:someValuesFrom foaf:Agent ],
        ns6:Relationship .

ns6:Company a owl:Class ;
    rdfs:label "Company" ;
    ns1:IAO_0000112 "from Wikipedia: \"A company is a form of business organization. It is an association or collection of individual real persons and/or other companies ... This collection, group or association of persons can be made to exist in law and then a company is itself considered a \"legal person\". The name company arose because, at least originally, it represented or was owned by more than one real or legal person.\""^^xsd:string ;
    ns1:IAO_0000115 "A legally-recognized business organization"^^xsd:string,
        "A legally-recognized business organization."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Country a owl:Class ;
    rdfs:label "Country" ;
    ns1:IAO_0000112 "Afghanistan; Antigua and Barbuda; Cameroon; Iceland; Jamaica; Nigeria; United States of America"^^xsd:string,
        "Source of the Short Definition: http://www.thefreedictionary.com/country.  This is also the same as geopolitical.owl:self_governing."^^xsd:string ;
    ns1:IAO_0000115 "An area of land distinguished by its political autonomy. Politically independent territories."^^xsd:string ;
    rdfs:subClassOf ns6:GeopoliticalEntity .

ns6:Department a owl:Class ;
    rdfs:label "Department" ;
    ns1:IAO_0000112 "Definition modified from the definition here: http://dictionary.reference.com/browse/department. It is difficult to tell the difference between and department and a division."^^xsd:string,
        "Legal (department within a company); Use for any non-academic department"^^xsd:string ;
    ns1:IAO_0000115 "A unit within a larger organization that addresses a specific subject or area of activity."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:EmeritusFaculty a owl:Class ;
    rdfs:label "Faculty Member Emeritus" ;
    ns1:IAO_0000115 "A retired faculty member who has retained their rank, title and privileges."^^xsd:string ;
    rdfs:subClassOf foaf:Person .

ns6:ExtensionUnit a owl:Class ;
    rdfs:label "Extension Unit" ;
    ns1:IAO_0000112 "Alachua County Extension Office"^^xsd:string ;
    ns1:IAO_0000115 "A unit devoted primarily to extension activities, whether for outreach or research"^^xsd:string,
        "A unit devoted primarily to extension activities, whether for outreach or research."^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf foaf:Organization .

ns6:Licensure a owl:Class ;
    rdfs:label "Licensure" ;
    ns1:IAO_0000112 "A granted license, which gives a 'permission to practice.' Such licenses are usually issued in order to regulate some activity that is deemed to be dangerous or a threat to the person or the public or which involves a high level of specialized skill.  See also core:License."^^xsd:string ;
    ns1:IAO_0000115 "A granted license, which gives a 'permission to practice.'"^^xsd:string ;
    rdfs:subClassOf ns6:IssuedCredential .

ns6:Location a owl:Class ;
    rdfs:label "Location" ;
    ns1:IAO_0000112 "It's anticipated that the subclasses will be used when classifying items. And, all locations can be viewable via this class."^^xsd:string,
        "Use subclasses of core:Location when classsifying items."^^xsd:string ;
    ns1:IAO_0000115 "Top level of all location classes."^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000006 .

ns6:NonFacultyAcademic a owl:Class ;
    rdfs:label "Non-Faculty Academic" ;
    ns1:IAO_0000115 "A person not considered a faculty member but holding an academic appointment."^^xsd:string ;
    rdfs:subClassOf foaf:Person .

ns6:NonFacultyAcademicPosition a owl:Class ;
    rdfs:label "Non-Faculty Academic Position" ;
    ns1:IAO_0000112 "Researcher; Academic Extension Associate; Postdoctoral Associate"^^xsd:string,
        "Those positions are held by people who do academic work but do not have faculty positions in universities or institutes."^^xsd:string ;
    ns1:IAO_0000115 "A position involving academic work but without faculty status"^^xsd:string ;
    rdfs:subClassOf ns6:Position .

ns6:Presentation a owl:Class ;
    rdfs:label "Presentation" ;
    ns1:IAO_0000115 "Encompasses talk, speech, lecture, slide lecture, conference presentation"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> .

ns6:Project a owl:Class ;
    rdfs:label "Project" ;
    ns1:IAO_0000112 "An endeavor, frequently collaborative, that occurs over a finite period of time and is intended to achieve a particular aim."^^xsd:string ;
    ns1:IAO_0000115 "An endeavor, frequently collaborative, that occurs over a finite period of time and is intended to achieve a particular aim."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicRegion ;
            owl:onProperty ns6:geographicFocus ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns6:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:DateTimeInterval ;
            owl:onProperty ns6:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns6:GeographicRegion ;
            owl:onProperty ns6:geographicFocus ],
        ns1:BFO_0000015 .

ns6:ResearcherRole a owl:Class ;
    rdfs:label "Researcher Role" ;
    ns1:IAO_0000112 "Examples of research can be seen at: http://www.ufl.edu/research/products/index.html.  Note these may have been funded, but the research doesn't have to be funded.  Also, the research may be linked to an Agreement (for example, a Grant), but does not need to be."^^xsd:string ;
    ns1:IAO_0000115 "A role of conducting funded or unfunded research,  sometimes linked to an Agreement."^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:Review a owl:Class ;
    rdfs:label "Review" ;
    ns1:IAO_0000115 "An article reviewing one or more other information resources (a book, one or more other articles, movies, etc)"^^xsd:string ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Article> .

ns6:ReviewerRole a owl:Class ;
    rdfs:label "Reviewer Role" ;
    ns1:IAO_0000112 "A role that encompasses both ongoing reviewer responsibility for a bibo:Collection, such as a Journal or Series, and also a review performed for a bibo:Document, such as a book, academic article or conference paper."^^xsd:string ;
    ns1:IAO_0000115 "A role that encompasses both ongoing reviewer responsibility for a bibo:Collection, such as a Journal or Series, and also a review performed for a bibo:Document, such as a book, academic article or conference paper."^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns6:ServiceProvidingLaboratory a owl:Class ;
    rdfs:label "Service Providing Lab" ;
    ns1:IAO_0000112 "Ideally a defined class -- a Laboratory the provides some Service via the property"^^xsd:string ;
    ns1:IAO_0000115 "A laboratory that provides services"^^xsd:string ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf ns6:Laboratory .

ns6:assignee a owl:ObjectProperty ;
    rdfs:label "assignee" ;
    rdfs:domain <http://purl.org/ontology/bibo/Patent> ;
    rdfs:range foaf:Agent .

ns6:contributingRole a owl:ObjectProperty ;
    rdfs:label "contributor" ;
    rdfs:range ns1:BFO_0000023 ;
    owl:inverseOf ns6:roleContributesTo .

ns6:equipmentFor a owl:ObjectProperty ;
    rdfs:label "equipment for",
        "equipment for"@en-us ;
    rdfs:domain ns6:Equipment ;
    rdfs:range foaf:Organization ;
    rdfs:subPropertyOf <http://isf/deprecated_op> .

ns6:grantSubcontractedThrough a owl:ObjectProperty ;
    rdfs:label "subcontracted through" ;
    rdfs:domain ns6:Grant ;
    rdfs:range foaf:Organization .

ns6:hasFacility rdfs:label "has facility" ;
    rdfs:range ns6:Facility .

ns6:hasProceedings a owl:ObjectProperty ;
    rdfs:label "proceedings" ;
    ns5:descriptionAnnot "A possible working example: The conference proceeding of the SPIE was generated from the conference - International Society for Optical Engineering."^^xsd:string ;
    rdfs:domain <http://purl.org/ontology/bibo/Conference> ;
    rdfs:range <http://purl.org/ontology/bibo/Proceedings> .

ns6:hasSuccessorOrganization a owl:ObjectProperty ;
    rdfs:label "successor organization" ;
    rdfs:domain foaf:Organization ;
    rdfs:range foaf:Organization .

ns6:informationResourceSupportedBy a owl:ObjectProperty ;
    rdfs:label "supported by" ;
    ns5:descriptionAnnot "an information resource (typically a publication) supported by (typically via funding) an agreement (such as a grant)"^^xsd:string ;
    rdfs:domain ns1:IAO_0000030 ;
    rdfs:subPropertyOf ns6:supportedBy .

ns6:offeredBy a owl:ObjectProperty ;
    rdfs:label "offered by" .

ns6:prerequisiteFor a owl:ObjectProperty ;
    rdfs:label "prerequisite for" ;
    rdfs:domain ns6:Course ;
    rdfs:range ns6:Course .

ns6:providesFundingThrough a owl:ObjectProperty ;
    rdfs:label "provides funding through" ;
    ns1:IAO_0000112 "For example, National Science Foundation providesFundingThrough Graduate Research Fellowship Program; National Institutes of Health providesFundingThrough National Center for Research Resources."^^xsd:string ;
    rdfs:domain ns6:FundingOrganization ;
    rdfs:range ns6:FundingOrganization .

ns6:publicationVenueFor a owl:ObjectProperty ;
    rdfs:label "publication venue for" .

ns6:publisherOf a owl:ObjectProperty ;
    rdfs:label "publisher of" ;
    ns1:IAO_0000112 "Public Definition source (http://www.answers.com/topic/publisher)."^^xsd:string ;
    rdfs:domain foaf:Organization ;
    rdfs:range ns1:IAO_0000030 .

ns6:relatedBy a owl:ObjectProperty ;
    rdfs:label "related by" ;
    ns1:IAO_0000115 "Relates a Thing to a Relationship as a Thing that is somehow related to other Thing in the same Relationship instance. A Relationship instnace is a predicate over Thing and is created by an Agent."@en .

ns6:researchAreaOf a owl:ObjectProperty ;
    rdfs:label "research area of" ;
    rdfs:subPropertyOf ns6:conceptAssociatedWith .

ns6:reviewedIn a owl:ObjectProperty ;
    rdfs:label "reviewed in" ;
    ns5:descriptionAnnot "The bibo:reviewOf public description was found here: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html .  As of 26 May 2010, bibo:reviewOf is used with the class Review, but core:reviewIn doesn't seem to be being used."^^xsd:string ;
    rdfs:range ns6:Review .

ns6:roleContributesTo a owl:ObjectProperty ;
    rdfs:label "contributes to" ;
    rdfs:domain ns1:BFO_0000023 ;
    owl:inverseOf ns6:contributingRole .

ns6:sponsoredBy a owl:ObjectProperty ;
    rdfs:label "award sponsored by" ;
    rdfs:domain ns6:Award ;
    rdfs:range foaf:Organization .

ns6:subjectAreaOf a owl:ObjectProperty ;
    rdfs:label "subject area of" ;
    rdfs:subPropertyOf ns6:conceptAssociatedWith .

ns6:supportedBy a owl:ObjectProperty ;
    rdfs:label "supported by" ;
    ns5:descriptionAnnot "general relationship of support"^^xsd:string ;
    owl:inverseOf ns6:supports .

ns6:translatorOf a owl:ObjectProperty ;
    rdfs:label "translator of" ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://purl.org/ontology/bibo/Document> .

<http://www.obofoundry.org/ro/ro.owl#has_agent> rdfs:label "has agent" .

owl:DeprecatedProperty rdfs:label "deprecated property" .

skos:narrower a owl:ObjectProperty ;
    rdfs:label "narrower concept" ;
    ns1:IAO_0000115 "Public description modified from the information on this page: http://www.w3.org/TR/2005/WD-swbp-skos-core-guide-20050510/#sechierarchy ."^^xsd:string ;
    ns5:descriptionAnnot "Public description modified from the information on this page: http://www.w3.org/TR/2005/WD-swbp-skos-core-guide-20050510/#sechierarchy ."^^xsd:string ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .

<http://www.w3.org/2006/vcard/ns#Addressing> a owl:Class ;
    rdfs:label "Addressing" ;
    rdfs:comment "These types are concerned with information related to the delivery addressing or label for the vCard object"^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#timeZone> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#sortAs> ] ) ] ) ] .

<http://www.w3.org/2006/vcard/ns#Group> a owl:Class ;
    rdfs:label "Group" ;
    rdfs:comment "Defines all the properties required to be a Group of Individuals or  Organizations"^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Kind> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#hasMember> ;
                        owl:someValuesFrom <http://www.w3.org/2006/vcard/ns#Kind> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#hasMember> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#hasMember> ;
                        owl:someValuesFrom <http://www.w3.org/2006/vcard/ns#Kind> ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#hasMember> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Language> a owl:Class ;
    rdfs:label "Language" ;
    rdfs:comment "To specify the language(s) that may be used for contacting the entity associated with the vCard."^^xsd:string ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Communication> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#language> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Security> a owl:Class ;
    rdfs:label "Security" ;
    rdfs:comment "Contains all the Security related Classes"^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#geo> ;
                                    owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
