<http://semantic-systems.net/swemls/ResourceSize.1K_10K> a owl:NamedIndividual,
        ns1:ResourceSize ;
    rdfs:label "1K-10K" .

<http://semantic-systems.net/swemls/ResourceSize.10K_100K> a owl:NamedIndividual,
        ns1:ResourceSize ;
    rdfs:label "10K-100K" .

<http://semantic-systems.net/swemls/ResourceType.Linked_Dataset> a owl:NamedIndividual,
        ns1:ResourceType ;
    rdfs:label "Linked Dataset" .

ns1:T-Pattern a owl:Class ;
    rdfs:label "T-Pattern" ;
    rdfs:comment "Advanded pattern type: a chain of Atomic and Fusion Patterns" ;
    rdfs:subClassOf ns1:Pattern .

<http://semantic-systems.net/swemls/Task.Other_Tasks> a owl:NamedIndividual,
        ns1:Task ;
    rdfs:label "Other Tasks" ;
    skos:broader <http://semantic-systems.net/swemls/Task.Other_Tasks> .

ns1:ResourceFormalism a owl:Class ;
    rdfs:label "Symbol Formalism" ;
    rdfs:comment "Formalism of the semantic web resource data" .

<http://semantic-systems.net/swemls/ResourceSize.100K_500K> a owl:NamedIndividual,
        ns1:ResourceSize ;
    rdfs:label "100K-500K" .

<http://semantic-systems.net/swemls/StatisticalModel.ClassicalML> a owl:NamedIndividual,
        ns1:StatisticalModel ;
    rdfs:label "Classical ML model" .

ns1:System a owl:Class ;
    rdfs:label "System" ;
    rdfs:comment "SWeML System" ;
    rdfs:subClassOf <http://purl.org/net/p-plan#Plan> .

<http://semantic-systems.net/swemls/ResourceFormalism.OWL> a owl:NamedIndividual,
        ns1:ResourceFormalism ;
    rdfs:label "OWL" .

<http://semantic-systems.net/swemls/ResourceType.Ontology> a owl:NamedIndividual,
        ns1:ResourceType ;
    rdfs:label "Ontology" .

ns1:ApplicationDomain a owl:Class ;
    rdfs:label "Application Domain" ;
    rdfs:comment "The application domain in which the SWeML systems solve tasks (e.g. Chemistry, Legal)" .

<http://semantic-systems.net/swemls/ResourceSize.More_than_1M> a owl:NamedIndividual,
        ns1:ResourceSize ;
    rdfs:label "More than 1M" .

ns1:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "Country to which authors describing the SWeML systems in their paper are affiliated to" .

<http://semantic-systems.net/swemls/ResourceType.Knowledge_Graph> a owl:NamedIndividual,
        ns1:ResourceType ;
    rdfs:label "Knowledge Graph" .

<http://semantic-systems.net/swemls/StatisticalModel.DeepLearning> a owl:NamedIndividual,
        ns1:StatisticalModel ;
    rdfs:label "Deep Learning model" .

ns1:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:comment "Task that the SWeML system supposed to solve" .

ns1:StatisticalModel a owl:Class ;
    rdfs:label "Statistical Model" ;
    rdfs:comment "Inductive Model" ;
    rdfs:subClassOf ns1:Model .

ns1:SemanticWebResource a owl:Class ;
    rdfs:label "Semantic Web Resource" ;
    rdfs:comment "Semantic entities or relations" ;
    rdfs:subClassOf ns1:SemanticModel,
        ns1:Symbol .

