        ns1:ApplicationDomain ;
    rdfs:label "General" .

<http://semantic-systems.net/swemls/Domain.News_Social_Media> a owl:NamedIndividual,
        ns1:ApplicationDomain ;
    rdfs:label "News & Social Media" .

