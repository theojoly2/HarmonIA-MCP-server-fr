onto:U46i_was_context_of a owl:ObjectProperty ;
    rdfs:label "U46i was context of"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://erlangen-crm.org/current/P2i_is_type_of> .

onto:U52i_is_context_of a owl:ObjectProperty ;
    rdfs:label "U52i is context of"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://erlangen-crm.org/current/P2i_is_type_of> .

onto:M4_Key a owl:Class ;
    rdfs:label "M4 Key"@en,
        "M4 Tonalité"@fr ;
    rdfs:comment "Examples:\\t→ Le Concerto pour Piano et orchestre en Si bémol majeur de Beethoven a pour tonalité si bémol majeur :\\nF22 Self-Contained Expression u11 has key M4 Key { Si bémol Majeur }"@fr,
        "Scope note:\\nCette classe décrit la tonalité de l’œuvre.\\nLes tonalités sont souvent listées sous forme de référentiels multilingues, c’est pourquoi la classe M4 Key est liée à la classe M7 Linguistic Appellation."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://erlangen-crm.org/current/E55_Type> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://data.doremus.org/vocabulary/key/> ;
            owl:onProperty skos:inScheme ] .

onto:M23_Casting_Detail a owl:Class ;
    rdfs:label "M23 Casting Detail"@en,
        "M23 Détail de la distribution"@fr ;
    rdfs:comment "Examples:\\nLa Sonate pour piano opus 27, no 2 de Beethoven (F22) U13 has intended casting M6 Intended Casting U23 has casting detail M23 Casting Detail U1 has intended medium of performance M35 Cast Medium of Performance U39 has medium of performance M14 Medium of Performance { piano } and P90 has value { 1 }."@fr,
        "Scope note:\\nCette classe décrit un détail de la distribution prévue par le compositeur, par exemple une sonate pour violon et piano est décrite par deux « composantes » M23 qui sont le violon et le piano. Elle est donc obligatoirement associée à la classe M6 Intended Casting dont elle détaille les composantes. Ces composantes comprennent notamment le ou les medium of performance prévus par le compositeur, l’éventuel rôle soliste du medium of performance, le personnage interprété (par exemple dans un opéra), la tessiture précise."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://erlangen-crm.org/current/E29_Design_or_Procedure> .

onto:M40_Context a owl:Class ;
    rdfs:label "M40 Context"@en,
        "M40 Contexte"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://erlangen-crm.org/current/E55_Type> .

onto: a owl:Ontology ;
    dc:description "DOREMUS is an extension of the FRBRoo model for describing the music." ;
    dcterms:created "2017-01-24"^^xsd:date ;
    dcterms:creator <http://data.doremus.org/organization/DOREMUS> ;
    dcterms:issued "2016-05-02"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2018-01-17" ;
    vann:preferredNamespacePrefix "mus" ;
    vann:preferredNamespaceUri "http://data.doremus.org/ontology#" ;
    owl:imports <http://erlangen-crm.org/efrbroo/>,
        <http://www.w3.org/2004/02/skos/core> ;
    owl:versionInfo "v0.2 05/06/2017 - starting enrichemnent for Manifestations - change in of type of several properties controlled by controlled vocabularies\\n\\nv0.2.1 Beta - test de gestion des vocabulaires contrôlés et propriétés avec valeur contrôlées -\\n- import de l'ontologie SKOS\\n- M4 devient le range de la propriété U11_has_Key\\n- M4 est déclarée sous classe de skos:Concept\\n- key est déclaré comme instance de la classe skos:ConceptScheme\\n- M4 est déclarée comme equivalent au skos:ConceptScheme key\\n\\nSi l'utilisateur de l'ontologie n'utilise pas de vocabulaire contrôlé, cette équivalence peut être supprimée. On peut donner une valeur litérale à l'instance de M4_Key en utilisant la propriété rdfs:label et mettre des commentaires en utilisant rdfs:comment\\n\\nv0.2.2 11/01/2018 - enrichissements de classes et propriétés\\n- voir tableau des nouvelles classes et propriétés pour le détail\\n\\nv0.2.3 08/04/2018\\n- voir tableau des nouvelles classes et propriétés pour le détail\\n\\nv0.2.4 14/05/2018\\n- diverses corrections\\n\\nv0.2.5 16/05/2018\\n- diverses corrections\\n\\nv0.2.6 04/07/2018\\n- diverses corrections selon tableau des nouvelles classes et propriétés\\n\\nv0.2.7 05/07/2018\\n- diverses corrections selon tableau des nouvelles classes et propriétés\\n\\nv0.2.9 09/07/2018\\n- changement du label FR de la classe M37"@en .

