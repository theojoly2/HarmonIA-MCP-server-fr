    rdfs:label "M159 Edition statement"@en ;
    rdfs:subClassOf <http://erlangen-crm.org/current/E33_Linguistic_Object> .

onto:U46_occurred_in_context a owl:ObjectProperty ;
    rdfs:label "U46 occurred in context"@en ;
    rdfs:domain <http://erlangen-crm.org/current/E7_Activity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:M40_Context ;
    rdfs:subPropertyOf <http://erlangen-crm.org/current/P2_has_type> ;
    owl:inverseOf onto:U46i_was_context_of .

onto:U52_has_context a owl:ObjectProperty ;
    rdfs:label "U52 has context"@en ;
    rdfs:domain <http://erlangen-crm.org/efrbroo/F22_Self-Contained_Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:M40_Context ;
    rdfs:subPropertyOf <http://erlangen-crm.org/current/P2_has_type> ;
    owl:inverseOf onto:U52i_is_context_of .

<http://erlangen-crm.org/efrbroo/F38_Character> a owl:Class .

dc:title a owl:DatatypeProperty .

onto:M29_Editing a owl:Class ;
    rdfs:label "M29 Editing"@en,
        "M29 Post-production"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://erlangen-crm.org/efrbroo/F28_Expression_Creation> .

onto:M2_Opus_Statement a owl:Class ;
    rdfs:label "M2 Opus Statement"@en,
        "M2 Mention d'opus"@fr ;
