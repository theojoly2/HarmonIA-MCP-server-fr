    rdfs:range xsd:string .

onto:luggageCapacitySeatsFolded a owl:ObjectProperty ;
    rdfs:label "luggageCapacitySeatsFolded (0..1)"@en ;
    rdfs:comment "The available volume for cargo or luggage with the seats folded\\nTypical unit code(s): LTR for liters, FTQ for cubic foot/feet\\n\\t\\nNote: You can use gr:hasMinValueFloat and gr:hasMaxValueFloat to indicate ranges."@en ;
    rdfs:domain <http://purl.org/vso/ns#MotorizedRoadVehicle> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/goodrelations/v1#QuantitativeValueFloat> ;
    rdfs:subPropertyOf <http://purl.org/goodrelations/v1#quantitativeProductOrServiceProperty>,
        <http://purl.org/vso/ns#cargoVolume> .

