onto:gearbox a owl:ObjectProperty ;
    rdfs:label "gearbox (0..1)"@en ;
    rdfs:comment "The gearbox type of the vehicle or vehicle model"@en ;
    rdfs:domain <http://purl.org/vso/ns#MotorizedRoadVehicle> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:GearboxTypeValue ;
    rdfs:seeAlso <http://dbpedia.org/page/Transmission_%28mechanics%29>,
        <http://en.wikipedia.org/wiki/Transmission_%28mechanics%29> ;
    rdfs:subPropertyOf <http://purl.org/goodrelations/v1#qualitativeProductOrServiceProperty> .

