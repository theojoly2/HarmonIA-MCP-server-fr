            owl:unionOf ( <http://purl.org/vso/ns#MotorizedRoadVehicle> onto:Engine ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:dateLaunched a owl:DatatypeProperty ;
    rdfs:label "dateLaunched (0..1)"@en ;
    rdfs:comment "The date of the official launch of the car model"@en ;
    rdfs:domain <http://purl.org/goodrelations/v1#ProductOrService> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf <http://purl.org/goodrelations/v1#datatypeProductOrServiceProperty> .

onto:depositContribution a owl:ObjectProperty ;
    rdfs:label "depositContribution (0..1)"@en ;
