@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.loc.gov/premis/rdf/v3/SignificantProperties> a owl:Class ;
    rdfs:label "Significant properties"@en ;
    rdfs:comment "Characteristics of a particular object subjectively determined to be important to maintain       through preservation actions."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/PreservationPolicy> .

<http://www.loc.gov/premis/rdf/v3/act> a owl:ObjectProperty ;
    rdfs:label "act"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Rule> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Action> .

<http://www.loc.gov/premis/rdf/v3/allows> a owl:ObjectProperty ;
    rdfs:label "allows"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Rule> .

<http://www.loc.gov/premis/rdf/v3/basis> a owl:ObjectProperty ;
    rdfs:label "has basis"@en ;
    rdfs:comment "Links from a RightsStatus to the RightsBasis instance that supports or documents       it."@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/RightsStatus> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/RightsBasis> .

<http://www.loc.gov/premis/rdf/v3/characteristic> a owl:ObjectProperty ;
    rdfs:label "has characteristic"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Dependency> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/EnvironmentCharacteristic> .

<http://www.loc.gov/premis/rdf/v3/citation> a owl:DatatypeProperty ;
    rdfs:label "has citation"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal .

<http://www.loc.gov/premis/rdf/v3/compositionLevel> a owl:DatatypeProperty ;
    rdfs:label "has composition level"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/File> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range xsd:nonNegativeInteger .

<http://www.loc.gov/premis/rdf/v3/dependency> a owl:ObjectProperty ;
    rdfs:label "has dependency"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Object> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Dependency> .

<http://www.loc.gov/premis/rdf/v3/determinationDate> a owl:DatatypeProperty ;
    rdfs:label "has determination date"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/RightsStatus> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dcterms:date .

<http://www.loc.gov/premis/rdf/v3/documentation> a owl:ObjectProperty ;
    rdfs:label "has documentation"@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Resource .

<http://www.loc.gov/premis/rdf/v3/encoding> a owl:ObjectProperty ;
    rdfs:label "has encoding"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Signature> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/SignatureEncoding> .

<http://www.loc.gov/premis/rdf/v3/endDate> a owl:DatatypeProperty ;
    rdfs:label "end date"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/RightsStatus> <http://www.loc.gov/premis/rdf/v3/Rule> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subPropertyOf dcterms:date .

<http://www.loc.gov/premis/rdf/v3/fixity> a owl:ObjectProperty ;
    rdfs:label "has fixity"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/Bitstream> <http://www.loc.gov/premis/rdf/v3/File> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Fixity> .

<http://www.loc.gov/premis/rdf/v3/governs> a owl:ObjectProperty ;
    rdfs:label "governs"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Object> .

<http://www.loc.gov/premis/rdf/v3/identifier> a owl:ObjectProperty ;
    rdfs:label "has identifier"@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Identifier> .

<http://www.loc.gov/premis/rdf/v3/inhibitedBy> a owl:ObjectProperty ;
    rdfs:label "inhibited by"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/Bitstream> <http://www.loc.gov/premis/rdf/v3/File> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Inhibitor> .

<http://www.loc.gov/premis/rdf/v3/inhibits> a owl:ObjectProperty ;
    rdfs:label "inhibits"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Inhibitor> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Action> .

<http://www.loc.gov/premis/rdf/v3/jurisdiction> a owl:ObjectProperty ;
    rdfs:label "has jurisdiction"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Resource .

<http://www.loc.gov/premis/rdf/v3/key> a owl:DatatypeProperty ;
    rdfs:label "has key"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/Inhibitor> <http://www.loc.gov/premis/rdf/v3/Signature> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal .

<http://www.loc.gov/premis/rdf/v3/medium> a owl:ObjectProperty ;
    rdfs:label "has medium"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/StorageLocation> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/StorageMedium> .

<http://www.loc.gov/premis/rdf/v3/originalName> a owl:DatatypeProperty ;
    rdfs:label "has original name"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/File> <http://www.loc.gov/premis/rdf/v3/IntellectualEntity> <http://www.loc.gov/premis/rdf/v3/Representation> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal .

<http://www.loc.gov/premis/rdf/v3/outcome> a owl:ObjectProperty ;
    rdfs:label "has outcome"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Event> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/OutcomeStatus> .

<http://www.loc.gov/premis/rdf/v3/outcomeNote> a owl:DatatypeProperty ;
    rdfs:label "has outcome note"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Event> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.loc.gov/premis/rdf/v3/note> .

<http://www.loc.gov/premis/rdf/v3/policy> a owl:ObjectProperty ;
    rdfs:label "has policy"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Object> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/PreservationPolicy> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/preservationLevelRole> .

<http://www.loc.gov/premis/rdf/v3/prohibits> a owl:ObjectProperty ;
    rdfs:label "prohibits"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Rule> .

<http://www.loc.gov/premis/rdf/v3/purpose> a owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Dependency> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Action> .

<http://www.loc.gov/premis/rdf/v3/rationale> a owl:DatatypeProperty ;
    rdfs:label "has rationale"@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.loc.gov/premis/rdf/v3/note> .

<http://www.loc.gov/premis/rdf/v3/relationship> a owl:ObjectProperty ;
    rdfs:label "has relationship"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/Agent> <http://www.loc.gov/premis/rdf/v3/Object> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Object> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/relationshipSubType> .

<http://www.loc.gov/premis/rdf/v3/restriction> a owl:DatatypeProperty ;
    rdfs:label "has restriction"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Rule> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal .

<http://www.loc.gov/premis/rdf/v3/rightsStatus> a owl:ObjectProperty ;
    rdfs:label "has rights status"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Object> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/RightsStatus> ;
    rdfs:subPropertyOf dc:rights .

<http://www.loc.gov/premis/rdf/v3/signature> a owl:ObjectProperty ;
    rdfs:label "has signature"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/Bitstream> <http://www.loc.gov/premis/rdf/v3/File> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/Signature> .

<http://www.loc.gov/premis/rdf/v3/size> a owl:DatatypeProperty ;
    rdfs:label "has size"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/Bitstream> <http://www.loc.gov/premis/rdf/v3/File> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:narrowMatch <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#fileSize> .

<http://www.loc.gov/premis/rdf/v3/startDate> a owl:DatatypeProperty ;
    rdfs:label "start date"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/RightsStatus> <http://www.loc.gov/premis/rdf/v3/Rule> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subPropertyOf dcterms:date .

<http://www.loc.gov/premis/rdf/v3/storedAt> a owl:ObjectProperty ;
    rdfs:label "stored at"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/premis/rdf/v3/Bitstream> <http://www.loc.gov/premis/rdf/v3/File> <http://www.loc.gov/premis/rdf/v3/Representation> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range <http://www.loc.gov/premis/rdf/v3/StorageLocation> .

<http://www.loc.gov/premis/rdf/v3/terms> a owl:DatatypeProperty ;
    rdfs:label "has terms"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.loc.gov/premis/rdf/v3/note> .

<http://www.loc.gov/premis/rdf/v3/validationRules> a owl:DatatypeProperty ;
    rdfs:label "has validation rules"@en ;
    rdfs:domain <http://www.loc.gov/premis/rdf/v3/Signature> ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.loc.gov/premis/rdf/v3/note> .

<http://www.loc.gov/premis/rdf/v3/version> a owl:DatatypeProperty ;
    rdfs:label "has version"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dcterms:FileFormat <http://www.loc.gov/premis/rdf/v3/HardwareAgent> <http://www.loc.gov/premis/rdf/v3/IntellectualEntity> <http://www.loc.gov/premis/rdf/v3/SoftwareAgent> ) ] ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal .

dcterms:FileFormat a owl:Class .

<http://www.loc.gov/premis/rdf/v3/EnvironmentCharacteristic> a owl:Class ;
    rdfs:label "Environment characteristic"@en ;
    rdfs:comment "An assessment of the extent to which the described environment supports its       purpose."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/environmentCharacteristic> .

<http://www.loc.gov/premis/rdf/v3/Fixity> a owl:Class ;
    rdfs:label "Fixity"@en ;
    rdfs:comment "Information used to verify whether an object has been altered in an undocumented or       unauthorized way."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/cryptographicHashFunctions> .

<http://www.loc.gov/premis/rdf/v3/Identifier> a owl:Class ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "An unambiguous reference to the PREMIS entity within the preservation       repository."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> .

<http://www.loc.gov/premis/rdf/v3/OutcomeStatus> a owl:Class ;
    rdfs:label "Outcome status"@en ;
    rdfs:comment "Overall result of the Event in terms of success, partial success, or failure."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventOutcome> .

<http://www.loc.gov/premis/rdf/v3/SignatureEncoding> a owl:Class ;
    rdfs:label "Signature encoding"@en ;
    rdfs:comment "Encoding used for the signature value and key information."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/signatureEncoding> .

<http://www.loc.gov/premis/rdf/v3/StorageMedium> a owl:Class ;
    rdfs:label "Storage medium"@en ;
    rdfs:comment "The physical medium on which the Object is stored (e.g., magnetic tape, hard disk, CD-ROM,       DVD)."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/storageMedium> .

<http://www.loc.gov/premis/rdf/v3/Event> a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "Action performed within or outside the repository that affects its capability to preserve Objects over the long term."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/eventType> ;
    rdfs:subClassOf prov:Activity .

<http://www.loc.gov/premis/rdf/v3/PreservationPolicy> a owl:Class ;
    rdfs:label "Preservation policy"@en ;
    rdfs:comment "Information indicating the decision or policy on the set of preservation functions to be       applied to an object and the context in which the decision or policy was made. Note that in addition to       subclasses declared at presLevType, SignificantProperties is also a subclass of PreservationPolicy.       Implementers may also wish to create locally-defined subclasses."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/preservationLevelRole> ;
    rdfs:subClassOf dcterms:Policy .

<http://www.loc.gov/premis/rdf/v3/StorageLocation> a owl:Class ;
    rdfs:label "Storage location"@en ;
    rdfs:comment "Information needed to retrieve a physical item from its physical storage location or a file       from the storage system, or to access a bitstream within a file."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/contentLocationType> .

<http://www.loc.gov/premis/rdf/v3/Action> a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "Operation type to perform on an Object. Effectively performing this action may produce an Event."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/actionsGranted> .

<http://www.loc.gov/premis/rdf/v3/Copyright> a owl:Class ;
    rdfs:label "Copyright"@en ;
    rdfs:comment "Copyright law."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/copyrightStatus> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/InstitutionalPolicy>,
        <http://www.loc.gov/premis/rdf/v3/License>,
        <http://www.loc.gov/premis/rdf/v3/Statute> .

<http://www.loc.gov/premis/rdf/v3/Dependency> a owl:Class ;
    rdfs:label "Dependency"@en ;
    rdfs:comment "Relationship where one Object requires another Object to support its function, delivery, or       the coherence of its content."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> .

<http://www.loc.gov/premis/rdf/v3/Inhibitor> a owl:Class ;
    rdfs:label "Inhibitor"@en ;
    rdfs:comment "Feature of a Digital Object intended to inhibit access, copying, dissemination, or       migration. Common Inhibitors are encryption and password protection."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/inhibitorType> .

<http://www.loc.gov/premis/rdf/v3/InstitutionalPolicy> a owl:Class ;
    rdfs:label "Institutional policy"@en ;
    rdfs:comment "A policy decision made by an organization."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/Copyright>,
        <http://www.loc.gov/premis/rdf/v3/License>,
        <http://www.loc.gov/premis/rdf/v3/Statute> .

<http://www.loc.gov/premis/rdf/v3/License> a owl:Class ;
    rdfs:label "License"@en ;
    rdfs:comment "A license agreement or other legal document that grants rights."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/Copyright>,
        <http://www.loc.gov/premis/rdf/v3/InstitutionalPolicy>,
        <http://www.loc.gov/premis/rdf/v3/Statute> .

<http://www.loc.gov/premis/rdf/v3/Organization> a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/Agent>,
        prov:Organization,
        foaf:Organization ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/HardwareAgent>,
        <http://www.loc.gov/premis/rdf/v3/Person>,
        <http://www.loc.gov/premis/rdf/v3/SoftwareAgent> .

<http://www.loc.gov/premis/rdf/v3/Person> a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/Agent>,
        prov:Person,
        foaf:Person ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/HardwareAgent>,
        <http://www.loc.gov/premis/rdf/v3/Organization>,
        <http://www.loc.gov/premis/rdf/v3/SoftwareAgent> .

<http://www.loc.gov/premis/rdf/v3/Statute> a owl:Class ;
    rdfs:label "Statute"@en ;
    rdfs:comment "A law that grants or revokes rights, such as laws governing privacy or orphan       works."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/RightsBasis> ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/Copyright>,
        <http://www.loc.gov/premis/rdf/v3/InstitutionalPolicy>,
        <http://www.loc.gov/premis/rdf/v3/License> .

<http://www.loc.gov/premis/rdf/v3/HardwareAgent> a owl:Class ;
    rdfs:label "Hardware agent"@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/Agent> ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/Organization>,
        <http://www.loc.gov/premis/rdf/v3/Person>,
        <http://www.loc.gov/premis/rdf/v3/SoftwareAgent> ;
    owl:sameAs <http://id.loc.gov/vocabulary/preservation/agentType/har> .

<http://www.loc.gov/premis/rdf/v3/Signature> a owl:Class ;
    rdfs:label "Signature"@en ;
    rdfs:comment "Mathematical technique used to validate the authenticity and integrity of a message,       software or digital document."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/signatureMethod> .

<http://www.loc.gov/premis/rdf/v3/SoftwareAgent> a owl:Class ;
    rdfs:label "Software agent"@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/Agent>,
        prov:SoftwareAgent ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/HardwareAgent>,
        <http://www.loc.gov/premis/rdf/v3/Organization>,
        <http://www.loc.gov/premis/rdf/v3/Person> .

<http://www.loc.gov/premis/rdf/v3/note> a owl:DatatypeProperty ;
    rdfs:label "has note"@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:description .

<http://www.loc.gov/premis/rdf/v3/Agent> a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "Actor (human, machine, or software) associated with one or more Event and/or Rights       statement associated with a digital object."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf prov:Agent,
        foaf:Agent .

<http://www.loc.gov/premis/rdf/v3/IntellectualEntity> a owl:Class ;
    rdfs:label "Intellectual entity"@en ;
    rdfs:comment " set of content that is considered a single intellectual unit for purposes of management and       description: for example, a particular book, map, photograph, database, or piece of hardware or       software. An Intellectual Entity can include other Intellectual Entities; for example, a web site can       include a web page; a web page can include an image. An Intellectual Entity may have one or more digital       representations. An Intellectual Entity may also describe an environment, defined as technology       supporting a digital object in some way (e.g. by rendering or executing it). Environments can consist of       software, hardware, or a combination of both."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/environmentFunctionType> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/Object> ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/Bitstream>,
        <http://www.loc.gov/premis/rdf/v3/File>,
        <http://www.loc.gov/premis/rdf/v3/Representation> .

<http://www.loc.gov/premis/rdf/v3/Representation> a owl:Class ;
    rdfs:label "Representation"@en ;
    rdfs:comment "Digital or physical Object instantiating or embodying an Intellectual Entity. A digital       representation is the set of stored digital files and structural metadata needed to provide a complete       and reasonable rendition of the Intellectual Entity. A physical representation is an item such as a       manuscript, video cassette, or printed document."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/Object> ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/Bitstream>,
        <http://www.loc.gov/premis/rdf/v3/File>,
        <http://www.loc.gov/premis/rdf/v3/IntellectualEntity> .

<http://www.loc.gov/premis/rdf/v3/RightsStatus> a owl:Class ;
    rdfs:label "Rights status"@en ;
    rdfs:comment "Information about how a RightsBasis applies to a particular object."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> .

<http://www.loc.gov/premis/rdf/v3/Rule> a owl:Class ;
    rdfs:label "Rule"@en ;
    rdfs:comment "Statement about the Actions an Agent is permitted to undertake or prohibited from       undertaking with respect to an Object."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> .

<http://www.loc.gov/premis/rdf/v3/Bitstream> a owl:Class ;
    rdfs:label "Bitstream"@en ;
    rdfs:comment "Contiguous or non-contiguous data within a file that has meaningful properties for       preservation purposes."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/Object> ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/File>,
        <http://www.loc.gov/premis/rdf/v3/IntellectualEntity>,
        <http://www.loc.gov/premis/rdf/v3/Representation> .

<http://www.loc.gov/premis/rdf/v3/File> a owl:Class ;
    rdfs:label "File"@en ;
    rdfs:comment "Named and ordered sequence of bytes that is known to an operating system."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf <http://www.loc.gov/premis/rdf/v3/Object> ;
    owl:disjointWith <http://www.loc.gov/premis/rdf/v3/Bitstream>,
        <http://www.loc.gov/premis/rdf/v3/IntellectualEntity>,
        <http://www.loc.gov/premis/rdf/v3/Representation> .

<http://www.loc.gov/premis/rdf/v3/Object> a owl:Class ;
    rdfs:label "Object"@en ;
    rdfs:comment "Discrete unit of information subject to digital preservation. Subclasses of Object are       Intellectual Entity, Representation, File and Bitstream."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:subClassOf prov:Entity .

<http://www.loc.gov/premis/rdf/v3/RightsBasis> a owl:Class ;
    rdfs:label "Rights basis"@en ;
    rdfs:comment "Designation of the basis for the right or permission governing the Object."@en ;
    rdfs:isDefinedBy <http://www.loc.gov/premis/rdf/v3/> ;
    rdfs:seeAlso <http://id.loc.gov/vocabulary/preservation/rightsBasis> .

<http://www.loc.gov/premis/rdf/v3/> a owl:Ontology ;
    rdfs:label "PREMIS 3 Ontology"@en ;
    dcterms:modified "2018-10-12"^^xsd:date ;
    rdfs:comment "Ontology for PREMIS 3, the international standard       for metadata to support the preservation of digital objects and ensure their       long-term usability."@en ;
    rdfs:seeAlso <http://www.loc.gov/standards/premis/>,
        <https://github.com/PREMIS-OWL-Revision-Team/revise-premis-owl/> ;
    owl:imports <http://www.w3.org/ns/prov-o-20130430> ;
    owl:versionIRI <http://www.loc.gov/premis/rdf/v3/2018/10/12/> ;
    owl:versionInfo "2018/10/12"^^xsd:string .

