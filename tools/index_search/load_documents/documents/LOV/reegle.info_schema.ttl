@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://reegle.info/schema> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    ns1:license <http://www.nationalarchives.gov.uk/doc/open-government-licence> ;
    dcterms:description "A vocabulary describing the clean energy data published on http://data.reegle.info."@en ;
    dcterms:issued "2011-12-20"^^xsd:date ;
    dcterms:modified "2012-11-16"^^xsd:date ;
    dcterms:title "Reegle RDF Schema"@en ;
    vann:preferredNamespacePrefix "reegle" ;
    vann:preferredNamespaceUri "http://reegle.info/schema#" ;
    rdfs:comment "Version 1.1: Added vocabulary metadata and missing labels for some properties."@en ;
    owl:versionInfo 1.1 .

<http://reegle.info/schema#activeIn> a owl:ObjectProperty ;
    rdfs:label "is active in"@en ;
    rdfs:comment "defines the countries an organisation is active in"@en ;
    rdfs:range <http://www.geonames.org/ontology#Feature> .

<http://reegle.info/schema#activities> a owl:DatatypeProperty ;
    rdfs:label "activities"@en ;
    rdfs:comment "activities of the organisation in the renewable energy & energy efficiency sector."@en ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#capacityConcerns> a owl:DatatypeProperty ;
    rdfs:label "capacity concerns"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#competition> a owl:DatatypeProperty ;
    rdfs:label "competition"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#degreeIndependence> a owl:DatatypeProperty ;
    rdfs:label "degree of independence"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#desirability> a owl:DatatypeProperty ;
    rdfs:label "desirability"@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyDebates> a owl:DatatypeProperty ;
    rdfs:label "energy debates"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyEfficiency> a owl:DatatypeProperty ;
    rdfs:label "energy efficiency"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyEfficiencyIndustry> a owl:DatatypeProperty ;
    rdfs:label "energy efficiency industry"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyEfficiencyPublic> a owl:DatatypeProperty ;
    rdfs:label "energy efficiency public"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyEfficiencyResidantial> a owl:DatatypeProperty ;
    rdfs:label "energy efficiency residential"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyEfficiencyTransport> a owl:DatatypeProperty ;
    rdfs:label "energy efficiency transport"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyEfficiencyUtilities> a owl:DatatypeProperty ;
    rdfs:label "energy efficiency utilities"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyFramework> a owl:DatatypeProperty ;
    rdfs:label "energy framework"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyProcedure> a owl:DatatypeProperty ;
    rdfs:label "energy procedure"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyRegulationRole> a owl:DatatypeProperty ;
    rdfs:label "energy regulation role"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyRegulator> a owl:DatatypeProperty ;
    rdfs:label "energy regulator"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#energyStudies> a owl:DatatypeProperty ;
    rdfs:label "energy debates"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#extendNetwork> a owl:DatatypeProperty ;
    rdfs:label "extend network"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#funded> a owl:DatatypeProperty ;
    rdfs:label "funded"@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#governmentAgencies> a owl:DatatypeProperty ;
    rdfs:label "government agencies"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#governmentRole> a owl:DatatypeProperty ;
    rdfs:label "role of the government"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#mission> a owl:DatatypeProperty ;
    rdfs:label "mission"@en ;
    rdfs:comment "the declared mission of the organisation."@en ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#organisationType> a owl:DatatypeProperty ;
    rdfs:label "organisation type"@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#ownership> a owl:DatatypeProperty ;
    rdfs:label "ownership"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#profile> a owl:ObjectProperty ;
    rdfs:label "has country profile"@en ;
    rdfs:range <http://reegle.info/schema#CountryProfile> .

<http://reegle.info/schema#projectDescription> a owl:DatatypeProperty ;
    rdfs:label "project description"@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#projectExpertise> a owl:DatatypeProperty ;
    rdfs:label "project expertise"@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#projectTitle> a owl:DatatypeProperty ;
    rdfs:label "project title"@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#referenceNumber> a owl:DatatypeProperty ;
    rdfs:label "reference number\""@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range <http://www.w3.org/2001/XMLSchema-datatypes#int> .

<http://reegle.info/schema#references> a owl:DatatypeProperty ;
    rdfs:label "references\""@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range <http://www.w3.org/2001/XMLSchema-datatypes#int> .

<http://reegle.info/schema#regulatoryBarriers> a owl:DatatypeProperty ;
    rdfs:label "regulatory barriers"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#regulatoryFramework> a owl:DatatypeProperty ;
    rdfs:label "regulatory framework"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#regulatoryRoles> a owl:DatatypeProperty ;
    rdfs:label "regulatory roles"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#reliance> a owl:DatatypeProperty ;
    rdfs:label "reliance"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#renewableEnergy> a owl:DatatypeProperty ;
    rdfs:label "renewable energy"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#sector> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "in sector"@en,
        "sector"@en ;
    rdfs:comment "The sector an organisation is active in."@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range <http://reegle.info/schema#Sector>,
        rdfs:Literal .

<http://reegle.info/schema#sources> a owl:DatatypeProperty ;
    rdfs:label "energy sources"@en ;
    rdfs:domain <http://reegle.info/schema#CountryProfile> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#specialisation> a owl:ObjectProperty ;
    rdfs:label "specialisation"@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range <http://reegle.info/schema#Specialisation> .

<http://reegle.info/schema#targetAudience> a owl:DatatypeProperty ;
    rdfs:label "target audience"@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range rdfs:Literal .

<http://reegle.info/schema#technology> a owl:ObjectProperty ;
    rdfs:label "technology"@en ;
    rdfs:comment "the technologies that are related to a project"@en ;
    rdfs:domain <http://reegle.info/schema#ProjectOutput> ;
    rdfs:range <http://reegle.info/schema#Technology> .

<http://reegle.info/schema#Sector> a owl:Class ;
    rdfs:label "sector"@en ;
    rdfs:comment "A sector in the field of renewable energy and energy efficiency."@en .

<http://reegle.info/schema#Specialisation> a owl:Class ;
    rdfs:label "specialisation"@en .

<http://reegle.info/schema#Technology> a owl:Class ;
    rdfs:label "technology"@en .

<http://reegle.info/schema#ProjectOutput> a owl:Class ;
    rdfs:label "project output"@en ;
    rdfs:comment "output summary of a renewable energy & energy efficiency project."@en .

<http://reegle.info/schema#CountryProfile> a owl:Class ;
    rdfs:label "country profle"@en .

