@prefix ns1: <http://www.w3.org/ns/rdfa#> .
@prefix ns2: <http://www.w3.org/1999/xhtml/vocab#> .
@prefix onto: <http://www.w3.org/1999/xhtml/vocab> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: ns2:stylesheet <http://www.w3.org/StyleSheets/TR/base.css> .

ns2:alert a rdf:Property ;
    rdfs:comment "A message\\n      with important, and usually time-sensitive, information. Also see alertdialog\\n      and status."^^xsd:string .

ns2:alertdialog a rdf:Property ;
    rdfs:comment "A\\n      type of dialog that contains an alert message, where initial focus goes\\n      an element within the dialog. Also see alert and dialog."^^xsd:string .

ns2:alternate a rdf:Property ;
    rdfs:comment "alternate \\n    designates alternate versions for a resource."^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "alternate" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#alternate" .

ns2:appendix a rdf:Property ;
    rdfs:comment "appendix refers to a resource serving\\n      as an appendix in a collection. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "appendix" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#appendix" .

ns2:application a rdf:Property ;
    rdfs:comment "A\\n      region declared as a web application, as opposed to a web document."^^xsd:string .

ns2:article a rdf:Property ;
    rdfs:comment "A section\\n      of a page that consists of a composition that forms an independent part\\n      of a document, page, or site."^^xsd:string .

ns2:banner a rdf:Property ;
    rdfs:comment "contains\\n      the prime heading or internal title of a page. "^^xsd:string ;
    rdfs:member ns2:role-properties .

ns2:bookmark a rdf:Property ;
    rdfs:comment "bookmark refers to a bookmark - a link\\n      to a key entry point within an extended document. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "bookmark" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#bookmark" .

ns2:button a rdf:Property ;
    rdfs:comment "An input\\n      that allows for user-triggered actions when clicked or pressed. Also see\\n      link."^^xsd:string .

ns2:chapter a rdf:Property ;
    rdfs:comment "chapter refers to a resource serving\\n      as a chapter in a collection. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "chapter" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#chapter" .

ns2:checkbox a rdf:Property ;
    rdfs:comment "A checkable\\n      input that has three possible values: true, false, or mixed."^^xsd:string .

ns2:cite a rdf:Property ;
    rdfs:comment "cite refers to a resource that defines\\n      a citation. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "cite" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#cite" .

ns2:columnheader a rdf:Property ;
    rdfs:comment "A\\n      cell containing header information for a column."^^xsd:string .

ns2:combobox a rdf:Property ;
    rdfs:comment "A presentation\\n      of a select; usually similar to a textbox where users can type ahead to\\n      select an option, or type to enter arbitrary text as a new item in the\\n      list. Also see listbox."^^xsd:string .

ns2:complementary a rdf:Property ;
    rdfs:comment "indicates that the section supports but is\\n      separable from the main content of resource."^^xsd:string ;
    rdfs:member ns2:role-properties .

ns2:contentinfo a rdf:Property ;
    rdfs:comment "contains meta information about the\\n      content on the page or the page as a whole."^^xsd:string ;
    rdfs:member ns2:role-properties .

ns2:contents a rdf:Property ;
    rdfs:comment "contents refers to a resource serving\\n      as a table of contents. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "contents" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#contents" .

ns2:copyright a rdf:Property ;
    rdfs:comment "copyright refers to a copyright\\n      statement for the resource. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "copyright" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#copyright" .

ns2:definition a rdf:Property ;
    rdfs:comment "indicates the definition of a term or concept."^^xsd:string ;
    rdfs:member ns2:role-properties .

ns2:dialog a rdf:Property ;
    rdfs:comment "A dialog\\n      is an application window that is designed to interrupt the current processing\\n      of an application in order to prompt the user to enter information or require\\n      a response. Also see alertdialog."^^xsd:string .

ns2:directory a rdf:Property ;
    rdfs:comment "A list\\n      of references to members of a group, such as a static table of contents."^^xsd:string .

ns2:document a rdf:Property ;
    rdfs:comment "A region\\n      containing related information that is declared as document content, as\\n      opposed to a web application."^^xsd:string .

ns2:first a rdf:Property ;
    rdfs:comment "first refers the first item in a\\n      collection (see also start and top)."^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "first" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#first" .

ns2:form a rdf:Property ;
    rdfs:comment "A landmark\\n      region that contains a collection of items and objects that, as a whole,\\n      combine to create a form. Also see search."^^xsd:string .

ns2:glossary a rdf:Property ;
    rdfs:comment "glossary refers to a resource\\n      providing a glossary of terms. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "glossary" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#glossary" .

ns2:grid a rdf:Property ;
    rdfs:comment "A grid is\\n      an interactive control which contains cells of tabular data arranged in\\n      rows and columns, like a table."^^xsd:string .

ns2:gridcell a rdf:Property ;
    rdfs:comment "A cell\\n      in a grid or treegrid."^^xsd:string .

ns2:group a rdf:Property ;
    rdfs:comment "A set of\\n      user interface objects which are not intended to be included in a page\\n      summary or table of contents by assistive technologies."^^xsd:string .

ns2:heading a rdf:Property ;
    rdfs:comment "A heading\\n      for a section of the page."^^xsd:string .

ns2:help a rdf:Property ;
    rdfs:comment "help refers to a resource offering\\n      help. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "help" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#help" .

ns2:icon a rdf:Property ;
    rdfs:comment "icon refers to a resource that\\n      represents an icon. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "icon" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#icon" .

ns2:img a rdf:Property ;
    rdfs:comment "A container\\n      for a collection of elements that form an image."^^xsd:string .

ns2:index a rdf:Property ;
    rdfs:comment "index refers to a resource providing\\n      an index. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "index" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#index" .

ns2:itsRules a rdf:Property ;
    rdfs:comment "itsRules indicates that the designated\\n      resource is an [ITS] rule set."^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "itsRules" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#itsRules" .

ns2:last a rdf:Property ;
    rdfs:comment "last refers to the last resource in a\\n      collection of resources. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "last" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#last" .

ns2:license a rdf:Property ;
    rdfs:comment "license refers to a resource that\\n      defines the associated license. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "license" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#license" .

ns2:link a rdf:Property ;
    rdfs:comment "An interactive\\n      reference to an internal or external resource that, when activated, causes\\n      the user agent to navigate to that resource. Also see button."^^xsd:string .

ns2:list a rdf:Property ;
    rdfs:comment "A group of\\n      non-interactive list items. Also see listbox."^^xsd:string .

ns2:listbox a rdf:Property ;
    rdfs:comment "A widget\\n      that allows the user to select one or more items from a list of choices.\\n      Also see combobox and list."^^xsd:string .

ns2:listitem a rdf:Property ;
    rdfs:comment "A single\\n      item in a list or directory."^^xsd:string .

ns2:log a rdf:Property ;
    rdfs:comment "A type of\\n      live region where new information is added in meaningful order and old\\n      information may disappear. Also see marquee."^^xsd:string .

ns2:main a rdf:Property ;
    rdfs:comment "acts as the\\n      main content of the document. "^^xsd:string ;
    rdfs:member ns2:role-properties .

ns2:marquee a rdf:Property ;
    rdfs:comment "A type\\n      of live region where non-essential information changes frequently. Also\\n      see log."^^xsd:string .

ns2:math a rdf:Property ;
    rdfs:comment "Content that\\n      represents a mathematical expression. "^^xsd:string .

ns2:menu a rdf:Property ;
    rdfs:comment "A type of\\n      widget that offers a list of choices to the user."^^xsd:string .

ns2:menubar a rdf:Property ;
    rdfs:comment "A presentation\\n      of menu that usually remains visible and is usually presented horizontally."^^xsd:string .

ns2:menuitem a rdf:Property ;
    rdfs:comment "An option\\n      in a group of choices contained by a menu or menubar."^^xsd:string .

ns2:menuitemcheckbox a rdf:Property ;
    rdfs:comment "A\\n      checkable menuitem that has three possible values: true, false, or mixed."^^xsd:string .

ns2:menuitemradio a rdf:Property ;
    rdfs:comment "A\\n      checkable menuitem in a group of menuitemradio roles, only one of which\\n      can be checked at a time."^^xsd:string .

ns2:meta a rdf:Property ;
    rdfs:comment "meta refers to a resource that\\n      provides metadata. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "meta" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#meta" .

ns2:navigation a rdf:Property ;
    rdfs:comment "indicates a collection of items suitable for\\n      navigating the document or related documents."^^xsd:string ;
    rdfs:member ns2:role-properties .

ns2:next a rdf:Property ;
    rdfs:comment "next refers to the next resource\\n      (after the current one) in an ordered collection of resources. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "next" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#next" .

ns2:note a rdf:Property ;
    rdfs:comment "indicates\\n      the content is parenthetic or ancillary to the main content of the\\n      resource. "^^xsd:string ;
    rdfs:member ns2:role-properties .

ns2:option a rdf:Property ;
    rdfs:comment "A selectable\\n      item in a select list."^^xsd:string .

ns2:p3pv1 a rdf:Property ;
    rdfs:comment "p3pv1 refers to a P3P Policy Reference\\n      File [P3P]. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "p3pv1" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#p3pv1" .

ns2:presentation a rdf:Property ;
    rdfs:comment "An\\n      element whose implicit native role semantics will not be mapped to the\\n      accessibility API."^^xsd:string .

ns2:prev a rdf:Property ;
    rdfs:comment "prev refers to a previous resource\\n      (before the current one) in an ordered collection of resources. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "prev" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#prev" .

ns2:progressbar a rdf:Property ;
    rdfs:comment "An\\n      element that displays the progress status for tasks that take a long time."^^xsd:string .

ns2:radio a rdf:Property ;
    rdfs:comment "A checkable\\n      input in a group of radio roles, only one of which can be checked at a\\n      time."^^xsd:string .

ns2:radiogroup a rdf:Property ;
    rdfs:comment "A group\\n      of radio buttons."^^xsd:string .

ns2:region a rdf:Property ;
    rdfs:comment "A large\\n      perceivable section of a web page or document, that the author feels is\\n      important enough to be included in a page summary or table of contents,\\n      for example, an area of the page containing live sporting event statistics."^^xsd:string .

ns2:role a rdf:Bag,
        rdf:Property ;
    rdfs:comment "role indicates the purpose of the\\n      resource. See the XHTML Role\\n      Vocabulary for roles in this vocabulary space, and XHTMLROLE for information on extending the\\n      collection of roles. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "role" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#role" .

ns2:row a rdf:Property ;
    rdfs:comment "A row of cells\\n      in a grid."^^xsd:string .

ns2:rowgroup a rdf:Property ;
    rdfs:comment "A group\\n      containing one or more row elements in a grid."^^xsd:string .

ns2:rowheader a rdf:Property ;
    rdfs:comment "A cell\\n      containing header information for a row in a grid."^^xsd:string .

ns2:scrollbar a rdf:Property ;
    rdfs:comment "A graphical\\n      object that controls the scrolling of content within a viewing area, regardless\\n      of whether the content is fully displayed within the viewing area."^^xsd:string .

ns2:search a rdf:Property ;
    rdfs:comment "indicates\\n      that the section provides a search facility. "^^xsd:string ;
    rdfs:member ns2:role-properties .

ns2:section a rdf:Property ;
    rdfs:comment "section refers to a resource serving\\n      as a section in a collection. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "section" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#section" .

ns2:separator a rdf:Property ;
    rdfs:comment "A divider\\n      that separates and distinguishes sections of content or groups of menuitems."^^xsd:string .

ns2:slider a rdf:Property ;
    rdfs:comment "A user\\n      input where the user selects a value from within a given range."^^xsd:string .

ns2:spinbutton a rdf:Property ;
    rdfs:comment "A form\\n      of range that expects a user to select from amongst discrete choices."^^xsd:string .

ns2:start a rdf:Property ;
    rdfs:comment "start refers to the first resource in\\n      a collection of resources. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "start" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#start" .

ns2:status a rdf:Property ;
    rdfs:comment "A container\\n      whose content is advisory information for the user but is not important\\n      enough to justify an alert. Also see alert."^^xsd:string .

ns2:stylesheet a rdf:Property ;
    rdfs:comment "stylesheet refers to a resource\\n      serving as a stylesheet for a resource. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "stylesheet" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#stylesheet" .

ns2:subsection a rdf:Property ;
    rdfs:comment "subsection refers to a resource\\n      serving as a subsection in a collection. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "subsection" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#subsection" .

ns2:tab a rdf:Property ;
    rdfs:comment "A grouping\\n      label providing a mechanism for selecting the tab content that is to be\\n      rendered to the user."^^xsd:string .

ns2:tablist a rdf:Property ;
    rdfs:comment "A list\\n      of tab elements, which are references to tabpanel elements."^^xsd:string .

ns2:tabpanel a rdf:Property ;
    rdfs:comment "A container\\n      for the resources associated with a tab, where each tab is contained in\\n      a tablist."^^xsd:string .

ns2:textbox a rdf:Property ;
    rdfs:comment "Input\\n      that allows free-form text as its value."^^xsd:string .

ns2:timer a rdf:Property ;
    rdfs:comment "A type of\\n      live region containing a numerical counter which indicates an amount of\\n      elapsed time from a start point, or the time remaining until an end point."^^xsd:string .

ns2:toolbar a rdf:Property ;
    rdfs:comment "A collection\\n      of commonly used function buttons represented in compact visual form."^^xsd:string .

ns2:tooltip a rdf:Property ;
    rdfs:comment "A contextual\\n      popup that displays a description for an element."^^xsd:string .

ns2:top a rdf:Property ;
    rdfs:comment "top is a synonym for start. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "top" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#top" .

ns2:tree a rdf:Property ;
    rdfs:comment "A type of\\n      list that may contain sub-level nested groups that can be collapsed and\\n      expanded."^^xsd:string .

ns2:treegrid a rdf:Property ;
    rdfs:comment "A grid\\n      whose rows can be expanded and collapsed in the same manner as for a tree."^^xsd:string .

ns2:treeitem a rdf:Property ;
    rdfs:comment "An option\\n      item of a tree. This is an element within a tree that may be expanded or\\n      collapsed if it contains a sub-level group of treeitems."^^xsd:string .

ns2:up a rdf:Property ;
    rdfs:comment "up refers to a resource \"above\" in a\\n      hierarchically structured set. "^^xsd:string ;
    rdfs:member ns2:relrev-properties ;
    ns1:term "up" ;
    ns1:uri "http://www.w3.org/1999/xhtml/vocab#up" .

ns2:role-properties a rdf:Bag,
        rdfs:member .

ns2:relrev-properties a rdf:Bag ;
    rdfs:member ns2:role-properties .

