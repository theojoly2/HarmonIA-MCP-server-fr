@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://purl.org/imbi/ru-meta.owl#> .
@prefix onto: <http://purl.org/biotop/biotop.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

onto: a owl:Ontology ;
    dc:creator "Stefan Schulz, Martin Boeker, Elena Beisswanger, Holger Stenzhorn, Djamila Raufie, Daniel Schober, Udo Hahn" ;
    dc:description "BioTop Website:\\nhttp://purl.org/biotop\\n\\n\\nSee related articles at:\\n\\nhttp://www.google.com/search?q=Schulz+BioTop+site:www.ncbi.nlm.nih.gov/pmc/articles+ontology+OR+ontologies",
        "Upper-Level ontology for Biology and Medicine. Compatible with BFO, DOLCE, and the UMLS Semantic Network (mapping files available)" ;
    dc:format "application/rdf+xml" ;
    dc:identifier "20120424",
        "http://purl.org/biotop/biotop.owl" ;
    dc:publisher "Institute of Medical Biometry and Medical Informatics, University Medical Center Freiburg, Stefan-Meier-Strasse 26, 79104 Freiburg, Germany\\n\\nInstitute of Medical Informatics, Statistics and Documentation, Medical University of Graz, Auenbruggerplatz 2/V , 8036 Graz (Austria)" ;
    dc:rights "http://creativecommons.org/licenses/by/3.0" ;
    dc:subject "An experimental top level ontology for biology and medicine.",
        "Biology, Medicine" ;
    dc:title "BioTop" ;
    owl:versionInfo "Last modification\\nApr 24, 2012 by Stefan Schulz" .

<http://purl.org/biotop/biotop.owl#AcquiredAbnormalStructure> a owl:Class ;
    rdfs:label "acquired abnormal structure" ;
    ns1:definition "biological structure that deviates from what is considered normal and that evolved during lifetime" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PathologicalStructure> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#CongenitalAbnormalStructure> .

<http://purl.org/biotop/biotop.owl#AcquiredPathologicalStaticProcessualEntity> a owl:Class ;
    rdfs:label "acquired pathological static processual entity" ;
    ns1:definition "pathological state acquired during lifetime" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#PathologicalStaticProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#AcquiredPathologicalCondition> ] ) ] ] ) ] ;
    owl:priorVersion "acquired pathological state" .

<http://purl.org/biotop/biotop.owl#AminoAcidSequenceInformation> a owl:Class ;
    rdfs:label "amino acid sequence information" ;
    ns1:definition "The information that describes the make-up of a (physical) amino acid sequence." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#AmountOfBodySubstance> a owl:Class ;
    rdfs:label "amount of body substance" ;
    ns1:definition "collection with molecules or atoms as granular parts (but which may have also bigger granular parts) that is produced by a biological system (e.g. blood, urine, ivory)" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#CompoundOfCollectiveMaterialEntities> .

<http://purl.org/biotop/biotop.owl#Analyzing> a owl:Class ;
    rdfs:label "analyzing" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HumanAction> .

<http://purl.org/biotop/biotop.owl#AnimalExcludingHuman> a owl:Class ;
    rdfs:label "animal excluding human" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#AnimalIncludingHuman> [ a owl:Class ;
                        owl:complementOf <http://purl.org/biotop/biotop.owl#Human> ] ) ] .

<http://purl.org/biotop/biotop.owl#AntibioticRole> a owl:Class ;
    rdfs:label "antibiotic role" ;
    ns1:definition "the role a chemical plays if used to combat a bacterial infection" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DrugRole> .

<http://purl.org/biotop/biotop.owl#ArchaebacterialCell> a owl:Class ;
    rdfs:label "archaebacterial cell" ;
    ns1:synonym "Archaebacterium" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:allValuesFrom <http://purl.org/biotop/biotop.owl#KingdomArchaeaValueRegion> ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Prokaryote> .

<http://purl.org/biotop/biotop.owl#ArthropodPopulation> a owl:Class ;
    rdfs:label "arthropod population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Arthropod> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Arthropod> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#BacteriaPopulation> a owl:Class ;
    rdfs:label "bacteria population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#BacterialCell> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#BacterialCell> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#BacterialColony> a owl:Class ;
    rdfs:label "bacterial colony" ;
    ns1:definition "Cluster of bacteria, usually cultured from a single cell." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#BiologicalColony> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#BacterialCell> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#BacterialCell> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#BakersYeastPopulation> a owl:Class ;
    rdfs:label "bakers yeast population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#BakersYeastCell> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#BakersYeastCell> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#BioMolecularProcess> a owl:Class ;
    rdfs:label "bio molecular process" ;
    ns1:definition "Process occuring on molecular level. It has exclusivly subclasses of MolecularEntity as participants." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#BiologicalProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ] ) ] .

<http://purl.org/biotop/biotop.owl#BioMolecularSequenceInformation> a owl:Class ;
    rdfs:label "bio molecular sequence information" ;
    ns1:definition "Sequence as an entity of information. The same sequence can inhere in different biopolymers. Sequence information can be theoretical, therefore a \"real\" sequence is not implied." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#BioMolecularSequenceStructure> a owl:Class ;
    rdfs:label "bio molecular sequence structure" ;
    ns1:definition "chain (segment) of similar monomers such as proteins or nucleotides" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganicMolecularEntity> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#AminoAcidSequence> <http://purl.org/biotop/biotop.owl#ChainOfCarbohydrateMonomers> <http://purl.org/biotop/biotop.owl#ChainOfNucleotideMonomers> <http://purl.org/biotop/biotop.owl#DNAChain> <http://purl.org/biotop/biotop.owl#RNAChain> ) ] .

<http://purl.org/biotop/biotop.owl#BiologicalBoundary> a owl:Class ;
    rdfs:label "biological boundary" ;
    ns1:definition "boundary in or of a biological entity" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PhysicalBoundary> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#physicallyBounds> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#BiologicalSpace> <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ) ] ] .

<http://purl.org/biotop/biotop.owl#BiomedicalMaterialRole> a owl:Class ;
    rdfs:label "biomedical material role" ;
    ns1:definition "Role of Non-drug material used for therapeutic Purpose" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TherapeuticRole> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#DrugRole> .

<http://purl.org/biotop/biotop.owl#Biomolecule> a owl:Class ;
    rdfs:label "biomolecule" ;
    ns1:definition "Monomolecular entity that stems from some organism" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#originatesFrom> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] ) ] .

<http://purl.org/biotop/biotop.owl#BodyLiquid> a owl:Class ;
    rdfs:label "body liquid" ;
    ns1:definition "Suspension and / or solution of biomolecules, ions, bigger particles in Water." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ] ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#WaterMolecule> ] ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#originatesFrom> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ],
        <http://purl.org/biotop/biotop.owl#PortionOfHeterogenousLiquid> .

<http://purl.org/biotop/biotop.owl#CandidaAlbicansPopulation> a owl:Class ;
    rdfs:label "candida albicans population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CandidaAlbicansCell> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#CandidaAlbicansCell> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#CanonicalProcessualEntity> a owl:Class ;
    rdfs:label "canonical processual entity" ;
    ns1:definition "a process that is considered normal" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Process> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#NoncanonicalProcessualEntity> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Process> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CanonicalValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#CanonicalStaticProcessualEntity> a owl:Class ;
    rdfs:label "canonical static processual entity" ;
    rdfs:comment "a biological state that is considered \"normal\"" ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#NoncanonicalStaticProcessualEntity> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#StaticProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CanonicalValueRegion> ] ) ] ] ) ] ;
    owl:priorVersion "canonical state" .

<http://purl.org/biotop/biotop.owl#CarbohydrateSequenceInformation> a owl:Class ;
    rdfs:label "carbohydrate sequence information" ;
    ns1:definition "The information that describes the make-up of a (physical) carbohydrate sequence." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#CategorizationSystem> a owl:Class ;
    rdfs:label "categorization system" ;
    ns1:definition "A categorization system is a human artifact that aims at partinioning object classes, denotations, or concepts of a given domain." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#IntellectualProduct> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#RegulationOrLaw> .

<http://purl.org/biotop/biotop.owl#Causing> a owl:Class ;
    rdfs:label "causing" ;
    ns1:definition "action that causes an effect" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Affecting> .

<http://purl.org/biotop/biotop.owl#ChlamydiaCell> a owl:Class ;
    rdfs:label "chlamydia cell" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Prokaryote> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#RickettsiaCell> .

<http://purl.org/biotop/biotop.owl#Chromosome> a owl:Class ;
    rdfs:label "chromosome" ;
    ns1:definition "Organized form of DNA in cells, containing one very long, continuous piece of DNA, which contains many genes, regulatory elements and other intervening nucleotide sequences. Includes also the DNA-bound proteins which serve to package and manage the DNA." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EntireNucleicAcidMolecule> ],
        <http://purl.org/biotop/biotop.owl#MoleculeComplex> .

<http://purl.org/biotop/biotop.owl#Complicating> a owl:Class ;
    rdfs:label "complicating" ;
    ns1:definition "causes to become more severe" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Affecting> .

<http://purl.org/biotop/biotop.owl#CongenitalPathologicalStaticProcessualEntity> a owl:Class ;
    rdfs:label "congenital pathological static processual entity" ;
    ns1:definition "pathological state present at birth" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#PathologicalStaticProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CongenitalPathologicalCondition> ] ) ] ] ) ] ;
    owl:priorVersion "congenital pathological state" .

<http://purl.org/biotop/biotop.owl#DeadBody> a owl:Class ;
    rdfs:label "dead body" ;
    ns1:definition "body that is the transformation of a living body after death" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Body> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#LivingBody> .

<http://purl.org/biotop/biotop.owl#Death> a owl:Class ;
    rdfs:label "death" ;
    ns1:definition "End of live of a biological system" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#BiologicalProcessualEntity> [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasDuration> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TimeInterval> ] ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasPointInTime> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PointInTime> ] ) ] .

<http://purl.org/biotop/biotop.owl#DigitalEntity> a owl:Class ;
    rdfs:label "digital entity" ;
    ns1:definition "any kind of information that is fully expressible by a sequence of binary values." ;
    rdfs:comment "(OBI 306)" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#InformationObject> .

<http://purl.org/biotop/biotop.owl#Disrupting> a owl:Class ;
    rdfs:label "disrupting" ;
    ns1:definition "Producing a negative effect on" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#Function> <http://purl.org/biotop/biotop.owl#MaterialObject> <http://purl.org/biotop/biotop.owl#Process> ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasPatient> ],
        <http://purl.org/biotop/biotop.owl#Affecting> .

<http://purl.org/biotop/biotop.owl#EmbryonicStructure> a owl:Class ;
    rdfs:label "embryonic structure" ;
    ns1:definition "An embryo or any structure derived from it. There may be structures derived from an embryo that are no longer considered embryonic ones, hence no full definition." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#EmbryonicOrganism> [ a owl:Restriction ;
                                    owl:onProperty <http://purl.org/biotop/biotop.owl#originatesFrom> ;
                                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EmbryonicOrganism> ] ) ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#DevelopmentalQuality> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EmbryonicValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#EntireCarbohydrateMonomer> a owl:Class ;
    rdfs:label "entire carbohydrate monomer" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#CarbohydrateMonomer> [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ] ] ) ] .

<http://purl.org/biotop/biotop.owl#EnzymeRole> a owl:Class ;
    rdfs:label "enzyme role" ;
    rdfs:comment "The role a peptide plays in accelerating a biochemical reaction" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#CatalyticRole> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#PeptideStructure> <http://purl.org/biotop/biotop.owl#RNAChain> ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#EscherichiaColiPopulation> a owl:Class ;
    rdfs:label "escherichia coli population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EscherichiaColiCell> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#EscherichiaColiCell> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#EukaryotePopulation> a owl:Class ;
    rdfs:label "eukaryote population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Eukaryote> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Eukaryote> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#Event> a owl:Class ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#ExaminationResultRole> a owl:Class ;
    rdfs:label "examination result role" ;
    ns1:definition "The role a measurement plays if it has been produced in the context of the quantitative assessment of a biological system" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FindingRole> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#SignOrSymptomRole> .

<http://purl.org/biotop/biotop.owl#FamilyOfIndividualOrganisms> a owl:Class ;
    rdfs:label "family of individual organisms" ;
    rdfs:comment "unclear classe. to be revised" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#FruitFlyPopulation> a owl:Class ;
    rdfs:label "fruit fly population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#FruitFly> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#FruitFly> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#FungusPopulation> a owl:Class ;
    rdfs:label "fungus population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Fungus> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Fungus> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#GeneInformation> a owl:Class ;
    rdfs:label "gene information" ;
    ns1:definition "Information that resides on a gene." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#GeneRegion> a owl:Class ;
    rdfs:label "gene region" ;
    ns1:definition "part of a gene" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#GenomeInformation> a owl:Class ;
    rdfs:label "genome information" ;
    ns1:definition "The totality of hereditary information of an organism" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#GeographicSurface> a owl:Class ;
    rdfs:label "geographic surface" ;
    ns1:definition "delineated surface of a large solid body in space (earth, moon, sun,...)" ;
    rdfs:comment "previous name \"geographic entity\"" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TwoDimensionalPhysicalEntity> .

<http://purl.org/biotop/biotop.owl#Government> a owl:Class ;
    rdfs:label "government" ;
    ns1:definition "entity governing a defined group of people" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Organization> .

<http://purl.org/biotop/biotop.owl#GreatApePopulation> a owl:Class ;
    rdfs:label "great ape population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#GreatApe> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#GreatApe> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#HumanEpithelialCell> a owl:Class ;
    rdfs:label "human epithelial cell" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#EpithelialCell> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#originatesFrom> ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                                    owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SpeciesHomoSapiensValueRegion> ] ) ] ] ] ) ] .

<http://purl.org/biotop/biotop.owl#HumanReasoning> a owl:Class ;
    rdfs:label "human reasoning" ;
    ns1:definition "Process in which a human creates an intellectual product" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HumanAction> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#HumanAction> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Human> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasOutcome> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#IntellectualProduct> ] ) ] .

<http://purl.org/biotop/biotop.owl#Hurting> a owl:Class ;
    rdfs:label "hurting" ;
    rdfs:comment "negatively affecting a biological system by using physical force" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PhysicalForce> ],
        <http://purl.org/biotop/biotop.owl#ActionOnBiologicalSystem> .

<http://purl.org/biotop/biotop.owl#ImmaterialNonphysicalEntity> a owl:Class ;
    rdfs:label "immaterial nonphysical entity" ;
    ns1:definition "Continuant entity that has neither a mass nor a volume and which do not inhere in other entities." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#ImmaterialPhysicalEntity> a owl:Class ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#Indicating> a owl:Class ;
    rdfs:label "indicating" ;
    ns1:definition "action that indicates something" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Affecting> .

<http://purl.org/biotop/biotop.owl#IndividualBehavior> a owl:Class ;
    rdfs:label "individual behavior" ;
    ns1:definition "Behavior of an individual organism" ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#SocialBehavior> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Behavior> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ] ) ] .

<http://purl.org/biotop/biotop.owl#InformationEntity> a owl:Class ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#InsectPopulation> a owl:Class ;
    rdfs:label "insect population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Insect> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Insect> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#InstantaneousProcess> a owl:Class ;
    rdfs:label "instantaneous process" ;
    ns1:definition "What happens at one point in time, typically a process boundary. \\nName \"event\" deprecated\\n" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Process> [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasDuration> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TimeInterval> ] ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasPointInTime> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PointInTime> ] ) ] .

<http://purl.org/biotop/biotop.owl#IntraCellularProcess> a owl:Class ;
    rdfs:label "intra cellular process" ;
    ns1:definition "Process occuring in a cell." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#BiologicalProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasLocus> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Cell> ] ) ] .

<http://purl.org/biotop/biotop.owl#MachineAction> a owl:Class ;
    rdfs:label "machine action" ;
    ns1:definition "An action performed by a machine. A machine is here seen as a non-biological artifact." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Action> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#MaterialObject> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#ArtefactRole> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#MacroscopicValueRegion> a owl:Class ;
    rdfs:label "macroscopic value region" ;
    ns1:definition "size values of objects that are visible to the naked eye" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#BiologicalSizeValueRegion> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#MicroscopicValueRegion> .

<http://purl.org/biotop/biotop.owl#MammalPopulation> a owl:Class ;
    rdfs:label "mammal population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Mammal> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Mammal> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#ManagingCare> a owl:Class ;
    rdfs:label "managing care" ;
    ns1:definition "action in which a subject cares for the well-being of some biological entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#Human> <http://purl.org/biotop/biotop.owl#LegalEntity> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Human> ] ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ],
        <http://purl.org/biotop/biotop.owl#Affecting> .

<http://purl.org/biotop/biotop.owl#MaterialEntity> a owl:Class ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#Measure> a owl:Class ;
    rdfs:label "measure" ;
    ns1:definition "Numeric quantity or cardinality, reference for measurement processes. Example kilogram, hour, ampere." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#InformationObject> .

<http://purl.org/biotop/biotop.owl#MeasurementMethod> a owl:Class ;
    rdfs:label "measurement method" ;
    ns1:definition "Plan that is realized by a measurement process." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Plan> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Plan> [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#MeasuringAction> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasRealization> ] ) ] .

<http://purl.org/biotop/biotop.owl#Membership> a owl:Class ;
    rdfs:label "membership" ;
    ns1:definition "Process that endures while something or some person is part of a legal entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#Human> <http://purl.org/biotop/biotop.owl#LegalEntity> ) ] ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasPatient> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LegalEntity> ],
        <http://purl.org/biotop/biotop.owl#ImmaterialProcessualEntity> .

<http://purl.org/biotop/biotop.owl#MentalFunction> a owl:Class ;
    rdfs:label "mental function" ;
    ns1:definition "biological function ascribed to the behavioral manisfestations of the brain" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#BiologicalFunction> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CentralNervousSystem> ] ) ] .

<http://purl.org/biotop/biotop.owl#MentalProcess> a owl:Class ;
    rdfs:label "mental process" ;
    rdfs:comment "process in an organism as a realization of a mental function" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganismProcess> .

<http://purl.org/biotop/biotop.owl#Microorganism> a owl:Class ;
    rdfs:label "microorganism" ;
    ns1:definition "organism that can be seen only through a microscope" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#LivingOrganism> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MicroscopicValueRegion> ] ] ) ] .

<http://purl.org/biotop/biotop.owl#Mind> a owl:Class ;
    rdfs:label "mind" ;
    rdfs:comment "Difficult concept. Better to be expressed by the primitive \"mental function\" " ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#NeoplasticProcess> a owl:Class ;
    rdfs:label "neoplastic process" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#GrowingProcess> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#NoncanonicalValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#NucleicAcidRegion> a owl:Class ;
    rdfs:label "nucleic acid region" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#NucleotideSequenceInformation> a owl:Class ;
    rdfs:label "nucleotide sequence information" ;
    ns1:definition "The information that describes the make-up of a (physical) nucleotide sequence." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#NurseRole> a owl:Class ;
    rdfs:label "nurse role" ;
    ns1:definition "The role a nurse plays" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HealthProfessionalRole> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#PhysicianRole> .

<http://purl.org/biotop/biotop.owl#ObservingAction> a owl:Class ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Action> .

<http://purl.org/biotop/biotop.owl#OneDimensionalBoundary> a owl:Class ;
    rdfs:label "one dimensional boundary" ;
    ns1:definition "line bounding a two-dimensional biological entity" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OneDimensionalPhysicalEntity> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#TwoDimensionalBoundary> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#physicallyBounds> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TwoDimensionalPhysicalEntity> ] .

<http://purl.org/biotop/biotop.owl#OrganSystemPart> a owl:Class ;
    rdfs:label "organ system part" ;
    rdfs:seeAlso "FMAID:67509  Organ system subdivistion" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#BodySystem> .

<http://purl.org/biotop/biotop.owl#ParticularEntity> a owl:Class ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#PathologicalCondition> a owl:Class ;
    rdfs:label "pathological condition" ;
    ns1:definition "pathological structure, disposition, or process. This disjoint category helps properly represent diseases becauses it is often left open whether they are meant as pathological structure, disposition, or process.\\n\\nIn case this is to be left open, the relation has_locus should be used to connect them to anatomical entities" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Condition> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#PathologicalDisposition> <http://purl.org/biotop/biotop.owl#PathologicalProcess> <http://purl.org/biotop/biotop.owl#PathologicalStructure> ) ] .

<http://purl.org/biotop/biotop.owl#PeptideFunction> a owl:Class ;
    rdfs:label "peptide function" ;
    ns1:definition "Inherent Function of a protein or a part of it." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#MolecularFunction> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PeptideStructure> ] ) ] .

<http://purl.org/biotop/biotop.owl#Phosphate> a owl:Class ;
    rdfs:label "phosphate" ;
    ns1:definition "Phosphate is a salt of phosphoric acid or a functional group on organic compounds." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#InorganicMolecularEntity> .

<http://purl.org/biotop/biotop.owl#PlantPopulation> a owl:Class ;
    rdfs:label "plant population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Plant> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Plant> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#PluralityOfIdenticalPolymolecularEntities> a owl:Class ;
    rdfs:label "plurality of identical polymolecular entities" ;
    ns1:definition "collection of identical things of the same sort" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#CollectiveMaterialEntity> .

<http://purl.org/biotop/biotop.owl#Poisoning> a owl:Class ;
    rdfs:label "poisoning" ;
    rdfs:comment "negatively affecting the integrity of a biologival system caused by one or more chemical substances" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#AmountOfPureSubstance> <http://purl.org/biotop/biotop.owl#CompoundOfCollectiveMaterialEntities> ) ] ],
        <http://purl.org/biotop/biotop.owl#ActionOnBiologicalSystem> .

<http://purl.org/biotop/biotop.owl#PortionOfHomogenousMatter> a owl:Class ;
    rdfs:label "portion of homogenous matter" ;
    ns1:definition "Composition of granular components of the same kind." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#PreventionAction> a owl:Class ;
    rdfs:label "prevention action" ;
    ns1:definition "Hinders a  process or the realization of a  function. As the second argument represents sth non-existent, it cannot be expressed in FOL. Hence the special status of this class. (Cf. Condovardi et al. \"Preventing Existence, FOIS 2001)" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#MaterialObject> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Process> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasPatient> ] ) ],
        <http://purl.org/biotop/biotop.owl#Action> .

<http://purl.org/biotop/biotop.owl#PrimatePopulation> a owl:Class ;
    rdfs:label "primate population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Primate> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Primate> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#Producing> a owl:Class ;
    rdfs:label "producing" ;
    ns1:definition "action in which a new physical or informational entity comes into being" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Affecting> .

<http://purl.org/biotop/biotop.owl#ProteinComplex> a owl:Class ;
    rdfs:label "protein complex" ;
    ns1:definition "Mostly only proteins but composition with other molecules possible (e.g. Fe -> Hemoglobin) or also lipoproteins" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#MoleculeComplex> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EntireProteinMolecule> ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#EntireProteinMolecule> <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ) ] ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#ProteinDomain> a owl:Class ;
    rdfs:label "protein domain" ;
    ns1:definition "Structural domain is the smallest element of protein tertiary structure that is self-stabilizing and often folds independently of the rest of the amino acid chain. It may contain one or more structural motives (ProteinSubstructure). A protein domain typically has its own function, the overall function of the protein results from the composition of the functions of all of its structural domains." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EntireProteinMolecule> ],
        <http://purl.org/biotop/biotop.owl#PeptideStructure> .

<http://purl.org/biotop/biotop.owl#ProteinSubstructure> a owl:Class ;
    rdfs:label "protein substructure" ;
    ns1:definition "A secondary substructure of a protein (protein Motif)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EntireProteinMolecule> ],
        <http://purl.org/biotop/biotop.owl#PeptideStructure> .

<http://purl.org/biotop/biotop.owl#ProteinSubunit> a owl:Class ;
    rdfs:label "protein subunit" ;
    ns1:definition "A protein molecule that assembles with other protein molecules to form a protein complex. May have its own function. However, most proteinsubunits do not gain functionality until associated with the other subunits." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#EntireProteinMolecule> .

<http://purl.org/biotop/biotop.owl#ProtistPopulation> a owl:Class ;
    rdfs:label "protist population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Protist> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Protist> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#Radiation> a owl:Class ;
    rdfs:label "radiation" ;
    ns1:definition "process in which energy-rich particles or electromagnetic waves participate" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#PhysicalProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#AlphaParticle> <http://purl.org/biotop/biotop.owl#SubatomicParticle> <http://purl.org/biotop/biotop.owl#Wave> ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#RegulatoryBody> a owl:Class ;
    rdfs:label "regulatory body" ;
    ns1:definition "organization that has the function of issuing regulations or laws" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Organization> .

<http://purl.org/biotop/biotop.owl#SocialAction> a owl:Class ;
    rdfs:label "social action" ;
    ns1:definition "action that targets a population" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#HumanPopulation> <http://purl.org/biotop/biotop.owl#Organization> ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ],
        <http://purl.org/biotop/biotop.owl#Action> .

<http://purl.org/biotop/biotop.owl#SpatialRegion> a owl:Class ;
    rdfs:label "spatial region" ;
    ns1:definition "An independent continuant entity that is neither a bearer of qualities nor inheres in any other entity (snap:SpatialRegion)" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ImmaterialThreeDimensionalPhysicalEntity> .

<http://purl.org/biotop/biotop.owl#TemporalEntity> a owl:Class ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DEPRECATED> .

<http://purl.org/biotop/biotop.owl#Treating> a owl:Class ;
    rdfs:label "treating" ;
    ns1:definition "action with the intention to produce a positive effect on a biological organism or in which a malfunctioning is relieved or disrupted." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Affecting> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#TreatingCondition> <http://purl.org/biotop/biotop.owl#TreatingOrganism> ) ] .

<http://purl.org/biotop/biotop.owl#TwoDimensionalBiologicalEntity> a owl:Class ;
    rdfs:label "two dimensional biological entity" ;
    ns1:definition "surface or plane in a biological entity" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TwoDimensionalPhysicalEntity> [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://purl.org/biotop/biotop.owl#physicallyBounds> ;
                                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#BiologicalSpace> ] [ a owl:Restriction ;
                                    owl:onProperty <http://purl.org/biotop/biotop.owl#physicallyBounds> ;
                                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ] [ a owl:Restriction ;
                                    owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
                                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ] ) ] [ a owl:Class ;
                        owl:complementOf [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#BiologicalSpace> <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ) ] ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#BiologicalSpace> <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ) ] ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#physicallyBounds> ] ) ] .

<http://purl.org/biotop/biotop.owl#UnicellularOrganism> a owl:Class ;
    rdfs:label "unicellular organism" ;
    ns1:definition "Organisms that (always or in certain initial stages) consist of a single cell. We conceive organisms in a material sense. Therefore we do not assume any ontological difference between a monocellular organism and the cell it is made of." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Class ;
                        owl:complementOf <http://purl.org/biotop/biotop.owl#Syncytium> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CellMembrane> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CellularComponent> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Cytoplasm> ] ) ] .

<http://purl.org/biotop/biotop.owl#UsingAction> a owl:Class ;
    rdfs:label "using action" ;
    ns1:definition "action that relates a user with an object he/she uses" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Action> .

<http://purl.org/biotop/biotop.owl#VertebratePopulation> a owl:Class ;
    rdfs:label "vertebrate population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Vertebrate> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Vertebrate> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#VirusPopulation> a owl:Class ;
    rdfs:label "virus population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Virus> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Virus> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#YeastPopulation> a owl:Class ;
    rdfs:label "yeast population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#YeastCell> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#YeastCell> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#abstractPartOf> a owl:ObjectProperty ;
    rdfs:label "abstract part of" ;
    ns1:definition "abstractPartOf (inverse: hasAbstractPart) Relates parts and wholes of abstract entities. Abstract entities are neither processes, material objects, regions or spaces. Typical abstract entities are pieces of information. \\n\\nExample: a header is an abstract part of a jpg file." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#InformationObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#InformationObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#hasAbstractPart> .

<http://purl.org/biotop/biotop.owl#branchOf> a owl:ObjectProperty ;
    rdfs:label "branch of" ;
    ns1:definition "A is a branch of B if it is contiguous with B and if some flow of matter or energy of information flows form B to A.\\nSchulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\nArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#attachedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#hasBranch> .

<http://purl.org/biotop/biotop.owl#continuousWith> a owl:ObjectProperty ;
    rdfs:label "continuous with" ;
    ns1:definition "Contiguous with a clear bona fide boundary between the connected parts.\\nSchulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\nArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118 " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#contiguousWith> .

<http://purl.org/biotop/biotop.owl#cooccurringWith> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "cooccurring with" ;
    ns1:definition "The relation coocurring with relates two processes if their temporal extensions overlap." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#temporallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#denotedBy> a owl:ObjectProperty ;
    rdfs:label "denoted by" ;
    ns1:definition "denotedBy (inverse: denotes) relates entities with symbols, which are information entities. In contrast to encoding, the denoted entity is completely independent on the denoting one. \\n\\nExample: The inflamation of a sinus is denoted by the word \"Sinusitis\", as well as by the ICD code \"J10\"" ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> .

<http://purl.org/biotop/biotop.owl#denotes> a owl:ObjectProperty ;
    rdfs:label "denotes" ;
    ns1:definition "denotedBy (inverse: denotes) relates entities with symbols, which are information entities. In contrast to encoding, the denoted entity is completely independent on the denoting one. \\n\\nExample: The inflamation of a sinus is denoted by the word \"Sinusitis\", as well as by the ICD code \"J10\"" ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#InformationObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> .

<http://purl.org/biotop/biotop.owl#derivedInto> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "derived into" ;
    ns1:definition "DerivesFrom (inverse: derivedInto) holds between  distinct material objects  when one succeeds the other across a temporal divide in such a way that at least a biologically significant portion of the matter of the earlier object is included into the later. \\n\\nThere is some instant of time t such that the first object exists only prior to and the second one  only subsequent to t. \\n\\nThese relations are borrowed from the OBO Relation Ontology\\n\\nExample:\\n\"Three simple kinds of instance-level derivation can then be distinguished (Figure 3): first, the succession of one single continuant by another single continuant across a temporal threshold (for example, this blastocyst derives from this zygote); second, the fusion of two or more continuants into one continuant (for example, this zygote derives from this sperm and from this ovum); and third, the fission of an earlier single continuant to create a plurality of later continuants (for example, these promyelocytes derive from this myeoloblast). \" from http://genomebiology.com/2005/6/5/R46" ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasOrigin> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#derivesFrom> .

<http://purl.org/biotop/biotop.owl#encodedBy> a owl:ObjectProperty ;
    rdfs:label "encodedBy" ;
    ns1:definition "EncodedBy (inverse: encodes) relates entities with symbols, which are information entities. In contrast to denotation, encoding entails that the makeup of the encoded entity is determined by the code. There is a dependence of the former on the latter. Note that the association of human-made codes with entities (e.g. for coding and classification systems like ICD-10) is nothing more than denotation and is therefore not in the scope of the encodedBy (encodes) relation.\\n\\nExample: A material gene sequence is related to a sequence of nucleotide symbols (like ACCGATTGA) " ;
    rdfs:range <http://purl.org/biotop/biotop.owl#InformationObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#encodes> .

<http://purl.org/biotop/biotop.owl#featureOf> a owl:ObjectProperty ;
    rdfs:label "feature of" ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#DEPRECATED_RELATION> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#hasFeature> .

<http://purl.org/biotop/biotop.owl#granularPartOf> a owl:ObjectProperty ;
    rdfs:label "granular part of" ;
    ns1:definition "hasGranularPart (inverse: granularPartOf) relate  Pluralities with their constituents. The constituents are of the same sort. \\n\\nGenerally pluralities have a high number of grains. The loss of a grain has no effect on the sortality of the identity of the plurality.\\n\\nExample: A cow is a granular part of a herd of cows. A water molecule is a granular part of some amount of water" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#hasGranularPart> .

<http://purl.org/biotop/biotop.owl#hasOriginalPart> a owl:ObjectProperty ;
    rdfs:label "has original part" ;
    ns1:definition "hasOriginalPart (inverse: originalPartOf). \\n\\noriginal parts of A are no longer parts of A but were parts of A when they came into existence. \\n\\nExample:\\nApples harvested from an apple tree, tissue samples in a lab. " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasOrigin> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#originalPartOf> .

<http://purl.org/biotop/biotop.owl#hasOriginatingPhysicalPart> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has originating physical part" ;
    ns1:definition "originatingPhysicalPartOf (inverse: hasOriginatingPhysicalPart)\\n\\nAn originating physical part is a proper physical part that has never ceased to be part of the object it is related to. \\n\\nExample: my brain is an originating physical part of my body " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasOrigin>,
        <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#originatingPhysicalPartOf> .

<http://purl.org/biotop/biotop.owl#hasProcessualPart> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has processual part" ;
    ns1:definition "hasProcessualPart (inverse: processualPartOf) relates a process with a subprocess (process part).\\n\\nExample: G1 phase is a processual part of the process mitosis." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#temporallyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#processualPartOf> .

<http://purl.org/biotop/biotop.owl#isAbout> a owl:ObjectProperty ;
    rdfs:label "is about" ;
    ns1:definition "replaced by denotes" ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#DEPRECATED_RELATION> .

<http://purl.org/biotop/biotop.owl#outcomeOf> a owl:ObjectProperty ;
    rdfs:label "outcome of" ;
    ns1:definition "outcomeOf (inverse: hasOutcome) relates a participant to a process. This participant either\\n- a) comes into being during the process\\nor - b) undergoes some change during the process, so that it instantiates a different class at the end of the process \\nand it constitutes (one of) the main result(s) of the process\\n\\nExample: a Protein molecule is the outcome of a translation process." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#participatesIn> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#hasOutcome> .

<http://purl.org/biotop/biotop.owl#physicallyBoundedBy> a owl:ObjectProperty ;
    rdfs:label "physically bounded by" ;
    ns1:definition "physicallyBounds (inverse: physically boundedBy) relates a three-dimensional physical object with its two dimensional boundary. \\n\\nExample: the surface of my liver physically bounds my liver. " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range <http://purl.org/biotop/biotop.owl#PhysicalBoundary> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#physicallyBounds> .

<http://purl.org/biotop/biotop.owl#physicallyDisconnectedFrom> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "physically disconnected from" ;
    ns1:definition "No sharing of parts and no sharing of boundaries. \\n\\nSchulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\nArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#spatiallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#physicallyInterconnects> a owl:ObjectProperty ;
    rdfs:label "physically interconnects" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicallyConnectedTo> .

<http://purl.org/biotop/biotop.owl#physicallySurroundedBy> a owl:ObjectProperty ;
    rdfs:label "physically surrounded by" ;
    ns1:definition "Partly or completely covering from outside (establishing boundaries, enclosing, confining, enclosing, circumscribing)\\n" ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicallyConnectedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#physicallySurrounds> .

<http://purl.org/biotop/biotop.owl#physicallyTraverses> a owl:ObjectProperty ;
    rdfs:label "physically traverses" ;
    ns1:definition "crossing over and crossing through" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicallyConnectedTo> .

<http://purl.org/biotop/biotop.owl#precededBy> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "preceded by" ;
    ns1:definition "precedes (inverse: precededBy) relates two processes, one of which ends or totally happens before the second one begins. \\n\\nExample: fecundation preceeds embryonic development." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Time> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Time> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#temporallyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#precedes> .

<http://purl.org/biotop/biotop.owl#processRoleOf> a owl:ObjectProperty ;
    rdfs:label "process role of" ;
    ns1:definition "processRoleOf (abstract: hasProcessRole) links a role attributed to a process to this process. Process roles are asserted where the process cannot sufficiently be described by the roles of its participants only. \\n\\nExample: The process of injuring has the process role \"allowed\" in case of a surgical intervention agreed by both the patient and the doctor." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Role> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#hasProcessRole> .

<http://purl.org/biotop/biotop.owl#ramificationOf> a owl:ObjectProperty ;
    rdfs:label "ramification of" ;
    dc:source "Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\n\\t\\t\\tArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#DEPRECATED_RELATION> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#ramifies> .

<http://purl.org/biotop/biotop.owl#touches> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "touches" ;
    ns1:definition "Abutting without mechanical connection.\\nSchulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\nArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118 " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicallyAdjacentTo> .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:format a owl:AnnotationProperty .

dc:identifier a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:source a owl:AnnotationProperty .

dc:subject a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

ns1:definition a owl:AnnotationProperty .

ns1:synonym a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

rdfs:seeAlso a owl:AnnotationProperty .

owl:Thing a owl:Class .

owl:priorVersion a owl:AnnotationProperty .

owl:topDataProperty a owl:DatatypeProperty .

owl:versionInfo a owl:AnnotationProperty .

<http://purl.org/biotop/biotop.owl#AcquiredPathologicalCondition> a owl:Class ;
    rdfs:label "acquired pathological condition" ;
    ns1:definition "Ill-formed state of a biological entity,acquired after birth [steschu 20071010]" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PathologicalValueRegion> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#CongenitalPathologicalCondition> .

<http://purl.org/biotop/biotop.owl#AgeQuality> a owl:Class ;
    rdfs:label "age quality" ;
    ns1:definition "the quality of having a livespan" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ] ) ],
        <http://purl.org/biotop/biotop.owl#ObjectQuality> .

<http://purl.org/biotop/biotop.owl#AlphaParticle> a owl:Class ;
    rdfs:label "alpha particle" ;
    ns1:definition "Positively charged particles composed of two protons and two neutrons, i.e. equivalent to Helium nuclei " ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Electron> ] ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Neutron> ] ) ],
        <http://purl.org/biotop/biotop.owl#Atom> .

<http://purl.org/biotop/biotop.owl#AminoAcidSequence> a owl:Class ;
    rdfs:label "amino acid sequence" ;
    ns1:definition "Chain of amino acids, joined by peptide bonds. Folded or unfolded." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PeptideStructure> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#AminoAcidMoleculeOrResidue> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#AminoAcidMoleculeOrResidue> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#AmountOfPureSubstance> a owl:Class ;
    rdfs:label "amount of pure substance" ;
    ns1:definition "collection with molecules or atoms as granular parts of the same sort" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#Atom> <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ) ] ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PolyMolecularCompositeEntity> ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#Atom> <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ],
        <http://purl.org/biotop/biotop.owl#CollectiveMaterialEntity> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#PluralityOfOrganisms> .

<http://purl.org/biotop/biotop.owl#Amphibian> a owl:Class ;
    rdfs:label "amphibian" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Vertebrate> .

<http://purl.org/biotop/biotop.owl#AnimalCell> a owl:Class ;
    rdfs:label "animal cell" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#CellByTaxonPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#BacterialCell>,
        <http://purl.org/biotop/biotop.owl#PlantCell> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Cell> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#KingdomAnimaliaValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#AnimalPopulation> a owl:Class ;
    rdfs:label "animal population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#AnimalIncludingHuman> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#AnimalIncludingHuman> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#BiologicalAction> a owl:Class ;
    rdfs:label "biological action" ;
    ns1:definition "Action that has some biological entity as agent" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Action> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ] ) ] ] .

<http://purl.org/biotop/biotop.owl#BiologicalColony> a owl:Class ;
    rdfs:label "biological colony" ;
    ns1:definition "Plurality of several individual organisms living closely together, usually for mutual benefit" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PluralityOfOrganisms> .

<http://purl.org/biotop/biotop.owl#BiologicalFunction> a owl:Class ;
    rdfs:label "biological function" ;
    ns1:definition "a function that inheres in some structured biological entity." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Function> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ] ) ] .

<http://purl.org/biotop/biotop.owl#BiologicalSize> a owl:Class ;
    rdfs:label "biological size" ;
    ns1:definition "quality of being visible with or without microscope" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#BiologicalSizeValueRegion> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#BiologicalSizeValueRegion> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ],
        <http://purl.org/biotop/biotop.owl#ObjectQuality> .

<http://purl.org/biotop/biotop.owl#Bird> a owl:Class ;
    rdfs:label "bird" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Vertebrate> .

<http://purl.org/biotop/biotop.owl#CellByTypePartition> a owl:Class ;
    rdfs:label "*" ;
    ns1:definition "CellByTypePartition\\n\\nOntologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Cell> .

<http://purl.org/biotop/biotop.owl#CellNucleus> a owl:Class ;
    rdfs:label "cell nucleus" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#CellularComponent> .

<http://purl.org/biotop/biotop.owl#CentralNervousSystem> a owl:Class ;
    rdfs:label "central nervous system" ;
    ns1:definition "the central control unit of an organism. Constitutes the brain in higher organisms. " ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganSystem> .

<http://purl.org/biotop/biotop.owl#ChildRole> a owl:Class ;
    rdfs:label "child role" ;
    ns1:definition "the role an organism plays in relation to its parent" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FamilyRole> .

<http://purl.org/biotop/biotop.owl#ClassGammaProteobacteriaValueRegion> a owl:Class ;
    rdfs:label "class gamma proteobacteria value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PhylumProteobacteriaValueRegion> .

<http://purl.org/biotop/biotop.owl#ClassSaccharomycetesValueRegion> a owl:Class ;
    rdfs:label "class saccharomycetes value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#SubphylumSaccharomycotinaValueRegion> .

<http://purl.org/biotop/biotop.owl#Condition> a owl:Class ;
    rdfs:label "condition" ;
    ns1:definition "Union of material entity, process, or disposition. The rationale of this class is to represent the ambiguous nature of what is commonly referred to by health-related condition (not necessarily pathologic)" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Particular> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Disposition> <http://purl.org/biotop/biotop.owl#MaterialObject> <http://purl.org/biotop/biotop.owl#Process> ) ] .

<http://purl.org/biotop/biotop.owl#CongenitalAbnormalStructure> a owl:Class ;
    rdfs:label "congenital abnormal structure" ;
    ns1:definition "biological structure that deviates from what is considered normal and that already existed at birth" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PathologicalStructure> .

<http://purl.org/biotop/biotop.owl#DNAChain> a owl:Class ;
    rdfs:label "DNA chain" ;
    ns1:definition "A DNA is a complex, high-molecular-weight biochemical macromolecule composed of deoxyribonumcleotide chains that convey genetic information. Any kind of NucleicAcid that is composed of Deoxyribonucleotides is here defined as DNA." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ChainOfNucleotideMonomers> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#RNAChain> .

<http://purl.org/biotop/biotop.owl#EducatorRole> a owl:Class ;
    rdfs:label "educator role" ;
    ns1:definition "The role a person plays that is occupied by educational activities" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OccupationalRole> .

<http://purl.org/biotop/biotop.owl#Eicosanoid> a owl:Class ;
    rdfs:label "eicosanoid" ;
    ns1:definition "An oxygenated metabolite from polyunsaturated 20 carbon fatty acids including lipoxygenase and cyclooxygenase products and their synthetic analogs. This includes the prostaglandins and thromboxanes. (UMLS SN)" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#LipidMoleculeOrResidue> .

<http://purl.org/biotop/biotop.owl#EntireNucleicAcidMolecule> a owl:Class ;
    rdfs:label "entire nucleic acid molecule" ;
    rdfs:comment "not (properPartOf some MonoMolecularEntity)  REMOVED" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#NucleicAcidStructure> [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Monomer> ] .

<http://purl.org/biotop/biotop.owl#EpithelialCell> a owl:Class ;
    rdfs:label "epithelial cell" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#CellByTypePartition> .

<http://purl.org/biotop/biotop.owl#FamilyDrosophilidaeValueRegion> a owl:Class ;
    rdfs:label "family drosophilidae value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrderDipteraValueRegion> .

<http://purl.org/biotop/biotop.owl#FamilyEnterobacteriaceaeaValueRegion> a owl:Class ;
    rdfs:label "family enterobacteriaceaea value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrderEnterobacterialesValueRegion> .

<http://purl.org/biotop/biotop.owl#Fish> a owl:Class ;
    rdfs:label "fish" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Vertebrate> .

<http://purl.org/biotop/biotop.owl#GaseousValueRegion> a owl:Class ;
    rdfs:label "gaseous value region" ;
    rdfs:comment "\"gaseous\" as the value of a states of matter.  E.g. a portion of air has a quality which has its value located in \"gaseous value region\"" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#StateOfMatterValueRegion> .

<http://purl.org/biotop/biotop.owl#Gene> a owl:Class ;
    rdfs:label "gene" ;
    ns1:definition "region of nucleic acid macromolecule that carry information" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#GeneticInformation> ],
        <http://purl.org/biotop/biotop.owl#NucleicAcidStructure> ;
    owl:versionInfo "TODO: Discuss whether all genes are DNA !" .

<http://purl.org/biotop/biotop.owl#GenusCandidaValueRegion> a owl:Class ;
    rdfs:label "genus candida value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FamilySaccharomycetaceaeValueRegion> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#GenusSaccharomycesValueRegion> .

<http://purl.org/biotop/biotop.owl#GenusDrosophilaValueRegion> a owl:Class ;
    rdfs:label "genus drosophila value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#SubfamilyDrosophilinaeValueRegion> .

<http://purl.org/biotop/biotop.owl#GenusEscherichiaValueRegion> a owl:Class ;
    rdfs:label "genus escherichia value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FamilyEnterobacteriaceaeaValueRegion> .

<http://purl.org/biotop/biotop.owl#GenusHomoValueRegion> a owl:Class ;
    rdfs:label "genus homo value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FamilyHominidaeValueRegion> .

<http://purl.org/biotop/biotop.owl#GrowingProcess> a owl:Class ;
    rdfs:label "growing process" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TissueProcess> .

<http://purl.org/biotop/biotop.owl#HormoneRole> a owl:Class ;
    rdfs:label "hormone role" ;
    ns1:definition "The role a biologically active substance plays when it participates in the transmission of messages across a certain distance in an organism." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#SignallingRole> .

<http://purl.org/biotop/biotop.owl#HumanPopulation> a owl:Class ;
    rdfs:label "human population" ;
    rdfs:comment "EXAMPLE OF POPULATION" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Population> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Human> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Human> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#ImmaterialProcessualEntity> a owl:Class ;
    rdfs:label "immaterial processual entity" ;
    ns1:definition "A process with non-material participants, e.g. legal or organizational entities or information objects" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Process> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#InformationObject> ] ) ] .

<http://purl.org/biotop/biotop.owl#ImmunologicRole> a owl:Class ;
    rdfs:label "immunologic role" ;
    ns1:definition "A role that is played by any biological entity in virtue of the defense of an organism against infective agents" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#BiologicalSystemRole> .

<http://purl.org/biotop/biotop.owl#IndicatorRole> a owl:Class ;
    rdfs:label "indicator role" ;
    ns1:definition "A role a chemical plays for measuring or analyzing other chemical processes" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ChemicalRole> .

<http://purl.org/biotop/biotop.owl#Invertebrate> a owl:Class ;
    rdfs:label "invertebrate" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#AnimalIncludingHuman> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#Vertebrate> .

<http://purl.org/biotop/biotop.owl#KingdomChromistaValueRegion> a owl:Class ;
    rdfs:label "kingdom chromista value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TaxonValueRegion> .

<http://purl.org/biotop/biotop.owl#KingdomProtozoaValueRegion> a owl:Class ;
    rdfs:label "kingdom protozoa value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TaxonValueRegion> .

<http://purl.org/biotop/biotop.owl#KingdomVirusesValueRegion> a owl:Class ;
    rdfs:label "kingdom viruses value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TaxonValueRegion> .

<http://purl.org/biotop/biotop.owl#Language> a owl:Class ;
    rdfs:label "language" ;
    ns1:definition "system of signs used for communication between biological and / or machine agents" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#InformationObject> .

<http://purl.org/biotop/biotop.owl#LivingBody> a owl:Class ;
    rdfs:label "living body" ;
    ns1:definition "Entirety of the biological structure that constitutes a living organism" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] ) ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#participatesIn> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#BiologicalLife> ],
        <http://purl.org/biotop/biotop.owl#Body> .

<http://purl.org/biotop/biotop.owl#MeasuringAction> a owl:Class ;
    rdfs:label "measuring action" ;
    ns1:definition "an action that aims at producing a measurement" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Action> .

<http://purl.org/biotop/biotop.owl#MolecularFunction> a owl:Class ;
    rdfs:label "molecular function" ;
    ns1:definition "Inherent function of a single molecule." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Function> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ] ) ] .

<http://purl.org/biotop/biotop.owl#NeuroreactiveRole> a owl:Class ;
    rdfs:label "neuroreactive role" ;
    ns1:definition "A role a molecule plays if it acts as a neurotransmitter" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#SignallingRole> .

<http://purl.org/biotop/biotop.owl#NonSteroidLipid> a owl:Class ;
    rdfs:label "non steroid lipid" ;
    ns1:definition "Lipids that have aliphatic chains and no steroid rings" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#LipidMoleculeOrResidue> .

<http://purl.org/biotop/biotop.owl#NoncanonicalProcessualEntity> a owl:Class ;
    rdfs:label "noncanonical processual entity" ;
    ns1:definition "a process that is considered abnormal" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Process> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#NoncanonicalValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#NucleosideMolecule> a owl:Class ;
    rdfs:label "nucleoside molecule" ;
    ns1:definition "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SubmolecularGroup> ],
        <http://purl.org/biotop/biotop.owl#NucleicAcidNucleotideOrNucleosideMoleculeOrResidue> .

<http://purl.org/biotop/biotop.owl#OrderDipteraValueRegion> a owl:Class ;
    rdfs:label "order diptera value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ClassInsectaValueRegion> .

<http://purl.org/biotop/biotop.owl#OrderEnterobacterialesValueRegion> a owl:Class ;
    rdfs:label "order enterobacteriales value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ClassGammaProteobacteriaValueRegion> .

<http://purl.org/biotop/biotop.owl#OrderSaccharomycetalesValueRegion> a owl:Class ;
    rdfs:label "order saccharomycetales value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ClassSaccharomycetesValueRegion> .

<http://purl.org/biotop/biotop.owl#OrganPart> a owl:Class ;
    rdfs:label "organ part" ;
    rdfs:seeAlso "FMAID:82472 Cardinal organ part" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganismPart> .

<http://purl.org/biotop/biotop.owl#OrganSystem> a owl:Class ;
    rdfs:label "organ system" ;
    rdfs:seeAlso "FMAID:7149 Organ system" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#BodySystem> .

<http://purl.org/biotop/biotop.owl#OrganismAction> a owl:Class ;
    rdfs:label "organism action" ;
    ns1:definition "Action that has some organism as agent" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#BiologicalAction> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] ) ] ] .

<http://purl.org/biotop/biotop.owl#ParentRole> a owl:Class ;
    rdfs:label "parent role" ;
    ns1:definition "the role an organism plays in relation to its children" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FamilyRole> .

<http://purl.org/biotop/biotop.owl#PathologicalDisposition> a owl:Class ;
    rdfs:label "pathological disposition" ;
    ns1:definition "any kind of disposition considered non-canonical. The criteria of canonicity are not further specified. \\nThe classification of certain dispositions as dysfunctional or pathological is dependent on a historic and cultural context. Dysfunction or disease therefore hasn't the status of a universal." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Disposition> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Disposition> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                                    owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#NoncanonicalValueRegion> ] ) ] ] ] ) ] ;
    owl:priorVersion "prior label \"dysfunction\"" .

<http://purl.org/biotop/biotop.owl#PathologicalProcess> a owl:Class ;
    rdfs:label "pathological process" ;
    ns1:definition "a biological process which is non-canonic" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#BiologicalProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#NoncanonicalValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#PhylumAscomycotaValueRegion> a owl:Class ;
    rdfs:label "phylum ascomycota value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#KingdomFungiValueRegion> .

<http://purl.org/biotop/biotop.owl#PhylumProteobacteriaValueRegion> a owl:Class ;
    rdfs:label "phylum proteobacteria value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#KingdomBacteriaValueRegion> .

<http://purl.org/biotop/biotop.owl#PhysicalLength> a owl:Class ;
    rdfs:label "physical length" ;
    ns1:definition "physical length (e.g. in meters)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ],
        <http://purl.org/biotop/biotop.owl#ObjectQuality> .

<http://purl.org/biotop/biotop.owl#PhysicalState> a owl:Class ;
    rdfs:label "physical state" ;
    ns1:definition "Quality of being solid, liquid, gaseous, ...  [steschu20080127]" ;
    rdfs:comment "former name: StateOfAggregation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MaterialObject> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#MaterialObject> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ],
        <http://purl.org/biotop/biotop.owl#ObjectQuality> .

<http://purl.org/biotop/biotop.owl#PhysicianRole> a owl:Class ;
    rdfs:label "physician role" ;
    ns1:definition "The role a physician plays" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HealthProfessionalRole> .

<http://purl.org/biotop/biotop.owl#PortionOfHeterogenousLiquid> a owl:Class ;
    rdfs:label "portion of heterogenous liquid" ;
    ns1:definition "Liquid constituted by different kinds of collectives, e.g. aqueous NaCl solution" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#CompoundOfCollectiveMaterialEntities> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#CompoundOfCollectiveMaterialEntities> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LiquidValueRegion> ] ] ) ] .

<http://purl.org/biotop/biotop.owl#PortionOfHeterogenousSolid> a owl:Class ;
    rdfs:label "portion of heterogenous solid" ;
    ns1:definition "Solid constituted by different kinds of collectives, e.g. a NaCl crystal, granite" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#CompoundOfCollectiveMaterialEntities> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LiquidValueRegion> ] ] ) ] .

<http://purl.org/biotop/biotop.owl#ReagentRole> a owl:Class ;
    rdfs:label "reagent role" ;
    ns1:definition "A role a chemical plays as participant in a chemical reation" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ChemicalRole> .

<http://purl.org/biotop/biotop.owl#ReceptorRole> a owl:Class ;
    rdfs:label "receptor role" ;
    ns1:definition "The role a (membrane) protein or protein complex plays in acting as a receptor." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#SignallingRole> .

<http://purl.org/biotop/biotop.owl#RegulationOrLaw> a owl:Class ;
    rdfs:label "regulation or law" ;
    ns1:definition "set of rules governing a particular kind of activity (WordNet)" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#IntellectualProduct> .

<http://purl.org/biotop/biotop.owl#Reptile> a owl:Class ;
    rdfs:label "reptile" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Vertebrate> .

<http://purl.org/biotop/biotop.owl#ResearcherRole> a owl:Class ;
    rdfs:label "researcher role" ;
    ns1:definition "the role a human plays if he / she is involved in research activities" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OccupationalRole> .

<http://purl.org/biotop/biotop.owl#RickettsiaCell> a owl:Class ;
    rdfs:label "rickettsia cell" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Prokaryote> .

<http://purl.org/biotop/biotop.owl#SiblingRole> a owl:Class ;
    rdfs:label "sibling role" ;
    ns1:definition "the role an organism plays in relation to another organism that has the same parents" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FamilyRole> .

<http://purl.org/biotop/biotop.owl#SignOrSymptomRole> a owl:Class ;
    rdfs:label "sign or symptom role" ;
    ns1:definition "A role that can inhere in states, processes, or even in certain independent continuants (e.g. in a deformity). This a role is ascribed to an entity in a diagnostic process where the symptom is suspected to indicate a second state or process)" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FindingRole> .

<http://purl.org/biotop/biotop.owl#SocialBehavior> a owl:Class ;
    rdfs:label "social behavior" ;
    ns1:definition "Behaviour of a group of organisms" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Behavior> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Population> ] ) ] .

<http://purl.org/biotop/biotop.owl#SolidValueRegion> a owl:Class ;
    rdfs:label "solid value region" ;
    rdfs:comment "\"solid\" as the value of a states of matter. E.g. a stone has a quality which has its value located in \"solid value region\"" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#StateOfMatterValueRegion> .

<http://purl.org/biotop/biotop.owl#SpatialReferenceRole> a owl:Class ;
    rdfs:label "spatial reference role" ;
    ns1:definition "The role attributed to a - mainly fiat - part of an object that is the site of some process or the location of some object of interest." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Role> .

<http://purl.org/biotop/biotop.owl#SpeciesCandidaAlbicansValueRegion> a owl:Class ;
    rdfs:label "species candida albicans value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#GenusCandidaValueRegion> .

<http://purl.org/biotop/biotop.owl#SpeciesDrosophilaMelanogasterValueRegion> a owl:Class ;
    rdfs:label "species drosophila melanogaster value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#GenusDrosophilaValueRegion> .

<http://purl.org/biotop/biotop.owl#SpeciesEscherichiaColiValueRegion> a owl:Class ;
    rdfs:label "species escherichia coli value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#GenusEscherichiaValueRegion> .

<http://purl.org/biotop/biotop.owl#SpeciesSaccharomycesCerevisiaeValueRegion> a owl:Class ;
    rdfs:label "species saccharomyces cerevisiae value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#GenusSaccharomycesValueRegion> .

<http://purl.org/biotop/biotop.owl#Steroid> a owl:Class ;
    rdfs:label "steroid" ;
    ns1:definition "One of a group of polycyclic, 17-carbon-atom, fused-ring compounds occurring both in natural and synthetic forms. Included here are naturally occurring and synthetic steroids, bufanolides, cardanolides, homosteroids, norsteroids, and secosteroids. (UMLS SN)" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#LipidMoleculeOrResidue> .

<http://purl.org/biotop/biotop.owl#StructuredNonbiologicalCompound> a owl:Class ;
    rdfs:label "structured nonbiological compound" ;
    ns1:definition "All those things that are not identified by belonging to any biological species\\nBorderline cases are artifacts that use biological substance (a table, a cloth, a house, a meal ...) A criterion to draw the boundary is whether or not the species affiliation has some structural or functional implication." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:complementOf <http://purl.org/biotop/biotop.owl#TaxonQuality> ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ],
        <http://purl.org/biotop/biotop.owl#PolyMolecularCompositeEntity> .

<http://purl.org/biotop/biotop.owl#SubfamilyDrosophilinaeValueRegion> a owl:Class ;
    rdfs:label "subfamily drosophilinae value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FamilyDrosophilidaeValueRegion> .

<http://purl.org/biotop/biotop.owl#SubjectOfCareRole> a owl:Class ;
    rdfs:label "subject of care role" ;
    ns1:definition "the role an animal or human plays as receiver of health care" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HealthRelatedRole> .

<http://purl.org/biotop/biotop.owl#SubphylumSaccharomycotinaValueRegion> a owl:Class ;
    rdfs:label "subphylum saccharomycotina value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PhylumAscomycotaValueRegion> .

<http://purl.org/biotop/biotop.owl#TissueProcess> a owl:Class ;
    rdfs:label "tissue process" ;
    ns1:definition "process occurring in a tissue" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#BiologicalProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Tissue> ] ) ] .

<http://purl.org/biotop/biotop.owl#TreatingCondition> a owl:Class ;
    rdfs:label "treating condition" ;
    ns1:definition "action with the intention to relieve or disrupt a malfunctioning of a biological entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TherapeuticRole> ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#participatesIn> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#NoncanonicalStaticProcessualEntity> ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasPatient> ],
        <http://purl.org/biotop/biotop.owl#Affecting> .

<http://purl.org/biotop/biotop.owl#TreatingOrganism> a owl:Class ;
    rdfs:label "treating organism" ;
    ns1:definition "action with the intention to produce a positive effect on a biological organism" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasPatient> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#OccupationalRole> ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ],
        <http://purl.org/biotop/biotop.owl#Affecting> .

<http://purl.org/biotop/biotop.owl#TwoDimensionalBoundary> a owl:Class ;
    rdfs:label "two dimensional boundary" ;
    ns1:definition "plane bounding a three-dimensional biological entity" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TwoDimensionalPhysicalEntity> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#physicallyBounds> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialThreeDimensionalPhysicalEntity> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ] .

<http://purl.org/biotop/biotop.owl#VitaminRole> a owl:Class ;
    rdfs:label "vitamin role" ;
    ns1:definition "The role a certain substance can play in an organism. Vitamins are organic compounds that are essential to an organism for metabolic reactions. They are not food. Vitamin does not include essential fatty acids or essential amino acids" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#BiologicalSystemRole> .

<http://purl.org/biotop/biotop.owl#Wave> a owl:Class ;
    rdfs:label "wave" ;
    ns1:definition "(wikipedia) disturbance that propagates through space and time, usually with transference of energy" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ImmaterialObject> .

<http://purl.org/biotop/biotop.owl#agentIn> a owl:ObjectProperty ;
    rdfs:label "agent in" ;
    ns1:definition "agentIn (inverse: hasAgent) relates a participant with a process, with the condition that this participant is causally active in the relevant process.\\nThis is the reason why agentIn is subsumed by the relation causedBy. \\n\\nExample: A physician is the agent in a opeeration process; a solvent is the agent in a solving process. " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#causes>,
        <http://purl.org/biotop/biotop.owl#participatesIn> .

<http://purl.org/biotop/biotop.owl#encodes> a owl:ObjectProperty ;
    rdfs:label "encodes" ;
    ns1:definition "EncodedBy (inverse: encodes) relates entities with symbols, which are information entities. In contrast to denotation, encoding entails that the makeup of the encoded entity is determined by the code. There is a dependence of the former on the latter. Note that the association of human-made codes with entities (e.g. for coding and classification systems like ICD-10) is nothing more than denotation and is therefore not in the scope of the encodedBy (encodes) relation.\\n\\nExample: A material gene sequence is related to a sequence of nucleotide symbols (like ACCGATTGA) " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#InformationObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> .

<http://purl.org/biotop/biotop.owl#hasAbstractPart> a owl:ObjectProperty ;
    rdfs:label "has abstract part" ;
    ns1:definition "abstractPartOf (inverse: hasAbstractPart) Relates parts and wholes of abstract entities. Abstract entities are neither processes, material objects, regions or spaces. Typical abstract entities are pieces of information. \\n\\nFor instance, a header is an abstract part of a jpg file." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#InformationObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#InformationObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> .

<http://purl.org/biotop/biotop.owl#hasBranch> a owl:ObjectProperty ;
    rdfs:label "has branch" ;
    ns1:definition "B hasBranch A if it is contiguous with B and if some flow of matter or energy of information flows form B to A.\\nSchulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\nArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#attachedTo> .

<http://purl.org/biotop/biotop.owl#hasFeature> a owl:ObjectProperty ;
    rdfs:label "has feature" ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#DEPRECATED_RELATION> .

<http://purl.org/biotop/biotop.owl#hasProcessRole> a owl:ObjectProperty ;
    rdfs:label "has process role" ;
    ns1:definition "processRoleOf (abstract: hasProcessRole) links a role attributed to a process to this process. Process roles are asserted where the process cannot sufficiently be described by the roles of its participants only. \\n\\nExample: The process of injuring has the process role \"allowed\" in case of a surgical intervention agreed by both the patient and the doctor." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Role> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> .

<http://purl.org/biotop/biotop.owl#originalPartOf> a owl:ObjectProperty ;
    rdfs:label "original part of" ;
    ns1:definition "hasOriginalPart (inverse: originalPartOf). \\n\\noriginal parts of A are no longer parts of A but were parts of A when they came into existence. \\n\\nExample:\\nApples harvested from an apple tree, tissue samples in a lab. " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#originatesFrom> .

<http://purl.org/biotop/biotop.owl#originatingPhysicalPartOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "originating physical part of" ;
    ns1:definition "originatingPhysicalPartOf (inverse: hasOriginatingPhysicalPart)\\n\\nAn originating physical part is a proper physical part that has never ceased to be part of the object it is related to. \\n\\nExample: my brain is an originating physical part of my body " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#originatesFrom>,
        <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> .

<http://purl.org/biotop/biotop.owl#physicalPartOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "physical part of" ;
    ns1:definition "hasPhysicalPart (inverse: physicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. \\nThis relation is reflexive, i.e. every physical object has itself as a physical part.\\n\\nNote that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"\\n\\nFor processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicallyLocatedIn> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#hasPhysicalPart> .

<http://purl.org/biotop/biotop.owl#physicallyContainedIn> a owl:ObjectProperty ;
    rdfs:label "physically contained in" ;
    ns1:definition "Containment is location without parthood. E.g. Food is contained in the stomach. \\n\\nSchulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\nArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicallyLocatedIn> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#physicallyContains> .

<http://purl.org/biotop/biotop.owl#physicallyContains> a owl:ObjectProperty ;
    rdfs:label "physically contains" ;
    ns1:definition "Containment is location without parthood. E.g. Food is contained in the stomach. \\n\\nSchulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\nArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118  " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicalLocationOf> .

<http://purl.org/biotop/biotop.owl#physicallySurrounds> a owl:ObjectProperty ;
    rdfs:label "physically surrounds" ;
    ns1:definition "Partly or completely covering from outside (establishing boundaries, enclosing, confining, enclosing, circumscribing)\\n" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicallyConnectedTo> .

<http://purl.org/biotop/biotop.owl#precedes> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes" ;
    ns1:definition "precedes (inverse: precededBy) relates two processes, one of which ends or totally happens before the second one begins. \\n\\nExample: fecundation preceeds embryonic development." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Time> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Time> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#temporallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#processualPartOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "processual part of" ;
    ns1:definition "hasProcessualPart (inverse: processualPartOf) relates a process with a subprocess (process part).\\n\\nExample: G1 phase is a processual part of the process mitosis." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#temporallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#ramifies> a owl:ObjectProperty ;
    rdfs:label "ramifies" ;
    dc:source "Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\n\\t\\t\\tArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#DEPRECATED_RELATION> .

<http://purl.org/biotop/biotop.owl#realizationOf> a owl:ObjectProperty ;
    rdfs:label "realization of" ;
    ns1:definition "Realization occurs if a disposition or function manifests itself as a process. \\n\\nExample: the disposition of a bird to fly (which exists even when it does not fly) is realized by its process of flying.  " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Disposition> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Role> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#causedBy> .

<http://purl.org/biotop/biotop.owl#ActionOnBiologicalSystem> a owl:Class ;
    rdfs:label "action on biological system" ;
    ns1:definition "an action which externally acts upon a biological system" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasPatient> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Action> .

<http://purl.org/biotop/biotop.owl#AdultOrganism> a owl:Class ;
    rdfs:label "adult organism" ;
    ns1:definition "organism in reproductive phase" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganismByDevelopmentalStagePartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#EmbryonicOrganism>,
        <http://purl.org/biotop/biotop.owl#JuvenileOrganism> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#DevelopmentalQuality> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#AdultValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#AdultValueRegion> a owl:Class ;
    rdfs:label "adult value region" ;
    rdfs:comment "\"adult\" as the value of a developmental stage. E.g. a 4 year old dog has a quality which has its value located in \"adult value region\"." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DevelopmentalValueRegion> .

<http://purl.org/biotop/biotop.owl#Alga> a owl:Class ;
    rdfs:label "alga" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Eukaryote> .

<http://purl.org/biotop/biotop.owl#AnimalLanguage> a owl:Class ;
    rdfs:label "animal language" ;
    ns1:definition "language used in communication between animals" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#LanguagePartition> .

<http://purl.org/biotop/biotop.owl#ArtefactRole> a owl:Class ;
    rdfs:label "artefact role" ;
    ns1:definition "The role an entity plays when it has been artificially produced. [steschu 20071010]" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Role> .

<http://purl.org/biotop/biotop.owl#BakersYeastCell> a owl:Class ;
    rdfs:label "bakers yeast cell" ;
    rdfs:comment "one saccharomyces cerevisiae cell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SpeciesSaccharomycesCerevisiaeValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#YeastCell> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#CandidaAlbicansCell> .

<http://purl.org/biotop/biotop.owl#Behavior> a owl:Class ;
    rdfs:label "behavior" ;
    ns1:definition "An (often habitual) action of an organism that is the realization of some disposition" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Action> .

<http://purl.org/biotop/biotop.owl#BiologicalLife> a owl:Class ;
    rdfs:label "biological life" ;
    ns1:definition "The whole process from origin to death of an organism" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganismProcess> .

<http://purl.org/biotop/biotop.owl#Body> a owl:Class ;
    rdfs:label "body" ;
    ns1:definition "Entire biological structure that constitutes a (living) organism. A body can be living or dead. Whether a living organism coincides with its body or hasPart its body, is controversial. We use \"hasPhysicalPart\" for relating organism to body. Being reflexive, this would not be incompatible with a view in which a living organism is a body." ;
    rdfs:seeAlso "FMAID:256135 Body" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> .

<http://purl.org/biotop/biotop.owl#CarbohydrateMonomer> a owl:Class ;
    rdfs:label "carbohydrate monomer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SubmolecularGroup> ],
        <http://purl.org/biotop/biotop.owl#CarbohydrateMoleculeOrResidue>,
        <http://purl.org/biotop/biotop.owl#Monomer> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#ChainOfCarbohydrateMonomers> .

<http://purl.org/biotop/biotop.owl#CatalyticRole> a owl:Class ;
    rdfs:label "catalytic role" ;
    ns1:definition "The role a substance plays in accelerating a chemical reaction" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ChemicalRole> .

<http://purl.org/biotop/biotop.owl#CellByLocusPartition> a owl:Class ;
    rdfs:label "*" ;
    ns1:definition "\\nCellByLocusPartition\\n\\nOntologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#CellInVivo> <http://purl.org/biotop/biotop.owl#ModifiedCell> ) ],
        <http://purl.org/biotop/biotop.owl#Cell> .

<http://purl.org/biotop/biotop.owl#CellInVivo> a owl:Class ;
    rdfs:label "cell in vivo" ;
    ns1:definition "Living cell that is not removed from a living system" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] ) ],
        <http://purl.org/biotop/biotop.owl#CellByLocusPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#ModifiedCell> .

<http://purl.org/biotop/biotop.owl#ChainOfCarbohydrateMonomers> a owl:Class ;
    rdfs:label "chain of carbohydrate monomers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CarbohydrateMonomer> ],
        <http://purl.org/biotop/biotop.owl#CarbohydrateMoleculeOrResidue> .

<http://purl.org/biotop/biotop.owl#ClassInsectaValueRegion> a owl:Class ;
    rdfs:label "class insecta value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PhylumArthropodaValueRegion> .

<http://purl.org/biotop/biotop.owl#ClassMammaliaValueRegion> a owl:Class ;
    rdfs:label "class mammalia value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#SubphylumVertebrataValueRegion> .

<http://purl.org/biotop/biotop.owl#CongenitalPathologicalCondition> a owl:Class ;
    rdfs:label "congenital pathological condition" ;
    ns1:definition "Ill-formed state of a biological entity, present from birth [steschu 20071010]" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PathologicalValueRegion> .

<http://purl.org/biotop/biotop.owl#DrugRole> a owl:Class ;
    rdfs:label "drug role" ;
    ns1:definition "The role of a chemical of biological entity of being deliberately used in virtue of its expected positive impact on a dysfunctional biological system" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TherapeuticRole> .

<http://purl.org/biotop/biotop.owl#EscherichiaColiCell> a owl:Class ;
    rdfs:label "escherichia coli cell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SpeciesEscherichiaColiValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#BacterialCell> .

<http://purl.org/biotop/biotop.owl#FamilyHominidaeValueRegion> a owl:Class ;
    rdfs:label "family hominidae value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrderPrimatesValueRegion> .

<http://purl.org/biotop/biotop.owl#FamilySaccharomycetaceaeValueRegion> a owl:Class ;
    rdfs:label "family saccharomycetaceae value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrderSaccharomycetalesValueRegion> .

<http://purl.org/biotop/biotop.owl#FattyAcidMoleculeOrResidue> a owl:Class ;
    rdfs:label "fatty acid molecule or residue" ;
    ns1:definition "Carboxylic acid often with a long unbranched aliphatic tail." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SubmolecularGroup> ],
        <http://purl.org/biotop/biotop.owl#OrganicMolecularEntityPartition> .

<http://purl.org/biotop/biotop.owl#FoodRole> a owl:Class ;
    rdfs:label "food role" ;
    ns1:definition "The role of an entity components of which are used for supplying energy and vital substrates to a biological system" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HealthRelatedRole> .

<http://purl.org/biotop/biotop.owl#FruitFly> a owl:Class ;
    rdfs:label "fruit fly" ;
    rdfs:comment "one drosophila melanogaster" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SpeciesDrosophilaMelanogasterValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Insect> .

<http://purl.org/biotop/biotop.owl#GeneticInformation> a owl:Class ;
    rdfs:label "genetic information" ;
    ns1:definition "information that can be interpreted by a genetic code" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#InformationObject> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#ChainOfNucleotideMonomers> <http://purl.org/biotop/biotop.owl#Gene> <http://purl.org/biotop/biotop.owl#Genome> ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#Genome> a owl:Class ;
    rdfs:label "genome" ;
    rdfs:comment "sum of genetic material in a cell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#GeneticInformation> ],
        <http://purl.org/biotop/biotop.owl#CellularComponent> .

<http://purl.org/biotop/biotop.owl#GenusSaccharomycesValueRegion> a owl:Class ;
    rdfs:label "genus saccharomyces value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#FamilySaccharomycetaceaeValueRegion> .

<http://purl.org/biotop/biotop.owl#GroupInteraction> a owl:Class ;
    rdfs:label "group interaction" ;
    ns1:definition "action in which physical or legal groups interact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#LegalEntity> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ],
        <http://purl.org/biotop/biotop.owl#Interacting> .

<http://purl.org/biotop/biotop.owl#HeterocyclicBaseMoleculeOrResidue> a owl:Class ;
    rdfs:label "heterocyclic base molecule or residue" ;
    ns1:definition "Organic compounds that contain a ring structure containing N as proton receptor. Important parts of DNA and RNA molecules." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SubmolecularGroup> ],
        <http://purl.org/biotop/biotop.owl#OrganicMolecularEntityPartition> .

<http://purl.org/biotop/biotop.owl#HumanLanguage> a owl:Class ;
    rdfs:label "human language" ;
    ns1:definition "language used in communication between non-human animals" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#LanguagePartition> .

<http://purl.org/biotop/biotop.owl#JuvenileValueRegion> a owl:Class ;
    rdfs:label "juvenile value region" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DevelopmentalValueRegion> .

<http://purl.org/biotop/biotop.owl#KingdomArchaeaValueRegion> a owl:Class ;
    rdfs:label "kingdom archaea value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TaxonValueRegion> .

<http://purl.org/biotop/biotop.owl#MachineLanguage> a owl:Class ;
    rdfs:label "machine language" ;
    ns1:definition "language used for processing by machines" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#LanguagePartition> .

<http://purl.org/biotop/biotop.owl#ModifiedCell> a owl:Class ;
    rdfs:label "modified cell" ;
    ns1:definition "Cells that grow and replicate continuously outside the living organism." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#derivesFrom> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CellInVivo> ],
        <http://purl.org/biotop/biotop.owl#CellByLocusPartition> .

<http://purl.org/biotop/biotop.owl#MolecularEntityByEntiretyPartition> a owl:Class ;
    rdfs:label "*" ;
    ns1:definition "MolecularEntityByEntiretyPartition\\n\\nOntologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#EntireMolecularEntity> <http://purl.org/biotop/biotop.owl#MolecularResidue> ) ] ) ] .

<http://purl.org/biotop/biotop.owl#MolecularEntityByOrganicInorganicPartition> a owl:Class ;
    rdfs:label "*" ;
    ns1:definition "MolecularEntityByOrganicInorganicPartition\\n\\nOntologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#InorganicMolecularEntity> <http://purl.org/biotop/biotop.owl#OrganicMolecularEntity> ) ] .

<http://purl.org/biotop/biotop.owl#MolecularResidue> a owl:Class ;
    rdfs:label "molecular residue" ;
    ns1:definition "not self-standing aggregation of atoms which are part of a bigger molecule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#componentPartOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ],
        <http://purl.org/biotop/biotop.owl#MolecularEntityByEntiretyPartition> .

<http://purl.org/biotop/biotop.owl#MulticellularOrganism> a owl:Class ;
    rdfs:label "multicellular organism" ;
    ns1:definition "Organisms that are composed by more than one cell." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#DevelopmentalQuality> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Cell> ] ) ] .

<http://purl.org/biotop/biotop.owl#OneDimensionalPhysicalEntity> a owl:Class ;
    rdfs:label "one dimensional physical entity" ;
    ns1:definition "line or curve" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ImmaterialObject> .

<http://purl.org/biotop/biotop.owl#Organ> a owl:Class ;
    rdfs:label "organ" ;
    ns1:definition "Macroscopic, well delimited, functionally and structurally characterized part of an organism. Exact criteria of what an organ is do not exist." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganismPart> .

<http://purl.org/biotop/biotop.owl#OrganismInteraction> a owl:Class ;
    rdfs:label "organism interaction" ;
    ns1:definition "action in which single biological organisms interact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ],
        <http://purl.org/biotop/biotop.owl#Interacting> .

<http://purl.org/biotop/biotop.owl#OrganismProcess> a owl:Class ;
    rdfs:label "organism process" ;
    ns1:definition "any biological process that involves a whole organism" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#BiologicalProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ] ) ] .

<http://purl.org/biotop/biotop.owl#PathologicalStaticProcessualEntity> a owl:Class ;
    rdfs:label "pathological static processual entity" ;
    rdfs:comment "Condition of an organism that deviates from what is considered normal. Often referred to by the terms \"disorder\", \"disease\", \"syndrome\", \"sign\", or \"symptom\". None of these denote clearly delineated ontological categories. \\n\\nSee disease role etc." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#NoncanonicalStaticProcessualEntity> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PathologicalValueRegion> ] ) ] ] ) ] ;
    owl:priorVersion "pathological state" .

<http://purl.org/biotop/biotop.owl#PhylumArthropodaValueRegion> a owl:Class ;
    rdfs:label "phylum arthropoda value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#KingdomAnimaliaValueRegion> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#PhylumChordataValueRegion> .

<http://purl.org/biotop/biotop.owl#PhylumChordataValueRegion> a owl:Class ;
    rdfs:label "phylum chordata value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#KingdomAnimaliaValueRegion> .

<http://purl.org/biotop/biotop.owl#PhysicalForce> a owl:Class ;
    rdfs:label "physical force" ;
    ns1:definition "force as defined by physics (mass + acceleration)" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ProcessQuality> .

<http://purl.org/biotop/biotop.owl#PhysicalProcessualEntity> a owl:Class ;
    rdfs:label "physical processual entity" ;
    ns1:definition "process that only involves non-biological participants" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf <http://purl.org/biotop/biotop.owl#BiologicalProcessualEntity> ],
        <http://purl.org/biotop/biotop.owl#Process> .

<http://purl.org/biotop/biotop.owl#Plan> a owl:Class ;
    rdfs:label "plan" ;
    ns1:definition "A plan is an information entity that describes a series of steps to be carried out in order to achiev a goal. Plans can only be realized by processes." ;
    rdfs:comment "(OBI 344)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Process> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasRealization> ],
        <http://purl.org/biotop/biotop.owl#InformationObject> .

<http://purl.org/biotop/biotop.owl#PoisonRole> a owl:Class ;
    rdfs:label "poison role" ;
    ns1:definition "The role of a substance of mixture of substance of a defined amount thereof to be toxic to (parts of) biological organisms" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HealthRelatedRole> .

<http://purl.org/biotop/biotop.owl#PreventiveRole> a owl:Class ;
    rdfs:label "preventive role" ;
    ns1:definition "The role an action plays if it is intended to protect an organism against negative external influences." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HealthRelatedRole> .

<http://purl.org/biotop/biotop.owl#StateOfMatter> a owl:Class ;
    rdfs:label "state of matter" ;
    ns1:definition "States of matter are the distinct forms that different phases of matter take on." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StateOfMatterValueRegion> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#StateOfMatterValueRegion> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ],
        <http://purl.org/biotop/biotop.owl#ObjectQuality> .

<http://purl.org/biotop/biotop.owl#StaticProcessualEntity> a owl:Class ;
    rdfs:label "static processual entity" ;
    rdfs:comment "Static condition as a special case of process in which temporal parts are neglected.  " ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> <http://purl.org/biotop/biotop.owl#PhysicalBoundary> ) ] ],
        <http://purl.org/biotop/biotop.owl#Process> ;
    owl:priorVersion "State" .

<http://purl.org/biotop/biotop.owl#StructuredBiologicalCompoundByCanonicityPartition> a owl:Class ;
    rdfs:label "*" ;
    ns1:definition "StructuredBiologicalCompoundByCanonicityPartition\\n\\nontologically irrelevant partition node" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#PathologicalStructure> <http://purl.org/biotop/biotop.owl#WellFormedBiologicalStructure> ) ] ) ] .

<http://purl.org/biotop/biotop.owl#SubstanceInteraction> a owl:Class ;
    rdfs:label "substance interaction" ;
    ns1:definition "action in which molecular entities interact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#MoleculeComplex> <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#MoleculeComplex> <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ) ] ] ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ],
        <http://purl.org/biotop/biotop.owl#Interacting> .

<http://purl.org/biotop/biotop.owl#Tissue> a owl:Class ;
    rdfs:label "tissue" ;
    ns1:definition "Aggregate of an arbitrary number of congeneric cells (cells with identical specialized characteristics), embedded into an amount of matter (matrix) that work together to perform a specific function." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#originatesFrom> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MulticellularOrganism> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Cell> ] ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EntireMolecularEntity> ] ],
        <http://purl.org/biotop/biotop.owl#PortionOfHeterogenousSolid> .

<http://purl.org/biotop/biotop.owl#WaterMolecule> a owl:Class ;
    rdfs:label "water molecule" ;
    ns1:definition "A water molecule is composed by one oxygen molecule and two hydrogen molecules" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#InorganicMolecularEntity> .

<http://purl.org/biotop/biotop.owl#WellFormedBiologicalStructure> a owl:Class ;
    rdfs:label "well formed biological structure" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#StructuredBiologicalCompoundByCanonicityPartition> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CanonicalValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#attachedTo> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "attached to" ;
    ns1:definition "Contiguous with a clear bona fide boundary between the connected parts.\\nSchulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.\\nArtif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#contiguousWith> .

<http://purl.org/biotop/biotop.owl#causallyRelatedTo> a owl:ObjectProperty ;
    rdfs:label "causally related to" ;
    ns1:definition "Expresses a causal chain between material or processual entities.\\n\\ncausallyRelatedTo is meant as an organizing parent. It should not be asserted." ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://purl.org/biotop/biotop.owl#causes> a owl:ObjectProperty ;
    rdfs:label "causes" ;
    ns1:definition "Causation of a process is here understood as the disjunction between agency (a continuant causes a process) and as the realization of a disposition, i.e. a disposition is considered the cause of a process. \\n " ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#causallyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#causedBy> .

<http://purl.org/biotop/biotop.owl#componentPartOf> a owl:ObjectProperty ;
    rdfs:label "component part of" ;
    ns1:definition "The non-transitive relation hasComponentPart (inverse: componentPartOf) relates components with a compound. Components strictly partition the compound, and the compound is the mereological sum of its components. A loss of some component affects the integrity of the compound, and possibly the type it instantiates, e.g. a complete vs. a defective organism. \\n\\nThe choice of what is a component of a compound is somewhat arbitrary, because there are several ways to divide a whole into parts. Strictly spoken, this relation should refer to some partition.\\n\\nComponents should be - at least - partly bona fide parts. The use of this relation also requires the commitment to an underlying granularity level. So could we consider the codons (base triples) as the components of a DNA molecule but also the single nucleotides. Note that components of a compound may also be portions of matter.\\n\\nExamples: my liver is a component of my organism, a carboxy group is a component of some organic acid molecule." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#hasComponentPart> .

<http://purl.org/biotop/biotop.owl#contiguousWith> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "contiguous with" ;
    ns1:definition "ContiguousWith describes the connection between two material objects that abut and can transmit forces.\\n\\n " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicallyAdjacentTo> .

<http://purl.org/biotop/biotop.owl#derivesFrom> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "derives from" ;
    ns1:definition "DerivesFrom (inverse: derivedInto) holds between  distinct material objects  when one succeeds the other across a temporal divide in such a way that at least a biologically significant portion of the matter of the earlier object is included into the later. \\n\\nThere is some instant of time t such that the first object exists only prior to and the second one  only subsequent to t. \\n\\nThese relations are borrowed from the OBO Relation Ontology\\n\\nExample:\\n\"Three simple kinds of instance-level derivation can then be distinguished (Figure 3): first, the succession of one single continuant by another single continuant across a temporal threshold (for example, this blastocyst derives from this zygote); second, the fusion of two or more continuants into one continuant (for example, this zygote derives from this sperm and from this ovum); and third, the fission of an earlier single continuant to create a plurality of later continuants (for example, these promyelocytes derive from this myeoloblast). \" from http://genomebiology.com/2005/6/5/R46" ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#originatesFrom> .

<http://purl.org/biotop/biotop.owl#hasOutcome> a owl:ObjectProperty ;
    rdfs:label "has outcome" ;
    ns1:definition "outcomeOf (inverse: hasOutcome) relates a participant to a process. This participant either\\n- a) comes into being during the process\\nor - b) undergoes some change during the process, so that it instantiates a different class at the end of the process \\nand it constitutes (one of) the main result(s) of the process\\n\\nExample: a Protein molecule is the outcome of a translation process." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasParticipant> .

<http://purl.org/biotop/biotop.owl#patientIn> a owl:ObjectProperty ;
    rdfs:label "patient in" ;
    ns1:definition "patientIn (inverse: hasPatient) relates a participant with a process, with the condition that that this participant is not causally active.  \\n\\nExample: A prey is the patient in a hunting process; a solute is the patient in a solving process. " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#participatesIn> .

<http://purl.org/biotop/biotop.owl#physicallyAdjacentTo> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "physically adjacent to" ;
    ns1:definition "physicalAdjacentTo relates two physical objects that abut without physical overlap. \\n\\nExamples: see subrelations" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicallyConnectedTo> .

<http://purl.org/biotop/biotop.owl#physicallyLocatedIn> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "physically located in" ;
    ns1:definition "physicallylocatedIn (inverse: physical location of) relates two physical objects in terms of space. All point in space occupied by the first object are also occupied by the second object. \\n\\nGenerally, this relation is further specificed in terms of parthood or containment\\n\\nExamples: my thumb is physically located in my hand, food is located in my stomach or also in the cavity of my stomach. A 10 Euro bill is located in my wallet. " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasLocus>,
        <http://purl.org/biotop/biotop.owl#physicallyConnectedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#physicalLocationOf> .

<http://purl.org/biotop/biotop.owl#processuallyRelatedTo> a owl:ObjectProperty ;
    rdfs:label "processually related to" ;
    ns1:definition "Relations that connect processes with other entities.\\n\\nprocessuallyRelatedTo is meant as an organizing parent. It should not be asserted." .

<http://purl.org/biotop/biotop.owl#AminoAcidMoleculeOrResidue> a owl:Class ;
    rdfs:label "amino acid molecule or residue" ;
    ns1:definition "Amino Acids molecules or residues (residues as in peptide bonds)" ;
    rdfs:comment "(QCR) ro:hasPart some CarbonHydrogenSubstructure and ((hasComponent myx 2 CarboxyGroup) and (hasComponent min 1 CarboxyGroup) and (hasComponent exactly 1 AminoGroup)) or ((hasComponent max 2 AminoGroup) and (hasComponent min 1 AminoGroup) and (hasComponent exactly 1 CarboxyGroup))",
        "In chemistry, an amino acid is any molecule that contains both amine and carboxyl functional groups. However, in biochemistry, this more general term is frequently used to refer to alpha amino acids (amino acids in which the amino and carboxylate functionalities are attached to the same carbon, called ?–carbon). Amino Acids have at least one amino and one carboxy group. Those having two carboxy groups have only one amino group and vice versa." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SubmolecularGroup> ],
        <http://purl.org/biotop/biotop.owl#AminoAcidOrPeptideMoleculeOrStructure>,
        <http://purl.org/biotop/biotop.owl#Monomer> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#PeptideStructure> .

<http://purl.org/biotop/biotop.owl#Arthropod> a owl:Class ;
    rdfs:label "arthropod" ;
    rdfs:comment "one arthropod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PhylumArthropodaValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Invertebrate> .

<http://purl.org/biotop/biotop.owl#BodySystem> a owl:Class ;
    rdfs:label "body system" ;
    ns1:definition "Mereological sum of heterogeneous body components that constitute a functional unity" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganismPart> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#Organ> .

<http://purl.org/biotop/biotop.owl#CandidaAlbicansCell> a owl:Class ;
    rdfs:label "candida albicans cell" ;
    rdfs:comment "One candida albicans cell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SpeciesCandidaAlbicansValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#YeastCell> .

<http://purl.org/biotop/biotop.owl#CanonicalValueRegion> a owl:Class ;
    rdfs:label "canonical value region" ;
    rdfs:comment "abstract region in which the value \"canonical\" of canonicity is located" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#CanonicityValueRegion> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#NoncanonicalValueRegion> .

<http://purl.org/biotop/biotop.owl#CellByTaxonPartition> a owl:Class ;
    rdfs:label "*" ;
    ns1:definition "CellByTaxonPartition\\n\\nOntologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#AnimalCell> <http://purl.org/biotop/biotop.owl#BacterialCell> <http://purl.org/biotop/biotop.owl#PlantCell> ) ],
        <http://purl.org/biotop/biotop.owl#Cell> .

<http://purl.org/biotop/biotop.owl#Electron> a owl:Class ;
    rdfs:label "electron" ;
    ns1:definition "Negatively Charged Particle" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#SubatomicEntityByChargePartition> .

<http://purl.org/biotop/biotop.owl#EmbryonicValueRegion> a owl:Class ;
    rdfs:label "embryonic value region" ;
    rdfs:comment "\"embryonic\" as the value of a developmental stage. E.g. a 3 days old mouse embryo has a quality which has its value located in \"embryonic value region\"." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#DevelopmentalValueRegion> .

<http://purl.org/biotop/biotop.owl#Function> a owl:Class ;
    rdfs:label "function" ;
    ns1:definition "A classical definition of function according to Wright is that the function F of X is Z means that X is there because it Zs, and Z is a consequence of X being there. \\n\\nFor artefacts, functions are distinguished from dispositions by the purpose they have been built. For example, a hammer has the function to drive in nails, but not to be used as a weapon. However, it has the disposition to be used as a weapon under certain circumstances.\\n\\nFor biological objects, which developed by evolution, the definition of function is still subject to controversy (e.g. Barry Smith's view of function as pertaining to a canonical life plan, cf. \\nhttp://www.slideserve.com/presentation/103450/The-Canonical-Life). \\n\\nIn BFO \"Disposition\" and \"Function\" are siblings, in BioTop Function is more specific.\\n " ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Process> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasRealization> ],
        <http://purl.org/biotop/biotop.owl#Disposition> .

<http://purl.org/biotop/biotop.owl#GreatApe> a owl:Class ;
    rdfs:label "great ape" ;
    rdfs:comment "one great ape" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#FamilyHominidaeValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Mammal> .

<http://purl.org/biotop/biotop.owl#HealthProfessionalRole> a owl:Class ;
    rdfs:label "health professional role" ;
    ns1:definition "the role a human plays as active part in a health system" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OccupationalRole> .

<http://purl.org/biotop/biotop.owl#HumanAction> a owl:Class ;
    rdfs:label "human action" ;
    ns1:definition "Action that has some human as agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#Human> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Human> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#OrganismAction> .

<http://purl.org/biotop/biotop.owl#InorganicMolecularEntity> a owl:Class ;
    rdfs:label "inorganic molecular entity" ;
    ns1:definition "Substances which do not include carbon and its derivatives as their principal elements. However, carbides, carbonates, cyanides, cyanates and carbon disulfide are included in this class." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#MolecularEntityByOrganicInorganicPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#OrganicMolecularEntity> .

<http://purl.org/biotop/biotop.owl#Insect> a owl:Class ;
    rdfs:label "insect" ;
    ns1:definition "one insect" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#ClassInsectaValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Arthropod> .

<http://purl.org/biotop/biotop.owl#IntellectualProduct> a owl:Class ;
    rdfs:label "intellectual product" ;
    ns1:definition "An intellectual product is a piece of information that is the outcome of a human reasoning process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#patientIn> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Process> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Human> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#InformationObject> .

<http://purl.org/biotop/biotop.owl#Interacting> a owl:Class ;
    rdfs:label "interacting" ;
    ns1:definition "two or more interaction partners exerce a mutual effect that may lead to structural transformation." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Affecting> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#GroupInteraction> <http://purl.org/biotop/biotop.owl#OrganismInteraction> <http://purl.org/biotop/biotop.owl#SubstanceInteraction> ) ] .

<http://purl.org/biotop/biotop.owl#KingdomPlantaeValueRegion> a owl:Class ;
    rdfs:label "kingdom plantae value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TaxonValueRegion> .

<http://purl.org/biotop/biotop.owl#LanguagePartition> a owl:Class ;
    ns1:definition "Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Language> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#AnimalLanguage> <http://purl.org/biotop/biotop.owl#HumanLanguage> <http://purl.org/biotop/biotop.owl#MachineLanguage> ) ] ) ] .

<http://purl.org/biotop/biotop.owl#LiquidValueRegion> a owl:Class ;
    rdfs:label "liquid value region" ;
    rdfs:comment "\"liquid\" as the value of a states of matter. E.g. a portion of water has a quality which has its value located in \"liquid value region\"" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#StateOfMatterValueRegion> .

<http://purl.org/biotop/biotop.owl#MolecularEntityByGranularityPartition> a owl:Class ;
    rdfs:label "*" ;
    ns1:definition "MolecularEntityByGranularityPartition\\n\\nOntologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Monomer> <http://purl.org/biotop/biotop.owl#OligoOrPolymer> <http://purl.org/biotop/biotop.owl#SubmolecularGroup> ) ] .

<http://purl.org/biotop/biotop.owl#Neutron> a owl:Class ;
    rdfs:label "neutron" ;
    ns1:synonym "Neutral Particle" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#SubatomicEntityByChargePartition> .

<http://purl.org/biotop/biotop.owl#NoncanonicalStaticProcessualEntity> a owl:Class ;
    rdfs:label "noncanonical static processual entity" ;
    ns1:definition "a biological state that is considered \"abnormal\"" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#StaticProcessualEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProcessQuality> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#NoncanonicalValueRegion> ] ) ] ] ) ] ;
    owl:priorVersion "noncanonical state" .

<http://purl.org/biotop/biotop.owl#NucleotideMolecule> a owl:Class ;
    rdfs:label "nucleotide molecule" ;
    ns1:definition "Comment: (QCR) hasComponent exactly 1 HeterocyclicBase and hasComponent exactly 1 Phosphate and hasComponent only (Phosphate or Ribose or HeterocyclicBase) and hasComponent exactly 1 Pentose" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SubmolecularGroup> ],
        <http://purl.org/biotop/biotop.owl#NucleicAcidNucleotideOrNucleosideMoleculeOrResidue> .

<http://purl.org/biotop/biotop.owl#OligoOrPolymer> a owl:Class ;
    rdfs:label "oligo or polymer" ;
    ns1:definition "An oligo or polymer macromolecular structure is a molecule of moderate to high relative molecular mass, the structure of which essentially comprises the multiple repetition (n >= 2) of units derived from molecules of low relative molecular mass." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Monomer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Monomer> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ],
        <http://purl.org/biotop/biotop.owl#MolecularEntityByGranularityPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#SubmolecularGroup> .

<http://purl.org/biotop/biotop.owl#OrderPrimatesValueRegion> a owl:Class ;
    rdfs:label "order primates value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ClassMammaliaValueRegion> .

<http://purl.org/biotop/biotop.owl#OrganismByDevelopmentalStagePartition> a owl:Class ;
    ns1:definition "Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#AdultOrganism> <http://purl.org/biotop/biotop.owl#EmbryonicOrganism> <http://purl.org/biotop/biotop.owl#JuvenileOrganism> ) ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#AdultOrganism> <http://purl.org/biotop/biotop.owl#EmbryonicOrganism> <http://purl.org/biotop/biotop.owl#JuvenileOrganism> ) ] ) ] .

<http://purl.org/biotop/biotop.owl#OrganismByTaxonPartition> a owl:Class ;
    rdfs:comment "Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#Eukaryote> <http://purl.org/biotop/biotop.owl#Prokaryote> <http://purl.org/biotop/biotop.owl#Virus> ) ] ) ] .

<http://purl.org/biotop/biotop.owl#Organization> a owl:Class ;
    rdfs:label "organization" ;
    ns1:definition "collection of human or legal entities" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#LegalEntity> .

<http://purl.org/biotop/biotop.owl#PathologicalValueRegion> a owl:Class ;
    rdfs:label "pathological value region" ;
    ns1:definition "state of an organism or an organism part requiring therapeutic or palliative intervention" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#NoncanonicalValueRegion> [ a owl:Class ;
                        owl:unionOf ( [ a owl:Class ;
                                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                                owl:onProperty <http://purl.org/biotop/biotop.owl#processQualityOf> ;
                                                owl:someValuesFrom [ a owl:Class ;
                                                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> <http://purl.org/biotop/biotop.owl#OrganismPart> ) ] ] ) ] [ a owl:Restriction ;
                                    owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocationOf> ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> <http://purl.org/biotop/biotop.owl#OrganismPart> ) ] ] ) ] ] ) ] ) ] .

<http://purl.org/biotop/biotop.owl#PlantCell> a owl:Class ;
    rdfs:label "plant cell" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#CellByTaxonPartition> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Cell> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#KingdomPlantaeValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#Primate> a owl:Class ;
    rdfs:label "primate" ;
    rdfs:comment "one primate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#OrderPrimatesValueRegion> ] [ a owl:Restriction ;
                                owl:allValuesFrom <http://purl.org/biotop/biotop.owl#OrderPrimatesValueRegion> ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#GreatApe> .

<http://purl.org/biotop/biotop.owl#RNAChain> a owl:Class ;
    rdfs:label "RNA chain" ;
    ns1:definition "any kind of NucleicAcid that is composed of Ribonucleotides which are not Deoxyribonucleotides" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ChainOfNucleotideMonomers> .

<http://purl.org/biotop/biotop.owl#SpeciesHomoSapiensValueRegion> a owl:Class ;
    rdfs:label "species homo sapiens value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#GenusHomoValueRegion> .

<http://purl.org/biotop/biotop.owl#SubatomicEntityByChargePartition> a owl:Class ;
    rdfs:label "*" ;
    ns1:definition "SubatomicEntityByChargePartition\\n\\nontologically irrelevant node: disjoint partition: subatomic entity by charge" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#SubatomicParticle> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#Electron> <http://purl.org/biotop/biotop.owl#Neutron> <http://purl.org/biotop/biotop.owl#Proton> ) ] ) ] .

<http://purl.org/biotop/biotop.owl#SubphylumVertebrataValueRegion> a owl:Class ;
    rdfs:label "subphylum vertebrata value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PhylumChordataValueRegion> .

<http://purl.org/biotop/biotop.owl#causedBy> a owl:ObjectProperty ;
    rdfs:label "caused by" ;
    ns1:definition "Causation of a process is here understood as the disjunction between agency (a continuant causes a process) and as the realization of a disposition, i.e. a disposition is considered the cause of a process. \\n " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#causallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#hasOrigin> a owl:ObjectProperty ;
    rdfs:label "has origin" ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#spatiallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#hasPhysicalPart> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has physical part" ;
    ns1:definition "hasPhysicalPart (inverse: physicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. \\nThis relation is reflexive, i.e. every physical object has itself as a physical part.\\n\\nNote that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"\\n\\nFor processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicalLocationOf> .

<http://purl.org/biotop/biotop.owl#hasPointInTime> a owl:ObjectProperty ;
    rdfs:label "has point in time" ;
    ns1:definition "hasPointInTome relates a processual entity with some point in the interval it occupies. \\nIf there is no temporal extension (process boundary) it relates it to the time it occurs. " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#PointInTime> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#temporallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#hasRealization> a owl:ObjectProperty ;
    rdfs:label "has realization" ;
    ns1:definition "Realization occurs if a disposition or function manifests itself as a process. \\n\\nExample: the disposition of a bird to fly (which exists even when it does not fly) is realized by its process of flying.  " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Disposition> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Role> ) ] ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#causes> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#realizationOf> .

<http://purl.org/biotop/biotop.owl#locusOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "locus of" ;
    ns1:definition "hasLocus (inverse: locusOf) is a very broad relation which relates an entity with the place it occurs, inheres, or is part of.\\n\\nSee property chains: a participant of a process at a given time is located where the process is located. \\n\\nExample: A heart pumping process is located in a heart. " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Disposition> <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Role> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#spatiallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#physicalLocationOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "physical location of" ;
    ns1:definition "physicallylocatedIn (inverse: physical location of) relates two physical objects in terms of space. All point in space occupied by the first object are also occupied by the second object. \\n\\nGenerally, this relation is further specificed in terms of parthood or containment\\n\\nExamples: my thumb is physically located in my hand, food is located in my stomach or also in the cavity of my stomach. A 10 Euro bill is located in my wallet. " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#locusOf>,
        <http://purl.org/biotop/biotop.owl#physicallyConnectedTo> .

<http://purl.org/biotop/biotop.owl#processQualityOf> a owl:ObjectProperty ;
    rdfs:label "process quality of" ;
    ns1:definition "processQualityOf (abstract: hasProcessQuality) links a quality that further characterizes a process to this process. Process qualities are asserted where the process cannot sufficiently be described by the qualities of its participants only. \\n\\nExample: The process of heart beating has the process quality heart rate." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#ProcessQuality> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> .

owl:topObjectProperty a owl:ObjectProperty .

<http://purl.org/biotop/biotop.owl#AminoAcidOrPeptideMoleculeOrStructure> a owl:Class ;
    rdfs:label "amino acid or peptide molecule or structure" ;
    ns1:definition "amino acids as monomers and polymers" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganicMolecularEntityPartition> .

<http://purl.org/biotop/biotop.owl#BiologicalSpace> a owl:Class ;
    rdfs:label "biological space" ;
    ns1:definition "space that is located inside a biological entity" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialThreeDimensionalPhysicalEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#physicallyContainedIn> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ] ) ] .

<http://purl.org/biotop/biotop.owl#BiologicalSystemRole> a owl:Class ;
    rdfs:label "biological system role" ;
    ns1:definition "A role specific to biological processes" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Role> .

<http://purl.org/biotop/biotop.owl#CarbohydrateMoleculeOrResidue> a owl:Class ;
    rdfs:label "carbohydrate molecule or residue" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganicMolecularEntityPartition> .

<http://purl.org/biotop/biotop.owl#ChainOfNucleotideMonomers> a owl:Class ;
    rdfs:label "chain of nucleotide monomers" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#NucleicAcidStructure> .

<http://purl.org/biotop/biotop.owl#ChemicalRole> a owl:Class ;
    rdfs:label "chemical role" ;
    ns1:definition "Any role performed by a chemical substance." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Role> .

<http://purl.org/biotop/biotop.owl#FamilyRole> a owl:Class ;
    rdfs:label "family role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#AnimalIncludingHuman> <http://purl.org/biotop/biotop.owl#AnimalPopulation> ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ],
        <http://purl.org/biotop/biotop.owl#Role> .

<http://purl.org/biotop/biotop.owl#FindingRole> a owl:Class ;
    rdfs:label "finding role" ;
    ns1:definition "The role that may inhere in any biological structure, state, or process that is of reportable interest in a diagnostic process." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HealthRelatedRole> .

<http://purl.org/biotop/biotop.owl#Fungus> a owl:Class ;
    rdfs:label "fungus" ;
    ns1:definition "Heterotrophic organisms characterized by a chitinous cell wall." ;
    rdfs:comment "On fungus organisms" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#KingdomFungiValueRegion> ] [ a owl:Restriction ;
                                owl:allValuesFrom <http://purl.org/biotop/biotop.owl#KingdomFungiValueRegion> ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Eukaryote> .

<http://purl.org/biotop/biotop.owl#ImmaterialThreeDimensionalPhysicalEntity> a owl:Class ;
    rdfs:label "immaterial three dimensional physical entity" ;
    ns1:definition "three-dimensional space" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PhysicalVolume> ],
        <http://purl.org/biotop/biotop.owl#ImmaterialObject> .

<http://purl.org/biotop/biotop.owl#JuvenileOrganism> a owl:Class ;
    rdfs:label "juvenile organism" ;
    ns1:definition "born organism, not yet in reproductive age" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganismByDevelopmentalStagePartition> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#DevelopmentalQuality> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#JuvenileValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#KingdomBacteriaValueRegion> a owl:Class ;
    rdfs:label "kingdom bacteria value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TaxonValueRegion> .

<http://purl.org/biotop/biotop.owl#KingdomFungiValueRegion> a owl:Class ;
    rdfs:label "kingdom fungi value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TaxonValueRegion> .

<http://purl.org/biotop/biotop.owl#Mammal> a owl:Class ;
    rdfs:label "mammal" ;
    rdfs:comment "one mammal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#ClassMammaliaValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Vertebrate> .

<http://purl.org/biotop/biotop.owl#MaterialEntityBySizePartition> a owl:Class ;
    rdfs:label "*" ;
    rdfs:comment "MaterialEntityBySizePartition\\n\\nOntologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Atom> <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> <http://purl.org/biotop/biotop.owl#PolyMolecularCompositeEntity> <http://purl.org/biotop/biotop.owl#SubatomicParticle> ) ] .

<http://purl.org/biotop/biotop.owl#NucleicAcidStructure> a owl:Class ;
    rdfs:label "nucleic acid structure" ;
    ns1:definition "A nucleic acid is a complex, high-molecular-weight biochemical macromolecule composed of nucleotide chains that convey genetic information." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#NucleotideMolecule> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#NucleotideMolecule> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ],
        <http://purl.org/biotop/biotop.owl#NucleicAcidNucleotideOrNucleosideMoleculeOrResidue> .

<http://purl.org/biotop/biotop.owl#OrganicMolecularEntity> a owl:Class ;
    rdfs:label "organic molecular entity" ;
    ns1:definition "Substances containing carbon and its derivatives as their prinicipal elements, usually combined with itself and with atoms of one or more other element such as hydrogen, oxygen, nitrogen, sulfur, phosphorus, chlorine or fluorine. They exist in either carbon chain or carbon ring form. Excludes carbides, carbonates and carbon oxides." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#MolecularEntityByOrganicInorganicPartition> .

<http://purl.org/biotop/biotop.owl#PathologicalStructure> a owl:Class ;
    rdfs:label "pathological structure" ;
    ns1:definition "biological structure that is non-canonic" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#StructuredBiologicalCompoundByCanonicityPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#WellFormedBiologicalStructure> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Canonicity> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#NoncanonicalValueRegion> ] ) ] ] ) ] ;
    owl:priorVersion "former name: \"ill formed biological structure\"" .

<http://purl.org/biotop/biotop.owl#PhysicalBoundary> a owl:Class ;
    rdfs:label "physical boundary" ;
    ns1:definition "A independent physical entity that bounds or demarcates some other physical entity. Commonly viewed as a lower-dimensional part, the the notion of physical boundary here also encompasses ill-delimited spaces that fulfill the same function, e.g. biological joints." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ImmaterialObject> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#physicallyBounds> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ] .

<http://purl.org/biotop/biotop.owl#PhysicalMass> a owl:Class ;
    rdfs:label "physical mass" ;
    ns1:definition "Mass (gravity independent) - not weight. Measured in g, kg, ..." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#MaterialObject> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MaterialObject> ],
        <http://purl.org/biotop/biotop.owl#ObjectQuality> .

<http://purl.org/biotop/biotop.owl#PhysicalVolume> a owl:Class ;
    rdfs:label "physical volume" ;
    ns1:definition "Volume of three-dimensional objects - third potency of length" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ],
        <http://purl.org/biotop/biotop.owl#ObjectQuality> .

<http://purl.org/biotop/biotop.owl#Plant> a owl:Class ;
    rdfs:label "plant" ;
    ns1:definition "Organism of the kingdom Plantae." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#KingdomPlantaeValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Eukaryote> .

<http://purl.org/biotop/biotop.owl#PluralityOfOrganisms> a owl:Class ;
    rdfs:label "plurality of organisms" ;
    ns1:definition "Collection of two or more organisms of the same sort.  " ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TaxonQuality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#LivingOrganism> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ],
        <http://purl.org/biotop/biotop.owl#CollectiveMaterialEntity> .

<http://purl.org/biotop/biotop.owl#PointInTime> a owl:Class ;
    rdfs:label "point in time" ;
    ns1:definition "typically the boundary of a time interval" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Time> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#TimeInterval> .

<http://purl.org/biotop/biotop.owl#Protist> a owl:Class ;
    rdfs:label "protist" ;
    ns1:definition "Organisms of the kingdom Protista" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MicroscopicValueRegion> ] ],
        <http://purl.org/biotop/biotop.owl#Eukaryote> .

<http://purl.org/biotop/biotop.owl#Proton> a owl:Class ;
    rdfs:label "proton" ;
    ns1:definition "Positively Charged Particle" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#SubatomicEntityByChargePartition> .

<http://purl.org/biotop/biotop.owl#SignallingRole> a owl:Class ;
    rdfs:label "signalling role" ;
    ns1:definition "The role of a biological entity that participates in a biological signalling process." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ],
        <http://purl.org/biotop/biotop.owl#BiologicalSystemRole> .

<http://purl.org/biotop/biotop.owl#StructuredBiologicalCompoundByGranularityPartition> a owl:Class ;
    rdfs:label "*" ;
    rdfs:comment "StructuredBiologicalCompoundByGranularityPartition\\n\\nontologically irrelevant disjoint partition: structured biological compound by granularity" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#Cell> <http://purl.org/biotop/biotop.owl#CellularComponent> <http://purl.org/biotop/biotop.owl#OrganismPart> <http://purl.org/biotop/biotop.owl#Syncytium> ) ] ) ] .

<http://purl.org/biotop/biotop.owl#Virus> a owl:Class ;
    rdfs:label "virus" ;
    ns1:definition "Sub-microscopic agent that requires a host cell to grow and reproduce. Viruses resemble other organisms in that they possess genes, and can evolve in infected cells by natural selection.  We therefore classify viruses as organisms, although there is an open debate." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf <http://purl.org/biotop/biotop.owl#Cell> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MicroscopicValueRegion> ] ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Cell> ] ],
        <http://purl.org/biotop/biotop.owl#OrganismByTaxonPartition> .

<http://purl.org/biotop/biotop.owl#YeastCell> a owl:Class ;
    rdfs:label "yeast cell" ;
    rdfs:comment "Unicellular Fungi." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:complementOf <http://purl.org/biotop/biotop.owl#Cell> ] ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Cytoplasm> ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CellMembrane> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CellularComponent> ] ) ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MicroscopicValueRegion> ] ],
        <http://purl.org/biotop/biotop.owl#Fungus> .

<http://purl.org/biotop/biotop.owl#hasDuration> a owl:ObjectProperty ;
    rdfs:label "has duration" ;
    ns1:definition "hasDuration relates a process with the time interval it covers." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#TimeInterval> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#temporallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#BiologicalSizeValueRegion> a owl:Class ;
    rdfs:label "biological size value region" ;
    ns1:definition "values that describe the size of biological entities" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ValueRegion> .

<http://purl.org/biotop/biotop.owl#CanonicityValueRegion> a owl:Class ;
    rdfs:label "canonicity value region" ;
    ns1:definition "abstract region in which values of canonicity are located" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocationOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Canonicity> ],
        <http://purl.org/biotop/biotop.owl#ValueRegion> .

<http://purl.org/biotop/biotop.owl#CellMembrane> a owl:Class ;
    rdfs:label "cell membrane" ;
    ns1:definition "Semipermeable lipid bilayer found in all cells.[1] It contains a wide variety of biological molecules, primarily proteins and lipids, which are involved in a vast array of cellular processes, and also serves as the attachment point for both the intracellular cytoskeleton and, if present, the cell wall." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#LipidMoleculeOrResidue> ] ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PeptideStructure> ] ],
        <http://purl.org/biotop/biotop.owl#CellularComponent> .

<http://purl.org/biotop/biotop.owl#CollectiveMaterialEntity> a owl:Class ;
    rdfs:label "collective material entity" ;
    ns1:definition "Mereological Sum of multiple grains of the same sort without clear identity and unity criteria.\\nWhether or not the grains are considered of the same sort depends on the view. Therefore this class does not really make a clear categorial distinction, because all matter can be described as a collection of atoms.\\nAs a consequence, these classes are not fully defined. \\n " ;
    rdfs:comment "The fuzzyness of this class is due to the \"same sort\" criterion." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#MaterialObject> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MaterialObject> ] ) ] .

<http://purl.org/biotop/biotop.owl#CompoundOfCollectiveMaterialEntities> a owl:Class ;
    rdfs:label "compound of collective material entities" ;
    ns1:definition "Composition of different kinds of collections without clear unity and identity criteria.\\nOld name: compound of collections.\\nPractically all naturally occurring substances are of this sort. The different compounds are also called fractions" ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#PluralityOfOrganisms> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#MaterialObject> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CollectiveMaterialEntity> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/biotop/biotop.owl#CollectiveMaterialEntity> ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ] ) ] .

<http://purl.org/biotop/biotop.owl#Cytoplasm> a owl:Class ;
    rdfs:label "cytoplasm" ;
    ns1:definition "Gelatinous, semi-transparent fluid that fills most cells. E" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#WaterMolecule> ] ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#hasGranularPart> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PeptideStructure> ] ],
        <http://purl.org/biotop/biotop.owl#CellularComponent> .

<http://purl.org/biotop/biotop.owl#DEPRECATED_RELATION> a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://purl.org/biotop/biotop.owl#EmbryonicOrganism> a owl:Class ;
    rdfs:label "embryonic organism" ;
    ns1:definition "evolving organism before birth, with not yet fully formed organs" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganismByDevelopmentalStagePartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#JuvenileOrganism> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#LivingOrganism> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#DevelopmentalQuality> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EmbryonicValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#EntireMolecularEntity> a owl:Class ;
    rdfs:label "entire molecular entity" ;
    ns1:definition "Separately distinguishable molecular structure, neither part of nor attached to any other molecular structure. Atoms are not considered molecular structures. The hierarchy of entire entities mirrors the hierarchy of structures." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#MolecularEntityByEntiretyPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#MolecularResidue> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ] ] ) ] .

<http://purl.org/biotop/biotop.owl#EntireProteinMolecule> a owl:Class ;
    rdfs:label "entire protein molecule" ;
    ns1:definition "Amino Acid Polymer longer than 100 monomers." ;
    rdfs:comment "(QCR) Peptide and hasComponent min 101 AminoAcidMonomer and not (ro:properPartOf some MolecularEntity)" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MonoMolecularEntity> ] ],
        <http://purl.org/biotop/biotop.owl#PeptideStructure> .

<http://purl.org/biotop/biotop.owl#LegalEntity> a owl:Class ;
    rdfs:label "legal entity" ;
    ns1:definition "nonmaterial entity that as an existence in a legal system" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#InformationObject> .

<http://purl.org/biotop/biotop.owl#MoleculeComplex> a owl:Class ;
    rdfs:label "molecule complex" ;
    ns1:definition "Particle that consists of entire molecules." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EntireMolecularEntity> ],
        <http://purl.org/biotop/biotop.owl#PolyMolecularCompositeEntity> .

<http://purl.org/biotop/biotop.owl#NucleicAcidNucleotideOrNucleosideMoleculeOrResidue> a owl:Class ;
    rdfs:label "nucleic acid nucleotide or nucleoside molecule or residue" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganicMolecularEntityPartition> .

<http://purl.org/biotop/biotop.owl#OccupationalRole> a owl:Class ;
    rdfs:label "occupational role" ;
    ns1:definition "The role that determines the occupation that characterizes the daily life of a human being or animal." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Role> .

<http://purl.org/biotop/biotop.owl#ProcessQuality> a owl:Class ;
    rdfs:label "process quality" ;
    ns1:definition "A quality that inheres in some process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#processQualityOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Process> ],
        <http://purl.org/biotop/biotop.owl#Quality> .

<http://purl.org/biotop/biotop.owl#TherapeuticRole> a owl:Class ;
    rdfs:label "therapeutic role" ;
    ns1:definition "1. The role of a continuant participating in a process with an expected positive impact on a dysfunctional biological system.\\n2. The role of a process with an expected positive impact on a dysfunctional biological system." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#HealthRelatedRole> .

<http://purl.org/biotop/biotop.owl#TwoDimensionalPhysicalEntity> a owl:Class ;
    rdfs:label "two dimensional physical entity" ;
    ns1:definition "plane" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ImmaterialObject> .

<http://purl.org/biotop/biotop.owl#hasLocus> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has locus" ;
    ns1:definition "hasLocus (inverse: locusOf) is a very broad relation which relates an entity with the place it occurs, inheres, or is part of.\\n\\nSee property chains: a participant of a process at a given time is located where the process is located. \\n\\nExample: A heart pumping process is located in a heart. " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Disposition> <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Role> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#spatiallyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#locusOf> ;
    owl:propertyChainAxiom ( <http://purl.org/biotop/biotop.owl#participatesIn> <http://purl.org/biotop/biotop.owl#hasLocus> ) .

<http://purl.org/biotop/biotop.owl#DevelopmentalQuality> a owl:Class ;
    rdfs:label "developmental quality" ;
    ns1:definition "Ontogenetic stage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#DevelopmentalValueRegion> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#DevelopmentalValueRegion> ],
        <http://purl.org/biotop/biotop.owl#ObjectQuality> .

<http://purl.org/biotop/biotop.owl#DevelopmentalValueRegion> a owl:Class ;
    rdfs:label "developmental value region" ;
    ns1:definition "abstract region in which the values of developmental stages are located" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#ValueRegion> .

<http://purl.org/biotop/biotop.owl#KingdomAnimaliaValueRegion> a owl:Class ;
    rdfs:label "kingdom animalia value region" ;
    rdfs:comment "EXAMPLE OF TAXON REGION" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#TaxonValueRegion> .

<http://purl.org/biotop/biotop.owl#LipidMoleculeOrResidue> a owl:Class ;
    rdfs:label "lipid molecule or residue" ;
    ns1:definition "Fat-soluble (lipophilic), naturally-occurring molecule." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SubmolecularGroup> ],
        <http://purl.org/biotop/biotop.owl#OrganicMolecularEntityPartition> .

<http://purl.org/biotop/biotop.owl#Monomer> a owl:Class ;
    rdfs:label "monomer" ;
    ns1:definition "Monomers can be described as constituted by molecularl groups. They are not repetitive and can constitute the building blocks of Polymers." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#MolecularEntityByGranularityPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#OligoOrPolymer>,
        <http://purl.org/biotop/biotop.owl#SubmolecularGroup> .

<http://purl.org/biotop/biotop.owl#OrganicMolecularEntityPartition> a owl:Class ;
    rdfs:comment "Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#OrganicMolecularEntity> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#AminoAcidOrPeptideMoleculeOrStructure> <http://purl.org/biotop/biotop.owl#CarbohydrateMoleculeOrResidue> <http://purl.org/biotop/biotop.owl#FattyAcidMoleculeOrResidue> <http://purl.org/biotop/biotop.owl#HeterocyclicBaseMoleculeOrResidue> <http://purl.org/biotop/biotop.owl#LipidMoleculeOrResidue> <http://purl.org/biotop/biotop.owl#NucleicAcidNucleotideOrNucleosideMoleculeOrResidue> ) ] ) ] .

<http://purl.org/biotop/biotop.owl#PolyMolecularCompositeEntity> a owl:Class ;
    rdfs:label "poly molecular composite entity" ;
    ns1:definition "An object which contains several molecules, has direct parts (components) of different types and which changes its ontological nature if subdivided. It must have clear unity and identity criteria." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#EntireMolecularEntity> ],
        <http://purl.org/biotop/biotop.owl#MaterialEntityBySizePartition> .

<http://purl.org/biotop/biotop.owl#Prokaryote> a owl:Class ;
    rdfs:label "prokaryote" ;
    ns1:definition "Cell lacking membrane enclosed organells" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MicroscopicValueRegion> ] ],
        <http://purl.org/biotop/biotop.owl#OrganismByTaxonPartition> .

<http://purl.org/biotop/biotop.owl#StateOfMatterValueRegion> a owl:Class ;
    rdfs:label "state of matter value region" ;
    ns1:definition "Values that a states of matter can have, e.g. liquid, solid." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocationOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StateOfMatter> ],
        <http://purl.org/biotop/biotop.owl#ValueRegion> .

<http://purl.org/biotop/biotop.owl#SubatomicParticle> a owl:Class ;
    rdfs:label "subatomic particle" ;
    ns1:definition "Parts of Atoms." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#MaterialEntityBySizePartition> .

<http://purl.org/biotop/biotop.owl#Syncytium> a owl:Class ;
    rdfs:label "syncytium" ;
    ns1:definition "Fusion of cells " ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CellMembrane> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CellularComponent> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Cytoplasm> ] ) ],
        <http://purl.org/biotop/biotop.owl#StructuredBiologicalCompoundByGranularityPartition> .

<http://purl.org/biotop/biotop.owl#TimeInterval> a owl:Class ;
    rdfs:label "time interval" ;
    ns1:definition "the interval between two time points" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Time> .

<http://purl.org/biotop/biotop.owl#hasPatient> a owl:ObjectProperty ;
    rdfs:label "has patient" ;
    ns1:definition "patientIn (inverse: hasPatient) relates a participant with a process, with the condition that that this participant is not causally active.  \\n\\nExample: A prey is the patient in a hunting process; a solute is the patient in a solving process. " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasParticipant> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#patientIn> .

<http://purl.org/biotop/biotop.owl#spatiallyRelatedTo> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "spatially related to" ;
    ns1:definition "Most general relation that relates entities in terms of physical location.\\n\\nspatiallyRelatedTo is meant as an organizing parent. It should not be asserted. " ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Disposition> <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Role> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Disposition> <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Role> ) ] .

<http://purl.org/biotop/biotop.owl#Atom> a owl:Class ;
    rdfs:label "atom" ;
    ns1:definition "Basic building block of molecules. Particle of discrete types. Biologically important atoms are C, N, H, O, P, S, Na, Ca, K, Mg, Cl, J, Fe, Co, Zn ,... Atoms may be electrically neutral or ionic." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Proton> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Proton> ] ) ],
        <http://purl.org/biotop/biotop.owl#MaterialEntityBySizePartition> .

<http://purl.org/biotop/biotop.owl#BacterialCell> a owl:Class ;
    rdfs:label "bacterial cell" ;
    ns1:synonym "Bacterium" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#KingdomBacteriaValueRegion> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#CellByTaxonPartition>,
        <http://purl.org/biotop/biotop.owl#Prokaryote> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#PlantCell> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Cell> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#KingdomBacteriaValueRegion> ] ) ] ] ) ] .

<http://purl.org/biotop/biotop.owl#BiologicalProcessualEntity> a owl:Class ;
    rdfs:label "biological processual entity" ;
    ns1:definition "Process specific for biological systems." ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#PhysicalProcessualEntity> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Process> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasLocus> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ] ) ] .

<http://purl.org/biotop/biotop.owl#HealthRelatedRole> a owl:Class ;
    rdfs:label "health related role" ;
    ns1:definition "A role an entity plays as an actor or participant in processes that assess or influence the health status of an organism." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Role> .

<http://purl.org/biotop/biotop.owl#MicroscopicValueRegion> a owl:Class ;
    rdfs:label "microscopic value region" ;
    ns1:definition "size values of objects that are too small to be seen without a microscope" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#BiologicalSizeValueRegion> .

<http://purl.org/biotop/biotop.owl#physicallyConnectedTo> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "physically connected to" ;
    ns1:definition "physicallyConnectedTo (a symmetric relation) relates two spatially relevant entities (material entities or spaces) which overlap at least one point in space. \\n\\nExample: France is connected to Germany, my optic nerve is connected to my eyeball." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#spatiallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#qualityLocationOf> a owl:ObjectProperty ;
    rdfs:label "quality location of" ;
    ns1:definition "qualityLocated (inverse: qualityLocationOf) relates a quality with an abstract value region. The underlying idea, borrowed from the DOLCE ontology, is that the attribute / value distinction - as ubiquitous in information systems - should at least be optionally expressible in ontologies. \\nValue regions are abstract regions, in which qualitative just as quantitative \"values\" are located. Like in topographic regions, these entities can overlap or be disjoint.\\n\\nExample: \"Color\" as quality may be refined as \"Red Color\". It can be fully defined in by \"quality located some RedColorRegion\"   " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#ValueRegion> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Quality> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> .

<http://purl.org/biotop/biotop.owl#temporallyRelatedTo> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "temporally related to" ;
    ns1:definition "The temporal arrangement of processes, events, durations and temporal measurements.\\n\\ntemporallyRelatedTo is meant as an organizing parent. It should not be asserted." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Time> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Process> <http://purl.org/biotop/biotop.owl#Time> ) ] .

<http://purl.org/biotop/biotop.owl#AnimalIncludingHuman> a owl:Class ;
    rdfs:label "animal including human" ;
    ns1:definition "Multicellular organisms of the kingdom Animalia" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#KingdomAnimaliaValueRegion> ] [ a owl:Restriction ;
                                owl:allValuesFrom <http://purl.org/biotop/biotop.owl#KingdomAnimaliaValueRegion> ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Eukaryote> .

<http://purl.org/biotop/biotop.owl#NoncanonicalValueRegion> a owl:Class ;
    rdfs:label "noncanonical value region" ;
    rdfs:comment "abstract region in which the value \"noncanonical\" of canonicity is located" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#CanonicityValueRegion> .

<http://purl.org/biotop/biotop.owl#OrganismPart> a owl:Class ;
    rdfs:label "organism part" ;
    ns1:definition "A well defined and circumscribed subdivision of an organism, not any arbitrary part. Macroscopic organism parts may be delimited mainly by natural boundaries but always exhibit at least small regions of fiat boundaries. An organism part may derive from an organism, i.e. it may continue to exist even when the organism does not exist any longer." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#StructuredBiologicalCompoundByGranularityPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#Syncytium> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Tissue> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#originatesFrom> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MulticellularOrganism> ] ) ] .

<http://purl.org/biotop/biotop.owl#Quality> a owl:Class ;
    rdfs:label "Quality" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Particular> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Particular> [ a owl:Class ;
                        owl:unionOf ( <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#ProcessQuality> ) ] ) ] .

<http://purl.org/biotop/biotop.owl#Vertebrate> a owl:Class ;
    rdfs:label "vertebrate" ;
    rdfs:comment "one vertebrate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SubphylumVertebrataValueRegion> ] [ a owl:Restriction ;
                                owl:allValuesFrom <http://purl.org/biotop/biotop.owl#SubphylumVertebrataValueRegion> ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ] ) ] ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                    owl:someValuesFrom [ a owl:Restriction ;
                            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#MicroscopicValueRegion> ] ] ],
        <http://purl.org/biotop/biotop.owl#AnimalIncludingHuman> .

<http://purl.org/biotop/biotop.owl#participatesIn> a owl:ObjectProperty ;
    rdfs:label "participates in" ;
    ns1:definition "HasParticipant (inverse: participatesIn) relates a process with a non processual entity which plays some role in the process. Process participants may exist during the whole process, remain unchanged or undergo changes; they may come into being or get out of being during the process. \\n\\nProcess participation is distinguished from process location.\\n\\nExample: \\n\\nAn urea molecule which is excreted in a renal filtration process is participant of this process.\\n\\nA person who undergoes an operation is participant of this process." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#processuallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#physicallyBounds> a owl:ObjectProperty ;
    rdfs:label "physically bounds" ;
    ns1:definition "physicallyBounds (inverse: physically boundedBy) relates a three-dimensional physical object with its two dimensional boundary. \\n\\nExample: the surface of my liver physically bounds my liver. " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#PhysicalBoundary> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#properPhysicalPartOf> .

<http://purl.org/biotop/biotop.owl#Eukaryote> a owl:Class ;
    rdfs:label "eukaryote" ;
    ns1:definition "An eukaryote is an organism with a complex cell or cells, in which the genetic material is organized into a membrane-bound nucleus or nuclei. Most Eukaryots are multicellular, haowever, there are some which are always unicellular (protists, some fungi) but there are also unicellular developmental stages (zygotes) of plants and animals." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#OrganismByTaxonPartition> .

<http://purl.org/biotop/biotop.owl#PeptideStructure> a owl:Class ;
    rdfs:label "peptide structure" ;
    rdfs:comment "Comment: We here use the term peptide in the most general sense, viz. a oligo or polymer made out of amino acids." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#AminoAcidMoleculeOrResidue> ],
        <http://purl.org/biotop/biotop.owl#AminoAcidOrPeptideMoleculeOrStructure> .

<http://purl.org/biotop/biotop.owl#Time> a owl:Class ;
    rdfs:label "time" ;
    ns1:definition "Point or interval on the time axis" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Particular> ;
    owl:priorVersion "temporal entity" .

<http://purl.org/biotop/biotop.owl#ValueRegion> a owl:Class ;
    rdfs:label "value region" ;
    ns1:definition "A value region is an abstract region in which (non quantitative) values of qualities are located." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocationOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Quality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#Quality> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocationOf> ],
        <http://purl.org/biotop/biotop.owl#Particular> .

<http://purl.org/biotop/biotop.owl#Action> a owl:Class ;
    rdfs:label "action" ;
    ns1:definition "An action is a processual entity that that is promoted by an agent, having a clear role distinction between agent and patient" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasDuration> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TimeInterval> ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Process> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasAgent> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Particular> ] ) ] .

<http://purl.org/biotop/biotop.owl#Affecting> a owl:Class ;
    rdfs:label "affecting" ;
    ns1:definition "Producing a direct effect on" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#Action> .

<http://purl.org/biotop/biotop.owl#CellularComponent> a owl:Class ;
    rdfs:label "cellular component" ;
    ns1:definition "Components which only can be formed inside living cells but which may survive their host cell." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#originatesFrom> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Cell> ],
        <http://purl.org/biotop/biotop.owl#StructuredBiologicalCompoundByGranularityPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#OrganismPart>,
        <http://purl.org/biotop/biotop.owl#Syncytium> .

<http://purl.org/biotop/biotop.owl#Human> a owl:Class ;
    rdfs:label "human" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#TaxonQuality> [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SpeciesHomoSapiensValueRegion> ] [ a owl:Restriction ;
                                owl:allValuesFrom <http://purl.org/biotop/biotop.owl#SpeciesHomoSapiensValueRegion> ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ] ) ] ],
        <http://purl.org/biotop/biotop.owl#Primate> .

<http://purl.org/biotop/biotop.owl#SubmolecularGroup> a owl:Class ;
    rdfs:label "submolecular group" ;
    rdfs:comment "A submolecular group or moiety is a group of covalently bound atoms that occurs only as part of a molecule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#componentPartOf> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:complementOf <http://purl.org/biotop/biotop.owl#OligoOrPolymer> ] ],
        [ a owl:Class ;
            owl:complementOf <http://purl.org/biotop/biotop.owl#EntireMolecularEntity> ],
        [ a owl:Class ;
            owl:complementOf <http://purl.org/biotop/biotop.owl#Atom> ],
        <http://purl.org/biotop/biotop.owl#MolecularEntityByGranularityPartition> .

<http://purl.org/biotop/biotop.owl#hasProcessQuality> a owl:ObjectProperty ;
    rdfs:label "has process quality" ;
    ns1:definition "processQualityOf (abstract: hasProcessQuality) links a quality that further characterizes a process to this process. Process qualities are asserted where the process cannot sufficiently be described by the qualities of its participants only. \\n\\nExample: The process of heart beating has the process quality heart rate." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#ProcessQuality> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#processQualityOf> .

<http://purl.org/biotop/biotop.owl#originatesFrom> a owl:ObjectProperty ;
    rdfs:label "originates from" ;
    ns1:definition "originatesFrom relates two material objects one of which originates from the other in a very broad sense. \\n\\nIt includes derivation (in the OBO RO sense), actual actual parts (provided they were always parts), as well as original (historical) parts.\\n\\nExamples: see Subrelations" ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#spatiallyRelatedTo> .

<http://purl.org/biotop/biotop.owl#TaxonValueRegion> a owl:Class ;
    rdfs:label "taxon value region" ;
    ns1:definition "abstract region in which the values of biological taxa are located (cf. Schulz et.al ISMB 2008). Biological taxa can be ascribed not only to organisms but also to ogranism parts, derivates, as well as populations.\\n\\n" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocationOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TaxonQuality> ],
        <http://purl.org/biotop/biotop.owl#ValueRegion> .

<http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> a owl:ObjectProperty ;
    rdfs:label "abstractly related to" ;
    ns1:definition "Relation in which immaterial entities (information entities, roles, qualities) are involved. \\n\\nabstractlyRelatedTo is meant as an organizing parent. It should not be asserted." ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://purl.org/biotop/biotop.owl#Disposition> a owl:Class ;
    rdfs:label "disposition" ;
    ns1:definition "A disposition is a realizable entity. \\nIts manifestation is a process its bearer is involved in virtue of the bearer's physical make-up." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ],
        <http://purl.org/biotop/biotop.owl#Particular> .

<http://purl.org/biotop/biotop.owl#Cell> a owl:Class ;
    rdfs:label "cell" ;
    ns1:definition "Constituting unit of an organism. The boundary between cell, syncytium and subcellular fragments such as platelets is problematic. Hence no full definition possible." ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#StructuredBiologicalCompoundByGranularityPartition> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#CellularComponent>,
        <http://purl.org/biotop/biotop.owl#OrganismPart>,
        <http://purl.org/biotop/biotop.owl#Syncytium> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:complementOf <http://purl.org/biotop/biotop.owl#Syncytium> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CellMembrane> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasComponentPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CellularComponent> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Cytoplasm> ] ) ] .

<http://purl.org/biotop/biotop.owl#Particular> a owl:Class ;
    ns1:definition "From an universalist point of view most BioTop classes can be considered the extension of universals. \\n\\nHowever, BioTop does not claim that all of its classes are the extension of universals and is agnostic with regard to the existence of universals and the delineation between universals and non-universals.\\n" ;
    owl:priorVersion "particular entity" .

<http://purl.org/biotop/biotop.owl#properPhysicalPartOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "proper physical part of" ;
    ns1:definition "hasProperPhysicalPart (inverse: properPhysicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. \\nThis relation is irreflexive, i.e. a physical object cannot have itself as a physical proper part.\\n\\nNote that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"\\n\\nFor processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"\\n\\nExamples: my thumb is a proper physical part of my hand, this keyboard is a proper physical part of my computer." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#physicalPartOf> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> .

<http://purl.org/biotop/biotop.owl#Canonicity> a owl:Class ;
    rdfs:label "canonicity" ;
    ns1:definition "The condition of an entity (state, process, function, object) in terms of being well or ill-formed or behaving" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#CanonicityValueRegion> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#CanonicityValueRegion> ],
        <http://purl.org/biotop/biotop.owl#Quality> .

<http://purl.org/biotop/biotop.owl#hasAgent> a owl:ObjectProperty ;
    rdfs:label "has agent" ;
    ns1:definition "agentIn (inverse: hasAgent) relates a participant with a process, with the condition that this participant is causally active in the relevant process.\\nThis is the reason why agentIn is subsumed by the relation causedBy. \\n\\nExample: A physician is the agent in a opeeration process; a solvent is the agent in a solving process. " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#causedBy>,
        <http://purl.org/biotop/biotop.owl#hasParticipant> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#agentIn> .

<http://purl.org/biotop/biotop.owl#hasParticipant> a owl:ObjectProperty ;
    rdfs:label "has participant" ;
    ns1:definition "HasParticipant (inverse: participatesIn) relates a process with a non processual entity which plays some role in the process. Process participants may exist during the whole process, remain unchanged or undergo changes; they may come into being or get out of being during the process. \\n\\nProcess participation is distinguished from process location.\\n\\nExample: \\n\\nAn urea molecule which is excreted in a renal filtration process is participant of this process.\\n\\nA person who undergoes an operation is participant of this process." ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Process> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#processuallyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#participatesIn> .

<http://purl.org/biotop/biotop.owl#DEPRECATED> a owl:Class ;
    rdfs:comment "Place for currently non maintained classes. It should be assured that they are not being referred to by application ontologies that import BioTop" .

<http://purl.org/biotop/biotop.owl#Role> a owl:Class ;
    rdfs:label "role" ;
    ns1:definition "A role is a realizable entity the manifestation of which brings about some result or end that is not essential to its bearer in virtue of the kind of thing that it is, but that can be served or participated in by that kind of continuant entity in some kinds of natural, social or institutional\\ncontexts." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Particular> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Particular> ] ) ] .

<http://purl.org/biotop/biotop.owl#ObjectQuality> a owl:Class ;
    rdfs:label "object quality" ;
    ns1:definition "A quality that inheres in some material or immaterial physical object." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#ValueRegion> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ],
        <http://purl.org/biotop/biotop.owl#Quality> ;
    owl:disjointWith <http://purl.org/biotop/biotop.owl#ProcessQuality> .

<http://purl.org/biotop/biotop.owl#Population> a owl:Class ;
    rdfs:label "population" ;
    ns1:definition "Collection of Organisms of a defined taxon living in a given geographic area. In contrast to the \"official\" definition (\"same species\") this definition is broader and corresponds better to the use of the term in some contexts (e.g. \"mixed population of 2 species\")" ;
    rdfs:comment "all child classes of population are only meant as examples demonstrating how population classes can be postcoordinated" ;
    rdfs:subClassOf <http://purl.org/biotop/biotop.owl#PluralityOfOrganisms> .

<http://purl.org/biotop/biotop.owl#MonoMolecularEntity> a owl:Class ;
    rdfs:label "mono molecular entity" ;
    ns1:definition "A mono-molecular entity is a self connected compound of two atoms or more which exhibit at least one covalent bound. Molecular entities can be isolated molecules or parts of molecules (groups, residue). They may be electrically neutral or not.\\n\\nIn biological systems molecular entities generally occur in very high quantities. In text, references to chemicals are often ambiguous. When we state \"water has a molecular weight of 18\" we refer to single water molecules. However, saying that \"water has a density of 1kg/dm³\" under certain conditions then we make a statement about pluralities of water molecules each of which has water molecules as \"grains\"\\nOld name: molecular entity\\n\\nThe upper bound of monomolecular entities is shallow. Strictly even a diamond crystal would be a monomolecular entity. One argument against this idea is that a diamond crystal is still a diamond crystal if you take away some portions. \\nThis is not the case with a classical molecule. " ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#Atom> ],
        <http://purl.org/biotop/biotop.owl#MaterialEntityBySizePartition> .

<http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> a owl:Class ;
    rdfs:label "structured biological entity" ;
    ns1:definition "Corresponds to FMA anatomical structure but extends to any kind of orgnaism: Material anatomical entity which is generated by coordinated expression of the organism's own genes that guide its morphogenesis; has inherent 3D shape; its parts are connected and spatially related to one another in patterns determined by coordinated gene expression. Examples: heart, right ventricle, mitral valve, myocardium, endothelium, lymphocyte, fibroblast, thorax, cardiovascular system, hemoglobin, T cell receptor.\\nOld name: anatomical structure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TaxonQuality> ],
        <http://purl.org/biotop/biotop.owl#PolyMolecularCompositeEntity> .

<http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has proper physical part" ;
    ns1:definition "hasProperPhysicalPart (inverse: properPhysicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. \\nThis relation is irreflexive, i.e. a physical object cannot have itself as a physical proper part.\\n\\nNote that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"\\n\\nFor processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"\\n\\nExamples: my thumb is a proper physical part of my hand, this keyboard is a proper physical part of my computer." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasPhysicalPart> .

<http://purl.org/biotop/biotop.owl#TaxonQuality> a owl:Class ;
    rdfs:label "taxon quality" ;
    ns1:definition "The quality of one or more biological organisms, as well as of parts of organism of partaining to a biological taxon. [steschu20080127]" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#TaxonValueRegion> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#qualityLocated> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TaxonValueRegion> ],
        <http://purl.org/biotop/biotop.owl#ObjectQuality> .

<http://purl.org/biotop/biotop.owl#inheresIn> a owl:ObjectProperty ;
    rdfs:label "inheres in" ;
    ns1:definition "inheresIn (inverse: bearerOf) relates a quality, role, function, disposition, or information object with the physical entity it depends on.\\n\\n(Note that for processes there is a separate relation pair \"hasProcessQuality\" and \"processQualityOf\")\\n\\nExample: a color inheres in a paint, the ability to fly inheres in a bird, or a pdf file inheres in a USB stick." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Disposition> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Role> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasLocus> .

<http://purl.org/biotop/biotop.owl#LivingOrganism> a owl:Class ;
    rdfs:label "living organism" ;
    ns1:definition "Living complex biological system which functions as a stable whole. In contrast to colonial organisms their components generally cannot survive on their own. We conceive organisms in a material sense. Therefore we do not assume any ontological difference between a unicellular organism and the cell it is made of. \"Colonial Organism\" are not considered Organisms. We here include viruses into the category of organisms.\\n\\nOrganism in an inactive form which are not dead are considered living organisms.\\n\\nWhether a living organism coincides with its body or hasPart its body, is controversial. We use \"hasPhysicalPart\" for relating organism to body. Being reflexive, this would not be incompatible with a view in which a living organism is a body." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#participatesIn> ;
            owl:someValuesFrom <http://purl.org/biotop/biotop.owl#BiologicalLife> ],
        <http://purl.org/biotop/biotop.owl#StructuredBiologicalEntity> ;
    owl:priorVersion "organism" .

<http://purl.org/biotop/biotop.owl#InformationObject> a owl:Class ;
    rdfs:label "information object" ;
    ns1:definition "Piece of information (not necessarily human) , as it exists independently of any potential material carrier." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PhysicalMass> ] ] [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                                owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PhysicalVolume> ] ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#inheresIn> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ] ) ],
        <http://purl.org/biotop/biotop.owl#Particular> ;
    owl:priorVersion "information entity" .

<http://purl.org/biotop/biotop.owl#hasComponentPart> a owl:ObjectProperty ;
    rdfs:label "has component part" ;
    ns1:definition "The non-transitive relation hasComponentPart (inverse: componentPartOf) relates components with a compound. Components strictly partition the compound, and the compound is the mereological sum of its components. A loss of some component affects the integrity of the compound, and possibly the type it instantiates, e.g. a complete vs. a defective organism. \\n\\nThe choice of what is a component of a compound is somewhat arbitrary, because there are several ways to divide a whole into parts. Strictly spoken, this relation should refer to some partition.\\n\\nComponents should be - at least - partly bona fide parts. The use of this relation also requires the commitment to an underlying granularity level. So could we consider the codons (base triples) as the components of a DNA molecule but also the single nucleotides. Note that components of a compound may also be portions of matter.\\n\\nExamples: my liver is a component of my organism, a carboxy group is a component of some organic acid molecule." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ],
        <http://purl.org/biotop/biotop.owl#MaterialObject> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> .

<http://purl.org/biotop/biotop.owl#bearerOf> a owl:ObjectProperty ;
    rdfs:label "bearer of" ;
    ns1:definition "inheresIn (inverse: bearerOf) relates a quality, role, function, disposition, or information object with the physical entity it depends on.\\n\\n(Note that for processes there is a separate relation pair \"hasProcessQuality\" and \"processQualityOf\")\\n\\nExample: a color inheres in a paint, the ability to fly inheres in a bird, or a pdf file inheres in a USB stick." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#Disposition> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#ObjectQuality> <http://purl.org/biotop/biotop.owl#Role> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#locusOf> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#inheresIn> .

<http://purl.org/biotop/biotop.owl#Process> a owl:Class ;
    rdfs:label "process" ;
    ns1:definition "Process is in BioTop the generic subsumer of anything that \"occurs\". \\nProcesses can span across time and have temporal parts (i.e. there is no time in which all parts of a process are simultaneously present). \\n\\nA special kind of process is the event, which has no temporal extension. It can be regarded as Process Boundary (BFO).\\n\\n\\nProcesses have physical or informational entities as participants." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasDuration> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#TimeInterval> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasPointInTime> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PointInTime> ] ) ],
        <http://purl.org/biotop/biotop.owl#Particular> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Particular> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasParticipant> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#InformationObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ] ) ] ;
    owl:priorVersion "processual entity" .

<http://purl.org/biotop/biotop.owl#qualityLocated> a owl:ObjectProperty ;
    rdfs:label "quality located" ;
    ns1:definition "qualityLocated (inverse: qualityLocationOf) relates a quality with an abstract value region. The underlying idea, borrowed from the DOLCE ontology, is that the attribute / value distinction - as ubiquitous in information systems - should at least be optionally expressible in ontologies. \\nValue regions are abstract regions, in which qualitative just as quantitative \"values\" are located. Like in topographic regions, these entities can overlap or be disjoint.\\n\\nExample: \"Color\" as quality may be refined as \"Red Color\". It can be fully defined in by \"quality located some RedColorRegion\"   " ;
    rdfs:domain <http://purl.org/biotop/biotop.owl#Quality> ;
    rdfs:range <http://purl.org/biotop/biotop.owl#ValueRegion> ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#abstractlyRelatedTo> ;
    owl:inverseOf <http://purl.org/biotop/biotop.owl#qualityLocationOf> .

<http://purl.org/biotop/biotop.owl#hasGranularPart> a owl:ObjectProperty ;
    rdfs:label "has granular part" ;
    ns1:definition "hasGranularPart (inverse: granularPartOf) relate  Pluralities with their constituents. The constituents are of the same sort. \\n\\nGenerally pluralities have a high number of grains. The loss of a grain has no effect on the sortality of the identity of the plurality.\\n\\nExample: A cow is a granular part of a herd of cows. A water molecule is a granular part of some amount of water" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#ImmaterialObject> <http://purl.org/biotop/biotop.owl#MaterialObject> ) ] ;
    rdfs:subPropertyOf <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> .

<http://purl.org/biotop/biotop.owl#ImmaterialObject> a owl:Class ;
    rdfs:label "immaterial object" ;
    ns1:definition "Physical spaces that have a threedimensional spatial dimension but no mass.\\nOld name: immaterial anatomical entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/biotop/biotop.owl#ImmaterialObject> ;
            owl:onProperty <http://purl.org/biotop/biotop.owl#hasPhysicalPart> ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                    owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PhysicalMass> ] ],
        <http://purl.org/biotop/biotop.owl#Particular> ;
    owl:priorVersion "immaterial physical entity" .

<http://purl.org/biotop/biotop.owl#MaterialObject> a owl:Class ;
    rdfs:label "material object" ;
    ns1:definition "A material object that has exactly one mass and one volume at a time.  Material objects may have Immaterial nonphysical entities as parts (e.g. Heart and Heart Ventricle). " ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( <http://purl.org/biotop/biotop.owl#SubatomicParticle> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#hasProperPhysicalPart> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#SubatomicParticle> ] ) ],
        <http://purl.org/biotop/biotop.owl#Particular> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/biotop/biotop.owl#Particular> [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PhysicalMass> ] [ a owl:Restriction ;
                        owl:onProperty <http://purl.org/biotop/biotop.owl#bearerOf> ;
                        owl:someValuesFrom <http://purl.org/biotop/biotop.owl#PhysicalVolume> ] ) ] ;
    owl:priorVersion "material entity" .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/biotop/biotop.owl#ImmaterialThreeDimensionalPhysicalEntity> <http://purl.org/biotop/biotop.owl#OneDimensionalPhysicalEntity> <http://purl.org/biotop/biotop.owl#TwoDimensionalPhysicalEntity> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/biotop/biotop.owl#ImmunologicRole> <http://purl.org/biotop/biotop.owl#SignallingRole> <http://purl.org/biotop/biotop.owl#VitaminRole> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/biotop/biotop.owl#Alga> <http://purl.org/biotop/biotop.owl#AnimalIncludingHuman> <http://purl.org/biotop/biotop.owl#Fungus> <http://purl.org/biotop/biotop.owl#Plant> <http://purl.org/biotop/biotop.owl#Protist> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/biotop/biotop.owl#GroupInteraction> <http://purl.org/biotop/biotop.owl#OrganismInteraction> <http://purl.org/biotop/biotop.owl#SubstanceInteraction> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/biotop/biotop.owl#KingdomAnimaliaValueRegion> <http://purl.org/biotop/biotop.owl#KingdomArchaeaValueRegion> <http://purl.org/biotop/biotop.owl#KingdomBacteriaValueRegion> <http://purl.org/biotop/biotop.owl#KingdomChromistaValueRegion> <http://purl.org/biotop/biotop.owl#KingdomFungiValueRegion> <http://purl.org/biotop/biotop.owl#KingdomPlantaeValueRegion> <http://purl.org/biotop/biotop.owl#KingdomProtozoaValueRegion> <http://purl.org/biotop/biotop.owl#KingdomVirusesValueRegion> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/biotop/biotop.owl#BodySystem> <http://purl.org/biotop/biotop.owl#Organ> <http://purl.org/biotop/biotop.owl#OrganPart> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/biotop/biotop.owl#CellMembrane> <http://purl.org/biotop/biotop.owl#CellNucleus> <http://purl.org/biotop/biotop.owl#Cytoplasm> <http://purl.org/biotop/biotop.owl#Genome> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/biotop/biotop.owl#EducatorRole> <http://purl.org/biotop/biotop.owl#HealthProfessionalRole> <http://purl.org/biotop/biotop.owl#ResearcherRole> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/biotop/biotop.owl#FindingRole> <http://purl.org/biotop/biotop.owl#FoodRole> <http://purl.org/biotop/biotop.owl#PoisonRole> <http://purl.org/biotop/biotop.owl#PreventiveRole> <http://purl.org/biotop/biotop.owl#SubjectOfCareRole> <http://purl.org/biotop/biotop.owl#TherapeuticRole> ) .

[] a owl:AllDisjointClasses ;
