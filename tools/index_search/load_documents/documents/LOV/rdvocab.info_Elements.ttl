<http://rdvocab.info/Elements/PublicationStatementEncodingScheme> a owl:Class ;
    rdfs:label "Publication Statement Encoding Scheme"@en ;
    ns1:name "PublicationStatementEncodingScheme"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
