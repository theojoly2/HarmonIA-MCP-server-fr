<http://rdvocab.info/Elements/verticalScaleCartographicContentExpression> a rdf:Property ;
    rdfs:label "Vertical scale of cartographic content (Expression)"@en ;
    ns1:name "verticalScaleCartographicContentExpression"@en ;
