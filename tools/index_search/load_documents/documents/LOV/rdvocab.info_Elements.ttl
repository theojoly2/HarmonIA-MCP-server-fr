    ns1:name "titleProper"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/Elements/title> ;
    skos:definition "The chief name of a resource (i.e., the title normally used when citing the resource)."@en .

<http://rdvocab.info/Elements/titleProperManifestation> a rdf:Property ;
    rdfs:label "Title proper (Manifestation)"@en ;
    ns1:name "titleProperManifestation"@en ;
