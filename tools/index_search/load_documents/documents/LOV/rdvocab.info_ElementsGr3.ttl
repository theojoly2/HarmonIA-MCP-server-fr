@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://metadataregistry.org/uri/profile/RegAp/> .
@prefix onto: <http://rdvocab.info/ElementsGr3> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://rdvocab.info/ElementsGr3/cataloguersNote> a rdf:Property ;
    rdfs:label "Cataloguer's note"@en ;
    ns1:name "cataloguersNote"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Subject> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "An annotation that might be helpful to those using or revising the authorized access point representing an entity or relationship data, or creating an authorized access point representing a related entity."@en .

<http://rdvocab.info/ElementsGr3/identifierForTheConcept> a rdf:Property ;
    rdfs:label "Identifier for the concept"@en ;
    ns1:name "identifierForTheConcept"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Concept> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/ElementsGr3/identifierForTheEvent> a rdf:Property ;
    rdfs:label "Identifier for the event"@en ;
    ns1:name "identifierForTheEvent"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Event> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/ElementsGr3/identifierForTheObject> a rdf:Property ;
    rdfs:label "Identifier for the object"@en ;
    ns1:name "identifierForTheObject"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Object> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/ElementsGr3/identifierForThePlace> a rdf:Property ;
    rdfs:label "Identifier for the place"@en ;
    ns1:name "identifierForThePlace"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Place> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/ElementsGr3/preferredNameForThePlace> a rdf:Property ;
    rdfs:label "Preferred name for the place"@en ;
    ns1:name "preferredNameForThePlace"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Place> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "The name or form of name chosen to represent a place when a place name is used as the conventional name of a government, etc., or as an addition to the name of a corporate body, a conference, etc., or a work, or when recording a place associated with a person, family, or corporate body."@en .

<http://rdvocab.info/ElementsGr3/sourceConsulted> a rdf:Property ;
    rdfs:label "Source consulted"@en ;
    ns1:name "sourceConsulted"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Subject> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A resource used in determining the name, title, or other identifying attributes of an entity, or in determining the relationship between entities."@en .

<http://rdvocab.info/ElementsGr3/statusOfIdentification> a rdf:Property ;
    rdfs:label "Status of identification"@en ;
    ns1:name "statusOfIdentification"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Subject> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A resource used in determining the name, title, or other identifying attributes of an entity, or in determining the relationship between entities."@en .

<http://rdvocab.info/ElementsGr3/nameOfThePlace> a rdf:Property ;
    rdfs:label "Name of the place"@en ;
    ns1:hasSubproperty <http://rdvocab.info/ElementsGr3/variantNameForThePlace> ;
    ns1:name "nameOfThePlace"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Place> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A word, character, or group of words and/or characters by which a place is known."@en .

<http://rdvocab.info/ElementsGr3/preferredNameForTheEvent> a rdf:Property ;
    rdfs:label "Preferred name for the event"@en ;
    ns1:name "preferredNameForTheEvent"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Event> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/ElementsGr3/nameOfTheEvent> .

<http://rdvocab.info/ElementsGr3/preferredNameForTheObject> a rdf:Property ;
    rdfs:label "Preferred name for the object"@en ;
    ns1:name "preferredNameForTheObject"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Object> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/ElementsGr3/nameOfTheObject> .

<http://rdvocab.info/ElementsGr3/preferredTermForTheConcept> a rdf:Property ;
    rdfs:label "Preferred term for the concept"@en ;
    ns1:name "preferredTermForTheConcept"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Concept> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/ElementsGr3/termForTheConcept> .

<http://rdvocab.info/ElementsGr3/variantNameForTheEvent> a rdf:Property ;
    rdfs:label "Variant name for the event"@en ;
    ns1:name "variantNameForTheEvent"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Event> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/ElementsGr3/nameOfTheEvent> .

<http://rdvocab.info/ElementsGr3/variantNameForTheObject> a rdf:Property ;
    rdfs:label "Variant name for the object"@en ;
    ns1:name "variantNameForTheObject"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Object> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/ElementsGr3/nameOfTheObject> .

<http://rdvocab.info/ElementsGr3/variantNameForThePlace> a rdf:Property ;
    rdfs:label "Variant name for the place"@en ;
    ns1:name "variantNameForThePlace"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Place> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/ElementsGr3/nameOfThePlace> .

<http://rdvocab.info/ElementsGr3/variantTermForTheConcept> a rdf:Property ;
    rdfs:label "Variant term for the concept"@en ;
    ns1:name "variantTermForTheConcept"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Concept> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/ElementsGr3/termForTheConcept> .

<http://rdvocab.info/ElementsGr3/nameOfTheEvent> a rdf:Property ;
    rdfs:label "Name of the event"@en ;
    ns1:hasSubproperty <http://rdvocab.info/ElementsGr3/preferredNameForTheEvent>,
        <http://rdvocab.info/ElementsGr3/variantNameForTheEvent> ;
    ns1:name "nameOfTheEvent"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Event> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/ElementsGr3/nameOfTheObject> a rdf:Property ;
    rdfs:label "Name of the object"@en ;
    ns1:hasSubproperty <http://rdvocab.info/ElementsGr3/preferredNameForTheObject>,
        <http://rdvocab.info/ElementsGr3/variantNameForTheObject> ;
    ns1:name "nameOfTheObject"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Object> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/ElementsGr3/termForTheConcept> a rdf:Property ;
    rdfs:label "Term for the concept"@en ;
    ns1:hasSubproperty <http://rdvocab.info/ElementsGr3/preferredTermForTheConcept>,
        <http://rdvocab.info/ElementsGr3/variantTermForTheConcept> ;
    ns1:name "termForTheConcept"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Concept> ;
    rdfs:isDefinedBy onto: .

<http://metadataregistry.org/uri/RegStatus/1002> a skos:Concept ;
    skos:prefLabel "New-Proposed"@en .

onto: dc:title "RDA Group 3 Elements"@en .

