    rdfs:domain <http://www.w3.org/2006/vcard/ns#Location> ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#postal-code> a owl:DatatypeProperty ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Location> ;
    rdfs:range xsd:int .

<http://www.w3.org/2006/vcard/ns#region> a owl:DatatypeProperty ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Location> ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#street-address> a owl:DatatypeProperty ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Location> ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#tel> a owl:DatatypeProperty ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Location> ;
    rdfs:range xsd:int .

org:changedBy a owl:ObjectProperty ;
    rdfs:domain org:Organization ;
    rdfs:range org:ChangeEvent .

org:originalOrganization a owl:ObjectProperty ;
    rdfs:domain org:ChangeEvent ;
    rdfs:range org:Organization .

org:resultedFrom a owl:ObjectProperty ;
    rdfs:domain org:Organization ;
    rdfs:range org:ChangeEvent .

org:resultingOrganization a owl:ObjectProperty ;
    rdfs:domain org:ChangeEvent ;
    rdfs:range org:Organization .

org:subOrganizationOf a owl:ObjectProperty ;
    rdfs:domain org:Organization ;
    rdfs:range org:Organization .

foaf:homepage a owl:DatatypeProperty ;
    rdfs:label "Página web"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( org:Organization foaf:Person ) ] ;
    rdfs:range xsd:string .

foaf:mbox a owl:DatatypeProperty ;
    rdfs:label "Correo electrónico"^^xsd:string ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

foaf:phone a owl:DatatypeProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

<https://www.w3.org/TR/vocab-dcat-2/distribution> a owl:ObjectProperty ;
    rdfs:comment "A specific representation of a dataset."@en ;
    rdfs:domain <https://www.w3.org/TR/vocab-dcat-2/Dataset> .

<https://www.w3.org/TR/vocab-dcat-2/landingPage> a owl:ObjectProperty ;
    rdfs:comment "A Web page that can be navigated to in a Web browser to gain access to the catalog"^^xsd:string ;
    rdfs:domain <https://www.w3.org/TR/vocab-dcat-2/Dataset> .

<http://data.europa.eu/eli/ontology/Agent> a owl:Class ;
    rdfs:label "ELI Agent"@en ;
    rdfs:comment "Organization that generates a law"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:organization ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:organization ],
        owl:Thing .

<http://data.europa.eu/eli/ontology/date_applicability> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://data.europa.eu/eli/ontology/LegalResource> <http://schema.org/CreativeWork> ) ] ;
    rdfs:range xsd:dateTime .

<http://data.tbfy.eu/ontology/ocds#Value> a owl:Class .

dc:description a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://vocab.gtfs.org/terms#Trip> org:Organization <https://www.w3.org/TR/vocab-dcat-2/Dataset> ) ] ;
    rdfs:range xsd:string .

qb:DimensionProperty a owl:Class ;
    rdfs:label "Dimension property"@en ;
    rdfs:comment "It represents the dimensions of the cube"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty qb:concept ],
        qb:ComponentProperty .

qb:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "A single observation in the cube, may have one or more associated measured values"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty qb:dataSet ],
        owl:Thing .

<http://schema.org/image> a owl:DatatypeProperty ;
    rdfs:label "Imagen"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://schema.org/CreativeWork> <http://schema.org/Event> ) ] ;
    rdfs:range xsd:string .

prov:SoftwareAgent a owl:Class ;
    rdfs:label "Software Agent"@en ;
    rdfs:comment "A software agent is running software that provides data to the graph"@en .

<http://data.europa.eu/eli/ontology/ResourceType> a owl:Class ;
    rdfs:label "ELI Resource type"@en ;
    rdfs:comment "Represents the law type"@en .

<http://data.europa.eu/eli/ontology/date_publication> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://data.europa.eu/eli/ontology/LegalResource> <http://schema.org/CreativeWork> ) ] ;
    rdfs:range xsd:dateTime .

<http://data.europa.eu/eli/ontology/first_date_entry_in__force> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://data.europa.eu/eli/ontology/LegalResource> <http://schema.org/CreativeWork> ) ] ;
    rdfs:range xsd:dateTime .

qb:DataStructureDefinition a owl:Class ;
    rdfs:label "Data Structure Definition"@en ;
    rdfs:comment "Defines the structure of a DataSet"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty qb:component ],
        owl:Thing .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://vocab.gtfs.org/terms#Stop> <http://www.w3.org/2006/vcard/ns#Location> ) ] ;
    rdfs:range xsd:float .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://vocab.gtfs.org/terms#Stop> <http://www.w3.org/2006/vcard/ns#Location> ) ] ;
    rdfs:range xsd:float .

skos:Collection a owl:Class .

time:TemporalEntity a owl:Class ;
    rdfs:label "Temporal entity"@en ;
    rdfs:comment "A temporal interval or instant"@en .

prov:Activity a owl:Class ;
    rdfs:label "PROV Activity"@en ;
    rdfs:comment "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities"@en .

dc:date a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://vocab.gtfs.org/terms#Trip> org:Organization sosa:Featureofinterest ) ] ;
    rdfs:range xsd:dateTime .

qb:DataSet a owl:Class ;
    rdfs:label "Cube Dataset"@en ;
    rdfs:comment "Represents a collection of observations, conforming to some common dimensional structure"@en ;
    rdfs:isDefinedBy <http://opendata.aragon.es/def/ei2av2#Concept> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        owl:Thing .

<http://schema.org/abstract> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://schema.org/CreativeWork> <http://schema.org/ItemList> <http://schema.org/ListItem> ) ] ;
    rdfs:range xsd:string .

org:Role a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:comment "Denotes a role that a Person or other Agent can take in an organization. Instances of this class describe the abstract role; to denote a specific instance of a person playing that role in a specific organization use an instance of `org:Membership`. It is common for roles to be arranged in some taxonomic structure and we use SKOS to represent that"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        owl:Thing .

<http://data.tbfy.eu/ontology/ocds#Period> a owl:Class .

<http://schema.org/identifier> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://schema.org/CreativeWork> <http://schema.org/Event> <http://schema.org/ItemList> <http://schema.org/ListItem> ) ] ;
    rdfs:range xsd:string .

org:Site a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:siteAddress ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        owl:Thing .

<https://www.w3.org/TR/vocab-dcat-2/Dataset> a owl:Class ;
    rdfs:label "DCAT Dataset"@en ;
    rdfs:comment "A collection of data, published or curated by a single agent, and available for access or download in one or more representations (from CKAN)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://www.w3.org/TR/vocab-dcat-2/landingPage> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://www.w3.org/TR/vocab-dcat-2/distribution> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:description ],
        owl:Thing .

qb:ComponentProperty a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "Indicates a property on a Dataset Cube. rdfs:Range indicates the object type. E.g.: org:organization"@en .

<http://vocab.gtfs.org/terms#StopTime> a owl:Class ;
    rdfs:label "Stop time"@en ;
    rdfs:comment "Describes a stop time as part of a trip"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://vocab.gtfs.org/terms#arrivalTime> ],
        owl:Thing .

<http://vocab.gtfs.org/terms#Trip> a owl:Class ;
    rdfs:label "Trip"@en ;
    rdfs:comment "A collection of gtfs:StopTimes followed by a transit vehicle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:date ],
        owl:Thing .

sosa:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://opendata.aragon.es/def/ei2av2#comment> ],
        owl:Thing .

<http://data.tbfy.eu/ontology/ocds#Tender> a owl:Class ;
    rdfs:label "Tender"@en ;
    rdfs:comment "Model for public tender"@en .

qb:ComponentSpecification a owl:Class ;
    rdfs:label "Component specification"@en ;
    rdfs:comment "Used to define properties of a component (attribute, dimension etc) which are specific to its usage in a DSD"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty qb:measure ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty qb:dimension ],
        owl:Thing .

<http://vocab.gtfs.org/terms#Agency> a owl:Class ;
    rdfs:label "Agency"@en ;
    rdfs:comment "An agency operates a certain schedule based transport mode"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:organization ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:organization ],
        owl:Thing .

<http://vocab.gtfs.org/terms#Route> a owl:Class ;
    rdfs:label "Route"@en ;
    rdfs:comment "It is a commercial route followed entirely or partly by gtfs:Trips"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://vocab.gtfs.org/terms#agency> ],
        owl:Thing .

org:ChangeEvent a owl:Class ;
    rdfs:label "Change Event"@en ;
    rdfs:comment "Represents an event which resulted in a major change to an organization such as a merger or complete restructuring. It is intended for situations where the resulting organization is sufficient distinct from the original organizations that it has a distinct identity and distinct URI. Extension vocabularies should define sub-classes of this to denote particular categories of event. The instant or interval at which the event occurred should be given by prov:startAtTime and prov:endedAtTime, a description should be given by dct:description"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:resultingOrganization ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:originalOrganization ],
        owl:Thing .

org:organization a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://data.europa.eu/eli/ontology/Agent> <http://data.tbfy.eu/ontology/ocds#Contract> <http://data.tbfy.eu/ontology/ocds#Tender> <http://schema.org/CreativeWork> <http://schema.org/ListItem> <http://vocab.gtfs.org/terms#Agency> ) ] ;
    rdfs:range org:Organization .

org:siteAddress a owl:ObjectProperty ;
    rdfs:label "Site address"@en ;
    rdfs:comment "Indicates an address for the site in a suitable encoding. Use of vCard (using the vcard vocabulary) is encouraged but the range is left open to allow other encodings to be used. The address may include email, telephone, and geo-location information and is not restricted to a physical address"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://schema.org/CreativeWork> <http://vocab.gtfs.org/terms#Stop> <http://www.w3.org/2006/vcard/ns#Location> org:Site sosa:Featureofinterest ) ] ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Location> .

sosa:Featureofinterest a owl:Class ;
    rdfs:label "Feature of Interest"@en ;
    rdfs:comment "The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:siteAddress ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:date ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:date ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:siteAddress ],
        owl:Thing .

<http://data.tbfy.eu/ontology/ocds#Contract> a owl:Class ;
    rdfs:label "Contract"@en ;
    rdfs:comment "It models the contract and its process"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:organization ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:organization ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        owl:Thing .

<http://schema.org/ItemList> a owl:Class ;
    rdfs:label "Item List"@en ;
    rdfs:comment "A list of items of any sort, sucha as the steps of an administrative process"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/abstract> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/abstract> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/identifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/previousItem> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/nextItem> ],
        owl:Thing .

<http://vocab.gtfs.org/terms#Stop> a owl:Class ;
    rdfs:label "Stop"@en ;
    rdfs:comment "A location where passengers board or disembark from a transit vehicle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#lat> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:siteAddress ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:siteAddress ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#lat> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#long> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#long> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        owl:Thing .

<http://schema.org/Event> a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "It models events such as holidays"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/location> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/eventSchedule> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/identifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/image> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/endDate> ],
        owl:Thing .

<http://schema.org/ListItem> a owl:Class ;
    rdfs:label "List item"@en ;
    rdfs:comment "An list item, e.g. a step in an administrative process"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/identifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/abstract> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty skos:concept ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/identifier> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/itemListElement> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://schema.org/abstract> ],
        owl:Thing .

foaf:Post a owl:Class ;
    rdfs:label "Post"@en ;
    rdfs:comment "Post with the beginning and ending dates"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:hasBeginning ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:hasEnd ],
        owl:Thing .

dc:identifier a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://vocab.gtfs.org/terms#Agency> <http://vocab.gtfs.org/terms#Route> <http://vocab.gtfs.org/terms#StopTime> <http://vocab.gtfs.org/terms#Trip> skos:Concept org:Organization org:Role org:Site sosa:Featureofinterest foaf:Person foaf:Post ) ] ;
    rdfs:range xsd:string .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "Used to classify entities, such as the organization types"@en .

foaf:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "The Person class represents people. Something is a Person if it is a person. We don't nitpic about whether they're alive, dead, real, or imaginary. The Person class is a sub-class of the Agent class, since all people are considered agents in FOAF"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:phone ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://purl.org/vocab/bio/0.1/biography> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:mbox ],
        owl:Thing .

<http://data.europa.eu/eli/ontology/LegalResource> a owl:Class ;
    rdfs:label "Legal resource"@en ;
    rdfs:comment "Laws modeled according the ELI ontology"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.europa.eu/eli/ontology/first_date_entry_in__force> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.europa.eu/eli/ontology/first_date_entry_in__force> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.europa.eu/eli/ontology/date_publication> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.europa.eu/eli/ontology/amends> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.europa.eu/eli/ontology/date_publication> ],
        [ a owl:Restriction ;
