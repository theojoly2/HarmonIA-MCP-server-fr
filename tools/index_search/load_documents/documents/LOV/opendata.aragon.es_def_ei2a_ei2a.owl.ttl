<http://data.tbfy.eu/ontology/ocds#contractId> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://data.tbfy.eu/ontology/ocds#Contract> <http://data.tbfy.eu/ontology/ocds#Tender> ) ] ;
    rdfs:range xsd:string .

<http://data.tbfy.eu/ontology/ocds#description> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://data.tbfy.eu/ontology/ocds#Contract> <http://data.tbfy.eu/ontology/ocds#Tender> ) ] ;
