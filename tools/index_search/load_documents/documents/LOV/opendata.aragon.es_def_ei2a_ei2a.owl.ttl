<http://data.tbfy.eu/ontology/ocds#hasContractValue> a owl:ObjectProperty ;
    rdfs:comment "Valor"^^xsd:string ;
    rdfs:domain <http://data.tbfy.eu/ontology/ocds#Contract> ;
