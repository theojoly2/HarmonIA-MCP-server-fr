            owl:onProperty <http://data.europa.eu/eli/ontology/amended_by> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.europa.eu/eli/ontology/number> ],
        owl:Thing .

dc:title a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://data.tbfy.eu/ontology/ocds#Contract> <http://data.tbfy.eu/ontology/ocds#Tender> qb:DataSet <http://vocab.gtfs.org/terms#Agency> <http://vocab.gtfs.org/terms#Route> <http://vocab.gtfs.org/terms#Stop> org:Organization org:Role org:Site sosa:Featureofinterest <https://www.w3.org/TR/vocab-dcat-2/Dataset> ) ] ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#Location> a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "An object representing a named geographical place"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2006/vcard/ns#fn> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2006/vcard/ns#postal-code> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2006/vcard/ns#region> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2006/vcard/ns#locality> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2006/vcard/ns#email> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#lat> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2006/vcard/ns#tel> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:siteAddress ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#long> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2006/vcard/ns#street-address> ],
        owl:Thing .

org:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organizations are often decomposable into hierarchical structures"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://opendata.aragon.es/def/ei2av2#order> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:subOrganizationOf ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:changedBy ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:title ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:date ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:homepage ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://opendata.aragon.es/def/ei2av2#legislature> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dc:description ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org:resultedFrom ],
        owl:Thing .

<http://schema.org/CreativeWork> a owl:Class ;
