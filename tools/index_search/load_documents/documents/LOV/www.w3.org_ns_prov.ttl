@prefix onto: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdfs:comment a owl:AnnotationProperty ;
    rdfs:comment ""@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty ;
    rdfs:comment ""@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> .

owl:versionInfo a owl:AnnotationProperty .

onto:Accept a owl:Class ;
    rdfs:label "Accept"@en ;
    rdfs:subClassOf onto:Activity ;
    onto:definition "Activity that identifies the acceptance of a resource (e.g., an article in a conference)"@en .

onto:Copyright a owl:Class ;
    rdfs:label "Copyright"@en ;
    rdfs:subClassOf onto:Activity ;
    onto:definition "Activity that identifies the Copyrighting activity associated to a resource."@en .

onto:Create a owl:Class ;
    rdfs:label "Create"@en ;
    rdfs:subClassOf onto:Contribute ;
    onto:definition "Activity that identifies the creation of a resource"@en .

onto:Creator a owl:Class ;
    rdfs:label "Creator"@en ;
    rdfs:subClassOf onto:Contributor ;
    onto:definition "Role with the function of creating a resource. The Agent assigned to this role is associated with a Create Activity"@en .

onto:DirectQueryService a owl:Class ;
    rdfs:label "ProvenanceService" ;
    rdfs:comment "Type for a generic provenance query service. Mainly for use in RDF provenance query service descriptions, to facilitate discovery in linked data environments." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:SoftwareAgent ;
    onto:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-query-service-discovery"^^xsd:anyURI ;
    onto:category "access-and-query" .

onto:EmptyDictionary a owl:Class ;
    rdfs:label "Empty Dictionary" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Dictionary,
        onto:EmptyCollection ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "An empty dictionary (i.e. has no members)." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-conceptual-definition"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary"^^xsd:anyURI .

onto:Modify a owl:Class ;
    rdfs:label "Modify"@en ;
    rdfs:subClassOf onto:Activity ;
    onto:definition "Activity that identifies the modification of a resource. "@en .

onto:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:Agent ;
    onto:category "expanded" ;
    onto:component "agents-responsibility" ;
    onto:definition "An organization is a social or legal institution such as a company, society, etc." ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

onto:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:Agent ;
    onto:category "expanded" ;
    onto:component "agents-responsibility" ;
    onto:definition "Person agents are people."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

onto:Publish a owl:Class ;
    rdfs:label "Publish"@en ;
    rdfs:subClassOf onto:Activity ;
    onto:definition "Activity that identifies the publication of a resource"@en .

onto:Publisher a owl:Class ;
    rdfs:label "Publisher"@en ;
    rdfs:subClassOf onto:Role ;
    onto:definition "Role with the function of publishing a resource. The Agent assigned to this role is associated with a Publish Activity"@en .

onto:Replace a owl:Class ;
    rdfs:label "Replace"@en ;
    rdfs:subClassOf onto:Activity ;
    onto:definition "Activity that identifies the replacement of a resource."@en .

onto:RightsAssignment a owl:Class ;
    rdfs:label "RightsAssignment"@en ;
    rdfs:subClassOf onto:Activity ;
    onto:definition "Activity that identifies the rights assignment of a resource."@en .

onto:RightsHolder a owl:Class ;
    rdfs:label "RightsHolder"@en ;
    rdfs:subClassOf onto:Role ;
    onto:definition "Role with the function of owning or managing rights over a resource. The Agent assigned to this role is associated with a RightsAssignment Activity"@en .

onto:ServiceDescription a owl:Class ;
    rdfs:label "ServiceDescription" ;
    rdfs:comment "Type for a generic provenance query service. Mainly for use in RDF provenance query service descriptions, to facilitate discovery in linked data environments." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:SoftwareAgent ;
    onto:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-query-service-discovery"^^xsd:anyURI ;
    onto:category "access-and-query" .

onto:Submit a owl:Class ;
    rdfs:label "Submit"@en ;
    rdfs:subClassOf onto:Activity ;
    onto:definition "Activity that identifies the issuance (e.g., publication) of a resource. "@en .

onto:activityOfInfluence rdfs:label "activityOfInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:activity .

onto:agentOfInfluence rdfs:label "agentOfInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:agent .

onto:aq a owl:AnnotationProperty ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:asInBundle a owl:ObjectProperty ;
    rdfs:label "asInBundle" ;
    rdfs:comment "prov:asInBundle is used to specify which bundle the general entity of a prov:mentionOf property is described.\\n\\nWhen :x prov:mentionOf :y and :y is described in Bundle :b, the triple :x prov:asInBundle :b is also asserted to cite the Bundle in which :y was described."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-links#> ;
    rdfs:range onto:Bundle ;
    onto:inverse "contextOf" ;
    onto:sharesDefinitionWith onto:mentionOf .

onto:category a owl:AnnotationProperty ;
    rdfs:comment "Classify prov-o terms into three categories, including 'starting-point', 'qualifed', and 'extended'. This classification is used by the prov-o html document to gently introduce prov-o terms to its users. "@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> .

onto:component a owl:AnnotationProperty ;
    rdfs:comment "Classify prov-o terms into six components according to prov-dm, including 'agents-responsibility', 'alternate', 'annotations', 'collections', 'derivations', and 'entities-activities'. This classification is used so that readers of prov-o specification can find its correspondence with the prov-dm specification."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> .

onto:constraints a owl:AnnotationProperty ;
    rdfs:comment "A reference to the principal section of the PROV-CONSTRAINTS document that describes this concept."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:contributed rdfs:label "contributed" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:wasAttributedTo .

onto:describesService a owl:ObjectProperty ;
    rdfs:label "describesService" ;
    rdfs:comment "relates a generic provenance query service resource (type prov:ServiceDescription) to a specific query service description (e.g. a prov:DirectQueryService or a sd:Service)."@en ;
    rdfs:isDefinedBy onto: ;
    onto:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/rovenance-query-service-description"^^xsd:anyURI ;
    onto:category "access-and-query" ;
    onto:inverse "serviceDescribedBy" .

onto:dm a owl:AnnotationProperty ;
    rdfs:comment "A reference to the principal section of the PROV-DM document that describes this concept."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:editorialNote a owl:AnnotationProperty ;
    rdfs:comment "A note by the OWL development team about how this term expresses the PROV-DM concept, or how it should be used in context of semantic web or linked data."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> .

onto:editorsDefinition a owl:AnnotationProperty ;
    rdfs:comment "When the prov-o term does not have a definition drawn from prov-dm, and the prov-o editor provides one."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf onto:definition .

onto:ended rdfs:label "ended" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:wasEndedBy .

onto:entityOfInfluence rdfs:label "entityOfInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:entity .

onto:generalizationOf rdfs:label "generalizationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:specializationOf .

onto:generatedAsDerivation rdfs:label "generatedAsDerivation" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:hadGeneration .

onto:hadDelegate rdfs:label "hadDelegate" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:actedOnBehalfOf .

onto:hadDerivation rdfs:label "hadDerivation" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:wasDerivedFrom .

onto:hadDictionaryMember a owl:ObjectProperty ;
    rdfs:label "hadDictionaryMember" ;
    rdfs:domain onto:Dictionary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:KeyEntityPair ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "Describes the key-entity pair that was member of a prov:Dictionary. A dictionary can have multiple members." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

onto:hadInfluence rdfs:label "hadInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:influencer .

onto:hadRevision rdfs:label "hadRevision" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:wasRevisionOf .

onto:has_anchor a owl:ObjectProperty ;
    rdfs:label "has_anchor" ;
    rdfs:comment "Indicates anchor URI for a potentially dynamic resource instance."@en ;
    rdfs:isDefinedBy onto: ;
    onto:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#resource-represented-as-html"^^xsd:anyURI ;
    onto:category "access-and-query" ;
    onto:inverse "anchorOf" .

onto:has_provenance a owl:ObjectProperty ;
    rdfs:label "has_provenance" ;
    rdfs:comment "Indicates a provenance-URI for a resource; the resource identified by this property presents a provenance record about its subject or anchor resource."@en ;
    rdfs:isDefinedBy onto: ;
    onto:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#resource-represented-as-html"^^xsd:anyURI ;
    onto:category "access-and-query" ;
    onto:inverse "provenanceOf" .

onto:has_query_service a owl:ObjectProperty ;
    rdfs:label "hasProvenanceService" ;
    rdfs:comment "Indicates a provenance query service that can access provenance related to its subject or anchor resource."@en ;
    rdfs:isDefinedBy onto: ;
    onto:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/"^^xsd:anyURI ;
    onto:category "access-and-query" ;
    onto:inverse "provenanceQueryServiceOf" .

onto:informed rdfs:label "informed" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:wasInformedBy .

onto:inverse a owl:AnnotationProperty ;
    rdfs:comment "PROV-O does not define all property inverses. The directionalities defined in PROV-O should be given preference over those not defined. However, if users wish to name the inverse of a PROV-O property, the local name given by prov:inverse should be used."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:seeAlso <http://www.w3.org/TR/prov-o/#names-of-inverse-properties> .

onto:locationOf rdfs:label "locationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:atLocation .

onto:n a owl:AnnotationProperty ;
    rdfs:comment "A reference to the principal section of the PROV-DM document that describes this concept."@en,
        "A reference to the principal section of the PROV-M document that describes this concept."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:order a owl:AnnotationProperty ;
    rdfs:comment "The position that this OWL term should be listed within documentation. The scope of the documentation (e.g., among all terms, among terms within a prov:category, among properties applying to a particular class, etc.) is unspecified."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

onto:pingback a owl:ObjectProperty ;
    rdfs:label "provenance pingback" ;
    rdfs:comment "Relates a resource to a provenance pingback service that may receive additional provenance links about the resource."@en ;
    rdfs:isDefinedBy onto: ;
    onto:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-pingback"^^xsd:anyURI ;
    onto:category "access-and-query" .

onto:provenanceUriTemplate a owl:DatatypeProperty ;
    rdfs:label "provenanceUriTemplate" ;
    rdfs:comment "Relates a provenance service to a URI template string for constructing provenance-URIs."@en ;
    rdfs:isDefinedBy onto: ;
    onto:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/"^^xsd:anyURI ;
    onto:category "access-and-query" .

onto:qualifiedAssociationOf rdfs:label "qualifiedAssociationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedAssociation .

onto:qualifiedAttributionOf rdfs:label "qualifiedAttributionOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedAttribution .

onto:qualifiedCommunicationOf rdfs:label "qualifiedCommunicationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedCommunication .

onto:qualifiedDelegationOf rdfs:label "qualifiedDelegationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedDelegation .

onto:qualifiedDerivationOf rdfs:label "qualifiedDerivationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedDerivation .

onto:qualifiedEndOf rdfs:label "qualifiedEndOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedEnd .

onto:qualifiedForm a owl:AnnotationProperty ;
    rdfs:comment "This annotation property links a subproperty of prov:wasInfluencedBy with the subclass of prov:Influence and the qualifying property that are used to qualify it. \\n\\nExample annotation:\\n\\n    prov:wasGeneratedBy prov:qualifiedForm prov:qualifiedGeneration, prov:Generation .\\n\\nThen this unqualified assertion:\\n\\n    :entity1 prov:wasGeneratedBy :activity1 .\\n\\ncan be qualified by adding:\\n\\n   :entity1 prov:qualifiedGeneration :entity1Gen .\\n   :entity1Gen \\n       a prov:Generation, prov:Influence;\\n       prov:activity :activity1;\\n       :customValue 1337 .\\n\\nNote how the value of the unqualified influence (prov:wasGeneratedBy :activity1) is mirrored as the value of the prov:activity (or prov:entity, or prov:agent) property on the influence class."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:qualifiedGenerationOf rdfs:label "qualifiedGenerationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedGeneration .

onto:qualifiedInfluenceOf rdfs:label "qualifiedInfluenceOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedInfluence .

onto:qualifiedInsertion a owl:ObjectProperty ;
    rdfs:label "qualifiedInsertion" ;
    rdfs:domain onto:Dictionary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Insertion ;
    rdfs:subPropertyOf onto:qualifiedDerivation ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "The dictionary was derived from the other by insertion. prov:qualifiedInsertion shows details of the insertion, in particular the inserted key-entity pairs." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI .

onto:qualifiedInvalidationOf rdfs:label "qualifiedInvalidationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedInvalidation .

onto:qualifiedQuotationOf rdfs:label "qualifiedQuotationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedQuotation .

onto:qualifiedRemoval a owl:ObjectProperty ;
    rdfs:label "qualifiedRemoval" ;
    rdfs:domain onto:Dictionary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Removal ;
    rdfs:subPropertyOf onto:qualifiedDerivation ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "The dictionary was derived from the other by removal. prov:qualifiedRemoval shows details of the removal, in particular the removed keys." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

onto:qualifiedSourceOf rdfs:label "qualifiedSourceOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedPrimarySource .

onto:qualifiedStartOf rdfs:label "qualifiedStartOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedStart .

onto:qualifiedUsingActivity rdfs:label "qualifiedUsingActivity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedUsage .

onto:quotedAs rdfs:label "quotedAs" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:wasQuotedFrom .

onto:revisedEntity rdfs:label "revisedEntity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:qualifiedRevision .

onto:sharesDefinitionWith a owl:AnnotationProperty ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:started rdfs:label "started" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:wasStartedBy .

onto:todo a owl:AnnotationProperty .

onto:unqualifiedForm a owl:AnnotationProperty ;
    rdfs:comment "Classes and properties used to qualify relationships are annotated with prov:unqualifiedForm to indicate the property used to assert an unqualified provenance relation."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    onto:category "expanded" ;
    onto:component "entities-activities" ;
    onto:definition "Provides a value that is a direct representation of an entity."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-value"^^xsd:anyURI ;
    onto:editorialNote "The editor's definition comes from http://www.w3.org/TR/rdf-primer/#rdfvalue",
        "This property serves the same purpose as rdf:value, but has been reintroduced to avoid some of the definitional ambiguity in the RDF specification (specifically, 'may be used in describing structured values')."@en .

onto:wasActivityOfInfluence rdfs:label "wasActivityOfInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:hadActivity .

onto:wasAssociateFor rdfs:label "wasAssociateFor" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:wasAssociatedWith .

onto:wasMemberOf rdfs:label "wasMemberOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:hadMember .

onto:wasPlanOf rdfs:label "wasPlanOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:hadPlan .

onto:wasPrimarySourceOf rdfs:label "wasPrimarySourceOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:hadPrimarySource .

onto:wasRoleIn rdfs:label "wasRoleIn" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:hadRole .

onto:wasUsedBy rdfs:label "wasUsedBy" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:used .

onto:wasUsedInDerivation rdfs:label "wasUsedInDerivation" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:hadUsage .

owl:topObjectProperty a owl:ObjectProperty .

onto:Bundle a owl:Class ;
    rdfs:label "Bundle" ;
    rdfs:comment "Note that there are kinds of bundles (e.g. handwritten letters, audio recordings, etc.) that are not expressed in PROV-O, but can be still be described by PROV-O."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:Entity ;
    onto:category "expanded" ;
    onto:definition "A bundle is a named set of provenance descriptions, and is itself an Entity, so allowing provenance of provenance to be expressed."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-bundle-entity"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-bundle-declaration"^^xsd:anyURI .

onto:Contribute a owl:Class ;
    rdfs:label "Contribute\\n"@en ;
    rdfs:subClassOf onto:Activity ;
    onto:definition "Activity that identifies any contribution of an agent to a resource. "@en .

onto:Contributor a owl:Class ;
    rdfs:label "Contributor"@en ;
    rdfs:subClassOf onto:Role ;
    onto:definition "Role with the function of having responsibility for making contributions to a resource. The Agent assigned to this role is associated with a Modify or Create Activities"@en .

onto:EmptyCollection a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "EmptyCollection"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:Collection ;
    onto:category "expanded" ;
    onto:component "collections" ;
    onto:definition "An empty collection is a collection without members."@en .

onto:definition a owl:AnnotationProperty ;
    rdfs:comment "A definition quoted from PROV-DM or PROV-CONSTRAINTS that describes the concept expressed with this OWL term."@en ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> .

onto:derivedByInsertionFrom a owl:ObjectProperty ;
    rdfs:label "derivedByInsertionFrom" ;
    rdfs:domain onto:Dictionary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Dictionary ;
    rdfs:subPropertyOf onto:wasDerivedFrom ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "The dictionary was derived from the other by insertion. prov:qualifiedInsertion shows details of the insertion, in particular the inserted key-entity pairs." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI .

onto:derivedByRemovalFrom a owl:ObjectProperty ;
    rdfs:label "derivedByRemovalFrom" ;
    rdfs:domain onto:Dictionary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Dictionary ;
    rdfs:subPropertyOf onto:wasDerivedFrom ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "The dictionary was derived from the other by removal. prov:qualifiedRemoval shows details of the removal, in particular the removed key-entity pairs." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

onto:endedAtTime a owl:DatatypeProperty ;
    rdfs:label "endedAtTime" ;
    rdfs:comment "The time at which an activity ended. See also prov:startedAtTime."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    onto:category "starting-point" ;
    onto:component "entities-activities" ;
    onto:editorialNote "It is the intent that the property chain holds: (prov:qualifiedEnd o prov:atTime) rdfs:subPropertyOf prov:endedAtTime."@en ;
    onto:qualifiedForm onto:End,
        onto:atTime .

onto:generated a owl:ObjectProperty ;
    rdfs:label "generated" ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/ns/prov-o-inverses#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:influenced ;
    owl:inverseOf onto:wasGeneratedBy ;
    onto:category "expanded" ;
    onto:component "entities-activities" ;
    onto:editorialNote "prov:generated is one of few inverse property defined, to allow Activity-oriented assertions in addition to Entity-oriented assertions."@en ;
    onto:inverse "wasGeneratedBy" ;
    onto:sharesDefinitionWith onto:Generation .

onto:generatedAtTime a owl:DatatypeProperty ;
    rdfs:label "generatedAtTime" ;
    rdfs:comment "The time at which an entity was completely created and is available for use."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    onto:category "expanded" ;
    onto:component "entities-activities" ;
    onto:editorialNote "It is the intent that the property chain holds: (prov:qualifiedGeneration o prov:atTime) rdfs:subPropertyOf prov:generatedAtTime."@en ;
    onto:qualifiedForm onto:Generation,
        onto:atTime .

onto:hadGeneration a owl:ObjectProperty ;
    rdfs:label "hadGeneration" ;
    rdfs:comment "The _optional_ Generation involved in an Entity's Derivation."@en ;
    rdfs:domain onto:Derivation ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Generation ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:inverse "generatedAsDerivation" ;
    onto:sharesDefinitionWith onto:Generation .

onto:hadPlan a owl:ObjectProperty ;
    rdfs:label "hadPlan" ;
    rdfs:comment "The _optional_ Plan adopted by an Agent in Association with some Activity. Plan specifications are out of the scope of this specification."@en ;
    rdfs:domain onto:Association ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Plan ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:inverse "wasPlanOf" ;
    onto:sharesDefinitionWith onto:Plan .

onto:hadUsage a owl:ObjectProperty ;
    rdfs:label "hadUsage" ;
    rdfs:comment "The _optional_ Usage involved in an Entity's Derivation."@en ;
    rdfs:domain onto:Derivation ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Usage ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:inverse "wasUsedInDerivation" ;
    onto:sharesDefinitionWith onto:Usage .

onto:insertedKeyEntityPair a owl:ObjectProperty ;
    rdfs:label "insertedKeyEntityPair" ;
    rdfs:domain onto:Insertion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:KeyEntityPair ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "An object property to refer to the prov:KeyEntityPair inserted into a prov:Dictionary." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI .

onto:invalidated a owl:ObjectProperty ;
    rdfs:label "invalidated" ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/ns/prov-o-inverses#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:influenced ;
    owl:inverseOf onto:wasInvalidatedBy ;
    onto:category "expanded" ;
    onto:component "entities-activities" ;
    onto:editorialNote "prov:invalidated is one of few inverse property defined, to allow Activity-oriented assertions in addition to Entity-oriented assertions."@en ;
    onto:inverse "wasInvalidatedBy" ;
    onto:sharesDefinitionWith onto:Invalidation .

onto:invalidatedAtTime a owl:DatatypeProperty ;
    rdfs:label "invalidatedAtTime" ;
    rdfs:comment "The time at which an entity was invalidated (i.e., no longer usable)."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    onto:category "expanded" ;
    onto:component "entities-activities" ;
    onto:editorialNote "It is the intent that the property chain holds: (prov:qualifiedInvalidation o prov:atTime) rdfs:subPropertyOf prov:invalidatedAtTime."@en ;
    onto:qualifiedForm onto:Invalidation,
        onto:atTime .

onto:mentionOf a owl:ObjectProperty ;
    rdfs:label "mentionOf" ;
    rdfs:comment "prov:mentionOf is used to specialize an entity as described in another bundle. It is to be used in conjuction with prov:asInBundle.\\n\\nprov:asInBundle is used to cite the Bundle in which the generalization was mentioned."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-links#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:specializationOf ;
    onto:inverse "hadMention" .

onto:pairEntity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "pairKey" ;
    rdfs:domain onto:KeyEntityPair ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Entity ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "The value of a KeyEntityPair." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

onto:pairKey a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "pairKey" ;
    rdfs:domain onto:KeyEntityPair ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "The key of a KeyEntityPair, which is an element of a prov:Dictionary." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

onto:removedKey a owl:DatatypeProperty ;
    rdfs:label "removedKey" ;
    rdfs:domain onto:Removal ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "The key removed in a Removal." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

onto:startedAtTime a owl:DatatypeProperty ;
    rdfs:label "startedAtTime" ;
    rdfs:comment "The time at which an activity started. See also prov:endedAtTime."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    onto:category "starting-point" ;
    onto:component "entities-activities" ;
    onto:editorialNote "It is the intent that the property chain holds: (prov:qualifiedStart o prov:atTime) rdfs:subPropertyOf prov:startedAtTime."@en ;
    onto:qualifiedForm onto:Start,
        onto:atTime .

owl:Thing a owl:Class .

onto:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:seeAlso onto:atLocation ;
    onto:category "expanded" ;
    onto:definition "A location can be an identifiable geographic place (ISO 19112), but it can also be a non-geographic place such as a directory, row, or column. As such, there are numerous ways in which location can be expressed, such as by a coordinate, address, landmark, and so forth."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-location"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribute"^^xsd:anyURI .

onto:Plan a owl:Class ;
    rdfs:label "Plan" ;
    rdfs:comment "There exist no prescriptive requirement on the nature of plans, their representation, the actions or steps they consist of, or their intended goals. Since plans may evolve over time, it may become necessary to track their provenance, so plans themselves are entities. Representing the plan explicitly in the provenance can be useful for various tasks: for example, to validate the execution as represented in the provenance record, to manage expectation failures, or to provide explanations."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:Entity ;
    onto:category "expanded",
        "qualified" ;
    onto:component "agents-responsibility" ;
    onto:definition "A plan is an entity that represents a set of actions or steps intended by one or more agents to achieve some goals." ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Association"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Association"^^xsd:anyURI .

onto:SoftwareAgent a owl:Class ;
    rdfs:label "SoftwareAgent" ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf owl:Thing,
        onto:Agent ;
    onto:category "expanded" ;
    onto:component "agents-responsibility" ;
    onto:definition "A software agent is running software."@en ;
    onto:dm "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-dm.html#term-agent"^^xsd:anyURI,
        "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-n.html#expression-types"^^xsd:anyURI,
        "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

onto:atLocation a owl:ObjectProperty ;
    rdfs:label "atLocation" ;
    rdfs:comment "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.",
        "The Location of any resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Activity onto:Agent onto:Entity onto:InstantaneousEvent ) ] ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Location ;
    onto:category "expanded" ;
    onto:editorialNote "The naming of prov:atLocation parallels prov:atTime, and is not named prov:hadLocation to avoid conflicting with the convention that prov:had* properties are used on prov:Influence classes."@en,
        "This property is not functional because the many values could be at a variety of granularies (In this building, in this room, in that chair)."@en ;
    onto:inverse "locationOf" ;
    onto:sharesDefinitionWith onto:Location .

onto:dictionary a owl:ObjectProperty ;
    rdfs:label "dictionary" ;
    rdfs:domain onto:Insertion,
        onto:Removal ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Dictionary ;
    rdfs:subPropertyOf onto:entity ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "The property used by a prov:Insertion and prov:Removal to cite the prov:Dictionary that was prov:derivedByInsertionFrom or prov:derivedByRemovalFrom another dictionary." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI,
        "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI,
        "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

onto:hadActivity a owl:ObjectProperty ;
    rdfs:label "hadActivity" ;
    rdfs:comment "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.",
        "The _optional_ Activity of an Influence, which used, generated, invalidated, or was the responsibility of some Entity. This property is _not_ used by ActivityInfluence (use prov:activity instead)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Delegation onto:Derivation onto:End onto:Start ) ],
        onto:Influence ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Activity ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:editorialNote "The multiple rdfs:domain assertions are intended. One is simpler and works for OWL-RL, the union is more specific but is not recognized by OWL-RL."@en ;
    onto:inverse "wasActivityOfInfluence" ;
    onto:sharesDefinitionWith onto:Activity .

onto:hadMember a owl:ObjectProperty ;
    rdfs:label "hadMember" ;
    rdfs:domain onto:Collection ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    onto:category "expanded" ;
    onto:component "expanded" ;
    onto:inverse "wasMemberOf" ;
    onto:sharesDefinitionWith onto:Collection .

onto:hadRole a owl:ObjectProperty ;
    rdfs:label "hadRole" ;
    rdfs:comment "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.",
        "The _optional_ Role that an Entity assumed in the context of an Activity. For example, :baking prov:used :spoon; prov:qualified [ a prov:Usage; prov:entity :spoon; prov:hadRole roles:mixing_implement ]."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Association onto:InstantaneousEvent ) ],
        onto:Influence ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Role ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:editorsDefinition "prov:hadRole references the Role (i.e. the function of an entity with respect to an activity), in the context of an instantaneous usage, generation, association, start, and end."@en ;
    onto:inverse "wasRoleIn" ;
    onto:sharesDefinitionWith onto:Role .

onto:wasInformedBy a owl:ObjectProperty ;
    rdfs:label "wasInformedBy" ;
    rdfs:comment "An activity a2 is dependent on or informed by another activity a1, by way of some unspecified entity that is generated by a1 and used by a2."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Activity ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:propertyChainAxiom ( onto:qualifiedCommunication onto:activity ) ;
    onto:category "starting-point" ;
    onto:component "entities-activities" ;
    onto:inverse "informed" ;
    onto:qualifiedForm onto:Communication,
        onto:qualifiedCommunication .

<http://www.w3.org/ns/prov-aq#> a owl:Ontology ;
    rdfs:label "PROV Access and Query Ontology"@en ;
    rdfs:comment "0.2"^^xsd:string,
        "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). \\n\\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en ;
    rdfs:seeAlso <http://www.w3.org/TR/prov-aq/>,
        onto: ;
    owl:versionIRI <http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/> .

<http://www.w3.org/ns/prov-dc#> a owl:Ontology ;
    rdfs:label "Dublin Core extensions of the W3C PROVenance Interchange Ontology (PROV-O) "@en ;
    rdfs:comment "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). \\n\\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en ;
    owl:imports <http://www.w3.org/ns/prov-o#> .

<http://www.w3.org/ns/prov-dictionary#> a owl:Ontology ;
    rdfs:label "W3C PROVenance Interchange Ontology (PROV-O) Dictionary Extension"@en ;
    rdfs:comment "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). \\r\\n\\r\\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en ;
    rdfs:seeAlso <http://www.w3.org/TR/prov-dictionary/>,
        <http://www.w3.org/ns/prov> .

onto:Attribution a owl:Class ;
    rdfs:label "Attribution" ;
    rdfs:comment "An instance of prov:Attribution provides additional descriptions about the binary prov:wasAttributedTo relation from an prov:Entity to some prov:Agent that had some responsible for it. For example, :cake prov:wasAttributedTo :baker; prov:qualifiedAttribution [ a prov:Attribution; prov:entity :baker; :foo :bar ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:AgentInfluence ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "Attribution is the ascribing of an entity to an agent.\\n\\nWhen an entity e is attributed to agent ag, entity e was generated by some unspecified activity that in turn was associated to agent ag. Thus, this relation is useful when the activity is not known, or irrelevant."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribution"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribution"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasAttributedTo .

onto:Collection a owl:Class ;
    rdfs:label "Collection" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:Entity ;
    onto:category "expanded" ;
    onto:component "collections" ;
    onto:definition "A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-collection"^^xsd:anyURI .

onto:Insertion a owl:Class ;
    rdfs:label "Insertion" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:int ;
            owl:onProperty onto:insertedKeyEntityPair ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty onto:dictionary ],
        onto:Derivation ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "Insertion is a derivation that transforms a dictionary into another, by insertion of one or more key-entity pairs." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI ;
    onto:unqualifiedForm onto:derivedByInsertionFrom .

onto:PrimarySource a owl:Class ;
    rdfs:label "PrimarySource" ;
    rdfs:comment "An instance of prov:PrimarySource provides additional descriptions about the binary prov:hadPrimarySource relation from some secondary prov:Entity to an earlier, primary prov:Entity. For example, :blog prov:hadPrimarySource :newsArticle; prov:qualifiedPrimarySource [ a prov:PrimarySource; prov:entity :newsArticle; :foo :bar ] ."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:Derivation ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:definition "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight.\\n\\nBecause of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated.\\n\\nA primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-primary-source"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-original-source"^^xsd:anyURI ;
    onto:unqualifiedForm onto:hadPrimarySource .

onto:Quotation a owl:Class ;
    rdfs:label "Quotation" ;
    rdfs:comment "An instance of prov:Quotation provides additional descriptions about the binary prov:wasQuotedFrom relation from some taken prov:Entity from an earlier, larger prov:Entity. For example, :here_is_looking_at_you_kid prov:wasQuotedFrom :casablanca_script; prov:qualifiedQuotation [ a prov:Quotation; prov:entity :casablanca_script; :foo :bar ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:Derivation ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:definition "A quotation is the repeat of (some or all of) an entity, such as text or image, by someone who may or may not be its original author. Quotation is a particular case of derivation."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-quotation"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-quotation"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasQuotedFrom .

onto:Removal a owl:Class ;
    rdfs:label "Removal" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:int ;
            owl:onProperty onto:removedKey ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty onto:dictionary ],
        onto:Derivation ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "Removal is a derivation that transforms a dictionary into another, by removing one or more key-entity pairs." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI ;
    onto:unqualifiedForm onto:derivedByRemovalFrom .

onto:Revision a owl:Class ;
    rdfs:label "Revision" ;
    rdfs:comment "An instance of prov:Revision provides additional descriptions about the binary prov:wasRevisionOf relation from some newer prov:Entity to an earlier prov:Entity. For example, :draft_2 prov:wasRevisionOf :draft_1; prov:qualifiedRevision [ a prov:Revision; prov:entity :draft_1; :foo :bar ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:Derivation ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:definition "A revision is a derivation for which the resulting entity is a revised version of some original. The implication here is that the resulting entity contains substantial content from the original. Revision is a particular case of derivation."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-revision"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Revision"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasRevisionOf .

onto:actedOnBehalfOf a owl:ObjectProperty ;
    rdfs:label "actedOnBehalfOf" ;
    rdfs:comment "An object property to express the accountability of an agent towards another agent. The subordinate agent acted on behalf of the responsible agent in an actual activity. "@en ;
    rdfs:domain onto:Agent ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Agent ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:propertyChainAxiom ( onto:qualifiedDelegation onto:agent ) ;
    onto:category "starting-point" ;
    onto:component "agents-responsibility" ;
    onto:inverse "hadDelegate" ;
    onto:qualifiedForm onto:Delegation,
        onto:qualifiedDelegation .

onto:alternateOf a owl:ObjectProperty ;
    rdfs:label "alternateOf" ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/ns/prov-o-inverses#> ;
    rdfs:range onto:Entity ;
    rdfs:seeAlso onto:specializationOf ;
    owl:inverseOf onto:alternateOf ;
    onto:category "expanded" ;
    onto:component "alternate" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "Two alternate entities present aspects of the same thing. These aspects may be the same or different, and the alternate entities may or may not overlap in time."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-alternate"^^xsd:anyURI ;
    onto:inverse "alternateOf" ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-alternate"^^xsd:anyURI .

onto:influenced a owl:ObjectProperty ;
    rdfs:label "influenced" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf onto:wasInfluencedBy ;
    onto:category "expanded" ;
    onto:component "agents-responsibility" ;
    onto:inverse "wasInfluencedBy" ;
    onto:sharesDefinitionWith onto:Influence .

onto:qualifiedAssociation a owl:ObjectProperty ;
    rdfs:label "qualifiedAssociation" ;
    rdfs:comment "If this Activity prov:wasAssociatedWith Agent :ag, then it can qualify the Association using prov:qualifiedAssociation [ a prov:Association;  prov:agent :ag; :foo :bar ]."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Association ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:inverse "qualifiedAssociationOf" ;
    onto:sharesDefinitionWith onto:Association ;
    onto:unqualifiedForm onto:wasAssociatedWith .

onto:qualifiedAttribution a owl:ObjectProperty ;
    rdfs:label "qualifiedAttribution" ;
    rdfs:comment "If this Entity prov:wasAttributedTo Agent :ag, then it can qualify how it was influenced using prov:qualifiedAttribution [ a prov:Attribution;  prov:agent :ag; :foo :bar ]."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Attribution ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:inverse "qualifiedAttributionOf" ;
    onto:sharesDefinitionWith onto:Attribution ;
    onto:unqualifiedForm onto:wasAttributedTo .

onto:qualifiedCommunication a owl:ObjectProperty ;
    rdfs:label "qualifiedCommunication" ;
    rdfs:comment "If this Activity prov:wasInformedBy Activity :a, then it can qualify how it was influenced using prov:qualifiedCommunication [ a prov:Communication;  prov:activity :a; :foo :bar ]."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Communication ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:inverse "qualifiedCommunicationOf" ;
    onto:qualifiedForm onto:Communication ;
    onto:sharesDefinitionWith onto:Communication .

onto:qualifiedDelegation a owl:ObjectProperty ;
    rdfs:label "qualifiedDelegation" ;
    rdfs:comment "If this Agent prov:actedOnBehalfOf Agent :ag, then it can qualify how with prov:qualifiedResponsibility [ a prov:Responsibility;  prov:agent :ag; :foo :bar ]."@en ;
    rdfs:domain onto:Agent ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Delegation ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:inverse "qualifiedDelegationOf" ;
    onto:sharesDefinitionWith onto:Delegation ;
    onto:unqualifiedForm onto:actedOnBehalfOf .

onto:qualifiedEnd a owl:ObjectProperty ;
    rdfs:label "qualifiedEnd" ;
    rdfs:comment "If this Activity prov:wasEndedBy Entity :e1, then it can qualify how it was ended using prov:qualifiedEnd [ a prov:End;  prov:entity :e1; :foo :bar ]."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:End ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:inverse "qualifiedEndOf" ;
    onto:sharesDefinitionWith onto:End ;
    onto:unqualifiedForm onto:wasEndedBy .

onto:qualifiedGeneration a owl:ObjectProperty ;
    rdfs:label "qualifiedGeneration" ;
    rdfs:comment "If this Activity prov:generated Entity :e, then it can qualify how it performed the Generation using prov:qualifiedGeneration [ a prov:Generation;  prov:entity :e; :foo :bar ]."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Generation ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:inverse "qualifiedGenerationOf" ;
    onto:sharesDefinitionWith onto:Generation ;
    onto:unqualifiedForm onto:wasGeneratedBy .

onto:qualifiedInvalidation a owl:ObjectProperty ;
    rdfs:label "qualifiedInvalidation" ;
    rdfs:comment "If this Entity prov:wasInvalidatedBy Activity :a, then it can qualify how it was invalidated using prov:qualifiedInvalidation [ a prov:Invalidation;  prov:activity :a; :foo :bar ]."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Invalidation ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:inverse "qualifiedInvalidationOf" ;
    onto:sharesDefinitionWith onto:Invalidation ;
    onto:unqualifiedForm onto:wasInvalidatedBy .

onto:qualifiedPrimarySource a owl:ObjectProperty ;
    rdfs:label "qualifiedPrimarySource" ;
    rdfs:comment "If this Entity prov:hadPrimarySource Entity :e, then it can qualify how using prov:qualifiedPrimarySource [ a prov:PrimarySource; prov:entity :e; :foo :bar ]."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:PrimarySource ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:inverse "qualifiedSourceOf" ;
    onto:sharesDefinitionWith onto:PrimarySource ;
    onto:unqualifiedForm onto:hadPrimarySource .

onto:qualifiedQuotation a owl:ObjectProperty ;
    rdfs:label "qualifiedQuotation" ;
    rdfs:comment "If this Entity prov:wasQuotedFrom Entity :e, then it can qualify how using prov:qualifiedQuotation [ a prov:Quotation;  prov:entity :e; :foo :bar ]."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Quotation ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:inverse "qualifiedQuotationOf" ;
    onto:sharesDefinitionWith onto:Quotation ;
    onto:unqualifiedForm onto:wasQuotedFrom .

onto:qualifiedRevision a owl:ObjectProperty ;
    rdfs:label "qualifiedRevision" ;
    rdfs:comment "If this Entity prov:wasRevisionOf Entity :e, then it can qualify how it was revised using prov:qualifiedRevision [ a prov:Revision;  prov:entity :e; :foo :bar ]."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Revision ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:inverse "revisedEntity" ;
    onto:sharesDefinitionWith onto:Revision ;
    onto:unqualifiedForm onto:wasRevisionOf .

onto:qualifiedStart a owl:ObjectProperty ;
    rdfs:label "qualifiedStart" ;
    rdfs:comment "If this Activity prov:wasStartedBy Entity :e1, then it can qualify how it was started using prov:qualifiedStart [ a prov:Start;  prov:entity :e1; :foo :bar ]."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Start ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:inverse "qualifiedStartOf" ;
    onto:sharesDefinitionWith onto:Start ;
    onto:unqualifiedForm onto:wasStartedBy .

onto:qualifiedUsage a owl:ObjectProperty ;
    rdfs:label "qualifiedUsage" ;
    rdfs:comment "If this Activity prov:used Entity :e, then it can qualify how it used it using prov:qualifiedUsage [ a prov:Usage; prov:entity :e; :foo :bar ]."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Usage ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:inverse "qualifiedUsingActivity" ;
    onto:sharesDefinitionWith onto:Usage ;
    onto:unqualifiedForm onto:used .

onto:specializationOf a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "specializationOf" ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy onto:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:seeAlso onto:alternateOf ;
    rdfs:subPropertyOf owl:topObjectProperty,
        onto:alternateOf ;
    onto:category "expanded" ;
    onto:component "alternate" ;
    onto:constraints "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-constraints.html#prov-dm-constraints-fig"^^xsd:anyURI,
        "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "An entity that is a specialization of another shares all aspects of the latter, and additionally presents more specific aspects of the same thing as the latter. In particular, the lifetime of the entity being specialized contains that of any specialization. Examples of aspects include a time period, an abstraction, and a context associated with the entity."@en ;
    onto:dm "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-dm.html#term-specialization"^^xsd:anyURI,
        "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-specialization"^^xsd:anyURI ;
    onto:inverse "generalizationOf" ;
    onto:n "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-n.html#expression-specialization"^^xsd:anyURI,
        "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-specialization"^^xsd:anyURI .

onto:used a owl:ObjectProperty ;
    rdfs:label "used" ;
    rdfs:comment "A prov:Entity that was used by this prov:Activity. For example, :baking prov:used :spoon, :egg, :oven ."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:propertyChainAxiom ( onto:qualifiedUsage onto:entity ) ;
    onto:category "starting-point" ;
    onto:component "entities-activities" ;
    onto:inverse "wasUsedBy" ;
    onto:qualifiedForm onto:Usage,
        onto:qualifiedUsage .

onto:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:label "wasAssociatedWith" ;
    rdfs:comment "An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Agent ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:propertyChainAxiom ( onto:qualifiedAssociation onto:agent ) ;
    onto:category "starting-point" ;
    onto:component "agents-responsibility" ;
    onto:inverse "wasAssociateFor" ;
    onto:qualifiedForm onto:Association,
        onto:qualifiedAssociation .

onto:wasEndedBy a owl:ObjectProperty ;
    rdfs:label "wasEndedBy" ;
    rdfs:comment "End is when an activity is deemed to have ended. An end may refer to an entity, known as trigger, that terminated the activity."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:propertyChainAxiom ( onto:qualifiedEnd onto:entity ) ;
    onto:category "expanded" ;
    onto:component "entities-activities" ;
    onto:inverse "ended" ;
    onto:qualifiedForm onto:End,
        onto:qualifiedEnd .

onto:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "wasGeneratedBy" ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/ns/prov-o-inverses#> ;
    rdfs:range onto:Activity ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:inverseOf onto:generated ;
    owl:propertyChainAxiom ( onto:qualifiedGeneration onto:activity ) ;
    onto:category "starting-point" ;
    onto:component "entities-activities" ;
    onto:inverse "generated" ;
    onto:qualifiedForm onto:Generation,
        onto:qualifiedGeneration .

onto:wasInvalidatedBy a owl:ObjectProperty ;
    rdfs:label "wasInvalidatedBy" ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/ns/prov-o-inverses#> ;
    rdfs:range onto:Activity ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:inverseOf onto:invalidated ;
    owl:propertyChainAxiom ( onto:qualifiedInvalidation onto:activity ) ;
    onto:category "expanded" ;
    onto:component "entities-activities" ;
    onto:inverse "invalidated" ;
    onto:qualifiedForm onto:Invalidation,
        onto:qualifiedInvalidation .

onto:wasStartedBy a owl:ObjectProperty ;
    rdfs:label "wasStartedBy" ;
    rdfs:comment "Start is when an activity is deemed to have started. A start may refer to an entity, known as trigger, that initiated the activity."@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:propertyChainAxiom ( onto:qualifiedStart onto:entity ) ;
    onto:category "expanded" ;
    onto:component "entities-activities" ;
    onto:inverse "started" ;
    onto:qualifiedForm onto:Start,
        onto:qualifiedStart .

onto:ActivityInfluence a owl:Class ;
    rdfs:label "ActivityInfluence" ;
    rdfs:comment "ActivityInfluence provides additional descriptions of an Activity's binary influence upon any other kind of resource. Instances of ActivityInfluence use the prov:activity property to cite the influencing Activity."@en,
        "It is not recommended that the type ActivityInfluence be asserted without also asserting one of its more specific subclasses."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:seeAlso onto:activity ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:hadActivity ],
        onto:Influence ;
    owl:disjointWith onto:EntityInfluence ;
    onto:category "qualified" ;
    onto:editorsDefinition "ActivitiyInfluence is the capacity of an activity to have an effect on the character, development, or behavior of another by means of generation, invalidation, communication, or other."@en .

onto:AgentInfluence a owl:Class ;
    rdfs:label "AgentInfluence" ;
    rdfs:comment "AgentInfluence provides additional descriptions of an Agent's binary influence upon any other kind of resource. Instances of AgentInfluence use the prov:agent property to cite the influencing Agent."@en,
        "It is not recommended that the type AgentInfluence be asserted without also asserting one of its more specific subclasses."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:seeAlso onto:agent ;
    rdfs:subClassOf onto:Influence ;
    onto:category "qualified" ;
    onto:editorsDefinition "AgentInfluence is the capacity of an agent to have an effect on the character, development, or behavior of another by means of attribution, association, delegation, or other."@en .

onto:Communication a owl:Class ;
    rdfs:label "Communication" ;
    rdfs:comment "An instance of prov:Communication provides additional descriptions about the binary prov:wasInformedBy relation from an informed prov:Activity to the prov:Activity that informed it. For example, :you_jumping_off_bridge prov:wasInformedBy :everyone_else_jumping_off_bridge; prov:qualifiedCommunication [ a prov:Communication; prov:activity :everyone_else_jumping_off_bridge; :foo :bar ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:ActivityInfluence ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "Communication is the exchange of an entity by two activities, one activity using the entity generated by the other." ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Communication"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-wasInformedBy"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasInformedBy .

onto:Delegation a owl:Class ;
    rdfs:label "Delegation" ;
    rdfs:comment "An instance of prov:Delegation provides additional descriptions about the binary prov:actedOnBehalfOf relation from a performing prov:Agent to some prov:Agent for whom it was performed. For example, :mixing prov:wasAssociatedWith :toddler . :toddler prov:actedOnBehalfOf :mother; prov:qualifiedDelegation [ a prov:Delegation; prov:entity :mother; :foo :bar ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:AgentInfluence ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:definition "Delegation is the assignment of authority and responsibility to an agent (by itself or by another agent) to carry out a specific activity as a delegate or representative, while the agent it acts on behalf of retains some responsibility for the outcome of the delegated work.\\n\\nFor example, a student acted on behalf of his supervisor, who acted on behalf of the department chair, who acted on behalf of the university; all those agents are responsible in some way for the activity that took place but we do not say explicitly who bears responsibility and to what degree."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-delegation"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-delegation"^^xsd:anyURI ;
    onto:unqualifiedForm onto:actedOnBehalfOf .

onto:KeyEntityPair a owl:Class ;
    rdfs:label "Key-Entity Pair" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty onto:pairEntity ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty onto:pairKey ] ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "A key-entity pair. Part of a prov:Dictionary through prov:hadDictionaryMember. The key is any RDF Literal, the value is a prov:Entity." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

onto:atTime a owl:DatatypeProperty ;
    rdfs:label "atTime" ;
    rdfs:comment "The time at which an InstantaneousEvent occurred, in the form of xsd:dateTime."@en ;
    rdfs:domain onto:InstantaneousEvent ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:sharesDefinitionWith onto:InstantaneousEvent ;
    onto:unqualifiedForm onto:endedAtTime,
        onto:generatedAtTime,
        onto:invalidatedAtTime,
        onto:startedAtTime .

onto:hadPrimarySource a owl:ObjectProperty ;
    rdfs:label "hadPrimarySource" ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:wasDerivedFrom ;
    owl:propertyChainAxiom ( onto:qualifiedPrimarySource onto:entity ) ;
    onto:category "expanded" ;
    onto:component "derivations" ;
    onto:inverse "wasPrimarySourceOf" ;
    onto:qualifiedForm onto:PrimarySource,
        onto:qualifiedPrimarySource .

onto:influencer a owl:ObjectProperty ;
    rdfs:label "influencer" ;
    rdfs:comment "Subproperties of prov:influencer are used to cite the object of an unqualified PROV-O triple whose predicate is a subproperty of prov:wasInfluencedBy (e.g. prov:used, prov:wasGeneratedBy). prov:influencer is used much like rdf:object is used."@en ;
    rdfs:domain onto:Influence ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range owl:Thing ;
    onto:category "qualified" ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"^^xsd:anyURI ;
    onto:editorialNote "This property and its subproperties are used in the same way as the rdf:object property, i.e. to reference the object of an unqualified prov:wasInfluencedBy or prov:influenced triple."@en ;
    onto:editorsDefinition "This property is used as part of the qualified influence pattern. Subclasses of prov:Influence use these subproperties to reference the resource (Entity, Agent, or Activity) whose influence is being qualified."@en ;
    onto:inverse "hadInfluence" .

onto:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "wasAttributedTo" ;
    rdfs:comment "Attribution is the ascribing of an entity to an agent."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Agent ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:propertyChainAxiom ( onto:qualifiedAttribution onto:agent ) ;
    onto:category "starting-point" ;
    onto:component "agents-responsibility" ;
    onto:definition "Attribution is the ascribing of an entity to an agent."@en ;
    onto:inverse "contributed" ;
    onto:qualifiedForm onto:Attribution,
        onto:qualifiedAttribution .

onto:wasQuotedFrom a owl:ObjectProperty ;
    rdfs:label "wasQuotedFrom" ;
    rdfs:comment "An entity is derived from an original entity by copying, or 'quoting', some or all of it."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:wasDerivedFrom ;
    owl:propertyChainAxiom ( onto:qualifiedQuotation onto:entity ) ;
    onto:category "expanded" ;
    onto:component "derivations" ;
    onto:inverse "quotedAs" ;
    onto:qualifiedForm onto:Quotation,
        onto:qualifiedQuotation .

onto:wasRevisionOf a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "wasRevisionOf" ;
    rdfs:comment "A revision is a derivation that revises an entity into a revised version."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:wasDerivedFrom ;
    owl:propertyChainAxiom ( onto:qualifiedRevision onto:entity ) ;
    onto:category "expanded" ;
    onto:component "derivations" ;
    onto:inverse "hadRevision" ;
    onto:qualifiedForm onto:Revision,
        onto:qualifiedRevision .

<http://www.w3.org/ns/prov-links#> a owl:Ontology ;
    rdfs:label "W3C PROV Linking Across Provenance Bundles Ontology (PROV-LINKS)"@en ;
    rdfs:comment "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). If you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/\\n). All feedback is welcome."@en ;
    rdfs:seeAlso <http://www.w3.org/TR/prov-links/>,
        <http://www.w3.org/ns/prov> ;
    owl:imports <http://www.w3.org/ns/prov-o#> ;
    owl:versionIRI <http://www.w3.org/ns/prov-links-20130430> ;
    owl:versionInfo "Working Group Note version 2013-04-30"@en ;
    onto:specializationOf <http://www.w3.org/ns/prov-links> .

onto:Association a owl:Class ;
    rdfs:label "Association" ;
    rdfs:comment "An instance of prov:Association provides additional descriptions about the binary prov:wasAssociatedWith relation from an prov:Activity to some prov:Agent that had some responsiblity for it. For example, :baking prov:wasAssociatedWith :baker; prov:qualifiedAssociation [ a prov:Association; prov:agent :baker; :foo :bar ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:AgentInfluence ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:definition "An activity association is an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity. It further allows for a plan to be specified, which is the plan intended by the agent to achieve some goals in the context of this activity."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Association"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Association"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasAssociatedWith .

onto:End a owl:Class ;
    rdfs:label "End" ;
    rdfs:comment "An instance of prov:End provides additional descriptions about the binary prov:wasEndedBy relation from some ended prov:Activity to an prov:Entity that ended it. For example, :ball_game prov:wasEndedBy :buzzer; prov:qualifiedEnd [ a prov:End; prov:entity :buzzer; :foo :bar; prov:atTime '2012-03-09T08:05:08-05:00'^^xsd:dateTime ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:EntityInfluence,
        onto:InstantaneousEvent ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "End is when an activity is deemed to have been ended by an entity, known as trigger. The activity no longer exists after its end. Any usage, generation, or invalidation involving an activity precedes the activity's end. An end may refer to a trigger entity that terminated the activity, or to an activity, known as ender that generated the trigger."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-End"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-End"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasEndedBy .

onto:Invalidation a owl:Class ;
    rdfs:label "Invalidation" ;
    rdfs:comment "An instance of prov:Invalidation provides additional descriptions about the binary prov:wasInvalidatedBy relation from an invalidated prov:Entity to the prov:Activity that invalidated it. For example, :uncracked_egg prov:wasInvalidatedBy :baking; prov:qualifiedInvalidation [ a prov:Invalidation; prov:activity :baking; :foo :bar ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:ActivityInfluence,
        onto:InstantaneousEvent ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "Invalidation is the start of the destruction, cessation, or expiry of an existing entity by an activity. The entity is no longer available for use (or further invalidation) after invalidation. Any generation or usage of an entity precedes its invalidation." ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Invalidation"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Invalidation"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasInvalidatedBy .

onto:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:seeAlso onto:hadRole ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:definition "A role is the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-role"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribute"^^xsd:anyURI .

onto:Start a owl:Class ;
    rdfs:label "Start" ;
    rdfs:comment "An instance of prov:Start provides additional descriptions about the binary prov:wasStartedBy relation from some started prov:Activity to an prov:Entity that started it. For example, :foot_race prov:wasStartedBy :bang; prov:qualifiedStart [ a prov:Start; prov:entity :bang; :foo :bar; prov:atTime '2012-03-09T08:05:08-05:00'^^xsd:dateTime ] ."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:EntityInfluence,
        onto:InstantaneousEvent ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "Start is when an activity is deemed to have been started by an entity, known as trigger. The activity did not exist before its start. Any usage, generation, or invalidation involving an activity follows the activity's start. A start may refer to a trigger entity that set off the activity, or to an activity, known as starter, that generated the trigger."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Start"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Start"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasStartedBy .

onto:Usage a owl:Class ;
    rdfs:label "Usage" ;
    rdfs:comment "An instance of prov:Usage provides additional descriptions about the binary prov:used relation from some prov:Activity to an prov:Entity that it used. For example, :keynote prov:used :podium; prov:qualifiedUsage [ a prov:Usage; prov:entity :podium; :foo :bar ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:EntityInfluence,
        onto:InstantaneousEvent ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "Usage is the beginning of utilizing an entity by an activity. Before usage, the activity had not begun to utilize this entity and could not have been affected by the entity."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Usage"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Usage"^^xsd:anyURI ;
    onto:unqualifiedForm onto:used .

onto:activity a owl:ObjectProperty ;
    rdfs:label "activity" ;
    rdfs:domain onto:ActivityInfluence ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Activity ;
    rdfs:subPropertyOf onto:influencer ;
    onto:category "qualified" ;
    onto:editorialNote "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en ;
    onto:editorsDefinition "The prov:activity property references an prov:Activity which influenced a resource. This property applies to an prov:ActivityInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent." ;
    onto:inverse "activityOfInfluence" .

onto:agent a owl:ObjectProperty ;
    rdfs:label "agent" ;
    rdfs:domain onto:AgentInfluence ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Agent ;
    rdfs:subPropertyOf onto:influencer ;
    onto:category "qualified" ;
    onto:editorialNote "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en ;
    onto:editorsDefinition "The prov:agent property references an prov:Agent which influenced a resource. This property applies to an prov:AgentInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent."@en ;
    onto:inverse "agentOfInfluence" .

onto:qualifiedDerivation a owl:ObjectProperty ;
    rdfs:label "qualifiedDerivation" ;
    rdfs:comment "If this Entity prov:wasDerivedFrom Entity :e, then it can qualify how it was derived using prov:qualifiedDerivation [ a prov:Derivation;  prov:entity :e; :foo :bar ]."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Derivation ;
    rdfs:subPropertyOf onto:qualifiedInfluence ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:inverse "qualifiedDerivationOf" ;
    onto:sharesDefinitionWith onto:Derivation ;
    onto:unqualifiedForm onto:wasDerivedFrom .

onto:EntityInfluence a owl:Class ;
    rdfs:label "EntityInfluence" ;
    rdfs:comment "EntityInfluence provides additional descriptions of an Entity's binary influence upon any other kind of resource. Instances of EntityInfluence use the prov:entity property to cite the influencing Entity."@en,
        "It is not recommended that the type EntityInfluence be asserted without also asserting one of its more specific subclasses."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:seeAlso onto:entity ;
    rdfs:subClassOf onto:Influence ;
    onto:category "qualified" ;
    onto:editorsDefinition "EntityInfluence is the capacity of an entity to have an effect on the character, development, or behavior of another by means of usage, start, end, derivation, or other. "@en .

rdfs:seeAlso a owl:AnnotationProperty ;
    rdfs:comment ""@en .

onto:Generation a owl:Class ;
    rdfs:label "Generation" ;
    rdfs:comment "An instance of prov:Generation provides additional descriptions about the binary prov:wasGeneratedBy relation from a generated prov:Entity to the prov:Activity that generated it. For example, :cake prov:wasGeneratedBy :baking; prov:qualifiedGeneration [ a prov:Generation; prov:activity :baking; :foo :bar ]."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:ActivityInfluence,
        onto:InstantaneousEvent ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Generation"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Generation"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasGeneratedBy .

onto:Dictionary a owl:Class ;
    rdfs:label "Dictionary" ;
    rdfs:comment "A given dictionary forms a given structure for its members. A different structure (obtained either by insertion or removal of members) constitutes a different dictionary.",
        "This concept allows for the provenance of the dictionary, but also of its constituents to be expressed. Such a notion of dictionary corresponds to a wide variety of concrete data structures, such as a maps or associative arrays." ;
    rdfs:isDefinedBy onto: ;
    onto:category "collections" ;
    onto:component "collections" ;
    onto:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    onto:definition "A dictionary is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the dictionary." ;
    onto:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-conceptual-definition"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary"^^xsd:anyURI .

onto:entity a owl:ObjectProperty ;
    rdfs:label "entity" ;
    rdfs:domain onto:EntityInfluence ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:influencer ;
    onto:category "qualified" ;
    onto:editorialNote "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en ;
    onto:editorsDefinition "The prov:entity property references an prov:Entity which influenced a resource. This property applies to an prov:EntityInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent." ;
    onto:inverse "entityOfInfluence" .

onto:Derivation a owl:Class ;
    rdfs:label "Derivation" ;
    rdfs:comment "An instance of prov:Derivation provides additional descriptions about the binary prov:wasDerivedFrom relation from some derived prov:Entity to another prov:Entity from which it was derived. For example, :chewed_bubble_gum prov:wasDerivedFrom :unwrapped_bubble_gum; prov:qualifiedDerivation [ a prov:Derivation; prov:entity :unwrapped_bubble_gum; :foo :bar ]."@en,
        "The more specific forms of prov:Derivation (i.e., prov:Revision, prov:Quotation, prov:PrimarySource) should be asserted if they apply."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf onto:EntityInfluence ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Derivation"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#Derivation-Relation"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasDerivedFrom .

onto:Influence a owl:Class ;
    rdfs:label "Influence" ;
    rdfs:comment "An instance of prov:Influence provides additional descriptions about the binary prov:wasInfluencedBy relation from some influenced Activity, Entity, or Agent to the influencing Activity, Entity, or Agent. For example, :stomach_ache prov:wasInfluencedBy :spoon; prov:qualifiedInfluence [ a prov:Influence; prov:entity :spoon; :foo :bar ] . Because prov:Influence is a broad relation, the more specific relations (Communication, Delegation, End, etc.) should be used when applicable."@en,
        "Because prov:Influence is a broad relation, its most specific subclasses (e.g. prov:Communication, prov:Delegation, prov:End, prov:Revision, etc.) should be used when applicable."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:definition "Influence is the capacity of an entity, activity, or agent to have an effect on the character, development, or behavior of another by means of usage, start, end, generation, invalidation, communication, derivation, attribution, association, or delegation."@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-influence"^^xsd:anyURI ;
    onto:unqualifiedForm onto:wasInfluencedBy .

onto:InstantaneousEvent a owl:Class ;
    rdfs:label "InstantaneousEvent" ;
    rdfs:comment "An instantaneous event, or event for short, happens in the world and marks a change in the world, in its activities and in its entities. The term 'event' is commonly used in process algebra with a similar meaning. Events represent communications or interactions; they are assumed to be atomic and instantaneous."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    onto:category "qualified" ;
    onto:component "entities-activities" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#dfn-event"^^xsd:anyURI ;
    onto:definition "The PROV data model is implicitly based on a notion of instantaneous events (or just events), that mark transitions in the world. Events include generation, usage, or invalidation of entities, as well as starting or ending of activities. This notion of event is not first-class in the data model, but it is useful for explaining its other concepts and its semantics."@en .

onto:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "wasDerivedFrom" ;
    rdfs:comment "The more specific subproperties of prov:wasDerivedFrom (i.e., prov:wasQuotedFrom, prov:wasRevisionOf, prov:hadPrimarySource) should be used when applicable."@en ;
    rdfs:domain onto:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Entity ;
    rdfs:subPropertyOf onto:wasInfluencedBy ;
    owl:propertyChainAxiom ( onto:qualifiedDerivation onto:entity ) ;
    onto:category "starting-point" ;
    onto:component "derivations" ;
    onto:definition "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en ;
    onto:inverse "hadDerivation" ;
    onto:qualifiedForm onto:Derivation,
        onto:qualifiedDerivation .

onto:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    owl:disjointWith onto:InstantaneousEvent ;
    onto:category "starting-point" ;
    onto:component "agents-responsibility" ;
    onto:definition "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity. "@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Agent"^^xsd:anyURI .

onto:qualifiedInfluence a owl:ObjectProperty ;
    rdfs:label "qualifiedInfluence" ;
    rdfs:comment "Because prov:qualifiedInfluence is a broad relation, the more specific relations (qualifiedCommunication, qualifiedDelegation, qualifiedEnd, etc.) should be used when applicable."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Activity onto:Agent onto:Entity ) ] ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range onto:Influence ;
    onto:category "qualified" ;
    onto:component "derivations" ;
    onto:inverse "qualifiedInfluenceOf" ;
    onto:sharesDefinitionWith onto:Influence ;
    onto:unqualifiedForm onto:wasInfluencedBy .

onto:wasInfluencedBy a owl:ObjectProperty ;
    rdfs:label "wasInfluencedBy" ;
    rdfs:comment "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.",
        "Because prov:wasInfluencedBy is a broad relation, its more specific subproperties (e.g. prov:wasInformedBy, prov:actedOnBehalfOf, prov:wasEndedBy, etc.) should be used when applicable."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Activity onto:Agent onto:Entity ) ] ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/ns/prov-o-inverses#> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:Activity onto:Agent onto:Entity ) ] ;
    owl:inverseOf onto:influenced ;
    onto:category "qualified" ;
    onto:component "agents-responsibility" ;
    onto:editorialNote "The sub-properties of prov:wasInfluencedBy can be elaborated in more detail using the Qualification Pattern. For example, the binary relation :baking prov:used :spoon can be qualified by asserting :baking prov:qualifiedUsage [ a prov:Usage; prov:entity :spoon; prov:atLocation :kitchen ] .\\n\\nSubproperties of prov:wasInfluencedBy may also be asserted directly without being qualified.\\n\\nprov:wasInfluencedBy should not be used without also using one of its subproperties. \\n"@en ;
    onto:inverse "influenced" ;
    onto:qualifiedForm onto:Influence,
        onto:qualifiedInfluence ;
    onto:sharesDefinitionWith onto:Influence .

onto:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    owl:disjointWith onto:Entity ;
    onto:category "starting-point" ;
    onto:component "entities-activities" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities." ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Activity"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Activity"^^xsd:anyURI .

onto: a owl:Ontology ;
    rdfs:label "W3C PROVenance Interchange"@en ;
    rdfs:comment "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page).\\n\\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/\\nArchives/Public/public-prov-comments/). All feedback is welcome."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov> ;
    rdfs:seeAlso <http://www.w3.org/TR/prov-o/#names-of-inverse-properties>,
        <http://www.w3.org/TR/prov-overview/> ;
    owl:imports <http://www.w3.org/ns/prov-aq#>,
        <http://www.w3.org/ns/prov-dc#>,
        <http://www.w3.org/ns/prov-dictionary#>,
        <http://www.w3.org/ns/prov-links#>,
        <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:versionIRI <http://www.w3.org/ns/prov-20130430>,
        <http://www.w3.org/ns/prov-o-inverses-20130430> ;
    onto:specializationOf <http://www.w3.org/ns/prov-o-inverses> ;
    onto:wasDerivedFrom <http://www.w3.org/ns/prov-aq#>,
        <http://www.w3.org/ns/prov-dc#>,
        <http://www.w3.org/ns/prov-dictionary#>,
        <http://www.w3.org/ns/prov-links#>,
        <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/ns/prov-o-20130430>,
        <http://www.w3.org/ns/prov-o-inverses#> ;
    onto:wasRevisionOf <http://www.w3.org/ns/prov-20130312>,
        <http://www.w3.org/ns/prov-o-inverses-20120312> .

onto:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    owl:disjointWith onto:InstantaneousEvent ;
    onto:category "starting-point" ;
    onto:component "entities-activities" ;
    onto:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    onto:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary. "@en ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-entity"^^xsd:anyURI ;
    onto:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Entity"^^xsd:anyURI .

<http://www.w3.org/ns/prov-o#> a owl:Ontology ;
    rdfs:label "W3C PROVenance Interchange Ontology (PROV-O)"@en ;
    rdfs:comment "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). \\n\\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en ;
    rdfs:seeAlso <http://www.w3.org/TR/prov-o/>,
        <http://www.w3.org/ns/prov> ;
    owl:versionIRI <http://www.w3.org/ns/prov-o-20130430> ;
    owl:versionInfo "Recommendation version 2013-04-30"@en ;
    onto:specializationOf <http://www.w3.org/ns/prov-o> ;
    onto:wasRevisionOf <http://www.w3.org/ns/prov-o-20120312> .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:range ;
    owl:annotatedSource onto:wasInfluencedBy ;
    owl:annotatedTarget [ a owl:Class ;
            owl:unionOf ( onto:Activity onto:Agent onto:Entity ) ] ;
    onto:definition "influencer: an identifier (o1) for an ancestor entity, activity, or agent that the former depends on;" ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence" .

[] a owl:Axiom ;
    rdfs:comment "Revision is a derivation (see http://www.w3.org/TR/prov-dm/#term-Revision). Moreover, according to \\nhttp://www.w3.org/TR/2013/REC-prov-constraints-20130430/#term-Revision 23 April 2012 'wasRevisionOf is a strict sub-relation of wasDerivedFrom since two entities e2 and e1 may satisfy wasDerivedFrom(e2,e1) without being a variant of each other.'" ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource onto:wasRevisionOf ;
    owl:annotatedTarget onto:wasDerivedFrom .

[] a owl:Axiom ;
    rdfs:comment "Derivation is a particular case of trace (see http://www.w3.org/TR/prov-dm/#term-trace), since it links an entity to another entity that contributed to its existence." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource onto:wasDerivedFrom ;
    owl:annotatedTarget onto:wasInfluencedBy .

[] a owl:Axiom ;
    rdfs:comment "Attribution is a particular case of trace (see http://www.w3.org/TR/prov-dm/#concept-trace), in the sense that it links an entity to the agent that ascribed it." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource onto:wasAttributedTo ;
    owl:annotatedTarget onto:wasInfluencedBy ;
    onto:definition "IF wasAttributedTo(e2,ag1,aAttr) holds, THEN wasInfluencedBy(e2,ag1) also holds. " .

[] a owl:Axiom ;
    rdfs:comment "hadPrimarySource property is a particular case of wasDerivedFrom (see http://www.w3.org/TR/prov-dm/#term-original-source) that aims to give credit to the source that originated some information." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource onto:hadPrimarySource ;
    owl:annotatedTarget onto:wasDerivedFrom .

[] a owl:Axiom ;
    rdfs:comment "A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections."@en ;
    owl:annotatedProperty rdfs:range ;
    owl:annotatedSource onto:hadMember ;
    owl:annotatedTarget onto:Entity ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-collection" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:domain ;
    owl:annotatedSource onto:wasInfluencedBy ;
    owl:annotatedTarget [ a owl:Class ;
            owl:unionOf ( onto:Activity onto:Agent onto:Entity ) ] ;
    onto:definition "influencee: an identifier (o2) for an entity, activity, or agent; " ;
    onto:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence" .

[] a owl:Axiom ;
    rdfs:comment "Quotation is a particular case of derivation (see http://www.w3.org/TR/prov-dm/#term-quotation) in which an entity is derived from an original entity by copying, or \"quoting\", some or all of it. " ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource onto:wasQuotedFrom ;
    owl:annotatedTarget onto:wasDerivedFrom .

