@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix ns2: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix onto: <https://w3id.org/todo/tododial> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:license a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

xsd:time a rdfs:Datatype .

owl:versionIRI a owl:AnnotationProperty .

ns2:term_status a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

onto: a owl:Ontology ;
    ns1:license "http://purl.org/NET/rdflicense/cc-by4.0" ;
    dcterms:contributor "Izaskun Fernández (Tekniker) <mailto:izaskun.fernandez@tekniker.es>"^^xsd:string ;
    dcterms:created "2020-04-21T00:00:00" ;
    dcterms:creator "Cristina Aceta (Tekniker) <mailto:cristina.aceta@tekniker.es>"^^xsd:string ;
    dcterms:description "Module for dialogue process and system output management."^^xsd:string ;
    dcterms:issued "" ;
    dcterms:modified "2021-09-23T10:00:00" ;
    dcterms:title "TODODial: Dialogue Module for Task-Oriented Dialogue management Ontology (TODO)"^^xsd:string ;
    vann:preferredNamespacePrefix "tododial"^^xsd:string ;
    vann:preferredNamespaceUri "https://w3id.org/todo/tododial" ;
    owl:imports <https://w3id.org/todo/tododm>,
        <https://w3id.org/todo/tododt> ;
    owl:priorVersion "" ;
    owl:versionInfo 2.1 .

<https://w3id.org/todo/tododial#hasDialogueProcessStep> a owl:ObjectProperty ;
    rdfs:label "hasDialogueProcessStep" ;
    rdfs:comment "Establishes the DialogueProcessStep corresponding to a DialogueTrace." ;
    rdfs:isDefinedBy "https://w3id.org/todo/tododial#" ;
    ns2:term_status "stable" .

<https://w3id.org/todo/tododial#hasTrace> a owl:ObjectProperty ;
    rdfs:label "hasTrace" ;
    rdfs:comment "Establishes the relationship between an element and its Trace." ;
    rdfs:isDefinedBy "https://w3id.org/todo/tododial#" ;
    owl:inverseOf <https://w3id.org/todo/tododial#isTraceOf> ;
    ns2:term_status "stable" .

<https://w3id.org/todo/tododial#isTraceOf> a owl:ObjectProperty ;
    rdfs:label "isTraceOf" ;
    rdfs:comment "Establishes the relationship between a Trace and the element it refers to." ;
    rdfs:isDefinedBy "https://w3id.org/todo/tododial#" ;
    ns2:term_status "stable" .

