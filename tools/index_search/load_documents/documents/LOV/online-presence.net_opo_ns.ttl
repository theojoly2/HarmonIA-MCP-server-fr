@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://online-presence.net/opo/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:DoNotDisturb a onto:Disturbability ;
    rdfs:label "DoNotDisturb"@en ;
    rdfs:comment "The Agent is busy and does not want to be contacted by other\\n\\t\\t\\tAgents."@en ;
    rdfs:isDefinedBy onto: .

onto:StatusMessage a owl:Class ;
    rdfs:label "StatusMessage"@en ;
    rdfs:comment "A status message that cannot be commented on."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdfs.org/sioc/ns#Item> .

onto:attendedOrganisedEvent a owl:ObjectProperty ;
    rdfs:label "Attended Organised Event"@en ;
    rdfs:comment "The organised event attended by people in the Sharing Space."@en ;
    rdfs:domain onto:SharingSpace ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://data.semanticweb.org/ns/swc/ontology#OrganisedEvent> .

onto:avatar a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "avatar"@en ;
    rdfs:comment "The graphical representation of the Agent used to depict him\\n\\t\\t\\tin online systems."@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Image .

onto:basedNear a owl:ObjectProperty ;
    rdfs:label "Based Near"@en ;
    rdfs:comment "The location where members of the Sharing Space are based."@en ;
    rdfs:domain onto:SharingSpace ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

onto:closestFriendsOf a owl:ObjectProperty ;
    rdfs:label "Closest Friends Of"@en ;
    rdfs:comment "The Person who's closest friends belog to the Sharing Space."@en ;
    rdfs:domain onto:SharingSpace ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person .

onto:commonInterest a owl:ObjectProperty ;
    rdfs:label "Common Interest"@en ;
    rdfs:comment "An interst shared by people in the Sharing Space."@en ;
    rdfs:domain onto:SharingSpace ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Document .

onto:currentAction a owl:ObjectProperty ;
    rdfs:label "currentAction"@en ;
    rdfs:comment "Current action performed by the Agent"@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Action .

onto:currentLocation a owl:ObjectProperty ;
    rdfs:label "currentLocation"@en ;
    rdfs:comment "Current location of the Agent"@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

onto:currentlyIn a owl:ObjectProperty ;
    rdfs:label "Currently In"@en ;
    rdfs:comment "The current location of people in the Sharing Space."@en ;
    rdfs:domain onto:SharingSpace ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

onto:customMessage a owl:ObjectProperty ;
    rdfs:label "customMessage"@en ;
    rdfs:comment "A message associated with the OnlinePresence, often used in\\n\\t\\t\\tchat programs and social networks as custom title as well as in microblogging as status message."@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdfs.org/sioc/ns#Item> .

onto:declaredOn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "declaredOn"@en ;
    rdfs:comment "The sioc:UserAccount account where the OnlinePresence was declared."@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdfs.org/sioc/ns#UserAccount> ;
    rdfs:subPropertyOf <http://rdfs.org/sioc/ns#has_creator> .

onto:duration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "duration"@en ;
    rdfs:comment "The estimated duration of the OnlinePresence after the\\n\\t\\t\\tstartTime"@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:duration .

onto:familyOf a owl:ObjectProperty ;
    rdfs:label "Family Of"@en ;
    rdfs:comment "The Person who's family members belog to the Sharing Space."@en ;
    rdfs:domain onto:SharingSpace ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person .

onto:inactivityPeriod a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "inactivityPeriod"@en ;
    rdfs:comment "Period of inactivity on a certain service"@en ;
    rdfs:domain onto:Activity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:duration .

onto:intendedFor a owl:ObjectProperty ;
    rdfs:label "intendedFor"@en ;
    rdfs:comment "A group of people belonging to a space for sharing online psresence data - the intended audience of presence information."@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SharingSpace .

onto:onlineStatusName a owl:DatatypeProperty ;
    rdfs:label "OnlineStatusName"@en ;
    rdfs:comment "A name used by chat systems to distinguish their various\\n\\t\\t\\tstatuses."@en ;
    rdfs:domain onto:OnlineStatus ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:publishedFrom a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "publishedFrom"@en ;
    rdfs:comment "The source from which the OnlinePresence is declared (e.g., a mobile device)"@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SourceOfPublishing .

onto:schoolHomepage a owl:ObjectProperty ;
    rdfs:label "School Homepage"@en ;
    rdfs:comment "The homepage of school attended by people in the Sharing Space."@en ;
    rdfs:domain onto:SharingSpace ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Document .

onto:sourceDescription a owl:ObjectProperty ;
    rdfs:label "sourceDescription"@en ;
    rdfs:comment "the description of the SourceOfPublishing."@en ;
    rdfs:domain onto:SourceOfPublishing ;
    rdfs:isDefinedBy onto: .

onto:sourceName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "sourceName"@en ;
    rdfs:comment "The name of the SourceOfPublishing."@en ;
    rdfs:domain onto:SourceOfPublishing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:startTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "startTime"@en ;
    rdfs:comment "The time when the OnlinePresence started"@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:dateTime .

onto:workplaceHomepage a owl:ObjectProperty ;
    rdfs:label "Workplace Homepage"@en ;
    rdfs:comment "The homepage of workplace of people in the Sharing Space."@en ;
    rdfs:domain onto:SharingSpace ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Document .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

<http://data.semanticweb.org/ns/swc/ontology#OrganisedEvent> a owl:Class .

onto:Available a onto:Disturbability ;
    rdfs:label "Available"@en ;
    rdfs:comment "The agent is not busy and therefore available for contatc by\\n\\t\\t\\tother Agents."@en ;
    rdfs:isDefinedBy onto: .

onto:ConstrainedContactability a onto:Contactability ;
    rdfs:label "ConstrainedContactability"@en ;
    rdfs:comment "The Agent cannot be contated by anyone on the Web, but the\\n\\t\\t\\tcontactability is controled by some rules/policies."@en ;
    rdfs:isDefinedBy onto: .

onto:ConstrainedFindability a onto:Findability ;
    rdfs:label "ConstrainedFindability"@en ;
    rdfs:comment "The Agent's contact details cannot be found by anyone on\\n\\t\\t\\tthe Web, but the findability is controled by some\\n\\t\\t\\trules/policies."@en ;
    rdfs:isDefinedBy onto: .

onto:DoNotDistrub a owl:Thing .

onto:FreelyContactable a onto:Contactability ;
    rdfs:label "FreelyContactable"@en ;
    rdfs:comment "The Agent can be contacted by anyone on the Web"@en ;
    rdfs:isDefinedBy onto: .

onto:Invisible a onto:Visibility ;
    rdfs:label "Invisible"@en ;
    rdfs:comment "The Agent's OnlineStatus is not visible to other Agents"@en ;
    rdfs:isDefinedBy onto: .

onto:PubliclyFindable a onto:Findability ;
    rdfs:label "PubliclyFindable"@en ;
    rdfs:comment "The Agent's contact details canbe found by anyone on the\\n\\t\\t\\tWeb"@en ;
    rdfs:isDefinedBy onto: .

onto:Visible a onto:Visibility ;
    rdfs:label "Visible"@en ;
    rdfs:comment "The Agent's OnlineStatus is visible to other Agents"@en ;
    rdfs:isDefinedBy onto: .

onto:declaredBy a owl:ObjectProperty ;
    rdfs:label "declaredBy"@en ;
    rdfs:comment "The Agent that declared the OnlinePresence"@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent ;
    owl:inverseOf onto:declaresOnlinePresence .

onto:declaresOnlinePresence a owl:ObjectProperty ;
    rdfs:label "declaresOnlinePresence"@en ;
    rdfs:comment "The OnlinePresence declared by the Agent"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OnlinePresence ;
    owl:inverseOf onto:declaredBy .

onto:hasPresenceComponent a owl:ObjectProperty ;
    rdfs:label "hasOnlinePresence"@en ;
    rdfs:comment "OnlinePresenceComponent included in this OnlinePresence"@en ;
    rdfs:domain onto:OnlinePresence ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OnlinePresenceComponent ;
    owl:inverseOf onto:isPresenceComponentOf .

onto:isPresenceComponentOf a owl:ObjectProperty ;
    rdfs:label "isPresenceComponentOf"@en ;
    rdfs:comment "The OnlinePresence that has this OnlinePresenceComponent"@en ;
    rdfs:domain onto:OnlinePresenceComponent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OnlinePresence ;
    owl:inverseOf onto:hasPresenceComponent .

onto:isStatusComponentOf a owl:ObjectProperty ;
    rdfs:label "isStatusComponentOf"@en ;
    rdfs:comment "The OnlineStatus that includes this OnlineStatusComponent."@en ;
    rdfs:domain onto:OnlineStatusComponent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OnlineStatus ;
    owl:inverseOf onto:hasStatusComponent .

<http://purl.org/NET/c4dm/event.owl#Event> a owl:Class .

<http://rdfs.org/sioc/ns#UserAccount> a owl:Class .

<http://rdfs.org/sioc/ns#has_creator> a owl:ObjectProperty .

foaf:Group a owl:Class .

foaf:Image a owl:Class .

onto:Active a onto:Activity ;
    rdfs:label "Active"@en ;
    rdfs:comment "The Agent is active on the system."@en ;
    rdfs:isDefinedBy onto: .

onto:AllNotificationsPass a onto:Notifiability ;
    rdfs:label "AllNotificationsPass"@en ;
    rdfs:comment "Agent can receive notifications from applications"@en ;
    rdfs:isDefinedBy onto: .

onto:Inactive a onto:Activity ;
    rdfs:label "Inactive"@en ;
    onto:inactivityPeriod "PT5M"^^xsd:duration ;
    rdfs:comment "The Agent is inactive for at least 5 min."@en ;
    rdfs:isDefinedBy onto: .

onto:NotificationsConstrained a onto:Notifiability ;
    rdfs:label "NotificationsConstrained"@en ;
    rdfs:comment "The acceptance of notifications from applications is somehow\\n\\t\\t\\tconstrained (by using some rules or policies)."@en ;
    rdfs:isDefinedBy onto: .

onto:NotificationsProhibited a onto:Notifiability ;
    rdfs:label "NotificationsProhibited"@en ;
    rdfs:comment "Agent cannot receive any notification form applications"@en ;
    rdfs:isDefinedBy onto: .

onto:ProlongedInactive a onto:Activity ;
    rdfs:label "ProlongedInactive"@en ;
    onto:inactivityPeriod "PT20M"^^xsd:duration ;
    rdfs:comment "The Agent is inactive for at least 20 min."@en ;
    rdfs:isDefinedBy onto: .

<http://rdfs.org/sioc/ns#Item> a owl:Class .

foaf:Agent a owl:Class .

foaf:Person a owl:Class .

onto:Action a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "An action currently performed by the Agent (e.g., listening to music, reading a book)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ;
    owl:disjointWith onto:OnlinePresence,
        onto:SourceOfPublishing .

<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a owl:Class .

foaf:Document a owl:Class .

onto:Contactability a owl:Class ;
    rdfs:label "Contactability"@en ;
    rdfs:comment "OnlineStatusComponent used to represent the state of\\n\\t\\t\\tcontactability of an Agent. Contatctability relates to the\\n\\t\\t\\tpossiblity of other Agents to conatct the Agent freely or\\n\\t\\t\\tonly with regard to some conditions."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:OnlineStatusComponent ;
    owl:disjointWith onto:Activity,
        onto:Disturbability,
        onto:Visibility .

onto:Findability a owl:Class ;
    rdfs:label "Findability"@en ;
    rdfs:comment "The OnlinePresenceComponent used to represent the\\n\\t\\t\\tpossibility to find contact details of an Agent in a public\\n\\t\\t\\tlisting"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:OnlinePresenceComponent ;
    owl:disjointWith onto:Notifiability,
        onto:OnlineStatus .

onto:SourceOfPublishing a owl:Class ;
    rdfs:label "SourceOfPublishing"@en ;
    rdfs:comment "The source that can publish Online Presence data."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointWith onto:Action,
        onto:OnlinePresence .

onto:Disturbability a owl:Class ;
    rdfs:label "Disturbability"@en ;
    rdfs:comment "OnlineStatusComponent used to represent the wish of an Agent\\n\\t\\t\\tto be or not to be disturbed."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:OnlineStatusComponent ;
    owl:disjointWith onto:Activity,
        onto:Contactability,
        onto:Visibility .

onto:OnlinePresenceComponent a owl:Class ;
    rdfs:label "OnlinePresenceComponent"@en ;
    rdfs:comment "A component of OnlinePresence used to represent one of its\\n\\t\\t\\tdimensions."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointWith onto:OnlinePresence .

onto:Visibility a owl:Class ;
    rdfs:label "Visibility"@en ;
    rdfs:comment "OnlineStatusComponent used to represent the possiblity of\\n\\t\\t\\tothers to see the OnlineStatus of the Agent"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:OnlineStatusComponent ;
    owl:disjointWith onto:Activity,
        onto:Contactability,
        onto:Disturbability .

onto:Notifiability a owl:Class ;
    rdfs:label "Notifiability"@en ;
    rdfs:comment "The OnlinePresenceComponent used to represent the attitude\\n\\t\\t\\tof an Agent towards interaction with applications i.e., the\\n\\t\\t\\tpossibility of applications to show notifications."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:OnlinePresenceComponent ;
    owl:disjointWith onto:Findability,
        onto:OnlineStatus .

onto:OnlineStatus a owl:Class ;
    rdfs:label "OnlineStatus"@en ;
    rdfs:comment "The OnlinePresenceComponent used to represent the attitude\\n\\t\\t\\tof an Agent towards the possibility of communication with\\n\\t\\t\\tother Agents. The OnlineStatus is defined by its components."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass onto:Disturbability ;
            owl:onProperty onto:hasStatusComponent ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass onto:Activity ;
            owl:onProperty onto:hasStatusComponent ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass onto:Visibility ;
            owl:onProperty onto:hasStatusComponent ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass onto:Notifiability ;
            owl:onProperty onto:hasStatusComponent ],
        onto:OnlinePresenceComponent ;
    owl:disjointWith onto:Findability,
        onto:Notifiability,
        onto:OnlineStatusComponent .

onto:OnlineStatusComponent a owl:Class ;
    rdfs:label "OnlineStatusComponent"@en ;
    rdfs:comment "The component of the OnlineStatus representing one of its\\n\\t\\t\\tdimensions."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointWith onto:OnlineStatus .

onto:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "OnlineStatusComponent used to represent the state of\\n\\t\\t\\tActivity of the Agent (e.g., Active, Inactive,\\n\\t\\t\\tProlongedInactive)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:OnlineStatusComponent ;
    owl:disjointWith onto:Contactability,
        onto:Disturbability,
        onto:Visibility .

onto:hasStatusComponent a owl:ObjectProperty ;
    rdfs:label "hasStatusComponent"@en ;
    rdfs:comment "OnlineStatusComponent included in this OnlineStatus"@en ;
    rdfs:domain onto:OnlineStatus ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OnlineStatusComponent ;
    owl:inverseOf onto:isStatusComponentOf .

onto:SharingSpace a owl:Class ;
    rdfs:label "SharingSpace"@en ;
    rdfs:comment "A group of people belonging to a space for sharing online psresence data - the intended audience of data."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf foaf:Group .

onto:OnlinePresence a owl:Class ;
    rdfs:label "OnlinePresence"@en ;
    rdfs:comment "OnlinePresence, described in termes of various\\n\\t\\t\\tOnlinePresenceComponents to represent the attitude of an\\n\\t\\t\\tAgent towards interaction with other Agents and\\n\\t\\t\\tApplications."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass onto:Findability ;
            owl:onProperty onto:hasStatusComponent ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass onto:OnlineStatus ;
            owl:onProperty onto:hasStatusComponent ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass onto:Notifiability ;
            owl:onProperty onto:hasStatusComponent ],
        owl:Thing ;
    owl:disjointWith onto:Action,
        onto:OnlinePresenceComponent,
        onto:SourceOfPublishing .

onto: a owl:Ontology,
        owl:Thing ;
    dc:contributor "Alexandre Passant",
        "Jelena Jovanovic" ;
    dc:creator "Milan Stankovic"^^xsd:string ;
    dc:date "2010-07-01"^^xsd:date ;
    dc:description "Ontology for representing OnlinePresence."@en ;
    dc:title "OnlinePresence Ontology"@en ;
    rdfs:seeAlso <http://online-presence.net/opo/spec/> ;
    owl:versionInfo "Revision 0.5.2" .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:NotificationsProhibited onto:NotificationsConstrained ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:Visible onto:Invisible ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:NotificationsProhibited onto:AllNotificationsPass ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:Active onto:ProlongedInactive ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:DoNotDistrub onto:Available ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:Inactive onto:ProlongedInactive ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:FreelyContactable onto:ConstrainedContactability ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:Active onto:Inactive ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:PubliclyFindable onto:ConstrainedFindability ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( onto:AllNotificationsPass onto:NotificationsConstrained ) .

