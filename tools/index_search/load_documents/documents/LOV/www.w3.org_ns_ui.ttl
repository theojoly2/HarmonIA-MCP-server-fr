@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.w3.org/ns/ui#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:Classifier a rdfs:Class ;
    rdfs:label "classifier" ;
    rdfs:comment "A classifier allows the user to select the type of an object.\\r\\n    The possible types must be subclasses of some overall class, the \"category\".\\r\\n    (Ideally, the superclass is also set up as the disjoint union of the subclasses,\\r\\n    if they are disjoint.)\\r\\n\\r\\n    The form normally stores the resulting classes using an rdf:type triple,\\r\\n    but a different predicate can be used if required, so the classifier field\\r\\n    needs is 'property' defined too.\\r\\n\\r\\n    If the subclass selected itself is has subclasses defined, the user can\\r\\n    recursively select from them in turn, as many levels as needed." ;
    rdfs:subClassOf ns1:Form,
        ns1:Single .

ns1:Form a rdfs:Class ;
    rdfs:comment "A form can be any type of single field, or typically a Group of several fields,\\r\\n    including interspersed headings and comments.  " ;
    owl:disjointUnionOf ( ns1:ValueField ns1:Group ns1:Choice ns1:Classifier ns1:Options ns1:Multiple ns1:Heading ns1:Comment ) ;
    ns1:creationForm ns1:FormForm .

ns1:NumericField a rdfs:Class ;
    rdfs:subClassOf ns1:ValueField ;
    owl:disjointUnionOf ( ns1:BooleanField ns1:TriStateField ns1:IntegerField ns1:DecimalField ns1:FloatField ) .

ns1:Single a rdfs:Class ;
    owl:disjointUnionOf ( ns1:ValueField ns1:Group ns1:Choice ns1:Classifier ns1:Options ns1:Heading ns1:Comment ) .

ns1:TextField a rdfs:Class ;
    rdfs:subClassOf ns1:ValueField ;
    owl:disjointUnionOf ( ns1:SingleLineTextField ns1:MultiLineTextField ) .

ns1:ValueField a rdfs:Class ;
    rdfs:subClassOf ns1:Form,
        ns1:Single ;
    owl:disjointUnionOf ( ns1:TextField ns1:NumericField ns1:ColorField ns1:DateField ns1:DateTimeField ns1:PhoneField ns1:EmailField ) .

<http://njh.me/> dc:author <https://www.w3.org/People/Berners-Lee/card#i> ;
    dc:created "2010-08-07"^^xsd:date ;
    dc:description "The User Interface ontology allows the definition\\r\\n\\tof forms for processing RDF model data, and include a bootstrap form for\\r\\n\\tediting forms. It allows user interface hints such as background colors,\\r\\n\\tcan be associated with objects and classes.\\r\\n\\t" ;
    dc:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dc:modified "$Date: 2020/03/22 16:53:21 $" ;
    dc:title "An ontology for User Interface description, Hints and Forms." .

ns1:annotationForm a rdf:Property ;
    rdfs:label "annotation form" ;
    rdfs:comment "A form which may be used to add more infromation to an\\r\\ninstance of this class which we know something about.  Anything from\\r\\nadding just add one more fact, to adding a whole lot of information about a specific\\r\\nfacet of the thing.\\r\\n" ;
    rdfs:domain rdfs:Class ;
    rdfs:range ns1:Form .

ns1:backgroundColor a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "background color"@en ;
    rdfs:comment "Must be a valid CSS color string such as one could put in\\r\\n        an HTML style attribute.  This should be in the #xxxxxx form,\\r\\n        (with 6 digits of hex)  so that it\\r\\n        can work with Graphviz." ;
    rdfs:range ns1:Color .

ns1:backgroundImage a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "background image"@en ;
    rdfs:comment "URI or base64 representation of an image" .

ns1:color a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "color"@en ;
    rdfs:comment "Must be a valid CSS color string such as one could put in\\r\\n        an HTML style attribute.  This should be in the #xxxxxx form,\\r\\n        (with 6 digits of hex)  so that it\\r\\n        can work with Graphviz." ;
    rdfs:range ns1:Color .

ns1:creationForm a rdf:Property ;
    rdfs:label "creation form" ;
    rdfs:comment "A form which may be used to collect information about a\\r\\n    hitherto locally undocumented instance instance of this class." ;
    rdfs:domain rdfs:Class ;
    rdfs:range ns1:Form .

ns1:initialProperties a rdf:Property ;
    rdfs:label "initial properties" ;
    rdfs:comment "A really simple way of enabling user interfaces to\\r\\n            create new information about a class of things is to make a define of properties\\r\\n            to be specified when a information about a new item\\r\\n            (\"New item\" here means an item which the system\\r\\n            does not have prvious information about yet,\\r\\n            not an items which has just been created,\\r\\n            like new friend as opposed to new baby)" ;
    rdfs:domain rdfs:Class ;
    rdfs:range rdf:List ;
    ns1:prompt "Properties to be specified for new ones" .

ns1:maxValue a rdf:Property ;
    rdfs:label "max" ;
    rdfs:domain ns1:ValueField .

ns1:minValue a rdf:Property ;
    rdfs:label "min" ;
    rdfs:domain ns1:ValueField .

ns1:prompt a rdf:Property ;
    rdfs:label "user prompt" ;
    rdfs:comment "A string for the UI to use if the user needs a longer\\r\\n        prompts than just a field name, the rdfs:label. " ;
    ns1:prompt "A longer prompt for a user inputting this property" .

ns1:seqeunce a rdf:Property ;
    rdfs:label "sequence number" ;
    rdfs:comment "The sequence in which this item is arranged with repect to other parts." ;
    rdfs:range xsd:integer .

ns1:sortBy a rdf:Property ;
    rdfs:label "sort by" ;
    rdfs:comment "A property which typically is used to sort\\r\\n        members of a given class." ;
    rdfs:domain rdfs:Class ;
    rdfs:range rdf:Property .

ns1:sortPriority a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "sort priority" ;
    rdfs:comment "When individuals or classes must be sorted, then\\r\\n        if they are given different values of sortPriority a user agent can\\r\\n        use this as a hint to how to present information." ;
    rdfs:range xsd:integer .

ns1:style a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "style" ;
    rdfs:comment "Must be a valid CSS style string such as one could put in\\r\\n        an HTML style attribute.  Depending on the user interface system, this can\\r\\n        by given to individuals, classes or properties. It is up to a user interface\\r\\n        which wants to draw on them to pick how it uses styles from which parts\\r\\n        of the data it has.  For example, the style of a class may be picked\\r\\n        to distinguish information about things in that class." ;
    ns1:prompt "CSS style" .

ns1:tableProperties a rdf:Property ;
    rdfs:label "table properties" ;
    rdfs:comment "This  is a crude way of specifying a table-based\\r\\n            view for objects of this class." ;
    rdfs:domain rdfs:Class ;
    rdfs:range rdf:List ;
    ns1:prompt "Properties to be given in a default table view" .

ns1:CaseForm a ns1:Group ;
    dc:title "Form for a conditional case in a form" ;
    ns1:parts ( [ a ns1:Choice ;
                ns1:canMintNew ns1:true ;
                ns1:from rdfs:Class ;
                ns1:label "when it is" ;
                ns1:property ns1:for ;
                ns1:sequence 1 ] [ a ns1:Choice ;
                ns1:canMintNew ns1:true ;
                ns1:from ns1:Form ;
                ns1:property ns1:use ;
                ns1:sequence 2 ;
                ns1:use ns1:FieldForm ] ) .

ns1:FF1 a ns1:Heading ;
    ns1:contents "Edit Form"@en ;
    ns1:sequence 1 .

ns1:FF2 a ns1:SingleLineTextField ;
    ns1:property dc:title ;
    ns1:sequence 2 ;
    ns1:size 60 .

ns1:FF3 a ns1:Comment ;
    ns1:contents "To add a field to the form, press the plus at the bottom,\\r\\n        and then select what sort of field you want."@en ;
    ns1:sequence 3 ;
    ns1:style "background-color: #ffe;" .

ns1:TriStateField rdfs:subClassOf ns1:NumericField .

ns1:category a rdf:Property ;
    rdfs:label "overall superclass"@en ;
    rdfs:comment "The superclass subclasses of which will be selected." ;
    rdfs:domain ns1:Classifier ;
    rdfs:range rdfs:Class .

ns1:dependingOn a rdf:Property ;
    rdfs:label "depending on"@en ;
    rdfs:comment "Many fields prompt for information about a given property of the subject" ;
    rdfs:domain ns1:Options ;
    rdfs:range rdf:Property .

ns1:for a rdf:Property ;
    rdfs:label "for"@en ;
    rdfs:comment "The value for which this case is selected." .

ns1:from a rdf:Property ;
    rdfs:label "from" ;
    rdfs:domain ns1:Choice ;
    rdfs:range rdf:Class ;
    ns1:prompt "from what class" .

ns1:maxLength a rdf:Property ;
    rdfs:label "max length of value" ;
    rdfs:domain ns1:TextField ;
    rdfs:range xsd:integer .

ns1:ordered rdfs:label "ordered" ;
    rdfs:range xsd:Boolean ;
    ns1:e rdf:Property .

ns1:part a rdf:Property ;
    rdfs:label "part"@en ;
    rdfs:domain ns1:Form ;
    rdfs:range ns1:Form .

ns1:parts a rdf:Property ;
    rdfs:label "parts"@en ;
    rdfs:domain ns1:Form ;
    rdfs:range rdf:Collection .

ns1:size a rdf:Property ;
    rdfs:label "size of field" ;
    rdfs:domain ns1:ValueField ;
    rdfs:range xsd:integer ;
    ns1:prompt "size of field in characters" .

ns1:ColorField rdfs:subClassOf ns1:ValueField .

ns1:EmailField rdfs:subClassOf ns1:ValueField .

ns1:FieldList a ns1:Multiple ;
    ns1:ordered ns1:true ;
    ns1:part ns1:FieldForm ;
    ns1:property ns1:parts ;
    ns1:sequence 10 .

ns1:FormForm a ns1:Form,
        ns1:Group ;
    dc:title "Form for editing Forms" ;
    ns1:parts ( ns1:FF1 ns1:FF2 ns1:FF3 ns1:FieldList ) .

ns1:MultiLineTextField rdfs:subClassOf ns1:TextField .

ns1:PhoneField rdfs:subClassOf ns1:ValueField .

ns1:use a rdf:Property ;
    rdfs:range ns1:Form .

ns1:BooleanField rdfs:subClassOf ns1:NumericField .

ns1:FieldForm a ns1:Group ;
    dc:title "Form for selecting a type of field" ;
    ns1:parts ( [ a ns1:Classifier ;
                ns1:category ns1:Form ;
                ns1:property rdf:type ;
                ns1:sequence 1 ] [ a ns1:Options ;
                ns1:case [ ns1:for ns1:DecimalField ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:DatatypeProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] [ a ns1:DecimalField ;
                                            ns1:label "minimum value" ;
                                            ns1:property ns1:min ;
                                            ns1:sequence 2 ] [ a ns1:DecimalField ;
                                            ns1:label "maximum value" ;
                                            ns1:property ns1:max ;
                                            ns1:sequence 3 ] ) ] ],
                    [ ns1:for ns1:IntegerField ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:DatatypeProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] [ a ns1:IntegerField ;
                                            ns1:label "minimum value" ;
                                            ns1:property ns1:min ;
                                            ns1:sequence 2 ] [ a ns1:IntegerField ;
                                            ns1:label "maximum value" ;
                                            ns1:property ns1:max ;
                                            ns1:sequence 3 ] ) ] ],
                    [ ns1:for ns1:Comment ;
                        ns1:use [ a ns1:MultiLineTextField ;
                                ns1:property ns1:contents ] ],
                    [ ns1:for ns1:ColorField ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:DatatypeProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] ) ] ],
                    [ ns1:for ns1:EmailField ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:ObjectProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] ) ] ],
                    [ ns1:for ns1:TextField ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:DatatypeProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ] [ a ns1:IntegerField ;
                                            ns1:label "field size" ;
                                            ns1:max 4096 ;
                                            ns1:min 1 ;
                                            ns1:property ns1:size ] [ a ns1:IntegerField ;
                                            ns1:label "Max. length of string" ;
                                            ns1:min 1 ;
                                            ns1:property ns1:maxLength ] ) ] ],
                    [ ns1:for ns1:Choice ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:ObjectProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from rdfs:Class ;
                                            ns1:label "destination class" ;
                                            ns1:property ns1:from ;
                                            ns1:sequence 2 ] [ a ns1:BooleanField ;
                                            ns1:label "user can add new" ;
                                            ns1:property ns1:canMintNew ;
                                            ns1:sequence 3 ] [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from ns1:Form ;
                                            ns1:label "Nested Form (if any)" ;
                                            ns1:optional ns1:true ;
                                            ns1:property ns1:use ;
                                            ns1:sequence 4 ;
                                            ns1:use ns1:FormForm ] ) ] ],
                    [ ns1:for ns1:DateField ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:DatatypeProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] [ a ns1:DateField ;
                                            ns1:label "min" ;
                                            ns1:property ns1:min ;
                                            ns1:sequence 2 ] [ a ns1:DateField ;
                                            ns1:label "max" ;
                                            ns1:property ns1:max ;
                                            ns1:sequence 3 ] ) ] ],
                    [ ns1:for ns1:PhoneField ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:ObjectProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] ) ] ],
                    [ ns1:for ns1:DateTimeField ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:DatatypeProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] [ a ns1:DateTimeField ;
                                            ns1:label "min" ;
                                            ns1:property ns1:min ;
                                            ns1:sequence 2 ] [ a ns1:DateTimeField ;
                                            ns1:label "max" ;
                                            ns1:property ns1:max ;
                                            ns1:sequence 3 ] ) ] ],
                    [ ns1:for ns1:Classifier ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Comment ;
                                            ns1:contents "A classifier allows the user to which classes the item belongs to, given a common superclass of the allowed classes.  Give the superclass here:" ;
                                            ns1:sequence 2 ] [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from rdfs:Class ;
                                            ns1:label "superclass" ;
                                            ns1:property ns1:category ;
                                            ns1:sequence 4 ] [ a ns1:Comment ;
                                            ns1:contents "(When the choice is made normally the item is given a rdf:type. Set this to rdf:type unless you want the form to set a different property.)" ;
                                            ns1:sequence 6 ] [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:default rdf:type ;
                                            ns1:from owl:ObjectProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 8 ] ) ] ],
                    [ ns1:for ns1:Heading ;
                        ns1:use [ a ns1:SingleLineTextField ;
                                ns1:property ns1:contents ] ],
                    [ ns1:for ns1:FloatField ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from owl:DatatypeProperty ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] [ a ns1:FloatField ;
                                            ns1:label "minimum value" ;
                                            ns1:property ns1:min ;
                                            ns1:sequence 2 ] [ a ns1:FloatField ;
                                            ns1:label "maximum value" ;
                                            ns1:property ns1:max ;
                                            ns1:sequence 3 ] ) ] ],
                    [ ns1:for ns1:Options ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:default rdf:type ;
                                            ns1:from rdf:Property ;
                                            ns1:label "depending on" ;
                                            ns1:property ns1:dependingOn ;
                                            ns1:sequence 1 ] [ a ns1:Multiple ;
                                            ns1:part ns1:CaseForm ;
                                            ns1:property ns1:case ;
                                            ns1:sequence 2 ] ) ] ],
                    [ ns1:for ns1:Multiple ;
                        ns1:use [ a ns1:Group ;
                                ns1:parts ( [ a ns1:BooleanField ;
                                            ns1:label "ordered" ;
                                            ns1:property ns1:ordered ;
                                            ns1:sequence 0 ] [ a ns1:IntegerField ;
                                            ns1:label "minimum number" ;
                                            ns1:property ns1:min ;
                                            ns1:sequence 0 ] [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from rdf:Property ;
                                            ns1:label "property" ;
                                            ns1:property ns1:property ;
                                            ns1:sequence 1 ] [ a ns1:Choice ;
                                            ns1:canMintNew ns1:true ;
                                            ns1:from ns1:Form ;
                                            ns1:property ns1:part ;
                                            ns1:sequence 2 ;
                                            ns1:use ns1:FieldForm ] ) ] ],
                    [ ns1:for ns1:Group ;
                        ns1:use ns1:FieldList ] ;
                ns1:dependingOn rdf:type ;
                ns1:sequence 2 ] ) .

ns1:SingleLineTextField rdfs:subClassOf ns1:TextField .

ns1:DateField rdfs:subClassOf ns1:ValueField .

ns1:DateTimeField rdfs:subClassOf ns1:ValueField .

ns1:DecimalField rdfs:subClassOf ns1:NumericField .

ns1:FloatField rdfs:subClassOf ns1:NumericField .

ns1:Heading rdfs:subClassOf ns1:Form,
        ns1:Single .

ns1:Multiple rdfs:subClassOf ns1:Form .

ns1:Options rdfs:subClassOf ns1:Form,
        ns1:Single .

ns1:Comment rdfs:subClassOf ns1:Form,
        ns1:Single .

ns1:IntegerField rdfs:subClassOf ns1:NumericField .

ns1:property a rdf:Property ;
    rdfs:label "property to be stored"@en ;
    rdfs:comment "Many fields prompt for information about a given property of the subject.\\r\\n    When field is filled in, this gives which property is written into the data." ;
    rdfs:domain ns1:Form ;
    rdfs:range rdf:Property .

ns1:Group rdfs:subClassOf ns1:Form,
        ns1:Single .

ns1:Choice rdfs:subClassOf ns1:Form,
        ns1:Single .

