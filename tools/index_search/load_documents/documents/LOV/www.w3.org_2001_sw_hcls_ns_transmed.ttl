        onto:TMO_0168,
        onto:TMO_0220 .

onto:TMO_0071 a owl:Class ;
    rdfs:label "pharmaceutical ingredient"@en ;
    dc:description "A pharmaceutical ingredient is a chemical substance that is part of a formulated pharmaceutical that bears a pharmaceutical ingredient role."@en ;
    ns2:hasDbXref "dailymed:ingredients" ;
    rdfs:subClassOf [ a owl:Restriction ;
