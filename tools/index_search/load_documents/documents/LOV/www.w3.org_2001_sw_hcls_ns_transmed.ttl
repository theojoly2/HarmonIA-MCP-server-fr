onto:TMO_0199 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "HapMap population name abbreviation "@en ;
    dc:description "A short acronym identifying a sample population that was examined by the HapMap project."@en .

onto:TMO_0200 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "CEPH (Utah residents with ancestry from northern and western Europe)"@en ;
    dc:description "A population of individuals living in Utah with ancestry from northern and western Europe. The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "CEU"^^xsd:string .

onto:TMO_0201 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Han Chinese in Beijing, China"@en ;
    dc:description "A population of individuals living in the residential community at Beijing Normal University who were self-identified as having at least three out of four Han Chinese grandparents. Although individuals of Beijing Normal University were from many different parts of China, this set of samples was not drawn to be representative of all Han Chinese people. The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "CHB"^^xsd:string .

onto:TMO_0202 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Japanese in Tokyo, Japan"@en ;
    dc:description "A population in the Tokyo metropolitan area, with people who came from (or whose ancestors came from) many different parts of Japan. Thus, this population can be viewed as representative of the majority population in Japan. The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "JPT"^^xsd:string .

onto:TMO_0203 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Yoruba in Ibadan, Nigeria"@en ;
    dc:description "A particular community in Ibadan, Nigeria, with individuals who identified themselves as having four Yoruba grandparents. The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "YRI"^^xsd:string .

onto:TMO_0204 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Population with african ancestry in Southwest USA"@en ;
    dc:description "The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "ASW"^^xsd:string .

onto:TMO_0205 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Chinese in Metropolitan Denver, Colorado"@en ;
    dc:description "The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "CHD"^^xsd:string .

onto:TMO_0206 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Gujarati Indians in Houston, Texas"@en ;
    dc:description "The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "GIH"^^xsd:string .

onto:TMO_0207 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Luhya in Webuye, Kenya"@en ;
    dc:description "The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "LWK"^^xsd:string .

onto:TMO_0208 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Population with mexican ancestry in Los Angeles, California"@en ;
    dc:description "The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "MXL"^^xsd:string .

onto:TMO_0209 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Maasai in Kinyawa, Kenya"@en ;
    dc:description "The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "MKK"^^xsd:string .

onto:TMO_0210 a onto:TMO_0140,
        owl:NamedIndividual ;
    rdfs:label "Toscani in Italia"@en ;
    dc:description "The genetic characteristics of this population were described by the HapMap project and are used as a reference for other genetic studies."@en ;
    onto:TMO_0199 "TSI"^^xsd:string .

