    rdfs:subClassOf onto:TMO_0093 .

onto:TMO_0036 a owl:Class ;
    rdfs:label "cell line"@en ;
    dc:description "A cell line is a material entity that consists of a population of cells cultured in vitro that are descended through one or more generations (and possible sub-cultures) from a single primary culture which was originally derived from part of an organism."@en ;
    ns2:hasDbXref "BIRNLex:11036"^^xsd:string,
        "EFO:0000322"^^xsd:string,
        "MSH:D002460"^^xsd:string,
        "NCIt:Cell_Line"^^xsd:string,
        "UMLS:C0007600"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0045 ;
    owl:disjointWith onto:TMO_0046,
        onto:TMO_0139 .

onto:TMO_0046 a owl:Class ;
    rdfs:label "arm of clinical study"@en ;
    dc:description "An arm of clinical study is a population that participates in a clinical trial and is subject to some intervention."@en ;
    ns2:hasDbXref "IAO:0000120",
        "linkedct:trial_arm_group" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.obofoundry.org/ro/ro.owl#has_proper_part> ;
            owl:someValuesFrom onto:TMO_0124 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000316 ;
            owl:someValuesFrom onto:TMO_0060 ],
        onto:TMO_0045 ;
    owl:disjointWith onto:TMO_0036,
        onto:TMO_0139 .

onto:TMO_0048 a owl:Class ;
    rdfs:label "allele"@en ;
    dc:description "An allele is a specific variant of a gene."@en ;
    ns2:hasDbXref "SO:0001023" ;
    rdfs:subClassOf onto:TMO_0172 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty onto:TMO_0216 ;
                        owl:someValuesFrom onto:TMO_0037 ] onto:TMO_0215 ) ] .

onto:TMO_0056 a owl:Class ;
    rdfs:label "toxicity"@en ;
    dc:description "Toxicity is a quality of a chemical substance which indicates the capacity to cause injury to an organism in a dose dependent manner."@en ;
    ns2:hasDbXref "ACGT:Toxicity"^^xsd:string,
        "MSH:Q000633"^^xsd:string,
        "NCIt:Toxicity"^^xsd:string,
        "UMLS:C0600688"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Quality> .

onto:TMO_0060 a owl:Class ;
    rdfs:label "clinical subject role"@en ;
    dc:description "A clinical subject role is the role played by an organism who is the subject of a clinical procedure or assessment."@en ;
    ns2:hasDbXref "OCRe_clinical:Subject" ;
    rdfs:subClassOf onto:TMO_0006 .

onto:TMO_0062 a owl:Class ;
    rdfs:label "pharmaceutical ingredient role"@en ;
    dc:description "A pharmaceutical ingredient role is a role played by a chemical substance that is part of a pharmaceutical formulation."@en ;
    rdfs:subClassOf onto:TMO_0073 .

onto:TMO_0068 a owl:Class ;
    rdfs:label "diagnostic criterion"@en ;
    dc:description "A diagnostic criterion is a directive information entity for consideration during a diagnosis which, if satisfied, contributes to a diagnostic result"@en ;
    ns2:hasDbXref "IAO:0000124" ;
    rdfs:subClassOf onto:TMO_0151 .

onto:TMO_0072 a owl:Class ;
    rdfs:label "molecular target role"@en ;
    dc:description "A molecular target role is a role played by a chemical entity in which it is a specific target of an intervention that aims to change it behavior."@en ;
    rdfs:subClassOf onto:TMO_0073 .

onto:TMO_0075 a owl:Class ;
    rdfs:label "planned process"@en ;
    dc:description "A planned process is a process in which specific objectives are realized in a plan designed by some agent."@en ;
    ns2:hasDbXref "BIRNLex:11021"^^xsd:string,
        "OBI:0000011"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

onto:TMO_0077 a owl:Class ;
    rdfs:label "clinical trial criterion"@en ;
    dc:description "A clinical trial criterion is a directive information entity which, if satisfied, contributes to the inclusion or exclusion of candidate patients."@en ;
    rdfs:subClassOf onto:TMO_0151 .

onto:TMO_0086 a owl:Class ;
    rdfs:label "sex"@en ;
    dc:description "Sex is an quality that inheres in an organism for which sexual differentiation is required for sexual reproduction."@en ;
    rdfs:subClassOf onto:TMO_0084 .

onto:TMO_0090 a owl:Class ;
    rdfs:label "process description"@en ;
    rdfs:subClassOf onto:TMO_0089 .

onto:TMO_0094 a owl:Class ;
