    rdfs:subClassOf onto:TMO_0099 .

onto:TMO_0125 a owl:Class ;
    rdfs:label "nucleotide sequence position"@en ;
    dc:description "A nucleotide sequence position indicates the position of a nucleotide residue in relation to the start of the nucleic acid."@en ;
    rdfs:subClassOf onto:TMO_0119 .

onto:TMO_0129 a owl:Class ;
    rdfs:label "amino acid sequence"@en,
        "protein sequence"@en ;
