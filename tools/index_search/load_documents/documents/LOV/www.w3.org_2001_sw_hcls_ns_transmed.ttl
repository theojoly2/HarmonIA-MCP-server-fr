        owl:ReflexiveProperty ;
    rdfs:subPropertyOf <http://www.obofoundry.org/ro/ro.owl#location_of> .

onto:TMO_0080 a owl:Class ;
    rdfs:label "genotype"@en ;
    dc:description "In this context, a genotype is a material entity made up of two DNA regions on two homologous chromosomes in a diploid cell. One chromosome is derived from the father and one is derived from the mother. The two DNA regions are located at the same genetic locus on each of the two chromosomes."@en ;
    rdfs:subClassOf onto:TMO_0228 .

onto:TMO_0100 a owl:Class ;
    rdfs:label "functional quantity"@en ;
    dc:description "A functional quantity is a quantity obtained as a result of a function involving one or more parameters."@en ;
    rdfs:subClassOf onto:TMO_0120 .

onto:TMO_0215 a owl:Class ;
    rdfs:label "DNA region"@en ;
    rdfs:comment "A DNA region is a part of a DNA molecule that is made up of a continous chain of deoxyribonucleotide residues."^^xsd:string ;
    rdfs:subClassOf onto:TMO_0228 .

onto:TMO_0034 a owl:Class ;
    rdfs:label "molecular entity"@en ;
    dc:description "Any constitutionally or isotopically distinct atom, molecule, ion, ion pair, radical, radical ion, complex, conformer etc., identifiable as a separately distinguishable entity."@en ;
