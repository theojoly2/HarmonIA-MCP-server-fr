@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://purl.obolibrary.org/obo/> .
@prefix ns2: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix ns3: <http://spinrdf.org/spin#> .
@prefix onto: <http://www.w3.org/2001/sw/hcls/ns/transmed/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:IAO_0000004 rdfs:subPropertyOf onto:TMO_0185 .

ns1:IAO_0000109 rdfs:subClassOf onto:TMO_0099 .

ns1:IAO_0000119 a owl:AnnotationProperty .

ns1:IAO_0000300 rdfs:subClassOf onto:TMO_0089 .

ns1:IAO_0000302 rdfs:subClassOf ns1:IAO_0000009 .

ns1:IAO_0000303 rdfs:subClassOf ns1:IAO_0000009 .

ns1:IAO_0000306 rdfs:subClassOf onto:TMO_0089 .

ns1:IAO_0000308 rdfs:subClassOf onto:TMO_0089 .

ns1:IAO_0000313 a owl:Class ;
    owl:equivalentClass onto:TMO_0012 .

ns1:IAO_0000400 rdfs:subClassOf onto:TMO_0116 .

ns1:IAO_0000404 rdfs:subPropertyOf onto:TMO_0185 .

ns1:IAO_0000405 rdfs:subPropertyOf onto:TMO_0185 .

ns1:IAO_0000406 rdfs:subPropertyOf onto:TMO_0185 .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:subject a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

<http://purl.org/obo/owl/OBO_REL#bearer_of> rdfs:subPropertyOf onto:TMO_0196 .

ns2:hasDbXref a owl:AnnotationProperty .

<http://www.ifomis.org/bfo/1.1/snap#Continuant> a owl:Class ;
    ns2:hasDbXref "dcterms:Agent",
        "dcterms:AgentClass",
        "foaf:Agent" .

<http://www.ifomis.org/bfo/1.1/snap#Disposition> a owl:Class .

<http://www.obofoundry.org/ro/ro.owl#has_integral_part> rdfs:subPropertyOf <http://www.obofoundry.org/ro/ro.owl#has_proper_part> .

<http://www.obofoundry.org/ro/ro.owl#integral_part_of> rdfs:subPropertyOf <http://www.obofoundry.org/ro/ro.owl#proper_part_of> .

rdfs:label a owl:AnnotationProperty .

onto:TMO_0000 a owl:Class ;
    rdfs:label "active ingredient"@en ;
    dc:description "An active ingredient is a pharmaceutical ingredient that has the disposition to treat a certain disease."@en ;
    ns2:hasDbXref "HL7V3.0:ACTI"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0071 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:TMO_0071 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000316 ;
                        owl:someValuesFrom onto:TMO_0064 ] [ a owl:Restriction ;
                        owl:onProperty <http://www.obofoundry.org/ro/ro.owl#part_of> ;
                        owl:someValuesFrom onto:TMO_0001 ] ) ] .

onto:TMO_0002 a owl:Class ;
    rdfs:label "pharmaceutical product"@en ;
    dc:description "A pharmaceutical product is a formulated pharmaceutical that has been approved to treat patients."@en ;
    ns2:hasDbXref "NCIt:Finished_Pharmaceutical_Product"^^xsd:string,
        "UMLS:C1708062"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0001 .

onto:TMO_0003 a owl:Class ;
    rdfs:label "inactive ingredient"@en ;
    dc:description "An inactive ingredient is a pharmaceutical ingredient that is part of a pharmaceutical formulation but does not have the disposition to treat a certain disease."@en ;
    ns2:hasDbXref "HL7V3.0:IACT"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0071 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:TMO_0071 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000316 ;
                        owl:someValuesFrom onto:TMO_0065 ] [ a owl:Restriction ;
                        owl:onProperty <http://www.obofoundry.org/ro/ro.owl#part_of> ;
                        owl:someValuesFrom onto:TMO_0001 ] ) ] .

onto:TMO_0004 a owl:Class ;
    rdfs:label "absent phenotype"@en ;
    dc:description "An absent phenotype is a phenotype that represents the notable absence of a characteristic."@en ;
    rdfs:subClassOf onto:TMO_0019 .

onto:TMO_0005 a owl:Class ;
    rdfs:label "genetic description"@en ;
    dc:description "A genetic description is a description of the genetic composition of some entity."@en ;
    rdfs:subClassOf onto:TMO_0089 .

onto:TMO_0007 a owl:Class ;
    rdfs:label "prognosis"@en ;
    ns1:IAO_0000119 "NCI Thesaurus" ;
    dc:description "A prognosis is a hypothesis about the likely course of a disease, the chance of recovery or recurrence."@en ;
    ns2:hasDbXref "Galen:Prognosis"^^xsd:string,
        "MSH:D011379"^^xsd:string,
        "NCIt:Prognosis"^^xsd:string,
        "UMLS:C0033325"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0059 .

onto:TMO_0008 a owl:Class ;
    rdfs:label "patient role"@en ;
    dc:description "A patient role is a role played a human subject that receives medical attention, care or treatment or who is registered with a medical institution with the purpose of receiving medical care when necessary."@en ;
    rdfs:subClassOf onto:TMO_0060 .

onto:TMO_0009 a owl:Class ;
    rdfs:label "medical expert role"@en ;
    dc:description "An medical expert role is a role played by a human in a clinical context who is involved in the assessment or administration of treatment or its results."@en ;
    ns2:hasDbXref "OCRe_clinical:Clinician" ;
    rdfs:subClassOf onto:TMO_0074 .

onto:TMO_0013 a owl:Class ;
    rdfs:label "exclusion criterion for clinical trial"@en ;
    dc:description "An exclusion criterion for clinical trial is a clinical trial criterion which, if satisfied, supports the exclusion of candidate patients."@en ;
    ns2:hasDbXref "IAO:0000124" ;
    rdfs:subClassOf onto:TMO_0077 .

onto:TMO_0014 a owl:Class ;
    rdfs:label "inclusion criterion for clinical trial"@en ;
    dc:description "A inclusion criterion for clinical trial is a clinical trial criterion which, if satisfied, supports the inclusion of candidate patients."@en ;
    ns2:hasDbXref "IAO:0000124" ;
    rdfs:subClassOf onto:TMO_0077 .

onto:TMO_0015 a owl:Class ;
    rdfs:label "diagnostic result"@en ;
    dc:description "A diagnostic result is a medical measure of determining the nature of a  problem or illness through medical procedure."@en ;
    ns2:hasDbXref "IAO:0000124" ;
    rdfs:subClassOf onto:TMO_0136 .

onto:TMO_0017 a owl:Class ;
    rdfs:label "evidence"@en ;
    dc:description "Evidence is a group of indicators that are relevant in some decision-making process."@en ;
    ns2:hasDbXref "IAO:0000123",
        "NCIt:Evidence"^^xsd:string,
        "UMLS:C0332120"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0109 .

onto:TMO_0018 a owl:Class ;
    rdfs:label "environmental description"@en ;
    dc:description "An environmental description is a description concerning some aspect of a physical environment."@en ;
    ns2:hasDbXref "IAO:0000123" ;
    rdfs:subClassOf onto:TMO_0089 .

onto:TMO_0020 a owl:Class ;
    rdfs:label "personal medical history"@en ;
    dc:description "A personal medical history is a medical record consisting of a collection of information obtained from the patient and from other sources concerning the patient's health."@en ;
    ns2:hasDbXref "NCIt:Personal_Medical_History"^^xsd:string,
        "UMLS:C0262926"^^xsd:string,
        "pchr:Encounter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom onto:TMO_0124 ],
        onto:TMO_0098 .

onto:TMO_0021 a owl:Class ;
    rdfs:label "clinical trial protocol"@en ;
    dc:description "A clinical trial protocol is a clinical protocol about the objective(s), design, methodology, statistical considerations, and organization of a clinical trial."@en ;
    rdfs:subClassOf onto:TMO_0016 .

onto:TMO_0022 a owl:Class ;
    rdfs:label "sign"@en ;
    ns1:IAO_0000119 "Richard Scheuermann, Werner Ceusters, Barry Smith in \"Toward an Ontological Treatment of Disease and Diagnosis\"" ;
    dc:description "A quality of a patient, a material entity that is part of a patient, or a processual entity that a patient participates in, any one of which is observed in a physical examination and is deemed by the clinician to be of clinical significance."@en ;
    ns2:hasDbXref "NCIt:Sign"^^xsd:string,
        "SNOMEDCT:72670004"^^xsd:string,
        "UMLS:C0311392"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0019 .

onto:TMO_0023 a owl:Class ;
    rdfs:label "symptom"@en ;
    ns1:IAO_0000119 "Richard Scheuermann, Werner Ceusters, Barry Smith in \"Toward an Ontological Treatment of Disease and Diagnosis\"" ;
    dc:description "A quality of a patient that is observed by the patient or a processual entity experienced by the patient, either of which is hypothesized by the patient to be a realization of a disease."@en ;
    ns2:hasDbXref "ACGT:Symptom"^^xsd:string,
        "CPR:symptom"^^xsd:string,
        "NCIt:Symptom"^^xsd:string,
        "UMLS:C1457887"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0019 .

onto:TMO_0024 a owl:Class ;
    rdfs:label "medical measure"@en ;
    dc:description "A medical measure is a measure that describes or is a measure of medically relevant entities."@en ;
    rdfs:subClassOf onto:TMO_0010 .

onto:TMO_0026 a owl:Class ;
    rdfs:label "regulatory authority"@en ;
    dc:description "A regulatory authority is an institution created by legislation which acts to control what treatments can be prescribed."@en ;
    rdfs:subClassOf onto:TMO_0025 .

onto:TMO_0027 a owl:Class ;
    rdfs:label "institutional payer"@en ;
    ns2:hasDbXref "NCIt:Healthcare_Payer"^^xsd:string,
        "UMLS:C2348942"^^xsd:string ;
    rdfs:comment "This is, at the moment, a kind of institution because \\nthe payers are typically insurance companies or government bodies.\\nBut it is possible in some jurisdictions to pay for treatment oneself.\\nTreat by renaming to \"institutional payer\". --CRB" ;
    rdfs:subClassOf onto:TMO_0025 .

onto:TMO_0028 a owl:Class ;
    rdfs:label "market"@en ;
    rdfs:subClassOf onto:TMO_0025 .

onto:TMO_0030 a owl:Class ;
    rdfs:label "intervention"@en ;
    dc:description "An intervention is a study in which a substance is administered to a subject or group of subjects."@en ;
    ns2:hasDbXref "IAO:0000121",
        "NCIt:Intervention"^^xsd:string,
        "OCRe_research:Intervention"^^xsd:string,
        "linkedct:intervention" ;
    rdfs:subClassOf onto:TMO_0029 .

onto:TMO_0031 a owl:Class ;
    rdfs:label "diagnosis"@en ;
    ns1:IAO_0000119 "NCI thesaurus" ;
    dc:description "A diagnosis is a study composed of investigation, analysis and recognition of the presence and nature of disease, condition, or injury from expressed signs and symptoms; also, the scientific determination of any kind; the concise results of such an investigation."@en ;
    ns2:hasDbXref "ACGT:Diagnosis"^^xsd:string,
        "FHHO:Diagnosis"^^xsd:string,
        "Galen:Diagnosis"^^xsd:string,
        "LNC:LP72437-4"^^xsd:string,
        "MSH:D003933"^^xsd:string,
        "NCIt:Diagnosis"^^xsd:string,
        "OBI:0000075"^^xsd:string,
        "OCRe_clinical:Diagnosis"^^xsd:string,
        "SNOMEDCT:439401001"^^xsd:string,
        "UMLS:C0011900"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0029 .

onto:TMO_0032 a owl:Class ;
    rdfs:label "clinical trial"@en ;
    dc:description "A clinical trial is a study to assess the efficacy of a substance for the treatment of a condition."@en ;
    ns2:hasDbXref "HL7V3.0:CLNTRL"^^xsd:string,
        "IAO:0000121",
        "MSH:D016430"^^xsd:string,
        "NCIt:Clinical_Trial"^^xsd:string,
        "SNOMEDCT:110465008"^^xsd:string,
        "linkedct:trials" ;
    rdfs:subClassOf onto:TMO_0029 .

onto:TMO_0033 a owl:Class ;
    rdfs:label "drug measure"@en ;
    dc:description "A drug measure is a biomedical measure that describes or is a measure of drugs or their activies."@en ;
    rdfs:subClassOf onto:TMO_0010 .

onto:TMO_0038 a owl:Class ;
    rdfs:label "genotype with SNP"@en ;
    dc:description "A genotype with a single-nucleotide polymorphism (SNP). A SNP is a variation at a single nucleotide locus in the genomes of members of a species. For a variation to be considered a SNP, it must occur in at least 1% of the population."@en ;
    ns2:hasDbXref "MSH:D020641"^^xsd:string,
        "NCIt:Single_Nucleotide_Polymorphism"^^xsd:string,
        "SO:0000694"^^xsd:string,
        "UMLS:C0752046"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0080 .

onto:TMO_0039 a owl:Class ;
    rdfs:label "genotype with copy number variation"@en ;
    dc:description "A genotype of which variants with a different number of copies of a sequence identifical region exist."@en ;
    ns2:hasDbXref "SO:0001019"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0080 .

onto:TMO_0040 a owl:Class ;
    rdfs:label "drug-drug interaction"@en ;
    dc:description "A drug-drug interaction is a drug interaction in which two drugs interact in such a way to produce an abnormal phenotypic event."@en ;
    ns2:hasDbXref "IAO:0000124",
        "SNOMEDCT:404204005"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0304 .

onto:TMO_0041 a owl:Class ;
    rdfs:label "disease progression"@en ;
    ns2:hasDbXref "IAO:0000124",
        "MSH:D018450"^^xsd:string,
        "NCIt:Disease_Progression"^^xsd:string,
        "NDFRT:C7812"^^xsd:string,
        "OBI:0000354"^^xsd:string,
        "UMLS:C0242656"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

onto:TMO_0042 a owl:Class ;
    rdfs:label "mechanism of action"@en ;
    dc:description "The mechanism of action is a description of processes and behaviour of a biologically active molecule in its administration into a living system."@en ;
    ns2:hasDbXref "NCIt:Mechanism_of_Action"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0090 .

onto:TMO_0043 a owl:Class ;
    rdfs:label "adverse drug event"@en ;
    ns1:IAO_0000119 "CDISC glossary" ;
    dc:description "An adverse drug event is a any untoward medical occurrence in a patient or clinical investigation subject administered a pharmaceutical product and which does not necessarily have a causal relationship with this treatment. An adverse event (AE) can therefore be any unintended sign (including an abnormal laboratory finding), symptom,or disease temporally associated with the use of a medicinal (investigational) product, whether or not related to the medicinal (investigational) product."@en ;
    ns2:hasDbXref "MSH:D004362"^^xsd:string,
        "SNOMEDCT:406644009"^^xsd:string,
        "sider:side_effects" ;
    rdfs:subClassOf onto:TMO_0061 .

onto:TMO_0044 a owl:Class ;
    rdfs:label "pathway"@en ;
    ns1:IAO_0000119 "NCI Thesaurus" ;
    dc:description "A pathway is a representation of a set or series of interactions, often forming a network, which biologists have found useful to group together for organizational, historic, biophysical, or other reasons."@en ;
    ns2:hasDbXref "GRO:Pathway"^^xsd:string,
        "Galen:Pathway"^^xsd:string,
        "IEV:0000001"^^xsd:string,
        "MI:0619"^^xsd:string,
        "NCIt:Pathway"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0090 .

onto:TMO_0047 a owl:Class ;
    rdfs:label "disease"@en ;
    ns1:IAO_0000119 "Richard Scheuermann, Werner Ceusters, Barry Smith in \"Toward an Ontological Treatment of Disease and Diagnosis\"" ;
    dc:description "A quality of an organism which predisposes it to undergo pathological processes because of one or more disorders in that organism."@en ;
    ns2:hasDbXref "ACGT:Disease"^^xsd:string,
        "BIRNLex:11013"^^xsd:string,
        "DOID:4"^^xsd:string,
        "GRO:Disease"^^xsd:string,
        "LNC:LP21006-9"^^xsd:string,
        "MSH:D004194"^^xsd:string,
        "NCIt:Disease_or_Disorder"^^xsd:string,
        "NDFRT:C2140"^^xsd:string,
        "OBI:0000155"^^xsd:string,
        "UMLS:C0012634"^^xsd:string,
        "diseasome:diseases",
        "linkedct:condition",
        "pharmgkb:Disease" ;
    rdfs:subClassOf onto:TMO_0084 .

onto:TMO_0049 a owl:Class ;
    rdfs:label "metabolite role"@en ;
    dc:description "A metabolite role is the role played by a material entity that is a metabolic substrate, intermediate or product."@en ;
    ns2:hasDbXref "CHEBI:25212"^^xsd:string,
        "Galen:Metabolite"^^xsd:string,
        "LNC:LP20702-4"^^xsd:string,
        "NCIt:Metabolite"^^xsd:string,
        "UMLS:C0870883"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0073 .

onto:TMO_0050 a owl:Class ;
    rdfs:label "drug efficacy"@en ;
    dc:description "Drug efficacy is a measure of the capabilty of a drug to produce an intended effect as a function of its concentration."@en ;
    ns2:hasDbXref "IAO:0000124" ;
    rdfs:subClassOf onto:TMO_0100 .

onto:TMO_0051 a owl:Class ;
    rdfs:label "treatment safety value"@en ;
    ns1:IAO_0000119 "NCI Thesaurus" ;
    dc:description "Treatment safety is a condition that refers to an absence of harmful side effects resulting from use of the product and may be assessed by laboratory testing of biological samples, special tests and procedures, psychiatric evaluation, and/or physical examination of subjects."@en ;
    ns2:hasDbXref "IAO:0000124" ;
    rdfs:subClassOf onto:TMO_0100 .

onto:TMO_0052 a owl:Class ;
    rdfs:label "biomarker"@en ;
    dc:description "A biomarker is a characteristic of a material entity that is objectively measured and evaluated as an indicator of normal biological processes, pathogenic processes, or pharmacologic responses to a therapeutic intervention."@en ;
    ns2:hasDbXref "IAO:0000121",
        "MSH:D054316"^^xsd:string,
        "NCIt:Biomarker"^^xsd:string,
        "UMLS:C1955886"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0019 .

onto:TMO_0053 a owl:Class ;
    rdfs:label "comparative effectiveness"@en ;
    dc:description "Comparative effectiveness is a drug measure that provides information about which treatment works best, for whom, and under what circumstances."@en ;
    ns2:hasDbXref "IAO:0000121" ;
    rdfs:subClassOf onto:TMO_0092 .

onto:TMO_0054 a owl:Class ;
    rdfs:label "lifestyle"@en ;
    dc:description "Lifestyle is a description about an individual`s manner of living."@en ;
    ns2:hasDbXref "IAO:0000121",
        "MSH:D008019"^^xsd:string,
        "NCIt:Lifestyle"^^xsd:string,
        "SNOMEDCT:134436002"^^xsd:string,
        "SNOMEDCT:366925008"^^xsd:string,
        "SNOMEDCT:367150003"^^xsd:string,
        "UMLS:C0023676"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0097 .

onto:TMO_0055 a owl:Class ;
    rdfs:label "health outcome"@en ;
    dc:description "A health outcome is a medical measure of health or loss of health."@en ;
    ns2:hasDbXref "IAO:0000121",
        "linkedct:primary_outcomes",
        "linkedct:secondary_outcomes" ;
    rdfs:subClassOf onto:TMO_0135 .

onto:TMO_0057 a owl:Class ;
    rdfs:label "dosage"@en ;
    dc:description "Dosage is the amount of a chemical administered to, or taken by, an organism and expressed as some function of the organism and of time (mg/kg body weight/day)."@en ;
    ns2:hasDbXref "EFO:0000428"^^xsd:string,
        "LNC:LP6801-7"^^xsd:string,
        "NCIt:Dose"^^xsd:string,
        "SNOMEDCT:260911001"^^xsd:string,
        "UMLS:C0178602"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0113 .

onto:TMO_0058 a owl:Class ;
    rdfs:label "syndrome"@en ;
    dc:description "A syndrome is a group of signs and symptoms that characterize a particular abnormality."@en ;
    ns2:hasDbXref "ACGT:Syndrome"^^xsd:string,
        "DOID:225"^^xsd:string,
        "EFO:0000428"^^xsd:string,
        "EFO:0000716"^^xsd:string,
        "MSH:D013577"^^xsd:string,
        "NCIt:Syndrome"^^xsd:string,
        "UMLS:C0039082"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0084 .

onto:TMO_0066 a owl:Class ;
    rdfs:label "molecular target"@en ;
    dc:description "A molecular target is a molecular entity that is the target of a transformation process."@en ;
    ns2:hasDbXref "drugbank:targets" ;
    rdfs:subClassOf onto:TMO_0034 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:TMO_0034 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000316 ;
                        owl:someValuesFrom onto:TMO_0072 ] ) ] .

onto:TMO_0067 a owl:Class ;
    rdfs:label "protein target"@en ;
    rdfs:subClassOf onto:TMO_0035 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:TMO_0035 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000316 ;
                        owl:someValuesFrom onto:TMO_0072 ] ) ] .

onto:TMO_0069 a owl:Class ;
    rdfs:label "diagnostic inclusion criterion"@en ;
    dc:description "A diagnostic inclusion criterion is a diagnostic criterion for consideration during a diagnosis which, if satisfied, supports a diagnostic result."@en ;
    ns2:hasDbXref "IAO:0000124" ;
    rdfs:subClassOf onto:TMO_0068 .

onto:TMO_0070 a owl:Class ;
    rdfs:label "diagnostic exclusion criterion"@en ;
    dc:description "A diagnostic exclusion criterion is a diagnostic criterion for consideration during a diagnosis which, if satisfied, excludes a diagnostic result."@en ;
    ns2:hasDbXref "IAO:0000124" ;
    rdfs:subClassOf onto:TMO_0068 .

onto:TMO_0078 a owl:Class ;
    rdfs:label "enzyme"@en ;
    dc:description "An enzyme is a protein that catalyzes (increases the rate of) a chemical reaction."@en ;
    ns2:hasDbXref "drugbank:enzymes" ;
    rdfs:subClassOf onto:TMO_0035 .

onto:TMO_0081 a owl:Class ;
    rdfs:label "haplotype"@en ;
    dc:description "A haplotype a variant DNA region which contains several smaller variant DNA regions which tend to be inherited together."@en ;
    rdfs:subClassOf onto:TMO_0172 .

onto:TMO_0082 a owl:Class ;
    rdfs:label "gene variant"@en ;
    dc:description "A gene variant is a variant of another gene based on some difference in sequence (composition and connectivity)"@en ;
    rdfs:subClassOf onto:TMO_0109 .

onto:TMO_0083 a owl:Class ;
    rdfs:label "ethnicity"@en ;
    dc:description "Ethinicity is the quality of an organism that describes membership in a social group based on a common heritage."@en ;
    rdfs:subClassOf onto:TMO_0084 .

onto:TMO_0085 a owl:Class ;
    rdfs:label "age"@en ;
    dc:description "Age is the temporal quality of an organism that refers to the length of time elapsed since it came into existence. For most animals and humans, age refers to the length of time elapsed since birth."@en ;
    rdfs:subClassOf onto:TMO_0084 .

onto:TMO_0087 a owl:Class ;
    rdfs:label "male"@en ;
    dc:description "Male is a sex quality for which sex organs contain only male gametes"@en ;
    rdfs:subClassOf onto:TMO_0086 ;
    owl:disjointWith onto:TMO_0088 .

onto:TMO_0091 a owl:Class ;
    rdfs:label "temporal quality"@en ;
    rdfs:subClassOf onto:TMO_0109 .

onto:TMO_0095 a owl:Class ;
    rdfs:label "toxic"@en ;
    rdfs:subClassOf onto:TMO_0056 .

onto:TMO_0096 a owl:Class ;
    rdfs:label "non toxic"@en ;
    rdfs:subClassOf onto:TMO_0056 .

onto:TMO_0103 a owl:Class ;
    rdfs:label "enumerated numerical quantity"@en ;
    dc:description "An enumerated numerical quantity is a numerical quantity selected from a discrete set of quantities."@en ;
    rdfs:subClassOf onto:TMO_0121 .

onto:TMO_0105 a owl:Class ;
    rdfs:label "multitude numerical quantity"@en ;
    dc:description "A multitude numerical quantity is a numerical quantity that indicates the number of individuals."@en ;
    rdfs:subClassOf onto:TMO_0121 .

onto:TMO_0107 a owl:Class ;
