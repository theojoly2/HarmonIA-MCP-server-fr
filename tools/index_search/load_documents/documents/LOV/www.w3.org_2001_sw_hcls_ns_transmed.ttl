    rdfs:subClassOf onto:TMO_0109 .

onto:TMO_0122 a owl:Class ;
    rdfs:label "chromosomal sequence position"@en ;
    dc:description "A chromosomal nucleotide sequence position is an ordinal number which reflects the position of a nucleotide in relation to the first nucleotide of the same chromosome."@en ;
