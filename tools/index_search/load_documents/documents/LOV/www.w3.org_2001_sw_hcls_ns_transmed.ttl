    dc:description "In a group of allelic variants in a population, the ancestral allele is the allele from which all other allelic variants are believed to have descended from during phylogeny."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onto:TMO_0079 ;
            owl:someValuesFrom onto:TMO_0048 ],
        onto:TMO_0048 .

