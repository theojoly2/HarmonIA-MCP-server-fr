    ns2:hasDbXref "ACGT:Protein"^^xsd:string,
        "BIRNLex:23"^^xsd:string,
        "CHEBI:36080"^^xsd:string,
        "FMA:Protein"^^xsd:string,
        "GO:0003675"^^xsd:string,
        "GRO:Protein"^^xsd:string,
        "Galen:Protein"^^xsd:string,
