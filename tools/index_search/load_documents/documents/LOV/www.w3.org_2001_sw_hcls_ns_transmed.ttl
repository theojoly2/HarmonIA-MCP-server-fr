onto:TMO_0141 a owl:Class ;
    rdfs:label "reference genomic sequence"@en ;
    dc:description "A reference genomic sequence is a genomic sequence that serves as a standard or reference, and may be composed by the consensus of the genomes of a number of individuals or parts thereof."@en ;
    rdfs:subClassOf onto:TMO_0138 .

onto:TMO_0158 a owl:Class ;
