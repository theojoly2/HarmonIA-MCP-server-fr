onto:TMO_0130 a owl:Class ;
    rdfs:label "nucleotide sequence"@en ;
    dc:description "A nucleotide sequence is a sequence of nucleotides in which a word (1 more more sequence of characters) represents a nucleotide and their adjacency indicates their connectivity."@en ;
    rdfs:subClassOf onto:TMO_0128 .

onto:TMO_0137 a owl:Class ;
    rdfs:label "identifier"@en ;
    dc:description "An identifier is an information content entity which consists of one or more symbols in order to identify some entity."@en ;
