onto:TMO_0217 a owl:Class ;
    rdfs:label "genetic status "@en ;
    rdfs:subClassOf onto:TMO_0109 .

onto:TMO_0218 a owl:Class ;
    rdfs:label "companion diagnostic role "@en ;
    rdfs:subClassOf onto:TMO_0221 .

onto:TMO_0219 a owl:Class ;
    rdfs:label "genetic test"@en ;
    rdfs:subClassOf onto:TMO_0076 .

onto:TMO_0222 a owl:ObjectProperty ;
    rdfs:label "provides supporting evidence for "@en ;
    rdfs:subPropertyOf ns1:IAO_0000136 .

onto:TMO_0225 a owl:Class ;
    rdfs:label "genotype with indel variation"@en ;
    dc:description "A genotype of which variants exist that differ though an insertion, deletion or a combination thereof."@en ;
    rdfs:subClassOf onto:TMO_0080 .

onto:TMO_0226 a owl:Class ;
    rdfs:label "genotype with short tandem repeat variation"@en ;
    rdfs:subClassOf onto:TMO_0080 .

onto:TMO_0227 a owl:Class ;
    rdfs:label "genotype with multiple nucleotide polymorphism"@en ;
    dc:description "A genotype with a multiple-nucleotide polymorphism (MNP). An MNP is a variation of several adjacent nucleotides in the genomes of members of a species. For a variation to be considered an MNP, it must occur in at least 1% of the population."@en ;
    rdfs:subClassOf onto:TMO_0080 .

onto:TMO_0229 a owl:Class ;
    rdfs:label "genotype with allele "@en ;
    dc:description "A genotype containing one matching allele on each chromosome (e.g., CYP2C9*1/*3)"@en ;
    rdfs:subClassOf onto:TMO_0080 .

onto:tmo a owl:Ontology ;
    dc:creator "Christi Denney",
        "Colin Batchelor",
        "Elgar Pichler",
        "Joanne Luciano",
        "Julia Kozlovsky",
        "M. Scott Marshall"^^xsd:string,
        "Matthias Samwald",
        "Michel Dumontier",
        "Susie Stephens",
        "Trish Whetzel" ;
    dc:description "The Translational Medicine Ontology (TMO) is a high-level, patient-centric ontology that extends existing domain ontologies to integrate data across aspects of drug discovery and clinical practice. The ontology has been developed by participants in the World Wide Web Consortium’s Semantic Web for Health Care and Life Sciences Interest Group."@en ;
    dc:publisher "W3C Health Care and Life Sciences Interest Group" ;
    dc:rights "Creative Commons - By Attribution" ;
    dc:subject "ontology, translational medicine, personalized medicine, life sciences, health care"^^xsd:string ;
    dc:title "Translational Medicine Ontology" ;
    ns3:imports <http://topbraid.org/spin/owlrl-all> ;
    rdfs:comment "Further information can be found in the publication \"The Translational Medicine Ontology and Knowledge Base: driving personalized medicine by bridging the gap between bench and bedside\", published in the Journal of Biomedical Semantics: http://www.jbiomedsem.com/content/2/S2/S1"^^xsd:string ;
    owl:imports <http://translationalmedicineontology.googlecode.com/svn/trunk/ontology/tmo-external.owl> ;
    owl:versionInfo "1.0.2"^^xsd:string .

ns1:IAO_0000028 rdfs:subClassOf onto:TMO_0137 .

ns1:IAO_0000310 a owl:Class ;
    ns2:hasDbXref "drugbank:references" .

<http://www.ifomis.org/bfo/1.1/snap#GenericallyDependentContinuant> a owl:Class .

onto:TMO_0011 a owl:Class ;
    rdfs:label "molecular structure description"@en ;
    dc:description "A molecular structure description is a description of a molecule in terms of its composition and connectivity."@en ;
    rdfs:comment "Examples: connection table, fragment, pharmacophore." ;
    rdfs:subClassOf onto:TMO_0106 .

onto:TMO_0012 a owl:Class ;
    rdfs:label "patent"@en ;
    ns1:IAO_0000119 "American Heritage(R) Stedman's Medical Dictionary" ;
    dc:description "A patent is an information entity granted by a patent office which confers upon the patenter the sole right to make, use and sell an invention for a set period of time."@en ;
    ns2:hasDbXref "BIRNLex:2364"^^xsd:string,
        "BRO:Patent"^^xsd:string,
        "Galen:patent"^^xsd:string,
        "IAO:0000313"^^xsd:string,
        "MSH:D020490"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000310 .

onto:TMO_0016 a owl:Class ;
    rdfs:label "clinical protocol"@en ;
    dc:description "A clinical protocol is a directive information entity about the objective(s), design, methodology, statistical considerations, and organization of a clinical procedure."@en ;
    ns2:hasDbXref "IAO:0000124" ;
    rdfs:subClassOf ns1:IAO_0000033 .

onto:TMO_0037 a owl:Class ;
    rdfs:label "gene"@en ;
    dc:description "A gene is a part of DNA that encodes information about other molecular entities."@en ;
    ns2:hasDbXref "FMA:Structural_gene"^^xsd:string,
        "GRO:Gene"^^xsd:string,
        "Galen:Gene"^^xsd:string,
        "LNC:LP32747-5"^^xsd:string,
        "MSH:D005796"^^xsd:string,
        "NCIt:Gene"^^xsd:string,
        "NCIt:Gene_Object"^^xsd:string,
        "NDFRT:C242394"^^xsd:string,
        "PRO:Gene"^^xsd:string,
        "SNOMEDCT:67271001"^^xsd:string,
        "SO:0000704"^^xsd:string,
        "UMLS:C0017337"^^xsd:string,
        "diseasome:genes",
        "pharmgkb:Gene" ;
    rdfs:subClassOf onto:TMO_0215 .

onto:TMO_0059 a owl:Class ;
    rdfs:label "hypothesis"@en ;
    dc:description "A hypothesis is an information content entity that describes a possible correlation between two or more variables."@en ;
    ns2:hasDbXref "NCIt:Hypothesis"^^xsd:string,
        "OBI:0000074"^^xsd:string,
        "UMLS:C1512571"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0089 .

onto:TMO_0061 a owl:Class ;
    rdfs:label "side effect"@en ;
    dc:description "A side effect is an effect of an intervention, whether therapeutic or adverse, that is secondary to the intended effect of the intervention."@en ;
    ns2:hasDbXref "NCIt:Side_Effect"^^xsd:string ;
    rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity> .

onto:TMO_0064 a owl:Class ;
    rdfs:label "active ingredient role"@en ;
    dc:description "An active ingredient role is a role played by a chemical substance which has the disposition to treat a certain disease and is part of a pharmaceutical formulation."@en ;
    rdfs:subClassOf onto:TMO_0062 .

onto:TMO_0065 a owl:Class ;
    rdfs:label "inactive ingredient role"@en ;
    dc:description "An inactive ingredient role is a role played by a chemical substance which is part of a pharmaceutical formulation but does not have the disposition to treat a certain disease."@en ;
    rdfs:subClassOf onto:TMO_0062 .

onto:TMO_0076 a owl:Class ;
    rdfs:label "assay"@en ;
    dc:description "An assay is a planned process with the objective to obtain information about a material entity."@en ;
    ns2:hasDbXref "BIRNLex:11025"^^xsd:string,
        "EFO:0001455"^^xsd:string,
        "Galen:Assay"^^xsd:string,
        "MSH:Q000032"^^xsd:string,
        "NCIt:Assay"^^xsd:string,
        "OBI:0000070",
        "PATO:0000003"^^xsd:string,
        "SNOMEDCT:272392009"^^xsd:string,
        "UMLS:C1510438"^^xsd:string,
        "cto_asyont:Assay"^^xsd:string ;
    rdfs:subClassOf onto:TMO_0075 .

