onto:ZEROeTurbofan a onto:Aircraft,
        owl:NamedIndividual ;
    rdfs:label "ZEROe Turbofan"@en ;
    dcterms:references <https://www.airbus.com/en/innovation/zero-emission/hydrogen/zeroe> ;
    onto:relatesToApplication onto:ZEROe ;
    skos:definition "Passenger Aircraft running on two hybrid-hydrogen turbofan engines providing thrust. The liquid hydrogen storage and distribution system is located behind the rear pressure bulkhead.\\r\\n\\r\\nRange: +1000 nm\\r\\nPassengers: <100"@en .

onto:ZEROeTurboprop a onto:Aircraft,
        owl:NamedIndividual ;
    rdfs:label "ZEROe Turboprop"@en ;
    dcterms:references <https://www.airbus.com/en/innovation/zero-emission/hydrogen/zeroe> ;
    onto:relatesToApplication onto:ZEROe ;
    skos:definition "Passenger aircraft with two hybrid-hydrogen turboprop engines, which drive eight-bladed propellers, providing thrust. The liquid hydrogen storage and distribution system is located behind the rear pressure bulkhead.\\r\\n\\r\\nRange: 2000 nm\\r\\nPassengers: <200"@en .

