    skos:example "PATH4ZERO"@en,
        "Paving the way for Zero Emission Inland Navigation"@en,
        "Power Edison Partnership"@en ;
    ns1:hyponym "Aviation Infrastructure Project"@en,
        "Bridge Infrastructure Project"@en,
        "Clean Transport Project"@en,
        "Commercial Construction Project"@en,
        "Energy Facility Construction Project"@en,
        "Energy Infrastructure Project"@en,
        "Energy Transport Transformation Project"@en,
        "Hydrogen Facility Development Project"@en,
        "Hydrogen Fuel Cell Power Generation Project"@en,
        "Hydrogen Hub Development"@en,
        "Industrial Construction Project"@en,
        "Power Edison Partnership"@en,
        "Power and Energy Infrastructure Project"@en,
        "Private Construction Project"@en,
        "Public Construction Project"@en,
        "Public Transportation Project"@en,
        "Railroad Infrastructure Project"@en,
        "Renewable Energy Development Project"@en,
        "Residential Construction"@en,
        "Road Infrastructure Construction Project"@en,
        "Road Infrastructure Project"@en,
        "Transportation Project"@en,
        "Water Infrastructure Project"@en .

