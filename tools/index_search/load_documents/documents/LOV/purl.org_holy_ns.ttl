        "Hydrogen Technology Expo Europe"@en,
        "Hydrogen Transition Summit"@en,
        "POWERGEN International"@en,
        "The Automotive & Tire Industry Forum"@en,
        "The COP 26 Climate Summit"@en,
        "The China International Import Expo"@en,
        "The LA Auto Show"@en,
        "The World Climate Conference"@en,
        "United Nations Conference on Climate Change"@en ;
    skos:hiddenLabel "Forum Tomorrow in Motion"@en,
        "Green Car Korea"@en ;
    ns1:hyponym "Clean Energy Megatrend"@en,
        "European Mobility Expo"@en,
        "Hydrogen Adoption"@en,
        "Hydrogen Economy Area"@en .

