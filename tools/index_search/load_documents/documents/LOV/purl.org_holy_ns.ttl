onto:RegionalTruck a owl:Class ;
    rdfs:label "Regional Truck"@en ;
    dcterms:references <https://www.azuga.com/blog/what-is-a-short-haul-truck-driver> ;
    rdfs:subClassOf onto:Truck ;
    skos:altLabel "Regional Truck"@en ;
    skos:definition "A road vehicle which is small to large-sized and used for the transportation of goods within an area of 150 miles."@en ;
    skos:hiddenLabel "Van"@en ;
    ns1:hyponym "All-electric Van"@en,
        "Box Truck"@en,
