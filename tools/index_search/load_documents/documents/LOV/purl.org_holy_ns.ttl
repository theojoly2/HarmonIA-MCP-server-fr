    rdfs:label "Sweden"@en ;
    ns2:continent onto:Europe .

ns6:ResearchProject a owl:Class ;
    rdfs:label "Research Project"@en ;
    dcterms:references <http://dx.doi.org/10.13140/RG.2.1.1432.6245>,
        ns6:,
        <http://www.maxwideman.com/guests/typology/projects.htm>,
        "https://dbpedia.org/ontology/ResearchProject"@en,
        "https://schema.org/ResearchProject"@en ;
    rdfs:comment "The Schema.org defintion of Research Project is 'A Research Project'"@en ;
    rdfs:subClassOf onto:PurposeBasedProject ;
    skos:altLabel "Experimental Project"@en,
        "R&D Project"@en,
        "Research Project"@en,
        "Research and Advanced Development Project"@en ;
    skos:definition "A scientific investigation, usually using scientific methods, to achieve defined objectives."@en ;
    ns1:hyponym "Meta Project"@en,
        "Qualitative Project"@en,
        "Quantitative Project"@en .

<http://dbpedia.org/resource/Europe> a owl:NamedIndividual ;
    rdfs:label "Europe"@en ;
    rdfs:comment "Europe is a continent, also recognised as part of Eurasia, located entirely in the Northern Hemisphere and mostly in the Eastern Hemisphere. Comprising the westernmost peninsulas of the continental landmass of Eurasia, it shares the continental landmass of Afro-Eurasia with both Asia and Africa. It is bordered by the Arctic Ocean to the north, the Atlantic Ocean to the west, the Mediterranean Sea to the south and Asia to the east. Europe is commonly considered to be separated from Asia by the watershed of the Ural Mountains, the Ural River, the Caspian Sea, the Greater Caucasus, the Black Sea and the waterways of the Turkish Straits."@en ;
    owl:sameAs onto:Europe .

onto:FuelCellStack a owl:Class ;
    rdfs:label "Fuel Cell Stack"@en ;
    dcterms:references <https://www.energy.gov/eere/fuelcells/fuel-cell-systems> ;
    rdfs:subClassOf onto:HydrogenFuelCellComponent ;
    skos:altLabel "Fuel Cell Stack"@en ;
    skos:definition "The heart of a fuel cell responsible for energy generation."@en .

onto:HyzonClass8 a onto:LongHaulTruck,
        owl:NamedIndividual ;
    rdfs:label "Hyzon Class 8"@en ;
