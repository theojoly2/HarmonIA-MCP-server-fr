ns4:isPubliclyTraded a owl:DatatypeProperty ;
    rdfs:label "is publicly traded"@en ;
    dcterms:references ns4: ;
    rdfs:domain <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a company is publicly traded (listed at a stock exchange)."@en .

ns4:isStartup a owl:DatatypeProperty ;
    rdfs:label "is startup"@en ;
    dcterms:references ns4: ;
    rdfs:domain <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a company is a startup."@en .

ns4:isStateOwned a owl:DatatypeProperty ;
    rdfs:label "is state owned"@en ;
    dcterms:references ns4: ;
    rdfs:domain <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a company is owned by the government, a government agency, municipality, city or other public entity."@en .

ns2:country a owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "country"@en ;
    rdfs:domain onto:GeographicMarket ;
    rdfs:range ns6:Country ;
    skos:definition "Links a continent to a country."@en .

ns2:project a ns6:Project,
        owl:NamedIndividual ;
    rdfs:label "Project"@en ;
    rdfs:comment "A project is a temporary endeavor undertaken to achieve defined objectives."@en .

ns2:projectEndDate a owl:DatatypeProperty ;
    rdfs:label "project end date"@en ;
    rdfs:domain ns6:Project ;
    rdfs:range xsd:date ;
    owl:equivalentProperty ns3:endOfProject ;
    skos:definition "The end date of the project."@en .

ns2:projectKeyword a owl:DatatypeProperty ;
    rdfs:label "project Keyword"@en ;
    rdfs:domain ns6:Project ;
    rdfs:range xsd:string ;
    skos:definition "A key word of the project."@en .

ns2:projectStartDate a owl:DatatypeProperty ;
    rdfs:label "project start date"@en ;
    rdfs:domain ns6:Project ;
    rdfs:range xsd:date ;
    owl:equivalentProperty ns3:startOfProject ;
    skos:definition "The start date of the project."@en .

ns2:research_project a ns6:ResearchProject,
        owl:NamedIndividual ;
    rdfs:label "Research Project"@en ;
    rdfs:comment "A research project is a scientific investigation, usually using scientific methods, to achieve defined objectives."@en .

