onto:GeographicMarket a owl:Class ;
    rdfs:label "Geographic Market"@en ;
    dcterms:references <https://dictionary.cambridge.org/dictionary/english/market>,
        <https://www.irena.org/publications/2022/Jan/Geopolitics-of-the-Energy-Transformation-Hydrogen>,
        <https://www.yourdictionary.com/geographical-area> ;
    owl:disjointWith onto:Indicator,
        onto:Product,
        ns6:Project,
        org:Organization ;
    skos:altLabel "Geographic Market"@en ;
    skos:definition "An area of land which can be classified for business or trade concerning a particular product or domain."@en ;
    skos:hiddenLabel "Earth"@en,
        "World"@en .

org:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    dcterms:references org: ;
    skos:altLabel "Company"@en,
        "Organisation"@en,
        "Organization"@en ;
    skos:definition "Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an agent. Organizations are often decomposable into hierarchical structures."@en ;
    ns1:hyponym "Enterprise"@en,
        "Institute"@en,
        "Institution"@en,
        "NGO"@en .

onto:North_America a ns6:Continent,
        owl:NamedIndividual ;
    rdfs:label "North America"@en .

onto:Asia a ns6:Continent,
        owl:NamedIndividual ;
    rdfs:label "Asia"@en .

onto:Europe a ns6:Continent,
        owl:NamedIndividual ;
    rdfs:label "Europe"@en ;
    skos:definition "European Market as a subclass of Geographic Market refers to markets on the European continent."@en .

onto:Africa a ns6:Continent,
        owl:NamedIndividual ;
    rdfs:label "Africa"@en ;
    skos:definition "African as a subclass of Geographic Market or Continent refers to markets on the African continent."@en .

ns6:Country a owl:Class ;
    rdfs:label "Country"@en ;
    dcterms:references ns6: ;
    rdfs:subClassOf onto:GeographicMarket ;
    skos:definition "An area of land that has its own government, army, etc."@en .

