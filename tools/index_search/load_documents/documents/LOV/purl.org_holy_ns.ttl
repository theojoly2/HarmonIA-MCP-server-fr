        "Linear Production System"@en,
        "Purification"@en .

onto:MembraneElectrodeAssembly a owl:Class ;
    rdfs:label "Membrane Electrode Assembly"@en ;
    dcterms:references <https://www.energy.gov/eere/fuelcells/parts-fuel-cell>,
        "https://doi.org/10.1016/B978-044452745-5.00227-6" ;
