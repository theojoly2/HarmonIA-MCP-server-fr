onto: a owl:Ontology ;
    dcterms:created "2022"^^xsd:gYear ;
    dcterms:creator [ ns6:affiliation [ foaf:homepage <https://www.th-nuernberg.de/einrichtungen-gesamt/fraunhofer-forschungsgruppen/future-engineering/> ;
                    foaf:name "Future Engineering Research Group" ] ;
            rdfs:seeAlso <https://www.th-nuernberg.de/person/ascencion-arevalo-kiara-marnitt/> ;
            foaf:homepage <https://orcid.org/0000-0002-4158-9478> ;
            foaf:name "Kiara Marnitt Ascencion Arevalo" ],
        [ ns6:affiliation [ foaf:homepage <https://www.th-nuernberg.de> ;
                    foaf:name "Technische Hochschule Nürnberg Georg Simon Ohm" ] ;
            foaf:homepage <https://orcid.org/0000-0001-9312-208X> ;
            foaf:name "Christoph Neunsinger" ] ;
    dcterms:description "This is the Hydrogen Ontology (HOLY). HOLY is a domain ontology for describing the complex structure of hydrogen-based markets. HOLY contributes to the systemic modeling of the hydrogen domain with a focus on its value chain. Hence, it provides a foundation for retrieval, storage, and delivery of market insights.  "@en ;
    dcterms:issued "2022-12-16"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2022-04-26"^^xsd:date ;
    dcterms:publisher [ foaf:homepage <https://www.th-nuernberg.de> ;
            foaf:name "Technische Hochschule Nürnberg Georg Simon Ohm" ] ;
    dcterms:title "Hydrogen Ontology"@en ;
    ns5:doi <https://doi.org/10.5281/zenodo.7447958> ;
    vann:preferredNamespacePrefix "holy" ;
    vann:preferredNamespaceURI "http://purl.org/holy/ns#" ;
    owl:priorVersion <http://purl.org/holy/holy-20221216> ;
    owl:versionIRI onto: ;
    owl:versionInfo 1.1 ;
    foaf:depiction <http://purl.org/holy/schema_diagram> ;
    ns8:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    ns7:acronym "HOLY" ;
    ns7:competencyQuestion <http://purl.org/holy/repository/cq> ;
    ns7:hasSyntax <http://www.w3.org/ns/formats/Turtle> .

