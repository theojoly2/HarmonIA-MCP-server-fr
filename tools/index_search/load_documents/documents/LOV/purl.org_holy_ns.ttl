onto:hasApplication a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has Application"@en ;
    rdfs:domain onto:GeographicMarket ;
    rdfs:range onto:Application ;
    skos:definition "Relates to the geographic location of applications in the market."@en .

onto:hasOrganization a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has Organization"@en ;
    rdfs:domain onto:GeographicMarket ;
    rdfs:range org:Organization ;
    owl:inverseOf onto:participatesIn ;
    owl:propertyChainAxiom ( [ owl:inverseOf ns2:continent ] onto:hasOrganization ) ;
    skos:definition "Indicates a direkt link from a geographic location to an organization. It shows where a organization is located."@en .

onto:participatesIn a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "participates in"@en ;
    rdfs:domain org:Organization ;
    rdfs:range onto:GeographicMarket ;
    skos:definition "Defines that an organization participates with presence in a certain geographic market."@en .

onto:producesProduct a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "produces Product"@en ;
    rdfs:domain org:Organization ;
    rdfs:range onto:Product ;
    skos:definition "Indicates which organization manufactures a given product."@en .

onto:productSoldIn a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "product sold in"@en ;
    rdfs:comment "The inverse of holy:hasProduct"@en ;
    rdfs:domain onto:Product ;
    rdfs:range onto:GeographicMarket ;
    skos:definition "Defines in which geographic market a product is sold or available for use."@en .

onto:providesApplication a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "provides Application"@en ;
    rdfs:comment "The inverse of holy:isProvidedBy"@en ;
    rdfs:domain org:Organization ;
    rdfs:range onto:Application ;
    skos:definition "Indicates which organizations are directly providing applications (the end-usage) to the market either by manufacturing the application or operating, licensing, leasing... it."@en .

onto:usesProduct a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "uses Product"@en ;
    rdfs:comment "Inverse of holy:isUsedIn - Disjoint with holy:usesTechnology"@en ;
    rdfs:domain onto:Application ;
    rdfs:range onto:Product ;
    rdfs:subPropertyOf onto:usesSource ;
    skos:definition "Defines the product used in a particular application"@en .

onto:usesTechnology a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "uses Technology"@en ;
    rdfs:comment "Inverse of holy:isUsedIn - Disjoint with holy:usesApplication"@en ;
    rdfs:domain onto:Application ;
    rdfs:range onto:Product ;
    rdfs:subPropertyOf onto:usesSource ;
    skos:definition "Defines the technology used in a particular application."@en .

ns3:endOfProject a owl:DatatypeProperty ;
    rdfs:label "project end date"@en ;
    dcterms:references ns3: ;
    rdfs:domain ns6:Project ;
    rdfs:range xsd:date ;
    skos:definition "end date of a project"@en .

ns3:projectParticipant a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "project participant"@en ;
    dcterms:references ns3: ;
    rdfs:comment "An object property comming from the Metadata4Ing ontology for describing the generation of research data, projects and scientific projects. The ontology was released recently on the 22.02.2022 and could be useful for future expansion of the hydrogen ontology."@en,
        "The inverse of m4i:associatesToProject"@en ;
    rdfs:domain ns6:Project ;
    rdfs:range org:Organization ;
    skos:altLabel "project partner"@en ;
    skos:definition "A property that connects a project with a person or an organisation."@en .

ns3:startOfProject a owl:DatatypeProperty ;
    rdfs:label "project start date"@en ;
    dcterms:references ns3: ;
    rdfs:domain ns6:Project ;
    rdfs:range xsd:date ;
    skos:definition "start date of a project"@en .

xsd:string a rdfs:Datatype .

owl:Thing a owl:Class ;
    rdfs:comment "The ontology is dedicated to store information of the hydrogen fuel cell domain. Since all sub-classes are providing detailed information to the general subject, 'owl:Thing' can be seen here as the Hydrogen Fuel Cell Domain."@en ;
    skos:altLabel "Hydrogen Fuel Cell Domain"@en .

org:FormalOrganization a owl:Class ;
    rdfs:label "Formal Organization"@en ;
    dcterms:references org: ;
    rdfs:subClassOf org:Organization ;
    skos:definition "An organization which is recognized in the world at large, in particular in legal jurisdictions, with associated rights and responsibilities. Examples include a corporation, charity, government or church."@en .

org:classification a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "classification"@en ;
    dcterms:references org: ;
    rdfs:comment "Main property of rov:orgActivity"@en ;
    rdfs:domain org:Organization ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:definition "Indicates a classification for this Organization within some classification scheme."@en .

org:hasSite a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has site"@en ;
    dcterms:references org: ;
    rdfs:domain org:Organization ;
    rdfs:range onto:GeographicMarket ;
    owl:inverseOf org:siteOf ;
    skos:definition "Indicates a site at which the Organization has some presence even if only indirect (e.g. virtual office or a professional service which is acting as the registered address for a company)."@en .

org:siteOf a owl:ObjectProperty ;
    rdfs:label "site of"@en ;
    dcterms:references <http://www.w3.org/ns/org> ;
    rdfs:domain onto:GeographicMarket ;
    rdfs:range org:Organization ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:definition "Indicates an Organization which has some presence at the given site. This is the inverse of `org:hasSite`."@en .

org:subOrganizationOf a owl:AsymmetricProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "sub-Organization of"@en ;
    dcterms:references org: ;
    rdfs:domain org:Organization ;
    rdfs:range org:Organization ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:definition "Represents hierarchical containment of Organizations or OrganizationalUnits; indicates an Organization which contains this Organization."@en .

ns2:continent a owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "continent"@en ;
    rdfs:domain ns6:Country ;
    rdfs:range ns6:Continent ;
    skos:definition "Links a country to the continent it belongs to."@en .

<http://dbpedia.org/resource/EvoBus> a onto:ManufacturingOrganization,
        owl:NamedIndividual ;
    rdfs:label "EvoBus"@en ;
    rdfs:comment "EvoBus GmbH is a German bus and coach manufacturer headquartered in Stuttgart, Germany and a wholly owned subsidiary of . Its products go to market under the brands Setra or Mercedes-Benz."@en ;
    skos:altLabel "EvoBus GmbH"@en ;
    org:subOrganizationOf <http://dbpedia.org/resource/Daimler_AG> .

<http://dbpedia.org/resource/Hyundai_Motor_Company> a onto:ManufacturingOrganization,
        owl:NamedIndividual ;
    rdfs:label "Hyundai Motor Company"@en ;
    onto:providesApplication <http://dbpedia.org/resource/Hyundai_Nexo>,
        <http://dbpedia.org/resource/Hyundai_ix35_FCEV> ;
    rdfs:comment "Hyundai Motor Company, often abbreviated to Hyundai Motors (Korean: 현대자동차; Hanja: 現代自動車; RR: Hyeondae Jadongcha ) and commonly known as Hyundai (Korean: 현대; Hanja: 現代; RR: Hyeondae, IPA: [ˈhjəːndɛ]; lit. 'modernity'), is a South Korean multinational automotive manufacturer headquartered in Seoul, South Korea. Hyundai Motor Company was founded in 1967. Currently, the company owns 33.88 percent of Kia Corporation, and also fully owns two marques including its luxury cars subsidiary, Genesis Motor, and an electric vehicle sub-brand, Ioniq. Those three brands altogether comprise the Hyundai Motor Group."@en .

onto:AviaticApplication a owl:Class ;
    rdfs:label "Aviatic Application"@en ;
    dcterms:references <https://dictionary.cambridge.org/dictionary/english/aviation> ;
    rdfs:subClassOf onto:MobileApplication ;
    skos:altLabel "Aeronautics"@en,
        "Air Travel"@en,
        "Airmanship"@en,
        "Aviation"@en ;
    skos:definition "An application related to the transport of people and/or goods by any form of aircraft or spacecraft."@en ;
    skos:hiddenLabel "Air Power"@en .

