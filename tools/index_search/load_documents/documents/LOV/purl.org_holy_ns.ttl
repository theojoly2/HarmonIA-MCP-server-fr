    rdfs:label "Spain"@en ;
    ns2:continent onto:Europe .

onto:SupportiveHardware a owl:Class ;
    rdfs:label "Supportive Hardware"@en ;
    dcterms:references <https://dictionary.cambridge.org/dictionary/english/hardware>,
        <https://www.energy.gov/eere/fuelcells/parts-fuel-cell> ;
    rdfs:subClassOf onto:FuelCellStack ;
    skos:altLabel "Supportive Hardware"@en ;
    skos:definition "A component such as equipment, material, or metal which enables efficient energy generation."@en .

onto:Sweden a ns6:Country,
