onto:IndustrialProcessing a owl:Class ;
    rdfs:label "Industrial Processing"@en ;
    dcterms:references <https://www.ipa.fraunhofer.de/en/industry-solutions/process-industry.html>,
        <https://www.irena.org/publications/2022/Jan/Geopolitics-of-the-Energy-Transformation-Hydrogen> ;
    rdfs:subClassOf onto:StationaryApplication ;
