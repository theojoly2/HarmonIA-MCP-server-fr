<https://w3id.org/dpv/dpv-pd#Accent> a skos:Concept,
        ns2:Concept ;
    dcterms:created "2019-06-04"^^xsd:date ;
    dcterms:creator "Elmar Kiesling; Harshvardhan J. Pandit",
        "Fajar Ekaputra" ;
    dcterms:source <https://enterprivacy.com/wp-content/uploads/2018/09/Categories-of-Personal-Information.pdf> ;
    rdfs:isDefinedBy <https://w3id.org/dpv/dpv-pd#> ;
    ns1:term_status "accepted"@en ;
    skos:broader <https://w3id.org/dpv/dpv-pd#Language> ;
    skos:definition "Information about linguistic and speech accents."@en ;
    skos:prefLabel "Accent"@en ;
    ns2:isSubTypeOf <https://w3id.org/dpv/dpv-pd#Language> .

<https://w3id.org/dpv/dpv-pd#Acquantaince> a skos:Concept,
        ns2:Concept ;
    dcterms:created "2019-06-04"^^xsd:date ;
    dcterms:creator "Elmar Kiesling; Harshvardhan J. Pandit",
        "Fajar Ekaputra" ;
    dcterms:source <https://enterprivacy.com/wp-content/uploads/2018/09/Categories-of-Personal-Information.pdf> ;
    rdfs:isDefinedBy <https://w3id.org/dpv/dpv-pd#> ;
    ns1:term_status "accepted"@en ;
    skos:broader <https://w3id.org/dpv/dpv-pd#SocialNetwork> ;
    skos:definition "Information about acquaintainces in a social network."@en ;
    skos:prefLabel "Acquantaince"@en ;
    ns2:isSubTypeOf <https://w3id.org/dpv/dpv-pd#SocialNetwork> .

<https://w3id.org/dpv/dpv-pd#AgeExact> a skos:Concept,
        ns2:Concept ;
    dcterms:created "2022-04-20"^^xsd:date ;
    dcterms:creator "Harshvardhan J. Pandit" ;
    rdfs:isDefinedBy <https://w3id.org/dpv/dpv-pd#> ;
    ns1:term_status "accepted"@en ;
    skos:broader <https://w3id.org/dpv/dpv-pd#AgeRange> ;
    skos:definition "Information about the exact age (i.e. to some degree within a year, month, or day)"@en ;
    skos:prefLabel "Age Exact"@en ;
    ns2:isSubTypeOf <https://w3id.org/dpv/dpv-pd#AgeRange> .

<https://w3id.org/dpv/dpv-pd#ApartmentOwned> a skos:Concept,
        ns2:Concept ;
    dcterms:created "2019-06-04"^^xsd:date ;
    dcterms:creator "Elmar Kiesling; Harshvardhan J. Pandit",
        "Fajar Ekaputra" ;
    dcterms:source <https://enterprivacy.com/wp-content/uploads/2018/09/Categories-of-Personal-Information.pdf> ;
    rdfs:isDefinedBy <https://w3id.org/dpv/dpv-pd#> ;
    ns1:term_status "accepted"@en ;
    skos:broader <https://w3id.org/dpv/dpv-pd#HouseOwned> ;
    skos:definition "Information about apartment(s) owned and its history"@en ;
    skos:prefLabel "Apartment Owned"@en ;
    ns2:isSubTypeOf <https://w3id.org/dpv/dpv-pd#HouseOwned> .

<https://w3id.org/dpv/dpv-pd#Association> a skos:Concept,
        ns2:Concept ;
    dcterms:created "2019-06-04"^^xsd:date ;
    dcterms:creator "Elmar Kiesling; Harshvardhan J. Pandit",
        "Fajar Ekaputra" ;
    dcterms:source <https://enterprivacy.com/wp-content/uploads/2018/09/Categories-of-Personal-Information.pdf> ;
    rdfs:isDefinedBy <https://w3id.org/dpv/dpv-pd#> ;
    ns1:term_status "accepted"@en ;
    skos:broader <https://w3id.org/dpv/dpv-pd#SocialNetwork> ;
