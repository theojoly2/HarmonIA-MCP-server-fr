    dcterms:created "2019-06-04"^^xsd:date ;
    dcterms:creator "Elmar Kiesling; Harshvardhan J. Pandit",
        "Fajar Ekaputra" ;
    dcterms:source <https://enterprivacy.com/wp-content/uploads/2018/09/Categories-of-Personal-Information.pdf> ;
    rdfs:isDefinedBy <https://w3id.org/dpv/dpv-pd#> ;
    ns1:term_status "accepted"@en ;
    skos:broader <https://w3id.org/dpv/dpv-pd#External> ;
    skos:definition "Information about Behavior or activity"@en ;
    skos:narrower <https://w3id.org/dpv/dpv-pd#Attitude>,
        <https://w3id.org/dpv/dpv-pd#AuthenticationHistory>,
        <https://w3id.org/dpv/dpv-pd#BrowsingBehavior>,
        <https://w3id.org/dpv/dpv-pd#CallLog>,
        <https://w3id.org/dpv/dpv-pd#Demeanor>,
        <https://w3id.org/dpv/dpv-pd#LinkClicked>,
        <https://w3id.org/dpv/dpv-pd#PerformanceAtWork>,
        <https://w3id.org/dpv/dpv-pd#Personality>,
        <https://w3id.org/dpv/dpv-pd#Reliability>,
        <https://w3id.org/dpv/dpv-pd#ServiceConsumptionBehavior>,
        <https://w3id.org/dpv/dpv-pd#VehicleUsage> ;
    skos:prefLabel "Behavioral"@en ;
    skos:related <https://specialprivacy.ercim.eu/vocabs/data#Activity> ;
    ns2:isSubTypeOf <https://w3id.org/dpv/dpv-pd#External> .

<https://w3id.org/dpv/dpv-pd#External> a skos:Concept,
        ns2:Concept ;
    dcterms:created "2019-06-04"^^xsd:date ;
    dcterms:creator "Elmar Kiesling; Harshvardhan J. Pandit",
        "Fajar Ekaputra" ;
    dcterms:source <https://enterprivacy.com/wp-content/uploads/2018/09/Categories-of-Personal-Information.pdf> ;
    rdfs:isDefinedBy <https://w3id.org/dpv/dpv-pd#> ;
    ns1:term_status "accepted"@en ;
    skos:broader ns2:PersonalData ;
    skos:definition "Information about external characteristics that can be observed"@en ;
    skos:narrower <https://w3id.org/dpv/dpv-pd#Behavioral>,
        <https://w3id.org/dpv/dpv-pd#Demographic>,
        <https://w3id.org/dpv/dpv-pd#Ethnicity>,
        <https://w3id.org/dpv/dpv-pd#Identifying>,
        <https://w3id.org/dpv/dpv-pd#Language>,
        <https://w3id.org/dpv/dpv-pd#MedicalHealth>,
        <https://w3id.org/dpv/dpv-pd#Nationality>,
        <https://w3id.org/dpv/dpv-pd#PersonalDocuments>,
        <https://w3id.org/dpv/dpv-pd#PhysicalCharacteristic>,
        <https://w3id.org/dpv/dpv-pd#Sexual>,
        <https://w3id.org/dpv/dpv-pd#Vehicle> ;
    skos:prefLabel "External"@en ;
    ns2:isSubTypeOf ns2:PersonalData .

<https://w3id.org/dpv/dpv-pd#Professional> a skos:Concept,
        ns2:Concept ;
    dcterms:created "2019-06-04"^^xsd:date ;
    dcterms:creator "Elmar Kiesling; Harshvardhan J. Pandit",
        "Fajar Ekaputra" ;
    dcterms:source <https://enterprivacy.com/wp-content/uploads/2018/09/Categories-of-Personal-Information.pdf> ;
    rdfs:isDefinedBy <https://w3id.org/dpv/dpv-pd#> ;
    ns1:term_status "accepted"@en ;
    skos:broader <https://w3id.org/dpv/dpv-pd#Social> ;
    skos:definition "Information about educational or professional career"@en ;
    skos:narrower <https://w3id.org/dpv/dpv-pd#DisciplinaryAction>,
        <https://w3id.org/dpv/dpv-pd#Education>,
        <https://w3id.org/dpv/dpv-pd#EmploymentHistory>,
        <https://w3id.org/dpv/dpv-pd#Job>,
        <https://w3id.org/dpv/dpv-pd#PerformanceAtWork>,
        <https://w3id.org/dpv/dpv-pd#ProfessionalCertification>,
        <https://w3id.org/dpv/dpv-pd#ProfessionalEvaluation>,
        <https://w3id.org/dpv/dpv-pd#ProfessionalInterview>,
        <https://w3id.org/dpv/dpv-pd#Reference>,
        <https://w3id.org/dpv/dpv-pd#Salary>,
        <https://w3id.org/dpv/dpv-pd#School>,
        <https://w3id.org/dpv/dpv-pd#WorkEnvironment>,
        <https://w3id.org/dpv/dpv-pd#WorkHistory> ;
    skos:prefLabel "Professional"@en ;
    ns2:isSubTypeOf <https://w3id.org/dpv/dpv-pd#Social> .

