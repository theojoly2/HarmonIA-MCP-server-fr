@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <http://purl.org/ontology/dso> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.org/ontology/dso#Interloan> a owl:Class ;
    rdfs:label "Interloan"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/dso#DocumentService> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/dso#Loan> a owl:Class ;
    rdfs:label "Loan"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/dso#DocumentService> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/dso#OpenAccess> a owl:Class ;
    rdfs:label "Digitization"@en,
        "OpenAccess"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/dso#DocumentService> ;
    ns1:term_status "testing",
        "unstable" .

<http://purl.org/ontology/dso#Presentation> a owl:Class ;
    rdfs:label "Presentation"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/dso#DocumentService> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/dso#hasDocument> a owl:ObjectProperty ;
    rdfs:label "hasDocument"@en ;
    rdfs:domain <http://purl.org/ontology/dso#DocumentService> ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://purl.org/ontology/bibo/Document>,
        <http://purl.org/ontology/daia/availableFor>,
        <http://purl.org/ontology/daia/unavailableFor>,
        foaf:Document ;
    owl:inverseOf <http://purl.org/ontology/dso#hasService> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/dso#hasService> a owl:ObjectProperty ;
    rdfs:label "hasService"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/ontology/dso#DocumentService> ;
    rdfs:seeAlso <http://purl.org/ontology/bibo/Document>,
        <http://purl.org/ontology/daia/availableFor>,
        <http://purl.org/ontology/daia/unavailableFor>,
        foaf:Document ;
    owl:inverseOf <http://purl.org/ontology/dso#hasDocument> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/dso#DocumentService> a owl:Class ;
    rdfs:label "DocumentService"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://purl.org/goodrelations/v1#Offering>,
        <http://purl.org/ontology/ssso#ServiceEvent>,
        <http://schema.org/Offer> ;
    rdfs:subClassOf <http://purl.org/ontology/service#Service> ;
    ns1:term_status "testing" .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "DSO" ;
    ns2:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:creator "Jakob Voß" ;
    dcterms:description "A micro-ontology that defines a set of typical document-related services such as provided by libraries, museums and archives."@en ;
    dcterms:modified "2013-12-05"^^xsd:date ;
    dcterms:title "Document Service Ontology" ;
    vann:preferredNamespacePrefix "dso" ;
    vann:preferredNamespaceUri "http://purl.org/ontology/dso#" ;
    owl:versionInfo "0.6.5rev1" .

