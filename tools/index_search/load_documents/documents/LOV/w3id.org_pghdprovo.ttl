@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <https://w3id.org/mod#> .
@prefix ns3: <https://w3id.org/pghdprovo#> .
@prefix ns4: <http://purl.org/ontology/bibo/> .
@prefix onto: <https://w3id.org/pghdprovo> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

ns4:status a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

xsd:date a rdfs:Datatype .

owl:versionInfo a owl:AnnotationProperty .

ns1:term_status a owl:AnnotationProperty .

prov:category a owl:AnnotationProperty .

prov:component a owl:AnnotationProperty .

prov:constraints a owl:AnnotationProperty .

prov:definition a owl:AnnotationProperty .

prov:dm a owl:AnnotationProperty .

prov:editorialNote a owl:AnnotationProperty .

prov:endedAtTime a owl:DatatypeProperty ;
    rdfs:label "endedAtTime" ;
    rdfs:comment "The number of calories burned associated with the\\nactivity.",
        "The time at which an activity ended. See also prov:startedAtTime."@en ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedEnd o prov:atTime) rdfs:subPropertyOf prov:endedAtTime."@en ;
    prov:qualifiedForm prov:End,
        prov:atTime .

prov:generated a owl:ObjectProperty ;
    rdfs:label "generated" ;
    rdfs:comment "Relates an activity to an entity that it generated."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

prov:generatedAtTime a owl:DatatypeProperty ;
    rdfs:label "generatedAtTime" ;
    rdfs:comment "The time at which an entity was completely created and is available for use."@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    prov:category "expanded" ;
    prov:component "entities-activities" ;
    prov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedGeneration o prov:atTime) rdfs:subPropertyOf prov:generatedAtTime."@en ;
    prov:qualifiedForm prov:Generation,
        prov:atTime .

prov:inverse a owl:AnnotationProperty .

prov:n a owl:AnnotationProperty .

prov:qualifiedForm a owl:AnnotationProperty .

prov:startedAtTime a owl:DatatypeProperty ;
    rdfs:label "startedAtTime" ;
    rdfs:comment "The time at which an activity started. See also prov:endedAtTime."@en ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range xsd:dateTime ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedStart o prov:atTime) rdfs:subPropertyOf prov:startedAtTime."@en ;
    prov:qualifiedForm prov:Start,
        prov:atTime .

<https://saref.etsi.org/saref4wear/User> a owl:Class ;
    rdfs:label "User"@en ;
    rdfs:comment "A user is an entity using a wearable."@en ;
    rdfs:subClassOf prov:Person ;
    owl:equivalentClass ns3:Patient .

ns2:createdWith a owl:AnnotationProperty .

onto: a owl:Ontology ;
    rdfs:label "Patient Generated Health Data Provenance Ontology"@en ;
    dcterms:bibliographicCitation "Kawu, A.A., O’Sullivan, D. and Hederman, L., 2025, June. PGHDProvO: Provenance Based Ontology for Sharing Patient Generated Health Data (PGHD) with an Electronic Health Record (EHR). In International Conference on Artificial Intelligence in Medicine (pp. 197-201). Cham: Springer Nature Switzerland." ;
    dcterms:contributor "Dympna OSullivan, Technological University Dublin",
        "Lucy Hederman, Trinity College Dublin" ;
    dcterms:created "2021-05-24"^^xsd:date ;
    dcterms:creator "Abdullahi Abubakar Kawu" ;
    dcterms:description "Patient Generated Health Data (PGHD) refer to health data collected by patient or their relatives. This ontology seeks to capture information about the data, the provenance and data quality associated with PGHD shared with an EHR."@en ;
    dcterms:issued "2024-05-24"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2025-11-24"^^xsd:date ;
    dcterms:publisher "Technological University Dublin" ;
    dcterms:title "PGHDPROVO" ;
    ns4:status "http://purl.org/ontology/bibo/status/published" ;
    vann:preferredNamespacePrefix "pghdprovo" ;
    vann:preferredNamespaceUri "https://w3id.org/pghdprovo#" ;
    owl:priorVersion <https://w3id.org/pghdprovo/1.0> ;
    owl:versionIRI <https://w3id.org/pghdprovo/1.0> ;
    owl:versionInfo "1.0" ;
    ns2:createdWith <https://chowlk.linkeddata.es/> .

ns3:BloodPressure1 a owl:NamedIndividual,
        ns3:PGHD ;
    dc:identifier "" ;
    prov:wasAttributedTo ns3:Patient1 ;
    prov:wasDerivedFrom ns3:BPMonitor ;
    foaf:name ""^^rdfs:Literal ;
    ns3:dataSource ""^^rdfs:Literal ;
    ns3:hasContextualInfo ns3:Programme1,
        ns3:Protocol1,
        ns3:Rating1,
        ns3:State1 ;
    ns3:unit ""^^rdfs:Literal ;
    ns3:value ""^^rdfs:Literal ;
    ns3:wasCollectedBy ns3:Patient1 .

ns3:ContextualDataInfo1 a owl:NamedIndividual,
        ns3:ContextualInfo ;
    ns3:locationOfPatient "" .

ns3:PGHDRequest1 a owl:NamedIndividual,
        ns3:PGHDRequest ;
    prov:endedAtTime "1000-10-10T00:00:00"^^xsd:dateTime ;
    prov:startedAtTime "1000-10-10T00:00:00"^^xsd:dateTime ;
    prov:used ns3:application1 ;
    ns3:PGHDRequestedBy ns3:Practitioner1 ;
    ns3:description "" ;
    ns3:requestId "" ;
    ns3:wasAuthorizedBy ns3:Patient1 .

ns3:PatientRelative1 a owl:NamedIndividual,
        ns3:PatientRelative ;
    prov:actedOnBehalfOf ns3:Patient1 ;
    foaf:name "" ;
    ns3:address "" ;
    ns3:id "" ;
    ns3:phoneNumber "" ;
    ns3:relationship "" .

ns3:State2 a owl:NamedIndividual,
        ns3:State ;
    ns3:posture "" .

ns3:address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:comment "A standardized representation of the location of a person, business, building, or organization." ;
    rdfs:domain prov:Person ;
    rdfs:isDefinedBy "http://purl.obolibrary.org/obo/NCIT_C25407" ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/2006/vcard/ns#hasAddress> .

ns3:authorized a owl:ObjectProperty ;
    rdfs:label "authorized"@en ;
    rdfs:comment "Indicates that an agent authorized an activity. Inverse of pghdprovo:wasAuthorizedBy."@en ;
    rdfs:domain ns3:Patient ;
    rdfs:range ns3:PGHDRequest ;
    owl:inverseOf ns3:wasAuthorizedBy .

ns3:bodySite a owl:DatatypeProperty ;
    rdfs:label "Body Site" ;
    rdfs:comment "The part of the body where data is collected or which a device was placed to collect health data." ;
    rdfs:domain ns3:Protocol ;
    rdfs:range rdfs:Literal .

ns3:calibrationStatus a owl:DatatypeProperty ;
    rdfs:label "calibration status" ;
    rdfs:comment "Specifies the calibration state of the device that produced the patient-generated health data. Preferred value includes calibrated, not-calibrated, calibration-due, unknown, and self-check-performed." ;
    rdfs:domain ns3:Protocol ;
    rdfs:range rdfs:Literal .

ns3:code a owl:DatatypeProperty ;
    rdfs:label "code" ;
    rdfs:comment "A code associated with the resource." ;
    rdfs:domain ns3:PGHD ;
    rdfs:range rdfs:Literal .

ns3:collected a owl:ObjectProperty ;
    rdfs:label "collected"@en ;
    rdfs:comment "Indicates that an agent collected data from an entity. Inverse of pghdprovo:wasCollectedBy."@en ;
    rdfs:domain prov:Person ;
    rdfs:range ns3:PGHD ;
    owl:inverseOf ns3:wasCollectedBy .

ns3:consentDate a owl:DatatypeProperty ;
    rdfs:label "Consent Date" ;
    rdfs:comment "The date and time the consent was issued." ;
    rdfs:domain ns3:Consent ;
    rdfs:range xsd:dateTime .

ns3:consentPolicy a owl:DatatypeProperty ;
    rdfs:label "Consent Policy URI" ;
    rdfs:comment "The URI for the specific organizational or jurisdictional policy referenced." ;
    rdfs:domain ns3:Consent ;
    rdfs:range rdfs:Literal .

ns3:consentRegulatory a owl:DatatypeProperty ;
    rdfs:label "Consent Regulatory Rule URI" ;
    rdfs:comment "The URI for the computable regulation or policy rule." ;
    rdfs:domain ns3:Consent ;
    rdfs:range rdfs:Literal .

ns3:consentSourceReference a owl:DatatypeProperty ;
    rdfs:label "Consent Source Reference" ;
    rdfs:comment "A string reference (URL, ID, or description) pointing to the original source of the consent." ;
    rdfs:domain ns3:Consent ;
    rdfs:range rdfs:Literal .

ns3:dataCoveredByConsent a owl:ObjectProperty ;
    rdfs:label "Data Covered By Consent" ;
    rdfs:comment "Indicates consents that cover this specific PGHD data." ;
    rdfs:domain ns3:PGHD ;
    rdfs:range ns3:Consent ;
    owl:inverseOf ns3:consentProvisionData .

ns3:dataName a owl:DatatypeProperty ;
    rdfs:label "data name" ;
    rdfs:comment "The 'dataName' property indicates the type of measurement or observation being recorded, such as heart rate, blood pressure, step count, or sleep duration." ;
    rdfs:domain ns3:PGHD ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf foaf:name .

ns3:dateCollected a owl:DatatypeProperty ;
    rdfs:label "date collected" ;
    rdfs:comment "The 'dateCollected' property records the date and time when the measurement or observation was taken." ;
    rdfs:domain ns3:PGHD ;
    rdfs:range rdfs:Literal .

ns3:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:comment "Provide more information about an activity." ;
    rdfs:domain ns3:PGHDRequest ;
    rdfs:range rdfs:Literal .

ns3:deviceModel a owl:DatatypeProperty ;
    rdfs:label "device model" ;
    rdfs:comment "A unique number or name given by a device manufacturer to devices that corresponds to a certain characteristics." ;
    rdfs:domain <https://saref.etsi.org/core/Device> ;
    rdfs:range rdfs:Literal .

ns3:deviceName a owl:DatatypeProperty ;
    rdfs:label "device name" ;
    rdfs:comment "A name for a device." ;
    rdfs:domain <https://saref.etsi.org/core/Device> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf foaf:name .

ns3:exerciseState a owl:DatatypeProperty ;
    rdfs:label "exercise state" ;
    rdfs:comment "exercise state." ;
    rdfs:domain ns3:State ;
    rdfs:range rdfs:Literal .

ns3:hasStaff a owl:ObjectProperty ;
    rdfs:label "has staff"@en ;
    rdfs:comment "Indicates that an organization has a staff member. Inverse of pghdprovo:isAStaffOf."@en ;
    rdfs:domain prov:Organization ;
    rdfs:range ns3:Practitioner ;
    owl:inverseOf ns3:isAStaffOf .

ns3:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:comment "Identifier" ;
    rdfs:domain prov:Person ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier .

ns3:locationOfPatient a owl:DatatypeProperty ;
    rdfs:label "location of patient" ;
    rdfs:comment "Location of a patient during data collection." ;
    rdfs:domain ns3:ContextualInfo ;
    rdfs:range rdfs:Literal .

ns3:orgAddress a owl:DatatypeProperty ;
    rdfs:label "organization address" ;
    rdfs:comment "Location of organisation." ;
    rdfs:domain prov:Organization ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/2006/vcard/ns#hasAddress> .

ns3:orgEmail a owl:DatatypeProperty ;
    rdfs:label "organization email" ;
    rdfs:comment "Organization email address." ;
    rdfs:domain prov:Organization ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/2006/vcard/ns#hasEmail> .

ns3:orgId a owl:DatatypeProperty ;
    rdfs:label "organization id" ;
    rdfs:comment "An identifier for an organization." ;
    rdfs:domain prov:Organization ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier .

ns3:orgName a owl:DatatypeProperty ;
    rdfs:label "organization name" ;
    rdfs:comment "The name of the organization where a practitioner belongs." ;
    rdfs:domain prov:Organization ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf foaf:name .

ns3:organisationConsented a owl:ObjectProperty ;
    rdfs:label "Organisation Consented" ;
    rdfs:comment "Indicates consents managed or enforced by the organization." ;
    rdfs:domain prov:Organization ;
    rdfs:range ns3:Consent ;
    owl:inverseOf ns3:consentOrganisation .

ns3:patientConsented a owl:ObjectProperty ;
    rdfs:label "Patient Consented" ;
    rdfs:comment "Indicates consents associated with this patient." ;
    rdfs:domain ns3:Patient ;
    rdfs:range ns3:Consent ;
    owl:inverseOf ns3:consentPatient .

ns3:phoneNumber a owl:DatatypeProperty ;
    rdfs:label "phone number" ;
    rdfs:comment "Phone contact number." ;
    rdfs:domain prov:Person ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/2006/vcard/ns#hasTelephone> .

ns3:posture a owl:DatatypeProperty ;
    rdfs:label "posture" ;
    rdfs:comment "The body position of the patient during data collection." ;
    rdfs:domain ns3:State ;
    rdfs:range rdfs:Literal .

ns3:programmeName a owl:DatatypeProperty ;
    rdfs:label "programme name" ;
    rdfs:comment "The treatment programme associated with the PGHD request." ;
    rdfs:domain ns3:Programme ;
    rdfs:range rdfs:Literal .

ns3:ratingOrgName a owl:DatatypeProperty ;
    rdfs:label "rating organization name" ;
    rdfs:comment "Denotes the name of the organization that conducted the rating." ;
    rdfs:domain ns3:Rating ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf owl:topDataProperty .

ns3:ratingScore a owl:DatatypeProperty ;
    rdfs:label "rating score" ;
    rdfs:comment "The efficiency rating of an equipement or device by recognized body." ;
    rdfs:domain ns3:Rating ;
    rdfs:range rdfs:Literal .

ns3:serviceProviderConsented a owl:ObjectProperty ;
    rdfs:label "Service Provider Consented" ;
    rdfs:comment "Indicates consents associated with this practitioner or provider." ;
    rdfs:domain ns3:Practitioner ;
    rdfs:range ns3:Consent ;
    owl:inverseOf ns3:consentServiceProvider .

ns3:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:comment "The 'unit' property specifies the metric or unit of measurement associated with the observed value." ;
    rdfs:domain ns3:PGHD ;
    rdfs:range rdfs:Literal .

ns3:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment "The 'value' property represents the quantity measured or observed, typically recorded by a health or activity monitoring device." ;
    rdfs:domain ns3:PGHD ;
    rdfs:range rdfs:Literal .

<http://www.w3.org/2006/vcard/ns#hasEmail> a owl:DatatypeProperty ;
    rdfs:label "has email" ;
    rdfs:comment "To specify the electronic mail address for communication with the object" ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal .

<http://www.w3.org/2006/vcard/ns#hasRole> a owl:DatatypeProperty ;
    rdfs:label "has role"@en ;
    rdfs:comment "To specify the function or part played in a particular situation by an individual."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal .

<http://www.w3.org/2006/vcard/ns#hasTelephone> a owl:DatatypeProperty ;
    rdfs:label "has telephone"@en ;
    rdfs:comment "To specify the telephone number for telephony communication with the object."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf owl:topDataProperty .

prov:SoftwareAgent a owl:Class ;
    rdfs:label "SoftwareAgent" ;
    rdfs:comment "A running software system acting as an agent in provenance descriptions."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Agent ;
    prov:category "expanded" ;
    prov:component "agents-responsibility" ;
    prov:definition "A software agent is running software."@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

prov:actedOnBehalfOf a owl:ObjectProperty ;
    rdfs:label "actedOnBehalfOf" ;
    rdfs:comment "An object property to express the accountability of an agent towards another agent. The subordinate agent acted on behalf of the responsible agent in an actual activity. "@en ;
    rdfs:domain prov:Agent ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    owl:inverseOf ns3:hadDelegate ;
    prov:category "starting-point" ;
    prov:component "agents-responsibility" ;
    prov:inverse "hadDelegate" ;
    prov:qualifiedForm prov:Delegation,
        prov:qualifiedDelegation .

prov:used a owl:ObjectProperty ;
    rdfs:label "used" ;
    rdfs:comment "A prov:Entity that was used by this prov:Activity. For example, :baking prov:used :spoon, :egg, :oven ."@en ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Entity ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:inverse "wasUsedBy" ;
    prov:qualifiedForm prov:Usage,
        prov:qualifiedUsage .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:label "wasAssociatedWith" ;
    rdfs:comment "An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity."@en ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    owl:inverseOf ns3:associatedWith ;
    prov:category "starting-point" ;
    prov:component "agents-responsibility" ;
    prov:inverse "wasAssociateFor" ;
    prov:qualifiedForm prov:Association,
        prov:qualifiedAssociation .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "wasGeneratedBy" ;
    rdfs:comment "Indicates that an entity was generated by an activity."@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Activity ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:inverse "generated" ;
    prov:qualifiedForm prov:Generation,
        prov:qualifiedGeneration .

foaf:age a owl:DatatypeProperty ;
    rdfs:label "age" ;
    rdfs:comment "A person's age, usually expressed in years, represented as an integer."@en ;
    rdfs:domain prov:Person ;
    rdfs:range rdfs:Literal .

foaf:birthday a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "birthday" ;
    rdfs:comment "The birthday of this Agent, represented in mm-dd string form, eg. '12-31'." ;
    rdfs:domain prov:Person ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf foaf:age ;
    ns1:term_status "unstable" .

foaf:gender a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "gender" ;
    rdfs:comment "The gender of this Agent (typically but not necessarily 'male' or 'female')." ;
    rdfs:domain prov:Person ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "testing" .

foaf:givenName a owl:DatatypeProperty ;
    rdfs:label "Given name" ;
    rdfs:comment "The given name of some person." ;
    rdfs:domain prov:Person ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "testing" .

<https://saref.etsi.org/saref4wear/Wearable> a owl:Class ;
    rdfs:label "Wearable device"@en ;
    rdfs:comment "A wearable device is a device that is intended to be located near, on or in an organism."@en ;
    rdfs:subClassOf <https://saref.etsi.org/core/Device> .

ns3:BPMonitor a owl:NamedIndividual,
        <https://saref.etsi.org/core/Device> ;
    ns3:deviceModel "" ;
    ns3:deviceName "" .

ns3:Carer a owl:Class ;
    rdfs:label "Carer" ;
    rdfs:comment "A Person who helps a patient to collect or transmit data." ;
    rdfs:subClassOf prov:Person .

ns3:Organisation1 a owl:NamedIndividual,
        prov:Organization ;
    ns3:orgAddress "" ;
    ns3:orgEmail "" ;
    ns3:orgId "" ;
    ns3:orgName "" .

ns3:PGHDRequestedBy a owl:ObjectProperty ;
    rdfs:label "PGHD requested by" ;
    rdfs:comment "A object property that declares the prov:agent responsible for the initializing a request for acquiring of patient Health data." ;
    rdfs:domain ns3:PGHDRequest ;
    rdfs:range ns3:Practitioner ;
    owl:inverseOf ns3:requested .

ns3:Programme1 a owl:NamedIndividual,
        ns3:Programme ;
    ns3:programmeName "" .

ns3:Protocol1 a owl:NamedIndividual,
        ns3:Protocol ;
    ns3:bodySite "" .

ns3:Rating1 a owl:NamedIndividual,
        ns3:Rating ;
    ns3:ratingOrgName "" ;
    ns3:ratingScore "" .

ns3:State1 a owl:NamedIndividual,
        ns3:State ;
    ns3:exerciseState "" ;
    ns3:posture "" .

ns3:appName a owl:DatatypeProperty ;
    rdfs:label "app name" ;
    rdfs:comment "The name of the software application utilised by a patient and practitioner." ;
    rdfs:domain ns3:Application ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf foaf:name .

ns3:application1 a owl:NamedIndividual,
        ns3:Application ;
    prov:wasAttributedTo ns3:Practitioner1 ;
    ns3:appName "" .

ns3:associatedWith a owl:ObjectProperty ;
    rdfs:label "associated with"@en ;
    rdfs:comment "Defines association between an agent and an activity. Inverse of prov:wasAssociatedWith."@en ;
    rdfs:domain prov:Agent ;
    rdfs:range prov:Activity .

ns3:consentOrganisation a owl:ObjectProperty ;
    rdfs:label "Consent Organization" ;
    rdfs:comment "The organization managing or enforcing this consent." ;
    rdfs:domain ns3:Consent ;
    rdfs:range prov:Organization .

ns3:consentPatient a owl:ObjectProperty ;
    rdfs:label "Consent Patient" ;
    rdfs:comment "The patient to whom this consent applies." ;
    rdfs:domain ns3:Consent ;
    rdfs:range ns3:Patient .

ns3:consentProvisionData a owl:ObjectProperty ;
    rdfs:label "Consent Provision Data" ;
    rdfs:comment "The specific observations (data) covered by this consent rule." ;
    rdfs:domain ns3:Consent ;
    rdfs:range ns3:PGHD .

ns3:consentServiceProvider a owl:ObjectProperty ;
    rdfs:label "Consent Service Provider" ;
    rdfs:comment "The practitioner or provider associated with the consent agreement." ;
    rdfs:domain ns3:Consent ;
    rdfs:range ns3:Practitioner .

ns3:contributed a owl:ObjectProperty ;
    rdfs:label "contributed"@en ;
    rdfs:comment "Indicates that an agent contributed to an entity. Inverse of prov:wasAttributedTo."@en ;
    rdfs:domain prov:Agent ;
    rdfs:range prov:Entity .

ns3:dataSource a owl:DatatypeProperty ;
    rdfs:label "data source" ;
    rdfs:comment "An entity that produce a digital data." ;
    rdfs:domain ns3:PGHD ;
    rdfs:range rdfs:Literal .

ns3:hadDelegate a owl:ObjectProperty ;
    rdfs:label "had delegate"@en ;
    rdfs:comment "Indicates that an agent had another agent act on their behalf. Inverse of prov:actedOnBehalfOf."@en ;
    rdfs:domain prov:Agent ;
    rdfs:range prov:Agent .

ns3:hasContextualInfo a owl:ObjectProperty ;
    rdfs:label "Contain Contextual Info" ;
    rdfs:comment "Has some contextual information associated to the PGHD" ;
    rdfs:domain ns3:PGHD ;
    rdfs:range ns3:ContextualInfo ;
    owl:inverseOf ns3:isContextualInfoOf .

ns3:isAStaffOf a owl:ObjectProperty ;
    rdfs:label "is a staff of" ;
    rdfs:comment "Shows the institution a person works." ;
    rdfs:domain ns3:Practitioner ;
    rdfs:range prov:Organization .

ns3:isContextualInfoOf a owl:ObjectProperty ;
    rdfs:label "is contextual info of"@en ;
    rdfs:comment "Relates contextual information back to the entity it describes. Inverse of pghdprovo:hasContextualInfo."@en ;
    rdfs:domain ns3:ContextualInfo ;
    rdfs:range ns3:PGHD .

ns3:isSourceOf a owl:ObjectProperty ;
    rdfs:label "is source of"@en ;
    rdfs:comment "Indicates that an entity served as the source for a derived entity. Inverse of prov:wasDerivedFrom."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

ns3:relationship a owl:DatatypeProperty ;
    rdfs:label "relationship" ;
    rdfs:comment "shows the relationship of a caregiver, friend, or relative to a patient." ;
    rdfs:domain ns3:PatientRelative ;
    rdfs:range rdfs:Literal .

ns3:requestId a owl:DatatypeProperty ;
    rdfs:label "activity id" ;
    rdfs:comment "Log id for an activity." ;
    rdfs:domain ns3:PGHDRequest ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier .

ns3:requested a owl:ObjectProperty ;
    rdfs:label "requested"@en ;
    rdfs:comment "Indicates that an agent made a request for PGHD. Inverse of pghdprovo:PGHDRequestedBy."@en ;
    rdfs:domain ns3:Practitioner ;
    rdfs:range ns3:PGHDRequest .

ns3:role a owl:DatatypeProperty ;
    rdfs:label "role" ;
    rdfs:comment "position or function within an organization" ;
    rdfs:domain ns3:Practitioner ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://www.w3.org/2006/vcard/ns#hasRole> .

<http://www.w3.org/2006/vcard/ns#hasAddress> a owl:DatatypeProperty ;
    rdfs:label "has address"@en ;
    rdfs:comment "To specify the components of the delivery address for the vCard object."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf owl:topDataProperty .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "wasDerivedFrom" ;
    rdfs:comment "The more specific subproperties of prov:wasDerivedFrom (i.e., prov:wasQuotedFrom, prov:wasRevisionOf, prov:hadPrimarySource) should be used when applicable."@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Entity ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    owl:inverseOf ns3:isSourceOf ;
    prov:category "starting-point" ;
    prov:component "derivations" ;
    prov:definition "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en ;
    prov:inverse "hadDerivation" ;
    prov:qualifiedForm prov:Derivation,
        prov:qualifiedDerivation .

ns3:Practitioner1 a owl:NamedIndividual,
        ns3:Practitioner ;
    foaf:name "" ;
    ns3:address "" ;
    ns3:id "" ;
    ns3:isAStaffOf ns3:Organisation1 ;
    ns3:phoneNumber "" ;
    ns3:role "" .

ns3:wasAuthorizedBy a owl:ObjectProperty ;
    rdfs:label "was authorized by" ;
    rdfs:comment "A person who grant access to data requested." ;
    rdfs:domain ns3:PGHDRequest ;
    rdfs:range ns3:Patient .

ns3:wasCollectedBy a owl:ObjectProperty ;
    rdfs:label "was collected by" ;
    rdfs:comment "Ascribing a person engaged in the retrieval of health data. This could be the patient themself, a caregiver, a relative, or a friend." ;
    rdfs:domain ns3:PGHD ;
    rdfs:range prov:Person .

dc:identifier a owl:DatatypeProperty ;
    rdfs:label "Identifier" ;
    rdfs:comment "Recommended practice is to identify the resource by means of a string conforming to an identification system." ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal ;
    prov:definition "An unambiguous reference to the resource within a given context." .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "wasAttributedTo" ;
    rdfs:comment "Attribution is the ascribing of an entity to an agent."@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    owl:inverseOf ns3:contributed ;
    prov:category "starting-point" ;
    prov:component "agents-responsibility" ;
    prov:definition "Attribution is the ascribing of an entity to an agent."@en ;
    prov:inverse "contributed" ;
    prov:qualifiedForm prov:Attribution,
        prov:qualifiedAttribution .

ns3:PatientRelative a owl:Class ;
    rdfs:label "Patient Relative" ;
    rdfs:comment "A Patient relative or friend who helps to collect or transmit data." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty ns3:relationship ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty prov:actedOnBehalfOf ;
            owl:someValuesFrom ns3:Patient ],
        ns3:Carer .

ns3:Programme a owl:Class ;
    rdfs:label "programme" ;
    rdfs:comment "Refers to a health plan or program the person is following, helping to understand the data in relation to their health goals." ;
    rdfs:subClassOf ns3:ContextualInfo .

foaf:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "A name for some thing." ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal .

ns3:Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "A software application is a software that can be directly executed by some processing unit." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:wasAttributedTo ;
            owl:someValuesFrom prov:Person ],
        [ a owl:Restriction ;
            owl:onProperty ns3:appName ;
            owl:someValuesFrom xsd:string ],
        prov:Entity .

ns3:Patient1 a owl:NamedIndividual,
        ns3:Patient ;
    foaf:name "" ;
    ns3:address "" ;
    ns3:id "" ;
    ns3:phoneNumber "" .

ns3:Protocol a owl:Class ;
    rdfs:label "protocol" ;
    rdfs:comment "Describes the steps or rules followed when collecting the data, such as instructions for using a device or following a specific health procedure." ;
    rdfs:subClassOf ns3:ContextualInfo .

ns3:Rating a owl:Class ;
    rdfs:label "rating" ;
    rdfs:comment "Includes scores or opinions about the measurement, like how good the data is or a personal rating of a health condition." ;
    rdfs:subClassOf ns3:ContextualInfo .

<https://saref.etsi.org/core/Device> a owl:Class ;
    rdfs:label "Device"@en ;
    rdfs:comment "A tangible object designed to accomplish a particular task. In order to accomplish this task, the device performs one or more functions. For example, a washing machine is designed to wash (task) and to accomplish this task it performs a start and stop function."@en ;
    rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
    rdfs:subClassOf prov:Entity .

ns3:State a owl:Class ;
    rdfs:label "state" ;
    rdfs:comment "Informaion about the person's condition when the data was recorded, such as whether they were resting, active, sleeping, or exercising." ;
    rdfs:subClassOf ns3:ContextualInfo .

prov:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "An action or process that occurs over a period of time and acts upon entities."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    owl:disjointWith prov:Entity ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    prov:definition "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities." ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Activity"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Activity"^^xsd:anyURI .

prov:wasInfluencedBy a owl:ObjectProperty ;
    rdfs:label "was influenced by" ;
    rdfs:comment "Indicates that one entity, activity, or agent was influenced by another."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

ns3:PGHDRequest a owl:Class ;
    rdfs:label "PGHD Request" ;
    rdfs:comment "A request made by a practitioner to obtain patient health data generated by wearable device or software application." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:Patient ;
            owl:onProperty prov:wasAssociatedWith ],
        [ a owl:Restriction ;
            owl:onProperty ns3:PGHDRequestedBy ;
            owl:someValuesFrom ns3:Practitioner ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ns3:requestId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom ns3:Application ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Patient ;
            owl:onProperty ns3:wasAuthorizedBy ],
        prov:Activity .

prov:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A social or legal entity such as a company, institution, or association."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Agent ;
    prov:category "expanded" ;
    prov:component "agents-responsibility" ;
    prov:definition "An organization is a social or legal institution such as a company, society, etc." ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

ns3:ContextualInfo a owl:Class ;
    rdfs:label "contextual information" ;
    rdfs:comment "Contextual Information provides to extra details that help explain the measurement, like the environment, device settings, or the activity the person was doing when the data was taken." ;
    rdfs:subClassOf prov:Entity .

ns3:Practitioner a owl:Class ;
    rdfs:label "Practitioner" ;
    rdfs:comment "A person professionally engaged medical practice who is appointed to a post or duties.\\n[Definition Source: NCI]" ;
    rdfs:isDefinedBy "http://purl.obolibrary.org/obo/NCIT_C51846" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty ns3:role ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        prov:Person .

prov:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "Something that bears responsibility for an activity taking place, for the existence of an entity, or for another agent's activity."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    prov:category "starting-point" ;
    prov:component "agents-responsibility" ;
    prov:definition "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity. "@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Agent"^^xsd:anyURI .

ns3:Patient a owl:Class ;
    rdfs:label "Patient" ;
    rdfs:comment "A person who receives medical attention, care, or treatment, or who is registered with medical professional or institution with the purpose to receive medical care when necessary." ;
    rdfs:isDefinedBy "http://purl.obolibrary.org/obo/NCIT_C16960" ;
    rdfs:subClassOf prov:Person .

ns3:Consent a owl:Class ;
    rdfs:label "Consent" ;
    rdfs:comment "A record of consent for Patient Generated Health Data." ;
    rdfs:subClassOf prov:Entity .

ns3:PGHD a owl:Class ;
    rdfs:label "PGHD" ;
    rdfs:comment "Patient Generated Health Data (PGHD) a term referring to data that patients (or their caregivers) collect from home or any location outside the clinical environment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:hasContextualInfo ;
            owl:someValuesFrom ns3:ContextualInfo ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Patient ;
            owl:onProperty prov:wasAttributedTo ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom <https://saref.etsi.org/saref4wear/Wearable> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:PGHDRequest ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:onProperty ns3:wasCollectedBy ;
            owl:someValuesFrom prov:Person ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty ns3:dataSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        prov:Entity .

prov:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    prov:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary. "@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-entity"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Entity"^^xsd:anyURI .

prov:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "Person agents are people."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:birthday ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:gender ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:givenName ],
        prov:Agent ;
    prov:category "expanded" ;
    prov:component "agents-responsibility" ;
    prov:definition "Person agents are people."@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://saref.etsi.org/core/Device> ns3:Application ns3:ContextualInfo ns3:PGHD ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns3:Patient ns3:PatientRelative ns3:Practitioner ) .

[] a owl:Axiom ;
    rdfs:comment "Derivation is a particular case of trace (see http://www.w3.org/TR/prov-dm/#term-trace), since it links an entity to another entity that contributed to its existence." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource prov:wasDerivedFrom ;
    owl:annotatedTarget prov:wasInfluencedBy .

[] a owl:AllDisjointClasses ;
    owl:members ( prov:Organization prov:Person prov:SoftwareAgent ) .

[] a owl:Axiom ;
    rdfs:comment "Attribution is a particular case of trace (see http://www.w3.org/TR/prov-dm/#concept-trace), in the sense that it links an entity to the agent that ascribed it." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource prov:wasAttributedTo ;
    owl:annotatedTarget prov:wasInfluencedBy ;
    prov:definition "IF wasAttributedTo(e2,ag1,aAttr) holds, THEN wasInfluencedBy(e2,ag1) also holds. " .

[] a owl:AllDisjointClasses ;
    owl:members ( ns3:Programme ns3:Protocol ns3:Rating ns3:State ) .

