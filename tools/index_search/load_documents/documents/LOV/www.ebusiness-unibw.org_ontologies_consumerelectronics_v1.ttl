    ns1:belongsToModule "MP3Player, TV"@en ;
    rdfs:comment "The business entity Packard Bell."@en ;
    rdfs:seeAlso <http://www.packardbell.com/> .

ns1:Palm a ns2:BusinessEntity ;
    rdfs:label "Palm"^^xsd:string ;
