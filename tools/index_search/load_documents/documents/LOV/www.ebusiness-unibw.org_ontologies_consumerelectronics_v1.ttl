    ns2:legalName "COWON SYSTEMS, Inc. "^^xsd:string ;
    ns1:belongsToModule "MP3Player"@en ;
    rdfs:comment "The business entity COWON SYSTEMS, Inc."@en ;
    rdfs:seeAlso <http://www.cowonglobal.com/> .

