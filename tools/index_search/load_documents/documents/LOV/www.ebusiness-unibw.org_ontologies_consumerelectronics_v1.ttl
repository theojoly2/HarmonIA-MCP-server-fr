ns1:DC_Cable a ns1:Accessory ;
    rdfs:label "DC cable"@en ;
    ns1:belongsToModule "Camcorder"@en ;
    rdfs:comment "The mean amplitude of a waveform."@en .

ns1:DK_digital a ns2:BusinessEntity ;
