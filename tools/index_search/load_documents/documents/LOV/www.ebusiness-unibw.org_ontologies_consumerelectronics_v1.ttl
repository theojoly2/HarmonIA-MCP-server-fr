    rdfs:seeAlso <http://www.chimei.com.tw/> .

ns1:Clock a ns1:Features ;
    rdfs:label "Clock"@en ;
    ns1:belongsToModule "MP3Player"@en ;
    rdfs:comment "Can display the current time."@en .

ns1:Coby a ns2:BusinessEntity ;
    rdfs:label "Coby"^^xsd:string ;
    ns2:legalName "Coby Electronics Corporation"^^xsd:string ;
    ns1:belongsToModule "MP3Player, TV"@en ;
