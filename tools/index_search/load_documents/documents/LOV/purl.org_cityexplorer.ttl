ns1:Attraction a owl:Class ;
    rdfs:label "Attraction"@en ;
    rdfs:comment "Refers to an attraction type, which can be cultural, park, etc."@en ;
    rdfs:sameAs "https://schema.org/Attraction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:name ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:aggregateRating ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty ns1:locatedInCity ;
            owl:someValuesFrom ns1:City ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:AttractionTypes ;
            owl:onProperty ns1:hasCategory ],
        [ a owl:Restriction ;
            owl:onProperty ns1:identifier ;
            owl:someValuesFrom xsd:string ] ;
    ns2:term_status "testing"@en .

ns1:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "Refers to an event"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:name ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:locatedInCity ;
            owl:someValuesFrom ns1:City ],
        [ a owl:Restriction ;
            owl:onProperty ns1:identifier ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:startDate ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:EventTypes ;
            owl:onProperty ns1:hasCategory ] ;
    ns2:term_status "testing"@en .

ns1:Transport a owl:Class ;
    rdfs:label "Transport"@en ;
    rdfs:comment "Refers to a way of transport"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:priceRange ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty ns1:locatedInCity ;
            owl:someValuesFrom ns1:City ],
        [ a owl:Restriction ;
            owl:onProperty ns1:company ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:TransportTypes ;
            owl:onProperty ns1:hasCategory ],
        [ a owl:Restriction ;
            owl:onProperty ns1:identifier ;
            owl:someValuesFrom xsd:string ] ;
    ns2:term_status "testing"@en .

ns1:Hotel a owl:Class ;
    rdfs:label "Hotel"@en ;
    rdfs:comment "Refers to an hotel"@en ;
    rdfs:sameAs "https://schema.org/Hotel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:priceRange ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:HotelCategory ;
            owl:onProperty ns1:hasCategory ],
        [ a owl:Restriction ;
            owl:onProperty ns1:locatedInCity ;
            owl:someValuesFrom ns1:City ],
        [ a owl:Restriction ;
            owl:onProperty ns1:name ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:aggregateRating ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty ns1:identifier ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:starRating ;
            owl:someValuesFrom xsd:integer ] ;
    ns2:term_status "testing"@en .

ns1:Restaurant a owl:Class ;
    rdfs:label "Restaurant"@en ;
    rdfs:comment "Refers to a restaurant"@en ;
    rdfs:sameAs "https://schema.org/Restaurant"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:aggregateRating ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty ns1:locatedInCity ;
            owl:someValuesFrom ns1:City ],
        [ a owl:Restriction ;
            owl:onProperty ns1:name ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:priceRange ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:onProperty ns1:identifier ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:RestaurantTypes ;
            owl:onProperty ns1:hasCategory ] ;
    ns2:term_status "testing"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:AndalusianRestaurant ns1:ItalianRestaurant ns1:JapaneseRestaurant ns1:MediterraneanRestaurant ns1:MexicanRestaurant ) .

[] a owl:Class ;
    rdfs:subClassOf ns1:EventTypes ;
    owl:oneOf ( ns1:Cultural ns1:Gastronomic ns1:Music ns1:Sport ns1:Technological ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:BeachAttraction ns1:CulturalAttraction ns1:MonumentAttraction ns1:MuseumAttraction ns1:ParkAttraction ) .

[] a owl:Class ;
    rdfs:subClassOf ns1:RestaurantTypes ;
    owl:oneOf ( ns1:Andalusian ns1:Italianian ns1:Japanese ns1:Mediterranean ns1:Mexican ) .

[] rdfs:comment "An entity responsible for making the resource."@en .

[] a ns3:Imp ;
    rdfs:label "RecommendedRestaurants"@en ;
    rdfs:comment "Rule for recommended restaurants aggregate rating greater than 4.0 and price range less or equal than 20."@en ;
    ns3:body [ a ns3:AtomList ;
            rdf:first [ a ns3:ClassAtom ;
                    ns3:argument1 <urn:swrl:var#r> ;
                    ns3:classPredicate ns1:Restaurant ] ;
            rdf:rest [ a ns3:AtomList ;
                    rdf:first [ a ns3:DatavaluedPropertyAtom ;
                            ns3:argument1 <urn:swrl:var#r> ;
                            ns3:argument2 <urn:swrl:var#ar> ;
                            ns3:propertyPredicate ns1:aggregateRating ] ;
                    rdf:rest [ a ns3:AtomList ;
                            rdf:first [ a ns3:DatavaluedPropertyAtom ;
                                    ns3:argument1 <urn:swrl:var#r> ;
                                    ns3:argument2 <urn:swrl:var#pr> ;
                                    ns3:propertyPredicate ns1:priceRange ] ;
                            rdf:rest [ a ns3:AtomList ;
                                    rdf:first [ a ns3:BuiltinAtom ;
                                            ns3:arguments [ a rdf:List ;
                                                    rdf:first <urn:swrl:var#ar> ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first 4.0 ;
                                                            rdf:rest () ] ] ;
                                            ns3:builtin <http://www.w3.org/2003/11/swrlb#greaterThan> ] ;
                                    rdf:rest [ a ns3:AtomList ;
                                            rdf:first [ a ns3:BuiltinAtom ;
                                                    ns3:arguments [ a rdf:List ;
                                                            rdf:first <urn:swrl:var#pr> ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first 20 ;
                                                                    rdf:rest () ] ] ;
                                                    ns3:builtin <http://www.w3.org/2003/11/swrlb#lessThanOrEqual> ] ;
                                            rdf:rest () ] ] ] ] ] ;
    ns3:head [ a ns3:AtomList ;
            rdf:first [ a ns3:ClassAtom ;
                    ns3:argument1 <urn:swrl:var#r> ;
                    ns3:classPredicate ns1:RecommendedRestaurants ] ;
            rdf:rest () ] .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:CulturalEvent ns1:GastronomicEvent ns1:MusicEvent ns1:SportsEvent ns1:TechnologicalEvent ) .

[] a ns3:Imp ;
    rdfs:label "BeachCities"@en ;
    rdfs:comment "rule for Cities with beach"@en ;
    ns3:body [ a ns3:AtomList ;
            rdf:first [ a ns3:ClassAtom ;
                    ns3:argument1 <urn:swrl:var#c> ;
                    ns3:classPredicate ns1:City ] ;
            rdf:rest [ a ns3:AtomList ;
                    rdf:first [ a ns3:IndividualPropertyAtom ;
                            ns3:argument1 <urn:swrl:var#c> ;
                            ns3:argument2 <urn:swrl:var#a> ;
                            ns3:propertyPredicate ns1:isCityOf ] ;
                    rdf:rest [ a ns3:AtomList ;
                            rdf:first [ a ns3:ClassAtom ;
                                    ns3:argument1 <urn:swrl:var#a> ;
                                    ns3:classPredicate ns1:Attraction ] ;
                            rdf:rest [ a ns3:AtomList ;
                                    rdf:first [ a ns3:ClassAtom ;
                                            ns3:argument1 <urn:swrl:var#a> ;
                                            ns3:classPredicate ns1:BeachAttraction ] ;
                                    rdf:rest () ] ] ] ] ;
    ns3:head [ a ns3:AtomList ;
            rdf:first [ a ns3:ClassAtom ;
                    ns3:argument1 <urn:swrl:var#c> ;
                    ns3:classPredicate ns1:BeachCities ] ;
            rdf:rest () ] .

[] rdfs:label "creator"@en ;
    rdfs:comment "An entity responsible for making the resource.\\nhttp://purl.org/dc/terms/creator"@en .

[] a owl:Class ;
    rdfs:subClassOf ns1:HotelTypes ;
    owl:oneOf ( ns1:Beach ns1:Business ns1:Luxury ns1:Rural ns1:Tourist ) .

[] a owl:Class ;
    rdfs:subClassOf ns1:AttractionTypes ;
    owl:oneOf ( ns1:Beach ns1:Cultural ns1:Monument ns1:Museum ns1:Park ) .

[] a ns3:Imp ;
    rdfs:label "CulturalCities"@en ;
    rdfs:comment "Rule for Cities with cultural attractions or events"@en ;
    ns3:body [ a ns3:AtomList ;
            rdf:first [ a ns3:ClassAtom ;
                    ns3:argument1 <urn:swrl:var#c> ;
                    ns3:classPredicate ns1:City ] ;
            rdf:rest [ a ns3:AtomList ;
                    rdf:first [ a ns3:IndividualPropertyAtom ;
                            ns3:argument1 <urn:swrl:var#c> ;
                            ns3:argument2 <urn:swrl:var#e> ;
                            ns3:propertyPredicate ns1:isCityOf ] ;
                    rdf:rest [ a ns3:AtomList ;
                            rdf:first [ a ns3:ClassAtom ;
                                    ns3:argument1 <urn:swrl:var#e> ;
                                    ns3:classPredicate ns1:Event ] ;
                            rdf:rest [ a ns3:AtomList ;
                                    rdf:first [ a ns3:ClassAtom ;
                                            ns3:argument1 <urn:swrl:var#e> ;
                                            ns3:classPredicate ns1:CulturalEvent ] ;
                                    rdf:rest [ a ns3:AtomList ;
                                            rdf:first [ a ns3:IndividualPropertyAtom ;
                                                    ns3:argument1 <urn:swrl:var#c> ;
                                                    ns3:argument2 <urn:swrl:var#a> ;
                                                    ns3:propertyPredicate ns1:isCityOf ] ;
                                            rdf:rest [ a ns3:AtomList ;
                                                    rdf:first [ a ns3:ClassAtom ;
                                                            ns3:argument1 <urn:swrl:var#a> ;
                                                            ns3:classPredicate ns1:Attraction ] ;
                                                    rdf:rest [ a ns3:AtomList ;
                                                            rdf:first [ a ns3:ClassAtom ;
                                                                    ns3:argument1 <urn:swrl:var#a> ;
                                                                    ns3:classPredicate ns1:CulturalAttraction ] ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    ns3:head [ a ns3:AtomList ;
            rdf:first [ a ns3:ClassAtom ;
                    ns3:argument1 <urn:swrl:var#c> ;
                    ns3:classPredicate ns1:CulturalCities ] ;
            rdf:rest () ] .

[] a owl:Class ;
    rdfs:subClassOf ns1:TransportTypes ;
    owl:oneOf ( ns1:Bus ns1:Metro ns1:PublicBike ns1:Taxi ns1:Tram ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:BeachHotel ns1:BusinessHotel ns1:LuxuryHotel ns1:RuralHotel ns1:TouristHotel ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:BusTransport ns1:MetroTransport ns1:PublicBikeTransport ns1:TaxiTransport ns1:TramTransport ) .

