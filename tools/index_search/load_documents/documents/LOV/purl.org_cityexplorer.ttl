    ns2:term_status "testing"@en .

ns1:name a owl:DatatypeProperty ;
    rdfs:label "Name"@en ;
    rdfs:comment "The name of the item"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Attraction ns1:City ns1:Event ns1:Hotel ns1:Restaurant ns1:Transport ) ] ;
    rdfs:range xsd:string ;
    rdfs:sameAs "https://schema.org/name"@en ;
    rdfs:subPropertyOf owl:topDataProperty .

ns1:HotelCategory a owl:Class ;
    rdfs:label "HotelCategory"@en ;
    rdfs:comment "Includes different hotel categories"@en ;
    rdfs:subClassOf ns1:Category ;
    ns2:term_status "testing"@en .

ns1:identifier a owl:DatatypeProperty ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "The identifier of the object (city, etc.)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Attraction ns1:City ns1:Event ns1:Hotel ns1:Restaurant ns1:Transport ) ] ;
    rdfs:range xsd:string ;
    rdfs:sameAs "https://schema.org/identifier"@en ;
    rdfs:subPropertyOf owl:topDataProperty .

ns1:locatedInCity a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "locatedInCity"@en ;
    rdfs:comment "Indicates if it's located in a city"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Attraction ns1:Event ns1:Hotel ns1:Restaurant ns1:Transport ) ] ;
    rdfs:range ns1:City .

<urn:swrl:var#a> a ns3:Variable .

ns1:CategoryTypes a owl:Class ;
    rdfs:label "CategoryTypes"@en ;
    rdfs:comment "Refers to different types of categories"@en ;
    ns2:term_status "testing"@en .

