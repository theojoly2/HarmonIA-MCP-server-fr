ns1:AndalusianRestaurant a owl:Class ;
    rdfs:label "AndalusianRestaurant"@en ;
    rdfs:comment "Refers to restaurants serving food from Andalusia"@en ;
    rdfs:subClassOf ns1:RestaurantCategory ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Restaurant [ a owl:Restriction ;
                        owl:hasValue ns1:Andalusian ;
                        owl:onProperty ns1:hasCategory ] ) ] ;
    ns2:term_status "testing"@en .

ns1:BeachCities a owl:Class ;
    rdfs:label "BeachCities"@en ;
    rdfs:comment "Refers to cities located at the beach"@en ;
    rdfs:subClassOf ns1:Recommendation ;
    ns2:term_status "testing"@en .

ns1:BeachHotel a owl:Class ;
    rdfs:label "BeachHotel"@en ;
    rdfs:comment "Refers to hotels at the beach"@en ;
    rdfs:subClassOf ns1:HotelCategory ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Hotel [ a owl:Restriction ;
                        owl:hasValue ns1:Beach ;
                        owl:onProperty ns1:hasCategory ] ) ] ;
    ns2:term_status "testing"@en .

ns1:BusTransport a owl:Class ;
    rdfs:label "BusTransport"@en ;
    rdfs:comment "Refers to bus transport"@en ;
    rdfs:subClassOf ns1:TransportCategory ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Transport [ a owl:Restriction ;
                        owl:hasValue ns1:Bus ;
                        owl:onProperty ns1:hasCategory ] ) ] ;
    ns2:term_status "testing"@en .

ns1:BusinessHotel a owl:Class ;
    rdfs:label "BusinessHotel"@en ;
    rdfs:comment "Refers to hotels considered for business"@en ;
    rdfs:subClassOf ns1:HotelCategory ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Hotel [ a owl:Restriction ;
                        owl:hasValue ns1:Business ;
                        owl:onProperty ns1:hasCategory ] ) ] ;
    ns2:term_status "testing"@en .

ns1:CulturalCities a owl:Class ;
    rdfs:label "CulturalCities"@en ;
    rdfs:comment "Refers to cities with cultural interest"@en ;
    rdfs:subClassOf ns1:Recommendation ;
    ns2:term_status "testing"@en .

ns1:GastronomicEvent a owl:Class ;
