ns1: a owl:Ontology ;
    rdfs:label "CityExplorer :ce"@en ;
    dcterms:backwardCompatibility "Backward compatible"@en ;
    dcterms:bibliographicCitation "https://service.tib.eu/webvowl/\\nhttps://oops.linkeddata.es/\\nhttps://dgarijo.github.io/Widoco/doc/tutorial/\\nhttps://github.com/protegeproject/swrlapi/wiki\\nhttps://www.w3.org/RDF/Validator/\\nhttps://schema.org/docs/schemas.html\\n" ;
    dcterms:created "2025-04-15" ;
    dcterms:creator "Carles Asensi Seguer\\nSergi Tur Pinent\\nAbel Bolance Olivares"@en ;
    dcterms:description "This ontology models personalized tourist experiences by representing cities, points of interest, events, accommodations, restaurants, transportation, and their relationships. This ontology is part of a university project."@en ;
    dcterms:identifier "https://purl.org/cityexplorer"@en ;
    dcterms:issued "2025-04-21"@en ;
    dcterms:license "https://creativecommons.org/licenses/by-nc-nd/4.0/deed.en"@en ;
    dcterms:modified "2025-04-21"@en ;
    dcterms:previousVersion "https://purl.org/cityexplorer/1.0"@en ;
    dcterms:publisher "REPRESENTACIÓ DEL CONEIXEMENT - PAC2"@en ;
    dcterms:source "https://purl.org/cityexplorer/data"@en ;
    dcterms:title "CityExplorer Ontology"@en ;
    vann:preferredNamespacePrefix "ce"@en ;
    vann:preferredNamespaceUri "https://purl.org/cityexplorer#"@en ;
    owl:versionIRI <https://purl.org/cityexplorer/1.0> ;
    owl:versionInfo "version 1.0"@en .

