ns1:City a owl:Class ;
    rdfs:label "City"@en ;
    rdfs:comment "Refers to a city"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:name ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:longitude ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:latitude ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:identifier ;
            owl:someValuesFrom xsd:string ] ;
    owl:equivalentClass "https://schema.org/City"@en ;
    ns2:term_status "testing"@en .

ns1:Rural a owl:NamedIndividual .

ns1:Bus a owl:NamedIndividual .

ns1:Museum a owl:NamedIndividual .

ns1:Japanese a owl:NamedIndividual .

ns1:Sport a owl:NamedIndividual .

ns1:Taxi a owl:NamedIndividual .

ns1:Tourist a owl:NamedIndividual .

ns1:Music a owl:NamedIndividual .

ns1:Tram a owl:NamedIndividual .

ns1:Andalusian a owl:NamedIndividual .

ns1:hasCategory a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasCategory"@en ;
    rdfs:comment "Indicate if a class has a specific category"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Attraction ns1:Event ns1:Hotel ns1:Restaurant ns1:Transport ) ] ;
    rdfs:range ns1:CategoryTypes ;
    owl:inverseOf ns1:isCategoryOf .

