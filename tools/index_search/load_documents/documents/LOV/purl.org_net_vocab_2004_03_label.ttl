@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://web.resource.org/cc/> .
@prefix ns2: <http://purl.org/net/vocab/2004/03/label#> .
@prefix onto: <http://purl.org/net/vocab/2004/03/label> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ns2:inversePlural a owl:AnnotationProperty ;
    rdfs:label "inverse plural"@en ;
    ns2:plural "plural forms of inverses"@en ;
    ns2:singular "plural form of inverse"@en ;
    rdfs:comment "A relation between a term and the label of its inverse in literal plural form"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:label .

ns2:inverseSingular a owl:AnnotationProperty ;
    rdfs:label "inverse singular"@en ;
    ns2:plural "singular forms of inverses"@en ;
    ns2:singular "singular form of inverse"@en ;
    rdfs:comment "A relation between a term and the label of its inverse in literal singular form"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:label .

ns2:plural a owl:AnnotationProperty ;
    rdfs:label "plural"@en ;
    ns2:plural "plural forms"@en ;
    ns2:singular "plural form"@en ;
    rdfs:comment "A relation between a term and its label in literal plural form"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:label .

ns2:singular a owl:AnnotationProperty ;
    rdfs:label "singular"@en ;
    ns2:plural "singular forms"@en ;
    ns2:singular "singular form"@en ;
    rdfs:comment "A relation between a term and its label in literal singular form"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:label .

onto: a ns1:Work,
        owl:Ontology ;
    rdfs:label "label"@en ;
    dcterms:created "2004-03-28"@en ;
    ns1:license <http://creativecommons.org/licenses/by/1.0/> ;
    rdfs:comment "Term definitions for singular and plural label properties, and their inverses, for RDF terms"@en ;
    owl:imports <http://www.w3.org/2000/01/rdf-schema>,
        <http://www.w3.org/2002/07/owl> ;
    foaf:maker [ a foaf:Person ;
            foaf:homepage <http://www.wasab.dk/morten/> ;
            foaf:mbox_sha1sum "65b983bb397fb71849da910996741752ace8369b" ;
            foaf:name "Morten Høybye Frederiksen" ] .

