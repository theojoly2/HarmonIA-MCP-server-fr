@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://www.w3.org/1999/xhtml/vocab#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix onto: <http://purl.org/media> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://payswarm.com/vocabs/media> ns3:attributionName "Digital Bazaar, Inc."@en ;
    ns3:attributionURL <http://digitalbazaar.com/> ;
    ns2:license <http://creativecommons.org/licenses/publicdomain/> ;
    ns2:stylesheet <http://payswarm.com/css/vocabulary.css> .

<http://purl.org/commerce#costs> a owl:DatatypeProperty ;
    rdfs:comment "A link to a\\n            method of paying for a full version of the media recording."@en ;
    ns1:term_status "stable"@en .

<http://purl.org/commerce#payment> a owl:DatatypeProperty ;
    rdfs:comment "A link to a\\n            method of paying for a full version of the media recording."@en ;
    ns1:term_status "stable"@en .

dcterms:contributor a owl:DatatypeProperty ;
    rdfs:comment "An entity that\\n            helped create the media recording."@en ;
    rdfs:range <http://www.w3.org/2001/vcard-rdf/3.0>,
        foaf:Agent,
        foaf:Person ;
    ns1:term_status "stable"@en .

dcterms:creator a owl:DatatypeProperty ;
    rdfs:comment "The primary\\n            creator or performer of the media recording."@en ;
    rdfs:range <http://www.w3.org/2001/vcard-rdf/3.0>,
        foaf:Agent,
        foaf:Person ;
    ns1:term_status "stable"@en .

dcterms:date a owl:DatatypeProperty ;
    rdfs:comment "The date the\\n            media recording was published."@en ;
    rdfs:range xsd:date ;
    ns1:term_status "stable"@en .

dcterms:description a owl:DatatypeProperty ;
    rdfs:comment "The description\\n            associated with the media recording."@en ;
    rdfs:range rdf:XMLLiteral ;
    ns1:term_status "stable"@en .

dcterms:title a owl:DatatypeProperty ;
    rdfs:comment "title of the\\n            media recording"@en ;
    ns1:term_status "stable"@en .

dcterms:type a owl:DatatypeProperty ;
    rdfs:comment "A genre that\\n            should be associated with the media recording."@en ;
    ns1:term_status "stable"@en .

onto: a owl:Ontology ;
    dcterms:description "The Media RDF vocabulary is not meant to be used by itself if you are marking up audio or video. If the media that you are marking up falls outside of audio/video, you should use the Media RDF Vocabulary if there is no other way to mark up the information. You may want to use the <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://purl.org/media/audio\" xml:lang=\"en\">Audio RDF Vocabulary</a> or <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://purl.org/media/video\" xml:lang=\"en\">Video RDF Vocabulary</a> if you are marking up audio or video."^^rdf:XMLLiteral ;
    dcterms:title "The Media Vocabulary"@en .

<http://purl.org/media#Collection> a owl:Class ;
    rdfs:label "<a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://purl.org/media#Collection\" xml:lang=\"en\">media:Collection</a>"^^rdf:XMLLiteral ;
    rdfs:comment "A collection of\\n            one or more media recordings."@en ;
    rdfs:subClassOf dcterms:Collection,
        <http://purl.org/media/media#Recording> ;
    ns1:term_status "stable"@en .

<http://purl.org/media#Recording> a owl:Class ;
    rdfs:label "<a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://purl.org/media#Recording\" xml:lang=\"en\">media:Recording</a>"^^rdf:XMLLiteral ;
    rdfs:comment "A recording of an item of interest in any form."@en ;
    rdfs:subClassOf owl:Thing ;
    ns1:term_status "stable"@en .

<http://purl.org/media#contains> a owl:DatatypeProperty ;
    rdfs:comment "Relationship for\\n            linking singular media recordings to collections or media recordings. Also used to denote pieces of a media recording that constitute a larger media recording.."@en ;
    ns1:term_status "stable"@en .

<http://purl.org/media#depiction> a owl:DatatypeProperty ;
    rdfs:comment "An image summary\\n            of the media recording."@en ;
    ns1:term_status "stable"@en .

<http://purl.org/media#download> a owl:DatatypeProperty ;
    rdfs:comment "A link to a\\n            complete audio file representation of the media recording."@en ;
    ns1:term_status "stable"@en .

<http://purl.org/media#duration> a owl:DatatypeProperty ;
    rdfs:comment "The length of the\\n            media recording encoded in ISO-8601 time duration format."@en ;
    rdfs:range xsd:duration ;
    ns1:term_status "stable"@en .

<http://purl.org/media#position> a owl:DatatypeProperty ;
    rdfs:comment "The position of\\n            the media recording in an album, LP, playlist, top 10 list,\\n            podcast history or other ordered list of media recordings."@en ;
    rdfs:range xsd:integer ;
    ns1:term_status "stable"@en .

<http://purl.org/media#rating> a owl:DatatypeProperty ;
    rdfs:comment "A standards-body\\n            rating such as PG-13, M, 18-SX, 15, AV15+, Explicit Lyrics, \\n            etc."@en ;
    ns1:term_status "testing"@en .

<http://purl.org/media#sample> a owl:DatatypeProperty ;
    rdfs:comment "A link to a\\n            sample file or stream of the media recording."@en ;
    ns1:term_status "stable"@en .

<http://purl.org/media/audio> owl:imports dcterms:,
        ns2: .

ns2:license a owl:DatatypeProperty ;
    rdfs:comment "The license under\\n            which the media recording is distributed."@en ;
    ns1:term_status "stable"@en .

