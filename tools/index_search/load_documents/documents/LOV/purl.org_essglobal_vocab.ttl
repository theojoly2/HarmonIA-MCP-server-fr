@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://purl.org/essglobal/vocab/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:Address a rdfs:Class ;
    rdfs:label "Address"@en ;
    dcterms:description "The physical address of the Location of Sale, SSe Initiative or Network. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" .

onto:Cost a rdfs:Class ;
    rdfs:label "Cost"@en ;
    dcterms:description "The cost for a particular product or service produced by an SSE initiative or network, including all costs. The price will be this cost added to delivery costs and sales margin as can be seen in the sale-option class."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" .

onto:CostComposition a rdfs:Class ;
    rdfs:label "Cost Composition"@en ;
    dcterms:description "A breakdown of all inputs (as taxes and raw materials) and labour costs that make up the product or service's final cost. An open cost is a pre-requisite for solidarity fair trade systems. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" .

onto:Input a rdfs:Class ;
    rdfs:label "Input"@en ;
    dcterms:description "A product, service, or activity that goes into making the final product or service. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" .

onto:Labour a rdfs:Class ;
    rdfs:label "Labour"@en ;
    dcterms:description "Work done for specific tasks related to the provision of goods or services offered by the SSE initiative. Generally it can be human, animal or machine labour, but in ESSglobal it's human labour only."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" .

onto:LocationOfSale a rdfs:Class ;
    rdfs:label "Location of Sale"@en ;
    dcterms:description "Place where the goods or services of an SSE initiative are provided. It can be self owned shops, but also partner places where the products or services are available among those from other initiatives. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" ;
    rdfs:subClassOf <http://purl.org/goodrelations/v1#Location> .

onto:Network a rdfs:Class ;
    rdfs:label "Network"@en ;
    dcterms:description "A network of individuals and/or organizations that participate in the SSE. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" ;
    rdfs:subClassOf org:OrganizationColaboration .

onto:OtherCosts a rdfs:Class ;
    rdfs:label "Other Costs"@en ;
    dcterms:description "Other costs which impact on the final cost of a product or service provided by an SSE initiative, other than input or labour, like taxes, deprecation of machinery, funds, etc. The delivery costs are not included in these costs: they are included in the sale-options class. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" .

onto:ProductOrService a rdfs:Class ;
    rdfs:label "Product or Service"@en ;
    dcterms:description "The good offered by an SSE initiative. It may be material goods or provision of services. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" ;
    rdfs:subClassOf <http://purl.org/goodrelations/v1#ProductOrService> .

onto:SSEInitiative a rdfs:Class ;
    rdfs:label "SSE Initiative"@en ;
    dcterms:description "An organization, practice, network, or other initiative that is recognized as belonging within the social solidarity economy.  "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" ;
    rdfs:subClassOf org:OrganizationUnit .

onto:SaleOption a rdfs:Class ;
    rdfs:label "Sale Option"@en ;
    dcterms:description "A Product sold at a certain price, under specific properties, in a certain Location. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:isDefinedBy "http://purl.org/essglobal/vocab/" .

onto:costPerUnit a owl:DatatypeProperty ;
    rdfs:label "Cost per Unit"@en ;
    dcterms:description "The cost per unit of input."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:Input ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:deliveryRangeDistance a owl:DatatypeProperty ;
    rdfs:label "Delivery Range (distance)"@en ;
    dcterms:description "Delivery range of product or service, in kilometers or miles."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:LocationOfSale ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:economicSector a owl:DatatypeProperty ;
    rdfs:label "Economic Sector"@en ;
    dcterms:description "A categorization of the type of activities carried on by SSE initiatives, depending of its nature, raw materials and methodology."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2014-08-05"^^xsd:date ;
    rdfs:domain onto:SSEInitiative ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Activities .

onto:hasAddress a owl:ObjectProperty ;
    rdfs:label "Has an address"@en ;
    dcterms:description "Object Property that links a Network, SSEInitiative or LocationOfSale to it's Address. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:SSEInitiative onto:Network onto:LocationOfSale ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Address .

onto:hasCost a owl:ObjectProperty ;
    rdfs:label "Has Cost"@en ;
    dcterms:description "An object property that links the Product or Service to its cost."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:ProductOrService ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Cost .

onto:hasImpactOnCost a owl:DatatypeProperty ;
    rdfs:label "Has impact on cost"@en ;
    dcterms:description "Does the input contribute to the monetary cost of the final product? Whereas many (perhaps most) inputs do contribute to the monetary price of the final product or service, some don't. For example, volunteer labour may contribute greatly to production without adding to the monetary cost of production.his property is of boolean type: Yes or No."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Input onto:OtherCosts ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

onto:hasInputCost a owl:ObjectProperty ;
    rdfs:label "Has input"@en ;
    dcterms:description "Object property that links a CostComposition to input that can be a product, service, or activity that goes into making the final product or service."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:CostComposition ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Input .

onto:hasLabourCost a owl:ObjectProperty ;
    rdfs:label "Has Labour"@en ;
    dcterms:description "Object Property to link the CostComposition to the Work done for specific tasks related to the provision of goods or services offered by the SSE initiative. Generally it can be human, animal or machine labour, but in ESSglobal it's human labour only."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:CostComposition ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Labour .

onto:hasOtherCosts a owl:ObjectProperty ;
    rdfs:label "Has Other Costs"@en ;
    dcterms:description "Object Property that links a CostComposition to other costs which impact on the final cost of a product or service provided by an SSE initiative, other than input or labour, like taxes, deprecation of machinery, funds, etc. The delivery costs are not included in these costs: they are included in the sale-options class."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:CostComposition ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OtherCosts .

onto:hasProductOrService a owl:ObjectProperty ;
    rdfs:label "Has Product or Service"@en ;
    dcterms:description "Object Property that links to the Network or SSE Initiative' products or services."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Network onto:SSEInitiative ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ProductOrService ;
    owl:equivalentProperty <http://purl.org/goodrelations/v1#offers> .

onto:hasSaleOption a owl:ObjectProperty ;
    rdfs:label "Has a Sale Option"@en ;
    dcterms:description "An object property that links the Product or service to the place where the product or service is provided."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:ProductOrService ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SaleOption .

onto:isAvailable a owl:DatatypeProperty ;
    rdfs:label "Is available"@en ;
    dcterms:description "Property that specifies if the Sale Option (the product/service at a certain price, under specific properties, in a specific Sale Location) is available.THis property us a boolena: Yes or No."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:SaleOption ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

onto:isAvailableAt a owl:ObjectProperty ;
    rdfs:label "Available At"@en ;
    dcterms:description "Object Property tha links a Product or Service that is sold at a certain location of sale under specific definitions."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:SaleOption ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:LocationOfSale ;
    owl:equivalentProperty <http://purl.org/goodrelations/v1#availableAtOrFrom> .

onto:isComposedBy a owl:ObjectProperty ;
    rdfs:label "Is Composed By"@en ;
    dcterms:description "An object property that links a Cost to the breakdown of all its inputs (as taxes and raw materials) and labour costs that make up the product or service's final cost. An open cost is a pre-requisite for solidarity fair trade systems."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:Cost ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:CostComposition .

onto:isMain a owl:DatatypeProperty ;
    rdfs:label "Is Main"@en ;
    dcterms:description "If the Location of Sale is the headquarter of the SSE initiative?This property is of boolean type: Yes or No."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:LocationOfSale ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

onto:isSSE a owl:DatatypeProperty ;
    rdfs:label "Is SSE Initiative"@en ;
    dcterms:description "If the Location of Sale is a place belonging to the SSE.This property is of boolean type: Yes or No."@en,
        "Se o Local de Venda é um lugar pertencente à ESS.Esta propriedade é do tipo Booleano. Toma os valores 'Sim' ou 'Não'."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:LocationOfSale ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

onto:legalForm a owl:DatatypeProperty ;
    rdfs:label "Legal Form"@en ;
    dcterms:description "The legal form of a SSE Initiative or Network.To be described."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2014-08-05"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:SSEInitiative onto:Network ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:LegalForm .

onto:mission a owl:DatatypeProperty ;
    rdfs:label "Mission"@en ;
    dcterms:description "The initiative's vision, values, and principles."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:SSEInitiative onto:Network ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:objective a owl:DatatypeProperty ;
    rdfs:label "Objective"@en ;
    dcterms:description "Actionable and measurable steps the SSE Initiative is taking to carry out its mission. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:SSEInitiative onto:Network ) ] ;
    rdfs:isDefinedBy onto: .

onto:qualifier a owl:DatatypeProperty ;
    rdfs:label "Qualifier"@en ;
    dcterms:description "Aspect that differentiates the product or service of an SSE initiative which is related to the form of production, the actors involved, the use of only organic materials, etc. Examples are organic, permacultural, made with recycled raw materials, indigenous, made by women, etc."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2014-08-05"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ProductOrService onto:Input ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Qualifiers .

onto:quantityPerProductOrServiceUnit a owl:DatatypeProperty ;
    rdfs:label "Quantity per Product or Service Unit"@en ;
    dcterms:description "The quantity of the input that goes into providing one unit of the final product or service. "@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:Input ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:salesMarginPercentage a owl:DatatypeProperty ;
    rdfs:label "Sales Margin (percentage)"@en ;
    dcterms:description "Margin (on sales) is the difference between selling price and cost. This difference is typically expressed either as a percentage of selling price or on a per-unit basis. This attribute is the percentage sales margin."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:SaleOption ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:salesMarginValue a owl:DatatypeProperty ;
    rdfs:label "Sales Margin (value)"@en ;
    dcterms:description "Margin (on sales) is the difference between selling price and cost. This difference is typically expressed either as a percentage of selling price or on a per-unit basis. The present attribute is an absolute value for sales margin on each unit of the product or service offered in the location."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:SaleOption ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:state a owl:DatatypeProperty ;
    rdfs:label "State"@en ;
    dcterms:description "The State of the Address."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:Address ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:totalMen a owl:DatatypeProperty ;
    rdfs:label "Total of Men"@en ;
    dcterms:description "The number of men that work in the SSE Initiative."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:SSEInitiative ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:totalOfMembers a owl:DatatypeProperty ;
    rdfs:label "Total of Members"@en ;
    dcterms:description "The total number of members that work in the SSE Initiative."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:SSEInitiative ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:totalWomen a owl:DatatypeProperty ;
    rdfs:label "Total of Women"@en ;
    dcterms:description "The number of women that work in the SSE Initiative."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:SSEInitiative ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:typeOfLabour a owl:DatatypeProperty ;
    rdfs:label "Type of Labour"@en ;
    dcterms:description "The human labour dedicated for providing goods or services can be of different types, depending on the established labour relations. For example, it might be associative (i.e., the worker is one of the collective owners of the SSE initiative), but it might also be subordinated work (an employee of the SSE initiative), volunteer work or externally hired work (like a freelancer or a partner initiative)."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:Labour ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:TypeOfLabour .

onto:unit a owl:DatatypeProperty ;
    rdfs:label "Unit"@en ;
    dcterms:description "The unit that a product or service is measured in, in the Universal Unit System (e.g., kilograms, hours)"@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    rdfs:domain onto:Input ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:Activities rdfs:label "Activities VES"@en ;
    dcterms:description "The activities vocabulary encoding scheme"@en ;
    dcterms:issued "2014-08-05"^^xsd:date ;
    dcterms:modified "2014-08-05"^^xsd:date ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://purl.org/essglobal/standard/activities> ;
            owl:onProperty skos:inScheme ] .

onto:LegalForm rdfs:label "Legal Form VES"@en ;
    dcterms:description "The legal form vocabulary encoding scheme"@en ;
    dcterms:issued "2014-08-05"^^xsd:date ;
    dcterms:modified "2014-08-05"^^xsd:date ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://purl.org/essglobal/standard/legal-form> ;
            owl:onProperty skos:inScheme ] .

onto:Qualifiers rdfs:label "Qualifiers VES"@en ;
    dcterms:description "The qualifiers vocabulary encoding scheme"@en ;
    dcterms:issued "2014-08-05"^^xsd:date ;
    dcterms:modified "2014-08-05"^^xsd:date ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://purl.org/essglobal/standard/qualifiers> ;
            owl:onProperty skos:inScheme ] .

onto:TypeOfLabour rdfs:label "Type of Labour VES"@en ;
    dcterms:description "The type of labour vocabulary encoding scheme"@en ;
    dcterms:issued "2014-08-05"^^xsd:date ;
    dcterms:modified "2014-08-05"^^xsd:date ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://purl.org/essglobal/standard/type-of-labour> ;
            owl:onProperty skos:inScheme ] .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    ns1:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:contributor <http://algoritmi.uminho.pt/>,
        <http://www.eita.org.br>,
        <http://www.haverford.edu/>,
        <http://www.iscap.ipp.pt> ;
    dcterms:creator <http://google.com/+MarianaCuradoMalta> ;
    dcterms:description "A vocabulary for the Social and Solidarity Economy (SSE). This vocabulary is designed to be used in combination with the metadata schemes/vocabularies/ontologies: dcterms, good relations, foaf, vcard and schema.org - this is defined in the Dublin Core Application Profile of the SSE. Developed by the ESSGlobal group of the Intercontinental Network for Promoting the Social and Solidarity Economy (RIPESS) Organisation."@en,
        "Un vocabulaire pour l'Économie Sociale et Solidaire (ESS). Ce vocabulaire est conçu pour être combiné avec les schémas de métadonnées/vocabulaires/ontologies: dcterms, good relations, foaf, vcard et schema.org - qui est défini dans le profil d'application Dublin Core de l'ESS. Vocabulaire développé par le groupe ESSGlobal du Réseau Intercontinental de Promotion de l'Economie Sociale et Solidaire (RIPESS)."@fr ;
    dcterms:issued "2014-07-16"^^xsd:date ;
    dcterms:modified "2015-05-04"^^xsd:date ;
    dcterms:publisher <http://www.ripess.org/> ;
    dcterms:title "ESSGlobal Vocabulary"@en,
        "Vocabulaire ESSGlobal"@fr ;
    vann:preferredNamespacePrefix "essglobal" ;
    vann:preferredNamespaceUri "http://purl.org/essglobal/vocab/" ;
    owl:versionInfo 1.1 .

