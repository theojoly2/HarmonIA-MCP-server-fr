@prefix ns1: <http://purl.org/NET/c4dm/keys.owl#> .
@prefix onto: <http://purl.org/NET/c4dm/keys.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology .

ns1:AFlatMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:AFlat ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/A-flat_major"^^xsd:anyURI .

ns1:AFlatMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:AFlat ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/A-flat_minor"^^xsd:anyURI .

ns1:AMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:A ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/A_major"^^xsd:anyURI .

ns1:AMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:A ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/A_minor"^^xsd:anyURI .

ns1:ASharpMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:ASharp ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/A-sharp_minor"^^xsd:anyURI .

ns1:BFlatMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:BFlat ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/B-flat_major"^^xsd:anyURI .

ns1:BFlatMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:BFlat ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/B-flat_minor"^^xsd:anyURI .

ns1:BMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:B ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/B_major"^^xsd:anyURI .

ns1:BMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:B ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/B_minor"^^xsd:anyURI .

ns1:CFlatMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:CFlat ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/C-flat_major"^^xsd:anyURI .

ns1:CMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:C ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/C_major"^^xsd:anyURI .

ns1:CMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:C ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/C_minor"^^xsd:anyURI .

ns1:CSharpMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:CSharp ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/C-sharp_major"^^xsd:anyURI .

ns1:CSharpMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:CSharp ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/C-sharp_minor"^^xsd:anyURI .

ns1:DFlatMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:DFlat ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/D-flat_major"^^xsd:anyURI .

ns1:DMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:D ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/D_major"^^xsd:anyURI .

ns1:DMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:D ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/D_minor"^^xsd:anyURI .

ns1:DSharpMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:DSharp ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/D-sharp_minor"^^xsd:anyURI .

ns1:EFlatMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:EFlat ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/E-flat_major"^^xsd:anyURI .

ns1:EFlatMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:EFlat ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/E-flat_minor"^^xsd:anyURI .

ns1:EMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:E ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/E_major"^^xsd:anyURI .

ns1:EMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:E ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/E_minor"^^xsd:anyURI .

ns1:FMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:F ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/F_major"^^xsd:anyURI .

ns1:FMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:F ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/F_minor"^^xsd:anyURI .

ns1:FSharpMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:FSharp ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/F-sharp_major"^^xsd:anyURI .

ns1:FSharpMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:FSharp ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/F-sharp_minor"^^xsd:anyURI .

ns1:GFlatMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:GFlat ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/G-flat_major"^^xsd:anyURI .

ns1:GMajor a ns1:Key ;
    ns1:mode "major"^^xsd:string ;
    ns1:tonic ns1:G ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/G_major"^^xsd:anyURI .

ns1:GMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:G ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/G_minor"^^xsd:anyURI .

ns1:GSharpMinor a ns1:Key ;
    ns1:mode "minor"^^xsd:string ;
    ns1:tonic ns1:GSharp ;
    ns1:wikipedia "http://en.wikipedia.org/wiki/G-sharp_minor"^^xsd:anyURI .

ns1:mode a owl:DatatypeProperty ;
    rdfs:domain ns1:Key ;
    rdfs:range [ a owl:DataRange ;
            owl:oneOf ( "major"^^xsd:string "minor"^^xsd:string ) ] .

ns1:tonic a owl:ObjectProperty ;
    rdfs:domain ns1:Key .

ns1:wikipedia a owl:DatatypeProperty ;
    rdfs:range xsd:anyURI .

ns1:ASharp a ns1:Note .

ns1:CFlat a ns1:Note .

ns1:DFlat a ns1:Note .

ns1:DSharp a ns1:Note .

ns1:GFlat a ns1:Note .

ns1:GSharp a ns1:Note .

ns1:A a ns1:Note .

ns1:AFlat a ns1:Note .

ns1:B a ns1:Note .

ns1:BFlat a ns1:Note .

ns1:C a ns1:Note .

ns1:CSharp a ns1:Note .

ns1:D a ns1:Note .

ns1:E a ns1:Note .

ns1:EFlat a ns1:Note .

ns1:F a ns1:Note .

ns1:FSharp a ns1:Note .

ns1:G a ns1:Note .

ns1:Note a owl:Class .

ns1:Key a owl:Class .

