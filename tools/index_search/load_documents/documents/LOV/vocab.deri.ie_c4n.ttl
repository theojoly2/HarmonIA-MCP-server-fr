@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/adms#> .
@prefix onto: <http://vocab.deri.ie/c4n> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://vocab.deri.ie/c4n#Call> a rdfs:Class,
        owl:Class ;
    rdfs:label "a call" ;
    rdfs:subClassOf rdfs:Resource .

<http://vocab.deri.ie/c4n#Condition> a rdfs:Class,
        owl:Class ;
    rdfs:label "a condition" ;
    rdfs:comment "a condition under which the call event has to be understood" ;
    rdfs:subClassOf rdfs:Resource .

<http://vocab.deri.ie/c4n#Deadline> a rdfs:Class,
        owl:Class ;
    rdfs:label "a deadline" ;
    rdfs:comment "a temporal condition that must be met to comply the call" ;
    rdfs:subClassOf <http://vocab.deri.ie/c4n#Condition> .

<http://vocab.deri.ie/c4n#Event> a rdfs:Class,
        owl:Class ;
    rdfs:label "an event" ;
    rdfs:comment "an event a call refers to" ;
    rdfs:subClassOf rdfs:Resource .

<http://vocab.deri.ie/c4n#Issuer> a rdfs:Class,
        owl:Class ;
    rdfs:label "the issuer of the call" ;
    rdfs:subClassOf rdfs:Resource,
        foaf:Agent .

<http://vocab.deri.ie/c4n#SpatialScope> a rdfs:Class,
        owl:Class ;
    rdfs:label "a spatial scope" ;
    rdfs:comment "a geographic condition that must be met to comply the call" ;
    rdfs:subClassOf <http://vocab.deri.ie/c4n#Condition> .

<http://vocab.deri.ie/c4n#LiDRC> a dcterms:Agent ;
    foaf:homepage <http://linkeddata.deri.ie/> ;
    foaf:member <http://vocab.deri.ie/c4n#Michael%20Hausenblas> ;
    foaf:name "LiDRC" .

<http://vocab.deri.ie/c4n#condition> a rdf:Property ;
    rdfs:label "must meet condition" ;
    rdfs:domain <http://vocab.deri.ie/c4n#Event> ;
    rdfs:range <http://vocab.deri.ie/c4n#Condition> .

<http://vocab.deri.ie/c4n#for> a rdf:Property ;
    rdfs:label "for" ;
    rdfs:comment "restricts the call to a certain event" ;
    rdfs:domain <http://vocab.deri.ie/c4n#Call> ;
    rdfs:range <http://vocab.deri.ie/c4n#Event> .

<http://vocab.deri.ie/c4n#issues> a rdf:Property,
        owl:FunctionalProperty ;
    rdfs:label "issues" ;
    rdfs:domain <http://vocab.deri.ie/c4n#Issuer> ;
    rdfs:range <http://vocab.deri.ie/c4n#Call> .

<http://vocab.deri.ie/c4n#rdf> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    ns1:accessURL "http://vocab.deri.ie/c4n.rdf" ;
    ns1:status <http://purl.org/adms/status/Completed> .

<http://vocab.deri.ie/c4n#ttl> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    ns1:accessURL "http://vocab.deri.ie/c4n.ttl" ;
    ns1:status <http://purl.org/adms/status/Completed> .

onto: a owl:Ontology,
        ns1:SemanticAsset ;
    dc:creator <http://vocab.deri.ie/c4n#Michael%20Hausenblas> ;
    dcterms:created "2010-02-04"^^xsd:date ;
    dcterms:description "A vocabulary to describe calls, such as call for tenders, call for proposals, call for papers, etc." ;
    dcterms:modified "2010-02-04"^^xsd:date ;
    dcterms:partOf <http://vocab.deri.ie> ;
    dcterms:publisher "http://vocab.deri.ie/c4n#LiDRC" ;
    dcterms:status <http://purl.org/adms/status/UnderDevelopment> ;
    dcterms:title "Call for Anything vocabulary" ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:preferredNamespacePrefix "c4n" ;
    vann:preferredNamespaceUri "http://vocab.deri.ie/c4n#" ;
    foaf:homepage onto:.html .

<http://vocab.deri.ie/c4n#Michael%20Hausenblas> a foaf:Person ;
    foaf:homepage <http://sw-app.org/about.html> ;
    foaf:mbox <mailto:michael.hausenblas@deri.org> ;
    foaf:name "Michael Hausenblas" .

