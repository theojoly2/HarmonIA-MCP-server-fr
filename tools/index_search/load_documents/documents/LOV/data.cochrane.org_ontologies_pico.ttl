@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://schema.org/> .
@prefix ns2: <http://proton.semanticweb.org/protonsys#> .
@prefix onto: <http://data.cochrane.org/ontologies/pico/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:SpecificMetric a owl:Class ;
    rdfs:label "SpecificMetric"@en ;
    rdfs:comment "Specific metric of an outcome" ;
    rdfs:isDefinedBy onto: .

onto:age a owl:ObjectProperty ;
    rdfs:label "age"@en ;
    rdfs:comment "The age of a population"@en ;
    rdfs:domain onto:Population ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Age .

onto:aggregationMethod a owl:ObjectProperty ;
    rdfs:label "aggregationMethod"@en ;
    rdfs:comment "The aggregation method of an outcome."@en ;
    rdfs:domain onto:Outcome ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:AggregationMethod .

onto:appliedIntervention a owl:ObjectProperty ;
    rdfs:label "appliedIntervention"@en ;
    ns2:transitiveOver <http://data.cochrane.org/ontologies/core/broaderConcept> ;
    rdfs:comment "Associates an appliedIntervention (material, procedure) with a PICO Intervention instance."@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:AppliedIntervention .

onto:comparatorGroup a owl:ObjectProperty ;
    rdfs:label "comparatorGroup"@en ;
    rdfs:comment "A comparator intervention group"@en ;
    rdfs:domain onto:PICO ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:InterventionGroup .

onto:condition a owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    ns2:transitiveOver <http://data.cochrane.org/ontologies/core/broaderConcept> ;
    rdfs:comment "A precondition of the population."@en ;
    rdfs:domain onto:Population ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Condition .

onto:dose a owl:ObjectProperty ;
    rdfs:label "dose"@en ;
    rdfs:comment "Dose used in an intervention"@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Dose .

onto:duration a owl:ObjectProperty ;
    rdfs:label "duration"@en ;
    rdfs:comment "duration of an intervention"@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Duration .

onto:endpoint a owl:ObjectProperty ;
    rdfs:label "endpoint"@en ;
    rdfs:comment "An endpoint of an outcome group, by duration"@en ;
    rdfs:domain onto:OutcomeGroup ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Duration .

onto:excludedIntervention a owl:ObjectProperty ;
    rdfs:label "excludedIntervention"@en ;
    rdfs:comment "An excluded intervention."@en ;
    rdfs:domain onto:InterventionGroup ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Intervention .

onto:excludedOutcome a owl:ObjectProperty ;
    rdfs:label "excludedOutcome"@en ;
    rdfs:comment "An excluded outcome."@en ;
    rdfs:domain onto:OutcomeGroup ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Outcome .

onto:excludedPopulation a owl:ObjectProperty ;
    rdfs:label "excludedPopulation"@en ;
    rdfs:comment "An excluded sub-population."@en ;
    rdfs:domain onto:PICO ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Population .

onto:intervention a owl:ObjectProperty ;
    rdfs:label "intervention"@en ;
    rdfs:comment "An intervention"@en ;
    rdfs:domain onto:InterventionGroup ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Intervention .

onto:interventionClassification a owl:ObjectProperty ;
    rdfs:label "interventionClassification"@en ;
    rdfs:comment "The type of intervention."@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:InterventionClassification .

onto:interventionGroup a owl:ObjectProperty ;
    rdfs:label "interventionGroup"@en ;
    rdfs:comment "An intervention group"@en ;
    rdfs:domain onto:PICO ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:InterventionGroup .

onto:interventionProvider a owl:ObjectProperty ;
    rdfs:label "interventionProvider"@en ;
    rdfs:comment "Intervention provider of an intervention"@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:InterventionProvider .

onto:interventionRationale a owl:ObjectProperty ;
    rdfs:label "interventionRationale"@en ;
    rdfs:comment "Rationale of an intervention"@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:InterventionRationale .

onto:isComparator a owl:DatatypeProperty ;
    rdfs:label "isComparator"@en ;
    rdfs:comment "The comparator flag (Deprecated)."@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

onto:modeOfDelivery a owl:ObjectProperty ;
    rdfs:label "modeOfDelivery"@en ;
    rdfs:comment "mode of delivery"@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ModeOfDelivery .

onto:numberOfParticipants a owl:DatatypeProperty ;
    rdfs:label "numberOfParticipants"@en ;
    rdfs:comment "The number of participants in a population an intervention is being applied to"@en ;
    rdfs:domain onto:InterventionGroup ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:int .

onto:outcome a owl:ObjectProperty ;
    rdfs:label "outcome"@en ;
    rdfs:comment "Relates a outcome group to an outcome"@en ;
    rdfs:domain onto:OutcomeGroup ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Outcome .

onto:outcomeClassification a owl:ObjectProperty ;
    rdfs:label "outcomeClassification"@en ;
    rdfs:comment "The type of outcome."@en ;
    rdfs:domain onto:Outcome ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OutcomeClassification .

onto:outcomeDomain a owl:ObjectProperty ;
    rdfs:label "outcomeDomain"@en ;
    ns2:transitiveOver <http://data.cochrane.org/ontologies/core/broaderConcept> ;
    rdfs:comment "The domain of an outome, e.g. a side effect outcome, typically a condition."@en ;
    rdfs:domain onto:Outcome ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OutcomeDomain .

onto:outcomeGroup a owl:ObjectProperty ;
    rdfs:label "outcomeGroup"@en ;
    rdfs:comment "Relates a pico to an outcome group"@en ;
    rdfs:domain onto:PICO ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OutcomeGroup .

onto:outcomeMeasurement a owl:ObjectProperty ;
    rdfs:label "outcomeMeasurement"@en ;
    rdfs:comment "The outcome measurement assessment scale."@en ;
    rdfs:domain onto:Outcome ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:AssessmentScale .

onto:outcomeText a owl:DatatypeProperty ;
    rdfs:label "outcomeText"@en ;
    rdfs:comment "Free text associated with an Outcome."@en ;
    rdfs:domain onto:Outcome ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString .

onto:outcomeTreatment a owl:ObjectProperty ;
    rdfs:label "outcomeTreatment"@en ;
    rdfs:comment "The outcome treatment."@en ;
    rdfs:domain onto:Outcome ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Treatment .

onto:parentIntervention a owl:ObjectProperty ;
    rdfs:label "parentIntervention"@en ;
    rdfs:comment "The parent intervention"@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Intervention ;
    owl:inverseOf onto:childIntervention .

onto:parentOutcome a owl:ObjectProperty ;
    rdfs:label "parentOutcome"@en ;
    rdfs:comment "References the parent outcome"@en ;
    rdfs:domain onto:Outcome ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Outcome ;
    owl:inverseOf onto:childOutcome .

onto:population a owl:ObjectProperty ;
    rdfs:label "population"@en ;
    rdfs:comment "A population"@en ;
    rdfs:domain onto:PICO ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Population .

onto:primaryEndpoint a owl:ObjectProperty ;
    rdfs:label "primaryEndpoint"@en ;
    rdfs:comment "The primary endpoint of an outcome group, by duration"@en ;
    rdfs:domain onto:OutcomeGroup ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Duration .

onto:schedule a owl:ObjectProperty ;
    rdfs:label "schedule"@en ;
    rdfs:comment "schedule of an intervention"@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Schedule .

onto:setting a owl:ObjectProperty ;
    rdfs:label "setting"@en ;
    rdfs:comment "setting of an intervention"@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Setting .

onto:sex a owl:ObjectProperty ;
    rdfs:label "sex"@en ;
    rdfs:comment "The sex of a population"@en ;
    rdfs:domain onto:Population ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Sex .

onto:socialContext a owl:ObjectProperty ;
    rdfs:label "socialContext"@en ;
    rdfs:comment "The social context of a population"@en ;
    rdfs:domain onto:Population ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SocialContext .

onto:treatment a owl:ObjectProperty ;
    rdfs:label "treatment"@en ;
    rdfs:comment "A treatment of a population"@en ;
    rdfs:domain onto:Population ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Treatment .

ns2:transitiveOver a owl:AnnotationProperty .

dc:abstract a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

ns1:image a owl:AnnotationProperty .

onto:Age a owl:Class ;
    rdfs:label "Age"@en ;
    rdfs:comment "The age of a population group"@en ;
    rdfs:isDefinedBy onto: .

onto:AggregationMethod a owl:Class ;
    rdfs:label "AggregationMethod"@en ;
    rdfs:comment "Outcome aggregation method" ;
    rdfs:isDefinedBy onto: .

onto:AppliedIntervention a owl:Class ;
    rdfs:label "AppliedIntervention"@en ;
    rdfs:comment "Abstract class, the intervention applied (procedure, materials etc)"@en ;
    rdfs:isDefinedBy onto: .

onto:AssessmentScale a owl:Class ;
    rdfs:label "AssessmentScale"@en ;
    rdfs:comment "Outcome assessment scale, e.g. SCTID:273249006"@en ;
    rdfs:isDefinedBy onto: .

onto:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "Conditions for example illness or disease."@en ;
    rdfs:isDefinedBy onto: .

onto:Dose a owl:Class ;
    rdfs:label "Dose"@en ;
    rdfs:comment "Dose in an intervention"@en ;
    rdfs:isDefinedBy onto: .

onto:InterventionClassification a owl:Class ;
    rdfs:label "Intervention Classification"@en ;
    rdfs:comment "The type of intervention"@en ;
    rdfs:isDefinedBy onto: .

onto:InterventionProvider a owl:Class ;
    rdfs:label "InterventionProvider"@en ;
    rdfs:comment "The provider of an intervention"@en ;
    rdfs:isDefinedBy onto: .

onto:InterventionRationale a owl:Class ;
    rdfs:label "InterventionRationale"@en ;
    rdfs:comment "The rationale of an intervention"@en ;
    rdfs:isDefinedBy onto: .

onto:ModeOfDelivery a owl:Class ;
    rdfs:label "ModeOfDelivery"@en ;
    rdfs:comment "Mode of delivery for an intervention"@en ;
    rdfs:isDefinedBy onto: .

onto:OutcomeClassification a owl:Class ;
    rdfs:label "OutcomeClassification"@en ;
    rdfs:comment "Classification scheme describing the type of outcome" ;
    rdfs:isDefinedBy onto: .

onto:OutcomeDomain a owl:Class ;
    rdfs:label "OutcomeDomain"@en ;
    rdfs:comment "The outcome domain, typically a Condition." ;
    rdfs:isDefinedBy onto: .

onto:Schedule a owl:Class ;
    rdfs:label "Schedule"@en ;
    rdfs:comment "Schedule of an intervention" ;
    rdfs:isDefinedBy onto: .

onto:Setting a owl:Class ;
    rdfs:label "Setting"@en ;
    rdfs:comment "Setting of an intervention"@en ;
    rdfs:isDefinedBy onto: .

onto:Sex a owl:Class ;
    rdfs:label "Sex"@en ;
    rdfs:comment "The sex of a population group"@en ;
    rdfs:isDefinedBy onto: .

onto:SocialContext a owl:Class ;
    rdfs:label "SocialContext"@en ;
    rdfs:comment "Social context of a population" ;
    rdfs:isDefinedBy onto: .

onto:childIntervention a owl:ObjectProperty ;
    rdfs:label "childIntervention"@en ;
    rdfs:comment "The child intervention"@en ;
    rdfs:domain onto:Intervention ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Intervention .

onto:childOutcome a owl:ObjectProperty ;
    rdfs:label "childOutcome"@en ;
    rdfs:comment "The child outcome"@en ;
    rdfs:domain onto:Outcome ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Outcome .

onto:Treatment a owl:Class ;
    rdfs:label "Treatment"@en ;
    rdfs:comment "Some treatment of a population" ;
    rdfs:isDefinedBy onto: .

onto:Duration a owl:Class ;
    rdfs:label "Duration"@en ;
    rdfs:comment "Duration of some action"@en ;
    rdfs:isDefinedBy onto: .

onto:InterventionGroup a owl:Class ;
    rdfs:label "InterventionGroup"@en ;
    rdfs:comment "An intervention group is a group of interventions for example an arm of a trial."@en ;
    rdfs:isDefinedBy onto: .

onto:OutcomeGroup a owl:Class ;
    rdfs:label "OutcomeGroup"@en ;
    rdfs:comment "An outcome group is a group of outcomes."@en ;
    rdfs:isDefinedBy onto: .

onto:PICO a owl:Class ;
    rdfs:label "PICO"@en ;
    rdfs:comment "A PICO class represents an object that defines a research or a clinical question."@en ;
    rdfs:isDefinedBy onto: .

onto:Population a owl:Class ;
    rdfs:label "Population"@en ;
    rdfs:comment "A population defines a group of people/patient in a PICO question."@en ;
    rdfs:isDefinedBy onto: .

onto:Outcome a owl:Class ;
    rdfs:label "Outcome"@en ;
    rdfs:comment "The desired outcome of an intervention." ;
    rdfs:isDefinedBy onto: .

onto:Intervention a owl:Class ;
    rdfs:label "Intervention"@en ;
    rdfs:comment "An intervention in a PICO question is an action under consideration for this population."@en ;
    rdfs:isDefinedBy onto: .

onto: a owl:Ontology ;
    dc:abstract "The PICO ontology provides a machine accessible version of the PICO framework. It essentially provides a model for describing evidence in a consistent way. The model allows the specifying of complex populations, detailed interventions and their comparisons as well as the outcomes considered.\\n                 The PICO ontology was originally designed to model the questions asked and answered in Cochrane's systematic reviews. As a leader in the field of evidence based healthcare Cochrane uses the PICO model when framing and publishing evidence based questions.\\n                 The PICO model is widely adopted for describing healthcare evidence, furthermore is equally applicable in other evidence-based domains. It essentially provides a model for describing evidence in a consistent way.\\n    dcterms:description \"The PICO ontology describes questions in evidence based healthcare with the intention of supporting the publishing of evidence as linked data."@en ;
    dc:creator "Chris Mavergames",
        "Julian Everett",
        "Lorne Becker",
        "Paul Wilton",
        "Silver Oliver" ;
    dc:publisher "Cochrane" ;
    dcterms:created "2014-02-06"^^xsd:date ;
    dcterms:modified "2019-09-06"^^xsd:date ;
    dcterms:rights "Copyright Cochrane 2020. Creative Commons License: CC BY-NC-ND : Attribution-NonCommercial-NoDerivs : https://creativecommons.org/licenses/by-nc-nd/4.0"@en ;
    dcterms:title "Cochrane PICO Ontology"@en ;
    vann:preferredNamespacePrefix "cp" ;
    vann:preferredNamespaceUri "http://data.cochrane.org/ontologies/pico/" ;
    ns1:image "https://data.cochrane.org/ontologies/pico/PICO-ontology.png" ;
    rdfs:comment "The PICO ontology describes questions in evidence based healthcare with the intention of supporting the publishing of evidence as linked data."@en ;
    owl:versionInfo "4.0.1" .

