@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://metadataregistry.org/uri/profile/RegAp/> .
@prefix onto: <http://iflastandards.info/ns/fr/frad/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

onto:P2019 a rdf:Property ;
    rdfs:label "has equivalence (manifestation) relationship"@en ;
    ns1:name "hasEquivalenceManifestationRelationship"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1003> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1003> ;
    skos:definition "Relates a manifestation to another manifestation that embodies the same intellectual or artistic content (work or work-expression)."@en .

onto:P2021 a rdf:Property ;
    rdfs:label "is creator (family) of"@en ;
    ns1:name "isCreatorFamilyOf"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1002 ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    skos:definition "Relates a family to a work of which it is responsible for the creation of the intellectual or artistic content."@en .

onto:P2022 a rdf:Property ;
    rdfs:label "is owned by (family)"@en ;
    ns1:name "isOwnedByFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1004> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:C1002 ;
    skos:definition "Relates an item to a family that is the owner or custodian of the item."@en .

onto:P2023 a rdf:Property ;
    rdfs:label "is owner (family) of"@en ;
    ns1:name "isOwnerFamilyOf"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1002 ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1004> ;
    skos:definition "Relates a family to an item of which it is the owner or custodian."@en .

onto:P2024 a rdf:Property ;
    rdfs:label "is produced by (family)"@en ;
    ns1:name "isProducedByFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1003> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:C1002 ;
    skos:definition "Relates a manifestation to a family that is responsible for publishing, distributing, fabricating or manufacturing the manifestation."@en .

onto:P2025 a rdf:Property ;
    rdfs:label "is producer (family) of"@en ;
    ns1:name "isProducerFamilyOf"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1002 ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1003> ;
    skos:definition "Relates a family to a manifestation of which it is responsible for publishing, distributing, fabricating or manufacturing."@en .

onto:P2026 a rdf:Property ;
    rdfs:label "is realized by (family)"@en ;
    ns1:name "isRealizedByFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:C1002 ;
    skos:definition "Relates an expression to a family that is responsible for the specifics of the intellectual or artistic realization or execution of the expression."@en .

onto:P2027 a rdf:Property ;
    rdfs:label "is realizer (family) of"@en ;
    ns1:name "isRealizerFamilyOf"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1002 ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1002> ;
    skos:definition "Relates a family to an expression of which it is responsible for the specifics of the intellectual or artistic realization or execution."@en .

onto:P2029 a rdf:Property ;
    rdfs:label "has sequential relationship"@en ;
    ns1:name "hasSequentialRelationship"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    skos:definition "Relates a work to another work of different content that is a successor or a predecessor of that work,"@en ;
    skos:scopeNote "E.g. a sequel, a serial or series that has changed title. Excludes derivative works that modify the content of an earlier work."@en .

onto:P2030 a rdf:Property ;
    rdfs:label "has accompanying relationship"@en ;
    ns1:name "hasAccompanyingRelationship"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    skos:definition "Relates a work to another work that is a supplement to that work (i.e., a work that is intended to be used in conjunction with or to augment the related work, such as a teacher’s guide or incidental music to a play; or intended to complement or be a companion to another work, such as a set of maps to a video travelogue, a computer disk to accompany a textbook, a set of coloured plates to accompany a text, the equal parts of a kit)."@en .

onto:P2031 a rdf:Property ;
    rdfs:label "has shared characteristic (work) relationship"@en ;
    ns1:name "hasSharedCharacteristicWorkRelationship"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    skos:definition "Relates two works that have some characteristic in common."@en ;
    skos:scopeNote "Excludes specific characteristics represented by other properties."@en .

onto:P2032 a rdf:Property ;
    rdfs:label "has shared characteristic (expression) relationship"@en ;
    ns1:name "hasSharedCharacteristicExpressionRelationship"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1002> ;
    skos:definition "Relates two expressions that have some characteristic in common. "@en ;
    skos:scopeNote "Excludes specific characteristics represented by other properties."@en .

onto:P2033 a rdf:Property ;
    rdfs:label "has shared characteristic (manifestation) relationship"@en ;
    ns1:name "hasSharedCharacteristicManifestationRelationship"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1003> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1003> ;
    skos:definition "Relates two manifestations that have some characteristic in common."@en ;
    skos:scopeNote "Excludes specific characteristics represented by other properties. "@en .

onto:P2034 a rdf:Property ;
    rdfs:label "has shared characteristic (item) relationship"@en ;
    ns1:name "hasSharedCharacteristicItemRelationship "@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1004> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1004> ;
    skos:definition "Relates two items that have some characteristic in common."@en ;
    skos:scopeNote "Excludes specific characteristics represented by other properties."@en .

onto:P2035 a rdf:Property ;
    rdfs:label "has descriptive work"@en ;
    ns1:name "hasDescriptiveWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    skos:definition "Relates a target work or expression or manifestation or item and a new work that refers to that target as its subject."@en ;
    skos:scopeNote "Includes criticism, commentary, review, casebook, etc., and the object of that analysis (that is, the target work, expression, or manifestation)."@en .

onto:P2036 a rdf:Property ;
    rdfs:label "is descriptive work of"@en ;
    ns1:name "isDescriptiveWorkOf"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a new work to a target work or expression or manifestation or item that it refers to as its subject."@en ;
    skos:scopeNote "Includes criticism, commentary, review, casebook, etc., and the object of that analysis (that is, the target work, expression, or manifestation). "@en .

onto:P2037 a rdf:Property ;
    rdfs:label "has equivalence (item) relationship"@en ;
    ns1:name "hasEquivalenceItemRelationship"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1004> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1004> ;
    skos:definition "Relates an item to another item that exemplifies the same intellectual or artistic content (work or work-expression)."@en .

onto:P3010 a rdf:Property ;
    rdfs:label "has language of base access point"@en ;
    ns1:name "hasLanguageOfBaseAccessPoint"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1001 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a controlled access point to the language in which the base access point is recorded."@en .

onto:P3011 a rdf:Property ;
    rdfs:label "has language of cataloguing"@en ;
    ns1:name "hasLanguageOfCataloguing"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1001 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a controlled access point to the language in which additions to the base access point are recorded."@en .

onto:P3012 a rdf:Property ;
    rdfs:label "has script of base access point"@en ;
    ns1:name "hasScriptOfBaseAccessPoint"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1001 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a controlled access point to the form of graphic characters in which the data in the base access point are recorded."@en .

onto:P3013 a rdf:Property ;
    rdfs:label "has script of cataloguing"@en ;
    ns1:name "hasScriptOfCataloguing"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1001 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a controlled access point to the form of graphic characters in which any additions to the base access point are recorded."@en .

onto:P3014 a rdf:Property ;
    rdfs:label "has transliteration scheme of base access point"@en ;
    ns1:name "hasTransliterationSchemeOfBaseAccessPoint"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1001 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a controlled access point to an indication of the scheme used in transliterating the base access point."@en .

onto:P3015 a rdf:Property ;
    rdfs:label "has transliteration scheme of cataloguing"@en ;
    ns1:name "hasTransliterationSchemeOfCataloguing"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1001 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a controlled access point to an indication of the scheme used in transliterating any additions to the base access point."@en .

onto:P3016 a rdf:Property ;
    rdfs:label "has source of controlled access point"@en ;
    ns1:name "hasSourceOfControlledAccessPoint"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1001 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a controlled access point to the publication or reference source used in establishing the form of name or title on which the controlled access point is based."@en ;
    skos:scopeNote "Includes the title, publisher, date, etc., of the resource for which the controlled access point was originally created. Includes the title, edition, etc., of the reference source(s) used to establish the conventional name or title."@en .

onto:P3018 a rdf:Property ;
    rdfs:label "has addition"@en ;
    ns1:name "hasAddition"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:comment "Sometimes referred to as a \"qualifier\"."@en ;
    rdfs:domain onto:C1001 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a controlled access point to a name, title, date, place, number, or other designation added to the base access point."@en ;
    skos:scopeNote "Includes the fuller form of name added to the base access point. Includes the title of nobility, title of royalty, or ecclesiastical title added to the base access point. Includes dates added to the base access point. Includes the place name associated with a corporate body added to the base access point. Includes a number associated with a corporate body or a musical work added to the base access point. Includes a title of an adaptation or version of a work added to the base access point. Includes the name and/or number of a section or part of a work added to the base access point. Includes a term designating the form of a work added to the base access point. Includes a term designating language of expression added to the base access point. Includes a term designating the key in which a musical work was originally composed added to the base access point. Includes a term designating the medium of performance for which a musical work was originally conceived added to the base access point. Includes other designations associated with persons and corporate bodies added to the base access point."@en .

onto:P3022 a rdf:Property ;
    rdfs:label "has type of name"@en ;
    ns1:name "hasTypeOfName"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1006 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a name to the category of a name."@en ;
    skos:scopeNote "Includes personal names, corporate names, names of families, trade names, and titles of works and manifestations. Includes names of concepts, objects, events, and places."@en .

onto:P3023 a rdf:Property ;
    rdfs:label "has name string"@en ;
    ns1:name "hasNameString"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1006 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a name to a sequence of numeric and/or alphabetic characters or symbols that represents the name of an entity."@en .

onto:P3024 a rdf:Property ;
    rdfs:label "has scope of usage"@en ;
    ns1:name "hasScopeOfUsage"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1006 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a name to the form of work associated with a particular name for a persona."@en ;
    skos:scopeNote "Includes forms, genres, etc., (e.g., literary works, critical works, works on mathematics, detective novels) associated with a name used by an author."@en .

onto:P3025 a rdf:Property ;
    rdfs:label "has dates of usage"@en ;
    ns1:name "hasDatesOfUsage"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1006 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a name to dates associated with the use of a particular name established by a person, corporate body, or family."@en .

onto:P3026 a rdf:Property ;
    rdfs:label "has language of name"@en ;
    ns1:name "hasLanguageOfName"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1006 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a name to the language in which the name is expressed."@en .

onto:P3027 a rdf:Property ;
    rdfs:label "has script of name"@en ;
    ns1:name "hasScriptOfName"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1006 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a name to the script in which the name is rendered"@en .

onto:P3028 a rdf:Property ;
    rdfs:label "has transliteration scheme of name"@en ;
    ns1:name "hasTransliterationSchemeOfName"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1006 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a name to the scheme used to produce the transliterated form of the name."@en .

onto:P3045 a rdf:Property ;
    rdfs:label "has place of origin of the work"@en ;
    ns1:name "hasPlaceOfOriginOfTheWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a work to the country or other territorial jurisdiction or cultural area from which the work originated."@en ;
    skos:scopeNote "Includes area of origin, etc."@en .

onto:P3046 a rdf:Property ;
    rdfs:label "has history (work)"@en ;
    ns1:name "hasHistoryWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a work to information pertaining to the history of the work."@en ;
    skos:scopeNote "Includes historical information pertaining to a work, including title changes for continuing resources."@en .

onto:P3047 a rdf:Property ;
    rdfs:label "has location of item"@en ;
    ns1:name "hasLocationOfItem"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:comment "Scope note not present in original documentation; added to clarify semantic difference with \"is part (item)\" property (http://iflastandards.info/ns/fr/frbr/frbrer/P2092)."@en ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1004> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates an item to the collection and/or institution in which the item is held, stored, or made available for access."@en ;
    skos:scopeNote "E.g. Moir rare book collection, http://www.juilliardmanuscriptcollection.org/, Short loan collection (School of African and Oriental Studies, University of London), Library of Congress. Does not include collections where the item is originally published or manufactured as a component part."@en .

onto:P3048 a rdf:Property ;
    rdfs:label "has custodial history of item"@en ;
    ns1:name "hasCustodialHistoryOfItem"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1004> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates an item to the record of previous ownership of an item."@en .

onto:P3049 a rdf:Property ;
    rdfs:label "has immediate source of acquisition of item"@en ;
    ns1:name "hasImmediateSourceOfAcquisitionOfItem"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1004> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates an item to the source from which an item was directly acquired and the circumstances under which it was acquired."@en .

onto:P3050 a rdf:Property ;
    rdfs:label "has subject of the work"@en ;
    ns1:name "hasSubjectOfTheWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a work to the subject aspects of the work and its content."@en ;
    skos:scopeNote "Includes information about the subject of the work. Includes classification numbers."@en .

onto:P3051 a rdf:Property ;
    rdfs:label "has numeric designation"@en ;
    ns1:name "hasNumericDesignation"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1001> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a work to a number assigned to it."@en ;
    skos:scopeNote "Includes serial numbers, opus numbers assigned by the composer of a musical work, etc."@en .

onto:P3052 a rdf:Property ;
    rdfs:label "has language of family"@en ;
    ns1:name "hasLanguageOfFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1002 ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Relates a family to a language associated with the family."@en .

onto:P4004 a rdf:Property ;
    rdfs:label "has member (family)"@en ;
    ns1:name "hasMemberFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1002 ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://iflastandards.info/ns/fr/frbr/frbrer/C1005> ;
    skos:definition "Relates a family to a person who is a member of the family."@en .

onto:P4005 a rdf:Property ;
    rdfs:label "is member of (family)"@en ;
    ns1:name "isMemberOfFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain <http://iflastandards.info/ns/fr/frbr/frbrer/C1005> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:C1002 ;
    skos:definition "Relates a person to a family of which the person is a member."@en .

onto:P4019 a rdf:Property ;
    rdfs:label "has related identifier"@en ;
    ns1:name "hasRelatedIdentifier"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1001 ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:C1009 ;
    skos:definition "Relates a controlled access point based on an authorized or variant form of name of a bibliographic entity to an identifier for the same bibliographic entity."@en .

onto:P4024 a rdf:Property ;
    rdfs:label "has alternative linguistic form (family) "@en ;
    ns1:name "hasAlternativeLinguisticFormFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1013 ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:C1013 ;
    skos:definition "Relates a name of a family and an alternative linguistic form of name by which that family is known."@en .

onto:P4028 a rdf:Property ;
    rdfs:label "has alternative linguistic form (work) "@en ;
    ns1:name "hasAlternativeLinguisticFormWork "@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1014 ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:C1014 ;
    skos:definition "Relates a name of a work and an alternative linguistic form of name by which that work is known."@en .

onto:P4031 a rdf:Property ;
    rdfs:label "has other variant name (person)"@en ;
    ns1:name "hasOtherVariantNamePerson"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    rdfs:domain onto:C1012 ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:C1012 ;
    skos:definition "Relates a name of a person and several other variations on a name (other than earlier name, later name, and alternative linguistic form)."@en ;
    skos:scopeNote "Includes orthographic variant names (spelling variations, transliterations, punctuation variations, capitalization variations), word order variant names (inversions, permutations), alternative name/synonym variant names (bynames, nicknames, courtesy names). "@en .

onto:P4033 a rdf:Property ;
