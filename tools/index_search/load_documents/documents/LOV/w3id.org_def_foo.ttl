        owl:NamedIndividual ;
    owl:sameAs <https://www.bbc.co.uk/ontologies/wildlife-ontology#Class> .

onto:Family a owl:Class,
        owl:NamedIndividual ;
    owl:sameAs <https://www.bbc.co.uk/ontologies/wildlife-ontology#Family> .

