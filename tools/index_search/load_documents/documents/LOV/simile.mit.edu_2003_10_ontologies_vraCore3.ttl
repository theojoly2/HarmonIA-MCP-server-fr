@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix onto: <http://simile.mit.edu/2003/10/ontologies/vraCore3#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

onto:Corporation a rdfs:Class ;
    rdfs:label "Corporation"@en ;
    rdfs:subClassOf onto:Entity .

onto:Entity a rdfs:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "Entities are creators e.g. people or organisations" ;
    rdfs:subClassOf dc:creator .

onto:Image a rdfs:Class ;
    rdfs:label "Image"@en ;
    rdfs:comment "An image record is used for the visual surrogates of objects" ;
    rdfs:subClassOf onto:Record .

onto:LargerEntity a rdfs:Class ;
    rdfs:label "Larger Entity"@en ;
    rdfs:comment "A work" .

onto:Record a rdfs:Class ;
    rdfs:label "Record"@en ;
    rdfs:comment "A record is the superclass for Works and Images" .

onto:Series a rdfs:Class ;
    rdfs:label "Series"@en ;
    rdfs:comment "A Series" ;
    rdfs:subClassOf onto:Work .

onto:Work a rdfs:Class ;
    rdfs:label "Work"@en ;
    rdfs:comment "A work record is used for physical or created objects" ;
    rdfs:subClassOf onto:Record .

onto: a owl:Ontology ;
    dc:creator "Andy Seaborne" ;
    dc:date "2003-10-14" ;
    dc:format "RDFS" ;
    dc:publisher "The SIMILE Project" ;
    dc:title "RDFS Ontology for VRA" .

onto:alteration a rdf:Property ;
    rdfs:label "alteration"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:date .

onto:attribution a rdf:Property ;
    rdfs:label "attribution"@en ;
    rdfs:domain onto:Entity ;
    rdfs:range rdfs:Literal .

onto:beginning a rdf:Property ;
    rdfs:label "beginning"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:date .

onto:completion a rdf:Property ;
    rdfs:label "completion"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:date .

onto:creation a rdf:Property ;
    rdfs:label "creation"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:date .

onto:creator a rdf:Property ;
    rdfs:label "creator"@en ;
    rdfs:domain onto:Record .

onto:culture a rdf:Property ;
    rdfs:label "culture"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:description a rdf:Property ;
    rdfs:label "description"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:design a rdf:Property ;
    rdfs:label "design"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:date .

onto:dynasty a rdf:Property ;
    rdfs:label "dynasty"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:group a rdf:Property ;
    rdfs:label "group"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:id a rdf:Property ;
    rdfs:label "ID"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:idCurrentAccession a rdf:Property ;
    rdfs:label "current accession ID"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:idCurrentRepository a rdf:Property ;
    rdfs:label "current repository ID"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:idFormerAccession a rdf:Property ;
    rdfs:label "former accession ID"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:idFormerRepository a rdf:Property ;
    rdfs:label "former repository ID"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:locationCreationSite a rdf:Property ;
    rdfs:label "creation site"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:location .

onto:locationCurrentRepository a rdf:Property ;
    rdfs:label "current repository"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:location .

onto:locationCurrentSite a rdf:Property ;
    rdfs:label "current location"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:location .

onto:locationDiscoverySite a rdf:Property ;
    rdfs:label "discovery site"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:location .

onto:locationFormerRepository a rdf:Property ;
    rdfs:label "former repository"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:location .

onto:locationFormerSite a rdf:Property ;
    rdfs:label "former location"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:location .

onto:measurementsDimensions a rdf:Property ;
    rdfs:label "dimensions"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:measurements .

onto:measurementsFormat a rdf:Property ;
    rdfs:label "format"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:measurementsResolution a rdf:Property ;
    rdfs:label "resolution"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:medium a rdf:Property ;
    rdfs:label "medium"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:material .

onto:movement a rdf:Property ;
    rdfs:label "movement"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:period a rdf:Property ;
    rdfs:label "period"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:stylePeriod .

onto:relation a rdf:Property ;
    rdfs:label "relation"@en ;
    rdfs:domain onto:Record ;
    rdfs:range onto:Relation ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:restoration a rdf:Property ;
    rdfs:label "restoration"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:date .

onto:rights a rdf:Property ;
    rdfs:label "rights"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:role a rdf:Property ;
    rdfs:label "role"@en ;
    rdfs:domain onto:Entity ;
    rdfs:range rdfs:Literal .

onto:school a rdf:Property ;
    rdfs:label "school"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:source a rdf:Property ;
    rdfs:label "source"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:style a rdf:Property ;
    rdfs:label "style"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:stylePeriod .

onto:subject a rdf:Property ;
    rdfs:label "subject"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Resource .

onto:support a rdf:Property ;
    rdfs:label "support"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:material .

onto:technique a rdf:Property ;
    rdfs:label "technique"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:titleTranslation a rdf:Property ;
    rdfs:label "title translation"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:titleVariant .

onto:type a rdf:Property ;
    rdfs:label "VRA record type"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf rdf:type .

onto:typeAAT a rdf:Property ;
    rdfs:label "VRA type"@en ;
    rdfs:domain onto:Record .

onto:measurements a rdf:Property ;
    rdfs:label "measurements"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:title a rdf:Property ;
    rdfs:label "title"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:titleVariant a rdf:Property ;
    rdfs:label "title variant"@en ;
    rdfs:domain onto:Record ;
    rdfs:subPropertyOf onto:title .

onto:material a rdf:Property ;
    rdfs:label "material"@en ;
    rdfs:domain onto:Record .

onto:stylePeriod a rdf:Property ;
    rdfs:label "style/period"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:date a rdf:Property ;
    rdfs:label "date"@en ;
    rdfs:domain onto:Record ;
    rdfs:range rdfs:Literal .

onto:location a rdf:Property ;
    rdfs:label "location"@en ;
    rdfs:domain onto:Record .

