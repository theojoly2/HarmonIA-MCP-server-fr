@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix onto: <http://purl.org/ontology/af/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

onto:Amplitude a owl:Class ;
    rdfs:label "Amplitude" ;
    rdfs:comment "\\n\\t\\tResult of an amplitude following process\\n\\t" ;
    rdfs:subClassOf onto:Signal ;
    ns1:term_status "testing" .

onto:Beat a owl:Class ;
    rdfs:label "Beat event" ;
    rdfs:comment "A beat event (instantaneous)" ;
    rdfs:subClassOf onto:Point ;
    ns1:term_status "testing" .

onto:ChordSegment a owl:Class ;
    rdfs:comment "\\n\\t\\tA classifier for chords. Equivalent concept as the one\\n\\t\\tin the Chord ontology.\\n\\t" ;
    rdfs:subClassOf onto:MusicSegment ;
    owl:equivalentClass <http://purl.org/ontology/chord/ChordEvent> ;
    ns1:term_status "testing" .

onto:Chromagram a owl:Class ;
    rdfs:label "Chromagram" ;
    rdfs:comment "\\n\\t\\tA chromagram feature.\\n\\t" ;
    rdfs:subClassOf onto:Signal ;
    ns1:term_status "testing" .

onto:Laugh a owl:Class ;
    rdfs:label "Laugh" ;
    rdfs:comment "\\n\\t\\tA classifier for laugh content\\n\\t\\t" ;
    rdfs:subClassOf onto:SpeechSegment ;
    ns1:term_status "testing" .

onto:LinearFrequencyCentroid a owl:Class ;
    rdfs:label "Linear-frequency spectral centroid" ;
    rdfs:comment "\\n\\t\\tLog-frequency spectral centroid\\n\\t" ;
    rdfs:subClassOf onto:SpectralCentroid ;
    ns1:term_status "testing" .

onto:LogFrequencyCentroid a owl:Class ;
    rdfs:label "Log-frequency spectral centroid" ;
    rdfs:comment "\\n\\t\\tLog-frequency spectral centroid\\n\\t" ;
    rdfs:subClassOf onto:SpectralCentroid ;
    ns1:term_Status "testing" .

onto:Loudness a owl:Class ;
    rdfs:label "Loudness event" ;
    rdfs:comment "Event holding a loudness value" ;
    rdfs:subClassOf onto:MusicSegment ;
    ns1:term_status "testing" .

onto:Major a owl:Class ;
    rdfs:label "Major segment" ;
    rdfs:comment "\\n\\t\\tA classifier for a major mode region.\\n\\t\\tIn case of a \"clean cut\", instances of such events have one\\n                factor. In other cases, this event can have several factors, each associated\\n                with a particular confidence using event decomposition.\\n\\t" ;
    rdfs:subClassOf onto:MusicSegment ;
    ns1:term_status "testing" .

onto:Minor a owl:Class ;
    rdfs:label "Minor segment" ;
    rdfs:comment "\\n\\t\\tA classifier for a minor mode region.\\n\\t\\tIn case of a \"clean cut\", instances of such events have one\\n                factor. In other cases, this event can have several factors, each associated\\n                with a particular confidence using event decomposition.\\n\\t" ;
    rdfs:subClassOf onto:MusicSegment ;
    ns1:term_status "testing" .

onto:ModeChange a owl:Class ;
    rdfs:label "Mode change event" ;
    rdfs:comment "A mode change event. The factors of such events include the mode that holds after the event." ;
    rdfs:subClassOf onto:Point ;
    ns1:term_status "testing" .

onto:MusicStructuralSegment a owl:Class ;
    rdfs:label "Music structural segment" ;
    rdfs:comment "\\n\\t\\tClassifier capturing the notion of chorus, verse, intro, bridge, phrase, etc.\\n\\t\\t" ;
    rdfs:subClassOf onto:MusicSegment ;
    ns1:term_status "testing" .

onto:NonTonalOnset a owl:Class ;
    rdfs:label "Percussive onset" ;
    rdfs:comment "A percussive onset" ;
    rdfs:subClassOf onto:Onset ;
    ns1:term_status "testing" .

onto:OnsetDetectionFunction a owl:Class ;
    rdfs:label "Onset detection function" ;
    rdfs:comment "\\n\\t\\tAn onset detection function\\n\\t" ;
    rdfs:subClassOf onto:DetectionFunction ;
    ns1:term_status "testing" .

onto:Ornament a owl:Class ;
    rdfs:label "Ornament event" ;
    rdfs:comment "Classifying a temporal region holding a musical ornament" ;
    rdfs:subClassOf onto:MusicSegment ;
    ns1:term_status "testing" .

onto:PersonSpeaking a owl:Class ;
    rdfs:label "Person speaking" ;
    rdfs:comment "\\n\\t\\t\\tA classifier associating a FOAF description to a particular segment \\n\\t\\t\\t(to classify genre, recognized speaker, etc.)\\n\\t\\t\\t" ;
    rdfs:subClassOf onto:SpeechSegment ;
    ns1:term_status "testing" .

onto:TempoDetectionFunction a owl:Class ;
    rdfs:label "Tempo detection function" ;
    rdfs:comment "\\n\\t\\tA tempo detection function\\n\\t" ;
    rdfs:subClassOf onto:DetectionFunction ;
    ns1:term_status "testing" .

onto:TimeSignature a owl:Class ;
    rdfs:label "Time signature" ;
    rdfs:comment "Classifying a temporal region with a particular time signature (what? there is something else than 4/4?? :-)" ;
    rdfs:subClassOf onto:MusicSegment ;
    ns1:term_status "testing" .

onto:TonalChange a owl:Class ;
    rdfs:label "Tonal change event" ;
    rdfs:comment "A tonal change event." ;
    rdfs:subClassOf onto:Point ;
    ns1:term_status "testing" .

onto:TonalChangeDetectionFunction a owl:Class ;
    rdfs:label "Tonal change detection function" ;
    rdfs:comment "\\n\\t\\tA tonal change detection function\\n\\t" ;
    rdfs:subClassOf onto:DetectionFunction ;
    ns1:term_status "testing" .

onto:TonalContentSpace a owl:Class ;
    rdfs:label "Tonal content space" ;
    rdfs:comment "\\n\\t\\tA 6-D tonal content space\\n\\t" ;
    rdfs:subClassOf onto:Signal ;
    ns1:term_status "testing" .

onto:TonalOnset a owl:Class ;
    rdfs:label "Pitched onset" ;
    rdfs:comment "A pitched onset" ;
    rdfs:subClassOf onto:Onset ;
    ns1:term_status "testing" .

onto:TonicChange a owl:Class ;
    rdfs:label "Tonic change event" ;
    rdfs:comment "A tonic change event. The factors of such events include the tonic that holds after the event." ;
    rdfs:subClassOf onto:Point ;
    ns1:term_status "testing" .

onto:ZeroCrossing a owl:Class ;
    rdfs:label "Zero crossing" ;
    rdfs:comment "Classifier for a zero-crossing point" ;
    rdfs:subClassOf onto:Point ;
    ns1:term_status "testing" .

onto:ZeroCrossingCount a owl:Class ;
    rdfs:label "Zero-crossing counts" ;
    rdfs:comment "\\n\\t\\tZero-crossing counts\\n\\t" ;
    rdfs:subClassOf onto:Signal ;
    ns1:term_status "testing" .

onto:austrian_german a onto:GermanIdiom ;
    dc:title "Austrian German" ;
    ns1:term_status "testing" .

onto:confidence a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:comment "\\n\\t\\tA really generic property, allowing to associate a confidence to a document or to a particular\\n\\t\\tresource (such as an automatically detected segment)\\n\\t\\t" ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "testing" .

onto:dimensions a owl:DatatypeProperty ;
    rdfs:label "dimensions" ;
    rdfs:comment "\\n\\t\\tAssociates a signal with its dimensions, eg. \"12 3546\". Equivalent to the mpeg7:dim attribute of the mpeg7:Raw\\n\\t\\telement.\\n\\t" ;
    rdfs:domain onto:Signal ;
    ns1:term_status "testing" .

onto:emotional_intensity a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "emotional intensity" ;
    rdfs:comment "\\n\\t\\tAssociates an \"emotional intensity\" value to a \\n\\t\\tsegment detected as being \"emotional\"\\n\\t\\t" ;
    rdfs:domain onto:EmotionSegment ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "testing" .

onto:english_irish_accent a onto:EnglishIdiom ;
    dc:title "English with an Irish accent" ;
    ns1:term_status "testing" .

onto:english_scottish_accent a onto:EnglishIdiom ;
    dc:title "English with a Scottish accent" ;
    ns1:term_status "testing" .

onto:idiom a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:comment "\\n\\t\\tAssociates a segment which classify an idiom (English with Irish accent, etc.) to an actual idiom\\n\\t\\t" ;
    rdfs:domain onto:IdiomSegment ;
    rdfs:range onto:Idiom ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#hasLiteralFactor> ;
    ns1:term_status "testing" .

onto:key a owl:ObjectProperty ;
    rdfs:label "key" ;
    rdfs:comment "Associates a key event to the corresponding key" ;
    rdfs:domain onto:KeySegment ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#factor> ;
    ns1:term_status "testing" .

onto:new_key a owl:ObjectProperty ;
    rdfs:label "new key" ;
    rdfs:comment "Associates a key change event to the new key, holding after the change" ;
    rdfs:domain onto:KeyChange ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#factor> ;
    ns1:term_status "testing" .

onto:new_mode a owl:ObjectProperty ;
    rdfs:label "new mode" ;
    rdfs:comment "Mode that holds after the mode change event" ;
    rdfs:domain onto:ModeChangeEvent ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#factor> ;
    ns1:term_status "testing" .

onto:new_tonic a owl:ObjectProperty ;
    rdfs:label "new tonic" ;
    rdfs:comment "Tonic that holds after the tonic change event" ;
    rdfs:domain onto:TonicChangeEvent ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#factor> ;
    ns1:term_status "testing" .

onto:person a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "person" ;
    rdfs:comment "\\n\\t\\tAssociates a segment classified as holding speech content to a FOAF\\n\\t\\tprofile (maybe holding information about genre, recognized speaker URI, etc.)\\n\\t\\t" ;
    rdfs:domain onto:PersonSegment ;
    rdfs:range foaf:Person ;
    ns1:term_status "testing" .

onto:pitch a owl:DatatypeProperty ;
    rdfs:label "pitch" ;
    rdfs:comment "\\n\\t\\tAssociates a pitch event to the corresponding pitch\\n\\t" ;
    rdfs:domain onto:Pitch ;
    rdfs:subPropertyOf onto:feature ;
    ns1:term_status "testing" .

onto:signal_feature a owl:DatatypeProperty ;
    rdfs:label "signal-level feature" ;
    rdfs:comment "\\n\\t\\tAssociates an audio signal with a track-level signal feature.\\n\\t\\teg. a spectrogram, a chromagram, an onset detection function.\\n\\t" ;
    rdfs:domain <http://purl.org/ontology/mo/Signal> ;
    rdfs:range onto:Signal ;
    ns1:term_status "testing" .

onto:standard_british_english a onto:EnglishIdiom ;
    dc:title "Standard British English" ;
    ns1:term_status "testing" .

onto:standard_german a onto:GermanIdiom ;
    dc:title "Standard German" ;
    ns1:term_status "testing" .

onto:standard_hungarian a onto:HungarianIdiom ;
    dc:title "Standard Hungarian" ;
    ns1:term_status "testing" .

onto:standard_us_english a onto:EnglishIdiom ;
    dc:title "Standard US English" ;
    ns1:term_status "testing" .

onto:swiss_german a onto:GermanIdiom ;
    dc:title "Swiss German" ;
    ns1:term_status "testing" .

onto:tempo a owl:DatatypeProperty ;
    rdfs:label "tempo" ;
    rdfs:comment "\\n\\t\\tAssociates a tempo event to the corresponding tempo value.\\n\\t" ;
    rdfs:domain onto:Tempo ;
    rdfs:subPropertyOf onto:feature ;
    ns1:term_status "testing" .

onto:text a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:comment "\\n\\t\\tRelates a Text segment (classifying a time interval that can \\n\\t\\tbe associated to some text) to a text string or other literals (number, etc.)\\n\\t\\t" ;
    rdfs:domain onto:Text ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#hasLiteralFactor> ;
    ns1:term_status "testing" .

onto:tonic a owl:ObjectProperty ;
    rdfs:label "tonic" ;
    rdfs:comment "Associates a tonic event with the corresponding tonic" ;
    rdfs:domain onto:TonicSegment ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#factor> ;
    ns1:term_status "testing" .

onto:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment "\\n\\t\\tAssociates a signal resource as defined in the Music Ontology to a literal: its actual value.\\n\\t\\tFor example, it can be used to link an onset detection function to a list of values.\\n\\t" ;
    rdfs:domain onto:Signal ;
    rdfs:subPropertyOf rdf:value ;
    ns1:term_status "testing" .

<http://www.w3.org/1999/02/22-rdf-syntax-ns> a owl:Ontology ;
    rdfs:label "The Audio Features ontology" ;
    dc:creator <http://moustaki.org/foaf.rdf#moustaki> ;
    dc:date "$Date: 2008/06/23 10:24:13 $" ;
    dc:description "\\n\\t\\tThis ontology expresses some common concepts\\n\\t\\tto represent automatically extracted features\\n\\t\\tfrom audio signals. Therefore, it mainly relies \\n\\t\\ton the Event ontology, in order to classify particular\\n\\t\\tparts of the timeline backing an audio signal. \\n\\t\\t\\n\\t\\tPrograms outputting RDF according to this ontology should \\n\\t\\talso describe the ouputted document to express some information\\n\\t\\tabout itself (estimated confidence, maintainer of the program, etc.)\\n\\t\\t" ;
    dc:title "The Audio Features ontology" ;
    owl:versionInfo "Revision: 1.1" ;
    foaf:maker <http://moustaki.org/foaf.rdf#moustaki> .

ns1:term_status a owl:AnnotationProperty .

onto:EmotionSegment a owl:Class ;
    rdfs:label "Emotion segment" ;
    rdfs:comment "\\n\\t\\tA classifier for emotional content\\n\\t\\t" ;
    rdfs:subClassOf onto:SpeechSegment ;
    ns1:term_status "testing" .

onto:HungarianIdiom a owl:Class ;
    rdfs:label "Hungarian idiom" ;
    rdfs:comment "Hungarian idiom" ;
    ns1:term_status "testing" .

onto:Idiom a owl:Class ;
    rdfs:label "Idiom" ;
    rdfs:comment "\\n\\t\\tIdiom (English with Irish accent, Austrian German, etc.)\\n\\t\\t" ;
    ns1:term_status "testing" .

onto:IdiomSegment a owl:Class ;
    rdfs:label "Idiom segment" ;
    rdfs:comment "\\n\\t\\tA classifier for recognized idiom (English with Irish accent, etc.)\\n\\t\\t" ;
    rdfs:subClassOf onto:SpeechSegment ;
    ns1:term_status "testing" .

onto:KeyChange a owl:Class ;
    rdfs:label "Key change event" ;
    rdfs:comment "A key change event. The factor of such an event captures the key that holds after that event." ;
    rdfs:subClassOf onto:Point ;
    ns1:term_status "testing" .

onto:KeySegment a owl:Class ;
    rdfs:label "Key event" ;
    rdfs:comment "\\n\\t\\tA classifier for keys.\\n\\t\\tIn case of a \"clean cut\", instances of such events\\n\\t\\tshould have one factor: the detected key (perhaps using the\\n\\t\\tkey ontology at http://purl.org/NET/c4dm/keys.owl).\\n\\t\\tIn other cases, we can put several keys as a factor, maybe with different confidence\\n\\t\\tfactors, using event decomposition.\\n\\t\\t" ;
    rdfs:subClassOf onto:MusicSegment ;
    ns1:term_status "testing" .

onto:Pitch a owl:Class ;
    rdfs:label "Pitch event" ;
    rdfs:comment "Associate a point to a particular pitch",
        "Event holding a pitch value (for example coming from a monophonic transcription process)" ;
    rdfs:subClassOf onto:MusicSegment,
        onto:Point ;
    ns1:term_status "testing" .

onto:Tempo a owl:Class ;
    rdfs:label "Tempo event" ;
    rdfs:comment "Event holding a tempo value (120bpm...)" ;
    rdfs:subClassOf onto:MusicSegment ;
    ns1:term_status "testing" .

onto:Text a owl:Class ;
    rdfs:label "Text" ;
    rdfs:comment "\\n\\t\\tA classifier allowing to associate some text to a segment\\n\\t\\t" ;
    rdfs:subClassOf onto:SpeechSegment ;
    ns1:term_status "testing" .

onto:TonicSegment a owl:Class ;
    rdfs:label "Tonic event" ;
    rdfs:comment "\\n\\t\\tA classifier for tonics.\\n\\t\\tIn case of a \"clean cut\", instances of such events have one\\n\\t\\tfactor. In other cases, this event can have several factors, each associated\\n\\t\\twith a particular confidence using event decomposition.\\t\\n\\t" ;
    rdfs:subClassOf onto:MusicSegment ;
    ns1:term_status "testing" .

onto:Onset a owl:Class ;
    rdfs:label "Onset" ;
    rdfs:comment "\\n\\t\\tA classifier corresponding to the output of an onset detection process.\\n\\t\\t" ;
    rdfs:subClassOf onto:Point ;
    ns1:term_status "testing" .

onto:Segment a owl:Class ;
    rdfs:label "Segment" ;
    rdfs:comment "\\n\\t\\tA classifier for a temporal region corresponding to the output\\n\\t\\tof an automatic process---an artificial cognitive agent.\\n\\t\\t" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/NET/c4dm/event.owl#time> ;
            owl:someValuesFrom <http://purl.org/NET/c4dm/timeline.owl#Interval> ],
        <http://purl.org/NET/c4dm/event.owl#Event> ;
    ns1:term_status "testing" .

onto:SpectralCentroid a owl:Class ;
    rdfs:label "Spectral centroid" ;
    rdfs:comment "\\n\\t\\tSpectral centroid\\n\\t" ;
    rdfs:subClassOf onto:Signal ;
    ns1:term_status "testing" .

onto:StructuralSegment a owl:Class ;
    rdfs:label "Structural Segment" ;
    rdfs:comment "\\n\\t\\tA classifier trying to capture the notion of structure in an audio piece.\\n\\t\\tThis classifier should be subsumed by more specific classifiers: speech/music\\n\\t\\tsegmentation, structural music segmmentation (intro, verse, chorus, etc.).\\n\\t\\t" ;
    rdfs:subClassOf onto:Segment ;
    ns1:term_status "testing" .

onto:feature a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "feature" ;
    rdfs:comment "\\n\\t\\tAssociates a segment classifying a feature to the actual feature---we should use mpeg7 sort-of datatypes here\\n\\t\\t" ;
    rdfs:domain onto:Segment ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#literal_factor> ;
    ns1:term_status "testing" .

onto:DetectionFunction a owl:Class ;
    rdfs:label "Detection function" ;
    rdfs:comment "\\n\\t\\tA detection function.\\n\\t" ;
    rdfs:subClassOf onto:Signal ;
    ns1:term_status "testing" .

onto:GermanIdiom a owl:Class ;
    rdfs:label "German idiom" ;
    rdfs:comment "\\n\\t\\tGerman idiom\\n\\t\\t" ;
    ns1:term_status "testing" .

onto:EnglishIdiom a owl:Class ;
    rdfs:label "English idiom" ;
    rdfs:comment "\\n\\t\\tEnglish idiom\\n\\t\\t" ;
    ns1:term_status "testing" .

onto:SpeechSegment a owl:Class ;
    rdfs:label "Speech" ;
    rdfs:comment "\\n\\t\\tA classifier capturing the notion of an audio segment holding speech\\n\\t\\tcontent\\n\\t\\t" ;
    rdfs:subClassOf onto:StructuralSegment ;
    ns1:term_status "testing" .

onto:Point a owl:Class ;
    rdfs:label "Point" ;
    rdfs:comment "\\n\\t\\tA classifier for instants corresponding to the output of an automatic process---an\\n\\t\\tartificial cognitive agent (should be associated to a time:Instant---DL version).\\n\\t\\t" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/NET/c4dm/event.owl#time> ;
            owl:someValuesFrom <http://purl.org/NET/c4dm/timeline.owl#Instant> ],
        <http://purl.org/NET/c4dm/event.owl#Event> ;
    ns1:term_status "testing" .

onto:Signal a owl:Class ;
    rdfs:label "Signal-level feature" ;
    rdfs:comment "\\n\\t\\tA signal-like feature, holding dense data describing another signal.\\n\\t\\tExamples of signal features include chromagrams, spectrograms, onset detection functions etc.\\n\\t" ;
    rdfs:subClassOf <http://purl.org/ontology/mo/Signal> ;
    ns1:term_status "testing" .

onto:MusicSegment a owl:Class ;
    rdfs:label "Music" ;
    rdfs:comment "\\n\\t\\tA classifier capturing the notion of an audio segment holding music.\\n\\t\\tThis classifier can be subsumed with more specific classifiers.\\n\\t\\t" ;
    rdfs:subClassOf onto:StructuralSegment ;
    ns1:term_status "testing" .

