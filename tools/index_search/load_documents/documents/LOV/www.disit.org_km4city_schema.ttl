    rdfs:domain <http://www.disit.org/km4city/schema#GoodsYard> ;
    rdfs:range xsd:string .

<http://www.disit.org/km4city/schema#year> a owl:DatatypeProperty ;
    rdfs:domain <http://www.disit.org/km4city/schema#Resolution> ;
