    rdfs:range xsd:string .

<http://www.disit.org/km4city/schema#state> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.disit.org/km4city/schema#GoodsYard> <http://www.disit.org/km4city/schema#TrainStation> ) ] ;
