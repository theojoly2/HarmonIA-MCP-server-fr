@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix onto: <http://www.nanopub.org/nschema> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    dc:created "2012-10-26"^^xsd:date ;
    dc:description <http://www.nanopub.org/2013/WD-guidelines-20131215/> ;
    dc:modified "2013-10-23"^^xsd:date ;
    owl:priorVersion onto:-1.9 .

<http://www.nanopub.org/nschema#hasAssertion> a owl:FunctionalProperty ;
    rdfs:domain <http://www.nanopub.org/nschema#Nanopublication> ;
    rdfs:range <http://www.nanopub.org/nschema#Assertion> .

<http://www.nanopub.org/nschema#hasProvenance> a owl:FunctionalProperty ;
    rdfs:domain <http://www.nanopub.org/nschema#Nanopublication> ;
    rdfs:range <http://www.nanopub.org/nschema#Provenance> .

<http://www.nanopub.org/nschema#hasPublicationInfo> a owl:FunctionalProperty ;
    rdfs:domain <http://www.nanopub.org/nschema#Nanopublication> ;
    rdfs:range <http://www.nanopub.org/nschema#PublicationInfo> .

<http://www.nanopub.org/nschema#Assertion> rdfs:subClassOf <http://www.w3.org/2004/03/trix/rdfg-1/Graph> .

<http://www.nanopub.org/nschema#Provenance> rdfs:subClassOf <http://www.w3.org/2004/03/trix/rdfg-1/Graph> .

<http://www.nanopub.org/nschema#PublicationInfo> rdfs:subClassOf <http://www.w3.org/2004/03/trix/rdfg-1/Graph> .

<http://www.nanopub.org/nschema#Nanopublication> a owl:Class .

