onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    ns1:license <http://creativecommons.org/licenses/by-sa/3.0/>,
        <http://www.gnu.org/copyleft/fdl.html> ;
    dcterms:creator "DBpedia Maintainers and Contributors" ;
    dcterms:description "The DBpedia ontology provides the classes and properties used in the DBpedia data set."@en ;
    dcterms:issued "2008-11-17T12:00Z" ;
    dcterms:modified "2016-05-21T19:13Z" ;
    dcterms:publisher "DBpedia Maintainers" ;
    dcterms:source <http://mappings.dbpedia.org> ;
    dcterms:title "The DBpedia Ontology"@en ;
    vann:preferredNamespacePrefix "dbo" ;
    vann:preferredNamespaceUri "http://dbpedia.org/ontology/" ;
    rdfs:comment "This ontology is generated from the manually created specifications in the DBpedia Mappings\\n              Wiki. Each release of this ontology corresponds to a new release of the DBpedia data set which\\n              contains instance data extracted from the different language versions of Wikipedia. For\\n              information regarding changes in this ontology, please refer to the DBpedia Mappings Wiki."@en ;
    owl:versionInfo "4.2-SNAPSHOT"@en ;
    foaf:homepage <http://wiki.dbpedia.org/Ontology> .

onto:Abbey a owl:Class ;
    rdfs:label "abbey"@en,
        "abbaye"@fr ;
    rdfs:comment "An abbey is a Catholic monastery or convent, under the authority of an Abbot or an Abbess, who serves as the spiritual father or mother of the community."@en,
        "Une abbaye est un monastère ou un couvent catholique placé sous la direction d'un abbé, lequel sert de père spirituel à la communauté religieuse"@fr ;
    rdfs:subClassOf onto:ReligiousBuilding ;
    owl:equivalentClass onto:Monastery,
        <http://www.wikidata.org/entity/Q160742> ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:Abbey> .

onto:AcademicConference a owl:Class ;
    rdfs:label "academic conference"@en,
        "conférence scientifique"@fr ;
    rdfs:subClassOf onto:SocietalEvent ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AcademicConference> .

onto:AcademicSubject a owl:Class ;
    rdfs:label "academic subject"@en,
        "sujet académique"@fr ;
    rdfs:comment "Genres of art, e.g. Mathematics, History, Philosophy, Medicine"@en ;
    rdfs:subClassOf onto:TopicalConcept ;
    owl:equivalentClass <http://www.wikidata.org/entity/Q11862829> ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AcademicSubject> .

onto:AmateurBoxer a owl:Class ;
    rdfs:label "amateur boxer"@en,
        "boxeur amateur"@fr ;
    rdfs:subClassOf onto:Boxer ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AmateurBoxer> .

onto:Ambassador a owl:Class ;
    rdfs:label "ambassador"@en,
        "ambassadeur"@fr ;
    rdfs:comment "An ambassador is the highest ranking diplomat that represents a nation and is usually accredited to a foreign sovereign or government, or to an international organization."@en ;
    rdfs:subClassOf onto:Person ;
    owl:equivalentClass <http://www.wikidata.org/entity/Q121998> ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:Ambassador> .

onto:AmericanFootballCoach a owl:Class ;
    rdfs:label "american football coach"@en ;
    rdfs:subClassOf onto:Coach ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AmericanFootballCoach> .

onto:AmericanFootballLeague a owl:Class ;
    rdfs:label "american football league"@en,
        "american football league"@fr ;
    rdfs:comment "A group of sports teams that compete against each other in american football."@en ;
    rdfs:subClassOf onto:SportsLeague ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AmericanFootballLeague> .

onto:AmericanFootballPlayer a owl:Class ;
    rdfs:label "american football player"@en,
        "joueur de football américain"@fr ;
    rdfs:subClassOf onto:GridironFootballPlayer ;
    owl:equivalentClass <http://www.wikidata.org/entity/Q14128148> ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AmericanFootballPlayer> .

onto:AmericanFootballTeam a owl:Class ;
    rdfs:label "american football Team"@en,
        "équipe américaine de football américain"@fr ;
    rdfs:subClassOf onto:SportsTeam ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AmericanFootballTeam> .

onto:Amphibian a owl:Class ;
    rdfs:label "amphibian"@en,
        "amphibien"@fr ;
    rdfs:subClassOf onto:Animal ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:Amphibian> .

onto:AnimangaCharacter a owl:Class ;
    rdfs:label "animanga character"@en ;
    rdfs:comment "Anime/Manga character"@en ;
    rdfs:subClassOf onto:ComicsCharacter ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AnimangaCharacter> .

