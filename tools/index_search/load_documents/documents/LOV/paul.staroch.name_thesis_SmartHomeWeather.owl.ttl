@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.oclc.org/NET/muo/muo#> .
@prefix ns2: <http://purl.oclc.org/NET/muo/ucum/> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix onto: <http://paul.staroch.name/thesis/SmartHomeWeather.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    ns3:license <http://creativecommons.org/licenses/by/3.0/> ;
    dc:contributor <http://paul.staroch.name/foaf/staroch.rdf#paul>,
        "Mario Kofler" ;
    dc:creator <http://paul.staroch.name/foaf/staroch.rdf#paul> ;
    dc:description "A ontology defining weather-related concepts and properties being relevant to smart home systems that provide predictive control." ;
    dc:issued "2013-08-29"^^xsd:date ;
    dc:modified "2014-03-23"^^xsd:date ;
    dc:publisher <http://paul.staroch.name/foaf/staroch.rdf#paul> ;
    dc:title "SmartHomeWeather" ;
    vann:preferredNamespacePrefix "shw" ;
    vann:preferredNamespaceUri "http://paul.staroch.name/thesis/SmartHomeWeather.owl" ;
    owl:imports ns2:,
        <http://www.w3.org/2006/time> ;
    owl:versionInfo 1.0 .

onto:AiringWeather a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:FairWeather onto:PleasantTemperatureWeather ) ] .

onto:AstronomicalTwilight a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasSunDirection ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:nonNegativeInteger ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive 360 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty onto:hasSunElevationAngle ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "-18.0"^^xsd:float ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive "-12.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:CivilTwilight a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasSunDirection ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:nonNegativeInteger ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive 360 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty onto:hasSunElevationAngle ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "-6.0"^^xsd:float ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive "0.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:CloudyWeather a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherState [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty onto:hasWeatherPhenomenon ;
                                    owl:someValuesFrom onto:MostlyCloudy ] [ a owl:Restriction ;
                                    owl:onProperty onto:hasWeatherPhenomenon ;
                                    owl:someValuesFrom onto:Overcast ] ) ] ) ] .

onto:ColdWeather a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherState [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty onto:hasWeatherPhenomenon ;
                                    owl:someValuesFrom onto:Cold ] [ a owl:Restriction ;
                                    owl:onProperty onto:hasWeatherPhenomenon ;
                                    owl:someValuesFrom onto:Frost ] ) ] ) ] .

onto:CurrentWeatherReportFromSensor a owl:Class ;
    rdfs:comment "A WeatherState about the current weather based on data retrieved from a (collection of) sensor(s), e.g. it is connected to an instance of SensorSource via the hasSource property."^^xsd:string ;
    rdfs:seeAlso onto:CurrentWeatherState,
        onto:WeatherState,
        onto:WeatherStateFromSensor ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:CurrentWeatherReport onto:WeatherReportFromSensor ) ] .

onto:CurrentWeatherReportFromService a owl:Class ;
    rdfs:comment "A WeatherState about the current weather based on data retrieved from an internet service, e.g. it is connected to an instance of ServiceSource via the hasSource property."^^xsd:string ;
    rdfs:seeAlso onto:CurrentWeatherState,
        onto:WeatherState,
        onto:WeatherStateFromService ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:CurrentWeatherReport onto:WeatherReportFromService ) ] .

onto:DirectionalWind a owl:Class ;
    rdfs:comment "A WeatherPhenomenon giving information about wind. There are two properties: hasWindDirection gives the cloud cover of this layer in degrees (an integer in the interval [0-359] where 0 is North, 90 is East etc.). hasWindSpeed is a float specifying wind speed in m/s."^^xsd:string ;
    rdfs:seeAlso onto:WeatherPhenomenon,
        onto:hasWindDirection,
        onto:hasWindSpeed ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasWindDirection ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:nonNegativeInteger ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive 360 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty onto:hasWindSpeed ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:metresPerSecond ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:DryWeather a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherState [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty onto:hasWeatherPhenomenon ;
                                    owl:someValuesFrom onto:Dry ] [ a owl:Restriction ;
                                    owl:onProperty onto:hasWeatherPhenomenon ;
                                    owl:someValuesFrom onto:VeryDry ] ) ] ) ] .

onto:EastWind a owl:Class ;
    rdfs:comment "A WeatherPhenomenon giving information about wind. There are two properties: hasWindDirection gives the cloud cover of this layer in degrees (an integer in the interval [0-359] where 0 is North, 90 is East etc.). hasWindSpeed is a float specifying wind speed in m/s."^^xsd:string ;
    rdfs:seeAlso onto:WeatherPhenomenon,
        onto:hasWindDirection,
        onto:hasWindSpeed ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasWindDirection ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:nonNegativeInteger ;
                                                    owl:withRestrictions ( [ xsd:minInclusive 45 ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:nonNegativeInteger ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive 135 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty onto:hasWindSpeed ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:metresPerSecond ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:HighPressure a owl:Class ;
    rdfs:comment "A WeatherPhenomenon describing an atmospheric pressure between 1018 hPa and 1028 hPa."^^xsd:string ;
    rdfs:seeAlso onto:AtmosphericPressure,
        onto:hasPressure ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasPressureValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:hectopascal ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "1018.0"^^xsd:float ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive "1028.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:HighRadiation a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasSolarRadiationValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:wattsPerSquareMeter ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "500.0"^^xsd:float ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive "750.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:HotWeather a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherState [ a owl:Restriction ;
                        owl:onProperty onto:hasWeatherPhenomenon ;
                        owl:someValuesFrom onto:Heat ] ) ] .

onto:Hour a owl:Class ;
    rdfs:comment "This class describes a duration of hours."^^xsd:string ;
    rdfs:seeAlso time:DurationDescription ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:weeks ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:years ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:days ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:seconds ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:minutes ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty time:hours ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty time:months ],
        time:DurationDescription .

onto:LongRangeForecastReport a owl:Class ;
    rdfs:comment "A WeatherState describing the weather for more than 12 hours in the future."^^xsd:string ;
    rdfs:seeAlso onto:LongRange,
        onto:WeatherState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherReport [ a owl:Restriction ;
                        owl:onProperty onto:hasStartTime ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty time:hasDurationDescription ;
                                owl:someValuesFrom [ a owl:Restriction ;
                                        owl:onProperty time:hours ;
                                        owl:someValuesFrom [ a rdfs:Datatype ;
                                                owl:onDatatype xsd:decimal ;
                                                owl:withRestrictions ( [ xsd:minInclusive 12 ] ) ] ] ] ] ) ] .

onto:LowPressure a owl:Class ;
    rdfs:comment "A WeatherPhenomenon describing an atmospheric pressure between 998 hPa and 1008 hPa."^^xsd:string ;
    rdfs:seeAlso onto:AtmosphericPressure,
        onto:hasPressure ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasPressureValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:hectopascal ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "998.0"^^xsd:float ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive "1008.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:LowRadiation a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasSolarRadiationValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:wattsPerSquareMeter ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minExclusive "0.0"^^xsd:float ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive "250.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:MediumRadiation a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasSolarRadiationValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:wattsPerSquareMeter ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "250.0"^^xsd:float ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive "500.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:MediumRangeForecastReport a owl:Class ;
    rdfs:comment "A WeatherState describing the weather for more than 3 and less than 12 hours in the future."^^xsd:string ;
    rdfs:seeAlso onto:MidRange,
        onto:WeatherState ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherReport [ a owl:Restriction ;
                        owl:onProperty onto:hasStartTime ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty time:hasDurationDescription ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( [ a owl:Restriction ;
                                                    owl:onProperty time:hours ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:decimal ;
                                                            owl:withRestrictions ( [ xsd:minExclusive 3 ] ) ] ] [ a owl:Restriction ;
                                                    owl:onProperty time:hours ;
                                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                                            owl:onDatatype xsd:decimal ;
                                                            owl:withRestrictions ( [ xsd:maxExclusive 12 ] ) ] ] ) ] ] ] ) ] .

onto:MoistWeather a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherState [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty onto:hasWeatherPhenomenon ;
                                    owl:someValuesFrom onto:Moist ] [ a owl:Restriction ;
                                    owl:onProperty onto:hasWeatherPhenomenon ;
                                    owl:someValuesFrom onto:VeryMoist ] ) ] ) ] .

onto:NauticalTwilight a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasSunDirection ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:nonNegativeInteger ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive 360 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty onto:hasSunElevationAngle ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "-12.0"^^xsd:float ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive "-6.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:Night a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasSunDirection ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:nonNegativeInteger ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive 360 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty onto:hasSunElevationAngle ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxExclusive "-18.0"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:NoAwningWeather a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherState [ a owl:Class ;
                        owl:unionOf ( onto:SevereWeather [ a owl:Restriction ;
                                    owl:onProperty onto:hasWeatherPhenomenon ;
                                    owl:someValuesFrom onto:StrongWind ] ) ] ) ] .

onto:NoRadiation a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasSolarRadiationValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:wattsPerSquareMeter ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:hasValue "0.0"^^xsd:float ;
                                            owl:onProperty ns1:numericalValue ] ) ] ] ) ] .

onto:NormalHumidity a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasHumidityValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/fraction/percent> ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:minInclusive "0.4"^^xsd:float ] ) ] ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
                                                    owl:withRestrictions ( [ xsd:maxInclusive "0.7"^^xsd:float ] ) ] ] ) ] ] ) ] .

onto:NormalPressure a owl:Class ;
    rdfs:comment "A WeatherPhenomenon describing an atmospheric pressure between 1008 hPa and 1018 hPa."^^xsd:string ;
    rdfs:seeAlso onto:AtmosphericPressure,
        onto:hasPressure ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasPressureValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:hectopascal ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:onProperty ns1:numericalValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:float ;
