onto:UnknownCloudCover a owl:Class ;
    rdfs:seeAlso onto:CloudCover,
        onto:WeatherPhenomenon,
        onto:hasCloudAltitude,
        onto:hasCloudCover,
        "A WeatherPhenomenon describing a cloud layer with cloud cover 9 (unknown cloud cover).\\n\\nNOTE: This class only specifies a single cloud layer. It does not make any statement about other cloud layers."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onto:WeatherPhenomenon [ a owl:Restriction ;
                        owl:onProperty onto:hasCloudCover ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Restriction ;
                                            owl:hasValue onto:okta ;
                                            owl:onProperty ns1:measuredIn ] [ a owl:Restriction ;
                                            owl:hasValue 9 ;
                                            owl:onProperty ns1:numericalValue ] ) ] ] ) ] .

