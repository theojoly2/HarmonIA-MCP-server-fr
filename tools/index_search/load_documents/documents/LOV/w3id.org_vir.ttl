@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix onto: <http://w3id.org/vir#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .

onto: a owl:Ontology ;
    dc:creator "Nicola Carboni" ;
    dc:date "2019-02-26" ;
    dc:description "This ontology, called VIR, is an extension of CIDOC-CRM created to sustain propositions on the nature of visual elements and permit these descriptions to be published on the Web.\\nWith the term visual element, we refer to those signs identified in the visual space as distinct and documentable units, and subject to an analytical interpretation.\\nThe scope of this ontology is to s to provide a framework to support the identification, annotation and interconnections between diverse visual elements and presents and assist their documentation and retrieval. Specifically, the model aims to clarify the identity and the relation of these visual signs, providing the necessary classes to characterise their constituent elements, reference, symbolic content and source of interpretation.\\nVIR expands on key entities and properties from CIDOC-CRM, introducing new classes and relationships responding to the visual and art historical community, specifically building up on the iconographical tradition. The result is a model which differentiates between interpretation and element identified, providing a clear distinction between denotation and signification of an element. As a consequence of such distinction, the ontology allows for the definition of diverse denotative criteria for the same representation, which could change based on traditions and perspective. Visual objects can be, in fact, polysemic and ambiguous, and it is not so easy to pin down a denotative or connotative meaning because they are very much context-dependent." ;
    dc:rights "This work is distributed under a Creative Commons Attribution License (http://creativecommons.org/licenses/by/3.0/)."@en ;
    dc:title "VIR - Visual Representation ontology"@en ;
    vann:preferredNamespacePrefix "vir" ;
    vann:preferredNamespaceUri "http://w3id.org/vir#" ;
    rdfs:comment "On 03/03/2019 change the range of K11 to E36_Visual_Item in order to accomodate the description of the recognition of Attributes" ;
    owl:versionInfo "1.1" .

onto:IC1_Iconographical_Atom a rdf:Class ;
    rdfs:label "Iconographical Atom" ;
    rdfs:comment "An Iconographical Atom is a physical arrangement of forms and colours created by human activity" ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E25_Man-Made_Feature> .

onto:K10_on_the_base_of a rdf:Property ;
    rdfs:label "On the base of" ;
    rdfs:comment "The property describes the source used for the status assignment" ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E89_Propositional_Object> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object> .

onto:K10i_is_basis_for a rdf:Property ;
    rdfs:label "is based on" ;
    rdfs:comment "The property describes the source used for the status assignment" ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E89_Propositional_Object> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P16i_was_used_for> .

onto:K11_assigned a rdf:Property ;
    rdfs:label "assigned" ;
    rdfs:comment "The property indicates the status assigned during the visual recognition event" ;
    rdfs:domain onto:IC12_Visual_Recognition ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P141_assigned> .

onto:K11i_was_assigned_by a rdf:Property ;
    rdfs:label "was assigned by" ;
    rdfs:comment "The property indicates the status assigned during the visual recognition event" ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item> ;
    rdfs:range onto:IC12_Visual_Recognition ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P141i_was_assigned_by> .

onto:K14_symbolize a rdf:Property ;
    rdfs:label "symbolize" ;
    rdfs:comment "The property indicates the symbolic value of the attribute presents in a representation" ;
    rdfs:domain onto:IC10_Attribute ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138_represents> .

onto:K14i_has_symbolic_value a rdf:Property ;
    rdfs:label "has symbolic value" ;
    rdfs:comment "The property indicates the symbolic value of the attribute presents in a representation" ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object> ;
    rdfs:range onto:IC10_Attribute ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138i_has_representation> .

onto:K15_use_feature a rdf:Property ;
    rdfs:label "use feature" ;
    rdfs:comment "The property indicates the specific attribute used during the production of a visual object" ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E12_Production> ;
    rdfs:range onto:IC10_Attribute ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P33_used_specific_technique> .

onto:K15i_has_been_used_by a rdf:Property ;
    rdfs:label "has been used by" ;
    rdfs:comment "The property indicates the specific attribute used during the production of a visual object" ;
    rdfs:domain onto:IC10_Attribute ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E12_Production> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P33i_was_used_by> .

onto:K17_has_attribute a rdf:Property ;
    rdfs:label "has attribute" ;
    rdfs:comment "This property associates an attribute with the iconographical object where it is depicted" ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range onto:IC10_Attribute ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P106_is_composed_of> .

onto:K17i_is_attribute_of a rdf:Property ;
    rdfs:label "is attribute of" ;
    rdfs:comment "This property associates an attribute with the iconographical object where it is depicted" ;
    rdfs:domain onto:IC10_Attribute ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P106i_forms_part_of> .

onto:K1_denotes a rdf:Property ;
    rdfs:label "Denote" ;
    rdfs:comment "The property documents the assignment of an iconographical object to a specific physical man-made object. It is a shortcut for the more fully developed path IC12 Visual Recognition assign (K9) to a E18 Physical Thing the status of (K11) IC9 Representation" ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P65_shows_visual_item> .

onto:K1i_is_denoted_by a rdf:Property ;
    rdfs:label "is denoted by" ;
    rdfs:comment "The property documents the assignment of an iconographical object to a specific physical man-made object. It is a shortcut for the more fully developed path IC12 Visual Recognition assign (K9) to a E18 Physical Thing the status of (K11) IC9 Representation." ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P65i_is_shown_by> .

onto:K20_forms_part_of a rdf:Property ;
    rdfs:label "forms part of" ;
    rdfs:comment "This property put in relation a representation with a part of itself." ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P148_has_component> .

onto:K20i_is_composed_of a rdf:Property ;
    rdfs:label "is composed of" ;
    rdfs:comment "This property put in relation a representation with a part of itself." ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P148i_is_component_of> .

onto:K21_depict_things_of_type a rdf:Property ;
    rdfs:label "depict things of type" ;
    rdfs:comment "This property indicates the type of object depicted by an iconographical attribute" ;
    rdfs:domain onto:IC10_Attribute ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P137_exemplifies> .

onto:K21i_is_depiction_of_attribute a rdf:Property ;
    rdfs:label "is depiction of attribute" ;
    rdfs:comment "This property indicates the type of object depicted by an iconographical attribute" ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
    rdfs:range onto:IC10_Attribute ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P137i_is_exemplified_by> .

onto:K22_has_personification a rdf:Property ;
    rdfs:label "has personification" ;
    rdfs:comment "This property indicates the membership of a personification in an iconographical object" ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range onto:IC11_Personification ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138_represents> .

onto:K22i_is_present_in a rdf:Property ;
    rdfs:label "is present in" ;
    rdfs:comment "This property indicates the membership of a personification in an iconographical object" ;
    rdfs:domain onto:IC16_Character ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138i_has_representation> .

onto:K23_connote a rdf:Property ;
    rdfs:label "connote" ;
    rdfs:comment "This property indicates the connotation relationships, formalised by Barthes, between a conceptual entity and an iconographical object. It is a shortcut for the more fully developed path IC12 Visual Recognition assign (K9) to a IC9 Representation a new (K11) IC9 Representation. It doesn&#8217;t offer any information about when and whom established the connotation relationship" ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138_represents> .

onto:K23i_is_connotation_of a rdf:Property ;
    rdfs:label "is connoted by" ;
    rdfs:comment "This property indicates the connotation relationships, formalised by Barthes, between a conceptual entity and an iconographical object. It is a shortcut for the more fully developed path IC12 Visual Recognition assign (K9) to a IC9 Representation a new (K11) IC9 Representation. It doesn&#8217;t offer any information about when and whom established the connotation relationship" ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138i_has_representation> .

onto:K24_portray a rdf:Property ;
    rdfs:label "portray" ;
    rdfs:comment "This property put in relation an iconographical object with the portrayed character." ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range onto:IC16_Character ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138_represents> .

onto:K24i_is_portrayed_in a rdf:Property ;
    rdfs:label "is portrayed by" ;
    rdfs:comment "This property put in relation an iconographical object with the portrayed character." ;
    rdfs:domain onto:IC16_Character ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138i_has_representation> .

onto:K25_express a rdf:Property ;
    rdfs:label "express" ;
    rdfs:comment "This property put in relation a symbolic object with a personification in a work of art" ;
    rdfs:domain onto:IC10_Attribute ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138_represents> .

onto:K25i_is_abstraction_of a rdf:Property ;
    rdfs:label "is abstraction of" ;
    rdfs:comment "This property put in relation a symbolic object with a personification in a work of art." ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object> ;
    rdfs:range onto:IC10_Attribute ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138i_has_representation> .

onto:K26_has_source a rdf:Property ;
    rdfs:label "has source" ;
    rdfs:comment "This property associates an instance of IC16 Character with an instance of E39 Actor that the character is motivated by or is intended to represent" ;
    rdfs:domain onto:IC16_Character ;
    rdfs:subPropertyOf <http://iflastandards.info/ns/fr/frbr/frbroo/R57_is_based_on> .

onto:K26i_is_source_of a rdf:Property ;
    rdfs:label "is source of" ;
    rdfs:comment "This property associates an instance of IC16 Character with an instance of E39 Actor that the character is motivated by or is intended to represent" ;
    rdfs:range onto:IC16_Character ;
    rdfs:subPropertyOf <http://iflastandards.info/ns/fr/frbr/frbroo/R57i_is_basis_for> .

onto:K34_illustrate a rdf:Property ;
    rdfs:label "illustrate" ;
    rdfs:comment "This property associate an information object to a iconographical representation" ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138_represents> .

onto:K34i_is_illustrated_by a rdf:Property ;
    rdfs:label "is illustrated by" ;
    rdfs:comment "This property associate an information object to a iconographical representation" ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P138i_has_representation> .

onto:K4_1_prototypical_model a rdf:Property ;
    rdfs:domain onto:PCK4_is_visual_prototype_of ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E55_Type> .

onto:K4_is_visual_prototype_of a rdf:Property ;
    rdfs:label "is visual prototype of" ;
    rdfs:comment "The property documents the use of a specific prototypical example for an image. The nature of the relationships helps define a map of relationships between prototypical items used in the arts." ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67_refers_to> .

onto:K4i_has_visual_prototype a rdf:Property ;
    rdfs:label "has visual prototype" ;
    rdfs:comment "The property documents the use of a specific prototypical example for an image. The nature of the relationships helps define a map of relationships between prototypical items used in the arts." ;
    rdfs:domain onto:IC9_Representation ;
    rdfs:range onto:IC9_Representation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by> .

onto:K6_has_back a rdf:Property ;
    rdfs:label "has back" ;
    rdfs:comment "The property documents the presence of a Verso or a Recto, respectively in the back or in the front of an object" ;
    rdfs:domain onto:IC19_Recto ;
    rdfs:range onto:IC20_Verso ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of> .

onto:K6i_has_front a rdf:Property ;
    rdfs:label "has front" ;
    rdfs:comment "The property documents the presence of a Verso or a Recto, respectively in the back or in the front of an object." ;
    rdfs:domain onto:IC20_Verso ;
    rdfs:range onto:IC19_Recto ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of> .

onto:K7_is_recto_of a rdf:Property ;
    rdfs:label "is recto of" ;
    rdfs:comment "The property indicates the presence of a recto in the described object" ;
    rdfs:domain onto:IC19_Recto ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E22_Man-Made_Object> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P56_bears_feature> .

onto:K7i_has_recto a rdf:Property ;
    rdfs:label "has recto" ;
    rdfs:comment "The property indicates the presence of a recto in the described object" ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E22_Man-Made_Object> ;
    rdfs:range onto:IC19_Recto ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P56i_is_found_on> .

onto:K8_is_verso_of a rdf:Property ;
    rdfs:label "is verso of" ;
    rdfs:comment "The property indicates the presence of a verso in the described object" ;
    rdfs:domain onto:IC20_Verso ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E22_Man-Made_Object> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P56_bears_feature> .

onto:K8i_has_verso a rdf:Property ;
    rdfs:label "has verso" ;
    rdfs:comment "The property indicates the presence of a verso in the described object" ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E22_Man-Made_Object> ;
    rdfs:range onto:IC20_Verso ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P56i_is_found_on> .

onto:K9_Assigned_status_to a rdf:Property ;
    rdfs:label "Assigned status to" ;
    rdfs:comment "The property documents the assignment of status to a specific physical thing" ;
    rdfs:domain onto:IC12_Visual_Recognition ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to> .

onto:K9i_has_status_assigned_by a rdf:Property ;
    rdfs:label "has status assigned by" ;
    rdfs:comment "The property documents the assignment of status to a specific physical thing." ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> ;
    rdfs:range onto:IC12_Visual_Recognition ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P140i_was_attributed_by> .

onto:IC11_Personification a rdf:Class ;
    rdfs:label "Personification" ;
    rdfs:comment "A human, or anthropomorphic figure, that represents an abstract idea or a concept" ;
    rdfs:subClassOf onto:IC16_Character ;
    skos:closeMatch <https://www.wikidata.org/wiki/Q207174> .

onto:PCK4_is_visual_prototype_of a rdf:Class ;
    rdfs:comment "n-ary construct to document the use of a specific prototypical example for an image. The nature of the relationships helps define a map of relationships between prototypical items used in the arts. To be used together with 'K4.1_prototypical_model'" ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/PC0_Typed_CRM_Property> .

onto:IC12_Visual_Recognition a rdf:Class ;
    rdfs:label "Visual Recognition" ;
    rdfs:comment "The activity of assigning the iconographical status to a man-made object, or to one of its parts. It takes into account the possibility to link it to a speech act or a document where the authoritative proposition is clearly made" ;
    rdfs:subClassOf <http://www.ics.forth.gr/isl/CRMsci/S4_Observation> .

onto:IC19_Recto a rdf:Class ;
    rdfs:label "Recto" ;
    rdfs:comment "The front or face of a single sheet or the right-hand page of an open book. The feature is presents in object such as codex, books, pamphlets, documents, photographs and painting." ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E26_Physical_Feature> ;
    skos:exactMatch <https://www.wikidata.org/wiki/Q9305022> .

onto:IC20_Verso a rdf:Class ;
    rdfs:label "Verso" ;
    rdfs:comment "The back or underside of a single sheet of paper, or the left-hand page of an open book. The feature is presents in object such as codex, books, pamphlets, documents, photographs and painting." ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E26_Physical_Feature> ;
    skos:exactMatch <https://www.wikidata.org/wiki/Q9368452> .

onto:IC16_Character a rdf:Class ;
    rdfs:label "Character" ;
    rdfs:comment "This class comprises fictional individuals, or groups, appearing in a representation. Each character portrayed can have a type, for example 'Saint' or 'layman'. Every saint portrayed is considered here as a character and not as an actor." ;
    rdfs:subClassOf <http://iflastandards.info/ns/fr/frbr/frbroo/F38_Character> .

onto:IC10_Attribute a rdf:Class ;
    rdfs:label "Iconographical Attribute" ;
    rdfs:comment "A set of features considered by a viewer more salient than others and used as a key for the identification of a Representation. The attribute could correspond to iconographical elements or simple signs which the viewer uses to provide a stable identity to a visual object." ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure>,
        <http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item> ;
    skos:closeMatch <http://dbpedia.org/ontology/iconographicAttributes>,
        <https://www.wikidata.org/wiki/Q204231> .

onto:IC9_Representation a rdf:Class ;
    rdfs:label "Representation" ;
    rdfs:comment "A single pictorial item or a part of it.  Single representations or region of the same representations are instance of this class." ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item> ;
    skos:exactMatch <https://w3id.org/lio/v1PictorialElement> .

