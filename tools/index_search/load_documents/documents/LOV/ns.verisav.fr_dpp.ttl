    rdfs:comment "The duration of the warranty in months."@en,
        "La durée de la garantie en mois."@fr ;
    rdfs:domain onto:Warranty ;
    rdfs:range xsd:integer .

onto:warrantyEndDate a owl:DatatypeProperty ;
    rdfs:label "warranty end date"@en,
        "date de fin de garantie"@fr ;
    rdfs:comment "The end date of the warranty."@en,
        "La date de fin de la garantie."@fr ;
    rdfs:domain onto:Warranty ;
    rdfs:range xsd:date .

onto:warrantyStartDate a owl:DatatypeProperty ;
    rdfs:label "warranty start date"@en,
        "date de début de garantie"@fr ;
    rdfs:comment "The start date of the warranty."@en,
        "La date de début de la garantie."@fr ;
    rdfs:domain onto:Warranty ;
    rdfs:range xsd:date .

onto:warrantyStatus a owl:DatatypeProperty ;
    rdfs:label "warranty status"@en,
        "statut de garantie"@fr ;
    rdfs:comment "The status of the warranty (active, expiree, suspendue, annulee)."@en,
        "Le statut de la garantie (active, expirée, suspendue, annulée)."@fr ;
    rdfs:domain onto:Warranty ;
    rdfs:range xsd:string .

onto:warrantyType a owl:DatatypeProperty ;
    rdfs:label "warranty type"@en,
        "type de garantie"@fr ;
    rdfs:comment "The type of warranty (constructeur, retailer, extension, maintenance)."@en,
        "Le type de garantie (constructeur, distributeur, extension, maintenance)."@fr ;
    rdfs:domain onto:Warranty ;
    rdfs:range xsd:string .

onto:workOrderNumber a owl:DatatypeProperty ;
    rdfs:label "work order number"@en,
        "numéro d'ordre de travail"@fr ;
    rdfs:comment "The unique identifier for the work order."@en,
        "L'identifiant unique de l'ordre de travail."@fr ;
    rdfs:domain onto:WorkOrder ;
    rdfs:range xsd:string .

onto:workOrderPriority a owl:DatatypeProperty ;
    rdfs:label "work order priority"@en,
        "priorité de l'ordre de travail"@fr ;
    rdfs:comment "The priority of the work order (basse, normale, haute, urgente)."@en,
        "La priorité de l'ordre de travail (basse, normale, haute, urgente)."@fr ;
    rdfs:domain onto:WorkOrder ;
    rdfs:range xsd:string .

onto:workOrderStatus a owl:DatatypeProperty ;
    rdfs:label "work order status"@en,
        "statut de l'ordre de travail"@fr ;
    rdfs:comment "The status of the work order (cree, assigne, en_cours, en_attente_pieces, complete, facture, annule)."@en,
        "Le statut de l'ordre de travail (créé, assigné, en cours, en attente de pièces, complété, facturé, annulé)."@fr ;
    rdfs:domain onto:WorkOrder ;
    rdfs:range xsd:string .

onto:Consumer a owl:Class ;
    rdfs:label "Consumer"@en,
        "Consommateur"@fr ;
    rdfs:comment "A consumer who owns or uses a product."@en,
        "Un consommateur qui possède ou utilise un produit."@fr ;
    rdfs:subClassOf schema:Person .

onto:Manufacturer a owl:Class ;
    rdfs:label "Manufacturer"@en,
        "Fabricant"@fr ;
    rdfs:comment "The manufacturer of a product."@en,
        "Le fabricant d'un produit."@fr ;
    rdfs:subClassOf schema:Organization .

onto:RecyclingInstructions a owl:Class ;
    rdfs:label "Recycling Instructions"@en,
        "Consignes de Recyclage"@fr ;
    rdfs:comment "Instructions for recycling or disposing of a product at end of life."@en,
        "Instructions pour recycler ou éliminer un produit en fin de vie."@fr ;
    rdfs:subClassOf schema:CreativeWork .

onto:Repairer a owl:Class ;
    rdfs:label "Repairer"@en,
        "Réparateur"@fr ;
    rdfs:comment "A person or organization that repairs products."@en,
        "Une personne ou organisation qui répare des produits."@fr ;
    rdfs:subClassOf schema:Organization,
        schema:Person .

onto:Retailer a owl:Class ;
    rdfs:label "Retailer"@en,
        "Distributeur"@fr ;
    rdfs:comment "A retailer or distributor who sells products."@en,
        "Un distributeur qui vend des produits."@fr ;
    rdfs:subClassOf schema:Organization .

onto:TraceabilityEvent a owl:Class ;
    rdfs:label "Traceability Event"@en,
        "Événement de Traçabilité"@fr ;
    rdfs:comment "Traceability event based on ISO/IEC 19987 (EPCIS) or similar standards. Aligned with UNTP DPP-06."@en,
        "Événement de traçabilité basé sur ISO/IEC 19987 (EPCIS) ou standards similaires. Aligné avec UNTP DPP-06."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>,
        <https://www.iso.org/standard/71507.html> ;
    rdfs:subClassOf schema:Event ;
    ns1:term_status "stable" .

onto:WarrantyClaim a owl:Class ;
    rdfs:label "Warranty Claim"@en,
        "Réclamation de Garantie"@fr ;
    rdfs:comment "A claim made under a warranty."@en,
        "Une réclamation effectuée sous garantie."@fr ;
    rdfs:subClassOf schema:Claim .

onto:hasIntervention a owl:ObjectProperty ;
    rdfs:label "has intervention"@en,
        "a pour intervention"@fr ;
    rdfs:comment "Links a WorkOrder to an Intervention."@en,
        "Lie un WorkOrder à une Intervention."@fr ;
    rdfs:domain onto:WorkOrder ;
    rdfs:range onto:Intervention .

onto:hasWorkOrder a owl:ObjectProperty ;
    rdfs:label "has work order"@en,
        "a pour ordre de travail"@fr ;
    rdfs:comment "Links a ProductPassport to a WorkOrder."@en,
        "Lie un ProductPassport à un Ordre de Travail."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:WorkOrder .

onto:Document a owl:Class ;
    rdfs:label "Document"@en,
        "Document"@fr ;
    rdfs:comment "A document associated with a product (manuals, invoices, certificates, etc.)."@en,
        "Un document associé à un produit (manuels, factures, certificats, etc.)."@fr ;
    rdfs:subClassOf schema:DigitalDocument .

onto:Facility a owl:Class ;
    rdfs:label "Facility"@en,
        "Installation"@fr ;
    rdfs:comment "A location or building involved in the value chain of a product (manufacturing facility, warehouse, etc.) as per EU ESPR regulation. Aligned with UNTP DPP-04."@en,
        "Un lieu ou bâtiment impliqué dans la chaîne de valeur d'un produit (usine de fabrication, entrepôt, etc.) selon la réglementation européenne ESPR. Aligné avec UNTP DPP-04."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    rdfs:subClassOf schema:Place ;
    ns1:term_status "stable" .

onto:RepairEvent a owl:Class ;
    rdfs:label "Repair Event"@en,
        "Événement de Réparation"@fr ;
    rdfs:comment "A specific repair or maintenance intervention performed on a product."@en,
        "Une intervention de réparation ou maintenance spécifique effectuée sur un produit."@fr ;
    rdfs:subClassOf schema:Service .

onto:VerifiableCredential a owl:Class ;
    rdfs:label "Verifiable Credential"@en,
        "Credential Vérifiable"@fr ;
    rdfs:comment "A W3C Verifiable Credential (VCDM 2.0) that can be used to verify claims about a product passport or economic operator. Stored and managed via EU Business Wallet (EBW)."@en,
        "Un W3C Verifiable Credential (VCDM 2.0) qui peut être utilisé pour vérifier des déclarations sur un passeport produit ou un opérateur économique. Stocké et géré via EU Business Wallet (EBW)."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>,
        <https://www.w3.org/TR/vc-data-model-2.0/> ;
    rdfs:subClassOf schema:Thing ;
    ns1:term_status "stable" .

onto:VerifiableProductPassport a owl:Class ;
    rdfs:label "Verifiable Product Passport"@en,
        "Passeport Produit Vérifiable"@fr ;
    rdfs:comment "A Digital Product Passport issued as a W3C Verifiable Credential (VCDM 2.0) via EU Business Wallet (EBW). Provides cryptographic proof of authenticity and integrity."@en,
        "Un Passeport Produit Numérique émis comme W3C Verifiable Credential (VCDM 2.0) via EU Business Wallet (EBW). Fournit une preuve cryptographique d'authenticité et d'intégrité."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>,
        <https://www.w3.org/TR/vc-data-model-2.0/> ;
    rdfs:subClassOf onto:ProductPassport ;
    ns1:term_status "stable" .

onto:Criterion a owl:Class ;
    rdfs:label "Criterion"@en,
        "Critère"@fr ;
    rdfs:comment "A criterion or rule within a standard or regulation against which a claim is evaluated."@en,
        "Critère ou règle dans un standard ou réglementation contre lequel une déclaration est évaluée."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf schema:Thing ;
    ns1:term_status "stable" .

onto:Diagnostic a owl:Class ;
    rdfs:label "Diagnostic"@en,
        "Diagnostic"@fr ;
    rdfs:comment "A diagnostic assessment performed on a product to identify issues."@en,
        "Une évaluation de diagnostic effectuée sur un produit pour identifier les problèmes."@fr ;
    rdfs:subClassOf schema:Thing .

onto:ProductClassification a owl:Class ;
    rdfs:label "Product Classification"@en,
        "Classification Produit"@fr ;
    rdfs:comment "Product classification according to a standardized scheme (UN-CPC, GS1, NACE, etc.). Aligned with UNTP DPP-02."@en,
        "Classification d'un produit selon un schéma standardisé (UN-CPC, GS1, NACE, etc.). Aligné avec UNTP DPP-02."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    rdfs:subClassOf schema:Thing ;
    ns1:term_status "stable" .

onto:ProductLifecycleStage a owl:Class ;
    rdfs:label "Product Lifecycle Stage"@en,
        "Étape du Cycle de Vie du Produit"@fr ;
    rdfs:comment "A stage in the product lifecycle (manufacturing, purchase, usage, end of life, recycling)."@en,
        "Une étape dans le cycle de vie du produit (fabrication, achat, usage, fin de vie, recyclage)."@fr ;
    rdfs:subClassOf schema:Enumeration .

onto:ProductStatus a owl:Class ;
    rdfs:label "Product Status"@en,
        "Statut Produit"@fr ;
    rdfs:comment "The current status of a product (under warranty, out of warranty, broken, repaired, etc.)."@en,
        "Le statut actuel d'un produit (sous garantie, hors garantie, en panne, réparé, etc.)."@fr ;
    rdfs:subClassOf schema:Enumeration .

onto:Regulation a owl:Class ;
    rdfs:label "Regulation"@en,
        "Réglementation"@fr ;
    rdfs:comment "Reference regulation for a conformity claim."@en,
        "Réglementation de référence pour une déclaration de conformité."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf schema:Thing ;
    ns1:term_status "stable" .

onto:SecureDataShare a owl:Class ;
    rdfs:label "Secure Data Share"@en,
        "Partage de Données Sécurisé"@fr ;
    rdfs:comment "A secure sharing of DPP data between economic operators via EU Business Wallet (EBW). Includes cryptographic integrity verification and timestamping."@en,
        "Un partage sécurisé de données DPP entre opérateurs économiques via EU Business Wallet (EBW). Inclut la vérification d'intégrité cryptographique et l'horodatage."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets> ;
    rdfs:subClassOf schema:Action ;
    ns1:term_status "stable" .

onto:CompoundIdentifier a owl:Class ;
    rdfs:label "Compound Identifier"@en,
        "Identifiant Composé"@fr ;
    rdfs:comment "A complex identifier combining a GTIN with a variant, batch, or serial number (Made-to-Order products)."@en,
        "Un identifiant complexe combinant un GTIN avec un variant, lot ou numéro de série (produits sur mesure)."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf schema:PropertyValue ;
    ns1:term_status "stable" .

onto:Metric a owl:Class ;
    rdfs:label "Metric"@en,
        "Métrique"@fr ;
    rdfs:comment "A metric defining actual measured values, optionally including accuracy."@en,
        "Métrique définissant les valeurs mesurées réelles, incluant optionnellement la précision."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf schema:QuantitativeValue ;
    ns1:term_status "stable" .

onto:ServiceRequest a owl:Class ;
    rdfs:label "Service Request"@en,
        "Demande de Service"@fr ;
    rdfs:comment "A request for after-sales service (SAV) for a product."@en,
        "Une demande de service après-vente (SAV) pour un produit."@fr ;
    rdfs:subClassOf schema:Service .

onto:TraceabilityPerformance a owl:Class ;
    rdfs:label "Traceability Performance"@en,
        "Performance Traçabilité"@fr ;
    rdfs:comment "Traceability information for a specific value chain process. Aligned with UNTP DPP."@en,
        "Information de traçabilité pour un processus spécifique de la chaîne de valeur. Aligné avec UNTP DPP."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    rdfs:subClassOf schema:Thing ;
    ns1:term_status "stable" .

onto:MaterialProvenance a owl:Class ;
    rdfs:label "Material Provenance"@en,
        "Provenance des Matériaux"@fr ;
    rdfs:comment "Information about material provenance: name, mass fraction, origin country. Aligned with UNTP DPP-03."@en,
        "Information sur la provenance d'un matériau : nom, fraction massique, pays d'origine. Aligné avec UNTP DPP-03."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    rdfs:subClassOf schema:Thing ;
    ns1:term_status "stable" .

onto:ReplacementPart a owl:Class ;
    rdfs:label "Replacement Part"@en,
        "Pièce de Rechange"@fr ;
    rdfs:comment "A part used to replace a component in a product during repair or maintenance."@en,
        "Une pièce utilisée pour remplacer un composant dans un produit lors d'une réparation ou maintenance."@fr ;
    rdfs:subClassOf schema:Product .

onto:EmissionsPerformance a owl:Class ;
    rdfs:label "Emissions Performance"@en,
        "Performance Émissions"@fr ;
    rdfs:comment "Greenhouse gas emissions scorecard for a product. Aligned with UNTP DPP."@en,
        "Tableau de bord des émissions de gaz à effet de serre du produit. Aligné avec UNTP DPP."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    rdfs:subClassOf schema:QuantitativeValue ;
    ns1:term_status "stable" .

onto:Standard a owl:Class ;
    rdfs:label "Standard"@en,
        "Standard"@fr ;
    rdfs:comment "Standard, norm, or reference scheme for a conformity claim."@en,
        "Standard, norme ou schéma de référence pour une déclaration de conformité."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf schema:Thing ;
    ns1:term_status "stable" .

onto:Warranty a owl:Class ;
    rdfs:label "Warranty"@en,
        "Garantie"@fr ;
    rdfs:comment "A warranty covering a product, which can be of different types (manufacturer, retailer, extension, maintenance)."@en,
        "Une garantie couvrant un produit, qui peut être de différents types (constructeur, distributeur, extension, maintenance)."@fr ;
    rdfs:subClassOf schema:WarrantyScope .

onto:WorkOrder a owl:Class ;
    rdfs:label "Work Order"@en,
        "Ordre de Travail"@fr ;
    rdfs:comment "An order for work to be performed on a product (repair, maintenance, etc.)."@en,
        "Un ordre de travail à effectuer sur un produit (réparation, maintenance, etc.)."@fr ;
    rdfs:subClassOf schema:Service .

onto:EconomicOperator a owl:Class ;
    rdfs:label "Economic Operator"@en,
        "Opérateur Économique"@fr ;
    rdfs:comment "An economic operator in the value chain (manufacturer, importer, distributor, dealer, repairer) as per EU ESPR regulation. Can be authenticated via EU Business Wallet (EBW) with EUID (European Unique Identifier)."@en,
        "Un opérateur économique dans la chaîne de valeur (fabricant, importateur, distributeur, revendeur, réparateur) selon la réglementation européenne ESPR. Peut être authentifié via EU Business Wallet (EBW) avec EUID (European Unique Identifier)."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets> ;
    rdfs:subClassOf schema:Organization ;
    ns1:term_status "stable" .

onto:SecureLink a owl:Class ;
    rdfs:label "Secure Link"@en,
        "Lien Sécurisé"@fr ;
    rdfs:comment "A secure link with hash digest and encryption method for verification."@en,
        "Lien sécurisé avec digest de hash et méthode de cryptage pour vérification."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf schema:URL ;
    ns1:term_status "stable" .

onto:CircularityPerformance a owl:Class ;
    rdfs:label "Circularity Performance"@en,
        "Performance Circularité"@fr ;
    rdfs:comment "Product circularity scorecard. Aligned with UNTP DPP."@en,
        "Tableau de bord de la circularité du produit. Aligné avec UNTP DPP."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>,
        <https://www.ellenmacarthurfoundation.org/resources/apply/material-circularity-indicator> ;
    rdfs:subClassOf schema:Thing ;
    ns1:term_status "stable" .

onto:ConformityClaim a owl:Class ;
    rdfs:label "Conformity Claim"@en,
        "Déclaration de Conformité"@fr ;
    rdfs:comment "Claim of conformity to a standard or regulation. Aligned with UNTP DPP."@en,
        "Déclaration de conformité à un standard ou réglementation. Aligné avec UNTP DPP."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    rdfs:subClassOf schema:Claim ;
    ns1:term_status "stable" .

onto:Intervention a owl:Class ;
    rdfs:label "Intervention"@en,
        "Intervention"@fr ;
    rdfs:comment "A technical intervention on a product (diagnostic, repair, maintenance, replacement, return to manufacturer)."@en,
        "Une intervention technique sur un produit (diagnostic, réparation, maintenance, remplacement, retour fabricant)."@fr ;
    rdfs:subClassOf onto:RepairEvent .

onto:ProductPassport a owl:Class ;
    rdfs:label "Product Passport"@en,
        "Passeport Produit"@fr ;
    rdfs:comment "A Digital Product Passport that tracks a product throughout its entire lifecycle."@en,
        "Un Passeport Produit Numérique qui suit un produit tout au long de son cycle de vie."@fr ;
    rdfs:subClassOf schema:Product .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "Verisav Digital Product Passport Vocabulary"@en,
        "Vocabulaire Passeport Produit Numérique Verisav"@fr ;
    ns2:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2025-12-16"^^xsd:date ;
    dcterms:creator [ a foaf:Person ;
            rdfs:seeAlso <https://orcid.org/0009-0001-0356-4421>,
                <https://www.linkedin.com/in/kévinboutillier>,
                <https://www.verisav.fr/en/founders/kevin-boutillier> ;
            foaf:name "Kévin Boutillier" ] ;
    dcterms:description "Vocabulary for Digital Product Passports (DPP) managing product lifecycle, warranties, repairs, and compliance with EU regulations (ESPR EU 2024/1781). Aligned with GS1 Digital Link standards, UNTP (United Nations Transparency Protocol) for sustainability and traceability, and EU Business Wallet (EBW) for verifiable credentials and enterprise identity. Includes GTIN, GLN, granularity (model/batch/serial), compound identifier support, material provenance, emissions, circularity, conformity claims, W3C Verifiable Credentials (VCDM 2.0), and EUID (European Unique Identifier) support."@en,
        "Vocabulaire pour les Passeports Produit Numérique (DPP) gérant le cycle de vie des produits, garanties, réparations et conformité avec les réglementations européennes (ESPR EU 2024/1781). Aligné avec les standards GS1 Digital Link, UNTP (United Nations Transparency Protocol) pour la durabilité et la traçabilité, et EU Business Wallet (EBW) pour les credentials vérifiables et l'identité d'entreprise. Inclut GTIN, GLN, granularité (modèle/lot/série), support des identifiants composés, provenance des matériaux, émissions, circularité, déclarations de conformité, W3C Verifiable Credentials (VCDM 2.0), et support EUID (European Unique Identifier)."@fr ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-01-23"^^xsd:date ;
    dcterms:publisher <https://www.verisav.fr> ;
    dcterms:rights "Copyright © 2025 Verisav SAS. All rights reserved."@en,
        "Copyright © 2025 Verisav SAS. Tous droits réservés."@fr ;
    dcterms:title "Verisav DPP Vocabulary"@en ;
    vann:preferredNamespacePrefix "dpp" ;
    vann:preferredNamespaceUri "https://ns.verisav.fr/dpp#" ;
    rdfs:comment "This vocabulary is accessible via GraphQL API at https://www.verisav.fr/api/graphql. Use the 'vocabulary(id: \"dpp\")' query to access DPP vocabulary data."@en,
        "This vocabulary is aligned with UNTP DPP specification for sustainability and traceability, EU Business Wallet (EBW) for verifiable credentials and enterprise identity, while maintaining a specific focus on after-sales service (SAV)."@en,
        "Version 1.2.0 (2026-01-23): Added EU Business Wallet (EBW) support - VerifiableProductPassport, VerifiableCredential, EUID support for EconomicOperator, SecureDataShare. Version 1.1.0 (2025-01-XX): Added UNTP alignment - Material Provenance, Product Classification, Emissions Performance, Circularity Performance, Conformity Claims, Traceability Events. Initial release (1.0.0) with GS1 Digital Link alignment and ESPR (EU 2024/1781) support. Added properties: gs1DigitalLink, hasGln, hasGtin, granularityLevel, batchLotNumber, versionNumber. Added classes: EconomicOperator, Facility, CompoundIdentifier."@en,
        "Ce vocabulaire est accessible via l'API GraphQL à https://www.verisav.fr/api/graphql. Utilisez la requête 'vocabulary(id: \"dpp\")' pour accéder aux données du vocabulaire DPP."@fr,
        "Ce vocabulaire est aligné avec la spécification UNTP DPP pour la durabilité et la traçabilité, EU Business Wallet (EBW) pour les credentials vérifiables et l'identité d'entreprise, tout en conservant un focus spécifique sur le service après-vente (SAV)."@fr,
        "Version 1.2.0 (2026-01-23): Ajout support EU Business Wallet (EBW) - VerifiableProductPassport, VerifiableCredential, support EUID pour EconomicOperator, SecureDataShare. Version 1.1.0 (2025-01-XX): Ajout alignement UNTP - Provenance Matériaux, Classification Produit, Performance Émissions, Performance Circularité, Déclarations Conformité, Événements Traçabilité. Version initiale (1.0.0) avec alignement GS1 Digital Link et support ESPR (EU 2024/1781). Propriétés ajoutées : gs1DigitalLink, hasGln, hasGtin, granularityLevel, batchLotNumber, versionNumber. Classes ajoutées : EconomicOperator, Facility, CompoundIdentifier."@fr ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>,
        <https://untp.unece.org/docs/specification/DigitalProductPassport/>,
        <https://www.gs1.org/standards/Digital-Link/>,
        <https://www.gs1.org/standards/id-keys>,
        <https://www.w3.org/TR/vc-data-model-2.0/> ;
    owl:imports schema: ;
    owl:versionInfo "1.2.0" ;
    dcat:accessURL <https://www.verisav.fr/api/graphql> ;
    dcat:distribution [ a dcat:Distribution ;
            dcterms:format "application/ld+json" ;
            dcterms:title "DPP Vocabulary (JSON-LD via API)"@en ;
            dcat:accessURL <https://www.verisav.fr/api/dpp/dpp.jsonld> ],
        [ a dcat:Distribution ;
            dcterms:format "application/ld+json" ;
            dcat:downloadURL <https://ns.verisav.fr/dpp/dpp.jsonld> ],
        [ a dcat:Distribution ;
            dcterms:format "application/rdf+xml" ;
            dcat:downloadURL <https://ns.verisav.fr/dpp/dpp.xml> ],
        [ a dcat:Distribution ;
            dcterms:description "GraphQL API for querying all Verisav vocabularies (DPP, RMA, WTY). Supports introspection, multilingual labels, and real-time vocabulary access."@en,
                "API GraphQL pour interroger tous les vocabulaires Verisav (DPP, RMA, WTY). Supporte l'introspection, les labels multilingues et l'accès en temps réel aux vocabulaires."@fr ;
            dcterms:format "application/graphql" ;
            dcterms:title "Verisav Vocabularies GraphQL API"@en,
                "API GraphQL Vocabulaires Verisav"@fr ;
            dcat:accessURL <https://www.verisav.fr/api/graphql> ;
            dcat:endpointURL <https://www.verisav.fr/api/graphql> ],
        [ a dcat:Distribution ;
            dcterms:format "text/turtle" ;
            dcat:downloadURL <https://ns.verisav.fr/dpp/dpp.ttl> ] ;
    dcat:endpointURL <https://www.verisav.fr/api/graphql> ;
    schema:potentialAction [ a schema:SearchAction ;
            schema:query-input "required name=query" ;
            schema:target <https://www.verisav.fr/api/v1/vocabulary/dpp/search?q=%7Bquery%7D> ] .

