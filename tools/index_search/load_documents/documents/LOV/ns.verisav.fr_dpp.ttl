@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <https://ns.verisav.fr/dpp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:accuracy a owl:DatatypeProperty ;
    rdfs:label "accuracy"@en,
        "précision"@fr ;
    rdfs:comment "Accuracy or uncertainty of the metric value (optional)."@en,
        "Précision ou incertitude de la valeur de la métrique (optionnel)."@fr ;
    rdfs:domain onto:Metric ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal ;
    ns1:term_status "stable" .

onto:assessmentCriteria a owl:ObjectProperty ;
    rdfs:label "assessment criteria"@en,
        "critères d'évaluation"@fr ;
    rdfs:comment "Criteria within the standard or regulation against which the claim is evaluated."@en,
        "Critères dans le standard ou réglementation contre lesquels la déclaration est évaluée."@fr ;
    rdfs:domain onto:ConformityClaim ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Criterion ;
    ns1:term_status "stable" .

onto:assessmentDate a owl:DatatypeProperty ;
    rdfs:label "assessment date"@en,
        "date d'évaluation"@fr ;
    rdfs:comment "Date when the claim was assessed."@en,
        "Date à laquelle la déclaration a été évaluée."@fr ;
    rdfs:domain onto:ConformityClaim ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:date ;
    ns1:term_status "stable" .

onto:batchLotNumber a owl:DatatypeProperty ;
    rdfs:label "Batch/Lot Number"@en,
        "Numéro de Lot"@fr ;
    rdfs:comment "The batch or lot number (GS1 AI 10) for production batches. Used with GTIN for batch-level granularity."@en,
        "Le numéro de lot ou batch (GS1 AI 10) pour les lots de production. Utilisé avec GTIN pour la granularité au niveau lot."@fr ;
    rdfs:domain onto:CompoundIdentifier,
        onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.gs1.org/standards/barcodes/application-identifiers/10> ;
    ns1:term_status "stable" .

onto:belongsTo a owl:ObjectProperty ;
    rdfs:label "belongs to"@en,
        "appartient à"@fr ;
    rdfs:comment "Inverse property: links a WorkOrder or Intervention to its ProductPassport."@en,
        "Propriété inverse : lie un WorkOrder ou Intervention à son ProductPassport."@fr ;
    rdfs:domain onto:Intervention,
        onto:WorkOrder ;
    rdfs:range onto:ProductPassport ;
    owl:inverseOf onto:hasIntervention,
        onto:hasWorkOrder .

onto:carbonFootprint a owl:DatatypeProperty ;
    rdfs:label "carbon footprint"@en,
        "empreinte carbone"@fr ;
    rdfs:comment "Carbon footprint of the product in kg CO2eq per declared unit."@en,
        "Empreinte carbone du produit en kg CO2eq par unité déclarée."@fr ;
    rdfs:domain onto:EmissionsPerformance ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal ;
    ns1:term_status "stable" .

onto:claimDescription a owl:DatatypeProperty ;
    rdfs:label "claim description"@en,
        "description de la réclamation"@fr ;
    rdfs:comment "A description of the service request or claim."@en,
        "Une description de la demande de service ou réclamation."@fr ;
    rdfs:domain onto:ServiceRequest ;
    rdfs:range xsd:string .

onto:claimPriority a owl:DatatypeProperty ;
    rdfs:label "claim priority"@en,
        "priorité de la réclamation"@fr ;
    rdfs:comment "The priority of the service request (normal, high, urgent)."@en,
        "La priorité de la demande de service (normal, haute, urgente)."@fr ;
    rdfs:domain onto:ServiceRequest ;
    rdfs:range xsd:string .

onto:claimStatus a owl:DatatypeProperty ;
    rdfs:label "claim status"@en,
        "statut de la réclamation"@fr ;
    rdfs:comment "The status of a service request (soumise, en_cours, approuvee, resolue)."@en,
        "Le statut d'une demande de service (soumise, en cours, approuvée, résolue)."@fr ;
    rdfs:domain onto:ServiceRequest ;
    rdfs:range xsd:string .

onto:classificationCode a owl:DatatypeProperty ;
    rdfs:label "classification code"@en,
        "code de classification"@fr ;
    rdfs:comment "Classification code according to the specified scheme."@en,
        "Code de classification selon le schéma spécifié."@fr ;
    rdfs:domain onto:ProductClassification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:classificationScheme a owl:DatatypeProperty ;
    rdfs:label "classification scheme"@en,
        "schéma de classification"@fr ;
    rdfs:comment "URI or identifier of the classification scheme (e.g., 'UN-CPC', 'GS1', 'NACE')."@en,
        "URI ou identifiant du schéma de classification (ex: 'UN-CPC', 'GS1', 'NACE')."@fr ;
    rdfs:domain onto:ProductClassification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:conformance a owl:DatatypeProperty ;
    rdfs:label "conformance"@en,
        "conformité"@fr ;
    rdfs:comment "Indicates whether the product meets the specified criteria (true/false)."@en,
        "Indique si le produit est conforme aux critères spécifiés (true/false)."@fr ;
    rdfs:domain onto:ConformityClaim ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    ns1:term_status "stable" .

onto:conformityEvidence a owl:ObjectProperty ;
    rdfs:label "conformity evidence"@en,
        "preuve de conformité"@fr ;
    rdfs:comment "Link to second or third party attestation, such as a UNTP Digital Conformity Credential, PDF, or other evidence format."@en,
        "Lien vers attestation de deuxième ou troisième partie, comme un Digital Conformity Credential UNTP, PDF, ou autre format de preuve."@fr ;
    rdfs:domain onto:ConformityClaim ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document,
        onto:SecureLink ;
    ns1:term_status "stable" .

onto:conformityTopic a owl:DatatypeProperty ;
    rdfs:label "conformity topic"@en,
        "thème de conformité"@fr ;
    rdfs:comment "Topic category of the claim (e.g., 'environment.emissions', 'social.working_conditions')."@en,
        "Catégorie thématique de la déclaration (ex: 'environment.emissions', 'social.working_conditions')."@fr ;
    rdfs:domain onto:ConformityClaim ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:credentialIssuer a owl:ObjectProperty ;
    rdfs:label "credential issuer"@en,
        "émetteur de credential"@fr ;
    rdfs:comment "The authority or EconomicOperator that issued a VerifiableCredential via EU Business Wallet (EBW)."@en,
        "L'autorité ou Opérateur Économique qui a émis un VerifiableCredential via EU Business Wallet (EBW)."@fr ;
    rdfs:domain onto:ConformityClaim,
        onto:VerifiableCredential ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:EconomicOperator ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets> ;
    ns1:term_status "stable" .

onto:criterionId a owl:DatatypeProperty ;
    rdfs:label "criterion ID"@en,
        "ID critère"@fr ;
    rdfs:comment "Unique identifier for the criterion (typically a URI)."@en,
        "Identifiant unique du critère (typiquement une URI)."@fr ;
    rdfs:domain onto:Criterion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI ;
    ns1:term_status "stable" .

onto:criterionName a owl:DatatypeProperty ;
    rdfs:label "criterion name"@en,
        "nom du critère"@fr ;
    rdfs:comment "Name of the criterion."@en,
        "Nom du critère."@fr ;
    rdfs:domain onto:Criterion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:dataIntegrityHash a owl:DatatypeProperty ;
    rdfs:label "data integrity hash"@en,
        "hash d'intégrité des données"@fr ;
    rdfs:comment "Cryptographic hash digest ensuring the integrity of shared DPP data via EU Business Wallet (EBW). Used in SecureDataShare for tamper detection."@en,
        "Digest de hash cryptographique garantissant l'intégrité des données DPP partagées via EU Business Wallet (EBW). Utilisé dans SecureDataShare pour la détection de falsification."@fr ;
    rdfs:domain onto:SecureDataShare ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets> ;
    ns1:term_status "stable" .

onto:declaredUnit a owl:DatatypeProperty ;
    rdfs:label "declared unit"@en,
        "unité déclarée"@fr ;
    rdfs:comment "Unit of measure for carbon footprint (e.g., 'KGM' for kg, 'C62' for unit)."@en,
        "Unité de mesure pour l'empreinte carbone (ex: 'KGM' pour kg, 'C62' pour unité)."@fr ;
    rdfs:domain onto:EmissionsPerformance ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:declaredValue a owl:ObjectProperty ;
    rdfs:label "declared value"@en,
        "valeur déclarée"@fr ;
    rdfs:comment "Actual measured values, optionally including accuracy."@en,
        "Valeurs mesurées réelles, incluant optionnellement la précision."@fr ;
    rdfs:domain onto:ConformityClaim ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Metric ;
    ns1:term_status "stable" .

onto:diagnosticDescription a owl:DatatypeProperty ;
    rdfs:label "diagnostic description"@en,
        "description du diagnostic"@fr ;
    rdfs:comment "A description of the diagnostic process and findings."@en,
        "Une description du processus de diagnostic et des résultats."@fr ;
    rdfs:domain onto:Diagnostic ;
    rdfs:range xsd:string .

onto:diagnosticResult a owl:DatatypeProperty ;
    rdfs:label "diagnostic result"@en,
        "résultat du diagnostic"@fr ;
    rdfs:comment "The result or conclusion of the diagnostic."@en,
        "Le résultat ou conclusion du diagnostic."@fr ;
    rdfs:domain onto:Diagnostic ;
    rdfs:range xsd:string .

onto:encryptionMethod a owl:DatatypeProperty ;
    rdfs:label "encryption method"@en,
        "méthode de cryptage"@fr ;
    rdfs:comment "Encryption method if applicable (e.g., 'AES', 'none')."@en,
        "Méthode de cryptage si applicable (ex: 'AES', 'none')."@fr ;
    rdfs:domain onto:SecureLink ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:euid a owl:DatatypeProperty ;
    rdfs:label "European Unique Identifier (EUID)"@en,
        "Identifiant Unique Européen (EUID)"@fr ;
    rdfs:comment "The European Unique Identifier (EUID) for a legal entity, issued via EU Business Wallet (EBW). Provides a unified digital identity across all 27 EU member states."@en,
        "L'Identifiant Unique Européen (EUID) pour une entité légale, émis via EU Business Wallet (EBW). Fournit une identité numérique unifiée dans les 27 États membres de l'UE."@fr ;
    rdfs:domain onto:EconomicOperator ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets> ;
    ns1:term_status "stable" .

onto:follows a owl:ObjectProperty ;
    rdfs:label "follows"@en,
        "suit"@fr ;
    rdfs:comment "Links an Intervention to a previous Intervention (creates a chain of interventions)."@en,
        "Lie une Intervention à une Intervention précédente (crée une chaîne d'interventions)."@fr ;
    rdfs:domain onto:Intervention ;
    rdfs:range onto:Intervention .

onto:granularityLevel a owl:DatatypeProperty ;
    rdfs:label "Granularity Level"@en,
        "Niveau de Granularité"@fr ;
    rdfs:comment "The level of identification granularity: 'model' (GTIN only), 'batch' (GTIN + batch/lot number), or 'serial' (GTIN + serial number). Determined by EU delegated acts per product category."@en,
        "Le niveau de granularité d'identification : 'model' (GTIN seul), 'batch' (GTIN + numéro de lot), ou 'serial' (GTIN + numéro de série). Déterminé par les actes délégués UE par catégorie de produit."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:gs1DigitalLink a owl:DatatypeProperty ;
    rdfs:label "GS1 Digital Link URI"@en,
        "URI GS1 Digital Link"@fr ;
    rdfs:comment "The standard GS1 Digital Link URI for the product, resolving to the DPP. Uses uncompressed GS1 Digital Link URI syntax per GS1 standards."@en,
        "L'URI standard GS1 Digital Link pour le produit, résolvant vers le DPP. Utilise la syntaxe GS1 Digital Link URI non compressée selon les standards GS1."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso <https://www.gs1.org/standards/Digital-Link/> ;
    ns1:term_status "stable" .

onto:hasCircularityScorecard a owl:ObjectProperty ;
    rdfs:label "has circularity scorecard"@en,
        "a pour tableau de bord circularité"@fr ;
    rdfs:comment "Links a ProductPassport to its circularity scorecard. Aligned with UNTP DPP."@en,
        "Lie un ProductPassport à son tableau de bord de circularité. Aligné avec UNTP DPP."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:CircularityPerformance ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    ns1:term_status "stable" .

onto:hasCompoundIdentifier a owl:ObjectProperty ;
    rdfs:label "has compound identifier"@en,
        "a pour identifiant composé"@fr ;
    rdfs:comment "Links a ProductPassport to a CompoundIdentifier (GTIN + variant/batch/serial)."@en,
        "Lie un ProductPassport à un Identifiant Composé (GTIN + variant/lot/série)."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:CompoundIdentifier .

onto:hasConformityClaim a owl:ObjectProperty ;
    rdfs:label "has conformity claim"@en,
        "a pour déclaration de conformité"@fr ;
    rdfs:comment "Links a ProductPassport to a conformity claim. Aligned with UNTP DPP."@en,
        "Lie un ProductPassport à une déclaration de conformité. Aligné avec UNTP DPP."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ConformityClaim ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    ns1:term_status "stable" .

onto:hasConstituentProduct a owl:ObjectProperty ;
    rdfs:label "has constituent product"@en,
        "a pour produit constituant"@fr ;
    rdfs:comment "Link to a DPP of a constituent product in the value chain. Enables multi-level traceability."@en,
        "Lien vers un DPP de produit constituant dans la chaîne de valeur. Permet la traçabilité multi-niveau."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ProductPassport ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    ns1:term_status "stable" .

onto:hasConsumer a owl:ObjectProperty ;
    rdfs:label "has consumer"@en,
        "a pour consommateur"@fr ;
    rdfs:comment "Links a ProductPassport to its Consumer."@en,
        "Lie un ProductPassport à son Consommateur."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:Consumer .

onto:hasCurrentStatus a owl:ObjectProperty ;
    rdfs:label "has current status"@en,
        "a pour statut actuel"@fr ;
    rdfs:comment "Links a ProductPassport to its current ProductStatus."@en,
        "Lie un ProductPassport à son ProductStatus actuel."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:ProductStatus .

onto:hasDiagnostic a owl:ObjectProperty ;
    rdfs:label "has diagnostic"@en,
        "a pour diagnostic"@fr ;
    rdfs:comment "Links an Intervention to a Diagnostic."@en,
        "Lie une Intervention à un Diagnostic."@fr ;
    rdfs:domain onto:Intervention ;
    rdfs:range onto:Diagnostic .

onto:hasDocument a owl:ObjectProperty ;
    rdfs:label "has document"@en,
        "a pour document"@fr ;
    rdfs:comment "Links a ProductPassport to a Document."@en,
        "Lie un ProductPassport à un Document."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:Document .

onto:hasEconomicOperator a owl:ObjectProperty ;
    rdfs:label "has economic operator"@en,
        "a pour opérateur économique"@fr ;
    rdfs:comment "Links a ProductPassport to its EconomicOperator (manufacturer, importer, distributor, etc.)."@en,
        "Lie un ProductPassport à son Opérateur Économique (fabricant, importateur, distributeur, etc.)."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:EconomicOperator .

onto:hasEmissionsScorecard a owl:ObjectProperty ;
    rdfs:label "has emissions scorecard"@en,
        "a pour tableau de bord émissions"@fr ;
    rdfs:comment "Links a ProductPassport to its emissions scorecard. Aligned with UNTP DPP."@en,
        "Lie un ProductPassport à son tableau de bord d'émissions. Aligné avec UNTP DPP."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:EmissionsPerformance ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    ns1:term_status "stable" .

onto:hasFacility a owl:ObjectProperty ;
    rdfs:label "has facility"@en,
        "a pour installation"@fr ;
    rdfs:comment "Links a ProductPassport to the Facility where it was produced."@en,
        "Lie un ProductPassport à l'Installation où il a été produit."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:Facility .

onto:hasGln a owl:DatatypeProperty ;
    rdfs:label "Global Location Number (GLN)"@en,
        "Code Lieu International (GLN)"@fr ;
    rdfs:comment "The GS1 Global Location Number identifying the organization or facility. Used for economic operators and facilities per EU ESPR regulation."@en,
        "Le Code Lieu International GS1 identifiant l'organisation ou l'installation. Utilisé pour les opérateurs économiques et installations selon la réglementation européenne ESPR."@fr ;
    rdfs:domain onto:EconomicOperator,
        onto:Facility,
        schema:Organization,
        schema:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.gs1.org/standards/id-keys/gln> ;
    rdfs:subPropertyOf schema:globalLocationNumber ;
    ns1:term_status "stable" .

onto:hasGtin a owl:DatatypeProperty ;
    rdfs:label "Global Trade Item Number (GTIN)"@en,
        "Numéro d'Article Global (GTIN)"@fr ;
    rdfs:comment "The GS1 Global Trade Item Number (GTIN) in one of the formats: GTIN-8, GTIN-12, GTIN-13, or GTIN-14. Used with AI (01) for Made-to-Stock products or AI (03) for Made-to-Order products."@en,
        "Le Numéro d'Article Global GS1 (GTIN) dans l'un des formats : GTIN-8, GTIN-12, GTIN-13 ou GTIN-14. Utilisé avec AI (01) pour produits Made-to-Stock ou AI (03) pour produits Made-to-Order."@fr ;
    rdfs:domain onto:CompoundIdentifier,
        onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.gs1.org/standards/id-keys/gtin> ;
    rdfs:subPropertyOf schema:gtin ;
    ns1:term_status "stable" .

onto:hasLifecycleStage a owl:ObjectProperty ;
    rdfs:label "has lifecycle stage"@en,
        "a pour étape de cycle de vie"@fr ;
    rdfs:comment "Links a ProductPassport to a ProductLifecycleStage."@en,
        "Lie un ProductPassport à une Étape du Cycle de Vie."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:ProductLifecycleStage .

onto:hasManufacturer a owl:ObjectProperty ;
    rdfs:label "has manufacturer"@en,
        "a pour fabricant"@fr ;
    rdfs:comment "Links a ProductPassport to its Manufacturer."@en,
        "Lie un ProductPassport à son Fabricant."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:Manufacturer .

onto:hasMaterialProvenance a owl:ObjectProperty ;
    rdfs:label "has material provenance"@en,
        "a pour provenance de matériau"@fr ;
    rdfs:comment "Links a ProductPassport to material provenance information. Aligned with UNTP DPP-03."@en,
        "Lie un ProductPassport à des informations de provenance des matériaux. Aligné avec UNTP DPP-03."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:MaterialProvenance ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    ns1:term_status "stable" .

onto:hasProductClassification a owl:ObjectProperty ;
    rdfs:label "has product classification"@en,
        "a pour classification produit"@fr ;
    rdfs:comment "Links a ProductPassport to product classification. Aligned with UNTP DPP-02."@en,
        "Lie un ProductPassport à une classification produit. Aligné avec UNTP DPP-02."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ProductClassification ;
    rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/> ;
    ns1:term_status "stable" .

onto:hasRecyclingInstructions a owl:ObjectProperty ;
    rdfs:label "has recycling instructions"@en,
        "a pour consignes de recyclage"@fr ;
    rdfs:comment "Links a ProductPassport to RecyclingInstructions."@en,
        "Lie un ProductPassport à des Consignes de Recyclage."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:RecyclingInstructions .

onto:hasRepairer a owl:ObjectProperty ;
    rdfs:label "has repairer"@en,
        "a pour réparateur"@fr ;
    rdfs:comment "Links an Intervention to its Repairer."@en,
        "Lie une Intervention à son Réparateur."@fr ;
    rdfs:domain onto:Intervention ;
    rdfs:range onto:Repairer .

onto:hasReplacementPart a owl:ObjectProperty ;
    rdfs:label "has replacement part"@en,
        "a pour pièce de rechange"@fr ;
    rdfs:comment "Links an Intervention to a ReplacementPart."@en,
        "Lie une Intervention à une Pièce de Rechange."@fr ;
    rdfs:domain onto:Intervention ;
    rdfs:range onto:ReplacementPart .

onto:hasRetailer a owl:ObjectProperty ;
    rdfs:label "has retailer"@en,
        "a pour distributeur"@fr ;
    rdfs:comment "Links a ProductPassport to its Retailer."@en,
        "Lie un ProductPassport à son Distributeur."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:Retailer .

onto:hasSecureDataShare a owl:ObjectProperty ;
    rdfs:label "has secure data share"@en,
        "a pour partage de données sécurisé"@fr ;
    rdfs:comment "Links a ProductPassport to a SecureDataShare action via EU Business Wallet (EBW)."@en,
        "Lie un ProductPassport à une action SecureDataShare via EU Business Wallet (EBW)."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SecureDataShare ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets> ;
    ns1:term_status "stable" .

onto:hasServiceRequest a owl:ObjectProperty ;
    rdfs:label "has service request"@en,
        "a pour demande de service"@fr ;
    rdfs:comment "Links a ProductPassport to a ServiceRequest."@en,
        "Lie un ProductPassport à une Demande de Service."@fr ;
    rdfs:domain onto:ProductPassport ;
    rdfs:range onto:ServiceRequest .

onto:hasTraceabilityEvent a owl:ObjectProperty ;
    rdfs:label "has traceability event"@en,
        "a pour événement de traçabilité"@fr ;
    rdfs:comment "Links a ProductPassport or TraceabilityPerformance to a traceability event. Aligned with UNTP DPP-06."@en,
        "Lie un ProductPassport ou TraceabilityPerformance à un événement de traçabilité. Aligné avec UNTP DPP-06."@fr ;
    rdfs:domain onto:ProductPassport,
        onto:TraceabilityPerformance ;
    rdfs:isDefinedBy onto: ;
