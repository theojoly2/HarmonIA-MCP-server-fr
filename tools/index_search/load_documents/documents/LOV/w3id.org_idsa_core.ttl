ns2: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual ;
    dcterms:created "2017-09-26"^^xsd:date ;
    dcterms:modified "2020-08-10"^^xsd:date ;
    dcterms:publisher ns2:IDSA ;
    dcterms:title "The International Data Spaces Information Model"@en .

ns2:AppRegistrationRequestMessage a owl:Class ;
    rdfs:label "App Registration Request Message"@en ;
    rdfs:comment "Message that asks for registration or update of a data app to the App Store. Payload contains app-related metadata (instance of class ids:AppResource). Message header may contain an app identifier parameter of a prior registered data app. If the app identifier is supplied, the message should be interpreted as a registration for an app update. Otherwise this message is used to register a new app. "@en ;
    rdfs:subClassOf ns2:RequestMessage .

ns2:AppRepresentation a owl:Class ;
    rdfs:label "App Representation"@en ;
    rdfs:comment "App representation"@en ;
    rdfs:subClassOf ns2:SoftwareRepresentation .

ns2:AppResource a owl:Class ;
    rdfs:label "App Resource"@en ;
    rdfs:comment "Resource comprising IDS data apps."@en ;
    rdfs:subClassOf ns2:Resource .

ns2:AppUploadMessage a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:UploadMessage ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:appArtifactReference ] .

ns2:ArtifactRequestMessage a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:RequestMessage ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:requestedArtifact ] .

ns2:AudioRepresentation a owl:Class ;
    rdfs:label "Audio Representation"@en ;
    rdfs:comment "Audio representation"@en ;
    rdfs:subClassOf ns2:Representation .

ns2:BoundingPolygon a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Geometry ;
    ns1:validation [ ns1:constraint ns1:NotEmpty ;
            ns1:forProperty ns2:geoPoint ;
            ns1:relationType ns1:OneToMany ] .

ns2:Broker a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Connector ;
    ns1:validation [ ns1:forProperty ns2:connectorCatalog ;
            ns1:relationType ns1:OneToMany ] .

ns2:ComponentCertification a owl:Class ;
    rdfs:label "Component Certification"@en ;
    rdfs:comment "Process and result of certifying a software component/servivce in order to become a certified part of the International Data Space infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:ComponentCertificationLevel ;
            owl:onProperty ns2:certificationLevel ],
        ns2:Certification ;
    owl:disjointWith ns2:ParticipantCertification .

ns2:Concept a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf skos:Concept ;
    ns1:abstract true .

ns2:ContractRejectionMessage a owl:Class ;
    rdfs:label "Contract Rejection Message"@en ;
    rdfs:comment "Message indicating rejection of a contract."@en ;
    rdfs:subClassOf ns2:RejectionMessage .

ns2:DatPayload a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:JwtPayload ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:referringConnector ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:iss ],
        [ ns1:forProperty ns2:extendedGuarantee ;
            ns1:relationType ns1:OneToMany ] .

ns2:DescriptionRequestMessage a owl:Class ;
    rdfs:label "Description Request Message"@en ;
    rdfs:comment "Message requesting metadata. If no URI is supplied via the ids:requestedElement field, this messages is treated like a self-description request and the recipient should return its self-description via an ids:DescriptionResponseMessage. However, if a URI is supplied, the Connector should either return metadata about the requested element via an ids:DescriptionResponseMessage, or send an ids:RejectionMessage, e.g. because the element was not found."@en ;
    rdfs:subClassOf ns2:RequestMessage .

ns2:DynamicAttributeToken a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Token ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:tokenFormat ] .

ns2:EndToEndRoute a owl:Class ;
    rdfs:label "end to end route"@en ;
    rdfs:comment "\\n    EndToEndRoute hold information about a communication pipelines between apps. An EndToEndRoute should hold\\n    one value for the ids:appRouteStart and/or ids:appRouteEnd properties, so that communication between app endpoints remain distinguishable.\\n    "@en ;
    rdfs:subClassOf ns2:AppRoute .

ns2:EvaluationFacility a owl:Class ;
    rdfs:label "Evaluation Facility"@en ;
    rdfs:comment "Evaluation Facilities carry out the evaluation work during a certification process and issue the corresponding Certifications."@en .

ns2:Geometry a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf <http://www.w3.org/ns/locn#Geometry>,
        ns2:Location ;
    ns1:abstract true .

ns2:HTTPAuthentication a owl:Class ;
    rdfs:label "HTTP Authentication"@en ;
    rdfs:comment "HTTP authentication."@en ;
    rdfs:subClassOf ns2:BasicAuthentication .

ns2:IDSA a dcterms:Agent,
        owl:NamedIndividual,
        foaf:Organization ;
    rdfs:label "International Data Spaces Association" ;
    foaf:homepage <https://www.internationaldataspaces.org> .

ns2:InvokeOperationMessage a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:RequestMessage ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:operationReference ] .

ns2:Named a owl:Class ;
    rdfs:label "Named"@en ;
    rdfs:comment "Entity that is identifiable within a context by means of a name."@en ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:name ] .

ns2:Operation a owl:Class .

ns2:ParIS a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Connector ;
    ns1:validation [ ns1:forProperty ns2:participantCatalog ;
            ns1:relationType ns1:OneToMany ] .

ns2:ParticipantRequestMessage a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:RequestMessage ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:requestedParticipant ] .

ns2:PolicyTemplate a owl:Class .

ns2:Prohibition a owl:Class ;
    rdfs:label "Prohibition"@en ;
    rdfs:comment "The class of Prohibitions as defined in the ODRL ontology."@en ;
    rdfs:subClassOf odrl:Prohibition,
        ns2:Rule .

ns2:SoftwareRepresentation a owl:Class ;
    rdfs:label "Software Representation"@en ;
    rdfs:comment "Software representation"@en ;
    rdfs:subClassOf ns2:Representation .

ns2:TextResource a owl:Class ;
    rdfs:label "Text Resource"@en ;
    rdfs:comment "Resource (at least partially) comprising textual content."@en ;
    rdfs:subClassOf ns2:Resource .

ns2:UploadMessage a owl:Class ;
    rdfs:label "Upload Message"@en ;
    rdfs:comment "Message used to upload a data to a recipient. Payload contains data."@en ;
    rdfs:subClassOf ns2:RequestMessage .

ns2:UploadResponseMessage a owl:Class ;
    rdfs:label "Upload Response Message"@en ;
    rdfs:comment "Message that follows up a UploadMessage and contains the upload confirmation."@en ;
    rdfs:subClassOf ns2:ResponseMessage .

ns2:Value a owl:Class ;
    rdfs:label "Value"@en ;
    rdfs:comment "Literal, inline value instantiation of a representation."@en ;
    rdfs:subClassOf ns2:RepresentationInstance .

ns2:VideoRepresentation a owl:Class ;
    rdfs:label "Video Representation"@en ;
    rdfs:comment "Video representation"@en ;
    rdfs:subClassOf ns2:Representation .

ns2:actionRefinement a owl:ObjectProperty ;
    rdfs:label "action refinement"@en ;
    rdfs:comment "Constraint that refines an Action."@en ;
    rdfs:domain ns2:Action ;
    rdfs:range ns2:Constraint .

ns2:affectedConnector a owl:ObjectProperty ;
    rdfs:domain ns2:ConnectorNotificationMessage ;
    rdfs:range ns2:Connector .

ns2:affectedParticipant a owl:ObjectProperty ;
    rdfs:domain ns2:ParticipantNotificationMessage ;
    rdfs:range ns2:Participant .

ns2:affectedResource a owl:ObjectProperty ;
    rdfs:domain ns2:ResourceNotificationMessage ;
    rdfs:range ns2:Resource .

ns2:and a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:LogicalConstraint ;
    rdfs:range ns2:Constraint ;
    rdfs:subPropertyOf odrl:and .

ns2:appArtifactReference a owl:ObjectProperty ;
    rdfs:domain ns2:AppUploadMessage ;
    rdfs:range ns2:Artifact .

ns2:appEndpoint a owl:ObjectProperty ;
    rdfs:label "app endpoint"@en ;
    rdfs:comment "Endpoints of a data app"@en ;
    rdfs:domain ns2:DataApp ;
    rdfs:range ns2:AppEndpoint .

ns2:appEndpointType a owl:ObjectProperty ;
    rdfs:label "App endpoint type"@en ;
    rdfs:comment "Type of an app endpoint. Data apps have different endpoint types, e.g., for input, output or health status."@en ;
    rdfs:domain ns2:AppEndpoint ;
    rdfs:range ns2:AppEndpointType .

ns2:appRoute a owl:ObjectProperty ;
    rdfs:label "app route" ;
    rdfs:domain ns2:ConfigurationModel ;
    rdfs:range ns2:AppRoute .

ns2:appRouteEnd a owl:ObjectProperty ;
    rdfs:label "app route end"@en ;
    rdfs:comment "End of a route."@en ;
    rdfs:domain ns2:AppRoute ;
    rdfs:range ns2:AppEndpoint .

ns2:appRouteStart a owl:ObjectProperty ;
    rdfs:label "app route start"@en ;
    rdfs:comment "Start of a route."@en ;
    rdfs:domain ns2:AppRoute ;
    rdfs:range ns2:AppEndpoint .

ns2:assignee a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Rule ;
    rdfs:range ns2:Participant ;
    rdfs:subPropertyOf odrl:assignee .

ns2:assigner a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Rule ;
    rdfs:range ns2:Participant ;
    rdfs:subPropertyOf odrl:assigner .

ns2:aud a owl:ObjectProperty ;
    rdfs:label "aud"@en ;
    rdfs:comment "The 'aud' (audience) claim identifies the recipients that the JWT is intended for."@en ;
    rdfs:domain ns2:JwtPayload ;
    rdfs:range ns2:Audience ;
    rdfs:seeAlso <https://tools.ietf.org/html/rfc7519#section-4.1.3> .

ns2:authService a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:AuthInfo ;
    rdfs:range xsd:anyURI .

ns2:begin a owl:ObjectProperty ;
    rdfs:label "beginning"@en ;
    rdfs:comment "Beginning of an Interval."@en ;
    rdfs:domain ns2:Interval ;
    rdfs:range ns2:Instant ;
    rdfs:subPropertyOf time:hasBeginning .

ns2:configurationModelLogLevel a owl:ObjectProperty ;
    rdfs:label "configuration model log level"@en ;
    rdfs:comment "Log level configuration for a Connector which is deployed using the Configuration Model"@en ;
    rdfs:domain ns2:ConfigurationModel ;
    rdfs:range ns2:LogLevel .

ns2:connectorCatalog a owl:ObjectProperty ;
    rdfs:label "connector Catalog"@en ;
    rdfs:comment "Reference to catalog of Connectors, which are listed in the Broker."@en ;
    rdfs:domain ns2:Broker ;
    rdfs:range ns2:ConnectorCatalog .

ns2:connectorDeployMode a owl:ObjectProperty ;
    rdfs:label "connector deploy mode"@en ;
    rdfs:comment "Deply mode of a Connector in the Configuration Model"@en ;
    rdfs:domain ns2:ConfigurationModel ;
    rdfs:range ns2:ConnectorDeployMode .

ns2:connectorProxy a owl:ObjectProperty ;
    rdfs:label "Connector proxy"@en ;
    rdfs:comment "Proxies for a Connector which is deployed using the Configuration Model"@en ;
    rdfs:domain ns2:ConfigurationModel ;
    rdfs:range ns2:Proxy .

ns2:connectorStatus a owl:ObjectProperty ;
    rdfs:label "Connector Status"@en ;
    rdfs:comment "Status of a Connector deployed by the Configuration Model"@en ;
    rdfs:domain ns2:ConfigurationModel ;
    rdfs:range ns2:ConnectorStatus .

ns2:constraint a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Rule ;
    rdfs:range ns2:Constraint ;
    rdfs:subPropertyOf odrl:constraint .

ns2:contract a owl:ObjectProperty ;
    rdfs:label "has contract"@en ;
    rdfs:comment "The target contract defining the usage of the data object."@en ;
    rdfs:domain ns2:UsageControlObject ;
    rdfs:range ns2:ContractAgreement .

ns2:contractOffer a owl:ObjectProperty ;
    rdfs:label "contract offer"@en ;
    rdfs:comment "Reference to a Contract Offer defining the authorized use of the Resource."@en ;
    rdfs:domain ns2:Resource ;
    rdfs:range ns2:ContractOffer .

ns2:contractStart a owl:DatatypeProperty ;
    rdfs:label "Contract start"@en ;
    rdfs:comment "Absolute datetime the Contract is requested, offered or expected to start, depending on the type of Contract."@en ;
    rdfs:domain ns2:Contract ;
    rdfs:range xsd:dateTimeStamp .

ns2:corporateEmailAddress a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Participant ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf foaf:mbox .

ns2:created a owl:DatatypeProperty ;
    rdfs:label "created"@en ;
    rdfs:comment "The date of the creation of the Digital Content. In contrast to the ids:temporalCoverage, creation dates of ids:Representation, ids:Artifacts or any other form of meta-data, this property describes the creation date of referenced Digital Content itself."@en ;
    rdfs:domain [ a owl:Class ] ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:seeAlso dcterms:created ;
    rdfs:subPropertyOf dcterms:issued .

ns2:curator a owl:ObjectProperty ;
    rdfs:domain ns2:InfrastructureComponent ;
    rdfs:range ns2:Participant ;
    rdfs:subPropertyOf dcterms:publisher .

ns2:data a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:UsageControlObject ;
    rdfs:range xsd:anyURI .

ns2:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Explanation of the resource in a natural language text."@en ;
    rdfs:domain ns2:Described ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description .

ns2:emailAddress a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf foaf:mbox .

ns2:endpointDocumentation a owl:DatatypeProperty ;
    rdfs:label "endpoint documentation"@en ;
    rdfs:comment "IRI reference to a documentation of the endpoint,  e.g., reference to an OpenAPI-based documentation."@en ;
    rdfs:domain ns2:Endpoint ;
    rdfs:range xsd:anyURI .

ns2:endpointInformation a owl:DatatypeProperty ;
    rdfs:label "endpoint information"@en ;
    rdfs:comment "Human-readable information and description of the endpoint."@en ;
    rdfs:domain ns2:Endpoint ;
    rdfs:range xsd:string .

ns2:exp a owl:DatatypeProperty ;
    rdfs:label "exp"@en ;
    rdfs:comment "The 'exp' (expiration time) claim identifies the expiration time on or after which the JWT MUST NOT be accepted for processing."@en ;
    rdfs:domain ns2:JwtPayload ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso <https://tools.ietf.org/html/rfc7519#section-4.1.4> .

ns2:geoPoint a owl:ObjectProperty ;
    rdfs:label "geoPoint"@en ;
    rdfs:comment "Refers to a GeoPoint that is member of a BoundingPolygon."@en ;
    rdfs:domain ns2:BoundingPolygon ;
    rdfs:range ns2:GeoPoint .

ns2:hasAgent a owl:ObjectProperty ;
    rdfs:domain ns2:Connector ;
    rdfs:range ns2:Agent .

ns2:hasDefaultEndpoint a owl:ObjectProperty ;
    rdfs:label "has default endpoint"@en ;
    rdfs:comment "Indicates the default endpoint that should be used for basic infrastructure interactions, e.g., providing the self description."@en ;
    rdfs:domain ns2:Connector ;
    rdfs:range ns2:ConnectorEndpoint .

ns2:hasDuration a owl:DatatypeProperty ;
    rdfs:domain ns2:TemporalEntity ;
    rdfs:range xsd:duration .

ns2:hasEndpoint a owl:ObjectProperty ;
    rdfs:label "has endpoint"@en ;
    rdfs:comment "Reference to the Endpoints serving the resource's content or let you exchange messages with an IDS Connector."@en ;
    rdfs:domain ns2:Connector ;
    rdfs:range ns2:ConnectorEndpoint .

ns2:hasState a owl:ObjectProperty ;
    rdfs:label "has state"@en ;
    rdfs:comment "The list of combined current states of the data object."@en ;
    rdfs:domain ns2:UsageControlObject ;
    rdfs:range ns2:ArtifactState .

ns2:iat a owl:DatatypeProperty ;
    rdfs:label "iat"@en ;
    rdfs:comment "The 'iat' (issued at) claim contains the point in time when the JWT was created."@en ;
    rdfs:domain ns2:JwtPayload ;
    rdfs:range xsd:integer .

ns2:inboundModelVersion a owl:DatatypeProperty ;
    rdfs:label "inboundModelVersion"@en ;
    rdfs:comment "Information Model version that the InfrastructureComponent is capable of reading/processing."@en ;
    rdfs:domain ns2:InfrastructureComponent ;
    rdfs:range xsd:string .

ns2:instance a owl:ObjectProperty ;
    rdfs:label "instance"@en ;
    rdfs:comment "Reference to an instance of given representation, i.e. inline value or file placeholder."@en ;
    rdfs:domain ns2:Representation ;
    rdfs:range ns2:RepresentationInstance .

ns2:iss a owl:DatatypeProperty ;
    rdfs:label "iss"@en ;
    rdfs:comment "The 'iss' (issuer) claim identifies the principal that issued the JWT."@en ;
    rdfs:domain ns2:JwtPayload ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://tools.ietf.org/html/rfc7519#section-4.1.1> .

ns2:issued a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Message ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf dcterms:issued .

ns2:issuerConnector a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Message ;
    rdfs:range ns2:Connector .

ns2:keyword a owl:DatatypeProperty ;
    rdfs:label "keyword"@en ;
    rdfs:comment "Controlled keywords that describe the nature, purpose, or use of the content."@en ;
    rdfs:domain ns2:DigitalContent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcat:keyword .

ns2:language a owl:ObjectProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "Natural language(s) used within the content."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns2:AppEndpoint ns2:DigitalContent ns2:Representation ) ] ;
    rdfs:range ns2:Language ;
    rdfs:subPropertyOf dcterms:language .

ns2:latitude a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:GeoPoint ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://www.w3.org/2003/01/geo/wgs84_pos#lat> .

ns2:leftOperand a owl:ObjectProperty ;
    rdfs:label "leftOperand"@en ;
    rdfs:comment "The left operand in a constraint expression."@en ;
    rdfs:domain ns2:Constraint ;
    rdfs:range ns2:LeftOperand ;
    rdfs:subPropertyOf odrl:leftOperand .

ns2:listedConnector a owl:ObjectProperty ;
    rdfs:label "listed Connector"@en ;
    rdfs:comment "A Connector, that is part of a Connector catalog."@en ;
    rdfs:domain ns2:ConnectorCatalog ;
    rdfs:range ns2:Connector ;
    rdfs:subPropertyOf dcat:dataset .

ns2:longitude a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:GeoPoint ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://www.w3.org/2003/01/geo/wgs84_pos#long> .

ns2:maintainer a owl:ObjectProperty ;
    rdfs:domain ns2:InfrastructureComponent ;
    rdfs:range ns2:Participant .

ns2:member a owl:ObjectProperty ;
    rdfs:label "member"@en ;
    rdfs:comment "A Participant, that is part of a participant catalog."@en ;
    rdfs:domain ns2:ParticipantCatalog ;
    rdfs:range ns2:Participant ;
    rdfs:subPropertyOf dcat:dataset .

ns2:memberParticipant a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Participant ;
    rdfs:range ns2:Participant ;
    rdfs:subPropertyOf org:hasMember .

ns2:memberPerson a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Participant ;
    rdfs:range ns2:Person ;
    rdfs:subPropertyOf org:hasMember .

ns2:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version"@en ;
    rdfs:comment "Version of the Information Model against which the Message should be interpreted."@en ;
    rdfs:domain ns2:Message ;
    rdfs:range xsd:string .

ns2:name a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Entity name unique within a specified context."@en ;
    rdfs:domain ns2:Named ;
    rdfs:range xsd:string .

ns2:nbf a owl:DatatypeProperty ;
    rdfs:label "nbf"@en ;
    rdfs:comment "The 'aud' (audience) claim identifies the recipients that the JWT is intended for."@en ;
    rdfs:domain ns2:JwtPayload ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso <https://tools.ietf.org/html/rfc7519#section-4.1.5> .

ns2:noProxy a owl:DatatypeProperty ;
    rdfs:label "no proxy"@en ;
    rdfs:comment "URLs that should be excluded from proxying.GNU emcs documentation contains a good explanation for the usage of noProxy."@en ;
    rdfs:domain ns2:Proxy ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso <https://www.gnu.org/software/emacs/manual/html_node/url/Proxies.html> .

ns2:obligation a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Contract ;
    rdfs:range ns2:Duty ;
    rdfs:subPropertyOf odrl:obligation .

ns2:offeredResource a owl:ObjectProperty ;
    rdfs:label "offered resource"@en ;
    rdfs:comment "A Resource that is part of a resource catalog, indicating an offering (of, e.g., data)."@en ;
    rdfs:domain ns2:ResourceCatalog ;
    rdfs:range ns2:Resource ;
    rdfs:subPropertyOf dcat:dataset .

ns2:operationReference a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:InvokeOperationMessage ;
    rdfs:range ns2:Operation .

ns2:operator a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Constraint ;
    rdfs:range ns2:BinaryOperator ;
    rdfs:subPropertyOf odrl:operator .

ns2:or a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:LogicalConstraint ;
    rdfs:range ns2:Constraint ;
    rdfs:subPropertyOf odrl:or .

ns2:outboundModelVersion a owl:DatatypeProperty ;
    rdfs:label "outbound model version"@en ;
    rdfs:comment "Information Model version being produced by the InfrastructureComponent."@en ;
    rdfs:domain ns2:InfrastructureComponent ;
    rdfs:range xsd:string .

ns2:participantCatalog a owl:ObjectProperty ;
    rdfs:label "participant catalog"@en ;
    rdfs:comment "List of participants a ParIS may expose."@en ;
    rdfs:domain ns2:ParIS ;
    rdfs:range ns2:ParticipantCatalog .

ns2:permission a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Contract ;
    rdfs:range ns2:Permission ;
    rdfs:subPropertyOf odrl:permission .

ns2:phoneNumber a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf foaf:phone .

ns2:postDuty a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Permission ;
    rdfs:range ns2:Duty ;
    rdfs:subPropertyOf odrl:duty .

ns2:preDuty a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Permission ;
    rdfs:range ns2:Duty ;
    rdfs:subPropertyOf odrl:duty .

ns2:prohibition a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Contract ;
    rdfs:range ns2:Prohibition ;
    rdfs:subPropertyOf odrl:prohibition .

ns2:proxyURI a owl:DatatypeProperty ;
    rdfs:label "proxy URI"@en ;
    rdfs:comment "URI of the proxy server."@en ;
    rdfs:domain ns2:Proxy ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso <https://www.gnu.org/software/emacs/manual/html_node/url/Proxies.html> .

ns2:recipientAgent a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Message ;
    rdfs:range ns2:Agent .

ns2:recipientConnector a owl:ObjectProperty ;
    rdfs:domain ns2:Message ;
    rdfs:range ns2:Connector .

ns2:referringConnector a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:JwtPayload ;
    rdfs:range ns2:Connector .

ns2:requestedArtifact a owl:ObjectProperty ;
    rdfs:domain ns2:ArtifactRequestMessage ;
    rdfs:range ns2:Artifact .

ns2:requestedParticipant a owl:ObjectProperty ;
    rdfs:domain ns2:ParticipantRequestMessage ;
    rdfs:range ns2:Participant .

ns2:requestedResource a owl:ObjectProperty ;
    rdfs:label "requested resource"@en ;
    rdfs:comment "A Resource that is part of a resource catalog, indicating a request (of, e.g., data, software,...)."@en ;
    rdfs:domain ns2:ResourceCatalog ;
    rdfs:range ns2:Resource ;
    rdfs:subPropertyOf dcat:dataset .

ns2:resourceCatalog a owl:ObjectProperty ;
    rdfs:label "resource catalog"@en ;
    rdfs:comment "References the Catalog of published or requested resource by this Connector."@en ;
    rdfs:domain ns2:Connector ;
    rdfs:range ns2:ResourceCatalog .

ns2:resourceEndpoint a owl:ObjectProperty ;
    rdfs:label "resource endpoint"@en ;
    rdfs:comment "Reference to the Endpoints serving the resource's content or let you exchange messages with an IDS Connector."@en ;
    rdfs:domain ns2:Resource ;
    rdfs:range ns2:ConnectorEndpoint .

ns2:resourcePart a owl:ObjectProperty ;
    rdfs:label "resource part"@en ;
    rdfs:comment "Reference to a Resource (physically or logically) included, definition of part-whole hierarchies."@en ;
    rdfs:domain ns2:Resource ;
    rdfs:range ns2:Resource ;
    rdfs:subPropertyOf ns2:contentPart .

ns2:routeDeployMethod a owl:DatatypeProperty ;
    rdfs:label "route deploy method"@en ;
    rdfs:comment "Supplementary information about, e.g., the technology used, for routes." ;
    rdfs:domain ns2:AppRoute ;
    rdfs:range xsd:string .

ns2:sample a owl:ObjectProperty ;
    rdfs:label "sample"@en ;
    rdfs:comment "Sample Resource instance."@en ;
    rdfs:domain ns2:Resource ;
    rdfs:range ns2:Resource .

ns2:scope a owl:DatatypeProperty ;
    rdfs:label "scope"@en ;
    rdfs:comment "Currently, the scope is limited to 'Connector' but can be used for scoping purposes in the future. Scope is currently fixed to 'https://w3id.org/idsa/core/Connector'."@en ;
    rdfs:domain ns2:JwtPayload ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://tools.ietf.org/html/rfc7519#section-4.1.2> .

ns2:securityGuarantee a owl:ObjectProperty ;
    rdfs:label "Security guarantee"@en ;
    rdfs:comment "Reference to a security guarantee supported by given profile."@en ;
    rdfs:domain ns2:SecurityProfile ;
    rdfs:range ns2:SecurityGuarantee .

ns2:securityToken a owl:ObjectProperty ;
    rdfs:label "Security token"@en ;
    rdfs:comment "A token representing a claim that the message sender supports a certain security profile."@en ;
    rdfs:domain ns2:Message ;
    rdfs:range ns2:DynamicAttributeToken .

ns2:senderAgent a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Message ;
    rdfs:range ns2:Agent .

ns2:spatialCoverage a owl:ObjectProperty ;
    rdfs:label "spatial coverage"@en ;
    rdfs:comment "Named spatial entity covered by the Resource."@en ;
    rdfs:domain ns2:DigitalContent ;
    rdfs:range ns2:Location ;
    rdfs:subPropertyOf dcterms:spatial .

ns2:sub a owl:DatatypeProperty ;
    rdfs:label "sub"@en ;
    rdfs:comment "The 'sub' (subject) claim identifies the principal that is the subject of the JWT."@en ;
    rdfs:domain ns2:JwtPayload ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://tools.ietf.org/html/rfc7519#section-4.1.2> .

ns2:subRoute a owl:ObjectProperty ;
    rdfs:label "sub route"@en ;
    rdfs:comment "Route between two or more app endpoints inside a app routing pipeline."@en ;
    rdfs:domain ns2:AppRoute ;
    rdfs:range ns2:EndToEndRoute .

ns2:temporalCoverage a owl:ObjectProperty ;
    rdfs:label "temporal coverage"@en ;
    rdfs:comment "Temporal period or instance covered by the content."@en ;
    rdfs:domain ns2:DigitalContent ;
    rdfs:range ns2:TemporalEntity ;
    rdfs:subPropertyOf dcterms:temporal .

ns2:theme a owl:ObjectProperty ;
    rdfs:domain ns2:DigitalContent ;
    rdfs:range ns2:Concept ;
    rdfs:subPropertyOf dcat:theme .

ns2:title a owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    rdfs:comment "(Localized) name of the entity."@en ;
    rdfs:domain ns2:Described ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title .

ns2:tokenFormat a owl:ObjectProperty ;
    rdfs:label "tokenFormat"@en ;
    rdfs:comment "Describes the format of the authentication token."@en ;
    rdfs:domain ns2:Token ;
    rdfs:range ns2:TokenFormat .

ns2:tokenValue a owl:DatatypeProperty ;
    rdfs:label "tokenValue"@en ;
    rdfs:comment "An authentication token value like JSON Web Token."@en ;
    rdfs:domain ns2:Token ;
    rdfs:range xsd:string .

ns2:transportCertsSha256 a owl:DatatypeProperty ;
    rdfs:label "transportCertsSha256"@en ;
    rdfs:comment "Separate certificates for IDS identification and transport encryption opens an attack vector for relay attacks. In order to prevent these attacks, a binding of this transport certificates to the connector is required. The inclusion of SHA256 fingerprints of currently valid transport certificates, mainly into the DAT, enables the client to relate the transport layer security with the IDS interactions."@en ;
    rdfs:domain ns2:JwtPayload ;
    rdfs:range xsd:string .

ns2:userAuthentication a owl:ObjectProperty ;
    rdfs:label "user authentication"@en ;
    rdfs:comment "authentication methods allowed in a Configuration Model"@en ;
    rdfs:domain ns2:ConfigurationModel ;
    rdfs:range ns2:UserAuthentication .

ns2:xone a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:LogicalConstraint ;
    rdfs:range ns2:Constraint ;
    rdfs:subPropertyOf odrl:xone .

ns1:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:comment "The class of contraints concerning the right operand of a relation." .

ns1:Package a owl:Class ;
    rdfs:label "Package"@en ;
    rdfs:comment "Abstract grouping of concepts relevant for a particular model view."@en .

ns1:RelationType a owl:Class ;
    rdfs:label "RelationType"@en ;
    rdfs:comment "The class of relation types, i.e., cardinality definitions of left and right operands of a relation." .

dcterms:conformsTo a owl:DatatypeProperty .

dcterms:created a owl:DatatypeProperty .

dcterms:licence a owl:DatatypeProperty .

dcterms:modified a owl:DatatypeProperty .

dcterms:publisher a owl:ObjectProperty .

xsd:duration a rdfs:Datatype .

odrl:duty a owl:AnnotationProperty .

foaf:homepage a owl:AnnotationProperty .

foaf:mbox a owl:AnnotationProperty .

<https://w3id.org/idsa/code/APP_RESOURCES_LOCAL_ENFORCEMENT> a owl:NamedIndividual,
        ns2:AppExecutionResources ;
    rdfs:label "App Resources Local Enforcement" .

<https://w3id.org/idsa/code/APP_RESOURCES_NONE> a owl:NamedIndividual,
        ns2:AppExecutionResources ;
    rdfs:label "App Resources None" .

<https://w3id.org/idsa/code/APP_RESOURCES_REMOTE_VERIFICATION> a owl:NamedIndividual,
        ns2:AppExecutionResources ;
    rdfs:label "App Resources Remote Verification" .

<https://w3id.org/idsa/code/AUDIT_REMOTE_TRACING> a owl:NamedIndividual,
        ns2:AuditGuarantee ;
    rdfs:label "Audit Remote Tracing" .

<https://w3id.org/idsa/code/COMPONENT_TRUST_SECURITY_PROFILE_CONCEPT_REVIEW> a owl:NamedIndividual,
        ns2:ComponentCertificationLevel ;
    rdfs:label "Trust Security Profile Certification of Components based on Concept Review"@en ;
    ns2:includedCertificationLevel <https://w3id.org/idsa/code/COMPONENT_BASE_SECURITY_PROFILE_CONCEPT_REVIEW> .

<https://w3id.org/idsa/code/INTEGRITY_PROTECTION_NONE> a owl:NamedIndividual,
        ns2:IntegrityGuarantee ;
    rdfs:label "Integrity Protection None" .

<https://w3id.org/idsa/code/INTEGRITY_VERIFICATION_SCOPE_KERNEL_CORE_CONTAINER> a owl:NamedIndividual,
        ns2:IntegrityVerificationScopeGuarantee ;
    rdfs:label "Integrity Verification Scope Kernel Core Container" .

<https://w3id.org/idsa/code/INTEGRITY_VERIFICATION_SCOPE_KERNEL_CORE_CONTAINER_APPLICATION> a owl:NamedIndividual,
        ns2:IntegrityVerificationScopeGuarantee ;
    rdfs:label "Integrity Verification Scope Kernel Core Container Application" .

<https://w3id.org/idsa/code/INTEGRITY_VERIFICATION_SCOPE_NONE> a owl:NamedIndividual,
        ns2:IntegrityVerificationScopeGuarantee ;
    rdfs:label "Integrity Verification Scope None" .

<https://w3id.org/idsa/code/LOCAL_DATA_CONFIDENTIALITY_NONE> a owl:NamedIndividual,
        ns2:LocalDataConfidentialityGuarantee ;
    rdfs:label "Local Data Confidentiality None" .

<https://w3id.org/idsa/code/PARTICIPANT_MEMBER_LEVEL_MANAGEMENT_SYSTEM> a owl:NamedIndividual,
        ns2:ParticipantCertificationLevel ;
    rdfs:label "Member Level Management System Certification of Participants"@en ;
    ns2:includedCertificationLevel <https://w3id.org/idsa/code/PARTICIPANT_MEMBER_LEVEL_MANAGEMENT_SYSTEM> .

<https://w3id.org/idsa/code/SERVICE_ISOLATION_PROCESS_GROUP> a owl:NamedIndividual,
        ns2:ServiceIsolationGuarantee ;
    rdfs:label "Service Isolation Process Group" .

<https://w3id.org/idsa/code/USAGE_CONTROL_NONE> a owl:NamedIndividual,
        ns2:UsageControlGuarantee ;
    rdfs:label "Usage Control None" .

<https://w3id.org/idsa/code/USAGE_CONTROL_POLICY_ENFORCEMENT> a owl:NamedIndividual,
        ns2:UsageControlGuarantee ;
    rdfs:label "Usage Control Policy Enforcement" .

<https://w3id.org/idsa/code/USAGE_CONTROL_REMOTE_COMPLIANCE_VERIFICATION> a owl:NamedIndividual,
        ns2:UsageControlGuarantee ;
    rdfs:label "Usage Control Remote Compliance Verification" .

<https://w3id.org/idsa/code/WRITE> a owl:NamedIndividual,
        ns2:Action ;
    rdfs:label "write"@en ;
    rdfs:comment "To change a remote resource."@en ;
    skos:note "This action is always evaluated at the provider side. It corresponds to 'allow changes of a resource' but *not* including its deletion."@en ;
    odrl:includedIn <https://w3id.org/idsa/code/USE> .

ns2:AssetCollection a owl:Class ;
    rdfs:label "Asset Collection"@en ;
    rdfs:comment "An AssetCollection is a bracket object combining several ids:Assets."@en ;
    rdfs:subClassOf odrl:AssetCollection,
        ns2:Asset .

ns2:Audience a owl:Class ;
    rdfs:label "Audience"@en ;
    rdfs:comment "The class of audiences (recipients) used in the JWT. "@en ;
    rdfs:seeAlso <https://tools.ietf.org/html/rfc7519> .

ns2:AuthStandard a owl:Class ;
    rdfs:label "AuthStandard"@en ;
    rdfs:comment "The class of authentication standards that may be supported by Connectors."@en .

ns2:ConnectorCatalog a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Catalog ;
    ns1:validation [ ns1:forProperty ns2:listedConnector ;
            ns1:relationType ns1:OneToMany ] .

ns2:DataRepresentation a owl:Class ;
    rdfs:label "Data representation"@en ;
    rdfs:comment "Physical representation of (structured) data."@en ;
    rdfs:subClassOf ns2:Representation .

ns2:ImageRepresentation a owl:Class ;
    rdfs:label "Image Representation"@en ;
    rdfs:comment "Image representation"@en ;
    rdfs:subClassOf ns2:Representation .

ns2:Interval a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf dcterms:PeriodOfTime,
        time:Interval,
        ns2:TemporalEntity ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:begin ] .

ns2:ParticipantCatalog a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Catalog ;
    ns1:validation [ ns1:forProperty ns2:member ;
            ns1:relationType ns1:OneToMany ] .

ns2:RejectionMessage a owl:Class ;
    rdfs:label "Rejection Message"@en ;
    rdfs:comment "Rejection messages are specialized response messages that notify the sender of a message that processing of this message has failed."@en ;
    rdfs:subClassOf ns2:ResponseMessage .

ns2:Site a owl:Class ;
    rdfs:label "Site"@en ;
    rdfs:comment "An office or other premise at which the organization is located"@en ;
    rdfs:subClassOf org:Site .

ns2:action a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Rule,
        ns2:UsageControlObject ;
    rdfs:range ns2:Action ;
    rdfs:subPropertyOf odrl:action .

ns2:certificationLevel a owl:ObjectProperty ;
    rdfs:label "certification level"@en ;
    rdfs:comment "Level of certification (based on a combination of requierements, evaluation method etc.)"@en ;
    rdfs:domain ns2:Certification ;
    rdfs:range ns2:CertificationLevel .

ns2:contentPart a owl:ObjectProperty ;
    rdfs:label "content part"@en ;
    rdfs:comment "Reference to a Digital Content (physically or logically) included, definition of part-whole hierarchies."@en ;
    rdfs:domain ns2:DigitalContent ;
    rdfs:range ns2:DigitalContent .

ns2:extendedGuarantee a owl:ObjectProperty ;
    rdfs:label "extended guarantee"@en ;
    rdfs:comment "Reference to a security guarantee that, if used in combination with a security profile instance, overrides the respective guarantee of the given predefined instance."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns2:Connector ns2:DatPayload ) ] ;
    rdfs:range ns2:SecurityGuarantee .

ns2:representation a owl:ObjectProperty ;
    rdfs:label "representation"@en ;
    rdfs:comment "Representation of the content."@en ;
    rdfs:domain ns2:DigitalContent ;
    rdfs:range ns2:Representation .

ns2:securityProfile a owl:ObjectProperty ;
    rdfs:label "securityProfile"@en ;
    rdfs:comment "The SecurityProfile supported by the Connector."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns2:Connector ns2:JwtPayload ) ] ;
    rdfs:range ns2:SecurityProfile .

ns1:ModelView a owl:Class ;
    rdfs:label "Model view"@en ;
    rdfs:comment "Tailored view defined upon and generated from an ontology for a particular purpose."@en .

org:hasMember a owl:AnnotationProperty .

<https://w3id.org/idsa/code/AUDIT_LOCAL_LOGGING> a owl:NamedIndividual,
        ns2:AuditGuarantee ;
    rdfs:label "Audit Local Logging" .

<https://w3id.org/idsa/code/INTEGRITY_VERIFICATION_REMOTE> a owl:NamedIndividual,
        ns2:IntegrityGuarantee ;
    rdfs:label "Integrity Protection Remote" .

<https://w3id.org/idsa/code/LOCAL_DATA_CONFIDENTIALITY_FULL_ENCRYPTION> a owl:NamedIndividual,
        ns2:LocalDataConfidentialityGuarantee ;
    rdfs:label "Local Data Confidentiality Full Encryption" .

<https://w3id.org/idsa/code/SERVICE_ISOLATION_LEAST_PRIVILEGE> a owl:NamedIndividual,
        ns2:ServiceIsolationGuarantee ;
    rdfs:label "Service Isolation Least Privilege" .

ns2:AppExecutionResources a owl:Class ;
    rdfs:label "App execution resources"@en ;
    rdfs:comment "Resource control for deployed services."@en ;
    rdfs:subClassOf ns2:SecurityGuarantee ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/idsa/code/APP_RESOURCES_LOCAL_ENFORCEMENT> <https://w3id.org/idsa/code/APP_RESOURCES_NONE> <https://w3id.org/idsa/code/APP_RESOURCES_REMOTE_VERIFICATION> ) ] .

ns2:AppNotificationMessage a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:ResourceNotificationMessage ;
    ns1:abstract true ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:affectedDataAppResource ] .

ns2:Asset a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf odrl:Asset ;
    ns1:abstract true .

ns2:AuditGuarantee a owl:Class ;
    rdfs:label "Audit guarantee"@en ;
    rdfs:comment "Local audit logging (including integrity protection) is the baseline for auditing and clearing. Remote audit log tracing provides means to do external audit verification."@en ;
    rdfs:subClassOf ns2:SecurityGuarantee ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/idsa/code/AUDIT_LOCAL_LOGGING> <https://w3id.org/idsa/code/AUDIT_NONE> <https://w3id.org/idsa/code/AUDIT_REMOTE_TRACING> ) ] .

ns2:AuthInfo a owl:Class,
        owl:NamedIndividual ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:authService ] .

ns2:AuthenticationGuarantee a owl:Class ;
    rdfs:label "Authentication"@en ;
    rdfs:comment "Authentication mechanism applied prior to opening a connection. Examples are the verification server's identity or doing mutual authentication."@en ;
    rdfs:subClassOf ns2:SecurityGuarantee ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/idsa/code/AUTHENTICATION_MUTUAL> <https://w3id.org/idsa/code/AUTHENTICATION_NONE> <https://w3id.org/idsa/code/AUTHENTICATION_SERVER_SIDE> ) ] .

ns2:BasicAuthentication a owl:Class ;
    rdfs:label "User Authentication"@en ;
    rdfs:comment "Basic authentication using username / password "@en ;
    rdfs:seeAlso <https://tools.ietf.org/html/rfc7617> ;
    rdfs:subClassOf ns2:UserAuthentication .

ns2:Catalog a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf dcat:Catalog ;
    ns1:abstract true .

ns2:ConnectorDeployMode a owl:Class ;
    rdfs:label "Connector Deploy Mode"@en ;
    rdfs:comment "Deploy mode of a Connector. Used mainly to capture a Connectors deployment type in the Configuration Model."@en .

ns2:ContentType a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf dcterms:DCMIType ;
    ns1:usage "Instances of Content Type are used to more precisely specify the type, genre or interpretation of a Digital Content."@en .

ns2:DescribedSemantically a owl:Class,
        owl:NamedIndividual ;
    ns1:abstract true .

ns2:Duty a owl:Class ;
    rdfs:label "Duty"@en ;
    rdfs:comment "The class of Duties as defined in the ODRL ontology."@en ;
    rdfs:subClassOf odrl:Duty,
        ns2:Rule .

ns2:GeoPoint a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Location ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:latitude ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:longitude ] .

ns2:Instant a owl:Class ;
    rdfs:label "Instant"@en ;
    rdfs:comment "A defined point in time with zero duration."@en ;
    rdfs:subClassOf time:Instant,
        ns2:TemporalEntity .

ns2:IntegrityGuarantee a owl:Class ;
    rdfs:label "Integrity protection and verification"@en ;
    rdfs:comment "Level of integrity protection and verification of the installed software stack. Trusted boot is an example of local integrity protection, remote integrity verification comprises, for example, remote attestation."@en ;
    rdfs:subClassOf ns2:SecurityGuarantee ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/idsa/code/INTEGRITY_PROTECTION_LOCAL> <https://w3id.org/idsa/code/INTEGRITY_PROTECTION_NONE> <https://w3id.org/idsa/code/INTEGRITY_VERIFICATION_REMOTE> ) ] .

ns2:IntegrityVerificationScopeGuarantee a owl:Class ;
    rdfs:label "Integrity verification scope"@en ;
    rdfs:comment "Level/extent of verifying the software stack."@en ;
    rdfs:subClassOf ns2:SecurityGuarantee ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/idsa/code/INTEGRITY_VERIFICATION_SCOPE_KERNEL_CORE_CONTAINER> <https://w3id.org/idsa/code/INTEGRITY_VERIFICATION_SCOPE_KERNEL_CORE_CONTAINER_APPLICATION> <https://w3id.org/idsa/code/INTEGRITY_VERIFICATION_SCOPE_NONE> ) ] .

ns2:LocalDataConfidentialityGuarantee a owl:Class ;
    rdfs:label "Local data confidentiality"@en ;
    rdfs:comment "Means by which local data is protected."@en ;
    rdfs:subClassOf ns2:SecurityGuarantee ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/idsa/code/LOCAL_DATA_CONFIDENTIALITY_FULL_ENCRYPTION> <https://w3id.org/idsa/code/LOCAL_DATA_CONFIDENTIALITY_NONE> <https://w3id.org/idsa/code/LOCAL_DATA_CONFIDENTIALITY_SECURE_ERASURE> ) ] .

ns2:LogicalConstraint a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf odrl:LogicalConstraint,
        ns2:AbstractConstraint ;
    ns1:validation [ ns1:forProperty ns2:or ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:and ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:xone ;
            ns1:relationType ns1:OneToMany ] .

ns2:ParticipantCertification a owl:Class ;
    rdfs:label "Participant Certification"@en ;
    rdfs:comment "Process and result of certifying an interested party in order to become a certified member of the International Data Space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:ParticipantCertificationLevel ;
            owl:onProperty ns2:certificationLevel ],
        ns2:Certification .

ns2:Permission a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf odrl:Permission,
        ns2:Rule ;
    ns1:validation [ ns1:forProperty ns2:postDuty ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:preDuty ;
            ns1:relationType ns1:OneToMany ] .

ns2:PublicKey a owl:Class ;
    rdfs:label "Public Key"@en ;
    rdfs:comment "Public key as used in asymmetric cryptography."@en .

ns2:QueryMessage a owl:Class ;
    rdfs:label "Query Message"@en ;
    rdfs:comment "Query message intended to be consumed by a component."@en ;
    rdfs:subClassOf ns2:RequestMessage .

ns2:RepresentationInstance a owl:Class,
        owl:NamedIndividual ;
    ns1:abstract true .

ns2:ResourceCatalog a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Catalog ;
    ns1:validation [ ns1:forProperty ns2:offeredResource ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:requestedResource ;
            ns1:relationType ns1:OneToMany ] .

ns2:ServiceIsolationGuarantee a owl:Class ;
    rdfs:label "Service isolation"@en ;
    rdfs:comment "Service isolation mechanism supported by the Connector. Examples are process group (Docker) or by least privilege with clear separation and support for additional security modules as done by trustme."@en ;
    rdfs:subClassOf ns2:SecurityGuarantee ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/idsa/code/SERVICE_ISOLATION_LEAST_PRIVILEGE> <https://w3id.org/idsa/code/SERVICE_ISOLATION_NONE> <https://w3id.org/idsa/code/SERVICE_ISOLATION_PROCESS_GROUP> ) ] .

ns2:UsageControlGuarantee a owl:Class ;
    rdfs:label "Usage control"@en ;
    rdfs:comment "Extent of supporting usage control."@en ;
    rdfs:subClassOf ns2:SecurityGuarantee ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/idsa/code/USAGE_CONTROL_NONE> <https://w3id.org/idsa/code/USAGE_CONTROL_POLICY_ENFORCEMENT> <https://w3id.org/idsa/code/USAGE_CONTROL_REMOTE_COMPLIANCE_VERIFICATION> ) ] .

ns2:UserAuthentication a owl:Class .

ns2:correlationMessage a owl:ObjectProperty ;
    rdfs:domain ns2:Message ;
    rdfs:range ns2:Message .

dcat:dataset a owl:ObjectProperty .

<https://w3id.org/idsa/code/AUTHENTICATION_MUTUAL> a owl:NamedIndividual,
        ns2:AuthenticationGuarantee ;
    rdfs:label "Authentication Mutual" .

ns2:AbstractConstraint a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf odrl:Constraint ;
    ns1:abstract true .

ns2:ConnectorEndpoint a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Endpoint ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:accessUrl ] .

ns2:ConnectorStatus a owl:Class ;
    rdfs:label "Connector Status"@en ;
    rdfs:comment "Connector Status is used to represent a Connectors current state inside the Configuration Model."@en .

ns2:LogLevel a owl:Class ;
    rdfs:label "Log Level"@en ;
    rdfs:comment "Instances of ids:LogLevel can be used to specify a log level. Currently this is only used by the Configuration Model."@en .

ns2:Proxy a owl:Class,
        owl:NamedIndividual ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:proxyURI ],
        [ ns1:forProperty ns2:noProxy ;
            ns1:relationType ns1:OneToMany ] .

ns2:QueryLanguage a owl:Class ;
    rdfs:label "QueryLanguage"@en ;
    rdfs:comment "Class of query languages in which query strings may be formalized."@en .

ns2:QueryScope a owl:Class ;
    rdfs:label "Query Scope"@en ;
    rdfs:comment "Class of scopes that may limit the space of query results, e.g. ALL, ACTIVE_ONLY."@en .

ns2:ResourceNotificationMessage a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:NotificationMessage ;
    ns1:abstract true ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:affectedResource ] .

ns2:Token a owl:Class,
        owl:NamedIndividual ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:tokenValue ] .

ns1:PropertyValidation a owl:Class ;
    rdfs:label "PropertyValidation"@en ;
    rdfs:comment "The class of all property validations." .

ns2:ArtifactState a owl:Class ;
    rdfs:label "Artifact State"@en ;
    rdfs:comment "The state which an ids:Artifact may have or not."@en .

ns2:Certification a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:ManagedEntity ;
    ns1:abstract true .

ns2:CertificationLevel a owl:Class,
        owl:NamedIndividual ;
    ns1:abstract true .

ns2:ConnectorNotificationMessage a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:NotificationMessage ;
    ns1:abstract true ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:affectedConnector ] .

ns2:KeyType a owl:Class ;
    rdfs:label "Key Type"@en ;
    rdfs:comment "Cryptographic Key Type."@en .

ns2:Location a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf dcterms:Location,
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    ns1:abstract true .

ns2:ManagedEntity a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Described ;
    ns1:abstract true .

ns2:MediaType a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf dcterms:MediaType ;
    ns1:abstract true ;
    ns1:usage "ids:CustomMediaType is used only when no ids:IANAMediaType available."@en .

ns2:ParticipantNotificationMessage a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:NotificationMessage ;
    ns1:abstract true ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:affectedParticipant ] .

ns2:SecurityProfile a owl:Class,
        owl:NamedIndividual ;
    ns1:validation [ ns1:forProperty ns2:securityGuarantee ;
            ns1:relationType ns1:OneToMany ] .

ns2:TemporalEntity a owl:Class ;
    rdfs:label "TemporalEntity"@en ;
    rdfs:comment "A temporal interval, instant or a relative duration."@en ;
    rdfs:subClassOf time:TemporalEntity .

ns2:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "Internal or external Agent interacting with the Industrial Data Space, not necessarily an IDS Participant."@en ;
    rdfs:subClassOf odrl:Party,
        foaf:Agent,
        ns2:Described .

ns2:AppEndpointType a owl:Class ;
    rdfs:label "App endpoint type"@en ;
    rdfs:comment "Class of endpoint types a data app offers."@en .

ns2:DataApp a owl:Class,
        owl:NamedIndividual ;
    ns1:abstract true ;
    ns1:validation [ ns1:constraint ns1:NotEmpty ;
            ns1:forProperty ns2:appEndpoint ;
            ns1:relationType ns1:OneToMany ] .

ns2:Described a owl:Class,
        owl:NamedIndividual ;
    ns1:abstract true ;
    ns1:validation [ ns1:forProperty ns2:title ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:description ;
            ns1:relationType ns1:OneToMany ] .

ns2:Person a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf foaf:Person ;
    ns1:validation [ ns1:forProperty ns2:phoneNumber ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:emailAddress ;
            ns1:relationType ns1:OneToMany ] .

ns2:QueryTarget a owl:Class ;
    rdfs:label "Query Target"@en ;
    rdfs:comment "Class of recipients of a query message, e.g. BROKER, APPSTORE, ANY."@en .

ns2:AppEndpoint a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Endpoint ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:appEndpointType ] .

ns2:ComponentCertificationLevel a owl:Class ;
    rdfs:label "Component Certification Level"@en ;
    rdfs:comment "Level of a Component Certification"@en ;
    rdfs:subClassOf ns2:CertificationLevel ;
    owl:disjointWith ns2:ParticipantCertificationLevel .

ns2:TokenFormat a owl:Class ;
    rdfs:label "Token format"@en ;
    rdfs:comment "Possible formats for (security-related) tokens."@en .

<https://w3id.org/idsa/code/USE> a owl:NamedIndividual,
        ns2:Action ;
    rdfs:label "use"@en ;
    rdfs:comment "To use a resource in any possible way. Includes all other actions."@en ;
    skos:broader odrl:use ;
    skos:note "This action is always evaluated at the consumer side."@en .

ns2:AppRoute a owl:Class,
        owl:NamedIndividual ;
    ns1:validation [ ns1:forProperty ns2:appRouteEnd ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:routeDeployMethod ],
        [ ns1:forProperty ns2:subRoute ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:appRouteStart ;
            ns1:relationType ns1:OneToMany ] .

ns2:Artifact a owl:Class ;
    rdfs:label "Artifact"@en ;
    rdfs:comment "Instance of a Representation materialized at a partiuclar version and point in time. Possesses characteristics like file name, size, creation date etc."@en ;
    rdfs:subClassOf ns2:RepresentationInstance ;
    owl:disjointWith ns2:Value .

ns2:Endpoint a owl:Class,
        owl:NamedIndividual ;
    ns1:validation [ ns1:forProperty ns2:endpointDocumentation ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:endpointInformation ;
            ns1:relationType ns1:OneToMany ] .

ns2:NotificationMessage a owl:Class ;
    rdfs:label "Notification Message"@en ;
    rdfs:comment "Event messages are informative and no response is expected by the sender."@en ;
    rdfs:subClassOf ns2:Message .

ns2:ParticipantCertificationLevel a owl:Class ;
    rdfs:label "Participant Certification Level"@en ;
    rdfs:comment "Level of a Participant Certification"@en ;
    rdfs:subClassOf ns2:CertificationLevel .

ns2:Rule a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf odrl:Rule,
        ns2:Described ;
    ns1:abstract true ;
    ns1:validation [ ns1:forProperty ns2:constraint ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:constraint ns1:NotEmpty ;
            ns1:forProperty ns2:action ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:assigner ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:assignee ;
            ns1:relationType ns1:OneToMany ] .

ns2:ConfigurationModel a owl:Class,
        owl:NamedIndividual ;
    ns1:validation [ ns1:forProperty ns2:userAuthentication ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:configurationModelLogLevel ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:connectorStatus ],
        [ ns1:forProperty ns2:appRoute ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:connectorDeployMode ],
        [ ns1:forProperty ns2:connectorProxy ;
            ns1:relationType ns1:OneToMany ] .

rdfs:Resource a owl:Class .

ns2:RequestMessage a owl:Class ;
    rdfs:label "Request Message"@en ;
    rdfs:comment "Client-generated message initiating a communication, motivated by a certain reason and with an answer expected."@en ;
    rdfs:subClassOf ns2:Message .

ns2:SecurityGuarantee a owl:Class ;
    rdfs:label "Security guarantee"@en ;
    rdfs:comment "Security guarantee claimed by a security profile."@en .

ns2:UsageControlObject a owl:Class,
        owl:NamedIndividual ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:created ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:data ],
        [ ns1:forProperty ns2:action ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:constraint ns1:NotEmpty ;
            ns1:forProperty ns2:contract ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:hasState ;
            ns1:relationType ns1:OneToMany ] .

dcterms:Agent a owl:Class .

foaf:Person a owl:Class .

ns2:Constraint a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:AbstractConstraint ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:leftOperand ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:operator ] .

ns2:InfrastructureComponent a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:ManagedEntity ;
    ns1:abstract true ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:curator ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:maintainer ],
        [ ns1:constraint ns1:NotEmpty ;
            ns1:forProperty ns2:inboundModelVersion ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:outboundModelVersion ] .

ns2:ResponseMessage a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Message ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:correlationMessage ] .

ns2:JwtPayload a owl:Class,
        owl:NamedIndividual ;
    ns1:abstract true ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:iat ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:scope ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:aud ],
        [ ns1:constraint ns1:NotEmpty ;
            ns1:forProperty ns2:transportCertsSha256 ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:sub ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:exp ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:nbf ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:securityProfile ] .

ns2:RejectionReason a owl:Class ;
    rdfs:label "RejectionReason"@en ;
    rdfs:comment "Class of reasons that might lead to issuing a Rejection message."@en .

ns2:Representation a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf dcat:Distribution,
        ns2:DescribedSemantically ;
    ns1:validation [ ns1:forProperty ns2:instance ;
            ns1:relationType ns1:OneToMany ] .

ns2:Contract a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf odrl:Policy ;
    ns1:abstract true ;
    ns1:validation [ ns1:forProperty ns2:obligation ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:permission ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:prohibition ;
            ns1:relationType ns1:OneToMany ] .

ns2:DigitalContent a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf dcat:Dataset,
        ns2:Described ;
    ns1:abstract true ;
    ns1:validation [ ns1:forProperty ns2:contentPart ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:spatialCoverage ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:contentRefinement ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:representation ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:language ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:keyword ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:theme ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:temporalCoverage ;
            ns1:relationType ns1:OneToMany ] .

ns2:Message a owl:Class,
        owl:NamedIndividual ;
    ns1:abstract true ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:issued ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:issuerConnector ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:senderAgent ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:modelVersion ],
        [ ns1:forProperty ns2:recipientAgent ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:securityToken ],
        [ ns1:forProperty ns2:recipientConnector ;
            ns1:relationType ns1:OneToMany ] .

skos:Concept a owl:Class .

ns2:ContractAgreement a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf odrl:Agreement,
        ns2:Contract ;
    owl:disjointWith ns2:ContractOffer,
        ns2:ContractRequest ;
    ns1:validation [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:contractStart ] .

ns2:Connector a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:InfrastructureComponent ;
    ns1:abstract true ;
    ns1:validation [ ns1:forProperty ns2:hasAgent ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:hasDefaultEndpoint ;
            ns1:relationType ns1:NotNull ],
        [ ns1:forProperty ns2:extendedGuarantee ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:hasEndpoint ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:resourceCatalog ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:constraint ns1:NotNull ;
            ns1:forProperty ns2:securityProfile ] .

ns2:ContractOffer a owl:Class ;
    rdfs:label "Contract offer"@en ;
    rdfs:comment "Contract issued by the Data Provider offering the usage of a Resource at particular conditions."@en ;
    rdfs:subClassOf odrl:Offer,
        ns2:Contract ;
    owl:disjointWith ns2:ContractRequest .

ns2:ContractRequest a owl:Class ;
    rdfs:label "Contract request"@en ;
    rdfs:comment "Contract issued by the Data Consumer requesting the usage of a Resource at particular conditions."@en ;
    rdfs:subClassOf odrl:Request,
        ns2:Contract .

ns2:Participant a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf org:Organization,
        ns2:Agent,
        ns2:ManagedEntity ;
    ns1:validation [ ns1:forProperty ns2:corporateEmailAddress ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:memberPerson ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:memberParticipant ;
            ns1:relationType ns1:OneToMany ] .

ns2:Action a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf odrl:Action ;
    ns1:validation [ ns1:forProperty ns2:actionRefinement ;
            ns1:relationType ns1:OneToMany ] .

ns2:Frequency a owl:Class ;
    rdfs:label "Frequency"@en ;
    rdfs:comment "Class of all frequencies."@en .

ns2:LeftOperand a owl:Class ;
    rdfs:label "LeftOperand"@en ;
    rdfs:comment "Instances of the LeftOperand class are used as the leftOperand of a Constraint."@en ;
    rdfs:subClassOf odrl:LeftOperand .

ns2:Resource a owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf ns2:Asset,
        ns2:DescribedSemantically,
        ns2:DigitalContent,
        ns2:ManagedEntity ;
    ns1:validation [ ns1:forProperty ns2:resourcePart ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:sample ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:resourceEndpoint ;
            ns1:relationType ns1:OneToMany ],
        [ ns1:forProperty ns2:contractOffer ;
            ns1:relationType ns1:OneToMany ] .

ns2:BinaryOperator a owl:Class ;
    rdfs:label "BinaryOperator"@en ;
    rdfs:comment "The class of binary operators."@en ;
    rdfs:subClassOf odrl:Operator .

ns2:Language a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:comment "The class of languages potentially being used by textual Data Assets."@en .

owl:Class a owl:Class .

