<https://w3id.org/idsa/code/WA> a owl:NamedIndividual,
        ns2:Language ;
    rdfs:label "Walloon"@en .

<https://w3id.org/idsa/code/WEEKLY> a owl:NamedIndividual,
        skos:Concept,
        ns2:Frequency ;
    rdfs:label "Weekly"@en ;
    dcam:memberOf <http://purl.org/cld/terms/Frequency> ;
    rdfs:comment "The event occurs once a week."@en ;
