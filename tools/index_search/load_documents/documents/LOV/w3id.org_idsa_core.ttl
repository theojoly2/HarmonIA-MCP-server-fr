    rdfs:label "Tahitian"@en .

<https://w3id.org/idsa/code/UG> a owl:NamedIndividual,
        ns2:Language ;
    rdfs:label "Uyghur"@en .

<https://w3id.org/idsa/code/UK> a owl:NamedIndividual,
