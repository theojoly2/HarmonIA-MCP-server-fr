@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <https://w3id.org/mod#> .
@prefix onto: <https://w3id.org/aerOS/continuum#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:contributor a owl:AnnotationProperty .

dc:created a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain onto:Domain,
        onto:Service ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range xsd:string .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:domain org:Organization,
        onto:Domain,
        onto:Service,
        onto:ServiceComponent,
        onto:ServiceType ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range xsd:string .

dcterms:license a owl:ObjectProperty ;
    rdfs:label "license" ;
    rdfs:domain onto:ServiceType ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range dcterms:LicenseDocument .

dcterms:modified a owl:AnnotationProperty .

dcterms:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain onto:LowLevelOrchestrator ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range xsd:string .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain onto:NetworkPort ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range xsd:string .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://schema.org/email> a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:isDefinedBy <http://schema.org/> ;
    rdfs:range xsd:string .

<http://schema.org/url> a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:domain onto:LowLevelOrchestrator ;
    rdfs:isDefinedBy <http://schema.org/> ;
    rdfs:range xsd:anyURI .

xsd:date a rdfs:Datatype .

owl:versionInfo a owl:AnnotationProperty .

org:member a owl:ObjectProperty ;
    rdfs:label "member" ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy org: ;
    rdfs:range foaf:Person .

org:organization a owl:ObjectProperty ;
    rdfs:label "organization" ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy org: ;
    rdfs:range org:Organization .

org:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:domain org:Membership ;
    rdfs:isDefinedBy org: ;
    rdfs:range org:Role .

foaf:firstName a owl:DatatypeProperty ;
    rdfs:label "first name" ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range xsd:string .

foaf:lastName a owl:DatatypeProperty ;
    rdfs:label "last name" ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range xsd:string .

onto:CloudTier a owl:NamedIndividual,
        onto:InfrastructureElementTier .

onto:ContainerdOrchestration a owl:NamedIndividual,
        onto:OrchestrationType .

onto:DockerOrchestration a owl:NamedIndividual,
        onto:OrchestrationType .

onto:EdgeTier a owl:NamedIndividual,
        onto:InfrastructureElementTier .

onto:FailedServiceComponent a owl:NamedIndividual,
        onto:ServiceComponentStatus .

onto:FarEdgeTier a owl:NamedIndividual,
        onto:InfrastructureElementTier .

onto:FinishedServiceComponent a owl:NamedIndividual,
        onto:ServiceComponentStatus .

onto:FunctionalDomain a owl:NamedIndividual,
        onto:DomainStatus .

onto:IotTier a owl:NamedIndividual,
        onto:InfrastructureElementTier .

onto:KubernetesOrchestration a owl:NamedIndividual,
        onto:OrchestrationType .

onto:Linux a owl:NamedIndividual,
        onto:OperatingSystem .

onto:LocatingServiceComponent a owl:NamedIndividual,
        onto:ServiceComponentStatus .

onto:MigratingServiceComponent a owl:NamedIndividual,
        onto:ServiceComponentStatus .

onto:OpenstackOrchestration a owl:NamedIndividual,
        onto:OrchestrationType .

onto:OverloadInfrastructureElement a owl:NamedIndividual,
        onto:InfrastructureElementStatus .

onto:OverloadServiceComponent a owl:NamedIndividual,
        onto:ServiceComponentStatus .

onto:PreliminarDomain a owl:NamedIndividual,
        onto:DomainStatus .

onto:ReadyInfrastructureElement a owl:NamedIndividual,
        onto:InfrastructureElementStatus .

onto:RemovedDomain a owl:NamedIndividual,
        onto:DomainStatus .

onto:RemovingServiceComponent a owl:NamedIndividual,
        onto:ServiceComponentStatus .

onto:RunningServiceComponent a owl:NamedIndividual,
        onto:ServiceComponentStatus .

onto:StartingServiceComponent a owl:NamedIndividual,
        onto:ServiceComponentStatus .

onto:UnsecureInfrastructureElement a owl:NamedIndividual,
        onto:InfrastructureElementStatus .

onto:UntrustedInfrastructureElement a owl:NamedIndividual,
        onto:InfrastructureElementStatus .

onto:Windows a owl:NamedIndividual,
        onto:OperatingSystem .

onto:arm32Architecture a owl:NamedIndividual,
        onto:CpuArchitecture .

onto:arm64Architecture a owl:NamedIndividual,
        onto:CpuArchitecture .

onto:availableRam a owl:DatatypeProperty ;
    rdfs:label "available ram" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:integer .

onto:averagePowerConsumption a owl:DatatypeProperty ;
    rdfs:label "average power consumption" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:float .

onto:belongsTo a owl:ObjectProperty ;
    rdfs:label "belongs to" ;
    rdfs:domain onto:LowLevelOrchestrator ;
    rdfs:range onto:Domain .

onto:cliArgs a owl:DatatypeProperty ;
    rdfs:label "cli args" ;
    rdfs:domain onto:ServiceComponent ;
    rdfs:range xsd:string .

onto:containerImage a owl:DatatypeProperty ;
    rdfs:label "container image" ;
    rdfs:domain onto:ServiceComponent ;
    rdfs:range xsd:string .

onto:cpuArchitecture a owl:ObjectProperty ;
    rdfs:label "cpu architecture" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range onto:CpuArchitecture .

onto:cpuCores a owl:DatatypeProperty ;
    rdfs:label "cpu cores" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:integer .

onto:currentCpuUsage a owl:DatatypeProperty ;
    rdfs:label "current cpu usage" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:float .

onto:currentPowerConsumption a owl:DatatypeProperty ;
    rdfs:label "current power consumption" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:float .

onto:currentRamUsage a owl:DatatypeProperty ;
    rdfs:label "current ram usage" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:integer .

onto:deployedOnServiceComponent a owl:ObjectProperty ;
    rdfs:label "deployed on service component" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range onto:ServiceComponent .

onto:domain a owl:ObjectProperty ;
    rdfs:label "domain" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range onto:Domain .

onto:domainStatus a owl:ObjectProperty ;
    rdfs:label "domain status" ;
    rdfs:domain onto:Domain ;
    rdfs:range onto:DomainStatus .

onto:envVars a owl:DatatypeProperty ;
    rdfs:label "env vars" ;
    rdfs:domain onto:ServiceComponent ;
    rdfs:range xsd:string .

onto:exposesNetworkPort a owl:ObjectProperty ;
    rdfs:label "exposes network port" ;
    rdfs:domain onto:ServiceComponent ;
    rdfs:range onto:NetworkPort .

onto:infrastructureElementRequirements a owl:ObjectProperty ;
    rdfs:label "infrastructure element requirements" ;
    rdfs:domain onto:ServiceComponent ;
    rdfs:range onto:InfrastructureElementRequirements .

onto:infrastructureElementStatus a owl:ObjectProperty ;
    rdfs:label "infrastructure element status" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range onto:InfrastructureElementStatus .

onto:infrastructureElementTier a owl:ObjectProperty ;
    rdfs:label "infrastructure element tier" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range onto:InfrastructureElementTier .

onto:internalIpAddress a owl:DatatypeProperty ;
    rdfs:label "internal ip address" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:string .

onto:isEntrypoint a owl:DatatypeProperty ;
    rdfs:label "is entrypoint" ;
    rdfs:domain onto:Domain ;
    rdfs:range xsd:boolean .

onto:isPartOfService a owl:ObjectProperty ;
    rdfs:label "is part of service" ;
    rdfs:domain onto:ServiceComponent ;
    rdfs:range onto:Service .

onto:location a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "location" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:Location .

onto:macAddress a owl:DatatypeProperty ;
    rdfs:label "mac address" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:string .

onto:operatingSystem a owl:ObjectProperty ;
    rdfs:label "operating system" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range onto:OperatingSystem .

onto:orchestrationType a owl:ObjectProperty ;
    rdfs:label "orchestration type" ;
    rdfs:domain onto:LowLevelOrchestrator ;
    rdfs:range onto:OrchestrationType .

onto:owner a owl:ObjectProperty ;
    rdfs:label "owner" ;
    rdfs:domain onto:Domain ;
    rdfs:range org:Organization .

onto:portNumber a owl:DatatypeProperty ;
    rdfs:label "port number" ;
    rdfs:domain onto:NetworkPort ;
    rdfs:range xsd:integer .

onto:publicUrl a owl:DatatypeProperty ;
    rdfs:label "public url" ;
    rdfs:domain onto:Domain ;
    rdfs:range xsd:anyURI .

onto:ramCapacity a owl:DatatypeProperty ;
    rdfs:label "ram capacity" ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:range xsd:integer .

onto:realTimeCapable a owl:DatatypeProperty ;
    rdfs:label "real time capable" ;
    rdfs:domain onto:InfrastructureElement,
        onto:InfrastructureElementRequirements ;
    rdfs:range xsd:boolean .

onto:requiredCpuUsage a owl:DatatypeProperty ;
    rdfs:label "required cpu usage" ;
    rdfs:domain onto:InfrastructureElementRequirements ;
    rdfs:range xsd:float .

onto:requiredRam a owl:DatatypeProperty ;
    rdfs:label "required ram" ;
    rdfs:domain onto:InfrastructureElementRequirements ;
    rdfs:range xsd:integer .

onto:serviceComponentStatus a owl:ObjectProperty ;
    rdfs:label "service component status" ;
    rdfs:domain onto:ServiceComponent ;
    rdfs:range onto:ServiceComponentStatus .

onto:serviceType a owl:ObjectProperty ;
    rdfs:label "service type" ;
    rdfs:domain onto:Service ;
    rdfs:range onto:ServiceType .

onto:sla a owl:DatatypeProperty ;
    rdfs:label "sla" ;
    rdfs:domain onto:ServiceComponent ;
    rdfs:range xsd:string .

onto:username a owl:DatatypeProperty ;
    rdfs:label "username" ;
    rdfs:domain onto:User ;
    rdfs:range xsd:string .

onto:webPage a owl:DatatypeProperty ;
    rdfs:label "web page" ;
    rdfs:domain onto:ServiceType ;
    rdfs:range xsd:anyURI .

onto:withinArea a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "within area" ;
    rdfs:domain onto:InfrastructureElementRequirements ;
    rdfs:range xsd:Area .

onto:x64Architecture a owl:NamedIndividual,
        onto:CpuArchitecture .

ns1:createdWith a owl:AnnotationProperty .

<http://purl.org/NET/rdflicense/APACHE2.0> a owl:NamedIndividual .

dcterms:LicenseDocument a owl:Class ;
    rdfs:label "License Document" ;
    rdfs:isDefinedBy dcterms: .

xsd:Area a owl:Class .

xsd:Location a owl:Class .

org:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "Function or set of functions that a person can perform within an organization. In the scope of aerOS, the functions will be mapped to the capabilities exposed by the aerOS continuum." ;
    rdfs:isDefinedBy org: .

onto: a owl:NamedIndividual,
        owl:Ontology ;
    rdfs:label "aerOS Continuum Ontology"@en ;
    dcterms:contributor "Andreu Belsa Pellicer",
        "Rafael Vaño Garcia" ;
    dcterms:created "2024-02-14"^^xsd:date ;
    dcterms:creator "Ignacio Dominguez Martinez-Casanueva" ;
    dcterms:description "\\n                                    Ontology for the orchestration of the aerOS continuum.\\n                                    " ;
    dcterms:license <http://purl.org/NET/rdflicense/APACHE2.0> ;
    dcterms:modified "2024-08-23"^^xsd:date ;
    dcterms:source <https://gitlab.aeros-project.eu/wp4/t4.1/aeros-continuum> ;
    dcterms:title "aerOS Continuum Ontology" ;
    vann:preferredNamespacePrefix "aeros" ;
    vann:preferredNamespaceUri onto: ;
    owl:versionIRI <https://w3id.org/aerOS/continuum> ;
    owl:versionInfo "1.1.0" ;
    ns1:createdWith <https://chowlk.linkeddata.es/> .

onto:User a owl:Class ;
    rdfs:label "User" ;
    rdfs:comment "Person with access to the capabilities of the continuum." ;
    rdfs:subClassOf foaf:Person .

org:Membership a owl:Class ;
    rdfs:label "Membership" ;
    rdfs:isDefinedBy org: .

org:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Group of people that work together towards a business goal. In the scope of aerOS, an organization is accountable for the management of an aerOS domain as part of a continuum." ;
    rdfs:isDefinedBy org: .

onto:NetworkPort a owl:Class ;
    rdfs:label "Network Port" .

onto:OperatingSystem a owl:Class ;
    rdfs:label "Operating System" .

foaf:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:isDefinedBy foaf: .

onto:CpuArchitecture a owl:Class ;
    rdfs:label "Cpu Architecture" .

onto:DomainStatus a owl:Class ;
    rdfs:label "Domain Status" ;
    rdfs:comment "Represents the status of a domain. Possible types are Preliminar, Functional, Removed.Represents the status of a domain. Possible types are Preliminar, Functional, Removed." .

onto:LowLevelOrchestrator a owl:Class ;
    rdfs:label "Low Level Orchestrator" ;
    rdfs:comment "This element interprets the Decision Blueprint coming from the HLO and oversees the actual deployment of workloads in the selected IE(s). Being aware of the underlying container management frameworks, is able to convert the allocation order into proper deployment. Several LLOs may live in the same domain." .

onto:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "Represents a single instance of an IoT service with a unique identifier. A service is composed by one or some ServiceComponents." .

onto:ServiceType a owl:Class ;
    rdfs:label "Service Type" ;
    rdfs:comment "Identifies the services such as a \"catalogue\"." .

onto:InfrastructureElementRequirements a owl:Class ;
    rdfs:label "Infrastructure Element Requirements" ;
    rdfs:comment "Represents the IE requirements for running a service component." .

onto:InfrastructureElementStatus a owl:Class ;
    rdfs:label "Infrastructure Element Status" ;
    rdfs:comment "Represents the status of an IE. Possible types are READY, OVERLOAD, UNSECURE, UNTRUSTED." .

onto:InfrastructureElementTier a owl:Class ;
    rdfs:label "Infrastructure Element Tier" ;
    rdfs:comment "Represents the computing continuum tier (cloud, edge, ...) of an IE." .

onto:OrchestrationType a owl:Class ;
    rdfs:label "Orchestration Type" ;
    rdfs:comment "Container orchestration technology." .

onto:Domain a owl:Class ;
    rdfs:label "Domain" ;
    rdfs:comment "A set of one or more IEs, functionally connected and sharing a common instance of aerOS basic services among them, constituting an administrative domain able to be managed and orchestrated by aerOS Meta-OS and thus be part of the IoT-Edge-Cloud continuum." .

onto:ServiceComponentStatus a owl:Class ;
    rdfs:label "Service Component Status" .

onto:ServiceComponent a owl:Class ;
    rdfs:label "Service Component" ;
    rdfs:comment "Individual, deployable units that together constitute a Service in the aerOS ecosystem, each with a specific role or function." .

onto:InfrastructureElement a owl:Class ;
    rdfs:label "Infrastructure Element" ;
    rdfs:comment "\"The fundamental building block within aerOS Meta-OS. A physical or virtual computing resource providing the necessary processing power, storage capacity, and network connectivity to support containerised workloads and services.\\n\\nExposes aerOS runtime on top of provided capabilities being thus the minimum execution unit within the IoT-Edge-Cloud continuum.\"" .

