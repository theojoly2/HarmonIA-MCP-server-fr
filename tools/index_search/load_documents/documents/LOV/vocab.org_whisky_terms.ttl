@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://vocab.org/whisky/terms> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://vocab.org/whisky/terms/Brand> a rdfs:Class ;
    rdfs:label "brand" ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/Cask> a rdfs:Class ;
    rdfs:label "cask" ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/Distillery> a rdfs:Class ;
    rdfs:label "distillery" ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/WaterSource> a rdfs:Class ;
    rdfs:label "water source" ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/Whisky> a rdfs:Class ;
    rdfs:label "Whiskey",
        "Whisky" ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/WhiskyReview> a rdfs:Class ;
    rdfs:label "Whisky Review" ;
    rdfs:isDefinedBy onto: .

onto:.rdf a dcmitype:Text,
        foaf:Document ;
    dcterms:hasFormat onto:.html,
        onto:.json,
        onto:.turtle ;
    foaf:primaryTopic onto: ;
    foaf:topic onto: .

<http://vocab.org/whisky/terms/abv> a rdf:Property ;
    rdfs:label "alcohol by volume" ;
    rdfs:comment "a standard measure of how much alcohol is contained in the drink" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/age> a rdf:Property ;
    rdfs:label "age" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/agingCask> a rdf:Property ;
    rdfs:label "aging cask" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.org/whisky/terms/Cask> .

<http://vocab.org/whisky/terms/body> a rdf:Property ;
    rdfs:label "body" ;
    rdfs:domain <http://vocab.org/whisky/terms/WhiskyReview> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/brand> a rdf:Property ;
    rdfs:label "brand" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.org/whisky/terms/Brand> .

<http://vocab.org/whisky/terms/character> a rdf:Property ;
    rdfs:label "character" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/colour> a rdf:Property ;
    rdfs:label "colour" ;
    rdfs:domain <http://vocab.org/whisky/terms/WhiskyReview> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/colourDescription> a rdf:Property ;
    rdfs:label "colour description" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/distillery> a rdf:Property ;
    rdfs:label "distillery" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.org/whisky/terms/Distillery> .

<http://vocab.org/whisky/terms/expressionLabel> a rdf:Property ;
    rdfs:label "expression label" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/finish> a rdf:Property ;
    rdfs:label "finish" ;
    rdfs:domain <http://vocab.org/whisky/terms/WhiskyReview> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/finishingCask> a rdf:Property ;
    rdfs:label "finishing cask" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.org/whisky/terms/Cask> .

<http://vocab.org/whisky/terms/grain> a rdf:Property ;
    rdfs:label "grain" ;
    rdfs:domain <http://vocab.org/whisky/terms/Whisky> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/material> a rdf:Property ;
    rdfs:label "material" ;
    rdfs:domain <http://vocab.org/whisky/terms/Cask> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/nose> a rdf:Property ;
    rdfs:label "nose" ;
    rdfs:domain <http://vocab.org/whisky/terms/WhiskyReview> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/owner> a rdf:Property ;
    rdfs:label "owner" ;
    rdfs:domain <http://vocab.org/whisky/terms/Distillery> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Organization .

<http://vocab.org/whisky/terms/palate> a rdf:Property ;
    rdfs:label "palate" ;
    rdfs:domain <http://vocab.org/whisky/terms/WhiskyReview> ;
    rdfs:isDefinedBy onto: .

<http://vocab.org/whisky/terms/previousContents> a rdf:Property ;
    rdfs:label "previous contents" ;
    rdfs:domain <http://vocab.org/whisky/terms/Cask> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://umbel.org/umbel/ac/LiquidTangibleThing> .

<http://vocab.org/whisky/terms/region> a rdf:Property ;
    rdfs:label "region" ;
    rdfs:domain <http://vocab.org/whisky/terms/Distillery> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.org/whisky/terms/Region> .

<http://vocab.org/whisky/terms/waterSource> a rdf:Property ;
    rdfs:label "water source" ;
    rdfs:domain <http://vocab.org/whisky/terms/Distillery> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.org/whisky/terms/WaterSource> .

onto:.html a dcmitype:Text,
        foaf:Document ;
    rdfs:label "HTML" ;
    dc:format "text/html" .

onto:.json a dcmitype:Text,
        foaf:Document ;
    rdfs:label "JSON" ;
    dc:format "application/json" .

onto:.turtle a dcmitype:Text,
        foaf:Document ;
    rdfs:label "Turtle" ;
    dc:format "text/plain" .

onto: a owl:Ontology ;
    dc:title "Vocabulary for describing whisky varieties"@en ;
    rdfs:comment "Created at vocamp oxford 2008"@en .

