@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://cookingbigdata.com/linkeddata/ccregions> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://cookingbigdata.com/linkeddata/ccregions#AvailabilityZone> a rdfs:Class,
        owl:Class ;
    rdfs:label "Availability Zone"@en ;
    dcterms:description "Each region has multiple isolated locations known as Availability Zones."@en ;
    rdfs:comment "Availability Zone"@en ;
    rdfs:isDefinedBy onto: .

<http://cookingbigdata.com/linkeddata/ccregions#GeographicalZone> a rdfs:Class,
        owl:Class ;
    rdfs:label "Geographical Zone"@en ;
    dcterms:description "Each Region is hosted in a Geographical Area or Division."@en ;
    rdfs:comment "Geographical Zone"@en ;
    rdfs:isDefinedBy onto: .

<http://cookingbigdata.com/linkeddata/ccregions#Location> a rdfs:Class,
        owl:Class ;
    rdfs:label "Location"@en ;
    dcterms:description "Physical location"@en ;
    rdfs:comment "Location"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://cookingbigdata.com/linkeddata/ccregions#Region> .

<http://cookingbigdata.com/linkeddata/ccregions#Region> a rdfs:Class,
        owl:Class ;
    rdfs:label "Region"@en ;
    dcterms:description "A region is a physical location of a computer center where instances, servers, clusters, etc. are stored. A region is a separate geographic area"@en ;
    rdfs:comment "Region"@en ;
    rdfs:isDefinedBy onto: .

<http://cookingbigdata.com/linkeddata/ccregions#> a owl:Ontology ;
    rdfs:label "Cloud Computing regions and availability zones"@en ;
    dcterms:created "2018-03-06"^^xsd:date ;
    dcterms:creator <http://cookingbigdata.com/linkeddata/ccregions#manuelparra> ;
    dcterms:description "Ontology for the definition of regions and zones of availability on CloudComputing platforms and services. This ontology allows to define model of regions used in large cloud computing providers such as Amazon, Azure, etc."@en ;
    dcterms:issued "2018-04-20"^^xsd:date ;
    dcterms:modified "2018-04-03"^^xsd:date ;
    dcterms:publisher <http://cookingbigdata.com/linkeddata/ccregions#cookingbigdata> ;
    dcterms:rights "Copyright © 2018 Manuel Parra-Royón" ;
    dcterms:title "Vocabulary for Regions and Zones on Cloud Computing"@en ;
    owl:versionInfo 1.0 .

<http://cookingbigdata.com/linkeddata/ccregions#availabilityzone_name> a rdf:Property ;
    rdfs:label "AZ Name"@en ;
    rdfs:comment "Name of the Availability Zone"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#AvailabilityZone> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccregions#availabilityzone_status> a rdf:Property ;
    rdfs:label "AZ Status"@en ;
    rdfs:comment "Status of the Availability Zone"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#AvailabilityZone> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://cookingbigdata.com/linkeddata/ccregions#geographical_zone> a rdf:Property ;
    rdfs:label "Geo Name"@en ;
    rdfs:comment "Administrative Geographical area."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#GeographicalZone> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://schema.org/AdministrativeArea> .

<http://cookingbigdata.com/linkeddata/ccregions#hasAvailabilityZone> a rdf:Property ;
    rdfs:label "has Availability Zone"@en ;
    rdfs:comment "Each Zone has almost one Availability Zone"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#Region> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccregions#AvailabilityZone> .

<http://cookingbigdata.com/linkeddata/ccregions#hasGeographicalZone> a rdf:Property ;
    rdfs:label "has geographical zone"@en ;
    rdfs:comment "Each Region is hosted in a Geographical Area or Division"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#Region> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccregions#GeographicalZone> .

<http://cookingbigdata.com/linkeddata/ccregions#region_code> a rdf:Property ;
    rdfs:label "Region code"@en ;
    rdfs:comment "Short Code of the region."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#Region> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccregions#region_compilance> a rdf:Property ;
    rdfs:label "Geo Compilance"@en ;
    rdfs:comment "Compilance with geographical boundaries."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#Region> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccregions#region_dataresidency> a rdf:Property ;
    rdfs:label "Sovereignty Location"@en ;
    rdfs:comment "Region Data residency / Sovereignty Location."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#Region> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://schema.org/AdministrativeArea> .

<http://cookingbigdata.com/linkeddata/ccregions#region_endpoint> a rdf:Property ;
    rdfs:label "Region Endpoint"@en ;
    rdfs:comment "Region Endpoint is the URI of the main resource at the region."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#Region> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://schema.org/EntryPoint> .

<http://cookingbigdata.com/linkeddata/ccregions#region_location> a rdf:Property ;
    rdfs:label "Region Location"@en ;
    rdfs:comment "Physical Location for a region."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#Location> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://schema.org/Place> .

<http://cookingbigdata.com/linkeddata/ccregions#region_name> a rdf:Property ;
    rdfs:label "Region name"@en ;
    rdfs:comment "Name of the region."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccregions#Region> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccregions#cookingbigdata> a foaf:Organization ;
    rdfs:seeAlso <http://cookingbigdata.com/about> ;
    foaf:homepage <http://cookingbigdata.com> ;
    foaf:name "CookingBigData" .

<http://cookingbigdata.com/linkeddata/ccregions#manuelparra> a foaf:Person ;
    rdfs:seeAlso <https://twitter.com/manugrapevine> ;
    foaf:homepage <https://twitter.com/manugrapevine> ;
    foaf:mbox "manuparra@gmail.com" ;
    foaf:name "Manuel Parra-Royon" .

