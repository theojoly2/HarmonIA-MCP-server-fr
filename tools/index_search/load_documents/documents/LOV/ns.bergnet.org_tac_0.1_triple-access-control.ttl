@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix onto: <http://ns.bergnet.org/tac/0.1/triple-access-control> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

onto: a owl:Ontology ;
    dc:created "2011-09-02" ;
    dc:creator <http://www.bergnet.org/people/bergi/card#me> ;
    dc:description "TripleAccessControl extension for WebAccessControl"@en ;
    dc:title "TripleAccessControl Ontology"@en ;
    owl:imports dc:,
        <http://www.w3.org/2004/03/trix/rdfg-1/>,
        <http://www.w3.org/2006/gen/ont>,
        <http://www.w3.org/ns/auth/acl>,
        <http://www.w3.org/ns/auth/acl#>,
        foaf: ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#accessToTriple> a owl:ObjectProperty ;
    rdfs:label "accesToTriple"@en ;
    rdfs:comment "Contains triple authorization information."@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#TripleAuthorization>,
        <http://www.w3.org/ns/auth/acl#Authorization> ;
    rdfs:range <http://ns.bergnet.org/tac/0.1/triple-access-control#TripleAuthorization> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#children> a owl:ObjectProperty ;
    rdfs:label "children"@en ;
    rdfs:comment "Contains sub triple authorization informations."@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#TripleAuthorization> ;
    rdfs:range <http://ns.bergnet.org/tac/0.1/triple-access-control#Authorization> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#filter> a owl:ObjectProperty ;
    rdfs:label "filter"@en ;
    rdfs:comment "Contains triple filter rules."@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#TripleAuthorization> ;
    rdfs:range <http://ns.bergnet.org/tac/0.1/triple-access-control#Filter> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#graph> a owl:ObjectProperty ;
    rdfs:label "graph" ;
    rdfs:comment "Graph for a triple filter."@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#Filter> ;
    rdfs:range <http://www.w3.org/2004/03/trix/rdfg-1/Graph> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#mode> a owl:ObjectProperty ;
    rdfs:label "mode"@en ;
    rdfs:comment "Access mode is defined per triple authorization."@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#TripleAuthorization> ;
    rdfs:subPropertyOf <http://www.w3.org/ns/auth/acl#mode> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#object> a owl:ObjectProperty ;
    rdfs:label "object"@en ;
    rdfs:comment "Object for a triple filter"@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#Filter> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#predicate> a owl:ObjectProperty ;
    rdfs:label "predicate"@en ;
    rdfs:comment "Predicate for a triple filter."@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#Filter> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#required> a owl:ObjectProperty ;
    rdfs:label "required"@en ;
    rdfs:comment "If this property is true access to the parent triple is only granted if childrens are found."@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#TripleAuthorization> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#statement> a owl:ObjectProperty ;
    rdfs:label "statement"@en ;
    rdfs:comment "Statement for a triple filter."@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#Filter> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#subject> a owl:ObjectProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "Subject for a triple filter."@en ;
    rdfs:domain <http://ns.bergnet.org/tac/0.1/triple-access-control#Filter> ;
    ns1:term_status "testing"@en .

<http://ns.bergnet.org/tac/0.1/triple-access-control#Filter> a owl:Class ;
    rdfs:label "Filter"@en ;
    rdfs:comment "A triple filter."@en ;
    ns1:term_status "testing" .

<http://ns.bergnet.org/tac/0.1/triple-access-control#TripleAuthorization> a owl:Class ;
    rdfs:label "TripleAuthorization"@en ;
    rdfs:comment "A triple authorization."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/auth/acl#Authorization> ;
    ns1:term_status "testing"@en .

