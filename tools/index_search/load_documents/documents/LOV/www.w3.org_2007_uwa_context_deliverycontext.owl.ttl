@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2007/uwa/context/common.owl#> .
@prefix ns2: <http://www.w3.org/2007/uwa/context/software.owl#> .
@prefix ns3: <http://www.w3.org/2007/uwa/context/web.owl#> .
@prefix ns4: <http://www.w3.org/2007/uwa/context/hardware.owl#> .
@prefix ns5: <http://www.w3.org/2007/uwa/context/java.owl#> .
@prefix ns6: <http://www.w3.org/2007/uwa/context/network.owl#> .
@prefix ns7: <http://www.w3.org/2007/uwa/context/location.owl#> .
@prefix ns8: <http://www.w3.org/2007/uwa/context/push.owl#> .
@prefix ns9: <http://www.w3.org/2007/uwa/context/deliverycontext.owl#> .
@prefix onto: <http://www.w3.org/2007/uwa/context/deliverycontext.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.example.org/2007/uwa/context/examples.owl#ARM9> a ns4:CPU ;
    rdfs:comment "The ARM ARM9 central processing unit"^^xsd:string ;
    ns1:model "ARM9"^^xsd:string ;
    ns4:maxCpuFrequency "4000"^^xsd:int .

<http://www.example.org/2007/uwa/context/examples.owl#Camera_Hypothetical_Device> a ns4:Camera ;
    rdfs:comment "This represents the camera on a Hypothetical Device"^^xsd:string ;
    ns1:resolutionWidth "307000"^^xsd:int .

<http://www.example.org/2007/uwa/context/examples.owl#ExampleDC_1> a ns9:DeliveryContext ;
    rdfs:comment "Example of a Delivery Context"^^xsd:string ;
    ns9:currentDevice <http://www.example.org/2007/uwa/context/examples.owl#Device_Hypothetical> ;
    ns9:currentEnvironment <http://www.example.org/2007/uwa/context/examples.owl#Environment_2> ;
    ns9:currentNetworkBearer <http://www.example.org/2007/uwa/context/examples.owl#NetworkBearer_2> ;
    ns9:currentUserAgent <http://www.example.org/2007/uwa/context/examples.owl#WebBrowser_x> ;
    ns9:usablePixelsX "340"^^xsd:int ;
    ns9:usablePixelsY "220"^^xsd:int .

