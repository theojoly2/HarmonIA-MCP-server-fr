    ns1:id "getElementById"^^xsd:string ;
    ns1:name ""^^xsd:string ;
    ns1:restrictedElement ns3:WebBrowserApi_DOM_LEVEL_1 ;
    ns1:restrictionValue true .

<http://www.example.org/2007/uwa/context/examples.owl#FeatureRestriction_17> a ns1:FeatureRestriction ;
    ns1:id "getElementById"^^xsd:string ;
    ns1:name ""^^xsd:string ;
    ns1:restrictedElement ns3:WebBrowserApi_DOM_LEVEL_1 ;
    ns1:restrictionValue false .

<http://www.example.org/2007/uwa/context/examples.owl#FeatureRestriction_4> a ns1:FeatureRestriction ;
