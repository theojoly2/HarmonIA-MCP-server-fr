    ns1:id "_GUTS/R-Data"^^xsd:string ;
    ns1:name "GUTS/R-Data"^^xsd:string .

ns6:BearerType_HSCSD a ns6:NetworkBearerTechnology ;
    rdfs:comment "High-Speed Circuit-Switched Data"^^xsd:string ;
    ns1:id "_HSCSD"^^xsd:string ;
    ns1:name "HSCSD"^^xsd:string .

ns6:BearerType_HSUPA a ns6:NetworkBearerTechnology ;
    rdfs:comment "High-Speed Uplink Packet Access"^^xsd:string ;
    ns1:id "_HSUPA"^^xsd:string ;
    ns1:name "HSUPA"^^xsd:string .

ns6:BearerType_MPAK a ns6:NetworkBearerTechnology ;
    ns1:id "_MPAK"^^xsd:string ;
    ns1:name "MPAK"^^xsd:string .

ns6:BearerType_PACKET a ns6:NetworkBearerTechnology ;
    rdfs:comment "Generic packet-based bearer"^^xsd:string ;
    ns1:id "_PACKET"^^xsd:string ;
    ns1:name "PACKET"^^xsd:string .

ns6:BearerType_REFLEX a ns6:NetworkBearerTechnology ;
    ns1:id "_REFLEX"^^xsd:string ;
    ns1:name "REFLEX"^^xsd:string .

ns6:BearerType_SDS a ns6:NetworkBearerTechnology ;
    ns1:id "_SDS"^^xsd:string ;
    ns1:name "SDS"^^xsd:string .

ns6:BearerType_SMS a ns6:NetworkBearerTechnology ;
    ns1:id "_SMS"^^xsd:string ;
    ns1:name "SMS"^^xsd:string .

ns6:BearerType_USSD a ns6:NetworkBearerTechnology ;
    rdfs:comment "Unstructured Supplementary Service Data is a capability of all GSM phones. It is generally associated with real-time or instant messaging type phone services."^^xsd:string ;
    ns1:id "_USSD"^^xsd:string ;
    ns1:name "USSD"^^xsd:string .

ns6:IS-95_800_1900 a ns6:NetworkMode ;
    ns6:networkTechnology ns6:NetworkType_IS-95 ;
    ns6:operationBands "800"^^xsd:long,
        "1900"^^xsd:long .

ns6:NetworkType_AMPS a ns6:NetworkTechnology ;
    rdfs:comment "Advanced Mobile Phone System"^^xsd:string ;
    ns1:id "_AMPS"^^xsd:string ;
    ns1:name "AMPS"^^xsd:string .

ns6:NetworkType_CDMA2000_1xRTT a ns6:NetworkTechnology ;
    rdfs:comment "CDMA 2000 1xRTT"^^xsd:string ;
    ns1:id "_CDMA2000_1xRTT"^^xsd:string ;
    ns1:name "1xrtt"^^xsd:string,
        "CDMA2000_1xRTT"^^xsd:string .

ns6:NetworkType_CDMA2000_EVDO a ns6:NetworkTechnology ;
    ns1:id "_CDMA2000_EVDO"^^xsd:string ;
    ns1:name "CDMA2000 EVDO"^^xsd:string,
        "EVDO"^^xsd:string .

ns6:NetworkType_CDMA2000_EVDV a ns6:NetworkTechnology ;
    ns1:id "_CDMA2000_EVDV"^^xsd:string ;
    ns1:name "CDMA2000 EVDV"^^xsd:string .

ns6:NetworkType_HSDPA a ns6:NetworkBearerTechnology ;
    rdfs:comment "High-Speed Downlink Packet Access"^^xsd:string ;
    ns1:id "_HSDPA"^^xsd:string ;
    ns1:name "HSDPA"^^xsd:string .

ns6:NetworkType_IEEE_802.11a a ns6:NetworkTechnology ;
    rdfs:comment "WiFi 802.11a"^^xsd:string ;
    ns1:id "IEEE 802.11a"^^xsd:string ;
    ns1:name "IEEE 802.11a"^^xsd:string .

ns6:NetworkType_IEEE_802.11g a ns6:NetworkTechnology ;
    rdfs:comment "Wi-Fi 802.11g"^^xsd:string ;
    ns1:id "IEEE 802.11g"^^xsd:string ;
    ns1:name "IEEE 802.11g"^^xsd:string .

ns6:NetworkType_Mobitex a ns6:NetworkTechnology ;
    rdfs:comment "MobiTex Network"^^xsd:string ;
    ns1:id "_Mobitex"^^xsd:string ;
    ns1:name "Mobitex"^^xsd:string .

ns6:NetworkType_PHS a ns6:NetworkTechnology ;
    rdfs:comment "Personal Handy-phone System"^^xsd:string ;
    ns1:id "_PHS"^^xsd:string ;
    ns1:name "PHS"^^xsd:string .

ns6:NetworkType_TD-SCDMA a ns6:NetworkTechnology ;
    rdfs:comment "Chinese standard"^^xsd:string ;
    ns1:id "_TD_SCDMA"^^xsd:string ;
    ns1:name "TD-SCDMA"^^xsd:string .

ns6:Networks_Disjoint a ns1:AllDisjointSet ;
    ns1:disjointClass "net:PLMNetwork"^^xsd:string,
        "net:WiFiNetwork"^^xsd:string,
        "net:WiredNetwork"^^xsd:string .

ns6:PDC_800_1500 a ns6:NetworkMode ;
    ns6:networkTechnology ns6:NetworkType_PDC ;
    ns6:operationBands "800"^^xsd:long,
        "1500"^^xsd:long .

ns6:Proxies_Disjoint a ns1:AllDisjointSet ;
    ns1:disjointClass "net:NonTransparentProxy"^^xsd:string,
        "net:TransparentProxy"^^xsd:string .

ns6:SiblingDisjoint_2 a ns1:AllDisjointSet ;
    ns1:disjointClass "net:Network"^^xsd:string,
        "net:NetworkBearer"^^xsd:string,
        "net:Proxy"^^xsd:string ;
    ns1:disjointSet ns6:Sibling_Disjoint .

ns6:Tetra_400_900 a ns6:NetworkMode ;
    ns6:networkTechnology ns6:NetworkType_TETRA ;
    ns6:operationBands "400"^^xsd:long,
        "900"^^xsd:long .

ns6:TransparentProxy a owl:Class ;
    rdfs:label "Transparent HTTP Proxy"^^xsd:string ;
    rdfs:comment "An HTTP proxy that does not modify the request or response beyond what is required for proxy authentication and identification."^^xsd:string ;
    rdfs:subClassOf ns6:HttpProxy ;
    ns1:normativeReference "http://www.ietf.org/rfc/rfc2616.txt"^^xsd:anyURI .

ns6:UMTS a ns6:NetworkBearerTechnology ;
    ns1:id "_UMTS"^^xsd:string ;
    ns1:name "UMTS"^^xsd:string .

ns6:UMTS_2100 a ns6:NetworkMode ;
    ns6:networkTechnology ns6:NetworkType_UMTS_W-CDMA ;
    ns6:operationBands "2100"^^xsd:long .

ns6:WiFi80211b_2400 a ns6:NetworkMode ;
    ns6:networkTechnology ns6:NetworkType_IEEE_802.11b ;
    ns6:operationBands "2400"^^xsd:long .

ns6:WiredNetwork a owl:Class ;
    rdfs:label "Wired Network"^^xsd:string ;
    rdfs:comment "This class represents a wired network in general"^^xsd:string ;
    rdfs:subClassOf ns6:Network .

ns6:availableNetworkBearers a owl:ObjectProperty ;
    rdfs:label "Available Network Bearers"^^xsd:string ;
    rdfs:comment "The available network bearers offered by a Network or available for a Device"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns6:Network ns6:NetworkSupport ) ] ;
    rdfs:range ns6:NetworkBearer ;
    rdfs:subPropertyOf ns1:available,
        ns9:component,
        ns6:supportedNetworkBearers .

ns6:bandwidthSupport a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Bandwidth Support"^^xsd:string ;
    rdfs:comment "The bandwidth support offered by a Network Bearer Technology"^^xsd:string ;
    rdfs:domain ns6:NetworkBearerTechnology ;
    rdfs:range ns6:BandwidthSupport ;
    rdfs:subPropertyOf ns1:supports .

ns6:bearerNetwork a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Bearer Network"^^xsd:string ;
    rdfs:comment "The network that provides the infraestructure of a Network Bearer"^^xsd:string ;
    rdfs:domain ns6:NetworkBearer ;
    rdfs:range ns6:Network .

ns6:cellId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Cell Identifier"^^xsd:string ;
    rdfs:comment "The id of the cell to which the device is interacting with in the mobile network"^^xsd:string ;
    rdfs:domain ns6:NetworkSupport ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns1:id .

ns6:connectedNetworks a owl:ObjectProperty ;
    rdfs:label "Connected Networks"^^xsd:string ;
    rdfs:comment "The networks to which a device is currently connected"^^xsd:string ;
    rdfs:domain ns6:NetworkSupport ;
    rdfs:range ns6:Network .

ns6:defaultNetworkBearer a owl:ObjectProperty ;
    rdfs:label "Default Network Bearer"^^xsd:string ;
    rdfs:comment "This property represents the default Network Bearer for a Device"^^xsd:string ;
    rdfs:domain ns6:NetworkSupport ;
    rdfs:range ns6:NetworkBearer ;
    rdfs:subPropertyOf ns9:defaultComponent,
        ns6:supportedNetworkBearers .

ns6:homePLMNetwork a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Home Network"^^xsd:string ;
    rdfs:comment "The home PLMN network of a device"^^xsd:string ;
    rdfs:domain ns6:NetworkSupport ;
    rdfs:range ns6:PLMNetwork .

ns6:iDEN_800 a ns6:NetworkMode ;
    ns6:networkTechnology ns6:NetworkType_iDEN ;
    ns6:operationBands "800"^^xsd:long .

ns6:networkSupport a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Network Support"^^xsd:string ;
    rdfs:comment "The network-related characteristics of a device"^^xsd:string ;
    rdfs:domain ns9:Device ;
    rdfs:range ns6:NetworkSupport .

ns6:preferredNetworkBearer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Preferred Network Bearer"^^xsd:string ;
    rdfs:comment "This property represents the preferred network bearer for a Network"^^xsd:string ;
    rdfs:domain ns6:Network ;
    rdfs:range ns6:NetworkBearer ;
    rdfs:subPropertyOf ns6:supportedNetworkBearers .

ns6:presentNetworks a owl:ObjectProperty ;
    rdfs:label "Present Networks"^^xsd:string ;
    rdfs:comment "The networks that are present in the current Environment"^^xsd:string ;
    rdfs:domain ns9:Environment ;
    rdfs:range ns6:Network .

ns6:proxy a owl:ObjectProperty ;
    rdfs:label "Proxy"^^xsd:string ;
    rdfs:comment "This property represents one or more proxies that can be present while using a Network Bearer"^^xsd:string ;
    rdfs:domain ns6:NetworkBearer ;
    rdfs:range ns6:HttpProxy ;
    rdfs:subPropertyOf ns9:activeComponent .

ns6:signalStrength a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Signal Strength"^^xsd:string ;
    rdfs:comment "This property indicates the relative (from 0 to 100) signal strength offered by a Network in this Context"^^xsd:string ;
    rdfs:domain ns6:Network ;
    rdfs:range xsd:int .

ns8:applicationIds a owl:DatatypeProperty ;
    rdfs:label "Push Application Ids"^^xsd:string ;
    rdfs:comment "This property represents the list of types of Push-enabled applications supported by the device. Application identifiers are represented on absolute URI format. A wildcard (\"*\") may be used to indicate support for any application"^^xsd:string ;
    rdfs:domain ns2:DeviceSoftware ;
    rdfs:range xsd:string ;
    ns1:normativeReference "http://www.openmobilealliance.org/tech/omna/omna-push-app-id.htm"^^xsd:anyURI .

ns8:defaultMmsClient a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Default MMS Client"^^xsd:string ;
    rdfs:comment "The default MMS client on the device"^^xsd:string ;
    rdfs:domain ns2:DeviceSoftware ;
    rdfs:range ns8:MmsClient ;
    rdfs:subPropertyOf ns9:defaultComponent,
        ns2:availableUserAgents ;
    ns1:relatedUAProfEntity "MmsCharacteristics"^^xsd:string .

ns8:defaultWapPushClient a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Default WAP Push Client"^^xsd:string ;
    rdfs:comment "The default WAP Push Client on a device"^^xsd:string ;
    rdfs:domain ns2:DeviceSoftware ;
    rdfs:range ns8:WapPushClient ;
    rdfs:subPropertyOf ns9:defaultComponent,
        ns2:availableUserAgents ;
    ns1:relatedUAProfEntity "PushCharacteristics"^^xsd:string .

ns8:maxMmsMessageSize a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "MMS Maximum Message Size"^^xsd:string ;
    rdfs:comment "The maximum size of an interchanged message in byes"^^xsd:string ;
    rdfs:domain ns8:MmsClient ;
    rdfs:range xsd:unsignedLong ;
    rdfs:subPropertyOf ns2:maxDeliveryUnitSize ;
    ns1:relatedUAProfEntity "MmsMaxMessageSize"^^xsd:string .

ns8:maxWapPushMessageSize a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "WAP Push Maximum Message Size"^^xsd:string ;
    rdfs:comment "THe maximum message size supported by the WAP Push User Agent in bytes"^^xsd:string ;
    rdfs:domain ns8:WapPushClient ;
    rdfs:range xsd:unsignedLong ;
    rdfs:subPropertyOf ns2:maxDeliveryUnitSize ;
    ns1:relatedUAProfEntity "Push-MsgSize"^^xsd:string .

ns8:maxWapPushRequests a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "WAP Push Maximum Number of Requests"^^xsd:string ;
    rdfs:comment "The maximum number of WAP Push requests that the WAP Push User Agent is capable to deal with"^^xsd:string ;
    rdfs:domain ns8:WapPushClient ;
    rdfs:range xsd:int ;
    ns1:relatedUAProfEntity "Push-MaxPushReq"^^xsd:string .

ns2:AudioPlayer a owl:Class ;
    rdfs:label "Audio Player"^^xsd:string ;
    rdfs:comment "This class represents a user agent capable of dealing with audio formats"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:supportedFormats ;
            owl:someValuesFrom ns2:AudioFormat ],
        ns2:MediaPlayer .

ns2:AudioRecorder a owl:Class ;
    rdfs:label "Audio Recorder"^^xsd:string ;
    rdfs:comment "This class represents a user agent capable of recording audio"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:supportedFormats ;
            owl:someValuesFrom ns2:AudioFormat ],
        ns2:MediaRecorder .

ns2:EmailClient a owl:Class ;
    rdfs:label "E-Mail Client"^^xsd:string ;
    rdfs:comment "This class represents a user agent capable of sending and receiving e-mail"^^xsd:string ;
    rdfs:subClassOf ns2:UserAgent .

ns2:FontFamily_CURSIVE a ns2:FontFamily ;
    rdfs:label "Cursive"^^xsd:string ;
    rdfs:comment "Generic Cursive Family"^^xsd:string ;
    ns1:id "__FontFamily_Cursive"^^xsd:string ;
    ns1:name "Cursive"^^xsd:string ;
    ns1:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#cursive-def"^^xsd:anyURI ;
    ns1:normativeStatus ns1:Normative .

ns2:FontFamily_FANTASY a ns2:FontFamily ;
    rdfs:label "Fantasy"^^xsd:string ;
    rdfs:comment "Generic Fantasy Family"^^xsd:string ;
    ns1:id "__FontFamily_Fantasy"^^xsd:string ;
    ns1:name "Fantasy"^^xsd:string ;
    ns1:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#fantasive-def"^^xsd:anyURI ;
    ns1:normativeStatus ns1:Normative .

ns2:FontFamily_MONOSPACE a ns2:FontFamily ;
    rdfs:label "Monospace"^^xsd:string ;
    rdfs:comment "Generic Monospace Family"^^xsd:string ;
    ns1:id "__FontFamily_MonoSpace"^^xsd:string ;
    ns1:name "Monospace"^^xsd:string ;
    ns1:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#monospace-def"^^xsd:anyURI ;
    ns1:normativeStatus ns1:Normative .

ns2:FontFamily_SANS_SERIF a ns2:FontFamily ;
    rdfs:label "Sans Serif"^^xsd:string ;
    rdfs:comment "Generic Sans Serif Family"^^xsd:string ;
    ns1:id "__FontFamily_SansSerif"^^xsd:string ;
    ns1:name "Sansserif"^^xsd:string ;
    ns1:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#sans-serif-def"^^xsd:anyURI ;
    ns1:normativeStatus ns1:Normative .

ns2:FontFamily_SERIF a ns2:FontFamily ;
    rdfs:label "Serif"^^xsd:string ;
    rdfs:comment "Generic Serif Family"^^xsd:string ;
    ns1:id "__FontFamily_Serif"^^xsd:string ;
    ns1:name "Serif"^^xsd:string ;
    ns1:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#serif-def"^^xsd:anyURI ;
    ns1:normativeStatus ns1:Normative .

ns2:FontStyle_ITALICS a ns2:FontStyle ;
    rdfs:label "Italics"^^xsd:string ;
    rdfs:comment "Italics style"^^xsd:string ;
    ns1:id "__FontStyle_Italics"^^xsd:string ;
    ns1:name "Italics"^^xsd:string ;
    ns1:normativeStatus ns1:Normative .

ns2:FontStyle_NORMAL a ns2:FontStyle ;
    rdfs:label "Normal"^^xsd:string ;
    rdfs:comment "Normal Style"^^xsd:string ;
    ns1:id "__FontStyle_Normal"^^xsd:string ;
    ns1:name "Normal"^^xsd:string ;
    ns1:normativeStatus ns1:Normative .

ns2:FontStyle_OBLIQUE a ns2:FontStyle ;
    rdfs:label "Oblique"^^xsd:string ;
    rdfs:comment "Oblique Style"^^xsd:string ;
    ns1:id "__FontStyle_Oblique"^^xsd:string ;
    ns1:name "Oblique"^^xsd:string ;
    ns1:normativeStatus ns1:Normative .

ns2:MP3 a ns2:AudioFormat ;
    rdfs:comment "MP3 audio format"^^xsd:string ;
    ns1:id "_MP3"^^xsd:string ;
    ns1:name "MPEG-3"^^xsd:string .

ns2:MP4 a ns2:VideoFormat ;
    rdfs:comment "The MP4 video format"^^xsd:string ;
    ns1:id "_MP4"^^xsd:string ;
    ns1:name "MP4"^^xsd:string,
        "MPEG-4"^^xsd:string ;
    ns1:version "4"^^xsd:string .

ns2:PDF a ns2:Format ;
    ns1:id "_PDF"^^xsd:string ;
    ns1:name "PDF"^^xsd:string .

ns2:PJPG a ns2:ImageFormat ;
    rdfs:comment "The progressive JPEG file image format image type."^^xsd:string ;
    ns1:id "_PJPG"^^xsd:string ;
    ns1:name "PJPG"^^xsd:string .

ns2:Plugin a owl:Class ;
    rdfs:label "Plugin"^^xsd:string ;
    rdfs:comment "This class represents a plugin, i.e. a software piece which extends the functionality offered by a host application (web browser, drawing application, etc)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns1:version ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty ns1:name ],
        ns2:Context_SoftwareEntity,
        ns2:SoftwareAspect .

ns2:Program_Disjoint a ns1:AllDisjointSet ;
    ns1:disjointClass "soft:Application"^^xsd:string,
        "soft:OperatingSystem"^^xsd:string,
        "soft:RuntimeEnvironment"^^xsd:string .

ns2:SiblingDisjoint4 a ns1:AllDisjointSet ;
    ns1:disjointSet ns2:SiblingDisjoint2,
        ns2:Sibling_Disjoint1,
        ns2:Sibling_Disjoint3 .

ns2:VideoRecorder a owl:Class ;
    rdfs:label "Video Recorder"^^xsd:string ;
    rdfs:comment "This class represents a user agent capable of recording video"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:supportedFormats ;
            owl:someValuesFrom ns2:VideoFormat ],
        ns2:MediaRecorder .

ns2:acceptedCharacterSets a owl:ObjectProperty ;
    rdfs:label "Accepted Character Sets"^^xsd:string ;
    rdfs:comment "This property represents the charsets accepted  by a user agent"^^xsd:string ;
    rdfs:domain ns2:Program ;
    rdfs:range ns1:CharacterSet ;
    rdfs:subPropertyOf ns1:supports ;
    ns1:relatedUAProfEntity "CcppAccept-Charset"^^xsd:string,
        "MmsCcppAcceptCharSet"^^xsd:string,
        "Push-Accept-Charset"^^xsd:string .

ns2:acceptedTransferEncodings a owl:ObjectProperty ;
    rdfs:label "Accepted Transfer Encodings"^^xsd:string ;
    rdfs:comment "The accepted transfer encodings supported by a user agent."^^xsd:string ;
    rdfs:domain ns2:Program ;
    rdfs:range ns1:TransferEncoding ;
    rdfs:subPropertyOf ns1:supports ;
    ns1:relatedUAProfEntity "CcppAccept-Encoding"^^xsd:string,
        "MmsCcppAcceptEncoding"^^xsd:string,
        "Push-Accept-Encoding"^^xsd:string .

ns2:apis a owl:ObjectProperty ;
    rdfs:label "APIs"^^xsd:string ;
    rdfs:comment "The  APIs supported by a user agent"^^xsd:string ;
    rdfs:domain ns2:UserAgent ;
    rdfs:range ns2:Api ;
    rdfs:subPropertyOf ns1:supports .

ns2:applicationProtocols a owl:ObjectProperty ;
    rdfs:label "Supported Application Protocols"^^xsd:string ;
    rdfs:comment "This property represents the  application protocols by a program"^^xsd:string ;
    rdfs:domain ns2:Program ;
    rdfs:range ns1:ApplicationProtocol ;
    rdfs:subPropertyOf ns1:supports ;
    ns1:relatedUAProfEntity "Push-SupportedBearers"^^xsd:string .

ns2:certificates a owl:ObjectProperty ;
    rdfs:label "Certificates"^^xsd:string ;
    rdfs:comment "Installed certificates in a device or user agent"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns2:DeviceSoftware ns2:UserAgent ) ] ;
    rdfs:range ns2:Certificate ;
    rdfs:subPropertyOf ns1:available .

ns2:characterColumns a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Character Columns"^^xsd:string ;
    rdfs:comment "The typical number of characters that can be displayed in a single row on the device display. This is an estimate using the default font for the device"^^xsd:string ;
    rdfs:domain ns9:Device ;
    rdfs:range xsd:int ;
    ns1:relatedUAProfEntity "ScreenSizeChar"^^xsd:string .

ns2:characterRows a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Character Rows"^^xsd:string ;
    rdfs:comment "The typical number of rows of characters that can be displayed on the device display. This is an estimate using the default font for the device"^^xsd:string ;
    rdfs:domain ns9:Device ;
    rdfs:range xsd:int ;
    ns1:relatedUAProfEntity "ScreenSizeChar"^^xsd:string .

ns2:contentType a owl:ObjectProperty ;
    rdfs:label "MIME Type"^^xsd:string ;
    rdfs:comment "These are the MIME types associated with this type of format"^^xsd:string ;
    rdfs:domain ns2:Format ;
    rdfs:range ns1:ContentType .

ns2:defaultHandler a owl:ObjectProperty ;
    rdfs:label "Default Handler"^^xsd:string ;
    rdfs:comment "This property represents a default handler"^^xsd:string ;
    rdfs:domain ns2:DeviceSoftware ;
    rdfs:range ns2:HandlingAssociation ;
    rdfs:subPropertyOf ns1:default .

ns2:fonts a owl:ObjectProperty ;
    rdfs:label "Fonts"^^xsd:string ;
    rdfs:comment "The fonts provided by a Context Entity. It can be the Device Software in general, a Web Browser or other program"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns2:Program ns2:DeviceSoftware ) ] ;
    rdfs:range ns2:Font ;
    rdfs:subPropertyOf ns1:available .

ns2:gif87 a ns2:ImageFormat ;
    ns1:id "_GIF87"^^xsd:string ;
    ns1:name "GIF"^^xsd:string,
        "GIF87"^^xsd:string ;
    ns1:version "87"^^xsd:string .

ns2:jpeg a ns2:ImageFormat ;
    rdfs:comment "The JPEG file image format image type."^^xsd:string ;
    ns1:id "_JPEG"^^xsd:string ;
    ns1:name "JPEG"^^xsd:string,
        "JPG"^^xsd:string .

ns2:operatingSystem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Active Operating System"^^xsd:string ;
    rdfs:comment "This is the active operating system"^^xsd:string ;
    rdfs:domain ns2:DeviceSoftware ;
    rdfs:range ns2:OperatingSystem ;
    rdfs:subPropertyOf ns9:activeComponent .

ns2:png a ns2:ImageFormat ;
    rdfs:comment "The PNG file image format image type."^^xsd:string ;
    ns1:id "_PNG"^^xsd:string ;
    ns1:name "PNG"^^xsd:string .

ns2:preferredFormats a owl:ObjectProperty ;
    rdfs:label "Preferred Formats"^^xsd:string ;
    rdfs:comment "The best supported formats"^^xsd:string ;
    rdfs:range ns2:Format ;
    rdfs:subPropertyOf ns2:supportedFormats .

ns2:supportedStreamedFormats a owl:ObjectProperty ;
    rdfs:label "Supported Streamed Formats"^^xsd:string ;
    rdfs:comment "This property represents the formats that are supported by a program in streaming mode"^^xsd:string ;
    rdfs:subPropertyOf ns2:supportedFormats .

ns3:CTransformationProxy a owl:Class ;
    rdfs:label "Content Transformation Proxy"^^xsd:string ;
    rdfs:comment "This class represents a Content Transformation Proxy, an intermediary in the communications path between a web browser and the origin server. These intermediary adjust HTML pages designed for desktop presentation to provide an enhanced user experience when accessed from a mobile device."^^xsd:string ;
    rdfs:subClassOf ns6:NonTransparentProxy ;
    ns1:informativeReference "http://www.w3.org/TR/ct-landscape/"^^xsd:string .

