    ns1:name ""^^xsd:string ;
    ns1:restrictedElement ns2:gif89a ;
    ns1:restrictionValue 5 .

<http://www.example.org/2007/uwa/context/examples.owl#FeatureRestriction_14> a ns1:FeatureRestriction ;
