@prefix ns1: <http://topbraid.org/tosh#> .
@prefix ns2: <http://datashapes.org/dash#> .
@prefix onto: <http://datashapes.org/graphql> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://datashapes.org/graphql#InputObjectType> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Input object type" ;
    rdfs:comment "Represents an input object type in a GraphQL schema." ;
    rdfs:subClassOf rdfs:Resource ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#InputValue> ;
            sh:description "The input value(s) of the input object type." ;
            sh:name "input value" ;
            sh:path <http://datashapes.org/graphql#inputValue> ] .

<http://datashapes.org/graphql#InputType> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Input type" ;
    ns2:abstract true ;
    rdfs:subClassOf rdfs:Resource .

<http://datashapes.org/graphql#InputValue> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Input value" ;
    rdfs:comment "The definition of an input value, consisting of a name, type and an optional default value." ;
    rdfs:subClassOf rdfs:Resource ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#InputType> ;
            sh:description "The allowed type of the input value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:path <http://datashapes.org/graphql#type> ],
        [ a sh:PropertyShape ;
            sh:description "The default value (if any), as an RDF node." ;
            sh:maxCount 1 ;
            sh:name "default value" ;
            sh:path <http://datashapes.org/graphql#defaultValue> ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "The GraphQL name of the input type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://datashapes.org/graphql#name> ] .

<http://datashapes.org/graphql#JSON2RDFTestCase> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "JSON-to-RDF test case" ;
    rdfs:comment "A test case that can be used to verify that a given JSON object is translated into RDF triples using shape definitions from a given graphql:Service. The service must be in the test case graph." ;
    rdfs:subClassOf ns2:TestCase ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "The JSON text." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "json" ;
            sh:path <http://datashapes.org/graphql#json> ],
        [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#Schema> ;
            sh:description "The GraphQL service." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "service" ;
            sh:nodeKind sh:IRI ;
            sh:path <http://datashapes.org/graphql#schema> ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "The TTL of the resulting RDF." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ns2:expectedResult ] .

<http://datashapes.org/graphql#ListType> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "List type" ;
    rdfs:subClassOf <http://datashapes.org/graphql#InputType> ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#InputType> ;
            sh:description "The type of members." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "member type" ;
            sh:nodeKind sh:BlankNode ;
            sh:path <http://datashapes.org/graphql#memberType> ] .

<http://datashapes.org/graphql#MutationTestCase> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "GraphQL mutation test case" ;
    rdfs:comment "A test case that runs a given GraphQL mutation (graphql:query) and compares its output JSON with an expected JSON string. Formatting of the strings is ignored. The mutation is executed over a given \"before\" graph which must be isomorphic to a given \"after\" graph. The TestCase is also a graphql:Schema defining which shapes to publish." ;
    rdfs:subClassOf ns2:TestCase,
        <http://datashapes.org/graphql#Query>,
        <http://datashapes.org/graphql#Schema> ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "The TTL source code of the expected graph \"after\" the mutation. Uses the same namespace prefixes as the test case." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "after graph" ;
            sh:path <http://datashapes.org/graphql#expectedGraph> ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "The TTL source code of the graph \"before\" the mutation. Uses the same namespace prefixes as the test case." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "before graph" ;
            sh:path <http://datashapes.org/graphql#dataGraph> ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "The expected JSON response object as a string." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ns2:expectedResult ] .

<http://datashapes.org/graphql#NamedType> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Named type" ;
    rdfs:subClassOf <http://datashapes.org/graphql#InputType> ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "The type name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://datashapes.org/graphql#name> ] .

<http://datashapes.org/graphql#NonNullType> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Non null type" ;
    rdfs:subClassOf <http://datashapes.org/graphql#InputType> ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#InputType> ;
            sh:description "The type that is not-nulled." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:nodeKind sh:BlankNode ;
            sh:path <http://datashapes.org/graphql#type> ] .

<http://datashapes.org/graphql#Query> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "GraphQL query" ;
    rdfs:comment "Represents specific GraphQL queries, stored by their query string and possibly other properties with metadata." ;
    rdfs:subClassOf rdfs:Resource ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://datashapes.org/graphql#queryString> ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <http://datashapes.org/graphql#variables> ] .

<http://datashapes.org/graphql#QueryTestCase> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "GraphQL query test case" ;
    rdfs:comment "A test case that runs a given GraphQL query (graphql:query) and compares its output JSON with an expected JSON string. Formatting of the strings is ignored. The TestCase is also a graphql:Schema defining which shapes to publish." ;
    rdfs:subClassOf ns2:TestCase,
        <http://datashapes.org/graphql#Query>,
        <http://datashapes.org/graphql#Schema> ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "The expected JSON response object as a string." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ns2:expectedResult ] .

<http://datashapes.org/graphql#ScalarType> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Scalar type" ;
    rdfs:comment "Represents a scalar type as defined by a GraphQL schema. The primary purpose of these types is for round-tripping, otherwise they are basically the same as node shapes. The instances must be URIs, and the GraphQL name is derived from them.\\n\\nThis is currently not marked as a subClassOf sh:NodeShape, although this may happen in the future. The idea is that we don't want all constraint parameters to apply here, only selected ones such as sh:datatype. In the SHACL spec, anything that has constraints counts as a node shape, even if it doesn't have a matching rdf:type triple." ;
    rdfs:subClassOf rdfs:Resource ;
    sh:property [ a sh:PropertyShape ;
            sh:description "The (RDF/XSD) datatype that this scalar type refers to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path sh:datatype ] .

<http://datashapes.org/graphql#Schema> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "GraphQL Schema" ;
    rdfs:comment "A collection of shapes that are part of a GraphQL schema. Includes declarations about which shapes shall be exposed/published by a GraphQL service. The set of public node shapes consists of all values of graphql:publicShape, all values of graphql:publicClass and their subclasses, all node shapes from any namespace graphql:publicNamespace, minus any explicitly excluded shapes via graphql:privateShape.\\n\\nAn RDF graph may contain multiple GraphQL schemas, each providing a different API or view on the underlying data. GraphQL services can include each other using owl:imports. To simplify common usage patterns, owl:Ontology has been marked as a subclass, so that all Ontologies are also graphql:Schemas once this graphql namespace is imported." ;
    rdfs:subClassOf rdfs:Resource ;
    sh:nodeKind sh:IRI ;
    sh:property [ a sh:PropertyShape ;
            sh:class sh:NodeShape ;
            sh:description "The declared root shape of a GraphQL schema, specified using schema { query: ... } in GraphQL schema syntax. Can be used to round-trip GraphQL files." ;
            sh:maxCount 1 ;
            sh:name "query shape" ;
            sh:nodeKind sh:IRI ;
            sh:path <http://datashapes.org/graphql#queryShape> ],
        [ a sh:PropertyShape ;
            sh:class sh:PrefixDeclaration ;
            sh:maxCount 1 ;
            sh:path <http://datashapes.org/graphql#defaultPrefix> ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:description "A system name that can be used in URLs to identify this schema." ;
            sh:maxCount 1 ;
            sh:path <http://datashapes.org/graphql#name> ],
        <http://datashapes.org/graphql#Schema-privateShape>,
        <http://datashapes.org/graphql#Schema-protectedClass>,
        <http://datashapes.org/graphql#Schema-protectedShape>,
        <http://datashapes.org/graphql#Schema-publicClass>,
        <http://datashapes.org/graphql#Schema-publicNamespace>,
        <http://datashapes.org/graphql#Schema-publicShape> .

<http://datashapes.org/graphql#WriterTestCase> a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Writer test case" ;
    rdfs:comment "A test case that can be used to verify that a RDF/SHACL to GraphQL writer works correctly. The expected result must be the complete GraphQL schema string." ;
    rdfs:subClassOf ns2:TestCase ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:description "True to include a test comparing that reloading the generated string yields the same graph." ;
            sh:maxCount 1 ;
            sh:name "can round trip" ;
            sh:path <http://datashapes.org/graphql#canRoundTrip> ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:description "The URI of the RDF graph to load." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "RDF graph" ;
            sh:path <http://datashapes.org/graphql#rdfGraph> ] .

onto: a owl:Ontology ;
    rdfs:label "GraphQL Vocabulary" ;
    rdfs:comment "A vocabulary to annotate RDF schemas (in particular SHACL shapes) with metadata to define mappings to GraphQL." ;
    owl:imports <http://datashapes.org/dash> .

<http://datashapes.org/graphql#ClassShape> a sh:NodeShape ;
    rdfs:label "GraphQL class shape" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#Schema> ;
            sh:description "Public classes (including subclasses) can be queried without restrictions, unless marked as protected or private. This also includes shapes linked to these classes via sh:targetClass or dash:applicableToClass." ;
            sh:group <http://datashapes.org/graphql#SchemaPropertyGroup> ;
            sh:name "public class of" ;
            sh:nodeKind sh:IRI ;
            sh:order 0.0 ;
            sh:path [ sh:inversePath <http://datashapes.org/graphql#publicClass> ] ],
        [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#Schema> ;
            sh:description "Protected classes (including subclasses) can only be queried if reached through a field from another shape." ;
            sh:group <http://datashapes.org/graphql#SchemaPropertyGroup> ;
            sh:name "protected class of" ;
            sh:nodeKind sh:IRI ;
            sh:order 2.0 ;
            sh:path [ sh:inversePath <http://datashapes.org/graphql#protectedClass> ] ] ;
    sh:targetClass rdfs:Class .

<http://datashapes.org/graphql#NameShape> a sh:NodeShape ;
    rdfs:label "Name shape" ;
    rdfs:comment "Defines syntax restrictions on the use of the graphql:name property." ;
    owl:versionInfo "TODO: Add checks against duplicate names within the same shape (including superclasses and sh:node references)." ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <http://datashapes.org/graphql#name> ;
            sh:pattern "^[_A-Za-z][_0-9A-Za-z]*$" ] ;
    sh:targetSubjectsOf <http://datashapes.org/graphql#name> .

<http://datashapes.org/graphql#NodeShapeShape> a sh:NodeShape ;
    rdfs:label "GraphQL node shape shape" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#Schema> ;
            sh:description "Protected shapes can only be queried if reached through a field from another shape." ;
            sh:group <http://datashapes.org/graphql#SchemaPropertyGroup> ;
            sh:name "protected shape of" ;
            sh:nodeKind sh:IRI ;
            sh:order 3.0 ;
            sh:path [ sh:inversePath <http://datashapes.org/graphql#protectedShape> ] ],
        [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#Schema> ;
            sh:description "Public shapes can be queried without restrictions." ;
            sh:group <http://datashapes.org/graphql#SchemaPropertyGroup> ;
            sh:name "public shape of" ;
            sh:nodeKind sh:IRI ;
            sh:order 1.0 ;
            sh:path [ sh:inversePath <http://datashapes.org/graphql#publicShape> ] ],
        [ a sh:PropertyShape ;
            sh:class <http://datashapes.org/graphql#Schema> ;
            sh:description "Private shapes cannot be queried." ;
            sh:group <http://datashapes.org/graphql#SchemaPropertyGroup> ;
            sh:name "private shape of" ;
            sh:nodeKind sh:IRI ;
            sh:order 4.0 ;
            sh:path [ sh:inversePath <http://datashapes.org/graphql#privateShape> ] ] ;
    sh:targetClass sh:NodeShape .

<http://datashapes.org/graphql#fieldName> a sh:Function ;
    rdfs:label "field name" ;
    rdfs:comment "Gets the GraphQL field name for a property path at a given node shape." ;
    sh:parameter [ a sh:Parameter ;
            sh:description "The property path expression (value of sh:path)." ;
            sh:name "path" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <http://datashapes.org/graphql#path> ],
        [ a sh:Parameter ;
            sh:class sh:NodeShape ;
            sh:name "node shape" ;
            sh:nodeKind sh:IRI ;
            sh:order 0.0 ;
            sh:path <http://datashapes.org/graphql#nodeShape> ] ;
    sh:returnType xsd:string .

<http://datashapes.org/graphql#isIDField> a rdf:Property ;
    rdfs:label "is ID field" ;
    rdfs:comment "Can be attached to property shapes to indicate they should be round-tripped as GraphQL type ID." ;
    rdfs:range xsd:boolean .

<http://datashapes.org/graphql#isInterface> a rdf:Property ;
    rdfs:label "is GraphQL interface" ;
    rdfs:comment "If set to true for a node shape, then it should become a GraphQL interface." ;
    rdfs:range xsd:boolean .

<http://datashapes.org/graphql#query> a rdf:Property ;
    rdfs:label "query" ;
    rdfs:comment "The GraphQL query string." .

<http://datashapes.org/graphql#uriTemplate> a rdf:Property ;
    rdfs:label "GraphQL URI template" ;
    rdfs:comment "Can be used to attach a URI template to node shapes, meaning that JSON objects that are processed with the given node shape will become URI resources with a URI derived from the given template. Example: \"ex:Person-{$id}\".\\n\\nURI templates can include {...} blocks that contain a variable reference such as $id if the corresponding GraphQL type has a field named \"id\". Fields are mandatory by default, meaning that if a JSON converter attempts to produce a URI that lacks a mandatory field then the conversion fails with an exception." ;
    rdfs:domain sh:NodeShape ;
    rdfs:range xsd:string .

ns1:PropertyShapeShape sh:property ns1:PropertyShapeShape-name .

<http://datashapes.org/graphql#Schema-privateShape> a sh:PropertyShape ;
    sh:class sh:NodeShape ;
    sh:description "Defines the shapes that shall not be published, overriding what has been specified to be public (e.g. via graphql:publicShape)." ;
    sh:group <http://datashapes.org/graphql#ShapesPropertyGroup> ;
    sh:name "private shape" ;
    sh:nodeKind sh:IRI ;
    sh:order 20.0 ;
    sh:path <http://datashapes.org/graphql#privateShape> .

<http://datashapes.org/graphql#Schema-protectedClass> a sh:PropertyShape ;
    sh:class rdfs:Class ;
    sh:description "Links to classes so that the class and all its subclasses are published, assuming they are also node shapes. Protected classes can however not be queried from the generated root query object." ;
    sh:group <http://datashapes.org/graphql#ShapesPropertyGroup> ;
    sh:name "protected class" ;
    sh:nodeKind sh:IRI ;
    sh:order 11.0 ;
    sh:path <http://datashapes.org/graphql#protectedClass> .

<http://datashapes.org/graphql#Schema-protectedShape> a sh:PropertyShape ;
    sh:class sh:NodeShape ;
    sh:description "Specifies the shape(s) that the GraphQL schema is publishing but not accessible from the generated root query object." ;
    sh:group <http://datashapes.org/graphql#ShapesPropertyGroup> ;
    sh:name "protected shape" ;
    sh:nodeKind sh:IRI ;
    sh:order 10.0 ;
    sh:path <http://datashapes.org/graphql#protectedShape> .

<http://datashapes.org/graphql#Schema-publicClass> a sh:PropertyShape ;
    sh:class rdfs:Class ;
    sh:description "Links to classes so that the class and all its subclasses are published, assuming they are also node shapes. Also publishes any shapes linked to the class and its subclasses via sh:targetClass or dash:applicableToClass." ;
    sh:group <http://datashapes.org/graphql#ShapesPropertyGroup> ;
    sh:name "public class" ;
    sh:nodeKind sh:IRI ;
    sh:order 2.0 ;
    sh:path <http://datashapes.org/graphql#publicClass> .

<http://datashapes.org/graphql#Schema-publicNamespace> a sh:PropertyShape ;
    sh:class sh:PrefixDeclaration ;
    sh:description "The namespace(s) of node shapes that shall be published by the GraphQL schema. Will use the values of sh:namespace of the linked prefix declarations." ;
    sh:group <http://datashapes.org/graphql#ShapesPropertyGroup> ;
    sh:name "public namespace" ;
    sh:order 0.0 ;
    sh:path <http://datashapes.org/graphql#publicNamespace> .

<http://datashapes.org/graphql#Schema-publicShape> a sh:PropertyShape ;
    sh:class sh:NodeShape ;
    sh:description "Specifies the shape(s) that the GraphQL schema is publishing." ;
    sh:group <http://datashapes.org/graphql#ShapesPropertyGroup> ;
    sh:name "public shape" ;
    sh:nodeKind sh:IRI ;
    sh:order 1.0 ;
    sh:path <http://datashapes.org/graphql#publicShape> .

<http://datashapes.org/graphql#defaultPrefix> a rdf:Property ;
    rdfs:label "default prefix" ;
    rdfs:comment "Points at a prefix declaration of the default namespace for the shapes derived by GraphQL types. This property can be used to round-trip .graphql files." .

<http://datashapes.org/graphql#queryShape> a rdf:Property ;
    rdfs:label "query shape" ;
    rdfs:range sh:NodeShape .

<http://datashapes.org/graphql#queryString> a rdf:Property ;
    rdfs:label "query string" ;
    rdfs:comment "The text of the actual query in GraphQL syntax." .

<http://datashapes.org/graphql#schema> a rdf:Property .

<http://datashapes.org/graphql#variables> a rdf:Property ;
    rdfs:label "variables" ;
    rdfs:comment "An optional JSON object with variables that shall be passed into the query for execution." .

ns1:PropertyShapeShape-name a sh:PropertyShape ;
    ns1:editWidget <http://topbraid.org/swa#PlainTextFieldEditor> ;
    sh:description "The name of the associated GraphQL field, must follow GraphQL naming syntax." ;
    sh:group ns1:AboutPropertyGroup ;
    sh:name "GraphQL field name" ;
    sh:order 0.5 ;
    sh:path <http://datashapes.org/graphql#name> .

owl:Ontology rdfs:subClassOf <http://datashapes.org/graphql#Schema> .

<http://datashapes.org/graphql#SchemaPropertyGroup> a sh:PropertyGroup ;
    rdfs:label "GraphQL Schema" ;
    ns1:editGroupDescription "The properties in this group define how the current shape/class is made available to GraphQL services." ;
    ns1:openable true ;
    sh:order 1.5 .

<http://datashapes.org/graphql#ShapesPropertyGroup> a sh:PropertyGroup ;
    rdfs:label "Shapes" ;
    sh:order 5.0 .

<http://datashapes.org/graphql#name> a rdf:Property ;
    rdfs:label "name" ;
    rdfs:comment "Defines a GraphQL name for a given subject. The values need to match the regular expression specified in http://facebook.github.io/graphql/October2016/#Name." ;
    rdfs:range xsd:string .

