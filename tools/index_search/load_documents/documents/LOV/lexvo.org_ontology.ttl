@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://lexvo.org/ontology> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "Lexvo.org Ontology"@en ;
    dcterms:contributor <http://data.semanticweb.org/person/bernard-vatant> ;
    dcterms:creator <http://www.demelo.org/gdm/#GDM> ;
    dcterms:modified "2014-01-29"^^<xsd:date> ;
    dcterms:subject <http://dbpedia.org/resource/Language> ;
    rdfs:comment "Lexvo.org Ontology" ;
    rdfs:seeAlso <http://www.lexvo.org/> ;
    owl:versionInfo "Lexvo.org Ontology Version 0.23 (2014-01-29)"@en ;
    foaf:homepage <http://www.lexvo.org/> .

<http://lexvo.org/ontology#characterRadical> a owl:ObjectProperty ;
    rdfs:label "translation"@en ;
    rdfs:comment "The property of a CJK character being conventionally\\n    associated with a CJK character radical."@en ;
    rdfs:domain <http://lexvo.org/ontology#Character> ;
    rdfs:range <http://lexvo.org/ontology#CJKRadical> .

<http://lexvo.org/ontology#containsCharacter> a owl:ObjectProperty ;
    rdfs:label "contains character"@en ;
    rdfs:comment "The property of a term containing a specific character."@en ;
    rdfs:domain <http://lexvo.org/ontology#Term> ;
    rdfs:range <http://lexvo.org/ontology#Character> .

<http://lexvo.org/ontology#hasCharacterComponent> a owl:ObjectProperty ;
    rdfs:label "character component"@en ;
    rdfs:comment "The property of a character being composed of another character."@en ;
    rdfs:domain <http://lexvo.org/ontology#Character> ;
    rdfs:range <http://lexvo.org/ontology#Character> ;
    skos:note "Especially for CJK characters."@en .

<http://lexvo.org/ontology#inScript> a owl:ObjectProperty ;
    rdfs:label "in script"@en ;
    rdfs:comment "The property of a document being written in a specific script,\\n    or a language being written or having being written in a specific script by a considerable\\n    group of language users."@en ;
    rdfs:range <http://lexvo.org/ontology#Script> .

<http://lexvo.org/ontology#involvedIn> a owl:ObjectProperty ;
    rdfs:label "involved in"@en ;
    rdfs:comment "The property of being involved in something, e.g. for semantic participants' involvement in a semantic frame."@en ;
    owl:inverseOf <http://lexvo.org/ontology#involves> .

<http://lexvo.org/ontology#isFocusOf> a owl:ObjectProperty ;
    rdfs:label "is focus of"@en ;
    owl:inverseOf foaf:focus ;
    skos:note "The isFocusOf relates an entity to relevant SKOS concepts \\n    that are conceptualizations of the same entity. This is the inverse of the\\n    standard foaf:focus property, which connects a SKOS concept to a relevant\\n    non-conceptualized entity."@en .

<http://lexvo.org/ontology#iso15924Alphacode> a owl:DatatypeProperty ;
    rdfs:label "ISO 15924 alphabetic code"@en ;
    rdfs:domain <http://lexvo.org/ontology#Script> ;
    rdfs:seeAlso <http://unicode.org/iso15924/> .

<http://lexvo.org/ontology#iso639P1Code> a owl:DatatypeProperty ;
    rdfs:label "ISO 639-1 code"@en ;
    rdfs:domain <http://lexvo.org/ontology#Language> .

<http://lexvo.org/ontology#iso639P2BCode> a owl:DatatypeProperty ;
    rdfs:label "ISO 639-2 Bibliographical code"@en ;
    rdfs:domain <http://lexvo.org/ontology#Language> ;
    rdfs:seeAlso <http://www.loc.gov/standards/iso639-2/> .

<http://lexvo.org/ontology#iso639P2TCode> a owl:DatatypeProperty ;
    rdfs:label "ISO 639-2 Terminological code"@en ;
    rdfs:domain <http://lexvo.org/ontology#Language> ;
    rdfs:seeAlso <http://www.loc.gov/standards/iso639-2/> .

<http://lexvo.org/ontology#iso639P3Code> a owl:DatatypeProperty ;
    rdfs:label "ISO 639-3 code"@en ;
    rdfs:domain <http://lexvo.org/ontology#Language> ;
    rdfs:seeAlso <http://www.sil.org/ISO639-3/> .

<http://lexvo.org/ontology#iso639P5Code> a owl:DatatypeProperty ;
    rdfs:label "ISO 639-5 code"@en ;
    rdfs:domain <http://lexvo.org/ontology#Language> ;
    rdfs:seeAlso <http://www.loc.gov/standards/iso639-5/> .

<http://lexvo.org/ontology#language> a owl:ObjectProperty ;
    rdfs:label "in language"@en ;
    rdfs:comment "The property of a resource being mainly encoded in a specific language."@en ;
    rdfs:range <http://lexvo.org/ontology#Language> ;
    rdfs:subPropertyOf dc:language,
        dcterms:language .

<http://lexvo.org/ontology#lexicalCategory> a owl:ObjectProperty ;
    rdfs:label "lexical category"@en ;
    rdfs:comment "A lexical category that a term can be used in."@en ;
    skos:note " For example, the English term \"score\" can be used as a noun and as a verb."@en .

<http://lexvo.org/ontology#marcCode> a owl:DatatypeProperty ;
    rdfs:label "MARC 21 / USMARC code"@en ;
    rdfs:domain <http://lexvo.org/ontology#Language> ;
    rdfs:seeAlso <http://www.loc.gov/marc/> .

<http://lexvo.org/ontology#memberOf> a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    rdfs:comment "The property of being a member of a group."@en ;
    owl:inverseOf <http://lexvo.org/ontology#hasMember> ;
    skos:note "For instance for geographic regions."@en .

<http://lexvo.org/ontology#narrower> a owl:ObjectProperty ;
    rdfs:label "narrower"@en ;
    onto:somewhatSameAs skos:narrower ;
    rdfs:comment "The property of having a narrower, less generic concept."@en ;
    owl:inverseOf <http://lexvo.org/ontology#broader> ;
    skos:note "Similar to skos:narrower but domain and range are not restricted to skos:Concept instances."@en .

<http://lexvo.org/ontology#nonRadicalStrokes> a owl:DatatypeProperty ;
    rdfs:label "non-radical strokes"@en ;
    rdfs:comment "The property of a character conventionally being\\n    written with a specific number strokes, excluding the strokes of its radical."@en ;
    rdfs:domain <http://lexvo.org/ontology#Character> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:note "Especially for CJK characters."@en .

<http://lexvo.org/ontology#scriptFor> a owl:ObjectProperty ;
    rdfs:label "script for"@en ;
    rdfs:comment "The property of a script being used for a particular language by\\n   a considerable of language users (but not necessarily the majority of all language users)."@en ;
    rdfs:domain <http://lexvo.org/ontology#Script> ;
    rdfs:range <http://lexvo.org/ontology#Language> ;
    owl:inverseOf <http://lexvo.org/ontology#usesScript> .

<http://lexvo.org/ontology#strength> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "strength"@en ;
    rdfs:comment "The strength of an rdf:Statement, given is a value in [0,1]."@en ;
    rdfs:domain rdf:Statement .

<http://lexvo.org/ontology#strictlySameAs> a owl:NamedIndividual,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "same as"@en ;
    rdfs:comment "The property of genuine identity in the Leibnizian sense."@en ;
    rdfs:subPropertyOf <http://lexvo.org/ontology#nearlySameAs> ;
    owl:sameAs owl:sameAs .

<http://lexvo.org/ontology#translation> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "translation"@en ;
    onto:nearlySameAs <http://purl.org/linguistics/gold/translation> ;
    rdfs:comment "translational equivalence between words and other signs\\n    and resources that they represent to or represented to a considerable number of humans"@en ;
    skos:note "Domain and range are usually Term objects, however string literals are acceptable as well for the range."@en .

<http://lexvo.org/ontology#usedIn> a owl:ObjectProperty ;
    rdfs:label "used in"@en ;
    rdfs:comment "The property of a language or writing system\\n    being used somewhat extensively in a particular geographical region \\n    at some point in time."@en ;
    rdfs:range <http://lexvo.org/ontology#GeographicRegion> .

<http://lexvo.org/ontology#variant> a owl:ObjectProperty ;
    rdfs:label "variant"@en ;
    rdfs:comment "The property of being a variant of another resource."@en ;
    skos:note "Especially for terms and characters."@en .

onto:nearlySameAs a owl:AnnotationProperty .

onto:somewhatSameAs a owl:AnnotationProperty .

onto:subClassOf a owl:AnnotationProperty .

skos:exactMatch a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://lexvo.org/ontology#nearlySameAs> .

skos:note a owl:AnnotationProperty .

<http://www.w3.org/2008/05/skos-xl#altLabel> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://lexvo.org/ontology#label> .

<http://www.w3.org/2008/05/skos-xl#prefLabel> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://lexvo.org/ontology#label> .

<http://lexvo.org/ontology#CJKRadical> a owl:Class ;
    rdfs:label "radical"@en ;
    rdfs:comment "A CJK character radical."@en ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Radical_%28Chinese_character%29> ;
    skos:note "CJK radicals are slightly more abstract than characters, because the same radical can be manifested as different\\n    characters, e.g. radical 4 can take the form of '丿', '乀', or '乁'."@en .

<http://lexvo.org/ontology#GeographicRegion> a owl:Class ;
    rdfs:label "geographic region"@en ;
    rdfs:comment "Geographic regions on Earth or elsewhere."@en .

<http://lexvo.org/ontology#Term> a owl:Class ;
    rdfs:label "term"@en ;
    onto:nearlySameAs <http://lexonto.ontoware.org/lmf#FormRepresentation> ;
    onto:subClassOf <http://www.w3.org/2008/05/skos-xl#Label> ;
    rdfs:comment "A term in a specific language."@en .

<http://lexvo.org/ontology#broader> a owl:ObjectProperty ;
    rdfs:label "broader"@en ;
    onto:somewhatSameAs skos:broader ;
    rdfs:comment "The property of having a broader, more generic concept."@en ;
    skos:note "Similar to skos:broader but domain and range are not restricted to skos:Concept instances."@en .

<http://lexvo.org/ontology#evokes> a owl:ObjectProperty ;
    rdfs:label "evokes"@en ;
    rdfs:comment "The property of conceptually evoking some object."@en ;
    owl:inverseOf <http://lexvo.org/ontology#evokes> .

<http://lexvo.org/ontology#hasMember> a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:comment "The property of having a member."@en ;
    skos:note "For instance for geographic regions."@en .

<http://lexvo.org/ontology#involves> a owl:ObjectProperty ;
    rdfs:label "involves"@en ;
    rdfs:comment "The property of involving some entity, e.g. for semantic participants involved in a semantic frame."@en .

<http://lexvo.org/ontology#means> a owl:ObjectProperty ;
    rdfs:label "means"@en ;
    rdfs:comment "the semiotic property of a natural language word meaning something, i.e. a\\n    relationship between words and resources that they represent (or represented) to a considerable number of humans"@en ;
    rdfs:subPropertyOf <http://lexvo.org/ontology#represents> .

<http://lexvo.org/ontology#representedBy> a owl:ObjectProperty ;
    rdfs:label "represented by"@en ;
    owl:inverseOf <http://lexvo.org/ontology#represents> .

<http://lexvo.org/ontology#usesScript> a owl:ObjectProperty ;
    rdfs:label "uses script"@en ;
    rdfs:comment "The property of a language being written or having being written in a specific \\n    script by a considerable group of language users."@en ;
    rdfs:range <http://lexvo.org/ontology#Script> .

dc:language a owl:ObjectProperty .

dcterms:LinguisticSystem a owl:Class .

dcterms:language a owl:ObjectProperty .

<http://purl.org/linguistics/gold/Character> a owl:NamedIndividual .

skos:broadMatch a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://lexvo.org/ontology#somewhatSameAs> .

foaf:focus a owl:ObjectProperty .

<http://lexvo.org/ontology#label> a owl:ObjectProperty ;
    rdfs:label "has label"@en ;
    rdfs:comment "If C lvont:Label L and L skosxl:literalForm V, then X rdfs:label V."@en,
        "the semiotic property of possessing a natural language label (as opposed to artificial identifiers), e.g. the city of Paris is lexicalized in Italian using the Italian term \"Parigi\"."@en ;
    rdfs:range <http://www.w3.org/2008/05/skos-xl#Label> ;
    rdfs:subPropertyOf <http://lexvo.org/ontology#representedBy> ;
    owl:inverseOf <http://lexvo.org/ontology#means> ;
    skos:note "This property is more general than skosxl:prefLabel and skosxl:altLabel, as it does not make any normative claims about which labels are preferred. It merely describes\\n    the fact that a certain label can be used to refer to something."@en .

<http://lexvo.org/ontology#represents> a owl:ObjectProperty ;
    rdfs:label "represents"@en ;
    rdfs:comment "the semiotic property of semantically representing something, i.e. a\\n    relationship between words and other signs and resources that they represent (or represented) to a considerable number of humans"@en .

<http://lexvo.org/ontology#somewhatSameAs> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "somewhat same as"@en ;
    onto:somewhatSameAs skos:broadMatch ;
    rdfs:comment "The property of being at least somewhat the same as something else. For instance,\\n    the City of Los Angeles is somewhat the same as the Greater Los Angeles area."@en .

owl:sameAs a owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:subPropertyOf <http://lexvo.org/ontology#nearlySameAs> .

<http://www.w3.org/2008/05/skos-xl#Label> a owl:Class .

<http://lexvo.org/ontology#nearlySameAs> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "nearly same as"@en ;
    onto:somewhatSameAs owl:sameAs ;
    rdfs:comment "The property of being at least nearly the same as something else. For instance,\\n    the geographical area comprising the island of Malta is nearly the same as the island of Malta."@en ;
    rdfs:subPropertyOf <http://lexvo.org/ontology#somewhatSameAs> .

<http://lexvo.org/ontology#Script> a owl:Class ;
    rdfs:label "script"@en ;
    rdfs:comment "A writing system considered abstractly, i.e. independent\\n    of language-specific variations."@en .

<http://lexvo.org/ontology#Character> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "character"@en ;
    rdfs:comment "An abstract character as defined by the Unicode Standard,\\n  Version 5, in Chapter 3.4."@en ;
    owl:sameAs <http://purl.org/linguistics/gold/Character> ;
    skos:note "The same abstract character may be rendered in different forms, depending on the language and on typeface characters."@en .

<http://lexvo.org/ontology#Language> a owl:Class ;
    rdfs:label "language"@en ;
    onto:somewhatSameAs <http://www.lingvoj.org/ontology#Lingvo> ;
    rdfs:comment "Groups of human language variants that are or were spoken, written, or signed at some point in time."@en ;
    rdfs:seeAlso <http://en.wikipedia.org/wiki/Language> ;
    rdfs:subClassOf dcterms:LinguisticSystem ;
    skos:note "This definition includes languages, particular language variants (e.g. dialects), and larger groups of language \\n    variants (e.g. macrolanguages and language families), as the distinction between them is largely conventional."@en .

