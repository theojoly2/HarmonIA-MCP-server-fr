@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/11/swrl#> .
@prefix ns2: <http://www.sensormeasurement.appspot.com/ont/transport/traffic#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.org/vocommons/voaf> a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual .

<http://purl.org/vocommons/voaf#VocabularySpace> a owl:Class ;
    rdfs:label "Vocabulary Space"@en ;
    rdfs:comment "Dublin Core properties isPartOf and hasPart are used to link a vocabulary to a \\nvocabulary space",
        "A vocabulary space defines any relevant grouping of vocabularies \\ne.g., designed for similar purposes or domains, or designed by the same publisher or the same project, etc.\\n    A vocabulary can belong to zero, one or more vocabulary spaces."@en ;
    rdfs:isDefinedBy <http://purl.org/vocommons/voaf#> .

ns2: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual,
        owl:Ontology ;
    ns3:license <http://creativecommons.org/licenses/by/3.0/> ;
    dc:description "A traffic ontology that describes the management of the traffic in a straight road with two lanes, both in the same direction. The situation is an ambulance trying to overtake all the other cars and they have to modify their speed and positions in order to able the ambulance to pass as fast as possible."@en ;
    dc:title "Road Traffic Management"@en ;
    dcterms:creator <mailto:alberto.cordoba@unavarra.es>,
        <mailto:antoniojesus.bermejo@unavarra.es>,
        <mailto:jesusv@unavarra.es>,
        <mailto:josej.astrain@unavarra.es> ;
    dcterms:issued "2012-01-21"^^xsd:date ;
    dcterms:modified "2012-09-07"^^xsd:date ;
    dcterms:source <http://link.springer.com/chapter/10.1007%2F978-3-642-32524-3_14> ;
    vann:preferredNamespacePrefix "traffic" ;
    vann:preferredNamespaceUri "http://www.sensormeasurement.appspot.com/ont/transport/traffic#" ;
    rdfs:comment " An ontology to describe the management of the traffic" ;
    owl:versionInfo 1.0 ;
    skos:historyNote "Ontology extracted from the paper Ontology Based Road Traffic Management. [Bermejo, A.J. et al. 2012] "@en .

ns2:Car1 a ns2:Vehicle,
        owl:NamedIndividual ;
    ns2:beforeTheGap true ;
    ns2:bigSpeedDifference false ;
    ns2:hasSpaceAhead true ;
    ns2:hasSpaceBehind false ;
    ns2:hasSpaceLateral false ;
    ns2:isInFrontOfOvertaker false ;
    ns2:isOvertaking false ;
    ns2:lastFirstBeforeAfter-TheGap true ;
    ns2:speedWithBeforeTheGapCar 2 .

ns2:Car2 a ns2:Vehicle,
        owl:NamedIndividual ;
    ns2:beforeTheGap false ;
    ns2:bigSpeedDifference false ;
    ns2:hasSpaceAhead true ;
    ns2:hasSpaceBehind false ;
    ns2:hasSpaceLateral false ;
    ns2:isInFrontOfOvertaker true ;
    ns2:isOvertaking false ;
    ns2:lastFirstBeforeAfter-TheGap true ;
    ns2:speedWithBeforeTheGapCar 1 .

ns2:Car3 a ns2:Vehicle,
        owl:NamedIndividual ;
    ns2:beforeTheGap false ;
    ns2:bigSpeedDifference false ;
    ns2:hasSpaceAhead true ;
    ns2:hasSpaceBehind false ;
    ns2:hasSpaceLateral false ;
    ns2:isInFrontOfOvertaker true ;
    ns2:isOvertaking false ;
    ns2:lastFirstBeforeAfter-TheGap false ;
    ns2:speedWithBeforeTheGapCar 3 .

ns2:Car4 a ns2:Vehicle,
        owl:NamedIndividual ;
    ns2:bigSpeedDifference false ;
    ns2:hasSpaceAhead true ;
    ns2:hasSpaceBehind false ;
    ns2:hasSpaceLateral false ;
    ns2:isInFrontOfOvertaker false ;
    ns2:isOvertaking true ;
    ns2:speedWithBeforeTheGapCar 3 .

ns2:hasDirectionValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns2:movement .

ns2:hasSpeedValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf ns2:movement .

ns2:hasXValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ns2:position .

ns2:hasYValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ns2:position .

<http://www.traffic.com/ontologies/a.owl#hasSpaceAhead> a owl:AnnotationProperty .

<http://www.traffic.com/ontologies/a.owl#hasSpaceBehind> a owl:AnnotationProperty .

<http://www.traffic.com/ontologies/a.owl#hasSpaceLateral> a owl:AnnotationProperty .

<http://www.traffic.com/ontologies/a.owl#isInFrontOfOvertaker> a owl:AnnotationProperty .

<http://www.traffic.com/ontologies/a.owl#isOvertaking> a owl:AnnotationProperty .

<http://www.unavarra.es> a owl:NamedIndividual,
        foaf:Organization .

<http://www.unavarra.es/foaf/unavarra.rdf#A.Cordoba> a owl:NamedIndividual,
        foaf:Person .

<http://www.unavarra.es/foaf/unavarra.rdf#A.J.Bermejo> a owl:NamedIndividual,
        foaf:Person .

<http://www.unavarra.es/foaf/unavarra.rdf#J.J.Astrain> a owl:NamedIndividual,
        foaf:Person .

<http://www.unavarra.es/foaf/unavarra.rdf#J.Villadangos> a owl:NamedIndividual,
        foaf:Person .

<http://www.w3org/2003/06/sw-vocab-status/ns#term_status> a owl:AnnotationProperty .

foaf:name a owl:AnnotationProperty .

ns2:ChangeLine a owl:Class ;
    rdfs:subClassOf ns2:Action .

ns2:isActionDoneBy a owl:AsymmetricProperty,
        owl:InverseFunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:range ns2:Vehicle ;
    owl:inverseOf ns2:doesAction .

foaf:Organization a owl:Class .

<mailto:alberto.cordoba@unavarra.es> a owl:NamedIndividual,
        foaf:Person ;
    foaf:name "A. Cordoba" .

<mailto:antoniojesus.bermejo@unavarra.es> a owl:NamedIndividual,
        foaf:Person ;
    foaf:name "A. J. Bermejo" .

<mailto:jesusv@unavarra.es> a owl:NamedIndividual,
        foaf:Person ;
    foaf:name "J. Villadangos" .

<mailto:josej.astrain@unavarra.es> a owl:NamedIndividual,
        foaf:Person ;
    foaf:name "J. J. Astrain" .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

ns2:MaintainDistanceWithCarInFront a owl:Class ;
    rdfs:subClassOf ns2:Action .

ns2:doesAction a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Vehicle .

ns2:hasSpaceBehind a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:hasSpace .

ns2:isOvertaking a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:position .

ns2:movement a owl:DatatypeProperty .

ns2:hasSpace a owl:DatatypeProperty .

ns2:hasSpaceAhead a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:hasSpace .

ns2:Position a owl:Class ;
    rdfs:subClassOf ns2:Vehicle .

ns2:Space a owl:Class .

ns2:beforeTheGap a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:position .

ns2:hasSpaceLateral a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:hasSpace .

ns2:lastFirstBeforeAfter-TheGap a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:position .

ns2:speedWith a owl:DatatypeProperty .

ns2:position a owl:DatatypeProperty .

ns2:Action a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:isActionDoneBy ;
            owl:someValuesFrom ns2:Vehicle ],
        owl:Thing .

ns2:LastBeforeGap a owl:Class ;
    rdfs:subClassOf ns2:Position .

ns2:isInFrontOfOvertaker a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:position .

ns2:speedWithOvertaker a owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "1"^^xsd:int ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "2"^^xsd:int ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "3"^^xsd:int ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:subPropertyOf ns2:speedWith .

foaf:Person a owl:Class .

ns2:FirstAfterGap a owl:Class ;
    rdfs:subClassOf ns2:Position .

ns2:Accelerate a owl:Class ;
    rdfs:subClassOf ns2:Action .

ns2:Decelerate a owl:Class ;
    rdfs:subClassOf ns2:Action .

ns2:BeforeGap a owl:Class ;
    rdfs:subClassOf ns2:Position .

ns2:AfterGap a owl:Class ;
    rdfs:subClassOf ns2:Position .

ns2:Lateral a owl:Class ;
    rdfs:subClassOf ns2:Space .

ns2:SoftDecelerate a owl:Class ;
    rdfs:subClassOf ns2:Action .

ns2:SoftAccelerate a owl:Class ;
    rdfs:subClassOf ns2:Action .

ns2:Ahead a owl:Class ;
    rdfs:subClassOf ns2:Space .

ns2:NoSpace a owl:Class ;
    rdfs:subClassOf ns2:Space .

ns2:MaintainSpeed a owl:Class ;
    rdfs:subClassOf ns2:Action .

ns2:Vehicle a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:doesAction ] .

ns2:speedWithAheadCar a owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "1"^^xsd:int ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "2"^^xsd:int ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "3"^^xsd:int ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:subPropertyOf ns2:speedWith .

ns2:Behind a owl:Class ;
    rdfs:subClassOf ns2:Space .

ns2:speedWithBehindCar a owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "1"^^xsd:int ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "2"^^xsd:int ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "3"^^xsd:int ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:subPropertyOf ns2:speedWith .

ns2:speedWithBeforeTheGapCar a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "1"^^xsd:int ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "2"^^xsd:int ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "3"^^xsd:int ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:subPropertyOf ns2:speedWith .

ns2:Overtaker a owl:Class ;
    rdfs:subClassOf ns2:Vehicle .

ns2:bigSpeedDifference a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Vehicle ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:speedWith .

ns2:NotOvertaker a owl:Class ;
    rdfs:subClassOf ns2:Vehicle .

<urn:swrl#c> a ns1:Variable .

ns2:c a ns1:Variable .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:AfterGap ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:ClassAtom ;
                            ns1:argument1 ns2:c ;
                            ns1:classPredicate ns2:Behind ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:ClassAtom ;
                                    ns1:argument1 ns2:c ;
                                    ns1:classPredicate ns2:NotOvertaker ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 ns2:c ;
                                            ns1:argument2 true ;
                                            ns1:propertyPredicate ns2:bigSpeedDifference ] ;
                                    rdf:rest [ a ns1:AtomList ;
                                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                    ns1:argument1 ns2:c ;
                                                    ns1:argument2 true ;
                                                    ns1:propertyPredicate ns2:isInFrontOfOvertaker ] ;
                                            rdf:rest [ a ns1:AtomList ;
                                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                            ns1:argument1 ns2:c ;
                                                            ns1:argument2 "1"^^xsd:long ;
                                                            ns1:propertyPredicate ns2:speedWithBehindCar ] ;
                                                    rdf:rest () ] ] ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:Accelerate ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:NoSpace ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:ClassAtom ;
                            ns1:argument1 ns2:c ;
                            ns1:classPredicate ns2:Overtaker ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 ns2:c ;
                                    ns1:argument2 false ;
                                    ns1:propertyPredicate ns2:bigSpeedDifference ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 ns2:c ;
                                            ns1:argument2 "3"^^xsd:long ;
                                            ns1:propertyPredicate ns2:speedWithAheadCar ] ;
                                    rdf:rest [ a ns1:AtomList ;
                                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                    ns1:argument1 ns2:c ;
                                                    ns1:argument2 "2"^^xsd:long ;
                                                    ns1:propertyPredicate ns2:speedWithBehindCar ] ;
                                            rdf:rest () ] ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:SoftDecelerate ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:FirstAfterGap ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:ClassAtom ;
                            ns1:argument1 ns2:c ;
                            ns1:classPredicate ns2:Lateral ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:ClassAtom ;
                                    ns1:argument1 ns2:c ;
                                    ns1:classPredicate ns2:NotOvertaker ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 ns2:c ;
                                            ns1:argument2 "2"^^xsd:long ;
                                            ns1:propertyPredicate ns2:speedWithBeforeTheGapCar ] ;
                                    rdf:rest () ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:MaintainSpeed ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:Behind ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:ClassAtom ;
                            ns1:argument1 ns2:c ;
                            ns1:classPredicate ns2:Overtaker ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 ns2:c ;
                                    ns1:argument2 false ;
                                    ns1:propertyPredicate ns2:bigSpeedDifference ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 ns2:c ;
                                            ns1:argument2 "1"^^xsd:long ;
                                            ns1:propertyPredicate ns2:speedWithAheadCar ] ;
                                    rdf:rest [ a ns1:AtomList ;
                                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                    ns1:argument1 ns2:c ;
                                                    ns1:argument2 "1"^^xsd:long ;
                                                    ns1:propertyPredicate ns2:speedWithBehindCar ] ;
                                            rdf:rest () ] ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:SoftAccelerate ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:BeforeGap ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:ClassAtom ;
                            ns1:argument1 ns2:c ;
                            ns1:classPredicate ns2:Behind ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:ClassAtom ;
                                    ns1:argument1 ns2:c ;
                                    ns1:classPredicate ns2:NotOvertaker ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 ns2:c ;
                                            ns1:argument2 "2"^^xsd:long ;
                                            ns1:propertyPredicate ns2:speedWithOvertaker ] ;
                                    rdf:rest () ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:SoftDecelerate ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:LastBeforeGap ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:ClassAtom ;
                            ns1:argument1 ns2:c ;
                            ns1:classPredicate ns2:Lateral ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:ClassAtom ;
                                    ns1:argument1 ns2:c ;
                                    ns1:classPredicate ns2:NotOvertaker ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 ns2:c ;
                                            ns1:argument2 "2"^^xsd:long ;
                                            ns1:propertyPredicate ns2:speedWithBeforeTheGapCar ] ;
                                    rdf:rest () ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:MaintainDistanceWithCarInFront ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                    ns1:argument1 <urn:swrl#c> ;
                    ns1:argument2 true ;
                    ns1:propertyPredicate ns2:hasSpaceAhead ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <urn:swrl#c> ;
                            ns1:argument2 false ;
                            ns1:propertyPredicate ns2:hasSpaceLateral ] ;
                    rdf:rest () ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 <urn:swrl#c> ;
                    ns1:classPredicate ns2:Ahead ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:Behind ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:ClassAtom ;
                            ns1:argument1 ns2:c ;
                            ns1:classPredicate ns2:Overtaker ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 ns2:c ;
                                    ns1:argument2 true ;
                                    ns1:propertyPredicate ns2:bigSpeedDifference ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 ns2:c ;
                                            ns1:argument2 "3"^^xsd:long ;
                                            ns1:propertyPredicate ns2:speedWithAheadCar ] ;
                                    rdf:rest [ a ns1:AtomList ;
                                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                    ns1:argument1 ns2:c ;
                                                    ns1:argument2 "2"^^xsd:long ;
                                                    ns1:propertyPredicate ns2:speedWithBehindCar ] ;
                                            rdf:rest () ] ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:Decelerate ] ;
            rdf:rest () ] .

[] a ns1:Imp ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 ns2:c ;
                    ns1:classPredicate ns2:Behind ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:ClassAtom ;
                            ns1:argument1 ns2:c ;
                            ns1:classPredicate ns2:Overtaker ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                    ns1:argument1 ns2:c ;
                                    ns1:argument2 "1"^^xsd:long ;
                                    ns1:propertyPredicate ns2:speedWithAheadCar ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                            ns1:argument1 ns2:c ;
                                            ns1:argument2 "3"^^xsd:long ;
                                            ns1:propertyPredicate ns2:speedWithBehindCar ] ;
