@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://usefulinc.com/ns/doap#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

onto:ArchRepository a rdfs:Class,
        owl:Class ;
    rdfs:label "GNU Arch repository"@en,
        "Dépôt GNU Arch"@fr ;
    rdfs:comment "GNU Arch source code repository."@en,
        "Dépôt GNU Arch du code source."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Repository .

onto:BKRepository a rdfs:Class,
        owl:Class ;
    rdfs:label "BitKeeper Repository"@en,
        "Dépôt BitKeeper"@fr ;
    rdfs:comment "BitKeeper source code repository."@en,
        "Dépôt BitKeeper du code source."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Repository .

onto:BazaarBranch a rdfs:Class ;
    rdfs:label "Bazaar Branch"@en ;
    rdfs:comment "Bazaar source code branch."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Repository .

onto:CVSRepository a rdfs:Class,
        owl:Class ;
    rdfs:label "CVS Repository"@en,
        "Dépôt CVS"@fr ;
    rdfs:comment "CVS source code repository."@en,
        "Dépôt CVS du code source."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Repository .

onto:DarcsRepository a rdfs:Class ;
    rdfs:label "darcs Repository"@en,
        "Dépôt darcs"@fr ;
    rdfs:comment "darcs source code repository."@en,
        "Dépôt darcs du code source."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Repository .

onto:GitRepository a rdfs:Class ;
    rdfs:label "Git Repository"@en,
        "Dépôt Git"@fr ;
    rdfs:comment "Git source code repository."@en,
        "Dépôt Git du code source."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Repository .

onto:HgRepository a rdfs:Class ;
    rdfs:label "Mercurial Repository"@en ;
    rdfs:comment "Mercurial source code repository."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Repository .

onto:Project a rdfs:Class ;
    rdfs:label "Project"@en,
        "Projet"@fr ;
    rdfs:comment "A project."@en,
        "Un projet."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf foaf:Project,
        <http://xmlns.com/wordnet/1.6/Project> .

onto:Repository a rdfs:Class ;
    rdfs:label "Repository"@en,
        "Dépôt"@fr ;
    rdfs:comment "Source code repository."@en,
        "Dépôt du code source."@fr ;
    rdfs:isDefinedBy onto: .

onto:SVNRepository a rdfs:Class ;
    rdfs:label "Subversion Repository"@en,
        "Dépôt Subversion"@fr ;
    rdfs:comment "Subversion source code repository."@en,
        "Dépôt Subversion du code source."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Repository .

onto:Specification a rdfs:Class ;
    rdfs:label "Specification"@en ;
    rdfs:comment "A specification of a system's aspects, technical or otherwise."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf rdfs:Resource .

onto:Version a rdfs:Class ;
    rdfs:label "Version"@en,
        "Version"@fr ;
    rdfs:comment "Version information of a project release."@en,
        "Détails sur une version d'une realease d'un projet."@fr ;
    rdfs:isDefinedBy onto: .

onto:anon-root a rdf:Property ;
    rdfs:label "anonymous root"@en,
        "racine anonyme"@fr ;
    rdfs:comment "Repository for anonymous access."@en,
        "Dépôt pour accès anonyme."@fr ;
    rdfs:domain onto:Repository ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:audience a rdf:Property ;
    rdfs:label "audience"@en ;
    rdfs:comment "Description of target user base"@en ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:blog a rdf:Property ;
    rdfs:label "blog"@en ;
    rdfs:comment "URI of a blog related to a project"@en ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Resource .

onto:browse a rdf:Property ;
    rdfs:label "browse"@en,
        "visualiser"@fr ;
    rdfs:comment "Web browser interface to repository."@en,
        "Interface web au dépôt."@fr ;
    rdfs:domain onto:Repository ;
    rdfs:isDefinedBy onto: .

onto:bug-database a rdf:Property ;
    rdfs:label "bug database"@en,
        "suivi des bugs"@fr ;
    rdfs:comment "Bug tracker for a project."@en,
        "Suivi des bugs pour un projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: .

onto:category a rdf:Property ;
    rdfs:label "category"@en,
        "catégorie"@fr ;
    rdfs:comment "A category of project."@en,
        "Une catégorie de projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: .

onto:created a rdf:Property ;
    rdfs:label "created"@en,
        "créé"@fr ;
    rdfs:comment "Date when something was created, in YYYY-MM-DD form. e.g. 2004-04-05"@en,
        "Date à laquelle a été créé quelque chose, au format AAAA-MM-JJ (par ex. 2004-04-05)"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:description a rdf:Property ;
    rdfs:label "description"@en,
        "description"@fr ;
    rdfs:comment "Plain text description of a project, of 2-4 sentences in length."@en,
        "Texte descriptif d'un projet, long de 2 à 4 phrases."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:developer a rdf:Property ;
    rdfs:label "developer"@en,
        "développeur"@fr ;
    rdfs:comment "Developer of software for the project."@en,
        "Développeur pour le projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person .

onto:documenter a rdf:Property ;
    rdfs:label "documenter"@en,
        "rédacteur de l'aide"@fr ;
    rdfs:comment "Contributor of documentation to the project."@en,
        "Collaborateur à la documentation du projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person .

onto:download-mirror a rdf:Property ;
    rdfs:label "download mirror"@en,
        "miroir pour le téléchargement"@fr ;
    rdfs:comment "Mirror of software download web page."@en,
        "Miroir de la page de téléchargement du programme."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: .

onto:download-page a rdf:Property ;
    rdfs:label "download page"@en,
        "page de téléchargement"@fr ;
    rdfs:comment "Web page from which the project software can be downloaded."@en,
        "Page web à partir de laquelle on peut télécharger le programme."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: .

onto:file-release a rdf:Property ;
    rdfs:label "file-release"@en ;
    rdfs:comment "URI of download associated with this release."@en ;
    rdfs:domain onto:Version ;
    rdfs:isDefinedBy onto: .

onto:helper a rdf:Property ;
    rdfs:label "helper"@en,
        "collaborateur"@fr ;
    rdfs:comment "Project contributor."@en,
        "Collaborateur au projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person .

onto:homepage a rdf:Property,
        owl:InverseFunctionalProperty ;
    rdfs:label "homepage"@en,
        "page web"@fr ;
    rdfs:comment "URL of a project's homepage,\\n\\t\\tassociated with exactly one project."@en,
        "L'URL de la page web d'un projet,\\n\\t\\tassociée avec un unique projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf foaf:homepage .

onto:implements a rdf:Property ;
    rdfs:label "Implements specification"@en ;
    rdfs:comment "A specification that a project implements. Could be a standard, API or legally defined level of conformance."@en ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Specification .

onto:language a rdf:Property ;
    rdfs:label "language"@en ;
    rdfs:comment "ISO language code a project has been translated into"@en,
        "このプロジェクトの翻訳された言語のISO言語コート"@en ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:license a rdf:Property ;
    rdfs:label "license"@en,
        "licence"@fr ;
    rdfs:comment "The URI of an RDF description of the license the software is distributed under."@en,
        "L'URI d'une description RDF de la licence sous laquelle le programme est distribué."@fr ;
    rdfs:isDefinedBy onto: .

onto:location a rdf:Property ;
    rdfs:label "repository location"@en,
        "emplacement du dépôt"@fr ;
    rdfs:comment "Location of a repository."@en,
        "Emplacement d'un dépôt."@fr ;
    rdfs:domain onto:Repository ;
    rdfs:isDefinedBy onto: .

onto:mailing-list a rdf:Property ;
    rdfs:label "mailing list"@en,
        "liste de diffusion"@fr ;
    rdfs:comment "Mailing list home page or email address."@en,
        "Page web de la liste de diffusion, ou adresse de courriel."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: .

onto:maintainer a rdf:Property ;
    rdfs:label "maintainer"@en,
        "développeur principal"@fr ;
    rdfs:comment "Maintainer of a project, a project leader."@en,
        "Développeur principal d'un projet, un meneur du projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person .

onto:module a rdf:Property ;
    rdfs:label "module"@en,
        "module"@fr ;
    rdfs:comment "Module name of a repository."@en,
        "Nom du module d'un dépôt."@fr ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:CVSRepository onto:ArchRepository onto:BKRepository ) ] ;
    rdfs:isDefinedBy onto: .

onto:name a rdf:Property ;
    rdfs:label "name"@en,
        "nom"@fr ;
    rdfs:comment "A name of something."@en,
        "Le nom de quelque chose."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf rdfs:label .

onto:old-homepage a rdf:Property,
        owl:InverseFunctionalProperty ;
    rdfs:label "old homepage"@en,
        "ancienne page web"@fr ;
    rdfs:comment "URL of a project's past homepage,\\n\\t\\tassociated with exactly one project."@en,
        "L'URL d'une ancienne page web d'un\\n\\t\\tprojet, associée avec un unique projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf foaf:homepage .

onto:os a rdf:Property ;
    rdfs:label "operating system"@en,
        "système d'exploitation"@fr ;
    rdfs:comment "Operating system that a project is limited to.  Omit this property if the project is not OS-specific."@en,
        "Système d'exploitation auquel est limité le projet. Omettez cette propriété si le\\n\\t\\tprojet n'est pas limité à un système d'exploitation."@fr ;
    rdfs:domain onto:Project,
        onto:Version ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:platform a rdf:Property ;
    rdfs:label "platform"@en ;
    rdfs:comment "Indicator of software platform (non-OS specific), e.g. Java, Firefox, ECMA CLR"@en ;
    rdfs:domain onto:Project,
        onto:Version ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:programming-language a rdf:Property ;
    rdfs:label "programming language"@en,
        "langage de programmation"@fr ;
    rdfs:comment "Programming language a project is implemented in or intended for use with."@en,
        "Langage de programmation avec lequel un projet est implémenté,\\n\\t\\tou avec lequel il est prévu de l'utiliser."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:release a rdf:Property ;
    rdfs:label "release"@en,
        "release"@fr ;
    rdfs:comment "A project release."@en,
        "Une release (révision) d'un projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Version .

onto:repository a rdf:Property ;
    rdfs:label "repository"@en,
        "dépôt"@fr ;
    rdfs:comment "Source code repository."@en,
        "Dépôt du code source."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Repository .

onto:revision a rdf:Property ;
    rdfs:label "revision"@en,
        "révision"@fr ;
    rdfs:comment "Revision identifier of a software release."@en,
        "Identifiant de révision d'une release du programme."@fr ;
    rdfs:domain onto:Version ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:screenshots a rdf:Property ;
    rdfs:label "screenshots"@en,
        "captures d'écran"@fr ;
    rdfs:comment "Web page with screenshots of project."@en,
        "Page web avec des captures d'écran du projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: .

onto:service-endpoint a rdf:Property ;
    rdfs:label "service endpoint"@en ;
    rdfs:comment "The URI of a web service endpoint where software as a service may be accessed"@en ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Resource .

onto:shortdesc a rdf:Property ;
    rdfs:label "short description"@en,
        "description courte"@fr ;
    rdfs:comment "Short (8 or 9 words) plain text description of a project."@en,
        "Texte descriptif concis (8 ou 9 mots) d'un projet."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

onto:tester a rdf:Property ;
    rdfs:label "tester"@en,
        "testeur"@fr ;
    rdfs:comment "A tester or other quality control contributor."@en,
        "このプロジェクトのため、試験をする人や品質メンテナー。"@en,
        "Un testeur ou un collaborateur au contrôle qualité."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person .

onto:translator a rdf:Property ;
    rdfs:label "translator"@en,
        "traducteur"@fr ;
    rdfs:comment "Contributor of translations to the project."@en,
        "Collaborateur à la traduction du projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person .

onto:vendor a rdf:Property ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Vendor organization: commercial, free or otherwise"@en ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Organization .

onto:wiki a rdf:Property ;
    rdfs:label "wiki"@en,
        "wiki"@fr ;
    rdfs:comment "URL of Wiki for collaborative discussion of project."@en,
        "L'URL du Wiki pour la discussion collaborative sur le projet."@fr ;
    rdfs:domain onto:Project ;
    rdfs:isDefinedBy onto: .

onto: a owl:Ontology ;
    dc:creator "Edd Dumbill" ;
    dc:description "The Description of a Project (DOAP) vocabulary, described using W3C RDF Schema and the Web Ontology Language.",
        "Le vocabulaire Description Of A Project (DOAP, Description D'Un Projet),\\n\\t\\tdécrit en utilisant RDF Schema du W3C et OWL."@fr ;
    dc:format "application/rdf+xml" ;
    dc:rights "Copyright © 2004-2009 Edd Dumbill" ;
    dc:title "Description of a Project (DOAP) vocabulary" ;
    owl:imports foaf:index.rdf ;
    foaf:maker [ a foaf:Person ;
            foaf:mbox <mailto:edd@usefulinc.com> ;
            foaf:name "Edd Dumbill" ] .

