@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://cookingbigdata.com/linkeddata/ccpricing#PriceCompound> a rdfs:Class,
        owl:Class ;
    rdfs:label "Compound"@en ;
    dcterms:description "."@en ;
    rdfs:comment "Compound"@en ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> .

<http://cookingbigdata.com/linkeddata/ccpricing#PricingPlan> a rdfs:Class,
        owl:Class ;
    rdfs:label "Prcing Plan"@en ;
    dcterms:description "."@en ;
    rdfs:comment "PricingPlan"@en ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> .

<http://cookingbigdata.com/linkeddata/ccpricing#hasPrice> a rdf:Property ;
    rdfs:label "Component price"@en ;
    rdfs:comment ""@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#PriceCompound> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range <http://purl.org/goodrelations/v1PriceSpecification> .

<http://cookingbigdata.com/linkeddata/ccpricing#hasPriceCompound> a rdf:Property ;
    rdfs:label "has Component price"@en ;
    rdfs:comment ""@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#PricingPlan> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccpricing#PriceCompound> .

<http://cookingbigdata.com/linkeddata/ccpricing#hasPricingPlan> a rdf:Property ;
    rdfs:label "Has pricing"@en ;
    rdfs:comment "Has pricing plans"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#ServicePricing> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccpricing#PricingPlan> .

<http://cookingbigdata.com/linkeddata/ccpricing#instance> a rdf:Property ;
    rdfs:label "Instance"@en ;
    rdfs:comment "Instance"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#PriceCompound> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccinstances#instance> .

<http://cookingbigdata.com/linkeddata/ccpricing#plan_name> a rdf:Property ;
    rdfs:label "Plan Name"@en ;
    rdfs:comment "Example Free"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#PricingPlan> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccpricing#region> a rdf:Property ;
    rdfs:label "Region"@en ;
    rdfs:comment "Region"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#PriceCompound> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccregions#region> .

<http://cookingbigdata.com/linkeddata/ccpricing#withMaxCompound> a rdf:Property ;
    rdfs:label "Max compound"@en ;
    rdfs:comment ""@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#PriceCompound> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range <http://purl.org/goodrelations/v1PriceSpecification> .

<http://cookingbigdata.com/linkeddata/ccpricing#withMaxPrice> a rdf:Property ;
    rdfs:label "Max price"@en ;
    rdfs:comment ""@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#PricingPlan> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range <http://purl.org/goodrelations/v1PriceSpecification> .

<http://cookingbigdata.com/linkeddata/ccpricing#withMinCompound> a rdf:Property ;
    rdfs:label "Min compound"@en ;
    rdfs:comment ""@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#PriceCompound> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range <http://purl.org/goodrelations/v1PriceSpecification> .

<http://cookingbigdata.com/linkeddata/ccpricing#withMinPrice> a rdf:Property ;
    rdfs:label "Min price"@en ;
    rdfs:comment ""@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccpricing#PricingPlan> ;
    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccpricing#> ;
    rdfs:range <http://purl.org/goodrelations/v1PriceSpecification> .

<http://cookingbigdata.com/linkeddata/ccpricing#cookingbigdata> a foaf:Organization ;
    rdfs:seeAlso <http://cookingbigdata.com/about> ;
    foaf:homepage <http://cookingbigdata.com> ;
    foaf:name "CookingBigData" .

<http://cookingbigdata.com/linkeddata/ccpricing#manuelparra> a foaf:Person ;
    rdfs:seeAlso <https://twitter.com/manugrapevine> ;
    foaf:homepage <https://twitter.com/manugrapevine> ;
    foaf:mbox "manuparra@gmail.com" ;
    foaf:name "Manuel Parra-Royon" .

<http://cookingbigdata.com/linkeddata/ccpricing#> a owl:Ontology ;
    rdfs:label "Pricing Plan for Cloud Computing Services"@en ;
    dcterms:created "2018-03-06"^^xsd:date ;
    dcterms:creator <http://cookingbigdata.com/linkeddata/ccpricing#manuelparra> ;
    dcterms:description "Simple and direct pricing ontology for Cloud Computing Services. This ontology allows to define model of prices used in large cloud computing providers such as Amazon, Azure, etc., including options for regions, type of instances, prices specification, etc. "@en ;
    dcterms:issued "2018-04-20"^^xsd:date ;
    dcterms:modified "2018-04-03"^^xsd:date ;
    dcterms:publisher <http://cookingbigdata.com/linkeddata/ccpricing#cookingbigdata> ;
    dcterms:rights "Copyright © 2018 Manuel Parra-Royón" ;
    dcterms:title "Vocabulary for prices options in Cloud Computing Services"@en ;
    owl:versionInfo 1.0 .

