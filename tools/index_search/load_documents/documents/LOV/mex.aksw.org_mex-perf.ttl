@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix onto: <http://mex.aksw.org/mex-perf> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "The MEX Vocabulary (mex-perf)"@en ;
    dc:publisher "AKSW Research Group - Leipzig University"@en ;
    dcterms:contributor <http://aksw.org/DiegoMoussallem.html>,
        <http://aksw.org/JensLehmann.html> ;
    dcterms:created "2014-02-02"^^xsd:date ;
    dcterms:creator <http://aksw.org/DiegoEsteves.html> ;
    dcterms:modified "2016-05-01"^^xsd:date ;
    dcterms:title "MEX Performance (mex-perf) is an ontology with the goal of describing performance values for machine learning problems (MEX Platform)"@en ;
    rdf:about "http://mex.aksw.org/mex-doc-perf#" ;
    rdfs:comment "MEX is an RDF vocabulary designed to facilitate interoperability between published machine learning experiments results on the Web. The mex-perf layer is the 3rd level of the MEX for representing the machine learning algorithm's performances."@en ;
    owl:imports doap:,
        rdfs:,
        <http://www.w3.org/ns/prov-o#> ;
    owl:versionInfo "1.0.2" .

<http://mex.aksw.org/mex-perf#ExamplePerformanceMeasureCollection> a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/prov-o#Collection> .

<http://mex.aksw.org/mex-perf#ExecutionPerformance> a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/prov-o#Activity> .

<http://mex.aksw.org/mex-perf#L1norm> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#L2norm> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#Linfnorm> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#UserDefinedMeasureCollection> a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/prov-o#Collection> .

<http://mex.aksw.org/mex-perf#accuracy> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#bonferroniDunn> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#chebyschevDistance> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClusteringMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#chiSquare> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#correlationCoefficient> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#RegressionMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#cosine> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClusteringMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#costParameter> a owl:DatatypeProperty .

<http://mex.aksw.org/mex-perf#error> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure>,
        <http://mex.aksw.org/mex-perf#ClusteringMeasure>,
        <http://mex.aksw.org/mex-perf#RegressionMeasure>,
        <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#euclideanDistance> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClusteringMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#f1Measure> a owl:DatatypeProperty ;
    dc:description "F-measure or F-score or F1 score" ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#falseNegative> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:integer .

<http://mex.aksw.org/mex-perf#falseNegativeRate> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#falsePositive> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:integer .

<http://mex.aksw.org/mex-perf#falsePositiveRate> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#folds> a owl:DatatypeProperty ;
    rdfs:range xsd:int .

<http://mex.aksw.org/mex-perf#formula> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#UserDefinedMeasure> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-perf#friedman> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#genSimilarityCoefficient> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClusteringMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#hammingDistance> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClusteringMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#kappaStatistics> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#kernel> a owl:DatatypeProperty ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-perf#kolmogorovSmirnov> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#manhattanDistance> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClusteringMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#mean> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#meanAbsoluteDeviation> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#RegressionMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#meanSquaredError> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#RegressionMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#median> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#medianAbsoluteDeviation> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#RegressionMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#mode> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#nemenyi> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#pearsonCorrelation> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#pmi> a owl:DatatypeProperty ;
    rdfs:label "Pointwise mutual information"@en ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#precision> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#predictedValue> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ExamplePerformanceMeasure> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-perf#realValue> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ExamplePerformanceMeasure> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-perf#recall> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#relativeAbsoluteError> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#RegressionMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#residual> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#RegressionMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#roc> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#rootMeanSquaredError> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#RegressionMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#rootRelativeSquaredError> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#RegressionMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#sensitivity> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#specificity> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#spmi> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> .

<http://mex.aksw.org/mex-perf#standardDeviation> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#totalError> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#RegressionMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#trueNegative> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:integer .

<http://mex.aksw.org/mex-perf#trueNegativeRate> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#truePositive> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:integer .

<http://mex.aksw.org/mex-perf#truePositiveRate> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#ClassificationMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#variance> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#wilcoxon> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-perf#StatisticalMeasure> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-perf#UserDefinedMeasure> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-perf#PerformanceMeasure> .

<http://www.w3.org/ns/prov-o#Activity> a owl:Class .

<http://mex.aksw.org/mex-perf#ExamplePerformanceMeasure> a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/prov-o#Entity> .

<http://www.w3.org/ns/prov-o#Collection> a owl:Class .

<http://www.w3.org/ns/prov-o#Entity> a owl:Class .

<http://mex.aksw.org/mex-perf#PerformanceMeasure> a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/prov-o#Entity> .

<http://mex.aksw.org/mex-perf#ClusteringMeasure> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-perf#PerformanceMeasure> .

<http://mex.aksw.org/mex-perf#RegressionMeasure> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-perf#PerformanceMeasure> .

<http://mex.aksw.org/mex-perf#ClassificationMeasure> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-perf#PerformanceMeasure> .

<http://mex.aksw.org/mex-perf#StatisticalMeasure> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-perf#PerformanceMeasure> .

