onto:lccn a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Collection onto:Document ) ] ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:identifier .

onto:numPages a owl:DatatypeProperty ;
    rdfs:label "number of pages"@en ;
