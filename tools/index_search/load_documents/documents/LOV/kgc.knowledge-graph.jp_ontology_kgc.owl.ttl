@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix onto: <http://kgc.knowledge-graph.jp/ontology/kgc.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    dc:description "This vocabulary set can represent 5W1H (Who, What, When, Where, Why, How) in event (scene) descriptions. This file is also provided in Knowledge Graph Reasoning Challenge." ;
    dc:title "KGRC Ontology" ;
    rdfs:seeAlso <https://github.com/KnowledgeGraphJapan/KGRC-RDF> ;
    owl:versionIRI <http://kgc.knowledge-graph.jp/ontology/kgc.owl#1.0.0> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#AbstractTime> a owl:Class .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#CanNotAction> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#NotAction> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Not> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#ActionOption> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#OFobj> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Object> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#ORobj> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Object> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Person> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Animal> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Place> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Object> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Property> a owl:Class .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Situation> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Scene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Statement> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Scene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Talk> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Scene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Thought> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Scene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#adjunct> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#around> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#at_the_same_time> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#RelationBetweenScene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#because> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#RelationBetweenScene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#canNot> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#ActionOption> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#from> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#hasPart> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#TargetObjProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#hasPredicate> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#TargetObjProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#hasProperty> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#TargetObjProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#how> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneObjectProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#if> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#RelationBetweenScene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#infoReceiver> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#infoSource> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#left> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#middle> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#near> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#next_to> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#ofPart> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#TargetObjProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#ofWhole> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#TargetObjProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#on> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#opposite> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#orTarget> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#TargetObjProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#otherwise> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#RelationBetweenScene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#right> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#subject> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#then> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#RelationBetweenScene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#therefore> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#RelationBetweenScene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#time> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:range xsd:DateTime .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#to> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#what> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneObjectProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#when> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#RelationBetweenScene>,
        <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneObjectProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#when_during> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#RelationBetweenScene> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#where> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#whom> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneObjectProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#why> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneObjectProperty> .

dc:description a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Action> a owl:Class .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Animal> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Object> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#NotAction> a owl:Class ;
    rdfs:subClassOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#Action> .

xsd:DateTime a owl:Class .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#ActionOption> a owl:ObjectProperty .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Object> a owl:Class .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#Scene> a owl:Class .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneProperty> a owl:ObjectProperty .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneObjectProperty> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneProperty> .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#TargetObjProperty> a owl:ObjectProperty .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#RelationBetweenScene> a owl:ObjectProperty .

<http://kgc.knowledge-graph.jp/ontology/kgc.owl#LocationProperty> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://kgc.knowledge-graph.jp/ontology/kgc.owl#SceneObjectProperty> .

