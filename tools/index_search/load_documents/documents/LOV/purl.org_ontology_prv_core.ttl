@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://spinrdf.org/spin#> .
@prefix onto: <http://purl.org/ontology/prv/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:PropertyReification a rdfs:Class ;
    rdfs:label "Property Reification"@en ;
    rdfs:comment "The class, which describes the relations of a property reification. That means, its \"shortcut relation\", its \\nreification class, and the properties that are relating to the subject and object of the \"shortcut relation\"."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf rdfs:Class ;
    ns1:term_status "testing"@en .

onto:object_property a rdf:Property ;
    rdfs:label "has object property"@en ;
    rdfs:comment "Relates to the property of the reification class, which relates to the object of the \"shortcut relation\"."@en ;
    rdfs:domain onto:PropertyReification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:Property ;
    ns1:term_status "testing"@en .

onto:reification_class a rdf:Property ;
    rdfs:label "has reification class"@en ;
    rdfs:comment "Relates to the reification class, which can be related to the object and subject property to be able to associate the \\nobject and subject of the \"shortcut relation\". The reification class should provide detailed descriptions of the relationship that is \\ndescribed in a simple form by the \"shortcut relation\"."@en ;
    rdfs:domain onto:PropertyReification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Class ;
    ns1:term_status "testing"@en .

onto:reified a rdf:Property ;
    rdfs:label "reified"@en ;
    rdfs:comment "This property relates an statement identifier of a shortcut relation with an instance of a reification class. Although, this is at the moment not really applicable, because it requires a notation for statement identifier as optional fourth element of a tuple; that means, triple + statement identifier."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    ns1:term_status "testing"@en .

onto:shortcut a rdf:Property ;
    rdfs:label "has shortcut"@en ;
    rdfs:comment "Relates to the property of the \"shortcut relation\" (its predicate)."@en ;
    rdfs:domain onto:PropertyReification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:Property ;
    ns1:term_status "testing"@en .

onto:shortcut_property a rdf:Property ;
    rdfs:label "has shortcut property"@en ;
    rdfs:comment "Relates to the property of the reification class,  which relates to the predicate of the \"shortcut relation\". So \\nthat the specific property reification can be \"verified\" (the property of the prv:shortcut relation and this one associated by the \\nreferred shortcut property should be equal)."@en ;
    rdfs:domain onto:PropertyReification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:Property ;
    ns1:term_status "testing"@en .

onto:subject_property a rdf:Property ;
    rdfs:label "has subject property"@en ;
    rdfs:comment "Relates to the property of the reification class, which relates to the subject of the \"shortcut relation\"."@en ;
    rdfs:domain onto:PropertyReification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:Property ;
    ns1:term_status "testing"@en .

onto: a owl:Ontology ;
    dc:creator <http://foaf.me/zazi#me>,
        <http://mud.cz/foaf.rdf#ojirio>,
        <http://richard.cyganiak.de/foaf.rdf#cygri>,
        <http://tobyinkster.co.uk/#i> ;
    dc:date "2011-02-19T14:38:53+01:00"^^xsd:dateTime ;
    dc:description "A vocabulary for describing the ontology design pattern of property reification. That means the semantic relation of \\na \"shortcut relation\" (subject, predicate, object) with its detailed description of the relationship."@en ;
    dc:title "Property Reification Vocabulary"@en ;
    vann:preferredNamespacePrefix "prv" ;
    vann:preferredNamespaceUri "http://purl.org/ontology/prv/core#" ;
    ns2:imports <http://purl.org/ontology/prv/rules> ;
    owl:imports dc:,
        vann:,
        <http://www.w3.org/2003/06/sw-vocab-status/ns>,
        foaf: ;
    owl:versionInfo 0.11 .

