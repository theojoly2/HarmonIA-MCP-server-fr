<http://purl.org/procurement/public-contracts#lot> a owl:ObjectProperty ;
    rdfs:label "Lot"@en ;
    rdfs:isDefinedBy <http://purl.org/procurement/public-contracts#> .

<http://webdiis.unizar.es/~seron/> a owl:NamedIndividual,
        foaf:Person .

<http://www.araid.es/en/users/jfm#profile-investigador> a owl:NamedIndividual,
        foaf:Person .

xsd:duration a rdfs:Datatype .

<https://www.linkedin.com/profile/view?id=218098827> a owl:NamedIndividual,
        foaf:Person .

<http://contsem.unizar.es/def/sector-publico/pproc#Briefing> a owl:Class ;
    rdfs:label "Briefing"@en ;
    rdfs:comment "Informative meeting about the public procurement contract."@en ;
    rdfs:subClassOf <http://schema.org/Event> .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractBodies> a owl:Class ;
    rdfs:label "Contract bodies"@en ;
    rdfs:comment "Class describing the bodies related to the contract."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractWithLots> a owl:Class ;
    rdfs:label "Contract with lots"@en ;
    rdfs:comment "Class of the contract that have lots."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://contsem.unizar.es/def/sector-publico/pproc#lot> ;
            owl:someValuesFrom <http://contsem.unizar.es/def/sector-publico/pproc#Lot> ],
        <http://contsem.unizar.es/def/sector-publico/pproc#Contract> .

<http://contsem.unizar.es/def/sector-publico/pproc#ElectronicAuctionPhase> a owl:Class ;
    rdfs:label "Electronic auction phase"@en ;
    rdfs:comment "Class describing a phase of an electronic auction."@en ;
    rdfs:subClassOf <http://schema.org/Event> .

<http://contsem.unizar.es/def/sector-publico/pproc#Negotiated> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Negotiated"@en ;
    rdfs:comment "Abstract concept defining the procedure of the contract as negotiated."@en ;
    owl:sameAs <http://purl.org/procurement/public-contracts#Negotiated> ;
    skos:inScheme <http://contsem.unizar.es/def/sector-publico/pproc#ProcedureTypeScheme> ;
    skos:narrower <http://contsem.unizar.es/def/sector-publico/pproc#NegotiatedWithPublicity>,
        <http://contsem.unizar.es/def/sector-publico/pproc#NegotiatedWithoutPublicity> ;
    skos:topConceptOf <http://contsem.unizar.es/def/sector-publico/pproc#ProcedureTypeScheme> .

<http://contsem.unizar.es/def/sector-publico/pproc#lot> a owl:ObjectProperty ;
    rdfs:label "Lote",
        "Lot"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractWithLots> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#Lot> ;
    rdfs:subPropertyOf <http://purl.org/procurement/public-contracts#lot> .

<http://purl.org/goodrelations/v1#PriceSpecification> a owl:Class ;
    rdfs:label "Price specification"@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1#> .

<http://schema.org/Place> a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:isDefinedBy <http://schema.org/> .

foaf:member a owl:ObjectProperty ;
    rdfs:label "Member"@en ;
    rdfs:isDefinedBy foaf: .

<http://contsem.unizar.es/def/sector-publico/pproc#BundlePriceSpecification> a owl:Class ;
    rdfs:label "Bundle price"@en ;
    rdfs:comment "Class used to describe the price a set of objets.\\n\\nCan be used to define the total price of an gr:Offering. Its value must be equal to the gr:UnitPriceSpecification multiplied by the number of items."@en ;
    rdfs:subClassOf <http://purl.org/goodrelations/v1#PriceSpecification> .

<http://contsem.unizar.es/def/sector-publico/pproc#CommitteeMember> a owl:Class ;
    rdfs:label "Committee member"@en ;
    rdfs:comment "Class that describes the member a committee."@en ;
    rdfs:subClassOf foaf:Person .

<http://contsem.unizar.es/def/sector-publico/pproc#ConclusionContract> a owl:Class ;
    rdfs:label "Conclusion contract"@en ;
    rdfs:comment "Class describing the contracts consisting in the conclusion of a framework agreement or a dynamic purchasing system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://contsem.unizar.es/def/sector-publico/pproc#frameworkAgreement> ;
            owl:someValuesFrom <http://contsem.unizar.es/def/sector-publico/pproc#FrameworkAgreement> ],
        <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    owl:disjointWith <http://contsem.unizar.es/def/sector-publico/pproc#DerivativeContract> .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractingBodyAgreement> a owl:Class ;
    rdfs:label "Contracting body agreement"@en .

<http://contsem.unizar.es/def/sector-publico/pproc#CriterionScore> a owl:Class ;
    rdfs:label "Criterion score"@en ;
    rdfs:comment "Class to describe an award criterion and its score."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#ElectronicAuction> a owl:Class ;
    rdfs:label "Electronic auction"@en ;
    rdfs:comment "Class that specifies the existence of an electronic auction of one or more of the award criterions."@en .

<http://schema.org/Event> a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:isDefinedBy <http://schema.org/> .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept scheme"@en ;
    rdfs:isDefinedBy skos: .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "In scheme"@en ;
    rdfs:isDefinedBy skos: .

org:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:isDefinedBy org: .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractActivities> a owl:Class ;
    rdfs:label "Contract activites"@en ;
    rdfs:comment "Class describing all activities of a contract (e.g. meetings or agreements of the contracting body)."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractExecutionConditions> a owl:Class ;
    rdfs:label "Contract execution conditions"@en ;
    rdfs:comment "Class that defines the execution conditions of the contract (e.g. special execution conditions or subcontracting percentage amounts)."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractModificationConditions> a owl:Class ;
    rdfs:label "Contract modification conditions"@en ;
    rdfs:comment "Class describing the conditions for which a contract can be modified (e.g. maximum percentage of its price or budget)."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractTemporalConditions> a owl:Class ;
    rdfs:label "Contract temporal conditions"@en ;
    rdfs:comment "Class that describes the temporal conditions of the contract."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#DerivativeContract> a owl:Class ;
    rdfs:label "Derivative contract"@en ;
    rdfs:comment "Class describing contracts derived from a framework agreement or a dynamic purchasing system."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Contract> .

<http://contsem.unizar.es/def/sector-publico/pproc#InformationProvider> a owl:Class ;
    rdfs:label "Information provider"@en ;
    rdfs:comment "Class defining the provider of information about the contract."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#Lot> a owl:Class ;
    rdfs:label "Lot"@en ;
    rdfs:comment "Class describing contracts that are an actual lot of another contract."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Contract> .

<http://contsem.unizar.es/def/sector-publico/pproc#SuppliesContract> a owl:Class ;
    rdfs:label "Supplies contract"@en ;
    rdfs:comment "Class describing contracts whose object is the acquisition of supplies."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Contract> .

<http://contsem.unizar.es/def/sector-publico/pproc#TenderMeeting> a owl:Class ;
    rdfs:label "Tender meeting"@en ;
    rdfs:comment "Class describing the meetings of tender committee."@en ;
    rdfs:subClassOf <http://schema.org/Event> .

<http://contsem.unizar.es/def/sector-publico/pproc#TenderRequirements> a owl:Class ;
    rdfs:label "Tender requirements"@en ;
    rdfs:comment "Class to define the tender requirements needed to submit a tender (e.g. tender document needs)."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#contractOrProcedureExtinction> a owl:ObjectProperty ;
    rdfs:label "Contract or procedure extinction"@en ;
    rdfs:comment "Abstract property pointing to extinction of contract or procedure. Use any of its subclasses."@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractOrProcedureExtinction> .

<http://contsem.unizar.es/def/sector-publico/pproc#price> a owl:ObjectProperty ;
    rdfs:label "Price"@en ;
    rdfs:range <http://purl.org/goodrelations/v1#PriceSpecification> .

<http://purl.org/goodrelations/v1#Offering> a owl:Class ;
    rdfs:label "Offering"@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1#> .

foaf:Document a owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:isDefinedBy foaf: .

<http://contsem.unizar.es/def/sector-publico/pproc#PublicServicesManagementContract> a owl:Class ;
    rdfs:label "Public services management contract"@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Contract> .

<http://contsem.unizar.es/def/sector-publico/pproc#documentReference> a owl:ObjectProperty ;
    rdfs:label "Document reference"@en ;
    rdfs:comment "Links to external documents."@en ;
    rdfs:range foaf:Document ;
    rdfs:seeAlso <http://purl.org/procurement/public-contracts#attachment> .

<http://contsem.unizar.es/def/sector-publico/pproc#duration> a owl:DatatypeProperty ;
    rdfs:label "Duration"@en ;
    rdfs:range xsd:duration .

foaf:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:isDefinedBy foaf: .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractAdditionalObligations> a owl:Class ;
    rdfs:label "Contract additional obligations"@en ;
    rdfs:comment "Class describing the additional obligations the contract needs (e.g. guarantees or advertisement costs)"@en .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractModification> a owl:Class ;
    rdfs:label "Contract modification"@en ;
    rdfs:comment "During the execution of a contract it could happen that the contract should be modified, to describe these kind of situations we use this class."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#FrameworkAgreement> a owl:Class ;
    rdfs:label "Framework agreement or dynamic purchasing system"@en ;
    rdfs:comment "Class used to describe a contract that is a declaration of a framework agreement or a dynamic purchasing system."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#InformationKindScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Information kind scheme"@en ;
    rdfs:comment "Scheme that indicates the type of the information that can be provided."@en .

<http://purl.org/procurement/public-contracts#AwardCriterion> a owl:Class ;
    rdfs:label "Award criterion"@en ;
    rdfs:isDefinedBy <http://purl.org/procurement/public-contracts#> .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractEconomicConditions> a owl:Class ;
    rdfs:label "Contract economic conditions"@en ;
    rdfs:comment "Class defining the actual economic conditions of the contract (e.g. budget or the formula that describes the revision of its price)."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractOrProcedureExtinction> a owl:Class ;
    rdfs:label "Contract or procedure extinction"@en ;
    rdfs:comment "Abstract class. There are some circumstances resulting in the extinction of the procedure of the contract or the contract itself. To describe that situations we may use one of its subclasses."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#TenderersRequirements> a owl:Class ;
    rdfs:label "Tenderers requirements"@en ;
    rdfs:comment "Class defining the tenderers requirements (e.g. required classification or financial capability)."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#Committee> a owl:Class ;
    rdfs:label "Tender committee"@en ;
    rdfs:comment "Abstract class describing a set of persons in committee and its roles."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#UrgencyTypeScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Urgency type scheme"@en ;
    rdfs:comment "Scheme that defines the kinds of urgency a procedure can follow."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractObject> a owl:Class ;
    rdfs:label "Contract object"@en ;
    rdfs:comment "Class that defines the object of the contract and the conditions or modifications the contract can have."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#Notice> a owl:Class ;
    rdfs:label "Notice"@en .

<http://contsem.unizar.es/def/sector-publico/pproc#Remedy> a owl:Class ;
    rdfs:label "Remedy"@en ;
    rdfs:comment "Remedy lodged concerning a resolution about the procurement procedure."@en .

xsd:date a rdfs:Datatype .

dcterms:date a owl:DatatypeProperty ;
    rdfs:label "Date"@en ;
    rdfs:isDefinedBy dcterms: .

<http://purl.org/procurement/public-contracts#Tender> a owl:Class ;
    rdfs:label "Tender"@en ;
    rdfs:isDefinedBy <http://purl.org/procurement/public-contracts#> .

<http://contsem.unizar.es/def/sector-publico/pproc#ProcedureTypeScheme> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Procedure type scheme"@en ;
    rdfs:comment "Scheme defining the procedure to be followed in a tender."@en .

<http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> a owl:Class ;
    rdfs:label "Contract procedure"@en ;
    rdfs:comment "Class that specifies the procedure of a contract (e.g. type of procedure or its urgency)."@en .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:isDefinedBy skos: .

<http://contsem.unizar.es/def/sector-publico/pproc#Contract> a owl:Class ;
    rdfs:label "Public contract"@en ;
    rdfs:subClassOf <http://purl.org/procurement/public-contracts#Contract> .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://contsem.unizar.es/def/sector-publico/pproc#MixedContract> <http://contsem.unizar.es/def/sector-publico/pproc#PrecomercialProcurement> <http://contsem.unizar.es/def/sector-publico/pproc#PrivateContract> <http://contsem.unizar.es/def/sector-publico/pproc#PublicPrivatePartnershipContract> <http://contsem.unizar.es/def/sector-publico/pproc#PublicServicesManagementContract> <http://contsem.unizar.es/def/sector-publico/pproc#PublicWorksConcessionContract> <http://contsem.unizar.es/def/sector-publico/pproc#ServicesContract> <http://contsem.unizar.es/def/sector-publico/pproc#SpecialAdministrativeContract> <http://contsem.unizar.es/def/sector-publico/pproc#SuppliesContract> <http://contsem.unizar.es/def/sector-publico/pproc#WorksContract> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://contsem.unizar.es/def/sector-publico/pproc#AdditionalInformationNotice> <http://contsem.unizar.es/def/sector-publico/pproc#ContractAwardNotice> <http://contsem.unizar.es/def/sector-publico/pproc#ContractNotice> <http://contsem.unizar.es/def/sector-publico/pproc#CorrectionNotice> <http://contsem.unizar.es/def/sector-publico/pproc#FormalizationNotice> <http://contsem.unizar.es/def/sector-publico/pproc#PriorInformationNotice> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://contsem.unizar.es/def/sector-publico/pproc#ContractWithLots> <http://contsem.unizar.es/def/sector-publico/pproc#ContractWithoutLots> <http://contsem.unizar.es/def/sector-publico/pproc#Lot> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://contsem.unizar.es/def/sector-publico/pproc#BuyContract> <http://contsem.unizar.es/def/sector-publico/pproc#LeaseContract> <http://contsem.unizar.es/def/sector-publico/pproc#RentContract> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://contsem.unizar.es/def/sector-publico/pproc#AgreementContract> <http://contsem.unizar.es/def/sector-publico/pproc#ConcessionContract> <http://contsem.unizar.es/def/sector-publico/pproc#MixedCapitalCompanyContract> <http://contsem.unizar.es/def/sector-publico/pproc#SharedResultAgreementContract> ) .

