            owl:onProperty <http://contsem.unizar.es/def/sector-publico/pproc#numberOfLots> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass <http://contsem.unizar.es/def/sector-publico/pproc#Lot> ;
            owl:onProperty <http://contsem.unizar.es/def/sector-publico/pproc#lot> ],
