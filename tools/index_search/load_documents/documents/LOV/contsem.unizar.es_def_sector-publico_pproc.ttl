@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://contsem.unizar.es/def/sector-publico/pproc> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://contsem.unizar.es/def/sector-publico/contsem> a owl:NamedIndividual ;
    dcterms:title "CONTSEM ontology"@en .

onto: a owl:Ontology ;
    rdfs:label "public procurement ontology"@en ;
    dcterms:creator <http://es.linkedin.com/pub/guillermo-esteban-p%C3%A9rez/56/210/5a8>,
        <http://webdiis.unizar.es/~seron/>,
        <http://www.araid.es/en/users/jfm#profile-investigador>,
        <https://www.linkedin.com/profile/view?id=218098827> ;
    owl:versionInfo "1.0.0",
        "Changes from 0.1.4 to 1.0.0:\\n\\n- Minor RDF documentation changes\\n- Added new axiom (pproc:ContractWithoutLots rdfs:subClassOf pproc:numberOfLots value 0)\\n- Web documentation changes\\n- Fixed an error where pproc:criterion had pc:AwardCriteriaCombination as range (instead pc:AwardCriterion)\\n- Added missing pproc:additionalObject to link multiple CPVs\\n- Added missing pproc:endMode from pproc:ElectronicAuctionPhase"@en .

<http://contsem.unizar.es/def/sector-publico/pproc#AcceptedTender> a owl:Class ;
    rdfs:label "Accepted tender"@en ;
    rdfs:comment "Class describing the tenders accepted in the procurement public contract."@en ;
    rdfs:subClassOf <http://purl.org/procurement/public-contracts#Tender> ;
    owl:disjointWith <http://contsem.unizar.es/def/sector-publico/pproc#ExcludedTender> .

<http://contsem.unizar.es/def/sector-publico/pproc#AdministrativeInformation> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Administrative information"@en ;
    skos:inScheme <http://contsem.unizar.es/def/sector-publico/pproc#InformationKindScheme> ;
    skos:topConceptOf <http://contsem.unizar.es/def/sector-publico/pproc#InformationKindScheme> .

<http://contsem.unizar.es/def/sector-publico/pproc#AwardedTender> a owl:Class ;
    rdfs:label "Awarded tender"@en ;
    rdfs:comment "Class describing the awarded tenders."@en ;
    rdfs:subClassOf <http://purl.org/procurement/public-contracts#Tender> ;
    owl:backwardCompatibleWith <http://purl.org/procurement/public-contracts#awardedTender> .

<http://contsem.unizar.es/def/sector-publico/pproc#DynamicPurchasingSystemConclusionContract> a owl:Class ;
    rdfs:label "Dynamic purchasing system conclusion contract"@en ;
    rdfs:comment "Class describing the contracts consisting in the conclusion of a dynamic purchasing system."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#ConclusionContract> .

<http://contsem.unizar.es/def/sector-publico/pproc#DynamicPurchasingSystemDerivativeContract> a owl:Class ;
    rdfs:label "Dynamic purchasing system derivative contract"@en ;
    rdfs:comment "Class describing contracts derived from a dynamic purchasing system."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#DerivativeContract> .

<http://contsem.unizar.es/def/sector-publico/pproc#Emergency> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Emergency"@en ;
    skos:inScheme <http://contsem.unizar.es/def/sector-publico/pproc#UrgencyTypeScheme> ;
    skos:topConceptOf <http://contsem.unizar.es/def/sector-publico/pproc#UrgencyTypeScheme> .

<http://contsem.unizar.es/def/sector-publico/pproc#ExpertCommittee> a owl:Class ;
    rdfs:label "Expert committee"@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Committee> .

<http://contsem.unizar.es/def/sector-publico/pproc#Express> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Express"@en ;
    skos:inScheme <http://contsem.unizar.es/def/sector-publico/pproc#UrgencyTypeScheme> ;
    skos:topConceptOf <http://contsem.unizar.es/def/sector-publico/pproc#UrgencyTypeScheme> .

<http://contsem.unizar.es/def/sector-publico/pproc#ExtendableContract> a owl:Class ;
    rdfs:label "Extendable contract"@en ;
    rdfs:comment "Class describing contracts whose end date can be extended."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Contract> .

<http://contsem.unizar.es/def/sector-publico/pproc#FormalizedTender> a owl:Class ;
    rdfs:label "Formalized tender"@en ;
    rdfs:comment "Class describing tenders being formalized."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://contsem.unizar.es/def/sector-publico/pproc#formalizedDate> ;
            owl:someValuesFrom xsd:date ],
        <http://purl.org/procurement/public-contracts#Tender> .

<http://contsem.unizar.es/def/sector-publico/pproc#FrameworkConclusionContract> a owl:Class ;
    rdfs:label "Framework conclusion contract"@en ;
    rdfs:comment "Class describing the contracts consisting in the conclusion of a framework agreement."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#ConclusionContract> .

<http://contsem.unizar.es/def/sector-publico/pproc#FrameworkDerivativeContract> a owl:Class ;
    rdfs:label "Framework derivative contract"@en ;
    rdfs:comment "Class describing contracts derived from a framework agreement."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#DerivativeContract> .

<http://contsem.unizar.es/def/sector-publico/pproc#HarmonizedContract> a owl:Class ;
    rdfs:label "Harmonized contract"@en ;
    rdfs:comment "Class to describe harmonized contracts (i.e. contracts that reachs the threshold to be treated as highlighted in the procurement Directives of the European Commision and European Council)."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Contract> .

<http://contsem.unizar.es/def/sector-publico/pproc#LegalRemedy> a owl:Class ;
    rdfs:label "Legal remedy"@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Remedy> .

<http://contsem.unizar.es/def/sector-publico/pproc#Minor> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Minor"@en ;
    skos:inScheme <http://contsem.unizar.es/def/sector-publico/pproc#ProcedureTypeScheme> ;
    skos:topConceptOf <http://contsem.unizar.es/def/sector-publico/pproc#ProcedureTypeScheme> .

<http://contsem.unizar.es/def/sector-publico/pproc#MultiannualContract> a owl:Class ;
    rdfs:label "Multiannual contract"@en ;
    rdfs:comment "Class describing the multiannual contracts (i.e. contract whose duration extends over more than one financial year)."@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Contract> .

<http://contsem.unizar.es/def/sector-publico/pproc#ObjectiveAwardCriterion> a owl:Class ;
    rdfs:label "Objective award criterion"@en ;
    rdfs:comment "Class describing criterioa that depend on a value judgement."@en ;
    rdfs:subClassOf <http://purl.org/procurement/public-contracts#AwardCriterion> .

<http://contsem.unizar.es/def/sector-publico/pproc#OrdinaryAdministrativeRemedy> a owl:Class ;
    rdfs:label "Ordinary administrative remedy"@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Remedy> .

<http://contsem.unizar.es/def/sector-publico/pproc#Regular> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Regular"@en ;
    skos:inScheme <http://contsem.unizar.es/def/sector-publico/pproc#UrgencyTypeScheme> ;
    skos:topConceptOf <http://contsem.unizar.es/def/sector-publico/pproc#UrgencyTypeScheme> .

<http://contsem.unizar.es/def/sector-publico/pproc#RegularOpen> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Regular open"@en ;
    owl:sameAs <http://purl.org/procurement/public-contracts#Open> ;
    skos:inScheme <http://contsem.unizar.es/def/sector-publico/pproc#ProcedureTypeScheme> ;
    skos:topConceptOf <http://contsem.unizar.es/def/sector-publico/pproc#ProcedureTypeScheme> .

<http://contsem.unizar.es/def/sector-publico/pproc#SimpleOpen> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Simple open"@en ;
    skos:inScheme <http://contsem.unizar.es/def/sector-publico/pproc#ProcedureTypeScheme> ;
    skos:topConceptOf <http://contsem.unizar.es/def/sector-publico/pproc#ProcedureTypeScheme> .

<http://contsem.unizar.es/def/sector-publico/pproc#SpecialAdministrativeRemedy> a owl:Class ;
    rdfs:label "Special administrative remedy"@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Remedy> .

<http://contsem.unizar.es/def/sector-publico/pproc#SubjectiveAwardCriterion> a owl:Class ;
    rdfs:label "Subjective award criterion"@en ;
    rdfs:comment "Class used to describe criteria that depend on a subjetive opinion."@en ;
    rdfs:subClassOf <http://purl.org/procurement/public-contracts#AwardCriterion> .

<http://contsem.unizar.es/def/sector-publico/pproc#TechnicalCommittee> a owl:Class ;
    rdfs:label "Technical committee"@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Committee> .

<http://contsem.unizar.es/def/sector-publico/pproc#TechnicalInformation> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Technical information"@en ;
    skos:inScheme <http://contsem.unizar.es/def/sector-publico/pproc#InformationKindScheme> ;
    skos:topConceptOf <http://contsem.unizar.es/def/sector-publico/pproc#InformationKindScheme> .

<http://contsem.unizar.es/def/sector-publico/pproc#TenderCommittee> a owl:Class ;
    rdfs:label "Tender committee"@en ;
    rdfs:subClassOf <http://contsem.unizar.es/def/sector-publico/pproc#Committee> .

<http://contsem.unizar.es/def/sector-publico/pproc#actualDuration> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Actual duration"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    rdfs:subPropertyOf <http://contsem.unizar.es/def/sector-publico/pproc#duration> .

<http://contsem.unizar.es/def/sector-publico/pproc#additionalDocumentReference> a owl:ObjectProperty ;
    rdfs:label "Additional document reference"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    rdfs:subPropertyOf <http://contsem.unizar.es/def/sector-publico/pproc#documentReference> .

<http://contsem.unizar.es/def/sector-publico/pproc#additionalObject> a owl:ObjectProperty ;
    rdfs:label "Additional object of contract"@en ;
    rdfs:comment "Property that points to the concept of the CPV code of an object.\\n\\nThe concept used should be a valid representation of a CPV code, as it is in http://cpv.data.ac.uk/."@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractObject> ;
    rdfs:range skos:Concept ;
    owl:backwardCompatibleWith <http://purl.org/procurement/public-contracts#additionalObject> .

<http://contsem.unizar.es/def/sector-publico/pproc#advertisementAmount> a owl:DatatypeProperty ;
    rdfs:label "Advertisement amount"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractAdditionalObligations> ;
    rdfs:range xsd:string .

<http://contsem.unizar.es/def/sector-publico/pproc#alternateMember> a owl:ObjectProperty ;
    rdfs:label "Alternate member"@en ;
    rdfs:comment "Points to an alternate member of a committee."@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Committee> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#CommitteeMember> ;
    rdfs:subPropertyOf foaf:member .

<http://contsem.unizar.es/def/sector-publico/pproc#assumptionProtectingProcedureType> a owl:DatatypeProperty ;
    rdfs:label "Assumption protecting the chosen procedure type"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> ;
    rdfs:range xsd:string .

<http://contsem.unizar.es/def/sector-publico/pproc#awardAgreement> a owl:ObjectProperty ;
    rdfs:label "Award agreement"@en ;
    rdfs:comment "Points to the body agreement where a tender has been awarded."@en ;
    rdfs:domain <http://purl.org/procurement/public-contracts#Tender> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractingBodyAgreement> .

<http://contsem.unizar.es/def/sector-publico/pproc#awardDate> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Date of award"@en ;
    rdfs:domain <http://purl.org/procurement/public-contracts#Tender> ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dcterms:date ;
    owl:backwardCompatibleWith <http://purl.org/procurement/public-contracts#awardDate> .

<http://contsem.unizar.es/def/sector-publico/pproc#briefing> a owl:ObjectProperty ;
    rdfs:label "Briefing"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#Briefing> .

<http://contsem.unizar.es/def/sector-publico/pproc#budgetPrice> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contract budget price"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractEconomicConditions> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#BundlePriceSpecification> ;
    rdfs:subPropertyOf <http://contsem.unizar.es/def/sector-publico/pproc#price> .

<http://contsem.unizar.es/def/sector-publico/pproc#committee> a owl:ObjectProperty ;
    rdfs:label "Committee"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractBodies> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#Committee> .

<http://contsem.unizar.es/def/sector-publico/pproc#complementaryContract> a owl:ObjectProperty ;
    rdfs:label "Complementary contract"@en ;
    rdfs:comment "Relates a contract with a complementary contract."@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#Contract> .

<http://contsem.unizar.es/def/sector-publico/pproc#compulsoryMeansForExecution> a owl:DatatypeProperty ;
    rdfs:label "Compulsory means for execution"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#TenderersRequirements> ;
    rdfs:range xsd:string .

<http://contsem.unizar.es/def/sector-publico/pproc#constructionSubsidies> a owl:DatatypeProperty ;
    rdfs:label "Construction subsidies"@en ;
    rdfs:comment "Description of the public subsidies to construction works contracts."@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractEconomicConditions> ;
    rdfs:range xsd:string .

<http://contsem.unizar.es/def/sector-publico/pproc#contractActivites> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contract activities"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractActivities> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractAdditionalObligations> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contract additional obligations"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractAdditionalObligations> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractBodies> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contract bodies"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractBodies> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractEconomicConditions> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contract economic conditions"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractObject> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractEconomicConditions> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractExecutionConditions> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contract execution conditions"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractObject> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractExecutionConditions> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractModification> a owl:ObjectProperty ;
    rdfs:label "Contract modification"@en ;
    rdfs:comment "Points to contract modifications being made."@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractModification> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractModificationConditions> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contract modification conditions"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractObject> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractModificationConditions> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractObject> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Object of the contract"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractObject> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractProcedureSpecifications> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contract procedure specifications"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractResolution> a owl:ObjectProperty ;
    rdfs:label "Contract resolution"@en ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractResolution> ;
    rdfs:subPropertyOf <http://contsem.unizar.es/def/sector-publico/pproc#contractOrProcedureExtinction> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractTemporalConditions> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contract temporal conditions"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractObject> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractTemporalConditions> .

<http://contsem.unizar.es/def/sector-publico/pproc#contractingBody> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Contracting body"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    rdfs:range org:Organization .

<http://contsem.unizar.es/def/sector-publico/pproc#contractingBodyAgreement> a owl:ObjectProperty ;
    rdfs:label "Contracting body agreement"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://contsem.unizar.es/def/sector-publico/pproc#ContractActivities> <http://contsem.unizar.es/def/sector-publico/pproc#ContractModification> <http://contsem.unizar.es/def/sector-publico/pproc#ContractOrProcedureExtinction> <http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> ) ] ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ContractingBodyAgreement> .

<http://contsem.unizar.es/def/sector-publico/pproc#criterion> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Criterion"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#CriterionScore> ;
    rdfs:range <http://purl.org/procurement/public-contracts#AwardCriterion> .

<http://contsem.unizar.es/def/sector-publico/pproc#criterionEvaluationMode> a owl:DatatypeProperty ;
    rdfs:label "Criterion evaluation mode"@en ;
    rdfs:comment "Property textually describing the criterion evaluarion mode."@en ;
    rdfs:domain <http://purl.org/procurement/public-contracts#AwardCriterion> ;
    rdfs:range xsd:string .

<http://contsem.unizar.es/def/sector-publico/pproc#criterionMaxAndMinScores> a owl:DatatypeProperty ;
    rdfs:label "Criterion maximum and minimum score"@en ;
    rdfs:domain <http://purl.org/procurement/public-contracts#AwardCriterion> ;
    rdfs:range xsd:string .

<http://contsem.unizar.es/def/sector-publico/pproc#criterionScore> a owl:ObjectProperty ;
    rdfs:label "Criterion score"@en ;
    rdfs:comment "Property that points to an unique criterion and its score."@en ;
    rdfs:domain <http://purl.org/procurement/public-contracts#Tender> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#CriterionScore> .

<http://contsem.unizar.es/def/sector-publico/pproc#delegatingAuthority> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Delegating authority"@en ;
    rdfs:comment "Points to the authority that is delegating the contract."@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#Contract> ;
    rdfs:range org:Organization .

<http://contsem.unizar.es/def/sector-publico/pproc#durationChange> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Duration change"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractModification> ;
    rdfs:range xsd:string .

<http://contsem.unizar.es/def/sector-publico/pproc#earlyTramitation> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Early tramitation"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> ;
    rdfs:range xsd:boolean .

<http://contsem.unizar.es/def/sector-publico/pproc#electronicAuction> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Electronic auction"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ContractProcedureSpecifications> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ElectronicAuction> .

<http://contsem.unizar.es/def/sector-publico/pproc#electronicAuctionPhase> a owl:ObjectProperty ;
    rdfs:label "Electronic auction phase"@en ;
    rdfs:domain <http://contsem.unizar.es/def/sector-publico/pproc#ElectronicAuction> ;
    rdfs:range <http://contsem.unizar.es/def/sector-publico/pproc#ElectronicAuctionPhase> .

<http://contsem.unizar.es/def/sector-publico/pproc#electronicAuctionWeb> a owl:ObjectProperty ;
    rdfs:label "Electronic auction web"@en ;
    rdfs:comment "Property that indicated where the electronic auction is made or where we can look for more information about the auction."@en ;
