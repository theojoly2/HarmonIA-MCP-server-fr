@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://schema.org/> .
@prefix onto: <http://www.samos.gr/ontologies/helpdeskOnto.owl> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://linkeddata.ihu.edu.gr/id/company/090344143> a owl:NamedIndividual ;
    owl:sameAs <http://www.samos.gr/ontologies/helpdeskOnto.owl#NARA> .

<http://publicspending.medialab.ntua.gr/describe/paymentAgents/090344143> a owl:NamedIndividual ;
    owl:sameAs <http://www.samos.gr/ontologies/helpdeskOnto.owl#NARA> .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#Samos_IT_department_at_NARA> a <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItDepartment>,
        owl:NamedIndividual ;
    rdfs:label "Samos IT department at NARA"@en ;
    rdfs:comment "IT depertment at Samos regional unit of NARA"@en,
        "This individual is defined for demonstration purposes only"@en ;
    org:memberOf <http://www.samos.gr/ontologies/helpdeskOnto.owl#NARA> .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#taskDescription> a owl:DatatypeProperty ;
    rdfs:label "task description"@en ;
    rdfs:comment "a task(ation) description"@en ;
    rdfs:domain <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTask> ;
    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:description,
        <http://purl.org/goodrelations/v1#description> .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#taskId> a owl:DatatypeProperty ;
    rdfs:label "task identification id"@en ;
    rdfs:domain <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTask> ;
    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl" ;
    rdfs:range xsd:int .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#taskTicketId> a owl:DatatypeProperty ;
    rdfs:label "task ticket identification id"@en ;
    rdfs:comment "id number to link task to ticket"@en ;
    rdfs:domain <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTask> ;
    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl" ;
    rdfs:range xsd:int .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#ticketDescription> a owl:DatatypeProperty ;
    rdfs:label "ticket description"@en ;
    rdfs:domain <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTicket> ;
    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:description,
        <http://purl.org/goodrelations/v1#description> .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#ticketId> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ticket id"@en ;
    rdfs:domain <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTicket> ;
    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl" ;
    rdfs:range xsd:int .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#ticketSolution> a owl:DatatypeProperty ;
    rdfs:label "ticket solution"@en ;
    rdfs:domain <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTicket> ;
    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl" ;
    rdfs:range xsd:string .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#ticketTitle> a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "ticket title"@en ;
    rdfs:domain <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTicket> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:title .

<http://purl.org/goodrelations/v1#ProductOrService> a owl:Class .

dc:description a owl:DatatypeProperty .

<http://purl.org/goodrelations/v1#description> a owl:DatatypeProperty .

onto: a owl:Ontology ;
    rdfs:label "helpdeskOnto.owl"@en ;
    dc:creator "K. Kotis"@en ;
    dc:title "HelpDesk support Ontology"@en ;
    dcterms:contributor "Christopher Gutteridge, University of Southampton Open Data Service"@en,
        "Nikolaos Loutas, PwC Principal Advisor"@en ;
    dcterms:created "2013-04-10"^^xsd:date ;
    dcterms:description "Simple ontology developed for integration purposes. Describe helpdesk entities used to record support tickets for diagnosis and resolve purpuses. The ontology re-uses a) W3C ORG and REGORG ontologies, b) DUL upper ontology, and c) GoodRelations ontology."@en ;
    dcterms:modified "2013-04-25"^^xsd:date ;
    vann:preferredNamespacePrefix "hdo"@en ;
    ns1:affiliation "Samos Regional Unit, North Aegean Region Admin. Authority and Department of Digital Systems, University of Piraeus. Greece. +30 6974822712, http://gr.linkedin.com/in/kotis"@en ;
    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl" ;
    owl:imports <http://purl.org/goodrelations/v1>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl>,
        org:,
        <http://www.w3.org/ns/regorg#> ;
    owl:priorVersion "0.1"@en ;
    owl:versionInfo "0.2"@en ;
    foaf:homepage "http://www.samos.gr/ontologies/helpdeskOnto.html"^^xsd:anyURI .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#ItDepartment> a owl:Class ;
    rdfs:label "Information Technology (IT) department"@en ;
    rdfs:comment "A department in the organization that is responsible for the Information Technology (IT) of the organization."@en ;
    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl" ;
    rdfs:subClassOf org:OrganizationalUnit,
        <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#NARA> a owl:NamedIndividual,
        org:FormalOrganization,
        <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    rdfs:label "North Aegean Regional Administration (NARA)"@en ;
    rdfs:comment "This individual is defined for demonstration purposes only and is linked to existing definitions in other LOGD sets "@en .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTask> a owl:Class ;
    rdfs:label "IT support task"@en ;
    rdfs:comment "A task is an action associated with tickets during an effort to solve an issue/problem in IT."@en ;
    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
            owl:someValuesFrom <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTicket> ],
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Task> .

<http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTicket> a owl:Class ;
    rdfs:label "IT support Ticket"@en ;
    rdfs:comment "Helpdesk support ticket to record some issue with IT to be diagnosed and resolved."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
            owl:someValuesFrom <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItSupportTask> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
            owl:someValuesFrom <http://purl.org/goodrelations/v1#ProductOrService> ],
        [ a owl:Restriction ;
            owl:onProperty prov:wasGeneratedBy ;
            owl:someValuesFrom <http://www.samos.gr/ontologies/helpdeskOnto.owl#ItDepartment> ],
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Diagnosis> .

