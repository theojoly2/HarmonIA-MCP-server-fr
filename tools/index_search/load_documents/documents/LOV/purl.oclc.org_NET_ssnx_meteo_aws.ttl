@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://purl.oclc.org/NET/ssnx/meteo/aws> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://creativecommons.org/ns#license> a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dc:creator "Laurent Lefort (CSIRO, Australia and W3C Semantic Sensor Network Incubator Group)"^^xsd:string ;
    dc:description "Meteorological sensor ontology (sensor types)" ;
    dc:identifier "http://purl.oclc.org/NET/ssnx/meteo/aws" ;
    dc:rights "Copyright 2010 - 2011 CSIRO. All rights reserved." ;
    dc:title "Ontology for Meteorological sensors" ;
    dcterms:created "2010-09-21" ;
    dcterms:modified "2011-06-20" ;
    rdfs:comment "Please report any errors to the Semantic Sensor Network Incubator Activity via the public W3C list public-xg-ssn@w3.org"^^xsd:string,
        "This ontology is is part of the Agriculture Meteorology example showcasing the ontology developed by the W3C Semantic Sensor Networks incubator group (SSN-XG). It is published here in order to generalize the potential usage and the alignment with other standardization efforts of the SSN ontology.\\n\\nFor more information on the group's activities see: http://www.w3.org/2005/Incubator/ssn/ .\\n\\nDISCLAIMER: This ontology includes information that has been automatically generated from data sourced from third parties but has not been fully manually checked. It is provided AS-IS, for information only, with no warranties or guarantees and confers no rights."^^xsd:string ;
    rdfs:seeAlso "http://www.w3.org/2005/Incubator/ssn/" ;
    owl:imports <http://purl.oclc.org/NET/ssnx/cf/cf-feature>,
        <http://purl.oclc.org/NET/ssnx/cf/cf-property>,
        <http://purl.oclc.org/NET/ssnx/qu/qu>,
        <http://purl.oclc.org/NET/ssnx/qu/qu-rec20>,
        <http://purl.oclc.org/NET/ssnx/ssn> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#Albedometer> a owl:Class ;
    rdfs:label "albedometer" ;
    dc:source "skos:closeMatch albedometer [GAMP 2.3.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html" ;
    rdfs:comment "pair of upward and downward facing solarimeters" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#RadiationSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#AtmometerOrSmallSurfaceEvaporimeter> a owl:Class ;
    rdfs:label "Atmometer or small surface evaporimeter" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/meteo/aws#ScreenedAndOpenPanEvaporimeter> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#AutomaticSunshineRecorder> a owl:Class ;
    rdfs:label "Automatic sunshine recorder" ;
    dc:source "skos:closeMatch Automatic sunshine recorder [GAMP 2.4.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html" ;
    rdfs:comment "time during which direct radiation (on a plane perpendicular to the Sun’s beam) is larger than 120 Wm-2." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#RadiationSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#BimetallicActinograph> a owl:Class ;
    rdfs:label "Bimetallic actinograph" ;
    rdfs:comment "total solar irradiance on a horizontal surface" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/meteo/aws#Pyranometer> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#CampbellStokesSunshineMeter> a owl:Class ;
    rdfs:label "Campbell-Stokes sunshine meter" ;
    dc:source "skos:closeMatch Campbell-Stokes sunshine meter [GAMP 2.4.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html" ;
    rdfs:comment "World standard abolished in 1989" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#RadiationSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#CapacitiveAluminumOxide> a owl:Class ;
    rdfs:label "Capacitive - aluminum oxide" ;
    rdfs:comment "certain materials interact with water vapour and undergo a change in capacitance, in relation to ambient humidity." ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/meteo/aws#CapacitanceSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#CapacitiveAneroid> a owl:Class ;
    rdfs:label "Capacitive aneroid" ;
    rdfs:comment "The aneroid displacement transducer contains a sensor with electrical properties (resistance or capacitance) that changes as the atmospheric pressure changes." ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/meteo/aws#AneroidDisplacementTransducer> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#CapacitiveBead> a owl:Class ;
    rdfs:label "Capacitive bead" ;
    dc:source "skos:closeMatch Capacitive bead [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#TemperatureSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#CapacitiveThinFilmPolymer> a owl:Class ;
    rdfs:label "Capacitive - thin film polymer" ;
    rdfs:comment "certain materials interact with water vapour and undergo a change in capacitance, in relation to ambient humidity." ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/meteo/aws#CapacitanceSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#ChilledMirrorHygrometer> a owl:Class ;
    rdfs:label "chilled-mirror hygrometer" ;
    dc:source "chilled-mirror hygrometer [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf" ;
    rdfs:comment "condensation is detected on the surface of a small polished metal reflecting surface (a mirror), using optical means. The temperature at which condensation is formed is the dew point." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#HumiditySensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#ChilledMirrorSystem> a owl:Class ;
    rdfs:label "Chilled mirror system" ;
    dc:source "skos:closeMatch Chilled mirror system [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#TemperatureSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#CupAnemometer> a owl:Class ;
    rdfs:label "Cup anemometer" ;
    dc:source "skos:closeMatch Cup anemometer [GAMP 2.4.1.5] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html" ;
    rdfs:comment "the angular velocity of the cup is directly proportional to the component of the wind speed parallel to the axis of rotation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#WindSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#CylindricalResonatorBarometer> a owl:Class ;
    rdfs:label "cylindrical resonator barometer" ;
    dc:source "skos:closeMatch cylindrical resonator barometer [CIMO Guide 3.3.1] http://www.wmo.int/pages/prog/www/IMOP/publications/CIMO-Guide/CIMO%20Guide%207th%20Edition,%202008/Part%20I/Chapter%203.pdf" ;
    rdfs:comment "A cylindrical resonator barometer (or vibrating cylinder air-pressure transducer) is designed to measure absolute air pressure using the vibrating element principle, providing a frequency output from which pressure is computed." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#AtmosphericPressureSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#DewCell> a owl:Class ;
    rdfs:label "dew cell" ;
    dc:source "dew cell [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf" ;
    rdfs:comment "A dew cell heats a salt solution until its equilibrium vapour pressure equals to the ambient vapour pressure, and maintains this equilibrium The temperature when this occurs is measured and it provides a measure of the ambient vapour pressure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#HumiditySensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#DewcelSystem> a owl:Class ;
    rdfs:label "Dewcel system" ;
    dc:source "skos:closeMatch Dewcel system [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#TemperatureSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#DifferentialExpansionThermometer> a owl:Class ;
    rdfs:label "differential expansion thermometer" ;
    dc:source "skos:closeMatch Differential expansion thermometer [GAMP 2.4.1.2] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#TemperatureSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#DigitalPiezoResistiveBarometer> a owl:Class ;
    rdfs:label "digital piezo-resistive barometer" ;
    dc:source "skos:closeMatch digital piezo-resistive barometer [CIMO Guide 3.3.1] http://www.wmo.int/pages/prog/www/IMOP/publications/CIMO-Guide/CIMO%20Guide%207th%20Edition,%202008/Part%20I/Chapter%203.pdf" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#AtmosphericPressureSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#DirmhirmSaubererPyranometer> a owl:Class ;
    rdfs:label "Dirmhirm-Sauberer pyranometer" ;
    rdfs:comment "total solar irradiance on a horizontal surface" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/meteo/aws#Pyranometer> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#DropCounters> a owl:Class ;
    rdfs:label "Drop counters" ;
    dc:source "skos:closeMatch Drop counters [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf" ;
    rdfs:comment "Counting the number of uniform droplets corresponding to a fixed volume of water" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#MassPerTimePerArea> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Distance> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Distance> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#MassPerTimePerArea> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#PrecipitationSensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#ElectricSensorWhichExploitsTheConductivityVariationAsAFunctionOfWetness> a owl:Class ;
    rdfs:label "electric sensor, which exploits the conductivity variation as a function of wetness" ;
    dc:source "skos:closeMatch electric sensor, which exploits the conductivity variation as a function of wetness [GAMP 2.4.1.6.3] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#HumiditySensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#ElectricalResistanceHumiditySensor> a owl:Class ;
    rdfs:label "electrical resistance humidity sensor" ;
    dc:source "skos:closeMatch electrical resistance humidity sensor [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf" ;
    rdfs:comment "certain materials interact with water vapour and undergo a change in electrical resistance, in relation to ambient humidity." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ],
        <http://purl.oclc.org/NET/ssnx/meteo/aws#HumiditySensor> .

<http://purl.oclc.org/NET/ssnx/meteo/aws#ElectricalResistanceThermometer> a owl:Class ;
    rdfs:label "Electrical resistance thermometer" ;
    dc:source "skos:closeMatch Resistance thermometer [GAMP 2.4.1.2] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html" ;
    rdfs:comment "For small temperature changes, the increase in resistance of pure metals is proportional to the change in temperature. Often made in Platinum." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#observes> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ],
