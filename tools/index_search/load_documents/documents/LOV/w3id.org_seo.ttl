@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/11/swrl#> .
@prefix ns2: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:Box a rdfs:Datatype .

dcterms:FileFormat a owl:Class ;
    rdfs:subClassOf dcterms:MediaType .

dcterms:ISO3166 a rdfs:Datatype .

dcterms:ISO639-2 a rdfs:Datatype .

dcterms:ISO639-3 a rdfs:Datatype .

dcterms:Jurisdiction a owl:Class .

dcterms:Period a rdfs:Datatype .

dcterms:Point a rdfs:Datatype .

dcterms:RFC1766 a rdfs:Datatype .

dcterms:RFC3066 a rdfs:Datatype .

dcterms:RFC4646 a rdfs:Datatype .

dcterms:RFC5646 a rdfs:Datatype .

dcterms:URI a rdfs:Datatype .

dcterms:W3CDTF a rdfs:Datatype .

dcterms:abstract a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:subPropertyOf dc:description,
        dcterms:description .

dcterms:accessRights a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:RightsStatement ;
    rdfs:subPropertyOf dc:rights,
        dcterms:rights .

dcterms:accrualMethod a owl:ObjectProperty ;
    rdfs:domain dcmitype:Collection .

dcterms:accrualPeriodicity a owl:ObjectProperty ;
    rdfs:domain dcmitype:Collection .

dcterms:accrualPolicy a owl:ObjectProperty ;
    rdfs:domain dcmitype:Collection .

dcterms:alternative a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:title,
        dcterms:title .

dcterms:available a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        dcterms:date .

dcterms:bibliographicCitation a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain dcterms:BibliographicResource ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier,
        dcterms:identifier .

dcterms:conformsTo a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:Standard ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:created a owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        dcterms:date .

dcterms:creator a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:Agent ;
    rdfs:subPropertyOf dc:creator,
        dcterms:contributor .

dcterms:dateAccepted a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        dcterms:date .

dcterms:dateCopyrighted a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        dcterms:date .

dcterms:dateSubmitted a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        dcterms:date .

dcterms:educationLevel a owl:ObjectProperty ;
    rdfs:range dcterms:AgentClass ;
    rdfs:subPropertyOf dcterms:audience .

dcterms:extent a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:SizeOrDuration ;
    rdfs:subPropertyOf dc:format,
        dcterms:format .

dcterms:hasFormat a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:hasPart a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:hasVersion a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:instructionalMethod a owl:ObjectProperty .

dcterms:isFormatOf a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:isReferencedBy a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:isReplacedBy a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:isRequiredBy a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:isVersionOf a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:issued a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        dcterms:date .

dcterms:language a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:LinguisticSystem ;
    rdfs:subPropertyOf dc:language .

dcterms:license a owl:ObjectProperty ;
    rdfs:range dcterms:LicenseDocument ;
    rdfs:subPropertyOf dc:rights,
        dcterms:rights .

dcterms:mediator a owl:ObjectProperty ;
    rdfs:range dcterms:AgentClass ;
    rdfs:subPropertyOf dcterms:audience .

dcterms:medium a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:PhysicalMedium ;
    rdfs:subPropertyOf dc:format,
        dcterms:format .

dcterms:modified a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        dcterms:date .

dcterms:provenance a owl:ObjectProperty .

dcterms:publisher a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:Agent ;
    rdfs:subPropertyOf dc:publisher .

dcterms:references a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:replaces a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:requires a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation,
        dcterms:relation .

dcterms:rightsHolder a owl:ObjectProperty ;
    rdfs:range dcterms:Agent .

dcterms:source a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:source,
        dcterms:relation .

dcterms:spatial a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:Location ;
    rdfs:subPropertyOf dc:coverage,
        dcterms:coverage .

dcterms:subject a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:subject .

dcterms:tableOfContents a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:subPropertyOf dc:description,
        dcterms:description .

dcterms:temporal a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:PeriodOfTime ;
    rdfs:subPropertyOf dc:coverage,
        dcterms:coverage .

dcterms:type a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range rdfs:Class ;
    rdfs:subPropertyOf dc:type .

dcterms:valid a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        dcterms:date .

<http://purl.org/semsur/belongsToProceedings> a owl:ObjectProperty ;
    rdfs:domain <http://swrc.ontoware.org/ontology#Publication> ;
    rdfs:range <http://swrc.ontoware.org/ontology#Proceedings> .

<http://purl.org/semsur/hasAppendix> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:allValuesFrom <http://swrc.ontoware.org/ontology#Publication> ;
            owl:onProperty <http://swrc.ontoware.org/ontology#cite> ],
        <http://swrc.ontoware.org/ontology#Publication> ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/spar/doco/Section> <http://www.essepuntato.it/2008/12/pattern#HeadedContainer> ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Block> <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Field> <http://www.essepuntato.it/2008/12/pattern#Meta> ) ] ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#contains> ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:isPartOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/spar/doco/BackMatter> <http://purl.org/spar/doco/FrontMatter> ) ] ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/spar/deo/DiscourseElement> <http://www.essepuntato.it/2008/12/pattern#HeadedContainer> ) ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> [ a owl:Restriction ;
                        owl:allValuesFrom <http://www.essepuntato.it/2008/12/pattern#Block> ;
                        owl:onProperty <http://www.essepuntato.it/2008/12/pattern#containsAsHeader> ] ) ],
        [ a owl:Class ;
            owl:complementOf <http://www.essepuntato.it/2008/12/pattern#Textual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.essepuntato.it/2008/12/pattern#Block> ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#containsAsHeader> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://www.essepuntato.it/2008/12/pattern#Bucket> [ a owl:Restriction ;
                                owl:allValuesFrom [ a owl:Class ;
                                        owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Popup> ) ] ;
                                owl:onProperty <http://www.essepuntato.it/2008/12/pattern#isContainedBy> ] ) ] ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#isContainedBy> ],
        [ a owl:Class ;
            owl:unionOf ( <http://purl.org/spar/doco/Paragraph> <http://purl.org/spar/doco/Section> ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:intersectionOf ( <http://purl.org/spar/doco/Section> <http://www.essepuntato.it/2008/12/pattern#HeadedContainer> ) ] [ a owl:Restriction ;
                        owl:onProperty dcterms:isPartOf ;
                        owl:someValuesFrom <http://purl.org/spar/doco/BackMatter> ] ) ],
        [ a owl:Class ;
            owl:unionOf ( <http://purl.org/spar/doco/Chapter> <http://purl.org/spar/doco/Section> ) ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#contains> ;
            owl:someValuesFrom <http://org.semanticweb.owlapi/error#Error3> ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#HeadedContainer> <http://www.essepuntato.it/2008/12/pattern#Table> ) ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Block> <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Field> <http://www.essepuntato.it/2008/12/pattern#Meta> ) ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://www.essepuntato.it/2008/12/pattern#Bucket> [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Popup> ) ] ;
                        owl:onProperty <http://www.essepuntato.it/2008/12/pattern#isContainedBy> ] ) ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:isPartOf ;
            owl:someValuesFrom <http://purl.org/spar/doco/BackMatter> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#contains> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:complementOf <http://purl.org/spar/doco/Chapter> ] ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Block> <http://www.essepuntato.it/2008/12/pattern#Container> ) ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#contains> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/spar/doco/Paragraph> <http://purl.org/spar/doco/Section> ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Popup> ) ] ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#isContainedBy> ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Popup> ) ],
        <http://org.semanticweb.owlapi/error#Error2>,
        <http://purl.org/spar/deo/DiscourseElement>,
        <http://purl.org/spar/doco/Appendix>,
        <http://purl.org/spar/doco/Section>,
        <http://www.essepuntato.it/2008/12/pattern#Bucket>,
        <http://www.essepuntato.it/2008/12/pattern#Container>,
        <http://www.essepuntato.it/2008/12/pattern#HeadedContainer>,
        <http://www.essepuntato.it/2008/12/pattern#NonTextual>,
        <http://www.essepuntato.it/2008/12/pattern#Pattern>,
        <http://www.essepuntato.it/2008/12/pattern#Structured> .

<http://purl.org/spar/doco/Abstract> a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( <http://purl.org/spar/doco/Chapter> <http://purl.org/spar/doco/Section> ) ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:isPartOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/spar/doco/BodyMatter> <http://purl.org/spar/doco/FrontMatter> ) ] ],
        <http://salt.semanticauthoring.org/ontologies/sro#Abstract> .

<http://purl.org/spar/fabio/ConferencePaper> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Manifestation> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#embodiment> ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#part> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ] ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Work> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#realizationOf> ],
        <http://purl.org/spar/fabio/Expression> .

<http://purl.org/spar/fabio/ConferencePoster> a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#part> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ] ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Work> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#realizationOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Manifestation> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#embodiment> ] .

<http://purl.org/spar/fabio/ConferenceProceedings> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
            owl:someValuesFrom <http://purl.org/spar/fabio/Expression> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Manifestation> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#embodiment> ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#part> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Expression> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ] ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Work> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#realizationOf> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
            owl:someValuesFrom <http://purl.org/spar/fabio/ProceedingsPaper> ],
        <http://purl.org/spar/fabio/Expression>,
        <http://purl.org/spar/fabio/ExpressionCollection> .

<http://purl.org/spar/fabio/WorkingPaper> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://purl.org/spar/fabio/Expression> ;
            owl:onProperty <http://purl.org/vocab/frbr/core#realization> ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Work> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#part> ] [ a owl:Restriction ;
                        owl:allValuesFrom <http://purl.org/vocab/frbr/core#Work> ;
                        owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ] ) ] .

<http://swrc.ontoware.org/ontology#keywords> a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Restriction ;
            owl:allValuesFrom <http://swrc.ontoware.org/ontology#Publication> ;
            owl:onProperty <http://swrc.ontoware.org/ontology#cite> ],
        <http://swrc.ontoware.org/ontology#Publication> ;
    rdfs:range xsd:string .

ns2:isRuleEnabled a owl:AnnotationProperty .

skos:note a owl:AnnotationProperty .

time:hasDuration a owl:AnnotationProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> .

time:hasTemporalDuration a owl:AnnotationProperty .

<https://w3id.org/scholarlydata/ontology/conference-ontology.owl#hasAddress> rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Agent> .

<https://w3id.org/scholarlydata/ontology/conference-ontology.owl#hasProceedings> a owl:AnnotationProperty .

<https://w3id.org/seo#> a owl:Ontology ;
    rdfs:label "Scientific Events Ontology"@en ;
    dc:creator "Christoph Lange",
        "Said Fathalla" ;
    dcterms:created "2018-02-01"@en ;
    dcterms:creator "Sahar Vahdati",
        "Soeren Auer" ;
    dcterms:description "SEO is a reference ontology for modelling data about scientific events such as conferences, symposioums and workshops."@en ;
    dcterms:lastModified "2019-04-10"@en ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:title "SEO, The Scientific Events Ontology."@en ;
    vann:preferredNamespacePrefix "seo" ;
    vann:preferredNamespaceUri "http://purl.org/seo/"^^dcterms:URI ;
    rdfs:seeAlso "See also documentation at http://kddste.sda.tech/SEOontology/Documentation/SEO.html"@en ;
    owl:imports <http://dbpedia.org/ontology/>,
        foaf:,
        <https://w3id.org/scholarlydata/ontology/conference-ontology.owl> ;
    owl:versionInfo 1.1 .

<https://w3id.org/seo#/> a owl:NamedIndividual .

<https://w3id.org/seo#ArtificialIntelligence> a owl:NamedIndividual,
        <https://w3id.org/seo#ResearchField> .

<https://w3id.org/seo#BestApplicationsPaperAward> a owl:Class ;
    rdfs:label "Best applications paper award"@en ;
    rdfs:comment "This award for the best application paper presented. "@en ;
    rdfs:subClassOf <https://w3id.org/seo#BestPaperAward> .

<https://w3id.org/seo#BestPosterAward> a owl:Class ;
    rdfs:label "Best poster award"@en ;
    rdfs:comment "This award highlight good quality posters presented."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Award> .

<https://w3id.org/seo#BestStudentPaperAward> a owl:Class ;
    rdfs:label "Best student paper award"@en ;
    rdfs:comment "This award recognizes the best paper authored primarily by a student and presented by the student."@en ;
    rdfs:subClassOf <https://w3id.org/seo#BestPaperAward> .

<https://w3id.org/seo#BronzeSponsorship> a owl:Class ;
    rdfs:label "Bronze sponsorship"@en ;
    rdfs:comment "A Sponsorship Package."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Sponsorship> .

<https://w3id.org/seo#ChallengeTrack> a owl:Class ;
    rdfs:label "Challenge track"@en ;
    rdfs:comment "The idea of the challenge track is to provide participants with a set of case studies and challenge the state of the art."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> .

<https://w3id.org/seo#ComputerSystemsOrganization> a owl:NamedIndividual,
        <https://w3id.org/seo#ResearchField> .

<https://w3id.org/seo#DemoChair> a owl:Class ;
    rdfs:label "Demo chair"@en ;
    rdfs:comment "A person responsible for assembling the system demonstration papers to be presented in the main conference program. "@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#DemosTrack> a owl:Class ;
    rdfs:label "Demos track"@en ;
    rdfs:comment "Offer an opportunity for presenting late-breaking research results, on-going research projects, and speculative or innovative work in progress."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> .

<https://w3id.org/seo#DoctoralConsortium> a owl:Class ;
    rdfs:label "Doctoral consortium"@en ;
    rdfs:comment "Provide PhD students an opportunity to share and develop their research ideas in a critical but supportive environment."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> .

<https://w3id.org/seo#DoctoralConsortiumChair> a owl:Class ;
    rdfs:label "Doctoral consortium chair"@en ;
    rdfs:comment "The event member who leads the doctoral consortium."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#EventReception> a owl:Class ;
    rdfs:label "Event reception"@en ;
    rdfs:comment "The reception event within a scientific event ."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#SocialEvent> .

<https://w3id.org/seo#GeneralChair> a owl:Class ;
    rdfs:label "General chair"@en ;
    rdfs:comment "A person responsible for overseeing and coordinating the whole conference. ."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#GetTogetherEvent> a owl:Class ;
    rdfs:label "Get together event"@en ;
    rdfs:comment "Socially gather two or more people in one event ."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#SocialEvent> .

<https://w3id.org/seo#GoldSponsorship> a owl:Class ;
    rdfs:label "Gold sponsorship"@en ;
    rdfs:comment "Sponsorship Package."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Sponsorship> .

<https://w3id.org/seo#HonorChair> a owl:Class ;
    rdfs:label "Honor chair"@en ;
    rdfs:comment "Chair of the conference ."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#HumanCenteredComputing> a owl:NamedIndividual,
        <https://w3id.org/seo#ResearchField> .

<https://w3id.org/seo#In-useTrack> a owl:Class ;
    rdfs:label "In-use track"@en ;
    rdfs:comment "In-Use track provides researchers to discuss novel research taken to the market."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> .

<https://w3id.org/seo#IndustrialConference> a owl:Class ;
    rdfs:label "Industrial conference"@en ;
    rdfs:comment "A business conference is held for people working in the same company or industry."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#NonAcademicEvent> .

<https://w3id.org/seo#IndustryTrack> a owl:Class ;
    rdfs:label "Industry track"@en ;
    rdfs:comment "The industry track seeks to present research contributions in industrial settings."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> .

<https://w3id.org/seo#InformationSystems> a owl:NamedIndividual,
        <https://w3id.org/seo#ResearchField> .

<https://w3id.org/seo#KeynoteSpeaker> a owl:Class ;
    rdfs:label "Keynote speaker"@en ;
    rdfs:comment "Someone who gives the main address at a formal gathering such as a conference ."@en ;
    rdfs:subClassOf <https://w3id.org/seo#InvitedSpeakers> .

<https://w3id.org/seo#LocalOrganisationChair> a owl:Class ;
    rdfs:label "Local organisation chair"@en ;
    rdfs:comment "The chair of the local organizers of the event. "@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#OnSiteRegistration> a owl:Class ;
    rdfs:label "On site registration"@en ;
    rdfs:comment "Process of signing up for an event on the day of, or at the site of, the event."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Registration> .

<https://w3id.org/seo#PHDSymposium> a owl:Class ;
    rdfs:label "PHD symposium"@en ;
    rdfs:comment "Event for PHD student to present and receive feedback on their ongoing work."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Symposium> .

<https://w3id.org/seo#PastEvents> a owl:Class ;
    rdfs:label "Past events"@en ;
    rdfs:comment "Events happened or existed before the present time. "@en .

<https://w3id.org/seo#PlatinumSponsorship> a owl:Class ;
    rdfs:label "Platinum sponsorship"@en ;
    rdfs:comment "Sponsorship Package."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Sponsorship> .

<https://w3id.org/seo#PosterChair> a owl:Class ;
    rdfs:label "Poster chair"@en ;
    rdfs:comment "The poster chair is responsible for recruiting and selecting poster fair organizers for the fairs that fall under the shared interest category."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#PostersTrack> a owl:Class ;
    rdfs:label "Posters track"@en ;
    rdfs:comment "Present research contributions as posters."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> .

<https://w3id.org/seo#ProgramChair> a owl:Class ;
    rdfs:label "Program chair"@en ;
    rdfs:comment "The Program Chair is responsible for working to develop the annual program budget, manage chapter-programming delivery, monitor program quality, manage member satisfaction with programs, and manage all speaker communications. "@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#ProgramCommitteeMember> a owl:Class ;
    rdfs:label "Program committee member"@en ;
    rdfs:comment "The program committee is responsible for objectively and thoroughly reviewing all submissions, for submitting timely, informative reviews that provide authors with feedback about their submissions, and for attending the program committee meetings."@en ;
    rdfs:subClassOf foaf:Person .

<https://w3id.org/seo#ProgramSchedule> a owl:Class ;
    rdfs:label "Program schedule"@en ;
    rdfs:comment "A plan for carrying out a process or procedure, giving lists of intended events and times."@en .

<https://w3id.org/seo#RegularRegistration> a owl:Class ;
    rdfs:label "Regular registration"@en ;
    rdfs:comment "Normal registration"@en ;
    rdfs:subClassOf <https://w3id.org/seo#AuthorRegistration> ;
    owl:disjointWith <https://w3id.org/seo#StudentRegistration> .

<https://w3id.org/seo#ResearchTrack> a owl:Class ;
    rdfs:label "Research track"@en ;
    rdfs:comment "The track for fundamental research, innovative technology, and applications concerning the research topic of the event."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> .

<https://w3id.org/seo#ResourceTrack> a owl:Class ;
    rdfs:label "Resource track"@en ;
    rdfs:comment "The Resources Track aims to promote the sharing of resources including: datasets, ontologies, vocabularies, ... etc"@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> .

<https://w3id.org/seo#Reviewer> a owl:Class ;
    rdfs:label "Reviewer"@en ;
    rdfs:comment "A person who reviews the submissions and give feedback about the submitted articles."@en ;
    rdfs:subClassOf foaf:Person .

<https://w3id.org/seo#SecurityAndPrivacy> a owl:NamedIndividual,
        <https://w3id.org/seo#ResearchField> .

<https://w3id.org/seo#SilverSponsorship> a owl:Class ;
    rdfs:label "Silver sponsorship"@en ;
    rdfs:comment "Sponsorship Package."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Sponsorship> .

<https://w3id.org/seo#SoftwareEngineering> a owl:NamedIndividual,
        <https://w3id.org/seo#ResearchField> .

<https://w3id.org/seo#SponsorshipChair> a owl:Class ;
    rdfs:label "Sponsorship chair"@en ;
    rdfs:comment "A person responsible for collecting funding from two kinds of sources: granting institutions and corporations. "@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#Student> a owl:Class ;
    rdfs:label "Student"@en ;
    rdfs:comment "A person enrolled in a school or other educational institution."@en ;
    rdfs:subClassOf foaf:Person .

<https://w3id.org/seo#SymposiumSeries> a owl:Class ;
    rdfs:label "Symposiums series"@en ;
    rdfs:comment "A series of symposiums."@en ;
    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#EventSeries> .

<https://w3id.org/seo#TheoryOfComputations> a owl:NamedIndividual,
        <https://w3id.org/seo#ResearchField> .

<https://w3id.org/seo#TutorialChair> a owl:Class ;
    rdfs:label "Tutorial chair"@en ;
    rdfs:comment "A person responsible for requesting tutorial proposals and making final selections."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#WorkshopChair> a owl:Class ;
    rdfs:label "Workshop chair"@en ;
    rdfs:comment "The one responsible for collaborating with the workshop chairs for other ACL-affiliated conferences in the given year, in preparing and circulating the Call for Proposals, and in reviewing submissions."@en ;
    rdfs:subClassOf <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#WorldWideWeb> a owl:NamedIndividual,
        <https://w3id.org/seo#ResearchField> .

<https://w3id.org/seo#abstractDeadline> a owl:DatatypeProperty ;
    rdfs:comment "The deadline of abstract submission."^^xsd:string ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range xsd:date .

<https://w3id.org/seo#acceptanceRate> a owl:DatatypeProperty ;
    rdfs:comment "The acceptance rate of the event in a particular year."@en ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range xsd:decimal .

<https://w3id.org/seo#acceptedPapers> a owl:DatatypeProperty ;
    rdfs:comment "The number of accepted papers in the event."@en ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range xsd:unsignedInt .

<https://w3id.org/seo#belongsToSeries> a owl:ObjectProperty ;
    rdfs:label "belongsToSeries"@en ;
    rdfs:comment "This property shows the series which an event belongs to."@en ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#EventSeries> ;
    owl:inverseOf <https://w3id.org/seo#hasEvent> .

<https://w3id.org/seo#eventWebsite> a owl:DatatypeProperty ;
    rdfs:comment "The webpage of the event."@en ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range xsd:anyURI .

<https://w3id.org/seo#hasAffiliation> a owl:ObjectProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Organization .

<https://w3id.org/seo#hasChair> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> ;
    rdfs:range <https://w3id.org/seo#Chair> .

<https://w3id.org/seo#hasFlyer> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range <https://w3id.org/seo#Flyer> .

<https://w3id.org/seo#hasImportantDates> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range <https://w3id.org/seo#ImportantDates> .

<https://w3id.org/seo#hasKeynote> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range <https://w3id.org/seo#Keynote> ;
    owl:inverseOf <https://w3id.org/seo#keynoteIn> .

<https://w3id.org/seo#hasProgramCommitteeMember> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Person> .

<https://w3id.org/seo#hasProgramSchedual> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> .

<https://w3id.org/seo#hasPublisher> a owl:ObjectProperty ;
    rdfs:comment "This propoerty shows the publisher of a proceedings."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Proceedings> ) ] ;
    rdfs:range <https://w3id.org/seo#Publisher> ;
    owl:inverseOf <https://w3id.org/seo#isPublisherOf> .

<https://w3id.org/seo#hasRegistration> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range <https://w3id.org/seo#Registration> .

<https://w3id.org/seo#hasRegistrationType> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/seo#Author> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/seo#EarlyBirdRegistration> <https://w3id.org/seo#LateRegistration> ) ] .

<https://w3id.org/seo#hasSocialEvent> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#SocialEvent> .

<https://w3id.org/seo#hasSponsor> a owl:ObjectProperty ;
    rdfs:comment "This propoerty shows the sponsor of an event."^^xsd:string ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range <https://w3id.org/seo#Sponsor> ;
    owl:inverseOf <https://w3id.org/seo#isSponsorOf> .

<https://w3id.org/seo#hasSubmissionGuidelines> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range <https://w3id.org/seo#SubmissionGuidelines> .

<https://w3id.org/seo#hasTrack> a owl:ObjectProperty ;
    rdfs:comment "This propoerty shows the available tracks of an event."^^xsd:string ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> ;
    owl:inverseOf <https://w3id.org/seo#isTrackOf> .

<https://w3id.org/seo#hasTwitter> a owl:DatatypeProperty ;
    rdfs:comment "The twitter account of the event."^^xsd:string ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#EventSeries> ;
    rdfs:range xsd:anyURI .

<https://w3id.org/seo#heldInCity> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range <http://dbpedia.org/ontology/City> ;
    rdfs:subPropertyOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#hasLocation> .

<https://w3id.org/seo#heldInCountry> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range <http://dbpedia.org/ontology/Country> ;
    rdfs:subPropertyOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#hasLocation> .

<https://w3id.org/seo#notificationDate> a owl:DatatypeProperty ;
    rdfs:label "Paper Acceptance Notification" ;
    rdfs:comment "The date of the paper acceptance notification." ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range xsd:date .

<https://w3id.org/seo#offersBestPaperAward> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range <https://w3id.org/seo#BestPaperAward> ;
    rdfs:subPropertyOf <https://w3id.org/seo#offersAward> .

<https://w3id.org/seo#participatesAs> a owl:ObjectProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/seo#Author> <https://w3id.org/seo#Chair> <https://w3id.org/seo#Organizer> ) ] .

<https://w3id.org/seo#providesTravelInformation> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range <https://w3id.org/seo#TravelInformation> .

<https://w3id.org/seo#registeredAs> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/seo#Author> ;
    rdfs:range <https://w3id.org/seo#AuthorRegistration> .

<https://w3id.org/seo#sponsorshipType> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/seo#Sponsor> ;
    rdfs:range <https://w3id.org/seo#Sponsorship> .

<https://w3id.org/seo#submissionDeadline> a owl:DatatypeProperty ;
    rdfs:comment "The deadline of paper submission."^^xsd:string ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range xsd:date .

<https://w3id.org/seo#submissionWebPage> a owl:DatatypeProperty ;
    rdfs:comment "The webpage of the submission to event."^^xsd:string ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range xsd:anyURI .

<https://w3id.org/seo#submittedPapers> a owl:DatatypeProperty ;
    rdfs:comment "The number of submitted papers to the event."@en ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> ;
    rdfs:range xsd:unsignedInt .

<https://w3id.org/seo#takesAward> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/seo#Author> ;
    rdfs:range <https://w3id.org/seo#Award> .

<http://creativecommons.org/licenses/by/3.0/> a owl:NamedIndividual .

<http://dbpedia.org/ontology/City> owl:equivalentClass <http://schema.org/City> .

<http://dbpedia.org/ontology/Country> owl:equivalentClass <http://schema.org/Country> .

<http://purl.org/dc/aboutdcmi#DCMI> a owl:NamedIndividual .

dc:contributor a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:source a owl:AnnotationProperty .

dc:subject a owl:AnnotationProperty .

dc:type a owl:AnnotationProperty .

dcterms: a owl:NamedIndividual ;
    dcterms:modified "2012-06-14"^^xsd:date ;
    dcterms:publisher <http://purl.org/dc/aboutdcmi#DCMI> ;
    dcterms:title "DCMI Metadata Terms - other"@en .

dcterms:BibliographicResource a owl:Class .

dcterms:LicenseDocument a owl:Class .

dcterms:Location a owl:Class .

dcterms:PeriodOfTime a owl:Class .

dcterms:PhysicalMedium a owl:Class ;
    rdfs:subClassOf dcterms:MediaType .

dcterms:contributor a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:range dcterms:Agent ;
    rdfs:subPropertyOf dc:contributor .

dcterms:identifier a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier .

dcterms:title a owl:AnnotationProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:title .

<http://purl.org/spar/doco/Appendix> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://www.essepuntato.it/2008/12/pattern#Bucket> [ a owl:Restriction ;
                                owl:allValuesFrom [ a owl:Class ;
                                        owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Popup> ) ] ;
                                owl:onProperty <http://www.essepuntato.it/2008/12/pattern#isContainedBy> ] ) ] ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#isContainedBy> ],
        [ a owl:Class ;
            owl:unionOf ( <http://purl.org/spar/doco/Chapter> <http://purl.org/spar/doco/Section> ) ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:isPartOf ;
            owl:someValuesFrom <http://purl.org/spar/doco/BackMatter> ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Popup> ) ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> [ a owl:Restriction ;
                        owl:allValuesFrom <http://www.essepuntato.it/2008/12/pattern#Block> ;
                        owl:onProperty <http://www.essepuntato.it/2008/12/pattern#containsAsHeader> ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://www.essepuntato.it/2008/12/pattern#Bucket> [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Popup> ) ] ;
                        owl:onProperty <http://www.essepuntato.it/2008/12/pattern#isContainedBy> ] ) ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Block> <http://www.essepuntato.it/2008/12/pattern#Container> ) ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:isPartOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/spar/doco/BackMatter> <http://purl.org/spar/doco/FrontMatter> ) ] ],
        [ a owl:Class ;
            owl:unionOf ( <http://purl.org/spar/doco/Paragraph> <http://purl.org/spar/doco/Section> ) ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#HeadedContainer> <http://www.essepuntato.it/2008/12/pattern#Table> ) ],
        [ a owl:Class ;
            owl:complementOf <http://www.essepuntato.it/2008/12/pattern#Textual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Popup> ) ] ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#isContainedBy> ],
        [ a owl:Class ;
            owl:unionOf ( <http://www.essepuntato.it/2008/12/pattern#Block> <http://www.essepuntato.it/2008/12/pattern#Container> <http://www.essepuntato.it/2008/12/pattern#Field> <http://www.essepuntato.it/2008/12/pattern#Meta> ) ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#contains> ;
            owl:someValuesFrom <http://org.semanticweb.owlapi/error#Error3> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#contains> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://purl.org/spar/doco/Paragraph> <http://purl.org/spar/doco/Section> ) ] ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.essepuntato.it/2008/12/pattern#contains> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:complementOf <http://purl.org/spar/doco/Chapter> ] ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://purl.org/spar/doco/Section> <http://www.essepuntato.it/2008/12/pattern#HeadedContainer> ) ],
        [ a owl:Restriction ;
