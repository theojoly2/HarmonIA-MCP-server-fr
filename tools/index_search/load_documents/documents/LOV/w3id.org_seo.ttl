<https://w3id.org/seo#TravelInformation> a owl:Class ;
    rdfs:label "Travel information"@en ;
    rdfs:comment "The information about the travel: date, place, ...etc ."@en .

<https://w3id.org/seo#hasEvent> a owl:ObjectProperty ;
    rdfs:comment "an event series has an event edition" ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#EventSeries> ;
    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> .

<https://w3id.org/seo#isPublisherOf> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/seo#Publisher> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Proceedings> ) ] .

<https://w3id.org/seo#isSponsorOf> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/seo#Sponsor> ;
    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> .

<https://w3id.org/seo#isTrackOf> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track> ;
    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent> .

<https://w3id.org/seo#keynoteIn> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/seo#Keynote> ;
    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> .

<https://w3id.org/seo#offersAward> a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> ;
    rdfs:range <https://w3id.org/seo#Award> .

<https://w3id.org/seo#participatesIn> a owl:ObjectProperty ;
    rdfs:domain foaf:Agent ;
    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent> .

