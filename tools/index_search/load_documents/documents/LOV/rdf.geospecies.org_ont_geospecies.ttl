        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "female" ;
    dc:description "Female (♀) is the sex of an organism, or a part of an organism, which produces mobile ova (egg cells)." ;
    rdfs:isDefinedBy onto:.owl .

<http://rdf.geospecies.org/ont/geospecies#Sex_hermaphrodite> a <http://rdf.geospecies.org/ont/geospecies#Sex>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "hermaphrodite" ;
    dc:description "one organism having both male and female sexual characteristics and organs; at birth an unambiguous assignment of male or female cannot be made" ;
    rdfs:isDefinedBy onto:.owl .

<http://rdf.geospecies.org/ont/geospecies#Sex_male> a <http://rdf.geospecies.org/ont/geospecies#Sex>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "male" ;
    dc:description "Male (♂) refers to the sex of an organism, or part of an organism, which produces small mobile gametes, called spermatozoa." ;
    rdfs:isDefinedBy onto:.owl .

<http://rdf.geospecies.org/ont/geospecies#Sex_undetermined> a <http://rdf.geospecies.org/ont/geospecies#Sex>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "Sex Undetermined" ;
    rdfs:isDefinedBy onto:.owl .

<http://rdf.geospecies.org/ont/geospecies#Sex_unknowable> a <http://rdf.geospecies.org/ont/geospecies#Sex>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "Sex Unknowable" ;
    rdfs:isDefinedBy onto:.owl .

<http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus_accepted> a <http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "Accepted" ;
    dc:description "The status of a taxon according to the taxonomic judgement of a cited authority" ;
    rdfs:isDefinedBy onto:.owl ;
    skos:prefLabel "taxonomicStatus_valid" .

<http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus_heterotypicSynonym> a <http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "Heterotypic Synonym" ;
    dc:description "Subjective synonym based on different type(s)" ;
    rdfs:isDefinedBy onto:.owl ;
    skos:prefLabel "taxonomicStatus_heterotypic_synonym" .

<http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus_homotypicSynonym> a <http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "Homotypic Synonym" ;
    dc:description "Objective synonym based on the same type(s)" ;
    rdfs:isDefinedBy onto:.owl ;
    skos:prefLabel "taxonomicStatus_homotypic_synonym" .

<http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus_invalid> a <http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:isDefinedBy onto:.owl ;
    skos:prefLabel "taxonomicStatus_invalid" .

<http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus_misapplied> a <http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "Misapplied" ;
    dc:description "misapplied name" ;
    rdfs:isDefinedBy onto:.owl ;
    skos:prefLabel "taxonomicStatus_misapplied_name" .

<http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus_proParteSynonym> a <http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "Proparte Synonym" ;
    dc:description "Some specimens of the original type series have been assigned to a new type" ;
    rdfs:isDefinedBy onto:.owl .

<http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus_synonym> a <http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "Synonym" ;
    dc:description "if unclear whether hetero- or homotypic. May be qualified by the nomenclatural status of the name" ;
    rdfs:isDefinedBy onto:.owl ;
    skos:prefLabel "taxonomicStatus_synonym" .

<http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus_unaccepted> a <http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus>,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "Unaccepted" ;
    dc:description "unaccepted name, invalid, invalid name" ;
    rdfs:isDefinedBy onto:.owl .

<http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus_unverified> a <http://rdf.geospecies.org/ont/geospecies#TaxonomicStatus>,
        owl:NamedIndividual,
