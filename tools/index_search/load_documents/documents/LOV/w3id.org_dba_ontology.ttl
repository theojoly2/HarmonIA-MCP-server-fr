@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <https://w3id.org/dba/ontology/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://culturalis.org/oad#isContainedIn> a owl:ObjectProperty ;
    rdfs:domain foaf:Document ;
    rdfs:range <http://culturalis.org/oad#ArchivalInstance> .

<http://dati.cdec.it/lod/bio-ext/fatherName> a owl:DatatypeProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

<http://dati.cdec.it/lod/bio-ext/motherName> a owl:DatatypeProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:domain <http://www.semanticweb.org/intesa#Application>,
        <http://www.semanticweb.org/intesa#Approval>,
        <http://www.semanticweb.org/intesa#ApprovalRecord>,
        <http://www.semanticweb.org/intesa#Check>,
        <http://www.semanticweb.org/intesa#Confiscation>,
        <http://www.semanticweb.org/intesa#Contract>,
        <http://www.semanticweb.org/intesa#CreditLine>,
        <http://www.semanticweb.org/intesa#Disposal>,
        <http://www.semanticweb.org/intesa#Donations>,
        <http://www.semanticweb.org/intesa#File>,
        <http://www.semanticweb.org/intesa#Guarantee>,
        <http://www.semanticweb.org/intesa#ImmovableProperty>,
        <http://www.semanticweb.org/intesa#Inspection>,
        <http://www.semanticweb.org/intesa#Loan>,
        <http://www.semanticweb.org/intesa#Mortage>,
        <http://www.semanticweb.org/intesa#MovableProperty>,
        <http://www.semanticweb.org/intesa#Outcome>,
        <http://www.semanticweb.org/intesa#PreliminaryAssessment>,
        <http://www.semanticweb.org/intesa#Property>,
        <http://www.semanticweb.org/intesa#Receivables>,
        <http://www.semanticweb.org/intesa#Report>,
        <http://www.semanticweb.org/intesa#Restitution>,
        <http://www.semanticweb.org/intesa#Seizure>,
        <http://www.semanticweb.org/intesa#SeizureOrConfiscation>,
        <http://www.semanticweb.org/intesa#Sponsorships>,
        <http://www.semanticweb.org/intesa#Verbal>,
        foaf:Document ;
    rdfs:range xsd:string .

dc:type a owl:DatatypeProperty .

dcterms:relation a owl:ObjectProperty .

<http://purl.org/spar/pro/relatesToEntity> a owl:ObjectProperty ;
    rdfs:domain <http://purl.org/spar/pro/RoleInTime> ;
    rdfs:range onto:Event .

<http://purl.org/vocab/bio/0.1/position> a owl:DatatypeProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

ns1:term_status a owl:AnnotationProperty .

<http://www.w3.org/ns/person#citizenship> a owl:DatatypeProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

<http://www.w3.org/ns/person#patronymicName> a owl:DatatypeProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

<http://www.w3.org/ns/person#residency> a owl:DatatypeProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "Description Banking Archives Ontology"@en ;
    ns2:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dc:creator "Fabiana Guernaccini",
        "Federica Brambilla",
        "Giovanni Bruno" ;
    dc:description "The ontology, presented here in a beta version, is based on the analysis of the documentation and descriptive requirements of the Intesa Sanpaolo Historical Archive and is intended to describe the content of historical banking documents and of some of the activities carried out by the bank, particularly in relation to third parties (loans, charity donations, seizures and confiscations, etc.), which involve the initiation of processes or the production of documents. The focal point of the descriptive model is the bank - an entity that initiates different types of processes, whose common feature is that they are structured into various stages/events - and the relationship between the documentation produced and the information it contains. In fact, this ontology is based on information collected from archived documents which describe various processes and activities carried out by banking institutions: the starting point for its construction were the inventories and databases of documentation stored in the Historical Archive which was produced by the various banks that over time were merged into Intesa Sanpaolo. The ontology was created to provide a sufficiently abstract representation and model for describing the processes of various banking activities from which the documentation was produced - from a company's request for financing and its outcome, to the preparation of seizure, confiscation and asset restitution filings, to charitable contributions, just to mention a few examples - reusing models that were already well established and widely used. The structure of the proposed ontology is in fact intended to adapt to the various activities, described in the archive files that a banking institution performs in relation to third parties. The proposed ontology is therefore not an ontology on banking activity in general, but on the relationship between this activity and the documents that are produced. Moreover, its objective is not to describe the documents in the strict sense of the term, for which reference is made to OAD ontology. The purpose of this project is to lay the initial, and fundamental, building blocks for describing the complexity, variety, and breadth of the domain of archiving bank records and the data they contain. Despite having data from different banks relating to different activities and having already made arrangements for the integration of third-party datasets and ontologies, before completing the project we will have to wait for the processing of representations based on other types of documents and banking institutions, including non-Italian ones.\\n"@en ;
    dc:issued "2021-03-18"^^xsd:date ;
    dc:title "Description Banking Archives Ontology"@en ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    vann:preferredNamespacePrefix "dba" ;
    vann:preferredNamespaceUri "https://w3id.org/dba/ontology/" ;
    owl:versionInfo 0.1 .

onto:Conclusion a owl:Class ;
    rdfs:label "Conclusion"@en ;
    rdfs:comment "The act of concluding, that is, finalising a contract, and sometimes the contract itself."@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "unstable"@en .

onto:Credit a owl:Class ;
    rdfs:label "Credit"@en ;
    rdfs:comment "Advance of resources, in the form of the provision of goods or services or the transfer of sums of money, which an economic agent grants to another against a promise of future restitution in one or more tranches, according to the methods and times specified in the contract. A credit can arise directly from commercial relationships between two companies or between a company (an entrepreneur) and a family, or involve a financial intermediary qualified to trade in the credit sector [for example a bank]."@en ;
    rdfs:subClassOf onto:Financing ;
    ns1:term_status "unstable"@en .

onto:CreditLine a owl:Class ;
    rdfs:label "Credit line"@en ;
    rdfs:comment "Credit granted by a bank, in any form, to a customer who has requested it, after having ascertained the customer’s income capacity, assets and moral qualities, or, in the case of a company, those of the individuals managing it. The concept must be distinguished from that of a loan."@en ;
    rdfs:subClassOf onto:Financing ;
    ns1:term_status "unstable"@en .

onto:ImmovableProperty a owl:Class ;
    rdfs:label "Immovable property"@en ;
    rdfs:comment "immovable property can be such by nature, by the owner’s intended use and by law. In addition to the ground, property that is fixed into the ground or rests firmly on it is immovable by nature, as are buildings and all constructions fixed into the ground, whether in masonry or otherwise, boats solidly anchored to the shore, such as the decks of boats, piers, ferries, bathing establishments. All those things that are ancillary to the main immovable property are immovable by intended use: these ancillary elements are usually called appurtenances: autonomous things that however are in a relationship of dependence upon the main thing. Appurtenances are divided into rural and urban, civil and industrial or corporate. Rights in rem over immovable property are immovable by law (e.g. rights of use, usufruct, easement...)"@en ;
    rdfs:subClassOf onto:Property ;
    ns1:term_status "unstable"@en .

onto:Loan a owl:Class ;
    rdfs:label "Loan"@en ;
    rdfs:comment "Transfer of a quantity of existing goods against the commitment to return the same quantity (free loan) or a greater quantity (interest-bearing loan) of future goods, according to different methods. Loans can be: in kind or monetary; granted by individuals to individuals (personal loans), by banks to individuals and other banks (bank loans), by individuals and banks to the State (public or national loans), by other States or by citizens and banks of other States to a State or to entities and companies present therein (foreign or international loans). They can also be distinguished: depending on the duration, in short-, medium- and long-term loans; depending on the guarantee, in mortgage loans, pledges, personal guarantee loans, bills of exchange, fiduciary loans, overdrafts; depending on the use made by the borrower, in consumption or commercial loans."@en ;
    rdfs:subClassOf onto:Financing ;
    ns1:term_status "unstable"@en .

onto:Mortage a owl:Class ;
    rdfs:label "Mortage"@en ;
    rdfs:comment "A mortgage (articles 1813-1822 of the Italian Civil Code) is the contract with which a party (lender) delivers a certain amount of money or other fungible things to the other party (borrower), who acquires the ownership thereof and undertakes to return as many things of the same kind and quality. The mortgage is a real contract: for its completion it is therefore necessary to deliver the money or the borrowed property (in practice, the mortgage generally has as its object a sum of money)."@en ;
    rdfs:subClassOf onto:Financing ;
    ns1:term_status "unstable"@en .

onto:MovableProperty a owl:Class ;
    rdfs:label "Movable property"@en ;
    rdfs:comment "Movable property can be such by nature or by law. Things that can be transported from one place to another are movable by nature, either by extraneous force or by intrinsic property. The rights in rem on movable property are first and foremost movable by law, then all credit rights. The shares in trading companies are movable, that is, the set of rights that accrue to the shareholder for the entire duration of the company, that is, until closing of the liquidation."@en ;
    rdfs:subClassOf onto:Property ;
    ns1:term_status "unstable"@en .

onto:ReportDocument a owl:Class ;
    rdfs:label "Report document"@en ;
    rdfs:comment "Summary or prospectus document"@en ;
    rdfs:subClassOf foaf:Document .

onto:appliesFor a owl:ObjectProperty ;
    rdfs:label "applies for"@en ;
    rdfs:comment "Property that describes the relationship between an agent and a bank service"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range onto:Financing,
        onto:Sponsorships,
        onto:Subsidy ;
    ns1:term_status "unstable"@en .

onto:approvedAmount a owl:DatatypeProperty ;
    rdfs:label "approved amount"@en ;
    rdfs:domain onto:Resolution ;
    rdfs:subPropertyOf onto:amount ;
    ns1:term_status "unstable"@en .

onto:approvedDuration a owl:DatatypeProperty ;
    rdfs:label "approval duration"@en ;
    rdfs:domain onto:Resolution ;
    rdfs:subPropertyOf onto:duration ;
    ns1:term_status "unstable" .

onto:approves a owl:ObjectProperty ;
    rdfs:label "approves"@en ;
    rdfs:comment "Inverse property of \"approved by\""@en ;
    owl:inverseOf onto:isApprovedBy ;
    ns1:term_status "unstable"@en .

onto:consistsOf a owl:ObjectProperty ;
    rdfs:label "consists of"@en ;
    rdfs:comment "Property that describes the relationship between a banking file and the events in which it is divided"@en ;
    rdfs:domain onto:File ;
    rdfs:range <https://linkedevents.org/ontology/Event> ;
    ns1:term_status "unstable"@en .

onto:currency a owl:DatatypeProperty ;
    rdfs:label "currency"@en ;
    rdfs:domain onto:Application,
        onto:DeedOfResolution,
        onto:Resolution ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en .

onto:endDate a owl:DatatypeProperty ;
    rdfs:label "end date"@en ;
    rdfs:subPropertyOf dc:date ;
    ns1:term_status "stable"@en .

onto:fileNumber a owl:DatatypeProperty ;
    rdfs:label "file number"@en ;
    rdfs:domain onto:File ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en .

onto:hasFollowingEvent a owl:ObjectProperty ;
    rdfs:label "following event"@en ;
    rdfs:comment "An event that starts at some time after this event."@en ;
    rdfs:domain <https://linkedevents.org/ontology/Event> ;
    rdfs:range <https://linkedevents.org/ontology/Event> ;
    ns1:term_status "stable"@en .

onto:hasSubEvent a owl:ObjectProperty ;
    rdfs:label "subevent"@en ;
    rdfs:comment "This property provides a way to split a complex event into simpler ones. It decribes the relationship between more events"@en ;
    rdfs:domain <https://linkedevents.org/ontology/Event> ;
    rdfs:range <https://linkedevents.org/ontology/Event> ;
    ns1:term_status "stable"@en .

onto:hasSubject a owl:ObjectProperty ;
    rdfs:label "has subject"@en ;
    rdfs:comment "Inverse property of \"is subject of\""@en ;
    owl:inverseOf onto:isSubjectOf ;
    ns1:term_status "unstable"@en .

onto:includes a owl:ObjectProperty ;
    rdfs:label "Includes"@en ;
    rdfs:comment "Property that describes the relationship between a document and a guarantee"@en ;
    rdfs:domain foaf:Document ;
    rdfs:range onto:Guarantee ;
    ns1:term_status "unstable"@en .

onto:interestRate a owl:DatatypeProperty ;
    rdfs:label "interest rate"@en ;
    rdfs:domain onto:PreliminaryAssessment,
        onto:Resolution ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en .

onto:involves a owl:ObjectProperty ;
    rdfs:label "involves"@en ;
    rdfs:comment "Property that describes the relationship between an event and a property"@en ;
    rdfs:domain onto:Event ;
    rdfs:range foaf:Agent,
        onto:Property ;
    owl:inverseOf onto:isInvolvedIn ;
    ns1:term_status "unstable"@en .

onto:isBasedOn a owl:ObjectProperty ;
    rdfs:label "based on"@en ;
    rdfs:comment "Property that describes the relationship between an event and a guarantee that can be requested during the event"@en ;
    rdfs:domain <https://linkedevents.org/ontology/Event> ;
    rdfs:range onto:Guarantee ;
    ns1:term_status "unstable"@en .

onto:isDocumentedBy a owl:ObjectProperty ;
    rdfs:label "documented by"@en ;
    rdfs:comment "Property that describes the relationship between a banking file or event and an archival instance"@en ;
    rdfs:domain <https://linkedevents.org/ontology/Event>,
        onto:File ;
    rdfs:range <http://culturalis.org/oad#ArchivalInstance> ;
    ns1:term_status "unstable"@en .

onto:isGuaranteedBy a owl:ObjectProperty ;
    rdfs:label "is guaranteed by"@en ;
    rdfs:comment "Property that describes the relationship between a guarantee and an agent"@en ;
    rdfs:domain onto:Guarantee ;
    rdfs:range foaf:Agent ;
    ns1:term_status "unstable"@en .

onto:isPreparedBy a owl:ObjectProperty ;
    rdfs:label "prepared by"@en ;
    rdfs:comment "Property that describes the relationship between a document and the agent who wrote it"@en ;
    rdfs:domain foaf:Document ;
    rdfs:range foaf:Agent ;
    owl:inverseOf onto:prepares ;
    ns1:term_status "unstable"@en .

onto:isSubjectTo a owl:ObjectProperty ;
    rdfs:label "is subject to"@en ;
    rdfs:comment "Property that describes the relationship between a property and the guarantee to which it is subject"@en ;
    rdfs:domain onto:Property ;
    rdfs:range onto:Guarantee ;
    ns1:term_status "unstable"@en .

onto:localIdentifier a owl:DatatypeProperty ;
    rdfs:label "local identifier"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en .

onto:mentions a owl:ObjectProperty ;
    rdfs:label "mentions"@en ;
    rdfs:comment "Property used to describe the relationship between a document and the agent mentioned in it"@en ;
    rdfs:domain foaf:Document ;
    rdfs:range foaf:Agent ;
    ns1:term_status "unstable"@en .

onto:note a owl:DatatypeProperty .

onto:outcome a owl:DatatypeProperty ;
    rdfs:label "outcome"@en ;
    rdfs:domain onto:File ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en .

onto:purpose a owl:DatatypeProperty ;
    rdfs:label "purpose"@en ;
    rdfs:domain foaf:Document,
        <https://linkedevents.org/ontology/Event> ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en .

onto:regards a owl:ObjectProperty ;
    rdfs:label "regards"@en ;
    rdfs:comment "Property that describes the relationship between a document and an agent"@en ;
    rdfs:domain foaf:Document ;
    rdfs:range foaf:Agent ;
    ns1:term_status "unstable"@en .

onto:requiredAmount a owl:DatatypeProperty ;
    rdfs:label "required amount"@en ;
    rdfs:domain onto:Application ;
    rdfs:subPropertyOf onto:amount ;
    ns1:term_status "unstable"@en .

onto:requiredDuration a owl:DatatypeProperty ;
    rdfs:domain onto:Application ;
    rdfs:subPropertyOf onto:duration ;
    ns1:term_status "required duration"@en,
        "unstable"@en .

onto:restitutionDate a owl:DatatypeProperty ;
    rdfs:label "restitution date"@en ;
    rdfs:subPropertyOf dc:date ;
    ns1:term_status "stable"@en .

onto:seizureDate a owl:DatatypeProperty ;
    rdfs:label "seizure date"@en ;
    rdfs:subPropertyOf dc:date ;
    ns1:term_status "stable"@en .

onto:specifications a owl:DatatypeProperty ;
    rdfs:label "specifications"@en ;
    rdfs:domain foaf:Document,
        <https://linkedevents.org/ontology/Event> ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en .

onto:startDate a owl:DatatypeProperty ;
    rdfs:label "start date"@en ;
    rdfs:subPropertyOf dc:date ;
    ns1:term_status "stable"@en .

<http://purl.org/spar/pro/RoleInTime> a owl:Class .

onto:Alienation a owl:Class ;
    rdfs:label "Alienation"@en ;
    rdfs:comment "Legal deed by which a property or a right on the goods comprising one’s own assets is transferred to other entities, through sale, donation, mortgage, etc."@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "unstable"@en .

onto:Audit a owl:Class ;
    rdfs:label "Audit"@en ;
    rdfs:comment "Verification of the formal or substantive regularity of a document, a factual situation or a right. The audit may refer, within the scope of companies, to checks of an economic nature, of a legal nature, of an accounting nature, of a financial nature, of a technical nature, etc."@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "unstable"@en .

onto:Bank a owl:Class ;
    rdfs:label "Bank"@en ;
    rdfs:comment "Company that carries out fundraising transactions and disburses non-transferable loans on the market."@en ;
    rdfs:subClassOf org:Organization .

onto:Confiscation a owl:Class ;
    rdfs:label "Confiscation"@en ;
    rdfs:comment "Confiscation consists of an ancillary penalty which is imposed following a conviction and which consists of an actual expropriation in favour of the State. It is therefore a security measure of a patrimonial nature consisting of the forced and free expropriation in favour of the State and, in an urban context, in favour of a Municipality’s assets, of all the things that comprise the price of the crime, which were used to commit the crime, those which constitute the product and the profit of such crime, as well as those which are criminal by nature. This measure can be optional or mandatory."@en ;
    ns1:term_status "unstable"@en .

onto:ConfiscationEvent a owl:Class ;
    rdfs:label "Confiscation"@en ;
    rdfs:comment "Execution of the confiscation"@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "Unstable"@en .

onto:Contract a owl:Class ;
    rdfs:label "Contract"@en ;
    rdfs:comment "The contract is defined by art. 1321 of the Italian Civil Code as “the agreement of two or more parties to establish, govern or terminate a legal patrimonial relationship between them”."@en ;
    rdfs:subClassOf foaf:Document ;
    ns1:term_status "unstable"@en .

onto:Inspection a owl:Class ;
    rdfs:label "Inspection"@en ;
    rdfs:comment "The visit and the set of checks carried out by an inspector."@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "unstable"@en .

onto:Minutes a owl:Class ;
    rdfs:label "Minutes"@en ;
    rdfs:comment "document drawn up by whoever is vested with this specific function or by a public official, in order to certify and remember - in a concise but complete and exhaustive form as regards the key data - facts, proceedings and events of various kinds and the matters discussed during a meeting or a shareholders’ meeting."@en ;
    rdfs:subClassOf foaf:Document ;
    ns1:term_status "unstable"@en .

onto:Outcome a owl:Class ;
    rdfs:label "Outcome"@en ;
    rdfs:comment "Method of extinguishing the loan and closing the file"@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "Unstable"@en .

onto:Report a owl:Class ;
    rdfs:label "Report"@en ;
    rdfs:comment "A report is a text which reports in detailed and objective manner on an activity, a study or an analysis, or illustrates a topic on which appropriate documentation has been collected."@en ;
    rdfs:subClassOf foaf:Document ;
    ns1:term_status "unstable"@en .

onto:Restitution a owl:Class ;
    rdfs:label "Restitution"@en ;
    rdfs:comment "The personal act of restitution is intended to obtain the fulfilment of the obligation to retransfer something that has previously been voluntarily transmitted by the plaintiff to the defendant, by virtue of transactions such as lease, loan, deposit and so on, which do not necessarily require the title of ownership. The restitution aims to obtain the retransfer of an asset previously voluntarily transmitted by the plaintiff to the defendant. The holder of right in rem on an asset (whether movable or immovable) can thus request the restitution of the asset from anyone who has appropriated the asset (exercising mere possession) or from anyone who owns the asset (exercising possession on account of others)."@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "unstable"@en .

onto:Seizure a owl:Class ;
    rdfs:label "Seizure"@en ;
    rdfs:comment "In legal jargon, a precautionary measure, which gives rise to a restriction of unavailability on the affected movable or immovable property, in order to ensure a certain factual or legal situation. Provision aimed at removing the free availability of movable and immovable property, of companies and the like, from their holders."@en ;
    ns1:term_status "unstable"@en .

onto:SeizureEvent a owl:Class ;
    rdfs:label "Seizure"@en ;
    rdfs:comment "Execution of the seizure"@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "unstable"@en .

onto:isApprovedBy a owl:ObjectProperty ;
    rdfs:label "is approved by"@en ;
    rdfs:comment "Property used to describe the relationship between an approval and the person who authorizes it"@en ;
    rdfs:domain onto:Resolution ;
    rdfs:range org:Organization ;
    ns1:term_status "unstable"@en .

onto:isInvolvedIn a owl:ObjectProperty ;
    rdfs:label "involved in"@en ;
    rdfs:comment "Inverse property of involves"@en ;
    ns1:term_status "unstable"@en .

onto:isSubjectOf a owl:ObjectProperty ;
    rdfs:label "subjectOf"@en ;
    rdfs:comment "Property that describes the relationship between a banking service, suche as loan, receivables mortgage creditline, or a property and a banking file"@en ;
    rdfs:domain onto:Confiscation,
        onto:Financing,
        onto:Property,
        onto:Seizure,
        onto:Sponsorships,
        onto:Subsidy ;
    rdfs:range onto:File ;
    ns1:term_status "unstable"@en .

onto:prepares a owl:ObjectProperty ;
    rdfs:label "prepares"@en ;
    rdfs:comment "Property that describes the relationship between a bank and a banking file"@en ;
    rdfs:domain onto:Bank ;
    rdfs:range onto:File ;
    ns1:term_status "unstable"@en .

<http://culturalis.org/oad#ArchivalInstance> a owl:Class .

org:Organization a owl:Class ;
    rdfs:subClassOf foaf:Agent .

onto:DeedOfResolution a owl:Class ;
    rdfs:label "Deed of resolution"@en ;
    rdfs:comment "Minutes documenting the conclusion of a decision-making process."@en ;
    rdfs:subClassOf foaf:Document ;
    ns1:term_status "unstable"@en .

onto:PreliminaryAssessment a owl:Class ;
    rdfs:label "Preliminary assessment"@en ;
    rdfs:comment "Indicates the preliminary investigation phase relating to the acquisition of information aimed at defining the possibilities and methods of intervention on the market by a company."@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "unstable"@en .

onto:Sponsorships a owl:Class ;
    rdfs:label "Sponsorships"@en ;
    rdfs:comment "A sponsorship contract is defined as the contract by which a party - called the “sponsor” - undertakes to pay a fee in favour of another party - called the “sponsee” - which, in turn, undertakes to disclose the sponsor’s name or brand in the course of its activities, with the aim of obtaining a positive return in terms of notoriety and image, thereby benefiting from the promotional potential of the event itself. \\nThe sponsorship identifies the relationship between a company, or a brand, and a cultural, sporting, musical or ethical initiative, which is financed in whole or in part thanks to an economic agreement of variable duration."@en ;
    ns1:term_status "unstable"@en .

onto:Subsidy a owl:Class ;
    rdfs:label "Subsidy"@en ;
    rdfs:comment "Financial aid granted to individuals, businesses, communities and miscellaneous institutions. In general, it is complementary and supplementary, and aimed at achieving certain activities and objectives."@en ;
    ns1:term_status "unstable"@en .

onto:amount a owl:DatatypeProperty ;
    rdfs:label "amount"@en ;
    rdfs:domain <https://linkedevents.org/ontology/Event> ;
    ns1:term_status "unstable"@en .

onto:duration a owl:DatatypeProperty ;
    rdfs:label "duration"@en ;
    rdfs:domain <https://linkedevents.org/ontology/Event> ;
    ns1:term_status "unstable"@en .

dc:date a owl:DatatypeProperty ;
    rdfs:domain foaf:Document,
        <https://linkedevents.org/ontology/Event>,
        onto:Alienation,
        onto:Application,
        onto:Audit,
        onto:ConfiscationEvent,
        onto:Contract,
        onto:DeedOfResolution,
        onto:File,
        onto:Guarantee,
        onto:Inspection,
        onto:Minutes,
        onto:Outcome,
        onto:PreliminaryAssessment,
        onto:Report,
        onto:Resolution,
        onto:Restitution,
        onto:SeizureEvent ;
    rdfs:range xsd:dateTime .

onto:Application a owl:Class ;
    rdfs:label "Application"@en ;
    rdfs:comment "Formulation of a request for a service, for example the disbursement of a mortgage or a loan, from a customer to the banking company."@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "unstable"@en .

onto:Guarantee a owl:Class ;
    rdfs:label "Guarantee"@en ;
    rdfs:comment "From a legal point of view, suitable means to ensure the fulfilment of an obligation, the exercise of a function or, in general, the observance of a legislative precept or a specific commitment. From an economic point of view, the guarantee is a transfer of risk: the lender assumes a risk that the beneficiary no longer bears, provided that the guarantee is honoured."@en ;
    ns1:term_status "unstable"@en .

onto:Property a owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:comment "In the general sense, goods are products or resources that can be destined directly to the satisfaction of needs, or be used to produce other goods. As tangible resources or products, goods are distinguished from services, which are performances rendered over time."@en ;
    ns1:term_status "unstable"@en .

foaf:Person a owl:Class ;
    rdfs:subClassOf foaf:Agent .

onto:Financing a owl:Class ;
    rdfs:label "Financing"@en ;
    rdfs:comment "The act of providing the necessary means for the completion of a work, for the performance of an activity, or the sum provided or obtained. In the private sector it is granted by private entities (banks and other financial institutions, large industries, etc.), or even by individual citizens with the underwriting of shares, the purchase of bonds, the granting of credit and guarantees, or with deeds of patronage (e.g. sponsorships), mostly as an aid for the completion of works or for the performance of activities of common interest. The financing of enterprises can take place through the granting of short-term credit for current activities and medium and long-term credit to provide the enterprises with the necessary capital for the initial set-up and their subsequent expansion, or through direct recourse by the same enterprises to the capital market with the issue of bonds, or shares, or even through the intermediation of financial companies."@en ;
    ns1:term_status "unstable"@en .

onto:Resolution a owl:Class ;
    rdfs:label "Resolution"@en ;
    rdfs:comment "Decision of a board and the resulting provision. Term used to indicate the decision taken by a board (e.g. shareholders’ meeting). It expresses the will of the entity. Usually the resolution is documented in a set of minutes, that is, in a public document."@en ;
    rdfs:subClassOf onto:Event ;
    ns1:term_status "unstable"@en .

onto:File a owl:Class ;
    rdfs:label "File"@en ;
    rdfs:comment "The set of deeds or documents required to start and conclude a business, and necessary to request authorisations, concessions and the suchlike. In a concrete sense, the set of papers relating to the individual, to a specific object, and the insert, the file that binds them together."@en ;
    ns1:term_status "unstable"@en .

foaf:Agent a owl:Class .

<https://linkedevents.org/ontology/Event> a owl:Class ;
    owl:equivalentClass onto:Event .

foaf:Document a owl:Class .

onto:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "A thing that happens or takes place; an action made by the Bank during the banking"@en ;
    ns1:term_status "unstable"@en .

