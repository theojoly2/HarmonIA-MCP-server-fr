@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://www.molmod.info/semantics/pims-ii.ttl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdf:List a rdfs:Class ;
    rdfs:comment "the first element is related to the list by rdf:first, the second by (rdf:rest o rdf:first), the third by (rdf:rest o rdf:rest o rdf:first), and so on; where the list ends, it is related by rdf:rest to rdf:nil"@en ;
    skos:example "See also: https://ontola.io/blog/ordered-data-in-rdf/"@en ;
    skos:scopeNote "Syntactic construct (x1 x2 x3 x4) used within the resource description framework (RDF) for a list"@en .

onto: a owl:Ontology ;
    dc:description "The Physicalistic Interpretation of Modelling and Simulation - Interoperability Infrastructure (PIMS-II) is a mid-level ontology with a focus on documenting cognitive processes and epistemic metadata"@en ;
    dcterms:bibliographicCitation "Cite this vocabulary as: M. T. Horsch, PIMS-II ontology, http://www.molmod.info/semantics/pims-ii/, version II.1.12a, 2023. Also reference at least one the following papers: (a) http://ceur-ws.org/Vol-2969/paper3-FOUST.pdf (b) http://ceur-ws.org/Vol-3249/paper2-CAOS.pdf"@en ;
    dcterms:created "2023-05-04"^^xsd:date ;
    dcterms:creator "Martin Thomas Horsch (ORCID 0000-0002-9464-6739)"^^xsd:string ;
    dcterms:issued "2023-05-04"^^xsd:date ;
    dcterms:license "https://www.gnu.org/licenses/lgpl-3.0.en.html"^^xsd:string ;
    dcterms:publisher "Innovation Centre for Process Data Technology (Inprodat e.V.)"^^xsd:string ;
    dcterms:references <http://www.molmod.info/semantics/pims-ii-latex-symbols.tex> ;
    dcterms:title "Physicalistic Interpretation of Modelling and Simulation - Interoperability Infrastructure (PIMS-II)"^^xsd:string ;
    vann:preferredNamespacePrefix "pims-ii"^^xsd:string ;
    vann:preferredNamespaceUri "http://www.molmod.info/semantics/pims-ii.ttl#"^^xsd:string ;
    owl:versionIRI <http://www.molmod.info/semantics/pims-ii/II.1.12a/> ;
    owl:versionInfo "PIMS-II version II.1.12a"^^xsd:string .

<http://www.molmod.info/semantics/pims-ii.ttl#CanonicalTUCAN> a owl:Class ;
    rdfs:label "CanonicalTUCAN"@en ;
    rdfs:comment "Canonical TUCAN, i.e., the material identifier as developed within the NFDI4Chem project"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#MaterialIdentifier> .

<http://www.molmod.info/semantics/pims-ii.ttl#Dataset> a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "Dataset, i.e., a digital articulation that is composed of multiple data items that are similar in shape, kind, and content type"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality 2 ;
            owl:onClass <http://www.molmod.info/semantics/pims-ii.ttl#DataItem> ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> .

<http://www.molmod.info/semantics/pims-ii.ttl#EPTRC> a owl:Class ;
    rdfs:label "EPTRC"@en ;
    rdfs:comment "EPTRC, i.e., an exact-agreement provenance-conscious team-change reproducibility claim"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#EPRC>,
        <http://www.molmod.info/semantics/pims-ii.ttl#ETRC>,
        <http://www.molmod.info/semantics/pims-ii.ttl#PTRC> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#ExactAgreementReproducibilityClaim> <http://www.molmod.info/semantics/pims-ii.ttl#ProvenanceConsciousReproducibilityClaim> <http://www.molmod.info/semantics/pims-ii.ttl#TeamChangeReproducibilityClaim> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#ExperimentalWorkflow> a owl:Class ;
    rdfs:label "ExperimentalWorkflow"@en ;
    rdfs:comment "experimental workflow, i.e., a cognition that is purposefully conducted in a controlled environment and has at least one measurement as a step"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isStepInCognitiveChain> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Measurement> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveWorkflow> .

<http://www.molmod.info/semantics/pims-ii.ttl#KnowledgeBasedAgent> a owl:Class ;
    rdfs:label "KnowledgeBasedAgent"@en ;
    rdfs:comment "Knowledge-based agent, i.e., an intelligent agent that uses a knowledge base to store and process its opinions/claims/worldview"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereologicallyConstitutiveOf> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#KnowledgeBase> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#IntelligentAgent> .

<http://www.molmod.info/semantics/pims-ii.ttl#MathematicalOperator> a owl:Class ;
    rdfs:label "MathematicalOperator"@en ;
    rdfs:comment "Mathematical operator, i.e., a lexeme that articulates a mathematical operation, such as the collective containing realizations of '*', '·', 'times', etc."^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Lexeme> .

<http://www.molmod.info/semantics/pims-ii.ttl#NegativeKnowledgeClaim> a owl:Class ;
    rdfs:label "NegativeKnowledgeClaim"@en ;
    rdfs:comment "Negative knowledge claim (NKC), i.e., a knowledge claim that expresses what we don't know, a gap or limitation of our knowledge"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#KnowledgeClaim> ;
    skos:altLabel "NKC"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#OwnClaim> a owl:Class ;
    rdfs:label "OwnClaim"@en ;
    rdfs:comment "Own claim, i.e., a claim that is asserted by a self reference (i.e., a/the present interlocutor)"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Claim> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isAssertedBy> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#ReferenceToSelf> ] ;
    skos:scopeNote "Specifically this could be used as a concept to be applied to propositional content of the present knowledge base"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Person> a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "Person, i.e., an interlocutor that is socially identified as a natural or legal person by social convention that involves using a name (or multiple names) for it as rigid designators"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isNameFor> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Name> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> .

<http://www.molmod.info/semantics/pims-ii.ttl#QuantityValue> a owl:Class ;
    rdfs:label "QuantityValue"@en ;
    rdfs:comment "Quantity value, i.e., a value that has a numerical magnitude and a physical unit"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    owl:equivalentClass [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMagnitudeOf> ] ;
                        owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Number> ] [ a owl:Restriction ;
                        owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isUnitOf> ] ;
                        owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#MeasurementUnit> ] ) ] .

<http://www.molmod.info/semantics/pims-ii.ttl#Query> a owl:Class ;
    rdfs:label "Query"@en ;
    rdfs:comment "Query, i.e., a digital articulation of a question"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> ;
    owl:equivalentClass [ owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> [ a owl:Restriction ;
                        owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#articulates> ;
                        owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Question> ] ) ] .

<http://www.molmod.info/semantics/pims-ii.ttl#ResearchQuestion> a owl:Class ;
    rdfs:label "ResearchQuestion"@en ;
    rdfs:comment "Research question, i.e., a question that could, has been, or is being addressed by scientific research and e.g. could be answered by a knowledge claim formulated on the grounds of scientific research data"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Question> ;
    skos:altLabel "RQN"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#SimulationWorkflow> a owl:Class ;
    rdfs:label "SimulationWorkflow"@en ;
    rdfs:comment "simulation workflow, i.e., a cognitive workflow in which simulation plays a major role"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isStepInCognitiveChain> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Simulation> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveWorkflow> .

<http://www.molmod.info/semantics/pims-ii.ttl#articulatesNonliterally> a owl:ObjectProperty ;
    rdfs:label "articulatesNonliterally"@en ;
    rdfs:comment "(x articulatesNonliterally y) means that x is a collective non-literal expression (e.g., an utterance) of proposition y, and possibly additional propositions beside y"^^xsd:string ;
    rdfs:domain [ owl:complementOf <http://www.molmod.info/semantics/pims-ii.ttl#CollectiveLiteral> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#articulates> .

<http://www.molmod.info/semantics/pims-ii.ttl#directlyPrecedesByRupture> a owl:ObjectProperty ;
    rdfs:label "directlyPrecedesByRupture"@en ;
    rdfs:comment "(x directlyPrecedesByRupture y) == x is the cognitive step that directly precedes y logically (and typically, y takes over a dyadic representation relation from x), but either x or y constitutes a cognitive rupture, i.e., it interrupts the chain of grounding"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#directlyPrecedesCognitiveStep> .

<http://www.molmod.info/semantics/pims-ii.ttl#hasAbsoluteNecessityMode> a owl:ObjectProperty ;
    rdfs:label "hasAbsoluteNecessityMode"@en ;
    rdfs:comment "(x hasAbsoluteNecessityMode y) means that x is a relational IRI and y is an absolute modal IRI for 'necessarily x'"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#AbsoluteModalIRI> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasNecessityMode> .

<http://www.molmod.info/semantics/pims-ii.ttl#hasAbsolutePossibilityMode> a owl:ObjectProperty ;
    rdfs:label "hasAbsolutePossibilityMode"@en ;
    rdfs:comment "(x hasAbsolutePossibilityMode y) means that x is a relational IRI and y is an absolute modal IRI for 'possibly x'"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#AbsoluteModalIRI> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasPossibilityMode> .

<http://www.molmod.info/semantics/pims-ii.ttl#hasNegation> a owl:ObjectProperty ;
    rdfs:label "hasNegation"@en ;
    rdfs:comment "(x hasNegation y) means that x and y are IRIs that can possibly occur in the predicate (middle) position of a triple, and that y is 'not x'; n.b., this is not a symmetrical relation, since 'not not x' is syntactically different from x"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#hasQualifiedNecessityMode> a owl:ObjectProperty ;
    rdfs:label "hasQualifiedNecessityMode"@en ;
    rdfs:comment "(x hasQualifiedNecessityMode y) means that x is a relational IRI and y is a qualified modal IRI for 'necessarily x'"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#QualifiedModalIRI> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasNecessityMode> .

<http://www.molmod.info/semantics/pims-ii.ttl#hasQualifiedPossibilityMode> a owl:ObjectProperty ;
    rdfs:label "hasQualifiedPossibilityMode"@en ;
    rdfs:comment "(x hasQualifiedPossibilityMode y) means that x is a relational IRI and y is a qualified modal IRI for 'possibly x'"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#QualifiedModalIRI> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasPossibilityMode> .

<http://www.molmod.info/semantics/pims-ii.ttl#isAccumulationConditionIn> a owl:ObjectProperty ;
    rdfs:label "isAccumulationConditionIn"@en ;
    rdfs:comment "(x isAccumulationConditionIn y) == in the accumulation process y, the condition x controls in what way the input and the additionally included elements interact to yield a combined output"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Accumulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> .

<http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleUnitFor> a owl:ObjectProperty ;
    rdfs:label "isAdmissibleUnitFor"@en ;
    rdfs:comment "(x isAdmissibleUnitFor y) means that x is a unit that can be associated with the variable y; subsumption under msHPIPIR is explained as follows: There is a sign z for the variable y (where z is a description of admissible values of y) of which x is constitutive (and with which x hence overlaps)"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#MeasurementUnit> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIR> .

<http://www.molmod.info/semantics/pims-ii.ttl#isCausallyDisconnectedFrom> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "isCausallyDisconnectedFrom"@en ;
    rdfs:comment "(x isCausallyDisconnectedFrom y) means that between x and y there is no 'real causal connection' in the Peircean sense; therefore, x and y cannot be the old and new referents in a metonymization; similarly, x cannot act as a representamen for y in a grounded cognition (if it does, then the cognition is not grounded)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> .

<http://www.molmod.info/semantics/pims-ii.ttl#isCognitiveSubstepOf> a owl:ObjectProperty ;
    rdfs:label "isCognitiveSubstepOf"@en ;
    rdfs:comment "In certain cases, multiple cognitive steps can be combined to yield one; e.g., the substep a: s - o - s' and the substep b: s' - o - s'' can be combined to yield a single triad, (a o b) = c: s - o - s''; in that case, c can be an element of a higher-order cognitive chain (of which it is a step), and a and b are its cognitive substeps"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveChain>,
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isStepInCognitiveChain> .

<http://www.molmod.info/semantics/pims-ii.ttl#isHeldBy> a owl:ObjectProperty ;
    rdfs:label "isHeldBy"@en ;
    rdfs:comment "(x isHeldBy y) means that the claim x is consistently asserted by the knowledge base y whenever it is queried about it; if y extends significantly through time and changes opinion about x (i.e., it does not assert it consistently over the whole time), it cannot be said to hold x as a claim, merely to assert it; in this case, it may be advisable to define a (temporal) part y' of y which can then be said to hold x as a claim"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Claim> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#KnowledgeBase> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isAssertedBy> .

<http://www.molmod.info/semantics/pims-ii.ttl#isListenerIn> a owl:ObjectProperty ;
    rdfs:label "isListenerIn"@en ;
    rdfs:comment "(x isListenerIn y) means that x is one of the interlocutors listening to the speaker's expressive act y"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#ExpressiveAct> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterlocutorIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isMaximizationObjectiveIn> a owl:ObjectProperty ;
    rdfs:label "isMaximizationObjectiveIn"@en ;
    rdfs:comment "(x isMaximizationObjectiveIn y) == x is a maximization objective/criterion considered in the optimization problem y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Optimization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isOptimizationObjectiveWithin> .

<http://www.molmod.info/semantics/pims-ii.ttl#isMinimizationObjectiveIn> a owl:ObjectProperty ;
    rdfs:label "isMaximizationObjectiveIn"@en ;
    rdfs:comment "(x isMaximizationObjectiveIn y) == x is a maximization objective/criterion considered in the optimization problem y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Optimization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isOptimizationObjectiveWithin> .

<http://www.molmod.info/semantics/pims-ii.ttl#isParadataWithin> a owl:ObjectProperty ;
    rdfs:label "isParadataWithin"@en ;
    rdfs:comment "(x isParadataWithin y) means that x articulates something explicitly said to be unsubstantial to the rule y, and thereby semiotically constitutive of it, e.g., by a mechanism of logical subtraction"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Rule> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ;
    skos:altLabel "\\\\v{C}_\\\\parallel"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isReferenceFrameFor> a owl:ObjectProperty ;
    rdfs:label "isReferenceFrameFor"@en ;
    rdfs:comment "(s isReferenceFrameFor s') means that s is a representamen that provides relevant context, such as presuppositions or preconditions, to the representamen s'"@en ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#sharesReferentWith> ;
    skos:altLabel "\\\\dddot{R}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isResultOf> a owl:ObjectProperty ;
    rdfs:label "isResultOf"@en ;
    rdfs:comment "(x isResultOf y) if x is an outcome/result of the cognitive process y"@en ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantIn> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> ] ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantInCognition> ;
    skos:altLabel "\\\\bar{R}"@en ;
    skos:example "outcomes/results of a research process can be a research data set, one or multiple knowledge claims, or some combination thereof such as a FAIR digital object"@en ;
    skos:scopeNote "an outcome/result of a cognition must occur in the role of the interpretant somewhere within that cognition"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isSelectionConditionIn> a owl:ObjectProperty ;
    rdfs:label "isSelectionConditionIn"@en ;
    rdfs:comment "(x isSelectionConditionIn y) == in the selection process y, the condition x controls what constitutive element(s) of the input are retained as part of the output"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Selection> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> .

<http://www.molmod.info/semantics/pims-ii.ttl#isTargetPropertyIn> a owl:ObjectProperty ;
    rdfs:label "isTargetPropertyIn"@en ;
    rdfs:comment "(x isTargetPropertyIn y) means that cognitive action x targets y as the property for which a value is to be determined by observation or by theoretical or computational methods"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Property> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveAction> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
    skos:altLabel "\\\\tilde{R}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isToolIn> a owl:ObjectProperty ;
    rdfs:label "isToolIn"@en ;
    rdfs:comment "(x isToolIn y) means that x is employed by an agent during the action y"@en ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Action> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantIn> ;
    skos:altLabel "\\\\ddot{P}_\\\\epsilon"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#AbsoluteLaw> a owl:Class ;
    rdfs:label "AbsoluteLaw"@en ;
    rdfs:comment "Absolute law, i.e., a law where the necessary entailment of the consequent(s) by the antecedent is expressed in terms of absolute logical/physical necessity"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Law> .

<http://www.molmod.info/semantics/pims-ii.ttl#AbstractModelPropertyClaim> a owl:Class ;
    rdfs:label "AbstractModelPropertyClaim"@en ;
    rdfs:comment "Abstract model property claim (CMPC), i.e., a model property claim that is not immediately applied to the corresponding property of a real physical system"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ModelPropertyClaim> ;
    skos:altLabel "AMPC"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Assessment> a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "Assessment (of a cognitive step), i.e., a ground that provides an explanation including a proposition on the extent (quantitatively or qualitatively) to which the grounded cognitive step is reliable/accurate/valid (or similar), why that is the case, and how that relates to the reliability/accuracy/etc. of the preceding step"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Ground> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isAssessmentFor> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ] .

<http://www.molmod.info/semantics/pims-ii.ttl#BasicGround> a owl:Class ;
    rdfs:label "BasicGround"@en ;
    rdfs:comment "Basic ground, i.e., a ground that is assumed to be valid and reliable a priori; a cognitive step for which there is a basic ground is a presupposition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Presupposition> ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isGroundFor> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Ground> .

<http://www.molmod.info/semantics/pims-ii.ttl#CognitiveRupture> a owl:Class ;
    rdfs:label "CognitiveRupture"@en ;
    rdfs:comment "Cognitive rupture, i.e., a cognitive step that constitutes a break in the chain of epistemic grounding"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> .

<http://www.molmod.info/semantics/pims-ii.ttl#CollectiveUtterance> a owl:Class ;
    rdfs:label "CollectiveUtterance"@en ;
    rdfs:comment "Collective utterance, i.e., a semiotic collective the members of which do not have digital, printed, or written textual/numerical form and the members of which are all attributed the same semantics and pragmatics; n.b., collective utterances are not permitted to have other semiotic collectives as their semiotic members"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#CollectiveLiteral> .

<http://www.molmod.info/semantics/pims-ii.ttl#ConceptualKnowledgeClaim> a owl:Class ;
    rdfs:label "ConceptualKnowledgeClaim"@en ;
    rdfs:comment "Conceptual knowledge claim (CKC), i.e., a knowledge claim establishing the ontological status of a lexeme"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#KnowledgeClaim> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#PropertyClaim> ;
    skos:altLabel "CKC"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#ConcreteModelPropertyClaim> a owl:Class ;
    rdfs:label "ConcretePropertyClaim"@en ;
    rdfs:comment "Concrete model property claim (CMPC), i.e., a model property claim that is immediately also applied to the corresponding property of a real physical system"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ModelPropertyClaim>,
        <http://www.molmod.info/semantics/pims-ii.ttl#PhysicalPropertyClaim> ;
    skos:altLabel "CMPC"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#EPRC> a owl:Class ;
    rdfs:label "EPRC"@en ;
    rdfs:comment "EPRC, i.e., an exact-agreement provenance-conscious reproducibility claim"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ExactAgreementReproducibilityClaim>,
        <http://www.molmod.info/semantics/pims-ii.ttl#ProvenanceConsciousReproducibilityClaim> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#ExactAgreementReproducibilityClaim> <http://www.molmod.info/semantics/pims-ii.ttl#ProvenanceConsciousReproducibilityClaim> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#ETRC> a owl:Class ;
    rdfs:label "ETRC"@en ;
    rdfs:comment "ETRC, i.e., an exact-agreement team-change reproducibility claim"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ExactAgreementReproducibilityClaim>,
        <http://www.molmod.info/semantics/pims-ii.ttl#TeamChangeReproducibilityClaim> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#ExactAgreementReproducibilityClaim> <http://www.molmod.info/semantics/pims-ii.ttl#TeamChangeReproducibilityClaim> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#MaterialIdentifier> a owl:Class ;
    rdfs:label "MaterialIdentifier"@en ;
    rdfs:comment "Name or label that identifies the material of its referent, or the material that some semiotic collective is about"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Name> ;
    skos:scopeNote "in particular, the TUCAN identifiers from NFDI4Chem can be used" .

<http://www.molmod.info/semantics/pims-ii.ttl#PTRC> a owl:Class ;
    rdfs:label "PTRC"@en ;
    rdfs:comment "PTRC, i.e., a provenance-conscious team-change reproducibility claim"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ProvenanceConsciousReproducibilityClaim>,
        <http://www.molmod.info/semantics/pims-ii.ttl#TeamChangeReproducibilityClaim> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#ProvenanceConsciousReproducibilityClaim> <http://www.molmod.info/semantics/pims-ii.ttl#TeamChangeReproducibilityClaim> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#PhysicalPropertyClaim> a owl:Class ;
    rdfs:label "PropertyClaim"@en ;
    rdfs:comment "Physical property claim (PPC), i.e., a PC concerning a property of a physical system"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#PropertyClaim> ;
    skos:altLabel "PPC"@en ;
    skos:scopeNote "Claim expressed through a PC: 'From data δ, property p of object o under conditions c was found by agent a to have the value v'"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#RationalAgent> a owl:Class ;
    rdfs:label "RationalAgent"@en ;
    rdfs:comment "A rational agent is an intelligent agent that exhibits rationality, i.e., a tendency toward maximizing a quantity: The performance measure of the agent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGoalOf> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#OptimizationProblem> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#IntelligentAgent> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isPerformanceMeasureOf> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Property> ] ;
    skos:scopeNote "Similar as in the case of goal-orientation, rationality does *not* require the agent to be aware of its performance measure."@en .

<http://www.molmod.info/semantics/pims-ii.ttl#ReferenceToSelf> a owl:Class ;
    rdfs:label "ReferenceToSelf"@en ;
    rdfs:comment "Reference to self, i.e., an entity for the interlocutor who *is* the present system, i.e., the system containing the present triples, etc., and whose claims are to be accepted as the present system's 'own claims.' A self-reference is an entity that is either identical with the system at hand, namely, the digital infrastructure or other interlocutor that stores the present semantic content, or a component of it"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ;
    skos:example "If the present triples are processed by a research data infrastructure with a federated architecture, consisting of several repositories (which are interlocutors, i.e., they can be queried and communicate with the outside world), both the research data infrastructure as a whole and the individual repositories are self-references"@en ;
    skos:scopeNote "This is relevant for distinguishing anybody's claims from the present system's own claims: If and only if a proposition is asserted by a self-reference, it is an own claim"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#TopicalProduct> a owl:Class ;
    rdfs:label "TopicalProduct"@en ;
    rdfs:comment "Topical product, i.e., a topical proposition with multiple topical factors"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Topical> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTopicalFactorIn> ] ;
            owl:someValuesFrom [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Topical> <http://www.molmod.info/semantics/pims-ii.ttl#TopicalSum> ) ] ] .

<http://www.molmod.info/semantics/pims-ii.ttl#UniqueIdentifier> a owl:Class ;
    rdfs:label "UniqueIdentifier"@en ;
    rdfs:comment "Unique identifier, i.e., a rigid designator that is applied to exactly one object"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Name> .

<http://www.molmod.info/semantics/pims-ii.ttl#affirmsCognition> a owl:ObjectProperty ;
    rdfs:label "affirmsCognition"@en ;
    rdfs:comment "(x affirmsCognition y) means that x is about the cognition y, affirming its validity"@en ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isAbout> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#providesJustification> <http://www.molmod.info/semantics/pims-ii.ttl#isJustificationFor> ) ;
    skos:altLabel "\\\\hat{A}_\\\\kappa"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#articulatesLiterally> a owl:ObjectProperty ;
    rdfs:label "articulatesLiterally"@en ;
    rdfs:comment "(x articulatesLiterally y) means that x is a collective literal expressing the proposition y, and possibly additional propositions beside y"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#CollectiveLiteral> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#articulates> .

<http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInPartToWhole> a owl:ObjectProperty ;
    rdfs:label "changesReferentInPartToWhole"@en ;
    rdfs:comment "(x changesReferentInPartToWhole y) == y is a part-to-whole synecdoche where x acts as the representamen, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#PartToWhole> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInSynecdoche> .

<http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInWholeToPart> a owl:ObjectProperty ;
    rdfs:label "changesReferentInWholeToPart"@en ;
    rdfs:comment "(x changesReferentInWholeToPart y) == y is a whole-to-part synecdoche where x acts as the representamen, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#WholeToPart> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInSynecdoche> .

<http://www.molmod.info/semantics/pims-ii.ttl#describesMethodAppliedIn> a owl:ObjectProperty ;
    rdfs:label "describesMethodAppliedIn"@en ;
    rdfs:comment "(x describesMethodAppliedIn y) means that x describes y in terms of the method that is employed"@en ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#describesMethodEmployedBy> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Agent> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Action> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
    skos:altLabel "\\\\v{R}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#describesMethodEmployedBy> a owl:ObjectProperty ;
    rdfs:label "describesMethodEmployedBy"@en ;
    rdfs:comment "(x describesMethodEmployedBy y) means that the agent y follows a methodology described by x in carrying out an action"@en ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Agent> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#describesMethodAppliedIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAgentIn> ] ) .

<http://www.molmod.info/semantics/pims-ii.ttl#directlyPrecedesStep> a owl:ObjectProperty ;
    rdfs:label "directlyPrecedesStep"@en ;
    rdfs:comment "(x directlyPrecedesStep y) means that x and y are processes such that y can commence when x (and possibly other steps that also directly precede y) has finished"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasDirectCausalConnectionWith>,
        <http://www.molmod.info/semantics/pims-ii.ttl#precedesStep> ;
    skos:altLabel "\\\\ddot\\\\hookrightarrow"@en ;
    skos:scopeNote "(x directlyPrecedesStep y) implies that there is a direct causal connection between x and y"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#doesNotTemporallyOverlapWith> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "doesNotTemporallyOverlapWith"@en ;
    rdfs:comment "(x doesNotTemporallyOverlapWith y) is the negation of (x temporallyOverlapsWith y); i.e., there is no temporal overlap between x and y"@en ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#doesNotOverlapWith> ;
    skos:altLabel "\\\\lnot(\\\\equiv_t\\\\dot{P}^-\\\\dot{P})"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#hasSubjectMatter> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasSubjectMatter"@en ;
    rdfs:comment "(x hasSubjectMatter y) means that x is a proposition or articulation that addresses the topic or sum (i.e., plurality) of topics y, i.e., that has y as its subject matter"@en ;
    rdfs:range [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Topical> <http://www.molmod.info/semantics/pims-ii.ttl#TopicalSum> ) ] ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isAbout> ;
    skos:altLabel "A"@en ;
    skos:scopeNote "following Yablo, there is such a thing as *the* subject matter of something, in other words, hasSubjectMatter is a functional property"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isAntecedentWithin> a owl:ObjectProperty ;
    rdfs:label "isAntecedentWithin"@en ;
    rdfs:comment "(x isAntecedentWithin y) means that x is the antecedent from the rule y"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Rule> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isAssertedIn> a owl:ObjectProperty ;
    rdfs:label "isAssertedIn"@en ;
    rdfs:comment "(x isAssertedIn y) means that x is a claim that is affirmatively expressed/stated/uttered in the expressive act y (by its speaker)"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Claim> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#ExpressiveAct> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isExpressedIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isAssessmentFor> a owl:ObjectProperty ;
    rdfs:label "isAssessmentFor"@en ;
    rdfs:comment "(g isAssessmentFor y) means that g is a ground for the cognitive step y, explaining how y is grounded in a way that provides a proposition on its validity, accuracy, and/or reliability, relating it to that of the previous step that directly grounds y"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assessment> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundFor> .

<http://www.molmod.info/semantics/pims-ii.ttl#isAssignmentFor> a owl:ObjectProperty ;
    rdfs:label "isAssignmentFor"@en ;
    rdfs:comment "(d isAssignmentFor o) means that d: x = y is an assignment that refers to o"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isAbout> ;
    skos:altLabel "\\\\hat{A}_D"@en ;
    skos:example "e.g., x may be thermodynamic temperature, y may be a temperature value, and o may be an object of which the temperature has been measured"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isClaimOf> a owl:ObjectProperty ;
    rdfs:label "isClaimOf"@en ;
    rdfs:comment "(x isClaimOf y) means that the x is a proposition that has some kind of belief-like or knowledge-like epistemic status for the intelligent agent y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Claim> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#IntelligentAgent> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ;
    skos:scopeNote "the agent y explicitly stores x, hence requiring spatiotemporal overlap between x and y"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isConsequentWithin> a owl:ObjectProperty ;
    rdfs:label "isConsequentWithin"@en ;
    rdfs:comment "(x isConsequentWithin y) means that x is a consequent from the rule y"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Rule> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isContextOfRelation> a owl:ObjectProperty ;
    rdfs:label "isContextOfRelation"@en ;
    rdfs:comment "(x isContextOfRelation y) means that x is an IRI for the modal context of qualified possibility/necessity in the relative modal IRI y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#ContextualIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#QualifiedModalIRI> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isContextWithinLaw> a owl:ObjectProperty ;
    rdfs:label "isContextWithinLaw"@en ;
    rdfs:comment "(x isContextWithinLaw y) means that x is an IRI for the modal context of relatively necessary implication in the relative law y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#ContextualIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#QualifiedLaw> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isDesignParameterWithin> a owl:ObjectProperty ;
    rdfs:label "isDesignParameterWithin"@en ;
    rdfs:comment "(x isDesignParameterWithin y) == x is one of the parameters that make up the design space considered in the optimization problem y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#OptimizationProblem> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isDuplicateIn> a owl:ObjectProperty ;
    rdfs:label "isDuplicateIn"@en ;
    rdfs:comment "(x isDuplicateIn y) == y is a duplication step where x is the output (duplicate), i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Duplication> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingOutputIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isEvaluatorIn> a owl:ObjectProperty ;
    rdfs:label "isEvaluatorIn"@en ;
    rdfs:comment "(x isEvaluatorIn y) means that y is an evaluation and x is the interpreter in it"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#GoalDirectedAgent>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Evaluation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpreterIn> ;
    skos:altLabel "\\\\ddot{P}_e"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isExaminationOutcomeIn> a owl:ObjectProperty ;
    rdfs:label "isExaminationOutcomeIn"@en ;
    rdfs:comment "(x isExaminationOutcomeIn y) == y is an examination where x is the examination outcome, i.e., the third element (e.g., yes the object agrees with the legisign, or it does so under this or that condition, etc.)"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Examination> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObservationOutcomeIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isExaminedIn> a owl:ObjectProperty ;
    rdfs:label "isExaminedIn"@en ;
    rdfs:comment "(x isExaminedIn y) == y is an examination where x acts as the examined object, i.e., the second element, for which it is assessed to what extent (in which way, under what additional conditions, etc.) it conforms with the legisign"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Examination> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObservedIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isExpressedBy> a owl:ObjectProperty ;
    rdfs:label "isExpressedBy"@en ;
    rdfs:comment "(x isExpressedBy y) means that x is expressed/stated/uttered by the interlocutor y; n.b., this does not necessarily mean that y affirms x (for that, use the subproperty isAssertedBy)"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isExpressedIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSpeakerIn> ] ) ;
    skos:altLabel "\\\\dot{B}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isInitialStepIn> a owl:ObjectProperty ;
    rdfs:label "isInitialStepIn"@en ;
    rdfs:comment "(x isInitialStepIn y) means that y is a step in x (i.e., a subprocess of x) that is not preceded by any other step"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isStepIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isLegisignIn> a owl:ObjectProperty ;
    rdfs:label "isLegisignIn"@en ;
    rdfs:comment "(x isLegisignIn y) == y is an examination where x is applied to an object as a legisign, i.e., the first element, specifying patterns or rules the compliance with which is being assessed"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Examination> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObservationInputIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isLiterally> a owl:DatatypeProperty ;
    rdfs:label "isLiterally"@en ;
    rdfs:comment "points to the expression of a collective literal as an RDFS literal (e.g., xs:string or xs:decimal)"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#CollectiveLiteral> .

<http://www.molmod.info/semantics/pims-ii.ttl#isMagnitudeOf> a owl:ObjectProperty ;
    rdfs:label "isMagnitudeOf"@en ;
    rdfs:comment "(x isMagnitudeOf y) means that x is the numerical magnitude of y, e.g., in 200 kPa, x would be 200"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Number> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isMeasuredObjectIn> a owl:ObjectProperty ;
    rdfs:label "isMeasuredObjectIn"@en ;
    rdfs:comment "(x isMeasuredObjectIn y) == y is a measurement where x acts as the object, i.e., the second element, that is subject to the measurement and for which a property is determined"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Measurement> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObservedIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isMeasurementInputIn> a owl:ObjectProperty ;
    rdfs:label "isMeasurementInputIn"@en ;
    rdfs:comment "(x isMeasurementInputIn y) == y is a measurement where x serves as the input (sign), i.e., the first element, constituting the precondition in terms of available information and similar items"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Measurement> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObservationInputIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isMeasurementOutcomeIn> a owl:ObjectProperty ;
    rdfs:label "isMeasurementOutcomeIn"@en ;
    rdfs:comment "(x isMeasurementOutcomeIn y) == y is a measurement where x is the measurement outcome, i.e., the third element (e.g., the value that is determined for the considered property of the measured object, the measurement error, and any other outcome)"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Measurement> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObservationOutcomeIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isModelledIn> a owl:ObjectProperty ;
    rdfs:label "isModelledIn"@en ;
    rdfs:comment "(x isModelledIn y) == y is a modelling (model construction or parameterization) step where x acts as the modelled object (system, substance, process, or similar), i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Modelling> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isModellingInputIn> a owl:ObjectProperty ;
    rdfs:label "isModellingInputIn"@en ;
    rdfs:comment "(x isModellingInputIn y) == y is a modelling (model construction or parameterization) step where x is the input (previous or unparameterized model, knowledge about the modelled system, etc.), i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Modelling> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isModellingOutputIn> a owl:ObjectProperty ;
    rdfs:label "isModellingOutputIn"@en ;
    rdfs:comment "(x isModellingOutputIn y) == y is a modelling (model construction or parameterization) step where x is the modelling output (e.g., a parameterized or improved model), i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Modelling> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectInDuplication> a owl:ObjectProperty ;
    rdfs:label "isObjectInDuplication"@en ;
    rdfs:comment "(x isObjectInDuplication y) == y is a duplication step where x is the object that the original and the duplicate both represent, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Duplication> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInformationProcessing> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectInOptimization> a owl:ObjectProperty ;
    rdfs:label "isObjectInOptimization"@en ;
    rdfs:comment "(x isObjectInOptimization y) == y is an optimization where x is that which the optimization is ultimately about, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Optimization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectInSelection> a owl:ObjectProperty ;
    rdfs:label "isObjectInSelection"@en ;
    rdfs:comment "(x isObjectInSelection y) == y is a selection where x is the object that the input and the output both represent, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Selection> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInformationProcessing> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectOfApplicationIn> a owl:ObjectProperty ;
    rdfs:label "isObjectOfApplicationIn"@en ;
    rdfs:comment "(x isObjectOfApplicationIn y) == y is an investigation-setup action where x acts as the object of application (e.g., the system to which a use case refers), i.e., the first element; n.b., there needs to be a causal connection between the object of application and the object of investigation"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#InvestigationSetup> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectOfInvestigationIn> a owl:ObjectProperty ;
    rdfs:label "isObjectOfInvestigationIn"@en ;
    rdfs:comment "(x isObjectOfInvestigationIn y) == y is an investigation-setup action where x acts as the object of investigation (e.g., the item subject to an experiment or a simulated process or system), i.e., as the third element; n.b., there needs to be a causal connection between the object of application and the object of investigation"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#InvestigationSetup> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectWithinTriple> a owl:ObjectProperty ;
    rdfs:label "isObjectWithinTriple"@en ;
    rdfs:comment "(x isObjectWithinTriple y) means that y is a subject-predicate-object triple wherein x is the IRI of the object"^^xsd:string ;
    rdfs:domain [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#IndividualIRI> <http://www.molmod.info/semantics/pims-ii.ttl#ConceptualIRI> ) ] ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Triple> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isOptimizationOutputIn> a owl:ObjectProperty ;
    rdfs:label "isOptimizationOutputIn"@en ;
    rdfs:comment "(x isOptimizationOutputIn y) == y is an optimization where x is the optimization output, i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Optimization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isOptimizationProblemIn> a owl:ObjectProperty ;
    rdfs:label "isOptimizationProblemIn"@en ;
    rdfs:comment "(x isOptimizationProblemIn y) == y is an optimization where x is the optimization problem, i.e., the first element."@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#OptimizationProblem> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Optimization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isAimIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isSignInInterpretation> ;
    skos:scopeNote "In (x isOptimizationProblemIn y), x is the aim/intention pursued by carrying out the optimization process y."@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isOriginalIn> a owl:ObjectProperty ;
    rdfs:label "isOriginalIn"@en ;
    rdfs:comment "(x isOriginalIn y) == y is a duplication step where x is the input (original version), i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Duplication> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingInputIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isOrthodataWithin> a owl:ObjectProperty ;
    rdfs:label "isOrthodataWithin"@en ;
    rdfs:comment "(x isOrthodataWithin y) means that x articulates a substantial aspect of either the antecedent or the consequent side of the rule y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Rule> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ;
    skos:altLabel "\\\\v{C}_\\\\perp"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isPerformanceMeasureOf> a owl:ObjectProperty ;
    rdfs:label "isPerformanceMeasureOf"@en ;
    rdfs:comment "(x isPerformanceMeasureOf y) means that x is the single/unique performance measure of the rational agent y."@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Property> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#RationalAgent> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
    skos:scopeNote "This does not require the agent to be aware of its performance measure or to somehow contain it or an internal representation of it."@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isPredicateWithinTriple> a owl:ObjectProperty ;
    rdfs:label "isPredicateWithinTriple"@en ;
    rdfs:comment "(x isPredicateWithinTriple y) means that y is a subject-predicate-object triple wherein x is the IRI of the predicate"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Triple> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInPlanning> a owl:ObjectProperty ;
    rdfs:label "isResolutionInPlanning"@en ;
    rdfs:comment "(x isResolutionInPlanning y) == y is a telesis carried out in advance of potentially undertaking an action, where x is the planning outcome, i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Planning> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInPerception>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInTelesis> .

<http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInSteering> a owl:ObjectProperty ;
    rdfs:label "isResolutionInSteering"@en ;
    rdfs:comment "(x isResolutionInSteering y) == y is a steering operation (reflection in actu) where x is the resolution, i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Steering> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInPerception>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInTelesis> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSignInInvestigation> a owl:ObjectProperty ;
    rdfs:label "isSignInInvestigation"@en ;
    rdfs:comment "(x isSignInInvestigation y) == y is an investigation-setup action where x acts as a representamen, i.e., the second element, both for the object of application (to which it is initially applied) and the object of investigation (to which it is reassigned such that the investigation can take place)"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#InvestigationSetup> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSimulatedIn> a owl:ObjectProperty ;
    rdfs:label "isSimulatedIn"@en ;
    rdfs:comment "(x isSimulatedIn y) == y is a simulation where x acts as the simulated object (system, substance, process, or similar), i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Simulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSimulationInputIn> a owl:ObjectProperty ;
    rdfs:label "isSimulationInputIn"@en ;
    rdfs:comment "(x isSimulationInputIn y) == y is a simulation where x is the simulation input (model, etc.), i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Simulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSimulationOutputIn> a owl:ObjectProperty ;
    rdfs:label "isSimulationOutputIn"@en ;
    rdfs:comment "(x isSimulationOutputIn y) == y is a simulation where x is the simulation output (computed property, higher-level model, or similar), i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Simulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSituationInPlanning> a owl:ObjectProperty ;
    rdfs:label "isSituationInPlanning"@en ;
    rdfs:comment "(x isSituationInPlanning y) == y is a telesis carried out in advance of potentially undertaking an action, where x is the perceived present situation, i.e., the second element, against which the telos is evaluated"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Planning> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInTelesis>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isPerceivedIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSituationInUndertaking> a owl:ObjectProperty ;
    rdfs:label "isSituationInUndertaking"@en ;
    rdfs:comment "(x isSituationInUndertaking y) == y is an undertaking wherein x is the pre-existing situation, i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Undertaking> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSpatiotemporallyDisconnectedFrom> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "isSpatiotemporallyDisconnectedFrom"@en ;
    rdfs:comment "(x isSpatiotemporallyDisconnectedFrom y) is the negation of (x isSpatiotemporallyConnectedWith y); i.e., to go from any point in x to any point in y, it is necessary to leave the fusion (x U y)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#doesNotOverlapWith> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSubjectWithinTriple> a owl:ObjectProperty ;
    rdfs:label "isSubjectWithinTriple"@en ;
    rdfs:comment "(x isSubjectWithinTriple y) means that y is a subject-predicate-object triple wherein x is the IRI of the subject"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#IndividualIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Triple> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isTelosInPlanning> a owl:ObjectProperty ;
    rdfs:label "isTelosInPlanning"@en ;
    rdfs:comment "(x isTelosInPlanning y) == y is a telesis carried out in advance of potentially undertaking an action, where x acts as the telos (initial guiding objective), i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Planning> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInPerception>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isTelosIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isTelosInValidation> a owl:ObjectProperty ;
    rdfs:label "Validation"@en ;
    rdfs:comment "(x isTelosInValidation y) means that y is a validation where x acts as the telos (initial guiding objective), i.e., the first element"@en ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Validation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isTelosInEvaluation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isTemporallyIncludedIn> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "isTemporallyIncludedIn"@en ;
    rdfs:comment "(x isTemporallyIncludedIn y) means that the temporal extension of x is a proper part of the temporal extension of y"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#temporallyOverlapsWith> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#temporallyCoextendsWith> <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> <http://www.molmod.info/semantics/pims-ii.ttl#temporallyCoextendsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#isTerminalStepIn> a owl:ObjectProperty ;
    rdfs:label "isTerminalStepIn"@en ;
    rdfs:comment "(x isTerminalStepIn y) means that y is a step in x (i.e., a subprocess of x) that does not precede any other step"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isStepIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isTopicalFactorIn> a owl:ObjectProperty ;
    rdfs:label "isTopicalFactorIn"@en ;
    rdfs:comment "(x isTopicalFactorIn y) means that x is combined with other subtopics into the topical proposition y, such that x and the other subtopics are not just standing beside each other, but exhibiting some meaningful interaction"@en ;
    rdfs:domain [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Topical> <http://www.molmod.info/semantics/pims-ii.ttl#TopicalSum> ) ] ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#TopicalProduct> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ;
    skos:altLabel "\\\\v{C}_T"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isTopicalSummandIn> a owl:ObjectProperty ;
    rdfs:label "isTopicalSummandIn"@en ;
    rdfs:comment "(x isTopicalSummandIn y) means that x is one of the topics contained in y, a collection of topics that are not immediately closely related to each other"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Topical> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#TopicalSum> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMemberOfPlurality> ;
    skos:altLabel "\\\\lhd_T"@en ;
    skos:scopeNote "If multiple topics are combined in a way that relates them closely to each other, with some meaningful interaction between them, the relation isTopicalFactorIn should be used, and the whole should then be a topical product, not a topical sum" .

<http://www.molmod.info/semantics/pims-ii.ttl#isUnitOf> a owl:ObjectProperty ;
    rdfs:label "isUnitOf"@en ;
    rdfs:comment "(x isUnitOf y) means that x is the unit of y, e.g., in 200 kPa, x would be kPa"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#MeasurementUnit> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ;
    skos:altLabel "\\\\v{C}_u"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isValidatedIn> a owl:ObjectProperty ;
    rdfs:label "isEvaluatedIn"@en ;
    rdfs:comment "(x isValidatedIn y) means that y is a validation where x is the cognitive action undergoing validation, i.e., the second element"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveAction> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Validation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isEvaluatedIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isValueInAssignment> a owl:ObjectProperty ;
    rdfs:label "isValueInAssignment"@en ;
    rdfs:comment "(y isValueInAssignment a) mans that a: x = y is an assignment where the value y is assigned to a variable x"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRightHandSideIn> ;
    skos:altLabel "\\\\ddot{D}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isVariableInAssignment> a owl:ObjectProperty ;
    rdfs:label "isVariableInAssignment"@en ;
    rdfs:comment "(x isVariableInAssignment a) mans that a: x = y is an assignment where a value y is assigned to the variable x"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isLeftHandSideIn> ;
    skos:altLabel "\\\\dot{D}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isVisualizationInputIn> a owl:ObjectProperty ;
    rdfs:label "isVisualizationInputIn"@en ;
    rdfs:comment "(x isVisualizationInputIn y) == y is a visualization process where x is the input (a pre-existing representamen for the visualized object, e.g., a simulation result), i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Visualization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isVisualizationOutputIn> a owl:ObjectProperty ;
    rdfs:label "isVisualizationOutputIn"@en ;
    rdfs:comment "(x isVisualizationOutputIn y) == y is a visualization where x is the visualization output, i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Visualization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isVisualizedObjectIn> a owl:ObjectProperty ;
    rdfs:label "isVisualizedObjectIn"@en ;
    rdfs:comment "(x isVisualizedObjectIn y) == y is a visualization process wherein x is the visualized object, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Visualization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInterpretation> .

