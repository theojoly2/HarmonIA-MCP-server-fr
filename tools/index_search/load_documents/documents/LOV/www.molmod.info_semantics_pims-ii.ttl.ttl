    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRHPHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRIP> <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRIPIR> a owl:ObjectProperty ;
    rdfs:label "msIRIPIR"@en ;
    rdfs:comment "chain relation msIRIP o isRepresentamenFor" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIPIR> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRHPHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRIP> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRIRHP> a owl:ObjectProperty ;
    rdfs:label "msIRIRHP"@en ;
    rdfs:comment "chain relation msIRIR o hasProperPart" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRIRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIPHRHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRIR> <http://www.molmod.info/semantics/pims-ii.ttl#hasProperPart> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRIRHR> a owl:ObjectProperty ;
    rdfs:label "msIRIRHR"@en ;
    rdfs:comment "chain relation isRepresentamenFor o sharesReferentWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRHRHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> <http://www.molmod.info/semantics/pims-ii.ttl#sharesReferentWith> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRIR> <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRIRIP> a owl:ObjectProperty ;
    rdfs:label "msIRIRIP"@en ;
    rdfs:comment "chain relation msIRIR o isProperPartOf" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRIRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPHRHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRIR> <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRIRIR> a owl:ObjectProperty ;
    rdfs:label "msIRIRIR"@en ;
    rdfs:comment "chain relation msIRIR o isRepresentamenFor" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRHRHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRIR> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#providesJustification> a owl:ObjectProperty ;
    rdfs:label "providesJustification"@en ;
    rdfs:comment "(x providesJustification y) means that x is about some cognition z, providing a justification of it by referring to y, i.e., a grounding chain that establishes the epistemic status of z; thereby, x does not only affirm z, but also its grounding chain y"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GroundingChain> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#affirmsCognition> .

<http://www.molmod.info/semantics/pims-ii.ttl#underlies> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "underlies"@en ;
    rdfs:comment "the relation 'underlies' is the transitive closure of the relation 'isConstitutiveOf'"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasCausalConnectionWith> .

<http://www.molmod.info/semantics/pims-ii.ttl#CognitiveWorkflow> a owl:Class ;
    rdfs:label "CognitiveWorkflow"@en ;
    rdfs:comment "Cognitive workflow, i.e., a purposefully conducted cognitive chain"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveAction>,
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveChain>,
        <http://www.molmod.info/semantics/pims-ii.ttl#PurposefulAction> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveChain> <http://www.molmod.info/semantics/pims-ii.ttl#PurposefulAction> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#Communication> a owl:Class ;
    rdfs:label "Communication"@en ;
    rdfs:comment "Communication, i.e., a cognitive process wherein multiple interlocutors engage in an exchange with another; a communication involves at least one expressive act (with a well defined role, i.e. in terms of participation)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#ExpressiveAct> ],
        [ a owl:Restriction ;
            owl:minCardinality 2 ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterlocutorIn> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> .

<http://www.molmod.info/semantics/pims-ii.ttl#GoalOrientedAgent> a owl:Class ;
    rdfs:label "GoalOrientedAgent"@en ;
    rdfs:comment "Goal-oriented agent, i.e., an agent that exhibits the tendency 'to achieve a certain state of the world' (Conte, doi:10.1007/978-1-4614-1800-9_158, 2009)"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Agent> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGoalOf> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ] ;
    skos:scopeNote "A goal of a goal-oriented agent is a descriptor/representamen for that state of the world, and it is also a descriptor/representament for the agent itself. Goal orientation can emerge by a multitude of mechanisms, including natural selection. It does *not* require the agent to be consciously aware of its goals. In PIMS-II, goal orientation is denoted by the relation isGoalOf (which does not require an internal mental representation of the goal), whereas conscious goal directedness is denoted by the relation isGoalFor."@en .

<http://www.molmod.info/semantics/pims-ii.ttl#GroundedCognition> a owl:Class ;
    rdfs:label "GroundedCognition"@en ;
    rdfs:comment "Grounded cognition, i.e., a cognition that is logically preceded by a presupposition such that there is a grounding chain establishing its epistemic status as a grounded cognition"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isJustificationFor> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#GroundingChain> ],
        [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Presupposition> [ a owl:Restriction ;
                        owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#logicallyPrecedes> ] ;
                        owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Presupposition> ] ) ] .

<http://www.molmod.info/semantics/pims-ii.ttl#KnowledgeBase> a owl:Class ;
    rdfs:label "KnowledgeBase"@en ;
    rdfs:comment "Knowledge base, i.e., an interlocutor that makes a consistent set of claims and will respond consistently if queried; n.b., that propositional content which 'isHeldBy' a knowledge base needs to be invariable over the whole 4D spacetime in which the knowledge base exist. Since technical knowledge bases do happen to change their propositional content over time, it may make sense either to define proper parts with a short temporal extension or to take care with what a knowledge base is stated to hold. Other kinds of propositional content (varying over time or depending on who makes the query) can be said to be asserted rather than held by the knowledge base."^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> .

<http://www.molmod.info/semantics/pims-ii.ttl#Law> a owl:Class ;
    rdfs:label "Law"@en ;
    rdfs:comment "Law, i.e., a proposition consisting of an antecedent and one or multiple consequent(s) such that the antecedent is stated to necessarily imply the consequent(s)"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Rule> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#AbsoluteLaw> <http://www.molmod.info/semantics/pims-ii.ttl#QualifiedLaw> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#ModelPropertyClaim> a owl:Class ;
    rdfs:label "PropertyClaim"@en ;
    rdfs:comment "Model property claim (MPC), i.e., a PC concerning a property of a model"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#PropertyClaim> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#AbstractModelPropertyClaim> <http://www.molmod.info/semantics/pims-ii.ttl#ConcreteModelPropertyClaim> ) ;
    skos:altLabel "MPC"@en ;
    skos:scopeNote "Claim expressed through a PC: 'From data δ, property p of object o under conditions c was found by agent a to have the value v'"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Number> a owl:Class ;
    rdfs:label "Number"@en ;
    rdfs:comment "Number, i.e., a lexeme that is numerical in nature, such as the collective containing realizations of 'two', '2', and '2.0'"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Lexeme> .

<http://www.molmod.info/semantics/pims-ii.ttl#ProofBasedValidityClaim> a owl:Class ;
    rdfs:label "ProofBasedValidityClaim"@en ;
    rdfs:comment "Proof-based validity claim (PVC), i.e., a validity claim obtained by formal verification, i.e., by deductive logical and mathematical reasoning"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ValidityClaim> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#ReproducibilityClaim>,
        <http://www.molmod.info/semantics/pims-ii.ttl#TestBasedValidityClaim> ;
    skos:altLabel "PVC"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#TestBasedValidityClaim> a owl:Class ;
    rdfs:label "TestBasedValidityClaim"@en ;
    rdfs:comment "Test-based validity claim (TVC), i.e., a validity claim obtained from validation or testing"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ValidityClaim> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#ProofBasedValidityClaim>,
        <http://www.molmod.info/semantics/pims-ii.ttl#ReproducibilityClaim> ;
    skos:altLabel "TVC"@en ;
    skos:scopeNote "Validation and testing are an integral part of the activity by which the validated knowledge claim and/or the associated data are produced, as opposed to reproducibility studies which are done subsequently in a separate activity"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#changesReferentIn> a owl:ObjectProperty ;
    rdfs:label "changesReferentIn"@en ;
    rdfs:comment "(x changesReferentIn y) == y is a semantic change where x acts as the representamen, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#SemanticChange> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isSecondElementIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#directlyGrounds> a owl:ObjectProperty ;
    rdfs:label "directlyGrounds"@en ;
    rdfs:comment "(x directlyGrounds y) == x is the cognitive step (or basic ground) that directly precedes y logically, such that a dyadic representation relation from y is taken over from x (or assumed to be grounded a priori due to x)"^^xsd:string ;
    rdfs:domain [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#TriadicCognition> <http://www.molmod.info/semantics/pims-ii.ttl#Presupposition> ) ] ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#directlyPrecedesCognitiveStep>,
        <http://www.molmod.info/semantics/pims-ii.ttl#logicallyPrecedes> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isGroundingStepIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundedStepIn> ] ) ;
    skos:altLabel "\\\\hookrightarrow"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#directlyPrecedesCognitiveStep> a owl:ObjectProperty ;
    rdfs:label "directlyPrecedesCognitiveStep"@en ;
    rdfs:comment "(x directlyPrecedesCognitiveStep y) == x is the cognitive step (or basic ground) that directly precedes y logically; typically, this means that y takes over a dyadic representation relation from x"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#directlyPrecedesStep> .

<http://www.molmod.info/semantics/pims-ii.ttl#doesNotOverlapWith> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "doesNotOverlapWith"@en ;
    rdfs:comment "(x doesNotOverlapWith y) is the negation of (x overlapsWith y); i.e., the spatiotemporal intersection of x and y is empty"@en ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    skos:altLabel "\\\\lnot(\\\\dot{P}^-\\\\dot{P})"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#groundsNextStepIn> a owl:ObjectProperty ;
    rdfs:label "groundsNextStepIn"@en ;
    rdfs:comment "(x groundsNextStepIn y) == y is a grounding interpretation where x is the third element, i.e., a ground for the subsequent cognitive step; thereby, x also serves as a ground for y itself"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Ground> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GroundingInterpretation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundFor>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#groundsPresentStepIn> a owl:ObjectProperty ;
    rdfs:label "groundsPresentStepIn"@en ;
    rdfs:comment "(x groundsPresentStepIn y) == y is a grounding interpretation where x is the first element, i.e., a ground for the considered cognitive step"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Ground> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GroundingInterpretation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#hasNecessityMode> a owl:ObjectProperty ;
    rdfs:label "hasNecessityMode"@en ;
    rdfs:comment "(x hasNecessityMode y) means that x is a relational IRI and y is a modal IRI for 'necessarily x'"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#ModalIRI> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#hasPossibilityMode> a owl:ObjectProperty ;
    rdfs:label "hasPossibilityMode"@en ;
    rdfs:comment "(x hasPossibilityMode y) means that x is a relational IRI and y is a modal IRI for 'possibly x'"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#ModalIRI> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isAccumulationInputIn> a owl:ObjectProperty ;
    rdfs:label "isAccumulationInputIn"@en ;
    rdfs:comment "(x isAccumulationInputIn y) == y is an accumulation where x is the input (initially given information), i.e., the first element; n.b., in an accumulation, the input needs to be constitutive of the output"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Accumulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingInputIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isActionInSteering> a owl:ObjectProperty ;
    rdfs:label "isActionInSteering"@en ;
    rdfs:comment "(x isActionInSteering y) == y is a steering operation (reflection in actu) where x is an ongoing action, i.e., the second element, against which the telos is evaluated"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Action> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Steering> ;
    rdfs:subPropertyOf [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isProperParticipantIn> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInTelesis>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isPerceivedIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isActionInUndertaking> a owl:ObjectProperty ;
    rdfs:label "isActionInUndertaking"@en ;
    rdfs:comment "(x isActionInUndertaking y) == y is an undertaking where x is the action that is undertaken, i.e., the third element"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Action> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Undertaking> ;
    rdfs:subPropertyOf [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleValueFor> a owl:ObjectProperty ;
    rdfs:label "isAdmissibleValueFor"@en ;
    rdfs:comment "(x isAdmissibleValueFor y) means that y is a term that could in principle evaluate to the value x; subsumption under msIPIRIR is explained as follows: There is a sign z for the term y (where z is the range of admissible values of y), for which in turn there is another sign z' (where z' lists members of z, explicitly including x) of which x is a part"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Term> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msIPIRIR> .

<http://www.molmod.info/semantics/pims-ii.ttl#isEvaluatedIn> a owl:ObjectProperty ;
    rdfs:label "isEvaluatedIn"@en ;
    rdfs:comment "(x isEvaluatedIn y) == y is an evaluation (reflection ex post) where x is the action undergoing evaluation, i.e., the second element; n.b., the action needs to temporally precede the evaluation"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Action> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Evaluation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInterpretation>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInTelesis>,
        <http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> .

<http://www.molmod.info/semantics/pims-ii.ttl#isEvaluationOutcomeIn> a owl:ObjectProperty ;
    rdfs:label "isEvaluationOutcomeIn"@en ;
    rdfs:comment "(x isEvaluationOutcomeIn y) == y is a an evaluation (reflection ex post) where x is the resolution (evaluation outcome), i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Evaluation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInInterpretation>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInTelesis> .

<http://www.molmod.info/semantics/pims-ii.ttl#isExpressedIn> a owl:ObjectProperty ;
    rdfs:label "isExpressedIn"@en ;
    rdfs:comment "(x isExpressedIn y) means that x is expressed/stated/uttered in the expressive act y (by its speaker), possibly but not necessarily in an affirmative way"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#ExpressiveAct> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantInCognition> .

<http://www.molmod.info/semantics/pims-ii.ttl#isFirstInDyad> a owl:ObjectProperty ;
    rdfs:label "isFirstInDyad"@en ;
    rdfs:comment "(x isFirstInDyad d) means that x is the first element of the dyad d"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Dyad> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ;
    skos:altLabel "\\\\dot{E}_D"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isGoalFor> a owl:ObjectProperty ;
    rdfs:label "isGoalFor"@en ;
    rdfs:comment "(x isGoalFor y) means that to the goal-directed agent y, the telos x represents something that is to be reached."@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GoalDirectedAgent> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isGoalOf>,
        <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInUndertaking> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAgentIn> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isAimIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAgentIn> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isTelosInSteering> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAgentIn> ] ) ;
    skos:altLabel "\\\\dot{G}"@en ;
    skos:example "In (x isGoalFor y), if the agent x wants to go to Paris, y is not physically the city of Paris as a 4D object, but rather the associated intention, i.e., a mental or textual representation of the agent achieving the objective and reaching Paris."@en ;
    skos:scopeNote "A goal is both a representamen for a state of affairs desired by the agent and a representamen for the agent itself."@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isInterpreterIn> a owl:ObjectProperty ;
    rdfs:label "isInterpreterIn"@en ;
    rdfs:comment "(x isInterpreterIn y) means that x is the (unique) agent who conducts/undertakes the cognitive action y"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Agent> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveAction> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isAgentIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantInCognition> .

<http://www.molmod.info/semantics/pims-ii.ttl#isJustificationFor> a owl:ObjectProperty ;
    rdfs:label "isJustificationFor"@en ;
    rdfs:comment "(x isJustificationFor y) means that x is a grounding chain that provides epsitemic grounding for the cognition y, which thereby becomes a grounded cognition"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#GroundingChain> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GroundedCognition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> .

<http://www.molmod.info/semantics/pims-ii.ttl#isLeftHandSideIn> a owl:ObjectProperty ;
    rdfs:label "isLeftHandSideIn"@en ;
    rdfs:comment "(x isLeftHandSideIn a) mans that a: x = y is an equality articulation with the term x as its left-hand side"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Term> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#EqualityArticulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isFirstInDyad> ;
    skos:altLabel "\\\\dot{E}_="@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isMemberOfStructure> a owl:ObjectProperty ;
    rdfs:label "isMemberOfStructure"@en ;
    rdfs:comment "(x isMemberOfStructure y) means that x is a semiotic member of the structure y, and that it participates in semiosis differently from all of its co-members x', x'', ... of the structure y"^^xsd:string ;
    rdfs:domain [ owl:complementOf <http://www.molmod.info/semantics/pims-ii.ttl#Structure> ] ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Structure> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> ;
    skos:altLabel "\\\\prec"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isMereologicallyConstitutiveOf> a owl:ObjectProperty ;
    rdfs:label "isMereologicallyConstitutiveOf"@en ;
    rdfs:comment "(x isMereologicallyConstitutiveOf y) means that x is constitutive of y by virtue of the way in which it is a proper part of y in 4D spacetime, e.g., as a necessary component of an item that was designed for a certain purpose"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isConstitutiveOf>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isMereotopologicalMemberOf> a owl:ObjectProperty ;
    rdfs:label "isMereotopologicalMemberOf"@en ;
    rdfs:comment "(x isMereotopologicalMemberOf y) means that x is one out of several mereotopologically connected components of y"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Item> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#MereotopologicalCollective> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMemberOf>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isMereologicallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isNameFor> a owl:ObjectProperty ;
    rdfs:label "isNameFor"@en ;
    rdfs:comment "(x isNameFor y), to be applied in the frequent special case where x is represented by a name for x, i.e., where social convention has established y as a rigid designator for x"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Name> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> .

<http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentIn> a owl:ObjectProperty ;
    rdfs:label "isNewReferentIn"@en ;
    rdfs:comment "(x isNewReferentIn y) == y is a semantic change where x acts as the new referent, i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#SemanticChange> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isReferentIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isThirdElementIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInPartToWhole> a owl:ObjectProperty ;
    rdfs:label "isNewReferentInPartToWhole"@en ;
    rdfs:comment "(x isNewReferentInPartToWhole y) == y is a part-to-whole synecdoche where x acts as the new referent (the whole), i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#PartToWhole> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInSynecdoche> .

<http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInWholeToPart> a owl:ObjectProperty ;
    rdfs:label "isNewReferentInWholeToPart"@en ;
    rdfs:comment "(x isNewReferentInWholeToPart y) == y is a whole-to-part synecdoche where x acts as the new referent (the part), i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#WholeToPart> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInSynecdoche> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectInAccumulation> a owl:ObjectProperty ;
    rdfs:label "isObjectInAccumulation"@en ;
    rdfs:comment "(x isObjectInAccumulation y) == y is an accumulation where x is the object that the input and the output both represent, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Accumulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInformationProcessing> .

<http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentIn> a owl:ObjectProperty ;
    rdfs:label "isOldReferentIn"@en ;
    rdfs:comment "(x isOldReferentIn y) == y is a semantic change where x acts as the old referent, i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#SemanticChange> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isFirstElementIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isReferentIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInPartToWhole> a owl:ObjectProperty ;
    rdfs:label "isOldReferentInPartToWhole"@en ;
    rdfs:comment "(x isOldReferentInPartToWhole y) == y is a part-to-whole synecdoche where x acts as the old referent (the part), i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#PartToWhole> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInSynecdoche> .

<http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInWholeToPart> a owl:ObjectProperty ;
    rdfs:label "isOldReferentInWholeToPart"@en ;
    rdfs:comment "(x isOldReferentInWholeToPart y) == y is a whole-to-part synecdoche where x acts as the old referent (the whole), i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#WholeToPart> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInSynecdoche> .

<http://www.molmod.info/semantics/pims-ii.ttl#isProperParticipantIn> a owl:ObjectProperty ;
    rdfs:label "isProperParticipantIn"@en ;
    rdfs:comment "(x isProperParticipantIn y) is the conjunction of (x isProperPartOf y) and (x isParticipantIn y)"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isRelatedToList> a owl:ObjectProperty ;
    rdfs:label "isRelatedToList"@en ;
    rdfs:comment "Top property for multi-argument predicates that are implemented as 'x isRelatedToList (y1 y2 ... yn)', i.e., such that the object is an rdf:List"@en ;
    rdfs:range rdf:List .

<http://www.molmod.info/semantics/pims-ii.ttl#isRightHandSideIn> a owl:ObjectProperty ;
    rdfs:label "isRightHandSideIn"@en ;
    rdfs:comment "(y isRightHandSideIn a) mans that a: x = y is an equality articulation with the term y as its right-hand side"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Term> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#EqualityArticulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSecondInDyad> ;
    skos:altLabel "\\\\ddot{E}_="@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isSecondInDyad> a owl:ObjectProperty ;
    rdfs:label "isSecondInDyad"@en ;
    rdfs:comment "(y isSecondInDyad d) means that y is the second element of the dyad d"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Dyad> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ;
    skos:altLabel "\\\\ddot{E}_D"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isSelectionInputIn> a owl:ObjectProperty ;
    rdfs:label "isSelectionInputIn"@en ;
    rdfs:comment "(x isSelectionInputIn y) == y is a selection where x is the input (initially given information), i.e., the first element; n.b., in a selection, the output needs to be constitutive of the input"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Selection> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingInputIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSelectionOutputIn> a owl:ObjectProperty ;
    rdfs:label "isSelectionOutputIn"@en ;
    rdfs:comment "(x isSelectionOutputIn y) == y is a selection where x is the output (retained information), i.e., the third element; n.b., in a selection, the output needs to be constitutive of the input"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Selection> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingOutputIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isTelosInEvaluation> a owl:ObjectProperty ;
    rdfs:label "isTelosInEvaluation"@en ;
    rdfs:comment "(x isTelosInEvaluation y) == y is an evaluation (reflection ex post) where x acts as the telos (initial guiding objective), i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Evaluation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInInterpretation>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isTelosIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isTemporallyConnectedWith> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty ;
    rdfs:label "isTemporallyConnectedWith"@en ;
    rdfs:comment "(x isTemporallyConnectedWith y) means that there is a point in time where both x and y exist"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#temporallyCoextendsWith> <http://www.molmod.info/semantics/pims-ii.ttl#isSpatiotemporallyConnectedWith> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isSpatiotemporallyConnectedWith> <http://www.molmod.info/semantics/pims-ii.ttl#temporallyCoextendsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#isValidationOutcomeIn> a owl:ObjectProperty ;
    rdfs:label "isValidationOutcomeIn"@en ;
    rdfs:comment "(x isValidationOutcomeIn y) means that x is the validity claim, i.e., the third element, obtained as an interpretant from the validation y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#ValidityClaim> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Validation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isEvaluationOutcomeIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#logicallyPrecedes> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "logicallyPrecedes"@en ;
    rdfs:comment "(x logicallyPrecedes y) means that x and y are cognitive steps that are connected by a cognitive chain, leading from x and y, that does not contain a cognitive rupture"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#precedesStep> ;
    skos:altLabel "\\\\hookrightarrow^+"@en ;
    skos:scopeNote "'logicallyPrecedes' is the transitive closure of 'directlyGrounds'"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#msHRHPIPIR> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "msHRHPIPIR"@en ;
    rdfs:comment "chain relation msHRHP o msIPIR" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#msHRHP> <http://www.molmod.info/semantics/pims-ii.ttl#msIPIR> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHRIRHR> a owl:ObjectProperty ;
    rdfs:label "msHRIRHR"@en ;
    rdfs:comment "chain relation hasRepresentamen o sharesReferentWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRHRIR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> <http://www.molmod.info/semantics/pims-ii.ttl#sharesReferentWith> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#sharesRepresentamenWith> <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIPIRIR> a owl:ObjectProperty ;
    rdfs:label "msIPIRIR"@en ;
    rdfs:comment "chain relation msIPIR o isRepresentamenFor" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRIR> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRHRHP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msIPIR> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIPHR> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "msIRHPIPHR"@en ;
    rdfs:comment "chain relation msIRHP o msIPHR" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRHP> <http://www.molmod.info/semantics/pims-ii.ttl#msIPHR> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRHRIR> a owl:ObjectProperty ;
    rdfs:label "msHRIRHR"@en ;
    rdfs:comment "chain relation sharesReferentWith o isRepresentamenFor" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRIRHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> <http://www.molmod.info/semantics/pims-ii.ttl#sharesRepresentamenWith> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#sharesReferentWith> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#precedesStep> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedesStep"@en ;
    rdfs:comment "'precedesStep' is the transitive closure of 'directlyPrecedesStep'; (x precedesStep y) means that the processes x and y are, possibly indirectly, causally connected such that x needs to be concluded before y can commence"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasCausalConnectionWith>,
        <http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> .

<http://www.molmod.info/semantics/pims-ii.ttl#realizes> a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    rdfs:comment "(x realizes y) means that x, which is not a semiotic collective, is a literal or non-literal realization of the expression y"^^xsd:string ;
    rdfs:domain [ owl:complementOf <http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> ] ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#AbsoluteModalIRI> a owl:Class ;
    rdfs:label "AbsoluteModalIRI"@en ;
    rdfs:comment "Absolute modal IRI, i.e., the IRI of a relation that is defined by absolute necessity or possibility of another relation. Absolute necessity means 'logical or physical necessity', and absolute possibility means 'logical or physical possibility'. Accordingly, absolute modal relations do not require the specification of a modal context, i.e., the frame of reference for understanding what 'necessity' and 'possibility' mean does not need to be specified. "^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ModalIRI> .

<http://www.molmod.info/semantics/pims-ii.ttl#Assignment> a owl:Class ;
    rdfs:label "Assignment"@en ;
    rdfs:comment "Assignment, i.e., an equality articulation by which a value is assigned to a variable with respect to a particular referent (e.g., T = 200 K for substance o as it was measured in a particular cognitive step); therein, T is the variable, related to the assignment by [inverseOf isVariableInAssignment], 200 K is the value, related to the assignment by [inverseOf isValueInAssignment], and o is the referent, related to the assignment by isAssignmentFor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isValueInAssignment> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Value> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isAssignmentFor> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isVariableInAssignment> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#DigitalConventional>,
        <http://www.molmod.info/semantics/pims-ii.ttl#EqualityArticulation> ;
    skos:altLabel "ASG"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Collective> a owl:Class ;
    rdfs:label "Collective"@en ;
    rdfs:comment "Collective, i.e., an object that has multiple items as members"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 2 ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMemberOf> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Object> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMemberOf> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ] ;
    owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#MereotopologicalCollective> <http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#ConceptualIRI> a owl:Class ;
    rdfs:label "ConceptualIRI"@en ;
    rdfs:comment "Conceptual IRI, i.e., the internationalized resource identifier of a concept (i.e., of an owl:Class)"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#IRI> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> .

<http://www.molmod.info/semantics/pims-ii.ttl#DataItem> a owl:Class ;
    rdfs:label "DataItem"@en ;
    rdfs:comment "Data item, i.e., a digital articulation given as a tuple of digital conventionals"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality 2 ;
            owl:onClass <http://www.molmod.info/semantics/pims-ii.ttl#DigitalConventional> ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> ;
    skos:altLabel "DI"@en ;
    skos:example "e.g., a key-value dyad with a left-hand side and a right-hand side"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Duplication> a owl:Class ;
    rdfs:label "Duplication"@en ;
    rdfs:comment "Duplication, i.e., an information-processing step in which the given information is reproduced, copied, converted into a different, but equivalent format, or any similar procedure; e.g., this may be based on a legisign to which the original (sign) and the duplicate (interpretant) jointly conform or on a semiotic collective of which they both semiotic members"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInDuplication> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOriginalIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isDuplicateIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#InformationProcessing> .

<http://www.molmod.info/semantics/pims-ii.ttl#EqualityArticulation> a owl:Class ;
    rdfs:label "EqualityArticulation"@en ;
    rdfs:comment "Equality articulation, i.e., a dyad by which two terms are asserted to be equal or to become equal"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isRightHandSideIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Term> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isLeftHandSideIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Term> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Dyad> ;
    skos:altLabel "EAN"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Examination> a owl:Class ;
    rdfs:label "Examination"@en ;
    rdfs:comment "Examination (by pattern matching & similar), i.e., an observation by which a legisign (specifying patterns or rules) is applied to an examined object, yielding an examination outcome that expresses in what way or to what extent the object matches the legisign"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isExaminedIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isExaminationOutcomeIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isLegisignIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Observation> ;
    skos:altLabel "EXA"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#GroundingChain> a owl:Class ;
    rdfs:label "GroundingChain"@en ;
    rdfs:comment "Grounding chain, i.e., a cognitive chain that establishes epistemic grounding"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#GroundingStep> <http://www.molmod.info/semantics/pims-ii.ttl#Presupposition> ) ] ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isStepInCognitiveChain> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveChain> .

<http://www.molmod.info/semantics/pims-ii.ttl#InvestigationSetup> a owl:Class ;
    rdfs:label "InvestigationSetup"@en ;
    rdfs:comment "Investigation setup, i.e., a metonymization where a sign (e.g., a model and/or open question) that has come up for an 'object of application' (the old referent, e.g., the system to which a use case refers) is reassigned to an 'object of investigation' to which dedicated studies can be applied, such as a system that will be simulated or investigated experimentally; n.b., there needs to be a causal connection between the old and the new referent, i.e., between the object of application and the object of investigation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectOfApplicationIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInInvestigation> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectOfInvestigationIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Metonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#MeasurementUnit> a owl:Class ;
    rdfs:label "MeasurementUnit"@en ;
    rdfs:comment "Measurement unit, i.e., a 'real scalar quantity, defined and adopted by convention' (EMMO, ISO 80000-1)"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Lexeme> .

<http://www.molmod.info/semantics/pims-ii.ttl#MereotopologicalCollective> a owl:Class ;
    rdfs:label "MereotopologicalCollective"@en ;
    rdfs:comment "Mereotopological collective, i.e., a region of spacetime that consists of multiple connected components, which are its mereotopological members"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 2 ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereotopologicalMemberOf> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Collective> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereotopologicalMemberOf> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Item> ] .

<http://www.molmod.info/semantics/pims-ii.ttl#Modelling> a owl:Class ;
    rdfs:label "Modelling"@en ;
    rdfs:comment "Modelling, i.e., an interpretation in which the sign is the basis for the modelling process (e.g., an unparameterized or previously parameterized model, knowledge about the modelled system, etc.), the object is the modelled system, and the interpretant is the modelling output (e.g., a parameterized model)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isModellingInputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isModellingOutputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isModelledIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#Property> a owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:comment "Property, i.e., a variable that is employed for the possible outcome of observations and similar processes (this may include different words used for the same property, in one or multiple languages, and different ways of expressing these words)"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Variable> .

<http://www.molmod.info/semantics/pims-ii.ttl#PropertyClaim> a owl:Class ;
    rdfs:label "PropertyClaim"@en ;
    rdfs:comment "Property claim (PC), i.e., a knowledge claim concerning a property"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#KnowledgeClaim> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#ConceptualKnowledgeClaim> ;
    skos:altLabel "PC"@en ;
    skos:scopeNote "Claim expressed through a PC: 'From data δ, property p of object o under conditions c was found by agent a to have the value v'"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#QualifiedLaw> a owl:Class ;
    rdfs:label "QualifiedLaw"@en ;
    rdfs:comment "Qualified law, i.e., a law where the necessary entailment of the consequent(s) by the antecedent is expressed in terms of qualified necessity, to be understood in terms of its modal context"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Law> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isContextWithinLaw> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#ContextualIRI> ] ;
    skos:altLabel "QL"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Question> a owl:Class ;
    rdfs:label "Question"@en ;
    rdfs:comment "Question, i.e., a topical proposition the semantics/pragmatics of which are of interrogative character"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Topical> ;
    skos:altLabel "QN"@en ;
    skos:scopeNote "A question contains interrogative pronouns or other interrogative elements, such as blank nodes when articulated as a query"@en,
        "Questions are articulated digitally by queries"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Triple> a owl:Class ;
    rdfs:label "Triple"@en ;
    rdfs:comment "Triple, i.e., a subject-predicate-object triple (connected by relations to the IRIs of the subject, predicate, and object)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSubjectWithinTriple> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#IRI> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectWithinTriple> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#IRI> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isPredicateWithinTriple> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#IRI> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#DataItem> .

<http://www.molmod.info/semantics/pims-ii.ttl#Visualization> a owl:Class ;
    rdfs:label "Visualization"@en ;
    rdfs:comment "Visualization, i.e., an interpretation in which the object is the visualized system and the interpretant is a visual representation of the object - the sign is a pre-existing representamen for the same object, e.g., a simulation result"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isVisualizationInputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isVisualizationOutputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isVisualizedObjectIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInSynecdoche> a owl:ObjectProperty ;
    rdfs:label "changesReferentInSynecdoche"@en ;
    rdfs:comment "(x changesReferentInSynecdoche y) == y is a synecdoche where x acts as the representamen, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Synecdoche> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#hasCausalConnectionWith> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "hasCausalConnectionWith"@en ;
    rdfs:comment "'Real causal connection' relation following Peirce, here, given by the transitive closure of 'hasDirectCausalConnectionWith'"@en ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInMetonymization> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInMetonymization> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInMetonymization> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInMetonymization> ] ) ;
    skos:altLabel "\\\\dot{C}^\\\\star"@en ;
    skos:scopeNote "this is to be understood broadly, as in Peirce, and can be a very indirect connection; here, this is relevant as follows: a) in a grounded cognition, there are only dyadic representation relations between representamina and their referents that have a real causal connection with each other; b) in a metonymization, there must be a real causal connection between the old and the new referent"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#hasDirectCausalConnectionWith> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty ;
    rdfs:label "hasDirectCausalConnectionWith"@en ;
    rdfs:comment "Direct causal connection (in a broad sense)"@en ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasCausalConnectionWith> ;
    skos:altLabel "\\\\dot{C}"@en ;
    skos:scopeNote "in particular, x and y are directly causally connected if (x isParticipantIn y), or if x and y are both steps in a process where x directly precedes y; however, spatiotemporal parthood is not enough to justify causal connectedness - x must actually play a role in bringing about y, or vice versa"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isAccumulationOutputIn> a owl:ObjectProperty ;
    rdfs:label "isAccumulationOutputIn"@en ;
    rdfs:comment "(x isAccumulationOutputIn y) == y is an accumulation where x is the output (combined information), i.e., the third element; n.b., in a selection, the input and any additionally included elements need to be constitutive of the output"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Accumulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingOutputIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isAimIn> a owl:ObjectProperty ;
    rdfs:label "isAimIn"@en ;
    rdfs:comment "(x isAimIn y) means that y is a purposeful action, and x is one of the aims followed by the agent of y by undertaking y"@en ;
    rdfs:domain [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isGoalFor> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#GoalDirectedAgent> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Action> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isTelosInSteering> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isActionInSteering> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInUndertaking> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isActionInUndertaking> ] ) ;
    skos:altLabel "R_\\\\alpha"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isAssertedBy> a owl:ObjectProperty ;
    rdfs:label "isAssertedBy"@en ;
    rdfs:comment "(x isAssertedBy y) means that x is a claim that is affirmatively expressed/stated/uttered by the interlocutor y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Claim> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isExpressedBy> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isAssertedIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSpeakerIn> ] ) ;
    skos:altLabel "B"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isConstitutiveOf> a owl:ObjectProperty ;
    rdfs:label "isConstitutiveOf"@en ;
    rdfs:comment "(x isConstitutiveOf y) means that, by virtue of an interaction requiring spatiotemporal overlap, x contributes causally to y fulfilling a certain function, exhibiting certain properties, or relating to other objects in the way it does, thereby creating a direct causal connection between x and y"@en ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasDirectCausalConnectionWith>,
        <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith>,
        <http://www.molmod.info/semantics/pims-ii.ttl#underlies> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isSelectionOutputIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSelectionInputIn> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isAccumulationInputIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAccumulationOutputIn> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isIncludedInAccumulation> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAccumulationOutputIn> ] ) ;
    skos:altLabel "\\\\ddot{C}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isFirstElementIn> a owl:ObjectProperty ;
    rdfs:label "isFirstElementIn"@en ;
    rdfs:comment "(x isFirstElementIn y) means that x acts as the first element in y, which is a triadic cognition"@en ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#TriadicCognition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentationalElementIn> ;
    owl:propertyChainAxiom ( [ owl:inverseOf rdf:first ] [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTriadOf> ] ) ;
    skos:altLabel "\\\\dot{E}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isFusionOf> a owl:ObjectProperty ;
    rdfs:label "isFusionOf"@en ;
    rdfs:comment "x isFusionOf (y1 y2 ... yn) means that x is the spatiotemporal union (i.e., fusion) of all the elements included in the list (y1 y2 ... yn)"@en ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRelatedToList> ;
    skos:altLabel "\\\\sigma"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isGoalOf> a owl:ObjectProperty ;
    rdfs:label "isGoalOf"@en ;
    rdfs:comment "(x isGoalOf y) means that y is a goal-oriented agent with the tendency to work toward a state of affairs that is described/represented by y; accordingly, the goal y is also a representamen for the agent itself; this does *not* imply that the agent x is aware of pursuing y as a goal, or that y is somehow included in x as a mental representation - for that purpose, use the relation 'isGoalFor'"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GoalOrientedAgent> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> .

<http://www.molmod.info/semantics/pims-ii.ttl#isGroundedStepIn> a owl:ObjectProperty ;
    rdfs:label "isGroundedStepIn"@en ;
    rdfs:comment "(x isGroundedStepIn y) == y is a grounding step where x is the grounded step, i.e., the third element"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GroundingMetonymization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isGroundingPropositionIn> a owl:ObjectProperty ;
    rdfs:label "isGroundingPropositionIn"@en ;
    rdfs:comment "(x isGroundingPropositionIn y) == y is a grounding step where x is the grounding proposition, i.e., the second element; therein, x is a ground for the grounded step, and x is also a ground for y itself"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Ground> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GroundingMetonymization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInMetonymization>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isGroundFor> .

<http://www.molmod.info/semantics/pims-ii.ttl#isGroundingStepIn> a owl:ObjectProperty ;
    rdfs:label "isGroundingStepIn"@en ;
    rdfs:comment "(x isGroundingStepIn y) == y is a grounding step where x is the grounding step, i.e., the first element"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GroundingMetonymization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isImproperPartOf> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:TransitiveProperty ;
    rdfs:label "isImproperPartOf"@en ;
    rdfs:comment "Spatiotemporal (mereological) improper parthood relation; in other words, it is the reflexive closure of proper parthood: (x isImproperPartOf y) means that all points within x are also within y"@en ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#hasImproperPart> ;
    owl:propertyChainAxiom ( [ owl:inverseOf rdf:first ] [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isFusionOf> ] ) ;
    skos:altLabel "P" .

<http://www.molmod.info/semantics/pims-ii.ttl#isIncludedInAccumulation> a owl:ObjectProperty ;
    rdfs:label "isIncludedInAccumulation"@en ;
    rdfs:comment "(x isIncludedInAccumulation y) == y is an accumulation where x is combined with the accumulation input, yielding an output that x is constitutive of; n.b., x needs to act as a representamen for the object (e.g., as an interpretant from a preceding cognitive step with the same object)"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Accumulation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isInterlocutorIn> a owl:ObjectProperty ;
    rdfs:label "isInterlocutorIn"@en ;
    rdfs:comment "(x isInterlocutorIn y) means that x engages, jointly with other interlocutors, in the communication y"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Communication> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isMemberOfPlurality> a owl:ObjectProperty ;
    rdfs:label "isMemberOfPlurality"@en ;
    rdfs:comment "(x isMemberOfPlurality y) means that x is a semiotic member of the plurality y, and that it participates in semiosis in the same way as its co-members x', x'', ... of the plurality y"^^xsd:string ;
    rdfs:domain [ owl:complementOf [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Plurality> <http://www.molmod.info/semantics/pims-ii.ttl#Structure> ) ] ] ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Plurality> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> ;
    skos:altLabel "\\\\lhd_p"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInSynecdoche> a owl:ObjectProperty ;
    rdfs:label "isNewReferentInSynecdoche"@en ;
    rdfs:comment "(x isNewReferentInSynecdoche y) == y is a synecdoche where x acts as the new referent, i.e., the third element; the old and the new referent need to have a causal connection (n.b., the mereological relation in terms of proper parthood as such is insufficient)"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Synecdoche> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObservationInputIn> a owl:ObjectProperty ;
    rdfs:label "isObservationInputIn"@en ;
    rdfs:comment "(x isObservationInputIn y) == y is an observation where x designates input and/or advance knowledge relevant to the observation, i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Observation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInPerception> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObservationOutcomeIn> a owl:ObjectProperty ;
    rdfs:label "isObservationOutcomeIn"@en ;
    rdfs:comment "(x isObservationOutcomeIn y) == y is an observation where x is the observation outcome (the observed value of the target property), i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Observation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInPerception> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObservedIn> a owl:ObjectProperty ;
    rdfs:label "isObservedIn"@en ;
    rdfs:comment "(x isObservedIn y) == y is an observation where x acts as the observed object, i.e., the second element, for which the value of a property is to be determined"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Observation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isPerceivedIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInSynecdoche> a owl:ObjectProperty ;
    rdfs:label "isOldReferentInSynecdoche"@en ;
    rdfs:comment "(x isOldReferentInSynecdoche y) == y is a synecdoche where x acts as the old referent, i.e., the first element; the old and the new referent need to have a causal connection (n.b., the mereological relation in terms of proper parthood as such is insufficient)"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Synecdoche> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isOptimizationObjectiveWithin> a owl:ObjectProperty ;
    rdfs:label "isOptimizationObjectiveWithin"@en ;
    rdfs:comment "(x isOptimizationObjectiveWithin y) == x is one of the optimization criteria that make up the objective space considered in the optimization problem y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#OptimizationProblem> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isPresentStepInGrounding> a owl:ObjectProperty ;
    rdfs:label "isPresentStepInGrounding"@en ;
    rdfs:comment "(x isPresentStepInGrounding y) == y is a grounding interpretation where x is the second element, i.e., the considered cognitive step"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#GroundingInterpretation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInUndertaking> a owl:ObjectProperty ;
    rdfs:label "isResolutionInUndertaking"@en ;
    rdfs:comment "(x isResolutionInUndertaking y) == y is an undertaking where x is the resolution (obtained from a previous telesis), i.e., the second element"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Undertaking> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInMetonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSecondElementIn> a owl:ObjectProperty ;
    rdfs:label "isSecondElementIn"@en ;
    rdfs:comment "(x isSecondElementIn y) means that x acts as the second element in y, which is a triadic cognition"@en ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#TriadicCognition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentationalElementIn> ;
    owl:propertyChainAxiom ( [ owl:inverseOf rdf:first ] [ owl:inverseOf rdf:rest ] [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTriadOf> ] ) ;
    skos:altLabel "\\\\ddot{E}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isSpeakerIn> a owl:ObjectProperty ;
    rdfs:label "isSpeakerIn"@en ;
    rdfs:comment "(x isSpeakerIn y) means that x is (the only) speaker in the expressive act y, where the role of the speaker is to be understood as that of an agent that conducts/undertakes the expressive act, i.e., it is not limited to vocal speech"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#ExpressiveAct> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isAgentIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isInterlocutorIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isStepIn> a owl:ObjectProperty ;
    rdfs:label "isStepIn"@en ;
    rdfs:comment "(x isStepIn y) means that x and y are processes, where x is a proper part of y that plays a well-defined role within y (e.g., a task within a project, the execution of a single command within the execution of a program, etc.)"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:range [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTerminalStepIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Process> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isInitialStepIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Process> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isProperParticipantIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isTelosInSteering> a owl:ObjectProperty ;
    rdfs:label "isTelosInSteering"@en ;
    rdfs:comment "(x isTelosInSteering y) == y is a steering operation (reflection in actu) where x acts as the telos (initial guiding objective), i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Steering> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInPerception>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isTelosIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isThirdElementIn> a owl:ObjectProperty ;
    rdfs:label "isThirdElementIn"@en ;
    rdfs:comment "(x isThirdElementIn y) means that x acts as the third element in y, which is a triadic cognition"@en ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#TriadicCognition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentationalElementIn> ;
    owl:propertyChainAxiom ( [ owl:inverseOf rdf:first ] [ owl:inverseOf rdf:rest ] [ owl:inverseOf rdf:rest ] [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTriadOf> ] ) ;
    skos:altLabel "\\\\dddot{E}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isTriadOf> a owl:ObjectProperty ;
    rdfs:label "isTriadOf"@en ;
    rdfs:comment "'x isTriadOf (e1 e2 e3)' is a shorthand for 'e1 isFirstElementIn x; e2 isSecondElementIn x; e3 isThirdElementIn x'"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#TriadicCognition> ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRelatedToList> ;
    skos:altLabel "3"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#msHRHPIPHR> a owl:ObjectProperty ;
    rdfs:label "msHRHPIPHR"@en ;
    rdfs:comment "chain relation msHRHP o msIPHR" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIPIR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#msHRHP> <http://www.molmod.info/semantics/pims-ii.ttl#msIPHR> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIPIR> a owl:ObjectProperty ;
    rdfs:label "msIRHPIPIR"@en ;
    rdfs:comment "chain relation msIRHP o msIPIR" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRHPIPHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRHP> <http://www.molmod.info/semantics/pims-ii.ttl#msIPIR> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#temporallyOverlapsWith> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty ;
    rdfs:label "temporallyOverlapsWith"@en ;
    rdfs:comment "(x temporallyOverlapsWith y) means that there is an (extended) interval in time where both x and y exist"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isTemporallyConnectedWith> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#temporallyCoextendsWith> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#temporallyCoextendsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#DigitalConventional> a owl:Class ;
    rdfs:label "DigitalConventional"@en ;
    rdfs:comment "Digital conventional, i.e., a conventional that is a digital articulation"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Conventional>,
        <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> ) ;
    skos:altLabel "DCV"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Dyad> a owl:Class ;
    rdfs:label "Dyad"@en ;
    rdfs:comment "Dyad, i.e., a data item by which two conventionals are grouped together; e.g., an equality or inequality articulation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isFirstInDyad> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#DigitalConventional> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSecondInDyad> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#DigitalConventional> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#DataItem> .

<http://www.molmod.info/semantics/pims-ii.ttl#GroundingInterpretation> a owl:Class ;
    rdfs:label "GroundingInterpretation"@en ;
    rdfs:comment "Grounding interpretation, i.e., an interpretation where the sign is a ground for the considered cognitive step, the object is the considered cognitive step, and the interpretant is a ground for a subsequent cognitive step"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#groundsPresentStepIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isPresentStepInGrounding> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#groundsNextStepIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#GroundingStep>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#GroundingStep> <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#GroundingMetonymization> a owl:Class ;
    rdfs:label "GroundingMetonymization"@en ;
    rdfs:comment "Grounding metonymization, i.e., a metonymization where a the old referent is a cognitive step (i.e., the grounding step) that grounds another (i.e., the grounded step), which is the new referent; the referent for both is a ground (i.e., the grounding proposition) that is a ground for the grounded step"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundingStepIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundedStepIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundingPropositionIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#GroundingStep>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Metonymization> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#GroundingStep> <http://www.molmod.info/semantics/pims-ii.ttl#SemanticChange> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#IndividualIRI> a owl:Class ;
    rdfs:label "IndividualIRI"@en ;
    rdfs:comment "Individual IRI, i.e., the internationalized resource identifier of an individual (owl:Thing or pims-ii:Object)"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#IRI>,
        <http://www.molmod.info/semantics/pims-ii.ttl#UniqueIdentifier> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> .

<http://www.molmod.info/semantics/pims-ii.ttl#KnowledgeClaim> a owl:Class ;
    rdfs:label "KnowledgeClaim"@en ;
    rdfs:comment "Knowledge claim (KC), i.e., a claim about something with respect to its knowledge status"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#hasSubjectMatter> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Question> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantIn> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Claim> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#ValidityClaim> ;
    skos:altLabel "KC"@en ;
    skos:scopeNote "A knowledge claim states 'what data mean,' i.e., in what way some agent of the academic discourse has given some data an interpretation as constituting knowledge. A knowledge claim asserts what was found from research data: 'Research data δ made agent a know φ,' which can be expanded as 'the interpreation of research data δ by interpreter a yielded the knowledge claim φ as an interpretant.'"@en,
        "The subject matter of a knowledge claim must be a (single) question, namely the one that is answered by the claim; in particular, therefore, its subject matter may not be a sum (plurality) of unrelated questions - in such a case, split it up into multiple independent knowledge claims"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Lexeme> a owl:Class ;
    rdfs:label "Lexeme"@en ;
    rdfs:comment "Lexeme, i.e., a semiotic collective the members of which are all instances/utterances/copies of the same word (or a fragment or group of words that fulfills the corresponding function) which acts as a conventional articulation due to social convention; different ways of writing the word, such as an abbreviation and the full version, may belong to the same lexeme"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#CollectiveLiteral>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> .

<http://www.molmod.info/semantics/pims-ii.ttl#Measurement> a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:comment "Measurement, i.e., an observation that follows a standard procedure, so that it can be expected to yield an objective (rather than subjective) outcome"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMeasuredObjectIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMeasurementOutcomeIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMeasurementInputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Observation> .

<http://www.molmod.info/semantics/pims-ii.ttl#ModalIRI> a owl:Class ;
    rdfs:label "ModalIRI"@en ;
    rdfs:comment "Modal IRI, i.e., the IRI of a relation that is defined by (absolute or qualified) necessity or possibility of another relation"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#AbsoluteModalIRI> <http://www.molmod.info/semantics/pims-ii.ttl#QualifiedModalIRI> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#Name> a owl:Class ;
    rdfs:label "Name"@en ;
    rdfs:comment "Name, i.e., a lexeme that acts as a rigid designator due to social convention"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isNameFor> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Lexeme> .

<http://www.molmod.info/semantics/pims-ii.ttl#PartToWhole> a owl:Class ;
    rdfs:label "PartToWhole"@en ;
    rdfs:comment "Part-to-whole synecdoche, i.e., a metonymization where the old referent is a spatiotemporal proper part of the new referent (additionally, the old and new referent need to be connected causally)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInPartToWhole> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInPartToWhole> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInPartToWhole> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Synecdoche> .

<http://www.molmod.info/semantics/pims-ii.ttl#Planning> a owl:Class ;
    rdfs:label "Planning"@en ;
    rdfs:comment "Planning, i.e., a reflection ex ante or predetermination, carried out by analysing the perceived present situation in advance of potentially undertaking an action"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSituationInPlanning> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTelosInPlanning> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInPlanning> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Perception>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Telesis> .

<http://www.molmod.info/semantics/pims-ii.ttl#QualifiedModalIRI> a owl:Class ;
    rdfs:label "QualifiedModalIRI"@en ;
    rdfs:comment "Qualified modal IRI, i.e., the IRI of a relation that is defined by qualified necessity or possibility of another relation"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ModalIRI> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isContextOfRelation> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#ContextualIRI> ] ;
    skos:scopeNote "Qualified modal relations require the specification of a modal context, i.e., a frame of reference for understanding what 'necessity' and 'possibility' exactly mean."@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Selection> a owl:Class ;
    rdfs:label "Selection"@en ;
    rdfs:comment "Selection, i.e., an information-processing step in which the given information is narrowed down such that the output (interpretant) is constitutive of the input (sign); this includes conditional selection, where one component of the input or another is retained depending on a selection condition (cf. relation isSelectionConditionIn)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSelectionOutputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSelectionInputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInSelection> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#InformationProcessing> .

<http://www.molmod.info/semantics/pims-ii.ttl#Simulation> a owl:Class ;
    rdfs:label "Simulation"@en ;
    rdfs:comment "Simulation, i.e., a purposefully conducted numerical interpretation of simulation input (model, etc.), where the interpretant is the simulation result"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSimulatedIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSimulationOutputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSimulationInputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation>,
        <http://www.molmod.info/semantics/pims-ii.ttl#PurposefulAction> .

<http://www.molmod.info/semantics/pims-ii.ttl#Steering> a owl:Class ;
    rdfs:label "Steering"@en ;
    rdfs:comment "Steering, i.e., a reflection in actu (Reflexion im Vollzug following Baumann and Tulatz) or determination, carried out while undertaking an action and playing a role in that action by proper participation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInSteering> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isActionInSteering> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTelosInSteering> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Perception>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Telesis> .

<http://www.molmod.info/semantics/pims-ii.ttl#TopicalSum> a owl:Class ;
    rdfs:label "TopicalSum"@en ;
    rdfs:comment "Topical sum, i.e., a plurality of topical propositions, where the individual elements (summands) don't genuinely interact but are just standing beside each other as independent, unrelated (or not very closely related) parts of what is addressed"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Plurality> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTopicalSummandIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Topical> ] ;
    skos:altLabel "TLS"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Undertaking> a owl:Class ;
    rdfs:label "Undertaking"@en ;
    rdfs:comment "Undertaking, i.e., a metonymization by which a resolution, which was previously determined (by telesis) in response to the pre-existing situation, is actively taken up by the agent, motivating an action"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isActionInUndertaking> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSituationInUndertaking> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#directlyGrounds> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Telesis> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInUndertaking> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Metonymization> .

<http://www.molmod.info/semantics/pims-ii.ttl#Validation> a owl:Class ;
    rdfs:label "Validation"@en ;
    rdfs:comment "Validation, i.e., an evaluation of a cognition yielding a validity claim as its interpretant"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isValidatedIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveAction> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isValidationOutcomeIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#ValidityClaim> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTelosInValidation> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Evaluation> ;
    skos:altLabel "VAL"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#WholeToPart> a owl:Class ;
    rdfs:label "WholeToPart"@en ;
    rdfs:comment "Whole-to-part synecdoche, i.e., a metonymization where the new referent is a spatiotemporal proper part of the old referent (additionally, the old and new referent need to be connected causally)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInWholeToPart> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInWholeToPart> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInWholeToPart> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Synecdoche> .

<http://www.molmod.info/semantics/pims-ii.ttl#hasImproperPart> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:TransitiveProperty ;
    rdfs:label "hasImproperPart"@en ;
    rdfs:comment "Spatiotemporal (mereological) improper parthood relation; in other words, it is the reflexive closure of proper parthood: (x hasImproperPart y) means that all points within y are also within x"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isImproperPartOf> .

<http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingInputIn> a owl:ObjectProperty ;
    rdfs:label "isInformationProcessingInputIn"@en ;
    rdfs:comment "(x isInformationProcessingInputIn y) == y is an information-processing step where x is the input, i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#InformationProcessing> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingOutputIn> a owl:ObjectProperty ;
    rdfs:label "isInformationProcessingOutputIn"@en ;
    rdfs:comment "(x isInformationProcessingOutputIn y) == y is an information-processing step where x is the output, i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#InformationProcessing> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInPerception> a owl:ObjectProperty ;
    rdfs:label "isInterpretantInPerception"@en ;
    rdfs:comment "(x isInterpretantInPerception y) == y is a perception where x acts as the interpretant, i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Perception> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isMemberOf> a owl:ObjectProperty ;
    rdfs:label "isMemberOf"@en ;
    rdfs:comment "membership relation, i.e., relation between an item/member and a collective"@en ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Collective> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isConstitutiveOf>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> ;
    skos:altLabel "\\\\leq"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectIn> a owl:ObjectProperty ;
    rdfs:label "isObjectIn"@en ;
    rdfs:comment "(x isObjectIn y) == y is a semiosis where x acts as the object, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isReferentIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isSecondElementIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInformationProcessing> a owl:ObjectProperty ;
    rdfs:label "isObjectInInformationProcessing"@en ;
    rdfs:comment "(x isObjectInInformationProcessing y) == y is an information-processing step where x is the object that the input and the output both represent, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#InformationProcessing> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInterpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectInTelesis> a owl:ObjectProperty ;
    rdfs:label "isObjectInTelesis"@en ;
    rdfs:comment "(x isObjectInTelesis y) == y is a telesis where x acts as the object (action, claim, or situation against which an objective is evaluated), i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Telesis> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isPerceivedIn> a owl:ObjectProperty ;
    rdfs:label "isPerceivedIn"@en ;
    rdfs:comment "(x isPerceivedIn y) == y is a perception where x acts as the perceived object, i.e., the second element; the perceived object is a (mereotopological) participant of the perception, in other words, it needs to be physically present so that it can be perceived"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Perception> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantInCognition> .

<http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInTelesis> a owl:ObjectProperty ;
    rdfs:label "isResolutionInTelesis"@en ;
    rdfs:comment "(x isResolutionInTelesis y) == y is a telesis where x acts as the resolution (a plan, revised objective, or other comparable sort of evaluation outcome), i.e., the third element"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Telesis> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSignIn> a owl:ObjectProperty ;
    rdfs:label "isSignIn"@en ;
    rdfs:comment "(x isSignIn y) == y is a semiosis where x acts as the sign, i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isFirstElementIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSignInPerception> a owl:ObjectProperty ;
    rdfs:label "isSignInPerception"@en ;
    rdfs:comment "(x isSignInPerception y) == y is a perception where x acts as the sign, i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Perception> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSpatiotemporallyConnectedWith> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty ;
    rdfs:label "isSpatiotemporallyConnectedWith"@en ;
    rdfs:comment "(x isSpatiotemporallyConnectedWith y) means that x and y overlap or are directly adjacent to each other at some point; i.e., there is a point p_x in x and a point p_y in y such that you can go from p_x to p_y without ever leaving the fusion (x U y)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isTemporallyConnectedWith> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasImproperPart> <http://www.molmod.info/semantics/pims-ii.ttl#isSpatiotemporallyConnectedWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#isTelosIn> a owl:ObjectProperty ;
    rdfs:label "isTelosIn"@en ;
    rdfs:comment "(x isTelosIn y) == y is a telesis where x acts as the telos (initial guiding objective), i.e., the first element"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Telesis> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPHRHPIP> a owl:ObjectProperty ;
    rdfs:label "msHPHRHPIP"@en ;
    rdfs:comment "chain relation msHPHR o overlapsWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msHPHR> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHR> a owl:ObjectProperty ;
    rdfs:label "msHPIPHR"@en ;
    rdfs:comment "(X msHPIPHR Z) == hasProperPart o isProperPartOf o hasRepresentamen == there is a Y such that (X overlapsWith Y) and (Z isRepresentamenFor Y)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRHP> a owl:ObjectProperty ;
    rdfs:label "msHPIPHRHP"@en ;
    rdfs:comment "chain relation overlapsWith o msHRHP" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIPIRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#msHRHP> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRHR> a owl:ObjectProperty ;
    rdfs:label "msHPIPHRHR"@en ;
    rdfs:comment "chain relation overlapsWith o msHRHR" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRIRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#msHRHR> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRIP> a owl:ObjectProperty ;
    rdfs:label "msHPIPHRIP"@en ;
    rdfs:comment "chain relation overlapsWith o msHRIP" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#msHRIP> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRIR> a owl:ObjectProperty ;
    rdfs:label "msHPIPHRIR"@en ;
    rdfs:comment "chain relation overlapsWith o sharesRepresentamenWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRIRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#sharesRepresentamenWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRHP> a owl:ObjectProperty ;
    rdfs:label "msHPIPIRHP"@en ;
    rdfs:comment "chain relation overlapsWith o msIRHP" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIPHRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#msIRHP> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRHR> a owl:ObjectProperty ;
    rdfs:label "msHPIPIRHR"@en ;
    rdfs:comment "chain relation overlapsWith o sharesReferentWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRHRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#sharesReferentWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRIP> a owl:ObjectProperty ;
    rdfs:label "msHPIPIRIP"@en ;
    rdfs:comment "chain relation overlapsWith o msIRIP" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPHRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#msIRIP> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRIR> a owl:ObjectProperty ;
    rdfs:label "msHPIPIRIR"@en ;
    rdfs:comment "chain relation overlapsWith o msIRIR" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRHRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#msIRIR> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIRHPIP> a owl:ObjectProperty ;
    rdfs:label "msHPIRHPIP"@en ;
    rdfs:comment "chain relation msHPIR o overlapsWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msHPIR> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHRHPIP> a owl:ObjectProperty ;
    rdfs:label "msHRHPIP"@en ;
    rdfs:comment "(X msHRHPIP Z) == hasRepresentamen o hasProperPart o isProperPartOf == there is a Y such that (Y isRepresentamenFor X) and (Y overlapsWith Z)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#msHRHP> <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHRHRHPIP> a owl:ObjectProperty ;
    rdfs:label "msHRHRHPIP"@en ;
    rdfs:comment "chain relation msHRHR o overlapsWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRIR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msHRHR> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHRIP> a owl:ObjectProperty ;
    rdfs:label "msHRIP"@en ;
    rdfs:comment "(X msHRIP Z) == hasRepresentamen o isProperPartOf == there is a Y such that (Y isRepresentamenFor X) and (Y isProperPartOf Z)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRIP>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msHRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHRIRHPIP> a owl:ObjectProperty ;
    rdfs:label "msHRIRHPIP"@en ;
    rdfs:comment "chain relation sharesRepresentamenWith o overlapsWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRIR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#sharesRepresentamenWith> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIPHRHPIP> a owl:ObjectProperty ;
    rdfs:label "msIPHRHPIP"@en ;
    rdfs:comment "chain relation msIPHR o overlapsWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRHP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msIPHR> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIPIRHPIP> a owl:ObjectProperty ;
    rdfs:label "msIPIRHPIP"@en ;
    rdfs:comment "chain relation msIPIR o overlapsWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRHP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msIPIR> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRHRHPIP> a owl:ObjectProperty ;
    rdfs:label "msIRHRHPIP"@en ;
    rdfs:comment "chain relation sharesReferentWith o overlapsWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#sharesReferentWith> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRIP> a owl:ObjectProperty ;
    rdfs:label "msIRIP"@en ;
    rdfs:comment "(X msIRIP Z) == isRepresentamenFor o isProperPartOf == there is a Y such that (X isRepresentamenFor Y) and (Y isProperPartOf Z)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRIP>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRIRHPIP> a owl:ObjectProperty ;
    rdfs:label "msIRIRHPIP"@en ;
    rdfs:comment "chain relation msIRIR o overlapsWith" ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRIR> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#Accumulation> a owl:Class ;
    rdfs:label "Accumulation"@en ;
    rdfs:comment "Accumulation, i.e., an information-processing step in which the given information is extended/complemented such that the input (sign) and one or multiple additional representamina (cf. relation isIncludedInAccumulation) are jointly constitutive of the output (interpretant); this includes conditional accumulation, where the choice and the way in which information is combined depends on an accumulation condition (cf. relation isAccumulationConditionIn)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isIncludedInAccumulation> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInAccumulation> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAccumulationInputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAccumulationOutputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#InformationProcessing> .

<http://www.molmod.info/semantics/pims-ii.ttl#ExactAgreementReproducibilityClaim> a owl:Class ;
    rdfs:label "ExactAgreementReproducibilityClaim"@en ;
    rdfs:comment "Exact-agreement reproducibility claim (ERC), i.e., a reproducibility claim obtained as an outcome of an attempt at obtaining exactly the same outcome as the original study"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ReproducibilityClaim> ;
    skos:altLabel "ERC"@en ;
    skos:scopeNote "The criterion for an ERC is that it has no outcome paradata - all the outcome metadata are orthodata"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#ExpressiveAct> a owl:Class ;
    rdfs:label "ExpressiveAct"@en ;
    rdfs:comment "Expressive act, i.e., a purposeful communication (e.g., a speech act or an analogous digital act of communicating) issued by its agent, the speaker (understood in a generalized sense, i.e., not limited to speech) - the purpose of the action consists of its illocutionary and perlocutionary intent"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSpeakerIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveAction>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Communication>,
        <http://www.molmod.info/semantics/pims-ii.ttl#PurposefulAction> .

<http://www.molmod.info/semantics/pims-ii.ttl#GoalDirectedAgent> a owl:Class ;
    rdfs:label "GoalDirectedAgent"@en ;
    rdfs:comment "'Goal-directed agents are intelligent agents that have an internal representation of the goals they [tend to] achieve' (Conte, doi:10.1007/978-1-4614-1800-9_158, 2009)"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#IntelligentAgent> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGoalFor> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ] ;
    skos:scopeNote "Goal-directedness requires an explicit internal representation of intentions/objectives/goals of the agent; that is what distinguishes it from goal orientation. In PIMS-II, goal orientation is denoted by the relation isGoalOf (which does not require an internal mental representation of the goal), whereas conscious goal directedness is denoted by the relation isGoalFor."@en .

<http://www.molmod.info/semantics/pims-ii.ttl#GroundingStep> a owl:Class ;
    rdfs:label "GroundingStep"@en ;
    rdfs:comment "Grounding step, i.e., a triadic cognition that establishes epistemic grounding"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#TriadicCognition> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#GroundingMetonymization> <http://www.molmod.info/semantics/pims-ii.ttl#GroundingInterpretation> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#IntelligentAgent> a owl:Class ;
    rdfs:label "IntelligentAgent"@en ;
    rdfs:comment "Intelligent agent, i.e., a goal-oriented agent that can internally make/hold claims (knowledge, beliefs, etc.). This requires the agent to have some kind of internal representation of its surroundings, and to store and process information about its surroundings. (Note that this does not require the agent to be queryable for its claims; for that purpose, use KnowledgeBase.)"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#GoalOrientedAgent> .

<http://www.molmod.info/semantics/pims-ii.ttl#Item> a owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "Item, i.e., a connected region of spacetime that does not consist of multiple connected components"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Object> ;
    skos:scopeNote "Alternative definition: An item is an object that cannot be split into two spatiotemporally disconnected parts"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Observation> a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "Observation, i.e., a perception by which characteristic aspects of an object (e.g., a target property or some more complex kind of behaviour) are purposefully investigated through specific means of perception; the procedure and evaluation may occur based on subjective judgement or according to an agreed procedure"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObservationInputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObservationOutcomeIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObservedIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Perception>,
        <http://www.molmod.info/semantics/pims-ii.ttl#PurposefulAction> .

<http://www.molmod.info/semantics/pims-ii.ttl#Optimization> a owl:Class ;
    rdfs:label "Optimization"@en ;
    rdfs:comment "Optimization, i.e., an interpretation in which the sign is the optimization problem, the object is that which the optimization problem is ultimately about, and the interpretant is the optimization output"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOptimizationOutputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInOptimization> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOptimizationProblemIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#OptimizationProblem> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#OptimizationProblem> a owl:Class ;
    rdfs:label "OptimizationProblem"@en ;
    rdfs:comment "Optimization problem, i.e., an intention expressed or expressible in terms of one or multiple objectives (objective space) and one or multiple design parameters (parameter space)"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isDesignParameterWithin> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOptimizationObjectiveWithin> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> ] .

<http://www.molmod.info/semantics/pims-ii.ttl#ProvenanceConsciousReproducibilityClaim> a owl:Class ;
    rdfs:label "ProvenanceConsciousReproducibilityClaim"@en ;
    rdfs:comment "Provenance-conscious reproducibility claim (PRC), i.e., a reproducibility claim obtained from an attempt that was subject to the requirement to retain the original research process or aspects of it"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ReproducibilityClaim> ;
    skos:altLabel "PRC"@en ;
    skos:scopeNote "The criterion for a PRC is that there are provenance orthodata, not only provenance paradata"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#PurposefulAction> a owl:Class ;
    rdfs:label "PurposefulAction"@en ;
    rdfs:comment "Purposeful action, i.e., an action carried out with an aim of which its agent (hence, a goal-directed agent) is aware"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#GoalDirectedAgent> ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAgentIn> ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAimIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Intention> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Action> .

<http://www.molmod.info/semantics/pims-ii.ttl#ReproducibilityClaim> a owl:Class ;
    rdfs:label "ReproducibilityClaim"@en ;
    rdfs:comment "Reproducibility claim (RC), i.e., a validity claim obtained as an outcome of a reproduction attempt/reproducibility study"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#QualifiedLaw>,
        <http://www.molmod.info/semantics/pims-ii.ttl#ValidityClaim> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#ProofBasedValidityClaim>,
        <http://www.molmod.info/semantics/pims-ii.ttl#TestBasedValidityClaim> ;
    skos:altLabel "RC"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Rule> a owl:Class ;
    rdfs:label "Rule"@en ;
    rdfs:comment "Rule, i.e., a proposition consisting of an antecedent and one or multiple consequent(s) such that the antecedent is stated to imply the consequent(s)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isConsequentWithin> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOrthodataWithin> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAntecedentWithin> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#articulates> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Dyad> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> .

<http://www.molmod.info/semantics/pims-ii.ttl#Synecdoche> a owl:Class ;
    rdfs:label "Synecdoche"@en ;
    rdfs:comment "Synecdoche, i.e., a metonymization where a sign is reassigned to a part of its old referent (WholeToPart) or vice versa (PartToWhole)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInSynecdoche> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInSynecdoche> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInSynecdoche> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Metonymization> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#PartToWhole> <http://www.molmod.info/semantics/pims-ii.ttl#WholeToPart> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#TeamChangeReproducibilityClaim> a owl:Class ;
    rdfs:label "TeamChangeReproducibilityClaim"@en ;
    rdfs:comment "Team-change reproducibility claim (TRC), i.e., a reproducibility claim obtained as an outcome of a reproducibility study conducted by an independent team"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#ReproducibilityClaim> ;
    skos:altLabel "TRC"@en ;
    skos:scopeNote "Criterion: Interpreter(s) disjoint with the interpreter(s) from the original research process"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Variable> a owl:Class ;
    rdfs:label "Variable"@en ;
    rdfs:comment "Variable, i.e., a conventional that is employed for something to which values can be assigned (this may include different notations for the same variable including, e.g., computational representations); this is to be understood very generally, e.g., a variable may be an array or set of elements or have another kind of internal structure"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Term> .

<http://www.molmod.info/semantics/pims-ii.ttl#articulates> a owl:ObjectProperty ;
    rdfs:label "articulates"@en ;
    rdfs:comment "(x articulates y) means that x is a semiotic member of the proposition y, giving a literal or non-literal (e.g., spoken) expression to its propositional content; n.b., x may also express other propositions beside y"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> ;
    skos:altLabel "\\\\lhd_a"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInMetonymization> a owl:ObjectProperty ;
    rdfs:label "changesReferentInMetonymization"@en ;
    rdfs:comment "(x changesReferentInMetonymization y) == y is a metonymization where x acts as the representamen, i.e., the second element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Metonymization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isReferentIn> a owl:ObjectProperty ;
    rdfs:label "isReferentIn"@en ;
    rdfs:comment "(x isReferentIn y) == x occurs in the cognitive step y in the function of the/a referent of a representamen"@en ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentationalElementIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenIn> a owl:ObjectProperty ;
    rdfs:label "isRepresentamenIn"@en ;
    rdfs:comment "(x isRepresentamenIn y) == x participates in the cognitive step y in the role of the/a representamen"@en ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantInCognition>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentationalElementIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isStepInCognitiveChain> a owl:ObjectProperty ;
    rdfs:label "isStepInCognitiveChain"@en ;
    rdfs:comment "(x isStepInCognitiveChain y) means that y is a cognitive chain that consists of multiple logically connected cognitive steps (following Peirce, these are typically triads, i.e., semioses and semantic changes), and that x is one of these steps"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveChain>,
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantInCognition>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isStepIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIR> a owl:ObjectProperty ;
    rdfs:label "msHPIPIR"@en ;
    rdfs:comment "(X msHPIPIR Z) == hasProperPart o isProperPartOf o isRepresentamenFor == there is a Y such that (X overlapsWith Y) and (Y isRepresentamenFor Z)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRHPIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIP> a owl:ObjectProperty ;
    rdfs:label "msIRHPIP"@en ;
    rdfs:comment "(X msIRHPIP Z) == isRepresentamenFor o hasProperPart o isProperPartOf == there is a Y such that (X isRepresentamenFor Y) and (Y overlapsWith Z)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#msIRHP> <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#CognitiveChain> a owl:Class ;
    rdfs:label "CognitiveChain"@en ;
    rdfs:comment "Cognitive chain, i.e., a cognition that consists of multiple (sub)steps"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 2 ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isStepInCognitiveChain> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> .

<http://www.molmod.info/semantics/pims-ii.ttl#ContextualIRI> a owl:Class ;
    rdfs:label "ContextualIRI"@en ;
    rdfs:comment "Contextual IRI, i.e., the internationalized resource identifier of a modal context, i.e., the frame of reference for a qualified-modal semiotic collective; that context defines how exactly necessity and possibility are to be understood"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#IRI> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> .

<http://www.molmod.info/semantics/pims-ii.ttl#Evaluation> a owl:Class ;
    rdfs:label "Evaluation"@en ;
    rdfs:comment "Evaluation, i.e., a reflection ex post (Reflexion des Vollzugs following Baumann and Tulatz) or redetermination, carried out after an action has terminated, either by the same agent or by somebody else"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isEvaluationOutcomeIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#directlyGrounds> ] ;
            owl:someValuesFrom [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Telesis> <http://www.molmod.info/semantics/pims-ii.ttl#Undertaking> ) ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isEvaluatorIn> ] ;
            owl:someValuesFrom [ owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#GoalDirectedAgent> <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ) ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isEvaluatedIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTelosInEvaluation> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Telesis> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Telesis> <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> ) ;
    skos:altLabel "EVA"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#InformationProcessing> a owl:Class ;
    rdfs:label "InformationProcessing"@en ;
    rdfs:comment "Information processing, i.e., an interpretation in which information is handled, revised, reformatted, extended, or narrowed down (or anything comparable to such actions), e.g., preprocessing or postprocessing in a simulation workflow"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingOutputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isInformationProcessingInputIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInformationProcessing> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> .

<http://www.molmod.info/semantics/pims-ii.ttl#Plurality> a owl:Class ;
    rdfs:label "Plurality"@en ;
    rdfs:comment "Plurality, i.e., a semiotic collective the semiotic members of which are a representational element (referent or representamen) together, whereby all act/contribute in the same way - this latter point distinguishes a plurality from a structure; e.g., the referent of the expression 'the four seasons/quarters of the year' (for a given year, within a given spatial region) is a plurality, and each of the four seasons/quarters is one of its semiotic members"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 2 ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMemberOfPlurality> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> ] ;
            owl:someValuesFrom [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Plurality> <http://www.molmod.info/semantics/pims-ii.ttl#Structure> ) ] ] ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMemberOfPlurality> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ] ;
    skos:altLabel "PL"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Presupposition> a owl:Class ;
    rdfs:label "Presupposition"@en ;
    rdfs:comment "Presupposition, i.e., a cognition that has a basic ground, so that it is accepted a priori as an ultimate anchor point for epistemic grounding; any cognition that is logically preceded by a presupposition is a grounded cognition"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#GroundedCognition> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundFor> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#BasicGround> ] .

<http://www.molmod.info/semantics/pims-ii.ttl#SemanticChange> a owl:Class ;
    rdfs:label "SemanticChange"@en ;
    rdfs:comment "Semantic change, i.e., a triadic cognition by which a representamen is assigned a new referent"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#TriadicCognition> .

<http://www.molmod.info/semantics/pims-ii.ttl#Structure> a owl:Class ;
    rdfs:label "Structure"@en ;
    rdfs:comment "Structure, i.e., a semiotic collective the semiotic members of which complement each other, contributing in different ways (or, at least, not all int the same way) to their joint action as a referent or a representamen"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 2 ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMemberOfStructure> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Structure> ] ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isMemberOfStructure> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ] .

<http://www.molmod.info/semantics/pims-ii.ttl#ValidityClaim> a owl:Class ;
    rdfs:label "ValidityClaim"@en ;
    rdfs:comment "Validity claim (VC), i.e., a claim about another claim, saying something about that claim's (in-)accuracy or somebody's (dis-)trust in the claim"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isAbout> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Claim> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Claim> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#KnowledgeClaim> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isValidationOutcomeIn> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Validation> ] ;
    skos:altLabel "VC"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isAbout> a owl:ObjectProperty ;
    rdfs:label "isAbout"@en ;
    rdfs:comment "(x isAbout y) means that x is a proposition and y is the object that x is related to by aboutness"@en ;
    rdfs:domain [ owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ) ] ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
    skos:altLabel "\\\\hat{A}"@en ;
    skos:scopeNote "it can make sense to use a structure or plurality to indicate the complex ways in which x can be about a combination of interrelated objects"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantIn> a owl:ObjectProperty ;
    rdfs:label "isInterpretantIn"@en ;
    rdfs:comment "(x isInterpretantIn y) == y is a semiosis where x acts as the interpretant, i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenIn>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isThirdElementIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isParticipantInCognition> a owl:ObjectProperty ;
    rdfs:label "isParticipantInCognition"@en ;
    rdfs:comment "(x isParticipantInCognition y) means that y is a cognition in which x is necessarily physically present and plays one of the roles characteristic for participation in a cognitive process as formalized by this ontology; this includes participation as a representamen, as a perceived object, as a step of a cognitive chain, or as an interpreter"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantIn> ;
    skos:altLabel "\\\\ddot{P}_\\\\kappa"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isRepresentationalElementIn> a owl:ObjectProperty ;
    rdfs:label "isRepresentationalElementIn"@en ;
    rdfs:comment "(x isRepresentationalElementIn y) == x acts as a representamen or referent in the cognitive step y"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPHR> a owl:ObjectProperty ;
    rdfs:label "msHPHR"@en ;
    rdfs:comment "(X msHPHR Z) == hasProperPart o hasRepresentamen == there is a Y such that (Y isProperPartOf X) and (Z isRepresentamenFor Y)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPHRHPIP>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHR> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasProperPart> <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHPIR> a owl:ObjectProperty ;
    rdfs:label "msHPIR"@en ;
    rdfs:comment "(X msHPIR Z) == hasProperPart o isRepresentamenFor == there is a Y such that (Y isProperPartOf X) and (Y is RepresentamenFor Z)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIR>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msHPIRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRIP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasProperPart> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ) .

rdf:first rdfs:comment "relates a rdf:List to its first element"@en ;
    rdfs:domain rdf:List ;
    skos:example "e.g., if L = (x y z), this would be 'L rdf:first x'"@en .

rdf:rest rdfs:comment "relates a rdf:List to the part that remains when its first element is removed"@en ;
    rdfs:domain rdf:List ;
    skos:example "e.g., if L = (x y z), this would be 'L rdf:rest (y z)'; if a list has only one element, the rest is rdf:nil, e.g., if L = (x), such that 'L rdf:first x', this would be 'L rdf:rest rdf:nil'"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Ground> a owl:Class ;
    rdfs:label "Ground"@en ;
    rdfs:comment "Ground (of a cognitive step), i.e., a proposition that justifies a cognitive step by explaning it and stating from what preceding step (which directly grounds that step) a sign-object relation is carried over, and in what way"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isGroundFor> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ] .

<http://www.molmod.info/semantics/pims-ii.ttl#IRI> a owl:Class ;
    rdfs:label "IRI"@en ;
    rdfs:comment "Internationalized resource identifier (IRI) as defined by RFC 3987; an IRI object should be related by 'isLiterally' to an xs:string containing the IRI literal"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#CollectiveLiteral>,
        <http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> ;
    owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#ConceptualIRI> <http://www.molmod.info/semantics/pims-ii.ttl#ContextualIRI> <http://www.molmod.info/semantics/pims-ii.ttl#IndividualIRI> <http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#Perception> a owl:Class ;
    rdfs:label "Perception"@en ;
    rdfs:comment "Perception, i.e., a semiosis in which the referent is a participant (as a perceived object) and therefore needs to be physically present"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInPerception> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isPerceivedIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInPerception> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ;
    skos:altLabel "PCN"@en ;
    skos:scopeNote "the perception is conducted by an agent, namely, the interpreter who perceives the object"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Term> a owl:Class ;
    rdfs:label "Term"@en ;
    rdfs:comment "Term, i.e., a conventional that can evaluate to a value; terms include variables, values, and any mathematically and semantically valid ways of combining variables, values, and mathematical operators - note that it is required for a term to potentially take a value"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Conventional> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleValueFor> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Value> ] .

<http://www.molmod.info/semantics/pims-ii.ttl#Topical> a owl:Class ;
    rdfs:label "Topical"@en ;
    rdfs:comment "Topical proposition, i.e., something that can be understood as stating the topic of something"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    skos:altLabel "TL"@en ;
    skos:scopeNote "A topic can be a product of (sub-)topics, that is the case if two aspects of something are being addressed jointly, with a genuine interaction between multiple factors; in this case, the whole topic is a topical product (subclass of topical), and its factors are related to it by pims-ii:isTopicalFactorIn. But something can also address multiple contributions to its subject matter independently, without a genuine interaction between the parts; in that case, the whole topic is a topical sum (disjoint with topical), its parts are topicals, and they are related to the whole by pims-ii:isTopicalSummandIn"@en,
        "In particular, all questions are topical propositions, since they state the topic of their potential answer"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Value> a owl:Class ;
    rdfs:label "Value"@en ;
    rdfs:comment "Value, i.e., an articulation that is by social convention understood to be potentially assignable to a variable"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleValueFor> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Term> .

<http://www.molmod.info/semantics/pims-ii.ttl#isGroundFor> a owl:ObjectProperty ;
    rdfs:label "isGroundFor"@en ;
    rdfs:comment "(g isGroundFor y) means that g is a representamen for the cognitive step y, explaining how y is grounded"@en ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Ground> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isAbout> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isGroundingPropositionIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundedStepIn> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#groundsPresentStepIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isPresentStepInGrounding> ] ) ;
    skos:altLabel "\\\\ddot{R}"@en ;
    skos:scopeNote "for g isGroundFor y, where x grounds y, there is a grounding metonymization where x is the old referent and y is the new referent of g"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInMetonymization> a owl:ObjectProperty ;
    rdfs:label "isNewReferentInMetonymization"@en ;
    rdfs:comment "(x isNewReferentInMetonymization y) == y is a metonymization where x acts as the new referent, i.e., the third element; the old and the new referent need to have a causal connection"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Metonymization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInMetonymization> a owl:ObjectProperty ;
    rdfs:label "isOldReferentInMetonymization"@en ;
    rdfs:comment "(x isOldReferentInMetonymization y) == y is a metonymization where x acts as the old referent, i.e., the first element; the old and the new referent need to have a causal connection"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Metonymization> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#msHRHP> a owl:ObjectProperty ;
    rdfs:label "msHRHP"@en ;
    rdfs:comment "(X msHRHP Z) == hasRepresentamen o hasProperPart == there is a Y such that (Y isRepresentamenFor X) and (Z isProperPartOf Y)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRHP>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msHRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIPIR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> <http://www.molmod.info/semantics/pims-ii.ttl#hasProperPart> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msHRHR> a owl:ObjectProperty ;
    rdfs:label "msHRHR"@en ;
    rdfs:comment "(X msHRHR Z) == (hasRepresentamen)^2 == there is a Y such that (Y isRepresentamenFor X) and (Z isRepresentamenFor Y)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRHR>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msHRHRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRIR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRHP> a owl:ObjectProperty ;
    rdfs:label "msIRHP"@en ;
    rdfs:comment "(X msIRHP Z) == isRepresentamenFor o hasProperPart == there is a Y such that (X isRepresentamenFor Y) and (Z isProperPartOf Y)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRHP>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIPHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> <http://www.molmod.info/semantics/pims-ii.ttl#hasProperPart> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIRIR> a owl:ObjectProperty ;
    rdfs:label "msIRIR"@en ;
    rdfs:comment "(X msIRIR Z) == (isRepresentamenFor)^2 == there is a Y such that (X isRepresentamenFor Y) and (Y isRepresentamenFor Z)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRIR>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msIRIRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRHR> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#Agent> a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "Agent, i.e., an object that interacts with its surroundings by a) perceiving and b) doing, i.e., an object that carries out actions, including perceptive actions"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Object> .

<http://www.molmod.info/semantics/pims-ii.ttl#Claim> a owl:Class ;
    rdfs:label "Claim"@en ;
    rdfs:comment "Claim, i.e., a proposition that is expressed by an interlocutor or believed/held by an intelligent agent"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> ;
    owl:equivalentClass [ owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> [ owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isAssertedBy> ;
                                    owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> ] [ a owl:Restriction ;
                                    owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isClaimOf> ;
                                    owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#IntelligentAgent> ] ) ] ) ] .

<http://www.molmod.info/semantics/pims-ii.ttl#CognitiveAction> a owl:Class ;
    rdfs:label "CognitiveAction"@en ;
    rdfs:comment "Cognitive action, i.e., a cognition that is conducted/undertaken by an agent; the agent of a cognitive action is called its interpreter"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpreterIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Agent> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Action>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> ;
    owl:intersectionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> <http://www.molmod.info/semantics/pims-ii.ttl#Action> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#CollectiveLiteral> a owl:Class ;
    rdfs:label "CollectiveLiteral"@en ;
    rdfs:comment "Collective literal, i.e., a semiotic collective the members of which all have a digital, printed, or written textual/numerical form in that they are all instances/copies of the same RDFS literal (or multiple RDFS literals that are very similar, e.g., different ways of spelling/abbreviating the same word or denoting the same number); n.b., collective literals are not permitted to have other semiotic collectives as their semiotic members"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#CollectiveUtterance> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isLiterally> ] .

<http://www.molmod.info/semantics/pims-ii.ttl#Metonymization> a owl:Class ;
    rdfs:label "Metonymization"@en ;
    rdfs:comment "Metonymization, i.e., a semantic change where there is a causal connection between the old and the new referent, so that the criterion of a 'real causal connection' (between signs and objects) from Peircean semiotics is preserved"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInMetonymization> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInMetonymization> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#changesReferentInMetonymization> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#SemanticChange> .

<http://www.molmod.info/semantics/pims-ii.ttl#TriadicCognition> a owl:Class ;
    rdfs:label "TriadicCognition"@en ;
    rdfs:comment "Triadic cognition, i.e., a cognitive step of the type s-o-s' (semiosis) or o-s-o' (semantic change), thus containing three elements, in line with the approach by Peirce"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isThirdElementIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundFor> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Ground> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isFirstElementIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSecondElementIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveAction>,
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#SemanticChange> <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#isAgentIn> a owl:ObjectProperty ;
    rdfs:label "isAgentIn"@en ;
    rdfs:comment "(x isAgentIn y) means that x is *the* agent that conducts/undertakes the action y; n.b., an action has exactly one agent (which can be a straightforward item, or a plurality, a structure, or similar)"^^xsd:string ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Agent> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Action> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantIn> ;
    skos:altLabel "\\\\ddot{P}_a"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInInterpretation> a owl:ObjectProperty ;
    rdfs:label "isInterpretantInInterpretation"@en ;
    rdfs:comment "(x isInterpretantInInterpretation y) == y is an interpretation where x acts as the interpretant, i.e., the third element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInterpretation> a owl:ObjectProperty ;
    rdfs:label "isObjectInInterpretation"@en ;
    rdfs:comment "(x isObjectInInterpretation y) == y is an interpretation where x acts as the object, i.e., the second element; there is no need to the object of an interpretation to be present and participate in the interpretation process physically"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#isParticipantIn> a owl:ObjectProperty ;
    rdfs:label "isParticipantIn"@en ;
    rdfs:comment "(x isParticipantIn y) means that y is a process in which x plays a certain role (e.g., x is a well-defined step within y, or x is an object that undergoes some change within y, or x is a sign that is read or an object that is perceived within y); this requires a spatiotemporal overlap between x and y"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasDirectCausalConnectionWith>,
        <http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> .

<http://www.molmod.info/semantics/pims-ii.ttl#isSignInInterpretation> a owl:ObjectProperty ;
    rdfs:label "isSignInInterpretation"@en ;
    rdfs:comment "(x isSignInInterpretation y) == y is an interpretation where x acts as the sign, i.e., the first element"^^xsd:string ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignIn> .

<http://www.molmod.info/semantics/pims-ii.ttl#msIPHR> a owl:ObjectProperty ;
    rdfs:label "msIPHR"@en ;
    rdfs:comment "(X msIPHR Z) == isProperPartOf o hasRepresentamen == there is a Y such that (X isProperPartOf Y) and (Z isRepresentamenFor Y)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHR>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msIPHRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msIRHP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#msIPIR> a owl:ObjectProperty ;
    rdfs:label "msIPIR"@en ;
    rdfs:comment "(X msIP Z) == isProperPartOf o isRepresentamenFor == there is a Y such that (X isProperPartOf Y) and (Y isRepresentamenFor Z)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIR>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msIPIRHPIP> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#msHRHP> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#temporallyCoextendsWith> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "temporallyCoextendsWith"@en ;
    rdfs:comment "(x temporallyCoextendsWith y) means that x and y have exactly the same extension in time, i.e., disregarding their spatial extension"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#temporallyOverlapsWith> .

<http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> a owl:Class ;
    rdfs:label "SemioticCollective"@en ;
    rdfs:comment "Semiotic collective, i.e., a collective the semiotic members of which act together as one representational element (i.e., referent or representamen) in a cognitive process"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 2 ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Collective> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> <http://www.molmod.info/semantics/pims-ii.ttl#Structure> <http://www.molmod.info/semantics/pims-ii.ttl#Plurality> ) ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentationalElementIn> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Item> ] ;
    skos:altLabel "SCO"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Telesis> a owl:Class ;
    rdfs:label "Telesis"@en ;
    rdfs:comment "Telesis (teleological semiosis), i.e., a semiosis where the sign is a telos (aim), the object is an action, claim, or situation against which that aim is evaluated, and the interpretant is a resolution, e.g., a revised objective, plan, or similar evaluation outcome"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInTelesis> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isResolutionInTelesis> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isTelosIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveAction>,
        <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Planning> <http://www.molmod.info/semantics/pims-ii.ttl#Steering> <http://www.molmod.info/semantics/pims-ii.ttl#Evaluation> ) ;
    skos:altLabel "TEL"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "temporallyPrecedes"@en ;
    rdfs:comment "(x temporallyPrecedes y) means that every point in x is earlier in time than every point in y; the spacetime regions x and y may be connected, but they cannot overlap temporally"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#doesNotTemporallyOverlapWith> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#temporallyCoextendsWith> <http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> <http://www.molmod.info/semantics/pims-ii.ttl#temporallyCoextendsWith> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> <http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> <http://www.molmod.info/semantics/pims-ii.ttl#hasProperPart> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#Action> a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "Action, i.e., a process that is conducted/undertaken by an agent - the action has exactly one agent"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAgentIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Agent> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Process> .

<http://www.molmod.info/semantics/pims-ii.ttl#DigitalArticulation> a owl:Class ;
    rdfs:label "DigitalArticulation"@en ;
    rdfs:comment "Digital articulation, i.e., an articulation the members of which are copies of the same digital content (a file, assignment of a value to a variable, a data set, etc.)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality 2 ;
            owl:onClass <http://www.molmod.info/semantics/pims-ii.ttl#CollectiveLiteral> ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
    skos:altLabel "DAN"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> a owl:Class ;
    rdfs:label "Semiosis"@en ;
    rdfs:comment "Semiosis, i.e., a triadic congition that relates 'the sign', 'the object', and 'the interpretant' to each other; a semiosis is either a perception (if the object needs to be present and participate physically in the process) or an interpretation (if the physical participation of the object is not inherently necessary)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#TriadicCognition> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Perception> <http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> a owl:ObjectProperty ;
    rdfs:label "isSemioticMemberOf"@en ;
    rdfs:comment "(x isSemioticMemberOf y) means that x acts as a representamen or as a referent jointly with other co-members of the same semiotic collective y"^^xsd:string ;
    rdfs:domain [ owl:complementOf <http://www.molmod.info/semantics/pims-ii.ttl#Plurality> ] ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isMemberOf>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ;
    skos:altLabel "\\\\ddot\\\\leq"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#sharesRepresentamenWith> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "sharesRepresentamenWith"@en ;
    rdfs:comment "(X sharesRepresentamenWith Z) == there is a Y such that Y isRepresentamenFor both X and Z"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHRIR>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msHRIRHPIP> .

<http://www.molmod.info/semantics/pims-ii.ttl#Cognition> a owl:Class ;
    rdfs:label "Cognition"@en ;
    rdfs:comment "Cognition, i.e., a process dealing with representamina (signs) consisting either of a single cognitive step, of multiple steps that are connected to each other as a cognitive chain, or of an anchor point for epistemic grounding"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    owl:unionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveChain> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#Intention> a owl:Class ;
    rdfs:label "Intention"@en ;
    rdfs:comment "Intention, i.e., a proposition that constitutes an aim or goal"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Proposition> .

<http://www.molmod.info/semantics/pims-ii.ttl#sharesReferentWith> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "sharesReferentWith"@en ;
    rdfs:comment "(X sharesReferentWith Z) == there is a Y such that both X and Z isRepresentamenFor Y"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIRHR>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msIRHRHPIP> .

<http://www.molmod.info/semantics/pims-ii.ttl#Conventional> a owl:Class ;
    rdfs:label "Conventional"@en ;
    rdfs:comment "Conventional, i.e., a semiotic collective articulation the members of which jointly fulfill a certain semiotic function by social convention; e.g., many spoken or written occurrences of the words 'enthalpy of vaporization' or 'latent heat' may act together as a property in this sense"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
    skos:altLabel "CV"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Interlocutor> a owl:Class ;
    rdfs:label "Interlocutor"@en ;
    rdfs:comment "Interlocutor, i.e., an agent that can be addressed and is capable of addressing others in a communication process"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Agent> ;
    skos:altLabel "IO"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Articulation> a owl:Class ;
    rdfs:label "Articulation"@en ;
    rdfs:comment "Articulation (collective expression), i.e., a semiotic collective the semiotic members (i.e., realizations) of which are not semiotic collectives, but individual literal (written or digital) or non-literal (e.g., spoken) items with the same semiotic function (or undergoing evaluation whether such a function is present)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 2 ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#realizes> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> ] ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#realizes> ] ;
            owl:someValuesFrom [ owl:complementOf <http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> ] ] ;
    skos:altLabel "AN"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Interpretation> a owl:Class ;
    rdfs:label "Interpretation"@en ;
    rdfs:comment "Interpretation, i.e., a semiosis where the sign-object relation is carried over from the preceding cognitive step, without the need for the represented object to be present physically"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSignInInterpretation> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInInterpretation> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isInterpretantInInterpretation> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ;
    skos:altLabel "IPR"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#RelationalIRI> a owl:Class ;
    rdfs:label "RelationalIRI"@en ;
    rdfs:comment "Relational IRI, i.e., the internationalized resource identifier of a something that can play the role of the predicate in a triple; this includes 'rdf:type', object properties, datatype properties, their negations"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#IRI> ;
    owl:disjointWith <http://www.molmod.info/semantics/pims-ii.ttl#ConceptualIRI>,
        <http://www.molmod.info/semantics/pims-ii.ttl#ContextualIRI>,
        <http://www.molmod.info/semantics/pims-ii.ttl#IndividualIRI> .

<http://www.molmod.info/semantics/pims-ii.ttl#Process> a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:comment "Process, i.e., a connected region that has at least one participant, an entity with which it overlaps spatiotemporally and that plays a certain role in the process"@en ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Item> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isParticipantIn> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ] ;
    skos:scopeNote "n.b., 'participation' here does not imply agency, anything that somehow plays a role in the process, and does so by virtue of overlapping with it spatiotemporally, is a participant in it"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Proposition> a owl:Class ;
    rdfs:label "Proposition"@en ;
    rdfs:comment "Proposition, i.e., a semiotic collective the members of which are collective literals and collective utterances understood to be attributed some joint semantic and/or pragmatic content, or undergoing evaluation jointly for the presence of such a content"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticMemberOf> ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#articulatesLiterally> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#CollectiveLiteral> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isAbout> ],
        <http://www.molmod.info/semantics/pims-ii.ttl#SemioticCollective> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#articulates> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Articulation> ] ;
    skos:altLabel "PN"@en ;
    skos:scopeNote "Note that this here includes any kind of semiotic collective that fits the given definition; the semantic/pragmatic content may be assertive, but also interrogative or of any other character - in particular, by this definition, 'Question' is a subclass of 'Proposition'"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#hasProperPart> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "hasProperPart"@en ;
    rdfs:comment "(x hasProperPart y) means that y is an improper part of x such that x and y are not the same, in other words, all points within y are also within x, but not vice versa"@en ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#hasImproperPart> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> ;
    skos:altLabel "\\\\dot{P}^-"@en ;
    skos:scopeNote "Spatiotemporal (mereological) proper parthood relation"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#CognitiveStep> a owl:Class ;
    rdfs:label "CognitiveStep"@en ;
    rdfs:comment "Cognitive step, i.e., an elementary cognition that can form an part of a cognitive chain"^^xsd:string ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Cognition> ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#CognitiveRupture> <http://www.molmod.info/semantics/pims-ii.ttl#Metonymization> <http://www.molmod.info/semantics/pims-ii.ttl#Presupposition> <http://www.molmod.info/semantics/pims-ii.ttl#Semiosis> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> a owl:ObjectProperty ;
    rdfs:label "isSemioticallyConstitutiveOf"@en ;
    rdfs:comment "(x isSemioticallyConstitutiveOf y) means that the evaluation or association with x plays a role in the way in which y functions as a representamen - n.b, this does not entail physical parthood; e.g., if 'q = 2f(p)' is given, the expression 'f(p) = ... (some term involving q)' may be seen as semiotically constituive of the first expression, precisely because it contains the right-hand side that was missing"^^xsd:string ;
    rdfs:range [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ] ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isConstitutiveOf> ;
    skos:altLabel "\\\\v{C}"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "isProperPartOf"@en ;
    rdfs:comment "Spatiotemporal (mereological) proper parthood relation; (x isProperPartOf y) means that x is an improper part of y such that x and y are not the same, in other words, all points within x are also within y, but not vice versa"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isImproperPartOf>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isTemporallyIncludedIn> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#hasProperPart> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInPartToWhole> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInPartToWhole> ] ),
        ( [ owl:inverseOf rdf:first ] [ owl:inverseOf rdf:rest ] [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isFusionOf> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isNewReferentInWholeToPart> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isOldReferentInWholeToPart> ] ),
        ( [ owl:inverseOf rdf:first ] [ owl:inverseOf rdf:rest ] [ owl:inverseOf rdf:rest ] [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isFusionOf> ] ) .

<http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> a owl:ObjectProperty ;
    rdfs:label "hasRepresentamen"@en ;
    rdfs:comment "Dyadic representation relation; (x hasRepresentamen y) means that there is a cognitive step z such that (x isReferentIn z) and (y isRepresentamenIn z)"@en ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPHR>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msHRHPIP>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msHRIRHR> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#isReferentIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenIn> ] ) ;
    skos:altLabel "R^-"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#overlapsWith> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty ;
    rdfs:label "overlapsWith"@en ;
    rdfs:comment "(x overlapsWith y) means that x and y share a spatiotemporal region where x and y intersect"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#isSpatiotemporallyConnectedWith>,
        <http://www.molmod.info/semantics/pims-ii.ttl#temporallyOverlapsWith> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#hasImproperPart> <http://www.molmod.info/semantics/pims-ii.ttl#isImproperPartOf> ) .

<http://www.molmod.info/semantics/pims-ii.ttl#isMereosemioticallyRelatedTo> a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "isMereosemioticallyRelatedTo"@en ;
    rdfs:comment "Top mereosemiotic relation: Direct or indirect connection through mereotopological and semiotic relations"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> a owl:ObjectProperty ;
    rdfs:label "isRepresentamenFor"@en ;
    rdfs:comment "Dyadic representation relation; (x isRepresentamenFor y) means that there is a cognitive step z such that (x isRepresentamenIn z) and (y isReferentIn z)"^^xsd:string ;
    rdfs:subPropertyOf <http://www.molmod.info/semantics/pims-ii.ttl#msHPIPIR>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msIRHPIP>,
        <http://www.molmod.info/semantics/pims-ii.ttl#msIRHRIR> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ;
    owl:propertyChainAxiom ( <http://www.molmod.info/semantics/pims-ii.ttl#groundsNextStepIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isPresentStepInGrounding> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isReferentIn> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isGroundingPropositionIn> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isGroundingStepIn> ] ),
        ( <http://www.molmod.info/semantics/pims-ii.ttl#isIncludedInAccumulation> [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isObjectInAccumulation> ] ) .

<http://www.molmod.info/semantics/pims-ii.ttl#Object> a owl:Class ;
    rdfs:label "Object"@en ;
    rdfs:comment "Object (PIMS-II top class) = cognizable entity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#hasProperPart> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isSpatiotemporallyDisconnectedFrom> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#temporallyPrecedes> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ] ;
    owl:disjointUnionOf ( <http://www.molmod.info/semantics/pims-ii.ttl#Item> <http://www.molmod.info/semantics/pims-ii.ttl#MereotopologicalCollective> ) ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isProperPartOf> ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Object> ] ;
    skos:scopeNote "following Peirce, all that exists is regarded as cognizable, i.e., all in principle be referred to by a sign, hence the label 'Object'"@en .

