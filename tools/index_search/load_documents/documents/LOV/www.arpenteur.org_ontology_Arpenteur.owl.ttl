@prefix ns1: <http://purl.org/dc/elements/1.1/#> .
@prefix ns2: <http://xmlns.com/foaf/0.1/#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix onto: <http://www.arpenteur.org/ontology/Arpenteur.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    ns3:license <http://creativecommons.org/licenses/by/3.0/> ;
    ns1:contributor [ a ns2:Person ;
            ns2:mbox <http://www.arpenteur.org/ontology/mauro.saccone@gmail.com> ;
            ns2:name "Mauro SACCONE" ],
        [ a ns2:Person ;
            ns2:mbox <http://www.arpenteur.org/ontology/benellefi@gmail.com> ;
            ns2:name "Mohamed BEN ELLEFI" ],
        [ a ns2:Person ;
            ns2:mbox <http://www.arpenteur.org/ontology/Pierre.Drap@gmail.com> ;
            ns2:name "Pierre DRAP" ] ;
    ns1:creator [ a ns2:Person ;
            ns2:mbox <http://www.arpenteur.org/ontology/Pierre.Drap@gmail.com> ;
            ns2:name "Pierre DRAP" ] ;
    ns1:description "\\n\\t Arpenteur ontology is dedicated to photogrammetry, archeology and oceanology communities \\n\\t in order to perform tasks such as image processing, photogrammetry and modelling.\\n    " ;
    ns1:publisher [ a ns2:Person ;
            ns2:mbox <http://www.arpenteur.org/ontology/Pierre.Drap@gmail.com> ;
            ns2:name "Pierre DRAP" ] ;
    ns1:rights "Copyright © 2015 Pierre DRAP" ;
    ns1:title "Arpenteur Ontology" ;
    rdfs:comment "v. 0.0.10: Changing BoundingBoxParallel to BoundingBox ",
        "v. 0.0.13: Adding \"rdfs:label\" to all the resources in the ontology",
        "v. 0.0.1: general ontology dedicated to photogrammetric survey and measured object",
        "v. 0.0.2: Now unified ontology for photogrammetry and measured items ",
        "v. 0.0.3: Adding PetraData Class to manage several Siti ",
        "v. 0.0.4: Starting using time from CRM for stratigraphy ",
        "v. 0.0.5: Adding ashlar Bloc to stratigraphy ",
        "v. 0.0.5: Cancelling all FunctionalProperties ",
        "v. 0.0.6: Now Element coming from Architecture have a link toward a stratigraphic Unit ",
        "v. 0.0.7: Adding Stratigraphic relation between two ElementoStratigrafico. Before this version these relation was done with ID ",
        "v. 0.0.8: All link with E54 relation from CRM CIDOC are commented ",
        "v. 0.0.9: Introduction to redCoral " ;
    owl:imports <http://erlangen-crm.org/current/>,
        <http://www.arpenteur.org/ontology/ArpenteurBuiltInLibrary.owl>,
        <http://www.arpenteur.org/ontology/nadlShip-1.6.owl> ;
    owl:versionInfo "v. 0.0.1    2015/05/12",
        "v. 0.0.10   2017/04/23",
        "v. 0.0.11   2017/07/19",
        "v. 0.0.12   2017/08/02",
        "v. 0.0.13    2018/01/15",
        "v. 0.0.2    2016/03/14",
        "v. 0.0.3    2016/03/21",
        "v. 0.0.4    2016/07/08",
        "v. 0.0.5    2016/07/12",
        "v. 0.0.6    2017/03/19",
        "v. 0.0.7    2017/04/03",
        "v. 0.0.8    2017/04/04",
        "v. 0.0.9    2017/04/22" .

<http://www.arpenteur.org/ontology/Arpenteur.owl#AreaFunzionale> a owl:Class ;
    rdfs:label "Functional Area"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaArcheologica> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Attivita> a owl:Class ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#ElementoStratigrafico> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Brique> a owl:Class ;
    rdfs:label "brick"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#ElementDeParement> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#BundleModel> a owl:Class ;
    rdfs:label "bundle model"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#Model> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Cassettone> a owl:Class ;
    rdfs:label "ceiling box"@en,
        "caisson du plafond"@fr ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#ElementDeCouverture> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#ConstraintManager> a owl:Class ;
    rdfs:label "constraint manager"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#GenericManager> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#ControlPoint> a owl:Class ;
    rdfs:label "control point"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#IPoint3D> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Dolia> a owl:Class ;
    rdfs:label "dolia (dolium)"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#RecipientTransport> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#GrindingStone> a owl:Class ;
    rdfs:label "grinding stone"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#StoneTool> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#IFixedPoint> a owl:Class ;
    rdfs:label "interface fixed point"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#IPoint3D> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#NauticalArchaeology> a owl:Class ;
    rdfs:label "nautical archaeology"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#Archaeology> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Ollae> a owl:Class ;
    rdfs:label "Olla (e)"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#RecipientTransport> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#ProspettoGenerale> a owl:Class ;
    rdfs:label "general prospectus"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#Prospetto> ;
    owl:disjointWith <http://www.arpenteur.org/ontology/Arpenteur.owl#ProspettoParticolare> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Subergorgia> a owl:Class ;
    rdfs:label "Subergorgia"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#Alcyonacea> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#TuileRonde> a owl:Class ;
    rdfs:label "round tile"@en,
        "tuile ronde"@fr ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#Tuile> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaStratigraficaMurale> a owl:Class ;
    rdfs:label "mural stratigrafical unit"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaStratigrafica> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#belongToUSM> a owl:DatatypeProperty ;
    rdfs:label "belong to a mural stratigraphic unit"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> ;
    rdfs:range xsd:integer .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOf3DPoint> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of 3D points"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Point3DManager> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#IPoint3D> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOf3DPointWithObs> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of 3D point with observations"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#MeasuredPointManager> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#Point_3D> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOfCA> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of architectural complexes"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Sito> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#ComplessoArchitettonico> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOfCF> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of factory bodies"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#ComplessoArchitettonico> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#CorpoDiFabbrica> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOfCamera> a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of camera"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#CameraManager> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#Camera> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOfObservation> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of observations"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#ImagePointManager> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#ImagePoint> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOfPP> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of particular prospectuses"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#CorpoDiFabbrica> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#ProspettoParticolare> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOfSiti> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of city"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#PetraData> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#ManagerCA> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOfSito> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of cities"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#SitiList> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#Sito> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOfUS> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of stratigrafic units"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#CorpoDiFabbrica>,
        <http://www.arpenteur.org/ontology/Arpenteur.owl#Prospetto>,
        <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaTopografica> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaStratigrafica> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasASetOfUT> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a set of topographic units"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Sito> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaTopografica> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasBellyDiameter> a owl:DatatypeProperty ;
    rdfs:label "has belly diameter"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Amphorae> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasBoundingBox> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has bounding box"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#SpatialObject> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#BoundingBox> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCA> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has architectural complex"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#CorpoDiFabbrica> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#ComplessoArchitettonico> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCF> a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "has factory body"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaFunzionale> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#CorpoDiFabbrica> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCamera> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has camera"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Photograph> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#Camera> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCameraManager> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has a camera manager"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Model> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#CameraManager> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCenter> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has center"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaStratigrafica> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#IPoint3D> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCoef_K1> a owl:DatatypeProperty ;
    rdfs:label "has radial distortion coefficient K1"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#RadialDecenteringDistortion> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCoef_K2> a owl:DatatypeProperty ;
    rdfs:label "has radial distortion coefficient K2"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#RadialDecenteringDistortion> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCoef_K3> a owl:DatatypeProperty ;
    rdfs:label "has radial distortion coefficient K3"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#RadialDecenteringDistortion> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCoef_K4> a owl:DatatypeProperty ;
    rdfs:label "has radial distortion coefficient K4"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#RadialDecenteringDistortion> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCoef_P1> a owl:DatatypeProperty ;
    rdfs:label "has decentring distortion coefficient P1"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#RadialDecenteringDistortion> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCoef_P2> a owl:DatatypeProperty ;
    rdfs:label "has decentring distortion coefficient P2"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#RadialDecenteringDistortion> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasColor_B> a owl:DatatypeProperty ;
    rdfs:label "has color B"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#IColoredPoint> ;
    rdfs:range xsd:integer .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasColor_G> a owl:DatatypeProperty ;
    rdfs:label "has color G"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#IColoredPoint> ;
    rdfs:range xsd:integer .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasColor_R> a owl:DatatypeProperty ;
    rdfs:label "has color R"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#IColoredPoint> ;
    rdfs:range xsd:integer .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasComment> a owl:DatatypeProperty ;
    rdfs:label "has comment"@en ;
    rdfs:comment "manual evaluation of the Percent of necrosed part in a colony" ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#CoralliumRubrum> ;
    rdfs:range xsd:string .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasCorrelationCoef> a owl:DatatypeProperty ;
    rdfs:label "has correlation coefficient"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#ImagePoint> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasData> a owl:DatatypeProperty ;
    rdfs:label "has data"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaArcheologica> ;
    rdfs:range xsd:string .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasDefinition> a owl:DatatypeProperty ;
    rdfs:label "has definition"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaArcheologica> ;
    rdfs:range xsd:string .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasDescription> a owl:DatatypeProperty ;
    rdfs:label "has description"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaArcheologica> ;
    rdfs:range xsd:string .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasDiameter> a owl:DatatypeProperty ;
    rdfs:label "has diameter"@en ;
    rdfs:comment "Should be max Diameter" ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#RecipientTransport> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasDiameterNeck> a owl:DatatypeProperty ;
    rdfs:label "has diameter neck"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Amphorae> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasDiameterSupport> a owl:DatatypeProperty ;
    rdfs:label "has diameter support"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Amphorae> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasDirettore> a owl:DatatypeProperty ;
    rdfs:label "has direttore"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaArcheologica> ;
    rdfs:range xsd:string .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasDistanceHandles> a owl:DatatypeProperty ;
    rdfs:label "has distance handles"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Amphorae> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasDistortion> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has distortion"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Camera> ;
    rdfs:range <http://www.arpenteur.org/ontology/Arpenteur.owl#RadialDecenteringDistortion> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasExtrudeDepth> a owl:DatatypeProperty ;
    rdfs:label "has extrude depth"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasExtrudedData1> a owl:DatatypeProperty ;
    rdfs:label "has extruded data 1"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasExtrudedData2> a owl:DatatypeProperty ;
    rdfs:label "has extruded data 2"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasExtrudedPt1X> a owl:DatatypeProperty ;
    rdfs:label "has extruded point 1 X"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasExtrudedPt1Y> a owl:DatatypeProperty ;
    rdfs:label "has extruded point 1 Y"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasExtrudedPt1Z> a owl:DatatypeProperty ;
    rdfs:label "has extruded point 1 Z"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasExtrudedPt2X> a owl:DatatypeProperty ;
    rdfs:label "has extruded point 2 X"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> ;
    rdfs:range xsd:double .

<http://www.arpenteur.org/ontology/Arpenteur.owl#hasExtrudedPt2Y> a owl:DatatypeProperty ;
    rdfs:label "has extruded point 2 Y"@en ;
    rdfs:domain <http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> ;
