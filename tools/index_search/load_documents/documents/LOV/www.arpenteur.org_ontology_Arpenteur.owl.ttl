<http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaStratigrafica> a owl:Class ;
    rdfs:label "stratigrafical unit"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#ElementoStratigrafico> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#BoundingBox> a owl:Class ;
    rdfs:label "bounding box"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#MathematicalObject> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#IPoint3D> a owl:Class ;
    rdfs:label "interface point 3D"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#IPoint2D> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#ImagePoint> a owl:Class ;
    rdfs:label "image point"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#IPoint2D> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Point_3D> a owl:Class ;
    rdfs:label "point 3D"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#IColoredPoint>,
        <http://www.arpenteur.org/ontology/Arpenteur.owl#IPoint3D> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#RadialDecenteringDistortion> a owl:Class ;
    rdfs:label "radial decentring distortion"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#MathematicalObject> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#SpatialObject> a owl:Class ;
    rdfs:label "spatial object"@en ;
    rdfs:subClassOf <http://erlangen-crm.org/current/E18_Physical_Thing>,
        <http://www.arpenteur.org/ontology/Arpenteur.owl#SpatialLocalization> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Camera> a owl:Class ;
    rdfs:label "camera"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#Photogrammetry> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Photograph> a owl:Class ;
    rdfs:label "photograph"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#Photogrammetry> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#IIdentifiedObject> a owl:Class ;
    rdfs:label "interface identified object"@en ;
    rdfs:subClassOf owl:Thing .

<http://www.arpenteur.org/ontology/Arpenteur.owl#RotationMatrix> a owl:Class ;
    rdfs:label "rotation matrix"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://www.arpenteur.org/ontology/Arpenteur.owl#Transformation3D> ;
            owl:onProperty <http://www.arpenteur.org/ontology/Arpenteur.owl#hasRotationMatrix> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://www.arpenteur.org/ontology/Arpenteur.owl#Matrix> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Amphorae> a owl:Class ;
    rdfs:label "amphorae"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#RecipientTransport> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaArcheologica> a owl:Class ;
    rdfs:label "archaeological unit"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#Archaeology> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#Bloc> a owl:Class ;
    rdfs:label "block"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#ElementDeParement> .

<http://www.arpenteur.org/ontology/Arpenteur.owl#ElementoStratigrafico> a owl:Class ;
    rdfs:label "stratigraphic element"@en ;
    rdfs:subClassOf <http://www.arpenteur.org/ontology/Arpenteur.owl#UnitaArcheologica> .

