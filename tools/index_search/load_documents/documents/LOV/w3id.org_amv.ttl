        schema:OperatingSystem .

ns1:UserQueryProcessingAlgorithm a owl:NamedIndividual,
        ns1:Algorithm ;
    ns1:computesSolutionTo ns1:UserQueryProcessing ;
    ns1:hasSubalgorithm ns1:QueryProcessingAlgorithm .

