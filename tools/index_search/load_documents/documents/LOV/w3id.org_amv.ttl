ns1:QuickSort a owl:NamedIndividual,
        ns1:Algorithm ;
    dcterms:created "1961-01-01T00:00:00"^^rdfs:Literal ;
    dcterms:creator ns1:CARHoare ;
    dcterms:description "Average-case optimal divide and conquer comparison sorting algorithm."^^xsd:string,
        "Quicksort is a type of divide and conquer algorithm for sorting an array, based on a partitioning routine."^^xsd:string ;
    dcterms:identifier "https://rosettacode.org/wiki/Sorting_algorithms/Quicksort"^^rdfs:Literal ;
    dcterms:title "Quick Sort"^^xsd:string ;
    ns1:computesSolutionTo ns1:Sorting ;
    ns1:firstWrittenRecord "1959-01-01T00:00:00"^^xsd:dateTime ;
    ns1:hasSpaceComplexity ns1:QuickSortSpaceComplexity ;
    ns1:hasTimeComplexity ns1:QuickSortTimeComplexity ;
    ns1:isATypeOf ns1:DivideAndConquerAlgorithm ;
    ns1:pub_appearedIn <https://w3id.org/amv#Algorithm64:Quicksort> .

ns1:R a owl:NamedIndividual,
        ns1:ProgrammingLanguage .

ns1:RandomizedAlgorithm a owl:NamedIndividual,
        ns1:AlgorithmicType ;
    rdfs:comment "A randomized algorithm uses a random number at least once during the computation to make a decision."@en .

ns1:RecursiveAlgorithm a owl:NamedIndividual,
        ns1:AlgorithmicType ;
    rdfs:label "Recursive algorithm"@en ;
    rdfs:comment "A simple recursive algorithm: (i) Solves the base cases directly; (ii) Recurs with a simpler subproblem; (iii) Does some extra work to convert the solution to the simpler subproblem into a solution to the given problem. \\nIt is called “simple” because several of the other algorithm types are inherently recursive. (source: https://www.cis.upenn.edu/~matuszek/cit594-2003/Lectures/35-algorithm-types.ppt)"@en ;
    skos:AltLabel "Simple recursive algorithm"@en .

ns1:RedHatLinux a owl:NamedIndividual,
        schema:OperatingSystem .

ns1:SelectionSort a owl:NamedIndividual,
        ns1:Algorithm ;
    dcterms:description "Sorting Algorithm"^^xsd:string ;
    dcterms:identifier "https://rosettacode.org/wiki/Sorting_algorithms/Selection_sort"^^rdfs:Literal ;
    dcterms:title "Selection Sort"^^xsd:string ;
    ns1:computesSolutionTo ns1:Sorting ;
    ns1:dataStructureUsed ns1:Array ;
    ns1:hasImplementation ns1:SelectionSortImplementationInC ;
    ns1:hasSpaceComplexity ns1:SelectionSortSpaceComplexity ;
    ns1:hasTimeComplexity ns1:SelectionSortTimeComplexity .

ns1:SelmerMJohnson a owl:NamedIndividual,
        foaf:Person .

ns1:SetProblem a owl:Class ;
    rdfs:label "Set Problem"@en ;
    rdfs:comment "Sets are collections of symbols whose order is assumed to carry no significance."@en ;
    rdfs:subClassOf ns1:Problem .

ns1:SmoothSort a owl:NamedIndividual,
        ns1:Algorithm ;
    dcterms:created "1981-01-01T00:00:00"^^rdfs:Literal ;
    dcterms:creator ns1:EdsgerWDijkstra ;
    dcterms:description "A comparison-based sorting algorithm."^^xsd:string ;
    dcterms:title "Smooth Sort"^^xsd:string ;
    prov:wasDerivedFrom ns1:HeapSort ;
    ns1:computesSolutionTo ns1:Sorting ;
    ns1:dataStructureUsed ns1:Array ;
    ns1:hasSpaceComplexity ns1:SmoothSortSpaceComplexity ;
    ns1:hasTimeComplexity ns1:SmoothSortTimeComplexity ;
    ns1:pub_appearedIn ns1:SmoothSortAlternativeForSortingInSitu .

ns1:Statistics a owl:NamedIndividual,
        ns1:pub_Discipline .

ns1:StringProblem a owl:Class ;
    rdfs:label "String problem"@en ;
    rdfs:comment "Strings are defined by the sequence or arrangement of symbols"@en ;
    rdfs:subClassOf ns1:Problem .

ns1:StuartLloyd a owl:NamedIndividual,
