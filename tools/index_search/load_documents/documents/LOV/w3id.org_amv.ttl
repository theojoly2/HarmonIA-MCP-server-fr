ns1:TimSort a owl:NamedIndividual,
        ns1:Algorithm ;
    dcterms:created "2002-01-01T00:00:00"^^rdfs:Literal ;
    dcterms:creator ns1:TimPeters ;
    dcterms:description "Timsort is a hybrid stable sorting algorithm, derived from merge sort and insertion sort, designed to perform well on many kinds of real-world data."^^xsd:string ;
    dcterms:title "Tim Sort"^^xsd:string ;
    prov:wasDerivedFrom ns1:InsertionSort,
        ns1:MergeSort ;
    ns1:computesSolutionTo ns1:Sorting ;
    ns1:dataStructureUsed ns1:Array ;
    ns1:hasImplementation ns1:TimSortImplementedInPython ;
    ns1:hasSpaceComplexity ns1:TimSortSpaceComplexity ;
    ns1:hasTimeComplexity ns1:TimSortTimeComplexity .

