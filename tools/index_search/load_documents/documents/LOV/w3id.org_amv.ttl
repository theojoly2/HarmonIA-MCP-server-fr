ns1:HardProblem a owl:Class ;
    rdfs:label "Hard Problem"@en ;
    rdfs:comment "Any graph problem, which is NP-hard in general graphs, becomes polynomial-time solvable when restricted to graphs in special\\nclasses." ;
    rdfs:subClassOf ns1:GraphProblem .

ns1:HashTable a owl:NamedIndividual,
        ns1:DataStructure .

ns1:Hypergraph a owl:NamedIndividual,
        ns1:DataStructure ;
    rdfs:label "Hypergraph"@en ;
    rdfs:isDefinedBy "https://xlinux.nist.gov/dads/HTML/hypergraph.html"@en ;
    prov:specializationOf ns1:Graph ;
    ns1:definition "A graph whose hyperedges connect two or more vertices."^^xsd:string ;
    ns1:formalDefinition "A hypergraph G can be defined as a pair (V, E), where V is a set of vertices, and E is a set of hyperedges between the vertices. Each hyperedge is a set of vertices: E ⊆ {{u, v, …} ∈ 2V}. (Hyperedges are undirected.)"^^xsd:string .

