ns1:BacktrackingAlgorithm a owl:NamedIndividual,
        ns1:AlgorithmicType ;
    rdfs:comment "Backtracking algorithms are based on a depth-first recursive search."@en .

ns1:Basic a owl:NamedIndividual,
        ns1:ProgrammingLanguage .

ns1:BeadSort a owl:NamedIndividual,
        ns1:Algorithm ;
    dcterms:created "2002-01-01T00:00:00"^^rdfs:Literal ;
    dcterms:creator ns1:CristianSCalude,
        ns1:JoshuaJArulanandham,
        ns1:MichaelDinneen ;
    dcterms:description "A natural sorting algorithm."^^xsd:string ;
    dcterms:identifier "https://rosettacode.org/wiki/Sorting_algorithms/Bead_sort"^^rdfs:Literal ;
    dcterms:title "Bead Sort"^^xsd:string ;
    ns1:computesSolutionTo ns1:Sorting ;
    ns1:hasImplementation ns1:BeadSortInPython ;
    ns1:hasSpaceComplexity ns1:BeadSortSpaceComplexity ;
    ns1:hasTimeComplexity ns1:BeadSortTimeComplexity ;
    ns1:input "A set of positive integers."^^xsd:string ;
    ns1:inputImage ns1:BeadSort-R ;
    ns1:outputImage ns1:BeadSort-L ;
    ns1:pub_appearedIn <https://w3id.org/amv#BeadSort:ANaturalSortingAlgorithm> .

ns1:BellmanFormPerformanceMetric a owl:NamedIndividual,
        ns1:PerformanceMetric .

ns1:BestBinFirst a owl:NamedIndividual,
        ns1:Algorithm ;
    dcterms:description "Best bin first is a search algorithm that is designed to efficiently find an approximate solution to the nearest neighbor search problem in very-high-dimensional spaces."^^xsd:string ;
    dcterms:title "Best bin first"^^xsd:string .

ns1:BlockSort a owl:NamedIndividual,
        ns1:Algorithm ;
    dcterms:created "2008-01-01T00:00:00"^^rdfs:Literal ;
    dcterms:creator ns1:ArneKutzner,
        ns1:PokSonKim ;
    dcterms:description "Efficient sorting algorithm that combines insert and merge operations."^^xsd:string ;
    dcterms:title "Block Sort"^^xsd:string ;
    ns1:computesSolutionTo ns1:Sorting ;
    ns1:hasSpaceComplexity ns1:BlockSortSpaceComplexity ;
    ns1:hasTimeComplexity ns1:BlockSortTimeComplexity ;
    ns1:pub_appearedIn ns1:RatioBasedStableIn-placeMerging .

ns1:BranchAndBoundAlgorithm a owl:NamedIndividual,
        ns1:AlgorithmicType ;
    rdfs:comment "Branch and bound algorithms are generally used for optimization problems. \\nAs the algorithm progresses, a tree of subproblems is formed. \\nThe original problem is considered the “root problem”. A method is used to construct an upper and lower bound for a given problem. At each node, apply the bounding methods."@en .

ns1:BruteForceAlgorithm a owl:NamedIndividual,
        ns1:AlgorithmicType ;
    rdfs:comment "A brute force algorithm simply tries all possibilities until a satisfactory solution is found."@en .

ns1:BubbleSort a owl:NamedIndividual,
        ns1:Algorithm ;
    dcterms:description "Simple sorting algorithm that works by repeatedly swapping the adjacent elements."^^xsd:string ;
    dcterms:title "Bubble sort"^^xsd:string ;
    ns1:computesSolutionTo ns1:Sorting ;
    ns1:dataStructureUsed ns1:Array ;
    ns1:hasImplementation ns1:BubbleSortPseudocodeImplementation ;
    ns1:hasSpaceComplexity ns1:BubbleSortSpaceComplexity ;
    ns1:hasTimeComplexity ns1:BubbleSortTimeComplexity .

