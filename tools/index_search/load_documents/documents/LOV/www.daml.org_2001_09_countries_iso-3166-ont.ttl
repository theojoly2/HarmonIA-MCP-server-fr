@prefix ns1: <http://www.daml.org/2001/03/daml+oil#> .
@prefix onto: <http://www.daml.org/2001/09/countries/iso-3166-ont> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.daml.org/2001/09/countries/iso-3166-ont#Country> a rdfs:Class ;
    rdfs:subClassOf [ a ns1:Restriction ;
            ns1:cardinality "1" ;
            ns1:onProperty <http://www.daml.org/2001/09/countries/iso-3166-ont#code> ;
            ns1:toClass <http://www.w3.org/2000/10/XMLSchema#string> ],
        [ a ns1:Restriction ;
            ns1:cardinality "1" ;
            ns1:onProperty <http://www.daml.org/2001/09/countries/iso-3166-ont#name> ;
            ns1:toClass <http://www.w3.org/2000/10/XMLSchema#string> ],
        <http://www.daml.org/2001/09/countries/country-ont#Country> .

onto: a ns1:Ontology ;
    ns1:versionInfo "$Id: iso-3166-ont.daml,v 1.3 2003/08/11 23:26:13 mdean Exp $" ;
    rdfs:comment "ISO 3166 Country Codes" .

<http://www.daml.org/2001/09/countries/iso-3166-ont#code> a ns1:DatatypeProperty .

<http://www.daml.org/2001/09/countries/iso-3166-ont#name> a ns1:DatatypeProperty .

