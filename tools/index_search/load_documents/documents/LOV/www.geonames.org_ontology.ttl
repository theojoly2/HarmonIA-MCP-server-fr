@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/adms#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix ns3: <http://id.loc.gov/vocabulary/relators/> .
@prefix onto: <http://www.geonames.org/ontology> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    ns2:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:contributor "Erik Bolstad (norwegian and swedish translations)",
        "Roman Rachkov (bulgarian translation)",
        "Valery Hronusov (russian translation)" ;
    dcterms:creator <http://data.semanticweb.org/person/bernard-vatant> ;
    dcterms:description "The Geonames ontologies provides elements of description for geographical features, in particular those defined in the geonames.org data base"@en ;
    dcterms:issued "2006-10-14" ;
    dcterms:modified "2012-10-29" ;
    dcterms:publisher <http://dbpedia.org/resource/GeoNames> ;
    dcterms:title "The Geonames ontology"@en ;
    vann:preferredNamespacePrefix "gn" ;
    vann:preferredNamespaceUri "http://www.geonames.org/ontology#" ;
    rdfs:comment "Modifications from version 3.01 :\\n            Added : gn:GeonamesFeature, subclass of gn:Feature.\\n            Added : explicit property gn:geonamesID, mandatory and unique for each gn:GeonamesFeature instance.\\n            Deleted : owl:FunctionalProperty declarations for properties attached to gn:Feature, replaced by local cardinality restrictions on gn:GeonamesFeature\\n            The gn:Feature class and attached properties can therefore be used in the open world for features not necessarily identified in the Geonames data base, or with partial descriptions.\\n            Modified : Equivalent classes and superclasses of geonames:Feature in other vocabularies.\\n            Added : new feature codes for historical features.\\n            Improved metadata."@en ;
    rdfs:isDefinedBy <http://www.geonames.org/ontology/ontology_v3.1.rdf> ;
    owl:priorVersion <http://www.geonames.org/ontology/ontology_v3.0.1.rdf> ;
    owl:versionInfo "Version 3.1 - 2012-10-29"@en ;
    ns1:relatedDocumentation <http://www.geonames.org/ontology/documentation.html> ;
    foaf:homepage <http://www.geonames.org/ontology/documentation.html> .

<http://www.geonames.org/ontology#A.ADM1H> a <http://www.geonames.org/ontology#Code> ;
    skos:historyNote "Added in v3.1"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADM1H" ;
    skos:prefLabel "historical first-order administrative division"@en .

<http://www.geonames.org/ontology#A.ADM2H> a <http://www.geonames.org/ontology#Code> ;
    skos:historyNote "Added in v3.1"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADM2H" ;
    skos:prefLabel "historical second-order administrative division"@en .

<http://www.geonames.org/ontology#A.ADM3H> a <http://www.geonames.org/ontology#Code> ;
    skos:historyNote "Added in v3.1"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADM3H" ;
    skos:prefLabel "historical third-order administrative division"@en .

<http://www.geonames.org/ontology#A.ADM4H> a <http://www.geonames.org/ontology#Code> ;
    skos:historyNote "Added in v3.1"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADM4H" ;
    skos:prefLabel "historical fourth-order administrative division"@en .

<http://www.geonames.org/ontology#A.ADM5> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a subdivision of a fourth-order administrative division"@en ;
    skos:notation "A.ADM5" ;
    skos:prefLabel "fifth-order administrative division"@en .

<http://www.geonames.org/ontology#A.ADMD> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an administrative division of a country, undifferentiated as to administrative level"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADMD" ;
    skos:prefLabel "administrative division"@en .

<http://www.geonames.org/ontology#A.ADMH> a <http://www.geonames.org/ontology#Code> ;
    skos:historyNote "Added in v3.1"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADMH" ;
    skos:prefLabel "historical administrative division"@en .

<http://www.geonames.org/ontology#A.LTER> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a tract of land leased to another country, usually for military installations"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.LTER" ;
    skos:prefLabel "leased area"@en .

<http://www.geonames.org/ontology#A.PCL> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.PCL" ;
    skos:prefLabel "political entity"@en .

<http://www.geonames.org/ontology#A.PCLD> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.PCLD" ;
    skos:prefLabel "dependent political entity"@en .

<http://www.geonames.org/ontology#A.PCLF> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.PCLF" ;
    skos:prefLabel "freely associated state"@en .

<http://www.geonames.org/ontology#A.PCLH> a <http://www.geonames.org/ontology#Code> ;
    skos:historyNote "Added in v3.1"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.PCLH" ;
    skos:prefLabel "historical political entity"@en .

<http://www.geonames.org/ontology#A.PCLIX> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.PCLIX" ;
    skos:prefLabel "section of independent political entity"@en .

<http://www.geonames.org/ontology#A.PCLS> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.PCLS" ;
    skos:prefLabel "semi-independent political entity"@en .

<http://www.geonames.org/ontology#A.PPCLH> a <http://www.geonames.org/ontology#Code> ;
    skos:historyNote "Added in v3.1"@en ;
    skos:inScheme <http://www.geonames.org/ontology#P> ;
    skos:notation "A.PPCLH" ;
    skos:prefLabel "historical capital of a political entity"@en .

<http://www.geonames.org/ontology#A.PPLH> a <http://www.geonames.org/ontology#Code> ;
    skos:historyNote "Added in v3.1"@en ;
    skos:inScheme <http://www.geonames.org/ontology#P> ;
    skos:notation "A.PPLH" ;
    skos:prefLabel "historical populated place"@en .

<http://www.geonames.org/ontology#A.PRSH> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an ecclesiastical district"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.PRSH" ;
    skos:prefLabel "parish"@en .

<http://www.geonames.org/ontology#A.TERR> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.TERR" ;
    skos:prefLabel "territory"@en .

<http://www.geonames.org/ontology#A.ZN> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ZN" ;
    skos:prefLabel "zone"@en .

<http://www.geonames.org/ontology#A.ZNB> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a zone recognized as a buffer between two nations in which military presence is minimal or absent"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ZNB" ;
    skos:prefLabel "buffer zone"@en .

<http://www.geonames.org/ontology#GeonamesFeature> a owl:Class ;
    rdfs:label "Geonames Feature"@en ;
    rdfs:comment "A feature described in geonames database, uniquely defined by its geonames identifier"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#parentADM3> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#parentADM2> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#geonamesID> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#lat> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#parentADM4> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#name> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#parentADM1> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#parentADM4> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#countryCode> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#parentADM3> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#long> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#parentADM2> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#countryCode> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#featureClass> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#long> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#lat> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#population> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#geonamesID> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#population> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#name> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#featureClass> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.geonames.org/ontology#parentADM1> ],
        <http://www.geonames.org/ontology#Feature> ;
    skos:historyNote "Added in version 3.1"@en .

<http://www.geonames.org/ontology#H.AIRS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a place on a waterbody where floatplanes land and take off"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.AIRS" ;
    skos:prefLabel "seaplane landing area"@en .

<http://www.geonames.org/ontology#H.ANCH> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an area where vessels may anchor"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.ANCH" ;
    skos:prefLabel "anchorage"@en .

<http://www.geonames.org/ontology#H.BAY> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a coastal indentation between two capes or headlands, larger than a cove but smaller than a gulf"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.BAY" ;
    skos:prefLabel "bay"@en .

<http://www.geonames.org/ontology#H.BAYS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "coastal indentations between two capes or headlands, larger than a cove but smaller than a gulf"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.BAYS" ;
    skos:prefLabel "bays"@en .

<http://www.geonames.org/ontology#H.BGHT> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an open body of water forming a slight recession in a coastline"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.BGHT" ;
    skos:prefLabel "bight(s)"@en .

<http://www.geonames.org/ontology#H.BNK> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an elevation, typically located on a shelf, over which the depth of water is relatively shallow but sufficient for most surface navigation"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.BNK" ;
    skos:prefLabel "bank(s)"@en .

<http://www.geonames.org/ontology#H.BNKR> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a sloping margin of a stream channel which normally confines the stream to its channel on land"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.BNKR" ;
    skos:prefLabel "stream bank"@en .

<http://www.geonames.org/ontology#H.BNKX> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.BNKX" ;
    skos:prefLabel "section of bank"@en .

<http://www.geonames.org/ontology#H.BOG> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a wetland characterized by peat forming sphagnum moss, sedge, and other acid-water plants"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.BOG" ;
    skos:prefLabel "bog(s)"@en .

<http://www.geonames.org/ontology#H.CAPG> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a dome-shaped mass of glacial ice covering an area of  mountain summits or other high lands; smaller than an ice sheet"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CAPG" ;
    skos:prefLabel "icecap"@en .

<http://www.geonames.org/ontology#H.CHN> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "the deepest part of a stream, bay, lagoon, or strait, through which the main current flows"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CHN" ;
    skos:prefLabel "channel"@en .

<http://www.geonames.org/ontology#H.CHNL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "that part of a lake having water deep enough for navigation between islands, shoals, etc."@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CHNL" ;
    skos:prefLabel "lake channel(s)"@en .

<http://www.geonames.org/ontology#H.CHNM> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "that part of a body of water deep enough for navigation through an area otherwise not suitable"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CHNM" ;
    skos:prefLabel "marine channel"@en .

<http://www.geonames.org/ontology#H.CHNN> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a buoyed channel of sufficient depth for the safe navigation of vessels"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CHNN" ;
    skos:prefLabel "navigation channel"@en .

<http://www.geonames.org/ontology#H.CNFL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a place where two or more streams or intermittent streams flow together"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNFL" ;
    skos:prefLabel "confluence"@en .

<http://www.geonames.org/ontology#H.CNL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an artificial watercourse"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNL" ;
    skos:prefLabel "canal"@en .

<http://www.geonames.org/ontology#H.CNLA> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a conduit used to carry water"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNLA" ;
    skos:prefLabel "aqueduct"@en .

<http://www.geonames.org/ontology#H.CNLB> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a conspicuously curved or bent section of a canal"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNLB" ;
    skos:prefLabel "canal bend"@en .

<http://www.geonames.org/ontology#H.CNLD> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an artificial waterway carrying water away from a wetland or from drainage ditches"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNLD" ;
    skos:prefLabel "drainage canal"@en .

<http://www.geonames.org/ontology#H.CNLI> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a canal which serves as a main conduit for irrigation water"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNLI" ;
    skos:prefLabel "irrigation canal"@en .

<http://www.geonames.org/ontology#H.CNLN> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a watercourse constructed for navigation of vessels"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNLN" ;
    skos:prefLabel "navigation canal(s)"@en .

<http://www.geonames.org/ontology#H.CNLQ> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNLQ" ;
    skos:prefLabel "abandoned canal"@en .

<http://www.geonames.org/ontology#H.CNLSB> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a gently inclined underground tunnel bringing water for irrigation from aquifers"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNLSB" ;
    skos:prefLabel "underground irrigation canal(s)"@en .

<http://www.geonames.org/ontology#H.CNLX> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CNLX" ;
    skos:prefLabel "section of canal"@en .

<http://www.geonames.org/ontology#H.COVE> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a small coastal indentation, smaller than a bay"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.COVE" ;
    skos:prefLabel "cove(s)"@en .

<http://www.geonames.org/ontology#H.CRKT> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a meandering channel in a coastal wetland subject to bi-directional tidal currents"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CRKT" ;
    skos:prefLabel "tidal creek(s)"@en .

<http://www.geonames.org/ontology#H.CRNT> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a horizontal flow of water in a given direction with uniform velocity"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CRNT" ;
    skos:prefLabel "current"@en .

<http://www.geonames.org/ontology#H.CUTF> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a channel formed as a result of a stream cutting through a meander neck"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.CUTF" ;
    skos:prefLabel "cutoff"@en .

<http://www.geonames.org/ontology#H.DCK> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a waterway between two piers, or cut into the land for the berthing of ships"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.DCK" ;
    skos:prefLabel "dock(s)"@en .

<http://www.geonames.org/ontology#H.DCKB> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a part of a harbor where ships dock"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.DCKB" ;
    skos:prefLabel "docking basin"@en .

<http://www.geonames.org/ontology#H.DOMG> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a comparatively elevated area on an icecap"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.DOMG" ;
    skos:prefLabel "icecap dome"@en .

<http://www.geonames.org/ontology#H.DPRG> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a comparatively depressed area on an icecap"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.DPRG" ;
    skos:prefLabel "icecap depression"@en .

