<http://www.geonames.org/ontology#T.DPR> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a low area surrounded by higher land and usually characterized by interior drainage"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.DPR" ;
