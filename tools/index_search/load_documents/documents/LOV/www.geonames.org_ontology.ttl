<http://www.geonames.org/ontology#T.CNYN> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a deep, narrow valley with steep sides cutting into a plateau or mountainous area"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.CNYN" ;
    skos:prefLabel "canyon"@en .

<http://www.geonames.org/ontology#T.CONE> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a conical landform composed of mud or volcanic material"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.CONE" ;
    skos:prefLabel "cone(s)"@en .

<http://www.geonames.org/ontology#T.CRDR> a <http://www.geonames.org/ontology#Code> ;
