    skos:prefLabel "wadi mouth"@en .

<http://www.geonames.org/ontology#H.WADS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "valleys or ravines, bounded by relatively steep banks, which in the rainy season become watercourses; found primarily in North Africa and the Middle East"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.WADS" ;
    skos:prefLabel "wadies"@en .

<http://www.geonames.org/ontology#H.WADX> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.WADX" ;
    skos:prefLabel "section of wadi"@en .

<http://www.geonames.org/ontology#H.WHRL> a <http://www.geonames.org/ontology#Code> ;
