<http://www.geonames.org/ontology#T.DSRT> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a large area with little or no vegetation due to extreme environmental conditions"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.DSRT" ;
