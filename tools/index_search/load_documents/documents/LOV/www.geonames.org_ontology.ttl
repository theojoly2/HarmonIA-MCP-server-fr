    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.CRTR" ;
    skos:prefLabel "crater(s)"@en .

<http://www.geonames.org/ontology#T.CUET> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an asymmetric ridge formed on tilted strata"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.CUET" ;
    skos:prefLabel "cuesta(s)"@en .

<http://www.geonames.org/ontology#T.DLTA> a <http://www.geonames.org/ontology#Code> ;
