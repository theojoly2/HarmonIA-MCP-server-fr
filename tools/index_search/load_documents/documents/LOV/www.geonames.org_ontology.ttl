    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.GAP" ;
    skos:prefLabel "gap"@en .

<http://www.geonames.org/ontology#T.GRGE> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a short, narrow, steep-sided section of a stream valley"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.GRGE" ;
    skos:prefLabel "gorge(s)"@en .

<http://www.geonames.org/ontology#T.HDLD> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a high projection of land extending into a large body of water beyond the line of the coast"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.HDLD" ;
