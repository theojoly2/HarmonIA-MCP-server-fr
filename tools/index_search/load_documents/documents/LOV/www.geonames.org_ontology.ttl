<http://www.geonames.org/ontology#H.WLLQ> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.WLLQ" ;
    skos:prefLabel "abandoned well"@en .

<http://www.geonames.org/ontology#H.WLLS> a <http://www.geonames.org/ontology#Code> ;
