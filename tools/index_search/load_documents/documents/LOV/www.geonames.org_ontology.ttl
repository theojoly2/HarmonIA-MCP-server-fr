    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.ISLET" ;
    skos:prefLabel "islet"@en .

<http://www.geonames.org/ontology#T.ISLF> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an island created by landfill or diking and filling in a wetland, bay, or lagoon"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.ISLF" ;
