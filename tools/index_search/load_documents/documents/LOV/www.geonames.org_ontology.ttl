<http://www.geonames.org/ontology#H.STMI> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.STMI" ;
    skos:prefLabel "intermittent stream"@en .

<http://www.geonames.org/ontology#H.STMIX> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.STMIX" ;
    skos:prefLabel "section of intermittent stream"@en .

<http://www.geonames.org/ontology#H.STMM> a <http://www.geonames.org/ontology#Code> ;
