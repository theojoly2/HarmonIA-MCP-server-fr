    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.ISTH" ;
    skos:prefLabel "isthmus"@en .

<http://www.geonames.org/ontology#T.KRST> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a distinctive landscape developed on soluble rock such as limestone characterized by sinkholes, caves, disappearing streams, and underground drainage"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.KRST" ;
    skos:prefLabel "karst area"@en .

<http://www.geonames.org/ontology#T.LAVA> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an area of solidified lava"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.LAVA" ;
    skos:prefLabel "lava area"@en .

<http://www.geonames.org/ontology#T.LEV> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a natural low embankment bordering a distributary or meandering stream; often built up artificially to control floods"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.LEV" ;
    skos:prefLabel "levee"@en .

<http://www.geonames.org/ontology#T.MESA> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a flat-topped, isolated elevation with steep slopes on all sides, less extensive than a plateau"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.MESA" ;
    skos:prefLabel "mesa(s)"@en .

<http://www.geonames.org/ontology#T.MND> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a low, isolated, rounded hill"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.MND" ;
    skos:prefLabel "mound(s)"@en .

<http://www.geonames.org/ontology#T.MRN> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a mound, ridge, or other accumulation of glacial till"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.MRN" ;
    skos:prefLabel "moraine"@en .

<http://www.geonames.org/ontology#T.MT> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an elevation standing high above the surrounding area with small summit area, steep slopes and local relief of 300m or more"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.MT" ;
    skos:prefLabel "mountain"@en .

<http://www.geonames.org/ontology#T.MTS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a mountain range or a group of mountains or high ridges"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.MTS" ;
    skos:prefLabel "mountains"@en .

<http://www.geonames.org/ontology#T.NKM> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a narrow strip of land between the two limbs of a meander loop at its narrowest point"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.NKM" ;
    skos:prefLabel "meander neck"@en .

<http://www.geonames.org/ontology#T.NTK> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a rock or mountain peak protruding through glacial ice"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.NTK" ;
    skos:prefLabel "nunatak"@en .

<http://www.geonames.org/ontology#T.NTKS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "rocks or mountain peaks protruding through glacial ice"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.NTKS" ;
    skos:prefLabel "nunataks"@en .

<http://www.geonames.org/ontology#T.PAN> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a near-level shallow, natural depression or basin, usually containing an intermittent lake, pond, or pool"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PAN" ;
    skos:prefLabel "pan"@en .

<http://www.geonames.org/ontology#T.PANS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a near-level shallow, natural depression or basin, usually containing an intermittent lake, pond, or pool"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PANS" ;
    skos:prefLabel "pans"@en .

<http://www.geonames.org/ontology#T.PASS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a break in a mountain range or other high obstruction, used for transportation from one side to the other [See also gap]"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PASS" ;
    skos:prefLabel "pass"@en .

<http://www.geonames.org/ontology#T.PEN> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an elongate area of land projecting into a body of water and nearly surrounded by water"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PEN" ;
    skos:prefLabel "peninsula"@en .

<http://www.geonames.org/ontology#T.PENX> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PENX" ;
    skos:prefLabel "section of peninsula"@en .

<http://www.geonames.org/ontology#T.PK> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a pointed elevation atop a mountain, ridge, or other hypsographic feature"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PK" ;
    skos:prefLabel "peak"@en .

<http://www.geonames.org/ontology#T.PKS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "pointed elevations atop a mountain, ridge, or other hypsographic features"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PKS" ;
    skos:prefLabel "peaks"@en .

<http://www.geonames.org/ontology#T.PLAT> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an elevated plain with steep slopes on one or more sides, and often with incised streams"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PLAT" ;
    skos:prefLabel "plateau"@en .

<http://www.geonames.org/ontology#T.PLATX> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PLATX" ;
    skos:prefLabel "section of plateau"@en .

<http://www.geonames.org/ontology#T.PLDR> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an area reclaimed from the sea by diking and draining"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PLDR" ;
    skos:prefLabel "polder"@en .

<http://www.geonames.org/ontology#T.PLN> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an extensive area of comparatively level to gently undulating land, lacking surface irregularities, and usually adjacent to a higher area"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PLN" ;
    skos:prefLabel "plain(s)"@en .

<http://www.geonames.org/ontology#T.PLNX> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PLNX" ;
    skos:prefLabel "section of plain"@en .

<http://www.geonames.org/ontology#T.PROM> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a bluff or prominent hill overlooking or projecting into a lowland"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PROM" ;
    skos:prefLabel "promontory(-ies)"@en .

<http://www.geonames.org/ontology#T.PT> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a tapering piece of land projecting into a body of water, less prominent than a cape"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PT" ;
    skos:prefLabel "point"@en .

<http://www.geonames.org/ontology#T.PTS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "tapering pieces of land projecting into a body of water, less prominent than a cape"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.PTS" ;
    skos:prefLabel "points"@en .

<http://www.geonames.org/ontology#T.RDGB> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a ridge of sand just inland and parallel to the beach, usually in series"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.RDGB" ;
    skos:prefLabel "beach ridge"@en .

<http://www.geonames.org/ontology#T.RDGE> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a long narrow elevation with steep sides, and a more or less continuous crest"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.RDGE" ;
    skos:prefLabel "ridge(s)"@en .

<http://www.geonames.org/ontology#T.REG> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a desert plain characterized by a surface veneer of gravel and stones"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.REG" ;
    skos:prefLabel "stony desert"@en .

<http://www.geonames.org/ontology#T.RK> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a conspicuous, isolated rocky mass"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.RK" ;
    skos:prefLabel "rock"@en .

<http://www.geonames.org/ontology#T.RKFL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an irregular mass of fallen rock at the base of a cliff or steep slope"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.RKFL" ;
    skos:prefLabel "rockfall"@en .

<http://www.geonames.org/ontology#T.RKS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "conspicuous, isolated rocky masses"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.RKS" ;
    skos:prefLabel "rocks"@en .

<http://www.geonames.org/ontology#T.SAND> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a tract of land covered with sand"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SAND" ;
    skos:prefLabel "sand area"@en .

<http://www.geonames.org/ontology#T.SBED> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a channel formerly containing the water of a stream"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SBED" ;
    skos:prefLabel "dry stream bed"@en .

<http://www.geonames.org/ontology#T.SCRP> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a long line of cliffs or steep slopes separating level surfaces above and below"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SCRP" ;
    skos:prefLabel "escarpment"@en .

<http://www.geonames.org/ontology#T.SDL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a broad, open pass crossing a ridge or between hills or mountains"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SDL" ;
    skos:prefLabel "saddle"@en .

<http://www.geonames.org/ontology#T.SHOR> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a narrow zone bordering a waterbody which covers and uncovers at high and low water, respectively"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SHOR" ;
    skos:prefLabel "shore"@en .

<http://www.geonames.org/ontology#T.SINK> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a small crater-shape depression in a karst area"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SINK" ;
    skos:prefLabel "sinkhole"@en .

<http://www.geonames.org/ontology#T.SLID> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a mound of earth material, at the base of a slope and the associated scoured area"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SLID" ;
    skos:prefLabel "slide"@en .

<http://www.geonames.org/ontology#T.SLP> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a surface with a relatively uniform slope angle"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SLP" ;
    skos:prefLabel "slope(s)"@en .

<http://www.geonames.org/ontology#T.SPIT> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a narrow, straight or curved continuation of a beach into a waterbody"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SPIT" ;
    skos:prefLabel "spit"@en .

<http://www.geonames.org/ontology#T.SPUR> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a subordinate ridge projecting outward from a hill, mountain or other elevation"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.SPUR" ;
    skos:prefLabel "spur(s)"@en .

<http://www.geonames.org/ontology#T.TAL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a steep concave slope formed by an accumulation of loose rock fragments at the base of a cliff or steep slope"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.TAL" ;
    skos:prefLabel "talus slope"@en .

<http://www.geonames.org/ontology#T.TRGD> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a long wind-swept trough between parallel longitudinal dunes"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.TRGD" ;
    skos:prefLabel "interdune trough(s)"@en .

<http://www.geonames.org/ontology#T.TRR> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a long, narrow alluvial platform bounded by steeper slopes above and below, usually overlooking a waterbody"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.TRR" ;
    skos:prefLabel "terrace"@en .

<http://www.geonames.org/ontology#T.UPLD> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an extensive interior region of high land with low to moderate surface relief"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.UPLD" ;
    skos:prefLabel "upland"@en .

<http://www.geonames.org/ontology#T.VAL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an elongated depression usually traversed by a stream"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.VAL" ;
    skos:prefLabel "valley"@en .

<http://www.geonames.org/ontology#T.VALG> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a valley the floor of which is notably higher than the valley or shore to which it leads; most common in areas that have been glaciated"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.VALG" ;
    skos:prefLabel "hanging valley"@en .

<http://www.geonames.org/ontology#T.VALS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "elongated depressions usually traversed by a stream"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.VALS" ;
    skos:prefLabel "valleys"@en .

<http://www.geonames.org/ontology#T.VALX> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.VALX" ;
    skos:prefLabel "section of valley"@en .

<http://www.geonames.org/ontology#T.VLC> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a conical elevation composed of volcanic materials with a crater at the top"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.VLC" ;
    skos:prefLabel "volcano"@en .

<http://www.geonames.org/ontology#U.APNU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a gentle slope, with a generally smooth surface, particularly found around groups of islands and seamounts"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.APNU" ;
    skos:prefLabel "apron"@en .

<http://www.geonames.org/ontology#U.ARCU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a low bulge around the southeastern end of the island of Hawaii"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.ARCU" ;
    skos:prefLabel "arch"@en .

<http://www.geonames.org/ontology#U.ARRU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an area of subdued corrugations off Baja California"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.ARRU" ;
    skos:prefLabel "arrugado"@en .

<http://www.geonames.org/ontology#U.BDLU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a region adjacent to a continent, normally occupied by or bordering a shelf, that is highly irregular with depths well in excess of those typical of a shelf"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.BDLU" ;
    skos:prefLabel "borderland"@en .

<http://www.geonames.org/ontology#U.BKSU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "elevations, typically located on a shelf, over which the depth of water is relatively shallow but sufficient for safe surface navigation"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.BKSU" ;
    skos:prefLabel "banks"@en .

<http://www.geonames.org/ontology#U.BNCU> a <http://www.geonames.org/ontology#Code> ;
    owl:deprecated true ;
    skos:definition "a small terrace"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.BNCU" ;
    skos:prefLabel "bench"@en .

<http://www.geonames.org/ontology#U.BNKU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an elevation, typically located on a shelf, over which the depth of water is relatively shallow but sufficient for safe surface navigation"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.BNKU" ;
    skos:prefLabel "bank"@en .

<http://www.geonames.org/ontology#U.BSNU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a depression more or less equidimensional in plan and of variable extent"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.BSNU" ;
    skos:prefLabel "basin"@en .

<http://www.geonames.org/ontology#U.CDAU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an entire mountain system including the subordinate ranges, interior plateaus, and basins"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.CDAU" ;
    skos:prefLabel "cordillera"@en .

<http://www.geonames.org/ontology#U.CNSU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "relatively narrow, deep depressions with steep sides, the bottom of which generally has a continuous slope"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.CNSU" ;
    skos:prefLabel "canyons"@en .

<http://www.geonames.org/ontology#U.CNYU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a relatively narrow, deep depression with steep sides, the bottom of which generally has a continuous slope"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.CNYU" ;
    skos:prefLabel "canyon"@en .

<http://www.geonames.org/ontology#U.CRSU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a gentle slope rising from oceanic depths towards the foot of a continental slope"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.CRSU" ;
    skos:prefLabel "continental rise"@en .

<http://www.geonames.org/ontology#U.DEPU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a localized deep area within the confines of a larger feature, such as a trough, basin or trench"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.DEPU" ;
    skos:prefLabel "deep"@en .

<http://www.geonames.org/ontology#U.EDGU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a line along which there is a marked increase of slope at the outer margin of a continental shelf or island shelf"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.EDGU" ;
    skos:prefLabel "shelf edge"@en .

<http://www.geonames.org/ontology#U.ESCU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an elongated and comparatively steep slope separating flat or gently sloping areas"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.ESCU" ;
    skos:prefLabel "escarpment (or scarp)"@en .

<http://www.geonames.org/ontology#U.FANU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a relatively smooth feature normally sloping away from the lower termination of a canyon or canyon system"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.FANU" ;
    skos:prefLabel "fan"@en .

<http://www.geonames.org/ontology#U.FLTU> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a small level or nearly level area"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.FLTU" ;
    skos:prefLabel "flat"@en .

<http://www.geonames.org/ontology#U.FRKU> a <http://www.geonames.org/ontology#Code> ;
    owl:deprecated true ;
    skos:definition "a branch of a canyon or valley"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.FRKU" ;
    skos:prefLabel "fork"@en .

<http://www.geonames.org/ontology#U.FRSU> a <http://www.geonames.org/ontology#Code> ;
    owl:deprecated true ;
    skos:definition "a branch of a canyon or valley"@en ;
    skos:inScheme <http://www.geonames.org/ontology#U> ;
    skos:notation "U.FRSU" ;
    skos:prefLabel "forks"@en .

