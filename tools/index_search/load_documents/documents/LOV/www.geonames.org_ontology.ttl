<http://www.geonames.org/ontology#T.HLLS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "rounded elevations of limited extent rising above the surrounding land with local relief of less than 300m"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.HLLS" ;
    skos:prefLabel "hills"@en .

<http://www.geonames.org/ontology#T.HMCK> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a patch of ground, distinct from and slightly above the surrounding plain or wetland. Often occurs in groups"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.HMCK" ;
    skos:prefLabel "hammock(s)"@en .

<http://www.geonames.org/ontology#T.HMDA> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a relatively sand-free, high bedrock plateau in a hot desert, with or without a gravel veneer"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.HMDA" ;
    skos:prefLabel "rock desert"@en .

<http://www.geonames.org/ontology#T.INTF> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a relatively undissected upland between adjacent stream valleys"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.INTF" ;
    skos:prefLabel "interfluve"@en .

<http://www.geonames.org/ontology#T.ISL> a <http://www.geonames.org/ontology#Code> ;
