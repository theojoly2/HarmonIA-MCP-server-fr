<http://www.geonames.org/ontology#T.HLL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a rounded elevation of limited extent rising above the surrounding land with local relief of less than 300m"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.HLL" ;
