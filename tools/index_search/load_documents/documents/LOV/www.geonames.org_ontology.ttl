    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.DUNE" ;
    skos:prefLabel "dune(s)"@en .

<http://www.geonames.org/ontology#T.DVD> a <http://www.geonames.org/ontology#Code> ;
