<http://www.geonames.org/ontology#T.FAN> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a fan-shaped wedge of coarse alluvium with apex merging with a mountain stream bed and the fan spreading out at a low angle slope onto an adjacent plain"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.FAN" ;
    skos:prefLabel "fan(s)"@en .

<http://www.geonames.org/ontology#T.FORD> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a shallow part of a stream which can be crossed on foot or by land vehicle"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.FORD" ;
    skos:prefLabel "ford"@en .

<http://www.geonames.org/ontology#T.FSR> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a crack associated with volcanism"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.FSR" ;
    skos:prefLabel "fissure"@en .

<http://www.geonames.org/ontology#T.GAP> a <http://www.geonames.org/ontology#Code> ;
