    skos:inScheme <http://www.geonames.org/ontology#V> ;
    skos:notation "V.VINS" ;
    skos:prefLabel "vineyards"@en .

<http://www.geonames.org/ontology#childrenFeatures> a owl:ObjectProperty ;
    rdfs:label "children features"@en ;
    rdfs:comment "Links to an RDF document containing the descriptions of children features"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#RDFData> .

<http://www.geonames.org/ontology#colloquialName> a owl:DatatypeProperty ;
    rdfs:label "colloquial name"@en ;
    rdfs:subPropertyOf <http://www.geonames.org/ontology#alternateName> .

<http://www.geonames.org/ontology#historicalName> a owl:DatatypeProperty ;
    rdfs:label "historical name"@en ;
    rdfs:subPropertyOf <http://www.geonames.org/ontology#alternateName> .

<http://www.geonames.org/ontology#locatedIn> a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:comment "Indicates that the subject resource is located in the object feature"@en ;
    rdfs:range <http://www.geonames.org/ontology#Feature> .

<http://www.geonames.org/ontology#locationMap> a owl:ObjectProperty ;
    rdfs:label "map"@en ;
    rdfs:comment "A geonames map centered on the feature."@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#Map> .

<http://www.geonames.org/ontology#nearby> a owl:ObjectProperty ;
    rdfs:label "nearby"@en ;
    rdfs:comment "A feature close to the reference feature"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#Feature> .

<http://www.geonames.org/ontology#nearbyFeatures> a owl:ObjectProperty ;
    rdfs:label "nearby features"@en ;
    rdfs:comment "Links to an RDF document containing the descriptions of nearby features"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#RDFData> .

<http://www.geonames.org/ontology#neighbour> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "neighbour"@en ;
    rdfs:comment "A feature sharing a common boarder with the reference feature"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#Feature> .

<http://www.geonames.org/ontology#neighbouringFeatures> a owl:ObjectProperty ;
    rdfs:label "neighbouring features"@en ;
    rdfs:comment "Links to an RDF document containing the descriptions of neighbouring features. Applies when the feature has definite boarders."@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#RDFData> .

<http://www.geonames.org/ontology#officialName> a owl:DatatypeProperty ;
    rdfs:label "official name"@en ;
    rdfs:comment "A name in an official local language"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:subPropertyOf skos:prefLabel .

<http://www.geonames.org/ontology#parentCountry> a owl:ObjectProperty ;
    rdfs:label "parent country"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.PCLI> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.PCLI> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ] ;
    rdfs:subPropertyOf <http://www.geonames.org/ontology#parentFeature> .

<http://www.geonames.org/ontology#postalCode> a owl:DatatypeProperty ;
    rdfs:label "postal code"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> .

<http://www.geonames.org/ontology#shortName> a owl:DatatypeProperty ;
    rdfs:label "short name"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:subPropertyOf <http://www.geonames.org/ontology#alternateName> .

<http://www.geonames.org/ontology#wikipediaArticle> a owl:ObjectProperty ;
    rdfs:label "wikipedia article"@en ;
    rdfs:comment "A Wikipedia article of which subject is the resource."@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#WikipediaArticle> .

skos:notation a owl:DatatypeProperty ;
    rdfs:label "notation"@en ;
    rdfs:comment "Used to store the values of feature codes"@en .

foaf:name a owl:DatatypeProperty .

<http://data.semanticweb.org/person/bernard-vatant> a foaf:Person ;
    foaf:name "Bernard Vatant" ;
    foaf:page <http://blog.hubjects.com> ;
    foaf:workplaceHomepage <http://www.mondeca.com> .

<http://dbpedia.org/resource/GeoNames> a foaf:Organization ;
    ns3:dtm <http://www.geonames.org/ontology#Marc-Wick> ;
    foaf:homepage <http://www.geonames.org> ;
    foaf:name "GeoNames" .

<http://www.geonames.org/ontology#Map> a owl:Class ;
    rdfs:label "Map"@en ;
    rdfs:comment "A Web page displaying a map"@en ;
    rdfs:subClassOf foaf:Document .

<http://www.geonames.org/ontology#Marc-Wick> a foaf:Person ;
    foaf:name "Marc Wick" .

<http://www.geonames.org/ontology#WikipediaArticle> a owl:Class ;
    rdfs:label "Wikipedia Article"@en ;
    rdfs:comment "A Wikipedia article"@en ;
    rdfs:subClassOf foaf:Document .

skos:prefLabel a owl:DatatypeProperty .

<http://www.geonames.org/ontology#A.ADM1> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a primary administrative division of a country, such as a state in the United States"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADM1" ;
    skos:prefLabel "first-order administrative division"@en .

<http://www.geonames.org/ontology#A.ADM2> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a subdivision of a first-order administrative division"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADM2" ;
    skos:prefLabel "second-order administrative division"@en .

<http://www.geonames.org/ontology#A.ADM3> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a subdivision of a second-order administrative division"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADM3" ;
    skos:prefLabel "third-order administrative division"@en .

<http://www.geonames.org/ontology#A.ADM4> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a subdivision of a third-order administrative division"@en ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.ADM4" ;
    skos:prefLabel "fourth-order administrative division"@en .

<http://www.geonames.org/ontology#A.PCLI> a <http://www.geonames.org/ontology#Code> ;
    skos:inScheme <http://www.geonames.org/ontology#A> ;
    skos:notation "A.PCLI" ;
    skos:prefLabel "independent political entity"@en .

<http://www.geonames.org/ontology#countryCode> a owl:DatatypeProperty ;
    rdfs:label "ISO country code"@en ;
    rdfs:comment "A two letters country code in the ISO 3166 list"@en,
        "The countryCode value for a Geoname Feature is equal to the countryCode value of the parentCountry value."@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> .

<http://www.geonames.org/ontology#featureClass> a owl:ObjectProperty ;
    rdfs:label "feature class"@en ;
    rdfs:comment "The main category of the feature, as defined in geonames taxonomy."@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#Class> ;
    rdfs:subPropertyOf dcterms:type ;
    owl:propertyChainAxiom ( <http://www.geonames.org/ontology#featureCode> skos:inScheme ),
        ( <http://www.geonames.org/ontology#featureCode> skos:inScheme ) .

<http://www.geonames.org/ontology#geonamesID> a owl:DatatypeProperty ;
    rdfs:label "geonames identifier"@en ;
    rdfs:subPropertyOf dcterms:identifier ;
    skos:historyNote "Added in version 3.1"@en .

<http://www.geonames.org/ontology#name> a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "The main international name of a feature. The value has no xml:lang tag."@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> .

<http://www.geonames.org/ontology#parentADM1> a owl:ObjectProperty ;
    rdfs:label "level 1 administrative parent"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM1> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM1> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ] ;
    rdfs:subPropertyOf <http://www.geonames.org/ontology#parentFeature> .

<http://www.geonames.org/ontology#parentADM2> a owl:ObjectProperty ;
    rdfs:label "level 2 administrative parent"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM2> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM2> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ] ;
    rdfs:subPropertyOf <http://www.geonames.org/ontology#parentFeature> .

<http://www.geonames.org/ontology#parentADM3> a owl:ObjectProperty ;
    rdfs:label "level 3 administrative parent"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM3> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM3> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ] ;
    rdfs:subPropertyOf <http://www.geonames.org/ontology#parentFeature> .

<http://www.geonames.org/ontology#parentADM4> a owl:ObjectProperty ;
    rdfs:label "level 4 administrative parent"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM4> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM4> ;
            owl:onProperty <http://www.geonames.org/ontology#featureCode> ] ;
    rdfs:subPropertyOf <http://www.geonames.org/ontology#parentFeature> .

<http://www.geonames.org/ontology#population> a owl:DatatypeProperty ;
    rdfs:label "population"@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range xsd:integer .

<http://www.geonames.org/ontology#RDFData> a owl:Class ;
    rdfs:label "RDF Data"@en ;
    rdfs:comment "A Document containing RDF description of one or several features."@en ;
    rdfs:subClassOf foaf:Document .

<http://www.geonames.org/ontology#alternateName> a owl:DatatypeProperty ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:subPropertyOf skos:altLabel .

<http://www.geonames.org/ontology#parentFeature> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "parent feature"@en ;
    rdfs:comment "A feature parent of the current one, in either administrative or physical subdivision."@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#Feature> .

<http://www.geonames.org/ontology#Class> a owl:Class ;
    rdfs:label "Class"@en ;
    rdfs:comment "A class of features."@en ;
    rdfs:subClassOf skos:ConceptScheme .

<http://www.geonames.org/ontology#featureCode> a owl:ObjectProperty ;
    rdfs:label "feature code"@en ;
    rdfs:comment "Type of the feature, as defined in geonames taxonomy."@en ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:range <http://www.geonames.org/ontology#Code> ;
    rdfs:subPropertyOf dcterms:type .

<http://www.geonames.org/ontology#P> a <http://www.geonames.org/ontology#Class> ;
    rdfs:comment "city, village,..."@en .

<http://www.geonames.org/ontology#V> a <http://www.geonames.org/ontology#Class> ;
    rdfs:comment "forest, heath, ..."@en .

<http://www.geonames.org/ontology#A> a <http://www.geonames.org/ontology#Class> ;
    rdfs:comment "country, state, region ..."@en .

<http://www.geonames.org/ontology#R> a <http://www.geonames.org/ontology#Class> ;
    rdfs:comment "road, railroad, ..."@en .

<http://www.geonames.org/ontology#Feature> a owl:Class ;
    rdfs:label "Feature"@en ;
    rdfs:comment "A geographical feature"@en ;
    rdfs:subClassOf <http://schema.org/Place>,
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    owl:equivalentClass <http://geovocab.org/spatial#Feature>,
        <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> ;
    skos:historyNote "Modified in version 3.1 : The cardinality constraints on feature code, feature class are relaxed on this class, and put on the specific subclass Geonames Feature. This class and attached properties can therefore be used for features not necessarily identified in the Geoanmes data base"@en .

<http://www.geonames.org/ontology#L> a <http://www.geonames.org/ontology#Class> ;
    rdfs:comment "parks,area, ..."@en .

<http://www.geonames.org/ontology#U> a <http://www.geonames.org/ontology#Class> ;
    rdfs:comment "undersea"@en .

<http://www.geonames.org/ontology#T> a <http://www.geonames.org/ontology#Class> ;
    rdfs:comment "mountain, hill, rock, ..."@en .

<http://www.geonames.org/ontology#H> a <http://www.geonames.org/ontology#Class> ;
    rdfs:comment "stream, lake, ..."@en .

<http://www.geonames.org/ontology#S> a <http://www.geonames.org/ontology#Class> ;
    rdfs:comment "spot, building, farm, ..."@en .

<http://www.geonames.org/ontology#Code> a owl:Class ;
    rdfs:label "Code"@en ;
    rdfs:comment "A feature code."@en ;
    rdfs:subClassOf skos:Concept .

