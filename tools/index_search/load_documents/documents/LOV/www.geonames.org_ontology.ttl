<http://www.geonames.org/ontology#S.ZOO> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a zoological garden or park where wild animals are kept for exhibition"@en ;
    skos:inScheme <http://www.geonames.org/ontology#S> ;
    skos:notation "S.ZOO" ;
    skos:prefLabel "zoo"@en .

<http://www.geonames.org/ontology#T.ASPH> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a small basin containing naturally occurring asphalt"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.ASPH" ;
    skos:prefLabel "asphalt lake"@en .

<http://www.geonames.org/ontology#T.ATOL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a ring-shaped coral reef which has closely spaced islands on it encircling a lagoon"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.ATOL" ;
    skos:prefLabel "atoll(s)"@en .

<http://www.geonames.org/ontology#T.BAR> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a shallow ridge or mound of coarse unconsolidated material in a stream channel, at the mouth of a stream, estuary, or lagoon and in the wave-break zone along coasts"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.BAR" ;
    skos:prefLabel "bar"@en .

<http://www.geonames.org/ontology#T.BCH> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a shore zone of coarse unconsolidated sediment that extends from the low-water line to the highest reach of storm waves"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.BCH" ;
    skos:prefLabel "beach"@en .

<http://www.geonames.org/ontology#T.BCHS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a shore zone of coarse unconsolidated sediment that extends from the low-water line to the highest reach of storm waves"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.BCHS" ;
    skos:prefLabel "beaches"@en .

<http://www.geonames.org/ontology#T.BDLD> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "an area characterized by a maze of very closely spaced, deep, narrow, steep-sided ravines, and sharp crests and pinnacles"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.BDLD" ;
    skos:prefLabel "badlands"@en .

<http://www.geonames.org/ontology#T.BLDR> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a high altitude or high latitude bare, flat area covered with large angular rocks"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.BLDR" ;
    skos:prefLabel "boulder field"@en .

<http://www.geonames.org/ontology#T.BLHL> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a hole in coastal rock through which sea water is forced by a rising tide or waves and spurted through an outlet into the air"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.BLHL" ;
    skos:prefLabel "blowhole(s)"@en .

<http://www.geonames.org/ontology#T.BLOW> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a small depression in sandy terrain, caused by wind erosion"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.BLOW" ;
    skos:prefLabel "blowout(s)"@en .

<http://www.geonames.org/ontology#T.BNCH> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a long, narrow bedrock platform bounded by steeper slopes above and below, usually overlooking a waterbody"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.BNCH" ;
    skos:prefLabel "bench"@en .

<http://www.geonames.org/ontology#T.BUTE> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a small, isolated, usually flat-topped hill with steep sides"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.BUTE" ;
    skos:prefLabel "butte(s)"@en .

<http://www.geonames.org/ontology#T.CAPE> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a land area, more prominent than a point, projecting into the sea and marking a notable change in coastal direction"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.CAPE" ;
    skos:prefLabel "cape"@en .

<http://www.geonames.org/ontology#T.CFT> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a deep narrow slot, notch, or groove in a coastal cliff"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.CFT" ;
    skos:prefLabel "cleft(s)"@en .

<http://www.geonames.org/ontology#T.CLDA> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a depression measuring kilometers across formed by the collapse of a volcanic mountain"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
