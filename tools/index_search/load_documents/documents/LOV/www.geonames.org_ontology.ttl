<http://www.geonames.org/ontology#H.STMB> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "a conspicuously curved or bent segment of a stream"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.STMB" ;
    skos:prefLabel "stream bend"@en .

<http://www.geonames.org/ontology#H.STMC> a <http://www.geonames.org/ontology#Code> ;
