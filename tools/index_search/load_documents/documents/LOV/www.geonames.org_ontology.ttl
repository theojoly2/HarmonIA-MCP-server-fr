<http://www.geonames.org/ontology#T.CRQS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "bowl-like hollows partially surrounded by cliffs or steep slopes at the head of a glaciated valley"@en ;
    skos:inScheme <http://www.geonames.org/ontology#T> ;
    skos:notation "T.CRQS" ;
