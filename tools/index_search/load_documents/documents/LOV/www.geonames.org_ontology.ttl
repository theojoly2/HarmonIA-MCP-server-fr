<http://www.geonames.org/ontology#H.STMS> a <http://www.geonames.org/ontology#Code> ;
    skos:definition "bodies of running water moving to a lower level in a channel on land"@en ;
    skos:inScheme <http://www.geonames.org/ontology#H> ;
    skos:notation "H.STMS" ;
    skos:prefLabel "streams"@en .

<http://www.geonames.org/ontology#H.STMSB> a <http://www.geonames.org/ontology#Code> ;
