    rdfs:range <http://purl.org/vocab/frbr/core#Manifestation> ;
    owl:inverseOf <http://purl.org/vocab/frbr/extended#isPartOfManifestation> .

<http://purl.org/vocab/frbr/extended#hasPartWork> a owl:ObjectProperty ;
