@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://vocab.sti2.at/vrank> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.org/voc/vrank#Algorithm> a rdfs:Class,
        owl:Class ;
    rdfs:label "algorithm" ;
    rdfs:comment "A ranking algorithm used to compute the ranking scores associated with an item (vrank:Rank)." .

<http://purl.org/voc/vrank#Feature> a rdfs:Class,
        owl:Class ;
    rdfs:label "feature" ;
    rdfs:comment "A feature of a vrank:Algorithm such as Granularity, RankingFactor, etc." .

<http://purl.org/voc/vrank#Parameter> a rdfs:Class,
        owl:Class ;
    rdfs:label "parameter" ;
    rdfs:comment "A parameter of a vrank:Algorithm such as number of iterations or damping factor." .

<http://purl.org/voc/vrank#Rank> a rdfs:Class,
        owl:Class ;
    rdfs:label "rank" ;
    rdfs:comment "Represents a ranking score associated with an item." .

<http://purl.org/voc/vrank#computedBy> a rdf:Property ;
    rdfs:label "computed by" ;
    rdfs:comment "A vrank:Rank is computed by an vrank:Algorithm." ;
    rdfs:domain <http://purl.org/voc/vrank#Rank> ;
    rdfs:range <http://purl.org/voc/vrank#Algorithm> .

<http://purl.org/voc/vrank#featureId> a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "feature id" ;
    rdfs:comment "The id associated to a vrank:Feature." ;
    rdfs:domain <http://purl.org/voc/vrank#Feature> ;
    rdfs:range xsd:string .

<http://purl.org/voc/vrank#featureValue> a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "feature value" ;
    rdfs:comment "The value associated to a vrank:Feature." ;
    rdfs:domain <http://purl.org/voc/vrank#Feature> ;
    rdfs:range xsd:string .

<http://purl.org/voc/vrank#hasFeature> a rdf:Property ;
    rdfs:label "has feature" ;
    rdfs:comment "TODO." ;
    rdfs:domain <http://purl.org/voc/vrank#Algorithm> ;
    rdfs:range <http://purl.org/voc/vrank#Feature> .

<http://purl.org/voc/vrank#hasName> a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has name" ;
    rdfs:comment "A vrank:Algorithm has a name." ;
    rdfs:domain <http://purl.org/voc/vrank#Algorithm> ;
    rdfs:range xsd:string .

<http://purl.org/voc/vrank#hasParameter> a rdf:Property ;
    rdfs:label "has parameter" ;
    rdfs:comment "TODO." ;
    rdfs:domain <http://purl.org/voc/vrank#Algorithm> ;
    rdfs:range <http://purl.org/voc/vrank#Parameter> .

<http://purl.org/voc/vrank#hasRank> a rdf:Property ;
    rdfs:label "has rank" ;
    rdfs:comment "A subject, property or object hasRank a vrank:Rank." ;
    rdfs:domain owl:Thing ;
    rdfs:range <http://purl.org/voc/vrank#Rank> .

<http://purl.org/voc/vrank#hasRankTimeStamp> a rdf:Property,
        owl:FunctionalProperty ;
    rdfs:label "has rank timestamp" ;
    rdfs:comment "The time when a vrank:Rank was computed." ;
    rdfs:domain <http://purl.org/voc/vrank#Rank> ;
    rdfs:range xsd:datetime .

<http://purl.org/voc/vrank#paramId> a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "parameter id" ;
    rdfs:comment "The id associated to a vrank:Parameter." ;
    rdfs:domain <http://purl.org/voc/vrank#Parameter> ;
    rdfs:range xsd:string .

<http://purl.org/voc/vrank#paramValue> a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "parameter value" ;
    rdfs:comment "The value associated to a vrank:Parameter." ;
    rdfs:domain <http://purl.org/voc/vrank#Parameter> ;
    rdfs:range xsd:string .

<http://purl.org/voc/vrank#rankValue> a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has rank value" ;
    rdfs:comment "The numerical value associated to a vrank:Rank." ;
    rdfs:domain <http://purl.org/voc/vrank#Rank> ;
    rdfs:range xsd:float .

<http://vocab.sti2.at/vrank#STI%20Innsbruck> a dcterms:Agent ;
    foaf:homepage onto: ;
    foaf:member <http://vocab.sti2.at/vrank#andtha>,
        <http://vocab.sti2.at/vrank#aroa>,
        <http://vocab.sti2.at/vrank#itoma> ;
    foaf:name "STI Innsbruck" .

<http://vocab.sti2.at/vrank#rdf> dcterms:FileFormat onto: .

<http://vocab.sti2.at/vrank#ttl> dcterms:FileFormat onto: .

<http://vocab.sti2.at/vrank#andtha> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "Andreas Thalhammer" .

<http://vocab.sti2.at/vrank#aroa> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "Antonio J. Roa-Valverde" .

<http://vocab.sti2.at/vrank#itoma> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "Ioan Toma" .

onto: a owl:Ontology ;
    dc:creator <http://vocab.sti2.at/vrank#andtha>,
        <http://vocab.sti2.at/vrank#aroa>,
        <http://vocab.sti2.at/vrank#itoma> ;
    dcterms:created "2012-06-05"^^xsd:date ;
    dcterms:description "The Vocabulary for Ranking (vRank) is an RDF Schema vocabulary for materializing ranking computations." ;
    dcterms:modified "2012-06-05"^^xsd:date ;
    dcterms:partOf <http://vocab.sti2.at> ;
    dcterms:publisher "http://vocab.sti2.at/vrank#STI%20Innsbruck" ;
    dcterms:status <http://purl.org/adms/status/UnderDevelopment> ;
    dcterms:title "Vocabulary for Ranking (vRank)" ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:preferredNamespacePrefix "vrank" ;
    vann:preferredNamespaceUri "http://purl.org/voc/vrank#" ;
    foaf:homepage onto:.html .

