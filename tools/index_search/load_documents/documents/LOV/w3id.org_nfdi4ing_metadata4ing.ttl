<http://mlcommons.org/croissant/Field> a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    skos:definition "A component of the structure of a RecordSet, such as a column of a table."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel and skos:definition"@en ;
    skos:prefLabel "Field"@en .

<http://purl.obolibrary.org/obo/BFO_0000055> a owl:ObjectProperty ;
    rdfs:comment "Paraphrase of elucidation: a relation between a process and a realizable entity, where there is some material entity that is bearer of the realizable entity and participates in the process, and the realizable entity comes to be realized in the course of the process" ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "realizes"@en .

<http://purl.obolibrary.org/obo/RO_0000056> a owl:ObjectProperty ;
    owl:inverseOf <http://purl.obolibrary.org/obo/RO_0000057> ;
    skos:definition "a relation between a continuant and a process, in which the continuant is somehow involved in the process"@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en,
        "changed by m4i: copied obo:IAO_0000115 to a skos:definition"@en ;
    skos:prefLabel "participates in"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isAssignmentFor> a owl:ObjectProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    skos:broader <http://www.molmod.info/semantics/pims-ii.ttl#isRepresentamenFor> ;
    skos:definition "(o isAssignment for d) means that d: x = y is an assignment that refers to o; e.g., x may be temperature, y may be a temperature value, and o may be an object of which the temperature has been measured or some other context to which the assignment refers"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels, harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "is assignment for"@en .

xsd:date a rdfs:Datatype .

prov:Association a owl:Class ;
    rdfs:comment "An instance of prov:Association provides additional descriptions about the binary prov:wasAssociatedWith relation from an prov:Activity to some prov:Agent that had some responsiblity for it. For example, :baking prov:wasAssociatedWith :baker; prov:qualifiedssociation [ a prov:Association; prov:agent :baker; :foo :bar ]."@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "association"@en .

prov:agent a owl:ObjectProperty ;
    rdfs:range prov:Agent ;
    skos:definition "The prov:agent property is used to reference an agent that had a role in an activity."@en ;
    skos:editorialNote "changed by m4i: added german label, added skos:prefLabel"@en,
        "changed by m4i: simplified definition"@en ;
    skos:prefLabel "has agent"@en .

prov:qualifiedAssociation a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy prov: ;
    rdfs:range prov:Association ;
    skos:definition "Allows to specify more information (e.g. a role) about an association between an agent (e.g. a person) and an Activity (e.g. a processing step)."@en ;
    skos:editorialNote "changed by m4i: added german label, added skos:prefLabel, added skos:definition, skos:example and skos:note"@en ;
    skos:example "Example application in m4i:\\n:SomeProcess\\n    a m4i:ProcessingStep; \\n    obo:RO_0000057 :SomePerson;\\n    prov:qualifiedAssociation [\\n        a prov:Association;\\n        prov:agent   :SomePerson;\\n        prov:hadRole :SomeRole;\\n        rdfs:comment \":SomePerson had the :SomeRole in this :SomeProcess\"@en\\n    ] ; \\n                          skos:prefLabel \"has qualified association\"@en , \\n                                         \"hat qualifizierte Beziehung\"@de .\\n\\nThe direct relation between an activity and an agent expressed with 'has participant' (http://purl.obolibrary.org/obo/RO_0000057 or http://www.w3.org/ns/prov#wasAssociatedWith) does not give details about the agent's role in that activity. Using the property prov:qualifiedAssociation one can point to a blank node (cf. https://en.wikipedia.org/w/index.php?title=Blank_node) containing additional information about the participation relation.\\n"@en ;
    skos:note "In metadata4ing use obo:RO_0000057 or prov:wasAssociatedWith as unqualified form for the relation between an activity and an agent."@en ;
    skos:prefLabel "qualified association"@en .

<https://ptb.de/si/Real> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:hasUncertaintyDeclaration ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:hasNumericalValue ],
        onto:NumericalVariable ;
    skos:definition "(Real value +- uncertainty) x measurement unit, i.e., a scalar value with a measurement unit and an uncertainty indication"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "real"@en .

<https://ptb.de/si/hasCoverageProbability> a owl:DatatypeProperty ;
    rdfs:domain onto:UncertaintyDeclaration ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:decimal ;
            owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 1.0 ] ) ] ;
    skos:definition "points to the probability (between 0 and 1) ascribed to the event of the actual value falling within the range asserted by the given uncertainty declaration"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "has coverage probability"@en .

<https://ptb.de/si/hasDistribution> a owl:DatatypeProperty ;
    rdfs:domain onto:UncertaintyDeclaration ;
    rdfs:range xsd:string ;
    skos:definition "points to a descriptor/label of the assumed underlying distribution"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "has statistical distribution"@en .

<https://ror.org/02kkvpp62> a owl:NamedIndividual,
        foaf:Organization ;
    foaf:name "Technische Universität München (TUM)" .

<http://purl.obolibrary.org/obo/BFO_0000017> a owl:Class ;
    skos:definition "To say that b is a realizable entity is to say that b is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region and is of a type instances of which are realized in processes of a correlated type. (axiom label in BFO2 Reference: [058-002])" ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "realizable entity"@en .

<http://purl.obolibrary.org/obo/BFO_0000051> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    skos:definition "a core relation that holds between a whole and its part"@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en,
        "changed by m4i: copied obo:IAO_0000115 to a skos:definition"@en ;
    skos:prefLabel "has part"@en .

<http://qudt.org/schema/qudt/QuantityKind> a owl:Class ;
    rdfs:comment "A <b>Quantity Kind</b> is any observable property that can be  measured and quantified numerically. Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity."@en ;
    rdfs:subClassOf schema:Intangible ;
    skos:definition "Kind of quantity, i.e., a physical/chemical quantity from a controlled vocabulary, such as QUDT, IEC, or EMMO"@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:note "we recommend using a persistent identifier resolving to a persistent URL"@en ;
    skos:prefLabel "quantity kind"@en .

<http://qudt.org/schema/qudt/Unit> a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    skos:closeMatch <http://emmo.info/emmo#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4>,
        <http://www.molmod.info/semantics/pims-ii.ttl#MeasurementUnit> ;
    skos:definition "A unit of measure, or unit is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures). Any measurement of the length can be expressed as a number multiplied by the unit meter. More formally, the value of physical quanitity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as Q = nU."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added German label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "unit"@en .

onto:hasUncertaintyDeclaration a owl:ObjectProperty ;
    rdfs:domain onto:NumericalVariable ;
    rdfs:range onto:UncertaintyDeclaration ;
    skos:definition "Associates an si:Real quantity value with its mandatory uncertainty declaration (i.e., with an expanded uncertainty or a coverage interval)"@en ;
    skos:prefLabel "has uncertainty declaration"@en .

onto:identifier a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    skos:altLabel "has unique identifier"@en,
        "is represented through identifier"@en ;
    skos:definition "A systematically built alphanumeric string that identifies a unique object (e.g. a person, a publication, an organisation, a research activity, a sample, etc.) or a unique class of objects."@en ;
    skos:prefLabel "has identifier"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleValueFor> a owl:ObjectProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    skos:definition "(x isAdmissibleValueFor y) means that x is a value that can be assigned to the variable y; subsumption under msIPIRIR is explained as follows: There is a sign z for the variable y (where z is the range of admissible values of y), for which in turn there is another sign z' (where z' lists members of z, explicitly including x) of which x is a part"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels, harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "is admissible value for"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isValueInAssignment> a owl:ObjectProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    skos:broader <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ;
    skos:definition "(y isValueInAssignment a) means that a: x = y is an assignment where the value y is assigned to a variable x"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels, harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "is value in assignment"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isVariableInAssignment> a owl:ObjectProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    skos:broader <http://www.molmod.info/semantics/pims-ii.ttl#isSemioticallyConstitutiveOf> ;
    skos:definition "(x isVariableInAssignment a) means that a: x = y is an assignment where a value y is assigned to the variable x"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels, harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "is variable in assignment"@en .

dcat:Dataset a owl:Class ;
    rdfs:comment "A collection of data, published or curated by a single source, and available for access or download in one or more representations."@en ;
    rdfs:isDefinedBy dcat: ;
    owl:equivalentClass schema:Dataset ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
    skos:prefLabel "dataset"@en ;
    skos:scopeNote "The notion of dataset in DCAT is broad and inclusive, with the intention of accommodating resource types arising from all communities. Data comes in many forms including numbers, text, pixels, imagery, sound and other multi-media, and potentially other types, any of which might be collected into a dataset."@en,
        "This class describes the conceptual dataset. One or more representations might be available, with differing schematic layouts and formats or serializations."@en .

foaf:Agent a owl:Class ;
    rdfs:comment "DEPRECATED An agent (eg. person, group, software or physical artifact).",
        "exchanged foaf:Agent by prov:Agent to fulfill range definition of prov:agent property" ;
    rdfs:seeAlso prov:Agent ;
    owl:deprecated true .

<https://ptb.de/si/ExpandedUnc> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://ptb.de/si/hasUncertainty> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://ptb.de/si/hasCoverageProbability> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://ptb.de/si/hasCoverageFactor> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://ptb.de/si/hasDistribution> ],
        onto:UncertaintyDeclaration ;
    skos:definition "Structure for stating an expanded measurement, model, or simulation uncertainty, e.g., to be applied to an si:Real quantity value"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "expanded uncertainty"@en .

<https://ror.org/05558nw16> a owl:NamedIndividual,
        foaf:Organization ;
    foaf:name "Leibniz Supercomputing Centre (LRZ)" .

onto:Method a owl:Class ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:definition "Abstract description of a method for analysis, generation and transformation of data and material objects like, e.g., 'Fourier Transform Infrared Spectroscopy' or 'Molecular Dynamics Simulation'. Note that while values for relevant parameters should be provided, m4i:Method does not refer to the actual execution of the process that is described (use m4i:ProcessingStep for that), but rather a description of the underlying principle."@en ;
    skos:prefLabel "method"@en .

prov:Activity a owl:Class ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:closeMatch <http://www.molmod.info/semantics/pims-ii.ttl#Action> ;
    skos:definition "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "activity"@en .

prov:Person a owl:Class ;
    rdfs:isDefinedBy prov: ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "Person agents are people."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel, added skos:definition, added german definition, added instances"@en ;
    skos:prefLabel "person"@en .

<https://ptb.de/dcc/formulaType> a rdfs:Datatype ;
    skos:definition "A data type to express formulae in a markup language such as MathML or LaTeX. The preferred syntax is Semantic MathML."@en ;
    skos:editorialNote "harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "formula"@en .

<https://ptb.de/si/CoverageInterval> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://ptb.de/si/hasCoverageProbability> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://ptb.de/si/hasDistribution> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://ptb.de/si/hasIntervalMin> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://ptb.de/si/hasIntervalMax> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://ptb.de/si/hasStandardUnc> ],
        onto:UncertaintyDeclaration ;
    skos:definition "Structure for stating a probabilistic-symmetric coverage interval for a real uncertainty, to be applied to an si:Real quantity value"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "coverage interval"@en .

<http://purl.obolibrary.org/obo/RO_0000057> a owl:ObjectProperty ;
    owl:propertyChainAxiom ( prov:qualifiedAssociation prov:agent ) ;
    skos:definition "a relation between a process and a continuant, in which the continuant is somehow involved in the process"@en ;
    skos:editorialNote "changed by m4i: added a property chain axiom for use with prov:qualifiedAssociation"@en,
        "changed by m4i: added german labels, added skos:prefLabel"@en,
        "changed by m4i: copied obo:IAO_0000115 to a skos:definition"@en ;
    skos:prefLabel "has participant"@en .

onto:Tool a owl:Class ;
    skos:definition "Object that helps an agent perform an action (e.g., John wrote a book with a pen), i.e., an object of the relation schema:instrument or m4i:hasTool"@en ;
    skos:prefLabel "tool"@en .

onto:UncertaintyDeclaration a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    skos:definition "Declaration that can be applied to an si:Real quantity value to give an assessment of uncertainty"@en ;
    skos:prefLabel "uncertainty declaration"@en .

onto:hasAssignmentTimestamp a owl:DatatypeProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:range schema:DateTime ;
    rdfs:subPropertyOf schema:temporal ;
    skos:definition "Points to a timestamp associated with an assignment; there are multiple kinds of timestamp datatype properties, which are included here from schema.org"@en ;
    skos:prefLabel "has assignment timestamp"@en .

onto:hasValue a owl:DatatypeProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    skos:definition "A value of any type"@en ;
    skos:prefLabel "has value"@en .

prov:Organization a owl:Class ;
    rdfs:isDefinedBy prov: ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "An organization is a social or legal institution such as a company, society, etc."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel, added skos:definition, added german definition, added instances"@en ;
    skos:prefLabel "organization"@en .

prov:Agent a owl:Class ;
    rdfs:isDefinedBy prov: ;
    skos:definition "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel, added skos:definition, added german definition, added instances"@en ;
    skos:prefLabel "agent"@en .

schema:Project a owl:Class ;
    rdfs:comment "An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim"@en ;
    skos:editorialNote "changed by m4i: added German definition, added language tag to English definition, shortened definition"@en,
        "changed by m4i: use of skos:prefLabel instead of rdfs:label, added German label, added language tag to English label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "project"@en .

<http://purl.obolibrary.org/obo/BFO_0000015> a owl:Class ;
    skos:closeMatch <http://www.molmod.info/semantics/pims-ii.ttl#Process> ;
    skos:definition "Process, i.e., a physical entity with a temporal evolution that 'has a meaning for the ontologist'"@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "process"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Value> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleValueFor> ],
        schema:Intangible ;
    skos:definition "Value, i.e., an articulation that is by social convention understood to be potentially assignable to a variable"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels, harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "value"@en .

schema:DateTime a rdfs:Datatype ;
    skos:definition "A combination of date and time of day in the form [-]CCYY-MM-DDThh:mm:ss[Z|(+|-)hh:mm] (see Chapter 5.4 of ISO 8601)"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "date with time"@en .

schema:Intangible a owl:Class ;
    skos:definition "A utility class that serves as the umbrella for a number of 'intangible' things such as quantities, structured values, etc."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "intangible"@en .

dcat:Distribution a owl:Class ;
    rdfs:isDefinedBy dcat: ;
    skos:definition "A specific representation of a dataset. A dataset might be available in multiple serializations that may differ in various ways, including natural language, media-type or format, schematic organization, temporal and spatial resolution, level of detail or profiles (which might specify any or all of the above)."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
    skos:prefLabel "distribution"@en .

foaf:Organization a owl:Class ;
    rdfs:comment "DEPRECATED An organization.",
        "Replace foaf:Organization by prov:Organization" ;
    rdfs:seeAlso prov:Organization ;
    rdfs:subClassOf foaf:Agent ;
    owl:deprecated true .

onto:NumericalVariable a owl:Class ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    skos:closeMatch <http://qudt.org/schema/qudt/Quantity>,
        <https://ptb.de/si/Real> ;
    skos:definition "A variable that expects a float or integer as a value"@en ;
    skos:prefLabel "numerical variable"@en .

foaf:Person a owl:Class ;
    rdfs:comment "DEPRECATED A person.",
        "Replace foaf:Person by prov:Person" ;
    rdfs:seeAlso prov:Person ;
    rdfs:subClassOf foaf:Agent ;
    owl:deprecated true .

onto:ProcessingStep a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "Specific action undertaken during research"@en ;
    skos:prefLabel "processing step"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Assignment> a owl:Class ;
    rdfs:comment "Assignment, i.e., a data item by which a value is assigned to a variable with respect to a particular referent (e.g., T = 200 K for substance o as it was measured in a particular cognitive step); therein, T is the variable, related to the assignment by m4i:hasVariable, 200 K is the value, related to the assignment by m4i:hasValue, and o is the referent, related to the assignment by isAssignmentFor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.molmod.info/semantics/pims-ii.ttl#isAssignmentFor> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isValueInAssignment> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Value> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isVariableInAssignment> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ],
        schema:Intangible ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels,  harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "assignment"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Variable> a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleValueFor> ] ;
            owl:someValuesFrom <http://www.molmod.info/semantics/pims-ii.ttl#Value> ] ;
    skos:closeMatch <http://emmo.info/emmo#EMMO_1eed0732_e3f1_4b2c_a9c4_b4e75eeb5895> ;
    skos:definition "Variable, i.e., a conventional that is employed for something to which values can be assigned (this may include different notations for the same variable including, e.g., computational representations); this is to be understood very generally, e.g., a variable may be an array or set of elements or have another kind of internal structure"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels, harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "variable"@en .

prov:Role a owl:Class ;
    rdfs:isDefinedBy prov: ;
    skos:definition "A role is the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel, added skos:definition, added german definition, added instances, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "role"@en .

