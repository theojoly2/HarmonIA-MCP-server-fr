<https://ptb.de/si/hasCoverageFactor> a owl:DatatypeProperty ;
    rdfs:domain <https://ptb.de/si/ExpandedUnc> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:decimal ;
            owl:withRestrictions ( [ xsd:minInclusive 1.0 ] ) ] ;
    skos:definition "points to the coverage factor, i.e., to a factor (greater than or equal to unity) by which the expanded uncertainty relates to the standard uncertainty"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "has coverage factor"@en .

<https://ptb.de/si/hasIntervalMax> a owl:DatatypeProperty ;
    rdfs:domain <https://ptb.de/si/CoverageInterval> ;
    rdfs:range xsd:decimal ;
    skos:definition "upper boundary of the coverage interval"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "has interval maximum"@en .

<https://ptb.de/si/hasIntervalMin> a owl:DatatypeProperty ;
    rdfs:domain <https://ptb.de/si/CoverageInterval> ;
    rdfs:range xsd:decimal ;
    skos:definition "lower boundary of the coverage interval"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "has interval minimum"@en .

<https://ptb.de/si/hasStandardUnc> a owl:DatatypeProperty ;
    rdfs:domain <https://ptb.de/si/CoverageInterval> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:decimal ;
            owl:withRestrictions ( [ xsd:minInclusive 0.0 ] ) ] ;
    skos:definition "The standard measurement uncertainty is the measurement uncertainty expressed as a standard deviation"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "has standard uncertainty"@en .

<https://ptb.de/si/hasUncertainty> a owl:DatatypeProperty ;
    rdfs:domain <https://ptb.de/si/ExpandedUnc> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:decimal ;
            owl:withRestrictions ( [ xsd:minInclusive 0.0 ] ) ] ;
    skos:definition "absolute magnitude of the indicated uncertainty"@en ;
    skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added skos:prefLabel" ;
    skos:prefLabel "has uncertainty"@en .

