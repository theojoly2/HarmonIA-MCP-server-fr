@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/vocommons/voaf#> .
@prefix ns2: <http://www.loc.gov/premis/rdf/v3/> .
@prefix ns3: <https://w3id.org/mod#> .
@prefix ns4: <http://purl.org/ontology/bibo/> .
@prefix onto: <http://w3id.org/nfdi4ing/metadata4ing#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://mlcommons.org/croissant/FileObject> a owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    skos:definition "An individual file that is part of a dataset."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "file object"@en .

<http://mlcommons.org/croissant/FileSet> a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    skos:definition "A set of homogeneous files extracted from a container, optionally filtered by inclusion and/or exclusion filters."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "file set"@en .

<http://mlcommons.org/croissant/containedIn> skos:definition "Another FileObject or FileSet that this one is contained in, e.g., in the case of a file extracted from an archive. When this property is present, the contentUrl is evaluated as a relative path within the container object."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel and skos:definition, added german labels, removed schema:rangeIncludes and schema:domainIncludes properties"@en ;
    skos:prefLabel "containedIn"@en .

<http://mlcommons.org/croissant/field> a owl:ObjectProperty ;
    rdfs:domain <http://mlcommons.org/croissant/RecordSet> ;
    rdfs:range <http://mlcommons.org/croissant/Field> ;
    skos:definition "A data element that appears in the records of the RecordSet (e.g., one column of a table)."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel and skos:definition, added german labels, removed schema:rangeIncludes and schema:domainIncludes properties"@en ;
    skos:prefLabel "field"@en .

<http://mlcommons.org/croissant/source> a owl:ObjectProperty ;
    skos:definition "The data source of the field. This will generally reference a FileObject or FileSet's contents (e.g., a specific column of a table)."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel and skos:definition, added german labels, removed schema:rangeIncludes and schema:domainIncludes properties"@en ;
    skos:prefLabel "source"@en .

<http://purl.obolibrary.org/obo/BFO_0000054> a owl:ObjectProperty ;
    rdfs:comment "Paraphrase of elucidation: a relation between a realizable entity and a process, where there is some material entity that is bearer of the realizable entity and participates in the process, and the realizable entity comes to be realized in the course of the process" ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000017> ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    owl:inverseOf <http://purl.obolibrary.org/obo/BFO_0000055> ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "realized in"@en .

<http://purl.obolibrary.org/obo/RO_0002090> a owl:ObjectProperty ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000063> ;
    skos:definition "X immediately precedes_Y iff: end(X) simultaneous_with start(Y)" ;
    skos:editorialNote "changed by m4i: added skos:prefLabel"@en ;
    skos:prefLabel "immediately precedes"@en .

<http://purl.obolibrary.org/obo/RO_0002224> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:range onto:ProcessingStep ;
    rdfs:seeAlso <http://ontologydesignpatterns.org/wiki/Submissions:Componency> ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000051> ;
    skos:altLabel "started by"@en ;
    skos:definition "x starts with y if and only if x has part y and the time point at which x starts is equivalent to the time point at which y starts. Formally: α(y) = α(x) ∧ ω(y) < ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "starts with"@en .

<http://purl.obolibrary.org/obo/RO_0002230> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:range onto:ProcessingStep ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000051> ;
    skos:altLabel "finished by"@en ;
    skos:definition "x ends with y if and only if x has part y and the time point at which x ends is equivalent to the time point at which y ends. Formally: α(y) > α(x) ∧ ω(y) = ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "ends with"@en .

<http://purl.obolibrary.org/obo/RO_0002233> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057> ;
    owl:inverseOf <http://purl.obolibrary.org/obo/RO_0002352> ;
    skos:definition "(x has input y) means x takes specific input as y for further processes"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel"@en ;
    skos:prefLabel "has input"@en .

<http://purl.obolibrary.org/obo/RO_0002234> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057> ;
    owl:inverseOf <http://purl.obolibrary.org/obo/RO_0002353> ;
    skos:definition "(x has output y) means x provides specific output y for the result or further processes"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel"@en ;
    skos:prefLabel "has output"@en .

dcterms:abstract a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty ;
    skos:definition "An account of the resource."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel"@en ;
    skos:prefLabel "description"@en .

dcterms:isReferencedBy a owl:AnnotationProperty ;
    dcterms:description "This property is intended to be used with non-literal values. This property is an inverse property of References."@en ;
    rdfs:comment "A related resource that references, cites, or otherwise points to the described resource."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "is referenced by"@en .

dcterms:issued a owl:AnnotationProperty .

dcterms:language a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:references a owl:AnnotationProperty ;
    dcterms:description "This property is intended to be used with non-literal values. This property is an inverse property of Is Referenced By."@en ;
    rdfs:comment "A related resource that is referenced, cited, or otherwise pointed to by the described resource."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "references"@en .

dcterms:replaces a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:subject a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty ;
    skos:definition "A name given to the resource."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel"@en ;
    skos:prefLabel "title"@en .

ns4:doi a owl:AnnotationProperty .

ns4:status a owl:AnnotationProperty .

<http://purl.org/spar/biro/BibliographicRecord> a owl:Class ;
    rdfs:comment "A record that uniquely describes a particular textual or data publication (or a work in preparation for publication). Each bibliographic record is a set of entities describing aspects of the referenced work, including, for example, but not restricted to: authors, title, journal, publication year, DOI, ISSN, publisher and copyright information, or, in the case of a data publication: creators, title, version, archive, publication year, DOI or other identifier). The FRBR expression of a bibliographic record is a bibliographic reference, which usually contains only a sub-set of these entities, ordered in a particular way that corresponds to the house style of the publication in which it occurs."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "bibliographic record"@en .

vann:example a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

ns1:extends a owl:AnnotationProperty .

doap:audience a owl:AnnotationProperty .

doap:bug-database a owl:AnnotationProperty .

doap:repository a owl:AnnotationProperty .

onto: a owl:NamedIndividual,
        owl:Ontology ;
    rdfs:label "Metadata4Ing"@en ;
    dcterms:abstract "The ontology Metadata4Ing provides a framework for the semantic description of research data and of the whole data generation process, embracing the object of investigation, all sample and data manipulation methods and tools, the data files themselves, and the roles of persons and institutions. The structure and application of the ontology are based on the principles of modularity and inheritance."@en ;
    dcterms:bibliographicCitation "Metadata4Ing Workgroup (2025). Metadata4Ing: An ontology for describing the generation of research data within a scientific activity. v1.3.1. http://w3id.org/nfdi4ing/metadata4ing/1.3.1 [ttl, jsonld, nt, rdf/xml]"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6272-204X>,
        <https://orcid.org/0000-0001-8341-1478>,
        <https://orcid.org/0000-0002-1019-9151>,
        <https://orcid.org/0000-0002-1489-6501>,
        <https://orcid.org/0000-0002-1698-6826>,
        <https://orcid.org/0000-0002-2239-3955>,
        <https://orcid.org/0000-0002-2639-1949>,
        <https://orcid.org/0000-0002-5031-9170>,
        <https://orcid.org/0000-0002-7213-5110>,
        <https://orcid.org/0000-0002-8524-0569>,
        <https://orcid.org/0000-0002-9033-5538>,
        <https://orcid.org/0000-0002-9826-018X> ;
    dcterms:created "2022-02-22"^^xsd:date ;
    dcterms:creator "Metadata4Ing Workgroup" ;
    dcterms:issued "2025-03-10"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/deu>,
        <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2025-03-10"^^xsd:date ;
    dcterms:publisher <http://d-nb.info/gnd/1227971389> ;
    dcterms:references <https://doi.org/10.14454/csba-e454>,
        <https://doi.org/10.1504/IJMSO.2020.107792>,
        <https://doi.org/10.26083/tuprints-00024573>,
        <https://doi.org/10.5281/zenodo.3816686>,
        <https://doi.org/10.5281/zenodo.3982367>,
        <https://doi.org/10.5281/zenodo.4846313>,
        <https://doi.org/10.52825/cordi.v1i.271> ;
    dcterms:replaces <http://w3id.org/nfdi4ing/metadata4ing/1.3.0> ;
    dcterms:rights <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://doi.org/10.5281/zenodo.7362037>,
        <https://doi.org/10.52825/CoRDI.v1i.271>,
        <https://nfdi4ing.de/wp-content/uploads/2019/10/Programmheft-NFDI4Ing-Community-Meeting.pdf#page=6> ;
    dcterms:subject <http://d-nb.info/gnd/1227971389>,
        <http://d-nb.info/gnd/1342271416>,
        <http://d-nb.info/gnd/4137304-2>,
        <http://d-nb.info/gnd/4384643-9>,
        <http://d-nb.info/gnd/4827894-4> ;
    dcterms:title "Metadata4Ing: An ontology for describing the generation of research data within a scientific activity."@en ;
    ns4:doi <https://doi.org/10.5281/zenodo.5957103> ;
    ns4:status "active"@en ;
    vann:example <https://w3id.org/nfdi4ing/metadata4ing/first-steps-guide.md> ;
    vann:preferredNamespacePrefix "m4i" ;
    vann:preferredNamespaceUri "http://w3id.org/nfdi4ing/metadata4ing#" ;
    ns1:extends <http://emmo.info/emmo#>,
        <http://purl.obolibrary.org/obo/>,
        <http://www.molmod.info/semantics/pims-ii.ttl#>,
        <https://ptb.de/si/> ;
    doap:audience "Engineers and scientists working with quantitative data"@en ;
    doap:bug-database <https://git.rwth-aachen.de/nfdi4ing/metadata4ing/metadata4ing/-/issues> ;
    doap:repository <https://git.rwth-aachen.de/nfdi4ing/metadata4ing/metadata4ing/> ;
    ns2:documentation <https://w3id.org/nfdi4ing/metadata4ing> ;
    rdfs:comment "\\nMetadata4Ing defines classes and properties or reuses such classes and properties from other ontologies to describe research processes and research data management in NFDI4Ing.  \\nNew concepts and properties are located in the namespace of Metadata4Ing.  \\nMetadata4Ing does not import complete ontologies for the sake of relevance, readability, understandability and usability by and for engineers.  \\nInstead, it tries to make re-use of existing identifiers for classes and properties by re-using all or a relevant subset of the axioms from the original ontology.  \\nThese statements have been extracted in different ways, e.g. by using Protégé tools importing an ontology and copying axioms of relevant items to Metadata4Ing or by download from data services or raw files of ontologies and manual copypasting.  \\nIn some cases there was a need to extend or modify the original set of statements about an entity, e.g. because labels and definitions were expressed with a different owl:AnnotationProperty than the rest of Metadata4Ing, or because a skos:preflabel or a skos:definition in any of the languages we would like to support was missing.  \\nAny editorial changes on elements from external ontologies are declared in Metadata4Ing by an annotation with skos:editorialNote at item-level.  \\nTo get the original set of statements we encourage to visit the original namespace of the respective item.  \\nMetadata4Ing reuses elements from the following ontologies:  \\n- BIRO = Bibliographic Reference Ontology  \\n- CR = Croissant  \\n- DCAT = Data Catalog  \\n- DCC = Digital Calibration Certificate  \\n- DCTERMS = Dublin Core Terms  \\n- EMMO = European Materials and Modelling Ontology  \\n- FOAF = Friend of a Friend  \\n- OBO = Open Biological and Biomedical Ontologies:\\n  - BFO = Basic Formal Ontology  \\n  - RO = Relation Ontology  \\n- OWL = Web Ontology Language  \\n- PIMS-II = PIMS Interoperability Infrastructure  \\n- PROV = Provenance Namespace  \\n- QUDT = Quantities, Units, Dimensions and Types  \\n- RDF = Resource Description Framework  \\n- RDFS = RDF Schema  \\n- SCHEMA = schema.org  \\n- D-SI = Digital System of Units  \\n- SIO = Semanticscience Integrated Ontology  \\n- SKOS = Simple Knowledge Organization System  \\n- SSN = Semantic Sensor Network Ontology  \\n- XSD = XML Schema Definition  \\n"@en ;
    owl:versionIRI <http://w3id.org/nfdi4ing/metadata4ing/1.3.1> ;
    owl:versionInfo "v1.3.1" ;
    dcat:distribution <https://w3id.org/nfdi4ing/metadata4ing/ontology.jsonld>,
        <https://w3id.org/nfdi4ing/metadata4ing/ontology.nt>,
        <https://w3id.org/nfdi4ing/metadata4ing/ontology.ttl>,
        <https://w3id.org/nfdi4ing/metadata4ing/ontology.xml> ;
    schema:funder <https://ror.org/018mejw64> ;
    schema:funding <https://gepris.dfg.de/gepris/projekt/442146713> ;
    schema:logo <https://w3id.org/nfdi4ing/metadata4ing/m4i_logo.png> .

onto:ContactPerson a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#contactperson"^^xsd:anyURI ;
    skos:definition "Person with knowledge of how to access, troubleshoot, or otherwise field issues related to the resource"@en ;
    skos:prefLabel "contact person"@en ;
    skos:scopeNote "May also be the \"Point of Contact\" in an organisation that controls access to the resource, if that organisation is different from the Publisher, Distributor, and Data Manager."@en .

onto:DataCollector a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#datacollector"^^xsd:anyURI ;
    skos:definition "Person/institution responsible for finding or gathering/collecting data under the guidelines of the author(s) or Principal Investigator (PI)"@en ;
    skos:prefLabel "data collector"@en ;
    skos:scopeNote "May also be used when crediting survey conductors, interviewers, event or condition observers, or persons responsible for monitoring key instrument data."@en .

onto:DataCurator a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#datacurator"^^xsd:anyURI ;
    skos:definition "Person tasked with reviewing, enhancing, cleaning, or standardizing metadata and the associated data submitted for storage, use, and maintenance within a data centre or repository"@en ;
    skos:prefLabel "data curator"@en ;
    skos:scopeNote "While the DataManager is concerned with digital maintenance, the DataCurator's role encompasses quality assurance focused on content and metadata. DataCurator responsibilities include: checking completeness of the submitted dataset against the content as described by the submitter; verifying standard metadata according to the applicable system or schema; adding or verifying specialized metadata to add value and ensure access across disciplines; and determining how the metadata might map to search engines, database products, and automated feeds. Repository managers as well as data librarians working in the repository fall within this category. \\n\\nExample: https://doi.org/10.20375/0000-000D-1D1F-2"@en .

onto:DataManager a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#datamanager"^^xsd:anyURI ;
    skos:definition "Person (or organisation with a staff of data managers, such as a data centre) responsible for maintaining the finished resource"@en ;
    skos:prefLabel "data manager"@en ;
    skos:scopeNote "The work done by this person or organisation ensures that the resource is periodically \"refreshed\" in terms of software/hardware support, is kept available or is protected from unauthorized access, is stored in accordance with industry standards, and is handled in accordance with the records management requirements applicable to it.\\n\\nExample: https://doi.org/10.6073/pasta/41b3ed2e152e1e4c3846e646118208e7"@en .

onto:Distributor a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#distributor"^^xsd:anyURI ;
    skos:definition "Institution tasked with responsibility to generate/disseminate copies of the resource in either electronic or print form"@en ;
    skos:prefLabel "distributor"@en ;
    skos:scopeNote "Works stored in more than one archive/repository may credit each as a distributor."@en .

onto:Editor a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#editor"^^xsd:anyURI ;
    skos:definition "A person who oversees the details related to the publication format of the resource"@en ;
    skos:prefLabel "editor"@en ;
    skos:scopeNote "Note: if the Editor is to be credited in place of multiple creators, the Editor's name may be supplied as Creator, with \"(Ed.)\" appended to the name."@en .

onto:HostingInstitution a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#hostinginstitution"^^xsd:anyURI ;
    skos:definition "Typically, the organisation allowing the resource to be available on the internet through the provision of its hardware/software/operating support"@en ;
    skos:prefLabel "hosting institution"@en ;
    skos:scopeNote "This role normally falls on the University, research center or organization where the data center/data repository belongs.\\n\\nEXAMPLE: Université Grenoble Alpes (UGA)\\n\\nMay also be used for an organisation that stores the data offline-often a data centre if that data centre is not the \"publisher\" of the resource."@en .

onto:NumericalAssignment a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isValueInAssignment> ] ;
            owl:someValuesFrom <https://ptb.de/si/Real> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isVariableInAssignment> ] ],
        <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    skos:definition "Assignment by which a variable (e.g., a physical property) is assigned an si:Real quantity value (scalar x measurement unit) in some context (e.g., applied to some object of research)"@en ;
    skos:prefLabel "numerical assignment"@en .

onto:Other a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#other"^^xsd:anyURI ;
    skos:definition "Any person or institution making a significant contribution to the development and/or maintenance of the resource, but whose contribution is notadequately described by any of the other values for contributorType"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "other person"@en ;
    skos:scopeNote "Could be a photographer, artist, or writer whose contribution helped to publicize the resource (as opposed to creating it), a reviewer of the resource, someone providing administrative services to the author (such as depositing updates into an online repository, analysing usage, etc.), or one of many other roles."@en .

onto:Producer a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#producer"^^xsd:anyURI ;
    skos:definition "Typically,a person or organisation responsible for the artistry and form of a media product"@en ;
    skos:prefLabel "producer"@en ;
    skos:scopeNote "In the data industry, this may be a company \"producing\" DVDs that package data for future dissemination by a distributor."@en .

onto:ProjectLeader a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#projectleader"^^xsd:anyURI ;
    skos:definition "Person officially designated as head of project team or sub-project team instrumental in the work necessary to development of the resource"@en ;
    skos:prefLabel "project leader"@en ;
    skos:scopeNote "The Project Leader is not \"removed\" from the work that resulted in the resource; he or she remains intimately involved"@en .

onto:ProjectManager a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#projectmanager"^^xsd:anyURI ;
    skos:definition "Person officially designated as manager of a project. Project may consist of one or many project teams and sub-teams."@en ;
    skos:prefLabel "project manager"@en ;
    skos:scopeNote "The manager of a project normally has more administrative responsibility than actual work involvement."@en .

onto:ProjectMember a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#projectmember"^^xsd:anyURI ;
    skos:definition "Person on the membership list of a designated project/project team"@en ;
    skos:prefLabel "project member"@en ;
    skos:scopeNote "This vocabulary may or may not indicate the quality, quantity, or substance of the person's involvement."@en .

onto:RegistrationAgency a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#registrationagency"^^xsd:anyURI ;
    skos:definition "Institution/organisation officially appointed by a Registration Authority to handle specific tasks within a defined area of responsibility"@en ;
    skos:prefLabel "registration agency"@en ;
    skos:scopeNote "DataCite is a Registration Agency for the International DOI Foundation (IDF). One of DataCite’s tasks is to assign DOI prefixes to the allocating agents who then assign the full, specific character string to data clients, provide metadata back to the DataCite registry, etc."@en .

onto:RegistrationAuthority a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#registrationauthority"^^xsd:anyURI ;
    skos:definition "A standards-setting body from which Registration Agencies obtain official recognition and guidance"@en ;
    skos:prefLabel "registration authority"@en ;
    skos:scopeNote "The IDF serves as the Registration Authority for the International Standards Organisation (ISO) in the area/domain of Digital Object Identifiers."@en .

onto:RelatedPerson a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#relatedperson"^^xsd:anyURI ;
    skos:definition "A person without a specifically defined role in the development of the resource, but who is someone the author wishes to recognize"@en ;
    skos:prefLabel "related person"@en ;
    skos:scopeNote "This person could be an author's intellectual mentor, a person providing intellectual leadership in the discipline or subject domain, etc."@en .

onto:ResearchGroup a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#researchgroup"^^xsd:anyURI ;
    skos:definition "Typically refers to a group of individuals with a lab, department, or divisionthathas a specifically defined focus of activity."@en ;
    skos:prefLabel "research group"@en ;
    skos:scopeNote "May operate at a narrower level of scope; may or may not hold less administrative responsibility than a project team.\\n\\nExample: Space Research & Planetary Sciences Division of the University of Bern (WP Unibe)\\n\\nSource: https://doi.org/10.26302/SSHADE/EXPERIMENT_OP_20201104_001"@en .

onto:Researcher a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#researcher"^^xsd:anyURI ;
    skos:definition "A person involved in analysing data or the results of an experiment or formal study. May indicate an intern or assistant to one of the authors who helped with research but who was not so “key” as to be listed as an author."@en ;
    skos:prefLabel "researcher"@en ;
    skos:scopeNote "Should be a person, not an institution. Note that a person involved in the gathering of data would fall under the contributorType \"DataCollector.\" The researcher may find additional data online and correlate it to the data collected for the experiment or study, for example."@en .

onto:RightsHolder a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#rightsholder"^^xsd:anyURI ;
    skos:definition "Person or institution owning or managing property rights, including intellectual property rights over the resource"@en ;
    skos:prefLabel "rights holder"@en .

onto:Sponsor a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#sponsor"^^xsd:anyURI ;
    skos:definition "Person or organisation that issued a contract or under the auspices of which a work has been written, printed, published, developed, etc."@en ;
    skos:prefLabel "sponsor"@en ;
    skos:scopeNote "Includes organisations that provide in-kind support, through donation, provision of people or a facility or instrumentation necessary for the development of the resource, etc."@en .

onto:Supervisor a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#supervisor"^^xsd:anyURI ;
    skos:definition "Designated administrator over one or more groups/teams working to produce a resource, or over one or more steps of a development process"@en ;
    skos:prefLabel "supervisor"@en .

onto:UsageInstruction a owl:DatatypeProperty ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( rdfs:Literal xsd:string ) ] ;
    skos:definition "Textual description of a processing step within a research process to enable or facilitate its reproducibility"@en ;
    skos:prefLabel "usage instruction"@en .

onto:WorkPackageLeader a owl:NamedIndividual,
        prov:Role ;
    rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.5/appendices/appendix-1/contributorType/#workpackageleader"^^xsd:anyURI ;
    skos:definition "A Work Package is a recognized data product, not all of which is included in publication. The package, instead, may include notes, discarded documents, etc. The Work Package Leader is responsible for ensuring the comprehensive contents, versioning, and availability of the Work Package during the development of the resource."@en ;
    skos:prefLabel "work package leader"@en .

onto:endOfProject a owl:DatatypeProperty ;
    rdfs:domain schema:Project ;
    rdfs:range xsd:date ;
    skos:definition "end date of a project"@en ;
    skos:prefLabel "project end date"@en .

onto:hasAdmissibleUnit a owl:ObjectProperty ;
    rdfs:comment "redundant information: applicable unit can be deduced from quantity kind. If one wants to enforce the use of a specific unit, use a SHACL constraint." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://qudt.org/schema/qudt/QuantityKind> onto:NumericalVariable ) ] ;
    rdfs:range <http://qudt.org/schema/qudt/Unit> ;
    owl:deprecated true ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleUnitFor> ;
    skos:definition "DEPRECATED (x hasAdmissibleUnit y) means that y is a unit that can be associated with the variable x"@en ;
    skos:prefLabel "has admissible unit"@en .

onto:hasAdmissibleValue a owl:ObjectProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleValueFor> ;
    skos:definition "(x hasAdmissibleValue y) means that y is a value that can be assigned to the variable x"@en ;
    skos:prefLabel "has admissible value"@en .

onto:hasAssignedValue a owl:ObjectProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isValueInAssignment> ;
    skos:definition "(a hasAssignedValue y) means that a: x = y is an assignment where the value y is assigned to a variable x"@en ;
    skos:prefLabel "has assigned value"@en .

onto:hasCoverageInterval a owl:ObjectProperty ;
    rdfs:domain onto:NumericalVariable ;
    rdfs:range <https://ptb.de/si/CoverageInterval> ;
    rdfs:subPropertyOf onto:hasUncertaintyDeclaration ;
    skos:definition "Associates an si:Real quantity value with an si:CoverageInterval"@en ;
    skos:prefLabel "has coverage interval"@en .

onto:hasDateAssignmentCreated a owl:DatatypeProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:range schema:DateTime ;
    rdfs:subPropertyOf onto:hasAssignmentTimestamp ;
    skos:broader schema:dateCreated ;
    skos:definition "Points to a date(time) of creation of an assignment"@en ;
    skos:prefLabel "has date assignment created"@en .

onto:hasDateAssignmentDeleted a owl:DatatypeProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:range schema:DateTime ;
    rdfs:subPropertyOf onto:hasAssignmentTimestamp ;
    skos:broader schema:dateDeleted ;
    skos:definition "Points to a date(time) of deletion of an assignment"@en ;
    skos:prefLabel "has date assignment deleted"@en .

onto:hasDateAssignmentModified a owl:DatatypeProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:range schema:DateTime ;
    rdfs:subPropertyOf onto:hasAssignmentTimestamp ;
    skos:broader schema:dateModified ;
    skos:definition "Points to a date(time) of modification of an assignment"@en ;
    skos:prefLabel "has date assignment modified"@en .

onto:hasDateAssignmentValidFrom a owl:DatatypeProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:range schema:DateTime ;
    rdfs:subPropertyOf onto:hasAssignmentTimestamp ;
    skos:broader schema:validFrom ;
    skos:definition "Points to a date(time) at which the validity of an assignment begins"@en ;
    skos:prefLabel "has date assignment valid from"@en .

onto:hasDateAssignmentValidUntil a owl:DatatypeProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:range schema:DateTime ;
    rdfs:subPropertyOf onto:hasAssignmentTimestamp ;
    skos:broader schema:validThrough ;
    skos:definition "Points to a date(time) at which the validity of an assignment ends"@en ;
    skos:prefLabel "has date assignment valid until"@en .

onto:hasEmployedTool a owl:ObjectProperty ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:range onto:Tool ;
    rdfs:subPropertyOf schema:instrument ;
    owl:inverseOf onto:isEmployedToolIn ;
    skos:definition "Points to a tool that is used within a given processing step"@en ;
    skos:prefLabel "has employed tool"@en .

onto:hasExpandedUnc a owl:ObjectProperty ;
    rdfs:domain onto:NumericalVariable ;
    rdfs:range <https://ptb.de/si/ExpandedUnc> ;
    rdfs:subPropertyOf onto:hasUncertaintyDeclaration ;
    skos:definition "Relates an si:Real to its expanded uncertainty"@en ;
    skos:prefLabel "has expanded uncertainty"@en .

onto:hasKindOfQuantity a owl:ObjectProperty ;
    rdfs:domain onto:NumericalVariable ;
    rdfs:range <http://qudt.org/schema/qudt/QuantityKind> ;
    skos:definition "Points to the property characterization (i.e., to the kind of quantity) from a controlled vocabulary"@en ;
    skos:note "we recommend using a persistent identifier resolving to a persistent URL"@en ;
    skos:prefLabel "has kind of quantity"@en .

onto:hasMaximumValue a owl:DatatypeProperty ;
    rdfs:domain onto:NumericalVariable ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:decimal <https://ptb.de/dcc/formulaType> ) ] ;
    rdfs:subPropertyOf onto:hasValue ;
    skos:broader <http://qudt.org/schema/qudt/value>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isLiterally>,
        <https://ptb.de/si/hasValue> ;
    skos:definition "Represents the highest value of a multi-valued variable"@en ;
    skos:prefLabel "has maximum value"@en .

onto:hasMinimumValue a owl:DatatypeProperty ;
    rdfs:domain onto:NumericalVariable ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:decimal <https://ptb.de/dcc/formulaType> ) ] ;
    rdfs:subPropertyOf onto:hasValue ;
    skos:broader <http://qudt.org/schema/qudt/value>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isLiterally>,
        <https://ptb.de/si/hasValue> ;
    skos:definition "Represents the lowest value of a multi-valued variable"@en ;
    skos:prefLabel "has minimum value"@en .

onto:hasParameter a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Method onto:Tool ) ] ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    skos:definition "Points to a parameter of a given method or tool."@en ;
    skos:prefLabel "has parameter"@en .

onto:hasRorId a owl:DatatypeProperty ;
    rdfs:domain prov:Organization ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "https://ror.org/[0-9][0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][0-9][0-9]" ] ) ] ;
    rdfs:subPropertyOf onto:identifier ;
    skos:altLabel "has research organization registry id"@en ;
    skos:definition "A Research Organization Registry identifier that persistently and uniquely identifies a research organization"@en ;
    skos:prefLabel "has ROR ID"@en .

onto:hasRuntimeAssignment a owl:ObjectProperty ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:subPropertyOf [ owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isAssignmentFor> ],
        <http://purl.obolibrary.org/obo/RO_0000057> ;
    skos:definition "Points to an assignment that is neither input nor output"@en ;
    skos:prefLabel "has runtime assignment"@en .

onto:hasStepSize a owl:DatatypeProperty ;
    rdfs:domain onto:NumericalVariable ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:decimal <https://ptb.de/dcc/formulaType> ) ] ;
    rdfs:subPropertyOf onto:hasValue ;
    skos:broader <http://qudt.org/schema/qudt/value>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isLiterally>,
        <https://ptb.de/si/hasValue> ;
    skos:definition "Describes the spacing of a multi-valued variable"@en ;
    skos:prefLabel "has step size"@en .

onto:hasStringValue a owl:DatatypeProperty ;
    rdfs:domain onto:TextVariable ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasValue ;
    skos:definition "A character string of any length"@en ;
    skos:prefLabel "has string value"@en .

onto:hasSymbol a owl:DatatypeProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    rdfs:range xsd:string ;
    skos:broader <http://qudt.org/schema/qudt/symbol> ;
    skos:definition "Letter or string that denotes a variable"@en ;
    skos:prefLabel "has symbol"@en .

onto:hasUnit a owl:ObjectProperty ;
    rdfs:domain onto:NumericalVariable ;
    rdfs:range <http://qudt.org/schema/qudt/Unit> ;
    skos:closeMatch <http://qudt.org/schema/qudt/unit>,
        <https://ptb.de/si/hasUnit> ;
    skos:definition "Represents the unit of a numerical (real) value"@en ;
    skos:note "We recommend using a resolvable PID from a controlled vocabulary, such as ISO 80000, IEC or QUDT"@en,
        "cardinality of this property for the description of a si:Real: 0-1"@en,
        "obligation of this property for the description of a si:Real: recommended"@en ;
    skos:prefLabel "has unit"@en .

onto:hasVariable a owl:ObjectProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Assignment> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    owl:inverseOf <http://www.molmod.info/semantics/pims-ii.ttl#isVariableInAssignment> ;
    skos:definition "( a hasVariable x ) means that a: x = y is an assignment where the value y is assigned to a variable x"@en ;
    skos:prefLabel "has variable"@en .

onto:hasVariableDescription a owl:DatatypeProperty ;
    rdfs:domain <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    rdfs:range xsd:string ;
    skos:definition "Textual and human readable description of a variable in a research context"@en ;
    skos:prefLabel "has variable description"@en .

onto:implementedByTool a owl:ObjectProperty ;
    rdfs:domain onto:Method ;
    rdfs:range onto:Tool ;
    rdfs:subPropertyOf ssn:implementedBy ;
    owl:inverseOf onto:implementsMethod ;
    skos:definition "Points to a tool that implements a given method"@en ;
    skos:prefLabel "implemented by"@en .

onto:inProject a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prov:Organization prov:Person ) ] ;
    rdfs:range schema:Project ;
    owl:inverseOf onto:projectParticipant ;
    skos:definition "A property that connects a person or an organization with a project."@en ;
    skos:prefLabel "associated to project"@en .

onto:investigatesProperty a owl:ObjectProperty ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Property> ;
    rdfs:subPropertyOf onto:investigates ;
    skos:broader <http://emmo.info/emmo#EMMO_60577dea_9019_4537_ac41_80b0fb563d41>,
        <http://www.molmod.info/semantics/pims-ii.ttl#hasRepresentamen> ;
    skos:definition "(x investigatesProperty y) means that x is about target property y, in the context of scientific research and development"@en ;
    skos:prefLabel "investigates property"@en .

onto:orcidId a owl:DatatypeProperty ;
    rdfs:domain prov:Person ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "https://orcid.org/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9X]" ] ) ] ;
    rdfs:subPropertyOf onto:identifier ;
    skos:definition "Open Researcher and Contributor ID: an identifier, that allows unique identification of a person, usually active in research."@en ;
    skos:prefLabel "has ORCID ID"@en .

onto:projectReferenceID a owl:DatatypeProperty ;
    rdfs:domain schema:Project ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:identifier ;
    skos:definition "An alphanumeric identifier for a project. We recommend using an identifier which is understandable outside the involved institutions and possibly resolvable and persistent, such as the [Research Activity Identifier (RAiD)](https://raid.org/) or a funder-given ID (see for example the [DFG project database](https://gepris.dfg.de/gepris/OCTOPUS) or the [EU project database](https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/projects-results))."@en ;
    skos:prefLabel "has project ID"@en .

onto:realizesMethod a owl:ObjectProperty ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:range onto:Method ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000055> ;
    skos:definition "Points to a method that is used within a given processing step"@en ;
    skos:prefLabel "realizes method"@en .

onto:representsVariable a owl:ObjectProperty ;
    rdfs:domain <http://mlcommons.org/croissant/Field> ;
    rdfs:range <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    rdfs:subPropertyOf <http://semanticscience.org/resource/SIO_000210> ;
    skos:definition "Points to a variable that is represented through a field within a recordset"@en ;
    skos:prefLabel "represents variable"@en .

onto:startOfProject a owl:DatatypeProperty ;
    rdfs:domain schema:Project ;
    rdfs:range xsd:date ;
    skos:definition "start date of a project"@en ;
    skos:prefLabel "project start date"@en .

ns2:documentation a owl:AnnotationProperty .

<http://www.molmod.info/semantics/pims-ii.ttl#QuantityValue> a owl:Class ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    skos:definition "Quantity value, i.e., a value that has a numerical magnitude and a physical unit"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels, harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "quantity value"@en .

skos:altLabel a owl:AnnotationProperty .

skos:broader a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

skos:narrower a owl:AnnotationProperty .

skos:note a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

dcat:byteSize a owl:DatatypeProperty ;
    rdfs:domain dcat:Distribution ;
    rdfs:isDefinedBy dcat: ;
    skos:definition "The size of a distribution in bytes."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
    skos:prefLabel "file size (in bytes)"@en ;
    skos:scopeNote "The size in bytes can be approximated when the precise size is not known. The literal value of dcat:byteSize should by typed as xsd:decimal."@en .

dcat:compressFormat a owl:ObjectProperty ;
    rdfs:domain dcat:Distribution ;
    rdfs:isDefinedBy dcat: ;
    skos:definition "The compression format of the distribution in which the data is contained in a compressed form, e.g. to reduce the size of the downloadable file."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
    skos:prefLabel "compression format"@en ;
    skos:scopeNote "This property is to be used when the files in the distribution are compressed, e.g. in a ZIP file. The format SHOULD be expressed using a media type as defined by IANA media types registry https://www.iana.org/assignments/media-types/, if available."@en .

dcat:distribution a owl:ObjectProperty ;
    rdfs:domain dcat:Dataset ;
    rdfs:isDefinedBy dcat: ;
    rdfs:range dcat:Distribution ;
    skos:definition "An available distribution of the dataset."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
    skos:prefLabel "has distribution"@en .

dcat:downloadURL a owl:ObjectProperty ;
    rdfs:domain dcat:Distribution ;
    rdfs:isDefinedBy dcterms: ;
    skos:definition "The URL of the downloadable file in a given format. E.g. CSV file or RDF file. The format is indicated by the distribution's dcterms:format and/or dcat:mediaType."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
    skos:prefLabel "download URL"@en ;
    skos:scopeNote "dcat:downloadURL SHOULD be used for the address at which this distribution is available directly, typically through a HTTP Get request."@en .

dcat:inSeries a owl:ObjectProperty ;
    rdfs:comment "Normally, child datasets in dataset series are represented as dcat:Dataset. The use of dcat:Distribution for typing child datasets is however recognized as a possible alternative, whenever it addresses more effectively the requirements of a given application scenario."@en ;
    rdfs:domain dcat:Dataset ;
    rdfs:isDefinedBy dcat: ;
    rdfs:range dcat:DatasetSeries ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000050> ;
    skos:definition "A dataset series of which the dataset is part."@en ;
    skos:editorialNote "changed by m4i: changed subproperty relation from DCTerms to OBO_000050 added skos:prefLabel, added german labels,  removed redundant notes, extracted from DCAT3-Documentation https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset_Series"@en ;
    skos:prefLabel "in series"@en .

dcat:mediaType a owl:ObjectProperty ;
    rdfs:domain dcat:Distribution ;
    rdfs:isDefinedBy dcat: ;
    skos:definition "The media type of the distribution as defined by IANA."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
    skos:prefLabel "media type"@en ;
    skos:scopeNote "This property SHOULD be used when the media type of the distribution is defined in the IANA media types registry https://www.iana.org/assignments/media-types/, otherwise dcterms:format MAY be used with different values."@en .

dcat:packageFormat a owl:ObjectProperty ;
    rdfs:domain dcat:Distribution ;
    rdfs:isDefinedBy dcat: ;
    skos:definition "The package format of the distribution in which one or more data files are grouped together, e.g. to enable a set of related files to be downloaded together."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
    skos:prefLabel "packaging format"@en ;
    skos:scopeNote "This property to be used when the files in the distribution are packaged, e.g. in a TAR file, a Frictionless Data Package or a Bagit file. The format SHOULD be expressed using a media type as defined by IANA media types registry https://www.iana.org/assignments/media-types/, if available."@en .

dcat:spatialResolutionInMeters a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    skos:definition "Minimum spatial separation resolvable in a dataset, measured in metres."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition, adjusted spelling conform to SI"@en ;
    skos:prefLabel "spatial resolution (in metres)"@en ;
    skos:scopeNote "Alternative spatial resolutions might be provided as different dataset distributions."@en,
        "If the dataset is an image or grid this should correspond to the spacing of items. For other kinds of spatial dataset, this property will usually indicate the smallest distance between items in the dataset."@en .

dcat:temporalResolution a owl:DatatypeProperty ;
    rdfs:range xsd:duration ;
    skos:definition "Minimum time period resolvable in a dataset."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "temporal resolution"@en ;
    skos:scopeNote "Alternative temporal resolutions might be provided as different dataset distributions."@en,
        "If the dataset is a time-series this should correspond to the spacing of items in the series. For other kinds of dataset, this property will usually indicate the smallest time difference between items in the dataset."@en .

prov:SoftwareAgent a owl:Class ;
    rdfs:isDefinedBy prov: ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "A software agent is running software."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel, added skos:definition, added german definition, added instances"@en ;
    skos:prefLabel "software agent"@en .

prov:hadRole a owl:ObjectProperty ;
    rdfs:domain prov:Association ;
    owl:inverseOf prov:wasRoleIn ;
    skos:definition "prov:hadRole references the Role (i.e. the function of an entity with respect to an activity)"@en ;
    skos:editorialNote "changed by m4i: exchanged original rdfs:label by skos:prefLabel, added german label, simplified definition, simplified rdfs:domain to prov:Association"@en ;
    skos:prefLabel "had role"@en .

prov:wasAssociateFor a owl:ObjectProperty ;
    owl:inverseOf prov:wasAssociatedWith ;
    skos:altLabel "wasAssociateFor"@en ;
    skos:definition "property between an agent and an activity with which the agent was associated with or participates in"@en ;
    skos:editorialNote "changed by m4i: exchanged original rdfs:label by skos:prefLabel, added German skos:preflabel; added own skos:definition"@en ;
    skos:prefLabel "participates in"@en .

ssn:hasProperty a owl:ObjectProperty ;
    rdfs:isDefinedBy ssn: ;
    owl:inverseOf ssn:isPropertyOf ;
    skos:definition "Relation between an entity and a Property of that entity."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels"@en ;
    skos:prefLabel "has property"@en .

foaf:Group a owl:Class ;
    rdfs:comment "DEPRECATED A class of Agents.",
        "Remove foaf:Group, use prov:Organization instead" ;
    rdfs:seeAlso prov:Organization ;
    rdfs:subClassOf foaf:Agent ;
    owl:deprecated true .

foaf:firstName a owl:DatatypeProperty ;
    rdfs:comment "The first name of a person." ;
    rdfs:range rdfs:Literal ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "first name"@en .

foaf:homepage a owl:AnnotationProperty .

foaf:lastName a owl:DatatypeProperty ;
    rdfs:comment "The last name of a person." ;
    rdfs:range rdfs:Literal ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "last name"@en .

foaf:logo a owl:AnnotationProperty .

foaf:mbox a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "A personal mailbox, ie. an Internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that   there is (across time and change) at most one individual that ever has any particular value for foaf:mbox." ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range owl:Thing ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en ;
    skos:prefLabel "personal mailbox"@en .

foaf:name a owl:AnnotationProperty .

foaf:title a owl:DatatypeProperty ;
    rdfs:comment "Title (Mr, Mrs, Ms, Dr. etc)" ;
    rdfs:range rdfs:Literal ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel, defined rdfs:domain and rdfs:range"@en ;
    skos:prefLabel "salutation"@en .

schema:ResearchProject a owl:Class ;
    rdfs:comment "A research project"@en ;
    rdfs:subClassOf schema:Project ;
    skos:editorialNote "changed by m4i: added German definition, added language tag to English definition"@en,
        "changed by m4i: changed label to \"research project\" (no CamelCase)"@en,
        "changed by m4i: use of skos:prefLabel instead of rdfs:label, added German label, added language tag to English label"@en ;
    skos:prefLabel "research project"@en .

schema:affiliation a owl:AnnotationProperty ;
    rdfs:comment "An organization that this person is affiliated with. For example, a school/university, a club, or a team."@en ;
    skos:editorialNote "changed by m4i: added German definition, added language tag to English definition"@en,
        "changed by m4i: added application example"@en,
        "changed by m4i: use of skos:prefLabel instead of rdfs:label, added German label, added language tag to English label"@en ;
    skos:example ":Person schema:affiliation :Organization ."@en ;
    skos:prefLabel "affiliation"@en .

schema:citation a owl:AnnotationProperty .

schema:endTime a owl:DatatypeProperty ;
    rdfs:comment "The endTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to end. For actions that span a period of time, when the action was performed. e.g. John wrote a book from January to <em>December</em>. For media, including audio and video, it's the time offset of the end of a clip within a larger file.<br/><br/>\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions."@en ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:DateTime ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german label"@en ;
    skos:prefLabel "end time"@en .

schema:funder a owl:AnnotationProperty ;
    rdfs:comment "A person or organization that supports (sponsors) something through some kind of financial contribution."@en ;
    skos:editorialNote "changed by m4i: added German definition, added language tag to English definition"@en,
        "changed by m4i: added application example"@en,
        "changed by m4i: use of skos:prefLabel instead of rdfs:label, added German label, added language tag to English label"@en ;
    skos:example ":Project schema:funder :DFG"@en ;
    skos:prefLabel "funder"@en .

schema:funding a owl:AnnotationProperty .

schema:logo a owl:AnnotationProperty .

schema:startTime a owl:DatatypeProperty ;
    rdfs:comment "The startTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to start. For actions that span a period of time, when the action was performed. e.g. John wrote a book from <em>January</em> to December. For media, including audio and video, it's the time offset of the start of a clip within a larger file.<br/><br/>\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions."@en ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:DateTime ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german label"@en ;
    skos:prefLabel "start time"@en .

ns3:hasSyntax a owl:AnnotationProperty .

<http://mlcommons.org/croissant/RecordSet> a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    skos:definition "A description of a set of structured records from one or more data sources and their structure, expressed as a set of fields."@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel and skos:definition, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "record set"@en .

<http://purl.obolibrary.org/obo/BFO_0000050> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    owl:inverseOf <http://purl.obolibrary.org/obo/BFO_0000051> ;
    skos:definition "a core relation that holds between a part and its whole"@en ;
    skos:editorialNote "changed by m4i: added german labels, added skos:prefLabel"@en,
        "changed by m4i: copied obo:IAO_0000115 to a skos:definition"@en ;
    skos:prefLabel "part of"@en .

<http://purl.obolibrary.org/obo/BFO_0000063> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x precedes y if and only if the time point at which x ends is before or equivalent to the time point at which y starts. Formally: x precedes y iff ω(x) <= α(y), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point."@en ;
    skos:prefLabel "precedes"@en .

<http://purl.obolibrary.org/obo/RO_0002352> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000056> ;
    skos:definition "(x input of y) means x is a specific input of y to carry out further processes"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel"@en ;
    skos:prefLabel "input of"@en .

<http://purl.obolibrary.org/obo/RO_0002353> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000056> ;
    skos:definition "(x output of y) means x is the specific output of y as the result or further processes"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel"@en ;
    skos:prefLabel "output of"@en .

<http://semanticscience.org/resource/SIO_000001> a owl:ObjectProperty ;
    skos:definition "A ist verwandt zu B wenn eine Beziehnung zwischen beiden besteht",
        "A is related to B iff there is some relation between A and B."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels" ;
    skos:prefLabel "is related to"@en .

<http://semanticscience.org/resource/SIO_000210> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://semanticscience.org/resource/SIO_000628> ;
    skos:definition "A repräsentiert B wenn es als ein Zeichen, Symbol oder Modell von B dient",
        "A represents B when A serves as a sign, symbol or model of B."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels" ;
    skos:prefLabel "represents"@en .

<http://semanticscience.org/resource/SIO_000628> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://semanticscience.org/resource/SIO_000001> ;
    skos:definition "bezieht sich auf ist eine Relation zwischen einer Entität und einer anderen Entität, auf die sie sich bezieht",
        "refers to is a relation between one entity and the entity that it makes reference to."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels" ;
    skos:prefLabel "refers to"@en .

onto:TextVariable a owl:Class ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    skos:definition "A variable that expects a string of characters as a value"@en ;
    skos:prefLabel "text variable"@en .

onto:hasNumericalValue a owl:DatatypeProperty ;
    rdfs:domain onto:NumericalVariable ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:decimal <https://ptb.de/dcc/formulaType> ) ] ;
    rdfs:subPropertyOf onto:hasValue ;
    skos:broader <http://qudt.org/schema/qudt/value>,
        <http://www.molmod.info/semantics/pims-ii.ttl#isLiterally>,
        <https://ptb.de/si/hasValue> ;
    skos:closeMatch <https://ptb.de/si/hasNumericalValue> ;
    skos:definition "Represents the numerical value of a real"@en ;
    skos:prefLabel "has numerical value"@en .

onto:implementsMethod a owl:ObjectProperty ;
    rdfs:domain onto:Tool ;
    rdfs:range onto:Method ;
    rdfs:subPropertyOf ssn:implements ;
    skos:definition "Points to a method that is implemented by a given tool"@en ;
    skos:prefLabel "implements"@en .

onto:investigates a owl:ObjectProperty ;
    rdfs:domain onto:ProcessingStep ;
    rdfs:range owl:Thing ;
    skos:definition "(x investigates y) means that x is about y, in the context of scientific research and development"@en ;
    skos:prefLabel "investigates"@en .

onto:isEmployedToolIn a owl:ObjectProperty ;
    rdfs:domain onto:Tool ;
    rdfs:range onto:ProcessingStep ;
    skos:definition "Points to a processing step the tool has been used in"@en ;
    skos:prefLabel "is employed tool"@en .

onto:projectParticipant a owl:ObjectProperty ;
    rdfs:domain schema:Project ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( prov:Organization prov:Person ) ] ;
    skos:definition "A property that connects a project with a person or an organisation."@en ;
    skos:prefLabel "project participant"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#Property> a owl:Class ;
    rdfs:subClassOf <http://www.molmod.info/semantics/pims-ii.ttl#Variable> ;
    skos:broader <http://purl.obolibrary.org/obo/BFO_0000020> ;
    skos:closeMatch <http://emmo.info/emmo#EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba> ;
    skos:definition "Property, i.e., a variable that can be considered (as an investigated property, i.e., target property) within a processing step"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels, harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "property"@en .

<http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleUnitFor> a owl:ObjectProperty ;
    rdfs:comment "redundant information: admissible unit can be deduced from quantity kind. If one wants to enforce the use of a specific unit, use a SHACL contraint." ;
    rdfs:domain <http://qudt.org/schema/qudt/Unit> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://qudt.org/schema/qudt/QuantityKind> onto:NumericalVariable ) ] ;
    owl:deprecated true ;
    skos:definition "DEPRECATED (x isAdmissibleUnitFor y) means that x is a unit that can be associated with the variable y; subsumption under msHPIPIR is explained as follows: There is a sign z for the variable y (where z is a description of admissible values of y) of which x is constitutive (and with which x hence overlaps)"@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, adjusted german labels, harmonized spelling to OBO naming conventions (lower case, space separated)" ;
    skos:prefLabel "is admissible unit for"@en .

xsd:duration a rdfs:Datatype .

dcat:DatasetSeries a owl:Class ;
    rdfs:isDefinedBy dcat: ;
    rdfs:subClassOf dcat:Dataset ;
    skos:definition "A collection of datasets that are published separately, but share some common characteristics that groups them."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels, removed redundant notes, extracted from DCAT3-Documentation https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset_Series"@en ;
    skos:prefLabel "dataset series"@en .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Agent ;
    owl:propertyChainAxiom ( prov:qualifiedAssociation prov:agent ) ;
    skos:altLabel "wasAssociatedWith"@en ;
    skos:definition "property between some activity and an agent involved in that activity"@en ;
    skos:editorialNote "changed by m4i: exchanged original rdfs:label by skos:prefLabel, moved original rdfs:label to skos:altLabel, added German skos:preflabel; added own skos:definition"@en ;
    skos:prefLabel "has participant"@en .

prov:wasRoleIn a owl:ObjectProperty ;
    skos:definition "prov:wasRoleIn references the association (e.g. between an agent and an activity) in which a role shall be defined. Inverse property of prov:hadRole." ;
    skos:editorialNote "changed by m4i: exchanged original rdfs:label by skos:prefLabel, added german label, added skos:definition, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
    skos:prefLabel "was role in"@en .

ssn:implementedBy a owl:ObjectProperty ;
    skos:definition "Relation between a Procedure (an algorithm, procedure or method) and an entity that implements that Procedure in some executable way."@en ;
    skos:editorialNote "changed by m4i: added skos:definition, added german definition"@en ;
    skos:prefLabel "implemented by"@en .

ssn:implements a owl:ObjectProperty ;
    skos:definition "Relation between an entity that implements a Procedure in some executable way and the Procedure (an algorithm, procedure or method)."@en ;
    skos:editorialNote "changed by m4i: added skos:definition, added german definition"@en ;
    skos:prefLabel "implements"@en .

ssn:isPropertyOf a owl:ObjectProperty ;
    skos:definition "Relation between a Property and the entity it belongs to."@en ;
    skos:editorialNote "changed by m4i: added skos:prefLabel, added german labels"@en ;
    skos:prefLabel "is property of"@en .

