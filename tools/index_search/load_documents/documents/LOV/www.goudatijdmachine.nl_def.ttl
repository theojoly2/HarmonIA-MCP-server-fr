@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <https://www.goudatijdmachine.nl/def> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:abstract a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:hasVersion a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

xsd:date a rdfs:Datatype .

<http://www.w3.org/2003/01/geo/wgs84_pos#asWKT> a owl:DatatypeProperty ;
    rdfs:label "geometry as well-known text (WKT)"@en ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#Geometry> ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#wktLiteral> .

<http://www.w3.org/2003/01/geo/wgs84_pos#hasGeometry> a owl:ObjectProperty ;
    rdfs:label "has geometry"@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#GeoTemporeelObject> ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#Geometry> .

org:memberOf a owl:AnnotationProperty .

foaf:homepage a owl:AnnotationProperty .

foaf:logo a owl:AnnotationProperty .

foaf:name a owl:AnnotationProperty .

schema:creativeWorkStatus a owl:AnnotationProperty .

schema:endDate a owl:DatatypeProperty ;
    rdfs:label "end date"@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#GeoTemporeelObject> ;
    rdfs:range xsd:dateTime .

schema:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#GeoTemporeelObject> ;
    rdfs:range xsd:string .

schema:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#GeoTemporeelObject> ;
    rdfs:range xsd:string .

schema:startDate a owl:DatatypeProperty ;
    rdfs:label "start date"@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#GeoTemporeelObject> ;
    rdfs:range xsd:dateTime .

<https://w3id.org/widoco/vocab#introduction> a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dcterms:abstract "The Gouda Time Machine describes and links geo-temporal objects related to the city (and people) of Gouda. This ontology specifically describes the generic GeoTemporalObject class, its properties and subclasses. The ontology is set up in Dutch."@en ;
    dcterms:bibliographicCitation "Gouda Time Machine Ontology, versie 0.9, https://www.goudatijdmachine.nl/def/"@en ;
    dcterms:created "2021-11-25"^^xsd:date ;
    dcterms:creator [ org:memberOf [ foaf:homepage "https://www.goudatijdmachine.nl" ;
                    foaf:name "Gouda Time Machine"@en ] ;
            foaf:name "Bob Coret" ] ;
    dcterms:hasVersion "0.9" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2024-06-26"^^xsd:date ;
    dcterms:title "Gouda Time Machine Ontology"@en ;
    vann:preferredNamespacePrefix "gtm" ;
    vann:preferredNamespaceUri <https://www.goudatijdmachine.nl/def#> ;
    rdfs:comment "The Gouda Time Machine Ontology describes the geo-temporal classes and properties used within the Gouda Time Machine.<br>In the diagram below, the blue blocks indicate classes, the arrows between them subclasses, and the red blocks are properties associated with the class.<br><br><img alt=\"https://docs.google.com/presentation/d/1GQCdcWp2ruxdYIbfW5ZzWALfJf09OEmUwcT8ak7I_yc/\" title=\"Diagram of the Gouda Time Machine Ontology\" src=\"diagram-en.png\">"@en ;
    foaf:logo <https://www.goudatijdmachine.nl/wp-content/uploads/sites/7/2021/08/wapen.png#> ;
    schema:creativeWorkStatus "Gouda Time Machine Ontology Specification"@en .

<https://www.goudatijdmachine.nl/def#Hofje> a owl:Class ;
    rdfs:label "Courtyard"@en ;
    rdfs:comment "A partly private community intended for the needy, usually consisting of a number of houses around a small park."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Structuur> .

<https://www.goudatijdmachine.nl/def#Kwartier> a owl:Class ;
    rdfs:label "Quarter"@en ;
    rdfs:comment "A quarter is a part of a city or town that is often characterized by a specific function or population group, such as a residential, commercial, or entertainment area."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Structuur> .

<https://www.goudatijdmachine.nl/def#NummerAanduiding> a owl:Class ;
    rdfs:label "Number designation"@en ;
    rdfs:comment "One number issued per district."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Adressering> ;
    owl:disjointWith <https://www.goudatijdmachine.nl/def#PlaatselijkeAanduiding>,
        <https://www.goudatijdmachine.nl/def#StraatNummerAanduiding> .

<https://www.goudatijdmachine.nl/def#PlaatsPlaats> a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "A place is an inhabited location such as a city, town, or other settlement, where people live and work."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Structuur> .

<https://www.goudatijdmachine.nl/def#Sectie> a owl:Class ;
    rdfs:label "Section"@en ;
    rdfs:comment "The section that uniquely identifies the section within the cadastral municipality."@en ;
    rdfs:seeAlso <http://brk.basisregistraties.overheid.nl/id/begrip/Sectie> ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Structuur> .

<https://www.goudatijdmachine.nl/def#heeftAdres> a owl:ObjectProperty ;
    rdfs:label "has address"@en ;
    rdfs:comment "The property 'heeft adres' (has address) indicates that an entity is associated with a specific address, which denotes a unique location within a geographic area."@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#Gebouw> ;
    rdfs:range <https://www.goudatijdmachine.nl/def#Adressering> ;
    owl:inverseOf <https://www.goudatijdmachine.nl/def#adresseert> .

<https://www.goudatijdmachine.nl/def#ligtIn> a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#Structuur> ;
    rdfs:range <https://www.goudatijdmachine.nl/def#Structuur> .

<https://www.goudatijdmachine.nl/def#ligtInStraat> a owl:ObjectProperty ;
    rdfs:label "is located in street"@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#StraatNummerAanduiding> ;
    rdfs:range <https://www.goudatijdmachine.nl/def#Straat> .

<https://www.goudatijdmachine.nl/def#ligtInWijk> a owl:ObjectProperty ;
    rdfs:label "is located in district"@en ;
    rdfs:comment "The property 'located in district' indicates that an neighbourhood is situated within a specific district, where a district is a defined area within a city or town."@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#Buurt> ;
    rdfs:range <https://www.goudatijdmachine.nl/def#Wijk> .

<https://www.goudatijdmachine.nl/def#staatOpPerceel> a owl:ObjectProperty ;
    rdfs:label "build on plot"@en ;
    rdfs:comment "The property 'is located on parcel' indicates that an entity is situated on a specific parcel of land, where a parcel is a piece of land delineated for a specific purpose."@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#Adressering> ;
    rdfs:range <https://www.goudatijdmachine.nl/def#Perceel> .

<http://www.w3.org/2003/01/geo/wgs84_pos#Feature> a owl:Class .

<http://www.w3.org/2003/01/geo/wgs84_pos#wktLiteral> a rdfs:Datatype .

<https://www.goudatijdmachine.nl/def#Buurt> a owl:Class ;
    rdfs:label "Neighbourhood"@en ;
    rdfs:comment "Part of a municipality that is homogeneously demarcated on the basis of historical or urban development characteristics. Homogeneous means that one function is dominant, for example residential function (residential area), work function (industrial area) or recreational function (nature area). However, functions can also be mixed. The municipalities in the Netherlands are divided into districts and neighborhoods. Neighborhoods are the lowest regional level. Neighborhoods are sums of one or more contiguous neighborhoods. The municipality itself determines the division into districts and neighborhoods."@en ;
    rdfs:seeAlso <https://www.cbs.nl/nl-nl/onze-diensten/methoden/begrippen/buurt> ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Structuur> .

<https://www.goudatijdmachine.nl/def#Kunstwerk> a owl:Class ;
    rdfs:label "Work of art"@en ;
    rdfs:comment "A work of art is a civil engineering work for the infrastructure of roads, water, railways, flood defenses and/or pipes and is not intended for permanent human residence."@en ;
    rdfs:seeAlso <http://bag.basisregistraties.overheid.nl/id/begrip/Kunstwerk> ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Constructie> ;
    owl:disjointWith <https://www.goudatijdmachine.nl/def#Natuur> .

<https://www.goudatijdmachine.nl/def#Perceel> a owl:Class ;
    rdfs:label "Plot"@en ;
    rdfs:comment "A plot is a limited part of Dutch territory that is cadastrally identified and bounded by cadastral boundaries."@en ;
    rdfs:seeAlso <http://brk.basisregistraties.overheid.nl/id/begrip/Perceel> ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Structuur> .

<https://www.goudatijdmachine.nl/def#PlaatselijkeAanduiding> a owl:Class ;
    rdfs:label "Place designation"@en ;
    rdfs:comment "Combination of the district letter and a number issued per district."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Adressering> ;
    owl:disjointWith <https://www.goudatijdmachine.nl/def#StraatNummerAanduiding> .

<https://www.goudatijdmachine.nl/def#Straat> a owl:Class ;
    rdfs:label "Street"@en ;
    rdfs:comment "A street is a public road in a village, town, or other inhabited area. Streets are usually used by vehicles and pedestrians and can have houses, businesses, and other buildings on either side."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Structuur> .

<https://www.goudatijdmachine.nl/def#Wijk> a owl:Class ;
    rdfs:label "District"@en ;
    rdfs:comment "Part of a municipality and cluster of one or more neighborhoods, which is homogeneously demarcated on the basis of historical or urban development characteristics. A district consists of one or more neighborhoods."@en ;
    rdfs:seeAlso <https://www.cbs.nl/nl-nl/onze-diensten/methoden/begrippen/wijk> ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Structuur> .

<https://www.goudatijdmachine.nl/def#adresseert> a owl:ObjectProperty ;
    rdfs:label "addresses"@en ;
    rdfs:comment "The property 'adresseert' (adresses) indicates that an entity is associated with a specific address, which denotes a unique location within a geographic area."@en ;
    rdfs:domain <https://www.goudatijdmachine.nl/def#Adressering> ;
    rdfs:range <https://www.goudatijdmachine.nl/def#Gebouw> .

<http://www.w3.org/2003/01/geo/wgs84_pos#Geometry> a owl:Class .

<https://www.goudatijdmachine.nl/def#Gebouw> a owl:Class ;
    rdfs:label "Building"@en ;
    rdfs:comment "A building is the smallest functionally and architecturally-constructively independent unit that is directly and permanently connected to the earth and can be entered and locked."@en ;
    rdfs:seeAlso <http://bag.basisregistraties.overheid.nl/id/begrip/Pand> ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Constructie> ;
    owl:disjointWith <https://www.goudatijdmachine.nl/def#Kunstwerk>,
        <https://www.goudatijdmachine.nl/def#Natuur> .

<https://www.goudatijdmachine.nl/def#Natuur> a owl:Class ;
    rdfs:label "Nature"@en ;
    rdfs:comment "Nature is everything in the physical world that is not made by humans, including plants, trees, landscapes, waterways, and other elements of the Earth."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Constructie> .

<https://www.goudatijdmachine.nl/def#Constructie> a owl:Class ;
    rdfs:label "Construction"@en ;
    rdfs:comment "A construction is a human-made or naturally created object or ensemble, which have a physical form and function within a specific area."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#GeoTemporeelObject> .

<https://www.goudatijdmachine.nl/def#StraatNummerAanduiding> a owl:Class ;
    rdfs:label "Street number designation"@en ;
    rdfs:comment "A number issued per street."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#Adressering> .

<https://www.goudatijdmachine.nl/def#Adressering> a owl:Class ;
    rdfs:label "Addressing"@en ;
    rdfs:comment "Addressing is the assignment of an address to a location, object, or entity within a geographic area, enabling it to be uniquely identified for postal and identification purposes."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#GeoTemporeelObject> .

<https://www.goudatijdmachine.nl/def#GeoTemporeelObject> a owl:Class ;
    rdfs:label "Geo temporal object"@en ;
    rdfs:comment "A geo-temporal object is an entity that has both geographical and temporal characteristics, enabling the specification and analysis of the location and time period of events or objects in space."@en ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#Feature> .

<https://www.goudatijdmachine.nl/def#Structuur> a owl:Class ;
    rdfs:label "Structure"@en ;
    rdfs:comment "A structure is an organized collection of interconnected elements within a geographic area, such as a parcel, district, street, neighborhood, section, or place, that together form the physical and functional composition of a region."@en ;
    rdfs:subClassOf <https://www.goudatijdmachine.nl/def#GeoTemporeelObject> .

