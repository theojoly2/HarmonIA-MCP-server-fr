    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:range onto:Money_for_Service ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14i_performed> ;
    owl:inverseOf onto:money_provided_to .

onto:registered_by a rdf:Property ;
    rdfs:label "registered by"@en ;
    rdfs:comment "This property describes the authority, the port of registry, which is responsible for the registration of a ship."@en ;
    rdfs:domain onto:Ship_Registration ;
    rdfs:range onto:Port_of_Registry ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by> ;
    owl:inverseOf onto:is_responsible_for_registration .

onto:registers a rdf:Property ;
    rdfs:label "registers"@en ;
    rdfs:comment "This property associates a ship and the ship registration activity that registered and identified it."@en ;
    rdfs:domain onto:Ship_Registration ;
    rdfs:range onto:Ship ;
    owl:inverseOf onto:is_registered_by .

onto:registers_person a rdf:Property ;
    rdfs:label "registers person"@en ;
    rdfs:comment "This property describes a person that is registered by a civil registration activity."@en ;
    rdfs:domain onto:Civil_Registration ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E21_Person> ;
    owl:inverseOf onto:person_is_registered_by .

onto:repaired a rdf:Property ;
    rdfs:label "repaired"@en ;
    rdfs:comment "This property identifies a ship repaired by a ship repair activity."@en ;
    rdfs:domain onto:Ship_Repair ;
    rdfs:range onto:Ship ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P31_has_modified> ;
    owl:inverseOf onto:was_repaired_by .

onto:ship_ID_identifies a rdf:Property ;
    rdfs:label "ship ID identifies"@en ;
    rdfs:domain onto:Ship_ID ;
    rdfs:range onto:Ship ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P1i_identifies> ;
    owl:inverseOf onto:has_ship_ID .

onto:ship_ID_of a rdf:Property ;
    rdfs:label "ship ID of"@en ;
    rdfs:domain onto:Ship_ID ;
    rdfs:range onto:Ship_Registration ;
    owl:inverseOf onto:with_ship_ID .

onto:started a rdf:Property ;
    rdfs:label "started"@en ;
    rdfs:comment "This property describes an employment that was started by a recruitment activity."@en ;
    rdfs:domain onto:Recruitment ;
    rdfs:range onto:Employment ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P175_starts_before_or_with_the_start_of> ;
    owl:inverseOf onto:started_by .

onto:started_by a rdf:Property ;
    rdfs:label "started by"@en ;
    rdfs:domain onto:Employment ;
    rdfs:range onto:Recruitment ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P175i_starts_after_or_with_the_start_of> ;
    owl:inverseOf onto:started .

onto:starting_from a rdf:Property ;
    rdfs:label "starting from"@en ;
    rdfs:comment "This property describes the spatial location from which a voyage started. It is the beginning of the route."@en ;
    rdfs:domain onto:Voyage ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E53_Place> ;
    owl:inverseOf onto:is_starting_place_of .

onto:status_type_was_promoted_by a rdf:Property ;
    rdfs:label "status type was promoted by"@en ;
    rdfs:domain onto:Social_Status ;
    rdfs:range onto:Promotion ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P141i_was_assigned_by> ;
    owl:inverseOf onto:promoted_into_status_type .

onto:student_in a rdf:Property ;
    rdfs:label "student in"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:range onto:Teaching_Unit ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P11i_participated_in> ;
    owl:inverseOf onto:had_student .

onto:terminates_ownership a rdf:Property ;
    rdfs:label "terminates ownership"@en ;
    rdfs:domain onto:De-flagging ;
    rdfs:range onto:Ship_Ownership_Phase ;
    rdfs:subPropertyOf onto:terminates ;
    owl:inverseOf onto:ownership_is_terminated_by .

onto:thing_of a rdf:Property ;
    rdfs:label "thing of"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> ;
    rdfs:range onto:Money_for_Things ;
    owl:inverseOf onto:for_thing .

onto:through_place a rdf:Property ;
    rdfs:label "through place"@en ;
    rdfs:comment "This property associates an instance of a place with an instance of a passing activity through that place. This class provides information about the types of movements of a ship, which are parts of the route (of the voyage), and are documented as that."@en ;
    rdfs:domain onto:Passing ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E53_Place> ;
    owl:inverseOf onto:is_place_of_passing_through .

onto:under_name a rdf:Property ;
    rdfs:label "under name"@en ;
    rdfs:comment "This property identifies the name of the ship with the ship construction information."@en ;
    rdfs:domain onto:Ship_Construction ;
    rdfs:range onto:Ship_Name ;
    owl:inverseOf onto:named_with .

onto:unloaded a rdf:Property ;
    rdfs:label "unloaded"@en ;
    rdfs:comment "This property associates an instance of E18 Physical Thing with an instance of the unloading activity that moved (unloaded) it."@en ;
    rdfs:domain onto:Unloading ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> ;
    owl:inverseOf onto:was_unloaded_by .

onto:unloading_is_part_of a rdf:Property ;
    rdfs:label "unloading is part of"@en ;
    rdfs:domain onto:Unloading ;
    rdfs:range onto:Voyage ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P9i_forms_part_of> ;
    owl:inverseOf onto:consists_of_unloading .

onto:voyage_of a rdf:Property ;
    rdfs:label "voyage of"@en ;
    rdfs:comment "This property describes the voyage of a ship, its movement/travelling at sea."@en ;
    rdfs:domain onto:Voyage ;
    rdfs:range onto:Ship ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P12_occurred_in_the_presence_of> ;
    owl:inverseOf onto:voyages .

onto:voyages a rdf:Property ;
    rdfs:label "voyages"@en ;
    rdfs:domain onto:Ship ;
    rdfs:range onto:Voyage ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P12i_was_present_at> ;
    owl:inverseOf onto:voyage_of .

onto:was_constructed_by a rdf:Property ;
    rdfs:label "was constructed by"@en ;
    rdfs:domain onto:Ship ;
    rdfs:range onto:Ship_Construction ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P108i_was_produced_by> ;
    owl:inverseOf onto:constructed .

onto:was_flag_of a rdf:Property ;
    rdfs:label "was flag of"@en ;
    rdfs:domain onto:Country ;
    rdfs:range onto:Ship ;
    owl:inverseOf onto:had_flag_of .

onto:was_loaded_by a rdf:Property ;
    rdfs:label "was loaded by"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> ;
    rdfs:range onto:Loading ;
    owl:inverseOf onto:loaded .

onto:was_mediated_by a rdf:Property ;
    rdfs:label "was mediated by"@en ;
    rdfs:comment "This property identifies the E39 Actor that participated in the transaction (Money for Service activity) in the role of a mediator. For example, there are sources that refer that seamen used to provide money to the captain of the ship in order that the wives to receive these money (so the captain was the mediator of this transaction)."@en ;
    rdfs:domain onto:Money_for_Service ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by> ;
    owl:inverseOf onto:was_mediator_of .

onto:was_mediator_of a rdf:Property ;
    rdfs:label "was mediator of"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:range onto:Money_for_Service ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14i_performed> ;
    owl:inverseOf onto:was_mediated_by .

onto:was_price_of a rdf:Property ;
    rdfs:label "was price of"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E97_Monetary_Amount> ;
    rdfs:range onto:Money_for_Service ;
    owl:inverseOf onto:had_money_value .

onto:was_promoted_by a rdf:Property ;
    rdfs:label "was promoted by"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E21_Person> ;
    rdfs:range onto:Promotion ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P140i_was_attributed_by> ;
    owl:inverseOf onto:concerned .

onto:was_punished_by a rdf:Property ;
    rdfs:label "was punished by"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:range onto:Punishment ;
    owl:inverseOf onto:is_given_to .

onto:was_repaired_by a rdf:Property ;
    rdfs:label "was repaired by"@en ;
    rdfs:domain onto:Ship ;
    rdfs:range onto:Ship_Repair ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P31i_was_modified_by> ;
    owl:inverseOf onto:repaired .

onto:was_unloaded_by a rdf:Property ;
    rdfs:label "was unloaded by"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> ;
    rdfs:range onto:Unloading ;
    owl:inverseOf onto:unloaded .

onto:with_ID a rdf:Property ;
    rdfs:label "with ID"@en ;
    rdfs:comment "This property records the identifier that was assigned to a person in a Civil Registration activity."@en ;
    rdfs:domain onto:Civil_Registration ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E42_Identifier> ;
    owl:inverseOf onto:ID_of .

onto:with_ship_ID a rdf:Property ;
    rdfs:label "with ship ID"@en ;
    rdfs:comment "This property records the ship identifier assigned by a Ship Registration activity."@en ;
    rdfs:domain onto:Ship_Registration ;
    rdfs:range onto:Ship_ID ;
    owl:inverseOf onto:ship_ID_of .

onto:with_ship_flag_of a rdf:Property ;
    rdfs:label "with ship flag of"@en ;
    rdfs:comment "This property identifies the country represented in the ship flag of a Ship Registration activity."@en ;
    rdfs:domain onto:Ship_Registration ;
    rdfs:range onto:Country ;
    owl:inverseOf onto:is_flag_of .

onto:works_at a rdf:Property ;
    rdfs:label "works at"@en ;
    rdfs:comment "This property identifies the workplace, meaning the organisation/company in which a person works at. The in the role of property of the property allows specifying the nature, the role of an actor’s work in the organisation/company."@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E21_Person> ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E74_Group> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P107i_is_current_or_former_member_of> ;
    owl:inverseOf onto:is_working_place_of .

onto:for_service a rdf:Property ;
    rdfs:label "for service"@en ;
    rdfs:comment "This property describes a Money for Service activity that pays/receives money for Services."@en ;
    rdfs:domain onto:Money_for_Service ;
    rdfs:range onto:Service ;
    owl:inverseOf onto:service_of .

onto:has_owner a rdf:Property ;
    rdfs:label "has owner"@en ;
    rdfs:comment "This property describes information about the owner, the person or the company (shipping enterprise), of a ship. In the context of the SeaLiT project, we make the hypothesis that the owner as a concept, implies a legal entity, so in that sense, a person is the minimum legal entity-company (with members himself/herself) of a ship."@en ;
    rdfs:domain onto:Ship_Ownership_Phase ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    owl:inverseOf onto:is_owner_of_phase .

onto:has_ownership_phase a rdf:Property ;
    rdfs:label "has ownership phase"@en ;
    rdfs:domain onto:Ship ;
    rdfs:range onto:Ship_Ownership_Phase ;
    owl:inverseOf onto:is_ownership_phase_of .

onto:initializes a rdf:Property ;
    rdfs:label "initializes"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E5_Event> ;
    rdfs:range onto:Legal_Object_Relationship ;
    owl:inverseOf onto:is_initialized_by .

onto:is_initialized_by a rdf:Property ;
    rdfs:label "is initialized by"@en ;
    rdfs:comment "This property associates the beginning of an instance of Legal Object Relationship with an explicit event initiating it."@en ;
    rdfs:domain onto:Legal_Object_Relationship ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E5_Event> ;
    owl:inverseOf onto:initializes .

onto:is_owner_of_phase a rdf:Property ;
    rdfs:label "is owner of phase"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:range onto:Ship_Ownership_Phase ;
    owl:inverseOf onto:has_owner .

onto:is_ownership_phase_of a rdf:Property ;
    rdfs:label "is ownership phase of"@en ;
    rdfs:comment "This property associates a ship with the different ownership phases related to it."@en ;
    rdfs:domain onto:Ship_Ownership_Phase ;
    rdfs:range onto:Ship ;
    owl:inverseOf onto:has_ownership_phase .

onto:is_terminated_by a rdf:Property ;
    rdfs:label "is terminated by"@en ;
    rdfs:comment "This property associates the end of existence of an instance of Legal Object Relationship with an explicit event that terminates it."@en ;
    rdfs:domain onto:Legal_Object_Relationship ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E5_Event> ;
    owl:inverseOf onto:terminates .

onto:provided_service a rdf:Property ;
    rdfs:label "provided service"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:range onto:Service ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14i_performed> ;
    owl:inverseOf onto:service_provided_by .

onto:service_of a rdf:Property ;
    rdfs:label "service of"@en ;
    rdfs:domain onto:Service ;
    rdfs:range onto:Money_for_Service ;
    owl:inverseOf onto:for_service .

onto:service_provided_by a rdf:Property ;
    rdfs:label "service provided by"@en ;
    rdfs:comment "This property describes the intention of an E39 Actor to provide a service. The property of property in the role of allows specifying the nature of an Actor’s service provision."@en ;
    rdfs:domain onto:Service ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by> ;
    owl:inverseOf onto:provided_service .

onto:terminates a rdf:Property ;
    rdfs:label "terminates"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E5_Event> ;
    rdfs:range onto:Legal_Object_Relationship ;
    owl:inverseOf onto:is_terminated_by .

