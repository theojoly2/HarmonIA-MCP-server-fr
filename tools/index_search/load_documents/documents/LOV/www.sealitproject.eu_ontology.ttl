    rdfs:domain onto:Tonnage ;
    rdfs:range onto:Ship ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P43i_is_dimension_of> ;
    owl:inverseOf onto:has_tonnage .

onto:is_working_place_of a rdf:Property ;
    rdfs:label "is working place of"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E74_Group> ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E21_Person> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P107_has_current_or_former_member> ;
    owl:inverseOf onto:works_at .

onto:leaving_is_part_of a rdf:Property ;
    rdfs:label "leaving is part of"@en ;
    rdfs:domain onto:Leaving ;
    rdfs:range onto:Voyage ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P9i_forms_part_of> ;
    owl:inverseOf onto:consists_of_leaving .

onto:loaded a rdf:Property ;
    rdfs:label "loaded"@en ;
    rdfs:comment "This property associates an instance E18 Physical Thing with an instance of the loading activity that moved (loaded) it."@en ;
    rdfs:domain onto:Loading ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> ;
    owl:inverseOf onto:was_loaded_by .

onto:loading_is_part_of a rdf:Property ;
    rdfs:label "loading is part of"@en ;
    rdfs:domain onto:Loading ;
    rdfs:range onto:Voyage ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P9i_forms_part_of> ;
    owl:inverseOf onto:consists_of_loading .

onto:money_provided_by a rdf:Property ;
    rdfs:label "money provided by"@en ;
    rdfs:comment "This property identifies the E39 Actor that paid (gave money) for a specific service (Money For Service)."@en ;
    rdfs:domain onto:Money_for_Service ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by> ;
    owl:inverseOf onto:provided_money .

onto:money_provided_to a rdf:Property ;
    rdfs:label "money provided to"@en ;
    rdfs:comment "This property identifies the E39 Actor that received money for a specific service (Money For Service)."@en ;
    rdfs:domain onto:Money_for_Service ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by> ;
    owl:inverseOf onto:received_money .

onto:motivated_payment a rdf:Property ;
    rdfs:label "motivated payment"@en ;
    rdfs:domain onto:Voyage ;
    rdfs:range onto:Crew_Payment ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P17i_motivated> ;
    owl:inverseOf onto:for_voyage .

onto:name_with_ownership a rdf:Property ;
    rdfs:label "name with ownership"@en ;
    rdfs:domain onto:Ship_Name ;
    rdfs:range onto:Ship_Ownership_Phase ;
    owl:inverseOf onto:ownership_under_name .

onto:named_with a rdf:Property ;
    rdfs:label "named with"@en ;
    rdfs:domain onto:Ship_Name ;
    rdfs:range onto:Ship_Construction ;
    owl:inverseOf onto:under_name .

onto:navigated a rdf:Property ;
    rdfs:label "navigated"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:range onto:Voyage ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14i_performed> ;
    owl:inverseOf onto:navigated_by_captain .

onto:navigated_by_captain a rdf:Property ;
    rdfs:label "navigated by captain"@en ;
    rdfs:comment "This property describes the participation of an E39 Actor as being responsible for the navigation of the voyage. The captain may change from voyage to voyage. The concept of the captain is normally synonym to the concept of ruling, of the power of governing, so in that sense should be mapped to the E74 Group. But, in the context of the SeaLiT project, there is the requirement for a simpler structure with more details on the biographic data of a captain, so the decision is to model the captain as a role by person (not by group)."@en ;
    rdfs:domain onto:Voyage ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by> ;
    owl:inverseOf onto:navigated .

onto:ownership_is_initialized_by a rdf:Property ;
    rdfs:label "ownership is initialized by"@en ;
    rdfs:comment "This property associates the beginning of an instance of Ship Ownership Phase with the Ship Registration that initiates it."@en ;
    rdfs:domain onto:Ship_Ownership_Phase ;
    rdfs:range onto:Ship_Registration ;
    rdfs:subPropertyOf onto:is_initialized_by ;
    owl:inverseOf onto:initializes_ownership .

onto:ownership_is_terminated_by a rdf:Property ;
    rdfs:label "ownership is terminated by"@en ;
    rdfs:comment "This property associates the end of existence of an instance of Ship Ownership Phase with a De-flagging event that terminates it."@en ;
    rdfs:domain onto:Ship_Ownership_Phase ;
    rdfs:range onto:De-flagging ;
    rdfs:subPropertyOf onto:is_terminated_by ;
    owl:inverseOf onto:terminates_ownership .

onto:ownership_under_name a rdf:Property ;
    rdfs:label "ownership under name"@en ;
    rdfs:comment "This property identifies the change of ship name because of an ownership phase. It can be used to provide previous/old names of a ship."@en ;
    rdfs:domain onto:Ship_Ownership_Phase ;
    rdfs:range onto:Ship_Name ;
    owl:inverseOf onto:name_with_ownership .

onto:participates_with_share a rdf:Property ;
    rdfs:label "participates with share"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E39_Actor> ;
    rdfs:range onto:Shareholding ;
    rdfs:subPropertyOf onto:is_owner_of_phase ;
    owl:inverseOf onto:has_shareholder .

onto:passing_is_part_of a rdf:Property ;
    rdfs:label "passing is part of"@en ;
    rdfs:domain onto:Passing ;
    rdfs:range onto:Voyage ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P9i_forms_part_of> ;
    owl:inverseOf onto:consists_of_passing .

onto:person_is_registered_by a rdf:Property ;
