    owl:inverseOf onto:registered_by .

onto:is_sex_type_of a rdf:Property ;
    rdfs:label "is sex type of"@en ;
    rdfs:domain onto:Sex_Type ;
    rdfs:range <http://www.cidoc-crm.org/cidoc-crm/E21_Person> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
    owl:inverseOf onto:has_sex_type .

onto:is_shareholding_phase_of a rdf:Property ;
