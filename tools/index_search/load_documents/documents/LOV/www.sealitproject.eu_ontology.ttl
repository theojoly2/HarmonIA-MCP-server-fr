    rdfs:range onto:Voyage ;
    owl:inverseOf onto:starting_from .

onto:is_subject_of a rdf:Property ;
    rdfs:label "is subject of"@en ;
    rdfs:domain onto:Subject ;
    rdfs:range onto:Teaching_Unit ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
    owl:inverseOf onto:has_subject .

onto:is_time_of a rdf:Property ;
    rdfs:label "is time of"@en ;
    rdfs:domain <http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span> ;
    rdfs:range onto:Legal_Object_Relationship ;
    owl:inverseOf onto:in_time .

onto:is_tonnage_of a rdf:Property ;
