@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://open-multinet.info/ontology/omn> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "omn"@en ;
    ns1:license <http://creativecommons.org/licenses/by/4.0/> ;
    dc:contributor <http://www.commit-nl.nl/people/morsey>,
        <https://staff.fnwi.uva.nl/p.grosso>,
        <https://www.linkedin.com/in/yahyaalhazmi>,
        <mailto:brecht.vermeulen@iminds.be>,
        <mailto:chrisap@noc.ntua.gr>,
        <mailto:ibaldin@renci.org>,
        <mailto:jorge.lopez_vergara@uam.es>,
        <mailto:loughnane@campus.tu-berlin.de>,
        <mailto:thijs.walcarius@intec.ugent.be>,
        <mailto:yxin@renci.org> ;
    dc:creator <http://alex.willner.ws/about#me> ;
    dc:description <http://raw.githubusercontent.com/open-multinet/playground-rspecs-ontology/master/ontologies/pics/omn.png>,
        "This ontology defines the most abstract concepts and properties that are needed to semantically manage resource within federated infrastructures."@en ;
    dc:publisher <http://open-multinet.org/> ;
    dc:rights <http://creativecommons.org/licenses/by/4.0/> ;
    dc:title "Open-Multinet Upper Ontology"@en ;
    dcterms:created "2014-11-11"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2015-04-04"^^xsd:date ;
    vann:preferredNamespacePrefix "omn"^^xsd:string ;
    vann:preferredNamespaceUri <http://open-multinet.info/ontology/omn#> ;
    rdfs:comment "This ontology defines the most abstract concepts and properties that are needed to semantically manage resource within federated infrastructures."@en ;
    owl:versionInfo "2015-04-04"^^xsd:string .

<http://open-multinet.info/ontology/omn#Topology> a owl:Class ;
    rdfs:label "Topology"@en ;
    rdfs:comment "A collection of omn:Resource, omn:Service or omn:Group"@en,
        "Examples: Infrastructure, Reservation, Slice, ..."@en ;
    rdfs:subClassOf <http://open-multinet.info/ontology/omn#Group> .

<http://open-multinet.info/ontology/omn#dependsOn> a owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    rdfs:comment "claims dependency"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:subPropertyOf <http://open-multinet.info/ontology/omn#relatesTo> .

<http://open-multinet.info/ontology/omn#fromDependency> a owl:ObjectProperty ;
    rdfs:label "from dependency"@en ;
    rdfs:comment "claims dependency"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Dependency> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#toDependency> .

<http://open-multinet.info/ontology/omn#hasEndpoint> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has endpoint"@en ;
    rdfs:comment "The URL of the API of a service"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Service> ;
    rdfs:range xsd:anyURI .

<http://open-multinet.info/ontology/omn#hasGroup> a owl:ObjectProperty ;
    rdfs:label "has group"@en ;
    rdfs:comment "a group that is related to this resource - e.g. a reserved topology within an infrastructure"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Group> ;
    rdfs:range <http://open-multinet.info/ontology/omn#Group> ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#isGroupOf> .

<http://open-multinet.info/ontology/omn#hasResource> a owl:ObjectProperty ;
    rdfs:label "has resource"@en ;
    rdfs:comment "a resource that this resource contains - e.g. a node within a reserved topology"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Group> ;
    rdfs:range <http://open-multinet.info/ontology/omn#Resource> ;
    rdfs:seeAlso <http://fp7-novi.eu/im.owl#contains> ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#isResourceOf> .

<http://open-multinet.info/ontology/omn#isReadonly> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "is read only"@en ;
    rdfs:comment "information/attribute that is not writable"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Attribute> ;
    rdfs:range xsd:boolean .

<http://open-multinet.info/ontology/omn#isReservationOf> a owl:ObjectProperty ;
    rdfs:label "is reservation of"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Reservation> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#hasReservation> .

<http://open-multinet.info/ontology/omn#isServiceOf> a owl:ObjectProperty ;
    rdfs:label "is service of"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Service> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:seeAlso <http://purl.org/ontology/service#providedBy> ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#hasService> .

<http://open-multinet.info/ontology/omn#withinEnvironment> a owl:ObjectProperty ;
    rdfs:label "within environment"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range <http://open-multinet.info/ontology/omn#Environment> .

owl:NamedIndividual a owl:Class .

<http://alex.willner.ws/about#me> a foaf:Person .

<http://open-multinet.info/ontology/omn#adaptableFrom> a owl:ObjectProperty ;
    rdfs:label "adaptable from"@en ;
    rdfs:comment "determines the resource from which this resource can be adapted from - e.g. from an Ethernet to a FDDI port."@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Layer> ;
    rdfs:range <http://open-multinet.info/ontology/omn#Layer> ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#adaptableTo> .

<http://open-multinet.info/ontology/omn#adaptableTo> a owl:ObjectProperty ;
    rdfs:label "adaptable to"@en ;
    rdfs:comment "determines to which resource this resource can adapts to - e.g. from an Ethernet to a FDDI port."@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Layer> ;
    rdfs:range <http://open-multinet.info/ontology/omn#Layer> ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#adaptableFrom> .

<http://open-multinet.info/ontology/omn#adaptsFrom> a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "adapts from"@en ;
    rdfs:comment "determines from which resource this resource adapts - e.g. from an Ethernet to a FDDI port."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#adaptsTo> .

<http://open-multinet.info/ontology/omn#adaptsTo> a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "adapts to"@en ;
    rdfs:comment "determines to which resource this resource adapts - e.g. from an Ethernet to a FDDI port."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#adaptsFrom> .

<http://open-multinet.info/ontology/omn#hasAttribute> a owl:ObjectProperty ;
    rdfs:label "has attribute"@en ;
    rdfs:comment "link to a general attribute of the resource - e.g. to a ReadOnly class"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range <http://open-multinet.info/ontology/omn#Attribute> ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#isAttributeOf> .

<http://open-multinet.info/ontology/omn#hasComponent> a owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    rdfs:comment "component of the resource - e.g. a CPU"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range <http://open-multinet.info/ontology/omn#Component> ;
    rdfs:seeAlso <http://fp7-novi.eu/im.owl#hasComponent> ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#isComponentOf> .

<http://open-multinet.info/ontology/omn#hasReservation> a owl:ObjectProperty ;
    rdfs:label "has reservation"@en ;
    rdfs:comment "the reservation details of a resource - e.g. an immediate reservation for 3 hours"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range <http://open-multinet.info/ontology/omn#Reservation> .

<http://open-multinet.info/ontology/omn#hasService> a owl:ObjectProperty ;
    rdfs:label "has service"@en ;
    rdfs:comment "a service that this resource contains - e.g. a Hadoop instance within a reserved topology"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range <http://open-multinet.info/ontology/omn#Service> .

<http://open-multinet.info/ontology/omn#isAttributeOf> a owl:ObjectProperty ;
    rdfs:label "is attribute of"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Attribute> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#hasAttribute> .

<http://open-multinet.info/ontology/omn#isComponentOf> a owl:ObjectProperty ;
    rdfs:label "is component of"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Component> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    owl:inverseOf <http://open-multinet.info/ontology/omn#hasComponent> .

<http://open-multinet.info/ontology/omn#isGroupOf> a owl:ObjectProperty ;
    rdfs:label "is group of"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Group> ;
    rdfs:range <http://open-multinet.info/ontology/omn#Group> .

<http://open-multinet.info/ontology/omn#isResourceOf> a owl:ObjectProperty ;
    rdfs:label "is resource of"@en ;
    rdfs:domain <http://open-multinet.info/ontology/omn#Resource> ;
    rdfs:range <http://open-multinet.info/ontology/omn#Group> ;
    rdfs:seeAlso <http://fp7-novi.eu/im.owl#contains> .

<http://open-multinet.info/ontology/omn#relatesTo> a owl:ObjectProperty ;
    rdfs:label "relates to"@en ;
    rdfs:comment "claims a general dependency"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] .

<http://open-multinet.info/ontology/omn#toDependency> a owl:ObjectProperty ;
    rdfs:label "to dependency"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) ] ;
    rdfs:range <http://open-multinet.info/ontology/omn#Dependency> .

owl:AllDisjointClasses a owl:Class .

time:Interval rdfs:subClassOf <http://open-multinet.info/ontology/omn#Reservation> .

<http://open-multinet.info/ontology/omn#Environment> a owl:Class ;
    rdfs:label "Environment"@en ;
    rdfs:comment "Examples: interference, concurrent virtual machines, concurrent traffic, temperature, heat, ..."@en,
        "The operating conditions under which a omn:Resource, omn:Group, omn:Service is operating."@en ;
    rdfs:seeAlso <http://schema.org/Place> .

owl:IrreflexiveProperty a owl:Class .

<http://open-multinet.info/ontology/omn#Dependency> a owl:Class ;
    rdfs:label "Dependency"@en ;
    rdfs:comment "Examples: application coloring (in GENI context), orchestration needs dependencies"@en,
        "Helps to defines a directional relationship between omn:Resource, omn:Group, omn:Component or omn:Service. It makes it possible to annotate the dependencies with additional properties."@en ;
    rdfs:seeAlso <http://fp7-novi.eu/im.owl#implements>,
        <http://geni-orca.renci.org/owl/app-color.owl#ColorAttribute>,
        <http://www.science.uva.nl/research/sne/indl#implements> .

<http://open-multinet.info/ontology/omn#Reservation> a owl:Class ;
    rdfs:label "Reservation"@en ;
    rdfs:comment "A specification of a guarantee"@en,
        "Examples: (Earliest) Start and (lates) end time, data volume, ..."@en ;
    rdfs:seeAlso time:Interval .

<http://open-multinet.info/ontology/omn#Attribute> a owl:Class ;
    rdfs:label "Attribute"@en ;
    rdfs:comment "Describes the attributes of an omn:Group, omn:Resource, omn:Service or omn:Component in more detail"@en,
        "Examples: Monitoring information, Color attributes, Reservation information, QoS, SLAs, Location, Configuration, ..."@en ;
    rdfs:seeAlso <http://geni-orca.renci.org/owl/app-color.owl#ColorAttribute>,
        <http://schemas.ogf.org/nml/2013/05/base#Location> .

<http://open-multinet.info/ontology/omn#Layer> a owl:Class ;
    rdfs:label "Layer"@en ;
    rdfs:comment "Describes a place within a hierarchy a specific omn:Group, omn:Resource, omn:Service or omn:Component can adapt to."@en,
        "Examples: In networking, an end-to-end connectivity has to be on the same layer (path finding). For resources, it can describe the capability to adapt to a virtualized version"@en ;
    rdfs:seeAlso <http://schemas.ogf.org/nml/2013/05/base#AdaptationService>,
        <http://www.science.uva.nl/research/sne/indl#VirtualNode> .

<http://open-multinet.info/ontology/omn#Component> a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "An Entity that is part of an omn:Resource or omn:Service. It does not need to be an omn:Resource or an omn:Service itself."@en,
        "Examples: CPU, Sensor, Core, Port, Image"@en ;
    rdfs:seeAlso dcterms:isPartOf,
        <http://schema.org/partOfSystem>,
        <http://www.ontologydesignpatterns.org/cp/owl/move.owl#formsPartOf> .

<http://open-multinet.info/ontology/omn#Resource> a owl:Class ;
    rdfs:label "Resource"@en ;
    rdfs:comment "An Entity that can be provisioned/controlled/measured by APIs"@en,
        "Examples: Node, Link, People, ..."@en ;
    rdfs:seeAlso <http://fp7-novi.eu/im.owl#Node>,
        <http://schemas.ogf.org/nml/2013/05/base#Node> .

<http://open-multinet.info/ontology/omn#Service> a owl:Class ;
    rdfs:label "Service"@en ;
    rdfs:comment "An Entity that has an API/capability to use it, it may depend on an omn:Resource"@en,
        "Examples: Aggregate Manager, Portal, Measurement Service, Hadoop, Broker, ..."@en ;
    rdfs:seeAlso <http://fp7-novi.eu/im.owl#Service>,
        dcmitype:Service,
        <http://purl.org/goodrelations/v1#ProductOrService>,
        <http://purl.org/ontology/service#Service>,
        <http://schema.org/Service>,
        <http://schemas.ogf.org/nml/2013/05/base#Service> .

<http://open-multinet.info/ontology/omn#Group> a owl:Class ;
    rdfs:label "Group"@en ;
    rdfs:comment "A collection of omn:Resource, omn:Service or omn:Group"@en,
        "Examples: Bi-directional Link, ..."@en ;
    rdfs:seeAlso <http://fp7-novi.eu/im.owl#Group>,
        <http://geni-orca.renci.org/owl/collections.owl#Collection>,
        <http://schemas.ogf.org/nml/2013/05/base#Group> .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://open-multinet.info/ontology/omn#Attribute> <http://open-multinet.info/ontology/omn#Component> <http://open-multinet.info/ontology/omn#Dependency> <http://open-multinet.info/ontology/omn#Environment> <http://open-multinet.info/ontology/omn#Group> <http://open-multinet.info/ontology/omn#Layer> <http://open-multinet.info/ontology/omn#Resource> <http://open-multinet.info/ontology/omn#Service> ) .

