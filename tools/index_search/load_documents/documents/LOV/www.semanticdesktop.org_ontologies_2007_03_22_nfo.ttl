@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.semanticdesktop.org/ontologies/2007/08/15/nrl#> .
@prefix ns2: <http://www.semanticdesktop.org/ontologies/2007/08/15/nao#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Application> a rdfs:Class ;
    rdfs:label "Application" ;
    rdfs:comment "An application" ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Software> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Archive> a rdfs:Class ;
    rdfs:label "Archive" ;
    rdfs:comment "A compressed file. May contain other files or folder inside. " ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#DataContainer> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#ArchiveItem> a rdfs:Class ;
    rdfs:label "ArchiveItem" ;
    rdfs:comment "A file entity inside an archive." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#EmbeddedFileDataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Attachment> a rdfs:Class ;
    rdfs:label "Attachment" ;
    rdfs:comment "A file attached to another data object. Many data formats allow for attachments: emails, vcards, ical events, id3 and exif..." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#EmbeddedFileDataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Audio> a rdfs:Class ;
    rdfs:label "Audio" ;
    rdfs:comment "A file containing audio content" ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Bookmark> a rdfs:Class ;
    rdfs:label "Bookmark" ;
    rdfs:comment "A bookmark of a webbrowser. Use nie:title for the name/label, nie:contentCreated to represent the date when the user added the bookmark, and nie:contentLastModified for modifications. nfo:bookmarks to store the link." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#BookmarkFolder> a rdfs:Class ;
    rdfs:label "Bookmark Folder" ;
    rdfs:comment "A folder with bookmarks of a webbrowser. Use nfo:containsBookmark to relate Bookmarks. Folders can contain subfolders, use containsBookmarkFolder to relate them." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#CompressionType> a rdfs:Class ;
    rdfs:label "CompressionType" ;
    rdfs:comment "Type of compression. Instances of this class represent the limited set of values allowed for the nfo:compressionType property." ;
    rdfs:subClassOf rdfs:Resource .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Cursor> a rdfs:Class ;
    rdfs:label "Cursor" ;
    rdfs:comment "A Cursor." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#RasterImage> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#DataContainer> a rdfs:Class ;
    rdfs:label "DataContainer" ;
    rdfs:comment "A superclass for all entities, whose primary purpose is to serve as containers for other data object. They usually don't have any \"meaning\" by themselves. Examples include folders, archives and optical disc images." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#DeletedResource> a rdfs:Class ;
    rdfs:label "DeletedResource" ;
    rdfs:comment "A file entity that has been deleted from the original source. Usually such entities are stored within various kinds of 'Trash' or 'Recycle Bin' folders." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Document> a rdfs:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A generic document. A common superclass for all documents on the desktop." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#EmbeddedFileDataObject> a rdfs:Class ;
    rdfs:label "EmbeddedFileDataObject" ;
    rdfs:comment "A file embedded in another data object. There are many ways in which a file may be embedded in another one. Use this class directly only in cases if none of the subclasses gives a better description of your case." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#EncryptionStatus> a rdfs:Class ;
    rdfs:label "EncryptionStatus" ;
    rdfs:comment "The status of the encryption of an InformationElement. nfo:encryptedStatus means that the InformationElement has been encrypted and couldn't be decrypted by the extraction software, thus no content is available. nfo:decryptedStatus means that decryption was successfull and the content is available." .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Executable> a rdfs:Class ;
    rdfs:label "Executable" ;
    rdfs:comment "An executable file." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> a rdfs:Class ;
    rdfs:label "file" ;
    rdfs:comment "A resource containing a finite sequence of bytes with arbitrary information, that is available to a computer program and is usually based on some kind of durable storage. A file is durable in the sense that it remains available for programs to use after the current program has finished." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileHash> a rdfs:Class ;
    rdfs:label "FileHash" ;
    rdfs:comment "A fingerprint of the file, generated by some hashing function." ;
    rdfs:subClassOf rdfs:Resource .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Filesystem> a rdfs:Class ;
    rdfs:label "Filesystem" ;
    rdfs:comment "A filesystem. Examples of filesystems include hard disk partitions, removable media, but also images thereof stored in files such as ISO." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#DataContainer> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FilesystemImage> a rdfs:Class ;
    rdfs:label "FilesystemImage" ;
    ns2:deprecated true ;
    rdfs:comment "An image of a filesystem. Instances of this class may include CD images, DVD images or hard disk partition images created by various pieces of software (e.g. Norton Ghost). Deprecated in favor of nfo:Filesystem." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Filesystem> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Folder> a rdfs:Class ;
    rdfs:label "Folder" ;
    rdfs:comment "A folder/directory. Examples of folders include folders on a filesystem and message folders in a mailbox." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#DataContainer> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Font> a rdfs:Class ;
    rdfs:label "Font" ;
    rdfs:comment "A font." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#HardDiskPartition> a rdfs:Class ;
    rdfs:label "HardDiskPartition" ;
    rdfs:comment "A partition on a hard disk" ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#HtmlDocument> a rdfs:Class ;
    rdfs:label "HtmlDocument" ;
    rdfs:comment "A HTML document, may contain links to other files." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#PlainTextDocument> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Icon> a rdfs:Class ;
    rdfs:label "Icon" ;
    rdfs:comment "An Icon (regardless of whether it's a raster or a vector icon. A resource representing an icon could have two types (Icon and Raster, or Icon and Vector) if required." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Image> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Image> a rdfs:Class ;
    rdfs:label "Image" ;
    rdfs:comment "A file containing an image." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Visual> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#LocalFileDataObject> a rdfs:Class ;
    rdfs:label "local file" ;
    rdfs:comment "A local file data object which is stored on a local file system. Its nie:url always uses the file:/ protocol. The main use of this class is to distinguish local and non-local files." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> a rdfs:Class ;
    rdfs:label "Media" ;
    rdfs:comment "A piece of media content. This class may be used to express complex media containers with many streams of various media content (both aural and visual)." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#MediaFileListEntry> a rdfs:Class ;
    rdfs:label "MediaFileListEntry" ;
    rdfs:comment "A single node in the list of media files contained within an MediaList instance. This class is intended to provide a type all those links have. In valid NRL untyped resources cannot be linked. There are no properties defined for this class but the application may expect rdf:first and rdf:last links. The former points to the DataObject instance, interpreted as Media the latter points at another MediaFileListEntr. At the end of the list there is a link to rdf:nil." ;
    rdfs:subClassOf rdfs:Resource .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#MediaList> a rdfs:Class ;
    rdfs:label "MediaList" ;
    rdfs:comment "A file containing a list of media files.e.g. a playlist" ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#MediaStream> a rdfs:Class ;
    rdfs:label "MediaStream" ;
    rdfs:comment "A stream of multimedia content, usually contained within a media container such as a movie (containing both audio and video) or a DVD (possibly containing many streams of audio and video). Most common interpretations for such a DataObject include Audio and Video." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#MindMap> a rdfs:Class ;
    rdfs:label "MindMap" ;
    rdfs:comment "A MindMap, created by a mind-mapping utility. Examples might include FreeMind or mind mapper." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Document> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#OperatingSystem> a rdfs:Class ;
    rdfs:label "OperatingSystem" ;
    rdfs:comment "An OperatingSystem" ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Software> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#PaginatedTextDocument> a rdfs:Class ;
    rdfs:label "PaginatedTextDocument" ;
    rdfs:comment "A file containing a text document, that is unambiguously divided into pages. Examples might include PDF, DOC, PS, DVI etc." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#TextDocument> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Placemark> a rdfs:Class ;
    rdfs:label "Placemark" ;
    rdfs:comment "One placemark within a placemark container/file. Use nie:title for the name/label, nao:creator for defining the creator." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#PlacemarkContainer> a rdfs:Class ;
    rdfs:label "Placemark Container" ;
    rdfs:comment "A data object containing placemark(s). Use nie:contentCreated to represent the date when the user created the dataobject, nao:creator for defining the creator, nie:contentLastModified for modifications. nfo:containsPlacemark to refer to individual placemarks within." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#PlainTextDocument> a rdfs:Class ;
    rdfs:label "PlainTextDocument" ;
    rdfs:comment "A file containing plain text (ASCII, Unicode or other encodings). Examples may include TXT, HTML, XML, program source code etc." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#TextDocument> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Presentation> a rdfs:Class ;
    rdfs:label "Presentation" ;
    rdfs:comment "A Presentation made by some presentation software (Corel Presentations, OpenOffice Impress, MS Powerpoint etc.)" ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Document> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#RasterImage> a rdfs:Class ;
    rdfs:label "RasterImage" ;
    rdfs:comment "A raster image." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Image> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#RemoteDataObject> a rdfs:Class ;
    rdfs:label "RemoteDataObject" ;
    rdfs:comment "A file data object stored at a remote location. Don't confuse this class with a RemotePortAddress. This one applies to a particular resource, RemotePortAddress applies to an address, that can have various interpretations." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#RemotePortAddress> a rdfs:Class ;
    rdfs:label "RemotePortAddress" ;
    rdfs:comment "An address specifying a remote host and port. Such an address can be interpreted in many ways (examples of such interpretations include mailboxes, websites, remote calendars or filesystems), depending on an interpretation, various kinds of data may be extracted from such an address." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Software> a rdfs:Class ;
    rdfs:label "Software" ;
    rdfs:comment "A piece of software. Examples may include applications and the operating system. This interpretation most commonly applies to SoftwareItems." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement>,
        ns2:Agent .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#SoftwareItem> a rdfs:Class ;
    rdfs:label "SoftwareItem" ;
    rdfs:comment "A DataObject representing a piece of software. Examples of interpretations of a SoftwareItem include an Application and an OperatingSystem." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#SoftwareService> a rdfs:Class ;
    rdfs:label "SoftwareService" ;
    rdfs:comment "A service published by a piece of software, either by an operating system or an application. Examples of such services may include calendar, addressbook and mailbox managed by a PIM application. This category is introduced to distinguish between data available directly from the applications (Via some Interprocess Communication Mechanisms) and data available from files on a disk. In either case both DataObjects would receive a similar interpretation (e.g. a Mailbox) and wouldn't differ on the content level." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#SourceCode> a rdfs:Class ;
    rdfs:label "SourceCode" ;
    rdfs:comment "Code in a compilable or interpreted programming language." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#PlainTextDocument> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Spreadsheet> a rdfs:Class ;
    rdfs:label "Spreadsheet" ;
    rdfs:comment "A spreadsheet, created by a spreadsheet application. Examples might include Gnumeric, OpenOffice Calc or MS Excel." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Document> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#TextDocument> a rdfs:Class ;
    rdfs:label "TextDocument" ;
    rdfs:comment "A text document" ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Document> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Trash> a rdfs:Class ;
    rdfs:label "Trash" ;
    rdfs:comment "Represents a container for deleted files, a feature common in modern operating systems." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#DataContainer> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#VectorImage> a rdfs:Class ;
    rdfs:label "VectorImage" ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Image> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Video> a rdfs:Class ;
    rdfs:label "Video" ;
    rdfs:comment "A video file." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Visual> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Visual> a rdfs:Class ;
    rdfs:label "Visual" ;
    rdfs:comment "File containing visual content." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#WebDataObject> a rdfs:Class ;
    rdfs:label "web data object" ;
    rdfs:comment "An information resources of which representations (files, streams) can be retrieved through a web server. They may be generated at retrieval time. Typical examples are pages served by PHP or AJAX or mp3 streams." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Website> a rdfs:Class ;
    rdfs:label "Website" ;
    rdfs:comment "A website, usually a container for remote resources, that may be interpreted as HTMLDocuments, images or other types of content." ;
    rdfs:subClassOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#aspectRatio> a rdf:Property ;
    rdfs:label "aspectRatio" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Visual content aspect ratio. (Width divided by Height)" ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Visual> ;
    rdfs:range xsd:float .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#averageBitrate> a rdf:Property ;
    rdfs:label "averageBitrate" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The average overall bitrate of a media container. (i.e. the size of the piece of media in bits, divided by it's duration expressed in seconds)." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#rate> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#belongsToContainer> a rdf:Property ;
    rdfs:label "belongsToContainer" ;
    rdfs:comment "Models the containment relations between Files and Folders (or CompressedFiles)." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#DataContainer> ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#isPartOf> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#bitrateType> a rdf:Property ;
    rdfs:label "bitrateType" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The type of the bitrate. Examples may include CBR and VBR." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#bitsPerSample> a rdf:Property ;
    rdfs:label "bitsPerSample" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Amount of bits in each audio sample." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Audio> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#bitDepth> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#bookmarks> a rdf:Property ;
    rdfs:label "link" ;
    ns1:cardinality 1 ;
    rdfs:comment "The address of the linked object. Usually a web URI." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Bookmark> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#links> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#characterCount> a rdf:Property ;
    rdfs:label "characterCount" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The amount of characters in the document." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#TextDocument> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#characterPosition> a rdf:Property ;
    rdfs:label "characterPosition" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Character position of the bookmark." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Bookmark> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#codec> a rdf:Property ;
    rdfs:label "codec" ;
    rdfs:comment "The name of the codec necessary to decode a piece of media." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> ;
    rdfs:range rdfs:Literal .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#colorCount> a rdf:Property ;
    rdfs:label "color count" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The number of colors used/available in a raster image." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#RasterImage> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#colorDepth> a rdf:Property ;
    rdfs:label "colorDepth" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Amount of bits used to express the color of each pixel." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Visual> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#bitDepth> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#commentCharacterCount> a rdf:Property ;
    rdfs:label "commentCharacterCount" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The amount of character in comments i.e. characters ignored by the compiler/interpreter." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#SourceCode> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#compressionType> a rdf:Property ;
    rdfs:label "compressionType" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The type of the compression. Values include, 'lossy' and 'lossless'." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#CompressionType> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#conflicts> a rdf:Property ;
    rdfs:label "conflicts" ;
    rdfs:comment "States that a piece of software is in conflict with another piece of software." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Software> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Software> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#containsBookmark> a rdf:Property ;
    rdfs:label "contains bookmark" ;
    rdfs:comment "The folder contains a bookmark." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#BookmarkFolder> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Bookmark> ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#hasLogicalPart> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#containsBookmarkFolder> a rdf:Property ;
    rdfs:label "contains folder" ;
    rdfs:comment "The folder contains a bookmark folder." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#BookmarkFolder> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#BookmarkFolder> ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#hasLogicalPart> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#containsPlacemark> a rdf:Property ;
    rdfs:label "contains Placemark" ;
    rdfs:comment "Containment relation between placemark containers (files) and placemarks within." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#PlacemarkContainer> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Placemark> ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#hasLogicalPart> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#decryptedStatus> a <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#EncryptionStatus> ;
    rdfs:label "DecryptedStatus" .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#definesClass> a rdf:Property ;
    rdfs:label "definesClass" ;
    rdfs:comment "Name of a class defined in the source code file." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#SourceCode> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#definesFunction> a rdf:Property ;
    rdfs:label "definesFunction" ;
    rdfs:comment "A name of a function/method defined in the given source code file." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#SourceCode> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#definesGlobalVariable> a rdf:Property ;
    rdfs:label "definesGlobalVariable" ;
    rdfs:comment "Name of a global variable defined within the source code file." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#SourceCode> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#deletionDate> a rdf:Property ;
    rdfs:label "deletionDate" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The date and time of the deletion." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#DeletedResource> ;
    rdfs:range xsd:dateTime .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#duration> a rdf:Property ;
    rdfs:label "duration" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Duration of a media piece." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> ;
    rdfs:range xsd:duration .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#encoding> a rdf:Property ;
    rdfs:label "encoding" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The encoding used for the Embedded File. Examples might include BASE64 or UUEncode" ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#EmbeddedFileDataObject> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#encryptedStatus> a <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#EncryptionStatus> ;
    rdfs:label "EncryptedStatus" .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#encryptionStatus> a rdf:Property ;
    rdfs:label "encryptionStatus" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The status of the encryption of the InformationElement." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#InformationElement> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#EncryptionStatus> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#fileCreated> a rdf:Property ;
    rdfs:label "fileCreated" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "File creation date" ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#created> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#fileLastAccessed> a rdf:Property ;
    rdfs:label "fileLastAccessed" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Time when the file was last accessed." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dc:date .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#fileLastModified> a rdf:Property ;
    rdfs:label "fileLastModified" ;
    ns2:deprecated true ;
    rdfs:comment "last modification date" ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#lastModified> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#fileName> a rdf:Property ;
    rdfs:label "fileName" ;
    ns1:maxCardinality "1" ;
    rdfs:comment "Name of the file, together with the extension" ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns2:prefLabel .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#fileOwner> a rdf:Property ;
    rdfs:label "fileOwner" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The owner of the file as defined by the file system access rights feature." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nco#Contact> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#fileSize> a rdf:Property ;
    rdfs:label "fileSize" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The size of the file in bytes. For compressed files it means the size of the packed file, not of the contents. For folders it means the aggregated size of all contained files and folders " ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#byteSize> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#fileUrl> a rdf:Property ;
    rdfs:label "fileUrl" ;
    ns2:deprecated true ;
    rdfs:comment "URL of the file. It points at the location of the file. In cases where creating a simple file:// or http:// URL for a file is difficult (e.g. for files inside compressed archives) the applications are encouraged to use conventions defined by Apache Commons VFS Project at http://jakarta.apache.org/  commons/ vfs/ filesystems.html." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#url> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#filesystemType> a rdf:Property ;
    rdfs:label "filesystemType" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Type of filesystem such as ext3 and ntfs." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Filesystem> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#fontFamily> a rdf:Property ;
    rdfs:label "fontFamily" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The name of the font family." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Font> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#foundry> a rdf:Property ;
    rdfs:label "foundry" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The foundry, the organization that created the font." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Font> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nco#Contact> ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nco#creator> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#frameCount> a rdf:Property ;
    rdfs:label "frameCount" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The amount of frames in a video sequence." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Video> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#count> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#frameRate> a rdf:Property ;
    rdfs:label "frameRate" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Amount of video frames per second." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Video> ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#rate> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#freeSpace> a rdf:Property ;
    rdfs:label "freeSpace" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Unoccupied storage space of the filesystem." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Filesystem> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#frontChannels> a rdf:Property ;
    rdfs:label "frontChannels" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Number of front channels." ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#channels> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#hasHash> a ns1:DefiningProperty,
        rdf:Property ;
    rdfs:label "hasHash" ;
    ns2:userVisible false ;
    rdfs:comment "Links the file with it's hash value." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileHash> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#hasMediaFileListEntry> a rdf:Property ;
    rdfs:label "hasMediaFileListEntry" ;
    rdfs:comment "This property is intended to point to an RDF list of MediaFiles." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#MediaList> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#MediaFileListEntry> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#hasMediaStream> a rdf:Property ;
    rdfs:label "hasMediaStream" ;
    rdfs:comment "Connects a media container with a single media stream contained within." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#DataObject> ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#hasPart> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#hashAlgorithm> a rdf:Property ;
    rdfs:label "hashAlgorithm" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Name of the algorithm used to compute the hash value. Examples might include CRC32, MD5, SHA, TTH etc." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileHash> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#hashValue> a rdf:Property ;
    rdfs:label "hashValue" ;
    ns1:cardinality 1 ;
    rdfs:comment "The actual value of the hash." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileHash> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#height> a rdf:Property ;
    rdfs:label "height" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Visual content height in pixels." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Visual> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#horizontalResolution> a rdf:Property ;
    rdfs:label "horizontalResolution" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Horizontal resolution of an image (if printed). Expressed in DPI." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Image> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#interlaceMode> a rdf:Property ;
    rdfs:label "interlaceMode" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "True if the image is interlaced, false if not." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Visual> ;
    rdfs:range xsd:boolean .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#isPasswordProtected> a rdf:Property ;
    rdfs:label "isPasswordProtected" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "States if a given resource is password-protected." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#ArchiveItem> ;
    rdfs:range xsd:boolean .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#lfeChannels> a rdf:Property ;
    rdfs:label "lfeChannels" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Number of Low Frequency Expansion (subwoofer) channels." ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#channels> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#lineCount> a rdf:Property ;
    rdfs:label "lineCount" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The amount of lines in a text document" ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#TextDocument> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#losslessCompressionType> a <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#CompressionType> ;
    rdfs:label "losslessCompressionType" .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#lossyCompressionType> a <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#CompressionType> ;
    rdfs:label "lossyCompressionType" .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#occupiedSpace> a rdf:Property ;
    rdfs:label "occupiedSpace" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Occupied storage space of the filesystem." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Filesystem> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#originalLocation> a rdf:Property ;
    rdfs:label "originalLocation" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The original location of the deleted resource." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#DeletedResource> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#pageCount> a rdf:Property ;
    rdfs:label "pageCount" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Number of pages." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#PaginatedTextDocument> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#pageNumber> a rdf:Property ;
    rdfs:label "pageNumber" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Page linked by the bookmark." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Bookmark> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#paletteSize> a rdf:Property ;
    rdfs:label "palette size" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The number of colors defined in palette of the raster image." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#RasterImage> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#permissions> a rdf:Property ;
    rdfs:label "permissions" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "A string containing the permissions of a file. A feature common in many UNIX-like operating systems." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#FileDataObject> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#programmingLanguage> a rdf:Property ;
    rdfs:label "programmingLanguage" ;
    rdfs:comment "Indicates the name of the programming language this source code file is written in. Examples might include 'C', 'C++', 'Java' etc." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#SourceCode> ;
    rdfs:range xsd:string .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#rearChannels> a rdf:Property ;
    rdfs:label "rearChannels" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Number of rear channels." ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#channels> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#sampleCount> a rdf:Property ;
    rdfs:label "sampleCount" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The amount of samples in an audio clip." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Audio> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#count> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#sampleRate> a rdf:Property ;
    rdfs:label "sampleRate" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The amount of audio samples per second." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Audio> ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#rate> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#sideChannels> a rdf:Property ;
    rdfs:label "sideChannels" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Number of side channels" ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#channels> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#streamPosition> a rdf:Property ;
    rdfs:label "streamPosition" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Stream position of the bookmark, suitable for e.g. audio books. Expressed in milliseconds" ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Bookmark> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#supercedes> a rdf:Property ;
    rdfs:label "supercedes" ;
    rdfs:comment "States that a piece of software supercedes another piece of software." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Software> ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Software> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#totalSpace> a rdf:Property ;
    rdfs:label "totalSpace" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Total storage space of the filesystem, which can be different from nie:contentSize because the latter includes filesystem format overhead." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Filesystem> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#uncompressedSize> a rdf:Property ;
    rdfs:label "uncompressedSize" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Uncompressed size of the content of a compressed file." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Archive> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#uuid> a rdf:Property ;
    rdfs:label "uuid" ;
    rdfs:comment "Universally unique identifier of the filesystem. In the future, this property may have its parent changed to a more generic class." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Filesystem> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#identifier> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#verticalResolution> a rdf:Property ;
    rdfs:label "verticalResolution" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Vertical resolution of an Image (if printed). Expressed in DPI" ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Image> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#width> a rdf:Property ;
    rdfs:label "width" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Visual content width in pixels." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Visual> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#wordCount> a rdf:Property ;
    rdfs:label "wordCount" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "The amount of words in a text document." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#TextDocument> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#depiction> a rdf:Property ;
    rdfs:label "depiction" ;
    ns1:inverseProperty <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#depicts> ;
    rdfs:comment "Relates an information element to an image which depicts said element." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Image> .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#depicts> a rdf:Property ;
    rdfs:label "depicts" ;
    ns1:inverseProperty <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#depiction> ;
    rdfs:comment "Relates an image to the information elements it depicts." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Image> ;
    rdfs:range rdfs:Resource .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#bitDepth> a rdf:Property ;
    rdfs:label "bitDepth" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "A common superproperty for all properties signifying the amount of bits for an atomic unit of data. Examples of subproperties may include bitsPerSample and bitsPerPixel" ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> ;
    rdfs:range rdfs:Literal .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#count> a rdf:Property ;
    rdfs:label "count" ;
    rdfs:comment "A common superproperty for all properties signifying the amount of atomic media data units. Examples of subproperties may include sampleCount and frameCount." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> ;
    rdfs:range xsd:integer .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#rate> a rdf:Property ;
    rdfs:label "rate" ;
    rdfs:comment "A common superproperty for all properties specifying the media rate. Examples of subproperties may include frameRate for video and sampleRate for audio. This property is expressed in units per second." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Media> ;
    rdfs:range xsd:float .

<http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#channels> a rdf:Property ;
    rdfs:label "channels" ;
    ns1:maxCardinality 1 ;
    rdfs:comment "Number of channels. This property is to be used directly if no detailed information is necessary. Otherwise use more detailed subproperties." ;
    rdfs:domain <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#Audio> ;
    rdfs:range xsd:integer .

