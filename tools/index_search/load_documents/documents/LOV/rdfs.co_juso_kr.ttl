@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://www.w3.org/ns/adms#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix onto: <http://rdfs.co/juso/kr/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:0.1 a ns3:Work,
        <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology,
        ns2:SemanticAsset ;
    ns3:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <http://jayg.me/> ;
    dcterms:description "\\n    South Korea Extension to Juso Ontology is a Web vocabulary that extends\\n    <a href=\"http://rdfs.co/juso/\">Juso Ontology</a> to descrbe geographical\\n    addresses and features in South Korea.\\n    "@en ;
    dcterms:hasFormat <http://rdfs.co/juso/kr/0.1/html>,
        <http://rdfs.co/juso/kr/0.1/rdf>,
        <http://rdfs.co/juso/kr/0.1/ttl> ;
    dcterms:identifier "http://rdfs.co/juso/kr/0.1" ;
    dcterms:isVersionOf onto: ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-07"^^xsd:date ;
    dcterms:publisher <http://listinc.kr/id/listinc> ;
    dcterms:rights "Copyright © 2015 LiST Inc. Some Rights Reserved." ;
    dcterms:title "South Korea Extension to Juso Ontology"@en ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:example [ rdfs:comment "\\n    <pre><code>_:YangyongBldg a juso.kr:Building ;\\n  juso:name \"Yangyong Building\"@en , \"양용빌딩\"@ko ;\\n  juso:geometry &lt;http://geohash.org/wydjrzg6ece9&gt; ;\\n  juso.kr:administrative_building_number \"1156011700101210017028596\" .\\n\\n_:LiSTInc a juso:SpatialThing , foaf:Organization ;\\n  juso:name \"LiST Inc.\"@en , \"주식회사 리스트\"@ko ;\\n  juso:within _:YangyongBldg ;\\n  juso:historical_address [\\n    a juso.kr:EastAsianAddress ;\\n    juso:full_address\\n      \"대한민국 서울특별시 영등포구 당산동 121-17 양용빌딩 9층 150-040\"@ko ,\\n      \"9th Floor, Yangyong Building, 121-17, Dangsan-dong, Yeongdeungpo-gu, Seoul, 150-040, South Korea\"@en ;\\n    juso:country &lt;http://sws.geonames.org/1835841/&gt; ;\\n    juso.kr:si_do &lt;http://sws.geonames.org/1835847/&gt; ;\\n    juso.kr:si_gun_gu &lt;http://sws.geonames.org/1832536/&gt; ;\\n    juso.kr:eup_myeon_dong &lt;http://sws.geonames.org/8692617/&gt; ;\\n    juso.kr:beonji \"121\" ;\\n    juso.kr:ho \"17\" ;\\n    juso:locator _:YangyongBldg ;\\n    juso:locator_address \"9층\"@ko , \"9th Floor\"@en ;\\n    juso:postal_code [\\n      a juso.kr:PostalCode1988 ;\\n      rdf:value \"150-040\"\\n    ]\\n  ] ;\\n  juso:address [\\n    a juso.kr:RoadNameAddress ;\\n    juso:full_address\\n      \"대한민국 서울특별시 영등포구 버드나루로19길 3 (당산동) 양용빌딩 9층 07229\"@ko ,\\n      \"9th Floor, Yangyong Building, 3, Beodeunaru-ro 19-gil, Yeongdeungpo-gu, Seoul, 07229, South Korea\"@en ;\\n    juso:country &lt;http://sws.geonames.org/1835841/&gt; ;\\n    juso.kr:si_do &lt;http://sws.geonames.org/1835847/&gt; ;\\n    juso.kr:si_gun_gu &lt;http://sws.geonames.org/1832536/&gt; ;\\n    juso.kr:eup_myeon_dong &lt;http://sws.geonames.org/8692617/&gt; ;\\n    juso:thoroughfare [\\n      a juso.kr:Road ;\\n      juso:name \"Beodeunaru-ro 19-gil\"@en , \"버드나루로19길\"@ko ;\\n      juso:parent &lt;http://sws.geonames.org/8692617/&gt;\\n      juso.kr:road_name_number \"4154419\" ;\\n      juso.kr:parent_road [\\n        a juso.kr:Street ;\\n        juso:name \"Beodeunaru-ro\"@en , \"버드나루로\"@ko ;\\n        juso:parent &lt;http://sws.geonames.org/8692617/&gt;\\n        juso.kr:road_name_number \"3118010\" ;\\n      ]\\n    ] ;\\n    juso.kr:building_number \"3\" ;\\n    juso:locator _:YangyongBldg ;\\n    juso:locator_address \"9층\"@ko , \"9th Floor\"@en ;\\n    juso:postal_code [\\n      a juso.kr:PostalCode2015 ;\\n      rdf:value \"07229\"\\n    ] ;\\n    juso.kr:landform &lt;http://dbpedia.org/resource/Land_lot&gt; ;\\n    juso.kr:floor &lt;http://dbpedia.org/resource/Storey&gt; ;\\n    juso.kr:eup_myeon_dong_serial_number \"1\"\\n  ] .\\n\\n&lt;http://sws.geonames.org/1832536/&gt; a juso.kr:AutonomousDistrict ;\\n  juso.kr:si_gun_gu_code \"11560\" .\\n\\n&lt;http://sws.geonames.org/8692617/&gt; a juso.kr:LegalStatusNeighborhood ;\\n  juso.kr:legal_status_neighborhood_code \"1156011700\" ;\\n  juso.kr:eup_myeon_dong_code \"117\" .</code></pre>\\n    "^^rdf:HTML ] ;
    vann:preferredNamespacePrefix "juso.kr" ;
    vann:preferredNamespaceUri "http://rdfs.co/juso/kr/" ;
    vann:termGroup onto:AddressGroup,
        onto:AdministrativeDivisionGroup ;
    rdfs:comment "\\n    <div>\\n      The master version of this vocabulary is maintained in <a\\n      href=\"https://github.com/listinc/juso-ontology/tree/master/kr\">the GitHub\\n      repository</a> so others can contribute edits and improvements.\\n    </div>\\n    "^^rdf:HTML,
        "\\n    Most of the descriptions given here are from Wikipedia or from the related\\n    ontologies and vocabularies.\\n    "@en ;
    rdfs:seeAlso <https://github.com/listinc/juso-ontology/tree/master/kr> ;
    owl:versionInfo "0.1" ;
    skos:changeNote [ dcterms:creator <http://jayg.me/> ;
            dcterms:date "2015-10-07"^^xsd:date ;
            rdf:value "\\n      Fixed the wrong use of rdf:XMLLiteral\\n      "@en ] ;
    ns2:status <http://purl.org/adms/status/UnderDevelopment> .

<http://rdfs.co/juso/kr/0.1/html> dcterms:format [ a dcterms:MediaType ;
            rdfs:label "HTML"@en ;
            dcam:memberOf dcterms:IMT ;
            rdf:value "text/html" ;
            rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/html> ] .

<http://rdfs.co/juso/kr/0.1/rdf> dcterms:format [ a dcterms:MediaType ;
            rdfs:label "RDF/XML"@en ;
            dcam:memberOf dcterms:IMT ;
            rdf:value "application/rdf+xml" ;
            rdfs:seeAlso <http://www.iana.org/assignments/media-types/application/rdf+xml> ] .

<http://rdfs.co/juso/kr/0.1/ttl> dcterms:format [ a dcterms:MediaType ;
            rdfs:label "Turtle"@en ;
            dcam:memberOf dcterms:IMT ;
            rdf:value "text/turtle" ;
            rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/turtle> ] .

onto:AddressGroup a rdf:Bag ;
    rdfs:label "Address Terms"@en ;
    rdf:_1 onto:EastAsianAddress ;
    rdf:_10 onto:Street ;
    rdf:_11 onto:Road ;
    rdf:_12 onto:road_name_number ;
    rdf:_13 onto:parent_road ;
    rdf:_14 onto:Building ;
    rdf:_15 onto:administrative_building_number ;
    rdf:_16 onto:MultiFamilyResidentialBuilding ;
    rdf:_17 onto:PostalCode1970 ;
    rdf:_18 onto:PostalCode1988 ;
    rdf:_19 onto:PostalCode2015 ;
    rdf:_2 onto:RoadNameAddress ;
    rdf:_20 onto:landform ;
    rdf:_21 onto:floor ;
    rdf:_22 onto:building_number ;
    rdf:_23 onto:building_extra_number ;
    rdf:_24 onto:eup_myeon_dong_serial_number ;
    rdf:_3 onto:si_do ;
    rdf:_4 onto:si_gun_gu ;
    rdf:_5 onto:eup_myeon_dong ;
    rdf:_6 onto:ri ;
    rdf:_7 onto:beonji ;
    rdf:_8 onto:ho ;
    rdf:_9 onto:Boulevard ;
    rdfs:comment "\\n     These classes and properties are used to describe addresses in South Korea.\\n     "@en .

onto:AdministrativeDivisionGroup a rdf:Bag ;
    rdfs:label "Administrative Division Terms"@en ;
    rdf:_1 onto:RegionalLocalGovernment ;
    rdf:_10 onto:AdministrativeCity ;
    rdf:_11 onto:County ;
    rdf:_12 onto:AutonomousDistrict ;
    rdf:_13 onto:NonAutonomousDistrict ;
    rdf:_14 onto:si_gun_gu_code ;
    rdf:_15 onto:Town ;
    rdf:_16 onto:Township ;
    rdf:_17 onto:LegalStatusNeighborhood ;
    rdf:_18 onto:legal_status_neighborhood_code ;
    rdf:_19 onto:AdministrativeNeighborhood ;
    rdf:_2 onto:Province ;
    rdf:_20 onto:administrative_neighborhood_code ;
    rdf:_21 onto:eup_myeon_dong_code ;
    rdf:_22 onto:LegalStatusVillage ;
    rdf:_23 onto:AdministrativeVillage ;
    rdf:_3 onto:SpecialAutonomousProvince ;
    rdf:_4 onto:SpecialCity ;
    rdf:_5 onto:MetropolitanCity ;
    rdf:_6 onto:MetropolitanAutonomousCity ;
    rdf:_7 onto:BasicLocalGovernment ;
    rdf:_8 onto:City ;
    rdf:_9 onto:SpecificCity ;
    rdfs:comment "\\n    These classes and properties are used to describe administrative divisions\\n    in South Korea.    \\n    "@en .

onto:County a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    In South Korea, a county has a population of less than 150,000 (more than\\n    that would make it a city), is less densely populated than a district, and\\n    is more rural in character than either of the other 2 divisions.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Gun_(administrative_division)>,
        <https://ko.wikipedia.org/wiki/군_(행정_구역)> ;
    rdfs:subClassOf <http://rdfs.co/juso/County>,
        onto:BasicLocalGovernment ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A county is an administrative unit in South Korea similar.\\n    "@en ;
    skos:prefLabel "County"@en .

onto:MultiFamilyResidentialBuilding a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Multi-family_residential>,
        <https://ko.wikipedia.org/wiki/공동_주택> ;
    rdfs:subClassOf onto:Building ;
    ns1:term_status "unstable"@en ;
    skos:altLabel "MDU Building"@en,
        "Multi-dwelling Unit Building"@en ;
    skos:definition "\\n    A multifamily residential building is a building that contain multiple\\n    separate housing units for residential inhabitants.\\n    "@en ;
    skos:prefLabel "Multi-family Residential Building"@en .

onto:PostalCode1970 a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_postal_codes>,
        <https://ko.wikipedia.org/wiki/대한민국의_우편번호> ;
    rdfs:subClassOf <http://rdfs.co/juso/PostalCode> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    The first 5-digit postal code system in South Korea that was rolled out on\\n    July 1, 1970, and used until January 31, 1988.\\n    "@en ;
    skos:prefLabel "Postal Code (1970 - 1988)"@en .

onto:PostalCode1988 a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_postal_codes>,
        <https://ko.wikipedia.org/wiki/대한민국의_우편번호> ;
    rdfs:subClassOf <http://rdfs.co/juso/PostalCode> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    The 6-digit postal code system in South Korea that was rolled out on\\n    February 1, 1988, and used until July 31, 2015.\\n    "@en ;
    skos:prefLabel "Postal Code (1988 - 2015)"@en .

onto:PostalCode2015 a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_postal_codes_in_South_Korea>,
        <https://ko.wikipedia.org/wiki/대한민국의_우편번호> ;
    rdfs:subClassOf <http://rdfs.co/juso/PostalCode> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    The 5-digit postal code system based on the road name address system in\\n    South Korea, which has been rolled out on August 1, 2015.\\n    "@en ;
    skos:prefLabel "Postal Code (1988 - 2015)"@en .

onto:SpecificCity a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    Specific city are given powers to subdivide themselves into non-autonomous\\n    districts but, not all Specific city are subdivided into non-autonomous\\n    districts.\\n  "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Cities_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/특정시> ;
    rdfs:subClassOf onto:City ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A Specific city is a municipal city that has a population greater than\\n    500,000 and has been designated as such by an order of the National\\n    Government under Article 175 of the Local Autonomy Law.\\n    "@en ;
    skos:prefLabel "Specific City"@en .

onto:administrative_building_number a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain onto:Building ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Each building is given a number for administration.\\n    "@en ;
    skos:prefLabel "administrative building number"@en .

onto:administrative_neighborhood_code a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain onto:AdministrativeNeighborhood ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    The unique administrative code for the administrative neighborhood.\\n    "@en ;
    skos:prefLabel "administrative neighborhood code"@en .

onto:beonji a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain onto:EastAsianAddress ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/지번_(토지)> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Each neighborhood is divided into city blocks (beonji), which can range\\n    from several dozen to several thousand per neighborhood.\\n    "@en ;
    skos:prefLabel "beonji"@en .

onto:building_extra_number a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain onto:RoadNameAddress ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Addresses_in_South_Korea>,
        <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    rdfs:subPropertyOf <http://rdfs.co/juso/thoroughfare_address> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Buildings on a street or alley that is too small or too short to receive\\n    a name of its own share the same building number, followed by a hyphen,\\n    followed by a unique extra number afterwards.\\n    "@en ;
    skos:prefLabel "building extra number"@en .

onto:building_number a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain onto:RoadNameAddress ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Addresses_in_South_Korea>,
        <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    rdfs:subPropertyOf <http://rdfs.co/juso/thoroughfare_address> ;
    ns1:term_status "unstable"@en ;
    skos:altLabel "building main number"@en ;
    skos:definition "\\n    Buildings are numbered along a street with even numbers on one side and odd\\n    numbers on the other, as in most European countries.\\n    "@en ;
    skos:prefLabel "building number"@en .

onto:eup_myeon_dong a owl:ObjectProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:EastAsianAddress onto:RoadNameAddress ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:Town onto:Township onto:LegalStatusNeighborhood onto:AdministrativeNeighborhood ) ] ;
    rdfs:subPropertyOf <http://rdfs.co/juso/third_level_administrative_division> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    The third-level administrative division of the address in South Korea,\\n    one of the four types of submunicipal-level divisions: towns (eup),\\n    townships (myeon), legal-status neighborhoods (beopjeongdong), and\\n    administrative neighborhoods (haengjeongdong).\\n    "@en ;
    skos:prefLabel "town, township, or neighborhood"@en .

onto:eup_myeon_dong_code a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Town onto:Township onto:LegalStatusNeighborhood onto:AdministrativeNeighborhood ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Each of towns (eup), townships (myeon), or neighborhoods (dong) is given a\\n    3-number code.\\n    "@en ;
    skos:prefLabel "code for town, township, neighborhood"@en .

onto:eup_myeon_dong_serial_number a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain onto:RoadNameAddress ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A serial number for town, township, or neighborhood to distinguish\\n    addresses that share the same code for city, county, or district, and\\n    the same road name number.\\n    "@en ;
    skos:prefLabel "serial number for town, township, or neighborhood"@en .

onto:floor a owl:ObjectProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain onto:RoadNameAddress ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:oneOf ( <http://dbpedia.org/resource/Storey> <http://dbpedia.org/resource/Basement> <http://dbpedia.org/resource/Sky> ) ] ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Whether the address locates a place on the ground, under the ground, or in\\n    the air.\\n    "@en ;
    skos:prefLabel "floor"@en .

onto:ho a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    Usually, the words \"번지\" and \"호\" are not included in the written address;\\n    instead, only their numbers, separated by a hyphen, are written.\\n    "@en ;
    rdfs:domain onto:EastAsianAddress ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/House_numbering>,
        <https://ko.wikipedia.org/wiki/지번_(토지)> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    The building itself is given a house number (ho) within the city block.\\n    "@en ;
    skos:prefLabel "ho"@en .

onto:landform a owl:ObjectProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain onto:RoadNameAddress ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:oneOf ( <http://dbpedia.org/resource/Land_lot> <http://dbpedia.org/resource/Mountain> ) ] ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Whether the address locates a land lot or a mountain.\\n    "@en ;
    skos:prefLabel "landform"@en .

onto:legal_status_neighborhood_code a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain onto:LegalStatusNeighborhood ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    The unique administrative code for the legal-status neighborhood.\\n    "@en ;
    skos:prefLabel "legal-status neighborhood code"@en .

onto:parent_road a owl:ObjectProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Boulevard onto:Street onto:Road ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:Boulevard onto:Street onto:Road ) ] ;
    rdfs:subPropertyOf <http://www.geonames.org/ontology#parentFeature> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A boulevard, street, or road that is a direct parent of the current one.\\n    "@en ;
    skos:prefLabel "parent boulevard, street, or road"@en .

onto:ri a owl:ObjectProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:EastAsianAddress onto:RoadNameAddress ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:LegalStatusVillage onto:AdministrativeVillage ) ] ;
    rdfs:subPropertyOf <http://rdfs.co/juso/fourth_level_administrative_division> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A legal-status village (beopjeongri) or administrative village\\n    (haengjeongri) for the fourth-level administrative division of the address\\n    in South Korea.\\n    "@en ;
    skos:prefLabel "village"@en .

onto:road_name_number a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Boulevard onto:Street onto:Road ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Each of boulevards, streets, or roads is given a 7-number code.\\n    "@en ;
    skos:prefLabel "road name number"@en .

onto:si_do a owl:ObjectProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:EastAsianAddress onto:RoadNameAddress ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:RegionalLocalGovernment ;
    rdfs:subPropertyOf <http://rdfs.co/juso/first_level_administrative_division> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    The top tier of administrative division of the address in South Korea,\\n    one of the five types of provincial-level divisions: provinces (do),\\n    special autonomous provinces (teukbyeol-jachido), special cities\\n    (teukbyeolsi), metropolitan cities (gwangyeoksi) and metropolitan\\n    autonomous cities (teukbyeol-jachisi).\\n    "@en ;
    skos:prefLabel "city or province"@en .

onto:si_gun_gu a owl:ObjectProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:EastAsianAddress onto:RoadNameAddress ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:BasicLocalGovernment onto:NonAutonomousDistrict ) ] ;
    rdfs:subPropertyOf <http://rdfs.co/juso/second_level_administrative_division> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    The second-level administrative division of the address in South Korea,\\n    one of the six types of municipal-level divisions: cities (si), specific\\n    cities (teukjeongsi), administrative cities (haengjeongsi), county (gun),\\n    autonomous districts (jachigu), and non-autonomous districts (ilbangu).\\n    "@en ;
    skos:prefLabel "city, county, or district"@en .

onto:si_gun_gu_code a owl:DatatypeProperty ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:BasicLocalGovernment onto:NonAutonomousDistrict ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Each of cities (si), counties (gun), or districts (gu) is given a 5-number\\n    code.\\n    "@en ;
    skos:prefLabel "code for city, county, or district"@en .

<http://jayg.me/> a foaf:Person ;
    owl:sameAs <http://listinc.kr/id/member/jgkim> ;
    org:memberOf <http://listinc.kr/id/listinc> ;
