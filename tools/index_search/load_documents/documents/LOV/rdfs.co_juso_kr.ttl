    foaf:mbox_sha1sum "f03421e94730da58e8943d3a1d2c4c6b02898e14" ;
    foaf:name "James G. Kim"@en .

<http://listinc.kr/id/listinc> a org:Organization,
        foaf:Organization ;
    foaf:homepage <http://li-st.com/>,
        <http://listinc.kr/> ;
    foaf:mbox_sha1sum "de068365487dd2da1f2e88f1eaad0217bff79b40" ;
    foaf:member <http://listinc.kr/id/member/jgkim> ;
    foaf:name "LiST Inc."@en .

onto:AdministrativeCity a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    Since Jeju was given more autonomy, cities in Jeju could not be defined by\\n    the Local Autonomy Law so this new class of city was created for Jeju.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Cities_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/행정시> ;
    rdfs:subClassOf <http://rdfs.co/juso/City>,
        <http://rdfs.co/juso/SecondLevelAdministrativeDivision> ;
    owl:disjointWith onto:City ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    An Administrative city is a type of municipal city that are created in 1\\n    July 2006 after the 2005 referendum in Jeju and the province was given\\n    extensive administrative powers that had previously been reserved for the\\n    central government.\\n    "@en ;
    skos:prefLabel "Administrative City"@en .

onto:AdministrativeVillage a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    A legal-status village can be subdivided into one or more administrative\\n    villages.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Ri_(administrative_division)>,
        <https://ko.wikipedia.org/wiki/리_(행정_구역)> ;
    rdfs:subClassOf <http://rdfs.co/juso/FourthLevelAdministrativeDivision>,
        <http://rdfs.co/juso/Village> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A administrative village is an administrative unit in South Korea.\\n    "@en ;
    skos:prefLabel "Administrative Village"@en .

onto:AutonomousDistrict a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Gu_(administrative_division)>,
        <https://ko.wikipedia.org/wiki/구_(행정_구역)> ;
    rdfs:subClassOf <http://rdfs.co/juso/District>,
        onto:BasicLocalGovernment ;
    owl:disjointWith onto:NonAutonomousDistrict ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    An autonomous district of special and metropolitan cities is a municipal\\n    entity similar to a city with its own mayor along with its own\\n    legislative council.\\n    "@en ;
    skos:prefLabel "Autonomous District"@en .

onto:LegalStatusVillage a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Ri_(administrative_division)>,
        <https://ko.wikipedia.org/wiki/리_(행정_구역)> ;
    rdfs:subClassOf <http://rdfs.co/juso/FourthLevelAdministrativeDivision>,
        <http://rdfs.co/juso/Village> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A legal-status village is an administrative unit in South Korea.\\n    "@en ;
    skos:prefLabel "Legal-status Village"@en .

onto:Province a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Provinces_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/도_(행정_구역)> ;
    rdfs:subClassOf <http://rdfs.co/juso/Province>,
        onto:RegionalLocalGovernment ;
    owl:disjointWith onto:SpecialAutonomousProvince ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A province are the highest-ranked administrative divisions in South Korea.\\n    "@en ;
    skos:prefLabel "Province"@en .

onto:SpecialAutonomousProvince a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    Jeju is the only special autonomous province in South Korea.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Provinces_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/특별자치도> ;
    rdfs:subClassOf <http://rdfs.co/juso/Province>,
        onto:RegionalLocalGovernment ;
    owl:disjointWith onto:Province ;
    ns1:term_status "unstable"@en ;
    skos:altLabel "Special Self-governing Province"@en ;
    skos:definition "\\n    A special autonomous province is a province with more autonomy over its\\n    economy and more powers are given to the provincial government.\\n    "@en ;
    skos:prefLabel "Special Autonomous Province"@en .

onto:Building a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Building>,
        <https://ko.wikipedia.org/wiki/건축물> ;
    rdfs:subClassOf <http://rdfs.co/juso/Feature> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A building is a man-made structure with a roof and walls standing more or\\n    less permanently in one place, such as a house or factory.\\n    "@en ;
    skos:prefLabel "Building"@en .

onto:City a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    Cities are ranked on the same level as county and autonomous district.\\n  "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Cities_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/시_(행정_구역)> ;
    rdfs:subClassOf <http://rdfs.co/juso/City>,
        onto:BasicLocalGovernment ;
    owl:disjointWith onto:AdministrativeCity ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A city is a municipal administrative unit in South Korea.\\n    "@en ;
    skos:prefLabel "City"@en .

onto:MetropolitanAutonomousCity a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    The only metropolitan autonomous city in South Korea called Sejong opened 2\\n    July 2012.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Special_cities_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/특별자치시> ;
    rdfs:subClassOf <http://rdfs.co/juso/City>,
        onto:RegionalLocalGovernment ;
    owl:disjointWith onto:MetropolitanCity,
        onto:SpecialCity ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    In early 2007, the South Korean government created a special administrative\\n    district from parts of South Chungcheong and North Chungcheong provinces,\\n    near Daejeon, to relocate nine ministries and four national agencies from\\n    Seoul.\\n    "@en ;
    skos:prefLabel "Metropolitan Autonomous City"@en .

onto:MetropolitanCity a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    They were called \"directly-administered city\" before 1995. These cities\\n    have equal status to the provinces.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Special_cities_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/광역시> ;
    rdfs:subClassOf <http://rdfs.co/juso/City>,
        onto:RegionalLocalGovernment ;
    owl:disjointWith onto:MetropolitanAutonomousCity,
        onto:SpecialCity ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Metropolitan cities are the highest-ranked administrative divisions in\\n    South Korea.\\n    "@en ;
    skos:prefLabel "Metropolitan City"@en .

onto:SpecialCity a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Special_cities_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/특별시> ;
    rdfs:subClassOf <http://rdfs.co/juso/City>,
        onto:RegionalLocalGovernment ;
    owl:disjointWith onto:MetropolitanAutonomousCity,
        onto:MetropolitanCity ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    Seoul was designated a \"special free city\" separate from Gyeonggi Province\\n    on August 15, 1946; it became a \"special city\" on August 15, 1949.\\n    "@en ;
    skos:prefLabel "Special City"@en .

onto:Town a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    Along with \"township\", a town is one of the divisions of a county, and of\\n    some cities with a population of less than 500,000. Towns are subdivided\\n    into villages.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Eup_(administrative_division)>,
        <https://ko.wikipedia.org/wiki/읍> ;
    rdfs:subClassOf <http://rdfs.co/juso/ThirdLevelAdministrativeDivision>,
        <http://rdfs.co/juso/Town> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A town is an administrative unit in South Korea.\\n    "@en ;
    skos:prefLabel "Town"@en .

onto:Township a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    Along with town, township is of a county and some cities of fewer than\\n    500,000 population. Townships have smaller populations than towns and\\n    represent the rural areas of a county or city. Townships are subdivided\\n    into villages.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Myeon_(administrative_division)>,
        <https://ko.wikipedia.org/wiki/면_(행정_구역)> ;
    rdfs:subClassOf <http://rdfs.co/juso/ThirdLevelAdministrativeDivision>,
        <http://rdfs.co/juso/Township> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A township is an administrative unit in South Korea.\\n    "@en ;
    skos:prefLabel "Township"@en .

onto:AdministrativeNeighborhood a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    In some cases, a single legal-status neighborhood is divided into several\\n    administrative neighborhoods. In such cases, each administrative dong has\\n    its own office and staff.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Dong_(administrative_division)>,
        <https://ko.wikipedia.org/wiki/동_(행정_구역)> ;
    rdfs:subClassOf <http://rdfs.co/juso/Neighborhood>,
        <http://rdfs.co/juso/ThirdLevelAdministrativeDivision> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    An administrative neighborhood is the smallest level of urban government to\\n    have its own office and staff in South Korea.\\n    "@en ;
    skos:prefLabel "Administrative Neighborhood"@en .

onto:Boulevard a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    rdfs:subClassOf <http://rdfs.co/juso/Street> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    In the Road Name Address system, the word boulevard (daero) is used to\\n    describe two-way roads that have more than 40m width or 8 lanes.\\n    "@en ;
    skos:prefLabel "Boulevard"@en .

onto:LegalStatusNeighborhood a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Dong_(administrative_division)>,
        <https://ko.wikipedia.org/wiki/법정동> ;
    rdfs:subClassOf <http://rdfs.co/juso/Neighborhood>,
        <http://rdfs.co/juso/ThirdLevelAdministrativeDivision> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    A legal-status neighborhood is a submunicipal level administrative unit of\\n    a city and of those cities which are not divided into districts throughout\\n    Korea.\\n    "@en ;
    skos:prefLabel "Legal-status Neighborhood"@en .

onto:NonAutonomousDistrict a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Gu_(administrative_division)>,
        <https://ko.wikipedia.org/wiki/구_(행정_구역)> ;
    rdfs:subClassOf <http://rdfs.co/juso/District>,
        <http://rdfs.co/juso/SecondLevelAdministrativeDivision> ;
    owl:disjointWith onto:AutonomousDistrict ;
    ns1:term_status "unstable"@en ;
    skos:altLabel "Administrative District"@en ;
    skos:definition "\\n    Cities with over 500,000 people are allowed to have non-autonomous\\n    districts (notable exceptions to this rule are the cities of Gimhae,\\n    Hwaseong, and Namyangju).\\n    "@en ;
    skos:prefLabel "Non-autonomous District"@en .

onto:Road a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    rdfs:subClassOf <http://rdfs.co/juso/Street> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    In the Road Name Address system, the word road (gil) is used to describe\\n    roads that have less than 12m width or 2 lanes.\\n    width or 2 lanes.\\n    "@en ;
    skos:prefLabel "Road"@en .

onto:Street a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    rdfs:subClassOf <http://rdfs.co/juso/Street> ;
    ns1:term_status "unstable"@en ;
    skos:definition "\\n    In the Road Name Address system, the word street (ro) is used to\\n    describe two-way roads that are narrower than roads but have more than 12m\\n    width or 2 lanes.\\n    "@en ;
    skos:prefLabel "Street"@en .

onto:BasicLocalGovernment a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:comment "\\n    Non-autonomous districts of municipal cities and administrative cities in\\n    Jeju are not basic local governments.\\n    "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Administrative_divisions_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/기초지방자치단체> ;
    rdfs:subClassOf <http://rdfs.co/juso/SecondLevelAdministrativeDivision> ;
    owl:disjointWith onto:RegionalLocalGovernment ;
    ns1:term_status "unstable"@en ;
    skos:altLabel "Lower-level Local Autonomy"@en,
        "Municipal Government"@en,
        "Municipality"@en ;
    skos:definition "\\n    Basic local governments are the municipal-level administrative division\\n    within South Korea.\\n    "@en ;
    skos:prefLabel "Basic Local Government"@en .

onto:EastAsianAddress a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Addresses_in_South_Korea>,
        <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    rdfs:subClassOf <http://rdfs.co/juso/Address> ;
    ns1:term_status "testing"@en ;
    skos:definition "\\n    The previous addressing system used in South Korea was the the East Asian\\n    system, which is also used in Japan and North Korea (but not within the\\n      Chinese-speaking world), but although still commonly used, is no longer\\n    officially recognized since December 31, 2013.\\n    "@en ;
    skos:prefLabel "East Asian Address"@en .

onto:RegionalLocalGovernment a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Administrative_divisions_of_South_Korea>,
        <https://ko.wikipedia.org/wiki/광역자치단체> ;
    rdfs:subClassOf <http://rdfs.co/juso/FirstLevelAdministrativeDivision> ;
    owl:disjointWith onto:BasicLocalGovernment ;
    ns1:term_status "unstable"@en ;
    skos:altLabel "Metropolitan Government"@en,
        "Upper-level Local Autonomy"@en ;
    skos:definition "\\n    Regional local governments are the highest-ranked administrative division\\n    within South Korea.\\n    "@en ;
    skos:prefLabel "Regional Local Government"@en .

onto:RoadNameAddress a owl:Class ;
    dcterms:issued "2015-10-02"^^xsd:date ;
    dcterms:modified "2015-10-02"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Addresses_in_South_Korea>,
        <https://ko.wikipedia.org/wiki/대한민국의_주소> ;
    rdfs:subClassOf <http://rdfs.co/juso/Address> ;
    ns1:term_status "testing"@en ;
    skos:definition "\\n    The Road Name Address system, rolled out on January 1, 2014, uses street\\n    names and house numbers, and is similar to the systems used by the United\\n    States, Canada, and Europe.\\n    "@en ;
    skos:prefLabel "Road Name Address"@en .

