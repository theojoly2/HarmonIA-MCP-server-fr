onto: a owl:Ontology ;
    dcterms:description "Defines concepts and properties specific for the Philips use case (cooking domain)."@en ;
    dcterms:title "SmartProducts Food Domain Model"@en ;
    rdfs:comment "Defines concepts and properties specific for the Philips use case (cooking domain)." ;
    owl:imports <http://kmi.open.ac.uk/projects/smartproducts/ontologies/process.owl>,
        <http://kmi.open.ac.uk/projects/smartproducts/ontologies/product.owl> .

