            owl:hasValue <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#USA> ;
            owl:onProperty <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#hasGeographicalProvenance> ],
