<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#RecipePreference> a owl:Class ;
    rdfs:subClassOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#FoodPreference> .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#SideCourse> a <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#MealCourseType>,
        owl:NamedIndividual,
        owl:Thing .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#FoodOrDrinkMatter> a owl:Class ;
    rdfs:subClassOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#Matter>,
        <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#MetaClass> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#FoodOrDrink> ;
            owl:onProperty rdfs:subClassOf ] .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#IngredientPortion> a owl:Class ;
    rdfs:subClassOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#AtomicFoodOrDrinkItem>,
        <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#VirtualFoodOrDrinkItem>,
        <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#AssemblyComponent>,
        <http://www.loa-cnr.it/ontologies/DUL.owl#Substance> .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#KitchenTool> a owl:Class ;
    rdfs:subClassOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/product.owl#ProductizedDevice> .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#Recipe> a owl:Class ;
    rdfs:comment <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#SideCourse> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#CookingActivity> ;
            owl:onProperty <http://kmi.open.ac.uk/projects/smartproducts/ontologies/process.owl#hasStep> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#IngredientPortion> ;
            owl:onProperty <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#hasIngredient> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#IngredientPortion> ;
            owl:onProperty <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#hasIngredient> ],
        <http://kmi.open.ac.uk/projects/smartproducts/ontologies/process.owl#WorkflowDefinition> .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#Nutrient> a owl:Class ;
    rdfs:subClassOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#Matter> .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#MealCourseType> a owl:Class ;
    rdfs:subClassOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#RoleType> .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#DietType> a owl:Class ;
    rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Concept> .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#RegionalCuisineRecipe> a owl:Class ;
    rdfs:subClassOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#Recipe> .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#FoodOrDrinkItem> a owl:Class ;
    rdfs:subClassOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#PhysicalEntityInSpace>,
        <http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalBody> .

<http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#hasGeographicalProvenance> a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#FoodOrDrinkItem> <http://kmi.open.ac.uk/projects/smartproducts/ontologies/food.owl#Recipe> ) ] ;
    rdfs:range <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#PhysicalGeographicEntity> .

owl:Thing a owl:Class .

