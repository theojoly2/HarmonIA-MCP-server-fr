onto:AlternativeMaterial a owl:Class ;
    rdfs:label "Alternative material"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document> ;
    ns1:term_status "stable" .

