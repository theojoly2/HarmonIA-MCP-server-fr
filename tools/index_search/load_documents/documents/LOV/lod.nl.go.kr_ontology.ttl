    dcterms:creator <http://listinc.kr/id/member/joyhong>,
        <http://listinc.kr/id/member/wonseok.oh> ;
    dcterms:description "이 자료는 국립중앙도서관이 관리, 보존하고 있는 서지 정보와 주제명, 저자명 데이터를 대상으로 기존의 (KOR)MARC 형태 또는 DBMS 형태의 데이터를 RDF로 형식으로 변환하여 웹상에 Linked Open Data 형식으로 발행하고 있는 <a href=\"http://lod.nl.go.kr/home\">국립중앙도서관 LOD</a>에서 사용하고 있는 명세서입니다."^^xsd:string ;
    dcterms:issued "2015-09-08"^^xsd:date ;
    dcterms:modified "2015-11-23"^^xsd:date ;
    dcterms:publisher <http://lod.nl.go.kr/library/011001> ;
    dcterms:title "National Library of Korea Ontology"^^xsd:string ;
    vann:preferredNamespacePrefix "nlon" ;
    vann:preferredNamespaceUri "http://lod.nl.go.kr/ontology/" ;
    rdfs:comment "This specification describes National Library of Korea Ontology vocaburaries using W3C's RDF and OWL technology."^^xsd:string ;
    owl:imports dcam:,
        dcmitype:,
        dc:,
        <http://purl.org/ontology/bibo/>,
        <http://www.w3.org/2004/02/skos/core>,
        foaf: ;
    owl:versionInfo "NLK 2015"^^xsd:string .

