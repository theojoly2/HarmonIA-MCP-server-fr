<http://data.semanticweb.org/ns/swc/ontology#InvitedPaper> a owl:DeprecatedClass ;
    rdfs:label "Invited Paper" ;
    dcterms:subject <http://dbpedia.org/resource/Document> ;
    rdfs:comment "\\n\\t\\t\\t<p>As opposed to a peer-reviewed paper. This class has been deprecated in order to reduce the inflation of classes.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://swrc.ontoware.org/ontology#InProceedings> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#KeynoteTalk> a owl:DeprecatedClass ;
    rdfs:label "Keynote Talk" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#TalkEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#LocalOrganiser> a owl:DeprecatedClass ;
    rdfs:label "Local Organiser" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#MealBreak> a owl:DeprecatedClass ;
    rdfs:label "Meal Break" ;
    dcterms:subject <http://dbpedia.org/resource/Event> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just use <a href=\"#BreakEvent\">BreakEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#BreakEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#MeetingRoomPlace> a owl:Class ;
    rdfs:label "Meeting Room Place" ;
    dcterms:subject <http://dbpedia.org/resource/Place> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA particular room at the <a href=\"#ConferenceVenuePlace\">conference venue</a> (or elsewhere). E.g., the room where a particular <a href=\"#SessionEvent\">SessionEvent</a> takes place. \\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#OrganisingCommitteeMember> a owl:DeprecatedClass ;
    rdfs:label "Organising Committee Member" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#PanelEvent> a owl:Class ;
    rdfs:label "Panel Event" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\t<p>A panel discussion at a conference or conference-like event, usually involving several speakers.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#PaperPresentation> a owl:DeprecatedClass ;
    rdfs:label "Paper Presentation" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#TalkEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#PaperSession> a owl:DeprecatedClass ;
    rdfs:label "Paper Session" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#SessionEvent\">SessionEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#SessionEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#PhDSymposiumChair> a owl:DeprecatedClass ;
    rdfs:label "PhD Symposium or Doctoral Consortium Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tDeprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Poster> a owl:Class ;
    rdfs:label "Poster" ;
    dcterms:subject <http://dbpedia.org/resource/Document> ;
    rdfs:comment "\\n\\t\\t\\t<p>A scientific poster at a conference or workshop.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#ArgumentativeDocument>,
        <http://data.semanticweb.org/ns/swc/ontology#Artefact> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#PosterPresentation> a owl:DeprecatedClass ;
    rdfs:label "Poster Presentation" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#TalkEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#PosterSession> a owl:DeprecatedClass ;
    rdfs:label "Poster Session" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#SessionEvent\">SessionEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#SessionEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#PostersChair> a owl:DeprecatedClass ;
    rdfs:label "Posters Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tDeprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Presenter> a owl:Class ;
    rdfs:label "Presenter" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA presenter is someone who presents matter in front of an audience. Examples of events to which this role applies are paper presentations, tutorials, or talks. A keynote speaker could also be modelled as an instance of this class.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#PrintedProceedingsChair> a owl:DeprecatedClass ;
    rdfs:label "(Printed) Proceedings Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#ProgrammeChair> a owl:DeprecatedClass ;
    rdfs:label "Programme Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#ProgrammeCommitteeMember> a owl:Class ;
    rdfs:label "Programme Committee Member" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tThis role is played by the members of the programme committee of a conference or conference-like event. We found this role to be so significant that it justifies to be represented by its own class.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#PublicityChair> a owl:DeprecatedClass ;
    rdfs:label "Publicity Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Reception> a owl:DeprecatedClass ;
    rdfs:label "Reception" ;
    dcterms:subject <http://dbpedia.org/resource/Event> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just use <a href=\"#SocialEvent\">SocialEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#SocialEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#ResearchTrack> a owl:DeprecatedClass ;
    rdfs:label "Research Track" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#TrackEvent\">TrackEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#TrackEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Reviewer> a owl:DeprecatedClass ;
    rdfs:label "Reviewer" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tDeprecating this, just use <a href=\"#ProgrammeCommitteeMember\">ProgrammeCommitteeMember</a> instead.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#SWChallengeChair> a owl:DeprecatedClass ;
    rdfs:label "Semantic Web Challenge Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tDeprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#SessionChair> a owl:DeprecatedClass ;
    rdfs:label "Session Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#SlideSet> a owl:Class ;
    rdfs:label "Slide Set" ;
    dcterms:subject <http://dbpedia.org/resource/Document> ;
    rdfs:comment "\\n\\t\\t\\t<p>A set of slides used for a presentation of e.g. a paper at a conference.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#ArgumentativeDocument>,
        <http://data.semanticweb.org/ns/swc/ontology#Artefact> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#SponsorshipChair> a owl:DeprecatedClass ;
    rdfs:label "Sponsorship Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#SubmissionsChair> a owl:DeprecatedClass ;
    rdfs:label "Submissions Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#SystemDemonstration> a owl:DeprecatedClass ;
    rdfs:label "System Demonstration" ;
    dcterms:subject <http://dbpedia.org/resource/Document> ;
    rdfs:comment "\\n\\t\\t\\t<p>A type of paper which accompanies the demonstration of software, also known as an extended abstract or demo description. This class has been deprecated in order to reduce the inflation of classes; it is too specific for CS conferences.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Paper> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#SystemDescription> a owl:DeprecatedClass ;
    rdfs:label "System Description" ;
    dcterms:subject <http://dbpedia.org/resource/Document> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA type of paper which is mainly describes the properties, implementation or architecture of an system (such as a software system).\\n\\t\\t\\t</p>\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tDeprecating this: it's too specific for, not generic enough to apply for most conferences.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Paper> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#TrackChair> a owl:DeprecatedClass ;
    rdfs:label "Track Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tThe chair of a particular track of a conference, responsible for all submissions and actions regarding this track.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Treasurer> a owl:DeprecatedClass ;
    rdfs:label "Treasurer" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Tutor> a owl:DeprecatedClass ;
    rdfs:label "Tutor" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#TutorialEvent> a owl:Class ;
    rdfs:label "Tutorial Event" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA tutorial is a special session at a conference or workshop, somewhat like a long lecture on a specific topic.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#TutorialPresenter> a owl:DeprecatedClass ;
    rdfs:label "Tutorial Presenter" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tDeprecating this, just use <a href=\"#Presenter\">Presenter</a> instead.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#TutorialsChair> a owl:DeprecatedClass ;
    rdfs:label "Tutorials Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Webmaster> a owl:DeprecatedClass ;
    rdfs:label "Webmaster" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#WelcomeTalk> a owl:DeprecatedClass ;
    rdfs:label "Welcome Talk" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#TalkEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#WorkshopEvent> a owl:Class ;
    rdfs:label "Workshop Event" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA scientific workshop. Workshops are often co-located with <a href=\"#ConferenceEvent\">ConferenceEvent</a>s.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#WorkshopOrganiser> a owl:DeprecatedClass ;
    rdfs:label "Workshop Organiser" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#WorkshopsChair> a owl:DeprecatedClass ;
    rdfs:label "Workshops Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#affiliation> a owl:DeprecatedProperty ;
    rdfs:label "affiliation" ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#biblioReference> a owl:DeprecatedProperty ;
    rdfs:label "bibliographic reference" ;
    rdfs:comment "\\n\\t\\t\\t<p>Deprecated because it has never been used and in order to reduce the inflation of ontology terms.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#Artefact> ;
    rdfs:range xsd:string ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#hasCameraReadyDeadline> a owl:DeprecatedProperty ;
    rdfs:label "has camera-ready deadline" ;
    rdfs:comment "\\n\\t\\t\\t<p>The call classes have been deprecated in SWC. Instead, we suggest to use the <a href=\"http://sw.deri.org/2005/08/conf/cfp\">CfP ontology</a>.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#Call> ;
    rdfs:range xsd:dateTime ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#hasCostAmount> a owl:DeprecatedProperty ;
    rdfs:label "has cost amount" ;
    rdfs:comment "\\n\\t\\t\\t<p>Deprecated because it has never been used and in order to reduce the inflation of ontology terms.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#Sponsorship> ;
    rdfs:range xsd:integer ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#hasCostCurrency> a owl:DeprecatedProperty ;
    rdfs:label "has cost currency" ;
    rdfs:comment "\\n\\t\\t\\t<p>Deprecated because it has never been used and in order to reduce the inflation of ontology terms.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#Sponsorship> ;
    rdfs:range xsd:string ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#hasLocation> a owl:ObjectProperty ;
    rdfs:label "has location" ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tRelates an event such as a conference or any sub-event thereof to a location where it takes place. \\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#OrganisedEvent> ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#hasMenu> a owl:DeprecatedProperty ;
    rdfs:label "has menu" ;
    rdfs:comment "\\n\\t\\t\\t<p>Deprecated because it has never been used and in order to reduce the inflation of ontology terms.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#MealEvent> ;
    rdfs:range <http://xmlns.com/wordnet/1.6/Menu> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#hasNotificationDeadline> a owl:DeprecatedProperty ;
    rdfs:label "has notification deadline" ;
    rdfs:comment "\\n\\t\\t\\t<p>The call classes have been deprecated in SWC. Instead, we suggest to use the <a href=\"http://sw.deri.org/2005/08/conf/cfp\">CfP ontology</a>.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#Call> ;
    rdfs:range xsd:dateTime ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#hasPart> a owl:ObjectProperty ;
    rdfs:label "has part" ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA generic property to model part-of relationships. In SWC this property is used to relate a <a href=\"#Proceedings\">proceedings document</a> to the papers and articles contained in it.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#hasProgramme> a owl:ObjectProperty ;
    rdfs:label "has programme" ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tRelates an event such as a conference to its <a href=\"#Programme\">Programme</a>. \\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#OrganisedEvent> ;
    rdfs:range <http://data.semanticweb.org/ns/swc/ontology#Programme> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#hasRelatedArtefact> a owl:ObjectProperty ;
    rdfs:label "has related artefact" ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tRelates an <a href=\"#AcademicEvent\">event</a> such as a conference, workshop, etc. to a physical <a href=\"#Artefact\">artefact</a>.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:range <http://data.semanticweb.org/ns/swc/ontology#Artefact> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#hasSponsorship> a owl:DeprecatedProperty ;
    rdfs:label "has sponsorship" ;
    rdfs:comment "\\n\\t\\t\\t<p>Deprecated because it has never been used and in order to reduce the inflation of ontology terms.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#OrganisedEvent> ;
    rdfs:range <http://data.semanticweb.org/ns/swc/ontology#Sponsorship> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#hasSubmissionDeadline> a owl:DeprecatedProperty ;
    rdfs:label "has submission deadline" ;
    rdfs:comment "\\n\\t\\t\\t<p>The call classes have been deprecated in SWC. Instead, we suggest to use the <a href=\"http://sw.deri.org/2005/08/conf/cfp\">CfP ontology</a>.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#Call> ;
    rdfs:range xsd:dateTime ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#hasSubmissionInstructions> a owl:DeprecatedProperty ;
    rdfs:label "has submission instructions" ;
    rdfs:comment "\\n\\t\\t\\t<p>The call classes have been deprecated in SWC. Instead, we suggest to use the <a href=\"http://sw.deri.org/2005/08/conf/cfp\">CfP ontology</a>.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://data.semanticweb.org/ns/swc/ontology#Call> ;
    rdfs:range xsd:string ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#hasTopic> a owl:DeprecatedProperty ;
    rdfs:label "has topic" ;
    rdfs:comment "\\n\\t\\t\\t<p>Instead of this property, use <a href=\"http://xmlns.com/foaf/0.1/topic\">foaf:topic</a>.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:range <http://swrc.ontoware.org/ontology#ResearchTopic> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#isLocationFor> a owl:ObjectProperty ;
    rdfs:label "is location of" ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tRelates a location to a conference or sub-event thereof which takes place at it.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:range <http://data.semanticweb.org/ns/swc/ontology#OrganisedEvent> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#isPartOf> a owl:ObjectProperty ;
    rdfs:label "is part of" ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA generic property to model part-of relationships. In SWC this property is used to relate papers or articles to the <a href=\"#Proceedings\">proceedings document</a> in which they are contained.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#isTopicOf> a owl:DeprecatedProperty ;
    rdfs:label "is topic of" ;
    rdfs:comment "\\n\\t\\t\\t<p>Deprecated, instead using terms from FOAF.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain <http://swrc.ontoware.org/ontology#ResearchTopic> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#memberOf> a owl:ObjectProperty ;
    rdfs:label "member of" ;
    rdfs:comment "\\n\\t\\t\\t<p>FOAF does not define an inverse of <code>foaf:member</code>, so SWC does it.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Group ;
    owl:inverseOf foaf:member ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#plansToAttend> a owl:ObjectProperty ;
    rdfs:label "plans to attend" ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA person might plan to attend a talk or session at a conference or similar event. This property could be used to prepare a delegate's conference experience with respect to who they want to meet, etc.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:domain foaf:Person ;
    rdfs:range <http://data.semanticweb.org/ns/swc/ontology#OrganisedEvent> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#uuid> a owl:DeprecatedProperty ;
    rdfs:label "uuid" ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/organization/deri-nui-galway> a foaf:Organization ;
    foaf:homepage <http://www.deri.ie> ;
    foaf:member <http://kantenwerk.org/metadata/foaf.rdf#me> ;
    foaf:name "DERI" .

<http://data.semanticweb.org/organization/talis-information-limited> a foaf:Organization ;
    foaf:homepage <http://www.talis.com/> ;
    foaf:member <http://tomheath.com/id/me> ;
    foaf:name "Talis Information Limited" .

<http://data.semanticweb.org/organization/university-of-manchester-uk> a foaf:Organization ;
    foaf:homepage <http://www.manchester.ac.uk/> ;
    foaf:member <http://data.semanticweb.org/person/sean-bechhofer> ;
    foaf:name "University of Manchester" .

