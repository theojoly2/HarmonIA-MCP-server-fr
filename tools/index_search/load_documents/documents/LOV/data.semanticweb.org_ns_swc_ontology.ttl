@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://rdfs.org/sioc/ns#> .
@prefix ns3: <http://data.semanticweb.org/ns/misc#> .
@prefix ns4: <http://www.cs.vu.nl/~mcaklein/onto/swrc_ext/2005/05#> .
@prefix onto: <http://data.semanticweb.org/ns/swc/ontology> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "Semantic Web Conference Ontology" ;
    ns3:licenseDoc <http://data.semanticweb.org/ns/swc/ontology#license_doc> ;
    dcterms:created "2007/05/31" ;
    dcterms:creator <http://data.semanticweb.org/person/sean-bechhofer>,
        <http://kantenwerk.org/metadata/foaf.rdf#me>,
        <http://tomheath.com/id/me> ;
    dcterms:hasVersion <http://data.semanticweb.org/ns/swc/swc_2009-02-27.rdf>,
        <http://data.semanticweb.org/ns/swc/swc_2009-03-02.rdf> ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:modified "$Date: 2009-05-11 17:50:14 +0100 (Mon, 11 May 2009) $" ;
    dcterms:title "Semantic Web Conference Ontology" ;
    ns2:earlier_version <http://data.semanticweb.org/ns/swc/swc_2009-03-02.rdf> ;
    doap:revision "\\n\\t\\t\\t$Revision: 895 $ - <i>Slim Version</i>\\n\\t\\t\\t" ;
    ns4:authorList [ rdf:_1 <http://kantenwerk.org/metadata/foaf.rdf#me> ;
            rdf:_2 <http://data.semanticweb.org/person/sean-bechhofer> ;
            rdf:_3 <http://tomheath.com/id/me> ] ;
    owl:imports <http://data.semanticweb.org/ns/swc/swrc>,
        <http://data.semanticweb.org/ns/swc/swrc-topics> ;
    ns1:userdocs ( <http://data.semanticweb.org/ns/swc/ontology#01_introduction> <http://data.semanticweb.org/ns/swc/ontology#02_describing_papers> <http://data.semanticweb.org/ns/swc/ontology#03_roles> ) ;
    foaf:logo <http://data.semanticweb.org/images/bones_256.png> ;
    foaf:maker <http://data.semanticweb.org/person/sean-bechhofer>,
        <http://kantenwerk.org/metadata/foaf.rdf#me>,
        <http://tomheath.com/id/me> .

<http://data.semanticweb.org/ns/swc/ontology#AccommodationPlace> a owl:Class ;
    rdfs:label "Accommodation Place" ;
    dcterms:subject <http://dbpedia.org/resource/Place> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA hotel, hostel, BnB or similar. \\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#AdditionalReviewer> a owl:DeprecatedClass ;
    rdfs:label "Additional Reviewer" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Administrator> a owl:DeprecatedClass ;
    rdfs:label "Administrator" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#CallForDemos> a owl:DeprecatedClass ;
    rdfs:label "Call for Demos" ;
    dcterms:subject <http://dbpedia.org/resource/Call> ;
    rdfs:comment "\\n\\t\\t\\t<p>A call for demonstrations of software at a conference or workshop. Submissions are usually in the form of extended abstracts (~2 page) discussing the research questions addressed by the software and outlining the content of the demonstration.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Call> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#CallForPapers> a owl:DeprecatedClass ;
    rdfs:label "Call for Papers" ;
    dcterms:subject <http://dbpedia.org/resource/Call> ;
    rdfs:comment "\\n\\t\\t\\t<p>A <emph>call for papers</emph> or <emph>CfP</emph> encourages authors to submit papers for peer-review for a conference or workshop, or a journal or book.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Call> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#CallForParticipation> a owl:DeprecatedClass ;
    rdfs:label "Call for Participation" ;
    dcterms:subject <http://dbpedia.org/resource/Call> ;
    rdfs:comment "\\n\\t\\t\\t<p>This kind of call usually calls for potential delegates to attend an event such as a conference or a workshop.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Call> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#CallForPosters> a owl:DeprecatedClass ;
    rdfs:label "Call for Posters" ;
    dcterms:subject <http://dbpedia.org/resource/Call> ;
    rdfs:comment "\\n\\t\\t\\t<p>A call for scientific posters at a conference or workshop. Submissions are usually in the form of extended abstracts (~2 page) discussing the research presented on the poster.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Call> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#CallForProposals> a owl:DeprecatedClass ;
    rdfs:label "Call for Proposals" ;
    dcterms:subject <http://dbpedia.org/resource/Call> ;
    rdfs:comment "\\n\\t\\t\\t<p>A call which asks for contributions in the form of e.g. workshop or tutorial proposals.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Call> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Chair> a owl:Class ;
    rdfs:label "Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA sub-class of Role for various kinds of chair functions. Examples are the main chair of a conference, the tutorials chair, the proceedings chair, etc. Instead of introducing a large amount of sub-classes of Chair, we suggest to model all the different chair functions as instances of Chair with appropriate labels.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#CoffeeBreak> a owl:DeprecatedClass ;
    rdfs:label "Coffee Break" ;
    dcterms:subject <http://dbpedia.org/resource/Event> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just use <a href=\"#BreakEvent\">BreakEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#BreakEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#CommunalPlace> a owl:Class ;
    rdfs:label "Communal Place" ;
    dcterms:subject <http://dbpedia.org/resource/Place> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA location at the <a href=\"#ConferenceVenuePlace\">conference venue</a> (or elsewhere), which is not a meeting room. \\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#ConferenceChair> a owl:DeprecatedClass ;
    rdfs:label "Conference Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#ConferenceClosingEvent> a owl:DeprecatedClass ;
    rdfs:label "Closing Event" ;
    dcterms:subject <http://dbpedia.org/resource/Event> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just use <a href=\"#TalkEvent\">TalkEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#NonAcademicEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#ConferenceDinner> a owl:DeprecatedClass ;
    rdfs:label "Conference Dinner" ;
    dcterms:subject <http://dbpedia.org/resource/Event> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just use <a href=\"#SocialEvent\">SocialEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#MealEvent>,
        <http://data.semanticweb.org/ns/swc/ontology#SocialEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#ConferenceEvent> a owl:Class ;
    rdfs:label "Conference Event" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA scientific conference.\\n\\t\\t\\t</p>\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tTODO: Maybe this should be opened up - why only scientific conferences?\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#ConferenceOpeningEvent> a owl:DeprecatedClass ;
    rdfs:label "Opening Event" ;
    dcterms:subject <http://dbpedia.org/resource/Event> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just use <a href=\"#TalkEvent\">TalkEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#NonAcademicEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#ConferenceVenuePlace> a owl:Class ;
    rdfs:label "Conference Venue Place" ;
    dcterms:subject <http://dbpedia.org/resource/Place> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tThe location of a conference or conference-like event. Ideally, this would be more specific than just the city. Instead it should  be the hotel, convention centre, university or similar place where the event is held.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#Delegate> a owl:Class ;
    rdfs:label "Delegate" ;
    dcterms:subject <http://dbpedia.org/resource/Role> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tA delegate is someone who attends a conference or conference-like event.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "testing" .

<http://data.semanticweb.org/ns/swc/ontology#DemoPresentation> a owl:DeprecatedClass ;
    rdfs:label "Demo Presentation" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#TalkEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#DemoSession> a owl:DeprecatedClass ;
    rdfs:label "Demo Session" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#SessionEvent\">SessionEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#SessionEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#DemosChair> a owl:DeprecatedClass ;
    rdfs:label "Demos Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tDeprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#DogfoodTsar> a owl:DeprecatedClass ;
    rdfs:label "Dogfood Tsar" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:comment "A role that is only relevant in relation to the topic of the conference e.g. Semantic \\n\\t\\t\\tWeb Technologies Coordinator at a Semantic Web Conference.\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#DrinkingPlace> a owl:DeprecatedClass ;
    rdfs:label "Drinking Place" ;
    dcterms:subject <http://dbpedia.org/resource/Place> ;
    rdfs:comment "\\n\\t\\t\\t<p>Deprecated to reduce inflation of terms.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Place> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#EatingPlace> a owl:DeprecatedClass ;
    rdfs:label "Eating Place" ;
    dcterms:subject <http://dbpedia.org/resource/Place> ;
    rdfs:comment "\\n\\t\\t\\t<p>Deprecated to reduce inflation of terms.</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Place> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#Excursion> a owl:DeprecatedClass ;
    rdfs:label "Excursion" ;
    dcterms:subject <http://dbpedia.org/resource/Event> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just use <a href=\"#SocialEvent\">SocialEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#SocialEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#ExhibitionChair> a owl:DeprecatedClass ;
    rdfs:label "Exhibition Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tDeprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
    ns1:term_status "deprecated" .

