    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#BreakEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#IndustrialTalk> a owl:DeprecatedClass ;
    rdfs:label "Industrial Talk" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#TalkEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#IndustrialTrack> a owl:DeprecatedClass ;
    rdfs:label "Industrial Track" ;
    dcterms:subject <http://data.semanticweb.org/ns/swc/ontology#AcademicEvent> ;
    rdfs:comment "\\n\\t\\t\\t\\n\\t\\t\\tDeprecating this - we can just as well use <a href=\"#TrackEvent\">TrackEvent</a>.\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#TrackEvent> ;
    ns1:term_status "deprecated" .

<http://data.semanticweb.org/ns/swc/ontology#IndustryChair> a owl:DeprecatedClass ;
    rdfs:label "Industry Chair or In-Use Chair" ;
    dcterms:subject <http://dbpedia.org/resource/Chairman> ;
    rdfs:comment "\\n\\t\\t\\t<p>\\n\\t\\t\\t\\tDeprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.\\n\\t\\t\\t</p>\\n\\t\\t\\t\\n\\t\\t" ;
    rdfs:subClassOf <http://data.semanticweb.org/ns/swc/ontology#Role> ;
