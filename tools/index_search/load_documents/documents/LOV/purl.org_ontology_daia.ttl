@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2008/05/skos#> .
@prefix ns2: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:references rdfs:type rdfs:Property .

<http://purl.org/ontology/daia/> a owl:Ontology ;
    dcterms:description "The Document Availability Information Ontology (DAIA) describes the current availability of documents in libraries and similar institutions. Availability can be expressed in terms of specific services."@en ;
    dcterms:title "Document Availability Information Ontology (DAIA)" ;
    owl:versionInfo "Beta version 2011-12-15" .

<http://purl.org/ontology/daia/Service/Interloan> a owl:Class ;
    rdfs:label "interloan service"@en ;
    rdfs:comment "Use mediated by another institution."@en ;
    rdfs:subClassOf <http://purl.org/ontology/daia/Service> .

<http://purl.org/ontology/daia/Service/Loan> a owl:Class ;
    rdfs:label "loan service"@en ;
    rdfs:comment "Use outside of the holding institution (by lending or online access)"@en ;
    rdfs:subClassOf <http://purl.org/ontology/daia/Service> .

<http://purl.org/ontology/daia/Service/Openaccess> a owl:Class ;
    rdfs:label "open access service"@en ;
    rdfs:comment "can be accessed freely on the Web"@en ;
    rdfs:subClassOf <http://purl.org/ontology/daia/Service> ;
    ns1:scopeNote "this does not imply free reuse, for instance distribution and and modification. A specific license should be used for details."@en .

<http://purl.org/ontology/daia/Service/Presentation> a owl:Class ;
    rdfs:label "presentation service"@en ;
    rdfs:comment "Use within the holding institution (in their rooms, in their intranet etc.)"@en ;
    rdfs:subClassOf <http://purl.org/ontology/daia/Service> .

<http://purl.org/ontology/daia/Storage> a owl:Class ;
    rdfs:label "Storage"@en ;
    rdfs:comment "A place where instances of frbr:Item are stored."@en ;
    rdfs:seeAlso dcterms:title,
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>,
        foaf:name,
        foaf:page,
        foaf:primaryTopicOf ;
    rdfs:subClassOf dcterms:Location,
        org:Site ;
    ns1:ScopeNote "Most instances of this class are also dct:Location and geo:SpatialThing" ;
    ns1:scopeNote "A link to a page with more information about the storage can be added with foaf:page and foaf:primaryTopicOf. However there should be another property to express a link to a specific item at a specific storage."@en,
        "Physical items can be related to storages with geo:location. Most non-physical items have no locations but access services."@en,
        "The name or title of this location can be expressed with foaf:name and dct:title"@en .

<http://purl.org/ontology/daia/availableOf> a owl:ObjectProperty ;
    rdfs:label "available of"@en ;
    rdfs:comment "Relates an available Service to the Item which this Service refers to"@en ;
    rdfs:domain <http://purl.org/ontology/daia/Service> ;
    rdfs:range <http://purl.org/vocab/frbr/core#Item> ;
    owl:inverseOf <http://purl.org/ontology/daia/availableFor> .

<http://purl.org/ontology/daia/delay> a owl:DatatypeProperty ;
    rdfs:label "delay"@en ;
    rdfs:comment "A time period of estimated delay untill an available Service can be used. Applications should normalize all literal values not conforming to xsd:duration to 'unknown'"@en ;
    rdfs:domain <http://purl.org/ontology/daia/Service> .

<http://purl.org/ontology/daia/expected> a owl:DatatypeProperty ;
    rdfs:label "expected"@en ;
    rdfs:comment "If this property is given on an unavailable Service, it is assumed that the Service will be available at the specified time. Applications should normalize all literal values not conforming to xsd:date or xsd:dateTime to 'unknown'"@en ;
    rdfs:domain <http://purl.org/ontology/daia/Service> ;
    rdfs:seeAlso dcterms:available .

<http://purl.org/ontology/daia/label> a owl:DatatypeProperty ;
    rdfs:label "label"@en ;
    rdfs:comment "A call number, shelf mark or similar label of an item"@en ;
    rdfs:domain <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier .

<http://purl.org/ontology/daia/limitedBy> a owl:ObjectProperty ;
    rdfs:label "limited by"@en ;
    rdfs:comment "Relates an Service to a Limitation."@en ;
    rdfs:domain <http://purl.org/ontology/daia/Service> ;
    rdfs:range <http://purl.org/ontology/daia/Limitation> ;
    rdfs:seeAlso dcterms:coverage ;
    owl:inverseOf <http://purl.org/ontology/daia/limits> .

<http://purl.org/ontology/daia/perform> a owl:DatatypeProperty ;
    rdfs:label "perform"@en ;
    rdfs:comment "A link to perform, register or reserve a Service."@en ;
    rdfs:domain <http://purl.org/ontology/daia/Service> ;
    rdfs:range xsd:anyURI .

<http://purl.org/ontology/daia/queue> a owl:DatatypeProperty ;
    rdfs:label "queue"@en ;
    rdfs:comment "The number number of waiting requests for this service. If this property is not given, the value zero may be assumed but applications may also distinguish zero and no value."@en ;
    rdfs:domain <http://purl.org/ontology/daia/Service> ;
    rdfs:range xsd:nonNegativeInteger .

<http://purl.org/ontology/daia/timestamp> a owl:DatatypeProperty ;
    rdfs:label "timestamp"@en ;
    rdfs:comment "Date and time of a the validity of a Response"@en ;
    rdfs:domain <http://purl.org/ontology/daia/Response> ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso dcterms:available ;
    rdfs:subPropertyOf dcterms:valid .

<http://purl.org/ontology/daia/unavailableOf> a owl:ObjectProperty ;
    rdfs:label "available of"@en ;
    rdfs:comment "Relates a unavailable Service to the Item which this Service refers to"@en ;
    rdfs:domain <http://purl.org/ontology/daia/Service> ;
    rdfs:range <http://purl.org/vocab/frbr/core#Item> ;
    owl:inverseOf <http://purl.org/ontology/daia/availableFor> .

xsd:date a rdfs:Datatype .

xsd:duration a rdfs:Datatype .

<http://www.w3.org/2003/01/geo/wgs84_pos#location> a owl:ObjectProperty ;
    rdfs:comment "The relation between something and the point, or other geometrical thing in space, where it is."@en ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

ns2:moreinfo a owl:AnnotationProperty .

ns2:term_status a owl:AnnotationProperty .

ns1:changeNote a owl:AnnotationProperty .

ns1:editorialNote a owl:AnnotationProperty .

ns1:historyNote a owl:AnnotationProperty .

ns1:scopeNote a owl:AnnotationProperty .

dcterms:Location a owl:Class .

dcterms:identifier rdfs:type rdfs:Property .

dcterms:valid rdfs:type rdfs:Property .

<http://purl.org/ontology/daia/Response> a owl:Class ;
    rdfs:label "Response"@en ;
    rdfs:comment "A Respone contains information about document availability for a specific time and institution."@en ;
    rdfs:seeAlso dcterms:description ;
    ns2:term_status "stable" ;
    ns1:scopeNote "Messages can be added with dct:description."@en,
        "rdfs:seeAlso is used to link to documents and institutions."@en .

<http://purl.org/ontology/daia/heldBy> a owl:ObjectProperty ;
    rdfs:label "held by"@en ;
    rdfs:comment "Relates an Item to an Institution that holds the Item."@en ;
    rdfs:domain <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:range foaf:Organization ;
    rdfs:subPropertyOf <http://purl.org/ontology/daia/collectedBy> ;
    owl:inverseOf <http://purl.org/ontology/daia/holds> .

<http://purl.org/ontology/daia/holds> a owl:ObjectProperty ;
    rdfs:label "holds"@en ;
    rdfs:comment "Relates an Institution to an Item which the Institution holds."@en ;
    rdfs:domain foaf:Organization ;
    rdfs:range <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:subPropertyOf <http://purl.org/ontology/daia/inCollection> ;
    owl:inverseOf <http://purl.org/ontology/daia/heldBy> .

<http://purl.org/ontology/daia/limits> a owl:ObjectProperty ;
    rdfs:label "limits"@en ;
    rdfs:comment "Relates a Limitation to a Service."@en ;
    rdfs:domain <http://purl.org/ontology/daia/Limitation> ;
    rdfs:range <http://purl.org/ontology/daia/Service> .

<http://purl.org/ontology/daia/providedBy> a owl:ObjectProperty ;
    rdfs:label "provided by"@en ;
    rdfs:comment "Relates a Service to an Institution that provides the Service."@en ;
    rdfs:domain <http://purl.org/ontology/daia/Service> ;
    rdfs:range foaf:Organization ;
    owl:inverseOf <http://purl.org/ontology/daia/provides> .

<http://purl.org/ontology/daia/provides> a owl:ObjectProperty ;
    rdfs:label "provides"@en ;
    rdfs:comment "Relates an Institution to a Service that is provided by the Institution."@en ;
    rdfs:domain foaf:Organization ;
    rdfs:range <http://purl.org/ontology/daia/Service> ;
    owl:inverseOf <http://purl.org/ontology/daia/providedBy> .

<http://purl.org/ontology/daia/unavailableFor> a owl:ObjectProperty ;
    rdfs:label "not available for"@en ;
    rdfs:comment "Relates an Item to a Service which the Item is not available for. This property is disjoint with the available property; however an Item can be available and unavailable for two different Services of the same class at the same time."@en ;
    rdfs:domain <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:range <http://purl.org/ontology/daia/Service> .

xsd:dateTime a rdfs:Datatype .

xsd:nonNegativeInteger a rdfs:Datatype .

org:Organization a owl:Class ;
    owl:equivalentClass foaf:Organization .

dcterms:available rdfs:type rdfs:Property ;
    ns1:scopeNote "Date that a resource became or will become available. Applications may derive this property from daia:expected and/or daia:timestamp"@en .

dcterms:coverage rdfs:type rdfs:Property .

dcterms:hasPart rdfs:type rdfs:Property ;
    ns1:scopeNote "This property can be inferred from a daia:narrowerExemplar or daia:broaderExemplar property."@en .

<http://purl.org/ontology/daia/Limitation> a owl:Class ;
    rdfs:label "Limitation"@en ;
    rdfs:comment "A Limitation is something that limits the the availability of an Item."@en ;
    rdfs:seeAlso dcterms:description,
        dcterms:title,
        foaf:page,
        foaf:primaryTopicOf ;
    ns1:scopeNote "A description of the limitation can be added with dct:description."@en,
        "A link to a page with more information can be added with foaf:page and with foaf:primaryTopicOf"@en .

<http://purl.org/ontology/daia/availableFor> a owl:ObjectProperty ;
    rdfs:label "available for"@en ;
    rdfs:comment "Relates an Item to a Service which the Item is available for. This property is disjoint with the unavailable property; however an Item can be available and unavailable for two different Services of the same class at the same time."@en ;
    rdfs:domain <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:range <http://purl.org/ontology/daia/Service> ;
    owl:propertyDisjointWith <http://purl.org/ontology/daia/unavailableFor> .

<http://purl.org/ontology/daia/collectedBy> a owl:ObjectProperty ;
    rdfs:label "collected by"@en ;
    rdfs:comment "Relates a Document to an Institution which helds an iten of the Document."@en ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:range foaf:Organization ;
    rdfs:seeAlso dcmitype:Collection ;
    owl:inverseOf <http://purl.org/ontology/daia/inCollection> ;
    ns1:scopeNote "This property implies the existence of a dcmitype:Collection and a cdtype:CatalogueOrIndex that need not to be modeled explicitly."@en .

<http://purl.org/ontology/daia/inCollection> a owl:ObjectProperty ;
    rdfs:label "in collection"@en ;
    rdfs:comment "Relates an Institution to a Document which the Institution helds an item of."@en ;
    rdfs:domain foaf:Organization ;
    rdfs:range <http://purl.org/ontology/bibo/Document> ;
    rdfs:seeAlso dcmitype:Collection ;
    owl:inverseOf <http://purl.org/ontology/daia/collectedBy> ;
    ns1:scopeNote "This property implies the existence of a dcmitype:Collection and a cdtype:CatalogueOrIndex that need not to be modeled explicitly."@en .

<http://purl.org/ontology/daia/narrowerExemplar> a owl:ObjectProperty ;
    rdfs:label "narrower exemplar"@en,
        "narrower exemplar of"@en ;
    rdfs:comment "Relates a Document to an Item that is an exemplar of a part of the Document."@en,
        "Relates an Item to a Document which is partly exemplified by the Item."@en ;
    rdfs:domain <http://purl.org/ontology/bibo/Document>,
        <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:range <http://purl.org/ontology/bibo/Document>,
        <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:seeAlso dcterms:hasPart,
        <http://purl.org/ontology/daia/broaderExemplar>,
        <http://purl.org/ontology/daia/broaderExemplarOf>,
        <http://purl.org/ontology/daia/exemplar>,
        <http://purl.org/ontology/daia/exemplarOf> ;
    owl:inverseOf <http://purl.org/ontology/daia/narrowerExemplar>,
        <http://purl.org/ontology/daia/narrowerExemplarOf> ;
    ns1:scopeNote "{ ?d daia:narrowerExemplar ?i } => { ?d dct:hasPart [ daia:exemplar ?i ] }",
        "{ ?i daia:narrowerExemplarOf ?d } => { ?i daia:exemplarOf [ dct:isPartOf ?d ] }" .

<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a owl:Class .

foaf:Document a owl:Class .

<http://purl.org/ontology/daia/exemplar> a owl:ObjectProperty ;
    rdfs:label "has exemplar"@en ;
    rdfs:comment "Relates a Document to an Item that is an exemplar of the Document. This property is similar to frbr:exemplar but does not refer to the class frbr:Manifestation."@en ;
    rdfs:domain <http://purl.org/ontology/bibo/Document> ;
    rdfs:range <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:seeAlso <http://purl.org/ontology/daia/broaderExemplar>,
        <http://purl.org/ontology/daia/narrowerExemplar>,
        <http://purl.org/vocab/frbr/core#embodimentOf>,
        <http://purl.org/vocab/frbr/core#exemplarOf> ;
    owl:inverseOf <http://purl.org/ontology/daia/exemplarOf> .

<http://purl.org/ontology/daia/exemplarOf> a owl:ObjectProperty ;
    rdfs:label "is examplar of"@en ;
    rdfs:comment "Relates an Item to the Document that is exemplified by the Item."@en ;
    rdfs:domain <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:range <http://purl.org/ontology/bibo/Document> ;
    rdfs:seeAlso <http://purl.org/ontology/daia/broaderExemplarOf>,
        <http://purl.org/ontology/daia/narrowerExemplarOf>,
        <http://purl.org/vocab/frbr/core#embodiment>,
        <http://purl.org/vocab/frbr/core#exemplar> ;
    owl:inverseOf <http://purl.org/ontology/daia/exemplar> .

dcterms:title a owl:AnnotationProperty .

<http://purl.org/ontology/daia/broaderExemplar> a owl:ObjectProperty ;
    rdfs:label "broader exemplar"@en,
        "broader exemplar of"@en ;
    rdfs:comment "Relates a Document to an Item that contains an exemplar of the Document as part."@en,
        "Relates an Item to a Document which is partly exemplified by the Item."@en ;
    rdfs:domain <http://purl.org/ontology/bibo/Document>,
        <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:range <http://purl.org/ontology/bibo/Document>,
        <http://purl.org/vocab/frbr/core#Item> ;
    rdfs:seeAlso dcterms:hasPart,
        <http://purl.org/ontology/daia/broaderExemplar>,
        <http://purl.org/ontology/daia/broaderExemplarOf>,
        <http://purl.org/ontology/daia/exemplar>,
        <http://purl.org/ontology/daia/exemplarOf> ;
    owl:inverseOf <http://purl.org/ontology/daia/broaderExemplar>,
        <http://purl.org/ontology/daia/broaderExemplarOf> ;
    ns1:scopeNote "{ ?d daia:broaderExemplar ?i } => { ?i dct:hasPart [ daia:exemplarOf ?d ] }",
        "{ ?i daia:broaderExemplarOf ?d } => { ?i dct:hasPart [ daia:exemplarOf ?d ] }" .

foaf:page a rdfs:Property .

foaf:primaryTopicOf a rdfs:Property .

dcterms:description a owl:AnnotationProperty ;
    rdfs:type rdfs:Property .

foaf:Organization a owl:Class ;
    rdfs:comment "Used for any kind of organization such as a library or a company, both Institution and Department."@en ;
    rdfs:seeAlso dcterms:title,
        foaf:page,
        foaf:primaryTopicOf ;
    owl:equivalentClass org:Organization ;
    ns1:scopeNote "A link to a page with more information can be added with foaf:page and with foaf:primaryTopicOf."@en,
        "A name or title can be expressed with dct:title"@en .

<http://purl.org/ontology/bibo/Document> a owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:comment "A Document"@en ;
    rdfs:seeAlso dcterms:description,
        dcterms:title,
        foaf:page,
        foaf:primaryTopicOf ;
    owl:equivalentClass foaf:Document ;
    ns1:scopeNote "A link to a document about the document can be added with foaf:page and with foaf:primaryTopicOf."@en,
        "A name or title can be expressed with dct:title"@en,
        "Messages can be added with dct:description."@en .

<http://purl.org/vocab/frbr/core#Item> a owl:Class ;
    rdfs:comment "An Item is a single instance of a Document. Availability information is directly connected to single items."@en,
        "Every Item is also a document (frbr:Item rdfs:subClassOf bibo:Document."@en ;
    rdfs:seeAlso dcterms:description ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document>,
        foaf:Document ;
    ns1:scopeNote "Messages can be added with dct:description."@en .

<http://purl.org/ontology/daia/Service> a owl:Class ;
    rdfs:label "Service"@en ;
    rdfs:comment "A Service is something that is provided by an Institution, typically related to an Item, for instance the service of loaning the Item."@en ;
    rdfs:seeAlso dcterms:coverage,
        dcterms:description ;
    rdfs:subClassOf dcmitype:Service ;
    ns1:scopeNote "Do not mix types of services (like 'loaning'), which are subclasses of Service, and specific instances of services (like loaning a particular book)!"@en,
        "Messages can be added with dct:description."@en,
        "The property dct:coverage may be used to refer to a scope of this service - but this is outside of the core purpose of DAIA"@en .

