@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://dati.cdec.it/lod/shoah/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    ns1:license <https://creativecommons.org/licenses/by/4.0/> ;
    dc:creator "Laura Brazzo" ;
    dc:description "The ontology describing the Shoah domain, proposed here in beta version, aims to formally describe concepts and relationships that characterize the process of persecution and deportation of Jews in Italy between 1943 and 1945."@en ;
    dcterms:creator onto:www.cdec.it,
        onto:www.regesta.com,
        <https://plus.google.com/+silviamazzini_lod/> ;
    dcterms:issued "2014-01-01"^^xsd:date ;
    vann:preferredNamespacePrefix "shoah" ;
    vann:preferredNamespaceUri "http://dati.cdec.it/lod/shoah/" ;
    owl:imports <http://purl.org/vocab/bio/0.1/>,
        foaf: ;
    owl:versionIRI onto:0.1 ;
    owl:versionInfo "beta version"^^xsd:string .

onto:arrestDate a owl:DatatypeProperty ;
    rdfs:label "Arrest Date"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range xsd:string .

onto:arrestPlace a owl:ObjectProperty ;
    rdfs:label "Arrest Place"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range onto:Place .

onto:arrestedBy a owl:DatatypeProperty ;
    rdfs:label "Arrested By"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range xsd:string .

onto:arrivalDate a owl:DatatypeProperty ;
    rdfs:label "Arrival Date"@en ;
    rdfs:domain onto:Convoy .

onto:auntOf a owl:ObjectProperty ;
    rdfs:label "Aunt of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:brotherOf a owl:ObjectProperty ;
    rdfs:label "Brother of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:campSerialNumber a owl:DatatypeProperty ;
    rdfs:label "Camp Serial Number"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range xsd:string .

onto:consortFamilyName a owl:DatatypeProperty ;
    rdfs:label "Consort Family Name"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto:consortFirstName a owl:DatatypeProperty ;
    rdfs:label "Consort First Name"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto:consortOf a owl:ObjectProperty ;
    rdfs:label "Consort of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:consortReligion a owl:DatatypeProperty ;
    rdfs:label "Consort Religion"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto:convoy a owl:ObjectProperty ;
    rdfs:label "Convoy"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range onto:Convoy .

onto:convoyDeparturePlace a owl:ObjectProperty ;
    rdfs:label "Last Place before Deportation"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range onto:DetentionPlace .

onto:convoyNumber a owl:DatatypeProperty ;
    rdfs:label "Convoy Number"@en ;
    rdfs:domain onto:Persecution .

onto:country a owl:DatatypeProperty ;
    rdfs:label "Country"@en ;
    rdfs:domain onto:Place ;
    rdfs:range xsd:string .

onto:dateOfBirth a owl:DatatypeProperty ;
    rdfs:label "Date of Birth"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:dateTime .

onto:dateOfDeath a owl:DatatypeProperty ;
    rdfs:label "Date of Death"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:dateTime .

onto:deathDescription a owl:DatatypeProperty ;
    rdfs:label "Death Description"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto:deathInItaly a owl:DatatypeProperty ;
    rdfs:label "Death in Italy"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range xsd:boolean .

onto:departureDate a owl:DatatypeProperty ;
    rdfs:label "Departure Date"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range xsd:dateTime .

onto:detentionPlace a owl:ObjectProperty ;
    rdfs:label "Detention Place"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range onto:DetentionPlace .

onto:detentionPlaceTransfer a owl:ObjectProperty ;
    rdfs:label "Detention Place Transfer"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range onto:DetentionPlaceTransfer .

onto:districtOfResidence a owl:DatatypeProperty ;
    rdfs:label "District of Residence"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto:fatherName a owl:DatatypeProperty ;
    rdfs:label "Father Name"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto:fatherOf a owl:ObjectProperty ;
    rdfs:label "Father of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:fromNaziCamp a owl:ObjectProperty ;
    rdfs:label "from Camp"@en ;
    rdfs:domain onto:NaziCampTransfer ;
    rdfs:range onto:NaziCamp .

onto:fromPrison a owl:ObjectProperty ;
    rdfs:label "from Prison"@en ;
    rdfs:domain onto:DetentionPlaceTransfer ;
    rdfs:range onto:DetentionPlace .

onto:grandfatherOf a owl:ObjectProperty ;
    rdfs:label "Grandfather of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:grandmotherOf a owl:ObjectProperty ;
    rdfs:label "Grandmother of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:liberation a owl:ObjectProperty ;
    rdfs:label "Liberation"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range onto:Liberation .

onto:liberationDate a owl:DatatypeProperty ;
    rdfs:label "Liberation Date"@en ;
    rdfs:domain onto:Liberation ;
    rdfs:range xsd:dateTime .

onto:massacre a owl:ObjectProperty ;
    rdfs:label "Massacre in Italy"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range onto:Massacre .

onto:motherMaidenName a owl:DatatypeProperty ;
    rdfs:label "Mother Maiden Name"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto:motherName a owl:DatatypeProperty ;
    rdfs:label "Mother Name"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto:motherOf a owl:ObjectProperty ;
    rdfs:label "Mother of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:naziCampTransfer a owl:ObjectProperty ;
    rdfs:label "Nazi Camp Transfer"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range onto:NaziCampTransfer .

onto:parentPlace a owl:DatatypeProperty ;
    rdfs:label "Parent Place"@en ;
    rdfs:domain onto:Place ;
    rdfs:range xsd:string .

onto:parentReligion a owl:DatatypeProperty ;
    rdfs:label "Parent Religion"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

onto:persecution a owl:ObjectProperty ;
    rdfs:label "Persecution"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range onto:Persecution .

onto:persecutionCategory a owl:DatatypeProperty ;
    rdfs:label "Reason of Deportation"@en ;
    rdfs:domain onto:Persecution ;
    rdfs:range xsd:dateTime .

onto:placeOfBirth a owl:ObjectProperty ;
    rdfs:label "Place of Birth"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range onto:Place .

onto:placeOfDeath a owl:ObjectProperty ;
    rdfs:label "Place of Death"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range onto:Place .

onto:returnDate a owl:DatatypeProperty ;
    rdfs:label "Return Date"@en ;
    rdfs:domain onto:Liberation ;
    rdfs:range xsd:dateTime .

onto:returnPlace a owl:DatatypeProperty ;
    rdfs:label "Return Place"@en ;
    rdfs:domain onto:Liberation ;
    rdfs:range xsd:string .

onto:shoahSurvivor a owl:DatatypeProperty ;
    rdfs:label "Shoah Survivor"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:boolean .

onto:sisterOf a owl:ObjectProperty ;
    rdfs:label "Sister of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:subCampOf a owl:ObjectProperty ;
    rdfs:label "Sub Camp of"@en ;
    rdfs:domain onto:NaziCamp ;
    rdfs:range onto:NaziCamp .

onto:toNaziCamp a owl:ObjectProperty ;
    rdfs:label "to Camp"@en ;
    rdfs:domain onto:NaziCampTransfer,
        onto:Persecution ;
    rdfs:range onto:NaziCamp .

onto:toPrison a owl:ObjectProperty ;
    rdfs:label "to Prison"@en ;
    rdfs:domain onto:DetentionPlaceTransfer ;
    rdfs:range onto:DetentionPlace .

onto:transferDate a owl:DatatypeProperty ;
    rdfs:label "Transfer Date"@en ;
    rdfs:domain onto:NaziCampTransfer ;
    rdfs:range xsd:string .

onto:uncleOf a owl:ObjectProperty ;
    rdfs:label "Uncle of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:widowOf a owl:ObjectProperty ;
    rdfs:label "Widow of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:widowerOf a owl:ObjectProperty ;
    rdfs:label "Widower of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

onto:Massacre a owl:Class ;
    rdfs:label "Massacre"@en .

onto:Convoy a owl:Class ;
    rdfs:label "Convoy"@en .

onto:DetentionPlaceTransfer a owl:Class ;
    rdfs:label "Detention Place Transfer"@en .

onto:DetentionPlace a owl:Class ;
    rdfs:label "Detention Place"@en .

onto:Liberation a owl:Class ;
    rdfs:label "Liberation"@en .

onto:NaziCamp a owl:Class ;
    rdfs:label "Nazi Camp"@en .

onto:NaziCampTransfer a owl:Class ;
    rdfs:label "Nazi Camp Transfer"@en .

onto:Place a owl:Class ;
    rdfs:label "Place"@en .

onto:Persecution a owl:Class ;
    rdfs:label "Persecution"@en .

