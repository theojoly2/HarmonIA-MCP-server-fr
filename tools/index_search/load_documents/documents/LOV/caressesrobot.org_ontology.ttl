    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Robot> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasRoom> a owl:ObjectProperty ;
    rdfs:label "hasRoom"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Room> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasLocation> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasSkype> a owl:DatatypeProperty ;
    rdfs:label "hasSkype"@en ;
    rdfs:comment "Skype account of user contacts"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasSong> a owl:ObjectProperty ;
    rdfs:label "hasSong"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Song> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasObject> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasSpecific> a owl:ObjectProperty ;
    rdfs:label "hasSpecific"@en ;
    rdfs:comment "Instances, belonging to the Person-Specific ABox layer, are fillers of the corresponding instances in the Culture-Specific ABox layer for the hasSpecific property,"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Topic> ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topObjectProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasSpeed> a owl:ObjectProperty ;
    rdfs:label "hasSpeed"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Action> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Speed> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasCParameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasSportsPlayer> a owl:ObjectProperty ;
    rdfs:label "hasSportsPlayer"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#SportsPlayer> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasPerson> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasStatus> a owl:DatatypeProperty ;
    rdfs:label "hasStatus"@en ;
    rdfs:comment "Possible status of the smart device"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#SmartDevice> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasSuggestion> a owl:ObjectProperty ;
    rdfs:label "hasSuggestion"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Action> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Topic> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasCParameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasTablet-view> a owl:DatatypeProperty ;
    rdfs:label "hasTablet-view"@en ;
    rdfs:comment "Confirmation to be shown on the robot's tablet"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Goal> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasTelegram> a owl:DatatypeProperty ;
    rdfs:label "hasTelegram"@en ;
    rdfs:comment "Telegram account of user's contact accounts"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasType> a owl:DatatypeProperty ;
    rdfs:label "hasType"@en ;
    rdfs:comment "Type of the smart devices (device - sensor)"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#SmartDevice> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasUDDL> a owl:DatatypeProperty ;
    rdfs:label "hasUDDL"@en ;
    rdfs:comment "UDDL file describing the operator"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Operator> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasUrl-article> a owl:DatatypeProperty ;
    rdfs:label "hasUrl-article"@en ;
    rdfs:comment "Webpage for the ReadNewsAction"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#TVChannel> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasUrl-root> a owl:DatatypeProperty ;
    rdfs:label "hasUrl-root"@en ;
    rdfs:comment "Webpage for the readnews action"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#TVChannel> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasUserName> a owl:ObjectProperty ;
    rdfs:label "hasUserName"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Action> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Addressing> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasCParameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasValue> a owl:DatatypeProperty ;
    rdfs:label "hasValue"@en ;
    rdfs:comment "String value for handling triggering and necessary conditions"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasWaitingTime> a owl:ObjectProperty ;
    rdfs:label "hasWaitingTime"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Action> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#WaitingTime> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasCParameter> ;
    ns1:term_status "stable"@en .

<http://w3.org/2001/XMLSchema#decimal> a rdfs:Datatype .

<http://caressesrobot.org/ontology#Actor> a owl:Class ;
    rdfs:label "Actor"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#PublicPerson>,
        <http://caressesrobot.org/ontology#TopicOneCanHavePreferenceAbout> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Clothing> a owl:Class ;
    rdfs:label "Clothing"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Object> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Family> a owl:Class ;
    rdfs:label "Family"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasRelatLocation> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#RelativeLocation> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasRelative> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Relative> ],
        <http://caressesrobot.org/ontology#SocialEnvironment> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Food> a owl:Class ;
    rdfs:label onto:,
        "Food"@en ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#FoodAndDrink>,
        <http://caressesrobot.org/ontology#TopicOneCanHavePreferenceAbout> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#FoodAndDrink> a owl:Class ;
    rdfs:label "FoodAndDrink"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Object> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Friend> a owl:Class ;
    rdfs:label "Friend"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Person> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Game> a owl:Class ;
    rdfs:label "Game"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Object> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Home> a owl:Class ;
    rdfs:label "Home"@en ;
    rdfs:comment "The building where one lives. Examples of SubClasses are Apartment, CareHome (for the specific case of older adults to which the CARESSES Ontology is addressed)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasIn> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Room> ],
        <http://caressesrobot.org/ontology#Location> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Language> a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:comment "Parameter related to the language in which the sentences are written"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Parameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Manner> a owl:Class ;
    rdfs:label onto:,
        "Manner"@en ;
    rdfs:comment "Definitions of polite or acceptable social behaviours. They may be chosen accordingly to the specific targets (i.e. older adults) and cultural identities. Examples of SubClasses are GivingPresentsToRelativeOrFriend, StackingDishesAfterMeal, ..."@en ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Norm> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Medication> a owl:Class ;
    rdfs:label "Medication"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Object> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Message> a owl:Class ;
    rdfs:label "Message"@en ;
    rdfs:comment "Messages encoded for the SendMsgAction"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasCompulsory-recipient> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasMessage> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://caressesrobot.org/ontology#Parameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Music> a owl:Class ;
    rdfs:label "Music"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasSong> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Song> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasPerson> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Singer> ],
        <http://caressesrobot.org/ontology#ArtObject>,
        <http://caressesrobot.org/ontology#TopicOneCanHavePreferenceAbout> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Operator> a owl:Class ;
    rdfs:label "Operator"@en ;
    rdfs:comment "This class includes all Operators that should  be sent to the planner for the execution of actions. Operators achieve Goals by implementing Actions"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://caressesrobot.org/ontology#Goal> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasGoal> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasAction> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Action> ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasUDDL> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#PeriodOfTheDay> a owl:Class ;
    rdfs:label "PeriodOfTheDay"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Time> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Pet> a owl:Class ;
    rdfs:label "Pet"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Object>,
        <http://caressesrobot.org/ontology#TopicOneCanHavePreferenceAbout> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Pitch> a owl:Class ;
    rdfs:label "Pitch"@en ;
    rdfs:comment "Voice pitch for all actions involving verbal interaction"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Parameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Proxemics> a owl:Class ;
    rdfs:label "Proxemics"@en ;
    rdfs:comment "Distance parameter for the ApproachUser action"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Parameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Quality> a owl:Class ;
    rdfs:label "Quality"@en ;
    rdfs:comment "Basic entities to perceive or measure: shapes, colors, sizes, sounds, smells,..."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#RelativeLocation> a owl:Class ;
    rdfs:label "RelativeLocation"@en ;
    rdfs:comment "The position of something expressed in relative terms (e.g. Close, Far, VeryFar, ... )"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Location> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Religion> a owl:Class ;
    rdfs:label "Religion"@en ;
    rdfs:comment "Individuals of this class may be filled with Individuals of the class FoodNorm for the ObjectProperty hasNorm; thus, known the user's religion, the robot would probably investigate aspects related to possible alimentary restrictions\\n\\nIndividuals of this class may be filled with Individuals of the class ReligiousCulturalEvent for the ObjectProperty hasEvent; thus, known the user's religion, the robot would probably talk about related religious festivities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasEvent> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#ReligiousCulturalEvent> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasNorm> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#FoodNorm> ],
        <http://caressesrobot.org/ontology#BeliefSystem> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Robot> a owl:Class ;
    rdfs:label "Robot"@en ;
    rdfs:comment "The user's robot . An instance of the class Robot may be connected with instances of the class Goal, in order to encode all goals that may be achieved by the robot"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasGoal> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Goal> ],
        <http://caressesrobot.org/ontology#Object> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Singer> a owl:Class ;
    rdfs:label "Singer"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#PublicPerson> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Song> a owl:Class ;
    rdfs:label "Song"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasPerson> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Singer> ],
        <http://caressesrobot.org/ontology#ArtObject> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Speed> a owl:Class ;
    rdfs:label "Speed"@en ;
    rdfs:comment "Voice speed for all actions involving verbal interaction"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Parameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#SportsPlayer> a owl:Class ;
    rdfs:label "SportsPlayer"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#PublicPerson>,
        <http://caressesrobot.org/ontology#TopicOneCanHavePreferenceAbout> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#TVChannel> a owl:Class ;
    rdfs:label "TVChannel"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasUrl-article> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasUrl-root> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://caressesrobot.org/ontology#Object> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#WaitingTime> a owl:Class ;
    rdfs:label "WaitingTime"@en ;
    rdfs:comment "Waiting Time parameter for the AcceptRequest Action"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Parameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasAdjacent> a owl:ObjectProperty ;
    rdfs:label "hasAdjacent"@en ;
    rdfs:comment "Relationship of closeness between Objects and/or Locations"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Topic> ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topObjectProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasBeliefAndValue> a owl:ObjectProperty ;
    rdfs:label "hasBeliefAndValue"@en ;
    rdfs:comment "ObjectProperty used for let the robot talk about user's beliefs and values"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#BeliefSystem> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasCoordinates> a owl:DatatypeProperty ;
    rdfs:label "hasCoordinates"@en ;
    rdfs:comment "Coordinates of objects in the environment"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#HouseObject> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasCountry> a owl:ObjectProperty ;
    rdfs:label "hasCountry"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Country> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasLocation> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasFeeling> a owl:ObjectProperty ;
    rdfs:label "hasFeeling"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#PhysicalAndMentalCondition> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasPhysicalAndMentalState> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasGoal> a owl:ObjectProperty ;
    rdfs:label "hasGoal"@en ;
    rdfs:comment "ObjectProperty used for let the robot talk about possible activities"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Goal> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> .

<http://caressesrobot.org/ontology#hasHabit> a owl:ObjectProperty ;
    rdfs:label "hasHabit"@en ;
    rdfs:comment "ObjectProperty used for let the robot talk about user's regular / periodical activities"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Habit> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasNorm> a owl:ObjectProperty ;
    rdfs:label "hasNorm"@en ;
    rdfs:comment "ObjectProperty used for let the robot talk about social norms"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Norm> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasRelative> a owl:ObjectProperty ;
    rdfs:label "hasRelative"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Relative> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasPerson> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasSocialEnvironment> a owl:ObjectProperty ;
    rdfs:label "hasSocialEnvironment"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#SocialEnvironment> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasTown> a owl:ObjectProperty ;
    rdfs:label "hasTown"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Town> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasLocation> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Country> a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "A nation with its own government"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasTown> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Town> ],
        <http://caressesrobot.org/ontology#Location> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#HavingHealthProblems> a owl:Class ;
    rdfs:label "HavingHealthProblems"@en ;
    rdfs:comment "The condition of having health problems can be related to medicines taken by the user"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasMedicine> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Medication> ],
        <http://caressesrobot.org/ontology#PhysicalAndMentalCondition> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Town> a owl:Class ;
    rdfs:label "Town"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://caressesrobot.org/ontology#Country> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasCountry> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://caressesrobot.org/ontology#Location> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#YearlyEvent> a owl:Class ;
    rdfs:label "YearlyEvent"@en ;
    rdfs:comment "Any event that takes place regularly every year"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Event> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasPhysicalAndMentalState> a owl:ObjectProperty ;
    rdfs:label "hasPhysicalAndMentalState"@en ;
    rdfs:comment "ObjectProperty used for let the robot talk about the physical and mental state of the user"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#PhysicalAndMentalCondition> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Addressing> a owl:Class ;
    rdfs:label "Addressing"@en ;
    rdfs:comment "Possible ways to address the user. In the context of the verbal interaction between the robot and the user, this conversation topic will be probably selected among the firsts (this is implemented by the ObjectProperty hasTriggeringCondition). Examples of subclasses may be: FirstName, MrLastName, MrsLastName, Nickname, ...\\n\\nThe DataProperty hasNameforPlanner describes how the robot should actually address the person, and its value is usually encoded in a User-Specific Individual (E.g. for the class FirstName, the DataProperty hasNameforPlanner will include the actual first name of the user)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://caressesrobot.org/ontology#Event> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasCondition> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasNameforPlanner> ;
            owl:someValuesFrom <http://w3.org/2001/XMLSchema#string> ],
        <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#BeliefSystem> a owl:Class ;
    rdfs:label "BeliefSystem"@en ;
    rdfs:comment "Ideology or set of principles. It is mainly intended in the form of religion.\\n\\nIndividuals of this class may be related to Individuals of the class ReligiousCulturalEvent; thus, known the user's religion, the robot would probably talk about related religious festivities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasEvent> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Event> ],
        <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Norm> a owl:Class ;
    rdfs:label "Norm"@en ;
    rdfs:comment "Guidelines about what is considered correct or incorrect speaking of social behavior in a particular group, social unit or cultural identities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#PublicPerson> a owl:Class ;
    rdfs:label "PublicPerson"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Person> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Relative> a owl:Class ;
    rdfs:label "Relative"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Person> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Room> a owl:Class ;
    rdfs:label "Room"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasIn> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#HouseObject> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasAdjacent> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Room> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasIn> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Object> ],
        <http://caressesrobot.org/ontology#Location> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#SocialEnvironment> a owl:Class ;
    rdfs:label "SocialEnvironment"@en ;
    rdfs:comment "Social relationships that influence the user's life (friends, family, ...)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasCondition> a owl:ObjectProperty ;
    rdfs:label "hasCondition"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Topic> ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topObjectProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasCorrelation> a owl:ObjectProperty ;
    rdfs:label "hasCorrelation"@en ;
    rdfs:comment "Correlations between Individuals, even belonging to different Classes. An HCorrelation implies that, if a UserSpecific instances with an high DataProperty HasLikeliness value is added, the hasLiklelines of the other individuals should be increased. A VLCorrelation impliease that if a UserSpecific instances with an high DataProperty HasLikeliness value is added, the hasLiklelines of the other individuals should be decreased."^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Topic> ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topObjectProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasIn> a owl:ObjectProperty ;
    rdfs:label "hasIn"@en ;
    rdfs:comment "Inclusion relationship between Objects and/or Location"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Topic> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasAdjacent>,
        <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasTime> a owl:ObjectProperty ;
    rdfs:label "hasTime"@en ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Time> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#ArtObject> a owl:Class ;
    rdfs:label "ArtObject"@en ;
    rdfs:comment "An abstract or physical object considered to fulfill a primarily independent aesthetic function."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Object> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#SmartDevice> a owl:Class ;
    rdfs:label "SmartDevice"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasAs-sensor> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasStatus> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasOperations> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasLocations> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://caressesrobot.org/ontology#HouseObject> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasEvent> a owl:ObjectProperty ;
    rdfs:label "hasEvent"@en ;
    rdfs:comment "ObjectProperty used for let the robot talk about events relevant for the user's life"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Event> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Goal> a owl:Class ;
    rdfs:label "Goal"@en ;
    rdfs:comment "The DataProperty hasPDDL encode the related string, in PDDL formalism, that should be sent to the planner when the goal is required"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2000/01/rdf-schema#Literal> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasQuestion-t> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2000/01/rdf-schema#Literal> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasPDDL> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2000/01/rdf-schema#Literal> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasTablet-view> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://caressesrobot.org/ontology#Parameter> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Habit> a owl:Class ;
    rdfs:label "Habit"@en ;
    rdfs:comment "Activities, routines or behaviors that are regularly repeated by the user.\\n\\nIndividuals of this class may be filled with Individuals to the class Time for the ObjectProperty hasCondition (conversation topics may be triggered in some specific period of the day) or hasTime (the robot may investigate if habits take place in specific times of the day)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasTime> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Time> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasCondition> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Time> ],
        <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#TopicAboutOnesLife> a owl:Class ;
    rdfs:label "TopicAboutOnesLife"@en ;
    rdfs:comment "Relevant facts for the user's past and present life (chilldhood, education, heritage, work, ...)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://w3.org/2000/01/rdf-schema#Literal> a rdfs:Datatype .

<http://caressesrobot.org/ontology#PhysicalAndMentalCondition> a owl:Class ;
    rdfs:label "PhysicalAndMentalCondition"@en ;
    rdfs:comment "The condition or state of the body or mind"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#PhysicalEnvironment> a owl:Class ;
    rdfs:label "PhysicalEnvironment"@en ;
    rdfs:comment "All tangible space regiones that support and influence the user's life"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Location> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasLocation> a owl:ObjectProperty ;
    rdfs:label "hasLocation"@en ;
    rdfs:comment "ObjectProperty used for let the robot talk about places that are relevant for the user"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Location> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasPerson> a owl:ObjectProperty ;
    rdfs:label "hasPerson"@en ;
    rdfs:comment "ObjectProperty used for let the robot talk about persons relevant for the user's life"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Person> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Time> a owl:Class ;
    rdfs:label "Time"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasCParameter> a owl:ObjectProperty ;
    rdfs:label "hasCParameter"@en ;
    rdfs:comment "Cultural Parameters to be associated to Actions"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Action> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Topic> ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topObjectProperty> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#HouseObject> a owl:Class ;
    rdfs:label "HouseObject"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasPrep-object> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasCoordinates> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://caressesrobot.org/ontology#Object> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Location> a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "A physical space or region, defined by geographical coordinates (absolute location) or expressed in relative terms (relative location)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasObject> a owl:ObjectProperty ;
    rdfs:label "hasObject"@en ;
    rdfs:comment "Relationships between User and Objects"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Topic> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasTopic> ;
    ns1:term_status "stable"@en .

<http://w3.org/2002/07/owl#topObjectProperty> a owl:ObjectProperty .

<http://caressesrobot.org/ontology#Event> a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "A thing that has happened, or that takes place with regularity, independently from the user's activity"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Person> a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "Persons in the social, physical and cultural environemnt of the user"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasSkype> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasPhone> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasEmail> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasLine> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasTelegram> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Parameter> a owl:Class ;
    rdfs:label "Parameter"@en ;
    rdfs:comment "Parameters associated to actions"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#TopicOneCanHavePreferenceAbout> a owl:Class ;
    rdfs:label "TopicOneCanHavePreferenceAbout"@en ;
    rdfs:comment "All things that may be expressed in terms of \"preference\" (e.g. what is your favourite ... ?)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Object> a owl:Class ;
    rdfs:label onto:,
        "Object"@en ;
    rdfs:comment "Abstracts objects, with no physical referents and that does not exist at any particular time or place, and concrete objects"@en ;
    rdfs:subClassOf <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#Action> a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "Actions that may be executed by the robot. Actions are associate to parameters (Volume, Pitch, Speed, Language), to the username (Name), to the Suggestions (Topic)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasSpeed> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Speed> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasWaitingTime> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#WaitingTime> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasUserName> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Addressing> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasDistance> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Proxemics> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasConfFile1> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Topic> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasCParameter> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Parameter> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasLanguage> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Language> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasSuggestion> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Topic> ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2000/01/rdf-schema#Literal> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasConfirmation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2000/01/rdf-schema#Literal> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasConfFile1Name> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasPitch> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Pitch> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasConfFile2> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Topic> ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2000/01/rdf-schema#Literal> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasConfFile2Name> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://caressesrobot.org/ontology#Topic> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasTopic> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "hasTopic"@en ;
    rdfs:comment "All object properties that allow the robot to talk about conversation topics"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
    rdfs:domain <http://caressesrobot.org/ontology#Topic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#Topic> ;
    rdfs:subPropertyOf <http://w3.org/2002/07/owl#topObjectProperty> ;
    ns1:term_status "stable"@en .

<http://w3.org/2001/XMLSchema#string> a rdfs:Datatype .

<http://w3.org/2002/07/owl#topDataProperty> a owl:DatatypeProperty .

<http://caressesrobot.org/ontology#Topic> a owl:Class ;
    rdfs:label "Topic"@en ;
    rdfs:comment "Conversation topics that may be explored by the robot.\\n\\nConversation topics are defined by a set of DataProperties:\\n- hasLikeliness (it reflects the probability that the user will have a positive attitude towards that topic, given his cultural identity (if the instance belong to the Culture-Specific ABox), or given the evidence collected through the interaction with the user (if the instance belong to the Person-Specific ABox).\\n- hasQuestion (encoded sentences used by the robot to ask the general user's feeback about the topic)\\n- hasQuestionContextual (encoded sentences used by the robot to ask the user's feedback related to the specific context)\\n- hasQuestionGoal (encoded sentences used by the robot to ask the user about activities to be performed)\\n- has PositiveSentence (encoded sentences used by the robot when a positive feedback is received)\\n- has PositiveAndWait (encoded sentences used by the robot when a positive feedback is received. With these sentences, the robot invites the user to freely talk about a conversation topic)\\n- hasNegativeSentence (encoded sentences used by the robot when a negative feedback is received)\\n- hasKeyword1 & hasKeyword2 (keywords that may trigger a conversation topic)\\n\\nCulture-specific instances of subclasses of Topic may be filled with Person-specific instances for the hasSpecific ObjectProperty"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasValue> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasKeyword2> ;
            owl:someValuesFrom <http://w3.org/2001/XMLSchema#string> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasSpecific> ;
            owl:someValuesFrom <http://caressesrobot.org/ontology#Topic> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasName> ;
            owl:someValuesFrom <http://w3.org/2001/XMLSchema#string> ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasKeyword1> ;
            owl:someValuesFrom <http://w3.org/2001/XMLSchema#string> ],
        [ a owl:Restriction ;
            owl:onDataRange <http://w3.org/2001/XMLSchema#string> ;
            owl:onProperty <http://caressesrobot.org/ontology#hasFull> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <http://caressesrobot.org/ontology#hasLikeliness> ;
            owl:someValuesFrom <http://w3.org/2001/XMLSchema#decimal> ],
        <http://caressesrobot.org/ontology#Entity> ;
    ns1:term_status "stable"@en .

onto: a owl:Ontology ;
    rdfs:label "CARESSES Ontology"@en ;
    ns2:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "Antonio Sgorbissa (University of Genova)",
        "Barbara Bruno (University of Genova)",
        "Carmine Recchiuto (University of Genova)",
        "Christina Kouloglioti (Middlesex University)",
        "Hiroko Kamide (Nagoya University)",
        "Irena Papadopoulos (Middlesex University)" ;
    dcterms:description "The CARESSES Ontology encodes guidelines defined by experts in Transcultural Nursing, with the aim of offering a specific tool for endowing social assistive robots (assisting older adults) with cultural competence."@en ;
    dcterms:issued "2019-06-10"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dcterms:modified "2019-06-17"^^xsd:date ;
    dcterms:rights "Copyright © 2019 CARESSES Consortium" ;
    dcterms:title "CARESSES Ontology"@en ;
    vann:preferredNamespacePrefix "caresses" ;
    vann:preferredNamespaceUri "http://caressesrobot.org/ontology#" ;
    rdfs:comment "As part of a joint effort towards the development of a culturally competent robot for elderly care, experts in Transcultural Nursing have led the development of guidelines defining the behaviour and functionalities of a culturally competent robot for older people, linking cultural knowledge and perceptual information to actions and utterances. These guidelines have an impact upon the following main areas:\\n\\n- Goals. The user always has the last word in choosing what the robot should do for her. However, the robot might proactively make suggestions, and some of them might depend on cultural factors. What activity should the robot suggest the user to engage in before lunch? Cooking - and what menu?, praying - and how? What will the user most likely want to be reminded of? Social or cultural events - and which ones? TV shows?\\n- Actions and their parameters. Different cultures may use different actions to convey the same concept. How should the robot greet the user? Waving, bowing, or with a Namaste? What volume would the user be comfortable with? What distance while interacting? \\n- Norms. Behaviours which are common in one culture might be unacceptable in others. Are there areas of the house that should be off-limits for the robot? Does the answer depend on the time of the day? What is the user likely to consider as private?\\n- Topics of conversation.  Different cultures might have different histories, customs and traditions, which influence the lifestyle of people. What are the topics a user might like to talk about? Is she interested in sports, movies, politics or social activities? And if so, which sports, which types of movies could the robot suggest? Topics of conversation are also those activities in which the robot might assist the user, independently from any physical assistance it might also provide. Could the user be interested in discussing pizza toppings? Could this motivate her to bake a pizza herself? Or to call her friends for an evening out?\\n\\nThe CARESSES Ontology encodes all these guidelines, with the aim of offering a specific tool for endowing robots with cultural competence. In particular, this Ontology may be used to:\\n\\n- provide suitable Goals, Operators, Actions and Parameters to the planner\\n- handle the verbal interaction between the robot and the user, in a cultural competent way.\\n- store user-specific information, that makes the robot attune its behaviour towards the assisted person’s preferences and needs.\\n\\nPlease refer to the following for additional information:\\n- http://caressesrobot.org, CARESSES project website;\\n- Bruno, B., Menicatti, R., Recchiuto, C. T., Lagrue, E., Pandey, A. K., & Sgorbissa, A. (2018, June). Culturally-Competent Human-Robot Verbal Interaction. In 2018 15th International Conference on Ubiquitous Robots (UR) (pp. 388-395). IEEE.\\n- Sgorbissa, A., Papadopoulos, I., Bruno, B., Koulouglioti, C., & Recchiuto, C. (2018, October). Encoding guidelines for a culturally competent robot for elderly care</a> . In 2018 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS) (pp. 1988-1995). IEEE.\\n- Bruno, B., Recchiuto, C. T., Papadopoulos, I., Saffiotti, A., Koulouglioti, C., Menicatti, R., ... & Sgorbissa, A. (2019).  International Journal of Social Robotics, 1-24."@en,
        "Version 1.0 "@en ;
    owl:versionInfo 1.0 ;
    ns1:term_status "" .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://caressesrobot.org/ontology#AmusementPlace> <http://caressesrobot.org/ontology#EatingPlace> <http://caressesrobot.org/ontology#LivingPlace> <http://caressesrobot.org/ontology#ShoppingPlace> <http://caressesrobot.org/ontology#SleepingPlace> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://caressesrobot.org/ontology#Family> <http://caressesrobot.org/ontology#Friend> <http://caressesrobot.org/ontology#Relative> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://caressesrobot.org/ontology#Appliance> <http://caressesrobot.org/ontology#Decoration> <http://caressesrobot.org/ontology#Furniture> <http://caressesrobot.org/ontology#Kitchenware> ) .

