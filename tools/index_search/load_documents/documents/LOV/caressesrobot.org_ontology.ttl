    rdfs:isDefinedBy onto: ;
    rdfs:range <http://caressesrobot.org/ontology#RelativeLocation> ;
    rdfs:subPropertyOf <http://caressesrobot.org/ontology#hasLocation> ;
    ns1:term_status "stable"@en .

<http://caressesrobot.org/ontology#hasReligion> a owl:ObjectProperty ;
    rdfs:label "hasReligion"@en ;
    rdfs:comment "ObjectProperty used for let the robot talk about user's religion"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> ;
