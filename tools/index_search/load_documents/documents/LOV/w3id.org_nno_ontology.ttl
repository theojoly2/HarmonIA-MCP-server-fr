@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix onto: <https://w3id.org/nno/ontology> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:DatatypeProperty ;
    rdfs:domain <https://w3id.org/nno/ontology#NeuralNetwork> ;
    rdfs:range xsd:dateTime .

dcterms:creator a owl:DatatypeProperty ;
    rdfs:domain <https://w3id.org/nno/ontology#NeuralNetwork> ;
    rdfs:range xsd:anyURI .

dcterms:description a owl:DatatypeProperty ;
    rdfs:domain <https://w3id.org/nno/ontology#NeuralNetwork> ;
    rdfs:range rdfs:Literal .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:DatatypeProperty ;
    rdfs:domain <https://w3id.org/nno/ontology#NeuralNetwork> ;
    rdfs:range xsd:anyURI .

dcterms:modified a owl:DatatypeProperty ;
    rdfs:domain <https://w3id.org/nno/ontology#NeuralNetwork> ;
    rdfs:range xsd:dateTime .

dcterms:publisher a owl:DatatypeProperty ;
    rdfs:domain <https://w3id.org/nno/ontology#NeuralNetwork> ;
    rdfs:range xsd:anyURI .

dcterms:references a owl:DatatypeProperty ;
    rdfs:domain <https://w3id.org/nno/ontology#NeuralNetwork> ;
    rdfs:range xsd:anyURI .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

doap:category a owl:DatatypeProperty ;
    rdfs:comment "indicates an assigned topic" ;
    rdfs:domain <https://w3id.org/nno/ontology#NeuralNetwork> ;
    rdfs:range rdfs:Literal .

<http://www.aifb.kit.edu/web/Anna_Nguyen> a owl:NamedIndividual,
        foaf:Person ;
    rdfs:label "Anna Nguyen" ;
    rdfs:seeAlso "http://www.aifb.kit.edu/web/Anna_Nguyen" .

<http://www.aifb.kit.edu/web/Michael_Färber> a owl:NamedIndividual,
        foaf:Person ;
    rdfs:label "Michael Färber" ;
    rdfs:seeAlso "http://www.aifb.kit.edu/web/Michael_Färber" .

<http://www.aifb.kit.edu/web/Tobias_Weller> a owl:NamedIndividual,
        foaf:Person ;
    rdfs:label "Tobias Weller" ;
    rdfs:seeAlso "http://www.aifb.kit.edu/web/Tobias_Weller" .

<http://www.aifb.kit.edu/web/Web_Science> a owl:NamedIndividual,
        foaf:Organization ;
    rdfs:label "Web Science (AIFB)" ;
    rdfs:seeAlso "http://www.aifb.kit.edu/web/Web_Science" .

<http://www.aifb.kit.edu/web/York_Sure-Vetter> a owl:NamedIndividual,
        foaf:Person ;
    rdfs:label "York Sure-Vetter" ;
    rdfs:seeAlso "http://www.aifb.kit.edu/web/York_Sure-Vetter" .

owl:topDataProperty rdfs:domain <https://w3id.org/nno/ontology#Layer> ;
    rdfs:range xsd:nonNegativeInteger .

ns1:term_status a owl:AnnotationProperty .

onto: a owl:Ontology ;
    rdfs:label "The FAIRnets Ontology" ;
    dcterms:issued "2019-03-22" ;
    dcterms:title "The FAIRnets Ontology" ;
    vann:preferredNamespacePrefix "nno" ;
    vann:preferredNamespaceUri "https://w3id.org/nno/ontology#" ;
    rdfs:comment "This is the FAIRnets Ontology. Designed by the AIFB (http://www.aifb.kit.edu).\\nIt enables to formalize Artificial Neural Networks in RDF, making it possible to represent existing Neural Networks according the FAIR principles." ;
    owl:versionInfo 2.0 ;
    ns1:term_status "stable" .

<https://w3id.org/nno/ontology#Activation> a owl:Class ;
    rdfs:label "Activation Layer" ;
    rdfs:comment "Applies an activation function to an output." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#ActivityRegularization> a owl:Class ;
    rdfs:label "Activity Regularization Layer" ;
    rdfs:comment "Layer that applies an update to the cost function based input activity." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#AveragePooling1D> a owl:Class ;
    rdfs:label "Average Pooling 1D Layer" ;
    rdfs:comment "Average pooling for temporal data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#AveragePooling2D> a owl:Class ;
    rdfs:label "Average Pooling 2D Layer" ;
    rdfs:comment "Average pooling operation for spatial data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#AveragePooling3D> a owl:Class ;
    rdfs:label "Average Pooling 3D Layer" ;
    rdfs:comment "Average pooling operation for 3D data (spatial or spatio-temporal)." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#BatchNormalization> a owl:Class ;
    rdfs:label "Batch Normalization Layer" ;
    rdfs:comment "Batch normalization layer (Ioffe and Szegedy, 2014).\\n\\nNormalize the activations of the previous layer at each batch, i.e. applies a transformation that maintains the mean activation close to 0 and the activation standard deviation close to 1." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#NormalizationLayer> .

<https://w3id.org/nno/ontology#Conv1D> a owl:Class ;
    rdfs:label "Convolutional 1D Layer" ;
    rdfs:comment "1D convolution layer (e.g. temporal convolution).\\n\\nThis layer creates a convolution kernel that is convolved with the layer input over a single spatial (or temporal) dimension to produce a tensor of outputs." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#Conv2D> a owl:Class ;
    rdfs:label "Convolutional 2D Layer" ;
    rdfs:comment "2D convolution layer (e.g. spatial convolution over images).\\n\\nThis layer creates a convolution kernel that is convolved with the layer input to produce a tensor of outputs." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#Conv2DTranspose> a owl:Class ;
    rdfs:label "Convolutional 2D Transpose Layer" ;
    rdfs:comment "Transposed convolution layer (sometimes called Deconvolution).\\n\\nThe need for transposed convolutions generally arises from the desire to use a transformation going in the opposite direction of a normal convolution, i.e., from something that has the shape of the output of some convolution to something that has the shape of its input while maintaining a connectivity pattern that is compatible with said convolution." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#Conv3D> a owl:Class ;
    rdfs:label "Convolutional 3D Layer" ;
    rdfs:comment "3D convolution layer (e.g. spatial convolution over volumes).\\n\\nThis layer creates a convolution kernel that is convolved with the layer input to produce a tensor of outputs." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#Conv3DTranspose> a owl:Class ;
    rdfs:label "Convolutional 3D Transpose Layer" ;
    rdfs:comment "Transposed convolution layer (sometimes called Deconvolution).\\n\\nThe need for transposed convolutions generally arises from the desire to use a transformation going in the opposite direction of a normal convolution, i.e., from something that has the shape of the output of some convolution to something that has the shape of its input while maintaining a connectivity pattern that is compatible with said convolution." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#ConvLSTM2D> a owl:Class ;
    rdfs:label "Convolutional LSTM 2D Layer" ;
    rdfs:comment "Convolutional LSTM.\\n\\nIt is similar to an LSTM layer, but the input transformations and recurrent transformations are both convolutional." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#ConvLSTM2DCell> a owl:Class ;
    rdfs:label "Convolutional LSTM 2D Cell Layer" ;
    rdfs:comment "Cell class for the ConvLSTM2D layer." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#Cropping1D> a owl:Class ;
    rdfs:label "Cropping 1D Layer" ;
    rdfs:comment "Cropping layer for 1D input (e.g. temporal sequence).\\n\\nIt crops along the time dimension (axis 1)." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#Cropping2D> a owl:Class ;
    rdfs:label "Cropping 2D Layer" ;
    rdfs:comment "Cropping layer for 2D input (e.g. picture).\\n\\nIt crops along spatial dimensions, i.e. height and width." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#Cropping3D> a owl:Class ;
    rdfs:label "Cropping 3D Layer" ;
    rdfs:comment "Cropping layer for 3D data (e.g. spatial or spatio-temporal)." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#CuDNNGRU> a owl:Class ;
    rdfs:label "CuDNN GRU Layer" ;
    rdfs:comment "Fast GRU implementation backed by CuDNN.\\n\\nCan only be run on GPU, with the TensorFlow backend." ;
    rdfs:seeAlso "https://developer.nvidia.com/cudnn" ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#CuDNNLSTM> a owl:Class ;
    rdfs:label "CuDNN LSTM Layer" ;
    rdfs:comment "Fast LSTM implementation with CuDNN.\\n\\nCan only be run on GPU, with the TensorFlow backend." ;
    rdfs:seeAlso "https://developer.nvidia.com/cudnn" ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#CustomLayer> a owl:Class ;
    rdfs:label "Custom Layer" ;
    rdfs:comment "Custom layer defined by user" ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#Layer> .

<https://w3id.org/nno/ontology#Dense> a owl:Class ;
    rdfs:label "Dense Layer" ;
    rdfs:comment "Just your regular densely-connected NN layer." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#DepthwiseConv2D> a owl:Class ;
    rdfs:label "Depthwise Convolutional 2D Layer" ;
    rdfs:comment "Depthwise separable 2D convolution.\\n\\nDepthwise Separable convolutions consists in performing just the first step in a depthwise spatial convolution (which acts on each input channel separately)." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#Dropout> a owl:Class ;
    rdfs:label "Dropout Layer" ;
    rdfs:comment "Applies Dropout to the input." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#Embedding> a owl:Class ;
    rdfs:label "Embedding Layer" ;
    rdfs:comment "Turns positive integers (indexes) into dense vectors of fixed size." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#EmbeddingLayer> .

<https://w3id.org/nno/ontology#Flatten> a owl:Class ;
    rdfs:label "Flatten Layer" ;
    rdfs:comment "Flattens the input. Does not affect the batch size." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#GRU> a owl:Class ;
    rdfs:label "GRU Layer" ;
    rdfs:comment "Gated Recurrent Unit - Cho et al. 2014.\\n\\nThere are two variants. The default one is based on 1406.1078v3 and has reset gate applied to hidden state before matrix multiplication. The other one is based on original 1406.1078v1 and has the order reversed." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#GRUCell> a owl:Class ;
    rdfs:label "GRU Cell Layer" ;
    rdfs:comment "Cell class for the GRU layer." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#GlobalAveragePooling1D> a owl:Class ;
    rdfs:label "Global Average Pooling 1D Layer" ;
    rdfs:comment "Global average pooling operation for temporal data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#GlobalAveragePooling2D> a owl:Class ;
    rdfs:label "Global Average Pooling 2D Layer" ;
    rdfs:comment "Global average pooling operation for spatial data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#GlobalAveragePooling3D> a owl:Class ;
    rdfs:label "Global Average Pooling 3D Layer" ;
    rdfs:comment "Global Average pooling operation for 3D data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#GlobalMaxPooling1D> a owl:Class ;
    rdfs:label "Global Max Pooling 1D Layer" ;
    rdfs:comment "Global max pooling operation for temporal data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#GlobalMaxPooling2D> a owl:Class ;
    rdfs:label "Global Max Pooling 2D Layer" ;
    rdfs:comment "Global max pooling operation for spatial data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#GlobalMaxPooling3D> a owl:Class ;
    rdfs:label "Global Max Pooling 3D Layer" ;
    rdfs:comment "Global Max pooling operation for 3D data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#Input> a owl:Class ;
    rdfs:label "Input Layer" ;
    rdfs:comment "Input() is used to instantiate a Keras tensor.\\n\\nA Keras tensor is a tensor object from the underlying backend (Theano, TensorFlow or CNTK), which we augment with certain attributes that allow us to build a Keras model just by knowing the inputs and outputs of the model." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#InputLayer> a owl:Class ;
    rdfs:label "Input Layer" ;
    rdfs:comment "Input (e.g. data set)." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#Layer> .

<https://w3id.org/nno/ontology#LSTM> a owl:Class ;
    rdfs:label "LSTM Layer" ;
    rdfs:comment "Long Short-Term Memory layer - Hochreiter 1997." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#LSTMCell> a owl:Class ;
    rdfs:label "Cell class for the LSTM layer.",
        "LSTM Cell Layer" ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#Lambda> a owl:Class ;
    rdfs:label "Lambda Layer" ;
    rdfs:comment "Wraps arbitrary expression as a Layer object." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#LocallyConnected1D> a owl:Class ;
    rdfs:label "Locally-connected 1D Layer" ;
    rdfs:comment "Locally-connected layer for 1D inputs." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#Locally-connectedLayer> .

<https://w3id.org/nno/ontology#LocallyConnected2D> a owl:Class ;
    rdfs:label "Locally-connected 2D Layer" ;
    rdfs:comment "Locally-connected layer for 2D inputs." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#Locally-connectedLayer> .

<https://w3id.org/nno/ontology#Masking> a owl:Class ;
    rdfs:label "Masking Layer" ;
    rdfs:comment "Masks a sequence by using a mask value to skip timesteps." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#MaxPooling1D> a owl:Class ;
    rdfs:label "Max Pooling 1D Layer" ;
    rdfs:comment "Max pooling operation for temporal data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#MaxPooling2D> a owl:Class ;
    rdfs:label "Max Pooling 2D Layer" ;
    rdfs:comment "Max pooling operation for spatial data." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#MaxPooling3D> a owl:Class ;
    rdfs:label "Max Pooling 3D Layer" ;
    rdfs:comment "Max pooling operation for 3D data (spatial or spatio-temporal)." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#PoolingLayer> .

<https://w3id.org/nno/ontology#Permute> a owl:Class ;
    rdfs:label "Permute Layer" ;
    rdfs:comment "Permutes the dimensions of the input according to a given pattern.\\n\\nUseful for e.g. connecting RNNs and convnets together." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#RNN> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#RepeatVector> a owl:Class ;
    rdfs:label "Repeat Vector Layer" ;
    rdfs:comment "Repeats the input n times." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#Reshape> a owl:Class ;
    rdfs:label "Reshape Layer" ;
    rdfs:comment "Reshapes an output to a certain shape." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#SeparableConv1D> a owl:Class ;
    rdfs:label "Separable Convolutional 1D Layer" ;
    rdfs:comment "Depthwise separable 1D convolution.\\n\\nSeparable convolutions consist in first performing a depthwise spatial convolution (which acts on each input channel separately) followed by a pointwise convolution which mixes together the resulting output channels.\\n\\nIntuitively, separable convolutions can be understood as a way to factorize a convolution kernel into two smaller kernels, or as an extreme version of an Inception block." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#SeparableConv2D> a owl:Class ;
    rdfs:label "Separable Convolutional 2D Layer" ;
    rdfs:comment "Depthwise separable 2D convolution.\\n\\nSeparable convolutions consist in first performing a depthwise spatial convolution (which acts on each input channel separately) followed by a pointwise convolution which mixes together the resulting output channels.\\n\\nIntuitively, separable convolutions can be understood as a way to factorize a convolution kernel into two smaller kernels, or as an extreme version of an Inception block." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#SimpleRNN> a owl:Class ;
    rdfs:label "Simple RNN Layer" ;
    rdfs:comment "Fully-connected RNN where the output is to be fed back to input." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#SimpleRNNCell> a owl:Class ;
    rdfs:label "Simple RNN Cell Layer" ;
    rdfs:comment "Cell class for SimpleRNN." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#RecurrentLayer> .

<https://w3id.org/nno/ontology#SpatialDropout1D> a owl:Class ;
    rdfs:label "Spatial Dropout 1D Layer" ;
    rdfs:comment "Spatial 1D version of Dropout.\\n\\nThis version performs the same function as Dropout, however it drops entire 1D feature maps instead of individual elements. If adjacent frames within feature maps are strongly correlated (as is normally the case in early convolution layers) then regular dropout will not regularize the activations and will otherwise just result in an effective learning rate decrease. In this case, SpatialDropout1D will help promote independence between feature maps and should be used instead." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#SpatialDropout2D> a owl:Class ;
    rdfs:label "Spatial Dropout 2D Layer" ;
    rdfs:comment "Spatial 2D version of Dropout.\\n\\nThis version performs the same function as Dropout, however it drops entire 2D feature maps instead of individual elements. If adjacent pixels within feature maps are strongly correlated (as is normally the case in early convolution layers) then regular dropout will not regularize the activations and will otherwise just result in an effective learning rate decrease. In this case, SpatialDropout2D will help promote independence between feature maps and should be used instead." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#SpatialDropout3D> a owl:Class ;
    rdfs:label "Spatial Dropout 3D Layer" ;
    rdfs:comment "Spatial 3D version of Dropout.\\n\\nThis version performs the same function as Dropout, however it drops entire 3D feature maps instead of individual elements. If adjacent pixels within feature maps are strongly correlated (as is normally the case in early convolution layers) then regular dropout will not regularize the activations and will otherwise just result in an effective learning rate decrease. In this case, SpatialDropout3D will help promote independence between feature maps and should be used instead." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#CoreLayer> .

<https://w3id.org/nno/ontology#UpSampling1D> a owl:Class ;
    rdfs:label "Upsampling 1D Layer" ;
    rdfs:comment "Upsampling layer for 1D inputs." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#UpSampling2D> a owl:Class ;
    rdfs:label "Upsampling 2D Layer" ;
    rdfs:comment "Upsampling layer for 2D inputs.\\n\\nRepeats the rows and columns of the data by size[0] and size[1] respectively." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#UpSampling3D> a owl:Class ;
    rdfs:label "Upsampling 3D Layer" ;
    rdfs:comment "Upsampling layer for 3D inputs.\\n\\nRepeats the 1st, 2nd and 3rd dimensions of the data by size[0], size[1] and size[2] respectively." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#ZeroPadding1D> a owl:Class ;
    rdfs:label "Zero-padding 1D Layer" ;
    rdfs:comment "Zero-padding layer for 1D input (e.g. temporal sequence)." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#ZeroPadding2D> a owl:Class ;
    rdfs:label "Zero-padding 2D Layer" ;
    rdfs:comment "Zero-padding layer for 2D input (e.g. picture).\\n\\nThis layer can add rows and columns of zeros at the top, bottom, left and right side of an image tensor." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#ZeroPadding3D> a owl:Class ;
    rdfs:label "Zero-padding 3D Layer" ;
    rdfs:comment "Zero-padding layer for 3D data (spatial or spatio-temporal)." ;
    rdfs:subClassOf <https://w3id.org/nno/ontology#ConvolutionalLayer> .

<https://w3id.org/nno/ontology#adadelta> a owl:NamedIndividual,
        <https://w3id.org/nno/ontology#Optimizer> ;
    rdfs:label "Adadelta Optimizer" ;
    rdfs:comment "Adadelta is a more robust extension of Adagrad that adapts learning rates based on a moving window of gradient updates, instead of accumulating all past gradients. This way, Adadelta continues learning even when many updates have been done. Compared to Adagrad, in the original version of Adadelta you don't have to set an initial learning rate. In this version, initial learning rate and decay factor can be set, as in most other Keras optimizers." .

<https://w3id.org/nno/ontology#adagrad> a owl:NamedIndividual,
        <https://w3id.org/nno/ontology#Optimizer> ;
    rdfs:label "Adagrad Optimizer" ;
    rdfs:comment "Adagrad is an optimizer with parameter-specific learning rates, which are adapted relative to how frequently a parameter gets updated during training. The more updates a parameter receives, the smaller the learning rate." .

<https://w3id.org/nno/ontology#adam> a owl:NamedIndividual,
        <https://w3id.org/nno/ontology#Optimizer> ;
