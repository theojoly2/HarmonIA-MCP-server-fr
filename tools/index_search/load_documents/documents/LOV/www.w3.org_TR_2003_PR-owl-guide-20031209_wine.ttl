    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:oneOf ( ns1:Moderate ns1:Strong ) ] ;
            owl:onProperty ns1:hasFlavor ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Red ;
            owl:onProperty ns1:hasColor ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Dry ;
            owl:onProperty ns1:hasSugar ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:oneOf ( ns1:Full ns1:Medium ) ] ;
            owl:onProperty ns1:hasBody ] ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:ZinfandelGrape ;
                owl:onProperty ns1:madeFromGrape ] [ a owl:Restriction ;
                owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                owl:onProperty ns1:madeFromGrape ] ) .

ns1:FrenchRegion a ns1:Region .

ns1:SauvignonBlancGrape a owl:Thing,
        ns1:WineGrape .

ns1:WhiteWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:White ;
                owl:onProperty ns1:hasColor ] ) .

ns1:NewZealandRegion a ns1:Region .

ns1:NapaRegion a ns1:Region ;
    ns1:locatedIn ns1:CaliforniaRegion .

ns1:SonomaRegion a ns1:Region ;
    ns1:locatedIn ns1:CaliforniaRegion .

ns1:CaliforniaRegion a ns1:Region ;
    ns1:locatedIn ns1:USRegion .

ns1:OffDry a owl:Thing,
        ns1:WineSugar ;
    owl:differentFrom ns1:Dry,
        ns1:Sweet .

ns1:Light a owl:Thing,
        ns1:WineBody .

ns1:Sweet a owl:Thing,
        ns1:WineSugar ;
    owl:differentFrom ns1:Dry .

ns1:White a owl:Thing,
        ns1:WineColor .

ns1:Delicate a owl:Thing,
        ns1:WineFlavor .

ns1:Red a owl:Thing,
        ns1:WineColor .

ns1:WineGrape a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#Grape> .

ns1:hasBody a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:WineBody ;
    rdfs:subPropertyOf ns1:hasWineDescriptor .

ns1:hasFlavor a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:WineFlavor ;
    rdfs:subPropertyOf ns1:hasWineDescriptor .

ns1:Strong a owl:Thing,
        ns1:WineFlavor .

ns1:hasSugar a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ns1:WineSugar ;
    rdfs:subPropertyOf ns1:hasWineDescriptor .

ns1:locatedIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:Region .

ns1:hasColor a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ns1:Wine ;
    rdfs:range ns1:WineColor ;
    rdfs:subPropertyOf ns1:hasWineDescriptor .

ns1:Full a owl:Thing,
        ns1:WineBody .

ns1:Wine a owl:Class ;
    rdfs:label "wine"@en,
        "vin"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasBody ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Winery ;
            owl:onProperty ns1:hasMaker ],
        [ a owl:Restriction ;
            owl:onProperty ns1:locatedIn ;
            owl:someValuesFrom ns1:Region ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasMaker ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasSugar ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasFlavor ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasColor ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:madeFromGrape ],
        <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#PotableLiquid> .

ns1:Medium a owl:Thing,
        ns1:WineBody .

ns1:Moderate a owl:Thing,
        ns1:WineFlavor .

ns1:Region a owl:Class .

ns1:Winery a owl:Class .

ns1:madeFromGrape a owl:ObjectProperty ;
    rdfs:domain ns1:Wine ;
    rdfs:range ns1:WineGrape ;
    rdfs:subPropertyOf <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#madeFromFruit> .

ns1:Dry a owl:Thing,
        ns1:WineSugar .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ns1:Red ns1:White ns1:Rose ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ns1:Light ns1:Medium ns1:Full ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ns1:Bancroft ns1:ChateauChevalBlanc ns1:ChateauDYchem ns1:ChateauDeMeursault ns1:ChateauLafiteRothschild ns1:ChateauMargauxWinery ns1:ChateauMorgon ns1:ClosDeLaPoussie ns1:ClosDeVougeot ns1:CongressSprings ns1:Corbans ns1:CortonMontrachet ns1:Cotturi ns1:DAnjou ns1:Elyse ns1:Forman ns1:Foxen ns1:GaryFarrell ns1:KalinCellars ns1:KathrynKennedy ns1:LaneTanner ns1:Longridge ns1:Marietta ns1:McGuinnesso ns1:MountEdenVineyard ns1:Mountadam ns1:PageMillWinery ns1:PeterMccoy ns1:PulignyMontrachet ns1:SantaCruzMountainVineyard ns1:SaucelitoCanyon ns1:SchlossRothermel ns1:SchlossVolrad ns1:SeanThackrey ns1:Selaks ns1:SevreEtMaine ns1:StGenevieve ns1:Stonleigh ns1:Taylor ns1:Ventana ns1:WhitehallLane ) .

