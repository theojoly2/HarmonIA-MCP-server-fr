@prefix ns1: <http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#> .
@prefix onto: <http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "Wine Ontology" ;
    rdfs:comment "An example OWL ontology",
        "Derived from the DAML Wine ontology at \\n      http://ontolingua.stanford.edu/doc/chimaera/ontologies/wines.daml\\n      Substantially changed, in particular the Region based relations.\\n    " ;
    owl:imports <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food> ;
    owl:priorVersion <http://www.w3.org/TR/2003/CR-owl-guide-20030818/wine> .

ns1:AlsatianWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:AlsaceRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:AmericanWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:USRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:BancroftChardonnay a ns1:Chardonnay ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Bancroft ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NapaRegion .

ns1:Beringer a ns1:Winery .

ns1:CaliforniaWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:CaliforniaRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:ChateauChevalBlancStEmilion a ns1:StEmilion ;
    ns1:hasMaker ns1:ChateauChevalBlanc .

ns1:ChateauDYchemSauterne a ns1:Sauternes ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:ChateauDYchem ;
    ns1:madeFromGrape ns1:SauvignonBlancGrape,
        ns1:SemillonGrape .

ns1:ChateauDeMeursaultMeursault a ns1:Meursault ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:ChateauDeMeursault .

ns1:ChateauLafiteRothschildPauillac a ns1:Pauillac ;
    ns1:hasMaker ns1:ChateauLafiteRothschild .

ns1:ChateauMargaux a ns1:Margaux ;
    ns1:hasMaker ns1:ChateauMargauxWinery .

ns1:ChateauMorgonBeaujolais a ns1:Beaujolais ;
    ns1:hasMaker ns1:ChateauMorgon .

ns1:ChiantiClassico a ns1:Chianti ;
    ns1:hasBody ns1:Medium ;
    ns1:hasMaker ns1:McGuinnesso .

ns1:ClosDeLaPoussieSancerre a ns1:Sancerre ;
    ns1:hasMaker ns1:ClosDeLaPoussie .

ns1:ClosDeVougeotCotesDOr a ns1:CotesDOr ;
    ns1:hasMaker ns1:ClosDeVougeot .

ns1:CongressSpringsSemillon a ns1:Semillon ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:CongressSprings ;
    ns1:hasSugar ns1:Dry .

ns1:CorbansDryWhiteRiesling a ns1:Riesling ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Corbans ;
    ns1:hasSugar ns1:OffDry ;
    ns1:locatedIn ns1:NewZealandRegion .

ns1:CorbansPrivateBinSauvignonBlanc a ns1:SauvignonBlanc ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:Corbans ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NewZealandRegion .

ns1:CorbansSauvignonBlanc a ns1:SauvignonBlanc ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:Corbans ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NewZealandRegion .

ns1:CortonMontrachetWhiteBurgundy a ns1:WhiteBurgundy ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:CortonMontrachet ;
    ns1:hasSugar ns1:Dry .

ns1:CotturiZinfandel a ns1:Zinfandel ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:Cotturi ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SonomaRegion .

ns1:DryRedWine a owl:Class ;
    owl:intersectionOf ( ns1:DryWine ns1:RedWine ) .

ns1:DryWhiteWine a owl:Class ;
    owl:intersectionOf ( ns1:DryWine ns1:WhiteWine ) .

ns1:ElyseZinfandel a ns1:Zinfandel ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Elyse ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NapaRegion .

ns1:FormanCabernetSauvignon a ns1:CabernetSauvignon ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:Forman ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NapaRegion .

ns1:FormanChardonnay a ns1:Chardonnay ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Forman ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NapaRegion .

ns1:FoxenCheninBlanc a ns1:CheninBlanc ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Foxen ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SantaBarbaraRegion .

ns1:FrenchWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:FrenchRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:FullBodiedWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:Full ;
                owl:onProperty ns1:hasBody ] ) .

ns1:Gamay a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:GamayGrape ;
                owl:onProperty ns1:madeFromGrape ] [ a owl:Restriction ;
                owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                owl:onProperty ns1:madeFromGrape ] ) .

ns1:GaryFarrellMerlot a ns1:Merlot ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:GaryFarrell ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SonomaRegion .

ns1:GermanWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:GermanyRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:Handley a ns1:Winery .

ns1:KalinCellarsSemillon a ns1:Semillon ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:KalinCellars ;
    ns1:hasSugar ns1:Dry .

ns1:KathrynKennedyLateral a ns1:Meritage ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Delicate ;
    ns1:hasMaker ns1:KathrynKennedy ;
    ns1:hasSugar ns1:Dry .

ns1:LaneTannerPinotNoir a ns1:PinotNoir ;
    ns1:hasBody ns1:Light ;
    ns1:hasFlavor ns1:Delicate ;
    ns1:hasMaker ns1:LaneTanner ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SantaBarbaraRegion .

ns1:LongridgeMerlot a ns1:Merlot ;
    ns1:hasBody ns1:Light ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Longridge ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NewZealandRegion .

ns1:MariettaCabernetSauvignon a ns1:CabernetSauvignon ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Marietta ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SonomaRegion .

ns1:MariettaOldVinesRed a ns1:RedTableWine ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Marietta ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SonomaRegion .

ns1:MariettaPetiteSyrah a ns1:PetiteSyrah ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Marietta ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SonomaRegion .

ns1:MariettaZinfandel a ns1:Zinfandel ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Marietta ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SonomaRegion .

ns1:MendocinoRegion a ns1:Region ;
    ns1:adjacentRegion ns1:SonomaRegion ;
    ns1:locatedIn ns1:CaliforniaRegion .

ns1:MountEdenVineyardEdnaValleyChardonnay a ns1:Chardonnay ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:MountEdenVineyard ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:EdnaValleyRegion .

ns1:MountEdenVineyardEstatePinotNoir a ns1:PinotNoir ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:MountEdenVineyard ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:EdnaValleyRegion .

ns1:MountadamChardonnay a ns1:Chardonnay ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:Mountadam ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SouthAustraliaRegion .

ns1:MountadamPinotNoir a ns1:PinotNoir ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Mountadam ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SouthAustraliaRegion .

ns1:MountadamRiesling a ns1:DryRiesling ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Delicate ;
    ns1:hasMaker ns1:Mountadam ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SouthAustraliaRegion .

ns1:PageMillWineryCabernetSauvignon a ns1:CabernetSauvignon ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:PageMillWinery ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NapaRegion .

ns1:PeterMccoyChardonnay a ns1:Chardonnay ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:PeterMccoy ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SonomaRegion .

ns1:PinotBlanc a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:White ;
            owl:onProperty ns1:hasColor ] ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:PinotBlancGrape ;
                owl:onProperty ns1:madeFromGrape ] [ a owl:Restriction ;
                owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                owl:onProperty ns1:madeFromGrape ] ) .

ns1:PulignyMontrachetWhiteBurgundy a ns1:WhiteBurgundy ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:PulignyMontrachet ;
    ns1:hasSugar ns1:Dry .

ns1:RedBordeaux a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:oneOf ( ns1:CabernetSauvignonGrape ns1:MerlotGrape ) ] ;
            owl:onProperty ns1:madeFromGrape ] ;
    owl:intersectionOf ( ns1:Bordeaux ns1:RedWine ) .

ns1:RoseDAnjou a ns1:Anjou ;
    ns1:hasMaker ns1:DAnjou .

ns1:RoseWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:Rose ;
                owl:onProperty ns1:hasColor ] ) .

ns1:SantaCruzMountainVineyardCabernetSauvignon a ns1:CabernetSauvignon ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:SantaCruzMountainVineyard ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:SantaCruzMountainsRegion .

ns1:SaucelitoCanyonZinfandel a ns1:Zinfandel ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:SaucelitoCanyon ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:ArroyoGrandeRegion .

ns1:SaucelitoCanyonZinfandel1998 a ns1:Zinfandel ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:SaucelitoCanyon ;
    ns1:hasSugar ns1:Dry ;
    ns1:hasVintageYear ns1:Year1998 ;
    ns1:locatedIn ns1:ArroyoGrandeRegion .

ns1:SchlossRothermelTrochenbierenausleseRiesling a ns1:SweetRiesling ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:SchlossRothermel ;
    ns1:hasSugar ns1:Sweet ;
    ns1:locatedIn ns1:GermanyRegion .

ns1:SchlossVolradTrochenbierenausleseRiesling a ns1:SweetRiesling ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:SchlossVolrad ;
    ns1:hasSugar ns1:Sweet ;
    ns1:locatedIn ns1:GermanyRegion .

ns1:SeanThackreySiriusPetiteSyrah a ns1:PetiteSyrah ;
    ns1:hasBody ns1:Full ;
    ns1:hasFlavor ns1:Strong ;
    ns1:hasMaker ns1:SeanThackrey ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NapaRegion .

ns1:SelaksIceWine a ns1:IceWine ;
    ns1:hasBody ns1:Medium ;
    ns1:hasColor ns1:White ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Selaks ;
    ns1:locatedIn ns1:NewZealandRegion .

ns1:SelaksSauvignonBlanc a ns1:SauvignonBlanc ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Selaks ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NewZealandRegion .

ns1:SevreEtMaineMuscadet a ns1:Muscadet ;
    ns1:hasMaker ns1:SevreEtMaine .

ns1:StGenevieveTexasWhite a ns1:WhiteWine ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:StGenevieve ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:CentralTexasRegion .

ns1:StonleighSauvignonBlanc a ns1:SauvignonBlanc ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Delicate ;
    ns1:hasMaker ns1:Stonleigh ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NewZealandRegion .

ns1:SweetWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:Sweet ;
                owl:onProperty ns1:hasSugar ] ) .

ns1:TaylorPort a ns1:Port ;
    ns1:hasMaker ns1:Taylor .

ns1:TexasWine a owl:Class ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:TexasRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:Tours a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:CheninBlancGrape ;
            owl:onProperty ns1:madeFromGrape ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:madeFromGrape ] ;
    owl:intersectionOf ( ns1:Loire [ a owl:Restriction ;
                owl:hasValue ns1:ToursRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:VentanaCheninBlanc a ns1:CheninBlanc ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:Ventana ;
    ns1:hasSugar ns1:OffDry ;
    ns1:locatedIn ns1:CentralCoastRegion .

ns1:WhiteBordeaux a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:oneOf ( ns1:SemillonGrape ns1:SauvignonBlancGrape ) ] ;
            owl:onProperty ns1:madeFromGrape ] ;
    owl:intersectionOf ( ns1:Bordeaux ns1:WhiteWine ) .

ns1:WhiteLoire a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:oneOf ( ns1:CheninBlancGrape ns1:PinotBlancGrape ns1:SauvignonBlancGrape ) ] ;
            owl:onProperty ns1:madeFromGrape ] ;
    owl:intersectionOf ( ns1:Loire ns1:WhiteWine ) .

ns1:WhiteNonSweetWine a owl:Class ;
    owl:intersectionOf ( ns1:WhiteWine [ a owl:Restriction ;
                owl:allValuesFrom [ a owl:Class ;
                        owl:oneOf ( ns1:Dry ns1:OffDry ) ] ;
                owl:onProperty ns1:hasSugar ] ) .

ns1:WhiteTableWine a owl:Class ;
    owl:intersectionOf ( ns1:TableWine [ a owl:Restriction ;
                owl:hasValue ns1:White ;
                owl:onProperty ns1:hasColor ] ) .

ns1:WhitehallLaneCabernetFranc a ns1:CabernetFranc ;
    ns1:hasBody ns1:Medium ;
    ns1:hasFlavor ns1:Moderate ;
    ns1:hasMaker ns1:WhitehallLane ;
    ns1:hasSugar ns1:Dry ;
    ns1:locatedIn ns1:NapaRegion .

ns1:WhitehallLanePrimavera a ns1:DessertWine ;
    ns1:hasBody ns1:Light ;
    ns1:hasFlavor ns1:Delicate ;
    ns1:hasSugar ns1:Sweet ;
    ns1:locatedIn ns1:NapaRegion .

ns1:adjacentRegion a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain ns1:Region ;
    rdfs:range ns1:Region .

ns1:madeIntoWine a owl:ObjectProperty ;
    owl:inverseOf ns1:madeFromGrape .

ns1:producesWine a owl:ObjectProperty ;
    owl:inverseOf ns1:hasMaker .

ns1:yearValue a owl:DatatypeProperty ;
    rdfs:domain ns1:VintageYear ;
    rdfs:range xsd:positiveInteger .

<http://www.w3.org/TR/2003/CR-owl-guide-20030818/wine> a owl:Ontology .

ns1:AlsaceRegion a ns1:Region ;
    ns1:locatedIn ns1:FrenchRegion .

ns1:Anjou a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:OffDry ;
            owl:onProperty ns1:hasSugar ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Delicate ;
            owl:onProperty ns1:hasFlavor ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Light ;
            owl:onProperty ns1:hasBody ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Rose ;
            owl:onProperty ns1:hasColor ] ;
    owl:intersectionOf ( ns1:Loire [ a owl:Restriction ;
                owl:hasValue ns1:AnjouRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:AnjouRegion a ns1:Region ;
    ns1:locatedIn ns1:LoireRegion .

ns1:AustralianRegion a ns1:Region .

ns1:Beaujolais a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:Dry ;
            owl:onProperty ns1:hasSugar ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Delicate ;
            owl:onProperty ns1:hasFlavor ],
        [ a owl:Restriction ;
            owl:hasValue ns1:GamayGrape ;
            owl:onProperty ns1:madeFromGrape ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Light ;
            owl:onProperty ns1:hasBody ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:madeFromGrape ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Red ;
            owl:onProperty ns1:hasColor ] ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:BeaujolaisRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:BeaujolaisRegion a ns1:Region ;
    ns1:locatedIn ns1:FrenchRegion .

ns1:CabernetFranc a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:Dry ;
            owl:onProperty ns1:hasSugar ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Medium ;
            owl:onProperty ns1:hasBody ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Red ;
            owl:onProperty ns1:hasColor ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Moderate ;
            owl:onProperty ns1:hasFlavor ] ;
    owl:intersectionOf ( ns1:Wine [ a owl:Restriction ;
                owl:hasValue ns1:CabernetFrancGrape ;
                owl:onProperty ns1:madeFromGrape ] [ a owl:Restriction ;
                owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                owl:onProperty ns1:madeFromGrape ] ) .

ns1:CentralCoastRegion a ns1:Region ;
    ns1:locatedIn ns1:CaliforniaRegion .

ns1:CentralTexasRegion a ns1:Region ;
    ns1:locatedIn ns1:TexasRegion .

ns1:Chianti a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:Red ;
            owl:onProperty ns1:hasColor ],
        [ a owl:Restriction ;
            owl:hasValue ns1:ChiantiRegion ;
            owl:onProperty ns1:locatedIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:oneOf ( ns1:Light ns1:Medium ) ] ;
            owl:onProperty ns1:hasBody ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Dry ;
            owl:onProperty ns1:hasSugar ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Moderate ;
            owl:onProperty ns1:hasFlavor ],
        [ a owl:Restriction ;
            owl:hasValue ns1:SangioveseGrape ;
            owl:onProperty ns1:madeFromGrape ],
        ns1:ItalianWine .

ns1:ChiantiRegion a ns1:Region ;
    ns1:locatedIn ns1:ItalianRegion .

ns1:CotesDOr a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:Moderate ;
            owl:onProperty ns1:hasFlavor ] ;
    owl:intersectionOf ( ns1:RedBurgundy [ a owl:Restriction ;
                owl:hasValue ns1:CotesDOrRegion ;
                owl:onProperty ns1:locatedIn ] ) .

ns1:CotesDOrRegion a ns1:Region ;
    ns1:locatedIn ns1:BourgogneRegion .

ns1:DryRiesling a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:White ;
            owl:onProperty ns1:hasColor ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
