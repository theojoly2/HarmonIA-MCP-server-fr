@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://www.ics.forth.gr/isl/oncm/core> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

onto: a owl:Ontology ;
    rdfs:label "Open NEE Configuration Model"@en ;
    dcterms:contributor <http://users.ics.forth.gr/~tzitzik> ;
    dcterms:creator <http://users.ics.forth.gr/~fafalios> ;
    dcterms:description "The Open NEE Configuration Model defines a Linked Data-based model for describing a configuration supported by a Named Entity Extraction (NEE) service. It is based on the model proposed in \"Configuring Named Entity Extraction through Real-Time Exploitation of Linked Data\" (http://dl.acm.org/citation.cfm?doid=2611040.2611085) for configuring such services, and allows a NEE service to describe and publish as Linked Data its entity mining capabilities, but also to be dynamically configured."@en ;
    dcterms:title "The Open NEE Configuration Model"@en ;
    rdfs:comment "The Open NEE Configuration Model defines a Linked Data-based model for describing a configuration supported by a Named Entity Extraction (NEE) service. It is based on the model proposed in \"Configuring Named Entity Extraction through Real-Time Exploitation of Linked Data\" (http://dl.acm.org/citation.cfm?doid=2611040.2611085) for configuring such services, and allows a NEE service to describe and publish as Linked Data its entity mining capabilities, but also to be dynamically configured."@en ;
    rdfs:seeAlso <http://dl.acm.org/citation.cfm?doid=2611040.2611085> ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ;
    owl:versionInfo "1.0" .

<http://www.ics.forth.gr/isl/oncm/core#accessibleThrough> a owl:ObjectProperty ;
    rdfs:label "accessible through"@en ;
    dcterms:description "Relates a NEE service to a resource, e.g. to a URL describing the API of a service."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#NEEService> ;
    rdfs:range rdfs:Resource .

<http://www.ics.forth.gr/isl/oncm/core#endpoint> a owl:ObjectProperty ;
    rdfs:label "endpoint"@en ;
    dcterms:description "Relates a KBM to the URL of a SPARQL endpoint."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#KBM> ;
    rdfs:range rdfs:Resource .

<http://www.ics.forth.gr/isl/oncm/core#entitiesSpecFrom> a owl:ObjectProperty ;
    rdfs:label "entities specification from"@en ;
    dcterms:description "Relates a category to a KBM."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#Category> ;
    rdfs:range <http://www.ics.forth.gr/isl/oncm/core#KBM> .

<http://www.ics.forth.gr/isl/oncm/core#isDefinedBy> a owl:ObjectProperty ;
    rdfs:label "is defined by"@en ;
    dcterms:description "Relates a ranking method to a resource, e.g. to a URL describing the ranking approach."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#RankingMethod> ;
    rdfs:range rdfs:Resource .

<http://www.ics.forth.gr/isl/oncm/core#ranksEntitiesUsing> a owl:ObjectProperty ;
    rdfs:label "ranks entities using"@en ;
    dcterms:description "Relates a configuration to a method for ranking entities."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#Configuration> ;
    rdfs:range <http://www.ics.forth.gr/isl/oncm/core#RankingMethod> .

<http://www.ics.forth.gr/isl/oncm/core#ranksResourcesUsing> a owl:ObjectProperty ;
    rdfs:label "ranks resources using"@en ;
    dcterms:description "Relates a configuration to a method for ranking resources."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#Configuration> ;
    rdfs:range <http://www.ics.forth.gr/isl/oncm/core#RankingMethod> .

<http://www.ics.forth.gr/isl/oncm/core#supports> a owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    dcterms:description "Relates a NEE service to a configuration, or a configuration to a supported category."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#Configuration>,
        <http://www.ics.forth.gr/isl/oncm/core#NEEService> ;
    rdfs:range <http://www.ics.forth.gr/isl/oncm/core#Category>,
        <http://www.ics.forth.gr/isl/oncm/core#Configuration> .

<http://www.ics.forth.gr/isl/oncm/core#usesEntityEnrichmentSpec> a owl:ObjectProperty ;
    rdfs:label "uses entity enrichment specification"@en ;
    dcterms:description "Relates a KBM to an entity-enrichment specification."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#KBM> ;
    rdfs:range <http://www.ics.forth.gr/isl/oncm/core#EntityEnrichmentSpec> .

<http://www.ics.forth.gr/isl/oncm/core#usesEntityLinkingSpec> a owl:ObjectProperty ;
    rdfs:label "uses entity linking specification"@en ;
    dcterms:description "Relates a KBM to an entity-linking specification."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#KBM> ;
    rdfs:range <http://www.ics.forth.gr/isl/oncm/core#EntityLinkingSpec> .

<http://www.ics.forth.gr/isl/oncm/core#usesEntityNamesSpec> a owl:ObjectProperty ;
    rdfs:label "uses entity names specification"@en ;
    dcterms:description "Relates a KBM to specification of entity names."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#KBM> ;
    rdfs:range <http://www.ics.forth.gr/isl/oncm/core#EntityNamesSpec> .

<http://www.ics.forth.gr/isl/oncm/core#usesSparqlQuery> a owl:DatatypeProperty ;
    rdfs:label "uses SPARQL query"@en ;
    dcterms:description "Relates a specification of entity names to a SPARQL query."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#EntityNamesSpec> ;
    rdfs:range rdfs:Literal .

<http://www.ics.forth.gr/isl/oncm/core#usesSparqlTemplateParam> a owl:DatatypeProperty ;
    rdfs:label "uses SPARQL template parameter"@en ;
    dcterms:description "Relates an entity-linking or entity-enrichment specification to a SPARQL template parameter."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#EntityEnrichmentSpec>,
        <http://www.ics.forth.gr/isl/oncm/core#EntityLinkingSpec> ;
    rdfs:range rdfs:Literal .

<http://www.ics.forth.gr/isl/oncm/core#usesSparqlTemplateQuery> a owl:DatatypeProperty ;
    rdfs:label "uses SPARQL template query"@en ;
    dcterms:description "Relates an entity-linking or entity-enrichment specification to a SPARQL template query."@en ;
    rdfs:domain <http://www.ics.forth.gr/isl/oncm/core#EntityEnrichmentSpec>,
        <http://www.ics.forth.gr/isl/oncm/core#EntityLinkingSpec> ;
    rdfs:range rdfs:Literal .

<http://www.ics.forth.gr/isl/oncm/core#Category> a owl:Class ;
    rdfs:label "category"@en ;
    dcterms:description "A category/class of entities supported by a configuration."@en ;
    rdfs:subClassOf skos:Concept .

<http://www.ics.forth.gr/isl/oncm/core#EntityNamesSpec> a owl:Class ;
    rdfs:label "entity names specification"@en ;
    dcterms:description "Specification of the entity names of a category."@en .

<http://www.ics.forth.gr/isl/oncm/core#NEEService> a owl:Class ;
    rdfs:label "named entity extraction service"@en ;
    dcterms:description "A Named Entity Extraction (NEE) service"@en .

<http://www.ics.forth.gr/isl/oncm/core#EntityEnrichmentSpec> a owl:Class ;
    rdfs:label "entity enrichment specification"@en ;
    dcterms:description "Specification of the extra information that should be fetched for an entity URI."@en .

<http://www.ics.forth.gr/isl/oncm/core#EntityLinkingSpec> a owl:Class ;
    rdfs:label "entity linking specification"@en ;
    dcterms:description "Specification of how an entity name corresponds to entity URIs."@en .

<http://www.ics.forth.gr/isl/oncm/core#RankingMethod> a owl:Class ;
    rdfs:label "ranking method"@en ;
    dcterms:description "A method used for ranking the entities or the entity URIs."@en .

<http://www.ics.forth.gr/isl/oncm/core#Configuration> a owl:Class ;
    rdfs:label "configuration"@en ;
    dcterms:description "The configuration supported by a NEE service."@en .

<http://www.ics.forth.gr/isl/oncm/core#KBM> a owl:Class ;
    rdfs:label "knowledge base mirror"@en ;
    dcterms:description "A Knowledge Base Mirror (KBM): the gateway for accessing a Knowledge Base."@en .

