skos:prefLabel a owl:DatatypeProperty .

foaf:depiction a owl:ObjectProperty .

<http://lod.taxonconcept.org/ontology/txn.owl#RankSpecies> a <http://lod.taxonconcept.org/ontology/txn.owl#TaxonRank>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rank Species" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" ;
    skos:broader <http://lod.taxonconcept.org/ontology/txn.owl#RankSubgenus> ;
    skos:narrower <http://lod.taxonconcept.org/ontology/txn.owl#RankSubpecies> .

<http://lod.taxonconcept.org/ontology/txn.owl#synonymID> a owl:ObjectProperty ;
    rdfs:label "synonymID" ;
    rdfs:comment "The URI to a synonymID of the TaxonNameID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    rdfs:subPropertyOf <http://lod.taxonconcept.org/ontology/txn.owl#relatedTaxonNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#Identification> a owl:Class ;
    rdfs:label "Identification" ;
    rdfs:comment "An identification action. The identification of a specimen." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#Image> a owl:Class ;
    rdfs:label "Image" ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass foaf:Image ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#Scientist> a owl:Class ;
    rdfs:label "Scientist"@en ;
    rdfs:comment "Class for Scientist a foaf:Person"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf foaf:Person ;
    owl:equivalentClass <http://dbpedia.org/ontology/Scientist> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#Sex> a owl:Class ;
    rdfs:label "Sex" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#SpeciesConcept> a owl:Class ;
    rdfs:label "SpeciesConcept" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#TaxonConcept> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#Area> a owl:Class ;
    rdfs:label "Area" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    ns1:term_status "testing" .

<http://www.geonames.org/ontology#Feature> a owl:Class .

foaf:Person a owl:Class .

<http://lod.taxonconcept.org/ontology/txn.owl#SpeciesIndividual> a owl:Class ;
    rdfs:label "SpeciesIndividual" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://purl.uniprot.org/core/Taxon> a owl:Class .

<http://lod.taxonconcept.org/ontology/txn.owl#Year> a owl:Class ;
    rdfs:label "Year"@en ;
    rdfs:comment "Class for the Concept Year"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf time:DateTimeDescription ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#scientificName> a owl:DatatypeProperty ;
    rdfs:label "scientificName" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://purl.org/biodiversity/taxon/scientificName> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#Occurrence> a owl:Class ;
    rdfs:label "Occurrence" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ;
    ns1:term_status "testing" .

foaf:page a owl:ObjectProperty .

<http://purl.org/ontology/bibo/Webpage> a owl:Class .

<http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> a owl:Class ;
    rdfs:label "TaxonNameID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/biodiversity/taxon/TaxonNameID> .

<http://lod.taxonconcept.org/ontology/txn.owl#TaxonRank> a owl:Class ;
    rdfs:label "TaxonRank" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

onto: a <http://labs.mondeca.com/vocab/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "TaxonConcept Ontology"@en ;
    dcterms:creator <http://lod.taxonconcept.org/ontology/people.owl#Peter_J_DeVries> ;
    dcterms:description "Version 0.976 This is an ontology for dealing with data related to species including observations, specimens, images etc. Traditionally species have been identified by the combination of a genus and specific epithet, for example Puma concolor. However these names change frequently as new information moves a given species into a different genus etc. Most of the time the species concept itself is unchanged. This leads a lot of confusion and difficulty connecting data relating to a given species concept together. This ontology and the related TaxonConcept data set avoids this by minting identifiers that are tied to a specific species concept which can have several names and classifications. The RDF descriptions of each species concept provides some guide as to what is the best species concept for a given specimen or observation, and links together data sets containing additional information about that concept. Since some of these related data sets entail specific names or classifications they are loosely linked using skos:closeMatch etc. Depending on your particular needs, you might want to merge these in your own knowledge base as sameAs or simply merge those properties that you think are appropriate."@en ;
    dcterms:modified "2013-05-19" ;
    dcterms:publisher <http://lod.taxonconcept.org/ontology/txn.owl#TaxonConcept_Knowledge_Base_Project> ;
    dcterms:title "TaxonConcept Ontology"@en ;
    vann:preferredNamespacePrefix "txn" ;
    vann:preferredNamespaceUri "http://lod.taxonconcept.org/ontology/txn.owl#" ;
    rdfs:comment "Version 0.976 Added additional GenusNameID, SubfamilyNameID and FamilyNameID for NLP project"@en ;
    rdfs:seeAlso <http://labs.mondeca.com/dataset/lov/details/vocabulary_txn.html>,
        <http://lod.taxonconcept.org/ontology/doc/index.html>,
        <http://lod.taxonconcept.org/ontology/void.rdf>,
        <http://purl.org/NET/biol/ns>,
        <http://purl.org/ontology/bibo/>,
        <http://vocab.deri.ie/void>,
        <http://www.w3.org/TR/skos-reference/skos-owl1-dl.rdf>,
        foaf: ;
    owl:versionInfo 0.976 .

[] a owl:AllDifferent ;
    owl:distinctMembers ( <http://lod.taxonconcept.org/ontology/txn.owl#Sex_female> <http://lod.taxonconcept.org/ontology/txn.owl#Sex_hermaphrodite> <http://lod.taxonconcept.org/ontology/txn.owl#Sex_male> <http://lod.taxonconcept.org/ontology/txn.owl#Sex_undetermined> <http://lod.taxonconcept.org/ontology/txn.owl#Sex_unknowable> ) .

