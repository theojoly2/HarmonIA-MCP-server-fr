    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#GenusNameID> a owl:Class ;
    rdfs:label "GenusNameID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#MonomialNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#MarineHabitat> a owl:Class ;
    rdfs:label "FreshwaterHabitat" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#Habitat> ;
    owl:equivalentClass <http://purl.org/ontology/wo/MarineHabitat> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#OccurrenceSpecimenTag> a owl:Class ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#OccurrenceTaxonTag> a owl:Class ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#OpenCycTaxon> a owl:Class ;
    rdfs:label "OpenCycTaxon" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#RankDivision> a <http://lod.taxonconcept.org/ontology/txn.owl#TaxonRank>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rank Division" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#RankSubdivision> a <http://lod.taxonconcept.org/ontology/txn.owl#TaxonRank>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rank Subdivision" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#RankSubspecificAggregate> a <http://lod.taxonconcept.org/ontology/txn.owl#TaxonRank>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rank SubspecificAggregate" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" ;
    skos:broader <http://lod.taxonconcept.org/ontology/txn.owl#RankSpecies> .

<http://lod.taxonconcept.org/ontology/txn.owl#RankSuperdivision> a <http://lod.taxonconcept.org/ontology/txn.owl#TaxonRank>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rank Superdivision" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#RankVariety> a <http://lod.taxonconcept.org/ontology/txn.owl#TaxonRank>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rank Variety" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" ;
    skos:broader <http://lod.taxonconcept.org/ontology/txn.owl#RankSpecies> .

<http://lod.taxonconcept.org/ontology/txn.owl#ScientificAuthorPerson> a owl:Class ;
    rdfs:label "ScientificAuthorPerson" ;
    rdfs:comment "Someone who has authored a scientific article." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#Scientist> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#ScientificCollectorPerson> a owl:Class ;
    rdfs:label "ScientificCollectorPerson" ;
    rdfs:comment "Someone who has collected a scientific sample or specimen." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#Scientist> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#ScientificDataCuratorPerson> a owl:Class ;
    rdfs:label "ScientificDataCuratorPerson" ;
    rdfs:comment "Someone who has curated or entered data into a scientific data set." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#Scientist> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#ScientificIdentifierPerson> a owl:Class ;
    rdfs:label "ScientificIdentifierPerson" ;
    rdfs:comment "Someone who has identified a specimen." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#Scientist> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#ScientificNameWithAuthorID> a owl:Class ;
    rdfs:label "ScientificNameWithAuthorID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#SpeciesImageTag> a owl:Class ;
    rdfs:label "SpeciesImageTag" ;
    rdfs:comment "A tag like entity that can be used to indicate that an image is associated with a specific species concept. Instances of SpeciesImageTag take the form of the species concept URI with the fragment of #Image rather than #Species." ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#SpeciesIndividualTag> a owl:Class ;
    rdfs:label "SpeciesIndividualTag" ;
    rdfs:comment "A tag like entity that can be used to indicate that an individual organism is an associated with a particular species concept. Instances of SpeciesIndividualTag take the form of the species concept URI with the fragment of #Individual rather than #Species." ;
    rdfs:isDefinedBy onto: .

<http://lod.taxonconcept.org/ontology/txn.owl#SpeciesModel> a owl:Class ;
    rdfs:label "SpeciesModel" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#SpeciesOriginalDescription> a owl:Class ;
    rdfs:label "SpeciesOriginalDescription" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#SpeciesTaxonomyNCBI> a owl:Class ;
    rdfs:label "SpeciesTaxonomyNCBI" ;
    rdfs:comment "A tag like entity for the NCBI Taxonomic Classification." ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#Specimen> a owl:Class ;
    rdfs:label "Specimen" ;
    rdfs:comment "A organismal specimen that is related to a specific organism, parts of an individual organism, or a collection of these from several organisms. It should be used for the smallest entity in a specimen database. Ideally there should be at least one specimen per individual organism. Specimens consisting of multiple individuals or multiple species often complicate analysis. If one photo contains multiple entities, document these as separate specimens all linked to the same photo." ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#Status_Preliminary> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Status_Preliminary" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#Status_Testing> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Status_Testing" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#SubfamilyNameID> a owl:Class ;
    rdfs:label "SubfamilyNameID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#MonomialNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#SurrogateNameID> a owl:Class ;
    rdfs:label "SurrogateNameID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#TDWG2010_BioBlitz_Project> a owl:NamedIndividual,
        foaf:Project ;
    rdfs:label "TDWG2010 BioBlitz Project" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#TaxonConcept_Scheme> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "TaxonConcept_Scheme" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameGroupID> a owl:Class ;
    rdfs:label "TaxonNameGroupID" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#TaxonOntology> a owl:Class ;
    rdfs:label "TaxonOntology" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#TerrestrialHabitat> a owl:Class ;
    rdfs:label "TerrestrialHabitat" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#Habitat> ;
    owl:equivalentClass <http://purl.org/ontology/wo/TerrestrialHabitat> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#TrinomialNameID> a owl:Class ;
    rdfs:label "TrinomialNameID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#ScientificNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#acceptedName> a owl:DatatypeProperty ;
    rdfs:label "acceptedName" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:prefLabel ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#acceptedTaxonNameID_Of> a owl:ObjectProperty ;
    rdfs:label "acceptedTaxonNameID_Of" ;
    rdfs:domain <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lod.taxonconcept.org/ontology/txn.owl#taxonNameID_Of> ;
    owl:inverseOf <http://lod.taxonconcept.org/ontology/txn.owl#acceptedNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#altAcceptedNameID> a owl:ObjectProperty ;
    rdfs:label "altAcceptedNameID" ;
    rdfs:comment "The URI to an Alternative Accepted Name String" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    rdfs:subPropertyOf <http://lod.taxonconcept.org/ontology/txn.owl#taxonNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#altAcceptedNameID_Of> a owl:ObjectProperty ;
    rdfs:label "altAcceptedNameID_Of" ;
    rdfs:comment "The URI to an Alternative Accepted Name String" ;
    rdfs:domain <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lod.taxonconcept.org/ontology/txn.owl#taxonNameID_Of> ;
    owl:inverseOf <http://lod.taxonconcept.org/ontology/txn.owl#originalNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#areaHasIndividual> a owl:ObjectProperty ;
    rdfs:label "areaHasIndividual" ;
    rdfs:comment "Links an Area to an Individual" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#areaHasObservedSpeciesConcept> a owl:ObjectProperty ;
    rdfs:label "areaHasObservedSpeciesConcept" ;
    rdfs:comment "Links an Area to a Species Concept" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#areaHasOccurrence> a owl:ObjectProperty ;
    rdfs:label "areaHasOccurrence" ;
    rdfs:comment "Links an Area to an Occurrence" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#areaInCounty> a owl:ObjectProperty ;
    rdfs:label "areaInCounty" ;
    rdfs:comment "Links an Area to Geonames County URI" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#areaInStateProvince> a owl:ObjectProperty ;
    rdfs:label "areaInStateProvince" ;
    rdfs:comment "Links an Area to Geonames State/Province URI" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#authority> a owl:DatatypeProperty ;
    rdfs:label "authority" ;
    rdfs:comment "The author and year of the species description publication i.e (Baker, 1899)" ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://purl.org/NET/biol/ns#authority> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#basisOfRecord> a owl:ObjectProperty ;
    rdfs:label "basisOfRecord" ;
    rdfs:comment "Assumed to be equivalent to TDWG Basis of Record" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#behavioralNote> a owl:DatatypeProperty ;
    rdfs:label "behavioralNote" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#binomial> a owl:DatatypeProperty ;
    rdfs:label "binomial" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://purl.org/biodiversity/taxon/binomial> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#botanyAuthorName> a owl:DatatypeProperty ;
    rdfs:label "botany author abbreviation" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf foaf:nick ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#canonicalFormID> a owl:ObjectProperty ;
    rdfs:label "canonicalFormID" ;
    rdfs:comment "The URI ID for the canonical form of the name i.e. Puma concolor or Felidae, for name to name mapping" ;
    rdfs:domain <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    rdfs:subPropertyOf <http://lod.taxonconcept.org/ontology/txn.owl#relatedTaxonNameID> .

<http://lod.taxonconcept.org/ontology/txn.owl#canonicalFormID_Of> a owl:ObjectProperty ;
    rdfs:label "canonicalFormID Of" ;
    rdfs:comment "The URI ID for the scientific name with authorship form of the name i.e. Puma concolor Linnaeus 1758, for name to name mapping" ;
    rdfs:domain <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    rdfs:subPropertyOf <http://lod.taxonconcept.org/ontology/txn.owl#relatedTaxonNameID> .

<http://lod.taxonconcept.org/ontology/txn.owl#catalogCode> a owl:DatatypeProperty ;
    rdfs:label "catalogCode" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#class> a owl:DatatypeProperty ;
    rdfs:label "class" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lod.taxonconcept.org/ontology/txn.owl#scientificName> ;
    owl:equivalentProperty <http://purl.org/NET/biol/ns#class> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#collectionCode> a owl:DatatypeProperty ;
    rdfs:label "collectionCode" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#commonName> a owl:DatatypeProperty ;
    rdfs:label "commonName" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://purl.org/biodiversity/taxon/commonName> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#conceptStatus> a owl:ObjectProperty ;
    rdfs:label "conceptStatus" ;
    rdfs:comment "The Links to the Status of the TaxonConcept" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#continent> a owl:DatatypeProperty ;
    rdfs:label "continent" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#country> a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#countryCode> a owl:DatatypeProperty ;
    rdfs:label "countryCode" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#county> a owl:DatatypeProperty ;
    rdfs:label "county" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#descYearOf> a owl:ObjectProperty ;
    rdfs:label "descYearOf" ;
    rdfs:domain <http://lod.taxonconcept.org/ontology/txn.owl#Year> ;
    rdfs:isDefinedBy onto: ;
    owl:inverseOf <http://lod.taxonconcept.org/ontology/txn.owl#descYear> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#endDate> a owl:DatatypeProperty ;
    rdfs:label "endDate" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#family> a owl:DatatypeProperty ;
    rdfs:label "family" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lod.taxonconcept.org/ontology/txn.owl#scientificName> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#featureContainsArea> a owl:ObjectProperty ;
    rdfs:label "featureContainsArea" ;
    rdfs:comment "This is used to link a geonames feature to a geo area. For example geo:44.86528100,-87.23147800;u=10" ;
    rdfs:domain <http://www.geonames.org/ontology#Feature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://lod.taxonconcept.org/ontology/txn.owl#Area> ;
    rdfs:subPropertyOf dcterms:hasPart ;
    owl:inverseOf <http://lod.taxonconcept.org/ontology/txn.owl#areaWithInFeature> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#firstAuthorID> a owl:ObjectProperty ;
    rdfs:label "firstAuthorID" ;
    rdfs:comment "The URI to the First Author" ;
    rdfs:domain <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://lod.taxonconcept.org/ontology/txn.owl#Taxonomist> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#genus> a owl:DatatypeProperty ;
    rdfs:label "genus" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lod.taxonconcept.org/ontology/txn.owl#scientificName> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#georeferenceProtocol> a owl:ObjectProperty ;
    rdfs:label "georeferenceProtocol" ;
    rdfs:comment "The method used to determine the latitude, longitude as a URI" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#georeferenceVerificationStatus> a owl:ObjectProperty ;
    rdfs:label "georeferenceVerificationStatus" ;
    rdfs:comment "Was this location verified, controlled choices URI" ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#habitat> a owl:ObjectProperty ;
    rdfs:label "habitat" ;
    rdfs:comment "associates a taxon with a habitat in which it may typically be found" ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://purl.org/ontology/wo/habitat> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#hasADWPage> a owl:ObjectProperty ;
    rdfs:label "hasADWPage" ;
