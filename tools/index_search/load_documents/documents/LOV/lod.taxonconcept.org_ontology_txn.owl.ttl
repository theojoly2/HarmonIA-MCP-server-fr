<http://bio2rdf.org/uniprot_resource:Taxon> a owl:Class .

<http://dbpedia.org/property/binomial> a owl:DatatypeProperty .

<http://dbpedia.org/property/classis> a owl:DatatypeProperty .

<http://dbpedia.org/property/familia> a owl:DatatypeProperty .

<http://dbpedia.org/property/genus> a owl:DatatypeProperty .

<http://dbpedia.org/property/ordo> a owl:DatatypeProperty .

<http://dbpedia.org/property/phylum> a owl:DatatypeProperty .

<http://dbpedia.org/property/regnum> a owl:DatatypeProperty .

<http://dbpedia.org/property/species> a owl:DatatypeProperty .

<http://dbpedia.org/property/synonym> a owl:DatatypeProperty .

<http://dbpedia.org/property/trinomial> a owl:DatatypeProperty .

<http://lod.taxonconcept.org/ontology/dwc_area.owl#Area> a owl:Class .

<http://lod.taxonconcept.org/ontology/dwc_area.owl#radius> a owl:DatatypeProperty .

<http://lod.taxonconcept.org/ontology/txn.owl#BinomialNameID> a owl:Class ;
    rdfs:label "BinomialNameID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#ScientificNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#CommonNameID> a owl:Class ;
    rdfs:label "CommonNameID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#TaxonNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#DataObject> a owl:Class ;
    rdfs:label "DataObject"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/biodiversity/taxon/DataObject> .

<http://lod.taxonconcept.org/ontology/txn.owl#FamilyNameID> a owl:Class ;
    rdfs:label "FamilyNameID" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lod.taxonconcept.org/ontology/txn.owl#MonomialNameID> ;
    ns1:term_status "testing" .

<http://lod.taxonconcept.org/ontology/txn.owl#FreshwaterHabitat> a owl:Class ;
