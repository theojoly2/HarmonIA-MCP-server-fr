            owl:onProperty <http://qudt.org/schema/qudt#unit> ],
        <http://qudt.org/schema/qudt#QuantityValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> a owl:Class ;
