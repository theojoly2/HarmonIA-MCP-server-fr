<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum> a owl:Class ;
    rdfs:comment "Descriptors for describing area locations."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegEnumerations> ;
