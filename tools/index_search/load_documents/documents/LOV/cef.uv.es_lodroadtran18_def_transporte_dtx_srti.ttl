<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useIntersectionOrJunction> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReroutingManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Rerouted traffic is to use the specified intersection or junction to commence the alternative route."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useOfSpecifiedLanesOrCarriagewaysAllowed> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadOrCarriagewayOrLaneManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "The specified lane(s) or carriageway(s) may be used. The normal lane(s) or carriageway(s) restrictions are not currently in force."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useRailService> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsersTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Use rail service."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useSnowChains> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WinterEquipmentManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Use snow chains."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useSnowChainsOrTyres> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WinterEquipmentManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Use snow chains or snow tyres."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useSnowTyres> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WinterEquipmentManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Use snow tyres."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useSpecifiedLanesOrCarriageways> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadOrCarriagewayOrLaneManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Use the specified lane(s) or carriageway(s)."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useTramService> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsersTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Use tram service."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useUndergroundService> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsersTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Use underground service."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#van> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Van."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vandalism> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CauseTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A vandalism incident."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleFailure> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AccidentCauseEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Malfunction or failure of vehicle function."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleOnFire> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstructionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A vehicle is or has been on fire and may cause traffic disruption."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleOnWrongCarriageway> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstructionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A vehicle is travelling the wrong way along a divided highway (i.e. on the wrong side)."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleProbeMeasurement> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SourceTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A specially equipped vehicle used to provide measurements."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleRecovery> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadsideAssistanceTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle recovery."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleRepair> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadsideAssistanceTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle repair assistance."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleStorageInOperation> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadOrCarriagewayOrLaneManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicles are being stored on the roadway and/or at a rest area or service area at the specified location."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleStuck> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstructionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "One or more vehicles are stuck (i.e. unable to move) due to environmental conditions such as a snow drift or severe icy road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleWithCaravan> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle (of unspecified type) towing a caravan."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleWithCatalyticConverter> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle with catalytic converter."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleWithOverwideLoad> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstructionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A vehicle of width greater than that normally allowed which may cause traffic disruption."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleWithTrailer> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle (of unspecified type) towing a trailer."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleWithoutCatalyticConverter> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle without catalytic converter."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#verge> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LaneEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On the verge."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#veryHazardous> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DrivingConditionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Driving conditions are very hazardous due to environmental conditions."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#veryImportantPerson> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PersonCategoryEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A very important person."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#veryLongDelays> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DelaysTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Delays on the road network of abnormally unusual severity."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#videoProcessingMonitoringStation> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SourceTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A station dedicated to the monitoring of the road network by processing video image information."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#visibilityReduced> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PoorEnvironmentTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Environmental conditions causing reduced visibility."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vms> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InformationDeliveryServicesEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Variable Message Signs or any other visual roadside devices which information are accessible to drivers which aim to affect driving style improving safety and road network LoS."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#waitForEscortVehicle> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsersTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Wait for escort vehicle."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ward> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Ward"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#waterArea> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedAreaTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Water area"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#waterMain> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubjectTypeOfWorksEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Water main under or along the highway."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#waterSportsMeeting> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PublicEventTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Water sports meeting that could disrupt traffic."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#weakBridge> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDamageTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Weak bridge capable of carrying a reduced load, typically with a reduced weight limit restriction imposed."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#weightRestrictionInOperation> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadOrCarriagewayOrLaneManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A weight restriction is in operation."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#westBound> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum>,
        owl:NamedIndividual ;
    rdfs:comment "West bound general direction." .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#winterConditions> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DrivingConditionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Driving conditions are consistent with those expected in winter."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#winterEquipmentOnBoardRequired> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WinterEquipmentManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "The carrying of winter equipment (snow chains and/or snow tyres) is required."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#winterSportsMeeting> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PublicEventTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Winter sports meeting or event (e.g. skiing, ski jumping, skating) that could disrupt traffic."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#withEvenNumberedRegistrationPlates> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle with even numbered registration plate."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#withOddNumberedRegistrationPlates> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle with odd numbered registration plate."@en .

<http://data.europa.eu/nuts/code/> a owl:Class ;
    rdfs:label "NutsResource"@en ;
    rdfs:comment "A NUTS code (Nomenclature of territorial units for statistics)."@en ;
    rdfs:isDefinedBy "http://data.europa.eu/nuts/" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://datex2.eu/schema/3/Common/3_1#GmlPosList> a rdfs:Datatype ;
    rdfs:comment "List of coordinates, space-separated, within the same coordinate reference system, defining a geometric entity. Modelled on DirectPositionListType in GML (EN ISO 19136), but constrained to represent a 2D or 3D polyline."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://datex2.eu/schema/3/Common/3_1#VehiclesPerHour> a rdfs:Datatype ;
    rdfs:comment "Vehicles per hour."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#ramon_geoObjectProperties> a owl:ObjectProperty ;
    rdfs:comment "Only for organizational purposes. Ramon geographyt object properties"@en ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedObjectProperties> .

<http://qudt.org/vocab/unit/M> a owl:NamedIndividual ;
    rdfs:label "Meter"@en ;
    dcterms:description "The metric and SI base unit of distance. The 17th General Conference on Weights and Measures in 1983 defined the meter as that distance that makes the speed of light in a vacuum equal to exactly 299 792 458 meters per second. The speed of light in a vacuum,  , is one of the fundamental constants of nature. The meter is equal to approximately 1.093 613 3 yards, 3.280 840 feet, or 39.370 079 inches."@en ;
    rdfs:comment "Unit of Measure: Meter"@en ;
    rdfs:isDefinedBy "http://qudt.org/2.1/vocab/unit"@en .

<http://www.omg.org/spec/LCC/Countries/CountryRepresentation#CountrySubdivision> a owl:Class ;
    rdfs:comment "Country Subdivision Code from LCC Countries Representation"@en ;
    rdfs:isDefinedBy "http://www.omg.org/spec/LCC/Countries/CountryRepresentation#" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LCC_CountryRepresentation> .

time:Instant rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#Region> rdfs:isDefinedBy "https://ec.europa.eu/eurostat/ramon/" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Ramon_geoClasses> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Alpha2Code> a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:comment "The default language used throughout the payload publication. Identifies a specified language by an ISO 639-1 2-alpha code."@en ;
    rdfs:isDefinedBy "https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> ;
    skos:note "In the ISO 639-1 language code, each language identifier is composed of two letters (lower case letters from the Latin alphabet, corresponding to characters 97 through 122 of the UTF-8 encoding), without diacritical marks or other encodings of any kind."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Activity> a owl:Class ;
    rdfs:comment "A collection of information relating to human activities external to the traffic stream or roadway which could disrupt traffic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Mobility> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobilityOfActivity> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2Linear> a owl:Class ;
    rdfs:comment "A linear section along a road between two points, primary and secondary, which are pre-defined in an ALERT-C location table. Direction is FROM the secondary point TO the primary point, i.e. the primary point is downstream of the secondary point." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCDirection> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2PrimaryPointLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCMethod2PrimaryPointLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2SecondaryPointLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCMethod2SecondaryPointLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinear> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2SecondaryPointLocation> a owl:Class ;
    rdfs:comment "The point (called Secondary point) which is at the upstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4Linear> a owl:Class ;
    rdfs:comment "A linear section along a road between two points, primary and secondary, which are pre-defined ALERT-C locations plus offset distance. Direction is FROM the secondary point TO the primary point, i.e. the primary point is downstream of the secondary point." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCDirection> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4SecondaryPointLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCMethod4SecondaryPointLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4PrimaryPointLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCMethod4PrimaryPointLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinear> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralObstruction> a owl:Class ;
    rdfs:comment "Any stationary or moving obstacle of a physical nature, other than of an animal, vehicle, environmental, or damaged equipment nature."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ObstructionTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasObstructionTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> ;
    owl:disjointWith <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstruction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Gml> a owl:Class ;
    rdfs:comment "GML location"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationObjects> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLinearRing> a owl:Class ;
    rdfs:comment "Closed line string not self-intersecting (i.e. having as last point the first point)"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLineString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LCC_CountryRepresentation> a owl:Class ;
    rdfs:comment "Country Representation ontology provides a reference model to support the first two parts of ISO 3166, along with the other coding systems:\\n - ISO 3166-1 (Country codes) establishes codes that represent the current names of countries, dependencies, and other areas of particular geopolitical interest, on the basis of lists of country names obtained from the United Nations.\\n - ISO 3166-2 (Country subdivision code) establishes a code that represents the names of the principal administrative divisions, or similar areas, of the countries, etc. included in the ISO 3166-1.\\n - ISO 3166-3 (Code for formerly used names of countries) establishes a code that represents non-current country names, i.e., the country names deleted from ISO 3166 since its first publication in 1974."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ImportedClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Lane> a owl:Class ;
    rdfs:comment "Indicates a specific lane or group of lanes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:integer ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#laneNumber> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LaneEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLaneEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalPack> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementByPoints> a owl:Class ;
    rdfs:comment "A linear element along a single linear object defined by its start and end points."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElement> [ a owl:Restriction ;
                        owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
                        owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentEndPointLinearElement> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
                        owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentIntermediatePointLinearElement> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
                        owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentStartPointLinearElement> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkLocation> a owl:Class ;
    rdfs:comment ""@en,
        "The specification of a location on a network (as a point or a linear location).Association: 0..1 SupplementaryPositionalDescription"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSupplementaryPositionalDescription> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Location> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrGeoCoordinate> a owl:Class ;
    rdfs:comment "A geo-coordinate pair is a position in a map defined by its longitude and latitude coordinate values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrCoordinates> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPointLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPolygonCorners> a owl:Class ;
    rdfs:comment "A geodetic coordinate Tuple that defines the vertices of the underlying geometrical polygon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPointCoordinates> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OperatorAction> a owl:Class ;
    rdfs:comment "Actions that a traffic operator can decide to implement to prevent or help correct dangerous or poor driving conditions, including maintenance of the road infrastructure."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinatesAssociationsFrom> a owl:Class ;
    rdfs:comment "Only for organizational purposes.Package PointCoordinates."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SingleRoadLinearLocation> a owl:Class ;
    rdfs:comment "Location representing a linear section along a single road with optional directionality defined between two points on the same road. No matter the kind of linear reference it uses, the constraint of using only a single road must be preserved. Associations:\\n0..1\\tTpegLinearLocation\\n0..*\\tAlertCLinear"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLinearLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegLinearLocation> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Situation> a owl:Class ;
    rdfs:comment "An identifiable instance of a traffic/travel situation comprising one or more traffic/travel circumstances which are linked by one or more causal relationships. Each traffic/travel circumstance is represented by a Situation Record."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeaderInformation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeaderInformation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSituationRecord> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadPublishing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SkosClasses> a owl:Class ;
    rdfs:comment "Skos Vocabulary"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ImportedClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TPEGLoc01LinearLocationSubtypeEnum> a owl:Class ;
    rdfs:comment "Types of linear location."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#segment> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegGeometricArea> a owl:Class ;
    rdfs:comment "A geometric area defined by a centre point and a radius."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaDescriptor> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegAreaDescriptor> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#radius> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasCentrePoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegJunctionPointDescriptor> a owl:Class ;
    rdfs:comment "A descriptor for describing a point at a junction on a road network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03JunctionPointDescriptorSubtypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegJunctionPointDescriptorType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPointDescriptor> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01FramedPointLocationSubtypeEnum> a owl:Class ;
    rdfs:comment "Types of points on the road network framed by two other points on the same road."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#framedPoint> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03JunctionPointDescriptorSubtypeEnum> a owl:Class ;
    rdfs:comment "Descriptors for describing a point at a road junction."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#junctionName> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegOtherPointDescriptor> a owl:Class ;
    rdfs:comment "General descriptor for describing a point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegOtherPointDescriptorType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPointDescriptor> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPointDescriptor> a owl:Class ;
    rdfs:comment "A descriptor for describing a point location."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegDescriptor> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Vehicle> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleStatusEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVehicleStatus> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleCharacteristics> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVehicleCharacteristics> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleCharacteristics> a owl:Class ;
    rdfs:comment "The characteristics of a vehicle, e.g. lorry of gross weight greater than 30 tonnes."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WeatherRelatedRoadConditions> a owl:Class ;
    rdfs:comment "Road surface conditions that are related to the weather which may affect the driving conditions, such as ice, snow or water."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NonWeatherRelatedRoadConditions> ],
        [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasWeatherRelatedRoadConditionTypeEnum> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WeatherRelatedRoadConditionType> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadSurfaceConditions> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#againstLineDirection> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOrientationEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Against line direction"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationCountryCode> a owl:DatatypeProperty ;
    rdfs:comment "ALERT-C country code as defined in IEC 62106."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCArea> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinear> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCPoint> ) ] ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationTableNumber> a owl:DatatypeProperty ;
    rdfs:comment "Number allocated to an ALERT-C table in a country. Ref. EN ISO 14819-3 for the allocation of a location table number."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCArea> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinear> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCPoint> ) ] ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationTableVersion> a owl:DatatypeProperty ;
    rdfs:comment "Version number associated with an ALERT-C table reference."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCArea> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinear> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCPoint> ) ] ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobility> a owl:ObjectProperty ;
    rdfs:comment "An indication of whether the associated instance of a SituationRecord is mobile (e.g. a march or parade moving along a road) or stationary."@en ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Mobility> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNamedArea> a owl:ObjectProperty ;
    rdfs:comment "An area defined by a name and/or in terms of known boundaries, such as country or county boundaries or allocated control area of particular authority. The attributes do not form a union; instead, the smallest intersection forms the resulting area."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaLocation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLastLocationReferencePoint> a owl:ObjectProperty ;
    rdfs:comment "Allows defining the last point of the OpenLR path"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBasePointLocation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrClosedLineLocationReference> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineLocationReference> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLastLocationReferencePoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLocationReferencePoint> a owl:ObjectProperty ;
    rdfs:comment "Allows defining the first point of the OpenLR path"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBasePointLocation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrClosedLineLocationReference> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineLocationReference> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLocationReferencePoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#left> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrSideOfRoadEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On the left side of the road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#noOrientationOrUnknown> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOrientationEnum>,
        owl:NamedIndividual ;
    rdfs:comment "No orientation or unknown"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onRoadOrUnknown> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrSideOfRoadEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On road or unknown"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#right> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrSideOfRoadEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On the right side of the road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#withLineDirection> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOrientationEnum>,
        owl:NamedIndividual ;
    rdfs:comment "With line direction"@en .

<http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#skosAnnotationProperties> a owl:AnnotationProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2PrimaryPointLocation> a owl:Class ;
    rdfs:comment "The point (called Primary point) which is either a single point or at the downstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4SecondaryPointLocation> a owl:Class ;
    rdfs:comment "The point (called Secondary point) which is at the upstream end of a linear road section. The point is specified by a reference to a point in a pre-defined Alert-C location table plus a non-negative offset distance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OffsetDistance> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOffsetDistance> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AltitudeConfidence> a owl:Class ;
    rdfs:comment "Evaluation of the altitude confidence assessed according to ETSI ISO 102894-2" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceCodedErrorEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPositionConfidenceCodedErrorEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AltitudeAccuracyEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAltitudeAccuracyCodedValue> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightCoordinateAssociationFrom> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Carriageway> a owl:Class ;
    rdfs:comment "Supplementary positional information which details carriageway and lane locations. Several instances may exist where the element being described extends over more than one carriageway."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:int ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#originalNumberOfLanes> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNamedArea> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CarriagewayEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasCarriagewayEnum> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalPack> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Conditions> a owl:Class ;
    rdfs:comment "Any conditions which have the potential to degrade normal driving conditions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DrivingConditionTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDrivingConditionTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficElement> ;
    owl:disjointWith <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConstructionWorkTypeEnum> a owl:Class ;
    rdfs:comment "Types of works relating to construction."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#blastingWork> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#constructionWork> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionPurposeEnum> a owl:Class ;
    rdfs:comment "Main purpose of a direction of a road"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inbound> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#outbound> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceFromLinearElementReferent> a owl:Class ;
    rdfs:comment "Distance of a point along a linear element measured from a \"from referent\" on the linear element, in the sense relative to the linear element definition rather than the direction of traffic flow or optionally towards a \"towards referent\"."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#distanceAlong> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentTowards> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentFrom> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlMultiPolygon> a owl:Class ;
    rdfs:comment "An area defined by a set of polygons acording to GML (EN ISO 19136)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGmlPolygon> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlPolygon> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#gmlAreaName> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Gml> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlPolygon> a owl:Class ;
    rdfs:comment "Planar surface defined by 1 exterior boundary and 0 or more interior boundaries"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLinearRing> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGmlExteriorLinearRing> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Gml> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InformationDeliveryServicesEnum> a owl:Class ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#anyGeneralDeliveryService> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#safetyServices> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vms> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InternationalIdentifier> a owl:Class ;
    rdfs:comment "An identifier/name whose range is specific to the particular country." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://www.omg.org/spec/LCC/Countries/CountryRepresentationi#Alpha2Code> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#country> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nationalIdentifier> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearLocation> a owl:Class ;
    rdfs:comment "Location representing a linear section with optional directionality defined between two points. Any LinearLocation must have an instance of at least one of these classes. If using multiple instances, producers must take care to ensure they represent the same location.\\nAssociations:\\n0..1\\tOpenlrLinear\\n0..1\\tGmlLineString\\n0..1\\tSupplementaryPositionalDescription"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLineString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGmlLineString> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLinear> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLinear> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSecondarySupplementaryDescription> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationObjects> a owl:Class ;
    rdfs:comment "Only for organizational purposes"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadPublishing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReference> a owl:Class ;
    rdfs:comment "Represents one or more physically separate locations. Multiple locations may be related, as in an itinerary or route, or may be unrelated. One LocationReference should not use multiple Location objects to represent the same physical location. In SRTI is not included LocationGroup"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MaintenanceVehicles> a owl:Class ;
    rdfs:comment "Details of the maintenance vehicles involved in the roadworks activity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfMaintenanceVehicles> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadPublishing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OffsetDistance> a owl:Class ;
    rdfs:comment "The non-negative offset distance from the ALERT-C referenced point to the actual point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#offsetDistance> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBaseReferencePoint> a owl:Class ;
    rdfs:comment "Base class used to hold data about a reference point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineAttributes> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLineAttributes> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrEnumerations> a owl:Class ;
    rdfs:comment "Only for organizational purposes"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Enums> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLastLocationReferencePoint> a owl:Class ;
    rdfs:comment "The sequence of location reference points is terminated by a last location reference point."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBaseReferencePoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPathAttributes> a owl:Class ;
    rdfs:comment "Properties of the path from the associated location reference point to the next location reference point, which are specified to assist correct identification of the point in an external map data source."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrDistanceToNextLRPoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrFunctionalRoadClassEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLowestFrcToNextLRPoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPointLocationReference> a owl:Class ;
    rdfs:comment "A point location is a zero-dimensional element in a map that specifies a geometric location."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointByCoordinates> a owl:Class ;
    rdfs:comment "A single point defined only by a coordinate set with an optional bearing direction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AngleInDegreesValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#bearing> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPointCoordinates> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinatesAssociationsTo> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadInformation> a owl:Class ;
    rdfs:comment "Information on a road"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/roads#RoadNumber> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadNumber> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadName> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadDestination> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalPack> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedValue> a owl:Class ;
    rdfs:comment "A measured or calculated value of speed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/KiloM-PER-HR> ;
            owl:onProperty <http://qudt.org/schema/qudt#unit> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:float ;
            owl:onProperty <http://qudt.org/schema/qudt#numericValue> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://qudt.org/schema/qudt#QuantityValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Subjects> a owl:Class ;
    rdfs:comment "The subjects with which the roadworks are associated."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfSubjects> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubjectTypeOfWorksEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSubjectTypeOfWorks> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaDescriptor> a owl:Class ;
    rdfs:comment "A descriptor for describing an area location."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegAreaDescriptorType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegDescriptor> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegDescriptor> a owl:Class ;
    rdfs:comment "A collection of information providing descriptive references to locations using the TPEG-Loc location referencing approach."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/roads#RoadNumber> ) ] ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#descriptor> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#descriptorString> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegFramedPoint> a owl:Class ;
    rdfs:comment "A point on the road network which is framed between two other points on the same road."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegNonJunctionPoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegFramedPoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegPointTo> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01FramedPointLocationSubtypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegFramedPointLocationType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegPointFrom> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPointLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegHeight> a owl:Class ;
    rdfs:comment "Height information which provides additional discrimination for the applicable area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc04HeightTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegHeightType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#height> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegIlcPointDescriptor> a owl:Class ;
    rdfs:comment "A descriptor for describing a junction by defining the intersecting roads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03IlcPointDescriptorSubtypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegIlcPointDescriptorType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPointDescriptor> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegJunction> a owl:Class ;
    rdfs:comment "A point on the road network which is a road junction point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegJunctionPointDescriptor> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegJunctionPointDescriptor> ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegIlcPointDescriptor> ;
                        owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegIlcPointDescriptor> ] [ a owl:Restriction ;
                        owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                        owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegIlcPointDescriptor> ;
                        owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegIlcPointDescriptor> ] ) ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> ;
    owl:disjointWith <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegNonJunctionPoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01AreaLocationSubtypeEnum> a owl:Class ;
    rdfs:comment "Types of area."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#largeArea> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01SimplePointLocationSubtypeEnum> a owl:Class ;
    rdfs:comment "Types of simple point."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#intersection> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nonLinkedPoint> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Validity> a owl:Class ;
    rdfs:comment "Specification of validity, either explicitly or by a validity time period specification which may be discontinuous."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ValidityStatusEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasValidityStatus> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OverallPeriod> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#validityTimeSpecification> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#administrativeAreaName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Name of an administrative area."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#administrativeReferenceName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Reference name by which administrative area is known."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#aligned> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Same direction as the normal direction of flow at this point on the road network."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#areaName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#countyName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Name of a county (administrative sub-division)."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#intersection> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReferentTypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01SimplePointLocationSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A crossing of two or more roads where the precise point of intersection is defined according to specific business rules.\\n\\nAn point on the road network at which one or more roads intersect."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#lakeName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Name of a lake."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#metropolitanArea> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedAreaTypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Metropolitan area"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#municipality> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedAreaTypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Municipality"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nationName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Name of a nation (e.g. Wales) which is a sub-division of a ISO recognised country."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#opposite> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Indicates that the direction of traffic flow affected by the situation or related to the traffic data is in the opposite sense to the direction in which the linear element is defined.\\nOpposite direction to the normal direction of flow at this point on the road network."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#regionName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Name of a geographic region."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#road> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementNatureEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubjectTypeOfWorksEnum>,
        owl:NamedIndividual ;
    rdfs:comment "The nature of the linear element is a road."@en,
        "road"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#seaName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Name of a sea."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#slipRoad> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementNatureEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrFormOfWayEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Slip Road. The nature of the linear element is a slip road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#townName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Name of a town."@en .

<http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#ramon_geoAnnotationProperties> a owl:AnnotationProperty .

<http://qudt.org/schema/qudt#QuantityValue> a owl:Class ;
    rdfs:label "QuantityValue"@en ;
    dc:source "http://qudt.org/schema/qudt#"@en ;
    rdfs:comment "A quantity value expresses the numerical value of a quantity with respect to a chosen unit of measure."@en ;
    rdfs:isDefinedBy "http://qudt.org/schema/qudt#" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> .

<http://qudt.org/schema/qudt#numericValue> a owl:DatatypeProperty ;
    rdfs:comment "Numeric Value for a quantity"@en ;
    rdfs:isDefinedBy "http://qudt.org/2.1/schema/qudt"@en,
        "http://qudt.org/schema/qudt"@en ;
    rdfs:subPropertyOf <http://qudt.org/schema/qudt#qudtDataTypeProperties> .

<http://qudt.org/schema/qudt#unit> a owl:ObjectProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "A reference to the unit of measure of a quantity (variable or constant) of interest."@en ;
    rdfs:isDefinedBy "http://qudt.org/2.1/schema/qudt"@en ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#qudtObjectProperties> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCArea> a owl:Class ;
    rdfs:comment "An area defined by reference to a predefined ALERT-C location table."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationTableVersion> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationTableNumber> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationCountryCode> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirectionEnum> a owl:Class ;
    rdfs:comment "Direction used to reach the primary location from the secondary location in ALERT-C location table, as defined in CEN ISO 14819-1"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#both> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#negative> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#positive> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4PrimaryPointLocation> a owl:Class ;
    rdfs:comment "The point (called Primary point) which is either a single point or at the downstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table plus a non-negative offset distance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OffsetDistance> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOffsetDistance> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AnimalPresenceTypeEmum> a owl:Class ;
    rdfs:comment "Types of animal presence."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#animalsOnTheRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#herdOfAnimalsOnTheRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#largeAnimalsOnTheRoad> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Delays> a owl:Class ;
    rdfs:comment "The details of the delays being caused by the situation element defined in the situation record. It is recommended to only use one of the optional attributes to avoid confusion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#delayTimeValue> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DelaysTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#delaysType> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DelayBandEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#delayBand> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DisturbanceActivityTypeEnum> a owl:Class ;
    rdfs:comment "Types of disturbance activities."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#crowd> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#demonstration> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#evacuation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeaderInformation> a owl:Class ;
    rdfs:comment "Management information relating to the data contained within a publication." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasConfidentiality> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConfidentialityValueEnum> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InformationStatusEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasInformationStatus> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightTypeEnum> a owl:Class ;
    rdfs:comment "Coded value for type of height"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ellipsoidalHeight> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#gravityRelatedHeight> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#relativeHeight> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearReferencing> a owl:Class ;
    rdfs:comment "Only for organizational purposes.Package LinearReferencing"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Location> a owl:Class ;
    rdfs:label "Location"@en ;
    dcterms:replaces "groupOfLocations"@en ;
    rdfs:comment "The specification of a location either on a network (as a point or a linear location) or as an area. This may be provided in one or more referencing systems. Association: 0..1PointCoordinates. In SRTI is not included LocationByReference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPointCoordinates> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MobilityTypeEnum> a owl:Class ;
    rdfs:comment "An indication of whether the associated instance of a SituationRecord is mobile (e.g. a march or parade moving along a road) or stationary."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#mobile> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#stationary> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unknown> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineAttributes> a owl:Class ;
    rdfs:comment "Line attributes are part of a location reference point and consists of functional road class (FRC),form of way (FOW) and bearing (BEAR) data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrFormOfWayEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrFormOfWayEnum> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrFunctionalRoadClassEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLowestFrcToNextLRPoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AngleInDegreesValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrBearing> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLinear> a owl:Class ;
    rdfs:comment "OpenLR line location reference"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineLocationReference> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrOppositeDirection> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineLocationReference> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrFirstDirection> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOffsets> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrOffsets> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLine> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLocationReferencePoint> a owl:Class ;
    rdfs:comment "The basis of a location reference is a sequence of location reference points (LRPs)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPathAttributes> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrPathAttributes> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBaseReferencePoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOffsets> a owl:Class ;
    rdfs:comment "Offsets are used to locate the start and end of a location more precisely than bounding to the nodes in a network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrNegativeOffset> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrPositiveOffset> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadEnumerations> a owl:Class ;
    rdfs:comment "Only for organizational purposes"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Enums> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadPublishing> a owl:Class ;
    rdfs:comment "Only for organizational purposes. Package PayloadPublication"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointLocation> a owl:Class ;
    rdfs:comment "At least one of these aggregated classes must be present. If using multiple instances of the agregated classes, producers must take care to ensure they present the same location.\\n\\nAssociations:\\n0..1\\tPointByCoordinates\\n0..*\\tPointAlongLinearElement\\n0..*\\tAlertCPoint\\n0..1\\tTpegPointLocation\\n0..1\\tOpenlrPointLocationReference"@en,
        "Location representing a single geospatial point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointByCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPointByCoordinates> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPointLocationReference> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrPointLocationReference> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPointLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegPointLocation> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RelativePositionOnCarriagewayEnum> a owl:Class ;
    rdfs:comment "Identifies a relative position across a carriageway"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inTheCentre> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onTheLeft> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onTheRight> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadworksDurationEnum> a owl:Class ;
    rdfs:comment "Expected durations of roadworks in general terms."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#longTerm> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#mediumTerm> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#shortTerm> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadworksScaleEnum> a owl:Class ;
    rdfs:comment "Grade of complexity of the roadworks according to the responsible road operator. For example determined by size, duration and/or traffic disruption."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#major> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#mediumRoadworksScale> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#minor> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalPack> a owl:Class ;
    rdfs:comment "Supplementary positional information"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03IlcPointDescriptorSubtypeEnum> a owl:Class ;
    rdfs:comment "Descriptors for describing a junction by identifying the intersecting roads at a road junction."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegIlcName1> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegIlcName2> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegIlcName3> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegNonJunctionPoint> a owl:Class ;
    rdfs:comment "A point on the road network which is not a road junction point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegOtherPointDescriptor> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegOtherPointDescriptor> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPointLocation> a owl:Class ;
    rdfs:comment "A single point on the road network defined by a TPEG-Loc structure and which has an associated direction of traffic flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegDirection> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCDirection> a owl:ObjectProperty ;
    rdfs:comment "ALERT-C direction"@en,
        "The direction of traffic flow along the road to which the information relates."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinearByCode> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2Linear> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2Point> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4Linear> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4Point> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCLocation> a owl:ObjectProperty ;
    rdfs:comment "ALERT-C location"@en,
        "Identification of a specific point, linear or area location in an ALERT-C location table."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCArea> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2PrimaryPointLocation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2SecondaryPointLocation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4PrimaryPointLocation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4SecondaryPointLocation> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPointCoordinates> a owl:ObjectProperty ;
    rdfs:comment "Coordinates that may be used by clients for visual display on user interfaces."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Location> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBaseReferencePoint> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPolygonCorners> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrRectangle> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointByCoordinates> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegJunction> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegNonJunctionPoint> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferent> a owl:ObjectProperty ;
    rdfs:comment "Specifies a referent on a linear object that has a known location such as a node, a reference marker (e.g. a marker-post), an intersection etc."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceFromLinearElementReferent> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedObjectProperties> a owl:ObjectProperty ;
    rdfs:comment "Only for organizational purposes. Imported object properties"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#skosObjectProperties> a owl:ObjectProperty ;
    rdfs:comment "Only for organizational purposes. Skos object properties"@en ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedObjectProperties> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/roads#RoadNumber> a owl:Class ;
    rdfs:comment "The road number designated by the road authority"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#descriptor> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalPack> .

<http://www.omg.org/spec/LCC/Countries/CountryRepresentationi#Alpha2Code> a owl:Class ;
    rdfs:comment "A digraph representing a country or geographic region"@en ;
    rdfs:isDefinedBy "https://www.omg.org/spec/LCC/Countries/CountryRepresentation/"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LCC_CountryRepresentation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTraffic> a owl:Class ;
    rdfs:comment "A traffic condition which is not normal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTrafficTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAbnormalTrafficType> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficFlowCharateristicsEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTrafficFlowCharacteristicsEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficTrendTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTrafficTrendTypeEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RelativeTrafficFlowEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRelativeTrafficFlowEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfVehiclesWaiting> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#queueLength> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCPoint> a owl:Class ;
    rdfs:comment "A single point on the road network defined by reference to a pre-defined ALERT-C location table and which has an associated direction of traffic flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationCountryCode> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationTableVersion> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationTableNumber> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> ;
    owl:disjointWith <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AngleInDegreesValue> a owl:Class ;
    rdfs:comment "A measured or  value of Angles. An integer number representing an angle in whole degrees between 0 and 359."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://qudt.org/schema/qudt#numericValue> ;
            owl:someValuesFrom xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/DEG> ;
            owl:onProperty <http://qudt.org/schema/qudt#unit> ],
        <http://qudt.org/schema/qudt#QuantityValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaLocation> a owl:Class ;
    rdfs:comment "Location representing a geographic or geometric defined area which may be qualified by height information to provide additional geospatial discrimination (e.g. for snow in an area but only above a certain altitude). Associations:\\n0..*\\tAlertCArea\\n0..1\\tTpegAreaLocation\\n0..1\\tNamedArea\\n0..1\\tGmlMultiPolygon\\n0..1\\tOpenlrAreaLocationReference"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlMultiPolygon> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGmlMultiPolygon> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrAreaLocationReference> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrAreaLocationReference> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNamedArea> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaPlacesEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAreaPlacesEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegAreaLocation> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Location> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DelaysTypeEnum> a owl:Class ;
    rdfs:comment "Coarse classification of the delay."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#delays> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#delaysOfUncertainDuration> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#longDelays> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#veryLongDelays> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Enums> a owl:Class ;
    rdfs:comment "Data Dictionary.This clause contains the definitions of all enumerations which are used."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeographicCharacteristicEnum> a owl:Class ;
    rdfs:comment "Descriptor to help to identify a specific location."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#aroundABendInRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onBorder> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onPass> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#overCrestOfHill> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightCoordinate> a owl:Class ;
    rdfs:comment "Third coordinate for points defined geodetically" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeightTypeEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionAccuracy> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVerticalPositionAccuracy> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AltitudeConfidence> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAltitudeConfidence> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#heightValue> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinatesAssociationsFrom> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InformationStatusEnum> a owl:Class ;
    rdfs:comment "Status of the related information (i.e. real, test or exercise)."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#real> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#securityExercise> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#technicalExercise> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#test> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementNatureEnum> a owl:Class ;
    rdfs:comment "List of indicative natures of linear elements."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#road> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadSection> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#slipRoad> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MaintenanceVehicleActionsEnum> a owl:Class ;
    rdfs:comment "Types of maintenance vehicle actions associated with roadworks."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#maintenanceVehiclesMergingIntoTrafficFlow> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#saltAndGritSpreading> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#slowMoving> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#snowClearing> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#stoppingToServiceEquipments> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Mobility> a owl:Class ;
    rdfs:comment "An indication of whether the associated instance of a SituationRecord is mobile (e.g. a march or parade moving along a road) or stationary."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#speed> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MobilityTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobilityType> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkManagement> a owl:Class ;
    rdfs:comment "Restrictions on road usage, whether by legal order or by operational decisions. It includes road and lane closures, weight and dimensional limits, banned turns, contraflows and alternate traffic operations."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OperatorAction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineLocationReference> a owl:Class ;
    rdfs:comment "A line location reference is defined by an ordered sequence of location reference points and a terminating last location reference point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLastLocationReferencePoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLastLocationReferencePoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLocationReferencePoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLocationReferencePoint> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLine> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOrientationEnum> a owl:Class ;
    rdfs:comment "Enumeration of side of road"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#againstLineDirection> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#bothDirections> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#noOrientationOrUnknown> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#withLineDirection> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrRectangle> a owl:Class ;
    rdfs:comment "Area delimited by a rectangle defined by the geodetic co-ordinates of the two ends of its diagonal from south-west to north-east (the rectangle having two sides that are parallel to lines of latitude)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrUpperRight> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLowerLeft> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrSideOfRoadEnum> a owl:Class ;
    rdfs:comment "Enumeration of side of road"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#bothSides> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#left> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onRoadOrUnknown> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#right> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayloadPublication> a owl:Class ;
    rdfs:comment "A payload publication of traffic related information or associated management information created at a specific point in time that can be exchanged via a DATEX II interface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#feedDescription> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#publicationTime> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#feedType> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InternationalIdentifier> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#publicationCreator> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Alpha2Code> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#defaultLanguage> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadPublishing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ProbabilityOfOccurrenceEnum> a owl:Class ;
    rdfs:comment "Levels of confidence that the sender has in the information, ordered {certain, probable, risk of}."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#certain> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#improbable> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#probable> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#riskOf> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedManagementTypeEnum> a owl:Class ;
    rdfs:comment "Management actions relating to speed."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TimeClasses> a owl:Class ;
    rdfs:comment "OWL-Time is an ontology of temporal concepts, for describing the temporal properties of resources. The vocabulary provided expresses facts about relations among instants and intervals, as well as durations. Time positions and durations may be expressed using either the conventional (Gregorian) calendar and clock, or using another temporal reference system such as Unix-time, geologic time, or different calendars."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ImportedClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaLocation> a owl:Class ;
    rdfs:comment "A geographic or geometric area defined by a TPEG-Loc structure which may include height information for additional geospatial discrimination"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegHeight> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegHeight> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01AreaLocationSubtypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegAreaLocationType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLinearLocation> a owl:Class ;
    rdfs:comment "A linear section along a single road defined between two points on the same road by a TPEG-Loc structure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegDirection> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegPointTo> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TPEGLoc01LinearLocationSubtypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegLinearLocationType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc> a owl:Class ;
    rdfs:comment "Tpeg location"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationObjects> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficElement> a owl:Class ;
    rdfs:comment "An event which is not planned by the traffic operator, which is affecting, or has the potential to affect traffic flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficConstrictionTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTrafficConstrictionTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficFlowCharateristicsEnum> a owl:Class ;
    rdfs:comment "The consistency (steadiness) of the traffic flow."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#erraticFlow> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#smoothFlow> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#stopAndGo> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficBlocked> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficTrendTypeEnum> a owl:Class ;
    rdfs:comment "A characterization of the trend in the traffic conditions at the specified location and direction."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficBuildingUp> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficEasing> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficStable> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unknown> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ValidityStatusEnum> a owl:Class ;
    rdfs:comment "Values of validity status that can be assigned to a described event, action or item"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#active> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#definedByValidityTimeSpec> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#planned> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#suspended> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstruction> a owl:Class ;
    rdfs:comment "An obstruction on the road caused by one or more vehicles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstructionTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVehicleObstructionTypeEnum> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVehicleTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#both> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirectionEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Indicates that both directions of traffic flow are affected by the situation or relate to the traffic data."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#country> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedAreaTypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum>,
        owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:comment "Country"@en,
        "EN ISO 3166-1 two-character country code."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InternationalIdentifier> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> ) ] ;
    rdfs:range <http://www.omg.org/spec/LCC/Countries/CountryRepresentationi#Alpha2Code> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlDataProperties> a owl:DatatypeProperty ;
    rdfs:comment "For organizational purposes"@en ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedDataProperties> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedDataProperties> a owl:DatatypeProperty ;
    rdfs:comment "For organizational purposes"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roundabout> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CarriagewayEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrFormOfWayEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubjectTypeOfWorksEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Roundabout"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AccidentTypeEnum> a owl:Class ;
    rdfs:comment "Collection of descriptive terms for types of accidents."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accident> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accidentInvolvingHazardousMaterials> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accidentInvolvingHeavyLorries> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#collision> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#multipleVehicleAccident> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinear> a owl:Class ;
    rdfs:comment "A linear section along a road defined between two points on the road by reference to a pre-defined ALERT-C location table. When there are multiple instances of AlertCLinear they should represent the same location using different location tables." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationTableNumber> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationCountryCode> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationTableVersion> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ComputationMethodEnum> a owl:Class ;
    rdfs:comment "Types of computational methods used in deriving data values for data sets."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#arithmeticAverageOfSamplesBasedOnAFixedNumberOfSamples> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#arithmeticAverageOfSamplesInATimePeriod> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#harmonicAverageOfSamplesInATimePeriod> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#medianOfSamplesInATimePeriod> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#movingAverageOfSamples> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLineString> a owl:Class ;
    rdfs:comment "Line string based on GML (EN ISO 19136) definition: a curve defined by a series of two or more coordinate tuples. Unlike GML may be self-intersecting. If srsName attribute is not present, posList is assumed to use \"ETRS89-LatLonh\" reference system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#GmlPosList> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#gmlPosList> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#srsName> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#srsDimension> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Gml> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightGradeEnum> a owl:Class ;
    rdfs:comment "List of height or vertical gradings of road sections."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#aboveGrade> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atGrade> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#belowGrade> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ImportedClasses> a owl:Class ;
    rdfs:comment "Only for organizational purposes"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NutsCodeTypeEnum> a owl:Class ;
    rdfs:comment "Types of NUTS codes (Nomenclature of territorial units for statistics) including LAU codes (Local Administrative Units)."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#lau1Code> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#lau2Code> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nuts1Code> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nuts2Code> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nuts3Code> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrAreaLocationReference> a owl:Class ;
    rdfs:comment "A two-dimensional part of the surface of the earth which is bounded by a closed curve. An area location may cover parts of the road network but does not necessarily need to. It is represented according to the OpenLR standard for Area Locations"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBasePointLocation> a owl:Class ;
    rdfs:comment "Holds common data that are used both in OpenlrPointAccessPoint and OpenlrPointAlongLine."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLocationReferencePoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLocationReferencePoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrSideOfRoadEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrSideOfRoad> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOrientationEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrOrientation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLastLocationReferencePoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLastLocationReferencePoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOffsets> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrOffsets> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPointLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointAlongLinearElement> a owl:Class ;
    rdfs:comment "A point on a linear element where the linear element is either a part of or the whole of a linear object (i.e. a road), consistent with EN ISO 19148 definitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDistanceAlongLinearElement> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAdministrativeAreaOfPoint> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElement> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLinearElement> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightGradeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeightGradeOfPoint> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#directionAtPoint> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#directionRelativeAtPoint> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionAccuracy> a owl:Class ;
    rdfs:comment "Horizontal position accuracy parameters defined according to EN 16803-1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accuracyPercentile75> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accuracyPercentile50> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accuracyPercentile95> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinatesAssociationsFrom> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReferentTypeEnum> a owl:Class ;
    rdfs:comment "A set of types of known points along a linear object such as a road."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#boundary> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#intersection> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#landmark> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#referenceMarker> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadNode> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RelativeTrafficFlowEnum> a owl:Class ;
    rdfs:comment "Assessment of the traffic flow conditions relative to normally expected conditions at this date/time."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficFlowNormal> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficHeavierThanNormal> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficLighterThanNormal> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficVeryMuchHeavierThanNormal> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficVeryMuchLighterThanNormal> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Source> a owl:Class ;
    rdfs:comment "Details of the source from which the information was obtained."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sourceName> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sourceIdentification> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SourceTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sourceType> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://www.omg.org/spec/LCC/Countries/CountryRepresentationi#Alpha2Code> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sourceCountry> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#reliable> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WeatherRelatedRoadConditionType> a owl:Class ;
    rdfs:comment "Types of road surface conditions which are related to the weather."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#blackIce> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ice> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#icyPatches> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#snowDrifts> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#surfaceWater> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WinterEquipmentManagementTypeEnum> a owl:Class ;
    rdfs:comment "Type of winter equipment management action instigated by operator."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#doNoUseStudTyres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useSnowChains> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useSnowChainsOrTyres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#useSnowTyres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#winterEquipmentOnBoardRequired> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit> a owl:Class ;
    rdfs:comment "Used in DATEX II to identification of the road administration area which contains the specified linear section or point."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTrafficTypeEnum> a owl:Class ;
    rdfs:comment "Descriptive terms for abnormal traffic conditions specifically relating to the nature of the traffic movement, implying levels of service."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#heavyTraffic> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#queuingTraffic> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#slowTraffic> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#stationaryTraffic> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unspecifiedAbnormalTraffic> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#EnvironmentalObstructionTypeEnum> a owl:Class ;
    rdfs:comment "Types of environmental obstructions."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#avalanches> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#fallenTrees> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#flooding> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#landslips> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#rockfalls> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#subsidence> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearWithinLinearElement> a owl:Class ;
    rdfs:comment "A linear section along a linear element where the linear element is either a part of or the whole of a linear object (i.e. a road), consistent with ISO 19148 definitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDistanceAlongLinearElementFrom> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightGradeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeightGradeOfLinearSection> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDistanceAlongLinearElementTo> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#directionOnLinearSection> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#directionRelativeOnLinearSection> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElement> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLinearElement> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAdministrativeAreaOfLinearSection> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceCodedErrorEnum> a owl:Class ;
    rdfs:comment "Error code for horizontal or vertical position confidence"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#outOfRange> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unavailable> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceEllipse> a owl:Class ;
    rdfs:comment "Confidence ellipse position defined in a shape of ellipse with a predefined confidence level (e.g. 95 %). The centre of the ellipse shape corresponds to the reference position point for which the position accuracy is evaluated." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#semiMajorAxisOrientationError> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AngleInDegreesValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#semiMajorAxisOrientation> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#semiMajorAxisLength> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#semiMinorAxisLength> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceCodedErrorEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSemiMinorAxisLengthCodedError> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceCodedErrorEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSemiMajorAxisLengthCodedError> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinatesAssociationsFrom> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadMaintenanceTypeEnum> a owl:Class ;
    rdfs:comment "Types of road maintenance."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#maintenanceWork> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#repairWork> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#resurfacingWork> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadMarkingWork> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#snowploughsInUse> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficConstrictionTypeEnum> a owl:Class ;
    rdfs:comment "Types of constriction to which traffic is subjected as a result of an event."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#carriagewayBlocked> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#carriagewayPartiallyObstructed> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#lanesBlocked> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#lanesPartiallyObstructed> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadBlocked> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadPartiallyObstructed> ) ] .

<http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> a rdfs:Datatype ;
    rdfs:comment "An integer number whose value space is the set {0, 1, 2, ..., 2147483645, 2147483646, 2147483647}."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://qudt.org/schema/qudt/floatPercentage> a rdfs:Datatype ;
    rdfs:label "float percentage"@en ;
    rdfs:comment "percentage in float"@en ;
    rdfs:isDefinedBy "http://qudt.org/2.1/schema/qudt"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> a owl:Class ;
    rdfs:comment "Alert C location"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationObjects> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> a owl:Class ;
    rdfs:comment "The direction of traffic flow along the road to which the information relates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCAffectedDirection> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirectionEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCDirectionCoded> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> ;
    owl:disjointWith <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DelayBandEnum> a owl:Class ;
    rdfs:comment "The time band within which the additional travel time due to adverse travel conditions of any kind falls, when compared to \"normal conditions\"."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#betweenOneHourAndThreeHours> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#betweenTenMinutesAndThirtyMinutes> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#betweenThirtyMinutesAndOneHour> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#betweenThreeHoursAndSixHours> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#longerThanSixHours> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#negligible> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#upToTenMinutes> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> a owl:Class ;
    rdfs:comment "Distance of a point along a linear element either measured from the start node or a defined referent on that linear element, where the start node is relative to the element definition rather than the direction of traffic flow."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing> a owl:Class ;
    rdfs:comment "Only for organizational purposes." .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> a owl:Class ;
    rdfs:comment "An area defined by a name and/or in terms of known boundaries, such as country or county boundaries or allocated control area of particular authority. The attributes do not form a union; instead, the smallest intersection forms the resulting area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedAreaTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNamedAreaTypeEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://www.omg.org/spec/LCC/Countries/CountryRepresentationi#Alpha2Code> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#country> ],
        [ a owl:Restriction ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#areaNameProperty> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> a owl:Class ;
    rdfs:comment "Any stationary or moving obstacle of a physical nature (e.g. obstacles or vehicles from an earlier accident, shed loads on carriageway, rock fall, abnormal or dangerous loads, or animals etc.) which could disrupt or endanger traffic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Mobility> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobilityOfObstruction> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfObstructions> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> a owl:Class ;
    rdfs:comment "OpenLR location"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationObjects> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> a owl:Class ;
    rdfs:comment "Highway maintenance, installation and construction activities that may potentially affect traffic operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#underTraffic> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#publicTransportAlternative> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadworksDurationEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadworksDuration> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Mobility> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobility> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MaintenanceVehicles> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMaintenanceVehicles> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Subjects> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSubject> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadworksIdentifier> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#urgentRoadworks> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadworksScaleEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadworksScaleEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OperatorAction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SeverityEnum> a owl:Class ;
    rdfs:comment "Levels of severity of a situation as whole assessed by the impact that the situation may have on traffic flow as perceived by the supplier."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#high> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#highest> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#low> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#lowest> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#medium> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#none> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unknown> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegEnumerations> a owl:Class ;
    rdfs:comment "Only for organizational purposes"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Enums> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConfidentialityValueEnum> a owl:Class ;
    rdfs:comment "<<enumeration>> Values of confidentiality."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#internalUse> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#noRestriction> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#restrictedToAuthorities> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#restrictedToAuthoritiesAndTrafficOperators> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#restrictedToAuthoritiesTrafficOperatorsAndPublishers> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#restrictedToAuthoritiesTrafficOperatorsAndVms> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DrivingConditionTypeEnum> a owl:Class ;
    rdfs:comment "Types of the perceived driving conditions."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hazardous> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#impossible> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#normal> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#passableWithCare> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unknown> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#veryHazardous> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#winterConditions> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> a owl:Class ;
    rdfs:comment "An assessment of the impact that an event or operator action defined by the situation record has on the driving conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Delays> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDelays> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfOperationalLanes> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#residualLaneWidth> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfLanesRestricted> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://qudt.org/schema/qudt/floatPercentage> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#capacityRemaining> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#residualRoadWidth> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum> a owl:Class ;
    rdfs:comment "Directions of traffic flow relative to the direction in which the linear element is defined."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#aligned> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#both> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#opposite> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unknown> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrFormOfWayEnum> a owl:Class ;
    rdfs:comment "Enumeration of form of way"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#motorway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#multipleCarriageway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roundabout> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#singleCarriageway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#slipRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficSquare> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#undefined> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadsideAssistanceTypeEnum> a owl:Class ;
    rdfs:comment "Indicates the nature of the road side assistance that will be, is or has been provided."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#airAmbulance> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#busPassengerAssistance> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#emergencyServices> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#firstAid> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#foodDelivery> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#helicopterRescue> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleRecovery> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleRepair> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> a owl:Class ;
    rdfs:comment "A point on the road network which is either a junction point or a non junction point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPointCoordinates> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleStatusEnum> a owl:Class ;
    rdfs:comment "The status of a vehicle."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#brokenDown> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#burntOut> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damaged> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedAndImmobililized> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#jacknifed> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onFire> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#overturned> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#spunAround> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> a owl:Class ;
    rdfs:comment "Identification of a specific point, linear or area location in an ALERT-C location table."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertC> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> a owl:Class ;
    rdfs:comment "A data value of something that can be measured or calculated. Any provided meta-data values specified in the attributes override any specified generic characteristics such as defined for a specific measurement in the MeasurementSiteTable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#dataError> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfInputValuesUsed> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#reasonForDataError> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://qudt.org/schema/qudt/floatPercentage> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accuracy> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:float ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#standardDeviation> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://qudt.org/schema/qudt/floatPercentage> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#supplierCalculatedDataQuality> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:float ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#smoothingFactor> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ComputationMethodEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasComputationMethodEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfIncompleteInputs> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralNetworkManagementTypeEnum> a owl:Class ;
    rdfs:comment "Types of network management actions."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#bridgeSwingInOperation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#convoyService> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#obstacleSignalling> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#rampMeteringInOperation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#temporaryTrafficLights> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tollGatesOpen> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficBeingManuallyDirected> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficHeld> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElement> a owl:Class ;
    rdfs:comment "A linear element along a single linear object, consistent with EN ISO 19148 definitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadName> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/roads#RoadNumber> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadNumber> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementNatureEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLinearElementNature> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#linearElementReferenceModel> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#linearElementReferenceModelVersion> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NonWeatherRelatedRoadConditionTypeEnum> a owl:Class ;
    rdfs:comment "Types of road surface conditions which are not related to the weather."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#leavesOnRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#looseChippings> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#looseSandOnRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#mudOnRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#oilOnRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#petrolOnRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadSurfaceInPoorCondition> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#slipperyRoad> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrFunctionalRoadClassEnum> a owl:Class ;
    rdfs:comment "Enumuration of functional road class"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#frc0> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#frc1> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#frc2> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#frc3> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#frc4> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#frc5> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#frc6> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#frc7> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReroutingManagementTypeEnum> a owl:Class ;
