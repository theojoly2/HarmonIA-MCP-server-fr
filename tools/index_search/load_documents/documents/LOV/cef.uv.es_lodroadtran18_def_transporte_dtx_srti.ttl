    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#abnormalLoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#brokenDownHeavyLorry> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#brokenDownVehicle> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#convoy> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedVehicle> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#longLoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#militaryConvoy> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#slowVehicle> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleOnFire> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleOnWrongCarriageway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleStuck> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleWithOverwideLoad> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ObstructionTypeEnum> a owl:Class ;
    rdfs:comment "Types of obstructions on the roadway."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#airCrash> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#childrenOnRoadway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#clearanceWork> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#cyclistsOnRoadway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#incident> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#objectOnTheRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#peopleOnRoadway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#railCrash> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#rescueAndRecoveryWork> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#shedLoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#spillageOnTheRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unprotectedAccidentArea> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> a owl:Class ;
    rdfs:comment "A collection of supplementary positional information which improves the precision of the location."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeographicCharacteristicEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGeographicDescriptor> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasInfrastructureDescriptor> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNamedArea> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#locationPrecision> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sequentialRampNumber> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#lengthAffected> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#locationDescription> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionPurposeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDirectionPurpose> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RelativePositionOnCarriagewayEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPositionOnCarriageway> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalPack> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AltitudeAccuracyEnum> a owl:Class ;
    rdfs:comment "Coded level of vertical accuracy"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan100Metres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan10Centimetres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan10Metres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan1Centimetre> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan1Metre> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan200Metres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan20Centimetres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan20Metres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan2Centimetres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan2Metres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan50Centimetres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan50Metres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan5Centimetres> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#equalToOrLessThan5Metres> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses> a owl:Class ;
    rdfs:comment "Common classes"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PersonCategoryEnum> a owl:Class ;
    rdfs:comment "Categories of person."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#adult> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#child> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#emergencyServicesPerson> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#fireman> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#infant> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#medicalStaff> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#memberOfThePublic> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#policeman> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#politician> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#publicTransportPassenger> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sickPerson> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficOfficer> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficWarden> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#veryImportantPerson> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> a owl:Class ;
    rdfs:comment "A referent on a linear object that has a known location such as a node, a reference marker (e.g. a marker-post), an intersection etc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#referentName> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#referentIdentifier> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReferentTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentTypeEnum> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPointCoordinates> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#referentDescription> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unknown> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AccidentCauseEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DrivingConditionTypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MobilityTypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SeverityEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc04HeightTypeEnum>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficTrendTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Direction is unknown.",
        "Accident cause is unknown."@en,
        "Driving conditions are unknown."@en,
        "Perceived by supplier as being of an unknown level."@en,
        "The trend of traffic conditions is currently unknown."@en,
        "Unknow mobility of the describe element of a situation."@en,
        "Unknown height reference."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDamageTypeEnum> a owl:Class ;
    rdfs:comment "Types of infrastructure damage which may have an effect on the road network."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#burstPipe> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#burstWaterMain> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#collapsedSewer> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedBridge> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedCrashBarrier> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedFlyover> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedGallery> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedGantry> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedRoadSurface> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedTunnel> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#damagedViaduct> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#fallenPowerCables> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#gasLeak> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#weakBridge> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> a owl:Class ;
    rdfs:comment "Any situation record. An identifiable versioned instance of a single record/element within a situation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasImpactOnOppositeDirection> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ProbabilityOfOccurrenceEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasProbabilityOfOccurrence> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConfidentialityValueEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#confidentialityOverride> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordCreationReference> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasImpact> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordVersionTime> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#safetyRelatedMessage> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordFirstSupplierVersionTime> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Validity> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasValidity> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SeverityEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSeverityEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Source> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSource> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordCreationTime> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordObservationTime> ],
        [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordVersion> ;
            owl:someValuesFrom xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReference> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLocationReference> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayLoadPublishing>,
        geo:Feature .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> a owl:Class ;
    rdfs:comment "Only for organizational purposes"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Enums> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AccidentCauseEnum> a owl:Class ;
    rdfs:comment "Collection of descriptive terms for causes of accidents."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#avoidanceOfObstacles> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#driverDistraction> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#driverDrugAbuse> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#driverIllness> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#exceedingSpeedsLimits> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#excessAlcohol> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#excessiveDriverTiredness> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#impermissibleManoeuvre> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#limitedVisibility> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#notKeepingASafeDistance> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onTheWrongSideOfTheRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#other> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#pedestrianInRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#poorLaneAdherence> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#poorMergeEntryOrExitJudgement> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#poorRoadSurfaceCondition> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#poorSurfaceAdherence> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#undisclosed> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unknown> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleFailure> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaPlacesEnum> a owl:Class ;
    rdfs:comment "Type of area place(s)"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atBorders> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atHighAltitudes> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inBuiltUpAreas> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inForestedAreas> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inGalleries> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inLowLyingAreas> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inRuralAreas> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inShadedAreas> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inTheInnerCityAreas> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inTunnels> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onBridges> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onDownhillSections> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onElevatedSections> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onEnteringOrLeavingTunnels> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onFlyovers> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onPasses> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onUndergroundSections> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onUnderpasses> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CarriagewayEnum> a owl:Class ;
    rdfs:comment "List of descriptors identifying specific carriageway details."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#connectingCarriageway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#cycleTrack> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#entrySlipRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#exitSlipRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#flyover> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#footpath> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#leftHandFeederRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#leftHandParallelCarriageway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#mainCarriageway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#oppositeCarriageway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#parallelCarriageway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#rightHandFeederRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#rightHandParallelCarriageway> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roundabout> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#serviceRoad> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#slipRoads> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#underpass> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#unspecifiedCarriageway> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PoorEnvironmentTypeEnum> a owl:Class ;
    rdfs:comment "Types of poor environmental conditions."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#badWeather> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#blowingDust> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#blowingSnow> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#crosswinds> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#extremeCold> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#extremeHeat> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#fog> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#frost> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hail> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#rain> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sandStorms> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#smokeHazard> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#snowFall> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#stormForceWinds> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#strongGustsOfWinds> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#strongWinds> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#swarmOfInsects> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#visibilityReduced> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum> a owl:Class ;
    rdfs:comment "Descriptor identifying infrastructure to help to identify a specific location."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencingEnumerations> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> a owl:Class ;
    rdfs:comment "A measure of distance defined in metres in a floating point format."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/M> ;
            owl:onProperty <http://qudt.org/schema/qudt#unit> ],
        [ a owl:Restriction ;
            owl:onProperty <http://qudt.org/schema/qudt#numericValue> ;
            owl:someValuesFrom xsd:float ],
        <http://qudt.org/schema/qudt#QuantityValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> a owl:Class ;
    rdfs:comment "In Datex II definition, a pair of planar coordinates defining the geodetic position of a single point using the European Terrestrial Reference System 1989 (ETRS89).\\n\\nNote: At the moment, in Spain it is used the WGS84 and so, the 2 references are possible ( geo/wgs84_pos (lat, long) / geo_core (xETRS89,yETRS89) )."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:float ;
            owl:onProperty <https://datos.ign.es/def/geo_core#xETRS89> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:float ;
            owl:onProperty <https://datos.ign.es/def/geo_core#yETRS89> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightCoordinate> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeightCoordinate> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionAccuracy> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHorizontalPositionAccuracy> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:float ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#lat> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceEllipse> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPositionConfidenceEllipse> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:float ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#lon> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing>,
        <http://www.w3.org/2003/01/geo/wgs84_pos#Point> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> a owl:ObjectProperty ;
    rdfs:comment "Only for organizational purposes. Time object properties"@en ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedObjectProperties> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SourceTypeEnum> a owl:Class ;
    rdfs:comment "Information about the technology used for measuring the data or the method used for obtaining qualitative descriptions relating to this version of the information."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#automobileClubPatrol> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#cameraObservation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#freightVehicleOperator> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inductionLoopMonitoringStation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#infraredMonitoringStation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#microwaveMonitoringStation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#mobileTelephoneCaller> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nonPoliceEmergencyServicePatrol> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#otherOfficialVehicle> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#policePatrol> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#privateBreakdownService> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#publicAndPrivateUtilities> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#registeredMotoristObserver> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadAuthorities> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadOperatorPatrol> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadsideTelephoneCaller> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#spotterAircraft> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficMonitoringStation> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#transitOperator> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleProbeMeasurement> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#videoProcessingMonitoringStation> ) ] .

<http://datex2.eu/schema/3/Common/3_1#MultilingualString> a rdfs:Datatype ;
    rdfs:comment "A multilingual string, whereby the same text may be expressed in more than one language."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubjectTypeOfWorksEnum> a owl:Class ;
