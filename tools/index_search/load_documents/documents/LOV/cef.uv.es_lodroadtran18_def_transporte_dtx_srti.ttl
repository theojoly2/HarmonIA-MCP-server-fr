@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix onto: <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    dc:date "2022-03-31"@en ;
    dc:source "https://docs.datex2.eu/_static/data/v3.2/umlmodel/html/index.htm"@en ;
    dcterms:contributor "Tam Tam Research, CVUT, ESAM Technologies & LMT."@en ;
    dcterms:creator "Julian Gutierrez Moret (https://www.uv.es/uvweb/universidad/es/ficha-persona-1285950309813.html?p2=gumoju) \\n\\nJ. Javier Samper Zapater (https://www.uv.es/uvweb/college/en/profile-1285950309813.html?p2=jjsamper&idA=true) \\n\\nIRTIC - (Instituto de Robótica y Tecnologías de la Información y la Comunicación)"@en ;
    dcterms:description "An RDF/OWL vocabulary to represent SRTI DATEX II profile (according the Commission  Delegated Regulation (EU) No 886/2013) within the European  LOD-RoadTran18 action  \"Supporting the cross-border use of Road Traffic Data with Linked Open Data based on DATEX II (LOD-RoadTran18)\" (Agreement No: INEA/CEF/ICT/A2018/1803421, Action No: 2018-EU-IA-0088). The  vocabulary is used for mapping between DATEX II and LOD formats."@en ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/" ;
    dcterms:title "LOD SRTI DATEX II"@en ;
    vann:preferredNamespacePrefix "dtx_srti"@en ;
    vann:preferredNamespaceUri "http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#"@en ;
    rdfs:seeAlso "http://cef.uv.es/lodroadtran18/"@en ;
    owl:imports <http://www.opengis.net/ont/geosparql>,
        time:2016,
        <https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf> ;
    owl:versionInfo "1.0"@en ;
    skos:changeNote "2022-02-01. Extended the ontology with non-SRTI elements and adition of the comments:\\n\\n\\t- Related with a SituationRecord: Severity, Source & Impact \\n\\t- New items for old SRTI Enumerations and new non-SRTI Enumerations \\n\\t- Added Mobility"@en,
        "2022-07-29. Use of  LCC Country Representation  alpha2code and LCC Language Representation  alpha2code according to Datex specification.\\nIt allows the instantiation of Spain and the Czech Republic would be reusing the individuals from ISO3166-1-CountryCodes and  ISO639-1-LanguageCodes respectively."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPointAlongLine> a owl:Class ;
    rdfs:comment "Point along a line"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBasePointLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCDirectionNamed> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "ALERT-C name of a direction e.g. Brussels -> Lille."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#alertCLocationName> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Name of ALERT-C location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#allowedDeliveryChannel> a owl:ObjectProperty ;
    rdfs:comment "The allowed delivery channel."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeaderInformation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InformationDeliveryServicesEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCArea> a owl:ObjectProperty ;
    rdfs:comment "ALERT-C Area"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCArea> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCLinear> a owl:ObjectProperty ;
    rdfs:comment "The linear location expressed using AlertC. Multiple instances of AlertCLinear shall represent the same real-world geographic feature."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SingleRoadLinearLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinear> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCPoint> a owl:ObjectProperty ;
    rdfs:comment "A single point on the road network defined by reference to a pre-defined ALERT-C location table and which has an associated direction of traffic flow."@en,
        "ALERT-C point"@en,
        "PointLocation is associated to AlertCPoint with cardinality 0..*"@en,
        "The point location expressed using AlertC. Multiple instances of AlertCPoint shall represent the same real-world geographic feature.They should represent the same point using different location tables."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCPoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasCarriageway> a owl:ObjectProperty ;
    rdfs:comment "Supplementary positional information which details carriageway and lane locations. Several instances may exist where the element being described extends over more than one carriageway."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Carriageway> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDisturbanceActivityTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Deliberate human action of either a public disorder nature or of a situation alert type which could disrupt traffic."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DisturbanceActivity> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DisturbanceActivityTypeEnum> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGmlInteriorLinearRing> a owl:ObjectProperty ;
    rdfs:comment "A boundary of internal patches of a polygonal surface consisting of a ring feature"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlPolygon> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLinearRing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLane> a owl:ObjectProperty ;
    rdfs:comment "Indicates a specific lane or group of lanes."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Carriageway> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Lane> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLinearWithinLinearElement> a owl:ObjectProperty ;
    rdfs:comment "Specifies a linear section along a linear element where the linear element is either a part of or the whole of a linear object (i.e. a road), consistent with ISO 19148 definitions."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SingleRoadLinearLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearWithinLinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMaintenanceVehicleActions> a owl:ObjectProperty ;
    rdfs:comment "The actions of the maintenance vehicles associated with the roadworks activities."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MaintenanceVehicles> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MaintenanceVehicleActionsEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOverallEndTime> a owl:AnnotationProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOverallStartTime> a owl:AnnotationProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPointAlongLinearElement> a owl:ObjectProperty ;
    rdfs:comment "PointLocation is associated to PointAlongLinearElement with cardinality 0..*"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointAlongLinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPublicEventType> a owl:ObjectProperty ;
    rdfs:comment "Specifies types of public events."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PublicEvent> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PublicEventTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadInformation> a owl:ObjectProperty ;
    rdfs:comment "Information on a set of one or more roads. The location could correspond to a part of the road identified, the whole stretch of road identified, or a combination of multiple road sections."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadInformation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadOrCarriagewayOrLaneManagementType> a owl:ObjectProperty ;
    rdfs:comment "Management actions relating to road, carriageway or lane usage."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadOrCarriagewayOrLaneManagement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadOrCarriagewayOrLaneManagementTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSituation> a owl:ObjectProperty ;
    rdfs:comment "traffic/travel situations."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationPublication> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Situation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVehiclesInvolved> a owl:ObjectProperty ;
    rdfs:comment "The vehicle involved in the accident."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Accident> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstruction> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Vehicle> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasWinterEquipmentManagementType> a owl:ObjectProperty ;
    rdfs:comment "Type of winter equipment management action instigated by operator."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WinterDrivingManagement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WinterEquipmentManagementTypeEnum> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#specificLocation> a owl:DatatypeProperty ;
    rdfs:comment "Unique code within the ALERT-C location table which identifies the specific point, linear or area location." ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#AlertCLocationCode> .

<http://datex2.eu/schema/3/Common/3_1#CountryCode> a rdfs:Datatype ;
    rdfs:comment "EN ISO 3166-1 alpha-2 two-letter country code"@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://datex2.eu/schema/3/Common/3_1#DateTime> a rdfs:Datatype ;
    rdfs:comment "A combination of integer-valued year, month, day, hour, minute properties, a decimal-valued second property and a time zone property from which it is possible to determine the local time, the equivalent UTC time and the time zone offset from UTC."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://datex2.eu/schema/3/Common/3_1#Language> a rdfs:Datatype ;
    rdfs:comment "A language datatype, identifies a specified language by an ISO 639-1 2-alpha code"@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://datex2.eu/schema/3/Common/3_1#MetresAsNonNegativeInteger> a rdfs:Datatype ;
    rdfs:comment "A measure of distance defined in metres in a non negative integer format."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://datex2.eu/schema/3/Common/3_1#NutsCode> a rdfs:Datatype ;
    rdfs:comment "A NUTS code (Nomenclature of territorial units for statistics)."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://datex2.eu/schema/3/Common/3_1#SubdivisionCode> a rdfs:Datatype ;
    rdfs:comment "ISO 3166-2 country sub-division code (up to 3 characters)."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

dc:date a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:DatatypeProperty ;
    rdfs:comment "The range defined for dcterms:created is the class of rdfs:Literal. Values used with this property therefore have to be literal values."@en .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:comment "The range defined for dcterms:identifier is the class of rdfs:Literal. Values used with dcterms:identifier have to be instances of this class. Therefore this property can only be used with literal values."@en .

dcterms:isReplacedBy a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:replaces a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://www.omg.org/spec/LCC/Countries/CountryRepresentation#Country> a owl:Class ;
    rdfs:comment "Country Code from LCC Countries Representation"@en ;
    rdfs:isDefinedBy "http://www.omg.org/spec/LCC/Countries/CountryRepresentation#" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LCC_CountryRepresentation> .

<http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> rdfs:comment "Composite unit (century, year, month, day, hour, minute, second, millisecond) defining the scale for the gregorian calendar used in ISO 8601. Note that this just identifies the scale and can be used with different time reference systems (UTC, UT1, GPS, etc.)."@en ;
    rdfs:seeAlso "http://www.opengis.net/doc/IS/SWE/2.0"@en .

geo:SpatialObject rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeoSparqlClasses> .

geo:coordinateDimension rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlDataProperties> .

geo:dimension rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlDataProperties> .

geo:ehContains rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:ehCoveredBy rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:ehCovers rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:ehDisjoint rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:ehEquals rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:ehInside rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:ehMeet rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:ehOverlap rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:hasGeometry rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:hasSerialization rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlDataProperties> .

geo:isEmpty rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlDataProperties> .

geo:isSimple rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlDataProperties> .

geo:rcc8dc rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:rcc8ec rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:rcc8eq rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:rcc8ntpp rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:rcc8ntppi rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:rcc8po rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:rcc8tpp rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:rcc8tppi rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:sfContains rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:sfCrosses rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:sfDisjoint rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:sfEquals rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:sfIntersects rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:sfOverlaps rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:sfTouches rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:sfWithin rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlObjectProperties> .

geo:spatialDimension rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geoSparqlDataProperties> .

<http://www.openlinksw.com/schemas/virtrdf#geometry> a rdfs:Datatype ;
    rdfs:comment "geometry"@en ;
    rdfs:isDefinedBy "http://www.openlinksw.com/schemas/virtrdf#"@en .

rdf:List rdfs:comment "List"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ImportedClasses> .

rdfs:subClassOf a owl:AnnotationProperty .

xsd:ID a rdfs:Datatype .

xsd:time a rdfs:Datatype .

owl:Thing a owl:Class .

skos:Collection rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SkosClasses> .

skos:Concept rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SkosClasses> .

skos:ConceptScheme rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SkosClasses> .

skos:hasTopConcept rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#skosObjectProperties> .

skos:inScheme rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#skosObjectProperties> .

skos:isReplacedBy a owl:AnnotationProperty ;
    rdfs:subPropertyOf <http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#skosAnnotationProperties> .

skos:member rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#skosObjectProperties> .

skos:memberList rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#skosObjectProperties> .

skos:notation rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#skosDataProperties> .

skos:note rdfs:subPropertyOf <http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#skosAnnotationProperties> .

skos:replaces a owl:AnnotationProperty ;
    rdfs:subPropertyOf <http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#skosAnnotationProperties> .

skos:semanticRelation rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#skosObjectProperties> .

time:DateTimeDescription rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:DateTimeInterval rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:DayOfWeek rdfs:isDefinedBy "http://www.w3.org/2006/time#" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TimeClasses> .

time:Duration rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:DurationDescription rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:GeneralDateTimeDescription rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:GeneralDurationDescription rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:Interval rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:MonthOfYear rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:TRS rdfs:isDefinedBy "http://www.w3.org/2006/time#" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TimeClasses> .

time:TemporalDuration rdfs:isDefinedBy "http://www.w3.org/2006/time#" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TimeClasses> .

time:TemporalEntity rdfs:isDefinedBy "http://www.w3.org/2006/time#" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TimeClasses> .

time:TemporalPosition rdfs:isDefinedBy "http://www.w3.org/2006/time#" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TimeClasses> .

time:TemporalUnit rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:TimePosition rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:TimeZone rdfs:isDefinedBy "http://www.w3.org/2006/time#" ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TimeClasses> .

time:after rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:before rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:day rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:dayOfWeek rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:dayOfYear rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:days rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:hasDateTimeDescription rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:hasTRS rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:hasTemporalDuration rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:hasTime rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:hasXSDDuration rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:hour rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:hours rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:inTemporalPosition rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:inXSDDate rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:inXSDDateTime rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:inXSDDateTimeStamp rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:inXSDgYear rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:inXSDgYearMonth rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:inside rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalContains rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalDisjoint rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalEquals rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalFinishedBy rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalIn rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalMeets rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalMetBy rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalOverlappedBy rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalOverlaps rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:intervalStartedBy rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:minute rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:minutes rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:month rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:monthOfYear rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:months rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:nominalPosition rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:numericDuration rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:numericPosition rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:second rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:timeZone rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:unitType rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeObjectProperties> .

time:week rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:weeks rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:xsdDateTime rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:year rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

time:years rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

<http://www.w3.org/ns/adms#status> a owl:AnnotationProperty .

<https://datex2.eu/schema/3/Common/3_1#MetresAsFloat> a rdfs:Datatype ;
    rdfs:comment "A measure of distance defined in metres in a floating point format."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#Country> rdfs:isDefinedBy "https://ec.europa.eu/eurostat/ramon/" .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#LAURegion> rdfs:isDefinedBy "https://ec.europa.eu/eurostat/ramon/" .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#NUTSRegion> rdfs:isDefinedBy "https://ec.europa.eu/eurostat/ramon/" .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#code> rdfs:subPropertyOf <http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#ramon_geoAnnotationProperties> .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#hasParentRegion> rdfs:subPropertyOf <http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#ramon_geoObjectProperties> .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#hasSubRegion> rdfs:subPropertyOf <http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#ramon_geoObjectProperties> .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#level> rdfs:subPropertyOf <http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#ramon_geoAnnotationProperties> .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#name> rdfs:subPropertyOf <http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#ramon_geoAnnotationProperties> .

<https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#regionCode> a owl:AnnotationProperty ;
    rdfs:domain <https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#Region> ;
    rdfs:subPropertyOf <http://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#ramon_geoAnnotationProperties> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AnimalPresenceObstruction> a owl:Class ;
    rdfs:comment "An obstruction on the road resulting from the presence of animals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AnimalPresenceTypeEmum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAnimalPresenceTypeEnum> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> ;
    owl:disjointWith <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#EnvironmentalObstruction>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralObstruction>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstruction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConstructionWorks> a owl:Class ;
    rdfs:comment "Roadworks involving the construction of new infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConstructionWorkTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasConstructionWorkType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceFromLinearElementStart> a owl:Class ;
    rdfs:comment "Distance of a point along a linear element measured from the start node of the linear element, where start node is relative to the element definition rather than the direction of traffic flow."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DisturbanceActivity> a owl:Class ;
    rdfs:comment "Deliberate human action of either a public disorder nature or of a situation alert type which could disrupt traffic."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Activity> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeoSparqlClasses> a owl:Class ;
    rdfs:comment "The OGC GeoSPARQL standard supports representing and querying geospatial data on the Semantic Web. GeoSPARQL defines a vocabulary for representing geospatial data in RDF, and it defines an extension to the SPARQL query language for processing geospatial data."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ImportedClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Geo_WGS84> a owl:Class ;
    rdfs:comment "Geo WGS84 vocabulary"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ImportedClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightCoordinateAssociationFrom> a owl:Class ;
    rdfs:comment "Third coordinate for points defined geodetically"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDamageObstruction> a owl:Class ;
    rdfs:comment "An obstruction on the road caused by one Infrastructure Damage"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasInfrastructureDamageType> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDamageTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Itinerary> a owl:Class ;
    rdfs:comment "Multiple (i.e. more than one) physically separate locations arranged as an ordered set that defines an itinerary or route. In SRTI is not included ItineraryByReference"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ItineraryByIndexedLocations> a owl:Class ;
    rdfs:comment "Multiple physically separate locations arranged as an ordered set that defines an itinerary or route. The index qualifier indicates the order.\\nAssociation: 1..1 Location"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Location> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLocationContainedInItinerary> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Itinerary> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementByCode> a owl:Class ;
    rdfs:comment "A linear element along a single linear object defined by its identifier or code in a road network reference model (specified in LinearElement class) which segments the road network according to specific business rules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#linearElementIdentifier> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementByLineString> a owl:Class ;
    rdfs:comment "A linear element defined by a line string (class GmlLineString)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLineString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGmlLineString> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MaintenanceWorks> a owl:Class ;
    rdfs:comment "Roadworks involving the maintenance or installation of infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadMaintenanceTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadMaintenanceType> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPoiWithAccessPoint> a owl:Class ;
    rdfs:comment "A point of interest (POI) along a line with access is a point location which is defined by a linear reference path, an offset value (defining the access point) from the starting node of this path and a coordinate pair that defines the POI itself."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrCoordinates> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBasePointLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPolygonLocationReference> a owl:Class ;
    rdfs:comment "The OpenLR method of area definition by providing points that bound the area"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPolygonCorners> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrPolygonCorners> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrAreaLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrRectangleLocationReference> a owl:Class ;
    rdfs:comment "The openLR method of area definition by providing a rectangular shape defined by two geo-coordinate pairs"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrRectangle> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrRectangle> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrAreaLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PercentageDistanceAlongLinearElement> a owl:Class ;
    rdfs:comment "Distance of a point along a linear element measured from the start node expressed as a percentage of the whole length of the linear element, where start node is relative to the element definition rather than the direction of traffic flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://qudt.org/schema/qudt/floatPercentage> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#percentageDistanceAlong> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinatesAssociationsTo> a owl:Class ;
    rdfs:comment "A pair of planar coordinates defining the geodetic position of a single point using the European Terrestrial Reference System 1989 (ETRS89)."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReferencing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PoorEnvironmentConditions> a owl:Class ;
    rdfs:comment "Any environmental conditions which may be affecting the driving conditions on the road."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PoorEnvironmentTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPoorEnvironmentTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Conditions> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Ramon_geoClasses> a owl:Class ;
    rdfs:comment "RAMON geographic ontology describes countries, NUTS, and Local Administrative Units (LAU) related concepts and properties"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ImportedClasses> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReroutingManagement> a owl:Class ;
    rdfs:comment "Rerouting management action that is issued by the network/road operator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReroutingManagementTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReroutingManagementType> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkManagement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadsideAssistance> a owl:Class ;
    rdfs:comment "Details of road side assistance required or being given."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadsideAssistenceTypeEnum> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadsideAssistanceTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OperatorAction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationPublication> a owl:Class ;
    rdfs:comment "A publication containing zero or more traffic/travel situations."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayloadPublication> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegNamedOnlyArea> a owl:Class ;
    rdfs:comment "An area defined by a well-known name."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegAreaDescriptor> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaDescriptor> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TransitServiceInformationEnum> a owl:Class ;
    rdfs:comment "Types of public transport information."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Non-SRTI_Enum> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ferry> ) ] .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleFlowValue> a owl:Class ;
    rdfs:comment "A measured or calculated value of the flow rate of vehicles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#VehiclesPerHour> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleFlowRate> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WinterDrivingManagement> a owl:Class ;
    rdfs:comment "Winter driving management action that is instigated by the network/road operator."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkManagement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accuracy> a owl:DatatypeProperty ;
    rdfs:comment "The extent to which the value is expected to be free from error, measured as a percentage of the data value. 100% means fully accurate." ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> ;
    rdfs:range <http://qudt.org/schema/qudt/floatPercentage> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accuracyPercentile50> a owl:ObjectProperty ;
    rdfs:comment "Accuracy defined by the 50th percentile of the cumulative distribution of position errors."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionAccuracy> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accuracyPercentile75> a owl:ObjectProperty ;
    rdfs:comment "Accuracy defined by the 75th percentile of the cumulative distribution of position errors"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionAccuracy> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accuracyPercentile95> a owl:ObjectProperty ;
    rdfs:comment "Accuracy defined by the 95th percentile of the cumulative distribution of position errors"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionAccuracy> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#areaNameProperty> a owl:DatatypeProperty ;
    rdfs:comment "The name of the area."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atMotorwayInterchange> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "At a motorway interchange."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atRestArea> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "At rest area off the carriageway."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atServiceArea> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "At service area."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atTollPlaza> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "At toll plaza."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atTunnelEntryOrExit> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "At entry or exit of tunnel."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#bearing> a owl:ObjectProperty ;
    rdfs:comment "Accuracy defined by the 95th percentile of the cumulative distribution of position errors"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointByCoordinates> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AngleInDegreesValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#capacityRemaining> a owl:DatatypeProperty ;
    rdfs:comment "The ratio of current capacity to the normal (free flow) road capacity in the defined direction, expressed as a percentage. Capacity is the maximum number of vehicles that can pass a specified point on the road, in unit time given the specified conditions."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> ;
    rdfs:range <http://qudt.org/schema/qudt/floatPercentage> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#confidentialityOverride> a owl:ObjectProperty ;
    rdfs:comment "The extent to which the related information may be circulated, according to the recipient type. Recipients must comply with this confidentiality statement. This overrides any confidentiality defined for the situation as a whole in the header information."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConfidentialityValueEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#dataError> a owl:DatatypeProperty ;
    rdfs:comment "Indication of whether the value is deemed to be erroneous by the supplier (true = erroneous). If not present, the data value is assumed to be ok. This may be used when automatic fault detection information relating to sensors is available."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> ;
    rdfs:range xsd:boolean .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#defaultLanguage> a owl:ObjectProperty ;
    rdfs:comment "Specifies the language by an ISO 639-1 2-alpha code"@en,
        "The default language used throughout the payload publication"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayloadPublication> ;
    rdfs:range <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Alpha2Code> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#delayBand> a owl:ObjectProperty ;
    rdfs:comment "The time band within which the additional travel time due to adverse travel conditions of any kind falls, when compared to \"normal conditions\"."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Delays> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DelayBandEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#delayTimeValue> a owl:DatatypeProperty ;
    rdfs:comment "The value of the additional travel time due to adverse travel conditions of any kind, when compared to \"normal conditions\", given in seconds."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Delays> ;
    rdfs:range xsd:decimal ;
    owl:equivalentProperty time:seconds .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#delaysType> a owl:ObjectProperty ;
    rdfs:comment "Coarse classification of the delay."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Delays> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DelaysTypeEnum> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#descriptorString> a owl:DatatypeProperty ;
    rdfs:comment "A text string which describes or elaborates the location. Here is used for values distinct to RoadNumbers or AdministrativeUnit."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegDescriptor> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#directionAtPoint> a owl:ObjectProperty ;
    rdfs:comment "The direction of traffic flow at the specified point in terms of general destination direction."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointAlongLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#directionOnLinearSection> a owl:ObjectProperty ;
    rdfs:comment "The direction of traffic flow on the linear section in terms of general destination direction."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearWithinLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#directionRelativeAtPoint> a owl:ObjectProperty ;
    rdfs:comment "The direction of traffic flow at the specified point relative to the direction in which the linear element is defined."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointAlongLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#directionRelativeOnLinearSection> a owl:ObjectProperty ;
    rdfs:comment ""@en,
        "The direction of traffic flow on the linear section relative to the direction in which the linear element is defined."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearWithinLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#distanceAlong> a owl:ObjectProperty ;
    rdfs:comment "A measure of distance along a linear element."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceFromLinearElementReferent> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceFromLinearElementStart> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#extremelyUrgent> a owl:NamedIndividual ;
    rdfs:comment "Dissemination of the information is extremely urgent."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#feedDescription> a owl:DatatypeProperty ;
    rdfs:comment "A description of the information which is to be found in the publications originating from the particular feed (URL)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayloadPublication> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#feedType> a owl:DatatypeProperty ;
    rdfs:comment "A classification of the information which is to be found in the publications originating from the particular feed."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayloadPublication> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#generalMessageToRoadUsers> a owl:DatatypeProperty ;
    rdfs:comment "General message that is issued by the network/road operator which is applicable to drivers and sometimes passengers, e.g. details about an amber alert (missing or abducted child alert)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsers> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#gmlAreaName> a owl:DatatypeProperty ;
    rdfs:comment "Name of the multi-polygon area"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlMultiPolygon> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#gmlPosList> a owl:DatatypeProperty ;
    rdfs:comment "List of coordinate Tuples define the geometry of this GmlLineString. There must be at least 2 Tuples of coordinates."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLineString> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#GmlPosList> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAbnormalTrafficType> a owl:ObjectProperty ;
    rdfs:comment "A characterization of the nature of abnormal traffic flow, i.e. specifically relating to the nature of the traffic movement, implying a level of service."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTraffic> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTrafficTypeEnum> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAccidentType> a owl:ObjectProperty ;
    rdfs:comment "A characterization of the nature of the accident."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Accident> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AccidentTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAdministrativeAreaOfLinearSection> a owl:ObjectProperty ;
    rdfs:comment "Identification of the road administration area which contains the specified linear section."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearWithinLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAdministrativeAreaOfPoint> a owl:ObjectProperty ;
    rdfs:comment "Identification of the road administration area which contains the specified point."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointAlongLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCAffectedDirection> a owl:ObjectProperty ;
    rdfs:comment "The direction(s) of traffic flow to which the situation, traffic data or information is related."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearDirectionEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCDirectionCoded> a owl:ObjectProperty ;
    rdfs:comment "Direction of navigation with respect to secondary to primary location (RDS direction)"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirectionEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCMethod2SecondaryPointLocation> a owl:ObjectProperty ;
    rdfs:comment "ALERT-C method2 secondary point location"@en,
        "The point (called Secondary point) which is at the upstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2Linear> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2SecondaryPointLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCMethod4SecondaryPointLocation> a owl:ObjectProperty ;
    rdfs:comment "ALERT-C method4 secondary point location"@en,
        "The point (called Secondary point) which is at the upstream end of a linear road section. The point is specified by a reference to a point in a pre-defined Alert-C location table plus a non-negative offset distance."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4Linear> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4SecondaryPointLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAltitudeAccuracyCodedValue> a owl:ObjectProperty ;
    rdfs:comment "Absolute accuracy of reported value of a geographical point for a confidence level expressed by a coded scale."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AltitudeConfidence> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AltitudeAccuracyEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAltitudeConfidence> a owl:ObjectProperty ;
    rdfs:comment "Evaluation of the altitude confidence assessed according to ETSI ISO 102894-2"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightCoordinate> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AltitudeConfidence> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAnimalPresenceTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Indicates the nature of animals present on or near the roadway."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AnimalPresenceObstruction> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AnimalPresenceTypeEmum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAreaPlacesEnum> a owl:ObjectProperty ;
    rdfs:comment "Places, in generic terms, at which the corresponding information applies."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaPlacesEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasCarriagewayEnum> a owl:ObjectProperty ;
    rdfs:comment "Indicates the section of carriageway to which the location relates."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Carriageway> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CarriagewayEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasCentrePoint> a owl:ObjectProperty ;
    rdfs:comment "Centre point of a circular geometric area."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegGeometricArea> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasComputationMethodEnum> a owl:ObjectProperty ;
    rdfs:comment "Method of computation which has been used to compute this data value."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ComputationMethodEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasConfidentiality> a owl:ObjectProperty ;
    rdfs:comment "The extent to which the related information may be circulated, according to the recipient type. Recipients must comply with this confidentiality statement."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeaderInformation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConfidentialityValueEnum> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasConstructionWorkType> a owl:ObjectProperty ;
    rdfs:comment "The type of construction work being performed."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConstructionWorks> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ConstructionWorkTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasCountrySubdivision> a owl:ObjectProperty ;
    rdfs:comment "The ISO 3166-2 subdivision code for the named area."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#IsoNamedArea> ;
    rdfs:range <http://www.omg.org/spec/LCC/Countries/CountryRepresentation#CountrySubdivision> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDelays> a owl:ObjectProperty ;
    rdfs:comment "The details of the delays being caused by the situation element defined in the situation record. It is recommended to only use one of the optional attributes to avoid confusion."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Delays> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDirectionPurpose> a owl:ObjectProperty ;
    rdfs:comment "Identifies the main purpose of the road at the location"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionPurposeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDistanceAlongLinearElement> a owl:ObjectProperty ;
    rdfs:comment "Distance of a point along a linear element either measured from the start node or a defined referent on that linear element, where the start node is relative to the element definition rather than the direction of traffic flow."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointAlongLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDistanceAlongLinearElementFrom> a owl:ObjectProperty ;
    rdfs:comment "A point on the linear element that defines the start node of the linear section."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearWithinLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDistanceAlongLinearElementTo> a owl:ObjectProperty ;
    rdfs:comment "A point on the linear element that defines the end node of the linear section."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearWithinLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceAlongLinearElement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasDrivingConditionTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Types of the perceived driving conditions."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Conditions> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DrivingConditionTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasEnvironmentalObstructionTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Characterization of an obstruction on the road resulting from an environmental cause."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#EnvironmentalObstruction> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#EnvironmentalObstructionTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGeneralInstructionOrMessageToRoadUsersType> a owl:ObjectProperty ;
    rdfs:comment "General instruction that is issued by the network/road operator which is applicable to drivers and sometimes passengers." ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsers> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsersTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGeneralNetworkManagementType> a owl:ObjectProperty ;
    rdfs:comment "The type of traffic management action instigated by the network/road operator." ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralNetworkManagement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralNetworkManagementTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGeographicDescriptor> a owl:ObjectProperty ;
    rdfs:comment "Descriptor which identifies a geographic characteristic to help identify the specific location"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeographicCharacteristicEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGmlExteriorLinearRing> a owl:ObjectProperty ;
    rdfs:comment "A boundary of a polygonal surface consisting of a ring i.e. in the normal 2D case, a closed polygonal line distinguished as exterior. Such a polygonal line has at least 4 pairs of coordinates"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlPolygon> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLinearRing> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGmlMultiPolygon> a owl:ObjectProperty ;
    rdfs:comment "An area defined by a set of polygons acording to GML (EN ISO 19136)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlMultiPolygon> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGmlPolygon> a owl:ObjectProperty ;
    rdfs:comment "Planar surface defined by 1 exterior boundary and 0 or more interior boundaries"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlMultiPolygon> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlPolygon> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeaderInformation> a owl:ObjectProperty ;
    rdfs:comment "Management information relating to the data contained within a publication."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Situation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeaderInformation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeightCoordinate> a owl:ObjectProperty ;
    rdfs:comment "Third coordinate for points defined geodetically"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightCoordinate> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeightGradeOfLinearSection> a owl:ObjectProperty ;
    rdfs:comment "Identification of whether the linear section that is part of the linear element is at, above or below the normal elevation of a linear element of that type (e.g. road or road section) at that location, typically used to indicate \"grade\" separation."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearWithinLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightGradeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeightGradeOfPoint> a owl:ObjectProperty ;
    rdfs:comment "Identification of whether the point on the linear element is at, above or below the normal elevation of a linear element of that type (e.g. road or road section) at that location, typically used to indicate \"grade\" separation."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointAlongLinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightGradeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHeightTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Type of measured height.When it is omitted it is supposed to be the ellipsoidal height."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightCoordinate> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasHorizontalPositionAccuracy> a owl:ObjectProperty ;
    rdfs:comment "Defines the horizontal position accuracy according EN 16803-1"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionAccuracy> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasImpact> a owl:ObjectProperty ;
    rdfs:comment "An assessment of the impact that an event or operator action defined by the situation record has on the driving conditions."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasImpactOnOppositeDirection> a owl:ObjectProperty ;
    rdfs:comment "An assessment of the impact that an event or operator action defined by the situation record has on the driving conditions, but on opposite direction."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasInformationStatus> a owl:ObjectProperty ;
    rdfs:comment "The status of the related information (real, test, exercise ....)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeaderInformation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InformationStatusEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasInfrastructureDamageType> a owl:ObjectProperty ;
    rdfs:comment "Types of infrastructure damage which may have an effect on the road network."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDamageObstruction> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDamageTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasInfrastructureDescriptor> a owl:ObjectProperty ;
    rdfs:comment "Descriptor which identifies infrastructure to help identify the specific location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLaneEnum> a owl:ObjectProperty ;
    rdfs:comment "Indicates the specific lane to which the location relates."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Lane> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LaneEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLinearElementNature> a owl:ObjectProperty ;
    rdfs:comment "An indication of the nature of the linear element."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementNatureEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLocationCodeForLinearLocation> a owl:ObjectProperty ;
    rdfs:comment "Specific location. Unique code within the ALERT-C location table which identifies the specific point, linear or area location.Unique code within the ALERT-C location table which identifies the specific point, linear or area location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinearByCode> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLocationContainedInItinerary> a owl:ObjectProperty ;
    rdfs:comment "A location contained in an itinerary (i.e. an ordered set of locations defining a route or itinerary)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ItineraryByIndexedLocations> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Location> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLocationReference> a owl:ObjectProperty ;
    rdfs:comment "Has a location reference"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LocationReference> ;
    owl:inverseOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#isLocationReferenceOf> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMaintenanceVehicles> a owl:ObjectProperty ;
    rdfs:comment "Details of the maintenance vehicles involved in the roadworks activity."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MaintenanceVehicles> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobilityOfActivity> a owl:ObjectProperty ;
    rdfs:comment "Specifies the mobility of activity"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Activity> ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobility> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobilityOfObstruction> a owl:ObjectProperty ;
    rdfs:comment "Specifies the mobility of a obstruction"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobility> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasMobilityType> a owl:ObjectProperty ;
    rdfs:comment "Types of mobility relating to a situation element defined by a SituationReord."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Mobility> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MobilityTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNamedAreaTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "The type of the area."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedAreaTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNonWeatherRelatedRoadConditionTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "The type of road conditions which are not related to the weather."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NonWeatherRelatedRoadConditions> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NonWeatherRelatedRoadConditionTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNutsCodeTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "The NUTS code type for the named area."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NutsNamedArea> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NutsCodeTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasObstructionTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Characterization of the type of general obstruction."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralObstruction> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ObstructionTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrAreaLocationReference> a owl:ObjectProperty ;
    rdfs:comment "A two-dimensional part of the surface of the earth which is bounded by a closed curve. An area location may cover parts of the road network but does not necessarily need to. It is represented according to the OpenLR standard for Area Locations"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrAreaLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrFirstDirection> a owl:ObjectProperty ;
    rdfs:comment "First OpenLR reference in first/main direction."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLinear> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrFormOfWayEnum> a owl:ObjectProperty ;
    rdfs:comment "A classification based on the importance of the role that the Road Element (or Ferry Connection) performs in the connectivity of the total road network. (EN ISO 14825 § 7.2.88)"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineAttributes> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrFormOfWayEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrGeoCoordinate> a owl:ObjectProperty ;
    rdfs:comment "A geo-coordinate pair is a position in a map defined by its longitude and latitude coordinate values."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrCircleLocationReference> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrGeoCoordinate> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLineAttributes> a owl:ObjectProperty ;
    rdfs:comment "Properties of the line towards the topologically adjacent OpenLR location referencing point, on the shortest path to that point."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBaseReferencePoint> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineAttributes> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLinear> a owl:ObjectProperty ;
    rdfs:comment "OpenLR line location reference"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLinear> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLowerLeft> a owl:ObjectProperty ;
    rdfs:comment "The lower left corner of the rectangle."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrRectangle> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrOppositeDirection> a owl:ObjectProperty ;
    rdfs:comment "If both direction, this is the reference in the opposite direction against firstDirection."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLinear> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrOrientation> a owl:ObjectProperty ;
    rdfs:comment "Orientation of the driving direction in relation with the direction of the underlying linear"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBasePointLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOrientationEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrPathAttributes> a owl:ObjectProperty ;
    rdfs:comment "Properties of the path from the associated location reference point to the next location reference point, which are specified to assist correct identification of the point in an external map data source."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLocationReferencePoint> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPathAttributes> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrPointLocationReference> a owl:ObjectProperty ;
    rdfs:comment "PointLocation is associated to OpenlrPointLocationReference with cardinality 0..1"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPointLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrPolygonCorners> a owl:ObjectProperty ;
    rdfs:comment "A geodetic coordinate Tuple that defines the vertices of the underlying geometrical polygon."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPolygonLocationReference> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPolygonCorners> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrSideOfRoad> a owl:ObjectProperty ;
    rdfs:comment "Provides the of road where the corresponding point lies."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrBasePointLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrSideOfRoadEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrUpperRight> a owl:ObjectProperty ;
    rdfs:comment "The upper right corner of the rectangle."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrRectangle> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPointByCoordinates> a owl:ObjectProperty ;
    rdfs:comment "PointLocation is associated to PointByCoordinates with cardinality 0..1"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointByCoordinates> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPoorEnvironmentTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Any environmental conditions which may be affecting the driving conditions on the road."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PoorEnvironmentConditions> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PoorEnvironmentTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPositionConfidenceCodedErrorEnum> a owl:ObjectProperty ;
    rdfs:comment "Error code in case the altitude confidence is out of range or cannot be determined"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AltitudeConfidence> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceCodedErrorEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPositionConfidenceEllipse> a owl:ObjectProperty ;
    rdfs:comment "Confidence ellipse position defined in a shape of ellipse with a predefined confidence level (e.g. 95 %). The centre of the ellipse shape corresponds to the reference position point for which the position accuracy is evaluated."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceEllipse> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasPositionOnCarriageway> a owl:ObjectProperty ;
    rdfs:comment "Relative position across carriageway"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RelativePositionOnCarriagewayEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasProbabilityOfOccurrence> a owl:ObjectProperty ;
    rdfs:comment "An assessment of the degree of likelihood that the reported event will occur."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ProbabilityOfOccurrenceEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentEndPointLinearElement> a owl:ObjectProperty ;
    rdfs:comment "The referent at a known location on the linear object which defines the end of the linear element."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementByPoints> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferent> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentFrom> a owl:ObjectProperty ;
    rdfs:comment "A known location along the linear element from which the distanceAlong is measured, termed the \"fromReferent\" in EN ISO 19148."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceFromLinearElementReferent> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferent> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentIntermediatePointLinearElement> a owl:ObjectProperty ;
    rdfs:comment "A referent at a known location on the linear object which is neither the start or end of the linear element."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementByPoints> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferent> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentStartPointLinearElement> a owl:ObjectProperty ;
    rdfs:comment "The referent at a known location on the linear object which defines the start of the linear element."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementByPoints> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferent> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentTowards> a owl:ObjectProperty ;
    rdfs:comment "A known location along the linear element towards which the distanceAlong is measured, termed the \"towardsReferent\" in EN ISO 19148."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DistanceFromLinearElementReferent> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferent> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReferentTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "The type of the referent."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReferentTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRelativeTrafficFlowEnum> a owl:ObjectProperty ;
    rdfs:comment "Assessment of the traffic flow conditions relative to normally expected conditions at this date/time."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTraffic> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RelativeTrafficFlowEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasReroutingManagementType> a owl:ObjectProperty ;
    rdfs:comment "Management actions relating to rerouting."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReroutingManagement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ReroutingManagementTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadMaintenanceType> a owl:ObjectProperty ;
    rdfs:comment "The type of road maintenance or installation work at the specified location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MaintenanceWorks> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadMaintenanceTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadsideAssistenceTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Indicates the nature of the road side assistance that will be, is or has been provided."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadsideAssistance> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadworksDuration> a owl:ObjectProperty ;
    rdfs:comment "Indicates in general terms the expected duration of the roadworks."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadworksDurationEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasRoadworksScaleEnum> a owl:ObjectProperty ;
    rdfs:comment "Grade of complexity of the roadworks according to the responsible road operator. For example determined by size, duration and/or traffic disruption."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadworksScaleEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSecondarySupplementaryDescription> a owl:ObjectProperty ;
    rdfs:comment "Supplementary description that applies to the secondary end of the linear location. Use when properties change along the Linear. For a one-way linear the secondary end should be the destination end."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSemiMajorAxisLengthCodedError> a owl:ObjectProperty ;
    rdfs:comment "Provides a coded error in case the semi-major axis length is not defined"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceEllipse> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceCodedErrorEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSemiMinorAxisLengthCodedError> a owl:ObjectProperty ;
    rdfs:comment "Provides a coded error in case the semi-minor axis length is not defined"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceEllipse> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceCodedErrorEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSeverityEnum> a owl:ObjectProperty ;
    rdfs:comment "Levels of severity of a situation as whole assessed by the impact that the situation may have on traffic flow as perceived by the supplier."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SeverityEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSituationRecord> a owl:ObjectProperty ;
    rdfs:comment "Details of the Situation"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Situation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSource> a owl:ObjectProperty ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Source> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSpeedManagementType> a owl:ObjectProperty ;
    rdfs:comment "Type of speed management action instigated by operator."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedManagement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedManagementTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSubdivisionTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "The ISO 3166-2 subdivison type for the named area."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#IsoNamedArea> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSubject> a owl:ObjectProperty ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Subjects> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSubjectTypeOfWorks> a owl:ObjectProperty ;
    rdfs:comment "The subject type of the roadworks (i.e. on what the construction or maintenance work is being performed)." ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Subjects> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubjectTypeOfWorksEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSupplementaryPositionalDescription> a owl:ObjectProperty ;
    rdfs:comment "A collection of supplementary positional information which improves the precision of the location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegAreaLocation> a owl:ObjectProperty ;
    rdfs:comment "A geographic or geometric area defined by a TPEG-Loc structure which may include height information for additional geospatial discrimination."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegFramedPoint> a owl:ObjectProperty ;
    rdfs:comment "A single non-junction point on the road network which is framed between two other specified points on the road network."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegFramedPoint> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegNonJunctionPoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegHeight> a owl:ObjectProperty ;
    rdfs:comment "Height information which provides additional discrimination for the applicable area."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegHeight> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegJunctionPointDescriptor> a owl:ObjectProperty ;
    rdfs:comment "A name which identifies a junction point on the road network"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegJunction> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegJunctionPointDescriptor> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegLinearLocation> a owl:ObjectProperty ;
    rdfs:comment "A linear section along a single road defined between two points on the same road by a TPEG-Loc structure."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SingleRoadLinearLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLinearLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegOtherPointDescriptor> a owl:ObjectProperty ;
    rdfs:comment "A descriptive name which helps to identify the non-junction point. At least one descriptor must identify the road on which the point is located, i.e. must be of type 'linkName' or 'localLinkName'."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegJunction> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegNonJunctionPoint> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegOtherPointDescriptor> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegPoint> a owl:ObjectProperty ;
    rdfs:comment "A single point defined by a coordinate set and TPEG descriptors."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegSimplePoint> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegPointFrom> a owl:ObjectProperty ;
    rdfs:comment "The location at the up stream end of the linear section of road."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegFramedPoint> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLinearLocation> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegPointLocation> a owl:ObjectProperty ;
    rdfs:comment "PointLocation is associated to TpegPointLocation with cardinality 0..1"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPointLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTrafficConstrictionTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Types of the constriction to which traffic is subjected as a result of an event."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficElement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficConstrictionTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTrafficFlowCharacteristicsEnum> a owl:ObjectProperty ;
    rdfs:comment "The consistency (steadiness) of the traffic flow."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTraffic> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficFlowCharateristicsEnum> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTrafficTrendTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "A characterization of the trend in the traffic conditions at the specified location and direction."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTraffic> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficTrendTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasValidity> a owl:ObjectProperty ;
    rdfs:comment "Specification of validity, either explicitly or by a validity time period specification which may be discontinuous."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Validity> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasValidityStatus> a owl:ObjectProperty ;
    rdfs:comment "Specification of validity, either explicitly overriding the validity time specification or confirming it."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Validity> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ValidityStatusEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVehicleCharacteristics> a owl:ObjectProperty ;
    rdfs:comment "The characteristics of a vehicle, e.g. lorry of gross weight greater than 30 tonnes."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Vehicle> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleCharacteristics> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVehicleObstructionTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Characterization of an obstruction on the road caused by one or more vehicles."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstruction> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstructionTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVehicleStatus> a owl:ObjectProperty ;
    rdfs:comment "Vehicle status."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Vehicle> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleStatusEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVehicleTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "Vehicle type."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleCharacteristics> <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstruction> ) ] ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasVerticalPositionAccuracy> a owl:ObjectProperty ;
    rdfs:comment "Defines the horizontal position accuracy according EN 16803-1"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightCoordinate> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionAccuracy> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasWeatherRelatedRoadConditionTypeEnum> a owl:ObjectProperty ;
    rdfs:comment "The type of road surface condition that is related to the weather which is affecting the driving conditions."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WeatherRelatedRoadConditions> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WeatherRelatedRoadConditionType> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#height> a owl:ObjectProperty ;
    rdfs:comment "A measurement of height in metres"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegHeight> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#heightValue> a owl:ObjectProperty ;
    rdfs:comment "Value in metres for the height measured vertically at to the planar coordinates the point corresponding."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightCoordinate> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inGallery> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "In gallery."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#inTunnel> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "In tunnel."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#isLocationReferenceOf> a owl:ObjectProperty ;
    rdfs:comment "It is location reference of ..."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#laneNumber> a owl:DatatypeProperty ;
    rdfs:comment "The number of the lane, where 1 is nearest the hard shoulder/verge and the numbers increase towards the central reservation/road axis."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Lane> ;
    rdfs:range xsd:integer .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#lengthAffected> a owl:ObjectProperty ;
    rdfs:comment "This indicates the length (measured in metres) of carriageway (and lanes) affected by the associated traffic element."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#linearElementIdentifier> a owl:DatatypeProperty ;
    rdfs:comment "An identifier or code of a linear element (or link) in the road network reference model that is specified in the LinearElement class."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElementByCode> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#linearElementReferenceModel> a owl:DatatypeProperty ;
    rdfs:comment "The identifier of a road network reference model which segments the road network according to specific business rules."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElement> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#linearElementReferenceModelVersion> a owl:DatatypeProperty ;
    rdfs:comment "The version of the identified road network reference model."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LinearElement> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#locationDescription> a owl:DatatypeProperty ;
    rdfs:comment "Supplementary human-readable description of the location"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#locationPrecision> a owl:ObjectProperty ;
    rdfs:comment "Indicates that the location is given with a precision which is better than the stated value in metres."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#minimumCarOccupancy> a owl:DatatypeProperty ;
    rdfs:comment "The minimum number of persons required in a vehicle in order for it to be allowed to transit the specified road section."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadOrCarriagewayOrLaneManagement> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nationalIdentifier> a owl:DatatypeProperty ;
    rdfs:comment "Identifier or name unique within the specified country."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InternationalIdentifier> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#normalUrgency> a owl:NamedIndividual ;
    rdfs:comment "Dissemination of the information is of normal urgency."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfIncompleteInputs> a owl:DatatypeProperty ;
    rdfs:comment "The number of inputs detected but not completed during the sampling or measurement period; e.g. vehicles detected entering but not exiting the detection zone."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> ;
    rdfs:range xsd:nonNegativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfInputValuesUsed> a owl:DatatypeProperty ;
    rdfs:comment "The number of input values used in the sampling or measurement period to determine the data value."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> ;
    rdfs:range xsd:nonNegativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfLanesRestricted> a owl:DatatypeProperty ;
    rdfs:comment "The number of normally usable lanes on the carriageway which are now restricted either fully or partially (this may include the hard shoulder if it is normally available for operational use, e.g. in hard shoulder running schemes)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> ;
    rdfs:range xsd:nonNegativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfMaintenanceVehicles> a owl:DatatypeProperty ;
    rdfs:comment "The number of maintenance vehicles associated with the roadworks activities at the specified location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MaintenanceVehicles> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfObstructions> a owl:DatatypeProperty ;
    rdfs:comment "Number of Obstructions. Not in SRTI profile"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> ;
    rdfs:range xsd:nonNegativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfOperationalLanes> a owl:DatatypeProperty ;
    rdfs:comment "The number of usable lanes in the specified direction which remain fully operational (this may include the hard shoulder if it is being used as an operational lane)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> ;
    rdfs:range xsd:nonNegativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfSubjects> a owl:DatatypeProperty ;
    rdfs:comment "The number of subjects on which the roadworks (construction or maintenance) are being performed."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Subjects> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#numberOfVehiclesWaiting> a owl:DatatypeProperty ;
    rdfs:comment "The number of vehicles waiting in a queue."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTraffic> ;
    rdfs:range xsd:nonNegativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nutsCode> a owl:ObjectProperty ;
    rdfs:comment "The NUTS code for the named area."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NutsNamedArea> ;
    rdfs:range <http://data.europa.eu/nuts/code/> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#observeSpeedLimits> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Observe speed limit."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#offsetDistance> a owl:ObjectProperty ;
    rdfs:comment "The non-negative offset distance from the ALERT-C referenced point to the actual point. The ALERT-C locations in the primary and secondary locations must always encompass the linear section being specified, thus offset distance is towards the other point."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OffsetDistance> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onBridge> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On bridge"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onConnector> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On connecting carriageway between two different roads or road sections."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onElevatedSection> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On elevated section of road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onFlyover> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On flyover, i.e. on section of road over another road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onIceRoad> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On ice road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onLevelCrossing> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On level-crossing."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onLinkRoad> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On road section linking two different roads."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onRoundabout> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On roundabout."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onTheRoadway> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On the roadway."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onUndergroundSection> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On underground section of road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#onUnderpass> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On underpass, i.e. section of road which passes under another road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrBearing> a owl:ObjectProperty ;
    rdfs:comment "Defines the bearing field as an integer value between 0 and 359"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLineAttributes> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AngleInDegreesValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrDistanceToNextLRPoint> a owl:DatatypeProperty ;
    rdfs:comment "The DNP attribute measures the distance in meters between two consecutive location reference-points along the location reference path described in the corresponding enumeration"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrPathAttributes> ;
    rdfs:range xsd:nonNegativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrNegativeOffset> a owl:ObjectProperty ;
    rdfs:comment "The negative offset along the line of the location measured along the line reference path between the end point of the location reference and the ending node of the line reference path."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOffsets> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrNumColumns> a owl:DatatypeProperty ;
    rdfs:comment "The number that the base rectangle should be multiplied in the east direction"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrGridLocationReference> ;
    rdfs:range xsd:nonNegativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrNumRows> a owl:DatatypeProperty ;
    rdfs:comment "The number that the base rectangle should be multiplied in the north direction"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrGridLocationReference> ;
    rdfs:range xsd:nonNegativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrPositiveOffset> a owl:ObjectProperty ;
    rdfs:comment "The positive offset along the line of the location measured along the line reference path between the start point of the location reference and the starting node of the line reference path."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrOffsets> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrRadius> a owl:ObjectProperty ;
    rdfs:comment "The radius of the corresponding circular area."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrCircleLocationReference> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#originalNumberOfLanes> a owl:DatatypeProperty ;
    rdfs:comment "Normal number of lanes, potentially available for moving traffic, before reduction due to situations. Hard shoulder should not be counted unless it is sometimes used operationally for moving traffic."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Carriageway> ;
    rdfs:range xsd:int .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#percentageDistanceAlong> a owl:DatatypeProperty ;
    rdfs:comment "A measure of distance along a linear element from the start of the element expressed as a percentage of the total length of the linear object."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PercentageDistanceAlongLinearElement> ;
    rdfs:range <http://qudt.org/schema/qudt/floatPercentage> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#policeSpeedChecksInOperation> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Police speed checks are in operation."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#publicTransportAlternative> a owl:DatatypeProperty ;
    rdfs:comment "Describes an available public transport alternative to the normal route"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#publicationCreator> a owl:ObjectProperty ;
    rdfs:comment "Specifies the publication creator using an international identifier"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayloadPublication> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InternationalIdentifier> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#publicationTime> a owl:DatatypeProperty ;
    rdfs:comment "Date/time at which the payload publication was created."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PayloadPublication> ;
    rdfs:range xsd:dateTime .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#qudtObjectProperties> a owl:ObjectProperty ;
    rdfs:comment "Only for organizational purposes. Qudt object properties"@en ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedObjectProperties> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#queueLength> a owl:ObjectProperty ;
    rdfs:comment "The length of a queue or the average length of queues in separate lanes due to a situation."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AbnormalTraffic> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#radius> a owl:ObjectProperty ;
    rdfs:comment "The radius of the corresponding circular area"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegGeometricArea> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#reasonForDataError> a owl:DatatypeProperty ;
    rdfs:comment "The reason why the value is deemed to be erroneous by the supplier."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#reduceYourSpeed> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedManagementTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Reduce your speed."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#referentDescription> a owl:DatatypeProperty ;
    rdfs:comment "Description of the referent."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#referentIdentifier> a owl:DatatypeProperty ;
    rdfs:comment "The identifier of the referent, unique on the specified linear element (i.e. road or part of)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#referentName> a owl:DatatypeProperty ;
    rdfs:comment "The name of the referent, e.g. a junction or intersection name."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Referent> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#reliable> a owl:DatatypeProperty ;
    rdfs:comment "An indication as to whether the source deems the associated information to be reliable/correct. \"True\" indicates it is deemed reliable."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Source> ;
    rdfs:range xsd:boolean .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#residualLaneWidth> a owl:ObjectProperty ;
    rdfs:comment "The width of lanes after any lane narrowing" ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#residualRoadWidth> a owl:ObjectProperty ;
    rdfs:comment "The total width of the combined operational lanes in the specified direction." ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Impact> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadDestination> a owl:DatatypeProperty ;
    rdfs:comment "A destination associated with this road."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadInformation> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#roadworksIdentifier> a owl:DatatypeProperty ;
    rdfs:comment "An external identifier for the roadworks"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#safetyRelatedMessage> a owl:DatatypeProperty ;
    rdfs:comment "Indicates, whether this SituationRecord specifies a safety related message according to Commission Delegated Regulation (EU) No 886/2013."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range xsd:boolean .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#semiMajorAxisLength> a owl:ObjectProperty ;
    rdfs:comment "Half of length of the major axis, i.e. distance between the centre point and major axis point of the position accuracy ellipse."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceEllipse> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#semiMajorAxisOrientation> a owl:ObjectProperty ;
    rdfs:comment "Orientation direction of the ellipse major axis of the position accuracy ellipse with regards to the geographic north."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceEllipse> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AngleInDegreesValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#semiMajorAxisOrientationError> a owl:DatatypeProperty ;
    rdfs:comment "Indicates whether the ellipse orientation is unavailable (True) or not (False)"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceEllipse> ;
    rdfs:range xsd:boolean .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#semiMinorAxisLength> a owl:ObjectProperty ;
    rdfs:comment "Half of length of the minor axis, i.e. distance between the centre point and minor axis point of the position accuracy ellipse"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PositionConfidenceEllipse> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsFloatValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sequentialRampNumber> a owl:DatatypeProperty ;
    rdfs:comment "The sequential number of an exit/entrance ramp from a given location in a given direction (normally used to indicate a specific exit/entrance in a complex junction/intersection)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SupplementaryPositionalDescription> ;
    rdfs:range xsd:negativeInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordCreationReference> a owl:DatatypeProperty ;
    rdfs:comment "A unique alphanumeric reference (e.g. an external reference or a UUID) of the SituationRecord object (the first version of the record) that was created by the original supplier."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordCreationTime> a owl:DatatypeProperty ;
    rdfs:comment "The date/time that the SituationRecord object (the first version of the record) was created by the original supplier."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range xsd:dateTime .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordFirstSupplierVersionTime> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The date/time that the current version of the Situation Record was written into the database of the original supplier in the supply chain."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range xsd:dateTime .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordObservationTime> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range xsd:dateTime .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordVersion> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Version of Situation Record"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range xsd:int .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#situationRecordVersionTime> a owl:DatatypeProperty ;
    rdfs:comment "The date/time that this current version of the SituationRecord within the situation was written into the database of the supplier which is involved in the data exchange. Identity and version of record are defined by the class stereotype implementation."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SituationRecord> ;
    rdfs:range xsd:dateTime .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#skosDataProperties> a owl:DatatypeProperty ;
    rdfs:comment "For organizational purposes"@en ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedDataProperties> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#smoothingFactor> a owl:DatatypeProperty ;
    rdfs:comment "Coefficient required when a moving average is computed to give specific weights to the former average and the new data. A typical formula is, F being the smoothing factor: New average = (old average) F + (new data) (1 - F)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> ;
    rdfs:range xsd:float .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sourceCountry> a owl:ObjectProperty ;
    rdfs:comment "EN ISO 3166-1 two-character country code of the source of the information."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Source> ;
    rdfs:range <http://www.omg.org/spec/LCC/Countries/CountryRepresentationi#Alpha2Code> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sourceIdentification> a owl:DatatypeProperty ;
    rdfs:comment "Language independent textual code or identifier for the organisation or the equipment that has produced the information."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Source> ;
    rdfs:range xsd:string .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sourceName> a owl:DatatypeProperty ;
    rdfs:comment "The name of the organisation which has produced the information relating to this version of the information."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Source> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#sourceType> a owl:ObjectProperty ;
    rdfs:comment "Information about the technology used for measuring the data or the method used for obtaining qualitative descriptions relating to this version of the information."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Source> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SourceTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#speed> a owl:ObjectProperty ;
    rdfs:comment "Speed of the mobile entity."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Mobility> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedValue> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#srsDimension> a owl:DatatypeProperty ;
    rdfs:comment "Provides the size of the tuple of coordinates of each point. This number is 2 or 3. By default when omitted the dimension shall be interpreted as 2."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLineString> ;
    rdfs:range xsd:positiveInteger .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#srsName> a owl:DatatypeProperty ;
    rdfs:comment "Specifies the Coordinate Reference System (CRS) used to interpret the coordinates in this GmlLineString"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GmlLineString> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#standardDeviation> a owl:DatatypeProperty ;
    rdfs:comment "The standard deviation of the sample of input values from which this value was derived, measured in the units of the data value."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> ;
    rdfs:range xsd:float .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#supplierCalculatedDataQuality> a owl:DatatypeProperty ;
    rdfs:comment "A measure of data quality assigned to the value by the supplier. 100% equates to ideal/perfect quality. The method of calculation is supplier specific and needs to be agreed between supplier and client."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DataValue> ;
    rdfs:range <http://qudt.org/schema/qudt/floatPercentage> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#temporarySpeedLimit> a owl:ObjectProperty ;
    rdfs:comment "Temporary limit defining the maximum advisory or mandatory speed of vehicles."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedManagement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedValue> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegAreaDescriptorType> a owl:ObjectProperty ;
    rdfs:comment "The nature of the descriptor used to define the location under consideration (derived from the TPEG Loc table 03)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaDescriptor> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03AreaDescriptorSubtypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegAreaLocationType> a owl:ObjectProperty ;
    rdfs:comment "The type of TPEG location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegAreaLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01AreaLocationSubtypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegFramedPointLocationType> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The type of TPEG location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegFramedPoint> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01FramedPointLocationSubtypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegHeightType> a owl:ObjectProperty ;
    rdfs:comment "A descriptive identification of relative height using TPEG-Loc location referencing."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegHeight> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc04HeightTypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegIlcPointDescriptorType> a owl:ObjectProperty ;
    rdfs:comment "The nature of the descriptor used to define the location under consideration (derived from the TPEG Loc table 03)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegIlcPointDescriptor> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03IlcPointDescriptorSubtypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegJunctionPointDescriptorType> a owl:ObjectProperty ;
    rdfs:comment "The nature of the descriptor used to define the location under consideration (derived from the TPEG Loc table 03)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegJunctionPointDescriptor> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03JunctionPointDescriptorSubtypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegLinearLocationType> a owl:ObjectProperty ;
    rdfs:comment "The type of TPEG location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLinearLocation> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TPEGLoc01LinearLocationSubtypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegOtherPointDescriptorType> a owl:ObjectProperty ;
    rdfs:comment "The nature of the descriptor used to define the location under consideration (derived from the TPEG Loc table 03)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegOtherPointDescriptor> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegSimplePointLocationType> a owl:ObjectProperty ;
    rdfs:comment "The type of TPEG location."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegSimplePoint> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01SimplePointLocationSubtypeEnum> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficManuallyDirectedBy> a owl:ObjectProperty ;
    rdfs:comment "Type of person that is manually directing traffic (applicable if generalNetworkManagementType is set to \"trafficBeingManuallyDirected\")."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralNetworkManagement> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PersonCategoryEnum> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#underTraffic> a owl:DatatypeProperty ;
    rdfs:comment "Indicates that the road section where the roadworks are located is under traffic or not under traffic. 'True' indicates the road is under traffic."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> ;
    rdfs:range xsd:boolean .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#urgent> a owl:NamedIndividual ;
    rdfs:comment "Dissemination of the information is urgent."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#urgentRoadworks> a owl:DatatypeProperty ;
    rdfs:comment "Indication of whether the roadworks are considered to be urgent whereby emergency work is being, or needs to be, undertaken to mitigate safety concerns. 'True' indicates they are urgent."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadWorks> ;
    rdfs:range xsd:boolean .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#validityTimeSpecification> a owl:ObjectProperty ;
    rdfs:comment "A specification of periods of validity defined by overall bounding start and end times and the possible intersection of valid periods with exception periods (exception periods overriding valid periods)."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Validity> ;
    rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OverallPeriod> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#vehicleFlowRate> a owl:DatatypeProperty ;
    rdfs:comment "A value of vehicle flow rate expressed in vehicles per hour."@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleFlowValue> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#VehiclesPerHour> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#venueName> a owl:DatatypeProperty ;
    rdfs:comment "Name of the venue at which the public event is being held"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PublicEvent> ;
    rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#withinJunction> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InfrastructureDescriptorEnum>,
        owl:NamedIndividual ;
    rdfs:comment "On the main carriageway within a junction between exit slip road and entry slip road."@en .

<http://datex2.eu/schema/3/Common/3_1#AlertCLocationCode> a rdfs:Datatype ;
    rdfs:comment "Unique code within the ALERT-C location table which identifies the specific point, linear or area location.Unique code within the ALERT-C location table which identifies the specific point, linear or area location."@en ;
    rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en .

<http://qudt.org/schema/qudt#qudtDataTypeProperties> a owl:DatatypeProperty ;
    rdfs:comment "For organizational purposes"@en ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedDataProperties> .

<http://qudt.org/vocab/unit/DEG> a owl:NamedIndividual ;
    rdfs:label "Degree"@en ;
    dcterms:description "A degree (in full, a degree of arc, arc degree, or arcdegree), usually denoted by     (the degree symbol), is a measurement of plane angle, representing 1/360 of a full rotation; one degree is equivalent to  ,  . It is not an SI unit, as the SI unit for angles is radian, but is an accepted SI unit."@en ;
    rdfs:comment "Unit of measure: Degrees"@en ;
    rdfs:isDefinedBy "http://qudt.org/2.1/vocab/unit"@en .

<http://qudt.org/vocab/unit/KiloM-PER-HR> a owl:NamedIndividual ;
    rdfs:label "Kilometer per Hour"@en ;
    dcterms:description "\"Kilometer per Hour\" is a C.G.S System unit for 'Linear Velocity' expressed as  km/hr."@en ;
    rdfs:comment "Unit of measure: Kilometers per Hour"@en ;
    rdfs:isDefinedBy "http://qudt.org/2.1/vocab/unit"@en .

<http://www.w3.org/2003/01/geo/wgs84_pos#Point> a owl:Class ;
    rdfs:label "point" ;
    rdfs:comment " \\nUniquely identified by lat/long/alt. i.e.\\n\\nspaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),\\n  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).\\n\\nsameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).\\n  ",
        "A point, typically described using a coordinate system relative to Earth, such as WGS84.\\n  " ;
    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#" ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a owl:Class ;
    rdfs:comment "Spatial thing"@en ;
    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Geo_WGS84> .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Latitude in WGS84"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geo_WGS84> .

<http://www.w3.org/2003/01/geo/wgs84_pos#lon> a owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Longitude in WGS84"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geo_WGS84> .

time:ProperInterval rdfs:isDefinedBy "http://www.w3.org/2006/time#" .

time:seconds rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#timeDataProperties> .

<https://datos.ign.es/def/geo_core#xETRS89> a owl:DatatypeProperty ;
    rdfs:comment "X coordinate in meters (ETRS89)"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
    rdfs:isDefinedBy "https://datos.ign.es/def/geo_core"@en ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geo_core> .

<https://datos.ign.es/def/geo_core#yETRS89> a owl:DatatypeProperty ;
    rdfs:comment "Y coordinate in meters (ETRS89)"@en ;
    rdfs:domain <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PointCoordinates> ;
    rdfs:isDefinedBy "https://datos.ign.es/def/geo_core"@en ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geo_core> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Accident> a owl:Class ;
    rdfs:comment "Accidents are events where one or more vehicles are involved in collisions or in leaving the roadway. These include collisions between vehicles or with other road users or obstacles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAccidentType> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AccidentTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TrafficElement> ;
    owl:disjointWith <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Conditions>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinearByCode> a owl:Class ;
    rdfs:comment "A linear section along a road defined by reference to a linear section in a pre-defined ALERT-C location table." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasLocationCodeForLinearLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCDirection> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCLinear> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2Point> a owl:Class ;
    rdfs:comment "A single point on the road network defined by reference to a point in a pre-defined ALERT-C location table and which has an associated direction of traffic flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod2PrimaryPointLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCMethod2PrimaryPointLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCDirection> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCPoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4Point> a owl:Class ;
    rdfs:comment "A single point on the road network defined by reference to a point in a pre-defined ALERT-C location table plus an offset distance and which has an associated direction of traffic flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCDirection> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCDirection> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCMethod4PrimaryPointLocation> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasAlertCMethod4PrimaryPointLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AlertCPoint> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#EnvironmentalObstruction> a owl:Class ;
    rdfs:comment "An obstruction on the road resulting from an environmental cause."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#EnvironmentalObstructionTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasEnvironmentalObstructionTypeEnum> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Obstruction> ;
    owl:disjointWith <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralObstruction>,
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstruction> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsers> a owl:Class ;
    rdfs:comment "General instruction and/or message that is issued by the network/road operator which is applicable to drivers and sometimes passengers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGeneralInstructionOrMessageToRoadUsersType> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsersTypeEnum> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#generalMessageToRoadUsers> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkManagement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralNetworkManagement> a owl:Class ;
    rdfs:comment "Network management action which is applicable to the road network and its users. \"trafficManuallyDirectedBy\" is only valid if \"hasGeneralNetworkManagementTypeEnum\" is set to \"trafficBeingManuallyDirected\"."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PersonCategoryEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#trafficManuallyDirectedBy> ],
        [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasGeneralNetworkManagementType> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralNetworkManagementTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkManagement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#IsoNamedArea> a owl:Class ;
    rdfs:comment "Iso named area\\tThe ISO 3166-2 representation for the named area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSubdivisionTypeEnum> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://www.omg.org/spec/LCC/Countries/CountryRepresentation#CountrySubdivision> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasCountrySubdivision> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NonWeatherRelatedRoadConditions> a owl:Class ;
    rdfs:comment "Road surface conditions that are not related to the weather but which may affect driving conditions."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WeatherRelatedRoadConditions> ],
        [ a owl:Restriction ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNonWeatherRelatedRoadConditionTypeEnum> ;
            owl:someValuesFrom <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NonWeatherRelatedRoadConditionTypeEnum> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadSurfaceConditions> ;
    owl:disjointWith <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#WeatherRelatedRoadConditions> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NutsNamedArea> a owl:Class ;
    rdfs:comment "The NUTS-Code representation for the named area (Nomenclature of territorial units for statistics) or its LAU code representation (Local Administrative Unit)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://data.europa.eu/nuts/code/> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#nutsCode> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NutsCodeTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasNutsCodeTypeEnum> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedArea> ;
    owl:equivalentClass <https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#Region> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrCircleLocationReference> a owl:Class ;
    rdfs:comment "The OpenLR method of area definition by providing a center position and a radius"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#MetresAsNonNegativeIntegerValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrRadius> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrGeoCoordinate> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrGeoCoordinate> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrAreaLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrClosedLineLocationReference> a owl:Class ;
    rdfs:comment "The OpenLR method of area definition by providing a closed path (i.e. a circuit) in the road network.\\nThe boundary always consists of road segments"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLocationReferencePoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLocationReferencePoint> ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLastLocationReferencePoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrLastLocationReferencePoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrAreaLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrGridLocationReference> a owl:Class ;
    rdfs:comment "Area defined using an OpenLR™ method consisting in defining it by a tessellation of rectangles"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrRectangle> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasOpenlrRectangle> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrNumRows> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#openlrNumColumns> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrAreaLocationReference> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenlrLine> a owl:Class ;
    rdfs:comment "Only for organizational purposes."@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OpenLR> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#OverallPeriod> a owl:Class ;
    rdfs:comment "A continuous or discontinuous period of validity defined by overall bounding start and end times and the possible intersection of valid periods (potentially recurring) with the complement of exception periods (also potentially recurring)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasEnd ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasBeginning ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CommonClasses>,
        time:ProperInterval .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PublicEvent> a owl:Class ;
    rdfs:comment "Public event"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#venueName> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Activity> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadOrCarriagewayOrLaneManagement> a owl:Class ;
    rdfs:comment "Road, carriageway or lane management action that is instigated by the network/road operator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#minimumCarOccupancy> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkManagement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadSurfaceConditions> a owl:Class ;
    rdfs:comment "Conditions of the road surface which may affect driving conditions. These may be related to the weather (e.g. ice, snow etc.) or to other conditions (e.g. oil, mud, leaves etc. on the road)"@en ;
    rdfs:subClassOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#Conditions> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedManagement> a owl:Class ;
    rdfs:comment "Speed management action that is instigated by the network/road operator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedValue> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#temporarySpeedLimit> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SpeedManagementTypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasSpeedManagementType> ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NetworkManagement> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegSimplePoint> a owl:Class ;
    rdfs:comment "A point on the road network which is not bounded by any other points on the road network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPoint> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#hasTpegPoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc01SimplePointLocationSubtypeEnum> ;
            owl:onProperty <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#tpegSimplePointLocationType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegPointLocation> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#abnormalLoad> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleObstructionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Abnormal traffic information."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#aboveGrade> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightGradeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Above or over the normal road grade elevation."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#aboveSeaLevelTPEGHeight> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc04HeightTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Height above mean sea high water level."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#aboveStreetLevelTPEGHeight> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc04HeightTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Above street level"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#aboveTPEGHeight> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc04HeightTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Above"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accident> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AccidentTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Accidents are situations in which one or more vehicles lose control and do not recover.  They include collisions between vehicle(s) or other road user(s), between vehicle(s) and fixed obstacle(s), or they result from a vehicle running off the road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accidentCause> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#CauseTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "A descriptor indicating the most significant factor causing an accident."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accidentInvolvingHazardousMaterials> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AccidentTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Includes all accidents involving at least one vehicle believed to be carrying materials, which could present an additional hazard to road users."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accidentInvolvingHeavyLorries> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AccidentTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Includes all accidents involving at least one heavy goods vehicle."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#accidentInvolvingRadioactiveMaterial> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedAreaTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Accident involving radioactive material."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#active> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ValidityStatusEnum>,
        owl:NamedIndividual ;
    rdfs:comment "The described event, action or item is currently active regardless of the definition of the validity time specification."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#administrativeAtoll> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Administrative atoll"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#administrativeRegion> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Administrative region"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#administrativeTerritory> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Administrative territory"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#adult> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PersonCategoryEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Adult."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#agriculturalShow> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PublicEventTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Agricultural show or event which could disrupt traffic."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#agriculturalVehicle> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle normally used for agricultural purposes, e.g. tractor, combined harvester etc."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#airAmbulance> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#RoadsideAssistanceTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Air ambulance assistance."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#airCrash> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ObstructionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "An air crash adjacent to the roadway which may cause traffic disruption."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#airShow> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#PublicEventTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Air show or other aeronautical event which could disrupt traffic."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#airportName> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc03OtherPointDescriptorSubtypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Name of an airport."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#allDirections> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum>,
        owl:NamedIndividual ;
    rdfs:comment "All directions (where more than two are applicable) at this point on the road network."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#allLanesCompleteCarriageway> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#LaneEnum>,
        owl:NamedIndividual ;
    rdfs:comment "In all lanes of the carriageway."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#allowEmergencyVehiclesToPass> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsersTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Allow emergency vehicles to pass"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#animalsOnTheRoad> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AnimalPresenceTypeEmum>,
        owl:NamedIndividual ;
    rdfs:comment "Traffic may be disrupted due to animals on the roadway."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#anticlockwise> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Anti-clockwise."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#anyGeneralDeliveryService> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#InformationDeliveryServicesEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Includes any general delivery channel such as broadcast channels (e.g. radio, tv, RDS-TMC, TPEG services, etc.) or web publishing available to public or to specific users, depending on Service Provider policies."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#anyVehicle> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Vehicle of any type."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#applicationRegion> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#NamedAreaTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Application region"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#approachWithCare> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeneralInstructionOrMessageToRoadUsersTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Approach with care"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#arcticRegion> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#SubdivisionTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Arctic region"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#arithmeticAverageOfSamplesBasedOnAFixedNumberOfSamples> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ComputationMethodEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Arithmetic average of sample values based on a fixed number of samples."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#arithmeticAverageOfSamplesInATimePeriod> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#ComputationMethodEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Arithmetic average of sample values in a time period."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#aroundABendInRoad> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#GeographicCharacteristicEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Around a bend in the road."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#articulatedVehicle> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#VehicleTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "Articulated vehicle."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atBorders> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaPlacesEnum>,
        owl:NamedIndividual ;
    rdfs:comment "At national borders"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atGrade> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#HeightGradeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "At the normal road grade elevation."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atHighAltitudes> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#AreaPlacesEnum>,
        owl:NamedIndividual ;
    rdfs:comment "At high altitudes"@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atSeaLevelTPEGHeight> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc04HeightTypeEnum>,
        owl:NamedIndividual ;
    rdfs:comment "At service area."@en .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#atStreetLevelTPEGHeight> a <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#TpegLoc04HeightTypeEnum>,
