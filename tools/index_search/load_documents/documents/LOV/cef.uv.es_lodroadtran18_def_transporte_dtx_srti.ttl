    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedDataProperties> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#DirectionEnum> a owl:Class ;
    rdfs:comment "List of directions of travel."@en ;
