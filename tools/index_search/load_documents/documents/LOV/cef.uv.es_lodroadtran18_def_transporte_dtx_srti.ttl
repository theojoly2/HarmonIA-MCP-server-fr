<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geo_WGS84> a owl:DatatypeProperty ;
    rdfs:comment "For organizational purposes. Properties of the WGS84 Geo Positioning by World Wide Web Consortium (W3C). A vocabulary for representing latitude, longitude and altitude information in the WGS84 geodetic reference datum. WGS stands for the World Geodetic Survey."@en ;
    rdfs:subPropertyOf <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#importedDataProperties> .

<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#geo_core> a owl:DatatypeProperty ;
