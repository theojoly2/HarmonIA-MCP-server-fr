@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://purl.org/biodiversity/taxon/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://eunis.eea.europa.eu/rdf/species-schema.rdf#authority> a owl:DatatypeProperty .

<http://eunis.eea.europa.eu/rdf/species-schema.rdf#scientificName> a owl:DatatypeProperty .

<http://lod.taxonconcept.org/ontology/txn.owl#authority> a owl:DatatypeProperty .

<http://lod.taxonconcept.org/ontology/txn.owl#scientificName> a owl:DatatypeProperty .

<http://purl.org/NET/biol/ns#authority> a owl:DatatypeProperty .

<http://purl.org/biodiversity/eol/authority> a owl:DatatypeProperty .

<http://purl.org/biodiversity/eol/scientificName> a owl:DatatypeProperty .

onto: a owl:Ontology ;
    rdfs:label "TaxonMap Ontology"@en ;
    dcterms:creator <http://lod.taxonconcept.org/ontology/people.owl#Peter_J_DeVries> ;
    dcterms:description "Version 0.18 This is the initial vocabulary for Mapping the various taxon classes on the Linked Open Data Cloud"@en ;
    dcterms:issued "2012-05-27" ;
    dcterms:modified "2013-03-18" ;
    dcterms:publisher <http://lod.taxonconcept.org/ontology/txn.owl#TaxonConcept_Knowledge_Base_Project> ;
    dcterms:title "TaxonMap Ontology"@en ;
    vann:preferredNamespacePrefix "taxon" ;
    vann:preferredNamespaceUri "http://purl.org/biodiversity/taxon/" ;
    rdfs:comment "Version 0.18 Added those taxon classes I know about, and data type properties for scientific name and authority"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    owl:versionInfo 0.17 .

onto:Amphibian a owl:Class ;
    rdfs:label "Amphibian" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Tetrapod .

onto:Arachnid a owl:Class ;
    rdfs:label "Arachnid" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Arthropod .

onto:Archaea a owl:Class ;
    rdfs:label "Archaea" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:BiologicalOrganism .

onto:Armoured_fish a owl:Class ;
    rdfs:label "Armoured_fish" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Fish .

onto:Bacteria a owl:Class ;
    rdfs:label "Bacteria" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:BiologicalOrganism .

onto:Bird a owl:Class ;
    rdfs:label "Bird" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Tetrapod .

onto:Cartilaginous_fish a owl:Class ;
    rdfs:label "Cartilaginous Fish" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Fish .

onto:Cephalochordate a owl:Class ;
    rdfs:label "Cephalochordate" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Chordate .

onto:ClubMoss a owl:Class ;
    rdfs:label "ClubMoss" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Plant .

onto:Conifer a owl:Class ;
    rdfs:label "Conifer" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Plant .

onto:Crustacean a owl:Class ;
    rdfs:label "Crustacean" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Arthropod .

onto:Cycad a owl:Class ;
    rdfs:label "Cycad" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Plant .

onto:DataObject a owl:Class ;
    rdfs:label "DataObject"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> .

onto:Dinosauria a owl:Class ;
    rdfs:label "Dinosauria" ;
    rdfs:comment "Dinosaurs" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Tetrapod .

onto:Fern a owl:Class ;
    rdfs:label "Fern" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Plant .

onto:FloweringPlant a owl:Class ;
    rdfs:label "FloweringPlant" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Plant .

onto:Fungus a owl:Class ;
    rdfs:label "Fungus" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Eukaryote .

onto:Ginkgo a owl:Class ;
    rdfs:label "Ginkgo" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Plant .

onto:Gnetophytes a owl:Class ;
    rdfs:label "Gnetophytes" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Plant .

onto:GreenAlga a owl:Class ;
    rdfs:label "GreenAlga" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Plant .

onto:Image a owl:Class ;
    rdfs:label "Image" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf foaf:Image .

onto:Insect a owl:Class ;
    rdfs:label "Insect" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Arthropod .

onto:Jawless_fish a owl:Class ;
    rdfs:label "Jawless fish" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Fish .

onto:Lobe_Finned_fish a owl:Class ;
    rdfs:label "Lobe Finned Fish" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Fish .

onto:Lungfish a owl:Class ;
    rdfs:label "Lungfish" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Fish .

onto:Mammal a owl:Class ;
    rdfs:label "Mammal" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Tetrapod .

onto:MapImage a owl:Class ;
    rdfs:label "MapImage" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf foaf:Image .

onto:Microbial_Eukaryote a owl:Class ;
    rdfs:label "Microbial Eukaryote" ;
    rdfs:comment "a polyphyletic group" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Eukaryote .

onto:ModernReptile a owl:Class ;
    rdfs:label "Modern Reptile" ;
    rdfs:comment "The class of recently extant reptiles including Crocodiles, Turtles, Snakes and Lizards" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Tetrapod .

onto:Mollusca a owl:Class ;
    rdfs:label "Mollusca" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Animal .

onto:Moss a owl:Class ;
    rdfs:label "Moss" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Plant .

onto:Ray_Fined_fish a owl:Class ;
    rdfs:label "Ray Fined Fish" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Fish .

onto:Red_algae a owl:Class ;
    rdfs:label "Red algae" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Eukaryote .

onto:Taxon a owl:Class ;
    rdfs:label "Taxon" ;
    rdfs:comment "A proposed superclass for all the known LOD classes for a \"taxon\"" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:seeAlso <http://bio2rdf.org/uniprot_resource:Taxon>,
        <http://dbpedia.org/ontology/Species>,
        <http://eunis.eea.europa.eu/rdf/species-schema.rdf#SpeciesSynonym>,
        <http://purl.org/NET/biol/ns#Taxonomy>,
        <http://purl.org/biodiversity/eol/Taxon>,
        onto:TaxonConcept,
        <http://purl.org/ontology/wo/Species>,
        <http://purl.uniprot.org/core/Taxon>,
        <http://rdf.freebase.com/ns/biology.organism_classification>,
        <http://rdf.geospecies.org/ont/geospecies#TaxonConcept>,
        <http://rdfdata.eionet.europa.eu/itis/ontology/Taxon>,
        <http://rs.tdwg.org/dwc/terms/Taxon> .

onto:TaxonName a owl:Class ;
    rdfs:label "TaxonName" ;
    rdfs:comment "A proposed superclass for all the known LOD classes a taxon name" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> .

onto:TaxonRank a owl:Class ;
    rdfs:label "TaxonRank" ;
    rdfs:comment "A proposed superclass for all the known LOD classes of a Taxon Rank" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> .

onto:Tunicate a owl:Class ;
    rdfs:label "Tunicate" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Chordate .

onto:Unclassified_Chordate a owl:Class ;
    rdfs:label "Unclassified Chordate" ;
    rdfs:comment "a polyphyletic group" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Chordate .

onto:authority a owl:DatatypeProperty ;
    rdfs:label "authority" ;
    rdfs:comment "The author and year of the species description publication i.e (Baker 1899)" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> .

onto:binomial a owl:DatatypeProperty ;
    rdfs:label "binomial" ;
    rdfs:comment "a scientific name consisting of genus, epithet i.e. Felis silvestris" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subPropertyOf onto:scientificName .

onto:canonicalFormID a owl:ObjectProperty ;
    rdfs:label "canonicalFormID" ;
    rdfs:comment "The URI ID for the canonical form of the name i.e. Puma concolor or Felidae, for name to name mapping" ;
    rdfs:domain onto:TaxonNameID ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range onto:TaxonNameID ;
    rdfs:subPropertyOf onto:relatedTaxonNameID .

onto:canonicalFormID_Of a owl:ObjectProperty ;
    rdfs:label "canonicalFormID Of" ;
    rdfs:comment "The URI ID for the scientific name with authorship form of the name i.e. Puma concolor Linnaeus 1758, for name to name mapping" ;
    rdfs:domain onto:TaxonNameID ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range onto:TaxonNameID ;
    rdfs:subPropertyOf onto:relatedTaxonNameID_Of .

onto:commonName a owl:DatatypeProperty ;
    rdfs:label "commonName" ;
    rdfs:comment "The common name for a taxon i.e. \"Wolf\"" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> .

onto:dbClass a owl:ObjectProperty ;
    rdfs:label "dbClass"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://dbpedia.org/ontology/Species> .

onto:dbFamily a owl:ObjectProperty ;
    rdfs:label "dbFamily"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://dbpedia.org/ontology/Species> .

onto:dbGenus a owl:ObjectProperty ;
    rdfs:label "dbGenus"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://dbpedia.org/ontology/Species> .

onto:dbKingdom a owl:ObjectProperty ;
    rdfs:label "dbKingdom"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://dbpedia.org/ontology/Species> .

onto:dbOrder a owl:ObjectProperty ;
    rdfs:label "dbOrder"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://dbpedia.org/ontology/Species> .

onto:dbPhylum a owl:ObjectProperty ;
    rdfs:label "dbPhylum"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://dbpedia.org/ontology/Species> .

onto:dbSpecies a owl:ObjectProperty ;
    rdfs:label "dbSpecies"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://dbpedia.org/ontology/Species> .

onto:monomial a owl:DatatypeProperty ;
    rdfs:label "monomial" ;
    rdfs:comment "a one word scientific name i.e. Felidae, Mammalia, Metazoa" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subPropertyOf onto:scientificName .

onto:trinomial a owl:DatatypeProperty ;
    rdfs:label "trinomial" ;
    rdfs:comment "a scientific name consisting of genus epithet and subepithet i.e. Felis silvestris lybica" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subPropertyOf onto:scientificName .

onto:uniprotClass a owl:ObjectProperty ;
    rdfs:label "uniprotClass"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://purl.uniprot.org/core/Taxon> .

onto:uniprotFamily a owl:ObjectProperty ;
    rdfs:label "uniprotFamily"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://purl.uniprot.org/core/Taxon> .

onto:uniprotGenus a owl:ObjectProperty ;
    rdfs:label "uniprotGenus"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://purl.uniprot.org/core/Taxon> .

onto:uniprotKingdom a owl:ObjectProperty ;
    rdfs:label "uniprotKingdom"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://purl.uniprot.org/core/Taxon> .

onto:uniprotOrder a owl:ObjectProperty ;
    rdfs:label "uniprotOrder"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://purl.uniprot.org/core/Taxon> .

onto:uniprotPhylum a owl:ObjectProperty ;
    rdfs:label "uniprotPhylum"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://purl.uniprot.org/core/Taxon> .

onto:uniprotSpecies a owl:ObjectProperty ;
    rdfs:label "uniprotSpecies"@en ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range <http://purl.uniprot.org/core/Taxon> .

dcterms:creator a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

<http://purl.uniprot.org/core/scientificName> a owl:DatatypeProperty .

<http://bio2rdf.org/uniprot_resource:Taxon> a owl:Class .

<http://eunis.eea.europa.eu/rdf/species-schema.rdf#SpeciesSynonym> a owl:Class .

<http://lod.taxonconcept.org/ontology/people.owl#Peter_J_DeVries> a foaf:Person .

<http://lod.taxonconcept.org/ontology/txn.owl#TaxonConcept_Knowledge_Base_Project> a foaf:Organization .

<http://purl.org/NET/biol/ns#Taxonomy> a owl:Class .

<http://purl.org/biodiversity/eol/Taxon> a owl:Class .

onto:TaxonConcept a owl:Class .

onto:relatedTaxonNameID a owl:ObjectProperty ;
    rdfs:label "relatedTaxonNameID" ;
    rdfs:comment "The URI to a URI of a related name" ;
    rdfs:domain onto:TaxonNameID ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range onto:TaxonNameID .

onto:relatedTaxonNameID_Of a owl:ObjectProperty ;
    rdfs:label "relatedTaxonNameID_ Of" ;
    rdfs:comment "The URI to a URI of a related name" ;
    rdfs:domain onto:TaxonNameID ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:range onto:TaxonNameID ;
    owl:inverseOf onto:relatedName .

<http://purl.org/ontology/wo/Species> a owl:Class .

<http://rdf.freebase.com/ns/biology.organism_classification> a owl:Class .

<http://rdf.geospecies.org/ont/geospecies#TaxonConcept> a owl:Class .

<http://rdfdata.eionet.europa.eu/itis/ontology/Taxon> a owl:Class .

<http://rs.tdwg.org/dwc/terms/Taxon> a owl:Class .

foaf:Organization a owl:Class .

foaf:Person a owl:Class .

foaf:Image a owl:Class .

onto:Animal a owl:Class ;
    rdfs:label "Animal" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Eukaryote ;
    foaf:page <http://en.wikipedia.org/wiki/Animal>,
        <http://eol.org/pages/1/overview>,
        <http://species.wikimedia.org/wiki/Animalia> .

onto:Arthropod a owl:Class ;
    rdfs:label "Arthropod" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Animal .

onto:BiologicalOrganism a owl:Class ;
    rdfs:label "BiologicalOrganism" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> .

onto:scientificName a owl:DatatypeProperty ;
    rdfs:label "scientificName" ;
    rdfs:comment "The scientific name without the authority string i.e. Felidae or Puma concolor" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> .

onto:Chordate a owl:Class ;
    rdfs:label "Chordate" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Animal .

onto:Eukaryote a owl:Class ;
    rdfs:label "Eukaryote" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:BiologicalOrganism ;
    foaf:page <http://en.wikipedia.org/wiki/Eukaryote>,
        <http://eol.org/pages/2908256/overview>,
        <http://species.wikimedia.org/wiki/Eukaryota>,
        <http://tolweb.org/Eukaryotes/3> .

onto:Tetrapod a owl:Class ;
    rdfs:label "Tetrapod" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Chordate .

onto:Fish a owl:Class ;
    rdfs:label "Fish" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Chordate .

<http://dbpedia.org/ontology/Species> a owl:Class .

onto:TaxonNameID a owl:Class ;
    rdfs:label "TaxonNameID" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> .

<http://purl.uniprot.org/core/Taxon> a owl:Class .

onto:Plant a owl:Class ;
    rdfs:label "Plant",
        "Viridiplantae" ;
    rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl> ;
    rdfs:subClassOf onto:Eukaryote .

