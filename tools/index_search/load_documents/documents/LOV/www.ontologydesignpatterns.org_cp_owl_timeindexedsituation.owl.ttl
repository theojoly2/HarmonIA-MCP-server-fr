@prefix ns1: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix onto: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting> a owl:ObjectProperty ;
    rdfs:label "has time indexed setting"@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation> ;
    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting> ;
    owl:inverseOf <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity> .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#isTimeIndexFor> a owl:ObjectProperty ;
    rdfs:label "is time index for"@en ;
    rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation> ;
    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting> ;
    owl:inverseOf <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime> .

ns1:coversRequirements a owl:AnnotationProperty .

ns1:hasAuthor a owl:AnnotationProperty .

ns1:hasComponent a owl:AnnotationProperty .

ns1:hasConsequences a owl:AnnotationProperty .

ns1:hasIntent a owl:AnnotationProperty .

ns1:hasUnitTest a owl:AnnotationProperty .

ns1:isSpecializationOf a owl:AnnotationProperty .

ns1:relatedCPs a owl:AnnotationProperty .

ns1:scenarios a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> a owl:Class .

<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting> a owl:ObjectProperty .

<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor> a owl:ObjectProperty .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime> a owl:ObjectProperty ;
    rdfs:label "at time"@en ;
    rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval> ;
    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor> .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity> a owl:ObjectProperty ;
    rdfs:label "for entity"@en ;
    rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor> .

<http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval> a owl:Class .

owl:Thing a owl:Class .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation> a owl:Class ;
    rdfs:label "Time indexed situation"@en ;
    rdfs:comment "A Situation that is explicitly indexed at some time for at least one entity." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity> ],
        <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> .

onto: a owl:Ontology ;
    ns1:coversRequirements "At what time did a certain situation occur?,What situations occurred at a certain time?"^^rdf:PlainLiteral ;
    ns1:hasAuthor "Aldo Gangemi"^^rdf:PlainLiteral ;
    ns1:hasComponent "TimeInterval"^^rdf:PlainLiteral ;
    ns1:hasConsequences "We can represent situations that have an explicit time parameter.\\nIn principle, this can be done already with the Situation pattern, but this provides a handy composition with the TimeInterval pattern."^^rdf:PlainLiteral ;
    ns1:hasIntent "To represent time indexed situations."^^rdf:PlainLiteral ;
    ns1:hasUnitTest "SELECT ?x ?e ?t\\nWHERE {\\n?x :forEntity ?e .\\n?x :atTime ?t }"^^rdf:PlainLiteral ;
    ns1:isSpecializationOf "Situation"^^rdf:PlainLiteral ;
    ns1:relatedCPs "Time indexed participation,TimeIndexedClassification"^^rdf:PlainLiteral ;
    ns1:scenarios "Mustafa's address in 2005 was in Brussels"^^rdf:PlainLiteral ;
    rdfs:comment "A generic pattern usable for all situations that require a temporal indexing."^^rdf:PlainLiteral ;
    owl:imports <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl>,
        <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
    owl:versionInfo "1.0\\n- Revised, and added annotations for ODP publishing\\n0.1\\n- Created by Aldo Gangemi"^^xsd:string,
        "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

