<http://premon.fbk.eu/ontology/vn#natural_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "natural" ;
    skos:broader <http://premon.fbk.eu/ontology/vn#concrete_rrp> .

<http://premon.fbk.eu/ontology/vn#source> a <http://premon.fbk.eu/ontology/vn#ThematicRole>,
        owl:NamedIndividual ;
    rdfs:label "source"@en ;
    skos:broader <http://premon.fbk.eu/ontology/vn#place> .

<http://premon.fbk.eu/ontology/vn#value> a <http://premon.fbk.eu/ontology/vn#ThematicRole>,
        owl:NamedIndividual ;
    rdfs:label "value"@en ;
    skos:broader <http://premon.fbk.eu/ontology/vn#place> .

<http://premon.fbk.eu/ontology/vn#AtomicRestriction> a owl:Class ;
    rdfs:label "Atomic Restriction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#valueObj> ],
        <http://premon.fbk.eu/ontology/vn#Restriction> ;
    owl:disjointUnionOf ( <http://premon.fbk.eu/ontology/vn#AbsentAtomicRestriction> <http://premon.fbk.eu/ontology/vn#ExistAtomicRestriction> ) .

<http://premon.fbk.eu/ontology/vn#CompoundRestriction> a owl:Class ;
    rdfs:label "Compound Restriction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#item> ;
            owl:someValuesFrom owl:Thing ],
        <http://premon.fbk.eu/ontology/vn#Restriction> ;
    owl:disjointUnionOf ( <http://premon.fbk.eu/ontology/vn#AndCompoundRestriction> <http://premon.fbk.eu/ontology/vn#OrCompoundRestriction> ) .

<http://premon.fbk.eu/ontology/vn#PrepositionSelectionalRestriction> a owl:Class ;
    rdfs:label "Preposition Selectional Restriction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#PrepositionRestrictionProperty> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#valueObj> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#PrepositionSelectionalRestriction> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#item> ],
        <http://premon.fbk.eu/ontology/vn#SelectionalRestriction> .

<http://premon.fbk.eu/ontology/vn#RoleSelectionalRestriction> a owl:Class ;
    rdfs:label "Role Selectional Restriction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#RoleSelectionalRestriction> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#item> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#valueObj> ],
        <http://premon.fbk.eu/ontology/vn#SelectionalRestriction> .

<http://premon.fbk.eu/ontology/vn#SelectionalRestrictionProperty> a owl:Class ;
    rdfs:label "Selectional Restriction Property"@en ;
    rdfs:subClassOf <http://premon.fbk.eu/ontology/vn#RestrictionProperty> ;
    owl:disjointUnionOf ( <http://premon.fbk.eu/ontology/vn#PrepositionRestrictionProperty> <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty> ) .

<http://premon.fbk.eu/ontology/vn#SyntacticRestriction> a owl:Class ;
    rdfs:label "Syntactic Restriction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#SyntacticRestriction> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#item> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#SyntacticRestrictionProperty> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#valueObj> ],
        <http://premon.fbk.eu/ontology/vn#Restriction> .

<http://premon.fbk.eu/ontology/vn#actor> a <http://premon.fbk.eu/ontology/vn#ThematicRole>,
        owl:NamedIndividual ;
    rdfs:label "actor"@en ;
    rdfs:comment "abstract, non instantiated in the dataset"@en ;
    skos:broader <http://premon.fbk.eu/ontology/vn#participant> .

<http://premon.fbk.eu/ontology/vn#machine_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "machine" ;
    skos:broader <http://premon.fbk.eu/ontology/vn#artifact_rrp>,
        <http://premon.fbk.eu/ontology/vn#int_control_rrp> ;
    skos:related <http://premon.fbk.eu/ontology/vn#int_control_rrp> .

<http://premon.fbk.eu/ontology/vn#patient> a <http://premon.fbk.eu/ontology/vn#ThematicRole>,
        owl:NamedIndividual ;
    rdfs:label "patient"@en ;
    skos:broader <http://premon.fbk.eu/ontology/vn#undergoer> .

<http://premon.fbk.eu/ontology/vn#phys_obj_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "physical object" ;
    rdfs:comment "Non in the data" ;
    skos:broader <http://premon.fbk.eu/ontology/vn#concrete_rrp> .

<http://premon.fbk.eu/ontology/vn#shape_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "shape" ;
    rdfs:comment "Non in the data" ;
    skos:broader <http://premon.fbk.eu/ontology/vn#concrete_rrp> .

<http://premon.fbk.eu/ontology/vn#solid_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "solid" ;
    rdfs:comment "Non in the data" ;
    skos:broader <http://premon.fbk.eu/ontology/vn#concrete_rrp> .

<http://premon.fbk.eu/ontology/vn#SelectionalRestriction> a owl:Class ;
    rdfs:label "Selectional Restriction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#SelectionalRestriction> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#item> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#SelectionalRestrictionProperty> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#valueObj> ],
        <http://premon.fbk.eu/ontology/vn#Restriction> ;
    owl:disjointUnionOf ( <http://premon.fbk.eu/ontology/vn#PrepositionSelectionalRestriction> <http://premon.fbk.eu/ontology/vn#RoleSelectionalRestriction> ) .

<http://premon.fbk.eu/ontology/vn#abstract_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "abstract" .

<http://premon.fbk.eu/ontology/vn#artifact_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "artifact" ;
    rdfs:comment "Non in the data" ;
    skos:broader <http://premon.fbk.eu/ontology/vn#phys_obj_rrp> .

<http://premon.fbk.eu/ontology/vn#place> a <http://premon.fbk.eu/ontology/vn#ThematicRole>,
        owl:NamedIndividual ;
    rdfs:label "place"@en ;
    rdfs:comment "abstract, non instantiated in the dataset"@en ;
    skos:broader <http://premon.fbk.eu/ontology/vn#participant> .

<http://premon.fbk.eu/ontology/vn#time> a <http://premon.fbk.eu/ontology/vn#ThematicRole>,
        owl:NamedIndividual ;
    rdfs:label "time"@en ;
    skos:broader <http://premon.fbk.eu/ontology/vn#participant> .

<http://premon.fbk.eu/ontology/vn#AuxnpType> a owl:Class ;
    rdfs:label "Auxiliary NP Type"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://premon.fbk.eu/ontology/vn#oblique_auxnpType> <http://premon.fbk.eu/ontology/vn#oblique2_auxnpType> <http://premon.fbk.eu/ontology/vn#oblique1_auxnpType> <http://premon.fbk.eu/ontology/vn#np_auxnpType> ) ] .

<http://premon.fbk.eu/ontology/vn#EventPredArgType> a owl:Class ;
    rdfs:label "Event Predicate Argument Type"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://premon.fbk.eu/ontology/vn#startEventArg> <http://premon.fbk.eu/ontology/vn#resultEventArg> <http://premon.fbk.eu/ontology/vn#endEventArg> <http://premon.fbk.eu/ontology/vn#duringEventArg> ) ] .

<http://premon.fbk.eu/ontology/vn#Restriction> a owl:Class ;
    rdfs:label "Restriction"@en ;
    owl:disjointUnionOf ( <http://premon.fbk.eu/ontology/vn#AtomicRestriction> <http://premon.fbk.eu/ontology/vn#CompoundRestriction> ),
        ( <http://premon.fbk.eu/ontology/vn#SelectionalRestriction> <http://premon.fbk.eu/ontology/vn#SyntacticRestriction> ) .

<http://premon.fbk.eu/ontology/vn#VerbClass> a owl:Class ;
    rdfs:label "Verb Class (VN)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#SemanticRole> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#semRole> ],
        <http://premon.fbk.eu/ontology/core#SemanticClass> .

<http://premon.fbk.eu/ontology/vn#animate_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "animate" ;
    skos:broader <http://premon.fbk.eu/ontology/vn#natural_rrp> ;
    skos:related <http://premon.fbk.eu/ontology/vn#int_control_rrp> .

<http://premon.fbk.eu/ontology/vn#int_control_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "int_control" ;
    skos:broader <http://premon.fbk.eu/ontology/vn#concrete_rrp> ;
    skos:related <http://premon.fbk.eu/ontology/vn#animate_rrp>,
        <http://premon.fbk.eu/ontology/vn#machine_rrp> .

<http://premon.fbk.eu/ontology/vn#restriction> a owl:ObjectProperty ;
    rdfs:label "restriction"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://premon.fbk.eu/ontology/vn#NpSynItem> <http://premon.fbk.eu/ontology/vn#PrepSynItem> <http://premon.fbk.eu/ontology/vn#SemanticRole> ) ] ;
    rdfs:range <http://premon.fbk.eu/ontology/vn#Restriction> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://premon.fbk.eu/ontology/vn#SemanticRole> a owl:Class ;
    rdfs:label "Semantic Role (VN)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://premon.fbk.eu/ontology/vn#thematicRole> ;
            owl:someValuesFrom <http://premon.fbk.eu/ontology/vn#ThematicRole> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty> ;
            owl:onProperty <http://premon.fbk.eu/ontology/vn#restriction> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#VerbClass> ;
            owl:onProperty [ owl:inverseOf <http://premon.fbk.eu/ontology/core#semRole> ] ],
        <http://premon.fbk.eu/ontology/core#SemanticRole> .

<http://premon.fbk.eu/ontology/vn#VerbNetFrame> a owl:Class ;
    rdfs:label "Syntactic Frame (VN)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://premon.fbk.eu/ontology/vn#SynItem> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#first> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://premon.fbk.eu/ontology/vn#VerbSynItem> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#item> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://premon.fbk.eu/ontology/vn#Pred> <http://premon.fbk.eu/ontology/vn#SynItem> ) ] ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#item> ] .

<http://premon.fbk.eu/ontology/vn#concrete_rrp> a <http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty>,
        owl:NamedIndividual ;
    rdfs:label "concrete" .

<http://premon.fbk.eu/ontology/vn#participant> a <http://premon.fbk.eu/ontology/vn#ThematicRole>,
        owl:NamedIndividual ;
    rdfs:label "participant"@en ;
    rdfs:comment "abstract, non instantiated in the dataset."@en .

<http://premon.fbk.eu/ontology/vn#PredArg> a owl:Class ;
    rdfs:label "Predicate Argument"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#valueDt> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#valueDt> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#PredArg> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#next> ] ;
    owl:disjointUnionOf ( <http://premon.fbk.eu/ontology/vn#ConstantPredArg> <http://premon.fbk.eu/ontology/vn#EventPredArg> <http://premon.fbk.eu/ontology/vn#ThemRolePredArg> <http://premon.fbk.eu/ontology/vn#VerbSpecificPredArg> ) .

<http://premon.fbk.eu/ontology/vn#undergoer> a <http://premon.fbk.eu/ontology/vn#ThematicRole>,
        owl:NamedIndividual ;
    rdfs:label "undergoer"@en ;
    rdfs:comment "abstract, non instantiated in the dataset"@en ;
    skos:broader <http://premon.fbk.eu/ontology/vn#participant> .

<http://premon.fbk.eu/ontology/vn#SynItem> a owl:Class ;
    rdfs:label "Syntactic Item"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://premon.fbk.eu/ontology/vn#SynItem> ;
            owl:onProperty <http://premon.fbk.eu/ontology/core#next> ] ;
    owl:disjointUnionOf ( <http://premon.fbk.eu/ontology/vn#AdjSynItem> <http://premon.fbk.eu/ontology/vn#AdvSynItem> <http://premon.fbk.eu/ontology/vn#LexSynItem> <http://premon.fbk.eu/ontology/vn#NpSynItem> <http://premon.fbk.eu/ontology/vn#PrepSynItem> <http://premon.fbk.eu/ontology/vn#VerbSynItem> ) .

<http://premon.fbk.eu/ontology/vn#PrepositionRestrictionProperty> a owl:Class ;
    rdfs:label "Preposition Selectional Restriction Property"@en ;
    rdfs:subClassOf <http://premon.fbk.eu/ontology/vn#SelectionalRestrictionProperty> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://premon.fbk.eu/ontology/vn#dest_prp> <http://premon.fbk.eu/ontology/vn#path_prp> <http://premon.fbk.eu/ontology/vn#dir_prp> <http://premon.fbk.eu/ontology/vn#loc_prp> <http://premon.fbk.eu/ontology/vn#spatial_prp> <http://premon.fbk.eu/ontology/vn#plural_prp> <http://premon.fbk.eu/ontology/vn#src_prp> <http://premon.fbk.eu/ontology/vn#dest_dir_prp> <http://premon.fbk.eu/ontology/vn#dest_conf_prp> ) ] .

<http://premon.fbk.eu/ontology/vn#RoleRestrictionProperty> a owl:Class ;
    rdfs:label "Role Selectional Restriction Property"@en ;
    rdfs:subClassOf <http://premon.fbk.eu/ontology/vn#SelectionalRestrictionProperty> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://premon.fbk.eu/ontology/vn#machine_rrp> <http://premon.fbk.eu/ontology/vn#pointy_rrp> <http://premon.fbk.eu/ontology/vn#animate_rrp> <http://premon.fbk.eu/ontology/vn#comestible_rrp> <http://premon.fbk.eu/ontology/vn#scalar_rrp> <http://premon.fbk.eu/ontology/vn#shape_rrp> <http://premon.fbk.eu/ontology/vn#region_rrp> <http://premon.fbk.eu/ontology/vn#communication_rrp> <http://premon.fbk.eu/ontology/vn#plant_rrp> <http://premon.fbk.eu/ontology/vn#body_part_rrp> <http://premon.fbk.eu/ontology/vn#nonrigid_rrp> <http://premon.fbk.eu/ontology/vn#human_rrp> <http://premon.fbk.eu/ontology/vn#int_control_rrp> <http://premon.fbk.eu/ontology/vn#substance_rrp> <http://premon.fbk.eu/ontology/vn#organization_rrp> <http://premon.fbk.eu/ontology/vn#concrete_rrp> <http://premon.fbk.eu/ontology/vn#biotic_rrp> <http://premon.fbk.eu/ontology/vn#tool_rrp> <http://premon.fbk.eu/ontology/vn#rigid_rrp> <http://premon.fbk.eu/ontology/vn#sound_rrp> <http://premon.fbk.eu/ontology/vn#vehicle_rrp> <http://premon.fbk.eu/ontology/vn#solid_rrp> <http://premon.fbk.eu/ontology/vn#artifact_rrp> <http://premon.fbk.eu/ontology/vn#force_rrp> <http://premon.fbk.eu/ontology/vn#location_rrp> <http://premon.fbk.eu/ontology/vn#time_rrp> <http://premon.fbk.eu/ontology/vn#animal_rrp> <http://premon.fbk.eu/ontology/vn#elongated_rrp> <http://premon.fbk.eu/ontology/vn#phys_obj_rrp> <http://premon.fbk.eu/ontology/vn#abstract_rrp> <http://premon.fbk.eu/ontology/vn#state_rrp> <http://premon.fbk.eu/ontology/vn#currency_rrp> <http://premon.fbk.eu/ontology/vn#garment_rrp> <http://premon.fbk.eu/ontology/vn#refl_rrp> ) ] .

<http://premon.fbk.eu/ontology/vn#ThematicRole> a owl:Class ;
    rdfs:label "Thematic Role (VN)"@en ;
    rdfs:subClassOf skos:Concept .

<http://premon.fbk.eu/ontology/vn#SyntacticRestrictionProperty> a owl:Class ;
    rdfs:label "Syntactic Restriction Property" ;
    rdfs:subClassOf <http://premon.fbk.eu/ontology/vn#RestrictionProperty> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://premon.fbk.eu/ontology/vn#adv_loc_syrp> <http://premon.fbk.eu/ontology/vn#np_omit_ing_syrp> <http://premon.fbk.eu/ontology/vn#tensed_that_syrp> <http://premon.fbk.eu/ontology/vn#np_ing_syrp> <http://premon.fbk.eu/ontology/vn#oc_ing_syrp> <http://premon.fbk.eu/ontology/vn#sc_to_inf_syrp> <http://premon.fbk.eu/ontology/vn#vc_to_inf_syrp> <http://premon.fbk.eu/ontology/vn#small_clause_syrp> <http://premon.fbk.eu/ontology/vn#genitive_syrp> <http://premon.fbk.eu/ontology/vn#wheth_inf_syrp> <http://premon.fbk.eu/ontology/vn#oc_to_inf_syrp> <http://premon.fbk.eu/ontology/vn#what_extract_syrp> <http://premon.fbk.eu/ontology/vn#oc_bare_inf_syrp> <http://premon.fbk.eu/ontology/vn#np_p_ing_syrp> <http://premon.fbk.eu/ontology/vn#wh_ing_syrp> <http://premon.fbk.eu/ontology/vn#how_extract_syrp> <http://premon.fbk.eu/ontology/vn#to_be_syrp> <http://premon.fbk.eu/ontology/vn#wh_extract_syrp> <http://premon.fbk.eu/ontology/vn#what_inf_syrp> <http://premon.fbk.eu/ontology/vn#np_ppart_syrp> <http://premon.fbk.eu/ontology/vn#that_comp_syrp> <http://premon.fbk.eu/ontology/vn#ac_ing_syrp> <http://premon.fbk.eu/ontology/vn#plural_syrp> <http://premon.fbk.eu/ontology/vn#quotation_syrp> <http://premon.fbk.eu/ontology/vn#wh_comp_syrp> <http://premon.fbk.eu/ontology/vn#np_to_inf_syrp> <http://premon.fbk.eu/ontology/vn#acc_ing_syrp> <http://premon.fbk.eu/ontology/vn#rs_to_inf_syrp> <http://premon.fbk.eu/ontology/vn#np_tobe_syrp> <http://premon.fbk.eu/ontology/vn#for_comp_syrp> <http://premon.fbk.eu/ontology/vn#wh_inf_syrp> <http://premon.fbk.eu/ontology/vn#be_sc_ing_syrp> <http://premon.fbk.eu/ontology/vn#sentential_syrp> <http://premon.fbk.eu/ontology/vn#definite_syrp> <http://premon.fbk.eu/ontology/vn#poss_ing_syrp> <http://premon.fbk.eu/ontology/vn#sc_ing_syrp> <http://premon.fbk.eu/ontology/vn#ac_to_inf_syrp> <http://premon.fbk.eu/ontology/vn#body_part_syrp> <http://premon.fbk.eu/ontology/vn#refl_syrp> ) ] .

