@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <https://w3id.org/vocab/olca#> .
@prefix ns2: <http://lexvo.org/ontology#> .
@prefix onto: <https://w3id.org/vocab/lingvoj> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "The Lingvoj Ontology"@en,
        "Ontologie des langues"@fr ;
    dcterms:contributor [ foaf:homepage <http://www.asahi-net.or.jp/~ax2s-kmtn/> ;
            foaf:name "Shuji Kamitsuna" ],
        <http://google.com/+MaríaPovedaVillalón>,
        <http://google.com/+RonaldPoell>,
        <https://plus.google.com/113072078430654119300>,
        <https://w3id.org/people/gatemezing> ;
    dcterms:creator <http://google.com/+BernardVatant> ;
    dcterms:issued "2007-09-17" ;
    dcterms:language <http://lexvo.org/id/iso639-3/eng>,
        <http://lexvo.org/id/iso639-3/fra>,
        <http://lexvo.org/id/iso639-3/jap>,
        <http://lexvo.org/id/iso639-3/nld>,
        <http://lexvo.org/id/iso639-3/spa>,
        <http://www.lexvo.org/id/iso639-3/por> ;
    dcterms:modified "2014-08-11",
        "2020-05-31" ;
    dcterms:title "The Lingvoj Ontology"@en,
        "Ontologie des langues"@fr ;
    vann:preferredNamespacePrefix "lingvo" ;
    vann:preferredNamespaceUri "https://w3id.org/vocab/lingvoj#" ;
    rdfs:comment "A vocabulary for describing the use of languages by people and organizations, their geographical scope and status as well as their usage in documents or during events"@en,
        "Un vocabulaire pour décrire l'utilisation des langues par les personnes et les organisations, leur répartition géographique et leur statut, ainsi que leur usage dans les documents ou lors des événements"@fr ;
    rdfs:seeAlso <http://lingvoj.linkedvocabs.org/> ;
    owl:incompatibleWith onto:_v1.3.rdf ;
    owl:priorVersion onto:_v2.33.ttl ;
    owl:versionIRI onto:_v3.0.ttl ;
    owl:versionInfo "v3.0" ;
    skos:historyNote "v2.1 : Relaxed domain constraints on several properties, replaced by Ontology Loose Coupling Annotations",
        "v2.2 : Added spanish translations, provided by María Poveda Villalón",
        "v2.21 : Added dutch translations plus 'interpreter' property suggested by Ronald Poell, along with minor corrections",
        "v2.3 : Added :LanguageResource class, subclasses and properties. Added properties :tag :officialIn :fromCountry",
        "v2.31 : Added more translations, language metadata, fixed typos plus cosmetic changes in the .ttl file",
        "v2.32 : Added japanese translations, provided by Shuji Kamitsuna",
        "v2.33 : Corrected minor typos, and added portuguese translations, provided by Mariana Curado Malta",
        "v3.0 : Added new content negotiation to w3id since the previous website is off" .

<https://w3id.org/vocab/lingvoj#endangeredLanguage> a owl:DatatypeProperty ;
    rdfs:label "endangered language"@en,
        "langue menacée"@fr ;
    rdfs:comment "The language is endangered at the given date"@en,
        "La langue est menacée à la date indiquée"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Lingvo> ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf <https://w3id.org/vocab/lingvoj#livingLanguage> .

<https://w3id.org/vocab/lingvoj#extinctLanguage> a owl:DatatypeProperty ;
    rdfs:label "extinct language"@en,
        "langue morte"@fr ;
    rdfs:comment "The language has no longer any speaker at the given date"@en,
        "La langue n'a plus de locuteurs à la date indiquée"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Lingvo> ;
    rdfs:range xsd:date .

<https://w3id.org/vocab/lingvoj#fromCountry> a owl:ObjectProperty ;
    rdfs:label "from country"@en,
        "pays d'origine"@fr ;
    rdfs:comment "Country of origin of the language"@en,
        "Pays d'origine de la langue"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Lingvo> ;
    rdfs:range <http://schema.org/Country> .

<https://w3id.org/vocab/lingvoj#hasAbility5> rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#historicalLanguage> a owl:ObjectProperty ;
    rdfs:label "historical language"@en,
        "langue historique"@fr ;
    rdfs:comment "A language spoken in the past in this place, but not used anymore"@en,
        "Une langue parlée dans le passé dans ce lieu, mais plus utilisée aujourd'hui"@fr ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> ;
    ns1:domainIncludes <http://schema.org/Place> .

<https://w3id.org/vocab/lingvoj#interpreter> a owl:ObjectProperty ;
    rdfs:label "interpreter"@en,
        "interprète"@fr ;
    rdfs:comment "An agent (person or software) responsible of a real-time oral translation"@en,
        "Un agent (personne ou logiciel) responsable de la traduction orale en temps réel"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Translation> ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf <https://w3id.org/vocab/lingvoj#translator> .

<https://w3id.org/vocab/lingvoj#iso1> dcterms:isReplacedBy ns2:iso639P1Code ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#iso2b> dcterms:isReplacedBy ns2:iso639P2BCode ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#iso2t> dcterms:isReplacedBy ns2:iso639P2TCode ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#iso3> dcterms:isReplacedBy ns2:iso639P3Code ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#mainLanguage> a owl:ObjectProperty ;
    rdfs:label "main language"@en,
        "langue principale"@fr ;
    rdfs:comment "The main language used in the place or language resource "@en,
        "La langue principale utilisée dans le lieu ou la ressource linguistique"@fr ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> ;
    ns1:domainIncludes <http://schema.org/Place>,
        <https://w3id.org/vocab/lingvoj#LanguageResource> .

<https://w3id.org/vocab/lingvoj#minorityLanguage> a owl:ObjectProperty ;
    rdfs:label "minority language"@en,
        "langue minoritaire"@fr ;
    rdfs:comment "A language spoken by a minority in some country, but not necessarily in a specific region"@en,
        "Une langue parlée par une minorité dans un pays, mais pas nécessairement dans une région spécifique"@fr ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> ;
    ns1:domainIncludes <http://schema.org/Country> .

<https://w3id.org/vocab/lingvoj#notRead> a owl:ObjectProperty ;
    rdfs:label "not read"@en,
        "non lue"@fr ;
    rdfs:comment "The person does not read at all the language"@en,
        "La personne ne lit pas du tout la langue"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#notSpoken> a owl:ObjectProperty ;
    rdfs:label "not spoken"@en,
        "non parlée"@fr ;
    rdfs:comment "The person does not speak at all the language"@en,
        "La personne ne parle pas du tout la langue"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#notUnderstood> a owl:ObjectProperty ;
    rdfs:label "not understood"@en,
        "non comprise"@fr ;
    rdfs:comment "The person does not understand at all the spoken language"@en,
        "La personne ne comprend pas du tout la langue parlée"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#notWritten> a owl:ObjectProperty ;
    rdfs:label "not written"@en,
        "non écrite"@fr ;
    rdfs:comment "The person does not write at all the language"@en,
        "La personne n'écrit pas du tout la langue"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#originalLanguage> a owl:ObjectProperty ;
    rdfs:label "original language"@en,
        "langue d'origine"@fr ;
    rdfs:comment "The language of the original ressource"@en,
        "La langue de la ressource originale"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Translation> ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#originalTitle> rdfs:comment "The original title is a property of the original resource (use dcterms:title) and not a property of the Translation itself"@en,
        "Le titre original est une propriété de la ressource originale (utiliser dcterms:title) et non une propriété de la Traduction elle-même"@fr ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#original_resource> dcterms:isReplacedBy <https://w3id.org/vocab/lingvoj#originalResource> ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#regionalLanguage> a owl:ObjectProperty ;
    rdfs:label "regional language"@en,
        "langue régionale"@fr ;
    rdfs:comment "A language spoken in a region of a country"@en,
        "Une langue parlée dans une région d'un pays"@fr ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> ;
    ns1:domainIncludes <http://schema.org/Country> .

<https://w3id.org/vocab/lingvoj#resourceType> a owl:ObjectProperty ;
    rdfs:label "resource type"@en,
        "type de ressource"@fr ;
    rdfs:comment "A concept defining the type of the language resource"@en,
        "Un concept définissant le type de la ressource linguistique"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#LanguageResource> ;
    rdfs:range skos:Concept .

<https://w3id.org/vocab/lingvoj#spokenLanguage> a owl:ObjectProperty ;
    rdfs:label "spoken language"@en,
        "langue parlée"@fr ;
    rdfs:comment "A language which is spoken in some place or event"@en,
        "Une langue parlée dans un lieu ou lors d'un événement"@fr ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> ;
    ns1:domainIncludes <http://linkedevents.org/ontology/Event>,
        <http://schema.org/Place>,
        foaf:Organization,
        foaf:Project .

<https://w3id.org/vocab/lingvoj#supportingResource> a owl:ObjectProperty ;
    rdfs:label "support resource"@en,
        "ressource support"@fr ;
    rdfs:comment "A language resource for this language"@en,
        "Une ressource linguistique pour cette langue"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Lingvo> ;
    rdfs:range <https://w3id.org/vocab/lingvoj#LanguageResource> ;
    owl:inverseOf <https://w3id.org/vocab/lingvoj#supportedLanguage> .

<https://w3id.org/vocab/lingvoj#tag> a owl:DatatypeProperty ;
    rdfs:label "language tag"@en,
        "tag de langue"@fr ;
    rdfs:comment "The tag to use for the language, for example as value of xml:lang. See https://tools.ietf.org/html/bcp47"@en,
        "Le tag à utiliser pour la langue, par exemple comme valeur de xml:lang. Voir https://tools.ietf.org/html/bcp47"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Lingvo> ;
    rdfs:subPropertyOf dcterms:identifier .

<https://w3id.org/vocab/lingvoj#targetLanguage> a owl:ObjectProperty ;
    rdfs:label "target language"@en,
        "langue cible"@fr ;
    rdfs:comment "The language of the translated ressource"@en,
        "La langue de la ressource traduite"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Translation> ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#translatedResource> a owl:ObjectProperty ;
    rdfs:label "translated resource"@en,
        "ressource traduite"@fr ;
    rdfs:comment "The resource which is the result of the translation"@en,
        "La ressource qui est le résultat de la traduction"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Translation> .

<https://w3id.org/vocab/lingvoj#translatedTitle> rdfs:comment "The translated title is a property of the translated resource (use dcterms:title) and not a property of the Translation itself"@en,
        "Le titre traduit est une propriété de la ressource traduite (utiliser dcterms:title) et non une propriété de la Traduction elle-même"@fr ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#advancedReading> a owl:ObjectProperty ;
    rdfs:label "advanced reading"@en,
        "bon niveau de lecture"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility3> ;
    rdfs:comment "The person can read the language at an advanced level"@en,
        "La personne lit la langue à un bon niveau"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#advancedSpeaking> a owl:ObjectProperty ;
    rdfs:label "advanced speaking"@en,
        "bonne expression"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility3> ;
    rdfs:comment "The person can speak the language at an advanced level"@en,
        "La personne parle la langue à un bon niveau"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#advancedUnderstanding> a owl:ObjectProperty ;
    rdfs:label "advanced understanding"@en,
        "bonne compréhension"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility3> ;
    rdfs:comment "The person has an advanced understanding of the spoken language"@en,
        "La personne a une bonne compréhension de la langue parlée"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#advancedWriting> a owl:ObjectProperty ;
    rdfs:label "advanced writing"@en,
        "bon niveau d'écriture"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility3> ;
    rdfs:comment "The person can write the language at an advanced level"@en,
        "La personne écrit la langue à un bon niveau"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#basicReading> a owl:ObjectProperty ;
    rdfs:label "basic reading"@en,
        "lecture élémentaire"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility1> ;
    rdfs:comment "The person can read the language at a basic level"@en,
        "La personne lit la langue à un niveau élémentaire"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#basicSpeaking> a owl:ObjectProperty ;
    rdfs:label "basic speaking"@en,
        "expression élémentaire"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility1> ;
    rdfs:comment "The person can speak the language at a basic level"@en,
        "La personne parle la langue à un niveau élémentaire"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#basicUnderstanding> a owl:ObjectProperty ;
    rdfs:label "basic understanding"@en,
        "compréhension élémentaire"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility1> ;
    rdfs:comment "The person has a basic understanding of the spoken language"@en,
        "La personne a une compréhension élémentaire de la langue parlée"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#basicWriting> a owl:ObjectProperty ;
    rdfs:label "basic writing"@en,
        "écriture élémentaire"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility1> ;
    rdfs:comment "The person can write the language at a basic level"@en,
        "La personne écrit la langue à un niveau élémentaire"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#communicationLanguage> a owl:ObjectProperty ;
    rdfs:label "communication language"@en,
        "langue de communication"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasCommunicationLanguage> ;
    rdfs:comment "A language used for external communication"@en,
        "Une langue utilisée pour la communication externe"@fr ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> ;
    ns1:domainIncludes foaf:Organization,
        foaf:Project .

<https://w3id.org/vocab/lingvoj#expertReading> a owl:ObjectProperty ;
    rdfs:label "expert reading"@en,
        "excellente lecture"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility4> ;
    rdfs:comment "The person can read the language at a expert level"@en,
        "La personne lit la langue à un niveau excellent"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#expertSpeaking> a owl:ObjectProperty ;
    rdfs:label "expert speaking"@en,
        "excellente expression"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility4> ;
    rdfs:comment "The person can speak the language at an expert level"@en,
        "La personne parle la langue à niveau excellent"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#expertUnderstanding> a owl:ObjectProperty ;
    rdfs:label "expert understanding"@en,
        "excellente compréhension"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility4> ;
    rdfs:comment "The person has an expert understanding of the spoken language"@en,
        "La personne a une excellente compréhension de la langue parlée"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#expertWriting> a owl:ObjectProperty ;
    rdfs:label "expert writing"@en,
        "excellente écriture"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility4> ;
    rdfs:comment "The person can write the language at an expert level"@en,
        "La personne écrit la langue à un niveau excellent"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#hasCommunicationLanguage> dcterms:isReplacedBy <https://w3id.org/vocab/lingvoj#communicationLanguage> ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#hasNativeLanguage> dcterms:isReplacedBy <https://w3id.org/vocab/lingvoj#nativeLanguage> ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#hasWorkingLanguage> dcterms:isReplacedBy <https://w3id.org/vocab/lingvoj#workingLanguage> ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#intermediateReading> a owl:ObjectProperty ;
    rdfs:label "intermediate reading"@en,
        "lecture moyenne"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility2> ;
    rdfs:comment "The person can read the language at a intermediate level"@en,
        "La personne lit la langue à un niveau moyen"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#intermediateSpeaking> a owl:ObjectProperty ;
    rdfs:label "intermediate speaking"@en,
        "expression moyenne"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility2> ;
    rdfs:comment "The person can speak the language at an intermediate level"@en,
        "La personne parle la langue à un niveau moyen"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#intermediateUnderstanding> a owl:ObjectProperty ;
    rdfs:label "intermediate understanding"@en,
        "compréhension moyenne"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility2> ;
    rdfs:comment "The person has an intermediate understanding of the spoken language"@en,
        "La personne a une compréhension moyenne de la langue parlée"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#intermediateWriting> a owl:ObjectProperty ;
    rdfs:label "intermediate writing"@en,
        "écriture moyenne"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasAbility2> ;
    rdfs:comment "The person can write the language at an intermediate level"@en,
        "La personne écrit la langue à un niveau moyen"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#livingLanguage> a owl:DatatypeProperty ;
    rdfs:label "living language"@en,
        "langue vivante"@fr ;
    rdfs:comment "The language has speakers at the given date"@en,
        "La langue possède des locuteurs à la date indiquée"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Lingvo> ;
    rdfs:range xsd:date .

<https://w3id.org/vocab/lingvoj#nativeLanguage> a owl:ObjectProperty ;
    rdfs:label "native language"@en,
        "langue maternelle"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasNativeLanguage> ;
    rdfs:comment "This property is independent of the level of fluency, reading or writing ability"@en,
        "Cette propriété est indépendante du niveau de langue parlée, lue ou écrite"@fr ;
    rdfs:domain foaf:Person ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#officialIn> a owl:ObjectProperty ;
    rdfs:label "official language of"@en,
        "langue officielle de"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Lingvo> ;
    owl:inverseOf <https://w3id.org/vocab/lingvoj#officialLanguage> ;
    ns1:rangeIncludes <http://linkedevents.org/ontology/Event>,
        <http://schema.org/Place>,
        foaf:Organization,
        foaf:Project .

<https://w3id.org/vocab/lingvoj#officialLanguage> a owl:ObjectProperty ;
    rdfs:label "official language"@en,
        "langue officielle"@fr ;
    rdfs:comment "An official language of a country, project, organization or event"@en,
        "Une langue officielle d'un pays, d'une organisation, d'un projet ou d'un événement"@fr ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> ;
    owl:inverseOf <https://w3id.org/vocab/lingvoj#officialIn> ;
    ns1:domainIncludes <http://linkedevents.org/ontology/Event>,
        <http://schema.org/Place>,
        foaf:Organization,
        foaf:Project ;
    ns1:similarProperty <http://www.telegraphis.net/ontology/geography/geography#officialLanguage> .

<https://w3id.org/vocab/lingvoj#originalResource> a owl:ObjectProperty ;
    rdfs:label "original resource"@en,
        "ressource originale"@fr ;
    rdfs:comment "The resource which is translated"@en,
        "La ressource qui est traduite"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Translation> .

<https://w3id.org/vocab/lingvoj#supportedLanguage> a owl:ObjectProperty ;
    rdfs:label "supported language"@en,
        "langue supportée"@fr ;
    rdfs:comment "A language supported by the language resource"@en,
        "Une langue supportée par la ressource linguistique"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#LanguageResource> ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> .

<https://w3id.org/vocab/lingvoj#translator> a owl:ObjectProperty ;
    rdfs:label "translator"@en,
        "traducteur"@fr ;
    rdfs:comment "An agent (person, organization or sofware) responsible of the translation"@en,
        "Un agent (personne, organisation ou logiciel) responsable de la traduction"@fr ;
    rdfs:domain <https://w3id.org/vocab/lingvoj#Translation> ;
    rdfs:range foaf:Agent .

<https://w3id.org/vocab/lingvoj#workingLanguage> a owl:ObjectProperty ;
    rdfs:label "working language"@en,
        "langue de travail"@fr ;
    dcterms:replaces <https://w3id.org/vocab/lingvoj#hasWorkingLanguage> ;
    rdfs:comment "A language the project or organization uses for internal communication"@en,
        "Une langue utilisée par l'organisation ou le projet pour sa communication interne"@fr ;
    rdfs:range <https://w3id.org/vocab/lingvoj#Lingvo> ;
    ns1:domainIncludes foaf:Organization,
        foaf:Project .

<https://w3id.org/vocab/lingvoj#LanguageResource> a owl:Class ;
    rdfs:label "Language resource"@en,
        "Ressource linguistique"@fr ;
    rdfs:comment "Dictionaries, thesauri, language courses, translation services, etc."@en,
        "Dictionnaires, thesaurus, cours de langue, services de traduction, etc."@fr ;
    rdfs:seeAlso <http://www.language-archives.org/documents/faq.html#2> .

<https://w3id.org/vocab/lingvoj#hasAbility1> dcterms:isReplacedBy <https://w3id.org/vocab/lingvoj#basicReading>,
        <https://w3id.org/vocab/lingvoj#basicSpeaking>,
        <https://w3id.org/vocab/lingvoj#basicUnderstanding>,
        <https://w3id.org/vocab/lingvoj#basicWriting> ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#hasAbility2> dcterms:isReplacedBy <https://w3id.org/vocab/lingvoj#intermediateReading>,
        <https://w3id.org/vocab/lingvoj#intermediateSpeaking>,
        <https://w3id.org/vocab/lingvoj#intermediateUnderstanding>,
        <https://w3id.org/vocab/lingvoj#intermediateWriting> ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#hasAbility3> dcterms:isReplacedBy <https://w3id.org/vocab/lingvoj#advancedReading>,
        <https://w3id.org/vocab/lingvoj#advancedSpeaking>,
        <https://w3id.org/vocab/lingvoj#advancedUnderstanding>,
        <https://w3id.org/vocab/lingvoj#advancedWriting> ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#hasAbility4> dcterms:isReplacedBy <https://w3id.org/vocab/lingvoj#expertReading>,
        <https://w3id.org/vocab/lingvoj#expertSpeaking>,
        <https://w3id.org/vocab/lingvoj#expertUnderstanding>,
        <https://w3id.org/vocab/lingvoj#expertWriting> ;
    rdfs:isDefinedBy onto:_v1.3.rdf ;
    owl:deprecated true .

<https://w3id.org/vocab/lingvoj#Translation> a owl:Class ;
    rdfs:label "Translation"@en,
        "Traduction"@fr ;
    vann:example <http://www.lingvoj.org/translations/w3c-recs.rdf#translation-css1-en-to-bg> ;
    rdfs:comment "Description of a Translation should include original resource, translated resource, original language and target language. It might also include translator(s) and translation date, and relevant other information using properties inherited from the generic Event class"@en,
        "La description d'une Traduction inclut au minimum la ressource originale, la ressource traduite, la langue d'origine et la langue cible. Elle peut aussi inclure le(s) traducteur(s), la date de traduction, et toute autre information pertinente utilisant les propriétés de la classe générique Evénement"@fr ;
    rdfs:subClassOf <http://linkedevents.org/ontology/Event> ;
    ns1:expectedProperty dcterms:date .

<https://w3id.org/vocab/lingvoj#Lingvo> a owl:Class ;
    rdfs:label "Language"@en,
        "Langue"@fr ;
    ns2:somewhatSameAs ns2:Language ;
    vann:example <http://id.loc.gov/vocabulary/iso639-1/ja>,
        <http://lexvo.org/id/iso639-3/fra> ;
    rdfs:comment "A language used in spoken or written human communication, or in which a resource is written or recorded. It is recommended to use instances defined on the basis of ISO 639 codes, such as those in examples"@en,
        "Une langue utilisée dans la communication orale ou écrite entre humains, ou dans laquelle une ressource est écrite ou enregistrée. Il est recommandé d'utiliser des instances définies sur la base d'un code ISO 639, comme dans les exemples"@fr ;
    rdfs:subClassOf dcterms:LinguisticSystem,
        <http://www.loc.gov/mads/rdf/v1#Language> ;
    owl:equivalentClass <http://d-nb.info/standards/elementset/gnd#Language>,
        <http://purl.org/linguistics/gold/Language>,
        <http://schema.org/Language>,
        <http://www.ontotext.com/proton/protontop#Language> .

