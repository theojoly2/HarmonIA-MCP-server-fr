@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <https://w3id.org/widoco/vocab#> .
@prefix ns2: <https://w3id.org/itsmo#> .
@prefix ns3: <http://purl.org/vocommons/voaf#> .
@prefix ns4: <http://purl.org/ontology/bibo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:abstract a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

dcterms:bibliographicCitation a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

dcterms:conformsTo a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

dcterms:creator a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

dcterms:license a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

dcterms:publisher a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

dcterms:subject a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

dcterms:title a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

ns4:status a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

vann:preferredNamespacePrefix a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

vann:preferredNamespaceUri a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

ns3:extends a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

rdfs:comment a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

skos:broader a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

skos:inScheme a owl:AnnotationProperty .

skos:notation a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

prov:generatedAtTime a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

foaf:fundedBy a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

foaf:homepage a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

foaf:name a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

<https://itsmo-efe4e5.gitlab.io/userguide> dcterms:title "ITSMO User Guide"@en .

<https://purl.org/itsmo> a owl:NamedIndividual ;
    foaf:name "ITSMO User Guide" .

schema:codeRepository a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

schema:image a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

ns2:Agreement a owl:Class ;
    rdfs:label "Agreement" ;
    rdfs:comment "A document that describes a formal understanding between two or more parties. An agreement is not legally binding, unless it forms part of a contract."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:BinaryDistribution a owl:Class ;
    rdfs:label "BinaryDistribution"@en ;
    rdfs:comment "a software package distributed in compiled form"@en ;
    rdfs:subClassOf ns2:SoftwarePackage .

ns2:BuildProcessDescription a owl:NamedIndividual,
        prov:Role ;
    rdfs:label "BuildProcessDescription"@en ;
    rdfs:comment "An entity that defines the process  for constructing or assembling something."@en ;
    rdfs:isDefinedBy ns2: .

ns2:BusinessService a owl:NamedIndividual,
        ns2:ServiceScope ;
    rdfs:label "BusinessService"@en ;
    dcterms:conformsTo <http://www.itil-officialsite.com/InternationalActivities/ITILGlossaries_2.aspx#English_2011_Glossary> ;
    rdfs:comment "An IT service that is visible to the customer. These are normally services that support the customer’s business processes and facilitate one or more outcomes desired by the customer. All live customer-facing services, including those available for deployment, are recorded in the service catalogue along with customer-visible information about deliverables, prices, contact points, ordering and request processes. Other information such as relationships to supporting services and other CIs will also be recorded for internal use by the IT service provider. ITIL 2011 calls this \"customer-facing service\" while use Business Service as a more general term ( ITIL Business Service could be also a non IT )."@en ;
    rdfs:isDefinedBy ns2: .

ns2:Container a owl:Class ;
    rdfs:label "Container"@en ;
    rdfs:comment "A structure or system designed to hold or encapsulate elements."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Artifact .

ns2:CustomerAgreementPortfolio a owl:Class ;
    rdfs:label "CustomerAgreementPortfolio" ;
    rdfs:comment "A database or structured document used to manage service contracts or agreements between an IT service provider and its customers. Each IT service delivered to a customer should have a contract or other agreement that is listed in the customer agreement portfolio."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Catalogue .

ns2:CustomerPortfolio a owl:Class ;
    rdfs:label "CustomerPortfolio" ;
    rdfs:comment "A database or structured document used to record all customers of the IT service provider. The customer portfolio is the business relationship manager’s view of the customers who receive services from the IT service provider."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Catalogue .

ns2:Dataset a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A structured collection of data, typically used for analysis or reference."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Artifact .

ns2:DeployProcessDescription a owl:NamedIndividual,
        prov:Role ;
    rdfs:label "DeployProcessDescription"@en ;
    rdfs:comment "An entity responsible for deploying and managing a system or application."@en ;
    rdfs:isDefinedBy ns2: .

ns2:Design a owl:NamedIndividual,
        ns2:ServiceLifeCycleStage ;
    rdfs:label "Design"@en ;
    rdfs:comment "A plan or specification for constructing an object, system, or service."@en ;
    rdfs:isDefinedBy ns2: .

ns2:HighCriticality a owl:NamedIndividual,
        ns2:Criticality ;
    rdfs:label "HighCriticality"@en ;
    rdfs:comment "an high criticality value"@en ;
    rdfs:isDefinedBy ns2: .

ns2:HighPriority a owl:NamedIndividual,
        ns2:Priority ;
    rdfs:label "HighPriority"@en ;
    rdfs:comment "an high priority"@en ;
    rdfs:isDefinedBy ns2: .

ns2:InfrastructureService a owl:NamedIndividual,
        ns2:ServiceScope ;
    rdfs:label "InfrastructureService"@en ;
    dcterms:conformsTo <http://www.itil-officialsite.com/InternationalActivities/ITILGlossaries_2.aspx#English_2011_Glossary> ;
    rdfs:comment "An IT service that is not directly used by the business, but is required by the IT service provider to deliver IT Business Services (for example, a directory service or a backup service).\\nSupporting services may also include IT services only used by the IT service provider.\\nAll live supporting services, including those available for deployment, are recorded in the service catalogue along with information about their relationships to Business Services  and other CIs.\\nITIL 2011 call ths also \"Supporting Service\""@en ;
    rdfs:isDefinedBy ns2: .

ns2:Library a owl:Class ;
    rdfs:label "Library" ;
    rdfs:comment "A structured collection of documents, assets, or components that support knowledge sharing, versioning, and reuse within the ITIL framework."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Software .

ns2:LowCriticality a owl:NamedIndividual,
        ns2:Criticality ;
    rdfs:label "LowCriticality"@en ;
    rdfs:comment "a low criticality value"@en ;
    rdfs:isDefinedBy ns2: .

ns2:LowPriority a owl:NamedIndividual,
        ns2:Priority ;
    rdfs:label "LowPriority"@en ;
    rdfs:comment "a low priority"@en ;
    rdfs:isDefinedBy ns2: .

ns2:ManagementProcess a owl:Class ;
    rdfs:label "ManagementProcess" ;
    rdfs:comment "Is a process of planning and controlling one or more of activities. Here \\n    are some examples:\\n\\n- **Configuration Management**: the process responsible for ensuring that the assets required to deliver services are properly controlled, and that accurate and reliable information about those assets is available when and where it is needed. This information includes details of how the assets have been configured and the relationships betweens [ITIL glossary].\\n\\n- **Project Management**: the discipline of planning, organizing, securing, and managing resources to achieve specific goals. A project is a temporary endeavor with a defined beginning and end (usually time-constrained, and often constrained by funding or deliverables), undertaken to meet unique goals and objectives, typically to bring about beneficial change or added value [Wikipedia].\\n\\n- **Change Management**: the process responsible for controlling the lifecycle of all changes, enabling beneficial changes to be made with minimum disruption to IT services. [ITIL glossary]"@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:ProcessDescription .

ns2:MediumCriticality a owl:NamedIndividual,
        ns2:Criticality ;
    rdfs:label "MediumCriticality"@en ;
    rdfs:comment "A medium criticality value."@en ;
    rdfs:isDefinedBy ns2: .

ns2:MediumPriority a owl:NamedIndividual,
        ns2:Priority ;
    rdfs:label "MediumPriority"@en ;
    rdfs:comment "A medium priority."@en ;
    rdfs:isDefinedBy ns2: .

ns2:Operation a owl:NamedIndividual,
        ns2:ServiceLifeCycleStage ;
    rdfs:label "Operation"@en ;
    rdfs:comment "A specific action or series of actions performed as part of a process."@en ;
    rdfs:isDefinedBy ns2: .

ns2:OperationLevelAgreement rdfs:label "OperationLevelAgreement"@en .

ns2:OperationLevelAgrement a owl:NamedIndividual,
        schema:WarranyScope ;
    rdfs:label "OperationLevelAgreement"@en ;
    rdfs:comment "An agreement outlining operational expectations and responsibilities."@en ;
    rdfs:isDefinedBy ns2: .

ns2:Owner a owl:NamedIndividual,
        prov:Role ;
    rdfs:label "Owner"@en ;
    rdfs:comment "An entity or individual possessing rights or control over an object or resource."@en ;
    rdfs:isDefinedBy ns2: .

ns2:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "Formally documented management expectations and intentions. Policies are used to direct decisions, and to ensure consistent and appropriate development and implementation of processes, standards, roles, activities, IT infrastructure etc."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:Responsible a owl:NamedIndividual,
        prov:Role ;
    rdfs:label "Responsible"@en ;
    rdfs:comment "An entity or individual accountable for a particular task or decision."@en ;
    rdfs:isDefinedBy ns2: .

ns2:Retire a owl:NamedIndividual,
        ns2:ServiceLifeCycleStage ;
    rdfs:label "Retire"@en ;
    rdfs:comment "Permanent removal of a configuration item, from the live environment. Being retired is a stage in the lifecycle of many configuration items."@en ;
    rdfs:isDefinedBy ns2: .

ns2:ServiceCatalogue a owl:Class ;
    rdfs:label "ServiceCatalogue" ;
    rdfs:comment "A database or structured document with information about all live IT services, including those available for deployment. The service catalogue is part of the service portfolio and contains information about two types of IT service: customer-facing services that are visible to the business; and supporting services required by the service provider to deliver customer-facing services."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:ServicePortfolio .

ns2:ServiceLevelAgreement a owl:NamedIndividual,
        schema:WarranyScope ;
    rdfs:label "ServiceLevelAgreement"@en ;
    rdfs:comment "A formal agreement defining the expected service performance and commitments."@en ;
    rdfs:isDefinedBy ns2: .

ns2:ServiceOption a owl:Class ;
    rdfs:label "ServiceOption" ;
    rdfs:comment "A choice of utility and warranty offered to customers by a core service or service package."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Utility .

ns2:SourceDistribution a owl:Class ;
    rdfs:label "SourceDistribution"@en ;
    rdfs:comment "A software package distributed with source code"@en ;
    rdfs:subClassOf ns2:SoftwarePackage .

ns2:Strategy a owl:NamedIndividual,
        ns2:ServiceLifeCycleStage ;
    rdfs:label "Strategy"@en ;
    rdfs:comment "A high-level plan or approach designed to achieve specific long-term objectives, often related to business or IT goals."@en ;
    rdfs:isDefinedBy ns2: .

ns2:SupportService a owl:NamedIndividual,
        ns2:ServiceScope ;
    rdfs:label "SupportService"@en ;
    rdfs:comment "A service that provides assistance or maintenance."@en ;
    rdfs:isDefinedBy ns2: .

ns2:Template a owl:Class ;
    rdfs:label "Template" ;
    rdfs:comment "A skeleton document or a document to be used as reference for editing another document."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:Transition a owl:NamedIndividual,
        ns2:ServiceLifeCycleStage ;
    rdfs:label "Transition"@en ;
    rdfs:comment "The phase or process in ITIL that focuses on ensuring that changes, updates, or new services are transitioned smoothly from development to production."@en ;
    rdfs:isDefinedBy ns2: .

ns2:Warranty a owl:Class ;
    rdfs:label "Warranty" ;
    rdfs:comment "Assurance that a product or service will meet agreed requirements. This may be a formal agreement such as a service level agreement or contract, or it may be a marketing message or brand image. Warranty refers to the ability of a service to be available when needed, to provide the required capacity, and to provide the required reliability in terms of continuity and security. Warranty can be summarized as ‘how the service is delivered’, and can be used to determine whether a service is ‘fit for use’. The business value of an IT service is created by the combination of utility and warranty."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:WebService a owl:Class ;
    rdfs:label "WebService"@en ;
    rdfs:comment "A service that communicates over a network using web-based protocols."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf schema:WebAPI,
        ns2:ITService .

ns2:builtFrom a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "builtFrom"@en ;
    rdfs:comment "A software baseline that contributes to the construction of an artifact."@en ;
    rdfs:domain ns2:Artifact ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:Packaging ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns2:created a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns2:ConfigurationItem ;
    rdfs:subPropertyOf dcterms:created .

ns2:hasEndpoint a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasEndpoint"@en ;
    rdfs:comment "an URL where the service responds, it is an inverse functional property"@en ;
    rdfs:domain ns2:ITService ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subPropertyOf ns2:versionOf ;
    skos:editorialNote "for WebService this is usually the same of the service URI."@en .

ns2:hasOwner a owl:ObjectProperty ;
    rdfs:label "hasOwner" ;
    rdfs:comment "Denotes the legal owner of an asset"@en ;
    rdfs:domain ns2:ObjectRepository ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:Agent ;
    skos:editorialNote "think it as the owner of a git repository"@en .

ns2:hasResponsible a owl:ObjectProperty ;
    rdfs:label "hasResponsible" ;
    rdfs:comment "Those who do the work to achieve a Process. There is typically one role with a participation type of Responsible, although others can be delegated to assist in the work required."@en ;
    rdfs:domain ns2:ConfigurationItem ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:Agent ;
    skos:editorialNote "think it as the Git repository maintainer"@en .

ns2:hasScope a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasScope" ;
    rdfs:comment "This attribute states the service scope"@en ;
    rdfs:domain ns2:Service ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:ServiceScope .

ns2:implementsInterface a owl:ObjectProperty ;
    rdfs:domain ns2:SystemComponent ;
    rdfs:range ns2:ComponentInterface .

ns2:informedBy a owl:ObjectProperty ;
    rdfs:label "informedBy"@en ;
    rdfs:comment "Indicates a source or entity providing relevant information."@en ;
    rdfs:domain ns2:Service ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:Service ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns2:interface_EI a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:definition "Custom interface used to access data from a legacy system or external data providers through unspecified protocols and formats. (Not a Web Resource)"@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "EI" ;
    skos:prefLabel "External Interface"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_ENV a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:definition "Service configuration options passed through environment variables and/or startup options."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "ENV" ;
    skos:prefLabel "Config Interface"@en ;
    ns2:interface_implementationStatus "mandatory" .

ns2:interface_FS a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:definition "A POSIX compliant sharable file system interface (can be read-only)."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "FS" ;
    skos:prefLabel "File System Interface"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_LDR a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_API ;
    skos:definition "A RESTFul API interface providing Linked Data Resources."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "LDR" ;
    skos:prefLabel "Linked Data Resource"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_LOG a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:definition "A logging feature compatible with the Docker Log commands."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "LOG" ;
    skos:prefLabel "Log Interface"@en ;
    ns2:interface_implementationStatus "mandatory" .

ns2:interface_MDB a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_API ;
    skos:definition "A DB exposing Mongo DB interface."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "MDB" ;
    skos:prefLabel "Mongo DB"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_MOC a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_LI ;
    skos:definition "An Operator Console supporting Mopso SDaaS commands."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "MOC" ;
    skos:prefLabel "Mopso Operator Console"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_MQ a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_API ;
    skos:definition "Queues exposing RabbitMQ interface."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "MQ" ;
    skos:prefLabel "Message queue interface"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_S3 a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_API ;
    skos:definition "Object Block Storage exposing AWS S3 interface."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "S3" ;
    skos:prefLabel "OBS S3 interface"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_SQ a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_PI ;
    skos:definition "An endpoint compliant with the SPARQL 1.1 protocol specification providing the sd:SPARQL11Query and sd:UnionDefaultGraph features."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "SQ" ;
    skos:prefLabel "SPARQL QUERY"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_SU a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_API ;
    skos:definition "An endpoint compliant with the SPARQL 1.1 protocol specification providing the sd:SPARQL11Update and sd:UnionDefaultGraph features, plus support for the SPARQL 1.1 Graph Store HTTP Protocol."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "SU" ;
    skos:prefLabel "SPARQL UPDATE"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_SWB a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_WAPP ;
    skos:definition "A web application providing browsable user access to a knowledge graph."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "SWB" ;
    skos:prefLabel "Semantic Workbench"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_implementationStatus a owl:AnnotationProperty .

ns2:partOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "partOf"@en ;
    rdfs:comment "a direct hierarchical dependency"@en ;
    rdfs:domain ns2:ConfigurationItem ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:ConfigurationItem ;
    rdfs:subPropertyOf ns2:dependsOn .

ns2:path a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "path"@en ;
    rdfs:comment "an optional  reference inside the repository structure."@en ;
    rdfs:domain ns2:ConfigurationBaseline ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range xsd:string ;
    skos:editorialNote "in GittLab or GithHub repository can be assigned on a path of a file or directory in a commit or tag tree or"@en .

ns2:promises a owl:ObjectProperty ;
    rdfs:label "promises" ;
    rdfs:comment "Represents a formal commitment or assurance provided by a service provider to meet certain standards or deliver specific outcomes."@en ;
    rdfs:domain ns2:ProductSheet ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:FeatureSheet ;
    rdfs:subPropertyOf ns2:links .

ns2:versionTag a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "versionTag" ;
    rdfs:comment "A label or identifier assigned to a specific reference version of a component, application, or document for tracking and management."@en ;
    rdfs:domain ns2:ConfigurationItem ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range xsd:string ;
    skos:editorialNote "in GitLab/GitHub can be a tag or the commit id."@en .

ns1:introduction a owl:AnnotationProperty ;
    rdfs:isDefinedBy ns2: .

dcterms:created a owl:DatatypeProperty .

skos:ConceptScheme a owl:Class .

prov:Agent a owl:Class .

prov:specializationOf a owl:ObjectProperty .

<https://gitlab.com/ecow> a owl:NamedIndividual ;
    foaf:name "Enrico Fagnoni" .

schema:CreativeWork a owl:Class .

schema:Organization a owl:Class .

schema:Person a owl:Class .

schema:Service a owl:Class .

schema:SoftwareSourceCode a owl:Class .

schema:WebAPI a owl:Class .

ns2:ArtifactRegistry a owl:Class ;
    rdfs:label "ArtifactRegistry" ;
    rdfs:comment "A repository where software artifacts such as code, configurations, and dependencies are stored, managed, and versioned."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:ObjectRepository .

ns2:BuildingConfiguration a owl:Class ;
    rdfs:label "BuildingConfiguration"@en ;
    rdfs:comment "Documentation of Any human-made structure used or intended for supporting or sheltering any use or continuous occupancy."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:FeatureSheet a owl:Class ;
    rdfs:label "FeatureSheet" ;
    rdfs:comment "A document summarizing the key features and functionalities of a service, system, or product for stakeholders or users."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Utility .

ns2:GitHubProject a owl:Class ;
    rdfs:label "GitHubProject"@en ;
    rdfs:comment "A project hosted on GitHub, typically containing source code and version control."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:ObjectRepository .

ns2:GitLabProject a owl:Class ;
    rdfs:label "GitLabProject"@en ;
    rdfs:comment "A project hosted on GitLab, typically containing code and version control."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:ObjectRepository .

ns2:Hardware a owl:Class ;
    rdfs:label "Hardware" ;
    rdfs:comment "The documentation of the physical part of a computer."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:Packaging a owl:Class ;
    rdfs:label "Packaging"@en ;
    rdfs:comment "A document that describes how to create an artifact."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Plan,
        ns2:ProcessDescription,
        ns2:Software .

ns2:ProductSheet a owl:Class ;
    rdfs:label "ProductSheet" ;
    rdfs:comment "A document that provides an overview of a product, including its features, capabilities, and benefits, aimed at potential users or stakeholders."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Utility .

ns2:ServicePortfolio a owl:Class ;
    rdfs:label "ServicePortfolio" ;
    rdfs:comment "The complete set of services that is managed by a service provider. The service portfolio is used to manage the entire lifecycle of all services, and includes three categories: service pipeline (proposed or in development), service catalogue (live or available for deployment), and retired services."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Catalogue .

ns2:SystemComponent a owl:Class ;
    rdfs:label "SystemComponent" ;
    rdfs:comment "A fundamental building block or element of an IT system, such as hardware, software, or a network component."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Software .

ns2:dependsOn a owl:ObjectProperty ;
    rdfs:label "dependsOn"@en ;
    rdfs:comment "Indicates a directed dependency between entities."@en ;
    rdfs:domain ns2:ConfigurationItem ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:ConfigurationItem .

ns2:deployedFrom a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "deployedFrom"@en ;
    rdfs:comment "States baseline that contains the instructions to deploy a specific version of a service in a specific environment."@en ;
    rdfs:domain ns2:Service ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:Deployment ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns2:hasCriticality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasCriticality" ;
    rdfs:comment "Represents the relative criticality of an entity."@en ;
    rdfs:domain ns2:Service ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:Criticality ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns2:hasPriority a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasPriority" ;
    rdfs:comment "A priority qualitative value."@en ;
    rdfs:domain ns2:Service ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:Priority ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns2:interface_LI a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_OC ;
    skos:definition "A generic user interface on a local client."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "LI" ;
    skos:prefLabel "Local Interface"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_OC a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:definition "A basic compatible bash shell through ssh protocol providing STDIN and STDOUT."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "OC" ;
    skos:prefLabel "Operator Console"@en ;
    ns2:interface_implementationStatus "mandatory" .

ns2:interface_PI a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:definition "A protocol‐based interface representing endpoints following specific communication protocols."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "PI" ;
    skos:prefLabel "Protocol Interface"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_WAPP a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:definition "A web application providing browsable user access."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "WAPP" ;
    skos:prefLabel "Web App Interface"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:interface_WR a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:definition "A generic web resource in the definition of the W3C Web Architecture."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "WR" ;
    skos:prefLabel "Web Resource"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:links a owl:ObjectProperty ;
    rdfs:label "links" ;
    rdfs:comment "Indicates a connection or relationship between two entities, such as systems, services, or processes."@en ;
    rdfs:domain ns2:ConfigurationItem ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:ConfigurationItem ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns2:serviceStatus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "serviceStatus" ;
    rdfs:comment "the referenced resource is a stage in the life cycle of the described resource."@en ;
    rdfs:domain ns2:Service ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:ServiceLifeCycleStage ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://gitlab.com/linkeddatacenter> a owl:NamedIndividual ;
    foaf:homepage "https://linkeddata.center/" ;
    foaf:name "LinkedData.Center" .

schema:QualitativeValue a owl:Class .

schema:WarranyScope a owl:Class .

ns2:Deployment a owl:Class ;
    rdfs:label "Deployment"@en ;
    rdfs:comment "a document that describes how to crate an instance of a service or change its status."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Plan,
        ns2:ProcessDescription,
        ns2:Software .

ns2:ITService a owl:Class ;
    rdfs:label "ITService" ;
    rdfs:comment "An IT service is made up of a combination of information technology. It is deployed from a deployment baseline."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Service ;
    skos:editorialNote "An IT service is a runtime object that  must be linkked with a Deployment software  that stores the service configuration and tthe process descriptio (or pipelines) used to deploy it."@en .

ns2:Plan a owl:Class ;
    rdfs:label "Plan" ;
    rdfs:comment "A structured document or set of instructions outlining objectives, strategies, and actions for achieving specific IT or business goals."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:SoftwarePackage a owl:Class ;
    rdfs:label "SoftwarePackage" ;
    rdfs:comment "An artifact that  realizes a software release or a software feature set.\\nFor example: \"VirtueMart 1.1.x\", \"Linux LTS 10.04\" , \"Windows 7 service pack 2\", \"Apache 2\" . Sometime referenced only with \"software\"."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Artifact .

schema:Enumeration a owl:Class .

ns2:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "An autonomous entity capable of performing actions in a system."@en ;
    rdfs:isDefinedBy ns2: ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( prov:Agent schema:Organization schema:Person ) ] .

ns2:Catalogue a owl:Class ;
    rdfs:label "Catalogue" ;
    rdfs:comment "A complete list of items, typically one in alphabetical or other systematic order."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:ProcessDescription a owl:Class ;
    rdfs:label "ProcessDescription" ;
    rdfs:comment "A documenthat describes a structured set of activities designed to accomplish a specific objective. \\nA process takes one or more defined inputs and turns them into defined outputs. It may include any of the roles, responsibilities, tools and management controls required to reliably deliver the outputs. A process may define policies, standards, guidelines, activities and work instructions if they are needed."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:Utility a owl:Class ;
    rdfs:label "Utility" ;
    rdfs:comment "The functionality offered by a product or service to meet a particular need. Utility can be summarized as ‘what the service does’, and can be used to determine whether a service is able to meet its required outcomes, or is ‘fit for purpose’. The business value of an IT service is created by the combination of utility and warranty."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Documentation .

ns2:versionOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "versionOf"@en ;
    rdfs:comment "the referring ConfigurationItem is a total or partial snapshot of a resource state"@en ;
    rdfs:domain ns2:ConfigurationItem ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf owl:topObjectProperty,
        prov:specializationOf .

prov:Role a owl:Class .

ns2:ConfigurationBaseline a owl:Class ;
    rdfs:label "ConfigurationBaseline"@en ;
    rdfs:comment "A Configuration Item and  a  schema:CreativeWork that represents a portion of a snapshot of an ObjectRepository."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns2:ObjectRepository ;
            owl:onProperty ns2:versionOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        schema:CreativeWork,
        ns2:ConfigurationItem ;
    owl:disjointWith ns2:Service ;
    skos:editorialNote "think it as a commit tree in a git repository"@en .

ns2:ServiceScope a owl:Class ;
    rdfs:label "ServiceScope"@en ;
    rdfs:comment "The service scope (business or infrastructure)."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf schema:Enumeration .

ns2:Artifact a owl:Class ;
    rdfs:label "Artifact" ;
    rdfs:comment "A tangible output from a process, such as a document, container, or a library."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:ConfigurationBaseline .

ns2:Criticality a owl:Class ;
    rdfs:label "Criticality" ;
    rdfs:comment "A process criticality."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf schema:QualitativeValue .

ns2:Priority a owl:Class ;
    rdfs:label "Priority" ;
    rdfs:comment "A process priority"@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf schema:QualitativeValue .

ns2:Software a owl:Class ;
    rdfs:label "Software"@en ;
    rdfs:comment "Software code"@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf schema:SoftwareSourceCode,
        ns2:ConfigurationBaseline .

ns2:interface_API a owl:NamedIndividual,
        ns2:ComponentInterface ;
    skos:broader ns2:interface_WR ;
    skos:definition "Generic HTTP based application program interface compliant with the RESTful architecture."@en ;
    skos:inScheme ns2:ComponentInterfaceScheme ;
    skos:notation "API" ;
    skos:prefLabel "RESTfull APIs"@en ;
    ns2:interface_implementationStatus "optional" .

ns2:ObjectRepository a owl:Class ;
    rdfs:label "ObjectRepository"@en ;
    rdfs:comment "an service management entity with a state that can be versioned and managed in a repository" ;
    rdfs:isDefinedBy ns2: ;
    skos:editorialNote "think it as  a git repository"@en .

ns2:ServiceLifeCycleStage a owl:Class ;
    rdfs:label "ServiceLifeCycleStage" ;
    rdfs:comment "A stage in the life of a configuration item. The lifecycle defines the categories for status and the status transitions that are permitted. For   example:\\n\\n- The lifecycle of an application includes requirements, design, build, deploy, operate, optimize.\\n- The expanded incident lifecycle includes detection, diagnosis, repair, recovery, and restoration.\\n- The lifecycle of a server may include: ordered, received, in test, live, disposed, etc."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf schema:Enumeration .

ns2:Service a owl:Class ;
    rdfs:label "Service"@en ;
    rdfs:comment "A means of delivering value to customers by facilitating outcomes customers want to achieve without the ownership of specific costs and risks."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns2:ServiceLifeCycleStage ;
            owl:onProperty ns2:serviceStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns2:Priority ;
            owl:onProperty ns2:hasPriority ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns2:Deployment ;
            owl:onProperty ns2:deployedFrom ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns2:Criticality ;
            owl:onProperty ns2:hasCriticality ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        schema:Service,
        ns2:ConfigurationItem .

ns2:Documentation a owl:Class ;
    rdfs:label "Documentation"@en ;
    rdfs:comment "Information in readable form. A document may be paper or electronic – for example, a policy statement, service level agreement, incident record or diagram of a computer room layout. Dublin Core vocabulary applies to objects of this class."@en,
        "Information in readable form. A document may be paper or electronic – for example, a policy statement, service level agreement, incident record or diagram of a computer room layout.\\n\\nDublin Core vocabulary appy to objetc of thes class."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:ConfigurationBaseline .

ns2:ConfigurationItem a owl:Class ;
    rdfs:label "ConfigurationItem" ;
    rdfs:comment "Any component or other service asset whose state  needs to be managed in order to deliver an IT service. Information about each configuration item is recorded in a record within the configuration management system and is maintained throughout its lifecycle by service asset and configuration management. Configuration items are under the control of change management. They typically include IT services, hardware, software, buildings, and formal documentation such as process documentation and service level agreements."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:seeAlso <https://itsmo-efe4e5.gitlab.io/userguide/data-model/#the-configurationitem> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns2:versionOf ] ;
    skos:editorialNote "represents an immutable records that identifies  a specific state of an object"@en .

ns2:ComponentInterfaceScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    skos:prefLabel "IT Components Taxonomy"@en .

ns2:ComponentInterface a owl:Class ;
    rdfs:subClassOf schema:Enumeration .

ns2: a owl:NamedIndividual,
        owl:Ontology,
        ns2:ObjectRepository ;
    rdfs:label "ITSMO"@en ;
    dcterms:abstract "\\nIT Service Management Ontology (ITSMO)  provides a semantic framework for IT Service Providing businesses.\\n\\nITSMO aligns with ITIL best practices, ISO 20000 standards, and W3C architecture. It is free and easy to extend.\\n\\n**Please see the [ITSMO User Guide](https://purl.org/itsmo) for more info.**\\n\\t\\t\\t\\t\\t\\t  \\t"@en ;
    dcterms:bibliographicCitation "IT Service Management Ontology 2 (ITSMO). https://w3id.org/itsmo"@en ;
    dcterms:creator <https://gitlab.com/ecow> ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher <https://gitlab.com/linkeddatacenter> ;
    dcterms:subject "ITSM, ITIL, IT Service Management"@en ;
    dcterms:title "IT Service Management Ontology (ITSMO)"@en ;
    ns4:status <http://purl.org/ontology/bibo/status/accepted> ;
    vann:preferredNamespacePrefix "itsmo" ;
    vann:preferredNamespaceUri "https://w3id.org/itsmo#" ;
    ns3:extends prov:,
        schema: ;
    rdfs:comment "\\nITSMO encapsulates a typical ITIL service management model: Services and Software are tracked as configuration items, they have defined relationships to providers and customers, \\nand they go through building and deployment processes that rely on underlying infrastructure (as a service). The structure highlights both accountability \\n(who is responsible and who is the customer/provider) and the dependencies among CIs in a CMDB-like environment.\\n\\nITSMO works best with the [PROV](https://www.w3.org/TR/prov-o) and https://schema.org/ontologies.\\n\\nThis vocabulary is the second edition of ITSMO  that replaces  the deprecated http://ontology.it/itsmo/v1 version\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t "@en ;
    rdfs:seeAlso <https://LinkedData.Center/itsmo> ;
    owl:incompatibleWith <https://ontology.it/itsmo/v1> ;
    owl:priorVersion <https://ontology.it/itsmo/v1> ;
    owl:versionIRI <https://w3id.org/itsmo> ;
    owl:versionInfo "2.0.0" ;
    prov:generatedAtTime "2025-02-02T05:03:00"^^xsd:dateTime ;
    foaf:fundedBy <https://gitlab.com/linkeddatacenter> ;
    schema:codeRepository "https://gitlab.com/linkeddatacenter/itsmo" ;
    schema:image <https://www.plantuml.com/plantuml/svg/VLHDZvim4BtxLrXxQQkAFu2srR9iLekq2gj0RxauPY3kWeti8H5g-zyxV8Hain0kpFYzUOPv7Zyu51QRgcHV-8-PXvPvW6ZLha5mIoGcI-4S3utELT5OWShe2A7Y_0_Z_Fi1hAELL1G-TwIbYsvLMX08cSypUgMg0lPlJkTHE2YLXb6h5hYVL4u5KPg0FIW90sSlt9jLnYfiltxp-IaUeP1Y9KKveXTfHt23K8826zVXe_AhoY5iPTaX1OnIYJGrN93wVCHMEgkDqjZ1lpQlqxVUrTOS_A00ZNTSEDv79ymSIp_Tqw_rK1_TC2PQlwmsKHgimzMYCxq6l__hUJpU_GQ96wYDKsXiozXdmthYRF-No5Flh-GcttfMO57bGk8jpfEHJKNDwA5RnCJaU1IMTZn5V5I0kZHjft6Dl0dvBegkdUp3DYDgJTP8JFO0E8S_qqbjB0puVAl9zMvKaYGEeo2DudMom1iDyMQcnUVZfCGvOzTkKSc2Cn_hFijwti_PpJAeGMSkrbjTqoKGvrjDSkzkGQ8_g5H6Pti3hZRQgLq9MqrvVDHW6JkPtDEdZbF9hb4bFbjJCNOUrOvqpdokT6vi1TbZUqKwkpfyD2MG3MhiqZbEt4kdY4spLYb75nTxe5_jhhd_> ;
    ns1:introduction "IT Service Management Ontology (ITSMO) is a formal [vocabulary](http://www.w3.org/standards/semanticweb/ontology) (also known as \"schema,\" \"data dictionary,\" or \"ontology\") for describing resources related to IT Service Management best practices. The ITSMO namespace  is `https://w3id.org/itsmo#` and its usual prefix is `itsmo`.\\n\\n**The goals of ITSMO:**\\n1. Supporting IT Service Providers and product developers with a formal and shared vocabulary consistent with ITIL and ISO 20000 glossaries.\\n2. Describing and publishing knowledge about IT managed assets.\\n3. Being methodology agnostic.\\n4. Being independent from tools and vendors, allowing flexibility in asset control.\\n5. Enabling semantic web technologies to [infer](http://www.w3.org/standards/semanticweb/inference) useful insights about configuration items.\\n6. Serving as a foundation for applications supporting automatic impact analysis and risk management."@en .

[] a owl:AllDisjointClasses ;
    rdfs:isDefinedBy ns2: ;
    owl:members ( ns2:Artifact ns2:BuildingConfiguration ns2:Documentation ns2:Hardware ns2:Software ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns2:ArtifactRegistry ns2:GitHubProject ns2:GitLabProject ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns2:Agent ns2:ConfigurationItem ns2:ObjectRepository ) .

