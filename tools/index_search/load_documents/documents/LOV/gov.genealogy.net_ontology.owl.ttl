@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://gov.genealogy.net/ontology.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "Ontology for modelling historic administrative information."@en ;
    dc:created "2013-10-15"^^xsd:date ;
    dc:creator <http://datahub.io/user/jzedlitz> ;
    dc:date "2015-07-29"^^xsd:date ;
    dc:publisher <http://datahub.io/organization/compgen> ;
    dcterms:modified "2015-07-29"^^xsd:date .

<http://gov.genealogy.net/ontology.owl#begin> a owl:DatatypeProperty ;
    rdfs:label "begin"@en .

<http://gov.genealogy.net/ontology.owl#containsInformationAbout> a owl:ObjectProperty ;
    rdfs:label "the source contains information about these objects"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Source> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Relation> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#relation> .

<http://gov.genealogy.net/ontology.owl#end> a owl:DatatypeProperty ;
    rdfs:label "end"@en .

<http://gov.genealogy.net/ontology.owl#hasArea> a owl:ObjectProperty ;
    rdfs:label "area (in m²)"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForObject> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasAuthor> a owl:ObjectProperty ;
    rdfs:label "name of the publication's author"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Source> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForSource> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasDenomination> a owl:ObjectProperty ;
    rdfs:label "denomination"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForObject> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasHouseholds> a owl:ObjectProperty ;
    rdfs:label "number of households"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForObject> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasISBN> a owl:ObjectProperty ;
    rdfs:label "International Standard Book Number (ISBN)"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Source> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForSource> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasMunicipalityId> a owl:ObjectProperty ;
    rdfs:label "municipality code"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForObject> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasName> a owl:ObjectProperty ;
    rdfs:label "name"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyName> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasPopulation> a owl:ObjectProperty ;
    rdfs:label "population"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForObject> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasPostalCode> a owl:ObjectProperty ;
    rdfs:label "postal code"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForObject> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasSubtitle> a owl:ObjectProperty ;
    rdfs:label "subtitle"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Source> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForSource> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasTitle> a owl:ObjectProperty ;
    rdfs:label "title"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Source> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForSource> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property>,
        dcterms:title .

<http://gov.genealogy.net/ontology.owl#hasType> a owl:ObjectProperty ;
    rdfs:label "object type"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyType> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#hasURL> a owl:DatatypeProperty ;
    rdfs:label "web site"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovItem> ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://gov.genealogy.net/ontology.owl#hasWNumber> a owl:ObjectProperty ;
    rdfs:label "\"W number\" (identification for former German municipalities)"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#PropertyForObject> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#property> .

<http://gov.genealogy.net/ontology.owl#height> a owl:DatatypeProperty ;
    rdfs:label "altitude in meters"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Position> ;
    rdfs:range xsd:int .

<http://gov.genealogy.net/ontology.owl#isLocatedIn> a owl:ObjectProperty ;
    rdfs:label "building is located in"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Relation> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#relation> .

<http://gov.genealogy.net/ontology.owl#isPartOf> a owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Relation> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#relation> .

<http://gov.genealogy.net/ontology.owl#isReplacedBy> a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "object is deprecated and has been replaced by"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovItem> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#GovItem> .

<http://gov.genealogy.net/ontology.owl#language> a owl:DatatypeProperty ;
    rdfs:label "language (ISO-639-2)"@en .

<http://gov.genealogy.net/ontology.owl#lastModification> a owl:DatatypeProperty ;
    rdfs:label "date of last modification"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovItem> ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:modified .

<http://gov.genealogy.net/ontology.owl#latitude> a owl:DatatypeProperty ;
    rdfs:label "latitute"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Position> ;
    rdfs:range xsd:double .

<http://gov.genealogy.net/ontology.owl#longitude> a owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Position> ;
    rdfs:range xsd:double .

<http://gov.genealogy.net/ontology.owl#note> a owl:ObjectProperty ;
    rdfs:label "note"@en ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Note> .

<http://gov.genealogy.net/ontology.owl#noteText> a owl:DatatypeProperty ;
    rdfs:label "note text"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Note> ;
    rdfs:range xsd:string .

<http://gov.genealogy.net/ontology.owl#position> a owl:ObjectProperty ;
    rdfs:label "geographic position"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Position> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://gov.genealogy.net/ontology.owl#ref> a owl:ObjectProperty ;
    rdfs:label "reference"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Relation> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#GovObject> .

<http://gov.genealogy.net/ontology.owl#represents> a owl:ObjectProperty ;
    rdfs:label "object represents another object"@en ;
    rdfs:comment "examples: 1) a church as a visible building represents a parish 2) a town represents a country\\n    as its capital"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovObject> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Relation> ;
    rdfs:subPropertyOf <http://gov.genealogy.net/ontology.owl#relation> .

<http://gov.genealogy.net/ontology.owl#source> a owl:ObjectProperty ;
    rdfs:label "source citation"@en .

<http://gov.genealogy.net/ontology.owl#sourceNote> a owl:DatatypeProperty ;
    rdfs:label "note to the source"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#SourceReference> ;
    rdfs:range xsd:string .

<http://gov.genealogy.net/ontology.owl#sourceRef> a owl:ObjectProperty ;
    rdfs:label "source"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#SourceReference> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Source> .

<http://gov.genealogy.net/ontology.owl#time> a owl:ObjectProperty ;
    rdfs:label "lifetime"@en ;
    rdfs:comment "time period in which the statement was correct or there was relation\\n    relationship."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://gov.genealogy.net/ontology.owl#Property> <http://gov.genealogy.net/ontology.owl#Relation> ) ] ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Timespan> .

<http://gov.genealogy.net/ontology.owl#type> a owl:ObjectProperty ;
    rdfs:label "object type"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#PropertyType> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Type> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://gov.genealogy.net/ontology.owl#typeName> a owl:DatatypeProperty ;
    rdfs:label "type's name"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Type> .

<http://gov.genealogy.net/ontology.owl#value> a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#Property> .

<http://gov.genealogy.net/ontology.owl#PropertyName> a owl:Class ;
    rdfs:label "property 'name'"@en ;
    rdfs:subClassOf <http://gov.genealogy.net/ontology.owl#PropertyForObject> .

<http://gov.genealogy.net/ontology.owl#Timespan> a owl:Class ;
    rdfs:label "time span"@en .

<http://gov.genealogy.net/ontology.owl#Note> a owl:Class ;
    rdfs:label "note"@en .

<http://gov.genealogy.net/ontology.owl#PropertyType> a owl:Class ;
    rdfs:label "property 'object type'"@en ;
    rdfs:subClassOf <http://gov.genealogy.net/ontology.owl#PropertyForObject> .

<http://gov.genealogy.net/ontology.owl#SourceReference> a owl:Class ;
    rdfs:label "source citation"@en .

<http://gov.genealogy.net/ontology.owl#Type> a owl:Class ;
    rdfs:label "type"@en .

<http://gov.genealogy.net/ontology.owl#Position> a owl:Class ;
    rdfs:label "geographic position"@en .

<http://gov.genealogy.net/ontology.owl#PropertyForSource> a owl:Class ;
    rdfs:label "property of a source"@en ;
    rdfs:subClassOf <http://gov.genealogy.net/ontology.owl#Property> .

<http://gov.genealogy.net/ontology.owl#relation> a owl:ObjectProperty ;
    rdfs:label "generic relation"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovItem> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Relation> .

<http://gov.genealogy.net/ontology.owl#Property> a owl:Class ;
    rdfs:label "property"@en .

<http://gov.genealogy.net/ontology.owl#Source> a owl:Class ;
    rdfs:label "source"@en ;
    rdfs:subClassOf <http://gov.genealogy.net/ontology.owl#GovItem> .

<http://gov.genealogy.net/ontology.owl#Relation> a owl:Class ;
    rdfs:label "relationship between two objects"@en .

<http://gov.genealogy.net/ontology.owl#GovItem> a owl:Class .

<http://gov.genealogy.net/ontology.owl#PropertyForObject> a owl:Class ;
    rdfs:label "property of an object"@en ;
    rdfs:subClassOf <http://gov.genealogy.net/ontology.owl#Property> .

<http://gov.genealogy.net/ontology.owl#property> a owl:ObjectProperty ;
    rdfs:label "generic property"@en ;
    rdfs:domain <http://gov.genealogy.net/ontology.owl#GovItem> ;
    rdfs:range <http://gov.genealogy.net/ontology.owl#Property> .

<http://gov.genealogy.net/ontology.owl#GovObject> a owl:Class ;
    rdfs:label "object (settlement or administrative unit)"@en ;
    rdfs:subClassOf <http://gov.genealogy.net/ontology.owl#GovItem> .

