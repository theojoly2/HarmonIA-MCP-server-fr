    owl:sameAs <http://rdaregistry.info/Elements/w/key> ;
    skos:definition "Relates a work to the set of pitch relationships that establishes the tonal centre, or principal tonal centre, of a musical work."@en ;
    skos:scopeNote "Key is indicated by its pitch name and its mode, when it is major or minor."@en .

<http://rdaregistry.info/Elements/w/P10222> a rdf:Property ;
