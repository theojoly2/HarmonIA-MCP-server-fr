    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    ns2:instructionNumber "6.17" ;
    ns2:toolkitDefinition "The set of pitch relationships that establishes the tonal centre, or principal tonal centre, of a musical work."@en ;
