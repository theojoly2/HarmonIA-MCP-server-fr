    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    ns2:instructionNumber "7.7" ;
    ns2:toolkitDefinition "The class of user for which the content of a resource is intended, or for whom the content is considered suitable."@en ;
    ns2:toolkitLabel "intended audience"@en ;
