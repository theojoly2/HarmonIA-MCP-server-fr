    rdfs:isDefinedBy <http://rdaregistry.info/Elements/w/> ;
    rdfs:range <http://rdaregistry.info/Elements/c/C10004> ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60457> ;
    owl:inverseOf <http://rdaregistry.info/Elements/a/P50122> ;
    owl:sameAs <http://rdaregistry.info/Elements/w/appellantPerson> ;
    skos:definition "Relates a work to a person who appeals the decision of a lower court recorded in a legal work of a higher court."@en .

