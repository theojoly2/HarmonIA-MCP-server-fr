<http://rdaregistry.info/Elements/w/P10002> a rdf:Property ;
    rdfs:label "has identifier for the work"@en ;
    ns1:hasUnconstrained <http://rdaregistry.info/Elements/u/P60052> ;
    ns1:lexicalAlias <http://rdaregistry.info/Elements/w/identifierForTheWork.en> ;
    ns1:name "identifierForTheWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    ns2:instructionNumber "6.8" ;
    ns2:toolkitDefinition "A character string uniquely associated with a work, or with a surrogate for a work (e.g., an authority record)."@en ;
    ns2:toolkitLabel "identifier for the work"@en ;
    rdfs:domain <http://rdaregistry.info/Elements/c/C10001> ;
    rdfs:isDefinedBy <http://rdaregistry.info/Elements/w/> ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60052> ;
    owl:sameAs <http://rdaregistry.info/Elements/w/identifierForTheWork> ;
    skos:definition "Relates a work to a character string uniquely associated with a work, or with a surrogate for a work (e.g., an authority record)."@en ;
    skos:scopeNote "The identifier serves to differentiate that work from other works."@en .

<http://rdaregistry.info/Elements/w/P10003> a rdf:Property ;
    rdfs:label "has other distinguishing characteristic of the work"@en ;
    ns1:hasUnconstrained <http://rdaregistry.info/Elements/u/P60054> ;
    ns1:lexicalAlias <http://rdaregistry.info/Elements/w/otherDistinguishingCharacteristicOfTheWork.en> ;
    ns1:name "otherDistinguishingCharacteristicOfTheWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    ns2:instructionNumber "6.6" ;
    ns2:toolkitDefinition "A characteristic other than form of work, date of work, or place of origin of the work."@en ;
    ns2:toolkitLabel "other distinguishing characteristic of the work"@en ;
    rdfs:domain <http://rdaregistry.info/Elements/c/C10001> ;
    rdfs:isDefinedBy <http://rdaregistry.info/Elements/w/> ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60054> ;
    owl:sameAs <http://rdaregistry.info/Elements/w/otherDistinguishingCharacteristicOfTheWork> ;
    skos:definition "Relates a work to a characteristic other than form of work, date of work, or place of origin of the work."@en ;
    skos:scopeNote "It serves to differentiate a work from another work with the same title or from the name of a person, family, or corporate body."@en .

<http://rdaregistry.info/Elements/w/P10004> a rdf:Property ;
    rdfs:label "has form of work"@en ;
    ns1:hasUnconstrained <http://rdaregistry.info/Elements/u/P60058> ;
    ns1:lexicalAlias <http://rdaregistry.info/Elements/w/formOfWork.en> ;
