@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/ui#> .
@prefix ns2: <http://www.w3.org/2000/10/swap/pim/doc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.w3.org/ns/pim/space#ControlledStorage> a rdfs:Class ;
    rdfs:label "access controlled storage" ;
    rdfs:comment "A  storage is a space of URIs in which you can individually control for each resource\\n    who has access to it.\\n" ;
    rdfs:subClassOf <http://www.w3.org/ns/pim/space#Storage> .

<http://www.w3.org/ns/pim/space#PersonalStorage> a rdfs:Class ;
    rdfs:label "personal storage" ;
    rdfs:comment "A personal storage is a space of URIs in which you and only you have access to data,\\n    you cannot give access to anyone else.\\n" ;
    rdfs:subClassOf <http://www.w3.org/ns/pim/space#Storage> .

<http://www.w3.org/ns/pim/space#PublicStorage> a rdfs:Class ;
    rdfs:label "public storage" ;
    rdfs:comment "A public storage is a space of URIs in which you have access to data,\\n    and all data is accessible to anyone without control.\\n" ;
    rdfs:subClassOf <http://www.w3.org/ns/pim/space#Storage> .

<http://www.w3.org/ns/pim/space#Storage> a rdfs:Class ;
    rdfs:label "storage" ;
    rdfs:comment "A storage is a space of URIs in which you have access to data.\\n" .

<http://www.w3.org/ns/pim/space#Workspace> a rdfs:Class ;
    rdfs:label "workspace" ;
    rdfs:comment "Workspaces are place where data is stored, and associated polices of privacy.\\nA given application typically stores information in several different\\nworkspaces, some being user private, some shared, and some public.\\n" ;
    owl:disjointUnionOf ( <http://www.w3.org/ns/pim/space#PrivateWorkspace> <http://www.w3.org/ns/pim/space#SharedWorkspace> <http://www.w3.org/ns/pim/space#PublicWorkspace> ) .

<http://www.w3.org/ns/pim/space#PreferencesWorkspace> rdfs:label "Preferences workspace" ;
    rdfs:comment "Aceess may not be open to the public. Contains preferences resources." ;
    rdfs:subClassOf <http://www.w3.org/ns/pim/space#Workspace> .

<http://www.w3.org/ns/pim/space#masterWorkspace> a rdf:Property ;
    rdfs:label "master workspace"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://www.w3.org/ns/pim/space#MasterWorkspace> .

<http://www.w3.org/ns/pim/space#preferencesFile> a rdf:Property ;
    rdfs:label "preferences file" ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://www.w3.org/ns/pim/space#ConfigurationFile> .

<http://www.w3.org/ns/pim/space#storage> a rdf:Property ;
    rdfs:label "storage" ;
    rdfs:comment "The storage in which this workspace is, or the storage which\\ncontains this resource, or a storage available to this agent to use." ;
    rdfs:range <http://www.w3.org/ns/pim/space#Storage> .

<http://www.w3.org/ns/pim/space#uriPrefix> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "URI prefix" ;
    rdfs:comment "URIs which start with this string are in this workspace or storage.\\nThis may be used for constructing URIs for new storage resources.\\n" ;
    ns1:prompt "Give the first part of the URis in this workspace" .

<http://www.w3.org/ns/pim/space#workspace> a rdf:Property ;
    rdfs:label "workspace"@en ;
    rdfs:range <http://www.w3.org/ns/pim/space#Workspace> .

<https://www.w3.org/ns/pim/space#> dc:title "Workspace Ontology" ;
    rdfs:comment "This ontology is for use in describing\\nWorkspaces.  Workspaces are places where data is stored and associated policies of privacy.\\nA given application typically stores information in several different\\nworkspaces, some being user private, some shared, and some public.\\nit is crucial that the user has easy control over the destiny of information.\\n\\nGoals then are that the user can\\n\\n      - create workspaces\\n      - easily understand which workspace data is going into\\n      - understand what the implications of that are\\n      - (later) set ACLS on them\\n      - publish apropriate use policies for them\\n\\n" ;
    ns2:version "$Id: space.ttl,v 1.4 2021/10/01 18:47:19 timbl Exp $" .

<http://www.w3.org/ns/pim/space#ConfigurationFile> rdfs:subClassOf <http://www.w3.org/2006/gen/ont#InformationResource> .

<http://www.w3.org/ns/pim/space#MasterWorkspace> rdfs:label "Master Workspace"@en ;
    rdfs:comment "This is a workspace for storing the\\n    information about the other workspaces.\\n    As a user, you normally don't have to worry about it." ;
    rdfs:subClassOf <http://www.w3.org/ns/pim/space#PrivateWorkspace> .

<http://www.w3.org/ns/pim/space#PublicWorkspace> rdfs:label "Public workspace" ;
    rdfs:comment "Aceess is open to the public. Anything in a public workspace\\n    can be accesed by anyone." ;
    rdfs:subClassOf <http://www.w3.org/ns/pim/space#Workspace> .

<http://www.w3.org/ns/pim/space#SharedWorkspace> rdfs:label "Shared workspace" ;
    rdfs:comment "Access is to some but not all people." ;
    rdfs:subClassOf <http://www.w3.org/ns/pim/space#Workspace> .

<http://www.w3.org/ns/pim/space#PrivateWorkspace> rdfs:label "Private workspace" ;
    rdfs:comment "Access only by the you, the user." ;
    rdfs:subClassOf <http://www.w3.org/ns/pim/space#Workspace> .

