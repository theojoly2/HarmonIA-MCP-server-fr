ns3:GovernanceProtocol a owl:Class ;
    rdfs:label "Governance Protocol"^^xsd:string ;
    dc:description "Governance is used  to mean the processes that need to exist for a successful initiaitve, mission, program, or project. Such governance needs to outline the relationships between all internal and external groups involved, describe the proper flow of information regarding to all stakeholders, ensure the appropriate review of issues encountered and ensure that required approvals and direction for a 'GovernedEntity' is obtained at each appropriate stage."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:isGovernedBy ;
            owl:someValuesFrom ns3:StakeholderGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:ApprovalProcess ;
            owl:onProperty ns3:hasApprovalProcess ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasIssueResolutionProcess ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasChangeManagementProcess ],
        [ a owl:Restriction ;
            owl:cardinality "3"^^xsd:int ;
            owl:onProperty ns3:hasProcess ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:StakeholderGroup ;
            owl:onProperty ns3:isInterestOf ],
        [ a owl:Restriction ;
            owl:onProperty ns3:hasNormativeDocument ;
            owl:someValuesFrom ns3:Document ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:StakeholderGroup ;
            owl:onProperty ns3:mayNeedConcurrenceFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:StakeholderGroup ;
            owl:onProperty ns3:isApprovedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:ChangeManagementProcess ;
            owl:onProperty ns3:hasChangeManagementProcess ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Organization ;
            owl:onProperty ns3:isGovernedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:IssueResolutionProcess ;
            owl:onProperty ns3:hasIssueResolutionProcess ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:StakeholderGroup ;
            owl:onProperty ns3:reviewedBy ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:isGovernedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasApprovalProcess ],
        ns3:Qualifier ;
    owl:equivalentClass [ a owl:Class ;
            rdfs:isDefinedBy onto: ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns3:isGovernedBy ;
                        owl:someValuesFrom ns3:StakeholderGroup ] [ a owl:Restriction ;
                        owl:onProperty ns3:hasProcess ;
                        owl:someValuesFrom ns3:GovernanceProcess ] [ a owl:Restriction ;
                        owl:onProperty ns3:hasNormativeDocument ;
                        owl:someValuesFrom ns3:Document ] ) ] .

