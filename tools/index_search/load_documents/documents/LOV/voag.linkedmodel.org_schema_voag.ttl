    rdfs:isDefinedBy onto: .

ns3:hasChangeType a owl:ObjectProperty ;
    rdfs:label "has change type"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasGovernanceEvent a owl:ObjectProperty ;
