    rdfs:label "Creative commons work"^^xsd:string,
        "Creative Commons Work"@en-us ;
    dc:description "A potentially copyrightable work"@en-us ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:url ],
        owl:Thing .

ns3:Organization a owl:Class ;
    rdfs:label "Organization"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasLogo ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:OrganizationLogo ;
            owl:onProperty ns3:hasLogo ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:url ],
        ns3:Party,
        prov:Organization .

ns3:OrganizationLogo a owl:Class ;
    rdfs:label "Organization logo"^^xsd:string ;
    ns1:description "A logo for an organization"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Logo .

ns3:Pedigree a owl:Class ;
    rdfs:label "Pedigree"^^xsd:string ;
    dc:description "The origin or source of something. The primary purpose of provenance is to capture the time, place, and if appropriate the person responsible, for the creation, production or provisioning of some information object."^^xsd:string ;
    ns1:description "Pedigree captures aspects of an artifact that have to do with maturity, quality, salience, and accredidation."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:Accredidation ;
            owl:onProperty ns3:hasAccredidation ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Party ;
            owl:onProperty ns3:usedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasAccredidation ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:usage ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Maturity ;
            owl:onProperty ns3:hasMaturity ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasMaturity ],
        ns3:Qualifier .

ns3:Person a owl:Class ;
    rdfs:label "Person"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Party,
        prov:Person .

ns3:ProductLogo a owl:Class ;
    rdfs:label "Product logo"^^xsd:string ;
    ns1:description "Product logo is used for products, solutions, etc."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Logo .

ns3:Provenance a owl:Class ;
    rdfs:label "Provenance"^^xsd:string ;
    dc:description "The origin or source of something. The primary purpose of provenance is to capture the time, place, and if appropriate the person responsible, for the creation, production or provisioning of some information object."^^xsd:string ;
    ns1:description "Provenance specifies the origin or source of some artifact. The primary purpose of provenance is to capture the time, place, and if appropriate the person responsible, for the creation, production or provisioning of The artifact. Provenance also captures a record of how a version may have been superceded by another version of the artifact."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    rdfs:isDefinedBy onto: ;
                    owl:unionOf ( ns3:Party ns3:Document ) ] ;
            owl:onProperty ns3:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Pedigree ;
            owl:onProperty ns3:hasPedigree ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:ChangeType ;
            owl:onProperty ns3:hasChangeType ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:GovernedObject ;
            owl:onProperty ns3:supercedes ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:timestamp ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:revision ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:source ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:lastUpdated ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasPedigree ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:derivedFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:GovernedObject ;
            owl:onProperty ns3:supercededBy ],
        ns3:Qualifier .

ns3:TopQuadrantAttribution a ns3:Attribution ;
    rdfs:label "TopQuadrant attribution"^^xsd:string ;
    ns3:hasLogo ns3:TopQuadrantLogo-613x150 ;
    ns3:pointOfContact "Ralph Hodgson, TopQuadrant, Inc."^^xsd:string ;
    ns3:url "http://www.topquadrant.com"^^xsd:anyURI ;
    ns1:name "TopQuadrant, Inc."^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:VOAG-CatalogEntry a ns3:SchemaGraph,
        ns1:CatalogEntry ;
    rdfs:label "VOAG Catalog Entry"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:derivedFrom a rdf:Property ;
    rdfs:label "derived from"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasAccredidation a owl:ObjectProperty ;
    rdfs:label "has accredidation"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasApprovalProcess a owl:ObjectProperty ;
    rdfs:label "has approval process"^^xsd:string ;
    dc:description "An object property that specifies a process that is used for approval in a 'Governance Protocol'."^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasApprovalStatus a owl:ObjectProperty ;
    rdfs:label "has approval status"^^xsd:string ;
    dc:description "An object property that referes to an enumerated value that denotes the state of an approval."^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasChangeManagementProcess a owl:ObjectProperty ;
    rdfs:label "has change management process"^^xsd:string ;
    dc:description "An object property that specifies a process that is used for managing change in a 'Governance Protocol'."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:hasProcess .

ns3:hasConfidentiality a owl:ObjectProperty ;
    rdfs:label "has confidentiality"^^xsd:string ;
    dc:description "An object property that specifies a level of confidentiality. Typicall the range of this property will be 'voag:Confidentiality'."^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasGovernance a owl:ObjectProperty ;
    rdfs:label "has governance"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasIssueResolutionProcess a owl:ObjectProperty ;
    rdfs:label "has issue resolution process"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:hasProcess .

ns3:hasMaturity a owl:ObjectProperty ;
    rdfs:label "has maturity"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasOwner a owl:ObjectProperty ;
    rdfs:label "has owner"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasPedigree a owl:ObjectProperty ;
    rdfs:label "has pedigree"^^xsd:string ;
    dc:description "A reference to a description about the pedigree of something."^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasProtocol a owl:ObjectProperty ;
    rdfs:label "has protocol"^^xsd:string ;
    dc:description "A pointer to a record that holds governance information for one or more governed entities. Often governance can be shared across entities." ;
    rdfs:isDefinedBy onto: .

ns3:hasProvenance a owl:ObjectProperty ;
    rdfs:label "has provenance"^^xsd:string ;
    dc:description "A pointer to a provenance record that details the source, version and time of some subject of interest." ;
    rdfs:isDefinedBy onto: .

ns3:hasStatus a owl:ObjectProperty ;
    rdfs:label "has status"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:image a owl:DatatypeProperty ;
    rdfs:label "image"^^xsd:string ;
    dc:description "The property 'vaem:image' points  to an image using a URL."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI .

ns3:instigatedBy a owl:ObjectProperty ;
    rdfs:label "instigated by"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:isApprovedBy a owl:ObjectProperty ;
    rdfs:label "is approved by"^^xsd:string ;
    dc:description "References to which parties approve an entity." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:isGovernedBy .

ns3:isInterestOf a owl:ObjectProperty ;
    rdfs:label "interest of"^^xsd:string ;
    dc:description "A pointer to parties who have an interest in an entity. This is a two-way reference with the inverse property 'interestIn'." ;
    rdfs:isDefinedBy onto: .

ns3:mayNeedConcurrenceFrom a owl:ObjectProperty ;
    rdfs:label "may need concurrence from"^^xsd:string ;
    dc:description "An object property that specifies that a party may need to give consent, in the form of agreement, either written or verbally to the approval of some govenance concern."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:isGovernedBy ;
    owl:inverseOf ns3:givesConcurrenceFor .

ns3:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:priority a owl:ObjectProperty ;
    rdfs:label "priority"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:reviewedBy a owl:ObjectProperty ;
    rdfs:label "reviewed by"^^xsd:string ;
    dc:description "References to which parties review a data or information asset." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:isGovernedBy ;
    owl:inverseOf ns3:reviews .

ns3:source a owl:ObjectProperty ;
    rdfs:label "source"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:supercededBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "superceded by"^^xsd:string ;
    dc:description "A pointer to one or more 'GovernedEntities' that replace this entity."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:inverseOf ns3:supercedes .

ns3:CreativeCommonsProhibition a owl:Class ;
    rdfs:label "Creative Commons Prohibition"@en-us ;
    dc:description "something you may be asked not to do"@en-us ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue .

ns3:Governance a owl:Class ;
    rdfs:label "Governance"^^xsd:string ;
    dc:description "Governance is mainly concerned with how an artifact is provisioned and managed over its lifecycle. Governance also concerns the status tracking and processes that need to exist on information objects and services for a successful initiaitve, mission, program, or project. Such governance needs to outline the relationships between all internal and external groups involved, describe the proper flow of information regarding to all stakeholders, ensure the appropriate review of issues encountered and ensure that required approvals and direction are obtained at each appropriate stage."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:ChangeType ;
            owl:onProperty ns3:hasAnticipatedChangeType ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Governance ;
            owl:onProperty ns3:supercedes ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasConfidentiality ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Document ;
            owl:onProperty ns3:hasNormativeDocument ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Party ;
            owl:onProperty ns3:hasOwner ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Document ;
            owl:onProperty ns3:hasApplicableDocument ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:ConfidentialityLevel ;
            owl:onProperty ns3:hasConfidentiality ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:ChangeFrequency ;
            owl:onProperty ns3:frequencyOfChange ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:GovernanceEvent ;
            owl:onProperty ns3:hasGovernanceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Issue ;
            owl:onProperty ns3:hasIssue ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Document ;
            owl:onProperty ns3:hasReferenceDocument ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty ns3:hasApprovalStatus ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:isITAR ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:GovernanceProtocol ;
            owl:onProperty ns3:hasProtocol ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty ns3:hasProtocol ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:isFOSS ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasOwner ],
        ns3:Qualifier .

ns3:GovernanceEvent a owl:Class ;
    rdfs:label "Governance Event"^^xsd:string ;
    dc:description "A \"Governance Event\"."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Event .

ns3:Image a owl:Class ;
    rdfs:label "Image"^^xsd:string ;
    ns1:description "Image is a class for figures, pictures, logos, and icons  of various kinds"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:caption ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:width ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:height ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:image ],
        owl:Thing .

ns3:hasNormativeDocument a owl:ObjectProperty ;
    rdfs:label "has normative document"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:hasStakeholder a owl:ObjectProperty ;
    rdfs:label "has stakeholder"^^xsd:string ;
    rdfs:isDefinedBy onto: .

ns3:supercedes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "supercedes"^^xsd:string ;
    dc:description "A pointer to one or more 'GovernedEntities' that are replaced by this entity." ;
    rdfs:isDefinedBy onto: ;
    owl:inverseOf ns3:supercededBy .

ns3:title a owl:DatatypeProperty ;
    rdfs:label "title"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

ns3:Attribution a owl:Class ;
    rdfs:label "Attributed Source"^^xsd:string ;
    dc:description "An 'Attribution' specifies how credit should be given when citing the creators of a piece of work. Attribution must use the specified attribution text and optionally use logos that are provided in the attribution details below., with the names of points of contact."^^xsd:string,
        "The name, url and other details of an attribution."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:AttributionLogo ;
            owl:onProperty ns3:hasLogo ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasLogo ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:pointOfContact ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:name ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:url ],
        ns3:Qualifier .

ns3:GovernanceProcess a owl:Class ;
    rdfs:label "Governance Process"^^xsd:string ;
    dc:description "A \"Process\"."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Process .

ns3:GovernanceRole a owl:Class ;
    rdfs:label "Governance Role"^^xsd:string ;
    dc:description "A \"Role\" with the following instance(s): \"authorizer\", \"steward\", \"submitter\"."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue .

ns3:Graph a owl:Class ;
    rdfs:label "Graph"^^xsd:string ;
    ns1:description "A set of RDF triples in an ontology graph specified according to VOAG."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Discipline ;
            owl:onProperty ns1:disciplineScope ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasLogo ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Domain ;
            owl:onProperty ns1:domainScope ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasLicenseType ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Aspect ;
            owl:onProperty ns1:aspectScope ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:downloads ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:ProductLogo ;
            owl:onProperty ns3:hasLogo ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasGraphRole ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:urlOfTurtleFile ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:curatedGraphURI ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:attributionText ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:LicenseModel ;
            owl:onProperty ns1:hasLicenseType ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Attribution ;
            owl:onProperty ns1:withAttributionTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Viewpoint ;
            owl:onProperty ns1:viewpointScope ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:GraphRole ;
            owl:onProperty ns1:hasGraphRole ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:namespacePrefix ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:urlOfRDFfile ],
        void:Dataset .

ns3:Icon a owl:Class ;
    rdfs:label "Icon"^^xsd:string ;
    ns1:description "A logo of some kind"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Image .

ns3:Issue a owl:Class ;
    rdfs:label "Issue"^^xsd:string ;
    dc:description "captures issues such as raising of an issue related to a particular entity in a registry"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:description ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:IssueStatus ;
            owl:onProperty ns3:hasStatus ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty ns3:disposition ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty ns3:userID ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns3:priority ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:PriorityValue ;
            owl:onProperty ns3:priority ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasStatus ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:BoardDispositionStatus ;
            owl:onProperty ns3:dispositionStatus ],
        owl:Thing .

ns3:SchemaGraph a owl:Class ;
    rdfs:label "Schema graph"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:SchemaGraph ;
            owl:onProperty ns1:hasGraphRole ],
        ns3:Graph ;
    owl:equivalentClass [ a owl:Class ;
            rdfs:isDefinedBy onto: ;
            owl:intersectionOf ( ns3:Graph [ a owl:Restriction ;
                        owl:hasValue ns1:SchemaGraph ;
                        owl:onProperty ns1:hasGraphRole ] ) ] .

ns3:governs a owl:ObjectProperty ;
    rdfs:label "governs"^^xsd:string ;
    dc:description "A super-property of governance properties: 'approves', 'gives concurrence for', 'reviews' and 'witness to'."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:inverseOf ns3:isGovernedBy .

ns3:hasProcess a owl:ObjectProperty ;
    rdfs:label "has process"^^xsd:string ;
    dc:description "A reference to a process description." ;
    rdfs:isDefinedBy onto: .

ns1:description rdfs:label "description"^^xsd:string ;
    rdfs:range xsd:string .

ns3:CreativeCommonsPermission a owl:Class ;
    rdfs:label "Creative Commons Permission"@en-us ;
    dc:description "An action that may or may not be allowed or desired"@en-us ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue .

ns3:Logo a owl:Class ;
    rdfs:label "Logo"^^xsd:string ;
    ns1:description "Logo is ..."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Image .

ns3:ChangeType a owl:Class ;
    rdfs:label "Change type"^^xsd:string ;
    ns1:description "Change Type provides an indicator for how an artifact has or will change in the future. This indicator is important to understanding the stability of an ontology."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue .

ns3:Document a owl:Class ;
    rdfs:label "Document"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:dateCreated ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:name ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:url ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:description ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:title ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:lastUpdated ],
        owl:Thing .

ns3:PriorityValue a owl:Class ;
    rdfs:label "Priority value"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue .

ns3:PublicationStatus a owl:Class ;
    rdfs:label "Publication Status"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue .

ns3:Qualifier a owl:Class ;
    rdfs:label "Qualifier"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:name ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:id ],
        owl:Thing .

ns3:StakeholderGroup a owl:Class ;
    rdfs:label "Stakeholder Group"^^xsd:string ;
    dc:description "A Stakeholder Group is a party of people who have common interests and concerns." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:int ;
            owl:onProperty ns3:hasStakeholder ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Person ;
            owl:onProperty ns3:hasStakeholder ],
        ns3:Party,
        prov:Organization ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:hasStakeholder ;
            owl:someValuesFrom ns3:Person ] .

ns3:url a owl:DatatypeProperty ;
    rdfs:label "url"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI .

ns3:ConfidentialityLevel a owl:Class ;
    rdfs:label "Confidentiality level"^^xsd:string ;
    ns1:description "An enumerated codelist for values thath pertain to the security of a set of resources, or a resource. In 'lmc' an ontology can carry a property to denote its confidentiality."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue .

ns3:CreativeCommonsRequirement a owl:Class ;
    rdfs:label "Requirement"@en-us ;
    dc:description "an action that may or may not be requested of you"@en-us ;
    ns1:description "An action that may or may not be requested of you"@en-us ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue .

ns3:GovernedObject a owl:Class ;
    rdfs:label "Governed Object"^^xsd:string ;
    ns1:description "An abstract class for all governed entities"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:id ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:name ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:normativeURL ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:description ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:dateCreated ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:revision ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:url ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:title ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:lastUpdated ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasProvenance ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:hasGovernance ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:documentedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Governance ;
            owl:onProperty ns3:hasGovernance ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Provenance ;
            owl:onProperty ns3:hasProvenance ],
        prov:Entity .

ns3:Party a owl:Class ;
    rdfs:label "Party"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:id ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:name ] .

ns3:Event a owl:Class ;
    rdfs:label "Event"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:id ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:name ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns3:endDate ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns3:instigatedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns3:eventDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Party ;
            owl:onProperty ns3:instigatedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:description ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns3:startDate ],
        owl:Thing .

ns3:IssueStatus a owl:Class ;
    rdfs:label "Issue Status"^^xsd:string ;
    dc:description "The status of an issue: \"Closed\", \"Deferred\", \"Non issue\", \"Open\", \"Resolved\"."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue .

ns3:Maturity a owl:Class ;
    rdfs:label "Maturity"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue ;
    owl:unionOf ( ns3:WidelyAdopted ns3:SomeAdoption ns3:EarlyAdoption ns3:Proposed ns3:UnknownMaturity ns3:Experimental ns3:InDevelopment ) .

ns3:id a owl:DatatypeProperty ;
    rdfs:label "id"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anySimpleType .

ns3:hasLogo a owl:ObjectProperty ;
    rdfs:label "has logo"^^xsd:string ;
    dc:description "A property to reference an image that is used as a logo."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Logo .

ns3:ChangeFrequency a owl:Class ;
    rdfs:label "Change frequency"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:EnumeratedValue ;
    owl:oneOf ( ns3:Never ns3:Daily ns3:Weekly ns3:BiWeekly ns3:Monthly ns3:BiMonthly ns3:Quarterly ns3:BiQuarterly ns3:Annually ns3:UncertainFrequency ) .

ns3:EnumeratedValue a owl:Class ;
    rdfs:label "Metadata Enumerated value"^^xsd:string ;
    dc:description "The base class in LMC for enumerated values"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns2:EnumeratedValue .

ns3:LicenseModel a owl:Class ;
    rdfs:label "License Model"^^xsd:string ;
    ns1:description "A License Model describes the licensing conditions associated with a software artifact."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:LicenseModel ;
            owl:onProperty ns3:incompatibleWith ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:LicenseModel ;
            owl:onProperty ns3:compatibleWith ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:LicenseModel ;
            owl:onProperty ns3:derivedFrom ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns3:image ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:acronym ],
        ns3:GovernedObject .

ns3:isGovernedBy a owl:ObjectProperty ;
    rdfs:label "is governed by"^^xsd:string ;
    dc:description "A pointer to who is responsible for the governance of some entity of interest. This is a two-way reference with the inverse property 'governs'." ;
    rdfs:isDefinedBy onto: .

onto: a owl:Ontology ;
    rdfs:label "Vocabulary Of Attribution and Governance"^^xsd:string ;
    dc:author "Ralph Hodgson"^^xsd:string ;
    dc:subject "Licensing, Attribution and Governance"^^xsd:string ;
    dc:title "Vocabulary Of Attribution and Governance"^^xsd:string ;
    ns3:intent "Provides a schema for intellectual capital rights, attribution and governance. Uses the PROVO ontology for provenance.  Typical use of the ontology is to refer to its resources, as opposed to importing the ontology."^^xsd:string ;
    ns1:dateCreated "2011-01-31T10:00:00"^^xsd:dateTime ;
    ns1:description "VOAG stands for \"Vocabulary Of Attribution and Governance\". The ontology is intended to specify licensing, attribution, provenance and governance of an ontology. VOAG captures many common license types and their restrictions. Where a license requires attribution, VOAG provides resources that allow the attribution should be made. Provenance is defined in terms of source and pedigree. A miminal model of governance is provided based on how issues, releases and changes are managed. VOAG does not import, but makes uses of some concepts from VOID (http://vocab.deri.ie/void), notably void:Dataset."^^xsd:string ;
    ns1:hasCatalogEntry ns3:VOAG-CatalogEntry ;
    ns1:hasGraphRole ns1:SchemaGraph ;
    ns1:lastUpdated "2012-11-01"^^xsd:date ;
    ns1:name "VOAG"^^xsd:string ;
    ns1:namespace "http://voag.linkedmodel.org/voag"^^xsd:string ;
    ns1:namespacePrefix "voag"^^xsd:string ;
    ns1:revision "1.0"^^xsd:string ;
    ns1:url "http://voag.linkedmodel.org/1.0/owl/schema/voag"^^xsd:anyURI ;
    ns1:usesNonImportedResource dc:author,
        dc:contributor,
        dc:description,
        dc:subject,
        dc:title,
        ns3:TopQuadrantAttribution,
        ns3:VOAG-CatalogEntry ;
    ns1:withAttributionTo ns3:TopQuadrantAttribution ;
    owl:imports <http://rdfs.org/ns/void>,
        <http://www.linkedmodel.org/1.2/schema/vaem-xics>,
        <http://www.linkedmodel.org/schema/dtype>,
        <http://www.linkedmodel.org/schema/vaem>,
        <http://www.linkedmodel.org/schema/vaem-xina>,
        <http://www.w3.org/ns/20120724/prov> ;
    owl:versionIRI onto: .

