    rdfs:label "reviews"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:governs ;
    owl:inverseOf ns3:reviewedBy .

ns3:startDate a owl:DatatypeProperty ;
    rdfs:label "start date"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:dateUnion .

