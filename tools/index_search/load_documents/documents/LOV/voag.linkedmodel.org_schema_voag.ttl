ns3:supervisedBy a owl:ObjectProperty ;
    rdfs:label "supervised by"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:isGovernedBy .

ns3:timestamp a owl:DatatypeProperty ;
