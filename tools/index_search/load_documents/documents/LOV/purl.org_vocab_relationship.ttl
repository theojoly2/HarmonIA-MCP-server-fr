@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://open.vocab.org/terms/> .
@prefix onto: <http://purl.org/vocab/relationship/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .

onto:Relationship a rdfs:Class ;
    rdfs:label "Relationship"@en ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A particular type of connection existing between people related to or having dealings with each other."@en .

onto:acquaintanceOf a owl:SymmetricProperty ;
    rdfs:label "Acquaintance Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/acquaintanceOf> ;
    skos:definition "A person having more than slight or superficial knowledge of this person but short of friendship."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:ambivalentOf a rdf:Property ;
    rdfs:label "Ambivalent Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/ambivalentOf> ;
    skos:definition "A person towards whom this person has mixed feelings or emotions."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is a sub-property of foaf:knows due to reciprocity requirements. It is possible for one to be ambivalent of another without that person knowing the first." ] .

onto:antagonistOf a rdf:Property ;
    rdfs:label "Antagonist Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/antagonistOf> ;
    skos:definition "A person who opposes and contends against this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:closeFriendOf a owl:SymmetricProperty ;
    rdfs:label "Close Friend Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person who shares a close mutual friendship with this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:collaboratesWith a owl:SymmetricProperty ;
    rdfs:label "Collaborates With"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person who works towards a common goal with this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:colleagueOf a owl:SymmetricProperty ;
    rdfs:label "Colleague Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person who is a member of the same profession as this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:enemyOf a rdf:Property ;
    rdfs:label "Enemy Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/enemyOf> ;
    skos:definition "A person towards whom this person feels hatred, intends injury to, or opposes the interests of."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:engagedTo a owl:SymmetricProperty ;
    rdfs:label "Engaged To"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person to whom this person is betrothed."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:friendOf a owl:SymmetricProperty ;
    rdfs:label "Friend Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/friendOf> ;
    skos:definition "A person who shares mutual friendship with this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:hasMet a owl:SymmetricProperty ;
    rdfs:label "Has Met"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person who has met this person whether in passing or longer."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:influencedBy a rdf:Property ;
    rdfs:label "Influenced By"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom ;
    skos:definition "a person who has influenced this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is a sub-property of foaf:knows due to reciprocity requirements. It is possible for one to be influenced by another by reputation without that person knowing the first." ] .

onto:knowsByReputation a rdf:Property ;
    rdfs:label "Knows By Reputation"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom ;
    skos:definition "A person known by this person primarily for a particular action, position or field of endeavour."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is a sub-property of foaf:knows due to reciprocity requirements. It is possible for one to know of another by reputation without that person knowing the first." ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:knowsInPassing a rdf:Property ;
    rdfs:label "Knows In Passing"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person whom this person has slight or superficial knowledge of."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:lifePartnerOf a owl:SymmetricProperty ;
    rdfs:label "Life Partner of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person who has made a long-term commitment to this person's."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:livesWith a owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "Lives With"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person who shares a residence with this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:lostContactWith a owl:SymmetricProperty ;
    rdfs:label "Lost Contact With"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person who was once known by this person but has subsequently become uncontactable."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:neighborOf a owl:SymmetricProperty ;
    rdfs:label "Neighbor Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person who lives in the same locality as this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is transitive." ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:participant a rdf:Property ;
    rdfs:label "Participant"@en ;
    rdfs:domain onto:Relationship ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is a sub-property of foaf:knows." ] .

onto:participantIn a rdf:Property ;
    rdfs:label "Participant In"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Relationship ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is a sub-property of foaf:knows." ] .

onto:siblingOf a owl:SymmetricProperty ;
    rdfs:label "Sibling Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/siblingOf> ;
    skos:definition "A person having one or both parents in common with this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:spouseOf a owl:SymmetricProperty ;
    rdfs:label "Spouse Of"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/spouseOf> ;
    skos:definition "A person who is married to this person"@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:worksWith a owl:SymmetricProperty ;
    rdfs:label "Works With"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    skos:definition "A person who works for the same employer as this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is transitive." ] .

onto:wouldLikeToKnow a rdf:Property ;
    rdfs:label "Would Like To Know"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom ;
    skos:definition "A person whom this person would desire to know more closely."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is a sub-property of foaf:knows which would imply that the two people already know one another." ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

<http://vocab.org/relationship/.rdf> a dcmitype:Text,
        foaf:Document ;
    dcterms:hasFormat <http://vocab.org/relationship/.html>,
        <http://vocab.org/relationship/.json>,
        <http://vocab.org/relationship/.turtle> ;
    foaf:primaryTopic onto: ;
    foaf:topic onto: .

<http://iandavis.com/id/me> a foaf:Person ;
    foaf:name "Ian Davis" .

<http://lists.foaf-project.org/mailman/listinfo/foaf-dev> rdfs:label "FOAF-DEV mailing list" .

onto:ancestorOf a owl:TransitiveProperty ;
    rdfs:label "Ancestor Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom ;
    owl:inverseOf onto:descendantOf ;
    skos:definition "A person who is a descendant of this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is a sub-property of foaf:knows. foaf:knows requires a reciprocation that may not be possible for distant ancestors." ] .

onto:apprenticeTo a rdf:Property ;
    rdfs:label "Apprentice To"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:inverseOf onto:mentorOf ;
    skos:definition "A person to whom this person serves as a trusted counselor or teacher."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:childOf a rdf:Property ;
    rdfs:label "Child Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/childOf> ;
    owl:inverseOf onto:parentOf ;
    skos:definition "A person who was given birth to or nurtured and raised by this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:descendantOf a owl:TransitiveProperty ;
    rdfs:label "Descendant Of",
        "Descendant Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom ;
    owl:inverseOf onto:ancestorOf ;
    skos:definition "A person from whom this person is descended."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is a sub-property of foaf:knows. foaf:knows requires a reciprocation that may not be possible for distant descendants." ] .

onto:employedBy a rdf:Property ;
    rdfs:label "Employed By"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:inverseOf onto:employerOf ;
    skos:definition "A person for whom this person's services have been engaged."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:employerOf a rdf:Property ;
    rdfs:label "Employer Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:inverseOf onto:employedBy ;
    skos:definition "A person who engages the services of this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

<http://purl.org/vocab/relationship/examples/1> a ns1:SchemaExample ;
    rdfs:label "Using With FOAF" ;
    rdfs:comment "<p>The RELATIONSHIP vocabulary can be used without modification with <a href=\"http://xmlns.com/foaf/0.1/\">FOAF</a> documents. Simply replace <code>foaf:knows</code> properties with a more specific property from this vocabulary. For backwards compatibility with older, non-RDF aware,  tools, you may want to keep the <code>foaf:knows</code> property as well.</p>     <pre>\\n<code class=\"xml\">\\n&lt;rdf:RDF\\n      xmlns:rdf=&quot;http://www.w3.org/1999/02/22-rdf-syntax-ns#&quot;\\n      xmlns:rdfs=&quot;http://www.w3.org/2000/01/rdf-schema#&quot;\\n      xmlns:foaf=&quot;http://xmlns.com/foaf/0.1/&quot;\\n      xmlns:rel=&quot;http://purl.org/vocab/relationship/&quot;\\n      &gt;\\n\\n  &lt;foaf:Person rdf:nodeID=&quot;ian&quot;&gt;\\n    &lt;foaf:name&gt;Ian Davis&lt;/foaf:name&gt;\\n    &lt;foaf:title&gt;Mr&lt;/foaf:title&gt;\\n    &lt;foaf:firstName&gt;Ian&lt;/foaf:firstName&gt;\\n    &lt;foaf:surname&gt;Davis&lt;/foaf:surname&gt;\\n\\n    &lt;rel:hasMet&gt;\\n      &lt;foaf:Person&gt;\\n        &lt;foaf:name&gt;William Tell&lt;/foaf:name&gt;\\n      &lt;/foaf:Person&gt;\\n    &lt;/rel:hasMet&gt;\\n\\n    &lt;rel:collaboratesWith rdf:nodeID=&quot;eric&quot;/&gt;\\n  &lt;/foaf:Person&gt;\\n\\n  &lt;foaf:Person rdf:nodeID=&quot;eric&quot;&gt;\\n    &lt;foaf:nick&gt;pixel&lt;/foaf:nick&gt;\\n  &lt;/foaf:Person&gt;\\n\\n\\n\\n&lt;/rdf:RDF&gt;\\n</code>\\n    </pre>\\n"^^rdf:XMLLiteral .

<http://purl.org/vocab/relationship/examples/2> a ns1:SchemaExample ;
    rdfs:label "Using With HTML and XHTML" ;
    rdfs:comment "<p>\\n\\n      The relationship vocabulary can be used to describe relationships with the people linked from a web page. This is particularly useful for blogrolls or contact lists but can be used with any type of link. The HTML <code>a</code> element provides two attributes, <a href=\"http://www.w3.org/TR/html401/struct/links.html#adef-rel\">rel and rev</a>, that can be used to specify the relationship. Both <code>rel</code> and <code>rev</code> take a space separated list of keywords as their value. To use a term from the relationship vocabulary just drop the <code>http://purl.org/vocab/relationship/</code> namespace to leave the property name, e.g. <code>http://purl.org/vocab/relationship/worksWith</code> would become <code>worksWith</code> which can be added as the value of <code>rel</code> or <code>rev</code>.\\n    </p>\\n    <dl>\\n      <dt>\\n        <code>rel</code>\\n      </dt>\\n      <dd>\\n        <p>\\n          The <code>rel</code> attribute specifies a relationship that the author of the <em>linked</em> page has with the author of the <em>linking</em> page.\\n          For example:\\n        </p>\\n        <pre><code><span class=\"elem\">&lt;a</span><span class=\"attr\">href</span>=&quot;<span class=\"attrVal\">http://example.com/boats</span>&quot; <span class=\"attr highlight\">rel</span>=&quot;<span class=\"attrVal\">childOf</span>&quot;<span class=\"elem\">&gt;</span><span class=\"text\">The boat we restored</span><span class=\"elem\">&quot;&lt;/a&gt;</span></code></pre>\\n        <p>This link states that the author of <code>http://example.com/boats</code> is a child of the author of the html above. </p>\\n      </dd>\\n      <dt>\\n        <code>rev</code>\\n      </dt>\\n      <dd>\\n        <p>\\n          The <code>rev</code> attribute specifies a relationship that the author of the <em>linking</em> page has with the author of the   <em>linked</em> page. The example here is:\\n        </p>\\n        <pre><code><span class=\"elem\">&lt;a</span><span class=\"attr\">href</span>=&quot;<span class=\"attrVal\">http://example.com/boats</span>&quot; <span class=\"attr highlight\">rev</span>=&quot;<span class=\"attrVal\">childOf</span>&quot;<span class=\"elem\">&gt;</span><span class=\"text\">The boat we restored</span><span class=\"elem\">&quot;&lt;/a&gt;</span></code></pre>\\n        <p>In this case the meaning of the link is reversed: the author of the html above is a child of the author of <code>http://example.com/boats</code>.</p>\\n      </dd>\\n    </dl>\\n    <p>The HTML and XHTML recommendations require an HTML document to declare a custom profile if it uses any non-standard <code>rel</code> or <code>rev</code> types. This is done by adding a <code>profile</code> attribute with a value of <code>http://purl.org/vocab/relationship/</code> to the document's <code>head</code> element. </p>\\n    <pre><code>  &lt;head profile=&quot;http://purl.org/vocab/relationship/&quot;&gt;\\n    &lt;title&gt;People I Know&lt;/title&gt;\\n  &lt;/head&gt;</code></pre>\\n    <h3>Complete Example</h3>\\n    <pre><code>  &lt;html profile=&quot;http://purl.org/vocab/relationship/&quot;&gt;\\n    &lt;head&gt;\\n      &lt;title&gt;People I Know&lt;/title&gt;\\n    &lt;/head&gt;\\n    &lt;body&gt;\\n      &lt;p&gt;Here are the people I know:&lt;/p&gt;\\n        &lt;ul&gt;\\n          &lt;li&gt;&lt;a href=&quot;http://example.com/~freddy&quot; rel=&quot;closeFriendOf&quot;&gt;Freddy (he's cool!)&lt;/a&gt;&lt;/li&gt;\\n          &lt;li&gt;&lt;a href=&quot;http://frooble.com/&quot; rel=&quot;mentorOf&quot;&gt;Jimbo&lt;/a&gt;&lt;/li&gt;\\n          &lt;li&gt;&lt;a href=&quot;http://mmmm.com/klm&quot; rel=&quot;friendOf&quot;&gt;Katie&lt;/a&gt;&lt;/li&gt;\\n          &lt;li&gt;&lt;a href=&quot;http://example.com/~omah&quot; rel=&quot;worksWith&quot;&gt;Omah (does the coding)&lt;/a&gt;&lt;/li&gt;\\n          &lt;li&gt;&lt;a href=&quot;http://example.com/~jason&quot; rev=&quot;closeFriendOf employedBy&quot;&gt;Jason, my henchman&lt;/a&gt;&lt;/li&gt;\\n        &lt;/ul&gt;\\n      &lt;/body&gt;\\n    &lt;/html&gt;\\n</code></pre>\\n    <h3>RDF Interpretation</h3>\\n    <p>Custom parsers that extract RDF from (X)HTML can use the relationships expressed in the links to infer the\\n  equivilent RDF triples. It should be remembered that the relationship is between the authors of the pages not between\\n  the pages themselves. Given the following link on a document at <code>http://example.com/mypage.html</code>:\\n  </p>\\n    <pre><code><span class=\"elem\">&lt;a</span><span class=\"attr\">href</span>=&quot;<span class=\"attrVal\">http://example.com/boats</span>&quot; <span class=\"attr highlight\">rel</span>=&quot;<span class=\"attrVal\">childOf</span>&quot;<span class=\"elem\">&gt;</span><span class=\"text\">The boat we restored</span><span class=\"elem\">&quot;&lt;/a&gt;</span></code></pre>\\n    <p>a suggested RDF extraction is:</p>\\n    <pre><code>  &lt;foaf:Person&gt;\\n    &lt;foaf:maker rdf:resource=&quot;http://example.com/boats&quot;/&gt;\\n    &lt;rel:childOf&gt;\\n      &lt;foaf:Person&gt;\\n        &lt;foaf:maker rdf:resource=&quot;http://example.com/mypage.html&quot;/&gt;\\n      &lt;/foaf:Person&gt;\\n    &lt;/rel:childOf&gt;\\n  &lt;/foaf:Person&gt;</code></pre>\\n"^^rdf:XMLLiteral .

onto:grandchildOf a rdf:Property ;
    rdfs:label "Grandchild Of",
        "Grandchild Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/grandchildOf> ;
    owl:inverseOf onto:grandparentOf ;
    skos:definition "A person who is a child of any of this person's children."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:grandparentOf a rdf:Property ;
    rdfs:label "Grandparent Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:inverseOf onto:grandchildOf ;
    skos:definition "A person who is the parent of any of this person's parents."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:knowsOf a rdf:Property ;
    rdfs:label "Knows Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom ;
    skos:definition "A person who has come to be known to this person through their actions or position."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Removed assertion that this property is a sub-property of foaf:knows due to reciprocity requirements. It is possible for one to know of another without that person knowing the first." ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Assert that foaf:knows is rdfs:subPropertyOf rel:knowsOf" ] .

onto:mentorOf a rdf:Property ;
    rdfs:label "Mentor Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:inverseOf onto:apprenticeTo ;
    skos:definition "A person who serves as a trusted counselor or teacher to this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

onto:parentOf a rdf:Property ;
    rdfs:label "Parent Of"@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom,
        foaf:knows ;
    owl:equivalentClass <http://www.perceive.net/schemas/relationship/parentOf> ;
    owl:inverseOf onto:childOf ;
    skos:definition "A person who has given birth to or nurtured and raised this person."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that this property is a sub-property of owl:differentFrom, indicating that this is a relationship between different individuals" ] .

<http://vocab.org/relationship/.html> a dcmitype:Text,
        foaf:Document ;
    rdfs:label "HTML" ;
    dc:format "text/html" .

<http://vocab.org/relationship/.json> a dcmitype:Text,
        foaf:Document ;
    rdfs:label "JSON" ;
    dc:format "application/json" .

<http://vocab.org/relationship/.turtle> a dcmitype:Text,
        foaf:Document ;
    rdfs:label "Turtle" ;
    dc:format "text/plain" .

foaf:knows rdfs:subPropertyOf onto:knowsOf .

onto: a owl:Ontology ;
    ns1:discussionList <http://lists.foaf-project.org/mailman/listinfo/foaf-dev> ;
    dc:creator [ a foaf:Person ;
            foaf:name "Eric Vitiello Jr" ],
        <http://iandavis.com/id/me> ;
    dc:description "A vocabulary for describing relationships between people" ;
    dc:identifier "http://purl.org/vocab/relationship/rel-vocab-20050810" ;
    dc:title "RELATIONSHIP: A vocabulary for describing relationships between people" ;
    dcterms:isVersionOf onto: ;
    dcterms:issued "2004-02-11" ;
    dcterms:replaces onto:rel-vocab-20090515 ;
    vann:example <http://purl.org/vocab/relationship/examples/1>,
        <http://purl.org/vocab/relationship/examples/2> ;
    vann:preferredNamespacePrefix "rel" ;
    vann:preferredNamespaceUri "http://purl.org/vocab/relationship" ;
    skos:changeNote [ dc:creator "Ian Davis" ;
            dc:date "2010-04-19" ;
            rdf:value "Inlined the examples that had been orphaned by publishing software changes" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-10" ;
            rdf:value "Added isDefinedBy properties and updated documentation" ] ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Asserted that foaf:knows is rdfs:subPropertyOf rel:knowsOf" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2009-05-15" ;
            rdf:value "Typed vocabulary as owl:Ontology" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2010-02-09" ;
            rdf:value "Incorporated changes suggested by Henry Story on foaf-dev list" ] .

