    rdfs:label "Albino"@en,
        "Freckles"@en,
        "Very Fair"@en,
        "White"@en ;
    rdf:value "I" ;
    skos:equivalent <http://en.wikipedia.org/wiki/Celts_(modern)> ;
    skos:narrower ns4:SkinColorVonLuschan1,
        ns4:SkinColorVonLuschan2,
