@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.linkedmodel.org/schema/vaem#> .
@prefix onto: <http://www.linkedmodel.org/schema/dtype> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.linkedmodel.org/schema/dtype#isInvalid> a owl:DatatypeProperty ;
    rdfs:label "is invalid"^^xsd:string ;
    ns1:comment "A boolean flag to state that a value is invalid with respect to its type."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:range xsd:boolean .

<http://www.linkedmodel.org/schema/dtype#literal> a owl:DatatypeProperty ;
    rdfs:label "literal"^^xsd:string ;
    ns1:comment "A general purpose property for holding string literals."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:range xsd:string .

<http://www.linkedmodel.org/schema/dtype#numericUnion> a rdfs:Datatype ;
    rdfs:label "numeric union"^^xsd:string ;
    dc:description "A datatype that is the union of numeric xsd data types. \"numericUnion\" is equivalent to the xsd specification that uses an xsd:union of memberTypes=\"xsd:decimal xsd:double xsd:float xsd:integer\"."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:subClassOf rdfs:Resource ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:unionOf ( xsd:float xsd:decimal xsd:integer xsd:double ) ] .

<http://www.linkedmodel.org/schema/dtype#type> a owl:ObjectProperty ;
    rdfs:label "datatype"^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: .

<http://www.linkedmodel.org/schema/dtype#Enumeration> a owl:Class ;
    rdfs:label "DTYPE Enumeration"^^xsd:string ;
    ns1:comment "A type that serves as a container for the enumerated values of an enumeration. This enables the enumeration itself to be referenceable. One need for this is in determing the default value of an enumeration , another need is in the management of sub-enumerations and composite enumerations."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://www.linkedmodel.org/schema/dtype#EnumeratedValue> ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#defaultValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.linkedmodel.org/schema/dtype#EnumeratedValue> ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#value> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#defaultValue> ],
        owl:Thing .

<http://www.linkedmodel.org/schema/dtype#ValueReference> a owl:Class ;
    rdfs:label "Value Reference"^^xsd:string ;
    ns1:comment "A value reference is a pointer to an Enumerated Value. The original position of the value can be overridden by the position attribute."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#refersTo> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#position> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.linkedmodel.org/schema/dtype#EnumeratedValue> ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#refersTo> ],
        owl:Thing .

<http://www.linkedmodel.org/schema/dtype#code> a owl:DatatypeProperty ;
    rdfs:label "code"^^xsd:string ;
    ns1:comment "A property for expressing an encoded value. The range has been set to \"xsd:anySimpleType\" to allow for a variety of scalar datatypes."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:range xsd:anySimpleType .

<http://www.linkedmodel.org/schema/dtype#compositeOf> a owl:ObjectProperty ;
    rdfs:label "composite of"^^xsd:string ;
    ns1:comment "Aproperty for constructing composite data structures"^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: .

<http://www.linkedmodel.org/schema/dtype#order> a owl:DatatypeProperty ;
    rdfs:label "order"^^xsd:string ;
    ns1:comment "The property \"dtype:order\" provides a means to specify a precedence. One use of order is in specifying ordered enumerations such as \"voag:ConfidentialityLevel\".  A similar property, but with an important type difference, is \"vaem:orderIndex\". This is for use on property occurrences in class axioms where it can be placed on a restriction to specify how that property may be transformed into other representations where ordering has some importance, for example, in XML Schema sequences.  Whereas \"vaem:order\" is a datatype property, \"vaem:orderIndex\" is an annotation property."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso <http://www.linkedmodel.org/schema/dtype#orderIndex> .

<http://www.linkedmodel.org/schema/dtype#orderIndex> a owl:AnnotationProperty ;
    rdfs:label "order index"^^xsd:string ;
    ns1:comment "The property \"dtype:orderIndex\" is an annotation property to specify a position that some value or structure will have. One use is to specify the place that a resource has in a sequence. One use is on property occurrences in class axioms. Here \"vaem:orderIndex\" is placed on a restriction to specify how that property may be transformed into a representation where ordering has some importance, for example, in XML Schema sequences."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:range xsd:nonNegativeInteger .

<http://www.linkedmodel.org/schema/dtype#CompositeCodeList> a owl:Class ;
    rdfs:label "Composite Code List"^^xsd:string ;
    ns1:comment "A composite codelist is a codelist made up of other codelists. It does not introduce any new codes."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://www.linkedmodel.org/schema/dtype#CodeList> ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#compositeOf> ],
        <http://www.linkedmodel.org/schema/dtype#CodeList> ;
    owl:disjointWith <http://www.linkedmodel.org/schema/dtype#DerivedCodeList>,
        <http://www.linkedmodel.org/schema/dtype#SimpleCodeList> .

<http://www.linkedmodel.org/schema/dtype#DerivedCodeList> a owl:Class ;
    rdfs:label "Derived Code List"^^xsd:string ;
    ns1:comment "A derived codelist is a sublist of another codelist. The members that it has must be members of the source list."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://www.linkedmodel.org/schema/dtype#ValueReference> ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#hasMember> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.linkedmodel.org/schema/dtype#CodeList> ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#derivedFrom> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#derivedFrom> ],
        <http://www.linkedmodel.org/schema/dtype#CodeList> ;
    owl:disjointWith <http://www.linkedmodel.org/schema/dtype#CompositeCodeList>,
        <http://www.linkedmodel.org/schema/dtype#SimpleCodeList> .

<http://www.linkedmodel.org/schema/dtype#SimpleCodeList> a owl:Class ;
    rdfs:label "Simple Code List"^^xsd:string ;
    ns1:comment "A simple codelist is one made up only of enumerated values."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://www.linkedmodel.org/schema/dtype#EnumeratedValue> ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#hasMember> ],
        <http://www.linkedmodel.org/schema/dtype#CodeList> ;
    owl:disjointWith <http://www.linkedmodel.org/schema/dtype#CompositeCodeList>,
        <http://www.linkedmodel.org/schema/dtype#DerivedCodeList> .

<http://www.linkedmodel.org/schema/dtype#defaultValue> a rdf:Property ;
    rdfs:label "default value"^^xsd:string ;
    ns1:comment "The property \"dtype:defaultValue\" is a general property for specifying a value in situations where none is specified, or can be determined. In some cases of use, this property could have a scalar value and in other cases may need to refer to a first class concept that holds a \"value object\".  For this reason, the  type of this property is set as \"rdf:Property\" and the property is rangeless."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: .

<http://www.linkedmodel.org/schema/dtype#derivedFrom> a owl:ObjectProperty ;
    rdfs:label "derived from"^^xsd:string ;
    ns1:comment "A property for specifying a derivation relationship."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: .

<http://www.linkedmodel.org/schema/dtype#hasMember> a owl:ObjectProperty ;
    rdfs:label "has member"^^xsd:string ;
    ns1:comment "A property for specifying how member elements make up a data structure."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: .

<http://www.linkedmodel.org/schema/dtype#position> a owl:DatatypeProperty ;
    rdfs:label "position"^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:range xsd:nonNegativeInteger .

<http://www.linkedmodel.org/schema/dtype#refersTo> a owl:ObjectProperty ;
    rdfs:label "refers to"^^xsd:string ;
    ns1:comment "An indirection pointer for relating a slot in am occurrence data structure, such as \"dtype:ValueReference\" with another resource."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: .

<http://www.linkedmodel.org/schema/dtype#value> a rdf:Property ;
    rdfs:label "value"^^xsd:string ;
    ns1:comment "The property \"dtype:value\" is a general property that in some cases could have scalar values and in other cases may refer to a first class concept that is a \"value object\". For this reason, the  type of this property is set as \"rdf:Property\" and the property is rangeless."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: .

<http://www.linkedmodel.org/schema/dtype#EnumeratedValue> a owl:Class ;
    rdfs:label "DTYPE Enumerated value"^^xsd:string ;
    dc:description "The base class for datatypes that have values that are restriced to a set of literals or tokens. The members of the restriction may themselve be restriced by facets that apply to scalar data types."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:url ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#position> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#code> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#order> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.linkedmodel.org/schema/dtype#value> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:name ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:description ],
        owl:Thing .

<http://www.linkedmodel.org/schema/dtype#CodeList> a owl:Class ;
    rdfs:label "Codelist"^^xsd:string ;
    ns1:comment "A codelist is a controlled vocabulary of terms that are used to represent permissible values of a variable in information systems. The representaiton of codes in \"dtype\" has been influenced by CCTS and UBL."^^xsd:string ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
        onto: ;
    rdfs:subClassOf <http://www.linkedmodel.org/schema/dtype#Enumeration> .

onto: a owl:Ontology ;
    owl:imports <http://www.linkedmodel.org/schema/vaem> .

<http://www.linkedmodel.org/1.1/schema/dtype> rdfs:label "Datatype Ontology"^^xsd:string ;
    dc:author "Ralph Hodgson"^^xsd:string ;
    dc:subject "Datatype schema"^^xsd:string ;
    dc:title "Datatype Ontology"^^xsd:string ;
    ns1:dateCreated "2011-05-29"^^ns1:dateUnion ;
    ns1:description "The ontology \"dtype\" provides a specification of simple data types such as enumerations and codelists. These are needed in support of the conversion of XML Schemas and UML Models to OWL. The purpose of \"dtype\" is to provide a foundation for expressing rich data types. These data types are typically needed when dealing with OWL representations of data structures derived from XML Schema."^^xsd:string ;
    ns1:hasGraphRole ns1:SchemaGraph ;
    ns1:hasLicenseType <http://voag.linkedmodel.org/voag#CC-SHAREALIKE_3PT0-US> ;
    ns1:lastUpdated "2014-06-28"^^ns1:dateUnion ;
    ns1:name "DTYPE"^^xsd:string ;
    ns1:namespace "http://www.linkedmodel.org/schema/dtype"^^xsd:anyURI ;
    ns1:namespacePrefix "dtype"^^xsd:string ;
    ns1:owner "TopQuadrant"^^xsd:string ;
    ns1:revision "1.1"^^xsd:string ;
    ns1:usesNonImportedResource dc:author,
        dc:contributor,
        dc:description,
        dc:subject,
        dc:title ;
    ns1:withAttributionTo <http://voag.linkedmodel.org/voag#TopQuadrantAttribution> ;
    owl:versionIRI <http://www.linkedmodel.org/1.1/schema/dtype> ;
    owl:versionInfo "Created with TopBraid Composer"^^xsd:string .

