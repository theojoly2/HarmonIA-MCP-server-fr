@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://rdf-vocabulary.ddialliance.org/discovery> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://rdf-vocabulary.ddialliance.org/discovery#AnalysisUnit> a rdfs:Class,
        owl:Class ;
    rdfs:label "Analysis Unit"@en ;
    rdfs:comment "The process collecting data is focusing on the analysis of a particular type of subject. If, for example, the adult population of Finland is being studied, the AnalysisUnit would be individuals or persons."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf skos:Concept .

<http://rdf-vocabulary.ddialliance.org/discovery#CategoryStatistics> a rdfs:Class,
        owl:Class ;
    rdfs:label "Category statistics"@en ;
    rdfs:comment "For CategoryStatistics, frequencies, percentages, and weighted percentages can be defined."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf-vocabulary.ddialliance.org/discovery#DescriptiveStatistics> .

<http://rdf-vocabulary.ddialliance.org/discovery#DataFile> a rdfs:Class,
        owl:Class ;
    rdfs:label "Data file"@en,
        "Fichier de données"@fr ;
    rdfs:comment "The class DataFile, which is also a dcterms:Dataset, represents all the data files containing the microdata datasets."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf dcat:Distribution .

<http://rdf-vocabulary.ddialliance.org/discovery#DescriptiveStatistics> a rdfs:Class,
        owl:Class ;
    rdfs:label "Descriptive statistics"@en,
        "Statistique descriptive"@fr ;
    rdfs:comment "SummaryStatistics pointing to variables and CategoryStatistics pointing to categories and codes are both DescriptiveStatistics."@en ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/discovery#Instrument> a rdfs:Class,
        owl:Class ;
    rdfs:label "Instrument"@en,
        "Instrument de collecte"@fr ;
    rdfs:comment "The data for the study are collected by an Instrument. The purpose of an Instrument, i.e. an interview, a questionnaire or another entity used as a means of data collection, is in the case of a survey to record the flow of a questionnaire, its use of questions, and additional component parts. A questionnaire contains a flow of questions."@en ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/discovery#LogicalDataSet> a rdfs:Class,
        owl:Class ;
    rdfs:label "LogicalDataSet"@en,
        "Ensemble de données"@fr ;
    rdfs:comment "Each study has a set of logical metadata associated with the processing of data, at the time of collection or later during cleaning, and re-coding. LogicalDataSet represents the microdata dataset."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf dcat:Dataset .

<http://rdf-vocabulary.ddialliance.org/discovery#Mapping> a rdfs:Class,
        owl:Class ;
    rdfs:label "Mapping"@en ;
    rdfs:comment "Mappings betwenn DDI-RDF and DDI-XML"@en ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/discovery#Question> a rdfs:Class,
        owl:Class ;
    rdfs:label "Question"@en,
        "Question"@fr ;
    rdfs:comment "A Question is designed to get information upon a subject, or sequence of subjects, from a respondent."@en ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/discovery#Questionnaire> a rdfs:Class,
        owl:Class ;
    rdfs:label "Questionnaire"@en ;
    rdfs:comment "A questionnaire contains a flow of questions. "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf-vocabulary.ddialliance.org/discovery#Instrument> .

<http://rdf-vocabulary.ddialliance.org/discovery#RepresentedVariable> a rdfs:Class,
        owl:Class ;
    rdfs:label "Data element"@en,
        "Élément de donnée"@fr ;
    rdfs:comment "RepresentedVariables encompasse study-independent, re-usable parts of variables like occupation classification."@en ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/discovery#Study> a rdfs:Class,
        owl:Class ;
    rdfs:label "Study"@en,
        "Étude"@fr ;
    rdfs:comment "A Study represents the process by which a data set was generated or collected."@en ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/discovery#StudyGroup> a rdfs:Class,
        owl:Class ;
    rdfs:label "Study Group"@en ;
    rdfs:comment "In some cases, where data collection is cyclic or on-going, data sets may be released as a StudyGroup, where each cycle or wave of the data collection activity produces one or more data sets. This is typical for longitudinal studies, panel studies, and other types of series (to use the DDI term). In this case, a number of Study objects would be collected into a single StudyGroup."@en ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/discovery#SummaryStatistics> a rdfs:Class,
        owl:Class ;
    rdfs:label "Summary statistics"@en ;
    rdfs:comment "For SummaryStatistics, maximum values, minimum values, and standard deviations can be defined."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf-vocabulary.ddialliance.org/discovery#DescriptiveStatistics> .

<http://rdf-vocabulary.ddialliance.org/discovery#Universe> a rdfs:Class,
        owl:Class ;
    rdfs:label "Universe"@en,
        "Univers"@fr ;
    rdfs:comment "A Universe is the total membership or population of a defined class of people, objects or events."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf skos:Concept .

<http://rdf-vocabulary.ddialliance.org/discovery#Variable> a rdfs:Class,
        owl:Class ;
    rdfs:label "Variable"@en,
        "Variable"@fr ;
    rdfs:comment "Variables provide a definition of the column in a rectangular data file. Variable is a characteristic of a unit being observed. A variable might be the answer of a question, have an administrative source, or be derived from other variables."@en ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/discovery#aggregation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "aggregation"@en ;
    rdfs:comment "points to the aggregated data set of a microdata data set."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#LogicalDataSet> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range qb:DataSet .

<http://rdf-vocabulary.ddialliance.org/discovery#analysisUnit> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "analysis unit"@en ;
    rdfs:comment "analysis unit of a Study, a StudyGroup, or a Variable."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Study> <http://rdf-vocabulary.ddialliance.org/discovery#StudyGroup> <http://rdf-vocabulary.ddialliance.org/discovery#Variable> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#AnalysisUnit> .

<http://rdf-vocabulary.ddialliance.org/discovery#basedOn> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "based on"@en,
        "utilise l'élément de donnée"@fr ;
    rdfs:comment "points to the RepresentedVariable the Variable is based on."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Variable> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#RepresentedVariable> .

<http://rdf-vocabulary.ddialliance.org/discovery#caseQuantity> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "number of cases"@en,
        "nombre d'observations"@fr ;
    rdfs:comment "case quantity of a DataFile."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#DataFile> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:nonNegativeInteger .

<http://rdf-vocabulary.ddialliance.org/discovery#collectionMode> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "collection mode"@en ;
    rdfs:comment "mode of collection of a Questionnaire"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Questionnaire> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/discovery#computationBase> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "computation base"@en,
        "pourcentage"@fr ;
    rdfs:comment "computation base"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#CategoryStatistics> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString .

<http://rdf-vocabulary.ddialliance.org/discovery#concept> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "concept"@en,
        "a pour concept"@fr ;
    rdfs:comment "points to the DDI concept of a RepresentedVariable, a Variable, or a Question"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#RepresentedVariable> <http://rdf-vocabulary.ddialliance.org/discovery#Question> <http://rdf-vocabulary.ddialliance.org/discovery#Variable> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/discovery#containsVariable> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "contains variable"@en,
        "contient la variable"@fr ;
    rdfs:comment "points to Variable contained in the LogicalDataSet"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#LogicalDataSet> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#Variable> .

<http://rdf-vocabulary.ddialliance.org/discovery#context> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "context specifies conditions which have to be fulfilled for specific mappings"@en ;
    rdfs:comment "context specifies conditions which have to be fulfilled for specific mappings"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Mapping> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString .

<http://rdf-vocabulary.ddialliance.org/discovery#cumulativePercentage> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "cumulative percentage"@en ;
    rdfs:comment "cumulative percentage"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#CategoryStatistics> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal .

<http://rdf-vocabulary.ddialliance.org/discovery#dataFile> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "data file"@en,
        "a pour fichier de données"@fr ;
    rdfs:comment "points to the DataFile of a Study or a LogicalDataSet."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Study> <http://rdf-vocabulary.ddialliance.org/discovery#LogicalDataSet> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#DataFile> .

<http://rdf-vocabulary.ddialliance.org/discovery#ddifile> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "DDI file"@en ;
    rdfs:comment "points from a Study or a StudyGroup to the original DDI file which is a foaf:Document."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Study> <http://rdf-vocabulary.ddialliance.org/discovery#StudyGroup> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Document .

<http://rdf-vocabulary.ddialliance.org/discovery#endDate> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "end date"@en ;
    rdfs:comment "end date"@en ;
    rdfs:domain dcterms:PeriodOfTime ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:date .

<http://rdf-vocabulary.ddialliance.org/discovery#externalDocumentation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "external documentation"@en ;
    rdfs:comment "points from an Instrument to a foaf:Document which is the external documentation of the Instrument."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Instrument> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Document .

<http://rdf-vocabulary.ddialliance.org/discovery#frequency> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "frequency"@en,
        "fréquence"@fr ;
    rdfs:comment "frequency"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#CategoryStatistics> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:nonNegativeInteger .

<http://rdf-vocabulary.ddialliance.org/discovery#fundedBy> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "funded by"@en ;
    rdfs:comment "points from a Study or a StudyGroup to the funding foaf:Agent which is either a foaf:Person or a org:Organization."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Study> <http://rdf-vocabulary.ddialliance.org/discovery#StudyGroup> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf dcterms:contributor .

<http://rdf-vocabulary.ddialliance.org/discovery#inGroup> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "in group"@en ;
    rdfs:comment "points from a Study to the StudyGroup which contains the Study."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Study> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#StudyGroup> .

<http://rdf-vocabulary.ddialliance.org/discovery#inputVariable> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "input variable"@en,
        "variable en entrée"@fr ;
    rdfs:comment "Indicates the original Variable of an aggregated qb:DataSet."@en ;
    rdfs:domain qb:DataSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#Variable> .

<http://rdf-vocabulary.ddialliance.org/discovery#instrument> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "instrument"@en,
        "a comme instrument"@fr ;
    rdfs:comment "Indicates the Instrument of a Study or a LogicalDataSet."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Study> <http://rdf-vocabulary.ddialliance.org/discovery#LogicalDataSet> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#Instrument> .

<http://rdf-vocabulary.ddialliance.org/discovery#isPublic> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "is public"@en ;
    rdfs:comment "The value true indicates that the dataset can be accessed (usually downloaded) by anyone."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#LogicalDataSet> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://rdf-vocabulary.ddialliance.org/discovery#isValid> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "is valid"@en ;
    rdfs:comment "Indicates if the code (represented by skos:Concept) is valid or missing."@en ;
    rdfs:domain skos:Concept ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://rdf-vocabulary.ddialliance.org/discovery#kindOfData> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "kind of data"@en ;
    rdfs:comment "The general kind of data (e.g. geospatial, register, survey) collected in this study, given either as a skos:Concept, or as a blank node with attached free-text rdfs:label." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Study> <http://rdf-vocabulary.ddialliance.org/discovery#StudyGroup> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/discovery#mappingDDI-C> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Mapping from and to DDI-C"@en ;
    rdfs:comment "Mapping from and to DDI-C"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Mapping> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString .

<http://rdf-vocabulary.ddialliance.org/discovery#mappingDDI-L> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Mapping from and to DDI-L"@en ;
    rdfs:comment "Mapping from and to DDI-L"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Mapping> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString .

<http://rdf-vocabulary.ddialliance.org/discovery#percentage> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "percentage"@en,
        "pourcentage"@fr ;
    rdfs:comment "percentage"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#CategoryStatistics> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal .

<http://rdf-vocabulary.ddialliance.org/discovery#product> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "product"@en ;
    rdfs:comment "Indicates the LogicalDataSets of a Studies."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Study> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range qb:LogicalDataSet .

<http://rdf-vocabulary.ddialliance.org/discovery#purpose> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "purpose"@en ;
    rdfs:comment "The purpose of a Study of a StudyGroup."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Study> <http://rdf-vocabulary.ddialliance.org/discovery#StudyGroup> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString .

<http://rdf-vocabulary.ddialliance.org/discovery#question> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "question"@en,
        "a comme question"@fr ;
    rdfs:comment "Indicates the Questions associated to Variables or contained in Questionnaires."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Variable> <http://rdf-vocabulary.ddialliance.org/discovery#Questionnaire> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#Question> .

<http://rdf-vocabulary.ddialliance.org/discovery#questionText> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "question text"@en ;
    rdfs:comment "question text"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Question> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString .

<http://rdf-vocabulary.ddialliance.org/discovery#representation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "representation"@en,
        "a pour représentation"@fr ;
    rdfs:comment "RepresentedVariables and Variables can have a Representation whose individuals are either of the class rdfs:Datatype (to represent values) or skos:ConceptScheme (to represent code lists)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#RepresentedVariable> <http://rdf-vocabulary.ddialliance.org/discovery#Variable> <http://rdf-vocabulary.ddialliance.org/discovery#Question> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( skos:ConceptScheme rdfs:Datatype ) ] .

<http://rdf-vocabulary.ddialliance.org/discovery#responseDomain> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "responseDomain"@en ;
    rdfs:comment "The response domain of questions."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Question> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#Representation> .

<http://rdf-vocabulary.ddialliance.org/discovery#startDate> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "start date"@en ;
    rdfs:comment "start date"@en ;
    rdfs:domain dcterms:PeriodOfTime ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:date .

<http://rdf-vocabulary.ddialliance.org/discovery#statisticsCategory> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "statistics category"@en,
        "a pour concept statistique"@fr ;
    rdfs:comment "Indicates the skos:Concept (representing codes and categories) of a specific CategoryStatistics individual."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#CategoryStatistics> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/discovery#statisticsDataFile> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "statistics data file"@en,
        "a pour fichier statistique"@fr ;
    rdfs:comment "Indicates the DataFile of a specific DesciptiveStatistics individual."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#DescriptiveStatistics> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#DataFile> .

<http://rdf-vocabulary.ddialliance.org/discovery#statisticsVariable> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "statistics variable"@en,
        "a pour variable statistique"@fr ;
    rdfs:comment "Indicates the Variable of a specific SummaryStatistics individual."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#SummaryStatistics> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#Variable> .

<http://rdf-vocabulary.ddialliance.org/discovery#subtitle> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "subtitle"@en ;
    rdfs:comment "The sub-title of a Study of a StudyGroup."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Study> <http://rdf-vocabulary.ddialliance.org/discovery#StudyGroup> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString .

<http://rdf-vocabulary.ddialliance.org/discovery#summaryStatisticsType> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "summary statistics type"@en ;
    rdfs:comment "summary statistics type"@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#SummaryStatistics> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/discovery#universe> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "universe"@en,
        "a comme univers"@fr ;
    rdfs:comment "Indicates the Universe(s) of Studies, StudyGrous, RepresentedVariables, Variables, Questions, and LogicalDataSets."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#Study> <http://rdf-vocabulary.ddialliance.org/discovery#StudyGroup> <http://rdf-vocabulary.ddialliance.org/discovery#RepresentedVariable> <http://rdf-vocabulary.ddialliance.org/discovery#Variable> <http://rdf-vocabulary.ddialliance.org/discovery#Question> <http://rdf-vocabulary.ddialliance.org/discovery#LogicalDataSet> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#Universe> .

<http://rdf-vocabulary.ddialliance.org/discovery#variable> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "variable"@en ;
    rdfs:comment "Indicates the Variable of a Study."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/discovery#Study> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#Variable> .

<http://rdf-vocabulary.ddialliance.org/discovery#weightedBy> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "weighted by"@en,
        ""@fr ;
    rdfs:comment "SummaryStatistics or CategoryStatistics resources may be weighted by a specific Variable."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://rdf-vocabulary.ddialliance.org/discovery#SummaryStatistics> <http://rdf-vocabulary.ddialliance.org/discovery#CategoryStatistics> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/discovery#Variable> .

