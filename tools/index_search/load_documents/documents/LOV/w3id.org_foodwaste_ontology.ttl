    rdfs:label "Allergens" ;
    rdfs:comment "An enumeration of substances that may cause allergic reactions." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns2:Crustacean_shellfish ns2:Eggs ns2:Fish ns2:Milk ns2:Sesame ns2:Soybeans ns2:Tree_Nuts ns2:Wheat ) ] .

