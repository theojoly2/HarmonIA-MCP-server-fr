    rdfs:comment "v1.0" .

ns3: rdfs:label "geo" ;
    dc:date "$Date: 2009/04/20 15:00:30 $" ;
    dc:description "A vocabulary for representing latitude, longitude and \\n altitude information in the WGS84 geodetic reference datum. \\n Version $Id: wgs84_pos.rdf,v 1.22 2009/04/20 15:00:30 timbl Exp $. See http://www.w3.org/2003/01/geo/ for more details." ;
    dc:title "WGS84 Geo Positioning: an RDF vocabulary" ;
    rdfs:comment "\\nRecent changes to this namespace:\\n$Log: wgs84_pos.rdf,v $\\nRevision 1.22  2009/04/20 15:00:30  timbl\\nRemove the time bits which have been deal with elsewhere eg in iCal.\\n\\nRevision 1.21  2009/04/20 12:52:47  timbl\\ntry again\\n\\nRevision 1.20  2009/04/20 12:42:11  timbl\\nAdd Event (edited ages ago and never checked in), and location (following discussion http://chatlogs.planetrdf.com/swig/2009-04-20#T12-36-09)\\n\\nRevision 1.19  2009/04/20 12:36:31  timbl\\nAdd Event (edited ages ago and never checked in), and location (following discussion http://chatlogs.planetrdf.com/swig/2009-04-20#T12-36-09)\\n\\nRevision 1.18  2006/02/01 22:01:04  danbri\\nClarified that lat and long are decimal degrees, and that alt is decimal metres about local reference ellipsoid\\n\\nRevision 1.17  2004/02/06 17:38:12  danbri\\nFixed a bad commit screwup\\n\\nRevision 1.15  2003/04/19 11:24:08  danbri\\nFixed the typo even more.\\n\\nRevision 1.14  2003/04/19 11:16:56  danbri\\nfixed a typo\\n\\nRevision 1.13  2003/02/19 22:27:27  connolly\\nrelaxed domain constraints on lat/long/alt from Point to SpatialThing\\n\\nRevision 1.12  2003/01/12 01:41:41  danbri\\nTrying local copy of XSLT doc.\\n\\nRevision 1.11  2003/01/12 01:20:18  danbri\\nadded a link to morten's xslt rdfs viewer.\\n\\nRevision 1.10  2003/01/11 18:56:49  danbri\\nRemoved datatype range from lat and long properties, since they would\\nhave required each occurance of the property to mention the datatype.\\n\\nRevision 1.9  2003/01/11 11:41:31  danbri\\nAnother typo; repaired rdfs:Property to rdf:Property x4\\n\\nRevision 1.8  2003/01/11 11:05:02  danbri\\nAdded an rdfs:range for each lat/long/alt property,\\nhttp://www.w3.org/2001/XMLSchema#float\\n\\nRevision 1.7  2003/01/10 20:25:16  danbri\\nLonger rdfs:comment for Point, trying to be Earth-centric and neutral about\\ncoordinate system(s) at the same time. Feedback welcomed.\\n\\nRevision 1.6  2003/01/10 20:18:30  danbri\\nAdded CVS log comments into the RDF/XML as an rdfs:comment property of the\\nvocabulary. Note that this is not common practice (but seems both harmless\\nand potentially useful).\\n\\n\\nrevision 1.5\\ndate: 2003/01/10 20:14:31;  author: danbri;  state: Exp;  lines: +16 -5\\nUpdated schema:\\nAdded a dc:date, added url for more info. Changed the rdfs:label of the\\nnamespace from gp to geo. Added a class Point, set as the rdfs:domain of\\neach property. Added XML comment on the lat_long property suggesting that\\nwe might not need it (based on #rdfig commentary from implementors).\\n\\nrevision 1.4\\ndate: 2003/01/10 20:01:07;  author: danbri;  state: Exp;  lines: +6 -5\\nFixed typo; several rdfs:about attributes are now rdf:about. Thanks to MortenF in\\n#rdfig for catching this error.\\n\\nrevision 1.3\\ndate: 2003/01/10 11:59:03;  author: danbri;  state: Exp;  lines: +4 -3\\nfixed buglet in vocab, added more wgs links\\n\\nrevision 1.2\\ndate: 2003/01/10 11:01:11;  author: danbri;  state: Exp;  lines: +4 -4\\nRemoved alt from the as-a-flat-string property, and switched from\\nspace separated to comma separated.\\n\\nrevision 1.1\\ndate: 2003/01/10 10:53:23;  author: danbri;  state: Exp;\\nbasic geo vocab\\n\\n" .

ns3:Point a owl:Class ;
    rdfs:label "point" ;
    rdfs:comment " \\nUniquely identified by lat/long/alt. i.e.\\n\\nspaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),\\n  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).\\n\\nsameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).\\n  ",
        "A point, typically described using a coordinate system relative to Earth, such as WGS84.\\n  " ;
    rdfs:subClassOf ns3:SpatialThing .

ns3:alt a owl:AnnotationProperty ;
    rdfs:label "altitude" ;
    rdfs:comment "The WGS84 altitude of a SpatialThing (decimal meters \\nabove the local reference ellipsoid)." ;
    rdfs:domain ns3:SpatialThing .

ns3:lat a owl:AnnotationProperty ;
    rdfs:label "latitude" ;
    rdfs:comment "The WGS84 latitude of a SpatialThing (decimal degrees)." ;
    rdfs:domain ns3:SpatialThing .

ns3:lat_long rdfs:label "lat/long" ;
    rdfs:comment "A comma-separated representation of a latitude, longitude coordinate." .

ns3:location a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "location" ;
    rdfs:comment "The relation between something and the point, \\n or other geometrical thing in space, where it is.  For example, the realtionship between\\n a radio tower and a Point with a given lat and long.\\n Or a relationship between a park and its outline as a closed arc of points, or a road and\\n its location as a arc (a sequence of points).\\n Clearly in practice there will be limit to the accuracy of any such statement, but one would expect\\n an accuracy appropriate for the size of the object and uses such as mapping .\\n " ;
    rdfs:range ns3:SpatialThing ;
    rdfs:subPropertyOf foaf:based_near .

ns3:long a owl:AnnotationProperty ;
    rdfs:label "longitude" ;
    rdfs:comment "The WGS84 longitude of a SpatialThing (decimal degrees)." ;
    rdfs:domain ns3:SpatialThing .

skos:note a owl:AnnotationProperty .

foaf:logo a owl:AnnotationProperty .

schema:includedInDataCatalog a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dc:creator "Shivam Ganguly" ;
    dc:description "An ontology to model food donation logistics."@en ;
    dc:title "Food Wastage Ontology"@en ;
    dcterms:bibliographicCitation "http://purl.org/dc/elements/1.1/"^^rdfs:Literal ;
    dcterms:created "2025-05-16"^^rdfs:Literal ;
    dcterms:identifier "https://w3id.org/foodwaste/ontology"^^rdfs:Literal ;
    dcterms:issued "2025-06-16"^^rdfs:Literal ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher "Shivam Ganguly" ;
    dcterms:source <https://github.com/MonarchRyuzaki/FoodWastageOntology> ;
    dcterms:status "draft"@en ;
    ns1:doi "10.5281/zenodo.16788052" ;
    vann:preferredNamespacePrefix "fwo" ;
    vann:preferredNamespaceUri "https://w3id.org/foodwaste/ontology#" ;
    owl:imports vann:,
        <http://www.w3.org/ns/prov-o-inverses-20130430> ;
    owl:versionIRI <https://w3id.org/foodwaste/ontology/v1> ;
    owl:versionInfo "v1.0" ;
    prov:wasGeneratedBy "Protégé"@en ;
    foaf:logo <https://raw.githubusercontent.com/MonarchRyuzaki/FoodWastageFrontend/refs/heads/master/public/logo.svg> ;
    schema:includedInDataCatalog <https://github.com/MonarchRyuzaki/FoodWastageOntology> .

ns2:6832c9d165d2ec4756cab2ed_Donor a owl:NamedIndividual,
        ns2:Donor .

ns2:6841464540dd1a066f42dc98_Donor a owl:NamedIndividual,
        ns2:Donor .

ns2:AtRiskDonation a owl:Class ;
    rdfs:label "At‑Risk Donation" ;
    rdfs:comment "A food donation that is nearing its expiry and should be prioritized." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns2:FoodDonation [ a owl:Restriction ;
                        owl:hasValue ns2:High ;
                        owl:onProperty ns2:hasPriority ] ) ] .

ns2:ClaimedDonation a owl:Class ;
    rdfs:label "Claimed Donation" ;
    rdfs:comment "A food donation that has been claimed by a recipient." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns2:Claimed ;
            owl:onProperty ns2:hasDonationStatus ],
        ns2:FoodDonation .

ns2:Donor1 a owl:NamedIndividual,
        ns2:Donor .

ns2:Donor10 a owl:NamedIndividual .

ns2:Donor_xyzq a owl:NamedIndividual,
        ns2:Donor .

ns2:NGO1 a owl:NamedIndividual,
        ns2:NGO .

ns2:NGO2 a owl:NamedIndividual,
        ns2:NGO ;
    ns2:prefersFoodType ns2:Meat .

ns2:Peanuts a owl:NamedIndividual .

ns2:PreferredDonation a owl:Class ;
    rdfs:label "Preferred Donation" ;
    rdfs:comment "A donation marked as preferred by a user based on their preferences." ;
    rdfs:subClassOf ns2:FoodDonation .

ns2:TrustedDonation a owl:Class ;
    rdfs:label "Trusted Donation" ;
    rdfs:comment "A donation from a source flagged as trusted." ;
    rdfs:subClassOf ns2:FoodDonation .

ns2:UrgentDonation a owl:Class ;
    rdfs:label "Urgent Donation" ;
    rdfs:comment "A donation requiring immediate pickup or distribution" ;
    rdfs:subClassOf ns2:FoodDonation .

ns2:abc123 a owl:NamedIndividual,
        ns2:NGO ;
    ns2:avoidsAllergen ns2:Gluten,
        ns2:Peanut ;
    ns2:prefersFoodType ns2:Fruit,
        ns2:Meat ;
    ns2:rejectsFoodType ns2:Dairy .

ns2:abc1234 a owl:NamedIndividual,
        ns2:NGO ;
    ns3:lat 12.9816 ;
    ns3:long 77.6946 ;
    ns2:avoidsAllergen ns2:Gluten,
        ns2:Peanut ;
    ns2:prefersFoodType ns2:Fruit,
        ns2:Meat ;
    ns2:rejectsFoodType ns2:Dairy .

ns2:abc123_Location a owl:NamedIndividual .

ns2:claimedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "claimed by" ;
    rdfs:comment "Indicates the user who has claimed this donation." ;
    rdfs:domain ns2:FoodDonation ;
    rdfs:range ns2:NGO .

ns2:don12345_Location a owl:NamedIndividual .

ns2:donatedBy a owl:ObjectProperty ;
    rdfs:label "donated by" ;
    rdfs:comment "Indicates the user or farmer who made this donation." ;
    rdfs:domain ns2:FoodDonation ;
    rdfs:range ns2:Donor ;
    owl:inverseOf ns2:hasDonated .

ns2:donor456_Donor a owl:NamedIndividual,
        ns2:Donor .

ns2:hasExpiryDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has expiry date"@en ;
    rdfs:comment "Denotes the expiration date of a donated food item" ;
    rdfs:domain ns2:FoodDonation ;
    rdfs:range xsd:dateTime .

ns2:hasHigherPriorityThan a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has higher priority than" ;
    rdfs:comment "Indicates that one priority level is higher than another." ;
    rdfs:domain ns2:Priority ;
    rdfs:range ns2:Priority ;
    owl:inverseOf ns2:hasLowerPriorityThan .

ns2:hasParentType a owl:ObjectProperty ;
    rdfs:label "has parent type" ;
    rdfs:comment "Relates a food type to its more general parent category." ;
    rdfs:domain ns2:FoodType ;
    rdfs:range ns2:FoodType .

ns2:isPreferredBy a owl:ObjectProperty ;
    rdfs:label "is preferred by" ;
    rdfs:comment "Indicates that a donation is preferred by a particular user." ;
    owl:inverseOf ns2:prefersFoodType .

ns2:isRejectedBy a owl:ObjectProperty ;
    rdfs:label "is rejected by" ;
    rdfs:comment "Indicates that a donation type has been rejected by a particular user." ;
    owl:inverseOf ns2:rejectsFoodType .

ns2:xyz1234 a owl:NamedIndividual,
        ns2:Donor ;
    ns3:lat 12.9716 ;
    ns3:long 77.5946 .

ns2:xyzq_Donor a owl:NamedIndividual,
        ns2:Donor .

