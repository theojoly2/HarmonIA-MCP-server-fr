    rdfs:label "Priority" ;
    rdfs:comment "An ordered enumeration indicating the urgency or importance of a donation." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns2:High ns2:Low ns2:Medium ) ] .

