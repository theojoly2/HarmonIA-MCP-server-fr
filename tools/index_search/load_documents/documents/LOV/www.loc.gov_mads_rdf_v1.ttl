@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.loc.gov/mads/rdf/v1#Area> a owl:Class ;
    rdfs:label "Area Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is a non-jurisdictional geographic entity."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#City> a owl:Class ;
    rdfs:label "City Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is an inhabited place incorporated as a city, town, etc."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#CitySection> a owl:Class ;
    rdfs:label "City Section Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is a smaller unit within a populated place, e.g., a neighborhood, park, or\\n      street."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#ConferenceName> a owl:Class ;
    rdfs:label "Conference Name Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label represents a conference name."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Name> .

<http://www.loc.gov/mads/rdf/v1#Continent> a owl:Class ;
    rdfs:label "Continent Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is one of seven large landmasses on Earth. These are: Asia, Africa, Europe, North\\n      America, South America, Australia, and Antarctica."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#Country> a owl:Class ;
    rdfs:label "Country Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is a country, i.e. a political entity considered a country. "^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#County> a owl:Class ;
    rdfs:label "County Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is the largest local administrative unit, e.g. Warwickshire, in a country, e.g.\\n      England."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#DateNameElement> a owl:Class ;
    rdfs:label "Date Name\\n      Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#NameElement> .

<http://www.loc.gov/mads/rdf/v1#ExtraterrestrialArea> a owl:Class ;
    rdfs:label "Extraterrestrial Area Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is any extraterrestrial entity or space, including a solar system, a galaxy, a star\\n      system, and a planet, including a geographic feature of an individual planet."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#FamilyName> a owl:Class ;
    rdfs:label "Family Name Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label represents a family name."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Name> .

<http://www.loc.gov/mads/rdf/v1#FamilyNameElement> a owl:Class ;
    rdfs:label "Family Name\\n      Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#NameElement> .

<http://www.loc.gov/mads/rdf/v1#FullNameElement> a owl:Class ;
    rdfs:label "Fullname Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#NameElement> .

<http://www.loc.gov/mads/rdf/v1#GenreForm> a owl:Class ;
    rdfs:label "Genre/Form Type"@en ;
    rdfs:comment "Describes a resource whose label is a genre or form term. Genre\\n      terms for textual materials designate specific kinds of materials distinguished by the style\\n      or technique of their intellectual contents; for example, biographies, catechisms, essays,\\n      hymns, or reviews. Form terms designate historically and functionally specific kinds of\\n      materials as distinguished by an examination of their physical character, characteristics of\\n      their intellectual content, or the order of information within them; for example, daybooks,\\n      diaries, directories, journals, memoranda, questionnaires, syllabi, or time sheets. In the\\n      context of graphic materials, genre headings denote categories of material distinguished by\\n      vantage point, intended purpose, characteristics of the creator, publication status, or method\\n      of representation."@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#SimpleType> .

<http://www.loc.gov/mads/rdf/v1#GenreFormElement> a owl:Class ;
    rdfs:label "Genre/Form Element"@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Element> .

<http://www.loc.gov/mads/rdf/v1#GeographicElement> a owl:Class ;
    rdfs:label "Geographic Element"@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Element> .

<http://www.loc.gov/mads/rdf/v1#GivenNameElement> a owl:Class ;
    rdfs:label "Given Name\\n      Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#NameElement> .

<http://www.loc.gov/mads/rdf/v1#Island> a owl:Class ;
    rdfs:label "Island Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is a tract of land surrounded by water and smaller than a continent but is not itself a\\n      separate country. "^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#LanguageElement> a owl:Class ;
    rdfs:label "Language Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Element> .

<http://www.loc.gov/mads/rdf/v1#MainTitleElement> a owl:Class ;
    rdfs:label "Main Title\\n      Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#TitleElement> .

<http://www.loc.gov/mads/rdf/v1#NonSortElement> a owl:Class ;
    rdfs:label "Non-sort Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#TitleElement> .

<http://www.loc.gov/mads/rdf/v1#PartNameElement> a owl:Class ;
    rdfs:label "Part Name\\n      Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#TitleElement> .

<http://www.loc.gov/mads/rdf/v1#PartNumberElement> a owl:Class ;
    rdfs:label "Part Number\\n      Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#TitleElement> .

<http://www.loc.gov/mads/rdf/v1#Province> a owl:Class ;
    rdfs:label "Province Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is a first order political division, e.g. Ontario, within a country, e.g. Canada. "^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#Region> a owl:Class ;
    rdfs:label "Region Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is an area that has the status of a jurisdiction, usually incorporating more than one\\n      first level jurisdiction. "^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#State> a owl:Class ;
    rdfs:label "State Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is a first order political division, e.g. Montana, within a country, e.g.\\n      U.S."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#SubTitleElement> a owl:Class ;
    rdfs:label "Subtitle Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#TitleElement> .

<http://www.loc.gov/mads/rdf/v1#Temporal> a owl:Class ;
    rdfs:label "Temporal Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label represents a time-based notion."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#SimpleType> .

<http://www.loc.gov/mads/rdf/v1#TemporalElement> a owl:Class ;
    rdfs:label "Temporal Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Element> .

<http://www.loc.gov/mads/rdf/v1#TermsOfAddressNameElement> a owl:Class ;
    rdfs:label "Terms of Address\\n      Element"^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#NameElement> .

<http://www.loc.gov/mads/rdf/v1#Territory> a owl:Class ;
    rdfs:label "Territory Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is a geographical area belonging to or under the jurisdiction of a governmental\\n      authority. "^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#Title> a owl:Class ;
    rdfs:label "Title Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label represents a title."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#SimpleType> .

<http://www.loc.gov/mads/rdf/v1#Topic> a owl:Class ;
    rdfs:label "Topic Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label represents a topic."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#SimpleType> .

<http://www.loc.gov/mads/rdf/v1#TopicElement> a owl:Class ;
    rdfs:label "Topic Element"@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Element> .

<http://www.loc.gov/mads/rdf/v1#activityEndDate> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Activity End"^^xsd:string ;
    rdfs:comment "Latest date in a period of activity.\\n    "^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#activityStartDate> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Activity Start"^^xsd:string ;
    rdfs:comment "Earliest date in a period of activity.\\n    "^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#adminMetadata> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Administrative Metadata"@en ;
    rdfs:comment "This relates an Authority or Variant to its administrative metadata,\\n      which is, minimimally, a Class defined outside of the MADS/RDF namespace. The RecordInfo Class\\n      from the RecordInfo ontology is recommended."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/mads/rdf/v1#Authority> <http://www.loc.gov/mads/rdf/v1#DeprecatedAuthority> <http://www.loc.gov/mads/rdf/v1#Variant> ) ] .

<http://www.loc.gov/mads/rdf/v1#affiliationEnd> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Affiliation\\n      Ended"^^xsd:string ;
    rdfs:comment "The date an individual\\n      ceased to be affiliated with an organization."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Affiliation> ;
    rdfs:range xsd:date .

<http://www.loc.gov/mads/rdf/v1#affiliationStart> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Affiliation\\n      Started"^^xsd:string ;
    rdfs:comment "The date an individual\\n      established an affiliation with an organization."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Affiliation> ;
    rdfs:range xsd:date .

<http://www.loc.gov/mads/rdf/v1#associatedLanguage> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Associated\\n      Language"^^xsd:string ;
    rdfs:comment "Language that a person,\\n      organization, or family uses for publication, communication, etc., or in which a work is\\n      expressed. "^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Language> .

<http://www.loc.gov/mads/rdf/v1#associatedLocale> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Associated Locale"^^xsd:string ;
    rdfs:comment "A town, city, province,\\n      state, and/or country associated with persons, corporate bodies, families, works, and\\n      expressions."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#authoritativeLabel> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Authoritative Label"@en ;
    rdfs:comment "A lexical string representing a controlled, curated label for the\\n      Authority."@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Authority> ;
    rdfs:subPropertyOf rdfs:label,
        skos:prefLabel .

<http://www.loc.gov/mads/rdf/v1#birthDate> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Birth Date"^^xsd:string ;
    rdfs:comment "The year a person was born.\\n      Date of birth may also include the month and day of the person’s birth. (RDA\\n      9.3.2.1)"^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#birthPlace> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Place of Birth"^^xsd:string ;
    rdfs:comment "The town, city, province,\\n      state, and/or country in which a person was born."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#citationNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Citation Note"@en ;
    rdfs:comment "A note about how the madsrdf:Source relates to the resource about\\n      which the madsrdf:Source is the information source."@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Source> .

<http://www.loc.gov/mads/rdf/v1#citationSource> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Citation Source"@en ;
    rdfs:comment "The cited resource."@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Source> .

<http://www.loc.gov/mads/rdf/v1#citationStatus> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Citation Status"@en ;
    rdfs:comment "Should use a standard term - such as 'found' or 'not found' - to\\n      indicate whether the cited resource yielded information about the resource related to the\\n      madsrdf:Source."@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Source> ;
    rdfs:range xsd:string .

<http://www.loc.gov/mads/rdf/v1#city> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "City"@en ;
    rdfs:comment "The city component of an address."@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Address> .

<http://www.loc.gov/mads/rdf/v1#classification> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Classification"@en ;
    rdfs:comment "The classification code associated with a\\n      madsrdf:Authority."@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Authority> ;
    rdfs:subPropertyOf skos:semanticRelation .

<http://www.loc.gov/mads/rdf/v1#code> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Code"^^xsd:string ;
    rdfs:comment "A code is a string of\\n      characters associated with a the authoritative or deprecated label. It may record an\\n      historical notation once used to uniquely identify a concept."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/mads/rdf/v1#Authority> <http://www.loc.gov/mads/rdf/v1#DeprecatedAuthority> ) ] ;
    rdfs:subPropertyOf skos:notation .

<http://www.loc.gov/mads/rdf/v1#country> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Country"^^xsd:string ;
    rdfs:comment "Country associated with an\\n      address."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Address> .

<http://www.loc.gov/mads/rdf/v1#creationDateEnd> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label ""^^xsd:string ;
    rdfs:comment "Ending date of the date range for which the beginning date is recorded in madsrdf:creationDateStart."^^xsd:string .

<http://www.loc.gov/mads/rdf/v1#creationDateStart> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Work begun"^^xsd:string ;
    rdfs:comment "For a work, earliest date (normally the year) associated with a work; that date may be the date the work was created or first published or released. For an expression, the earliest date (normally the year) associated with an expression; that date may be the date of the earliest known manifestation of that expression. In both cases the date may be the starting date of a range or a single date."^^xsd:string .

<http://www.loc.gov/mads/rdf/v1#deathDate> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Death Date"^^xsd:string ;
    rdfs:comment "The year a person died.\\n      Date of death may also include the month and day of the person’s death. (RDA\\n      9.3.3.1)"^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#deathPlace> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Place of Death"^^xsd:string ;
    rdfs:comment "The town, city, province,\\n      state, and/or country in which a person died."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/mads/rdf/v1#definitionNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Definition Note"@en ;
    rdfs:comment "An explanation of the meaning of an Authority, DeprecatedAuthority,\\n      or Variant description."@en ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#note> ;
    owl:equivalentProperty skos:definition .

<http://www.loc.gov/mads/rdf/v1#deletionNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Deletion Note"^^xsd:string ;
    rdfs:comment "A note pertaining to the\\n      deletion of a resource."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#changeNote> .

<http://www.loc.gov/mads/rdf/v1#deprecatedLabel> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Deprecated Label"^^xsd:string ;
    rdfs:comment "A label once considered\\n      authoritative (controlled and curated) but which is no longer."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#DeprecatedAuthority> ;
    rdfs:subPropertyOf rdfs:label,
        skos:hiddenLabel .

<http://www.loc.gov/mads/rdf/v1#editorialNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Editorial Note"^^xsd:string ;
    rdfs:comment "A note pertaining to the\\n      management of the label associated with the resource."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#note> ;
    owl:equivalentProperty skos:editorialNote .

<http://www.loc.gov/mads/rdf/v1#elementList> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Element List"^^xsd:string ;
    rdfs:comment "The madsrdf:elementList property is used to organize the various\\n      parts of labels."@en ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( rdf:List rdf:Seq ) ] .

<http://www.loc.gov/mads/rdf/v1#email> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Email"^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Affiliation> .

<http://www.loc.gov/mads/rdf/v1#entityDescriptor> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Entity\\n      Descriptor"^^xsd:string ;
    rdfs:comment "Any attribute that serves\\n      to characterize a person, family or corporate body or that may be needed for differentiation\\n      from other persons. families or corporate bodies and for which separate content designation is\\n      not already defined.Or "^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#establishDate> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Established"^^xsd:string ;
    rdfs:comment "The year a corporate body was established. Date of establishment may also include the month and day of the corporate body’s establishment.\\n    "^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#exampleNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Example Note"^^xsd:string ;
    rdfs:comment "A example of how the\\n      resource might be used."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#note> ;
    owl:equivalentProperty skos:example .

<http://www.loc.gov/mads/rdf/v1#extendedAddress> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Extended Address"^^xsd:string ;
    rdfs:comment "The second address line, if\\n      needed."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Address> .

<http://www.loc.gov/mads/rdf/v1#extension> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Extension"^^xsd:string .

<http://www.loc.gov/mads/rdf/v1#fax> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Fax"^^xsd:string ;
    rdfs:comment "Fax number"^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Affiliation> .

<http://www.loc.gov/mads/rdf/v1#fieldOfActivity> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Field of\\n      Activity"^^xsd:string ;
    rdfs:comment "The field of activity\\n      associated with an individual."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#fullerName> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Fuller Name"^^xsd:string ;
    rdfs:comment "Full form of name needed to\\n      distinguish a person from another person with the same preferred name."^^xsd:string ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#PersonalName> .

<http://www.loc.gov/mads/rdf/v1#gender> a rdf:Property,
        owl:DataTypeProperty ;
    rdfs:label "Gender"^^xsd:string ;
    rdfs:comment "The gender with which a\\n      person identifies. "^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#hasAbbreviationVariant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Abbreviation\\n      Variant"^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasVariant> .

<http://www.loc.gov/mads/rdf/v1#hasAcronymVariant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Acronym\\n      Variant"^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasVariant> .

<http://www.loc.gov/mads/rdf/v1#hasAffiliation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Affiliation"^^xsd:string ;
    rdfs:comment "Property to associate an\\n      individual, such as a foaf:Agent, to a group or organization with which an individual is or\\n      has been affiliated."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Affiliation> .

<http://www.loc.gov/mads/rdf/v1#hasAffiliationAddress> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Affiliation\\n      Address"^^xsd:string ;
    rdfs:comment "The address of the group or\\n      organization with which an individual is associated."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Affiliation> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Address> .

<http://www.loc.gov/mads/rdf/v1#hasBroaderExternalAuthority> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Broader External\\n      Authority"^^xsd:string ;
    rdfs:comment "Creates a direct\\n      relationship between an Authority and a more broadly defined Authority from a different MADS\\n      Scheme."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasBroaderAuthority>,
        skos:broadMatch .

<http://www.loc.gov/mads/rdf/v1#hasChararacteristic> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Other characteristic"^^xsd:string ;
    rdfs:comment "A term that specifies a characteristic that differentiates a work or expression from another one.\\n    "^^xsd:string .

<http://www.loc.gov/mads/rdf/v1#hasCorporateSubsidiaryAuthority> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Is Parent Organization\\n      Of"^^xsd:string ;
    rdfs:comment "Establishes a relationship\\n      between a CorporateName Authority and one of the same that is more narrowly\\n      defined."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#CorporateName> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#CorporateName> ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasRelatedAuthority> ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#hasCorporateParentAuthority> .

<http://www.loc.gov/mads/rdf/v1#hasExactExternalAuthority> a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "Has Exact External\\n      Authority"^^xsd:string ;
    rdfs:comment "Records a relationship\\n      between an Authority and one to which it matches exactly but from a different MADS\\n      Scheme."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasCloseExternalAuthority>,
        skos:exactMatch .

<http://www.loc.gov/mads/rdf/v1#hasExpansionVariant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Expansion\\n      Variant"^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasVariant> .

<http://www.loc.gov/mads/rdf/v1#hasHiddenVariant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Hidden Variant"@en ;
    rdfs:comment "Use for variants that are searchable, but not necessarily for\\n      display."@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Authority> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Variant> ;
    rdfs:subPropertyOf <http://www.w3.org/2008/05/skos-xl#hiddenLabel> .

<http://www.loc.gov/mads/rdf/v1#hasIdentifier> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Identifier"^^xsd:string ;
    rdfs:comment "Associates a resource with\\n      a madsrdf:Identifier."^^xsd:string ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Identifier> .

<http://www.loc.gov/mads/rdf/v1#hasNarrowerExternalAuthority> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Narrower External\\n      Authority"^^xsd:string ;
    rdfs:comment "Creates a direct\\n      relationship between an Authority and a more narrowly defined Authority from a different MADS\\n      Scheme."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasNarrowerAuthority>,
        skos:narrowMatch .

<http://www.loc.gov/mads/rdf/v1#hasReciprocalExternalAuthority> a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Has Reciprocal External\\n      Authority"^^xsd:string ;
    rdfs:comment "Establishes a relationship\\n      between an Authority and one from a different MADS Scheme. It is reciprocal, so the\\n      relationship must be shared."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasReciprocalAuthority>,
        skos:relatedMatch .

<http://www.loc.gov/mads/rdf/v1#hasSource> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Source"^^xsd:string ;
    rdfs:comment "Associates a resource description with its Source."@en ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Source> .

<http://www.loc.gov/mads/rdf/v1#hasTranslationVariant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Translation\\n      Variant"^^xsd:string ;
    rdfs:comment "A Variant whose label\\n      represents a translation of that of the authoritative label."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasVariant> .

<http://www.loc.gov/mads/rdf/v1#hiddenLabel> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Hidden Label"^^xsd:string ;
    rdfs:comment "A label entered for\\n      discovery purposes but not shown."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Variant> ;
    rdfs:subPropertyOf <http://www.w3.org/2008/05/skos-xl#literalForm> .

<http://www.loc.gov/mads/rdf/v1#historyNote> a owl:AnnotationProperty ;
    rdfs:label "History Note"^^xsd:string ;
    rdfs:comment "A note pertaining to the\\n      history of the resource."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#note> ;
    owl:equivalentProperty skos:historyNote .

<http://www.loc.gov/mads/rdf/v1#honoraryTitle> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Honorary Title"^^xsd:string ;
    rdfs:comment "Designation indicative of\\n      royalty, nobility, or ecclesiastical rank or office, or a term of address for a person of\\n      religious vocation."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#hours> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Hours"^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Affiliation> .

<http://www.loc.gov/mads/rdf/v1#idScheme> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Identifier\\n      Scheme"^^xsd:string ;
    rdfs:comment "The scheme associated with\\n      the identifier. For example, \"LCCN\" would be used when the Identifier Value (madsrdf:idValue)\\n      is a LC Control Number."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Identifier> .

<http://www.loc.gov/mads/rdf/v1#idValue> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Identifier Value"^^xsd:string ;
    rdfs:comment "The value of the identifier\\n      conforming to the Identifier Scheme syntax."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Identifier> ;
    rdfs:range xsd:string .

<http://www.loc.gov/mads/rdf/v1#isTopMemberOfMADSScheme> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Is Top Member of MADS\\n      Scheme"^^xsd:string ;
    rdfs:comment "Identifies a MADS Scheme in\\n      which the Authority is at the top of the hierarchy."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/mads/rdf/v1#Authority> <http://www.loc.gov/mads/rdf/v1#MADSCollection> ) ] ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#MADSScheme> ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#isMemberOfMADSScheme>,
        skos:topConceptOf ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#hasTopMemberOfMADSScheme> .

<http://www.loc.gov/mads/rdf/v1#natureOfAffiliation> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Nature of\\n      Affiliation"^^xsd:string ;
    rdfs:comment "Records the individual's\\n      role or position in the organization with which the individual is affiliated. A \"job title\"\\n      might be appropriate."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Affiliation> .

<http://www.loc.gov/mads/rdf/v1#occupation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Occupation"^^xsd:string ;
    rdfs:comment "A profession or occupation\\n      in which the person works or has worked."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Occupation> .

<http://www.loc.gov/mads/rdf/v1#organization> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Organization or\\n      Group"^^xsd:string ;
    rdfs:comment "The group or organization\\n      with which an individual is associated."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Affiliation> .

<http://www.loc.gov/mads/rdf/v1#phone> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Phone"^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Affiliation> .

<http://www.loc.gov/mads/rdf/v1#postcode> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Post Code / Zip\\n      Code"^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Address> .

<http://www.loc.gov/mads/rdf/v1#prominentFamilyMember> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Prominent Family\\n      Member"^^xsd:string ;
    rdfs:comment "A well-known individual who\\n      is a member of the family."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#scopeNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Scope Note"^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#note> ;
    owl:equivalentProperty skos:scopeNote .

<http://www.loc.gov/mads/rdf/v1#state> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "State"^^xsd:string ;
    rdfs:comment "The state associated with\\n      an address."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Address> .

<http://www.loc.gov/mads/rdf/v1#streetAddress> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Street Address"^^xsd:string ;
    rdfs:comment "First line of address. For\\n      second line, use madsrdf:extendedAddress."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Address> .

<http://www.loc.gov/mads/rdf/v1#terminateDate> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Terminated"^^xsd:string ;
    rdfs:comment "The year a corporate body was terminated. Date of termination may also include the month and day of the corporate body’s termination. \\n    "^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> .

<http://www.loc.gov/mads/rdf/v1#useFor> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Use For"^^xsd:string ;
    rdfs:comment "\"Use [This Resource] For.\"\\n      Traditional \"USE FOR\" reference."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#see> ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#useInstead> .

<http://www.loc.gov/mads/rdf/v1#variantLabel> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Variant Label"^^xsd:string ;
    rdfs:comment "The lexical, variant form\\n      of an authoritative label."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Variant> ;
    rdfs:subPropertyOf <http://www.w3.org/2008/05/skos-xl#literalForm> .

<http://www.loc.gov/mads/rdf/v1#workOrigin> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Work locale"^^xsd:string ;
    rdfs:comment "The country or other territorial jurisdiction from which a work originated."^^xsd:string ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Geographic> .

<http://www.loc.gov/standards/mads/rdf/v1.rdf> a owl:Ontology ;
    rdfs:comment "Updated: 10 May 2012 - Added Language Class; componentList and\\n      elementList now has the union of rdf:List or rdf:Seq for a range."@en .

rdfs:comment a owl:AnnotationProperty .

<http://www.loc.gov/mads/rdf/v1#ComplexSubject> a owl:Class ;
    rdfs:label "Complex Subject Type"@en ;
    rdfs:comment "The label of a madsrdf:ComplexSubject is the concatenation of labels\\n      from two or more madsrdf:SimpleType descriptions, except that the combination of\\n      madsrdf:SimpleType labels for the madsrdf:ComplexSubject does not meet the conditions to be\\n      the label of a madsrdf:NameTitle resource or madsrdf:HierarchicalGeographic\\n      resource."@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#ComplexType> .

<http://www.loc.gov/mads/rdf/v1#HierarchicalGeographic> a owl:Class ;
    rdfs:label "Hierarchical Geographic Type"@en ;
    rdfs:comment "A madsrdf:HierarchicalGeographic indicates that its label is the\\n      concatenation of labels from a sequence of madsrdf:Geographic types taken from one of the\\n      madsrdf:Geographic sub-classes such as madsrdf:City, madsrdf:Country, madsrdf:State,\\n      madsrdf:Region, madsrdf:Area, etc. The madsrdf:Geographic resources that constitute the\\n      madsrdf:HierarchicalGeographic should have a broader to narrower hierarchical relationship\\n      between them."@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#ComplexType> .

<http://www.loc.gov/mads/rdf/v1#Language> a owl:Class ;
    rdfs:label "Language Type"@en ;
    rdfs:comment "Describes a resource whose label represents a\\n      language."@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#SimpleType> ;
    owl:equivalentClass dcterms:LinguisticSystem .

<http://www.loc.gov/mads/rdf/v1#NameTitle> a owl:Class ;
    rdfs:label "Name/Title Type"@en ;
    rdfs:comment "The label of a madsrdf:NameTitle resource is the concatenation of a\\n      label of a madsrdf:Name description and the label of a madsrdf:Title description. Both\\n      description types (madsrdf:Name and madsrdf:Title) are of madsrdf:SimpleType\\n      types."@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#ComplexType> .

<http://www.loc.gov/mads/rdf/v1#Occupation> a owl:Class ;
    rdfs:label "Occupation Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label represents an occcupation."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#SimpleType> .

<http://www.loc.gov/mads/rdf/v1#PersonalName> a owl:Class ;
    rdfs:label "Personal Name Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label represents a personal name."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Name> .

<http://www.loc.gov/mads/rdf/v1#changeNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Change Note"@en ;
    rdfs:comment "A note detailing a modification to an Authority or\\n      Variant."@en ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#note> ;
    owl:equivalentProperty skos:changeNote .

<http://www.loc.gov/mads/rdf/v1#componentList> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Component List"^^xsd:string ;
    rdfs:comment "madsrdf:componentList\\n      organizes the madsrdf:SimpleType resources whose labels are represented in the label of the\\n      associated madsrdf:ComplexType resource."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#ComplexType> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( rdf:List rdf:Seq ) ] .

<http://www.loc.gov/mads/rdf/v1#elementValue> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Element Value"^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Element> ;
    rdfs:range xsd:string .

<http://www.loc.gov/mads/rdf/v1#hasCloseExternalAuthority> a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Has Close External\\n      Authority"^^xsd:string ;
    rdfs:comment "Records a relationship\\n      between an Authority and one that is closely related from a different MADS\\n      Scheme."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasRelatedAuthority>,
        skos:closeMatch .

<http://www.loc.gov/mads/rdf/v1#hasCorporateParentAuthority> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Parent\\n      Organization"^^xsd:string ;
    rdfs:comment "Establishes a relationship\\n      between a CorporateName Authority and one of the same that is more broadly\\n      defined."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#CorporateName> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#CorporateName> ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasRelatedAuthority> .

<http://www.loc.gov/mads/rdf/v1#hasEarlierEstablishedForm> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Earlier Established\\n      Form"^^xsd:string ;
    rdfs:comment "Used to reference a resource that was an earlier form. This is\\n      Related type='earlier' in MADS XML."@en ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#see> ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#hasLaterEstablishedForm> .

<http://www.loc.gov/mads/rdf/v1#hasLaterEstablishedForm> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Later Established\\n      Form"^^xsd:string ;
    rdfs:comment "Use to reference the later form of a resource. This is Related\\n      type='later' in MADS XML."@en ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#see> ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#hasEarlierEstablishedForm> .

<http://www.loc.gov/mads/rdf/v1#hasMADSCollectionMember> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has MADSCollection Member"@en ;
    rdfs:comment "Associates an Authority or other Collection with a\\n      madsrdf:MADSCollection."@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#MADSCollection> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/mads/rdf/v1#Authority> <http://www.loc.gov/mads/rdf/v1#MADSCollection> ) ] ;
    rdfs:subPropertyOf skos:member ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#isMemberOfMADSCollection> .

<http://www.loc.gov/mads/rdf/v1#hasReciprocalAuthority> a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Has Reciprocal\\n      Authority"^^xsd:string ;
    rdfs:comment "Establishes a relationship between two Authority resources. It is\\n      reciprocal, so the relationship must be shared. This is Related type='equivalent' in MADS\\n      XML."@en ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasRelatedAuthority>,
        skos:related .

<http://www.loc.gov/mads/rdf/v1#hasTopMemberOfMADSScheme> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Top Member of MADS\\n      Scheme"^^xsd:string ;
    rdfs:comment "Identifies an Authority\\n      that is at the top of the hierarchy of authorities within the MADS Scheme."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#MADSScheme> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Authority> ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasMADSSchemeMember>,
        skos:hasTopConcept .

<http://www.loc.gov/mads/rdf/v1#identifiesRWO> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Identifies RWO"^^xsd:string ;
    rdfs:comment "Associates a\\n      madsrdf:Authority with the Real World Object that is the subject of the authority's\\n      label."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Authority> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#RWO> ;
    rdfs:subPropertyOf foaf:focus ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#isIdentifiedByAuthority> .

<http://www.loc.gov/mads/rdf/v1#isIdentifiedByAuthority> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Is Identified By\\n      Authority"^^xsd:string ;
    rdfs:comment "Associates a Real World\\n      Object with its Authority description."^^xsd:string ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#RWO> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Authority> ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#identifiesRWO> .

<http://www.loc.gov/mads/rdf/v1#isMemberOfMADSCollection> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Is Member Of MADSCollection"@en ;
    rdfs:comment "Associates a Collection with a madsrdf:Authority or another\\n      madsrdf:MADSCollection."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/mads/rdf/v1#Authority> <http://www.loc.gov/mads/rdf/v1#MADSCollection> ) ] ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#MADSCollection> ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#hasMADSCollectionMember> .

<http://www.loc.gov/mads/rdf/v1#useInstead> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Use Instead"^^xsd:string ;
    rdfs:comment "\"Use [This Other Resource]\\n      Instead.\" Traditional \"USE\" reference."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#see> .

<http://www.loc.gov/mads/rdf/v1#MADSType> a owl:Class ;
    rdfs:label "MADS Type"^^xsd:string ;
    owl:disjointWith <http://www.loc.gov/mads/rdf/v1#MADSCollection>,
        <http://www.loc.gov/mads/rdf/v1#MADSScheme> .

<http://www.loc.gov/mads/rdf/v1#hasBroaderAuthority> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Broader\\n      Authority"^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasRelatedAuthority>,
        skos:broader ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#hasNarrowerAuthority> .

<http://www.loc.gov/mads/rdf/v1#hasMADSSchemeMember> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has MADS Scheme\\n      Member"^^xsd:string ;
    rdfs:comment "Associates an Authority or Collection with a\\n      madsrdf:MADSScheme."@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#MADSScheme> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/mads/rdf/v1#Authority> <http://www.loc.gov/mads/rdf/v1#MADSCollection> ) ] ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#isMemberOfMADSScheme> .

<http://www.loc.gov/mads/rdf/v1#hasNarrowerAuthority> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Narrower\\n      Authority"^^xsd:string ;
    rdfs:comment "Creates a direct\\n      relationship between an Authority and one that is more narrowly defined."^^xsd:string ;
    rdfs:subPropertyOf <http://www.loc.gov/mads/rdf/v1#hasRelatedAuthority>,
        skos:narrower ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#hasBroaderAuthority> .

<http://www.loc.gov/mads/rdf/v1#isMemberOfMADSScheme> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Is Member of MADS\\n      Scheme"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/mads/rdf/v1#Authority> <http://www.loc.gov/mads/rdf/v1#MADSCollection> ) ] ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#MADSScheme> ;
    rdfs:subPropertyOf skos:inScheme ;
    owl:inverseOf <http://www.loc.gov/mads/rdf/v1#hasMADSSchemeMember> .

rdfs:label a owl:AnnotationProperty .

xsd:date a rdfs:Datatype .

<http://www.loc.gov/mads/rdf/v1#Identifier> a owl:Class ;
    rdfs:label "Other Identifier"^^xsd:string ;
    rdfs:comment "A madsrdf:Identifier\\n      resource describes an identifier by associating the identifier value with its type. To be used\\n      to record identifiers for a resource in the absence of URIs."^^xsd:string .

<http://www.loc.gov/mads/rdf/v1#ComplexType> a owl:Class ;
    rdfs:label "Complex Type"@en ;
    rdfs:comment "madsrdf:ComplexType is a resource whose label is the concatenation\\n      of labels from two or more Authority descriptions or two or more Variant descriptions or some\\n      combination of Authority and Variant descriptions, each of a\\n      madsrdf:SimpleType."@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#MADSType> ;
    owl:disjointUnionOf ( <http://www.loc.gov/mads/rdf/v1#HierarchicalGeographic> <http://www.loc.gov/mads/rdf/v1#ComplexSubject> <http://www.loc.gov/mads/rdf/v1#NameTitle> ) ;
    owl:disjointWith <http://www.loc.gov/mads/rdf/v1#SimpleType> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.loc.gov/mads/rdf/v1#componentList> ] .

<http://www.loc.gov/mads/rdf/v1#CorporateName> a owl:Class ;
    rdfs:label "Corporate Name Type"@en ;
    rdfs:comment "Describes a resource whose\\n      label is the name of a corporate entity, which may include political or ecclesiastical\\n      entities."^^xsd:string ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Name> .

<http://www.loc.gov/mads/rdf/v1#Name> a owl:Class ;
    rdfs:label "Name Type"@en ;
    rdfs:comment "Describes a resource whose label represents a name, especially when\\n      a more precise Name type (madsrdf:ConferenceName, masdrdf:FamilyName, etc.) cannot be\\n      identified."@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#SimpleType> .

<http://www.loc.gov/mads/rdf/v1#Source> a owl:Class ;
    rdfs:label "Source"^^xsd:string ;
    rdfs:comment "A resource that represents\\n      the source of information about another resource. madsrdf:Source is a type of\\n      citation."^^xsd:string .

<http://www.loc.gov/mads/rdf/v1#hasVariant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Variant"^^xsd:string ;
    rdfs:comment "Associates a Variant with an Authority or Deprecrated Authority.\\n      Unless the variant type can be more specifically identified, use 'hasVariant.'"@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Authority> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Variant> ;
    rdfs:subPropertyOf <http://www.w3.org/2008/05/skos-xl#altLabel> .

<http://www.loc.gov/mads/rdf/v1#see> a owl:ObjectProperty ;
    rdfs:label "See Also"^^xsd:string ;
    rdfs:comment "Denotes a relationship\\n      between an Authority and/or DeprecatedAuthority. The relationship may or may or may not be\\n      reciprocated and there is no certainty that the related resource will further illuminate the\\n      original resource."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/mads/rdf/v1#Authority> <http://www.loc.gov/mads/rdf/v1#DeprecatedAuthority> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.loc.gov/mads/rdf/v1#Authority> <http://www.loc.gov/mads/rdf/v1#DeprecatedAuthority> ) ] ;
    rdfs:subPropertyOf rdfs:seeAlso .

owl:Thing a owl:Class .

<http://www.loc.gov/mads/rdf/v1#NameElement> a owl:Class ;
    rdfs:label "Name Element"@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Element> .

<http://www.loc.gov/mads/rdf/v1#TitleElement> a owl:Class ;
    rdfs:label "Title Element"@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#Element> .

<http://www.loc.gov/mads/rdf/v1#DeprecatedAuthority> a owl:Class ;
    rdfs:label "Deprecated\\n      Authority"^^xsd:string ;
    rdfs:comment "A former\\n      Authority."^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointWith <http://www.loc.gov/mads/rdf/v1#Authority>,
        <http://www.loc.gov/mads/rdf/v1#MADSCollection>,
        <http://www.loc.gov/mads/rdf/v1#MADSScheme> .

<http://www.loc.gov/mads/rdf/v1#hasRelatedAuthority> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Related Authority"@en ;
    rdfs:comment "Unless the relationship can be more specifically identified, use\\n      'hasRelatedAuthority.'"@en ;
    rdfs:domain <http://www.loc.gov/mads/rdf/v1#Authority> ;
    rdfs:range <http://www.loc.gov/mads/rdf/v1#Authority> ;
    rdfs:subPropertyOf skos:semanticRelation .

<http://www.loc.gov/mads/rdf/v1#note> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Note"^^xsd:string ;
    rdfs:comment "A note about the\\n      resource."^^xsd:string ;
    owl:equivalentProperty skos:note .

<http://www.loc.gov/mads/rdf/v1#Address> a owl:Class ;
    rdfs:label "Address"@en .

<http://www.loc.gov/mads/rdf/v1#Element> a owl:Class ;
    rdfs:label "Element"@en ;
    rdfs:comment "madsrdf:Element types\\n      describe the various parts of labels."^^xsd:string ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.loc.gov/mads/rdf/v1#elementValue> ] .

<http://www.loc.gov/mads/rdf/v1#Variant> a owl:Class ;
    rdfs:label "Variant"@en ;
    rdfs:comment "A resource whose label is the alternate form of an Authority or\\n      Deprecated Authority."@en ;
    rdfs:subClassOf owl:Thing,
        <http://www.w3.org/2008/05/skos-xl#Label> ;
    owl:disjointWith <http://www.loc.gov/mads/rdf/v1#Authority>,
        <http://www.loc.gov/mads/rdf/v1#MADSCollection>,
        <http://www.loc.gov/mads/rdf/v1#MADSScheme> .

<http://www.loc.gov/mads/rdf/v1#MADSScheme> a owl:Class ;
    rdfs:label "MADS Scheme"@en ;
    rdfs:comment "MADS Scheme is an organizational unit that describes a knowledge\\n      organization system. It aggregates madsrdf:Authority descriptions and/or\\n      madsrdf:MADSCollection resources included in the knowledge organization system. Including a\\n      madsrdf:MADSCollection within a madsrdf:MADSScheme should be done with care; when a\\n      madsrdf:MADSCollection is part of a madsrdf:MADSScheme, then any madsrdf:Authority within that\\n      madsrdf:MADSCollection is effectively also in the madsrdf:MADSScheme."@en ;
    rdfs:subClassOf skos:ConceptScheme ;
    owl:disjointWith <http://www.loc.gov/mads/rdf/v1#Authority>,
        <http://www.loc.gov/mads/rdf/v1#MADSCollection>,
        <http://www.loc.gov/mads/rdf/v1#Variant> .

<http://www.loc.gov/mads/rdf/v1#SimpleType> a owl:Class ;
    rdfs:label "Simple Type"@en ;
    rdfs:comment "madsrdf:SimpleType is a resource with a label constituting a single\\n      word or phrase."@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#MADSType> .

<http://www.loc.gov/mads/rdf/v1#Affiliation> a owl:Class ;
    rdfs:label "Affiliation"@en ;
    rdfs:comment "A resource that describes an individual's affiliation with an\\n      organization or group, such as the nature of the affiliation and the active\\n      dates."@en .

<http://www.loc.gov/mads/rdf/v1#MADSCollection> a owl:Class ;
    rdfs:label "MADS Collection"^^xsd:string ;
    rdfs:comment "A madsrdf:Collection is an\\n      organizational unit, members of which will have some form of intellectually unifying theme but\\n      not to the extent that it defines an independent knowledge organization system. It aggregates\\n      madsrdf:Authority descriptions or other madsrdf:MADSCollection resources."^^xsd:string ;
    rdfs:subClassOf skos:Collection ;
    owl:disjointWith <http://www.loc.gov/mads/rdf/v1#Authority>,
        <http://www.loc.gov/mads/rdf/v1#MADSScheme>,
        <http://www.loc.gov/mads/rdf/v1#Variant> .

<http://www.loc.gov/mads/rdf/v1#Geographic> a owl:Class ;
    rdfs:label "Geographic Authority"@en ;
    rdfs:comment "Describes a resource whose label represents a geographic place or\\n      feature, especially when a more precise geographic determination (City, Country, Region, etc.)\\n      cannot be made."@en ;
    rdfs:subClassOf <http://www.loc.gov/mads/rdf/v1#SimpleType> .

<http://www.loc.gov/mads/rdf/v1#RWO> a owl:Class ;
    rdfs:label "Real World\\n      Object"^^xsd:string ;
    rdfs:comment "A madsrdf:RWO is an\\n      abstract entity and identifies a Real World Object (RWO) identified by the label of a\\n      madsrdf:Authority or madsrdf:DeprecatedAuthority."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

<http://www.loc.gov/mads/rdf/v1#Authority> a owl:Class ;
    rdfs:label "Authority"@en ;
    rdfs:comment "A concept with a controlled\\n      label."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        skos:Concept ;
    owl:disjointWith <http://www.loc.gov/mads/rdf/v1#DeprecatedAuthority>,
        <http://www.loc.gov/mads/rdf/v1#MADSCollection>,
        <http://www.loc.gov/mads/rdf/v1#MADSScheme>,
        <http://www.loc.gov/mads/rdf/v1#Variant> .

