dcat:byteSize rdfs:domain dcat:Distribution ;
    rdfs:range xsd:decimal .

dcat:downloadURL rdfs:comment "Defines a relation between a Dataset and the URL that contains the distribution of the dataset in a given format."@en .

foaf:isPrimaryTopicOf a owl:ObjectProperty .

