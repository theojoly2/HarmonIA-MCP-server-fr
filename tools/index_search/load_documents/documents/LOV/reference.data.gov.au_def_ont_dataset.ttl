dc:relation a owl:AnnotationProperty ;
    rdfs:label "Relation"@en ;
    dcterms:description "Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system. "@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#relation-006> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource."@en ;
    rdfs:isDefinedBy dc: ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dcterms:relation a owl:AnnotationProperty,
        owl:NamedIndividual ;
    rdfs:label "Relation"@en ;
    dcterms:description "Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system. "@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#relationT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:subPropertyOf dc:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

<http://www.agls.gov.au/agls/terms/> dcterms:created "2002-04-18" ;
    dcterms:creator "National Archives of Australia"@en-au ;
    dcterms:description "The AGLS Metadata Terms Namespace provides URIs for the AGLS Metadata Terms Vocabulary. Vocabulary terms are declared using RDF Schema language to support RDF applications. The AGLS Metadata Terms form a richer vocabulary, which is intended to facilitate discovery of resources. It will be updated according to AGLS Working Group decisions."@en-au ;
    dcterms:language "English" ;
    dcterms:modified "2010-06-30" ;
    dcterms:publisher "National Archives of Australia"@en-au ;
    dcterms:rights "Copyright Commonwealth of Australia 2007" ;
    dcterms:title "The AGLS Metadata Terms Namespace providing access to its content by means of an RDF Schema."@en-au .

