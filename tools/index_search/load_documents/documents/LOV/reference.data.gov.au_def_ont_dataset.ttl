<http://reference.data.gov.au/def/datasetOntology> a owl:NamedIndividual ;
    dcterms:creator <http://linked.data.gov.au/> ;
    dcterms:publisher <http://linked.data.gov.au/> ;
    dcterms:rights <http://creativecommons.org/licenses/by/4.0/> .

<http://reference.data.gov.au/def/datasetOntology#> a owl:NamedIndividual ;
    dcterms:publisher <http://purl.org/dc/aboutdcmi#DCMI> .

onto: a owl:Ontology ;
    dc:contributor <http://reference.data.gov.au/def/ont/d.lowe@bom.gov.au> ;
    dc:publisher "Australian Government Linked Data Working Group"@en ;
    dcterms:contributor <http://reference.data.gov.au/def/ont/armin.haller@anu.edu.au>,
        <http://reference.data.gov.au/def/ont/nicholas.car@ga.gov.au>,
        <http://reference.data.gov.au/def/ont/simon.cox@csiro.au> ;
    dcterms:created "2015-06-19"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2017-09-26"^^xsd:date ;
    dcterms:title "Dataset Ontology"@en ;
    rdfs:comment "The data.gov.au Dataset Ontology is an OWL ontology designed to describe the characteristics of datasets published on data.gov.au.\\n\\nThe ontology contains elements which describe the publication, update, origin, governance, spatial and temporal coverage and other contextual information about the dataset. The ontology also covers aspects of organisational custodianship and governance.\\n \\nBy using this ontology to describe datasets on data.gov.au publishers increase discoverability and enable the consumption of this information in other applications/systems as Linked Data. It further enables decentralised publishing of catalogs and facilitates federated dataset search across sites, e.g. in datasets that are published by the States.\\n \\nOther publishers of Linked Data may make assertions about data published using this ontology, e.g. they may publish information about the use of the dataset in other applications."@en ;
    owl:imports <http://www.opengis.net/ont/geosparql>,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/2006/vcard/ns>,
        <http://www.w3.org/ns/dcat>,
        <http://www.w3.org/ns/prov-o> ;
    owl:priorVersion <https://github.com/AGLDWG/TR/blob/master/government.ttl> ;
    owl:versionIRI <http://reference.data.gov.au/def/ont/dataset/1.0> ;
    owl:versionInfo "1.0"@en .

<http://reference.data.gov.au/def/ont/dataset#AssociatedOrganisation> a owl:Class ;
    rdfs:comment "An AssociatedOrganisation is an Organisation that is responsible for an Event that changed a Dataset the Organisation is associated with."@en ;
    rdfs:subClassOf prov:Association .

<http://reference.data.gov.au/def/ont/dataset#Catalog> a owl:Class ;
    rdfs:label "Catalog"@en ;
    rdfs:comment "A Catalog is a curated collection of metadata about datasets."@en ;
    rdfs:isDefinedBy "https://www.w3.org/ns/dcat#Catalog"@en ;
    rdfs:subClassOf dcat:Catalog,
        prov:Entity .

<http://reference.data.gov.au/def/ont/dataset#DatasetPublicationEvent> a owl:Class ;
    rdfs:label "Dataset Publication Event"@en ;
    rdfs:comment "A Dataset Publication Event is a description of an event that happens at a given point in time and that results in the publication of a Dataset on data.gov.au."@en ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#DatasetChangeEvent> .

<http://reference.data.gov.au/def/ont/dataset#Document> a owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:subClassOf prov:Entity ;
    owl:equivalentClass foaf:Document .

<http://reference.data.gov.au/def/ont/dataset#Federal> a owl:Class ;
    rdfs:label "Federal Government"@en ;
    rdfs:comment "Federal Government denotes the federal democratic administrative authority of the Commonwealth of Australia."@en ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#LevelOfGovernment> .

<http://reference.data.gov.au/def/ont/dataset#FieldOfResearch> a owl:Class ;
    rdfs:label "Field of Research"@en ;
    rdfs:comment "The Field of Research defined by the Australian and New Zealand Standard Research Classification (ANZSRC) that best describes the type of methods applied to obtain the data contained within a Dataset."@en ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#Classifier> .

<http://reference.data.gov.au/def/ont/dataset#GazettedLocality> a owl:Class ;
    rdfs:label "Spatial Gazetteer"@en ;
    rdfs:comment "Locality with a name authorised by a government agency"^^xsd:string ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#Locality> .

<http://reference.data.gov.au/def/ont/dataset#GovernmentAgency> a owl:Class ;
    rdfs:label "Government Agency"@en ;
    rdfs:comment "A Government Agency is a kind of Organisation in the Commonwealth of Australia that is a distinct and recognisable body which has responsibility for carrying out administrative functions."@en ;
    rdfs:seeAlso <http://recordsearch.naa.gov.au/manual/Provenance/AgencyDefinition.htm#DEFINITION> ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#Organisation> .

<http://reference.data.gov.au/def/ont/dataset#Point> a owl:Class ;
    rdfs:label "Point"@en ;
    rdfs:comment "This is a stub class which allows us to defer which external vocabulary to adopt. Adoption can be at run-time through a owl:equivalentClass axiom - likely to be from WGS84_pos or OGC GeoSPARQL or both, or something else as proposed by the W3C SDWWG."^^xsd:string,
        "A Point is a point in space using its geographic coordinates."@en ;
    rdfs:seeAlso <http://www.w3.org/2003/01/geo/wgs84_pos> ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#Geometry> .

<http://reference.data.gov.au/def/ont/dataset#Polygon> a owl:Class ;
    rdfs:label "Polygon"@en ;
    rdfs:comment "This is a stub class which allows us to defer which external vocabulary to adopt. Adoption can be at run-time through a owl:equivalentClass axiom in the data - likely to be from WGS84_pos or OGC GeoSPARQL or both, or something else as proposed by the W3C SDWWG."^^xsd:string ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#Geometry> .

<http://reference.data.gov.au/def/ont/dataset#fileSize> a owl:DatatypeProperty ;
    rdfs:label "File Size"@en ;
    rdfs:comment "The size of a distribution in bytes."@en ;
    owl:equivalentProperty dcat:byteSize .

<http://reference.data.gov.au/def/ont/dataset#hasAgent> a owl:ObjectProperty ;
    rdfs:comment "Defines a relationship for the Agent responsible for a DatasetChangeEvent through an Association that defines the Organisation that the Agent is associated with for that Event."@en ;
    rdfs:range dcterms:Agent ;
    rdfs:subPropertyOf prov:agent .

<http://reference.data.gov.au/def/ont/dataset#hasContact> a owl:ObjectProperty ;
    rdfs:comment "Defines an agent who is the contact for inquiries on a Dataset."@en ;
    owl:equivalentProperty dcat:contactPoint .

<http://reference.data.gov.au/def/ont/dataset#hasDataset> a owl:ObjectProperty ;
    rdfs:comment "Defines a Dataset to be part of a Catalog."@en ;
    owl:equivalentProperty dcat:dataset ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/dataset#inCatalog> .

<http://reference.data.gov.au/def/ont/dataset#hasDistribution> a owl:ObjectProperty ;
    rdfs:comment "Defines the available distribution(s) for a Dataset."@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#Dataset> ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#Distribution> ;
    rdfs:subPropertyOf dcat:distribution .

<http://reference.data.gov.au/def/ont/dataset#hasDownloadURL> a owl:ObjectProperty ;
    rdfs:comment "Defines the URLs that contains the Distribution of the Dataset in a given format."@en ;
    owl:equivalentProperty dcat:downloadURL .

<http://reference.data.gov.au/def/ont/dataset#hasLandingPage> a owl:ObjectProperty ;
    rdfs:comment "Defines a relation that associates a Catalog, Dataset or Distribution with its (one) main Web page that can be navigated to in a Web browser to gain access to the dataset, its distributions and/or additional information."@en ;
    rdfs:range foaf:Document ;
    rdfs:subPropertyOf dcat:landingPage .

<http://reference.data.gov.au/def/ont/dataset#hasLevelOfGovernment> a owl:ObjectProperty ;
    rdfs:comment "Defines a relation that denotes the Level of Government of an Organisation, typically a Government Agency."@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#Organisation> ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#LevelOfGovernment> .

<http://reference.data.gov.au/def/ont/dataset#hasLicense> a owl:ObjectProperty ;
    rdfs:comment "A relation that associates a Catalog, Dataset or Distribution to its license document under which it is made available."@en ;
    rdfs:subPropertyOf dcterms:license .

<http://reference.data.gov.au/def/ont/dataset#hasLocalGovernmentArea> a owl:ObjectProperty ;
    rdfs:comment "Defines a relation that denotes the Local Government representing a Locality (a Spatial Thing)."@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#Locality> ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#LocalGovernmentArea> .

<http://reference.data.gov.au/def/ont/dataset#hasMember> a owl:ObjectProperty ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/dataset#isMemberOf> .

<http://reference.data.gov.au/def/ont/dataset#hasPurpose> a owl:DatatypeProperty ;
    rdfs:comment "The purpose of a Dataset."@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#Dataset> ;
    rdfs:range rdfs:Literal .

<http://reference.data.gov.au/def/ont/dataset#hasSpatialExtent> a owl:ObjectProperty ;
    rdfs:comment "Spatial extent corresponds to the geographic area within which all items in the dataset fall."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://reference.data.gov.au/def/ont/dataset#Dataset> <http://reference.data.gov.au/def/ont/dataset#Locality> ) ] ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#SpatialThing> .

<http://reference.data.gov.au/def/ont/dataset#hasTemporalExtent> a owl:ObjectProperty ;
    rdfs:comment "Temporal extent corresponds to the time interval within which all items in the dataset occur."^^xsd:string ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#Dataset> ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#Timelnterval> .

<http://reference.data.gov.au/def/ont/dataset#hasUpdateFrequency> a owl:ObjectProperty ;
    rdfs:comment "Describes the anticipated frequency of updates of a Dataset."@en .

<http://reference.data.gov.au/def/ont/dataset#isAssociatedWith> a owl:ObjectProperty ;
    rdfs:comment "Defines an association between a Dataset Change Event (e.g. Publishing) and an Association that defines the Agent and/or the Organisation responsible for that Change Event."@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#DatasetChangeEvent> ;
    rdfs:range prov:Association ;
    rdfs:subPropertyOf prov:qualifiedAssociation ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/dataset#participatesIn> .

<http://reference.data.gov.au/def/ont/dataset#isChangedBy> a owl:ObjectProperty ;
    rdfs:comment "Defines a relation that relates a Dataset Change Event to a Dataset. Typically, at least, a Publishing Change Event should be defined that describes when a Dataset is published on the Web."@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#Dataset> ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#DatasetChangeEvent> ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/dataset#resultedIn> .

<http://reference.data.gov.au/def/ont/dataset#isDescribedBy> a owl:ObjectProperty ;
    rdfs:comment "Defines a relation that associates a Thing to a Dataset that describes the Dataset in more detail."@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#Dataset> ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf foaf:isPrimaryTopicOf .

<http://reference.data.gov.au/def/ont/dataset#keyword> a owl:DatatypeProperty ;
    rdfs:label "Keyword"@en ;
    rdfs:comment "A keyword associated with the Dataset."@en ;
    owl:equivalentProperty dcat:keyword .

<http://reference.data.gov.au/def/ont/dataset#maintenanceArrangement> a owl:ObjectProperty ;
    rdfs:comment "Links to a description of a maintenance activity."@en ;
    rdfs:domain dcmitype:Dataset ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#MaintenanceResponsibility> ;
    rdfs:subPropertyOf prov:wasInfluencedBy .

<http://reference.data.gov.au/def/ont/dataset#playsRole> a owl:ObjectProperty ;
    rdfs:comment "A relation that defines the Role someone plays in a Dataset Change event defined through an Association entity."@en ;
    rdfs:domain prov:Association ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#Role> ;
    rdfs:subPropertyOf prov:hadRole ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/dataset#roleOf> .

<http://reference.data.gov.au/def/ont/dataset#publisher> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:comment "A Publisher plays the Role of uploading the Dataset to data.gov.au."@en ;
    rdfs:subPropertyOf dcterms:publisher .

<http://reference.data.gov.au/def/ont/dataset#title> a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:subPropertyOf dcterms:title .

<http://reference.data.gov.au/def/ont/dataset#updateDate> a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:subPropertyOf dcterms:modified .

<http://www.agls.gov.au/agls/terms/AGLSAgentClass> a owl:Class ;
    rdfs:label "AGLS Agent Class"@en-au ;
    dcterms:issued "2008-05-27" ;
    dcterms:modified "2010-04-13" ;
    rdfs:comment "A set of agent encoding schemes and/or formats"@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> .

<http://www.agls.gov.au/agls/terms/AZNSCO> a rdfs:Datatype ;
    rdfs:label "Australian and New Zealand Standard Classification of Occupations"@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2009-02-02" ;
    rdfs:comment "The set of occupations specified by the Australian Bureau of Statistics."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:seeAlso <http://www.abs.gov.au/anzsco/> .

<http://www.agls.gov.au/agls/terms/AgentClass> a owl:Class .

<http://www.agls.gov.au/agls/terms/AglsAgent> a rdfs:Datatype ;
    rdfs:label "AAGLS Agent Scheme"@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2009-02-02" ;
    rdfs:comment "The set of agents defined by contact details according to Dublin Core Structured Values"@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:seeAlso <http://www.agls.gov.au/documents/AglsAgent/> .

<http://www.agls.gov.au/agls/terms/AglsAvail> a rdfs:Datatype ;
    rdfs:label "AGLS Availability Scheme"@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2009-02-02" ;
    rdfs:comment "The set of resource availability or physical access to a resource defined by contact details according to Dublin Core Structured Values"@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:seeAlso <http://www.agls.gov.au/documents/AglsAvail/> .

<http://www.agls.gov.au/agls/terms/AudienceClass> a owl:Class .

<http://www.agls.gov.au/agls/terms/AvailClass> a owl:Class ;
    rdfs:label "Availability Class"@en-au ;
    dcterms:issued "2007-12-12" ;
    dcterms:modified "2009-02-02" ;
    rdfs:comment "A set of availability encoding schemes and/or formats"@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> .

<http://www.agls.gov.au/agls/terms/DocumentClass> a owl:Class ;
    rdfs:label "Document Class"@en-au ;
    dcterms:issued "2007-12-12" ;
    dcterms:modified "2009-02-02" ;
    rdfs:comment "A set of document encoding schemes and/or formats"@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> .

<http://www.agls.gov.au/agls/terms/GOLD> a rdfs:Datatype ;
    rdfs:label "Government Online Directory"@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2009-02-02" ;
    rdfs:comment "The set of agents defined by contact details according to X500 syntax."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:seeAlso <http://gold.directory.gov.au/> .

<http://www.agls.gov.au/agls/terms/Geocode> a rdfs:Datatype ;
    rdfs:label "Geocode"@en-au ;
    dcterms:issued "2008-10-21" ;
    dcterms:modified "2010-04-13" ;
    rdfs:comment "Geographic coordinates expressed as latitude and longitude."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> .

<http://www.agls.gov.au/agls/terms/JuriClass> a owl:Class ;
    rdfs:label "Jurisdiction Class"@en-au ;
    dcterms:issued "2007-12-12" ;
    dcterms:modified "2009-02-02" ;
    rdfs:comment "A set of jurisdiction encoding schemes and/or formats"@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> .

<http://www.agls.gov.au/agls/terms/ServiceClass> a owl:Class ;
    rdfs:label "Service Class"@en-au ;
    dcterms:issued "2007-12-12" ;
    dcterms:modified "2010-04-13" ;
    rdfs:comment "A set of service encoding schemes and/or formats"@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> .

<http://www.agls.gov.au/agls/terms/act> a owl:AnnotationProperty ;
    rdfs:label "Act"@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2009-02-02" ;
    dcterms:type rdf:Property ;
    rdfs:comment "A specific piece of legislation which requires or drives the creation or provision of the resource."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf <http://www.agls.gov.au/agls/1.2/mandate>,
        <http://www.agls.gov.au/agls/terms/mandate> .

<http://www.agls.gov.au/agls/terms/aggregationLevel> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Aggregation Level"@en-au ;
    dcterms:description "There are only two values possible for this refinement, either item or collection."@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2007-12-19" ;
    dcterms:type rdf:Property ;
    rdfs:comment "The level of aggregation of the described resource."@en-au ;
    rdfs:domain dcterms:Collection ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf dc:type,
        dcterms:type .

<http://www.agls.gov.au/agls/terms/agls-audience> a owl:Class ;
    rdfs:label "AGLS Audience Vocabulary"@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2009-02-02" ;
    rdfs:comment "The set of audience types specified by the AGLS Audience Scheme."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:seeAlso <http://www.agls.gov.au/documents/agls-audience/> .

<http://www.agls.gov.au/agls/terms/availability> a owl:AnnotationProperty ;
    rdfs:label "Availability"@en-au ;
    dcterms:issued "2007-12-19" ;
    dcterms:modified "2009-02-02" ;
    dcterms:type rdf:Property ;
    rdfs:comment "How the resource can be obtained or accessed, or contact information."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf <http://www.agls.gov.au/agls/1.2/availability> .

<http://www.agls.gov.au/agls/terms/case> a owl:AnnotationProperty ;
    rdfs:label "Case"@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2009-02-02" ;
    dcterms:type rdf:Property ;
    rdfs:comment "A specific piece of case law which requires or drives the creation or provision of the resource."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf <http://www.agls.gov.au/agls/1.2/mandate>,
        <http://www.agls.gov.au/agls/terms/mandate> .

<http://www.agls.gov.au/agls/terms/category> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Category"@en-au ;
    dcterms:description "There are only three valid values for this property, 'service', 'document' or 'agency'."@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2009-02-02" ;
    dcterms:type rdf:Property ;
    rdfs:comment "The generic type of the resource being described."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf dc:type,
        dcterms:type .

<http://www.agls.gov.au/agls/terms/dateLicensed> a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "Date Licensed"@en-au ;
    dcterms:issued "2007-12-12" ;
    dcterms:modified "2009-02-02" ;
    dcterms:type rdf:Property ;
    rdfs:comment "Date a license was applied or became effective."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date,
        dcterms:date .

<http://www.agls.gov.au/agls/terms/documentType> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Document Type"@en-au ;
    dcterms:description "Document is used in its widest sense and includes such things as software, sound files and images."@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2007-12-19" ;
    dcterms:type rdf:Property ;
    rdfs:comment "The form of the resource where category = 'document'."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf dc:type,
        dcterms:type .

<http://www.agls.gov.au/agls/terms/function> a owl:AnnotationProperty ;
    rdfs:label "Function"@en-au ;
    dcterms:issued "2007-12-19" ;
    dcterms:modified "2007-12-19" ;
    dcterms:type rdf:Property ;
    rdfs:comment "The business function to which the resource relates."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf <http://www.agls.gov.au/agls/1.2/function> .

<http://www.agls.gov.au/agls/terms/jurisdiction> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Jurisdiction"@en-au ;
    dcterms:description "Jurisdiction is a description of the territory over which a particular government exercises its authority or a particular business transacts its operations, to which the resource content is applicable."@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2007-12-19" ;
    dcterms:type rdf:Property ;
    rdfs:comment "The name of the political/administrative entity covered by the resource."@en-au ;
    rdfs:domain dcterms:Jurisdiction ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf dc:coverage,
        dcterms:coverage .

<http://www.agls.gov.au/agls/terms/protectiveMarking> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Protective Marking"@en-au ;
    dcterms:issued "2007-12-12" ;
    dcterms:modified "2009-02-06" ;
    dcterms:type rdf:Property ;
    rdfs:comment "A protective marking applied to the resource."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf dc:rights,
        dcterms:rights .

<http://www.agls.gov.au/agls/terms/regulation> a owl:AnnotationProperty ;
    rdfs:label "Regulation"@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2009-02-02" ;
    dcterms:type rdf:Property ;
    rdfs:comment "A specific regulation which requires or drives the creation or provision of the resource."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf <http://www.agls.gov.au/agls/1.2/mandate>,
        <http://www.agls.gov.au/agls/terms/mandate> .

<http://www.agls.gov.au/agls/terms/serviceType> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Service Type"@en-au ;
    dcterms:issued "2002-04-18" ;
    dcterms:modified "2007-12-19" ;
    dcterms:type rdf:Property ;
    rdfs:comment "The form of the resource where category = 'service'."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf dc:type,
        dcterms:type .

<http://creativecommons.org/licenses/by/4.0/> a owl:NamedIndividual .

dc:contributor rdfs:label "Contributor"@en ;
    dcterms:description "Examples of a Contributor include a person, an organization, or a service. Typically, the name of a Contributor should be used to indicate the entity."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#contributor-006> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity responsible for making contributions to the resource."@en ;
    rdfs:isDefinedBy dc: ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dc:creator rdfs:label "Creator"@en ;
    dcterms:description "Examples of a Creator include a person, an organization, or a service. Typically, the name of a Creator should be used to indicate the entity."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#creator-006> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity primarily responsible for making the resource."@en ;
    rdfs:isDefinedBy dc: ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dc:language a owl:AnnotationProperty ;
    rdfs:label "Language"@en ;
    dcterms:description "Recommended best practice is to use a controlled vocabulary such as RFC 4646 [RFC4646]."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#language-007> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A language of the resource."@en ;
    rdfs:isDefinedBy dc: ;
    rdfs:seeAlso <http://www.ietf.org/rfc/rfc4646.txt> ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dc:mandate a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty ;
    rdfs:label "Publisher"@en ;
    dcterms:description "Examples of a Publisher include a person, an organization, or a service. Typically, the name of a Publisher should be used to indicate the entity."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#publisher-006> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "An entity responsible for making the resource available."@en ;
    rdfs:isDefinedBy dc: ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dc:source a owl:AnnotationProperty ;
    rdfs:label "Source"@en ;
    dcterms:description "The described resource may be derived from the related resource in whole or in part. Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#source-006> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource from which the described resource is derived."@en ;
    rdfs:isDefinedBy dc: ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dc:subject a owl:ObjectProperty ;
    rdfs:label "Subject"@en ;
    dcterms:description "Typically, the subject will be represented using keywords, key phrases, or classification codes. Recommended best practice is to use a controlled vocabulary."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#subject-007> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2012-06-14"^^xsd:date ;
    rdfs:comment "The topic of the resource."@en ;
    rdfs:isDefinedBy dc: ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dcterms:BibliographicResource a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Bibliographic Resource"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#BibliographicResource-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A book, article, or other documentary resource."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:Frequency a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Frequency"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Frequency-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A rate at which something recurs."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:Jurisdiction a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Jurisdiction"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Jurisdiction-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "The extent or range of judicial, law enforcement, or other authority."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:subClassOf dcterms:LocationPeriodOrJurisdiction .

dcterms:LinguisticSystem a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Linguistic System"@en ;
    dcterms:description "Examples include written, spoken, sign, and computer languages."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#LinguisticSystem-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A system of signs, symbols, sounds, gestures, or rules used in communication."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:Location a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Location"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Location-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A spatial region or named place."@en ;
