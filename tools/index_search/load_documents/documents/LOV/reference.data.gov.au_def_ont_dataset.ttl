dcterms:RightsStatement a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Rights Statement"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#RightsStatement-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A statement about the intellectual property rights (IPR) held in or over a Resource, a legal document giving official permission to do something with a resource, or a statement about access rights."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:coverage a owl:AnnotationProperty,
        owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "Coverage"@en ;
    dcterms:description "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended best practice is to use a controlled vocabulary such as the Thesaurus of Geographic Names [TGN]. Where appropriate, named places or time periods can be used in preference to numeric identifiers such as sets of coordinates or date ranges."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#coverageT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The spatial or temporal topic of the resource, the spatial applicability of the resource, or the jurisdiction under which the resource is relevant."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range dcterms:LocationPeriodOrJurisdiction ;
    rdfs:subPropertyOf dc:coverage .

dcterms:rights a owl:AnnotationProperty,
        owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "Rights"@en ;
    dcterms:description "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#rightsT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Information about rights held in and over the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range dcterms:RightsStatement ;
    rdfs:subPropertyOf dc:rights .

<http://reference.data.gov.au/def/ont/dataset#Classifier> a owl:Class ;
    rdfs:comment "A classifier used for Australian Government Data."@en ;
    rdfs:subClassOf skos:Concept .

<http://reference.data.gov.au/def/ont/dataset#DatasetChangeEvent> a owl:Class ;
    rdfs:label "Dataset Change Event"@en ;
    rdfs:comment "A Dataset Change Event is a description of an event that happens at a given point in time and that results in any type of change to the Dataset."@en ;
    rdfs:subClassOf prov:Activity .

<http://reference.data.gov.au/def/ont/dataset#Organisation> a owl:Class ;
    rdfs:label "Organisation"@en ;
    rdfs:comment "An Organisation is a kind of Agent representing, for example, a business or government, or organisational subunits thereof."@en ;
    rdfs:subClassOf dcterms:Agent,
        prov:Organization .

<http://reference.data.gov.au/def/ont/dataset#SpatialThing> a owl:Class ;
    rdfs:label "Spatial Thing"@en ;
    rdfs:comment "This is a stub class which allows us to defer which external vocabulary to adopt. Adoption can be at run-time through a owl:equivalentClass axiom in the data - likely to be  w3 geo or OGC GeoSPARQL or both, or something else as proposed by SDWWG."^^xsd:string,
        "A Spatial Thing describes the spatial characteristics of the resources within a Dataset, i.e. the geographical area where data was collected, a place which is the predominant subject of the Dataset, or a location which is the focus of an activity described in the Dataset."@en ;
    rdfs:subClassOf geo:SpatialObject .

<http://www.agls.gov.au/agls/terms/mandate> a owl:AnnotationProperty ;
    rdfs:label "Mandate"@en-au ;
    dcterms:issued "2007-12-19" ;
    dcterms:modified "2009-02-02" ;
    dcterms:type rdf:Property ;
    rdfs:comment "A specific legal instrument which requires a resource to be created or made available."@en-au ;
    rdfs:isDefinedBy <http://www.agls.gov.au/agls/terms/> ;
    rdfs:subPropertyOf dc:mandate,
        <http://www.agls.gov.au/agls/1.2/mandate> .

dc:coverage a owl:AnnotationProperty ;
    rdfs:label "Coverage"@en ;
    dcterms:description "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended best practice is to use a controlled vocabulary such as the Thesaurus of Geographic Names [TGN]. Where appropriate, named places or time periods can be used in preference to numeric identifiers such as sets of coordinates or date ranges."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#coverage-006> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The spatial or temporal topic of the resource, the spatial applicability of the resource, or the jurisdiction under which the resource is relevant."@en ;
    rdfs:isDefinedBy dc: ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dc:rights a owl:AnnotationProperty ;
    rdfs:label "Rights"@en ;
    dcterms:description "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#rights-006> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Information about rights held in and over the resource."@en ;
    rdfs:isDefinedBy dc: ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dcterms:AgentClass a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Agent Class"@en ;
    dcterms:description "Examples of Agent Class include groups seen as classes, such as students, women, charities, lecturers."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#AgentClass-003> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2012-06-14"^^xsd:date ;
    rdfs:comment "A group of agents."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:subClassOf rdfs:Class .

dcterms:LocationPeriodOrJurisdiction a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Location, Period, or Jurisdiction"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#LocationPeriodOrJurisdiction-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A location, period of time, or jurisdiction."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:type a owl:AnnotationProperty,
        owl:NamedIndividual,
        owl:ObjectProperty ;
    rdfs:label "Type"@en ;
    dcterms:description "Recommended best practice is to use a controlled vocabulary such as the DCMI Type Vocabulary [DCMITYPE]. To describe the file format, physical medium, or dimensions of the resource, use the Format element."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#typeT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The nature or genre of the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Class ;
    rdfs:subPropertyOf dc:type .

<http://reference.data.gov.au/def/ont/dataset#LevelOfGovernment> a owl:Class ;
    rdfs:label "Level of Government"@en ;
    rdfs:comment "Level of Government is a description that is used to describe the Jurisidiction of an Organisation."@en .

<http://reference.data.gov.au/def/ont/dataset#Locality> a owl:Class ;
    rdfs:comment "Locality is a Spatial Thing corresponding to a place or area, which is denoted by a commonly recognised, or formally designated, name or description."^^xsd:string ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#SpatialThing> .

<http://www.agls.gov.au/agls/1.2/mandate> a owl:AnnotationProperty .

dc:type a owl:AnnotationProperty ;
    rdfs:label "Type"@en ;
    dcterms:description "Recommended best practice is to use a controlled vocabulary such as the DCMI Type Vocabulary [DCMITYPE]. To describe the file format, physical medium, or dimensions of the resource, use the Format element."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#type-006> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The nature or genre of the resource."@en ;
    rdfs:isDefinedBy dc: ;
    skos:note "A second property with the same name as this property has been declared in the dcterms: namespace (http://purl.org/dc/terms/).  See the Introduction to the document \"DCMI Metadata Terms\" (http://dublincore.org/documents/dcmi-terms/) for an explanation."@en .

dcterms:Agent a dcterms:AgentClass,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Agent"@en ;
    dcterms:description "Examples of Agent include person, organization, and software agent."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Agent-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A resource that acts or has the power to act."@en ;
    rdfs:isDefinedBy dcterms: .

<http://reference.data.gov.au/def/ont/dataset#Dataset> a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A Dataset is a collection of resources, published or curated by an agent, and openly available for download in one or more formats."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://reference.data.gov.au/def/ont/dataset#agiftFunction> ],
        [ a owl:Restriction ;
            owl:onProperty <http://reference.data.gov.au/def/ont/dataset#dateChangeEvent> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:license ;
            owl:someValuesFrom dcterms:LicenseDocument ],
        [ a owl:Restriction ;
            owl:onProperty <http://reference.data.gov.au/def/ont/dataset#dateUpdated> ;
            owl:someValuesFrom rdfs:Literal ],
        dcat:Dataset,
        prov:Entity .

dcam:VocabularyEncodingScheme a owl:Class .

dcterms:date a owl:AnnotationProperty,
        owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "Date"@en ;
    dcterms:description "Date may be used to express temporal information at any level of granularity.  Recommended best practice is to use an encoding scheme, such as the W3CDTF profile of ISO 8601 [W3CDTF]."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#dateT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date .

dc:date rdfs:label "Date"@en ;
    dcterms:description "Date may be used to express temporal information at any level of granularity.  Recommended best practice is to use an encoding scheme, such as the W3CDTF profile of ISO 8601 [W3CDTF]."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#date-006> ;
    dcterms:issued "1999-07-02"^^xsd:date ;
