dcterms:tableOfContents a owl:AnnotationProperty,
        owl:NamedIndividual ;
    rdfs:label "Table Of Contents"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#tableOfContents-003> ;
    dcterms:issued "2000-07-11"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
