dcterms:valid a owl:AnnotationProperty,
        owl:DatatypeProperty,
        owl:NamedIndividual ;
    rdfs:label "Date Valid"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#valid-003> ;
    dcterms:issued "2000-07-11"^^xsd:date ;
