<http://reference.data.gov.au/def/ont/dataset#AGIFTFunction> a owl:Class ;
    rdfs:label "Function"@en ;
    dc:source <http://www.agls.gov.au/agls/terms/FunctionClass> ;
    rdfs:comment "The Government Function defined by the Australian Governments' Interactive Functions Thesaurus that best describes the data contained within a Dataset."@en ;
    rdfs:seeAlso <https://data.naa.gov.au/def/agift/export/def/agift.rdf> ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#Classifier> .

<http://reference.data.gov.au/def/ont/dataset#Distribution> a owl:Class ;
    rdfs:label "Distribution"@en ;
    rdfs:comment "A Distribution defines the available form of a Dataset, i.e. different formats of the Dataset or different type of endpoints the Dataset can be retrieved from."@en ;
    rdfs:subClassOf dcat:Distribution,
        prov:Entity .

<http://reference.data.gov.au/def/ont/dataset#LocalGovernmentArea> a owl:Class ;
    rdfs:label "Local Government"@en ;
    rdfs:comment "Local Government is the lowest tier of government in the Commonwealth of Australia administered under the states and territories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://reference.data.gov.au/def/ont/dataset#inState> ],
        <http://reference.data.gov.au/def/ont/dataset#LevelOfGovernment> .

<http://reference.data.gov.au/def/ont/dataset#MaintenanceResponsibility> a owl:Class ;
    rdfs:label "Dataset Maintenance Arrangement"@en ;
    rdfs:comment "Provides information about the maintenance arrangements for the dataset. At a minimum the Agent and start-time for the maintenance responsibility is required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty prov:wasAssociatedWith ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty prov:startedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty prov:endedAtTime ],
        prov:Activity .

<http://reference.data.gov.au/def/ont/dataset#Role> a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:comment "A Role corresponds to the involvement of an Agent in an Event, e.g. fulfilling a publisher, contributor or custodian Role."@en ;
    rdfs:subClassOf prov:Role .

<http://reference.data.gov.au/def/ont/dataset#StateOrTerritory> a owl:Class ;
    rdfs:label "State and Territories Government"@en ;
    rdfs:comment "States and Territories Government are the second tier of Government in the Commonwealth of Australia. The Commonwealth of Australia comprises of six states and various territories some of which enjoy a large degree of self-governance."@en ;
    rdfs:subClassOf <http://reference.data.gov.au/def/ont/dataset#LevelOfGovernment> .

<http://reference.data.gov.au/def/ont/dataset#Timelnterval> a owl:Class ;
    rdfs:label "Time Interval"@en ;
    rdfs:comment "Note that this is a subclass of the Interval class from OWL-Time."^^xsd:string,
        "A Time Interval describes a time period (interval) during which data was collected or observations were made that are described in the Dataset."@en ;
    rdfs:subClassOf time:Interval .

<http://reference.data.gov.au/def/ont/dataset#agiftFunction> a owl:ObjectProperty ;
    rdfs:label "AGIFT Theme"^^xsd:string ;
    rdfs:comment "The AGIFT classification for this dataset"^^xsd:string ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#AGIFTFunction> ;
    rdfs:subPropertyOf <http://reference.data.gov.au/def/ont/dataset#classifiedAs> .

<http://reference.data.gov.au/def/ont/dataset#classifiedAs> a owl:ObjectProperty ;
    rdfs:comment "A relation to define the main category of the dataset. A dataset can have multiple themes."@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#Dataset> ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#Classifier> ;
    rdfs:subPropertyOf dcat:theme .

<http://reference.data.gov.au/def/ont/dataset#dateUpdated> a owl:DatatypeProperty ;
    rdfs:label "Update Date"@en ;
    rdfs:comment "A relation to define when the Dataset was updated, i.e. a minor change that is not reflected in a Dataset Change Event."@en ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://reference.data.gov.au/def/ont/dataset#dateChangeEvent> .

<http://reference.data.gov.au/def/ont/dataset#inCatalog> a owl:ObjectProperty .

<http://reference.data.gov.au/def/ont/dataset#inState> a owl:ObjectProperty ;
    rdfs:comment "Defines the State or Territory a Locality is located in."@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/dataset#Locality> ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#StateOrTerritory> .

<http://reference.data.gov.au/def/ont/dataset#isMemberOf> a owl:ObjectProperty ;
    rdfs:comment "Defines a relation that denotes the beloning of an Agent to an Organisation."@en ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Agent> ;
    rdfs:range <http://reference.data.gov.au/def/ont/dataset#Organisation> .

<http://reference.data.gov.au/def/ont/dataset#participatesIn> a owl:ObjectProperty .

<http://reference.data.gov.au/def/ont/dataset#resultedIn> a owl:ObjectProperty .

<http://reference.data.gov.au/def/ont/dataset#roleOf> a owl:ObjectProperty .

<http://www.agls.gov.au/agls/1.2/availability> a owl:AnnotationProperty .

<http://www.agls.gov.au/agls/1.2/function> a owl:AnnotationProperty .

