@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://cookingbigdata.com/linkeddata/ccinstances> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://cookingbigdata.com/linkeddata/ccinstances#Instance> a rdfs:Class,
        owl:Class ;
    rdfs:label "Instance"@en ;
    rdfs:comment "Instance"@en ;
    rdfs:isDefinedBy onto: .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu> a rdfs:Class,
        owl:Class ;
    rdfs:label "CPU"@en ;
    rdfs:comment "CPU"@en ;
    rdfs:isDefinedBy onto: .

<http://cookingbigdata.com/linkeddata/ccinstances#gpu> a rdfs:Class,
        owl:Class ;
    rdfs:label "GPU"@en ;
    rdfs:comment "GPU"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://cookingbigdata.com/linkeddata/ccinstances#cpu> .

<http://cookingbigdata.com/linkeddata/ccinstances#network> a rdfs:Class,
        owl:Class ;
    rdfs:label "Network"@en ;
    rdfs:comment "Network"@en ;
    rdfs:isDefinedBy onto: .

<http://cookingbigdata.com/linkeddata/ccinstances#ram> a rdfs:Class,
        owl:Class ;
    rdfs:label "RAM"@en ;
    rdfs:comment "RAM"@en ;
    rdfs:isDefinedBy onto: .

<http://cookingbigdata.com/linkeddata/ccinstances#storage> a rdfs:Class,
        owl:Class ;
    rdfs:label "Storage"@en ;
    rdfs:comment "Storage"@en ;
    rdfs:isDefinedBy onto: .

<http://cookingbigdata.com/linkeddata/ccinstances#> a owl:Ontology ;
    rdfs:label "Cloud Instances definition"@en ;
    ns1:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:created "2018-03-06"^^xsd:date ;
    dcterms:creator <http://cookingbigdata.com/linkeddata/ccinstances#manuelparra> ;
    dcterms:description "Ontology for Cloud Computing Instances. Instance are classes of VM that comprise varying combinations of CPU, memory, storage, and networking capacity. This ontology allows to define the instantiation model of MVs used in large cloud computing providers such as Amazon, Azure, etc."@en ;
    dcterms:issued "2018-04-20"^^xsd:date ;
    dcterms:modified "2018-04-03"^^xsd:date ;
    dcterms:publisher <http://cookingbigdata.com/linkeddata/ccinstances#cookingbigdata> ;
    dcterms:rights "Copyright © 2018 Manuel Parra-Royón" ;
    dcterms:title "Ontology for Cloud Computing instances"@en ;
    owl:versionInfo 1.0 .

<http://cookingbigdata.com/linkeddata/ccinstances#code> a rdf:Property ;
    rdfs:label "Short Code"@en ;
    rdfs:comment "Instance group code"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#Instance> ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu_cache> a rdf:Property ;
    rdfs:label "CPU Cache"@en ;
    rdfs:comment "CPU Cache is an area of fast memory located on the processor. It refers to the architecture that allows all cores to dynamically share access to the last level cache."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#cpu> ;
    rdfs:range xsd:integer .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu_code> a rdf:Property ;
    rdfs:label "CPU ID"@en ;
    rdfs:comment "Processor Number. For example: i5-8600T"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#cpu> ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu_consumition> a rdf:Property ;
    rdfs:label "CPU TDP"@en ;
    rdfs:comment "CPU Thermal Design Power (TDP) represents the average power, in watts, the processor dissipates when operating at Base Frequency with all cores active under an Intel-defined, high-complexity workload"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#cpu> ;
    rdfs:range xsd:decimal .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu_cores> a rdf:Property ;
    rdfs:label "CPU cores"@en ;
    rdfs:comment "Numer of physical cores. For example: 6"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#cpu> ;
    rdfs:range xsd:integer .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu_frecuency> a rdf:Property ;
    rdfs:label "CPU Frecuency"@en ;
    rdfs:comment "Processor Base Frequency describes the rate at which the processor's transistors open and close. The processor base frequency is the operating point where TDP is defined. Frequency is measured in gigahertz (GHz), or billion cycles per second."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#cpu> ;
    rdfs:range xsd:decimal .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu_max_frecuency> a rdf:Property ;
    rdfs:label "CPU Max Frecuency"@en ;
    rdfs:comment "Max turbo frequency is the maximum single core frequency at which the processor is capable of operating using Intel® Turbo Boost Technology. Frequency is measured in gigahertz (GHz), or billion cycles per second."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#cpu> ;
    rdfs:range xsd:decimal .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu_model> a rdf:Property ;
    rdfs:label "CPU Model"@en ;
    rdfs:comment "Model of CPU. For example: 8th Generation Intel® Core™ i5 Processors"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#cpu> ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu_spped> a rdf:Property ;
    rdfs:label "CPU bus speed"@en ;
    rdfs:comment "A bus is a subsystem that transfers data between computer components or between computers. Types include (FSB) (DMI) (Intel I/O) (QPI)"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#cpu> ;
    rdfs:range xsd:integer .

<http://cookingbigdata.com/linkeddata/ccinstances#cpu_threads> a rdf:Property ;
    rdfs:label "CPU threads"@en ;
    rdfs:comment "CPU threads"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#cpu> ;
    rdfs:range xsd:integer .

<http://cookingbigdata.com/linkeddata/ccinstances#hasCPU> a rdf:Property ;
    rdfs:label "Has CPU"@en ;
    rdfs:comment "Specifies that the instance is provided with CPU"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#Instance> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccinstances#cpu> .

<http://cookingbigdata.com/linkeddata/ccinstances#hasNetwork> a rdf:Property ;
    rdfs:label "Has network"@en ;
    rdfs:comment "Specifies that the instance is provided with network"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#Instance> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccinstances#network> .

<http://cookingbigdata.com/linkeddata/ccinstances#hasRAM> a rdf:Property ;
    rdfs:label "Has RAM"@en ;
    rdfs:comment "Specifies that the instance is provided with RAM"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#Instance> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccinstances#ram> .

<http://cookingbigdata.com/linkeddata/ccinstances#hasStorage> a rdf:Property ;
    rdfs:label "Has storage"@en ;
    rdfs:comment "Specifies that the instance is provided with storage"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#Instance> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://cookingbigdata.com/linkeddata/ccinstances#storage> .

<http://cookingbigdata.com/linkeddata/ccinstances#model> a rdf:Property ;
    rdfs:label "Model Code"@en ;
    rdfs:comment "Unique identifier of the instance. It allows to know the name of the instance in a quick way. For instance: t2.medium"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#Instance> ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccinstances#network_bandwidth> a rdf:Property ;
    rdfs:label "Network bandwidth"@en ;
    rdfs:comment "Network bandwidth in Mbps. For example: 1000 Mbps"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#network> ;
    rdfs:range xsd:decimal .

<http://cookingbigdata.com/linkeddata/ccinstances#ram_frecuency> a rdf:Property ;
    rdfs:label "RAM frecuency"@en ;
    rdfs:comment "RAM frecuency in MHz. For example: 2300 MHz"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#ram> ;
    rdfs:range xsd:integer .

<http://cookingbigdata.com/linkeddata/ccinstances#ram_size> a rdf:Property ;
    rdfs:label "RAM size"@en ;
    rdfs:comment "RAM size of the instance. For example: 256 GB"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#ram> ;
    rdfs:range xsd:integer .

<http://cookingbigdata.com/linkeddata/ccinstances#ram_type> a rdf:Property ;
    rdfs:label "RAM Type"@en ;
    rdfs:comment "RAM Type. For example: DDR3"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#ram> ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccinstances#storage_bandwidth> a rdf:Property ;
    rdfs:label "Storage Bandwidth"@en ;
    rdfs:comment "Storage bandwidth in MB/s"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#storage> ;
    rdfs:range xsd:integer .

<http://cookingbigdata.com/linkeddata/ccinstances#storage_size> a rdf:Property ;
    rdfs:label "Storage size"@en ;
    rdfs:comment "Storage size. For example: 500 GB"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#storage> ;
    rdfs:range xsd:decimal .

<http://cookingbigdata.com/linkeddata/ccinstances#storage_technology> a rdf:Property ;
    rdfs:label "Storage Technology"@en ;
    rdfs:comment "Storage Technology. For instance: SSD/HDD/..."@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#storage> ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccinstances#type> a rdf:Property ;
    rdfs:label "Type Code"@en ;
    rdfs:comment "Name that groups together instances of the same or similar type under a common name; for example: Basic Group"@en ;
    rdfs:domain <http://cookingbigdata.com/linkeddata/ccinstances#Instance> ;
    rdfs:range xsd:string .

<http://cookingbigdata.com/linkeddata/ccinstances#cookingbigdata> a foaf:Organization ;
    rdfs:seeAlso <http://cookingbigdata.com/about> ;
    foaf:homepage <http://cookingbigdata.com> ;
    foaf:name "CookingBigData" .

<http://cookingbigdata.com/linkeddata/ccinstances#manuelparra> a foaf:Person ;
    rdfs:seeAlso <https://twitter.com/manugrapevine> ;
    foaf:homepage <https://twitter.com/manugrapevine> ;
    foaf:mbox "manuparra@gmail.com" ;
    foaf:name "Manuel Parra-Royon" .

