@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/ns/adms#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <http://ontology.eil.utoronto.ca/icontact.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns2:license a owl:AnnotationProperty .

onto: a owl:Ontology ;
    ns2:license "http://creativecommons.org/licenses/by/3.0/" ;
    dcterms:creator "Mark S. Fox, http://eil.utoronto.ca/profiles/foxpro.html\\nEnterprise Integration Laboratory, http://eil.utoronto.ca\\nUniversity of Toronto, \\nmsf@eil.utoronto.ca"@en ;
    dcterms:description "International Contact Ontology: \\n\\nhttp://ontology.eil.utoronto.ca/icontact.html\\n\\nThis ontology provides basic classes and more detailed properties for  representating international street addresses, phone numbers and emails.  Rather than using existing ontologies, such as vcard, it was decided to create a new one as the vcard and foaf ignore the details of international addresses, phone numbers, etc.\\n\\nThe important part of the ontology are the object and data properties used to describe addresses primarily and phone numbers."@en ;
    dcterms:modified "16 April 2015"@en ;
    dcterms:title "International Contact (Address) Ontology: Addresses, phone numbers and emails."@en ;
    vann:preferredNamespacePrefix "ic" ;
    vann:preferredNamespaceUri "http://ontology.eil.utoronto.ca/icontact.owl#" ;
    ns1:relatedDocumentation "http://ontology.eil.utoronto.ca/icontact.html" .

<http://ontology.eil.utoronto.ca/icontact.owl#CellNumber> a owl:Class ;
    rdfs:label "Mobile Telephone Number"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icontact.owl#CellPhone> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasPhoneType> ],
        <http://ontology.eil.utoronto.ca/icontact.owl#PhoneNumber> .

<http://ontology.eil.utoronto.ca/icontact.owl#CottageAddress> a owl:Class ;
    rdfs:label "Cottage Address"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icontact.owl#Cottage> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasAddressType> ],
        <http://ontology.eil.utoronto.ca/icontact.owl#Address> .

<http://ontology.eil.utoronto.ca/icontact.owl#FaxNumber> a owl:Class ;
    rdfs:label "Fax Telephone Number"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icontact.owl#FaxPhone> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasPhoneType> ],
        <http://ontology.eil.utoronto.ca/icontact.owl#PhoneNumber> .

<http://ontology.eil.utoronto.ca/icontact.owl#Friday> a <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek>,
        owl:NamedIndividual ;
    rdfs:label "Friday"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#HomeAddress> a owl:Class ;
    rdfs:label "Home Address"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icontact.owl#Home> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasAddressType> ],
        <http://ontology.eil.utoronto.ca/icontact.owl#Address> .

<http://ontology.eil.utoronto.ca/icontact.owl#HomeNumber> a owl:Class ;
    rdfs:label "Home Telephone Number"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icontact.owl#HomePhone> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasPhoneType> ],
        <http://ontology.eil.utoronto.ca/icontact.owl#PhoneNumber> .

<http://ontology.eil.utoronto.ca/icontact.owl#Monday> a <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek>,
        owl:NamedIndividual ;
    rdfs:label "Monday"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Saturday> a <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek>,
        owl:NamedIndividual ;
    rdfs:label "Saturday"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Sunday> a <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek>,
        owl:NamedIndividual ;
    rdfs:label "Sunday"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Thursday> a <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek>,
        owl:NamedIndividual ;
    rdfs:label "Thursday"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#TollFreeNumber> a owl:Class ;
    rdfs:label "Toll  Free Telephone Number"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icontact.owl#TollFreePhone> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasPhoneType> ],
        <http://ontology.eil.utoronto.ca/icontact.owl#PhoneNumber> .

<http://ontology.eil.utoronto.ca/icontact.owl#Tuesday> a <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek>,
        owl:NamedIndividual ;
    rdfs:label "Tuesday"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Wednesday> a <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek>,
        owl:NamedIndividual ;
    rdfs:label "Wednesday"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#WorkAddress> a owl:Class ;
    rdfs:label "Work Address"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icontact.owl#Work> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasAddressType> ],
        <http://ontology.eil.utoronto.ca/icontact.owl#Address> .

<http://ontology.eil.utoronto.ca/icontact.owl#WorkNumber> a owl:Class ;
    rdfs:label "Work Telephone Number"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://ontology.eil.utoronto.ca/icontact.owl#WorkPhone> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasPhoneType> ],
        <http://ontology.eil.utoronto.ca/icontact.owl#PhoneNumber> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasAddress> a owl:ObjectProperty ;
    rdfs:comment "hasAddress links any class to the Address class."@en ;
    rdfs:range <http://ontology.eil.utoronto.ca/icontact.owl#Address> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#contactProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasDate> a owl:DatatypeProperty ;
    rdfs:label "has Date"@en ;
    dcterms:description "Specifies the opening and closing times for a specific date.  For example, used to provide times for a holiday which deviates from the norm."@en ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#operatingDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasEmail> a owl:ObjectProperty ;
    rdfs:label "has Email"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#contactProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasGeoCoordinates> a owl:ObjectProperty ;
    rdfs:label "has Geo Coordinates"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasLocation> a owl:DatatypeProperty ;
    rdfs:label "has Location"@en ;
    dcterms:description "Closet street intersection for the organization."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#hasContactDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasOperatingHours> a owl:ObjectProperty ;
    rdfs:label "has Operating Hours"@en ;
    rdfs:range <http://ontology.eil.utoronto.ca/icontact.owl#HoursOfOperation> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#OperatingProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasPersonalEmail> a owl:DatatypeProperty ;
    rdfs:label "has Personal Email"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#emailDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasTelephone> a owl:ObjectProperty ;
    rdfs:label "has Telephone"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#contactProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasWebSite> a owl:DatatypeProperty ;
    rdfs:label "has Web Site"@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#hasContactDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasWorkEmail> a owl:DatatypeProperty ;
    rdfs:label "has Work Email"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#emailDataProperty> .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://schema.org/GeoCoordinates> a owl:Class ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icontact.owl#SchemaOrgThing> .

ns1:relatedDocumentation a owl:AnnotationProperty .

<http://ontology.eil.utoronto.ca/icontact.owl#Avenue> a owl:NamedIndividual ;
    rdfs:label "Avenue"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Boulevard> a owl:NamedIndividual ;
    rdfs:label "Boulevard"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Circle> a owl:NamedIndividual ;
    rdfs:label "Circle"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Crescent> a owl:NamedIndividual ;
    rdfs:label "Crescent"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Drive> a owl:NamedIndividual ;
    rdfs:label "Drive"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#East> a owl:NamedIndividual ;
    rdfs:label "East"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#North> a owl:NamedIndividual ;
    rdfs:label "North"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Road> a owl:NamedIndividual ;
    rdfs:label "Road"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#South> a owl:NamedIndividual ;
    rdfs:label "South"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Street> a owl:NamedIndividual ;
    rdfs:label "Street"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#West> a owl:NamedIndividual ;
    rdfs:label "West"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#dayofWeek> a owl:ObjectProperty ;
    rdfs:comment "Specifies the day of the week, e.g., Monday, that the times apply to.  This is the default for that day and can be overidden by the \"hasDate\" property."@en ;
    rdfs:range <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#OperatingProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasAreaCode> a owl:DatatypeProperty ;
    rdfs:label "has Area Code"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#telephoneDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasBuilding> a owl:DatatypeProperty ;
    rdfs:label "has Building"@en ;
    dcterms:description "The building where the address is located.  Often used in countries like England, India and Japan."@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasCity> a owl:ObjectProperty ;
    dcterms:description "has City"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasCitySection> a owl:DatatypeProperty ;
    rdfs:label "has City Section"@en ;
    dcterms:description "The section of the city where the address is located.  Often used in countries like England, India and Japan."@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasClosingTime> a owl:DatatypeProperty ;
    rdfs:label "has Closing Time"@en ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#operatingDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasCountry> a owl:ObjectProperty ;
    rdfs:label "has Country"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasCountryCode> a owl:DatatypeProperty ;
    rdfs:label "has Country Code"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#telephoneDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasOpeningTime> a owl:DatatypeProperty ;
    rdfs:label "has Opening Time"@en ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#operatingDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasPhoneNumber> a owl:DatatypeProperty ;
    rdfs:label "has Phone Number"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#telephoneDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasPostalCode> a owl:DatatypeProperty ;
    rdfs:label "has Postal Code"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasState> a owl:ObjectProperty ;
    rdfs:label "has State"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasStreet> a owl:DatatypeProperty ;
    rdfs:label "has Street"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasStreetDirection> a owl:ObjectProperty ;
    rdfs:label "has Street Direction"@en ;
    rdfs:domain <http://ontology.eil.utoronto.ca/icontact.owl#Address> ;
    rdfs:range <http://ontology.eil.utoronto.ca/icontact.owl#StreetDirection> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasStreetNumber> a owl:DatatypeProperty ;
    rdfs:label "has Street Number"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasStreetType> a owl:ObjectProperty ;
    rdfs:label "has Street Type"@en ;
    rdfs:domain <http://ontology.eil.utoronto.ca/icontact.owl#Address> ;
    rdfs:range <http://ontology.eil.utoronto.ca/icontact.owl#StreetType> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#hasUnitNumber> a owl:DatatypeProperty ;
    rdfs:label "has Unit Number"@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressDataProperty> .

<http://schema.org/City> a owl:Class ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icontact.owl#SchemaOrgThing> .

<http://schema.org/Country> a owl:Class ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icontact.owl#SchemaOrgThing> .

<http://schema.org/State> a owl:Class ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icontact.owl#SchemaOrgThing> .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty ;
    rdfs:label "lattitude"@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressDataProperty> .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#AddressType> a owl:Class ;
    rdfs:label "Address Type"@en ;
    dcterms:description "Different type for home, office, cottage, etc."@en ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icontact.owl#iContactThing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://ontology.eil.utoronto.ca/icontact.owl#Cottage> <http://ontology.eil.utoronto.ca/icontact.owl#Home> <http://ontology.eil.utoronto.ca/icontact.owl#Work> ) ] .

<http://ontology.eil.utoronto.ca/icontact.owl#CellPhone> a owl:NamedIndividual ;
    rdfs:label "Cell Phone"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Cottage> a owl:NamedIndividual ;
    rdfs:label "Cottage Address"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#FaxPhone> a owl:NamedIndividual ;
    rdfs:label "Fax Line"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Home> a owl:NamedIndividual ;
    rdfs:label "Home Address"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#HomePhone> a owl:NamedIndividual ;
    rdfs:label "Home Phone"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#HoursOfOperation> a owl:Class ;
    dcterms:description "HoursOfOperation class provides the ability to define when the contact \"opens\" and \"closes\". Used for businesses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#dayofWeek> ;
            owl:someValuesFrom <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasClosingTime> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasOpeningTime> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://ontology.eil.utoronto.ca/icontact.owl#iContactThing> .

<http://ontology.eil.utoronto.ca/icontact.owl#OperatingProperty> a owl:ObjectProperty ;
    dcterms:description "Properties that define the hours of operation of the contact."@en ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#contactProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#TollFreePhone> a owl:NamedIndividual ;
    rdfs:label "Toll Free Number"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#Work> a owl:NamedIndividual ;
    rdfs:label "WorkAddress"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#WorkPhone> a owl:NamedIndividual ;
    rdfs:label "Work Phone"@en .

<http://ontology.eil.utoronto.ca/icontact.owl#emailDataProperty> a owl:DatatypeProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#hasContactDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#PhoneType> a owl:Class ;
    rdfs:label "Phone Type"@en ;
    dcterms:description "Types of phoned include home, cell, work, etc."@en ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icontact.owl#iContactThing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://ontology.eil.utoronto.ca/icontact.owl#TollFreePhone> <http://ontology.eil.utoronto.ca/icontact.owl#CellPhone> <http://ontology.eil.utoronto.ca/icontact.owl#FaxPhone> <http://ontology.eil.utoronto.ca/icontact.owl#WorkPhone> <http://ontology.eil.utoronto.ca/icontact.owl#HomePhone> ) ] .

<http://ontology.eil.utoronto.ca/icontact.owl#StreetDirection> a owl:Class ;
    rdfs:label "Street Direction"@en ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icontact.owl#iContactThing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://ontology.eil.utoronto.ca/icontact.owl#South> <http://ontology.eil.utoronto.ca/icontact.owl#West> <http://ontology.eil.utoronto.ca/icontact.owl#East> <http://ontology.eil.utoronto.ca/icontact.owl#North> ) ] .

<http://ontology.eil.utoronto.ca/icontact.owl#StreetType> a owl:Class ;
    rdfs:label "Street Type"@en ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icontact.owl#iContactThing> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://ontology.eil.utoronto.ca/icontact.owl#Drive> <http://ontology.eil.utoronto.ca/icontact.owl#Circle> <http://ontology.eil.utoronto.ca/icontact.owl#Boulevard> <http://ontology.eil.utoronto.ca/icontact.owl#Crescent> <http://ontology.eil.utoronto.ca/icontact.owl#Avenue> <http://ontology.eil.utoronto.ca/icontact.owl#Road> <http://ontology.eil.utoronto.ca/icontact.owl#Street> ) ] .

<http://ontology.eil.utoronto.ca/icontact.owl#hasAddressType> a owl:ObjectProperty ;
    rdfs:label "has Address Type"@en ;
    rdfs:range <http://ontology.eil.utoronto.ca/icontact.owl#AddressType> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#addressProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#operatingDataProperty> a owl:DatatypeProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#hasContactDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#telephoneDataProperty> a owl:DatatypeProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#hasContactDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#SchemaOrgThing> a owl:Class .

<http://ontology.eil.utoronto.ca/icontact.owl#PhoneNumber> a owl:Class ;
    rdfs:label "Phone Number"@en ;
    dcterms:description "PhoneNumber is another core class. It is divided into country code, and phone number."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasAreaCode> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasPhoneNumber> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasCountryCode> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://ontology.eil.utoronto.ca/icontact.owl#PhoneType> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasPhoneType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://ontology.eil.utoronto.ca/icontact.owl#iContactThing> .

<http://ontology.eil.utoronto.ca/icontact.owl#contactProperty> a owl:ObjectProperty .

<http://ontology.eil.utoronto.ca/icontact.owl#hasContactDataProperty> a owl:DatatypeProperty .

<http://ontology.eil.utoronto.ca/icontact.owl#hasPhoneType> a owl:ObjectProperty ;
    rdfs:label "has Phone Type"@en ;
    rdfs:range <http://ontology.eil.utoronto.ca/icontact.owl#PhoneType> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#contactProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#addressProperty> a owl:ObjectProperty ;
    rdfs:domain <http://ontology.eil.utoronto.ca/icontact.owl#Address> ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#contactProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#Address> a owl:Class ;
    rdfs:label "Address"@en ;
    dcterms:description "Address is the main concept for a contact.  It has been designed to represent any type of address in the world, including India and the UK.  For example, the property hasBuilding is important in many UK and Indian addresses to further identify the person or business location.\\n\\nStreet information is divided into separate properties to fully indentify direction (hasStreetDirection), Type (hasStreetType), etc.  See the associated list of properties for more."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasStreetNumber> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasCitySection> ],
        [ a owl:Restriction ;
            owl:onClass <http://schema.org/City> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasCity> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://schema.org/State> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasState> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasPostalCode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icontact.owl#StreetDirection> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasStreetDirection> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#lat> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasStreet> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://www.w3.org/2003/01/geo/wgs84_pos#long> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasUnitNumber> ],
        [ a owl:Restriction ;
            owl:onClass <http://schema.org/Country> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasCountry> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasBuilding> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ontology.eil.utoronto.ca/icontact.owl#StreetType> ;
            owl:onProperty <http://ontology.eil.utoronto.ca/icontact.owl#hasStreetType> ],
        <http://ontology.eil.utoronto.ca/icontact.owl#iContactThing> .

<http://ontology.eil.utoronto.ca/icontact.owl#addressDataProperty> a owl:DatatypeProperty ;
    rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#hasContactDataProperty> .

<http://ontology.eil.utoronto.ca/icontact.owl#iContactThing> a owl:Class .

<http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek> a owl:Class ;
    rdfs:label "Days of the Week"@en ;
    rdfs:subClassOf <http://ontology.eil.utoronto.ca/icontact.owl#iContactThing> .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://ontology.eil.utoronto.ca/icontact.owl#Address> <http://ontology.eil.utoronto.ca/icontact.owl#AddressType> <http://ontology.eil.utoronto.ca/icontact.owl#DaysOfWeek> <http://ontology.eil.utoronto.ca/icontact.owl#HoursOfOperation> <http://ontology.eil.utoronto.ca/icontact.owl#PhoneNumber> <http://ontology.eil.utoronto.ca/icontact.owl#PhoneType> <http://ontology.eil.utoronto.ca/icontact.owl#StreetDirection> <http://ontology.eil.utoronto.ca/icontact.owl#StreetType> ) .

