@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://resource.geosciml.org/ontology/timescale/thors> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://resource.geosciml.org/ontology/timescale/thors#member> a owl:ObjectProperty ;
    rdfs:label "era member / sub-era"@en ;
    rdfs:domain <http://resource.geosciml.org/ontology/timescale/thors#Era> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://resource.geosciml.org/ontology/timescale/thors#Era> ;
    rdfs:subPropertyOf skos:narrower .

<http://resource.geosciml.org/ontology/timescale/thors#positionalUncertainty> a owl:DatatypeProperty ;
    rdfs:label "uncertainty in temporal position"@en ;
    rdfs:isDefinedBy onto: .

<http://resource.geosciml.org/ontology/timescale/thors#referencePoint> a owl:ObjectProperty ;
    rdfs:label "reference point in timescale" ;
    rdfs:domain <http://resource.geosciml.org/ontology/timescale/thors#ReferenceSystem> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://resource.geosciml.org/ontology/timescale/thors#EraBoundary> ;
    rdfs:subPropertyOf skos:hasTopConcept .

<http://resource.geosciml.org/ontology/timescale/thors#system> a owl:ObjectProperty ;
    rdfs:label "system"@en ;
    rdfs:comment "reference system that this era belongs to" ;
    rdfs:domain <http://resource.geosciml.org/ontology/timescale/thors#Era> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://resource.geosciml.org/ontology/timescale/thors#ReferenceSystem> ;
    rdfs:subPropertyOf skos:topConceptOf ;
    owl:inverseOf <http://resource.geosciml.org/ontology/timescale/thors#component> .

<http://resource.geosciml.org/ontology/timescale/thors#begin> a owl:ObjectProperty ;
    rdfs:label "era beginning"@en ;
    rdfs:comment "era or interval beginning or start" ;
    rdfs:domain <http://resource.geosciml.org/ontology/timescale/thors#Era> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://resource.geosciml.org/ontology/timescale/thors#EraBoundary> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    owl:inverseOf <http://resource.geosciml.org/ontology/timescale/thors#nextEra> .

<http://resource.geosciml.org/ontology/timescale/thors#component> a owl:ObjectProperty ;
    rdfs:label "temporal reference system component"@en ;
    rdfs:domain <http://resource.geosciml.org/ontology/timescale/thors#ReferenceSystem> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://resource.geosciml.org/ontology/timescale/thors#Era> ;
    rdfs:subPropertyOf skos:hasTopConcept ;
    owl:inverseOf <http://resource.geosciml.org/ontology/timescale/thors#system> .

<http://resource.geosciml.org/ontology/timescale/thors#end> a owl:ObjectProperty ;
    rdfs:label "era end"@en ;
    rdfs:domain <http://resource.geosciml.org/ontology/timescale/thors#Era> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://resource.geosciml.org/ontology/timescale/thors#EraBoundary> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    owl:inverseOf <http://resource.geosciml.org/ontology/timescale/thors#previousEra> .

<http://resource.geosciml.org/ontology/timescale/thors#nextEra> a owl:ObjectProperty ;
    rdfs:label "next era"@en ;
    rdfs:domain <http://resource.geosciml.org/ontology/timescale/thors#EraBoundary> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://resource.geosciml.org/ontology/timescale/thors#Era> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    owl:inverseOf <http://resource.geosciml.org/ontology/timescale/thors#begin> .

<http://resource.geosciml.org/ontology/timescale/thors#previousEra> a owl:ObjectProperty ;
    rdfs:label "previous era"@en ;
    rdfs:domain <http://resource.geosciml.org/ontology/timescale/thors#EraBoundary> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://resource.geosciml.org/ontology/timescale/thors#Era> ;
    rdfs:subPropertyOf skos:semanticRelation ;
    owl:inverseOf <http://resource.geosciml.org/ontology/timescale/thors#end> .

<http://resource.geosciml.org/ontology/timescale/thors#ReferenceSystem> a owl:Class ;
    rdfs:label "Hierarchical Time Ordinal Reference System" ;
    rdfs:comment "A temporal ordinal reference system is a constrained temporal topological complex, in which the edges are called 'eras'. Each era may be subdivided into one set of eras of the next finer rank. This constraint is required to establish a mono-hierarchy, so that a set of temporal positions defined relative to the reference system may be uniquely ordered." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://resource.geosciml.org/ontology/timescale/thors#component> ],
        [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://resource.geosciml.org/ontology/timescale/thors#referencePoint> ],
        skos:ConceptScheme .

<http://resource.geosciml.org/ontology/timescale/thors#EraBoundary> a owl:Class ;
    rdfs:label "Time Ordinal Era Boundary" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://resource.geosciml.org/ontology/timescale/thors#nextEra> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://resource.geosciml.org/ontology/timescale/thors#previousEra> ],
        skos:Concept .

<http://resource.geosciml.org/ontology/timescale/thors#Era> a owl:Class ;
    rdfs:label "Time Ordinal Era or Interval" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://resource.geosciml.org/ontology/timescale/thors#end> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://resource.geosciml.org/ontology/timescale/thors#begin> ],
        skos:Concept .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    dc:creator "Simon Jonathan David COX, CSIRO Australia" ;
    dc:description "An OWL representation of the model for Temporal Ordinal Reference Systems defined in GeoSciML v3. " ;
    dc:rights "Copyright © 2012-2017 CSIRO" ;
    dc:source "Simon J.D. Cox and Stephen M. Richard, A formal model for the geologic time scale and global stratotype section and point, compatible with geospatial information transfer standards, Geosphere, 1, 119-137 (2005)" ;
    dc:title "Temporal Hierarchical Ordinal Reference System model" ;
    dcterms:created "2011-01-01"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2017-04-28"^^xsd:date ;
    vann:preferredNamespacePrefix "thors" ;
    vann:preferredNamespaceUri <http://resource.geosciml.org/ontology/timescale/thors#> ;
    rdfs:comment "This model is related to the model for TORS in ISO 19108:2002, except that boundaries between eras are first class objects, supporting multiple properties, rather than being just time coordinates. It is also linked to the ISO 19108 Temporal Topology model. " ;
    rdfs:seeAlso <doi:10.1130/GES00022.1>,
        <http://dx.doi.org/10.1130/GES00022.1>,
        <http://geosphere.gsapubs.org/cgi/doi/10.1130/GES00022.1>,
        <http://www.geosciml.org> ;
    owl:imports dc: ;
    owl:priorVersion <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201402/Geoscience/GeologicTimeScale/thors.rdf> ;
    owl:versionIRI <https://github.com/GeoscienceAustralia/geosciml.org/commit/24d302bf3f0fa315c1dddc2c734b84f52299cd02#diff-73b17e22072459ab7e06e9ab664a9d48> ;
    skos:changeNote "2017-04-28 - removed imports of ISO ontologies " .

[] a owl:Class ;
    owl:unionOf [ ] .

