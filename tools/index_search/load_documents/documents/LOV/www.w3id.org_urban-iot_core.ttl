@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://www.w3id.org/urban-iot/core> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:Location a owl:Class ;
    rdfs:label "Location"@en .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en .

dcterms:license a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

vann:usageNote a owl:AnnotationProperty .

<http://schema.org/ContactPoint> a owl:Class ;
    rdfs:label "Contact Point"@en .

<http://schema.org/DayOfWeek> a owl:Class ;
    rdfs:label "Day of Week"@en .

<http://schema.org/OpeningHoursSpecification> a owl:Class ;
    rdfs:label "Opening Hours Specification"@en .

<http://schema.org/Organization> a owl:Class ;
    rdfs:label "Organization"@en .

<http://schema.org/ServiceChannel> a owl:Class ;
    rdfs:label "Service Channel"@en .

<http://schema.org/alternateName> a owl:DatatypeProperty ;
    rdfs:label "alternate name"@en .

<http://schema.org/areaServed> a owl:ObjectProperty ;
    rdfs:label "area served"@en .

<http://schema.org/availableChannel> a owl:ObjectProperty ;
    rdfs:label "available channel"@en .

<http://schema.org/availableLanguage> a owl:DatatypeProperty ;
    rdfs:label "available language"@en .

<http://schema.org/closes> a owl:DatatypeProperty ;
    rdfs:label "closes"@en .

<http://schema.org/contactPoint> a owl:ObjectProperty ;
    rdfs:label "contact point"@en .

<http://schema.org/dayOfWeek> a owl:ObjectProperty ;
    rdfs:label "day of week"@en .

<http://schema.org/description> a owl:DatatypeProperty ;
    rdfs:label "description"@en .

<http://schema.org/duration> a owl:DatatypeProperty ;
    rdfs:label "duration"@en .

<http://schema.org/email> a owl:DatatypeProperty ;
    rdfs:label "email"@en .

<http://schema.org/endDate> a owl:DatatypeProperty ;
    rdfs:label "end date"@en .

<http://schema.org/gender> a owl:DatatypeProperty ;
    rdfs:label "gender"@en .

<http://schema.org/hoursAvailable> a owl:ObjectProperty ;
    rdfs:label "hours available"@en .

<http://schema.org/itemCondition> a owl:DatatypeProperty ;
    rdfs:label "item condition"@en .

<http://schema.org/itemOffered> a owl:ObjectProperty ;
    rdfs:label "item offered"@en .

<http://schema.org/legalName> a owl:DatatypeProperty ;
    rdfs:label "legal name"@en .

<http://schema.org/name> a owl:DatatypeProperty ;
    rdfs:label "name"@en .

<http://schema.org/offers> a owl:ObjectProperty ;
    rdfs:label "offers"@en .

<http://schema.org/openingHoursSpecification> a owl:ObjectProperty ;
    rdfs:label "opening hours specification"@en .

<http://schema.org/opens> a owl:DatatypeProperty ;
    rdfs:label "opens"@en .

<http://schema.org/priceCurrency> a owl:DatatypeProperty ;
    rdfs:label "price currency"@en .

<http://schema.org/provider> a owl:ObjectProperty ;
    rdfs:label "provider"@en .

<http://schema.org/servicePhone> a owl:ObjectProperty ;
    rdfs:label "service phone"@en .

<http://schema.org/serviceUrl> a owl:DatatypeProperty ;
    rdfs:label "service url"@en .

<http://schema.org/startDate> a owl:DatatypeProperty ;
    rdfs:label "start date"@en .

<http://schema.org/telephone> a owl:DatatypeProperty ;
    rdfs:label "telephone"@en ;
    rdfs:comment "Literal datatype xsd:string."@en .

<http://schema.org/url> a owl:DatatypeProperty ;
    rdfs:label "url"@en ;
    rdfs:comment "Literal datatype xsd:anyURI."@en .

time:timeZone a owl:ObjectProperty ;
    rdfs:label "time zone"@en .

<http://www.w3.org/ns/locn#Address> a owl:Class ;
    rdfs:label "Address"@en .

<http://www.w3.org/ns/locn#Geometry> a owl:Class ;
    rdfs:label "Geometry"@en .

<http://www.w3.org/ns/locn#address> a owl:ObjectProperty ;
    rdfs:label "address"@en .

<http://www.w3.org/ns/locn#fullAddress> a owl:DatatypeProperty ;
    rdfs:label "full address"@en .

<http://www.w3.org/ns/locn#geometry> a owl:ObjectProperty ;
    rdfs:label "geometry"@en .

<http://www.w3.org/ns/locn#location> a owl:ObjectProperty ;
    rdfs:label "location"@en .

<http://www.w3.org/ns/locn#postCode> a owl:DatatypeProperty ;
    rdfs:label "post code"@en .

<http://www.w3.org/ns/locn#postName> a owl:DatatypeProperty ;
    rdfs:label "post name"@en .

<http://www.w3.org/ns/locn#registeredAddress> a owl:ObjectProperty ;
    rdfs:label "registered address"@en .

sosa:ObservableProperty a owl:Class ;
    rdfs:label "Observable Property"@en .

sosa:hasResult a owl:ObjectProperty ;
    rdfs:label "has result"@en .

sosa:hasSimpleResult a owl:DatatypeProperty ;
    rdfs:label "has simple result"@en .

sosa:madeBySensor a owl:ObjectProperty ;
    rdfs:label "made by sensor"@en .

sosa:madeObservation a owl:ObjectProperty ;
    rdfs:label "made observation"@en .

sosa:observedProperty a owl:ObjectProperty ;
    rdfs:label "observed property"@en .

sosa:observes a owl:ObjectProperty ;
    rdfs:label "observes"@en .

onto: a owl:Ontology ;
    rdfs:label "Urban IoT Ontologies - Core Module"@en ;
    dc:contributor "Area Pianificazione e Monitoraggio (AMAT Milano)",
        "Direzione Mobilità e Trasporti - Area Pianificazione e Programmazione Mobilità (Comune di Milano)",
        "Direzione Sistemi Informativi ed Agenda Digitale - Area Gestione ed Integrazione Dati (Comune di Milano)" ;
    dc:creator "Ilaria Baroni (Cefriel)",
        "Irene Celino (Cefriel)",
        "Mario Scrocca (Cefriel)" ;
    dc:publisher "Comune di Milano" ;
    dc:rights "Copyright Comune di Milano, 2020" ;
    dc:title "Urban IoT Ontologies - Core Module"@en ;
    dcterms:bibliographicCitation "Comune di Milano. Urban IoT Ontologies - Core Module (v1.0.0). http://www.w3id.org/urban-iot/core" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "uiot" ;
    vann:preferredNamespaceUri "http://www.w3id.org/urban-iot/core#" ;
    rdfs:comment "Core module of the suite of ontologies for urban IoT devices."@en ;
    owl:versionIRI <http://www.w3id.org/urban-iot/core/1.0.0> ;
    owl:versionInfo "v1.0.0" .

<http://www.w3id.org/urban-iot/core#associatedBusiness> a owl:ObjectProperty ;
    rdfs:label "associated business"@en ;
    rdfs:comment "Associates a Usage Session with the Service Business User enabling it."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#UsageSession> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#ServiceBusinessUser> .

<http://www.w3id.org/urban-iot/core#birthYear> a owl:DatatypeProperty ;
    rdfs:label "birth year"@en ;
    rdfs:domain <http://schema.org/Person> ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf <http://schema.org/birthDate> .

<http://www.w3id.org/urban-iot/core#containsObservation> a owl:ObjectProperty ;
    rdfs:label "contains observation"@en ;
    rdfs:comment "Associates a Sensor Record with a Observation contained in it."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#SensorRecord> ;
    rdfs:range sosa:Observation ;
    owl:inverseOf <http://www.w3id.org/urban-iot/core#observationIn> .

<http://www.w3id.org/urban-iot/core#deregistrationDate> a owl:DatatypeProperty ;
    rdfs:label "deregistration date"@en ;
    rdfs:comment "Date in which a Service User deregistered from a Service."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServiceUser> ;
    rdfs:range xsd:dateTime .

<http://www.w3id.org/urban-iot/core#enablesSession> a owl:ObjectProperty ;
    rdfs:label "enables session"@en ;
    rdfs:comment "Associates a Service with a Usage Session enabled by the service."@en ;
    rdfs:domain <http://schema.org/Service> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#UsageSession> ;
    owl:inverseOf <http://www.w3id.org/urban-iot/core#sessionEnabledBy> .

<http://www.w3id.org/urban-iot/core#fixedAmount> a owl:DatatypeProperty ;
    rdfs:label "fixed amount"@en ;
    rdfs:comment "Associates an Offer with a fixed amount required from it."@en ;
    rdfs:domain <http://schema.org/Offer> ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf <http://schema.org/price> .

<http://www.w3id.org/urban-iot/core#hasEnabledUser> a owl:ObjectProperty ;
    rdfs:label "has enabled user"@en ;
    rdfs:comment "Associates a Service Business User with the Service Private User enabled by that business user."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServiceBusinessUser> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#ServicePrivateUser> ;
    owl:inverseOf <http://www.w3id.org/urban-iot/core#userEnabledBy> .

<http://www.w3id.org/urban-iot/core#hasUser> a owl:ObjectProperty ;
    rdfs:label "has user"@en ;
    rdfs:comment "Associates a Service to a Service User."@en ;
    rdfs:domain <http://schema.org/Service> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#ServiceUser> ;
    owl:inverseOf <http://www.w3id.org/urban-iot/core#userOfService> .

<http://www.w3id.org/urban-iot/core#includedInMobilityStation> a owl:ObjectProperty ;
    rdfs:label "included in mobility station"@en ;
    rdfs:comment "Associates a Mobility Station with another Mobility Station including it."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#MobilityStation> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#MobilityStation> .

<http://www.w3id.org/urban-iot/core#latestRecord> a owl:ObjectProperty ;
    rdfs:label "latest record"@en ;
    rdfs:comment "Associates a Sensor with the latest registered Sensor Record."@en ;
    rdfs:domain sosa:Sensor ;
    rdfs:range <http://www.w3id.org/urban-iot/core#SensorRecord> ;
    rdfs:subPropertyOf <http://www.w3id.org/urban-iot/core#registersRecord> .

<http://www.w3id.org/urban-iot/core#madeAvailableBy> a owl:ObjectProperty ;
    rdfs:label "made available by"@en ;
    rdfs:comment "Associates a Service Resource with the Service making it available."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServiceResource> ;
    rdfs:range <http://schema.org/Service> ;
    owl:inverseOf <http://www.w3id.org/urban-iot/core#makesAvailable> .

<http://www.w3id.org/urban-iot/core#offerAssociated> a owl:ObjectProperty ;
    rdfs:label "offer associated"@en ;
    rdfs:comment "Associates a Usage Session with the tariff (Offer) applied to the specific session."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#UsageSession> ;
    rdfs:range <http://schema.org/Offer> .

<http://www.w3id.org/urban-iot/core#performsSession> a owl:ObjectProperty ;
    rdfs:label "performs session"@en ;
    rdfs:comment "Associates a Service Private User with a Usage Session performed."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServicePrivateUser> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#UsageSession> ;
    owl:inverseOf <http://www.w3id.org/urban-iot/core#sessionPerformedBy> .

<http://www.w3id.org/urban-iot/core#recordRegisteredBy> a owl:ObjectProperty ;
    rdfs:label "record registered by"@en ;
    rdfs:comment "Associates a Sensor Record with the Sensor registering it."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#SensorRecord> ;
    rdfs:range sosa:Sensor ;
    owl:inverseOf <http://www.w3id.org/urban-iot/core#registersRecord> .

<http://www.w3id.org/urban-iot/core#recordTimestamp> a owl:DatatypeProperty ;
    rdfs:label "record timestamp"@en ;
    rdfs:comment "Timestamp associated with a Sensor Record."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#SensorRecord> ;
    rdfs:range xsd:dateTime .

<http://www.w3id.org/urban-iot/core#registeredTo> a owl:ObjectProperty ;
    rdfs:label "registered to"@en ;
    rdfs:comment "Associates a Service User to the Service to which the user is registered to."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServiceUser> ;
    rdfs:range <http://schema.org/Service> .

<http://www.w3id.org/urban-iot/core#registrationDate> a owl:DatatypeProperty ;
    rdfs:label "registration date"@en ;
    rdfs:comment "Date in which a Service User registered to the Service."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServiceUser> ;
    rdfs:range xsd:dateTime .

<http://www.w3id.org/urban-iot/core#reservationUsed> a owl:DatatypeProperty ;
    rdfs:label "reservation used"@en ;
    rdfs:comment "Indicates whether a reservation mechanism has been used for a Usage Session."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#UsageSession> ;
    rdfs:range xsd:boolean .

<http://www.w3id.org/urban-iot/core#resourceUsedIn> a owl:ObjectProperty ;
    rdfs:label "resource used in"@en ;
    rdfs:comment "Associates a Service Resource with a Usage Session using it."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServiceResource> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#UsageSession> ;
    owl:inverseOf <http://www.w3id.org/urban-iot/core#usesResource> .

<http://www.w3id.org/urban-iot/core#serialNumber> a owl:DatatypeProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "Indication of the serial number."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServiceResource> ;
    rdfs:range xsd:string .

<http://schema.org/Event> a owl:Class ;
    rdfs:label "Event"@en .

<http://schema.org/Place> a owl:Class ;
    rdfs:label "Place"@en .

<http://schema.org/birthDate> a owl:DatatypeProperty ;
    rdfs:label "birth date"@en .

<http://schema.org/price> a owl:DatatypeProperty ;
    rdfs:label "price"@en .

<http://www.w3.org/ns/legal#LegalEntity> a owl:Class ;
    rdfs:label "Legal Entity"@en .

<http://www.w3id.org/urban-iot/core#makesAvailable> a owl:ObjectProperty ;
    rdfs:label "makes available"@en ;
    rdfs:comment "Associates a Service with the Service Resource that makes available."@en ;
    rdfs:domain <http://schema.org/Service> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#ServiceResource> .

<http://www.w3id.org/urban-iot/core#observationIn> a owl:ObjectProperty ;
    rdfs:label "observation in"@en ;
    rdfs:comment "Associates an Observation with the Sensor Record containing it."@en ;
    rdfs:domain sosa:Observation ;
    rdfs:range <http://www.w3id.org/urban-iot/core#SensorRecord> .

<http://www.w3id.org/urban-iot/core#sessionEnabledBy> a owl:ObjectProperty ;
    rdfs:label "session enabled by"@en ;
    rdfs:comment "Associates a Usage Session with the Service enabling it."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#UsageSession> ;
    rdfs:range <http://schema.org/Service> .

<http://www.w3id.org/urban-iot/core#sessionPerformedBy> a owl:ObjectProperty ;
    rdfs:label "session performed by"@en ;
    rdfs:comment "Associates a Usage Session with the Service Private User performing it."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#UsageSession> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#ServicePrivateUser> .

<http://www.w3id.org/urban-iot/core#userEnabledBy> a owl:ObjectProperty ;
    rdfs:label "user enabled by"@en ;
    rdfs:comment "Associates a Service Private User to the Service Business User enabling it."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServicePrivateUser> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#ServiceBusinessUser> .

<http://www.w3id.org/urban-iot/core#userOfService> a owl:ObjectProperty ;
    rdfs:label "user of service"@en ;
    rdfs:comment "Associates a Service User to the Service used."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#ServiceUser> ;
    rdfs:range <http://schema.org/Service> .

<http://www.w3id.org/urban-iot/core#usesResource> a owl:ObjectProperty ;
    rdfs:label "uses resource"@en ;
    rdfs:comment "Associates a Usage Session with the Service Resource used in the session."@en ;
    rdfs:domain <http://www.w3id.org/urban-iot/core#UsageSession> ;
    rdfs:range <http://www.w3id.org/urban-iot/core#ServiceResource> .

<http://schema.org/Offer> a owl:Class ;
    rdfs:label "Offer"@en .

<http://schema.org/Person> a owl:Class ;
    rdfs:label "Person"@en .

sosa:Observation a owl:Class ;
    rdfs:label "Observation"@en .

<http://www.w3id.org/urban-iot/core#MobilityStation> a owl:Class ;
    rdfs:label "Mobility Station"@en ;
    rdfs:comment "A Place characterized by mobility services. A Mobility Station can include more specific Mobility Station (Sharing Station, Charging Station, ecc.)."@en ;
    rdfs:subClassOf <http://schema.org/Place> .

<http://www.w3id.org/urban-iot/core#registersRecord> a owl:ObjectProperty ;
    rdfs:label "registers record"@en ;
    rdfs:comment "Associates a Sensor with a registered Sensor Record."@en ;
    rdfs:domain sosa:Sensor ;
    rdfs:range <http://www.w3id.org/urban-iot/core#SensorRecord> .

sosa:Sensor a owl:Class ;
    rdfs:label "Sensor"@en .

<http://www.w3id.org/urban-iot/core#ServiceBusinessUser> a owl:Class ;
    rdfs:label "Service Business User"@en ;
    rdfs:comment "Legal Entity with a business contract for the service. A Service Business User can not directly use the service but can enable a Service Private User to do so."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/legal#LegalEntity>,
        <http://www.w3id.org/urban-iot/core#ServiceUser> .

<http://www.w3id.org/urban-iot/core#ServicePrivateUser> a owl:Class ;
    rdfs:label "Service Private User"@en ;
    rdfs:comment "A natural person using a service."@en ;
    rdfs:subClassOf <http://schema.org/Person>,
        <http://www.w3id.org/urban-iot/core#ServiceUser> .

<http://www.w3id.org/urban-iot/core#ServiceResource> a owl:Class ;
    rdfs:label "Service Resource"@en ;
    rdfs:comment "A Resource made available by a Service to be used in a Usage Session."@en .

<http://www.w3id.org/urban-iot/core#SensorRecord> a owl:Class ;
    rdfs:label "Sensor Record"@en ;
    rdfs:comment "A Sensor Record aggregates a set of observations associated to the same timestamp and the same sensor."@en .

<http://schema.org/Service> a owl:Class ;
    rdfs:label "Service"@en .

<http://www.w3id.org/urban-iot/core#ServiceUser> a owl:Class ;
    rdfs:label "Service User"@en ;
    rdfs:comment "A User using a Service."@en .

<http://www.w3id.org/urban-iot/core#UsageSession> a owl:Class ;
    rdfs:label "Usage Session"@en ;
    rdfs:comment "A Usage Session is an Event associated to a Service and a Service Resource representing a usage of the resource made available by the Service."@en ;
    rdfs:subClassOf <http://schema.org/Event> .

