@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://iais.fraunhofer.de/vocabs/rami#CADFormat> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#MCAD> ;
    rdfs:range xsd:string ;
    skos:definition "Different types of format files for CAD Archive of the Object/Entity"@en ;
    skos:prefLabel "CAD Format"@en .

<http://iais.fraunhofer.de/vocabs/rami#CADSystem> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#MCAD> ;
    rdfs:range xsd:string ;
    skos:definition "Points to the different types of CAD systems of the Object/Entity"@en ;
    skos:example "Neutral 2D, Neutral 3D, SolidWorks" ;
    skos:prefLabel "CAD Format"@en .

<http://iais.fraunhofer.de/vocabs/rami#CADarchive> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#MCAD> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Link(URL) to the CAD Archive of the Object/Entity"@en ;
    skos:prefLabel "CAD Archive"@en .

<http://iais.fraunhofer.de/vocabs/rami#Machine> a owl:Class ;
    rdfs:subClassOf <http://iais.fraunhofer.de/vocabs/rami#Object> ;
    skos:definition "A machine is ordered, designed, commissioned, operated, serviced, converted and recycled."@en ;
    skos:prefLabel "Machine"@en .

<http://iais.fraunhofer.de/vocabs/rami#Order> a owl:Class ;
    skos:definition "Each order for manufacturing runs through a life cycle and its specifics necessarily have an impact on the production facility during performance of the order"@en ;
    skos:prefLabel "Order"@en .

<http://iais.fraunhofer.de/vocabs/rami#SensorMeasurementData> a owl:Class ;
    rdfs:label "Sensor Data"@en ;
    rdfs:comment "Data measured by a sensor"@en ;
    rdfs:subClassOf <http://iais.fraunhofer.de/vocabs/rami#BasicData> ;
    owl:equivalentClass <http://purl.oclc.org/NET/ssnx/ssn#SensorOutput> .

<http://iais.fraunhofer.de/vocabs/rami#blockUrl> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Firmware> ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL of the Firmware that belongs to the Object/Entity"@en ;
    skos:prefLabel "Block Url"@en .

<http://iais.fraunhofer.de/vocabs/rami#brakingResistance> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#ElectricalData> ;
    rdfs:range <http://www.wurvoc.org/vocabularies/om-1.8/hertz> ;
    skos:prefLabel "braking Resistance"@en .

<http://iais.fraunhofer.de/vocabs/rami#certificateName> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#SafetyConfiguration> ;
    rdfs:range xsd:string ;
    skos:definition "Certificate Safety Name of the Object/Entity"@en ;
    skos:prefLabel "Certificate Name"@en .

<http://iais.fraunhofer.de/vocabs/rami#certificateUrl> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#SafetyConfiguration> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Certificate Safety Url of the Object/Entity"@en ;
    skos:prefLabel "Certificate Url"@en .

<http://iais.fraunhofer.de/vocabs/rami#contributes> a owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#BasicData> ;
    rdfs:range prov:Agent ;
    skos:definition "Agent(Person or Software) that contributes to the Entity/Object related data. It correspond to the Contributor concept of OMM"@en ;
    skos:prefLabel "typeDescription"@en .

<http://iais.fraunhofer.de/vocabs/rami#contributionDate> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#BasicData> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date when an Agent(Person or Software) contributes to the Entity/Object related data. It correspond to the Contributor concept of OMM"@en ;
    skos:prefLabel "hasCreator"@en .

<http://iais.fraunhofer.de/vocabs/rami#createdBy> a owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#BasicData> ;
    rdfs:range prov:Agent ;
    skos:definition "Agent(Person or Software) that creates to the Entity/Object related data. It correspond to the Creator concept of OMM"@en ;
    skos:prefLabel "hasCreator"@en .

<http://iais.fraunhofer.de/vocabs/rami#creationDate> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#BasicData> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date when an Agent(Person or Software) creates to the Entity/Object related data. It correspond to the Creator concept of OMM"@en ;
    skos:prefLabel "hasCreator"@en .

<http://iais.fraunhofer.de/vocabs/rami#description> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Object> ;
    rdfs:range xsd:string ;
    skos:definition "Description of the Object/Entity"@en ;
    skos:prefLabel "has Description"@en .

<http://iais.fraunhofer.de/vocabs/rami#eClassClassification> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#eClass> ;
    rdfs:range xsd:integer ;
    skos:definition "Identification of an object according to the eCl@ss Standard hierarchy level"@en ;
    skos:prefLabel "eClassIRDI"@en .

<http://iais.fraunhofer.de/vocabs/rami#eClassIRDI> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#eClass> ;
    rdfs:range xsd:string ;
    skos:definition "Unique Identification of an object according to eCl@ss Standard"@en ;
    skos:prefLabel "eClassIRDI"@en .

<http://iais.fraunhofer.de/vocabs/rami#firmwareDate> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Firmware> ;
    rdfs:range xsd:date ;
    skos:definition "Firmware date that belongs to the Object/Entity"@en ;
    skos:prefLabel "firmware Date"@en .

<http://iais.fraunhofer.de/vocabs/rami#hasData> a owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#AdminShell> ;
    rdfs:range <http://iais.fraunhofer.de/vocabs/rami#BasicData> ;
    skos:definition "Connects the AdminShell with the different types of Data for the Object/Entity"@en ;
    skos:prefLabel "has Data"@en .

<http://iais.fraunhofer.de/vocabs/rami#hasEnergyValue> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#CumulativeEnergyConsumption> ;
    rdfs:range xsd:float ;
    skos:prefLabel "hasEnergyValue"@en .

<http://iais.fraunhofer.de/vocabs/rami#hasRAMIHierarchyLevel> a owl:ObjectProperty ;
    rdfs:range <http://iais.fraunhofer.de/vocabs/rami#RAMIHierarchyLevel> ;
    skos:definition "Connects the concepts with the correspondent layer in the RAMI Hierarchy Levels"@en ;
    skos:prefLabel "has RAMI Hierarchy Level" .

<http://iais.fraunhofer.de/vocabs/rami#hasSensorId> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Sensor> ;
    rdfs:range xsd:string ;
    skos:definition "Unique Identification of the Sensor"@en ;
    skos:prefLabel "hasSensorId"@en .

<http://iais.fraunhofer.de/vocabs/rami#hasTechnicalFuncionality> a owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#AdminShell> ;
    rdfs:range <http://iais.fraunhofer.de/vocabs/rami#TechnicalFunctionality> ;
    skos:definition "The Administrative Shell has Technical Funcionalities"@en ;
    skos:prefLabel "has Technical Funcionality"@en .

<http://iais.fraunhofer.de/vocabs/rami#identification> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#BasicData> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.w3.org/2005/Incubator/omm/XGR-omm-20111026/> ;
    skos:definition "Identification for the Entity/Object related data. It correspond to the ID concept of OMM"@en ;
    skos:prefLabel "Identification"@en .

<http://iais.fraunhofer.de/vocabs/rami#inputVoltage> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#ElectricalData> ;
    rdfs:range <http://www.wurvoc.org/vocabularies/om-1.8/volt> ;
    skos:example "230 V AC / 50-60 Hz" ;
    skos:prefLabel "Input Voltage"@en .

<http://iais.fraunhofer.de/vocabs/rami#inventoryNumber> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#BasicData> ;
    rdfs:range xsd:string ;
    skos:definition "Inventory number of the Entity/Object according to the identification nomenclature"@en ;
    skos:prefLabel "Inventory Number"@en .

<http://iais.fraunhofer.de/vocabs/rami#isDescribedWith> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#AdminShell> ;
    rdfs:range <http://iais.fraunhofer.de/vocabs/rami#Standard> ;
    skos:definition "Points to the Standard used to describe a given object"@en ;
    skos:prefLabel "Is Described With"@en .

<http://iais.fraunhofer.de/vocabs/rami#isPartOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "isPartOf"@en ;
    rdfs:comment "The Object can be part of of other Objects"@en ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Object> ;
    rdfs:range <http://iais.fraunhofer.de/vocabs/rami#Object> .

<http://iais.fraunhofer.de/vocabs/rami#livePicture> a owl:ObjectProperty ;
    rdfs:label "LivePicture"@en ;
    rdfs:comment "Points to an Image for the Object/Entity"@en ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Object> ;
    rdfs:range <http://xmlns.com/foaf/spec/Image> .

<http://iais.fraunhofer.de/vocabs/rami#logs> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#TraceRecordings> ;
    rdfs:range xsd:string ;
    skos:prefLabel "logs"@en .

<http://iais.fraunhofer.de/vocabs/rami#manual> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#ApplicationData> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Points to the Manual document of a given Object/Entity"@en ;
    skos:prefLabel "Manual"@en .

<http://iais.fraunhofer.de/vocabs/rami#name> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Object> ;
    rdfs:range xsd:string ;
    skos:definition "Name of the Object/Entity"@en ;
    skos:prefLabel "has Name"@en .

<http://iais.fraunhofer.de/vocabs/rami#objectId> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Object> ;
    rdfs:range xsd:string ;
    skos:definition "Unique ID for the Object/Entity"@en ;
    skos:prefLabel "has Object Id"@en .

<http://iais.fraunhofer.de/vocabs/rami#outputFrequency> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#ElectricalData> ;
    rdfs:range <http://www.wurvoc.org/vocabularies/om-1.8/hertz> ;
    skos:prefLabel "Output Frequency"@en .

<http://iais.fraunhofer.de/vocabs/rami#phasesNumber> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#ElectricalData> ;
    rdfs:range xsd:string ;
    skos:example "Single phase, three phase" ;
    skos:prefLabel "Phases Number"@en .

<http://iais.fraunhofer.de/vocabs/rami#publishedURL> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Standard> ;
    rdfs:range xsd:AnyURI ;
    skos:definition "Published URL of the Standard"@en ;
    skos:prefLabel "Published URL"@en .

<http://iais.fraunhofer.de/vocabs/rami#releaseDate> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Standard> ;
    rdfs:range xsd:date ;
    skos:definition "Release Date of the Standard"@en ;
    skos:prefLabel "Release Date"@en .

<http://iais.fraunhofer.de/vocabs/rami#safetyName> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#SafetyConfiguration> ;
    rdfs:range xsd:string ;
    skos:definition "Name of the Safety Configuration of the Object/Entity"@en ;
    skos:prefLabel "Safety Name"@en .

<http://iais.fraunhofer.de/vocabs/rami#standardName> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#EngineeringData> ;
    rdfs:range xsd:string ;
    skos:definition "Name of the Standard that specifies the Engineering Data"@en ;
    skos:prefLabel "Standard Name"@en .

<http://iais.fraunhofer.de/vocabs/rami#standardURL> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#EngineeringData> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Points to the URL of the Standard that specifies the Engineering Data"@en ;
    skos:prefLabel "Standard URL"@en .

<http://iais.fraunhofer.de/vocabs/rami#standardVersion> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#EngineeringData> ;
    rdfs:range xsd:string ;
    skos:definition "Version of the Standard that specifies the Engineering Data"@en ;
    skos:prefLabel "Standard Version"@en .

<http://iais.fraunhofer.de/vocabs/rami#stdName> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Standard> ;
    rdfs:range xsd:string ;
    skos:definition "Name of the Standard"@en ;
    skos:prefLabel "Std Name"@en .

<http://iais.fraunhofer.de/vocabs/rami#typeDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#BasicData> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.w3.org/2005/Incubator/omm/XGR-omm-20111026/> ;
    skos:definition "Describes the Entity/Object related data. It correspond to the Description concept of OMM"@en ;
    skos:prefLabel "typeDescription"@en .

<http://iais.fraunhofer.de/vocabs/rami#version> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#Firmware>,
        <http://iais.fraunhofer.de/vocabs/rami#Standard> ;
    rdfs:range xsd:string ;
    skos:definition "Current version of the Standard"@en,
        "Version of the Firmware that belongs to the Object/Entity"@en ;
    skos:prefLabel "Version"@en,
        "has Version"@en .

<http://iais.fraunhofer.de/vocabs/rami#videoRecordingUrl> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#VideoRecording> ;
    rdfs:range xsd:anyURI ;
    skos:prefLabel "Video Recording Url"@en .

<http://iais.fraunhofer.de/vocabs/rami#videoUrl> a owl:DatatypeProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#VideoRecordings> ;
    rdfs:range xsd:anyURI ;
    skos:prefLabel "videoUrl"@en .

<http://iais.fraunhofer.de/vocabs/rami#wraps> a owl:ObjectProperty ;
    rdfs:domain <http://iais.fraunhofer.de/vocabs/rami#AdminShell> ;
    rdfs:range <http://iais.fraunhofer.de/vocabs/rami#Object> ;
    skos:definition "Connect the Object with the Admin Shell"@en ;
    skos:prefLabel "wraps"@en .

