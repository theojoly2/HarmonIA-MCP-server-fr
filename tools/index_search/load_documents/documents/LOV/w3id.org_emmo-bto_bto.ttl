<http://w3id.org/emmo-bto/bto#BatteryCharacterizationHardware> a owl:Class ;
    rdfs:label "BatteryCharacterizationHardware"@en ;
    rdfs:comment "The physical apparatus of the battery testing procedure. It is required in a battery measurement process."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-chameo/chameo#CharacterisationInstrument> ;
    skos:altLabel "Hardware"@en ;
    skos:prefLabel "BatteryCharacterizationHardware"@en .

<http://w3id.org/emmo-bto/bto#BatteryMeasurementParameter> a owl:Class ;
    rdfs:label "BatteryMeasurementParameter"@en ;
    rdfs:comment "A configuration parameter of a battery measurement step in the testing procedure."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-bto/bto#BatteryTestingOntology>,
        <http://w3id.org/emmo-chameo/chameo#MeasurementParameter> ;
    skos:prefLabel "BatteryMeasurementParameter"@en .

<http://w3id.org/emmo-bto/bto#TraceData> a owl:Class ;
    rdfs:label "TraceData"@en ;
    rdfs:comment "The output of a battery measurement process in terms of raw data resulting from the measurement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://w3id.org/emmo-chameo/chameo#hasDataset> ;
            owl:someValuesFrom <https://w3id.org/emmo/domain/battery/battery#BatteryTimeSeriesDataSet> ],
        <http://w3id.org/emmo-bto/bto#BatteryTestingOntology>,
        <http://w3id.org/emmo-chameo/chameo#RawData> ;
    skos:prefLabel "TraceData"@en .

