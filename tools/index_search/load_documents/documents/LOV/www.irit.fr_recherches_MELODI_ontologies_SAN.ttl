@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/vocommons/voaf#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <http://www.irit.fr/recherches/MELODI/ontologies/SAN> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.oclc.org/NET/ssnx/ssn#Input> a owl:Class .

onto: a ns1:Vocabulary,
        owl:Ontology ;
    ns2:license <http://creativecommons.org/licenses/by/4.0/> ;
    dc:creator <http://www.irit.fr/recherches/MELODI/ontologies/contributors#ben_alaya>,
        <http://www.irit.fr/recherches/MELODI/ontologies/contributors#drira>,
        <http://www.irit.fr/recherches/MELODI/ontologies/contributors#hernandez>,
        <http://www.irit.fr/recherches/MELODI/ontologies/contributors#monteil>,
        <http://www.irit.fr/recherches/MELODI/ontologies/contributors#seydoux>,
        "Nicolas Seydoux, Mahdi Ben Alaya, Khalil Drira, Nathalie Hernandez, Thierry Monteil" ;
    dc:publisher "IRIT (https://www.irit.fr/)",
        "LAAS-CNRS (https://www.laas.fr)" ;
    dc:title "SAN (Semantic Actuator Network)" ;
    dcterms:issued "2015-02-20" ;
    dcterms:modified "2016-02-26" ;
    vann:preferredNamespacePrefix "san" ;
    vann:preferredNamespaceURI "http://www.irit.fr/recherches/MELODI/ontologies/SAN" ;
    ns1:reliesOn <http://purl.oclc.org/NET/ssnx/ssn> ;
    rdfs:comment "This ontology is intended to describe Semantic Actuator Networks, as a counterpoint to SSN definition of Semantic Sensor Networks. An actuator is a physical device having an effect on the world (see Actuator for more information).\\n\\nIt is worth noticing that some concepts are imported from SSN, but not SSN as a whole. This is a design choice intended to separate as much as possible the definition on actuator from the definition of sensor, which are completely different concept that can be used independantly from each other.\\n\\nThis ontology is used as a ontological module in IoT-O ontology." ;
    rdfs:seeAlso "http://www.irit.fr/recherches/MELODI/ontologies/IoT-O" ;
    owl:imports <http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl>,
        <http://www.loa-cnr.it/ontologies/DUL.owl> ;
    owl:versionInfo "2.0" ;
    foaf:primaryTopic "Actuators and actuation" .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingDevice> a owl:Class ;
    rdfs:label "Actuating device" ;
    rdfs:comment "A device that implements actuating" ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device>,
        <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuator> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingRange> a owl:Class ;
    rdfs:label "Actuating Range" ;
    rdfs:comment "Range of commands that the actuator can receive and transduce into the physical world without damage to itself or security issues to its surrounding environment." ;
    rdfs:subClassOf <http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingProperty> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingTime> a owl:Class ;
    rdfs:label "Actuating Time" ;
    rdfs:comment "Time between the moment when the actuator receives an actuation command and the actual actuation." ;
    rdfs:subClassOf <http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingProperty> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatorOutput> a owl:Class ;
    rdfs:label "Actuator Output" ;
    rdfs:comment "Behaviour of an actuator after it has been given an input. To stick to its definition, an actuator output must have an effect on the physical world." ;
    rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Event> ;
    owl:equivalentClass <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Effect> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#actuationResults> a owl:ObjectProperty ;
    rdfs:label "actuation results" ;
    rdfs:comment "Relation between an actuation and an actuator input, its result. Implements the ODP Effect-Actuator-Observation" ;
    rdfs:domain <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuation> ;
    rdfs:range <http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatorInput> ;
    rdfs:subPropertyOf <http://www.loa-cnr.it/ontologies/DUL.owl#isSettingFor> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#consumes> a owl:ObjectProperty ;
    rdfs:label "consumes" ;
    rdfs:comment "Relation between an consumer entity and a consumee entity. Consumption can be destructive, transformative or neutral for the consumed entity." ;
    rdfs:domain <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> ;
    rdfs:range <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> ;
    owl:inverseOf <http://www.irit.fr/recherches/MELODI/ontologies/SAN#isConsumedBy> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#isController> a owl:ObjectProperty ;
    rdfs:label "is controller" ;
    rdfs:comment "An entity is controller of another one when it has influence on its decision process or evolution in time." ;
    rdfs:domain <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> ;
    rdfs:range <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> ;
    owl:inverseOf <http://www.irit.fr/recherches/MELODI/ontologies/SAN#controlledBy> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#receivedActuation> a owl:ObjectProperty ;
    rdfs:label "received actuation" ;
    rdfs:comment "Relationship between an actuator and an Actuation it received in order to modify its action." ;
    rdfs:domain <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuator> ;
    rdfs:range <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuation> ;
    owl:inverseOf <http://www.irit.fr/recherches/MELODI/ontologies/SAN#wasActuationSent> .

<http://www.loa-cnr.it/ontologies/DUL.owl#Set> a owl:Class ;
    owl:equivalentClass <http://www.ontologydesignpatterns.org/cp/owl/set.owl#Set> .

<xsd:integer> a rdfs:Datatype .

<http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#Object> rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Object> .

<http://purl.oclc.org/NET/ssnx/ssn#Device> a owl:Class ;
    rdfs:subClassOf <http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#Object>,
        <http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalObject> .

<http://purl.oclc.org/NET/ssnx/ssn#FeatureOfInterest> a owl:Class ;
    rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/ssn" .

<http://purl.oclc.org/NET/ssnx/ssn#Process> a owl:Class ;
    rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Method> .

<http://purl.oclc.org/NET/ssnx/ssn#forProperty> a owl:ObjectProperty .

<http://purl.oclc.org/NET/ssnx/ssn#implements> a owl:ObjectProperty .

<http://purl.oclc.org/NET/ssnx/ssn#isPropertyOf> a owl:ObjectProperty ;
    rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/ssn" .

<http://qudt.org/schema/qudt#Unit> a owl:Class ;
    rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#UnitOfMeasure> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuationValue> a owl:Class ;
    rdfs:label "Actuation Value" ;
    rdfs:comment "Value of the command sent to an actuator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasDateTime> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#isParametrizedBy> ;
            owl:someValuesFrom <http://qudt.org/schema/qudt#Unit> ],
        <http://www.loa-cnr.it/ontologies/DUL.owl#Region> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatorInput> a owl:Class ;
    rdfs:label "Actuator Input" ;
    rdfs:comment "An actuator input is a piece of information provided to an actuator describing its expected behaviour, and it is described by an Actuation Value" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/SAN#isConsumedBy> ;
            owl:someValuesFrom <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuator> ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#hasValue> ;
            owl:someValuesFrom <http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuationValue> ],
        <http://www.loa-cnr.it/ontologies/DUL.owl#InformationObject> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#actsOn> a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "acts on" ;
    rdfs:comment "Relationship between an entity that acts upon a quantity or another entity" ;
    rdfs:domain <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> ;
    rdfs:range <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> ;
    owl:inverseOf <http://www.irit.fr/recherches/MELODI/ontologies/SAN#isActedUponBy> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#actuationMethodUsed> a owl:ObjectProperty ;
    rdfs:label "actuation method used" ;
    rdfs:comment "Process involved in the Actuation" ;
    rdfs:domain <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuation> ;
    rdfs:range <http://www.loa-cnr.it/ontologies/DUL.owl#Process> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#controlledBy> a owl:ObjectProperty ;
    rdfs:label "controlled by" ;
    rdfs:comment "Describes the relationship between a controlledentity and a controller  one. The controlled entity can be a situation (state of a system, property of an environment), a device, a piece of software..." ;
    rdfs:domain <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> ;
    rdfs:range <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasActuatingCapability> a owl:ObjectProperty ;
    rdfs:label "has actuation capability" ;
    rdfs:comment "Relation between an Actuator and an ActuatingCapability, describing the actuating properties of an actuator." ;
    rdfs:domain <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuator> ;
    rdfs:range <http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingCapability> ;
    rdfs:subPropertyOf <http://purl.oclc.org/NET/ssnx/ssn#hasProperty> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasActuatingProperty> a owl:ObjectProperty ;
    rdfs:label "has actuation property" ;
    rdfs:comment "Relation from an actuation capability to an actuation property." ;
    rdfs:domain <http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingCapability> ;
    rdfs:range <http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingProperty> ;
    rdfs:subPropertyOf <http://purl.oclc.org/NET/ssnx/ssn#hasProperty> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasDateTime> a owl:ObjectProperty ;
    rdfs:label "has date time" ;
    rdfs:comment "Relationship between an event (DUL:Region) and a point in time." ;
    rdfs:domain <http://www.loa-cnr.it/ontologies/DUL.owl#Region> ;
    rdfs:range time:Instant ;
    rdfs:subPropertyOf <http://www.linkedmodel.org/schema/vaem#date> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasEffect> a owl:ObjectProperty ;
    rdfs:label "has effect" ;
    rdfs:comment "Relationship between an Actuator and the effect that it induces. The Effect will be linked to a physical property that the actuator impacts" ;
    rdfs:domain <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuator> ;
    rdfs:range <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Effect> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#impacts> a owl:ObjectProperty ;
    rdfs:label "impacts" ;
    rdfs:comment "Relationship between an effect and the property it impacts. Used in the Effect-Actuator-Actuation design pattern to describe the link between an actuator and the physical property it acts upon." ;
    rdfs:domain <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Effect> ;
    rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#Property> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#isActedUponBy> a owl:ObjectProperty ;
    rdfs:label "is acted upon by" ;
    rdfs:comment "Relation between an entity that is acted upen by another acting entity" ;
    rdfs:domain <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> ;
    rdfs:range <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> .

<http://www.linkedmodel.org/schema/vaem#date> a owl:ObjectProperty .

<http://www.linkedmodel.org/schema/vaem#dateUnion> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#Agent> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#Amount> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#InformationObject> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#Method> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#Object> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#Quality> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#Situation> a owl:Class ;
    owl:equivalentClass <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> .

<http://www.loa-cnr.it/ontologies/DUL.owl#UnitOfMeasure> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#includesEvent> a owl:ObjectProperty .

<http://www.loa-cnr.it/ontologies/DUL.owl#isParametrizedBy> a owl:ObjectProperty .

<http://www.loa-cnr.it/ontologies/DUL.owl#isSettingFor> a owl:ObjectProperty .

<http://purl.oclc.org/NET/ssnx/ssn#hasProperty> a owl:ObjectProperty .

<http://purl.oclc.org/NET/ssnx/ssn#hasValue> a owl:ObjectProperty .

<http://qudt.org/schema/qudt#QuantityKind> a owl:Class ;
    rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Quality> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#Acting> a owl:Class ;
    rdfs:label "Acting" ;
    rdfs:comment "Acting is the process that results in an action on the physical world, might it be a motion, a display, the emission of a sound..." ;
    rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Process> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#isConsumedBy> a owl:ObjectProperty ;
    rdfs:label "is consumed by" ;
    rdfs:comment "Describes a relation between a consumer and a consumee" ;
    rdfs:domain <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> ;
    rdfs:range <http://www.loa-cnr.it/ontologies/DUL.owl#Entity> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#wasActuationSent> a owl:ObjectProperty ;
    rdfs:label "was actuation sent" ;
    rdfs:comment "Relationship between an actuation that was sent and the actuator that received it" ;
    rdfs:domain <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuation> ;
    rdfs:range <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuator> .

<http://www.loa-cnr.it/ontologies/DUL.owl#Event> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalObject> a owl:Class .

<http://www.loa-cnr.it/ontologies/DUL.owl#Region> a owl:Class .

time:Instant a owl:Class ;
    rdfs:subClassOf <http://www.linkedmodel.org/schema/vaem#dateUnion> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingCapability> a owl:Class ;
    rdfs:label "Actuating Capability" ;
    rdfs:comment "Represents actuation properties such as precision, latency, power consumption, and the environmental conditions in which these actuation can take place normally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#forProperty> ;
            owl:someValuesFrom <http://qudt.org/schema/qudt#QuantityKind> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasActuatingProperty> ;
            owl:someValuesFrom <http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingProperty> ],
        <http://purl.oclc.org/NET/ssnx/ssn#Property> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingProperty> a owl:Class ;
    rdfs:label "Actuating Property" ;
    rdfs:comment "A characteristic of an Actuator that gives information about the Actuations it is able to perform." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#hasValue> ;
            owl:someValuesFrom <http://www.loa-cnr.it/ontologies/DUL.owl#Amount> ],
        <http://purl.oclc.org/NET/ssnx/ssn#Property> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuation> a owl:Class ;
    rdfs:label "Actuation" ;
    rdfs:comment "An Actuation is the abstract representation of the command that will be translated into Effect by the Actuator (cf http://ontologydesignpatterns.org/wiki/Submissions:Actuation-Actuator-Effect for more information)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/SAN#wasActuationSent> ;
            owl:someValuesFrom <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuator> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#includesEvent> ;
            owl:someValuesFrom <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Effect> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Acting> ;
            owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/SAN#actuationMethodUsed> ],
        <http://www.loa-cnr.it/ontologies/DUL.owl#Situation> .

<http://purl.oclc.org/NET/ssnx/ssn#Property> a owl:Class ;
    rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/ssn" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#isPropertyOf> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/ssn#FeatureOfInterest> ],
        <http://qudt.org/schema/qudt#QuantityKind> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#Effect> a owl:Class ;
    rdfs:label "Effect" ;
    rdfs:comment "Concept bound to the definition of an actuator as an agent havong an effect on the physical world. Therefore, an effect is any kind of physical modification induced by an actuator." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/SAN#impacts> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/ssn#Property> ],
        <http://www.loa-cnr.it/ontologies/DUL.owl#Event> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuator> a owl:Class ;
    rdfs:label "Actuator" ;
    rdfs:comment "An actuator is an entity which is able to act upon the physical world. Whether it is a light bulb or a servomotor, an actuator receives inputs represented by Actuations and produces an effect on the world." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#implements> ;
            owl:someValuesFrom <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Acting> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasActuatingCapability> ;
            owl:someValuesFrom <http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingCapability> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasEffect> ;
            owl:someValuesFrom <http://www.irit.fr/recherches/MELODI/ontologies/SAN#Effect> ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/SAN#actsOn> ;
            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/ssn#Property> ],
        <http://www.loa-cnr.it/ontologies/DUL.owl#Agent>,
        <http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalObject> .

