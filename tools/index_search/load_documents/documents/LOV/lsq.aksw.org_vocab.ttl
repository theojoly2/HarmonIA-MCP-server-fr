@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://lsq.aksw.org/vocab> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    dcterms:creator <http://aidanhogan.com/foaf.rdf#me> ;
    dcterms:date "2015-09-07"^^xsd:date ;
    dcterms:description "The Linked SPARQL Queries Vocabulary (LSQ(V)), defined using RDF(S) and OWL, provides a machine readable vocabulary to help describe queries in SPARQL logs and their statistics. The vocabulary builds upon the SPIN vocabulary and the Service Description vocabulary."@en ;
    dcterms:title "The Linked SPARQL Queries Vocabulary (LSQ(V))"@en .

<http://lsq.aksw.org/vocab#Avg> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Avg"@en .

<http://lsq.aksw.org/vocab#Bind> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Bind"@en .

<http://lsq.aksw.org/vocab#Count> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Count"@en .

<http://lsq.aksw.org/vocab#Distinct> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Distinct"@en .

<http://lsq.aksw.org/vocab#Execution> a owl:Class ;
    rdfs:label "Query Execution"@en ;
    rdfs:comment "Each instance is an execution of a particular query against a particular endpoint at a particular time by a particular agent"@en .

<http://lsq.aksw.org/vocab#Filter> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Filter"@en .

<http://lsq.aksw.org/vocab#FromNamed> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "FromNamed"@en .

<http://lsq.aksw.org/vocab#GroupBy> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "GroupBy"@en .

<http://lsq.aksw.org/vocab#Having> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Having"@en .

<http://lsq.aksw.org/vocab#Hybrid> a owl:Class ;
    rdfs:label "Hybrid Join Vertex"@en ;
    rdfs:comment "Each instance is a hybrid join vertex (position) in the query (at least one incoming edge, at least one outgoing edge, at least three edges)"@en ;
    rdfs:subClassOf <http://lsq.aksw.org/vocab#JoinVertex> .

<http://lsq.aksw.org/vocab#Limit> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Limit"@en .

<http://lsq.aksw.org/vocab#Max> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Max"@en .

<http://lsq.aksw.org/vocab#Min> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Min"@en .

<http://lsq.aksw.org/vocab#Minus> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Minus"@en .

<http://lsq.aksw.org/vocab#NamedGraph> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "NamedGraph"@en ;
    owl:sameAs <http://lsq.aksw.org/vocab#namedGraph> .

<http://lsq.aksw.org/vocab#Offset> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Offset"@en .

<http://lsq.aksw.org/vocab#Optional> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Optional"@en .

<http://lsq.aksw.org/vocab#OrderBy> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "OrderBy"@en .

<http://lsq.aksw.org/vocab#Path> a owl:Class ;
    rdfs:label "Path Join Vertex"@en ;
    rdfs:comment "Each instance is a path-shaped join vertex (position) in the query (one incoming edge, one outgoing edge)"@en ;
    rdfs:subClassOf <http://lsq.aksw.org/vocab#JoinVertex> .

<http://lsq.aksw.org/vocab#Regex> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Regex"@en .

<http://lsq.aksw.org/vocab#Service> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Service"@en .

<http://lsq.aksw.org/vocab#Sink> a owl:Class ;
    rdfs:label "Sink Join Vertex"@en ;
    rdfs:comment "Each instance is a sink join vertex (position) in the query (multiple incoming edges, zero outgoing edges)"@en ;
    rdfs:subClassOf <http://lsq.aksw.org/vocab#JoinVertex> .

<http://lsq.aksw.org/vocab#Star> a owl:Class ;
    rdfs:label "Star Join Vertex"@en ;
    rdfs:comment "Each instance is a star-shaped join vertex (position) in the query (zero incoming edges, multiple outgoing edges)"@en ;
    rdfs:subClassOf <http://lsq.aksw.org/vocab#JoinVertex> .

<http://lsq.aksw.org/vocab#SubQuery> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "SubQuery"@en .

<http://lsq.aksw.org/vocab#Sum> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Sum"@en .

<http://lsq.aksw.org/vocab#Union> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Union"@en .

<http://lsq.aksw.org/vocab#Values> a <http://www.w3.org/ns/sparql-service-description#Feature> ;
    rdfs:label "Values"@en .

<http://lsq.aksw.org/vocab#agent> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "run by agent"@en ;
    rdfs:comment "Links a query execution instance to the agent that initiated the execution"@en .

<http://lsq.aksw.org/vocab#bgps> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number of bgps"@en ;
    rdfs:comment "The number of Basic Graph Patterns in a query"@en ;
    rdfs:range xsd:nonNegativeInteger .

<http://lsq.aksw.org/vocab#endpoint> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "run at endpoint"@en ;
    rdfs:comment "Links a query execution instance to the endpoint against which it was run"@en .

<http://lsq.aksw.org/vocab#execution> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has execution"@en ;
    rdfs:comment "Links a query to an execution of it against a particular endpoint by a particular agent at a particular time"@en .

<http://lsq.aksw.org/vocab#executionError> a owl:DatatypeProperty ;
    rdfs:label "execution error"@en ;
    rdfs:comment "The text of an error encountered during a query execution"@en .

<http://lsq.aksw.org/vocab#joinVertex> a owl:ObjectProperty ;
    rdfs:label "has join vertex"@en ;
    rdfs:comment "Links a query to a join vertex it contains"@en .

<http://lsq.aksw.org/vocab#joinVertexType> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is of type"@en ;
    rdfs:comment "Links a join vertex to the type of vertex it is"@en .

<http://lsq.aksw.org/vocab#joinVertices> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number of join vertices"@en ;
    rdfs:comment "The number of join vertices in a query"@en ;
    rdfs:range xsd:nonNegativeInteger .

<http://lsq.aksw.org/vocab#meanJoinVerticesDegree> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "mean join vertex degree"@en ;
    rdfs:comment "The mean degree across all the join vertices"@en ;
    rdfs:range xsd:decimal .

<http://lsq.aksw.org/vocab#meanTriplePatternSelectivity> a owl:DatatypeProperty ;
    rdfs:label "mean selectivity of triple patterns"@en ;
    rdfs:comment "The mean selectivity of all triple patterns"@en ;
    rdfs:range xsd:decimal .

<http://lsq.aksw.org/vocab#mentionsObject> a rdf:Property ;
    rdfs:label "mentions object"@en ;
    rdfs:comment "Links a query to a term it mentions in the object of a triple pattern"@en .

<http://lsq.aksw.org/vocab#mentionsPredicate> a rdf:Property ;
    rdfs:label "mentions predicate"@en ;
    rdfs:comment "Links a query to a term it mentions in the predicate of a triple pattern"@en .

<http://lsq.aksw.org/vocab#mentionsSubject> a rdf:Property ;
    rdfs:label "mentions subject"@en ;
    rdfs:comment "Links a query to a term it mentions in the subject of a triple pattern"@en .

<http://lsq.aksw.org/vocab#parseError> a owl:DatatypeProperty ;
    rdfs:label "parse error"@en ;
    rdfs:comment "The text of an error encountered when parsing query"@en .

<http://lsq.aksw.org/vocab#resultSize> a owl:DatatypeProperty ;
    rdfs:label "result size"@en ;
    rdfs:comment "Number of results returned when executed locally"@en ;
    rdfs:range xsd:nonNegativeInteger .

<http://lsq.aksw.org/vocab#runTimeMs> a owl:DatatypeProperty ;
    rdfs:label "run time in milliseconds"@en ;
    rdfs:comment "The run time of the query in milliseconds when executed locally"@en ;
    rdfs:range xsd:decimal .

<http://lsq.aksw.org/vocab#runtimeError> a owl:DatatypeProperty ;
    rdfs:label "runtime error"@en ;
    rdfs:comment "The text of an error encountered when running the query locally"@en .

<http://lsq.aksw.org/vocab#spinError> a owl:DatatypeProperty ;
    rdfs:label "SPIN error"@en ;
    rdfs:comment "The text of an error encountered when generating the SPIN description"@en .

<http://lsq.aksw.org/vocab#triplePatterns> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number of triple patterns"@en ;
    rdfs:comment "The number of triple patterns in a query"@en ;
    rdfs:range xsd:nonNegativeInteger .

<http://lsq.aksw.org/vocab#usesFeature> a owl:ObjectProperty ;
    rdfs:label "uses feature"@en ;
    rdfs:comment "A feature used by the query"@en .

<http://lsq.aksw.org/vocab#JoinVertex> a owl:Class ;
    rdfs:label "Join Vertex"@en ;
    rdfs:comment "Each instance is a join vertex (position) in the query"@en .

