@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix ns3: <http://gbol.life/ontology/bibo#> .
@prefix onto: <https://w3id.org/tribont/material> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns3:status a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

owl:cardinality a owl:AnnotationProperty .

owl:maxCardinality a owl:AnnotationProperty .

owl:maxQualifiedCardinality a owl:AnnotationProperty .

owl:qualifiedCardinality a owl:AnnotationProperty .

ns1:term_status a owl:AnnotationProperty .

<https://w3id.org/tribont/core#Body> a owl:Class ;
    owl:disjointWith <https://w3id.org/tribont/material#Material> .

onto: a owl:Ontology ;
    ns2:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    ns3:status "published" ;
    dcterms:bibliographicCitation "Work in progress" ;
    dcterms:contributor "Izaskun Fernandez (Tekniker) \\nDomain expert:Iban Quintana (Tekniker) \\nDomain expert:Xana Fernandez (Tekniker)"@en ;
    dcterms:created "2023-06-02" ;
    dcterms:creator "Patricia Casla (Tekniker)"@en ;
    dcterms:description "The goal of this module is to represent the materials  that can be involved in the tribological experiments as part of the tested samples."@en ;
    dcterms:publisher "Tekniker" ;
    dcterms:title "Material module" ;
    vann:preferredNamespacePrefix "material" ;
    vann:preferredNamespaceUri "https://w3id.org/tribont/material" ;
    owl:imports <https://w3id.org/tribont/core> ;
    owl:versionInfo 1.0 .

<https://w3id.org/tribont/material#AISI_52100> a owl:NamedIndividual,
        <https://w3id.org/tribont/material#MaterialStandard> ;
    rdfs:label "AISI_52100" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#ASTM_A295> a owl:NamedIndividual,
