<https://w3id.org/isCharacterisedBy#isCharacterisedBy> a owl:ObjectProperty .

<https://w3id.org/tribont/material#Material> a owl:Class ;
    rdfs:label "Material" ;
    rdfs:comment "The basic material from which something is made." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/material#MaterialIdentification> ;
            owl:onProperty <https://w3id.org/tribont/material#hasNaming> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://w3id.org/tribont/core#ElectricalProperty> <https://w3id.org/tribont/core#MechanicalProperty> <https://w3id.org/tribont/core#PhysicalProperty> <https://w3id.org/tribont/core#ThermalProperty> <https://w3id.org/tribont/material#ElementConcentration> ) ] ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/material#MaterialApplication> ;
            owl:onProperty <https://w3id.org/tribont/material#hasTypicalUse> ],
        <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#MetallicMaterial> a owl:Class ;
    rdfs:label "MetallicMaterial" ;
    rdfs:comment "Metal and alloy material." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf <https://w3id.org/tribont/material#SolidMaterial> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#hasElementRole> a owl:ObjectProperty ;
    rdfs:label "hasElementRole" ;
    rdfs:comment "Relationship between an element and its role," ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:range <https://w3id.org/tribont/material#ElementRole> ;
    owl:inverseOf <https://w3id.org/tribont/material#isElementRoleFor> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#MaterialIdentification> a owl:Class ;
    rdfs:label "MaterialIdentification" ;
    rdfs:comment "Something that identifies a material." ;
    rdfs:isDefinedBy "MaterialIdentification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tribont/core#longName> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tribont/core#name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tribont/core#shortNam> ] ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#PolymerMaterial> a owl:Class ;
    rdfs:label "PolymerMaterial" ;
    rdfs:comment "Any polymer" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf <https://w3id.org/tribont/material#SolidMaterial> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#Steel> a owl:Class ;
    rdfs:label "Steel" ;
    rdfs:comment "Steel material." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf <https://w3id.org/tribont/material#MetallicMaterial> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#MaterialStandard> a owl:Class ;
    rdfs:label "MaterialStandard" ;
    rdfs:comment "A document approved by a recognized body that provides common to by fullfiled by a material." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#Standard> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#SolidMaterial> a owl:Class ;
    rdfs:label "SolidMaterial" ;
    rdfs:comment "Solid material." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://w3id.org/tribont/core#ElectricalProperty> <https://w3id.org/tribont/core#MechanicalProperty> <https://w3id.org/tribont/core#SolidPhysicalProperty> <https://w3id.org/tribont/core#SolidThermalProperty> <https://w3id.org/tribont/material#ElementConcentration> ) ] ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        <https://w3id.org/tribont/material#Material> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#ElementConcentration> a owl:Class ;
    rdfs:label "ElementConcentration" ;
    rdfs:comment "Concentration of an specific element in a material." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/material#ElementRole> ;
            owl:onProperty <https://w3id.org/tribont/material#hasElementRole> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/material#ElementRole> ;
            owl:onProperty <https://w3id.org/tribont/material#hasElementRole> ],
        <https://w3id.org/isCharacterisedBy#Property> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#ElementRole> a owl:Class ;
    rdfs:label "ElementRole" ;
    rdfs:comment "The position or purpose that an element has in a situation or relationship." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#Role> ;
    ns1:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#hasUnit> a owl:ObjectProperty .

<https://w3id.org/tribont/material#OtherElementConcentration> a owl:Class ;
    rdfs:label "OtherElementConcentration" ;
    rdfs:comment "Concentration  of an additive element in a material." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <https://w3id.org/tribont/material#additive> ;
            owl:onProperty <https://w3id.org/tribont/material#hasElementRole> ],
        <https://w3id.org/tribont/material#ElementConcentration> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#PolymerElementConcentration> a owl:Class ;
    rdfs:label "PolymerElementConcentration" ;
    rdfs:comment "Concentration of polymer element in a material." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf <https://w3id.org/tribont/material#ElementConcentration> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#ChemicalElementConcentration> a owl:Class ;
    rdfs:label "ChemicalElementConcentration" ;
    rdfs:comment "Concentration of chemical element in a material." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf <https://w3id.org/tribont/material#ElementConcentration> ;
    ns1:term_status "Testing" .

