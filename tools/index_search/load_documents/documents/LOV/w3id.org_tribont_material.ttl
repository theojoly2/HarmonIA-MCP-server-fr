    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#Alluminium-Flake> a owl:Class ;
    rdfs:label "Alluminium-Flake" ;
    rdfs:comment "Content of Alluminium-Flake in a material." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf <https://w3id.org/tribont/material#PolymerElementConcentration> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/material#AlluminiumAlloy> a owl:Class ;
