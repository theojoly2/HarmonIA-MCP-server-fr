@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://www.w3.org/ns/rdftest> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.w3.org/ns/rdftest#Approval> a rdfs:Class ;
    rdfs:label "Approval"@en ;
    rdfs:comment "The superclass of all test approval statuses."@en .

<http://www.w3.org/ns/rdftest#Approved> a rdfs:Class ;
    rdfs:label "Approved"@en ;
    rdfs:comment "Indicates that a test is approved."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#Approval> .

<http://www.w3.org/ns/rdftest#Proposed> a rdfs:Class ;
    rdfs:label "Proposed"@en ;
    rdfs:comment "Indicates that a test is proposed, but not approved."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#Approval> .

<http://www.w3.org/ns/rdftest#Rejected> a rdfs:Class ;
    rdfs:label "Rejected"@en ;
    rdfs:comment "Indicates that a test is not approved."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#Approval> .

<http://www.w3.org/ns/rdftest#Test> a rdfs:Class ;
    rdfs:label "Test"@en ;
    rdfs:comment "Superclass of all RDF Tests."@en .

<http://www.w3.org/ns/rdftest#TestEval> a rdfs:Class ;
    rdfs:label "Test Evaluation"@en ;
    rdfs:comment "Superclass of all RDF Evaluation Tests."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#Test> .

<http://www.w3.org/ns/rdftest#TestNQuadsNegativeSyntax> a rdfs:Class ;
    rdfs:label "N-Quads Negative Syntax"@en ;
    rdfs:comment "A negative N-Quads syntax test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestSyntax> .

<http://www.w3.org/ns/rdftest#TestNQuadsPositiveSyntax> a rdfs:Class ;
    rdfs:label "N-Quads Positive Syntax"@en ;
    rdfs:comment "A positive N-Quads syntax test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestSyntax> .

<http://www.w3.org/ns/rdftest#TestNTriplesNegativeSyntax> a rdfs:Class ;
    rdfs:label "N-Triples Negative Syntax"@en ;
    rdfs:comment "A negative N-Triples syntax test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestSyntax> .

<http://www.w3.org/ns/rdftest#TestNTriplesPositiveSyntax> a rdfs:Class ;
    rdfs:label "N-Triples Positive Syntax"@en ;
    rdfs:comment "A positive N-Triples syntax test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestSyntax> .

<http://www.w3.org/ns/rdftest#TestSyntax> a rdfs:Class ;
    rdfs:label "Test Syntax"@en ;
    rdfs:comment "Superclass of all RDF Syntax Tests."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#Test> .

<http://www.w3.org/ns/rdftest#TestTriGNegativeSyntax> a rdfs:Class ;
    rdfs:label "TriG Negative Syntax"@en ;
    rdfs:comment "A negative TriG syntax test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestSyntax> .

<http://www.w3.org/ns/rdftest#TestTriGPositiveSyntax> a rdfs:Class ;
    rdfs:label "TriG Positive Syntax"@en ;
    rdfs:comment "A positive TriG syntax test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestSyntax> .

<http://www.w3.org/ns/rdftest#TestTrigEval> a rdfs:Class ;
    rdfs:label "TriG Positive Evaluation"@en ;
    rdfs:comment "A positive TriG evaluation test."@en .

<http://www.w3.org/ns/rdftest#TestTrigNegativeEval> a rdfs:Class ;
    rdfs:label "TriG Negative Evaluation"@en ;
    rdfs:comment "A negative TriG evaluation test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestEval> .

<http://www.w3.org/ns/rdftest#TestTurtleEval> a rdfs:Class ;
    rdfs:label "Turtle Positive Evaluation"@en ;
    rdfs:comment "A positive Turtle evaluation test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestEval> .

<http://www.w3.org/ns/rdftest#TestTurtleNegativeEval> a rdfs:Class ;
    rdfs:label "Turtle Negative Evaluation"@en ;
    rdfs:comment "A negative Turtle evaluation test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestEval> .

<http://www.w3.org/ns/rdftest#TestTurtleNegativeSyntax> a rdfs:Class ;
    rdfs:label "Turtle Negative Syntax"@en ;
    rdfs:comment "A negative Turtle syntax test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestSyntax> .

<http://www.w3.org/ns/rdftest#TestTurtlePositiveSyntax> a rdfs:Class ;
    rdfs:label "Turtle Positive Syntax"@en ;
    rdfs:comment "A positive Turtle syntax test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestSyntax> .

<http://www.w3.org/ns/rdftest#TestXMLNegativeSyntax> a rdfs:Class ;
    rdfs:label "RDF/XML Negative Syntax"@en ;
    rdfs:comment "A negative RDF/XML syntax test."@en .

<http://www.w3.org/ns/rdftest#XMLEval> a rdfs:Class ;
    rdfs:label "RDF/XML Evaluation"@en ;
    rdfs:comment "A positive RDF/XML evaluation test."@en ;
    rdfs:subClassOf <http://www.w3.org/ns/rdftest#TestEval> .

onto: a owl:Ontology ;
    rdfs:label "The RDF 1.1 Test Vocabulary"@en ;
    dcterms:description "This is a vocabulary document and is used to define classes and properties used in\\r\\n      RDF 1.1 Test Cases and associated test manifests.\\r\\n      The URI of the vocabulary is http://www.w3.org/ns/rdftest# (abbreviated by rdft: in this document).\\r\\n      Turtle and an JSON-LD versions of the vocabulary are also available.\\r\\n      The vocabulary is published by W3C.\\r\\n    "@en ;
    dcterms:publisher <http://www.w3.org/data#W3C> ;
    dcterms:title "The RDF 1.1 Test Vocabulary"@en ;
    rdfs:comment "This is a vocabulary document and is used to define classes and properties used in\\r\\n      RDF 1.1 Test Cases and associated test manifests.\\r\\n      The URI of the vocabulary is http://www.w3.org/ns/rdftest# (abbreviated by rdft: in this document).\\r\\n      Turtle and an JSON-LD versions of the vocabulary are also available.\\r\\n      The vocabulary is published by W3C.\\r\\n    "@en .

<http://www.w3.org/ns/rdftest#approval> a rdf:Property ;
    rdfs:label "approval"@en ;
    rdfs:comment "Approval status of a test."@en ;
    rdfs:domain <http://www.w3.org/ns/rdftest#Test> ;
    rdfs:range <http://www.w3.org/ns/rdftest#Approval> .

