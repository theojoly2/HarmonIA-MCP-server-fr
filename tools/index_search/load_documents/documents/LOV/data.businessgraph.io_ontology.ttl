@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://schema.org/> .
@prefix onto: <http://data.businessgraph.io/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:IdentifierSystem a rdfs:Class ;
    rdfs:label "Identifier System" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A system managed by a publisher (e.g., a register or agency) that is used to issue identifiers to entities (companies, persons, etc)." ;
    skos:example "http://www.registryagency.bg keeps the systems used by The Trade Register http://brra.bg for companies, and The Bulstat Register http://www.bulstat.bg/ for other entities" ;
    skos:scopeNote "Some agencies/registers keep several identifier systems; this ontology doesn't distinguish between an identifier system and its register(s)" .

onto:IdentifierWebResource a rdfs:Class ;
    rdfs:label "Identifier Web Resource" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "URL template complemented with name, language and MIME type(s) to specify what the URL is about. Substitute the identifier value into the template" ;
    skos:scopeNote "This class has ebg:urlTemplate, and the same general properties as Web Resource: name, MIME type, language" .

onto:LAURegion a rdfs:Class ;
    rdfs:label "LAU Region" ;
    dcterms:source <http://ec.europa.eu/eurostat/web/nuts/correspondence-tables/national-structures-non-eu>,
        <http://ec.europa.eu/eurostat/web/nuts/national-structures-eu> ;
    rdfs:comment "Local Administrative Unit" ;
    rdfs:isDefinedBy onto: ;
    skos:example "LAU1 BG: Общини (Obshtini)",
        "LAU1 CH: Bezirke Districts Distretti",
        "LAU1 CY: Επαpχίες (Eparchies)",
        "LAU1 CZ: Okresy",
        "LAU1 DE: Verwaltungs- gemeinschaften",
        "LAU1 DK: Kommuner",
        "LAU1 EE: Maakond",
        "LAU1 EL: Δήμοι, Κοινότητες (Demoi, Koinotites)",
        "LAU1 FI: Seutukunnat / Ekonomiska regioner",
        "LAU1 FR: Cantons de rattachement",
        "LAU1 HU: Statisztikai kistérségek",
        "LAU1 IE: Counties, Cities",
        "LAU1 IS: Landsvædi",
        "LAU1 LI: Landschaften",
        "LAU1 LT: Savivaldybės",
        "LAU1 LU: Cantons",
        "LAU1 ME: Општине (Opštine)",
        "LAU1 MK: Општини (Opštini)",
        "LAU1 MT: Distretti",
        "LAU1 NO: Økonomiske regioner",
        "LAU1 PL: Powiaty i miasta na prawach powiatu",
        "LAU1 PT: Concelhos - Munícipios",
        "LAU1 SI: Upravne enote",
        "LAU1 SK: Okresy",
        "LAU1 TR: Ilceler",
        "LAU1 UK: Lower tier authorities (districts) or individual unitary authorities;  Individual unitary authorities or LECs (or parts thereof); Districts",
        "LAU2 AL: Bashki / Komunë",
        "LAU2 AT: Gemeinden",
        "LAU2 BE: Gemeenten / Communes",
        "LAU2 BG: Naseleni mesta",
        "LAU2 CH: Gemeinden Communes Comuni",
        "LAU2 CY: Δήμοι, Κοινότητες (Dimoi, koinotites)",
        "LAU2 CZ: Obce",
        "LAU2 DE: Gemeinden",
        "LAU2 DK: Sogne",
        "LAU2 EE: Linn, vald",
        "LAU2 EL: Δημοτικές / Τοπικές Κοινότητες (Dimotikes / Topikes Koinotites - Municipal  / Local Communes)",
        "LAU2 ES: Municipios",
        "LAU2 FI: Kunnat / Kommuner",
        "LAU2 FR: Communes",
        "LAU2 HR: Gradovi i općine",
        "LAU2 HU: Települések",
        "LAU2 IE: Electoral Districts",
        "LAU2 IS: Sveitarfélög",
        "LAU2 IT: Comuni",
        "LAU2 LI: Gemeinden",
        "LAU2 LT: Seniūnijos",
        "LAU2 LU: Communes",
        "LAU2 LV: Republikas pilsētas, novadi",
        "LAU2 ME: Naselja",
        "LAU2 MK: Naseleni mesta",
        "LAU2 MT: Kunsilli",
        "LAU2 NL: Gemeenten",
        "LAU2 NO: Kommuner",
        "LAU2 PL: Gminy",
        "LAU2 PT: Freguesias",
        "LAU2 RO: Comuni + Municipiu + Orase",
        "LAU2 SE: Kommuner",
        "LAU2 SI: Obcine",
        "LAU2 SK: Obce",
        "LAU2 TR: Köy",
        "LAU2 UK: Wards (or parts thereof)" .

onto:WebResource a rdfs:Class ;
    rdfs:label "Web Resource" ;
    rdfs:isDefinedBy onto: ;
    skos:definition "URL complemented with name, language and MIME type(s) to specify what the URL is about" .

<http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion> a rdfs:Class ;
    rdfs:label "NUTS Region" .

ns1:GeoCoordinates a rdfs:Class ;
    rdfs:label "Geographic coordinates" ;
    skos:definition "Geographic coordinates, eg of a geo-located address." .

ns1:Organization a rdfs:Class ;
    rdfs:label "Organization" ;
    skos:definition "An organization." ;
    skos:scopeNote "Used to represent the creator, publisher and author of an IdentifierSystem, and the creator of an Identifier" .

rdf:Resource a rdfs:Class ;
    rdfs:label "Resource" .

skos:Concept a rdfs:Class ;
    rdfs:label "Concept" .

skos:ConceptScheme a rdfs:Class ;
    rdfs:label "Concept Scheme" .

time:Instant a rdfs:Class ;
    rdfs:label "Instant" ;
    skos:definition "A temporal entity with zero extent or duration." .

time:Interval a rdfs:Class ;
    rdfs:label "Interval" ;
    skos:definition "represents a time interval." .

<http://www.w3.org/ns/adms#Identifier> a rdfs:Class ;
    rdfs:label "Identifier" ;
    skos:definition "Identifier of an entity (company, person) according to some identifier system." ;
    skos:scopeNote "The identifier value is recorded in skos:notation and the issuer/register in dct:creator." .

<http://www.w3.org/ns/locn#Address> a rdfs:Class ;
    rdfs:label "Address" ;
    skos:definition "Mailing or physical address of a company" ;
    skos:scopeNote "Every data provider should strive to provide NUTS3 for each address. This can be done in cooperation, using the techniques described in Address Calculations above.",
        "Should be linked as registered address (one) or other address (multiple)." .

org:Membership a rdfs:Class ;
    rdfs:label "Membership" ;
    skos:definition "represents the relation between an organisation and a member of that organisation." ;
    skos:scopeNote "it is acceptable to use the same Membership node for several officers, if they had exactly the same role and membership interval (e.g. in many countries the Board is appointed and discharged at the same interval, namely between AGMs of the company)" .

org:Role a rdfs:Class ;
    rdfs:label "Role" ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Denotes a role that a Person can take in an organization." ;
    skos:scopeNote "Instances of this class describe the abstract role; to denote a specific instance of a person playing that role in a specific organization use an instance of org:Membership." .

org:Site a rdfs:Class ;
    rdfs:label "Site" ;
    skos:definition "An office or other premise at which the organization is located.\\nMany organizations are spread across multiple sites and many sites will host multiple locations.\\nIn most cases a Site will be a physical location. However, we don't exclude the possibility of non-physical sites such as a virtual office with an associated post box and phone reception service [org:]"@en ;
    skos:scopeNote "EBG doesn't need the distinction between org:Site and locn:Address, so we use one node having both types, and a self link org:siteAddress" .

<http://www.w3.org/ns/person#Person> a rdfs:Class ;
    rdfs:label "Officer" ;
    skos:definition "An officer is a natural person (as opposed to a legal person) [person:] that has a high-level management role in a Company (e.g., the CEO, treasurer and chief financial officer). Despite their high status, they typically serve at the will of the corporate directors, who can fire or replace them. Officers can also be shareholders and directors but don't necessarily have to be. They have the authority to act on behalf of the corporation, including contract authority." .

<http://www.w3.org/ns/regorg#RegisteredOrganization> a rdfs:Class ;
    rdfs:label "Registered Organization" ;
    skos:definition "An organization that gains legal entity status by the act of registration. Compare to org:FormalOrganization that applies to any legal entity, including those created by other legal means. Registered organizations are distinct from the broader concept of organizations, groups or, in some jurisdictions, sole traders. Many organizations exist that are not legal entities yet to the outside world they have staff, hierarchies, locations etc. Other organizations exist that are an umbrella for several legal entities (universities are often good examples of this) [rov:].  A legal person or structure that is organized under the laws of any jurisdiction [lei-elf:]." ;
    skos:example "All entities listed on an exchange.",
        "All entities that issue equity, debt or other securities for other capital structures.",
        "All entities that trade stock or debt, investment vehicles, including mutual funds, pension funds and alternative investment vehicles constituted as corporate entities or collective investment agreements (including umbrella funds as well as funds under an umbrella structure, hedge funds, private equity funds, etc.).",
        "All entities under the purview of a financial regulator and their affiliates, subsidiaries and holding companies.",
        "All financial intermediaries.",
        "Banks and finance companies.",
        "Counterparties to financial transactions." ;
    skos:scopeNote "Registered organizations are the main entities that euBusinessGraph works with (the project is not concerned with  unregistered informal groups). The borderline between public organizations and commercial companies is not always clear-cut (a company may be partially owned by government, and e.g.  Public-Private-Partnerships are a prime example), so the project may deal with some organizations that are not companies. But for brevity and convenience we often call  them Companies [ebg:]." .

<http://data.businessgraph.io/dataset/free-available> a skos:Concept ;
    rdfs:isDefinedBy onto: ;
    skos:inScheme <http://data.businessgraph.io/dataset/> ;
    skos:prefLabel "Freely available" .

<http://data.businessgraph.io/dataset/paid-advertised> a skos:Concept ;
    rdfs:isDefinedBy onto: ;
    skos:inScheme <http://data.businessgraph.io/dataset/> ;
    skos:prefLabel "Paid (advertised only)" .

<http://data.businessgraph.io/dataset/partition> a skos:Concept ;
    rdfs:isDefinedBy onto: ;
    skos:inScheme <http://data.businessgraph.io/dataset/> ;
    skos:prefLabel "Partition" ;
    skos:scopeNote "Used to describe dataset statistics. Not downloadable separately." .

<http://data.businessgraph.io/lau/> a void:Dataset ;
    rdfs:label "LAU Regions" ;
    dcterms:created "2017-07-28"^^xsd:date ;
    dcterms:creator <http://businessgraph.io> ;
    dcterms:issued "2017-07-28"^^xsd:date ;
    dcterms:license <https://opendatacommons.org/licenses/by/> ;
    dcterms:publisher <http://businessgraph.io> ;
    dcterms:source <http://ec.europa.eu/eurostat/web/nuts/local-administrative-units> ;
    rdfs:comment "Local Administrative Units" ;
    rdfs:isDefinedBy onto: .

<http://data.businessgraph.io/nace/> a skos:ConceptScheme ;
    rdfs:label "NACE 2 classification" ;
    dcterms:created "2017-07-28"^^xsd:date ;
    dcterms:creator <http://businessgraph.io> ;
    dcterms:issued "2017-07-28"^^xsd:date ;
    dcterms:license <https://opendatacommons.org/licenses/by/> ;
    dcterms:publisher <http://businessgraph.io> ;
    dcterms:source <http://ec.europa.eu/eurostat/ramon/nomenclatures/index.cfm?TargetUrl=LST_CLS_DLD&StrNom=NACE_REV2&StrLanguageCode=EN&StrLayoutCode=HIERARCHIC#> ;
    rdfs:comment "Statistical Classification of Economic Activities in the European Community, Rev. 2 (2008)" ;
    rdfs:isDefinedBy onto: .

onto:adminUnit onto:order 107 .

onto:adminUnitL3 a owl:ObjectProperty ;
    rdfs:label "admin unit level 3" ;
    onto:order 31 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes <http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "NUTS2 (administrative region) of the address." ;
    skos:example "nuts:ITC2 Valle d'Aosta/Vallée d'Aoste",
        "nuts:ITH2 Provincia Autonoma di Trento" ;
    skos:scopeNote "Use a valid NUTS region. Eg Trentino-Alto Adige/Sudtirol (taken from the Geonames hierarchy above) is not a NUTS region." .

onto:adminUnitL4 a owl:ObjectProperty ;
    rdfs:label "admin unit level 4" ;
    onto:order 32 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes <http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "NUTS3 (Province) of the address." ;
    skos:example "nuts:ITC20 Aosta",
        "nuts:ITH31 Verona" .

onto:adminUnitL5 a owl:ObjectProperty ;
    rdfs:label "admin unit level 5" ;
    onto:order 33 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes onto:LAURegion ;
    rdfs:isDefinedBy onto: ;
    skos:definition "LAU1 (Municipality/Commune/Settlement) of the address." ;
    skos:scopeNote "Some countries (e.g. Bulgaria) use both LAU1 and LAU2 levels. Others (e.g. Italy) use only LAU2." .

onto:adminUnitL6 a owl:ObjectProperty ;
    rdfs:label "admin unit level 6" ;
    onto:order 34 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes onto:LAURegion ;
    rdfs:isDefinedBy onto: ;
    skos:definition "LAU2 (Municipality/Commune/Settlement) of the address." ;
    skos:scopeNote "Some countries (e.g. Bulgaria) use both LAU1 and LAU2 levels. Others (e.g. Italy) use only LAU2." .

onto:dissolutionYear a owl:DatatypeProperty ;
    rdfs:label "dissolution year" ;
    onto:order 16 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:integer ;
    skos:definition "Year the organization was dissolved or deregistered, as integer." ;
    skos:scopeNote "Used for faceting." .

onto:exclusionNote a owl:DatatypeProperty ;
    rdfs:label "exclusion note" ;
    onto:order 108 ;
    ns1:domainIncludes skos:Concept ;
    ns1:rangeIncludes rdf:langString ;
    rdfs:comment "Exclusion note of a NACE classification concept" ;
    rdfs:isDefinedBy onto: .

onto:foundingYear a owl:DatatypeProperty ;
    rdfs:label "founding year" ;
    onto:order 14 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:integer ;
    skos:definition "Year the organization was created, as integer." ;
    skos:scopeNote "Used for faceting." .

onto:geoResolution a owl:ObjectProperty ;
    rdfs:label "geocoordinate resolution" ;
    onto:order 44 ;
    ns1:domainIncludes ns1:GeoCoordinates ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Resolution of a geographic coordinate location: from <resolution/L0> continent (least precise) to <resolution/L10> individual house number (most precise)." ;
    skos:scopeNote "If geo coordinates are present, resolution must be present too, even if it's a guess. There is no default value.",
        "Values must be mapped to the <resolution/> ConceptScheme (lookup list)." .

onto:identifierWebResource a owl:ObjectProperty ;
    rdfs:label "identifier web resource" ;
    onto:order 63 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes onto:IdentifierWebResource ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Web resource associated with an identifier system" ;
    skos:example "'https://opencorporates.com/companies/{}'      with MIME type 'text/html'",
        "'https://opencorporates.com/companies/{}.json' with MIME type 'application/json'",
        "'https://opencorporates.com/companies/{}.rdf'  with MIME type 'application/rdf+xml'",
        "'https://opencorporates.com/companies/{}.xml'  with MIME type 'application/xml'" ;
    skos:scopeNote "Specifies a template that can be used uniformly to build URLs for all identifiers in the system." .

onto:isEnumerated a owl:DatatypeProperty ;
    rdfs:label "has enumerated identifiers" ;
    onto:order 58 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Whether the system has an Issuer and issued identifiers are kept in a database (register)" ;
    skos:example "Every official register is enumerated",
        "Websites are not enumerated" .

onto:isImmutable a owl:DatatypeProperty ;
    rdfs:label "has immutable identifiers" ;
    onto:order 55 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "whether identifiers can change" ;
    skos:example "Some registers encode additional information within the identifier (e.g., some identifiers encode the economic sector of the company). In these cases the identifier changes when the extra information that is encoded changes (see 'Dumb vs. Intelligent Identifiers' in Section 3.1.2.5)." .

onto:isOfficial a owl:DatatypeProperty ;
    rdfs:label "is official in jurisdiction" ;
    onto:order 59 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Whether the system is considered the official one in all jurisdictions in which it applies." ;
    skos:example "False for GLEI, since it is not the official register for any of the world's jurisdictions",
        "False for SDATI identifiers since the SDATI system is not official in Italy.",
        "False for Website, Twitter, Facebook in that they don't have any official status",
        "True for UK Company House identifiers, the official register for the GB jurisdiction" .

onto:isPersistent a owl:DatatypeProperty ;
    rdfs:label "has persistent identifiers" ;
    onto:order 54 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Whether identifiers can be removed from the register (e.g., when a company is dissolved): such are not persistent" ;
    skos:scopeNote "Some registers 'remove' identifiers when the object they relate to is no longer active, whereas the best practice is to make such identifiers Obsolete." .

onto:isPublic a owl:DatatypeProperty ;
    rdfs:label "is public" ;
    onto:order 56 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "whether identifiers from the system are available for public use: consulting, search or download." ;
    skos:example "DUNS identifiers are not public, even though there are limited lookup services (e.g., https://www.dnb.com/duns-number/lookup.html). Dun and Bradstreet does not allow their use en-masse.",
        "Italian (IT) company identifiers are public. Even though they are not published openly, they are available for a fee, and then can be used freely" ;
    skos:scopeNote "Most public systems (but not all) will have some Publishers, and preferably some web resources." .

onto:isPubliclyTraded a owl:DatatypeProperty ;
    rdfs:label "is publicly traded" ;
    onto:order 7 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Whether the company is publicly traded (listed at a stock exchange) [ebg:]." .

onto:isSingleValued a owl:DatatypeProperty ;
    rdfs:label "is single-valued" ;
    onto:order 53 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Whether each entity has only one identifier in the system" ;
    skos:example "Company IDs are single-valued in most national registers. If two companies merge, the recessive company ID is usually deprecated.",
        "Official person names are single-valued, since each person has one official name (but that can change over time).",
        "Stock exchange tickers are not single-valued, since a company may have several tickers for different kinds of its stock.",
        "Websites are not single-valued since a company may have several websites" ;
    skos:scopeNote "Similar to owl:FunctionalProperty, and Wikidata Single Value constraint" .

onto:isStartup a owl:DatatypeProperty ;
    rdfs:label "is startup" ;
    onto:order 5 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Whether the company is a startup [ebg:]" ;
    skos:example "A special section of the IT Business Register http://startup.registroimprese.it/ includes pitch, sectors and business model of startups and innovative SMEs" .

onto:isStateOwned a owl:DatatypeProperty ;
    rdfs:label "is state owned" ;
    onto:order 6 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Whether this organisation is owned by the government, a government agency, community, city or other public entity." ;
    skos:example "False for SpazioDati (a private company).",
        "True for the Autonomous Province of Trento (local government).",
        "True for the Norwegian company Statkraft (Norwegian state-owned company)." ;
    skos:scopeNote "In many cases it's not possible to compute this attribute without access to the shareholder register, so it may be missing." .

onto:isUnique a owl:DatatypeProperty ;
    rdfs:label "has unique identifiers" ;
    onto:order 52 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:boolean ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Whether each identifier in the system relates to only one entity" ;
    skos:example "Company IDs are unique in most national registers: one ID cannot identify two companies",
        "Person names are not unique since they are highly ambiguous",
        "Stock exchange tickers are unique to each exchange (but a company can buy the ticker of another, i.e. the identity may change over time)",
        "Websites are not unique since a website can be shared by several related companies" ;
    skos:scopeNote "Similar to: owl:InverseFunctionalProperty, and Wikidata Distinct Values constraint" .

onto:level a owl:DatatypeProperty ;
    rdfs:label "concept level" ;
    onto:order 109 ;
    ns1:domainIncludes skos:Concept ;
    ns1:rangeIncludes xsd:integer ;
    rdfs:comment "Hierarchical level of a thesaurus concept" ;
    rdfs:isDefinedBy onto: .

onto:numberOfEmployees a owl:DatatypeProperty ;
    rdfs:label "number of employees" ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:integer ;
    rdfs:isDefinedBy onto: ;
    skos:definition "The number of employees in the company." .

onto:order a owl:DatatypeProperty ;
    rdfs:label "order" ;
    onto:order 110 ;
    ns1:domainIncludes skos:Concept ;
    ns1:rangeIncludes xsd:integer ;
    rdfs:comment "Global order of a thesaurus concept respecting the hierarchical structure (depth-first traversal)" ;
    rdfs:isDefinedBy onto: .

onto:orgActivityText a owl:DatatypeProperty ;
    rdfs:label "economic activity text" ;
    onto:order 11 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:langString ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Economic activity of the organization (free text)" ;
    skos:example "Free text = Development, exploration and production of opto-electronic systems for analogue and digital holographic recording, interferometric measurement of mechanical characteristics and biological objects at micro and macro level, refractometers, light-sensitive materials for holographic recording, blueprints of museum exhibits, artworks and collection surveys, production of holographic illustrations for students, albums, advertising, souvenirs and others, design and manufacture of holographic optical elements with a wide spectrum of applications, marketing and sale of holographic products, consulting, training and promotion of holographic methods and technologies, mediation, brokerage, and **any other activity not prohibited** by Bulgarian legislation.",
        "NACE = 72.19 Scientific research and development in the field of natural, medical, agricultural and technical sciences, without biotechnology" ;
    skos:scopeNote "Such field is widely used in some countries (e.g. BG) and may include much richer info than rov:orgActivity" .

onto:orgActivityTransitive onto:order 12 .

onto:orgStatusText a owl:DatatypeProperty ;
    rdfs:label "status text" ;
    onto:order 9 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:langString ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Company status as it comes from the original register (free text)." ;
    skos:example "Dissolved"@en,
        "Inactive"@en,
        "Revoked"@en,
        "Situation Normale"@fr ;
    skos:scopeNote "If both Status and Status Text are present, they must express compatible values (Status Text may be a finer-granularity value).",
        "Include valid language tag (see [iana:] for list)." .

onto:orgTypeText a owl:DatatypeProperty ;
    rdfs:label "type text" ;
    onto:order 4 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:langString ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Company Type (Entity Legal Form) as reported by a national company registe (free text)." ;
    skos:example "Private Limited Company"@en ;
    skos:scopeNote "Because of the difficulties of standardizing Type lookup, we include a free text field",
        "If Type is also present, it must express the same value as Type Text.",
        "Include valid language tag (see [iana:] for list)." .

onto:probabilityOfDefault onto:order 114 .

onto:ralCode a owl:DatatypeProperty ;
    rdfs:label "identifier system RAL code" ;
    onto:order 50 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:string ;
    rdfs:isDefinedBy onto: ;
    skos:definition "GLEI RAL code for the identifier system." ;
    skos:scopeNote "Used only for official registers." .

onto:replacementPattern a owl:DatatypeProperty ;
    rdfs:label "replacement pattern" ;
    onto:order 62 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:string ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Pattern to use together with the Validation Regex to normalise identifier values by removing optional decorations" ;
    skos:example "\"$1$2$3\" can be used together with the validationRegex \"(\\\\d{2})-?(\\\\d{3})-?(\\\\d{4})\" to extract the pure digits from a DUNS number spelled with optional dashes (e.g. \"36-032-1459\" -> \"360321459\")" .

onto:rolePositionText a owl:DatatypeProperty ;
    rdfs:label "role text" ;
    ns1:domainIncludes org:Membership ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "The (hierarchical) position of the person within a company (in free text), e.g., director." .

onto:urlTemplate a owl:DatatypeProperty ;
    rdfs:label "URL template" ;
    onto:order 69 ;
    ns1:domainIncludes onto:IdentifierWebResource ;
    ns1:rangeIncludes xsd:string ;
    rdfs:isDefinedBy onto: ;
    skos:definition "URL template of an identifier web resource.\\nIf it has a placeholder {}, substitute the identifier value there.\\nIf it has placeholders like $1, $2… substitute the groups extracted by ebg:validationRegex" ;
    skos:example "'For BE Banque-Carrefour des Entreprises, 'https://kbopub.economie.fgov.be/kbopub/toonondernemingps.html?ondernemingsnummer={}' with MIME type 'text/html' shows a web page for the company.'",
        "'For BR, 'http://data.brreg.no/enhetsregisteret/enhet/{}' with either 'application/xml' or 'application/json' returns the respective MIME type using Content Negotiation'",
        "'For the EU Value Added Tax (VIES) register, 'http://ec.europa.eu/taxation_customs/vies/vatResponse.html?memberStateCode=$1&number=$2' with MIME type 'text/html' shows a web page for an identifier that can be parsed with ebg:validationRegex '([A-Z]{2})/(\\\\d+)'. Here $1 is the member state code, and $2 is the national company id'",
        "For OCORP, 'https://opencorporates.com/companies/{}'      returns company data with MIME type 'text/html'",
        "For OCORP, 'https://opencorporates.com/companies/{}.json' returns company data with MIME type 'application/json'",
        "For OCORP, 'https://opencorporates.com/companies/{}.rdf'  returns company data with MIME type 'application/rdf+xml'",
        "For OCORP, 'https://opencorporates.com/companies/{}.xml'  returns company data with MIME type 'application/xml'" .

onto:validationRegex a owl:DatatypeProperty ;
    rdfs:label "validation regex" ;
    onto:order 61 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes xsd:string ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Regular expression for validating identifier values within the system" ;
    skos:example "\"([A-Z]{2})/(\\\\d+)\" is a regex for the EU Value Added Tax (VIES) register, which consists of a member state code followed by slash and a national numeric identifier",
        "\"(\\\\d{2})-?(\\\\d{3})-?(\\\\d{4})\" is a regex for validating DUNS numbers that may include optional dashes in the indicated positions (e.g. \"36-032-1459\")",
        "\"\\\\d{9}\" is a simple regex for validating DUNS numbers" .

onto:validationRule a owl:ObjectProperty ;
    rdfs:label "validation rule" ;
    onto:order 60 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes rdf:Resource ;
    rdfs:isDefinedBy onto: ;
    skos:definition "URL providing human or machine-readable rule(s) for validating identifiers in the system" ;
    skos:example "http://bsv-bg.com/ describes the BG EIK checksum algorithm in HTML",
        "http://www.nsi.bg/sites/default/files/konkursi/RGP_OPAK_2014_Annex_6.pdf describes the BG EIK checksum algorithm in PDF. It is by an official source, but is less convenient" ;
    skos:scopeNote "Can be in the form of webpage, PDF document, RDF shape, etc. Multiple values about the same validation rule are ok." .

onto:webResource a owl:ObjectProperty ;
    rdfs:label "web resource" ;
    onto:order 64 ;
    ns1:domainIncludes onto:IdentifierSystem,
        void:Dataset ;
    ns1:rangeIncludes onto:WebResource ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Web resource associated with an identifier system." ;
    skos:example "http://opendata.government.bg/dataset/tbprobckn-pernctbp is the open data download site for BG TR.",
        "https://brra.bg is the homepage of BG TR.",
        "https://kbopub.economie.fgov.be/kbopub/zoeknummerform.html is the search URL for BE Banque-Carrefour des Entreprises." .

<http://data.businessgraph.io/resolution/> a skos:ConceptScheme ;
    rdfs:label "Geo Coordinate Resolution" ;
    dcterms:creator <http://businessgraph.io> ;
    dcterms:publisher <http://businessgraph.io> ;
    rdfs:comment "Resolution of a geographic coordinate location: from continent (least precise) to individual house number (most precise)" ;
    rdfs:isDefinedBy onto: .

<http://data.businessgraph.io/status/> a skos:ConceptScheme ;
    rdfs:label "Company status" ;
    dcterms:creator <http://businessgraph.io> ;
    dcterms:publisher <http://businessgraph.io> ;
    rdfs:comment "Company status, e.g. active, inactive. Unfortunately different providers use different definitions" ;
    rdfs:isDefinedBy onto: .

<http://data.businessgraph.io/type/> a skos:ConceptScheme ;
    rdfs:label "Company type" ;
    dcterms:creator <http://businessgraph.io> ;
    dcterms:publisher <http://businessgraph.io> ;
    rdfs:comment "Company type (legal form) per jurisdiction" ;
    rdfs:isDefinedBy onto: .

<http://dbpedia.org/ontology/jurisdiction> a owl:DatatypeProperty ;
    rdfs:label "jurisdiction" ;
    onto:order 22 ;
    ns1:domainIncludes onto:IdentifierSystem,
        <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "Jurisdiction in which the company is registered or to which the identifier system applies." ;
    skos:example "BG has many types, including a number of European companies.",
        "NO has type NUF 'Norskregistrert utenlandsk foretak'." ;
    skos:scopeNote "For Europe, this is a country, even for Germany that has 166 separate registers (see Registration Authorities List).  Many jurisdictions register foreign companies that are incorporated and fully owned in another country. EBG collects all registrations from each register and doesn't attempt to match foreign companies across jurisdictions.",
        "If we know the official legal ID of the company, the jurisdiction code and official ID are used to form the company URL." .

dc:format a owl:DatatypeProperty ;
    rdfs:label "MIME Type" ;
    onto:order 67 ;
    ns1:domainIncludes onto:IdentifierWebResource,
        onto:WebResource ;
    ns1:rangeIncludes rdf:Resource,
        xsd:string ;
    skos:definition "MIME type of the resource. If several are provided, the server must provide all these resource types using Content Negotiation" ;
    skos:example "'For a Description document supporting the OpenSearch standard, use '<http://a9.com/-/spec/opensearch/1.1/>''",
        "'For a search page, use the custom type 'application/x-search''",
        "application/rdf+xml",
        "application/xml",
        "text/csv",
        "text/html",
        "text/tab-separated-values",
        "text/turtle" .

dcterms:creator a owl:ObjectProperty ;
    rdfs:label "issuer" ;
    onto:order 46 ;
    ns1:domainIncludes onto:IdentifierSystem,
        <http://www.w3.org/ns/adms#Identifier> ;
    ns1:rangeIncludes ns1:Organization,
        ns1:Person ;
    skos:definition "Agent that issues identifiers and then keeps them in a database (register), and who issued a specific identifier" ;
    skos:example "Companies House is the issuer for the official UK identifier system.",
        "Dun and Bradstreet issues DUNS numbers.",
        "GLEI Foundation (GLEIF) issues identifiers for the world-wide GLEI register (through its Local Operating Units, LOU).",
        "Web URLs are not issued by any central agency and there is no register to consult.",
        "http://www.registryagency.bg keeps both Trade Register http://brra.bg for companies, and Bulstat Register http://www.bulstat.bg/ for other entities" ;
    skos:scopeNote "In many countries there is a single registry although in others, such as Spain and Germany, multiple registries exist. [rov:].",
        "Many agencies keep several registries; this ontology doesn't distinguish between an identifier system and its register(s)" .

dcterms:isPartOf a owl:ObjectProperty ;
    rdfs:label "is part of" ;
    onto:order 71 ;
    ns1:domainIncludes <http://www.w3.org/ns/adms#Identifier> ;
    ns1:rangeIncludes onto:IdentifierSystem ;
    skos:definition "The Identifier System this identifier is part of" .

dcterms:issued a owl:DatatypeProperty ;
    rdfs:label "issued on" ;
    onto:order 73 ;
    ns1:domainIncludes <http://www.w3.org/ns/adms#Identifier> ;
    ns1:rangeIncludes xsd:date ;
    skos:definition "When was the identifier was issued (start date)." ;
    skos:scopeNote "This may or may not be the same as the Incorporation Date of the company. Even for the official registration, the two dates may differ, depending on business rules." .

<http://rdfdata.eionet.europa.eu/ramon/ontology/code> a owl:DatatypeProperty ;
    rdfs:label "code" ;
    onto:order 111 ;
    ns1:domainIncludes onto:LAURegion,
        <http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion> ;
    ns1:rangeIncludes xsd:string ;
    rdfs:comment "NUTS/LAU Code of an administrative region" .

<http://rdfdata.eionet.europa.eu/ramon/ontology/level> a owl:DatatypeProperty ;
    rdfs:label "admin region level" ;
    onto:order 112 ;
    ns1:domainIncludes onto:LAURegion,
        <http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion> ;
    ns1:rangeIncludes xsd:integer ;
    rdfs:comment "Level of an administrative region: NUTS1..3=1..3, LAU1..2=4..5" .

<http://rdfdata.eionet.europa.eu/ramon/ontology/name> a owl:DatatypeProperty ;
    rdfs:label "admin region name" ;
    onto:order 113 ;
    ns1:domainIncludes onto:LAURegion,
        <http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion> ;
    ns1:rangeIncludes rdf:langString ;
    rdfs:comment "Name of an administrative region or settlement" .

<http://rdfs.org/sioc/ns#feed> a owl:ObjectProperty ;
    rdfs:label "news/blog feed" ;
    onto:order 21 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:Resource ;
    skos:definition "RSS/Atom feed pertaining to the company." ;
    skos:example <http://www.comune.ancona.gov.it/ankonline/anconaentrate/feed/> .

ns1:author a owl:ObjectProperty ;
    rdfs:label "author" ;
    onto:order 45 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes ns1:Organization,
        ns1:Person ;
    skos:definition "Agent who specified the rules and organisation of an Identifier System",
        "Agent who specified the rules and organization of the identifier system" ;
    skos:example "Dun and Bradstreet specified DUNS numbers",
        "GLEIF specified GLEI",
        "GLEIF specified LEI structure and rules, then formalied it as ISO 17442:2012 Financial services -- Legal Entity Identifier (LEI)",
        "W3C or TimBL specified web URLs",
        "W3C specified web URL rules" .

ns1:availableLanguage a owl:DatatypeProperty ;
    rdfs:label "language" ;
    onto:order 17 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "Languages used by the organization." ;
    skos:example "en",
        "it",
        "zh-CN" ;
    skos:scopeNote "Currently this data is provided by SDATI, for matching company entities only.",
        "Deduced from languages appearing in web resources related to the organisation (e.g. corporate websites, social network accounts, etc.).",
        "The value should be from the [iana:] list: ISO 639-1 codes, optionally followed by region of use." .

ns1:birthDate a owl:DatatypeProperty ;
    rdfs:label "person birth date" ;
    ns1:domainIncludes <http://www.w3.org/ns/person#Person> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "The birth date of the person." .

ns1:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    ns1:domainIncludes onto:IdentifierSystem,
        ns1:Organization ;
    ns1:rangeIncludes rdf:langString,
        xsd:string ;
    skos:definition "Description of the resource" .

ns1:dissolutionDate a owl:DatatypeProperty ;
    rdfs:label "dissolution date" ;
    onto:order 15 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:date,
        xsd:gYear,
        xsd:gYearMonth ;
    skos:definition "Date when the organization was dissolved or removed from register." ;
    skos:example "2010-11-18"^^xsd:date,
        "2010"^^xsd:gYear,
        "2010-11"^^xsd:gYearMonth ;
    skos:scopeNote "Should have a valid XSD datatype." .

ns1:email a owl:ObjectProperty ;
    rdfs:label "certified email address" ;
    onto:order 20 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:Resource ;
    skos:definition "Email that is officially registered and with the same validity as certified (snail) mail." ;
    skos:example <mailto:elettorale@pec.comune.trento.it> ;
    skos:scopeNote "The value should be a mailto: URL.",
        "euBusinessGraph does not record other company emails, so there is no need to distinguish between different kinds" .

ns1:expires a owl:DatatypeProperty ;
    rdfs:label "expires" ;
    onto:order 74 ;
    ns1:domainIncludes <http://www.w3.org/ns/adms#Identifier> ;
    ns1:rangeIncludes xsd:date ;
    skos:definition "Date when the identifier expires (end date)" ;
    skos:scopeNote "This may or may not be the same as the dissolution date of the company. Even when it is about the official registration, the two dates may differ, depending on business rules." .

ns1:foundingDate a owl:DatatypeProperty ;
    rdfs:label "founding date" ;
    onto:order 13 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes xsd:date,
        xsd:gYear,
        xsd:gYearMonth ;
    skos:definition "Date when the organization was created." ;
    skos:example "2010-11-18"^^xsd:date,
        "2010"^^xsd:gYear,
        "2010-11"^^xsd:gYearMonth ;
    skos:scopeNote "Should have a valid XSD datatype." .

ns1:gender a owl:DatatypeProperty ;
    rdfs:label "person gender" ;
    ns1:domainIncludes <http://www.w3.org/ns/person#Person> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "The gender of the person." .

ns1:geo a owl:ObjectProperty ;
    rdfs:label "geographic coordinates" ;
    onto:order 41 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes ns1:GeoCoordinates ;
    skos:definition "Geographic coordinates, eg of a geo-located address." ;
    skos:scopeNote "If data is integrated from several providers, we may end up with multiple coordinate pairs in that node, which will need to be resolved into one." .

ns1:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    ns1:domainIncludes ns1:Organization,
        <http://www.w3.org/ns/person#Person> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "An identifier for a resource." ;
    skos:scopeNote "Used to represent the identifier (e.g. URL) of a Person or Organization." .

ns1:inLanguage a owl:DatatypeProperty ;
    rdfs:label "language" ;
    onto:order 68 ;
    skos:definition "Language of the web resource" ;
    skos:scopeNote "Use a valid [iana:] language code from the IETF BCP 47 standard" .

ns1:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    onto:order 42 ;
    ns1:domainIncludes ns1:GeoCoordinates ;
    ns1:rangeIncludes xsd:decimal ;
    skos:scopeNote "Coordinates must be expressed in the WGS 84 system.",
        "If no coordinates are available, do not make a schema:GeoCoordinates node." .

ns1:license a owl:ObjectProperty ;
    rdfs:label "license" ;
    onto:order 51 ;
    ns1:domainIncludes onto:IdentifierSystem,
        void:Dataset ;
    ns1:rangeIncludes rdf:Resource ;
    skos:definition "License that applies to an identifier system or dataset" ;
    skos:scopeNote "If possible, use established license URLs, e.g. from https://creativecommons.org/ or http://rightsstatements.org/" .

ns1:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    onto:order 43 ;
    ns1:domainIncludes ns1:GeoCoordinates ;
    ns1:rangeIncludes xsd:decimal ;
    skos:scopeNote "Coordinates must be expressed in the WGS 84 system.",
        "If no coordinates are available, do not make a schema:GeoCoordinates node." .

ns1:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    onto:order 66 ;
    ns1:domainIncludes onto:IdentifierSystem,
        onto:IdentifierWebResource,
        onto:WebResource ;
    ns1:rangeIncludes rdf:langString,
        xsd:string ;
    skos:definition "Name or short (generic) description of the resource" ;
    skos:example "Company data",
        "Download",
        "Homepage",
        "Search" ;
    skos:scopeNote "Provide this since it's useful to the user. Can provide it in several languages, in which case the language tag should be specified" .

ns1:nationality a owl:DatatypeProperty ;
    rdfs:label "person nationality" ;
    ns1:domainIncludes <http://www.w3.org/ns/person#Person> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "The nationality of the person." .

ns1:publisher a owl:DatatypeProperty ;
    rdfs:label "identifier system publisher" ;
    onto:order 47 ;
    ns1:domainIncludes onto:IdentifierSystem ;
    ns1:rangeIncludes ns1:Organization,
        ns1:Person ;
    skos:definition "Agent that publishes an identifier database (register) in some form (i.e., printed form, online)" ;
    skos:example "Companies House and BRC publish the UK and NO registers openly.",
        "DUNS numbers are not openly published.",
        "GLEIF publishes the GLEI openly, with a full dump that is updated regularly, which has spurned re-publishers such as http://openleis.com/ and http://glei.info." ;
    skos:scopeNote "Different functions and distributions can be considered (e.g. search or other query, per-company web resources, full download). Often but not always the issuer is also the publisher." .

ns1:sameAs a owl:ObjectProperty ;
    rdfs:label "wikipedia page" ;
    onto:order 19 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:Resource ;
    skos:definition "Wikipedia page pertaining to the company." ;
    skos:example <https://it.wikipedia.org/wiki/Trento> .

ns1:url a owl:ObjectProperty ;
    rdfs:label "website" ;
    onto:order 18 ;
    ns1:domainIncludes onto:WebResource,
        <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:Resource ;
    skos:definition "Website pertaining to the company or URL of a web resource" ;
    skos:example <http://www.comune.trento.it>,
        "For system BE Banque-Carrefour des Entreprises, <https://kbopub.economie.fgov.be/kbopub/zoeknummerform.html> with MIME type \"application/x-search\" is the search URL",
        "For system BG TR, <http://opendata.government.bg/dataset/tbprobckn-pernctbp> with language \"bg\" and MIME type \"application/xml\" is open data download in XML",
        "For system BG TR, <https://brra.bg> with language \"bg\" and MIME type \"text/html\" is the homepage" .

skos:altLabel a owl:DatatypeProperty ;
    rdfs:label "alt label (trade name)" ;
    onto:order 2 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:langString,
        xsd:string ;
    skos:definition "Informal/popular name of the company (also called Trading As) [ebg:]. Sometimes (e.g., when the legal name is very long) people refer to a company using a different, informal version [ebg:]. Some jurisdictions recognize concepts such as a trading name or alternative forms of a legal entity's name [rov:]." ;
    skos:example "OpenCorporates"@en ;
    skos:scopeNote "Do not emit such name if it's equal to the legal name [ebg:]. ",
        "Do not use this property to record translations of the primary legal name [rov:].",
        "Don't allow leading, trailing and two consecutive spaces.",
        "Provide a valid language tag if possible (see [iana:] for a list)." .

skos:notation a owl:DatatypeProperty ;
    rdfs:label "notation (identifier value)" ;
    onto:order 49 ;
    ns1:domainIncludes onto:IdentifierSystem,
        <http://www.w3.org/ns/adms#Identifier> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "Literal value of the identifier." ;
    skos:scopeNote "Codes for Identifier Systems are issued locally by euBusinessGraph.\\nFor identifier systems published by the sole or preferred official register in a jurisdiction, we use the jurisdiction code (e.g. \"BG\", \"GB\"). \\nFor others, if the identifier system has no explicit name, we use a short mnemonic code of the publisher:\\n- upper-case for company registers (e.g. \"OCORP\", \"SDATI\", \"RAL\", \"EU\", \"BRIS\"),\\n- mixed-case for social network registers (e.g. \"Twitter\", \"Facebook\").",
        "Should not include leading, trailing and consecutive spaces, to facilitate exact match.",
        "adms:Identifier recommends that this value should be \"datatyped with the identifier scheme (including the version number if appropriate)\". However, we decided not to do this because:\\n- One cannot search by exact literal value unless one also knows the datatype URL\\n- Currently we do not plan to maintain different identifier system versions" .

skos:prefLabel a owl:DatatypeProperty ;
    rdfs:label "preferred name" ;
    onto:order 1 ;
    ns1:domainIncludes onto:IdentifierSystem,
        <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:langString,
        xsd:string ;
    skos:definition "A single preferred name of a company or identifier system (preferably English)." ;
    skos:scopeNote "Used as a display name of the company or identifier system. For companies we usually pick one of the Registered Names (English if present, else at random). For identifier systems, we use a commonly used English name." .

time:hasBeginning a owl:ObjectProperty ;
    rdfs:label "start time" ;
    ns1:domainIncludes org:Interval ;
    ns1:rangeIncludes time:Instance ;
    skos:definition "Beginning of the membership relation" .

time:hasEnd a owl:ObjectProperty ;
    rdfs:label "end time" ;
    ns1:domainIncludes org:Interval ;
    ns1:rangeIncludes time:Instance ;
    skos:definition "End of the membership relation" .

time:inXSDDate a owl:DatatypeProperty ;
    rdfs:label "date" ;
    ns1:domainIncludes <http://www.w3.org/ns/person#Person> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "Position of an instant, expressed using xsd:date." .

<http://www.w3.org/ns/adms#identifier> a owl:ObjectProperty ;
    rdfs:label "identifier" ;
    onto:order 26 ;
    ns1:domainIncludes onto:IdentifierSystem,
        <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes <http://www.w3.org/ns/adms#Identifier> ;
    skos:definition "An identifier of a Company (the official identifier is rov:registration) or Identifier System / Register" ;
    skos:example "Direct: EU VAT number (in those jurisdictions where it is used as the primary company identifier), BRIS id, OCORP id.",
        "Indirect: BG GUID 617f4edf8c154f4296efdf146513de21, which corresponds to official id 204060254 and can be used to reach the official register page for that company",
        "Indirect: GLEI LEI, SDATI Atoka ID.",
        "Multiple: bank license, insurance license, license to trade dual-use goods (arms), Twitter account, Facebook account." ;
    skos:scopeNote "For Identifier Systems, we use codes issued by euBusinessGraph.\\nFor official Identifier Systems (country registers), we use the jurisdiction code (e.g. 'BG', 'GB').\\nFor other identifier systems, we use a short mnemonic code:\\n- upper-case for company registers (e.g. 'OCORP', 'SDATI', 'RAL', 'EU', 'BRIS'),\\n- mixed-case for social network registers (eg 'Twitter', 'Facebook').\\nThis code is used as the last URL part for identifiers issued in that system.",
        "This includes, but is not limited to:\\n- Direct: Identifier in some aggregated dataset, where the official ID is part of the aggregation ID.\\n- Indirect: Identifier in some aggregated dataset or for a website, where the aggregation ID bears no resemblance to the official ID\\n- Multiple: Identifier that has a many-to-many relation with the company, i.e., a company may have several identifiers of the same kind, and the same identifier can be used by several companies." .

<http://www.w3.org/ns/locn#addressArea> a owl:DatatypeProperty ;
    rdfs:label "address area (neighbourhood/quarter)" ;
    onto:order 36 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes rdf:langString,
        xsd:string ;
    skos:definition "Part of a city, village or neighborhood." ;
    skos:scopeNote "Not likely to appear, but we have Coordinate resolution corresponding to this field." .

<http://www.w3.org/ns/locn#adminUnitL1> a owl:ObjectProperty ;
    rdfs:label "admin unit level 1" ;
    onto:order 29 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes <http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion> ;
    skos:definition "Country of the address" ;
    skos:example "nuts:IT (Italy)." .

<http://www.w3.org/ns/locn#adminUnitL2> a owl:ObjectProperty ;
    rdfs:label "admin unit level 2" ;
    onto:order 30 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes <http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion> ;
    skos:definition "NUTS1 (Macroregion) of the address." ;
    skos:example "nuts:ITC NORD-OVEST (Nord-est)." .

<http://www.w3.org/ns/locn#fullAddress> a owl:DatatypeProperty ;
    rdfs:label "full address" ;
    onto:order 28 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes rdf:langString,
        xsd:string ;
    skos:definition "Full address, free text." ;
    skos:example "Aston House, Cornwall Avenue, London N3 1LF, UK",
        "Via Belenzani 19, 38122, Trento" .

<http://www.w3.org/ns/locn#locatorDesignator> a owl:DatatypeProperty ;
    rdfs:label "locator designator (street number)" ;
    onto:order 38 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "Street number and/or building name." ;
    skos:example "47A",
        "Polygraphia Office Center, floor 4" ;
    skos:scopeNote "Not likely to appear separately, but we have Coordinate resolution corresponding to this field." .

<http://www.w3.org/ns/locn#poBox> a owl:DatatypeProperty ;
    rdfs:label "post office box" ;
    onto:order 40 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "Some addresses are associated with a PO box instead of a street address." .

<http://www.w3.org/ns/locn#postCode> a owl:DatatypeProperty ;
    rdfs:label "post code" ;
    onto:order 39 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "Postal code of the address." ;
    skos:scopeNote "If possible, a European postal code should correspond to the fixed values given in NUTS Downloads, so we can correlate it to a NUTS region." .

<http://www.w3.org/ns/locn#postName> a owl:DatatypeProperty ;
    rdfs:label "post name (locality/city/settlement)" ;
    onto:order 35 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes rdf:langString,
        xsd:string ;
    skos:definition "Locality/City/Settlement of the address, free text." ;
    skos:scopeNote "Provide a language tag if possible. If both ebg:adminUnitL6 and locn:postName are specified, they should correspond to each other." .

<http://www.w3.org/ns/locn#thoroughfare> a owl:DatatypeProperty ;
    rdfs:label "thoroughfare (street address)" ;
    onto:order 37 ;
    ns1:domainIncludes <http://www.w3.org/ns/locn#Address> ;
    ns1:rangeIncludes rdf:langString,
        xsd:string ;
    skos:definition "Street name and optionally number." ;
    skos:example "Polygraphia Office Center, floor 4\\n47A Tsarigradsko Shosse",
        "Via Belenzani 19" ;
    skos:scopeNote "It is ok if the street number is also here, because many systems do not enter the number separately. There may be several concatenated lines, separated with newlines." .

org:hasRegisteredSite a owl:ObjectProperty ;
    rdfs:label "registered site/address" ;
    onto:order 23 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes <http://www.w3.org/ns/locn#Address> ;
    skos:definition "Public legal address where legal papers can be served." ;
    skos:scopeNote "org:hasRegisteredSite leads to a node with types org:Site and locn:Address that has self-link org:siteAddress." .

org:hasSite a owl:ObjectProperty ;
    rdfs:label "site/address" ;
    onto:order 24 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes org:Site ;
    skos:definition "Other address/location associated to an organisation." ;
    skos:scopeNote "org:hasSite leads to a node with types org:Site & locn:Address that has self-link org:siteAddress. org:hasRegisteredSite is declared a sub-property of org:hasSite, so querying by org:hasSite will obtain all addresses." .

org:member a owl:ObjectProperty ;
    rdfs:label "member" ;
    onto:order 104 ;
    ns1:domainIncludes org:Membership ;
    ns1:rangeIncludes <http://www.w3.org/ns/person#Person> ;
    skos:definition "The officer that the membership is about" .

org:memberDuring a owl:ObjectProperty ;
    rdfs:label "duration" ;
    onto:order 105 ;
    ns1:domainIncludes org:Membership ;
    ns1:rangeIncludes time:Interval ;
    skos:definition "Interval (beginning and end) of the membership relation. May be an open interval." ;
    skos:scopeNote "for the common case of missing time, we prefer to use xsd:date rather than completing it with a fake null time, eg \"<date>T00:00:00Z\"^^xsd:dateTime." .

org:organization a owl:ObjectProperty ;
    rdfs:label "company" ;
    onto:order 103 ;
    ns1:domainIncludes org:Membership ;
    ns1:rangeIncludes org:Organization ;
    skos:definition "Points to the company the membership is about" .

org:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    onto:order 106 ;
    ns1:domainIncludes org:Membership ;
    ns1:rangeIncludes org:Role ;
    skos:definition "The role played by the officer in the membership" .

org:siteAddress a owl:ObjectProperty ;
    rdfs:label "site's address" ;
    onto:order 27 ;
    ns1:domainIncludes org:Site ;
    ns1:rangeIncludes <http://www.w3.org/ns/locn#Address> ;
    skos:scopeNote "EBG doesn't need the distinction between org:Site and locn:Address, so we use one node having both types, and a self-link org:siteAddress" .

<http://www.w3.org/ns/person#birthName> a owl:DatatypeProperty ;
    rdfs:label "birth name" ;
    onto:order 102 ;
    ns1:domainIncludes <http://www.w3.org/ns/person#Person> ;
    ns1:rangeIncludes xsd:string ;
    skos:definition "The legal name of the person which is usually determined at or around birth, usually persistent and for this reason usually recorded by some official registers. Although birth names tend to be persistent we do not assume this has to be the case." ;
    skos:example "Michele Barbera" .

<http://www.w3.org/ns/regorg#legalName> a owl:DatatypeProperty ;
    rdfs:label "legal name" ;
    onto:order 0 ;
    ns1:domainIncludes ns1:Organization,
        <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes rdf:langString ;
    skos:definition "The legal name of the business, i.e. official name of the company [ebg:]" ;
    skos:example "CHRINON LTD",
        "Ontotext"@en ;
    skos:scopeNote "A business may have more than one legal name, particularly in jurisdictions with more than one official language (e.g. Belgium). Some registries also treat a transliterated name as official [ebg:]",
        "Don't allow leading, trailing and two consecutive spaces.",
        "Provide a legal language tag (see [iana:] for a list) if possible." .

<http://www.w3.org/ns/regorg#orgActivity> a owl:ObjectProperty ;
    rdfs:label "economic activity" ;
    onto:order 10 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes skos:Concept ;
    skos:definition "Economic activity of the organization (NACE code)" ;
    skos:scopeNote "More detailed national classifications could also useful (e.g. IT ATECO, UK SIC, BG NKID) but are not supported for now. Providers should drop eventual NACE National Extensions trailing digits.",
        "Only the most specific classification code(s) should be provided since we have a skos:broader hierarchy.",
        "Recorded using a controlled vocabulary: EC NACE 2. Values should be like nace:A, nace:42.50, etc",
        "Values are taken from the euBusinessGraph NACE ConceptScheme. URL template: nace:([A-Z]|[0-9]{2}|[0-9]{2}\\\\.[0-9]{1,2}). Providers must use exact codes of the specified form" .

<http://www.w3.org/ns/regorg#orgStatus> a owl:ObjectProperty ;
    rdfs:label "status" ;
    onto:order 8 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    skos:definition "Flag that identifies whether a company is active or not [ebg:]. The operational and/or legal registration status of the entity [lei:]." ;
    skos:example "'Actively trading' vs 'Dormant' vs 'Unregistered' could be considered the 3 main divisions of Status.",
        "'Normal Activity': does appear to have cross-border usefulness and this should be used in preference to terms like 'trading' or 'operating' [rov:].",
        "'insolvent', 'bankrupt', 'in receivership': likely to mean slightly different things with different legal implications in different jurisdictions [rov:]." ;
    skos:scopeNote "A Best Practice for recording status levels is to use the relevant jurisdiction's terms and to encode these in a SKOS Concept Scheme [rov:].",
        "There is no globally accepted list of company states. For Inactive, some look at hard evidence (the company has been deregistered), others at a long period of inactivity (dormant). Because of this, a user cannot assume that Active and Inactive are opposites." .

<http://www.w3.org/ns/regorg#orgType> a owl:ObjectProperty ;
    rdfs:label "type" ;
    onto:order 3 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    skos:definition "Company Type (Legal Form of the entity)" ;
    skos:scopeNote "In addition or alternatively to this field, ebg:orgTypeText may be used.",
        "The types may form a hierarchy, but each company can have maximum one value. E.g. for Italy: Società Di Capitale > Società a responsabilità limitata [ebg:]",
        "There is no agreed set of company types that crosses borders [rov:]. Each jurisdiction will have a limited set of recognized company types and these should be expressed in a consistent manner in a SKOS Concept Scheme [rov:]. Code lists of euBusinessGraph data providers were collected and published in the project repository." .

<http://www.w3.org/ns/regorg#registration> a owl:ObjectProperty ;
    rdfs:label "official registration" ;
    onto:order 25 ;
    ns1:domainIncludes <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    ns1:rangeIncludes <http://www.w3.org/ns/adms#Identifier> ;
    skos:definition "Identifier that holds the official company registration in its jurisdiction of registration. It establishes the legal existence of the company." ;
    skos:scopeNote "In some cases we may not have info about the official registration, though \"it is questionable whether a description of a registered organization without this property and an associated Identifier class will be of any value\" [rov:]",
        "This is a sub-property of adms:identifier, and should be an adms:Identifier pointing to an official ebg:IdentifierSystem. So it holds redundant information, but this is done for compatibility with the Registered Organization vocabulary." .

xsd:gYear a rdfs:Datatype ;
    rdfs:label "Year" .

xsd:gYearMonth a rdfs:Datatype ;
    rdfs:label "Year-Month" .

<http://data.businessgraph.io/dataset/> a skos:ConceptScheme ;
    rdfs:label "Dataset type" ;
    dcterms:creator <http://businessgraph.io> ;
    dcterms:publisher <http://businessgraph.io> ;
    rdfs:comment "Company dataset type: freely avaialable, paid (advertised only), partition" ;
    rdfs:isDefinedBy onto: .

xsd:date a rdfs:Datatype ;
    rdfs:label "Date" .

rdf:langString a rdfs:Datatype ;
    rdfs:label "Language-Tagged String" .

xsd:string a rdfs:Datatype ;
    rdfs:label "String" .

onto: a owl:Ontology ;
    dcterms:contributor [ foaf:homepage <http://eubusinessgraph.eu/partners/> ;
            foaf:name "The euBusinessGraph Consortium" ] ;
    dcterms:created "2017-07-11"^^xsd:date ;
    dcterms:creator [ foaf:name "Tatiana Tarasova" ],
        [ foaf:mbox <mailto:BjornMarius.vonZernichow@sintef.no> ;
            foaf:name "Bjørn Marius von Zernichow" ],
        [ foaf:mbox <mailto:dumitru.roman@sintef.no> ;
            foaf:name "Dumitru Roman" ],
        [ foaf:mbox <mailto:brian.elvesater@sintef.no> ;
            foaf:name "Brian Elvesæter" ],
        [ foaf:name "Fredrik Seehusen" ],
        [ foaf:mbox <mailto:chris.taggart@opencorporates.com> ;
            foaf:name "Chris Taggart" ],
        [ foaf:mbox <mailto:boyan.simeonov@ontotext.com> ;
            foaf:name "Boyan Simeonov" ],
        [ foaf:mbox <mailto:ahmet.soylu@sintef.no> ;
            foaf:name "Ahmet Soylu" ],
        [ foaf:mbox <mailto:paniagua@spaziodati.eu> ;
            foaf:name "Javier Paniagua" ],
        [ foaf:mbox <mailto:vladimir.alexiev@ontotext.com> ;
            foaf:name "Vladimir Alexiev" ],
        [ foaf:mbox <mailto:david.norheim@brreg.no> ;
            foaf:name "David Norheim" ] ;
    dcterms:license <https://opendatacommons.org/licenses/by/> ;
    dcterms:modified "2020-02-11"^^xsd:date ;
    dcterms:publisher [ foaf:homepage <http://eubusinessgraph.eu> ;
            foaf:name "The euBusinessGraph Project" ] ;
    dcterms:status <http://purl.org/adms/status/UnderDevelopment> ;
    dcterms:title "euBusinessGraph ontology" ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:preferredNamespacePrefix "ebg" ;
    vann:preferredNamespaceUri "http://data.businessgraph.io/ontology#" ;
    rdfs:comment "The euBusinessGraph (`ebg:`) ontology represents companies, type/status/economic classification, addresses, identifiers, company officers (e.g., directors and CEOs), and dataset offerings.\\n\\nIt uses `schema:domainIncludes/rangeIncludes` (which are polymorphic) to describe which properties are applicable to a class, \\nrather than `rdfs:domain/range` (which are monomorphic) to prescribe what classes must be applied to each node using a property.\\nWe find that this enables more flexible reuse and combination of different ontologies.\\nWe reuse the following ontologies and nomenclatures, and extend them where appropriate with classes and properties:\\n\\n- W3C Org, W3C RegOrg (basic company data), \\n\\n- W3C Time (officer membership), \\n\\n- W3C Locn (addresses),\\n\\n- schema.org (domain/rangeIncludes and various properties)\\n\\n- DBpedia ontology (jurisdiction)\\n\\n- NGEO and Spatial (NUTS administrative divisions)\\n\\n- ADMS (identifiers), \\n\\n- FOAF, SIOC (blog posts),\\n\\n- RAMON, SKOS (NACE economic classifications and various nomenclatures),\\n\\n- VOID (dataset descriptions).\\n\\nThis is only a reference. See more detail in the [EBG Semantic Model](https://docs.google.com/document/d/1dhMOTlIOC6dOK_jksJRX0CB-GIRoiYY6fWtCnZArUhU/edit) google document, which includes an informative description of classes and properties, gives examples and data provider rules, and provides more schema and instance diagrams.\\n\\n## Overview\\nThe figure below gives an overview of the ontology, depicting the main classes and their relationships (i.e., object properties). The ontology covers the following areas:\\n\\n- Registered Organization: To represent a legal company.\\n\\n- Identifier System: To represent Identifier Systems. A company can have several Identifiers belonging to different Identifier Systems.\\n\\n- Officer: To represent associated company officers, e.g., directors.\\n\\n- Dataset: To represent information about datasets that are offered by company data providers.\\n\\n![](https://raw.githubusercontent.com/euBusinessGraph/eubg-data/master/model/images/ontology-overview.png)\\n\\n### Registered Organization (company)\\nRegistered organizations are the main entities for which information is captured in the euBusinessGraph ontology. The ontology is not concerned with unregistered informal groups. Registered organizations gain legal entity status by the act of registration and are distinct from the broader concept of organizations, groups or, in some jurisdictions, sole traders. The figure below shows the classes and properties for representing core data about a registered organization.\\n\\n![](https://raw.githubusercontent.com/euBusinessGraph/eubg-data/master/model/images/ontology-company-classes.png)\\n\\n### Identifier System\\nMechanisms to identify companies in various data sources are essential in integration of data about companies across data sources. A proper understanding of what kind of systems of identifiers can be used for companies is thus necessary in this context. We analyzed various types of identifiers commonly used for companies and collected various properties of the systems they are part of. We modelled identifiers and identifier systems explicitly in the ontology as shown in thew figure below.\\n\\n![](https://raw.githubusercontent.com/euBusinessGraph/eubg-data/master/model/images/ontology-identifier-classes.png)\\n\\n### Officer\\nWe use the membership model of the W3C Organization Ontology in a straightforward way to represent officer data as shown in the figure below.\\n\\n![](https://raw.githubusercontent.com/euBusinessGraph/eubg-data/master/model/images/ontology-officer-classes.png)\\n\\n### Dataset Descriptions\\nData consumers need to know how many companies are included in a data provider dataset, from which jurisdictions, and what depth of data is included (e.g., which properties, addresses with what geo resolution, etc.). We thus need to express both metadata about the dataset itself, and fine-grained statistics about the content of a dataset, as shown in the figure below.\\n\\n![](https://raw.githubusercontent.com/euBusinessGraph/eubg-data/master/model/images/ontology-dataset-classes.png)\\n\\n" ;
    rdfs:seeAlso <https://docs.google.com/document/d/1dhMOTlIOC6dOK_jksJRX0CB-GIRoiYY6fWtCnZArUhU/edit> ;
    owl:versionInfo "1.4.1" ;
    prov:wasGeneratedBy [ a doap:Project,
                prov:Activity ;
            doap:repository <https://github.com/euBusinessGraph/eubg-data> ] ;
    foaf:homepage <http://businessgraph.io> .

