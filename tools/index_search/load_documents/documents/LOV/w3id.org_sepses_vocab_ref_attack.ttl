@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix onto: <http://w3id.org/sepses/vocab/ref/attack> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dc:creator "Kabul Kurniawan" ;
    dc:description "An ontology to represent MITRE ATT & CK.\\nThis ontology is developed based on the MITRE ATT & CK  (https://attack.mitre.org/)"@en ;
    dc:rights "http://creativecommons.org/licenses/by/4.0/" ;
    dc:title "MITRE ATT&CK Ontology" ;
    vann:preferredNamespacePrefix "attack" ;
    owl:versionIRI <https://w3id.org/sepses/vocab/ref/attack/2.0.0> .

<http://w3id.org/sepses/vocab/ref/attack#Campaign> a owl:Class ;
    rdfs:label "Campaign" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#DataComponent> a owl:Class ;
    rdfs:label "DataComponent" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#DataSource> a owl:Class ;
    rdfs:label "DataSource" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#SubTechnique> a owl:Class ;
    rdfs:label "SubTechnique" ;
    rdfs:subClassOf <http://w3id.org/sepses/vocab/ref/attack#Technique>,
        owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#accomplishesTactic> a owl:ObjectProperty ;
    rdfs:label "accomplishesTactic" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Tactic> .

<http://w3id.org/sepses/vocab/ref/attack#aliases> a owl:DatatypeProperty ;
    rdfs:label "aliases" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#AdversaryGroup> ;
    rdfs:range xsd:string .

<http://w3id.org/sepses/vocab/ref/attack#associatedGroup> a owl:ObjectProperty ;
    rdfs:label "associatedGroup" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#AdversaryGroup> .

<http://w3id.org/sepses/vocab/ref/attack#dataSource> a owl:DatatypeProperty ;
    rdfs:label "dataSource" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range xsd:string .

<http://w3id.org/sepses/vocab/ref/attack#detection> a owl:DatatypeProperty ;
    rdfs:label "detection" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range xsd:string .

<http://w3id.org/sepses/vocab/ref/attack#hasAdversaryGroup> a owl:ObjectProperty ;
    rdfs:label "hasAdversaryGroup" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Malware> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#AdversaryGroup> .

<http://w3id.org/sepses/vocab/ref/attack#hasCAPEC> a owl:ObjectProperty ;
    rdfs:label "hasCAPEC" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/capec#CAPEC> .

<http://w3id.org/sepses/vocab/ref/attack#hasMitigation> a owl:ObjectProperty ;
    rdfs:label "hasMitigation" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Mitigation> .

<http://w3id.org/sepses/vocab/ref/attack#hasReference> a owl:ObjectProperty ;
    rdfs:label "hasReference" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Reference> .

<http://w3id.org/sepses/vocab/ref/attack#hasSoftware> a owl:ObjectProperty ;
    rdfs:label "hasSoftware" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Software> .

<http://w3id.org/sepses/vocab/ref/attack#hasTechnique> a owl:ObjectProperty ;
    rdfs:label "hasTechnique" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Tactic> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Technique> .

<http://w3id.org/sepses/vocab/ref/attack#implementsTechnique> a owl:ObjectProperty ;
    rdfs:label "implementsTechnique" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Malware> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Technique> .

<http://w3id.org/sepses/vocab/ref/attack#isSubTechniqueOf> a owl:ObjectProperty ;
    rdfs:label "isSubTechniqueOf" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Technique> .

<http://w3id.org/sepses/vocab/ref/attack#isSubtechnique> a owl:DatatypeProperty ;
    rdfs:label "isSubtechnique" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range xsd:boolean .

<http://w3id.org/sepses/vocab/ref/attack#permissionRequired> a owl:DatatypeProperty ;
    rdfs:label "permissionRequired" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range xsd:string .

<http://w3id.org/sepses/vocab/ref/attack#platform> a owl:DatatypeProperty ;
    rdfs:label "platform" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range xsd:string .

<http://w3id.org/sepses/vocab/ref/attack#preventsTechnique> a owl:ObjectProperty ;
    rdfs:label "preventsTechnique" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Mitigation> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Technique> .

<http://w3id.org/sepses/vocab/ref/attack#referenceDescription> a owl:DatatypeProperty ;
    rdfs:label "referenceDescription" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Reference> ;
    rdfs:range xsd:string .

<http://w3id.org/sepses/vocab/ref/attack#referenceId> a owl:DatatypeProperty ;
    rdfs:label "referenceId" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Reference> ;
    rdfs:range xsd:string .

<http://w3id.org/sepses/vocab/ref/attack#referenceName> a owl:DatatypeProperty ;
    rdfs:label "referenceName" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Reference> ;
    rdfs:range xsd:string .

<http://w3id.org/sepses/vocab/ref/attack#referenceUrl> a owl:DatatypeProperty ;
    rdfs:label "referenceUrl" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Reference> ;
    rdfs:range xsd:string .

<http://w3id.org/sepses/vocab/ref/attack#targetsAsset> a owl:ObjectProperty ;
    rdfs:label "targetsAsset" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#Technique> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Asset> .

<http://w3id.org/sepses/vocab/ref/attack#usesMalware> a owl:ObjectProperty ;
    rdfs:label "usesMalware" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#AdversaryGroup> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Malware> .

<http://w3id.org/sepses/vocab/ref/attack#usesSoftware> a owl:ObjectProperty ;
    rdfs:label "usesSoftware" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#AdversaryGroup> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Software> .

<http://w3id.org/sepses/vocab/ref/attack#usesTechnique> a owl:ObjectProperty ;
    rdfs:label "usesTechnique" ;
    rdfs:domain <http://w3id.org/sepses/vocab/ref/attack#AdversaryGroup> ;
    rdfs:range <http://w3id.org/sepses/vocab/ref/attack#Technique> .

<http://w3id.org/sepses/vocab/ref/attack#Asset> a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/sepses/vocab/ref/capec#CAPEC> a owl:Class .

<http://w3id.org/sepses/vocab/ref/attack#Mitigation> a owl:Class ;
    rdfs:label "Mitigation" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#Tactic> a owl:Class ;
    rdfs:label "Tactic" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#Malware> a owl:Class ;
    rdfs:label "Malware" ;
    rdfs:subClassOf <http://w3id.org/sepses/vocab/ref/attack#Software>,
        owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#Software> a owl:Class ;
    rdfs:label "Software" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#Reference> a owl:Class ;
    rdfs:label "Reference" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#AdversaryGroup> a owl:Class ;
    rdfs:label "AdversaryGroup" ;
    rdfs:subClassOf owl:Thing .

<http://w3id.org/sepses/vocab/ref/attack#Technique> a owl:Class ;
    rdfs:label "Technique" ;
    rdfs:subClassOf owl:Thing .

