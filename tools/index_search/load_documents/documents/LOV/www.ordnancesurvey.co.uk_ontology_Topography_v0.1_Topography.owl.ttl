@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#> .
@prefix onto: <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

ns1:Definition a owl:AnnotationProperty .

ns1:Purpose a owl:AnnotationProperty .

ns1:Rabbit a owl:AnnotationProperty .

ns1:Scope a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dc:creator "Glen Hart and Cathy Dolbear" ;
    dc:date "24/02/2008" ;
    dc:publisher "Ordnance Survey" ;
    dc:rights "Crown Copyright 2008" ;
    dc:title "Topography Ontology" ;
    ns1:Purpose "The general purpose of a this ontology is to provide a library of high level concepts that are used by the other modules within the whole OS Topographic ontology.  The ontology also describes the relationships  and instances common to more than one module." ;
    ns1:Scope "General high level classifications of topographic features surveyed by Ordnance Survey." ;
    rdfs:comment "This ontology is still under construction" ;
    owl:imports <http://www.ordnancesurvey.co.uk/ontology/MereologicalRelations/v0.2/MereologicalRelations.owl>,
        <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl> ;
    owl:versionInfo "V0.1" .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#EconomicActivity> a owl:Class ;
    rdfs:comment "Secondary concept" ;
    rdfs:subClassOf <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Purpose> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Holding> a owl:Class ;
    rdfs:label "\"Holding\"" ;
    rdfs:subClassOf <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Purpose> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Industry> a owl:Class ;
    rdfs:label "Industry" ;
    ns1:Rabbit "Secondary concept" ;
    rdfs:subClassOf owl:Thing .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Storage> a owl:Class ;
    rdfs:label "Secondary concept",
        "Storage" ;
    rdfs:subClassOf <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Purpose> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Structure> a owl:Class ;
    rdfs:label "Structure" ;
    rdfs:subClassOf <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#TopographicObject> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Transport> a owl:Class ;
    rdfs:label "\"Transport\"" ;
    ns1:Rabbit "Secondary concept" ;
    rdfs:subClassOf <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Purpose> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#contains> a owl:ObjectProperty ;
    rdfs:label "contains" ;
    ns1:Rabbit "The relationship \"contains\" is the complement of \"is contained in\"." ;
    owl:inverseOf <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#isContainedIn> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#earths_surface> a <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Surface> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#hasFootprint> a owl:ObjectProperty ;
    rdfs:label "has footprint" ;
    ns1:Definition "Occupies a physical area of the terrain's surface." ;
    rdfs:range <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Footprint> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#hasName> a owl:ObjectProperty ;
    rdfs:label "has name" ;
    ns1:Definition "Possesses a name." .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#hasPurpose> a owl:ObjectProperty ;
    rdfs:label "has purpose" ;
    ns1:Rabbit "The relationship \"has purpose is\" a special type of the relationship \"enables\"." ;
    rdfs:subPropertyOf <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#enables> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#scotland> a <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#UK_Country> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#somerset> a <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#English_County> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#united_kingdom> owl:sameAs <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#uk> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#wales> a <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#UK_Country> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#English_County> a owl:Class ;
    rdfs:label "English County" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#england> ;
            owl:onProperty <http://www.ordnancesurvey.co.uk/ontology/MereologicalRelations/v0.2/MereologicalRelations.owl#isPartOf> ],
        <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Traditional_County> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Footprint> a owl:Class ;
    rdfs:label "Footprint" ;
    rdfs:subClassOf owl:Thing .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Surface> a owl:Class ;
    rdfs:label "Surface" ;
    ns1:Rabbit "Surface is a secondary concept." ;
    rdfs:subClassOf owl:Thing .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#TopographicObject> a owl:Class ;
    rdfs:label "Topographic Object" .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Traditional_County> a owl:Class ;
    rdfs:label "\"Traditional County\"" ;
    rdfs:subClassOf owl:Thing .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#enables> a owl:ObjectProperty ;
    rdfs:label "enables" ;
    ns1:Definition "allows something to happen but not necessairly by design." .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#england> a <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#UK_Country> .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#isContainedIn> a owl:ObjectProperty ;
    rdfs:label "is contained in" ;
    ns1:Rabbit "The relationship \"is contained in\" is the inverse of \"contains\"." .

<http://www.ordnancesurvey.co.uk/ontology/MereologicalRelations/v0.2/MereologicalRelations.owl#isPartOf> a owl:ObjectProperty .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#UK_Country> a owl:Class ;
    rdfs:label "UK Country" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#uk> ;
            owl:onProperty <http://www.ordnancesurvey.co.uk/ontology/MereologicalRelations/v0.2/MereologicalRelations.owl#isPartOf> ],
        owl:Thing .

<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#Purpose> a owl:Class ;
    rdfs:label "Purpose" ;
    ns1:Rabbit "Purpose is a secondary concept." ;
    rdfs:subClassOf owl:Thing .

owl:Thing a owl:Class .

