@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/vocommons/voaf#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <http://ns.inria.fr/emoca> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://ns.inria.fr/emoca#Anger> a rdfs:Class ;
    rdfs:label "Anger"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Emotion> .

<http://ns.inria.fr/emoca#Arousal> a rdfs:Class ;
    rdfs:label "Arousal"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Component> .

<http://ns.inria.fr/emoca#Component> a rdfs:Class ;
    rdfs:label "Component"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Coordinate> .

<http://ns.inria.fr/emoca#Coordinate> a rdfs:Class,
        owl:Class ;
    rdfs:label "Coordinate"@en .

<http://ns.inria.fr/emoca#Disgust> a rdfs:Class ;
    rdfs:label "Disgust"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Emotion> .

<http://ns.inria.fr/emoca#Emotion> a rdfs:Class,
        owl:Class ;
    rdfs:label "Emotion"@en .

<http://ns.inria.fr/emoca#Fear> a rdfs:Class ;
    rdfs:label "Fear"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Emotion> .

<http://ns.inria.fr/emoca#Impact> a rdfs:Class,
        owl:Class ;
    rdfs:label "Impact"@en .

<http://ns.inria.fr/emoca#Joy> a rdfs:Class ;
    rdfs:label "Joy"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Emotion> .

<http://ns.inria.fr/emoca#Person> a rdfs:Class,
        owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf foaf:Person .

<http://ns.inria.fr/emoca#Radius> a rdfs:Class ;
    rdfs:label "Radius"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Coordinate> .

<http://ns.inria.fr/emoca#Sadness> a rdfs:Class ;
    rdfs:label "Sadness"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Emotion> .

<http://ns.inria.fr/emoca#Stimulus> a rdfs:Class,
        owl:Class ;
    rdfs:label "Stimulus"@en .

<http://ns.inria.fr/emoca#Surprise> a rdfs:Class ;
    rdfs:label "Surprise"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Emotion> .

<http://ns.inria.fr/emoca#Trait> a rdfs:Class,
        owl:Class ;
    rdfs:label "Trait"@en .

<http://ns.inria.fr/emoca#Valence> a rdfs:Class ;
    rdfs:label "Valence"@en ;
    rdfs:subClassOf <http://ns.inria.fr/emoca#Component> .

foaf:Person a rdfs:Class,
        owl:Class .

<http://ns.inria.fr/emoca#hasEffect> a rdf:Property ;
    rdfs:label "has effect"@en ;
    rdfs:domain <http://ns.inria.fr/emoca#Impact> ;
    rdfs:range xsd:double .

<http://ns.inria.fr/emoca#hasImpact> a rdf:Property ;
    rdfs:label "has impact"@en ;
    rdfs:domain <http://ns.inria.fr/emoca#Trait> ;
    rdfs:range <http://ns.inria.fr/emoca#Impact> .

<http://ns.inria.fr/emoca#hasMaximum> a rdf:Property ;
    rdfs:label "has maximum"@en ;
    rdfs:domain <http://ns.inria.fr/emoca#Coordinate> ;
    rdfs:range xsd:double .

<http://ns.inria.fr/emoca#hasMinimum> a rdf:Property ;
    rdfs:label "has minimum"@en ;
    rdfs:domain <http://ns.inria.fr/emoca#Coordinate> ;
    rdfs:range xsd:double .

<http://ns.inria.fr/emoca#hasTrait> a rdf:Property ;
    rdfs:label "has trait"@en ;
    rdfs:domain <http://ns.inria.fr/emoca#Person> ;
    rdfs:range <http://ns.inria.fr/emoca#Trait> .

<http://ns.inria.fr/emoca#involves> a rdf:Property ;
    rdfs:label "involves"@en ;
    rdfs:domain <http://ns.inria.fr/emoca#Stimulus> .

<http://ns.inria.fr/emoca#isDefinedBy> a rdf:Property ;
    rdfs:label "is defined by"@en ;
    rdfs:domain <http://ns.inria.fr/emoca#Emotion> ;
    rdfs:range <http://ns.inria.fr/emoca#Coordinate> .

<http://ns.inria.fr/emoca#pertainsTo> a rdf:Property ;
    rdfs:label "pertains to"@en ;
    rdfs:domain <http://ns.inria.fr/emoca#Impact> ;
    rdfs:range <http://ns.inria.fr/emoca#Component> .

<http://ns.inria.fr/emoca#relatesTo> a rdf:Property ;
    rdfs:label "relates to"@en ;
    rdfs:domain <http://ns.inria.fr/emoca#Trait> .

onto: a ns1:Vocabulary,
        owl:Ontology ;
    ns2:license <http://creativecommons.org/licenses/by/3.0/>,
        <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:contributor [ a foaf:Person ;
            foaf:name "Fabien Gandon" ],
        [ a foaf:Person ;
            foaf:name "Ghislain Atemezing" ],
        [ a foaf:Person ;
            foaf:name "Peter Sander" ] ;
    dcterms:created "2013-08-30" ;
    dcterms:creator [ a foaf:Person ;
            foaf:name "Franck Berthelon" ] ;
    dcterms:description "EmOCA is used to describe and contextualize emotions"@en ;
    dcterms:modified "2013-11-26" ;
    dcterms:publisher <http://dbpedia.org/page/National_Institute_for_Research_in_Computer_Science_and_Control> ;
    dcterms:title "Emotion ontology for context awareness"@en ;
    vann:preferredNamespacePrefix "emotion" ;
    vann:preferredNamespaceUri <http://ns.inria.fr/emoca#> ;
    ns1:classNumber 16 ;
    ns1:propertyNumber 9 ;
    owl:versionInfo "Version 1.0 - 2013-11-26" ;
    foaf:homepage onto: .

