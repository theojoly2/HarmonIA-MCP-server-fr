@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/vocommons/voaf#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <http://rdf.insee.fr/def/geo> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns2:license a rdf:Property ;
    rdfs:label "licence"@fr .

<http://id.insee.fr/codes/geo/typeDEPCI/CA> a <http://rdf.insee.fr/def/geo#TypeDEPCI>,
        skos:Concept ;
    skos:inScheme <http://id.insee.fr/codes/geo/typeDEPCI/liste> ;
    skos:notation "CA" ;
    skos:prefLabel "Communauté d'agglomération"@fr .

<http://id.insee.fr/codes/geo/typeDEPCI/CC> a <http://rdf.insee.fr/def/geo#TypeDEPCI>,
        skos:Concept ;
    skos:inScheme <http://id.insee.fr/codes/geo/typeDEPCI/liste> ;
    skos:notation "CC" ;
    skos:prefLabel "Communauté de communes"@fr .

<http://id.insee.fr/codes/geo/typeDEPCI/CU> a <http://rdf.insee.fr/def/geo#TypeDEPCI>,
        skos:Concept ;
    skos:inScheme <http://id.insee.fr/codes/geo/typeDEPCI/liste> ;
    skos:notation "CU" ;
    skos:prefLabel "Communauté urbaine"@fr .

<http://id.insee.fr/codes/geo/typeDEPCI/SAN> a <http://rdf.insee.fr/def/geo#TypeDEPCI>,
        skos:Concept ;
    skos:inScheme <http://id.insee.fr/codes/geo/typeDEPCI/liste> ;
    skos:notation "SAN" ;
    skos:prefLabel "Syndicat d'agglomération nouvelle"@fr .

<http://id.insee.fr/codes/geo/typeDIRIS/A> a <http://rdf.insee.fr/def/geo#TypeDIRIS>,
        skos:Concept ;
    skos:inScheme <http://id.insee.fr/codes/geo/typeDIRIS/liste> ;
    skos:notation "A" ;
    skos:prefLabel "IRIS d'activité"@fr .

<http://id.insee.fr/codes/geo/typeDIRIS/D> a <http://rdf.insee.fr/def/geo#TypeDIRIS>,
        skos:Concept ;
    skos:inScheme <http://id.insee.fr/codes/geo/typeDIRIS/liste> ;
    skos:notation "D" ;
    skos:prefLabel "IRIS divers"@fr .

<http://id.insee.fr/codes/geo/typeDIRIS/H> a <http://rdf.insee.fr/def/geo#TypeDIRIS>,
        skos:Concept ;
    skos:inScheme <http://id.insee.fr/codes/geo/typeDIRIS/liste> ;
    skos:notation "H" ;
    skos:prefLabel "IRIS d'habitat"@fr .

<http://id.insee.fr/codes/geo/typeDIRIS/Z> a <http://rdf.insee.fr/def/geo#TypeDIRIS>,
        skos:Concept ;
    skos:inScheme <http://id.insee.fr/codes/geo/typeDIRIS/liste> ;
    skos:notation "Z" ;
    skos:prefLabel "Commune non découpée en IRIS"@fr .

dcterms:contributor a rdf:Property ;
    rdfs:label "contributeur"@fr .

dcterms:creator a rdf:Property ;
    rdfs:label "créateur"@fr .

dcterms:publisher a rdf:Property ;
    rdfs:label "éditeur"@fr .

<http://rdf.insee.fr/def/geo#AireUrbaine> a owl:Class ;
    rdfs:label "Aire urbaine"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#GroupementStatistiqueDeCommunes> .

<http://rdf.insee.fr/def/geo#ArrondissementMunicipal> a owl:Class ;
    rdfs:label "Arrondissement municipal"@fr ;
    rdfs:comment "Cette classe n'est utilisée que pour les arrondissements de Paris, Lyon et Marseille"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#TerritoireAdministratif> .

<http://rdf.insee.fr/def/geo#CantonOuVille> a owl:Class ;
    rdfs:label "Canton-ou-ville"@fr ;
    rdfs:comment "Dit aussi 'pseudo-canton', c'est un regroupement d'une ou plusieurs communes entières"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#Commune> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivision> ],
        <http://rdf.insee.fr/def/geo#TerritoireStatistique> .

<http://rdf.insee.fr/def/geo#CollectiviteTerritoriale> a owl:Class ;
    rdfs:label "Collectivité territoriale"@fr ;
    rdfs:comment "Collectivité territoriale d'outre-mer. Inclut les TOM et les territoires à statut particulier."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#TerritoireAdministratif> .

<http://rdf.insee.fr/def/geo#DeplacementDeLimitesDIRIS> a owl:Class ;
    rdfs:label "Déplacement de limites d'IRIS"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#ModificationDIRIS> .

<http://rdf.insee.fr/def/geo#EchangeParcellesCommunesIrisees> a owl:Class ;
    rdfs:label "Échange de parcelles entre communes irisées"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://rdf.insee.fr/def/geo#territoireModifie> ;
            owl:someValuesFrom <http://rdf.insee.fr/def/geo#Commune> ],
        <http://rdf.insee.fr/def/geo#EchangeDeParcelles>,
        <http://rdf.insee.fr/def/geo#ModificationDIRIS> .

<http://rdf.insee.fr/def/geo#EchangeParcellesHabiteesCommunesIriseesNonIrisees> a owl:Class ;
    rdfs:label "Échange de parcelles habitées entre communes irisées et non irisées"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://rdf.insee.fr/def/geo#territoireModifie> ;
            owl:someValuesFrom <http://rdf.insee.fr/def/geo#Commune> ],
        <http://rdf.insee.fr/def/geo#EchangeDeParcelles>,
        <http://rdf.insee.fr/def/geo#ModificationDIRIS> .

<http://rdf.insee.fr/def/geo#EchangeParcellesInhabiteesCommunesIriseesNonIrisees> a owl:Class ;
    rdfs:label "Échange de parcelles inhabitées entre communes irisées et non irisées"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://rdf.insee.fr/def/geo#territoireModifie> ;
            owl:someValuesFrom <http://rdf.insee.fr/def/geo#Commune> ],
        <http://rdf.insee.fr/def/geo#EchangeDeParcelles>,
        <http://rdf.insee.fr/def/geo#ModificationDIRIS> .

<http://rdf.insee.fr/def/geo#FusionDeCommunesIrisees> a owl:Class ;
    rdfs:label "Fusion de communes irisées"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#SuppressionFusion> .

<http://rdf.insee.fr/def/geo#GrandQuartier> a owl:Class ;
    rdfs:label "Grand Quartier"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#IRIS> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivision> ],
        [ a owl:Restriction ;
            owl:onClass <http://rdf.insee.fr/def/geo#Commune> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDe> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://rdf.insee.fr/def/geo#TerritoireStatistique> .

<http://rdf.insee.fr/def/geo#LAU1> a owl:Class ;
    rdfs:label "LAU 1" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#LAU> .

<http://rdf.insee.fr/def/geo#ModificationCantonale> a owl:Class ;
    rdfs:label "Modification cantonale"@fr ;
    rdfs:comment "Modification de la structure d'un ou plusieurs cantons"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://rdf.insee.fr/def/geo#territoireModifie> ;
            owl:someValuesFrom <http://rdf.insee.fr/def/geo#Canton> ],
        <http://rdf.insee.fr/def/geo#ModificationTerritoriale> .

<http://rdf.insee.fr/def/geo#NUTS1> a owl:Class ;
    rdfs:label "NUTS 1" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#NUTS2> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivision> ],
        <http://rdf.insee.fr/def/geo#NUTS> .

<http://rdf.insee.fr/def/geo#RetablissementCommunesIssuesDeCommuneIrisees> a owl:Class ;
    rdfs:label "Rétablissement de communes issues de communes irisées"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://rdf.insee.fr/def/geo#territoireModifie> ;
            owl:someValuesFrom <http://rdf.insee.fr/def/geo#Commune> ],
        <http://rdf.insee.fr/def/geo#CreationOuRetablissement> .

<http://rdf.insee.fr/def/geo#ScissionDIRIS> a owl:Class ;
    rdfs:label "Scission d'IRIS"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#ModificationDIRIS> .

<http://rdf.insee.fr/def/geo#TRIRIS> a owl:Class ;
    rdfs:label "TRIRIS"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://rdf.insee.fr/def/geo#Commune> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDe> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#IRIS> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivision> ],
        <http://rdf.insee.fr/def/geo#TerritoireStatistique> .

<http://rdf.insee.fr/def/geo#UniteUrbaine> a owl:Class ;
    rdfs:label "Unité urbaine"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#GroupementStatistiqueDeCommunes> .

<http://rdf.insee.fr/def/geo#ZoneDEmploi> a owl:Class ;
    rdfs:label "Zone d'emploi"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#GroupementStatistiqueDeCommunes> .

<http://rdf.insee.fr/def/geo#ancienNom> a owl:DatatypeProperty ;
    rdfs:label "ancien nom"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ChangementDeNom> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token .

<http://rdf.insee.fr/def/geo#capitale> a owl:ObjectProperty ;
    rdfs:label "capitale d'un pays ou d'un territoire"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#chefLieu> .

<http://rdf.insee.fr/def/geo#centroide> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "centroïde"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Commune> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#Point> .

<http://rdf.insee.fr/def/geo#chefLieuDeCanton> a owl:ObjectProperty ;
    rdfs:label "chef-lieu de canton"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Canton> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#chefLieu> .

<http://rdf.insee.fr/def/geo#chefLieuDeCommune> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "chef-lieu de commune"@fr ;
    rdfs:comment "Position géographique de la mairie"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Commune> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#Point> .

<http://rdf.insee.fr/def/geo#codeArrondissement> a owl:DatatypeProperty ;
    rdfs:label "code arrondissement"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Arrondissement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#codeINSEE> .

<http://rdf.insee.fr/def/geo#codeCanton> a owl:DatatypeProperty ;
    rdfs:label "code canton"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Canton> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#codeINSEE> .

<http://rdf.insee.fr/def/geo#codeCommune> a owl:DatatypeProperty ;
    rdfs:label "code commune"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Commune> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#codeINSEE> .

<http://rdf.insee.fr/def/geo#codeDepartement> a owl:DatatypeProperty ;
    rdfs:label "code département"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Departement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#codeINSEE> .

<http://rdf.insee.fr/def/geo#codeIRIS> a owl:DatatypeProperty ;
    rdfs:label "code IRIS"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#IRIS> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#codeINSEE> .

<http://rdf.insee.fr/def/geo#codePays> a owl:DatatypeProperty ;
    rdfs:label "code pays"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Pays> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#codeINSEE> .

<http://rdf.insee.fr/def/geo#codeRegion> a owl:DatatypeProperty ;
    rdfs:label "code région"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Region> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#codeINSEE> .

<http://rdf.insee.fr/def/geo#date> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "date"@fr ;
    rdfs:comment "Date de la modification"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ModificationTerritoriale> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dcterms:date .

<http://rdf.insee.fr/def/geo#description> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "description"@fr ;
    rdfs:comment "Description de la modification"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ModificationTerritoriale> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token .

<http://rdf.insee.fr/def/geo#fractionCantonale> a owl:ObjectProperty ;
    rdfs:label "fraction cantonale"@fr ;
    rdfs:comment "Indique une commune dont une fraction seulement est incluse dans le canton"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Canton> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#Commune> .

<http://rdf.insee.fr/def/geo#modificationInduite> a owl:ObjectProperty ;
    rdfs:label "modification induite"@fr ;
    rdfs:comment "La modification objet de cette propriété est provoquée par la modification sujet"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ModificationTerritoriale> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#ModificationTerritoriale> .

<http://rdf.insee.fr/def/geo#nom> a owl:DatatypeProperty ;
    rdfs:label "nom"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token .

<http://rdf.insee.fr/def/geo#nouveauNom> a owl:DatatypeProperty ;
    rdfs:label "nouveau nom"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ChangementDeNom> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token .

<http://rdf.insee.fr/def/geo#paysEntrant> a owl:ObjectProperty ;
    rdfs:label "pays entrant"@fr ;
    rdfs:comment "Pays entrant"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ModificationDeGroupement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#place> .

<http://rdf.insee.fr/def/geo#paysSortant> a owl:ObjectProperty ;
    rdfs:label "pays sortant"@fr ;
    rdfs:comment "Pays sortant"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ModificationDeGroupement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#place> .

<http://rdf.insee.fr/def/geo#prefecture> a owl:ObjectProperty ;
    rdfs:label "préfecture de département"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Departement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#chefLieu> .

<http://rdf.insee.fr/def/geo#prefectureDeRegion> a owl:ObjectProperty ;
    rdfs:label "préfecture de région"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Region> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#chefLieu> .

<http://rdf.insee.fr/def/geo#resultante> a owl:ObjectProperty ;
    rdfs:label "résultante"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#SuppressionFusion> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#place> .

<http://rdf.insee.fr/def/geo#sousPrefecture> a owl:ObjectProperty ;
    rdfs:label "sous-préfecture de département"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Departement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#chefLieu> .

<http://rdf.insee.fr/def/geo#territoireDOrigine> a owl:ObjectProperty ;
    rdfs:label "territoire d'origine"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ChangementDeDepartementOuArrondissement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ owl:unionOf ( <http://rdf.insee.fr/def/geo#Arrondissement> <http://rdf.insee.fr/def/geo#Departement> ) ] ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#territoireModifie> .

<http://rdf.insee.fr/def/geo#territoireDeRattachement> a owl:ObjectProperty ;
    rdfs:label "territoire de rattachement"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ChangementDeDepartementOuArrondissement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ owl:unionOf ( <http://rdf.insee.fr/def/geo#Arrondissement> <http://rdf.insee.fr/def/geo#Departement> ) ] ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#territoireModifie> .

<http://rdf.insee.fr/def/geo#typeDEPCI> a owl:ObjectProperty ;
    rdfs:label "type d'EPCI"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#EPCI> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Restriction ;
            owl:hasValue <http://id.insee.fr/codes/geo/typeDEPCI/liste> ;
            owl:onProperty skos:inScheme ] .

<http://rdf.insee.fr/def/geo#typeDIRIS> a owl:ObjectProperty ;
    rdfs:label "type d'IRIS"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#IRIS> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Restriction ;
            owl:hasValue <http://id.insee.fr/codes/geo/typeDIRIS/liste> ;
            owl:onProperty skos:inScheme ] .

<http://rdf.insee.fr/def/geo#vivant> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "vivant"@fr ;
    rdfs:comment "La valeur par défaut 'true' indique que le territoire existe actuellement. La valeur 'false' indique un territoire mort suite à un événement de modification." ;
    rdfs:domain <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://www.w3.org/2003/01/geo/wgs84_pos#alt> a rdf:Property ;
    rdfs:label "altitude"@fr .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a rdf:Property ;
    rdfs:label "latitude"@fr .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a rdf:Property ;
    rdfs:label "longitude"@fr .

<http://creativecommons.org/licenses/by/3.0/> a ns2:License ;
    rdfs:label "CC BY 3.0"@en .

ns2:License a owl:Class ;
    rdfs:label "Licence"@fr ;
    rdfs:subClassOf foaf:Document .

<http://dbpedia.org/resource/INSEE> a foaf:Organization .

dcterms:Location a owl:Class ;
    rdfs:label "Lieu"@fr .

dcterms:hasPart a rdf:Property ;
    rdfs:label "a pour partie"@fr .

dcterms:isPartOf a rdf:Property ;
    rdfs:label "fait partie de"@fr .

<http://rdf.insee.fr/def/geo#CreationOuRetablissement> a owl:Class ;
    rdfs:label "Création ou rétablissement"@fr ;
    rdfs:comment "Création ou rétablissemnt d'un territoire"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#ModificationTerritoriale> .

<http://rdf.insee.fr/def/geo#EPCI> a owl:Class ;
    rdfs:label "EPCI"@fr ;
    rdfs:comment "Établissement public de coopération intercommunale"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#Commune> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#membre> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#Commune> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDirecte> ],
        <http://rdf.insee.fr/def/geo#TerritoireAdministratif> .

<http://rdf.insee.fr/def/geo#GroupementDePays> a owl:Class ;
    rdfs:label "Groupement de pays"@fr ;
    rdfs:comment "Exemples : Communauté Européenne, OCDE, OTAN, Pays arabes ..."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#membre> ],
        foaf:Organization .

<http://rdf.insee.fr/def/geo#LAU2> a owl:Class ;
    rdfs:label "LAU 2" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#LAU> .

<http://rdf.insee.fr/def/geo#ancienChefLieu> a owl:ObjectProperty ;
    rdfs:label "ancien chef-lieu"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#TransfertDeChefLieu> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#Commune> ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#place> .

<http://rdf.insee.fr/def/geo#codeISO> a owl:DatatypeProperty ;
    rdfs:label "code de pays ISO"@fr ;
    rdfs:comment "Code conforme à la norme ISO 3166-1-alpha-2"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#Pays> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token ;
    owl:equivalentProperty <http://www.geonames.org/ontology#countryCode> .

<http://rdf.insee.fr/def/geo#communeDeplacee> a owl:ObjectProperty ;
    rdfs:label "commune déplacée"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ChangementDeDepartementOuArrondissement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#Commune> ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#territoireModifie> .

<http://rdf.insee.fr/def/geo#groupementModifie> a owl:ObjectProperty ;
    rdfs:label "groupement modifié"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ModificationDeGroupement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#GroupementDePays> .

<http://rdf.insee.fr/def/geo#modification> a owl:ObjectProperty ;
    rdfs:label "modification"@fr ;
    rdfs:comment "Une modification intervenue pour ce territoire"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#ModificationTerritoriale> ;
    owl:inverseOf <http://rdf.insee.fr/def/geo#territoireModifie> .

<http://rdf.insee.fr/def/geo#nouveauChefLieu> a owl:ObjectProperty ;
    rdfs:label "nouveau chef-lieu"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#TransfertDeChefLieu> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#Commune> ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#place> .

<http://rdf.insee.fr/def/geo#voisin> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "voisin"@fr ;
    rdfs:comment "Un territoire ayant une frontière commune"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    owl:inverseOf <http://rdf.insee.fr/def/geo#voisin> .

<http://www.geonames.org/ontology#A.ADM1> a <http://www.geonames.org/ontology#Code> ;
    rdfs:label "Division administrative de niveau 1"@fr .

<http://www.geonames.org/ontology#A.ADM2> a <http://www.geonames.org/ontology#Code> ;
    rdfs:label "Division administrative de niveau 2"@fr .

<http://www.geonames.org/ontology#A.ADM3> a <http://www.geonames.org/ontology#Code> ;
    rdfs:label "Division administrative de niveau 3"@fr .

<http://www.geonames.org/ontology#A.ADM4> a <http://www.geonames.org/ontology#Code> ;
    rdfs:label "Division administrative de niveau 4"@fr .

<http://www.geonames.org/ontology#A.PCLI> a <http://www.geonames.org/ontology#Code> ;
    rdfs:label "Entité politiquement indépendante"@fr .

<http://www.geonames.org/ontology#countryCode> owl:equivalentProperty <http://rdf.insee.fr/def/geo#codeISO> .

foaf:Document a owl:Class ;
    rdfs:label "Document"@fr .

<http://purl.org/NET/c4dm/event.owl#Event> a owl:Class ;
    rdfs:label "Event"@en,
        "Événement"@fr ;
    rdfs:comment "An arbitrary classification of a space/time region, by a cognitive agent. An event may have actively participating agents, passive factors, products, and a location in space/time."@en .

<http://rdf.insee.fr/def/geo#ChangementDeNom> a owl:Class ;
    rdfs:label "Changement de nom"@fr ;
    rdfs:comment "Changement de l'intitulé du territoire"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://rdf.insee.fr/def/geo#territoireModifie> ],
        <http://rdf.insee.fr/def/geo#ModificationTerritoriale> .

<http://rdf.insee.fr/def/geo#LAU> a owl:Class ;
    rdfs:label "Local Administrative Unit"@en,
        "Unité Administrative Locale"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#PaysOuTerritoire> .

<http://rdf.insee.fr/def/geo#NUTS2> a owl:Class ;
    rdfs:label "NUTS 2" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#NUTS3> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivision> ],
        <http://rdf.insee.fr/def/geo#NUTS> .

<http://rdf.insee.fr/def/geo#NUTS3> a owl:Class ;
    rdfs:label "NUTS 3" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#NUTS> .

<http://rdf.insee.fr/def/geo#Pays> a owl:Class ;
    rdfs:label "Pays"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.PCLI> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#codeAdministratifGeonames> ],
        <http://rdf.insee.fr/def/geo#PaysOuTerritoire> .

<http://rdf.insee.fr/def/geo#SuppressionFusion> a owl:Class ;
    rdfs:label "Suppression-fusion"@fr ;
    rdfs:comment "Suppression ou fusion de territoires"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#ModificationTerritoriale> .

<http://rdf.insee.fr/def/geo#TerritoireFrancais> a owl:Class ;
    rdfs:label "Territoire français"@fr ;
    rdfs:comment "Subdivision administrative ou statistique du territoire français"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://rdf.insee.fr/def/geo#france> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDe> ],
        <http://rdf.insee.fr/def/geo#PaysOuTerritoire> .

<http://rdf.insee.fr/def/geo#TransfertDeChefLieu> a owl:Class ;
    rdfs:label "Transfert de chef-lieu"@fr ;
    rdfs:comment "Changement de la commune chef-lieu d'un territoire"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://rdf.insee.fr/def/geo#nouveauChefLieu> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://rdf.insee.fr/def/geo#ancienChefLieu> ],
        <http://rdf.insee.fr/def/geo#ModificationTerritoriale> .

<http://rdf.insee.fr/def/geo#membre> a owl:ObjectProperty ;
    rdfs:label "membre"@fr ;
    rdfs:comment "Le pays ou territoire objet de cette propriété appartient au groupement sujet"@fr ;
    rdfs:isDefinedBy onto: .

<http://www.w3.org/2003/01/geo/wgs84_pos#Point> a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a owl:Class ;
    rdfs:label "Spatial thing"@en,
        "Entité spatiale"@fr .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Structure de concepts"@fr .

foaf:Organization a owl:Class ;
    rdfs:label "Organisation"@fr .

foaf:Person a owl:Class ;
    rdfs:label "Personne"@fr .

<http://rdf.insee.fr/def/geo#ChangementDeDepartementOuArrondissement> a owl:Class ;
    rdfs:label "Changement de département ou d'arrondissement"@fr ;
    rdfs:comment "Changement de rattachement administratif d'une commune"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://rdf.insee.fr/def/geo#communeDeplacee> ],
        <http://rdf.insee.fr/def/geo#ModificationTerritoriale> .

<http://rdf.insee.fr/def/geo#EchangeDeParcelles> a owl:Class ;
    rdfs:label "Échange de parcelles"@fr ;
    rdfs:comment "Échange de parcelles entre territoires"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#ModificationTerritoriale> .

<http://rdf.insee.fr/def/geo#GroupementStatistiqueDeCommunes> a owl:Class ;
    rdfs:label "Groupement statistique de communes"@fr ;
    rdfs:comment "Modélise des zonages divers d'intérêt statistique"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#Commune> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDirecte> ],
        <http://rdf.insee.fr/def/geo#TerritoireStatistique> .

<http://rdf.insee.fr/def/geo#ModificationDeGroupement> a owl:Class ;
    rdfs:label "Modification de groupement"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://rdf.insee.fr/def/geo#groupementModifie> ],
        <http://purl.org/NET/c4dm/event.owl#Event> .

<http://rdf.insee.fr/def/geo#NUTS> a owl:Class ;
    rdfs:label "Unité Territoriale Statistique"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#PaysOuTerritoire> .

<http://rdf.insee.fr/def/geo#Region> a owl:Class ;
    rdfs:label "Région"@fr ;
    rdfs:comment "Région française de métropole ou d'outre-mer"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#Departement> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDirecte> ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM1> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#codeAdministratifGeonames> ],
        <http://rdf.insee.fr/def/geo#NUTS2>,
        <http://rdf.insee.fr/def/geo#TerritoireAdministratif> .

<http://rdf.insee.fr/def/geo#Canton> a owl:Class ;
    rdfs:label "Canton"@fr ;
    rdfs:comment "Canton français, circonscription d'élection des conseillers généraux"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#TerritoireAdministratif> .

<http://rdf.insee.fr/def/geo#TypeDEPCI> a owl:Class ;
    rdfs:label "Type d'EPCI"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf skos:Concept .

<http://rdf.insee.fr/def/geo#TypeDIRIS> a owl:Class ;
    rdfs:label "Type d'IRIS"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf skos:Concept .

<http://rdf.insee.fr/def/geo#subdivisionDirecte> a owl:ObjectProperty ;
    rdfs:label "subdivision directe"@fr ;
    rdfs:comment "L'objet de cette propriété est une subdivision administrative directe du sujet."@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf.insee.fr/def/geo#subdivision> .

<http://id.insee.fr/codes/geo/typeDEPCI/liste> a skos:ConceptScheme ;
    rdfs:label "Type d'EPCI"@fr .

<http://id.insee.fr/codes/geo/typeDIRIS/liste> a skos:ConceptScheme ;
    rdfs:label "Type d'IRIS"@fr .

<http://rdf.insee.fr/def/geo#Arrondissement> a owl:Class ;
    rdfs:label "Arrondissement"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM3> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#codeAdministratifGeonames> ],
        [ a owl:Restriction ;
            owl:onClass <http://rdf.insee.fr/def/geo#Departement> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDe> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://rdf.insee.fr/def/geo#TerritoireAdministratif> .

<http://rdf.insee.fr/def/geo#IRIS> a owl:Class ;
    rdfs:label "IRIS"@fr ;
    rdfs:comment "Îlot regroupé pour l'information statistique"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://rdf.insee.fr/def/geo#Commune> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDe> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://rdf.insee.fr/def/geo#TerritoireStatistique> .

<http://rdf.insee.fr/def/geo#ModificationDIRIS> a owl:Class ;
    rdfs:label "Modification IRIS"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://rdf.insee.fr/def/geo#territoireModifie> ;
            owl:someValuesFrom <http://rdf.insee.fr/def/geo#IRIS> ],
        <http://rdf.insee.fr/def/geo#ModificationTerritoriale> .

<http://rdf.insee.fr/def/geo#TerritoireStatistique> a owl:Class ;
    rdfs:label "Territoire statistique"@fr ;
    rdfs:comment "Subdivision du territoire français utilisée pour la production de statistiques"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#TerritoireFrancais> .

<http://rdf.insee.fr/def/geo#codeAdministratifGeonames> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "code administratif Geonames"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#TerritoireAdministratif> ;
    rdfs:range [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A> ;
            owl:onProperty skos:inScheme ] .

<http://www.geonames.org/ontology#Code> a owl:Class ;
    rdfs:label "Code Geonames"@fr ;
    rdfs:subClassOf skos:Concept .

<http://purl.org/NET/c4dm/event.owl#place> a rdf:Property ;
    rdfs:label "lieu concerné"@fr ;
    rdfs:comment "Entité spatiale concernée par un événement"@fr .

<http://rdf.insee.fr/def/geo#chefLieu> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "chef-lieu"@fr ;
    rdfs:comment "La commune siège des institutions administratives du territoire"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#Commune> .

<http://rdf.insee.fr/def/geo#Departement> a owl:Class ;
    rdfs:label "Département"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://rdf.insee.fr/def/geo#Arrondissement> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDirecte> ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM2> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#codeAdministratifGeonames> ],
        [ a owl:Restriction ;
            owl:onClass <http://rdf.insee.fr/def/geo#Region> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDe> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://rdf.insee.fr/def/geo#NUTS3>,
        <http://rdf.insee.fr/def/geo#TerritoireAdministratif> .

<http://rdf.insee.fr/def/geo#codeINSEE> a owl:DatatypeProperty ;
    rdfs:label "code INSEE"@fr ;
    rdfs:comment "Propriété générique à utiliser pour les types de territoire pour lesquels un type de code plus spécifique n'est pas défini"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:token .

<http://rdf.insee.fr/def/geo#subdivision> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "subdivision"@fr ;
    rdfs:comment "Une subdivision du territoire" ;
    rdfs:domain <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:subPropertyOf dcterms:hasPart ;
    owl:inverseOf <http://rdf.insee.fr/def/geo#subdivisionDe> .

<http://rdf.insee.fr/def/geo#subdivisionDe> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "subdivision de"@fr ;
    rdfs:comment "Un territoire dont le sujet est une subdivision" ;
    rdfs:domain <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    owl:inverseOf <http://rdf.insee.fr/def/geo#subdivision> .

<http://rdf.insee.fr/def/geo#TerritoireAdministratif> a owl:Class ;
    rdfs:label "Territoire administratif"@fr ;
    rdfs:comment "Subdivision administrative du territoire français"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdf.insee.fr/def/geo#TerritoireFrancais> .

<http://rdf.insee.fr/def/geo#territoireModifie> a owl:ObjectProperty ;
    rdfs:label "territoire modifié"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#ModificationTerritoriale> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/geo#PaysOuTerritoire> ;
    rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#place> ;
    owl:inverseOf <http://rdf.insee.fr/def/geo#modification> .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@fr .

<http://rdf.insee.fr/def/geo#ModificationTerritoriale> a owl:Class ;
    rdfs:label "Modification territoriale"@fr ;
    rdfs:comment "Classe générique de tous les événements liés à la création ou à la modification de territoires"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> .

<http://rdf.insee.fr/def/geo#Commune> a owl:Class ;
    rdfs:label "Commune"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://rdf.insee.fr/def/geo#Arrondissement> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#subdivisionDe> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.geonames.org/ontology#A.ADM4> ;
            owl:onProperty <http://rdf.insee.fr/def/geo#codeAdministratifGeonames> ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://rdf.insee.fr/def/geo#chefLieu> ],
        <http://rdf.insee.fr/def/geo#LAU2>,
        <http://rdf.insee.fr/def/geo#TerritoireAdministratif> .

<http://rdf.insee.fr/def/geo#PaysOuTerritoire> a owl:Class ;
    rdfs:label "Pays ou territoire"@fr ;
    rdfs:comment "Pays ou subdivision géopolitique d'un pays"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf dcterms:Location,
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

onto: a ns1:Vocabulary,
        owl:Ontology ;
    ns2:license <http://creativecommons.org/licenses/by/3.0/>,
        <http://www.data.gouv.fr/Licence-Ouverte-Open-Licence> ;
    dc:rights "Copyright © 2013 INSEE" ;
    dcterms:contributor [ a foaf:Person ;
            foaf:name "Bernard Vatant" ] ;
