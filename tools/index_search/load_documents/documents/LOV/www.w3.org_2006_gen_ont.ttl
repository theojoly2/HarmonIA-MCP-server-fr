@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.w3.org/2000/10/swap/pim/doc#> .
@prefix onto: <http://www.w3.org/2006/gen/ont> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.w3.org/2006/gen/ont#FixedResource> a rdfs:Class ;
    rdfs:label "fixed resource" ;
    rdfs:comment "A resource whose representation type and content will not\\n\\t    change under any circumstances." ;
    rdfs:subClassOf <http://www.w3.org/2006/gen/ont#LanguageSpecificResource>,
        <http://www.w3.org/2006/gen/ont#contentTypeSpecificResource>,
        <http://www.w3.org/2006/gen/ont#timeSpecificResource> .

<http://www.w3.org/2006/gen/ont#InformationResource> a rdfs:Class ;
    rdfs:label "information resource" ;
    rdfs:comment "An Information Resource is defined by the Architecture of\\n\\t    the WWW." .

onto: dc:title "An Ontology for Relating Generic and Specific Information Resources" ;
    rdfs:comment "\\n    This ontology implements concepts discussed in the Generic URIs 'DesignIsues' note.\\n    It is also the topic of the W3C TAG issue and a related TAG finding.\\n    This ontology does not model the fact that representations of a resource can be\\n    customised as a function of things like user agent, target media,\\n    the geographical position of the user,\\n    the preferences of the user, etc.  These could be and can be added.\\n    The FixedResource class is defined to be specific to ANY variation,\\n    as is the fixedResource property.\\n    " ;
    rdfs:seeAlso <http://www.w3.org/DesignIssues/Generic> ;
    ns1:creator <http://www.w3.org/People/Berners-Lee/card#i> ;
    ns1:ipr <http://www.w3.org/2000/10/swap/LICENSE.n3> ;
    ns1:version "$Id: ont.rdf,v 1.7 2009/04/20 10:12:30 timbl Exp $" .

<http://www.w3.org/2006/gen/ont#contentTypeGeneric> a rdf:Property ;
    rdfs:label "Content-Type generic" ;
    rdfs:domain <http://www.w3.org/2006/gen/ont#ContentTypeSpecificResource> ;
    rdfs:range <http://www.w3.org/2006/gen/ont#ContentTypeGenericResource> ;
    rdfs:subPropertyOf <http://www.w3.org/2006/gen/ont#sameWorkAs> .

<http://www.w3.org/2006/gen/ont#fixedResource> a rdf:Property ;
    rdfs:label "Content-Type specific" ;
    rdfs:comment "A relation between a generic resource and a fixedResource\\n    which is an everything-specific version of it." ;
    rdfs:domain <http://www.w3.org/2006/gen/ont#InformationResource> ;
    rdfs:range <http://www.w3.org/2006/gen/ont#FixedResource> ;
    rdfs:subPropertyOf <http://www.w3.org/2006/gen/ont#contentTypeSpecific>,
        <http://www.w3.org/2006/gen/ont#languageSpecific>,
        <http://www.w3.org/2006/gen/ont#timeSpecific> .

<http://www.w3.org/2006/gen/ont#contentTypeSpecific> a rdf:Property ;
    rdfs:label "Content-Type specific" ;
    rdfs:domain <http://www.w3.org/2006/gen/ont#ContentTypeGenericResource> ;
    rdfs:range <http://www.w3.org/2006/gen/ont#ContentTypeSpecificResource> ;
    rdfs:subPropertyOf <http://www.w3.org/2006/gen/ont#sameWorkAs> ;
    owl:inverseOf <http://www.w3.org/2006/gen/ont#ContentTypeGeneric> .

<http://www.w3.org/2006/gen/ont#languageGeneric> a rdf:Property ;
    rdfs:label "language generic" ;
    rdfs:domain <http://www.w3.org/2006/gen/ont#LanguageSpecificResource> ;
    rdfs:range <http://www.w3.org/2006/gen/ont#LanguageGenericResource> ;
    rdfs:subPropertyOf <http://www.w3.org/2006/gen/ont#sameWorkAs> .

<http://www.w3.org/2006/gen/ont#languageSpecific> a rdf:Property ;
    rdfs:label "language specific" ;
    rdfs:domain <http://www.w3.org/2006/gen/ont#LanguageGenericResource> ;
    rdfs:range <http://www.w3.org/2006/gen/ont#LanguageSpecificResource> ;
    rdfs:subPropertyOf <http://www.w3.org/2006/gen/ont#sameWorkAs> ;
    owl:inverseOf <http://www.w3.org/2006/gen/ont#languageGeneric> .

<http://www.w3.org/2006/gen/ont#timeGeneric> a rdf:Property ;
    rdfs:label "time generic" ;
    rdfs:comment "The related resource which for this time-sepcific resource\\n            is the related time-generic resource.\\n            A representation of the time-generic resource may be expected to be\\n            the most recent time-specific resource at the time of\\n            the representation." ;
    rdfs:domain <http://www.w3.org/2006/gen/ont#TimeSpecificResource> ;
    rdfs:range <http://www.w3.org/2006/gen/ont#TimeGenericResource> ;
    rdfs:subPropertyOf <http://www.w3.org/2006/gen/ont#sameWorkAs> .

<http://www.w3.org/2006/gen/ont#timeSpecific> a rdf:Property ;
    rdfs:label "version" ;
    rdfs:domain <http://www.w3.org/2006/gen/ont#TimeGenericResource> ;
    rdfs:range <http://www.w3.org/2006/gen/ont#TimeSpecificResource> ;
    rdfs:subPropertyOf <http://www.w3.org/2006/gen/ont#sameWorkAs> ;
    owl:inverseOf <http://www.w3.org/2006/gen/ont#timeGeneric> .

<http://www.w3.org/2006/gen/ont#ContentTypeGenericResource> rdfs:label "Content-Type-generic resource" ;
    rdfs:comment "A resource which may have representations in\\n    many different Content-Types." ;
    rdfs:subClassOf <http://www.w3.org/2006/gen/ont#InformationResource> .

<http://www.w3.org/2006/gen/ont#ContentTypeSpecificResource> rdfs:label "Content-Type-specific resource" ;
    rdfs:comment "A resource of which all representations are in the\\n\\t\\tsame Internet media type, or 'Content-Type'." ;
    rdfs:subClassOf <http://www.w3.org/2006/gen/ont#InformationResource> .

<http://www.w3.org/2006/gen/ont#LanguageGenericResource> rdfs:label "language-generic resource" ;
    rdfs:comment "A resource defiend without constraint as to\\n\\tthe particular natural language in which it\\n        maight be expressed." ;
    rdfs:subClassOf <http://www.w3.org/2006/gen/ont#InformationResource> .

<http://www.w3.org/2006/gen/ont#TimeGenericResource> rdfs:label "Time-generic resource" ;
    rdfs:comment "A Information Resource which may have many versions,\\n    and therfore representations of the resource at different times may vary." ;
    rdfs:subClassOf <http://www.w3.org/2006/gen/ont#InformationResource> .

<http://www.w3.org/2006/gen/ont#TimeSpecificResource> rdfs:label "version" ;
    rdfs:comment "A resource of which all representations are in the\\n\\t\\tsame version.  Representations of the resource will\\n                not change as a result of th resource neing updated to a\\n                version with time.  The dates of creation and\\n                of last modification of such a resource would be\\n                expected to be the same." ;
    rdfs:subClassOf <http://www.w3.org/2006/gen/ont#InformationResource> .

<http://www.w3.org/2006/gen/ont#LanguageSpecificResource> rdfs:label "language-specific resource" ;
    rdfs:comment "A resource of which all representations are in the\\n\\t\\tsame natural language." ;
    rdfs:subClassOf <http://www.w3.org/2006/gen/ont#InformationResource> .

<http://www.w3.org/2006/gen/ont#sameWorkAs> a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:label "same work as" ;
    rdfs:comment "The equivalence relation linking all versions of a work,\\n            specific or generic along various axes." ;
    rdfs:domain <http://www.w3.org/2006/gen/ont#InformationResource> ;
    rdfs:range <http://www.w3.org/2006/gen/ont#InformationResource> .

