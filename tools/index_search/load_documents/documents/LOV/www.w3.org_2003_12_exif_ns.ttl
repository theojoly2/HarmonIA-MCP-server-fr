@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/12/exif/ns#> .
@prefix ns2: <http://example.org/> .
@prefix onto: <http://www.w3.org/2003/12/exif/ns> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ns1:IFD a rdfs:Class ;
    rdfs:label "IFD"@en ;
    rdfs:comment "An Image File Directory"@en .

onto: a owl:Ontology ;
    dc:description "Vocabulary to describe an Exif format picture data. All Exif 2.2 tags are defined as RDF properties, as well as several terms to help this schema."@en,
        "Vocabulaire pour décrire les données Exif d'une photographie. Toutes les balises Exif 2.2 sont définies comme des propriétés RDF, ainsi que plusieurs termes pour donner de l'aide."@fr ;
    dc:source <http://tsc.jeita.or.jp/avs/data/cp3451.pdf> ;
    dc:title "Exif data description vocabulary"@en ;
    dcterms:created "2003-07-18"@en ;
    dcterms:modified "2003-08-19"@en ;
    owl:versionInfo "Experimental version."@en ;
    foaf:maker <urn:pin:MK705> .

ns1:_unknown a rdf:Property ;
    rdfs:label "Unknown tag"@en ;
    rdfs:comment "An Exif tag whose meaning is not known"@en .

ns1:apertureValue a rdf:Property ;
    rdfs:label "ApertureValue"@en ;
    rdfs:comment "The lens aperture. The unit is the APEX value."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "37378"@en .

ns1:artist a rdf:Property ;
    rdfs:label "Artist"@en ;
    rdfs:comment "Person who created the image"@en ;
    rdfs:subPropertyOf dc:creator,
        ns1:exifAttribute ;
    ns1:tagNumber "315"@en .

ns1:bitsPerSample a rdf:Property ;
    rdfs:label "BitsPerSample"@en ;
    rdfs:comment "The number of bits per image component. In this standard each component of the image is 8 bits, so the value for this tag is 8. See also SamplesPerPixel. In JPEG compressed data a JPEG marker is used instead of this tag."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct,
        ns1:resolution ;
    ns1:tagNumber "258"@en .

ns1:brightnessValue a rdf:Property ;
    rdfs:label "BrightnessValue"@en ;
    rdfs:comment "The value of brightness. The unit is the APEX value. Ordinarily it is given in the range of -99.99 to 99.99. Note that if the numerator of the recorded value is FFFFFFFF.H, Unknown shall be indicated."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "37379"@en .

ns1:cfaPattern a rdf:Property ;
    rdfs:label "CFAPattern"@en ;
    rdfs:comment "The color filter array (CFA) geometric pattern of the image sensor when a one-chip color area sensor is used. It does not apply to all sensing methods."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41730"@en .

ns1:colorSpace a rdf:Property ;
    rdfs:label "ColorSpace"@en ;
    rdfs:comment "The color space information tag (ColorSpace) is always recorded as the color space specifier. Normally sRGB (=1) is used to define the color space based on the PC monitor conditions and environment."@en ;
    rdfs:subPropertyOf ns1:imageDataCharacter ;
    ns1:tagNumber "40961"@en .

ns1:componentsConfiguration a rdf:Property ;
    rdfs:label "ComponentsConfiguration"@en ;
    rdfs:comment "Information specific to compressed data. The channels of each component are arranged in order from the 1st component to the 4th. For uncompressed data the data arrangement is given in the PhotometricInterpretation tag. However, since PhotometricInterpretation can only express the order of Y,Cb and Cr, this tag is provided for cases when compressed data uses components other than Y, Cb, and Cr and to enable support of other sequences."@en ;
    rdfs:subPropertyOf ns1:imageConfig ;
    ns1:tagNumber "37121"@en .

ns1:compressedBitsPerPixel a rdf:Property ;
    rdfs:label "CompressedBitsPerPixel"@en ;
    rdfs:comment "Information specific to compressed data. The compression mode used for a compressed image is indicated in unit bits per pixel."@en ;
    rdfs:subPropertyOf ns1:imageConfig ;
    ns1:tagNumber "37122"@en .

ns1:compression a rdf:Property ;
    rdfs:label "Compression"@en ;
    rdfs:comment "The compression scheme used for the image data. When a primary image is JPEG compressed, this designation is not necessary and is omitted. When thumbnails use JPEG compression, this tag value is set to 6."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct ;
    ns1:tagNumber "259"@en .

ns1:contrast a rdf:Property ;
    rdfs:label "Contrast"@en ;
    rdfs:comment "The direction of contrast processing applied by the camera when the image was shot."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41992"@en .

ns1:copyright a rdf:Property ;
    rdfs:label "Copyright"@en ;
    rdfs:comment "Copyright information. In this standard the tag is used to indicate both the photographer and editor copyrights. It is the copyright notice of the person or organization claiming rights to the image."@en ;
    rdfs:subPropertyOf dc:rights,
        ns1:exifAttribute ;
    ns1:tagNumber "33432"@en .

ns1:customRendered a rdf:Property ;
    rdfs:label "CustomRendered"@en ;
    rdfs:comment "The use of special processing on image data, such as rendering geared to output. When special processing is performed, the reader is expected to disable or minimize any further processing."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41985"@en .

ns1:datatype a rdf:Property ;
    rdfs:label "Data Type"@en ;
    rdfs:comment "The Exif field data type, such as ascii, byte, short etc."@en ;
    rdfs:subPropertyOf dc:type .

ns1:dateTime a rdf:Property ;
    rdfs:label "DateTime"@en ;
    rdfs:comment "The date and time of image creation. In this standard it is the date and time the file was changed."@en ;
    rdfs:subPropertyOf ns1:date,
        ns1:exifAttribute ;
    ns1:tagNumber "306"@en .

ns1:dateTimeDigitized a rdf:Property ;
    rdfs:label "DateTimeDigitized"@en ;
    rdfs:comment "The date and time when the image was stored as digital data. If, for example, an image was captured by DSC and at the same time the file was recorded, then the DateTimeOriginal and DateTimeDigitized will have the same contents."@en ;
    rdfs:subPropertyOf ns1:date,
        ns1:dateAndOrTime ;
    ns1:tagNumber "36868"@en .

ns1:dateTimeOriginal a rdf:Property ;
    rdfs:label "DateTimeOriginal"@en ;
    rdfs:comment "The date and time when the original image data was generated. For a DSC the date and time the picture was taken are recorded."@en ;
    rdfs:subPropertyOf ns1:date,
        ns1:dateAndOrTime ;
    ns1:tagNumber "36867"@en .

ns1:deviceSettingDescription a rdf:Property ;
    rdfs:label "DeviceSettingDescription"@en ;
    rdfs:comment "Information on the picture-taking conditions of a particular camera model. The tag is used only to indicate the picture-taking conditions in the reader."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41995"@en .

ns1:digitalZoomRatio a rdf:Property ;
    rdfs:label "DigitalZoomRatio"@en ;
    rdfs:comment "The digital zoom ratio when the image was shot. If the numerator of the recorded value is 0, this indicates that digital zoom was not used."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41988"@en .

ns1:exifVersion a rdf:Property ;
    rdfs:label "ExifVersion"@en ;
    rdfs:comment "Exif Version"@en ;
    rdfs:subPropertyOf ns1:versionInfo ;
    ns1:tagNumber "36864"@en .

ns1:exif_IFD_Pointer a rdf:Property ;
    rdfs:label "Exif IFD Pointer"@en ;
    rdfs:comment "A pointer to the Exif IFD, which is a set of tags for recording Exif-specific attribute information."@en ;
    rdfs:subPropertyOf ns1:ifdPointer ;
    ns1:tagNumber "34665"@en .

ns1:exifdata a rdf:Property ;
    rdfs:label "Exif data"@en ;
    rdfs:comment "An Exif IFD data entry"@en .

ns1:exposureBiasValue a rdf:Property ;
    rdfs:label "ExposureBiasValue"@en ;
    rdfs:comment "The exposure bias. The unit is the APEX value. Ordinarily it is given in the range of -99.99 to 99.99."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "37380"@en .

ns1:exposureIndex a rdf:Property ;
    rdfs:label "ExposureIndex"@en ;
    rdfs:comment "The exposure index selected on the camera or input device at the time the image is captured."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41493"@en .

ns1:exposureMode a rdf:Property ;
    rdfs:label "ExposureMode"@en ;
    rdfs:comment "the exposure mode set when the image was shot. In auto-bracketing mode, the camera shoots a series of frames of the same scene at different exposure settings."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41986"@en .

ns1:exposureProgram a rdf:Property ;
    rdfs:label "ExposureProgram"@en ;
    rdfs:comment "The class of the program used by the camera to set exposure when the picture is taken."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "34850"@en .

ns1:exposureTime a rdf:Property ;
    rdfs:label "ExposureTime"@en ;
    rdfs:comment "Exposure time, given in seconds (sec)."@en ;
    rdfs:subPropertyOf ns1:pictTaking,
        ns1:seconds ;
    ns1:tagNumber "33434"@en .

ns1:fNumber a rdf:Property ;
    rdfs:label "FNumber"@en ;
    rdfs:comment "F number"@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "33437"@en .

ns1:fileSource a rdf:Property ;
    rdfs:label "FileSource"@en ;
    rdfs:comment "The image source. If a DSC recorded the image, this tag value of this tag always be set to 3, indicating that the image was recorded on a DSC."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41728"@en .

ns1:flash a rdf:Property ;
    rdfs:label "Flash"@en ;
    rdfs:comment "The status of flash when the image was shot."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "37385"@en .

ns1:flashEnergy a rdf:Property ;
    rdfs:label "FlashEnergy"@en ;
    rdfs:comment "The strobe energy at the time the image is captured, as measured in Beam Candle Power Seconds (BCPS)."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41483"@en .

ns1:flashpixVersion a rdf:Property ;
    rdfs:label "FlashpixVersion"@en ;
    rdfs:comment "The Flashpix format version supported by a FPXR file. If the FPXR function supports Flashpix format Ver. 1.0, this is indicated similarly to ExifVersion by recording \"0100\" as 4-byte ASCII."@en ;
    rdfs:subPropertyOf ns1:versionInfo ;
    ns1:tagNumber "40960"@en .

ns1:focalLength a rdf:Property ;
    rdfs:label "FocalLength"@en ;
    rdfs:comment "The actual focal length of the lens, in mm. Conversion is not made to the focal length of a 35 mm film camera."@en ;
    rdfs:subPropertyOf ns1:mm,
        ns1:pictTaking ;
    ns1:tagNumber "37386"@en .

ns1:focalLengthIn35mmFilm a rdf:Property ;
    rdfs:label "FocalLengthIn35mmFilm"@en ;
    rdfs:comment "The equivalent focal length assuming a 35mm film camera, in mm. A value of 0 means the focal length is unknown. Note that this tag differs from the FocalLength tag."@en ;
    rdfs:subPropertyOf ns1:length,
        ns1:pictTaking ;
    ns1:tagNumber "41989"@en .

ns1:focalPlaneResolutionUnit a rdf:Property ;
    rdfs:label "FocalPlaneResolutionUnit"@en ;
    rdfs:comment "The unit for measuring FocalPlaneXResolution and FocalPlaneYResolution. This value is the same as the ResolutionUnit."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41488"@en .

ns1:focalPlaneXResolution a rdf:Property ;
    rdfs:label "FocalPlaneXResolution"@en ;
    rdfs:comment "The number of pixels in the image width (X) direction per FocalPlaneResolutionUnit on the camera focal plane."@en ;
    rdfs:subPropertyOf ns1:pictTaking,
        ns1:resolution ;
    ns1:tagNumber "41486"@en .

ns1:focalPlaneYResolution a rdf:Property ;
    rdfs:label "FocalPlaneYResolution"@en ;
    rdfs:comment "The number of pixels in the image height (Y) direction per FocalPlaneResolutionUnit on the camera focal plane."@en ;
    rdfs:subPropertyOf ns1:pictTaking,
        ns1:resolution ;
    ns1:tagNumber "41487"@en .

ns1:gainControl a rdf:Property ;
    rdfs:label "GainControl"@en ;
    rdfs:comment "The degree of overall image gain adjustment."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41991"@en .

ns1:gpsAltitude a rdf:Property ;
    rdfs:label "GPSAltitude"@en ;
    rdfs:comment "The altitude based on the reference in GPSAltitudeRef. Altitude is expressed as one RATIONAL value. The reference unit is meters."@en ;
    rdfs:subPropertyOf ns1:geo,
        ns1:gpsInfo ;
    ns1:tagNumber "6"@en .

ns1:gpsAltitudeRef a rdf:Property ;
    rdfs:label "GPSAltitudeRef"@en ;
    rdfs:comment "Indicates the altitude used as the reference altitude. If the reference is sea level and the altitude is above sea level, 0 is given. If the altitude is below sea level, a value of 1 is given and the altitude is indicated as an absolute value in the GPSAltitude tag. The reference unit is meters."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "5"@en .

ns1:gpsAreaInformation a rdf:Property ;
    rdfs:label "GPSAreaInformation"@en ;
    rdfs:comment "A character string recording the name of the GPS area. The first byte indicates the character code used, and this is followed by the name of the GPS area."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "28"@en .

ns1:gpsDOP a rdf:Property ;
    rdfs:label "GPSDOP"@en ;
    rdfs:comment "The GPS DOP (data degree of precision). An HDOP value is written during two-dimensional measurement, and PDOP during three-dimensional measurement."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "11"@en .

ns1:gpsDateStamp a rdf:Property ;
    rdfs:label "GPSDateStamp"@en ;
    rdfs:comment "date and time information relative to UTC (Coordinated Universal Time). The record format is \"YYYY:MM:DD\" while converted to W3C-DTF to use in RDF"@en ;
    rdfs:subPropertyOf ns1:date,
        ns1:gpsInfo ;
    ns1:tagNumber "29"@en .

ns1:gpsDestBearing a rdf:Property ;
    rdfs:label "GPSDestBearing"@en ;
    rdfs:comment "The bearing to the destination point. The range of values is from 0.00 to 359.99."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "24"@en .

ns1:gpsDestBearingRef a rdf:Property ;
    rdfs:label "GPSDestBearingRef"@en ;
    rdfs:comment "Indicates the reference used for giving the bearing to the destination point. 'T' denotes true direction and 'M' is magnetic direction."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "23"@en .

ns1:gpsDestDistance a rdf:Property ;
    rdfs:label "GPSDestDistance"@en ;
    rdfs:comment "The distance to the destination point."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "26"@en .

ns1:gpsDestDistanceRef a rdf:Property ;
    rdfs:label "GPSDestDistanceRef"@en ;
    rdfs:comment "Indicates the unit used to express the distance to the destination point. 'K', 'M' and 'N' represent kilometers, miles and knots."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "25"@en .

ns1:gpsDestLatitude a rdf:Property ;
    rdfs:label "GPSDestLatitude"@en ;
    rdfs:comment "Latitude of destination, expressed as three values giving the degrees, minutes, and seconds, respectively."@en ;
    rdfs:subPropertyOf ns1:geo,
        ns1:gpsInfo ;
    ns1:tagNumber "20"@en .

ns1:gpsDestLatitudeRef a rdf:Property ;
    rdfs:label "GPSDestLatitudeRef"@en ;
    rdfs:comment "Reference for latitude of destination"@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "19"@en .

ns1:gpsDestLongitude a rdf:Property ;
    rdfs:label "GPSDestLongitude"@en ;
    rdfs:comment "Longitude of destination, expressed as three values giving the degrees, minutes, and seconds, respectively."@en ;
    rdfs:subPropertyOf ns1:geo,
        ns1:gpsInfo ;
    ns1:tagNumber "22"@en .

ns1:gpsDestLongitudeRef a rdf:Property ;
    rdfs:label "GPSDestLongitudeRef"@en ;
    rdfs:comment "Reference for longitude of destination"@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "21"@en .

ns1:gpsDifferential a rdf:Property ;
    rdfs:label "GPSDifferential"@en ;
    rdfs:comment "Indicates whether differential correction is applied to the GPS receiver."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "30"@en .

ns1:gpsImgDirection a rdf:Property ;
    rdfs:label "GPSImgDirection"@en ;
    rdfs:comment "The direction of the image when it was captured. The range of values is from 0.00 to 359.99."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "17"@en .

ns1:gpsImgDirectionRef a rdf:Property ;
    rdfs:label "GPSImgDirectionRef"@en ;
    rdfs:comment "The reference for giving the direction of the image when it is captured. 'T' denotes true direction and 'M' is magnetic direction."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "16"@en .

ns1:gpsInfo_IFD_Pointer a rdf:Property ;
    rdfs:label "GPSInfo IFD Pointer"@en ;
    rdfs:comment "A pointer to the GPS IFD, which is a set of tags for recording GPS information."@en ;
    rdfs:subPropertyOf ns1:ifdPointer ;
    ns1:tagNumber "34853"@en .

ns1:gpsLatitude a rdf:Property ;
    rdfs:label "GPSLatitude"@en ;
    rdfs:comment "The latitude, expressed as three values giving the degrees, minutes, and seconds, respectively."@en ;
    rdfs:subPropertyOf ns1:geo,
        ns1:gpsInfo ;
    ns1:tagNumber "2"@en .

ns1:gpsLatitudeRef a rdf:Property ;
    rdfs:label "GPSLatitudeRef"@en ;
    rdfs:comment "Indicates whether the latitude is north or south latitude. The ASCII value 'N' indicates north latitude, and 'S' is south latitude."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "1"@en .

ns1:gpsLongitude a rdf:Property ;
    rdfs:label "GPSLongitude"@en ;
    rdfs:comment "The longitude, expressed as three values giving the degrees, minutes, and seconds, respectively."@en ;
    rdfs:subPropertyOf ns1:geo,
        ns1:gpsInfo ;
    ns1:tagNumber "4"@en .

ns1:gpsLongitudeRef a rdf:Property ;
    rdfs:label "GPSLongitudeRef"@en ;
    rdfs:comment "Indicates whether the longitude is east or west longitude. ASCII 'E' indicates east longitude, and 'W' is west longitude."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "3"@en .

ns1:gpsMapDatum a rdf:Property ;
    rdfs:label "GPSMapDatum"@en ;
    rdfs:comment "The geodetic survey data used by the GPS receiver. If the survey data is restricted to Japan, the value of this tag is 'TOKYO' or 'WGS-84'. If a GPS Info tag is recorded, it is strongly recommended that this tag be recorded."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "18"@en .

ns1:gpsMeasureMode a rdf:Property ;
    rdfs:label "GPSMeasureMode"@en ;
    rdfs:comment "The GPS measurement mode. '2' means two-dimensional measurement and '3' means three-dimensional measurement is in progress."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "10"@en .

ns1:gpsProcessingMethod a rdf:Property ;
    rdfs:label "GPSProcessingMethod"@en ;
    rdfs:comment "A character string recording the name of the method used for location finding. The first byte indicates the character code used, and this is followed by the name of the method."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "27"@en .

ns1:gpsSatellites a rdf:Property ;
    rdfs:label "GPSSatellites"@en ;
    rdfs:comment "The GPS satellites used for measurements. This tag can be used to describe the number of satellites, their ID number, angle of elevation, azimuth, SNR and other information in ASCII notation. The format is not specified. If the GPS receiver is incapable of taking measurements, value of the tag shall be set to NULL."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "8"@en .

ns1:gpsSpeed a rdf:Property ;
    rdfs:label "GPSSpeed"@en ;
    rdfs:comment "The speed of GPS receiver movement."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "13"@en .

ns1:gpsSpeedRef a rdf:Property ;
    rdfs:label "GPSSpeedRef"@en ;
    rdfs:comment "The unit used to express the GPS receiver speed of movement. 'K' 'M' and 'N' represents kilometers per hour, miles per hour, and knots."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "12"@en .

ns1:gpsStatus a rdf:Property ;
    rdfs:label "GPSStatus"@en ;
    rdfs:comment "The status of the GPS receiver when the image is recorded. 'A' means measurement is in progress, and 'V' means the measurement is Interoperability."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "9"@en .

ns1:gpsTimeStamp a rdf:Property ;
    rdfs:label "GPSTimeStamp"@en ;
    rdfs:comment "The time as UTC (Coordinated Universal Time). TimeStamp is expressed as three RATIONAL values giving the hour, minute, and second."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "7"@en .

ns1:gpsTrack a rdf:Property ;
    rdfs:label "GPSTrack"@en ;
    rdfs:comment "The direction of GPS receiver movement. The range of values is from 0.00 to 359.99."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "15"@en .

ns1:gpsTrackRef a rdf:Property ;
    rdfs:label "GPSTrackRef"@en ;
    rdfs:comment "The reference for giving the direction of GPS receiver movement. 'T' denotes true direction and 'M' is magnetic direction."@en ;
    rdfs:subPropertyOf ns1:gpsInfo ;
    ns1:tagNumber "14"@en .

ns1:gpsVersionID a rdf:Property ;
    rdfs:label "GPSVersionID"@en ;
    rdfs:comment "The version of GPSInfoIFD. The version is given as 2.2.0.0. This tag is mandatory when GPSInfo tag is present."@en ;
    rdfs:subPropertyOf ns1:gpsInfo,
        ns1:versionInfo ;
    ns1:tagNumber "0"@en .

ns1:imageDescription a rdf:Property ;
    rdfs:label "ImageDescription"@en ;
    rdfs:comment "A character string giving the title of the image. It may be a comment such as \"1988 company picnic\" or the like. Two-byte character codes cannot be used. When a 2-byte code is necessary, the Exif Private tag UserComment is to be used."@en ;
    rdfs:subPropertyOf dc:title,
        ns1:exifAttribute ;
    ns1:tagNumber "270"@en .

ns1:imageLength a rdf:Property ;
    rdfs:label "ImageLength"@en ;
    rdfs:comment "Image height. The number of rows of image data. In JPEG compressed data a JPEG marker is used."@en ;
    rdfs:subPropertyOf ns1:height,
        ns1:imageDataStruct ;
    ns1:tagNumber "257"@en .

ns1:imageUniqueID a rdf:Property ;
    rdfs:label "ImageUniqueID"@en ;
    rdfs:comment "An identifier assigned uniquely to each image. It is recorded as an ASCII string equivalent to hexadecimal notation and 128-bit fixed length."@en ;
    rdfs:subPropertyOf dc:identifier,
        ns1:exifAttribute ;
    ns1:tagNumber "42016"@en .

ns1:imageWidth a rdf:Property ;
    rdfs:label "ImageWidth"@en ;
    rdfs:comment "Image width. The number of columns of image data, equal to the number of pixels per row. In JPEG compressed data a JPEG marker is used instead of this tag."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct,
        ns1:width ;
    ns1:tagNumber "256"@en .

ns1:interoperabilityIndex a rdf:Property ;
    rdfs:label "InteroperabilityIndex"@en ;
    rdfs:comment "Indicates the identification of the Interoperability rule. 'R98' = conforming to R98 file specification of Recommended Exif Interoperability Rules (ExifR98) or to DCF basic file stipulated by Design Rule for Camera File System. 'THM' = conforming to DCF thumbnail file stipulated by Design rule for Camera File System."@en ;
    rdfs:subPropertyOf ns1:interopInfo ;
    ns1:tagNumber "1"@en .

ns1:interoperabilityVersion a rdf:Property ;
    rdfs:label "InteroperabilityVersion"@en ;
    rdfs:comment "Interoperability Version"@en ;
    rdfs:subPropertyOf ns1:interopInfo ;
    ns1:tagNumber "2"@en .

ns1:interoperability_IFD_Pointer a rdf:Property ;
    rdfs:label "Interoperability IFD Pointer"@en ;
    rdfs:comment "A pointer to the Interoperability IFD, which is composed of tags storing the information to ensure the Interoperability"@en ;
    rdfs:subPropertyOf ns1:ifdPointer ;
    ns1:tagNumber "40965"@en .

ns1:isoSpeedRatings a rdf:Property ;
    rdfs:label "ISOSpeedRatings"@en ;
    rdfs:comment "Indicates the ISO Speed and ISO Latitude of the camera or input device as specified in ISO 12232."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "34855"@en .

ns1:jpegInterchangeFormat a rdf:Property ;
    rdfs:label "JPEGInterchangeFormat"@en ;
    rdfs:comment "The offset to the start byte (SOI) of JPEG compressed thumbnail data. This is not used for primary image JPEG data."@en ;
    rdfs:subPropertyOf ns1:recOffset ;
    ns1:tagNumber "513"@en .

ns1:jpegInterchangeFormatLength a rdf:Property ;
    rdfs:label "JPEGInterchangeFormatLength"@en ;
    rdfs:comment "The number of bytes of JPEG compressed thumbnail data. This is not used for primary image JPEG data."@en ;
    rdfs:subPropertyOf ns1:recOffset ;
    ns1:tagNumber "514"@en .

ns1:lightSource a rdf:Property ;
    rdfs:label "LightSource"@en ;
    rdfs:comment "Light source such as Daylight, Tungsten, Flash etc."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "37384"@en .

ns1:make a rdf:Property ;
    rdfs:label "Make"@en ;
    rdfs:comment "Manufacturer of image input equipment"@en ;
    rdfs:subPropertyOf rdfs:label,
        ns1:exifAttribute ;
    ns1:tagNumber "271"@en .

ns1:makerNote a rdf:Property ;
    rdfs:label "MakerNote"@en ;
    rdfs:comment "Manufacturer notes"@en ;
    rdfs:subPropertyOf ns1:userInfo ;
    ns1:tagNumber "37500"@en .

ns1:maxApertureValue a rdf:Property ;
    rdfs:label "MaxApertureValue"@en ;
    rdfs:comment "The smallest F number of the lens. The unit is the APEX value. Ordinarily it is given in the range of 00.00 to 99.99, but it is not limited to this range."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "37381"@en .

ns1:meteringMode a rdf:Property ;
    rdfs:label "MeteringMode"@en ;
    rdfs:comment "Metering mode, such as CenterWeightedAverage, Spot, MultiSpot,Pattern, Partial etc."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "37383"@en .

ns1:model a rdf:Property ;
    rdfs:label "Model"@en ;
    rdfs:comment "Model of image input equipment"@en ;
    rdfs:subPropertyOf rdfs:label,
        ns1:exifAttribute ;
    ns1:tagNumber "272"@en .

ns1:oecf a rdf:Property ;
    rdfs:label "OECF"@en ;
    rdfs:comment "Indicates the Opto-Electric Conversion Function (OECF) specified in ISO 14524. OECF is the relationship between the camera optical input and the image values."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "34856"@en .

ns1:orientation a rdf:Property ;
    rdfs:label "Orientation"@en ;
    rdfs:comment "The image orientation viewed in terms of rows and columns."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct ;
    ns1:tagNumber "274"@en .

ns1:photometricInterpretation a rdf:Property ;
    rdfs:label "PhotometricInterpretation"@en ;
    rdfs:comment "Pixel composition. In JPEG compressed data a JPEG marker is used instead of this tag."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct ;
    ns1:tagNumber "262"@en .

ns1:pimBrightness a rdf:Property ;
    rdfs:label "PrintIM Brightness"@en ;
    rdfs:comment "Brightness info for print image matching"@en ;
    rdfs:subPropertyOf ns1:pimInfo ;
    ns1:tagNumber "10"@en .

ns1:pimColorBalance a rdf:Property ;
    rdfs:label "PrintIM ColorBalance"@en ;
    rdfs:comment "ColorBalance info for print image matching"@en ;
    rdfs:subPropertyOf ns1:pimInfo ;
    ns1:tagNumber "11"@en .

ns1:pimContrast a rdf:Property ;
    rdfs:label "PrintIM Contrast"@en ;
    rdfs:comment "Contrast info for print image matching"@en ;
    rdfs:subPropertyOf ns1:pimInfo ;
    ns1:tagNumber "9"@en .

ns1:pimSaturation a rdf:Property ;
    rdfs:label "PrintIM Saturation"@en ;
    rdfs:comment "Saturation info for print image matching"@en ;
    rdfs:subPropertyOf ns1:pimInfo ;
    ns1:tagNumber "12"@en .

ns1:pimSharpness a rdf:Property ;
    rdfs:label "PrintIM Sharpness"@en ;
    rdfs:comment "Sharpness info for print image matching"@en ;
    rdfs:subPropertyOf ns1:pimInfo ;
    ns1:tagNumber "13"@en .

ns1:pixelXDimension a rdf:Property ;
    rdfs:label "PixelXDimension"@en ;
    rdfs:comment "Information specific to compressed data. When a compressed file is recorded, the valid width of the meaningful image shall be recorded in this tag, whether or not there is padding data or a restart marker. This tag should not exist in an uncompressed file."@en ;
    rdfs:subPropertyOf ns1:imageConfig,
        ns1:width ;
    ns1:tagNumber "40962"@en .

ns1:pixelYDimension a rdf:Property ;
    rdfs:label "PixelYDimension"@en ;
    rdfs:comment "Information specific to compressed data. When a compressed file is recorded, the valid height of the meaningful image shall be recorded in this tag, whether or not there is padding data or a restart marker. This tag should not exist in an uncompressed file. Since data padding is unnecessary in the vertical direction, the number of lines recorded in this valid image height tag will in fact be the same as that recorded in the SOF."@en ;
    rdfs:subPropertyOf ns1:height,
        ns1:imageConfig ;
    ns1:tagNumber "40963"@en .

ns1:planarConfiguration a rdf:Property ;
    rdfs:label "PlanarConfiguration"@en ;
    rdfs:comment "Indicates whether pixel components are recorded in chunky or planar format. In JPEG compressed files a JPEG marker is used instead of this tag. If this field does not exist, the TIFF default of 1 (chunky) is assumed."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct ;
    ns1:tagNumber "284"@en .

ns1:primaryChromaticities a rdf:Property ;
    rdfs:label "PrimaryChromaticities"@en ;
    rdfs:comment "The chromaticity of the three primary colors of the image. Normally this tag is not necessary, since color space is specified in the color space information tag (ColorSpace)."@en ;
    rdfs:subPropertyOf ns1:imageDataCharacter ;
    ns1:tagNumber "319"@en .

ns1:printImageMatching_IFD_Pointer a rdf:Property ;
    rdfs:label "PrintImageMatching IFD Pointer"@en ;
    rdfs:comment "A pointer to the print image matching IFD"@en ;
    rdfs:subPropertyOf ns1:ifdPointer ;
    ns1:tagNumber "50341"@en .

ns1:referenceBlackWhite a rdf:Property ;
    rdfs:label "ReferenceBlackWhite"@en ;
    rdfs:comment "The reference black point value and reference white point value. The color space is declared in a color space information tag, with the default being the value that gives the optimal image characteristics Interoperability these conditions."@en ;
    rdfs:subPropertyOf ns1:imageDataCharacter ;
    ns1:tagNumber "532"@en .

ns1:relatedImageFileFormat a rdf:Property ;
    rdfs:label "RelatedImageFileFormat"@en ;
    rdfs:comment "Related image file format"@en ;
    rdfs:subPropertyOf ns1:interopInfo ;
    ns1:tagNumber "4096"@en .

ns1:relatedImageLength a rdf:Property ;
    rdfs:label "RelatedImageLength"@en ;
    rdfs:comment "Related image length"@en ;
    rdfs:subPropertyOf ns1:height,
        ns1:interopInfo ;
    ns1:tagNumber "4098"@en .

ns1:relatedImageWidth a rdf:Property ;
    rdfs:label "RelatedImageWidth"@en ;
    rdfs:comment "Related image width"@en ;
    rdfs:subPropertyOf ns1:interopInfo,
        ns1:width ;
    ns1:tagNumber "4097"@en .

ns1:relatedSoundFile a rdf:Property ;
    rdfs:label "RelatedSoundFile"@en ;
    rdfs:comment "Related audio file"@en ;
    rdfs:subPropertyOf ns1:relatedFile ;
    ns1:tagNumber "40964"@en .

ns1:resolutionUnit a rdf:Property ;
    rdfs:label "ResolutionUnit"@en ;
    rdfs:comment "The unit for measuring XResolution and YResolution. The same unit is used for both XResolution and YResolution. If the image resolution in unknown, 2 (inches) is designated."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct ;
    ns1:tagNumber "296"@en .

ns1:rowsPerStrip a rdf:Property ;
    rdfs:label "RowsPerStrip"@en ;
    rdfs:comment "The number of rows per strip. This is the number of rows in the image of one strip when an image is divided into strips. With JPEG compressed data this designation is not needed and is omitted."@en ;
    rdfs:subPropertyOf ns1:recOffset ;
    ns1:tagNumber "278"@en .

ns1:samplesPerPixel a rdf:Property ;
    rdfs:label "SamplesPerPixel"@en ;
    rdfs:comment "The number of components per pixel. Since this standard applies to RGB and YCbCr images, the value set for this tag is 3. In JPEG compressed data a JPEG marker is used instead of this tag."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct ;
    ns1:tagNumber "277"@en .

ns1:saturation a rdf:Property ;
    rdfs:label "Saturation"@en ;
    rdfs:comment "The direction of saturation processing applied by the camera when the image was shot."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41993"@en .

ns1:sceneCaptureType a rdf:Property ;
    rdfs:label "SceneCaptureType"@en ;
    rdfs:comment "The type of scene that was shot. It can also be used to record the mode in which the image was shot, such as Landscape, Portrait etc. Note that this differs from the scene type (SceneType) tag."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41990"@en .

ns1:sceneType a rdf:Property ;
    rdfs:label "SceneType"@en ;
    rdfs:comment "The type of scene. If a DSC recorded the image, this tag value shall always be set to 1, indicating that the image was directly photographed."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41729"@en .

ns1:sensingMethod a rdf:Property ;
    rdfs:label "SensingMethod"@en ;
    rdfs:comment "The image sensor type on the camera or input device, such as One-chip color area sensor etc."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41495"@en .

ns1:sharpness a rdf:Property ;
    rdfs:label "Sharpness"@en ;
    rdfs:comment "The direction of sharpness processing applied by the camera when the image was shot."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41994"@en .

ns1:shutterSpeedValue a rdf:Property ;
    rdfs:label "ShutterSpeedValue"@en ;
    rdfs:comment "Shutter speed. The unit is the APEX (Additive System of Photographic Exposure) setting"@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "37377"@en .

ns1:software a rdf:Property ;
    rdfs:label "Software"@en ;
    rdfs:comment "The name and version of the software or firmware of the camera or image input device used to generate the image."@en ;
    rdfs:subPropertyOf rdfs:label,
        ns1:exifAttribute ;
    ns1:tagNumber "305"@en .

ns1:spatialFrequencyResponse a rdf:Property ;
    rdfs:label "SpatialFrequencyResponse"@en ;
    rdfs:comment "This tag records the camera or input device spatial frequency table and SFR values in the direction of image width, image height, and diagonal direction, as specified in ISO 12233."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41484"@en .

ns1:spectralSensitivity a rdf:Property ;
    rdfs:label "SpectralSensitivity"@en ;
    rdfs:comment "Indicates the spectral sensitivity of each channel of the camera used. The tag value is an ASCII string compatible with the standard developed by the ASTM Technical committee."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "34852"@en .

ns1:stripByteCounts a rdf:Property ;
    rdfs:label "StripByteCounts"@en ;
    rdfs:comment "The total number of bytes in each strip. With JPEG compressed data this designation is not needed and is omitted."@en ;
    rdfs:subPropertyOf ns1:recOffset ;
    ns1:tagNumber "279"@en .

ns1:stripOffsets a rdf:Property ;
    rdfs:label "StripOffsets"@en ;
    rdfs:comment "For each strip, the byte offset of that strip. With JPEG compressed data this designation is not needed and is omitted."@en ;
    rdfs:subPropertyOf ns1:recOffset ;
    ns1:tagNumber "273"@en .

ns1:subSecTime a rdf:Property ;
    rdfs:label "SubSecTime"@en ;
    rdfs:comment "DateTime subseconds"@en ;
    rdfs:subPropertyOf ns1:dateAndOrTime,
        ns1:subsecond ;
    ns1:tagNumber "37520"@en .

ns1:subSecTimeDigitized a rdf:Property ;
    rdfs:label "SubSecTimeDigitized"@en ;
    rdfs:comment "DateTimeDigitized subseconds"@en ;
    rdfs:subPropertyOf ns1:dateAndOrTime,
        ns1:subsecond ;
    ns1:tagNumber "37522"@en .

ns1:subSecTimeOriginal a rdf:Property ;
    rdfs:label "SubSecTimeOriginal"@en ;
    rdfs:comment "DateTimeOriginal subseconds"@en ;
    rdfs:subPropertyOf ns1:dateAndOrTime,
        ns1:subsecond ;
    ns1:tagNumber "37521"@en .

ns1:subjectArea a rdf:Property ;
    rdfs:label "SubjectArea"@en ;
    rdfs:comment "The location and area of the main subject in the overall scene."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "37396"@en .

ns1:subjectDistance a rdf:Property ;
    rdfs:label "SubjectDistance"@en ;
    rdfs:comment "The distance to the subject, given in meters. Note that if the numerator of the recorded value is FFFFFFFF.H, Infinity shall be indicated; and if the numerator is 0, Distance unknown shall be indicated."@en ;
    rdfs:subPropertyOf ns1:meter,
        ns1:pictTaking ;
    ns1:tagNumber "37382"@en .

ns1:subjectDistanceRange a rdf:Property ;
    rdfs:label "SubjectDistanceRange"@en ;
    rdfs:comment "The distance to the subject, such as Macro, Close View or Distant View."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41996"@en .

ns1:subjectLocation a rdf:Property ;
    rdfs:label "SubjectLocation"@en ;
    rdfs:comment "The location of the main subject in the scene. The value of this tag represents the pixel at the center of the main subject relative to the left edge, prior to rotation processing as per the Rotation tag. The first value indicates the X column number and second indicates the Y row number."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41492"@en .

ns1:subseconds a rdf:Property ;
    rdfs:label "Subseconds"@en ;
    rdfs:comment "A tag used to record fractions of seconds for a date property"@en .

ns1:tagid a rdf:Property ;
    rdfs:label "Tag ID"@en ;
    rdfs:comment "The Exif tag number with context prefix, such as IFD type or maker name"@en ;
    rdfs:subPropertyOf ns1:tag_number .

ns1:transferFunction a rdf:Property ;
    rdfs:label "TransferFunction"@en ;
    rdfs:comment "A transfer function for the image, described in tabular style. Normally this tag is not necessary, since color space is specified in the color space information tag (ColorSpace)."@en ;
    rdfs:subPropertyOf ns1:imageDataCharacter ;
    ns1:tagNumber "301"@en .

ns1:userComment a rdf:Property ;
    rdfs:label "UserComment"@en ;
    rdfs:comment "A tag for Exif users to write keywords or comments on the image besides those in ImageDescription, and without the character code limitations of the ImageDescription tag. The character code used in the UserComment tag is identified based on an ID code in a fixed 8-byte area at the start of the tag data area."@en ;
    rdfs:subPropertyOf ns1:userInfo ;
    ns1:tagNumber "37510"@en .

ns1:whiteBalance a rdf:Property ;
    rdfs:label "WhiteBalance"@en ;
    rdfs:comment "The white balance mode set when the image was shot."@en ;
    rdfs:subPropertyOf ns1:pictTaking ;
    ns1:tagNumber "41987"@en .

ns1:whitePoint a rdf:Property ;
    rdfs:label "WhitePoint"@en ;
    rdfs:comment "The chromaticity of the white point of the image. Normally this tag is not necessary, since color space is specified in the color space information tag (ColorSpace)."@en ;
    rdfs:subPropertyOf ns1:imageDataCharacter ;
    ns1:tagNumber "318"@en .

ns1:xResolution a rdf:Property ;
    rdfs:label "XResolution"@en ;
    rdfs:comment "The number of pixels per ResolutionUnit in the ImageWidth direction. When the image resolution is unknown, 72 [dpi] is designated."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct,
        ns1:resolution ;
    ns1:tagNumber "282"@en .

ns1:yCbCrCoefficients a rdf:Property ;
    rdfs:label "YCbCrCoefficients"@en ;
    rdfs:comment "The matrix coefficients for transformation from RGB to YCbCr image data."@en ;
    rdfs:subPropertyOf ns1:imageDataCharacter ;
    ns1:tagNumber "529"@en .

ns1:yCbCrPositioning a rdf:Property ;
    rdfs:label "YCbCrPositioning"@en ;
    rdfs:comment "The position of chrominance components in relation to the luminance component. This field is designated only for JPEG compressed data or uncompressed YCbCr data."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct ;
    ns1:tagNumber "531"@en .

ns1:yCbCrSubSampling a rdf:Property ;
    rdfs:label "YCbCrSubSampling"@en ;
    rdfs:comment "The sampling ratio of chrominance components in relation to the luminance component. In JPEG compressed data a JPEG marker is used instead of this tag."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct ;
    ns1:tagNumber "530"@en .

ns1:yResolution a rdf:Property ;
    rdfs:label "YResolution"@en ;
    rdfs:comment "The number of pixels per ResolutionUnit in the ImageLength direction. The same value as XResolution is designated."@en ;
    rdfs:subPropertyOf ns1:imageDataStruct,
        ns1:resolution ;
    ns1:tagNumber "283"@en .

<http://tsc.jeita.or.jp/avs/data/cp3451.pdf> dc:format "PDF"@en ;
    dc:title "JEITA CP-3451/EXIF 2.2 Specification"@en .

ns1:meter a rdf:Property ;
    rdfs:label "Meter"@en ;
    rdfs:comment "A length with unit of meter"@en ;
    rdfs:subPropertyOf ns1:length .

ns1:mm a rdf:Property ;
    rdfs:label "Milimeter"@en ;
    rdfs:comment "A length with unit of mm"@en ;
    rdfs:subPropertyOf ns1:length .

ns1:relatedFile a rdf:Property ;
    rdfs:label "Related File"@en ;
    rdfs:comment "Tag Relating to Related File Information"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:seconds a rdf:Property ;
    rdfs:label "Seconds"@en ;
    rdfs:comment "a mesurement of time length with unit of second"@en .

ns1:tag_number a rdf:Property ;
    rdfs:label "Tag number"@en ;
    rdfs:comment "The Exif tag number"@en ;
    rdfs:subPropertyOf dc:identifier .

<urn:pin:MK705> a foaf:Person ;
    rdfs:seeAlso <http://www.kanzaki.com/info/webwho.rdf> .

ns1:userInfo a rdf:Property ;
    rdfs:label "User Info"@en ;
    rdfs:comment "An attribute relating to User Information"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:height a rdf:Property ;
    rdfs:label "Height"@en ;
    rdfs:comment "Height of an object"@en ;
    rdfs:subPropertyOf ns1:length .

ns1:versionInfo a rdf:Property ;
    rdfs:label "Version Info"@en ;
    rdfs:comment "An attribute relating to Version"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:width a rdf:Property ;
    rdfs:label "Width"@en ;
    rdfs:comment "Width of an object"@en ;
    rdfs:subPropertyOf ns1:length .

ns1:date a rdf:Property ;
    rdfs:label "Date"@en ;
    rdfs:comment "a date information. Usually saved as YYYY:MM:DD (HH:MM:SS) format in Exif data, but represented here as W3C-DTF format"@en ;
    rdfs:subPropertyOf dc:date .

ns1:ifdPointer a rdf:Property ;
    rdfs:label "IFD Pointer"@en ;
    rdfs:comment "A tag that refers a child IFD"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:imageConfig a rdf:Property ;
    rdfs:label "Image Config"@en ;
    rdfs:comment "An attribute relating to Image Configuration"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:dateAndOrTime a rdf:Property ;
    rdfs:label "Date and/or Time"@en ;
    rdfs:comment "An attribute relating to Date and/or Time"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:geo a rdf:Property ;
    rdfs:label "Geometric data"@en ;
    rdfs:comment "Geometric data such as latitude, longitude and altitude. Usually saved as rational number."@en .

ns1:interopInfo a rdf:Property ;
    rdfs:label "Interoperability Info"@en ;
    rdfs:comment "An attribute relating to Interoperability. Tags stored in\\nInteroperability IFD may be defined dependently to each Interoperability rule."@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:length a rdf:Property ;
    rdfs:label "Length"@en ;
    rdfs:comment "Length of an object. Could be a subProperty of other general schema."@en .

ns1:pimInfo a rdf:Property ;
    rdfs:label "PIM Info"@en ;
    rdfs:comment "An attribute relating to print image matching"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:recOffset a rdf:Property ;
    rdfs:label "Recording Offset"@en ;
    rdfs:comment "An attribute relating to recording offset"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:resolution a rdf:Property ;
    rdfs:label "Resolution"@en ;
    rdfs:comment "a rational number representing a resolution. Could be a subProperty of other general schema."@en .

ns1:imageDataCharacter a rdf:Property ;
    rdfs:label "Image Data Character"@en ;
    rdfs:comment "An attribute relating to image data characteristics"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:imageDataStruct a rdf:Property ;
    rdfs:label "Image Data Structure"@en ;
    rdfs:comment "An attribute relating to image data structure"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:exifAttribute a rdf:Property ;
    rdfs:label "Exif Attribute"@en ;
    rdfs:comment "A property that connects an IFD to one of its entries. Super property which integrates all Exif tags."@en ;
    rdfs:domain ns1:IFD .

ns1:gpsInfo a rdf:Property ;
    rdfs:label "GPS Info"@en ;
    rdfs:comment "An attribute relating to GPS information"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

ns1:pictTaking a rdf:Property ;
    rdfs:label "PictTaking"@en ;
    rdfs:comment "An attribute relating to Picture-Taking Conditions"@en ;
    rdfs:subPropertyOf ns1:exifAttribute .

[] a ns2:Example ;
    ns2:code "\\n <exif:IFD rdf:ID=\"Primary_Image\">\\n   <exif:make>Canon</exif:make>\\n   <exif:model>Canon IXY DIGITAL 30</exif:model>\\n   <exif:orientation>top-left</exif:orientation>\\n   <exif:xResolution>180/1</exif:xResolution>\\n   <exif:yResolution>180/1</exif:yResolution>\\n   <exif:resolutionUnit>inch</exif:resolutionUnit>\\n   <exif:dateTime>2003-01-18T16:07:30</exif:dateTime>\\n   <exif:yCbCrPositioning>centered</exif:yCbCrPositioning>\\n   <exif:exif_IFD_Pointer>\\n    <exif:IFD>\\n      <exif:exposureTime>1/400</exif:exposureTime>\\n      <exif:fNumber>35/10</exif:fNumber>\\n      <exif:exifVersion>2.20</exif:exifVersion>\\n      <exif:dateTimeOriginal>2003-01-18T16:07:30</exif:dateTimeOriginal>\\n      <exif:dateTimeDigitized>2003-01-18T16:07:30</exif:dateTimeDigitized>\\n      <exif:componentsConfiguration>01 02 03 00</exif:componentsConfiguration>\\n      <exif:compressedBitsPerPixel>5/1</exif:compressedBitsPerPixel>\\n      <exif:shutterSpeedValue>76</exif:shutterSpeedValue>\\n      <exif:apertureValue>116/32</exif:apertureValue>\\n      <exif:exposureBiasValue>96</exif:exposureBiasValue>\\n      <exif:maxApertureValue>116/32</exif:maxApertureValue>\\n      <exif:meteringMode>Pattern</exif:meteringMode>\\n      <exif:flash>Flash fired, compulsory flash mode, red-eye reduction mode</exif:flash>\\n      <exif:focalLength>294/32</exif:focalLength>\\n      <exif:flashpixVersion>1.00</exif:flashpixVersion>\\n      <exif:colorSpace>sRGB</exif:colorSpace>\\n    </exif:IFD>\\n   </exif:exif_IFD_Pointer>\\n </exif:IFD>\\n "@en ;
    ns2:trial <http://www.kanzaki.com/test/exif2rdf> ;
    dc:description "IFD nodes correspond Exif's IFD directories. Each tag in the directory is described as a property. Some tags are defined as integer in EXIF, but may be better to use (controlled) string value, e.g, use 'top-left' instead of integer value '1' for 'orientation' tag."@en .

