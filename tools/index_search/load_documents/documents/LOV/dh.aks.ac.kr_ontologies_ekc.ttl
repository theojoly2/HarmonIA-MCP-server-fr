@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://dh.aks.ac.kr/ontologies/ekc> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    dc:creator "The Center for Digital Humanities at the Academy of Korean Studies"@en ;
    dc:title "EKC (Encyclopedic Archives of Korean Culture) Data Model vocabulary"@en ;
    dcterms:issued "2017-03-29T18:44:00+09:00"^^xsd:dateTime ;
    dcterms:modified "2025-07-27T06:50:09+09:00"^^xsd:dateTime ;
    rdfs:comment "The present specification is based on the document \\\\\"Ontology:EKC 2022\\\\\", originally led by Hyeon Kim in the Center for Digital Humanities at the Academy of Korean Studies." ;
    rdfs:seeAlso "https://dh.aks.ac.kr/~hanyang2/wiki/index.php/Ontology:EKC_2022",
        "https://github.com/dongshins/EKC_ontology",
        "https://github.com/dongshins/EKC_ontology_advanced" .

<http://dh.aks.ac.kr/ontologies/ekc#> a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual .

<http://dh.aks.ac.kr/ontologies/ekc#3D_모델> a owl:Class ;
    rdfs:label "3D_모델" ;
    rdfs:subClassOf <http://dh.aks.ac.kr/ontologies/ekc#Multimedia> .

<http://dh.aks.ac.kr/ontologies/ekc#3D_지도> a owl:Class ;
    rdfs:label "3D_지도" ;
    rdfs:subClassOf <http://dh.aks.ac.kr/ontologies/ekc#Multimedia> .

<http://dh.aks.ac.kr/ontologies/ekc#administrates> a owl:ObjectProperty ;
    rdfs:label "administrates"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Event> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#E2> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isAdministratedBy> .

<http://dh.aks.ac.kr/ontologies/ekc#annotator> a owl:ObjectProperty ;
    rdfs:label "annotator"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Record> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A2> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isAnnotatorOf> .

<http://dh.aks.ac.kr/ontologies/ekc#appearsIn> a owl:ObjectProperty ;
    rdfs:label "appearsIn"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Concept> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#E3> .

<http://dh.aks.ac.kr/ontologies/ekc#archiveHolding> a owl:ObjectProperty ;
    rdfs:label "archiveHolding"@en ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#XR> ;
    skos:scopeNote "Range : Index/WebResource" .

<http://dh.aks.ac.kr/ontologies/ekc#bibliography> a owl:ObjectProperty ;
    rdfs:label "bibliography"@en ;
    dc:description "참고문헌 목록은 ~이다 ※ 목적어는 참고문헌 색인(bib-XXXX) 노드" ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#XR> ;
    skos:scopeNote "Range : Index/Bibliography" .

<http://dh.aks.ac.kr/ontologies/ekc#calligrapher> a owl:ObjectProperty ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Record> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A2> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isCalligrapherOf> .

<http://dh.aks.ac.kr/ontologies/ekc#commemorates> a owl:ObjectProperty ;
    rdfs:label "commemorates"@en ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Event> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#OB> ;
    skos:note "A는 B를 기념하여 만들어졌다" ;
    skos:scopeNote "Domain : Object/Event/Record" .

<http://dh.aks.ac.kr/ontologies/ekc#constructor> a owl:ObjectProperty ;
    rdfs:label "constructor"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Architecture> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#AR> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isConstructorOf> .

<http://dh.aks.ac.kr/ontologies/ekc#cooks> a owl:ObjectProperty ;
    rdfs:label "cooks"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Food> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#FO> ;
    skos:scopeNote "Domain : Agent(Actor의 subclasses 중 기관, 단체 등)" .

<http://dh.aks.ac.kr/ontologies/ekc#creatorPresumed> a owl:ObjectProperty ;
    rdfs:label "creatorPresumed"@en ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A2> ;
    skos:note "A의 작가는 B라고 알려져 있다" ;
    skos:scopeNote "Domain : Record/Object" .

<http://dh.aks.ac.kr/ontologies/ekc#curates> a owl:ObjectProperty ;
    rdfs:label "curates"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Event> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#E4> ;
    skos:scopeNote "Range : Object/Record/Event" .

<http://dh.aks.ac.kr/ontologies/ekc#depicts> a owl:ObjectProperty ;
    rdfs:label "depicts"@en ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#RE> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isDepictedIn> ;
    skos:note "A가 묘사하는 주된 대상이 B이다" ;
    skos:scopeNote "Domain : Object/Record" .

<http://dh.aks.ac.kr/ontologies/ekc#documents> a owl:ObjectProperty ;
    rdfs:label "documents"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Record> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Event> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#RE> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isDocumentedIn> ;
    skos:note "A:기록물(예:의궤), B: 기록되는 대상(예:의례)" .

<http://dh.aks.ac.kr/ontologies/ekc#doner> a owl:ObjectProperty ;
    rdfs:label "doner"@en ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A2> ;
    skos:scopeNote "Domain : Record/Object" .

<http://dh.aks.ac.kr/ontologies/ekc#editor> a owl:ObjectProperty ;
    rdfs:label "editor"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Record> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A2> .

<http://dh.aks.ac.kr/ontologies/ekc#enshrines> a owl:ObjectProperty ;
    rdfs:label "enshrines"@en ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#P1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isEnshrinedIn> .

<http://dh.aks.ac.kr/ontologies/ekc#founder> a owl:ObjectProperty ;
    rdfs:label "founder"@en ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#AR> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isFounderOf> ;
    skos:scopeNote "Domain : Architecture/Agent(Actor의 subclasses 중 기관, 단체 등)" .

<http://dh.aks.ac.kr/ontologies/ekc#goesWith> a owl:ObjectProperty ;
    rdfs:label "goesWith"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Object> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Object> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#OB> ;
    skos:note "의식에서 물품 간의 수반 관계\\nA는 B와 함께 착용하였다/사용되었다\\nA는 B에 올려졌다\\nA는 B를 담는다/감싼다\\nA는 B로 운반되었다" .

<http://dh.aks.ac.kr/ontologies/ekc#hasAdoptedHeir> a owl:ObjectProperty ;
    rdfs:label "hasAdoptedHeir"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isAdoptedHeirOf> .

<http://dh.aks.ac.kr/ontologies/ekc#hasAffiliation> a owl:ObjectProperty ;
    rdfs:label "hasAffiliation"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A3> ;
    skos:note "A는 B 소속이다" ;
    skos:scopeNote "Range : Agent(Actor의 subclasses 중 기관, 단체 등)" .

<http://dh.aks.ac.kr/ontologies/ekc#hasAppointee> a owl:ObjectProperty ;
    rdfs:label "hasAppointee"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Record> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A4> ;
    skos:note "A(관직, 타이틀)의 피임자는 B이다" .

<http://dh.aks.ac.kr/ontologies/ekc#hasAsset> a owl:ObjectProperty ;
    rdfs:label "hasAsset"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Place> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#HR> ;
    skos:note "A(문화유산 도메인)는 B(개별 문화유산)를 가지고 있다" ;
    skos:scopeNote "Range : Architecture/Object/Record" .

<http://dh.aks.ac.kr/ontologies/ekc#hasBranchTemple> a owl:ObjectProperty ;
    rdfs:label "hasBranchTemple"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Place> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Place> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#HR> ;
    skos:note "A(사찰 본사)에는 말사 B(사찰 말사)가 있다" .

<http://dh.aks.ac.kr/ontologies/ekc#hasBrother> a owl:ObjectProperty ;
    rdfs:label "hasBrother"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isBrotherOf> ;
    skos:scopeNote "형 / 남동생 / 오빠 / 미상未詳" .

<http://dh.aks.ac.kr/ontologies/ekc#hasBrotherInLaw> a owl:ObjectProperty ;
    rdfs:label "hasBrotherInLaw"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    skos:scopeNote "매부 / 동서 / 처남 / 시형제 / 미상未詳" .

<http://dh.aks.ac.kr/ontologies/ekc#hasChineseExplanation> a owl:ObjectProperty ;
    rdfs:label "hasChineseExplanation"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Story> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Story> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#ST> .

<http://dh.aks.ac.kr/ontologies/ekc#hasConcubine> a owl:ObjectProperty ;
    rdfs:label "hasConcubine"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1>,
        <http://dh.aks.ac.kr/ontologies/ekc#isHusbandOf> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isConcubineOf> .

<http://dh.aks.ac.kr/ontologies/ekc#hasContextualElement> a owl:ObjectProperty ;
    rdfs:label "hasContextualElement"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Story> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Story> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#ST> .

<http://dh.aks.ac.kr/ontologies/ekc#hasCousin> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "hasCousin"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> .

<http://dh.aks.ac.kr/ontologies/ekc#hasDaughter> a owl:ObjectProperty ;
    rdfs:label "hasDaughter"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isDaughterOf> ;
    skos:scopeNote "부녀관계(=isFatherOf) / 모녀관계(=isMotherOf) / 미상未詳" .

<http://dh.aks.ac.kr/ontologies/ekc#hasDaughterInLaw> a owl:ObjectProperty ;
    rdfs:label "hasDaughterInLaw"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isDaughterInLawOf> ;
    skos:scopeNote "시부입장(=isFatherInLawOf) / 시모입장(=isMotherInLawOf) / 미상未詳" .

<http://dh.aks.ac.kr/ontologies/ekc#hasDescendant> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "hasDescendant"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isDescendantOf> .

<http://dh.aks.ac.kr/ontologies/ekc#hasDisciple> a owl:ObjectProperty ;
    rdfs:label "hasDisciple"@en ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:equivalentProperty <http://dh.aks.ac.kr/ontologies/ekc#isMasterOf> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isDiscipleOf> .

<http://dh.aks.ac.kr/ontologies/ekc#hasDrawing> a owl:ObjectProperty ;
    rdfs:label "hasDrawing"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Architecture> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Record> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#AR> .

<http://dh.aks.ac.kr/ontologies/ekc#hasEnglishExplanation> a owl:ObjectProperty ;
    rdfs:label "hasEnglishExplanation"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Story> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Story> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#ST> .

<http://dh.aks.ac.kr/ontologies/ekc#hasEpitaph> a owl:ObjectProperty ;
    rdfs:label "hasEpitaph"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Record> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Text> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#RE> ;
    skos:note "A(비석)에는 비문 B(비문)가 새겨져 있다" .

<http://dh.aks.ac.kr/ontologies/ekc#hasExhibition> a owl:ObjectProperty ;
    rdfs:label "hasExhibition"@en ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Event> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#E4> ;
    skos:scopeNote "Domain : Object/Record" .

<http://dh.aks.ac.kr/ontologies/ekc#hasExhibitionAt> a owl:ObjectProperty ;
    rdfs:label "hasExhibitionAt"@en ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#E4> ;
    skos:scopeNote "Domain : Object/Record",
        "Range : Place/Agent(Actor의 subclasses 중 기관, 단체 등)" .

<http://dh.aks.ac.kr/ontologies/ekc#hasFather> a owl:ObjectProperty ;
    rdfs:label "hasFather"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isFatherOf> ;
    skos:note "A의 아버지는 B이다" ;
    skos:scopeNote "부녀관계(=isDaughterOf) / 부자관계(=isSonOf) / 미상未詳" .

<http://dh.aks.ac.kr/ontologies/ekc#hasFatherInLaw> a owl:ObjectProperty ;
    rdfs:label "hasFatherInLaw"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isFatherInLawOf> ;
    skos:scopeNote "며느리입장(=isDaughterInLawOf) / 사위입장(=isSonInLawOf) / 미상未詳" .

<http://dh.aks.ac.kr/ontologies/ekc#hasGrandDaughter> a owl:ObjectProperty ;
    rdfs:label "hasGrandDaughter"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isGrandDaughterOf> .

<http://dh.aks.ac.kr/ontologies/ekc#hasGrandson> a owl:ObjectProperty ;
    rdfs:label "hasGrandson"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:inverseOf <http://dh.aks.ac.kr/ontologies/ekc#isGrandsonOf> .

<http://dh.aks.ac.kr/ontologies/ekc#hasHermitage> a owl:ObjectProperty ;
    rdfs:label "hasHermitage"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Place> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Place> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#HR> ;
    skos:note "A(사찰)에는 암자 B(사찰 암자)가 있다" .

<http://dh.aks.ac.kr/ontologies/ekc#hasHistoricalSetting> a owl:ObjectProperty ;
    rdfs:label "hasHistoricalSetting"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Record> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Event> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#RE> .

<http://dh.aks.ac.kr/ontologies/ekc#hasIngredient> a owl:ObjectProperty ;
    rdfs:label "hasIngredient"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Food> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Food> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#FO> .

<http://dh.aks.ac.kr/ontologies/ekc#hasInscription> a owl:ObjectProperty ;
    rdfs:label "hasInscription"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Object> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Text> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#OB> ;
    skos:note "A(물품)에는 명문 B(명문)가 새겨져 있다" .

<http://dh.aks.ac.kr/ontologies/ekc#hasMaster> a owl:ObjectProperty ;
    rdfs:label "hasMaster"@en ;
    rdfs:domain <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:range <http://dh.aks.ac.kr/ontologies/ekc#Actor> ;
    rdfs:subPropertyOf <http://dh.aks.ac.kr/ontologies/ekc#A1> ;
    owl:equivalentProperty <http://dh.aks.ac.kr/ontologies/ekc#isDiscipleOf> ;
    skos:note "A의 스승은 B이다" .

<http://dh.aks.ac.kr/ontologies/ekc#hasMother> a owl:ObjectProperty ;
    rdfs:label "hasMother"@en ;
