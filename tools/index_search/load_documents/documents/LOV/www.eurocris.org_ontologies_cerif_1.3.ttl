@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://www.eurocris.org/ontologies/cerif/1.3> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity> a rdfs:Class,
        owl:Class ;
    rdfs:label "Base Entity" ;
    rdfs:comment "This abstract class brings together the main entities of the CERIF model." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#Entity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Cite> a rdfs:Class,
        owl:Class ;
    rdfs:label "Cite" ;
    rdfs:comment "Cite" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Classification> a rdfs:Class,
        owl:Class ;
    rdfs:label "Classification" ;
    rdfs:comment "Represents the classification of a given entity" ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#CurriculumVitae> a rdfs:Class,
        owl:Class ;
    rdfs:label "Curriculum Vitae" ;
    rdfs:comment "Curriculum Vitae" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#ElectronicAddress> a rdfs:Class,
        owl:Class ;
    rdfs:label "Electronic Address" ;
    rdfs:comment "ElectronicAddress" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Entity> a rdfs:Class,
        owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "Common superclass of all non-link entities, as an aid in querying." ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#Equipment> a rdfs:Class,
        owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:comment "Equipment" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#InfrastructureEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Event> a rdfs:Class,
        owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "Event" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#ExpSkill> a rdfs:Class,
        owl:Class ;
    rdfs:label "Expertise and skills" ;
    rdfs:comment "Expertise and skills" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Facility> a rdfs:Class,
        owl:Class ;
    rdfs:label "Facility" ;
    rdfs:comment "Facility" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#InfrastructureEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Funding> a rdfs:Class,
        owl:Class ;
    rdfs:label "Funding" ;
    rdfs:comment "Funding" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#InfrastructureEntity> a rdfs:Class,
        owl:Class ;
    rdfs:label "Infrastructure Entity" ;
    rdfs:comment "Abstract entity for representing infrastructures" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#Entity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Metrics> a rdfs:Class,
        owl:Class ;
    rdfs:label "Metrics" ;
    rdfs:comment "Metrics" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#OrganizationalUnit> a rdfs:Class,
        owl:Class ;
    rdfs:label "Organizational Unit (cfOrgUnit)" ;
    rdfs:comment "A given organizational unit" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity>,
        foaf:Organization .

<http://www.eurocris.org/ontologies/cerif/1.3#Patent> a rdfs:Class,
        owl:Class ;
    rdfs:label "Patent" ;
    rdfs:comment "A registered patent as a research result" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Patent>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Person> a rdfs:Class,
        owl:Class ;
    rdfs:label "Person (cfPers)" ;
    rdfs:comment "A given person" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity>,
        foaf:Person .

<http://www.eurocris.org/ontologies/cerif/1.3#PostalAddress> a rdfs:Class,
        owl:Class ;
    rdfs:label "Postal Address" ;
    rdfs:comment "Postal Address" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#PriceAward> a rdfs:Class,
        owl:Class ;
    rdfs:label "Price Award" ;
    rdfs:comment "Price Award" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Product> a rdfs:Class,
        owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A research result that is classified neither as a patent nor as a publication." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Project> a rdfs:Class,
        owl:Class ;
    rdfs:label "Project" ;
    rdfs:comment "A research project" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity>,
        foaf:Project .

<http://www.eurocris.org/ontologies/cerif/1.3#Publication> a rdfs:Class,
        owl:Class ;
    rdfs:label "Publication" ;
    rdfs:comment "Represents a scientific or academic publication " ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/bibo/Document>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Qualification> a rdfs:Class,
        owl:Class ;
    rdfs:label "Qualification" ;
    rdfs:comment "Qualification" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Relationship> a rdfs:Class,
        owl:Class ;
    rdfs:label "Relationship" ;
    rdfs:comment "intermediate entity between two entities." ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity> a rdfs:Class,
        owl:Class ;
    rdfs:label "Result Entity" ;
    rdfs:comment "Represents a research result" ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> a rdfs:Class,
        owl:Class ;
    rdfs:label "Second-level Entity" ;
    rdfs:comment "The 2nd level entities allow for the representation of the research context by linking to them from the base and result entities." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#Entity> .

<http://www.eurocris.org/ontologies/cerif/1.3#Service> a rdfs:Class,
        owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "Service" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.eurocris.org/ontologies/cerif/1.3#InfrastructureEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#abstract> a rdf:Property ;
    rdfs:label "Abstract" ;
    rdfs:comment "Abstract of a given Project" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Project> ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#acronym> a rdf:Property ;
    rdfs:label "Acronym" ;
    rdfs:comment "Acronym of a given Project or an Organisation Unit" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#OrganizationalUnit>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Project> ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#addressLine> a rdf:Property ;
    rdfs:label "Address Line" ;
    rdfs:comment "Numbered line of a given postal address" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#PostalAddress> ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#agrovoc> a rdf:Property ;
    rdfs:label "Agrovoc Classification" ;
    rdfs:comment "External Classification Scheme according to Agrovoc Vocabulary" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:subject .

<http://www.eurocris.org/ontologies/cerif/1.3#approvalDate> a rdf:Property ;
    rdfs:label "Approval Date" ;
    rdfs:comment "Approval Date of a patent" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Patent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:date .

<http://www.eurocris.org/ontologies/cerif/1.3#birthdate> a rdf:Property ;
    rdfs:label "Birthdate" ;
    rdfs:comment "BirthDate of a Person" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf foaf:birthday .

<http://www.eurocris.org/ontologies/cerif/1.3#cityTown> a rdf:Property ;
    rdfs:label "City Town" ;
    rdfs:comment "City Town of an physical localisation" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Event>,
        <http://www.eurocris.org/ontologies/cerif/1.3#PostalAddress> ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#classification> a rdf:Property ;
    rdfs:label "Classification" ;
    rdfs:comment "Indicates a classification for a entity according to a suitable external vocabulary" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Classification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#link> .

<http://www.eurocris.org/ontologies/cerif/1.3#country> a rdf:Property ;
    rdfs:label "Country " ;
    rdfs:comment "A given country - http://dbpedia.org/ontology/Country" ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#countryCode> a rdf:Property ;
    rdfs:label "Country Code" ;
    rdfs:comment "International code of a given country " ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Event>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Patent>,
        <http://www.eurocris.org/ontologies/cerif/1.3#PostalAddress> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#code> .

<http://www.eurocris.org/ontologies/cerif/1.3#currency> a rdf:Property ;
    rdfs:label "Currency" ;
    rdfs:comment "Specific currency used for denote amounts, prices and turnovers. Linking with http://dbpedia.org/ontology/Language" ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#digitalCV> a rdf:Property ;
    rdfs:label "Digital CV" ;
    rdfs:comment "Digital CV" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#CurriculumVitae> ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#endDate> a rdf:Property ;
    rdfs:label "End Date" ;
    rdfs:comment "End of a period of time" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Event>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Funding>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Project>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Relationship>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:date .

<http://www.eurocris.org/ontologies/cerif/1.3#feeOrFree> a rdf:Property ;
    rdfs:label "Fee Or Free" ;
    rdfs:comment "Flag indicating if the event is fee or free" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Event> ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#fraction> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Fraction" ;
    rdfs:comment "Fractional value to indicate a classification reference or a % allocation in the relationship between entities." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

<http://www.eurocris.org/ontologies/cerif/1.3#funding> a rdf:Property ;
    rdfs:label "Funding" ;
    rdfs:comment "Amount of a given Funding (measured in a specific currency)" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Funding> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#money> .

<http://www.eurocris.org/ontologies/cerif/1.3#fundingCurrencyCode> a rdf:Property ;
    rdfs:label "Funding Currency Code" ;
    rdfs:comment "Currency code used to denote the funding amount" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#currencyCode> .

<http://www.eurocris.org/ontologies/cerif/1.3#gender> a rdf:Property ;
    rdfs:label "Gender" ;
    rdfs:comment "Gender of a CERIF person" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf foaf:gender .

<http://www.eurocris.org/ontologies/cerif/1.3#headcount> a rdf:Property ;
    rdfs:label "Headcount" ;
    rdfs:comment "Number of persons enrolled in a Organisation Unit" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#OrganizationalUnit> ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#internalIdentifier> a rdf:Property ;
    rdfs:label "Internal Identifier" ;
    rdfs:comment "Internal Identifier for a research entity. It fits with the primary key in the corresponding table from the internal database" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:identifier .

<http://www.eurocris.org/ontologies/cerif/1.3#inventoryIdentifier> a rdf:Property ;
    rdfs:label "Inventory Identifier" ;
    rdfs:comment "The equipment owner's inventory identifier." ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Equipment> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:identifier .

<http://www.eurocris.org/ontologies/cerif/1.3#isClassifiedBy> a rdf:Property ;
    rdfs:label "Is Classified By" ;
    rdfs:comment "A entity is classified within a time interval according to CERIF Semantic Vocabulary." ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#InfrastructureEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.eurocris.org/ontologies/cerif/1.3#Classification> .

<http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByFunding> a rdf:Property ;
    rdfs:label "Is Linked By Funding" ;
    rdfs:comment "A given Funding is related with a entity through a time-stamped link." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByOrganisationUnit> a rdf:Property ;
    rdfs:label "Is Linked By a Organisation Unit" ;
    rdfs:comment "A given Organisation Unit is related with a entity through a time-stamped link." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByPerson> a rdf:Property ;
    rdfs:label "Is Linked By a Person" ;
    rdfs:comment "A given Person is related with a entity through a time-stamped link. " ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByProject> a rdf:Property ;
    rdfs:label "is Linked By Project" ;
    rdfs:comment "A given Project is related with a entity through a time-stamped link." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByPublication> a rdf:Property ;
    rdfs:label "is Linked By Publication" ;
    rdfs:comment "A given Publication is related with a entity through a time-stamped link." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#keyword> a rdf:Property ;
    rdfs:label "Keyword" ;
    rdfs:comment "Keywords of a given entity" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:subject .

<http://www.eurocris.org/ontologies/cerif/1.3#language> a rdf:Property ;
    rdfs:label "Language" ;
    rdfs:comment "A given language. Linking to http://dbpedia.org/ontology/Language" ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#languageCode> a rdf:Property ;
    rdfs:label "Language Code" ;
    rdfs:comment "International code of a given language" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#code> .

<http://www.eurocris.org/ontologies/cerif/1.3#linksToFunding> a rdf:Property ;
    rdfs:label "Links to Funding" ;
    rdfs:comment "It relates a entity with a given Funding entity through a time-stamped link." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#linksToEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#linksToOrganisationUnit> a rdf:Property ;
    rdfs:label "Links To a Organisation Unit" ;
    rdfs:comment "It relates a entity with a given Organisation Unit through a time-stamped link." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#linksToEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#linksToPerson> a rdf:Property ;
    rdfs:label "Is Linked By a Person" ;
    rdfs:comment "It relates a entity with a given Person through a time-stamped link." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#linksToEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#linksToPostalAddress> a rdf:Property ;
    rdfs:label "Links to a Postal Address" ;
    rdfs:comment "It relates a entity with a given Postal Address through a time-stamped link. Used, for example, in Persons and Organisation Units" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#linksToEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#linksToProject> a rdf:Property ;
    rdfs:label "Links To a Project" ;
    rdfs:comment "It relates a  entity with a given Project through a time-stamped link." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#linksToEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#linksToPublication> a rdf:Property ;
    rdfs:label "Links To a Publication" ;
    rdfs:comment "It relates a entity with a given Publication through a time-stamped link." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#linksToEntity> .

<http://www.eurocris.org/ontologies/cerif/1.3#manufacturerIdentifier> a rdf:Property ;
    rdfs:label "Manufacturer Identifier" ;
    rdfs:comment "The equipment manufacturer's ID." ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Equipment> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:identifier .

<http://www.eurocris.org/ontologies/cerif/1.3#name> a rdf:Property ;
    rdfs:label "Name" ;
    rdfs:comment "Name of a CERIF entity, e.g.: Person, or Organization Unit" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Person>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Project> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf foaf:name .

<http://www.eurocris.org/ontologies/cerif/1.3#patentNumber> a rdf:Property ;
    rdfs:label "Patent Number" ;
    rdfs:comment "Number of a Registered Patent" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:identifier .

<http://www.eurocris.org/ontologies/cerif/1.3#postCode> a rdf:Property ;
    rdfs:label "Post Code" ;
    rdfs:comment "Postal Code of a given Address" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#PostalAddress> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#code> .

<http://www.eurocris.org/ontologies/cerif/1.3#price> a rdf:Property ;
    rdfs:label "Price" ;
    rdfs:comment "Quantity of payment or compensation given by one party to another in return for goods or service (measured in a specific currency)" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#money> .

<http://www.eurocris.org/ontologies/cerif/1.3#priceCurrencyCode> a rdf:Property ;
    rdfs:label "Price Currency Code" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#currencyCode> .

<http://www.eurocris.org/ontologies/cerif/1.3#productNumber> a rdf:Property ;
    rdfs:label "Product Number" ;
    rdfs:comment "Number of a Product" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:identifier .

<http://www.eurocris.org/ontologies/cerif/1.3#registrationDate> a rdf:Property ;
    rdfs:label "Registration Date" ;
    rdfs:comment "Registration Date of a patent" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Patent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:date .

<http://www.eurocris.org/ontologies/cerif/1.3#researchActivities> a rdf:Property ;
    rdfs:label "Research Activities" ;
    rdfs:comment "Research Activities" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#OrganizationalUnit> ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#researchInterests> a rdf:Property ;
    rdfs:label "Research Interests" ;
    rdfs:comment "Research Interests" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Person> ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#role> a rdf:Property ;
    rdfs:label "Role" ;
    rdfs:comment "Indicates a role for the association or composition between two CERIF entities indicated by a term from a suitable external vocabulary" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Relationship> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#link> .

<http://www.eurocris.org/ontologies/cerif/1.3#startDate> a rdf:Property ;
    rdfs:label "Start Date" ;
    rdfs:comment "Beginning of a period of time" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#Classification>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Event>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Funding>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Project>,
        <http://www.eurocris.org/ontologies/cerif/1.3#Relationship> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:date .

<http://www.eurocris.org/ontologies/cerif/1.3#title> a rdf:Property ;
    rdfs:label "Title" ;
    rdfs:comment "Title of a given CERIF entity" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:title .

<http://www.eurocris.org/ontologies/cerif/1.3#turnover> a rdf:Property ;
    rdfs:label "Turnover" ;
    rdfs:comment "Turnover of a Organisation Unit (measured in a specific currency)" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#OrganizationalUnit> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#money> .

<http://www.eurocris.org/ontologies/cerif/1.3#turnoverCurrencyCode> a rdf:Property ;
    rdfs:label "Turnover Currency Code" ;
    rdfs:comment "Currency Code used to denote turnovers" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#currencyCode> .

<http://www.eurocris.org/ontologies/cerif/1.3#uri> a rdf:Property ;
    rdfs:label "URI" ;
    rdfs:comment "Uniform Resource Identifier related with a given CERIF entity" ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf foaf:homepage .

<http://www.eurocris.org/ontologies/cerif/1.3#brigitte> a foaf:Person ;
    foaf:name "Brigitte Joerg" .

<http://www.eurocris.org/ontologies/cerif/1.3#geert> a foaf:Person ;
    foaf:name "Geert van Grootel" .

<http://www.eurocris.org/ontologies/cerif/1.3#jan> a foaf:Person ;
    foaf:name "Jan Dvorak" .

<http://www.eurocris.org/ontologies/cerif/1.3#keith> a foaf:Person ;
    foaf:name "Keith G Jeffery" .

<http://www.eurocris.org/ontologies/cerif/1.3#msicilia> a foaf:Person ;
    foaf:name "Miguel Ángel Sicilia" .

<http://www.eurocris.org/ontologies/cerif/1.3#ruizrube> a foaf:Person ;
    foaf:name "Iván Ruiz Rube" .

<http://www.eurocris.org/ontologies/cerif/1.3#link> a rdf:Property ;
    rdfs:label "Link" ;
    rdfs:comment "It is a generalisation for relationship and classification properties" ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#currencyCode> a rdf:Property ;
    rdfs:label "Currency Code" ;
    rdfs:comment "Code of a specific currency used for denote amounts, prices and turnovers." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.eurocris.org/ontologies/cerif/1.3#code> .

<http://www.eurocris.org/ontologies/cerif/1.3#money> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Money" ;
    rdfs:comment "This property embraces all Currency-dependent properties " ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

<http://www.eurocris.org/ontologies/cerif/1.3#code> a rdf:Property ;
    rdfs:label "Code" ;
    rdfs:comment "Generic property for represent international and shared codes" ;
    rdfs:isDefinedBy onto: .

<http://www.eurocris.org/ontologies/cerif/1.3#isLinkedByEntity> a rdf:Property ;
    rdfs:label "Is Linked by Entity" ;
    rdfs:comment "This is an abstract property to group all properties that inversely relate a entity with other through a time-stamped link." ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#InfrastructureEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.eurocris.org/ontologies/cerif/1.3#Relationship> .

<http://www.eurocris.org/ontologies/cerif/1.3#linksToEntity> a rdf:Property ;
    rdfs:label "Links to Entity" ;
    rdfs:comment "This is an abstract property to group all properties that directly relate a entity with other through a time-stamped link." ;
    rdfs:domain <http://www.eurocris.org/ontologies/cerif/1.3#BaseEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#InfrastructureEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ResultEntity>,
        <http://www.eurocris.org/ontologies/cerif/1.3#SecondLevelEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.eurocris.org/ontologies/cerif/1.3#Relationship> .

onto: a owl:Ontology ;
    dc:creator <http://www.eurocris.org/ontologies/cerif/1.3#brigitte>,
        <http://www.eurocris.org/ontologies/cerif/1.3#geert>,
        <http://www.eurocris.org/ontologies/cerif/1.3#jan>,
        <http://www.eurocris.org/ontologies/cerif/1.3#keith>,
        <http://www.eurocris.org/ontologies/cerif/1.3#msicilia>,
        <http://www.eurocris.org/ontologies/cerif/1.3#ruizrube> ;
    dc:description "The <em>Common European Research Information Format (CERIF) Ontology Specification</em> provides basic concepts and properties for describing research information as semantic data. This document contains a friendly description of the <em>Common European Research Information Format (CERIF) Ontology</em> developed by EuroCRIS." ;
    dc:modified "2015-03-26"^^xsd:date ;
    dc:title "CERIF Ontology 1.3" ;
    vann:preferredNamespacePrefix "cerif" ;
    vann:preferredNamespaceUri "http://www.eurocris.org/ontologies/cerif/1.3#" ;
    foaf:page onto:.html .

