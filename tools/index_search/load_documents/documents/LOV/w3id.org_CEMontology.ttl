@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <https://w3id.org/CEMontology> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://crimeanalytics.it/cem/Assault> a owl:Class ;
    rdfs:label "Assault"@en ;
    rdfs:comment "Assaults and threats"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeAgainstPerson> .

<http://crimeanalytics.it/cem/Burglary> a owl:Class ;
    rdfs:label "Burglary"@en ;
    rdfs:comment "Burglary"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeAgainstProperty> .

<http://crimeanalytics.it/cem/Corruption> a owl:Class ;
    rdfs:label "Corruption"@en ;
    rdfs:comment "Corruption"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeWithDeception> .

<http://crimeanalytics.it/cem/CrimeAgainstNaturalEnvironment> a owl:Class ;
    rdfs:label "CrimeAgainstNaturalEnvironment"@en ;
    rdfs:comment "Acts against the natural environment "@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://crimeanalytics.it/cem/CrimeAgainstPublicSafety> a owl:Class ;
    rdfs:label "CrimeAgainstPublicSafety"@en ;
    rdfs:comment "Acts against public safety and state security"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://crimeanalytics.it/cem/Defamation> a owl:Class ;
    rdfs:label "Defamation"@en ;
    rdfs:comment "Defamation or insult"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeAgainstPerson> .

<http://crimeanalytics.it/cem/Discrimination> a owl:Class ;
    rdfs:label "Discrimination"@en ;
    rdfs:comment "Discrimination"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeAgainstPerson> .

<http://crimeanalytics.it/cem/Drug> a owl:Class ;
    rdfs:label "Drug"@en ;
    rdfs:comment "Acts involving controlled drugs or other psychoactive substances"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://crimeanalytics.it/cem/Forgery> a owl:Class ;
    rdfs:label "Forgery"@en ;
    rdfs:comment "Forgery/counterfeiting"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeWithDeception> .

<http://crimeanalytics.it/cem/Fraud> a owl:Class ;
    rdfs:label "Fraud"@en ;
    rdfs:comment "Fraud"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeWithDeception> .

<http://crimeanalytics.it/cem/Homicide> a owl:Class ;
    rdfs:label "Homicide"@en ;
    rdfs:comment "Acts leading to death or intending to cause death"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://crimeanalytics.it/cem/Intimidation> a owl:Class ;
    rdfs:label "Intimidation"@en ;
    rdfs:comment "Acts intended to induce fear or emotional distress"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeAgainstPerson> .

<http://crimeanalytics.it/cem/MoneyLaundering> a owl:Class ;
    rdfs:label "MoneyLaundering"@en ;
    rdfs:comment "Money laundering"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeProceeds> .

<http://crimeanalytics.it/cem/OtherCrime> a owl:Class ;
    rdfs:label "OtherCrime"@en ;
    rdfs:comment "Other criminal acts not elsewhere classified"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://crimeanalytics.it/cem/PropertyDamage> a owl:Class ;
    rdfs:label "PropertyDamage"@en ;
    rdfs:comment "Property damage"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeAgainstProperty> .

<http://crimeanalytics.it/cem/SexualExploitation> a owl:Class ;
    rdfs:label "SexualExploitation"@en ;
    rdfs:comment "Sexual exploitation"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/SexualCrime> .

<http://crimeanalytics.it/cem/SexualViolence> a owl:Class ;
    rdfs:label "SexualViolence"@en ;
    rdfs:comment "Sexual violence"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/SexualCrime> .

<http://crimeanalytics.it/cem/Slavery> a owl:Class ;
    rdfs:label "Slavery"@en ;
    rdfs:comment "Slavery and exploitation"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeAgainstPerson> .

<http://crimeanalytics.it/cem/TaxEvasion> a owl:Class ;
    rdfs:label "TaxEvasion"@en ;
    rdfs:comment "Acts contrary to public revenue or regulatory provisions"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeAgainstPublicOrder> .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:provenance a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://schema.org/NewsArticle> a owl:Class ;
    rdfs:label "NewsArticle"@en ;
    rdfs:comment "A NewsArticle is an article whose content reports news, or provides background context and supporting materials for understanding the news.<br/><br/>\\n\\nA more detailed overview of <a href=\"/docs/news.html\">schema.org News markup</a> is also available."@en ;
    rdfs:isDefinedBy schema:NewsArticle ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://schema.org/mentions> ;
            owl:someValuesFrom <http://crimeanalytics.it/cem/CrimeEvent> ],
        <http://schema.org/Article> .

<http://schema.org/hasurl> a owl:ObjectProperty ;
    rdfs:label "url"@en ;
    rdfs:comment "URL of the item."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Thing> ;
                    rdf:rest () ] ] ;
    rdfs:isDefinedBy schema:url ;
    rdfs:range [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Text> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/URL> ;
                            rdf:rest () ] ] ] .

<http://schema.org/inLanguage> a owl:ObjectProperty ;
    rdfs:label "inLanguage"@en ;
    rdfs:comment "The language of the content or performance or used in an action. Please use one of the language codes from the <a href=\"http://tools.ietf.org/html/bcp47\">IETF BCP 47 standard</a>. See also <a class=\"localLink\" href=\"http://schema.org/availableLanguage\">availableLanguage</a>."@en ;
    rdfs:domain <http://schema.org/CreativeWork> ;
    rdfs:isDefinedBy schema:inLanguage ;
    rdfs:range [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Language> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/Text> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://schema.org/URL> ;
                                    rdf:rest () ] ] ] ] .

<http://schema.org/publisher> a owl:ObjectProperty ;
    rdfs:label "publisher"@en ;
    rdfs:comment "The publisher of the creative work."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/CreativeWork> ;
                    rdf:rest () ] ] ;
    rdfs:isDefinedBy schema:publisher ;
    rdfs:range [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Organization> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/Person> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://schema.org/Text> ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first <http://schema.org/URL> ;
                                            rdf:rest () ] ] ] ] ] .

<http://semanticweb.cs.vu.nl/2009/11/sem/hasBeginTimeStamp> a owl:DatatypeProperty ;
    rdfs:label "hasBeginTimestamp" ;
    rdfs:comment "Has begin timestamp is used to indicate the beginning of a time interval. Omitting the hasBeginTimeStamp while stating a hasEndTimeStamp is interpreted as an open ended interval."@en ;
    rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/hasTimeStamp> .

<http://semanticweb.cs.vu.nl/2009/11/sem/hasEndTimeStamp> a owl:DatatypeProperty ;
    rdfs:label "hasEndTimestamp" ;
    rdfs:comment "Has end timestamp is used to indicate the end of a time interval. Omitting the hasEndTimeStamp while stating a hasBeginTimeStamp is interpreted as an open ended interval."@en ;
    rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/hasTimeStamp> .

<http://semanticweb.cs.vu.nl/2009/11/sem/subTypeOf> a owl:ObjectProperty ;
    rdfs:label "subtype of" ;
    rdfs:comment "The inverse property of hasSubType."@en ;
    rdfs:domain rdfs:Class ;
    rdfs:range rdfs:Class ;
    rdfs:subPropertyOf rdfs:subClassOf .

xsd:date a rdfs:Datatype .

skos:broadMatch a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

foaf:name a owl:AnnotationProperty .

<http://crimeanalytics.it/cem/CrimeAgainstPropertyAndPerson> a owl:Class ;
    rdfs:label "CrimeAgainstPropertyAndPerson"@en ;
    rdfs:comment "Acts against property involving violence or threat against a person"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://crimeanalytics.it/cem/CrimeAgainstPublicOrder> a owl:Class ;
    rdfs:label "CrimeAgainstPublicOrder"@en ;
    rdfs:comment "Acts against public order, authority, and provisions of the State"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://crimeanalytics.it/cem/CrimeProceeds> a owl:Class ;
    rdfs:label "CrimeProceeds"@en ;
    rdfs:comment "Acts involving proceeds of crime"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeWithDeception> .

<http://crimeanalytics.it/cem/Robbery> a owl:Class ;
    rdfs:label "Robbery"@en ;
    rdfs:comment "Robbery"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://crimeanalytics.it/cem/hasWeapon> ;
            owl:someValuesFrom owl:Thing ],
        <http://crimeanalytics.it/cem/CrimeAgainstPropertyAndPerson> .

<http://crimeanalytics.it/cem/Theft> a owl:Class ;
    rdfs:label "Theft"@en ;
    rdfs:comment "Theft"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://crimeanalytics.it/cem/hasStolenObject> ;
            owl:someValuesFrom owl:Thing ],
        <http://crimeanalytics.it/cem/CrimeAgainstProperty> .

<http://crimeanalytics.it/cem/hasAuthor> a owl:ObjectProperty ;
    rdfs:label "hasAuthor"@en ;
    rdfs:comment "Used to state the author(s) of the crime event."@en ;
    rdfs:domain <http://crimeanalytics.it/cem/CrimeEvent> ;
    rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Actor> ;
    rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/hasActor> .

<http://crimeanalytics.it/cem/hasOtherSubject> a owl:ObjectProperty ;
    rdfs:label "hasOtherSubject"@en ;
    rdfs:comment "Used to state other subject(s) involved in the crime event (e.g., law enforcement agencies)."@en ;
    rdfs:domain <http://crimeanalytics.it/cem/CrimeEvent> ;
    rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Actor> ;
    rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/hasActor> .

<http://crimeanalytics.it/cem/hasStolenObject> a owl:ObjectProperty ;
    rdfs:label "has stolen object(s)"@en ;
    rdfs:comment "Property to express the stolen object(s) in a theft."@en ;
    rdfs:domain <http://crimeanalytics.it/cem/Theft> ;
    rdfs:range owl:Thing .

<http://crimeanalytics.it/cem/hasVictim> a owl:ObjectProperty ;
    rdfs:label "hasVictim"@en ;
    rdfs:comment "Used to state the victim(s) of the crime event."@en ;
    rdfs:domain <http://crimeanalytics.it/cem/CrimeEvent> ;
    rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Actor> ;
    rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/hasActor> .

<http://crimeanalytics.it/cem/hasWeapon> a owl:ObjectProperty ;
    rdfs:label "hasWeapon"@en ;
    rdfs:comment "Property to express the weapon(s) used in a robbery."@en ;
    rdfs:domain <http://crimeanalytics.it/cem/Robbery> ;
    rdfs:range owl:Thing .

<http://crimeanalytics.it/cem/success> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "success"@en ;
    rdfs:comment "Property to manifest if the crime event has been successful."@en ;
    rdfs:domain <http://crimeanalytics.it/cem/CrimeEvent> ;
    rdfs:range xsd:boolean .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

<http://schema.org/articleBody> a owl:ObjectProperty ;
    rdfs:label "articleBody"@en ;
    rdfs:comment "The actual body of the article."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Article> ;
                    rdf:rest () ] ] ;
    rdfs:isDefinedBy schema:articleBody ;
    rdfs:range [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Text> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/URL> ;
                            rdf:rest () ] ] ] .

<http://schema.org/containedInPlace> a owl:ObjectProperty ;
    rdfs:label "containedInPlace"@en ;
    rdfs:comment "The basic containment relation between a place and one that contains it."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Place> ;
                    rdf:rest () ] ] ;
    rdfs:isDefinedBy schema:containedInPlace ;
    rdfs:range [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Place> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/Text> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://schema.org/URL> ;
                                    rdf:rest () ] ] ] ] ;
    owl:inverseOf <http://schema.org/containsPlace> .

<http://schema.org/datePublished> a owl:ObjectProperty ;
    rdfs:label "datePublished"@en ;
    rdfs:comment "Date of first broadcast/publication."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/CreativeWork> ;
                    rdf:rest () ] ] ;
    rdfs:isDefinedBy schema:datePublished ;
    rdfs:range [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Date> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/DateTime> ;
                            rdf:rest () ] ] ] .

<http://schema.org/headline> a owl:ObjectProperty ;
    rdfs:label "headline"@en ;
    rdfs:comment "Headline of the article."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/CreativeWork> ;
                    rdf:rest () ] ] ;
    rdfs:isDefinedBy schema:headline ;
    rdfs:range [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Text> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/URL> ;
                            rdf:rest () ] ] ] .

<http://schema.org/mentions> a owl:ObjectProperty ;
    rdfs:label "mentions"@en ;
    rdfs:comment "Indicates that the CreativeWork contains a reference to, but is not necessarily about a concept."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/CreativeWork> ;
                    rdf:rest () ] ] ;
    rdfs:isDefinedBy schema:mentions ;
    rdfs:range [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Text> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/Thing> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://schema.org/URL> ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first owl:Thing ;
                                            rdf:rest () ] ] ] ] ] .

<http://semanticweb.cs.vu.nl/2009/11/sem/hasPlace> a owl:ObjectProperty ;
    rdfs:label "hasPlace" ;
    rdfs:comment "Has place is used to state in which Place(s) an Event happened. Coordinates can be attached to the Place with the W3C Geospatial Vocabulary (http://www.w3.org/2005/Incubator/geo/XGR-geo-20071023/)." ;
    rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Place> ;
    rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty> ;
    skos:exactMatch <http://www.kulttuurisampo.fi/ebkr/place> ;
    skos:narrowMatch <http://linkedevents.org/ontology/inSpace> .

<http://semanticweb.cs.vu.nl/2009/11/sem/hasSubEvent> a owl:ObjectProperty ;
    rdfs:label "has subevent" ;
    rdfs:comment "Has subevent connects an Event to other Events that belong to it. This is a very generic property that does not mean the subevents fully define the superconcept or that there is any causal relationship." ;
    rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty> ;
    owl:inverseOf <http://semanticweb.cs.vu.nl/2009/11/sem/subEventOf> ;
    skos:exactMatch <http://purl.org/NET/c4dm/event.owl#sub_event> .

<http://semanticweb.cs.vu.nl/2009/11/sem/hasTime> a owl:ObjectProperty ;
    rdfs:label "has Time" ;
    rdfs:comment "Has time is used to indicate at which time an Event took place or when a property under the Temporary Constraint is valid. Has time points to a symbolic representation of time, which allows semantic relations between time resources. (see http://www.w3.org/TR/owl-time/)" ;
    rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Time> ;
    rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty> ;
    skos:broadMatch <http://linkedevents.org/ontology/atTime> .

rdfs:subClassOf a owl:ObjectProperty ;
    rdfs:label "subClassOf" ;
    rdfs:comment "The subject is a subclass of a class."@en ;
    rdfs:domain rdfs:Class ;
    rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema> ;
    rdfs:range rdfs:Class .

foaf:Organization a owl:Class .

<https://w3id.org/BLIND> a owl:NamedIndividual,
        foaf:Organization .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual,
        owl:Ontology ;
    rdfs:label "Crime Event Model (CEM)"@en ;
    dcterms:bibliographicCitation "BLIND" ;
    dcterms:contributor [ a foaf:Person ;
            foaf:name "BLIND" ],
        [ a foaf:Person ;
            foaf:name "BLIND" ] ;
    dcterms:created "2022-06-14"^^xsd:date ;
    dcterms:creator "BLIND" ;
    dcterms:description "A lightweight ontology to describe crime events"@en ;
    dcterms:identifier <https://w3id.org/CEMontology/>,
        "info:doi:10.13140/RG.2.2.18252.90243" ;
    dcterms:issued "2022-06-14"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:modified "2022-10-26"^^xsd:date ;
    dcterms:provenance onto: ;
    dcterms:publisher <https://w3id.org/BLIND> ;
    dcterms:title "Crime Event Model (CEM)"@en ;
    vann:preferredNamespacePrefix "cem" ;
    vann:preferredNamespaceUri "https://w3id.org/CEMontology/" ;
    rdfs:comment "-Version 1.1: Insertion of ontology descriptors to be inserted in Linked Open Vocabulary-Version 1: creation"@en,
        "The Crime Event Model is an ontology for the representation of crime events extracted from local newspapers. It could be employed for Crime Analysis purposes: extracting crime information from newspapers and enriching them with proper machine-readable semantics is a critical task to help law enforcement agencies at preventing crime, supporting criminal investigations and evaluating the action of law enforcement agencies themselves. The model is based on the fundamental 5W1H journalistic questions, that are Who?, What?, When?, Where?, Why? and How?. Another important requirement was the attempt to exploit existing knowledge graphs and ontologies such as the Simple Event Model (SEM) Ontology and the Schema.org data model for interoperability and interconnection."@en ;
    owl:versionIRI <http://crimeanalytics.it/cem-reference/cem.owl> ;
    owl:versionInfo 1.1 .

<http://crimeanalytics.it/cem/SexualCrime> a owl:Class ;
    rdfs:label "SexualCrime"@en ;
    rdfs:comment "Injurious acts of a sexual nature"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://crimeanalytics.it/cem/how> a owl:DatatypeProperty ;
    rdfs:label "how"@en ;
    rdfs:comment "Property to express how the crime event has been accomplished."@en ;
    rdfs:domain <http://crimeanalytics.it/cem/CrimeEvent> ;
    rdfs:range xsd:string .

<http://crimeanalytics.it/cem/why> a owl:DatatypeProperty ;
    rdfs:label "why"@en ;
    rdfs:comment "Property to express the crime event motive."@en ;
    rdfs:domain <http://crimeanalytics.it/cem/CrimeEvent> ;
    rdfs:range xsd:string .

<http://schema.org/Article> a owl:Class ;
    rdfs:label "Article"@en ;
    rdfs:comment "An article, such as a news article or piece of investigative report. Newspapers and magazines have articles of many different types and this is intended to cover them all."@en ;
    rdfs:subClassOf <http://schema.org/CreativeWork> .

<http://schema.org/Date> a owl:Class ;
    rdfs:label "Date"@en ;
    rdfs:comment "A date value in <a href=\"http://en.wikipedia.org/wiki/ISO_8601\">ISO 8601 date format</a>."@en ;
    rdfs:isDefinedBy schema:Date ;
    rdfs:subClassOf <http://schema.org/DataType> .

<http://schema.org/DateTime> a owl:Class ;
    rdfs:label "DateTime"@en ;
    rdfs:comment "A combination of date and time of day in the form [-]CCYY-MM-DDThh:mm:ss[Z|(+|-)hh:mm] (see Chapter 5.4 of ISO 8601)."@en ;
    rdfs:isDefinedBy schema:DateTime ;
    rdfs:subClassOf <http://schema.org/DataType> .

<http://schema.org/Organization> a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "An organization such as a school, NGO, corporation, club, etc."@en ;
    rdfs:subClassOf <http://schema.org/Thing> .

<http://schema.org/Person> a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A person (alive, dead, undead, or fictional)."@en ;
    rdfs:subClassOf <http://schema.org/Thing> .

<http://schema.org/containsPlace> a owl:ObjectProperty ;
    rdfs:label "containsPlace"@en ;
    rdfs:comment "Inverse property of containedInPlace."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Place> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/Text> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://schema.org/URL> ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first <http://schema.org/Place> ;
                    rdf:rest () ] ] .

<http://semanticweb.cs.vu.nl/2009/11/sem/Time> a owl:Class ;
    rdfs:label "Time" ;
    rdfs:comment "Time contains symbolic representations of when an Event took place. Time instances do not necessarily need to have a timestamp associated with them. The Time class exists to represent semantics of time, e.g. that one thing happens before another, even though the exact timestamps are unknown." ;
    rdfs:subClassOf <http://semanticweb.cs.vu.nl/2009/11/sem/Core> ;
    skos:broadMatch <http://www.w3.org/2006/timeTemporalEntity> .

<http://semanticweb.cs.vu.nl/2009/11/sem/subEventOf> a owl:ObjectProperty ;
    rdfs:label "subevent of" ;
    rdfs:comment "Inverse property of hasSubEvent" ;
    rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Event> .

foaf:Person a owl:Class .

<http://crimeanalytics.it/cem/CrimeAgainstProperty> a owl:Class ;
    rdfs:label "CrimeAgainstProperty"@en ;
    rdfs:comment "Acts against property only"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://schema.org/DataType> a owl:Class ;
    rdfs:label "DataType"@en ;
    rdfs:comment "The basic data types such as Integers, Strings, etc."@en ;
    owl:disjointWith <http://semanticweb.cs.vu.nl/2009/11/sem/Core> .

<http://schema.org/Language> a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:comment "Natural languages such as Spanish, Tamil, Hindi, English, etc. Formal language code tags expressed in BCP 47 can be used via the alternateName property. The Language type previously also covered programming languages such as Scheme and Lisp, which are now best represented using ComputerLanguage."@en ;
    rdfs:subClassOf <http://schema.org/Thing> .

<http://semanticweb.cs.vu.nl/2009/11/sem/hasTimeStamp> a owl:DatatypeProperty ;
    rdfs:label "hasTimestamp" ;
    rdfs:comment "Has timestamp is used to put time indicators on any individual. It is the most common way to state when an Event took place. There are subproperties of hasTimeStamp to represent time intervals and uncertain time intervals. If the exact moment is not known, but it is necessary to specify a certain time, use hasTime instead. All of these properties are also used to indicate the time at which a property under the Temporary Constraint is valid."@en ;
    rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:range xsd:dateTimeStamp ;
    skos:closeMatch <http://www.kulttuurisampo.fi/ebkr/time> .

<http://crimeanalytics.it/cem/CrimeWithDeception> a owl:Class ;
    rdfs:label "CrimeWithDeception"@en ;
    rdfs:comment "Acts involving fraud, deception or corruption"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://schema.org/Place> a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "Entities that have a somewhat fixed, physical extension."@en ;
    rdfs:subClassOf <http://schema.org/Thing> ;
    owl:equivalentClass <http://semanticweb.cs.vu.nl/2009/11/sem/Place> .

<http://semanticweb.cs.vu.nl/2009/11/sem/Place> a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "Places are locations where an Event happens. They do not need to be physical places and hence do not necessarily need coordinates. Neither do they need to have any significance apart from them being the location of an Event." ;
    rdfs:subClassOf <http://semanticweb.cs.vu.nl/2009/11/sem/Core> ;
    skos:closeMatch dcterms:Location,
        <http://sw.opencyc.org/2009/04/07/concept/en/EnduringThing-Localized>,
        <http://www.ontologyportal.org/translations/SUMO.owl.txt#GeographicArea>,
        <http://www8.informatik.uni-erlangen.de/IMMD8/Services/cidoc-crm/erlangen-crm_090330_5_0_1.owl#E53.Place> ;
    skos:narrowMatch <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#PhysicalRegion>,
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

<http://semanticweb.cs.vu.nl/2009/11/sem/hasActor> a owl:ObjectProperty ;
    rdfs:label "hasActor" ;
    rdfs:comment "Has actor is used to state which Actors or Objects participate in an Event."@en ;
    rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Actor> ;
    rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty> ;
    skos:exactMatch <http://linkedevents.org/ontology/involved> ;
    skos:narrowMatch <http://www.kulttuurisampo.fi/ebkr/agent> .

<http://crimeanalytics.it/cem/CrimeAgainstPerson> a owl:Class ;
    rdfs:label "CrimeAgainstPerson"@en ;
    rdfs:comment "Acts causing harm or intending to cause harm to the person"@en ;
    rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeEvent> .

<http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty> a owl:ObjectProperty ;
    rdfs:label "eventProperty" ;
    rdfs:comment "Event properties connect Events to other SEM Core entities."@en ;
    rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
    rdfs:range rdfs:Class .

rdfs:Class a owl:Class .

<http://semanticweb.cs.vu.nl/2009/11/sem/Core> a owl:Class ;
    rdfs:label "Core" ;
    rdfs:comment "The SEM Core class contains all entities that make up the context of an event: Events, Actors, Places, Times. This class is meant to be extended for each application domain." .

<http://schema.org/Thing> a owl:Class ;
    rdfs:label "Thing"@en ;
    rdfs:comment "The most generic type of item."@en ;
    owl:equivalentClass owl:Thing .

<http://schema.org/CreativeWork> a owl:Class ;
    rdfs:label "CreativeWork"@en ;
    rdfs:comment "The most generic kind of creative work, including books, movies, photographs, software programs, etc."@en ;
    rdfs:subClassOf <http://schema.org/Thing> .

<http://schema.org/URL> a owl:Class ;
    rdfs:label "URL"@en ;
    rdfs:comment "Data type: URL."@en ;
    rdfs:subClassOf <http://schema.org/Text> .

<http://semanticweb.cs.vu.nl/2009/11/sem/Actor> a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "Actors are entities that take part in an Event, either actively or passively. Actors do not necessarily have to be sentient. They can also be objects. Actors are a thing, animate or inanimate, physical or non-physical." ;
    rdfs:subClassOf <http://semanticweb.cs.vu.nl/2009/11/sem/Core> ;
    skos:broadMatch <http://sw.opencyc.org/2009/04/07/concept/en/SomethingExisting>,
        <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#endurant> ;
    skos:closeMatch dcterms:Agent,
        dcterms:AgentClass,
        <http://sw.opencyc.org/2009/04/07/concept/en/Agent-Generic>,
        <http://www.ontologyportal.org/translations/SUMO.owl.txt#Agent>,
        <http://www8.informatik.uni-erlangen.de/IMMD8/Services/cidoc-crm/erlangen-crm_090330_5_0_1.owl#E39.Actor>,
        foaf:Agent .

<http://schema.org/Text> a owl:Class ;
    rdfs:label "Text"@en ;
    rdfs:comment "Data type: Text."@en ;
    rdfs:isDefinedBy schema:Text ;
    rdfs:subClassOf <http://schema.org/DataType> .

<http://semanticweb.cs.vu.nl/2009/11/sem/Event> a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "Events are things that happen. This comprises everything from historical events to web site sessions and mythical journeys. Event is the central class of SEM." ;
    rdfs:subClassOf <http://semanticweb.cs.vu.nl/2009/11/sem/Core> ;
    skos:broadMatch <http://linkedevents.org/ontology/Event>,
        <http://purl.org/NET/c4dm/event.owl#Event> ;
    skos:closeMatch dcmitype:Event,
        <http://sw.opencyc.org/2009/04/07/concept/en/Situation>,
        <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#perdurant>,
        <http://www.ontologyportal.org/translations/SUMO.owl.txt#Process>,
        <http://www8.informatik.uni-erlangen.de/IMMD8/Services/cidoc-crm/erlangen-crm_090330_5_0_1.owl#E5.Event> .

<http://crimeanalytics.it/cem/CrimeEvent> a owl:Class ;
    rdfs:label "CrimeEvent"@en ;
    rdfs:comment "Event subclass to express the crime event."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://crimeanalytics.it/cem/why> ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty <http://crimeanalytics.it/cem/hasVictim> ;
            owl:someValuesFrom <http://semanticweb.cs.vu.nl/2009/11/sem/Actor> ],
        [ a owl:Restriction ;
            owl:onProperty <http://crimeanalytics.it/cem/hasAuthor> ;
            owl:someValuesFrom <http://semanticweb.cs.vu.nl/2009/11/sem/Actor> ],
        [ a owl:Restriction ;
            owl:onProperty <http://crimeanalytics.it/cem/hasOtherSubject> ;
            owl:someValuesFrom <http://semanticweb.cs.vu.nl/2009/11/sem/Actor> ],
        [ a owl:Restriction ;
            owl:onProperty <http://crimeanalytics.it/cem/how> ;
            owl:someValuesFrom xsd:string ],
        <http://semanticweb.cs.vu.nl/2009/11/sem/Event> .

[] a owl:AllDisjointClasses ;
    owl:members [ a rdf:List ;
            rdf:first <http://schema.org/Date> ;
            rdf:rest [ a rdf:List ;
                    rdf:first <http://schema.org/DateTime> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/Text> ;
                            rdf:rest () ] ] ] .

[] a owl:AllDisjointClasses ;
    owl:members [ a rdf:List ;
            rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/Actor> ;
            rdf:rest [ a rdf:List ;
                    rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/Event> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/Place> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/Time> ;
                                    rdf:rest () ] ] ] ] .

[] a owl:AllDisjointClasses ;
    owl:members [ a rdf:List ;
            rdf:first <http://schema.org/CreativeWork> ;
            rdf:rest [ a rdf:List ;
                    rdf:first <http://schema.org/Language> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/Core> ;
                            rdf:rest () ] ] ] .

[] a owl:AllDisjointProperties ;
    owl:members [ a rdf:List ;
            rdf:first <http://crimeanalytics.it/cem/how> ;
            rdf:rest [ a rdf:List ;
                    rdf:first <http://crimeanalytics.it/cem/success> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://crimeanalytics.it/cem/why> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/hasTimeStamp> ;
                                    rdf:rest () ] ] ] ] .

[] a owl:AllDisjointProperties ;
    owl:members [ a rdf:List ;
            rdf:first <http://schema.org/articleBody> ;
            rdf:rest [ a rdf:List ;
                    rdf:first <http://schema.org/containedInPlace> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/containsPlace> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://schema.org/datePublished> ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first <http://schema.org/headline> ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty> ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/subEventOf> ;
                                                            rdf:rest () ] ] ] ] ] ] ] .

[] a owl:AllDisjointProperties ;
    owl:members [ a rdf:List ;
            rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/hasActor> ;
            rdf:rest [ a rdf:List ;
                    rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/hasPlace> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/hasSubEvent> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/hasTime> ;
                                    rdf:rest () ] ] ] ] .

[] a owl:AllDisjointClasses ;
    owl:members [ a rdf:List ;
            rdf:first <http://schema.org/CreativeWork> ;
            rdf:rest [ a rdf:List ;
                    rdf:first <http://schema.org/Language> ;
                    rdf:rest [ a rdf:List ;
                            rdf:first <http://schema.org/Organization> ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first <http://schema.org/Person> ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first <http://semanticweb.cs.vu.nl/2009/11/sem/Place> ;
                                            rdf:rest () ] ] ] ] ] .

