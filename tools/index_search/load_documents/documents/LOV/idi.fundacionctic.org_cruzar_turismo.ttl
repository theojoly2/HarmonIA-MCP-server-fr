ns2:temporal-region a owl:Class ;
    owl:disjointWith <http://www.loa-cnr.it/ontologies/Collectives#social-type-collective>,
        ns5:geographical-object,
        ns2:event,
        ns2:quality,
        ns4:course,
        ns4:social-role,
        <http://www.loa-cnr.it/ontologies/Plans#plan-execution> .

ns1:Interes-turistico a owl:Class ;
    rdfs:subClassOf ns2:quality .

ns1:Visita-turistica a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:setting ;
            owl:someValuesFrom ns1:Ruta-turistica ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Visita-turistica ;
            owl:onProperty ns3:precedes ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Evento-de-zaragoza ;
            owl:onProperty ns3:temporally-coincides ],
        [ a owl:Restriction ;
            owl:onProperty <http://www.loa-cnr.it/ontologies/FunctionalParticipation#target> ;
            owl:someValuesFrom ns1:Recurso-de-zaragoza ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.loa-cnr.it/ontologies/FunctionalParticipation#target> ],
        [ a owl:Restriction ;
            owl:onProperty ns5:happens-at ;
            owl:someValuesFrom ns1:Dia-de-visita-turistica ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns3:follows ;
                        owl:someValuesFrom ns1:Visita-turistica ] [ a owl:Restriction ;
                        owl:onProperty ns3:precedes ;
                        owl:someValuesFrom ns1:Visita-turistica ] ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Visita-turistica ;
            owl:onProperty ns3:follows ],
        ns4:activity .

ns1:Preferencia-de-usuario a owl:Class ;
    rdfs:subClassOf ns4:course .

