@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix onto: <http://www.opengis.net/ont/gml> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

geo:Feature rdfs:isDefinedBy onto: .

geo:SpatialObject rdfs:isDefinedBy onto: .

<http://www.opengis.net/ont/gml#ArcByBulge> a owl:Class ;
    rdfs:label "Arc by Bulge"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#ArcStringByBulge> .

<http://www.opengis.net/ont/gml#Bezier> a owl:Class ;
    rdfs:label "Bezier"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#BSpline> .

<http://www.opengis.net/ont/gml#Circle> a owl:Class ;
    rdfs:label "Circle"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Arc> .

<http://www.opengis.net/ont/gml#CircleByCenterPoint> a owl:Class ;
    rdfs:label "CircleByCenterPoint"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#ArcByCenterPoint> .

<http://www.opengis.net/ont/gml#Clothoid> a owl:Class ;
    rdfs:label "Clothoid"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#CompositeSolid> a owl:Class ;
    rdfs:label "Composite Solid"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Composite>,
        <http://www.opengis.net/ont/gml#Solid> .

<http://www.opengis.net/ont/gml#Cone> a owl:Class ;
    rdfs:label "Cone"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGriddedSurface> .

<http://www.opengis.net/ont/gml#CubicSpline> a owl:Class ;
    rdfs:label "Cubic Spline"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#PolynomialSpline> .

<http://www.opengis.net/ont/gml#Curve> a owl:Class ;
    rdfs:label "Curve"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometricPrimitive>,
        <http://www.opengis.net/ont/gml#OrientableCurve> .

<http://www.opengis.net/ont/gml#Cylinder> a owl:Class ;
    rdfs:label "Cylinder"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGriddedSurface> .

<http://www.opengis.net/ont/gml#Geodesic> a owl:Class ;
    rdfs:label "Geodesic"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#GeodesicString> .

<http://www.opengis.net/ont/gml#LineString> a owl:Class ;
    rdfs:label "Line String"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#LineStringSegment> .

<http://www.opengis.net/ont/gml#LinearRing> a owl:Class ;
    rdfs:label "Linear Ring"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Ring> .

<http://www.opengis.net/ont/gml#MultiCurve> a owl:Class ;
    rdfs:label "Multi-Curve"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#MultiGeometry> .

<http://www.opengis.net/ont/gml#MultiPoint> a owl:Class ;
    rdfs:label "Multi-Point"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#MultiGeometry> .

<http://www.opengis.net/ont/gml#MultiSolid> a owl:Class ;
    rdfs:label "Multi-Solid"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#MultiGeometry> .

<http://www.opengis.net/ont/gml#MultiSurface> a owl:Class ;
    rdfs:label "Multi-Surface"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#MultiGeometry> .

<http://www.opengis.net/ont/gml#OffsetCurve> a owl:Class ;
    rdfs:label "Offset Curve"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#Point> a owl:Class ;
    rdfs:label "Point"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometricPrimitive> .

<http://www.opengis.net/ont/gml#Polygon> a owl:Class ;
    rdfs:label "Polygon"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Surface> .

<http://www.opengis.net/ont/gml#Rectangle> a owl:Class ;
    rdfs:label "Rectangle"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#PolygonPatch> .

<http://www.opengis.net/ont/gml#Shell> a owl:Class ;
    rdfs:label "Shell"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#CompositeSurface> .

<http://www.opengis.net/ont/gml#Sphere> a owl:Class ;
    rdfs:label "Sphere"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGriddedSurface> .

<http://www.opengis.net/ont/gml#Tin> a owl:Class ;
    rdfs:label "Triangulated Irregular Network"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#TriangulatedSurface> .

<http://www.opengis.net/ont/gml#Triangle> a owl:Class ;
    rdfs:label "Triangle"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#PolygonPatch> .

<http://www.opengis.net/ont/gml#AbstractParametricCurveSurface> a owl:Class ;
    rdfs:label "Abstract Parametric Curve Surface"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractSurfacePatch> .

<http://www.opengis.net/ont/gml#Arc> a owl:Class ;
    rdfs:label "Arc"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#ArcString> .

<http://www.opengis.net/ont/gml#ArcByCenterPoint> a owl:Class ;
    rdfs:label "Arc by Center Point"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#ArcString> a owl:Class ;
    rdfs:label "Arc String"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#ArcStringByBulge> a owl:Class ;
    rdfs:label "Arc String by Bulge"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#BSpline> a owl:Class ;
    rdfs:label "BSpline"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#SplineCurve> .

<http://www.opengis.net/ont/gml#CompositeCurve> a owl:Class ;
    rdfs:label "Composite Curve"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Composite>,
        <http://www.opengis.net/ont/gml#OrientableCurve> .

<http://www.opengis.net/ont/gml#CompositeSurface> a owl:Class ;
    rdfs:label "Composite Surface"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Composite>,
        <http://www.opengis.net/ont/gml#OrientableSurface> .

<http://www.opengis.net/ont/gml#GeodesicString> a owl:Class ;
    rdfs:label "Geodesic String"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#GeometricComplex> a owl:Class ;
    rdfs:label "Geometric Complex"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometry> .

<http://www.opengis.net/ont/gml#LineStringSegment> a owl:Class ;
    rdfs:label "Line String Segment"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#PolyhedralSurface> a owl:Class ;
    rdfs:label "Polyhedral Surface"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#Surface> .

<http://www.opengis.net/ont/gml#PolynomialSpline> a owl:Class ;
    rdfs:label "Polynomial Spline"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#SplineCurve> .

<http://www.opengis.net/ont/gml#Ring> a owl:Class ;
    rdfs:label "Ring"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#CompositeCurve> .

<http://www.opengis.net/ont/gml#Solid> a owl:Class ;
    rdfs:label "Solid"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometricPrimitive> .

<http://www.opengis.net/ont/gml#TriangulatedSurface> a owl:Class ;
    rdfs:label "Triangulated Surface"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#PolyhedralSurface> .

<http://www.opengis.net/ont/gml#AbstractSurfacePatch> a owl:Class ;
    rdfs:label "Abstract Surface Patch"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf geo:Geometry .

<http://www.opengis.net/ont/gml#OrientableCurve> a owl:Class ;
    rdfs:label "Orientable Curve"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometricPrimitive> .

<http://www.opengis.net/ont/gml#OrientableSurface> a owl:Class ;
    rdfs:label "Orientable Surface"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometricPrimitive> .

<http://www.opengis.net/ont/gml#PolygonPatch> a owl:Class ;
    rdfs:label "Polygon Patch"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractSurfacePatch> .

<http://www.opengis.net/ont/gml#SplineCurve> a owl:Class ;
    rdfs:label "Spline Curve"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractCurveSegment> .

<http://www.opengis.net/ont/gml#Surface> a owl:Class ;
    rdfs:label "Surface"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometricPrimitive>,
        <http://www.opengis.net/ont/gml#OrientableSurface> .

geo:Geometry rdfs:isDefinedBy onto: .

<http://www.opengis.net/ont/gml#AbstractGeometry> a owl:Class ;
    rdfs:label "Abstract Geometry"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf geo:Geometry .

<http://www.opengis.net/ont/gml#AbstractGriddedSurface> a owl:Class ;
    rdfs:label "Abstract Gridded Surface"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractParametricCurveSurface> .

<http://www.opengis.net/ont/gml#Composite> a owl:Class ;
    rdfs:label "Composite"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#GeometricComplex> .

<http://www.opengis.net/ont/gml#MultiGeometry> a owl:Class ;
    rdfs:label "Multi-Geometry"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometry> .

<http://www.opengis.net/ont/gml#AbstractGeometricPrimitive> a owl:Class ;
    rdfs:label "Abstract Geometric Primitive"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.opengis.net/ont/gml#AbstractGeometry> .

<http://www.opengis.net/ont/gml#AbstractCurveSegment> a owl:Class ;
    rdfs:label "Abstract Curve Segment"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf geo:Geometry .

onto: a owl:Ontology ;
    owl:imports <http://www.opengis.net/ont/geosparql> .

