@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://protege.stanford.edu/plugins/owl/protege#> .
@prefix ns2: <http://semanticscience.org/resource/> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix onto: <http://ontology.cybershare.utep.edu/ELSEWeb/mappings/elseweb-mappings.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Characteristic> rdfs:subClassOf <http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Characteristic>,
        ns2:SIO_000614 .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#DatasetManifestation> a owl:Class ;
    rdfs:subClassOf dcat:Distribution .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Entity> rdfs:subClassOf <http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Entity>,
        ns2:SIO_000776 .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Format> a owl:Class ;
    rdfs:subClassOf dcterms:MediaTypeOrExtent .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#GeographicRegion> a owl:Class ;
    ns2:example "America"^^xsd:string ;
    rdfs:subClassOf dcterms:Location .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#GeospatialDataset> a owl:Class ;
    rdfs:subClassOf dcat:Dataset .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Provider> a owl:Class ;
    rdfs:subClassOf prov:Agent .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Theme> a owl:Class ;
    rdfs:subClassOf skos:Concept .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#TimePeriod> a owl:Class ;
    rdfs:subClassOf dcterms:PeriodOfTime .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Unit> a owl:Class ;
    rdfs:subClassOf <http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Unit>,
        ns2:SIO_000074 .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#encodedInFormat> a owl:ObjectProperty ;
    rdfs:subPropertyOf dcat:mediaType .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasManifestation> rdfs:subPropertyOf dcat:distribution .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processing> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasAssociatedWith> rdfs:subPropertyOf prov:wasAssociatedWith .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasMeasuredBy> rdfs:subPropertyOf prov:wasGeneratedBy .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasModelledBy> rdfs:subPropertyOf prov:wasGeneratedBy .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ProjectionActivity> a owl:Class ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperServiceActivity> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingAlgorithm> rdfs:subClassOf ns2:SIO_000094 .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingParameter> rdfs:subClassOf ns2:SIO_000144 .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingParameters> rdfs:subClassOf ns2:SIO_000616 .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingSoftware> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperServiceAgent>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent>,
        ns2:SIO_000140 .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-service.owl#CardioSHAREActivity> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-service.owl#SADIActivity> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-service.owl#SADIService> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-service.owl#SHAREClient> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent> .

onto: a owl:Ontology ;
    ns3:license "http://creativecommons.org/licenses/by/3.0/"^^xsd:anyURI ;
    ns1:defaultLanguage "en" ;
    dc:contributor "Contributors are those that engage in discussions during the development of this ontology (in alphabetical order):\\nkarl benedict\\nluis garnica\\ncj grady\\nbill hudspeth\\ndeana pennington\\nsoren scott\\naimee stewart"^^xsd:string ;
    dc:creator "http://cybershare.utep.edu"^^xsd:anyURI,
        "ELSEWeb team"@en,
        "Natalia Villanueva-Rosales"@en,
        "Nicholas del Rio"@en ;
    dc:description "The ELSEWeb mappings ontology imports related upper level ontologies and vocabularies and aligns ELSEWeb ontologies to importec classes. This ontology provides support for the ELSEWeb project(http://elseweb.cybershare.utep.edu/).\\nwebsite: http://elseweb.cybershare.utep.edu/ontologies\\nemail: nvillanuevarosales@utep.edu\\n"@en ;
    dc:issued "2014-05-01"^^xsd:date ;
    dc:rights "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/3.0/]."^^xsd:string ;
    dc:title "ELSEWeb Mappings Ontology"@en ;
    dcterms:identifier "elseweb-mappings.owl" ;
    dcterms:modified "2015-09-24"^^xsd:date ;
    vann:preferredNamespacePrefix "elseweb-mappings"@en ;
    vann:preferredNamespaceUri "http://ontology.cybershare.utep.edu/ELSEWeb/"^^xsd:string ;
    rdfs:isDefinedBy <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-mappings.owl> ;
    owl:imports <http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-service.owl>,
        <http://semanticscience.org/ontology/sio.owl>,
        <http://www.w3.org/ns/dcat>,
        <http://www.w3.org/ns/prov-o#> ;
    owl:versionIRI <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-mappings.owl> ;
    owl:versionInfo "1.2"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperServiceActivity> a owl:Class ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperServiceAgent> a owl:Class ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent> .

dcterms:Location a owl:Class ;
    rdfs:label "location" .

dcterms:PeriodOfTime a owl:Class ;
    rdfs:label "period of time" .

skos:Concept a owl:Class ;
    rdfs:label "concept" .

prov:Agent a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity> a owl:Class ;
    rdfs:subClassOf prov:Activity .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent> a owl:Class ;
    rdfs:subClassOf prov:SoftwareAgent .

