@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix onto: <http://courseware.rkbexplorer.com/ontologies/courseware> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://courseware.rkbexplorer.com/ontologies/courseware#course-duration> a owl:DatatypeProperty ;
    rdfs:label "course duration" ;
    rdfs:comment "The total duration of the course (in hours)" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer .

<http://courseware.rkbexplorer.com/ontologies/courseware#course-objectives> a owl:DatatypeProperty ;
    rdfs:label "course objectives" ;
    rdfs:comment "The objectives of this course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://courseware.rkbexplorer.com/ontologies/courseware#detailed-description> a owl:DatatypeProperty ;
    rdfs:label "detailed description" ;
    rdfs:comment "A detailed description of the content conveyed within the course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-assessment-method> a owl:ObjectProperty ;
    rdfs:label "has assessment method" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://courseware.rkbexplorer.com/ontologies/courseware#Assessment-Method> .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-author> a owl:ObjectProperty ;
    rdfs:label "has author" ;
    rdfs:comment "A person which is involved with the creation of the course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.aktors.org/ontology/portal#Generic-Agent> .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-courseware> a owl:ObjectProperty ;
    rdfs:label "has courseware" ;
    rdfs:comment "Courseware used by the Resist-Course (reference texts, personal hand-outs, slides, etc)." ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.aktors.org/ontology/portal#Publication-Reference> .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-infrastructure-requirement> a owl:ObjectProperty ;
    rdfs:label "has infrastructure requirement" ;
    rdfs:comment "An infrastructure requirement that is needed to carry out the course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.aktors.org/ontology/portal#Technology> .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-instructor> a owl:ObjectProperty ;
    rdfs:label "has instructor" ;
    rdfs:comment "A person delivering tuition as part of the course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.aktors.org/ontology/portal#Person> .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-language> a owl:DatatypeProperty ;
    rdfs:label "has language" ;
    rdfs:comment "The language in which an item of abstract information is written, expressed or delivered." ;
    rdfs:domain <http://www.aktors.org/ontology/portal#Abstract-Information> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:language .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-prerequisite> a owl:ObjectProperty ;
    rdfs:label "has pre-requisite" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://courseware.rkbexplorer.com/ontologies/courseware#Pre-requisite> .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-rights> a owl:ObjectProperty ;
    rdfs:comment "This property describes the intellectual property rights and conditions of use for this learning object. " ;
    rdfs:domain <http://www.aktors.org/ontology/portal#Abstract-Information> ;
    rdfs:isDefinedBy onto: .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-rights-copyright> a owl:DatatypeProperty ;
    rdfs:comment "Whether copyright or other restrictions apply to the use of this learning resource." ;
    rdfs:domain <http://www.aktors.org/ontology/portal#Abstract-Information> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:DataRange ;
            owl:oneOf ( "false" "true" ) ] .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-rights-cost> a owl:DatatypeProperty ;
    rdfs:comment "Whether use of this learning resource requires payment" ;
    rdfs:domain <http://www.aktors.org/ontology/portal#Abstract-Information> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:DataRange ;
            owl:oneOf ( "false" "true" ) ] .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-rights-description> a owl:DatatypeProperty ;
    rdfs:comment "Comments on the conditions of use of this learning resource." ;
    rdfs:domain <http://www.aktors.org/ontology/portal#Abstract-Information> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-student-interaction-type> a owl:ObjectProperty ;
    rdfs:label "has student interaction type" ;
    rdfs:comment "Identifies a course as having the prescribed interaction type" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://courseware.rkbexplorer.com/ontologies/courseware#Student-Interaction-Type> .

<http://courseware.rkbexplorer.com/ontologies/courseware#has-title> a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "The title of this course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdfs:label .

<http://courseware.rkbexplorer.com/ontologies/courseware#hours-of-labs> a owl:DatatypeProperty ;
    rdfs:label "hours of labs" ;
    rdfs:comment "The total number of hours of laboratory sessions in this course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

<http://courseware.rkbexplorer.com/ontologies/courseware#hours-of-lectures> a owl:DatatypeProperty ;
    rdfs:label "hours of lectures" ;
    rdfs:comment "The total number of hours of lectures delivered in this course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

<http://courseware.rkbexplorer.com/ontologies/courseware#hours-of-personal-study> a owl:DatatypeProperty ;
    rdfs:label "hours of personal study" ;
    rdfs:comment "The total number of hours of personal study in this course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

<http://courseware.rkbexplorer.com/ontologies/courseware#involves-organization> a owl:ObjectProperty ;
    rdfs:label "involves organisation" ;
    rdfs:comment "The association of an organisation which is involved in delivering a course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.aktors.org/ontology/portal#Organization> .

<http://courseware.rkbexplorer.com/ontologies/courseware#is-taught-present> a owl:DatatypeProperty ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:DataRange ;
            owl:oneOf ( "false" "true" ) ] .

<http://courseware.rkbexplorer.com/ontologies/courseware#number-of-credits> a owl:DatatypeProperty ;
    rdfs:label "number of credits" ;
    rdfs:comment "The number of EU BS/MS program credits" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

<http://courseware.rkbexplorer.com/ontologies/courseware#submitted-by> a owl:ObjectProperty ;
    rdfs:label "submitted by" ;
    rdfs:comment "The ReSIST Project member who has submitted and is the point of contact for this course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.aktors.org/ontology/portal#Generic-Agent> .

<http://courseware.rkbexplorer.com/ontologies/courseware#taught-at> a owl:ObjectProperty ;
    rdfs:label "taught at" ;
    rdfs:comment "The organization at which this course is taught" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.aktors.org/ontology/portal#Organization> .

<http://courseware.rkbexplorer.com/ontologies/courseware#total-hours-engagement> a owl:DatatypeProperty ;
    rdfs:label "total hours of engagement" ;
    rdfs:comment "The total number of hours of engagement while undertaking this course" ;
    rdfs:domain <http://courseware.rkbexplorer.com/ontologies/courseware#Course> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

<http://courseware.rkbexplorer.com/ontologies/courseware#Assessment-Method> a owl:Class ;
    rdfs:label "Assessment Method" ;
    rdfs:comment "A method by which a student is assessed; instances of this class may include examination, coursework, etc." ;
    rdfs:isDefinedBy onto: .

<http://courseware.rkbexplorer.com/ontologies/courseware#Pre-requisite> a owl:Class ;
    rdfs:label "Pre-requisite" ;
    rdfs:comment "This class encapsulates a body of previous knowledge required to undertake a course." ;
    rdfs:isDefinedBy onto: .

<http://courseware.rkbexplorer.com/ontologies/courseware#Student-Interaction-Type> a owl:Class ;
    rdfs:label "Student Interaction Type" ;
    rdfs:comment "A type of interaction in which a student engages whilst undertaking a course; instances of this class may include lectures, laboratory sessions, and group or individual projects." ;
    rdfs:isDefinedBy onto: .

<http://courseware.rkbexplorer.com/ontologies/courseware#Course> a owl:Class ;
    rdfs:label "Course" ;
    rdfs:comment "This class encapsulates a course that is taught to students" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/portal#Abstract-Information> .

onto: a owl:Ontology ;
    rdfs:label "ReSIST Courseware Ontology" ;
    dc:created "2006-05-03" ;
    dc:creator "Bene Rodriguez",
        "Ian Millard" ;
    dc:description "The ReSIST Courseware Ontology represents the various eduacational courses and resources within the ReSIST project"@en ;
    dc:title "ReSIST Courseware Ontology"@en ;
    owl:imports <http://www.aktors.org/ontology/portal> ;
    owl:versionInfo "0.1" .

