dcmitype:Collection a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Collection"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Collection-001> ;
    dcterms:issued "2000-07-11" ;
    rdfs:comment "A collection is an aggregation of items. The term \\n\\t\\tcollection means that the resource is described as a \\n\\t\\tgroup; its parts may be separately described and navigated."@en-us ;
    rdfs:isDefinedBy dcmitype: .

dcmitype:Dataset a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Dataset"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Dataset-001> ;
    dcterms:issued "2000-07-11" ;
    rdfs:comment "A dataset is information encoded in a defined structure \\n\\t\\t(for example, lists, tables, and databases), intended to \\n\\t\\tbe useful for direct machine processing."@en-us ;
    rdfs:isDefinedBy dcmitype: .

dcmitype:InteractiveResource a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Interactive Resource"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#InteractiveResource-001> ;
    dcterms:issued "2000-07-11" ;
    rdfs:comment "An interactive resource is a resource which requires \\n\\t\\tinteraction from the user to be understood, executed, \\n\\t\\tor experienced. For example - forms on web pages, applets, \\n\\t\\tmultimedia learning objects, chat services, virtual \\n\\t\\treality."@en-us ;
    rdfs:isDefinedBy dcmitype: .

dcmitype:MovingImage a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Moving Image"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#MovingImage-001> ;
    dcterms:issued "2003-11-18" ;
    rdfs:comment "A series of visual representations that,\\n        when shown in succession, impart an impression\\n        of motion.  Examples of moving images are:\\n        animations, movies, television programs,\\n        videos, zoetropes, or visual output from\\n        a simulation."@en-us ;
    rdfs:isDefinedBy dcmitype: ;
    rdfs:subClassOf dcmitype:Image .

dcmitype:PhysicalObject a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Physical Object"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#PhysicalObject-001> ;
    dcterms:issued "2002-07-13" ;
    rdfs:comment "An inanimate, three-dimensional object or substance.  \\n\\t\\tFor example -- a computer, the great pyramid, a \\n\\t\\tsculpture.  Note that digital representations \\n\\t\\tof, or surrogates for, these things should use Image, \\n\\t\\tText or one of the other types."@en-us ;
    rdfs:isDefinedBy dcmitype: .

dcmitype:Service a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Service"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Service-001> ;
    dcterms:issued "2000-07-11" ;
    rdfs:comment "A service is a system that provides one or more \\n\\t\\tfunctions of value to the end-user. Examples include: \\n\\t\\ta photocopying service, a banking service, an \\n\\t\\tauthentication service, interlibrary loans, a Z39.50 \\n\\t\\tor Web server."@en-us ;
    rdfs:isDefinedBy dcmitype: .

dcmitype:Software a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Software"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Software-001> ;
    dcterms:issued "2000-07-11" ;
    rdfs:comment "Software is a computer program in source or \\n\\t\\tcompiled form which may be available for installation \\n\\t\\tnon-transiently on another machine. For software which \\n\\t\\texists only to create an interactive environment, use \\n\\t\\tinteractive instead."@en-us ;
    rdfs:isDefinedBy dcmitype: .

dcmitype:Sound a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sound"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Sound-001> ;
    dcterms:issued "2000-07-11" ;
    rdfs:comment "A sound is a resource whose content is primarily \\n\\t\\tintended to be rendered as audio. For example - a \\n\\t\\tmusic playback file format, an audio compact disc, \\n\\t\\tand recorded speech or sounds."@en-us ;
    rdfs:isDefinedBy dcmitype: .

dcmitype:StillImage a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Still Image"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#StillImage-001> ;
    dcterms:issued "2003-11-18" ;
    rdfs:comment "A static visual representation. Examples of\\n        still images are: paintings, drawings, graphic designs,\\n        plans and maps."@en-us ;
    rdfs:isDefinedBy dcmitype: ;
    rdfs:subClassOf dcmitype:Image .

dcmitype:Text a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Text"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Text-001> ;
    dcterms:issued "2000-07-11" ;
    rdfs:comment "A text is a resource whose content is primarily \\n\\t\\twords for reading. For example - books, letters, \\n\\t\\tdissertations, poems, newspapers, articles, \\n\\t\\tarchives of mailing lists. Note that facsimiles \\n\\t\\tor images of texts are still of the genre text."@en-us ;
    rdfs:isDefinedBy dcmitype: .

dc:description a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:source a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dc:type a owl:AnnotationProperty .

dcterms:hasVersion a owl:AnnotationProperty .

dcterms:isReferencedBy a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:requires a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dcterms:contributor <http://users.ics.forth.gr/~fafalios/>,
        <http://users.ics.forth.gr/~marketak/pages/aboutme.html>,
        <http://users.ics.forth.gr/~tzitzik/>,
        "Carlo Allocca",
        "Christina Lantzaki",
        "Michalis Mountantonakis",
        "Nikos Minadakis" ;
    dcterms:creator <http://users.ics.forth.gr/~fafalios/>,
        <http://users.ics.forth.gr/~marketak/pages/aboutme.html>,
        <http://users.ics.forth.gr/~mountant/>,
        <http://users.ics.forth.gr/~tzitzik/>,
        "Carlo Allocca",
        "Christina Lantzaki",
        "Nikos Minadakis" ;
    dcterms:description "An extension of W3C VoID that is able to represent these metrics for expressing the Connectivity Metrics of a Semantic Warehouse." ;
    dcterms:issued "2014-05-21"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:publisher <http://www.ics.forth.gr/isl> ;
    dcterms:rights "Copyright © FORTH ICS" ;
    dcterms:title "Void Warehouse Ontology" ;
    owl:versionInfo 1.0 .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#accordingTo> a owl:ObjectProperty ;
    rdfs:label "according To" ;
    rdfs:comment "A measurement is carried out by an agent using a specific metric accordingTo one (or more) configurations over one (or more) datasets. Therefore, this property links an instance of measurement class with an instance of configuation class." ;
    rdfs:domain <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement> ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    rdfs:range <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Configuration> ;
    ns1:term_status "Stable" .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#averageDegreeIncrement> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#carriedOutBy> a owl:ObjectProperty ;
    rdfs:comment "A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal).\\nTherefore, this property links an instance of measurement class with an instance of the Agent class." ;
    rdfs:domain <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement> ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    rdfs:range dcterms:Agent ;
    ns1:term_status "Stable" .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#commonLiterals> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#commonLiteralsPercentage> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#commonUris> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#commonUrisPercentage> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#complementarityFactor> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#entityMatching> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#URIEquivalence>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#exactStringEquality> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#URIEquivalence>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#suffixCanonicalization> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#URIEquivalence>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#uniqueTriples> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#uniqueTriplesPercentage> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
        owl:NamedIndividual .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#usesMetrics> a owl:ObjectProperty ;
    rdfs:label "uses Metrics" ;
    rdfs:comment "A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets. Therefore, this property links an instance of measurement class with an instance of metrics class." ;
    rdfs:domain <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement> ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    rdfs:range <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics> ;
    ns1:term_status "Stable" .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#usesSPARQLquery> a owl:DatatypeProperty ;
    rdfs:label "uses SPARQL query" ;
    rdfs:comment "This property specifies the entities of interest involved in a configuration by providing a SPARQL query that returns them." ;
    rdfs:domain <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#EntityConfiguration> ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "Stable" .

rdfs:isDefinedBy a owl:ObjectProperty ;
    rdfs:domain <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Configuration>,
        <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement> ;
    rdfs:range rdf:resource .

ns1:term_status a owl:AnnotationProperty .

ns2:status a owl:AnnotationProperty .

dcmitype:Event a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Event"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Event-001> ;
    dcterms:issued "2000-07-11" ;
    rdfs:comment "An event is a non-persistent, time-based occurrence. \\n\\t\\tMetadata for an event provides descriptive\\n\\t\\tinformation that is the basis for discovery of the\\n\\t\\tpurpose, location, duration, responsible agents, and\\n\\t\\tlinks to related events and resources.  The resource\\n\\t\\tof type event may not be retrievable if the described\\n\\t\\tinstantiation has expired or is yet to occur.\\n\\t\\tExamples - exhibition, web-cast, conference,\\n\\t\\tworkshop, open-day, performance, battle, trial,\\n\\t\\twedding, tea-party, conflagration."@en-us ;
    rdfs:isDefinedBy dcmitype: .

dcterms:Agent a owl:Class .

dcterms:TypeScheme a owl:Class .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#EntityConfiguration> a owl:Class ;
    rdfs:label "Entity Configuration" ;
    rdfs:comment "The notion of Configuration concerns issues that explain how the measurement was done. At this point, and for the requirements at hand, we need two subclasses: the first concerns the way URI equivalence is defined (see URIEquivalence class), while the second (the EntityConfiguration class) concerns how the entities of interest are defined. Regarding the latter the current modeling allows someone to specify the desired set of entities by providing a SPARQL query that returns them." ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    rdfs:subClassOf <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Configuration> ;
    ns1:term_status "Stable" .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#over> a owl:ObjectProperty ;
    rdfs:label "over" ;
    rdfs:comment "A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal). Therefore, this property links instances of Measurement class with instances of dataset class." ;
    rdfs:domain <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement> ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    rdfs:range void:Dataset ;
    ns1:term_status "Stable" .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#producesValue> a owl:DatatypeProperty ;
    rdfs:label "produces Value" ;
    rdfs:comment "A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets. Therefore, this property indicates the value produced by the measurement." ;
    rdfs:domain <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement> ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "Stable" .

rdf:resource a owl:Class .

dcmitype:Image a dcterms:DCMIType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Image"@en-us ;
    dc:type <http://dublincore.org/usage/documents/principles/#vocabulary-term> ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Image-002> ;
    dcterms:issued "2000-07-11" ;
    rdfs:comment "An image is a primarily symbolic visual representation \\n\\t\\tother than text. For example - images and photographs of \\n\\t\\tphysical objects, paintings, prints, drawings, other \\n\\t\\timages and graphics, animations and moving pictures, \\n\\t\\tfilm, diagrams, maps, musical notation. Note that image \\n\\t\\tmay include both electronic and physical representations."@en-us ;
    rdfs:isDefinedBy dcmitype: .

void:Dataset a owl:Class .

<http://users.ics.forth.gr/~fafalios/> a owl:NamedIndividual,
        foaf:Person .

<http://users.ics.forth.gr/~marketak/pages/aboutme.html> a owl:NamedIndividual,
        foaf:Person .

<http://users.ics.forth.gr/~tzitzik/> a owl:NamedIndividual,
        foaf:Person .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#URIEquivalence> a owl:Class ;
    rdfs:label "URI Equivalence" ;
    rdfs:comment "The notion of Configuration concerns issues that explain how the measurement was done. At this point, and for the requirements at hand, we need two subclasses: the first concerns the way URI equivalence is defined (see URIEquivalence class), while the second (the EntityConfiguration class) concerns how the entities of interest are defined. Regarding the latter the current modeling allows someone to specify the desired set of entities by providing a SPARQL query that returns them." ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    rdfs:subClassOf <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Configuration> ;
    ns1:term_status "Stable" .

foaf:Person a owl:Class .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Configuration> a owl:Class ;
    rdfs:label "Configuration"^^xsd:string ;
    rdfs:comment "Based on the fact that a measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal). The Configuration defines the polices with respect to a measurement is carried out. It defines polices about how to compare URIs and the configuration of an entity." ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    ns1:term_status "Stable"^^xsd:string .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement> a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "The notion of Measurement is actually a specialization of dc:Event and therefore inherits the property date. A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal)." ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#producesValue> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass void:Dataset ;
            owl:onProperty <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#over> ],
        dcmitype:Event ;
    ns2:status "Stable" .

<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics> a owl:Class ;
    rdfs:label "Metrics" ;
    rdfs:comment "A metric is an individual with a URI and is defined by a resource (e.g. the DOI of the scientific paper that defined that metric)." ;
    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl" ;
    ns1:term_status "stable" .

dcmitype: dc:description "The Dublin Core Types namespace provides URIs for the entries of the DCMI Type Vocabulary. Entries are declared using RDF Schema language to support RDF applications. The Schema will be updated according to dc-usage decisions."@en-us ;
    dc:language "English"@en-us ;
    dc:publisher "The Dublin Core Metadata Initiative"@en-us ;
    dc:source <http://dublincore.org/documents/dcmi-type-vocabulary/>,
        <http://dublincore.org/usage/terms/> ;
    dc:title "The DCMI Types namespace providing access to its content by means of an RDF Schema"@en-us ;
    dcterms:isReferencedBy dcterms: ;
    dcterms:issued "2000-07-11" ;
    dcterms:modified "2002-05-22" ;
    dcterms:requires <http://dublincore.org/documents/dcmi-type-vocabulary/>,
        dc: .

dcterms:DCMIType a dcterms:TypeScheme,
        owl:Class,
        owl:NamedIndividual ;
    dc:description "The DCMI Type Vocabulary provides a general, cross-domain list of\\n\\t    approved terms that may be used as values for the Resource Type\\n\\t    element to identify the genre of a resource." ;
    dcterms:issued "2000-07-11" .

