@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <https://w3id.org/riverbench/schema/documentation#> .
@prefix ns2: <http://schema.org/> .
@prefix onto: <https://w3id.org/riverbench/schema/documentation> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:conformsTo a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:isHiddenInDoc true .

dcterms:creator a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "10"^^xsd:int .

dcterms:description a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "1"^^xsd:int .

dcterms:identifier a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "2"^^xsd:int .

dcterms:issued a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "20"^^xsd:int .

dcterms:license a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "11"^^xsd:int .

dcterms:modified a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "21"^^xsd:int .

dcterms:rights a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "12"^^xsd:int .

dcterms:source a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "12"^^xsd:int .

dcterms:title a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "0"^^xsd:int .

<http://spdx.org/rdf/terms#checksum> a owl:AnnotationProperty ;
    ns1:hasDocWeight "2020"^^xsd:int .

rdf:type a owl:AnnotationProperty ;
    ns1:hasDocWeight "-1"^^xsd:int .

dcat:byteSize a owl:AnnotationProperty ;
    ns1:hasDocWeight "2001"^^xsd:int .

dcat:compressFormat a owl:AnnotationProperty ;
    ns1:hasDocWeight "2012"^^xsd:int .

dcat:dataset a owl:ObjectProperty ;
    ns1:hasDocGroup ns1:groupContent ;
    ns1:hasDocWeight "1000"^^xsd:int ;
    ns1:hasLabelOverride "Has dataset"@en .

dcat:distribution a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupDistributions ;
    ns1:hasDocWeight "6000"^^xsd:int .

dcat:downloadUrl a owl:AnnotationProperty ;
    ns1:hasDocWeight "2000"^^xsd:int .

dcat:inCatalog a owl:ObjectProperty ;
    rdfs:label "In suite"@en ;
    rdfs:comment "Indicates the benchmark suite to which a dataset or profile belongs"@en ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "60"^^xsd:int .

dcat:landingPage a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "30"^^xsd:int .

dcat:mediaType a owl:AnnotationProperty ;
    ns1:hasDocWeight "2010"^^xsd:int .

dcat:packageFormat a owl:AnnotationProperty ;
    ns1:hasDocWeight "2011"^^xsd:int .

dcat:seriesMember ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "50"^^xsd:int .

dcat:temporalResolution a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "3000"^^xsd:int .

dcat:theme a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "4"^^xsd:int .

dcat:themeTaxonomy a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "100"^^xsd:int .

foaf:homepage a owl:AnnotationProperty ;
    ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "20"^^xsd:int .

foaf:name a owl:AnnotationProperty ;
    ns1:hasDocWeight "0"^^xsd:int .

foaf:nick a owl:AnnotationProperty ;
    ns1:hasDocWeight "1"^^xsd:int .

onto: a owl:Ontology ;
    dc:description "Ontology with metadata needed to generate documentation of datasets, distributions, profiles, etc. in RiverBench"@en ;
    dc:title "RiverBench documentation ontology"@en ;
    dcterms:created "2023-04-30T00:00:00"^^xsd:dateTime ;
    dcterms:creator [ foaf:homepage <https://github.com/Ostrzyciel>,
                <https://orcid.org/0000-0002-2543-9461> ;
            foaf:name "Piotr Sowiński" ;
            foaf:nick "Ostrzyciel" ],
        "Piotr Sowiński"@en ;
    dcterms:issued "2023-05-05T00:00:00"^^xsd:dateTime ;
    dcterms:license <https://spdx.org/licenses/CC-BY-4.0> ;
    vann:preferredNamespacePrefix "rbdoc" ;
    vann:preferredNamespaceUri "https://w3id.org/riverbench/schema/documentation#" ;
    ns2:citation "Please cite this work according to the instructions here: https://w3id.org/riverbench/documentation/licensing/"@en ;
    owl:imports <https://w3id.org/riverbench/schema/metadata/dev> ;
    owl:versionIRI <https://w3id.org/riverbench/schema/documentation/dev> .

ns1:hasDocGroup a owl:AnnotationProperty ;
    rdfs:label "Has documentation group"@en ;
    rdfs:comment "Indicates the documentation group (heading) of a property"@en ;
    rdfs:range ns1:DocGroup ;
    ns1:isHiddenInDoc true .

ns1:hasDocWeight a owl:AnnotationProperty ;
    rdfs:label "Has documentation weight"@en ;
    rdfs:comment "Weight of a given property or item when generating documentation (integer). Properties or items with lower values will be shown first in the generated docs."@en ;
    rdfs:range xsd:int ;
    ns1:isHiddenInDoc true .

ns1:hasLabelOverride a owl:AnnotationProperty ;
    rdfs:label "Has label override"@en ;
    rdfs:comment "Top-priority label to be used in documentation pages."@en ;
    ns1:isHiddenInDoc true .

ns1:isHiddenInDoc a owl:AnnotationProperty ;
    rdfs:label "Is hidden in documentation"@en ;
    rdfs:comment "Whether a given property should be omitted in the generated documentation."@en ;
    rdfs:range xsd:boolean ;
    ns1:isHiddenInDoc true .

<https://w3id.org/riverbench/schema/metadata#conformsToRdf11> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1100"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#conformsToRdfStarDraft_20211217> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1110"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasDistributionType> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1000"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasFileName> ns1:hasDocWeight "12"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasProfile> ns1:hasDocGroup ns1:groupContent ;
    ns1:hasDocWeight "1001"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasRestriction> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "200"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasStatistics> ns1:hasDocWeight "2040"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasStreamElementCount> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1001"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasStreamElementSplit> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1002"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasStreamElementType> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1000"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasTemporalProperty> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1020"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#hasVersion> ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "3"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#isSubsetOfProfile> ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "21"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#isSupersetOfProfile> ns1:hasDocGroup ns1:groupGeneralInfo ;
    ns1:hasDocWeight "20"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#maximum> ns1:hasDocWeight "2105"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#mean> ns1:hasDocWeight "2102"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#minimum> ns1:hasDocWeight "2104"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#standardDeviation> ns1:hasDocWeight "2103"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#sum> ns1:hasDocWeight "2100"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#uniqueCount> ns1:hasDocWeight "2101"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#usesGeneralizedRdfDatasets> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1201"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#usesGeneralizedTriples> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1200"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#usesOntology> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1010"^^xsd:int .

<https://w3id.org/riverbench/schema/metadata#usesRdfStar> ns1:hasDocGroup ns1:groupTechnicalMetadata ;
    ns1:hasDocWeight "1210"^^xsd:int .

ns1:groupDistributions a owl:NamedIndividual,
        ns1:DocGroup ;
    rdfs:label "Distributions"@en .

ns1:groupContent a owl:NamedIndividual,
        ns1:DocGroup ;
    rdfs:label "Content"@en .

ns1:DocGroup a owl:Class ;
    rdfs:label "Documentation group"@en ;
    rdfs:comment "Documentation group, corresponding to a heading in the generated document."@en .

ns1:groupTechnicalMetadata a owl:NamedIndividual,
        ns1:DocGroup ;
    rdfs:label "Technical metadata"@en .

ns1:groupGeneralInfo a owl:NamedIndividual,
        ns1:DocGroup ;
    rdfs:label "General information"@en .

