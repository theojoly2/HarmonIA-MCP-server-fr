ns2:R2 a ns1:Variable .

ns2:M1 a ns1:Variable .

ns2:M2 a ns1:Variable .

ns2:valid a owl:DatatypeProperty ;
    rdfs:label "valid"@en ;
    rdfs:domain ns2:GSNElement ;
    rdfs:range xsd:boolean ;
    ns2:coreOrExtension "Core GSN"@en .

ns2:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns2:Argument ns2:AssuranceCase ns2:Module ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns2:Argument ns2:Artefact ns2:Module ) ] ;
    ns2:coreOrExtension "Core GSN"@en .

ns2:Module a owl:Class ;
    rdfs:label "Module"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:Module ;
            owl:onProperty ns2:inContextOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns2:Module ;
            owl:onProperty ns2:supportedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns2:Argument ns2:Module ) ] ;
            owl:onProperty ns2:contains ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns2:Argument ;
            owl:onProperty ns2:contains ],
        ns2:GSNElement ;
    skos:definition "Goal structures can be partitioned into separate, but interrelated, modules. This can allow the division of an overall goal structure into separate goal structures focusing on particular aspects of the overall argument. A module may contain one or more arguments and may contain other modules."@en ;
    ns2:coreOrExtension "Modular Extension"@en ;
    ns2:renderedAs "a rectangle with a second smaller rectangle adjoining at the top left" .

ns2:Goal a owl:Class ;
    rdfs:label "Goal"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:inContextOf ;
            owl:someValuesFrom ns2:Context ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns2:GSNElement ns2:Relationship ) ] ;
            owl:onProperty ns2:challenges ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns2:Goal ns2:Module ns2:Solution ns2:Strategy ) ] ;
            owl:onProperty ns2:supportedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns2:Assumption ns2:Context ns2:Justification ns2:Module ) ] ;
            owl:onProperty ns2:inContextOf ],
        _:Be37232b0c6d4f156bda5fcbddec12a5c,
        ns2:GSNElement ;
    skos:altLabel "Claim"@en ;
    skos:definition "(Claim is) A proposition being asserted by the author that is a true or false statement."@en,
        "A goal, rendered as a rectangle, presents a claim forming part of the argument."@en ;
    ns2:coreOrExtension "Core GSN"@en ;
    ns2:renderedAs "rectangle"@en .

ns2:supportedBy a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "supported by"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns2:Goal ns2:Strategy ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns2:Goal ns2:Module ns2:Solution ns2:Strategy ) ] ;
    skos:definition "SupportedBy, rendered as a line with a solid arrowhead, allows support relationships between elements to be documented."@en ;
    ns2:coreOrExtension "Core GSN"@en ;
    ns2:renderedAs "line with a solid arrowhead" .

