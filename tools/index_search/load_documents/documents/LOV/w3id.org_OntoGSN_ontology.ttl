ns2:inContextOf a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "in context of"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns2:Goal ns2:Strategy ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns2:Assumption ns2:Context ns2:Justification ns2:Module ) ] ;
    skos:definition "InContextOf, rendered as a line with a hollow arrowhead, declares a contextual relationship."@en ;
    ns2:coreOrExtension "Core GSN"@en ;
    ns2:renderedAs "line with a hollow arrowhead" .

ns2:R1 a ns1:Variable .

ns2:S a ns1:Variable .

ns2:G a ns1:Variable .

rdf:object a owl:ObjectProperty .

