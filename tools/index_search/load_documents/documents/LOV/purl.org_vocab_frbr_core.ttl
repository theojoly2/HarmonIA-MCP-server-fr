            dc:date "2005-08-10" ;
            rdf:value "Removed subclass of geo:SpatialThing" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Made subclass of geo:SpatialThing" ] .

<http://purl.org/vocab/frbr/core#Manifestation> a owl:Class ;
    rdfs:label "manifestation"@en ;
    dcterms:issued "2005-07-15" ;
    rdfs:comment "This class corresponds to the FRBR group one entity 'Manifestation'."@en ;
    rdfs:isDefinedBy onto: ;
