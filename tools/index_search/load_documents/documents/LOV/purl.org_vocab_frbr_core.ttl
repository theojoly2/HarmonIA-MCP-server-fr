<http://purl.org/vocab/frbr/core#Person> a owl:Class ;
    rdfs:label "person"@en ;
    dcterms:issued "2005-08-08" ;
    rdfs:comment "This class corresponds to the FRBR group two entity 'Person'."@en ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <http://purl.org/vocab/frbr/core#Endeavour>,
        <http://purl.org/vocab/frbr/core#Subject> ;
    owl:equivalentClass foaf:Person ;
    skos:changeNote [ dc:creator "Ian Davis" ;
            dc:date "2005-08-09" ;
            rdf:value "Extracted definition from existing comment" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Added comment" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Added isDefinedBy property referring to FRBR core namespace" ] ;
    skos:definition "A living or dead individual."@en .

<http://purl.org/vocab/frbr/core#ScholarlyWork> a owl:Class ;
