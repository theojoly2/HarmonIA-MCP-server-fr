<http://purl.org/vocab/frbr/core#subject> a owl:ObjectProperty ;
    rdfs:label "subject"@en ;
    dcterms:issued "2005-07-15" ;
    rdfs:domain <http://purl.org/vocab/frbr/core#Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/vocab/frbr/core#Endeavour> <http://purl.org/vocab/frbr/core#ResponsibleEntity> <http://purl.org/vocab/frbr/core#Subject> ) ] ;
