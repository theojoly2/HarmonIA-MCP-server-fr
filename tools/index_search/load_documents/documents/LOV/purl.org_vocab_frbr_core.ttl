        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Added isDefinedBy property referring to FRBR core namespace" ] ;
    skos:definition "Another endeavour that is related in some way to an endeavour."@en .

<http://purl.org/vocab/frbr/core#Work> a owl:Class ;
    rdfs:label "work"@en ;
    dcterms:issued "2005-07-15" ;
    rdfs:comment "This class corresponds to the FRBR group one entity 'Work'."@en ;
    rdfs:isDefinedBy onto: ;
