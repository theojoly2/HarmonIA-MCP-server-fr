dc:title a owl:DatatypeProperty .

dc:type a owl:AnnotationProperty .

dcterms:IMT a owl:Class .

dcterms:hasFormat a owl:ObjectProperty .

dcterms:isVersionOf a owl:AnnotationProperty .

dcterms:replaces a owl:AnnotationProperty .

<http://purl.org/vocab/frbr/core#ClassicalWork> a owl:Class ;
