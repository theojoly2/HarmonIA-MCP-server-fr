        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-09" ;
            rdf:value "Added definition" ] ;
    skos:definition "A transformation of a work or expression."@en ;
    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2005-08-10" ;
            rdf:value "Added domain and range of Work or Expression" ] .

<http://purl.org/vocab/frbr/core#transformationOf> a owl:ObjectProperty ;
