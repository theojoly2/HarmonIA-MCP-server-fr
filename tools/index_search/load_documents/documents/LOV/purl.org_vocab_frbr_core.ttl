    skos:historyNote [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Made subclass of wordnet:Work~2" ] .

<http://purl.org/vocab/frbr/core#Expression> a owl:Class ;
    rdfs:label "expression"@en ;
    dcterms:issued "2005-07-15" ;
    rdfs:comment "This class corresponds to the FRBR group one entity 'Expression'."@en ;
    rdfs:isDefinedBy onto: ;
