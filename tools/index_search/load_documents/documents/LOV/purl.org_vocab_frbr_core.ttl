<http://purl.org/vocab/frbr/core#CorporateBody> a owl:Class ;
    rdfs:label "corporate body"@en ;
    dcterms:issued "2005-07-15" ;
    rdfs:comment "This class corresponds to the FRBR group two entity 'Corporate Body'."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/vocab/frbr/core#ResponsibleEntity> ;
    owl:equivalentClass [ a owl:Class ;
            rdfs:label "the union of all organizations and groups"@en ;
            owl:unionOf ( foaf:Organization foaf:Group ) ] ;
