foaf:Person a owl:Class ;
    rdfs:subClassOf <http://purl.org/vocab/frbr/core#ResponsibleEntity> .

<http://purl.org/vocab/frbr/core#Subject> a owl:Class ;
    rdfs:label "subject"@en ;
    dcterms:issued "2005-07-15" ;
    rdfs:comment "This class represents any of the FRBR group three entities."@en ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <http://purl.org/vocab/frbr/core#Endeavour>,
        <http://purl.org/vocab/frbr/core#ResponsibleEntity> ;
    owl:equivalentClass [ a owl:Class ;
            rdfs:label "the union of all events, objects, places and concepts"@en ;
            owl:unionOf ( <http://purl.org/vocab/frbr/core#Event> <http://purl.org/vocab/frbr/core#Object> <http://purl.org/vocab/frbr/core#Place> <http://purl.org/vocab/frbr/core#Concept> ) ] ;
    skos:changeNote [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Added isDefinedBy property referring to FRBR core namespace" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-09" ;
            rdf:value "Extracted definition from existing comment" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Added comment" ] ;
    skos:definition "Something that may serve as the subject of a work."@en .

<http://purl.org/vocab/frbr/core#Endeavour> a owl:Class ;
    rdfs:label "endeavour"@en ;
    dcterms:issued "2005-07-15" ;
    rdfs:comment "This class represents any one of the FRBR group one entities."@en ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <http://purl.org/vocab/frbr/core#ResponsibleEntity>,
        <http://purl.org/vocab/frbr/core#Subject> ;
    owl:equivalentClass [ a owl:Class ;
            rdfs:label "the union of all expressions, items, manifestations and works"@en ;
            owl:unionOf ( <http://purl.org/vocab/frbr/core#Expression> <http://purl.org/vocab/frbr/core#Item> <http://purl.org/vocab/frbr/core#Manifestation> <http://purl.org/vocab/frbr/core#Work> ) ] ;
    skos:changeNote [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Added isDefinedBy property referring to FRBR core namespace" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-09" ;
            rdf:value "Extracted definition from existing comment" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Added comment" ] ;
    skos:definition "Any of the products of artistic or creative endeavour."@en .

<http://purl.org/vocab/frbr/core#ResponsibleEntity> a owl:Class ;
    rdfs:label "responsible entity"@en ;
    dcterms:issued "2005-07-15" ;
    rdfs:comment "This class represents any of the FRBR group two entities."@en ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <http://purl.org/vocab/frbr/core#Endeavour>,
        <http://purl.org/vocab/frbr/core#Subject> ;
    owl:equivalentClass [ a owl:Class ;
            rdfs:label "the union of all people and corporate bodies"@en ;
            owl:unionOf ( <http://purl.org/vocab/frbr/core#CorporateBody> foaf:Person ) ] ;
    skos:changeNote [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Added isDefinedBy property referring to FRBR core namespace" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-09" ;
            rdf:value "Extracted definition from existing comment" ],
        [ dc:creator "Ian Davis" ;
            dc:date "2005-08-08" ;
            rdf:value "Added comment" ] ;
    skos:definition "One responsible for the creation, production, distribution or maintenance of artistic or creative content."@en .

<http://purl.org/vocab/frbr/core#Item> a owl:Class ;
    rdfs:label "item"@en ;
    dcterms:issued "2005-07-15" ;
    rdfs:comment "This class corresponds to the FRBR group one entity 'Item'."@en ;
    rdfs:isDefinedBy onto: ;
