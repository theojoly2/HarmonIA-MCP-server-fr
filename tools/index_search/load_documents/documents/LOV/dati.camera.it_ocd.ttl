onto:votazioneFinale a owl:DatatypeProperty ;
    rdfs:label "votazione finale" ;
    rdfs:domain onto:votazione ;
    rdfs:range xsd:boolean ;
    owl:versionInfo "Questa proprietà è stata inserita nell'ultima versione del 2 maggio 2013"^^xsd:string .

onto:votazioneSegreta a owl:DatatypeProperty ;
    rdfs:label "votazione segreta" ;
    rdfs:domain onto:votazione ;
    rdfs:range xsd:boolean ;
    owl:versionInfo "Questa proprietà è stata inserita nell'ultima versione del 2 maggio 2013"^^xsd:string .

onto:adesioneGruppoMisto a owl:Class ;
    rdfs:label "adesione al Gruppo Misto"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onto:rif_componente ],
        [ a owl:Restriction ;
            owl:onProperty dc:date ;
            owl:someValuesFrom rdfs:Literal ] .

