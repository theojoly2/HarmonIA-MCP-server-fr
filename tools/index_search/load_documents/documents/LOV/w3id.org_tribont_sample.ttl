@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://www.w3.org/2003/11/swrl#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix ns4: <http://gbol.life/ontology/bibo#> .
@prefix onto: <https://w3id.org/tribont/sample> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns3:license a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

owl:cardinality a owl:AnnotationProperty .

owl:maxCardinality a owl:AnnotationProperty .

owl:maxQualifiedCardinality a owl:AnnotationProperty .

owl:qualifiedCardinality a owl:AnnotationProperty .

ns1:term_status a owl:AnnotationProperty .

<https://w3id.org/tribont/material#ElementRole> a owl:Class ;
    owl:disjointWith <https://w3id.org/tribont/sample#SampleRole> .

onto: a owl:Ontology ;
    ns3:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    ns4:status "published" ;
    dcterms:bibliographicCitation "Work in progress" ;
    dcterms:contributor "Izaskun Fernandez (Tekniker) \\nDomain expert:Iban Quintana (Tekniker) \\nDomain expert:Xana Fernandez (Tekniker)"@en ;
    dcterms:created "2023-05-30" ;
    dcterms:creator "Patricia Casla (Tekniker)"@en ;
    dcterms:description "The goal of this module is to represent the sample systems , and the undelaying samples, involved in the tribological experiments."@en ;
    dcterms:issued "2023-05-30" ;
    dcterms:publisher "Tekniker" ;
    dcterms:title "Sample module" ;
    vann:preferredNamespacePrefix "sample" ;
    vann:preferredNamespaceUri "https://w3id.org/tribont/sample" ;
    owl:imports <https://w3id.org/tribont/material> ;
    owl:versionInfo 1.0 .

<https://w3id.org/tribont/sample#CoatedSample> a owl:Class ;
    rdfs:label "CoatedSample" ;
    rdfs:comment "Sample body which has a coating moterial." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf <https://w3id.org/tribont/sample#Sample> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <https://w3id.org/tribont/sample#Sample> [ a owl:Restriction ;
                        owl:onProperty <https://w3id.org/tribont/sample#hasCoating> ;
                        owl:someValuesFrom <https://w3id.org/tribont/sample#Coating> ] ) ] ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#CoatingThickness> a owl:Class ;
    rdfs:label "CoatingThickness" ;
    rdfs:comment "Thickness of a coating." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf <https://w3id.org/tribont/sample#CoatingProperty> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#CoatingType> a owl:Class ;
    rdfs:label "CoatingType" ;
    rdfs:comment "Type of coating." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf <https://w3id.org/tribont/sample#CoatingProperty> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#LubricatedSampleSystem> a owl:Class ;
    rdfs:label "LubricatedSampleSystem" ;
    rdfs:comment "Sample system that includes a lubricant as part of it." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf <https://w3id.org/tribont/sample#SampleSystem> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <https://w3id.org/tribont/sample#SampleSystem> [ a owl:Restriction ;
                        owl:onProperty <https://w3id.org/tribont/sample#hasLubricationSample> ;
                        owl:someValuesFrom <https://w3id.org/tribont/sample#LubricationSample> ] ) ] ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#executionDate> a owl:DatatypeProperty ;
    rdfs:label "executionDate" ;
    rdfs:comment "Data when something has been executed." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#reference> a owl:NamedIndividual,
        <https://w3id.org/tribont/sample#SampleRole> ;
    rdfs:label "reference" ;
    rdfs:comment "A reference against which the sample is tested." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#target> a owl:NamedIndividual,
        <https://w3id.org/tribont/sample#SampleRole> ;
    rdfs:label "target" ;
    rdfs:comment "Target sample for the  testing  activity." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#Property> a owl:Class .

<https://w3id.org/tribont/core#OperationProperty> a owl:Class .

<https://w3id.org/tribont/core#Role> a owl:Class .

<https://w3id.org/tribont/material#ElementConcentration> a owl:Class .

<https://w3id.org/tribont/material#FluidLubricant> a owl:Class .

<https://w3id.org/tribont/material#SolidLubricant> a owl:Class .

<https://w3id.org/tribont/sample#SampleBatch> a owl:Class ;
    rdfs:label "SampleBatch" ;
    rdfs:comment "An aggrupation of samples which have been transformed at the same time using a same material and share a set of common atributes of characteristics." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasBody> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/material#Material> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasCoreMaterial> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/tribont/sample#Coating> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasCoating> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <https://w3id.org/tribont/sample#preparationDate> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasBody> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/sample#Coating> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasCoating> ],
        <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#isCoatingFor> a owl:ObjectProperty ;
    rdfs:label "isCoatingFor" ;
    rdfs:comment "Relationship between a coating  and the sample  of which it is a part." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#isCoreMaterialFor> a owl:ObjectProperty ;
    rdfs:label "isCoreMaterialFor" ;
    rdfs:comment "Relationship between  the material it is made of and something" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#isLubricationSampleFor> a owl:ObjectProperty ;
    rdfs:label "isLubricationSampleFor" ;
    rdfs:comment "Relationship between a lubrication sample  and the sample system of which it is a part." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#isMovingSampleFor> a owl:ObjectProperty ;
    rdfs:label "isMovingSampleFor" ;
    rdfs:comment "Relationship between a moving sample  and the sample system of which it is a part." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#isSampleRoleFor> a owl:ObjectProperty ;
    rdfs:label "isSampleRoleFor" ;
    rdfs:comment "Relationship between a role and the sample to which it applies," ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#isStaticSampleFor> a owl:ObjectProperty ;
    rdfs:label "isStaticSampleFor" ;
    rdfs:comment "Relationship between a static sample  and the sample system of which it is a part." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#SystemProperty> a owl:Class .

<https://w3id.org/tribont/core#TechnicalProperty> a owl:Class .

<https://w3id.org/tribont/sample#LubricationSample> a owl:Class ;
    rdfs:label "LubricationSample" ;
    rdfs:comment "Portion of lubricant material selected from a larger quantity of lubricant material for Testing purposes. Lubricant material can be fluid or solid lubricants " ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf <https://w3id.org/tribont/sample#Sample> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <https://w3id.org/tribont/sample#Sample> [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty <https://w3id.org/tribont/sample#hasCoreMaterial> ;
                                    owl:someValuesFrom <https://w3id.org/tribont/material#FluidLubricant> ] [ a owl:Restriction ;
                                    owl:onProperty <https://w3id.org/tribont/sample#hasCoreMaterial> ;
                                    owl:someValuesFrom <https://w3id.org/tribont/material#SolidLubricant> ] ) ] ) ] ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#hasLubricationSample> a owl:ObjectProperty ;
    rdfs:label "hasLubricationSample" ;
    rdfs:comment "Relationship between a sample system and a lubricant material that is part of it." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    owl:inverseOf <https://w3id.org/tribont/sample#isLubricationSampleFor> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#hasMovingSample> a owl:ObjectProperty ;
    rdfs:label "hasMovingSample" ;
    rdfs:comment "Relationship between a sample system and a moving sample body that is part of it." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    owl:inverseOf <https://w3id.org/tribont/sample#isMovingSampleFor> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#hasSampleRole> a owl:ObjectProperty ;
    rdfs:label "hasSampleRole" ;
    rdfs:comment "Relationship between a sample and its role." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    owl:inverseOf <https://w3id.org/tribont/sample#isSampleRoleFor> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#hasStaticSample> a owl:ObjectProperty ;
    rdfs:label "hasStaticSample" ;
    rdfs:comment "Relationship between a sample system and a static sample body that is part of it." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    owl:inverseOf <https://w3id.org/tribont/sample#isStaticSampleFor> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#interactsWith> a owl:ObjectProperty ;
    rdfs:label "interactsWith" ;
    rdfs:comment "Releation between sveral samples interacting one with each other." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<urn:swrl:var#b> a ns2:Variable .

<urn:swrl:var#c> a ns2:Variable .

<https://w3id.org/isCharacterisedBy#isCharacterisedBy> a owl:ObjectProperty .

<urn:swrl:var#ms> a ns2:Variable .

<urn:swrl:var#ss> a ns2:Variable .

<urn:swrl:var#sts> a ns2:Variable .

<https://w3id.org/isCharacterisedBy#SubjectOfInterest> a owl:Class .

<https://w3id.org/isCharacterisedBy#belongsTo> a owl:ObjectProperty .

<https://w3id.org/tribont/sample#CoatingProperty> a owl:Class ;
    rdfs:label "CoatingProperty" ;
    rdfs:comment "Qualifiable or quantifiable attribute, or characteristic of a coating." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf <https://w3id.org/isCharacterisedBy#Property> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#SampleSystem> a owl:Class ;
    rdfs:label "SampleSystem" ;
    rdfs:comment "Object aggregate that has two or more elements that interact with each other, and it is used for Testing purposes. For example, a tribological sample system aggregates at least a static and a moving sample body and can include or not a lubrication sample body." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/sample#LubricationSample> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasLubricationSample> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/sample#Sample> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasMovingSample> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#SystemProperty> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/sample#Sample> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasStaticSample> ],
        <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#preparationDate> a owl:DatatypeProperty ;
    rdfs:label "preparationDate" ;
    rdfs:comment "Data when something has been prepared." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<urn:swrl:var#m> a ns2:Variable .

<https://w3id.org/tribont/core#Body> a owl:Class .

<https://w3id.org/tribont/material#Material> a owl:Class .

<https://w3id.org/tribont/sample#SampleRole> a owl:Class ;
    rdfs:label "SampleRole" ;
    rdfs:comment "The position or purpose that a sample has in a situation." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#Role> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#Coating> a owl:Class ;
    rdfs:label "Coating" ;
    rdfs:comment "A thin layer covering of something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/material" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/material#Material> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasCoreMaterial> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/material#Material> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasCoreMaterial> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/sample#CoatingProperty> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#hasBody> a owl:ObjectProperty ;
    rdfs:label "hasBody" ;
    rdfs:comment "Relationship between something  and its body configuration.." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#hasCoating> a owl:ObjectProperty ;
    rdfs:label "hasCoating" ;
    rdfs:comment "Relationship between a sample  and its coating." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    owl:inverseOf <https://w3id.org/tribont/sample#isCoatingFor> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/sample#hasCoreMaterial> a owl:ObjectProperty ;
    rdfs:label "hasCoreMaterial" ;
    rdfs:comment "Relationship between something and the material of which it is made" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    owl:inverseOf <https://w3id.org/tribont/sample#isCoreMaterialFor> ;
    ns1:term_status "Testing" .

<urn:swrl:var#sb> a ns2:Variable .

<https://w3id.org/tribont/sample#Sample> a owl:Class ;
    rdfs:label "Sample" ;
    rdfs:comment "Portion of material which can be transformed or not for Testing purposes. For example the moving and static samples in a tribological tests are transformed following a specific manufacturing process to achieve the required body characteristics, while lubricants acting as lubrication body are not transformed." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/sample" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/tribont/sample#preparationDate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#TechnicalProperty> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/tribont/sample#SampleRole> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasSampleRole> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/sample#SampleRole> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasSampleRole> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/tribont/sample#Coating> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasCoating> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/sample#Coating> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasCoating> ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasBody> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasBody> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/material#Material> ;
            owl:onProperty <https://w3id.org/tribont/sample#hasCoreMaterial> ],
        <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    ns1:term_status "Testing" .

<urn:swrl:var#s> a ns2:Variable .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/tribont/core#OperationProperty> <https://w3id.org/tribont/core#SystemProperty> <https://w3id.org/tribont/core#TechnicalProperty> <https://w3id.org/tribont/material#ElementConcentration> <https://w3id.org/tribont/sample#CoatingProperty> ) .

[] owl:cardinality "1"^^xsd:nonNegativeInteger .

[] owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger .

[] a ns2:Imp ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:ClassAtom ;
                    ns2:argument1 <urn:swrl:var#s> ;
                    ns2:classPredicate <https://w3id.org/tribont/sample#Sample> ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:IndividualPropertyAtom ;
                            ns2:argument1 <urn:swrl:var#s> ;
                            ns2:argument2 <urn:swrl:var#sb> ;
                            ns2:propertyPredicate <https://w3id.org/isCharacterisedBy#belongsTo> ] ;
                    rdf:rest [ a ns2:AtomList ;
                            rdf:first [ a ns2:DatavaluedPropertyAtom ;
                                    ns2:argument1 <urn:swrl:var#sb> ;
                                    ns2:argument2 <urn:swrl:var#m> ;
                                    ns2:propertyPredicate <https://w3id.org/tribont/sample#preparationDate> ] ;
                            rdf:rest () ] ] ] ;
    ns2:head [ a ns2:AtomList ;
            rdf:first [ a ns2:DatavaluedPropertyAtom ;
                    ns2:argument1 <urn:swrl:var#s> ;
                    ns2:argument2 <urn:swrl:var#m> ;
                    ns2:propertyPredicate <https://w3id.org/tribont/sample#preparationDate> ] ;
            rdf:rest () ] .

[] owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger .

[] owl:maxCardinality "1"^^xsd:nonNegativeInteger .

[] a ns2:Imp ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:ClassAtom ;
                    ns2:argument1 <urn:swrl:var#ss> ;
                    ns2:classPredicate <https://w3id.org/tribont/sample#SampleSystem> ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:IndividualPropertyAtom ;
                            ns2:argument1 <urn:swrl:var#ss> ;
                            ns2:argument2 <urn:swrl:var#ms> ;
                            ns2:propertyPredicate <https://w3id.org/tribont/sample#hasMovingSample> ] ;
                    rdf:rest [ a ns2:AtomList ;
                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                    ns2:argument1 <urn:swrl:var#ss> ;
                                    ns2:argument2 <urn:swrl:var#sts> ;
                                    ns2:propertyPredicate <https://w3id.org/tribont/sample#hasStaticSample> ] ;
                            rdf:rest () ] ] ] ;
    ns2:head [ a ns2:AtomList ;
            rdf:first [ a ns2:IndividualPropertyAtom ;
                    ns2:argument1 <urn:swrl:var#ms> ;
                    ns2:argument2 <urn:swrl:var#sts> ;
                    ns2:propertyPredicate <https://w3id.org/tribont/sample#interactsWith> ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:IndividualPropertyAtom ;
                            ns2:argument1 <urn:swrl:var#sts> ;
                            ns2:argument2 <urn:swrl:var#ms> ;
                            ns2:propertyPredicate <https://w3id.org/tribont/sample#interactsWith> ] ;
                    rdf:rest () ] ] .

[] owl:maxCardinality "1"^^xsd:nonNegativeInteger .

[] a ns2:Imp ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:ClassAtom ;
                    ns2:argument1 <urn:swrl:var#s> ;
                    ns2:classPredicate <https://w3id.org/tribont/sample#Sample> ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:IndividualPropertyAtom ;
