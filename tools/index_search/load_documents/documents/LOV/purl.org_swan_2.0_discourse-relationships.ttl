@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://purl.org/swan/2.0/discourse-relationships/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:contributor a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:date a owl:AnnotationProperty .

dcterms:format a owl:AnnotationProperty .

dcterms:language a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

onto: a owl:Ontology ;
    rdfs:label "Discourse relationships vocabulary v. 3.0"^^xsd:string ;
    dcterms:contributor "David Shotton"^^xsd:string,
        "Elizabeth Wu"^^xsd:string,
        "Gwen Wong"^^xsd:string,
        "June Kinoshita"^^xsd:string,
        "Marco Ocana"^^xsd:string,
        "Paolo Ciccarese"^^xsd:string,
        "Tim Clark"^^xsd:string ;
    dcterms:creator <http://www.hcklab.org/foaf.rdf#me> ;
    dcterms:date "October 12, 2010"^^xsd:string ;
    dcterms:format "rdf/xml"^^xsd:string ;
    dcterms:language "en" ;
    dcterms:publisher "Massachusetts General Hospital" ;
    dcterms:title "Discourse relationships vocabulary"@en ;
    rdfs:comment "These relationships don't have range and domains defined as they are meant to be reused in different contexts"^^xsd:string ;
    owl:versionInfo "3.0"^^xsd:string .

onto:alternativeTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "alternativeTo" ;
    rdfs:comment "It connects two different resources that can be \\n\\t    \\t\\tconsidered alternative interpretations of the same experimental results"^^xsd:string ;
    rdfs:subPropertyOf onto:relatesTo .

onto:arisesFrom a owl:ObjectProperty ;
    rdfs:label "arisesFrom" ;
    rdfs:comment "Something (question, doubt...) that arises because of something else"^^xsd:string ;
    rdfs:subPropertyOf onto:refersTo .

onto:consistentWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "consistentWith" ;
    rdfs:comment "It expresses consistency between two resources. \\n\\t    \\t\\tIt is a bidirectional relationship"^^xsd:string ;
    rdfs:subPropertyOf onto:relatesTo .

onto:inconsistentWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "inconsistentWith" ;
    rdfs:comment "It expresses inconsistency between two resources. \\n\\t    \\t\\tIt is a bidirectional relationship"^^xsd:string ;
    rdfs:subPropertyOf onto:relatesTo .

onto:motivates a owl:ObjectProperty ;
    rdfs:label "motivates" ;
    rdfs:comment "Something (hypothesis, doubt...) that motivates something else like an experiment"^^xsd:string ;
    rdfs:subPropertyOf onto:refersTo .

onto:referencesAsInconsistentEvidence a owl:ObjectProperty ;
    rdfs:label "referencesAsInconsistentEvidence" ;
    rdfs:comment ""^^xsd:string ;
    rdfs:subPropertyOf onto:refersTo .

onto:referencesAsRelevantEvidence a owl:ObjectProperty ;
    rdfs:label "referencesAsRelevantEvidence" ;
    rdfs:comment ""^^xsd:string ;
    rdfs:subPropertyOf onto:refersTo .

onto:referencesAsSupportiveEvidence a owl:ObjectProperty ;
    rdfs:label "referencesAsSupportiveEvidence" ;
    rdfs:comment ""^^xsd:string ;
    rdfs:subPropertyOf onto:refersTo .

onto:relevantTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "relevantTo" ;
    rdfs:comment "It expresses the fact that a resource is \\n\\t    \\t\\trelevant for another one and vice-versa"^^xsd:string ;
    rdfs:subPropertyOf onto:relatesTo .

onto:respondsNegativelyTo a owl:ObjectProperty ;
    rdfs:label "respondsNegativelyTo" ;
    rdfs:comment "It expresses the fact that one entity is talking \\n\\t\\t\\t\\t    \\t\\tabout another one expressing disagreement"^^xsd:string ;
    rdfs:subPropertyOf onto:respondsTo .

onto:respondsNeutrallyTo a owl:ObjectProperty ;
    rdfs:label "respondsNeutrallyTo" ;
    rdfs:comment "It expresses the fact that one entity is \\n\\t\\t\\t\\t    \\t\\ttalking about another one without expressing agreement or disagreement"^^xsd:string ;
    rdfs:subPropertyOf onto:respondsTo .

onto:respondsPositivelyTo a owl:ObjectProperty ;
    rdfs:label "respondsPositivelyTo" ;
    rdfs:comment "It expresses the fact that one entity is talking \\n\\t\\t\\t\\t    \\t\\tabout another one expressing agreement"^^xsd:string ;
    rdfs:subPropertyOf onto:respondsTo .

onto:respondsTo a owl:ObjectProperty ;
    rdfs:label "respondsTo" ;
    rdfs:comment ""^^xsd:string ;
    rdfs:subPropertyOf onto:refersTo .

onto:relatesTo a owl:ObjectProperty ;
    rdfs:label "relatesTo" ;
    rdfs:comment "The most generic relationship: it expresses connection \\n\\t\\t\\tbetween two resources without specifying the nature of such connection"^^xsd:string .

onto:refersTo a owl:ObjectProperty ;
    rdfs:label "refersTo" ;
    rdfs:comment "It connects an entity with another entity in an \\n\\t\\t\\t\\tunidirectional way"^^xsd:string ;
    rdfs:subPropertyOf onto:relatesTo .

