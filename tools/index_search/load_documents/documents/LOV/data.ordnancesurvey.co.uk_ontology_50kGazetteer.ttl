@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://data.ordnancesurvey.co.uk/ontology/50kGazetteer/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    dc:creator "Ordnance Survey"^^rdf:PlainLiteral ;
    dc:description "An ontology describing the 50K Gazetteer."^^xsd:string ;
    dcterms:creator <http://data.ordnancesurvey.co.uk/id/ordnancesurvey> ;
    dcterms:publisher <http://data.ordnancesurvey.co.uk/id/ordnancesurvey> ;
    rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/50KGazetteer.owl> .

