onto: a owl:Ontology ;
    dc:creator "ICAR - Centro MAAS" ;
    dc:date "2015-03-02" ;
    dc:rights "Per l'ontologia ed il thesaurus SAN, si applica una licenza Creative Commons 2.5 BY di attribuzione. Per tipologie di uso e riutilizzo non consentite dalla licenza adottata, è necessario richiedere esplicita autorizzazione all'ICAR" ;
    dc:title "SAN Ontologia" ;
    owl:versionInfo "Version 1.1"^^xsd:string .

onto:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract"^^xsd:string ;
    rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaeac.xsd//eac-cpf/cpfDescription/description/biogHist/abstract",
        "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaead.xsd//ead/archdesc/did/abstract[@langcode]" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ ] ] .

onto:acronimo a owl:DatatypeProperty ;
