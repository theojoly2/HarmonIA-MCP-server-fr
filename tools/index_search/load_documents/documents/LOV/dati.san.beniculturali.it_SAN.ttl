<http://dati.san.beniculturali.it/SAN/TesauroSAN/Tipo_data_esistenza_CPF> a owl:Class ;
    rdfs:subClassOf skos:Concept .

<http://dati.san.beniculturali.it/SAN/TesauroSAN/natura_giuridica_ente> a owl:Class ;
    rdfs:subClassOf skos:Concept .

<http://dati.san.beniculturali.it/SAN/TesauroSAN/sottotipologia_ente> a owl:Class ;
    rdfs:subClassOf skos:Concept .

<http://dati.san.beniculturali.it/SAN/TesauroSAN/tipologia_Conservatore> a owl:Class ;
    rdfs:subClassOf skos:Concept .

onto:famiglia a owl:Class ;
    rdfs:label "famiglia"^^xsd:string ;
    rdfs:subClassOf onto:produttore ;
    owl:disjointWith onto:persona ;
    owl:equivalentClass <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf#family> .

onto:has_CSI a owl:ObjectProperty ;
    rdfs:label "ha contesto storico istituzionale"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ ] ] ;
    rdfs:range onto:contestoStoricoIstituzionale .

onto:has_conservatore a owl:ObjectProperty ;
    rdfs:label "ha conservatore"^^xsd:string ;
    rdfs:domain onto:complessoArchivistico ;
    rdfs:range onto:conservatore .

onto:has_produttore a owl:ObjectProperty ;
    rdfs:label "ha produttore"^^xsd:string ;
    rdfs:domain onto:complessoArchivistico ;
    rdfs:range onto:produttore .

onto:has_strumentoDiRicerca a owl:ObjectProperty ;
    rdfs:label "ha strumento di ricerca"^^xsd:string ;
    rdfs:domain onto:complessoArchivistico ;
    rdfs:range onto:strumento ;
    owl:equivalentProperty <http://lod.xdams.org/reload/oad/has_findingAid> .

onto:dateCSI a owl:Class ;
    rdfs:label "date contesto storico istituzionale"^^xsd:string ;
    rdfs:subClassOf [ ],
        onto:date .

onto:dateStrumento a owl:Class ;
    rdfs:label "date strumento"^^xsd:string ;
    rdfs:subClassOf onto:date .

onto:dateComplarc a owl:Class ;
    rdfs:label "date complesso archivistico"^^xsd:string ;
    rdfs:subClassOf [ ],
        [ ],
        onto:date .

onto:estensioneDateComplarc a owl:Class ;
    rdfs:label "estensione date complesso archivistico"^^xsd:string ;
    rdfs:subClassOf [ ],
        onto:date .

onto:luogo a owl:Class ;
    rdfs:label "luogo"^^xsd:string ;
    rdfs:subClassOf [ ],
        owl:Thing ;
    owl:equivalentClass <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf#place>,
        <http://www.geonames.org/ontology#Feature> .

onto:profiloIstituzionale a owl:Class ;
    rdfs:label "profilo istituzionale"^^xsd:string ;
    rdfs:comment "Istituzioni, preunitarie o unitarie, descritte una volta per tutte, con riferimento al periodo in cui hanno operato e al contesto storico istituzionale o statuale di appartenenza.\\nDescrive una volta per tutte un particolare soggetto produttore, e costituisce una chiave di ricerca per tutti i soggetti produttori che appartengono al profilo descritto." ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        owl:Thing .

onto:sitoWeb a owl:Class ;
    rdfs:label "sito web"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass <http://lod.xdams.org/reload/ocsa/contactArea> .

onto:strumentoDigitale a owl:Class ;
    rdfs:label "strumento digitale"^^xsd:string ;
    rdfs:subClassOf [ ],
        [ ],
        owl:Thing .

onto:dateEsistenza a owl:Class ;
    rdfs:label "date esistenza"^^xsd:string ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        onto:date .

onto:persona a owl:Class ;
    rdfs:label "persona"^^xsd:string ;
    rdfs:subClassOf onto:produttore ;
    owl:equivalentClass <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf#person>,
        foaf:person .

onto:contestoStoricoIstituzionale a owl:Class ;
    rdfs:label "contesto storico istituzionale"^^xsd:string ;
    rdfs:comment "Organizzazione istituzionale entro cui ha operato il soggetto produttore. Può trattarsi di uno Stato o di articolazioni territoriali o amministrative di esso. L'entità  statale può essere individuata con la denominazione propria di un determinato periodo storico (per es. “Repubblica di Siena”, “Granducato di Toscana””) o con le denominazioni assunte in un più lungo arco cronologico (es. \"Regno d'Italia poi Repubblica italiana\")." ;
    rdfs:subClassOf owl:Thing .

onto:date a owl:Class ;
    rdfs:label "date"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

onto:luogoConservatore a owl:Class ;
    rdfs:label "luogo conservatore"^^xsd:string ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        onto:luogo .

onto:qualificazioniRelazioniCpf a owl:Class ;
    rdfs:label "qualificazioni relazioni Cpf"^^xsd:string ;
    rdfs:subClassOf [ ],
        owl:Thing .

onto:has_luogoProduttore a owl:ObjectProperty ;
    rdfs:label "ha luogoProduttore"^^xsd:string ;
    rdfs:domain onto:produttore ;
    rdfs:range onto:luogo ;
    owl:equivalentProperty <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf#hasPlace> .

onto:produttore a owl:Class ;
    rdfs:label "soggetto produttore"^^xsd:string ;
    rdfs:comment "Soggetto (ente, famiglia o persona) che ha prodotto o acquisito per finalità  amministrative, familiari o personali il complesso archivistico oggetto di descrizione. Può essere collegato ad altri soggetti produttori con relazioni gerarchiche o temporali." ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf [ ] ],
        <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf#entity> .

onto:strumento a owl:Class ;
    rdfs:label "strumento di ricerca"^^xsd:string ;
    rdfs:comment "Repertorio - in forma di inventario analitico o sommario, elenco, elenco di versamento, elenco di consistenza, elenco numerico o altro - che descrive in maniera più o meno dettagliata un fondo o parte di esso." ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        owl:Thing ;
    owl:equivalentClass <http://lod.xdams.org/reload/oad/findingAid> .

onto:conservatore a owl:Class ;
    rdfs:label "soggetto conservatore"^^xsd:string ;
    rdfs:comment "Il soggetto sul quale ricade la responsabilità  della conservazione e valorizzazione dell'archivio" ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        owl:Thing ;
    owl:equivalentClass org:Organization .

onto:complessoArchivistico a owl:Class ;
    rdfs:label "complesso archivistico"^^xsd:string ;
    rdfs:comment "Locuzione generica per indicare un corpus documentale oggetto di descrizione." ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        owl:Thing ;
    owl:equivalentClass <http://lod.xdams.org/reload/oad/uod> .

