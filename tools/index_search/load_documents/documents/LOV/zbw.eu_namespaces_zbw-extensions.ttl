@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://zbw.eu/namespaces/zbw-extensions/> dc:creator "Joachim Neubert" ;
    dc:publisher "German National Library of Economics (ZBW)"@en ;
    dc:title "Extensions to SKOS and other standard vocabularies used by the German National Library of Economics (ZBW)"@en ;
    dcterms:created "2010-04-28" ;
    dcterms:modified "2017-04-12" .

<http://zbw.eu/namespaces/zbw-extensions/Descriptor> a owl:Class ;
    rdfs:label "Descriptor"@en ;
    rdfs:comment "Among themselves, the Descriptor entries are \\n    linked in multiple skos:broader/skos:narrower hierarchies and skos:related \\n    connections. To Thsys entries, only skos:broader connections are\\n    allowed."@en ;
    rdfs:isDefinedBy <http://zbw.eu/namespaces/zbw-extensions/zbw-extensions.rdf> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The descriptors part of the STW - concepts used for indexing."@en .

<http://zbw.eu/namespaces/zbw-extensions/Found> a owl:Class ;
    rdfs:label "Found"@en ;
    rdfs:comment "Class to mark concepts which were\\n    matched by a search query, as opposed to other (e.g., skos:narrower or\\n    skos:related) concepts returned in the same result set. (Experimental)\\n    "@en ;
    rdfs:isDefinedBy <http://zbw.eu/namespaces/zbw-extensions/zbw-extensions.rdf> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A skos:Concept (or another object), found\\n    by a search operation."@en .

<http://zbw.eu/namespaces/zbw-extensions/Thsys> a owl:Class ;
    rdfs:label "Thsys"@en ;
    rdfs:comment "Each entry has a rdfs:label property for each \\n    supported language and one skos:notation property. skos:prefLabel \\n    properties are generated by concatenation of these properties. \\n    Among themselves, the thsys entries are linked in several\\n    skos:broader/skos:narrower mono-hierarchies under a top-level \\n    \"Subthesaurus\" Thsys concept. To Descriptor entities, only skos:narrower \\n    connections are allowed."@en ;
    rdfs:isDefinedBy <http://zbw.eu/namespaces/zbw-extensions/zbw-extensions.rdf> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The systematic part of the STW - concepts used for\\n    organizing descriptors in broader subject categories."@en .

<http://zbw.eu/namespaces/zbw-extensions/altLabelNarrower> a owl:AnnotationProperty ;
    rdfs:label "altLabelNarrower"@en ;
    rdfs:isDefinedBy <http://zbw.eu/namespaces/zbw-extensions/zbw-extensions.rdf> ;
    skos:definition "Lexical label for a narrower term which is\\n    not defined as a separate concept (according to ISO 25964, 8.4), sometimes\\n    referred to as 'upward posting'. Intended for use with\\n    skos:Concept, instead of using skos:altLabel."@en .

<http://zbw.eu/namespaces/zbw-extensions/econbizCount> a owl:FunctionalProperty ;
    rdfs:label "econbizCount"@en ;
    rdfs:isDefinedBy <http://zbw.eu/namespaces/zbw-extensions/zbw-extensions.rdf> ;
    rdfs:subPropertyOf <http://rdf.myexperiment.org/ontologies/base/count> ;
    skos:definition "Count of matching items in EconBiz (virtual library \\n    for economics and business studies, http://econbiz.eu)."@en .

<http://zbw.eu/namespaces/zbw-extensions/indexedItem> a owl:ObjectProperty ;
    rdfs:label "indexedItem"@en ;
    rdfs:comment "A substitute for the vanished skos:isSubjectOf. \\n    May be used with collections of resources also."@en ;
    rdfs:isDefinedBy <http://zbw.eu/namespaces/zbw-extensions/zbw-extensions.rdf> ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    skos:definition "The concept is used as an index term or subject \\n    for the resource."@en .

<http://zbw.eu/namespaces/zbw-extensions/useInsteadNote> a owl:AnnotationProperty ;
    rdfs:label "useInsteadNote"@en ;
    rdfs:comment "The note consists of a blank node. It contains \\n    a rdfs:value literal which designates the aspect and a rdfs:seeAlso link to \\n    the concept which should be used instead."@en ;
    rdfs:isDefinedBy <http://zbw.eu/namespaces/zbw-extensions/zbw-extensions.rdf> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "For an aspect of the current concept use the \\n    concept to which the note points instead of the current."@en .

