@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://purl.org/nemo/gufo#> .
@prefix onto: <http://purl.org/coreo> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    dc:creator "<https://orcid.org/0009-0006-6051-2165>,\\n<https://orcid.org/0000-0002-9819-3781>,\\n<https://orcid.org/0000-0002-5385-5761>,\\n<https://orcid.org/0000-0002-3452-553X>"@en ;
    dc:title "Core-o: Competence Reference Ontology"@en ;
    dcterms:bibliographicCitation "R. F. Calhau, J. P. A. Almeida, T. P. Sales, G. Guizzardi, \\\\\"Core-O: A Competence Reference Ontology\\\\\", 2023, http://purl.org/coreo"@en ;
    dcterms:created "2023-05-08"^^xsd:date ;
    dcterms:description "An ontology to describe competences and human capabilities"@en ;
    dcterms:issued "2023-05-08"^^xsd:date ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:anyURI ;
    dcterms:modified "2023-05-12"^^xsd:date ;
    dcterms:publisher "<https://www.utwente.nl/eemcs/scs/>"@en ;
    vann:preferredNamespacePrefix "coreo"@en ;
    vann:preferredNamespaceUri "http://purl.org/coreo"@en ;
    rdfs:comment "Core-O is a well-founded competence reference ontology that accounts for competence-related elements such as knowledge, attitudes, and skills; also countenance their performance---related to tasks, their context, and outcomes---as well as their evolution over time (proficiency). This ontology is based on the Unified Foundational Ontology (Guizzardi, 2005), more specifically using gUFO (gentle UFO), a UFO-based lightweight ontology.\\nThe ontology was based on these works: (CALHAU et al., 2021) and (CALHAU et al., 2023)\\n\\nIt was created to support: (i) semantically annotate competence-related artifacts such as curriculum, job vacancy, learning objects, resources, professional profiles, task logs, logbooks, and learning diaries; (ii) semantically inter-operate and integrate professional data concerning internal system (from organizations, VET institutions) and external ones (e.g., professional networks as LinkedIn); (iii) support the semantic search to find the best professional to an occupation, or to find the best occupation to a professional; (iv) support the skill/competence matching in gap analysis; (v) support competence/skill identification/assessment based on ontology-driven data and text mining in competence-related artifacts, such as learning diary, logbook, or task logs from control version tools as Github.\\n\\n\\nFor background information on the reference ontology, see: \\n\\n1. CALHAU, Rodrigo F.; AZEVEDO, Carlos LB; ALMEIDA, João Paulo A. Towards Ontology-based Competence Modeling in Enterprise Architecture. In: 2021 IEEE 25th International Enterprise Distributed Object Computing Conference (EDOC). IEEE, 2021. p. 71-81.\\n2. CALHAU, Rodrigo F.; ALMEIDA, João Paulo A. Zooming in on Competences in Ontology-Based Enterprise Architecture Modeling. In: Enterprise Design, Operations, and Computing. EDOC 2022 Workshops: IDAMS, SoEA4EE, TEAR, EDOC Forum, Demonstrations Track and Doctoral Consortium, Bozen-Bolzano, Italy, October 4–7, 2022, Revised Selected Papers. Cham: Springer International Publishing, 2023. p. 198-213.\\n3. GUIZZARDI, Giancarlo. Ontological foundations for structural conceptual models. 2005.\\n\\nCite this work as: \\nR. F. Calhau, J. P. A. Almeida, T. P. Sales, G. Guizzardi, \\\\\"Core-O: A Competence Reference Ontology\\\\\", 2023, http://purl.org/coreo\\n\\nThis work is distributed under Creative Commons Attribution License CC BY 4.0 <https://creativecommons.org/licenses/by/4.0/legalcode>.\\n\\n\\nFor the source repository, see: <https://github.com/core-o/ontology>"@en ;
    owl:imports <http://purl.org/nemo/gufo#/1.0.0> ;
    owl:versionIRI <http://purl.org/coreo/1.0.0> ;
    owl:versionInfo "1.0.0"@en .

<http://purl.org/coreo#CapabilityContext> rdfs:label "Capability Context"@en .

<http://purl.org/coreo#CapabilityManifestation> rdfs:label "Capability Manifestation"@en .

<http://purl.org/coreo#CapabilityOutcome> rdfs:label "Capability Outcome"@en .

<http://purl.org/coreo#CompetenceType> rdfs:label "CompetenceType"@en ;
    ns1:categorizes <http://purl.org/coreo#PersonalCompetence> ;
    rdfs:comment "A gufo:Type whose instances are coreo:PersonalCompetence. \\n\\nInstances of coreo:CompetenceType are subclasses of coreo:PersonalCompetence.\\n\\nExamples include the competence type of \"Software Development\""@en .

<http://purl.org/coreo#EndurantType> a owl:NamedIndividual .

<http://purl.org/coreo#HumanAspectPhase> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HumanAspectPhase"@en ;
    ns1:categorizes <http://purl.org/coreo#HumanAspect> ;
    rdfs:subClassOf <http://purl.org/coreo#HumanAspectType>,
        ns1:Phase .

<http://purl.org/coreo#HumanCharacteristic> rdfs:label "HumanCharacteristic"@en ;
    rdfs:comment "Human aspects inherent to an individual used to describe his/her profile, Includes qualities and traits"@en .

<http://purl.org/coreo#Object> a ns1:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Object"@en ;
    rdfs:subClassOf ns1:FunctionalComplex .

<http://purl.org/coreo#PerdurantType> a owl:NamedIndividual .

<http://purl.org/coreo#PersonalCompetenceType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "PersonalCompetenceType"@en ;
    ns1:categorizes <http://purl.org/coreo#PersonalCompetence> ;
    rdfs:subClassOf <http://purl.org/coreo#HumanCapabilityType> .

<http://purl.org/coreo#Phase> a owl:NamedIndividual .

<http://purl.org/coreo#PhysicalAgent> a ns1:Category,
        owl:NamedIndividual .

<http://purl.org/coreo#Role> a owl:NamedIndividual .

<http://purl.org/coreo#SituationType> a owl:NamedIndividual .

<http://purl.org/coreo#SkillType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "SkillType"@en ;
    ns1:categorizes <http://purl.org/coreo#Skill> ;
    rdfs:comment "A gufo:Type whose instances are coreo:Skill. \\n\\nInstances of coreo:SkillType are subclasses of coreo:Skill.\\n\\nExamples include the skill type of \"Java Programming\""@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanCapabilityType> .

<http://purl.org/coreo#SocialAgent> a ns1:Category,
        owl:NamedIndividual .

<http://purl.org/coreo#TaskOutcome> rdfs:label "Task Outcome"@en .

<http://purl.org/coreo#Type> a owl:NamedIndividual .

<http://purl.org/coreo#bringsAbout> a owl:ObjectProperty ;
    rdfs:label "bringsAbout"@en ;
    rdfs:comment "Details the SituationType that a coreo:TaskType can result"@en ;
    rdfs:domain <http://purl.org/coreo#TaskType> ;
    rdfs:range ns1:SituationType .

<http://purl.org/coreo#broughtAboutHumanTask> a owl:ObjectProperty ;
    rdfs:label ""@en ;
    rdfs:domain <http://purl.org/coreo#CompetenceOutcome> ;
    rdfs:range <http://purl.org/coreo#HumanTask> ;
    rdfs:subPropertyOf ns1:broughtAbout .

<http://purl.org/coreo#capabilityRequiringRoleHasField> a owl:ObjectProperty ;
    rdfs:label "hasField"@en ;
    rdfs:comment "Describes the field of a coreo:CapabilityRequiringRole"@en ;
    rdfs:domain <http://purl.org/coreo#CapabilityRequiringRole> ;
    rdfs:range <http://purl.org/coreo#Field> .

<http://purl.org/coreo#characterizedBy> a owl:ObjectProperty ;
    rdfs:label "characterizedBy"@en ;
    rdfs:comment "Relationship used to detail a coreo:ArtifactType"@en ;
    rdfs:domain <http://purl.org/coreo#ArtifactType> ;
    rdfs:range <http://purl.org/coreo#MomentType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#describedBy> .

<http://purl.org/coreo#concerns> a owl:ObjectProperty ;
    rdfs:label "concernsArtifact"@en ;
    rdfs:comment "Relationship used to detail a coreo:TaskType"@en ;
    rdfs:domain <http://purl.org/coreo#TaskType> ;
    rdfs:range <http://purl.org/coreo#ArtifactType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#describedBy> .

<http://purl.org/coreo#concerns_1> a owl:ObjectProperty ;
    rdfs:label "concernsResource"@en ;
    rdfs:comment "Relationship used to detail a coreo:TaskType"@en ;
    rdfs:domain <http://purl.org/coreo#TaskType> ;
    rdfs:range <http://purl.org/coreo#ResourceType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#describedBy> .

<http://purl.org/coreo#constitutes> a owl:ObjectProperty ;
    rdfs:label "constitutesAspect"@en ;
    rdfs:comment "Describes the constitutive relationship between coreo:HumanAspectTypes manifested as parthood relationships between their instances"@en ;
    rdfs:domain <http://purl.org/coreo#HumanAspectType> ;
    rdfs:range <http://purl.org/coreo#HumanAspectType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#constitutesType> .

<http://purl.org/coreo#contributesTo> a owl:ObjectProperty ;
    rdfs:label "contributesTo"@en ;
    rdfs:comment "Describes the contribution relation between a coreo:HumanQuality and a coreo:PersonalCompetence"@en ;
    rdfs:domain <http://purl.org/coreo#HumanQuality> ;
    rdfs:range <http://purl.org/coreo#PersonalCompetence> .

<http://purl.org/coreo#definedInTermsOf> a owl:ObjectProperty ;
    rdfs:label "definedInTermsOf"@en ;
    rdfs:comment "Relationship used to detail a coreo:HumanCapabilityType"@en ;
    rdfs:domain <http://purl.org/coreo#HumanCapabilityType> ;
    rdfs:range <http://purl.org/coreo#TaskType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#describedBy> .

<http://purl.org/coreo#dependsOn> a owl:ObjectProperty ;
    rdfs:label "dependsOnTask"@en ;
    rdfs:comment "Describes the dependence relationship between types manifested as dependence relationships between their instances"@en ;
    rdfs:domain <http://purl.org/coreo#TaskType> ;
    rdfs:range <http://purl.org/coreo#TaskType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#dependsOnType> .

<http://purl.org/coreo#dependsOn_1> a owl:ObjectProperty ;
    rdfs:label "dependsOnArtifact"@en ;
    rdfs:comment "Describes the dependence relationship between types manifested as dependence relationships between their instances"@en ;
    rdfs:domain <http://purl.org/coreo#ArtifactType> ;
    rdfs:range <http://purl.org/coreo#ArtifactType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#dependsOnType> .

<http://purl.org/coreo#dependsOn_2> a owl:ObjectProperty ;
    rdfs:label "dependsOnHumanAspect"@en ;
    rdfs:comment "Describes the dependence relationship between types manifested as dependence relationships between their instances"@en ;
    rdfs:domain <http://purl.org/coreo#HumanAspectType> ;
    rdfs:range <http://purl.org/coreo#HumanAspectType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#dependsOnType> .

<http://purl.org/coreo#dependsOn_3> a owl:ObjectProperty ;
    rdfs:label "dependsOnRole"@en ;
    rdfs:comment "Describes the dependence relationship between types manifested as dependence relationships between their instances"@en ;
    rdfs:domain <http://purl.org/coreo#CapabilityRequiringRole> ;
    rdfs:range <http://purl.org/coreo#CapabilityRequiringRole> ;
    rdfs:subPropertyOf <http://purl.org/coreo#dependsOnType> .

<http://purl.org/coreo#enables> a owl:ObjectProperty ;
    rdfs:label "enablesSituationType"@en ;
    rdfs:comment "Relationship used to detail types of contexts that activates HumanCapabilityTypes"@en ;
    rdfs:domain <http://purl.org/coreo#HumanCapabilityType> ;
    rdfs:range ns1:SituationType .

<http://purl.org/coreo#evidencedBy> a owl:ObjectProperty ;
    rdfs:label "evidencedBy"@en ;
    rdfs:comment "evidances of a coreo:HumanAspect"@en ;
    rdfs:domain <http://purl.org/coreo#HumanAspect> ;
    rdfs:range <http://purl.org/coreo#Evidence> .

<http://purl.org/coreo#isDefinedBy> a owl:ObjectProperty ;
    rdfs:label "isDefinedBy"@en ;
    rdfs:comment "Relationship used to detail a coreo:HumanCapabilityType"@en ;
    rdfs:domain <http://purl.org/coreo#CapabilityRequiringRole> ;
    rdfs:range <http://purl.org/coreo#HumanCapabilityType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#describedBy> .

<http://purl.org/coreo#personalCompetenceHasAttitude> a owl:ObjectProperty ;
    rdfs:label "hasAttitude"@en ;
    rdfs:comment "parthood relation between a competence and attitude"@en ;
    rdfs:domain <http://purl.org/coreo#PersonalCompetence> ;
    rdfs:range <http://purl.org/coreo#Attitude> ;
    rdfs:subPropertyOf ns1:isAspectProperPartOf .

<http://purl.org/coreo#personalCompetenceHasHumanAspect> a owl:ObjectProperty ;
    rdfs:label "hasHumanAspect"@en ;
    rdfs:comment "parthood relation between a competence and human aspect"@en ;
    rdfs:domain <http://purl.org/coreo#PersonalCompetence> ;
    rdfs:range <http://purl.org/coreo#HumanAspect> ;
    rdfs:subPropertyOf ns1:isAspectProperPartOf .

<http://purl.org/coreo#personalCompetenceHasKnowledge> a owl:ObjectProperty ;
    rdfs:label "hasKnowledge"@en ;
    rdfs:comment "parthood relation between a competence and knowledge"@en ;
    rdfs:domain <http://purl.org/coreo#PersonalCompetence> ;
    rdfs:range <http://purl.org/coreo#Knowledge> ;
    rdfs:subPropertyOf ns1:isAspectProperPartOf .

<http://purl.org/coreo#personalCompetenceHasPersonalCompetence> a owl:ObjectProperty ;
    rdfs:label "hasCompetence"@en ;
    rdfs:comment "parthood relation between a competence and other competence"@en ;
    rdfs:domain <http://purl.org/coreo#PersonalCompetence> ;
    rdfs:range <http://purl.org/coreo#PersonalCompetence> ;
    rdfs:subPropertyOf ns1:isAspectProperPartOf .

<http://purl.org/coreo#personalCompetenceHasSkill> a owl:ObjectProperty ;
    rdfs:label "hasSkill"@en ;
    rdfs:comment "parthood relation between a competence and skill"@en ;
    rdfs:domain <http://purl.org/coreo#PersonalCompetence> ;
    rdfs:range <http://purl.org/coreo#Skill> ;
    rdfs:subPropertyOf ns1:isAspectProperPartOf .

<http://purl.org/coreo#specializes> a owl:ObjectProperty ;
    rdfs:label "specializesArtifact"@en ;
    rdfs:comment "specialization relation between types symbolizing the types that are instances of other type"@en ;
    rdfs:domain <http://purl.org/coreo#ArtifactType> ;
    rdfs:range <http://purl.org/coreo#ArtifactType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#specializes_1> .

<http://purl.org/coreo#specializes_2> a owl:ObjectProperty ;
    rdfs:label "specializesAspect"@en ;
    rdfs:comment "specialization relation between types symbolizing the types that are instances of other type"@en ;
    rdfs:domain <http://purl.org/coreo#HumanAspectType> ;
    rdfs:range <http://purl.org/coreo#HumanAspectType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#specializes_1> .

<http://purl.org/coreo#specializes_3> a owl:ObjectProperty ;
    rdfs:label "specializesTask"@en ;
    rdfs:comment "specialization relation between types symbolizing the types that are instances of other type"@en ;
    rdfs:domain <http://purl.org/coreo#TaskType> ;
    rdfs:range <http://purl.org/coreo#TaskType> ;
    rdfs:subPropertyOf <http://purl.org/coreo#specializes_1> .

<http://purl.org/coreo#specializes_4> a owl:ObjectProperty ;
    rdfs:label "specializesRole"@en ;
    rdfs:comment "specialization relation between types symbolizing the types that are instances of other type"@en ;
    rdfs:domain <http://purl.org/coreo#CapabilityRequiringRole> ;
    rdfs:range <http://purl.org/coreo#CapabilityRequiringRole> ;
    rdfs:subPropertyOf <http://purl.org/coreo#specializes_1> .

<http://purl.org/coreo#standsIn> a owl:ObjectProperty ;
    rdfs:label "standsInContext"@en ;
    rdfs:comment "Details the coreo:Resource that stands in a coreo:CompetenceContext"@en ;
    rdfs:domain <http://purl.org/coreo#Resource> ;
    rdfs:range <http://purl.org/coreo#CompetenceContext> ;
    rdfs:subPropertyOf ns1:standsIn .

<http://purl.org/coreo#standsIn_1> a owl:ObjectProperty ;
    rdfs:label "standsInContext"@en ;
    rdfs:comment "Details the coreo:Artifact that stands in a coreo:CompetenceContext"@en ;
    rdfs:domain <http://purl.org/coreo#Artifact> ;
    rdfs:range <http://purl.org/coreo#CompetenceContext> ;
    rdfs:subPropertyOf ns1:standsIn .

<http://purl.org/coreo#standsIn_2> a owl:ObjectProperty ;
    rdfs:label "standsInOutcome"@en ;
    rdfs:comment "Details the coreo:Artifact that stands in a coreo:CompetenceOutcome"@en ;
    rdfs:domain <http://purl.org/coreo#Artifact> ;
    rdfs:range <http://purl.org/coreo#CompetenceOutcome> ;
    rdfs:subPropertyOf ns1:standsIn .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

ns1:categorizes a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

<https://www.w3.org/1999/02/22-rdf-syntax-ns#type> a owl:AnnotationProperty .

<http://purl.org/coreo#Agent> a ns1:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Agent"@en ;
    rdfs:comment "Agents are objects that perceive events and perform actions based on their intentions"@en ;
    rdfs:subClassOf ns1:Object .

<http://purl.org/coreo#AttitudeType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "AttitudeType"@en ;
    rdfs:comment "A gufo:Type whose instances are coreo:Attitude. \\n\\nInstances of coreo:AttitudeType are subclasses of coreo:Attitude.\\n\\nExamples include the coreo:HumanAttitude \"Collaboration\""@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanAspectType> .

<http://purl.org/coreo#Evidence> a ns1:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Evidence"@en ;
    rdfs:comment "Any object (social or not) used to prove a human capability. \\nE.G.  John's graduation certification in computer science,  Mary's project participation."@en ;
    rdfs:subClassOf ns1:ConcreteIndividual .

<http://purl.org/coreo#Field> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Field"@en ;
    rdfs:comment "Knowledge Area"@en ;
    rdfs:subClassOf ns1:ConcreteIndividualType .

<http://purl.org/coreo#HumanTrait> a ns1:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HumanTrait"@en ;
    rdfs:comment "Traits inherent to an individual, e.g. John's introversion, Paul's interest, Mary's hobbies"@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanAspect> .

<http://purl.org/coreo#KnowledgeType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "KnowledgeType"@en ;
    rdfs:comment "A gufo:Type whose instances are coreo:Knowledge. \\n\\nInstances of coreo:KnowledgeType are subclasses of coreo:Knowledge.\\n\\nExamples include the the coreo:KnowledgeType \"Quantum Physics\""@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanAspectType> .

<http://purl.org/coreo#ResourceType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ResourceType"@en ;
    ns1:categorizes <http://purl.org/coreo#Resource> ;
    rdfs:comment "A gufo:Type whose instances are coreo:Resource. \\n\\nInstances of coreo:ResourceType are subclasses of coreo:Resource.\\n\\nExamples include \"Tool\", \"Software\", \"Hardware\""@en ;
    rdfs:subClassOf <http://purl.org/coreo#SubstantialType> .

<http://purl.org/coreo#constitutesType> a owl:ObjectProperty ;
    rdfs:label "constitutesType"@en ;
    rdfs:comment "Describes the constitutive relationship between types manifested as parthood relationships between their instances"@en ;
    rdfs:domain ns1:Type ;
    rdfs:range ns1:Type .

<http://purl.org/coreo#performed> a owl:ObjectProperty ;
    rdfs:label "performed"@en ;
    rdfs:comment "participation of a person in a human task"@en ;
    rdfs:domain <http://purl.org/coreo#Person> ;
    rdfs:range <http://purl.org/coreo#HumanTask> ;
    rdfs:subPropertyOf ns1:participatedIn .

<http://purl.org/coreo#wasGeneratedIn> a owl:ObjectProperty ;
    rdfs:label "wasGeneratedIn"@en ;
    rdfs:comment "output generation from a coreo:HumanTask"@en ;
    rdfs:domain <http://purl.org/coreo#TaskOutput> ;
    rdfs:range <http://purl.org/coreo#HumanTask> ;
    rdfs:subPropertyOf ns1:wasCreatedIn .

<http://purl.org/coreo#wasManifestedIn> a owl:ObjectProperty ;
    rdfs:label "wasManifestedInTask"@en ;
    rdfs:comment "Identifies a coreo:HumanTask in which the coreo:HumanAspect is manifested."@en ;
    rdfs:domain <http://purl.org/coreo#HumanAspect> ;
    rdfs:range <http://purl.org/coreo#HumanTask> ;
    rdfs:subPropertyOf ns1:manifestedIn .

<http://purl.org/coreo#wasManifestedIn_1> a owl:ObjectProperty ;
    rdfs:label "wasManifestedIn"@en ;
    rdfs:comment "Identifies a coreo:HumanTask in which the coreo:HumanCapability is manifested."@en ;
    rdfs:domain <http://purl.org/coreo#HumanCapability> ;
    rdfs:range <http://purl.org/coreo#HumanTask> ;
    rdfs:subPropertyOf ns1:manifestedIn .

<http://purl.org/coreo#wasUsedIn> a owl:ObjectProperty ;
    rdfs:label "wasUsedIn"@en ;
    rdfs:comment "usage of a artifact in a human task as input"@en ;
    rdfs:domain <http://purl.org/coreo#TaskInput> ;
    rdfs:range <http://purl.org/coreo#HumanTask> ;
    rdfs:subPropertyOf ns1:participatedIn .

<http://purl.org/coreo#wasUsedIn_1> a owl:ObjectProperty ;
    rdfs:label "wasUsedIn"@en ;
    rdfs:comment "usage of an object in a human task as a resource"@en ;
    rdfs:domain <http://purl.org/coreo#Resource> ;
    rdfs:range <http://purl.org/coreo#HumanTask> ;
    rdfs:subPropertyOf ns1:participatedIn .

<http://purl.org/coreo#Attitude> a ns1:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Attitude"@en ;
    rdfs:comment "Attitude is a tendency to act (or feel) in a given situation (Maze, 2011) inherent to an individual, based on assumptions, values, and beliefs (Maze, 2011). In general, definitions of attitude take into account the following characteristics: (i) mental state; (ii) values (beliefs, \\nemotions); and (iii) predisposition to act or behave (ALTMANN, 2008).\\n\\nE.g. John' accuracy, Paul' responsability, Mary' colaboration\\n\\nALTMANN, Tanya K. Attitude: a concept analysis. In: Nursing forum. Malden, USA: Blackwell Publishing Inc, 2008. p. 144-150.\\n\\nMAZE, John R. The concept of attitude. In: Realism and Psychology. Brill, 2011. p. 183-230."@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanAspect> .

<http://purl.org/coreo#CompetenceOutcome> a ns1:SituationType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "CompetenceOutcome"@en ;
    rdfs:subClassOf ns1:Situation .

<http://purl.org/coreo#HumanQuality> a ns1:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HumanQuality"@en ;
    rdfs:comment "Qualities inherent to a person, e.g. age, gender, height, etc."@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanAspect> .

<http://purl.org/coreo#Knowledge> a ns1:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Knowledge"@en ;
    rdfs:comment "Knowledge is typically associated with internal representations of facts, principles, or theories (WESTERA, 2001) by an individual. and that can be manifested through actions.\\n\\nE.G., Paul' quantum theory knowledge\\n\\nWESTERA, Wim. Competences in education: a confusion of tongues. Journal of Curriculum studies, v. 33, n. 1, p. 75-88, 2001."@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanAspect> .

<http://purl.org/coreo#MomentType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "AspectType"@en ;
    rdfs:comment "A gufo:Type whose instances are aspects. \\n\\nInstances of AspectType are subclasses of gufo:Aspect.\\n\\nExamples include the aspect kind \"age\", \"knowledge\", and \"mariage\""@en ;
    rdfs:subClassOf ns1:EndurantType .

<http://purl.org/coreo#Proficiency> a ns1:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Proficiency"@en ;
    rdfs:comment "Intencity or deepness of a human capability. Can be related to level, degree, score, or other quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://purl.org/coreo#HumanCapability> ;
            owl:onProperty <http://purl.org/coreo#inheresIn> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:Quality .

<http://purl.org/coreo#SubstantialType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ObjectType"@en,
        "SubstantialType"@en ;
    rdfs:comment "A gufo:Type whose instances are objects. \\n\\nInstances of ObjectType are subclasses of Object.\\n\\nExamples include the object kinds \"Car\", \"Person\", \"Apple\""@en ;
    rdfs:subClassOf ns1:EndurantType .

<http://purl.org/coreo#TaskInput> a ns1:RoleMixin,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "TaskInput"@en ;
    rdfs:comment "Artifact used in a task as manifestation of a human capability"@en ;
    rdfs:subClassOf <http://purl.org/coreo#Artifact> .

<http://purl.org/coreo#TaskOutput> a ns1:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "TaskOutput"@en ;
    rdfs:comment "Artifact created or changed in a task as manifestation of a human capability"@en ;
    rdfs:subClassOf <http://purl.org/coreo#Artifact> .

<http://purl.org/coreo#competenceContextContributedToTriggerHumanTask> a owl:ObjectProperty ;
    rdfs:label "activatesTask"@en ;
    rdfs:comment "Identifies a coreo:HumanTask that the coreo:CompetenceContext contributed to trigger."@en ;
    rdfs:domain <http://purl.org/coreo#CompetenceContext> ;
    rdfs:range <http://purl.org/coreo#HumanTask> ;
    rdfs:subPropertyOf ns1:contributedToTrigger .

<http://purl.org/coreo#inheresIn> a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "inheresInHumanCapability"@en ;
    rdfs:comment "relates a coreo:Proficiency to the correspondent coreo:HumanCapability"@en ;
    rdfs:domain <http://purl.org/coreo#Proficiency> ;
    rdfs:range <http://purl.org/coreo#HumanCapability> ;
    rdfs:subPropertyOf ns1:inheresIn .

<http://purl.org/coreo#inheresIn_1> a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "CapabilityInheresInPerson"@en ;
    rdfs:comment "relates the coreo:HumanCapability to the correspondent coreo:Person"@en ;
    rdfs:domain <http://purl.org/coreo#HumanCapability> ;
    rdfs:range <http://purl.org/coreo#Person> ;
    rdfs:subPropertyOf <http://purl.org/coreo#inheresIn_2> .

<http://purl.org/coreo#inheresIn_2> a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "inheresInPerson"@en ;
    rdfs:comment "relates the coreo:HumanAspect to the correspondent coreo:Person"@en ;
    rdfs:domain <http://purl.org/coreo#HumanAspect> ;
    rdfs:range <http://purl.org/coreo#Person> ;
    rdfs:subPropertyOf ns1:inheresIn .

<http://purl.org/coreo#CompetenceContext> a ns1:SituationType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Competence Context"@en,
        "CompetenceContext"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/coreo#competenceContextContributedToTriggerHumanTask> ;
            owl:someValuesFrom <http://purl.org/coreo#HumanTask> ],
        ns1:Situation .

<http://purl.org/coreo#Resource> a ns1:RoleMixin,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Resource"@en ;
    rdfs:comment "Any object used in a task by a person as manifestation of a human capability\\n\\nE.G. John's Integrated Development Environment (IDE)"@en ;
    rdfs:subClassOf ns1:Object .

<http://purl.org/coreo#Skill> a ns1:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Skill"@en ;
    rdfs:comment "Skill is a human capability of an individual to perform a task (discrete unit of work) well (RODRIGUES et al, 2021), not strongly related to a context. \\n\\nE.G. John' programming skill, Pelé's kick skill\\n\\n\\nRODRIGUES, Margarida; FERNÁNDEZ-MACÍAS, Enrique; SOSTERO, Matteo. A unified conceptual framework of tasks, skills and competences. JRC Working Papers Series on Labour, Education and Technology, 2021."@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanCapability> .

<http://purl.org/coreo#dependsOnType> a owl:ObjectProperty ;
    rdfs:label "dependsOnType"@en ;
    rdfs:comment "Describes the dependence relationship between types manifested as dependence relationships between their instances"@en ;
    rdfs:domain ns1:Type ;
    rdfs:range ns1:Type .

<http://purl.org/coreo#specializes_1> a owl:ObjectProperty ;
    rdfs:label "specializes"@en ;
    rdfs:comment "specialization relation between types symbolizing the types that are instances of other type"@en ;
    rdfs:domain ns1:Type ;
    rdfs:range ns1:Type .

<http://purl.org/coreo#Artifact> a ns1:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Artifact"@en ;
    rdfs:comment "Human-made object produced, used, or changed in task as a result of human capabilities\\n\\nE.G., Web form code (produced by John)" ;
    rdfs:subClassOf ns1:Object .

<http://purl.org/coreo#describedBy> a owl:ObjectProperty ;
    rdfs:label "describedBy"@en ;
    rdfs:comment "Relationship used to detail a type"@en ;
    rdfs:domain ns1:Type ;
    rdfs:range ns1:Type .

<http://purl.org/coreo#ArtifactType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ArtifactType"@en ;
    ns1:categorizes <http://purl.org/coreo#Artifact> ;
    rdfs:comment "A gufo:Type whose instances are coreo:Artifact. \\n\\nInstances of coreo:ArtifactType are subclasses of coreo:Artifact.\\n\\nExamples include \"Web Form\", \"Class Diagram\", \"Painting\", a \"Sculpture\""@en ;
    rdfs:subClassOf <http://purl.org/coreo#SubstantialType> .

<http://purl.org/coreo#CapabilityRequiringRole> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "CapabilityRequiringRole"@en ;
    ns1:categorizes <http://purl.org/coreo#Person> ;
    rdfs:subClassOf ns1:Role .

<http://purl.org/coreo#HumanCapabilityType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HumanCapabilityType"@en ;
    ns1:categorizes <http://purl.org/coreo#HumanCapability> ;
    rdfs:comment "A gufo:Type whose instances are dispositions. \\n\\nInstances of coreo:HumanCapabilityType are subclasses of coreo:HumanCapability.\\n\\nExamples include the skill type of \"Java Programming\" and competence type of \"Software Development\""@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanAspectType> .

<http://purl.org/coreo#Person> a ns1:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Person"@en ;
    rdfs:comment "Physical agent that are human being"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://purl.org/coreo#HumanCapability> ;
            owl:onProperty [ owl:inverseOf <http://purl.org/coreo#inheresIn_1> ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://purl.org/coreo#Agent> .

<http://purl.org/coreo#TaskType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "TaskType"@en ;
    ns1:categorizes <http://purl.org/coreo#HumanTask> ;
    rdfs:comment "A gufo:Type whose instances are coreo:Task. \\n\\nInstances of coreo:TaskType are subclasses of coreo:Task.\\n\\nExamples include \"Develop a Software\", \"Perform a Interview\""@en ;
    rdfs:subClassOf ns1:EventType .

<http://purl.org/coreo#HumanCapability> a ns1:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HumanCapability"@en ;
    rdfs:comment "Human ability to perform some task in some situation, inherent to an individual. Includes skills and personal competences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.org/coreo#wasManifestedIn_1> ;
            owl:someValuesFrom <http://purl.org/coreo#HumanTask> ],
        [ a owl:Restriction ;
            owl:onClass <http://purl.org/coreo#Person> ;
            owl:onProperty <http://purl.org/coreo#inheresIn_1> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://purl.org/coreo#inheresIn> ] ;
            owl:someValuesFrom <http://purl.org/coreo#Proficiency> ],
        <http://purl.org/coreo#HumanAspect> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://purl.org/coreo#PersonalCompetence> <http://purl.org/coreo#Skill> ) ] .

<http://purl.org/coreo#HumanAspectType> a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HumanAspectType"@en ;
    ns1:categorizes <http://purl.org/coreo#HumanAspect> ;
    rdfs:comment "A gufo:Type whose instances are coreo:HumanAspect. \\n\\nInstances of coreo:HumanAspectType are subclasses of coreo:HumanAspect.\\n\\nExamples include the coreo:SkillType \"Java Programming\", the coreo:CompetenceType \"Software Development\", the coreo:HumanAttitude \"Collaboration\", the coreo:HumanKnowledge \"Quantum Physics\", the coreo:HumanCharacteristic \"Age\", \"Gender\", and \"Interest\""@en ;
    rdfs:subClassOf <http://purl.org/coreo#MomentType> .

<http://purl.org/coreo#PersonalCompetence> a ns1:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "PersonalCompetence"@en ;
    rdfs:comment "Competence is a human capability inherent to an individual and formed by the combination of perceptible characteristics, such as the ``well-known'' knowledge, skills, and attitudes (KSA) elements. \\n\\n\\nE.G. John's agile software development competence, Ronaldo's football playing competence"@en ;
    rdfs:subClassOf <http://purl.org/coreo#HumanCapability> ;
    owl:disjointWith <http://purl.org/coreo#Skill> .

<http://purl.org/coreo#HumanTask> a ns1:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HumanTask"@en ;
    rdfs:comment "Event performed by a person as a result of the manifestation of his/her human capabilities"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://purl.org/coreo#wasGeneratedIn> ] ;
            owl:someValuesFrom <http://purl.org/coreo#TaskOutput> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://purl.org/coreo#performed> ] ;
            owl:someValuesFrom <http://purl.org/coreo#Person> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <http://purl.org/coreo#CompetenceContext> ;
            owl:onProperty [ owl:inverseOf <http://purl.org/coreo#competenceContextContributedToTriggerHumanTask> ] ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://purl.org/coreo#wasUsedIn> ] ;
            owl:someValuesFrom <http://purl.org/coreo#TaskInput> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://purl.org/coreo#wasUsedIn_1> ] ;
            owl:someValuesFrom <http://purl.org/coreo#Resource> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <http://purl.org/coreo#wasManifestedIn> ] ;
            owl:someValuesFrom <http://purl.org/coreo#HumanAspect> ],
        ns1:Event .

<http://purl.org/coreo#HumanAspect> a ns1:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HumanAspect"@en ;
    rdfs:comment "Aspects inherent to an individual. Includes human capabilities (skills and competences), knowledge, attidutes, and other characteristics (human qualities as age, gender, etc and human traits)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://purl.org/coreo#Person> ;
            owl:onProperty <http://purl.org/coreo#inheresIn_2> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:IntrinsicMode .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/coreo#AttitudeType> <http://purl.org/coreo#HumanCapabilityType> <http://purl.org/coreo#KnowledgeType> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://purl.org/coreo#Attitude> <http://purl.org/coreo#HumanCapability> <http://purl.org/coreo#HumanQuality> <http://purl.org/coreo#HumanTrait> <http://purl.org/coreo#Knowledge> ) .

