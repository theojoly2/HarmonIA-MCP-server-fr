@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://schema.org/> .
@prefix onto: <http://data.cochrane.org/ontologies/core/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:Age a owl:Class ;
    rdfs:label "Age"@en ;
    rdfs:comment "A Age of some defined population."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:AggregationMethod a owl:Class ;
    rdfs:label "AggregationMethod"@en ;
    rdfs:comment "An Aggregation method used in defining an outcome."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:AssessmentScale a owl:Class ;
    rdfs:label "AssessmentScale"@en ;
    rdfs:comment "An AssessmentScale that an outcome is measured against."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "A Condition of some defined population."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:Device a owl:Class ;
    rdfs:label "Device"@en ;
    rdfs:comment "A Device used as intervention"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Material .

onto:DeviceCategory a owl:Class ;
    rdfs:label "DeviceCategory"@en ;
    rdfs:comment "A category or class of Device"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:InterventionCategory .

onto:Drug a owl:Class ;
    rdfs:label "Drug"@en ;
    rdfs:comment "A Drug used as intervention"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Material .

onto:DrugCategory a owl:Class ;
    rdfs:label "DrugCategory"@en ;
    rdfs:comment "A category or class of drug"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:InterventionCategory .

onto:InterventionClassification a owl:Class ;
    rdfs:label "InterventionClassification"@en ;
    rdfs:comment "The classification of an intervention."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:InterventionProvider a owl:Class ;
    rdfs:label "InterventionProvider"@en ;
    rdfs:comment "Some agent that provides or delivers an intervention."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:InterventionRationale a owl:Class ;
    rdfs:label "InterventionRationale"@en ;
    rdfs:comment "The rationale for providing an intervention."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:ModeOfDelivery a owl:Class ;
    rdfs:label "ModeOfDelivery"@en ;
    rdfs:comment "The mechanism by which an intervention is delivered."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:OutcomeClassification a owl:Class ;
    rdfs:label "OutcomeClassification"@en ;
    rdfs:comment "The classification of an outcome."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:Procedure a owl:Class ;
    rdfs:label "Procedure"@en ;
    rdfs:comment "A Procedure used as intervention"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:AppliedIntervention .

onto:ProcedureCategory a owl:Class ;
    rdfs:label "ProcedureCategory"@en ;
    rdfs:comment "A category or class of procedure"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:InterventionCategory .

onto:Setting a owl:Class ;
    rdfs:label "Setting"@en ;
    rdfs:comment "The setting in which an intervention is delivered (eg clininc, hospital, at home)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:Sex a owl:Class ;
    rdfs:label "Sex"@en ;
    rdfs:comment "A Sex of some defined population."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:SpecificMetric a owl:Class ;
    rdfs:label "SpecificMetric"@en ;
    rdfs:comment "A specific metric used in defining an outcome."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:Treatment a owl:Class ;
    rdfs:label "Treatment"@en ;
    rdfs:comment "A Treatment some population is undergoing."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:alternateLabel a owl:DatatypeProperty ;
    rdfs:alternateLabel "alternateLabel"@en ;
    rdfs:comment "The alternate label or synonym of something."@en ;
    rdfs:domain onto:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString .

onto:equivalentConcept a owl:ObjectProperty ;
    rdfs:label "equivalentConcept"@en ;
    rdfs:comment "Relates a Concept to an equivalent one."@en ;
    rdfs:domain onto:Concept ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Concept .

onto:inCategory a owl:ObjectProperty ;
    rdfs:label "inCategory"@en ;
    rdfs:comment "Relates an intervention to an intervention category."@en ;
    rdfs:domain onto:Concept ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:AppliedIntervention ;
    rdfs:subPropertyOf onto:broaderConcept .

onto:inConceptScheme a owl:ObjectProperty ;
    rdfs:label "inConceptScheme"@en ;
    rdfs:comment "Relates a Concept to its ConceptScheme"@en ;
    rdfs:domain onto:Concept ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ConceptScheme .

onto:label a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "label"@en ;
    rdfs:comment "The label of something."@en ;
    rdfs:domain onto:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString ;
    rdfs:subPropertyOf rdfs:label .

onto:lastModifiedDate a owl:DatatypeProperty ;
    rdfs:label "lastModifiedDate"@en ;
    rdfs:comment "The date/time a concept was last modified (workflow/provenance)."@en ;
    rdfs:domain onto:Concept ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:dateTime .

onto:longLabel a owl:DatatypeProperty ;
    rdfs:comment "The long label of something."@en ;
    rdfs:domain onto:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:longLabel "longLabel"@en ;
    rdfs:range rdf:langString .

onto:modifiedBy a owl:DatatypeProperty ;
    rdfs:label "modifiedBy"@en ;
    rdfs:comment "The agent that modified the concept (workflow/provenance)."@en ;
    rdfs:domain onto:Concept ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:narrowerConcept a owl:ObjectProperty ;
    rdfs:label "narrowerConcept"@en ;
    rdfs:comment "Relates a Concept to a narrower one in the same concept scheme."@en ;
    rdfs:domain onto:Concept ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Concept .

onto:shortLabel a owl:DatatypeProperty ;
    rdfs:comment "The short label of something."@en ;
    rdfs:domain onto:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:langString ;
    rdfs:shortLabel "shortLabel"@en .

dc:abstract a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

ns1:image a owl:AnnotationProperty .

rdfs:alternateLabel a owl:AnnotationProperty .

rdfs:longLabel a owl:AnnotationProperty .

rdfs:shortLabel a owl:AnnotationProperty .

onto:ConceptScheme a owl:Class ;
    rdfs:label "ConceptScheme"@en ;
    rdfs:comment "A scheme that a concept exists within"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Thing .

onto:broaderConcept a owl:ObjectProperty ;
    rdfs:label "broaderConcept"@en ;
    rdfs:comment "Relates a Concept to a broader one in the same concept scheme."@en ;
    rdfs:domain onto:Concept ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Concept .

onto:Material a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:comment "A material used as intervention"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:AppliedIntervention .

onto:InterventionCategory a owl:Class ;
    rdfs:label "InterventionCategory"@en ;
    rdfs:comment "A category or class of applied intervention"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:AppliedIntervention .

onto:AppliedIntervention a owl:Class ;
    rdfs:label "AppliedIntervention"@en ;
    rdfs:comment "Am applied intervention used to treat some condition"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Concept .

onto:Thing a owl:Class ;
    rdfs:label "Thing"@en ;
    rdfs:comment "A Thing"@en ;
    rdfs:isDefinedBy onto: .

onto:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "A vocabulary concept"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Thing .

onto: a owl:Ontology ;
    dc:abstract "The Cochrane Core ontology describes the entities and concepts that exist in the domain of evidence based healthcare.\\n    It is used for the construction of the Cochrane Linked Data Vocabulary containing some 400k terms including Interventions (Drugs, Procedures etc), Populations (Age, Sex, Condition), and clinical Outcomes."@en ;
    dc:creator "Chris Mavergames",
        "Julian Everett",
        "Lorne Becker",
        "Paul Wilton",
        "Silver Oliver" ;
    dc:publisher "Cochrane" ;
    dcterms:created "2014-02-06"^^xsd:date ;
    dcterms:description "The Cochrane Core ontology describes the entities and concepts that exist in the domain of evidence based healthcare."@en ;
    dcterms:modified "2019-09-06"^^xsd:date ;
    dcterms:rights "Copyright Cochrane 2020. Creative Commons License: CC BY-NC-ND : Attribution-NonCommercial-NoDerivs : https://creativecommons.org/licenses/by-nc-nd/4.0"@en ;
    dcterms:title "Cochrane Core Vocabulary Ontology"@en ;
    vann:preferredNamespacePrefix "cc" ;
    vann:preferredNamespaceUri "http://data.cochrane.org/ontologies/core/" ;
    ns1:image "https://data.cochrane.org/ontologies/pico/PICO-ontology.png" ;
    rdfs:comment "The Cochrane Core ontology describes the entities and concepts that exist in the domain of evidence based healthcare."@en ;
    owl:versionInfo "2.0.1" .

