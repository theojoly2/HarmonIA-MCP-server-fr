                                                    owl:onProperty ns1:OBI_1110119 ;
                                                    owl:someValuesFrom ns1:GO_0042571 ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
