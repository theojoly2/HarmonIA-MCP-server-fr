ns1:OBI_0001909 a owl:Class ;
    rdfs:label "conclusion based on data" ;
    ns1:IAO_0000111 "conclusion based on data" ;
    ns1:IAO_0000112 "The conclusion that a gene is upregulated in a tissue sample based on the band intensity in a western blot. The conclusion that a patient has a infection based on measurement of an elevated body temperature and reported headache. The conclusion that there were problems in an investigation because data from PCR and microarray are conflicting.\\nThe following are NOT conclusions based on data: data themselves; results from pure mathematics, e.g. \"13 is prime\"." ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An information content entity that is inferred from data." ;
    ns1:IAO_0000116 "In the Philly 2013 workshop, we recognized the limitations of \"conclusion textual entity\", and we introduced this as more general. The need for the 'textual entity' term going forward is up for future debate. " ;
    ns1:IAO_0000117 "Group:2013 Philly Workshop group" ;
    ns1:IAO_0000119 "Group:2013 Philly Workshop group" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0000338 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000124 ;
            owl:someValuesFrom ns1:IAO_0000027 ],
        ns1:IAO_0000030 .

ns1:OBI_0001917 a owl:Class ;
    rdfs:label "chromosome conformation identification objective"@en ;
    ns1:IAO_0000111 "chromosome conformation identification objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A molecular feature identification objective that aims to determine spatial organization of chromatin." ;
    ns1:IAO_0000117 "Chris Stoeckert, Jie Zheng" ;
    ns1:IAO_0000119 "Group: Penn Group" ;
    rdfs:subClassOf ns1:OBI_0000131 .

ns1:OBI_0001926 a owl:Class ;
    rdfs:label "microRNA profiling assay" ;
    ns1:IAO_0000111 "microRNA profiling assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A transcription profiling assay that quantifies the microRNA species within a biological sample."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string,
        "Jie Zheng"^^xsd:string,
        "Venkat Malladi"^^xsd:string ;
    ns1:IAO_0000118 "miRNA expression assay"^^xsd:string,
        "microRNA expression assay"^^xsd:string ;
    ns1:IAO_0000119 "PMID: 23382819"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:OBI_0000880 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000880 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:SO_0000276 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000101 ],
        ns1:OBI_0000424 .

ns1:OBI_0001927 a owl:ObjectProperty ;
    rdfs:label "specifies value of" ;
    ns1:IAO_0000111 "specifies value of" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A relation between a value specification and an entity which the specification is about." ;
    rdfs:domain ns1:OBI_0001933 ;
