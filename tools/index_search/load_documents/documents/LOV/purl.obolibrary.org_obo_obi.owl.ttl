ns1:OBI_0000494 a owl:Class ;
    rdfs:label "liquid chromatography autosampler"@en ;
    ns1:IAO_0000111 "liquid chromatography autosampler"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Designed to perform capillary LC with injection of sample volumes ranging from nL to L."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01061"^^xsd:string,
