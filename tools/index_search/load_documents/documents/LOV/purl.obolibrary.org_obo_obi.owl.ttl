ns1:OBI_0001265 a owl:Class ;
    rdfs:label "FWER adjusted p-value"^^xsd:string ;
    ns1:IAO_0000111 "FWER adjusted p-value"^^xsd:string ;
    ns1:IAO_0000112 "http://ugrad.stat.ubc.ca/R/library/LPE/html/mt.rawp2adjp.html"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A quantitative confidence value resulting from a multiple testing error correction method which adjusts the p-value used as input to control for Type I error in the context of multiple pairwise tests"@en ;
    ns1:IAO_0000117 "PERS:Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "adapted from wikipedia (http://en.wikipedia.org/wiki/Familywise_error_rate) "@en ;
    rdfs:subClassOf ns1:OBI_0000071 .

ns1:OBI_0001351 a owl:Class ;
    rdfs:label "epitope specific tumor necrosis factor superfamily cytokine production by T cells"^^xsd:string ;
