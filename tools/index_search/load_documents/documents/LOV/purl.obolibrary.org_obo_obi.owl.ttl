    rdfs:comment "The 'term requester' can credit the person, organization or project who request the ontology term." .

ns1:IAO_0000304 a owl:Class ;
    rdfs:label "caption"@en ;
    ns1:IAO_0000111 "caption"@en ;
    ns1:IAO_0000112 "Figure 1: A system diagram describing the modules of the Hanalyzer.  Reading methods (green) take external sources of knowledge (blue) and extract information from them, either by parsing structured data or biomedical language processing to extract information from unstructured data.  Reading modules are responsible for tracking the provenance of all knowledge.  Reasoning methods (yellow) enrich the knowledge that results from reading by, for example, noting two genes that are annotated to the same ontology term or database entry.  All knowledge sources, read or reasoned, are assigned a reliability score, and all are combined using that score into a knowledge network (orange) that represents the integration of all sorts of relationship between a pair of genes and a combined reliability score.  A data network (also orange) is created from experimental results to be analyzed.  The reporting modules (pink) integrate the data and knowledge networks, producing visualizations that can be queried with the associated drill-down tool."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A textual entity that describes a figure"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:IAO_0000308 ],
        ns1:IAO_0000300 .

ns1:IAO_0000307 a owl:Class ;
    rdfs:label "table of abbreviations"@en ;
    ns1:IAO_0000111 "table of abbreviations"@en ;
    ns1:IAO_0000112 "IAO  information artifact ontology\\nOBI  ontology of biomedical investiations\\nGO   gene ontology"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A table where the constituent texts are abbreviations and their expansions"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf ns1:IAO_0000306 .

ns1:IAO_0000312 a owl:Class ;
    rdfs:label "publication about an investigation"@en ;
    ns1:IAO_0000111 "publication about an investigation"@en ;
    ns1:IAO_0000112 "Most scientific journal articles"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A publication that is about an investigation"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    ns1:IAO_0000118 "scientific publication"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:OBI_0000066 ],
        ns1:IAO_0000311 .

ns1:IAO_0000313 a owl:Class ;
    rdfs:label "patent"@en ;
    ns1:IAO_0000111 "patent"@en ;
    ns1:IAO_0000112 "US Patent 6,449,603"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A document that has been accepted by a patent authority"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf ns1:IAO_0000310 .

ns1:IAO_0000315 a owl:Class ;
    rdfs:label "abstract"@en ;
    ns1:IAO_0000111 "abstract"@en ;
    ns1:IAO_0000112 "The profusion of high-throughput instruments and the explosion of new results in the scientific literature, particularly in molecular biomedicine, is both a blessing and a curse to the bench researcher.   Even knowledgeable and experienced scientists can benefit from computational tools that help navigate this vast and rapidly evolving terrain. In this paper, we describe a novel computational approach to this challenge, a knowledge-based system that combines reading, reasoning and reporting methods to facilitate analysis of experimental data. Reading methods extract information from external resources, either by parsing structured data or biomedical language processing to extract information from unstructured data, and track knowledge provenance.  Reasoning methods enrich the knowledge that results from reading by, for example, noting two genes that are annotated to the same ontology term or database entry.  Reasoning is also used to combine all sources into a knowledge network that represents the integration of all sorts of relationships between a pair of genes, and to calculate a combined reliability score. Reporting methods combine the knowledge network with a congruent network constructed from experimental data and visualize the combined network in a tool that facilitates the knowledge-based analysis of that data."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A summary of the entire document that is substantially smaller than the document it summarizes.  It is about the document it summarizes."@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:IAO_0000310 ],
        ns1:IAO_0000314 .

ns1:IAO_0000316 a owl:Class ;
    rdfs:label "introduction to a publication about an investigation"@en ;
    ns1:IAO_0000111 "introduction to a publication about an investigation"@en ;
    ns1:IAO_0000112 "Section labelled 'introduction' of a typical scientific journal article"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A part of a publication about an investigation that is about the objective specification (why the investigation is being done)"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    ns1:IAO_0000118 "background"@en,
        "introduction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:IAO_0000005 ],
        ns1:IAO_0000314 .

