ns1:OBI_0000116 a owl:Class ;
    rdfs:label "worker role"@en ;
    ns1:IAO_0000111 "worker role"^^xsd:string ;
    ns1:IAO_0000112 "Public sector workers in states that run their own OSHA programs are covered by those states.   http://www.osha.gov/as/opa/worker/index.html"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a personnel role played by a party who executes a component of the study plan; this can occur before, during, after or outside the study timeline"@en ;
    ns1:IAO_0000116 "\"executes the study plan\" includes the suppliers and manufacturers of reagents and other materials used in the study"^^xsd:string ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "worker"^^xsd:string ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf ns1:OBI_0000202 .

ns1:OBI_0000268 a owl:Class ;
    rdfs:label "organism feature identification objective"@en ;
    ns1:IAO_0000111 "organism feature identification objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Organism_feature_identification_objective is a biological_feature_identification_objective role describing a study designed to examine or characterize a biological feature monitored at the level of the organism, e.g. height, weight, stage of development, stage of life cycle."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000015 .

ns1:OBI_0000424 a owl:Class ;
    rdfs:label "transcription profiling assay" ;
    ns1:IAO_0000111 "transcription profiling assay" ;
    ns1:IAO_0000112 "Whole genome transcription profiling of Anaplasma phagocytophilum in human and tick host cells by tiling array analysis. BMC Genomics. 2008 Jul 31;9:364. PMID: 18671858"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that determines gene expression and transcription activity using ribonucleic acids collected from a material entity."^^xsd:string ;
    ns1:IAO_0000116 "This term should encompass transcription and post-transcription, but before translation into protein. So 'gene expression' itself is too broad, and we use 'transcription profiling identification objective' to constrain the scope of this term."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "gene expression profiling"^^xsd:string,
        "transcription profiling"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000070 [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000055 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000081 ;
                                                        owl:someValuesFrom ns1:OBI_0000880 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0000880 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000087 ;
                                                        owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000055 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0000275 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000052 ;
                                                        owl:someValuesFrom ns1:CHEBI_33697 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom ns1:CHEBI_33697 ] ) ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0100051 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom ns1:CHEBI_33697 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:IAO_0000109 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:IAO_0000136 ;
                                owl:someValuesFrom ns1:GO_0010467 ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0001331 ] ) ] .

