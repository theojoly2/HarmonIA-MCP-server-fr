ns1:OBI_0001684 a owl:Class ;
    rdfs:label "methylation-specific polymerase chain reaction assay" ;
    ns1:IAO_0000111 "methylation-specific polymerase chain reaction assay" ;
    ns1:IAO_0000112 "Methylation status of breast cancer resistance protein detected by methylation-specific polymerase chain reaction analysis is correlated inversely with its expression in drug-resistant lung cancer cells. PMID:18219662"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An assay that uses initial modification of DNA by sodium bisulfite, converting all unmethylated, but not methylated, cytosines to uracil, and subsequent amplification with primers specific for methylated versus unmethylated DNA."^^xsd:string ;
    ns1:IAO_0000117 "Marcus Chibucos"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "MSP"^^xsd:string ;
    ns1:IAO_0000119 "PMID:8790415"^^xsd:string ;
