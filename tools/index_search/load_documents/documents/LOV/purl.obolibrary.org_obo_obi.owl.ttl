        ns1:OBI_0666667 .

ns1:OBI_0000345 a owl:Class ;
    rdfs:label "mass analyzer"@en ;
    ns1:IAO_0000111 "mass analyzer"@en ;
    ns1:IAO_0000112 "The mass analyzer of the Voyager-DE(tm) STR Biospectrometry Workstation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A Mass analyzer is a device that separates ions according to their mass-to-charge ratio. All mass spectrometers are based on dynamics of charged particles in electric and magnetic fields in vacuum where the two laws of Lorentz force law and Newton's second law of motion apply."@en ;
    ns1:IAO_0000117 "Frank Gibson"^^xsd:string,
        "PERSON: Daniel Schober"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Mass_spectrometry#Mass_analyzer"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000372 ],
        ns1:OBI_0000832,
        ns1:OBI_0000932 .

ns1:OBI_0000361 a owl:Class ;
    rdfs:label "ion source"@en ;
    ns1:IAO_0000111 "ion source"@en ;
    ns1:IAO_0000112 "The ion source of a Voyager-DE??? STR Biospectrometry Workstation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An ion source is a device that is part of a mass\\nspectrometer that ionizes the material under analysis. The ions are\\nthen transported by magnetic or electric fields to the mass analyzer.\\nTechniques for ionization have been key to determining what types of\\nsamples can be analyzed by mass spectrometry. Electron ionization and\\nchemical ionization are used for gases and vapors. In chemical\\nionization sources, the material is ionized by chemical ion-molecule\\nreactions during collisions in the source. Two techniques often used\\nwith liquid and solid biological samples include electrospray\\nionization (due to John Fenn PMID 2675315.) and matrix-assisted laser\\ndesorption/ionization (MALDI, due to M. Karas and F. Hillenkamp\\n(Measuring Mass: From Positive Rays to Proteins by Michael A. Grayson\\n(Editor) (ISBN 0-941901-31-9)))."@en ;
    ns1:IAO_0000117 "Frank Gibson"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Mass_spectrometry#Ion_source"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000385 ],
        ns1:OBI_0000968 .

ns1:OBI_0000369 a owl:Class ;
    rdfs:label "magnify function"@en ;
    ns1:IAO_0000111 "magnify function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A magnify function is a function to increase the size of a transmitted object image through the precise arrangement of energy diffraction elements along an imaging path."@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0000384 a owl:Class ;
    rdfs:label "electricity supply function"@en ;
    ns1:IAO_0000111 "electricity supply function"@en ;
    ns1:IAO_0000112 "the function of supplying current during a neuroscience experiment."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An electricity supply function is an energy supply function to transfer electricity from one source to another, typically a consumer of the electricity or as a stimulus during a neuroscience experiment."@en ;
    ns1:IAO_0000117 "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    ns1:IAO_0000118 "power supply"@en ;
    rdfs:subClassOf ns1:OBI_0000391 .

ns1:OBI_0000391 a owl:Class ;
    rdfs:label "energy supply function"@en ;
    ns1:IAO_0000111 "energy supply function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An energy supply function is a function to supply or transfer energy from an energy source to a consumer of the energy"@en ;
    ns1:IAO_0000117 "Frank Gibson"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0000403 a owl:Class ;
    rdfs:label "sort function"@en ;
    ns1:IAO_0000111 "sort function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A sort function is a function to distinguish material components based on some associated physical quality or entity and to partition the separate components into distinct fractions according to a defined order."@en ;
    ns1:IAO_0000117 "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000372 .

ns1:OBI_0000409 a owl:Class ;
    rdfs:label "nucleic acid template role"@en ;
    ns1:IAO_0000111 "nucleic acid template role"^^xsd:string ;
    ns1:IAO_0000112 "a model or standard for making comparisons; wordnet.princeton.edu/perl/webwn 19 feb 2009"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a reference substance role which inheres in nucleic acid material entity and is realized in the process of using the nucleic acid bearing the template role as a reference during synthesis of a reverse copy."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000415 ;
            owl:onProperty ns1:BFO_0000054 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:CHEBI_33696 ],
        ns1:OBI_0000025 .

