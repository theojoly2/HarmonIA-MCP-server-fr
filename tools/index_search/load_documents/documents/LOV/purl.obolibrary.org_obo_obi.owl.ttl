    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000561 .

ns1:OBI_0000504 a owl:Class ;
    rdfs:label "sample injection system"@en ;
    ns1:IAO_0000111 "sample injection system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An automated chromatography system that injects the sample into the chromatography columns in order to increase speed and minimize human involvement in the purification process for  better reproducibility."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01057"^^xsd:string,
