ns1:CHEBI_33696 a owl:Class ;
    rdfs:label "nucleic acid"^^xsd:string ;
    ns1:IAO_0000111 "nucleic acid"^^xsd:string ;
    ns1:IAO_0000115 "A macromolecule made up of nucleotide units and hydrolysable into certain pyrimidine or purine bases (usually adenine, cytosine, guanine, thymine, uracil), D-ribose or 2-deoxy-D-ribose and phosphoric acid."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_33839 .

ns1:GO_0019814 a owl:Class ;
    rdfs:label "immunoglobulin complex"^^xsd:string ;
    ns1:IAO_0000111 "immunoglobulin complex"^^xsd:string ;
    ns1:IAO_0000115 "A protein complex that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains, held together by disulfide bonds and sometimes complexed with additional proteins. An immunoglobulin complex may be embedded in the plasma membrane or present in the extracellular space, in mucosal areas or other tissues, or circulating in the blood or lymph."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0043234 .

ns1:OBI_0000401 a owl:Class ;
    rdfs:label "environment control function"@en ;
    ns1:IAO_0000111 "environment control function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An environmental control function is a function that regulates a contained environment within specified parameter ranges. For example the control of light exposure, humidity and temperature."@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0000750 a owl:Class ;
    rdfs:label "study design independent variable"@en ;
    ns1:IAO_0000111 "independent variable specification"^^xsd:string ;
    ns1:IAO_0000112 "In a study in which gene expression is measured in patients between 8 month to 4 years old that have mild or severe malaria and in which the hypothesis is that gene expression in that age group is a function of disease status, disease status is the independent variable." ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a directive information entity that is part of a study design. Independent variables are entities whose values are selected to determine its relationship to an observed phenomenon (the dependent variable). In such an experiment, an attempt is made to find evidence that the values of the independent variable determine the values of the dependent variable (that which is being measured). The independent variable can be changed as required, and its values do not represent a problem requiring explanation in an analysis, but are taken simply as given. The dependent variable on the other hand, usually cannot be directly controlled"@en ;
    ns1:IAO_0000116 "In the Philly 2013 workshop the label was chosen to distinguish it from \"dependent variable\" as used in statistical modelling. See: http://en.wikipedia.org/wiki/Statistical_modeling",
        "2/2/2009 Original definition - In the design of experiments, independent variables are those whose values are controlled or selected by the person experimenting (experimenter) to determine its relationship to an observed phenomenon (the dependent variable). In such an experiment, an attempt is made to find evidence that the values of the independent variable determine the values of the dependent variable (that which is being measured). The independent variable can be changed as required, and its values do not represent a problem requiring explanation in an analysis, but are taken simply as given. The dependent variable on the other hand, usually cannot be directly controlled."@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"^^xsd:string,
        "PERSON: Bjoern Peters"^^xsd:string,
        "PERSON: Chris Stoeckert"^^xsd:string ;
    ns1:IAO_0000118 "experimental factor",
        "independent variable" ;
    ns1:IAO_0000119 "Web: http://en.wikipedia.org/wiki/Dependent_and_independent_variables"^^xsd:string ;
    ns1:IAO_0000232 "2009-03-16: work has been done on this term during during the OBI workshop winter 2009 and the current definition was considered acceptable for use in OBI. If there is a need to modify thisdefinition please notify OBI."^^xsd:string ;
    ns1:OBI_0001847 "study factor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom ns1:OBI_0500000 ],
        ns1:IAO_0000033 .

ns1:OBI_0000038 a owl:Class ;
    rdfs:label "chromatography column"@en ;
    ns1:IAO_0000111 "chromatography column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Chromatography column in chemistry is a tube and contents (typically glass) used to purify individual chemical compounds from mixtures of compounds. It is often used for preparative applications on scales from micrograms up to kilograms."@en ;
    ns1:IAO_0000117 "Frank Gibson"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Column_chromatography"@en ;
    ns1:IAO_0000232 "open tracker https://sourceforge.net/tracker/index.php?func=detail&aid=2881353&group_id=177891&atid=886178"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000967 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000372 [ a owl:Restriction ;
                                owl:allValuesFrom ns1:OBI_0600046 ;
                                owl:onProperty ns1:BFO_0000054 ] ) ] ],
        ns1:OBI_0000932 .

ns1:OBI_0000112 a owl:Class ;
    rdfs:label "specimen role"@en ;
    ns1:IAO_0000111 "specimen role"^^xsd:string ;
    ns1:IAO_0000112 "liver section; a portion of a culture of cells; a nemotode or other animal once no longer a subject (generally killed); portion of blood from a patient."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a role borne by a material entity that is gained during a specimen collection process and that can be realized by use of the specimen in an investigation"@en ;
    ns1:IAO_0000116 "22Jun09.  The definition includes whole organisms, and can include a human.  The link between specimen role and study subject role has been removed.  A specimen taken as part of a case study is not considered to be a population representative, while a specimen taken as representing a population, e.g. person taken from a cohort, blood specimen taken from an animal) would be considered a population representative and would also bear material sample role."^^xsd:string,
        "Note: definition is in specimen creation objective which is defined as an objective to obtain and store a material entity for potential use as an input during an investigation."^^xsd:string,
        "blood taken from animal: animal continues in study, whereas blood has role specimen.\\nsomething taken from study subject, leaves the study and becomes the specimen."@en,
        "parasite example\\n- when parasite in people we study people, people are subjects and parasites are specimen\\n- when parasite extracted, they become subject in the following study\\nspecimen can later be subject."@en ;
    ns1:IAO_0000117 "GROUP:  Role Branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000312 ;
                                owl:someValuesFrom ns1:OBI_0000659 ] ) ] ],
        ns1:BFO_0000023 .

owl:Thing a owl:Class .

ns1:OBI_0200166 a owl:Class ;
    rdfs:label "data transformation objective"@en ;
    ns1:IAO_0000111 "data transformation objective"@en ;
    ns1:IAO_0000112 "normalize objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An objective specification to transformation input data into output data"@en ;
    ns1:IAO_0000116 "Modified definition in 2013 Philly OBI workshop" ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:IAO_0000005 .

ns1:OBI_0200167 a owl:Class ;
    rdfs:label "data normalization objective"@en ;
    ns1:IAO_0000111 "data normalization objective"@en ;
    ns1:IAO_0000112 "Quantile transformation which has normalization objective can be used for expression microarray assay normalization and it is referred to as \"quantile normalization\", according to the procedure described e.g. in PMID 12538238."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A normalization objective is a data transformation objective where the aim is to remove\\nsystematic sources of variation to put the data on equal footing in order\\nto create a common base for comparisons."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string,
        "Helen Parkinson"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"^^xsd:string,
        "PERSON: Helen Parkinson"^^xsd:string,
        "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0600014 a owl:Class ;
    rdfs:label "material component separation"@en ;
    ns1:IAO_0000111 "material component separation"@en ;
    ns1:IAO_0000112 "Using a cell sorter to separate a mixture of T cells into two fractions; one with surface receptor CD8 and the other lacking the receptor, or purification"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a material processing in which components of an input material become segregated in space"@en ;
    ns1:IAO_0000117 "Bjoern Peters"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
