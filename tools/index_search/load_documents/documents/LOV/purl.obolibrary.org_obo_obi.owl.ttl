    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement device that detects biological, chemical or physical events of samples in microtiter plates."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Erik Segerdell"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Plate_reader"^^xsd:string ;
