            owl:intersectionOf ( ns1:OBI_0600064 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000430 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000411 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000410 ] ) ] .

ns1:OBI_0600048 a owl:Class ;
    rdfs:label "vector mediated amplification"@en ;
    ns1:IAO_0000111 "vector mediated amplification"^^xsd:string ;
    ns1:IAO_0000112 "E coli expressing the gene for M avium p35 were cultured in order to produce p35."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "The process of creating a copy of some biological entity in cell culture"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0600064 .

ns1:OBI_0600049 a owl:Class ;
    rdfs:label "DNA polymerase amplification"@en ;
    ns1:IAO_0000111 "DNA polymerase amplification"@en ;
    ns1:IAO_0000112 "The use of taq polymerase to amplify a DNA fragment during a PCR."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "DNA polymerase amplification is an enzymatic amplification which uses DNA polymerase enzyme to make copies of a DNA contained in biomaterial used as input"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
