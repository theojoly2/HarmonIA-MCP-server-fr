ns1:OBI_0000552 a owl:Class ;
    rdfs:label "reverse transcribed polymerase chain reaction"^^xsd:string ;
    ns1:IAO_0000111 "reverse transcribed polymerase chain reaction"^^xsd:string ;
    ns1:IAO_0000112 "Harmonisation of multi-centre real-time reverse-transcribed PCR results of a candidate prognostic marker in breast cancer: an EU-FP6 supported study of members of the EORTC - PathoBiology Group.\\n\\nSpan PN, Sieuwerts AM, Heuvel JJ, Spyratos F, Duffy MJ, Eppenberger-Castori S, Vacher S, O'Brien K, McKiernan E, Pierce A, Vuaroqueaux V, Foekens JA, Sweep FC, Martens JW.\\nEur J Cancer. 2009 Jan;45(1):74-81. PMID: 19008094"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "reverse transcribe pcr is a process which allow amplification of cDNA during a pcr reaction while the cDNA results from a retrotranscription of messenger RNA isolated from a material entity."^^xsd:string ;
    ns1:IAO_0000116 "3/21/10,  BP:Modified definition to clarify that this is not the assay, but the material transformation"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
