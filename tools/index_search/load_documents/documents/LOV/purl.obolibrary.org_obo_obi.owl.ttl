ns1:OBI_0000804 a owl:Class ;
    rdfs:label "informing investigator of subject study arm"^^xsd:string ;
    ns1:IAO_0000111 "informing investigator of subject study arm"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A process in which an investigator is made aware of which study arm that a patient is participating in, for example whether they are receiving a placebo or a treatment with an investigational compound."^^xsd:string ;
    ns1:IAO_0000116 "09/28/2009 Alan Ruttenberg. This and the class informing-subject-of-study-arm are defined in order to solve the question of how to represent single and double blind experiments. To represent the aspect of double blinding pertaining to investigators, we say that the study execution doesn't include any processes of this sort"^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:IAO_0000219 ;
                                owl:someValuesFrom [ a owl:Restriction ;
                                        owl:onProperty ns1:RO_0000053 ;
                                        owl:someValuesFrom ns1:OBI_0000097 ] ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000057 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:OBI_0000202 ] ] ) ],
        ns1:OBI_0000011 .

ns1:OBI_0000811 a owl:Class ;
    rdfs:label "primary structure of DNA macromolecule"^^xsd:string ;
    ns1:IAO_0000111 "primary structure of DNA macromolecule"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a quality of a DNA molecule that inheres in its bearer due to the order of its DNA nucleotide residues."^^xsd:string ;
    ns1:IAO_0000116 "placeholder for SO"^^xsd:string ;
    ns1:IAO_0000117 "BP et al"^^xsd:string ;
    rdfs:subClassOf ns1:SO_0000001 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000058 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0000052 ;
                    owl:someValuesFrom ns1:CHEBI_16991 ] ] .

ns1:OBI_0000815 a owl:Class ;
    rdfs:label "Berichrom(r) Antithrombin III (A) Kit"^^xsd:string ;
    ns1:IAO_0000111 "Berichrom(r) Antithrombin III (A) Kit"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "For the chromogenic determination of antithrombin III. Autoanalyzer method for undiluted samples. For the quantitative chromogenic determination of the functional activity of antithrombin III in plasma on autoanalyzers for the diagnosis of diminished AT III synthesis, increased consumption, and for monitoring substitution therapy. Berichrom(r) Antithrombin III (A) is used for the rapid determination of the physiologically active antithrombin III and permits the diagnosis of congenital and acquired antithrombin III deficiency, a condition frequently associated with an increased risk of thrombosis. Acquired antithrombin III deficiencies frequently occur due to consumption following major operations or due to disseminated intravascular coagulation (DIC) in cases of septicaemia, nephroses, liver parenchymal damage (hepatitis, drug intoxication, alcoholism) and estrogen-containing contraceptives. The test permits early detection of patients at increased risk for thrombosis. Kit contains: 6 x for 5.0 mL Thrombin (bovine), 3 x for 3.0 mL Substrate Reagent, 1 x 30.0 mL Buffer Solution"^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "WEB:http://www.dadebehring.com/edbna2/ebusiness/products/productDetail.jsp?sDiscipline=Hemostasis&FirstLevelOID=-13075&sCategory_Name=BCS&SecondLevelOID=-13895&ThirdLevelOID=-13904&selectedProductType=H-Assays+-+non+US&sProductName=OWWR15&PROD_OID=44198@2009/08/06"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000047 .

ns1:OBI_0000818 a owl:Class ;
    rdfs:label "calibration"^^xsd:string ;
    ns1:IAO_0000111 "calibration"^^xsd:string ;
    ns1:IAO_0000112 "the process of using pH buffer adjust a pH meter"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A planned process with the objective to establish the relationship between data produced by a measurement device and physical qualities. This is done by using the measurement device under defined conditions, and either tuning it to adjust the measured output, or record the output and use it as a reference in future measurements."^^xsd:string ;
    ns1:IAO_0000117 "GROUP: OBI Philly workshop"^^xsd:string ;
    ns1:IAO_0000119 "WEB:http://en.wikipedia.org/wiki/calibration"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000832 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000070 ],
        ns1:OBI_0000011 .

ns1:OBI_0000822 a owl:Class ;
    rdfs:label "single blind study execution"^^xsd:string ;
    ns1:IAO_0000111 "single blind study execution"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A single blind study execution is defined as any study execution in which the subjects are not informed of which study arm they are part of during the portion of the trial when the subjects are being treated"^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "http://clinicaltrials.gov/ct2/info/glossary#single"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000826 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000826 [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:complementOf ns1:OBI_0000842 ] ;
                        owl:onProperty ns1:BFO_0000051 ] ) ] .

