ns1:OBI_0000065 a owl:Class ;
    rdfs:label "polyethylene glycol p-(1,1,3,3-tetramethylbutyl)-phenyl ether"@en ;
    ns1:IAO_0000111 "polyethylene glycol p-(1,1,3,3-tetramethylbutyl)-phenyl ether"@en ;
    ns1:IAO_0000112 "PMID: 30799. J Histochem Cytochem. 1978 Sep;26(9):696-712. Acid lipase: a histochemical and biochemical study using triton X100-naphtyl palmitate micelles."@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "triton X100 is a chemical entity which belongs to the group of The pluronics which are triblock copolymers of ethylene oxide and propylene oxide. Triton x-100 is_used_as detergent due to its non-ionic surfactant properties"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "adapted from Wikipedia before possible import from CHEBI"@en ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:OBI_0000076 a owl:Class ;
    rdfs:label "unplanned occurrence effecting an investigation"@en ;
    ns1:IAO_0000111 "unplanned occurrence effecting an investigation"^^xsd:string ;
    ns1:IAO_0000112 "Earthquake that destroys the lab, an outside investigator discovering an adverse effect of the reagants used"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process which is external in origin to the investigation that has an impact on the outcome."@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns1:OBI_0000078 a owl:Class ;
    rdfs:label "eMedical record"@en ;
    ns1:IAO_0000111 "eMedical record"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An eMedical record is a digital document derived from a computer system used primarily for patient care in a clinical setting.  Not required to be compliant with requirements of 21 CFR Part 11."@en ;
    ns1:IAO_0000117 "person:Jennifer Fostel"@en ;
    ns1:IAO_0000119 "article-without-pmid-or-doi:CDISCglossary"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0000083 a owl:Class ;
    rdfs:label "electronic case report tabulation"@en ;
    ns1:IAO_0000111 "electronic case report tabulation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An electronic case report tabulation is a digital document containing tabular data about multiple trial participants which is part of a clinical regulatory submission.  An eCRT has the property that it can be audited and compliant with requirements of 21 CFR Part 11  and has format suited to review by regulators."@en ;
    ns1:IAO_0000117 "person:Jennifer Fostel"@en ;
    ns1:IAO_0000119 "CDISC glossary"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0000084 a owl:Class ;
    rdfs:label "polystyrene tube"@en ;
    ns1:IAO_0000111 "polystyrene tube"@en ;
    ns1:IAO_0000112 "Polystyrene tubes can be used  to contain tissue culture cells during centrifgation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a polystyrene tube is a test tube made of polystyrene"@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert"@en ;
    ns1:IAO_0000119 "PERSON: Chris Stoeckert"@en ;
    rdfs:subClassOf ns1:OBI_0000836 .

ns1:OBI_0000089 a owl:Class ;
    rdfs:label "role of regulator of chemical manufacturer"@en ;
    ns1:IAO_0000111 "role of regulator of chemical manufacturer"^^xsd:string ;
    ns1:IAO_0000112 "EPA; John Mollison is the registrar of chemical products in Tasmania, the body that administers the Act that regulates chemical use in that State. http://www.abc.net.au/rn/science/earth/stories/s1160346.htm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a regulator involved with making and enforcing legislation and governmental orders relevant to chemical manufacture"@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "regulator of chemical manufacture"^^xsd:string ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf ns1:OBI_0000014 .

ns1:OBI_0000091 a owl:Class ;
    rdfs:label "detector reagent role"@en ;
    ns1:IAO_0000111 "detector reagent role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a role which inheres in a molecular entity and is realized by the process of recording or registering a stimulus."^^xsd:string ;
    ns1:IAO_0000116 "19feb2009.  not clear we need this term.  originally if came from microarrays -- the probes on the array are termed detectors in some instances"^^xsd:string ;
    ns1:IAO_0000119 "One that detects, especially a mechanical, electrical, or chemical device that automatically identifies and records or registers a stimulus, such as an environmental change in pressure or temperature, an electric signal, or radiation from a radioactive material.   http://www.answers.com/topic/detector  19feb2009"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_0000092 a owl:Class ;
    rdfs:label "role of certified IRB professional"@en ;
    ns1:IAO_0000111 "role of certified IRB professional"^^xsd:string ;
    ns1:IAO_0000112 "CIP= Certified IRB Professional; http://acronyms.thefreedictionary.com/Certified+IRB+Professional"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role of which inheres in a Homo sapiens and realized during administration and oversight of the daily activities of Institutional Review Boards (IRBs) in the USA"^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "certified IRB professional"^^xsd:string ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Certified_IRB_Professional"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000016 .

ns1:OBI_0000100 a owl:Class ;
    rdfs:label "obsolete_role of being first subject treated"@en ;
    ns1:IAO_0000111 "First subject treated"@en ;
    ns1:IAO_0000112 "Rat 1A; first enrolled patient to receive treatment"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "First subject treated role is a study subject role borne by the subject realized in the application of the process specified in intervention study design with no previous study subject realizing the role prior in the study"@en ;
    ns1:IAO_0000116 "first subject treated. First subject who receives the test article or placebo in a clinical trial."@en ;
    ns1:IAO_0000117 "Role Branch"@en ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000109 a owl:Class ;
    rdfs:label "biological vector role"@en ;
    ns1:IAO_0000111 "biological vector role"^^xsd:string ;
    ns1:IAO_0000112 "1983 Sci. Amer. Jan. 58/2 Plasmids are routinely used as vectors for introducing foreign DNA into bacteria."@en,
        "Some epidemiological aspects and vector role of tick infestation on layers in the Faisalabad district (Pakistan). http://journals.cambridge.org/action/displayAbstract;jsessionid=0373164489D00868AEEF2C556EB4FD29.tomcat1?fromPage=online&aid=624280"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a biological vector role is a material to be added role that is realized by the process of transmitting material to the organism that is the target of the transmission."^^xsd:string ;
    ns1:IAO_0000116 false,
        "Feb 20, 2009. The material transmitted can be genetic information (as in cloning vector) or a pathogen (as in a disease vector)"^^xsd:string ;
    ns1:IAO_0000117 "GROUP:  Role Branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI and Wikipedia"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    ns1:IAO_0000232 "6/12/2009 Alan made this a material to be added role, because it was, and because this speeded up reasoning"^^xsd:string ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000110 a owl:Class ;
    rdfs:label "pH indicator dye role"@en ;
    ns1:IAO_0000111 "pH indicator dye role"^^xsd:string ;
    ns1:IAO_0000112 "bromophenol blue has a pH indicator dye role"^^xsd:string,
        "phenol red in RPMI; pH=4 indicator dye (also carries reference role)"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "the role of a dye that is realized when the dye is used in an experiment to measure the pH in a material entity"^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "pH indicator dye"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000250 .

ns1:OBI_0000117 a owl:Class ;
    rdfs:label "Bernoulli trial" ;
    ns1:IAO_0000111 "Bernoulli trial" ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An assay where the output data is a datum with one of two values denoting success and failure."^^xsd:string ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 .

ns1:OBI_0000119 a owl:Class ;
    rdfs:label "number of particles in subset"@en ;
    ns1:IAO_0000111 "number of particles in subset"@en ;
    ns1:IAO_0000112 "500, 200, 0"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement datum measuring the number of subjects in a defined subset in a flow cytometer instrument. The datum has a qualitative role"@en ;
    ns1:IAO_0000117 "person:Kevin Clancy"@en ;
    ns1:IAO_0000119 "Submitted by the Flow Cytometry community in DigitalEntity-FlowCytometry-2007-03-30.txt"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:OBI_0000125 a owl:Class ;
    rdfs:label "number of lost events electronic"@en ;
    ns1:IAO_0000111 "number of lost events electronic"@en ;
    ns1:IAO_0000112 "74, 0, 14 events lost due to data acquisition electronic coincidence."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement datum measuring the number of analysis events lost due to errors in data acquisition electronic coincidence in a flow cytometer instrument. The datum has a qualitative role."@en ;
    ns1:IAO_0000117 "person:Kevin Clancy"@en ;
    ns1:IAO_0000119 "Submitted by the Flow Cytometry community in DigitalEntity-FlowCytometry-2007-03-30.txt"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:OBI_0000129 a owl:Class ;
    rdfs:label "calibration substance role"@en ;
    ns1:IAO_0000111 "calibration substance role"@en ;
    ns1:IAO_0000112 "pH buffer used to calibrate a pH meter bears a calibration substance role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A reference substance role that is realized when characteristics or responses elicited by the bearer are used to ensure an instrument is within protocol specification of accuracy or performance"^^xsd:string ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000818 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:OBI_0000025 .

ns1:OBI_0000140 a owl:Class ;
    rdfs:label "obsolete_label role"@en ;
    ns1:IAO_0000111 "label role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000428 ;
    ns1:IAO_0000115 "Label role is a role which inheres in a material entity and which is realized in a detection of label assay"@en ;
    ns1:IAO_0000116 "MHB (9-26-12): consider deprecation of this class and replacement with REO:'molecular label role'",
        "Nucleotides synthesized with the incorporation of biotin were used to synthesize cDNA, which was then detected by adding fluorochrome-conjugated anti-biotin antibody.  the fluorochrome bears label role, the antibody bears detector role, the biotin bears reporter role. may need to change the terms following discussion"@en,
        "need to add a restriction that the material entity has the disposition / quality that permits it to be detected, and one way to say this (BP) is that the entity is such that an assay exists that detects the presence of the material entity"@en,
        "we need to sort out probe, detector and reporter.  See https://sourceforge.net/tracker/index.php?func=detail&amp;aid=1866458&amp;group_id=177891&amp;atid=886178"@en ;
    ns1:IAO_0000117 "Role Branch"@en ;
    ns1:IAO_0000118 "label"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000228 ;
    ns1:IAO_0100001 "http://purl.obolibrary.org/obo/REO_0000171" ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000143 a owl:Class ;
    rdfs:label "baseline participant role"@en ;
    ns1:IAO_0000111 "baseline participant role"^^xsd:string ;
    ns1:IAO_0000112 "Subject at time = 0; subject before a stress test."@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a reference participant role which is realized by making the reference to qualities at the start of the study or intervention"^^xsd:string ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "baseline participant"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000220 .

ns1:OBI_0000144 a owl:Class ;
    rdfs:label "role of independent data monitoring committee"@en ;
    ns1:IAO_0000111 "role of independent data monitoring committee"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a trial monitor role charged recommending whether to continue, modify, or end the trial"@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "independent data monitoring committee"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000060 .

ns1:OBI_0000145 a owl:Class ;
    rdfs:label "pathologist role"@en ;
    ns1:IAO_0000111 "pathologist role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a worker role of being responsible for making the histopathology diagnoses associated with data from a study; this activity occurs outside the study timeline"@en ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "Pathologist"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000116 .

ns1:OBI_0000146 a owl:Class ;
    rdfs:label "supernatant collection system harvesting frame"@en ;
    ns1:IAO_0000111 "supernatant collection system harvesting frame"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a device that is designed for collecting 90% of the supernatant in a microplate well and separating the living cell with no stress, eliminating centrifugation and other similar techniques. It can be used in a variety of release assays with different radioactive isotopes, such as Cr51 or I125."@en ;
    ns1:IAO_0000117 "Daniel Schober"@en ;
    ns1:IAO_0000119 "google"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000370 ],
        ns1:OBI_0000967 .

ns1:OBI_0000153 a owl:Class ;
    rdfs:label "cell co-culturing"@en ;
    ns1:IAO_0000111 "cell co-culturing"@en ;
    ns1:IAO_0000112 "Culturing  cytotoxic T-lymphocytes together with target cells in order to study lysis of the target cells. See chromium_release_assay"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A material combination in which cell cultures of two or more different types are are combined and allowed to culture as one."@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:CL_0000000 ] [ a owl:Restriction ;
                        owl:minCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns1:OBI_0000293 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000079 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        ns1:OBI_0000094 .

ns1:OBI_0000154 a owl:Class ;
    rdfs:label "role of Institutional Review Board"@en ;
    ns1:IAO_0000111 "role of Institutional Review Board"^^xsd:string ;
    ns1:IAO_0000112 "Animal protocol review board"^^xsd:string,
        "An institutional review board/independent ethics committee (IRB/IEC) (also known as ethical review board) is a group that has been formally designated to approve, monitor, and review biomedical and behavioral research involving humans with the alleged aim to protect the rights and welfare of the subjects.  Wikipedia March 2008"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "the role of a organization that is realized by members reviewing study designs for their agreement with regulations"^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "Internal Review Board"^^xsd:string ;
    ns1:IAO_0000119 "OBI, CDISC"@en ;
    ns1:IAO_0000232 "CDISC definition:  institutional review board; independent ethics committee (IEC). An independent body (a review board or a committee, institutional, regional, national, or supranational) constituted of medical/scientific professionals and non-scientific members, whose responsibility it is to ensure the protection of the rights, safety and well-being of human subjects involved in a trial."@en ;
    rdfs:subClassOf ns1:OBI_0000014 .

ns1:OBI_0000158 a owl:Class ;
    rdfs:label "eSource document"@en ;
    ns1:IAO_0000111 "eSource document"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "an eSource document is a digital document consisting of a logical collection of Source data and other eSource documents that can be presented in an ordered way and capture the time of completion, change, and any signatures"@en ;
    ns1:IAO_0000117 "person:Jennifer Fostel"@en ;
    ns1:IAO_0000119 "article-without-pmid-or-doi:CDISCglossary"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0000161 a owl:Class ;
    rdfs:label "crossover population role"@en ;
    ns1:IAO_0000111 "crossover population role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a role realized when a participant serves as reference to itself"^^xsd:string ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "crossover population"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000220 .

ns1:OBI_0000163 a owl:Class ;
    rdfs:label "radiolabel role"@en ;
    ns1:IAO_0000111 "radiolabel role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a molecular label role which inheres in a material entity which is realized by the process of radioactivity detection"@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    ns1:IAO_0000118 "radiolabel"@en ;
    rdfs:subClassOf ns1:REO_0000171 .

ns1:OBI_0000167 a owl:Class ;
    rdfs:label "electronic case report form"@en ;
    ns1:IAO_0000111 "electronic case report form"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An electronic case report form is a digital document used to record all of the protocol required information to be reported for each trial subject. An eCRF has the property that it can be audited and compliant with requirements of 21 CFR Part 11."@en ;
    ns1:IAO_0000117 "person:Jennifer Fostel"@en ;
    ns1:IAO_0000119 "CDISC glossary"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0000169 a owl:Class ;
    rdfs:label "placebo role"@en ;
    ns1:IAO_0000111 "placebo role"^^xsd:string ;
    ns1:IAO_0000112 "Pill consisting of inert materials"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a negative reference substance is a reference role in which the substance playing the reference substance role is physically similar in appearance to the test substance"^^xsd:string ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "placebo"^^xsd:string ;
    ns1:IAO_0000232 "CDISC definition placebo. A pharmaceutical preparation that does not contain the investigational agent. In blinded studies, it is generally prepared to be physically indistinguishable from the preparation containing the investigational product."@en ;
    rdfs:subClassOf ns1:OBI_0000214 .

ns1:OBI_0000171 a owl:Class ;
    rdfs:label "autotransplantation"@en ;
    ns1:IAO_0000111 "autotransplantation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "is the transplantation of tissue from one part of \\\\nthe body to another in the same individual. )"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0000105 .

ns1:OBI_0000172 a owl:Class ;
    rdfs:label "parameter threshold"@en ;
    ns1:IAO_0000111 "parameter threshold"@en ;
    ns1:IAO_0000112 "0.01, 0.03"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement datum measuring the minimal signal that must be detected to generate an electrical event, as compared to the maximal detected signal in a flow cytometer instrument. The datum has a qualitative role"@en ;
    ns1:IAO_0000117 "person:Kevin Clancy"@en ;
    ns1:IAO_0000119 "Submitted by the Flow Cytometry community in DigitalEntity-FlowCytometry-2007-03-30.txt"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:OBI_0000174 a owl:Class ;
    rdfs:label "study group role"@en ;
    ns1:IAO_0000111 "study group role"^^xsd:string ;
    ns1:IAO_0000112 "The group of randomized participants that are assigned to a treatment arm of the trial"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a study population role where the bearer is a population of material entities and the role is realized in the implementation of a study design wherein the entities bearing the study population role are observed or subjected to intervention according to the study design and are biological replicates, i.e. they receive the same treatment under the protocol"@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    ns1:IAO_0000118 "study group population"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_0000188 a owl:Class ;
    rdfs:label "role of pathology review board"@en ;
    ns1:IAO_0000111 "role of pathology review board"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a worker role comprised of providing a confirmed and consensus diagnosis for histopathology results obtained during the investigation"@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "pathology review board"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000116 .

ns1:OBI_0000192 a owl:Class ;
    rdfs:label "microtiter plate"@en ;
    ns1:IAO_0000111 "microtiter plate"@en ;
    ns1:IAO_0000112 "A microtiter plate with 6, 24, 96, 384 or 1536 sample wells used in the enzyme-linked immunosorbent assay (ELISA)"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A microtiter_plate is a flat plate with multiple wells used as small test tubes."@en ;
    ns1:IAO_0000117 "Melanie Courtot"@en ;
    ns1:IAO_0000118 "microplate"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Microtiter_plate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000370 ],
        ns1:OBI_0000967 .

ns1:OBI_0000196 a owl:Class ;
    rdfs:label "role of impartial witness"@en ;
    ns1:IAO_0000111 "role of impartial witness"^^xsd:string ;
    ns1:IAO_0000112 "According to GCP , an impartial witness should be present for an\\nilliterate subject. PharmPK Discussion, http://www.boomer.org/pkin/PK06/PK2006253.html"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a role which inheres in a Homo sapiens and is realized during a clinical trial - the impartial witness is independent of the trial and cannot be unfairly influenced by people involved with the trial"^^xsd:string ;
    ns1:IAO_0000116 "impartial witness. A person, who is independent of the trial, who cannot be unfairly influenced by people involved with the trial, who attends the informed consent process if the subject or the subject's legally acceptable representative cannot read, and who"@en ;
    ns1:IAO_0000117 "Person: Helen Parkinson"^^xsd:string,
        "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "impartial witness"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000016 .

ns1:OBI_0000205 a owl:Class ;
    rdfs:label "obsolete_dropout role"@en ;
    ns1:IAO_0000111 "Dropout"@en ;
    ns1:IAO_0000112 "Escaped rat; human who moved to another city. Rat which escapes part way through a study; a human study participant who moved to another city before the study was completed (and stopped participating in the study)"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Dropout is a study subject role borne by an entity realized by a process of leaving the study earlier than the protocol specified and where the bearer of the dropout role had been borne study subject role prior to bearing dropout role."@en ;
    ns1:IAO_0000116 "Will be modelled as defined material, ouput of some 'dropout or withdrawal\\nprocess' instead of role"^^xsd:string ;
    ns1:IAO_0000117 "Role Branch"@en ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000207 a owl:Class ;
    rdfs:label "health care provider role"@en ;
    ns1:IAO_0000111 "health care provider role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a worker role of providing medical care either within or outside the study timeline"@en ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "health care provider"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000116 .

ns1:OBI_0000210 a owl:Class ;
    rdfs:label "analytical cytology data file"@en ;
    ns1:IAO_0000111 "analytical cytology data file"@en ;
    ns1:IAO_0000112 "FCS file, ACS file, foo.fcs, foo.asc"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A digital entity intended to capture data in analytical cytology domain."@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "group:Flow Cytometry community"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0000211 a owl:Class ;
    rdfs:label "proxy respondent role"@en ;
    ns1:IAO_0000111 "proxy respondent role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Proxy respondent is a worker role of describing patient's symptoms or condition to medical personnel"@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    ns1:IAO_0000118 "proxy respondent"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000116 .

ns1:OBI_0000213 a owl:Class ;
    rdfs:label "fluorescence compensation matrix"@en ;
    ns1:IAO_0000111 "fluorescence compensation matrix"@en ;
    ns1:IAO_0000112 "((1.053096, -0.22476), (-0.24877, 1.053096))"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A fluorescence compensation matrix is a square matrix which is used as the left multiplier of the vector of fluorescence values while performing digital fluorescence compensation. Also, fluorescence compensation matrix is the inverse of the fluorescence spillover matrix."@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "group:Flow Cytometry community"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0000215 a owl:Class ;
    rdfs:label "role of legally acceptable representative"@en ;
    ns1:IAO_0000111 "role of legally acceptable representative"^^xsd:string ;
    ns1:IAO_0000112 "Parent of minor patient;  Definition of legally acceptable representative\\nAn individual or juridicial or other body authorized under applicable law to consent, on behalf of a prospective subject, to the subject`s participation in the clinical trial. http://www.geneed.com/website/catalog/glossary_search.php?id=2134&search_term=legally%20acceptable%20representative&select=TRUE"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role which inheres in a human or organization who are able subject to applicable law to consent, on behalf of a prospective subject, to the subject`s participation in as clinical trial."^^xsd:string ;
    ns1:IAO_0000116 "legally acceptable representative. An individual or juridical or other body authorized under applicable law to consent, on behalf of a prospective subject, to the subject's participation in the clinical trial. [ICH, E6 Glossary]"@en ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "legally acceptable representative"^^xsd:string ;
    ns1:IAO_0000119 "OBI, CDISC"@en ;
    rdfs:subClassOf ns1:OBI_0000016 .

ns1:OBI_0000218 a owl:Class ;
    rdfs:label "investigation results report"@en ;
    ns1:IAO_0000111 "investigation results report"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An investigation report is a report on the results of an investigation."@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "group:OBI"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000088 .

ns1:OBI_0000221 a owl:Class ;
    rdfs:label "vital dye role"@en ;
    ns1:IAO_0000111 "vital dye role"^^xsd:string ;
    ns1:IAO_0000112 "typtan blue has a vital dye"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A dye role that is realized when used to detect live cells in an experiment"^^xsd:string ;
    ns1:IAO_0000116 "2009-11-10. Tracker: https://sourceforge.net/tracker/?func=detail&aid=2893048&group_id=177891&atid=886178"^^xsd:string ;
    ns1:IAO_0000117 "Person: Helen Parkinson"^^xsd:string,
        "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "vital dye"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000250 .

ns1:OBI_0000223 a owl:Class ;
    rdfs:label "obsolete_blinded medication role"@en ;
    ns1:IAO_0000111 "Blinded medication"@en ;
    ns1:IAO_0000112 "115 patients received ipilimumab and blinded medication"^^xsd:string,
        "Inert pill shaped like aspirin tablet"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Is a role which inheres in a material entity which is manufactured to be similar in appearance to a test material entity in e.g. a clinical trial to prevent participants from detecting which is the active and inactive substance"^^xsd:string ;
    ns1:IAO_0000116 "Will be modelled using a blinding process and specified output blinded medication instead"^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "Jennifer Fostel"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000224 a owl:Class ;
    rdfs:label "sub-investigator role"@en ;
    ns1:IAO_0000111 "sub-investigator role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a worker role authorized to make study-related decisions and carry out tasks related to the study; this role occurs during the study timeline"@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "sub-investigator"^^xsd:string ;
    ns1:IAO_0000232 "CDISC definition:  Sub-investigator. Any member of the clinical trial team designated and supervised by the investigator at a trial site to perform critical trial-related procedures and/or to make important trial-related decisions (e.g., associates, residents, research fellows) [ICH] See associates, residents, research fellows"@en ;
    rdfs:subClassOf ns1:OBI_0000116 .

ns1:OBI_0000227 a owl:Class ;
    rdfs:label "data encoding"@en ;
    ns1:IAO_0000111 "data encoding"@en ;
    ns1:IAO_0000112 "storage of measurement results from an assay into a text file, such as"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a documenting process to encode an information entity into a digital document"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "We (protocol application branch) placed this term because it kept getting bounced from data transformation and DENRIE"@en ;
    rdfs:subClassOf ns1:IAO_0000572 .

ns1:OBI_0000232 a owl:Class ;
    rdfs:label "hardware optimization objective"@en ;
    ns1:IAO_0000111 "hardware optimization objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Hardware_optimization is a hardware_testing_objective describing a study designed to identify the best hardware."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000134 .

ns1:OBI_0000233 a owl:Class ;
    rdfs:label "obsolete_defined_material"@en ;
    ns1:IAO_0000111 "_defined_material"@en ;
    ns1:IAO_0000114 ns1:IAO_0000121 ;
    ns1:IAO_0000115 "Place holder class, Utility class to gather the defined classes"@en ;
    ns1:IAO_0000116 false ;
    ns1:IAO_0000117 "Susanna Sansone"^^xsd:string ;
    ns1:IAO_0000119 "OBI Biomaterial derived"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000226 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000234 a owl:Class ;
    rdfs:label "trial statistician role"@en ;
    ns1:IAO_0000111 "trial statistician role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a worker role that analyzes data obtained during a trial or study; this role occurs after the trial or study is completed or terminated."@en ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "trial statistician"^^xsd:string ;
    ns1:IAO_0000232 "CDISC definition:  trial statistician. A statistician who has a combination of education/training and experience sufficient to implement the principles in the ICH E9 guidance and who is responsible for the statistical aspects of the trial. [ICH E9]"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000055 ;
                                owl:someValuesFrom [ a owl:Restriction ;
                                        owl:onProperty ns1:RO_0000059 ;
                                        owl:someValuesFrom ns1:OBI_0500001 ] ] ] [ a owl:Restriction ;
                        owl:allValuesFrom ns1:OBI_0000066 ;
                        owl:onProperty ns1:BFO_0000054 ] ) ],
        ns1:OBI_0000116 .

ns1:OBI_0000235 a owl:Class ;
    rdfs:label "standard error"@en ;
    ns1:IAO_0000111 "standard error"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A quantitative confidence value which is the standard deviations of the sample in a frequency distribution, obtained by dividing the standard deviation by the total number of cases in the frequency distribution."@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "group:OBI"^^xsd:string ;
    ns1:IAO_0000232 "see P-Value"@en ;
    rdfs:subClassOf ns1:OBI_0000071 .

ns1:OBI_0000237 a owl:Class ;
    rdfs:label "antigen role"@en ;
    ns1:IAO_0000111 "antigen role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Antigen is a role played by material which when introduced into an immune-competent organism causes an immune response"@en ;
    ns1:IAO_0000116 "An antigen is a substance that prompts the generation of antibodies and can cause an immune response.  Wikipedia  http://en.wikipedia.org/wiki/Antigen. In the strict sense, immunogens are those substances that elicit a response from the immune system, whereas antigens are defined as substances that bind to specific antibodies. Not all antigens produce an immunogenic response, but all immunogens are antigens"^^xsd:string ;
    ns1:IAO_0000117 "Role Branch"@en ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    ns1:IAO_0000232 "9Mar09 waiting for discussion with immunology terms"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:GO_0006955 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000023 .

ns1:OBI_0000243 a owl:Class ;
    rdfs:label "sponsor role"@en ;
    ns1:IAO_0000111 "sponsor role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a responsible party role involved with any of the following activities:  initiating, managing and funding a study"@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "sponsor"^^xsd:string ;
    ns1:IAO_0000232 "CDISC definition: sponsor. 1. An individual, company, institution, or organization that takes responsibility for the initiation, management, and/or financing of a clinical trial. 2. A corporation or agency whose employees conduct the investigation is considered a sponsor; employees are considered investigators"@en ;
    rdfs:subClassOf ns1:OBI_0000102 .

ns1:OBI_0000249 a owl:Class ;
    rdfs:label "technical replicate role"@en ;
    ns1:IAO_0000111 "technical replicate role"^^xsd:string ;
    ns1:IAO_0000112 "Aliquots of a tissue subjected to parallel assays"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "technical replicate role is realized when two portions from one evaluant are used in replicate runs of an assay"^^xsd:string ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "technical replicate"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000220 .

ns1:OBI_0000251 a owl:Class ;
    rdfs:label "cluster"@en ;
    ns1:IAO_0000111 "cluster"@en ;
    ns1:IAO_0000112 "Cluster of the lymphocytes population."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A data set which is a subset of data that are a similar to each other in some way."@en ;
    ns1:IAO_0000117 "person:Allyson"@en,
        "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "group:OBI"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000100 .

ns1:OBI_0000252 a owl:Class ;
    rdfs:label "cohort role"@en ;
    ns1:IAO_0000111 "cohort role"^^xsd:string ;
    ns1:IAO_0000112 "In statistics and demography, a cohort is a group of subjects - most often humans from a given population - defined by experiencing an event (typically birth) in a particular time span.  Wikipedia \"cohort\", Feb 29 2008"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a cohort role is a biological replicate role played by a group of study participants who share a common characteristic of interest to the study."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    ns1:IAO_0000119 "WEB:http://www.sceoc.com/glossaryofterms/ # a group of individuals having a statistical factor (as age or class membership) in common in a demographic study, such as a cohort of students."^^xsd:string,
        "WEB:http://www.thebody.org/content/treat/art2612.html # a group of individuals in a study who share a demographic, clinical, or other statistical characteristic (eg, age, study site)."^^xsd:string,
        "WEB:http://www.uhhospitals.org/tabid/591/Default.aspx # A cohort is a group of people with a common characteristic that is studied over a period of time as part of a scientific or medical investigation."^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000198 .

ns1:OBI_0000260 a owl:Class ;
    rdfs:label "plan"@en ;
    ns1:IAO_0000111 "plan"@en ;
    ns1:IAO_0000112 "The plan of researcher X to perform an experiment according to a protocol."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A plan is a realizable entity that is the inheres in a bearer who is committed to realizing it as a planned process."@en ;
    ns1:IAO_0000116 "This class is included to make clear how the plan specification, the plan, and the planned process relate. OBI will however only subclass and work under the 'plan specification', and 'planned process' class, as we want to avoid to get deep into discussions of 'intend' etc."^^xsd:string ;
    ns1:IAO_0000117 "AR, BP, JM, MC, PRS"@en ;
    ns1:IAO_0000119 "branch derived"@en ;
    rdfs:subClassOf ns1:BFO_0000017 .

ns1:OBI_0000264 a owl:Class ;
    rdfs:label "obsolete_sample population"@en ;
    ns1:IAO_0000111 "sample population"@en ;
    ns1:IAO_0000112 "Patterns of benzylpiperazine/trifluoromethylphenylpiperazine party pill use and adverse effects in a population sample in New Zealand. Drug Alcohol Rev. 2008 Mar 31:1-7.  PMID: 18608458"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A sample population is an object aggregate that is selected from the population, e.g. the fish in the net that were sampled from the lake, the people that responded to the call for volunteers."@en ;
    ns1:IAO_0000116 "03/21/2010: BP, obsoleting this term, as it is duplicated by 'material sample'. Use that instead term instead, which now also has 'sample population' as an alternative label."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Jennifer Fostel"^^xsd:string,
        "PERSON: Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "recruited population"@en ;
    ns1:IAO_0000119 "GROUP: OBI Biomaterial Branch"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000227 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000269 a owl:Class ;
    rdfs:label "number of lost events computer"@en ;
    ns1:IAO_0000111 "number of lost events computer"@en ;
    ns1:IAO_0000112 "0, 125, 787 events lost due to computer busy."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement datum recording the number of measurement events lost due to overloading of the analysis chip in a flow cytometer instrument. The datum has a qualitative role"@en ;
    ns1:IAO_0000117 "person:Kevin Clancy"@en ;
    ns1:IAO_0000119 "Submitted by the Flow Cytometry community in DigitalEntity-FlowCytometry-2007-03-30.txt"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:OBI_0000278 a owl:Class ;
    rdfs:label "disease stage"@en ;
    ns1:IAO_0000111 "disease stage"^^xsd:string ;
    ns1:IAO_0000112 "Stage II breast cancer, The timepoint of recovery from a disease"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a part of an occurrence of a disease process which is associated with position in the normal progression of the disease"@en ;
    ns1:IAO_0000117 "PERSON: Bjoern peters"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom ns1:OGMS_0000063 ],
        ns1:GO_0008150 .

ns1:OBI_0000281 a owl:Class ;
    rdfs:label "intraperitoneal injection"@en ;
    ns1:IAO_0000111 "intraperitoneal injection"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is the injection of a material entity (bearing the administered substance role) into the peritoneum (bearing the target role) of an organism using a syringe"^^xsd:string ;
    ns1:IAO_0000117 "BP"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000434 ],
        ns1:OBI_0000426,
        ns1:OBI_0000429 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom ns1:OBI_0000319 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0000422 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000444 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:UBERON_0002358 ] ) ] ] ) ] .

ns1:OBI_0000286 a owl:Class ;
    rdfs:label "precipitate"@en ;
    ns1:IAO_0000111 "precipitate"@en ;
    ns1:IAO_0000112 "Physicochemical properties and antibacterial activity of the precipitate of vancomycin and ceftazidime: implications in the management of endophthalmitis. Retina. 2008 Feb;28(2):320-5. PMID: 18301038"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a precipitate is a material entity which is output of a precipitation process"@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string ;
