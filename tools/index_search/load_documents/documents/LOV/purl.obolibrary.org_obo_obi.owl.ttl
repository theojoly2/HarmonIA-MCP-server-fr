    ns1:IAO_0000111 "ion exchange column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An ion exchange column is a chromatography column that is used in ion exchange chromatography and anion or cation exchange resins to enable separation."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01105"^^xsd:string,
