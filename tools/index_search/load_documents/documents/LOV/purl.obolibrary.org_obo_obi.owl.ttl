            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:IAO_0000104 [ a owl:Restriction ;
                                owl:allValuesFrom [ a owl:Restriction ;
                                        owl:onProperty ns1:BFO_0000055 ;
                                        owl:someValuesFrom ns1:OBI_0001932 ] ;
                                owl:onProperty ns1:RO_0000059 ] ) ] ],
        ns1:IAO_0000030 .

