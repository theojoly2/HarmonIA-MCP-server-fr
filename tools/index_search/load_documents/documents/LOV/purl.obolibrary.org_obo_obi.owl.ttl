    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A planned process that is used to assess whether an assay will provide reliable results based on the conditions or qualities of the inputs, devices, and other participants of the assay."^^xsd:string ;
