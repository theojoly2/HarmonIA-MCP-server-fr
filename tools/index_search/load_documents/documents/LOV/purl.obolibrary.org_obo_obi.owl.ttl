    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The primary structure of an RNA molecule that is completely defined by the set of its nucleic residue parts and the linear order induced by the peptide bonds that hold them together"^^xsd:string ;
