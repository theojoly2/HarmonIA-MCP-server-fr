    rdfs:label "restriction enzyme"^^xsd:string ;
    ns1:IAO_0000111 "restriction enzyme"^^xsd:string ;
    ns1:IAO_0000112 "The enzyme EcoR1 cuts DNA at the canonical cleavage site CAATTG"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "an enzyme that has a specific target cleavage sites within nucleic acids"^^xsd:string ;
    ns1:IAO_0000117 "Kevin Clancy, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000232 "5/22 Need to explore if there are GO / other classes exist that capture this. We need it now for cloning experiments"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000056 ;
            owl:someValuesFrom ns1:GO_0003824 ],
        ns1:PR_000000001 .

ns1:OBI_0000741 a owl:Class ;
    rdfs:label "topologically preserved clustered data set"^^xsd:string ;
    ns1:IAO_0000111 "topologically preserved clustered data set"^^xsd:string ;
    ns1:IAO_0000112 "the output data set generated from a self-organizing map."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A clustered data set in which the topology, i.e. the spatial properties between data points, is preserved from the original input data from which it was derived."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000648 .

