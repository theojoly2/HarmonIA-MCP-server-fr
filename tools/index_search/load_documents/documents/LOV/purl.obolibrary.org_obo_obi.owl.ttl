        "Person:Jessica Turner"^^xsd:string ;
    ns1:IAO_0000119 "PMID:5146491#Oldfield, R.C. (1971). The assessment and analysis of handedness: The Edinburgh inventory. Neuropsychologia, 9, 97-113"^^xsd:string,
        "WEB:http://www.cse.yorku.ca/course_archive/2006-07/W/4441/EdinburghInventory.html"^^xsd:string ;
