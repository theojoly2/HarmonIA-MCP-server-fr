    ns1:IAO_0000111 "investigation"@en ;
    ns1:IAO_0000112 "Lung cancer investigation using expression profiling, a stem cell transplant investigation, biobanking is not an investigation, though it may be part of an investigation"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a planned process that consists of parts: planning, study design execution, documentation and which produce conclusion(s)."@en ;
    ns1:IAO_0000117 "Bjoern Peters"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "Could add specific objective specification"^^xsd:string,
        "Following OBI call November 2012,26th: it was decided there was no need for adding \"achieves objective of drawing conclusion\" as existing relations were providing equivalent ability. this note closes the issue and validates the class definition to be part of the OBI core\\neditor = PRS"@en ;
    ns1:IAO_0000412 onto: ;
    ns1:OBI_0001847 "study"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000338 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000471 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000339 [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000299 ;
                                owl:someValuesFrom ns1:OBI_0500000 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:IAO_0000572 ],
        ns1:OBI_0000011 .

ns1:OBI_0000648 a owl:Class ;
