ns1:OBI_0200072 a owl:Class ;
    rdfs:label "curve fitting data transformation"@en ;
    ns1:IAO_0000111 "curve fitting data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A curve fitting is a data transformation that has objective curve fitting and that consists of finding a curve which matches a series of data points and possibly other constraints."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Curve_fitting"@en ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000656 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200174 ] ) ] .

ns1:OBI_0200137 a owl:Class ;
    rdfs:label "network subgraph quality calculation"@en ;
    ns1:IAO_0000111 "network subgraph quality calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network analysis in which an input data set describing node objects and edge relationships between node objects is used to determine the output quality of a subgraph partition of the network."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200080 .

ns1:OBI_0200172 a owl:Class ;
    rdfs:label "partitioning objective"@en ;
    ns1:IAO_0000111 "partitioning objective"@en ;
    ns1:IAO_0000112 "A k-means clustering which has partitioning objective is a data transformation in which the input data is partitioned into k output sets."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A partitioning objective is a data transformation objective where the aim is to generate a collection of disjoint non-empty subsets whose union equals a non-empty input set."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200174 a owl:Class ;
    rdfs:label "curve fitting objective"@en ;
    ns1:IAO_0000111 "curve fitting objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A curve fitting objective is a data transformation objective in which the aim is to find a curve which matches a series of data points and possibly other constraints."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200187 a owl:Class ;
    rdfs:label "sequence analysis data transformation"@en ;
    ns1:IAO_0000111 "sequence analysis data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A sequence analysis data transformation is a data transformation that has objective sequence analysis and has the aim of analysing ordered biological data for sequential patterns."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "EDITOR"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200081 ] .

ns1:OBI_0200197 a owl:Class ;
    rdfs:label "spectrum analysis objective"^^xsd:string ;
    ns1:IAO_0000111 "spectrum analysis objective"^^xsd:string ;
    ns1:IAO_0000112 "Calculation of characteristic path length in mass spectrometry"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a data transformation objective where the aim is to analyse some aspect of spectral data by some data transformation process. "^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Tina Boussard"^^xsd:string,
        "Person:Helen Parkinson"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0400044 a owl:Class ;
    rdfs:label "flow cytometer"@en ;
    ns1:IAO_0000111 "flow cytometer"@en ;
    ns1:IAO_0000112 "FACS Calibur"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A flow_cytometer is an instrument for counting, examining and sorting microscopic particles in suspension. It allows simultaneous multiparametric analysis of the physical and/or chemical characteristics of single cells flowing through an optical and/or electronic detection apparatus. A flow cytometer is an instrument that can be used to quantitatively measure the properties of individual cells in a flowing medium."@en ;
    ns1:IAO_0000117 "John Quinn"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Flow_cytometer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0400078 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0400043 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0400065 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0400079 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0400082 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0400153 ],
        ns1:OBI_0400137 .

ns1:OBI_0400082 a owl:Class ;
    rdfs:label "photodetector"@en ;
    ns1:IAO_0000111 "photodetector"@en ;
    ns1:IAO_0000112 "A photomultiplier tube, a photo diode"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A photodetector is a device used to detect and measure the intensity of radiant energy through photoelectric action. In a cytometer, photodetectors measure either the number of photons of laser light scattered on impact with a cell (for example), or the flourescence emitted by excitation of a fluorescent dye."@en ;
    ns1:IAO_0000117 "John Quinn"@en ;
    ns1:IAO_0000119 "http://einstein.stanford.edu/content/glossary/glossary.html"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0400114 a owl:Class ;
    rdfs:label "sonicator"@en ;
    ns1:IAO_0000111 "sonicator"@en ;
    ns1:IAO_0000112 "Sonicator 3000"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A device that converts a variable electrical current to mechanical vibration of a metallic probe. The device is used for the lysis of cells, the mixing of compounds or solutions, to framgent molecules of DNA, or to create emulsions."@en ;
    ns1:IAO_0000117 "Trish Whetzel"@en ;
    ns1:IAO_0000119 "MO"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000377 ],
        ns1:OBI_0001033 .

ns1:OBI_0600058 a owl:Class ;
    rdfs:label "enzymatic amplification"@en ;
    ns1:IAO_0000111 "enzymatic amplification"@en ;
    ns1:IAO_0000112 "the use of a polymerase chain reaction to amplify a fragment of DNA"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "the use of enzymes to increase the number of molecules of a biomaterial"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
