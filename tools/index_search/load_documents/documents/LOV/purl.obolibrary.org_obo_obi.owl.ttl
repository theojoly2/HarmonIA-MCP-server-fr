ns1:OBI_0001940 a owl:Class ;
    rdfs:label "N50"@en ;
    ns1:IAO_0000111 "N50"@en ;
    ns1:IAO_0000112 "Gigascience. 2012 Dec 27;1(1):18. doi: 10.1186/2047-217X-1-18.\\nPMID: 23587118. \\n\\n\"Here, the contig and scaffold N50 of the YH genome were ~20.9 kbp and ~22 Mbp\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "the weighted median item size or N50 is a weighted median of the lengths of items, equal to the length of the longest item i such that the sum of the lengths of items greater than or equal in length to i is greater than or equal to half the length of all of the items. With regard to assemblies the items are typically contigs or scaffolds. It therefore denotes the ability of the software to create contigs and provides information about the resulting sequence assembly" ;
    ns1:IAO_0000117 "Alejandra Gonzalez-Beltran"@en,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000118 "weighted median item size"@en ;
    ns1:IAO_0000119 "adapted from:\\n\"http://genome.cshlp.org/content/21/12/2224.full?sid=74019122-f944-4ccc-bffe-d16fdd0e7d6c\"\\n(from table 7)\\nand from \"http://www.nature.com/nrg/journal/v14/n3/full/nrg3367.html\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000039 ;
            owl:someValuesFrom ns1:IAO_0000003 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:SO_0001248 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0001872 ],
        ns1:IAO_0000032 .

ns1:OBI_0001973 a owl:Class ;
    rdfs:label "ion semiconductor chip"@en ;
    ns1:IAO_0000111 "ion semiconductor chip"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An ion detector that is organized as an electronic circuit whose components, such as transistors and resistors, are etched or deposited on a single slice of semiconductor material to produce a chip. The specific chip detects ion charge induced when an ion passes by or hits a surface."@en ;
    ns1:IAO_0000116 "Issue Tracker: #776\\nhttps://sourceforge.net/p/obi/obi-terms/776/" ;
    ns1:IAO_0000117 "PERSON: Sagar Jain"@en ;
    ns1:IAO_0000118 "ion chip"@en,
        "ion integrated circuit"@en,
        "ion semiconductor"@en ;
    ns1:IAO_0000119 "http://www.thefreedictionary.com/Semiconductor+chip" ;
    rdfs:subClassOf ns1:OBI_0000364 .

ns1:OBI_0002076 a owl:Class ;
    rdfs:label "collection of specimens"@en ;
    ns1:IAO_0000111 "collection of specimens"@en ;
    ns1:IAO_0000112 "Blood cells collected from multiple donors over the course of a study."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A material entity that has two or more specimens as its parts."@en ;
    ns1:IAO_0000116 "Details see tracker: https://sourceforge.net/p/obi/obi-terms/778/" ;
    ns1:IAO_0000117 "Person: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "OBIB, OBI" ;
    dc:source "Biobank" ;
