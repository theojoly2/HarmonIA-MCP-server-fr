    rdfs:label "primary cell culture"@en ;
    ns1:IAO_0000111 "primary cell culture"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cell culture comprised of primary cultured cells and the media in which they are being actively propaged or quiescently stored."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Matthew Brush"^^xsd:string ;
    ns1:IAO_0000119 "OBI-CLO Alignment Working Group (Spring 2013)"^^xsd:string ;
