ns1:OBI_0001848 a owl:Class ;
    rdfs:label "chromatin interaction analysis by paired-end tag sequencing assay" ;
    ns1:IAO_0000111 "chromatin interaction analysis by paired-end tag sequencing assay" ;
    ns1:IAO_0000112 "Zhang, et al. ChIA-PET analysis of transcriptional chromatin interactions. Methods. 2012 Nov;58(3):289-99. [PMID:22926262]"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that incorporates chromatin immunoprecipitation (ChIP)-based enrichment, chromatin proximity ligation, Paired-End Tags, and high-throughput sequencing to determine de novo long-range chromatin interactions genome-wide."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string,
        "Jie Zheng"^^xsd:string,
        "Venkat Malladi"^^xsd:string ;
    ns1:IAO_0000118 "ChIA-PET"^^xsd:string,
        "ChIA-PET assay"^^xsd:string ;
    ns1:IAO_0000119 "url:http://en.wikipedia.org/wiki/ChIA-PET"^^xsd:string ;
