    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A 3d structural organization datum capturing the results of X-ray crystallography or NMR experiment that is formatted as specified by the Protein Databank (http://www.wwpdb.org/docs.html). A PDB file can describe the structure of multiple molecules, each of which has a different chain identifier assigned. "^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters, Dorjee Tamang, Jason Greenbaum"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001155 .

