ns1:OBI_0001501 a owl:Class ;
    rdfs:label "fluorescence detection assay" ;
    ns1:IAO_0000111 "fluorescence detection assay" ;
    ns1:IAO_0000112 "Using a laser to stimulate a cell culture that was previously labeled with fluorescent antibodies to detect light emmission at a different wavelength in order to determine the presence of surface markers the antibodies are specific for."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay in which a material's fluorescence is determined."^^xsd:string ;
