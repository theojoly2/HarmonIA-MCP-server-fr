            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:CHEBI_33697 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0001025 ;
                                owl:someValuesFrom ns1:BFO_0000040 ] ) ] ],
        ns1:OBI_0600058 .

ns1:OBI_0600051 a owl:Class ;
    rdfs:label "gradient separation"@en ;
    ns1:IAO_0000111 "gradient separation"@en ;
    ns1:IAO_0000112 "the use of a sucrose gradient to isolate mitochondria"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application that uses different concentrations of materials in a defined order to create a gradient to facilitate the separation of an input material into its components with specific qualities"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        ns1:OBI_0600014 .

ns1:OBI_0600054 a owl:Class ;
    rdfs:label "selection by survival"@en ;
    ns1:IAO_0000111 "selection by survival"@en ;
    ns1:IAO_0000112 "The insertion of a gene for antibiotic resistance into a cell population and subsequent growth in the presence of the antibiotic to select for those cells which were successfully transfected"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "the use of environmental conditions to select for the organism or cells that have a certain trait"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0600055 a owl:Class ;
    rdfs:label "DNA cleavage, restriction analysis"@en ;
    ns1:IAO_0000111 "DNA cleavage, restriction analysis"@en ;
    ns1:IAO_0000112 "the use of the restriction enzymes SalPI and PstI to cleave DNA into fragments, assay made up of components"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "the use of enzymes to cut DNA molecules, the study of DNA through cleavage, mapping, and analysis of the fragments"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000118 "restriction enzyme assay"@en ;
    ns1:IAO_0000119 "the use of the restriction enzymes SalPI and PstI to cleave DNA into fragments, assay made up of components"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:CHEBI_33697 ],
        ns1:OBI_0000231 .

ns1:OBI_0600057 a owl:Class ;
    rdfs:label "enzymatic DNA replication"@en ;
    ns1:IAO_0000111 "enzymatic DNA replication"@en ;
    ns1:IAO_0000112 "the use of enzymes to duplicate DNA molecules"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "the use of enzymes to duplicate DNA molecule any process used to make additional copies of a biomaterial"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0600058 .

ns1:OBI_0600059 a owl:Class ;
    rdfs:label "DNA transduction"@en ;
    ns1:IAO_0000111 "DNA transduction"@en ;
    ns1:IAO_0000112 "The transfer of a recombinant bacterial plasmid into E.coli to facilitate amplification of a specific protein"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a genetic transformation which relies on the use of lysogenic infection to transfer DNA sequences into an organism"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:NCBITaxon_10239 ],
        ns1:OBI_0600043 .

ns1:OBI_0600060 a owl:Class ;
    rdfs:label "DNA transfection"@en ;
    ns1:IAO_0000111 "DNA transfection"@en ;
    ns1:IAO_0000112 "The use of electroporation to permeabilize a cell membrane in order to introduce a plasmid encoding for a labeled protein of interest"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a transfection which relies on the use of physical, electrical and chemical phenomena to introduce DNA into a cell"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
