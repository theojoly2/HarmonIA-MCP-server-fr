            owl:intersectionOf ( ns1:OBI_0000070 [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000055 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000081 ;
                                                        owl:someValuesFrom ns1:CL_0000000 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:CL_0000000 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000087 ;
                                                        owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ] ) ] .

ns1:OBI_0002326 a owl:Class ;
    rdfs:label "International Federation of Gynecology and Obstetrics cervical cancer stage value specification" ;
    ns1:IAO_0000111 "International Federation of Gynecology and Obstetrics cervical cancer stage value specification" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A categorical value specification that is an assessment of the stage of a gynecologic cancer according to the International Federation of Gynecology and Obstetrics (FIGO) staging systems."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Clinical FIGO stage"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001930 .

ns1:OBI_0002341 a owl:Class ;
    rdfs:label "International Federation of Gynecology and Obstetrics ovarian cancer stage value specification" ;
    ns1:IAO_0000111 "International Federation of Gynecology and Obstetrics ovarian cancer stage value specification" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A categorical value specification that is a pathologic finding about one or more characteristics of ovarian cancer following the rules of the FIGO classification system."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Pathologic Tumor Stage Grouping for ovarian cancer (FIGO)"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001930 .

ns1:OBI_0500027 a owl:Class ;
    rdfs:label "inclusion criterion"@en ;
    ns1:IAO_0000111 "inclusion criterion"@en ;
    ns1:IAO_0000112 "PMID: 23979341-The major inclusion criterion was patients in whom severe cerebral embolism was diagnosed at age 75 or younger (more than 9 in the NIHSS score on day 7 after the onset of stroke) ."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "an inclusion criterion (rule) is_a *eligibility criterion*  which defines and states a condition which, if met, makes an entity suitable for a given task or participation in a given process. For instance, in a study protocol, inclusion criteria indicate the conditions that prospective subjects MUST meet to be eligible for participation in a study."@en ;
    ns1:IAO_0000117 "Person: Philippe Rocca-Serra"@en ;
    ns1:IAO_0000118 "inclusion condition"@en,
        "inclusion rule"@en ;
    ns1:IAO_0000119 "Adapted from Clinical Research Glossary Version 4.0 CDICS glossary group"@en ;
    rdfs:subClassOf ns1:OBI_0500026 .

ns1:iao.owl a owl:NamedIndividual .

ns1:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    ns1:BFO_0000179 "ic" ;
    ns1:BFO_0000180 "IndependentContinuant" ;
    ns1:IAO_0000112 "a chair"@en,
        "a heart"@en,
        "a leg"@en,
        "a molecule"@en,
        "a spatial region"@en,
        "an atom"@en,
        "an orchestra."@en,
        "an organism"@en,
        "the bottom right portion of a human torso"@en,
        "the interior of your mouth"@en ;
    ns1:IAO_0000115 "A continuant that is a bearer of quality and realizable entity entities, in which other entities inhere and which itself cannot inhere in anything."@en,
        "b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])"@en ;
    ns1:IAO_0000601 "For any independent continuant b and any time t there is some spatial region r such that b is located_in r at t. (axiom label in BFO2 Reference: [134-001])"@en,
        "For every independent continuant b and time t during the region of time spanned by its life, there are entities which s-depends_on b during t. (axiom label in BFO2 Reference: [018-002])"@en ;
    ns1:IAO_0000602 "(forall (x t) (if (IndependentContinuant x) (exists (r) (and (SpatialRegion r) (locatedInAt x r t))))) // axiom label in BFO2 CLIF: [134-001] ",
        "(forall (x t) (if (and (IndependentContinuant x) (existsAt x t)) (exists (y) (and (Entity y) (specificallyDependsOnAt y x t))))) // axiom label in BFO2 CLIF: [018-002] ",
        "(iff (IndependentContinuant a) (and (Continuant a) (not (exists (b t) (specificallyDependsOnAt a b t))))) // axiom label in BFO2 CLIF: [017-002] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000002 ;
    owl:disjointWith ns1:BFO_0000020,
        ns1:BFO_0000031 .

ns1:GO_0043234 a owl:Class ;
    rdfs:label "protein complex"^^xsd:string ;
    ns1:IAO_0000111 "protein complex"^^xsd:string ;
    ns1:IAO_0000112 "A ribosome is a protein complex"^^xsd:string ;
    ns1:IAO_0000115 "A stable macromolecular complex composed (only) of two or more polypeptide subunits along with any covalently attached molecules (such as lipid anchors or oligosaccharide) or non-protein prosthetic groups (such as nucleotides or metal ions). Prosthetic group in this context refers to a tightly bound cofactor. The component polypeptide subunits may be identical."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:PR_000000001 ],
        ns1:BFO_0000040 .

ns1:IAO_0000104 a owl:Class ;
    rdfs:label "plan specification"@en ;
    ns1:IAO_0000111 "plan specification"@en ;
    ns1:IAO_0000112 "PMID: 18323827.Nat Med. 2008 Mar;14(3):226.New plan proposed to help resolve conflicting medical advice."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A directive information entity with action specifications and objective specifications as parts that, when concretized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified."@en ;
    ns1:IAO_0000116 "2009-03-16: provenance: a term a plan was proposed for OBI (OBI_0000344) , edited by the PlanAndPlannedProcess branch. Original definition was \" a plan is a specification of a process that is realized by an actor to achieve the objective specified as part of the plan\". It has been subsequently moved to IAO where the objective for which the original term was defined was satisfied with the definitionof this, different, term."@en,
        "2014-03-31: A plan specification can have other parts, such as conditional specifications."@en,
        "Alternative previous definition: a plan is a set of instructions that specify how an objective should be achieved"@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "OBI Plan and Planned Process branch"@en,
        "OBI_0000344"@en ;
    rdfs:comment "2/3/2009 Comment from OBI review.\\n\\nAction specification not well enough specified.\\nConditional specification not well enough specified.\\nQuestion whether all plan specifications have objective specifications.\\n\\nRequest that IAO either clarify these or change definitions not to use them"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:IAO_0000007 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:IAO_0000005 ],
        ns1:IAO_0000033 .

ns1:OBI_0000131 a owl:Class ;
    rdfs:label "molecular feature identification objective"@en ;
    ns1:IAO_0000111 "molecular feature identification objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Molecular_feature_identification_objective is a biological_feature_identification_objective role describing a study designed to examine or characterize molecular features of a biological system, e.g. expression profiling, copy number of molecular components, epigenetic modifications."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000015 .

ns1:OBI_0000383 a owl:Class ;
    rdfs:label "transfer function"@en ;
    ns1:IAO_0000111 "transfer function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A transfer function is a function to displace a material from one location to another."@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0000659 a owl:Class ;
    rdfs:label "specimen collection process" ;
    ns1:IAO_0000111 "specimen collection process" ;
    ns1:IAO_0000112 "drawing blood from a patient for analysis, collecting a piece of a plant for depositing in a herbarium, buying meat from a butcher in order to measure its protein content in an investigation" ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A planned process with the objective of collecting a specimen."^^xsd:string ;
    ns1:IAO_0000116 "Note: definition is in specimen creation objective which is defined as an objective to obtain and store a material entity for potential use as an input during an investigation."^^xsd:string,
        "Philly2013: A specimen collection can have as part a material entity acquisition, such as ordering from a bank. The distinction is that specimen collection necessarily involves the creation of a specimen role. However ordering cell lines cells from ATCC for use in an investigation is NOT a specimen collection, because the cell lines already have a specimen role.",
        "Philly2013: The specimen_role for the specimen is created during the specimen collection process.",
        "label  changed to 'specimen collection process' on 10/27/2014, details see tracker:\\nhttp://sourceforge.net/p/obi/obi-terms/716/" ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "specimen collection" ;
    ns1:IAO_0000232 "5/31/2012: This process is not necessarily an acquisition, as specimens may be collected from materials already in posession"^^xsd:string,
        "6/9/09: used at workshop"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100051 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        ns1:OBI_0000011 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000011 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0000684 ] ) ] .

ns1:OBI_0001398 a owl:Class ;
    rdfs:label "protein and DNA interaction identification objective"@en ;
    ns1:IAO_0000111 "protein and DNA interaction identification objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A sequence feature identification objective that aims to characterize the interactions between protein and DNA which includes identification of transcription factor binding sites."@en ;
    ns1:IAO_0000117 "Person: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "MO_933 binding_site_identification_design"@en ;
    rdfs:subClassOf ns1:OBI_0000113 .

ns1:OBI_0001875 a owl:Class ;
    rdfs:label "cultured immune cell population"@en ;
    ns1:IAO_0000111 "cultured immune cell population"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a cultured cell population comprised of a single type of immune system cell"^^xsd:string ;
    ns1:IAO_0000116 "MHB 3-5-13: created as a (temporary) organizational class to organize IEDB immune cultured cell population types. These were all previously labled as 'cell cultures' - and relabeld here as 'cultured cell populations' since a CLO alignment outcome was to use the term 'cell culture' to refer to cultured cells + media.  Consult with BP as to whether this organizational class is useful and if so, how to define it.  Also check whether the intent was to represent cell populations rather than cell cultures."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Matthew Brush" ;
    ns1:IAO_0000118 "immune cell culture sample"^^xsd:string ;
    ns1:IAO_0000119 "PERSON:Matthew Brush" ;
    rdfs:subClassOf ns1:OBI_0100060 .

ns1:OBI_0600064 a owl:Class ;
    rdfs:label "recombinant vector cloning"@en ;
    ns1:IAO_0000111 "recombinant vector cloning"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a planned process with the objective to insert genetic material into a cloning vector for future replication of the inserted material"@en ;
    ns1:IAO_0000117 "pa_branch (Alan, Randi, Kevin, Jay, Bjoern)"@en ;
    ns1:IAO_0000118 "molecular cloning"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000731 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:OBI_0000416 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000737 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom ns1:OBI_0000411 ],
        ns1:OBI_0000094 .

ns1:BFO_0000016 a owl:Class ;
    rdfs:label "disposition"@en ;
    ns1:BFO_0000179 "disposition" ;
    ns1:BFO_0000180 "Disposition" ;
    ns1:IAO_0000112 "an atom of element X has the disposition to decay to an atom of element Y"@en,
        "certain people have a predisposition to colon cancer"@en,
        "children are innately disposed to categorize objects in certain ways."@en,
        "the cell wall is disposed to filter chemicals in endocytosis and exocytosis"@en ;
    ns1:IAO_0000116 "BFO 2 Reference: Dispositions exist along a strength continuum. Weaker forms of disposition are realized in only a fraction of triggering cases. These forms occur in a significant number of cases of a similar type."@en ;
    ns1:IAO_0000600 "b is a disposition means: b is a realizable entity & b’s bearer is some material entity & b is such that if it ceases to exist, then its bearer is physically changed, & b’s realization occurs when and because this bearer is in some special physical circumstances, & this realization occurs in virtue of the bearer’s physical make-up. (axiom label in BFO2 Reference: [062-002])"@en ;
    ns1:IAO_0000601 "If b is a realizable entity then for all t at which b exists, b s-depends_on some material entity at t. (axiom label in BFO2 Reference: [063-002])"@en ;
    ns1:IAO_0000602 "(forall (x t) (if (and (RealizableEntity x) (existsAt x t)) (exists (y) (and (MaterialEntity y) (specificallyDepends x y t))))) // axiom label in BFO2 CLIF: [063-002] ",
        "(forall (x) (if (Disposition x) (and (RealizableEntity x) (exists (y) (and (MaterialEntity y) (bearerOfAt x y t)))))) // axiom label in BFO2 CLIF: [062-002] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000017 ;
    owl:disjointWith ns1:BFO_0000023 .

ns1:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    ns1:BFO_0000179 "quality" ;
    ns1:BFO_0000180 "Quality" ;
    ns1:IAO_0000112 "the ambient temperature of this portion of air"@en,
        "the color of a tomato"@en,
        "the length of the circumference of your waist"@en,
        "the mass of this piece of gold."@en,
        "the shape of your nose"@en,
        "the shape of your nostril"@en ;
    ns1:IAO_0000600 "a quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized. (axiom label in BFO2 Reference: [055-001])"@en ;
    ns1:IAO_0000601 "If an entity is a quality at any time that it exists, then it is a quality at every time that it exists. (axiom label in BFO2 Reference: [105-001])"@en ;
    ns1:IAO_0000602 "(forall (x) (if (Quality x) (SpecificallyDependentContinuant x))) // axiom label in BFO2 CLIF: [055-001] ",
        "(forall (x) (if (exists (t) (and (existsAt x t) (Quality x))) (forall (t_1) (if (existsAt x t_1) (Quality x))))) // axiom label in BFO2 CLIF: [105-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000020 .

ns1:GO_0032602 a owl:Class ;
    rdfs:label "chemokine production"^^xsd:string ;
    ns1:IAO_0000111 "chemokine production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of a chemokine due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:OBI_0000397 a owl:Class ;
    rdfs:label "image acquisition function"@en ;
    ns1:IAO_0000111 "image acquisition function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An image acquisition function is a function to acquire an image of a material"@en ;
    ns1:IAO_0000117 "Frank Gibson"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:OBI_0000398 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0001007 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:OBI_0000453 .

ns1:OBI_0000398 a owl:Class ;
    rdfs:label "image creation device"@en ;
    ns1:IAO_0000111 "image acquisition device"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An image creation device is a device which captures a digitized image of an object"@en ;
    ns1:IAO_0000117 "Frank Gibson"^^xsd:string ;
    ns1:IAO_0000118 "image acquisition device"@en ;
    ns1:IAO_0000119 "sep:00096"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000832 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000968 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000085 ;
                        owl:someValuesFrom ns1:OBI_0000397 ] ) ] .

ns1:OBI_0001307 a owl:Class ;
    rdfs:label "tiling microarray"@en ;
    ns1:IAO_0000111 "tiling microarray"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
