        owl:NamedIndividual ;
    rdfs:label "pTis (colon)" ;
    ns1:IAO_0000111 "pTis (colon)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for colon and rectum according to AJCC 7th edition indicating carcinoma in situ (intraepithelial or invasion of lamina propria)."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/colon/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002227 a ns1:OBI_0002224,
        owl:NamedIndividual ;
    rdfs:label "pT1 (colon)" ;
    ns1:IAO_0000111 "pT1 (colon)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for colon and rectum according to AJCC 7th edition indicating that the tumor invades submucosa."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/colon/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002228 a ns1:OBI_0002224,
        owl:NamedIndividual ;
    rdfs:label "pT2 (colon)" ;
    ns1:IAO_0000111 "pT2 (colon)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for colon and rectum according to AJCC 7th edition indicating that the tumor invades muscularis propria."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/colon/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002229 a ns1:OBI_0002224,
        owl:NamedIndividual ;
    rdfs:label "pT3 (colon)" ;
    ns1:IAO_0000111 "pT3 (colon)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for colon and rectum according to AJCC 7th edition indicating that the tumor invades subserosa or into non-peritionealized pericolic or perirectal tissues."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/colon/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002230 a ns1:OBI_0002224,
        owl:NamedIndividual ;
    rdfs:label "pT4a (colon)" ;
    ns1:IAO_0000111 "pT4a (colon)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for colon and rectum according to AJCC 7th edition indicating that the tumor perforates visceral peritoneum."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/colon/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002231 a ns1:OBI_0002224,
        owl:NamedIndividual ;
    rdfs:label "pT4b (colon)" ;
    ns1:IAO_0000111 "pT4b (colon)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for colon and rectum according to AJCC 7th edition indicating that the tumor directly invades other organs or structures."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/colon/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002233 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pT0 (lung)" ;
    ns1:IAO_0000111 "pT0 (lung)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for lung according to AJCC 7th edition indicating that there is no evidence of primary tumor."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002234 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pTis (lung)" ;
    ns1:IAO_0000111 "pTis (lung)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for lung according to AJCC 7th edition indicating carcinoma in situ."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002235 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pT1 (lung)" ;
    ns1:IAO_0000111 "pT1 (lung)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for lung according to AJCC 7th edition indicating that the tumor is 3 cm or less in greatest dimension, surrounded by lung or visceral pleura without bronchoscopic evidence of invasion more proximal than the lobar bronchus (i.e., not in the main bronchus)."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002236 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pT1a (lung)" ;
    ns1:IAO_0000111 "pT1a (lung)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for lung according to AJCC 7th edition indicating that the tumor is 2 cm or less in greatest dimension."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002237 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pT1b (lung)" ;
    ns1:IAO_0000111 "pT1b (lung)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for lung according to AJCC 7th edition indicating that the tumor is more than 2 cm but not more than 3 cm in greatest dimension."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002238 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pT2 (lung)" ;
    ns1:IAO_0000111 "pT2 (lung)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for lung according to AJCC 7th edition indicating that the tumor is more than 3 cm but not more than 7 cm or the tumor has any of the following features: involves main bronchus, 2 cm or more distal to the carina, invades visceral pleura, associated with atelectasis or obstructive pneumonitis that extends to the hilar region but does not involve the entire lung."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002239 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pT2a (lung)" ;
    ns1:IAO_0000111 "pT2a (lung)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for lung according to AJCC 7th edition indicating that the tumor is more than 3 cm but not more than 5 cm in greatest dimension."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002240 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pT2b (lung)" ;
