ns1:OBI_0000729 a owl:Class ;
    rdfs:label "cloning plasmid"^^xsd:string ;
    ns1:IAO_0000111 "cloning plasmid"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A cloning plasmid is a plasmid that was engineered to contain a bacterial origin of replication, encodes for a selectable gene product and contains a cloning site."^^xsd:string ;
    ns1:IAO_0000116 "Note: 'cloning vector role' is really a function. Should be dealt with globally"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000430,
        ns1:OBI_0000737 ;
