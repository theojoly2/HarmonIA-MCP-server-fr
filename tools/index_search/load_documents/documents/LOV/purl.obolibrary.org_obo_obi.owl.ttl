    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A part of a publication about an investigation that is about the study design of the investigation"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    ns1:IAO_0000118 "experimental"@en,
        "experimental procedures"@en,
