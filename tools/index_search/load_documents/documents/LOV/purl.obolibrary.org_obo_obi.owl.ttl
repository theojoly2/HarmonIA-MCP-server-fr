ns1:OBI_0400140 a owl:Class ;
    rdfs:label "gel tank"@en ;
    ns1:IAO_0000111 "gel tank"@en ;
    ns1:IAO_0000112 "CHEF gel box, slab gel box, capillary electrophoresis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a device which holds a gel and running buffers to allow electrophoresis to be performed. A gel tank has the function to contain and to control the contained environment and transfer energy from an energy supply through the running buffers to the gel matrix and the material with charged molecules in an electric field across a porous matrix or medium with the objective to separate the charged molecules."@en ;
    ns1:IAO_0000117 "Person:Frank Gibson"^^xsd:string,
        "Person:Kevin Clancy"@en ;
    ns1:IAO_0000118 "electrophoresis box"@en,
        "electrophoresis unit"@en ;
    ns1:IAO_0000119 "sep:00095"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
