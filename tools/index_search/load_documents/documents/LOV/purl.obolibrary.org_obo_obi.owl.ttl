    ns1:IAO_0000111 "dbGaP study identifier"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A central registered identifier symbol that denotes a specific study in dbGaP."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
