ns1:OBI_1110061 a owl:Class ;
    rdfs:label "exposure resulting in immune reactivity"@en ;
    ns1:IAO_0000111 "exposure resulting in immune reactivity"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process in which an organism (host) is exposed to some material entity, which results in an immune reactivity"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:OBI_1110087 a owl:Class ;
    rdfs:label "donor"@en ;
    ns1:IAO_0000111 "donor"^^xsd:string ;
    ns1:IAO_0000112 "A T cell line from a PPD(+) donor."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A role which inheres in an organism or part thereof from which any part including cell, organ or tissue is removed with the intention that the donated part will be placed into another organism and/or cultured in vitro."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "donor role"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"@en ;
    ns1:IAO_0000232 "Definition modified by HP to deal with the case where an organ may be removed for donation but is not transplanted as intended."^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_1110091 a owl:Class ;
    rdfs:label "immune epitope carrier role"@en ;
    ns1:IAO_0000111 "immune epitope carrier role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A role inhering in a material entity that is covalently bound to an epitope in order to increase the epitopes immunogenicity."@en ;
    ns1:IAO_0000116 "03/21/2010,  BP: surveying the literature, this seems to be a messy term. Need to clarify what material entities can be carriers, and if only immunogenicity (not antigenicity) is effected by their presence."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_1110095 a owl:Class ;
    rdfs:label "blood harvesting"@en ;
    ns1:IAO_0000111 "blood harvesting"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A material separation where blood is taken from an organism."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
