ns1:OBI_0002028 a owl:Class ;
    rdfs:label "SAGE ditag library preparation"@en ;
    ns1:IAO_0000111 "SAGE ditag library preparation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A library preparation in which tags identifiying transcripts are created, ligated to form ditags, amplified, concatemerized and ligated into a vector to create a library.\\n" ;
    ns1:IAO_0000116 "Related tracker:https://sourceforge.net/p/obi/obi-terms/720/" ;
    ns1:IAO_0000117 "Person:Chris Stoeckert" ;
    ns1:IAO_0000119 "PMID:15905473" ;
    rdfs:subClassOf ns1:OBI_0000711 .

ns1:OBI_0002036 a owl:Class ;
    rdfs:label "array based nucleic acid structure mapping assay" ;
    ns1:IAO_0000111 "array based nucleic acid structure mapping assay" ;
    ns1:IAO_0000112 "pmid:23580730"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay which aims to provide information about the in vivo organization/structure of nucleic acids using chemical or enzymatic probes using a microarray."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string,
        "Janos Demeter"^^xsd:string ;
    ns1:IAO_0000119 "OBI:0000870"^^xsd:string ;
    ns1:IAO_0000233 "https://sourceforge.net/p/obi/obi-terms/725/"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 .

ns1:OBI_0002043 a owl:Class ;
    rdfs:label "individual-nucleotide resolution cross-linking and immunoprecipitation sequencing assay" ;
    ns1:IAO_0000111 "individual-nucleotide resolution cross-linking and immunoprecipitation sequencing assay" ;
    ns1:IAO_0000112 "Protein-RNA interactions: new genomic technologies and perspectives. Nature Reviews Genetics 13 (2): 77-83. doi:10.1038/nrg3141"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cross-linking immunoprecipitation high-throughput sequencing assay that identifies protein-RNA interactions using UV light to covalently bind proteins and RNA molecules, allowing for a very stringent purification of the linked protein-RNA complexes."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string,
        "Jie Zheng"^^xsd:string,
        "Venkat Malladi"^^xsd:string ;
    ns1:IAO_0000118 "iCLIP"^^xsd:string,
        "iCLIP assay"^^xsd:string,
        "individual-nucleotide resolution cross-linking and immunoprecipitation"^^xsd:string ;
    ns1:IAO_0000119 "doi:10.1016/j.ymeth.2013.10.011"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001858 .

ns1:OBI_0002077 a owl:Class ;
    rdfs:label "specimens derived from shared ancestor"@en ;
    ns1:IAO_0000111 "specimens derived from shared ancestor"@en ;
    ns1:IAO_0000112 "Aliquoting one specimen to multiple tubes and the collection of the aliquoted specimens are a specimen family. Slicing a tissue specimen into multiple sections for microscopy."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A collection of specimens derived from one common specimen via one or more material processing process(es)."@en ;
    ns1:IAO_0000116 "Details see tracker: https://sourceforge.net/p/obi/obi-terms/778/" ;
    ns1:IAO_0000117 "Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000118 "specimen family"@en ;
    ns1:IAO_0000119 "Duke Biobank, OBIB, OBI"@en ;
    dc:source "Biobank" ;
    rdfs:subClassOf ns1:OBI_0002076 .

ns1:OBI_0002082 a owl:Class ;
    rdfs:label "reporter gene assay" ;
    ns1:IAO_0000111 "reporter gene assay" ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An assay that detects expression of a reporter gene that was inserted under the control of a regulatory sequence of interest."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string,
        "Paul D. Thomas"^^xsd:string ;
    ns1:IAO_0000118 "reporter gene detection assay"^^xsd:string ;
