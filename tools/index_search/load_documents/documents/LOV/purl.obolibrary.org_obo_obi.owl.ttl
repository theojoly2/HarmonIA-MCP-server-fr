ns1:OBI_0000181 a owl:Class ;
    rdfs:label "population"@en ;
    ns1:IAO_0000111 "population"@en ;
    ns1:IAO_0000112 "PMID12564891. Environ Sci Technol. 2003 Jan 15;37(2):223-8. Effects of historic PCB exposures on the reproductive success of the Hudson River striped bass population."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a population is a collection of individuals from the same taxonomic class living, counted or sampled at a particular site or in a particular area"@en ;
    ns1:IAO_0000116 "1/28/2013, BP, on the call it was raised that we may want to switch to an external ontology for all populatin terms: \\nhttp://code.google.com/p/popcomm-ontology/" ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "adapted from Oxford English Dictionnary"@en ;
    ns1:IAO_0000232 "rem1: collection somehow always involve a selection process"@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:OBI_0000182 a owl:Class ;
    rdfs:label "nuclear magnetic resonance 3D structure determination assay" ;
    ns1:IAO_0000111 "nuclear magnetic resonance 3D structure determination assay" ;
    ns1:IAO_0000112 "Determining the binding of epitope-specific nanobody cAb-HuL5 to wild type human lysozyme by chemical shift perturbations in NMR spectra (Erwin De Genst, J Phys Chem B 2013)."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A 3D structure determination assay that uses magnetic properties of atomic nuclei to determine the 3D structure and dynamics of molecules in the input sample."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string,
        "PlanAndPlannedProcess Branch"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0600045 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0600045 [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000055 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000052 ;
                                                        owl:someValuesFrom ns1:OBI_0000566 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom ns1:OBI_0000566 ] ) ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0001155 ] ) ] .

