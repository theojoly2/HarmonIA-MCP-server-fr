ns1:IAO_0000645 a owl:Class ;
    rdfs:label "tables section"@en ;
    ns1:IAO_0000111 "tables section"@en ;
    ns1:IAO_0000112 "The section labelled 'tables' in a typical scientific journal article."@en ;
    ns1:IAO_0000115 "A part of a document that contains one or more tables."@en ;
    ns1:IAO_0000117 "PERSON: Bill Baumgartner"@en ;
    ns1:IAO_0000118 "tables"@en ;
    ns1:IAO_0000233 <https://github.com/information-artifact-ontology/IAO/issues/183> ;
