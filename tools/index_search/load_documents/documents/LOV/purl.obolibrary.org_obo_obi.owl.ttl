    ns1:IAO_0000233 "https://github.com/obi-ontology/obi/issues/781"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 .

ns1:OBI_0002087 a owl:Class ;
    rdfs:label "containing a specimen function"@en ;
    ns1:IAO_0000111 "containing a specimen function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A contain function that involves physical contact with a specimen. This function is typically performed in such a way that the specimen is usable for an investigation or assay."@en ;
    ns1:IAO_0000116 "For details see tracker item: http://sourceforge.net/p/obi/obi-terms/792/"@en ;
    ns1:IAO_0000117 "Chris Stoeckert"@en ;
    ns1:IAO_0000119 "Duke Biobank, OBIB" ;
    dc:source "Biobank"@en ;
    rdfs:subClassOf ns1:OBI_0000370 .

ns1:OBI_0002091 a owl:Class ;
    rdfs:label "5' rapid amplification of cDNA ends"@en ;
    ns1:IAO_0000111 "5' rapid amplification of cDNA ends"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A rapid amplication of cDNA ends to amplify a mRNA sequence between a defined internal site and the 5' end of the mRNA."@en ;
    ns1:IAO_0000116 "For details see tracker item: https://sourceforge.net/p/obi/obi-terms/790/"@en ;
    ns1:IAO_0000117 "Jason Hilton, Chris Stoeckert"@en ;
    ns1:IAO_0000118 "5' RACE"@en ;
    ns1:IAO_0000119 "https://www.thermofisher.com/us/en/home/references/protocols/nucleic-acid-amplification-and-expression-profiling/cdna-protocol/5-race-system-for-rapid-amplification-of-cdna-ends.html"@en ;
    dc:source "ENCODE"@en ;
    rdfs:subClassOf ns1:OBI_0002090 .

ns1:OBI_0002106 a owl:Class ;
    rdfs:label "carboxyfluorescein succinimidyl ester staining assay" ;
    ns1:IAO_0000111 "carboxyfluorescein succinimidyl ester staining assay" ;
    ns1:IAO_0000112 "Measuring T cell proliferation based on the progressive halving of CFSE fluorescence within daughter cells following each cell division."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a assay detecting a molecular label assay where the amount of carboxyfluorescein succinimidyl ester is measured using fluorescence detection."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000118 "CFSE assay"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0001501 ],
        ns1:OBI_0600017 .

ns1:OBI_0002108 a owl:Class ;
    rdfs:label "small-angle scattering assay" ;
    ns1:IAO_0000111 "small-angle scattering assay" ;
    ns1:IAO_0000112 "Targeting a solution of antibody bound to a protein with a neutron beam to determine the binding site of the antibody on the protein"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A 3D structure determination assay in which the scattering pattern of a neutron or x-ray beam targeted at a material entity is recorded at small angles relative to the incident beam to determine the size, shape and structure of the material entity examined."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000118 "SAXS"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0600045 .

ns1:OBI_0002123 a owl:Class ;
    rdfs:label "IHC slide staining"@en ;
    ns1:IAO_0000111 "IHC slide staining"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A staining using labeled antibodies, i.e. the analytical part of immunohistochemistry. The staining is applied to fixed specimens on slides to identify biomarkers in tissues."@en ;
    ns1:IAO_0000117 "Chris Stoeckert, Ned Haubein"@en ;
    ns1:IAO_0000119 "http://www.agilent.com/cs/library/technicaloverviews/public/08002_ihc_staining_methods.pdf"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0302887 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OMIABIS_0000052 ] ) ],
        ns1:OBI_0302887 .

ns1:OBI_0002124 a owl:Class ;
    rdfs:label "H&E slide staining"@en ;
    ns1:IAO_0000111 "H&E slide staining"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A staining using hematoxylin and eosin. The staining is applied to fixed specimens on slides to observe the whole structure and morphology of cells in a tissue; nuclei are stained dark blue/purple while cytoplasm is stained pink."@en ;
    ns1:IAO_0000117 "Chris Stoeckert, Ned Haubein"@en ;
    ns1:IAO_0000119 "http://www.histalim.com/accueil/activities/our-services/histology/hematoxylin-eosin-2/"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0302887 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OMIABIS_0000052 ] ) ],
        ns1:OBI_0302887 .

ns1:OBI_0002135 a owl:DatatypeProperty ;
    rdfs:label "has specified value"@en ;
    ns1:IAO_0000111 "has specified value"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A relation between a value specification and a literal." ;
    ns1:IAO_0000116 "This is not an RDF/OWL object property. It is intended to link a value found in e.g. a database column of 'M' (the literal) to an instance of a value specification class, which can then be linked to indicate that this is about the biological gender of a human subject." ;
    ns1:IAO_0000119 "OBI" ;
    rdfs:domain ns1:OBI_0001933 .

