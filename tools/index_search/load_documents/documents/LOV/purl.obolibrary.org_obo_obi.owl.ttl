    rdfs:label "vascular endothelial growth factor production"^^xsd:string ;
    ns1:IAO_0000111 "vascular endothelial growth factor production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of vascular endothelial growth factor production due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

