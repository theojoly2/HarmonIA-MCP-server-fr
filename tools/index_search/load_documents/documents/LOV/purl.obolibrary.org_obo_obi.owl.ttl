ns1:CHEBI_32142 a owl:Class ;
    rdfs:label "sodium citrate dihydrate"^^xsd:string ;
    ns1:IAO_0000111 "sodium citrate dihydrate"^^xsd:string ;
    ns1:IAO_0000115 "The dihydrate of trisodium citrate."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_33709 a owl:Class ;
    rdfs:label "amino acid"^^xsd:string ;
    ns1:IAO_0000111 "amino acid"^^xsd:string ;
    ns1:IAO_0000115 "A carboxylic acid containing one or more amino groups."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_37586 a owl:Class ;
    rdfs:label "sodium phosphate"^^xsd:string ;
    ns1:IAO_0000111 "sodium phosphate"^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CL_0000066 a owl:Class ;
    rdfs:label "epithelial cell"^^xsd:string ;
    ns1:IAO_0000111 "epithelial cell"^^xsd:string ;
    ns1:IAO_0000115 "A cell that is usually found in a two-dimensional sheet with a free surface. The cell has a cytoskeleton that allows for tight cell to cell contact and for cell polarity where apical part is directed towards the lumen and the basal part to the basal lamina."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000000 .

ns1:CL_0000232 a owl:Class ;
    rdfs:label "erythrocyte"^^xsd:string ;
    ns1:IAO_0000111 "erythrocyte"^^xsd:string ;
    ns1:IAO_0000115 "A red blood cell. In mammals, mature erythrocytes are biconcave disks containing hemoglobin whose function is to transport oxygen."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000000 .

ns1:CL_0000578 a owl:Class ;
    rdfs:label "experimentally modified cell in vitro"^^xsd:string ;
    ns1:IAO_0000111 "experimentally modified cell in vitro"^^xsd:string ;
    ns1:IAO_0000115 "A cell in vitro that has undergone physical changes as a consequence of a deliberate and specific experimental procedure."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0000094 ],
        ns1:CL_0000000,
        ns1:OBI_0000047 .

ns1:CL_0000625 a owl:Class ;
    rdfs:label "CD8-positive, alpha-beta T cell"^^xsd:string ;
    ns1:IAO_0000111 "CD8-positive, alpha-beta T cell"^^xsd:string ;
    ns1:IAO_0000115 "A T cell expressing an alpha-beta T cell receptor and the CD8 coreceptor."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000789 .

ns1:CL_0000842 a owl:Class ;
    rdfs:label "mononuclear cell"^^xsd:string ;
    ns1:IAO_0000111 "mononuclear cell"^^xsd:string ;
    ns1:IAO_0000115 "A leukocyte with a single non-segmented nucleus in the mature form."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000000 .

ns1:ENVO_00001998 a owl:Class ;
    rdfs:label "soil"^^xsd:string ;
    ns1:IAO_0000111 "soil"^^xsd:string ;
    ns1:IAO_0000115 "Soil is an environmental material which is primarily composed of minerals, varying proportions of sand, silt, and clay, organic material such as humus, gases, liquids, and a broad range of resident micro- and macroorganisms."^^xsd:string ;
    ns1:IAO_0000412 ns1:envo.owl ;
    rdfs:subClassOf ns1:ENVO_00010483 .

ns1:GO_0001047 a owl:Class ;
    rdfs:label "core promoter binding"^^xsd:string ;
    ns1:IAO_0000111 "core promoter binding"^^xsd:string ;
    ns1:IAO_0000115 "Interacting selectively and non-covalently with the regulatory region composed of the transcription start site and binding sites for the basal transcription machinery. Binding may occur as a sequence specific interaction or as an interaction observed only once a factor has been recruited to the DNA by other factors."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:OBI_0001588 .

ns1:GO_0002514 a owl:Class ;
    rdfs:label "B cell tolerance induction"^^xsd:string ;
    ns1:IAO_0000111 "B cell tolerance induction"^^xsd:string ;
    ns1:IAO_0000115 "A process involving any mechanism for tolerance induction in B cells."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0002507 .

ns1:GO_0003823 a owl:Class ;
    rdfs:label "antigen binding"^^xsd:string ;
    ns1:IAO_0000111 "antigen binding"^^xsd:string ;
    ns1:IAO_0000115 "Interacting selectively and non-covalently with an antigen, any substance which is capable of inducing a specific immune response and of reacting with the products of that response, the specific antibody or specifically sensitized T-lymphocytes, or both. Binding may counteract the biological activity of the antigen."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns1:GO_0003964 a owl:Class ;
    rdfs:label "RNA-directed DNA polymerase activity"^^xsd:string ;
    ns1:IAO_0000111 "RNA-directed DNA polymerase activity"^^xsd:string ;
    ns1:IAO_0000115 "Catalysis of the reaction: deoxynucleoside triphosphate + DNA(n) = diphosphate + DNA(n+1). Catalyzes RNA-template-directed extension of the 3'- end of a DNA strand by one deoxynucleotide at a time."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0003824 .

ns1:GO_0006909 a owl:Class ;
    rdfs:label "phagocytosis"^^xsd:string ;
    ns1:IAO_0000111 "phagocytosis"^^xsd:string ;
    ns1:IAO_0000115 "An endocytosis process that results in the engulfment of external particulate material by phagocytes. The particles are initially contained within phagocytic vacuoles (phagosomes), which then fuse with primary lysosomes to effect digestion of the particles."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0006974 a owl:Class ;
    rdfs:label "cellular response to DNA damage stimulus"^^xsd:string ;
    ns1:IAO_0000111 "cellular response to DNA damage stimulus"^^xsd:string ;
    ns1:IAO_0000115 "Any process that results in a change in state or activity of a cell (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus indicating damage to its DNA from environmental insults or errors during metabolism."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0050896 .

ns1:GO_0007049 a owl:Class ;
    rdfs:label "cell cycle"^^xsd:string ;
    ns1:IAO_0000111 "cell cycle"^^xsd:string ;
    ns1:IAO_0000115 "The progression of biochemical and morphological phases and events that occur in a cell during successive cell replication or nuclear replication events. Canonically, the cell cycle comprises the replication and segregation of genetic material followed by the division of the cell, but in endocycles or syncytial cells nuclear replication or nuclear division may not be followed by cell division."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0019815 a owl:Class ;
    rdfs:label "B cell receptor complex"^^xsd:string ;
    ns1:IAO_0000111 "B cell receptor complex"^^xsd:string ;
    ns1:IAO_0000115 "An immunoglobulin complex that is present in the plasma membrane of B cells and that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains and a signaling subunit, a heterodimer of the Ig-alpha and Ig-beta proteins."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:OBI_1110022 .

ns1:GO_0030041 a owl:Class ;
    rdfs:label "actin filament polymerization"^^xsd:string ;
    ns1:IAO_0000111 "actin filament polymerization"^^xsd:string ;
    ns1:IAO_0000115 "Assembly of actin filaments by the addition of actin monomers to a filament."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0030097 a owl:Class ;
    rdfs:label "hemopoiesis"^^xsd:string ;
    ns1:IAO_0000111 "hemopoiesis"^^xsd:string ;
    ns1:IAO_0000115 "The process whose specific outcome is the progression of the myeloid and lymphoid derived organ/tissue systems of the blood and other parts of the body over time, from formation to the mature structure. The site of hemopoiesis is variable during development, but occurs primarily in bone marrow or kidney in many adult vertebrates."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0032606 a owl:Class ;
    rdfs:label "type I interferon production"^^xsd:string ;
    ns1:IAO_0000111 "type I interferon production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of type I interferon due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. Type I interferons include the interferon-alpha, beta, delta, episilon, zeta, kappa, tau, and omega gene families."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0032607 a owl:Class ;
    rdfs:label "interferon-alpha production"^^xsd:string ;
    ns1:IAO_0000111 "interferon-alpha production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of interferon-alpha due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0032606 .

ns1:GO_0033036 a owl:Class ;
    rdfs:label "macromolecule localization"^^xsd:string ;
    ns1:IAO_0000111 "macromolecule localization"^^xsd:string ;
    ns1:IAO_0000115 "Any process in which a macromolecule is transported to, or maintained in, a specific location."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0034061 a owl:Class ;
    rdfs:label "DNA polymerase activity"^^xsd:string ;
    ns1:IAO_0000111 "DNA polymerase activity"^^xsd:string ;
    ns1:IAO_0000115 "Catalysis of the reaction: deoxynucleoside triphosphate + DNA(n) = diphosphate + DNA(n+1); the synthesis of DNA from deoxyribonucleotide triphosphates in the presence of a nucleic acid template and a 3'hydroxyl group."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0003824 .

ns1:GO_0036392 a owl:Class ;
    rdfs:label "chemokine (C-C motif) ligand 20 production"^^xsd:string ;
    ns1:IAO_0000111 "chemokine (C-C motif) ligand 20 production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of chemokine (C-C motif) ligand 20 (CCL20) due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0032602 .

ns1:GO_0043227 a owl:Class ;
    rdfs:label "membrane-bounded organelle"^^xsd:string ;
    ns1:IAO_0000111 "membrane-bounded organelle"^^xsd:string ;
    ns1:IAO_0000115 "Organized structure of distinctive morphology and function, bounded by a single or double lipid bilayer membrane. Includes the nucleus, mitochondria, plastids, vacuoles, and vesicles. Excludes the plasma membrane."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0005575 .

ns1:GO_0044807 a owl:Class ;
    rdfs:label "macrophage migration inhibitory factor production"^^xsd:string ;
    ns1:IAO_0000111 "macrophage migration inhibitory factor production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of macrophage migration inhibitory factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0044808 a owl:Class ;
    rdfs:label "Oncostatin M production"^^xsd:string ;
    ns1:IAO_0000111 "Oncostatin M production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of Oncostatin M due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0044809 a owl:Class ;
    rdfs:label "chemokine (C-C motif) ligand 17 production"^^xsd:string ;
    ns1:IAO_0000111 "chemokine (C-C motif) ligand 17 production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of chemokine (C-C motif) ligand 17 (CCL17) due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0032602 .

ns1:GO_0048869 a owl:Class ;
    rdfs:label "cellular developmental process"^^xsd:string ;
    ns1:IAO_0000111 "cellular developmental process"^^xsd:string ;
    ns1:IAO_0000115 "A biological process whose specific outcome is the progression of a cell over time from an initial condition to a later condition."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0051276 a owl:Class ;
    rdfs:label "chromosome organization"^^xsd:string ;
    ns1:IAO_0000111 "chromosome organization"^^xsd:string ;
    ns1:IAO_0000115 "A process that is carried out at the cellular level that results in the assembly, arrangement of constituent parts, or disassembly of chromosomes, structures composed of a very long molecule of DNA and associated proteins that carries hereditary information. This term covers covalent modifications at the molecular level as well as spatial relationships among the major components of a chromosome."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:HP_0000855 a owl:Class ;
    rdfs:label "Insulin resistance"^^xsd:string ;
    ns1:IAO_0000111 "Insulin resistance"^^xsd:string ;
    ns1:IAO_0000115 "Increased resistance towards insulin, that is, diminished effectiveness of insulin in reducing blood glucose levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:hp.owl ;
    rdfs:subClassOf ns1:BFO_0000016 .

ns1:IAO_0000007 a owl:Class ;
    rdfs:label "action specification"@en ;
    ns1:IAO_0000112 "Pour the contents of flask 1 into flask 2"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a directive information entity that describes an action the bearer will take"@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "OBI Plan and Planned Process branch"@en ;
    rdfs:subClassOf ns1:IAO_0000033 .

ns1:IAO_0000013 a owl:Class ;
    rdfs:label "journal article"@en ;
    ns1:IAO_0000111 "journal article"@en ;
    ns1:IAO_0000112 "Examples are articles published in the journals, Nature and Science. The content can often be cited by reference to a paper based encoding, e.g.  Authors, Title of article, Journal name, date or year of publication, volume and page number."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a report that is published in a journal"@en ;
    ns1:IAO_0000117 "person:Alan Ruttenberg"@en,
        "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000159"@en,
        "group:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000088 .

ns1:IAO_0000029 a owl:Class ;
    rdfs:label "numeral"@en ;
    ns1:IAO_0000111 "numeral"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A symbol that denotes a number."@en ;
    ns1:IAO_0000117 "PERSON: Jonathan Rees"@en ;
    rdfs:subClassOf ns1:IAO_0000028 .

ns1:IAO_0000037 a owl:Class ;
    rdfs:label "dot plot"@en ;
    ns1:IAO_0000111 "dot plot"@en ;
    ns1:IAO_0000112 "Dot plot of SSC-H and FSC-H."@en ;
    ns1:IAO_0000114 ns1:IAO_0000002 ;
    ns1:IAO_0000115 "A dot plot is a report graph which is a graphical representation of data where each data point is represented by a single dot placed on coordinates corresponding to data point values in particular dimensions."@en ;
    ns1:IAO_0000117 "person:Allyson Lister"@en,
        "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000123"@en,
        "group:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000038 .

ns1:IAO_0000079 a owl:Class ;
    rdfs:label "density plot"@en ;
    ns1:IAO_0000111 "density plot"@en ;
    ns1:IAO_0000112 "Density plot of SSC-H and FSC-H."@en ;
    ns1:IAO_0000114 ns1:IAO_0000002 ;
    ns1:IAO_0000115 "A density plot is a report graph which is a graphical representation of data where the tint of a particular pixel corresponds to some kind of function corresponding the the amount of data points relativelly with their distance from the the pixel."@en ;
    ns1:IAO_0000117 "person:Allyson Lister"@en,
        "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000179"@en,
        "group:Flow Cytometry community"@en ;
    rdfs:subClassOf ns1:IAO_0000038 .

ns1:IAO_0000119 a owl:AnnotationProperty ;
    rdfs:label "definition source"@en ;
    ns1:IAO_0000111 "definition source"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "formal citation, e.g. identifier in external database to indicate / attribute source(s) for the definition. Free text indicate / attribute source(s) for the definition. EXAMPLE: Author Name, URI, MeSH Term C04, PUBMED ID, Wiki uri on 31.01.2007"@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "Discussion on obo-discuss mailing-list, see http://bit.ly/hgm99w"^^xsd:string,
        "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
    rdfs:isDefinedBy ns1:iao.owl .

ns1:IAO_0000183 a owl:Class ;
    rdfs:label "dendrogram"@en ;
    ns1:IAO_0000111 "dendrogram"@en ;
    ns1:IAO_0000112 "Dendrograms are often used in computational biology to\\nillustrate the clustering of genes."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A dendrogram is a report graph which is a tree diagram\\nfrequently used to illustrate the arrangement of the clusters produced by a\\nclustering algorithm."@en ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert"@en,
        "PERSON:James Malone"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Dendrogram"@en ;
    rdfs:subClassOf ns1:IAO_0000038 .

ns1:IAO_0000185 a owl:Class ;
    rdfs:label "photograph"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A photograph is created by projecting an image onto a photosensitive surface such as a chemically treated plate or film, CCD receptor, etc."@en ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"@en,
        "PERSON:Joanne Luciano"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000119 "WEB: http://en.wiktionary.org/wiki/photograph"@en ;
    rdfs:subClassOf ns1:IAO_0000101 .

