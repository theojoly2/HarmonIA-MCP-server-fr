    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An occurrence of disease is a process involving pathologic changes within an organism"@en ;
    ns1:IAO_0000116 "replaced by http://purl.obolibrary.org/obo/OGMS_0000063 'disease course'\\nDetails see https://sourceforge.net/tracker/?func=detail&aid=3515228&group_id=177891&atid=886178"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
