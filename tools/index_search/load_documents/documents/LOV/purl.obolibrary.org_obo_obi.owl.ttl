    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "environmental_material_collection is an acquisition where an object is taken from an environment and put into a storage container. Roles include, environment, thing collected, container, acquirer."@en ;
    ns1:IAO_0000116 "relabel the term and add axiom connecting to EnVO:'environmental material'\\ndiscussed on obi-dev call 9/28/2015, details see: https://sourceforge.net/p/obi/obi-terms/779/" ;
    ns1:IAO_0000117 "Bjoern Peters, Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    ns1:IAO_0000232 "the researcher is very interested in the location"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000684 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:ENVO_00010483 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100051 ],
        ns1:OBI_0000659 .

ns1:OBI_0600016 a owl:Class ;
    rdfs:label "pooling specimens"@en ;
    ns1:IAO_0000111 "pooling specimens"^^xsd:string ;
    ns1:IAO_0000112 "http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=104564; Combining spleens of 20 mice, Combining supernatant from a cell culture obtained at different time points"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "physical combination of several instances of like material"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000118 "sample pooling"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "like' is one of the things that you should be controling for in a well-designed experiment. The instances of material need to have the same class."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100051 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000686 ],
        [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:OBI_0000293 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0302716 ],
        ns1:OBI_0000652 .

ns1:OBI_0600018 a owl:Class ;
    rdfs:label "material portioning"@en ;
    ns1:IAO_0000111 "material portioning"@en ;
    ns1:IAO_0000112 "pouring 50 mL aliquots of fetal calf serum into conical tubes from a 500 mL stock"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a material processing in which the input substance is partitioned into a number of portions that are similar in composition."@en ;
    ns1:IAO_0000117 "PERSON:Bjoern Peters"@en ;
    ns1:IAO_0000118 "aliquoting"@en,
        "apportioning"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000678 ],
        ns1:OBI_0600014 .

ns1:OBI_0600019 a owl:Class ;
    rdfs:label "non-specific labeling"@en ;
    ns1:IAO_0000111 "non-specific labeling"@en ;
    ns1:IAO_0000112 "The addition of phycoerytherin label to an anti-CD8 antibody, to label all antibodies."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "The addition of a reagent labeling the entire input biomaterial enabling future detection of the output biomaterial"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "definition blessed by Allyson, Bjoern, Jay & Randi"@en ;
    rdfs:subClassOf ns1:OBI_0600038 .

ns1:OBI_0600021 a owl:Class ;
    rdfs:label "cell fixation"@en ;
    ns1:IAO_0000111 "cell fixation"@en ;
    ns1:IAO_0000112 "http://www.tissuearray.org/CellLinesProtocolforTMA112.pdf; the treatment of CD8+ cells with methanol at -20oC; http://www.ncbi.nlm.nih.gov/sites/entrez?cmd=Retrieve&db=PubMed&amp;list_uids=16080188&dopt=AbstractPlus"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application to preserve defined  qualities of cells or tissues (sample) which may otherwise change over time"@en ;
    ns1:IAO_0000116 "should include capturing what qualities are being preserved"@en ;
    ns1:IAO_0000117 "PERSON:Bjoern Peters"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "we could generalize this for other input materials"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:CL_0000000 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0001025 ;
                                owl:someValuesFrom ns1:OBI_0100051 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:CHEBI_23367 ns1:OBI_0302729 ) ] ],
        ns1:OBI_0000094 .

ns1:OBI_0600022 a owl:Class ;
    rdfs:label "excision"@en ;
    ns1:IAO_0000111 "excision"@en ;
    ns1:IAO_0000112 "Cutting out the portion of a gel which contains a DNA fragment"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "the use physical means to remove a portion of a substance from the rest"@en ;
    ns1:IAO_0000117 "Alan Ruttenberg, Kevin Clancy"@en ;
    ns1:IAO_0000119 "www.crohnsresource.com/glossary.jsp (via google define:resection)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        ns1:OBI_0600014 .

ns1:OBI_0600025 a owl:Class ;
    rdfs:label "substance detection assay" ;
    ns1:IAO_0000111 "substance detection assay" ;
    ns1:IAO_0000112 "the detection of phycoerytherin by means of flow cytometry"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An assay that detects a specified substance"^^xsd:string ;
    ns1:IAO_0000117 "Kevin Clancy"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
