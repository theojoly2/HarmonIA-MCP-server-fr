ns1:UO_0000010 a ns1:UO_0000003,
        owl:NamedIndividual ;
    rdfs:label "second"^^xsd:string ;
    ns1:IAO_0000111 "second"^^xsd:string ;
    ns1:IAO_0000115 "A time unit which is equal to the duration of 9 192 631 770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the caesium 133 atom."^^xsd:string ;
    ns1:IAO_0000118 "s"^^xsd:string,
        "sec"^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl .

