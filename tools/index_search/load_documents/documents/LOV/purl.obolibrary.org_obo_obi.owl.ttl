ns1:OBI_0001933 a owl:Class ;
    rdfs:label "value specification" ;
    ns1:IAO_0000111 "value specification" ;
    ns1:IAO_0000112 "The value of 'positive' in a classification scheme of \"positive or negative\"; the value of '20g' on the quantitative scale of mass." ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An information content entity that specifies a value within a classification scheme or on a quantitative scale." ;
    ns1:IAO_0000116 "This term is currently a descendant of 'information content entity', which requires that it 'is about' something. A value specification of '20g' for a measurement data item of the mass of a particular mouse 'is about' the mass of that mouse. However there are cases where a value specification is not clearly about any particular. In the future we may change 'value specification' to remove the 'is about' requirement." ;
    ns1:IAO_0000117 "PERSON:Bjoern Peters" ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0001977 a owl:Class ;
    rdfs:label "cytometry assay" ;
    ns1:IAO_0000111 "cytometry assay" ;
    ns1:IAO_0000112 "An intracellular material detection by flow cytometry assay measuring peforin inside a culture of T cells."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that measures properties of cells."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 ;
