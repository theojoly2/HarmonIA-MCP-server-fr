            owl:someValuesFrom ns1:BFO_0000040 ],
        ns1:OBI_0000094 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000686 ] .

ns1:OBI_0000675 a owl:Class ;
    rdfs:label "statistical hypothesis test objective"@en ;
    ns1:IAO_0000111 "statistical hypothesis test objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a data transformation objective where the aim is to estimate statistical significance with the aim of proving or disproving a hypothesis by means of some data transformation "^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000118 "hypothesis test objective"^^xsd:string ;
    ns1:IAO_0000119 "WEB:  http://en.wikipedia.org/wiki/Statistical_hypothesis_testing"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0000679 a owl:Class ;
    rdfs:label "average value"@en ;
    ns1:IAO_0000111 "average value"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A  data item that is produced as the output of an averaging data transformation and represents the average value of the input data."@en ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Monnie McGee"^^xsd:string ;
    ns1:IAO_0000118 "arithmetic mean"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000027 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0200170 ] .

ns1:OBI_0000686 a owl:Class ;
    rdfs:label "material combination objective"^^xsd:string ;
