ns1:OBI_0001674 a owl:Class ;
    rdfs:label "cap analysis of gene expression assay" ;
    ns1:IAO_0000111 "cap analysis of gene expression assay" ;
    ns1:IAO_0000112 "5' end-centered expression profiling using cap-analysis gene expression and next-generation sequencing. PMID:22362160"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A transcription profiling assay which measures RNA transcript abundances in biological samples by extracting 5' ends of capped transcripts, RTPCR and sequence those. Copy numbers of CAGE tags provide a way of quantification and provide a measure of expression of the transcriptome"^^xsd:string ;
    ns1:IAO_0000117 "Marcus Chibucos"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "CAGE"^^xsd:string ;
    ns1:IAO_0000119 "PMID:14663149"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
