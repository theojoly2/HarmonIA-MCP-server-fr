ns1:OBI_0001206 a owl:Class ;
    rdfs:label "ELISPOT assay measuring epitope specific granulocyte macrophage colony-stimulating factor production by T cells" ;
    ns1:IAO_0000111 "ELISPOT assay measuring epitope specific granulocyte macrophage colony-stimulating factor production by T cells" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay of epitope specific granulocyte macrophage colony stimulating factor production by T cells that uses an ELISPOT assay."^^xsd:string ;
