    ns1:IAO_0000111 "statistical hypothesis test"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A statistical hypothesis test data transformation is a data transformation that has objective statistical hypothesis test."@en ;
