    ns1:IAO_0000111 "administration in vivo with infectious agent"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is an administration of an infectious agent to a host organism"@en ;
