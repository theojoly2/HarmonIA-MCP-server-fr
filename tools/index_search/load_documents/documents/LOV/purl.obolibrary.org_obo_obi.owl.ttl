ns1:OBI_0001874 a owl:Class ;
    rdfs:label "random access memory size"@en ;
    ns1:IAO_0000111 "random access memory size"@en ;
    ns1:IAO_0000112 "Gigascience. 2012 Dec 27;1(1):18. doi: 10.1186/2047-217X-1-18.\\nPMID: 23587118.\\n\"However, the error correction module in SOAPdenovo was designed for short Illumina reads (35-50 bp), which consumes an excessive amount of computational time and memory on longer reads, for example, over 150 GB memory running for two days using 40-fold 100 bp paired-end Illumina HiSeq 2000 reads\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "random access memory size is a scalar measurement datum which denotes the amount of physical memory know as random access memory present of a computer or required by a computational process or data transformation"@en ;
    ns1:IAO_0000117 "Alejandra Gonzalez-Beltran"@en,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "PRS, AGB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0001877 [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000050 ;
                                owl:someValuesFrom ns1:OBI_0400107 ] ) ] ],
        ns1:IAO_0000032 .

ns1:OBI_0001878 a owl:Class ;
    rdfs:label "establishing primary cell culture"@en ;
    ns1:IAO_0000111 "establishing primary cell culture"@en ;
    ns1:IAO_0000112 "Effects of establishing cell cultures and cell culture conditions on the proliferative life span of human fibroblasts isolated from different tissues and donors of different ages.\\nExp Cell Res. 2002 Apr 1;274(2):275-87. PMID: 11900488\\n\\nWhen harvesting blood from a human, isolating T cells, and then limited dilution cloning of the cells, the establishing_cell_culture step comprises preparing the cells at a certain dilution and plating them in a container with growth medium."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "an establishing cell culture process whereby cells explanted directly from an organismal source or specimen, and placed in culture for maintenance or propagation as a primary cell culture"@en ;
    ns1:IAO_0000119 "PERSON: Matthew Brush"@en ;
    rdfs:comment "Cells are originally plated at a certain concentration referred to as seeding density. Upon a first passage this primary culture becomes a secondary cell culture that can be propagated to become a stable and homogneous cell line. This class covers establishment of primary cultures from any native cell - 'in vivo' cells isolated from some multicellular organism, or 'in environment' unicellular organisms isolated from some natural environment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100061 ],
        ns1:OBI_0600036 .

