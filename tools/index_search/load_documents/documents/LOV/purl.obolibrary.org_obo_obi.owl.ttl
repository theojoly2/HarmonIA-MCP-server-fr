    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An analyte assay that is meant to detect with the aid of carbon or charcoal particles general antibodies that react with substances that are produced by cellular damage caused by Treponema pallidum indicating a syphilis infection. RPR tests can be done without a microscope."^^xsd:string ;
