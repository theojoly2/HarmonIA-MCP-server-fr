    ns1:IAO_0000111 "substance unit"^^xsd:string ;
    ns1:IAO_0000115 "A unit which is a standardised quantity of an element or compound with uniform composition."^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl ;
    rdfs:subClassOf ns1:IAO_0000003 .

