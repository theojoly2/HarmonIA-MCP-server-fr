ns1:GO_0001906 a owl:Class ;
    rdfs:label "cell killing"^^xsd:string ;
    ns1:IAO_0000111 "cell killing"^^xsd:string ;
    ns1:IAO_0000115 "Any process in an organism that results in the killing of its own cells or those of another organism, including in some cases the death of the other organism. Killing here refers to the induction of death in one cell by another cell, not cell-autonomous death due to internal or other environmental conditions."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0002507 a owl:Class ;
    rdfs:label "tolerance induction"^^xsd:string ;
    ns1:IAO_0000111 "tolerance induction"^^xsd:string ;
    ns1:IAO_0000115 "A process that directly activates any of the steps required for tolerance, a physiologic state in which the immune system does not react destructively against the components of an organism that harbors it or against antigens that are introduced to it."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0002524 a owl:Class ;
    rdfs:label "hypersensitivity"^^xsd:string ;
    ns1:IAO_0000111 "hypersensitivity"^^xsd:string ;
    ns1:IAO_0000115 "An inflammatory response to an exogenous environmental antigen or an endogenous antigen initiated by the adaptive immune system."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0019904 a owl:Class ;
    rdfs:label "protein domain specific binding"^^xsd:string ;
    ns1:IAO_0000111 "protein domain specific binding"^^xsd:string ;
    ns1:IAO_0000115 "Interacting selectively and non-covalently with a specific domain of a protein."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:OBI_0001588 .

ns1:GO_0032609 a owl:Class ;
    rdfs:label "interferon-gamma production"^^xsd:string ;
    ns1:IAO_0000111 "interferon-gamma production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of interferon-gamma due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. Interferon-gamma is also known as type II interferon."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0097282 a owl:Class ;
    rdfs:label "immunoglobulin-mediated neutralization"^^xsd:string ;
    ns1:IAO_0000111 "immunoglobulin-mediated neutralization"^^xsd:string ;
    ns1:IAO_0000115 "The inhibition of an antigen's biological effects by antibody binding to it. An example is neutralization of diphtheria toxin by preventing its entry into human cells via the binding of antibody specific for diphtheria toxin."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0016064 .

