        "PERSON: Melanie Courtot"@en,
        "PERSON: Tina Boussard"@en ;
    ns1:IAO_0000232 "Possible future hierarchy might include this:\\ninformation_encoding\\n>data_encoding\\n>>image_encoding"^^xsd:string ;
