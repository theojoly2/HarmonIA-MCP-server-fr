ns1:OBI_0002132 a owl:Class ;
    rdfs:label "pulse stable isotope labeling by amino acids in cell culture" ;
    ns1:IAO_0000111 "pulse stable isotope labeling by amino acids in cell culture" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that detects differences in protein abundance using samples that have been metabolically labeled in vivo with a stable non-radioactive heavy isotope containing amino acid for a short period of time. After diluting the pulsed cells into growth media without label, high resolution mass spectrometry-based proteomics is used to analyze the time-dependent decay and determine protein stability."^^xsd:string ;
    ns1:IAO_0000117 "Rob Nash"^^xsd:string ;
    ns1:IAO_0000118 "dynamic SILAC"^^xsd:string,
        "pulse SILAC"^^xsd:string,
        "pulsed SILAC"^^xsd:string ;
    ns1:IAO_0000119 "PMID:18954100"^^xsd:string,
        "PMID:19053139"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 .

