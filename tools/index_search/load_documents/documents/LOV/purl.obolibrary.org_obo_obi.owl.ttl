            owl:intersectionOf ( ns1:OBI_0002449 [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0002442 ] ) ] .

ns1:OBI_0002451 a owl:Class ;
    rdfs:label "ELISA measuring epitope specific interferon-alpha production by T cells" ;
    ns1:IAO_0000111 "ELISA measuring epitope specific interferon-alpha production by T cells" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay of epitope specific interferon-alpha production by T cells that uses an ELISA."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
