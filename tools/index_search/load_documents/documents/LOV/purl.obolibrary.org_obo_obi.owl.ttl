            owl:intersectionOf ( ns1:OBI_1110127 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:IAO_0000030 [ a owl:Restriction ;
                                            owl:onProperty ns1:IAO_0000136 ;
                                            owl:someValuesFrom [ a owl:Restriction ;
                                                    owl:onProperty ns1:OBI_1110060 ;
                                                    owl:someValuesFrom ns1:OBI_0001702 ] ] ) ] ] ) ] .

ns1:OBI_0001982 a owl:Class ;
    rdfs:label "protection from challenge in vivo intervention experiment" ;
    ns1:IAO_0000111 "protection from challenge in vivo intervention experiment" ;
    ns1:IAO_0000112 "Injecting a set of mice with a peptide and measuring symtoms to determine if their disease course was less severe than the disease course of a set of mice that were not injected with the same peptide."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An in vivo intervention experiment that tests the ability of the intervention to prevent occurrence of a disease in a host."^^xsd:string ;
    ns1:IAO_0000116 "should have challenge as intervention"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001980 .

ns1:OBI_0002224 a owl:Class ;
    rdfs:label "pathologic primary tumor stage for colon and rectum according to AJCC 7th edition" ;
    ns1:IAO_0000111 "pathologic primary tumor stage for colon and rectum according to AJCC 7th edition" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A categorical value specification that is a pathologic finding about one or more characteristics of colorectal cancer following the rules of the TNM American Joint Committee on Cancer (AJCC) version 7 classification system as they pertain to staging of the primary tumor. TNM pathologic primary tumor findings are based on clinical findings supplemented by histopathologic examination of one or more tissue specimens acquired during surgery."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "pT: Pathologic spread colorectal primary tumor (AJCC 7th Edition)"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001930 .

ns1:OBI_0002290 a owl:Class ;
    rdfs:label "pathologic distant metastases stage for colon according to AJCC 7th edition" ;
    ns1:IAO_0000111 "pathologic distant metastases stage for colon according to AJCC 7th edition" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A categorical value specification that is a pathologic finding about one or more characteristics of colon cancer following the rules of the TNM AJCC v7 classification system as they pertain to distant metastases. TNM pathologic distant metastasis findings are based on clinical findings supplemented by histopathologic examination of one or more tissue specimens acquired during surgery."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "M: colon distant metastases (AJCC 7th Edition)"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001930 .

ns1:OBI_0002298 a owl:Class ;
    rdfs:label "pathologic distant metastases stage for lung according to AJCC 7th edition" ;
    ns1:IAO_0000111 "pathologic distant metastases stage for lung according to AJCC 7th edition" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A categorical value specification that is a pathologic finding about one or more characteristics of lung cancer following the rules of the TNM AJCC v7 classification system as they pertain to distant metastases. TNM pathologic distant metastasis findings are based on clinical findings supplemented by histopathologic examination of one or more tissue specimens acquired during surgery."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "M: lung distant metastases (AJCC 7th Edition)"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001930 .

ns1:OBI_0200080 a owl:Class ;
    rdfs:label "network analysis"@en ;
    ns1:IAO_0000111 "network analysis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A data transformation that takes as input data that describes biological networks in terms of the node (a.k.a. vertex) and edge graph elements and their characteristics and generates as output properties of the constituent nodes and edges, the sub-graphs, and the entire network."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000118 "network topology analysis"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200089 a owl:Class ;
    rdfs:label "multiple testing correction method"@en ;
    ns1:IAO_0000111 "multiple testing correction method"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A multiple testing correction method is a hypothesis test performed simultaneously on M > 1 hypotheses.  Multiple testing procedures produce a set of rejected hypotheses that is an estimate for the set of false null hypotheses while controlling for a suitably define Type I error rate"^^xsd:string ;
    ns1:IAO_0000117 "Monnie McGee"^^xsd:string ;
    ns1:IAO_0000118 "multiple testing procedure"@en ;
    ns1:IAO_0000119 "PAPER: Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 9-10."^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000668 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000791 ] .

ns1:OBI_0200177 a owl:Class ;
    rdfs:label "center calculation objective"@en ;
    ns1:IAO_0000111 "center calculation objective"@en ;
    ns1:IAO_0000112 "A mean calculation which has center calculation objective is a data transformation in which the center of the input data is discovered through the calculation of a mean average."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A center calculation objective is a data transformation objective where the aim is to calculate the center of an input data set."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200178 a owl:Class ;
    rdfs:label "class discovery objective"@en ;
    ns1:IAO_0000111 "class discovery objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A class discovery objective (sometimes called unsupervised classification) is a data transformation objective where the aim is to organize input data  (typically vectors of attributes) into classes, where the number of classes and their specifications are not known a priori. Depending on usage, the class assignment can be definite or probabilistic."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000118 "clustering objective"^^xsd:string,
        "discriminant analysis objective"@en,
        "unsupervised classification objective"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"^^xsd:string,
        "PERSON: James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200181 a owl:Class ;
    rdfs:label "center calculation data transformation"@en ;
    ns1:IAO_0000111 "center calculation data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A center calculation data transformation is a data transformation that has objective of center calculation."@en ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000674 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200177 ] ) ] .

ns1:OBI_0302893 a owl:Class ;
    rdfs:label "storage"@en ;
    ns1:IAO_0000111 "storage"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18550121.Total Prostate Specific Antigen Stability Confirmed After Long-Term Storage of Serum at -80C. J Urol. 2008 Jun 10."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A maintenance process by which material entities that are not actively metabolizing are placed in well identified location and possibly under controlled environment in ad-hoc devices/structures in order to preserve and protect them from decay/alteration and maintain availability"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "OBI-Branch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000806 ],
        ns1:OBI_0000838 .

ns1:OBI_0600037 a owl:Class ;
    rdfs:label "cell culture splitting"@en ;
    ns1:IAO_0000111 "cell culture splitting"@en ;
    ns1:IAO_0000112 "The act of taking a cell culture of high density, counting the cells, removing part of the cells, and re-seeding a select number of the cells into new flasks with fresh tissue culture media."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "The act of taking part of a homogeneous cell culture and creating one or more additional separate cultures of similar qualities. input: cell_culture, output cell_culture min cardinality 2. part of cell culturing"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000118 "cell culture passaging"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:comment "An active cell culture is typically split when it has grown to confluence in its culture dish.  Cell culture splitting of a cell culture sample results in an increase in its passage number, which measures how long a sample has been propagated in vitro, and therefore how many selective or genetic changes it is likely to have undergone." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000678 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        ns1:OBI_0600014 .

ns1:OBI_1000036 a owl:Class ;
    rdfs:label "cell lysate"@en ;
    ns1:IAO_0000111 "cell lysate"@en ;
    ns1:IAO_0000112 "The effect of vaccination with the lysate of heat-shocked tumor cells on nitric oxide production in BALB/c mice with fibrosarcoma tumor. Cell Biol Int. 2008 Jul;32(7):835-40. PMID: 18455932"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a cell lysate is a material entity which is output of a cell lysis process"@en ;
    ns1:IAO_0000116 "PRS:22-02-2008: is a material which has output_role during lysis protocol-application. \\nold defintion: A mixture (collection) of cell components created by rupturing of the cell wall resulting from a lysis process"@en ;
    ns1:IAO_0000117 "PERSON: Susanna Sansone"@en ;
    ns1:IAO_0000118 "lysed material"^^xsd:string,
        "lysate"@en ;
    ns1:IAO_0000119 "GROUP: PSI"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0302894 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:CL_0000000 ],
        ns1:OBI_0000047 .

ns1:PATO_0001018 a owl:Class ;
    rdfs:label "physical quality"^^xsd:string ;
    ns1:IAO_0000111 "physical quality"^^xsd:string ;
    ns1:IAO_0000115 "A quality of a physical entity that exists through action of continuants at the physical level of organisation in relation to other entities."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001241 .

ns1:PATO_0002201 a owl:Class ;
    rdfs:label "handedness"^^xsd:string ;
    ns1:IAO_0000111 "handedness"^^xsd:string ;
    ns1:IAO_0000115 "A behavioral quality inhering ina bearer by virtue of the bearer's unequal distribution of fine motor skill between its left and right hands or feet."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000186 .

ns1:UBERON_0000479 a owl:Class ;
    rdfs:label "tissue"^^xsd:string ;
    ns1:IAO_0000111 "tissue"^^xsd:string ;
    ns1:IAO_0000115 "Multicellular anatomical structure that consists of many cells of one or a few types, arranged in an extracellular matrix such that their long-range organisation is at least partly a repetition of their short-range organisation."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UO_0000284 a ns1:UO_0000280,
        owl:NamedIndividual ;
    rdfs:label "count per nanomolar"^^xsd:string ;
    ns1:IAO_0000111 "count per nanomolar"^^xsd:string ;
    ns1:IAO_0000115 "A rate unit which is equal to one over one nanomolar."^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl .

onto: a owl:NamedIndividual,
        owl:Ontology ;
    ns2:defaultLanguage "en"^^xsd:string ;
    ns1:IAO_0000589 "Ontology for Biomedical Investigations"@en ;
    dc:contributor "Advisors for this project come from the IFOMIS group, Saarbruecken and from the Co-ODE group in Manchester"@en ;
    dc:creator "Alan Ruttenberg"@en,
        "Allyson Lister"@en,
        "Barry Smith"@en,
        "Bill Bug"@en,
        "Bjoern Peters"@en,
        "Carlo Torniai"@en,
        "Chris Mungall"@en,
        "Chris Stoeckert"@en,
        "Chris Taylor"@en,
        "Christian Bolling"@en,
        "Cristian Cocos"@en,
        "Daniel Rubin"@en,
        "Daniel Schober"@en,
        "Dawn Field"@en,
        "Dirk Derom"@en,
        "Elisabetta Manduchi"@en,
        "Eric Deutsch"@en,
        "Frank Gibson"@en,
        "Gilberto Fragoso"@en,
        "Helen C. Causton"@en,
        "Helen Parkinson"@en,
        "Holger Stenzhorn"@en,
        "James A. Overton"@en,
        "James Malone"@en,
        "Jay Greenbaum"@en,
        "Jeffrey Grethe"@en,
        "Jennifer Fostel"@en,
        "Jessica Turner"@en,
        "Jie Zheng"@en,
        "Joe White"@en,
        "John Westbrook"@en,
        "Kevin Clancy"@en,
        "Larisa Soldatova"@en,
        "Lawrence Hunter"@en,
        "Liju Fan"@en,
        "Luisa Montecchi"@en,
        "Matthew Brush"@en,
        "Matthew Pocock"@en,
        "Melanie Courtot"@en,
        "Melissa Haendel"@en,
        "Mervi Heiskanen"@en,
        "Monnie McGee"@en,
        "Norman Morrison"@en,
        "Philip Lord"@en,
        "Philippe Rocca-Serra"@en,
        "Pierre Grenon"@en,
        "Richard Bruskiewich"@en,
        "Richard Scheuermann"@en,
        "Robert Stevens"@en,
        "Ryan R. Brinkman"@en,
        "Stefan Wiemann"@en,
        "Susanna-Assunta Sansone"@en,
        "Tanya Gray"@en,
        "Tina Hernandez-Boussard"@en,
        "Trish Whetzel"@en,
        "Yongqun He"@en ;
    dc:date "2009-07-31"^^xsd:date ;
    dc:description "The Ontology for Biomedical Investigations (OBI) is build in a collaborative, international effort and will serve as a resource for annotating biomedical investigations, including the study design, protocols and instrumentation used, the data generated and the types of analysis performed on the data. This ontology arose from the Functional Genomics Investigation Ontology (FuGO) and will contain both terms that are common to all biomedical investigations, including functional genomics investigations and those that are more domain specific."@en ;
    dc:format "OWL-DL"@en ;
    dc:subject "An ontology for the annotation of biomedical and functional genomics experiments."@en ;
    dcterms:license "http://creativecommons.org/licenses/by/4.0/" ;
    rdfs:comment "Please cite the OBI consortium http://purl.obolibrary.org/obo/obi where traditional citation is called for. However it is adequate that individual terms be attributed simply by use of the identifying PURL for the term, in projects that refer to them."^^xsd:string ;
    owl:versionIRI <http://purl.obolibrary.org/obo/obi/2019-08-06/obi.owl> ;
    owl:versionInfo "2019-08-06"^^xsd:string .

ns1:BFO_0000140 a owl:Class ;
    rdfs:label "continuant fiat boundary"@en ;
    ns1:BFO_0000179 "cf-boundary" ;
    ns1:BFO_0000180 "ContinuantFiatBoundary" ;
    ns1:IAO_0000115 "b is a continuant fiat boundary = Def. b is an immaterial entity that is of zero, one or two dimensions and does not include a spatial region as part. (axiom label in BFO2 Reference: [029-001])"@en ;
    ns1:IAO_0000116 "BFO 2 Reference: In BFO 1.1 the assumption was made that the external surface of a material entity such as a cell could be treated as if it were a boundary in the mathematical sense. The new document propounds the view that when we talk about external surfaces of material objects in this way then we are talking about something fiat. To be dealt with in a future version: fiat boundaries at different levels of granularity.More generally, the focus in discussion of boundaries in BFO 2.0 is now on fiat boundaries, which means: boundaries for which there is no assumption that they coincide with physical discontinuities. The ontology of boundaries becomes more closely allied with the ontology of regions."@en,
        "BFO 2 Reference: a continuant fiat boundary is a boundary of some material entity (for example: the plane separating the Northern and Southern hemispheres; the North Pole), or it is a boundary of some immaterial entity (for example of some portion of airspace). Three basic kinds of continuant fiat boundary can be distinguished (together with various combination kinds [29"@en,
        "Continuant fiat boundary doesn't have a closure axiom because the subclasses don't necessarily exhaust all possibilites. An example would be the mereological sum of two-dimensional continuant fiat boundary and a one dimensional continuant fiat boundary that doesn't overlap it. The situation is analogous to temporal and spatial regions."@en ;
    ns1:IAO_0000601 "Every continuant fiat boundary is located at some spatial region at every time at which it exists"@en ;
    ns1:IAO_0000602 "(iff (ContinuantFiatBoundary a) (and (ImmaterialEntity a) (exists (b) (and (or (ZeroDimensionalSpatialRegion b) (OneDimensionalSpatialRegion b) (TwoDimensionalSpatialRegion b)) (forall (t) (locatedInAt a b t)))) (not (exists (c t) (and (SpatialRegion c) (continuantPartOfAt c a t)))))) // axiom label in BFO2 CLIF: [029-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000141 .

ns1:IAO_0000101 a owl:Class ;
    rdfs:label "image"@en ;
    ns1:IAO_0000111 "image"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An image is an affine projection to a two dimensional surface, of measurements of some quality of an entity or entities repeated at regular intervals across a spatial range, where the measurements are represented as color and luminosity on the projected on surface."@en ;
    ns1:IAO_0000117 "person:Alan Ruttenberg"@en,
        "person:Allyson"@en,
        "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000030"@en,
        "group:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000308 .

ns1:IAO_0000102 a owl:Class ;
    rdfs:label "data about an ontology part"@en ;
    ns1:IAO_0000115 "data about an ontology part is a data item about a part of an ontology, for example a term"@en ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000027 .

