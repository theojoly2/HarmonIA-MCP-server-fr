ns1:OBI_0002444 a owl:Class ;
    rdfs:label "measurand role"@en ;
    ns1:IAO_0000111 "measurand role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A role borne by a material entity and realized in an assay which achieves the objective to measure the magnitude/concentration/amount of the measurand in the entity bearing evaluant role." ;
    ns1:IAO_0000117 "Person: Alan Ruttenberg, Jie Zheng" ;
    ns1:IAO_0000119 "https://en.wiktionary.org/wiki/measurand" ;
    ns1:IAO_0000233 "https://github.com/obi-ontology/obi/issues/778" ;
