    ns1:IAO_0000111 "date process started"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data item that is the date when a process was initiated."@en ;
    ns1:IAO_0000117 "Chris Stoeckert, Daniel Berrios, Stephen A. Fisher"@en ;
    rdfs:subClassOf ns1:IAO_0000027 .

ns1:OBI_0002472 a owl:Class ;
