ns1:OBI_0002445 a owl:Class ;
    rdfs:label "transcription start site mapping by primer extension assay" ;
    ns1:IAO_0000111 "transcription start site mapping by primer extension assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A transcription profiling assay in which the transcription start site for a gene is determined by identifying the 5' end of mRNA. A radio-labeled primer is annealed to a complementary mRNA sequence near the 3' end, then cDNA is synthesized until the 5' end is reached."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "PMID:23378648"^^xsd:string,
        "url:https://en.wikipedia.org/wiki/Primer_extension"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0010467 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0001851 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000973 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000880 ],
        ns1:OBI_0000424 .

ns1:OBI_0002446 a owl:Class ;
    rdfs:label "proteomic profiling design" ;
    ns1:IAO_0000111 "proteomic profiling design" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design in which proteins in a sample are detected, quantified or otherwise analysed."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "OBI:0001441"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500000 .

ns1:OBI_0002447 a owl:Class ;
    rdfs:label "suppression subtractive hybridization" ;
    ns1:IAO_0000111 "suppression subtractive hybridization" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An artificially induced nucleic acid hybridization that is performed to compare gene expression in different cell or tissue types based on normalization and suppression, which creates a subtracted cDNA or genomic DNA library."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "SSH"^^xsd:string,
        "subtractive hybridization"^^xsd:string ;
    ns1:IAO_0000119 "PMID:14970460"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000253 .

ns1:OBI_0002448 a owl:Class ;
    rdfs:label "differential screening hybridization" ;
    ns1:IAO_0000111 "differential screening hybridization" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An artificially induced nucleic acid hybridization that is performed to identify differentially expressed genes through hybridization of cDNA probes."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "DSH"^^xsd:string,
        "differential screening"^^xsd:string ;
    ns1:IAO_0000119 "PMID:25472628"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000253 .

ns1:OBI_0002450 a owl:Class ;
    rdfs:label "hydroxyl-radical footprinting assay measuring binding of a B cell epitope:antibody complex" ;
    ns1:IAO_0000111 "hydroxyl-radical footprinting assay measuring binding of a B cell epitope:antibody complex" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A footprinting assay that uses hydroxyl-radical footprinting to measure B cell epitope qualitative binding to antibody."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, James Overton, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "hydroxyl-radical footprinting assay"^^xsd:string,
        "qualitative binding"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002449 ;
