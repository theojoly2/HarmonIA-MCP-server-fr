ns1:IAO_0000609 a owl:Class ;
    rdfs:label "author summary section"@en ;
    ns1:IAO_0000111 "author summary section"@en ;
    ns1:IAO_0000112 "The section labelled 'synopsis' in a typical scientific journal article, e.g. in Pendse et al. BMC Genomics. 2013; 14: 136. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3608171/)"@en ;
    ns1:IAO_0000115 "A part of a document, distinct from the abstract, that describes the significance and broader context of the document content. The author summary is often written in a non-technical manner and is aimed at both scientists and non-scientist readers."@en ;
    ns1:IAO_0000117 "PERSON: Bill Baumgartner"@en ;
    ns1:IAO_0000118 "author summary"@en,
        "summary"@en,
        "synopsis"@en ;
    ns1:IAO_0000119 "Article submission guidelines for PLoS Genetics (http://journals.plos.org/plosgenetics/s/submission-guidelines)"@en ;
    ns1:IAO_0000233 <https://github.com/information-artifact-ontology/IAO/issues/183> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:IAO_0000610 ],
        ns1:IAO_0000314 .

ns1:IAO_0000611 a owl:Class ;
    rdfs:label "availability section"@en ;
    ns1:IAO_0000111 "availability section"@en ;
    ns1:IAO_0000112 "The section labelled 'availability and requirements' in a typical scientific journal article, e.g. Qi et al. BMC Bioinformatics. 2014; 15: 11. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3897912/)."@en ;
    ns1:IAO_0000115 "A part of a document about a resource described in the document, e.g. software, that describes where and/or how that resource can be obtained."@en ;
