    rdfs:label "microarray"@en ;
    ns1:IAO_0000111 "microarray"@en ;
    ns1:IAO_0000112 "An affymetrix U133 array is a microarray. Microarrays include 1 and 2-color arrays, custom and commercial arrays (e.g, Affymetrix, Agilent, Nimblegen, Illumina, etc.) for expression profiling, DNA variant detection, protein binding, and other genomic and functional genomic assays."^^xsd:string ;
