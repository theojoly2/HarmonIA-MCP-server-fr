ns1:OBI_0000257 a owl:Class ;
    rdfs:label "DNA extraction"@en ;
    ns1:IAO_0000111 "DNA extraction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A DNA extraction is a nucleic acid extraction where the desired output material is DNA."@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
