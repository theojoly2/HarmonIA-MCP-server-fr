ns1:OBI_0000854 a owl:Class ;
    rdfs:label "western blot analysis" ;
    ns1:IAO_0000111 "western blot analysis" ;
    ns1:IAO_0000112 "Running a cell lysate on an acrylamide gel in a western blot aparatus to separate the constituent proteins, followed by transfer of the proteins from the gel to a nitrocellulose membrane. Staining this membrane with specific antibodies to detect the presence of specific proteins of interest."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An analyte assay that detects specific peptides in an input material by separating it using gel electrophoresis, transfering the separated molecules to a membrane, and staining them with_ antibodies specific to the analyte molecules."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
