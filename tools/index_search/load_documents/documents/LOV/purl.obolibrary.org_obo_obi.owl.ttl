ns1:OBI_0000904 a owl:Class ;
    rdfs:label "reporter cell line analyte detection bioassay" ;
    ns1:IAO_0000111 "reporter cell line analyte detection bioassay" ;
    ns1:IAO_0000112 "CTLL-2 cells were grown in the presence of hybridoma supernatants and their growth was monitored by a 3H-thymidine incorporation cell proliferation assay in order to detect IL-2 in the hybridoma supernatant."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An analyte assay in which a cell line whose growth is known to be affected by the presence of a specific type of material (the anlyte) is cultured in the presence of an input material (the evaluant) in order to detect presence of the analyte in the evaluant."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000086 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:CLO_0000031 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:CLO_0000031 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0600024 ],
        ns1:OBI_0000443 .

ns1:OBI_0001144 a owl:Class ;
    rdfs:label "binding constant"@en ;
    ns1:IAO_0000111 "binding constant"@en ;
    ns1:IAO_0000112 "The predicted or measured binding affinity of a peptide to a MHC molecule can be captured in the binding constants \"IC50 = 12 nM\" or \"t 1/2 = 30 minutes\". "@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A binding datum about the disposition of two or more material entities to form complexes which comes in the form of a scalar and unit that are utilized in equations that model the binding process"@en ;
    ns1:IAO_0000116 "10/6/11 BP: The distinction between binding datum and binding constant is based on the later being part of an equation. That should be captured in the logical definition here, and used to make it to a defined class. "^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita, Jason Greenbaum"@en ;
    rdfs:subClassOf ns1:OBI_0001181 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ns1:OBI_0001536 ns1:OBI_0001548 ns1:OBI_0001571 ns1:OBI_0001581 ns1:OBI_0001583 ns1:OBI_0001603 ns1:OBI_0001605 ) ] .

ns1:OBI_0001155 a owl:Class ;
    rdfs:label "3D structural organization datum"^^xsd:string ;
    ns1:IAO_0000111 "3D structural organization datum"^^xsd:string ;
    ns1:IAO_0000112 "The atom coordinates found in a PDB (Protein Data Bank) file, generated by X Ray crystallography or NMR. "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A measurement datum that describes the structural orientation of a material entity in 3D space. "^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Jason Greenbaum, Randi Vita, Bjoern Peters"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000109 .

