ns1:OBI_0001981 a owl:Class ;
    rdfs:label "disease exacerbation in vivo intervention experiment" ;
    ns1:IAO_0000111 "disease exacerbation in vivo intervention experiment" ;
    ns1:IAO_0000112 "Injecting a set of mice with a peptide and measuring symtoms to determine if their disease course was more severe than the disease course of a set of mice that were not injected with the same peptide."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An in vivo intervention experiment that tests the ability of the intervention to increase the severity of a disease in the host."^^xsd:string ;
    ns1:IAO_0000116 "Should have data about disease severity as readout; could just use disease for now"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001980 .

ns1:OBI_0001983 a owl:Class ;
    rdfs:label "tolerance induction intervention experiment" ;
    ns1:IAO_0000111 "tolerance induction intervention experiment" ;
    ns1:IAO_0000112 "Injecting a set of mice with a Der p 2 peptide and measuring the IL-2 response of T cells from those mice when exposed to the Der p 2 protein in vitro to determine if those T cells made less IL-2 than cells taken from mice which were not injected with the same Der p 2 peptide."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An in vivo intervention experiment that tests the ability of the intervention to decrease an immune response."^^xsd:string ;
    ns1:IAO_0000116 "should have tolerance induction as intervention"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001980 .

ns1:OBI_0001984 a owl:Class ;
    rdfs:label "treatment intervention experiment" ;
    ns1:IAO_0000111 "treatment intervention experiment" ;
    ns1:IAO_0000112 "Testing if administering oral histamine-blockers will reduce the number of emergency room visits in severely asthmatic individuals."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An in vivo intervention experiment in which the ability of the intervention to reduce or cure the effects of a disease are tested."^^xsd:string ;
    ns1:IAO_0000116 "should have treatment as intervention"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001980 .

