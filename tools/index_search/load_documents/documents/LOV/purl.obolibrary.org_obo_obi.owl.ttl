                                owl:someValuesFrom ns1:OBI_0000444 ] ) ] ],
        ns1:OBI_0600043 .

ns1:OBI_0001174 a owl:Class ;
    rdfs:label "passive immunization"^^xsd:string ;
    ns1:IAO_0000111 "passive immunization"^^xsd:string ;
    ns1:IAO_0000112 "Giving VIG (concentrated antibodies from vaccinated donors) to a patient that is infected with smallpox. \\nTransferring epitope specific T cells from one mouse into another."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "The injection of immune effector material (antibodies, T cells or B cells) into an organism so that the organisms immune system gains its  immune effector function to recognize specific antigens."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita, Jason Greenbaum"^^xsd:string ;
    ns1:IAO_0000118 "adoptive transfer"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000319 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000052 ;
                                owl:someValuesFrom ns1:OBI_1110022 ] ) ] ],
        ns1:OBI_0600007 .

ns1:OBI_0001180 a owl:Class ;
    rdfs:label "half maximal effective concentration (EC50)"^^xsd:string ;
    ns1:IAO_0000111 "half maximal effective concentration (EC50)"^^xsd:string ;
    ns1:IAO_0000112 "Determining the potentency of a drug / antibody / toxicant by measuring a graded dose response curve, and determining the concentration of the compound where 50% of its maximal effect is observed. "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "half maximal effective concentration (EC50) is a scalar measurement datum corresponding to the concentration of a compound which induces a response halfway between the baseline and maximum after some specified exposure time. \\n"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters; Randi Vita"^^xsd:string ;
    ns1:IAO_0000119 "wikipedia"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:OBI_0001172 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000039 ;
            owl:someValuesFrom ns1:UO_0000051 ],
        ns1:IAO_0000032 .

ns1:OBI_0001191 a owl:Class ;
    rdfs:label "half maximal inhibitory concentration (IC50)"^^xsd:string ;
    ns1:IAO_0000111 "half maximal inhibitory concentration (IC50)"^^xsd:string ;
    ns1:IAO_0000112 "Interpolating that at a dose of IC50=12 nM, half of the binding of a comptetitive ligand is inhibited."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Half maximal inhibitory concentration (IC50) is a scalar measurement datum that measures the effectiveness of a compound to competitively inhibit a given process, and corresponds to the concentration of the compound at which it reaches half of its maximum inhibitory effect."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters; Randi Vita"^^xsd:string ;
    ns1:IAO_0000119 "wikipedia"^^xsd:string ;
