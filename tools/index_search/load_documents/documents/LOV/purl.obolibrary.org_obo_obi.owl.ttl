ns1:OBI_0001045 a owl:Class ;
    rdfs:label "capillary blotter"^^xsd:string ;
    ns1:IAO_0000111 "capillary blotter"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A device that is used to transfer nucleic acids from agarose gels onto a membrane, based on the movement of buffer from a reservoir through the gel and the blotting membrane to a stack of dry blotting paper by capillary force. The molecules are carried to the blotting membrane on which they are adsorbed."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Erik Segerdell"^^xsd:string ;
    ns1:IAO_0000119 "http://www.biometra.de/"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
