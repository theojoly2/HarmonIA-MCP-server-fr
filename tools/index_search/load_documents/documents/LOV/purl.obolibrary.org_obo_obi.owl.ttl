ns1:OBI_0000989 a owl:Class ;
    rdfs:label "PCR instrument"^^xsd:string ;
    ns1:IAO_0000111 "PCR instrument"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A device that is used to amplify a single or few copies of a piece of DNA across several orders of magnitude, generating thousands to millions of copies of a particular DNA sequence."^^xsd:string ;
    ns1:IAO_0000116 "03/21/2010: Added because it is unclear if the thermal cycler definition is intentionally broader than PCR instrument. Contacted Melanie and Trish about this. Definitions and use of alternative terms need to be made consistent."^^xsd:string ;
