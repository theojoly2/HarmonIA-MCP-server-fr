ns1:OBI_0000478 a owl:Class ;
    rdfs:label "column connector"@en ;
    ns1:IAO_0000111 "column connector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A device that connects two or more columns together in a functional way with leak-tight connection, low dead volume, low thermal mass and high inertness."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01236"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000479 a owl:Class ;
    rdfs:label "solid NMR probe"@en ;
    ns1:IAO_0000111 "solid NMR probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR probe that is designed to hold a solid sample."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400243"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR device"@en ;
    rdfs:subClassOf ns1:OBI_0000516 .

ns1:OBI_0000481 a owl:Class ;
    rdfs:label "chromatography detector"@en ;
    ns1:IAO_0000111 "chromatography detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A chromatography detector is a device that locates in the dimensions of space and time, the positions of the components of a mixture that has been subjected to a chromatographic process and thus permits the senses to appreciate the nature of the separation.  Defining characteristics are Dynamic Range, Response Index or Linearity, Linear Dynamic range, Detector Response,  Detector Noise Level, Detector Sensitivity or Minimum Detectable Concentration, Total System Dispersion, Sensor Dimensions, Detector Time Constant, Pressure Sensitivity, Flow Sensitivity, Operating Temperature Range."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01012"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/GC-Detectors/Classification/rs1.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000485 .

ns1:OBI_0000484 a owl:Class ;
    rdfs:label "NMR sample holder"@en ;
    ns1:IAO_0000111 "NMR sample holder"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR sample holder is the part of an NMR instrument, which carries the NMR probe,sample tube and the nmr sample."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400212"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR device"@en ;
    rdfs:subClassOf ns1:OBI_0000968 .

ns1:OBI_0000498 a owl:Class ;
    rdfs:label "NMR tube washing system"@en ;
    ns1:IAO_0000111 "NMR tube washing system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An automatic cleaning system for NMR tubes that removes previous probe and sample residues in order to allow for tube recycling."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400204"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000968 .

ns1:OBI_0000499 a owl:Class ;
    rdfs:label "NMR console"@en ;
    ns1:IAO_0000111 "NMR console"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A component of an NMR instrument that controls the activities of the other components."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400015"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument, TODO: same as or part of acquisition computer?"@en ;
    rdfs:subClassOf ns1:OBI_0000968 .

ns1:OBI_0000517 a owl:Class ;
    rdfs:label "NMR magnet"@en ;
    ns1:IAO_0000111 "NMR magnet"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A magnet which induces a certain frequency (MHz) and which has a certain bore diameter.\\\\n  alt The NMR signal is a natural physical property of the certain atomic nuclei but it can only be detected with an external magnetic field. A magnet is a fundamental part of an NMR instrument which induces an electromagnetic force field (RF pulse) and by this excites and aligns the spins of the electrons of the NMR acquisition nucleus. It is usually a big (superconducting) electromagnet which is cooled by liquid helium and can be adjusted to a frequency between 200 and 950 MHz. The magnetic field strength is measured in Tesla or Gauss."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400185"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000968 .

ns1:OBI_0000529 a owl:Class ;
    rdfs:label "JEOL NMR probe"@en ;
    ns1:IAO_0000111 "JEOL NMR probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR probe that is manufactured by JEOL."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400232"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR device"@en ;
    rdfs:subClassOf ns1:OBI_0000516 .

ns1:OBI_0000540 a owl:Class ;
    rdfs:label "isolation of adherent cells"^^xsd:string ;
    ns1:IAO_0000111 "isolation of adherent cells"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a material separation process in which cells that stick to the container in which they are grown as a cell culture are separated from those in the liquid component of the culture. The output of this process are adherent cells."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        ns1:OBI_0000512 .

ns1:OBI_0000548 a owl:Class ;
    rdfs:label "isolation of PBMCs"^^xsd:string ;
    ns1:IAO_0000111 "isolation of PBMCs"^^xsd:string ;
    ns1:IAO_0000112 "cells are extracted from whole blood using ficoll, a hydrophilic polysaccharide that separates layers of blood, with monocytes and lymphocytes forming a buffy coat under a layer of plasma. This buffy coat contains the PBMCs."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process in which cells with a single nucleus are isolated from a blood sample"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: bjoern peters"^^xsd:string ;
    ns1:IAO_0000119 "wiki http://en.wikipedia.org/wiki/PBMC"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:UBERON_0000178 ],
        ns1:OBI_0000512 .

ns1:OBI_0000555 a owl:Class ;
    rdfs:label "autosampler"@en ;
    ns1:IAO_0000111 "autosampler"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An optional part of an NMR instrument used to hold samples prior to NMR analysis and that sequentially loads these samples into the analytical part of the NMR instrument. \\\\n   alt The autosampler is an automatic sample changer device."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400002"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000968 .

ns1:OBI_0000618 a owl:Class ;
    rdfs:label "size exclusion column"@en ;
    ns1:IAO_0000111 "size exclusion column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A size exclusion column is a chromatography column as used in size exclusion chromatography and which enables the separation of mixtures according to differrences in molecular size."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01100"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000646 a owl:ObjectProperty ;
    rdfs:label "supplies"^^xsd:string ;
    ns1:IAO_0000111 "supplies"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A relation between an organisation or person and a material entity who owned or has license to the material entity and there was a legal transfer of ownership or licensing of the material entity to the current owner."^^xsd:string ;
    ns1:IAO_0000117 "GROUP: Relations branch"^^xsd:string ;
    owl:inverseOf ns1:OBI_0000647 .

ns1:OBI_0000649 a owl:Class ;
    rdfs:label "data set of features"@en ;
    ns1:IAO_0000111 "data set of features"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A data set that is produced as the output of a descriptive statistical calculation data transformation and consists of producing a data set that represents one or more features of interest about the input data set."@en ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Monnie McGee"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000100 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0200184 ] .

ns1:OBI_0000656 a owl:Class ;
    rdfs:label "data set of predicted values according to fitted curve"@en ;
    ns1:IAO_0000111 "data set of predicted values according to fitted curve"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A data set which is the output of a curve fitting data transformation in which the aim is to find a curve which matches a series of data points and possibly other constraints."@en ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Monnie McGee"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000100 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0200072 ] .

ns1:OBI_0000664 a owl:Class ;
    rdfs:label "BrdU incorporation assay" ;
    ns1:IAO_0000111 "BrdU incorporation assay" ;
    ns1:IAO_0000112 "The measurement of T cell proliferation as a response to a viral peptide by culturing T cells stimulated with APCs and peptide in the presence of BrdU."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cell proliferation assay in which cells are cultured in the presence of BrdU which is incorporated into newly synthesized DNA of replicating cells (during the S phase of the cell cycle), substituting for thymidine during DNA replication, which can be quantified by BrdU specific antibodies."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:REO_0000171 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:CHEBI_472552 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:CHEBI_472552 ] ) ],
        ns1:OBI_0000891 .

ns1:OBI_0000666 a owl:Class ;
    rdfs:label "background correction data transformation"@en ;
    ns1:IAO_0000111 "background correction data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A background correction data transformation (sometimes called supervised classification) is a data transformation that has the objective background correction."@en ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000660 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200173 ] ) ] .

ns1:OBI_0000669 a owl:Class ;
    rdfs:label "tritiated thymidine incorporation assay" ;
    ns1:IAO_0000111 "tritiated thymidine incorporation assay" ;
    ns1:IAO_0000112 "The measurement of T cell proliferation as a response to a viral peptide by culturing T cells stimulated with APCs and peptide in the presence of tritiated thymidine, and using a scintillation counter to detect the radioactivity."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cell proliferation assay in which cells are cultured in the presence of tritiated thymidine which is incorporated into newly synthesized DNA of replicating cells (during the S phase of the cell cycle). The radioactivity of tritiated thymidine in a cell is a proxy for cells that were actively replicating."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:REO_0000171 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:CHEBI_53526 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:CHEBI_53526 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000201 ],
        ns1:OBI_0000891 .

ns1:OBI_0000671 a owl:Class ;
    rdfs:label "sample from organism"^^xsd:string ;
    ns1:IAO_0000111 "sample from organism"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000002 ;
    ns1:IAO_0000115 "a material obtained from an organism in order to be a representative of the whole"^^xsd:string ;
    ns1:IAO_0000116 "5/29: This is a helper class for now"^^xsd:string,
        "we need to work on this: Is taking a urine sample a material separation process? If not, we will need to specify what 'taking a sample from organism' entails. We can argue that the objective to obtain a urine sample from a patient is enough to call it a material separation process, but it could dilute what material separation was supposed to be about."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:UBERON_0000465 ],
        ns1:OBI_0000747,
        ns1:OBI_0001479 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom ns1:OBI_0600005 ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:OBI_0000740 ] ) ] .

ns1:OBI_0000676 a owl:Class ;
    rdfs:label "reduced dimension data set"@en ;
    ns1:IAO_0000111 "reduced dimension data set"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A data set that is produced as the output of a data vector reduction data transformation and consists of producing a data set which has fewer vectors than the input data set."@en ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Monnie McGee"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000100 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0200182 ] .

ns1:OBI_0000680 a owl:Class ;
    rdfs:label "whole organism preparation"^^xsd:string ;
    ns1:IAO_0000111 "whole organism preparation"^^xsd:string ;
    ns1:IAO_0000112 "putting a mouse in the blender. Not: putting a mouse on a scale"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A material entity which is the output of a process in which one or more whole organisms are prepared in a way to make it easier to study them, and in which the great majority of organismal parts are maintained"^^xsd:string ;
    ns1:IAO_0000116 "does this include injecting a dye to a patient to be able to visualize parts of his brain? If not, we should state that the components of the organism are substantially re-arranged."^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:OBI_0000112 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0000659 ],
        ns1:OBI_0100051 .

ns1:OBI_0000688 a owl:Class ;
    rdfs:label "rodent care protocol"^^xsd:string ;
    ns1:IAO_0000111 "rodent care protocol"^^xsd:string ;
    ns1:IAO_0000112 "Keeping mice in the UCSD animals facility at 20 - 25 degrees celsius, in cages of 4 animals each and providing food twice daily."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A rodent care protocol is an animal protocol in which the animals being taken care of are rodents."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "Bjoern Peters"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000715 .

ns1:OBI_0000694 a owl:Class ;
    rdfs:label "animal feeding"^^xsd:string ;
    ns1:IAO_0000111 "animal feeding"^^xsd:string ;
    ns1:IAO_0000112 "giving crickets to a snake."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "animal feeding is a process in which animals are provided with food"^^xsd:string ;
    ns1:IAO_0000116 "In an investigation, this will typically be part of an animal care process"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "branch derived"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom ns1:OBI_0000248 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        ns1:OBI_0000011 .

ns1:OBI_0000700 a owl:Class ;
    rdfs:label "support vector machine"^^xsd:string ;
    ns1:IAO_0000111 "support vector machine"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A support vector machine is a data transformation with a class prediction objective based on the construction of a separating hyperplane that maximizes the margin between two data sets of vectors in n-dimensional space."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string,
        "Ryan Brinkman"^^xsd:string ;
    ns1:IAO_0000118 "SVM"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Ryan Brinkman"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200179 ],
        ns1:OBI_0000663 .

ns1:OBI_0000705 a owl:Class ;
    rdfs:label "Edman degradation" ;
    ns1:IAO_0000111 "Edman degradation" ;
    ns1:IAO_0000112 "Determination of the amino acid sequence of a peptide eluted from HLA-DRB1*04:01 to be VYPEVTVYPAKT."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A sequencing assay in which the amino acid sequence of input peptides or proteins is determined by iteratively cleaving of the amino-terminal (N-terminal) residue without disrupting the peptide bonds and identifying it by e.g. chromatography or electropheresis."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:REO_0000171 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:BFO_0000040 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:BFO_0000040 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:SO_0000104 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        ns1:OBI_0600047 .

ns1:OBI_0000708 a owl:Class ;
    rdfs:label "laboratory animal care"^^xsd:string ;
    ns1:IAO_0000111 "laboratory animal care"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a process that realizes an animal care protocol that specifies how animals are kept and maintained"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
