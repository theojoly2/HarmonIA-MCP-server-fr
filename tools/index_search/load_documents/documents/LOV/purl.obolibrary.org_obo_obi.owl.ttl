ns1:OBI_0500001 a owl:Class ;
    rdfs:label "clinical study design"@en ;
    ns1:IAO_0000111 "clinical study design"@en ;
    ns1:IAO_0000112 "PMID: 17655677.J Cardiovasc Electrophysiol. 2007 Aug;18(9):965-71.Biventricular versus right ventricular pacing in patients with AV block (BLOCK HF): clinical study design and rationale."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Plan for the precise procedure to be followed in a clinical trial, including planned and actual timing of events, choice of control group, method of allocating treatments, blinding methods; assigns a subject to pass through one or more epochs in the course of a trial. Specific design elements, e.g., crossover, parallel; dose-escalation [Modified from Pocock, Clinical Trials: A Practical Approach]"@en ;
    ns1:IAO_0000116 "The definition needs to be extended to other things than simply patients"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "Clinical Research Glossary Version 4.0 CDICS glossary group"@en ;
    rdfs:subClassOf ns1:OBI_0500000 .

ns1:OBI_0500002 a owl:Class ;
    rdfs:label "repeated measure design"@en ;
    ns1:IAO_0000111 "repeated measure design"@en ;
    ns1:IAO_0000112 "PMID: 10959922.J Biopharm Stat. 2000 Aug;10(3):433-45.Equivalence in test assay method comparisons for the repeated-measure, matched-pair design in medical device studies: statistical considerations."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a study design which use the same individuals and exposure them to a set of conditions. The effect of order and practice can be confounding factor in such designs"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "http://www.holah.karoo.net/experimentaldesigns.htm"@en ;
    rdfs:subClassOf ns1:OBI_0000115 .

ns1:OBI_0500003 a owl:Class ;
    rdfs:label "cross over design"@en ;
    ns1:IAO_0000111 "cross over design"@en ;
    ns1:IAO_0000112 "PMID: 17601993-Objective: HIV-infected patients with lipodystrophy (HIV-lipodystrophy) are insulin resistant and have elevated plasma free fatty acid (FFA) concentrations. We aimed to explore the mechanisms underlying FFA-induced insulin resistance in patients with HIV-lipodystrophy. Research Design and Methods: Using a randomized placebo-controlled cross-over design, we studied the effects of an overnight acipimox-induced suppression of FFA on glucose and FFA metabolism by using stable isotope labelled tracer techniques during basal conditions and a two-stage euglycemic, hyperinsulinemic clamp (20 mU insulin/m(2)/min; 50 mU insulin/m(2)/min) in nine patients with nondiabetic HIV-lipodystrophy. All patients received antiretroviral therapy. Biopsies from the vastus lateralis muscle were obtained during each stage of the clamp. Results: Acipimox treatment reduced basal FFA rate of appearance by 68.9% (52.6%-79.5%) and decreased plasma FFA concentration by 51.6 % (42.0%-58.9%), (both, P < 0.0001). Endogenous glucose production was not influenced by acipimox. During the clamp the increase in glucose-uptake was significantly greater after acipimox treatment compared to placebo (acipimox: 26.85 (18.09-39.86) vs placebo: 20.30 (13.67-30.13) mumol/kg/min; P < 0.01). Insulin increased phosphorylation of Akt (Thr(308)) and GSK-3beta (Ser(9)), decreased phosphorylation of glycogen synthase (GS) site 3a+b and increased GS-activity (I-form) in skeletal muscle (P < 0.01). Acipimox decreased phosphorylation of GS (site 3a+b) (P < 0.02) and increased GS-activity (P < 0.01) in muscle. Conclusion: The present study provides direct evidence that suppression of lipolysis in patients with HIV-lipodystrophy improves insulin-stimulated peripheral glucose-uptake. The increased glucose-uptake may in part be explained by increased dephosphorylation of GS (site 3a+b) resulting in increased GS activity."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a repeated measure design which ensures that experimental units receive, in sequence, the treatment (or the control), and then, after a specified time interval (aka *wash-out periods*), switch to the control (or treatment). In this design, subjects (patients in human context) serve as their own controls, and randomization may be used to determine the ordering which a subject receives the treatment and control"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "(source: http://www.sbu.se/Filer/Content0/publikationer/1/literaturesearching_1993/glossary.html)"@en ;
    rdfs:subClassOf ns1:OBI_0500002 .

ns1:OBI_0500023 a owl:Class ;
    rdfs:label "compliance rule"@en ;
    ns1:IAO_0000111 "compliance rule"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a compliance rule is a rule which ensures a compliance process occurs"@en ;
    ns1:IAO_0000117 "PRS"@en ;
    ns1:IAO_0000119 "PRS"@en ;
    rdfs:subClassOf ns1:IAO_0000055 .

ns1:OBI_0500024 a owl:Class ;
    rdfs:label "standard compliance rule"@en ;
    ns1:IAO_0000111 "standard compliance rule"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a  standard compliance rule is a compliance rule which defines conformity to a representation standard"@en ;
    ns1:IAO_0000117 "PRS"@en ;
    ns1:IAO_0000119 "PRS"@en ;
    rdfs:subClassOf ns1:OBI_0500023 .

ns1:OBI_0600000 a owl:Class ;
    rdfs:label "adding substance to cell culture"@en ;
    ns1:IAO_0000111 "adding substance to cell culture"@en ;
    ns1:IAO_0000112 "adding fetal calf serum to a 96 well plate containing a cell culture derived from a blood sample of a patient"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "is process in which a material substance is added to a cell culture"@en ;
    ns1:IAO_0000116 "renamed from 'administering substance to cell culture', to reflect that administration is commonly used only for organisms"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000434 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        ns1:OBI_0000274 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom ns1:OBI_0000319 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000444 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:OBI_0100060 ] ) ] ] ) ] .

ns1:OBI_0600010 a owl:Class ;
    rdfs:label "material acquisition"@en ;
    ns1:IAO_0000111 "material acquisition"@en ;
    ns1:IAO_0000112 "Acquiring 50 C57BL/6 mice bred in the animal facility of the institute as a service to investigators. Purchasing 1 mg of peptides synthesized by Mimotopes at 80% purity. Getting a gift of purified CD4+ specific antibodies presented by Stephen Schoenberger at LIAI."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An acquisition in which possession of a material entity is gained."@en ;
    ns1:IAO_0000116 "The assumption is that the object already exists in its current state, e.g, an available mouse strain purchased from the Jackson Lab, this is the differentia from specimen creation"^^xsd:string,
        "This excludes processes that create or change materials, such as material transformations." ;
    ns1:IAO_0000117 "Bjoern Peters, Alan Ruttenberg, Helen Parkinson"@en ;
    ns1:IAO_0000118 "material procurement"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        ns1:OBI_0600008 .

ns1:OBI_0600015 a owl:Class ;
    rdfs:label "group assignment"@en ;
    ns1:IAO_0000111 "group assignment"@en ;
    ns1:IAO_0000112 "Assigning' to be treated with active ingredient role' to an organism during group assignment. The group is those organisms that have the same role in the context of an investigation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "group assignment is a process which has an organism as specified input and during which a role is assigned"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000118 "cohort assignment"^^xsd:string,
        "study assignment"^^xsd:string ;
    ns1:IAO_0000119 "OBI Plan"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000023 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000052 ;
                                owl:someValuesFrom ns1:OBI_0100026 ] ) ] ],
        ns1:OBI_0000011 .

ns1:OBI_0600020 a owl:Class ;
    rdfs:label "histological assay" ;
    ns1:IAO_0000111 "histological assay" ;
    ns1:IAO_0000112 "the counting of the number of cells with fluorescent label at their surface to determine the percentage of the population which was activated"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An assay that uses visual examination of cells or tissue (or images of them) to make an assessment regarding a quality of the cells or tissue. This assay can include steps of staining, imaging, and judgement."^^xsd:string ;
    ns1:IAO_0000117 "Adam Witney"^^xsd:string,
        "Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000118 "histology"^^xsd:string,
        "histopathology"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:unionOf ( ns1:CL_0000000 ns1:OBI_0100066 ) ] ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000341 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000185 ],
        ns1:OBI_0000070 .

ns1:OBI_0600029 a owl:Class ;
    rdfs:label "isolation of cell culture supernatant"@en ;
    ns1:IAO_0000111 "isolation of cell culture supernatant"@en ;
    ns1:IAO_0000112 "Pouring out a portion of the fluid part of an adherant cell culture growing in a flask.; The centrifugation of a T cell culture followed by aspiration of the supernatant while the cellular pellet remains in the centrifuge tube."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol which results in the separation of supernatant material from a cell culture"@en ;
    ns1:IAO_0000116 "This does not apply to the case where the cells are lysed"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        ns1:OBI_0600014 .

ns1:OBI_0600034 a owl:Class ;
    rdfs:label "precipitation"@en ;
    ns1:IAO_0000111 "precipitation"@en ;
    ns1:IAO_0000112 "The use of ethanol to precipitate DNA molecules from a solution containing DNA"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application to cause a material to precipitate (becoming a solid) out of solution. Input is a solution, output is a solution plus a solid component (the precipitate)"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        ns1:OBI_0600014 .

ns1:OBI_0600039 a owl:Class ;
    rdfs:label "artificially induced methylation"@en ;
    ns1:IAO_0000111 "artificially induced methylation"@en ;
    ns1:IAO_0000112 "the use of enzymes to add methyl groups to DNA molecules"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A planned process of adding methyl groups to polymers"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0600040 a owl:Class ;
    rdfs:label "synthesis"@en ;
    ns1:IAO_0000111 "synthesis"^^xsd:string ;
    ns1:IAO_0000112 "making cDNA from nucleotides using RNA as a template"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "the construction of a biomaterial from simpler biomaterials"@en ;
    ns1:IAO_0000116 "This probably needs breaking down into more specific applications. The example given is already covered in reverse_transcription"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000118 "synthesize"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:CHEBI_23367 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:CHEBI_23367 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0600044 a owl:Class ;
    rdfs:label "lavage"@en ;
    ns1:IAO_0000111 "lavage"@en ;
    ns1:IAO_0000112 "the collection of bronchoalveolar lavage fluid (BAL) from the lungs of mice in order to study the cytokines present"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A protocol application to separate cells and/or cellular secretions from an anatomical space by the introduction and removal of fluid"@en ;
    ns1:IAO_0000116 "This is not washing, in which case the material of interest is not the resulting fluid"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000639 ],
        ns1:OBI_0600005,
        ns1:OBI_0600014 .

ns1:OBI_0600046 a owl:Class ;
    rdfs:label "preparative chromatography"@en ;
    ns1:IAO_0000111 "preparative chromatography"@en ;
    ns1:IAO_0000112 "The use of gas chromatography in order separate out from an input sample of eggs a fraction that would be enriched for pesticides."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "the use of a biomaterial's preferential affinity for either the mobile phase or the stationary phase to separate it from other materials of differing affinity"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy; Bjoern Peters"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000318 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:OBI_0000048 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:OBI_0000038 ],
        ns1:OBI_0600014 .

ns1:OBI_0600052 a owl:Class ;
    rdfs:label "dialysis"@en ;
    ns1:IAO_0000111 "dialysis"@en ;
    ns1:IAO_0000112 "the use of a dialysis bag of select pore size to remove salt from collagen isolated from mouse cartilage"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application that uses diffusion through a semi-permeable membrane to separate an input material into two fractions of different composition"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        ns1:OBI_0600014 .

ns1:OBI_0600053 a owl:Class ;
    rdfs:label "electrophoresis"@en ;
    ns1:IAO_0000111 "electrophoresis"@en ;
    ns1:IAO_0000112 "Loading a mixture of proteins into a polyacrylamide gel and the application of an electrical current to the gel to separate the proteins by size and change."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application that uses an electrical potential to move material through a defined matrix in order to separate it by its resistance to movement and its charge"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "Need to define more terms like gel_separation, matrix,centrifugation, and the connection between the force used to separate materials and the medium or barriers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:OBI_0400142 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:OBI_0400140 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:OBI_0000432 ns1:OBI_0000439 ) ] ],
        ns1:OBI_0600014 .

ns1:OBI_1110003 a owl:Class ;
    rdfs:label "host exposure to infectious agent"@en ;
    ns1:IAO_0000111 "host exposure to infectious agent"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process in which an infectious agent comes into physical contact with a host organism."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:GO_0008150 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000057 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000925 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0002220 ;
                                            owl:someValuesFrom ns1:OBI_1110026 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000057 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_1110026 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0002220 ;
                                            owl:someValuesFrom ns1:OBI_0000925 ] ) ] ] ) ] .

ns1:OBI_1110040 a owl:Class ;
    rdfs:label "infectious disease"@en ;
    ns1:IAO_0000111 "infectious disease"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a disease caused by an infectious agent"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OGMS_0000031 .

ns1:OBI_1110049 a owl:Class ;
    rdfs:label "allergy"@en ;
    ns1:IAO_0000111 "allergy"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a disease in which an abnormally strong inflammatory immune response is triggered against non-self entities, and the immune response has no protective effect"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OGMS_0000031 .

ns1:OBI_1110050 a owl:Class ;
    rdfs:label "cultured CD4- T cell population"@en ;
    ns1:IAO_0000111 "cultured CD4- T cell population"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A T cell population characterized by not expressing the CD4 molecule on its surface."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "CD4- T cell culture sample" ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_0001875 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0001875 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000643 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:CL_0000000 [ a owl:Class ;
                                            owl:complementOf [ a owl:Restriction ;
                                                    owl:onProperty ns1:BFO_0000051 ;
                                                    owl:someValuesFrom ns1:PR_000001004 ] ] ) ] ] ) ] .

ns1:OBI_1110051 a owl:Class ;
    rdfs:label "cultured CD8- T cell population"@en ;
    ns1:IAO_0000111 "cultured CD8- T cell population"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A T cell population characterized by not expressing the CD8 molecule on its surface."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "CD8- T cell culture sample" ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_0001875 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0001875 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000643 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:CL_0000000 [ a owl:Class ;
                                            owl:complementOf [ a owl:Restriction ;
                                                    owl:onProperty ns1:BFO_0000051 ;
                                                    owl:someValuesFrom ns1:OBI_1110132 ] ] ) ] ] ) ] .

ns1:OBI_1110084 a owl:Class ;
    rdfs:label "effector T cell function"@en ;
    ns1:IAO_0000111 "effector T cell function"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The function inhering in a T cell that is realized in an immune response that results from the T cell receptor binding to the MHC:epitope complex."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:CL_0000084 ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:GO_0002250 [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_1110060 ;
                                owl:someValuesFrom ns1:OBI_1110057 ] ) ] ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:OBI_1110016 .

ns1:OBI_1110085 a owl:Class ;
    rdfs:label "antigen presentation function"@en ;
    ns1:IAO_0000111 "antigen presentation function"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a function inhering in a cell  that expresses MHC molecules which is realized in the process of antigen processing and presentation of antigen derived parts by MHC molecules on the cell surface."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "APC"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    ns1:IAO_0000232 "should add a reference to the antigen processing and presentation process."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:CL_0000000 [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000051 ;
                                owl:someValuesFrom ns1:GO_0042611 ] ) ] ],
        ns1:BFO_0000034 .

ns1:OBI_1110086 a owl:Class ;
    rdfs:label "restricting MHC role"@en ;
    ns1:IAO_0000111 "restricting MHC role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The role played by an MHC molecule by binding a material entity playing the role of epitope when that epitope/MHC molecule pair are recognized (bound) by a TCR molecule on the surface of a cell playing the role of effector cell."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_1110092 a owl:Class ;
    rdfs:label "adjuvant role"@en ;
    ns1:IAO_0000111 "adjuvant role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Adjuvant role is a role that inheres in a material entity and which is realized through a process of modifying a biological response."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "adjuvent role"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:GO_0008150 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000023 .

ns1:OBI_1110108 a owl:Class ;
    rdfs:label "material to be added"^^xsd:string ;
    ns1:IAO_0000111 "material to be added"^^xsd:string ;
    ns1:IAO_0000112 "A mixture of peptides that is being added into a cell culture."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a material that is added to another one in a material combination process"^^xsd:string ;
    ns1:IAO_0000116 "10/26/09: This defined class is used as a 'macro expression' to reduce the  size of the IEDB export"^^xsd:string,
        "2010/02/24  Alan Ruttenberg: I think this might generate confusion as the common use of the term would consider something to be a specimen during the realization of the role, not only if it bears it. However having this class as a probe, or for display, or as a macro might be useful. Ideally we would mark or segregate such classes"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:OBI_0000319 ] .

ns1:OBI_1110109 a owl:Class ;
    rdfs:label "target of material addition"^^xsd:string ;
    ns1:IAO_0000111 "target of material addition"^^xsd:string ;
    ns1:IAO_0000112 "A cell culture into which a mixture of peptides is being added."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A material entity into which another is being added in a material combinatino process"^^xsd:string ;
    ns1:IAO_0000116 "10/26/09: This defined class is used as a 'macro' to reduce the size of the IEDB export."^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:OBI_0000444 ] .

ns1:OBI_1110120 a owl:Class ;
    rdfs:label "assay antigen role"@en ;
    ns1:IAO_0000111 "assay antigen role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Any molecule recognized by the adaptive immune receptors? Recognized means bound with a certain affinity? From GO ag binding:Interacting selectively with an antigen, any substance which is capable of inducing a specific immune response and of reacting with the products of that response, the specific antibody or specifically sensitized T-lymphocytes, or both. Binding may counteract the biological activity of the antigen. see OBI_1110120 below"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000070 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000023 .

ns1:OBI_1110179 a owl:Class ;
    rdfs:label "MHC tetramer/multimer assay measuring binding of a T cell epitope:MHC:TCR complex" ;
    ns1:IAO_0000111 "MHC tetramer/multimer assay measuring binding of a T cell epitope:MHC:TCR complex" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A T cell epitope qualitative binding assay that uses an MHC multimer staining assay."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "multimer/tetramer"^^xsd:string,
        "qualitative binding"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001317 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_1110124 [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000055 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0000086 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000052 ;
                                                        owl:someValuesFrom ns1:OBI_0000788 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom ns1:OBI_0000788 ] ) ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0000916 ] ) ] .

ns1:OBI_9999994 a owl:Class ;
    rdfs:label "chromium release assay" ;
    ns1:IAO_0000111 "chromium release assay" ;
    ns1:IAO_0000112 "Autologous EBV-transformed B-LCL were used as target cells for the influenza virus-specific CTL assays. Equal volumes of target and effector cells were added to triplicate wells of 96-well tissue culture plates, and 1:2 serial dilutions of effectors were made, producing effector-to-target (E:T) ratios of 100:1, 50:1, 25:1, and 12.5:1. After a 4-h incubation of the effector cells with the target cells, supernatants were collected following brief centrifugation and transferred to polystyrene tubes to be counted with the LKB 1272 Clinigamma counter (Wallac). Percent specific killing was determined with the following equation: (experimental 51Cr release - spontaneous 51Cr release)/(maximum 51Cr release - spontaneous 51Cr release) x 100."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An in vitro cell killing assay in which radioactive chromium is absorbed by cells and released into supernatant when the cells die. The amount of radioactivity measured in the supernatant is a proxy for the number of cells that have died."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string,
        "PlanAndPlannedProcess Branch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000201 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:REO_0000171 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:CHEBI_50076 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:CHEBI_50076 ] ) ],
        ns1:OBI_0000903 .

ns1:OMIABIS_0000050 a owl:Class ;
    rdfs:label "fixed tissue specimen"@en ;
    ns1:IAO_0000111 "fixed tissue specimen"@en ;
    ns1:IAO_0000115 "A processed specimen that is the output of a fixation process."@en ;
    ns1:IAO_0000412 ns1:omiabis.owl ;
    rdfs:subClassOf ns1:OBI_0000953 .

ns1:PATO_0000011 a owl:Class ;
    rdfs:label "age"^^xsd:string ;
    ns1:IAO_0000111 "age"^^xsd:string ;
    ns1:IAO_0000115 "A time quality inhering in a bearer by virtue of how long the bearer has existed."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000165 .

ns1:PATO_0000025 a owl:Class ;
    rdfs:label "composition"^^xsd:string ;
    ns1:IAO_0000111 "composition"^^xsd:string ;
    ns1:IAO_0000115 "A single physical entity inhering in an bearer by virtue of the bearer's quantities or relative ratios of subparts."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000141 .

ns1:PATO_0000033 a owl:Class ;
    rdfs:label "concentration of"^^xsd:string ;
    ns1:IAO_0000111 "concentration of"^^xsd:string ;
    ns1:IAO_0000115 "A quality inhering in a substance by virtue of the amount of the bearer's there is mixed with another substance."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0002182 .

ns1:PATO_0000117 a owl:Class ;
    rdfs:label "size"^^xsd:string ;
    ns1:IAO_0000111 "size"^^xsd:string ;
    ns1:IAO_0000115 "A morphology quality inhering in a bearer by virtue of the bearer's physical magnitude."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000051 .

ns1:PATO_0000122 a owl:Class ;
    rdfs:label "length"^^xsd:string ;
    ns1:IAO_0000111 "length"^^xsd:string ;
    ns1:IAO_0000115 "A 1-D extent quality which is equal to the distance between two points."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:BFO_0000019 .

ns1:PATO_0000165 a owl:Class ;
    rdfs:label "time"^^xsd:string ;
    ns1:IAO_0000111 "time"^^xsd:string ;
    ns1:IAO_0000115 "A quality in which events occur in sequence."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001018 .

ns1:PATO_0000186 a owl:Class ;
    rdfs:label "behavioral quality"^^xsd:string ;
    ns1:IAO_0000111 "behavioral quality"^^xsd:string ;
    ns1:IAO_0000115 "An organismal quality inhering in a bearer by virtue of the bearer's behavior aggregate of the responses or reactions or movements in a given situation."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001995 .

ns1:PATO_0000918 a owl:Class ;
    rdfs:label "volume"^^xsd:string ;
    ns1:IAO_0000111 "volume"^^xsd:string ;
    ns1:IAO_0000115 "A 3-D extent quality inhering in a bearer by virtue of the bearer's amount of 3-dimensional space it occupies."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001710 .

ns1:PATO_0001020 a owl:Class ;
    rdfs:label "damage"^^xsd:string ;
    ns1:IAO_0000111 "damage"^^xsd:string ;
    ns1:IAO_0000115 "A structural quality inhering in a bearer by virtue of whether the bearer has been harmed or injured or spoiled."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000141 .

ns1:PATO_0001291 a owl:Class ;
    rdfs:label "electromagnetic (EM) radiation quality"^^xsd:string ;
    ns1:IAO_0000111 "electromagnetic (EM) radiation quality"^^xsd:string ;
    ns1:IAO_0000115 "A physical quality that inheres in an bearer by virtue of how that bearer interacts with electromagnetic radiation."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001739 .

ns1:PATO_0001296 a owl:Class ;
    rdfs:label "luminous flux"^^xsd:string ;
    ns1:IAO_0000111 "luminous flux"^^xsd:string ;
    ns1:IAO_0000115 "A scalar optical quality which obtains by the magnitude of the light emitted by the bearer."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001300 .

ns1:PATO_0001300 a owl:Class ;
    rdfs:label "optical quality"^^xsd:string ;
    ns1:IAO_0000111 "optical quality"^^xsd:string ;
    ns1:IAO_0000115 "An EM radiation quality in which the EM radiation is within the fiat range of the spectrum visible deemed to be light."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001291 .

ns1:PATO_0001396 a owl:Class ;
    rdfs:label "cellular quality"^^xsd:string ;
    ns1:IAO_0000111 "cellular quality"^^xsd:string ;
    ns1:IAO_0000115 "A monadic quality of continuant that exists at the cellular level of organisation."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001241 .

ns1:PATO_0001574 a owl:Class ;
    rdfs:label "flow rate"^^xsd:string ;
    ns1:IAO_0000111 "flow rate"^^xsd:string ;
    ns1:IAO_0000115 "A physical quality inhering in a bearer by virtue of the bearer's motion characteristic."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001906 .

ns1:PATO_0001710 a owl:Class ;
    rdfs:label "3-D extent"^^xsd:string ;
    ns1:IAO_0000111 "3-D extent"^^xsd:string ;
    ns1:IAO_0000115 "A size quality inhering in an bearer by virtue of the bearer's extension in three dimensions."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000117 .

ns1:PATO_0001740 a owl:Class ;
    rdfs:label "activity (of a radionuclide)"^^xsd:string ;
    ns1:IAO_0000111 "activity (of a radionuclide)"^^xsd:string ;
    ns1:IAO_0000115 "A radiation quality inhering in a radioactive substance by virtue of its transformation (disintegration) rate."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001739 .

ns1:PATO_0001906 a owl:Class ;
    rdfs:label "movement quality"^^xsd:string ;
    ns1:IAO_0000111 "movement quality"^^xsd:string ;
    ns1:IAO_0000115 "A physical quality inhering in a bearer by virtue of the bearer's participation in movement."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001018 .

ns1:PATO_0002003 a owl:Class ;
    rdfs:label "population quality"^^xsd:string ;
    ns1:IAO_0000111 "population quality"^^xsd:string ;
    ns1:IAO_0000115 "A quality that inheres in an entire population or part of a population."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001241 .

ns1:PATO_0002182 a owl:Class ;
    rdfs:label "molecular quality"^^xsd:string ;
    ns1:IAO_0000111 "molecular quality"^^xsd:string ;
    ns1:IAO_0000115 "A quality which inheres in a molecular entity, a single molecule, atom, ion, radical etc."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001241 .

ns1:PATO_0002202 a owl:Class ;
    rdfs:label "left handedness"^^xsd:string ;
    ns1:IAO_0000111 "left handedness"^^xsd:string ;
    ns1:IAO_0000115 "Handedness where the organism preferentially uses the left hand or foot for tasks requiring the use of a single hand or foot or a dominant hand or foot."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0002201 .

ns1:PATO_0002203 a owl:Class ;
    rdfs:label "right handedness"^^xsd:string ;
    ns1:IAO_0000111 "right handedness"^^xsd:string ;
    ns1:IAO_0000115 "Handedness where the organism preferentially uses the right hand or foot for tasks requiring the use of a single hand or foot or a dominant hand or foot."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0002201 .

ns1:PATO_0002204 a owl:Class ;
    rdfs:label "ambidextrous handedness"^^xsd:string ;
    ns1:IAO_0000111 "ambidextrous handedness"^^xsd:string ;
    ns1:IAO_0000115 "Handedness where the organism exhibits no overall dominance in the use of right or left hand or foot in the performance of tasks that require one hand or foot or a dominant hand or foot."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0002201 .

ns1:RO_0000080 a owl:ObjectProperty ;
    rdfs:label "quality of"@en ;
    ns1:IAO_0000112 "this red color is a quality of this apple"@en ;
    ns1:IAO_0000115 "a relation between a quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en ;
    ns1:IAO_0000116 "A quality inheres in its bearer at all times for which the quality exists."@en ;
    ns1:IAO_0000118 "is quality of"@en,
        "quality_of"@en ;
    rdfs:subPropertyOf ns1:RO_0000052 ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0000086 ] ;
    owl:inverseOf ns1:RO_0000086 .

ns1:RO_0000091 a owl:ObjectProperty ;
    rdfs:label "has disposition"@en ;
    ns1:IAO_0000115 "a relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence"@en ;
    rdfs:domain ns1:BFO_0000004 ;
    rdfs:range ns1:BFO_0000016 ;
    rdfs:subPropertyOf ns1:RO_0000053 ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0000092 ] ;
    owl:inverseOf ns1:RO_0000092 .

ns1:RO_0001015 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "location of"@en ;
    ns1:IAO_0000111 "is location of"@en ;
    ns1:IAO_0000112 "my head is the location of my brain"@en,
        "this cage is the location of this rat"@en ;
    ns1:IAO_0000115 "a relation between two independent continuants, the location and the target, in which the target is entirely within the location"@en ;
    ns1:IAO_0000116 "Most location relations will only hold at certain times, but this is difficult to specify in OWL. See https://code.google.com/p/obo-relations/wiki/ROAndTime"@en ;
    ns1:IAO_0000118 "location_of"@en ;
    ns1:RO_0001900 ns1:RO_0001901 ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0001025 ] ;
    owl:inverseOf ns1:RO_0001025 .

ns1:RO_0002000 a owl:ObjectProperty ;
    rdfs:label "2D boundary of"@en ;
    ns1:IAO_0000112 "the surface of my skin is a 2D boundary of my body"@en ;
    ns1:IAO_0000115 "a relation between a 2D immaterial entity (the boundary) and a material entity, in which the boundary delimits the material entity"@en ;
    ns1:IAO_0000116 "A 2D boundary may have holes and gaps, but it must be a single connected entity, not an aggregate of several disconnected parts."@en,
        "Although the boundary is two-dimensional, it exists in three-dimensional space and thus has a 3D shape."@en ;
    ns1:IAO_0000118 "2D_boundary_of"@en,
        "boundary of"@en,
        "is 2D boundary of"@en,
        "is boundary of"@en ;
    ns1:RO_0001900 ns1:RO_0001901 ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0002002 ] ;
    owl:inverseOf ns1:RO_0002002 .

ns1:RO_0002090 a owl:ObjectProperty ;
    rdfs:label "immediately precedes"@en ;
    ns1:IAO_0000117 "David Osumi-Sutherland" ;
    ns1:IAO_0000118 "ends_at_start_of",
        "meets" ;
    rdfs:comment "X immediately_precedes_Y iff: end(X) simultaneous_with start(Y)"@en ;
    rdfs:subPropertyOf ns1:BFO_0000063 .

ns1:RO_0002223 a owl:ObjectProperty ;
    rdfs:label "starts"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "inverse of starts with" ;
    ns1:IAO_0000117 "Chris Mungall" ;
    ns1:IAO_0000119 "Allen" ;
    rdfs:subPropertyOf ns1:BFO_0000050,
        ns1:RO_0002222 .

ns1:RO_0002350 a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    ns1:IAO_0000112 "An organism that is a member of a population of organisms" ;
    ns1:IAO_0000115 "is member of is a mereological relation between a item and a collection." ;
    ns1:IAO_0000118 "is member of",
        "member part of" ;
    ns1:IAO_0000119 "SIO" ;
    ns1:RO_0001900 ns1:RO_0001901 ;
    rdfs:subPropertyOf ns1:BFO_0000050 ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0002351 ] ;
    owl:inverseOf ns1:RO_0002351 .

ns1:SO_0000104 a owl:Class ;
    rdfs:label "polypeptide"^^xsd:string ;
    ns1:IAO_0000111 "polypeptide"^^xsd:string ;
    ns1:IAO_0000115 "A sequence of amino acids linked by peptide bonds which may lack appreciable tertiary structure and may not be liable to irreversible denaturation."^^xsd:string ;
    ns1:IAO_0000118 "polypeptide sequence"^^xsd:string ;
    ns1:IAO_0000412 ns1:so.owl ;
    rdfs:subClassOf ns1:SO_0000001 .

ns1:SO_0000148 a owl:Class ;
    rdfs:label "supercontig"^^xsd:string ;
    ns1:IAO_0000111 "supercontig"^^xsd:string ;
    ns1:IAO_0000115 "One or more contigs that have been ordered and oriented using end-read information. Contains gaps that are filled with N's."^^xsd:string ;
    ns1:IAO_0000412 ns1:so.owl ;
    rdfs:subClassOf ns1:SO_0000353 .

ns1:SO_0000149 a owl:Class ;
    rdfs:label "contig"^^xsd:string ;
    ns1:IAO_0000111 "contig"^^xsd:string ;
    ns1:IAO_0000115 "A contiguous sequence derived from sequence assembly. Has no gaps, but may contain N's from unavailable bases."^^xsd:string ;
    ns1:IAO_0000412 ns1:so.owl ;
    rdfs:subClassOf ns1:SO_0000353 .

ns1:SO_0000988 a owl:Class ;
    rdfs:label "circular"^^xsd:string ;
    ns1:IAO_0000111 "circular"^^xsd:string ;
    ns1:IAO_0000115 "A quality of a nucleotide polymer that has no terminal nucleotide residues."^^xsd:string ;
    ns1:IAO_0000412 ns1:so.owl ;
    rdfs:subClassOf ns1:PATO_0001241 .

ns1:SO_0001410 a owl:Class ;
    rdfs:label "experimental_feature"^^xsd:string ;
    ns1:IAO_0000111 "experimental_feature"^^xsd:string ;
    ns1:IAO_0000115 "A region which is the result of some arbitrary experimental procedure. The procedure may be carried out with biological material or inside a computer."^^xsd:string ;
    ns1:IAO_0000412 ns1:so.owl ;
    rdfs:subClassOf ns1:SO_0000001 .

ns1:UBERON_0000007 a owl:Class ;
    rdfs:label "pituitary gland"^^xsd:string ;
    ns1:IAO_0000111 "pituitary gland"^^xsd:string ;
    ns1:IAO_0000115 "The pituitary gland is an endocrine gland that secretes hormones that regulate many other glands [GO]. An endocrine gland located ventral to the diencephalon and derived from mixed neuroectodermal and non neuroectodermal origin [ZFIN]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0000029 a owl:Class ;
    rdfs:label "lymph node"^^xsd:string ;
    ns1:IAO_0000111 "lymph node"^^xsd:string ;
    ns1:IAO_0000115 "Any of the rounded masses of lymphoid tissue that are surrounded by a capsule of connective tissue, are distributed along the lymphatic vessels, and contain numerous lymphocytes which filter the flow of lymph."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0000105 a owl:Class ;
    rdfs:label "life cycle stage"^^xsd:string ;
    ns1:IAO_0000111 "life cycle stage"^^xsd:string ;
    ns1:IAO_0000115 "A spatiotemporal region encompassing some part of the life cycle of an organism."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:UBERON_0000173 a owl:Class ;
    rdfs:label "amniotic fluid"^^xsd:string ;
    ns1:IAO_0000111 "amniotic fluid"^^xsd:string ;
    ns1:IAO_0000115 "Amniotic fluid is a bodily fluid consisting of watery liquid surrounding and cushioning a growing fetus within the amnion. It allows the fetus to move freely without the walls of the uterus being too tight against its body. Buoyancy is also provided. The composition of the fluid changes over the course of gestation. Initially, amniotic fluid is similar to maternal plasma, mainly water with electrolytes. As the fetus develops, proteins, carbohydrates, lipids, phospholipids originating from the lungs, fetal cells, and urea are deposited in the fluid."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0000362 a owl:Class ;
    rdfs:label "renal medulla"^^xsd:string ;
    ns1:IAO_0000111 "renal medulla"^^xsd:string ;
    ns1:IAO_0000115 "the inner portion of the kidney consisting of the renal pyramids"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000481 .

ns1:UBERON_0000473 a owl:Class ;
    rdfs:label "testis"^^xsd:string ;
    ns1:IAO_0000111 "testis"^^xsd:string ;
    ns1:IAO_0000115 "A gonad of a male animal. A gonad produces and releases sperm."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0000945 a owl:Class ;
    rdfs:label "stomach"^^xsd:string ;
    ns1:IAO_0000111 "stomach"^^xsd:string ;
    ns1:IAO_0000115 "An expanded region of the vertebrate alimentary tract that serves as a food storage compartment and digestive organ. A stomach is lined, in whole or in part by a glandular epithelium."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0000947 a owl:Class ;
    rdfs:label "aorta"^^xsd:string ;
    ns1:IAO_0000111 "aorta"^^xsd:string ;
    ns1:IAO_0000115 "The main trunk of the systemic arterial system that carries blood from the heart to all the organs and other structures of the body, bringing oxygenated blood to all parts of the body in the systemic circulation"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0000948 a owl:Class ;
    rdfs:label "heart"^^xsd:string ;
    ns1:IAO_0000111 "heart"^^xsd:string ;
    ns1:IAO_0000115 "A myogenic muscular circulatory organ found in the vertebrate cardiovascular system composed of chambers of cardiac muscle. It is the primary circulatory organ."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0000956 a owl:Class ;
    rdfs:label "cerebral cortex"^^xsd:string ;
    ns1:IAO_0000111 "cerebral cortex"^^xsd:string ;
    ns1:IAO_0000115 "The thin layer of gray matter on the surface of the cerebral hemisphere that develops from the telencephalon. It consists of the neocortex (6 layered cortex or isocortex), the hippocampal formation and the olfactory cortex."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000477 .

ns1:UBERON_0000992 a owl:Class ;
    rdfs:label "ovary"^^xsd:string ;
    ns1:IAO_0000111 "ovary"^^xsd:string ;
    ns1:IAO_0000115 "the gonad of a female organism which contains germ cells"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0000995 a owl:Class ;
    rdfs:label "uterus"^^xsd:string ;
    ns1:IAO_0000111 "uterus"^^xsd:string ;
    ns1:IAO_0000115 "the female muscular organ of gestation in which the developing embryo or fetus is nourished until birth"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001013 a owl:Class ;
    rdfs:label "adipose tissue"^^xsd:string ;
    ns1:IAO_0000111 "adipose tissue"^^xsd:string ;
    ns1:IAO_0000115 "Portion of connective tissue composed of adipocytes enmeshed in areolar tissue"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000479 .

ns1:UBERON_0001037 a owl:Class ;
    rdfs:label "strand of hair"^^xsd:string ;
    ns1:IAO_0000111 "strand of hair"^^xsd:string ;
    ns1:IAO_0000115 "A filament, mostly protein, that grows from follicles found in the dermis[WP]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001052 a owl:Class ;
    rdfs:label "rectum"^^xsd:string ;
    ns1:IAO_0000111 "rectum"^^xsd:string ;
    ns1:IAO_0000115 "the terminal portion of the intestinal tube, terminating with the anus"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001087 a owl:Class ;
    rdfs:label "pleural fluid"^^xsd:string ;
    ns1:IAO_0000111 "pleural fluid"^^xsd:string ;
    ns1:IAO_0000115 "Transudate contained in the pleural cavity."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001088 a owl:Class ;
    rdfs:label "urine"^^xsd:string ;
    ns1:IAO_0000111 "urine"^^xsd:string ;
    ns1:IAO_0000115 "Excretion that is the output of a kidney"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001089 a owl:Class ;
    rdfs:label "sweat"^^xsd:string ;
    ns1:IAO_0000111 "sweat"^^xsd:string ;
    ns1:IAO_0000115 "Secretion produced by a sweat gland."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001090 a owl:Class ;
    rdfs:label "synovial fluid"^^xsd:string ;
    ns1:IAO_0000111 "synovial fluid"^^xsd:string ;
    ns1:IAO_0000115 "Joint fluid is a transudate of plasma that is actively secreted by synovial cells."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001155 a owl:Class ;
    rdfs:label "colon"^^xsd:string ;
    ns1:IAO_0000111 "colon"^^xsd:string ;
    ns1:IAO_0000115 "Last portion of the large intestine before it becomes the rectum."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001159 a owl:Class ;
    rdfs:label "sigmoid colon"^^xsd:string ;
    ns1:IAO_0000111 "sigmoid colon"^^xsd:string ;
    ns1:IAO_0000115 "The part of the large intestine that is closest to the rectum and anus. It forms a loop that averages about 40 cm. in length, and normally lies within the pelvis, but on account of its freedom of movement it is liable to be displaced into the abdominal cavity."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001225 a owl:Class ;
    rdfs:label "cortex of kidney"^^xsd:string ;
    ns1:IAO_0000111 "cortex of kidney"^^xsd:string ;
    ns1:IAO_0000115 "Outer cortical portion of the kidney, between the renal capsule and the renal medulla."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001255 a owl:Class ;
    rdfs:label "urinary bladder"^^xsd:string ;
    ns1:IAO_0000111 "urinary bladder"^^xsd:string ;
    ns1:IAO_0000115 "distensible musculomembranous organ situated in the anterior part of the pelvic cavity in which urine collects before excretion[MP]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001264 a owl:Class ;
    rdfs:label "pancreas"^^xsd:string ;
    ns1:IAO_0000111 "pancreas"^^xsd:string ;
    ns1:IAO_0000115 "An endoderm derived structure that produces precursors of digestive enzymes and blood glucose regulating enzymes[GO]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001268 a owl:Class ;
    rdfs:label "peritoneal fluid"^^xsd:string ;
    ns1:IAO_0000111 "peritoneal fluid"^^xsd:string ;
    ns1:IAO_0000115 "Transudate contained in the peritoneal cavity."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001323 a owl:Class ;
    rdfs:label "tibial nerve"^^xsd:string ;
    ns1:IAO_0000111 "tibial nerve"^^xsd:string ;
    ns1:IAO_0000115 "The tibial nerve is a branch of the sciatic nerve. The tibial nerve passes through the popliteal fossa to pass below the arch of soleus. In the popliteal fossa the nerve gives off branches to gastrocnemius, popliteus, soleus and plantaris muscles, an articular branch to the knee joint, and a cutaneous branch that will become the sural nerve. The sural nerve is joined by fibres from the common peroneal nerve and runs down the calf to supply the lateral side of the foot. Below the soleus muscle the nerve lies close to the tibia and supplies the tibialis posterior, the flexor digitorum longus and the flexor hallucis longus. The nerve passes into the foot running posterior to the medial malleolus. Here it is bound down by the flexor retinaculum in company with the posterior tibial artery. [WP,unvetted]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000477 .

ns1:UBERON_0001359 a owl:Class ;
    rdfs:label "cerebrospinal fluid"^^xsd:string ;
    ns1:IAO_0000111 "cerebrospinal fluid"^^xsd:string ;
    ns1:IAO_0000115 "A clear, colorless, bodily fluid, that occupies the subarachnoid space and the ventricular system around and inside the brain and spinal cord."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001567 a owl:Class ;
    rdfs:label "cheek"^^xsd:string ;
    ns1:IAO_0000111 "cheek"^^xsd:string ;
    ns1:IAO_0000115 "A fleshy subdivision of one side of the face bounded by an eye, ear and the nose."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001621 a owl:Class ;
    rdfs:label "coronary artery"^^xsd:string ;
    ns1:IAO_0000111 "coronary artery"^^xsd:string ;
    ns1:IAO_0000115 "An artery that supplies the myocardium."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001638 a owl:Class ;
    rdfs:label "vein"^^xsd:string ;
    ns1:IAO_0000111 "vein"^^xsd:string ;
    ns1:IAO_0000115 "Any of the tubular branching vessels that carry blood from the capillaries toward the heart."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001723 a owl:Class ;
    rdfs:label "tongue"^^xsd:string ;
    ns1:IAO_0000111 "tongue"^^xsd:string ;
    ns1:IAO_0000115 "A muscular organ in the floor of the mouth."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001728 a owl:Class ;
    rdfs:label "nasopharynx"^^xsd:string ;
    ns1:IAO_0000111 "nasopharynx"^^xsd:string ;
    ns1:IAO_0000115 "the section of the pharynx that lies above the soft palate"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001729 a owl:Class ;
    rdfs:label "oropharynx"^^xsd:string ;
    ns1:IAO_0000111 "oropharynx"^^xsd:string ;
    ns1:IAO_0000115 "the portion of the pharynx that lies between the soft palate and the upper edge of the epiglottis"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001797 a owl:Class ;
    rdfs:label "vitreous humor"^^xsd:string ;
    ns1:IAO_0000111 "vitreous humor"^^xsd:string ;
    ns1:IAO_0000115 "A transparent, semigelatinous substance that fills the cavity behind the crystalline lens of the eye and in front of the retina"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001830 a owl:Class ;
    rdfs:label "minor salivary gland"^^xsd:string ;
    ns1:IAO_0000111 "minor salivary gland"^^xsd:string ;
    ns1:IAO_0000115 "One of the smaller, largely mucus-secreting, exocrine glands of the oral cavity, consisting of the labial, buccal, molar, lingual, and palatine glands[MP]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0001836 a owl:Class ;
    rdfs:label "saliva"^^xsd:string ;
    ns1:IAO_0000111 "saliva"^^xsd:string ;
    ns1:IAO_0000115 "A fluid produced in the oral cavity by salivary glands, typically used in predigestion, but also in other functions."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001913 a owl:Class ;
    rdfs:label "milk"^^xsd:string ;
    ns1:IAO_0000111 "milk"^^xsd:string ;
    ns1:IAO_0000115 "An emulsion of fat globules within a fluid that is secreted by the mammary gland during lactation."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001970 a owl:Class ;
    rdfs:label "bile"^^xsd:string ;
    ns1:IAO_0000111 "bile"^^xsd:string ;
    ns1:IAO_0000115 "vital aqueous secretion of the liver that is formed by hepatocytes and modified down stream by absorptive and secretory properties of the bile duct epithelium."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0001987 a owl:Class ;
    rdfs:label "placenta"^^xsd:string ;
    ns1:IAO_0000111 "placenta"^^xsd:string ;
    ns1:IAO_0000115 "organ of metabolic interchange between fetus and mother, partly of embryonic origin and partly of maternal origin[GO]. The fetal portion of the placenta is known as the villous chorion. The maternal portion is known as the decidua basalis. The two portions are held together by anchoring villi that are anchored to the decidua basalis by the cytotrophoblastic shell."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002032 a owl:Class ;
    rdfs:label "areola"^^xsd:string ;
    ns1:IAO_0000111 "areola"^^xsd:string ;
    ns1:IAO_0000115 "Subdivision of breast which consists of skin, connective tissue and smooth muscle bundle and modified sebaceous glands and which surrounds the nipple."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002037 a owl:Class ;
    rdfs:label "cerebellum"^^xsd:string ;
    ns1:IAO_0000111 "cerebellum"^^xsd:string ;
    ns1:IAO_0000115 "Part of the metencephalon that lies in the posterior cranial fossa behind the brain stem. It is concerned with the coordination of movement[MESH]. A large dorsally projecting part of the brain concerned especially with the coordination of muscles and the maintenance of bodily equilibrium, situated between the brain stem and the back of the cerebrum , and formed in humans of two lateral lobes and a median lobe[BTO]. Brain structure derived from the anterior hindbrain, and perhaps including posterior midbrain. The cerebellum plays a role in somatic motor function, the control of muscle tone, and balance[ZFA]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000481 .

ns1:UBERON_0002046 a owl:Class ;
    rdfs:label "thyroid gland"^^xsd:string ;
    ns1:IAO_0000111 "thyroid gland"^^xsd:string ;
    ns1:IAO_0000115 "A two-lobed endocrine gland found in all vertebrates, located in front of and on either side of the trachea in humans, and producing various hormones, such as triiodothyronine and calcitonin[BTO]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002048 a owl:Class ;
    rdfs:label "lung"^^xsd:string ;
    ns1:IAO_0000111 "lung"^^xsd:string ;
    ns1:IAO_0000115 "Respiration organ that develops as an oupocketing of the esophagus."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002067 a owl:Class ;
    rdfs:label "dermis"^^xsd:string ;
    ns1:IAO_0000111 "dermis"^^xsd:string ;
    ns1:IAO_0000115 "The dermis is a layer of skin between the epidermis (with which it makes up the skin) and subcutaneous tissues, and is composed of two layers, the papillary and reticular dermis[WP]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002072 a owl:Class ;
    rdfs:label "hypodermis"^^xsd:string ;
    ns1:IAO_0000111 "hypodermis"^^xsd:string ;
    ns1:IAO_0000115 "Lowermost layer of the integumentary system in vertebrates. Types of cells that are found in the hypodermis are fibroblasts, adipose cells, and macrophages. It is derived from the mesoderm, but unlike the dermis, it is not derived from the dermatome region of the mesoderm. The hypodermis is used mainly for fat storage[WP]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002097 a owl:Class ;
    rdfs:label "skin of body"^^xsd:string ;
    ns1:IAO_0000111 "skin of body"^^xsd:string ;
    ns1:IAO_0000115 "The organ covering the body that consists of the dermis and epidermis."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002107 a owl:Class ;
    rdfs:label "liver"^^xsd:string ;
    ns1:IAO_0000111 "liver"^^xsd:string ;
    ns1:IAO_0000115 "An exocrine gland which secretes bile and functions in metabolism of protein and carbohydrate and fat, synthesizes substances involved in the clotting of the blood, synthesizes vitamin A, detoxifies poisonous substances, stores glycogen, and breaks down worn-out erythrocytes[GO]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002116 a owl:Class ;
    rdfs:label "ileum"^^xsd:string ;
    ns1:IAO_0000111 "ileum"^^xsd:string ;
    ns1:IAO_0000115 "the portion of the small intestine that extends from the jejunum to the colon"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002367 a owl:Class ;
    rdfs:label "prostate gland"^^xsd:string ;
    ns1:IAO_0000111 "prostate gland"^^xsd:string ;
    ns1:IAO_0000115 "The prostate gland is a partly muscular, partly glandular body that is situated near the base of the mammalian male urethra and secretes an alkaline viscid fluid which is a major constituent of the ejaculatory fluid."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002369 a owl:Class ;
    rdfs:label "adrenal gland"^^xsd:string ;
    ns1:IAO_0000111 "adrenal gland"^^xsd:string ;
    ns1:IAO_0000115 "Either of a pair of complex endocrine organs near the anterior medial border of the kidney consisting of a mesodermal cortex that produces glucocorticoid, mineralocorticoid, and androgenic hormones and an ectodermal medulla that produces epinephrine and norepinephrine[BTO]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002371 a owl:Class ;
    rdfs:label "bone marrow"^^xsd:string ;
    ns1:IAO_0000111 "bone marrow"^^xsd:string ;
    ns1:IAO_0000115 "the soft tissue that fills the cavities of bones"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000479 .

ns1:UBERON_0002409 a owl:Class ;
    rdfs:label "pericardial fluid"^^xsd:string ;
    ns1:IAO_0000111 "pericardial fluid"^^xsd:string ;
    ns1:IAO_0000115 "Transudate contained in the pericardial cavity.[FMA]"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0002469 a owl:Class ;
    rdfs:label "esophagus mucosa"^^xsd:string ;
    ns1:IAO_0000111 "esophagus mucosa"^^xsd:string ;
    ns1:IAO_0000115 "A mucosa that is part of a esophagus [Automatically generated definition]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0003688 a owl:Class ;
    rdfs:label "omentum"^^xsd:string ;
    ns1:IAO_0000111 "omentum"^^xsd:string ;
    ns1:IAO_0000115 "A fold of peritoneum originating at the stomach and supporting the viscera."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0004648 a owl:Class ;
    rdfs:label "esophagus muscularis mucosa"^^xsd:string ;
    ns1:IAO_0000111 "esophagus muscularis mucosa"^^xsd:string ;
    ns1:IAO_0000115 "A muscularis mucosa that is part of a esophagus."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000479 .

ns1:UBERON_0005022 a owl:Class ;
    rdfs:label "mucosa of nasopharynx"^^xsd:string ;
    ns1:IAO_0000111 "mucosa of nasopharynx"^^xsd:string ;
    ns1:IAO_0000115 "A mucosa that is part of a nasopharynx [Automatically generated definition]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0006618 a owl:Class ;
    rdfs:label "atrium auricular region"^^xsd:string ;
    ns1:IAO_0000111 "atrium auricular region"^^xsd:string ;
    ns1:IAO_0000115 "A small conical pouch projections located on the upper anterior portion of each atrium of the heart."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000481 .

ns1:UBERON_0006911 a owl:Class ;
    rdfs:label "digestive system secreted substance"^^xsd:string ;
    ns1:IAO_0000111 "digestive system secreted substance"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0007311 a owl:Class ;
    rdfs:label "sputum"^^xsd:string ;
    ns1:IAO_0000111 "sputum"^^xsd:string ;
    ns1:IAO_0000115 "Matter ejected from the lungs, bronchi, and trachea, through the mouth."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000463 .

ns1:UBERON_0007610 a owl:Class ;
    rdfs:label "tibial artery"^^xsd:string ;
    ns1:IAO_0000111 "tibial artery"^^xsd:string ;
    ns1:IAO_0000115 "The anterior and posterior arteries created at the bifurcation of the popliteal artery. The anterior tibial artery begins at the lower border of the popliteus muscle and lies along the tibia at the distal part of the leg to surface superficially anterior to the ankle joint. Its branches are distributed throughout the leg, ankle, and pes. The posterior tibial artery begins at the lower border of the popliteus muscle, lies behind the tibia in the lower part of its course, and is found situated between the medial malleolus and the medial process of the calcaneal tuberosity. Its branches are distributed throughout the leg and foot."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0007650 a owl:Class ;
    rdfs:label "esophagogastric junction"^^xsd:string ;
    ns1:IAO_0000111 "esophagogastric junction"^^xsd:string ;
    ns1:IAO_0000115 "The junction between the esophagus and the stomach epithelium"^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0036149 a owl:Class ;
    rdfs:label "suprapubic skin"^^xsd:string ;
    ns1:IAO_0000111 "suprapubic skin"^^xsd:string ;
    ns1:IAO_0000115 "Area of skin in the hypoastric region of the abdomen."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UO_0000027 a ns1:UO_0000005,
        owl:NamedIndividual ;
    rdfs:label "degree Celsius"^^xsd:string ;
    ns1:IAO_0000111 "degree Celsius"^^xsd:string ;
    ns1:IAO_0000115 "A temperature unit which is equal to one kelvin degree. However, they have their zeros at different points. The centigrade scale has its zero at 273.15 K."^^xsd:string ;
    ns1:IAO_0000118 "C"^^xsd:string,
        "degree C"^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl .

ns1:UO_0000105 a owl:Class ;
    rdfs:label "frequency unit"^^xsd:string ;
    ns1:IAO_0000111 "frequency unit"^^xsd:string ;
    ns1:IAO_0000115 "A unit which is a standard measure of the number of repetitive actions in a particular time."^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl ;
    rdfs:subClassOf ns1:IAO_0000003 .

ns1:UO_0000270 a owl:Class ;
    rdfs:label "volumetric flow rate unit"^^xsd:string ;
    ns1:IAO_0000111 "volumetric flow rate unit"^^xsd:string ;
    ns1:IAO_0000115 "A unit which is a standard measure of the volume of fluid which passes through a given surface per unit time ."^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl ;
    rdfs:subClassOf ns1:IAO_0000003 .

<http://www.geneontology.org/formats/oboInOwl#Subset> a owl:Class ;
    rdfs:subClassOf ns1:IAO_0000102 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:IAO_0000224 ) ] .

xsd:nonNegativeInteger a rdfs:Datatype .

ns1:BFO_0000024 a owl:Class ;
    rdfs:label "fiat object"@en,
        "fiat object part"@en ;
    ns1:BFO_0000179 "fiat-object",
        "fiat-object-part" ;
    ns1:BFO_0000180 "FiatObjectPart" ;
    ns1:IAO_0000112 "or with divisions drawn by cognitive subjects for practical reasons, such as the division of a cake (before slicing) into (what will become) slices (and thus member parts of an object aggregate). However, this does not mean that fiat object parts are dependent for their existence on divisions or delineations effected by cognitive subjects. If, for example, it is correct to conceive geological layers of the Earth as fiat object parts of the Earth, then even though these layers were first delineated in recent times, still existed long before such delineation and what holds of these layers (for example that the oldest layers are also the lowest layers) did not begin to hold because of our acts of delineation.Treatment of material entity in BFOExamples viewed by some as problematic cases for the trichotomy of fiat object part, object, and object aggregate include: a mussel on (and attached to) a rock, a slime mold, a pizza, a cloud, a galaxy, a railway train with engine and multiple carriages, a clonal stand of quaking aspen, a bacterial community (biofilm), a broken femur. Note that, as Aristotle already clearly recognized, such problematic cases – which lie at or near the penumbra of instances defined by the categories in question – need not invalidate these categories. The existence of grey objects does not prove that there are not objects which are black and objects which are white; the existence of mules does not prove that there are not objects which are donkeys and objects which are horses. It does, however, show that the examples in question need to be addressed carefully in order to show how they can be fitted into the proposed scheme, for example by recognizing additional subdivisions [29"@en,
        "the FMA:regional parts of an intact human body."@en,
        "the Western hemisphere of the Earth"@en,
        "the division of the brain into regions"@en,
        "the division of the planet into hemispheres"@en,
        "the dorsal and ventral surfaces of the body"@en,
        "the upper and lower lobes of the left lung"@en ;
    ns1:IAO_0000116 "BFO 2 Reference: Most examples of fiat object parts are associated with theoretically drawn divisions"@en ;
    ns1:IAO_0000600 "b is a fiat object part = Def. b is a material entity which is such that for all times t, if b exists at t then there is some object c such that b proper continuant_part of  c at t and c is demarcated from the remainder of c by a two-dimensional continuant fiat boundary. (axiom label in BFO2 Reference: [027-004])"@en ;
    ns1:IAO_0000602 "(forall (x) (if (FiatObjectPart x) (and (MaterialEntity x) (forall (t) (if (existsAt x t) (exists (y) (and (Object y) (properContinuantPartOfAt x y t)))))))) // axiom label in BFO2 CLIF: [027-004] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:BFO_0000038 a owl:Class ;
    rdfs:label "one-dimensional temporal region"@en ;
    ns1:BFO_0000179 "1d-t-region" ;
    ns1:BFO_0000180 "OneDimensionalTemporalRegion" ;
    ns1:IAO_0000112 "the temporal region during which a process occurs."@en ;
    ns1:IAO_0000116 "BFO 2 Reference: A temporal interval is a special kind of one-dimensional temporal region, namely one that is self-connected (is without gaps or breaks)."@en ;
    ns1:IAO_0000600 "A one-dimensional temporal region is a temporal region that is extended. (axiom label in BFO2 Reference: [103-001])"@en ;
    ns1:IAO_0000602 "(forall (x) (if (OneDimensionalTemporalRegion x) (TemporalRegion x))) // axiom label in BFO2 CLIF: [103-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000008 ;
    owl:disjointWith ns1:BFO_0000148 .

ns1:BFO_0000063 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes"@en ;
    ns1:IAO_0000111 "precedes"@en ;
    rdfs:domain ns1:BFO_0000003 ;
    rdfs:range ns1:BFO_0000003 ;
    rdfs:subPropertyOf ns1:RO_0002222 .

ns1:BFO_0000067 a owl:ObjectProperty ;
    rdfs:label "contains process"@en ;
    ns1:IAO_0000111 "site of"@en ;
    ns1:IAO_0000115 "[copied from inverse property 'occurs in'] b occurs_in c =def b is a process and c is a material entity or immaterial entity& there exists a spatiotemporal region r and b occupies_spatiotemporal_region r.& forall(t) if b exists_at t then c exists_at t & there exist spatial regions s and s’ where & b spatially_projects_onto s at t& c is occupies_spatial_region s’ at t& s is a proper_continuant_part_of s’ at t"@en ;
    rdfs:comment "Paraphrase of definition: a relation between an independent continuant and a process, in which the process takes place entirely within the independent continuant" ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    owl:equivalentProperty [ owl:inverseOf ns1:BFO_0000066 ] .

ns1:BFO_0000134 ns1:IAO_0000600 "To say that each spatiotemporal region s temporally_projects_onto some temporal region t is to say that t is the temporal extension of s. (axiom label in BFO2 Reference: [080-003])"@en,
        "To say that spatiotemporal region s spatially_projects_onto spatial region r at t is to say that r is the spatial extent of s at t. (axiom label in BFO2 Reference: [081-003])"@en .

ns1:BFO_0000145 a owl:Class ;
    rdfs:label "relational quality"@en ;
    ns1:BFO_0000179 "r-quality" ;
    ns1:BFO_0000180 "RelationalQuality" ;
    ns1:IAO_0000112 "John’s role of husband to Mary is dependent on Mary’s role of wife to John, and both are dependent on the object aggregate comprising John and Mary as member parts joined together through the relational quality of being married."@en,
        "a marriage bond, an instance of love, an obligation between one person and another."@en ;
    ns1:IAO_0000115 "b is a relational quality = Def. for some independent continuants c, d and for some time t: b quality_of c at t & b quality_of d at t. (axiom label in BFO2 Reference: [057-001])"@en ;
    ns1:IAO_0000602 "(iff (RelationalQuality a) (exists (b c t) (and (IndependentContinuant b) (IndependentContinuant c) (qualityOfAt a b t) (qualityOfAt a c t)))) // axiom label in BFO2 CLIF: [057-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000019 .

ns1:BFO_0000182 a owl:Class ;
    rdfs:label "history"@en ;
    ns1:BFO_0000179 "history" ;
    ns1:BFO_0000180 "History" ;
    ns1:IAO_0000600 "A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by a material entity or site, including processes on the surface of the entity or within the cavities to which it serves as host. (axiom label in BFO2 Reference: [138-001])"@en ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns1:CHEBI_15422 a owl:Class ;
    rdfs:label "ATP"^^xsd:string ;
    ns1:IAO_0000111 "ATP"^^xsd:string ;
    ns1:IAO_0000115 "An adenosine 5'-phosphate in which the 5'-phosphate is a triphosphate group. It is involved in the transportation of chemical energy during metabolic pathways."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_29237 a owl:Class ;
    rdfs:label "deuterium atom"^^xsd:string ;
    ns1:IAO_0000111 "deuterium atom"^^xsd:string ;
    ns1:IAO_0000115 "The stable isotope of hydrogen with relative atomic mass 2.014102 and a natural abundance of 0.0115 atom percent (from Greek deltaepsilonupsilontauepsilonrhoomicronnu, second)."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367,
        ns1:CHEBI_33250 .

ns1:CHEBI_33321 a owl:Class ;
    rdfs:label "rare earth metal atom"^^xsd:string ;
    ns1:IAO_0000111 "rare earth metal atom"^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_33250 .

ns1:CHEBI_50076 a owl:Class ;
    rdfs:label "chromium-51"^^xsd:string ;
    ns1:IAO_0000111 "chromium-51"^^xsd:string ;
    ns1:IAO_0000115 "A synthetic radioactive isotope of chromium having a half-life of 27.7 days and decaying by electron capture with emission of gamma rays (0.32 MeV); it is used to label red blood cells for measurement of mass or volume, survival time, and sequestration studies, for the diagnosis of gastrointestinal bleeding, and to label platelets to study their survival."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_53526 a owl:Class ;
    rdfs:label "tritiated thymidine"^^xsd:string ;
    ns1:IAO_0000111 "tritiated thymidine"^^xsd:string ;
    ns1:IAO_0000115 "Thymidine linked to the radioisotope tritium. Used to label DNA in the study of cellular and viral DNA synthesis."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_59056 a owl:Class ;
    rdfs:label "EDTA methidiumpropylamide"^^xsd:string ;
    ns1:IAO_0000111 "EDTA methidiumpropylamide"^^xsd:string ;
    ns1:IAO_0000115 "A combined intercalating and chelating reagent. The iron chelate, prepared by adding Fe(NH4)2(SO4)2, effects random oxidative cleavage of DNA in the presence of O2 and a reducing agent. This activity is useful as a footprinting probe."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_61073 a owl:Class ;
    rdfs:label "oxygen radical"^^xsd:string ;
    ns1:IAO_0000111 "oxygen radical"^^xsd:string ;
    ns1:IAO_0000115 "An inorganic radical in which a free electron resides on one or more oxygen atoms of an oxygen species."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHMO_0000087 a owl:Class ;
    rdfs:label "fluorescence microscopy"^^xsd:string ;
    ns1:IAO_0000115 "Any type of microscopy where the specimen can be made to fluoresce (emit energy as visible light) by illuminating it with light of specific wavelengths. These specimens are called fluorophores."^^xsd:string ;
    ns1:IAO_0000118 "FM"^^xsd:string,
        "fluorescence imaging"^^xsd:string,
        "fluorescence microscopic imaging"^^xsd:string ;
    ns1:IAO_0000119 "CHMO"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002119 .

ns1:CLO_0000018 a owl:Class ;
    rdfs:label "mortal cell line cell"^^xsd:string ;
    ns1:IAO_0000111 "mortal cell line cell"^^xsd:string ;
    ns1:IAO_0000115 "A cell line cell that is capable of replicating a limited number of times in culture before undergoing senescence." ;
    ns1:IAO_0000412 ns1:clo.owl ;
    rdfs:subClassOf ns1:CLO_0000001 .

ns1:CLO_0000019 a owl:Class ;
    rdfs:label "immortal cell line cell"^^xsd:string ;
    ns1:IAO_0000111 "immortal cell line cell"^^xsd:string ;
    ns1:IAO_0000115 "A cell line cell that is expected to be capable of an unlimited number of divisions, and is thus able to support indefinite propagation in vitro as part of an immortal cell line." ;
    ns1:IAO_0000412 ns1:clo.owl ;
    rdfs:subClassOf ns1:CLO_0000001 .

ns1:CL_0000542 a owl:Class ;
    rdfs:label "lymphocyte"^^xsd:string ;
    ns1:IAO_0000111 "lymphocyte"^^xsd:string ;
    ns1:IAO_0000115 "A lymphocyte is a leukocyte commonly found in the blood and lymph that has the characteristics of a large nucleus, a neutral staining cytoplasm, and prominent heterochromatin."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000842 .

ns1:GAZ_00000448 a owl:Class ;
    rdfs:label "geographic location"^^xsd:string ;
    ns1:IAO_0000111 "geographic location"^^xsd:string ;
    ns1:IAO_0000115 "A reference to a place on the Earth, by its name or by its geographical location."^^xsd:string ;
    ns1:IAO_0000412 ns1:gaz.owl ;
    rdfs:subClassOf ns1:BFO_0000029 .

ns1:GO_0001508 a owl:Class ;
    rdfs:label "action potential"^^xsd:string ;
    ns1:IAO_0000111 "action potential"^^xsd:string ;
    ns1:IAO_0000115 "A process in which membrane potential cycles through a depolarizing spike, triggered in response to depolarization above some threshold, followed by repolarization. This cycle is driven by the flow of ions through various voltage gated channels with different thresholds and ion specificities."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0003674 a owl:Class ;
    rdfs:label "GO:molecular_function"^^xsd:string ;
    ns1:IAO_0000111 "molecular_function"^^xsd:string ;
    ns1:IAO_0000115 "A molecular process that can be carried out by the action of a single macromolecular machine, usually via direct physical interactions with other molecular entities. Function in this sense denotes an action, or activity, that a gene product (or a complex) performs. These actions are described from two distinct but related perspectives: (1) biochemical activity, and (2) role as a component in a larger system/process."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns1:GO_0005216 a owl:Class ;
    rdfs:label "ion channel activity"^^xsd:string ;
    ns1:IAO_0000111 "ion channel activity"^^xsd:string ;
    ns1:IAO_0000115 "Enables the facilitated diffusion of an ion (by an energy-independent process) by passage through a transmembrane aqueous pore or channel without evidence for a carrier-mediated mechanism. May be either selective (it enables passage of a specific ion only) or non-selective (it enables passage of two or more ions of same charge but different size)."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0009987 .

ns1:GO_0005694 a owl:Class ;
    rdfs:label "chromosome"^^xsd:string ;
    ns1:IAO_0000111 "chromosome"^^xsd:string ;
    ns1:IAO_0000115 "A structure composed of a very long molecule of DNA and associated proteins (e.g. histones) that carries hereditary information."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0005575 .

ns1:GO_0006260 a owl:Class ;
    rdfs:label "DNA replication"^^xsd:string ;
    ns1:IAO_0000111 "DNA replication"^^xsd:string ;
    ns1:IAO_0000115 "The cellular metabolic process in which a cell duplicates one or more molecules of DNA. DNA replication begins when specific sequences, known as origins of replication, are recognized and bound by initiation proteins, and ends when the original DNA molecule has been completely duplicated and the copies topologically separated. The unit of replication usually corresponds to the genome of the cell, an organelle, or a virus. The template for replication can either be an existing DNA molecule or RNA."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0006306 a owl:Class ;
    rdfs:label "DNA methylation"^^xsd:string ;
    ns1:IAO_0000111 "DNA methylation"^^xsd:string ;
    ns1:IAO_0000115 "The covalent transfer of a methyl group to either N-6 of adenine or C-5 or N-4 of cytosine."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0008283 a owl:Class ;
    rdfs:label "cell proliferation"^^xsd:string ;
    ns1:IAO_0000111 "cell proliferation"^^xsd:string ;
    ns1:IAO_0000115 "The multiplication or reproduction of cells, resulting in the expansion of a cell population."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0016570 a owl:Class ;
    rdfs:label "histone modification"^^xsd:string ;
    ns1:IAO_0000111 "histone modification"^^xsd:string ;
    ns1:IAO_0000115 "The covalent alteration of one or more amino acid residues within a histone protein."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0032612 a owl:Class ;
    rdfs:label "interleukin-1 production"^^xsd:string ;
    ns1:IAO_0000111 "interleukin-1 production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of interleukin-1 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0040030 a owl:Class ;
    rdfs:label "regulation of molecular function, epigenetic"^^xsd:string ;
    ns1:IAO_0000111 "regulation of molecular function, epigenetic"^^xsd:string ;
    ns1:IAO_0000115 "Any heritable epigenetic process that modulates the frequency, rate or extent of protein function by self-perpetuating conformational conversions of normal proteins in healthy cells. This is distinct from, though mechanistically analogous to, disease states associated with prion propagation and amyloidogenesis. A single protein, if it carries a glutamine/asparagine-rich ('prion') domain, can sometimes stably exist in at least two distinct physical states, each associated with a different phenotype; propagation of one of these traits is achieved by a self-perpetuating change in the protein from one form to the other, mediated by conformational changes in the glutamine/asparagine-rich domain. Prion domains are both modular and transferable to other proteins, on which they can confer a heritable epigenetic alteration of function; existing bioinformatics data indicate that they are rare in non-eukarya, but common in eukarya."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0042101 a owl:Class ;
    rdfs:label "T cell receptor complex"^^xsd:string ;
    ns1:IAO_0000111 "T cell receptor complex"^^xsd:string ;
    ns1:IAO_0000115 "A protein complex that contains a disulfide-linked heterodimer of T cell receptor (TCR) chains, which are members of the immunoglobulin superfamily, and mediates antigen recognition, ultimately resulting in T cell activation. The TCR heterodimer is associated with the CD3 complex, which consists of the nonpolymorphic polypeptides gamma, delta, epsilon, zeta, and, in some cases, eta (an RNA splice variant of zeta) or Fc epsilon chains."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:OBI_1110022 .

ns1:GO_0042110 a owl:Class ;
    rdfs:label "T cell activation"^^xsd:string ;
    ns1:IAO_0000111 "T cell activation"^^xsd:string ;
    ns1:IAO_0000115 "The change in morphology and behavior of a mature or immature T cell resulting from exposure to a mitogen, cytokine, chemokine, cellular ligand, or an antigen for which it is specific."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0097458 a owl:Class ;
    rdfs:label "neuron part"^^xsd:string ;
    ns1:IAO_0000111 "neuron part"^^xsd:string ;
    ns1:IAO_0000115 "Any constituent part of a neuron, the basic cellular unit of nervous tissue. A typical neuron consists of a cell body (often called the soma), an axon, and dendrites. Their purpose is to receive, conduct, and transmit impulses in the nervous system."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0005575 .

ns1:IAO_0000009 a owl:Class ;
    rdfs:label "datum label"@en ;
    ns1:IAO_0000111 "datum label"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A label is a symbol that is part of some other datum and is used to either partially define  the denotation of that datum or to provide a means for identifying the datum as a member of the set of data with the same label"@en ;
    ns1:IAO_0000116 "http://www.golovchenko.org/cgi-bin/wnsearch?q=label#4n"@en ;
    ns1:IAO_0000117 "GROUP: IAO"@en ;
    ns1:IAO_0000232 "9/22/11 BP: changed the rdfs:label for this class from 'label' to 'datum label' to convey that this class is not intended to cover all kinds of labels (stickers, radiolabels, etc.), and not even all kind of textual labels, but rather the kind of labels occuring in a datum. \\n" ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:IAO_0000055 a owl:Class ;
    rdfs:label "rule"@en ;
    ns1:IAO_0000111 "rule"@en ;
    ns1:IAO_0000112 "example to be added"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a rule is an executable which guides, defines, restricts actions"@en ;
    ns1:IAO_0000116 "MSI"@en ;
    ns1:IAO_0000117 "PRS"@en ;
    ns1:IAO_0000119 "OBI_0500021"@en,
        "PRS"@en ;
    rdfs:subClassOf ns1:IAO_0000001 .

ns1:IAO_0000178 a owl:Class ;
    rdfs:label "material information bearer"@en ;
    ns1:IAO_0000111 "material information bearer"@en ;
    ns1:IAO_0000112 "A page of a paperback novel with writing on it. The paper itself is a material information bearer, the pattern of ink is the information carrier."@en,
        "a brain"@en,
        "a hard drive"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A material entity in which a concretization of an information content entity inheres."@en ;
    ns1:IAO_0000117 "GROUP: IAO"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000053 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000059 ;
                                owl:someValuesFrom ns1:IAO_0000030 ] ] ) ] .

ns1:IAO_0000179 a owl:Class ;
    rdfs:label "histogram"@en ;
    ns1:IAO_0000111 "histogram"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A histogram is a report graph which is a statistical description of a\\ndistribution in terms of occurrence frequencies of different event classes."@en ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert"@en,
        "PERSON:James Malone"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000119 "GROUP:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000038 .

ns1:IAO_0000180 a owl:Class ;
    rdfs:label "heatmap"@en ;
    ns1:IAO_0000111 "heatmap"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A heatmap is a report graph which is a graphical representation of data\\nwhere the values taken by a variable(s) are shown as colors in a\\ntwo-dimensional map."@en ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert"@en,
        "PERSON:James Malone"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000119 "GROUP:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000038 .

ns1:IAO_0000184 a owl:Class ;
    rdfs:label "scatter plot"@en ;
    ns1:IAO_0000111 "scatter plot"@en ;
    ns1:IAO_0000112 "Comparison of gene expression values in two samples can be displayed in a scatter plot"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A scatterplot is a graph which uses Cartesian coordinates to display values for two variables for a set of data. The data is displayed as a collection of points, each having the value of one variable determining the position on the horizontal axis and the value of the other variable determining the position on the vertical axis."@en ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert"@en,
        "PERSON:James Malone"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000118 "scattergraph"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Scatterplot"@en ;
    rdfs:subClassOf ns1:IAO_0000038 .

ns1:IAO_0000229 a ns1:IAO_0000225,
        owl:NamedIndividual ;
    rdfs:label "term split"@en ;
    ns1:IAO_0000116 "This is to be used when a term has been split in two or more new terms. An editor note should indicate the reason for the split and indicate the URIs of the new terms created."@en .

ns1:IAO_0000230 a ns1:IAO_0000225,
        owl:NamedIndividual ;
    rdfs:label "other"@en ;
    ns1:IAO_0000116 "This is to be used if none of the existing instances cover the reason for obsolescence. An editor note should indicate this new reason."@en,
        "We expect to be able to mine these new reasons and add instances as required."@en ;
    owl:deprecated true .

ns1:IAO_0000311 a owl:Class ;
    rdfs:label "publication"@en ;
    ns1:IAO_0000111 "publication"@en ;
    ns1:IAO_0000112 "A journal article or book"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A document that has been accepted by a publisher"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf ns1:IAO_0000310 .

ns1:IAO_0000406 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has y coordinate value"@en ;
    rdfs:domain ns1:IAO_0000400 ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf owl:topDataProperty .

ns1:IAO_0000413 a owl:ObjectProperty ;
    rdfs:label "is duration of"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "relates a process to a time-measurement-datum that represents the duration of the process"@en ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"@en ;
    rdfs:domain ns1:IAO_0000416 ;
    rdfs:range ns1:BFO_0000015 ;
    rdfs:subPropertyOf ns1:IAO_0000136 .

ns1:IAO_0000417 a owl:ObjectProperty ;
    rdfs:label "is quality measured as"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "inverse of the relation of is quality measurement of"@en ;
    ns1:IAO_0000116 "2009/10/19 Alan Ruttenberg. Named 'junk' relation useful in restrictions, but not a real instance relationship"@en ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"@en ;
    owl:equivalentProperty [ owl:inverseOf ns1:IAO_0000221 ] .

ns1:IAO_0000419 a owl:ObjectProperty ;
    rdfs:label "quality is specified as"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "inverse of the relation of is quality specification of"@en ;
    ns1:IAO_0000116 "2009/10/19 Alan Ruttenberg. Named 'junk' relation useful in restrictions, but not a real instance relationship"@en ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"@en,
        "Person:Bjoern Peters"@en ;
    owl:equivalentProperty [ owl:inverseOf ns1:IAO_0000418 ] .

ns1:IAO_0000573 a owl:Class ;
    rdfs:label "line graph"@en ;
    ns1:IAO_0000111 "line graph"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A line graph is a type of graph created by connecting a series of data\\npoints together with a line."@en ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000118 "line chart"@en ;
    ns1:IAO_0000119 "GROUP:OBI"@en,
        "WEB: http://en.wikipedia.org/wiki/Line_chart"@en ;
    rdfs:subClassOf ns1:IAO_0000038 .

ns1:IAO_0000574 a owl:Class ;
    rdfs:label "assigning a centrally registered identifier"@en ;
    ns1:IAO_0000112 "A new pubmed ID being created for a journal article, and the associated pubmed record containing information to the journal article. A license plate number registered at the DMV to be belonging to a specific vehicle and owner. Placing a barcode on a product and entering information in a database that this barcode is assigned."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a planned process in which a new CRID is created, associated with an entity, and stored in the CRID registry thereby registering it as being associated with some entity"@en ;
    ns1:IAO_0000116 "2014-05-05: It is the CRID registry that assigns CRIDs, not the users of the registry."@en ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"@en,
        "Person:Bjoern Peters"@en,
        "Person:Melanie Courtot"@en ;
    ns1:IAO_0000118 "assigning a CRID" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000577 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:IAO_0000579 ],
        ns1:OBI_0000011 .

ns1:IAO_0000594 a owl:Class ;
    rdfs:label "software application"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A software application is software that can be directly executed by some processing unit."@en ;
    ns1:IAO_0000117 "PERSON: Melanie Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    ns1:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:subClassOf ns1:IAO_0000010 .

ns1:IDO_0000586 a owl:Class ;
    rdfs:label "infection"@en ;
    ns1:IAO_0000111 "infection"@en ;
    ns1:IAO_0000115 "A part of an extended organism that itself has as part a population of one or more infectious agents and that (1) exists as a result of processes initiated by members of the infectious agent population and is (2) clinically abnormal in virtue of the presence of this infectious agent population, or (3) has a disposition to bring clinical abnormality to immunocompetent organisms of the same Species as the host (the organism corresponding to the extended organism) through transmission of a member or offspring of a member of the infectious agent population."@en ;
    ns1:IAO_0000412 ns1:ido.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

