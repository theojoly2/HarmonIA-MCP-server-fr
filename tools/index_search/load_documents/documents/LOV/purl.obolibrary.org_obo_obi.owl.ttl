    ns1:IAO_0000111 "immune epitope assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that detects the binding of an epitope to an adaptive immune receptor or a immune response process resulting from such a binding event"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
