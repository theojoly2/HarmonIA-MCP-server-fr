    rdfs:label "exposure to arsenic history" ;
    ns1:IAO_0000111 "exposure to arsenic history" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exposure to environmental and workplace carcinogens history where the carcinogen is arsenic."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "OBIB"^^xsd:string ;
