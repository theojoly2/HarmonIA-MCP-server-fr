ns1:OBI_0000923 a owl:Class ;
    rdfs:label "surface plasmon resonance binding assay" ;
    ns1:IAO_0000111 "surface plasmon resonance binding assay" ;
    ns1:IAO_0000112 "Running a Biacore instrument to measure the affinity, on and off rates of binding of a plate bound antibody to a antigen passing by in flow."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A binding assay that uses the detection of electromagnetic waves in a surface to detect material entities adsorbed to the surface, which change the local optical index of refraction."^^xsd:string ;
