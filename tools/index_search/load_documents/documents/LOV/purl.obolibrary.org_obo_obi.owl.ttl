    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A device that measures and displayes signal voltages, usually as a two-dimensional graph of one or more electrical potential differences (vertical axis) plotted as a function of time or of some other voltage (horizontal axis)."^^xsd:string ;
