                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:OBI_0000411 ] ) ] .

ns1:OBI_0000730 a owl:Class ;
    rdfs:label "pyrosequencing assay" ;
    ns1:IAO_0000111 "pyrosequencing assay" ;
    ns1:IAO_0000112 "Pyrosequencing sheds light on DNA sequencing. PMID:1115661"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A DNA sequencing by synthesis assay which sequences a single strand of DNA by synthesizing the complementary strand along it, one base pair at a time, and detecting which base was actually added at each step. The template DNA is immobilized, and solutions of A, C, G, and T nucleotides are added and removed after the reaction, sequentially. Light is produced only when the nucleotide solution complements the first unpaired base of the template. The sequence of solutions which produce chemiluminescent signals allows the determination of the sequence of the template. ssDNA template is hybridized to a sequencing primer and incubated with the enzymes DNA polymerase, ATP sulfurylase, luciferase and apyrase, and with the substrates adenosine 5-prime phosphosulfate (APS) and luciferin."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "url:http://en.wikipedia.org/wiki/Pyrosequencing"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:unionOf ( ns1:OBI_0000689 ns1:OBI_0000702 ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:OBI_0000689 ns1:OBI_0000702 ) ] ] ) ],
        ns1:OBI_0000734 .

