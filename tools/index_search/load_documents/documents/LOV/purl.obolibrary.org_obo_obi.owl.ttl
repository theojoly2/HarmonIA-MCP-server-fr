ns1:OBI_0002194 a owl:Class ;
    rdfs:label "Microm Ergostar HM200"@en ;
    ns1:IAO_0000111 "Microm Ergostar HM200" ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A microtome that is manufactured by Microm and uses a vertical cutting stroke common to all rotary microtomes engaged by a horizontal sliding movement. An operating arm replaces the handwheel and is attached to both sides of the instrument for greater convenience to permit control of sectioning from the left or right." ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis" ;
    ns1:IAO_0000119 "http://www.ultra-medical.com/Microm-Ergostar-HM200-Microtome/en" ;
    ns1:IAO_0000234 "NCI BBRB" ;
    rdfs:subClassOf ns1:OBI_0400168 .

ns1:OBI_0002196 a owl:Class ;
    rdfs:label "Sakura Low profile Accu-Edge microtome blade"@en ;
    ns1:IAO_0000111 "Sakura Low profile Accu-Edge microtome blade" ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A microtome blade that is manufactured by Feather and is disposable. The ultra-sharp blades section specimens without striations, distortion or chattering." ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis" ;
    ns1:IAO_0000119 "http://www.sakura.eu/Our-products/item/8/Microtomy/29/Accu-Edge-Disposable-Microtome-Blades" ;
    ns1:IAO_0000234 "NCI BBRB" ;
    rdfs:subClassOf ns1:OBI_0002195 .

ns1:OBI_0002197 a owl:Class ;
    rdfs:label "tissue section thickness"@en ;
    ns1:IAO_0000111 "tissue section thickness" ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A length measurement datum that is the result of an assay measuring the thickness of a tissue section." ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis" ;
    ns1:IAO_0000119 "NCI BBRB, OBIB" ;
    ns1:IAO_0000234 "NCI BBRB" ;
    rdfs:subClassOf ns1:IAO_0000408 .

ns1:OBI_0002201 a owl:Class ;
