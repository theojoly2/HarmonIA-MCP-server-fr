        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:CL_0000000 ],
        ns1:OBI_0000094 .

ns1:OBI_0600056 a owl:Class ;
    rdfs:label "protease cleavage"@en ;
    ns1:IAO_0000111 "protease cleavage"@en ;
    ns1:IAO_0000112 "the use of trypsin to cleave pepsin into peptide fragments"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "protease cleavage is an enzymatic cleavage which relies on enzyme with protease activity to act on proteins and produce polypeptides (protein fragments)."@en ;
    ns1:IAO_0000116 "enzymatic digestion"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:CHEBI_16670 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:PR_000000001 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0001025 ;
                                owl:someValuesFrom ns1:BFO_0000040 ] ) ] ],
        ns1:OBI_0000231 .

ns1:OBI_1110010 a owl:Class ;
    rdfs:label "disposition to cause an allergic reaction"@en ;
    ns1:IAO_0000111 "disposition to cause an allergic reaction"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The role borne by a material entity that is realized when it is recognized by the immune system and results in the occurrence of an allergic disease."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "allergenic disposition"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_1110011 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000016 .

ns1:OBI_1110011 a owl:Class ;
    rdfs:label "allergic reaction"@en ;
    ns1:IAO_0000111 "allergic reaction"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "an allergic reaction is an pathologic immune response by an organism to a non-self entity that is normally harmless(the allergen)"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom ns1:OBI_1110010 ],
        ns1:OBI_1110122 .

ns1:OBI_1110015 a owl:Class ;
    rdfs:label "Immunization in vivo"@en ;
    ns1:IAO_0000111 "Immunization in vivo"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Process of administering an object playing the role of immunogen to a living organism"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        ns1:OBI_1110094 .

ns1:OBI_1110016 a owl:Class ;
    rdfs:label "adaptive immune effector function"@en ;
    ns1:IAO_0000111 "adaptive immune effector function"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A function realized as an immune response, which inheres in a T cell, B cell or antibody which derives from or is produced by a cell with prior antigen experience."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:CL_0000084 ns1:CL_0000236 ns1:GO_0042571 ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:GO_0002250 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000034 .

ns1:OBI_1110021 a owl:Class ;
    rdfs:label "infection process"@en ;
    ns1:IAO_0000111 "infection process"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "the detrimental process in which an infectious agent colonizes or replicates in a host environment"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:IDO_0000586 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom ns1:OBI_1110093 ],
        ns1:OBI_1110122 .

ns1:OBI_1110023 a owl:Class ;
    rdfs:label "immunogen"@en ;
    ns1:IAO_0000111 "immunogen"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a material entity bearing the immunogen role"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:OBI_1110082 ] .

ns1:OBI_1110026 a owl:Class ;
    rdfs:label "host of immune response"@en ;
    ns1:IAO_0000111 "host of immune response"^^xsd:string ;
    ns1:IAO_0000112 "A mouse that is vaccinated with a peptide and develops protective immunity. A human exposed to bacteria that are killed by pre-existing immune responses."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An organism in which an immune response process occurs."@en ;
    ns1:IAO_0000116 "In immune response processes in the context of infectious diseases and allergy, there are often multiple organisms involved, which requires calling out the 'host'. This terminology is expanded to allergy, cancer and  transplantation."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_0100026 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0100026 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:OBI_1110083 ] ) ] .

ns1:OBI_1110046 a owl:Class ;
    rdfs:label "organ harvesting"@en ;
    ns1:IAO_0000111 "organ harvesting"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The process of removing an organ from its source organism"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_0600014 .

ns1:OBI_1110082 a owl:Class ;
    rdfs:label "immunogen role"@en ;
    ns1:IAO_0000111 "immunogen role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "any entity capable of eliciting an immune response when introduced to components of the immune system"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_1110083 a owl:Class ;
    rdfs:label "host of immune response role"@en ;
    ns1:IAO_0000111 "host of immune response role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a role borne by an organism. It is realized by the organism during an immunization or an immune response taking place inside or on the surface of the organism, and in which the responding or stimulated immune system is part of the host."@en ;
    ns1:IAO_0000116 "03/21/2010: This sense of 'host' is used not only in infectious diseases but also allergy, cancer, transplantation, etc. which is why it is needed separately from the 'host of infectious agent' meaning, which will be imported from IDO."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:GO_0006955 ns1:OBI_1110015 ) ] ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000023 .

ns1:OBI_1110094 a owl:Class ;
    rdfs:label "immunization"@en ;
    ns1:IAO_0000111 "immunization"^^xsd:string ;
    ns1:IAO_0000112 "Infection with influenza (the immunogen) leading to B cells producing antibodies (the effector function) against surface regions of the HA protein (the epitope)."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The process of an epitope that is part of or derived from an immunogen coming into contact with adaptive immune cells resulting in these cells acquiring immune effector functions specific for the epitope."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:GO_0008150 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:GO_0008150 [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:RO_0000057 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_1110001 [ a owl:Restriction ;
                                                        owl:onProperty ns1:BFO_0000050 ;
                                                        owl:someValuesFrom ns1:OBI_1110023 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:RO_0000057 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_1110001 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0001000 ;
                                                        owl:someValuesFrom ns1:OBI_1110023 ] ) ] ] ) ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_1110014 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom ns1:OBI_1110082 ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000057 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Class ;
                                            owl:unionOf ( ns1:CL_0000084 ns1:CL_0000236 ) ] [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000085 ;
                                            owl:someValuesFrom ns1:OBI_1110016 ] ) ] ] ) ] .

