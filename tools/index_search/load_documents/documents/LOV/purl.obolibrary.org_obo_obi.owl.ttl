                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:OBI_0001140 ] ) ],
        ns1:OBI_0000047 .

ns1:OBI_0002464 a owl:Class ;
    rdfs:label "SRS identifier"@en ;
    ns1:IAO_0000111 "SRS identifier"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An accession number that applies to a database record for an individual sample object in an NCBI Sequence Read Archive (SRA) submission. These records are imported from the NCBI BioSample database."@en ;
    ns1:IAO_0000117 "Stephen Fisher, Dan Berrios"@en ;
    ns1:IAO_0000118 "SRA sample accession number"@en ;
    rdfs:subClassOf ns1:IAO_0000577 .

ns1:OBI_0002465 a owl:Class ;
    rdfs:label "age since culture seeding measurement datum" ;
    ns1:IAO_0000111 "age since culture seeding measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of a cell since cultured (the process of seeding cells onto a culture dish)." ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios" ;
    ns1:IAO_0000118 "age of culture" ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0002467 a owl:Class ;
    rdfs:label "alignment counting application"@en ;
    ns1:IAO_0000111 "alignment counting application"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A software application that implements an alignment counting algorithm, used to count the overlap of aligned sequencing reads with genes."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    ns1:IAO_0000119 "doi:10.1093/bioinformatics/btu638"@en ;
    rdfs:subClassOf ns1:IAO_0000594 .

ns1:OBI_0002468 a owl:Class ;
    rdfs:label "base calling algorithm"@en ;
    ns1:IAO_0000111 "base calling algorithm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An algorithm that assigns nucleotides to temporal or spatial peaks generated by a detector, such as peaks of light intensities generated by a DNA sequencer"@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:IAO_0000064 .

ns1:OBI_0002470 a owl:Class ;
    rdfs:label "bcl2fastq software application"@en ;
    ns1:IAO_0000111 "bcl2fastq software application"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A base calling application that implments a base calling algorithm to convert BCL (binary base call) files generated by Illumina sequencing systems to standard FASTQ file formats for downstream analysis."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
