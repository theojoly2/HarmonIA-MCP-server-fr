ns1:OBI_0002327 a ns1:OBI_0002326,
        owl:NamedIndividual ;
    rdfs:label "Stage IA (FIGO)" ;
    ns1:IAO_0000111 "Stage IA (FIGO)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An International Federation of Gynecology and Obstetrics cervical cancer stage value specification indicating invasive carcinoma which can be diagnosed only by microscopy, with deepest invasion <5 mm and the largest extension <7 mm."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Stage IA"^^xsd:string ;
    ns1:IAO_0000119 "https://en.wikipedia.org/wiki/Cervical_cancer_staging"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002328 a ns1:OBI_0002326,
        owl:NamedIndividual ;
    rdfs:label "Stage IA1 (FIGO)" ;
    ns1:IAO_0000111 "Stage IA1 (FIGO)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An International Federation of Gynecology and Obstetrics cervical cancer stage value specification indicating measured stromal invasion of <3.0 mm in depth and extension of <7.0 mm."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Stage IA1"^^xsd:string ;
    ns1:IAO_0000119 "https://en.wikipedia.org/wiki/Cervical_cancer_staging"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

