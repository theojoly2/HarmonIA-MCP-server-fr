ns1:OBI_0001064 a owl:Class ;
    rdfs:label "automatic tissue processor"^^xsd:string ;
    ns1:IAO_0000111 "automatic tissue processor"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A device for processing histological tissue having a tissue carrier basket suspended from a turntable overlying a plurality of beakers suspended from a carrier plate. The turntable is raised, indexed, and lowered by a suitable driving mechanism to move the tissue basket sequentially through the beakers. Timers can each be programmed to control the movement of the turntable to provide various different cycles for processing the tissue. Some of the beakers are received in individual thermal baths to heat and control the temperature of the substances received in the beakers for treating the tissue."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Erik Segerdell"^^xsd:string ;
    ns1:IAO_0000119 "United States Patent 3762362"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000960 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000379 ],
        ns1:OBI_0000968 .

