    rdfs:label "exposure to diesel exhaust history" ;
    ns1:IAO_0000111 "exposure to diesel exhaust history" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exposure to environmental and workplace carcinogens history where the carcinogen is diesel exhaust."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002415 .

ns1:OBI_0002419 a owl:Class ;
    rdfs:label "exposure to chromium history" ;
    ns1:IAO_0000111 "exposure to chromium history" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exposure to environmental and workplace carcinogens history where the carcinogen is chromium."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002415 .

ns1:OBI_0002420 a owl:Class ;
    rdfs:label "exposure to silica history" ;
    ns1:IAO_0000111 "exposure to silica history" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exposure to environmental and workplace carcinogens history where the carcinogen is silica."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002415 .

ns1:OBI_0002421 a owl:Class ;
    rdfs:label "indicator of whether an inclusion criterion was met" ;
    ns1:IAO_0000111 "indicator of whether an inclusion criterion was met" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An information content entity that indicates whether or not  an entity has met a specific requirement in order to take part in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "eligibility criterion met"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0002422 a owl:Class ;
    rdfs:label "indicator of whether all inclusion criteria were met" ;
    ns1:IAO_0000111 "indicator of whether all inclusion criteria were met" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An information content entity  that indicates whether or not  an entity  has met all specific requirements in order to take part in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "all eligibility criteria met"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0002423 a owl:Class ;
    rdfs:label "age of majority inclusion criterion" ;
    ns1:IAO_0000111 "age of majority inclusion criterion" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An inclusion criterion that uses the age of majority for a state or institution, where one is generally considered to be an adult, which if met, makes an individual suitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002424 a owl:Class ;
    rdfs:label "chemotherapy treatment exclusion criterion" ;
    ns1:IAO_0000111 "chemotherapy treatment exclusion criterion" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion that defines whether chemotherapy was received or is being received for a previous  or current cancer, which when met, makes an individual unsuitable for a given task or participation in a given process"^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002425 a owl:Class ;
    rdfs:label "radiation treatment exclusion criteria" ;
    ns1:IAO_0000111 "radiation treatment exclusion criteria" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion that defines whether radiation was received or is being received for a previous  or current cancer, which when met, makes an individual unsuitable for a given task or participation in a given process"^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002426 a owl:Class ;
    rdfs:label "chemotherapy treatment within the recent past exclusion criterion" ;
    ns1:IAO_0000111 "chemotherapy treatment within the recent past exclusion criterion" ;
    ns1:IAO_0000112 "An exclusion criterion defined by the pathologist is defined as whether the individual received chemotherapy within the last two years. "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion that defines whether chemotherapy was received within a certain timeframe, which when met, makes an individual unsuitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002427 a owl:Class ;
    rdfs:label "radiation treatment within the recent past exclusion criterion" ;
    ns1:IAO_0000111 "radiation treatment within the recent past exclusion criterion" ;
    ns1:IAO_0000112 "An exclusion criterion defined by the pathologist is defined as whether the individual received  radiation therapy within the last two years. "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion that defines whether radiation was received within a certain timeframe, which when met, makes an individual unsuitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002428 a owl:Class ;
    rdfs:label "BMI range inclusion criterion" ;
    ns1:IAO_0000111 "BMI range inclusion criterion" ;
    ns1:IAO_0000112 "An important inclusion criterion is for for the individual to have a BMI between 18.5 and 35.0"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states a Body Mass Index range, which if met, makes an individual suitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002429 a owl:Class ;
    rdfs:label "blood transfusion exclusion criterion" ;
    ns1:IAO_0000111 "blood transfusion exclusion criterion" ;
    ns1:IAO_0000112 "An exclusion criterion that is defined by whether the specimen donor received a whole blood transfusion within 48 hours prior to death."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion that is defined by whether the specimen donor received a whole blood transfusion within a specified time frame prior to death, which if met, makes a specimen donor unsuitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002430 a owl:Class ;
    rdfs:label "history of metastatic cancer exclusion criterion" ;
    ns1:IAO_0000111 "history of metastatic cancer exclusion criterion" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion defined as whether an individual has ever been diagnosed with metastatic cancer (cancer that spread beyond the initial site such as to other organs like brain bone or liver), which if met, makes the individual unsuitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002431 a owl:Class ;
    rdfs:label "intravenous drug use exclusion criterion" ;
    ns1:IAO_0000111 "intravenous drug use exclusion criterion" ;
    ns1:IAO_0000112 "Donor eligibility based on history of intravenous drug abuse in the last 5 years."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion defined as when an individual has a history of intravenous drug abuse for a specific timeframe, which if met, makes the individual unsuitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002432 a owl:Class ;
    rdfs:label "history of sex with someone with a history of blood borne infection  exclusion criterion" ;
    ns1:IAO_0000111 "history of sex with someone with a history of blood borne infection  exclusion criterion" ;
    ns1:IAO_0000112 "Donor eligibility based on whether the donor has a history of sex with someone who has been diagnosed or at risk for HIV/AIDS and/or HCV and/or HBV in the last 5 years."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion defined  as whether an individual has a history of sex with someone who has been diagnosed or at risk for a blood borne infections disease in a specified time frame, which if met, makes the individual unsuitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002433 a owl:Class ;
    rdfs:label "history of sex with someone with a history of intravenous drugs exclusion criterion" ;
    ns1:IAO_0000111 "history of sex with someone with a history of intravenous drugs exclusion criterion" ;
    ns1:IAO_0000112 "Donor eligibility based on whether the donor has a history of sex with someone who has used intravenous drugs in the last 5 years."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion defined  as whether an individual has a history of sex with someone who has used intravenous drugs in a specified time frame, which if met, makes the individual unsuitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002434 a owl:Class ;
    rdfs:label "HIV exclusion criterion" ;
    ns1:IAO_0000111 "HIV exclusion criterion" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion defined  as whether an individual has a history of repeatedly reactive screening assays for HIV-1 or HIV-2 antibody regardless of the results of supplemental assays, which if met, makes the individual unsuitable for a given task or participation in a given process. "^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002435 a owl:Class ;
    rdfs:label "exposure to blood borne infectious disease exclusion criterion" ;
    ns1:IAO_0000111 "exposure to blood borne infectious disease exclusion criterion" ;
    ns1:IAO_0000112 "Donor eligibility based on whether the donor has been exposed to HIV/AIDS. "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exclusion criterion defined  as whether an individual has been exposed to a blood borne infections disease through needle sticks and/or contact with non-intact skin and/or contact with open wounds and/or contact with mucous membranes, which if met, makes the individual unsuitable for a given task or participation in a given process."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500028 .

ns1:OBI_0002436 a owl:Class ;
    rdfs:label "RNA interactome capture" ;
    ns1:IAO_0000111 "RNA interactome capture" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that identifies RNA binding proteins by cross-linking RNA and proteins with UV light, then purifying the bound complexes by oligo(dT) capture. Finally, the complexes are analyzed by mass spectrometry."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "PMID:26463381"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000470 ],
        ns1:OBI_0000070 .

ns1:OBI_0002437 a owl:Class ;
    rdfs:label "widefield microscopy" ;
    ns1:IAO_0000111 "widefield microscopy" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A fluorescence microscopy technique where the specimen under investigation is fully bathed in light, as opposed to confocal microscopy in which only a small portion of the specimen is illuminated."^^xsd:string ;
    ns1:IAO_0000117 "Jie Zheng"^^xsd:string ;
    ns1:IAO_0000118 "WFM"^^xsd:string ;
    ns1:IAO_0000119 "url:http://bitesizebio.com/19409/the-many-flavors-of-widefield-microscopy/"^^xsd:string,
        "url:https://svi.nl/WideFieldMicroscope"^^xsd:string ;
    rdfs:subClassOf ns1:CHMO_0000087 .

ns1:OBI_0002441 a owl:Class ;
    rdfs:label "physical examination of individual" ;
    ns1:IAO_0000111 "physical examination of individual" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An assay that produces a description of the qualities of an entity that has not been transformed, through observation and physical, non-invasive techniques."^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 .

ns1:OBI_0002443 a owl:Class ;
    rdfs:label "methidiumpropyl-EDTA-iron(II) footprinting assay" ;
    ns1:IAO_0000111 "methidiumpropyl-EDTA-iron(II) footprinting assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A footprinting assay that determines protein-binding sites on DNA by partial cleavage of ligand-protected DNA restriction fragments with methidium-propyl-EDTA (MPE). MPE-Fe(II) in the presence of oxygen efficiently catalyzes the non-specific clevage of DNA."^^xsd:string ;
    ns1:IAO_0000117 "Jie Zheng"^^xsd:string ;
    ns1:IAO_0000118 "MPE-Fe(II) footprinting"^^xsd:string ;
    ns1:IAO_0000119 "PMID:6225070"^^xsd:string,
        "PMID:6435669"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001181 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:OBI_0001051 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0001051 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
