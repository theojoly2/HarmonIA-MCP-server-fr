ns1:OBI_0200001 a owl:Class ;
    rdfs:label "geometric mean calculation"@en ;
    ns1:IAO_0000111 "geometric mean calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    ns1:IAO_0000119 "PERSON: Mathias Brochhausen"@en ;
    rdfs:comment "A geometric mean calculation is a descriptive statistics calculation in which the mean is calculated by taking the nth root of the product of all of the observations in a data (n being the number of all observations)."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000674 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200177 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        ns1:OBI_0200181,
        ns1:OBI_0200184 .

ns1:OBI_0200002 a owl:Class ;
    rdfs:label "logistic-log curve fitting"@en ;
    ns1:IAO_0000111 "logistic-log curve fitting"@en ;
    ns1:IAO_0000112 "Typically used in an enzyme-linked immunosorbent assay (ELISA) to model the relationship between optical density (OD) and dilution. In this case a and d correspond to the theoretical OD of the assay at zero and infinite concentrations, respectively; c is the dilution associated with the point of symmetry of the sigmoid and is located at the midpoint of the assay found at the inflection point of the curve; b is a curvature parameter and is related to the slope of the curve."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A logistic-log curve fitting is a curve fitting where a curve of the form y=d+((a-d)/(1+(x/c)^b)) is obtained, where a, b, c, and d are determined so to optimize its fit to the input data points (x_1, y_1), (x_2, y_2), ..., (x_n, y_n)."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "ARTICLE: Plikaytis B.D. et al. (1991), J. Clin. Microbiol. 29(7): 1439-1448"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200174 ],
        ns1:OBI_0200072 .

ns1:OBI_0200003 a owl:Class ;
    rdfs:label "logit-log curve fitting"@en ;
    ns1:IAO_0000111 "logit-log curve fitting"@en ;
    ns1:IAO_0000112 "Typically used in an enzyme-linked immunosorbent assay (ELISA) to model the relationship between optical density (OD) and dilution. In this case OD_0 (also referred to OD_min) and OD_infty (also referred to OD_max) correspond to the theoretical OD of the assay at zero and infinite concentrations, respectively."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A logit-log curve fitting is a curve fitting where first the limits y_0 an y_infty of y when x->0 and x->infinity, respectively, are estimated from the input data points (x_1, y_1), (x_2,y_2), ..., (x_n, y_n). Then a curve with equation log((y-y_0)/(y_infty-y))=a+b log(x) is obtained, where a and b are determined to optimize its fit to the input data points."@en ;
    ns1:IAO_0000116 "The above definition refers to the 'fully specified' logit-log model. The reduced form of this, when it is assumed that y_0=0, is named 'partially specified' logit-log model."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "ARTICLE: Plikaytis B.D. et al. (1991), J. Clin. Microbiol. 29(7): 1439-1448"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200174 ],
        ns1:OBI_0200072 .

ns1:OBI_0200004 a owl:Class ;
    rdfs:label "log-log curve fitting"@en ;
    ns1:IAO_0000111 "log-log curve fitting"@en ;
    ns1:IAO_0000112 "Typically used in an enzyme-linked immunosorbent assay (ELISA) to model the relationship between optical density (OD) and dilution."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A log-log curve fitting is a curve fitting where first a logarithmic transformation is applied both to the x and the y coordinates of the input data points (x_1, y_1), (x_2, y_2), ..., (x_n, y_n), and then coefficients a and b are determined to optimize the fit of log(y)=a+b*log(x) to these input data points."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "ARTICLE: Plikaytis B.D. et al. (1991), J. Clin. Microbiol. 29(7): 1439-1446"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200174 ],
        ns1:OBI_0200072 .

ns1:OBI_0200006 a owl:Class ;
    rdfs:label "biexponential transformation"@en ;
    ns1:IAO_0000111 "biexponential transformation"@en ;
    ns1:IAO_0000112 "This type of transformation is typically used in flow cytometry."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A biexponential transformation is a data transformation that, for each (one dimensional) real number input x, outputs an approximation (found, e.g. with the Newton's method) to a solution y of the equation B(y)-x=0, where B denotes a b transformation."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Joseph Spliden"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000451 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200167 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200174 ],
        ns1:OBI_0200072,
        ns1:OBI_0200169 .

ns1:OBI_0200007 a owl:Class ;
    rdfs:label "box-cox transformation"@en ;
    ns1:IAO_0000111 "box-cox transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A box-cox transformation is a data transformation according to the methods of Box and Cox as described in the article Box, G. E. P. and Cox, D.R. (1964) An analysis of transformations. Journal of Royal Statistical Society, Series B, vol. 26, pp. 211-246."@en ;
    ns1:IAO_0000117 "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "ARTICLE: Box, G. E. P. and Cox, D.R. (1964), \"An analysis of transformations\", Journal of Royal Statistical Society, Series B, vol. 26, pp. 211-246."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200008 a owl:Class ;
    rdfs:label "hyperlog transformation"@en ;
    ns1:IAO_0000111 "hyperlog transformation"@en ;
    ns1:IAO_0000112 "This type of transformation is typically used in flow cytometry"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A hyperlog transformation ia a data transformation that, for each (one dimensional) real number input x, outputs an approximation (found, e.g. with the Newton's method) to a solution y of the equation EH(y)-x=0, where EH denotes an eh transformation."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Joseph Spliden"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "ARTICLE: Bagwell C.B. (2006), \"Hyperlog - a flexible log-like  transform for negative, zero, and positive valued data\", Cytometry A 64, 34-42.\""@en,
        "http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200010 a owl:Class ;
    rdfs:label "loess scale group transformation one-channel"@en ;
    ns1:IAO_0000111 "loess scale group transformation one-channel"@en ;
    ns1:IAO_0000112 "Loess scale group normalization applied to data from two one-channel expression microarray assays."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess scale group transformation one-channel is a loess scale group transformation consisting in the application of a scale adjustment following a loess group transformation one-channel, to render the M group variances similar."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "OTHER: Editor's adjustment based on MGED Ontology term"@en ;
    rdfs:subClassOf ns1:OBI_0200025 .

ns1:OBI_0200011 a owl:Class ;
    rdfs:label "logical transformation"@en ;
    ns1:IAO_0000111 "logical transformation"@en ;
    ns1:IAO_0000112 "This type of transformation is typically used in flow cytometry."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A logical transformation is a data transformation that, for each (one dimensional) real number input x, outputs an approximation (found, e.g. with the Newton's method) to a solution y of the equation S(y)-x=0, where S denotes an s transformation."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Joseph Spliden"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200012 a owl:Class ;
    rdfs:label "loess scale group transformation two-channel"@en ;
    ns1:IAO_0000111 "loess scale group transformation two-channel"@en ;
    ns1:IAO_0000112 "Loess scale group normalization applied to data from a two-channel expression microarray assay."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess scale group transformation two-channel is a loess scale group transformation consisting in the application of a scale adjustment following a loess group transformation two-channel, to render the M group variances similar."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "OTHER: Adjusted from MGED Ontology"@en ;
    rdfs:subClassOf ns1:OBI_0200025 .

ns1:OBI_0200013 a owl:Class ;
    rdfs:label "loess global transformation one-channel"@en ;
    ns1:IAO_0000111 "loess global transformation one-channel"@en ;
    ns1:IAO_0000112 "Loess global normalization applied to data from two one-channel expression microarray assays, where the curve is obtained using all reporters. The goal is to remove intensity-dependent biases."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess global transformation one-channel is a loess global transformation in the special case where the input is the result of an MA transformation applied to intensities from two related one-channel assays."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "OTHER: Editor's generalization based on MGED Ontology term"@en ;
    rdfs:subClassOf ns1:OBI_0200023 .

ns1:OBI_0200014 a owl:Class ;
    rdfs:label "split-scale transformation"@en ;
    ns1:IAO_0000111 "split-scale transformation"@en ;
    ns1:IAO_0000112 "This type of transformation is typically used in flow cytometry"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A split-scale transformation is a data transformation which is an application of a function f described as follows to a (one dimensional) real number input. f(x)=a*x+b if x=for x>t; where log denotes a logarithmic transformation and a, b, c, d, r, t are real constants, with a, c, d, r, t positive, chosen so that f is continuous with a continuous derivative at the transition point t."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Joseph Spliden"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200015 a owl:Class ;
    rdfs:label "loess global transformation two-channel"@en ;
    ns1:IAO_0000111 "loess global transformation two-channel"@en ;
    ns1:IAO_0000112 "Loess global normalization applied to data from a two-channel expression microarray assay, where the curve is obtained using all reporters. The goal is to remove intensity-dependent biases."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess global transformation two-channel is a loess global transformation in the special case where the input the result of an MA transformation applied to intensities from the two channels of a two-channel assay."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "OTHER: Editor's generalization based on MGED Ontology term"@en ;
    rdfs:subClassOf ns1:OBI_0200023 .

ns1:OBI_0200016 a owl:Class ;
    rdfs:label "sine transformation"@en ;
    ns1:IAO_0000111 "sine transformation"@en ;
    ns1:IAO_0000112 "sine(0)=0, sine(pi/2)=1, sine(pi)=0, sine(3*pi/2)=-1, sine(pi/6)=1/2, sine(x+2*k*pi)=sine(x) where k is any integer, etc."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A sine transformation is a data transformation which consists in applying the sine function to a (one dimensional) real number input. The sine function is one of the basic trigonometric functions and a definition is provided, e.g., at http://mathworld.wolfram.com/Sine.html."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "WEB: http://mathworld.wolfram.com/Sine.html"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200017 a owl:Class ;
    rdfs:label "cosine transformation"@en ;
    ns1:IAO_0000111 "cosine transformation"@en ;
    ns1:IAO_0000112 "cosine(0)=1, cosine(pi/2)=0, cosine(pi)=-1, cosine(3*pi/2)=0, cosine(pi/3)=1/2, cosine(x+2*k*pi)=cosine(x) where k is any integer, etc."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A cosine transformation is a data transformation which consists in applying the cosine function to a (one dimensional) real number input. The cosine function is one of the basic trigonometric functions and a definition is provided, e.g., at http://mathworld.wolfram.com/Cosine.html."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "WEB: http://mathworld.wolfram.com/Cosine.html"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200018 a owl:Class ;
    rdfs:label "loess group transformation one-channel"@en ;
    ns1:IAO_0000111 "loess group transformation one-channel"@en ;
    ns1:IAO_0000112 "A loess group transformation one-channel is a loess group transformation in the special case where the input is the result of an MA transformation applied to intensities from two related one-channel assays."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess group transformation one-channel is a loess group transformation in the special case where the input is the result of an MA transformation applied to intensities from two related one-channel assays."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "OTHER: Editor's generalization based on MGED Ontology term"@en ;
    rdfs:subClassOf ns1:OBI_0200024 .

ns1:OBI_0200019 a owl:Class ;
    rdfs:label "loess group transformation two-channel"@en ;
    ns1:IAO_0000111 "loess group transformation two-channel"@en ;
    ns1:IAO_0000112 "A loess group transformation two-channel is a loess group transformation in the special case where the input is the result of an MA transformation applied to intensities from the two channels of a two-channel assay."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess group transformation two-channel is a loess group transformation in the special case where the input is the result of an MA transformation applied to intensities from the two channels of a two-channel assay."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "OTHER: Editor's generalization based on MGED Ontology term"@en ;
    rdfs:subClassOf ns1:OBI_0200024 .

ns1:OBI_0200020 a owl:Class ;
    rdfs:label "homogeneous polynomial transformation"@en ;
    ns1:IAO_0000111 "homogeneous polynomial transformation"@en ;
    ns1:IAO_0000112 "a*x, with a non-zero, is a homogeneous polynomial of degree 1 in 1 variable, a*x^2, with a non-zero, is a homogeneous polynomial of degree 2 in 1 variable; a_1*x_1+...+a_n*x_n, with at least one of the a_i's non-zero, is a homogeneous polynomial of degree one in n variables; a*x_n^3+b*x_1*x_2*x_3, with at least one of a and b non-zero, is a homogeneous polynomial of degree 3 in n variables."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A homogeneous polynomial transformation is a polynomial transformation where all the term of the polynomial have the same degree."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "WEB: http://mathworld.wolfram.com/HomogeneousPolynomial.html"@en ;
    rdfs:subClassOf ns1:OBI_0200093 .

ns1:OBI_0200021 a owl:Class ;
    rdfs:label "linlog transformation"@en ;
    ns1:IAO_0000111 "linlog transformation"@en ;
    ns1:IAO_0000112 "This can be used for microarray normalization, e.g. to normalize the data from a two-channel expression microarray assay, as described in PMID 16646782."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A linlog transformation is a data transformation, described in PMID 16646782, whose input is a matrix [y_ik] and whose output is a matrix obtained by applying formula (9) of this paper, where values below an appropriately determined threshold (dependent on the row i) are transformed via a polynomial of degree 1, and values above this threshold are transformed via a logarithm."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "PMID: 16646782"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200022 a owl:Class ;
    rdfs:label "variance stabilizing transformation"@en ;
    ns1:IAO_0000111 "variance stabilizing transformation"@en ;
    ns1:IAO_0000112 "This can be used for expression microarray assay normalization and it is referred to as \"variance stabilizing normalization\", according to the procedure described e.g. in PMID 12169536."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A variance stabilizing transformation is a data transformation, described in PMID 12169536, whose input is a matrix [y_ik] and whose output is a matrix obtained by applying formula (6) in this paper. One of the goals is to obtain an output matrix whose rows have equal variances. The method relies on various assumptions described in the paper."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000118 "variance stabilising transformation"@en ;
    ns1:IAO_0000119 "PMID: 12169536"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200026 a owl:Class ;
    rdfs:label "total intensity transformation single"@en ;
    ns1:IAO_0000111 "total intensity transformation single"@en ;
    ns1:IAO_0000112 "This can be used as a simple normalization method for expression microarray assays. For example, each intensity from a one-channel microarray assay is multiplied by a constant so that the output mean intensity over the microarray equals a desired target T (the multiplicative constant in this case is the T/(mean intensity))."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A total intensity transformation single is a data transformation that takes as input an n-dimensional (real) vector and multiplies each component of this vector by a coefficient, where the coefficient is obtained by taking the sum of the input components or of a subset of these, multiplied by a constant of choice."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en,
        "Helen Parkinson"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000119 "OTHER: Adjusted from MGED Ontology"@en ;
    ns1:IAO_0000232 "Note that if the word \"sum\" is replaced by the word \"mean\" in the definition, the resulting definition is equivalent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200027 a owl:Class ;
    rdfs:label "total intensity transformation paired"@en ;
    ns1:IAO_0000111 "total intensity transformation paired"@en ;
    ns1:IAO_0000112 "This can be used as a simple normalization method for the two channels from a two-channel expression microarray assay or from two related one-channel expression microarray assays."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A total intensity transformation paired is a data transformation that takes as input two n-dimensional (real) vectors and multiplies each component of the first vector by a coefficient, where the coefficient is obtained by taking the ratio of the sum of the second input components or of a subset of these by the sum of the first input components or of a subset of these (the same subset is used for the two vectors)."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "OTHER: Adjusted from MGED Ontology"@en ;
    ns1:IAO_0000232 "Note that if the word \"sum\" is replaced by the word \"mean\" in the definition, the resulting definition is equivalent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200028 a owl:Class ;
    rdfs:label "quantile transformation"@en ;
    ns1:IAO_0000111 "quantile transformation"@en ;
    ns1:IAO_0000112 "This can be used for expression microarray assay normalization and it is referred to as \"quantile normalization\", according to the procedure described e.g. in PMID 12538238."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A quantile transformation is a data transformation that takes as input a collection of data sets, where each can be thought as an n-dimensional (real) vector, and which transforms each data set so that the resulting output data sets have equal quantiles."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000674 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200177 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169,
        ns1:OBI_0200181 .

ns1:OBI_0200030 a owl:Class ;
    rdfs:label "median centering"@en ;
    ns1:IAO_0000111 "median centering"@en ;
    ns1:IAO_0000112 "This can be used as a normalization method in expression microarray assays. For example, given a two-channel microarray assay, the log ratios of the two channels (M values) can be median-centered."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A median centering is a data transformation that takes as input an n-dimensional (real) vector, performs a median calculation on its components, and subtracts the resulting median from each component of the input."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en ;
    ns1:IAO_0000118 "median centring"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200032 a owl:Class ;
    rdfs:label "K-fold cross validation method"@en ;
    ns1:IAO_0000111 "K-fold cross validation method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "K-fold cross-validation randomly partitions the original sample into K subsamples. Of the K subsamples, a single subsample is retained as the validation data for testing the model, and the remaining K - 1 subsamples are used as training data. The cross-validation process is then repeated K times (the folds), with each of the K subsamples used exactly once as the validation data. The K results from the folds then can be averaged (or otherwise combined) to produce a single estimation. The advantage of this method over repeated random sub-sampling is that all observations are used for both training and validation, and each observation is used for validation exactly once. 10-fold cross-validation is commonly used"^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000119 "Tina Boussard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200188 ],
        ns1:OBI_0000792 .

ns1:OBI_0200034 a owl:Class ;
    rdfs:label "jackknifing method"@en ;
    ns1:IAO_0000111 "jackknifing method"^^xsd:string ;
    ns1:IAO_0000112 "simple weighting procedure is suggested for combining information over alleles and loci, and sample variances may be estimated by a jackknife procedure"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Jacknifing is a re-sampling data transformation process used to estimate the precision of sampling statistics and is a resampling method"^^xsd:string ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000118 "jackknifing"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Resampling_%28statistics%29"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200188 ],
        ns1:OBI_0000792 .

ns1:OBI_0200035 a owl:Class ;
    rdfs:label "boostrapping"@en ;
    ns1:IAO_0000111 "boostrapping"@en ;
    ns1:IAO_0000112 "Although widely accepted that high throughput biological data are typically highly noisy, the effects that this uncertainty has upon the conclusions we draw from these data are often overlooked. However, in order to assign any degree of confidence to our conclusions, we must quantify these effects. Bootstrap resampling is one method by which this may be achieved."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Bootstrapping is a statistical method for estimating the sampling distribution of a statistic by sampling with replacement from the original data, most often with the purpose of deriving robust estimates of standard errors and confidence intervals of a population parameter like a mean, median, proportion, odds ratio, correlation coefficient or regression coefficient"@en ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000119 "Bootstrapping is a data transformation process which estimates the precision of sampling statistics by drawing randomly with replacement from a set of data points"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200188 ],
        ns1:OBI_0000792 .

ns1:OBI_0200036 a owl:Class ;
    rdfs:label "Benjamini and Hochberg false discovery rate correction method"@en ;
    ns1:IAO_0000111 "Benjamini and Hochberg false discovery rate correction method"@en ;
    ns1:IAO_0000112 "Statistical significance of the 8 most represented biological processes (GO level 4) among E7 6 month upregulated genes following analysis with DAVID software; Benjamini-Hochberg FDR (false discovery rate)"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A data transformation process in which the Benjamini and Hochberg method sequential p-value procedure  is applied with the aim of correcting false discovery rate"^^xsd:string ;
    ns1:IAO_0000116 "2011-03-31: [PRS]. \\nspecified input and output of dt which were missing"@en ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "Helen Parkinson"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000662 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000175 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000791 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001442 ],
        ns1:OBI_0200163 .

ns1:OBI_0200037 a owl:Class ;
    rdfs:label "pareto scaling"@en ;
    ns1:IAO_0000111 "pareto scaling"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A pareto scaling is a data transformation that divides all measurements of a variable by the square root of the standard deviation of that variable."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "PMID:16762068"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200040 a owl:Class ;
    rdfs:label "modular decomposition"@en ;
    ns1:IAO_0000111 "modular decomposition"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Molecular decomposition is the partition of a network into distinct subgraphs for the purpose of identifying functional clusters. The network data is run through any of several existing algorithms designed to partition a network into distinct subgraphs for the purpose of isolating groups of functionally linked biological elements such as proteins."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "editor"@en ;
    rdfs:subClassOf ns1:OBI_0200080 .

ns1:OBI_0200043 a owl:Class ;
    rdfs:label "average linkage hierarchical clustering"@en ;
    ns1:IAO_0000111 "average linkage hierarchical clustering"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An average linkage hierarchical clustering is an agglomerative hierarchical clustering which generates successive clusters based on a distance measure, where the distance between two clusters is calculated as the average distance between objects from the first cluster and objects from the second cluster."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf ns1:OBI_0200154 .

ns1:OBI_0200044 a owl:Class ;
    rdfs:label "complete linkage hierarchical clustering"@en ;
    ns1:IAO_0000111 "complete linkage hierarchical clustering"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "an agglomerative hierarchical clustering which generates successive clusters based on a distance measure, where the distance between two clusters is calculated as the maximum distance between objects from the first cluster and objects from the second cluster."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf ns1:OBI_0200154 .

ns1:OBI_0200045 a owl:Class ;
    rdfs:label "single linkage hierarchical clustering"@en ;
    ns1:IAO_0000111 "single linkage hierarchical clustering"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A single linkage hierarchical clustering is an agglomerative hierarchical clustering which generates successive clusters based on a distance measure, where the distance between two clusters is calculated as the minimum distance between objects from the first cluster and objects from the second cluster."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf ns1:OBI_0200154 .

ns1:OBI_0200049 a owl:Class ;
    rdfs:label "Benjamini and Yekutieli false discovery rate correction method"@en ;
    ns1:IAO_0000111 "Benjamini and Yekutieli false discovery rate correction method"@en ;
    ns1:IAO_0000112 "The expression set was compared univariately between the stroke patients and controls, gene list was generated using False Discovery Rate correction (Benjamini and Yekutieli)"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A data transformation in which the Benjamini and Yekutieli method is applied with the aim of correcting false discovery rate"^^xsd:string ;
    ns1:IAO_0000116 "2011-03-31: [PRS]. \\nspecified input and output of dt which were missing"@en ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "Helen Parkinson"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000662 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001442 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000791 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000175 ],
        ns1:OBI_0200163 .

ns1:OBI_0200053 a owl:Class ;
    rdfs:label "expectation maximization"@en ;
    ns1:IAO_0000111 "expectation maximization"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "EM is a probabilistic algorithm used to estimate the maximum likelihood of parameters from existing data where the model involves unobserved latent variables. The input to this method is the data model for which the estimation is performed over and the output is an approximated probability function."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200052 .

ns1:OBI_0200054 a owl:Class ;
    rdfs:label "global modularity calculation"@en ;
    ns1:IAO_0000111 "global modularity calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network graph quality calculation in which an input data set of subgraph modules and their in-degree and out-degree qualities is used to calculate the average modularity of subgraphs within the network."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200147 .

ns1:OBI_0200055 a owl:Class ;
    rdfs:label "dye swap merge"@en ;
    ns1:IAO_0000111 "dye swap merge"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A dye swap merge is a replicate analysis which takes as input data from paired two-channel microarray assays where the sample labeled with one dye in the first assay is labeled with the other dye in the second assay and vice versa. The output for each reporter is obtained by combining its (raw or possibly pre-processed) M values in the two assays, where the M value in an assay is defined as the difference of the log intensities in the two channels. This can be used as a normalization step, when appropriate assumptions are met."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en,
        "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200057 .

ns1:OBI_0200056 a owl:Class ;
    rdfs:label "moving average"@en ;
    ns1:IAO_0000111 "moving average"@en ;
    ns1:IAO_0000112 "The moving average is often used to handle data from tiling arrays."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A moving average is a data transformation in which center calculations, usually mean calculations, are performed on values within a sliding window across the input data set."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en,
        "Helen Parkinson"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en,
        "PERSON: Helen Parkinson"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000679 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0000425 ] ) ],
        ns1:OBI_0200170 .

ns1:OBI_0200058 a owl:Class ;
    rdfs:label "b cell epitope prediction"@en ;
    ns1:IAO_0000111 "b cell epitope prediction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A B cell epitope prediction takes as input an antigen sequence, and through an analysis of this sequence, produces as output a prediction of the likelihood the biomaterial is a B Cell Epitope."@en ;
    ns1:IAO_0000117 "Helen Parkinson"@en ;
    ns1:IAO_0000119 "PERSON: Helen Parkinson"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200081 ],
        ns1:OBI_0200187 .

ns1:OBI_0200059 a owl:Class ;
    rdfs:label "mhc binding prediction"@en ;
    ns1:IAO_0000111 "mhc binding prediction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An MHC binding prediction takes an input of a biomaterial sequence and through an analysis of this sequence, produces as output a prediction of the likelihood that the biomaterial will bind to an MHC molecule."@en ;
    ns1:IAO_0000117 "Helen Parkinson"@en ;
    ns1:IAO_0000119 "PERSON: Helen Parkinson"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200081 ],
        ns1:OBI_0200187 .

ns1:OBI_0200060 a owl:Class ;
    rdfs:label "t cell epitope prediction"@en ;
    ns1:IAO_0000111 "t cell epitope prediction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A T cell epitope prediction takes as input an antigen sequence, and through an analysis of this sequence, produces as output a prediction of the likelihood the biomaterial is a T cell epitope."@en ;
    ns1:IAO_0000117 "Helen Parkinson"@en ;
    ns1:IAO_0000119 "PERSON: Helen Parkinson"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200081 ],
        ns1:OBI_0200187 .

ns1:OBI_0200061 a owl:Class ;
    rdfs:label "data imputation"@en ;
    ns1:IAO_0000111 "data imputation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "Imputation is a means of filling in missing data values from a predictive distribution of the missing values.  The predictive distribution can be created either based on a formal statistical model (i,e, a multivariate normal distribution) or an algorithm."@en ;
    ns1:IAO_0000117 "Monnie McGee"@en ;
    ns1:IAO_0000119 "ARTICLE: Little, RJA and Rubin, DB (2002).  Statistical Analysis with Missing Data, Second Edition.  John Wiley: Hoboken New Jersey, pp. 59-60."@en ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200062 a owl:Class ;
    rdfs:label "continuum mass spectrum"@en ;
    ns1:IAO_0000111 "continuum mass spectrum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A continuum mass spectrum is a data transformation that contains the full profile of the detected signals for a given ion."@en ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "PERSON: Tina Boussard"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200197 ],
        ns1:OBI_0200085 .

ns1:OBI_0200063 a owl:Class ;
    rdfs:label "characteristic path length calculation"@en ;
    ns1:IAO_0000111 "characteristic path length calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Quantifying subgraph navigability based on shortest-path length averaged over all pairs of subgraph vertices"@en ;
    ns1:IAO_0000117 "PERSON: Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "PERSON: Tina Hernandez-Boussard"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200197 ],
        ns1:OBI_0200085 .

ns1:OBI_0200064 a owl:Class ;
    rdfs:label "centroid mass spectrum"@en ;
    ns1:IAO_0000111 "centroid mass spectrum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A centroid mass spectrum is a data transformation in which many points are used to delineate a mass spectral peak, is converted into mass-centroided data by a data compression algorithm. The centroided mass peak is located at the weighted center of mass of the profile peak. The normalized area of the peak provides the mass intensity data."@en ;
    ns1:IAO_0000117 "Person:Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000118 "centroid mass spectrum calculation"^^xsd:string,
        "centroiding"^^xsd:string ;
    ns1:IAO_0000119 "centroid mass spectrum"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200197 ],
        ns1:OBI_0200085 .

ns1:OBI_0200066 a owl:Class ;
    rdfs:label "Holm-Bonferroni family-wise error rate correction method"@en ;
    ns1:IAO_0000111 "Holm-Bonferroni family-wise error rate correction method"@en ;
    ns1:IAO_0000112 "t-tests were used with the type I error adjusted for multiple comparisons, Holm's correction (HOLM 1979), and false discovery rate, http://www.genetics.org/cgi/content/full/172/2/1179"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a data transformation that performs more than one hypothesis test simultaneously, a closed-test procedure, that  controls the familywise error rate for all the k hypotheses at level α in the strong sense. Objective: multiple testing correction"^^xsd:string ;
    ns1:IAO_0000116 "2011-03-14: [PRS]. Class Label has been changed to address the conflict with the definition\\nAlso added restriction to specify the output to be a FWER adjusted p-value\\n\\nThe 'editor preferred term' should be removed"@en ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Holm%E2%80%93Bonferroni_method"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001265 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000175 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000791 ],
        ns1:OBI_0200073 .

ns1:OBI_0200070 a owl:Class ;
    rdfs:label "edge weighting"@en ;
    ns1:IAO_0000111 "edge weighting"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Edge weighting is the substitution or transformation of edge length using numerical data.  Data input include a symmetric adjacency matrix for a network and a second data set, for example a list of interactor pairs and a confidence score associated with the experimental detection of each pair's interaction.  Each element in the adjacency matrix is transformed or replaced with the corresponding number in the second data set.  Output data are a modified adjacency matrix reflecting the transformed state of the network."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "editor"@en ;
    ns1:IAO_0000232 "was classified under algorithm class which is not acceptable super-class\\nTO BE DEALT WITH STILL BY RICHARD.  JAMES"@en ;
    rdfs:subClassOf ns1:OBI_0200080 .

ns1:OBI_0200075 a owl:Class ;
    rdfs:label "row submatrix extraction"@en ;
    ns1:IAO_0000111 "row submatrix extraction"@en ;
    ns1:IAO_0000112 "When presented with the data from an expression microarray experiment in the form of a matrix, whose rows correspond to genes and whose columns correspond to samples, if one filters some of the genes out, the resulting data set corresponds to a row submatrix of the original set."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A row submatrix extraction is a submatrix extraction where all the columns of the input matrix are retained and selection only occurs on the rows."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en,
        "PERSON: James Malone"@en,
        "PERSON: Melanie Courtot"@en ;
    rdfs:subClassOf ns1:OBI_0200074 .

ns1:OBI_0200076 a owl:Class ;
    rdfs:label "column submatrix extraction"@en ;
    ns1:IAO_0000111 "column submatrix extraction"@en ;
    ns1:IAO_0000112 "When presented with the data from an expression microarray experiment in the form of a matrix, whose rows correspond to genes and whose columns correspond to samples, if one filters some of the samples out, the resulting data set corresponds to a column submatrix of the original set."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A column submatrix extraction is a submatrix extraction where all the rows of the input matrix are retained and selection only occurs on the columns."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en,
        "PERSON: James Malone"@en,
        "PERSON: Melanie Courtot"@en ;
    rdfs:subClassOf ns1:OBI_0200074 .

ns1:OBI_0200077 a owl:Class ;
    rdfs:label "gating"@en ;
    ns1:IAO_0000111 "gating"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Gating is a property-based vector selection with the objective of partitioning a data vector set into vector subsets based on dimension values of individual vectors (events), in which vectors represent individual physical particles (often cells) of a sample and dimension values represent light intensity qualities as measured by flow cytometry."@en ;
    ns1:IAO_0000117 "James Malone"@en,
        "Josef Spidlen"@en,
        "Melanie Courtot"@en,
        "Richard Scheuermann"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"@en,
        "PERSON: Josef Spidlen"@en,
        "PERSON: Richard Scheuermann"@en,
        "PERSON: Ryan Brinkman"@en,
        "PERSON:Melanie Courtot"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200157 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200172 ],
        ns1:OBI_0200171,
        ns1:OBI_0200182 .

ns1:OBI_0200079 a owl:Class ;
    rdfs:label "arithmetic mean calculation"@en ;
    ns1:IAO_0000111 "arithmetic mean calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An arithmetic mean calculation is a descriptive statistics calculation in which the mean is calculated by taking the sum of all of the observations in a data set divided by the total number of observations. It gives a measure of the 'center of gravity' for the data set. It is also known as the first moment."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "James Malone"@en,
        "Monnie McGee"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"@en,
        "PERSON: Monnie McGee"@en ;
    ns1:IAO_0000232 "From Monnie's file comments - need to add moment_calculation and center_calculation roles but they don't exist yet - (editor note added by James Jan 2008)"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000679 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0000425 ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000674 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200177 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        ns1:OBI_0200170,
        ns1:OBI_0200181,
        ns1:OBI_0200184 .

ns1:OBI_0200082 a owl:Class ;
    rdfs:label "longitudinal data analysis"@en ;
    ns1:IAO_0000111 "longitudinal data analysis"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Longitudinal analysis is a data transformation used to perform repeated observations of the same items over long periods of time."@en ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Tina Boussard"^^xsd:string ;
    ns1:IAO_0000118 "correlation analysis"^^xsd:string,
        "longitudinal data analysis"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200196 ],
        ns1:OBI_0200000 .

ns1:OBI_0200088 a owl:Class ;
    rdfs:label "Kaplan Meier"@en ;
    ns1:IAO_0000111 "Kaplan Meier"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a nonparametric (actuarial) data transformation technique for estimating time-related events. It is a univariate analysis that estimates the probability of the proportion of subjects in remission at a particular time, starting from the initiation of active date (time zero), and takes into account those lost to follow-up or not yet in remission at end of study (censored)"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Tina Boussard"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Kaplan%E2%80%93Meier_estimator"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200083 ],
        ns1:OBI_0200194 .

ns1:OBI_0200091 a owl:Class ;
    rdfs:label "inter-rater reliability objective"@en ;
    ns1:IAO_0000111 "inter-rater reliability objective"^^xsd:string ;
    ns1:IAO_0000112 "A study was conducted to determine the inter-rater reliability of common clinical examination procedures proposed to identify patients with lumbar segmental instability.\\n\\nExamples include joint-probability of agreement, Cohen's kappa and the related Fleiss' kappa, inter-rater correlation, concordance correlation coefficient and intra-class correlation."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a data transformation objective of determining the concordance or agreement between human judges."^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string,
        "Person:Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000118 "inter-rater agreement"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Inter-rater_reliability"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200092 a owl:Class ;
    rdfs:label "Westfall and Young family wise error rate correction"@en ;
    ns1:IAO_0000111 "Westfall and Young family wise error rate correction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Is a data transformation process in which the Westfall and Young method is applied with the aim of controlling for multiple testing"^^xsd:string ;
    ns1:IAO_0000116 "2011-03-31: [PRS]. \\nspecified input and output of dt which were missing"@en,
        "PRS: 2011-03-31: set specified input and specified output to the data transformation"@en ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000118 "Westfall and Young FWER correction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000791 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000175 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001265 ],
        ns1:OBI_0200073 .

ns1:OBI_0200094 a owl:Class ;
    rdfs:label "logarithmic transformation"@en ;
    ns1:IAO_0000111 "logarithmic transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A logarithmic transformation is a data transformation consisting in the application of the logarithm function with a given base a (where a>0 and a is not equal to 1) to a (one dimensional) positive real number input. The logarithm function with base a can be defined as the inverse of the exponential function with the same base. See e.g. http://en.wikipedia.org/wiki/Logarithm."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Logarithm"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200095 a owl:Class ;
    rdfs:label "exponential transformation"@en ;
    ns1:IAO_0000111 "exponential transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An exponential transformation is a data transformation consisting in the application of the exponential function with a given base a (where a>0 and a is typically not equal to 1) to a (one dimensional) real number input. For alternative definitions and properties of this function see, e.g., http://en.wikipedia.org/wiki/Exponential_function and http://en.wikipedia.org/wiki/Characterizations_of_the_exponential_function."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Characterizations_of_the_exponential_function"@en,
        "WEB: http://en.wikipedia.org/wiki/Exponential_function"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200097 a owl:Class ;
    rdfs:label "non-negative matrix factorization"@en ;
    ns1:IAO_0000111 "non-negative matrix factorization"^^xsd:string ;
    ns1:IAO_0000112 "Non-negative matrix factorization is used in text mining where document-term matrix is constructed with the weights of various terms (typically weighted word frequency information) from a set of documents. This matrix is factored into a term-feature and a feature-document matrix."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Non negative matrix factorization is a data transformation in which factorises a matrix and which forces that all elements must be equal to or greater than zero."^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Non-negative_matrix_factorization"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200098 a owl:Class ;
    rdfs:label "soft independent modeling of class analogy analysis"@en ;
    ns1:IAO_0000111 "soft independent modeling of class analogy analysis"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Soft independent modeling by class analogy (SIMCA) is a descriptive statistics method for supervised classification of data. The method requires a training data set consisting of samples (or objects) with a set of attributes and their class membership. The term soft refers to the fact the classifier can identify samples as belonging to multiple classes and not necessarily producing a classification of samples into non-overlapping classes."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000118 "SIMCA"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Soft_independent_modelling_of_class_analogies"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200099 a owl:Class ;
    rdfs:label "discriminant function analysis"@en ;
    ns1:IAO_0000111 "discriminant function analysis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Discriminant function analysis is a form of discriminant analysis used to determine which variables discriminate between two or more naturally occurring groups. Analysis is used to determine which variable(s) are the best predictors of a particular outcome."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "WEB: http://www.statsoft.com/textbook/stdiscan.html"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000648 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000023 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200179 ] ) ],
        ns1:OBI_0000663,
        ns1:OBI_0200106,
        ns1:OBI_0200175 .

ns1:OBI_0200100 a owl:Class ;
    rdfs:label "canonical variate analysis"@en ;
    ns1:IAO_0000111 "canonical variate analysis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "canonical variate analysis is a form of discriminant analysis that takes several continuous predictor variables and uses the entire set to predict several criterion variables, each of which is also continuous. CVA simultaneously calculates a linear composite of all x variables and  a linear composite of all y variables. Unlike other multivariate techniques, these weighted composites are derived in pairs. Each linear combination is called a canonical variate and takes the general linear form."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000118 "CVA"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Canonical_analysis"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200172 ],
        ns1:OBI_0200106,
        ns1:OBI_0200171 .

ns1:OBI_0200101 a owl:Class ;
    rdfs:label "linear discriminant functional analysis"@en ;
    ns1:IAO_0000111 "linear discriminant functional analysis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Linear discriminant functional analysis (LDFA) is a multivariate technique used in special applications where there are several intact groups (random assignment may be impossible) and they have been measured on several independent measures. Thus, you will want to describe how these groups differ on the basis of these measures. In this case, classification and prediction is the main objective."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "PERSON: Tina Hernandez-Boussard"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000023 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200179 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000648 ],
        ns1:OBI_0000663,
        ns1:OBI_0200106,
        ns1:OBI_0200175 .

ns1:OBI_0200103 a owl:Class ;
    rdfs:label "multiple linear regression analysis"@en ;
    ns1:IAO_0000111 "multiple linear regression analysis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "multiple linear regression is a regression method that models the relationship between a dependent variable Y, independent variables Xi, i = 1, ..., p, and a random term epsilon. The model can be written as\\n    Y = \\\\beta_0 + \\\\beta_1 X_1 + \\\\beta_2 X_2 + \\\\cdots +\\\\beta_p X_p + \\\\varepsilon\\nwhere \\\\beta_0 =  0 is the intercept (\"constant\" term), the \\\\beta_i s  are the respective parameters of independent variables, and p is the number of parameters to be estimated in the linear regression."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "WEB:http://en.wikipedia.org/wiki/Linear_regression"@en ;
    rdfs:subClassOf ns1:OBI_0200102 .

ns1:OBI_0200104 a owl:Class ;
    rdfs:label "principal component regression"@en ;
    ns1:IAO_0000111 "principal component regression"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "The Principal Component Regression method is a regression analysis method that combines the Principal Component Analysis (PCA)spectral decomposition with an Inverse Least Squares (ILS) regression method to create a quantitative model for complex samples. Unlike quantitation methods based directly on Beer's Law which attempt to calculate the absorbtivity coefficients for the constituents of interest from a direct regression of the constituent concentrations onto the spectroscopic responses, the PCR method regresses the concentrations on the PCA scores."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "WEB: : http://www.thermo.com/com/cda/resources/resources_detail/1,2166,13414,00.html"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000648 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200178 ] ) ],
        ns1:OBI_0200102,
        ns1:OBI_0200175 .

ns1:OBI_0200105 a owl:Class ;
    rdfs:label "partial least square regression analysis"@en ;
    ns1:IAO_0000111 "partial least square regression analysis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Partial least squares regression is an extension of the multiple linear regression model (see, e.g., Multiple Regression or General Stepwise Regression). In its simplest form, a linear model specifies the (linear) relationship between a dependent (response) variable Y, and a set of predictor variables, the X's, so that\\nY = b0 + b1X1 + b2X2 + ... + bpXp\\nIn this equation b0 is the regression coefficient for the intercept and the bi values are the regression coefficients (for variables 1 through p) computed from the data."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000118 "PLS-RA"@en ;
    ns1:IAO_0000119 "ARTICLE: de Jong, S. (1993). SIMPLS: An alternative approach to partial least squares regression. Chemometrics and Intelligent Laboratory Systems, 18: 251-263."@en ;
    rdfs:subClassOf ns1:OBI_0200102 .

ns1:OBI_0200107 a owl:Class ;
    rdfs:label "partial least square discriminant analysis"@en ;
    ns1:IAO_0000111 "partial least square discriminant analysis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "PLS Discriminant Analysis (PLS-DA) is a discriminant analysis performed in order to sharpen the separation between groups of observations, by hopefully rotating PCA (Principal Components Analysis) components such that a maximum separation among classes is obtained, and to understand which variables carry the class separating information."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000118 "PLS-DA"@en ;
    ns1:IAO_0000119 "WEB: http://www.camo.com/rt/Resources/pls-da.html"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200106 .

ns1:OBI_0200108 a owl:Class ;
    rdfs:label "eh transformation"@en ;
    ns1:IAO_0000111 "eh transformation"@en ;
    ns1:IAO_0000112 "This type of transformation is typically used in flow cytometry."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An eh transformation is a data transformation obtained by applying the function EH described in what follows to a (one dimensional) real number input. EH(x)=exp(x*d/r)+b*(d/r)*x-1, if x>=0, and EH(x)=-exp(-x*d/r)+b*(d/r)*x+1, otherwise. Here exp denotes an exponential transformation and b, d, r are positive real constants with the objective of normalization."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Joseph Spliden"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200109 a owl:Class ;
    rdfs:label "b transformation"@en ;
    ns1:IAO_0000111 "b transformation"@en ;
    ns1:IAO_0000112 "This type of transformation is typically used in flow cytometry."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A b transformation is a data transformation obtained by applying the function B described in what follows to a (one dimensional) real number input. B(x)= a*exp(b*x)-c*exp(-d*x)+f, where exp denotes an exponential transformation and a, b, c, d, f are real constants with a, b, c, d positive with the objective of normalization."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Joseph Spliden"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000451 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200167 ] ) ],
        ns1:OBI_0200169 .

ns1:OBI_0200110 a owl:Class ;
    rdfs:label "s transformation"@en ;
    ns1:IAO_0000111 "s transformation"@en ;
    ns1:IAO_0000112 "This type of transformation is typically used in flow cytometry."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An s transformation is a data transformation obtained by applying the function S described in what follows to a (one dimensional) real number input. S(x)=T*exp(w-m)*(exp(x-w)-(p^2)*exp((w-x)/p)+p^2-1) if x>=w, S(x)=-S(w-x) otherwise; where exp denotes an exponential_transformations, 'p^' denotes the exponential transformation with base p; T, w, m, p are real constants with T, m, and p positive and w non-negative, and where w and p are related by w=2p*ln(p)(p+1) with the objective of normalization."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Joseph Spliden"@en,
        "Ryan Brinkman"@en ;
    ns1:IAO_0000119 "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200114 a owl:Class ;
    rdfs:label "euclidean distance calculation"@en ;
    ns1:IAO_0000111 "euclidean distance calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An euclidean distance calculation is a similarity calculation that attaches to each pair of real number vectors of the same dimension n the square root of the sum of the square differences between corresponding components. The smaller this number, the more similar the two vectors are considered."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf ns1:OBI_0200113 .

ns1:OBI_0200115 a owl:Class ;
    rdfs:label "pearson correlation coefficient calculation"@en ;
    ns1:IAO_0000111 "pearson correlation coefficient calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A pearson correlation coefficient calculation is a similarity calculation which attaches to each pair of random variables X and Y the ratio of their covariance by the product of their standard deviations. Given a series of n measurements of X and Y written as x_i and y_i where i = 1, 2, ..., n, then their Pearson correlation coefficient refers to the \"sample correlation coefficient\" and is written as the sum over i of the ratios (x_i-xbar)*(y_i-ybar)/((n-1)*s_x*s_y) where xbar and ybar are the sample means of X and Y , s_x and s_y are the sample standard deviations of X and Y. The closer the pearson correlation coefficient is to 1, the more similar the inputs are considered."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en,
        "WEB: http://en.wikipedia.org/wiki/Correlation"@en ;
    rdfs:subClassOf ns1:OBI_0200113 .

ns1:OBI_0200116 a owl:Class ;
    rdfs:label "loess fitting"@en ;
    ns1:IAO_0000111 "loess fitting"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess fitting is a curve fitting obtained by localized regression. The latter refers to fitting a polynomial (straight line, quadratic, cubic, etc) to data values within a window covering a fraction of the total number of observations. As the window slides along the axis, a new polynomial is fit to the observations falling within the window. This continues until all points are fit with a local polynomial. The results are then smoothed together to form a curve. The smoothness of loess fits is controlled by a smoothing parameter (often denoted as alpha, usually between 1/4 and 1) and the degree of the polynomial that is fitted by the method (usually denoted by lambda)."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Monnie McGee"@en ;
    ns1:IAO_0000119 "ARTICLE: Mathematical details of loess fits are given in Cleveland, William (1993) Visualizing Data. Hobart Press, Summit, New Jersey, pp. 94-101."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200174 ],
        ns1:OBI_0200072 .

ns1:OBI_0200117 a owl:Class ;
    rdfs:label "mode calculation"@en ;
    ns1:IAO_0000111 "mode calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A mode calculation is a descriptive statistics calculation in which the mode is calculated which is the most common value in a data set. It is most often used as a measure of center for discrete data."@en ;
    ns1:IAO_0000117 "James Malone"@en,
        "Monnie McGee"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"@en,
        "PERSON: Monnie McGee"@en ;
    ns1:IAO_0000232 "From Monnie's file comments - need to add center_calculation role but it doesn't exist yet - (editor note added by James Jan 2008)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000674 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200177 ] ) ],
        ns1:OBI_0200181,
        ns1:OBI_0200184 .

ns1:OBI_0200118 a owl:Class ;
    rdfs:label "quantile calculation"@en ;
    ns1:IAO_0000111 "quantile calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A quantile calculation is a descriptive statistics calculation in which the kth quantile is the data value for which an approximate k fraction of the data is less than or equal to that value.  See http://www.stat.wvu.edu/SRS/Modules/Quantiles/quantiles.html for details."@en ;
    ns1:IAO_0000117 "Monnie McGee"@en ;
    ns1:IAO_0000119 "WEB: http://www.stat.wvu.edu/SRS/Modules/Quantiles/quantiles.html"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        ns1:OBI_0200184 .

ns1:OBI_0200119 a owl:Class ;
    rdfs:label "median calculation"@en ;
    ns1:IAO_0000111 "median calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A median calculation is a  descriptive statistics calculation in which the midpoint of the data set (the 0.5 quantile) is calculated.  First, the observations are sorted in increasing order.  For an odd number of observations, the median is the middle value of the sorted data.  For an even number of observations, the median is the average of the two middle values."@en ;
    ns1:IAO_0000117 "James Malone"@en,
        "Monnie McGee"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"@en,
        "PERSON: Monnie McGee"@en ;
    ns1:IAO_0000232 "From Monnie's file comments - need to add center_calculation role but it doesn't exist yet - (editor note added by James Jan 2008)"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000674 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200177 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        ns1:OBI_0200181,
        ns1:OBI_0200184 .

ns1:OBI_0200120 a owl:Class ;
    rdfs:label "variance calculation"@en ;
    ns1:IAO_0000111 "variance calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A variance calculation is a descriptive statistics calculation in which the variance is defined as the average squared distance of each observation in the data set to the mean of the data set.  It is also known as the second central moment."@en ;
    ns1:IAO_0000117 "Monnie McGee"@en ;
    ns1:IAO_0000119 "PERSON: Monnie McGee"@en ;
    ns1:IAO_0000232 "From Monnie's file comments - need to add spread_calculation and moment_calculation roles but they don't exist yet - (editor note added by James Jan 2008)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200180 ],
        ns1:OBI_0200086,
        ns1:OBI_0200184 .

ns1:OBI_0200121 a owl:Class ;
    rdfs:label "standard deviation calculation"@en ;
    ns1:IAO_0000111 "standard deviation calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A standard deviation calculation is a descriptive statistics calculation defined as the square root of the variance.  Also thought of as the average distance of each value to the mean."@en ;
    ns1:IAO_0000117 "Monnie McGee"@en ;
    ns1:IAO_0000119 "PERSON: Monnie McGee"@en ;
    ns1:IAO_0000232 "From Monnie's file comments - need to add spread calculation role but they doesn't exist yet - (editor note added by James Jan 2008)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200180 ],
        ns1:OBI_0200086,
        ns1:OBI_0200184 .

ns1:OBI_0200122 a owl:Class ;
    rdfs:label "interquartile-range calculation"@en ;
    ns1:IAO_0000111 "interquartile-range calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The interquartile range is a descriptive statistics calculation defined as the difference between the 0.75 quantile and the 0.25 quantile for a set of data."@en ;
    ns1:IAO_0000117 "Monnie McGee"@en ;
    ns1:IAO_0000119 "PERSON: Monnie McGee"@en ;
    ns1:IAO_0000232 "From Monnie's file comments - need to add spread calculation role but they doesn't exist yet - (editor note added by James Jan 2008)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200180 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        ns1:OBI_0200086,
        ns1:OBI_0200184 .

ns1:OBI_0200123 a owl:Class ;
    rdfs:label "skewness calculation"@en ;
    ns1:IAO_0000111 "skewness calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A skewness calculation is a descriptive statistics calculation defined as a parameter that describes how much a distribution (or a data set) varies from a bell-shaped curve.  See http://www.riskglossary.com/link/skewness.htm for details.  It is also known as the third central moment"@en ;
    ns1:IAO_0000117 "Monnie McGee"@en ;
    ns1:IAO_0000119 "WEB: http://www.riskglossary.com/link/skewness.htm"@en ;
    ns1:IAO_0000232 "From Monnie's file comments - need to add moment calculation role but they doesn't exist yet - (editor note added by James Jan 2008)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000674 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200177 ] ) ],
        ns1:OBI_0200181,
        ns1:OBI_0200184 .

ns1:OBI_0200124 a owl:Class ;
    rdfs:label "kurtosis calculation"@en ;
    ns1:IAO_0000111 "kurtosis calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A kurtosis calculation is a descriptive statistics calculation defined as a parameter that measures how large or small the tails of a distribution are relative to the mean.  For details, see http://davidmlane.com/hyperstat/A53638.html"@en ;
    ns1:IAO_0000117 "Monnie McGee"@en ;
    ns1:IAO_0000119 "WEB: http://davidmlane.com/hyperstat/A53638.html"@en ;
    ns1:IAO_0000232 "From Monnie's file comments - need to add moment calculation role but they doesn't exist yet - (editor note added by James Jan 2008)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200078 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200180 ],
        ns1:OBI_0200086,
        ns1:OBI_0200184 .

ns1:OBI_0200125 a owl:Class ;
    rdfs:label "data combination"@en ;
    ns1:IAO_0000111 "data combination"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data transformation in which individual input data elements and values are merged together into a output set of data elements and values."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000118 "data pooling"^^xsd:string ;
    ns1:IAO_0000119 "editor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200189 ],
        ns1:OBI_0200000 .

ns1:OBI_0200127 a owl:Class ;
    rdfs:label "weighted network graph construction"@en ;
    ns1:IAO_0000111 "weighted network graph construction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network graph construction in which an input data set describing objects and quantitative relationships between objects is transformed into and output representation of these objects as nodes and the quantitative relationships as weighted edges of a network graph."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200126 .

ns1:OBI_0200128 a owl:Class ;
    rdfs:label "directed network graph construction"@en ;
    ns1:IAO_0000111 "directed network graph construction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network graph construction in which an input data set describing objects and directional relationships between objects is transformed into and output representation of these objects as nodes and the directional relationships as directed edges of a network graph."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200126 .

ns1:OBI_0200130 a owl:Class ;
    rdfs:label "node degree calculation"@en ;
    ns1:IAO_0000111 "node degree calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A node quality calculation in which an input data set describing object nodes and relationship edges between object nodes is used to enumerate the number of unique relationships of an individual object node."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200129 .

ns1:OBI_0200131 a owl:Class ;
    rdfs:label "quantitative node degree calculation"@en ;
    ns1:IAO_0000111 "quantitative node degree calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A node quality calculation in which an input data set describing object nodes and quantitative relationship edges between object nodes is used to sum all of the quantitative relationships of an individual object node."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200129 .

ns1:OBI_0200132 a owl:Class ;
    rdfs:label "node in-degree calculation"@en ;
    ns1:IAO_0000111 "node in-degree calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A node quality calculation in which an input data set describing object nodes and directional relationship edges between object nodes is used to enumerate the number of unique relationships pointing into an individual object node."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200129 .

ns1:OBI_0200133 a owl:Class ;
    rdfs:label "node out-degree calculation"@en ;
    ns1:IAO_0000111 "node out-degree calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A node quality calculation in which an input data set describing object nodes and directional relationship edges between object nodes is used to enumerate the number of unique relationships pointing out of an individual object node."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200129 .

ns1:OBI_0200134 a owl:Class ;
    rdfs:label "node shortest path identification"@en ;
    ns1:IAO_0000111 "node shortest path identification"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A node quality calculation in which a path describing the shortest path needed to transverse through connected nodes and edges to arrive at a specific target node in the network."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200129 .

ns1:OBI_0200136 a owl:Class ;
    rdfs:label "edge betweenness calculation"@en ;
    ns1:IAO_0000111 "edge betweenness calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An edge quality calculation in which the input is a data sets of shortest paths between all pairs of node in the network and the output is the sum of all shortest paths that traverse the specific edge."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200135 .

ns1:OBI_0200138 a owl:Class ;
    rdfs:label "subgraph degree calculation"@en ;
    ns1:IAO_0000111 "subgraph degree calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network subgraph quality calculation in which an input data set describing subgraphs and relationship edges between subgraphs and other network objects is used to enumerate the number of unique relationships of an individual subgraph."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200137 .

ns1:OBI_0200139 a owl:Class ;
    rdfs:label "quantitative subgraph degree calculation"@en ;
    ns1:IAO_0000111 "quantitative subgraph degree calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network subgraph quality calculation in which an input data set describing subgraphs and quantitative relationship edges between subgraphs and other network objects is used to sum the quantitative relationships of an individual subgraph."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200137 .

ns1:OBI_0200141 a owl:Class ;
    rdfs:label "log base"@en ;
    ns1:IAO_0000111 "log base"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The log base is a feature of a logarithmic function which is defined in http://en.wikipedia.org/wiki/Logarithm. Its value can be any positive real number different from 1."^^xsd:string ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string ;
    ns1:IAO_0000118 "logarithm base"^^xsd:string,
        "logarithmic base"^^xsd:string ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Logarithm"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000292 ;
            owl:someValuesFrom xsd:float ],
        ns1:OBI_0200140 .

ns1:OBI_0200143 a owl:Class ;
    rdfs:label "subgraph in-degree calculation"@en ;
    ns1:IAO_0000111 "subgraph in-degree calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network subgraph quality calculation in which an input data set describing subgraphs and directional relationship edges between subgraphs and other network objects is used to enumerate the number of unique relationships pointing into an individual subgraph."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200137 .

ns1:OBI_0200144 a owl:Class ;
    rdfs:label "subgraph out-degree calculation"@en ;
    ns1:IAO_0000111 "subgraph out-degree calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network subgraph quality calculation in which an input data set describing subgraphs and relationship edges between subgraphs and other network objects is used to enumerate the number of unique relationships pointing out of an individual subgraph."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200137 .

ns1:OBI_0200145 a owl:Class ;
    rdfs:label "intra subgraph connectivity calculation"@en ;
    ns1:IAO_0000111 "intra subgraph connectivity calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network subgraph quality calculation in which an input data set describing internal nodes, edges and node degrees is used to determine the average node degree within the subgraph."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200137 .

ns1:OBI_0200146 a owl:Class ;
    rdfs:label "subgraph modularity calculation"@en ;
    ns1:IAO_0000111 "subgraph modularity calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network subgraph quality calculation in which an input data set of subgraph in-degree and out-degree qualities is used to calculate the ratio of indegree to outdegree as a measure of modularity."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200137 .

ns1:OBI_0200149 a owl:Class ;
    rdfs:label "unit-variance scaling"@en ;
    ns1:IAO_0000111 "unit-variance scaling"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A unit-variance scaling is a data transformation that divides all measurements of a variable by the standard deviation of that variable."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000118 "autoscaling"@en ;
    ns1:IAO_0000119 "PMID:16762068"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200150 a owl:Class ;
    rdfs:label "MA transformation"^^xsd:string ;
    ns1:IAO_0000111 "MA transformation"^^xsd:string ;
    ns1:IAO_0000112 "MA transformations are typically used in microarray data analyses. In this context, the g_i and r_i represent the reporter intensities in the two channels of a 2-channel assay or the reporter intensities in two related one-channel assays. Typically the base used for the logarithm is 2."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An MA transformation is a data transformation which takes as input a collection of data points (g_1, r_1), (g_2, r_2), ..., (g_n, r_n)  with the r_i and g_i positive real numbers, and whose output is the collection of data points (A_1, M_1), (A_2, M_2), ..., (A_n, M_n) where, for each i, A_i=(log(g_i)+log(r_i))/2 and M_i=log(r_i)-log(g_i). Here log denotes a logarithmic transformation."^^xsd:string ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200151 a owl:Class ;
    rdfs:label "exponential base"@en ;
    ns1:IAO_0000111 "exponential base"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The exponential base is a feature of an exponential function which is defined in http://en.wikipedia.org/wiki/Exponential_function. Its value can be any positive real number (typically different from 1)."^^xsd:string ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Exponential_function"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000292 ;
            owl:someValuesFrom xsd:float ],
        ns1:OBI_0200140 .

ns1:OBI_0200152 a owl:Class ;
    rdfs:label "polynomial degree"@en ;
    ns1:IAO_0000111 "polynomial degree"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The polynomial degree is a feature of a polynomial function defined as the highest power of the polynomial's terms, where the terms of a polynomial are the individual summands with the coefficients omitted."^^xsd:string ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000292 ;
            owl:someValuesFrom xsd:nonNegativeInteger ],
        ns1:OBI_0200140 .

ns1:OBI_0200153 a owl:Class ;
    rdfs:label "number of variables"@en ;
    ns1:IAO_0000111 "number of variables"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The number of variables is a feature of any function (including polynomial functions) with domain contained in an n-dimensional vector space and is defined as n, the dimension of such space."^^xsd:string ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000292 ;
            owl:someValuesFrom xsd:integer ],
        ns1:OBI_0200140 .

ns1:OBI_0200155 a owl:Class ;
    rdfs:label "divisive hierarchical clustering"@en ;
    ns1:IAO_0000111 "divisive hierarchical clustering"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A divisive hierarchical clustering is a hierarchical clustering which starts with a single cluster and then successively splits resulting clusters until only clusters of individual objects remain."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000118 "top-down hierarchical clustering"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf ns1:OBI_0200042 .

ns1:OBI_0200156 a owl:Class ;
    rdfs:label "data partitioning"@en ;
    ns1:IAO_0000111 "data partitioning"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Data partitioning is a data transformation with the objective of partitioning or separating input data into output subsets."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: Melanie Courtot"@en,
        "PERSON: Richard Scheuermann"@en,
        "PERSON: Ryan Brinkman"@en ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200160 a owl:Class ;
    rdfs:label "generalized family wise error rate correction method"@en ;
    ns1:IAO_0000111 "generalized family wise error rate correction method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A generalized FWER correction method is a multiple testing procedure that controls the probability of at least k+1 false positives, where k is a user-supplied integer."^^xsd:string ;
    ns1:IAO_0000117 "Monnie McGee"^^xsd:string ;
    ns1:IAO_0000118 "gFWER correction"@en ;
    ns1:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 19"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000791 ],
        ns1:OBI_0200089 .

ns1:OBI_0200161 a owl:Class ;
    rdfs:label "quantile number of false positives correction method"@en ;
    ns1:IAO_0000111 "quantile number of false positives correction method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A quantile number of false positives correction method is a MTP that controls for the pth quantile of the distribution of the number of false positives out of the total number of tests performed'"^^xsd:string ;
    ns1:IAO_0000117 "Monnie McGee"^^xsd:string ;
    ns1:IAO_0000118 "QNFP"@en ;
    ns1:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 19"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000662 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0000791 ] ) ],
        ns1:OBI_0200089 .

ns1:OBI_0200162 a owl:Class ;
    rdfs:label "tail probability for the proportion of false positives correction method"@en ;
    ns1:IAO_0000111 "tail probability for the proportion of false positives correction method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A TPPFP correction method is a MTP that controls the probability that the proportion of false positives among all rejected hypotheses is no greater than a constant q, where q is between 0 and 1."^^xsd:string ;
    ns1:IAO_0000117 "Monnie McGee"^^xsd:string ;
    ns1:IAO_0000118 "TPPFP correction method"@en ;
    ns1:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 20"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000791 ],
        ns1:OBI_0200089 .

ns1:OBI_0200164 a owl:Class ;
    rdfs:label "proportion of expected false positives correction method"@en ;
    ns1:IAO_0000111 "proportion of expected false positives correction method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A proportion of expected false positives correction method is a multiple testing procedure that controls the ratio of the expected value of the numbers of false positives to the expected value of the numbers of rejected hypotheses."^^xsd:string ;
    ns1:IAO_0000117 "Monnie McGee"^^xsd:string ;
    ns1:IAO_0000118 "PEFP correction method"@en ;
    ns1:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 21"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000662 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0000791 ] ) ],
        ns1:OBI_0200089 .

ns1:OBI_0200165 a owl:Class ;
    rdfs:label "quantile proportion of false positives correction method"@en ;
    ns1:IAO_0000111 "quantile proportion of false positives correction method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A quantile proportion of false positives correction method is a multiple testing procedure that controls the pth quantile of the distribution of the proportion of false positives among the rejected hypothesis (false discovery rate)."^^xsd:string ;
    ns1:IAO_0000117 "Monnie McGee"^^xsd:string ;
    ns1:IAO_0000118 "QPFP correction method"@en ;
    ns1:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 21"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000662 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0000791 ] ) ],
        ns1:OBI_0200089 .

ns1:OBI_0200176 a owl:Class ;
    rdfs:label "Fisher's exact test"^^xsd:string ;
    ns1:IAO_0000111 "Fisher's exact test"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Fisher's exact test is a data transformation used to determine if there are nonrandom associations between two Fisher's exact test is a statistical significance test used in the analysis of contingency tables where sample sizes are small where the significance of the deviation from a null hypothesis can be calculated exactly, rather than relying on an approximation that becomes exact in the limit as the sample size grows to infinity, as with many statistical tests."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "WEB:http://mathworld.wolfram.com/FishersExactTest.html"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000675 ],
        ns1:OBI_0000673 .

ns1:OBI_0200191 a owl:Class ;
    rdfs:label "gene list visualization"^^xsd:string ;
    ns1:IAO_0000111 "gene list visualization"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Adata visualization which has input of a gene list and produces an output of a report graph which is capable of rendering data of this type."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000118 ;
            owl:onProperty ns1:OBI_0000293 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000306 ],
        ns1:OBI_0200111 .

ns1:OBI_0200192 a owl:Class ;
    rdfs:label "classified data visualization"^^xsd:string ;
    ns1:IAO_0000111 "classified data visualization"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data visualization which has input of a classified data set and produces an output of a report graph which is capable of rendering data of this type."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:IAO_0000180 ns1:IAO_0000184 ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000023 ;
            owl:onProperty ns1:OBI_0000293 ],
        ns1:OBI_0200111 .

ns1:OBI_0200193 a owl:Class ;
    rdfs:label "background corrected data visualization"^^xsd:string ;
    ns1:IAO_0000111 "background corrected data visualization"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data visualization which has input of a background corrected data set and produces an output of a report graph which is capable of rendering data of this type."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string,
        "Monnie McGee"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:IAO_0000079 ns1:IAO_0000179 ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000660 ;
            owl:onProperty ns1:OBI_0000293 ],
        ns1:OBI_0200111 .

ns1:OBI_0200195 a owl:Class ;
    rdfs:label "proportional hazards model estimation"^^xsd:string ;
    ns1:IAO_0000111 "proportional hazards model estimation"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Proportional hazards model is a data transformation model to estimate the effects of different covariates influencing the times-to-failure of a system."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Tina Boussard"^^xsd:string ;
    ns1:IAO_0000118 "Cox model"^^xsd:string,
        "Cox proportional hazards model"^^xsd:string ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Cox_proportional_hazards_model"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200083 ],
        ns1:OBI_0200194 .

ns1:OBI_0200199 a owl:Class ;
    rdfs:label "gas chromatography mass spectrometry"^^xsd:string ;
    ns1:IAO_0000111 "gas chromatography mass spectrometry"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Gas chromatography mass spectrometry is a data transformation combining mass spectrometry and  \\ngas chromatography for the qualitative as well as quantitative  \\ndeterminations of compounds."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Tina Boussard"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Tina Boussard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200197 ],
        ns1:OBI_0200085 .

ns1:OBI_0200200 a owl:Class ;
    rdfs:label "chi square test"^^xsd:string ;
    ns1:IAO_0000111 "chi square test"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The chi-square test is a data transformation with the objective of statistical hypothesis testing, in which the sampling distribution of the test statistic is a chi-square distribution when the null hypothesis is true, or any in which this is asymptotically true, meaning that the sampling distribution (if the null hypothesis is true) can be made to approximate a chi-square distribution as closely as desired by making the sample size large enough."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Tina Boussard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000675 ],
        ns1:OBI_0000673 .

ns1:OBI_0200201 a owl:Class ;
    rdfs:label "ANOVA"^^xsd:string ;
    ns1:IAO_0000111 "ANOVA"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "ANOVA or analysis of variance is a data transformation in which a statistical test of whether the means of several groups are all equal."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0300310 a owl:Class ;
    rdfs:label "sequential design"@en ;
    ns1:IAO_0000111 "sequential design"@en ;
    ns1:IAO_0000112 "PMID: 17710740.Pharm Stat. 2007 Aug 20.Sequential design approaches for bioequivalence studies with crossover designs."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Any design in which the decision as to whether to enroll the next patient, pair of patients, or block of patients is determined by whether the cumulative treatment difference for all previous patients is within specified limits.  Enrollment is continued if the difference does not exceed the limits.  It is terminated if it does"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "MUSC"@en ;
    ns1:IAO_0000232 "Provenance: OCI"@en ;
    rdfs:subClassOf ns1:OBI_0000115 .

ns1:OBI_0300311 a owl:Class ;
    rdfs:label "observation design"@en ;
    ns1:IAO_0000111 "observation design"@en ;
    ns1:IAO_0000112 "PMID: 12387964.Lancet. 2002 Oct 12;360(9340):1144-9.Deficiency of antibacterial peptides in patients with morbus Kostmann: an observation study."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "observation design is a study design in which subjects are monitored in the absence of any active intervention by experimentalists."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0500000 .

ns1:OBI_0302714 a owl:Class ;
    rdfs:label "obsolete_collection (of entities of organismal origin)"@en ;
    ns1:IAO_0000111 "collection (of entities of organismal origin)"@en ;
    ns1:IAO_0000112 "PMID: 18037794. Magn Reson Med Sci. 2007;6(3):139-46. Imaging of a large collection of human embryo using a super-parallel MR microscope.[the Orsay Museum has a nice collection of Impressionnist paintings]"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a collection is a bfo:aggregate object, that is a set of material object of the same kind"@en ;
    ns1:IAO_0000116 "03/17/2010: obsoleted (on call), and replaced by 'material entity' and/or specimen. No need for the 'collection' part of this class any more after merging bfo:aggregate object into material entity, and by dealing with 'specimen' rather than with entities of organismal origin."^^xsd:string,
        "2009-11-04, MC: Entity of organismal origin has been deprecated a while ago. We still have collection (of entities of organismal origin). I am not sure we could replace with collection of material entity without altering the meaning (i.e. deprecating the class). In addition, if we do deprecate that class, should we just assert the children under material entity?"^^xsd:string,
        "added during 22-02-2008 biomaterial call to distinguish library and population"@en ;
    ns1:IAO_0000117 "PERSON: Susanna Sansone"^^xsd:string ;
    ns1:IAO_0000118 "set, group, ensemble"@en ;
    ns1:IAO_0000119 "PERSON: Philippe Rocca-Serra"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    ns1:IAO_0000232 "PRS: How can we distinguish with 'collection' as the process of collecting entities, (eg. data collection, urine collection)"@en ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0302736 a owl:Class ;
    rdfs:label "comet assay" ;
    ns1:IAO_0000111 "comet assay" ;
    ns1:IAO_0000112 "PMID: 18326531.Mutagenesis. 2008 Mar 6.Recommendations for design of the rat comet assay."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An assay that measures DNA damage (DNA breakage) in eucaryotic cells exposed to a challenge by determining the size and shape of DNA migration by detecting fluorescently labeled DNA from a cell placed in an electric field using gel electrophoresis"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
