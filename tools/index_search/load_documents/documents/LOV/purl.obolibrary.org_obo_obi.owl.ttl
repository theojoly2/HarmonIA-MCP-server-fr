ns1:IAO_0000309 a owl:Class ;
    rdfs:label "diagram"@en ;
    ns1:IAO_0000111 "diagram"@en ;
    ns1:IAO_0000112 "A molecular structure ribbon cartoon showing helices, turns and sheets and their relations to each other in space."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
