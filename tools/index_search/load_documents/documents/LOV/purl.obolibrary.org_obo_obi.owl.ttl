    rdfs:label "thrombin time assay" ;
    ns1:IAO_0000111 "thrombin time assay" ;
    ns1:IAO_0000112 "PMID:19696660#The thrombin time was determined using thromboclotin assay kit."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that measures the time between the addition of the thrombin and the clot formation in plasma."^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "url:http://en.wikipedia.org/wiki/Thrombin_time@2009/10/06"^^xsd:string ;
