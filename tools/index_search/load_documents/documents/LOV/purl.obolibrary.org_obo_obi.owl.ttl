ns1:OBI_0200106 a owl:Class ;
    rdfs:label "discriminant analysis"@en ;
    ns1:IAO_0000111 "discriminant analysis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Discriminant function analysis is used to determine which variables discriminate between two or more naturally occurring groups. Analysis is used to determine which variable(s) are the best predictors of a particular outcome."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "WEB: http://www.statsoft.com/textbook/stdiscan.html"@en ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200111 a owl:Class ;
    rdfs:label "data visualization"@en ;
    ns1:IAO_0000111 "data visualization"^^xsd:string ;
    ns1:IAO_0000112 "Generation of a heatmap from a microarray dataset"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An planned process that creates images, diagrams or animations from the input data."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
