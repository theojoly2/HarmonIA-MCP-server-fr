ns1:OBI_0400143 a owl:Class ;
    rdfs:label "fluorometer"@en ;
    ns1:IAO_0000111 "fluorometer"@en ;
    ns1:IAO_0000112 "laser/detector in capillary electrophoresis apparatus, NanoDrop ND-3300"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A fluorometer is an instrument for the detection and measurement of parameters of fluoresence, which in turn are used to identify the presence and amount of specific molecules in the sample."@en ;
    ns1:IAO_0000117 "Allyson Lister"@en,
        "Kevin Lister"@en ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf ns1:OBI_0400115 .

ns1:OBI_0400146 a owl:Class ;
    rdfs:label "multispectral imaging flow cytometer"@en ;
    ns1:IAO_0000111 "multispectral imaging flow cytometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A multispectral_imaging_flow_cytometer is an instrument which combines quantitative image analysis and flow cytometry in a single platform. It measures the amount, location and movement of molecules on, in, or between cells, and  the location and co-localization of multiple markers on or in cells. It can also quantitate morphologically distinct cell subpopulations."@en ;
    ns1:IAO_0000117 "Melanie Courtot"@en ;
    ns1:IAO_0000118 "MIFC"@en ;
    ns1:IAO_0000119 "http://www.amnis.com/"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0400044 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
