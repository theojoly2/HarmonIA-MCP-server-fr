ns1:OBI_1110125 a owl:Class ;
    rdfs:label "assay measuring MHC ligand processing and presentation" ;
    ns1:IAO_0000111 "assay measuring MHC ligand processing and presentation" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
