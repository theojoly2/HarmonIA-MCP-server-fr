ns1:OBI_0000052 a owl:Class ;
    rdfs:label "microarray platform"@en ;
    ns1:IAO_0000111 "microarray platform"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A microarray platform is a platform that contains the instruments, software and reagents needed to perform a microarray protocol. definition_source: OBI."@en ;
    ns1:IAO_0000117 "OBI Instrument branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI Instrument branch"^^xsd:string ;
