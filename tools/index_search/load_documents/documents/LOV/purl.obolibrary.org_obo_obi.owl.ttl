                    owl:onProperty ns1:RO_0000059 ;
                    owl:someValuesFrom ns1:OBI_0001522 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001939 ],
        ns1:OBI_0200000 .

ns1:OBI_0001934 a owl:Class ;
    rdfs:label "predicted value" ;
    ns1:IAO_0000111 "predicted value" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "an information content entity that has been generated by a prediction process in which an estimate of a value of an entity is made which can be measured but without performing such a measurement. The value specification is intended to be close to the value a measurement process would produce modulo a prediction error." ;
    ns1:IAO_0000117 "PERSON:Bjoern Peters" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0001933 ],
