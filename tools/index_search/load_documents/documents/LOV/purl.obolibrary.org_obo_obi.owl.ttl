            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000414 ],
        ns1:OBI_0000070 .

ns1:OBI_0600027 a owl:Class ;
    rdfs:label "artificially induced cell membrane lysis"@en ;
    ns1:IAO_0000111 "artificially induced cell membrane lysis"@en ;
    ns1:IAO_0000112 "http://www.ncbi.nlm.nih.gov/sites/entrez?cmd=Retrieve&db=PubMed&amp;list_uids=16080188&dopt=AbstractPlus; The destruction of cell membranes with detergent."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a material transformation to break the membranes of cells, releasing the cells contents; input=>cells; output=>cell_lysate"@en ;
    ns1:IAO_0000116 "---\\\\nThere is a more general 'membrane lysis', which could apply to artificial membranes etc. For this general membrane encapsulated objects would need to be defined."@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0600030 a owl:Class ;
    rdfs:label "experimental disease induction"@en ;
    ns1:IAO_0000111 "experimental disease induction"@en ;
    ns1:IAO_0000112 "the injection of mice with LCM virus iv to establish an LCMV infection. Witholding food from animals to induce starvation syndrome."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application to induce a specific disease in an organism"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "could be defined class"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0600032 a owl:Class ;
    rdfs:label "artificially induced DNA repair"@en ;
    ns1:IAO_0000111 "artificially induced DNA repair"@en ;
    ns1:IAO_0000112 "the use of DNA repair enzymes uracil DNA glycosylase and 3-methyladenine DNA glycosylase to repair DNA strands"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application to repair damaged DNA molecules"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "---\\\\nis this really a protocol?\\\\n--> This as several other protocol applications is also a natural process. The fact that it is induced experimetnally by following a protocol makes it a protocol application. Need to make sure that labels don't conflict wi"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0600041 a owl:Class ;
    rdfs:label "concentrate"@en ;
    ns1:IAO_0000111 "concentrate"@en ;
    ns1:IAO_0000112 "Evaporation of the solution containing DNA to increase the concentration of the DNA molecules"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application to create an output material with an increased density of a material of interest that is part of the input material by separating other parts of the input material"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        ns1:OBI_0600014 .

ns1:OBI_0600042 a owl:Class ;
    rdfs:label "recombinant plasmid cloning"@en ;
    ns1:IAO_0000111 "recombinant plasmid cloning"@en ;
    ns1:IAO_0000112 "The DNA fragment encoding the p35 gene from Mycobacterium avium complex was inserted into pcDNAII and expressed in E coli in order to study p35."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "the insertion of a particular DNA fragment into a plasmid in order to make copies of a biomaterial"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0600064 ;
