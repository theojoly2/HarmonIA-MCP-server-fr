ns1:OBI_0000652 a owl:Class ;
    rdfs:label "material combination"^^xsd:string ;
    ns1:IAO_0000111 "material combination"^^xsd:string ;
    ns1:IAO_0000112 "Mixing two fluids. Adding salt into water. Injecting a mouse with PBS."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "is a material processing with the objective to combine two or more material entities as input into a single material entity as output."^^xsd:string ;
    ns1:IAO_0000116 "created at workshop as parent class for 'adding material into target', which is asymmetric, while combination encompasses all addition processes."^^xsd:string ;
    ns1:IAO_0000117 "bp"^^xsd:string ;
    ns1:IAO_0000119 "bp"^^xsd:string ;
