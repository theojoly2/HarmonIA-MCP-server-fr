    ns1:IAO_0000111 "occurrence of allergy"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The process of an allergic disease occurring in an organism."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
