ns1:OBI_0000906 a owl:Class ;
    rdfs:label "induced hemagglutination"^^xsd:string ;
    ns1:IAO_0000111 "induced hemagglutination"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The clumping or clustering of red blood cells caused by certain viruses, antibodies, or other substances"^^xsd:string ;
    ns1:IAO_0000116 "MC, 20100217: This term was originally submitted to GO, see discussion at http://sourceforge.net/tracker/index.php?func=detail&aid=2947975&group_id=36855&atid=440764. After discussion it was agreed that this isn't a natural in vivo process and therefore out of scope for GO. \\nDev call Nov 22, 2010: To reflect this, the term's label has been updated to 'induced hemagglutination'."^^xsd:string ;
    ns1:IAO_0000117 "person: Bjoern Peters"^^xsd:string,
        "person: Melanie Courtot"^^xsd:string ;
    ns1:IAO_0000118 "hemeagglutination"^^xsd:string ;
    ns1:IAO_0000119 "WEB: http://medical-dictionary.thefreedictionary.com/hemagglutination"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:CL_0000232 ],
        ns1:OBI_0000094 .

