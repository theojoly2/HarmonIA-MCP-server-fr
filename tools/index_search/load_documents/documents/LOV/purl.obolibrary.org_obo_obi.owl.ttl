    rdfs:label "denaturing"^^xsd:string ;
    ns1:IAO_0000111 "denaturing"^^xsd:string ;
    ns1:IAO_0000112 "Denaturing DNA in alcohol"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Is a process in which the tertiary or secondary structure of a polymer is disrupted"^^xsd:string ;
