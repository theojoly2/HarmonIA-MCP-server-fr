    ns1:IAO_0000115 "A nuclear ligation assay that detects chromosomal interactions between any two genomic loci. Chromatin segments are cross-linked, cut by restriction enzymes, ligated, and finally analyzed by PCR."^^xsd:string ;
    ns1:IAO_0000117 "Chris S"^^xsd:string ;
    ns1:IAO_0000118 "3C assay"^^xsd:string ;
    ns1:IAO_0000119 "PMID:11847345"^^xsd:string,
        "url:http://www.nature.com/nprot/journal/v2/n7/full/nprot.2007.243.html"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0001917 ],
        ns1:OBI_0002438 .

ns1:OBI_0002452 a owl:Class ;
    rdfs:label "biological activity assay measuring epitope specific interferon-alpha production by T cells" ;
    ns1:IAO_0000111 "biological activity assay measuring epitope specific interferon-alpha production by T cells" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A T cell epitope specific cytokine production assay that detects interferon-alpha production by T cells."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "IFNa release"^^xsd:string,
        "biological activity"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_1110129 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_1110129 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:IAO_0000030 [ a owl:Restriction ;
                                            owl:onProperty ns1:IAO_0000136 ;
                                            owl:someValuesFrom ns1:GO_0032607 ] ) ] ] ) ] .

ns1:OBI_0002580 a owl:Class ;
    rdfs:label "aligned sequence data" ;
    ns1:IAO_0000111 "aligned sequence data" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The results of a sequence alignment."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000973 .

ns1:OBI_0002585 a owl:Class ;
    rdfs:label "sequence trimming" ;
    ns1:IAO_0000111 "sequence trimming" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data transformation in which subsequences of a molecular sequence are cut (removed)."^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0002587 a owl:Class ;
    rdfs:label "machine learning" ;
    ns1:IAO_0000111 "machine learning" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A planned process in which statistical techniques are used to give computers the ability to learn about patterns in data, without being explicitly programmed.  Learning is defined in this case as progressively improving performance on a specific task."^^xsd:string ;
    ns1:IAO_0000117 "Mark A. Miller" ;
    ns1:IAO_0000119 "https://en.wikipedia.org/wiki/Machine_learning"^^xsd:string ;
    dc:contributor "https://github.com/TrisSN" ;
    rdfs:subClassOf ns1:OBI_0000011 .

ns1:OBI_0100016 a owl:Class ;
    rdfs:label "blood plasma specimen"@en ;
    ns1:IAO_0000111 "blood plasma specimen"@en ;
    ns1:IAO_0000112 "PMID: 18217225.Sex Transm Dis. 2008 Jan;35(1):55-60. Review.Human immunodeficiency virus viral load in blood plasma and semen: review and implications of empirical findings."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a material entity which corresponds to the liquid component of blood, in which the blood cells are suspended."@en ;
    ns1:IAO_0000116 "03/21/2010: BP, blood plasma is defined as the output of certain separation processes, so this is in the domain of OBI, not FMA."@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string,
        "PERSON: Maura Gasparetto"@en,
        "PERSON: Melanie Courtot"@en ;
    ns1:IAO_0000118 "plasma"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Blood_plasma"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:OBI_0000112 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0600014 [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000293 ;
                                owl:someValuesFrom ns1:OBI_0000655 ] ) ] ],
        ns1:OBI_0000953 .

ns1:OBI_0100061 a owl:Class ;
    rdfs:label "primary cultured cell population"@en ;
    ns1:IAO_0000111 "primary cultured cell population"^^xsd:string ;
    ns1:IAO_0000112 "Spleen cells put directly into culture;  Cold storage of biopsies from wild endangered native Chilean species in field conditions and subsequent isolation of primary culture cell lines. In Vitro Cell Dev Biol Anim. 2008 Jul 2. PMID: 18594934"^^xsd:string,
        "cells that have been isolated from some organismal source, expanded in culture, but not undergone a complete passaging (ie are still in culture, or have been lifted from culture and frozen in aliquots for future use)"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cultured cell population comprised of cells expanded directly from living tissue prior to being passaged.\\n\\n"^^xsd:string ;
    ns1:IAO_0000116 "2013-6-5 MHB: This OBI class was formerly called 'primary cell culture', but label changed and definition updated following CLO alignment work.  Previous definition: 'a primary cell culture is a cell culture where the cells derive from a fresh tissue source.'" ;
    ns1:IAO_0000117 "PERSON:Matthew Brush"^^xsd:string ;
    ns1:IAO_0000118 "primary cell culture"^^xsd:string,
        "primary cell culture sample"^^xsd:string ;
    ns1:IAO_0000119 "PERSON:Matthew Brush"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:OBI_0600037 ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000643 ;
            owl:someValuesFrom ns1:CL_0000001 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CL_0000001 ;
            owl:onProperty ns1:OBI_0000643 ],
        ns1:OBI_0100060 .

ns1:OBI_0200023 a owl:Class ;
    rdfs:label "loess global transformation"@en ;
    ns1:IAO_0000111 "loess global transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess global transformation is a loess transformation where only one loess fitting is performed, utilizing one subset of (or possibly all of) the data points in the input so that there is only one resulting loess curve y=f(x) which is used for the transformation."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000119 "OTHER: Editor's generalization based on MGED Ontology term"@en ;
    rdfs:subClassOf ns1:OBI_0200071 .

ns1:OBI_0200025 a owl:Class ;
    rdfs:label "loess scale group transformation"@en ;
    ns1:IAO_0000111 "loess scale group transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess scale group transformation is a data transformation consisting in the application of a scale adjustment following a loess group transformation, to render the group variances for the second variable (y) similar.  Has objective scaling."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000119 "OTHER: Editor's generalization based on MGED Ontology term"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200183 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002087 ;
            owl:someValuesFrom ns1:OBI_0200024 ],
        ns1:OBI_0200185 .

ns1:OBI_0200050 a owl:Class ;
    rdfs:label "dimensionality reduction"@en ;
    ns1:IAO_0000111 "dimensionality reduction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A dimensionality reduction is data partitioning which transforms each input m-dimensional vector (x_1, x_2, ..., x_m) into an output n-dimensional vector (y_1, y_2, ..., y_n), where n is smaller than m."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000118 "data projection"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en,
        "PERSON: James Malone"@en,
        "PERSON: Melanie Courtot"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000648 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200178 ] ) ],
        ns1:OBI_0200175 .

ns1:OBI_0200071 a owl:Class ;
    rdfs:label "loess transformation"@en ;
    ns1:IAO_0000111 "loess transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess transformation is a data transformation that takes as input a collection of real number pairs (x, y) and, after performing (one or more) loess fittings, utilizes the resulting curves to transform each (x, y) in the input into (x, y-f(x)) where f(x) is one of the fitted curves."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000119 "OTHER: Editor's generalization based on MGED Ontology term"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200073 a owl:Class ;
    rdfs:label "family wise error rate correction method"@en ;
    ns1:IAO_0000111 "family wise error rate correction method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A family wise error rate correction method is a multiple testing procedure that controls the probability of at least one false positive."^^xsd:string ;
    ns1:IAO_0000116 "2011-03-31: [PRS]. \\ncreating a defined class by specifying the necessary output of dt\\nallows correct classification of FWER dt"@en ;
    ns1:IAO_0000117 "Monnie McGee"^^xsd:string,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000118 "FWER correction"@en ;
    ns1:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 19"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000791 ],
        ns1:OBI_0200089 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001265 ] .

ns1:OBI_0200074 a owl:Class ;
    rdfs:label "submatrix extraction"@en ;
    ns1:IAO_0000111 "submatrix extraction"@en ;
    ns1:IAO_0000112 "When presented with the data from an expression microarray experiment in the form of a matrix, whose rows correspond to genes and whose columns correspond to samples, if one filters some of the genes and/or some of the samples out, the resulting data set corresponds to a submatrix of the original set."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A submatrix extraction is a projection whose input is a matrix and whose output is a matrix obtained by selecting certain rows and columns from the input. (Note that, if one represents the input matrix as a vector obtained by concatenating its rows, then extracting a submatrix is equivalent to projecting this vector into that composed by the entries belonging to the rows and columns of interest from the input matrix.)"@en ;
    ns1:IAO_0000116 "Note that this can be considered as a special case of projection if one represents the input matrix as a vector obtained by concatenating its rows. Then extracting a submatrix is equivalent to projecting this vector into the entries belonging to the rows and columns of interest from the input matrix."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Submatrix"@en ;
    rdfs:subClassOf ns1:OBI_0200050 .

ns1:OBI_0200113 a owl:Class ;
    rdfs:label "similarity calculation"@en ;
    ns1:IAO_0000111 "similarity calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A similarity calculation is a data transformation that attaches to each pair of objects in the input a number that is meant to reflect how 'close' or 'similar' those objects are."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000023 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000648 ],
        ns1:OBI_0000663,
        ns1:OBI_0200175 .

ns1:OBI_0200126 a owl:Class ;
    rdfs:label "network graph construction"@en ;
    ns1:IAO_0000111 "network graph construction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network analysis in which an input data set describing objects and relationships between objects is transformed into an output representation of these objects as nodes and the relationships as edges of a network graph."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200080 .

ns1:OBI_0200157 a owl:Class ;
    rdfs:label "data vector reduction objective"@en ;
    ns1:IAO_0000111 "data vector reduction objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Data vector reduction is a data transformation objective in which k m-dimensional input vectors are reduced to j m-dimensional output vectors, where j is smaller than k."@en ;
    ns1:IAO_0000117 "James Malone"^^xsd:string,
        "Richard H. Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard H. Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200163 a owl:Class ;
    rdfs:label "false discovery rate correction method"@en ;
    ns1:IAO_0000111 "false discovery rate correction method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "The false discovery rate is a  data transformation used in multiple hypothesis testing to correct for multiple comparisons. It controls the expected proportion of incorrectly rejected null hypotheses (type I errors) in a list of rejected hypotheses. It is a less conservative comparison procedure with greater power than familywise error rate (FWER) control, at a cost of increasing the likelihood of obtaining type I errors. ."^^xsd:string ;
    ns1:IAO_0000116 "2011-03-31: [PRS]. \\ncreating a defined class by specifying the necessary output of dt\\nallows correct classification of FDR dt"@en ;
    ns1:IAO_0000117 "Monnie McGee"^^xsd:string,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000118 "FDR correction method"@en ;
    ns1:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 21 and http://www.wikidoc.org/index.php/False_discovery_rate"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000175 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000791 ],
        ns1:OBI_0200089 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001442 ] .

ns1:OBI_0200168 a owl:Class ;
    rdfs:label "correction objective"@en ;
    ns1:IAO_0000111 "correction objective"@en ;
    ns1:IAO_0000112 "Type I error correction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A correction objective is a data transformation objective where the aim is to correct for error, noise or other impairments to the input of the data transformation or derived from the data transformation itself"@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"^^xsd:string,
        "PERSON: Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200182 a owl:Class ;
    rdfs:label "data vector reduction data transformation"@en ;
    ns1:IAO_0000111 "data vector reduction data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A data vector reduction is a data transformation that has objective data vector reduction and that consists of reducing the input vectors k to a smaller number of output vectors j, where j<k."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0000707 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000676 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200157 ] ) ] .

ns1:OBI_0200183 a owl:Class ;
    rdfs:label "scaling objective"@en ;
    ns1:IAO_0000111 "scaling objective"@en ;
    ns1:IAO_0000112 "Scaling gene expression data for cross platform analysis http://www.springerprotocols.com/Abstract/doi/10.1007/978-1-59745-454-4_13"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a data transformation objective where all, or some of a data set is adjusted by some data transformation according to some scale, for example a user defined minimum or maximum"^^xsd:string ;
    ns1:IAO_0000116 "Awaiting English definition from Monnie McGee"@en ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200186 a owl:Class ;
    rdfs:label "error correction objective"@en ;
    ns1:IAO_0000111 "error correction objective"@en ;
    ns1:IAO_0000112 "Application of a multiple testing correction method"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An error correction objective is a data transformation objective where the aim is to remove (correct for) erroneous contributions arising from the input data, or the transformation itself."@en ;
    ns1:IAO_0000117 "James Malone, Helen Parkinson"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200168 .

ns1:OBI_0200190 a owl:Class ;
    rdfs:label "clustered data visualization"^^xsd:string ;
    ns1:IAO_0000111 "clustered data visualization"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data visualization which has input of a clustered data set and produces an output of a report graph which is capable of rendering data of this type."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:IAO_0000037 ns1:IAO_0000179 ns1:IAO_0000180 ns1:IAO_0000183 ns1:IAO_0000184 ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000648 ;
            owl:onProperty ns1:OBI_0000293 ],
        ns1:OBI_0200111 .

ns1:OBI_0200194 a owl:Class ;
    rdfs:label "survival analysis data transformation"^^xsd:string ;
    ns1:IAO_0000111 "survival analysis data transformation"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A data transformation which has the objective of performing survival analysis."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200083 ] .

ns1:OBI_0302859 a owl:Class ;
    rdfs:label "genetically modified organism"@en ;
    ns1:IAO_0000111 "genetically modified organism"^^xsd:string ;
    ns1:IAO_0000112 "A protocol for removal of antibiotic resistance cassettes from human embryonic stem cells genetically modified by homologous recombination or transgenesis.\\nNat Protoc. 2008;3(10):1550-8. PMID: 18802436"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "an organism that is the output of a genetic transformation process"@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "OBI Biomaterial"@en ;
    rdfs:subClassOf ns1:OBI_0001151,
        ns1:OBI_0100026 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0100026 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom ns1:OBI_0600043 ] ) ] .

ns1:OBI_0302890 a owl:Class ;
    rdfs:label "polymerization"@en ;
    ns1:IAO_0000111 "polymerization"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18517209. The electronic role of DNA-functionalized carbon nanotubes: efficacy for in situ polymerization of conducting polymer nanocomposites. J Am Chem Soc. 2008 Jun 25;130(25):7921-8. Epub 2008 Jun 3."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "polymerization is process by which molecular entity of small mass are aggregated in motifs over the course of a chemical reaction catalyzed by enzymes or other molecular entities acting as catalyst. polymerization results in molecular entity of high molecular weight"@en ;
    ns1:IAO_0000116 "PRS:22102008: need to import catalyst from CHEBI 35223"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "OBI-Branch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:CHEBI_33839 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:CHEBI_23367 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0302903 a owl:Class ;
    rdfs:label "nucleic acid hybridization"@en ;
    ns1:IAO_0000111 "nucleic acid hybridization"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18555787.Quantitative analysis of DNA hybridization in a flowthrough microarray for molecular testing. Anal Biochem. 2008 May 27."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a planned process by which totally or partially complementary, single-stranded nucleic acids are  combined into a single molecule called heteroduplex or homoduplex to an extent depending on the amount of complementarity."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "adapted from wikipedia [http://en.wikipedia.org/wiki/Nucleic_acid_hybridization]"^^xsd:string ;
    ns1:OBI_0001847 "hybridization assay"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000052 ;
                                owl:someValuesFrom ns1:OBI_0400110 ] ) ] ],
        ns1:OBI_0000094 .

ns1:OBI_0400047 a owl:Class ;
    rdfs:label "gas laser"@en ;
    ns1:IAO_0000111 "gas laser"^^xsd:string ;
    ns1:IAO_0000112 "helium-neon gas laser used to erradiate cells in a flow cytometer."@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A gas laser is a laser in which the lasing medium is a gas. The laser medium is places between two parallel mirrors for light emission amplification. The gas is excited to emit light via an external light source or an electric current discharging through the gas."@en ;
    ns1:IAO_0000117 "Daniel Schober"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Gas_laser"^^xsd:string,
        "John Quinn"@en ;
    rdfs:subClassOf ns1:OBI_0400064 .

ns1:OBI_0400076 a owl:Class ;
    rdfs:label "multi-well plate"@en ;
    ns1:IAO_0000111 "multi-well plate"@en ;
    ns1:IAO_0000112 "96 well plate, 48 multiwell plate"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A particle deliver vessel. A multi-well plate is a vessel that can deliver multiple samples to a flow cytometer in a specified order. It must be used with a plate loader."@en ;
    ns1:IAO_0000116 "FG this is synonymous with microtiter plate"@en ;
    ns1:IAO_0000117 "John Quinn"@en ;
    ns1:IAO_0000119 "http://www.nuncbrand.com/page.aspx?ID=301"@en ;
    rdfs:subClassOf ns1:OBI_0400081 .

ns1:OBI_0400078 a owl:Class ;
    rdfs:label "obscuration bar"@en ;
    ns1:IAO_0000111 "obscuration bar"@en ;
    ns1:IAO_0000112 "obscuration bar in a flow cytometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An obscuration bar is a an optical subsystem which is a strip of metal or other material that serves to block out direct light from the illuminating beam. The obscuration bar prevents the bright light scattered in the forward directions from burning out the collection device."@en ;
    ns1:IAO_0000117 "Daniel Schober"@en ;
    ns1:IAO_0000119 "Flow Cytometry: First Principles, by Alice Longobardi Givan, ISBN-10: 0471382248, ISBN-13: 978-0471382249"^^xsd:string,
        "John Quinn"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000378 ],
        ns1:OBI_0000932 .

ns1:OBI_0400101 a owl:Class ;
    rdfs:label "voltage amplifier"@en ;
    ns1:IAO_0000111 "voltage amplifier"@en ;
    ns1:IAO_0000112 "Linear amplifier, log amplifier, microwave amplifier"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A voltage amplifier is a device that amplifies the voltage signal."@en ;
    ns1:IAO_0000117 "Frank Gibson"^^xsd:string,
        "John Quinn"@en ;
    ns1:IAO_0000119 "http://en.wiktionary.org/wiki/amplifier"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000395 ],
        ns1:OBI_0000968 .

ns1:OBI_0400106 a owl:Class ;
    rdfs:label "centrifuge"@en ;
    ns1:IAO_0000111 "centrifuge"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A device with a rapidly rotating container that applies centrifugal force to its contents"^^xsd:string ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"^^xsd:string,
        "Melanie Courtot"@en,
        "Trish Whetzel"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Centrifuge"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0000085 ;
                    owl:someValuesFrom ns1:OBI_0000370 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000372 [ a owl:Restriction ;
                                owl:allValuesFrom ns1:OBI_0302886 ;
                                owl:onProperty ns1:BFO_0000054 ] ) ] ],
        ns1:OBI_0000832,
        ns1:OBI_0000932 .

ns1:OBI_0400110 a owl:Class ;
    rdfs:label "hybridization chamber"@en ;
    ns1:IAO_0000111 "hybridization chamber"@en ;
    ns1:IAO_0000112 "Glass Array Hybridization Cassette"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A device which is used to maintain constant contact of a liquid on an array.  This can be either a glass vial or slide."@en ;
    ns1:IAO_0000117 "Trish Whetzel"@en ;
    ns1:IAO_0000119 "MO_563 hybridization_chamber"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000401 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000370 ],
        ns1:OBI_0002089 .

ns1:OBI_0400120 a owl:Class ;
    rdfs:label "temperature control bath"@en ;
    ns1:IAO_0000111 "temperature control bath"@en ;
    ns1:IAO_0000112 "VWR Signature Deep-Chamber Heated Water Bath. A water bath is used for temperatures up to 100 degrees C. An oil bath is employed for temperatures over 100 degrees C."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A temperature_control_bath is a device that has the function to regulate the temperature of a material, the function to contain fluid and the function to vary and maintain the temperature of the contained fluid. Heat exchange (energy transfer) between the material and the heating element is facilitated via the contained fluid. A temperature_control_bath is composed of a container, a heating element and/or a cooling element and a means to adjust the needed temperature. In most cases also a timer and a means to stir the fluid is provided as well."@en ;
    ns1:IAO_0000117 "Alan Ruttenburg"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string ;
    ns1:IAO_0000119 "OBI Instrument branch"^^xsd:string ;
    ns1:IAO_0000232 "DS: This was heated_bath. It was renamed to reflect the possability that the same bath can be used for cooling. We can now define the temperature variables and based on that infer if it is a cooling device or a heating device (also quite relative to surrounding temperature)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000401 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000370 ],
        ns1:OBI_0002089 .

ns1:OBI_0400149 a owl:Class ;
    rdfs:label "protein microarray"@en ;
    ns1:IAO_0000111 "protein microarray"@en ;
    ns1:IAO_0000112 "The most common protein microarray is the antibody microarray, where antibodies are spotted onto the protein chip and are used as capture molecules to detect proteins from cell lysate solutions."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A protein-microarray is a microarray, ususlly a piece of glass, on which different molecules of protein have been affixed at separate locations in an ordered manner. These are used to identify protein-protein or protein-small molecule interactions."@en ;
    ns1:IAO_0000117 "Daniel Schober"@en ;
    ns1:IAO_0000119 "PERSON: Daniel Schober"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0400147 .

ns1:OBI_0400153 a owl:Class ;
    rdfs:label "droplet sorter"@en ;
    ns1:IAO_0000111 "droplet sorter"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A droplet sorter is part_of a flow cytometer sorter that converts the carrier fluid stream into individual droplets, and these droplets are directed into separate locations for recovery (enriching the original\\nsample for particles of interest based on qualities determined by gating) or disposal."@en ;
    ns1:IAO_0000117 "OBI Instrument branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI Instrument branch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000403 ],
        ns1:OBI_0000932 .

ns1:OBI_0400168 a owl:Class ;
    rdfs:label "microtome"@en ;
    ns1:IAO_0000111 "microtome"@en ;
    ns1:IAO_0000112 "PMID: 9974145.Serial sectioning of thick tissue with a novel vibrating blade microtome. Brain Res Brain Res Protoc. 1999 Jan;3(3):302-7."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A microtome is a mechanical instrument used to cut biological specimens into very thin segments for further treatment (e.g. ISH) and ultimately microscopic or histologic examination. Most microtomes provide cooling facilities (cryo-microtome) and use a steel blade to cut a slice of defined thickness. Some are automatic, and some are driven by hand."@en ;
    ns1:IAO_0000117 "PERSON: Phillippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Daniel Schober"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000372 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000379 ],
        ns1:OBI_0000932 .

ns1:OBI_0600006 a owl:Class ;
    rdfs:label "killing"@en ;
    ns1:IAO_0000111 "killing"@en ;
    ns1:IAO_0000112 "Terminal sacrifice of animals by cervical dislocation at the end of an investigation."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A protocol application in which an organism is intentionally put to death"@en ;
    ns1:IAO_0000116 "difficult to place this properly - JG. Death process (e.g. unscheduled death) is out of scope but should be added somewhere. All killings have death process as a part, but not all death processes are part of a killing."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Jennifer Fostel"@en ;
    ns1:IAO_0000118 "death status type"@en,
        "euthanisia"@en,
        "life termination"@en,
        "sacrifice"@en ;
    ns1:IAO_0000119 "CEBS, Biomaterial_branch"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0100026 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000086 ;
                                owl:someValuesFrom ns1:PATO_0001421 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0100026 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000086 ;
                                owl:someValuesFrom ns1:PATO_0001422 ] ) ] ],
        ns1:OBI_0000094 .

ns1:OBI_0600008 a owl:Class ;
    rdfs:label "acquisition"@en ;
    ns1:IAO_0000111 "acquisition"@en ;
    ns1:IAO_0000112 "Downloading a 3D structure from the PDB. Purchasing antibodies from sigma. "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "the planned process of gaining possession of a continuant "@en ;
    ns1:IAO_0000116 "5/31/2012 - OBI workshop: This process is not implying ownership of the material / information. "^^xsd:string,
        "Following OBI call November 2012,5th:\\naddition of a restriction to acquisition class to capture the need of having selection criteria\\nRelates to the creation of a class 'selection rule'"@en ;
    ns1:IAO_0000117 "Bjoern Peters"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    ns1:IAO_0000232 "This needs to be fleshed out and logical definitions added that will allow to place the children terms automatically under acquisition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:BFO_0000040 ns1:IAO_0000030 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0000059 ;
                    owl:someValuesFrom ns1:OBI_0001755 ] ],
        ns1:OBI_0001928 .

ns1:OBI_0600009 a owl:Class ;
    rdfs:label "exposure of material to environment"@en ;
    ns1:IAO_0000111 "exposure of material to environment"@en ;
    ns1:IAO_0000112 "Putting cells in a freezer at -80C.  Cy5-labeled DNA is irradiated with a laser to excite the fluorophore. Inducing a phase transition in a material by putting it in an environment with a specific temperature. Oxygen deprivation in a chamber."@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a planned process in which an input material is exposed to a defined set of conditions in a controlled environment. The environment is a specified input."@en ;
    ns1:IAO_0000117 "Bjoern Peters"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    ns1:IAO_0000232 "Alan says there will be problmes, e.g. with selection by survival"@en ;
    rdfs:subClassOf ns1:OBI_0000011 .

ns1:OBI_0600013 a owl:Class ;
    rdfs:label "information acquisition"@en ;
    ns1:IAO_0000111 "information acquisition"@en ;
    ns1:IAO_0000112 "Gathering all influenza HA sequences from GenBank, Retrieveing HLA allele frequencies in the North American populations from dbMHC"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An acquisition in which possession of information is gained."@en ;
    ns1:IAO_0000116 "This excludes processes that create or change information, such as assays and data transformations." ;
    ns1:IAO_0000117 "Bjoern Peters"@en ;
    ns1:IAO_0000118 "data collection"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        ns1:OBI_0600008 .

ns1:OBI_0600017 a owl:Class ;
    rdfs:label "assay detecting a molecular label" ;
    ns1:IAO_0000111 "assay detecting a molecular label" ;
    ns1:IAO_0000112 "Determination of the amount of phycoerytherin label present in a cell population stained with anti-CD8-PE in order to determine the percentage of CD8+ T cells present"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An assay that detects the presence or a quality of a molecular label which is a proxy for the detection of the molecular target to which the label is attached"^^xsd:string ;
    ns1:IAO_0000117 "Matthew Brush"^^xsd:string ;
    ns1:IAO_0000119 "OBI developer call, 3-12-12"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000109 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0001936 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:OBI_0001936 ] ],
        ns1:OBI_0000070 .

ns1:OBI_0600024 a owl:Class ;
    rdfs:label "maintaining cell culture"@en ;
    ns1:IAO_0000111 "maintaining cell culture"@en ;
    ns1:IAO_0000112 "When harvesting blood from a human, isolating T cells, and then limited dilution cloning of the cells, the maintaining_cell_culture step comprises all steps after the initial dilution and plating of the cells into culture, e.g. placing the culture into an incubator, changing or adding media, and splitting a cell culture"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application in which cells are kept alive in a defined environment outside of an organism.  part of cell_culturing"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:OBI_0000079 ns1:OBI_0001912 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000806 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        ns1:OBI_0000838 .

ns1:OBI_0600033 a owl:Class ;
    rdfs:label "cell permeabilization"@en ;
    ns1:IAO_0000111 "cell permeabilization"@en ;
    ns1:IAO_0000112 "Electroporation of HeLa cells to allow transfection with pUC19."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A protocol application to permeabilize cell membranes, allowing molecules to more easily pass through the membrane than was possible prior to the protocol application"@en ;
    ns1:IAO_0000116 "need to add output cell has_quality permeable"@en ;
    ns1:IAO_0000117 "PERSON:Bjoern Peters"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "definition blessed by Jay, Alan, Randi"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:CL_0000000 ],
        [ a owl:Restriction ;
