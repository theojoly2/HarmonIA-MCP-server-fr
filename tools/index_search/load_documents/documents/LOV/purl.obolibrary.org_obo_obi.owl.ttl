    ns1:IAO_0000111 "exposure to asbestos history" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An exposure to environmental and workplace carcinogens history where the carcinogen is asbestos."^^xsd:string ;
