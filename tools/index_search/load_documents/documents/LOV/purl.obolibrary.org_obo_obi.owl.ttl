    ns1:IAO_0000111 "sequence-specific DNA binding"^^xsd:string ;
    ns1:IAO_0000115 "Interacting selectively and non-covalently with DNA of a specific nucleotide composition, e.g. GC-rich DNA binding, or with a specific sequence motif or type of DNA e.g. promotor binding or rDNA binding."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:OBI_0001588 .

ns1:GO_0050896 a owl:Class ;
    rdfs:label "response to stimulus"^^xsd:string ;
    ns1:IAO_0000111 "response to stimulus"^^xsd:string ;
    ns1:IAO_0000115 "Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus. The process begins with detection of the stimulus and ends with a change in state or activity or the cell or organism."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0071604 a owl:Class ;
    rdfs:label "transforming growth factor beta production"^^xsd:string ;
    ns1:IAO_0000111 "transforming growth factor beta production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of any member of the transforming growth factor-beta family of cytokines due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. Transforming growth factor-beta family members include TGF-B1, TGF-B2, and TGF-B3."^^xsd:string ;
