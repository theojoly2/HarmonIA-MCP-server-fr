ns1:CL_0000001 a owl:Class ;
    rdfs:label "primary cultured cell"^^xsd:string ;
    ns1:IAO_0000111 "primary cultured cell"^^xsd:string ;
    ns1:IAO_0000115 "A cultured cell that is freshly isolated from a organismal source, or derives in culture from such a cell prior to the culture being passaged."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty ns1:OBI_0000312 ;
                    owl:someValuesFrom ns1:OBI_0600037 ] ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0001000 ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:intersectionOf ( ns1:CL_0000010 [ a owl:Restriction ;
                                        owl:onProperty ns1:OBI_0000312 ;
                                        owl:someValuesFrom ns1:OBI_0600037 ] ) ] ] ],
        ns1:CL_0000010 .

ns1:CL_0000010 a owl:Class ;
    rdfs:label "cultured cell"^^xsd:string ;
    ns1:IAO_0000111 "cultured cell"^^xsd:string ;
    ns1:IAO_0000115 "A cell in vitro that is or has been maintained or propagated as part of a cell culture."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom ns1:OBI_0600036 ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0001000 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000312 ;
                                owl:someValuesFrom ns1:OBI_0600036 ] ] ) ],
        ns1:CL_0000578 .

