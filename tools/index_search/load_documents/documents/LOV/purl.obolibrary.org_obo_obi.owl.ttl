    ns1:IAO_0000115 "High molecular weight, linear polymers, composed of nucleotides containing deoxyribose and linked by phosphodiester bonds; DNA contain the genetic information of organisms."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_33696 .

ns1:CHEBI_33697 a owl:Class ;
    rdfs:label "ribonucleic acid"^^xsd:string ;
