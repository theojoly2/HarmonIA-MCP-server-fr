    ns1:IAO_0000111 "obsolete intracellular material detection by flow cytometry assay" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An assay in which the presence of a material inside a cell is measured by permeabilizing the cell membrane to allow entry of specific antibodies, and counting the stained cells using a flow cytometer."^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000227 ;
    ns1:IAO_0100001 ns1:OBI_0000916 ;
    ns1:OBI_9991118 "intracellular staining"^^xsd:string ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000858 a owl:Class ;
    rdfs:label "record of unknown sex"^^xsd:string ;
    ns1:IAO_0000111 "record of unknown sex"^^xsd:string ;
    ns1:IAO_0000112 "A database record indicating that the tissue sample in a microarray experiment came from an organism for which the biological sex is not known to the person who created the record."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a record indicating that the biological sex of an organism is not known."^^xsd:string ;
    ns1:IAO_0000116 "I think the statement is still about the instance of the biological sex quality of an organism. It is also about information available to the person making the statement."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:PATO_0000047 ],
        ns1:OBI_0000852 .

ns1:OBI_0000860 a owl:Class ;
    rdfs:label "northern blot assay" ;
    ns1:IAO_0000111 "northern blot assay" ;
    ns1:IAO_0000112 "The level of actin mRNA levels in normal and diseased tiisue was measured using a northern blot assay."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An assay that determines the presence of gene transcripts by hybridizing labeled RNA or DNA probes against messenger RNAs isolated from tissue or cell cultures, resolved on denaturing gel, transfered by a blotting procedure to a solid support. Detection of hybridization signals is carried out by immunofluorescence or radioactivity measurements using photographic films or digital imaging devices such as Phosphor Imager."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Richard Scheuermann"^^xsd:string ;
    ns1:IAO_0000118 "northern blot"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000275 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:CHEBI_33697 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:CHEBI_33697 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000109 ],
        ns1:OBI_0000443 .

ns1:OBI_0000861 a owl:Class ;
    rdfs:label "Likelihood-ratio test"^^xsd:string ;
    ns1:IAO_0000111 "Likelihood-ratio test"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Likelihood-ratio is a data transformation which tests whether there is evidence of the need to move from a simple model to a more complicated one (where the simple model is nested within the complicated one); tests of the goodness-of-fit between two models."^^xsd:string ;
    ns1:IAO_0000117 "Tina Boussard"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 .

