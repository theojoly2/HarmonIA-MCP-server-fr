ns1:OBI_0000018 a owl:Class ;
    rdfs:label "material supplier role"@en ;
    ns1:IAO_0000111 "material supplier role"^^xsd:string ;
    ns1:IAO_0000112 "Jackson Labs is an organization which provide mice as experimental material"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role realized through the process of supplying materials such as animal subjects, reagents or other materials used in an investigation."@en ;
    ns1:IAO_0000116 "Supplier role is a special kind of service, e.g. biobank"^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "material provider role"^^xsd:string,
        "supplier"^^xsd:string ;
