ns1:OBI_1110300 a owl:Class ;
    rdfs:label "direct submission to IEDB"^^xsd:string ;
    ns1:IAO_0000111 "direct submission to IEDB"^^xsd:string ;
    ns1:IAO_0000112 "The report on \"Identification of a dominant CD4 T cell epitope in the membrane lipoprotein Tul4 from Francisella tularensis LVS. \" submitted by Valentino et al to the IEDB. \\n\\nThe content of that report on the IEDB website is here: http://iedb.org/refId/1013357"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A report about experiments in an investigation that characterize immune epitopes, and was submitted directly by the authors to the Immune Epitope Database (IEDB)"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000088 .

ns1:OBI_1200000 a owl:Class ;
    rdfs:label "FFPE specimen" ;
    ns1:IAO_0000111 "FFPE specimen" ;
    ns1:IAO_0000112 "Many of today’s researchers prefer to use Formalin-Fixed Paraffin-Embedded samples of tissues for their IHC, histological or in-situ genomic analyses. Professionally fixed and embedded FFPE samples and the biomolecules they contain are reasonably stable at ambient temperatures.\\n\\n-based on https://lab-ally.com/histopathology-resources/ffpe-samples/" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A specimen that has been fixed in formalin and embedded in paraffin." ;
    ns1:IAO_0000117 "MIABIS" ;
    ns1:IAO_0000118 "formalin-fixed paraffin-embeded specimen" ;
    ns1:IAO_0000119 <https://www.biochain.com/general/what-is-ffpe-tissue/> ;
    ns1:IAO_0000233 <https://github.com/obi-ontology/obi/issues/1019> ;
    rdfs:subClassOf ns1:OBI_0000950 .

