ns1:OBI_0000846 a owl:ObjectProperty ;
    rdfs:label "is member of organization"^^xsd:string ;
    ns1:IAO_0000111 "is member of organization"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Relating a legal person or organization to an organization in the case where the legal person or organization has a role as member of the organization."^^xsd:string ;
    ns1:IAO_0000116 "2009/10/01 Alan Ruttenberg. Barry prefers generic is-member-of. Question of what the range should be. For now organization. Is organization a population? Would the same relation be used to record members of a population"^^xsd:string,
        "JZ: Discussed on May 7, 2012 OBI dev call. Bjoern points out that we need to allow for organizations to be members of organizations. And agreed by the other OBI developers. So, human and organization were specified in 'Domains'. The textual definition was updated based on it."^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string,
        "Person:Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000119 "Person:Alan Ruttenberg"^^xsd:string,
        "Person:Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:NCBITaxon_9606 ns1:OBI_0000245 ) ] ;
    rdfs:range ns1:OBI_0000245 ;
    owl:inverseOf ns1:OBI_0001688 .

ns1:OBI_0000893 a owl:Class ;
    rdfs:label "real time polymerase chain reaction assay" ;
    ns1:IAO_0000111 "real time polymerase chain reaction assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay, based on the PCR, that amplifies and simultaneously quantifies a specific DNA molecule based on the use of complementary probes/primers. It enables both detection and quantification (as absolute number of copies or relative amount when normalized to DNA input or additional normalizing genes) of one or more specific sequences in a DNA sample."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    ns1:IAO_0000118 "Q-PCR"^^xsd:string,
        "kinetic polymerase chain reaction"^^xsd:string,
        "qPCR"^^xsd:string,
        "quantitative real time polymerase chain reaction"^^xsd:string ;
    ns1:IAO_0000119 "url:http://en.wikipedia.org/wiki/Real-time_polymerase_chain_reaction"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000415 ],
        ns1:OBI_0000070 .

ns1:OBI_0000902 a owl:Class ;
    rdfs:label "post mortem specimen"^^xsd:string ;
    ns1:IAO_0000111 "post mortem specimen"^^xsd:string ;
    ns1:IAO_0000112 "the spleen taken from a dead mouse"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a specimen that was taken from a dead organism"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "MO_416 postmortem"@en ;
    rdfs:subClassOf ns1:OBI_0001506 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000659 [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000293 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:OBI_0100026 [ a owl:Restriction ;
                                                    owl:onProperty ns1:RO_0000086 ;
                                                    owl:someValuesFrom ns1:PATO_0001422 ] ) ] ] ) ] ] .

ns1:OBI_0000903 a owl:Class ;
    rdfs:label "in vitro cell killing assay" ;
    ns1:IAO_0000111 "in vitro cell killing assay" ;
    ns1:IAO_0000112 "Autologous EBV-transformed B-LCL were used as target cells for the influenza virus-specific CTL assays. Equal volumes of target and effector cells were added to tissue culture plates, and 1:2 serial dilutions of effectors were made. After a 4-h incubation of the effector cells with the target cells, supernatants were collected and counted with the LKB 1272 Clinigamma counter. Percent specific killing was determined with the following equation: (experimental 51Cr release - spontaneous 51Cr release)/(maximum 51Cr release - spontaneous 51Cr release) x 100."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cell killing assay that measures if and how many target cells are actively killed by other cells in a cell culture."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000882 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000882 [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000055 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000081 ;
                                                        owl:someValuesFrom ns1:OBI_0100060 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0100060 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000087 ;
                                                        owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ] ) ] .

ns1:OBI_0000905 a owl:Class ;
