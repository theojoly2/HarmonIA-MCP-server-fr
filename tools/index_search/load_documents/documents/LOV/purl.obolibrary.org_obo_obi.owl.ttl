ns1:OBI_0002438 a owl:Class ;
    rdfs:label "nuclear ligation assay" ;
    ns1:IAO_0000111 "nuclear ligation assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that detects the proximity of chromosomal DNA through the use of a ligation reaction in isolated nuclei."^^xsd:string ;
