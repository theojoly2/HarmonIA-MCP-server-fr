ns1:GO_0034343 a owl:Class ;
    rdfs:label "type III interferon production"^^xsd:string ;
    ns1:IAO_0000111 "type III interferon production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of type III interferon due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. Interferon lambda is the only member of the type III interferon found so far."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0040029 a owl:Class ;
    rdfs:label "regulation of gene expression, epigenetic"^^xsd:string ;
    ns1:IAO_0000111 "regulation of gene expression, epigenetic"^^xsd:string ;
    ns1:IAO_0000115 "Any process that modulates the frequency, rate or extent of gene expression; the process is mitotically or meiotically heritable, or is stably self-propagated in the cytoplasm of a resting cell, and does not entail a change in DNA sequence."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0040030 .

ns1:GO_0042605 a owl:Class ;
    rdfs:label "peptide antigen binding"^^xsd:string ;
    ns1:IAO_0000111 "peptide antigen binding"^^xsd:string ;
    ns1:IAO_0000115 "Interacting selectively and non-covalently with an antigen peptide."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0003823 .

ns1:GO_0070358 a owl:Class ;
    rdfs:label "actin polymerization-dependent cell motility"^^xsd:string ;
    ns1:IAO_0000111 "actin polymerization-dependent cell motility"^^xsd:string ;
    ns1:IAO_0000115 "A process involved in the controlled movement of a bacterial cell powered by the continuous polymerization of actin at one pole of the cell."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:IAO_0000006 a owl:Class ;
    rdfs:label "narrative object"@en ;
    ns1:IAO_0000111 "narrative object"@en ;
    ns1:IAO_0000112 "Examples of narrative objects are reports, journal  articles, and patents submission."@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A narrative object is an information content entity that is a set of propositions."@en ;
    ns1:IAO_0000116 "2009-08-10 Alan Ruttenberg: Larry Hunter suggests that this be obsoleted and replaced by 'textual entity' and 'figure'. Alan restored as there are OBI dependencies and this merits further discussion"@en,
        "agree - DENRIE. Issue(alan) do we only mean text? What about a story told by mime. Does music count? (no) what about an oral report. Regarding definition, saying it is a set of propositions means we loose the idea that wording matters. Maybe adjust saying a narrative object has some relationshop to a set of propositions"@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000013"@en,
        "group:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:IAO_0000008 a owl:Class ;
    rdfs:label "obsolete_artifact"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000012 a owl:Class ;
    rdfs:label "obsolete2_digital entity"@en ;
    ns1:IAO_0000111 "obsolete_digital entity"@en ;
    ns1:IAO_0000115 "A digital entity is an information entity which is a collection of bits that can be interpreted by a computer. Two digital entities are the same if they are bitwise identical."@en ;
    ns1:IAO_0000116 "3/22/2009 Alan Ruttenberg, obsoleted per http://groups.google.com/group/information-ontology/browse_thread/thread/789ad4b7708d5cf4\\n\\nSuperclass was 'digitial quality'"@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000261"^^xsd:string,
        "group:OBI"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000015 a owl:Class ;
    rdfs:label "information carrier"@en ;
    ns1:IAO_0000111 "information carrier"@en ;
    ns1:IAO_0000112 "In the case of a printed paperback novel the physicality of the ink and of the paper form part of the information bearer. The qualities of appearing black and having a certain pattern for the ink and appearing white for the paper form part of the information carrier in this case."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A quality of an information bearer that imparts the information content"@en ;
    ns1:IAO_0000116 "2014-03-10: We are not certain that all information carriers are qualities. There was a discussion of dropping it.",
        "12/15/09: There is a concern that some ways that carry information may be processes rather than qualities, such as in a 'delayed wave carrier'."@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "Smith, Ceusters, Ruttenberg, 2000 years of philosophy"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000019 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000059 ;
                        owl:someValuesFrom ns1:IAO_0000030 ] ) ] .

ns1:IAO_0000017 a owl:Class ;
    rdfs:label "model number"@en ;
    ns1:IAO_0000111 "model number"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A model number is an information content entity specifically borne by catalogs, design specifications, advertising materials, inventory systems and similar  that is about manufactured objects of the same class. The model number is an alternative term for the class. The manufactered objects may or may not also bear the model number. Model numbers can be encoded in a variety of other information objects, such as bar codes, numerals, or patterns of dots."@en ;
    ns1:IAO_0000116 "manufactered items may have more than one model number, sometimes by rebranding, or because companies are sold and the products issued new model numbers"@en ;
    ns1:IAO_0000117 "Person: Alan Ruttenberg"@en ;
    rdfs:subClassOf ns1:IAO_0000028 .

ns1:IAO_0000018 a owl:Class ;
    rdfs:label "obsolete_material_entity"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000226 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000019 a owl:Class ;
    rdfs:label "obsolete2_binary digital entity"@en ;
    ns1:IAO_0000111 "binary digital entity"@en ;
    ns1:IAO_0000112 "MS Word document, ZIP file, DICOM file, JPEG file"@en ;
    ns1:IAO_0000115 "A binary digital entity is a digital entity that is encoded in a way that is not easily human readable and that contains other than text characters."@en ;
    ns1:IAO_0000116 "3/22/2009 Alan Ruttenberg, obsoleted per http://groups.google.com/group/information-ontology/browse_thread/thread/789ad4b7708d5cf4\\nSuperclass was 'digital entity'"@en,
        "digital_entity"@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000244"^^xsd:string,
        "group:OBI"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000024 a owl:Class ;
    rdfs:label "obsolete_unit of measure"^^xsd:string ;
    ns1:IAO_0000112 "The length of a ruler."^^xsd:string ;
    ns1:IAO_0000115 "a unit of measure is the quality of some material entity compared to which another quality is some multiple of."^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "Smith, Ceusters, Ruttenberg, 2000 years of philosophy"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000025 a owl:Class ;
    rdfs:label "programming language"@en ;
    ns1:IAO_0000111 "programming language"@en ;
    ns1:IAO_0000112 "R, Perl, Java"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A language in which source code is written that is intended to be executed/run by a software interpreter. Programming languages are ways to write instructions that specify what to do, and sometimes, how to do it."@en ;
    ns1:IAO_0000117 "person:Alan Ruttenberg"@en,
        "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000058"@en,
        "group:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000104 .

ns1:IAO_0000031 a owl:Class ;
    rdfs:label "integer numeral"@en ;
    ns1:IAO_0000111 "integer numeral"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a numeral that denotes an integer"@en ;
    ns1:IAO_0000117 "PERSON: Jonathan Rees"@en ;
    rdfs:subClassOf ns1:IAO_0000029 .

ns1:IAO_0000034 a owl:Class ;
    rdfs:label "time trigger"@en ;
    ns1:IAO_0000111 "time trigger"@en ;
    ns1:IAO_0000114 ns1:IAO_0000124 ;
    ns1:IAO_0000115 "revisit?"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en,
        "OBI_0000331"@en ;
    rdfs:subClassOf ns1:IAO_0000001 .

ns1:IAO_0000035 a owl:Class ;
    rdfs:label "obsolete_study interpretation"@en ;
    ns1:IAO_0000111 "obsolete_study interpretation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A study interpretation is a textual entity about the implications of a study result. Examples include discussion of whether a hypothesis is false, whether the study failed to address the hypothesis, and whether the study results have led to new hypotheses"@en ;
    ns1:IAO_0000116 "2009-03-16: definition was \"A conclusion is a narrative object which can be published in a paper summerizing and interpreting a protocol application.\""^^xsd:string,
        "2009-03-16: work has been done on this term during during the OBI workshop winter 2009 and the current definition was considered acceptable for use in OBI. If there is a need to modify this definition please notify OBI."^^xsd:string,
        "The obsoleting of narrative object required a modest change in the definition of this term.  Circularity with \"interpretation... interprets\" has been removed, using \"about the implications\" instead."@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"^^xsd:string,
        "PERSON: Melanie Courtot"^^xsd:string,
        "Lawrence Hunter"@en,
        "PERSON: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "conclusion"^^xsd:string ;
    ns1:IAO_0000119 "OBI_0000005"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000047 a owl:Class ;
    rdfs:label "obsolete2_text based digital entity"@en ;
    ns1:IAO_0000111 "text based digital entity"@en ;
    ns1:IAO_0000112 "XML file, C++ source code file"@en ;
    ns1:IAO_0000115 "A text based digital entity is a digital entity that is encoded so that it only contains text characters."@en ;
    ns1:IAO_0000116 "3/22/2009 Alan Ruttenberg, obsoleted per http://groups.google.com/group/information-ontology/browse_thread/thread/789ad4b7708d5cf4\\nsuperclass was 'digital document'"@en,
        "digital_entity"@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000132"^^xsd:string,
        "group:OBI"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000057 a owl:Class ;
    rdfs:label "contour plot"@en ;
    ns1:IAO_0000111 "contour plot"@en ;
    ns1:IAO_0000112 "Contour plot of SSC-H, FSC-H, and FL1-H."@en ;
    ns1:IAO_0000114 ns1:IAO_0000002 ;
    ns1:IAO_0000116 "generically_dependent_continuants"@en ;
    ns1:IAO_0000117 "person:Allyson Lister"@en,
