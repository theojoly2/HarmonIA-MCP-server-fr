    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process of an immunoglobulin complex binding to a material entity at the immunoglobulin complementarity determining region (CDR). "^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
