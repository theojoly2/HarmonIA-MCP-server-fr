    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:OBI_0000164 .

ns1:OBI_0002482 a owl:Class ;
    rdfs:label "specimen harvest quantity"@en ;
    ns1:IAO_0000111 "specimen harvest quantity"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A scalar measurement datum that indicates the amount of specimen collected."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    ns1:IAO_0000118 "harvest quantity"@en ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:OBI_0002483 a owl:Class ;
    rdfs:label "spike-in dilution factor"@en ;
    ns1:IAO_0000111 "spike-in dilution factor"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data item that indicates the dilution of spike-in added to a specimen."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:IAO_0000027 .

ns1:OBI_0002484 a owl:Class ;
    rdfs:label "star algorithm"@en ;
    ns1:IAO_0000111 "star algorithm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A reference genome transcriptome alignment algorithm that is a standalone RNA-seq alignment algorithm that uses uncompressed suffix arrays and a mapping algorithm similar to those used in large-scale genome alignment tools to align RNA-seq reads to a genomic reference."@en ;
    ns1:IAO_0000119 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en,
        "https://www.ncbi.nlm.nih.gov/pubmed/23104886"@en ;
    rdfs:subClassOf ns1:OBI_0002478 .

ns1:OBI_0002485 a owl:Class ;
    rdfs:label "transcript analysis by single-end sequencing assay" ;
    ns1:IAO_0000111 "transcript analysis by single-end sequencing assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A sequencing assay that incorporates single-end reads and sequencing technology to determine transcripts, gene structures, and gene expressions."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string,
        "Junhyong Kim"^^xsd:string,
        "Stephen A. Fisher"^^xsd:string ;
    ns1:IAO_0000118 "transcript analysis by single-end sequencing"^^xsd:string ;
    ns1:IAO_0000119 "url:https://www.illumina.com/science/technology/next-generation-sequencing/paired-end-vs-single-read-sequencing.html"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0600047 .

ns1:OBI_0002486 a owl:Class ;
    rdfs:label "verse algorithm"@en ;
    ns1:IAO_0000111 "verse algorithm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An alignment counting algorithm that assigns gene features to genomic alignments using a hierarchical assignment scheme, which allows simultaneous quantification of multiple feature types or annotation levels without repeatedly assigning reads."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim"@en ;
    ns1:IAO_0000119 "http://kim.bio.upenn.edu/software/verse.shtml or http://biorxiv.org/content/early/2016/05/14/053306"@en ;
    rdfs:subClassOf ns1:OBI_0002466 .

ns1:OBI_0002487 a owl:Class ;
    rdfs:label "microraft"@en ;
    ns1:IAO_0000111 "microraft"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A material separation device also commerically known as Isoraft, that is used to isolate single cells."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    ns1:IAO_0000119 "https://en.wikipedia.org/wiki/Microrafts"@en ;
    rdfs:subClassOf ns1:OBI_0000932 .

ns1:OBI_0002488 a owl:Class ;
    rdfs:label "pipette"@en ;
    ns1:IAO_0000111 "pipette"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A device that is a laboratory tool commonly used in chemistry, biology and medicine to transport a measured volume of liquid, often as a media dispenser."@en ;
