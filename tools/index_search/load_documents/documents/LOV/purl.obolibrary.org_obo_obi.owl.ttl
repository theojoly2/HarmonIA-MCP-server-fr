ns1:OBI_0001966 a owl:Class ;
    rdfs:label "sequence library data demultiplexing"@en ;
    ns1:IAO_0000111 "sequence library data demultiplexing"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "is a data transformation which uses sequence alignment and  'multiplex identifier sequence' information to separate all reads belonging to a given single sample following the sequencing of a multiplexed library"@en ;
