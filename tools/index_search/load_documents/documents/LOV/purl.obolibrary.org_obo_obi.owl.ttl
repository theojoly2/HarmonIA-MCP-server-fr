            owl:intersectionOf ( ns1:OBI_0000443 [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000055 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0000086 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000052 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( ns1:CHEBI_33696 [ a owl:Restriction ;
                                                                            owl:onProperty ns1:RO_0000087 ;
                                                                            owl:someValuesFrom ns1:OBI_0000857 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:CHEBI_33696 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000087 ;
                                                        owl:someValuesFrom ns1:OBI_0000857 ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
