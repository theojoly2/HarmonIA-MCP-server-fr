    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en,
        "http://www.biotech.ist.unige.it/cldb/cl5296.html"@en ;
    rdfs:subClassOf ns1:CLO_0009828 .

