    ns1:IAO_0000119 "doi:10.1038/ng1007-1181"@en ;
    rdfs:subClassOf ns1:IAO_0000577 .

ns1:OBI_0002473 a owl:Class ;
    rdfs:label "material amplification role"@en ;
    ns1:IAO_0000111 "material amplification role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A worker role played by the person who runs the enzymatic amplifying process."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:OBI_0000116 .

