ns1:OBI_0000913 a owl:Class ;
    rdfs:label "promoter activity detection by reporter gene assay" ;
    ns1:IAO_0000111 "promoter activity detection by reporter gene assay" ;
    ns1:IAO_0000112 "A T cell hybridoma in which the beta-galactosidase gene (lacZ) was inserted under the control of the IL-2 promoter, is detected by adding the X-gal substrate which when cleaved by lacZ results in detectable blue color."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay in which the activity of a promoter in a cell is monitored by using a reporter gene that was inserted in a genomic location under control of the promoter and whose expression can be easily detected based on qualities or functions of the gene."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:CL_0000000 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0001047 ] ],
        ns1:OBI_0000070 .

ns1:OBI_0000915 a owl:Class ;
    rdfs:label "freezing storage"^^xsd:string ;
    ns1:IAO_0000111 "freezing storage"^^xsd:string ;
    ns1:IAO_0000112 "a fozen pellet used for later assay"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A storage process in temperature that maintenance the frozen status of the stored entities."^^xsd:string ;
    ns1:IAO_0000116 "2010/3/3 Alan Ruttenberg: There is a question of whether we should have a separate objective to \"prepare for maintenance\"\\n2014/2/3 OBI dev call: \"prepare for maintenance\" is a separate process. For example, 'freezing' and 'flash freezing' are defined and can be used to produce frozen material for storage.\\nUpdated both textual and logical definition. Both input and output material of freezing storage have quality frozen."^^xsd:string ;
    ns1:IAO_0000117 "Person: Alan Ruttenberg, Mathias Brochhausen"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string,
        "MO_481 frozen_storage"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000086 ;
                                            owl:someValuesFrom ns1:PATO_0001985 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000086 ;
                                            owl:someValuesFrom ns1:PATO_0001985 ] ) ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000806 ],
        ns1:OBI_0302893 .

