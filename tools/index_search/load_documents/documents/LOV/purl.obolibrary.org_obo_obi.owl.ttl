    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A transcription profiling assay that is performed using a very low amount (nanogram scale) of mRNA samples using Cap analysis gene expression (CAGE)."^^xsd:string ;
    ns1:IAO_0000117 "Marcus Chibucos"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
