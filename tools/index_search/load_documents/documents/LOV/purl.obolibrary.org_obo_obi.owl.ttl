ns1:OBI_0000423 a owl:Class ;
    rdfs:label "extract"@en ;
    ns1:IAO_0000111 "extract"@en ;
    ns1:IAO_0000112 "Up-regulation of inflammatory signalings by areca nut extract and role of cyclooxygenase-2 -1195G>a polymorphism reveal risk of oral cancer. Cancer Res. 2008 Oct 15;68(20):8489-98. PMID: 18922923"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "an extract is a material entity which results from an extraction process"@en ;
