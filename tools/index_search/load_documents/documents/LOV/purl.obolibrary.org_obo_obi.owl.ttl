ns1:OBI_0000102 a owl:Class ;
    rdfs:label "responsible party role"@en ;
    ns1:IAO_0000111 "responsible party role"^^xsd:string ;
    ns1:IAO_0000112 "he THERAPIST has the ability to print a separate statement for the patient and each responsible party. http://www.beaverlog.com/therapist/ez_support/billing/responsible_party_statements.htm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a study personnel role played by a party who is accountable for the execution of a study component and can make decisions about the conduct of the study"@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
