    rdfs:label "number of rounds of amplification"@en ;
    ns1:IAO_0000111 "number of rounds of amplification"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data item that is the number of times an amplification reaction happened."@en ;
