ns1:IAO_0000400 a owl:Class ;
    rdfs:label "cartesian spatial coordinate datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cartesian spatial coordinate datum is a representation of a point in a spatial region, in which equal changes in the magnitude of a coordinate value denote length qualities with the same magnitude"@en ;
    ns1:IAO_0000116 "2009-08-18 Alan Ruttenberg - question to BFO list about whether the BFO sense of the lower dimensional regions is that they are always part of actual space (the three dimensional sort) http://groups.google.com/group/bfo-discuss/browse_thread/thread/9d04e717e39fb617"@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en ;
    ns1:IAO_0000232 "AR notes: We need to discuss whether it should include site." ;
    rdfs:seeAlso "http://groups.google.com/group/bfo-discuss/browse_thread/thread/9d04e717e39fb617"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000219 ;
            owl:someValuesFrom ns1:BFO_0000018 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:IAO_0000407 ],
        ns1:IAO_0000027 .

ns1:NCBITaxon_11676 a owl:Class ;
    rdfs:label "Human immunodeficiency virus 1"^^xsd:string ;
    ns1:IAO_0000111 "Human immunodeficiency virus 1"^^xsd:string ;
    ns1:IAO_0000412 ns1:ncbitaxon.owl ;
    rdfs:subClassOf ns1:NCBITaxon_11652 .

ns1:OBI_0000025 a owl:Class ;
    rdfs:label "reference substance role"@en ;
    ns1:IAO_0000111 "reference substance role"^^xsd:string ;
    ns1:IAO_0000112 "Calibration standard, positive control substance, vehicle   Good Laboratory Practices: Questions and Answers - Test Control and Reference Substance Characterization  http://www.epa.gov/enforcement/monitoring/programs/fifra/glpqanda-character.html"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role inhering in a material entity that is realized when  characteristics or responses elicited by the substance are used for comparison or reference."@en ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "reference substance"^^xsd:string ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        ns1:BFO_0000023 .

ns1:OBI_0000097 a owl:Class ;
    rdfs:label "participant under investigation role"@en ;
    ns1:IAO_0000111 "study subject role"@en ;
    ns1:IAO_0000112 "Human subjects in a clinical trial, rats in a toxicogenomics study, tissue cutlures subjected to drug tests, fish observed in an ecotoxicology study. \\nParasite example: people are infected with a parasite which is then extracted; the particpant under investigation could be the parasite, the people, or a population of which the people are members, depending on the nature of the study.\\nLake example: a lake could realize this role in an investigation that assays pollution levels in samples of water taken from the lake."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A role that is realized through the execution of a study design in which the bearer of the role participates and in which data about that bearer is collected."^^xsd:string ;
    ns1:IAO_0000116 "A participant can realize both \"specimen role\" and \"participant under investigation role\" at the same time. However \"participant under investigation role\" is distinct from \"specimen role\", since a specimen could somehow be involved in an investigation without being the thing that is under investigation." ;
    ns1:IAO_0000117 "GROUP:  Role Branch"@en ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    ns1:IAO_0000232 "Following OBI call November 2012,26th:\\n \\n1. it was decided there was no need for moving the children class and making them siblings of study subject role.\\n2. it also settles the disambiguation about 'study subject'. This is about the individual participating in the investigation/study, Not the 'topic' (as in 'toxicity study') of the investigation/study\\n\\nThis note closes the issue and validates the class definition to be part of the OBI core\\neditor = PRS\\n"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000471 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000023 .

ns1:OBI_0000107 a owl:ObjectProperty ;
    rdfs:label "provides_service_consumer_with" ;
    ns1:IAO_0000111 "provides_service_consumer_with" ;
    ns1:IAO_0000112 "The provides_service_consumer_with relation links the service to its primary process it provides for the consumer (as opposed to secondary processual parts of a service process such as payment or documentation).  For example, a 'DNA sequencing service' provides_service_consumer_with 'DNA sequencing' as the essential process performed by the provider for the client." ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A relation between a service and the primary processual part of the service that is performed by the provider for the consumer." ;
    rdfs:domain ns1:OBI_0001173 ;
    rdfs:subPropertyOf ns1:BFO_0000051 .

ns1:OBI_0000113 a owl:Class ;
    rdfs:label "sequence feature identification objective"@en ;
    ns1:IAO_0000111 "sequence feature identification objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Sequence_feature_identification_objective is a biological_feature_identification_objective role describing a study designed to examine or characterize molecular features exhibited at the level of a macromolecular sequence, e.g. nucleic acid, protein, polysaccharide."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000015 .

ns1:OBI_0000202 a owl:Class ;
    rdfs:label "investigation agent role"^^xsd:string ;
    ns1:IAO_0000111 "investigation agent role"^^xsd:string ;
    ns1:IAO_0000112 "The person perform microarray experiments and submit microarray results (including raw data, processed data) with experiment description to ArrayExpress."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A role borne by an entity and that is realized in a process that is part of an investigation in which an objective is achieved. These processes include, among others: planning, overseeing, funding, reviewing."@en ;
    ns1:IAO_0000116 "Implementing a study means carrying out or performing the study and providing reagents or other materials used in the study and other tasks without which the study would not happen."^^xsd:string,
        "Philly2013: Historically, this role would have been borne only by humans or organizations. However, we now also want to enable representing investigations run by robot scientists such as ADAM (King et al, Science, 2009)" ;
    ns1:IAO_0000117 "GROUP:  Role Branch"@en ;
    ns1:IAO_0000118 "investigator"^^xsd:string ;
    ns1:IAO_0000119 "OBI"@en ;
    ns1:IAO_0000232 "Feb 10, 2009.  changes after discussion at OBI Consortium Workshop Feb 2-6, 2009.  accepted as core term."^^xsd:string ;
    ns1:OBI_0001847 "study person role"^^xsd:string ;
    rdfs:comment "Philly2013: Historically, this role would have been borne only by humans or organizations. However, we now also want to enable investigations run by robot scientists such as ADAM (King et al, Science, 2009)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000066 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000023 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000023 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000052 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000053 ;
                                owl:someValuesFrom [ a owl:Restriction ;
                                        owl:onProperty ns1:RO_0000059 ;
                                        owl:someValuesFrom [ a owl:Restriction ;
                                                owl:onProperty ns1:OBI_0000833 ;
                                                owl:someValuesFrom [ a owl:Restriction ;
                                                        owl:onProperty ns1:BFO_0000050 ;
                                                        owl:someValuesFrom ns1:OBI_0000066 ] ] ] ] ] ) ] .

ns1:OBI_0000422 a owl:Class ;
    rdfs:label "syringe"@en ;
    ns1:IAO_0000111 "syringe"^^xsd:string ;
    ns1:IAO_0000112 "Accuracy of oral liquid measuring devices: comparison of dosing cup and oral dosing syringe.Ann Pharmacother. 2008 Jan;42(1):46-52. Epub 2007 Dec 4. PMID: 18056832"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a processed material which is used to introduce or draw fluids from a material entity. A syringe is made of a piston and body. the movement of the piston in the body determines the amount/volume of fluid to inject or draw"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "OBI Instrument adapted from Wikipedia"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000383 ],
        ns1:OBI_0000968 .

ns1:OBI_0000435 a owl:Class ;
    rdfs:label "genotyping assay" ;
    ns1:IAO_0000111 "genotyping assay" ;
    ns1:IAO_0000112 "High-throughput genotyping of oncogenic human papilloma viruses with MALDI-TOF mass spectrometry. Clin Chem. 2008 Jan;54(1):86-92. Epub 2007 Nov 2.PMID: 17981923"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay which generates data about a genotype from a specimen of genomic DNA. A variety of techniques and instruments can be used to produce information about sequence variation at particular genomic positions."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "SNP analysis"^^xsd:string,
        "genotype profiling"^^xsd:string ;
    ns1:IAO_0000119 "OBI Biomaterial"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:OBI_0001051 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0001051 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000113 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001305 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0100051 [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000051 ;
                                owl:someValuesFrom ns1:CHEBI_16991 ] ) ] ],
        ns1:OBI_0000443 .

ns1:OBI_0000470 a owl:Class ;
    rdfs:label "mass spectrometry assay" ;
    ns1:IAO_0000111 "mass spectrometry assay" ;
    ns1:IAO_0000112 "Identification of a proteins cut out from a 2D gel by cleaving it into peptides using trypsin digestion using electrospray ionizatino to ensure the peptides are charged, and accelerating them with an electro magnetic field in which the flight path is determined by the mass / charge ratio of the peptides. Comparing the mass/charge ratio of peptides in the proteins with databases of protein sequences allows to identify which protein gave rise to the peptides."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that identifies the amount and type of material entities present in a sample by fragmenting the sample and measuring the mass-to-charge ratio of the resulting particles."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "Philippe Rocca-Serra"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0000049 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0000049 ] ) ],
        ns1:OBI_0000070 .

