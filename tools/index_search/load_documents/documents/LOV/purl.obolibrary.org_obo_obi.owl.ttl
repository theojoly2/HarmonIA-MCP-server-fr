ns1:OBI_0000589 a owl:Class ;
    rdfs:label "chromatography pump system"@en ;
    ns1:IAO_0000111 "chromatography pump system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Better flow rates can be achieved by using a pump or by using compressed gas (e.g. air, nitrogen, or argon) to push the solvent through the column (flash column chromatography)."@en ;
