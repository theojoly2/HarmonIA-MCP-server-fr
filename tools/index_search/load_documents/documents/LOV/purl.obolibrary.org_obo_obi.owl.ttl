    ns1:IAO_0000111 "copyright section"@en ;
    ns1:IAO_0000112 "This work is licensed under a Creative Commons Attribution-Share Alike 3.0 United States License."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A document part that describes  legal restrictions on making or distributing copies of the document"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf ns1:IAO_0000314 .

ns1:IAO_0000401 a owl:Class ;
    rdfs:label "one dimensional cartesian spatial coordinate datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A cartesion spatial coordinate datum that  uses one value to specify a position along a one dimensional spatial region"@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:IAO_0000404 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000219 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000018 [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000050 ;
                                owl:someValuesFrom ns1:BFO_0000026 ] ) ] ],
        ns1:IAO_0000400 .

ns1:IAO_0000402 a owl:Class ;
    rdfs:label "two dimensional cartesian spatial coordinate datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A cartesion spatial coordinate datum that  uses two values to specify a position within a two dimensional spatial region"@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:IAO_0000406 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:IAO_0000404 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000219 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000018 [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000050 ;
                                owl:someValuesFrom ns1:BFO_0000009 ] ) ] ],
        ns1:IAO_0000400 .

ns1:IAO_0000403 a owl:Class ;
    rdfs:label "three dimensional cartesian spatial coordinate datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A cartesion spatial coordinate datum that  uses three values to specify a position within a three dimensional spatial region"@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000219 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000018 [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000050 ;
                                owl:someValuesFrom ns1:BFO_0000028 ] ) ] ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:IAO_0000404 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:IAO_0000406 ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:IAO_0000405 ],
        ns1:IAO_0000400 .

ns1:IAO_0000411 a owl:AnnotationProperty ;
    rdfs:label "is denotator type"^^xsd:string ;
    ns1:IAO_0000111 "is denotator type"@en ;
    ns1:IAO_0000115 "relates an class defined in an ontology, to the type of it's denotator"^^xsd:string ;
    ns1:IAO_0000116 "In OWL 2 add AnnotationPropertyRange('is denotator type' 'denotator type')"^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string .

ns1:IAO_0000412 a owl:AnnotationProperty ;
    rdfs:label "imported from"@en ;
    ns1:IAO_0000111 "imported from"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "For external terms/classes, the ontology from which the term was imported"@en ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
    rdfs:isDefinedBy ns1:iao.owl .

ns1:IAO_0000415 a owl:Class ;
    rdfs:label "hypothesis textual entity"@en ;
    ns1:IAO_0000111 "hypothesis textual entity"@en ;
    ns1:IAO_0000112 "that fucoidan has a small statistically significant effect on AT3 level but no useful clinical effect as in-vivo anticoagulant, a paraphrase of part of the last paragraph of the discussion section of the paper 'Pilot clinical study to evaluate the anticoagulant activity of fucoidan', by Lowenthal et. al.PMID:19696660"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A textual entity that expresses an assertion that is intended to be tested."@en ;
    ns1:IAO_0000116 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"@en ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"@en ;
    rdfs:subClassOf ns1:IAO_0000300 .

ns1:IAO_0000422 a owl:Class ;
    rdfs:label "postal address"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A textual entity that is used as directive to deliver something to a person, or organization" ;
    ns1:IAO_0000116 "2010-05-24 Alan Ruttenberg. Use label for the string representation. See issue https://github.com/information-artifact-ontology/IAO/issues/59" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:GAZ_00000448 ],
        ns1:IAO_0000300 .

ns1:IAO_0000424 a owl:AnnotationProperty ;
    rdfs:label "expand expression to"@en ;
    ns1:IAO_0000111 "expand expression to"@en ;
    ns1:IAO_0000112 "ObjectProperty: RO_0002104\\nLabel: has plasma membrane part\\nAnnotations: IAO_0000424 \"http://purl.obolibrary.org/obo/BFO_0000051 some (http://purl.org/obo/owl/GO#GO_0005886 and http://purl.obolibrary.org/obo/BFO_0000051 some ?Y)\"\\n"@en ;
    ns1:IAO_0000115 "A macro expansion tag applied to an object property (or possibly a data property)  which can be used by a macro-expansion engine to generate more complex expressions from simpler ones"@en ;
    ns1:IAO_0000117 "Chris Mungall"^^xsd:string .

ns1:IAO_0000425 a owl:AnnotationProperty ;
    rdfs:label "expand assertion to"@en ;
    ns1:IAO_0000111 "expand assertion to"@en ;
    ns1:IAO_0000112 "ObjectProperty: RO???\\nLabel: spatially disjoint from\\nAnnotations: expand_assertion_to \"DisjointClasses: (http://purl.obolibrary.org/obo/BFO_0000051 some ?X)  (http://purl.obolibrary.org/obo/BFO_0000051 some ?Y)\"\\n"@en ;
    ns1:IAO_0000115 "A macro expansion tag applied to an annotation property which can be expanded into a more detailed axiom."@en ;
    ns1:IAO_0000117 "Chris Mungall"@en .

ns1:IAO_0000426 a owl:AnnotationProperty ;
    rdfs:label "first order logic expression"@en ;
    ns1:IAO_0000111 "first order logic expression"@en ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"@en .

ns1:IAO_0000427 a owl:AnnotationProperty ;
    rdfs:label "antisymmetric property"@en ;
    ns1:IAO_0000111 "antisymmetric property"@en ;
    ns1:IAO_0000112 "part_of antisymmetric property xsd:true"@en ;
    ns1:IAO_0000115 "use boolean value xsd:true to indicate that the property is an antisymmetric property"@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en .

ns1:IAO_0000442 a owl:Class ;
    rdfs:label "author role"@en ;
    ns1:IAO_0000111 "author role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A role inhering in a person or organization that is realized when the bearer participates in the work which is the basis of the document, in the writing of the document, and signs it with their name."@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Melanie Courtot"@en ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:IAO_0000443 a owl:Class ;
    rdfs:label "data item extraction from journal article" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a planned process in which journal articles are read or processed and data items are extracted, typically for further analysis or indexing" ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:IAO_0000013 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000027 ],
        ns1:OBI_0000011 .

ns1:IAO_0000575 a owl:Class ;
    rdfs:label "associating information with a centrally registered identifier in its registry"@en ;
    ns1:IAO_0000112 "Articles in Pubmed are reviewed by curators who add MESH terms to the Pubmed records in order to categorize them better and improve the ability to search for them. " ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A planned process in which a CRID registry associates an information content entity with a CRID symbol"@en ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"@en ;
    ns1:IAO_0000118 "associating information with a CRID in the CRID registry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:IAO_0000577 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:IAO_0000579 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        ns1:OBI_0000011 .

ns1:IAO_0000576 a owl:Class ;
    rdfs:label "obsolete_establishing a CRID registry"^^xsd:string ;
    ns1:IAO_0000115 "a planned process with the objective to establish a system that allows to refer to specific entities of a certain kind and store information about them, by establishing a CRID registry and plan specifications for the process of 1) assigning a CRID and 2) looking up a CRID."^^xsd:string ;
    ns1:IAO_0000116 "MC, 20101124: deprecated following discussion at IAO call 20101124. Term was deemed not necessary - no use case for now." ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000580 a owl:Class ;
    rdfs:label "looking up a centrally registered identifier"@en ;
    ns1:IAO_0000112 "Going to the PubMed website and entering a PubMed ID in order to retrieve the Pubmed information associated with that ID. " ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A planned process in which a request to a CRID registry is made to return the information associated with a CRID symbol"@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Bill Hogan"@en,
        "PERSON: Bjoern Peters"@en,
        "PERSON: Melanie Courtot"@en ;
    ns1:IAO_0000118 "looking up a CRID" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:IAO_0000579 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:IAO_0000577 ],
        ns1:OBI_0000011 .

ns1:IAO_0000584 a owl:Class ;
    rdfs:label "time sampled measurement data set"@en ;
    ns1:IAO_0000112 "pmid:20604925 - time-lapse live cell microscopy"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A data set that is an aggregate of data recording some measurement at a number of time points. The time series data set is an ordered list of pairs of time measurement data and the corresponding measurement data acquired at that time."@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en ;
    ns1:IAO_0000118 "experimental time series"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:IAO_0000582 ],
        ns1:IAO_0000100 .

ns1:IAO_0000589 a owl:AnnotationProperty ;
    rdfs:label "OBO foundry unique label"@en ;
    ns1:IAO_0000111 "OBO foundry unique label"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An alternative name for a class or property which is unique across the OBO Foundry."@en ;
    ns1:IAO_0000116 "The intended usage of that property is as follow: OBO foundry unique labels are automatically generated based on regular expressions provided by each ontology, so that SO could specify unique label = 'sequence ' + [label], etc. , MA could specify 'mouse + [label]' etc. Upon importing terms, ontology developers can choose to use the 'OBO foundry unique label' for an imported term or not. The same applies to tools ."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"@en,
        "PERSON:Bjoern Peters"@en,
        "PERSON:Chris Mungall"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000119 "GROUP:OBO Foundry <http://obofoundry.org/>"@en .

ns1:IAO_0000591 a owl:Class ;
    rdfs:label "software method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A software method (also called subroutine, subprogram, procedure, method, function, or routine) is software designed to execute a specific task."@en ;
    ns1:IAO_0000117 "PERSON: Melanie Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    ns1:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:subClassOf ns1:IAO_0000010 .

ns1:IAO_0000592 a owl:Class ;
    rdfs:label "software module"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 " A software module is software composed of a collection of software methods."@en ;
    ns1:IAO_0000117 "PERSON: Melanei Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    ns1:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:subClassOf ns1:IAO_0000010 .

ns1:IAO_0000593 a owl:Class ;
    rdfs:label "software library"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A software library is software composed of a collection of software modules and/or software methods in a form that can be statically or dynamically linked to some software application."@en ;
    ns1:IAO_0000117 "PERSON: Melanie Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    ns1:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:subClassOf ns1:IAO_0000010 .

ns1:IAO_0000595 a owl:Class ;
    rdfs:label "software script"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 " A software script is software whose instructions can be executed using a software \\ninterpreter."@en ;
    ns1:IAO_0000117 "PERSON: Melanie Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    ns1:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:subClassOf ns1:IAO_0000010 .

ns1:IAO_0000596 a owl:AnnotationProperty ;
    rdfs:label "has ID digit count"@en ;
    ns1:IAO_0000112 "Ontology: <http://purl.obolibrary.org/obo/ro/idrange/>\\n  Annotations: \\n     'has ID prefix': \"http://purl.obolibrary.org/obo/RO_\"\\n     'has ID digit count' : 7,\\n     rdfs:label \"RO id policy\"\\n     'has ID policy for': \"RO\"" ;
    ns1:IAO_0000115 "Relates an ontology used to record id policy to the number of digits in the URI. The URI is: the 'has ID prefix\" annotation property value concatenated with an integer in the id range (left padded with \"0\"s to make this many digits)" ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg" .

ns1:IAO_0000597 a owl:AnnotationProperty ;
    rdfs:label "has ID range allocated to"@en ;
    ns1:IAO_0000112 "Datatype: idrange:1\\nAnnotations: 'has ID range allocated to': \"Chris Mungall\"\\nEquivalentTo: xsd:integer[> 2151 , <= 2300]\\n" ;
    ns1:IAO_0000115 "Relates a datatype that encodes a range of integers to the name of the person or organization who can use those ids constructed in that range to define new terms" ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg" .

ns1:IAO_0000598 a owl:AnnotationProperty ;
    rdfs:label "has ID policy for" ;
    ns1:IAO_0000112 "Ontology: <http://purl.obolibrary.org/obo/ro/idrange/>\\n  Annotations: \\n     'has ID prefix': \"http://purl.obolibrary.org/obo/RO_\"\\n     'has ID digit count' : 7,\\n     rdfs:label \"RO id policy\"\\n     'has ID policy for': \"RO\"" ;
    ns1:IAO_0000115 "Relating an ontology used to record id policy to the ontology namespace whose policy it manages" ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg" .

ns1:IAO_0000599 a owl:AnnotationProperty ;
    rdfs:label "has ID prefix"@en ;
    ns1:IAO_0000112 "Ontology: <http://purl.obolibrary.org/obo/ro/idrange/>\\n  Annotations: \\n     'has ID prefix': \"http://purl.obolibrary.org/obo/RO_\"\\n     'has ID digit count' : 7,\\n     rdfs:label \"RO id policy\"\\n     'has ID policy for': \"RO\"" ;
    ns1:IAO_0000115 "Relates an ontology used to record id policy to a prefix concatenated with an integer in the id range (left padded with \"0\"s to make this many digits) to construct an ID for a term being created." ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg" .

ns1:IAO_0000603 a owl:AnnotationProperty ;
    rdfs:label "is allocated id range"@en ;
    ns1:IAO_0000111 "is allocated id range"@en ;
    ns1:IAO_0000115 "Add as annotation triples in the granting ontology"@en,
        "Relates an ontology IRI to an (inclusive) range of IRIs in an OBO name space. The range is give as, e.g. \"IAO_0020000-IAO_0020999\""@en ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"@en .

ns1:IAO_0000604 a owl:AnnotationProperty ;
    rdfs:label "retired from use as of"^^xsd:string ;
    ns1:IAO_0000111 "retired from use as of"@en ;
    ns1:IAO_0000115 "relates a class of CRID to the date after which further instances should not be made, according to the central authority"^^xsd:string ;
    ns1:IAO_0000116 "In OWL 2 add AnnotationPropertyRange xsd:dateTimeStamp"^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string .

