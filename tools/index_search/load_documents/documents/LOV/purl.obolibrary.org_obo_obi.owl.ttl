ns1:OBI_0002160 a owl:Class ;
    rdfs:label "multiplexed indexed T7 ChIP-seq assay" ;
    ns1:IAO_0000111 "multiplexed indexed T7 ChIP-seq assay" ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A ChIP-seq assay which leverages T7 promoter amplification to allow low sample input and chromatin barcoding and pool-and-split multiplexing for high-throughput, quantitative profiling of chromatin states."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string,
        "Jason Hilton"^^xsd:string ;
    ns1:IAO_0000118 "Mint-ChIP"^^xsd:string,
