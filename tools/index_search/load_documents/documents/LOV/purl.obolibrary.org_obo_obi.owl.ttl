    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A clinical tumor stage group according to AJCC 7th edition indicating cancers that are smaller or less deeply invasive without regional disease or nodes."^^xsd:string ;
