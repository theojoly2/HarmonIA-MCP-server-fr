ns1:OBI_0001480 a owl:Class ;
    rdfs:label "phage display library panning"^^xsd:string ;
    ns1:IAO_0000111 "phage display library panning"^^xsd:string ;
    ns1:IAO_0000112 "Screening a libray of M13 phages displaying random peptide sequences for binding to the MHC molecule HLA-A*02:02 resulting in a subset of phages that encode peptides that bind. "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Phage display library panning is a process in which a diverse collection of phages encoding peptides or proteins are screened and the ones encoding active peptides/proteins are selected in an iterative process similar to natural selection.\\n"^^xsd:string ;
    ns1:IAO_0000117 "Jason Greenbaum, Randi Vita, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB, http://en.wikipedia.org/wiki/Phage_display"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_1000029 ],
        ns1:OBI_0000094 .

