    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A complex of two or more linked MHC molecules including a fluorescent label that can be loaded with a ligand, and is used in flow cytometry assay to bind to T cell receptors of T cells specific for the ligand"^^xsd:string ;
