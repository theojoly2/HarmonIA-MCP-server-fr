    ns1:IAO_0000115 "A ChIP-seq assay that identifies regions of chromatin bound to a chromatin modifying protein, e.g. a histone acetyltransferase."^^xsd:string ;
    ns1:IAO_0000117 "Paul D. Thomas"^^xsd:string,
        "Yang Chai"^^xsd:string ;
    ns1:IAO_0000118 "chromatin modifier binding site identification by ChIP-Seq assay"^^xsd:string ;
    ns1:IAO_0000119 "PMID:19212405"^^xsd:string ;
    ns1:IAO_0000233 "https://github.com/obi-ontology/obi/issues/782"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000716 .

ns1:OBI_0002085 a owl:Class ;
    rdfs:label "transcript expression location detection by hybridization chain reaction assay" ;
    ns1:IAO_0000111 "transcript expression location detection by hybridization chain reaction assay" ;
    ns1:IAO_0000112 "PMID 25977364: \"Multiplexed imaging of mRNA expression using fluorescent hybridization chain reaction (HCR) quantitatively confirmed the expression profiles of lead cells\""^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An in situ hybridization assay in which the location (e.g. anatomical/tissue) of a transcript is detected by a multiplexed fluorescent in situ hybridization, based on orthogonal amplification with hybridization chain reactions (HCR). RNA probes complementary to mRNA targets trigger chain reactions in which fluorophore-labeled RNA hairpins self-assemble into tethered fluorescent amplification polymers."^^xsd:string ;
    ns1:IAO_0000117 "Paul D. Thomas"^^xsd:string,
        "Yang Chai"^^xsd:string ;
    ns1:IAO_0000118 "transcript expression location detection by fluorescent HCR."^^xsd:string ;
    ns1:IAO_0000119 "PMID:21037591"^^xsd:string ;
    ns1:IAO_0000233 "https://github.com/obi-ontology/obi/issues/783"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001686 .

ns1:OBI_0002086 a owl:Class ;
    rdfs:label "Tet-assisted bisulfite sequencing assay" ;
    ns1:IAO_0000111 "Tet-assisted bisulfite sequencing assay" ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A bisulfite sequencing assay that identifies genomic methylation patterns by using a bisulfite based protocol with the Tet enzyme to differentiate 5-hydroxylmethylcytosine (5hmC) from 5-methylcytosine (5mC) through a step-wise oxidative demethylation of 5mC, converting it to 5-carboxylcytosine (5caC) while keeping 5hmC protected."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string,
        "Chris Stoeckert"^^xsd:string,
        "Jason Hilton"^^xsd:string,
        "OBI"^^xsd:string ;
    ns1:IAO_0000118 "TAB-seq"^^xsd:string,
        "Tet-assisted bisulfite sequencing"^^xsd:string ;
    ns1:IAO_0000119 "PMID:23196972"^^xsd:string ;
    ns1:IAO_0000233 "http://sourceforge.net/p/obi/obi-terms/789/"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000748 .

ns1:OBI_0002088 a owl:Class ;
    rdfs:label "specimen container"@en ;
    ns1:IAO_0000111 "specimen container"@en ;
    ns1:IAO_0000112 "COPAN eSwab, CPT vacutainer, PAXgene Blood DNA tube"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A container with the function of containing a specimen."@en ;
    ns1:IAO_0000116 "For details see tracker item: http://sourceforge.net/p/obi/obi-terms/792/"@en ;
    ns1:IAO_0000117 "Chris Stoeckert"@en ;
    ns1:IAO_0000119 "Duke Biobank, OBIB"@en ;
    dc:source "Biobank"@en ;
    rdfs:comment "Specimen containers are typically constructed or treated in a particular manner in order to perform their containing a specimen function. This will be a defined class so that any container (e.g., cryotube, vacutainer, conical test tube) with the function of containing a specimen will be inferred to be a specimen container."@en ;
    rdfs:subClassOf ns1:OBI_0000967 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0002087 ] .

ns1:OBI_0002092 a owl:Class ;
    rdfs:label "3' rapid amplification of cDNA ends"@en ;
    ns1:IAO_0000111 "3' rapid amplification of cDNA ends"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A rapid amplication of cDNA ends to amplify a mRNA sequence between a defined internal site and the 3' end of the mRNA."@en ;
    ns1:IAO_0000116 "For details see tracker item: https://sourceforge.net/p/obi/obi-terms/790/"@en ;
    ns1:IAO_0000117 "Jason Hilton, Chris Stoeckert"@en ;
    ns1:IAO_0000118 "3' RACE"@en ;
    ns1:IAO_0000119 "https://www.thermofisher.com/us/en/home/references/protocols/nucleic-acid-amplification-and-expression-profiling/cdna-protocol/3-race-system-for-rapid-amplification-of-cdna-ends.html"@en ;
    dc:source "ENCODE"@en ;
    rdfs:subClassOf ns1:OBI_0002090 .

ns1:OBI_0002093 a owl:Class ;
    rdfs:label "5' RNA ligase mediated rapid amplification of cDNA ends"@en ;
    ns1:IAO_0000111 "5' RNA ligase mediated rapid amplification of cDNA ends"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A 5' rapid amplification pf cDNA ends that uses RNA ligase to add an RNA adapter oligonucleotide to intact 5' mRNA ends, allowing the amplification of cDNA only from full-length, capped mRNA."@en ;
    ns1:IAO_0000116 "For details see tracker item: https://sourceforge.net/p/obi/obi-terms/790/"@en ;
    ns1:IAO_0000117 "Jason Hilton, Chris Stoeckert"@en ;
    ns1:IAO_0000118 "5' RLM RACE"@en ;
    ns1:IAO_0000119 "https://tools.thermofisher.com/content/sfs/manuals/cms_056070.pdf"@en ;
    dc:source "ENCODE"@en ;
    rdfs:subClassOf ns1:OBI_0002091 .

ns1:OBI_0002094 a owl:Class ;
    rdfs:label "MethylC-Capture sequencing assay" ;
    ns1:IAO_0000111 "MethylC-Capture sequencing assay" ;
    ns1:IAO_0000112 "MethylC-Capture Sequencing approach was introduced as a cost-effective and customizable alternative method for large-scale interrogation of functionally-active methylomes while simultaneously providing genetic variation information in a proof-of-concept epigenome-wide association study of 72 obese individuals, identifying novel disease-associated variants."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A bisulfite sequencing assay in which a whole-genome sequencing library is prepared, bisulfite converted and amplified, followed by a capture enriching for targeted bisulfite-converted DNA fragments that are are subsequently identified by DNA sequencing."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string,
        "David Bujold"^^xsd:string ;
    ns1:IAO_0000118 "Capture Methylome"^^xsd:string,
        "MCC-Seq"^^xsd:string,
        "MethylC-Capture Sequencing"^^xsd:string ;
    ns1:IAO_0000119 "PMID:26021296"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000748 .

ns1:OBI_0002095 a owl:Class ;
    rdfs:label "specimen family creation"@en ;
    ns1:IAO_0000111 "specimen family creation"@en ;
    ns1:IAO_0000112 "Aliquoting one specimen to multiple tubes, slicing a tissue specimen into multiple sections, processing blood into buffy coat, red cells, and serum."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A material processing that has as its input a specimen and as its output a collection of specimens."@en ;
    ns1:IAO_0000116 "For details see tracker: https://sourceforge.net/p/obi/obi-terms/778/"@en ;
    ns1:IAO_0000117 "Mathias Brochhausen, Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "OBI, OBIB"@en ;
    dc:source "Biobank"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000094 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0100051 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0002077 ] ) ],
        ns1:OBI_0000094 .

