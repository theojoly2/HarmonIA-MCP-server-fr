    ns1:IAO_0000111 "service"^^xsd:string ;
    ns1:IAO_0000112 "providing a training course for UCSD employees how to run a DNA sequencer; sequencing a DNA sample provided by a service consumer restricted to non-human samples; giving access to tissue samples in a biobank within OHSU; JAX shipping mice from their colony "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
