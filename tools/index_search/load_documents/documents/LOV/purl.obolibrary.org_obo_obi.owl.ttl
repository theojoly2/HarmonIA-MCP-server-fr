ns1:OBI_0001009 a owl:Class ;
    rdfs:label "obsolete_qualitative binding detection assay"@en ;
    ns1:IAO_0000111 "obsolete_qualitative binding detection assay"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A binding assay where the specified output determines if two or more material entities do or do not have the disposition to form a complex above a threshold level of significance. The threshold can be defined through detection limits of the instrument, the use of experimental controls that establish what is considered significant binding, or a predefined cutoff based on what binding is considered significant in a certain context. "@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita, Jason Greenbaum"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

