ns1:OBI_1110041 a owl:Class ;
    rdfs:label "lymph node cell specimen"@en ;
    ns1:IAO_0000111 "lymph node cell specimen"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A cell specimen comprised of a mixed population of cells obtained by processing whole lymph node into individual cells, typically performed using a sieve. This population includes T cells, B cells, macrophages, and other cell types."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_1110046 [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000293 ;
                                owl:someValuesFrom ns1:UBERON_0000029 ] ) ] ],
        ns1:OBI_0000953,
        ns1:OBI_0001468 .

ns1:OBI_1110043 a owl:Class ;
    rdfs:label "cultured adherent cell populaiton"@en ;
    ns1:IAO_0000111 "cultured adherent cell population"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A mixed cell population that is characterized by its ability to bind to tissue culture flasks or plates. This population typically contains macrophages and other cells capable of playing the antigen presenting cell role."^^xsd:string ;
    ns1:IAO_0000116 "MHB 3-27-13: Following CLO alignment efforts, propose to update definition to read: \"A cultured cell population comprised of cells that are able to grow attached to a solid substrate provided by tissue culture flasks or plates\". The current definition seems to describe a more specific type of adherent culture of immunological origin as needed by IEDB. \\n\\nMHB 3-5-13: Need to review axiom on this class in light of clarification that it refers to a cell line sample, and not an entire line. Not every population of adhernet cells is the output of an isolation process." ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "adherent cell culture sample" ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_0100060 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0100060 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom ns1:OBI_0000540 ] ) ] .

ns1:OBI_1110044 a owl:Class ;
    rdfs:label "cultured PBMC cell population"@en ;
    ns1:IAO_0000111 "cultured PBMC cell population"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A mixed cell population obtained by processing whole blood. The cells are characterized by having a similar density and are largely mononuclear cells (includes T cells, B cells, and other cell types)."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "PBMC cell culture sample" ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_0001875 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0001875 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom ns1:OBI_0000548 ] ) ] .

ns1:OBI_1110047 a owl:Class ;
    rdfs:label "cultured CD3+ T cell population"@en ;
    ns1:IAO_0000111 "cultured CD3+ T cell population"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A T cell population characterized by expressing the CD3 molecule on its surface."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "CD3+ T cell culture sample" ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_0001875 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0001875 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000643 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:CL_0000000 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom ns1:PR_000001018 ] ) ] ] ) ] .

ns1:OBI_1110048 a owl:Class ;
    rdfs:label "cultured CD3- T cell population"@en ;
    ns1:IAO_0000111 "cultured CD3- T cell population"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A T cell population characterized by not expressing the CD3 molecule on its surface."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "CD3- T cell culture sample" ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_0001875 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0001875 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000643 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:CL_0000000 [ a owl:Class ;
                                            owl:complementOf [ a owl:Restriction ;
                                                    owl:onProperty ns1:BFO_0000051 ;
                                                    owl:someValuesFrom ns1:PR_000001018 ] ] ) ] ] ) ] .

ns1:OBI_1110052 a owl:Class ;
    rdfs:label "cultured CD4-/CD8- T cell population"@en ;
    ns1:IAO_0000111 "cultured CD4-/CD8- T cell population"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A T cell population characterized by not expressing the CD4 nor the CD8 molecule on its surface."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "CD4-/CD8- T cell culture sample" ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_1110050,
        ns1:OBI_1110051 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0001875 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000643 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:CL_0000000 [ a owl:Class ;
                                            owl:complementOf [ a owl:Restriction ;
                                                    owl:onProperty ns1:BFO_0000051 ;
