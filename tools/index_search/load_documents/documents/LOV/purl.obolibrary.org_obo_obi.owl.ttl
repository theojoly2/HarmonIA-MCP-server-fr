ns1:OBI_0000314 a owl:ObjectProperty ;
    rdfs:label "is_proxy_for"@en ;
    ns1:IAO_0000111 "is_proxy_for"^^xsd:string ;
    ns1:IAO_0000112 "position on a gel is_proxy_for mass and charge of molecule in an western blot. Florescent intensity is_proxy_for amount of protein labeled with GFP. Examples:\\nA260/A280 (of a DNA sample) is_proxy_for DNA-purity. NMR Sample scan is a proxy for sample quality.\\n\\nWithin the assay mentioned here: https://wiki.cbil.upenn.edu/obiwiki/index.php/Chromium_Release_assay\\nlevel of radioactivity is_proxy_for level of toxicity"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A relation between continuant instances c1 and c2 where within an experiment/ protocol application,  measurement of c1 is used to determine what a measurement of c2 would be."@en ;
    ns1:IAO_0000116 "A relation between continuant instances c1 and c2 where within a protocol \\n    application, measurement of c1 is related to a what would be the \\n    measurement of c2.\\n(another definition)"@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en ;
    rdfs:domain ns1:BFO_0000002 ;
    rdfs:range ns1:BFO_0000002 .

