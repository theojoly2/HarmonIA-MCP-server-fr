ns1:OBI_0000830 a owl:Class ;
    rdfs:label "obsolete_primary structure of sequence macromolecule"^^xsd:string ;
    ns1:IAO_0000111 "obsolete_primary structure of sequence macromolecule"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A quality inhering in a molecule that is completely defined by the linear sequence of a set of residues which are connected by directional, linear bonds"^^xsd:string ;
    ns1:IAO_0000116 "2010-06-28 Alan Ruttenberg. This term and its children to be replaced by sequence ontology terms once we figure out what the right terms are ."^^xsd:string,
        "These are all placeholders and should be replaced by SO terms"^^xsd:string ;
    ns1:IAO_0000117 "Person:Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000228 ;
    ns1:IAO_0000232 "these are not in great shape yet; need to clarify how what a 'sequence macromolecule is' and how it differes from molecules in general (directivity of certain bonds, linear connectivity along that type of bond etc.)"^^xsd:string ;
    rdfs:comment "replaced by SO_0000001 region"^^xsd:string ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

