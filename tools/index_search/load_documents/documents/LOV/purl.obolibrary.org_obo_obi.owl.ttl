            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:BFO_0000040 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        ns1:OBI_0000070 .

ns1:OBI_0600026 a owl:Class ;
    rdfs:label "longitudinal mass measurement assay" ;
    ns1:IAO_0000111 "longitudinal mass measurement assay" ;
    ns1:IAO_0000112 "The comparison of the weight of vaccinated and non-vaccinated mice after infection with influenza A over 6 weeks post-infection"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that measures the mass of a material at two or more time points"^^xsd:string ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"^^xsd:string ;
