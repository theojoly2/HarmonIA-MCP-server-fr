    ns1:IAO_0000117 "PERSON:Bjoern Peters" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:IAO_0000039 ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:OBI_0001937 ],
        ns1:OBI_0001933 .

ns1:OBI_0001937 a owl:DatatypeProperty ;
    rdfs:label "has specified numeric value" ;
    ns1:IAO_0000111 "has specified numeric value" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A relation between a value specification and a number that quantifies it." ;
    ns1:IAO_0000116 "A range of 'real' might be better than 'float'. For now we follow 'has measurement value' until we can consider technical issues with SPARQL queries and reasoning." ;
    ns1:IAO_0000117 "PERSON: James A. Overton" ;
    ns1:IAO_0000119 "OBI" ;
    rdfs:domain ns1:OBI_0001933 ;
    rdfs:range owl:real ;
    rdfs:subPropertyOf ns1:OBI_0002135 .

