            owl:someValuesFrom ns1:UO_0000051 ],
        ns1:OBI_0001144 .

ns1:OBI_0001548 a owl:Class ;
    rdfs:label "equilibrium association constant (KA)"^^xsd:string ;
    ns1:IAO_0000111 "equilibrium association constant (KA)"^^xsd:string ;
    ns1:IAO_0000112 "KA = 10^-12 M^-1 is the equilibirum association constant maximally found for antibody binding to haptens. "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A binding constant defined as the ratio of koff over kon (off-rate of binding divided by on-rate)"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001144 .

