ns1:OBI_0001941 a owl:Class ;
    rdfs:label "contig N50"@en ;
    ns1:IAO_0000111 "contig N50"@en ;
    ns1:IAO_0000112 "Gigascience. 2012 Dec 27;1(1):18. doi: 10.1186/2047-217X-1-18.\\nPMID: 23587118. \\n\\n\"Here, the contig and scaffold N50 of the YH genome were ~20.9 kbp and ~22 Mbp\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "N50 statistic computed for the contigs produced by the assembly process. A contig N50 is calculated by first ordering every contig by length from longest to shortest. Next, starting from the longest contig, the lengths of each contig are summed, until this running sum equals one-half of the total length of all contigs in the assembly. The contig N50 of the assembly is the length of the shortest contig in this list." ;
    ns1:IAO_0000117 "Alejandra Gonzalez-Beltran"@en,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "adapted from: nature:http://www.nature.com/nrg/journal/v13/n5/box/nrg3174_BX1.html"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:SO_0000149 [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000312 ;
                                owl:someValuesFrom ns1:OBI_0001872 ] ) ] ],
        ns1:OBI_0001940 .

ns1:OBI_0001942 a owl:Class ;
    rdfs:label "grant agency"@en ;
    ns1:IAO_0000111 "grant agency"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An organization that provides funding support for projects such as investigations." ;
    ns1:IAO_0000117 "PERSON: Jie Zheng, Chris Stoeckert" ;
    ns1:IAO_0000118 "funding organization" ;
    ns1:IAO_0000119 "NIAID GSCID-BRC metadata working group" ;
    dc:source "NIAID GSCID-BRC" ;
    rdfs:seeAlso "'funding organization'\\nhttp://vivoweb.org/ontology/core#FundingOrganization" ;
    rdfs:subClassOf ns1:OBI_0000245 .

ns1:OBI_0001943 a owl:Class ;
    rdfs:label "software pipeline"@en ;
    ns1:IAO_0000111 "software pipeline"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A plan specification that specifies a chain encoded in software of processing elements (processes, threads, coroutines, etc.), arranged so that the output of each element is the input of the next. Usually some amount of buffering is provided between consecutive elements." ;
    ns1:IAO_0000117 "PERSON: Jie Zheng, Chris Stoeckert" ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Pipeline_%28software%29" ;
    dc:source "NIAID GSCID-BRC" ;
    rdfs:subClassOf ns1:IAO_0000104 .

ns1:OBI_0001944 a owl:Class ;
    rdfs:label "sequence annotation"@en ;
    ns1:IAO_0000111 "sequence annotation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A planned process that identifies and reports sequence features (e.g. protein coding regions) in sequence data." ;
    ns1:IAO_0000117 "PERSON: Jie Zheng, Chris Stoeckert" ;
    ns1:IAO_0000119 "NIAID GSCID-BRC metadata working group" ;
    dc:source "NIAID GSCID-BRC" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0000059 ;
                    owl:someValuesFrom ns1:OBI_0001625 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000905 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000973 ],
        ns1:OBI_0000011 .

ns1:OBI_0001945 a owl:Class ;
    rdfs:label "scaffold N50"@en ;
    ns1:IAO_0000111 "scaffold N50"@en ;
    ns1:IAO_0000112 "Gigascience. 2012 Dec 27;1(1):18. doi: 10.1186/2047-217X-1-18.\\nPMID: 23587118. \\n\\n\"Here, the contig and scaffold N50 of the YH genome were ~20.9 kbp and ~22 Mbp\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "N50 statistic computed for the scaffold produced by the assembly process. The method for computing the value is similar to that of contig N50 but uses scaffold information instead of contig information" ;
    ns1:IAO_0000117 "Alejandra Gonzalez-Beltran"@en,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "adapted from: nature:http://www.nature.com/nrg/journal/v13/n5/box/nrg3174_BX1.html"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:SO_0000148 [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000312 ;
