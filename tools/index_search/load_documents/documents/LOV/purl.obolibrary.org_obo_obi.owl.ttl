ns1:OBI_0000049 a owl:Class ;
    rdfs:label "mass spectrometer"@en ;
    ns1:IAO_0000111 "mass spectrometer"@en ;
    ns1:IAO_0000112 "LCQ Fleet Ion Trap MSn manufactured by thermo fisher scientific"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A mass spectrometer is an instrument which is used to measure the mass to charge ratio of ions. All mass spectrometers consist of three basic parts: an ion source, a mass analyzer, and a detector system. The stages within the mass spectrometer are: 1. Production of ions from the sample 2. Separation of ions with different masses 3. Detection of the number of ions of each mass produced 4.Collection of data to generate the mass spectrum"@en ;
    ns1:IAO_0000117 "Frank Gibson"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Mass_spectrometry"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000647 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:NCBITaxon_9606 ns1:OBI_0000245 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000053 ;
            owl:someValuesFrom ns1:OBI_0000654 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0000345 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0000361 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0000364 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

