    rdfs:label "immortalizing cell line transformation"^^xsd:string ;
    ns1:IAO_0000111 "immortalizing cell line transformation"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000428 ;
    ns1:IAO_0000115 "a genetic transformation of a cell line cell with transgenic constructs intended to confer the capability for indefinite propagation in culture"^^xsd:string ;
