ns1:OBI_0001581 a owl:Class ;
    rdfs:label "equilibrium dissociation constant (KD) approximated by EC50"^^xsd:string ;
    ns1:IAO_0000111 "equilibrium dissociation constant (KD) approximated by EC50"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement of an EC50 value under specific assay conditions approximates KD, namely the binding reaction is at an equilibrium,  and the concentration of the receptor must be much less than the KD for the ligand.  "^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita"^^xsd:string ;
    ns1:IAO_0000119 "Assay Development: Fundamentals and Practices, By Ge Wu, page 74"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001144,
        ns1:OBI_0001180 .

ns1:OBI_0001593 a owl:Class ;
    rdfs:label "competitive inhibition of binding assay" ;
    ns1:IAO_0000111 "competitive inhibition of binding assay" ;
    ns1:IAO_0000112 "Detecting the inhibition of binding of a fluorescently labeled antibody to its known protein ligand bound to the bottom of an ELISA plate, by incubating the antibody in the presence of a peptide of interest, adding it to the plate, washing the plate, and detecing fluorescence which is a proxy for the presence of the bound antibody. Reduction in binding due to the presence of the peptide indicates that the antibody binds the peptide._"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A binding assay that detects the inhibition of binding between 2 material entities known to form a complex by the addition of a third material entity of interest. Inhibition of binding between the 2 materials reflects binding by the third material."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:OBI_0001955 ] ) ] ],
        ns1:OBI_0001146 .

