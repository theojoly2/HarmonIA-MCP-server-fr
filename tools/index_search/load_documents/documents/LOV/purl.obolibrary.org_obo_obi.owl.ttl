    rdfs:label "transfection"@en ;
    ns1:IAO_0000111 "transfection"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a genetic transformation which relies on the use of physical, electrical and chemical phenomena to introduce DNA or RNA into a cell"@en ;
