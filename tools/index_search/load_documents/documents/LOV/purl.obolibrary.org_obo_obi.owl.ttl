ns1:OBI_0000480 a owl:Class ;
    rdfs:label "Bruker high resolution probe"@en ;
    ns1:IAO_0000111 "Bruker high resolution probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "BRUKER BIOSPIN's experienced Research & Development group not only delivers top-performance probes for the more common experiments, but also a wealth of special probes for almost any application. For high resolution (HR) NMR we offer probes with a variety of important characteristics and features."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "HR Probe"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400223"^^xsd:string,
