                                                    owl:someValuesFrom ns1:OBI_0000116 ] ) ] ] ) ] ],
        ns1:OBI_0500000 .

ns1:OBI_0001196 a owl:Class ;
    rdfs:label "cytometric bead array assay measuring epitope specific IP-10 production by T cells" ;
    ns1:IAO_0000111 "cytometric bead array assay measuring epitope specific IP-10 production by T cells" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay of epitope specific IP-10 production by T cells that uses a cytometric bead array assay."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "CXCL10/IP-10 release"^^xsd:string,
        "cytometric bead array"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001308 ;
