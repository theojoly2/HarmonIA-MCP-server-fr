ns1:IAO_0000059 a owl:Class ;
    rdfs:label "obsolete2_report figure"@en ;
    ns1:IAO_0000111 "report figure"@en ;
    ns1:IAO_0000114 ns1:IAO_0000124 ;
    ns1:IAO_0000115 "A report figure is a report display element that has some aspect of illustration, but may be a composite of figures, images, and other elements"@en ;
    ns1:IAO_0000116 "I prepended the 'report ' to make it clear that we mean parts of reports here. We may want a more generic version of 'figure', in which case this would become a defined class - figure and part_of some report"@en,
        "Replaced by defined version of figure"@en ;
    ns1:IAO_0000117 "person:Alan Ruttenberg"@en,
        "person:Allyson Lister"@en ;
    ns1:IAO_0000119 "OBI_0000027"^^xsd:string,
        "group:OBI"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000065 a owl:Class ;
    rdfs:label "software interpreter"@en ;
    ns1:IAO_0000111 "software interpreter"@en ;
    ns1:IAO_0000112 "R program, Perl interpreter, Java virtual machine"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A software interpreter is a software application that executes some specified input software. "@en ;
    ns1:IAO_0000116 "Do we care? Jennifer: Yes, there was a particular version of R that had a bug and it was fixed later. That would imply that we mean specific version of an interpreter. So an instance of this would be a particular version of the interpreter"@en ;
    ns1:IAO_0000117 "person:Alan Ruttenberg"@en,
        "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000199"@en,
        "group:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000064 .

ns1:IAO_0000091 a owl:Class ;
    rdfs:label "obsolete_report element"@en ;
    ns1:IAO_0000111 "report element"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A report element is a narrative object in which information is presented and consumed by a human being, and is part of a report. Examples of report elements are figure (dot plot), table, text portion (may include a movie or audio clip on a web page)."@en ;
    ns1:IAO_0000116 "2009-03-16: needs some more work (clarify relations)."^^xsd:string,
        "2009-03-16: was report display element with definition: A report display element is a narrative object that is part of a report. Report display elements are set off from the textual parts of a report and are typically given a label(e.g. Figure 2) which is used to refer to the element from the text. Typically the 2d layout is part of the identity of such elements."^^xsd:string,
        "2009-03-16: work has been done on this term during during the OBI workshop winter 2009 and the current definition was considered acceptable for use in OBI. If there is a need to modify this definition please notify OBI."^^xsd:string,
        "2009-08-10 Alan Ruttenberg: Larry Hunter suggests that this be obsoleted and replaced by 'textual entity' and 'figure'. Alan restored as there are OBI dependencies and this merits further discussion"^^xsd:string,
        "Replaced by textual entity and figure"^^xsd:string,
        "There will be some issue here about whether these are defined classes. As intended these are meant to denote the parts of the report that are not textual but are typically boxed and set within the text, labelled with some identifier, and referred to in the text"@en ;
    ns1:IAO_0000117 "PERSON: Melanie Courtot"^^xsd:string,
        "PERSON: Alan Ruttenberg"@en,
        "PERSON: Allyson Lister"@en ;
    ns1:IAO_0000119 "OBI_0000001"^^xsd:string,
        "GROUP:OBI"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000093 a owl:Class ;
    rdfs:label "obsolete2_binary executable"@en ;
    ns1:IAO_0000111 "binary executable"@en ;
    ns1:IAO_0000115 "Binary executable is a digital entity consisting of the binary representation of machine instructions of a specific processor or they may be binary pseudocode for a virtual machine. A non-source executable file is also called an object program. It is assumed that the binary executable file contains properly-formatted computer instructions.  (derived from Wikipedia, Nov 1, 2007)"@en ;
    ns1:IAO_0000116 "3/22/2009 Alan Ruttenberg, obsoleted per http://groups.google.com/group/information-ontology/browse_thread/thread/789ad4b7708d5cf4\\nsuperclass was 'digital entity'"@en ;
    ns1:IAO_0000117 "person:Jennifer Fostel"@en ;
    ns1:IAO_0000119 "OBI_0000222"^^xsd:string,
        "group:OBI"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000096 a owl:Class ;
    rdfs:label "source code module"@en ;
    ns1:IAO_0000111 "source code module"@en ;
    ns1:IAO_0000112 "The written source code that implements part of an algorithm. Test - if you know that it was written in a specific language, then it can be source code module. We mean here, roughly, the wording of a document such as a perl script."@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A source code module is a directive information entity that specifies, using a programming language, some algorithm."@en ;
    ns1:IAO_0000117 "person:Alan Ruttenberg"@en,
        "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000039"@en,
        "group:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000033 .

ns1:IAO_0000097 a owl:Class ;
    rdfs:label "obsolete_report table"@en ;
    ns1:IAO_0000111 "report table"@en ;
    ns1:IAO_0000114 ns1:IAO_0000002 ;
    ns1:IAO_0000115 "A report table is a report display element consisting of a matrix of cells layed out in a grid, some set of which are filled with some information content"@en ;
    ns1:IAO_0000116 "2009-08-10 Alan Ruttenberg: Larry Hunter suggests that this be obsoleted and replaced by 'textual entity table'. Alan restored as there are OBI dependencies and this merits further discussion"^^xsd:string ;
    ns1:IAO_0000117 "person:Alan Ruttenberg"@en,
        "person:Allyson Lister"@en ;
    ns1:IAO_0000119 "OBI_0000265"^^xsd:string,
        "group:OBI"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000105 a owl:Class ;
    rdfs:label "obsolete2_digital document"@en ;
    ns1:IAO_0000111 "digital document"@en ;
    ns1:IAO_0000115 "A digital document is a digital entity consisting of an electronic file which can be rendered into human-readable form by one or more computational applications.  The digital document does not refer to the information content of the document but to an instance of the file."@en ;
    ns1:IAO_0000116 "3/22/2009 Alan Ruttenberg, obsoleted per http://groups.google.com/group/information-ontology/browse_thread/thread/789ad4b7708d5cf4\\nsuperclass was 'digial entity'"@en ;
    ns1:IAO_0000117 "person:Jennifer Fostel"@en ;
    ns1:IAO_0000119 "OBI_0000195"^^xsd:string,
        "group:OBI"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000111 a owl:AnnotationProperty ;
    rdfs:label "editor preferred label",
        "editor preferred term",
        "editor preferred term~editor preferred label",
        "editor preferred label"@en,
        "editor preferred term"@en ;
    ns1:IAO_0000111 "editor preferred label",
        "editor preferred term",
        "editor preferred term~editor preferred label",
        "editor preferred label"@en,
        "editor preferred term"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "The concise, meaningful, and human-friendly name for a class or property preferred by the ontology developers. (US-English)"@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
    rdfs:isDefinedBy ns1:iao.owl .

ns1:IAO_0000112 a owl:AnnotationProperty ;
    rdfs:label "example of usage"@en ;
    ns1:IAO_0000111 "example"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A phrase describing how a term should be used and/or a citation to a work which uses it. May also include other kinds of examples that facilitate immediate understanding, such as widely know prototypes or instances of a class, or cases where a relation is said to hold."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
    rdfs:isDefinedBy ns1:iao.owl .

ns1:IAO_0000113 a owl:AnnotationProperty ;
    rdfs:label "in branch"@en ;
    ns1:IAO_0000111 "in branch"@en ;
    ns1:IAO_0000115 "An annotation property indicating which module the terms belong to. This is currently experimental and not implemented yet."@en ;
    ns1:IAO_0000117 "GROUP:OBI"@en ;
    ns1:IAO_0000119 "OBI_0000277"@en .

ns1:IAO_0000114 a owl:AnnotationProperty ;
    rdfs:label "has curation status"@en ;
    ns1:IAO_0000111 "has curation status"@en ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"@en,
        "PERSON:Bill Bug"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000119 "OBI_0000281"@en .

ns1:IAO_0000117 a owl:AnnotationProperty ;
    rdfs:label "term editor"@en ;
    ns1:IAO_0000111 "term editor"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "Name of editor entering the term in the file. The term editor is a point of contact for information regarding the term. The term editor may be, but is not always, the author of the definition, which may have been worked upon by several people"@en ;
    ns1:IAO_0000116 "20110707, MC: label update to term editor and definition modified accordingly. See https://github.com/information-artifact-ontology/IAO/issues/115."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
    rdfs:isDefinedBy ns1:iao.owl .

ns1:IAO_0000128 a owl:Class ;
    rdfs:label "obsolete_identifier"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000121 ;
    ns1:IAO_0000116 "_identifier is a container under information content entity for collecting types of terms to indicate a specific instance or clas of what was used or participated in an investigation. Identifiers are borne by a product or its packaging, and can be encoded in a variety of other information objects, such as bar codes, numerals, or patterns of dots.\\n\\nNote: everybody agreed that identifier is probably a too general term. We however felt that it would be appropriate to group \"identifiying\" terms under some kind of umbrella. We therefore propose to use _identifier for that purpose. As per OBI conventions, the _ prefixing identifier indicates that this is a helper class and shouldn't be considered as final."^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000226 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000129 a owl:Class ;
    rdfs:label "version number"@en ;
    ns1:IAO_0000111 "version number"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A version number is an information content entity which is a sequence of characters borne by part of each of a class of manufactured products or its packaging and indicates its order within a set of other products having the same name."@en ;
    ns1:IAO_0000116 "Note: we feel that at the moment we are happy with a general version number, and that we will subclass as needed in the future. For example, see 7. genome sequence version"@en ;
    ns1:IAO_0000117 "GROUP: IAO"@en ;
    rdfs:subClassOf ns1:IAO_0000028 .

ns1:IAO_0000131 a owl:Class ;
    rdfs:label "serial number"@en ;
    ns1:IAO_0000111 "serial number"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A serial number is an information content entity which is a unique sequence of characters borne by part of manufactured product or its packaging that is assigned to each individual in some class of products, and so can serve as a way to identify an individual product within the class. Serial numbers can be encoded in a variety of other information objects, such as bar codes, numerals, or patterns of dots."@en ;
    ns1:IAO_0000116 "Note: during the call there was some confusion between serial number and model number. We agreed that it would be very helpful for all those terms to have example of usages - please add if you have any :-)"@en ;
    ns1:IAO_0000117 "GROUP: IAO"@en ;
    rdfs:subClassOf ns1:IAO_0000028 .

ns1:IAO_0000132 a owl:Class ;
    rdfs:label "lot number"@en ;
    ns1:IAO_0000111 "lot number"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A lot number is an information content entity which is an identical sequence of character borne by part of manufactured product or its packaging for each instances of a product class in a discrete batch of an item. Lot numbers are usually assigned to each separate production run of an item. Manufacturing as a lot might be due to a variety of reasons, for example,  a single process during which many individuals are made from the same portion of source material. Lot numbers can be encoded in a pattern  of other information objects, such as bar codes, numerals, or patterns of dots."@en ;
    ns1:IAO_0000117 "GROUP: IAO"@en ;
    ns1:IAO_0000118 "batch number"@en ;
    rdfs:subClassOf ns1:IAO_0000028 .

ns1:IAO_0000135 a owl:ObjectProperty ;
    rdfs:label "obsolete_specifically denotes"^^xsd:string ;
    ns1:IAO_0000112 "The process of creation is, for example,  writing down on paper the name of a friend by deliberately creating a certain pattern using ink.\\n\\nHere the ink + paper is the independent continuant and the carrier is the pattern in the ink.\\n\\nc = pattern in the ink\\nb = paper + ink\\nr = friend"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "c specifically denotes r =def \\nr is a portion of reality\\n& c is a particular quality\\n& c depends specifically on some independent continuant b \\n& b acquired c as the result of the achievement of an objective to enable pointing to r repeatedly. \\n\\nMarked means there is a changed or additional quality of the bearer - the  quality is the information carrier.\\n\\nCase 1\\nMemory trace as mark created when reading some description of some friend. The trace can denote.\\n\\nCase 2\\nPattern of ink arrayed on paper as mark when writing down a friend's name\\n\\nCase 3\\nPattern of magnetic domains on scattered pieces of a hard disk platter as mark when saving a file."^^xsd:string ;
    ns1:IAO_0000116 "8/6/2009 Alan Ruttenberg: The suggestions is to deprecate specific and generically denotes in favor of a single denote relationship that corresponds to the generic sense"^^xsd:string,
        "see https://github.com/information-artifact-ontology/IAO/issues/25&q=denote"^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "Smith, Ceusters, Ruttenberg, 2000 years of philosophy"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteProperty> ;
    owl:deprecated true .

ns1:IAO_0000140 a owl:Class ;
    rdfs:label "setting datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A settings datum is a datum that denotes some configuration of an instrument."@en ;
    ns1:IAO_0000116 "2/3/2009 Feedback from OBI\\n\\nThis should be a \"setting specification\". There is a question of whether it is information about a realizable or not.\\n\\nPro other specification are about realizables.\\nCons sometimes specifies a quality which is not a realizable."@en,
        "Alan grouped these in placeholder for the moment. Name by analogy to measurement datum."@en ;
    rdfs:subClassOf ns1:IAO_0000027 .

ns1:IAO_0000141 a owl:Class ;
    rdfs:label "obsolete_digital quality"^^xsd:string ;
    ns1:IAO_0000116 "3/22/2009 Alan Ruttenberg, obsoleted per http://groups.google.com/group/information-ontology/browse_thread/thread/789ad4b7708d5cf4",
        "Need to rework digital entity. Digital quality was suggested by Barry."^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000142 a owl:ObjectProperty ;
    rdfs:label "mentions"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An information artifact IA mentions an entity E exactly when it has a component/part that denotes E"@en ;
    ns1:IAO_0000116 "7/6/2009 Alan Ruttenberg. P4 RC1 munges our GCI so remove it for now: mentions some entity equivalentTo has_part some ('generically denotes' some entity)"@en,
        "7/6/2009 Alan Ruttenberg: Add this relation following conversation with Jonathan Rees that N&S GCI for is_about was too strong. Really it was simply sufficient. To effect this change we introduce this relation, which is subproperty of is_about, and have previous GCI use this relation \"mentions\" in it's (logical) definition"@en ;
    ns1:IAO_0000117 "PERSON: Jonathan Rees"@en,
        "Person: Alan Ruttenberg"@en ;
    rdfs:subPropertyOf ns1:IAO_0000136 .

ns1:IAO_0000181 a owl:Class ;
    rdfs:label "Venn diagram"@en ;
    ns1:IAO_0000111 "Venn diagram"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A Venn diagram is a report graph showing all hypothetically possible\\nlogical relations between a finite collection of sets."@en ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert"@en,
        "PERSON:James Malone"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Venn_diagram"@en ;
    rdfs:subClassOf ns1:IAO_0000038 .

ns1:IAO_0000182 a owl:Class ;
    rdfs:label "obsolete_survival curve"@en ;
    ns1:IAO_0000111 "obsolete_survival curve"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A survival curve is a report graph which is a graphical representation of data where the percentage of survival is plotted as a function of time."@en ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert"@en,
        "PERSON:James Malone"@en,
        "PERSON:Melanie Courtot"@en ;
    ns1:IAO_0000119 "WEB: http://www.graphpad.com/www/book/survive.htm"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:IAO_0000186 a owl:Class ;
    rdfs:label "photographic print"@en ;
    ns1:IAO_0000111 "photographic print"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A photographic print is a material entity upon which a photograph generically depends."@en ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"@en,
        "PERSON:Melanie Courtot"@en ;
    rdfs:subClassOf ns1:IAO_0000178 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000053 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000059 ;
                                owl:someValuesFrom ns1:IAO_0000185 ] ] ) ] .

ns1:IAO_0000220 a owl:ObjectProperty ;
    rdfs:label "obsolete_materially denotes"^^xsd:string ;
    ns1:IAO_0000116 "see https://github.com/information-artifact-ontology/IAO/issues/25&q=denote"^^xsd:string ;
