ns1:IAO_0000233 a owl:AnnotationProperty ;
    rdfs:label "term tracker item"@en ;
    ns1:IAO_0000111 "term tracker item" ;
    ns1:IAO_0000112 "the URI for an OBI Terms ticket at sourceforge, such as https://sourceforge.net/p/obi/obi-terms/772/" ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An IRI or similar locator for a request or discussion of an ontology term." ;
    ns1:IAO_0000117 "Person: Jie Zheng, Chris Stoeckert, Alan Ruttenberg" ;
