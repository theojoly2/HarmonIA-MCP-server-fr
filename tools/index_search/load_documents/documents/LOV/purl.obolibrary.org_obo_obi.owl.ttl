ns1:OBI_0001866 a owl:Class ;
    rdfs:label "secondary cultured cell"^^xsd:string ;
    ns1:IAO_0000111 "secondary cultured cell"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cultured cell that has been passaged or derives from a cell that has been passaged in culture. "^^xsd:string ;
    ns1:IAO_0000116 "The term 'secondary cell culture' is generally used in biological texts/protocols to refer to any culture following an initial passage.  We include it here because there are often a number of passages between a primary culture and the establishment of a stable, homogenous cell line.  Such cultures are considered to be 'secondary cultures' but not 'cell lines' during this intermediate passaging/selection period between their derivation from a 'primary cell culture' and derivation into a 'cell line', which is a more specific type of secondary culture."^^xsd:string ;
    ns1:IAO_0000117 "Person: Matthew Brush" ;
    ns1:IAO_0000119 "PERSON: Matthew Brush"^^xsd:string ;
    rdfs:comment "A secondary cultured cell has been passaged in culture or is a descendant of such a cell that is derived through propagation in culture."^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom ns1:OBI_0600037 ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0001000 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000312 ;
                                owl:someValuesFrom ns1:OBI_0600037 ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:CL_0000001 ],
        ns1:CL_0000010 .

