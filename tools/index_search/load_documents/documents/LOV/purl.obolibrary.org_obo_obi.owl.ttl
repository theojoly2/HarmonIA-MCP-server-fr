    rdfs:label "animal cage"@en ;
    ns1:IAO_0000111 "animal cage"@en ;
    ns1:IAO_0000112 "PMID: 18246864.Barthold SW.Effects of cage density on behavior in young adult mice."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a processed material which has the function to define a bounded habitat which is amenable to keeping animals."@en ;
    ns1:IAO_0000117 "PERSON: Phillippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "laboratory cage"@en ;
    ns1:IAO_0000119 "OBI biomaterial branch"^^xsd:string ;
