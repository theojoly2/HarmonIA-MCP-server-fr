            owl:onProperty ns1:RO_0000081 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        ns1:BFO_0000023 .

ns1:OBI_0002458 a owl:Class ;
    rdfs:label "chromosome conformation capture-on-chip assay" ;
    ns1:IAO_0000111 "chromosome conformation capture-on-chip assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A nuclear ligation assay which uses cross-linking of proteins to proteins and DNA, followed by two rounds of digestion and ligation, inverse PCR, and characterization by microarray or DNA sequencing. This enables unbiased genome-wide screens for DNA contacts made by single genomic sites of interest."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "4C assay"^^xsd:string,
        "circularized chromosome conformation capture assay"^^xsd:string ;
    ns1:IAO_0000119 "url:http://www.sciencedirect.com/science/article/pii/B9780123919380000045"^^xsd:string ;
    ns1:IAO_0000233 "https://github.com/obi-ontology/obi/issues/875"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0002598 ],
        ns1:OBI_0002438 .

ns1:OBI_0002466 a owl:Class ;
    rdfs:label "alignment counting algorithm" ;
    ns1:IAO_0000111 "alignment counting algorithm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An algorithm used to assign aligned sequence reads, resulting from a reference genome transcriptome alignment algorithm, to sequence features (e.g. genes or transcripts)."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:IAO_0000064 .

ns1:OBI_0002469 a owl:Class ;
    rdfs:label "base calling application"@en ;
    ns1:IAO_0000111 "base calling application"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A base-calling application that implments a base-calling algorithm to convert BCL (binary base call) files, (e.g., those generated by Illumina sequencing systems) to standard FASTQ file formats for downstream analysis."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:IAO_0000594 .

ns1:OBI_0002478 a owl:Class ;
    rdfs:label "reference genome-transcriptome alignment algorithm"@en ;
    ns1:IAO_0000111 "reference genome-transcriptome alignment algorithm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An algorithm that attempts to align a nucleic acid sequence to a reference genome and transcriptome."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:IAO_0000064 .

ns1:OBI_0002556 a owl:Class ;
    rdfs:label "minimum age value specification"@en ;
    ns1:IAO_0000111 "minimum age value specification"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A value specifcation that specifies the youngest age when specifying an age range."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    rdfs:subClassOf ns1:OBI_0001933 .

ns1:OBI_0002557 a owl:Class ;
    rdfs:label "maximum age value specification"@en ;
    ns1:IAO_0000111 "maximum age value specification"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A value specifcation that specifies the oldest age when specifying an age range."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    rdfs:subClassOf ns1:OBI_0001933 .

ns1:OBI_0002566 a owl:Class ;
    rdfs:label "file merge" ;
    ns1:IAO_0000111 "file merge" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A data transformation in which data contained in 2 or more files are merged into a single file."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000973 ],
        ns1:OBI_0200000 .

ns1:OBI_0002574 a owl:Class ;
    rdfs:label "RNA extraction with polyA depletion"^^xsd:string ;
    ns1:IAO_0000111 "RNA extraction with polyA depletion"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A RNA extraction process in which only RNAs lacking a polyA tail are retained"^^xsd:string ;
    ns1:IAO_0000117 "Mark A. Miller, based on OBI_0000848"^^xsd:string ;
    ns1:IAO_0000119 "UPenn Group"^^xsd:string ;
    dc:date "2018-05-11T15:01:14+00:00"^^xsd:dateTime ;
    rdfs:subClassOf ns1:OBI_0666666 .

ns1:OBI_0002578 a owl:Class ;
    rdfs:label "adapter sequence data" ;
    ns1:IAO_0000111 "adapter sequence data" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Nucleotide sequences of molecules that are ligated to assay samples prior to sequencing of these samples;  these sequences are provided by assay kit manufacturers and typically used to combine sequencing of multiple samples in one assay run."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000973 .

ns1:OBI_0002579 a owl:Class ;
    rdfs:label "adapter-trimmed sequence data" ;
    ns1:IAO_0000111 "adapter-trimmed sequence data" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The results of a data transformation of sequence data in which reference subsequences corresponding to ligated library adapters are removed."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000973 .

ns1:OBI_0002582 a owl:Class ;
    rdfs:label "sequence library feature count data" ;
    ns1:IAO_0000111 "sequence library feature count data" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The results of a sequence data feature count tabulation."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000100 .

ns1:OBI_0002594 a owl:Class ;
    rdfs:label "direct interaction identification design" ;
    ns1:IAO_0000111 "direct interaction identification design" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A molecular interaction identification design that investigates the influence of molecules, which are in direct contact, on one another."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "molecular binding identification design"^^xsd:string ;
    ns1:IAO_0000119 "MI:0407"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000058 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:BFO_0000054 ;
                    owl:someValuesFrom [ a owl:Restriction ;
                            owl:onProperty ns1:BFO_0000051 ;
                            owl:someValuesFrom ns1:OBI_0001146 ] ] ],
        ns1:OBI_0002590 .

ns1:OBI_0002598 a owl:Class ;
    rdfs:label "inverse polymerase chain reaction" ;
    ns1:IAO_0000111 "inverse polymerase chain reaction" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A polymerase chain reaction which amplifies DNA with only one known sequence from which primers may be designed. A series of restriction digestions and ligations result in a looped DNA fragment which can be primed for PCR."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "inverse PCR"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Chromosome_conformation_capture"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000415 .

ns1:OBI_0002602 a owl:Class ;
    rdfs:label "multiplexed sequence data" ;
    ns1:IAO_0000111 "multiplexed sequence data" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Sequence data from a sequence library generated from at least two different sources, where each read in the sequence data includes base calls from a multiplex identifier sequence that can be used to trace the source of the read to its source."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000973 .

ns1:OBI_0002617 a owl:Class ;
    rdfs:label "national registry"@en ;
    ns1:IAO_0000111 "national registry"@en ;
    ns1:IAO_0000112 "The Social Security Administration's Death Master File is a national registry in the United States."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An information content entity that contains information about a nationwide group of individuals."^^xsd:string ;
    ns1:IAO_0000117 "MIABIS"^^xsd:string,
        "Sarah Bost"^^xsd:string ;
    ns1:IAO_0000119 "MIABIS contributors"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0100067 a owl:Class ;
    rdfs:label "bronchial alveolar lavage"@en ;
    ns1:IAO_0000111 "bronchial alveolar lavage"@en ;
    ns1:IAO_0000112 "solution containing lung derived T cells, eosinophils, and TNFa."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Group of biomaterials present in the bronchial aveolar space of an organism which are collected through lavage including the reagents used to for the lavage process, organisms, cells, and cellular secretions present in the bronchial aveolar space."@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"@en ;
    ns1:IAO_0000118 "BAL"@en ;
    ns1:IAO_0000119 "GROUP: IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0600044 ;
            owl:onProperty ns1:OBI_0000312 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:OBI_0000112 ],
        ns1:OBI_0100051 .

ns1:OBI_0200005 a owl:Class ;
    rdfs:label "feature extraction objective"@en ;
    ns1:IAO_0000111 "feature extraction objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A feature extraction objective is a data transformation objective where the aim of the data transformation is to generate quantified values from a scanned image."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000119 "TERM: http://mged.sourceforge.net/ontologies/MGEDOntology.owl#feature_extraction"@en ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200029 a owl:Class ;
    rdfs:label "mean centering"@en ;
    ns1:IAO_0000111 "mean centering"@en ;
    ns1:IAO_0000112 "This can be used as a normalization method in expression microarray assays. For example, given a two-channel microarray assay, the log ratios of the two channels (M values) can be mean-centered."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A mean centering is a data transformation that takes as input an n-dimensional (real) vector, performs a mean calculation on its components, and subtracts the resulting mean from each component of the input."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en ;
    ns1:IAO_0000118 "mean centring"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200031 a owl:Class ;
    rdfs:label "differential expression analysis objective"@en ;
    ns1:IAO_0000111 "differential expression analysis objective"@en ;
    ns1:IAO_0000112 "Analyses implemented by the SAM (http://www-stat.stanford.edu/~tibs/SAM), PaGE (www.cbil.upenn.edu/PaGE) or GSEA (www.broad.mit.edu/gsea/) algorithms and software"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A differential expression analysis objective is a data transformation objective whose input consists of expression levels of entities (such as transcripts or proteins), or of sets of such expression levels, under two or more conditions and whose output reflects which of these are likely to have different expression across such conditions."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200033 a owl:Class ;
    rdfs:label "leave one out cross validation method"@en ;
    ns1:IAO_0000111 "leave one out cross validation method"@en ;
    ns1:IAO_0000112 "The authors conducted  leave-one-out cross validation to estimate the strength and accuracy of the differentially expressed filtered genes. http://bioinformatics.oxfordjournals.org/cgi/content/abstract/19/3/368"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a data transformation :  leave-one-out cross-validation (LOOCV) involves using a single observation from the original sample as the validation data, and the remaining observations as the training data. This is repeated such that each observation in the sample is used once as the validation data"^^xsd:string ;
    ns1:IAO_0000116 "2009-11-10. Tracker: https://sourceforge.net/tracker/?func=detail&aid=2893049&group_id=177891&atid=886178"^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200188 ],
        ns1:OBI_0000792 .

ns1:OBI_0200041 a owl:Class ;
    rdfs:label "k-means clustering"@en ;
    ns1:IAO_0000111 "k-means clustering"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A k-means clustering is a data transformation which achieves a class discovery or partitioning objective, which takes as input a collection of objects (represented as points in multidimensional space) and which partitions them into a specified number k of clusters. The algorithm attempts to find the centers of natural clusters in the data. The most common form of the algorithm starts by partitioning the input points into k initial sets, either at random or using some heuristic data. It then calculates the mean point, or centroid, of each set. It constructs a new partition by associating each point with the closest centroid. Then the centroids are recalculated for the new clusters, and the algorithm repeated by alternate applications of these two steps until convergence, which is obtained when the points no longer switch clusters (or alternatively centroids are no longer changed)."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/K-means"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200172 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000648 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200178 ] ) ],
        ns1:OBI_0200171,
        ns1:OBI_0200175 .

ns1:OBI_0200051 a owl:Class ;
    rdfs:label "principal components analysis dimensionality reduction"@en ;
    ns1:IAO_0000111 "principal components analysis dimensionality reduction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A principal components analysis dimensionality reduction is a dimensionality reduction achieved by applying principal components analysis and by keeping low-order principal components and excluding higher-order ones."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000118 "pca data reduction"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en,
        "PERSON: James Malone"@en,
        "PERSON: Melanie Courtot"@en ;
    rdfs:subClassOf ns1:OBI_0200050 .

ns1:OBI_0200052 a owl:Class ;
    rdfs:label "probabilistic algorithm"@en ;
    ns1:IAO_0000111 "probabilistic algorithm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A probabilistic algorithm is one which involves an element of probability or randomness in the transformation of the data."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200057 a owl:Class ;
    rdfs:label "replicate analysis"@en ;
    ns1:IAO_0000111 "replicate analysis"@en ;
    ns1:IAO_0000112 "Replicate analysis can be used in microarray analysis to identify and potentially exclude low quality data."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A replicate analysis is a data transformation in which data from replicates are combined, e.g. through descriptive statistics calculations, and the results might be utilized for a variety of purposes, like assessing reproducibility, identifying outliers, normalizing, etc."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en,
        "Helen Parkinson"@en ;
    ns1:IAO_0000119 "PERSON: Helen Parkinson"@en,
        "PERSON:Elisabetta Manduchi"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200167 ],
        ns1:OBI_0200169 .

ns1:OBI_0200093 a owl:Class ;
    rdfs:label "polynomial transformation"@en ;
    ns1:IAO_0000111 "polynomial transformation"@en ;
    ns1:IAO_0000112 "a*x+b, with a non-zero, is a polynomial of degree one in one variable;  a*x^2+b*x+c, with a nonzero, is a polynomial of degree 2 in 1\\nvariable; a*x*y+b*y+c, with a non-zero, is a polynomial of degree 2 in 2 variables (x and y); a_1*x_1+...+a_n*x_n+b, with at least one of the a_i's non-zero, is a polynomial of degree one in n variables"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A polynomial transformation is a data transformation that is obtained through a polynomial, where a polynomial is a mathematical expression involving a sum of powers in one or more variables multiplied by coefficients (e.g. see http://mathworld.wolfram.com/Polynomial.html). The number of variables and the degree are properties of a polynomial. The degree of a polynomial is the highest power of its terms, where the terms of a polynomial are the individual summands with the coefficients omitted."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"@en ;
    ns1:IAO_0000119 "WEB: http://mathworld.wolfram.com/Polynomial.html"@en ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200135 a owl:Class ;
    rdfs:label "edge quality calculation"@en ;
    ns1:IAO_0000111 "edge quality calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network analysis in which an input data set describing node objects and edge relationships between node objects is used to determine the output quality of one of the edge relationships in the network."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200080 .

ns1:OBI_0200147 a owl:Class ;
    rdfs:label "network graph quality calculation"@en ;
    ns1:IAO_0000111 "network graph quality calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network analysis in which an input data set describing node objects and edge relationships between node objects is used to determine the output quality of the network as a whole."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200080 .

ns1:OBI_0200173 a owl:Class ;
    rdfs:label "background correction objective"@en ;
    ns1:IAO_0000111 "background correction objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A background correction objective is a data transformation objective where the aim is to remove irrelevant contributions from the measured signal, e.g. those due to instrument noise or sample preparation."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200168 .

ns1:OBI_0200185 a owl:Class ;
    rdfs:label "scaling data transformation"@en ;
    ns1:IAO_0000111 "scaling data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A scaling data transformation is a data transformation that has objective scaling."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200183 ] .

ns1:OBI_0200189 a owl:Class ;
    rdfs:label "merging objective"@en ;
    ns1:IAO_0000111 "merging objective"^^xsd:string ;
    ns1:IAO_0000112 "merging of columns from two different data sets"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A merging objective is a data transformation objective in which the data transformation has the aim of performing a union of two or more sets."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000118 "combining objective"@en ;
    ns1:IAO_0000119 "PERSON: Data Transformation Branch"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200196 a owl:Class ;
    rdfs:label "correlation study objective"^^xsd:string ;
    ns1:IAO_0000111 "correlation study objective"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data transformation objective in which correlation is obtained (often measured as a correlation coefficient, ρ) which indicates the strength and direction of a relationship between two random variables."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Tina Boussard"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200198 a owl:Class ;
    rdfs:label "tandem mass spectrometry"^^xsd:string ;
    ns1:IAO_0000111 "tandem mass spectrometry"^^xsd:string ;
    ns1:IAO_0000112 "A precursor ion is selected in the first stage, allowed to fragment and then all resultant masses are scanned in the second mass analyzer and detected in the detector that is positioned after the second mass analyzer. This experiment is commonly performed to identify transitions used for quantification by tandem MS."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Tandem mass spectrometry is a data transformation that uses two or more analyzers separated by a region in which ions can be induced to fragment by transfer of energy (frequently by collision with other molecules)."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Tina Boussard"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Tina Boussard"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200197 ],
        ns1:OBI_0200085 .

ns1:OBI_0302716 a owl:Class ;
    rdfs:label "pool of specimens"@en ;
    ns1:IAO_0000111 "pool of specimens"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pool of specimens is a mixture of a population of samples which have been gathered from one or more sample populations, obtained by the physical process of mixing individual specimens, e.g.  mixing the DNA collected from the individual fish."@en ;
    ns1:IAO_0000116 "check with advisors as to how to represent multiple instances of any class? a set of specimens which have been gathered from one or more sample_populations, obtained by the physical process of mixing individual specimens, e.g.  mixing the DNA collected from the individual fish"@en ;
    ns1:IAO_0000117 "PERSON: Jennifer Fostel"^^xsd:string ;
    ns1:IAO_0000119 "GROUP: CEBS"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000953 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0100051 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000652 [ a owl:Restriction ;
                                            owl:allValuesFrom ns1:OBI_0100051 ;
                                            owl:onProperty ns1:OBI_0000293 ] ) ] ] ) ] .

ns1:OBI_0302731 a owl:Class ;
    rdfs:label "buffer role"@en ;
    ns1:IAO_0000111 "buffer role"^^xsd:string ;
    ns1:IAO_0000112 "A buffer of carbonic acid (H2CO3) and bicarbonate (HCO3-) is present in blood plasma, to maintain a pH between 7.35 and 7.45. http://en.wikipedia.org/wiki/Buffer_solution"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a role which inheres in some molecular entity realized during the process of buffering"^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "Person:Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "buffer"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_0302733 a owl:Class ;
    rdfs:label "solute role"@en ;
    ns1:IAO_0000111 "solute role"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18380397.Pharmazie. 2008 Feb;63(2):113-21.Deviations of drug solubility in water-cosolvent mixtures from the Jouyban-Acree model--effect of solute structure."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "solute role is a role played by a chemical entity which is dissolved by another chemical entity (the solvent) when creating a solution"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "adapted from wikipedia (http://en.wikipedia.org/wiki/Solute)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000685 ;
            owl:onProperty ns1:BFO_0000054 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:CHEBI_23367 ],
        ns1:BFO_0000023 .

ns1:OBI_0302874 a owl:Class ;
    rdfs:label "edited document"@en ;
    ns1:IAO_0000111 "edited document"^^xsd:string ;
    ns1:IAO_0000112 "The OBI manuscript is (much) edited imformation"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A document which is the output of a document editing process"^^xsd:string ;
    ns1:IAO_0000117 "Person:Bjoern Peters"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0302908 ],
        ns1:IAO_0000310 .

ns1:OBI_0302885 a owl:Class ;
    rdfs:label "filtration"@en ;
    ns1:IAO_0000111 "filtration"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18524968.Filtration of CSF improves isolation of Mycobacteria.J Clin Microbiol. 2008 Jun 4."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "filtration is a process which separates components suspended in a fluid based on granularity properties relying on a filter device"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "OBI-Branch: adapted from wikipedia and wordnet"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:OBI_0000151 ],
        ns1:OBI_0600014 .

ns1:OBI_0302894 a owl:Class ;
    rdfs:label "cell lysis"@en ;
    ns1:IAO_0000111 "cell lysis"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18484276.Cell lysis with dimethyl sulphoxide produces stable homogeneous solutions in the dichlorofluorescein oxidative stress assay. Free Radic Res. 2008 May;42(5):435-41."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "cell lysis is a process by which cell membrane integrity of live cells  is compromised and leads to cell death. Cell lysis may be achieved by means of viral action or osmotic shock."@en ;
    ns1:IAO_0000116 "BP, JG, RV: There is also a need for the unplanned cell lysis, which is probably not in the scope of OBI, but should be linked to from this process."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "adapted from wikipedia [http://en.wikipedia.org/wiki/Lysis]"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:CL_0000000 ns1:OBI_0100060 ) ] ],
        ns1:OBI_0600006 .

ns1:OBI_0302899 a owl:Class ;
    rdfs:label "decapitation"@en ;
    ns1:IAO_0000111 "decapitation"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18246869. Loss of cortical function in mice after decapitation, cervical dislocation, potassium chloride injection, and CO2 inhalation. Comp Med. 2007 Dec;57(6):570-"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "decapitation is a process by which the head of a living organism is physically removed from the body, usually resulting in rapid death (in the case of Rhodnius prolixus, it might take a bit longer..)"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "OBI-Branch"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000919 .

ns1:OBI_0302900 a owl:Class ;
    rdfs:label "group randomization"@en ;
    ns1:IAO_0000111 "group randomization"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18349405. Randomization reveals unexpected acute leukemias in Southwest Oncology Group prostate cancer trial. J Clin Oncol. 2008 Mar 20;26(9):1532-6."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A group assignment which relies on chance to assign materials to a group of materials in order to avoid bias in experimental set up."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "adapted from wikipedia [http://en.wikipedia.org/wiki/Randomization]"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0600015 .

ns1:OBI_0302905 a owl:Class ;
    rdfs:label "elution"@en ;
    ns1:IAO_0000111 "elution"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18549238.Theory and Application of the Two-Mode Gradient Elution in Liquid Chromatography Involving Simultaneous Changes in Temperature and Mobile-Phase Composition.Anal Chem. 2008 Jun 13."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "the process of extracting one material from another by washing with a solvent to remove adsorbed material from an adsorbent (as in washing of loaded ion-exchange resins to remove captured ions)"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "wordnet.princeton.edu/perl/webwn"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000318 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:OBI_0000038 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:CHEBI_23367 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:OBI_0302732 ] ) ] ],
        ns1:OBI_0000094 .

ns1:OBI_0302908 a owl:Class ;
    rdfs:label "document editing"@en ;
    ns1:IAO_0000111 "document editing"^^xsd:string ;
    ns1:IAO_0000112 "Wax DB, Beilin Y, Hossain S, Lin HM, Reich DL.\\nManual editing of automatically recorded data in an anesthesia information management system. Anesthesiology. 2008 Nov;109(5):811-5. PMID: 18946292"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "is a planned process with specified input original document and specified output edited document"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra and OBI consortium"^^xsd:string ;
    ns1:IAO_0000119 "adapted from wikipedia"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0302874 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:IAO_0000310 ],
        ns1:OBI_0000011 .

ns1:OBI_0302910 a owl:Class ;
    rdfs:label "prediction"@en ;
    ns1:IAO_0000111 "prediction"^^xsd:string ;
    ns1:IAO_0000112 "Prediction of TF target sites based on atomistic models of protein-DNA complexes. BMC Bioinformatics. 2008 Oct 16;9(1):436. PMID: 18922190"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process by which an  event or an entity is described before it actually happens or is being discovered and identified."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:IAO_0000109 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000109 ],
        ns1:OBI_0000011 .

ns1:OBI_0302911 a owl:Class ;
    rdfs:label "validation"@en ;
    ns1:IAO_0000111 "validation"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18557814 . Chemical and genetic validation of dihydrofolate reductase-thymidylate synthase as a drug target in African trypanosomes. Mol Microbiol. 2008 Jun 16."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a planned process with objective to check that the accuracy or the quality of a claim or prediction  satisfies some criteria and which is assessed by comparing with independent results"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "adapted from wordnet (wkipedia)"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000011 .

ns1:OBI_0302914 a owl:Class ;
    rdfs:label "digital curation"@en ;
    ns1:IAO_0000111 "digital curation"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 16901087. Supporting the curation of biological databases with reusable text mining.Genome Inform. 2005;16(2):32-44."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Digital curation is the process of establishing and developing long term repositories of digital assets for current and future reference by researchers, scientists, and historians, and scholars generally."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "wikipedia"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000572 .

ns1:OBI_0400073 a owl:Class ;
    rdfs:label "metal vapor laser"@en ;
    ns1:IAO_0000111 "metal vapor laser"@en ;
    ns1:IAO_0000112 "Gold vapor laser, Helium-cadmium metal-vapor laser"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A metal vapor laser is a gas laser in which the lasing medium is metal vapor. A metal vapor laser can by used to irradiate cells in a flow cytometer."@en ;
    ns1:IAO_0000117 "John Quinn"@en ;
    ns1:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en ;
    rdfs:subClassOf ns1:OBI_0400047 .

ns1:OBI_0400081 a owl:Class ;
    rdfs:label "particle delivery vessel"@en ;
    ns1:IAO_0000111 "particle delivery vessel"@en ;
    ns1:IAO_0000112 "FC 500 particle delivery vessel"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Part of the fluidics subsystem. A particle delivery vessel is used to introduce either a single sample or multiple samples to a flow cytometer. The most common particle delivery vessel is a sample tube."@en ;
    ns1:IAO_0000117 "John Quinn"@en ;
    ns1:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en ;
    ns1:IAO_0000232 "FG: this should be delted - particle delivery is a role that an object can play"@en ;
    rdfs:subClassOf ns1:OBI_0000047 .

ns1:OBI_0400083 a owl:Class ;
    rdfs:label "photodiode"@en ;
    ns1:IAO_0000111 "photodiode"@en ;
    ns1:IAO_0000112 "Avalanche photodiode"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A photodiode is a semiconductor photodetector used to detect light and generate an electrical current. Typically used in forward scatter (FSC) detection. The photodiode collects the forward light scatter in a cytometer."@en ;
    ns1:IAO_0000117 "John Quinn"@en ;
    ns1:IAO_0000119 "http://cyto.mednet.ucla.edu/Protocols/flow.htm"@en ;
    rdfs:subClassOf ns1:OBI_0400082 .

ns1:OBI_0400096 a owl:Class ;
    rdfs:label "solid state laser"@en ;
    ns1:IAO_0000111 "solid state laser"@en ;
    ns1:IAO_0000112 "Solid State Heat Capacity Laser developed at DOE's Lawrence Livermore National Laboratory for the USA Army's Space and Missile Defense Command"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A solid-state laser is a laser that uses a lasing medium that is a solid, rather than a liquid such as dye lasers or a gas such as gas lasers. Semiconductor-based diode lasers are also in the solid state, but are generally considered separately from solid-state lasers. The first laser developed was an optical pumped ruby crystal solid state laser."@en ;
    ns1:IAO_0000117 "Daniel Schober"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Solid-state_laser"@en ;
    rdfs:subClassOf ns1:OBI_0400064 .

ns1:OBI_0400112 a owl:Class ;
    rdfs:label "liquid handler"@en ;
    ns1:IAO_0000111 "liquid handler"@en ;
    ns1:IAO_0000112 "Beckman BioMek 2000"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a device that is used for automated liquid transfer and handling."@en ;
    ns1:IAO_0000118 "liquid_handling_instrument"@en ;
    ns1:IAO_0000119 "MO_868 liquid_handler"@en ;
    ns1:IAO_0000232 "DS: Is this class justified? Its a unnamed class. If so, put a fluidic_system and the fluidic_subsystem as subclasses.\\nTW: This is required by MO.\\nFG & DS: Capture as function.\\nAll: Needs to be reviewed, according to query use case. If we keep it its kept as unnamed owl class.\\nThe liquid handling class remains but as an undefined class with are unlikely to have children. It is expected that the reasoner would classifiy appropriate classes under this class that meet the have the liquid_handling function relation."@en,
        "DS: Is this class justified? Its a unnamed class. If so, put a fluidic_system and the fluidic_subsystem as subclasses.\\nTW: This is required by MO.\\nFG: Or as function."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000383 ],
        ns1:OBI_0000968 .

