    ns1:IAO_0000111 "molecular analysis facility organization" ;
    ns1:IAO_0000112 "An analysis facility that includes analysis of molecular metabolites, as well as the various DNAs and RNAs." ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
