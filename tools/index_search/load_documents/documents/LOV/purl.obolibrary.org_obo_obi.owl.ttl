    ns1:IAO_0000111 "measured expression level"@en ;
    ns1:IAO_0000112 "Examples are quantified data from an expression microarray experiment, PCR measurements, etc."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
