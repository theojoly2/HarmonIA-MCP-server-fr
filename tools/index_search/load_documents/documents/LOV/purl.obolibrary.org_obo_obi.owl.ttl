                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0100026 [ a owl:Class ;
                                            owl:unionOf ( [ a owl:Restriction ;
                                                        owl:onProperty ns1:BFO_0000051 ;
                                                        owl:someValuesFrom ns1:OBI_0000925 ] [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0002220 ;
                                                        owl:someValuesFrom ns1:OBI_0000925 ] ) ] [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_1110083 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002087 ;
                        owl:someValuesFrom ns1:OBI_1110111 ] ) ] .

ns1:OBI_1110028 a owl:Class ;
    rdfs:label "293-T cell line"@en ;
    ns1:IAO_0000111 "293-T cell line"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A cell line derived from human embryonic kidney cells. This cell line contains the SV40 Large T-antigen, allowing episomal replication of transfected plasmids containing the SV40 origin of replication."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en,
        "http://www.biotech.ist.unige.it/cldb/cl5008.html"@en ;
    rdfs:subClassOf ns1:CLO_0009828 .

ns1:OBI_1110029 a owl:Class ;
    rdfs:label "C1R cell line"@en ;
    ns1:IAO_0000111 "C1R cell line"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A cell line derived from human B cells. This cell line was created by EBV transformation (B-lymphoblastoid cell-line (BLCL))."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:CLO_0009828 .

