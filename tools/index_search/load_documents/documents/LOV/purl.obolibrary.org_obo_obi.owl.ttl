ns1:OBI_0200179 a owl:Class ;
    rdfs:label "class prediction objective"@en ;
    ns1:IAO_0000111 "class prediction objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A class prediction objective (sometimes called supervised classification) is a data transformation objective where the aim is to create a predictor from training data through a machine learning technique. The training data consist of pairs of objects (typically vectors of attributes) and\\nclass labels for these objects. The resulting predictor can be used to attach class labels to any valid novel input object. Depending on usage, the prediction can be definite or probabilistic. A classification is learned from the training data and can then be tested on test data."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000118 "classification objective"^^xsd:string,
        "supervised classification objective"@en ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"^^xsd:string,
        "PERSON: James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0302884 a owl:Class ;
    rdfs:label "extraction"@en ;
    ns1:IAO_0000111 "extraction"^^xsd:string ;
    ns1:IAO_0000112 "nucleic acid extraction using phenol chloroform"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A material separation in which a desired component of an input material is separated from the remainder"^^xsd:string ;
    ns1:IAO_0000116 "Current the output of material processing defined as the molecular entity, main component in the output material entity, rather than the material entity that have grain molecular entity. \\n'nucleic acid extract' is the output of 'nucleic acid extraction' and has grain 'nucleic acid'. However, the output of 'nucleic acid extraction' is 'nucleic acid' rather than 'nucleic acid extract'. We are aware of this issue and will work it out in the future."@en ;
    ns1:IAO_0000117 "Person:Bjoern Peters"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        ns1:OBI_0600014 .

ns1:OBI_0302886 a owl:Class ;
    rdfs:label "centrifugation"@en ;
    ns1:IAO_0000111 "centrifugation"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18428461.Purification of oligodendrocytes and their progenitors using immunomagnetic separation and Percoll gradient centrifugation. Curr Protoc Neurosci. 2001 May;Chapter 3:Unit 3.12."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "centrifugation is a process separating molecules by size or density using centrifugal forces generated by a spinning rotor. G-forces of several hundred thousand times gravity are generated in ultracentrifugation"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "adapted from http://www.fao.org/DOCREP/003/X3910E/X3910E06.htm"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:OBI_0400106 ],
        ns1:OBI_0600014 .

ns1:OBI_0302887 a owl:Class ;
    rdfs:label "staining"@en ;
    ns1:IAO_0000111 "staining"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18540298. Role of modified bleach method in staining of acid-fast bacilli in lymph node aspirates. Acta Cytol. 2008 May-Jun;52(3):325-8."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Staining is a process which results in the addition a class-specific (DNA, proteins, lipids, carbohydrates) dye to a substrate to qualify or quantify the presence of a specific compound."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "adapted from Wikipedia: http://en.wikipedia.org/wiki/Staining"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0400060 a owl:Class ;
    rdfs:label "ion laser"@en ;
    ns1:IAO_0000111 "ion laser"@en ;
    ns1:IAO_0000112 "2 Watt Lexel 88 Argon Ion laser"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An ion laser is a gas laser which uses an ionized gas as its lasing medium."@en ;
    ns1:IAO_0000117 "Daniel Schober"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Ion_laser"^^xsd:string,
        "John Quinn"@en ;
    rdfs:subClassOf ns1:OBI_0400047 .

ns1:OBI_0400064 a owl:Class ;
    rdfs:label "laser"@en ;
    ns1:IAO_0000111 "laser"@en ;
    ns1:IAO_0000112 "A laser is the most common way to irradiate a cell in a flow cytometer."@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A laser (acronym for light amplification by the stimulated emission of radiation) is a light source that emits photons of the same characteristics in a coherent beam. A laser uses a solid, liquid or gaseous lasing medium, that contains molecules, of which some atoms have electrons that emit photons of the same frequency when falling back to their normal orbital after excitation (pumping) by external means A laser is the most common way to irradiate a cell in a flow cytometer."@en ;
    ns1:IAO_0000117 "Daniel Schober"@en ;
    ns1:IAO_0000118 "light amplification by the stimulated emission of radiation"@en ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Laser"^^xsd:string,
        "John Quinn"@en ;
    rdfs:subClassOf ns1:OBI_0400065 .

ns1:OBI_1000207 a owl:Class ;
    rdfs:label "assay bead"@en ;
    ns1:IAO_0000111 "assay bead"@en ;
    ns1:IAO_0000112 "Dynabeads are commercially available magnetic beads which are precoated with antibodies specific for select cellular receptors and are used to separate cell populations."@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A globular or round particle of defined physicochemical properties and size which can be exploited as either the primary substance for detection or as a secondary solid platform for the attachment of bioactive molecules."@en ;
    ns1:IAO_0000116 "DS: Probably better modeled as a role."@en ;
    ns1:IAO_0000117 "OBI"@en ;
    ns1:IAO_0000118 "bead"@en ;
    rdfs:subClassOf ns1:OBI_0000047 .

ns1:OBI_1110014 a owl:Class ;
    rdfs:label "epitope binding by adaptive immune receptor"@en ;
    ns1:IAO_0000111 "epitope binding by adaptive immune receptor"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is the process in which an adaptive immune receptor binds to a material entity (realizing its disposition). The binding affinity is significant enough to trigger an immune response. Specifically, transient non-specific binding of adaptive immune receptors occurring during immune surveillance is not considered significant binding."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:GO_0008150 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_1110045 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000052 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                                    owl:onProperty ns1:OBI_1110119 ;
                                                    owl:someValuesFrom ns1:OBI_1110022 ] ) ] ] ) ] ] .

ns1:OBI_1110130 a owl:Class ;
    rdfs:label "biological activity assay measuring epitope specific T cell killing" ;
    ns1:IAO_0000111 "biological activity assay measuring epitope specific T cell killing" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A T cell epitope dependent biological activity assay that detects the killing of an antigen presenting cell (APC) by a T cell whose TCR recognizes an epitope presented by the APC."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "biological activity"^^xsd:string,
        "cytotoxicity"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002055 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0002055 [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0000882 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:IAO_0000030 [ a owl:Restriction ;
                                            owl:onProperty ns1:IAO_0000136 ;
                                            owl:someValuesFrom ns1:GO_0001913 ] ) ] ] ) ] .

ns1:PATO_0000047 a owl:Class ;
    rdfs:label "biological sex"^^xsd:string ;
    ns1:IAO_0000111 "biological sex"^^xsd:string ;
    ns1:IAO_0000115 "An organismal quality inhering in a bearer by virtue of the bearer's ability to undergo sexual reproduction in order to differentiate the individuals or types involved."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001995 .

ns1:PATO_0001421 a owl:Class ;
    rdfs:label "alive"^^xsd:string ;
    ns1:IAO_0000111 "alive"^^xsd:string ;
    ns1:IAO_0000115 "A viability quality inhering in a bearer by virtue of the bearer's condition before death."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000169 .

ns1:PATO_0001741 a owl:Class ;
    rdfs:label "radioactive"^^xsd:string ;
    ns1:IAO_0000111 "radioactive"^^xsd:string ;
    ns1:IAO_0000115 "A radiation quality inhering in bearer by virtue of the bearer's exhibiting or being caused by radioactivity."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001740 .

ns1:RO_0002220 a owl:ObjectProperty ;
    rdfs:label "adjacent to" .

ns1:UBERON_0000481 a owl:Class ;
    rdfs:label "multi-tissue structure"^^xsd:string ;
    ns1:IAO_0000111 "multi-tissue structure"^^xsd:string ;
    ns1:IAO_0000115 "Anatomical structure that has as its parts two or more portions of tissue of at least two different types and which through specific morphogenetic processes forms a single distinct structural unit demarcated by bona-fide boundaries from other distinct structural units of different types."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UO_0000005 a owl:Class ;
    rdfs:label "temperature unit"^^xsd:string ;
    ns1:IAO_0000111 "temperature unit"^^xsd:string ;
    ns1:IAO_0000115 "A unit which is a standard measure of the average kinetic energy of the particles in a sample of matter."^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl ;
    rdfs:subClassOf ns1:IAO_0000003 .

ns1:UO_0000280 a owl:Class ;
    rdfs:label "rate unit"^^xsd:string ;
    ns1:IAO_0000111 "rate unit"^^xsd:string ;
    ns1:IAO_0000115 "A unit which represents a standard measurement occurrence of a process per unit time."^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl ;
    rdfs:subClassOf ns1:IAO_0000003 .

ns1:UO_0000282 a ns1:UO_0000280,
        owl:NamedIndividual ;
    rdfs:label "count per molar second"^^xsd:string ;
    ns1:IAO_0000111 "count per molar second"^^xsd:string ;
    ns1:IAO_0000115 "A rate unit which is equal to one over one molar second."^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl .

ns1:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    ns1:BFO_0000179 "object-aggregate" ;
    ns1:BFO_0000180 "ObjectAggregate" ;
    ns1:IAO_0000112 "a collection of cells in a blood biobank."@en,
        "a swarm of bees is an aggregate of members who are linked together through natural bonds"@en,
        "a symphony orchestra"@en,
        "an organization is an aggregate whose member parts have roles of specific types (for example in a jazz band, a chess club, a football team)"@en,
        "defined by fiat: the aggregate of members of an organization"@en,
        "defined through physical attachment: the aggregate of atoms in a lump of granite"@en,
        "defined through physical containment: the aggregate of molecules of carbon dioxide in a sealed container"@en,
        "defined via attributive delimitations such as: the patients in this hospital"@en,
        "the aggregate of bearings in a constant velocity axle joint"@en,
        "the aggregate of blood cells in your body"@en,
        "the nitrogen atoms in the atmosphere"@en,
        "the restaurants in Palo Alto"@en,
        "your collection of Meissen ceramic plates."@en ;
    ns1:IAO_0000116 "An entity a is an object aggregate if and only if there is a mutually exhaustive and pairwise disjoint partition of a into objects ",
        "BFO 2 Reference: object aggregates may gain and lose parts while remaining numerically identical (one and the same individual) over time. This holds both for aggregates whose membership is determined naturally (the aggregate of cells in your body) and aggregates determined by fiat (a baseball team, a congressional committee)."@en ;
    ns1:IAO_0000119 "ISBN:978-3-938793-98-5pp124-158#Thomas Bittner and Barry Smith, 'A Theory of Granular Partitions', in K. Munn and B. Smith (eds.), Applied Ontology: An Introduction, Frankfurt/Lancaster: ontos, 2008, 125-158." ;
    ns1:IAO_0000600 "b is an object aggregate means: b is a material entity consisting exactly of a plurality of objects as member_parts at all times at which b exists. (axiom label in BFO2 Reference: [025-004])"@en ;
    ns1:IAO_0000602 "(forall (x) (if (ObjectAggregate x) (and (MaterialEntity x) (forall (t) (if (existsAt x t) (exists (y z) (and (Object y) (Object z) (memberPartOfAt y x t) (memberPartOfAt z x t) (not (= y z)))))) (not (exists (w t_1) (and (memberPartOfAt w x t_1) (not (Object w)))))))) // axiom label in BFO2 CLIF: [025-004] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:BFO_0000141 a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    ns1:BFO_0000179 "immaterial" ;
    ns1:BFO_0000180 "ImmaterialEntity" ;
    ns1:IAO_0000116 "BFO 2 Reference: Immaterial entities are divided into two subgroups:boundaries and sites, which bound, or are demarcated in relation, to material entities, and which can thus change location, shape and size and as their material hosts move or change shape or size (for example: your nasal passage; the hold of a ship; the boundary of Wales (which moves with the rotation of the Earth) [38, 7, 10"@en ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000004 .

ns1:BFO_0000147 a owl:Class ;
    rdfs:label "zero-dimensional continuant fiat boundary"@en ;
    ns1:BFO_0000179 "0d-cf-boundary" ;
    ns1:BFO_0000180 "ZeroDimensionalContinuantFiatBoundary" ;
    ns1:IAO_0000112 "the geographic North Pole"@en,
        "the point of origin of some spatial coordinate system."@en,
        "the quadripoint where the boundaries of Colorado, Utah, New Mexico, and Arizona meet"@en ;
    ns1:IAO_0000116 "zero dimension continuant fiat boundaries are not spatial points. Considering the example 'the quadripoint where the boundaries of Colorado, Utah, New Mexico, and Arizona meet' : There are many frames in which that point is zooming through many points in space. Whereas, no matter what the frame, the quadripoint is always in the same relation to the boundaries of Colorado, Utah, New Mexico, and Arizona."@en ;
    ns1:IAO_0000600 "a zero-dimensional continuant fiat boundary is a fiat point whose location is defined in relation to some material entity. (axiom label in BFO2 Reference: [031-001])"@en ;
    ns1:IAO_0000602 "(iff (ZeroDimensionalContinuantFiatBoundary a) (and (ContinuantFiatBoundary a) (exists (b) (and (ZeroDimensionalSpatialRegion b) (forall (t) (locatedInAt a b t)))))) // axiom label in BFO2 CLIF: [031-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000140 .

ns1:CHEBI_33250 a owl:Class ;
    rdfs:label "atom"^^xsd:string ;
    ns1:IAO_0000111 "atom"^^xsd:string ;
    ns1:IAO_0000115 "A chemical entity constituting the smallest component of an element having the chemical properties of the element."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:CLO_0000031 a owl:Class ;
    rdfs:label "cell line"@en ;
    ns1:IAO_0000111 "cell line"@en ;
    ns1:IAO_0000115 "A cultured cell population that represents a genetically stable and homogenous population of cultured cells that shares a common propagation history (i.e. has been successively passaged together in culture).  \\n",
        "A cultured cell population that represents a genetically stable and homogenous population of cultured cells that shares a common propagation history (i.e. has been successively passaged together in culture). "@en ;
    ns1:IAO_0000412 ns1:clo.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000643 ;
            owl:someValuesFrom ns1:CLO_0000001 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CLO_0000001 ;
            owl:onProperty ns1:OBI_0000643 ],
        ns1:OBI_0001905 .

ns1:CL_0000084 a owl:Class ;
    rdfs:label "T cell"^^xsd:string ;
    ns1:IAO_0000111 "T cell"^^xsd:string ;
    ns1:IAO_0000115 "A type of lymphocyte whose defining characteristic is the expression of a T cell receptor complex."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000542 .

ns1:GO_0003824 a owl:Class ;
    rdfs:label "catalytic activity"^^xsd:string ;
    ns1:IAO_0000111 "catalytic activity"^^xsd:string ;
    ns1:IAO_0000115 "Catalysis of a biochemical reaction at physiological temperatures. In biologically catalyzed reactions, the reactants are known as substrates, and the catalysts are naturally occurring macromolecular substances known as enzymes. Enzymes possess specific binding sites for substrates, and are usually composed wholly or largely of protein, but RNA that has catalytic activity (ribozyme) is often also regarded as enzymatic."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0003674 .

ns1:GO_0005575 a owl:Class ;
    rdfs:label "cellular_component"^^xsd:string ;
    ns1:IAO_0000111 "cellular_component"^^xsd:string ;
    ns1:IAO_0000115 "A location, relative to cellular compartments and structures, occupied by a macromolecular machine when it carries out a molecular function. There are two ways in which the gene ontology describes locations of gene products: (1) relative to cellular structures (e.g., cytoplasmic side of plasma membrane) or compartments (e.g., mitochondrion), and (2) the stable macromolecular complexes of which they are parts (e.g., the ribosome)."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:GO_0007596 a owl:Class ;
    rdfs:label "blood coagulation"^^xsd:string ;
    ns1:IAO_0000111 "blood coagulation"^^xsd:string ;
    ns1:IAO_0000115 "The sequential process in which the multiple coagulation factors of the blood interact, ultimately resulting in the formation of an insoluble fibrin clot; it may be divided into three stages: stage 1, the formation of intrinsic and extrinsic prothrombin converting principle; stage 2, the formation of thrombin; stage 3, the formation of stable fibrin polymers."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0032620 a owl:Class ;
    rdfs:label "interleukin-17 production"^^xsd:string ;
    ns1:IAO_0000111 "interleukin-17 production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of any member of the interleukin-17 family of cytokines due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0035398 a owl:Class ;
    rdfs:label "helper T cell enhancement of T cell mediated immune response"^^xsd:string ;
    ns1:IAO_0000111 "helper T cell enhancement of T cell mediated immune response"^^xsd:string ;
    ns1:IAO_0000115 "Positive regulation of a T cell mediated immune response mediated via cytokine production by a helper T cell."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0035397 .

ns1:GO_0044030 a owl:Class ;
    rdfs:label "regulation of DNA methylation"^^xsd:string ;
    ns1:IAO_0000111 "regulation of DNA methylation"^^xsd:string ;
    ns1:IAO_0000115 "Any process that modulates the frequency, rate or extent of the covalent transfer of a methyl group to either N-6 of adenine or C-5 or N-4 of cytosine."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0040030 .

ns1:IAO_0000306 a owl:Class ;
    rdfs:label "table"@en ;
    ns1:IAO_0000111 "table"@en ;
    ns1:IAO_0000112 "| T     F\\n--+-----\\nT   | T     F\\nF   |  F    F"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A textual entity that contains a two-dimensional arrangement of texts repeated at regular intervals across a spatial range, such that the spatial relationships among the constituent texts expresses propositions"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf ns1:IAO_0000300 .

ns1:OBI_0000014 a owl:Class ;
    rdfs:label "regulator role"@en ;
    ns1:IAO_0000111 "regulator role"^^xsd:string ;
    ns1:IAO_0000112 "Fact sheet - Regulating the companies The role of the regulator. Ofwat is the economic regulator of the water and sewerage industry in England and Wales.  http://www.ofwat.gov.uk/aptrix/ofwat/publish.nsf/Content/roleofregulator_factsheet170805"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a regulatory role involved with making and/or enforcing relevant legislation and governmental orders"@en ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "regulator"^^xsd:string ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf ns1:OBI_0000017 .

ns1:OBI_0000023 a owl:Class ;
    rdfs:label "classified data set"@en ;
    ns1:IAO_0000111 "classified data set"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A data set that is produced as the output of a class prediction data transformation and consists of a data set with assigned class labels."@en ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Monnie McGee"^^xsd:string ;
    ns1:IAO_0000118 "data set with assigned class labels"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000100 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0000663 ] .

ns1:OBI_0000219 a owl:Class ;
    rdfs:label "cellular feature identification objective"@en ;
    ns1:IAO_0000111 "cellular feature identification objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Cellular_feature_identification_objective is a biological_feature_identification_objective role describing a study designed to examine or characterize a biological feature monitored at the cellular level, e.g. stage of cell cycle, stage of differentiation."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000015 .

ns1:OBI_0000250 a owl:Class ;
    rdfs:label "dye role"@en ;
    ns1:IAO_0000111 "dye role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A molecular label role which inheres in a material entity and which is realized in the process of detecting a molecular dye that imparts color to some material of interest. "^^xsd:string ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    ns1:IAO_0000118 "dye"^^xsd:string ;
    ns1:IAO_0000119 "A substance used to color materials  www.answers.com/topic/dye  19feb09"^^xsd:string ;
    rdfs:subClassOf ns1:REO_0000171 .

ns1:OBI_0000274 a owl:Class ;
    rdfs:label "adding a material entity into a target"@en ;
    ns1:IAO_0000111 "adding a material entity into a target"^^xsd:string ;
    ns1:IAO_0000112 "Injecting a drug into a mouse. Adding IL-2 to a cell culture. Adding NaCl into water."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "is a process with the objective to place a material entity bearing the 'material to be added role' into a material bearing the 'target of material addition role'."@en ;
    ns1:IAO_0000116 "Class was renamed from 'administering substance', as this is commonly used only for additions into organisms."^^xsd:string ;
    ns1:IAO_0000117 "BP"^^xsd:string ;
    ns1:IAO_0000119 "branch derived"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom ns1:OBI_0000319 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom ns1:OBI_0000444 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:OBI_0000319 ] [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0001025 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                                    owl:onProperty ns1:RO_0000087 ;
                                                    owl:someValuesFrom ns1:OBI_0000444 ] ) ] ] ) ] ],
        ns1:OBI_0000652 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000434 ] .

ns1:OBI_0000295 a owl:ObjectProperty ;
    rdfs:label "is_specified_input_of"@en ;
    ns1:IAO_0000111 "is_specified_input_of"^^xsd:string ;
    ns1:IAO_0000112 "some Autologous EBV(Epstein-Barr virus)-transformed B-LCL (B lymphocyte cell line) is_input_for instance of Chromum Release Assay described at https://wiki.cbil.upenn.edu/obiwiki/index.php/Chromium_Release_assay"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A relation between a planned process and a continuant participating in that process that is not created during  the process. The presence of the continuant during the process is explicitly specified in the plan specification which the process realizes the concretization of."@en ;
    ns1:IAO_0000117 "PERSON:Bjoern Peters"^^xsd:string,
        "Alan Ruttenberg"@en ;
    rdfs:range ns1:OBI_0000011 ;
    rdfs:subPropertyOf ns1:RO_0000056 ;
    owl:equivalentProperty [ owl:inverseOf ns1:OBI_0000293 ] .

ns1:OBI_0000377 a owl:Class ;
    rdfs:label "perturb function"@en ;
    ns1:IAO_0000111 "perturb function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A perturb function is a function that disrupts the normal function of a system induced through either internal or external means.  External means of perturbation include: (1) displacement fields in the physical sense - e.g., temperature change, osmotic shock, pressure change; (2) application of small molecules such as drugs or toxins to perturb the function of specific pathways or application of surfactants to perturb the normal function of plasma membrane.  Internal means of perturbation include: (1) manipulation of gene function via gene knockout or transcript knockdown via RNAi; (2) directed genetic mutation leading to minimal aa alterations that interfere with peptide function."@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Perturbation_biology"@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

