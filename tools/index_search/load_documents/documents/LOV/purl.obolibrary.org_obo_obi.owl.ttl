                                            owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000081 ;
                                                        owl:someValuesFrom ns1:CL_0000000 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:CL_0000000 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000087 ;
                                                        owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:IAO_0000136 ;
                                owl:someValuesFrom ns1:GO_0008283 ] ] ) ] .

ns1:OBI_0000912 a owl:Class ;
    rdfs:label "X-ray crystallography assay" ;
    ns1:IAO_0000111 "X-ray crystallography assay" ;
    ns1:IAO_0000112 "Crystallizing an antibody:antigen complex, and recording the diffraction pattern of a synchrotron beam, and assembling the 3d complex structure based on homologous complexes."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A 3D structure determination assay in which the diffraction of pattern of X-ray beams in a crystal of purified material entities is used to resolve the 3-dimensional structure of the material entity of interest."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
