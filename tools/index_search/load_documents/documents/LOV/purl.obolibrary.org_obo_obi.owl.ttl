    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An International Federation of Gynecology and Obstetrics cervical cancer stage value specification indicating measured stromal invasion of >3.0 mm and not >5.0 mm with an extension of not >7.0 mm."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Stage IA2"^^xsd:string ;
    ns1:IAO_0000119 "https://en.wikipedia.org/wiki/Cervical_cancer_staging"^^xsd:string ;
