    rdfs:label "Cy5 dye"^^xsd:string ;
    ns1:IAO_0000111 "Cy5 dye"^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:REO_0000280 .

ns1:CHEBI_42098 a owl:Class ;
    rdfs:label "digoxigenin"^^xsd:string ;
    ns1:IAO_0000111 "digoxigenin"^^xsd:string ;
    ns1:IAO_0000115 "A hydroxy steroid that consists of 5beta-cardanolide having a double bond at the 20(22)-position as well as hydroxy groups at the 3beta-, 12beta- and 14beta-positions. It has been isolated from the plant species of the genus Digitalis."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:REO_0000280 .

ns1:CHEBI_42191 a owl:Class ;
    rdfs:label "ethylenediaminetetraacetic acid"^^xsd:string ;
    ns1:IAO_0000111 "ethylenediaminetetraacetic acid"^^xsd:string ;
    ns1:IAO_0000115 "A polyamino carboxylic acid that has formula C10H16N2O8."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_51756 a owl:Class ;
    rdfs:label "Alexa Fluor 532"^^xsd:string ;
    ns1:IAO_0000111 "Alexa Fluor 532"^^xsd:string ;
    ns1:IAO_0000115 "An organosulfonic acid that has formula C34H33N3O11S2."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:REO_0000280 .

ns1:CHEBI_51760 a owl:Class ;
    rdfs:label "Alexa Fluor 546"^^xsd:string ;
    ns1:IAO_0000111 "Alexa Fluor 546"^^xsd:string ;
    ns1:IAO_0000115 "An organic heteropentacyclic compound that has formula C44H46Cl3N4NaO14S3."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:REO_0000280 .

ns1:CHEBI_52673 a owl:Class ;
    rdfs:label "Alexa Fluor 555"^^xsd:string ;
    ns1:IAO_0000111 "Alexa Fluor 555"^^xsd:string ;
    ns1:IAO_0000115 "A fluorescent dye of absorption wavelength 555 nm and emission wavelength 565 nm, derived from a 3,6-diaminoxanthene-4,5-disulfate."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:REO_0000280 .

ns1:CHEBI_59050 a owl:Class ;
    rdfs:label "dimethyl sulfate"^^xsd:string ;
    ns1:IAO_0000111 "dimethyl sulfate"^^xsd:string ;
    ns1:IAO_0000115 "The dimethyl ester of sulfuric acid."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_59051 a owl:Class ;
    rdfs:label "diethyl pyrocarbonate"^^xsd:string ;
    ns1:IAO_0000111 "diethyl pyrocarbonate"^^xsd:string ;
    ns1:IAO_0000115 "The diethyl ester of dicarbonic acid."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_59052 a owl:Class ;
    rdfs:label "1,1-dihydroxy-3-ethoxy-2-butanone"^^xsd:string ;
    ns1:IAO_0000111 "1,1-dihydroxy-3-ethoxy-2-butanone"^^xsd:string ;
    ns1:IAO_0000115 "A butanone derivative having two hydroxy substituents at the 1-position and an ethoxy substituent at the 3-position."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_59053 a owl:Class ;
    rdfs:label "N-cyclohexyl-N'-(2-(4-morpholinyl)ethyl)carbodiimide"^^xsd:string ;
    ns1:IAO_0000111 "N-cyclohexyl-N'-(2-(4-morpholinyl)ethyl)carbodiimide"^^xsd:string ;
    ns1:IAO_0000115 "A carbodiimide having cyclcohexyl and 2-(4-morpholinyl)ethyl as the two N-substituents."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_59054 a owl:Class ;
    rdfs:label "N-methylisatoic anhydride"^^xsd:string ;
    ns1:IAO_0000111 "N-methylisatoic anhydride"^^xsd:string ;
    ns1:IAO_0000115 "A 3,1-benzoxazin-1,4-dione having an N-methyl substituent."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_59055 a owl:Class ;
    rdfs:label "(S)-1-(4-bromoacetamidobenzyl)EDTA"^^xsd:string ;
    ns1:IAO_0000111 "(S)-1-(4-bromoacetamidobenzyl)EDTA"^^xsd:string ;
    ns1:IAO_0000115 "A tetracarboxylic acid consisting of ethylenediaminetetraacetic acid having a 4-bromoacetamidobenzyl group at the C1-position and (S)-configuration."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_59424 a owl:Class ;
    rdfs:label "bromophenol blue"^^xsd:string ;
    ns1:IAO_0000111 "bromophenol blue"^^xsd:string ;
    ns1:IAO_0000115 "3H-2,1-Benzoxathiole 1,1-dioxide in which both of the hydrogens at position 3 have been substituted by 3,5-dibromo-4-hydroxyphenyl groups. It is used as a laboratory indicator, changing from yellow below pH 3 to purple at pH 4.6, and as a size marker for monitoring the progress of agarose gel and polyacrylamide gel electrophoresis. It has also been used as an industrial dye."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_9754 a owl:Class ;
    rdfs:label "tris"^^xsd:string ;
    ns1:IAO_0000111 "tris"^^xsd:string ;
    ns1:IAO_0000115 "A primary amino compound that is tert-butylamine in which one hydrogen attached to each methyl group is replaced by a hydroxy group. A compound widely used as a biological buffer substance in the pH range 7--9; pKa = 8.3 at 20 degreeC; pKa = 7.82 at 37 degreeC."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHMO_0000089 a owl:Class ;
    rdfs:label "confocal fluorescence microscopy"^^xsd:string ;
    ns1:IAO_0000115 "Microscopy where the specimen can be made to fluoresce (emit energy as visible light) by scanning a gas (Ar or Kr) laser spot of specific wavelength over its surface and using a spatial pinhole to eliminate out-of-focus fluorescence."^^xsd:string ;
    ns1:IAO_0000118 "CLSM"^^xsd:string,
        "LSCM"^^xsd:string,
        "confocal fluorescence imaging"^^xsd:string,
        "confocal laser scanning fluorescence microscopy"^^xsd:string,
        "confocal laser scanning microscopy"^^xsd:string,
        "confocal-laser scanning microscopy"^^xsd:string,
        "fluorescence confocal microscopy"^^xsd:string,
        "fluorescence confocal scanning laser microscopy"^^xsd:string,
        "scanning confocal fluorescence microscopy"^^xsd:string ;
    ns1:IAO_0000119 "CHMO"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002119 .

ns1:CHMO_0000102 a owl:Class ;
    rdfs:label "light microscopy"^^xsd:string ;
    ns1:IAO_0000115 "Microscopy where the specimen is illuminated with visible light and a system of lenses is used to produce an image."^^xsd:string ;
    ns1:IAO_0000118 "OM"^^xsd:string,
        "light microscopy"^^xsd:string,
        "optical microscopy"^^xsd:string ;
    ns1:IAO_0000119 "CHMO"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002119 .

ns1:CHMO_0000701 a owl:Class ;
    rdfs:label "liquid chromatography-tandem mass spectrometry"^^xsd:string ;
    ns1:IAO_0000115 "A method where a sample mixture is first separated by liquid chromatography before being ionised and characterised by mass-to-charge ratio and relative abundance using two mass spectrometers in series."^^xsd:string ;
    ns1:IAO_0000118 "LC-MS-MS"^^xsd:string,
        "LC-MS/MS"^^xsd:string,
        "LC-MS2"^^xsd:string,
        "LC-MSMS"^^xsd:string,
        "LC/MS/MS"^^xsd:string,
        "LCMSMS"^^xsd:string,
        "liquid chromatography tandem mass spectrometry"^^xsd:string,
        "liquid chromatography tandem mass spectroscopy"^^xsd:string,
        "liquid chromatography-tandem mass spectroscopy"^^xsd:string ;
    ns1:IAO_0000119 "CHMO" ;
    rdfs:subClassOf ns1:OBI_0200198 .

ns1:CLO_0009829 a owl:Class ;
    rdfs:label "mortal cell line"@en ;
    ns1:IAO_0000111 "mortal cell line"@en ;
    ns1:IAO_0000115 "A cell line is able to support only a limited number of passages in vitro."^^xsd:string ;
    ns1:IAO_0000412 ns1:clo.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:OBI_0000877 ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CLO_0000018 ;
            owl:onProperty ns1:OBI_0000643 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000643 ;
            owl:someValuesFrom ns1:CLO_0000018 ],
        ns1:CLO_0000031 .

ns1:CL_0000003 a owl:Class ;
    rdfs:label "native cell"^^xsd:string ;
    ns1:IAO_0000111 "native cell"^^xsd:string ;
    ns1:IAO_0000115 "A cell that is found in a natural setting, which includes multicellular organism cells 'in vivo' (i.e. part of an organism), and unicellular organisms 'in environment' (i.e. part of a natural environment)."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000000 .

ns1:CL_0000057 a owl:Class ;
    rdfs:label "fibroblast"^^xsd:string ;
    ns1:IAO_0000111 "fibroblast"^^xsd:string ;
    ns1:IAO_0000115 "A connective tissue cell which secretes an extracellular matrix rich in collagen and other macromolecules. Flattened and irregular in outline with branching processes; appear fusiform or spindle-shaped."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000000 .

ns1:CL_0000097 a owl:Class ;
    rdfs:label "mast cell"^^xsd:string ;
    ns1:IAO_0000111 "mast cell"^^xsd:string ;
    ns1:IAO_0000115 "A cell that is found in almost all tissues containing numerous basophilic granules and capable of releasing large amounts of histamine and heparin upon activation. Progenitors leave bone marrow and mature in connective and mucosal tissue. Mature mast cells are found in all tissues, except the bloodstream. Their phenotype is CD117-high, CD123-negative, CD193-positive, CD200R3-positive, and FceRI-high. Stem-cell factor (KIT-ligand; SCF) is the main controlling signal of their survival and development."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000000 .

ns1:CL_0000182 a owl:Class ;
    rdfs:label "hepatocyte"^^xsd:string ;
    ns1:IAO_0000111 "hepatocyte"^^xsd:string ;
    ns1:IAO_0000115 "The main structural component of the liver. They are specialized epithelial cells that are organized into interconnected plates called lobules. Majority of cell population of liver, polygonal in shape, arranged in plates or trabeculae between sinusoids; may have single nucleus or binucleated."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000066 .

ns1:CL_0000235 a owl:Class ;
    rdfs:label "macrophage"^^xsd:string ;
    ns1:IAO_0000111 "macrophage"^^xsd:string ;
    ns1:IAO_0000115 "A mononuclear phagocyte present in variety of tissues, typically differentiated from monocytes, capable of phagocytosing a variety of extracellular particulate material, including immune complexes, microorganisms, and dead cells."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000000 .

ns1:CL_0000451 a owl:Class ;
    rdfs:label "dendritic cell"^^xsd:string ;
    ns1:IAO_0000111 "dendritic cell"^^xsd:string ;
    ns1:IAO_0000115 "A cell of hematopoietic origin, typically resident in particular tissues, specialized in the uptake, processing, and transport of antigens to lymph nodes for the purpose of stimulating an immune response via T cell activation. These cells are lineage negative (CD3-negative, CD19-negative, CD34-negative, and CD56-negative)."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000000 .

ns1:CL_0000624 a owl:Class ;
    rdfs:label "CD4-positive, alpha-beta T cell"^^xsd:string ;
    ns1:IAO_0000111 "CD4-positive, alpha-beta T cell"^^xsd:string ;
    ns1:IAO_0000115 "A mature alpha-beta T cell that expresses an alpha-beta T cell receptor and the CD4 coreceptor."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000789 .

ns1:CL_0000767 a owl:Class ;
    rdfs:label "basophil"^^xsd:string ;
    ns1:IAO_0000111 "basophil"^^xsd:string ;
    ns1:IAO_0000115 "Any of the immature or mature forms of a granular leukocyte that in its mature form has an irregularly shaped, pale-staining nucleus that is partially constricted into two lobes, and with cytoplasm that contains coarse, bluish-black granules of variable size. Basophils contain vasoactive amines such as histamine and serotonin, which are released on appropriate stimulation. A basophil is CD123-positive, CD193-positive, CD203c-positive, and FceRIa-positive."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000000 .

ns1:CL_0000786 a owl:Class ;
    rdfs:label "plasma cell"^^xsd:string ;
    ns1:IAO_0000111 "plasma cell"^^xsd:string ;
    ns1:IAO_0000115 "A terminally differentiated, post-mitotic, antibody secreting cell of the B cell lineage with the phenotype CD138-positive, surface immunonoglobulin-negative, and MHC Class II-negative. Plasma cells are oval or round with extensive rough endoplasmic reticulum, a well-developed Golgi apparatus, and a round nucleus having a characteristic cartwheel heterochromatin pattern and are devoted to producing large amounts of immunoglobulin."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000236 .

ns1:CL_0000794 a owl:Class ;
    rdfs:label "CD8-positive, alpha-beta cytotoxic T cell"^^xsd:string ;
    ns1:IAO_0000111 "CD8-positive, alpha-beta cytotoxic T cell"^^xsd:string ;
    ns1:IAO_0000115 "A CD8-positive, alpha-beta T cell that is capable of killing target cells in an antigen specific manner with the phenotype perforin-positive and granzyme B-positive."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000625 .

ns1:CL_0000814 a owl:Class ;
    rdfs:label "mature NK T cell"^^xsd:string ;
    ns1:IAO_0000111 "mature NK T cell"^^xsd:string ;
    ns1:IAO_0000115 "A mature alpha-beta T cell of a distinct lineage that bears natural killer markers and a T cell receptor specific for a limited set of ligands. NK T cells have activation and regulatory roles particularly early in an immune response."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000789 .

ns1:ENVO_00002257 a owl:Class ;
    rdfs:label "podzol"^^xsd:string ;
    ns1:IAO_0000111 "podzol"^^xsd:string ;
    ns1:IAO_0000115 "Podzols are soils with a typically ash-grey upper subsurface horizon, bleached by loss of organic matter and iron oxides, on top of a dark accumulation horizon with brown, reddish or black illuviated humus and/or reddish Fe compounds. Podzols occur in humid areas in the boreal and temperate zones and locally also in the tropics."^^xsd:string ;
    ns1:IAO_0000412 ns1:envo.owl ;
    rdfs:subClassOf ns1:ENVO_00001998 .

ns1:GO_0002367 a owl:Class ;
    rdfs:label "cytokine production involved in immune response"^^xsd:string ;
    ns1:IAO_0000111 "cytokine production involved in immune response"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of a cytokine due to biosynthesis or secretion following a cellular stimulus contributing to an immune response, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0002390 a owl:Class ;
    rdfs:label "platelet activating factor production"^^xsd:string ;
    ns1:IAO_0000111 "platelet activating factor production"^^xsd:string ;
    ns1:IAO_0000115 "The synthesis or release of platelet activating factor following a stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0002534 a owl:Class ;
    rdfs:label "cytokine production involved in inflammatory response"^^xsd:string ;
    ns1:IAO_0000111 "cytokine production involved in inflammatory response"^^xsd:string ;
    ns1:IAO_0000115 "The synthesis or release of a cytokine following a inflammatory stimulus as part of an inflammatory response, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0005739 a owl:Class ;
    rdfs:label "mitochondrion"^^xsd:string ;
    ns1:IAO_0000111 "mitochondrion"^^xsd:string ;
    ns1:IAO_0000115 "A semiautonomous, self replicating organelle that occurs in varying numbers, shapes, and sizes in the cytoplasm of virtually all eukaryotic cells. It is notably the site of tissue respiration."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0043227 .

ns1:GO_0006006 a owl:Class ;
    rdfs:label "glucose metabolic process"^^xsd:string ;
    ns1:IAO_0000111 "glucose metabolic process"^^xsd:string ;
    ns1:IAO_0000115 "The chemical reactions and pathways involving glucose, the aldohexose gluco-hexose. D-glucose is dextrorotatory and is sometimes known as dextrose; it is an important source of energy for living organisms and is found free as well as combined in homo- and hetero-oligosaccharides and polysaccharides."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0006338 a owl:Class ;
    rdfs:label "chromatin remodeling"^^xsd:string ;
    ns1:IAO_0000111 "chromatin remodeling"^^xsd:string ;
    ns1:IAO_0000115 "Dynamic structural changes to eukaryotic chromatin occurring throughout the cell division cycle. These changes range from the local changes necessary for transcriptional regulation to global changes necessary for chromosome segregation."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0009987 .

ns1:GO_0009566 a owl:Class ;
    rdfs:label "fertilization"^^xsd:string ;
    ns1:IAO_0000111 "fertilization"^^xsd:string ;
    ns1:IAO_0000115 "The union of gametes of opposite sexes during the process of sexual reproduction to form a zygote. It involves the fusion of the gametic nuclei (karyogamy) and cytoplasm (plasmogamy)."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0032601 a owl:Class ;
    rdfs:label "connective tissue growth factor production"^^xsd:string ;
    ns1:IAO_0000111 "connective tissue growth factor production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of connective tissue growth factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

ns1:GO_0032605 a owl:Class ;
    rdfs:label "hepatocyte growth factor production"^^xsd:string ;
    ns1:IAO_0000111 "hepatocyte growth factor production"^^xsd:string ;
    ns1:IAO_0000115 "The appearance of hepatocyte growth factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001816 .

