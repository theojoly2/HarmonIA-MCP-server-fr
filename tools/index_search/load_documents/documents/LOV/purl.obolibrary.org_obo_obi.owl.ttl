ns1:OBI_0002306 a owl:Class ;
    rdfs:label "pathologic distant metastases stage for kidney according to AJCC 7th edition" ;
    ns1:IAO_0000111 "pathologic distant metastases stage for kidney according to AJCC 7th edition" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A categorical value specification that is a pathologic finding about one or more characteristics of renal cancer following the rules of the TNM AJCC v7 classification system as they pertain to distant metastases. TNM pathologic distant metastasis findings are based on clinical findings supplemented by histopathologic examination of one or more tissue specimens acquired during surgery."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "M: kidney distant Metastases (AJCC 7th Edition)"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001930 .

ns1:OBI_0002310 a owl:Class ;
    rdfs:label "pathologic distant metastases stage for ovary according to AJCC 7th edition" ;
    ns1:IAO_0000111 "pathologic distant metastases stage for ovary according to AJCC 7th edition" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A categorical value specification that is a  pathologic finding about one or more characteristics of ovarian cancer following the rules of the TNM AJCC v7 classification system as they pertain to distant metastases. TNM pathologic distant metastasis findings are based on clinical findings supplemented by histopathologic examination of one or more tissue specimens acquired during surgery."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "M: ovarian distant metastases (AJCC 7th Edition)"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001930 .

ns1:OBI_0002385 a owl:Class ;
    rdfs:label "diagnosis of infectious disease" ;
    ns1:IAO_0000111 "diagnosis of infectious disease" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A diagnosis that is an assertion that a patient who is the subject of a diagnostic process has an infectious disease."^^xsd:string ;
