    ns1:IAO_0000117 "PERSON:Bjoern Peters"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:CHEBI_33696 ],
        ns1:BFO_0000023 .

ns1:OBI_0000891 a owl:Class ;
    rdfs:label "cell proliferation assay" ;
    ns1:IAO_0000111 "cell proliferation assay" ;
    ns1:IAO_0000112 "Measuring the amount of tritiated thymidine incorporated by dividing cells as a proxy for cell proliferation."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cytometry assay which measures the degreee to which input cells are replicating."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
