ns1:OBI_0100066 a owl:Class ;
    rdfs:label "organ section"@en ;
    ns1:IAO_0000111 "organ section"@en ;
    ns1:IAO_0000112 "A liver slice used in a perfusion experiment.\\nThyroidectomy during laryngectomy for advanced laryngeal carcinoma--whole organ section study with long-term functional evaluation. Clin Otolaryngol Allied Sci. 1995 Apr;20(2):145-9. PMID: 7634521"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A processed material which derives from an organ and results from a process of dissection or histological sample preparation a portion(formerly an organ section is portion of an organ removed from the context of the organ)"@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string,
        "PERSON: Helen Parkinson"@en ;
    ns1:IAO_0000119 "GROUP: OBI Biomaterial Branch"^^xsd:string,
        "GROUP: CEBS"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:OBI_0000341 ns1:OBI_0600005 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:UBERON_0000465 ],
        ns1:OBI_0000047 .

ns1:OBI_0200024 a owl:Class ;
    rdfs:label "loess group transformation"@en ;
    ns1:IAO_0000111 "loess group transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A loess group transformation is a loess transformation where the input is partitioned into groups and for each group a loess fitting is performed, utilizing a subset of (or possibly all of) the data points in that group. Thus, a collection of loess curves y=f_i(x) is generated, one per group. Each (x, y) in the input is transformed into (x, y-f_i(x)), where f_i(x) is the curve corresponding to the group to which that data point belongs."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string,
        "Elisabetta Manduchi"@en,
        "James Malone"@en,
        "Melanie Courtot"@en ;
    ns1:IAO_0000119 "OTHER: Editor's generalization based on MGED Ontology term"@en ;
    rdfs:subClassOf ns1:OBI_0200071 .

ns1:OBI_0200042 a owl:Class ;
    rdfs:label "hierarchical clustering"@en ;
    ns1:IAO_0000111 "hierarchical clustering"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A hierarchical clustering is a data transformation which achieves a class discovery objective, which takes as input data item and builds a hierarchy of clusters. The traditional representation of this hierarchy is a tree (visualized by a dendrogram), with the individual input objects at one end (leaves) and a single cluster containing every object at the other (root)."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Data_clustering#Hierarchical_clustering"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000648 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200178 ] ) ],
        ns1:OBI_0200175 .

ns1:OBI_0200083 a owl:Class ;
    rdfs:label "survival analysis objective"@en ;
    ns1:IAO_0000111 "survival analysis objective"@en ;
    ns1:IAO_0000112 "Kaplan meier data transformation"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A data transformation objective which has the data transformation aims to model time to event data (where events are e.g. death and or disease recurrence); the purpose of survival analysis is to model the underlying distribution of event times and to assess the dependence of the event time on other explanatory variables"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: James Malone"^^xsd:string,
        "PERSON: Tina Boussard"^^xsd:string ;
    ns1:IAO_0000118 "survival analysis"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Survival_analysis"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200102 a owl:Class ;
    rdfs:label "regression analysis method"@en ;
    ns1:IAO_0000111 "regression analysis method"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Regression analysis is a descriptive statistics technique that examines the relation of a dependent variable (response variable) to specified independent variables (explanatory variables). Regression analysis can be used as a descriptive method of data analysis (such as curve fitting) without relying on any assumptions about underlying processes generating the data."@en ;
    ns1:IAO_0000117 "Tina Hernandez-Boussard"@en ;
    ns1:IAO_0000119 "BOOK: Richard A. Berk, Regression Analysis: A Constructive Critique, Sage Publications (2004) 978-0761929048"@en ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200154 a owl:Class ;
    rdfs:label "agglomerative hierarchical clustering"@en ;
    ns1:IAO_0000111 "agglomerative hierarchical clustering"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "An agglomerative hierarchical clustering is a hierarchical clustering which starts with separate clusters and then successively combines these clusters until there is only one cluster remaining."@en ;
    ns1:IAO_0000117 "Elisabetta Manduchi"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000118 "bottom-up hierarchical clustering"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Elisabetta Manduchi"@en ;
    rdfs:subClassOf ns1:OBI_0200042 .

ns1:OBI_0200170 a owl:Class ;
    rdfs:label "averaging data transformation"@en ;
    ns1:IAO_0000111 "averaging data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An averaging data transformation is a data transformation that has objective averaging."@en ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000679 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0000425 ] ) ] .

ns1:OBI_0302729 a owl:Class ;
    rdfs:label "chemical solution"@en ;
    ns1:IAO_0000111 "chemical solution"@en ;
    ns1:IAO_0000112 "PMID: 18289311.Anesth Analg. 2008 Apr;106(4):1078-86.Less impairment of hemostasis and reduced blood loss in pigs after resuscitation from hemorrhagic shock using the small-volume concept with hypertonic saline/hydroxyethyl starch as compared to administration of 4% gelatin or 6% hydroxyethyl starch solution."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A material entity  that is made up of at least 2 scattered molecular aggregates, one playing the role of solvent and the other one playing the role of solute."@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"^^xsd:string,
        "PERSON: Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "liquid chemical solution"@en ;
    ns1:IAO_0000119 "GROUP: OBI Biomaterial Branch"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000576 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0302732 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000576 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0302733 ] ) ] ] ) ] .

ns1:OBI_0302732 a owl:Class ;
    rdfs:label "solvent role"@en ;
    ns1:IAO_0000111 "solvent role"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18373502.Transfusion. 2008 Mar 25. Solvent/detergent treatment of platelet concentrates enhances the release of growth factors."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "solvent role is a role which inheres in a molecular entity capable of ensuring the dissolution of another chemical entity and realized by the process of solvation"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "adpated from wikipedia (http://en.wikipedia.org/wiki/Solvatation)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:CHEBI_23367 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000685 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000023 .

ns1:OBI_0302892 a owl:Class ;
    rdfs:label "enzymatic ligation"@en ;
    ns1:IAO_0000111 "enzymatic ligation"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 17853876. Enzymatic ligation assisted by nucleases: simultaneous ligation and digestion promote the ordered assembly of DNA. Nat Protoc. 2007;2(9):2198-202."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An enzymatic ligation is a planned process in which molecules  are joined by covalent bonds through the action of an material entity with a ligase activity"@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "OBI-Branch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000052 ;
                                owl:someValuesFrom ns1:OBI_0000427 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0400043 a owl:Class ;
    rdfs:label "flow cell"@en ;
    ns1:IAO_0000111 "flow cell"^^xsd:string ;
    ns1:IAO_0000112 "Biofilm Flow Cell"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Aparatus in the fluidic subsystem where the sheath and sample meet. Can be one of several types; jet-in-air, quartz cuvette, or a hybrid of the two. The sample flows through the center of a fluid column of sheath fluid in the flow cell."@en ;
    ns1:IAO_0000117 "Person:John Quinn"@en ;
    ns1:IAO_0000118 "flow_cell"^^xsd:string ;
    ns1:IAO_0000119 "http://www.flocyte.com/FRTP/Resources/flow_cytometry_glossary.htm"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000370 ],
        ns1:OBI_0000967 .

