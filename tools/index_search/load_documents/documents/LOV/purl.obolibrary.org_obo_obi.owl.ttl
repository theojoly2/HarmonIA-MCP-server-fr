ns1:OBI_0002440 a owl:Class ;
    rdfs:label "Hi-C assay" ;
    ns1:IAO_0000111 "Hi-C assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A chromosome conformation capture assay that detects genome-wide chromosomal interactions. High-throughput techniques are used to sequence the ligated fragments after cross-linking and cutting with restriction enzymes."^^xsd:string ;
    ns1:IAO_0000117 "Chris S"^^xsd:string ;
    ns1:IAO_0000119 "PMID:20461051"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002439 .

ns1:OBI_0002442 a owl:Class ;
    rdfs:label "hydroxyl-radical footprinting assay" ;
    ns1:IAO_0000111 "hydroxyl-radical footprinting assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A footprinting assay that uses the reaction of hydroxyl radicals with side-chain sites in molecules (proteins, DNA, etc)_ with the resultant mass shift demonstrating the site of modification, used to_ to asses the accessibility of that site."^^xsd:string ;
