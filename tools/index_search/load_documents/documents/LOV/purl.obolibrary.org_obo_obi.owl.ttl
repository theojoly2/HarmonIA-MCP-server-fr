    rdfs:label "supplementary material to a document"@en ;
    ns1:IAO_0000111 "supplementary material to a document"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "part of a document that is segregated from the rest of the document due to its size"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    ns1:IAO_0000118 "additional information"@en,
        "appendix"@en,
        "supplemental information"@en,
        "supplementary material"@en,
        "supporting information"@en ;
    rdfs:subClassOf ns1:IAO_0000314 .

ns1:IAO_0000327 a owl:Class ;
    rdfs:label "table of contents"@en ;
    ns1:IAO_0000111 "table of contents"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A table that relates document parts to specific locations in a document (usually page numbers).  This is also a document part (subsumption there should be inferred)."@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf ns1:IAO_0000306 .

ns1:IAO_0000328 a owl:Class ;
    rdfs:label "table of figures"@en ;
    ns1:IAO_0000111 "table of figures"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A table that relates figures in a document to specific locations in that document (usually page numbers).  This is also a document part (subsumption there should be inferred)."@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf ns1:IAO_0000306 .

ns1:IAO_0000329 a owl:Class ;
    rdfs:label "running title"@en ;
    ns1:IAO_0000111 "running title"@en ;
