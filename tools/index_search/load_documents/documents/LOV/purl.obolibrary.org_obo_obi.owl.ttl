    rdfs:label "whole mount tissue"@en ;
    ns1:IAO_0000111 "whole mount tissue"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A whole organism preparation resulting from a histological preparation known as whole mount preparation where the whole specimen is mounted or spread on the microscope (glass) slide"@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string,
        "PERSON: Helen Parkinson"@en ;
