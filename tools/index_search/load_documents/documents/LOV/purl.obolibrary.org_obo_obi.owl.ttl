ns1:OBI_0001685 a owl:Class ;
    rdfs:label "amplification of intermethylated sites assay" ;
    ns1:IAO_0000111 "amplification of intermethylated sites assay" ;
    ns1:IAO_0000112 "Analysis of DNA methylation by amplification of intermethylated sites (AIMS). PMID:18987810"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An assay that estimates genome-wide DNA methylation and measures methylation of DNA sequences. AIMS is based on the differential enzymatic digestion of genomic DNA with methylation-sensitive and methylation-insensitive isoschizomers followed by restrained PCR amplification of methylated sequences."^^xsd:string ;
    ns1:IAO_0000117 "Marcus Chibucos"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "AIMS assay"^^xsd:string,
        "intermethylated site amplification"^^xsd:string ;
    ns1:IAO_0000119 "PMID:18987810"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
