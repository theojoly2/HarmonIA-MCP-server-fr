ns1:OBI_0000997 a owl:Class ;
    rdfs:label "growth environment"^^xsd:string ;
    ns1:IAO_0000111 "growth environment"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The collection of material entities and their qualities that are located near a live organism, tissue or cell and can influence its growth."^^xsd:string ;
    ns1:IAO_0000116 "Right now this may be incomplete. Should also cover e.g. sound, light as well."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Richard Scheuermann, Jie Zheng, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "OBI group"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000040 .

