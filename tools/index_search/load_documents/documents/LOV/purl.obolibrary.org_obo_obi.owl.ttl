    ns1:IAO_0000111 "cytoplasmic RNA extraction"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A RNA extraction process in which the desired output material is RNA in the cytoplasm."^^xsd:string ;
    ns1:IAO_0000117 "Person: Chris Stoeckert"^^xsd:string,
        "Person: Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "UPenn Group"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0666666 .

ns1:OBI_0000867 a owl:Class ;
    rdfs:label "establishing cancer cell line"^^xsd:string ;
    ns1:IAO_0000111 "establishing cancer cell line"^^xsd:string ;
    ns1:IAO_0000112 "Establishment of HeLa immortal cell line"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a planned process in which the objective is to generate a cell line from a natural population of cancer cells which are already immortal"^^xsd:string ;
    ns1:IAO_0000119 ""^^xsd:string ;
    rdfs:comment "Helen Parkinson"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001906 ],
        ns1:OBI_0001867 .

ns1:OBI_0000872 a owl:Class ;
    rdfs:label "serum neutralization of viral infectivity assay" ;
    ns1:IAO_0000111 "serum neutralization of viral infectivity assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An analyte assay that measures virus-neutralizing abilities of different sera. Different dilutions of serum are mixed with virus and used to infect cells. At the lower dilutions, antibodies will block infection, but at higher dilutions, there will be too few antibodies to have an effect.The neutralization titer is expressed as the reciprocal of the highest dilution at which virus infection is blocked."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    ns1:IAO_0000118 "influenza neutralization assay"^^xsd:string ;
    ns1:IAO_0000119 "url:http://www.virology.ws/2009/05/28/influenza-microneutralization-assay/"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0097282 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:OBI_0100017 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0100017 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000086 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:NCBITaxon_10239 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:NCBITaxon_10239 ] ) ],
        ns1:OBI_0000443 .

ns1:OBI_0000873 a owl:Class ;
    rdfs:label "pre-mortem specimen"^^xsd:string ;
    ns1:IAO_0000111 "pre-mortem specimen"^^xsd:string ;
    ns1:IAO_0000112 "material obtained through a liver biopsy from a human patient"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
