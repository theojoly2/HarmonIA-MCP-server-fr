    ns1:IAO_0000115 "A biological sex quality inhering in an individual or a population that only produces gametes that can be fertilised by male gametes."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001894 .

ns1:PATO_0000384 a owl:Class ;
    rdfs:label "male"^^xsd:string ;
    ns1:IAO_0000111 "male"^^xsd:string ;
    ns1:IAO_0000115 "A biological sex quality inhering in an individual or a population whose sex organs contain only male gametes."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001894 .

ns1:PATO_0001025 a owl:Class ;
    rdfs:label "pressure"^^xsd:string ;
    ns1:IAO_0000111 "pressure"^^xsd:string ;
    ns1:IAO_0000115 "A physical quality that inheres in a bearer by virtue of the bearer's amount of force per unit area it exerts."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001018 .

ns1:PATO_0001161 a owl:Class ;
    rdfs:label "diluted"^^xsd:string ;
    ns1:IAO_0000111 "diluted"^^xsd:string ;
    ns1:IAO_0000115 "A concentration which relatively low."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000033 .

ns1:PATO_0001167 a owl:Class ;
    rdfs:label "damaged"^^xsd:string ;
    ns1:IAO_0000111 "damaged"^^xsd:string ;
    ns1:IAO_0000115 "A structural quality inhering in a bearer by virtue of the bearer being harmed or injured or spoiled, such that its functionality is impaired."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001020 .

ns1:PATO_0001193 a owl:Class ;
    rdfs:label "lateral to"^^xsd:string ;
    ns1:IAO_0000111 "lateral to"^^xsd:string ;
    ns1:IAO_0000115 "A spatial quality inhering in a bearer by virtue of the bearer's being located toward the side relative to another entity."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000140 .

ns1:PATO_0001196 a owl:Class ;
    rdfs:label "ventral to"^^xsd:string ;
    ns1:IAO_0000111 "ventral to"^^xsd:string ;
    ns1:IAO_0000115 "A spatial quality inhering in a bearer by virtue of the bearer's being located toward the abdomen of an organism relative to another entity."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000140 .

ns1:PATO_0001233 a owl:Class ;
    rdfs:label "dorsal to"^^xsd:string ;
    ns1:IAO_0000111 "dorsal to"^^xsd:string ;
    ns1:IAO_0000115 "A spatial quality inhering in a bearer by virtue of the bearer's being located toward the back or upper surface of an organism relative to another entity."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000140 .

ns1:PATO_0001338 a owl:Class ;
    rdfs:label "mixed sex"^^xsd:string ;
    ns1:IAO_0000111 "mixed sex"^^xsd:string ;
    ns1:IAO_0000115 "A biological sex quality inhering in a population of multiple sexes."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0002003 .

ns1:PATO_0001339 a owl:Class ;
    rdfs:label "biomaterial purity"^^xsd:string ;
    ns1:IAO_0000111 "biomaterial purity"^^xsd:string ;
    ns1:IAO_0000115 "A composition quality inhering in an bearer by virtue of the bearer's homogeneity of a biomaterial."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000025 .

ns1:PATO_0001340 a owl:Class ;
    rdfs:label "hermaphrodite"^^xsd:string ;
    ns1:IAO_0000111 "hermaphrodite"^^xsd:string ;
    ns1:IAO_0000115 "A biological sex quality inhering in an organism or a population with both male and female sexual organs in one individual."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001894 .

ns1:PATO_0001341 a owl:Class ;
    rdfs:label "a mating type (yeast)"^^xsd:string ;
    ns1:IAO_0000111 "a mating type (yeast)"^^xsd:string ;
    ns1:IAO_0000115 "A S. cerevisiae mating type cells that secrete a pheromone that in alpha haploids stimulates processes that lead to mating."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001342 .

ns1:PATO_0001344 a owl:Class ;
    rdfs:label "alpha mating type (yeast)"^^xsd:string ;
    ns1:IAO_0000111 "alpha mating type (yeast)"^^xsd:string ;
    ns1:IAO_0000115 "A S. cerevisiae mating type cells that secrete a pheromone that stimulates a haploids."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001342 .

ns1:PATO_0001345 a owl:Class ;
    rdfs:label "h minus"^^xsd:string ;
    ns1:IAO_0000111 "h minus"^^xsd:string ;
    ns1:IAO_0000115 "A S. pombe mating type determined by the mat1-Mc and mat1-Mi on the mat1 locus."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001343 .

ns1:PATO_0001346 a owl:Class ;
    rdfs:label "h plus"^^xsd:string ;
    ns1:IAO_0000111 "h plus"^^xsd:string ;
    ns1:IAO_0000115 "A S. pombe mating type determined by the mat1-Pc and mat1-Pi on the mat1 locus."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001343 .

ns1:PATO_0001347 a owl:Class ;
    rdfs:label "F mating type"^^xsd:string ;
    ns1:IAO_0000111 "F mating type"^^xsd:string ;
    ns1:IAO_0000115 "A bacterial mating type indicating the presence of F plasmid in a bacterial cell."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001335 .

ns1:PATO_0001348 a owl:Class ;
    rdfs:label "F minus mating type"^^xsd:string ;
    ns1:IAO_0000111 "F minus mating type"^^xsd:string ;
    ns1:IAO_0000115 "A bacterial mating type indicating the absence of F plasmid in a bacterial cell."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001335 .

ns1:PATO_0001375 a owl:Class ;
    rdfs:label "haploid"^^xsd:string ;
    ns1:IAO_0000111 "haploid"^^xsd:string ;
    ns1:IAO_0000115 "A ploidy quality inhering in a bearer by virtue of the bearer's containing a single set of homologous chromosomes."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001393 .

ns1:PATO_0001377 a owl:Class ;
    rdfs:label "polyploid"^^xsd:string ;
    ns1:IAO_0000111 "polyploid"^^xsd:string ;
    ns1:IAO_0000115 "A ploidy quality inhering in a bearer by virtue of the bearer's containing more than two homologous sets of chromosomes."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001393 .

ns1:PATO_0001385 a owl:Class ;
    rdfs:label "aneuploid"^^xsd:string ;
    ns1:IAO_0000111 "aneuploid"^^xsd:string ;
    ns1:IAO_0000115 "A ploidy quality inhering in a bearer by virtue of the bearer's containing a non-integral multiple of the monoploid number, due to extra or missing chromosomes."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001374 .

ns1:PATO_0001394 a owl:Class ;
    rdfs:label "diploid"^^xsd:string ;
    ns1:IAO_0000111 "diploid"^^xsd:string ;
    ns1:IAO_0000115 "A ploidy quality inhering in a bearer by virtue of the bearer's having two copies (homologs) of each chromosome, usually one from the mother and one from the father."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001393 .

ns1:PATO_0001546 a owl:Class ;
    rdfs:label "quality of a solid"^^xsd:string ;
    ns1:IAO_0000111 "quality of a solid"^^xsd:string ;
    ns1:IAO_0000115 "A physical quality inhering in a bearer by virtue of the bearer's exhibiting the physical characteristics of an entity characterized by particles arranged such that their shape and volume are relatively stable."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0002198 .

ns1:PATO_0001547 a owl:Class ;
    rdfs:label "quality of a gas"^^xsd:string ;
    ns1:IAO_0000111 "quality of a gas"^^xsd:string ;
    ns1:IAO_0000115 "A physical quality inhering in a bearer by virtue of the bearer's exhibiting the physical characteristics of an entity consisting of particles that have neither a defined volume nor defined shape."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0002198 .

ns1:PATO_0001548 a owl:Class ;
    rdfs:label "quality of a liquid"^^xsd:string ;
    ns1:IAO_0000111 "quality of a liquid"^^xsd:string ;
    ns1:IAO_0000115 "A physical quality inhering in an entity exhibiting the physical characteristics of an amorphous (non-crystalline) form of matter between a gas and a solid that has a definite volume, but no definite shape."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0002198 .

ns1:PATO_0001632 a owl:Class ;
    rdfs:label "anterior to"^^xsd:string ;
    ns1:IAO_0000111 "anterior to"^^xsd:string ;
    ns1:IAO_0000115 "A spatial quality inhering in a bearer by virtue of the bearer's being located toward the front of an organism relative to another entity."^^xsd:string ;
    ns1:IAO_0000118 "frontal"@en ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000140 .

ns1:PATO_0001792 a owl:Class ;
    rdfs:label "left side of"^^xsd:string ;
    ns1:IAO_0000111 "left side of"^^xsd:string ;
    ns1:IAO_0000115 "A spatial quality inhering in a bearer by virtue of the bearer's being located on left side of from the a another entity."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000140 .

ns1:PATO_0001793 a owl:Class ;
    rdfs:label "right side of"^^xsd:string ;
    ns1:IAO_0000111 "right side of"^^xsd:string ;
    ns1:IAO_0000115 "A spatial quality inhering in a bearer by virtue of the bearer's being located on right side of a another entity."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0000140 .

ns1:PATO_0002243 a owl:Class ;
    rdfs:label "fluid flow rate"^^xsd:string ;
    ns1:IAO_0000111 "fluid flow rate"^^xsd:string ;
    ns1:IAO_0000115 "A physical quality inhering in a fluid (liquid or gas) by virtue of the amount of fluid which passes through a given surface per unit time."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001574 .

ns1:PR_000007928 a owl:Class ;
    rdfs:label "glial cell line-derived neurotrophic factor"^^xsd:string ;
    ns1:IAO_0000111 "glial cell line-derived neurotrophic factor"^^xsd:string ;
    ns1:IAO_0000115 "A protein that is a translation product of the human GDNF gene or a 1:1 ortholog thereof."^^xsd:string ;
    ns1:IAO_0000412 ns1:pr.owl ;
    rdfs:subClassOf ns1:PR_000000001 .

ns1:PR_000025402 a owl:Class ;
    rdfs:label "T cell receptor co-receptor CD8"^^xsd:string ;
    ns1:IAO_0000111 "T cell receptor co-receptor CD8"^^xsd:string ;
    ns1:IAO_0000115 "A protein complex that is a membrane-bound heterodimeric co-receptor for MHC class-I antigen/T-cell receptor interaction."^^xsd:string ;
    ns1:IAO_0000412 ns1:pr.owl ;
    rdfs:subClassOf ns1:PR_000000001 .

ns1:RO_0001900 a owl:AnnotationProperty ;
    rdfs:label "temporal interpretation"@en ;
    foaf:page "https://github.com/oborel/obo-relations/wiki/ROAndTime"^^xsd:anyURI .

ns1:RO_0001902 a owl:NamedIndividual ;
    rdfs:label "relation has no temporal argument"@en ;
    ns1:IAO_0000115 "\\n\\n## Elucidation\\n\\nThis is used when the first-order logic form of the relation is\\nbinary, and takes no temporal argument.\\n\\n## Example:\\n\\n    Class: limb\\n    SubClassOf: develops_from some lateral-plate-mesoderm\\n\\n     forall t, t2:\\n      forall x :\\n        instance_of(x,Limb,t)\\n         implies\\n        exists y :\\n          instance_of(y,LPM,t2)\\n          develops_from(x,y)\\n\\n\\n" .

ns1:UBERON_0000483 a owl:Class ;
    rdfs:label "epithelium"^^xsd:string ;
    ns1:IAO_0000111 "epithelium"^^xsd:string ;
    ns1:IAO_0000115 "Portion of tissue, that consists of one or more layers of epithelial cells connected to each other by cell junctions and which is underlain by a basal lamina. Examples: simple squamous epithelium, glandular cuboidal epithelium, transitional epithelium, myoepithelium[CARO]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000479 .

ns1:UBERON_0001873 a owl:Class ;
    rdfs:label "caudate nucleus"^^xsd:string ;
    ns1:IAO_0000111 "caudate nucleus"^^xsd:string ;
    ns1:IAO_0000115 "Subcortical nucleus of telecephalic origin consisting of an elongated gray mass lying lateral to and bordering the lateral ventricle. It is divided into a head, body and tail in some species."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000477 .

ns1:UBERON_0001874 a owl:Class ;
    rdfs:label "putamen"^^xsd:string ;
    ns1:IAO_0000111 "putamen"^^xsd:string ;
    ns1:IAO_0000115 "Subcortical nucleus of telencephalic , which together with the caudate nucleus, forms the striatum. The putamen lies lateral to the internal capsule and medial to the external medullary lamina, and is separated from the caudate nucleus by the fibers of the internal capsule for most of its length, except at its anterior portion."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000477 .

ns1:UBERON_0002812 a owl:Class ;
    rdfs:label "left cerebral hemisphere"^^xsd:string ;
    ns1:IAO_0000111 "left cerebral hemisphere"^^xsd:string ;
    ns1:IAO_0000115 "A cerebral hemisphere that is in the left side of a brain."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0002813 a owl:Class ;
    rdfs:label "right cerebral hemisphere"^^xsd:string ;
    ns1:IAO_0000111 "right cerebral hemisphere"^^xsd:string ;
    ns1:IAO_0000115 "A cerebral hemisphere that is in the right side of a brain."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UBERON_0005023 a owl:Class ;
    rdfs:label "mucosa of oropharynx"^^xsd:string ;
    ns1:IAO_0000111 "mucosa of oropharynx"^^xsd:string ;
    ns1:IAO_0000115 "A mucosa that is part of a oropharynx [Automatically generated definition]."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:UBERON_0000465 .

ns1:UO_0000008 a ns1:UO_0000001,
        owl:NamedIndividual ;
    rdfs:label "meter"^^xsd:string ;
    ns1:IAO_0000111 "meter"^^xsd:string ;
    ns1:IAO_0000115 "A length unit which is equal to the length of the path traveled by light in vacuum during a time interval of 1/299 792 458 of a second."^^xsd:string ;
    ns1:IAO_0000118 "m"^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl .

