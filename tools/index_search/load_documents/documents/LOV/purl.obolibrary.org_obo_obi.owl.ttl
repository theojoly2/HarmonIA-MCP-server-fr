ns1:OBI_0002453 a owl:Class ;
    rdfs:label "health status inclusion criterion"@en ;
    ns1:IAO_0000111 "health status inclusion criterion"@en ;
    ns1:IAO_0000112 "‘diagnosed with Type 2 diabetes mellitus’, ‘E11.4’, ’not finding of hypertension'"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states one or more clinically significant bodily components, dispositions, and/or bodily processes of an entity that are inferred from relevant clinical findings or self-reported, which, if met, makes the entity suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    ns1:IAO_0000234 "MIABIS2.0"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002454 a owl:Class ;
    rdfs:label "clinically relevant lifestyle inclusion criterion"@en ;
    ns1:IAO_0000111 "clinically relevant lifestyle inclusion criterion"@en ;
    ns1:IAO_0000112 "'smoking behavior’"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states one or more clinically relevant planned processes that a human being actively participates in , which, if met, makes the human being suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    ns1:IAO_0000234 "MIABIS2.0"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002455 a owl:Class ;
    rdfs:label "clinically relevant exposure inclusion criterion"@en ;
    ns1:IAO_0000111 "clinically relevant exposure inclusion criterion"@en ;
    ns1:IAO_0000112 "'exposure to cigarette smoke’, ‘exposure to lead through drinking water'"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states one or more clinically relevant histories of exposure of an entity, which, if met, makes the entity suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    ns1:IAO_0000234 "MIABIS2.0"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002456 a owl:Class ;
    rdfs:label "gravidity inclusion criterion"@en ;
    ns1:IAO_0000111 "gravidity inclusion criterion"@en ;
    ns1:IAO_0000112 "'pregnant’, ‘not pregnant'"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states one or more gravidity statuses of an organism, which, if met, makes the entity suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    ns1:IAO_0000234 "MIABIS2.0"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002457 a owl:Class ;
    rdfs:label "precision nuclear run-on sequencing assay" ;
    ns1:IAO_0000111 "precision nuclear run-on sequencing assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An RNA-seq assay that maps the genome-wide distribution of transcriptionally-engaged Pol II at base-pair resolution by using biotin-labeled ribonucleotide triphosphate analogs (biotin-NTP) for nuclear run-on reactions, allowing the efficient affinity purification of nascent RNAs for high throughput sequencing from their 3' ends."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "PRO-Seq"^^xsd:string,
        "precision nuclear run-on and sequencing assay"^^xsd:string ;
    ns1:IAO_0000119 "PMID:23430654"^^xsd:string ;
    ns1:IAO_0000233 "https://github.com/obi-ontology/obi/issues/876"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000552 ],
        ns1:OBI_0001271 .

ns1:OBI_0002459 a owl:Class ;
    rdfs:label "genotype phasing by Hi-C assay" ;
    ns1:IAO_0000111 "genotype phasing by Hi-C assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A genotyping assay in which carbon-copy chromosome conformation is used to detect polymorphism in DNA samples."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "haplotype reconstruction by Hi-C assay"^^xsd:string ;
    ns1:IAO_0000119 "PMID:19815776"^^xsd:string,
        "url:https://www.nature.com/articles/nbt.2728"^^xsd:string ;
    ns1:IAO_0000233 "https://github.com/obi-ontology/obi/issues/828"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0002440 ],
        ns1:OBI_0000435 .

ns1:OBI_0002460 a owl:Class ;
    rdfs:label "defined population inclusion criterion"@en ;
    ns1:IAO_0000111 "defined population inclusion criterion" ;
    ns1:IAO_0000112 "inclusion based on age, sex, and living region (rural area or specified city)." ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An inclusion criterion that is based on fitting within the defined characteristics of a population based study design." ;
    ns1:IAO_0000117 "Chris Stoeckert, Mathias Brochhausen" ;
    ns1:IAO_0000119 "MIABIS 2.0" ;
    ns1:IAO_0000233 920 ;
    ns1:IAO_0000234 "MIABIS 2.0" ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002461 a owl:Class ;
    rdfs:label "BCL format"@en ;
    ns1:IAO_0000111 "BCL format"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data format specification that is a binary file containing base calling data. These files are created by sequencing machines during the act of sequencing, and contain data about each of the nucleotide clusters on a sequencing flow cell."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:IAO_0000098 .

ns1:OBI_0002462 a owl:Class ;
    rdfs:label "ERCC RNA spike-in" ;
    ns1:IAO_0000111 "ERCC RNA spike-in" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A processed material developed by the External RNA Controls Consortium (ERCC) that  consists of 92 transcripts, derived and traceable from NIST-certified DNA plasmids."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    ns1:IAO_0000119 "https://www.thermofisher.com/order/catalog/product/4456740"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000047 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:OBI_0001140 ] ) ],
        ns1:OBI_0000047 .

ns1:OBI_0002463 a owl:Class ;
    rdfs:label "SIRV RNA spike-in"@en ;
    ns1:IAO_0000111 "SIRV RNA spike-in"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A processed material that consists of transcript isoforms of 7 spike-in RNA variant (SIRV) genes and possibly the 92 External RNA Controls Consortium (ERCC) RNA spike-in genes."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    ns1:IAO_0000119 "https://www.lexogen.com/sirvs/design/"@en ;
