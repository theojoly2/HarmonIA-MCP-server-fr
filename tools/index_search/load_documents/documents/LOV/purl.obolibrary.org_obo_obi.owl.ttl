ns1:OBI_0001979 a owl:Class ;
    rdfs:label "fluorescence quenching binding assay" ;
    ns1:IAO_0000111 "fluorescence quenching binding assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A binding assay in which the proximity of two entities is monitored by measuring a fluorescent signal of one of the entities that gets reduced if the two entities are cliose to each other."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0001501 ],
        ns1:OBI_0001146 .

ns1:OBI_0001989 a owl:Class ;
