    rdfs:label "has x coordinate value"@en ;
    rdfs:domain ns1:IAO_0000400 ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf owl:topDataProperty .

ns1:IAO_0000409 a owl:Class ;
    rdfs:label "denotator type"^^xsd:string ;
    ns1:IAO_0000112 "The Basic Formal Ontology ontology makes a distinction between Universals and defined classes, where the formal are \"natural kinds\" and the latter arbitrary collections of entities."^^xsd:string ;
    ns1:IAO_0000115 "A denotator type indicates how a term should be interpreted from an ontological perspective."^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "Barry Smith, Werner Ceusters"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000102 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:IAO_0000410 ns1:IAO_0000420 ns1:IAO_0000421 ) ] .

ns1:IAO_0000423 a ns1:IAO_0000078,
        owl:NamedIndividual ;
    rdfs:label "to be replaced with external ontology term"@en ;
    ns1:IAO_0000115 "Terms with this status should eventually replaced with a term from another ontology."@en ;
    ns1:IAO_0000117 "Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "group:OBI"@en .

ns1:IAO_0000572 a owl:Class ;
    rdfs:label "documenting"@en ;
    ns1:IAO_0000112 "Recording the current temperature in a laboratory notebook. Writing a journal article. Updating a patient record in a database."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a planned process in which a document is created or added to by including the specified input in it."@en ;
    ns1:IAO_0000116 "6/11/9: Edited at OBI workshop. We need to be able identify a child form of information artifact which corresponds to something enduring (not brain like). This used to be restricted to physical document or digital entity as the output, but that excludes e.g. an audio cassette tape"@en ;
    ns1:IAO_0000117 "Bjoern Peters"@en ;
    ns1:IAO_0000119 "wikipedia http://en.wikipedia.org/wiki/Documenting"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000310 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        ns1:OBI_0000011 .

