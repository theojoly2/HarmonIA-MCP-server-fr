ns1:IAO_0000320 a owl:Class ;
    rdfs:label "references section"@en ;
    ns1:IAO_0000111 "references section"@en ;
    ns1:IAO_0000112 "The list of citations found at the end of a scientific publication, grant proposal or patent application, sometimes called \"literature cited\" or \"bibliography\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A part of a document that has citations as parts"@en ;
