    ns1:IAO_0000111 "material sequencing library preparation role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A worker role played by the person who performs the library preparation process to generate a sequencing library for a sample to be sequenced."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:OBI_0000116 .

