                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom ns1:OBI_0400169 ] ) ] ) ] .

ns1:OBI_0002177 a owl:Class ;
    rdfs:label "patch clamp assay" ;
    ns1:IAO_0000111 "patch clamp assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An intracellular electrophysiology assay where a glass micropipette is sealed to the surface of the cell membrane as a recording electrode to study ion channel activity. The key distinction of this technique is the electrical resistance of the seal between the cell membrane and the pipette is of the order 10-100 gigaohms, permitting high-resolution current measurements over the cell membrane in several different standard configurations."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000119 "ECO:0006012"^^xsd:string,
        "url:http://www.annualreviews.org/doi/pdf/10.1146/annurev.ph.46.030184.002323"^^xsd:string,
        "url:https://en.wikipedia.org/wiki/Patch_clamp"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0001080 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0001080 ] ) ],
        ns1:OBI_0000447 .

