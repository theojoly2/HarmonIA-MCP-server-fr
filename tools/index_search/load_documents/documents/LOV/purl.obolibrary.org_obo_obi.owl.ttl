ns1:OBI_0002614 a owl:Class ;
    rdfs:label "birth cohort study design" ;
    ns1:IAO_0000111 "birth cohort study design" ;
    ns1:IAO_0000112 "The LucKi Birth Cohort Study was designed and started in 2006 to follow children from birth into adulthood on a wide range of determinants, disorders, and diseases."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cohort study design for which the subjects are followed from the time of birth usually including information about gestation and follow up."^^xsd:string ;
    ns1:IAO_0000117 "MIABIS"^^xsd:string ;
    ns1:IAO_0000119 "MIABIS contributors"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500000 .

ns1:OBI_0002615 a owl:Class ;
    rdfs:label "disease specific study design" ;
    ns1:IAO_0000111 "disease specific study design" ;
    ns1:IAO_0000112 "A study of the symptoms experienced by patients who have been diagnosed with multiple sclerosis employs a disease specific study design."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design for which material and information is collected from subjects that have already developed a particular disease."^^xsd:string ;
    ns1:IAO_0000117 "MIABIS"^^xsd:string ;
    ns1:IAO_0000119 "MIABIS contributors"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0500000 .

ns1:OBI_0002616 a owl:Class ;
    rdfs:label "genealogical record"@en ;
    ns1:IAO_0000111 "genealogical record"@en ;
    ns1:IAO_0000112 "A family tree is a type of genealogical record."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A document about the family relationships of persons related as members of a domestic group linked through descent from a common ancestor, marriage, or adoption."^^xsd:string ;
    ns1:IAO_0000117 "MIABIS"^^xsd:string,
        "Sarah Bost"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000310 .

ns1:OBI_0002618 a owl:Class ;
    rdfs:label "national biomedical registry"@en ;
    ns1:IAO_0000111 "national biomedical registry"@en ;
    ns1:IAO_0000112 "The Care Register for Health Care, maintained by the Finnish National Institute for Health and Welfare, is a national biomedical registry."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A national registry that contains information about individuals that was accumulated for a biomedical purpose, such as diagnoses, treatments, or outcomes."^^xsd:string ;
    ns1:IAO_0000117 "MIABIS"^^xsd:string,
        "Sarah Bost"^^xsd:string ;
    ns1:IAO_0000119 "MIABIS contributors"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002617 .

ns1:OBI_0002815 a owl:DatatypeProperty ;
    rdfs:label "has representation"@en ;
    ns1:IAO_0000111 "has representation"@en ;
    ns1:IAO_0000112 "20g"^^xsd:string,
        "12th arrondissement of Paris"@en,
        "I feel sick to my stomach every Tuesday"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "'has representation' is a data property that attaches between an information content entity and a value that contains linguistically or computationally coded text."@en ;
    ns1:IAO_0000116 "Further processing may enable the value to be represented in a component data structure such as an OBI value specification."@en ;
    ns1:IAO_0000117 "Damion Dooley"^^xsd:string,
        "Mark Miller"^^xsd:string ;
    dc:date "2019-07-14T07:05:50+00:00"^^xsd:dateTime .

ns1:OBI_0005246 a owl:Class ;
    rdfs:label "injection function"^^xsd:string ;
    ns1:IAO_0000111 "injection function"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "The function of a device realized when administering a substance in vivo, applied particularly to the forcible insertion of a liquid or gas by means of a syringe, pump, etc."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"^^xsd:string,
        "PERSON: Melanie Courtot"^^xsd:string ;
    ns1:IAO_0000119 "adapted from WEB: http://www.dictionary.net/injection"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0100010 a owl:Class ;
    rdfs:label "Epstein Barr virus transformed B cell"@en ;
    ns1:IAO_0000111 "Epstein Barr virus transformed B cell"@en ;
    ns1:IAO_0000112 "PMID: 8777380. Expression of thyroid peroxidase in EBV-transformed B cell lines using adenovirus.Thyroid. 1996 Feb;6(1):23-8."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A material entity which results from viral transformation process using EBV as transformation agent when applied to B-cell entity"@en ;
    ns1:IAO_0000117 "PERSON: Susanna Sansone"^^xsd:string ;
    ns1:IAO_0000119 "GROUP: OBI Biomaterial Branch"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000047 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0600036 [ a owl:Restriction ;
                                            owl:onProperty ns1:OBI_0000293 ;
                                            owl:someValuesFrom ns1:NCBITaxon_10239 ] ) ] ] [ a owl:Restriction ;
                        owl:allValuesFrom ns1:CL_0000236 ;
                        owl:onProperty ns1:RO_0001000 ] ) ] .

ns1:OBI_0100014 a owl:Class ;
    rdfs:label "chimera"@en ;
    ns1:IAO_0000111 "chimera"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An organism which contains cells or tissues with a different genotype"@en ;
    ns1:IAO_0000117 "PERSON: Helen Parkinson"@en ;
    ns1:IAO_0000119 "GROUP: OBI"@en ;
    rdfs:subClassOf ns1:OBI_0100026 .

ns1:OBI_0100015 a owl:Class ;
    rdfs:label "obsolete_anatomical entity"@en ;
    ns1:IAO_0000111 "anatomical entity"^^xsd:string ;
    ns1:IAO_0000112 "Tissue, organ, system, sperm, blood or body location (arm)."@en ;
    ns1:IAO_0000114 ns1:IAO_0000121 ;
    ns1:IAO_0000115 "An anatomical entity is a material entity that is part of a multicellular organism, and which is large enough so that it forms an identifiable structure in the organism. Specifically, it excludes granular parts of the organism, such as atoms, molecules, cells, which can be removed from the organism without affecting it. It is defined as the union of 'multi-tissue structure', 'body substance' and 'portion of tissue'"@en ;
    ns1:IAO_0000116 "13-02-2009:\\nBiomaterial branch: change of label and definition following discussions at the OBI winter meeting 2009. It was felt that 'macroscopic part of multicellular organism' introduce an impractical delineation.\\n\\nIMPORTANT NOTE:  OBI 'anatomical entity' would essentially correspond to FMA 'material anatomical entity' rather than FMA 'physical anatomical entity'. OBI does not include 'immaterial anatomical entity' as it would clash with the parent class 'material entity'\\n\\nDOCUMENTATION NOTE: OBI anatomical entity granularity level excludes cell and biological  molecules."^^xsd:string,
        "Biom call - January 2009 - Issues: \\nparasites are not macroscopic part or organism. \\nfetus is_a macroscopic part (but this is up for discussion)"^^xsd:string,
        "equivalent classes\\n'portion of tissue' or 'multi-tissue structure' or 'portion of organism substance'\\n\\nSuperclasses\\nmaterial_entity\\npart_of some organism"^^xsd:string,
        "10/20/09: This class and all subclasses are currently problematic. They should all be imported from other OBO foundry ontologies. (FMA / CARO / UBERON). Currently two problems exist: There is no cross species anatomy that covers all the entities we need. Secondly: there is not good boundary between anatomical entities and smaller parts in FMA. Currently we will use anatomical entities as if they are valid across species."@en,
        "not super happy about liquids (blood, sperm), as they seem to be 'granular' somewhat, and not form a structure."@en ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string,
        "Tina Boussard"@en ;
    ns1:IAO_0000119 "MO"@en ;
    ns1:IAO_0000231 ns1:IAO_0000228 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0100035 a owl:Class ;
    rdfs:label "obsolete_immortal cell"@en ;
    ns1:IAO_0000111 "immortal cell"@en ;
    ns1:IAO_0000112 "a single Hela cell"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a cell derived from a multicellular organism that has the potential to replicate indefinitely"@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"@en ;
    ns1:IAO_0000119 "GROUP: OBI Biomaterial Branch"@en ;
    ns1:IAO_0000231 ns1:IAO_0000228 ;
    ns1:IAO_0100001 ns1:CL_0000002 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0100039 a owl:Class ;
    rdfs:label "obsolete_fragment derived from protein"@en ;
    ns1:IAO_0000111 "fragment derived from protein"@en ;
    ns1:IAO_0000112 "the peptide with sequence SIINFEKL, which is eluted from a cell expressing hen egg lysozyme"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A material entity which is derived from a  protein"@en ;
    ns1:IAO_0000116 "BP:03/21/2010:obsoleted as the class is no longer necessary, and we would otherwise need all kinds of 'fragment derived from' classes. Instead, use composite terms with the relationship 'derived from' some protein OR derived from some part_of protein."^^xsd:string,
        "PRS:22022008. result from protocol_application where input=protein and output=polypeptide or peptide (to capture: derives_from protein)"@en,
        "original term: protein fragment split into synthetic polypeptide and fragment derived from protein\\nTHE DEFINITION OF THIS SUGGESTS WE COVER THIS ALREADY IN PEPTIDE/POLYPETIDE. DO WE NEED THIS AND CAN WE DEAL WITH IT IN SOME OTHER WAY?  JAMES"@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"@en ;
    ns1:IAO_0000119 "GROUP: IEDB"@en ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0100046 a owl:Class ;
    rdfs:label "phosphate buffered saline solution"@en ;
    ns1:IAO_0000111 "phosphate buffered saline solution"@en ;
    ns1:IAO_0000112 "PMID: 16279733.Dent Mater J. 2005 Sep;24(3):414-21.PBS buffer solutions with different pH values can change porosity of DNA-chitosan complexes."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "Phosphate buffered saline (abbreviated PBS) is a buffer solution commonly used in biochemistry. It is a salty solution containing sodium chloride, sodium phosphate and in some preparations potassium chloride and potassium phosphate. The buffer helps to maintain a constant pH. The concentration usually matches the human body (isotonic)."@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string,
        "PERSON: Melanie Courtot"@en,
        "PERSON: Tina Boussard"@en ;
    ns1:IAO_0000118 "PBS buffer"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Phosphate_buffered_saline"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:OBI_0302731 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000576 [ a owl:Restriction ;
                                owl:allValuesFrom ns1:CHEBI_26710 ;
