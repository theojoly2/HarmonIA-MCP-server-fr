ns1:OBI_0001057 a owl:Class ;
    rdfs:label "high performance liquid chromatography instrument"^^xsd:string ;
    ns1:IAO_0000111 "high performance liquid chromatography instrument"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A liquid chromatography instrument that consists of a reservoir of mobile phase, a pump, an injector, a separation column, and a detector. The pump (rather than gravity) provides the higher pressure required to propel the mobile phase and analyte through the densely packed column."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Erik Segerdell"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/High_performance_liquid_chromatography"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001139 .

