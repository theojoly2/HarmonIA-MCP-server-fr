    ns1:IAO_0000111 "material sample"^^xsd:string ;
    ns1:IAO_0000112 "blood drawn from patient to measure his systemic glucose level. A population of humans with HIV enrolled in a study taken to represent patients with HIV in general."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A material entity that has the material sample role"^^xsd:string ;
