    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A device for dropping and immobilizing a solution of biomolecules, for example, nucleic acids such as probe DNA, mRNA, and peptide nucleic acid (PNA), and proteins on a DNA microarray surface to manufacture a DNA microarray."^^xsd:string ;
