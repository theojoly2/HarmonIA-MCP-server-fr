        owl:NamedIndividual ;
    rdfs:label "core"@en ;
    ns1:IAO_0000115 "Core is an instance of a grouping of terms from an ontology or ontologies. It is used by the ontology to identify main classes."@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Melanie Courtot"@en .

ns1:IAO_0000301 a owl:Class ;
    rdfs:label "citation"@en ;
    ns1:IAO_0000111 "citation"@en ;
    ns1:IAO_0000112 "Verspoor, K., Cohen, KB., Hunter, L. Textual characteristics of traditional and Open Access scientific journals are similar, BMC Bioinformatics 2009, 10:183."@en ;
