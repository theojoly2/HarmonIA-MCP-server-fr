        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0000406 a owl:Class ;
    rdfs:label "PCR product"@en ;
    ns1:IAO_0000111 "PCR product"@en ;
    ns1:IAO_0000112 "PCR products are the results of amplifcation process. Detection of a PCR products is used to detect DNA and RNA."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "is double stranded DNA that is the specified output of a polymerase chain reaction"@en ;
    ns1:IAO_0000116 "We are using PCR and not the written out words, as this is the most common used."@en ;
    ns1:IAO_0000117 "GROUP: OBI BIomaterial Branch"^^xsd:string ;
    ns1:IAO_0000119 "GROUP: OBI BIomaterial Branch"^^xsd:string ;
    rdfs:subClassOf ns1:CHEBI_4705,
