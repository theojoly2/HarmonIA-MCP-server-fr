    ns1:IAO_0000111 "kilogram"^^xsd:string ;
    ns1:IAO_0000115 "A mass unit which is equal to the mass of the International Prototype Kilogram kept by the BIPM at Svres, France."^^xsd:string ;
    ns1:IAO_0000118 "kg"^^xsd:string ;
