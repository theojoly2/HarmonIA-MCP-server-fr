        ns1:OBI_0600047 .

ns1:OBI_0001961 a owl:Class ;
    rdfs:label "PCR program"@en ;
    ns1:IAO_0000111 "PCR program"@en ;
    ns1:IAO_0000112 "https://www.neb.com/protocols/1/01/01/taq-dna-polymerase-with-standard-taq-buffer-m0273"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a PCR program is a plan specification which is executed during a polymerase chain reaction (PCR) by a thermocycler instrument that will iterate through the changes in temperature and duration of each of the annealing, denaturation, elongation steps for as many times as specified by the program."@en ;
    ns1:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000104 .

ns1:OBI_0001962 a owl:Class ;
    rdfs:label "target gene specification"@en ;
    ns1:IAO_0000111 "target gene specification"@en ;
    ns1:IAO_0000112 "http://www.ncbi.nlm.nih.gov/pubmed/25367129\\n\\n\"performing a profiling of microbial phylogenetic composition using sequencing of 16S rRNA gene (used as target gene)"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "is a directive information specifying a coding genomic region which is the focus of a planned process such as an assay, for instance in a environmental gene survey"@en ;
    ns1:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "PRS for OBI"@en ;
    ns1:OBI_0001847 "target gene"@en ;
    rdfs:subClassOf ns1:IAO_0000033 .

ns1:OBI_0001963 a owl:Class ;
    rdfs:label "target subfragment specification"@en ;
    ns1:IAO_0000111 "target subfragment specification"@en ;
    ns1:IAO_0000112 "http://www.ncbi.nlm.nih.gov/pubmed/23335919\\n\\n\"performing a profiling of microbial phylogenetic composition using massively-parallel pyrotag sequencing targeting the V9 hypervariable region (used as target subfragment) of the 18S ribosomal RNA (rRNA) gene (used as target gene)"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "is a directive information specifying a genomic region, possibly located in a coding genomic region, which is the focus of a planned process such as an assay, for instance in a environmental gene survey"@en ;
    ns1:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "PRS for OBI"@en ;
    ns1:OBI_0001847 "target subfragment"@en ;
    rdfs:subClassOf ns1:IAO_0000033 .

ns1:OBI_0001965 a owl:Class ;
    rdfs:label "decision analysis study design" ;
    ns1:IAO_0000111 "decision analysis study design" ;
