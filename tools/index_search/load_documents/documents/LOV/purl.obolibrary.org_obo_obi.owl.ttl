    ns1:IAO_0000111 "intra cellular electrophysiology recording assay" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An electrophysiology recording assay where the recording location of the electrode is intracellular"^^xsd:string ;
    ns1:IAO_0000117 "Frank Gibson"^^xsd:string ;
    ns1:IAO_0000119 "Frank Gibson"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
