        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000027 ],
        ns1:OBI_0002020 .

ns1:OBI_0000639 a owl:Class ;
    rdfs:label "material separation objective"^^xsd:string ;
