    ns1:IAO_0000111 "filter function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A filter function is a function to prevent the flow of certain entities based on a quality or qualities of the entity while allowing entities which have different qualities to pass through"@en ;
    ns1:IAO_0000117 "Frank Gibson"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000372 .

