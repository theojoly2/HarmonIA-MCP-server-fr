    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "protection from challenge"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001178 .

ns1:OBI_0001192 a owl:Class ;
    rdfs:label "epitope specific immune intervention"^^xsd:string ;
    ns1:IAO_0000111 "epitope specific immune intervention"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An administration in vivo to either actively or passively immunize an organism in order to induce a response against a specific immune epitope"^^xsd:string ;
