    ns1:IAO_0000111 "purified MHC competitive binding assay measuring equilibrium dissociation constant [KD] of a MHC:ligand complex using radioactivity detection" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A purified MHC ligand binding equilibrium dissociation constant (KD) determination assay that uses radioactivity detection to detect loss of binding of a known reference ligand due to competition by the ligand under investigation."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "dissociation constant KD"^^xsd:string,
