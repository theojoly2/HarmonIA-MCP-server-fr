ns1:OBI_0002401 a owl:Class ;
    rdfs:label "hormonal birth control use history" ;
    ns1:IAO_0000111 "hormonal birth control use history" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An information content entity that indicates whether a woman has ever used oral contraceptives in order to block ovulation and prevent the occurrence of pregnancy."^^xsd:string ;
