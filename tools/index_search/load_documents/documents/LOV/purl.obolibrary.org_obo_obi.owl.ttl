ns1:OBI_0000738 a owl:Class ;
    rdfs:label "restriction enzyme based cloning"^^xsd:string ;
    ns1:IAO_0000111 "restriction enzyme based cloning"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "restriction enzyme based cloning is a recombinant vector cloning process that has as an input genetic material that was cleaved with restriction enzymes, and a cloning vector that was cleaved with complementary restriction enzymes. It uses ligase to chemically join the input genetic material and the cloning vector to create a recombinant vector."^^xsd:string ;
    ns1:IAO_0000117 "Kevin Clancy, Bjoern Peters"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0302892 ],
