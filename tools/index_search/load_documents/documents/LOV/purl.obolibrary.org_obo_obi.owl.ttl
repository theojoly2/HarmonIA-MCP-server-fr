    ns1:IAO_0000116 "obsolete during the San Diego workshop, March 2011\\nThe reason is that we decided to pursue a different modeling approach for services keeping just the 'service consumer' and 'service provider' roles and differentiate just at the level of planned process offered a s service."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Helen Parkinson"^^xsd:string ;
