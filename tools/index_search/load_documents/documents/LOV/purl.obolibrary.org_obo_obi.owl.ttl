ns1:OBI_0001911 a owl:Class ;
    rdfs:label "cell line culture"@en ;
    ns1:IAO_0000111 "cell line culture"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cell culture comprised of cell line cells and the media in which they are being actively propagated or quiescently stored."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Matthew Brush"^^xsd:string ;
    ns1:IAO_0000119 "OBI-CLO Alignment Working Group (Spring 2013)"^^xsd:string ;
