ns1:UBERON_0000465 a owl:Class ;
    rdfs:label "material anatomical entity"^^xsd:string ;
    ns1:IAO_0000111 "material anatomical entity"^^xsd:string ;
    ns1:IAO_0000115 "Anatomical entity that has mass."^^xsd:string ;
    ns1:IAO_0000412 ns1:uberon.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:OBI_0000011 a owl:Class ;
    rdfs:label "planned process"@en ;
    ns1:IAO_0000111 "planned process"^^xsd:string,
        "planned process"@en ;
    ns1:IAO_0000112 "Injecting mice with a vaccine in order to test its efficacy"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A processual entity that realizes a plan which is the concretization of a plan specification."@en ;
    ns1:IAO_0000116 "'Plan' includes a future direction sense. That can be problematic if plans are changed during their execution. There are however implicit contingencies for protocols that an agent has in his mind that can be considered part of the plan, even if the agent didn't have them in mind before. Therefore, a planned process can diverge from what the agent would have said the plan was before executing it, by adjusting to problems encountered during execution (e.g. choosing another reagent with equivalent properties, if the originally planned one has run out.)"^^xsd:string,
        "We are only considering successfully completed planned processes. A plan may be modified, and details added during execution. For a given planned process, the associated realized plan specification is the one encompassing all changes made during execution. This means that all processes in which an agent acts towards achieving some \\nobjectives is a planned process."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "branch derived"^^xsd:string ;
    ns1:IAO_0000232 "6/11/9: Edited at workshop. Used to include: is initiated by an agent"^^xsd:string,
        "This class merges the previously separated objective driven process and planned process, as they the separation proved hard to maintain. (1/22/09, branch call)"@en ;
    ns1:IAO_0000412 onto: ;
    rdfs:subClassOf ns1:BFO_0000015 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0000059 ;
                    owl:someValuesFrom ns1:IAO_0000104 ] ] .

ns1:OBI_0600005 a owl:Class ;
    rdfs:label "collecting specimen from organism"@en ;
    ns1:IAO_0000111 "collecting specimen from organism"@en ;
    ns1:IAO_0000112 "taking a sputum sample from a cancer patient, taking the spleen from a killed mouse, collecting a urine sample from a patient"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a process with the objective to obtain a material entity that was part of an organism for potential future use in an investigation"@en ;
    ns1:IAO_0000117 "PERSON:Bjoern Peters"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100051 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000684 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        ns1:OBI_0000659 .

ns1:CL_0000000 a owl:Class ;
    rdfs:label "cell"^^xsd:string,
        "cell"@en ;
    ns1:IAO_0000111 "cell"^^xsd:string,
        "cell"@en ;
    ns1:IAO_0000112 "PMID:18089833.Cancer Res. 2007 Dec 15;67(24):12018-25. \"...Epithelial cells were harvested from histologically confirmed adenocarcinomas ..\""@en ;
    ns1:IAO_0000115 "A material entity of anatomical origin (part of or deriving from an organism) that has as its parts a maximally connected cell compartment surrounded by a plasma membrane."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:OBI_0001479 a owl:Class ;
    rdfs:label "specimen from organism"@en ;
    ns1:IAO_0000111 "specimen from organism"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A specimen that derives from an anatomical part or substance arising from an organism. Examples of tissue specimen include tissue, organ, physiological system, blood, or body location (arm)."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000118 "tissue specimen"@en ;
    ns1:IAO_0000119 "MO_954 organism_part"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0100051 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:OBI_0000112 ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0001000 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:UBERON_0000465 ns1:UBERON_0000477 ) ] ] ) ] .

ns1:OBI_0100026 a owl:Class ;
    rdfs:label "organism"@en ;
    ns1:IAO_0000111 "organism"@en ;
    ns1:IAO_0000112 "animal"@en,
        "fungus"@en,
        "plant"@en,
        "virus"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A material entity that is an individual living system, such as animal, plant, bacteria or virus, that is capable of replicating or reproducing, growth and maintenance in the right environment. An organism may be unicellular or made up, like humans, of many billions of cells divided into specialized tissues and organs."@en ;
    ns1:IAO_0000116 "10/21/09: This is a placeholder term, that should ideally be imported from the NCBI taxonomy, but the high level hierarchy there does not suit our needs (includes plasmids and 'other organisms')"^^xsd:string,
        "13-02-2009:\\nOBI doesn't take position as to  when an organism starts or ends being an organism - e.g. sperm, foetus.\\nThis issue is outside the scope of OBI."^^xsd:string ;
    ns1:IAO_0000117 "GROUP: OBI Biomaterial Branch"^^xsd:string ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Organism"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ns1:NCBITaxon_10239 ns1:NCBITaxon_2 ns1:NCBITaxon_2157 ns1:NCBITaxon_2759 ) ] .

ns1:OBI_0400103 a owl:Class ;
    rdfs:label "DNA sequencer"@en ;
    ns1:IAO_0000111 "DNA sequencer"@en ;
    ns1:IAO_0000112 "ABI 377 DNA Sequencer, ABI 310 DNA Sequencer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A DNA sequencer is an instrument that determines the order of deoxynucleotides in deoxyribonucleic acid sequences."@en ;
