ns1:OBI_0000370 a owl:Class ;
    rdfs:label "contain function"@en ;
    ns1:IAO_0000111 "contain function"@en ;
    ns1:IAO_0000112 "A syringe, a beaker"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A contain function is a function to constrain a material entities location in space"@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0400148 a owl:Class ;
    rdfs:label "DNA microarray"@en ;
    ns1:IAO_0000111 "DNA microarray"@en ;
    ns1:IAO_0000112 "Moran G, Stokes C, Thewes S, Hube B, Coleman DC, Sullivan D (2004). \"Comparative genomics using Candida albicans DNA microarrays reveals absence and divergence of virulence-associated genes in Candida dubliniensis\". Microbiology 150: 3363-3382. doi:10.1099/mic.0.27221-0. PMID 15470115"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A DNA-microarray is a microarray that is used as a physical 2D immobilisation matrix for DNA sequences. DNA microarray-bound DNA fragments are used as targets for a hybridising probed sample."@en ;
    ns1:IAO_0000117 "PERSON: Frank Gibson"^^xsd:string,
        "PERSON: Daniel Schober"@en ;
    ns1:IAO_0000118 "DNA Chip"@en,
        "DNA-array"@en ;
    ns1:IAO_0000119 "Web:<http://en.wikipedia.org/wiki/DNA_microarray>@2008/03/03"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0400147 .

ns1:IAO_0000600 a owl:AnnotationProperty ;
    rdfs:label "elucidation"@en ;
    ns1:IAO_0000111 "elucidation"@en ;
    ns1:IAO_0000117 "person:Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "Person:Barry Smith"@en ;
    ns1:IAO_0000600 "Primitive terms in a highest-level ontology such as BFO are terms which are so basic to our understanding of reality that there is no way of defining them in a non-circular fashion. For these, therefore, we can provide only elucidations, supplemented by examples and by axioms"@en ;
    rdfs:isDefinedBy ns1:iao.owl .

ns1:NCBITaxon_9606 a owl:Class ;
    rdfs:label "Homo sapiens"^^xsd:string ;
    ns1:IAO_0000111 "Homo sapiens"^^xsd:string ;
    ns1:IAO_0000118 "human"^^xsd:string,
        "human being"^^xsd:string,
        "man"^^xsd:string ;
    ns1:IAO_0000412 ns1:ncbitaxon.owl ;
    rdfs:subClassOf ns1:NCBITaxon_314146 .

ns1:OBI_0000275 a owl:Class ;
    rdfs:label "analyte role"@en ;
    ns1:IAO_0000111 "analyte role"^^xsd:string ;
    ns1:IAO_0000112 "Glucose in blood (measured in an assay to determine the concentration of glucose)."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A measurand role borne by a molecular entity or an atom and realized in an analyte assay which achieves the objective to measure the magnitude/concentration/amount of the analyte in the entity bearing evaluant role."@en ;
    ns1:IAO_0000116 "interestingly, an analyte is still an analyte even if it is not detected.  for this reason it does not bear a specified input role"^^xsd:string,
        "pH (technically the inverse log of [H+]) may be considered a quality; this remains to be tested."^^xsd:string,
        "qualities such as weight, color are not assayed but measured, so they do not fall into this category."^^xsd:string ;
    ns1:IAO_0000117 "GROUP: Role Branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    ns1:IAO_0000232 "Feb 10, 2009.  changes after discussion at OBI Consortium Workshop Feb 2-6, 2009.  accepted as core term."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000081 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:CHEBI_23367 ns1:CHEBI_33250 ) ] ],
        ns1:OBI_0002444 .

ns1:RO_0000053 a owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    ns1:IAO_0000111 "bearer of"@en ;
    ns1:IAO_0000112 "this apple is bearer of this red color"@en,
        "this vase is bearer of this fragility"@en ;
    ns1:IAO_0000115 "a relation between an independent continuant (the bearer) and a specifically dependent continuant (the dependent), in which the dependent specifically depends on the bearer for its existence"@en ;
    ns1:IAO_0000116 "A bearer can have many dependents, and its dependents can exist for different periods of time, but none of its dependents can exist when the bearer does not exist."@en ;
    ns1:IAO_0000118 "bearer_of"@en,
        "is bearer of"@en ;
    ns1:RO_0001900 ns1:RO_0001901 ;
    rdfs:range ns1:BFO_0000020 ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0000052 ] .

ns1:UO_0000065 a ns1:UO_0000051,
        owl:NamedIndividual ;
    rdfs:label "nanomolar"^^xsd:string ;
    ns1:IAO_0000111 "nanomolar"^^xsd:string ;
    ns1:IAO_0000115 "A unit of molarity which is equal to one thousandth of one millionth of a molar or 10^[-9] M."^^xsd:string ;
    ns1:IAO_0000118 "nM"^^xsd:string ;
    ns1:IAO_0000412 ns1:uo.owl .

ns1:IAO_0000228 a ns1:IAO_0000225,
        owl:NamedIndividual ;
    rdfs:label "term imported"@en ;
