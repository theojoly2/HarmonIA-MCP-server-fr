ns1:OBI_0000789 a owl:Class ;
    rdfs:label "survival rate"^^xsd:string ;
    ns1:IAO_0000111 "survival rate"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement data that represents the percentage of people or animals in a study or treatment group who are alive for a given period of time after diagnosis or initiation of monitoring."^^xsd:string ;
    ns1:IAO_0000117 "Oliver He"^^xsd:string ;
    ns1:IAO_0000119 "adapted from wikipedia\\nhttp://en.wikipedia.org/wiki/Survival_rate"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000109 .

