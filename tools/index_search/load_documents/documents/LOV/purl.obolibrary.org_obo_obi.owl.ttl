    owl:deprecated true .

ns1:OBI_0100086 a owl:Class ;
    rdfs:label "glucose in solution"^^xsd:string ;
    ns1:IAO_0000111 "glucose in solution"^^xsd:string ;
    ns1:IAO_0000112 "Glucose present in blood"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
