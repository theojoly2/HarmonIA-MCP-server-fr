ns1:OBI_0000006 a owl:Class ;
    rdfs:label "role of being consumer safety officer"@en ;
    ns1:IAO_0000111 "role of being consumer safety officer"^^xsd:string ;
    ns1:IAO_0000112 "Consumer safety officer; Consumer Safety Officer Positions at FDA http://69.20.19.211/jobs/cso.htm"@en,
        "Person charged with serving as CSO, FDA official who coordinates the review"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "the role of a human being that is realized by enforcing regulations to ensure consumer safety"^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "Jennifer Fostel"@en ;
    ns1:IAO_0000119 "OBI, CDISC"@en ;
    rdfs:subClassOf ns1:OBI_0000273 .

ns1:OBI_0000010 a owl:Class ;
    rdfs:label "fluorescent reporter intensity"@en ;
    ns1:IAO_0000111 "fluorescent reporter intensity"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A measurement datum that represents the output of a scanner measuring the intensity value for each fluorescent reporter."@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "group:OBI"^^xsd:string ;
    ns1:IAO_0000232 "From the DT branch: This term and definition were originally submitted by the community to our branch, but we thought they best fit DENRIE. However we see several issues with this. First of all the name 'probe' might not be used in OBI. Instead we have a 'reporter' role. Also, albeit the term 'probe intensity' is often used in communities such as the microarray one, the name 'probe' is ambiguous (some use it to refer to what's on the array, some use it to refer to what's hybed to the array). Furthermore, this concept could possibly be encompassed by combining different OBI terms, such as the roles of analyte, detector and reporter (you need something hybed to a probe on the array to get an intensity) and maybe a more general term for 'measuring intensities'. We need to find the right balance between what is consistent with OBI and combinations of its terms and what is user-friendly. Finally, note that 'intensity' is already in the OBI .owl file and is also in PATO. Why didn't OBI import it from PATO? This might be a problem."@en ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:OBI_0000020 a owl:Class ;
    rdfs:label "contract research organization role"@en ;
    ns1:IAO_0000111 "contract research organization role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a worker role of carrying out the study according to the protocol document or study plan delivered by the PI, under the control of the study director.  This role cannot make decisions about the study execution"@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "contract research organization"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000116 .

ns1:OBI_0000021 a owl:Class ;
    rdfs:label "list-mode data file"@en ;
    ns1:IAO_0000111 "list-mode data file"@en ;
    ns1:IAO_0000112 "An example of a list-mode data file is a file following list-mode Flow Cytometry Standard (FCS) format. Since FCS files can be in histogram mode or  list-mode we have to specify which data format specifically. List-mode format in the overwhelming (even universal) option used."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A list-mode data file is a binary digital entity where events are stored sequentially, parameter by parameter."@en ;
    ns1:IAO_0000116 "One example of usage is in the context of flow cytometry, however is not restricted to this community and is more widely used, e.g. by imaging people."@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "group:Flow Cytometry community"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0000026 a owl:Class ;
    rdfs:label "cytological stain role"@en ;
    ns1:IAO_0000111 "cytological stain role"^^xsd:string ;
    ns1:IAO_0000112 "haemotoxylin is a general purpose nuclear stain extracted from the wood of the logwood tree WEB: http://en.wikipedia.org/wiki/Haematoxylin"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A dye role that is realized when the stain is used to colour cells and or cellular components for the purposes of visualization"^^xsd:string ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "cytological stain"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000250 .

ns1:OBI_0000029 a owl:Class ;
    rdfs:label "centrifuge pellet role"@en ;
    ns1:IAO_0000111 "centrifuge pellet role"^^xsd:string ;
    ns1:IAO_0000112 "Definition of pellet :the material concentrated at the bottom of a centrifuge tube after centrifugation. http://www.everythingbio.com/glos/definition.php?word=pellet"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "pellet role is a role which inheres in a material entity and is realized by a material separation process using gravitational force generated by a centrifuge in which the material bearing the pellet role is the heavier or heaviest component of the output material.."@en ;
    ns1:IAO_0000117 "GROUP:  Role branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    ns1:IAO_0000232 "9Mar09 after discussion with process branch changed definition to include use of centrifuge;"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0302886 ;
            owl:onProperty ns1:BFO_0000054 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        ns1:BFO_0000023 .

ns1:OBI_0000032 a owl:Class ;
    rdfs:label "clinical research coordinator role"@en ;
    ns1:IAO_0000111 "clinical research coordinator role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a worker role comprised of handling the administrative duties of a trial or study."@en ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "clinical research coordinator"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000116 .

ns1:OBI_0000034 a owl:Class ;
    rdfs:label "supernatant role"@en ;
    ns1:IAO_0000111 "supernatant role"^^xsd:string ;
    ns1:IAO_0000112 "Precipitation is the formation of a solid in a solution during a chemical reaction. When the reaction occurs, the solid formed is called the precipitate, and the liquid remaining above the solid is called the supernate.  Wikipedia"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "supernatant role is a role which inheres in a material entity and is realized by a material separation process using gravitational force in which the material bearing the supernatant role is the liquid component of the output material."^^xsd:string ;
    ns1:IAO_0000117 "GROUP: Role branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0600014 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000023 .

ns1:OBI_0000040 a owl:Class ;
    rdfs:label "drug role"@en ;
    ns1:IAO_0000111 "drug role"@en ;
    ns1:IAO_0000112 "http://www.answers.com/topic/drug\\n   1. A substance used in the diagnosis, treatment, or prevention of a disease or as a component of a medication.\\n   2. Such a substance as recognized or defined by the U.S. Food, Drug, and Cosmetic Act."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role borne by a molecular entity and is realized in a process of absorption by an organism  alters, or effects  (or is assumed to effect) a function(s) which inhere in an organism"@en ;
    ns1:IAO_0000117 "Role Branch"@en ;
    ns1:IAO_0000118 "drug"^^xsd:string ;
    ns1:IAO_0000119 "OBI, CDISC"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:CHEBI_23367 ],
        ns1:BFO_0000023 .

ns1:OBI_0000041 a owl:Class ;
    rdfs:label "pump valve switch"@en ;
    ns1:IAO_0000111 "pump valve switch"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A pump valve switch is a cardinal part of a liquid chromatography instrument that controls the flow."@en ;
    ns1:IAO_0000116 "FG:I would assume this should be a pump valve control switch and it would not be specific to a liquid chromatography instrument"@en ;
    ns1:IAO_0000117 "OBI Instrument branch"@en ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000379 ],
        ns1:OBI_0000968 .

ns1:OBI_0000043 a owl:Class ;
    rdfs:label "xenotransplantation"@en ;
    ns1:IAO_0000111 "xenotransplantation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "is the transplantation of living cells, tissues or \\\\norgans from one species to another such as from pigs to humans"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0000105 .

ns1:OBI_0000044 a owl:Class ;
    rdfs:label "physical document"@en ;
    ns1:IAO_0000111 "physical document"@en ;
    ns1:IAO_0000112 "a book is a physical document"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A physical document is an object serving as a record of information by means of symbolic marks."@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "GROUP: OBI"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000047 .

ns1:OBI_0000045 a owl:Class ;
    rdfs:label "waiting"@en ;
    ns1:IAO_0000111 "waiting"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "not actively doing anything to a material for a duration of time."@en ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "BP: I have doubts about the utility of this."@en,
        "We need a better handling/modeling of time (January 2008)"@en ;
    rdfs:subClassOf ns1:OBI_0600009 .

ns1:OBI_0000050 a owl:Class ;
    rdfs:label "obsolete_platform"@en ;
    ns1:IAO_0000111 "platform"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A platform is an object_aggregate that is the set of instruments and software needed to perform a process. definition_source: OBI."@en ;
    ns1:IAO_0000117 "OBI Instrument branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI Instrument branch"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    ns1:IAO_0000232 "suggested for deprecation https://sourceforge.net/tracker/index.php?func=detail&aid=2881353&group_id=177891&atid=886178"^^xsd:string,
        "rem1: We decided at the Philly workshop that consumables do not include reagents.\\nFG: we could actully add a relation to platform which would be \"has_part some instrument\"\\nDS: Sounds fine to me, with the restriction that I would assume a min. cardinality of 2 to be applicable for this crossproduct, so at least 2 instruments make it a platform... at least one is not  enough\\nAR:has_part is transitive, and transitive properties can't have  cardinality constraints in OWL-DL. We can always put this particular  constraint in the owl-full file.\\n\\nWe need to make this a defined class when the class software is in the ontology"@en ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000051 a owl:Class ;
    rdfs:label "liquid chromatography mass spectrometry platform"@en ;
    ns1:IAO_0000111 "liquid chromatography mass spectrometry platform"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A liquid chromatography mass spectrometry platform is a platform that is the collection of instrument, software and reagents needed to perform a liquid chromatography mass spectrometry protocol. definition_source: OBI."@en ;
    ns1:IAO_0000117 "OBI instrument branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI Instrument branch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000049 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000048 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000372 ],
        ns1:OBI_0000832,
        ns1:OBI_0000932 .

ns1:OBI_0000054 a owl:Class ;
    rdfs:label "ratio of collected to emitted light"@en ;
    ns1:IAO_0000111 "ratio of collected to emitted light"@en ;
    ns1:IAO_0000112 "10%"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement datum measuring the amount of light collected s compared to the total amount of emitted light in the detector component of a flow cytometer instrument. The datum has a qualitative role"@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en,
        "person:Kevin Clancy"@en ;
    ns1:IAO_0000119 "Submitted by the Flow Cytometry community in DigitalEntity-FlowCytometry-2007-03-30.txt"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:OBI_0000055 a owl:Class ;
    rdfs:label "software optimization objective"@en ;
    ns1:IAO_0000111 "software optimization objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Software_optimization is a software_testing_objective role describing a study designed to identify the best software or parameters of the software."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000242 .

ns1:OBI_0000056 a owl:Class ;
    rdfs:label "notified body role"@en ;
    ns1:IAO_0000111 "notified body role"^^xsd:string ;
    ns1:IAO_0000112 "The role of notified bodies presentation: http://ec.europa.eu/enterprise/electr_equipment/emc/revision/notified_bodies.pdf"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Notified body is regulator of consumables and medical devices charged by the Competent Authority with verifying compliance of medical devices (not drugs) with the applicable Essential Requirements stated in the Medical Device Directive"@en ;
    ns1:IAO_0000116 "Notified Body (NB). A private institution charged by the Competent Authority with verifying compliance of medical devices (not drugs) with the applicable Essential Requirements stated in the Medical Device Directive. This process, called Conformity Assessment, has EU-wide validity once completed by the NB."@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "notified body"^^xsd:string ;
    ns1:IAO_0000119 "OBI, CDISC"@en ;
    rdfs:subClassOf ns1:OBI_0000273 .

