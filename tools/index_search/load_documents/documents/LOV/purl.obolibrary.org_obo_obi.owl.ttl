ns1:OBI_0002168 a owl:Class ;
    rdfs:label "subcellular protein immunohistochemistry assay" ;
    ns1:IAO_0000111 "subcellular protein immunohistochemistry assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An immunohistochemistry assay that uses antibodies to display the specific subcellular location of proteins."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "ECO"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001986 .

ns1:OBI_0002169 a owl:Class ;
    rdfs:label "ChIP-qPCR assay" ;
    ns1:IAO_0000111 "ChIP-qPCR assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A ChIP assay that uses quantitative PCR to determine levels of specific DNA in immunoprecipitated samples."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string ;
    ns1:IAO_0000119 "PMID:18388953"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000893 ],
        ns1:OBI_0001954 .

ns1:OBI_0002170 a owl:Class ;
    rdfs:label "genomic SELEX" ;
    ns1:IAO_0000111 "genomic SELEX" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A systematic evolution of ligands by exponential enrichment assay that starts with a library derived from genomic DNA instead of synthetically derived random DNA molecules."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string ;
    ns1:IAO_0000119 "PMID:20541015"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002161 .

ns1:OBI_0002171 a owl:Class ;
    rdfs:label "dot blot assay" ;
    ns1:IAO_0000111 "dot blot assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An analyte assay that detects molecules in a mixture dotted on a membrane using DNA probes or antibodies."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "dot blot analysis"^^xsd:string ;
    ns1:IAO_0000119 "PMID:10473518"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000443 .

ns1:OBI_0002172 a owl:Class ;
    rdfs:label "Northwestern blot assay" ;
    ns1:IAO_0000111 "Northwestern blot assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A direct binding assay that detects interactions of labeled RNA with immobilized protein on a membrane."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "Northwestern analysis"^^xsd:string,
        "Northwestern assay"^^xsd:string ;
    ns1:IAO_0000119 "PMID:26965261"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001591 .

ns1:OBI_0002173 a owl:Class ;
    rdfs:label "Southwestern blot assay" ;
    ns1:IAO_0000111 "Southwestern blot assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A direct binding assay that detects interactions of labeled DNA with immobilized protein on a membrane."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "PMID:26404144"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001591 .

ns1:OBI_0002174 a owl:Class ;
    rdfs:label "immunocytochemistry" ;
    ns1:IAO_0000111 "immunocytochemistry" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An immuno staining assay in which samples of intact cells are examined that have had most, if not all, of their surrounding extracellular matrix removed"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
