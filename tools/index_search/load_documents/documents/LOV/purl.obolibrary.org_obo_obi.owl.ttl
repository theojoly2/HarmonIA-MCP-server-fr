ns1:OBI_0000949 a owl:Class ;
    rdfs:label "accessed material role"^^xsd:string ;
    ns1:IAO_0000111 "accessed material role"^^xsd:string ;
    ns1:IAO_0000112 "the role of the  DNA sequencer to which someone gets access to a period of time, e.g. by payment, or other mechanism"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is realized in a planned process where the bearer participates"^^xsd:string ;
