ns1:OBI_0001939 a owl:Class ;
    rdfs:label "genome coverage" ;
    ns1:IAO_0000111 "genome coverage" ;
    ns1:IAO_0000112 "Gigascience. 2012 Dec 27;1(1):18. doi: 10.1186/2047-217X-1-18.\\nPMID: 23587118. \\n\\n\"The genome coverage increased from 81.16% to 93.91%\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A data item that is the total number of bases in reads, divided by genome size, assumed to be the reference size (for instance of 3.10 Gb for human and 2.73 Gb for mouse) and refers to the percentage of the genome that is contained in the assembly based on size estimates; these are usually based on cytological techniques. Genome coverage of 90–95% is generally considered to be good, as most genomes contain a considerable fraction of repetitive regions that are difficult to sequence. So it is not a cause for concern if the genome coverage of an assembly is a bit less than 100%."@en ;
    ns1:IAO_0000117 "Alejandra Gonzalez-Beltran"@en,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "A beginner's guide to eukaryotic genome annotation. Yandell M, Ence D.\\nNat Rev Genet. 2012 Apr 18;13(5):329-42. doi: 10.1038/nrg3174.\\nPMID: 22510764"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:SO_0001248 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0001872 ],
        ns1:IAO_0000027 .

ns1:OBI_0001949 a owl:Class ;
    rdfs:label "sequence annotation reporting role"@en ;
    ns1:IAO_0000111 "sequence annotation reporting role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A reporting party role that is realized by a person or organization who reports the feature annotation results from the analysis of a macromolecular sequence." ;
    ns1:IAO_0000117 "PERSON: Jie Zheng, Chris Stoeckert" ;
    ns1:IAO_0000119 "NIAID GSCID-BRC metadata working group" ;
    dc:source "NIAID GSCID-BRC" ;
    rdfs:subClassOf ns1:OBI_0000068 .

ns1:OBI_0001953 a owl:Class ;
    rdfs:label "freezing"@en ;
    ns1:IAO_0000111 "freezing"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A planned process in which a material entity has it's temperature lowered to below the freezing point in order to bring it to a state in which it can be maintained at this lower temperature in order to preserve some of its qualities." ;
    ns1:IAO_0000117 "Person: Mathias Brochhausen, Jie Zheng" ;
    ns1:IAO_0000119 "Mathias Brochhausen" ;
    rdfs:subClassOf ns1:OBI_0000011 .

ns1:OBI_0001964 a owl:Class ;
    rdfs:label "decision-theoretic analysis objective" ;
    ns1:IAO_0000111 "decision-theoretic analysis objective" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An objective specification which what includes a description of two or more alternative actions to take in a particular situation and a metric that enables comparisons of the two actions. The objective specified is achieved in a planned process which includes a data transformation, the output of which is an identification of the 'best' choice according to the metric." ;
    ns1:IAO_0000116 "The best action to take is typically defined as the one that maximizes expected utility." ;
    ns1:IAO_0000117 "PERSON: Bill Hogan" ;
    ns1:IAO_0000118 "decision analysis objective" ;
    ns1:IAO_0000119 "PERSON: Bill Hogan" ;
    rdfs:subClassOf ns1:IAO_0000005 .

ns1:OBI_0001967 a owl:Class ;
    rdfs:label "multiplexing sequence identifier"@en ;
    ns1:IAO_0000111 "multiplexing sequence identifier"@en ;
    ns1:IAO_0000112 "We designed primers specifically to amplify protease and reverse transcriptase from Brazilian HIV subtypes and developed a multiplexing scheme using multiplex identifier tags to minimize cost while providing more robust data than traditional genotyping techniques. in http://www.ncbi.nlm.nih.gov/pubmed/22574170"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A multiplexing sequence identifier is a nucleic acid sequence which is used in a ligation step of library preparation process to allow pooling of samples while maintaining ability to identify individual source material and creation of a multiplexed library"@en ;
    ns1:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000295 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000711 ns1:OBI_0001959 ) ] ],
        ns1:CHEBI_16991 .

ns1:OBI_0001969 a owl:Class ;
    rdfs:label "biodiversity assessment objective"@en ;
    ns1:IAO_0000111 "biodiversity assessment objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "biodiversity assessment objective is an objective of a planned process aimed at producing data item whose interpretation should provide insight about variety of biological species found in a biological sample at macroscopic or microscopic level"@en ;
    ns1:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "PRS for OBI"@en ;
    rdfs:subClassOf ns1:OBI_0000015 .

ns1:OBI_0001970 a owl:Class ;
    rdfs:label "multiplexed sequencing library"@en ;
    ns1:IAO_0000111 "multiplexed sequencing library"@en ;
    ns1:IAO_0000112 "http://www.ncbi.nlm.nih.gov/pubmed/24997861\\n\\nNat Methods. 2014 Aug;11(8):834-40. doi: 10.1038/nmeth.3022. Epub 2014 Jul 6.\\nAccelerated chromatin biochemistry using DNA-barcoded nucleosome libraries."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a multiplexed library is a material entity which is the output of a library preparation process that uses a ligation step to attach a unique multiplexing sequence identifier to a specific sample, then mixes several such tagged samples prior to the library amplification process proper. A multiplexed library allows the sequencing of several samples in one sequencing run."@en ;
    ns1:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en ;
    ns1:IAO_0000118 "DNA-barcoded sequencing library"@en ;
    ns1:IAO_0000119 "PRS for OBI"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0001967 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000711 ns1:OBI_0001959 ) ] ],
        ns1:OBI_0000047 .

ns1:OBI_0001976 a owl:Class ;
    rdfs:label "hydrogen/deuterium exchange footprinting assay" ;
    ns1:IAO_0000111 "hydrogen/deuterium exchange footprinting assay" ;
    ns1:IAO_0000112 "Performing deuterium exchange on a protein by itself and in the presence of a binding partner, degrading the protein into peptide segments and identifying where deuterium exchange occurred by detecting the peptides in Mass Spectrometry. Peptides that have a modified deuteration pattern when the protein was bound to a partner are expected to be part of the binding interface."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A footprinting assay that uses a chemical reaction whereby a covalently bonded hydrogen atom is replaced by a deuterium atom, or vice versa in order to gather information about the solvent accessibility of parts of a molecule and thus its tertiary structure."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
