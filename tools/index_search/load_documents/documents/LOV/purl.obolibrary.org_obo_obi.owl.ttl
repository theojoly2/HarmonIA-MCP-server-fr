    ns1:IAO_0000117 "James Malone"@en,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "TERM: CHEBI:33839"@en ;
    ns1:IAO_0000231 ns1:IAO_0000228 ;
