    ns1:IAO_0000111 "Ion 318 Chip v2"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An ion semiconductor chip manufactured by Life Technologies which detects polymerase-driven base incorporation to translate into digital form. The 318 chip is compatible with the Ion Torrent PGM and has a run time of:\\n\\n4.4 hours for 200 bp reads with an output of 60 Mb-1 Gb,\\n7.3 hours for 400 bp reads with an output of 1.2 Gb-2 Gb."@en ;
    ns1:IAO_0000116 "Issue Tracker #775\\nhttps://sourceforge.net/p/obi/obi-terms/775/"@en ;
    ns1:IAO_0000117 "PERSON: Sagar Jain"@en ;
