ns1:OBI_0000695 a owl:Class ;
    rdfs:label "chain termination sequencing assay" ;
    ns1:IAO_0000111 "chain termination sequencing assay" ;
    ns1:IAO_0000112 "PMID: 271968. DNA sequencing with chain-terminating inhibitors."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A DNA sequencing assay which rely on the use of dideoxynucleotides used in 4 distinct sequencing reaction on the same DNA sample. The dideoxynucleotides, once incorporated in the complementary DNA strand being synthesized by the DNA polymerase prevent any further chain elongation. The newly generated sequences are resolved on a polyacrylamide gel using electrophoresis and labels (either fluorochrome or radioactivity) are used to determine the nucleotide present at a given position"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "Sanger sequencing"^^xsd:string,
        "dye terminator sequencing"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Sanger_sequencing"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000406 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:unionOf ( ns1:OBI_0000691 ns1:OBI_0000710 ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:OBI_0000691 ns1:OBI_0000710 ) ] ] ) ],
        ns1:OBI_0000734 .

ns1:OBI_0000697 a owl:Class ;
    rdfs:label "Helicos sequencing assay" ;
    ns1:IAO_0000111 "Helicos sequencing assay" ;
    ns1:IAO_0000112 "PMID: 18388294. Single-molecule DNA sequencing of a viral genome."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A DNA sequencing by synthesis assay that identifiies the sequnece of billions of DNA molecules immobilized to a surface using DNA polymerase and fluorescently labeled nucleotides added one at a time. The sequencing process does not require an amplification step and is typically able to produce reads of 25 base pair length."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "true single molecule sequencing"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Helicos_single_molecule_fluorescent_sequencing"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0000717 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0000717 ] ) ],
        ns1:OBI_0000734 .

ns1:OBI_0000698 a owl:Class ;
    rdfs:label "obsolete_DNA ligase"^^xsd:string ;
    ns1:IAO_0000111 "DNA ligase"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A DNA ligase is an enzyme that covalently joins two compatible pieces of DNA through the cleavage of an ATP molecule"^^xsd:string ;
    ns1:IAO_0000116 "5/22 Need to explore if there are GO / other classes exist that capture this. We need it now for cloning experiments"^^xsd:string,
        "replaced by imported PRO: DNA ligase"^^xsd:string ;
    ns1:IAO_0000117 "Kevin Clancy, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "ligase"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000228 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000699 a owl:Class ;
    rdfs:label "survival assessment assay" ;
    ns1:IAO_0000111 "survival assessment assay" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An assay that measures the occurrence of death events in one or more organisms over time"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0000789 ],
        [ a owl:Restriction ;
