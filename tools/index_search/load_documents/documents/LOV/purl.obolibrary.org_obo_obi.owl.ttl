            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000401 ],
        ns1:OBI_0002089 .

ns1:OBI_0000060 a owl:Class ;
    rdfs:label "trial monitor role"@en ;
    ns1:IAO_0000111 "trial monitor role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a responsible party involved in planning, overseeing the conduct of a study or study component, and interpreting data from a study"@en ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "trial monitor"^^xsd:string ;
    ns1:IAO_0000232 "CDISC definition:  Person employed by the sponsor or CRO who is responsible for determining that a trial is being conducted in accordance with the protocol and GCP guidance. NOTE: A monitor's duties may include, but are not limited to, helping to plan and initiate a trial, assessing the conduct of trials, and assisting in data analysis, interpretation and extrapolation. Clinical Research Associate:  Primary representative of the sponsor; monitors progress of investigator sites participating in a clinical study."@en ;
    rdfs:subClassOf ns1:OBI_0000102 .

ns1:OBI_0000068 a owl:Class ;
    rdfs:label "reporting party role"@en ;
    ns1:IAO_0000111 "reporting party role"^^xsd:string ;
    ns1:IAO_0000112 "Person who prepares microarray data in MAGE-TAB format and submits to a database, such as ArrayExpress."^^xsd:string,
        "The first section has been pre-designated as the 'Reporting Party' section and should be filled with the Reporting Party's personal information.  http://www.mercedsheriff.com/SelfReporting.htm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a study personnel role played by a party who reports the outcome of a study component"@en ;
    ns1:IAO_0000116 "MO:submitter mapped to this term. So, alternative term 'submitter' was added."^^xsd:string ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    ns1:IAO_0000118 "reporting party"^^xsd:string,
        "submitter"^^xsd:string ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf ns1:OBI_0000202 .

ns1:OBI_0000093 a owl:Class ;
    rdfs:label "patient role"@en ;
    ns1:IAO_0000111 "patient role"^^xsd:string ;
    ns1:IAO_0000112 "a hospitalized person; a person with controlled diabetes; the patient's role http://www.fertilityjourney.com/testingAndDiagnosis/theRightDoctor/thePatientsRole/index.asp?C=55245395146924652778"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role which inheres in a person and is realized by the process of being under the care of a physician or health care provider"@en ;
    ns1:IAO_0000117 "GROUP:Role Branch"@en ;
    ns1:IAO_0000118 "patient"^^xsd:string ;
    ns1:IAO_0000119 "OBI, CDISC"@en ;
    ns1:IAO_0000232 "CDISC definition:  patient. Person under a physician's care for a particular disease or condition. NOTE: A subject in a clinical trial is not necessarily a patient, but a patient in a clinical trial is a subject. See also subject, trial subject, healthy volunteer. Often used interchangeably"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:NCBITaxon_9606 ],
        ns1:BFO_0000023 .

ns1:OBI_0000096 a owl:Class ;
    rdfs:label "protocol testing objective"@en ;
    ns1:IAO_0000111 "protocol testing objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Protocol_testing_objective is a methodology_testing_objective role describing a study designed to examine the effects of using different protocols."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000208 .

ns1:OBI_0000103 a owl:Class ;
    rdfs:label "principal investigator role"@en ;
    ns1:IAO_0000111 "principal investigator role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a responsible party role played by a person responsible for the overall conduct of a study"@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "principal investigator"^^xsd:string ;
    ns1:IAO_0000232 "CDISC definition: A person responsible for the conduct of the clinical trial at a trial site. If a trial is conducted by a team of individuals at a trial site, the investigator is the responsible leader of the team and may be called the principal investigator. 2. The individual principal investigator. 2. The individual under whose immediate direction the test article is administered or dispensed to, or used involving, a subject, or, in the event of an investigation conducted by a team of individuals, is See also sponsor-investigator.; Leiter der klinischen Prufung.Under the German Drug Law, the physician who is head of the clinical investigation (CDISC): coordinating investigator (CDISC) (also study coordinator, MUSC); sponsor-investigator. An individual who both initiates and conducts, alone or with others, a clinical trial, and under whose immediate direction the investigational product is administered to, dispensed to, or used by a subject.NOTE: The term does not include any person other than an individual, hence not a corporation, agency (CDISC)"@en ;
    rdfs:subClassOf ns1:OBI_0000102 .

ns1:OBI_0000118 a owl:Class ;
    rdfs:label "gene list"@en ;
    ns1:IAO_0000111 "gene list"@en ;
    ns1:IAO_0000112 "Gene lists may arise from analysis to determine differentially expressed genes, may be collected from the literature for involvement in a particular process or pathway (e.g., inflammation), or may be the input for gene set enrichment analysis."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A data set of the names or identifiers of genes that are the outcome of an analysis or have been put together for the purpose of an analysis."@en ;
    ns1:IAO_0000117 "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "group:OBI"^^xsd:string ;
    ns1:IAO_0000232 "kind of report. (alan) need to be careful to distinguish from output of a data transformation or calculation. A gene list is a report when it is published as such? Relates to question of whether report is a whole, or whether it can be a part of some other narrative object."@en ;
    rdfs:subClassOf ns1:IAO_0000100 .

ns1:OBI_0000136 a owl:Class ;
    rdfs:label "incubator"@en ;
    ns1:IAO_0000111 "incubator"@en ;
    ns1:IAO_0000112 "Incubators are used in microbiology for culturing (growing) bacteria and other microorganisms. Incubators in tissue culture rooms are used for culturing stem cells, lymphocytes, skin fibroblasts and other types of cells"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a device in which environmental conditions (light, photoperiod, temperature, humidity, etc.) can be controlled"@en ;
    ns1:IAO_0000117 "Frank Gibson"@en ;
    ns1:IAO_0000119 "http://www.medterms.com/script/main/art.asp?articlekey=18426"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000401 ],
        ns1:OBI_0002089 .

ns1:OBI_0000151 a owl:Class ;
    rdfs:label "filter paper"@en ;
    ns1:IAO_0000111 "filter paper"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a device manufacture with the intent to provide a porous unsized paper used for filtering."@en ;
    ns1:IAO_0000117 "Frank Gibson"@en ;
    ns1:IAO_0000119 "sep:00107"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000378 ],
        ns1:OBI_0000932 .

ns1:OBI_0000162 a owl:Class ;
    rdfs:label "complete nutrient role"@en ;
    ns1:IAO_0000111 "complete nutrient role"^^xsd:string ;
    ns1:IAO_0000112 "Rat chow; RPMI medium + serum; use example:  CNS17 (Complete Nutrient System) Grow 3-2-4, http://www.kalyx.com/store/proddetail.cfm/ItemID/552307/CategoryID/12000/SubCatID/2755/file.htm"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A nutrient role that inheres in a material entity and is realized in the use of that material entity by an organism to provide all needed nourishment."^^xsd:string ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "complete nutrient"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000204 .

ns1:OBI_0000186 a owl:Class ;
    rdfs:label "protocol optimization objective"@en ;
    ns1:IAO_0000111 "protocol optimization objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Protocol_optimization is a protocol_testing_objective role describing a study designed to identify the best protocol.  This may be carried out by comparing different protocols or by modifying the parameters used within a single protocol."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000096 .

ns1:OBI_0000198 a owl:Class ;
    rdfs:label "biological replicate role"@en ;
    ns1:IAO_0000111 "biological replicate role"^^xsd:string ;
    ns1:IAO_0000112 "A member of a dose-time group; a patient in a given arm of a trial"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a reference participant role realized by equivalent treatment of participants"^^xsd:string ;
    ns1:IAO_0000117 "Person:Jennifer Fostel"@en ;
    ns1:IAO_0000118 "biological replicate"^^xsd:string ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf ns1:OBI_0000220 .

ns1:OBI_0000204 a owl:Class ;
    rdfs:label "nutrient role"@en ;
    ns1:IAO_0000111 "nutrient role"^^xsd:string ;
    ns1:IAO_0000112 "Luria broth; vitamin A; A nutrient is a substance used in an organism's metabolism which must be taken in from the environment.  Wikipedia."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role that inheres in a material entity and is realized in the use of that material entity by an organism when it is used in that organism's metabolism and provides nourishment."@en ;
    ns1:IAO_0000117 "GROUP:  Role branch"@en ;
    ns1:IAO_0000118 "nutrient"^^xsd:string ;
    ns1:IAO_0000119 "Wikipedia, feb 29, 2008"@en ;
    ns1:IAO_0000232 "19 Feb 2009; old def: A nutrient role is a role played by a substance used in an organism's metabolism which is taken in from the environment and provides nourishment."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        ns1:BFO_0000023 .

ns1:OBI_0000214 a owl:Class ;
    rdfs:label "negative reference substance role"@en ;
    ns1:IAO_0000111 "negative reference substance role"^^xsd:string ;
    ns1:IAO_0000112 "Saline solution"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a reference role in which the characteristics or responses elicited by the substance playing the reference substance role are used to establish a \"no effect\" response"^^xsd:string ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "negative reference substance"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_0000070 ;
