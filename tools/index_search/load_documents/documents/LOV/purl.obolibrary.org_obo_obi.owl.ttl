    ns1:IAO_0000112 "PMID:20679230"^^xsd:string,
        "PMID:25367129"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An assay that dteremines taxonomic and community diversity information by sequencing specific genomic regions used as marker of identity or diversity."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "environmental gene survey"^^xsd:string,
        "targeted gene survey"^^xsd:string,
        "targeted gene survey DNA barcoding"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
