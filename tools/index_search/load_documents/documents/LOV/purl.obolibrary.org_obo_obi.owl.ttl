ns1:OBI_0001968 a owl:Class ;
    rdfs:label "operational taxonomic unit matrix"@en ;
    ns1:IAO_0000111 "operational taxonomic unit matrix"@en ;
    ns1:IAO_0000112 "http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1610290/"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "Operational Taxonomic Unit matrix  is a data item, organized as a table, where organismal taxonomic units, computed by sequence analysis and genetic distance calculation, are counted in a set of biological or environmental samples. The table is  used to appraise biodiversity of a population or community of living organism.\\n"@en ;
    ns1:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "PRS for OBI"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0200000 ],
        ns1:IAO_0000027 .

ns1:OBI_0001971 a owl:Class ;
    rdfs:label "Ion 316 Chip v2"@en ;
    ns1:IAO_0000111 "Ion 316 Chip v2"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An ion semiconductor chip manufactured by Life Technologies which detects polymerase-driven base incorporation to translate into digital form. The 316 chip is compatible with the Ion Torrent PGM and has a run time of:\\n\\n3.0 hours for 200 bp reads with an output of 30-50 Mb,\\n4.9 hours for 400 bp reads with an output of 60 Mb-1 Gb."@en ;
    ns1:IAO_0000116 "Issue Tracker #774\\nhttps://sourceforge.net/p/obi/obi-terms/774/"@en ;
    ns1:IAO_0000117 "PERSON: Sagar Jain"@en ;
    ns1:IAO_0000118 "Ion 316 Chip"@en,
        "Ion PGM 316 Chip"@en,
        "Ion PGM 316 Chip v2"@en ;
    ns1:IAO_0000119 "http://www.lifetechnologies.com/us/en/home/life-science/sequencing/next-generation-sequencing/ion-torrent-next-generation-sequencing-workflow/ion-torrent-next-generation-sequencing-run-sequence/ion-pgm-ion-proton-system-chips.html" ;
    rdfs:subClassOf ns1:OBI_0001973 .

