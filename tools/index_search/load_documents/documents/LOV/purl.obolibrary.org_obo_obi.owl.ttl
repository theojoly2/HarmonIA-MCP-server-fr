ns1:IAO_0000324 a owl:Class ;
    rdfs:label "acknowledgements section"@en ;
    ns1:IAO_0000111 "acknowledgements section"@en ;
    ns1:IAO_0000112 "The authors wish to thank Alan Ruttenberg for his constructive comments about an earlier draft of this manuscript"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Part of a publication that is about the contributions of people or institutions other than the authors."@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    ns1:IAO_0000118 "acknowledgements"@en,
        "acknowledgments"@en ;
