    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A material entity that is generated by a purification process in which an input material is separated to obtain a fraction with a higher concentration of a desired component"^^xsd:string ;
    ns1:IAO_0000117 "GROUP: OBI call "^^xsd:string ;
