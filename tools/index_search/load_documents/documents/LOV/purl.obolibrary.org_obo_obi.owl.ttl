    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A planned process which results in physical changes in a specified input material"@en ;
    ns1:IAO_0000117 "PERSON: Frank Gibson"^^xsd:string,
