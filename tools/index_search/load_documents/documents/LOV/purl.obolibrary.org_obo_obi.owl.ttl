ns1:OBI_0000724 a owl:Class ;
    rdfs:label "Solexa sequencing assay" ;
    ns1:IAO_0000111 "Solexa sequencing assay" ;
    ns1:IAO_0000112 "PMID: 18987734"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A DNA sequencing by synthesis assay that identifies sequence information using DNA polymerase and reversible terminator, requiring immobilization of genomic DNA fragments onto a surface and a specific clonal amplification step known as bridge PCR. Reliance on a reversible terminator allows cycles of DNA chain extension by DNA polymerase and imaging without the need of electrophoretic separation of newly synthesized DNA fragment as with Sanger sequencing."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "reversible terminator sequencing"^^xsd:string ;
    ns1:IAO_0000119 "Solexa web site (SS_DNAsequencing.pdf document available on july 2009)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:OBI_0000722 ns1:OBI_0000736 ) ] ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0000703 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0000703 ] ) ],
        ns1:OBI_0000734 .

ns1:OBI_0000728 a owl:Class ;
    rdfs:label "rodent care"^^xsd:string ;
    ns1:IAO_0000111 "rodent care"^^xsd:string ;
    ns1:IAO_0000112 "keeping animal"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "rodent care  is the process by which rodents are being provided with a controlled living environment while kept in captivity for the purpose of research."^^xsd:string ;
    ns1:IAO_0000117 "PPPB branch"^^xsd:string ;
