    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01121"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000601 .

