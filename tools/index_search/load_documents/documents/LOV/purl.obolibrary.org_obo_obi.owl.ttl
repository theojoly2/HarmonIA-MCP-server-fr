ns1:OBI_0002477 a owl:Class ;
    rdfs:label "reference genome role"@en ;
    ns1:IAO_0000111 "reference genome role"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A reference substance role that is played by a reference genome when used during sequence alignment."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    rdfs:subClassOf ns1:OBI_0000025 .

ns1:OBI_0002479 a owl:Class ;
    rdfs:label "sequence read length measurement datum"@en ;
    ns1:IAO_0000111 "sequence read length measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A measurement datum that is the result of the measurement of the number of bases in a DNA or RNA sequence."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
    ns1:IAO_0000118 "read length, read length measurement datum"@en ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:OBI_0002480 a owl:Class ;
    rdfs:label "sequencing library input quantity measurement datum"@en ;
    ns1:IAO_0000111 "sequencing library input quantity measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A scalar measurement datum that indicates the amount of sequencing library used as input for a sequencer."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim"@en ;
    ns1:IAO_0000118 "library input amount"@en ;
