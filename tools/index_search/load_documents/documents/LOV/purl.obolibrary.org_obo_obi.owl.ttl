            owl:intersectionOf ( ns1:OBI_0001445 [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0600031 ] ) ] .

ns1:OBI_1110017 a owl:Class ;
    rdfs:label "living with infected household contact"@en ;
    ns1:IAO_0000111 "living with infected household contact"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process in which a a human being lives in the same household as another human being that is known to be infected with an infectious agent"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_1110111 .

ns1:OBI_1110018 a owl:Class ;
    rdfs:label "living in endemic area"@en ;
    ns1:IAO_0000111 "living in endemic area"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process in which a potential host organism lives in a geographic area in which an infectious agent is present to such a degree of frequency that contact is likely"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_1110111 .

ns1:OBI_1110019 a owl:Class ;
    rdfs:label "pathogen release in laboratory accident"@en ;
    ns1:IAO_0000111 "pathogen release in laboratory accident"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process in which a an infectious agent maintained in a laboratory setting is not contained as planned, leading to potential exposure of human beings to the agent"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:OBI_1110111 .

ns1:OBI_1110020 a owl:Class ;
    rdfs:label "Immunization in vitro"@en ;
    ns1:IAO_0000111 "Immunization in vitro"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Process of administering an object playing the role of immunogen to a cell culture"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_1110094 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        ns1:OBI_0000094 .

ns1:OBI_1110024 a owl:Class ;
    rdfs:label "environmental exposure to infectious agent"@en ;
    ns1:IAO_0000111 "environmental exposure to infectious agent"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Is a process in which an infectious agent is in direct contact with a potential host organism in its habitat. This is preceded by proximity to the infectious agent"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:GO_0008150 ;
