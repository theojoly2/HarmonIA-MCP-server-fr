ns1:OBI_0001147 a owl:Class ;
    rdfs:label "cell culture expansion"@en ;
    ns1:IAO_0000111 "cell culture expansion"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a processual entity that results in the increase of cell numbers"@en ;
    ns1:IAO_0000116 "including grow of yeast and bacteria"@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "MO_758 grow"@en ;
    ns1:IAO_0000232 "BP:\\nadd it as subclass of 'cell culturing'\\nJZ:\\nNo 'cell culturing' in OBI\\nHas term 'cell co-culturing' and  'maintaining cell culture'. Don't think either of it fit. So leave the term under process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0100060 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0100060 ] ) ],
        ns1:OBI_0000094 .

ns1:OBI_0001148 a owl:Class ;
    rdfs:label "gene knock out"@en ;
    ns1:IAO_0000111 "gene knock out"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a genetic transformation that renders a gene non-functional, e.g. due to a point mutation, or the removal of all, or part of, the gene using recombinant methods."@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "MO_771 gene_knock_out"@en ;
    rdfs:subClassOf ns1:OBI_0600043 .

ns1:OBI_0001149 a owl:Class ;
    rdfs:label "gene knock in"@en ;
    ns1:IAO_0000111 "gene knock in"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a genetic transformation that involves the insertion of a protein coding cDNA sequence at a particular locus in an organism's chromosome. Typically, this is done in mice since the technology for this process is more refined, and because mouse embryonic stem cells are easily manipulated. The difference between knock-in technology and transgenic technology is that a knock-in involves a gene inserted into a specific locus, and is a \"targeted\" insertion."@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_437 gene_knock_in"@en,
        "WEB: http://en.wikipedia.org/wiki/Gene_Knock-in"@en ;
    rdfs:subClassOf ns1:OBI_0600043 .

ns1:OBI_0001150 a owl:Class ;
    rdfs:label "chromosomal substitution"@en ;
    ns1:IAO_0000111 "chromosomal substitution"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A genetic transformation in which all, or part, of a chromosome from a donor replaces that of the recipient. It does not include chromosome recombination. For single gene insertion, use the term 'gene knock in'. "@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "MO_995 chromosomal_substitution"@en ;
    rdfs:subClassOf ns1:OBI_0600043 .

ns1:OBI_0001154 a owl:Class ;
    rdfs:label "induced mutation"@en ;
    ns1:IAO_0000111 "induced mutation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a genetic transformation that the modification of the genetic material (either coding or non-coding) of an organism is caused by mutagenic compounds or irradiation."@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "MO_564 induced_mutation"@en ;
    rdfs:subClassOf ns1:OBI_0600043 .

ns1:OBI_0001156 a owl:Class ;
    rdfs:label "age since planting measurement datum"@en ;
    ns1:IAO_0000111 "age since planting measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since planting, the process of placing a plant in media (e.g. soil) to allow it to grow, which excludes sowing."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_495 planting"^^xsd:string ;
    ns1:IAO_0000232 "Discussed by Jie and Chris, proposed to combine with different kinds of processes as initial time point. Proposed 'age measurement assay' is proceeded by some process. The process can be any kind of process defined in OBI. Think it is more flexible. However, it is hard to model  due to lake of temporal predicates on Nov 15, 2010 dev call.\\nTerm proposed by Bjoern on Nov 8, 2010 dev call\\nSupported by Alan on Nov 15, 2010 dev call"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0001157 a owl:Class ;
    rdfs:label "age since hatching measurement datum"@en ;
    ns1:IAO_0000111 "age since hatching measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since hatching, the process of emergence from an egg."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_745 hatching"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0001158 a owl:Class ;
    rdfs:label "age determination assay" ;
    ns1:IAO_0000111 "age determination assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that determines the duration of part of the life of an organism, where the initial time point is the beginning of some transitional state (such as birth or when planted)."^^xsd:string ;
    ns1:IAO_0000116 "This assay measures time not developmental stage. we recognize that development takes different time periods under different conditions such as media / temperature. For example, age measurement assay of fly age, the output likes 28 days but not mid-life of age at room temperature."^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000118 "age measurement assay"^^xsd:string ;
    ns1:IAO_0000119 "OBI group"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:OBI_0100026 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0100026 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0001167 ],
        ns1:OBI_0000070 .

ns1:OBI_0001159 a owl:Class ;
    rdfs:label "age since egg laying measurement datum"@en ;
    ns1:IAO_0000111 "age since egg laying measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since egg laying, the process of the production of egg(s) by an organism."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_767 egg laying"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0001160 a owl:Class ;
    rdfs:label "assay validation objective"@en ;
    ns1:IAO_0000111 "assay validation objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "an objective specification to check the accuracy or the quality of the results of an assay by comparison with independent results"@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "GROUP: Penn Group"@en ;
    rdfs:subClassOf ns1:IAO_0000005 .

ns1:OBI_0001161 a owl:Class ;
    rdfs:label "age since germination measurement datum"@en ;
    ns1:IAO_0000111 "age since germination measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since germination, the process consisting of physiological and developmental changes by a seed, spore, pollen grain (microspore), or zygote that occur after release from dormancy, and encompassing events prior to and including the first visible indications of growth."^^xsd:string ;
    ns1:IAO_0000116 "Definition of germination comes from GO. However, the term is deprecated from GO now because it is a grouping term without biological significance."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_590 germination"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0001162 a owl:Class ;
    rdfs:label "validation by reverse transcription PCR design"@en ;
    ns1:IAO_0000111 "validation by reverse transcription PCR design"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a study design in which checks the accuracy or the quality of the result of an assay  by comparing with reverse transcription PCR results"@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "MO_986 reverse_transcription_PCR_quality_control"@en ;
    rdfs:subClassOf ns1:OBI_0500000 .

ns1:OBI_0001163 a owl:Class ;
    rdfs:label "age since eclosion measurement datum"@en ;
    ns1:IAO_0000111 "age since eclosion measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since eclosion, the process of emergence of an adult insect from its pupa or cocoon."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_876 eclosion"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0001164 a owl:Class ;
    rdfs:label "age since sowing measurement datum"@en ;
    ns1:IAO_0000111 "age since sowing measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since sowing, the process of placing a seed or spore in some media with the intention to invoke germination."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_748 sowing"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0001165 a owl:Class ;
    rdfs:label "age since coitus measurement datum"@en ;
    ns1:IAO_0000111 "age since coitus measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since coitus, the process of copulation that occurs during the process of sexual reproduction."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_783 coitus"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0001166 a owl:Class ;
    rdfs:label "validation by real time PCR design"@en ;
    ns1:IAO_0000111 "validation by real time PCR design"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a study design in which the accuracy or the quality of the result of an assay is checked by comparing with real time PCR results"@en ;
    ns1:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "MO_434 real_time_PCR_quality_control"@en ;
    rdfs:subClassOf ns1:OBI_0500000 .

ns1:OBI_0001168 a owl:Class ;
    rdfs:label "age since fertilization measurement datum"@en ;
    ns1:IAO_0000111 "age since fertilization measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since fertilization, the process of the union of gametes of opposite sexes during the process of sexual reproduction to form a zygote."^^xsd:string ;
    ns1:IAO_0000116 "Definition of fertilization comes from GO."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_701 fertilization"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0001169 a owl:Class ;
    rdfs:label "age since birth measurement datum"@en ;
    ns1:IAO_0000111 "age since birth measurement datum"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since birth, the process of emergence and separation of offspring from the mother."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_710 birth"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001167 .

ns1:OBI_0001170 a owl:Class ;
    rdfs:label "reverse transcription polymerase chain reaction assay" ;
    ns1:IAO_0000111 "reverse transcription polymerase chain reaction assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that determines the concentration of RNA in a sample in which an RNA strand is first reverse transcribed into its DNA complement (complementary DNA, or cDNA) using the enzyme reverse transcriptase, and the resulting cDNA is amplified using traditional or real-time PCR."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert"^^xsd:string,
        "Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "Penn Group"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000880 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000552 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0010467 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:OBI_0000880 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000880 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        ns1:OBI_0000070 .

ns1:OBI_0001182 a owl:Class ;
    rdfs:label "negative binding datum"^^xsd:string ;
    ns1:IAO_0000111 "negative binding datum"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A binding datum that states that there is no significant disposition of two or more entities to form a complex"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001181 .

ns1:OBI_0001183 a owl:Class ;
    rdfs:label "epitope protection from tumor challenge experiment" ;
    ns1:IAO_0000111 "epitope protection from tumor challenge experiment" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An epitope protection experiment in which the ability of the epitope to protect the host from developing tumors is assessed. "^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "tumor burden after challenge"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001184 .

ns1:OBI_0001186 a owl:Class ;
    rdfs:label "epitope protection from infectious challenge experiment based on pathogen burden" ;
    ns1:IAO_0000111 "epitope protection from infectious challenge experiment based on pathogen burden" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An epitope protection from infectious challenge experiment in which the readout is a reduction in the presence of pathogens in the host compared to controls. "^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "pathogen urden after infectious challenge"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001179 .

ns1:OBI_0001187 a owl:Class ;
    rdfs:label "infectious agent detection assay" ;
    ns1:IAO_0000111 "infectious agent detection assay" ;
    ns1:IAO_0000112 "Culturing a sputum sample on agar medium to detect bacterial growth; Stain slices of liver from a mouse to count presence of infectious centers; PCR amplification using primers specific for influenza virus."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that measures the presence or amount of an infectious agent in an evaluant"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string,
        "Jason Greenbaum"^^xsd:string,
        "Randi Vita"^^xsd:string,
        "Richard Scheuermann"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:IDO_0000586 ] ],
        ns1:OBI_0000070 .

ns1:OBI_0001188 a owl:Class ;
    rdfs:label "epitope disease exacerbation experiment" ;
    ns1:IAO_0000111 "epitope disease exacerbation experiment" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An efficacy of epitope intervention experiment that tests the ability of inducing an epitope immune response to increase the severity of an existing disease in the host."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "exacerbation assay"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001178 .

ns1:OBI_0001190 a owl:Class ;
    rdfs:label "epitope treatment experiment" ;
    ns1:IAO_0000111 "epitope treatment experiment" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An epitope intervention experiment that tests the ability of inducing an epitope immune response to treat an existing disease  in the host."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "decreased disease symptoms after treatment"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001178 .

ns1:OBI_0001194 a owl:Class ;
    rdfs:label "ELISPOT assay measuring epitope specific transforming growth factor-beta production by T cells" ;
    ns1:IAO_0000111 "ELISPOT assay measuring epitope specific transforming growth factor-beta production by T cells" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay of epitope specific transforming growth factor-beta production by T cells that uses an ELISPOT assay."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "ELISPOT"^^xsd:string,
        "TGFb release"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001264 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0001264 [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0600031 ] ) ] .

ns1:OBI_0001195 a owl:Class ;
    rdfs:label "operator variation design"@en ;
    ns1:IAO_0000111 "operator variation design"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design that assesses the operator performance and relation to data consistency and quality."@en ;
