        ns1:OBI_0000094 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000639 ] .

ns1:OBI_0000973 a owl:Class ;
    rdfs:label "sequence data"@en ;
    ns1:IAO_0000111 "sequence data"^^xsd:string ;
    ns1:IAO_0000112 "example of usage: the representation of a nucleotide sequence in FASTA format used for a sequence similarity search."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement datum that representing the primary structure of a macromolecule(it's sequence) sometimes associated with an indicator of confidence of that measurement.\\n"^^xsd:string ;
