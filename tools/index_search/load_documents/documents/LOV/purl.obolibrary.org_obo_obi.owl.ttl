ns1:OBI_0001385 a owl:Class ;
    rdfs:label "intracellular cytokine staining assay measuring epitope specific tumor necrosis factor superfamily cytokine production by T cells" ;
    ns1:IAO_0000111 "intracellular cytokine staining assay measuring epitope specific tumor necrosis factor superfamily cytokine production by T cells" ;
