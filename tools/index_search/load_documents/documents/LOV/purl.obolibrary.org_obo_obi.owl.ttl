                                            owl:someValuesFrom ns1:GO_0042611 ] ) ] ] ) ] .

ns1:OBI_0001583 a owl:Class ;
    rdfs:label "half life of binding datum"^^xsd:string ;
    ns1:IAO_0000111 "half life of binding datum"^^xsd:string ;
    ns1:IAO_0000112 "The 45 minute period in which one half of the complexes formed by peptide ligand bound to a  HLA-A*0201molecule disassociate."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A half life datum of the time it takes for 50% of bound complexes in an ensemble to disassociate in absence of re-association. "^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001144,
        ns1:OBI_0001171 .

ns1:OBI_0001591 a owl:Class ;
    rdfs:label "direct binding assay" ;
    ns1:IAO_0000111 "direct binding assay" ;
    ns1:IAO_0000112 "Detecting the binding of a fluorescently labeled antibody to a peptide bound to the bottom of an ELISA plate, by incubating the antibody in the well, washing the plate, and detecing fluorescence which is a proxy for the presence of the bound antibody._"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A binding assay that measures the formation or disassociation of a complex of 2 material entities directly without use of a competitve ligand."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string,
        "Randi Vita"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001146 .

