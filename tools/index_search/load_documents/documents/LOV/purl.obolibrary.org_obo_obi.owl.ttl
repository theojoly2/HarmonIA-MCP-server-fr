ns1:OBI_0000201 a owl:Class ;
    rdfs:label "radioactivity detection" ;
    ns1:IAO_0000111 "radioactivity detection" ;
    ns1:IAO_0000112 "Placing the evaluant input material close to a scintillation counter which emits light upon being hit with alpha/beta/gamma radiation and counting the frequency of light blasts to determine the radioactivity of the input material."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that measures the amount of radiation in the radioactive spectrum (alpha, beta or gamma rays) emitted from an input material."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string,
        "PlanAndPlannedProcess Branch"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000070 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000053 ;
                                            owl:someValuesFrom ns1:PATO_0001741 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:IAO_0000136 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                                    owl:onProperty ns1:RO_0000053 ;
