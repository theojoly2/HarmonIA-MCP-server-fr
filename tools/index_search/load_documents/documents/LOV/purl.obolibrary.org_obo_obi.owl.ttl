ns1:IAO_0000003 a owl:Class ;
    rdfs:label "measurement unit label"@en ;
    ns1:IAO_0000111 "measurement unit label"@en ;
    ns1:IAO_0000112 "Examples of measurement unit labels are liters, inches, weight per volume."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A measurement unit label is as a label that is part of a scalar measurement datum and denotes a unit of measure."@en ;
    ns1:IAO_0000116 "2009-03-16: provenance: a term measurement unit was\\nproposed for OBI (OBI_0000176) , edited by Chris Stoeckert and\\nCristian Cocos, and subsequently moved to IAO where the objective for\\nwhich the original term was defined was satisfied with the definition\\nof this, different, term."@en,
        "2009-03-16: review of this term done during during the OBI workshop winter 2009 and the current definition was considered acceptable for use in OBI. If there is a need to modify this definition please notify OBI."@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Melanie Courtot"@en ;
    rdfs:subClassOf ns1:IAO_0000009 .

ns1:OBI_0000434 a owl:Class ;
    rdfs:label "adding material objective"@en ;
    ns1:IAO_0000111 "adding material objective"^^xsd:string ;
    ns1:IAO_0000112 "creating a mouse infected with LCM virus"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "is the specification of an objective to add a material into a target material. The adding is asymmetric in the sense that the target material largely retains its identity"@en ;
    ns1:IAO_0000117 "BP"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000686 .

ns1:OBI_0000885 a owl:Class ;
    rdfs:label "secondary structure of sequence macromolecule"^^xsd:string ;
    ns1:IAO_0000111 "secondary structure of sequence macromolecule"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000002 ;
    ns1:IAO_0000115 "A quality inhering in a molecule that refers to general three-dimensional form of local segments of biopolymers such as proteins and nucleic acids (DNA/RNA). It does not, however, describe specific atomic positions in three-dimensional space, which are considered to be tertiary structure.\\nSecondary structure was introduced by Kaj Ulrik Linderstrøm-Lang in the 1952 Lane medical lectures at Stanford."^^xsd:string ;
    ns1:IAO_0000116 "2010-01-31: Philippe Rocca-Serra: This is a placeholder to allow work on 'nucleic acid mapping assay' in collaboration with RNAOntology group. Need to liaise with SO"^^xsd:string ;
    ns1:IAO_0000117 "Person: Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "Wikipedia"^^xsd:string ;
    rdfs:subClassOf ns1:PATO_0001241 .

ns1:OBI_0000896 a owl:Class ;
    rdfs:label "secondary structure of RNA molecule"^^xsd:string ;
    ns1:IAO_0000111 "secondary structure of RNA molecule"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 15630685: Single molecule studies of RNA secondary structure: AFM of TYMV viral RNA."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 ""^^xsd:string ;
    ns1:IAO_0000116 "2010-01-31: Philippe Rocca-Serra: This is a placeholder to allow work on 'nucleic acid mapping assay' in collaboration with RNAOntology group. Need to liaise with SO"^^xsd:string ;
    ns1:IAO_0000117 "Person: Philippe Rocca-Serra"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000885 .

ns1:OBI_0002055 a owl:Class ;
    rdfs:label "assay measuring T cell epitope specific biological activity" ;
    ns1:IAO_0000111 "assay measuring T cell epitope specific biological activity" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A T cell epitope recognition assay that detects biological activity."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "any method"^^xsd:string,
        "biological activity"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_1110037 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_1110037 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:IAO_0000030 [ a owl:Restriction ;
                                            owl:onProperty ns1:IAO_0000136 ;
                                            owl:someValuesFrom [ a owl:Restriction ;
                                                    owl:onProperty ns1:OBI_1110060 ;
                                                    owl:someValuesFrom ns1:OBI_1110057 ] ] ) ] ] ) ] .

ns1:OBI_0002256 a owl:Class ;
    rdfs:label "pathologic primary tumor stage for ovary according to AJCC 7th edition" ;
    ns1:IAO_0000111 "pathologic primary tumor stage for ovary according to AJCC 7th edition" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A categorical value specification that is a pathologic finding about one or more characteristics of ovarian cancer following the rules of the TNM AJCC v7 classification system as they pertain to staging of the primary tumor. TNM pathologic primary tumor findings are based on clinical findings supplemented by histopathologic examination of one or more tissue specimens acquired during surgery."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "pT: Pathologic spread ovarian primary tumor (AJCC 7th Edition)"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001930 .

ns1:OBI_0002600 a owl:Class ;
    rdfs:label "collecting specimen with swab" ;
    ns1:IAO_0000111 "collecting specimen with swab" ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A specimen collection process that uses a swab as the collection device. A swab is an absorbent material (e.g. cotton) on a rod (e.g., wooden stick)." ;
    ns1:IAO_0000117 "Chris Stoeckert" ;
    ns1:IAO_0000119 "OBIB" ;
    ns1:IAO_0000233 "https://github.com/obi-ontology/obi/issues/910" ;
    ns1:IAO_0000234 "OBIB" ;
    rdfs:subClassOf ns1:OBI_0000659 .

ns1:GO_0000785 a owl:Class ;
    rdfs:label "chromatin"^^xsd:string ;
    ns1:IAO_0000111 "chromatin"^^xsd:string ;
    ns1:IAO_0000115 "The ordered and organized complex of DNA, protein, and sometimes RNA, that forms the chromosome."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0005575 .

ns1:IAO_0000033 a owl:Class ;
    rdfs:label "directive information entity"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An information content entity whose concretizations indicate to their bearer how to realize them in a process."@en ;
    ns1:IAO_0000116 "2009-03-16: provenance: a term realizable information entity was proposed for OBI (OBI_0000337) , edited by the PlanAndPlannedProcess branch. Original definition was  \"is the specification of a process that can be concretized and realized by an actor\" with alternative term  \"instruction\".It has been subsequently moved to IAO where the objective for which the original term was defined was satisfied with the definitionof this, different, term."@en,
        "2013-05-30 Alan Ruttenberg: What differentiates a directive information entity from an information concretization is that it can have concretizations that are either qualities or realizable entities. The concretizations that are realizable entities are created when an individual chooses to take up the direction, i.e. has the intention to (try to) realize it."@en,
        "8/6/2009 Alan Ruttenberg: Changed label from \"information entity about a realizable\" after discussions at ICBO"@en,
        "Werner pushed back on calling it realizable information entity as it isn't realizable. However this name isn't right either. An example would be a recipe. The realizable entity would be a plan, but the information entity isn't about the plan, it, once concretized, *is* the plan. -Alan"@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Bjoern Peters"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:BFO_0000017 ],
        ns1:IAO_0000030 .

ns1:IAO_0000100 a owl:Class ;
    rdfs:label "data set"@en ;
    ns1:IAO_0000111 "data set"@en ;
    ns1:IAO_0000112 "Intensity values in a CEL file or from multiple CEL files comprise a data set (as opposed to the CEL files themselves)."@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A data item that is an aggregate of other data items of the same type that have something in common. Averages and distributions can be determined for data sets."@en ;
    ns1:IAO_0000116 "2014-05-05: Data sets are aggregates and thus must include two or more data items. We have chosen not to add logical axioms to make this restriction.",
        "2009/10/23 Alan Ruttenberg. The intention is that this term represent collections of like data. So this isn't for, e.g. the whole contents of a cel file, which includes parameters, metadata etc. This is more like java arrays of a certain rather specific type"@en ;
    ns1:IAO_0000117 "person:Allyson Lister"@en,
        "person:Chris Stoeckert"@en ;
    ns1:IAO_0000119 "OBI_0000042"@en,
        "group:OBI"@en ;
    rdfs:subClassOf ns1:IAO_0000027 .

ns1:IAO_0000577 a owl:Class ;
    rdfs:label "centrally registered identifier symbol"@en ;
    ns1:IAO_0000112 "The sentence \"The article has Pubmed ID 12345.\" contains a CRID that has two parts: one part is the CRID symbol, which is '12345'; the other part denotes the CRID registry, which is Pubmed."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A symbol that is part of a CRID and that is sufficient to look up a record from the CRID's registry."@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PERSON: Bill Hogan"@en,
        "PERSON: Bjoern Peters"@en,
        "PERSON: Melanie Courtot"@en ;
    ns1:IAO_0000118 "CRID symbol" ;
    ns1:IAO_0000119 "Original proposal from Bjoern, discussions at IAO calls"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom ns1:IAO_0000578 ],
        ns1:IAO_0000028 .

ns1:OBI_0000427 a owl:Class ;
    rdfs:label "enzyme"@en ;
    ns1:IAO_0000111 "enzyme"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "(protein or rna) or has_part (protein or rna) and\\nhas_function some GO:0003824 (catalytic activity)"@en ;
    ns1:IAO_0000116 "MC: known issue: enzyme doesn't classify under material entity for now as it isn't stated that anything\\nthat has_part some material entity is a material entity. If we add as equivalent classes to material entity has_part some material entity and part_of some material entity  (each one in his own necessary and sufficient block) Pellet in P3 doesn't classify any more."^^xsd:string ;
    ns1:IAO_0000117 "person: Melanie Courtot"^^xsd:string ;
    ns1:IAO_0000119 "GROUP:OBI"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Class ;
                        owl:unionOf ( ns1:CHEBI_33697 ns1:GO_0043234 ns1:PR_000000001 [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000051 ;
                                    owl:someValuesFrom ns1:CHEBI_33697 ] [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000051 ;
                                    owl:someValuesFrom ns1:GO_0043234 ] [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000051 ;
                                    owl:someValuesFrom ns1:PR_000000001 ] ) ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000085 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:allValuesFrom ns1:GO_0003824 ;
                                owl:onProperty ns1:BFO_0000054 ] ] ) ] .

ns1:OBI_0000967 a owl:Class ;
    rdfs:label "container"^^xsd:string ;
    ns1:IAO_0000111 "container"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A device that can be used to restrict the location of material entities over time"^^xsd:string ;
    ns1:IAO_0000116 "03/21/2010: Added to allow classification of children (similar to what we want to do for 'measurement device'. Lookint at what classifies here, we may want to reconsider a contain function assigned to a part of an entity is necessarily also a function of the whole (e.g. is a centrifuge a container because it has test tubes as parts?)"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000968 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000370 ] .

ns1:OBI_0001017 a owl:Class ;
    rdfs:label "single-nucleotide-resolution nucleic acid structure mapping assay using chemical probing" ;
    ns1:IAO_0000111 "single-nucleotide-resolution nucleic acid structure mapping assay using chemical probing" ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A single-nucleotide-resolution nucleic acid structure mapping assay that determines structural information about the RNA species under study using small chemical compounds acting as chemical probes."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "RNAO and OBI"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000870 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000870 [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000055 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0000086 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000052 ;
                                                        owl:someValuesFrom [ a owl:Class ;
                                                                owl:intersectionOf ( ns1:CHEBI_23367 [ a owl:Class ;
                                                                            owl:complementOf ns1:OBI_0000427 ] ) ] ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:CHEBI_23367 [ a owl:Class ;
                                                        owl:complementOf ns1:OBI_0000427 ] ) ] ] ) ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:IAO_0000136 ;
                                owl:someValuesFrom ns1:OBI_0000885 ] ] ) ] .

ns1:OBI_0001234 a owl:Class ;
    rdfs:label "epigenetic modification identification objective"@en ;
    ns1:IAO_0000111 "epigenetic modification identification objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A molecular feature identification objective that aims to detect epigenetic modifications, such as DNA methylation, histone modifications."@en ;
