ns1:OBI_0000910 a owl:Class ;
    rdfs:label "radio immuno assay" ;
    ns1:IAO_0000111 "radio immuno assay" ;
    ns1:IAO_0000112 "To evaluate the specificity of antibody binding to 35S-labeled IA-2(256-760) in comparison with 35S-labeled IA-2IC construct, the mutual inhibition activity of different concentrations of unlabeled IA-2IC and/or IA-2(256-760) fragments were tested. Unlabeled recombinant IA-2(256-760) and/or IA-2IC (0.5-, 1-, 2-, and 4-fold the amount of 35S-labeled protein) were added to each tube and incubated overnight at 4C with patient sera. The following day, after incubation with radiolabeled 35 IA-2(256-760) or 35S IA-2IC proteins, samples were processed with the usual radioimmunoprecipitation assay."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay in which a radioactive labeled antigen or antibody is used to determine the interaction between an antigen and its receptor. This can be used to detect the presence of an antigen of interest in an input sample or determine the specificity of an input antibody."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:REO_0000171 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                                                owl:onProperty ns1:RO_0000053 ;
                                                                owl:someValuesFrom ns1:PATO_0001741 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000053 ;
                                            owl:someValuesFrom ns1:PATO_0001741 ] ) ] ] ) ],
        ns1:OBI_0000070 .

