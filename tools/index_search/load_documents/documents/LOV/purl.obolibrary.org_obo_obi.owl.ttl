ns1:OBI_0000714 a owl:Class ;
    rdfs:label "graph of vertices"^^xsd:string ;
    ns1:IAO_0000111 "graph of vertices"^^xsd:string ;
    ns1:IAO_0000112 "For example, if the nodes are cities, then the edges may have numerical values that correspond to the distances between the cities."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A construct that consists of many nodes connected with edges. The edges represent a relationship between the objects represented by the nodes.  A graph can be equivalently represented as a matrix."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string,
        "Chris Stoeckert"^^xsd:string,
        "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "WEB: http://mitpress.mit.edu/books/FLAOH/cbnhtml/glossary-G.html"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000038 .

ns1:OBI_0000719 a owl:Class ;
    rdfs:label "vaccine preparation"^^xsd:string ;
    ns1:IAO_0000111 "vaccine preparation"^^xsd:string ;
    ns1:IAO_0000112 "The production of B. pertussis vaccine."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "vaccine preparation is a planned  process with specified output a vaccine"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0000720 a owl:Class ;
    rdfs:label "immunologic adjuvant role"^^xsd:string ;
    ns1:IAO_0000111 "immunologic adjuvant role"^^xsd:string ;
    ns1:IAO_0000112 "Adjuvants are pharmacological or immunological agents that modify the effect of other agents (e.g., drugs, vaccines) while having few if any direct effects when given by themselves.   http://en.wikipedia.org/wiki/Adjuvant"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The role a material entity plays when it is co-administered with an immunogen in order to enhance the immune response to the immunogen."^^xsd:string ;
    ns1:IAO_0000116 "11Feb09:Vaccine Ontology Definition: Adjuvant boosts immune response of a vaccine or antigen in the host.  \\nthe role 'adjuvant role' inheres in some 'material entity' and is realized by some 'immune response assay'."^^xsd:string ;
    ns1:IAO_0000117 "GROUP:  Role branch"^^xsd:string ;
    ns1:IAO_0000119 "Vaccine Ontology, Wikipedia, OBI"^^xsd:string ;
    ns1:IAO_0000232 "Renamed from adjuvent role, to be a more specific useage for immunology, tracker https://sourceforge.net/tracker/?func=detail&atid=886178&aid=2887909&group_id=177891"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:GO_0006955 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:OBI_1110092 .

ns1:OBI_0000721 a owl:Class ;
    rdfs:label "glucose tolerance test" ;
    ns1:IAO_0000111 "glucose tolerance test" ;
    ns1:IAO_0000112 "PMID: 19527607"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An assay that measures glucose clearance from blood over time by repeated glucose measurement in blood serum or plasma after the administration of a glucose bolus in-vivo. This assay can be used to evaluate the severity of insulin resistance or the efficiency of glucose clearance."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "NuGO OBI plan branch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
