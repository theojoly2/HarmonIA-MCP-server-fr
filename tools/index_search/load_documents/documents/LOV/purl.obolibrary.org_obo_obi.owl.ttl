ns1:OBI_0000970 a owl:Class ;
    rdfs:label "scalar score from composite inputs"^^xsd:string ;
    ns1:IAO_0000111 "scalar score from composite inputs"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement datum which is the result of combining multiple datum. For example, a mean or summary score. "@en ;
    ns1:IAO_0000116 "JT:  We included this because we wanted to talk about an output from a questionnaire that summarized the answers to the questionnaire, but which was not actually the answer to any single question. "@en ;
    ns1:IAO_0000117 "Person: Jessica Turner"@en ;
    ns1:IAO_0000118 "questionaire score"^^xsd:string ;
    ns1:IAO_0000119 "Person: Jessica Turner"@en ;
    ns1:IAO_0000232 "JZ: can we defined it logically as the output of some data transformation, like aggragate data transformation?"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:IAO_0000004 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0200000 ],
        ns1:IAO_0000032 .

