    ns1:IAO_0000111 "light emission function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A light emission function is an excitation function to excite a material to a specific excitation state that it emits light."@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
