ns1:OBI_0001906 a owl:Class ;
    rdfs:label "cancer cell line"^^xsd:string ;
    ns1:IAO_0000111 "cancer cell line"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
