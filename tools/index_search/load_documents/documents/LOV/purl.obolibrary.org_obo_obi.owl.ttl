ns1:OBI_0001248 a owl:Class ;
    rdfs:label "ChIP-chip assay" ;
    ns1:IAO_0000111 "ChIP-chip assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay in which chromatin is immunoprecipitated and subsequently analyzed using a DNA microarray to identify which parts of DNA are part of the isolated chromatin"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Petesr"^^xsd:string,
        "James Malone"^^xsd:string ;
    ns1:IAO_0000118 "ChIP-on-chip assay"^^xsd:string ;
    ns1:IAO_0000119 "url:http://en.wikipedia.org/wiki/ChIP-on-chip"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001954 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0001954 [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
