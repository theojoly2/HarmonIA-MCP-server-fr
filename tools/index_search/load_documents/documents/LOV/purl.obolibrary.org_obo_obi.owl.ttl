            owl:intersectionOf ( ns1:OBI_0001308 [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0000920 ] ) ] .

ns1:OBI_0001197 a owl:Class ;
    rdfs:label "comparative genome hybridization by array design"@en ;
    ns1:IAO_0000111 "comparative genome hybridization by array design"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design that detects genomic copy number variations using microarray technology."@en ;
    ns1:IAO_0000117 "Person: Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_856 comparative_genome_hybridization_design"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000131 ],
        ns1:OBI_0500000 .

ns1:OBI_0001199 a owl:Class ;
    rdfs:label "in vivo design"@en ;
    ns1:IAO_0000111 "in vivo design"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design that is conducted entirely in a living organism, e.g. a compound treatment in a mouse model."@en ;
    ns1:IAO_0000117 "Person: Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_454 in_vivo_design"@en ;
    rdfs:subClassOf ns1:OBI_0500000 .

ns1:OBI_0001200 a owl:Class ;
    rdfs:label "genotyping by high throughput sequencing design"@en ;
    ns1:IAO_0000111 "genotyping by high throughput sequencing design"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design that classifies an individual or group of individuals on the basis of alleles, haplotypes, SNPs using high througput sequencing techniques."@en ;
    ns1:IAO_0000117 "Person: Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_560 genotyping_design"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001444 .

ns1:OBI_0001202 a owl:Class ;
    rdfs:label "innate behavior design"@en ;
    ns1:IAO_0000111 "innate behavior design"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design in which the innate behavior of the organism is examined, e.g. path finding in bees."@en ;
    ns1:IAO_0000117 "Person: Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_355 innate_behavior_design"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000268 ],
        ns1:OBI_0500000 .

ns1:OBI_0001203 a owl:Class ;
    rdfs:label "detection of specific nucleic acids with complementary probes assay measuring epitope specific transforming growth factor-beta production by T cells" ;
    ns1:IAO_0000111 "detection of specific nucleic acids with complementary probes assay measuring epitope specific transforming growth factor-beta production by T cells" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay of epitope specific transforming growth factor-beta production by T cells that uses a detection of specific nucleic acids with complementary probes assay."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
