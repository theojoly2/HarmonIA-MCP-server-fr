ns1:OBI_0000718 a owl:Class ;
    rdfs:label "pathogen role"^^xsd:string ;
    ns1:IAO_0000111 "pathogen role"^^xsd:string ;
    ns1:IAO_0000112 "Pathogen: An agent of disease. A disease producer. The term pathogen most commonly is used to refer to infectious organisms. These include bacteria (such as staph), viruses (such as HIV), and fungi (such as yeast). Less commonly, pathogen refers to a noninfectious agent of disease such as a chemical.   http://www.medterms.com/script/main/art.asp?articlekey=6383"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "pathogen role is a role which inheres in an organism and realized in the process of disease course in the organism bearing host role caused by the organism bearing pathogen role"^^xsd:string ;
    ns1:IAO_0000117 "GROUP: Role Branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    ns1:IAO_0000232 "6 April 2009:  from the Vaccine Community"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OGMS_0000063 ;
            owl:onProperty ns1:BFO_0000054 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        ns1:BFO_0000023 .

ns1:OBI_0000736 a owl:Class ;
    rdfs:label "single fragment library"^^xsd:string ;
    ns1:IAO_0000111 "single fragment library"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a collection of short tags from DNA fragments, are extracted and covalently linked as single tag constructs"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "fragment library"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000047 .

ns1:OBI_0000737 a owl:Class ;
    rdfs:label "cloning vector"^^xsd:string ;
    ns1:IAO_0000111 "cloning vector"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A cloning vector is an engineered material that is used as an input material for a recombinant vector cloning process to carry inserted nucleic acids. It contains an origin of replication for a specific destination host organism, encodes for a selectable gene product and contains a cloning site."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0000094 ],
        ns1:OBI_0000047,
        ns1:OBI_1110108 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:OBI_0000411 ] ) ] .

ns1:OBI_0000794 a owl:Class ;
    rdfs:label "transcription factor binding site"^^xsd:string ;
    ns1:IAO_0000111 "transcription factor binding site"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000002 ;
    ns1:IAO_0000119 "SO:0000235"^^xsd:string ;
    rdfs:comment "PLace_holder for sequence ontology term"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000905 .

ns1:OBI_0000810 a owl:Class ;
    rdfs:label "informed consent process"^^xsd:string ;
    ns1:IAO_0000111 "informed consent process"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A planned process in which a person or their legal representative is informed about key facts about potential risks and benefits of a process and makes a documented decision as to whether the person in question will participate."^^xsd:string ;
    ns1:IAO_0000116 "09/28/2009 Alan Ruttenberg: This is made a subclass of the higher level processual entity in BFO because I don't want to take a stand on whether it is a process aggregate. Analogous to the situation with Material entity."^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "http://clinicaltrials.gov/ct2/info/glossary#informed"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0000087 ;
                    owl:someValuesFrom ns1:OBI_0000202 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:NCBITaxon_9606 ],
        ns1:OBI_0000011 .

ns1:OBI_0000826 a owl:Class ;
    rdfs:label "treatment portion of study execution"^^xsd:string ;
    ns1:IAO_0000111 "treatment portion of study execution"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A planned process, part of a study design execution, during which the treatment of subjects is ongoing"^^xsd:string ;
    ns1:IAO_0000116 "09/28/2009 Alan Ruttenberg. Needed because we have to have a process to scope blinding over"^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom ns1:OBI_0000471 ],
        ns1:OBI_0000011 .

ns1:OBI_0000827 a owl:Class ;
    rdfs:label "pill"^^xsd:string ;
    ns1:IAO_0000111 "pill"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A dose of medicine or placebo in the form of a small pellet."^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "http://www.golovchenko.org/cgi-bin/wnsearch?q=pill#2n"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000047 .

ns1:OBI_0000833 a owl:ObjectProperty ;
    rdfs:label "objective_achieved_by"^^xsd:string ;
    ns1:IAO_0000111 "objective_achieved_by"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "This relation obtains between an objective specification and a planned process when the criteria specified in the objective specification are met at the end of the planned process."^^xsd:string ;
    ns1:IAO_0000117 "OBI" ;
    ns1:IAO_0000119 "OBI" ;
    rdfs:domain ns1:IAO_0000005 ;
    rdfs:range ns1:OBI_0000011 .

ns1:OBI_0000838 a owl:Class ;
    rdfs:label "material maintenance"^^xsd:string ;
    ns1:IAO_0000111 "material maintenance"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a process with that achieves the objective to maintain some or all of the characteristics of an input material over time"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000011 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000806 ] .

ns1:OBI_0000842 a owl:Class ;
    rdfs:label "informing subject of study arm"^^xsd:string ;
    ns1:IAO_0000111 "informing subject of study arm"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A process in which the subject is made aware of which study arm they are participating in, for example whether they are receiving a placebo or a treatment with an investigational compound."^^xsd:string ;
    ns1:IAO_0000116 "09/28/2009 Alan Ruttenberg. This and the class informing-investigator-of-study-arm are defined in order to solve the question of how to represent single and double blind experiments. To represent the aspect of blinding pertaining to subjects (happens in single and double blinding) we say that that the study execution doesn't include any processes of this sort"^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000050 ;
                        owl:someValuesFrom ns1:OBI_0000810 ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000057 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:OBI_0000097 ] ] ) ],
        ns1:OBI_0000011 .

ns1:OBI_0000857 a owl:Class ;
    rdfs:label "complementary nucleotide probe role"^^xsd:string ;
    ns1:IAO_0000111 "complementary nucleotide probe role"^^xsd:string ;
    ns1:IAO_0000112 "A primer in a PCR reaction. A probe on an Affymetrix chip."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
