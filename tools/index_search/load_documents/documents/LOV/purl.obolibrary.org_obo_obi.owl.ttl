    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A clinical tumor stage group according to AJCC 7th edition indicating cancers with increasing tumor or nodal extent but less than in Stage III and with differing characteristics from IIB and IIC."^^xsd:string ;
