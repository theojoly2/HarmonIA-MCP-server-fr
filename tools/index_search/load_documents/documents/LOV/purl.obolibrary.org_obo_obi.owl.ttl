ns1:GO_0097278 a owl:Class ;
    rdfs:label "complement-dependent cytotoxicity"^^xsd:string ;
    ns1:IAO_0000111 "complement-dependent cytotoxicity"^^xsd:string ;
    ns1:IAO_0000115 "Lysis of a cell resulting from triggering of the complement cascade. An example can be seen with complement activation and subsequent lysis of a bacterial cell as a result of the binding of IgM to the cell surface followed by the binding of complement proteins to that antibody."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001906 .

