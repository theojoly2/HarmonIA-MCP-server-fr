    ns1:IAO_0000111 "solid support function"^^xsd:string ;
    ns1:IAO_0000112 "Taped, glued, pinned, dried or molecularly bonded to a solid support"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A solid support function is a function of a device on which an entity is kept in a defined position and prevented in its movement"@en ;
    ns1:IAO_0000117 "Daniel Schober"^^xsd:string,
