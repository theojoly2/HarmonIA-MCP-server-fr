ns1:IAO_0000613 a owl:Class ;
    rdfs:label "case report section"@en ;
    ns1:IAO_0000111 "case report section"@en ;
    ns1:IAO_0000112 "The section labelled 'case report' in a typical scientific journal article, e.g. in Taglia et al. Acta Myol. 2012 Dec; 31(3): 201–203. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3631801/)"@en ;
    ns1:IAO_0000115 "A part of a document about the medical history of a specific patient as it relates to the topic of the document."@en ;
