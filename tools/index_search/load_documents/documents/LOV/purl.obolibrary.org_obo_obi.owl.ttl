        ns1:OBI_0001632,
        ns1:OBI_0001977 .

ns1:OBI_0002175 a owl:Class ;
    rdfs:label "ATP bioluminescence assay" ;
    ns1:IAO_0000111 "ATP bioluminescence assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An analyte assay that detects ATP concentration through light intensity when luciferase catalyzes the oxidation of luciferin in the presence of ATP, magnesium ions, and molecular oxygen."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "ATP quantitation assay"^^xsd:string,
        "cell viability ATP quantitation assay"^^xsd:string ;
    ns1:IAO_0000119 "ECO"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000275 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:CHEBI_15422 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:CHEBI_15422 ] ) ],
        ns1:OBI_0000443 .

ns1:OBI_0002176 a owl:Class ;
    rdfs:label "electrophysiology assay" ;
    ns1:IAO_0000111 "electrophysiology assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that measures the electrical properties of biological cells or tissues. Typically, this assay will generate measurements of voltage changes or electric current (or other associated variables such as impedence or capacitance)."^^xsd:string ;
    ns1:IAO_0000116 "Note that electrophysiological manipulations also exist which involve processes that alter the electrophysiological properties of cells and tissues."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Electrophysiology"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 .

ns1:OBI_0002178 a owl:Class ;
    rdfs:label "whole-cell patch clamp assay" ;
    ns1:IAO_0000111 "whole-cell patch clamp assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A patch-clamp assay where the electrode is left in place on the cell, as in cell-attached recordings, but the membrane patch has been perforated, providing access from the interior of the pipette to the intracellular space of the cell. Measurements made with this technique involve recording currents through multiple channels simultaneously, over the membrane of the entire cell."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000119 "ECO:0006015"^^xsd:string,
        "url:https://en.wikipedia.org/wiki/Patch_clamp#Whole-cell_recording_or_whole-cell_patch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0001080 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0001080 ] ) ],
        ns1:OBI_0002177 .

ns1:OBI_0002179 a owl:Class ;
    rdfs:label "cell-attached patch clamp assay" ;
    ns1:IAO_0000111 "cell-attached patch clamp assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A patch-clamp assay where the electrode is left in place on the cell, and the membrane patch has been left intact been perforated. This maintains the separation of the interior of the pipette to the intracellular space of the cell. Measurements made with this technique involve recording currents through multiple channels simultaneously, over the membrane of the entire cell."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Patch_clamp#Cell-attached_patch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0001080 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0001080 ] ) ],
        ns1:OBI_0002177 .

ns1:OBI_0002180 a owl:Class ;
    rdfs:label "inside-out patch clamp assay" ;
    ns1:IAO_0000111 "inside-out patch clamp assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A patch-clamp assay where a patch of the membrane is attached to the patch pipette, detached from the rest of the cell, and the cytosolic surface of the membrane is exposed to the external media, or bath. This provides the experimenter has access to the intracellular surface of the membrane via the bath and can manipulate the environment at the intracellular surface of single ion channels. For example, channels that are activated by intracellular ligands can then be studied through a range of ligand concentrations."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000119 "url:http://www.leica-microsystems.com/science-lab/the-patch-clamp-technique/"^^xsd:string,
        "url:https://en.wikipedia.org/wiki/Patch_clamp#Inside-out_patch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0001080 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0001080 ] ) ],
        ns1:OBI_0002177 .

ns1:OBI_0002181 a owl:Class ;
    rdfs:label "outside-out patch clamp assay" ;
    ns1:IAO_0000111 "outside-out patch clamp assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A patch-clamp assay where a patch of the membrane is attached to the patch pipette. In this configuration, the external surface of the cell membrane is exposed as the outside of the membrane patch relative to the patch electrode. An outside-out patch starts with a gigaohm seal in a whole-cell recording configuration. The electrode is slowly withdrawn from the cell, until a fragment of membrane bulges away from the cell, which detaches and reforms as a convex membrane on the end of the electrode, with the original external surface of the membrane facing outward from the electrode. This provides the experimenter with access to the extracellular surface of the membrane via the bath and can manipulate the environment at the extracellular surface of single ion channels."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000119 "url:http://www.leica-microsystems.com/science-lab/the-patch-clamp-technique/"^^xsd:string,
        "url:https://en.wikipedia.org/wiki/Patch_clamp#Outside-out_patch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0001080 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0001080 ] ) ],
        ns1:OBI_0002177 .

ns1:OBI_0002183 a owl:Class ;
    rdfs:label "two electrode voltage clamp assay" ;
    ns1:IAO_0000111 "two electrode voltage clamp assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The two electrode voltage clamp (TEVC) method utilizes two low-resistance pipettes, one sensing voltage and the other injecting current. The microelectrodes are filled with conductive solution and inserted into the cell to artificially control membrane potential. The membrane acts as a dielectric as well as a resistor, while the fluids on either side of the membrane function as capacitors.[9] The microelectrodes compare the membrane potential against a command voltage, giving an accurate reproduction of the currents flowing across the membrane. Current readings can be used to analyze the electrical response of the cell to different applications. This technique is mainly used in the Oocyte preparation."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000118 "TEVC"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Voltage_clamp#Two-electrode_voltage_clamp_using_microelectrodes"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0001129 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0001129 ] ) ],
        ns1:OBI_0002182 .

ns1:OBI_0002184 a owl:Class ;
    rdfs:label "cut open oocyte voltage clamp assay" ;
    ns1:IAO_0000111 "cut open oocyte voltage clamp assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The cut-open oocyte Vaseline gap (COVG) voltage-clamp technique is designed to solve weaknesses in the two elextrode voltage clamp by maximizing the benefits of the Xenopus oocyte expression system by improving on clamp speed, signal-to-noise ratio, and ability to effectively perfuse the oocyte. In this way, it was possible to combine the most popular transient expression system, and the associated benefits of molecular cloning and site-directed mutagenesis, with the superior voltage-clamp properties of cut-open cell techniques."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000118 "COVG"^^xsd:string ;
    ns1:IAO_0000119 "PMID:9711615"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0001129 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0001129 ] ) ],
        ns1:OBI_0002182 .

ns1:OBI_0002185 a owl:Class ;
    rdfs:label "current clamp assay" ;
    ns1:IAO_0000111 "current clamp assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The current clamp technique records the membrane potential by injecting current into a cell through the recording electrode. Unlike in the voltage clamp mode, where the membrane potential is held at a level determined by the experimenter, in \"current clamp\" mode the membrane potential is free to vary, and the amplifier records whatever voltage the cell generates on its own or as a result of stimulation. This technique is used to study how a cell responds when electric current enters a cell; this is important for instance for understanding how neurons respond to neurotransmitters that act by opening membrane ion channels."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Electrophysiology#Current_clamp"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000447 .

ns1:OBI_0002186 a owl:Class ;
    rdfs:label "electroencephalography" ;
    ns1:IAO_0000111 "electroencephalography" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An extracellular electrophysiology assay where electrodes are mounted outside the brain (either on the surface of the scalp on onto the brain surface itself during surgery) to measure the electrical field over the external surface."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000118 "EEG"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000454 .

ns1:OBI_0002187 a owl:Class ;
    rdfs:label "single-unit recording" ;
    ns1:IAO_0000111 "single-unit recording" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An extracellular electrophysiology assay where a single microelectrode is placed in close proximity to a single neuron to measure voltage and current changes over time. This is the technicque used by Hubel and Wiesel to measure firing properties of primary visual cortex neurons in the 1950s in their original Nobel-prize winning study. A classic, old technique."^^xsd:string ;
    ns1:IAO_0000116 "Can be used on any cell, not just neurons."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000119 "url:http://www.thieme.com/media/samples/pubid-80418214.pdf"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0000816 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0000816 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0001508 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( ns1:CL_0000000 [ a owl:Restriction ;
                                                                owl:onProperty ns1:BFO_0000051 ;
                                                                owl:someValuesFrom ns1:GO_0097458 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Class ;
                                            owl:intersectionOf ( ns1:CL_0000000 [ a owl:Restriction ;
                                                        owl:onProperty ns1:BFO_0000051 ;
                                                        owl:someValuesFrom ns1:GO_0097458 ] ) ] [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        ns1:OBI_0000454,
        ns1:OBI_0001977 .

ns1:OBI_0002188 a owl:Class ;
    rdfs:label "multi-unit recording" ;
    ns1:IAO_0000111 "multi-unit recording" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An extracellular electrophysiology assay where a collection of microelectrodes (often in an 'array' configuration) is placed into neural tissue to measure the distribution of voltage and current changes for a population of cells over time."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000454 .

ns1:OBI_0002189 a owl:Class ;
    rdfs:label "local field potential recording" ;
    ns1:IAO_0000111 "local field potential recording" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An extracellular electrophysiology assay where a microelectrode is placed in the extracellular space of brain tissue to measure action potential and compared to an electrode either outside or inside that tissue."^^xsd:string ;
    ns1:IAO_0000117 "Gully Burns"^^xsd:string ;
    ns1:IAO_0000119 "doi:10.1007/978-1-4614-7320-6_723-1"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
