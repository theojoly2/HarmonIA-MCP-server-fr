                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:OBI_0100026 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        ns1:OBI_0000070 .

ns1:OBI_0000701 a owl:Class ;
    rdfs:label "self-organizing map"^^xsd:string ;
    ns1:IAO_0000111 "self-organizing map"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A self-organizing map (SOM) is an artificial neural network with objective class discovery that uses a neighborhood function to preserve the topological properties of a dataset to produce low-dimensional (typically 2) discretized representation of the training data set. A set of artificial neurons learn to map points in an input space to coordinates in an output space. The input space can have different dimensions and topology from the output space, and the SOM will attempt to preserve these."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string,
        "Ryan Brinkman"^^xsd:string ;
    ns1:IAO_0000118 "SOM"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Ryan Brinkman"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:OBI_0000648 ns1:OBI_0000741 ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200178 ] ) ],
        ns1:OBI_0200175 .

ns1:OBI_0000706 a owl:Class ;
    rdfs:label "SOLiD sequencing assay" ;
    ns1:IAO_0000111 "SOLiD sequencing assay" ;
    ns1:IAO_0000112 "PMID: 19119315. High-resolution analysis of the 5'-end transcriptome using a next generation DNA sequencer. Hashimoto S, Qu W, Ahsan B, Ogoshi K, Sasaki A, Nakatani Y, Lee Y, Ogawa M, Ametani A, Suzuki Y, Sugano S, Lee CC, Nutter RC, Morishita S, Matsushima K. PLoS One. 2009;4(1):e4108."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A DNA sequencing by ligation assay that identifies sequence information using primers to hybridize to the P1 adapter sequence within the library template, fluorescently labeled di-base probes to compete for ligation to the sequencing primer, multiple cycles of ligation, detection and cleavage to determine the eventual read length, following a series of ligation cycles, the extension product is removed and the template is reset with a primer complementary to the n-1 position for a second round of ligation cycles."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/ABI_Solid_Sequencing"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:BFO_0000034 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0000696 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0000696 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:OBI_0000722 ns1:OBI_0000736 ns1:PR_000023089 ) ] ],
        ns1:OBI_0000723 .

ns1:OBI_0000709 a owl:Class ;
    rdfs:label "yeast artificial chromosome vector"^^xsd:string ;
    ns1:IAO_0000111 "yeast artificial chromosome vector"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a double-stranded DNA that was engineered to contain a yeast origin of replication, encodes for a selectable gene product, contains a cloning site, and has yeast telomerase sequences"^^xsd:string ;
    ns1:IAO_0000116 "this should be a child of 'chromosome' if we import that from another source"^^xsd:string ;
    ns1:IAO_0000117 "Kevin Clancy, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "YAC"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:OBI_0000411 ],
        ns1:CHEBI_4705,
        ns1:OBI_0000737 .

ns1:OBI_0000712 a owl:Class ;
    rdfs:label "pathogen challenge"^^xsd:string ;
    ns1:IAO_0000111 "pathogen challenge"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A pathogen challenge is the administration of a live pathogenic organism to a host"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
