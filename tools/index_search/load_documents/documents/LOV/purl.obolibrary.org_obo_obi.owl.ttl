ns1:OBI_0002232 a owl:Class ;
    rdfs:label "pathologic primary tumor stage for lung according to AJCC 7th edition" ;
    ns1:IAO_0000111 "pathologic primary tumor stage for lung according to AJCC 7th edition" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A categorical value specification that is a pathologic finding about one or more characteristics of lung cancer following the rules of the TNM American Joint Committee on Cancer (AJCC) version 7 classification system as they pertain to staging of the primary tumor. TNM pathologic primary tumor findings are based on clinical findings supplemented by histopathologic examination of one or more tissue specimens acquired during surgery."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "pT: Pathologic spread lung primary tumor (AJCC 7th Edition)"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001930 .

ns1:OBI_0200175 a owl:Class ;
    rdfs:label "class discovery data transformation"@en ;
    ns1:IAO_0000111 "class discovery data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A class discovery data transformation (sometimes called unsupervised classification) is a data transformation that has objective class discovery."@en ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000118 "clustering data transformation"^^xsd:string,
        "unsupervised classification data transformation"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:OBI_0000648 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0200178 ] ) ] .

ns1:OBI_0400065 a owl:Class ;
    rdfs:label "light source"@en ;
    ns1:IAO_0000111 "light source"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A light source is an optical subsystem that provides light for use in a distant area using a delivery system (e.g., fiber optics). Light sources may include one of a variety of lamps (e.g., xenon, halogen, mercury). Most light sources are operated from line power, but some may be powered from batteries. They are mostly used in endoscopic, microscopic, and other examination and/or in surgical procedures. The light source is part of the optical subsystem. In a flow cytometer the light source directs high intensity light at particles at the interrogation point. The light source in a flow cytometer is usually a laser."@en ;
    ns1:IAO_0000117 "Elizabeth M. Goralczyk"@en,
        "John Quinn"@en,
        "Olga Tchuvatkina"@en ;
    ns1:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000367 ],
        ns1:OBI_0001032 .

ns1:OGMS_0000015 a owl:Class ;
    rdfs:label "clinical history" ;
    ns1:IAO_0000111 "clinical history" ;
    ns1:IAO_0000115 "A series of statements representing health-relevant qualities of a patient and of a patient's family."@en ;
    ns1:IAO_0000412 ns1:ogms.owl ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:RO_0001025 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "located in"@en ;
    ns1:IAO_0000111 "located in"@en ;
    ns1:IAO_0000112 "my brain is located in my head"@en,
        "this rat is located in this cage"@en ;
    ns1:IAO_0000115 "a relation between two independent continuants, the target and the location, in which the target is entirely within the location"@en ;
    ns1:IAO_0000116 "Location as a relation between instances: The primitive instance-level relation c located_in r at t reflects the fact that each continuant is at any given time associated with exactly one spatial region, namely its exact location. Following we can use this relation to define a further instance-level location relation - not between a continuant and the region which it exactly occupies, but rather between one continuant and another. c is located in c1, in this sense, whenever the spatial region occupied by c is part_of the spatial region occupied by c1.    Note that this relation comprehends both the relation of exact location between one continuant and another which obtains when r and r1 are identical (for example, when a portion of fluid exactly fills a cavity), as well as those sorts of inexact location relations which obtain, for example, between brain and head or between ovum and uterus"@en,
        "Most location relations will only hold at certain times, but this is difficult to specify in OWL. See https://code.google.com/p/obo-relations/wiki/ROAndTime"@en ;
    ns1:IAO_0000118 "located_in"@en ;
    ns1:RO_0001900 ns1:RO_0001901 ;
    dc:source "http://www.obofoundry.org/ro/#OBO_REL:located_in" ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0001015 ] .

ns1:RO_0001901 a owl:NamedIndividual ;
    rdfs:label "axiom holds for all times"@en ;
    ns1:IAO_0000115 "\\n\\n## Elucidation\\n\\nThis is used when the statement/axiom is assumed to hold true 'eternally'\\n\\n## How to interpret (informal)\\n\\nFirst the \"atemporal\" FOL is derived from the OWL using the standard\\ninterpretation. This axiom is temporalized by embedding the axiom\\nwithin a for-all-times quantified sentence. The t argument is added to\\nall instantiation predicates and predicates that use this relation.\\n\\n## Example\\n\\n    Class: nucleus\\n    SubClassOf: part_of some cell\\n\\n    forall t :\\n      forall n :\\n        instance_of(n,Nucleus,t)\\n         implies\\n        exists c :\\n          instance_of(c,Cell,t)\\n          part_of(n,c,t)\\n\\n## Notes\\n\\nThis interpretation is *not* the same as an at-all-times relation\\n\\n" .

ns1:SO_0000001 a owl:Class ;
    rdfs:label "region"^^xsd:string ;
    ns1:IAO_0000111 "region"^^xsd:string ;
    ns1:IAO_0000115 "A sequence_feature with an extent greater than zero. A nucleotide region is composed of bases and a polypeptide region is composed of amino acids."^^xsd:string ;
    ns1:IAO_0000118 "primary structure of sequence macromolecule"^^xsd:string,
        "sequence"^^xsd:string ;
    ns1:IAO_0000412 ns1:so.owl ;
    rdfs:subClassOf ns1:BFO_0000031 .

ns1:IAO_0000002 a ns1:IAO_0000078,
        owl:NamedIndividual ;
    rdfs:label "example to be eventually removed"@en .

ns1:IAO_0000098 a owl:Class ;
    rdfs:label "data format specification"@en ;
    ns1:IAO_0000111 "data format specification"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data format specification is the information content borne by the document published defining the specification.\\nExample: The ISO document specifying what encompasses an XML document; The instructions in a XSD file"@en ;
    ns1:IAO_0000116 "2009-03-16: provenance: term imported from OBI_0000187, which had original definition \"A data format specification is a plan which organizes\\ninformation. Example: The ISO document specifying what encompasses an\\nXML document; The instructions in a XSD file\""@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en,
        "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en,
        "OBI_0000187"@en ;
    rdfs:subClassOf ns1:IAO_0000033 .

ns1:IAO_0000116 a owl:AnnotationProperty ;
    rdfs:label "editor note"@en ;
    ns1:IAO_0000111 "editor note"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An administrative note intended for its editor. It may not be included in the publication version of the ontology, so it should contain nothing necessary for end users to understand the ontology."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "GROUP:OBI:<http://purl.obfoundry.org/obo/obi>"@en ;
    rdfs:isDefinedBy ns1:iao.owl .

