ns1:OBI_0001706 a owl:Class ;
    rdfs:label "assay measuring B cell epitope specific biological activity" ;
    ns1:IAO_0000111 "assay measuring B cell epitope specific biological activity" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A B cell epitope recognition assay that detects biological activity."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "any method"^^xsd:string,
        "biological activity"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_1110127 ;
