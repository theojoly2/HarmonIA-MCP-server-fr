            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000372 ],
        ns1:OBI_0000832,
        ns1:OBI_0000932,
        ns1:OBI_0002089 .

ns1:OBI_0000444 a owl:Class ;
    rdfs:label "target of material addition role"@en ;
    ns1:IAO_0000111 "target of material addition role"^^xsd:string ;
    ns1:IAO_0000112 "peritoneum of an animal receiving an interperitoneal injection; solution in a tube receiving additional material; location of absorbed material following a dermal application."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "target of material addition role is a role realized by an entity into which a material is added in a material addition process"^^xsd:string ;
    ns1:IAO_0000116 "From Branch discussion with BP, AR, MC -- there is a need for the recipient to interact with the administered material.  for example, a tooth receiving a filling was not considered to be a target role."^^xsd:string ;
    ns1:IAO_0000117 "GROUP:  Role Branch"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
