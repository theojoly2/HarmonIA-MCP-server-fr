                    owl:intersectionOf ( ns1:OBI_0000219 [ a owl:Restriction ;
                                owl:onProperty ns1:IAO_0000136 ;
                                owl:someValuesFrom ns1:GO_0007049 ] ) ] ],
        ns1:OBI_0500000 .

ns1:OBI_0001410 a owl:Class ;
    rdfs:label "translation profiling design"@en ;
    ns1:IAO_0000111 "translation profiling design"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design in which surface-bound, translationally competent ribosome complexes are used to generate a translation profile for mRNA, where mRNA may be a single molecular species, or a combination of species, including complex mixtures such as those found in the set of mRNAs isolated from a cell or tissue. One or more components of the surface-bound ribosome complex may be labeled at specific positions to permit analysis of multiple or single molecules for determination of ribosomal conformational changes and translation kinetics. Translation profiles are used as the basis for comparison of an mRNA or set of mRNA species. The translation profile can be used to determine such characteristics as kinetics of initiation, kinetic of elongation, identity of the polypeptide product, and the like. Analysis of translation profiles may be used to determine differential gene expression, optimization of mRNA sequences for expression, screening drug candidates for an effect on translation."@en ;
    ns1:IAO_0000117 "Person: Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "Group: ArrayExpress production team"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000131 ],
        ns1:OBI_0500000 .

