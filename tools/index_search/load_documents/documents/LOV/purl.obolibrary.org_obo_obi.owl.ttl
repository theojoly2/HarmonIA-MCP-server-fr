ns1:OBI_0000340 a owl:Class ;
    rdfs:label "obsolete_documenting"@en ;
    ns1:IAO_0000111 "obsolete_documenting"^^xsd:string ;
    ns1:IAO_0000112 "Recording the current temperature in a laboratory notebook. Writing a journal article. Updating a patient record in a database."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000116 "6/11/9: Edited at workshop. Should go into IAO. We need to be able identify a child form of information artifact which corresponds to something enduring (not brain like). This used to be restricted to physical document or digital entity as the output, but that excludes e.g. an audio cassette tape"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "wikipedia http://en.wikipedia.org/wiki/Documenting"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000228 ;
    ns1:IAO_0100001 "IAO_0000572"^^xsd:string ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000343 a owl:Class ;
    rdfs:label "inductive reasoning"@en ;
    ns1:IAO_0000111 "inductive reasoning"^^xsd:string ;
    ns1:IAO_0000112 "Based on the observation that all lung cancer patients treated with aspirin in our clinical trial survived longer than the control group, we conclude by inductive reasining that aspirin has a therapeutic effect on lung cancer."@en ;
    ns1:IAO_0000114 ns1:IAO_0000428 ;
    ns1:IAO_0000115 "a interpreting data that is used to ascribe properties or relations to types based on an observation instance (i.e., on a number of observations or experiences); or to formulate laws based on limited observations of recurring phenomenal patterns."@en ;
    ns1:IAO_0000116 "BP: 10/22/122: After changing the parent class to drawing a conclusion *based on data* it is no longer clear that this class is needed; minimally it needs a better definition to distinguish it. \\n\\nProposal is to obsolete. \\n\\n" ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "wikipedia: http://en.wikipedia.org/wiki/Inductive_reasoning"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000338 .

ns1:OBI_0000355 a owl:Class ;
    rdfs:label "hypothesis driven investigation"@en ;
    ns1:IAO_0000111 "hypothesis driven investigation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "is an investigation with the goal to test one or more hypothesis"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0000066 .

ns1:OBI_0000356 a owl:Class ;
    rdfs:label "hypothesis generating investigation"@en ;
    ns1:IAO_0000111 "hypothesis generating investigation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "is an investigation in which data is generated and analyzed with the purpose of generating new hypothesis"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0000066 .

ns1:OBI_0000365 a owl:ObjectProperty ;
    rdfs:label "obsolete_results_from"^^xsd:string ;
