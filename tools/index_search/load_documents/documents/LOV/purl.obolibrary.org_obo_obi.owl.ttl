ns1:RO_0000092 a owl:ObjectProperty ;
    rdfs:label "disposition of"@en ;
    rdfs:subPropertyOf ns1:RO_0000052 ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0000091 ] .

ns1:RO_0001001 a owl:ObjectProperty ;
    rdfs:label "derives into"@en ;
    ns1:IAO_0000112 "this parent cell derives into this cell (cell division)"@en,
        "this parent nucleus derives into this nucleus (nuclear division)"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a relation between two distinct material entities, the old entity and the new entity, in which the new entity begins to exist when the old entity ceases to exist, and the new entity inherits the significant portion of the matter of the old entity"@en ;
    ns1:IAO_0000116 "This is a very general relation. More specific relations are preferred when applicable, such as 'directly develops into'. To avoid making statements about a future that may not come to pass, it is often better to use the backward-looking 'derives from' rather than the forward-looking 'derives into'."@en ;
    ns1:IAO_0000118 "derives_into"@en ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0001000 ] .

ns1:RO_0002002 a owl:ObjectProperty ;
    rdfs:label "has 2D boundary"@en ;
    ns1:IAO_0000112 "my body has 2D boundary the surface of my skin"@en ;
    ns1:IAO_0000115 "a relation between a material entity and a 2D immaterial entity (the boundary), in which the boundary delimits the material entity"@en ;
    ns1:IAO_0000116 "A 2D boundary may have holes and gaps, but it must be a single connected entity, not an aggregate of several disconnected parts."@en,
        "Although the boundary is two-dimensional, it exists in three-dimensional space and thus has a 3D shape."@en ;
    ns1:IAO_0000118 "has boundary"@en,
        "has_2D_boundary"@en ;
    ns1:RO_0001900 ns1:RO_0001901 ;
    rdfs:domain ns1:BFO_0000040 ;
    rdfs:range ns1:BFO_0000141 ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0002000 ] .

ns1:RO_0002219 a owl:ObjectProperty ;
    rdfs:label "surrounded by"@en ;
    ns1:IAO_0000111 "surrounded by"^^xsd:string ;
    ns1:IAO_0000115 "x surrounded_by y if and only if x is adjacent to y and for every region r that is adjacent to x, r overlaps y" ;
    ns1:IAO_0000412 ns1:ro.owl ;
    rdfs:subPropertyOf ns1:RO_0002220 .

ns1:RO_0002222 a owl:ObjectProperty ;
    rdfs:label "temporal relation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000116 "move to BFO?" ;
    ns1:IAO_0000119 "Allen" ;
    rdfs:comment "A relation that holds between two occurrents. This is a grouping relation that collects together all the Allen relations." ;
    rdfs:range ns1:BFO_0000003 .

