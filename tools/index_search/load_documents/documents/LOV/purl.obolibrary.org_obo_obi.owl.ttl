            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0000341 ],
        ns1:OBI_0000680,
        ns1:OBI_0000953,
        ns1:OBI_0001479 .

ns1:OBI_1110002 a owl:Class ;
