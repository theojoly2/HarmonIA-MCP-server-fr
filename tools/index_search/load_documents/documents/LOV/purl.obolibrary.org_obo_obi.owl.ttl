    ns1:IAO_0000111 "venereal disease research laboratory test" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An analyte assay that is meant to detect general antibodies that react with substances that are produced by cellular damage caused by Treponema pallidum indicating a syphilis infection. VDRL tests require a microscope and can be done on cerebrospinal fluid as well as blood."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string,
