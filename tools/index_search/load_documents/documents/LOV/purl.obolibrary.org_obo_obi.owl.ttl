    ns1:IAO_0000111 "cell lysate MHC binding assay measuring binding of a MHC:ligand complex" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A MHC binding qualitative binding to ligand assay using MHC in a cell lysate."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "lysate MHC"^^xsd:string,
        "qualitative binding"^^xsd:string ;
