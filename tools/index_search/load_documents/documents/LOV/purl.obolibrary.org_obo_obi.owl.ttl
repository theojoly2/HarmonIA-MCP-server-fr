ns1:OBI_0002555 a owl:Class ;
    rdfs:label "age group inclusion criterion"@en ;
    ns1:IAO_0000111 "age group inclusion criterion"@en ;
    ns1:IAO_0000112 "\"18-33 years old\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states an age bracket which, if met, makes an entity suitable for a given task or participation in a given process." ;
    ns1:IAO_0000117 "Mathias Brochhausen" ;
    ns1:IAO_0000233 "#839" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0002556 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0002557 ] ) ],
        ns1:OBI_0500027 .

ns1:OBI_0002558 a owl:Class ;
    rdfs:label "use of medication inclusion criterion"@en ;
    ns1:IAO_0000111 "use of medication inclusion criterion"@en ;
    ns1:IAO_0000112 "\"received at least 2 days of vancomycin\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states a a set of medications, which, if used by an entity, makes that entity suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    ns1:IAO_0000233 "#840"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002559 a owl:Class ;
    rdfs:label "hospital patient inclusion criterion"@en ;
    ns1:IAO_0000111 "hospital patient inclusion criterion"@en ;
    ns1:IAO_0000112 "\"included hospital patients\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion defines that a human being has to be a hospital patient to be suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002560 a owl:Class ;
    rdfs:label "family status inclusion criterion"@en ;
    ns1:IAO_0000111 "family status inclusion criterion"@en ;
    ns1:IAO_0000112 "\"included married and unmarried patients\", \"included divorced individuals\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states one or more family statuses, which, if met, makes a human being suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002561 a owl:Class ;
    rdfs:label "sex inclusion criterion"@en ;
    ns1:IAO_0000111 "sex inclusion criterion"@en ;
    ns1:IAO_0000112 "\"included males and females\", \"included male patients\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states one or more sexes which, if met, makes an entity suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002562 a owl:Class ;
    rdfs:label "country of residence inclusion criteria"@en ;
    ns1:IAO_0000111 "country of residence inclusion criteria"@en ;
    ns1:IAO_0000112 "\"include US residents\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criterion that defines and states one or more countries of residence which, if met, makes a human being suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002563 a owl:Class ;
    rdfs:label "ethnicity inclusion criterion"@en ;
    ns1:IAO_0000111 "ethnicity inclusion criterion"@en ;
    ns1:IAO_0000112 "\"include only Hispanic individuals\""@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An inclusion criteria that defines and states one or more ethnicities which, if met, makes an entity suitable for a given task or participation in a given process."@en ;
    ns1:IAO_0000117 "Mathias Brochhausen"@en ;
    rdfs:subClassOf ns1:OBI_0500027 .

ns1:OBI_0002564 a owl:Class ;
    rdfs:label "histopathology assay" ;
    ns1:IAO_0000111 "histopathology assay" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A histological assay that is intended to check for the presence or level of a specific disease."^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0600020 .

ns1:OBI_0002565 a owl:Class ;
    rdfs:label "adapter-sequence trimming" ;
    ns1:IAO_0000111 "adapter-sequence trimming" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A data transformation in which adapter sequences at the end of a molecular sequence are cut (removed)."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0002579 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000973 ns1:OBI_0002578 ) ] ],
        ns1:OBI_0002585 .

ns1:OBI_0002567 a owl:Class ;
    rdfs:label "sequence alignment" ;
    ns1:IAO_0000111 "sequence alignment" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A data transformation in which one or more sequences (reads) are positioned on a reference sequence template (often a reference set of genes), according to the genetic base-pairing paradigm."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000973 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0002580 ],
        ns1:OBI_0200187 .

ns1:OBI_0002568 a owl:Class ;
    rdfs:label "sequence data feature count tabulation" ;
    ns1:IAO_0000111 "sequence data feature count tabulation" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The counting of features (typically, genes) within aligned sequence data, and organization of these counts into one or more tables."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0002582 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0002580 ],
        ns1:OBI_0200187 .

ns1:OBI_0002569 a owl:Class ;
    rdfs:label "trimmed sequence data" ;
    ns1:IAO_0000111 "trimmed sequence data" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The results of a data transformation of sequence data in which (e.g., low quality) read bases are removed, to achieve some specific objective."^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000973 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000973 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom ns1:OBI_0002585 ] ) ] .

ns1:OBI_0002570 a owl:Class ;
    rdfs:label "nCounter Mouse miRNA Expression array" ;
    ns1:IAO_0000111 "nCounter Mouse miRNA Expression array" ;
    ns1:IAO_0000112 "Kolbert, Christopher P., et al. \"Multi-platform analysis of microRNA expression measurements in RNA from fresh frozen and FFPE tissues.\" PloS one 8.1 (2013): e52517. PMID:23382819" ;
    ns1:IAO_0000114 ns1:IAO_0000428 ;
    ns1:IAO_0000115 "A mouse array which is manufacutred by NanoString Technologies. Built upon color-coded molecular barcodes technology, the array profiles miRNA with increased specificity and sensitivty than microarrays." ;
    ns1:IAO_0000117 "PERSON: Venkat Malladi, Chris Stoeckert, Jie Zheng, Alan Ruttenberg.  Mark A. Miller added based on http://purl.obolibrary.org/obo/OBI_0002013" ;
    ns1:IAO_0000119 "https://www.nanostring.com/products/mirna-assays/mirna-panels" ;
    dc:date "2018-05-11T14:04:41+00:00"^^xsd:dateTime ;
    dc:source "ENCODE project" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:OBI_0001860 ;
            owl:onProperty ns1:OBI_0000304 ],
        ns1:OBI_0001865 .

ns1:OBI_0002571 a owl:Class ;
    rdfs:label "polyA-selected RNA sequencing assay" ;
    ns1:IAO_0000111 "polyA-selected RNA sequencing assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An RNA-seq assay to study transcriptomes through the enrichment of polyadenylated transcripts or removal of ribosomal RNA prior to high-throughput sequencing."^^xsd:string ;
    ns1:IAO_0000117 "Jason Hilton"^^xsd:string,
        "Mark A. Miller"^^xsd:string ;
    ns1:IAO_0000118 "mRNA-seq"^^xsd:string ;
    ns1:IAO_0000119 "url:https://bmcgenomics.biomedcentral.com/articles/10.1186/1471-2164-15-419"^^xsd:string ;
    ns1:IAO_0000234 "ENCODE"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001271 .

ns1:OBI_0002572 a owl:Class ;
    rdfs:label "polyA-depleted RNA sequencing assay" ;
    ns1:IAO_0000111 "polyA-depleted RNA sequencing assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An RNA-seq assay to study non-polyadenylated transcripts, such as, but not exclusive to unspliced and circular isoforms, through the depletion of polyadenylated transcripts prior to high-throughput sequencing."^^xsd:string ;
    ns1:IAO_0000117 "Jason Hilton"^^xsd:string,
        "Mark A. Miller"^^xsd:string ;
    ns1:IAO_0000118 "polyA-depleted RNA-seq"^^xsd:string ;
    ns1:IAO_0000119 "url:http://journals.plos.org/plosone/article?id=10.1371/journal.pone.0030733"^^xsd:string,
        "url:http://www.tandfonline.com/doi/full/10.1080/15476286.2015.1110676"^^xsd:string ;
    ns1:IAO_0000234 "ENCODE"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001271 .

ns1:OBI_0002573 a owl:Class ;
    rdfs:label "polyA depleted RNA extract"^^xsd:string ;
    ns1:IAO_0000111 "polyA depleted RNA extract"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A RNA extract that is the output of an extraction process in which RNA molecules lacking poly A tails at thier 3' ends are purified."^^xsd:string ;
    ns1:IAO_0000117 "Mark A. Miller, based on http://purl.obolibrary.org/obo/OBI_0000869"^^xsd:string,
        "PERSON: Chris Stoeckert"^^xsd:string,
        "PERSON: Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "UPenn Group"^^xsd:string ;
    dc:date "2018-05-11T16:35:11+00:00"^^xsd:dateTime ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0002574 ],
        ns1:OBI_0000880 .

ns1:OBI_0002575 a owl:Class ;
    rdfs:label "isoform sequencing" ;
    ns1:IAO_0000111 "isoform sequencing" ;
    ns1:IAO_0000112 "Novel transcript forms were assessed by isoform sequencing."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A method for sequencing isoforms by enriching a cDNA library for full-length reads spanning entire transcript isoforms."^^xsd:string ;
    ns1:IAO_0000118 "ISO-seq"^^xsd:string ;
    ns1:IAO_0000119 "url:http://www.pacb.com/blog/intro-to-iso-seq-method-full-leng/"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001271 .

ns1:OBI_0002581 a owl:Class ;
    rdfs:label "merged aligned sequence data" ;
    ns1:IAO_0000111 "merged aligned sequence data" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The results of a data transformation of sequence data in which files containing aligned sequence data are merged together"^^xsd:string ;
    ns1:IAO_0000117 "Dan Berrios"^^xsd:string ;
    ns1:IAO_0000119 "Dan Berrios"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0002566 ],
        ns1:OBI_0000973 .

ns1:OBI_0002583 a owl:Class ;
    rdfs:label "DNA methylation profiling data" ;
    ns1:IAO_0000111 "DNA methylation profiling data" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The results of a DNA methylation profiling assay"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0000634 ],
        ns1:OBI_0000973 .

ns1:OBI_0002584 a owl:Class ;
    rdfs:label "differential expression analysis data" ;
    ns1:IAO_0000111 "differential expression analysis data" ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The results of a differential expression analysis."^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000100 .

ns1:OBI_0002586 a owl:Class ;
    rdfs:label "digital acquisition card" ;
    ns1:IAO_0000111 "digital acquisition card" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The digital acquisition card acts as the interface between the computer and a measurement device via the computer bus. It converts the signal generated by a measurement device (output from device) to a digital signal via an analog-to-digital converter, ADC. It also converts a digital signal to an analog signal via a digital-to-analog converter, DAC. This analog signal (e.g., stimulus) is fed to a measurement device (input to device)." ;
    ns1:IAO_0000117 "Mark A. Miller"^^xsd:string ;
    ns1:IAO_0000118 "DAQ device",
        "digital acquisition and digital generation card" ;
    dc:date "2018-08-07T13:47:12+00:00"^^xsd:dateTime ;
    rdfs:seeAlso "https://github.com/obi-ontology/obi/issues/927" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000393 ],
        ns1:OBI_0000968 .

ns1:OBI_0002588 a owl:Class ;
    rdfs:label "supervised machine learning" ;
    ns1:IAO_0000111 "supervised machine learning" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A machine learning process using a function that maps an input to an output based on example input-output pairs. It infers a function from labeled training data consisting of a set of training examples."^^xsd:string ;
    ns1:IAO_0000117 "Mark A. Miller" ;
    ns1:IAO_0000119 "https://en.wikipedia.org/wiki/Supervised_learning"^^xsd:string ;
    dc:contributor "https://github.com/TrisSN" ;
    rdfs:subClassOf ns1:OBI_0002587 .

ns1:OBI_0002589 a owl:Class ;
    rdfs:label "unsupervised machine learning" ;
    ns1:IAO_0000111 "unsupervised machine learning" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A machine learning process that infers a function describing the structure of \"unlabeled\" data (i.e. data that has not been classified or categorized)."^^xsd:string ;
    ns1:IAO_0000117 "Mark A. Miller" ;
    ns1:IAO_0000119 "https://en.wikipedia.org/wiki/Unsupervised_learning"^^xsd:string ;
    dc:contributor "https://github.com/TrisSN" ;
    rdfs:subClassOf ns1:OBI_0002587 .

ns1:OBI_0002591 a owl:Class ;
    rdfs:label "colocalization identification design" ;
    ns1:IAO_0000111 "colocalization identification design" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A molecular interaction identification design that investigates the co-occurence and correlation of two or more molecules."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Colocalization"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002590 .

ns1:OBI_0002592 a owl:Class ;
    rdfs:label "genetic interaction identification design" ;
    ns1:IAO_0000111 "genetic interaction identification design" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A molecular interaction identification design that investigates a phenotype that is the result of two or more genetic perturbations, and is not explained by the individual genetic perturbations alone."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "MI:0208"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0000750 [ a owl:Restriction ;
                                owl:onProperty ns1:IAO_0000136 ;
                                owl:someValuesFrom ns1:OBI_0001404 ] ) ] ],
        ns1:OBI_0002590 .

ns1:OBI_0002593 a owl:Class ;
    rdfs:label "functional association identification design" ;
    ns1:IAO_0000111 "functional association identification design" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A molecular interaction identification design that investigates a relationship that is the result of intermediate steps between two or more molecules that are not necessarily in direct contact with each other."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "MI:2286"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002590 .

ns1:OBI_0002595 a owl:Class ;
    rdfs:label "enzymatic reaction identification design" ;
    ns1:IAO_0000111 "enzymatic reaction identification design" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A direct interaction identification design that investigations a biological reaction on a molecule which has been triggered by an enzyme."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "MI:0414"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002594 .

ns1:OBI_0002596 a owl:Class ;
    rdfs:label "self interaction identification design" ;
    ns1:IAO_0000111 "self interaction identification design" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A molecular interaction identification design that investigates intra-molecular interactions between two or more regions of a single molecule."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "MI:1126"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002590 .

ns1:OBI_0002597 a owl:Class ;
    rdfs:label "chromosome conformation capture sequencing assay" ;
    ns1:IAO_0000111 "chromosome conformation capture sequencing assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A chromosome conformation capture-on-chip assay quantitates the products with multiplexed high-throughput sequencing."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "3C-seq assay"^^xsd:string ;
    ns1:IAO_0000119 "PMID:23411633"^^xsd:string ;
    ns1:IAO_0000233 "https://github.com/obi-ontology/obi/issues/939"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
