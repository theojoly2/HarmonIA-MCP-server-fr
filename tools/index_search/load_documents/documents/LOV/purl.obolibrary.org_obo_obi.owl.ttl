ns1:OBI_0002241 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pT3 (lung)" ;
    ns1:IAO_0000111 "pT3 (lung)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for lung according to AJCC 7th edition indicating that the tumor is more than 7 cm or one that directly invades any of: parietal pleura, chest wall (including superior sulcus tumors), diaphragm, phrenic nerve, mediastinal pleura, parietal pericardiu or the tumor is in the main bronchus less than 2 cm distal to the carina but without  involvement of the carina or there is associated atelectasis or obstructive pneumonitis of the entire lung or there is separate tumor nodule(s) in the same lobe as the primary."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002242 a ns1:OBI_0002232,
        owl:NamedIndividual ;
    rdfs:label "pT4 (lung)" ;
    ns1:IAO_0000111 "pT4 (lung)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for lung according to AJCC 7th edition indicating that the tumor of any size that invades any of the following: mediastinum, heart, great vessels, trachea, recurrent laryngeal nerve, esophagus, vertebral body, carina or there is separate tumor nodule(s) in a different ipsilateral lobe to that of the primary."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

