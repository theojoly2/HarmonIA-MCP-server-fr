    rdfs:label "number of PCR cycles during library construction"@en ;
    ns1:IAO_0000111 "number of PCR cycles during library construction"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A data item that is the number of PCR cycles used during the construction of a sequencing library."@en ;
    ns1:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en ;
