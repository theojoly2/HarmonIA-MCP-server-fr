ns1:OBI_0002161 a owl:Class ;
    rdfs:label "systematic evolution of ligands by exponential enrichment assay" ;
    ns1:IAO_0000111 "systematic evolution of ligands by exponential enrichment assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A binding assay that identifies protein-binding sites on nucleic acids by selecting high-affinity target ligands from a randomized pool. The process is repeated in rounds, then the bound nucleic acids are separated from the unbound nucleic acids and amplified by PCR._"^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000118 "SELEX"^^xsd:string ;
    ns1:IAO_0000119 "PMID:21720957"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001146 .

ns1:OBI_0002195 a owl:Class ;
    rdfs:label "microtome blade"@en ;
    ns1:IAO_0000111 "microtome blade" ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A device that is the part of a microtome used to slice specimens to a desired thickness." ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis" ;
    ns1:IAO_0000119 "https://en.wikipedia.org/wiki/Microtome" ;
    ns1:IAO_0000234 "NCI BBRB" ;
    rdfs:subClassOf ns1:OBI_0000968 .

