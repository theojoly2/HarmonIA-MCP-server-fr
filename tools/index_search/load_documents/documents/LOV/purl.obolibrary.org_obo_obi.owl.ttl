ns1:OBI_0400135 a owl:Class ;
    rdfs:label "image cytometer"@en ;
    ns1:IAO_0000111 "image cytometer"@en ;
    ns1:IAO_0000112 "The most common current application of image cytometry is for DNA analysis, followed by quantitation of immunohistochemical staining."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
