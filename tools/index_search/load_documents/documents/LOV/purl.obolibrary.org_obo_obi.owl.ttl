ns1:OBI_0001305 a owl:Class ;
    rdfs:label "genotype information"@en ;
    ns1:IAO_0000111 "genotype information"@en ;
    ns1:IAO_0000112 "Genotype information can be: Mus musculus wild type (in this case the genetic population background information is Mus musculus), C57BL/6J  Hnf1a+/- (in this case, C57BL/6J is the genetic population background information and Hnf1a+/- is the allele information"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a genetic characteristics information that is about the genetic material of an organism and minimally includes information about the genetic background and can in addition contain information about specific alleles, genetic modifications, etc."@en ;
    ns1:IAO_0000116 "discussed on San Diego OBI workshop, March 2011"@en ;
    ns1:IAO_0000117 "Group: OBI group"@en ;
    ns1:IAO_0000119 "Group: OBI group"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0001225 ] [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom ns1:OBI_0001364 ] ) ],
        ns1:OBI_0001404 .

ns1:OBI_0001404 a owl:Class ;
    rdfs:label "genetic characteristics information"@en ;
    ns1:IAO_0000111 "genetic characteristics information"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a data item that is about genetic material including polymorphisms, disease alleles, and haplotypes."@en ;
    ns1:IAO_0000117 "Person: Chris Stoeckert, Jie Zheng"@en ;
    ns1:IAO_0000119 "MO_66 IndividualGeneticCharacteristics"@en ;
    ns1:IAO_0000232 "MO definition:\\nThe genotype of the individual organism from which the biomaterial was derived. Individual genetic characteristics include polymorphisms, disease alleles, and haplotypes.\\n\\nexamples in ArrayExpress\\nwild_type\\nMutaMouse (CD2F1 mice with lambda-gt10LacZ integration)\\nAlfpCre; SNF5 flox/knockout\\np53 knock out\\nC57Bl/6 gp130lox/lox MLC2vCRE/+\\nfer-15; fem-1\\ndf/df\\npat1-114/pat1-114 ade6-M210/ade6-M216 h+/h+ (cells are diploid)\\n"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:SO_0000001 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000058 ;
                                owl:someValuesFrom [ a owl:Restriction ;
                                        owl:onProperty ns1:RO_0000052 ;
                                        owl:someValuesFrom [ a owl:Class ;
                                                owl:intersectionOf ( ns1:CHEBI_33696 [ a owl:Restriction ;
                                                            owl:onProperty ns1:BFO_0000050 ;
                                                            owl:someValuesFrom ns1:OBI_0100026 ] ) ] ] ] ) ] ],
        ns1:IAO_0000027 .

