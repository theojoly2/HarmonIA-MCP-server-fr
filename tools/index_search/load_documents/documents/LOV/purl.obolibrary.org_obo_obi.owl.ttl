ns1:OBI_0001868 a owl:Class ;
    rdfs:label "genetic material" ;
    ns1:IAO_0000111 "genetic material" ;
    ns1:IAO_0000114 ns1:IAO_0000428 ;
    ns1:IAO_0000115 "A nucleic acid macromolecule that is part of a cell or virion and is inherited from an immediate ancestor, or incorporated in a manner that it has the disposition to be replicated and inherited by descendants." ;
    ns1:IAO_0000116 "MHB 3-22-13: Discussions are ongoing about the label of this class, given consideration of a second class that covers nucleic acid parts of cells or virions that participate in gene expression processes as a template for expression or a direct effector of expression of some other genetic element (e.g. an siRNA), but are not necessarily heritable by progeny or inherited from ancestors.  So things like transiently transfected plasmids and siRNAs would qualify as instances of this second class, but not of 'genetic material' as defined here.\\n\\nAlso, OBI needs to import a class representing virions for an axiom on genetic material (part_of some (cell or virion)." ;
    ns1:IAO_0000118 "genomic material",
        "hereditary genetic material" ;
    ns1:IAO_0000119 "OBI developer calls, March 4 2013 and March 11 2013" ;
    rdfs:comment "Naturally occurring or experimentally incorporated nucleic acids that meet these criteria can qualify as genetic/genomic material.\\n\\nQualifying examples include: (1) inherited chromosomal DNA in germ cells, stem cells, fully differentiated cells, or cell line cells, or the DNA/RNA content of a virion; (2) natural replicons exchanged through horizontal gene transfer mechanisms such as bacterial conjugation, which are capable of replication and inheritance by progeny; (3) a chromosomally integrated  gene targeting DNA construct transfected into a cell; or (4) a stable extra-chromosomal replicon delivered into cells, such as a plasmid in bacterial host with ori allowing indefinite propagation.  \\n\\nNon-qualifying examples include a transiently transfected plasmid or siRNA oligo (as these are not able to be replicated and inherited by progeny cells).\\n" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:CL_0000000 ns1:NCBITaxon_10239 ) ] ],
        ns1:CHEBI_33696 .

ns1:OBI_0001871 a owl:Class ;
    rdfs:label "LSRFortessa X-20"@en ;
    ns1:IAO_0000111 "LSRFortessa X-20"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A flow cytometer analyzer manifactured by Becton ans Dickinson. Can be configured with up to 5 lasers, 488nm, 532 or 561 nm, 640 nm, 405 nm, 355 nm for measuring up to 20 parameters simultaneously. " ;
    ns1:IAO_0000117 "Anna Maria Masci" ;
    ns1:IAO_0000119 "http://www.bdbiosciences.com/instruments/lsrx20/index.jsp?WT.srch=1&gclid=CJjJ8JTR5LoCFXBo7AodZycAbg" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:OBI_0001321 ;
            owl:onProperty ns1:OBI_0000304 ],
        ns1:OBI_0400008 .

ns1:OBI_0001873 a owl:Class ;
    rdfs:label "number of errors"@en ;
    ns1:IAO_0000111 "number of errors"@en ;
    ns1:IAO_0000112 "Gigascience. 2012 Dec 27;1(1):18. doi: 10.1186/2047-217X-1-18.\\nPMID: 23587118. see table2"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a data item that is the number of times that a given process failed, as an integer"@en ;
    ns1:IAO_0000117 "Alejandra Gonzalez-Beltran",
        "Philippe Rocca-Serra" ;
