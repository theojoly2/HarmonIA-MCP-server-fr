ns1:OBI_0001913 a owl:Class ;
    rdfs:label "computation run time"@en ;
    ns1:IAO_0000111 "computation run time"@en ;
    ns1:IAO_0000112 "Gigascience. 2012 Dec 27;1(1):18. doi: 10.1186/2047-217X-1-18.\\nPMID: 23587118. \\n\\nSee Table 4"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "computation run time is a time measurement datum which corresponds the time expressed in second, minute, hour necessary for a computer program to complete a process execution, for example genome assembly. It is an important metrics as it indicates the resource occupancy and computer program efficiency.\\n"@en ;
    ns1:IAO_0000117 "Alejandra Gonzalez-Beltran"@en,
        "Philippe Rocca-Serra"@en ;
    ns1:IAO_0000118 "computation run time datum"@en ;
    ns1:IAO_0000119 "PRS,AGB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000413 ;
            owl:someValuesFrom ns1:OBI_0200000 ],
        ns1:IAO_0000416 .

