    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The Edinburgh Handedness Inventory is a set of questions used to assess the dominance of a person's right or left hand in everyday activities. "@en ;
    ns1:IAO_0000117 "PERSON:Alan Ruttenberg"^^xsd:string,
        "PERSON:Jessica Turner"^^xsd:string ;
