ns1:OBI_0001667 a owl:Class ;
    rdfs:label "purified MHC competitive binding assay measuring equilibrium dissociation constant [KD] of a MHC:ligand complex approximated by IC50 using fluorescence detection" ;
    ns1:IAO_0000111 "purified MHC competitive binding assay measuring equilibrium dissociation constant [KD] of a MHC:ligand complex approximated by IC50 using fluorescence detection" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A purified MHC ligand binding equilibrium dissociation constant (KD) determination assay that uses fluorescence detection to detect loss of binding of a known reference ligand due to competition by the ligand under investigation and provides IC50 values determined under assay conditions where the IC50 approximates a KD value. "^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "dissociation constant KD (~IC50)"^^xsd:string,
        "nM"^^xsd:string,
        "purified MHC/competitive/fluorescence"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0001501 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0001485 [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000051 ;
                                owl:someValuesFrom ns1:GO_0042611 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:hasValue ns1:UO_0000065 ;
                    owl:onProperty ns1:IAO_0000039 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:OBI_0001955 ] ) ] ],
        ns1:OBI_0001537 .

ns1:OBI_0001668 a owl:Class ;
    rdfs:label "split-ubiquitin assay" ;
    ns1:IAO_0000111 "split-ubiquitin assay" ;
    ns1:IAO_0000112 "Split-ubiquitin two-hybrid assay to analyze protein-protein interactions at the endosome: application to Saccharomyces cerevisiae Bro1 interacting with ESCRT complexes, the Doa4 ubiquitin hydrolase, and the Rsp5 ubiquitin ligase. PMID:17513562"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A binding assay that screens membrane soluble proteins by fusion of two integral membrane proteins (bait and prey) to two different ubiquitin moieties. One moiety is also fused to a transcription factor (TF) that can be cleaved off by ubiquitin specific proteases. Upon bait and prey interaction, Nub and Cub-moieties assemble, reconstituting the split-ubiquitin. The reconstituted split-ubiquitin molecule is recognized by ubiquitin specific proteases, which cleave off the reporter protein, allowing it to induce the transcription of reporter genes."^^xsd:string ;
    ns1:IAO_0000117 "Marcus Chibucos"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Two-hybrid_screening"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000027 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0019904 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0001398 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0001151 ],
        ns1:OBI_0001146 .

ns1:OBI_0001669 a owl:Class ;
    rdfs:label "far-Western blot assay" ;
    ns1:IAO_0000111 "far-Western blot assay" ;
    ns1:IAO_0000112 "Studying protein-protein interactions via blot overlay or Far Western blot. PMID:15064457"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An assay that measures protein-protein interactions by separating target proteins on an SDS-PAGE gel, transfering them to a solid substrate, hybridizing with a protein probe and visualizing bound proteins using a probe-directed antibody. This is a adaptation on the western blot assay."^^xsd:string ;
    ns1:IAO_0000117 "Marcus Chibucos"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "PMID:18079728"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0019904 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000027 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:GO_0043234 ],
        ns1:OBI_0001146 .

ns1:OBI_0001670 a owl:Class ;
    rdfs:label "RNA protection assay" ;
    ns1:IAO_0000111 "RNA protection assay" ;
    ns1:IAO_0000112 "Absolute concentrations of mRNA for type I and type VI collagen in the canine meniscus in normal and ACL-deficient knee joints obtained by RNase protection assay. PMID:11518275"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An assay that determines the presence and estimates abundance of transcript species by first creating an homo or heteroduplex by adding a specific, complementary sequence to the sequence of interest and then exposing the mixture of ribonuclease, which will degrade only single stranded molecules. A detection step will reveal if the sample contained a sequence of interest."^^xsd:string ;
    ns1:IAO_0000117 "Marcus Chibucos"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "RNAse protection assay"^^xsd:string,
        "RPA"^^xsd:string ;
    ns1:IAO_0000119 "PMID:16491611"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0010467 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000880 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000027 ],
        ns1:OBI_0000070 .

ns1:OBI_0001671 a owl:Class ;
    rdfs:label "electrophoretic mobility shift assay" ;
    ns1:IAO_0000111 "electrophoretic mobility shift assay" ;
    ns1:IAO_0000112 "Electrophoretic mobility shift assay reveals a novel recognition sequence for Setaria italica NAC protein. PMID:21918373"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An assay that measures information about Protein-DNA or Protein-RNA interactions using gel electrophoresis and relying on the fact the molecular interactions will cause the heterodimer to be retarded on the gel when compared to controls corresponding to protein extract alone and protein extract + neutral nucleic acid."^^xsd:string ;
    ns1:IAO_0000117 "Marcus Chibucos"^^xsd:string,
        "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "EMSA"^^xsd:string,
        "band shift assay"^^xsd:string,
        "gel mobility shift assay"^^xsd:string,
        "gel retardation assay"^^xsd:string,
        "gel shift assay"^^xsd:string ;
    ns1:IAO_0000119 "PMID:6269071"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000880 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000027 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0043565 ] ],
        ns1:OBI_0001146 .

