ns1:OBI_0000785 a owl:Class ;
    rdfs:label "study design controlled variable"@en ;
    ns1:IAO_0000111 "controlled variable specification"^^xsd:string ;
    ns1:IAO_0000112 "In a study in which gene expression is measured in patients between 8 month to 4 years old that have mild or severe malaria and in which the hypothesis is that gene expression in that age group is a function of disease status, age is a controlled variable." ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "Controlled variable specification  is a part of a study design. They are the entities that could vary, but are kept constant to prevent their influence on the effect of the independent variable on the dependent."@en ;
    ns1:IAO_0000116 "In the Philly 2013 workshop the label was chosen to distinguish it from \"controlled variable\" as used in statistical modelling",
        "2/2/2009 Original definition: Controlled variables are also important to identify in experiments. They are the variables that are kept constant to prevent their influence on the effect of the independent variable on the dependent. Every experiment has a controlling variable, and it is necessary to not change it, or the results of the experiment won't be valid"@en ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"^^xsd:string,
        "PERSON: Bjoern Peters"^^xsd:string,
        "PERSON: Chris Stoeckert"^^xsd:string ;
    ns1:IAO_0000118 "controlled variable" ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Control_variable"^^xsd:string ;
    ns1:IAO_0000232 "2009-03-16: work has been done on this term during during the OBI workshop winter 2009 and the current definition was considered acceptable for use in OBI. If there is a need to modify thisdefinition please notify OBI."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom ns1:OBI_0500000 ],
        ns1:IAO_0000033 .

ns1:OBI_0000790 a owl:Class ;
    rdfs:label "recombinant BAC cloning"^^xsd:string ;
    ns1:IAO_0000111 "recombinant BAC cloning"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Recombinant BAC cloning is a  process with the objective to insert genetic material into an F plasmid based bacterial artificial chromosome for future replication of the inserted material"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Bacterial_artificial_chromosome"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0600064 .

ns1:OBI_0000793 a owl:Class ;
    rdfs:label "double blind study execution"^^xsd:string ;
    ns1:IAO_0000111 "double blind study execution"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A double blind study execution is defined as any study execution in which neither the subjects nor the investigators are informed of which study arm the subjects are part of during the portion of the trial when the subjects are being treated"^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "http://clinicaltrials.gov/ct2/info/glossary#double"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000822 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000826 [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:complementOf [ a owl:Class ;
                                        owl:unionOf ( ns1:OBI_0000804 ns1:OBI_0000842 ) ] ] ;
                        owl:onProperty ns1:BFO_0000051 ] ) ] .

ns1:OBI_0000795 a owl:Class ;
    rdfs:label "glucometer"^^xsd:string ;
    ns1:IAO_0000111 "glucometer"^^xsd:string ;
    ns1:IAO_0000112 "Diabetic patients use glucometers to determine their glucose levels"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A measurement device with the function to measure and record the level/amount of glucose in a blood sample"^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Frank Gibson"^^xsd:string,
        "PERSON:Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000118 "glucose meter"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Glucose_meter"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000797 a owl:Class ;
    rdfs:label "obsolete_primary structure of protein"^^xsd:string ;
    ns1:IAO_0000111 "obsolete_primary structure of protein"^^xsd:string ;
    ns1:IAO_0000112 "SIINFEKL' is the primary structure of a peptide "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "The primary structure of a protein that is completely defined by the set of its amino acid residue parts and the linear order induced by the peptide bonds that hold them together"^^xsd:string ;
    ns1:IAO_0000117 "Person:Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000228 ;
    rdfs:comment "replaced by SO_0000104 polypeptide"^^xsd:string ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000799 a owl:Class ;
    rdfs:label "recombinant phage cloning"^^xsd:string ;
    ns1:IAO_0000111 "recombinant phage cloning"^^xsd:string ;
    ns1:IAO_0000112 "Insert selection by BamHI methyltransferase protection in P1 phage-based cloning"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Recombinant phage cloning is the process of using a phage plus some insert nucleic acid for the purposes of amplification of the insert material achieved by phage assembly in vitro."^^xsd:string ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000119 "http://www.ncbi.nlm.nih.gov/books/bv.fcgi?rid=mcb.section.1611"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0600064 .

ns1:OBI_0000801 a owl:Class ;
    rdfs:label "spike train datum"^^xsd:string ;
    ns1:IAO_0000111 "spike train datum"^^xsd:string ;
    ns1:IAO_0000112 "Measurement of temporal regularity of spike train responses in auditory nerve fibers of the green treefrog"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A measurement datum which represents information about an ordered series of action potentials in an organism's CNS measured over time."^^xsd:string ;
    ns1:IAO_0000116 "needs more work to see exactly what the data set looks like - HP"^^xsd:string ;
    ns1:IAO_0000117 "Helen Parkinson, Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000118 "spike train measurement"^^xsd:string ;
    ns1:IAO_0000119 "Jessica Turner, NIF"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000109 .

ns1:OBI_0000802 a owl:Class ;
    rdfs:label "prothrombin time assay" ;
    ns1:IAO_0000111 "prothrombin time assay" ;
    ns1:IAO_0000112 "PMID:19696660#The prothrombin time (PT) was quantitatively determined using RecombiPlasTin (Instrumentation Laboratory Company, Lexington, Massachusetts, USA)."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that measures the prothrombin ratio, which is the prothrombin time for a patient, divided by the result for control plasma. Most commonly the test is preformed using blood plasma. Blood is drawn into a test tube containing liquid citrate, which acts as an anticoagulant. An excess of calcium is added to enable the blood to clot again.Tissue factor (also known as factor III or thromboplastin) is added, and the time the sample takes to clot is measured optically as the prothrombin time, which is compared to a control sample."^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "url:http://en.wikipedia.org/wiki/Prothrombin_time@2009/10/06"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0007596 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000032 ],
        ns1:OBI_0000070 .

ns1:OBI_0000805 a owl:Class ;
    rdfs:label "antithrombin-III berichrome assay" ;
    ns1:IAO_0000111 "antithrombin-III berichrome assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An antithrombin-III (AT-III) assay in which exogenous bovine thrombin and heparin are added to test plasma to form a thrombin-heparin-AT complex. The residual thrombin not bound then hydrolyzes the p-nitroalanine substrate to produce a yellow color, which is read at 405 nm. The intensity of color produced is inversely proportional to the AT present. A calibration is done with standard human plasma reagent and results for a given specimen are reported as a percentage relative to the standard"^^xsd:string ;
    ns1:IAO_0000118 "AT-III assay"^^xsd:string ;
    ns1:IAO_0000119 "url:http://www.clinchem.org/cgi/content/full/43/9/1783@2009/08/06"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom ns1:IAO_0000032 ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000057 ;
                        owl:someValuesFrom ns1:OBI_0000815 ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns1:OBI_0000299 ] ) ],
        ns1:OBI_0000787 .

ns1:OBI_0000807 a owl:Class ;
    rdfs:label "presentation of stimulus"^^xsd:string ;
    ns1:IAO_0000111 "presentation of stimulus"^^xsd:string ;
    ns1:IAO_0000112 "The presentation of a flashing light to a monkey during reward training"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a planned process in which an organism is exposed to some stimulus with the intent to invoke an action"^^xsd:string ;
    ns1:IAO_0000117 "Helen Parkinson, Jessica Turner, Dirk Derom"^^xsd:string ;
    ns1:IAO_0000118 "stimulation of organism"^^xsd:string ;
    ns1:IAO_0000119 "Helen Parkinson, Jessica Turner, Dirk Derom"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:OBI_0100026 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:OBI_0000097 ] ) ] ],
        ns1:OBI_0000011 .

ns1:OBI_0000808 a owl:Class ;
    rdfs:label "spectrolyse heparin antifactor-Xa assay" ;
    ns1:IAO_0000111 "spectrolyse heparin antifactor-Xa assay" ;
    ns1:IAO_0000112 "PMID:19696660#Antifactor-Xa (anti-Xa) was determined using spectrolyse heparin (Xa) (Trinity Biotech plc, Bray, County Wicklow, Ireland)."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that quantitatively measures heparin in human plasma using Factor Xa and Antithrombin III in excess, where the rate of Factor Xa inhibition is directly proportional to the heparin concentration. The residual Factor Xa activity, measured with a Factor Xa-specific chromogenic substrate, is inversely proportional to the heparin concentration."^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "url:http://www.kordia.nl/en/product/hemostasis/specialty_kits__reagens/598/spectrolyse_heparin_anti_xa@2009/08/06"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0007596 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000032 ],
        ns1:OBI_0000070 .

ns1:OBI_0000812 a owl:Class ;
    rdfs:label "measuring neural activity in the caudate nucleus assay" ;
    ns1:IAO_0000111 "measuring neural activity in the caudate nucleus assay" ;
    ns1:IAO_0000112 "An SU micro-electrode was used to measure neural activity in the form of spike trains in the caudate nucleus of monkeys in response to a flashing light stimulus"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that measures neural activity in the caudate nucleus"^^xsd:string ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000119 "Dirk Derom, OBI"^^xsd:string,
        "Jessica Turner, NIF"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000454 .

ns1:OBI_0000813 a owl:Class ;
    rdfs:label "to be treated with active ingredient role"^^xsd:string ;
    ns1:IAO_0000111 "to be treated with active ingredient role"^^xsd:string ;
    ns1:IAO_0000112 "Role of a patient in a group treated with an active substance in a clinical trial"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A study subject role which begins to exist when a subject is assigned to be one of those who will receive active ingredient, and is realized in a study execution in which they receive the active ingredient"^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000097 .

ns1:OBI_0000814 a owl:Class ;
    rdfs:label "guar gum"^^xsd:string ;
    ns1:IAO_0000111 "guar gum"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Guar gum, also called guaran, is a galactomannan. It is primarily the ground endosperm of guar beans. The guar seeds are dehusked, milled and screened to obtain the guar gum.[1] It is typically produced as a free flowing, pale, off-white colored, coarse to fine ground powder."^^xsd:string ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Guar_gum"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:OBI_0000817 a owl:Class ;
    rdfs:label "fucoidan"^^xsd:string ;
    ns1:IAO_0000111 "fucoidan"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Fucoidan is a sulfated polysaccharide (MW: average 20,000) found mainly in various species of brown seaweed such as kombu, limu moui,bladderwrack, wakame, mozuku, and hijiki (variant forms of fucoidan have also been found in animal species, including the sea cucumber)."^^xsd:string ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Fucoidan"^^xsd:string ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:OBI_0000819 a owl:Class ;
    rdfs:label "anticoagulant tube storage of blood specimen"^^xsd:string ;
    ns1:IAO_0000111 "anticoagulant tube storage of blood specimen"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Storage of a blood specimen in a tube with anticoagulant"^^xsd:string ;
    ns1:IAO_0000117 "Person:Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0100017 ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000784 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0002219 ;
                                            owl:someValuesFrom ns1:OBI_0100017 ] ) ] ] ) ],
        ns1:OBI_0302893 .

ns1:OBI_0000820 a owl:Class ;
    rdfs:label "activated partial thromboplastin time assay" ;
    ns1:IAO_0000111 "activated partial thromboplastin time assay" ;
    ns1:IAO_0000112 "The activated partial thromboplastin time (aPTT) was determined using Dade Actin FSL activated PTT reagent (PMID:19696660)"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that evaluates blood coagulation by measuring the time required for the appearance of fibrin strands following the mixing blood or plasma with phospholipid platelet substitute (e.g., crude cephalins, soybean phosphatides). It is a test of the intrinsic pathway (factors VIII, IX, XI, and XII) and the common pathway (fibrinogen, prothrombin, factors V and X) of blood coaguation . It is used as a screening test and to monitor heparin therapy."^^xsd:string ;
    ns1:IAO_0000116 "There is also the 'partial thromboplastin assay', which some people use synonymously to aPPT, but historically was done slightly differently (without adding a coagulant)."^^xsd:string ;
    ns1:IAO_0000117 "Alan Ruttenberg"^^xsd:string,
        "OBI call"^^xsd:string ;
    ns1:IAO_0000118 "aPTT assay"^^xsd:string ;
    ns1:IAO_0000119 "url:http://www.ebi.ac.uk/ols/ontologies/efo/terms?short_form=EFO_0004310"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000416 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:GO_0007596 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:unionOf ( ns1:OBI_0000655 ns1:OBI_0100016 ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Class ;
                                            owl:unionOf ( ns1:OBI_0000655 ns1:OBI_0100016 ) ] [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        ns1:OBI_0000070 .

