ns1:OBI_0002206 a ns1:OBI_0002205,
        owl:NamedIndividual ;
    rdfs:label "G1: Well differentiated" ;
    ns1:IAO_0000111 "G1: Well differentiated" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade according to AJCC 7th edition indicating that the tumor cells and the organization of the tumor tissue appear close to normal."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "G1"^^xsd:string ;
    ns1:IAO_0000119 "https://www.cancer.gov/about-cancer/diagnosis-staging/prognosis/tumor-grade-fact-sheet"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002207 a ns1:OBI_0002205,
        owl:NamedIndividual ;
    rdfs:label "G2: Moderately differentiated" ;
    ns1:IAO_0000111 "G2: Moderately differentiated" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade according to AJCC 7th edition indicating that the tumor cells are moderately differentiated and reflect an intermediate grade."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "G2"^^xsd:string ;
    ns1:IAO_0000119 "https://www.cancer.gov/about-cancer/diagnosis-staging/prognosis/tumor-grade-fact-sheet"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002208 a ns1:OBI_0002205,
        owl:NamedIndividual ;
    rdfs:label "G3: Poorly differentiated" ;
    ns1:IAO_0000111 "G3: Poorly differentiated" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade according to AJCC 7th edition indicating that the tumor cells are poorly differentiated and do not look like normal cells and tissue."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "G3"^^xsd:string ;
    ns1:IAO_0000119 "https://www.cancer.gov/about-cancer/diagnosis-staging/prognosis/tumor-grade-fact-sheet"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002209 a ns1:OBI_0002205,
        owl:NamedIndividual ;
    rdfs:label "G4: Undifferentiated" ;
    ns1:IAO_0000111 "G4: Undifferentiated" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade according to AJCC 7th edition indicating that the tumor cells are undifferentiated and do not look like normal cells and tissue."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "G4"^^xsd:string ;
    ns1:IAO_0000119 "https://www.cancer.gov/about-cancer/diagnosis-staging/prognosis/tumor-grade-fact-sheet"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002211 a ns1:OBI_0002210,
        owl:NamedIndividual ;
    rdfs:label "G1 (Fuhrman)" ;
    ns1:IAO_0000111 "G1 (Fuhrman)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade according to the Fuhrman Nuclear Grading System indicating that nuclei are round, uniform, approximately 10um and that nucleoli are inconspicuous or absent."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Grade 1"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002212 a ns1:OBI_0002210,
        owl:NamedIndividual ;
    rdfs:label "G2 (Fuhrman)" ;
    ns1:IAO_0000111 "G2 (Fuhrman)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade according to the Fuhrman Nuclear Grading System indicating that nuclei are slightly irregular, approximately 15um and nucleoli are evident."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Grade 2"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002213 a ns1:OBI_0002210,
        owl:NamedIndividual ;
    rdfs:label "G3 (Fuhrman)" ;
    ns1:IAO_0000111 "G3 (Fuhrman)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade according to the Fuhrman Nuclear Grading System indicating that nuclei are very irregular, approximately 20um and nucleoli large and prominent."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Grade 3"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002214 a ns1:OBI_0002210,
        owl:NamedIndividual ;
    rdfs:label "G4 (Fuhrman)" ;
    ns1:IAO_0000111 "G4 (Fuhrman)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade according to the Fuhrman Nuclear Grading System indicating that nuclei arei bizarre and multilobulated, 20um or greater and nucleoli are prominent and chromatin clumped."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Grade 4"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002217 a ns1:OBI_0002216,
        owl:NamedIndividual ;
    rdfs:label "Low grade ovarian tumor" ;
    ns1:IAO_0000111 "Low grade ovarian tumor" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade for ovarian tumor according to a two-tier grading system indicating that the tumor is low grade."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "Low grade"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002218 a ns1:OBI_0002216,
        owl:NamedIndividual ;
    rdfs:label "High grade ovarian tumor" ;
    ns1:IAO_0000111 "High grade ovarian tumor" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade for ovarian tumor according to a two-tier grading system indicating that the tumor is high grade."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "High grade"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002220 a ns1:OBI_0002219,
        owl:NamedIndividual ;
    rdfs:label "G1 (WHO)" ;
    ns1:IAO_0000111 "G1 (WHO)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade for ovarian tumor according to the World Health Organization indicating that the tumor is well differentiated."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "G1"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002221 a ns1:OBI_0002219,
        owl:NamedIndividual ;
    rdfs:label "G2 (WHO)" ;
    ns1:IAO_0000111 "G2 (WHO)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade for ovarian tumor according to the World Health Organization indicating that the tumor is moderately differentiated."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "G2"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002222 a ns1:OBI_0002219,
        owl:NamedIndividual ;
    rdfs:label "G3 (WHO)" ;
    ns1:IAO_0000111 "G3 (WHO)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade for ovarian tumor according to the World Health Organization indicating that the tumor is poorly differentiated."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "G3"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002223 a ns1:OBI_0002219,
        owl:NamedIndividual ;
    rdfs:label "G4 (WHO)" ;
    ns1:IAO_0000111 "G4 (WHO)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A histologic grade for ovarian tumor according to the World Health Organization indicating that the tumor is undifferentiated."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000118 "G4"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBI"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string .

ns1:OBI_0002225 a ns1:OBI_0002224,
        owl:NamedIndividual ;
    rdfs:label "pT0 (colon)" ;
    ns1:IAO_0000111 "pT0 (colon)" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pathologic primary tumor stage for colon and rectum according to AJCC 7th edition indicating that there is no evidence of primary tumor."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/colon/path_t/"^^xsd:string ;
