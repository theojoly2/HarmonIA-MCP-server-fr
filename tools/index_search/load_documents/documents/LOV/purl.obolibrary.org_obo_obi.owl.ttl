ns1:OBI_0000463 a owl:Class ;
    rdfs:label "column chromatography detector"@en ;
    ns1:IAO_0000111 "column chromatography detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "There is a wide range of detectors available for both GC and LC each having their own particular areas of application. In general the more catholic the response, the less sensitive the detector and the most sensitive detectors are those that have a specific response. The performance of all detectors should be properly specified so that the user can determine which is most suitable for a specific application. Such specifications are also essential to compare the performance of different detectors supplied by alternative instrument manufactures. Detector specifications should be presented in a standard form and in standard units, so that detectors can be compared that function on widely different principles."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01077"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/Principles/Basic-Chromatograph/Detector/rs56.html>"@en ;
    ns1:IAO_0000232 "chromatography detector, defined class/xps"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000465 a owl:Class ;
    rdfs:label "organic acid column"@en ;
    ns1:IAO_0000111 "organic acid column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An organic acid column is a chromatography column which enables (reversed-phase) separation of hydrophilic aliphatic and aromatic organic acids with UV detection. Organic acid columns allow retention of polar and apolar organic acids and are hydrolysis resistant."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01099"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000466 a owl:Class ;
    rdfs:label "thermal conductivity detector"@en ;
    ns1:IAO_0000111 "thermal conductivity detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The most commonly used detector in preparative GC is the thermal conductivity detector (hot wire detector). Even this detector, however, is often too sensitive and has too high a flow impedance. Under such circumstances, the procedure mentioned above must be employed. The eluent from the preparative column is split and a small portion diverted through the detector (sometimes with further dilution with carrier gas to reduce sensitivity)."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "TCD, hot wire detector"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01084"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/Preparative/Apparatus/Detectors/rs27.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000467 a owl:Class ;
    rdfs:label "Bruker US 2 NMR magnet"@en ;
    ns1:IAO_0000111 "Bruker US 2 NMR magnet"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An actively-shielded superconducting magnet from Bruker that combines Bruker BioSpin's advanced, proprietary UltraShield active shielding and UltraStabilized sub-cooling technologies. This shielded and stabilized (US2) magnet system delivers high sensitivity and spectral dispersion."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400189"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/nmr_magnets_950us2.html>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000597 .

ns1:OBI_0000468 a owl:Class ;
    rdfs:label "protein column"@en ;
    ns1:IAO_0000111 "protein column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A protein column is a chromatography column used for the separation of complex protein mixtures. Protein columns enable sample desalting, followed by chromatographic separation or fractionation of complex protein samples, e.g. immunodepleted serum or plasma proteins."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01238"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "refactor as defined class"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000469 a owl:Class ;
    rdfs:label "solvent mixer"@en ;
    ns1:IAO_0000111 "solvent mixer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A liquid chromatography device that mixes different solvents, e.g. under high pressure and in differrent volumes ranging from 5 ml to 5 L capacity. Powerful magnetic mixers provide vigorous agitation required for high pressure reaction chemistry."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01072"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "check on definition !"@en ;
    rdfs:subClassOf ns1:OBI_0000485 .

ns1:OBI_0000473 a owl:Class ;
    rdfs:label "Bruker NMR Case sample changer"@en ;
    ns1:IAO_0000111 "Bruker NMR Case sample changer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The NMR Case is an economical NMR sample changer for laboratories with modest automation needs. It expands the maximum number of samples your spectrometer can process during unattended operation to 24. The NMR Case consists of multiple components. The NMR Case exchange module installed atop your cryostat. The two front legs are adjustable, making the NMR Case compatible with many different cryostats."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400203"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/automation.html>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000464 .

ns1:OBI_0000474 a owl:Class ;
    rdfs:label "nano pump system"@en ;
    ns1:IAO_0000111 "nano pump system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pump system optimized for nano flow chromatography."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01052"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000589 .

ns1:OBI_0000475 a owl:Class ;
    rdfs:label "Bruker AutoClean system"@en ;
    ns1:IAO_0000111 "Bruker AutoClean system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "NMR tubes are often used once and discarded, creating needless waste. With the Bruker BioSpin Autoclean system you can now recycle 5mm, 3mm, or 5mm/3mm step-down (Wilmad 520-1B) NMR tubes. AutoClean NMR Tube Washing System is a simple way to recoup the substantial investment your organization makes in quality NMR tubes, and cut back on needless waste material."@en ;
    ns1:IAO_0000116 "washing system/NMR tube washing system, XPS: device has function washing"@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400205"^^xsd:string,
        "WEB:<http://www.used-line.com/c5983250s10028-Bruker_Biospin_NMR_Autoclean_Nuclear_Magnetic_Resonance_Organic_Solvents.htm>"@en ;
    rdfs:subClassOf ns1:OBI_0000498 .

ns1:OBI_0000476 a owl:Class ;
    rdfs:label "manual injection system"@en ;
    ns1:IAO_0000111 "manual injection system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The traditional hardware system that allows a human to inject a sample into an inlet by hand, using a syringe."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01064"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000504 .

ns1:OBI_0000477 a owl:Class ;
    rdfs:label "Varian GEMINI spectrometer"@en ;
    ns1:IAO_0000111 "Varian GEMINI spectrometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An older Varian Broadband NMR spectrometer."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400239"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000611 .

ns1:OBI_0000482 a owl:Class ;
    rdfs:label "normal phase column"@en ;
    ns1:IAO_0000111 "normal phase column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A normal phase column is a chromatography column in which the stationary phase is more polar than the mobile phase. Its counterpart is the reversed phase column."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01097"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000483 a owl:Class ;
    rdfs:label "APOLLO console"@en ;
    ns1:IAO_0000111 "APOLLO console"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The APOLLO is a compact, modular, multiple-DSP, Windows XP Professional-based console that can be equipped with up to 8 DDS-based RF transmitter channels configurable from 2 kHz to 3.5 GHz. Each transmitter channel produces a nominal 1V output and has the most agile frequency, phase and amplitude control of any system on the market. An array of additional options are available including multiple RF transmitters, linear high-power RF amplifiers, digital receiver arrays, low noise figure preamplifiers, a gradient control system, shim unit, MAS spin-speed controller, variable temperature unit, digital lock system and probe/coil interface. With its numerous options, the Apollo can be configured for any NMR, NQR or MRI application."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400249"^^xsd:string,
        "WEB:<http://www.tecmag.com/apollo.htm>"@en ;
    ns1:IAO_0000232 "NMR instrument/NMR console"@en ;
    rdfs:subClassOf ns1:OBI_0000599 .

ns1:OBI_0000486 a owl:Class ;
    rdfs:label "continuous wave NMR instrument"@en ;
    ns1:IAO_0000111 "continuous wave NMR instrument"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Continuous wave NMR spectrometers are similar to optical spectrometers, but the sample is held in a strong magnetic field, where the frequency of the source is slowly scanned (in some instruments, the source frequency is held constant, and the field is scanned)."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400283"^^xsd:string,
        "WEB:<http://teaching.shu.ac.uk/hwb/chemistry/tutorials/molspec/nmr3.htm>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000566 .

ns1:OBI_0000487 a owl:Class ;
    rdfs:label "fourier transformation NMR instrument"@en ;
    ns1:IAO_0000111 "fourier transformation NMR instrument"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "In fourier transformation NMR, all frequencies in a spectrum are irradiated simultaneously with a radio frequency pulse. Following the pulse, the nuclei return to thermal equilibrium. A time domain emission signal is recorded by the instrument as the nuclei relax. A frequency domain spectrum is obtained by Fourier transformation."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400284"^^xsd:string,
        "GROUP:<http://teaching.shu.ac.uk/hwb/chemistry/tutorials/molspec/nmr3.htm>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000566 .

ns1:OBI_0000489 a owl:Class ;
    rdfs:label "nitrogen phosphorous detector"@en ;
    ns1:IAO_0000111 "nitrogen phosphorous detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The nitrogen phosphorus detector (NPD) (sometimes called the thermionic detector) is a very sensitive, specific detector the design of which, is based on the FID. Physically the sensor appears to be very similar to the FID but, in fact, operates on an entirely different principle. The nitrogen phosphorous detector (sometimes called the thermionic detector) is a very sensitive but specific detector that responds almost exclusively to nitrogen and phosphorous compounds. It is based on the flame ionization detector but differs in that it contains a rubidium or cesium silicate (glass) bead situated in a heater coil, a little distance from the hydrogen flame. If the detector is to respond to both nitrogen and phosphorous then the hydrogen flow should be minimal so that the gas does not ignite at the jet. If the detector is to respond to phosphorous only, a large flow of hydrogen is used which is burnt at the jet. The heated bead emits electrons by thermionic emission. These electrons are collected under a potential of a few volts by an appropriately placed anode, and provides a background current. When a solute containing nitrogen or phosphorous is eluted from the column, the partially combusted nitrogen and phosphorous materials are adsorbed on the surface of the bead. The adsorbed material reduces the work function of the surface and, as consequence, the emission of electrons is increased which raises the current collected at the electrode. The sensitivity of the detector to phosphorous is about 10-12 gram per ml and for nitrogen about 10-11 gram per ml at a signal to nose ratio of 2. The alkali bead as a finite life and needs regular replacement."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01089"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/topics/nitrogen/phosphorus/detector.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000490 a owl:Class ;
    rdfs:label "cation exchange column"@en ;
    ns1:IAO_0000111 "cation exchange column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cation exchange column is a chromatography column that is used in cation exchange chromatography."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01096"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000560 .

ns1:OBI_0000491 a owl:Class ;
    rdfs:label "direct detection NMR probe"@en ;
    ns1:IAO_0000111 "direct detection NMR probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR probe designed to allow the direct detection of acquisition nuclei."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400280"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR device"@en ;
    rdfs:subClassOf ns1:OBI_0000516 .

ns1:OBI_0000492 a owl:Class ;
    rdfs:label "Bruker B-ACS system"@en ;
    ns1:IAO_0000111 "Bruker B-ACS system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The Bruker Automatic Sample Changer (B-ACS 60/120), used in conjunction with Bruker DISNMR, UXNMR or XWIN-NMR software, provides dialog-guided facilities which allow the user to easily and effectively perform automatic (continuous) experiments. Features include a 60 or 120 sample capacity, random accessing of samples, positive sample identification with the optional bar code reader, and temperature control of individual samples with the optional sample heater unit."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400210"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/automation.html>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000464 .

ns1:OBI_0000493 a owl:Class ;
    rdfs:label "rapid resolution column"@en ;
    ns1:IAO_0000111 "rapid resolution column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A rapid resolution column is a chromatography column as marketed by Agilent, which is used with a rapid resolution cartridge to ensure a fast chromatography process with good separation resolution."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01102"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000372 ],
        ns1:OBI_0000932 .

ns1:OBI_0000495 a owl:Class ;
    rdfs:label "vacuum degasser"@en ;
    ns1:IAO_0000111 "vacuum degasser"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A degassing system used for degassing solvents in liquid chromatography. Dissolved gasses, usually nitrogen and oxygen from the air, tend to be evolved in the mobile phase as the pressure is reduced when the mobile phase leaves the liquid chromatography column and enters the detector. Gasses in the mobile phase in the detector can produce completely unacceptable noise and, thus, must be removed. The dissolved gasses were originally removed under vacuum but, unfortunately, are soon replaced if the solvent is left in contact with air at atmospheric pressure. For this reason degassing is now usually carried out by bubbling helium through the mobile phase reservoirs. Secondly, vacuum is used in the thermionic detector. This consists of a device, very similar in design to the thermionic valve which is attached to a vacuum and a small quantity of the eluent from a gas chromatography column allowed to bleed through it. Helium is used as the carrier gas. The presence of solute vapor causes the thermionic current to fall. This type of detector tends to become contaminated rather readily."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01053"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/topics/vacuum.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000589 .

ns1:OBI_0000496 a owl:Class ;
    rdfs:label "capillary column"@en ;
    ns1:IAO_0000111 "capillary column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A capillary column is a thin tube with a small inner diameter, usually around 0.5 mm."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01066"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000497 a owl:Class ;
    rdfs:label "sample inlet"@en ;
    ns1:IAO_0000111 "sample inlet"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The column inlet (or injector) provides the means to introduce a sample into a continuous flow of carrier gas. The inlet is a piece of hardware attached to the column head."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01044"^^xsd:string,
        "WEB:<http://en.wikipedia.org/wiki/Gas_chromatography#Inlets>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000500 a owl:Class ;
    rdfs:label "dual loop autosampler"@en ;
    ns1:IAO_0000111 "dual loop autosampler"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A dual loop autosampler is an autosampler that is designed for handling both analytical (10 mL/min flow rate) to preparative scale sample purification (100 mL/min flow rate)."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01063"^^xsd:string,
        "WEB:<http://www.chem.agilent.com/scripts/pds.asp?lpage=17149>"@en ;
    rdfs:subClassOf ns1:OBI_0000494 .

ns1:OBI_0000501 a owl:Class ;
    rdfs:label "variable wavelength detector"@en ;
    ns1:IAO_0000111 "variable wavelength detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A chromatography detector, that can detect signals within a certain range at user-defined wavelengths."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01079"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000503 a owl:Class ;
    rdfs:label "Bruker LC-NMR platform"@en ;
    ns1:IAO_0000111 "Bruker LC-NMR platform"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The LC-NMR/MS setup was first introduced by Bruker BioSpin in 1999. An LC-NMR system including a Bruker Peak Sampling Unit (BPSU-36) was coupled with a Bruker Daltonics esquire series ion trap mass spectrometer via a Bruker NMR-MS interface (BNMI). Since October 2004 the Bruker Daltonics microTOF-LC time-of-flight mass spectrometer can also be integrated in an LC-NMR setup."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400276"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/hyphenation_lcnmr_ms.html>"@en ;
    ns1:IAO_0000232 "hyphenated NMR instrument platform"^^xsd:string,
        "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000596 .

ns1:OBI_0000505 a owl:Class ;
    rdfs:label "multiple wavelength detector"@en ;
    ns1:IAO_0000111 "multiple wavelength detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A chromatography detector, that can detect many discrete wavelengths in parallel and produces a multiple wavelength chromatographic profile."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01078"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000506 a owl:Class ;
    rdfs:label "photoionization detector"@en ;
    ns1:IAO_0000111 "photoionization detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The selective determination of aromatic hydrocarbons or organo-heteroatom species is the job of the photoionization detector (PID). This device uses ultraviolet light as a means of ionizing an analyte exiting from a GC column. The ions produced by this process are collected by electrodes. The current generated is therefore a measure of the analyte concentration. f the amount of ionization is reproducible for a given compound, pressure, and light source then the current collected at the PID's reaction cell electrodes is reproducibly proportional to the amount of that compound entering the cell. The reason why the compounds that are routinely analyzed are either aromatic hydrocarbons or heteroatom containing compounds (like organosulfur or organophosphorus species) is because these species have ionization potentials (IP) that are within reach of commercially available UV lamps. The available lamp energies range from 8.3 to 11.7 ev, that is, lambda max ranging from 150 nm to 106 nm. Although most PIDs have only one lamp, lamps in the PID are exchanged depending on the compound selectivity required in the analysis."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "PID"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01090"^^xsd:string,
        "WEB:<http://www.chemistry.adelaide.edu.au/external/soc-rel/content/pid.htm>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000508 a owl:Class ;
    rdfs:label "column jacket"@en ;
    ns1:IAO_0000111 "column jacket"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A column jacket is a piece of column chromatography equipment that covers a column in order to ensure thermoisolation and create a controllable thermostatic microenvironment."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01276"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000509 a owl:Class ;
    rdfs:label "electron capture detector"@en ;
    ns1:IAO_0000111 "electron capture detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The electron capture detector is a GC detector that uses a radioactive Beta emitter (electrons) to ionize some of the carrier gas and produce a current between a biased pair of electrodes. When organic molecules that contain electronegative functional groups, such as halogens, phosphorous, and nitro groups pass by the detector, they capture some of the electrons and reduce the current measured between the electrodes."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "ECD"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01085"^^xsd:string,
        "WEB:<http://homepages.onsnet.nu/%7Ealkema/html/whatisgc.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000510 a owl:Class ;
    rdfs:label "reversed phase column"@en ;
    ns1:IAO_0000111 "reversed phase column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A reversed phase column is a chromatography column in which the mobile phase is more polar than the stationary phase. Its counterpart is the normal phase column."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01106"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000511 a owl:Class ;
    rdfs:label "injector lubricant"@en ;
    ns1:IAO_0000111 "injector lubricant"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A lubricant used in liquid chromatography that eases sample injector penetration."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01118"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000601 .

ns1:OBI_0000513 a owl:Class ;
    rdfs:label "DISCOVERY console"@en ;
    ns1:IAO_0000111 "DISCOVERY console"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The Discovery console is a Windows XP Professional-based, integrated console designed especially for Solid-State NMR. The console includes everything needed to interface to any magnet and solids probe - from computer to cables to duplexing network."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400247"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument/NMR console"@en ;
    rdfs:subClassOf ns1:OBI_0000599 .

ns1:OBI_0000514 a owl:Class ;
    rdfs:label "Bruker AMX series NMR instrument"@en ;
    ns1:IAO_0000111 "Bruker AMX series NMR instrument"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A series of older Bruker NMR magnets, now out of production. The Bruker AMX500 has proven an extremely reliable workhorse, with excellent lineshape yielding superior water suppression even without gradients. The Oxford 11.7 Tesla 5.2 cm bore magnet rests on a TMC vibration damping table. Homogeneity is controlled by a BSN-18 and BSN-2 with 19 shim controls. In addition to the 5 mm triple resonance probe, the AMX is equipped with a 10mm broadband observe probe."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400240"^^xsd:string,
        "WEB:<http://www.tufts.edu/med/biochemistry/NMR/amx500.html>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000596 .

ns1:OBI_0000515 a owl:Class ;
    rdfs:label "chromatofocusing column"@en ;
    ns1:IAO_0000111 "chromatofocusing column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A chromatofocusing column is a chromatography column in which a resin is equilibrated at one pH and eluted at a second pH. The use of a weak ion-exchange resin causes a pH gradient to be formed at the solvent front owing to the buffering action of the resin. This pH gradient in turn leads to an ordering of proteins by isoelectric point. Molecules of charge sign opposite the resin bind; those of charge sign like the resin do not bind."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01209"^^xsd:string,
        "WEB:<http://www.bioprocessintl.com/default.asp?page=glossary&TopicID=1>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000519 a owl:Class ;
    rdfs:label "flow probe"@en ;
    ns1:IAO_0000111 "flow probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR probe that allows the automatized flow-through of a sample. The sample is aspirated via a syringe pump into the Flow probe, the NMR spectrum is acquired and when the experiment is complete, the sample is returned to back to an external source (well plate) or flushed to waste. Sometimes pulsed field gradients (PFG) can be established in flow probes."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400131"^^xsd:string,
        "WEB:<http://www.varianinc.com/cgi-bin/nav?products/NMR/accessory/auto_samplers/vast/index&cid=HFIH>"@en ;
    ns1:IAO_0000232 "NMR device"@en ;
    rdfs:subClassOf ns1:OBI_0000516 .

ns1:OBI_0000520 a owl:Class ;
    rdfs:label "clinical chemistry assay" ;
    ns1:IAO_0000111 "clinical chemistry assay" ;
    ns1:IAO_0000112 "Influence of hydroxyethyl starch (6% HES 130/0.4) administration on hematology and clinical chemistry parameters."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An analyte assay which uses analytical methods to produce measurements and data on the concentration of chemical parameters (analytes) present in a bodily fluid collected from an organism."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "chemical pathology"^^xsd:string,
        "detection of analyte in blood sample"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Clinical_chemistry"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:OBI_0000655 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000655 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000275 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:OBI_0000576 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:OBI_0000576 ] ) ],
        ns1:OBI_0000443 .

ns1:OBI_0000521 a owl:Class ;
    rdfs:label "flame ionization detector"@en ;
    ns1:IAO_0000111 "flame ionization detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A flame ionization detector is a GC detector that consist of a hydrogen/air flame and a collector plate which are normally heated independently of the chromatographic oven. Heating is necessary in order to prevent condensation of water generated by the flame and also to prevent any hold-up of solutes as they pass from the column to the flame. There is an electrode above the flame to collect the ions formed at a hydrogen/air flame. The number of ions hitting the collector is measured and a signal is generated. Flame ionization detectors are most widely used and generally applicable for gas chromatography and hence is used for routine and general purpose analysis. It is easy to use but destructive of the sample."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "FID"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01197"^^xsd:string,
        "WEB:<http://homepages.onsnet.nu/%7Ealkema/html/whatisgc.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000522 a owl:Class ;
    rdfs:label "vial"@en ;
    ns1:IAO_0000111 "vial"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A vial is a cylindrical container often made from glass tubing."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01117"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000601 .

ns1:OBI_0000523 a owl:Class ;
    rdfs:label "magic angle spinning rotor"@en ;
    ns1:IAO_0000111 "magic angle spinning rotor"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A rotor device that holds the NMR sample and enables the adjustment of the orientation of the rotation axis for a sample in a NMR instrument in the magic angle."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "MAS rotor"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400130"^^xsd:string,
        "WEB:<http://www.freepatentsonline.com/4352066.html>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom ns1:OBI_0000566 ],
        ns1:OBI_0000968 .

ns1:OBI_0000524 a owl:Class ;
    rdfs:label "Varian VXR spectrometer"@en ;
    ns1:IAO_0000111 "Varian VXR spectrometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A Varian NMR spectrometer."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400238"^^xsd:string,
        "WEB:<http://www.scs.uiuc.edu/NMR/instruments/vxr500.php>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000611 .

ns1:OBI_0000525 a owl:Class ;
    rdfs:label "splitless GC injector"@en ;
    ns1:IAO_0000111 "splitless GC injector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Injected sample enters column immediately (while split valve to split vent is closed). Here a sample is introduced into a heated small chamber via a syringe through a septum - the heat facilitates volatilization of the sample and sample matrix. The carrier gas then either sweeps the entirety (splitless mode) or a portion (split mode) of the sample into the column. In split mode, a part of the sample/carrier gas mixture in the injection chamber is exhausted through the split vent."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01060"^^xsd:string,
        "WEB:<http://en.wikipedia.org/wiki/Gas_chromatography>"@en ;
    rdfs:subClassOf ns1:OBI_0000504 .

ns1:OBI_0000526 a owl:Class ;
    rdfs:label "preparative autosampler"@en ;
    ns1:IAO_0000111 "preparative autosampler"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "For preparative LC with injection of sample volumes ranging from L to mL ranges."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01062"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000494 .

ns1:OBI_0000527 a owl:Class ;
    rdfs:label "flow high resolution probe"@en ;
    ns1:IAO_0000111 "flow high resolution probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Hyphenated analytical techniques combining mass spectrometry and chromatography are well-established laboratory tools. The combination of chromatography and NMR has also made its way into the analytical laboratory. Further developments even combine all three techniques into an LC-NMR/NMR-MS system. The use of solid phase extraction provides an efficient interface between chromatography and NMR with demands for special type of flow probes."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "flow HR-probe"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400195"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000480 .

ns1:OBI_0000528 a owl:Class ;
    rdfs:label "liquid chromatography valve"@en ;
    ns1:IAO_0000111 "liquid chromatography valve"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A sample valve that must be able to sustain pressures up to 10,000 p.s.i., although it is most likely to operate on a continuous basis, at pressures of 3,000 p.s.i. or less. The higher the operating pressure the tighter the valve seating surfaces must be forced together to eliminate any leak. It follows that any abrasive material, however fine, that passes into the valve can cause the valve seating to become scored each time it is rotated which will ultimately lead to leaks. This will cause the sample size to vary between samples and eventually affect the accuracy of the analysis. It follows that any solid material must be carefully removed from any sample before filling the valve. The sample volume of an internal loop valve is situated in the connecting slot of the valve rotor and can be used only for relatively small sample volumes. Internal sample loop valves provide samples with volumes ranging from 0.1 ml to about 0.5 ml. Valve operation is shown in figure 6. The left-hand side diagram shows the load position. The sample occupies the rotor slot and has been filled by passing the sample from an appropriate syringe through the rotor slot to waste. While loading the sample, the mobile phase supply is passed through the valve directly to the column. To place the sample onto the column, the valve is then rotated and the valve slot containing the sample is now placed between the solvent supply and the column. As a result, the sample is passed into the column by the flow of solvent."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01110"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/EC-Dispersion/HPLC-Sample-Valves/rs16.html>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000530 a owl:Class ;
    rdfs:label "Bruker UltraShield Plus NMR magnet"@en ;
    ns1:IAO_0000111 "Bruker UltraShield Plus NMR magnet"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR magnet of which Brukers claims it is the latest and most advanced self-shielding NMR magnet technology ever developed. These magnets are the ultimate advancement in high performance, actively-shielded NMR solutions. They offer unprecedented shielding performance whilst ensuring no compromise in system homogeneity, stability or cryogenic specifications."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400190"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/nmr_magnets_usplus.html>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000597 .

ns1:OBI_0000531 a owl:Class ;
    rdfs:label "Bruker CryoProbe"@en ;
    ns1:IAO_0000111 "Bruker CryoProbe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The Bruker BioSpin CryoProbe is a high-performance cryogenically cooled probe developed for high-resolution applications. It has improved signal/noise (S/N) ratios obtained by reducing the operating temperature of the coil and the pre-amplifier. As a result, the efficiency of the coil is improved and the noise of the coil and the pre-amplifier are reduced.The dramatic increase in the S/N ratio by a factor of 3-4, as compared to conventional probes, leads to a possible reduction in experiment time of up to 16 or a reduction in required sample concentration by a factor of up to 4. The CryoProbes possess key characteristics for NMR analysis:\\\\n   Significant S/N gains (with moderately salty samples also)\\\\n   Short pulse widths\\\\n   Short ring down times\\\\n   Linear behavior in power response\\\\n   Gradient capability\\\\n   CryoProbes are available as Triple Resonance, Dual, Selective X Detection, MicroImaging, and Quad Nucleus Probes configurations at 400 MHz and higher\\\\n   All high resolution probes have a lock circuit\\\\n   All high resolution probes have Z-gradient."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400191"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000561 .

ns1:OBI_0000532 a owl:Class ;
    rdfs:label "column cartridge"@en ;
    ns1:IAO_0000111 "column cartridge"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A device that binds the chromatography column and additional connector elements and / or valves or syringes into one physical unity for further processing."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01055"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "chromatography device, check on definition !"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000533 a owl:Class ;
    rdfs:label "affinity column"@en ;
    ns1:IAO_0000111 "affinity column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An affinity column is a chromatography column that is used in affinity chromatography. Differences in the affinity of molecules to be separated to a stationary phase are used for discriminate retention."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01094"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000534 a owl:Class ;
    rdfs:label "tecmag NMR instrument"@en ;
    ns1:IAO_0000111 "tecmag NMR instrument"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR instrument that is manufactured by tecmag."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400250"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000566 .

ns1:OBI_0000535 a owl:Class ;
    rdfs:label "gel filtration column"@en ;
    ns1:IAO_0000111 "gel filtration column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A Gel filtration column is a chromatography column for size-exclusion chromatography, in which the stationary phase is a gel. The main application of gel filtration chromatography is the fractionation of proteins and other water-soluble polymers."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01104"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000618 .

ns1:OBI_0000536 a owl:Class ;
    rdfs:label "fraction collector"@en ;
    ns1:IAO_0000111 "fraction collector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A fraction detector is a device that allows regular or specified samples to be taken from a column eluate and stored in a retrievable form. The storage vessels are usually small sample tubes or vials that are oriented in a rotating disk or in a moving belt, there movement usually being controlled by a microprocessor. On receiving a signal from the microprocessor, the next vial is placed under the column outlet and the eluate collected until receiving another signal from the computer. Once the properties of the chromatogram that describes the separation has been ascertained, then the collection program can be defined. The fractions can be collected on a basis of time either at regular intervals or a specific times to collect specific peaks. Alternatively the fractions can be collected by monitoring the detector output and when a peak starts to elute the fraction collector is activated and the peak collected in a specific vial. When the peak returns to base line the column eluate is then directed to waste until the next peak starts eluting. Fraction collectors are in common use with most liquid chromatographs. They are used to collect samples for further purification, subsequent examination by spectroscopic techniques or for biological or organoleptic testing."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01073"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/topics/fraction/collector.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000485 .

ns1:OBI_0000537 a owl:Class ;
    rdfs:label "copy number variation profiling assay" ;
    ns1:IAO_0000111 "copy number variation profiling assay" ;
    ns1:IAO_0000112 "Profiling of copy number variations (CNVs) in healthy individuals from three ethnic groups using a human genome 32 K BAC-clone-based array. PMID:18058796"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that determines lost or amplified genomic regions of DNA by comparing genomic DNA originating from tissues from the same or different individuals using specific techniques such as CGH, array CGH, SNP genotyping"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "CNV analysis"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:OBI_0001404 ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000109 ],
        ns1:OBI_0000070 .

ns1:OBI_0000538 a owl:Class ;
    rdfs:label "in-line filter"@en ;
    ns1:IAO_0000111 "in-line filter"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A solvent filter that sits between the pump and the injection valve that prevents dust particles, general debris and, to some extent, bacteria from entering the chromatography system. Contaminants can interfere with the low-pressure gradient former or the pump and particles entering valves may interfere with the proper function. The result could cause an increased baseline noise, non-repeatable gradient forming, unreliable flow rate or other interferences. Solvent in-line filters are low-pressure filters and will allow a high flow rate due to a large surface area and large porosity."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01123"^^xsd:string,
        "WEB:<http://www.appliedporous.com/frits-chromatography.htm>"@en ;
    rdfs:subClassOf ns1:OBI_0000592 .

ns1:OBI_0000539 a owl:Class ;
    rdfs:label "imaging NMR probe"@en ;
    ns1:IAO_0000111 "imaging NMR probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR probe that is designed for generating pictures from sample states via NMR imaging."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400244"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR device"@en ;
    rdfs:subClassOf ns1:OBI_0000516 .

ns1:OBI_0000541 a owl:Class ;
    rdfs:label "Bruker AC series NMR instrument"@en ;
    ns1:IAO_0000111 "Bruker AC series NMR instrument"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A series of older Bruker NMR magnets, now out of production."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400241"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000596 .

ns1:OBI_0000543 a owl:Class ;
    rdfs:label "syringe filter"@en ;
    ns1:IAO_0000111 "syringe filter"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A small membrane filter of defined pore size, that filters samples from a syringe."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01122"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000592 .

ns1:OBI_0000544 a owl:Class ;
    rdfs:label "Bruker SampleRail system"@en ;
    ns1:IAO_0000111 "Bruker SampleRail system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "This Instrument system automatically prepares an NMR sample, inserts it into an NMR magnet, performs NMR experiments on the sample, and transports it back to the preparation system.   The SampleRail fulfills the transporting tasks from the preparation system into the NMR magnet and back."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400207"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/automation.html>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000383 ],
        ns1:OBI_0000968 .

ns1:OBI_0000545 a owl:Class ;
    rdfs:label "column compartment"@en ;
    ns1:IAO_0000111 "column compartment"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "For chromatography analyses, the ability to maintain a stable column environment regardless of ambient temperature fluctuations is critical for maintaining retention time precision. In order to ensure such stable conditions at different chromatography steps a column compartment can be installed that ensures e.g. stable temperature of the column in a given step."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01068"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000546 a owl:Class ;
    rdfs:label "capillary pump system"@en ;
    ns1:IAO_0000111 "capillary pump system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pump system optimized for capillary chromatography."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01051"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000589 .

ns1:OBI_0000547 a owl:Class ;
    rdfs:label "evaporative light scattering detector"@en ;
    ns1:IAO_0000111 "evaporative light scattering detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The evaporative light scattering detector, as its name implies, utilizes a spray that continuously atomizes the column eluent into small droplets. These droplets are allowed to evaporate, leaving the solutes as fine particulate matter suspended in the atomizing gas."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01082"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/HPLC-Detectors/Evaporative-Light-Scattering/rs73.html>"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000549 a owl:Class ;
    rdfs:label "column cartridger"@en ;
    ns1:IAO_0000111 "column cartridger"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A chromatography device where the column cartridge is inserted into and stabilised."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01054"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "check on definition !"@en ;
    rdfs:subClassOf ns1:OBI_0000485 .

ns1:OBI_0000550 a owl:Class ;
    rdfs:label "nitrogen generator"@en ;
    ns1:IAO_0000111 "nitrogen generator"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A gas generator that generates nitrogen gas."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01034"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000507 .

ns1:OBI_0000551 a owl:Class ;
    rdfs:label "needle assembly"@en ;
    ns1:IAO_0000111 "needle assembly"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The needle assembly attached to the autosampler, comprises the injector needle that feeds a sample or carrier gas into the inlet"@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01065"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "chromatography device, check on definition !"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000553 a owl:Class ;
    rdfs:label "Bruker Capillary LC-NMR platform"@en ;
    ns1:IAO_0000111 "Bruker Capillary LC-NMR platform"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Capillary LC-NMR is a hyphenated technique coupling capillary liquid chromatography and NMR, which increases sensitivity dramatically through the use of miniaturization of the chromatographic techniques and NMR detection volume. LC-NMR hyphenated systems separate a mixture into its pure components and couple the output to NMR for automatic sample analysis. The ever increasing need to measure lower sample amounts and lower level impurities demands the highest NMR sensitivity. Traditional LC-NMR systems with relatively large peak volumes are not optimized for such low levels of detection. Bruker BioSpin, together with Waters and Protasis has developed a Capillary LC-NMR system. The latest capillary LC attributes and highest capillary flow probe sensitivity combine with state of the art NMR systems technology. Greater mass sensitivity and faster spectral analysis with smaller sample volumes is possible. This system is ideal for analysis of metabolites and impurities associated with the drug development process."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400279"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/hyphenation_caplcnmr.html>"@en ;
    ns1:IAO_0000232 "hyphenated NMR instrument platform"^^xsd:string,
        "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000596 .

ns1:OBI_0000554 a owl:Class ;
    rdfs:label "gas chromatography oven"@en ;
    ns1:IAO_0000111 "gas chromatography oven"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A gas chromatography oven is an oven with a heated connection between the GC and the MS instrument in a GCMS-analysis, that keeps compounds in the gas phase as they leave the GC oven."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01039"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "gas chromatography equipment"@en ;
    rdfs:subClassOf ns1:OBI_0000542 .

ns1:OBI_0000556 a owl:Class ;
    rdfs:label "isocratic pump system"@en ;
    ns1:IAO_0000111 "isocratic pump system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pump system optimized for isocratic chromatography."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01049"^^xsd:string,
        "WEB:<http://www.buchi.com/Isocratic-Pump-System.253.0.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000589 .

ns1:OBI_0000557 a owl:Class ;
    rdfs:label "flash pump system"@en ;
    ns1:IAO_0000111 "flash pump system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Any pump system used in flash column chromatography to push the solvent through the column. Better flow rates can be achieved by using a pump or by using compressed gas (e.g. air, nitrogen, or argon) to push the solvent through the column (flash column chromatography)."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01048"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000589 .

ns1:OBI_0000558 a owl:Class ;
    rdfs:label "Varian UNITY INOVA spectrometer"@en ;
    ns1:IAO_0000111 "Varian UNITY INOVA spectrometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The UNITY INOVA is also the easiest spectrometer to use and is also the choice of those interested in using advanced NMR techniques in their own research, but without becoming, or hiring, an NMR expert. A complete set of turnkey operating environments is available for the UNITY INOVA covering the structure and dynamics of biological macromolecules, small molecules, solids, and imaging. These packages put the combined NMR expertise of the entire Varian NMR community at your fingertips."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400236"^^xsd:string,
        "WEB:<http://www.varianinc.com/cgi-bin/nav?products/NMR/spectromet/inova/index&cid=HFIH>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000611 .

ns1:OBI_0000559 a owl:Class ;
    rdfs:label "liquid NMR probe"@en ;
    ns1:IAO_0000111 "liquid NMR probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR probe that is designed to hold a liquid sample."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400242"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR device"@en ;
    rdfs:subClassOf ns1:OBI_0000516 .

ns1:OBI_0000562 a owl:Class ;
    rdfs:label "anion trap column"@en ;
    ns1:IAO_0000111 "anion trap column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An anion trap column is a trap column and ion-exchange column which contains cationic anion-exchange resins."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01277"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000518 .

ns1:OBI_0000563 a owl:Class ;
    rdfs:label "fluorescene detector"@en ;
    ns1:IAO_0000111 "fluorescene detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A single wavelength detector, where the excitation light wavelength is normally a mercury lamp generated high intensity UV light at 253.7 nm. Many substances that fluoresce will be excited by light of this wavelength and hence be detected."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01080"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/HPLC-Detectors/Fluorescence/Single-Wavelength-Excitation/rs57.html>"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000564 a owl:Class ;
    rdfs:label "tecmag EAGLE probe"@en ;
    ns1:IAO_0000111 "tecmag EAGLE probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The Eagle is a 4 mm 1H/X solid-state MAS probe with a top spinning speed of 18 kHz. Its simple design is robust, reliable and easy to spin. Configurations are available for 200 to 600 MHz wide bore magnets on Tecmag, Bruker, Chemagnetics, JEOL and Varian spectrometers."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400248"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000479 .

ns1:OBI_0000565 a owl:Class ;
    rdfs:label "electrical conductivity detector"@en ;
    ns1:IAO_0000111 "electrical conductivity detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The electrical conductivity detector measures the conductivity of the mobile phase. There is usually background conductivity which must be backed-off by suitable electronic adjustments. If the mobile phase contains buffers, the detector gives a base signal that completely overwhelms that from any solute usually making detection impossible. Thus, the electrical conductivity detector a bulk property detector. and senses all ions whether they are from a solute or from the mobile phase. In order to prevent polarization of the sensing electrodes, AC voltages must be used and so it is the impedance not the resistance of the electrode system that is actually measured. From a physical chemistry stand point the conductivity of a solution is more important than its resistance. However, it is the resistance (impedance) of the electrode system that determines the current across it. The resistance of any conductor varies directly as its length and inversely as its cross sectional area."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01239"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/HPLC-Detectors/Electrical-Conductivity/rs83.html>"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000567 a owl:Class ;
    rdfs:label "Bruker UltraShield NMR magnet"@en ;
    ns1:IAO_0000111 "Bruker UltraShield NMR magnet"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR magnet manufactured by Bruker that ensures field homogeneity without amplified effects from vibrations or thermal changes. This magnet technology uses active shielding and optimizes coil design."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400187"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/nmr_magnets_us.html?&print=http%3A%2Fitsupportunit.com%2Fawstats%2Ficon%2Fnisum%2Fivuj%2F>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000597 .

ns1:OBI_0000568 a owl:Class ;
    rdfs:label "piston-seal"@en ;
    ns1:IAO_0000111 "piston-seal"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The seal made by a piston in a diaphragm pump. The unique property of the reciprocating diaphragm pump is that the actuating piston does not come into direct contact with the mobile phase and thus, the demands on the piston-cylinder seal are not so great. The diaphragm has a relatively high surface area and thus, the movement of the diaphragm is relatively small and consequently the pump can be operated at a fairly high frequency. High frequency pumping results in a very significant reduction in pulse amplitude and, in addition, high frequency pulses are more readily damped by the column system. Nevertheless, it must be emphasized that diaphragm pumps are not pulseless."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01116"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/HPLC/Basic-HPLC/Pump/Diaphragm/rs15.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000601 .

ns1:OBI_0000569 a owl:Class ;
    rdfs:label "mass selective detector"@en ;
    ns1:IAO_0000111 "mass selective detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A mass selective detector is a GC detector that uses mass spectrometry. It is based upon the ionization of solute molecules in the ion source and the separation of the ions generated on the basis of their mass/charge ratio by an analyzer unit. This may be a magnetic sector analyzer, a quadruple mass filter, or an ion trap. Ions are detected by a dynode electron multiplier."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "mass spectrometry detector"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01198"^^xsd:string,
        "WEB:<http://homepages.onsnet.nu/%7Ealkema/html/whatisgc.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000570 a owl:Class ;
    rdfs:label "spin column"@en ;
    ns1:IAO_0000111 "spin column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A spin column is a chromatography column which is suitable for putting it into a centrifuge. A spin column enforces separation through increased G-forces while spinning the column in a centrifuge. It is often used in DNA gel extraction kits."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01232"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000572 a owl:Class ;
    rdfs:label "transfer line"@en ;
    ns1:IAO_0000111 "transfer line"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A combination of devices that are used in connection with a sampling head for transferring components of an applied sample to the analyzing part of a chromatography system."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01235"^^xsd:string,
        "WEB:<http://www.freepatentsonline.com/5702671.html>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000573 a owl:Class ;
    rdfs:label "gradient pump system"@en ;
    ns1:IAO_0000111 "gradient pump system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pump system optimized for gradient chromatography."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01050"^^xsd:string,
        "WEB:<http://www.buchi.com/Gradient-Pump-System.531.0.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000589 .

ns1:OBI_0000574 a owl:Class ;
    rdfs:label "high temperature column"@en ;
    ns1:IAO_0000111 "high temperature column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A high temperature column is a chromatography column which is suitable for and withstands very high temperatures in chromatography ovens."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01233"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000575 a owl:Class ;
    rdfs:label "Bruker Ultrastabilized NMR magnet"@en ;
    ns1:IAO_0000111 "Bruker Ultrastabilized NMR magnet"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR magnet manufactured by Bruker for Ultra-High Field NMR, available from 750 MHz to 900 MHz, which provides reliable operation at reduced temperature and ambient pressure via being rigidly mounted and stabilized."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400188"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/nmr_magnets_ultrastabilized.html?&print=http%3A%2Fitsupportunit.com%2Fawstats%2Ficon%2Fnisum%2Fivuj%2F>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000597 .

ns1:OBI_0000577 a owl:Class ;
    rdfs:label "obsolete_molecular concentration"@en ;
    ns1:IAO_0000111 "molecular concentration"^^xsd:string ;
    ns1:IAO_0000112 "the phosphate concentration should be 0.1M"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A concentration is a relational quality that inheres in a material entity towards molecular scattered aggregate that is part of it by virtue of some ratio of masses of the two or the counts of the grains of the two or volume occupied by the larger material entity."^^xsd:string ;
    ns1:IAO_0000116 "JZ: Can we replace the term by PATO:\\nhttp://purl.obolibrary.org/obo/PATO_0000033\\nIf not, we will wait the term available in PATO.\\n\\nAlthough specified that obsolete reason is 'term imported', the term has not imported yet. Will keep tracking this term until import the replaced term.\\n\\nTerm depracted since the object property 'towards' used in the axioms is not avaliable in BFO2. "^^xsd:string,
        "This term represent a quality of molecular concentration. If there is need for some other sort of concentration - e.g. ratio of counts of cells, another term is needed. \\n\\nOBI uses a standard unit for representing concentration qualities but this still needs to be decided on. A relation needs to be defined that relates the quality instance to the representation of its quantitative value in the chosen units. See http://en.wikipedia.org/wiki/Concentration\\n\\nMeasurements of concentration may be in any appropriate unit. Note that precise concentrations are virtually never known.\\n\\nFinally, note that there is no such thing as a concentration of 0. A concentration is a *relational* quality and so can't exist unless both entities it inheres in exist. However one map make concentration measurements that turn out not to be about concentrations qualities, if it happens that the scattered molecular aggregate doesn't actually exist."^^xsd:string,
        "logical definition in OBI:\\n  'quality of related physical entities'\\n  ('inheres in' some material_entity) and (towards some 'scattered molecular aggregate')"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"^^xsd:string ;
    ns1:IAO_0000119 "Discussion in Karslruhe, Oct 2008, with, among others, Alan Rector, Stefan Schulz, Marijke Keet, Melanie Courtot, and Alan Ruttenberg."^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000228 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000578 a owl:Class ;
    rdfs:label "NMR sample tube"@en ;
    ns1:IAO_0000111 "NMR sample tube"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The sample-tube holds the NMR sample and sits in the nmr probe. It is usually a glass tube of 5-20mm diameter."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400132"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR device"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom ns1:OBI_0000566 ],
        ns1:OBI_0000836 .

ns1:OBI_0000579 a owl:Class ;
    rdfs:label "Varian UNITY spectrometer"@en ;
    ns1:IAO_0000111 "Varian UNITY spectrometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The predecessor series of the Varian UNITY INOVA spectrometer."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400237"^^xsd:string,
        "WEB:<http://www.scs.uiuc.edu/NMR/instruments/u400.php>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000611 .

ns1:OBI_0000580 a owl:Class ;
    rdfs:label "AVANCE II spectrometer"@en ;
    ns1:IAO_0000111 "AVANCE II spectrometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A spectrometer suitable for metabolomics and in vivo NMR studies but structural analysis of small molecules and low molecular weight proteins can also be performed. To accomplish these studies there are six probe-heads available. A successor, the AVANCE III came out recently."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400197"^^xsd:string,
        "WEB:<http://cermax.itqb.unl.pt/mambo/en/index.php?option=com_content&task=view&id=36&Itemid=93>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000596 .

ns1:OBI_0000581 a owl:Class ;
    rdfs:label "y-column connector"@en ;
    ns1:IAO_0000111 "y-column connector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A column connector that connects one column on one side with two columns at the other side, hence building a Y shaped structure."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01237"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000478 .

ns1:OBI_0000582 a owl:Class ;
    rdfs:label "Bruker LC-NMR/MS platform"@en ;
    ns1:IAO_0000111 "Bruker LC-NMR/MS platform"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Includes the connection to a high-resolution TOF-LC-MS system."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400277"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "hyphenated NMR instrument platform"^^xsd:string,
        "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000596 .

ns1:OBI_0000583 a owl:Class ;
    rdfs:label "refractive index detector"@en ;
    ns1:IAO_0000111 "refractive index detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "For analyzing non-UV absorbing substances, such as carbohydrates, lipids and polymers. This is also the detector of choice for gel permeation chromatography. The refractive index detector is one of the least sensitive LC detectors. It is very sensitive to changes in ambient temperature, pressure changes, flow-rate changes and can not be used for gradient elution. Despite these many disadvantages, this detector is extremely useful for detecting those compounds that are nonionic, do not adsorb in the UV, and do not fluoresce. There are many optical systems used in refractive index detectors but one of the most common is the differential refractive index detector."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01081"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/HPLC/Refractive-Index/rs33.html>"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000584 a owl:Class ;
    rdfs:label "anion exchange column"@en ;
    ns1:IAO_0000111 "anion exchange column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An anion exchange column is a chromatography column that is used in anion exchange chromatography and which enables the separation of anion mixtures."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01095"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000560 .

ns1:OBI_0000586 a owl:Class ;
    rdfs:label "plunger column"@en ;
    ns1:IAO_0000111 "plunger column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A plunger column is a chromatography column with adjustable heigth control. By means of an adjustable endpiece (plunger) the user can adjust the column length without disturbing the packed bed. Plunger columns can equalize volume changes and thus avoids dead volumes within the column."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01108"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000588 a owl:Class ;
    rdfs:label "flame photometric detector"@en ;
    ns1:IAO_0000111 "flame photometric detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The determination of sulfur or phosphorus containing compounds is the job of the flame photometric detector (FPD). This device uses the chemiluminescent reactions of these compounds in a hydrogen/air flame as a source of analytical information that is relatively specific for substances containing these two kinds of atoms. The emitting species for sulfur compounds is excited S2. The lambda max for emission of excited S2 is approximately 394 nm. The emitter for phosphorus compounds in the flame is excited HPO (lambda max = doublet 510-526 nm). In order to selectively detect one or the other family of compounds as it elutes from the GC column, an interference filter is used between the flame and the photomultiplier tube (PMT) to isolate the appropriate emission band. The drawback here being that the filter must be exchanged between chromatographic runs if the other family of compounds is to be detected."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "FPD"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01091"^^xsd:string,
        "WEB:<http://www.shsu.edu/~chemistry/FPD/FPD.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000590 a owl:Class ;
    rdfs:label "Bruker 1mm MicroProbe"@en ;
    ns1:IAO_0000111 "Bruker 1mm MicroProbe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Over the past few years there has been a significantly growing demand for miniaturization in all areas ofmodern research and development. Evoked by many exciting applications, there is a need for analytical methods which require less amounts of sample. Bruker BioSpin meets this challenge with a revolutionary NMR probe design: The 1mm MicroProbe. It operates with disposable 1mm capillary sample tubes and the sample volume of 5 microliters enables the use of lowest amounts of sample to run all high resolution NMR experiments with outstanding sensitivity and up to 16 times faster measurements. Due to the TXI-type probe design, the z-gradient coil and the automatic matching and tuning accessory, the 1mm MicroProbe can be used for a wide variety of NMR experiments. The key advantages of this probe include:\\\\n   up to 4 times higher mass sensitivity than 5mm conventional probes (with respect to the same sample amount)\\\\n   excellent solvent suppression properties\\\\n   virtually no salt effect\\\\n   discrete samples in tubes that can be sealed and stored\\\\n   automation accessory for sample preparation and handling available."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400194"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000561 .

ns1:OBI_0000591 a owl:Class ;
    rdfs:label "Bruker BEST NMR system"@en ;
    ns1:IAO_0000111 "Bruker BEST NMR system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The introduction of biological screening and combinatorial chemistry for chemical synthesis has also introduced new requirements for NMR automation, e.g., the use of well plates for sample input, increased demands on throughput, and the need for quick and simple interpretation of the acquired NMR data."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "Bruker Efficient Sample Transfer NMR"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400206"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/automation.html>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000464 .

ns1:OBI_0000593 a owl:Class ;
    rdfs:label "cation trap column"@en ;
    ns1:IAO_0000111 "cation trap column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cation trap column is a trap column and ion-exchange column which contains anionic cation-exchange resins."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01278"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000518 .

ns1:OBI_0000594 a owl:Class ;
    rdfs:label "column adapter"@en ;
    ns1:IAO_0000111 "column adapter"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An Adapter that enabled the connection of a column to additional devices."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01113"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000595 a owl:Class ;
    rdfs:label "pulsed amperometric detector"@en ;
    ns1:IAO_0000111 "pulsed amperometric detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A chromatography detector as used by high-performance anion exchange chromatography that provides sensitive and specific detection of carbohydrates. Pulsed Electrochemical Detection (PED) allows simple, sensitive, and direct detection of numerous polar aliphatic compounds, especially carbohydrates. This technique exploits the electrocatalytic activity of noble metal electrode surfaces to oxidize various polar functional groups. In PED, multi-step potential-time waveforms at Au and Pt electrodes realize amperometric/coulometric detection while maintaining uniform and reproducible electrode activity. The response mechanisms in PED are dominated by the surface properties of the electrode, and, as a consequence, members of each chemical class of compounds produce virtually identical voltammetric responses. Thus, the full potential is realized when combined with high performance liquid chromatography (HPLC)."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "PAD"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01240"^^xsd:string,
        "WEB:<http://adsabs.harvard.edu/abs/2004SPIE.5261..103L>"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000598 a owl:Class ;
    rdfs:label "ozone-induced chemiluminescence detector"@en ;
    ns1:IAO_0000111 "ozone-induced chemiluminescence detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Although there are many direct ozone chemiluminescent reactions with various gaseous molecules, the incorporation of a conversion step to convert various non-chemiluminescent analytes to a species capable of reacting with ozone to produce chemiluminescence broadens the horizon of this technique tremendously. The conversion of nearly all nitrogen- and sulfur-containing compounds to their respective chemiluminescent species for universal nitrogen and sulfur detection has made nitrogen/sulfur chemiluminescence detection the most widely used analytical methods based upon ozone-induced chemiluminescence. In addition to non-chromatographic applications, nitrogen/sulfur chemiluminescence detection has been adapted to various chromatographic techniques from gas chromatography to liquid and supercritical fluid chromatography as specialized element-specific detectors. The characteristics of these detectors are evaluated and compared to other element-selective detection techniques. The unique features of the chemiluminescence detectors have made them powerful tools in many diverse fields of analytical chemistry."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01088"^^xsd:string,
        "WEB:<http://sangerhinxtongbr.library.ingentaconnect.com/content/els/00219673/1999/00000842/00000001/art00177>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000602 a owl:Class ;
    rdfs:label "column frit"@en ;
    ns1:IAO_0000111 "column frit"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A part of the column content that separates column packing compartments. In radial columns the packing is supported between two cylindrical frits and the gap between represents the bed height or column length. The outer frit is the column inlet and consequently the sample initially has a large area of stationary phase with which to interact. Frits are porous metal products to prevent unwanted particles from entering the chromatography system. These particles may come from the sample, the solvent or debris generated by the chromatography system itself. Such particles entering the system may lead to clogging of capillaries, interference with the chromatography by changing chromatographic parameters or disturbance of the detector function. Characteristics of a frit, besides the diameter and the thickness, is the porosity (pore distribution, density)."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01070"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/topics/radial/columns.html>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000603 a owl:Class ;
    rdfs:label "liquid chromatography column"@en ;
    ns1:IAO_0000111 "liquid chromatography column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A liquid chromatography column is a chromatography column that is used in liquid chromatography, i.e. a column that is provided with a liquid sample mix."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01227"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000604 a owl:Class ;
    rdfs:label "detector lamp"@en ;
    ns1:IAO_0000111 "detector lamp"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A lamp used in a chromatography detector that excites sample molecules at certain frequencies / emission wavelengths, e.g. Mercury Vapor Lamp (253.7 nm), Zinc Vapor Lamp (2123.9 nm and 307.6 nm), Cadmium Vapor Lamp (228.8, 326.1,340.3, and 346.6 nm). To obtain monochromatic light an appropriate light filter would be needed."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01119"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/HPLC/UV-Detectors/Fixed-Wavelength/rs23.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000601 .

ns1:OBI_0000605 a owl:Class ;
    rdfs:label "chart recorder"@en ;
    ns1:IAO_0000111 "chart recorder"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The chart recorder is a device that transduces signal-intensities into a graphical peak output: As the separated components of the gas sample emerge into the detector, the change in voltage in the detecting bridge circuit causes a representative peak to be drawn on a chart recorder. The position of the peak along the time axis of the chart measures the component's retention time, which identifies the component. This is directly related to carrier gas flow rate, temperature and column packing and dimensions. The area under each peak is proportional to the concentration of the component of the sample. The area of the peaks inscribed on the chart recorder can be determined by multiplying the height of the peak in mm, by the width of the peak in mm at 1/2 the peak height. The calibration curves for use with the chart recorder are therefore peak area plotted against concentration."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01069"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000606 a owl:Class ;
    rdfs:label "open tubular column"@en ;
    ns1:IAO_0000111 "open tubular column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An open tubular column is a chromatography column in which the particles of the solid stationary phase or the support coated with a liquid stationary phase are concentrated on or along the inside tube wall leaving an open, unrestricted path for the mobile phase in the middle part of the tube."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01219"^^xsd:string,
        "WEB:<http:www.iupac.org/publications/pac/1993/pdf/6504x0819.pdf>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000607 a owl:Class ;
    rdfs:label "high resolution magic angle spin probe"@en ;
    ns1:IAO_0000111 "high resolution magic angle spin probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Samples that are neither solid nor liquid, being of biological, chemical, or pharmaceutical interest, reveal highly resolved spectra when magic angle spinning is applied. The correct solution is a gradient, such that the field varies along the spinner axis. This so-called Magic Angle Gradient is employed in Brukers high resolution Magic Angle Spinning (hr-MAS) probes, and is implemented in such a way that it is compatible with the stator and does not interfere with the sample eject or insert. Bruker BioSpin has developed a series of dedicated probes for standard bore magnets to accommodate the rapidly expanding field of hr-MAS. These probes are available in double (e.g. 1H and 13C) and triple resonance (e.g. 1H, 13C, 15N) modes and come equipped with a deuterium lock channel. The probes have automatic sample ejection and insertion capability, with the availability of an optional sample changer, enabling fully automated sample runs. Probes can be equipped with an optional B0 gradient, directed along the magic angle, so that gradient spectroscopy can be done used."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "high resolution MAS, hr-MAS"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400192"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000480 .

ns1:OBI_0000608 a owl:Class ;
    rdfs:label "hydrogen generator"@en ;
    ns1:IAO_0000111 "hydrogen generator"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A gas generator that generates hydrogen gas."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01035"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000507 .

ns1:OBI_0000609 a owl:Class ;
    rdfs:label "glass column"@en ;
    ns1:IAO_0000111 "glass column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A glass column is a chromatography column made out of glass that is usually used for larger scale and preparative liquid chromatography separations."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01101"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000610 a owl:Class ;
    rdfs:label "auto injector"@en ;
    ns1:IAO_0000111 "auto injector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A gas chromatography device that can auto-inject a small number of samples an inlet."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01058"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000504 .

ns1:OBI_0000612 a owl:Class ;
    rdfs:label "Bruker MATCH tube holder system"@en ;
    ns1:IAO_0000111 "Bruker MATCH tube holder system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The Bruker Multiple Adjustable Tube Clamp Holder MATCH system is a holder for 100 mm long NMR sample tubes with diameters ranging from micro tubes up to 5 mm NMR tubes. The MATCH insert fits into a standard 10 mm Bruker spinner and is suitable for all non-spinning applications.\\\\n   The MATCH system provides an easy and cost efficient means of optimizing the signal-to-noise ratio of each sample. By matching the NMR tube diameter to the size of the sample, most of the sample can be placed in the active column of the NMR coil. This leads to an enhanced signal detection compared to diluting the same sample quantity in a larger tube."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "Bruker Multiple Adjustable Tube Clamp Holder"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400211"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000484 .

ns1:OBI_0000613 a owl:Class ;
    rdfs:label "Bruker SPE-NMR platform"@en ;
    ns1:IAO_0000111 "Bruker SPE-NMR platform"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A Solid Phase Extraction (SPE) system provides an interface between liquid chromatography (LC) and NMR. For the process of LC-SPE  NMR a chromatographic separation is done and the peaks of interest are trapped on an individual SPE cartridge after the column. The peak selection is done either by UV detection or by evaluation of the on-line registered MS or MSn spectra."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400278"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "hyphenated NMR instrument platform"^^xsd:string,
        "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000596 .

ns1:OBI_0000614 a owl:Class ;
    rdfs:label "guard column"@en ;
    ns1:IAO_0000111 "guard column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Guard columns are installed between the injection valve and the analytical or preparative column and here will remove contaminants and prolong the lifetime of the columns."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01111"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000615 a owl:Class ;
    rdfs:label "protein expression profiling assay" ;
    ns1:IAO_0000111 "protein expression profiling assay" ;
    ns1:IAO_0000112 "Protein Expression Profiling During Chick Retinal Maturation: A Proteomics-based approach. PMID:19077203"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that determines protein expression and translation activity using protein extracts collected from a material entity."^^xsd:string ;
    ns1:IAO_0000117 "Phlippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "proteomic analysis"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( ns1:OBI_0100051 [ a owl:Restriction ;
                                                                owl:onProperty ns1:BFO_0000051 ;
                                                                owl:someValuesFrom ns1:PR_000000001 ] ) ] ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0100051 [ a owl:Restriction ;
                                                        owl:onProperty ns1:BFO_0000051 ;
                                                        owl:someValuesFrom ns1:PR_000000001 ] ) ] [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        ns1:OBI_0000070 .

ns1:OBI_0000616 a owl:Class ;
    rdfs:label "high resolution probe with automatic tuning and matching"@en ;
    ns1:IAO_0000111 "high resolution probe with automatic tuning and matching"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The Automatic Tuning and Matching (ATM) option for AVANCE spectrometers is available for double resonance probes in fixed-frequency and broadband tunable configurations with either direct or indirect detection. Thus, for multinuclear operation, as often required for applications in inorganic chemistry, ATM facilitates the accurate setting of 90 degree pulse widths on both observe and decoupling channels for each chosen nucleus and each individual sample - even with full automation. Triple resonance probes in fixed-frequency configurations, as typically used for inverse detection with high-field systems."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "High Resolution Probes with Automatic Tuning and Matching, HR_probe_with_ATM"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400224"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000480 .

ns1:OBI_0000617 a owl:Class ;
    rdfs:label "fluorine-induced chemiluminescence detector"@en ;
    ns1:IAO_0000111 "fluorine-induced chemiluminescence detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A gas chromatographic detection system based on the low pressure, gas phase chemiluminescence of the reaction mixture of molecular fluorine with organo-sulfur, -selenium, and -tellurium compounds separated from (gas phase) headspace samples. This detector was originally developed in the research group of John Birks at the University of Colorado, USA and was manufactured and sold by Sievers Instruments (Boulder Colorado, USA). This system can be divided up into three parts: the chromatograph, transfer line, and reaction cell; PMT and photon counting electronics; and the molecular fluorine generator."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01087"^^xsd:string,
        "WEB:<http://www.shsu.edu/~chm_tgc/publications/JPP/chasteen.htm>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000619 a owl:Class ;
    rdfs:label "chromatography splitter"@en ;
    ns1:IAO_0000111 "chromatography splitter"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An adjustable restriction that is placed in the waste outlet to allow the necessary pressure to develop at the column inlet to force a flow (q ml/min) through the column. If the flow of mobile phase is Q ml/min then the waste flow will be (Q-q) ml/min. by adjusting the waste flow, the proportion of the sample entering the capillary column can be varied over a wide range of values and the necessary minimum permissible volume for the particular column in use can be selected for analysis. Unfortunately, the fraction taken in this way may not be representative of the original sample. This is due to the individual solutes in the mixture having different diffusivities and, thus, they distribute themselves across the sampling tube in an irregular manner. In general, the components with higher diffusivities (e.g., those solutes of lower molecular weight) will diffuse away from the bulk sample more quickly than those having lower diffusivities."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01041"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/EC-Dispersion/GC-Capillary-Columns/rs13.html>"@en ;
    ns1:IAO_0000232 "chromatography device"@en ;
    rdfs:subClassOf ns1:OBI_0000048 .

ns1:OBI_0000620 a owl:Class ;
    rdfs:label "Bruker micro imaging probe"@en ;
    ns1:IAO_0000111 "Bruker micro imaging probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "For medical, biological and material sciences research, avance imaging systems provide optimal object handling and performance with a variety of samples types. Two classes of imaging probes are available: in vivo probes for handling and sustaining live objects such as animals and plants, and conventional imaging probes for materials samples."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400225"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/probes_microimaging.html>"@en ;
    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000561 .

ns1:OBI_0000621 a owl:Class ;
    rdfs:label "custom made column"@en ;
    ns1:IAO_0000111 "custom made column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A custom made column ia a chromatography column which is specifically tailored according to the needs of the separation as requested by a scientist or working group."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01234"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000622 a owl:Class ;
    rdfs:label "gel permeation column"@en ;
    ns1:IAO_0000111 "gel permeation column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A gel permeation column is a chromatography column which is used in gel permeation chromatography and which employs as the stationary phase a swollen gel made by polymerizing and cross-linking styrene in the presence of a diluent which is a nonsolvent for the styrene polymer. The polymer to be analyzed is introduced at the top of the column and then is elutriated with a solvent. The polymer molecules diffuse through the gel at rates depending on their molecular size."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01103"^^xsd:string,
        "WEB:<http://composite.about.com/od/glossaries/l/bldef_g2419.htm>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000623 a owl:Class ;
    rdfs:label "NMR spectroscopy assay" ;
    ns1:IAO_0000111 "NMR spectroscopy assay" ;
    ns1:IAO_0000112 "Metabolic profiling studies on the toxicological effects of realgar in rats by (1)H NMR spectroscopy. Wei L, Liao P, Wu H, Li X, Pei F, Li W, Wu Y. Toxicol Appl Pharmacol. 2008 Nov 25. PMID: 19073202"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An assay that exploits the magnetic properties of certain nuclei (those with a spin) to resonate when placed in particular magnetic field conditions. Instruments recording NMR spectrum and sets of analysis can be used to deduce identity of chemical as well as composition of complex chemical mixtures."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "Nuclear magnetic resonance spectroscopy"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Nuclear_magnetic_resonance_spectroscopy"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000070 .

ns1:OBI_0000624 a owl:Class ;
    rdfs:label "Bruker SampleJet system"@en ;
    ns1:IAO_0000111 "Bruker SampleJet system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Bruker BioSpin introduces the SampleJet, a robot for NMR tube automation. The SampleJet has been consciously designed to meet the growing customer demand for simplicity, versatility and higher throughput in NMR sample tube automation.\\\\n  The SampleJet utilizes the modern-day industry standard for sample arrangements-the 96 well plate array. Therefore, the samples may be handled by standard lab automation devices before or after the NMR measurement."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400208"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/automation.html>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000464 .

ns1:OBI_0000625 a owl:Class ;
    rdfs:label "JEOL ECX NMR spectrometer"@en ;
    ns1:IAO_0000111 "JEOL ECX NMR spectrometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The ECX series of NMR spectrometers is designed for any laboratory needing an easy-to-use, reliable, routine NMR system. The ECX NMR series is available from 300 to 500 MHz. The console is designed around a modular, digital NMR electronics chassis controlled by an intelligent acquisition computer. For unprecedented flexibility, the JEOL NMR system offers a Windows XP, Mac OSX or LINUX. Both the workstation and spectrometer may be connected to a standard network, allowing seamless remote operation anywhere in the world."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400227"^^xsd:string,
        "WEB:<http://www.jeol.com/PRODUCTS/AnalyticalInstruments/NuclearMagneticResonance/ECX/tabid/145/Default.aspx>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000600 .

ns1:OBI_0000627 a owl:Class ;
    rdfs:label "quaternary pump system"@en ;
    ns1:IAO_0000111 "quaternary pump system"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A pump system that pump and mix up to four different solvents in parallel."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01047"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000589 .

ns1:OBI_0000628 a owl:Class ;
    rdfs:label "carbon nanotube column"@en ;
    ns1:IAO_0000111 "carbon nanotube column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Carbon nanotubes (CNTs) are known to have high thermal and mechanical stability and have the potential to be high-performance separation media that utilize the nanoscale interactions. CNT can be applied in long capillary tubes for the development of gas chromatography columns. A film of CNTs can be deposited by chemical vapor deposition (CVD) to form the stationary phase in the open tubular format. Altering the CVD conditions can vary the thickness and the morphology of the CNT film, which opens the possibility of selectivity tuning. The ability to fabricate long tubes coated with CNTs can be readily employed in other gas- and liquid-phase separations as well."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01107"^^xsd:string,
        "WEB:<http://pubs.acs.org/cgi-bin/abstract.cgi/ancham/2005/77/i21/abs/ac050812j.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

ns1:OBI_0000629 a owl:Class ;
    rdfs:label "Bruker solid magic angle spinning probe"@en ;
    ns1:IAO_0000111 "Bruker solid magic angle spinning probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Magic angle spinning, nowadays a routine technique for solids NMR, still offers the capability of innovation. The high mechanical performance of MAS probes in conjunction with efficient rf pulse techniques open new exciting fields in solids NMR of biological samples and in the field of quadrupolar nuclei."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "solid MAS probe"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400193"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000561 .

ns1:OBI_0000630 a owl:Class ;
    rdfs:label "hematology assay" ;
    ns1:IAO_0000111 "hematology assay" ;
    ns1:IAO_0000112 "Co-associations between insulin sensitivity and measures of liver function, subclinical inflammation, and hematology._PMID:18702943"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An assay that studies blood and blood producing organs using a variety of techniques and instruments"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "blood analysis"^^xsd:string,
        "haematology"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:IAO_0000030 [ a owl:Restriction ;
                                owl:onProperty ns1:IAO_0000136 ;
                                owl:someValuesFrom ns1:GO_0030097 ] ) ] ],
        ns1:OBI_0000070 .

ns1:OBI_0000631 a owl:Class ;
    rdfs:label "Varian MERCURY spectrometer"@en ;
    ns1:IAO_0000111 "Varian MERCURY spectrometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "MERCURYplus spectrometers provide superior control, stability, and performance for high-productivity environments. Surface-mount electronics enable a small footprint without compromising data quality. Modular design allows flexible configuration. Direct digital synthesis, linear amplifiers, and other innovative RF and digital technologies enable push-button operation."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400235"^^xsd:string,
        "WEB:<http://www.varianinc.com/cgi-bin/nav?varinc/docs/products/NMR/spectromet/mercury/index&cid=975JINLIKLRMPGLMNOILJ>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000611 .

ns1:OBI_0000632 a owl:Class ;
    rdfs:label "Bruker Metabolic Profiler"@en ;
    ns1:IAO_0000111 "Bruker Metabolic Profiler"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR platform for conducting metabonomics studies, traditional metabolism studies, and analysis of complex mixtures, featuring an Avance NMR spectrometer and a microTOF from Bruker Daltonics. By combining the structural resolving power of NMR with mass accuracy of the microTOF Bruker offers a complete system for metabolic research. The Metabolic Profiler provides a simple, easy to use and inexpensive base-system to acquire the spectroscopic data, needed to do basic metabolic profiling including metabonomic statistical analysis."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400199"^^xsd:string,
        "WEB:<http://www.bruker-biospin.com/metabolicprofiler.html>"@en ;
    ns1:IAO_0000232 "hyphenated NMR instrument platform"^^xsd:string,
        "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000596 .

ns1:OBI_0000633 a owl:Class ;
    rdfs:label "column heater"@en ;
    ns1:IAO_0000111 "column heater"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The glass liner can be fitted with a separate heater and the volatilization temperature can, thus, be controlled. This flash heater system is available in most chromatographs. By using a syringe with a long needle, the tip can be made to penetrate past the liner and discharge its contents directly into the column packing. This procedure is called 'on-column injection' and, as it reduces peak dispersion on injection and thus, provides higher column efficiencies, is often the preferred procedure."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01040"^^xsd:string,
        "WEB:<http://www.chromatography-online.org/GC/Injection-Devices/Open-Tubular-Column/rs15.html>"@en ;
    rdfs:subClassOf ns1:OBI_0000485 .

ns1:OBI_0000635 a owl:Class ;
    rdfs:label "JEOL CapNMR probe"@en ;
    ns1:IAO_0000111 "JEOL CapNMR probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The JEOL ECA and ECX NMR spectrometers now support the MRM/Protasis CapNMR Probe for well plate-based and microvial-based NMR analysis. The CapNMR probe is available at proton frequencies ranging from 300 MHz to 800 MHz in both indirect configurations (e.g. 1H{13C} and 1H {31P}) and also in triple resonance configurations (e.g. 1H{13C, 15N}, 1H{31P, 15N}). Both employ a high-strength z-directed field gradient. The flowprobes come with the choice of two flowcell volumes: a 5 μl flowcell with an NMR active volume of 2.5 μl, and a 10 μl flowcell with an NMR active volume of 5 μl. The fluidic connections are 75 μm i.d. and 1/32 o.d. FEP Teflon with hastelloy unions for exceptional solvent compatibility."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400233"^^xsd:string,
        "WEB:<http://www.jeol.com/PRODUCTS/AnalyticalInstruments/NuclearMagneticResonance/CapNMRProbe/tabid/396/Default.aspx>"@en ;
    ns1:IAO_0000232 "NMR probe"@en ;
    rdfs:subClassOf ns1:OBI_0000529 .

ns1:OBI_0000636 a owl:Class ;
    rdfs:label "acquisition computer"@en ;
    ns1:IAO_0000111 "acquisition computer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A Computer used for NMR, can be divided into central processing unit (CPU), consisting of instruction, interpretation and arithmetic unit plus fast access memory, and peripheral devices such as bulk data storage and input and output devices (including, via the interface, the spectrometer). Under software control, the computer controls the RF pulses and gradients necessary to acquire data, and process the data to produce spectra or images. Note that devices such as the spectrometer may themselves incorporate small computers."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400013"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000392 ],
        ns1:OBI_0400107 .

ns1:OBI_0000638 a owl:Class ;
    rdfs:label "gas purifier"@en ;
    ns1:IAO_0000111 "gas purifier"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Gas purifiers are instruments used for the removal of gas impurities like hydrocarbons, oxygen, and moisture from carrier gas and fuel gases for GC or GC-MS systems."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01036"^^xsd:string,
        "WEB:<http://www.sigmaaldrich.com/Area_of_Interest/Analytical__Chromatography/Gas_Chromatography/Accessories/SGT_Gas_Purifier.html>"@en ;
    ns1:IAO_0000232 "gas chromatography equipment"@en ;
    rdfs:subClassOf ns1:OBI_0000542 .

ns1:OBI_0000640 a owl:Class ;
    rdfs:label "indirect detection probe"@en ;
    ns1:IAO_0000111 "indirect detection probe"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An NMR probe designed to allow the indirect detection of acquisition nuclei."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400281"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    ns1:IAO_0000232 "NMR device"@en ;
    rdfs:subClassOf ns1:OBI_0000516 .

ns1:OBI_0000641 a owl:Class ;
    rdfs:label "JEOL ECA NMR spectrometer"@en ;
    ns1:IAO_0000111 "JEOL ECA NMR spectrometer"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The ECA series of NMR spectrometers is a high performance, research grade NMR system configurable to a wide range off applications. The ECA NMR is available from 300 to 930 MHz field strengths and is 1GHz ready. The system is designed around a modular, digital NMR electronics chassis controlled from a UNIX or Windows workstation and acquisition system. Both the workstation and spectrometer may be connected to a standard network, allowing seamless remote operation anywhere in the world."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400228"^^xsd:string,
        "WEB:<http://www.jeol.com/PRODUCTS/AnalyticalInstruments/NuclearMagneticResonance/ECA/tabid/146/Default.aspx>"@en ;
    ns1:IAO_0000232 "NMR instrument"@en ;
    rdfs:subClassOf ns1:OBI_0000600 .

ns1:OBI_0000642 a owl:Class ;
    rdfs:label "atomic emission detector"@en ;
    ns1:IAO_0000111 "atomic emission detector"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Instead of measuring simple gas phase (carbon containing) ions created in a flame as with the flame ionization detector, or the change in background current because of electronegative element capture of thermal electrons as with the electron capture detector, the AED has a much wider applicability because it is based on the detection of atomic emissions. The strength of the AED lies in the detector's ability to simultaneously determine the atomic emissions of many of the elements in analytes that elute from a GC capillary column (called eluants or solutes in some books). As eluants come off the capillary column they are fed into a microwave powered plasma (or discharge) cavity where the compounds are destroyed and their atoms are excited by the energy of the plasma. The light that is emitted by the excited particles is separated into individual lines via a photodiode array. The associated computer then sorts out the individual emission lines and can produce chromatograms made up of peaks from eluants that contain only a specific element."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000118 "AED"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01086"^^xsd:string,
        "WEB:<http://elchem.kaist.ac.kr/vt/chem-ed/sep/gc/detector/aed.htmt>"@en ;
    rdfs:subClassOf ns1:OBI_0000637 .

ns1:OBI_0000644 a owl:ObjectProperty ;
    rdfs:label "obsoleted_is_specified_information_intput_of"^^xsd:string ;
    ns1:IAO_0000111 "obsoleted_is_specified_information_intput_of"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Is the inverse relation of has_specfied_input_information"^^xsd:string ;
    ns1:IAO_0000116 "is replaced by is_specified_intput_of"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000103 ;
    rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteProperty> ;
    owl:deprecated true .

ns1:OBI_0000645 a owl:ObjectProperty ;
    rdfs:label "is grain of"@en ;
    ns1:IAO_0000111 "is grain of"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A relation between granular parts and the whole of which they are a part. Granular parts have indeterminate number such that removing one granular part does not necessarily damage or diminish the whole." ;
    ns1:IAO_0000116 "JAO: Added definition 2013-10-25 based on 'has grain', but both these terms seem problematic." ;
    ns1:IAO_0000117 "PERSON: Alan Ruttenberg"@en ;
    ns1:IAO_0000119 "Discussion in Karslruhe with, among others, Alan Rector, Stefan Schulz, Marijke Keet, Melanie Courtot, and Alan Ruttenberg. With inspiration from the paper Granularity, scale and collectivity: When size does and does not matter, Alan Recto, Jeremy Rogers, Thomas Bittner, Journal of Biomedical Informatics 39 (2006) 333-349"@en ;
    rdfs:subPropertyOf ns1:BFO_0000050 .

ns1:OBI_0000650 a owl:Class ;
    rdfs:label "differential expression analysis data transformation"@en ;
    ns1:IAO_0000111 "differential expression analysis data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A differential expression analysis data transformation is a data transformation that has an objective of differential expression analysis.  Frequently this data transformation involves summarizing or otherwise aggregating signals from various samples categorized into groups, and calculating measures of group differences from these aggregated signals."@en ;
    ns1:IAO_0000117 "Dan Berrios",
        "James Malone"@en,
        "Melanie Courtot"@en,
        "Monnie McGee"@en ;
    ns1:IAO_0000119 "WEB:"@en ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200031 ] .

ns1:OBI_0000651 a owl:Class ;
    rdfs:label "urine specimen"^^xsd:string ;
    ns1:IAO_0000111 "urine specimen"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a portion of urine collected from an organism"^^xsd:string ;
    ns1:IAO_0000116 "4/10/2011BP: It seems to me that the editor notes refer to a previous version, and are no longer relevant. "^^xsd:string,
        "This could be instead a kind of collection of secreted stuff. Among secreted stuff there is passive, and active. urine is secreted, passiv.  lavage is secreted, active"^^xsd:string,
        "are we happy calling collection of urine a material separation?"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0600005 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:OBI_0000112 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:UBERON_0001088 ],
        ns1:OBI_0001479 .

ns1:OBI_0000653 a owl:Class ;
    rdfs:label "fuzzy clustering objective"@en ;
    ns1:IAO_0000111 "fuzzy clustering objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A fuzzy clustering objective is a data transformation objective where the aim is to assign input objects (typically vectors of attributes) a probability that a point belongs to a class, where the number of class and their specifications are not known a priori."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"^^xsd:string,
        "PERSON: Ryan Brinkman"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0000658 a owl:Class ;
    rdfs:label "data representational model"^^xsd:string ;
    ns1:IAO_0000111 "data representational model"^^xsd:string ;
    ns1:IAO_0000112 "gene regulatory graph model"^^xsd:string,
        "phylogenetic tree"^^xsd:string,
        "protein interaction network"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Data representational model is an information content entity of the  relationships between data items. A data representational model is encoded in a data format specification such as for cytoscape or biopax."^^xsd:string ;
    ns1:IAO_0000117 "Melanie Courtot"^^xsd:string ;
    ns1:IAO_0000118 "data structure"^^xsd:string,
        "data structure specification"^^xsd:string ;
    ns1:IAO_0000119 "GROUP: OBI"^^xsd:string ;
    ns1:IAO_0000232 "2009-02-28: work on this term has been finalized during the OBI workshop winter 2009"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000033 .

ns1:OBI_0000665 a owl:Class ;
    rdfs:label "obsolete intracellular cytokine staining assay" ;
    ns1:IAO_0000111 "obsolete intracellular cytokine staining assay" ;
    ns1:IAO_0000112 "Permeabilizing T cells and staining them with fluorescent labeled anti-IFN-gamma antibodies"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The measurement of cytokines within the cytoplasm of a cell by permeabilizing the cell membrane to allow entry of specific antibodies, and counting the stained cells using a flow cytometer."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000118 " ICS"^^xsd:string,
        "ICCS"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000227 ;
    ns1:IAO_0100001 ns1:OBI_0000916 ;
    ns1:OBI_9991118 "intracellular cytokine staining (ICS)"^^xsd:string ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000667 a owl:Class ;
    rdfs:label "obsolete MHC multimer staining assay" ;
    ns1:IAO_0000111 "obsolete MHC multimer staining assay" ;
    ns1:IAO_0000112 "Measuring T cells that are specific for the SYFPEITHI peptide when presented by the murine MHC molecule H-2 Kd by staining them with a tetramer of peptide loaded MHC complexes."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An MHC multimer assay is an assay that detects T cells capable of binding the MHC:ligand complexes present in the multimer. The multimer is fluorescently labelled. The T cells bound to multimers are counted in a flow cytometer"^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000118 "MHC tetramer assay"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000227 ;
    ns1:IAO_0100001 ns1:OBI_1110179 ;
    ns1:OBI_9991118 "MHC tetramer/multimer staining"^^xsd:string ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000682 a owl:Class ;
    rdfs:label "obsolete_study result"^^xsd:string ;
    ns1:IAO_0000111 "study result"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Study result is an information content entity  that is a specified data output of a study."^^xsd:string ;
    ns1:IAO_0000119 "GROUP: OBI"^^xsd:string ;
    ns1:IAO_0000231 ns1:IAO_0000230 ;
    ns1:IAO_0000232 "2009-02-28: work on this term has been finalized during the OBI workshop winter 2009"^^xsd:string ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0000687 a owl:Class ;
    rdfs:label "nucleotide overhang cloning"^^xsd:string ;
    ns1:IAO_0000111 "nucleotide overhang cloning"^^xsd:string ;
    ns1:IAO_0000112 "Cloning vectors are commercially available and supplied in linearized form with 3' dT overhangs"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Nucleotide overhang cloning is the process of inserting nucleic acid into a vector using nucleotide overhangs used to prevent self ligation"^^xsd:string ;
    ns1:IAO_0000117 "Helen Parkinson"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0600064 .

ns1:OBI_0000692 a owl:Class ;
    rdfs:label "recombination enzyme based cloning"^^xsd:string ;
    ns1:IAO_0000111 "recombination enzyme based cloning"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a recombination enzyme based cloning is a recombinant vector cloning process that uses complementary nucleotide sequences in both the insert genetic material and the cloning vector with a recombination enzyme to directly create a recombinant vector"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0600064 .

ns1:OBI_0000693 a owl:Class ;
    rdfs:label "MeDIP-seq assay" ;
    ns1:IAO_0000111 "MeDIP-seq assay" ;
    ns1:IAO_0000112 "PMID: 18612301. A Bayesian deconvolution strategy for immunoprecipitation-based DNA methylome analysis. Down TA, Rakyan VK, Turner DJ, Flicek P, Li H, Kulesha E, Gr�_f S, Johnson N, Herrero J, Tomazou EM, Thorne NP, B�_ckdahl L, Herberth M, Howe KL, Jackson DK, Miretti MM, Marioni JC, Birney E, Hubbard TJ, Durbin R, Tavar�� S, Beck S. Nat Biotechnol. 2008 Jul;26(7):779-85."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A DNA methylation profiling assay that identifies methylated sites in genomic DNA and determines the methylation pattern that affect gene transcription using immunoprecipitation of methylated genomic DNA, creation of a library of corresponding DNA fragments (either single or paired-end fragments) and subsequent sequencing using parallelized sequencing methods."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "Methylated DNA immunoprecipitation sequencing assay"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Methylated_DNA_immunoprecipitation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
