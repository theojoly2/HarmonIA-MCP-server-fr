    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:subClassOf ns1:IAO_0000308 .

ns1:IAO_0000405 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has z coordinate value"@en ;
