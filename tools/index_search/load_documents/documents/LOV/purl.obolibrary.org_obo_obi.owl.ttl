    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A delivery form for hormonal replacement therapy that is a patch for transdermal administration."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002406 .

ns1:OBI_0002409 a owl:Class ;
    rdfs:label "cream delivery form for hormonal replacement therapy" ;
    ns1:IAO_0000111 "cream delivery form for hormonal replacement therapy" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A delivery form for hormonal replacement therapy that is a cream for transdermal administration."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002406 .

ns1:OBI_0002411 a owl:Class ;
    rdfs:label "indeterminate menopausal status" ;
    ns1:IAO_0000111 "indeterminate menopausal status" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A menopausal status that is neither pre- nor post-menopausal."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002410 .

ns1:OBI_0002412 a owl:Class ;
    rdfs:label "premenopausal status" ;
    ns1:IAO_0000111 "premenopausal status" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A menopausal status indicating that less than 6 months has passed since the last menstrual period and there has not been prior bilateral oophorectomy and not on estrogen replacement."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
