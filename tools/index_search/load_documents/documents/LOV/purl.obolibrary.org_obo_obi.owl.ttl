ns1:VO_0000001 a owl:Class ;
    rdfs:label "vaccine" ;
    ns1:IAO_0000111 "vaccine" ;
    ns1:IAO_0000115 "A vaccine is a processed material with the function that when administered, it prevents or ameliorates a disorder in a target organism by inducing or modifying adaptive immune responses specific to the antigens in the vaccine." ;
    ns1:IAO_0000412 ns1:vo.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:VO_0000002 a owl:Class ;
    rdfs:label "vaccination" ;
    ns1:IAO_0000111 "vaccination" ;
    ns1:IAO_0000115 "a process of administering substance in vivo that involves in adding a vaccine into a host (e.g., human) in vivo with the intent to invoke a protective or therapeutic adaptive immune response." ;
    ns1:IAO_0000412 ns1:vo.owl ;
    rdfs:subClassOf ns1:OBI_0600007 .

