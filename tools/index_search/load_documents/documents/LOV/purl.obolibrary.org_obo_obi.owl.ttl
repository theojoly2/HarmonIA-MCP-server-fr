ns1:OBI_0000017 a owl:Class ;
    rdfs:label "regulatory role"@en ;
    ns1:IAO_0000111 "regulatory role"@en ;
    ns1:IAO_0000112 "Regulatory agency, Ethics committee, Approval letter; example:  Browse these EPA Regulatory Role subtopics  http://www.epa.gov/ebtpages/enviregulatoryrole.html  Feb 29, 2008"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role which inheres in material entities and is realized in the processes of making, enforcing or being defined by legislation or orders issued by a governmental body."@en ;
    ns1:IAO_0000117 "GROUP:  Role branch"@en ;
    ns1:IAO_0000119 "OBI, CDISC"@en ;
    ns1:IAO_0000232 "govt agents responsible for creating regulations; proxies for enforcing regulations.  CDISC definition:  regulatory authorities. Bodies having the power to regulate. NOTE: In the ICH GCP guideline the term includes the authorities that review submitted clinical data and those that conduct inspections. These bodies are sometimes referred to as competent"@en ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_0000073 a owl:Class ;
    rdfs:label "sample preparation for assay"@en ;
    ns1:IAO_0000111 "sample preparation for assay"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A sample_preparation_for_assay is a protocol_application including material_enrollments and biomaterial_transformations. definition_source: OBI."@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000118 "study"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0000075 a owl:Class ;
    rdfs:label "diagnosis textual entity"@en ;
    ns1:IAO_0000111 "diagnosis textual entity"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "diagnosis is an assessment of a disease or injury, its likely prognosis and treatment."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:IAO_0000300 .

ns1:OBI_0000124 a owl:ObjectProperty ;
    rdfs:label "is_supported_by_data" ;
    ns1:IAO_0000111 "is_supported_by_data" ;
    ns1:IAO_0000112 "The relation between the conclusion \"Gene tpbA is involved in EPS production\" and the data items produced using two sets of organisms, one being a tpbA knockout, the other being tpbA wildtype tested in polysacharide production assays and analyzed using an ANOVA. "^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "The relation between a data item and a conclusion where the conclusion is the output of a data interpreting process and the data item is used as an input to that process"^^xsd:string ;
    ns1:IAO_0000117 "OBI" ;
    ns1:IAO_0000119 "OBI",
        "Philly 2011 workshop"^^xsd:string ;
    rdfs:domain ns1:OBI_0001909 ;
    rdfs:range ns1:IAO_0000027 .

ns1:OBI_0000134 a owl:Class ;
    rdfs:label "hardware testing objective"@en ;
    ns1:IAO_0000111 "hardware testing objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Hardware_testing_objective is a methodology_testing_objective role describing a study designed to examine the effects of using different hardware, e.g. scanner."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000208 .

ns1:OBI_0000164 a owl:Class ;
    rdfs:label "cDNA library"@en ;
    ns1:IAO_0000111 "cDNA library"@en ;
    ns1:IAO_0000112 "PMID:6110205. collection of cDNA derived from mouse splenocytes."@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Mixed population of cDNAs (complementaryDNA) made from mRNA from a defined source, usually a specific cell type. This term should be associated only to nucleic acid interactors not to their proteins product. For instance in 2h screening use living cells (MI:0349) as sample process.\\n\\nALT DEF (PRS):: a cDNA library is a collection of host cells, typically E.Coli cells but not exclusively. modified by transfer of plasmid DNA molecule used as vector containing a fragment or totality of cDNA molecule (the insert) .  cDNA library may have an array of role and applications."@en ;
    ns1:IAO_0000117 "PERSON: Luisa Montecchi"@en,
        "PERSON: Philippe Rocca-Serra"@en ;
    ns1:IAO_0000119 "GROUP: PSI"@en ;
    ns1:IAO_0000232 "PRS: 22022008. class moved under population,\\nmodification of definition and replacement of biomaterials in previous definition with 'material'\\naddition of has_role restriction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000643 ;
            owl:someValuesFrom ns1:OBI_0000731 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0600064 ],
        ns1:OBI_0000731 .

ns1:OBI_0000242 a owl:Class ;
    rdfs:label "software testing objective"@en ;
    ns1:IAO_0000111 "software testing objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Software_testing_objective is a hardware_optimization role describing a study designed to examine the effects of using different software or software parameters, e.g. data processing software."@en ;
    ns1:IAO_0000117 "Jennifer Fostel"@en ;
    rdfs:subClassOf ns1:OBI_0000208 .

ns1:OBI_0000248 a owl:Class ;
    rdfs:label "feed role"@en ;
    ns1:IAO_0000111 "feed role"^^xsd:string ;
    ns1:IAO_0000112 "Purina rat chow; cited use:  Control; F = feed (rat chow); W = water; F. g. = feed-ginger concentrate. www.academicjournals.org/AJB/PDF/pdf2007/19Sep/Egwurugwu%20et%20al.pdf -  Feb 29, 2008"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a role that inheres in a material entity and is realized in the use of that material entity by lab animal to provide all needed nourishment."^^xsd:string ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "feed"^^xsd:string ;
    ns1:IAO_0000119 "OBI"@en ;
    rdfs:subClassOf ns1:OBI_0000162 .

ns1:OBI_0000253 a owl:Class ;
    rdfs:label "artificially induced nucleic acid hybridization"@en ;
    ns1:IAO_0000111 "artificially induced nucleic acid hybridization"@en ;
    ns1:IAO_0000112 "www.ornl.gov/sci/techresources/Human_Genome/publicat/97pr/09gloss.html, http://www.accessexcellence.org/RC/VL/GG/nucleic.html, http://omrf.ouhsc.edu/~frank/HYBNOTES.html. http://en.wikipedia.org/wiki/Nucleic_acid_hybridization,http://www.pnas.org/cgi/reprint/46/8/1044.pdf"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "Is a material transformation in which strands of nucleic acids that are (somewhat) complementary form a double-stranded molecule. Has input at least two single stranded molecules of nucleic acid molecules."@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        ns1:OBI_0000094 .

ns1:OBI_0000272 a owl:Class ;
    rdfs:label "protocol"@en ;
    ns1:IAO_0000111 "protocol"@en ;
    ns1:IAO_0000112 "PCR protocol, has objective specification, amplify DNA fragment of interest, and has action specification describes the amounts of experimental reagents used (e..g. buffers, dNTPS, enzyme), and the temperature and cycle time settings for running the PCR."@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A plan specification which has sufficient level of detail and quantitative information to communicate it between investigation agents, so that different investigation agents will reliably be able to independently reproduce the process."@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived + wikipedia (http://en.wikipedia.org/wiki/Protocol_%28natural_sciences%29)"@en ;
    ns1:OBI_0001847 "study protocol"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000104 .

ns1:OBI_0000273 a owl:Class ;
    rdfs:label "role of regulator of consumables and medical devices"@en ;
    ns1:IAO_0000111 "role of regulator of consumables and medical devices"^^xsd:string ;
    ns1:IAO_0000112 "FDA, EMEA; http://www.fda.gov/; The International Conference of Drug Regulatory Authorities (ICDRAs) provide drug regulatory authorities of WHO Member States with a forum to meet and discuss ways to strengthen collaboration.http://www.who.int/medicines/areas/quality_safety/regulation_legislation/icdra/en/index.html"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a regulator involved with making and enforcing legislation and governmental orders relevant to the development, testing, manufacture and use of food, drugs and medical devices"@en ;
    ns1:IAO_0000117 "Person: Jennifer Fostel"@en ;
    ns1:IAO_0000118 "drug regulatoy authority"^^xsd:string ;
    ns1:IAO_0000119 "OBI, CDISC"@en ;
    rdfs:subClassOf ns1:OBI_0000014 .

ns1:OBI_0000291 a owl:Class ;
    rdfs:label "transcription factor binding site assay" ;
    ns1:IAO_0000111 "transcription factor binding site assay" ;
    ns1:IAO_0000112 "Transcription factor binding site identification in yeast: a comparison of high-density oligonucleotide and PCR-based microarray platforms."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay tthat determines DNA regions specifically recognized by proteins that function as transcription factors"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "TF binding"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    ns1:IAO_0000233 "https://sourceforge.net/p/obi/obi-terms/767/"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:IAO_0000030 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:IAO_0000136 ;
                    owl:someValuesFrom ns1:OBI_0000794 ] ],
        ns1:OBI_0001146 .

ns1:OBI_0000318 a owl:Class ;
    rdfs:label "eluate"@en ;
    ns1:IAO_0000111 "eluate"@en ;
    ns1:IAO_0000112 "Raman spectroscopic detection of haemoproteins in the eluate from high-performance liquid chromatography. J Chromatogr. 1983 Jan 7;254:285-8. PMID: 6298263"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a eluate is a material entity which results from an elution, e.g. from a chromatography column. it has as part a material entity with role mobile phase"@en ;
    ns1:IAO_0000116 "need to add restriction to indicate: has_part some (material entity has_role mobile phase)\\nneed to add mobile phase as role"@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "eluted material"@en ;
    ns1:IAO_0000119 "OBI Bionaterial"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0302905 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:CHEBI_23367 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:OBI_0302732 ] ) ] ],
        ns1:OBI_0000047 .

ns1:OBI_0000339 a owl:Class ;
    rdfs:label "planning"@en ;
    ns1:IAO_0000111 "planning"^^xsd:string ;
    ns1:IAO_0000112 "The process of a scientist thinking about and deciding what reagents to use as part of a protocol for an experiment. Note that the scientist could be human or a \"robot scientist\" executing software."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a process of creating or modifying a plan specification"@en ;
    ns1:IAO_0000116 "7/18/2011 BP: planning used to itself be a planned process. Barry Smith pointed out that this would lead to an infinite regression, as there would have to be a plan to conduct a planning process, which in itself would be the result of planning etc. Therefore, the restrictions on 'planning' were loosened to allow for informal processes that result in an 'ad hoc plan '. This required changing from 'has_specified_output some plan specifiction' to 'has_participant some plan specification'. "^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "Bjoern Peters"^^xsd:string,
        "Plans and Planned Processes Branch"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000015 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000057 ;
                        owl:someValuesFrom ns1:IAO_0000104 ] ) ],
        ns1:BFO_0000015 .

ns1:OBI_0000364 a owl:Class ;
    rdfs:label "ion detector"@en ;
    ns1:IAO_0000111 "ion detector"@en ;
    ns1:IAO_0000112 "The ion detector of the Voyager-DE(tm) STR Biospectrometry Workstation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An ion detector is a device that measures and records\\nthe charge induced or current produced when an ion passes by or hits a\\nsurface. \\n\\nExample: In a scanning instrument the signal produced in the detector\\nduring the course of the scan versus where the instrument is in the\\nscan (at what m/Q) will produce a mass spectrum, a record of ions as a\\nfunction of m/Q."@en ;
    ns1:IAO_0000117 "Frank Gibson"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Mass_spectrometry#Detector"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom ns1:OBI_0000453 ],
        ns1:OBI_0000832 .

ns1:OBI_0000368 a owl:Class ;
    rdfs:label "record function"@en ;
    ns1:IAO_0000111 "record function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A record function is a function that registers or collects information in a particular format on a particular recording medium. For example on paper or a digital representation"@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0000375 a owl:Class ;
    rdfs:label "freeze function"@en ;
    ns1:IAO_0000111 "freeze function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A freeze function is a function to decrease the internal kinetic energy of a material below the freezing point of that type of material."@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0000385 a owl:Class ;
    rdfs:label "ionization function"@en ;
    ns1:IAO_0000111 "ionization function"@en ;
    ns1:IAO_0000112 "The ion source in amass spectrometer"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An ionization function is a function to physically convert an atom or molecule into an ion by adding or removing charged particles such as electrons or other ions."@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    ns1:IAO_0000119 "http://en.wikipedia.org/wiki/Ionization"@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0000387 a owl:Class ;
    rdfs:label "cool function"@en ;
    ns1:IAO_0000111 "cool function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A cool function is a function to decrease the internal kinetic energy of a material below the initial kinetic energy of that type of material."@en ;
    ns1:IAO_0000117 "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000034 .

ns1:OBI_0000395 a owl:Class ;
    rdfs:label "signal amplification function"@en ;
    ns1:IAO_0000111 "signal amplification function"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "A signal amplification function is a signal conversion function to inject energy into an input signal so as to produce an output signal with increased differential magnitude while also seeking to minimize increases in the signal to noise ratio. For example, to produce a 0.1 KW output signal from a 1 mW RMS input signal."@en ;
    ns1:IAO_0000117 "Bill Bug"^^xsd:string,
        "Daniel Schober"^^xsd:string,
        "Frank Gibson"^^xsd:string,
        "Melanie Courtot"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000393 .

ns1:OBI_0000416 a owl:Class ;
    rdfs:label "cloning insert role"@en ;
    ns1:IAO_0000111 "cloning insert role"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000121 ;
    ns1:IAO_0000115 "cloning insert role is a role which inheres in DNA or RNA and is realized by the process of being inserted into a cloning vector in a cloning process."@en ;
    ns1:IAO_0000116 "Feb 20, 2009.  from Wikipedia:  cloning of any DNA fragment essentially involves four steps: DNA fragmentation with restriction endonucleases, ligation of DNA fragments to a vector, transfection, and screening/selection.  There are multiple processes involved, it is not just \"cloning process\""^^xsd:string ;
    ns1:IAO_0000117 "GROUP: Role branch"^^xsd:string ;
    ns1:IAO_0000119 "OBII and Wikipedia"^^xsd:string ;
    rdfs:subClassOf ns1:BFO_0000023 .

ns1:OBI_0000439 a owl:Class ;
    rdfs:label "agarose gel"@en ;
    ns1:IAO_0000111 "agarose gel"@en ;
    ns1:IAO_0000112 "Performance comparison of capillary and agarose gel electrophoresis for the identification and characterization of monoclonal immunoglobulins. Am J Clin Pathol. 2008 Mar;129(3):451-8. PMID: 18285269"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a material entity resulting from the polymerization of agarose after heating agarose suspended in some buffer solution"@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string ;
