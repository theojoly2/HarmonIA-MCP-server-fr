ns1:IAO_0000323 a owl:Class ;
    rdfs:label "author contributions section"@en ;
    ns1:IAO_0000111 "author contributions section"@en ;
    ns1:IAO_0000112 "LH conceived of the hypothesis, designed the study and contributed to the writing of the manuscript.  KBC executed the experiments, analyzed the data, and contributed to the writing of the manuscript."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A part of a publication that is about the specific contributions of each author"@en ;
    ns1:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    ns1:IAO_0000118 "author contributions"@en,
        "contributions by the authors"@en ;
