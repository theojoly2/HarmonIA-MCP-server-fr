<http://example.com/bfo-spec-label> ns1:IAO_0000119 "Person:Alan Ruttenberg" .

ns2:defaultLanguage a owl:AnnotationProperty .

ns1:BFO_0000005 a owl:Class ;
    rdfs:label "obsolete dependent continuant"@en ;
    ns1:IAO_0000115 "A continuant  that is either dependent on one or other independent continuant  bearers or inheres in or is borne by other entities."@en ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:BFO_0000179 a owl:AnnotationProperty ;
    rdfs:label "BFO OWL specification label"@en ;
    ns1:IAO_0000115 "Relates an entity in the ontology to the name of the variable that is used to represent it in the code that generates the BFO OWL file from the lispy specification."@en ;
    ns1:IAO_0000232 "Really of interest to developers only"@en ;
    rdfs:subPropertyOf rdfs:label .

ns1:BFO_0000180 a owl:AnnotationProperty ;
    rdfs:label "BFO CLIF specification label"@en ;
    ns1:IAO_0000115 "Relates an entity in the ontology to the term that is used to represent it in the the CLIF specification of BFO2"@en ;
    ns1:IAO_0000119 "Person:Alan Ruttenberg" ;
    ns1:IAO_0000232 "Really of interest to developers only"@en ;
    rdfs:subPropertyOf rdfs:label .

ns1:CHEBI_15377 a owl:Class ;
    rdfs:label "water"^^xsd:string ;
    ns1:IAO_0000111 "water"^^xsd:string ;
    ns1:IAO_0000115 "An oxygen hydride consisting of an oxygen atom that is covalently bonded to two hydrogen atoms."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_15956 a owl:Class ;
    rdfs:label "biotin"^^xsd:string ;
    ns1:IAO_0000111 "biotin"^^xsd:string ;
    ns1:IAO_0000115 "An organic heterobicyclic compound that consists of 2-oxohexahydro-1H-thieno[3,4-d]imidazole having a valeric acid substituent attached to the tetrahydrothiophene ring. The parent of the class of biotins."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:REO_0000280 .

ns1:CHEBI_17137 a owl:Class ;
    rdfs:label "hydrogensulfite"^^xsd:string ;
    ns1:IAO_0000111 "hydrogensulfite"^^xsd:string ;
    ns1:IAO_0000115 "A sulfur oxoanion that has formula HO3S."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_17709 a owl:Class ;
    rdfs:label "5'-adenylyl sulfate"^^xsd:string ;
    ns1:IAO_0000111 "5'-adenylyl sulfate"^^xsd:string ;
    ns1:IAO_0000115 "An adenosine 5'-phosphate having a sulfo group attached to one the phosphate OH groups."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_23995 a owl:Class ;
    rdfs:label "N-ethyl-N-nitrosourea"^^xsd:string ;
    ns1:IAO_0000111 "N-ethyl-N-nitrosourea"^^xsd:string ;
    ns1:IAO_0000115 "A member of the class of N-nitrosoureas that is urea in which one of the nitrogens is substituted by ethyl and nitroso groups."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_24636 a owl:Class ;
    rdfs:label "proton"^^xsd:string ;
    ns1:IAO_0000111 "proton"^^xsd:string ;
    ns1:IAO_0000115 "Nuclear particle of charge number +1, spin 1/2 and rest mass of 1.007276470(12) u."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_25078 a owl:Class ;
    rdfs:label "luciferin"^^xsd:string ;
    ns1:IAO_0000111 "luciferin"^^xsd:string ;
    ns1:IAO_0000115 "A low-molecular-mass compound present in bioluminescent organisms that emits light when oxidized in presence of enzyme luciferase."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_27889 a owl:Class ;
    rdfs:label "lead(0)"^^xsd:string ;
    ns1:IAO_0000111 "lead(0)"^^xsd:string ;
    ns1:IAO_0000115 "An elemental lead that has formula Pb."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_29191 a owl:Class ;
    rdfs:label "hydroxyl"^^xsd:string ;
    ns1:IAO_0000111 "hydroxyl"^^xsd:string ;
    ns1:IAO_0000115 "An oxygen radical that has formula HO."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_30682 a owl:Class ;
    rdfs:label "ruthenium atom"^^xsd:string ;
    ns1:IAO_0000111 "ruthenium atom"^^xsd:string ;
    ns1:IAO_0000115 "An iron group element atom that has formula Ru."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_31624 a owl:Class ;
    rdfs:label "fluorescein"^^xsd:string ;
    ns1:IAO_0000111 "fluorescein"^^xsd:string ;
    ns1:IAO_0000115 "A xanthene dye that is highly fluorescent, detectable even when present in minute quantities. Used forensically to detect traces of blood, in analytical chemistry as an indicator in silver nitrate titrations and in microscopy."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:REO_0000280 .

ns1:CHEBI_31642 a owl:Class ;
    rdfs:label "gadodiamide hydrate"^^xsd:string ;
    ns1:IAO_0000111 "gadodiamide hydrate"^^xsd:string ;
    ns1:IAO_0000115 "The hydrate of gadodiamide."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_31643 a owl:Class ;
    rdfs:label "gadoteridol"^^xsd:string ;
    ns1:IAO_0000111 "gadoteridol"^^xsd:string ;
    ns1:IAO_0000115 "A non-ionic gadolinium chelate having a macrocyclic tetraamine framework. It is used as a paramagnetic contrast agent in magnetic resonance imaging (MRI)."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_31991 a owl:Class ;
    rdfs:label "phenol red"^^xsd:string ;
    ns1:IAO_0000111 "phenol red"^^xsd:string ;
    ns1:IAO_0000115 "3H-2,1-Benzoxathiole 1,1-dioxide in which both of the hydrogens at position 3 have been substituted by 4-hydroxyphenyl groups. A pH indicator changing colour from yellow below pH 6.8 to bright pink above pH 8.2, it is commonly used as an indicator in cell cultures and in home swimming pool test kits. It is also used in the (now infrequently performed) phenolsulfonphthalein (PSP) test for estimation of overall blood flow through the kidney."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_33359 a owl:Class ;
    rdfs:label "rhodium atom"^^xsd:string ;
    ns1:IAO_0000111 "rhodium atom"^^xsd:string ;
    ns1:IAO_0000115 "A cobalt group element atom that has formula Rh."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_33375 a owl:Class ;
    rdfs:label "gadolinium atom"^^xsd:string ;
    ns1:IAO_0000111 "gadolinium atom"^^xsd:string ;
    ns1:IAO_0000115 "A lanthanoid atom that has formula Gd."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_33376 a owl:Class ;
    rdfs:label "terbium atom"^^xsd:string ;
    ns1:IAO_0000111 "terbium atom"^^xsd:string ;
    ns1:IAO_0000115 "A lanthanoid atom that has formula Tb."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_35729 a owl:Class ;
    rdfs:label "gadolinium molecular entity"^^xsd:string ;
    ns1:IAO_0000111 "gadolinium molecular entity"^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_37333 a owl:Class ;
    rdfs:label "gadodiamide"^^xsd:string ;
    ns1:IAO_0000111 "gadodiamide"^^xsd:string ;
    ns1:IAO_0000115 "A non-ionic gadolinium chelate having a macrocyclic triamine framework. It is used as a paramagnetic contrast agent in magnetic resonance imaging (MRI)."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CHEBI_37972 a owl:Class ;
    rdfs:label "phosphorus-32 atom"^^xsd:string ;
    ns1:IAO_0000111 "phosphorus-32 atom"^^xsd:string ;
    ns1:IAO_0000115 "The radioactive isotope of phosphorus with relative atomic mass 31.973907 and half-life of 14.26 days."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:CHEBI_33250 .

ns1:CHEBI_37973 a owl:Class ;
    rdfs:label "phosphorus-33 atom"^^xsd:string ;
    ns1:IAO_0000111 "phosphorus-33 atom"^^xsd:string ;
    ns1:IAO_0000115 "The radioactive isotope of phosphorus with relative atomic mass 32.971725, half-life of 25.34 days and nuclear spin (1)/2."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:CHEBI_33250 .

