ns1:OBI_0000668 a owl:Class ;
    rdfs:label "error correction data transformation"@en ;
    ns1:IAO_0000111 "error correction data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An error correction data transformation is a data transformation that has the objective of error correction, where the aim is to remove (correct for) erroneous contributions from the input to the data transformation."@en ;
    ns1:IAO_0000117 "Monnie McGee"^^xsd:string,
        "James Malone"@en ;
    ns1:IAO_0000119 "EDITORS"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200186 ] .

ns1:OBI_0000689 a owl:Class ;
    rdfs:label "454 Genome Sequence 20"^^xsd:string ;
    ns1:IAO_0000111 "454 Genome Sequence 20"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18946007.Pyrosequencing analysis of the oral microflora of healthy adults. \\nKeijser BJ, Zaura E, Huse SM, van der Vossen JM, Schuren FH, Montijn RC, ten Cate JM, Crielaard W. J Dent Res. 2008 Nov;87(11):1016-20."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "is a DNA sequencer which is manufactured by 454 Life Science Corporation and enables pyrosequencing to be performed. It comprises both optics and fluidics subsystems, which are\\ncontrolled by a computer subsystem. The fluidics subsystem ensures accurate reagent dispensing. It consists of a reagents cassette (which holds the reagent containers), a sipper manifold, pumps, valves, and debubblers. The fluidics subsystem flows the sequencing reagents across the wells of the PicoTiterPlate device, and moves the spent reagents from the PicoTiterPlate device to the waste receptacle. The optics subsystem consists of a CCD camera and a camera controller. The camera captures the light emitted in the wells of the PicoTiterPlate device during each step of the sequencing cycle, and sends the digital images to the computer subsystem for processing. The computer controls the other Sequencer subsystems, and processes the digital images sent by the camera to extract the DNA sequence information."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "GS 20"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:OBI_0000758 ;
            owl:onProperty ns1:OBI_0000304 ],
        ns1:OBI_0400103 .

ns1:OBI_0000691 a owl:Class ;
    rdfs:label "ABI 377 automated sequencer"^^xsd:string ;
    ns1:IAO_0000111 "ABI 377 automated sequencer"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "is a DNA sequencer which is manufactured by Applied Biosystems corporation (formerly Perkin-Elmer). It allows automated chain termination DNA sequencing. It has part polyacrylamide gel electrophoresis system and a laser -based detection system to detect fluorescence intensity emitted by the dyes attached to the dideoxyterminator nucleotides or to the primers."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "Applied Biosystems"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:OBI_0000776 ;
            owl:onProperty ns1:OBI_0000304 ],
        ns1:OBI_0400103 .

ns1:OBI_0000702 a owl:Class ;
    rdfs:label "454 Genome Sequencer FLX"^^xsd:string ;
    ns1:IAO_0000111 "454 Genome Sequencer FLX"^^xsd:string ;
    ns1:IAO_0000112 "PMID: 18616967. The Genome Sequencer FLX System--longer reads, more applications, straight forward bioinformatics and more complete data sets.  Droege M, Hill B.\\nJ Biotechnol. 2008 Aug 31;136(1-2):3-10."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "is a DNA sequencer which is manufactured by 454 Life Science Corporation and enables pyrosequencing to be performed. It comprises both optics and fluidics subsystems, which are\\ncontrolled by a computer subsystem. The fluidics subsystem ensures accurate reagent dispensing. It consists of a reagents cassette (which holds the reagent containers), a sipper manifold, pumps, valves, and debubblers. The fluidics subsystem flows the sequencing reagents across the wells of the PicoTiterPlate device, and moves the spent reagents from the PicoTiterPlate device to the waste receptacle. The optics subsystem consists of a CCD camera and a camera controller. The camera captures the light emitted in the wells of the PicoTiterPlate device during each step of the sequencing cycle, and sends the digital images to the computer subsystem for processing. The computer controls the other Sequencer subsystems, and processes the digital images sent by the camera to extract the DNA sequence information."^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "454 GS FLX"^^xsd:string,
        "GS-FLX"^^xsd:string ;
    ns1:IAO_0000119 "adapted from https://www.roche-applied-science.com/servlet/RCProductDisplay?langId=-1&storeId=10202&productId=3.8.8.1.1.3&catalogId=10202&krypto=mgV8a0Sdps6%2BCXU8IoddmzNEyGgjde9j8MOFCiMzRsduELeenAlVZ%2FE1QR%2BxLpzNlqMZPLRHqaI%3D&ddkey=https:RCProductDisplay"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:OBI_0000758 ;
            owl:onProperty ns1:OBI_0000304 ],
        ns1:OBI_0400103 .

ns1:OBI_0000704 a owl:Class ;
    rdfs:label "decision tree induction objective"^^xsd:string ;
    ns1:IAO_0000111 "decision tree induction objective"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A decision tree induction objective is a data transformation objective in which a tree-like graph of edges and nodes is created and from which the selection of each branch requires that some type of logical decision is made."^^xsd:string ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0000707 a owl:Class ;
    rdfs:label "decision tree building data transformation"@en ;
    ns1:IAO_0000111 "decision tree building data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A decision tree building data transformation is a data transformation that has objective decision tree induction."@en ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000704 ] .

ns1:OBI_0000710 a owl:Class ;
    rdfs:label "Li-Cor 4300 DNA Analysis System"^^xsd:string ;
    ns1:IAO_0000111 "Li-Cor 4300 DNA Analysis System"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "is a DNA sequencer which is manufactured by Li-Cor corporation and enable automated chain termination based DNA sequencing"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "OBI and Li-Cor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:OBI_0000769 ;
            owl:onProperty ns1:OBI_0000304 ],
        ns1:OBI_0400103 .

ns1:OBI_0000715 a owl:Class ;
    rdfs:label "animal care protocol"^^xsd:string ;
    ns1:IAO_0000111 "animal care protocol"^^xsd:string ;
    ns1:IAO_0000112 "Keeping mice in the UCSD animals facility at 20 - 25 degrees celsius, in cages of 4 animals each and providing food twice daily."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An animal care protocol is a protocol which specifies the environment in which animals are being kept in captivity for research purposes"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "Bjoern Peters"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000272 .

ns1:OBI_0000717 a owl:Class ;
    rdfs:label "HeliScope Single Molecule Sequencer"^^xsd:string ;
    ns1:IAO_0000111 "HeliScope Single Molecule Sequencer"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "is a DNA sequencer manufacturer by Helicos Corporation to carry out Single Molecule sequencing using reversible termination chemistry"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ns1:OBI_0000757 ;
            owl:onProperty ns1:OBI_0000304 ],
        ns1:OBI_0400103 .

ns1:OBI_0000725 a owl:Class ;
    rdfs:label "host role"^^xsd:string ;
    ns1:IAO_0000111 "host role"^^xsd:string ;
    ns1:IAO_0000112 "In biology, a host is an organism that harbors a virus or parasite, or a mutual or commensal symbiont, typically providing nourishment and shelter.  http://en.wikipedia.org/wiki/Host_(biology)  30 March 09"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "host role is a role played by an organism and realized by providing nourishment, shelter or a means of reproduction to another organism within the organism playing the host role"^^xsd:string ;
    ns1:IAO_0000116 "30Mar09 virus reproducing inside a cell; bacteria causing a disease, host can be harmed or not.  we want to avoid a cat sitting on my lap and an animal care technician; these are not examples or hosts; dental cares = on tooth, but part of outer layer of tooth, so covered by \"within\" in the definition"^^xsd:string ;
    ns1:IAO_0000117 "GROUP: Role Branch"^^xsd:string ;
    ns1:IAO_0000119 "30 Mar09 submitted by vaccine community"^^xsd:string,
        "OBI"^^xsd:string,
        "http://en.wikipedia.org/wiki/Host_(biology)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:OBI_0100026 ],
        ns1:BFO_0000023 .

ns1:OBI_0000740 a owl:Class ;
    rdfs:label "material sample role"^^xsd:string ;
    ns1:IAO_0000111 "material sample role"^^xsd:string ;
    ns1:IAO_0000112 "a role borne by a portion of blood taken to represent all the blood in an organism; the role borne by a population of humans with HIV enrolled in a study taken to represent patients with HIV in general."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A material sample role is a specimen role borne by a material entity that is the output of a material sampling process."^^xsd:string ;
    ns1:IAO_0000116 "7/13/09: Note that this is a relational role: between the sample taken and the 'sampled' material of which the sample is thought to be representative off."^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000112 .

ns1:OBI_0000742 a owl:Class ;
    rdfs:label "nucleic acid restriction enzyme digest"^^xsd:string ;
    ns1:IAO_0000111 "nucleic acid restriction enzyme digest"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A nucleic acid digest is a material that is the output of a process in which nucleic acids are combined with a restriction enzyme resulting in digested fragments with defined ends based on the enzymes cleavage site"^^xsd:string ;
    ns1:IAO_0000117 "Kevin Clancy, Bjoern Peters"^^xsd:string ;
    rdfs:subClassOf ns1:CHEBI_33696,
        ns1:OBI_0000047 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:CHEBI_33696 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0600050 [ a owl:Restriction ;
                                            owl:onProperty ns1:OBI_0000293 ;
                                            owl:someValuesFrom ns1:CHEBI_33696 ] [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000057 ;
                                            owl:someValuesFrom ns1:OBI_0000732 ] ) ] ] ) ] .

