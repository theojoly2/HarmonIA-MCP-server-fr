    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A device that is used to isolate and collect nucleic acids (DNA or RNA) for subsequent molecular analysis."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Erik Segerdell"^^xsd:string ;
