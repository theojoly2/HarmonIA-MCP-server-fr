ns1:OBI_1110013 a owl:Class ;
    rdfs:label "ELISPOT assay measuring epitope specific interleukin-2 production by T cells" ;
    ns1:IAO_0000111 "ELISPOT assay measuring epitope specific interleukin-2 production by T cells" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay of epitope specific interleukin-2 production by T cells that uses an ELISPOT assay."^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "ELISPOT"^^xsd:string,
        "IL-2 release"^^xsd:string ;
