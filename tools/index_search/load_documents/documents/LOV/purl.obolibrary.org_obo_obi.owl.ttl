ns1:OBI_0002413 a owl:Class ;
    rdfs:label "perimenopausal status" ;
    ns1:IAO_0000111 "perimenopausal status" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A menopausal status indicating that it has been 6-12 months since last menstrual period."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002410 .

ns1:OBI_0002414 a owl:Class ;
    rdfs:label "postmenopausal status" ;
    ns1:IAO_0000111 "postmenopausal status" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A menopausal status indicating that it has been more than 12 months since the last menstrual period with no prior hysterectomy or that there has been a prior bilateral oophorectomy."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "NCI BBRB, OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002410 .

