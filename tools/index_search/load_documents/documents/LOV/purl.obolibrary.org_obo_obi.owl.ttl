    ns1:IAO_0000234 "ENCODE DCC"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000716 .

ns1:OBI_0002163 a owl:Class ;
    rdfs:label "DNAse footprinting assay" ;
    ns1:IAO_0000111 "DNAse footprinting assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An enzymatic footprinting assay that determines protein-binding sites on DNA by identifying bound fragments that are protected from DNAse I-catalyzed hydrolysis"^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "OBI development call"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002162 .

ns1:OBI_0002164 a owl:Class ;
    rdfs:label "mammalian 2-hybrid assay" ;
    ns1:IAO_0000111 "mammalian 2-hybrid assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A binding assay that increases the expression of a reporter gene in mammalian cells by proteins of interest attached to two portions of the transcriptional activator, bringing those portions closer together."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "ECO:0001095"^^xsd:string,
        "PMID:9043710"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0001146 .

