ns1:OBI_0001205 a owl:Class ;
    rdfs:label "cell component comparison design"@en ;
    ns1:IAO_0000111 "cell component comparison design"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design that compares samples from different cell components."^^xsd:string ;
    ns1:IAO_0000117 "Person: Chris Stoeckert, Jie Zheng"^^xsd:string ;
    ns1:IAO_0000119 "MO_1019 cell_component_comparison_design"@en ;
