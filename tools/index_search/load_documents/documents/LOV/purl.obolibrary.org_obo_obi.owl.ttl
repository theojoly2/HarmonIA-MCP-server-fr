    ns1:IAO_0000112 "PMID: 17334176.Hum Exp Toxicol. 2007 Jan;26(1):9-18.Is there a role for PCR-SSCP among the methods for missense mutation detection of TP53 gene?"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "An assay that identifies DNA sequence variation (mutation, deletion, insertions) in target DNA sequences amplified using polymerase chain reaction using gel electrophoresis and denaturating conditions"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000118 "polymerase chain reaction-single strand conformation polymorphism assay"^^xsd:string ;
    ns1:IAO_0000119 "PMID:18219595"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
