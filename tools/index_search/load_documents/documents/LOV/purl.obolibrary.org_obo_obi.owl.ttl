rdfs:label a owl:AnnotationProperty ;
    rdfs:label "label" ;
    ns1:IAO_0000111 "label" .

xsd:integer a rdfs:Datatype .

ns1:BFO_0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en ;
    ns1:IAO_0000111 "occurs in"@en ;
    ns1:IAO_0000115 "b occurs_in c =def b is a process and c is a material entity or immaterial entity& there exists a spatiotemporal region r and b occupies_spatiotemporal_region r.& forall(t) if b exists_at t then c exists_at t & there exist spatial regions s and s’ where & b spatially_projects_onto s at t& c is occupies_spatial_region s’ at t& s is a proper_continuant_part_of s’ at t"@en ;
    ns1:IAO_0000118 "occurs_in"@en,
        "unfolds in"@en,
        "unfolds_in"@en ;
    rdfs:comment "Paraphrase of definition: a relation between a process and an independent continuant, in which the process takes place entirely within the independent continuant" ;
    rdfs:domain ns1:BFO_0000003 ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:range ns1:BFO_0000004 ;
    owl:equivalentProperty [ owl:inverseOf ns1:BFO_0000067 ] ;
    owl:inverseOf ns1:BFO_0000067 ;
    owl:propertyChainAxiom ( ns1:BFO_0000050 ns1:BFO_0000066 ),
        ( ns1:BFO_0000066 ns1:BFO_0000050 ) .

ns1:BFO_0000142 a owl:Class ;
    rdfs:label "one-dimensional continuant fiat boundary"@en ;
    ns1:BFO_0000179 "1d-cf-boundary" ;
    ns1:BFO_0000180 "OneDimensionalContinuantFiatBoundary" ;
    ns1:IAO_0000112 "The Equator"@en,
        "all geopolitical boundaries"@en,
        "all lines of latitude and longitude"@en,
        "the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin."@en,
        "the median sulcus of your tongue"@en ;
    ns1:IAO_0000600 "a one-dimensional continuant fiat boundary is a continuous fiat line whose location is defined in relation to some material entity. (axiom label in BFO2 Reference: [032-001])"@en ;
    ns1:IAO_0000602 "(iff (OneDimensionalContinuantFiatBoundary a) (and (ContinuantFiatBoundary a) (exists (b) (and (OneDimensionalSpatialRegion b) (forall (t) (locatedInAt a b t)))))) // axiom label in BFO2 CLIF: [032-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000140 ;
    owl:disjointWith ns1:BFO_0000146,
        ns1:BFO_0000147 .

ns1:BFO_0000148 a owl:Class ;
    rdfs:label "zero-dimensional temporal region"@en ;
    ns1:BFO_0000179 "0d-t-region" ;
    ns1:BFO_0000180 "ZeroDimensionalTemporalRegion" ;
    ns1:IAO_0000112 "a temporal region that is occupied by a process boundary"@en,
        "right now"@en,
        "the moment at which a child is born"@en,
        "the moment at which a finger is detached in an industrial accident"@en,
        "the moment of death."@en ;
    ns1:IAO_0000118 "temporal instant."@en ;
    ns1:IAO_0000600 "A zero-dimensional temporal region is a temporal region that is without extent. (axiom label in BFO2 Reference: [102-001])"@en ;
    ns1:IAO_0000602 "(forall (x) (if (ZeroDimensionalTemporalRegion x) (TemporalRegion x))) // axiom label in BFO2 CLIF: [102-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000008 .

ns1:CL_0000789 a owl:Class ;
    rdfs:label "alpha-beta T cell"^^xsd:string ;
    ns1:IAO_0000111 "alpha-beta T cell"^^xsd:string ;
    ns1:IAO_0000115 "A T cell that expresses an alpha-beta T cell receptor complex."^^xsd:string ;
    ns1:IAO_0000412 ns1:cl.owl ;
    rdfs:subClassOf ns1:CL_0000084 .

ns1:ENVO_00010483 a owl:Class ;
    rdfs:label "environmental material"^^xsd:string ;
    ns1:IAO_0000111 "environmental material"^^xsd:string ;
    ns1:IAO_0000115 "A portion of environmental material is a fiat object which forms the medium or part of the medium of an environmental system."^^xsd:string ;
    ns1:IAO_0000412 ns1:envo.owl ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:GO_0001788 a owl:Class ;
    rdfs:label "antibody-dependent cellular cytotoxicity"^^xsd:string ;
    ns1:IAO_0000111 "antibody-dependent cellular cytotoxicity"^^xsd:string ;
    ns1:IAO_0000115 "Cytolysis of target cells by natural killer cells, eosinophils, neutrophils, monocytes, or macrophages following engagement of antibodies bound to the target cells by Fc receptors on the effector cells."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:GO_0001806 a owl:Class ;
    rdfs:label "type IV hypersensitivity"^^xsd:string ;
    ns1:IAO_0000111 "type IV hypersensitivity"^^xsd:string ;
    ns1:IAO_0000115 "An inflammatory response driven by T cell recognition of processed soluble or cell-associated antigens leading to cytokine release and leukocyte activation."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0002524 .

ns1:GO_0001913 a owl:Class ;
    rdfs:label "T cell mediated cytotoxicity"^^xsd:string ;
    ns1:IAO_0000111 "T cell mediated cytotoxicity"^^xsd:string ;
    ns1:IAO_0000115 "The directed killing of a target cell by a T cell through the release of granules containing cytotoxic mediators or through the engagement of death receptors."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0001906 .

ns1:GO_0002250 a owl:Class ;
    rdfs:label "adaptive immune response"^^xsd:string ;
    ns1:IAO_0000111 "adaptive immune response"^^xsd:string ;
    ns1:IAO_0000115 "An immune response mediated by cells expressing specific receptors for antigen produced through a somatic diversification process, and allowing for an enhanced secondary response to subsequent exposures to the same antigen (immunological memory)."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0006955 .

ns1:GO_0002517 a owl:Class ;
    rdfs:label "T cell tolerance induction"^^xsd:string ;
    ns1:IAO_0000111 "T cell tolerance induction"^^xsd:string ;
    ns1:IAO_0000115 "A process involving any mechanism for tolerance induction in T cells."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0002507 .

ns1:GO_0008228 a owl:Class ;
    rdfs:label "opsonization"^^xsd:string ;
    ns1:IAO_0000111 "opsonization"^^xsd:string ;
    ns1:IAO_0000115 "The process in which a microorganism (or other particulate material) is rendered more susceptible to phagocytosis by coating with an opsonin, a blood serum protein such as a complement component or antibody."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0006909 .

ns1:GO_0009987 a owl:Class ;
    rdfs:label "cellular process"^^xsd:string ;
    ns1:IAO_0000111 "cellular process"^^xsd:string ;
    ns1:IAO_0000115 "Any process that is carried out at the cellular level, but not necessarily restricted to a single cell. For example, cell communication occurs among more than one cell, but occurs at the cellular level."^^xsd:string ;
    ns1:IAO_0000412 ns1:go.owl ;
    rdfs:subClassOf ns1:GO_0008150 .

