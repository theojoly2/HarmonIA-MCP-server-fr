            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:CHEBI_16991 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000053 ;
                                owl:someValuesFrom ns1:OBI_0000444 ] ) ] ],
        ns1:OBI_0001152 .

ns1:OBI_0600063 a owl:Class ;
    rdfs:label "vector mediated expression"@en ;
    ns1:IAO_0000111 "vector mediated expression"@en ;
    ns1:IAO_0000112 "Construction of pRSS1327 expression vector by molecular cloning of a 1327-bp cDNA, which includes sequences of the entire coding region for RSS, into pBluescript. Expression in Escherichia coli of a functional, full-length RSS was confirmed by immunoblot analysis and enzymatic activity."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "vector mediated expression sis the generation of copies of biomaterial by in a cell_culture modified for this purpose by insertion of an expression vector"@en ;
    ns1:IAO_0000116 "needs defined relationship to cell culture"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0600064 .

ns1:OBI_0600065 a owl:Class ;
    rdfs:label "obsolete_defined processes"@en ;
    ns1:IAO_0000111 "_defined processes"@en ;
    ns1:IAO_0000114 ns1:IAO_0000121 ;
    ns1:IAO_0000115 "Place holder class, see editor note"@en ;
    ns1:IAO_0000116 "Remove to simplify OBI release\\nDiscussed on 2012 Ann Arbor OBI wokshop"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000231 ns1:IAO_0000226 ;
    rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
    owl:deprecated true .

ns1:OBI_0600067 a owl:Class ;
    rdfs:label "specific labeling"@en ;
    ns1:IAO_0000111 "specific labeling"@en ;
    ns1:IAO_0000112 "The addition of anti-CD8 antibody for an ICCS assay in order to selectively stain the CD8+ cells"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a labeling in which the labeling reagent used  has a specificity to bind only certain components of the input material"@en ;
    ns1:IAO_0000117 "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    ns1:IAO_0000232 "definition blessed by Allyson, Bjoern, Jay & Randi"@en ;
    rdfs:subClassOf ns1:OBI_0600038 .

ns1:OBI_1000023 a owl:Class ;
    rdfs:label "cell culture supernatant"@en ;
    ns1:IAO_0000111 "cell culture supernatant"@en ;
    ns1:IAO_0000112 "solution containing RPMI, fetal calf sera, antibiotics, and monoclonal antibody UCHT1.\\nIsolation of proliferation factor of immature T-cell clone in concanavalin A-stimulated splenocyte culture supernatant. Immunology. 2003 Jun;109(2):209-16. PMID: 12757615"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "Supernatant of a cell culture is a material entity which contains media, supplements, and secreted products of the cells and becomes the environment of cultivated cell."@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"@en ;
    ns1:IAO_0000119 "GROUP: IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0600029 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:OBI_0000079 ],
        ns1:OBI_0000047 .

ns1:OBI_1000024 a owl:Class ;
    rdfs:label "cell pellet"@en ;
    ns1:IAO_0000111 "cell pellet"@en ;
    ns1:IAO_0000112 "Detection of fetal DNA in a cell pellet after centrifugation of mountant. J Forensic Sci. 2003 Jan;48(1):135-6. PMID: 12570214"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A material entity which results from the aggregation of cells produced by the application of centrifugal force to a liquid containing cells in suspension"@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string,
        "PERSON: Helen Parkinson"@en ;
    ns1:IAO_0000119 "GROUP: OBI Biomaterial Branch"^^xsd:string,
        "GROUP: CEBS"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0302886 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:OBI_0100060 ns1:OBI_0100067 ) ] ],
        ns1:OBI_0000047 .

ns1:OBI_1000042 a owl:Class ;
    rdfs:label "peptide construct"@en ;
    ns1:IAO_0000111 "peptide construct"@en ;
    ns1:IAO_0000112 "Multiple Antigenic Peptide (MAP) construct containing T and B cell epitopes from p. falciparum congugated to a central glycin\\n\\nA novel multivalent human CTL peptide construct elicits robust cellular immune responses in HLA-A*0201 transgenic mice: implications for HTLV-1 vaccine design. Vaccine. 2003 Jun 20;21(21-22):2767-81. PMID: 12798617"@en ;
    ns1:IAO_0000114 ns1:IAO_0000122 ;
    ns1:IAO_0000115 "a material entity synthesized to contain a number of peptides conjugated together in a non-linear fashion"@en ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0302892 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:CHEBI_16670 ],
        ns1:OBI_0000047 .

ns1:OBI_1000048 a owl:Class ;
    rdfs:label "transgenic organism"@en ;
    ns1:IAO_0000111 "transgenic organism"@en ;
    ns1:IAO_0000112 "HLA-A*0201 transgenic mice, Vaccinia virus expressing the LCMV gp protein\\nPossible ecological risks of transgenic organism release when transgenes affect mating success: sexual selection and the Trojan gene hypothesis. Proc Natl Acad Sci U S A. 1999 Nov 23;96(24):13853-6. PMID: 10570162"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a transgenic organism is material entity which derives from an organism which has been modified to express a gene not normally part of it"@en ;
    ns1:IAO_0000116 "PRS:22-02-2008: is a organism which has output_role during genetic modification of type (KO) protocol-application"@en ;
    ns1:IAO_0000117 "PERSON: Philippe Rocca-Serra"^^xsd:string,
        "PERSON: Bjoern Peters"@en ;
    ns1:IAO_0000119 "GROUP:IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom ns1:OBI_0600043 ],
        ns1:OBI_0302859 .

