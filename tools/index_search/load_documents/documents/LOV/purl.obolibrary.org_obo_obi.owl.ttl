    ns1:IAO_0000111 "subcellular protein localization assay" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A protein localization assay that determines the specific subcellular location of a protein. The location is visualized through electron microscopy."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "ECO"^^xsd:string ;
