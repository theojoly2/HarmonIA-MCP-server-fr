ns1:PATO_0000140 a owl:Class ;
    rdfs:label "position"^^xsd:string ;
    ns1:IAO_0000111 "position"^^xsd:string ;
    ns1:IAO_0000115 "A spatial quality inhering in a bearer by virtue of the bearer's spatial location relative to other objects in the vicinity."^^xsd:string ;
    ns1:IAO_0000412 ns1:pato.owl ;
    rdfs:subClassOf ns1:PATO_0001018 .

ns1:RO_0000058 a owl:ObjectProperty ;
    rdfs:label "is concretized as"@en ;
    ns1:IAO_0000112 "A journal article is an information artifact that inheres in some number of printed journals. For each copy of the printed journal there is some quality that carries the journal article, such as a pattern of ink. The journal article (a generically dependent continuant) is concretized as the quality (a specifically dependent continuant), and both depend on that copy of the printed journal (an independent continuant)."@en,
        "An investigator reads a protocol and forms a plan to carry out an assay. The plan is a realizable entity (a specifically dependent continuant) that concretizes the protocol (a generically dependent continuant), and both depend on the investigator (an independent continuant). The plan is then realized by the assay (a process)."@en ;
    ns1:IAO_0000115 "A relationship between a generically dependent continuant and a specifically dependent continuant, in which the generically dependent continuant depends on some independent continuant in virtue of the fact that the specifically dependent continuant also depends on that same independent continuant. A generically dependent continuant may be concretized as multiple specifically dependent continuants."@en ;
    rdfs:domain ns1:BFO_0000031 ;
    rdfs:range ns1:BFO_0000020 ;
    owl:equivalentProperty [ owl:inverseOf ns1:RO_0000059 ] ;
    owl:inverseOf ns1:RO_0000059 .

ns1:BFO_0000018 a owl:Class ;
    rdfs:label "zero-dimensional spatial region"@en ;
    ns1:BFO_0000179 "0d-s-region" ;
    ns1:BFO_0000180 "ZeroDimensionalSpatialRegion" ;
    ns1:IAO_0000600 "A zero-dimensional spatial region is a point in space. (axiom label in BFO2 Reference: [037-001])"@en ;
    ns1:IAO_0000602 "(forall (x) (if (ZeroDimensionalSpatialRegion x) (SpatialRegion x))) // axiom label in BFO2 CLIF: [037-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000006 ;
    owl:disjointWith ns1:BFO_0000028 .

ns1:BFO_0000028 a owl:Class ;
    rdfs:label "three-dimensional spatial region"@en ;
    ns1:BFO_0000179 "3d-s-region" ;
    ns1:BFO_0000180 "ThreeDimensionalSpatialRegion" ;
    ns1:IAO_0000112 "a cube-shaped region of space"@en,
        "a sphere-shaped region of space,"@en ;
    ns1:IAO_0000600 "A three-dimensional spatial region is a spatial region that is of three dimensions. (axiom label in BFO2 Reference: [040-001])"@en ;
    ns1:IAO_0000602 "(forall (x) (if (ThreeDimensionalSpatialRegion x) (SpatialRegion x))) // axiom label in BFO2 CLIF: [040-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000006 .

ns1:BFO_0000035 a owl:Class ;
    rdfs:label "process boundary"@en ;
    ns1:BFO_0000179 "p-boundary" ;
    ns1:BFO_0000180 "ProcessBoundary" ;
    ns1:IAO_0000112 "the boundary between the 2nd and 3rd year of your life."@en ;
    ns1:IAO_0000115 "p is a process boundary =Def. p is a temporal part of a process & p has no proper temporal parts. (axiom label in BFO2 Reference: [084-001])"@en ;
    ns1:IAO_0000601 "Every process boundary occupies_temporal_region a zero-dimensional temporal region. (axiom label in BFO2 Reference: [085-002])"@en ;
    ns1:IAO_0000602 "(forall (x) (if (ProcessBoundary x) (exists (y) (and (ZeroDimensionalTemporalRegion y) (occupiesTemporalRegion x y))))) // axiom label in BFO2 CLIF: [085-002] ",
        "(iff (ProcessBoundary a) (exists (p) (and (Process p) (temporalPartOf a p) (not (exists (b) (properTemporalPartOf b a)))))) // axiom label in BFO2 CLIF: [084-001] " ;
    rdfs:isDefinedBy ns1:bfo.owl ;
    rdfs:subClassOf ns1:BFO_0000003 .

ns1:CHEBI_16670 a owl:Class ;
    rdfs:label "peptide"^^xsd:string ;
    ns1:IAO_0000111 "peptide"^^xsd:string ;
    ns1:IAO_0000115 "Amide derived from two or more amino carboxylic acid molecules (the same or different) by formation of a covalent bond from the carbonyl carbon of one to the nitrogen atom of another with formal loss of water. The term is usually applied to structures formed from alpha-amino acids, but it includes those derived from any amino carboxylic acid. X = OH, OR, NH2, NHR, etc."^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_33839 .

ns1:CHEBI_33839 a owl:Class ;
    rdfs:label "macromolecule"^^xsd:string ;
    ns1:IAO_0000111 "macromolecule"^^xsd:string ;
    ns1:IAO_0000115 "A macromolecule is a molecule of high relative molecular mass, the structure of which essentially comprises the multiple repetition of units derived, actually or conceptually, from molecules of low relative molecular mass."^^xsd:string ;
    ns1:IAO_0000118 "polymer"@en ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf ns1:CHEBI_23367 .

ns1:CLO_0000001 a owl:Class ;
    rdfs:label "cell line cell"^^xsd:string ;
    ns1:IAO_0000111 "cell line cell"^^xsd:string ;
    ns1:IAO_0000115 "A cultured cell that is part of a cell line - a stable and homogeneous population of cells with a common biological origin and propagation history in culture\\n",
        "A cultured cell that is part of a cell line - a stable and homogeneous population of cells with a common biological origin and propagation history in culture"@en ;
    ns1:IAO_0000412 ns1:clo.owl ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000312 ;
                        owl:someValuesFrom ns1:OBI_0001867 ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0001000 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:OBI_0000312 ;
                                owl:someValuesFrom ns1:OBI_0001867 ] ] ) ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001000 ;
            owl:someValuesFrom ns1:CL_0000001 ],
        ns1:OBI_0001866 .

ns1:IAO_0000064 a owl:Class ;
    rdfs:label "algorithm"@en ;
    ns1:IAO_0000111 "algorithm"@en ;
    ns1:IAO_0000112 "PMID: 18378114.Genomics. 2008 Mar 28. LINKGEN: A new algorithm to process data in genetic linkage studies."@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A plan specification which describes the inputs and output of mathematical functions as well as workflow of execution for achieving an predefined objective. Algorithms are realized usually by means of implementation as computer programs for execution by automata."@en ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"@en,
        "PlanAndPlannedProcess Branch"@en ;
    ns1:IAO_0000119 "OBI_0000270"@en,
        "adapted from discussion on OBI list (Matthew Pocock, Christian Cocos, Alan Ruttenberg)"@en ;
    rdfs:subClassOf ns1:IAO_0000104 .

