ns1:OBI_0001536 a owl:Class ;
    rdfs:label "equilibrium dissociation constant (KD)"^^xsd:string ;
    ns1:IAO_0000111 "equilibrium dissociation constant (KD)"^^xsd:string ;
    ns1:IAO_0000112 "KD = 32 nM is the equilibrium dissociation rate found for peptide SIINFEKL binding to H-2 Kb"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A binding constant defined as the ratio of kon over koff (on-rate of binding divided by off-rate)"^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
