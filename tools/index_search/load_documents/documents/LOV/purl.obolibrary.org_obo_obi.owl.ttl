            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000681 ],
        ns1:OBI_0600014 .

ns1:OBI_0000518 a owl:Class ;
    rdfs:label "trap column"@en ;
    ns1:IAO_0000111 "trap column"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A trap column is a chromatography column which is used prior to a, e.g. mass spectrometry, separation to clean up or concentrate controlled amounts of samples prior to elution to a detector."@en ;
    ns1:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns1:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01261"^^xsd:string,
        "GROUP:<http://msi-ontology.sourceforge.net>"@en ;
    rdfs:subClassOf ns1:OBI_0000038 .

