                                owl:someValuesFrom ns1:BFO_0000029 ] ) ] ],
        ns1:OBI_0000011 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty ns1:RO_0000059 ;
                    owl:someValuesFrom ns1:OBI_0000715 ] ] .

ns1:OBI_0000723 a owl:Class ;
    rdfs:label "DNA sequencing by ligation assay" ;
    ns1:IAO_0000111 "DNA sequencing by ligation assay" ;
    ns1:IAO_0000112 "ABI Solid Sequencing uses the ligation-based DNA sequencing technology (https://en.wikipedia.org/wiki/ABI_Solid_Sequencing)."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A DNA sequencing assay that performs chain extension during the sequencing reaction step using DNA ligase"^^xsd:string ;
    ns1:IAO_0000117 "Philippe Rocca-Serra"^^xsd:string ;
    ns1:IAO_0000119 "url:https://en.wikipedia.org/wiki/Sequencing_by_ligation"^^xsd:string ;
