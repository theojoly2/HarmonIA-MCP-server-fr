    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "An assay that determines the concentration of glucose molecules in a blood serum sample"^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
