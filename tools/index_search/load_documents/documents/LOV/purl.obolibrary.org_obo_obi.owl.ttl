ns1:OBI_0002415 a owl:Class ;
    rdfs:label "exposure to environmental and workplace carcinogens history" ;
    ns1:IAO_0000111 "exposure to environmental and workplace carcinogens history" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A information content entity that indicates the exposure of an individual to carcinogens in the workplace or environment."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
    ns1:IAO_0000119 "OBIB"^^xsd:string ;
    ns1:IAO_0000234 "NCI BBRB"^^xsd:string ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:OBI_0002590 a owl:Class ;
    rdfs:label "molecular interaction identification design" ;
    ns1:IAO_0000111 "molecular interaction identification design" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A study design that investigates the features of interaction between molecules."^^xsd:string ;
    ns1:IAO_0000117 "Rebecca Tauber"^^xsd:string ;
    ns1:IAO_0000119 "person:RCT"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000131 ],
        ns1:OBI_0500000 .

ns1:OBI_0200081 a owl:Class ;
    rdfs:label "sequence analysis objective"@en ;
    ns1:IAO_0000111 "sequence analysis objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A sequence analysis objective is a data transformation objective which aims to analyse some ordered biological data for sequential patterns."@en ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200085 a owl:Class ;
    rdfs:label "mass spectrometry analysis"@en ;
    ns1:IAO_0000111 "mass spectrometry analysis"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A data transformation which has the objective of spectrum analysis."^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200197 ] .

ns1:OBI_0200129 a owl:Class ;
    rdfs:label "node quality calculation"@en ;
    ns1:IAO_0000111 "node quality calculation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A network analysis in which an input data set describing node objects and edge relationships between node objects is used to determine the output quality of one of the node objects in the network."@en ;
    ns1:IAO_0000117 "Richard Scheuermann"@en ;
    ns1:IAO_0000119 "PERSON: Richard Scheuermann"@en ;
    rdfs:subClassOf ns1:OBI_0200080 .

ns1:OBI_0200140 a owl:Class ;
    rdfs:label "mathematical feature"@en ;
    ns1:IAO_0000111 "mathematical feature"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "feature is a (parent_class) that describes a characteristic, trait or quality of a data transformation"@en ;
    ns1:IAO_0000116 "This class is temporary and will be placed outside of data transformation ultimately (if it still remains at all after review)"@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000119 "PERSON: James Malone"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200000 .

ns1:OBI_0200171 a owl:Class ;
    rdfs:label "partitioning data transformation"@en ;
    ns1:IAO_0000111 "partitioning data transformation"@en ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A partitioning data transformation is a data transformation that has objective partitioning."@en ;
    ns1:IAO_0000117 "James Malone"^^xsd:string ;
    ns1:IAO_0000119 "PERSON: James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200000 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0200172 ] .

ns1:OBI_0200180 a owl:Class ;
    rdfs:label "spread calculation objective"@en ;
    ns1:IAO_0000111 "spread calculation objective"@en ;
    ns1:IAO_0000112 "Spread calculation can be achieved by use of a standard deviation, which measures distance from the mean"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a data transformation objective whereby the aim is to the calculate the spread of a dataset, spread is a descriptive statistic which describes the variability of values in a data set "^^xsd:string ;
    ns1:IAO_0000116 "Awaiting English definition from Monnie McGee"@en ;
    ns1:IAO_0000117 "Person:Helen Parkinson"^^xsd:string,
        "James Malone"@en ;
    rdfs:subClassOf ns1:OBI_0200166 .

ns1:OBI_0200188 a owl:Class ;
    rdfs:label "cross validation objective"@en ;
    ns1:IAO_0000111 "cross validation objective"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A cross validation objective is a data transformation objective in which the aim is to partition a sample of data into subsets such that the analysis is initially performed on a single subset, while the other subset(s) are retained for subsequent use in confirming and validating the initial analysis."@en ;
    ns1:IAO_0000117 "James Malone"@en ;
    ns1:IAO_0000118 "rotation estimation objective"@en ;
    ns1:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Cross_validation"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0200172 .

ns1:OBI_0600036 a owl:Class ;
    rdfs:label "establishing cell culture" ;
    ns1:IAO_0000111 "'establishing cell culture'" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "a process through which a new type of cell culture or cell line is created, either through the isolation and culture of one or more cells from a fresh source, or the deliberate experimental modification of an existing cell culture (e.g passaging a primary culture to become a secondary culture or line, or the immortalization or stable genetic modification of an existing culture or line)." ;
    ns1:IAO_0000117 "PERSON:Matthew Brush" ;
    ns1:IAO_0000119 "PERSON:Matthew Brush" ;
    rdfs:comment "A 'cell culture' as used here referes to a new lineage of cells in culture deriving from a single biological source.. New cultures are established through the initial isolation and culturing of cells from an organismal source, or through changes in an existing cell culture or line that result in a new culture with unique characteristics.  This can occur through the passaging/selection of a primary culture into a secondary culture or line, or experimental modifications of an existing cell culture or line such as an immortalization process or other stable genetic modification. This class covers establishment of cultures of either multicellular organism cells or unicellular organisms." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100060 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000456 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0000079 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:CL_0000000 ],
        ns1:OBI_0000094 .

ns1:OBI_0600050 a owl:Class ;
    rdfs:label "specific enzymatic cleavage"@en ;
    ns1:IAO_0000111 "specific enzymatic cleavage"@en ;
    ns1:IAO_0000112 "The use of a protease to digest a protein into peptides"@en ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "a protocol application to digest the fraction of input material that is susceptible to that enzyme"@en ;
    ns1:IAO_0000117 "PERSON:Kevin Clancy"@en ;
    ns1:IAO_0000119 "OBI branch derived"@en ;
    rdfs:subClassOf ns1:OBI_0000231 .

ns1:OBI_1110022 a owl:Class ;
    rdfs:label "adaptive immune receptor"@en ;
    ns1:IAO_0000111 "adaptive immune receptor"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is a receptor produced by cells of the adaptive immune system with the purpose of binding epitopes."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:GO_0043234 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ns1:GO_0019815 ns1:GO_0042101 ns1:GO_0042571 ) ] .

ns1:OBI_1110045 a owl:Class ;
    rdfs:label "disposition to be bound by an adaptive immune receptor"@en ;
    ns1:IAO_0000111 "disposition to be bound by an adaptive immune receptor"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Is the disposition borne by a material entity that is realized in a process of being bound by a adaptive immune receptor."@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000118 "epitope disposition"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OBI_1110014 ;
            owl:onProperty ns1:BFO_0000054 ],
        ns1:BFO_0000016 .

ns1:OBI_1110111 a owl:Class ;
    rdfs:label "environmental proximity to infectious agent"@en ;
    ns1:IAO_0000111 "environmental proximity to infectious agent"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "Is a process in which an infectious agent comes close enough to a potential host organism in its habitat that a contact can result"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
    rdfs:subClassOf ns1:GO_0008150 .

ns1:OBI_1110119 a owl:ObjectProperty ;
    rdfs:label "bound_to"^^xsd:string ;
    ns1:IAO_0000111 "bound_to"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "A relationship between two material entities that form a complex based on a selective, non-covalent interaction." ;
    ns1:IAO_0000116 "The definition of this term is modeled after the Chebi:50967 and GO:0005488 terms. Further alignment of the logical definitions with those ontologies will require agreement on the placement of GO:molecular function in BFO among other things. OBI will retire this term once such an alignment is achieved as 'bound to' is not in the primary OBI scope." ;
    rdfs:domain ns1:BFO_0000040 ;
    rdfs:range ns1:BFO_0000040 .

ns1:OBI_1110126 a owl:Class ;
    rdfs:label "assay measuring binding of a MHC:ligand complex" ;
    ns1:IAO_0000111 "assay measuring binding of a MHC:ligand complex" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A MHC ligand assay that detects the binding of a ligand to an MHC molecule."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    ns1:OBI_9991118 "MHC binding"^^xsd:string,
        "binding assay"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0002075 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0002075 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:IAO_0000030 [ a owl:Restriction ;
                                            owl:onProperty ns1:IAO_0000136 ;
                                            owl:someValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( ns1:OBI_0001503 [ a owl:Class ;
                                                                owl:complementOf [ a owl:Restriction ;
                                                                        owl:onProperty ns1:OBI_1110060 ;
                                                                        owl:someValuesFrom ns1:GO_0019882 ] ] ) ] ] ) ] ] ) ] .

ns1:OGMS_0000063 a owl:Class ;
    rdfs:label "disease course" ;
    ns1:IAO_0000111 "disease course" ;
    ns1:IAO_0000115 "The totality of all processes through which a given disease instance is realized."@en ;
    ns1:IAO_0000232 "replace 'OBI:occurrence of disease', need to add logical definition\\nThe axioms of OBI occurence of disease:\\nEquivalent classes:\\nrealizes some disease\\nSuperclasses:\\n'has part' some 'pathologic process'\\n'has participant' some \\n    (organism\\n     and ('has role' some 'host of immune response role'))\\nbiological_process\\nrealizes some 'host of immune response role'"^^xsd:string ;
    ns1:IAO_0000412 ns1:ogms.owl ;
    rdfs:subClassOf ns1:GO_0008150 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom ns1:OGMS_0000031 ] .

ns1:PATO_0000018 a owl:Class ;
    rdfs:label "fluorescence"^^xsd:string ;
    ns1:IAO_0000111 "fluorescence"^^xsd:string ;
    ns1:IAO_0000115 "A luminous flux quality inhering in a bearer by virtue of the bearer's emitting longer wavelength light following the absorption of shorter wavelength radiation; fluorescence is common with aromatic compounds with several rings joined together."^^xsd:string ;
