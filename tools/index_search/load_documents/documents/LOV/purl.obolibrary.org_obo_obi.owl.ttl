    ns1:IAO_0000115 "A competitive inhibition of binding assay in which two antibodies that are known to bind the same antigen are tested for the ability of one antibody to inhibit binding of the other antibody to the antigen, thereby determining if they have overlapping binding sites."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
