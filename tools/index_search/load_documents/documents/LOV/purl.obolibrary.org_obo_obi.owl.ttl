    ns1:IAO_0000111 "conclusion section"@en ;
    ns1:IAO_0000112 "The section labelled 'conclusion' in a typical scientific journal article."@en ;
    ns1:IAO_0000115 "A part of a document used to summarize the findings discussed in the document. The conclusion section is typically found near the end of a document. "@en ;
