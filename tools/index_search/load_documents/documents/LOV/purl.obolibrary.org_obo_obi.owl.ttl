            owl:someValuesFrom ns1:IAO_0000027 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:OBI_0100051 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0001623 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000081 ;
                                            owl:someValuesFrom ns1:OBI_0100051 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0100051 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000087 ;
                                            owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ],
        ns1:OBI_0001624 .

