ns1:OBI_0000796 a owl:Class ;
    rdfs:label "purification objective"^^xsd:string ;
    ns1:IAO_0000111 "purification objective"^^xsd:string ;
    ns1:IAO_0000112 "the objective to obtain a pure fraction of a specific peptide when running an HPLC on a crude synthesis of peptides."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "The objective to separate a material entity into different compositions of which one or more have are purified fractions that contain higher concentration of a desired component, while others contain impurities and are not of interest"^^xsd:string ;
    ns1:IAO_0000117 "PERSON:Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "isolation objective"^^xsd:string ;
    ns1:IAO_0000119 "BP"^^xsd:string ;
    ns1:IAO_0000232 "10/14/09,  BP: This should be linked to the 'purified' 'currently conferred quality"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000681 .

