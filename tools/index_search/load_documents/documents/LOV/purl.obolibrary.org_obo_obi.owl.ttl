ns1:OBI_0000647 a owl:ObjectProperty ;
    rdfs:label "has_supplier"^^xsd:string ;
    ns1:IAO_0000111 "has_supplier"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A relation between a material entity and an organisation or person who owned or has license to the material entity and there was a legal transfer of ownership or licensing of the material entity to the current owner."^^xsd:string ;
    ns1:IAO_0000117 "PERSON: Alan Rutternberg"^^xsd:string,
        "PERSON: Cristian Cocos"^^xsd:string,
        "PERSON: Frank Gibson"^^xsd:string,
        "PERSON: Melanie Courtot"^^xsd:string ;
    rdfs:domain ns1:BFO_0000040 ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:NCBITaxon_9606 ns1:OBI_0000245 ) ] .

ns1:OBI_0000654 a owl:Class ;
    rdfs:label "device setting"^^xsd:string ;
    ns1:IAO_0000111 "device setting"^^xsd:string ;
    ns1:IAO_0000112 "Examples, 300V for 4 hours, 200mvolts, 37degrees.A knob set a 300 V is the device setting, the protocol stating to set the instrument to 300V is a device setting specification"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a quality inheres_in some device and is concretization of some (device_setting_specification and is_about a quality of the device"^^xsd:string ;
    ns1:IAO_0000116 "There is some question of whether 'device setting' is really best modelled as a quality.  To be revisited after assay terms have been worked through. See https://github.com/obi-ontology/obi/issues/133" ;
    ns1:IAO_0000117 "PERSON: Frank Gibson"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000052 ;
            owl:someValuesFrom ns1:OBI_0000047 ],
        ns1:BFO_0000019 .

ns1:OBI_0000660 a owl:Class ;
    rdfs:label "background corrected data set"@en ;
    ns1:IAO_0000111 "background corrected data set"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000125 ;
    ns1:IAO_0000115 "A data set that is produced as the output of a background correction data transformation."@en ;
