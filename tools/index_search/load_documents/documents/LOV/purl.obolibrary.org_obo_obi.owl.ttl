    rdfs:label "Cy3 dye"^^xsd:string ;
    ns1:IAO_0000111 "Cy3 dye"^^xsd:string ;
    ns1:IAO_0000412 ns1:chebi.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:REO_0000171 ],
        ns1:REO_0000280 .

