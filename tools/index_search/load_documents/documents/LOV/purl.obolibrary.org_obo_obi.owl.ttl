ns1:OBI_0000875 a owl:Class ;
    rdfs:label "viral hemagglutination inhibition assay" ;
    ns1:IAO_0000111 "viral hemagglutination inhibition assay" ;
    ns1:IAO_0000112 "Examining the ability of a monoclonal antibody to inhibit hemagglutination by Influenza A virus by comparing the levels of hemagglutination with and without the presence of the antibody."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "An assay that measures the ability of an evaluant to inhibit hemagglutination by a virus. Hemagglutinin is a viral protein which binds to sialic acid receptors on cells or to erythrocytes, causing the cells to clump. Loss of clumping indicates hemagglutination inhibition by the evaluant."^^xsd:string ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string,
        "Melanie Courtot"^^xsd:string,
        "Randi Vita"^^xsd:string ;
    ns1:IAO_0000118 "HAI"^^xsd:string,
        "HIA"^^xsd:string,
        "biological activity"^^xsd:string,
        "hemagglutination inhibition"^^xsd:string,
        "viral haemagglutinin inhibition assay"^^xsd:string ;
    ns1:IAO_0000119 "OBI branch derived"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0000906 ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000055 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( ns1:OBI_0000086 [ a owl:Restriction ;
                                            owl:onProperty ns1:RO_0000052 ;
                                            owl:someValuesFrom ns1:NCBITaxon_10239 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom ns1:NCBITaxon_10239 ] ) ],
        ns1:OBI_0000070 .

ns1:OBI_0000877 a owl:Class ;
    rdfs:label "cell line immortalization"^^xsd:string ;
    ns1:IAO_0000111 "cell line immortalization"^^xsd:string ;
    ns1:IAO_0000112 "Production of a cell line for the purposes of experimentation e.g. EBV transformation of PBMs"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "an establishing cell line process whereby a mortal cell line is intentionally genetically modified to be capable of indefinite propagation and re-established as a new immortal cell line"^^xsd:string ;
    ns1:IAO_0000116 "4-20-13 MHB: This class was repositioned as a child of 'establishing cell line', based on the existing definition (\"the planned process of experimentally creating a cell line which is capable of dividing indefinitely in vitro\"), and examples and other annotations indicating the intent to describe a process through which a new immortal cell line is established from an existing mortal cell line using genetic modification techniques.  The definition above was modified to clarify this perspective." ;
    ns1:IAO_0000117 "Bjoern Peters"^^xsd:string ;
    ns1:IAO_0000118 "'establishing immortal cell line through directed genetic modification'" ;
    ns1:IAO_0000119 "OBI"^^xsd:string ;
    rdfs:comment "A immortalizing genetic transformation of an existing population of cell line cells is required as part of this process, as are additional steps for  selecting and propagating the cells output form this process into a cell line."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:CLO_0009828 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:OBI_0001907 ],
        ns1:OBI_0001867 .

ns1:OBI_0000883 a owl:Class ;
    rdfs:label "in vivo cell killing assay" ;
    ns1:IAO_0000111 "in vivo cell killing assay" ;
    ns1:IAO_0000112 "Labeling two populations of cells with different levels of CFSE, pusling one population with an influenza peptide, injecting the cells into a mouse, and recoving cells 24 hours later. By comparing the recovery rate of cells with different CFSE labeling, it is possible to determine if there was specific killing of peptide pulsed target cells."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A cell killing assay that measures if and how many target cells are killed within an organism."^^xsd:string ;
    ns1:IAO_0000117 "IEDB"^^xsd:string ;
    ns1:IAO_0000119 "IEDB"^^xsd:string ;
    rdfs:subClassOf ns1:OBI_0000882 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:OBI_0000882 [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000055 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0000067 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000081 ;
                                                        owl:someValuesFrom ns1:OBI_0100026 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ns1:OBI_0000293 ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( ns1:OBI_0100026 [ a owl:Restriction ;
                                                        owl:onProperty ns1:RO_0000087 ;
                                                        owl:someValuesFrom ns1:OBI_0000067 ] ) ] ] ) ] ) ] .

