ns1:OBI_0000839 a owl:Class ;
    rdfs:label "labeled oligonucleotide"^^xsd:string ;
    ns1:IAO_0000111 "labeled oligonucleotide"^^xsd:string ;
    ns1:IAO_0000112 ""^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "a labeled oligonucleotide is a short nucleic acid which underwent a labeling process resulting in a radioactive isotope such as P32 or P33 added to its backbone for instance by end labeling with polynucleotide kinase which added radiolabeled ATP to the 5' end of oligonucleotide"^^xsd:string ;
