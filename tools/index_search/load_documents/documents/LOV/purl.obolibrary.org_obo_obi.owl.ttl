    ns1:IAO_0000114 ns1:IAO_0000123 ;
    ns1:IAO_0000115 "is the administration of an infectious agent to a cell culture with the objective to have the agent colonize and replicate in culture"@en ;
    ns1:IAO_0000117 "IEDB"@en ;
    ns1:IAO_0000119 "IEDB"@en ;
