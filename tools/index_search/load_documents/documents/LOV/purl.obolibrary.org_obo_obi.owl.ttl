    ns1:IAO_0000111 "gynecologic surgery history" ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A clinical history in which a woman has had gynecologic surgery in the past."^^xsd:string ;
    ns1:IAO_0000117 "Chris Stoeckert, Helena Ellis"^^xsd:string ;
