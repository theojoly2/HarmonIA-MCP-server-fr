ns1:OBI_0002107 a owl:Class ;
    rdfs:label "bio-layer interferometry assay" ;
    ns1:IAO_0000111 "bio-layer interferometry assay" ;
    ns1:IAO_0000112 "Detecting the presence of an antibody in a cell culture supernatant by detecting a shift in the interference pattern reflected from a layer of immobilized protein to which the antibody binds."^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A binding assay that detects a shift in the interference pattern reflected from a layer of immobilized material on the biosensor tip to measure binding to- or dissociating from the material on the biosensor."^^xsd:string ;
