ns1:OBI_0001000 a owl:Class ;
    rdfs:label "questionnaire"^^xsd:string ;
    ns1:IAO_0000111 "questionnaire"^^xsd:string ;
    ns1:IAO_0000114 ns1:IAO_0000120 ;
    ns1:IAO_0000115 "A document with a set of printed or written questions with a choice of answers, devised for the purposes of a survey or statistical study."@en ;
    ns1:IAO_0000116 "Need to clarify if this is a document or a directive information entity (or what their connection is))"^^xsd:string,
        "JT: It plays a role in collecting data that could be fleshed out more; but I'm thinking it is, in itself, an edited document. \\nJZ: based on textual definition of edited document, it can be defined as N&S. I prefer to leave questionnaire as a document now. We can add more restrictions in the future and use that to determine it is an edited document or not. "@en ;
    ns1:IAO_0000117 "PERSON: Jessica Turner"@en ;
    ns1:IAO_0000119 "Merriam-Webster"@en ;
    rdfs:subClassOf ns1:IAO_0000310 .

