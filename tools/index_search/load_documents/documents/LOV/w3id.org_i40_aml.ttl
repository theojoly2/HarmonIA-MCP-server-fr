@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix ns1: <https://w3id.org/i40/aml#> .
@prefix ns2: <http://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

void:vocabulary a owl:AnnotationProperty .

ns2:affiliation a owl:AnnotationProperty .

ns2:name a owl:DatatypeProperty,
        owl:FunctionalProperty .

doap:repository a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

xsd:integer a rdfs:Datatype .

owl:versionInfo a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:domain ns1:CAEXFile ;
    rdfs:isDefinedBy "http://www.w3.org/ns/prov#wasGeneratedBy" ;
    rdfs:range prov:Activity .

<http://www.wurvoc.org/vocabularies/om-1.8/Speed> a owl:Class .

<http://www.wurvoc.org/vocabularies/om-1.8/numerical_value> a owl:DatatypeProperty .

<http://www.wurvoc.org/vocabularies/om-1.8/phenomenon> a owl:ObjectProperty .

<http://www.wurvoc.org/vocabularies/om-1.8/unit_of_measure> a owl:ObjectProperty .

ns1:AttValue1 a owl:NamedIndividual ;
    ns1:numerical_value 0 .

ns1:ExampleInstanceHierarchy a owl:NamedIndividual,
        ns1:CAEXFile .

ns1:GMA6.16BeispielPIDVersion2.97 a owl:NamedIndividual,
        ns1:CAEXFile ;
    ns1:hasAdditionalInformation ns1:AdditionalInformation1 ;
    ns1:hasSchemaVersion 2.15 .

ns1:LIRCS1 a owl:NamedIndividual,
        ns1:InternalElement ;
    ns1:hasAttribute ns1:PCEDescription ;
    ns1:hasAttributeIE ns1:FlowchartNumber,
        ns1:PCEFunction,
        ns1:PCEInitial ;
    ns1:hasExternalInterface ns1:AILevelSW ;
    ns1:hasIDIE "adb2ebf7-dc6f-479b-abfe-64a4fd69c209" ;
    ns1:hasNameIE "LIRCS+-A+-"@en ;
    ns1:isPartOfIE ns1:L1001 ;
    ns1:refBaseSystemUnitPath "NE150SUCLibrary/PCERequest" .

ns1:MaxConveyingSpeed a owl:NamedIndividual,
        ns1:Attribute ;
    ns1:hasNameAttribute "maxConveyingSpeed"@en ;
    ns1:hasUnitAttribute ns1:speedMeasurement .

ns1:MeasurementRangeEnd a owl:NamedIndividual,
        ns1:Attribute ;
    ns1:hasAttributeDataType "xs:double" ;
    ns1:hasAttributeDescription "Actual measurement range end of sensor in field"@en ;
    ns1:refSemanticAttribute "NE 150 v1.0 Annex 3.3.5" .

ns1:MeasurementRangeStart a owl:NamedIndividual,
        ns1:Attribute ;
    ns1:hasAttributeDataType "xs:double" ;
    ns1:hasAttributeDescription "Actual measurement range start of sensor in field"@en ;
    ns1:hasNameAttribute "MeasurementRangeStart"@en .

ns1:NE150DemoProject a owl:NamedIndividual,
        ns1:InstanceHierarchy ;
    ns1:hasInternalElement ns1:DemoEnterprise ;
    ns1:hasNameIH "NE150DemoProject"@en .

ns1:OldPCE a owl:NamedIndividual,
        ns1:Attribute ;
    ns1:hasAttributeDataType "xs:string" ;
    ns1:hasAttributeDescription "Old PCE designation for migration or renaming"@en ;
    ns1:hasAttributeValue "L 1101" ;
    ns1:hasNameAttribute "OldPCE"^^xsd:string ;
    ns1:refSemanticAttribute "NE 150 v1.0 Annex 2.1.4" .

ns1:hasAMLVersion a owl:DatatypeProperty ;
    rdfs:domain ns1:AdditionalInformation ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "hasAMLVersion"@en .

ns1:hasAdditionalInformation a owl:ObjectProperty ;
    rdfs:domain ns1:CAEXFile ;
    rdfs:range ns1:AdditionalInformation ;
    skos:prefLabel "hasAdditionalInformation"@en .

ns1:hasAttributeDataType a owl:DatatypeProperty ;
    rdfs:domain ns1:Attribute ;
    rdfs:range xsd:string ;
    skos:prefLabel "hasDataType"@en .

ns1:hasAttributeDescription a owl:DatatypeProperty ;
    rdfs:domain ns1:Attribute ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Points to an optional description of the Attribute"@en ;
    skos:prefLabel "hasDescription"@en .

ns1:hasAttributeIC a owl:ObjectProperty ;
    rdfs:domain ns1:InterfaceClass ;
    rdfs:range ns1:Attribute ;
    rdfs:subPropertyOf ns1:hasAttribute .

ns1:hasAttributeIE a owl:ObjectProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range ns1:Attribute ;
    rdfs:subPropertyOf ns1:hasAttribute .

ns1:hasAttributeName a owl:DatatypeProperty ;
    rdfs:domain ns1:Attribute ;
    rdfs:range xsd:string ;
    skos:prefLabel "hasAttributeName"@en .

ns1:hasAttributeRC a owl:ObjectProperty ;
    rdfs:domain ns1:RoleClass ;
    rdfs:range ns1:Attribute ;
    rdfs:subPropertyOf ns1:hasAttribute .

ns1:hasAttributeSUC a owl:ObjectProperty ;
    rdfs:domain ns1:SystemUnitClass ;
    rdfs:range ns1:Attribute ;
    rdfs:subPropertyOf ns1:hasAttribute .

ns1:hasAttributeValue a owl:DatatypeProperty ;
    rdfs:domain ns1:Attribute ;
    rdfs:range xsd:string .

ns1:hasBaseSystemUnitClass a owl:ObjectProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range ns1:SystemUnitClass .

ns1:hasClassificationClass a owl:DatatypeProperty ;
    rdfs:domain ns1:eClassSpecification ;
    rdfs:range xsd:string ;
    skos:definition "Points to the eClass classification Class a given Element"@en ;
    skos:prefLabel "eClassClassificationClass"@en .

ns1:hasExternalInterface a owl:ObjectProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range ns1:ExternalInterface ;
    skos:definition "Connects the Internal Element with an External Interface"@en ;
    skos:prefLabel "hasExternalInterface"@en .

ns1:hasExternalReference a owl:ObjectProperty ;
    rdfs:domain ns1:CAEXFile ;
    rdfs:range ns1:ExternalReference ;
    skos:definition "A CAEX File contains external references" ;
    skos:prefLabel "hasExternalReference"@en .

ns1:hasExternalReferenceAlias a owl:DatatypeProperty ;
    rdfs:domain ns1:ExternalReference ;
    rdfs:range xsd:string ;
    skos:definition "A external Reference of a CAEX File has Alias" ;
    skos:prefLabel "externalReferenceAlias"@en .

ns1:hasExternalReferencePath a owl:DatatypeProperty ;
    rdfs:domain ns1:ExternalReference ;
    rdfs:range xsd:string ;
    skos:definition "A external Reference of a CAEX File contains path to the file" ;
    skos:prefLabel "externalReferencePath"@en .

ns1:hasICID a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Unique ID for the Interface Class"@en ;
    rdfs:domain ns1:InterfaceClass ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:identifier .

ns1:hasIDIE a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:identifier ;
    skos:definition "Unique Id of an Internal Element"@en ;
    skos:prefLabel "internalElementId"@en .

ns1:hasIRDIeClass a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:eClassSpecification ;
    rdfs:range xsd:string ;
    skos:definition "Points to the eClass unique identification(IRDI) a given Element"@en ;
    skos:prefLabel "eClassIRDI"@en .

ns1:hasInstanceHierarchy a owl:ObjectProperty ;
    rdfs:domain ns1:CAEXFile ;
    rdfs:range ns1:InstanceHierarchy ;
    rdfs:subPropertyOf ns1:contains ;
    skos:definition "Points the CAEX file to the Instance Hierarchy"@en ;
    skos:prefLabel "hasInstanceHierarchy"@en .

ns1:hasInterfaceClass a owl:ObjectProperty ;
    rdfs:domain ns1:InterfaceClassLib ;
    rdfs:range ns1:InterfaceClass ;
    skos:definition "Model the relation between Interface Class Lib and Interface Class"@en ;
    skos:prefLabel "hasInterfaceClass"@en .

ns1:hasInterfaceClassLib a owl:ObjectProperty ;
    rdfs:domain ns1:CAEXFile ;
    rdfs:range ns1:InterfaceClassLib ;
    rdfs:subPropertyOf ns1:contains ;
    skos:definition "Points the CAEX file to the InterfaceClassLib"@en ;
    skos:prefLabel "hasInterfaceClassLib"@en .

ns1:hasInterfaceIE a owl:ObjectProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range ns1:InterfaceClass ;
    rdfs:subPropertyOf ns1:hasInterface .

ns1:hasInterfaceRC a owl:ObjectProperty ;
    rdfs:domain ns1:RoleClass ;
    rdfs:range ns1:InterfaceClass ;
    rdfs:subPropertyOf ns1:hasInterface .

ns1:hasInterfaceSUC a owl:ObjectProperty ;
    rdfs:domain ns1:SystemUnitClass ;
    rdfs:range ns1:InterfaceClass ;
    rdfs:subPropertyOf ns1:hasInterface .

ns1:hasInternalElement a owl:ObjectProperty ;
    rdfs:domain ns1:InstanceHierarchy ;
    rdfs:range ns1:InternalElement ;
    skos:definition "Hierarchy has many internal elements"@en ;
    skos:prefLabel "hasInternalElement"@en .

ns1:hasInternalLink a owl:ObjectProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range ns1:InternalLink .

ns1:hasNameAttribute a owl:DatatypeProperty ;
    rdfs:domain ns1:Attribute ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasName .

ns1:hasNameFile a owl:DatatypeProperty ;
    rdfs:domain ns1:CAEXFile ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasName ;
    skos:definition "The name of the main AutomationML File"@en ;
    skos:prefLabel "hasNameFile" .

ns1:hasNameIC a owl:DatatypeProperty ;
    rdfs:domain ns1:InterfaceClass ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasName ;
    skos:altLabel "hasInterfaceClassName"@en ;
    skos:definition "Name of the Interface Class"@en ;
    skos:prefLabel "hasNameIC"@en .

ns1:hasNameIE a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasName ;
    skos:altLabel "hasInternalElementName"@en ;
    skos:definition "Name of an Internal Element"@en ;
    skos:prefLabel "hasNameIE"@en .

ns1:hasNameIH a owl:DatatypeProperty ;
    rdfs:domain ns1:InstanceHierarchy ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasName ;
    skos:altLabel "hasInstanceHierarchyName"@en ;
    skos:definition "Given Name of the Instance Hierarchy"@en ;
    skos:prefLabel "hasNameIH"@en .

ns1:hasNameRC a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:RoleClass ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasName ;
    skos:altLabel "hasRoleClassName"@en ;
    skos:definition "Name for a RoleClass"@en ;
    skos:prefLabel "hasNameRC"@en .

ns1:hasNameSUC a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:SystemUnitClass ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasName ;
    skos:altLabel "hasSystemUnitClassName"@en ;
    skos:definition "Given Name of the System Unit Class"@en ;
    skos:prefLabel "hasNameSUC"@en .

ns1:hasProject a owl:ObjectProperty ;
    rdfs:domain ns1:AdditionalInformation ;
    rdfs:range ns1:Project ;
    skos:definition "Related Project for the CAEX File"@en ;
    skos:prefLabel "hasProject"@en .

ns1:hasProjectId a owl:DatatypeProperty ;
    rdfs:domain ns1:Project ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:identifier,
        dc:title ;
    skos:prefLabel "hasProjectId"@en .

ns1:hasProjectTitle a owl:DatatypeProperty ;
    rdfs:domain ns1:Project ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:title ;
    skos:prefLabel "has Project Release",
        "hasProjectTitle"@en .

ns1:hasRefBaseClassPathIC a owl:DatatypeProperty ;
    rdfs:domain ns1:InterfaceClass ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasRefBaseClassPath .

ns1:hasRefBaseClassPathRC a owl:DatatypeProperty ;
    rdfs:domain ns1:RoleClass ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasRefBaseClassPath .

ns1:hasRefBaseClassPathSUC a owl:DatatypeProperty ;
    rdfs:domain ns1:SystemUnitClass ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasRefBaseClassPath .

ns1:hasRefBaseRoleClassPath a owl:DatatypeProperty ;
    rdfs:range xsd:string .

ns1:hasRefBaseSystemUnitPath a owl:DatatypeProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range xsd:string ;
    skos:altLabel "Ref Base System Unit Path"@en ;
    skos:prefLabel "refBaseSUPath"@en .

ns1:hasRefPartnerSideA a owl:ObjectProperty ;
    rdfs:domain ns1:InternalLink ;
    skos:definition "Reference an Internal Link with an element A"@en ;
    skos:prefLabel "hasRefPartnerSideA"@en .

ns1:hasRefPartnerSideB a owl:ObjectProperty ;
    rdfs:domain ns1:InternalLink ;
    skos:definition "Reference an Internal Link with an element B"@en ;
    skos:prefLabel "hasRefPartnerSideB"@en .

ns1:hasRefRoleClassPath a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    skos:altLabel "refRoleClassPath"@en ;
    skos:prefLabel "refRCPath"@en .

ns1:hasRefSemAttribute a owl:ObjectProperty ;
    rdfs:domain ns1:Attribute ;
    rdfs:range ns1:eClassSpecification ;
    rdfs:subPropertyOf ns1:hasSemanticRef .

ns1:hasRefSemRC a owl:ObjectProperty ;
    rdfs:domain ns1:RoleClass ;
    rdfs:range ns1:eClassSpecification ;
    rdfs:subPropertyOf ns1:hasSemanticRef ;
    skos:altLabel "RoleClasseClassReference"@en ;
    skos:definition "A Role Class points to its ID according to eClass"@en ;
    skos:prefLabel "eClassRCReference" .

ns1:hasRoleClass a owl:ObjectProperty ;
    rdfs:domain ns1:RoleClassLib ;
    rdfs:range ns1:RoleClass ;
    skos:definition "A Role Class lib contains a Role Class"@en ;
    skos:prefLabel "hasRoleClass"@en .

ns1:hasRoleClassLib a owl:ObjectProperty ;
    rdfs:domain ns1:CAEXFile ;
    rdfs:range ns1:RoleClassLib ;
    rdfs:subPropertyOf ns1:contains ;
    skos:definition "Points the CAEX file to the RoleClassLib"@en ;
    skos:prefLabel "hasRoleClassLib"@en .

ns1:hasRoleRequirementIE a owl:ObjectProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range ns1:RoleClass ;
    rdfs:subPropertyOf ns1:hasRoleRequeriment .

ns1:hasRoleRequirementSUC a owl:ObjectProperty ;
    rdfs:domain ns1:SystemUnitClass ;
    rdfs:range ns1:RoleClass ;
    rdfs:subPropertyOf ns1:hasRoleRequeriment .

ns1:hasSchemaVersion a owl:DatatypeProperty ;
    rdfs:domain ns1:CAEXFile ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "hasSchemaVersion" .

ns1:hasSupportedRoleClassIE a owl:ObjectProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range ns1:RoleClass ;
    rdfs:subPropertyOf ns1:hasSupportedRoleClass .

ns1:hasSupportedRoleClassSUC a owl:ObjectProperty ;
    rdfs:domain ns1:SystemUnitClass ;
    rdfs:range ns1:RoleClass ;
    rdfs:subPropertyOf ns1:hasSupportedRoleClass .

ns1:hasSystemUnitClass a owl:ObjectProperty ;
    rdfs:domain ns1:SystemUnitClassLib ;
    rdfs:range ns1:SystemUnitClass ;
    skos:prefLabel "hasSystemUnitClass" .

ns1:hasSystemUnitClassLib a owl:ObjectProperty ;
    rdfs:domain ns1:CAEXFile ;
    rdfs:range ns1:SystemUnitClassLib ;
    rdfs:subPropertyOf ns1:contains ;
    skos:definition "Points the CAEX file to the SystemUnitClassLib"@en ;
    skos:prefLabel "hasInterfaceClassLib"@en .

ns1:hasUnit a owl:ObjectProperty ;
    rdfs:domain ns1:Attribute ;
    rdfs:range <http://www.wurvoc.org/vocabularies/om-1.8/Unit_of_measure> .

ns1:hasUnitAttribute a owl:ObjectProperty ;
    rdfs:domain ns1:Attribute .

ns1:hasUnitValue a owl:ObjectProperty ;
    rdfs:domain ns1:Attribute ;
    rdfs:range <http://www.wurvoc.org/vocabularies/om-1.8/Measure> ;
    skos:prefLabel "hasAttributeValue"@en .

ns1:hasVersion a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "hasVersion"@en .

ns1:hasVersionEClass a owl:DatatypeProperty ;
    rdfs:domain ns1:eClassSpecification ;
    rdfs:range xsd:string ;
    skos:definition "Points to the eClass version for a given Element"@en ;
    skos:prefLabel "eClassVersion"@en .

ns1:hasVersionICL a owl:DatatypeProperty ;
    rdfs:domain ns1:InterfaceClassLib ;
    rdfs:range xsd:string ;
    skos:definition "Points to the version for a Interface Class Lib"@en ;
    skos:prefLabel "hasVersionICL"@en .

ns1:hasVersionRCL a owl:DatatypeProperty ;
    rdfs:domain ns1:RoleClassLib ;
    rdfs:range xsd:string ;
    skos:definition "Points to the version for a Role Class Lib"@en ;
    skos:prefLabel "hasVersionRCL"@en .

ns1:hasVersionSUC a owl:DatatypeProperty ;
    rdfs:domain ns1:SystemUnitClass ;
    rdfs:range xsd:decimal ;
    skos:definition "Points to the version for a System Unit Class"@en ;
    skos:prefLabel "hasVersionSUC"@en .

ns1:hasWriterId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:AdditionalInformation ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:identifier ;
    skos:prefLabel "hasWriterId" .

ns1:hasWriterName a owl:DatatypeProperty ;
    rdfs:domain ns1:AdditionalInformation ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf ns1:hasName ;
    skos:definition "The name of the Writer, i.e., the tool that produced the file"@en ;
    skos:prefLabel "hasWriterName" .

ns1:hasWriterRelease a owl:DatatypeProperty ;
    rdfs:domain ns1:AdditionalInformation ;
    rdfs:range xsd:string ;
    skos:prefLabel "hasWriterRelease"@en .

ns1:hasWriterVendor a owl:DatatypeProperty ;
    rdfs:domain ns1:AdditionalInformation ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "hasWriterVendor"@en .

ns1:hasWriterVendorURL a owl:DatatypeProperty ;
    rdfs:domain ns1:AdditionalInformation ;
    rdfs:range xsd:anyURI ;
    skos:prefLabel "hasWriterVendorURL"@en .

ns1:hasWriterVersion a owl:DatatypeProperty ;
    rdfs:domain ns1:AdditionalInformation ;
    rdfs:range xsd:string ;
    skos:prefLabel "hasWriterVersion"@en .

ns1:isConnectedToEClass a owl:ObjectProperty ;
    skos:definition "Points to the eCl@ass connection for a given element"@en ;
    skos:prefLabel "eClassIsConnectedTo"@en .

ns1:isPartOfIC a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:InterfaceClass ;
    rdfs:range ns1:InterfaceClass ;
    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf> ;
    skos:altLabel "isPartOfInterfaceClass"@en ;
    skos:definition "Connects the InterfaceClasses with other InterfaceClasses that are part of the given Interface Class"@en ;
    skos:prefLabel "isPartOfIC"@en .

ns1:isPartOfIE a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:InternalElement ;
    rdfs:range ns1:InternalElement ;
    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf> ;
    skos:altLabel "InternalElementPartOf"@en ;
    skos:definition "Connects the Internal Element with other Internal Elements that are part of the given Internal Element"@en ;
    skos:prefLabel "isPartOfIE"@en .

ns1:isPartOfSUC a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain ns1:SystemUnitClass ;
    rdfs:range ns1:SystemUnitClass ;
    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf> ;
    skos:altLabel "SystemUnitClassPartOf"@en ;
    skos:definition "Connects the System Unit Class with another System Unit Class Elements"@en ;
    skos:prefLabel "isPartOfSUC"@en .

ns1:lastWritingDateTime a owl:DatatypeProperty ;
    rdfs:domain ns1:AdditionalInformation ;
    rdfs:range xsd:dateTime .

