<https://w3id.org/tribont/core#MaxLoadWithoutFailure> a owl:Class ;
    rdfs:label "MaxLoadWithoutFailure" ;
    rdfs:comment "Maximun load before failure of the material." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#ForceUnit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/core#ForceUnit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <https://w3id.org/tribont/core#TribologicalProperty> ;
    ns1:term_status "Testing",
        "https://w3id.org/tribont/core" .

