    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#ASTMD7421> a owl:NamedIndividual ;
    rdfs:label "ASTMD7421" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#BTUhr.ft.degreeF> a owl:NamedIndividual,
        <https://w3id.org/tribont/core#ThermalConductivityUnit> ;
    rdfs:label "BTU/hr.ft.°F" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
