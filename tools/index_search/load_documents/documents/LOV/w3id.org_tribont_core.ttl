        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty dcterms:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tribont/core#name> ] ;
