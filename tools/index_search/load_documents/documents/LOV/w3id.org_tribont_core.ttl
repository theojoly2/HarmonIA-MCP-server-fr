<https://w3id.org/tribont/core#MagnificationProperty> a owl:Class ;
    rdfs:label "MagnificationProperty" ;
    rdfs:comment "MagnificationProperty applyed to something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#OperationProperty> ;
