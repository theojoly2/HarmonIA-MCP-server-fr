    rdfs:comment "Number of contact surfaces of something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#SystemProperty> ;
    ns1:term_status "Testing" .

