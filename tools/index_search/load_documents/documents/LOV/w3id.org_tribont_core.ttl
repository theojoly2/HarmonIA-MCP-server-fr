        <https://w3id.org/tribont/core#PressureUnit> ;
    rdfs:label "Pa" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#RadiationType> a owl:Class ;
    rdfs:label "RadiationType" ;
    rdfs:comment "Radiation type." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#OperationProperty> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#WearScarLength> a owl:Class ;
    rdfs:label "WearScarLength" ;
    rdfs:comment " Length of wear scar.." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/core#DistanceUnit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#DistanceUnit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ],
        <https://w3id.org/tribont/core#WearScarProperty> ;
    owl:disjointWith <https://w3id.org/tribont/core#WearScarVolume> ;
    ns1:term_status "Testing",
        "https://w3id.org/tribont/core" .

