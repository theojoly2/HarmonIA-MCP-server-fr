<https://w3id.org/tribont/core#Laboratory> a owl:Class ;
    rdfs:label "Laboratory" ;
    rdfs:comment "A laboratory." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#Company> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#MGO> a owl:NamedIndividual,
