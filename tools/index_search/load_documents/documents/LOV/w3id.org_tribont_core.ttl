    rdfs:label "BTU/lb.°F" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#Ba> a owl:NamedIndividual,
        <https://w3id.org/tribont/core#MechanicalUnit> ;
    rdfs:label "Ba" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#Body> a owl:Class ;
    rdfs:label "Body" ;
    rdfs:comment "A body can be considered as an aggregate of particles to which it is possible to apply a force" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/tribont/core#Shape> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/tribont/core#Weight> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ;
            owl:someValuesFrom <https://w3id.org/tribont/core#GeometricDimension> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://w3id.org/tribont/core#GeometricDimension> <https://w3id.org/tribont/core#Shape> <https://w3id.org/tribont/core#Volume> <https://w3id.org/tribont/core#Weight> ) ] ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/tribont/core#Volume> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ],
        <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#COFMean> a owl:Class ;
    rdfs:label "COFMean" ;
    rdfs:comment "Mean value of the coefficient of friction." ;
    rdfs:subClassOf <https://w3id.org/tribont/core#FrictionProperty> ;
    ns1:term_status "Testing",
        "https://w3id.org/tribont/core" .

<https://w3id.org/tribont/core#ChamberTemperature> a owl:Class ;
    rdfs:label "ChamberTemperature" ;
    rdfs:comment "Temperature of the chamber where the sample is tested." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#Temperature> ;
    owl:disjointWith <https://w3id.org/tribont/core#SampleTemperature> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#Density> a owl:Class ;
    rdfs:label "Density" ;
    rdfs:comment "Density of something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#DensityUnit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/core#DensityUnit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <https://w3id.org/tribont/core#SolidPhysicalProperty> ;
    owl:disjointWith <https://w3id.org/tribont/core#Porosity> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#Duration> a owl:Class ;
    rdfs:label "Duration" ;
    rdfs:comment "Amount of time during which an event persists." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/core#TimeUnit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#TimeUnit> ;
            owl:onProperty <https://w3id.org/isCharacterisedBy#hasUnit> ],
        <https://w3id.org/tribont/core#OperationProperty> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#EHD> a owl:NamedIndividual,
        <https://w3id.org/tribont/core#LubricationRegime> ;
    rdfs:label "EHD" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#ElectricalConductivity> a owl:Class ;
    rdfs:label "ElectricalConductivity" ;
    rdfs:comment "Electrical conductivity of something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#ElectricalProperty> ;
    owl:disjointWith <https://w3id.org/tribont/core#ElectricalResistivity> ;
    ns1:term_status "Testing" .

<https://w3id.org/tribont/core#HV> a owl:NamedIndividual,
        <https://w3id.org/tribont/core#MechanicalUnit> ;
