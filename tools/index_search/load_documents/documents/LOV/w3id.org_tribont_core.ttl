<https://w3id.org/tribont/core#InnerDiameter> a owl:Class ;
    rdfs:label "InnerDiameter" ;
    rdfs:comment "Inner diameter of something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/core" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#Diameter> ;
    owl:disjointWith <https://w3id.org/tribont/core#OuterDiameter> ;
