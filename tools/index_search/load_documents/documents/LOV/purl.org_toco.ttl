    dcterms:title "Toucan Ontology"@en ;
    ns1:preferredNamespacePrefix "toco" ;
    ns1:preferredNamespaceUri "http://purl.org/toco/" ;
    rdfs:comment "Version 1.1: creation"@en ;
    owl:versionInfo 1.1 .

