<http://purl.oclc.org/net/unis/ontology/sensordata.owl/hasUnit> a owl:DatatypeProperty ;
    rdfs:comment "reused from SENSEI Observation and Measurement Ontology."^^xsd:string ;
    rdfs:domain <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:isDefinedBy <http://purl.oclc.org/net/unis/ontology/sensordata.owl/> ;
    rdfs:range xsd:string .

<http://purl.oclc.org/net/unis/ontology/sensordata.owl/hasUnits> a owl:ObjectProperty ;
    rdfs:comment "the unit of an observation or measurement."^^xsd:string ;
    rdfs:domain <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.oclc.org/net/unis/ontology/sensordata.owl/hasValue> a owl:DatatypeProperty ;
    rdfs:comment "the value of an observation or measurement."^^xsd:string ;
    rdfs:domain <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

dcterms:contributor a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

onto:Attached a owl:Class ;
    rdfs:subClassOf onto:UserDeviceStatus .

onto:AudioService a owl:Class ;
    rdfs:subClassOf onto:Service .

onto:AudioSession a owl:Class ;
    rdfs:subClassOf onto:Session .

onto:BaseStation a owl:Class ;
    rdfs:comment "a \"land station in the land mobile service.\" -- according to the International Telecommunication Union's (ITU) Radio Regulations (RR).\\n\\nit is a transceiver connecting a number of other devices to one another and/or to a wider area. In LTE, it is also known as eNodeB."^^xsd:string ;
    rdfs:subClassOf onto:SystemDevice .

onto:CellularUserEquipment a owl:Class ;
    rdfs:comment "User deivce in a Cellular network."^^xsd:string ;
    rdfs:subClassOf onto:UserEquipment .

onto:Detached a owl:Class ;
    rdfs:subClassOf onto:UserDeviceStatus .

onto:Drop a owl:Class ;
    rdfs:subClassOf onto:Action .

onto:FileTransferService a owl:Class ;
    rdfs:subClassOf onto:Service .

onto:Forward a owl:Class ;
    rdfs:subClassOf onto:Action .

onto:Host a owl:Class ;
    rdfs:comment "A host is a computer or other device connected to a computer network. It is a network node that is assigned a network address."^^xsd:string ;
    rdfs:subClassOf onto:UserDevice .

onto:Output a owl:Class ;
    rdfs:subClassOf onto:Action .

onto:PathFlow a owl:Class ;
    rdfs:subClassOf onto:Flow .

onto:SatelliteGroundStation a owl:Class ;
    rdfs:comment "used in satellite network. Also known as earth station, or earth terminal, it is a terrestrial radio station designed for extraplanetary telecommunication with spacecraft (constituting part of the ground segment of the spacecraft system), or reception of radio waves from astronomical radio sources. Ground stations may be located either on the surface of the Earth, or in its atmosphere.[1] Earth stations communicate with spacecraft by transmitting and receiving radio waves in the super high frequency or extremely high frequency bands (e.g., microwaves). When a ground station successfully transmits radio waves to a spacecraft (or vice versa), it establishes a telecommunications link. A principal telecommunications device of the ground station is the parabolic antenna."^^xsd:string ;
    rdfs:subClassOf onto:UserEquipment .

onto:SatelliteRelayStation a owl:Class ;
    rdfs:comment "An artificial satellite, that relays and amplifies radio telecommunications signals via a transponder; it creates a communication channel between a source transmitter and a receiver at different locations on Earth. Communications satellites are used for television, telephone, radio, internet, and military applications."^^xsd:string ;
    rdfs:subClassOf onto:SystemDevice .

onto:Switch a owl:Class ;
    rdfs:comment "A network switch (also called switching hub, bridging hub, officially MAC bridge) is a computer networking device that connects devices together on a computer network by using packet switching to receive, process, and forward data to the destination device."^^xsd:string ;
    rdfs:subClassOf onto:SystemDevice .

onto:Text a owl:Class ;
    rdfs:subClassOf onto:Service .

onto:VideoService a owl:Class ;
    rdfs:subClassOf onto:Service .

onto:VideoSession a owl:Class ;
    rdfs:subClassOf onto:Session .

onto:WiFiAccessPoint a owl:Class ;
    rdfs:comment "An access point in a WiFi network"^^xsd:string ;
    rdfs:subClassOf onto:AccessPoint .

onto:WiFiUserEquipment a owl:Class ;
    rdfs:comment "a user quipment in Wi-Fi network"^^xsd:string ;
    rdfs:subClassOf onto:UserEquipment .

onto:apsInRange a owl:ObjectProperty ;
    rdfs:domain onto:UserDevice ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:AccessPoint .

onto:belongsTo a owl:ObjectProperty ;
    rdfs:domain onto:UserDevice ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:User ;
    owl:inverseOf onto:hasDevice .

onto:channel a owl:DatatypeProperty ;
    rdfs:comment "the channel id of a interface."^^xsd:string ;
    rdfs:domain onto:Interface ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:int .

onto:contributor a owl:AnnotationProperty .

onto:cookie a owl:DatatypeProperty ;
    rdfs:domain onto:Flow ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:dlDst a owl:DatatypeProperty ;
    rdfs:comment "the Ethernet destination address of the flow. It should be an MAC address, with 6 pairs of hexadecimal digits." ;
    rdfs:domain onto:Flow ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:dlSrc a owl:DatatypeProperty ;
    rdfs:comment "the Ethernet source address of the flow. It should be an MAC address with 6 pairs of hexadecimal digits" ;
    rdfs:domain onto:Flow ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:driver a owl:DatatypeProperty ;
    rdfs:domain onto:AccessPoint ;
    rdfs:range xsd:string .

onto:flags a owl:DatatypeProperty ;
    rdfs:domain onto:Flow ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:frequency a owl:DatatypeProperty ;
    rdfs:comment "the frequency of the radio wave transmitted by a wireless interface (WLAN)."^^xsd:string ;
    rdfs:domain onto:Interface ;
    rdfs:range xsd:float .

onto:from a owl:ObjectProperty ;
    rdfs:comment "the source node that the link is transmit from."^^xsd:string ;
    rdfs:domain onto:Link ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Interface ;
    rdfs:subPropertyOf owl:topObjectProperty .

onto:hardTimeout a owl:DatatypeProperty ;
    rdfs:domain onto:Flow ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:hasAntennaGain a owl:DatatypeProperty ;
    rdfs:comment "the gain of an antenna on the wireless interface."^^xsd:string ;
    rdfs:domain onto:WLAN ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:int .

onto:hasAntennaHeight a owl:DatatypeProperty ;
    rdfs:comment "the height of the antenna of a wireless interface"^^xsd:string ;
    rdfs:domain onto:WLAN ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

onto:hasAssociatedStations a owl:ObjectProperty ;
    rdfs:comment "in wireless networks, the user equipments (mobile stations in another term, e.g., phones, laptops, tablets, etc.) that are associated to the access point."^^xsd:string ;
    rdfs:domain onto:AccessPoint ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:UserDevice ;
    rdfs:subPropertyOf owl:topObjectProperty .

onto:hasBandwidth a owl:ObjectProperty ;
    rdfs:comment "the bandwidth of the link"^^xsd:string ;
    rdfs:domain onto:Link ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:subPropertyOf onto:hasLinkProperty .

onto:hasDatarate a owl:ObjectProperty ;
    rdfs:domain onto:Link ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:subPropertyOf onto:hasLinkProperty .

onto:hasDistance a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:comment "the Euclidean distance between the LiFi user equipment and access point."^^xsd:string ;
    rdfs:domain onto:LiFiAssociation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLiFiAssociationProperty .

onto:hasErrorCode a owl:DatatypeProperty ;
    rdfs:comment "the error code of a service."^^xsd:string ;
    rdfs:domain onto:Service ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:hasFieldOfView a owl:DatatypeProperty ;
    rdfs:comment "Field of view (FOV) is the open observable area where a LiFi user equipment could receive visiable light signal. It is defined by let the incident angle of the LiFi user equipment equals to Pi/2.\\n\\nIf the incident angle larger than Pi/2, the light ray is out of the FOV, thus cannot be received by the LiFi user equipment."^^xsd:string ;
    rdfs:domain onto:LiFiUserEquipment ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLiFiUserEquipmentProperty .

onto:hasFlow a owl:ObjectProperty ;
    rdfs:domain onto:SystemDevice ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Flow .

onto:hasFlowAction a owl:ObjectProperty ;
    rdfs:domain onto:Flow ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Action .

onto:hasGainOfConcentrator a owl:DatatypeProperty ;
    rdfs:comment "The gain of the concentrator on the LiFi user equipment, usually equals to 1."^^xsd:string ;
    rdfs:domain onto:LiFiUserEquipment ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLiFiUserEquipmentProperty .

onto:hasGainofOpticalFilter a owl:DatatypeProperty ;
    rdfs:comment "Gain of optical filter on LiFi access point."^^xsd:string ;
    rdfs:domain onto:LiFiAccessPoint ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLiFiAccessPointProperty .

onto:hasHalfIntensityAngle a owl:DatatypeProperty ;
    rdfs:comment "The angle of half intensity of the LED light transmiting visible light signal in a LiFi access point. \\n\\nA fixed value. It is the angle where the radiated intensity will be half as intense as it would be at 0 degrees, or pointing straight ahead.\\n\\nFactors that contribute to the angle of half intensity include the amount of diffusing material in the epoxy, the shape of the reflector cup which surrounds the LED chip, the shape of the LED lens, the distance from the LED to the tip of the lens, and the type of emitter chip.\\n\\nThe most common value is Pi/3."^^xsd:string ;
    rdfs:domain onto:LiFiAccessPoint ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLiFiAccessPointProperty .

onto:hasIP a owl:DatatypeProperty ;
    rdfs:comment "the IP address of the interface."^^xsd:string ;
    rdfs:domain onto:Interface ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:hasIncidentAngle a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:comment "The angle of incidence of the LED receiver on LiFi user equipment, which is the angle between the visiable light ray incident on a surface and the line perpendicular to the surface at the point of incidence, called the normal."^^xsd:string ;
    rdfs:domain onto:LiFiAssociation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLiFiAssociationProperty .

onto:hasInterfaceName a owl:DatatypeProperty ;
    rdfs:comment "the port number of an interface"^^xsd:string ;
    rdfs:domain onto:Interface ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:hasJoinDate a owl:DatatypeProperty ;
    rdfs:comment "the join date of the user device" ;
    rdfs:domain onto:UserDevice ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:dateTime .

onto:hasLTEAssociation a owl:ObjectProperty ;
    rdfs:range onto:LTEAssociation ;
    rdfs:subPropertyOf onto:hasWirelessAssociation .

onto:hasLiFiAssociation a owl:ObjectProperty ;
    rdfs:domain onto:LiFiWLAN ;
    rdfs:range onto:LiFiAssociation ;
    rdfs:subPropertyOf onto:hasWirelessAssociation .

onto:hasLiFiWLAN a owl:ObjectProperty ;
    rdfs:domain onto:Device ;
    rdfs:range onto:LiFiWLAN ;
    rdfs:subPropertyOf onto:hasWLAN .

onto:hasMAC a owl:DatatypeProperty ;
    rdfs:comment "the MAC address of the interface."^^xsd:string ;
    rdfs:domain onto:Interface ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:hasOpticalTransmittedPower a owl:DatatypeProperty ;
    rdfs:comment "the transmitted power of the LED on the LiFi access point"^^xsd:string ;
    rdfs:domain onto:LiFiAccessPoint ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLiFiAccessPointProperty .

onto:hasPacketLoss a owl:DatatypeProperty ;
    rdfs:comment "the packet loss rate of a link, usually in percentage."^^xsd:string ;
    rdfs:domain onto:Link ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

onto:hasPort a owl:ObjectProperty ;
    rdfs:domain onto:Device ;
    rdfs:range onto:Interface ;
    rdfs:subPropertyOf onto:hasInterface .

onto:hasRadianceAngle a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:comment "the radiance angle of the light ray transmitted from LED on LiFi access point."^^xsd:string ;
    rdfs:domain onto:LiFiAssociation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLiFiAssociationProperty .

onto:hasRespansivity a owl:DatatypeProperty ;
    rdfs:domain onto:LiFiAccessPoint ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLiFiAccessPointProperty .

onto:hasRoundTripTime a owl:ObjectProperty ;
    rdfs:comment "the round trip time of a link, which is the time taken for signal travel a round trip via this link."^^xsd:string ;
    rdfs:domain onto:Link ;
    rdfs:range <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:subPropertyOf onto:hasLinkProperty .

onto:hasSatelliteAssociation a owl:ObjectProperty ;
    rdfs:domain onto:Device ;
    rdfs:range onto:SatelliteAssociation ;
    rdfs:subPropertyOf onto:hasWirelessAssociation .

onto:hasService a owl:ObjectProperty ;
    rdfs:domain onto:UserDevice ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Service .

onto:hasServiceEndTime a owl:DatatypeProperty ;
    rdfs:comment "the time that a service ends."^^xsd:string ;
    rdfs:domain onto:Service ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:dateTime .

onto:hasServiceStartTime a owl:DatatypeProperty ;
    rdfs:comment "the start time of a service."^^xsd:string ;
    rdfs:domain onto:Service ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:dateTime .

onto:hasServiceStatus a owl:DatatypeProperty ;
    rdfs:comment "the status of the service."^^xsd:string ;
    rdfs:domain onto:Service ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:hasServiceType a owl:DatatypeProperty ;
    rdfs:comment "the type of communication services, e.g., video, audio, file transmit, text transmiting, etc."^^xsd:string ;
    rdfs:domain onto:Service ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:hasStandardDeviation a owl:ObjectProperty ;
    rdfs:comment "After multiple round trip time tested on a link, the deviation of these test results."^^xsd:string ;
    rdfs:domain onto:Link ;
    rdfs:range <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:subPropertyOf onto:hasLinkProperty .

onto:hasThroughPut a owl:ObjectProperty ;
    rdfs:domain onto:Link ;
    rdfs:range <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:subPropertyOf onto:hasLinkProperty .

onto:hasTransmitPower a owl:ObjectProperty ;
    rdfs:domain onto:Interface ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:subPropertyOf owl:topObjectProperty .

onto:hasTxpower a owl:ObjectProperty ;
    rdfs:domain onto:Link ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> ;
    rdfs:subPropertyOf onto:hasLinkProperty .

onto:hasUserDeviceStatus a owl:ObjectProperty ;
    rdfs:domain onto:UserDevice ;
    rdfs:range onto:UserDeviceStatus .

onto:hasUserID a owl:DatatypeProperty ;
    rdfs:comment "the user ID of the user" ;
    rdfs:domain onto:User ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:hasWiFiAssociation a owl:ObjectProperty ;
    rdfs:domain onto:WiFiWLAN ;
    rdfs:range onto:WiFiAssociation ;
    rdfs:subPropertyOf onto:hasWirelessAssociation .

onto:hasWiFiWLAN a owl:ObjectProperty ;
    rdfs:domain onto:Device ;
    rdfs:range onto:WiFiWLAN ;
    rdfs:subPropertyOf onto:hasWLAN .

onto:hasWiredLink a owl:ObjectProperty ;
    rdfs:domain onto:Interface ;
    rdfs:range onto:WiredLink ;
    rdfs:subPropertyOf onto:hasLink ;
    owl:propertyDisjointWith onto:hasWirelessAssociation .

onto:idleTimeout a owl:DatatypeProperty ;
    rdfs:domain onto:Flow ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:inPort a owl:DatatypeProperty ;
    rdfs:comment "the port number of the in port of the flow, or could be a keyword, such as \"LOCAL\"" ;
    rdfs:domain onto:Flow ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:isUP a owl:DatatypeProperty ;
    rdfs:comment "indicate whether a interface is up or not." ;
    rdfs:domain onto:Interface ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

onto:license a owl:AnnotationProperty .

onto:mode a owl:DatatypeProperty ;
    rdfs:domain onto:Interface ;
    rdfs:range xsd:int .

onto:nwProtocol a owl:DatatypeProperty ;
    rdfs:comment "network protocol. The nw_proto property of a flow." ;
    rdfs:domain onto:Flow ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:nwTos a owl:DatatypeProperty ;
    rdfs:comment "network type of service. the nw_tos property of a flow. It should be a decimal number with the value between 0-255." ;
    rdfs:domain onto:Flow ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:priority a owl:DatatypeProperty ;
    rdfs:domain onto:Flow ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:range a owl:ObjectProperty ;
    rdfs:comment "the signal range of wireless devices, such as WiFi access point, LiFi access point, WiFi mobile station, and LiFi mobile station."^^xsd:string ;
    rdfs:domain onto:Device ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> .

onto:ssid a owl:DatatypeProperty ;
    rdfs:comment "in wireless networks, the ssid of the network this device belongs to."^^xsd:string ;
    rdfs:domain onto:Device ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:stationsInRange a owl:ObjectProperty ;
    rdfs:comment "in wireless networks (WiFi/LiFi), the mobile stations in the range of the access points."^^xsd:string ;
    rdfs:domain onto:AccessPoint ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:UserEquipment .

onto:tableId a owl:DatatypeProperty ;
    rdfs:domain onto:Flow ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:hasFlowProperty .

onto:to a owl:ObjectProperty ;
    rdfs:comment "the destination node of the link."^^xsd:string ;
    rdfs:domain onto:Link ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Interface ;
    rdfs:subPropertyOf owl:topObjectProperty .

onto:toPort a owl:DatatypeProperty ;
    rdfs:comment "the port number of the port forward to defined by the to_port property of the flow action OUTPUT." ;
    rdfs:domain onto:Action ;
    rdfs:range xsd:string .

onto:unReachable a owl:Class ;
    rdfs:subClassOf onto:UserDeviceStatus .

ns1:preferredNamespacePrefix a owl:AnnotationProperty .

ns1:preferredNamespaceUri a owl:AnnotationProperty .

<http://www.w3.org/2003/01/geo/wgs84_pos#Point> a owl:Class ;
    rdfs:label "location" ;
    rdfs:comment "The relation between something and the point, \\n or other geometrical thing in space, where it is.  For example, the realtionship between\\n a radio tower and a Point with a given lat and long.\\n Or a relationship between a park and its outline as a closed arc of points, or a road and\\n its location as a arc (a sequence of points).\\n Clearly in practice there will be limit to the accuracy of any such statement, but one would expect\\n an accuracy appropriate for the size of the object and uses such as mapping ." ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpartialThing> .

<http://www.w3.org/2003/01/geo/wgs84_pos#alt> a owl:DatatypeProperty ;
    rdfs:comment "the altitude of a spartial thing, i.e., a point." ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpartialThing> ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ;
    rdfs:range xsd:float .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpartialThing> ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#>,
        "the latitude of a point" ;
    rdfs:range xsd:float .

<http://www.w3.org/2003/01/geo/wgs84_pos#location> a owl:ObjectProperty ;
    rdfs:comment "The relation between something and the point, \\n or other geometrical thing in space, where it is.  For example, the realtionship between\\n a radio tower and a Point with a given lat and long.\\n Or a relationship between a park and its outline as a closed arc of points, or a road and\\n its location as a arc (a sequence of points).\\n Clearly in practice there will be limit to the accuracy of any such statement, but one would expect\\n an accuracy appropriate for the size of the object and uses such as mapping ." ;
    rdfs:domain onto:Device ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpartialThing> .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a owl:DatatypeProperty ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpartialThing> ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#>,
        "the longitude of a spartial thing, i.e., a point." ;
    rdfs:range xsd:float .

foaf:firstName a owl:DatatypeProperty ;
    rdfs:comment "the first name of a user." ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range rdfs:Literal .

foaf:gender a owl:DatatypeProperty ;
    rdfs:comment "the gender of a user, reused from foaf" ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range rdfs:Literal .

foaf:lastName a owl:DatatypeProperty ;
    rdfs:comment "the last name of a person.\\nReused from foaf" ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range rdfs:Literal .

<http://purl.obolibrary.org/obo/UO_0000058> a owl:Class ;
    rdfs:label "rotational frequency unit" ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000105> .

<http://purl.obolibrary.org/obo/UO_0000113> a owl:Class ;
    rdfs:label "power unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

onto:LTEAssociation a owl:Class ;
    rdfs:comment "the electromagnetic wave carring modulated signal between LTE base station, or eNodeB, and user equipment"^^xsd:string ;
    rdfs:subClassOf onto:WirelessAssociation .

onto:SatelliteAssociation a owl:Class ;
    rdfs:comment "the milli-meter electromagnetic wave carring modulated signal between satellite base stations and ground station."^^xsd:string ;
    rdfs:subClassOf onto:WirelessAssociation .

onto:WiFiAssociation a owl:Class ;
    rdfs:comment "the electromagnetic wave carring modulated signal between LTE base station, or eNodeB, and user equipment"^^xsd:string ;
    rdfs:subClassOf onto:WirelessAssociation .

onto:WiredLink a owl:Class ;
    rdfs:comment "wired link through twisted cable, optical fiber, etc." ;
    rdfs:subClassOf onto:Link ;
    owl:disjointWith onto:WirelessAssociation .

onto:hasDevice a owl:ObjectProperty ;
    rdfs:domain onto:User ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:UserDevice .

onto:hasWirelessLinkProperty a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain onto:WirelessAssociation ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasLinkProperty .

onto:isIn a owl:ObjectProperty ;
    rdfs:comment "the relation that a interface belongs to a device. A device can have multiple interfaces, but a interface can be in one and only one device."^^xsd:string ;
    rdfs:domain onto:Interface ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Device .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

<http://purl.obolibrary.org/obo/UO_0000111> a owl:Class ;
    rdfs:label "energy unit" ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

onto:LiFiWLAN a owl:Class ;
    rdfs:comment "WLAN interface on the devices in LIFi network, e.g., LiFi user equipment, LiFi access point."^^xsd:string ;
    rdfs:subClassOf onto:WLAN .

onto:Session a owl:Class ;
    rdfs:subClassOf onto:ConceptEntities .

onto:WiFiWLAN a owl:Class ;
    rdfs:comment "WLAN interface on the devices in LIFi network, e.g., LiFi user equipment, LiFi access point."^^xsd:string ;
    rdfs:subClassOf onto:WLAN .

onto:hasInterface a owl:ObjectProperty ;
    rdfs:comment "the fact that a device has a interface."^^xsd:string ;
    rdfs:domain onto:Device ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Interface ;
    owl:inverseOf onto:isIn .

onto:hasLiFiUserEquipmentProperty a owl:DatatypeProperty ;
    rdfs:comment "properties of LiFi user equipments."^^xsd:string ;
    rdfs:domain onto:LiFiUserEquipment ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

onto:hasLink a owl:ObjectProperty ;
    rdfs:domain onto:Interface ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Link .

onto:hasWLAN a owl:ObjectProperty ;
    rdfs:domain onto:Device ;
    rdfs:range onto:WLAN ;
    rdfs:subPropertyOf onto:hasInterface .

<http://purl.obolibrary.org/obo/UO_0000001> a owl:Class ;
    rdfs:label "length unit" ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000060> a owl:Class ;
    rdfs:label "speed/velocity unit" ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000105> a owl:Class ;
    rdfs:label "frequency unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

onto:LiFiUserEquipment a owl:Class ;
    rdfs:comment "any device used directly by an end-user to communicate. It can be a hand-held telephone, a laptop computer equipped with a mobile broadband adapter, or any other device."^^xsd:string ;
    rdfs:subClassOf onto:UserEquipment .

onto:User a owl:Class ;
    rdfs:comment "reused from foaf (http://xmlns.com/foaf/0.1/). Represent a user in the telecommunication system."^^xsd:string ;
    rdfs:subClassOf foaf:Person .

onto:hasLiFiAssociationProperty a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:comment "The properties of the visiable light association between the LED on LiFi access point and LiFi user equipment."^^xsd:string ;
    rdfs:domain onto:LiFiAssociation ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf onto:hasWirelessLinkProperty .

onto:PhysicalInfrastructure a owl:Class ;
    rdfs:comment "Describe all the physical resources in a telecommunication network system, which is divided into three main modules, namely, device, interface, link. \\n\\nPlease be reminded the electromagnetic wave (which is the links of all wireless communication netwoks), even if it is invisable, physically exists. Thus, it is also described in the subclass of \"net;PhysicalInfrastructure\"."^^xsd:string .

onto:UserDeviceStatus a owl:Class ;
    rdfs:subClassOf onto:ConceptEntities .

onto:hasLiFiAccessPointProperty a owl:DatatypeProperty ;
    rdfs:comment "datatype properties dedicated for LiFi access points"^^xsd:string ;
    rdfs:domain onto:LiFiAccessPoint ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

foaf:Person a owl:Class ;
    rdfs:isDefinedBy foaf: ;
    rdfs:subClassOf onto:ConceptEntities .

<http://purl.obolibrary.org/obo/UO_0000231> a owl:Class ;
    rdfs:label "information unit" ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

onto:Action a owl:Class ;
    rdfs:comment "the action of a flow defined in OpenFlow protocol" ;
    rdfs:subClassOf onto:ConceptEntities .

onto:LiFiAccessPoint a owl:Class ;
    rdfs:comment "The access point in Li-Fi network. Li-Fi is a wireless optical networking technology that uses light-emitting diodes (LEDs) for data transmission."^^xsd:string ;
    rdfs:subClassOf onto:AccessPoint .

onto:LiFiAssociation a owl:Class ;
    rdfs:comment "the visiable light carring modulated signals in Li-Fi network. Transmited and received by LiFi user equipment and LiFi access point."^^xsd:string ;
    rdfs:subClassOf onto:WirelessAssociation .

onto:SystemDevice a owl:Class ;
    rdfs:comment "All the physical facilities in the telecommunication system that provide the communication service to uses. For example: base station towers, Wi-Fi access points, switches, servers, etc."^^xsd:string ;
    rdfs:subClassOf onto:Device .

onto:UserEquipment a owl:Class ;
    rdfs:comment "any device used directly by an end-user to communicate. It can be a hand-held telephone, a laptop computer equipped with a mobile broadband adapter, or any other device."^^xsd:string ;
    rdfs:subClassOf onto:UserDevice .

onto:hasWirelessAssociation a owl:ObjectProperty ;
    rdfs:domain onto:WLAN ;
    rdfs:range onto:WirelessAssociation ;
    rdfs:subPropertyOf onto:hasLink .

<http://www.w3.org/2003/01/geo/wgs84_pos#SpartialThing> a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ;
    rdfs:subClassOf onto:ConceptEntities .

onto:AccessPoint a owl:Class ;
    rdfs:comment "a wireless access point, or more generally just access point (AP), is a networking hardware device that allows a Wi-Fi/Li-Fi device to connect to a wired network. The AP usually connects to a router (via a wired network) as a standalone device, but it can also be an integral component of the router itself. An AP is differentiated from a hotspot, which is the physical location where Wi-Fi access to a WLAN is available."^^xsd:string ;
    rdfs:subClassOf onto:SystemDevice .

onto:WLAN a owl:Class ;
    rdfs:comment "A wireless local area network (WLAN) interface, also known as WLAN, is the interface of a wireless computer network that links two or more devices using wireless communication within a limited area such as a home, school, computer laboratory, or office building." ;
    rdfs:subClassOf onto:Interface .

<http://purl.obolibrary.org/obo/UO_0000003> a owl:Class ;
    rdfs:label "time unit" ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

onto:WirelessAssociation a owl:Class ;
    rdfs:comment "the electromeganetic radio transmiting through wireless channels in wireless network, carring communication data. Depend on its frequency, it could be visiable light, micro waves, radio waves."^^xsd:string ;
    rdfs:subClassOf onto:Link .

onto:hasLinkProperty a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain onto:Link ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

<http://purl.obolibrary.org/obo/uo.owl/unit> a owl:Class ;
    rdfs:comment "reused from Units of measurement Ontology"^^xsd:string ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:subClassOf onto:ConceptEntities .

onto:ConceptEntities a owl:Class ;
    owl:disjointWith onto:PhysicalInfrastructure .

onto:UserDevice a owl:Class ;
    rdfs:comment "User Devices, requiring connectivity services, e.g., phones, tablets, laptops, wearable devices, etc."^^xsd:string ;
    rdfs:subClassOf onto:Device .

onto:Service a owl:Class ;
    rdfs:comment "a communication service, e.g., voice, video, file uploading/downloading, etc."^^xsd:string ;
    rdfs:subClassOf onto:ConceptEntities .

<http://purl.oclc.org/net/unis/ontology/sensordata.owl/ObervationAndMeasurement> a owl:Class ;
    rdfs:comment "reused from SenSei Observation And Measurement Ontology (http://purl.oclc.org/net/unis/ontology/sensordata.owl)."^^xsd:string ;
    rdfs:isDefinedBy <http://purl.oclc.org/net/unis/ontology/sensordata.owl> ;
    rdfs:subClassOf onto:ConceptEntities .

onto:hasFlowProperty a owl:DatatypeProperty ;
    rdfs:isDefinedBy onto: .

onto:Device a owl:Class ;
    rdfs:comment "represent all the devices in the physical infrastructure of telecommunciation system. \\n\\nAccording to its user, could be divided into UserDevice and SystemDevice."^^xsd:string ;
    rdfs:subClassOf onto:PhysicalInfrastructure .

onto:Link a owl:Class ;
    rdfs:subClassOf onto:PhysicalInfrastructure .

onto:Flow a owl:Class ;
    rdfs:comment "the flow entry in a flow table inside a switch or route. Defined by OpenFlow protocol." ;
    rdfs:subClassOf onto:ConceptEntities .

onto:Interface a owl:Class ;
    rdfs:subClassOf onto:PhysicalInfrastructure .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual,
        owl:Ontology ;
    ns2:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:contributor <http://www.macs.hw.ac.uk/~ajg33/>,
        <https://www.eng.ed.ac.uk/about/people/mr-mohammad-dehghani-soltani>,
        <https://www.hw.ac.uk/staff/uk/eps/stephen-mclaughlin.htm> ;
    dcterms:creator <https://www.gla.ac.uk/schools/computing/staff/qianruzhou/> ;
    dcterms:description "A ontology developed for telecommunciation network systems with hybrid technologies, e.g., WiFi, LiFi, LTE, 2G/3G, optical, etc." ;
    dcterms:issued "2015-3-1"^^xsd:date ;
    dcterms:modified "2019-3-29"^^xsd:date ;
    dcterms:publisher <http://hw.ac.uk> ;
