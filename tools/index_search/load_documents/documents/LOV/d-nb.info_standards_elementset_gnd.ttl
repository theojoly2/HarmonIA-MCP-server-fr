onto:functionOrRole a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Function or role"@en ;
    onto:marc21equivalent "550 $0 $4=funk" ;
    rdfs:comment "This property is equivalent to gndo:functionOrRoleAsLiteral but points to a subject heading instead of giving a literal value."@en ;
    rdfs:domain [ a owl:Class ;
