onto:broaderTermGeneric a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Broader term (generic)"@en ;
    onto:marc21equivalent "550 $0 $4=obge" ;
    rdfs:comment "The generic relation is a semantic relation between two concepts\\n      where the intension of one of the concepts includes that of the other concepts and at least\\n      one additional delimiting characteristic is added."@en ;
    rdfs:domain onto:SubjectHeading ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SubjectHeading ;
    rdfs:subPropertyOf onto:broaderTermGeneral ;
    owl:inverseOf onto:narrowerTermGeneric .

onto:broaderTermInstantial a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Broader term (instantial)"@en ;
    onto:marc21equivalent "550 $0 $4=obin" ;
    rdfs:comment "The instance relationship links a general concept such as a class of\\n      things or events, and an individual instance oft hat class, which is often represented by a\\n      proper name."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SubjectHeading ;
    rdfs:subPropertyOf onto:broaderTermGeneral ;
    owl:inverseOf onto:narrowerTermInstantial .

onto:contributingFamily a rdf:Property,
        owl:ObjectProperty ;
