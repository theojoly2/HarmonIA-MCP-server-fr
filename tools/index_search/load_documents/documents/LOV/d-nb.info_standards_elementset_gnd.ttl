        "510 $0 $4=komg" ;
    rdfs:comment "An author, artist, etc., relating him/her to a resource for which there is or once was substantial authority for designating that person as author, creator, etc. of the work"@en ;
    rdfs:domain onto:Work ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:subPropertyOf onto:composer,
        <http://rdaregistry.info/Elements/u/P60426> .

onto:acquaintanceshipOrFriendship a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Acquaintanceship or friendship"@en ;
    onto:marc21equivalent "500 $0 $4=beza" ;
    rdfs:comment "Relationship between a person, family, or corporate body and another person, family, or corporate body which cannot be specified more closely"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:seeAlso onto:memberOfTheFamily ;
    rdfs:subPropertyOf foaf:knows ;
    owl:equivalentProperty <http://d-nb.info/standards/elementset/agrelon#hasAcquaintance> .

onto:addition a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Addition"@en ;
    onto:marc21equivalent "100 $g",
        "400 $g" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:NameOfThePerson onto:CorporateBody onto:ConferenceOrEvent onto:Work onto:PlaceOrGeographicName onto:SubjectHeading ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:deprecated true .

onto:addressee a rdf:Property,
