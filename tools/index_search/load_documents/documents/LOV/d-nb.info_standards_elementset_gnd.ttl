            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] .

onto:affiliation a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Affiliation"@en ;
    onto:marc21equivalent "510 $0 $4=affi",
        "511 $0 $4=affi",
        "551 $0 $4=affi" ;
    rdfs:comment "A corporate body associated with a person or group of persons."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:PlaceOrGeographicName ) ] ;
    rdfs:seeAlso onto:affiliationAsLiteral ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/a/P50101> ;
    owl:equivalentProperty <http://d-nb.info/standards/elementset/agrelon#hasAssociate> .

onto:affiliationAsLiteral a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Affiliation (Literal)"@en ;
    onto:marc21equivalent "510 $a $b $g $n $4=affi",
        "511 $a $c $d $e $g $n $4=affi",
        "551 $a $g $z $4=affi" ;
    rdfs:comment "A corporate body associated with a person or group of persons.\\n\\t\\tThis property is equivalent to gndo:affiliation but gives a literal instead of\\n\\t\\ta URI."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso onto:affiliation ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/a/P50101> .

