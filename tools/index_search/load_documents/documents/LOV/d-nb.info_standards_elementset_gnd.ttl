onto:topic a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Topic"@en ;
    onto:marc21equivalent "500 $0 $4=them",
        "510 $0 $4=them",
        "511 $0 $4=them",
        "530 $0 $4=them",
        "550 $0 $4=them",
        "551 $0 $4=them" ;
    rdfs:comment "Topic that is related to a corporate body, conference, person, family, subject heading or work."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:Family onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] .

onto:translator a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Translator"@en ;
    onto:marc21equivalent "500 $0 $4=uebe",
        "510 $0 $4=uebe" ;
