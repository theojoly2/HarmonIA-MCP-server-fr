onto:accordingWork a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "According work"@en ;
    onto:marc21equivalent "530 $0 $4=werk" ;
    rdfs:domain onto:Work ;
    rdfs:isDefinedBy onto: ;
