        owl:DatatypeProperty ;
    rdfs:label "Function or role (Literal)"@en ;
    onto:marc21equivalent "550 $a $g $4=funk" ;
    rdfs:comment "This property is equivalent to gndo:functionOrRole but gives a literal instead of a URI"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:SubjectHeading ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso onto:functionOrRole .

onto:listMembers a foaf:Organization ;
    rdfs:label "Members of the GND ontology mailing list"@en ;
    foaf:mbox "gnd-ontology@lists.dnb.de" .

onto:memberOfTheFamily a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Member of the family"@en ;
    onto:marc21equivalent "500 $0 $4=mitg" ;
    rdfs:domain onto:DifferentiatedPerson ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Family ;
    rdfs:seeAlso onto:broaderTermPartitive ;
    rdfs:subPropertyOf <http://d-nb.info/standards/elementset/agrelon#isMemberOf>,
        onto:member,
        <http://rdaregistry.info/Elements/a/P50056> .

onto:narrowerTermGeneric a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Narrower term (generic)"@en ;
    rdfs:comment "The generic relation is a semantic relation between two concepts\\n      where the intension of one of the concepts includes that of the other concepts and at least\\n      one additional delimiting characteristic is added."@en ;
    rdfs:domain onto:SubjectHeading ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SubjectHeading ;
    rdfs:subPropertyOf onto:narrowerTermGeneral ;
    owl:inverseOf onto:broaderTermGeneric .

onto:narrowerTermInstantial a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Narrower term (instantial)"@en ;
    rdfs:comment "The instance relationship links a general concept such as a class of\\n      things or events, and an individual instance oft hat class, which is often represented by a\\n      proper name."@en ;
    rdfs:domain onto:SubjectHeading ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:subPropertyOf onto:narrowerTermGeneral ;
    owl:inverseOf onto:broaderTermInstantial .

onto:narrowerTermPartitive a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Narrower term (partitive)"@en ;
    rdfs:comment "The hierarchical whole-part relationship covers a limited range of\\n      situations in which a part of an entity or system belongs uniquely to a particular possessing\\n      whole. When applied to persons, this is the relation between a single person (particularly gods)\\n\\t  and hierarchically superior groups of gods and mythologic entities."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:subPropertyOf onto:narrowerTermGeneral ;
    owl:inverseOf onto:broaderTermPartitive .

onto:owner a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Owner"@en ;
    onto:marc21equivalent "500 $0 $4=besi",
        "510 $0 $4=besi" ;
    rdfs:comment "A person, family, or organization that currently owns an item or collection, i.e. has legal possession of a resource"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60404> .

onto:placeOfBirth a rdf:Property,
