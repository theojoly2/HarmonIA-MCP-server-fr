    rdfs:label "Place of Birth (Literal)"@en ;
    onto:marc21equivalent "551 $a $g $z $4=ortg" ;
    rdfs:comment "This property is equivalent to gndo:placeOfBirth but gives a literal instead of\\n\\t\\ta reference to a geographic entity"@en ;
    rdfs:domain onto:DifferentiatedPerson ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso onto:placeOfBirth ;
    rdfs:subPropertyOf onto:associatedPlace,
        <http://rdaregistry.info/Elements/a/P50119> .

onto:placeOfDeath a rdf:Property,
