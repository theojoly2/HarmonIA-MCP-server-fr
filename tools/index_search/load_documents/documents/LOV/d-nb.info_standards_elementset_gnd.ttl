onto:accreditedArtist a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Accredited artist"@en ;
    onto:marc21equivalent "500 $0 $4=kueg",
        "510 $0 $4=kueg" ;
    rdfs:comment "An author, artist, etc., relating him/her to a resource for which there is or once was substantial authority for designating that person as author, creator, etc. of the work"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:subPropertyOf onto:artist,
        <http://rdaregistry.info/Elements/u/P60431> .

onto:accreditedAuthor a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Accredited author"@en ;
    onto:marc21equivalent "500 $0 $4=autg",
        "510 $0 $4=autg" ;
    rdfs:comment "An author, artist, etc., relating him/her to a resource for which there is or once was substantial authority for designating that person as author, creator, etc. of the work"@en ;
    rdfs:domain onto:Work ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:subPropertyOf onto:author,
        <http://rdaregistry.info/Elements/u/P60434> .

onto:accreditedComposer a rdf:Property,
        owl:ObjectProperty ;
