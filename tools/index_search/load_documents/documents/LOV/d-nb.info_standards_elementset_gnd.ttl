    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Family .

