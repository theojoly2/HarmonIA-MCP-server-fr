    rdfs:comment "This property is equivalent to gndo:placeOfDeath but gives a literal instead of\\n\\t\\ta reference to a geographic entity"@en ;
    rdfs:domain onto:DifferentiatedPerson ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso onto:placeOfDeath ;
    rdfs:subPropertyOf onto:associatedPlace,
        <http://rdaregistry.info/Elements/a/P50118> .

onto:professionOrOccupation a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Profession or occupation"@en ;
    onto:marc21equivalent "550 $0 $4=berc",
        "550 $0 $4=beru" ;
