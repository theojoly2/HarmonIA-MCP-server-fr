    onto:marc21equivalent "500 $0 $4=adre",
        "510 $0 $4=adre" ;
    rdfs:comment "A person, family, or organization to whom the correspondence in a work is addressed."@en ;
    rdfs:domain onto:Work ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
