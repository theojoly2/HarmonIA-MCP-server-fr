        <http://rdaregistry.info/Elements/a/P50218> .

onto:relatedDdcWithDegreeOfDeterminacy1 a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related Dewey Decimal Classification with degree of determinacy\\n      1"@en ;
    rdfs:comment "The connotation scope of the GND entity corresponds to a small part\\n      to the connotation scope of the assigned DDC class."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: .

onto:relatedDdcWithDegreeOfDeterminacy2 a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related Dewey Decimal Classification with degree of determinacy\\n      2"@en ;
    rdfs:comment "The connotation scope of the GND entity is identical or nearly\\n      identical to the connotation scope of a topic that is logically part of the class but is less\\n      extensive in scope than the concept represented by the class number."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: .

onto:relatedDdcWithDegreeOfDeterminacy3 a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related Dewey Decimal Classification with degree of determinacy\\n      3"@en ;
    rdfs:comment "The connotation scope of the GND entity is identical or nearly\\n      identical to the connotation scope of a topic that approximates the whole of the assigned DDC\\n      class. According to DDC terms, topics that are nearly coextensive with the full meaning of a\\n      class or cover more than half of the content of the class approximate the whole of the DDC\\n      class."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: .

onto:relatedDdcWithDegreeOfDeterminacy4 a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related Dewey Decimal Classification with degree of determinacy\\n      4"@en ;
    rdfs:comment "The connotation scope of the GND entity is identical to the\\n      connotation scope of the topic emphasized in the DDC class heading."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: .

onto:relatedFamily a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related family"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:Family onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Family ;
    rdfs:subPropertyOf <http://d-nb.info/standards/elementset/agrelon#relatedAgent>,
        <http://rdaregistry.info/Elements/a/P50219> .

onto:relatedPlaceOrGeographicName a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related place or geographic name"@en ;
    onto:marc21equivalent "551 $0 $4=geoa",
        "551 $0 $4=rela" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:Family onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:PlaceOrGeographicName .

onto:relatedSubjecHeading a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related subject heading"@en ;
    onto:marc21equivalent "550 $0 $4=rela" ;
    rdfs:comment "Use relatedSubjectHeading ('subject', not 'subjec') instead"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:Family onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SubjectHeading ;
    rdfs:seeAlso onto:relatedSubjectHeading ;
    owl:deprecated true .

onto:relatedTerm a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Related Term"@en ;
    onto:marc21equivalent "500 $0 $4=vbal",
        "510 $0 $4=vbal",
        "511 $0 $4=vbal",
        "530 $0 $4=vbal",
        "550 $0 $4=vbal",
        "551 $0 $4=vbal" ;
    rdfs:comment "The associative relationship covers associations between pairs of\\n      concepts that are not related hierarchically, but are semantically or concetually associated\\n      to such an extent that the link between them needs to be made explicit in the thesaurus. "@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:Family onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:Family onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] .

onto:relatedWork a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related work"@en ;
    onto:marc21equivalent "530 $0 $4=rela" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:Family onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Work .

onto:restorer a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Restorer"@en ;
    onto:marc21equivalent "500 $0 $4=rest",
        "510 $0 $4=rest" ;
    rdfs:comment "A person, family, or organization responsible for the set of technical, editorial, and intellectual procedures aimed at compensating for the degradation of an item by bringing it back to a state as close as possible to its original condition"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60450> .

onto:revisor a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Revisor"@en ;
    onto:marc21equivalent "500 $0 $4=bear" ;
    rdfs:comment "A person or organization who 1) reworks a musical composition, usually for a different medium, or 2) rewrites novels or stories for motion pictures or other audiovisual medium."@en ;
    rdfs:domain onto:Work ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:DifferentiatedPerson .

onto:screenwriter a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Screenwriter"@en ;
    onto:marc21equivalent "500 $0 $4=vfrd",
        "510 $0 $4=vfrd" ;
