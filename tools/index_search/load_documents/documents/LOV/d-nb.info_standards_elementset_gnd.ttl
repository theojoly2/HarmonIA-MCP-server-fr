onto:architect a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Architect"@en ;
    onto:marc21equivalent "500 $0 $4=arch",
        "510 $0 $4=arch" ;
    rdfs:comment "A person, family, or organization responsible for creating an\\n\\t\\tarchitectural design, including a pictorial representation intended to show how a building,\\n\\t\\tetc., will look when completed. It also oversees the construction of structures."@en ;
    rdfs:domain onto:PlaceOrGeographicName ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson ) ] ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60435> .

onto:arranger a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Arranger"@en ;
    onto:marc21equivalent "500 $0 $4=arra",
        "510 $0 $4=arra" ;
    rdfs:comment "A person, family, or organization contributing to a musical\\n\\t\\twork by rewriting the composition for a medium of performance different from that\\n\\t\\tfor which the work was originally intended, or modifying the work for the same\\n\\t\\tmedium of performance, etc., such that the musical substance of the original\\n\\t\\tcomposition remains essentially unchanged. For extensive modification that effectively\\n\\t\\tresults in the creation of a new musical work, see composer."@en ;
    rdfs:domain onto:Work ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60379> .

