    rdfs:seeAlso onto:professionOrOccupationAsLiteral ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/a/P50104> .

onto:professionOrOccupationAsLiteral a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Profession or occupation (Literal)"@en ;
    onto:marc21equivalent "550 $a $g $4=berc",
        "550 $a $g $4=beru" ;
    rdfs:comment "This property is equivalent to gndo:professionOrOccupation but gives a literal instead of\\n\\t\\ta reference to a subject heading"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso onto:professionOrOccupation ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/a/P50104> .

onto:pseudonym a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Pseudonym"@en ;
    onto:marc21equivalent "500 $0 $4=pseu" ;
    rdfs:comment "Links a person's real identity to an identity under which one or more persons act, e. g. write, compose or create art, but that is not the person's real name (i. e. a pseudonym)."@en ;
    rdfs:domain onto:DifferentiatedPerson ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:DifferentiatedPerson ;
    rdfs:subPropertyOf onto:relatedPerson,
        <http://rdaregistry.info/Elements/a/P50105> ;
    owl:inverseOf onto:realIdentity .

onto:realIdentity a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Real identity"@en ;
    onto:marc21equivalent "500 $0 $4=nawi" ;
    rdfs:comment "Links an identity under which one or more persons act, e. g. write, compose or create art, but that is not their real name (i. e. a pseudonym) to their real identity."@en ;
    rdfs:domain onto:DifferentiatedPerson ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:DifferentiatedPerson ;
    rdfs:subPropertyOf onto:relatedPerson,
        <http://rdaregistry.info/Elements/a/P50106> ;
    owl:inverseOf onto:pseudonym .

onto:relatedSubjectHeading a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related subject heading"@en ;
    onto:marc21equivalent "550 $0 $4=rela" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:Family onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SubjectHeading .

onto:startingOrFinalPointOfADistance a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Starting or final point of a distance"@en ;
    onto:marc21equivalent "551 $0 $4=punk" ;
    rdfs:domain onto:PlaceOrGeographicName ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:PlaceOrGeographicName .

onto:titleOfNobility a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Title of nobility"@en ;
    onto:marc21equivalent "550 $0 $4=adel" ;
    rdfs:comment "A title of nobility held by a person or family."@en ;
    rdfs:domain onto:DifferentiatedPerson ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SubjectHeading ;
    rdfs:seeAlso onto:titleOfNobilityAsLiteral ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/a/P50059>,
        <http://rdaregistry.info/Elements/a/P50110>,
        foaf:title .

onto:titleOfNobilityAsLiteral a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Title of nobility (Literal)"@en ;
    onto:marc21equivalent "550 $a $g $4=adel" ;
    rdfs:comment "A title of nobility held by a person or family.\\n\\t\\tThis property is equivalent to gndo:titleOfNobility\\n\\t\\tbut gives a literal instead of a reference to a subject heading."@en ;
    rdfs:domain onto:DifferentiatedPerson ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso onto:titleOfNobility ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/a/P50059>,
        <http://rdaregistry.info/Elements/a/P50110>,
        foaf:title .

onto:variantNameForTheConferenceOrEvent a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Variant name for the conference or event"@en ;
    onto:marc21equivalent "411 $a $c $d $e $g $n" ;
    rdfs:domain onto:ConferenceOrEvent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:variantName,
        <http://rdaregistry.info/Elements/a/P50025> .

onto:variantNameForTheCorporateBody a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Variant name for the corporate body"@en ;
    onto:marc21equivalent "410 $a $b $g $n" ;
    rdfs:domain onto:CorporateBody ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:variantName,
        <http://rdaregistry.info/Elements/a/P50025>,
        foaf:name .

onto:variantNameForThePlaceOrGeographicName a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Variant name for the place or geographic name"@en ;
    onto:marc21equivalent "451 $a $g $z" ;
    rdfs:domain onto:PlaceOrGeographicName ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:variantName .

onto:variantNameForTheWork a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Variant name for the work"@en ;
    onto:marc21equivalent "430 $a $f $g $m $n $o $p $r $s" ;
    rdfs:domain onto:Work ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:variantName .

onto:broaderTermPartitive a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Broader term (partitive)"@en ;
    onto:marc21equivalent "530 $0 $4=obpa",
        "550 $0 $4=obpa",
        "551 $0 $4=obpa" ;
    rdfs:comment "The hierarchical whole-part relationship covers a limited range of\\n      situations in which a part of an entity or system belongs uniquely to a particular possessing\\n      whole. When applied to persons, this is the relation between a single person (particularly gods)\\n\\t  and hierarchically broader groups of gods and mythologic entities."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:subPropertyOf onto:broaderTermGeneral ;
    owl:inverseOf onto:narrowerTermPartitive .

onto:instrument a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Instrument"@en ;
    rdfs:comment "A musical instrument, a device to perform music with"@en ;
    rdfs:isDefinedBy onto: .

onto:occasion a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Occasion"@en ;
    rdfs:comment "Reason of the entity, e.g. a work or a historic event\\n\\t\\tis the reason of a conference, or a conference is the reason of a work."@en ;
    rdfs:isDefinedBy onto: .

onto:relatedPerson a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Related person"@en ;
    onto:marc21equivalent "500 $0 $4=rela" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:Family onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:DifferentiatedPerson ;
    rdfs:subPropertyOf <http://d-nb.info/standards/elementset/agrelon#relatedAgent>,
        <http://rdaregistry.info/Elements/a/P50220> .

onto:hierarchicalSuperior a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Hierarchical superior"@en ;
    rdfs:isDefinedBy onto: .

onto:member a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Member"@en ;
    rdfs:comment "A person or family being a member of (another) family"@en ;
    rdfs:isDefinedBy onto: .

onto:temporaryName a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Temporary name"@en ;
    rdfs:isDefinedBy onto: .

xsd:date a owl:Class .

xsd:gYear a owl:Class .

xsd:gYearMonth a owl:Class .

onto:artist a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Artist"@en ;
    onto:marc21equivalent "500 $0 $4=kuen",
        "510 $0 $4=kuen" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:PlaceOrGeographicName onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60431> .

onto:composer a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Composer"@en ;
    onto:marc21equivalent "500 $0 $4=koma",
        "510 $0 $4=koma" ;
    rdfs:comment "A person, family, or organization responsible for creating or contributing to a musical resource by adding music to a work that originally lacked it or supplements it"@en ;
    rdfs:domain onto:Work ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60426> .

onto:coordinates a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Coordinates"@en ;
    rdfs:isDefinedBy onto: .

onto:narrowerTermGeneral a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Narrower term (general)"@en ;
    rdfs:domain onto:SubjectHeading ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    owl:equivalentProperty skos:narrower ;
    owl:inverseOf onto:broaderTermGeneral .

onto:author a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Author"@en ;
    onto:marc21equivalent "500 $0 $4=auta",
        "510 $0 $4=auta" ;
    rdfs:comment "A person, family, or organization responsible for creating a work that is primarily textual in content, regardless of media type (e.g., printed text, spoken word, electronic text, tactile text) or genre (e.g., poems, novels, screenplays, blogs). Use also for persons, etc., creating a new work by paraphrasing, rewriting, or adapting works by another creator such that the modification has substantially changed the nature and content of the original or changed the medium of expression"@en ;
    rdfs:domain onto:Work ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( onto:CorporateBody onto:DifferentiatedPerson onto:Family ) ] ;
    rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60434> .

onto:predecessor a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Predecessor"@en ;
    rdfs:comment "A corporate body or a work being the predecessor of another corporate body or work"@en ;
    rdfs:isDefinedBy onto: .

onto:successor a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Successor"@en ;
    rdfs:isDefinedBy onto: .

onto:broaderTermGeneral a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Broader term (general)"@en ;
    onto:marc21equivalent "550 $0 $4=obal" ;
    rdfs:comment "Broader term"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:ConferenceOrEvent onto:CorporateBody onto:DifferentiatedPerson onto:PlaceOrGeographicName onto:SubjectHeading onto:Work ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SubjectHeading ;
    owl:equivalentProperty skos:broader ;
    owl:inverseOf onto:narrowerTermGeneral .

onto:preferredName a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Preferred name"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:label .

onto:variantName a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "Variant name"@en ;
    rdfs:isDefinedBy onto: .

xsd:dateTime a owl:Class .

onto:associatedDate a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Associated date"@en ;
    rdfs:isDefinedBy onto: .

onto:associatedPlace a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Associated place"@en ;
    rdfs:isDefinedBy onto: .

rdfs:Literal a owl:Class .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    ns1:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dc:title "GND Ontology"@en ;
    dcterms:available "2019-02-12"^^xsd:date ;
    dcterms:contributor onto:dnbStaff,
        onto:listMembers ;
    dcterms:creator onto:alexanderHaffner ;
    dcterms:issued "2012-06-30"^^xsd:date ;
    dcterms:modified "2018-11-05T13:20:00+01:00"^^xsd:dateTime ;
    dcterms:publisher <http://ld.zdb-services.de/resource/organisations/DE-101> ;
    dcterms:rights "Copyright 2012-2018 Deutsche Nationalbibliothek" ;
    vann:preferredNamespacePrefix "gndo" ;
    vann:preferredNamespaceUri "http://d-nb.info/standards/elementset/gnd#" ;
    rdfs:comment "\\n\\tChanges from 2018-10-16 to 2019-02-12\\n\\tRemoved the axiom that all main classes are disjoint\\n\\tRemoved all owl:PropertyChains that have a owl:DatatypeProperty as their last chain link\\n\\t- #affiliationAsLiteral\\n\\t- #functionOrRoleAsLiteral\\n\\t- #placeOfBirthAsLiteral\\n\\t- #placeOfDeathAsLiteral\\n\\t- #professionOrOccupationAsLiteral\\n\\t- #titleOfNobilityAsLiteral\\n\\t\\n\\tChanges from 2018-05-15\\n\\tMinor corrections at some labels\\n\\tAdded alignments to AgRelOn:\\n\\t\\tgndo:relatedPerson rdfs:subPropertyOf agrelon:relatedAgent\\n\\t\\tgndo:relatedFamily rdfs:subPropertyOf agrelon:relatedAgent\\n\\t\\tgndo:relatedCorporateBody rdfs:subPropertyOf agrelon:relatedAgent\\n\\t\\tgndo:memberOfTheFamily rdfs:subPropertyOf agrelon:isMemberOf\\n\\t\\tgndo:dateOfBirth rdfs:subPropertyOf agrelon:hasBeginDate\\n\\t\\tgndo:dateOfEstablishment rdfs:subPropertyOf agrelon:hasBeginDate\\n\\t\\tgndo:dateOfDeath rdfs:subPropertyOf agrelon:hasEndDate\\n\\t\\tgndo:dateOfTermination rdfs:subPropertyOf agrelon:hasEndDate\\n\\t\\n\\tChanges from 2018-01-16\\n    Minor corrections to\\n    http://d-nb.info/standards/elementset/gnd#topic\\n    http://d-nb.info/standards/elementset/gnd#fieldOfActivity\\n    http://d-nb.info/standards/elementset/gnd#narrowerTermGeneric \\n    \\n    Changes from 2017-09-12\\n\\t\\n\\tAdded new classes\\n\\t\\n\\thttp://d-nb.info/standards/elementset/gnd#Company\\n\\thttp://d-nb.info/standards/elementset/gnd#MusicalCorporateBody\\n\\thttp://d-nb.info/standards/elementset/gnd#ReligiousCorporateBody\\n\\thttp://d-nb.info/standards/elementset/gnd#ReligiousAdministrativeUnit\\n\\t\\n\\tChanges from 2017-01-17\\n\\t\\n\\tAdded new Annotation Properties:\\n\\t\\n\\thttp://d-nb.info/standards/elementset/gnd#abbreviatedNameForTheCorporateBody\\n\\thttp://d-nb.info/standards/elementset/gnd#abbreviatedNameForTheConferenceOrEvent\\n\\thttp://d-nb.info/standards/elementset/gnd#abbreviatedNameForThePlaceOrGeographicName\\n\\thttp://d-nb.info/standards/elementset/gnd#abbreviatedNameForTheWork\\n\\t\\n\\t\\n\\tChanges from 2016-01-12\\n\\t\\n\\tCreated new ObjectProperty #relatedSubjectHeading and deprecated ObjectProperty #relatedSubjecHeading\\n    All Properties named #preferredName* or #variantName are now instances of owl:AnnotationProperty instead of owl:DatatypeProperty\\n\\t\\n\\tChanges from 2015-10-01\\n\\tUpdated MARC 21-equivalent changing $9 to $g in following properties:\\n\\thttp://d-nb.info/standards/elementset/gnd#addition\\n\\thttp://d-nb.info/standards/elementset/gnd#nameAddition\\n\\thttp://d-nb.info/standards/elementset/gnd#preferredNameForTheConferenceOrEvent\\n\\thttp://d-nb.info/standards/elementset/gnd#preferredNameForTheCorporateBody\\n\\thttp://d-nb.info/standards/elementset/gnd#preferredNameForTheFamily\\n\\thttp://d-nb.info/standards/elementset/gnd#preferredNameForThePerson\\n\\thttp://d-nb.info/standards/elementset/gnd#preferredNameForThePlaceOrGeographicName\\n\\thttp://d-nb.info/standards/elementset/gnd#preferredNameForTheSubjectHeading\\n\\thttp://d-nb.info/standards/elementset/gnd#preferredNameForTheWork\\t\\n\\thttp://d-nb.info/standards/elementset/gnd#variantNameForTheConferenceOrEvent\\n\\thttp://d-nb.info/standards/elementset/gnd#variantNameForTheCorporateBody\\n\\thttp://d-nb.info/standards/elementset/gnd#variantNameForTheFamily\\n\\thttp://d-nb.info/standards/elementset/gnd#variantNameForThePerson\\n\\thttp://d-nb.info/standards/elementset/gnd#variantNameForThePlaceOrGeographicName\\n\\thttp://d-nb.info/standards/elementset/gnd#variantNameForTheSubjectHeading\\n\\thttp://d-nb.info/standards/elementset/gnd#variantNameForTheWork\\n\\thttp://d-nb.info/standards/elementset/gnd#affiliationAsLiteral\\n\\thttp://d-nb.info/standards/elementset/gnd#academicDegree\\n\\thttp://d-nb.info/standards/elementset/gnd#professionOrOccupationAsLiteral\\n\\thttp://d-nb.info/standards/elementset/gnd#titleOfNobilityAsLiteral\\n\\thttp://d-nb.info/standards/elementset/gnd#functionOrRoleAsLiteral\\n\\thttp://d-nb.info/standards/elementset/gnd#placeOfBirthAsLiteral\\n\\thttp://d-nb.info/standards/elementset/gnd#placeOfDeathAsLiteral\\n\\n\\n\\n\\tChanges from 2015-05-19\\n\\tCorrection of English comment and MARC 21 equivalent in gndo:titleOfNobilityAsLiteral\\n\\n\\tChanges from 2015-01-13\\n\\thttp://d-nb.info/standards/elementset/gnd#periodOfActivity is now a owl:DatatypeProperty\\n\\tgndo:homepage is now an owl:ObjectProperty (adaption to actual usage)\\n\\tremoved owl:ontologyIRI (nonexistent property...)\\n\\tCorrected relation between http://d-nb.info/standards/elementset/gnd#periodOfActivity and http://www.w3.org/2000/01/rdf-schema#label from owl:subClassOf to owl:subPropertyOf\\n\\tCorrected typo in gndo:surname\\n\\tDeprecated class gndo:MeansOfTransportWithIndividual_name (change due to naming convention)\\n\\tIntroduced class gndo:MeansOfTransportWithIndividualName\\n\\tIntroduced new datatype property gndo:functionOrRoleAsLiteral\\n\\tIntroduced new object property gndo:narrowerTermGeneral\\n\\tIntroduced new object property gndo:narrowerTermGeneric\\n\\tIntroduced new object property gndo:narrowerTermInstantial\\n\\tIntroduced new object property gndo:narrowerTermPartitive\\n\\n\\tChanges from 2014-09-16\\n\\tDeprecated http://d-nb.info/standards/elementset/gnd#Fictive_term\\n\\tIntroduced http://d-nb.info/standards/elementset/gnd#FictiveTerm in order to keep naming consistent\\n\\tChanged rdfs:type to rdf:type in http://d-nb.info/standards/elementset/gnd#correspondent\\n\\thttp://d-nb.info/standards/elementset/gnd#preferredNameEntityForThePerson and http://d-nb.info/standards/elementset/gnd#variantNameEntityForThePerson are now owl:ObjectProperties\\n\\thttp://d-nb.info/standards/elementset/gnd#titleOfNobility is now an owl:ObjectProperty\\n\\tIntroduced new owl:DatatypeProperty http://d-nb.info/standards/elementset/gnd#titleOfNobilityAsLiteral\\n\\thttp://d-nb.info/standards/elementset/gnd#preferredName is now an owl:subPropertyOf rdfs:label\\n\\t\\n\\t\\n\\tChanges from 2014-05-15:\\n\\tUpdated RDA-Mappings to reflect new RDA namespaces\\n\\t\\n\\tChanges from 2014-01-15:\\n\\tCorrected MARC 21 equivalent and rdfs:range in http://d-nb.info/standards/elementset/gnd#academicDegree\\n\\tUpdated labels to distinguish datatype properties from similar object properties: http://d-nb.info/standards/elementset/gnd#affiliationAsLiteral, http://d-nb.info/standards/elementset/gnd#placeOfBirthAsLiteral, http://d-nb.info/standards/elementset/gnd#placeOfDeathAsLiteral, http://d-nb.info/standards/elementset/gnd#professionOrOccupationAsLiteral\\n\\tMarked http://d-nb.info/standards/elementset/gnd#correspondent as owl:symmetricProperty \\n\\tDeprecated http://d-nb.info/standards/elementset/gnd#broderTermGeneral (misspelled term name in URI)\\n\\tIntroduced http://d-nb.info/standards/elementset/gnd#broaderTermGeneral (correctly spelled name in URI)\\n\\tCorrected alignment to skos:broader: added to http://d-nb.info/standards/elementset/gnd#broaderTermGeneral, removed from http://d-nb.info/standards/elementset/gnd#broderTermGeneric (skos:broader)\\n\\n\\tChanges from 2012-06-30\\n\\tAdded rdfs:isDefinedBy everywhere\\n\\tAdded alignments:\\n\\t\\thttp://d-nb.info/standards/elementset/gnd#variantNameForTheSubjectHeading (skos:altLabel)\\n\\t\\thttp://d-nb.info/standards/elementset/gnd#preferredNameForTheSubjectHeading (skos:prefLabel)\\n\\t\\thttp://d-nb.info/standards/elementset/gnd#SubjectHeading (skos:Concept)\\n\\t\\thttp://d-nb.info/standards/elementset/gnd#broaderTermGeneric (skos:broader)\\n\\tHierarchy of broader/narrower term changed\\n\\t\\tgndo:broaderTerm is deprecated\\n\\t\\tgndo:broaderTermGeneral is now top level hierarche of broader/narrower\\n\\t\\tFollowing Properties are now subproperties of gndo:broaderTermGeneral:\\n\\t\\t\\tgndo:broaderTermGeneric\\n\\t\\t\\tgndo:broaderTermInstantial\\n\\t\\t\\tgndo:broaderTermPartitive\\n\\t\\t\\tgndo:broaderTermWithMoreThanOneElement\\n\\tFixed incorrect supertype for gndo:definition. gndo:definition is now a subproperty\\n\\tof dct:definition, not of foaf:depiction\\n\\tDeprecated gndo:StartingOrFinalPointOfADistance (with a capital S)\\n\\tIntroduced gndo:startingOrFinalPointOfADistance (with a minor s)\\n\\n\\tSpecified that gndo:relatedTerm is also a owl:SymmetricProperty\\n\\tDeprecated the property #addition\\n\\tDeprecated the property #epithetGenericNameTitleOrTerritory\\n\\tAdded new Datatype property #nameAddition\\n\\t\\n\\tIntroduced new class hierarchy for NameOfThePerson\\n\\tgndo:NameOfThePerson (existing class)\\n\\t\\tgndo:PreferredNameOfThePerson (new class)\\n\\t\\tgndo:VariantNameOfThePerson (new class)\\n\\t\\t\\tgndo:EarlierNameOfThePerson (new class)\\n\\t\\t\\tgndo:LaterNameOfThePerson (new class)\\n\\t\\t\\tgndo:FullerFormOfNameOfThePerson (new class)\\n\\t\\t\\tgndo:RealNameOfThePerson (new class)\\n\\t\\t\\tgndo:PseudonymNameOfTheperson (new class)\\n\\n"@en ;
    owl:priorVersion <http://d-nb.info/standards/elementset/gnd_20181016> ;
    owl:versionIRI <http://d-nb.info/standards/elementset/gnd_20190212> ;
    owl:versionInfo "1.12" .

