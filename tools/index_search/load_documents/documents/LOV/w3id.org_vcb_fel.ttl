@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix onto: <http://w3id.org/vcb/fel#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:AdjectivePoS a onto:PartOfSpeechClass,
        owl:Class ;
    rdfs:label "Adjective"@en ;
    dcterms:description "This class gathers all the adjective mentions. For instance, the mention 'red' in the phrase 'red car' can be linked to wiki:Red; other examples include 'French', 'Democratic', 'his', etc." ;
    rdfs:isDefinedBy onto: ;
    skos:closeMatch <http://www.lexinfo.net/ontology/2.0/lexinfo#AdjectivePOS> .

onto:AdverbPoS a onto:PartOfSpeechClass,
        owl:Class ;
    rdfs:label "Adverb"@en ;
    dcterms:description "This class gathers all the Adverb mentions. For instance, 'comercially' could be associated to wiki:Commerce" ;
    rdfs:isDefinedBy onto: ;
    skos:closeMatch <http://www.lexinfo.net/ontology/2.0/lexinfo#AdverbPOS> .

onto:AliasProperForm a onto:BaseFormClass,
        owl:Class ;
    rdfs:label "Alias Proper Form"@en ;
    dcterms:description "This class is concerned with all the proper-noun mentions with a different morpheme than the primary label of the knowledge base entity to which if refers (though it may be a known alias). For instance, the mention 'King of Pop' targeting wiki:Michael_Jackson is considered an AliasProperForm."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ProperForm .

onto:AnaphoricReference a onto:ReferenceClass,
        owl:Class ;
    rdfs:label "Anaphoric Reference"@en ;
    dcterms:description "This class gathers mentions that are pro-forms referring to an antecedent or postcedent in the text. For instance, in the sentence 'His son was widfely regarded ...' the mention 'His' may be an anaphoric reference to wiki:Joe_Jackson_(manager). (Note that noun phrases such as 'His son' referring to wiki:Michael_Jackson' should rather be marked as descriptive references.)"@en ;
    rdfs:isDefinedBy onto: .

onto:CommonForm a onto:BaseFormClass,
        owl:Class ;
    rdfs:label "Common Form"@en ;
    dcterms:description "This class gathers all the mentions with a corresponding entity in the knowledgebase, but that does not correspond to a Proper Form, Pro-Form or Numeric/Temporal Form. For instance, the mention 'bfelt' referring to wiki:Bfelt_(clothing) is considered CommonForm."@en ;
    rdfs:isDefinedBy onto: .

onto:DescriptiveReference a onto:ReferenceClass,
        owl:Class ;
    rdfs:label "Desciptive Reference"@en ;
    dcterms:description "This class gathers mentions based on describing the entities they refer to. For instance, the mention 'the capital of Peru' refers descriptively to wiki:Lima, or in the sentence 'Michael Jackson and his father', the mention 'his father' refers to wiki:Joe_Jackson_(manager). Note that simple proforms ('he', 'her', etc.) should rather be marked as anaphoric reference."@en ;
    rdfs:isDefinedBy onto: .

onto:DirectReference a onto:ReferenceClass,
        owl:Class ;
    rdfs:label "Direct Reference"@en ;
    dcterms:description "This class gathers mentions with references based on the direct, literal meaning of the words and names. For instance, the reference 'Michael Jackson' referring to wiki:Michael_Jackson, or the reference 'talent manager' referring to wiki:Talent_manager, are considered direct references"@en ;
    rdfs:isDefinedBy onto: .

onto:ExtendedProperForm a onto:BaseFormClass,
        owl:Class ;
    rdfs:label "Extended Proper Form"@en ;
    dcterms:description "This class gathers all proper-name mentions longer than the label of the knowledgebase entity but containing the label. For example, the mention 'Michael Joseph Jackson' targeting wiki:Michael_Jackson is considered an ExtendedProperForm."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ProperForm .

onto:FullProperForm a onto:BaseFormClass,
        owl:Class ;
    rdfs:label "Full Proper Form"@en ;
    dcterms:description "This class gathers all proper-form mentions that (almost) exactly match with the label of the knowledgebase entity. For example, the mention 'Michael Jackson' targeting wiki:Michael_Jackson is considered Full. This class also includes mentions that are syntactically close to the knowlegebase entity (specifically, the lemmas should be the same and in the same order), for instance 'German' pointing to wiki:Germany is also considered a FullProperForm."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ProperForm .

onto:IntermediateOverlap a onto:OverlapClass,
        owl:Class ;
    rdfs:label "Intermediate Overlap"@en ;
    dcterms:description "This class describes all the mentions that overlap with others and that, more specifically, both contain and are contained in other mentions. For instance, in the mention 'New York Police Department Museum', the mention 'New York Police Department' has intermediate overlap because it is contained in the overall mention and contains the mention 'New York'." ;
    rdfs:isDefinedBy onto: .

onto:MaximalOverlap a onto:OverlapClass,
        owl:Class ;
    rdfs:label "Maximal Overlap"@en ;
    dcterms:description "This class describes all the mentions that overlap with others and that, more specifically, contain other mentions entirfely inside them but are not contained in other mentions. For instance, 'Living with Michael Jackson' is considered as maximal overlap assuming 'Michael Jackson' is also annotated and it is not contained inside another mention." ;
    rdfs:isDefinedBy onto: .

onto:MetaphoricReference a onto:ReferenceClass,
        owl:Class ;
    rdfs:label "Metaphoric Reference"@en ;
    dcterms:description "This class gathers mentions that make reference based on a figurative rather than literal meaning of the words. For example, in the phrase 'the King of Pop', the mention 'King' can be considered a metaphoric reference to wiki:King; in the sentence 'they added spice to their rfelationship', the mention 'spice' (wiki:Spice) is again a metaphoric reference."@en ;
    rdfs:isDefinedBy onto: .

onto:MetonymicReference a onto:ReferenceClass,
        owl:Class ;
    rdfs:label "Metonymic Reference"@en ;
    dcterms:description "This class gathers mentions that refer to something specific by reference to a broader related entity (often, but not always, countries). For example, in the phrase 'Russia announced today', the mention 'Russia' is a metonymic reference to wiki:Government_of_Russia; in the phrase 'Poland won 3-2 on penalties', 'Poland' may be a metonymic reference to wiki:Poland_national_football_team, etc."@en ;
    rdfs:isDefinedBy onto: .

onto:MinimalOverlap a onto:OverlapClass,
        owl:Class ;
    rdfs:label "Minimal Overlap"@en ;
    dcterms:description "This class describes all the mentions that overlap with others and that, more specifically, are contained in but do not contain other mentions. For instance, in the annotation 'Living with Michael Jackson', the mention 'Michael Jackson' is considered to have minimal overlap." ;
    rdfs:isDefinedBy onto: .

onto:NoOverlap a onto:OverlapClass,
        owl:Class ;
    rdfs:label "No Overlap"@en ;
    dcterms:description "This class gathers all the mentions without overlap." ;
    rdfs:isDefinedBy onto: .

onto:NounPhrasePoS a onto:PartOfSpeechClass,
        owl:Class ;
    rdfs:label "Noun Phrase PoS"@en ;
    dcterms:description "This class gathers all the noun-phrase mentions. It is further divided into singular and plural noun-phrase mentions." ;
    rdfs:isDefinedBy onto: ;
    skos:narrower <http://purl.org/linguistics/goldNoun>,
        <http://www.lexinfo.net/ontology/2.0/lexinfo#NounPOS> .

onto:NumericTemporalForm a onto:BaseFormClass,
        owl:Class ;
    rdfs:label "Numeric and Temporal Form"@en ;
    dcterms:description "This class gathers all mentions based on numeric and temporal expressions, such as: '1', 'one', '12/23/2019', etc. (as were included in MUC-6)."@en ;
    rdfs:isDefinedBy onto: ;
    skos:narrower <http://purl.org/linguistics/goldQuantifier>,
        <http://www.lexinfo.net/ontology/2.0/lexinfo#NumeralPOS> .

onto:PluralNounPhrasePoS a onto:PartOfSpeechClass,
        owl:Class ;
    rdfs:label "Plural Noun Phrase PoS"@en ;
    dcterms:description "This class gathers all the plural noun-phrase mentions. For instance, 'political parties' may refer to wiki:Political_party."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:NounPhrase .

onto:ProForm a onto:BaseFormClass,
        owl:Class ;
    rdfs:label "Pro-Form"@en ;
    dcterms:description "This class gathers all mentions based on pronouns, pro-adjective, etc. For example, the mentions 'he', 'theirs', etc., are considered ProForm (assuming they link to a knowledgebase entity)."@en ;
    rdfs:isDefinedBy onto: .

onto:RelatedReference a onto:ReferenceClass,
        owl:Class ;
    rdfs:label "Related Reference"@en ;
    dcterms:description "This class gathers mentions that refer to something for which there is (only) something closely related in the knowledgebase. For instance, in the phrase 'The Russian daily RBK', the mention 'daily' refers to a daily newpaper, but in Wikipedia we only have wiki:Newspaper, so 'daily' can be seen as a reference to the closely related wiki:Newspaper. (Such references are sometimes reflected, for example, with redirects in Wikipedia, or pointers to a subsection of an entity's article.)"@en ;
    rdfs:isDefinedBy onto: .

onto:ShortProperForm a onto:BaseFormClass,
        owl:Class ;
    rdfs:label "Short Proper Form"@en ;
    dcterms:description "This class is concerned with all the proper-name mentions that are shorter than the label of the knowledgebase entity while still being based on the label. For instance, the mentions 'Jackson' or 'M. Jackson' targeting wiki:Michael_Jackson are considered ShortProperForm."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ProperForm .

onto:SingularNounPhrasePoS a onto:PartOfSpeechClass,
        owl:Class ;
    rdfs:label "Singular Noun Phrase PoS"@en ;
    dcterms:description "This class gathers all the singular noun-phrase mentions, including 'documentary', 'Germany', etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:NounPhrase .

onto:VerbPoS a onto:PartOfSpeechClass,
        owl:Class ;
    rdfs:label "Verb PoS"@en ;
    dcterms:description "This class gathers all the verb mentions. For instance the verb mention 'assassinated' may link to wiki:Assassination."@en ;
    rdfs:isDefinedBy onto: ;
    skos:closeMatch <http://www.lexinfo.net/ontology/2.0/lexinfo#VerbPOS> .

onto:entityType a owl:ObjectProperty ;
    rdfs:label "Entity Type"@en ;
    dcterms:description "Specifies the entity type of a mention. The domain of the property are mentions, and the range is classes (from the KB), e.g., Organization, Place, Person, etc."@en ;
    rdfs:range owl:Class .

onto:OverlapClass a owl:Class ;
    rdfs:label "Overlap Class"@en ;
    dcterms:description "This meta-class gathers classes that divide annotations based on whether or not their mention overlaps with others. For example, in the sentence 'Living with Michael Jackson is a tfelevision documentary' the mention 'documentary' does not overlap with another mention; for this reason it is considered non-overlapping. On the other hand, the mentions 'Living with Michael Jackson' and 'Michael Jackson' have overlap."@en ;
    rdfs:isDefinedBy onto: .

onto:ProperForm a onto:BaseFormClass,
        owl:Class ;
    rdfs:label "Proper Form"@en ;
    dcterms:description "This class gathers all mentions based on names (proper nouns), e.g., 'Michael Jackson', 'USA', 'King of the Pop', 'B. Obama', etc. Such mentions do not have to be nouns if they are based on proper nouns, as in the case of 'French, 'Orwellian', etc. Such mentions may use abbreviated or extended forms of names; we add a new level in the class hierarchy to separate them: Full, Extended, Short or Alias."@en ;
    rdfs:isDefinedBy onto: ;
    skos:closeMatch <http://www.lexinfo.net/ontology/2.0/lexinfo#ProperNoun> .

onto:PartOfSpeechClass a owl:Class ;
    rdfs:label "Part Of Speech Class"@en ;
    dcterms:description "This meta-class gathers classes that divide annotations according to the part-of-speech of their mention."@en ;
    rdfs:isDefinedBy onto: .

onto:ReferenceClass a owl:Class ;
    rdfs:label "Reference Class"@en ;
    dcterms:description "This meta-class gathers classes that divide annotations based on how the mention references its entity. Examples of types of reference include Anaphoric, Direct, Descriptive, Metaphoric, Metonymic and Related."@en ;
    rdfs:isDefinedBy onto: .

onto:BaseFormClass a owl:Class ;
    rdfs:label "Base Form Class"@en ;
    dcterms:description "This meta-class gathers classes that divide annotations by the base-form of their mention, recognizing not only proper nouns as entities, but also other more flexible definitions, such as those that allow pronouns, numbers, temporal expressions, etc. Current instances of this meta-class include: ProperForm, NumericTemporalForm, CommonForm, and ProForm."@en ;
    rdfs:isDefinedBy onto: .

onto: a void:Dataset,
        owl:Ontology ;
    rdfs:label "A Fine-grained Entity Linking vocabulary"@en ;
    dcterms:creator <http://aidanhogan.com/foaf.rdf#me>,
        <http://users.dcc.uchile.cl/~hrosales/foaf.ttl#me>,
        <http://w3id.org/scholarlydata/person/barbara-poblete> ;
    dcterms:description "This RDF vocabulary can be use to describe and categorize annotations involving entity mentions (sub-strings of text) that link to knowledgebase identifiers"@en ;
    dcterms:issued "2019-03-01"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0> ;
    dcterms:publisher <http://www.wikidata.org/entity/Q232141> ;
    dcterms:rights "This ontology is licensed under CC-BY 4 (http://creativecommons.org/licenses/by/4.0/)"@en ;
    dcterms:title "A Fine-grained Entity Linking vocabulary"@en ;
    vann:changes <http://github.com/henryrosalesmendez/fel> ;
    vann:preferredNamespacePrefix "fel" ;
    vann:preferredNamespaceUri "http://w3id.org/vcb/fel#" ;
    doap:maintainer <http://users.dcc.uchile.cl/~hrosales/foaf.ttl#me> ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso <http://users.dcc.uchile.cl/~hrosales/vocabulary_fel> ;
    owl:versionInfo "0.0.1" .

