@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://vocab.data.gov/gd> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://reference.data.gov/def/govdata/Country> a rdfs:Class,
        owl:Class ;
    rdfs:label "Country" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf rdfs:Resource .

<http://reference.data.gov/def/govdata/County> a rdfs:Class,
        owl:Class ;
    rdfs:label "County" ;
    rdfs:isDefinedBy onto: .

<http://reference.data.gov/def/govdata/Record> a rdfs:Class,
        owl:Class ;
    rdfs:label "Record" ;
    rdfs:isDefinedBy onto: .

<http://reference.data.gov/def/govdata/RecordSet> a rdfs:Class,
        owl:Class ;
    rdfs:label "RecordSet" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf rdfs:Resource .

<http://reference.data.gov/def/govdata/Report> a rdfs:Class,
        owl:Class ;
    rdfs:label "Report" ;
    rdfs:isDefinedBy onto: .

<http://reference.data.gov/def/govdata/Site> a rdfs:Class,
        owl:Class ;
    rdfs:label "Site" ;
    rdfs:isDefinedBy onto: .

<http://reference.data.gov/def/govdata/State> a rdfs:Class,
        owl:Class ;
    rdfs:label "State" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf rdfs:Resource .

<http://reference.data.gov/def/govdata/Survey> a rdfs:Class,
        owl:Class ;
    rdfs:label "Survey" ;
    rdfs:isDefinedBy onto: .

<http://reference.data.gov/def/govdata/count> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "count" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer .

<http://reference.data.gov/def/govdata/country> a rdf:Property ;
    rdfs:label "country" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://reference.data.gov/def/govdata/Country> .

<http://reference.data.gov/def/govdata/countyCode> a rdf:Property ;
    rdfs:label "countyCode" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://reference.data.gov/def/govdata/County> .

<http://reference.data.gov/def/govdata/denominator> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "denominator" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float .

<http://reference.data.gov/def/govdata/median> a rdf:Property ;
    rdfs:label "median" ;
    rdfs:isDefinedBy onto: .

<http://reference.data.gov/def/govdata/percentage> a rdf:Property ;
    rdfs:label "percentage" ;
    rdfs:isDefinedBy onto: .

<http://reference.data.gov/def/govdata/record> a rdf:Property ;
    rdfs:label "record" ;
    rdfs:domain <http://reference.data.gov/def/govdata/RecordSet> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://reference.data.gov/def/govdata/Record> .

<http://reference.data.gov/def/govdata/recordset> a rdf:Property ;
    rdfs:label "recordset" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://reference.data.gov/def/govdata/RecordSet> .

<http://reference.data.gov/def/govdata/stateCode> a rdf:Property ;
    rdfs:label "stateCode" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://reference.data.gov/def/govdata/State> .

<http://vocab.data.gov/gd#HHS> a foaf:Organization ;
    foaf:homepage <http://www.hhs.gov/> ;
    foaf:member <http://vocab.data.gov/gd#George.Thomas> ;
    foaf:name "HHS" .

<http://vocab.data.gov/gd#George.Thomas> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "George Thomas" .

onto: a owl:Ontology ;
    dc:creator <http://vocab.data.gov/gd#George.Thomas> ;
    dc:description "A RDF Schema that defines concepts and relationships common to all Open Government Data." ;
    dc:modified "2014-11-22"^^xsd:date ;
    dc:title "Government Data Vocabulary" ;
    vann:preferredNamespacePrefix "gd" ;
    vann:preferredNamespaceUri "http://reference.data.gov/def/govdata/" ;
    foaf:page onto:.html .

