@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://metadataregistry.org/uri/profile/RegAp/> .
@prefix onto: <http://metadataregistry.org/uri/schema/RDARelationshipsGR2> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/explanationOfRelationship> a rdf:Property ;
    rdfs:label "Explanation of Relationship"@en ;
    ns1:name "explanationOfRelationship"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Agent> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "Information elaborating on or clarifying the relationship between an entity represented by a preferred access point and/or identifier and a related entity."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/hierarchicalSubordinate> a rdf:Property ;
    rdfs:label "Hierarchical subordinate"@en ;
    ns1:name "hierarchicalSubordinate"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A corporate body that is subordinate to the other corporate body (e.g., a parent body)."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/descendantFamily> a rdf:Property ;
    rdfs:label "Descendant Family"@en ;
    ns1:name "descendantFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Family> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamily> ;
    skos:definition "A family descended from the other family."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/descendants> a rdf:Property ;
    rdfs:label "Descendants"@en ;
    ns1:name "descendants"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Family> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPerson> ;
    skos:definition "A family descended from the particular person."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/employee> a rdf:Property ;
    rdfs:label "Employee"@en ;
    ns1:name "employee"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyPerson> ;
    skos:definition "A person employed by a corporate body."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/employer> a rdf:Property ;
    rdfs:label "Employer"@en ;
    ns1:name "employer"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPersonCorporateBody> ;
    skos:definition "A corporate body that employs the person."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/foundedOrganization> a rdf:Property ;
    rdfs:label "Founded organization"@en ;
    ns1:name "foundedOrganization"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamilyCorporateBody> ;
    skos:definition "A corporate body that the family founded."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/founder> a rdf:Property ;
    rdfs:label "Founder"@en ;
    ns1:name "founder"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyPerson> ;
    skos:definition "A person who founded the corporate body."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/foundingFamily> a rdf:Property ;
    rdfs:label "Founding Family"@en ;
    ns1:name "foundingFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Family> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBody> ;
    skos:definition "A family that founded the corporate body."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/groupMember> a rdf:Property ;
    rdfs:label "Group member"@en ;
    ns1:name "groupMember"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyPerson> ;
    skos:definition "A person who is a member of the performing group, expedition, etc."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/hierarchicalSuperior> a rdf:Property ;
    rdfs:label "Hierarchical superior"@en ;
    ns1:name "hierarchicalSuperior"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyCorporateBody> ;
    skos:definition "A corporate body that is hierarchically superior to the other corporate body."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/incumbent> a rdf:Property ;
    rdfs:label "Incumbent"@en ;
    ns1:name "incumbent"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyPerson> ;
    skos:definition "A person holding an office in the corporate body (e.g., the incumbent president)."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/mergee> a rdf:Property ;
    rdfs:label "Mergee"@en ;
    ns1:name "mergee"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyCorporateBody> ;
    skos:definition "A corporate body that merged with the other corporate body to form a third."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/predecessor> a rdf:Property ;
    rdfs:label "Predecessor"@en ;
    ns1:name "predecessor"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyCorporateBody> ;
    skos:definition "A corporate body that precedes the other corporate body."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/productOfAMerger> a rdf:Property ;
    rdfs:label "Product of a merger"@en ;
    ns1:name "productOfAMerger"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyCorporateBody> ;
    skos:definition "A corporate body that resulted from a merger of two or more other corporate bodies."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/productOfASplit> a rdf:Property ;
    rdfs:label "Product of a split"@en ;
    ns1:name "productOfASplit"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyCorporateBody> ;
    skos:definition "A corporate body that resulted from a split or division of the other corporate body."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/progenitor> a rdf:Property ;
    rdfs:label "Progenitor"@en ;
    ns1:name "progenitor"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/familyMember> ;
    skos:definition "A person from whom the family is descended."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyFamily> a rdf:Property ;
    rdfs:label "Related Corporate Body (Family)"@en ;
    ns1:name "relatedCorporateBodyFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Family> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBody> ;
    skos:definition "A corporate body that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a musical group to which a person belongs, a subsidiary company). Related corporate bodies include corporate bodies that precede or succeed the body represented by an authorized access point and/or identifier as the result of a change of name."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamilyFamily> a rdf:Property ;
    rdfs:label "Related Family (Family)"@en ;
    ns1:name "relatedFamilyFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Family> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamily> ;
    skos:definition "A family that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a person’s family, a family that owns the controlling interest in a corporate body)."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamilyPerson> a rdf:Property ;
    rdfs:label "Related Family (Person)"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/familyMember> ;
    ns1:name "relatedFamilyPerson"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A family that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a person’s family, a family that owns the controlling interest in a corporate body)."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPersonCorporateBody> a rdf:Property ;
    rdfs:label "Related Person (Corporate Body)"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/employer> ;
    ns1:name "relatedPersonCorporateBody"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A person who is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a collaborator, a member of a family, a founder of a corporate body). Related persons include separate identities established by an individual."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPersonFamily> a rdf:Property ;
    rdfs:label "Related Person (Family)"@en ;
    ns1:name "relatedPersonFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Family> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPerson> ;
    skos:definition "A person who is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a collaborator, a member of a family, a founder of a corporate body). Related persons include separate identities established by an individual."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/sponsor> a rdf:Property ;
    rdfs:label "Sponsor"@en ;
    ns1:name "sponsor"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyPerson> ;
    skos:definition "A person sponsoring the corporate body."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/sponsoredOrganization> a rdf:Property ;
    rdfs:label "Sponsored organization"@en ;
    ns1:name "sponsoredOrganization"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamilyCorporateBody> ;
    skos:definition "A corporate body that the family sponsors."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/sponsoringFamily> a rdf:Property ;
    rdfs:label "Sponsoring Family"@en ;
    ns1:name "sponsoringFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Family> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBody> ;
    skos:definition "A family that sponsors the corporate body."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/successor> a rdf:Property ;
    rdfs:label "Successor"@en ;
    ns1:name "successor"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyCorporateBody> ;
    skos:definition "A corporate body that succeeds or follows the other corporate body."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/alternateIdentity> a rdf:Property ;
    rdfs:label "Alternate identity"@en ;
    ns1:name "alternateIdentity"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPersonPerson> ;
    skos:definition "A pseudonymous or other identity assumed by the person."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/familyMember> a rdf:Property ;
    rdfs:label "Family member"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/progenitor> ;
    ns1:name "familyMember"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamilyPerson> ;
    skos:definition "A person who is a member of the family."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/realIdentity> a rdf:Property ;
    rdfs:label "Real identity"@en ;
    ns1:name "realIdentity"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPersonPerson> ;
    skos:definition "A real person who assumes the alternate identity."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamily> a rdf:Property ;
    rdfs:label "Related Family"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/descendantFamily>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamilyFamily> ;
    ns1:name "relatedFamily"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A family that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a person’s family, a family that owns the controlling interest in a corporate body)."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedFamilyCorporateBody> a rdf:Property ;
    rdfs:label "Related Family (Corporate Body)"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/foundedOrganization>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/sponsoredOrganization> ;
    ns1:name "relatedFamilyCorporateBody"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A family that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a person’s family, a family that owns the controlling interest in a corporate body)."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPerson> a rdf:Property ;
    rdfs:label "Related Person"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/descendants>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPersonFamily> ;
    ns1:name "relatedPerson"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A person who is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a collaborator, a member of a family, a founder of a corporate body). Related persons include separate identities established by an individual."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedPersonPerson> a rdf:Property ;
    rdfs:label "Related Person (Person)"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/alternateIdentity>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/realIdentity> ;
    ns1:name "relatedPersonPerson"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A person who is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a collaborator, a member of a family, a founder of a corporate body). Related persons include separate identities established by an individual."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBody> a rdf:Property ;
    rdfs:label "Related Corporate Body"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/foundingFamily>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyFamily>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/sponsoringFamily> ;
    ns1:name "relatedCorporateBody"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A corporate body that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a musical group to which a person belongs, a subsidiary company). Related corporate bodies include corporate bodies that precede or succeed the body represented by an authorized access point and/or identifier as the result of a change of name."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyPerson> a rdf:Property ;
    rdfs:label "Related Corporate Body (Person)"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/alternateIdentity>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/employee>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/founder>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/groupMember>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/incumbent>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/realIdentity>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/sponsor> ;
    ns1:name "relatedCorporateBodyPerson"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A corporate body that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a musical group to which a person belongs, a subsidiary company). Related corporate bodies include corporate bodies that precede or succeed the body represented by an authorized access point and/or identifier as the result of a change of name."@en .

<http://metadataregistry.org/uri/schema/RDARelationshipsGR2/relatedCorporateBodyCorporateBody> a rdf:Property ;
    rdfs:label "Related Corporate Body (Corporate Body)"@en ;
    ns1:hasSubproperty <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/hierarchicalSuperior>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/mergee>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/predecessor>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/productOfAMerger>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/productOfASplit>,
        <http://metadataregistry.org/uri/schema/RDARelationshipsGR2/successor> ;
    ns1:name "relatedCorporateBodyCorporateBody"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A corporate body that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a\\nmusical group to which a person belongs, a subsidiary company). Related corporate bodies include corporate bodies that precede or succeed the body represented by an\\nauthorized access point and/or identifier as the result of a change of name."@en .

<http://metadataregistry.org/uri/RegStatus/1002> a skos:Concept ;
    skos:prefLabel "New-Proposed"@en .

