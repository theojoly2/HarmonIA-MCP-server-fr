    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "OG/OGT" .

<https://w3id.org/arco/ontology/denotative-description/hasDedicatee> a owl:ObjectProperty ;
    rdfs:label "has dedicatee"@en ;
    rdfs:comment "This property connects a dedication to its dedicaatee, which is the person or institution to whom the dedication is addressed."@en ;
