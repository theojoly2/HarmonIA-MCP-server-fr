<https://w3id.org/arco/ontology/denotative-description/classifiesCharacteristic> a owl:ObjectProperty ;
    rdfs:label "classifies technical characteristic"@en ;
    ns1:isNativeTo <https://w3id.org/arco/pattern/technical-characteristic/> ;
    rdfs:comment "This property connects a techical concept to an entity's technical characteristic. It is the inverse property of isCharacteristicClassifiedBy."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/TechnicalConcept> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isConceptOf> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isCharacteristicClassifiedBy> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/hasAccessory> a owl:ObjectProperty ;
    rdfs:label "has accessory"@en ;
    rdfs:comment "This property relates a musical good to one of its accessories. In other words, it is an object linkable to a musical object, whether it is functional to the sound production, or if it is the sound's production or conservation medium."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/Accessory> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isAccessoryOf> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa SM 4.00: AS/ASS/ASST" .

<https://w3id.org/arco/ontology/denotative-description/hasAffixedElement> a owl:ObjectProperty ;
    rdfs:label "has element affixed to cultural property"@en ;
    rdfs:comment "This property relates a cultural property to an element affixed on it (e.g. inscription, stamp, etc.)"@en ;
