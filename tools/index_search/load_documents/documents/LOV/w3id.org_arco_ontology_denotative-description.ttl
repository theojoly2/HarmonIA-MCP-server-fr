    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isDesignationInTimeOf> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/OGD" .

<https://w3id.org/arco/ontology/denotative-description/hasDiapason> a owl:ObjectProperty ;
    rdfs:label "has diapason"@en ;
    rdfs:comment "This property relates a musical instrument to the identified diapason (note, temperature and eventually humidity during the detection)."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
