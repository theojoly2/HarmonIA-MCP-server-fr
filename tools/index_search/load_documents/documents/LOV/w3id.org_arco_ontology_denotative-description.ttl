    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/positionInComplexCulturalProperty> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "position in complex cultural property"@en ;
    rdfs:comment "This property represents a cultural entity's position with respect to a complex entity to which it belongs."@en ;
