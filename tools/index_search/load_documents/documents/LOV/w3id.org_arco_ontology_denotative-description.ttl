@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://ontologydesignpatterns.org/opla/> .
@prefix ns2: <https://w3id.org/arco/ontology/catalogue/> .
@prefix ns3: <http://www.ontologydesignpatterns.org/opla/> .
@prefix onto: <https://w3id.org/arco/ontology/denotative-description> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:isNativeTo a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

ns3:reusesPatternAsTemplate a owl:AnnotationProperty .

ns2:iccdNormTag a owl:AnnotationProperty .

<https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> a owl:Class .

<https://w3id.org/arco/ontology/context-description/PhotographicSeries> a owl:Class .

<https://w3id.org/arco/ontology/denotative-description/Accessible> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAccessibility> ;
    rdfs:label "Accessible"@en .

<https://w3id.org/arco/ontology/denotative-description/Area> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/denotative-description/MeasurementType> ;
    rdfs:label "Area"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/AssignedDesignation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/denotative-description/DesignationType> ;
    rdfs:label "Assigned designation"@en ;
    rdfs:comment "This individual represents an attributed denomination."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/Available> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAvailability> ;
    rdfs:label "Available"@en .

<https://w3id.org/arco/ontology/denotative-description/AvailableNotes> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/denotative-description/TechnicalConcept> ;
    rdfs:label "Available notes"@en ;
    rdfs:comment "This individual represents playable notes by a musical instrument, from low to high."@en ;
    owl:versionInfo "stable"@en ;
