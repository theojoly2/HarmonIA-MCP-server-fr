<https://w3id.org/arco/ontology/denotative-description/hasFiligree> a owl:ObjectProperty ;
    rdfs:label "has filigree"@en ;
    rdfs:comment "This property relates an artwork, painting, photography, print to its filigree."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> ;
