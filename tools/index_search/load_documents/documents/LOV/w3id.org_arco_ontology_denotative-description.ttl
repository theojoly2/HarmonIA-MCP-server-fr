<https://w3id.org/arco/ontology/denotative-description/hasExtension> a owl:ObjectProperty ;
    rdfs:label "has extension"@en ;
    rdfs:comment "This property relates a musical instrument to its extension."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> ;
