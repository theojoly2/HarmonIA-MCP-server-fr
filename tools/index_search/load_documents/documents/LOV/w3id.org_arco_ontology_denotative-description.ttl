    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/proposedIntervention> a owl:DatatypeProperty ;
    rdfs:label "proposed intervention"@en ;
    rdfs:comment "This property represents potential proposals for conservative interventions after evaluating the cultual entity's conditions at time of its cataloguing."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
