<https://w3id.org/arco/ontology/denotative-description/transcript> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "transcript"@en ;
    rdfs:comment "This property connects an inscription, emblem etc., to the text's transcription, using scientifically accepted integrations."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/l0/System> a owl:Class .

<https://w3id.org/italia/onto/l0/identifier> a owl:DatatypeProperty .

<https://w3id.org/italia/onto/l0/name> a owl:DatatypeProperty .

<https://w3id.org/arco/ontology/core/Concept> a owl:Class .

<https://w3id.org/arco/ontology/core/hasCharacteristic> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/denotative-description/Dedication> a owl:Class ;
    rdfs:label "Dedication"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Circumstance> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCircumstance> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Source> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSource> ],
        <https://w3id.org/arco/ontology/denotative-description/Inscription> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa MI 3.00: AU/DDC" .

<https://w3id.org/arco/ontology/denotative-description/Inscription> a owl:Class ;
    rdfs:label "Inscription"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/Orientation> a owl:Class ;
    rdfs:label "Orientation"@en ;
    rdfs:comment "This class represents the orientation of an object (i.e. N.W., S.E.), considering the main axis."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isOrientationOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/italia/onto/l0/Characteristic> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/hasFunctionalPurpose> a owl:ObjectProperty ;
    rdfs:label "has functional purpose"@en ;
    rdfs:comment "This property realtes an object (e.g. cultural entity, iconographic/decorative apparatus, affixed element like an inscription) to its functional purpose, intended as the function the object has to perform (decorative, religious, symbolic, magic-offensive etc.)."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/FunctionalPurpose> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCharacteristic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isFunctionalPurposeOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/hasMaterialOrTechnique> a owl:ObjectProperty ;
    rdfs:label "has material or technique"@en ;
    rdfs:comment "This property relates an object to the material or technique through which an object has been realized, e.g. a cultural entity. In ICCD standards for cataloguing cultural entities, this label is necessary when material and technique are registered in the same field."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/denotative-description/hasTechnicalCharacteristic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isMaterialOrTechniqueOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/hasMeasurement> a owl:ObjectProperty ;
    rdfs:label "has measurement"@en ;
    ns1:isNativeTo <https://w3id.org/arco/pattern/object-collection/> ;
    rdfs:comment "This property connects a set of observed measures on an object to one of those measures."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/MeasurementCollection> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/Measurement> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isMeasurementIn> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/hasTechnicalStatus> a owl:ObjectProperty ;
    rdfs:label "has technical status"@en ;
    rdfs:comment "This property connects a cultural entity to its technical status, valid until a specific moment, that is represented by the technical characteristics that a cultural entity has in that moment."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalStatus> ;
