<https://w3id.org/arco/ontology/denotative-description/hasFileFormat> a owl:ObjectProperty ;
    rdfs:label "has file format"@en ;
    rdfs:comment "This property relates a digital resource to the format used to write it on a data medium."@en ;
    rdfs:domain owl:Thing ;
