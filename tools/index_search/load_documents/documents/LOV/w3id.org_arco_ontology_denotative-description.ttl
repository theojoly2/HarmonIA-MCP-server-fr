    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isDedicateeOf> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa MI 3.00: AU/DDC/DDCM" .

<https://w3id.org/arco/ontology/denotative-description/hasDesignationInTime> a owl:ObjectProperty ;
    rdfs:label "has designation in time"@en ;
    rdfs:comment "This property connects a cultural entity to its denomination and/or dedication, or title (for FF legislation) over time."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/DesignationInTime> ;
