<https://w3id.org/arco/ontology/denotative-description/Brand> a owl:Class ;
    rdfs:label "Brand"@en ;
    rdfs:comment "This class represents a brand, that is a sign, an image, a symbol affixed on an object for identification."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/Capacity> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/denotative-description/MeasurementType> ;
    rdfs:label "Capacity"@en ;
