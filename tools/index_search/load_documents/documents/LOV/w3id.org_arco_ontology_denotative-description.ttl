    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa MA, CA, SI, SAS: MC/CMN" .

<https://w3id.org/arco/ontology/denotative-description/satisfiesTechnicalDescription> a owl:ObjectProperty ;
    rdfs:label "satisfies technical description"@en ;
    rdfs:comment "This property relates a technical status (intended as a situaiton) of a cultural entity to the technical description satisfied by that situation."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalStatus> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalDescription> ;
