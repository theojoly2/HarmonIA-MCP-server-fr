    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa BDI: CU" .

<https://w3id.org/arco/ontology/denotative-description/hasConservationStatus> a owl:ObjectProperty ;
    rdfs:label "has conservation status"@en ;
    rdfs:comment "This property relates the cultural property with its conservation status."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/ConservationStatus> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasSituation> ;
