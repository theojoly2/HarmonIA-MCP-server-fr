    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isGarmentAnalysisOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/hasGarmentColour> a owl:ObjectProperty ;
    rdfs:label "has garment colour"@en ;
    rdfs:comment "This property relates an ancient and contemporary garment to its dominant color, usually it is base fabric's color, or the interlaced decoration's color."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/denotative-description/hasTechnicalCharacteristic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isGarmentColourOf> ;
    owl:versionInfo "stable"@en .

