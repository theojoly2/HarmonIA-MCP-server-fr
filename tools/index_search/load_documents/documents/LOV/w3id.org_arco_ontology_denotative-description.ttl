    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/AffixedElementType> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasType> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isAffixedElementTypeOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/hasCommunicationMedium> a owl:ObjectProperty ;
    rdfs:label "has communication medium"@en ;
    rdfs:comment "This property relates an intangible cultural property to a communication medium."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
