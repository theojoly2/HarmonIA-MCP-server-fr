    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/isSupportOf> a owl:ObjectProperty ;
    rdfs:label "is support of"@en ;
    rdfs:comment "This property connects a support (e.g. \"paper label\") to an element (stamp, embelem, inscription, mark) which has been represented on it. It is the inverse property of hasSupport."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/Support> ;
    rdfs:isDefinedBy <https://w3id.org/arco/denotative-description> ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/ISE/ISES" .

<https://w3id.org/arco/ontology/denotative-description/isTechnicalStatusOf> a owl:ObjectProperty ;
    rdfs:label "is technical status of"@en ;
    rdfs:comment "This property connects a technical status to a cultural entity. This status is valid until a specific moment and is represented by the technical characteristics that a cultural entity has in that moment."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalStatus> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/isWritingSystemOf> a owl:ObjectProperty ;
    rdfs:label "is writing system of"@en ;
    rdfs:comment "This is the inverse property of \"has writing system\"."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/WritingSystem> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/usesTechnicalConcept> a owl:ObjectProperty ;
    rdfs:label "uses technical concept"@en ;
    rdfs:comment "This property relates a technical description of a cultural property to one of the concepts used in that description."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalDescription> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/TechnicalConcept> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation> a owl:Class .

<https://w3id.org/italia/onto/TI/TimeInterval> a owl:Class .

<https://w3id.org/italia/onto/l0/Collection> a owl:Class .

<https://w3id.org/arco/ontology/core/hasCulturalEntityCharacteristic> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/hasSituation> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/isSituationOf> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/denotative-description/Accessory> a owl:Class ;
    rdfs:label "Accessory"@en ;
    rdfs:comment "This class represents an accessory of a musical property, both if it is functional to the sound production, or if it is the sound's production or conservation medium."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isAccessoryOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/creationDate> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa SM 4.00: AS/ASS/ASST" .

<https://w3id.org/arco/ontology/denotative-description/AffixedElementType> a owl:Class ;
    rdfs:label "Affixed element type"@en ;
    rdfs:comment "This class represents the type (i.e. civil, religious) of an inscription, emblem, postmark, crest, etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isAffixedElementTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/AgeRange> a owl:Class ;
    rdfs:label "Age range"@en ;
    rdfs:comment "This class represents the age range (child, teenager, adult, old person) of a person."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isAgeRangeInvolvedIn> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/CommunicationMedium> ],
        <https://w3id.org/italia/onto/l0/Characteristic> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa BDI: CU/CUC/CUCE; CU/CUP/CUPE" .

<https://w3id.org/arco/ontology/denotative-description/CulturalPropertyDefinition> a owl:Class ;
    rdfs:label "Cultural Property Definition"@en ;
    rdfs:comment "This class represents the definition of a cultural property. It is the term or expression which identifies the property that is being catalogued."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isCulturalPropertyDefinitionOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyType> ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "OG/OGT/OGTD" .

<https://w3id.org/arco/ontology/denotative-description/CulturalPropertySpecification> a owl:Class ;
    rdfs:label "Cultural Property Specification"@en ;
    rdfs:comment "This class represents the morphological or functional specification, which are useful to define a cultural property for a more precise individuation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isCulturalPropertySpecificationOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyType> ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "OG/OGT/OGTT" .

<https://w3id.org/arco/ontology/denotative-description/FontStyle> a owl:Class ;
    rdfs:label "Font style"@en ;
    rdfs:comment "This class represents the font style used in a text (i.e. italic, bold, gothic)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isFontStyleOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ],
        <https://w3id.org/italia/onto/l0/Characteristic> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/ImplementationMethod> a owl:Class ;
    rdfs:label "Implementation method"@en ;
    rdfs:comment "This class represents the implementation method (e.g.: polyphonic) associated to a verbale or singing or instrumental communication medium."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isImplementationMethodOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/CommunicationMedium> ],
        <https://w3id.org/arco/ontology/core/Method> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa BDI: CU/CUM/CUMD; CU/CUS/CUSD" .

<https://w3id.org/arco/ontology/denotative-description/OrnamentalMotif> a owl:Class ;
    rdfs:label "Ornamental Motif"@en ;
    rdfs:comment "This class represents the ornamental motif (anthropomorphous, zoomorphic, geometric) represented by a cultural property's iconographic and decorative apparatus."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isOrnamentalMotifOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/IconographicOrDecorativeApparatus> ],
        <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/Support> a owl:Class ;
    rdfs:label "Support"@en ;
    rdfs:comment "This class represents the support on which an element can be located, for instance an inscription, emblem, postmark represented on a cultural property (i.e. \"paper label\")."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isSupportOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/ISE/ISES" .

<https://w3id.org/arco/ontology/denotative-description/WritingSystem> a owl:Class ;
    rdfs:label "Writing system"@en ;
    rdfs:comment "This class represents the writing system or alphabet of an inscription, postmark, crest etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isWritingSystemOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ],
        <https://w3id.org/italia/onto/l0/System> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/ISE/ISEF" .

<https://w3id.org/arco/ontology/denotative-description/isMaterialOrTechniqueOf> a owl:ObjectProperty ;
    rdfs:label "is material or technique of"@en ;
    rdfs:comment "This is the inverse property of \"has material or technique\""@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/denotative-description/isTechnicalCharacteristicOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/isMeasurementIn> a owl:ObjectProperty ;
    rdfs:label "is measurement in collection"@en ;
    ns1:isNativeTo <https://w3id.org/arco/pattern/object-collection/> ;
    rdfs:comment "This property connects an object's measure to the observed measures' collection of that object. It is the inverse property of hasMeasurement."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/Measurement> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/MeasurementCollection> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/MU/Value> a owl:Class .

<https://w3id.org/italia/onto/l0/Object> a owl:Class .

<https://w3id.org/arco/ontology/core/Situation> a owl:Class .

<https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalDescription> a owl:Class ;
    rdfs:label "Cultural entity technical description"@en ;
    rdfs:comment "This class represents the technical description of a cultural entity, which uses all the technical concepts classifying the technical characteristics that a cultural entity can have. This class is a particular type of the class Description, which is the class for socially constructed objects (i.e. texts, values, categories, relations, contexts) used to describe other objects in a structured manner."@en ;
    rdfs:isDefinedBy <https://w3di.org/arco/ontology/denotative-description/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/TechnicalConcept> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/usesTechnicalConcept> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalStatus> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isTechnicalDescriptionSatisfiedBy> ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAvailability> a owl:Class ;
    rdfs:label "Cultural Property Availability"@en ;
    rdfs:comment "This class represents the availability of a cultural property, wheter the cultural property is available or not (e.g.: theft, destruction) for example for cataloguing activities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isCulturalPropertyAvailabilityOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/core/CulturalEntityCharacteristic> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/OGR" .

<https://w3id.org/arco/ontology/denotative-description/FunctionalPurpose> a owl:Class ;
    rdfs:label "Functional purpose"@en ;
    rdfs:comment "This class represents the functional purpose (i.e. decorative, religious, symbolic, magic-offensive) of an object (i.e. culural property or iconographic/decorative apparatus or affixed element on a cultural property like an inscription). The functional purpose is intended as the function that an object has to perform."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isFunctionalPurposeOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/arco/ontology/core/CulturalEntityCharacteristic> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/SampleCollectedType> a owl:Class ;
    rdfs:label "Sample collected type"@en ;
    rdfs:comment "This class represents the sample type collected from an archaeologiacal property (i.e. coal, pottery, grout)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isSampleCollectedTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/SampleCollected> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa MA, CA, SI, SAS: MC/CMN/CMNT" .

<https://w3id.org/italia/onto/l0/Characteristic> a owl:Class .

<https://w3id.org/italia/onto/l0/Description> a owl:Class .

<https://w3id.org/arco/ontology/core/CulturalEntityCharacteristic> a owl:Class .

<https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAccessibility> a owl:Class ;
    rdfs:label "Cultural property accessibility"@en ;
    rdfs:comment "This class represents the cultural property accessibility, that is the possibility to reach or enter that cultural property, for example for cataloguing activities (e.g.: an immovable cultural property located in a walled area, a movable cultural property located on the top shelf, a totally accessible cultural property, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isCulturalPropertyAccessibilityOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/core/CulturalEntityCharacteristic> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: LC/ACB" .

<https://w3id.org/arco/ontology/denotative-description/DesignationInTime> a owl:Class ;
    rdfs:label "Designation In Time"@en ;
    rdfs:comment "This class represents a certain cultural property's designation/denomination attested over time."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/core/note> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isDesignationInTimeOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/onto/l0/name> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/DesignationType> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasDesignationType> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/l0/Agent> a owl:Class .

<https://w3id.org/arco/ontology/denotative-description/SampleCollected> a owl:Class ;
    rdfs:label "Sample collected"@en ;
    rdfs:comment "This class represents a sample collected from an archeological property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/sampleCollectedIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/SampleCollectedType> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasSampleCollectedType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/positionOnCulturalProperty> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isSampleCollectedFrom> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/italia/onto/l0/Collection> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa MA, CA, SI, SAS: MC/CMN" .

<https://w3id.org/arco/ontology/denotative-description/IconographicOrDecorativeApparatusType> a owl:Class ;
    rdfs:label "Iconographic Or Decorative Apparatus Type"@en ;
    rdfs:comment "This class represents the iconographic or decorative apparatus' type (iconographic, decorative, iconographic-decorative) of a cultual property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isIconographicOrDecorativeApparatusTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/IconographicOrDecorativeApparatus> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/AID/AIDO" .

<https://w3id.org/arco/ontology/core/Type> a owl:Class .

<https://w3id.org/arco/ontology/core/hasType> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/denotative-description/ConservationStatus> a owl:Class ;
    rdfs:label "Conservation Status"@en ;
    dc:description "An example of usage of the class 'Conservation status' is the following:\\nresource:ConservationStatus/0900750201-conservation-status-1\\n        a   dd:ConservationStatus ;\\n        rdfs:label  \"Conservation status 1 of cultural property: 0900750201\"@en ;\\n        core:specifications  \"Stains at the lining, along the neckline.\" ;\\n       dd:hasConservationStatusType dd:GoodConservationStatus ;\\n        tiapit:time   \"2014\" ."@en ;
    rdfs:comment "This class represents the conservation status of the cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/Legibility> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasLegibility> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/ConservationStatusType> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasConservationStatusType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isConservationStatusOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "CO/STC" .

<https://w3id.org/arco/ontology/denotative-description/IconographicOrDecorativeApparatus> a owl:Class ;
    rdfs:label "Iconographic or Decorative Apparatus"@en ;
    rdfs:comment "This class represents the iconographic or decorative apparaturs of a cultural property. It is intended as the more or less complex set of iconographic or decorative representations on the cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isIconographicOrDecorativeApparatusOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/OrnamentalMotif> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasOrnamentalMotif> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasIconographicOrDecorativeApparatusType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/IconographicOrDecorativeApparatusType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/FunctionalPurpose> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasFunctionalPurpose> ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/AID - ICCD Normative PST e BDM: DA/APF" .

<https://w3id.org/arco/ontology/denotative-description/Legibility> a owl:Class ;
    rdfs:label "Legibility"@en ;
    rdfs:comment "This class represents the legibility status (complete, decent, good, lowered, impossible) of a numinsmatic property. It is related to the property's conservation status."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isLegibilityOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/ConservationStatus> ],
        <https://w3id.org/arco/ontology/core/CulturalEntityCharacteristic> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa NU: CO/STC/STCL" .

<https://w3id.org/arco/ontology/denotative-description/MeasurementCollection> a owl:Class ;
    rdfs:label "Measurement collection"@en ;
    ns1:isNativeTo <https://w3id.org/arco/pattern/object-collection/> ;
    dc:description "An example of usage of the class 'Measurement collection' is the following:\\nresource:MeasurementCollection/1200865132-1\\n        a  dd:MeasurementCollection ;\\n        rdfs:label \"Measurements of cultural property 1200865132 7\"@en ;\\n        dd:hasMeasurement resource:Measurement/1200865132-1-width , resource:Measurement/1200865132-1-height , resource:Measurement/1200865132-1-depth ."@en ;
    rdfs:comment "This class represents the set of measurments observed for an object."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasMeasurement> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/Measurement> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isMeasurementCollectionOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/italia/onto/l0/Collection> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/ConservationStatusType> a owl:Class ;
    rdfs:label "Conservation Status Type"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isConservationStatusTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/ConservationStatus> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "CO/STC/STCC" .

<https://w3id.org/arco/ontology/denotative-description/CulturalPropertyType> a owl:Class ;
    rdfs:label "Cultural property Type"@en ;
    rdfs:comment "This class represents a cultural property's type, that is the term or expression which specifies the cultural propery that is being catalogued and additional information on the cultural property's definition."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isCulturalPropertyTypeOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalPropertySpecification> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasCulturalPropertySpecification> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasCulturalPropertyDefinition> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyDefinition> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "OG/OGT" .

<https://w3id.org/arco/ontology/denotative-description/CommunicationMediumType> a owl:Class ;
    rdfs:label "Communication medium type"@en ;
    rdfs:comment "This class represents the type of communication medium."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isCommunicationMediumTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/CommunicationMedium> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa BDI: CU" .

<https://w3id.org/arco/ontology/denotative-description/Measurement> a owl:Class ;
    rdfs:label "Measurement"@en ;
    dc:description "An example of usage of the class 'Measurement' is the following:\\nresource:Measurement/0500212021-1-height\\n        a  dd:Measurement ;\\n        rdfs:label  \"Measurement of cultural property 0500212021: 795mm.\"@en ;\\n        dd:hasMeasurementType dd:Height ;\\n        dd:hasValue resource:Value/0500212021-1-height-795 ."@en ;
    rdfs:comment "This class represents a measurement of an object. Measurements realte to the cultural property's dimensions."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasMeasurementType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/MeasurementType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasValue> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/MU/Value> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isMeasurementIn> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/MeasurementCollection> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalStatus> a owl:Class ;
    rdfs:label "Technical status of cultural entity"@en ;
    ns1:isNativeTo <https://w3id.org/arco/pattern/technical-characteristic/> ;
    dc:description "An example of usage of the class 'Cultural entity technical status' is the following:\\nresource:CulturalEntityTechnicalStatus/0900281817-4\\n        a           a-dd:CulturalEntityTechnicalStatus ;\\n        rdfs:label  \"Technical status of cultural property 0900281817-4\"@en ;\\n        a-dd:includesTechnicalCharacteristic\\n                resource:TechnicalCharacteristic/centinato, resource:TechnicalCharacteristic/stone-sculpture .\\n\\nresource:TechnicalCharacteristic/stone-sculpture\\n        a                    a-dd:TechnicalCharacteristic ;\\n        rdfs:label           \"stone/ sculpture\" ;\\n        a-dd:isClassifiedBy  a-dd:MaterialOrTechnique ."@en ;
    rdfs:comment "This class represents the technical status of a cultural entity, that is a situation in which the cultural entity is associated to technical characteristics. The technical status has a temporal validity, related to the moment when the characteristics were observed. For instance, a cultural property techncal status is: \"the cultural property X realized with pottery material and cylindrical in shape\"."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/includesTechnicalCharacteristic> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isTechnicalStatusOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: MT/MTC/MTCM; MT/MTC/MTCT - Normativa OA, D, F, S, MI: MT/FRM - Normativa OA, D, F, S: MT/FIL - Normativa VeAC: MT/MTC/MTCC; MT/MTC/MTCF - Normativa F: MT/FVC/FVCC; MT/FVC/FVCF; MT/FVC/FVCP; MT/FVC/FVCU; MT/FVC/FVCM; MT/FVM;" .

<https://w3id.org/arco/ontology/denotative-description/CommunicationMedium> a owl:Class ;
    rdfs:label "Communication medium"@en ;
    rdfs:comment "This class represents the communication medium of an object, defined by the communication medium type (e.g.: verbal, written, instrumental), the implementation method, the number of voices or instruments involved, etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/numberOfMaleParticipants> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasCommunicationMediumType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/CommunicationMediumType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/numberOfChildParticipants> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/ImplementationMethod> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasImplementationMethod> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/AgeRange> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/involvesAgeRange> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/numberOfFemaleParticipants> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isCommunicationMediumOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/core/CulturalEntityCharacteristic> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa BDI: CU" .

<https://w3id.org/arco/ontology/denotative-description/DesignationType> a owl:Class ;
    rdfs:label "Designation Type"@en ;
    rdfs:comment "This class represents a cultural property's denomination or dedication type, or its title (i.e. other language, current, attributed, dialectal)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isDesignationTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/DesignationInTime> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/hasTechnicalCharacteristic> a owl:ObjectProperty ;
    rdfs:label "has technical characteristic"@en ;
    rdfs:comment "This property relates an entity to a technical characteristic (e.g. material, technique, colour, quality level)."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isTechnicalCharacteristicOf> ;
    owl:propertyChainAxiom ( <https://w3id.org/arco/ontology/denotative-description/hasTechnicalStatus> <https://w3id.org/arco/ontology/denotative-description/includesTechnicalCharacteristic> ) ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/isTechnicalCharacteristicOf> a owl:ObjectProperty ;
    rdfs:label "is technical characteristic of"@en ;
    rdfs:comment "This property relates a technical characteristic to an entity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/AffixedElement> a owl:Class ;
    rdfs:label "Element affixed on cultural property"@en ;
    dc:description "An example of usage of one of the subclasses of the class 'Affixed element' is the following:\\nresource:Inscription/1200865151-inscription-1\\n        a   dd:Inscription ;\\n        rdfs:label \"Inscription 1 of cultural property 1200865151\"@en ;\\n        dd:hasFontStyle resource:FontStyle/lettere-capitali ;\\n        dd:hasTechnicalDetailOccurrence resource:TechnicalDetailOccurrence/1200865151-inscription-1-material-technique-1 ;\\n        dd:positionOnCulturalProperty \"in the middle\" ;\\n        dd:transcript \"PAVLVS VENETVS PAPA SECVNDVS SVIS IMPENSIS FIERI FECIT ANNO CRISTI MCCCLXVII\" ;\\n        language:hasLanguage resource:Language/latino ."@en ;
    rdfs:comment "This class represents an element (i.e. crest, trademark, postmark, inscription) which is affixed on a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/FontStyle> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasFontStyle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalStatus> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasTechnicalStatus> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/transcript> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/core/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/FunctionalPurpose> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasFunctionalPurpose> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isElementAffixedOn> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/Support> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasSupport> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/WritingSystem> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasWritingSystem> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAuthor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/italianTranslation> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/TechnicalConcept> a owl:Class ;
    rdfs:label "Technical concept"@en ;
    ns1:isNativeTo <https://w3id.org/arco/pattern/technical-characteristic/> ;
    rdfs:comment "This class represents a technical concept, a particular type of concept that classifies a technical characteristic of an entity, e.g. cultural property. For instance, \"material\" is a techincal concept that classifies the technical characteristic \"pottery\" related to a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: MT/MTC/MTCM; MT/MTC/MTCT - Normativa OA, D, S, MI: MT/FRM - Normativa OA, D, F, S: MT/FIL - Normativa VeAC: MT/MTC/MTCC; MT/MTC/MTCF - Normativa F: MT/FVC/FVCC; MT/FVC/FVCF; MT/FVC/FVCP; MT/FVC/FVCU; MT/FVC/FVCM; MT/FVM; MT/MTX; MT/FVM; MT/FRM;" .

<http://dati.beniculturali.it/cis/CulturalEntity> a owl:Class .

<https://w3id.org/arco/ontology/denotative-description/MeasurementType> a owl:Class ;
    rdfs:label "Measurement Type"@en ;
    rdfs:comment "This class represents the observed measurement type (width, height, diameter, etc)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isMeasurementTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/denotative-description/Measurement> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/TechnicalCharacteristic> a owl:Class ;
    rdfs:label "Technical Characteristic"@en ;
    ns1:isNativeTo <https://w3id.org/arco/pattern/technical-characteristic/> ;
    rdfs:comment "This class represents a characteristic of a cultural property. For example it can represent a cultural property's particular costituent material or the technique with which it was made or its shape or color. Each technical characteristic is classified by a concept (i.e. \"clay\" is a techical characteristic classified by the technical concept \"material\" related to a cultural property). For each cultural property typology can be registered some specific technical characteristics."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/TechnicalConcept> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isCharacteristicClassifiedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalStatus> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/isIncludedInTechnicalStatus> ],
        <https://w3id.org/italia/onto/l0/Characteristic> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: MT/MTC/MTCM; MT/MTC/MTCT - Normativa OA, D, F, S, MI: MT/FRM - Normativa OA, D, F, S: MT/FIL - Normativa VeAC: MT/MTC/MTCC; MT/MTC/MTCF - Normativa F: MT/FVC/FVCC; MT/FVC/FVCF; MT/FVC/FVCP; MT/FVC/FVCU; MT/FVC/FVCM; MT/FVM;" .

onto: a owl:Ontology ;
    rdfs:label "Denotative Description Ontology (ArCo network)"@en ;
    ns1:reusesPatternAsTemplate <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl> ;
    dc:creator "Aldo Gangemi (ISTC-CNR, STLab)",
        "Andrea Nuzzolese (ISTC-CNR, STLab)",
        "Chiara Veninata (MiBAC, ICCD)",
        "Ludovica Marinucci (ISTC-CNR, STLab)",
        "Marialetizia Mancinelli (MiBAC, ICCD)",
        "Valentina Carriero (ISTC-CNR, STLab)",
        "Valentina Presutti (ISTC-CNR, STLab)" ;
    dc:description "The Denotative Description module encodes the characteristics of a cultural property, as detectable and/or detected during the cataloguing process and measurable according to a reference system. Examples include measurements e.g. length, constituting materials e.g. clay, employed techniques e.g. melting, conservation status e.g. good, decent, bad."@en ;
    dc:language <http://publications.europa.eu/resource/authority/language/ENG>,
        <http://publications.europa.eu/resource/authority/language/ITA> ;
    dc:title "Denotative Description Ontology (ArCo network)"@en ;
    dcterms:issued "2018-03-07" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/>,
        <https://w3id.org/italia/controlled-vocabulary/licences/A31_CCBYSA40> ;
    dcterms:modified "2019-06-01" ;
    ns3:reusesPatternAsTemplate <http://www.ontologydesignpatterns.org/cp/owl/classification.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/situation.owl> ;
    rdfs:comment "The Denotative Description module encodes the characteristics of a cultural property, as detectable and/or detected during the cataloguing process and measurable according to a reference system. Examples include measurements e.g. length, constituting materials e.g. clay, employed techniques e.g. melting, conservation status e.g. good, decent, bad.\\nIn this module are used as template the following Ontology Design Patterns:\\n- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/classification.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/descriptionandsituation.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/situation.owl"@en ;
    owl:imports <https://w3id.org/arco/ontology/context-description>,
        <https://w3id.org/arco/ontology/core>,
        <https://w3id.org/arco/ontology/location> ;
    owl:versionInfo "Version 1.0"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/denotative-description/AffixedElementType> <https://w3id.org/arco/ontology/denotative-description/CommunicationMediumType> <https://w3id.org/arco/ontology/denotative-description/ConservationStatusType> <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyType> <https://w3id.org/arco/ontology/denotative-description/DesignationType> <https://w3id.org/arco/ontology/denotative-description/IconographicOrDecorativeApparatusType> <https://w3id.org/arco/ontology/denotative-description/MeasurementType> <https://w3id.org/arco/ontology/denotative-description/SampleCollectedType> ) .

