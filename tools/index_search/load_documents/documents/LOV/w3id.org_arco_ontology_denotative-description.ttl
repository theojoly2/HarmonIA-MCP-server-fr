    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isTemperamentOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/hasTuning> a owl:ObjectProperty ;
