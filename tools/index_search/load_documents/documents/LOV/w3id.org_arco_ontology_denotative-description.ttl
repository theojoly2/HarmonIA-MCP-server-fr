    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/denotative-description/sampleCollectedIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
