    rdfs:label "has iconographic or decorative apparatus"@en ;
    rdfs:comment "This property relates a cultural enitity to its iconographic or decorative apparatus."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/IconographicOrDecorativeApparatus> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasDescription> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isIconographicOrDecorativeApparatusOf> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/AID - ICCD Normative PST e BDM: DA/APF" .

<https://w3id.org/arco/ontology/denotative-description/hasLocationSubject> a owl:ObjectProperty ;
    rdfs:label "has location as subject"@en ;
    rdfs:comment "This property represent the location as a subject of a cultural entity."@en ;
