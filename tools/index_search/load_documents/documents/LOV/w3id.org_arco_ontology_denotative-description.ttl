    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "CO/STC" .

<https://w3id.org/arco/ontology/denotative-description/hasCulturalPropertyAccessibility> a owl:ObjectProperty ;
    rdfs:label "has cultural property accessibility"@en ;
    rdfs:comment "This property relates the cultural property to its accessibility, that is the possibility to reach or enter that cultural property, for example for cataloguing activities (e.g.: an immovable cultural property located in a walled area, a movable cultural property located on the top shelf, a totally accessible cultural property, etc.)"@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAccessibility> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCulturalEntityCharacteristic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isCulturalPropertyAccessibilityOf> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: LC/ACB" .

<https://w3id.org/arco/ontology/denotative-description/hasCulturalPropertyAvailability> a owl:ObjectProperty ;
    rdfs:label "has cultural property availability"@en ;
    rdfs:comment "This class relates the cultural property to its availability, that is wheter the cultural property is available or not (e.g.: theft, destruction) for example for cataloguing activities."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAvailability> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCulturalEntityCharacteristic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/denotative-description/isCulturalPropertyAvailabilityOf> ;
    owl:versionInfo "stable"@en ;
    ns2:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/OGR" .

