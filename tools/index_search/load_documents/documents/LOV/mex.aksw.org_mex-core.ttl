@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix onto: <http://mex.aksw.org/mex-core> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "The MEX Vocabulary (mex-core)"@en ;
    dc:publisher "AKSW Research Group - Leipzig University"@en ;
    dcterms:contributor <http://aksw.org/DiegoMoussallem.html>,
        <http://aksw.org/JensLehmann.html> ;
    dcterms:created "2014-02-02"^^xsd:date ;
    dcterms:creator <http://aksw.org/DiegoEsteves.html> ;
    dcterms:modified "2016-05-01"^^xsd:date ;
    dcterms:title "MEX Core (mex-core) is an ontology with the goal of describing the core process for machine learning problems (MEX Platform)"@en ;
    rdf:about "http://mex.aksw.org/mex-doc-core#" ;
    rdfs:comment "MEX is an RDF vocabulary designed to facilitate interoperability between published machine learning experiments results on the Web. The mex-core layer represents the core information gathered from a basic machine learning experiment design."@en ;
    owl:imports doap:,
        rdfs:,
        <http://www.w3.org/ns/prov-o#> ;
    owl:versionInfo "1.0.2" .

<http://mex.aksw.org/mex-core#AdaptativeWebSites> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#AffectiveComputing> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#Bioinformatics> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#Bootstrapping> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#SamplingMethod> .

<http://mex.aksw.org/mex-core#BrainMachineInterfaces> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#Cheminformatics> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#ClassifyingDNAsequences> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#ComputationalAdversiting> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#ComputationalFinance> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#ComputerVision> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#CrossValidation> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#SamplingMethod> .

<http://mex.aksw.org/mex-core#Dataset> a owl:Class ;
    dc:description "Class that provides a structured dataset"@en ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        <http://www.w3.org/ns/prov-o#Entity> .

<http://mex.aksw.org/mex-core#DetectingCreditCardFrauds> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#ExecutionOverall> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Execution> .

<http://mex.aksw.org/mex-core#ExecutionSingle> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Execution> .

<http://mex.aksw.org/mex-core#ExperimentConfiguration> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        <http://www.w3.org/ns/prov-o#Activity> .

<http://mex.aksw.org/mex-core#FactPrediction> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#Feature> a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/prov-o#Entity> .

<http://mex.aksw.org/mex-core#FeatureCollection> a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/prov-o#Collection> .

<http://mex.aksw.org/mex-core#GamePlaying> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#Holdout> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#SamplingMethod> .

<http://mex.aksw.org/mex-core#InformationRetrieval> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#InternetFraudDetection> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#LeaveOneOut> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#SamplingMethod> .

<http://mex.aksw.org/mex-core#LinkDiscovery> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#MachinePerception> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#MedicalDiagnosis> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#Metaheuristics> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#Model> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        <http://www.w3.org/ns/prov-o#Entity> .

<http://mex.aksw.org/mex-core#NFoldsCrossValidation> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#SamplingMethod> .

<http://mex.aksw.org/mex-core#NaturalLanguageProcessing> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#ObjectRecognition> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#Optimization> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#RecomenderSystems> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#Robotics> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#SearchEngines> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#SentimentAnalysis> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#SequenceMining> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#SoftwareEngineering> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#SpeechAndHandwritingRecognition> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#StockMarketAnalysis> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#StructuralHealthMonitoring> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#SyntacticLanguageProcessing> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Context> .

<http://mex.aksw.org/mex-core#attributeSelectionDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#Experiment> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#cpu> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#HardwareConfiguration> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#cpuCache> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#HardwareConfiguration> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#dataNormalizedDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#Experiment> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#datasetColumn> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#Example> ;
    rdfs:range rdfs:Literal .

<http://mex.aksw.org/mex-core#datasetRow> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#Example> ;
    rdfs:range rdfs:Literal .

<http://mex.aksw.org/mex-core#endsAt> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#ExampleCollection> ;
    rdfs:range rdfs:Literal .

<http://mex.aksw.org/mex-core#endsAtPosition> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#Execution> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#folds> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#SamplingMethod> ;
    rdfs:range xsd:nonNegativeInteger .

<http://mex.aksw.org/mex-core#hasApplicationContext> a owl:ObjectProperty ;
    rdfs:range <http://mex.aksw.org/mex-core#ApplicationContext> .

<http://mex.aksw.org/mex-core#hasPhase> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#ExampleCollection> ;
    rdfs:range <http://mex.aksw.org/mex-core#Phase> .

<http://mex.aksw.org/mex-core#hasSamplingMethod> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#Experiment> .

<http://mex.aksw.org/mex-core#hdType> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#HardwareConfiguration> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#memory> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#HardwareConfiguration> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#noiseRemovedDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#Experiment> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#numberOfIteraction> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#SlidingCrossValidation> ;
    rdfs:range xsd:nonNegativeInteger .

<http://mex.aksw.org/mex-core#outliersRemovedDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#Experiment> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#sequential> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#SamplingMethod> ;
    rdfs:range xsd:boolean .

<http://mex.aksw.org/mex-core#startsAt> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#ExampleCollection> ;
    rdfs:range rdfs:Literal .

<http://mex.aksw.org/mex-core#startsAtPosition> a owl:DatatypeProperty .

<http://mex.aksw.org/mex-core#targetClass> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#Execution> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#testSize> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#SamplingMethod> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-core#trainSize> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#SamplingMethod> ;
    rdfs:range xsd:double .

<http://mex.aksw.org/mex-core#trustyURI> a owl:ObjectProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#ApplicationContext> ;
    rdfs:range rdfs:Literal .

<http://mex.aksw.org/mex-core#trustyURIHash> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#ApplicationContext> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#videoGraphs> a owl:DatatypeProperty ;
    rdfs:domain <http://mex.aksw.org/mex-core#HardwareConfiguration> ;
    rdfs:range xsd:string .

<http://mex.aksw.org/mex-core#SlidingCrossValidation> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#SamplingMethod> .

<http://www.w3.org/ns/prov-o#Agent> a owl:Class .

<http://www.w3.org/ns/prov-o#Organization> a owl:Class .

<http://www.w3.org/ns/prov-o#Person> a owl:Class .

<http://mex.aksw.org/mex-core#Example> a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/prov-o#Entity> .

<http://mex.aksw.org/mex-core#Test> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Phase> .

<http://mex.aksw.org/mex-core#Training> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Phase> .

<http://mex.aksw.org/mex-core#Validation> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#Phase> .

<http://mex.aksw.org/mex-core#ValuePartition> a owl:Class .

<http://www.w3.org/ns/prov-o#Activity> a owl:Class .

<http://www.w3.org/ns/prov-o#Collection> a owl:Class .

<http://mex.aksw.org/mex-core#ApplicationContext> a owl:Class ;
    rdfs:comment "describes the context of the experiment, such as NLP, Stock Market Forecast, BioInformatics, Text-Retrieval AND contact informations/publication"@en ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        <http://www.w3.org/ns/prov-o#Agent>,
        <http://www.w3.org/ns/prov-o#Organization>,
        <http://www.w3.org/ns/prov-o#Person> .

<http://mex.aksw.org/mex-core#ExampleCollection> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        <http://www.w3.org/ns/prov-o#Collection> .

<http://mex.aksw.org/mex-core#Execution> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        <http://www.w3.org/ns/prov-o#Activity> .

<http://mex.aksw.org/mex-core#Phase> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#ValuePartition>,
        <http://www.w3.org/ns/prov-o#Entity> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://mex.aksw.org/mex-core#Test> <http://mex.aksw.org/mex-core#Training> <http://mex.aksw.org/mex-core#Validation> ) ] .

<http://mex.aksw.org/mex-core#Experiment> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        <http://www.w3.org/ns/prov-o#Entity> .

<http://mex.aksw.org/mex-core#HardwareConfiguration> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        doap:Version,
        <http://www.w3.org/ns/prov-o#Entity> .

<http://www.w3.org/ns/prov-o#Entity> a owl:Class .

<http://mex.aksw.org/mex-core#DomainConceptSpace> a owl:Class ;
    owl:disjointWith <http://mex.aksw.org/mex-core#ValuePartition> .

<http://mex.aksw.org/mex-core#SamplingMethod> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        <http://www.w3.org/ns/prov-o#Entity> .

<http://mex.aksw.org/mex-core#Context> a owl:Class ;
    rdfs:subClassOf <http://mex.aksw.org/mex-core#DomainConceptSpace>,
        <http://www.w3.org/ns/prov-o#Entity> .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://mex.aksw.org/mex-core#Test> <http://mex.aksw.org/mex-core#Training> <http://mex.aksw.org/mex-core#Validation> ) .

