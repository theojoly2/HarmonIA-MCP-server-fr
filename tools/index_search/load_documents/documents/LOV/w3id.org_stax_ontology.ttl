@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <https://w3id.org/stax/ontology#> .
@prefix ns2: <http://schema.org/> .
@prefix ns3: <http://purl.org/ontology/bibo/> .
@prefix onto: <https://w3id.org/stax/ontology> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:description a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

ns3:status a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

ns2:citation a owl:AnnotationProperty .

foaf:homepage a owl:AnnotationProperty .

foaf:logo a owl:AnnotationProperty .

ns1:hasStreamTypeUsage a owl:ObjectProperty ;
    rdfs:label "has stream type usage"@en ;
    rdfs:comment "Inverse of stax:isUsageOf – indicates that the subject is related to a usage of an RDF stream type.\\n\\nThe subject for this property can be for example a published stream on the Web (e.g., vocals:RDFStream) or a scientific publication that discusses a usage of an RDF stream type."@en ;
    rdfs:range ns1:RdfStreamTypeUsage ;
    owl:inverseOf ns1:isUsageOf .

ns1:canBeFlattenedInto a owl:ObjectProperty ;
    rdfs:label "can be flattened into"@en ;
    rdfs:comment "Indicates that the subject stream type can be flattened into the object.\\n\\nThe flattening is done by enumerating all components of the stream elements in one, flat stream. For example, a graph stream can be flattened into a flat triple stream."@en ;
    rdfs:domain ns1:ConcreteRdfStreamType ;
    rdfs:range ns1:ConcreteRdfStreamType ;
    rdfs:subPropertyOf ns1:streamTypeSemanticRelation ;
    owl:propertyChainAxiom ( skos:broaderTransitive ns1:canBeFlattenedInto ) .

ns1:canBeGroupedInto a owl:ObjectProperty ;
    rdfs:label "can be grouped into"@en ;
    rdfs:comment "Indicates that the subject stream type can be grouped into the object.\\n\\nThe grouping is done by splitting the flat stream of statements into groups, which then can be used to construct elements of the grouped stream. For example, a flat triple stream can be grouped into a graph stream. In this operation, the ordering information within a group is lost."@en ;
    rdfs:domain ns1:ConcreteRdfStreamType ;
    rdfs:range ns1:ConcreteRdfStreamType ;
    rdfs:subPropertyOf ns1:streamTypeSemanticRelation ;
    owl:propertyChainAxiom ( skos:broaderTransitive ns1:canBeGroupedInto ) .

ns1:canBeTriviallyExtendedInto a owl:ObjectProperty ;
    rdfs:label "can be trivially extended into"@en ;
    rdfs:comment "Indicates that the subject stream type that uses triples or graphs can be trivially extended into the object type that uses quads or datasets.\\n\\nThe extension is done by (in case of flat RDF streams) adding a fourth component, corresponding to the default graph. In case of grouped RDF streams, the contents of the graph are placed explicitly in the default graph."@en ;
    rdfs:domain ns1:ConcreteRdfStreamType ;
    rdfs:range ns1:ConcreteRdfStreamType ;
    rdfs:subPropertyOf ns1:streamTypeSemanticRelation ;
    owl:propertyChainAxiom ( skos:broaderTransitive ns1:canBeTriviallyExtendedInto ) .

ns1:hasStreamType a owl:ObjectProperty ;
    rdfs:label "has stream type"@en ;
    rdfs:comment "For an RDF stream type usage, this property indicates which stream type is used."@en ;
    rdfs:domain ns1:RdfStreamTypeUsage ;
    rdfs:range ns1:ConcreteRdfStreamType .

ns1:isUsageOf a owl:ObjectProperty ;
    rdfs:label "is usage of"@en ;
    rdfs:comment "For an RDF stream type usage, this property indicates where the stream was used or from where the usage was derived. The value of this property can be anything that makes sense for the desired use case. The value can be for example: the DOI URL of an academic work, URL of a piece of software, IRI of a published stream, IRI of an RDF dataset.\\n\\nInverse of stax:hasStreamTypeUsage."@en ;
    rdfs:domain ns1:RdfStreamTypeUsage .

ns1:subjectGraphStream a owl:NamedIndividual,
        skos:Concept,
        ns1:ConcreteRdfStreamType ;
    skos:broader ns1:graphStream ;
    skos:definition "An RDF subject graph stream is an RDF graph stream in which every element contains an IRI node (called the subject node) that uniquely identifies the graph in the stream. Every other node in the graph can be reached by traversing triples, starting from the subject node."@en ;
    skos:example <https://w3id.org/np/RAD3_KmaQcSOOQTOKOsrwahi56Ib8pKMRlKfhylozW-UQ>,
        <https://w3id.org/np/RAqbZ03A1F0UPJmpa6d_r_uRUp46nmcwN8Yep2Rgiy8b4> ;
    skos:inScheme onto: ;
    skos:note "A stream of RDF graphs which have a node that uniquely identifies them in the stream."@en ;
    skos:prefLabel "RDF subject graph stream"@en ;
    ns1:canBeFlattenedInto ns1:flatTripleStream ;
    ns1:hasElementType ns1:graph .

ns1:timestampedNamedGraphStream a owl:NamedIndividual,
        skos:Concept,
        ns1:ConcreteRdfStreamType ;
    skos:broader ns1:namedGraphStream ;
    skos:definition "A timestamped named graph is an RDF dataset in which: (1) there is exactly one named RDF graph pair <n, G>, where G is an RDF graph, and n is the graph name; (2) the default graph includes a timestamp triple <n, p, t>, where p is a timestamp predicate that relates t, called the timestamp, and the graph G.\\n\\nA timestamped RDF named graph stream is an RDF named graph stream in which every element is a timestamped named graph. The elements that share the same timestamp predicate p are ordered by the partial order associated with p."@en ;
    skos:example <https://w3id.org/np/RA6E9BH7J5qMYnuL7Kgys4Vsz25AKIAHtSQ78tcXFIlTc>,
        <https://w3id.org/np/RAU7pbHsOVgltc5Az1pOuNSV4cjI-DDWqoRJyAVhKvUus> ;
    skos:inScheme onto: ;
    skos:note "A stream of datasets which contain one timestamped, named graph. The definition is based on the draft RSP Data model: https://streamreasoning.org/RSP-QL/Abstract%20Syntax%20and%20Semantics%20Document/"@en ;
    skos:prefLabel "Timestamped RDF named graph stream"@en ;
    ns1:canBeFlattenedInto ns1:flatQuadStream ;
    ns1:hasElementType ns1:dataset .

ns1:namedGraphStream a owl:NamedIndividual,
        skos:Concept,
        ns1:ConcreteRdfStreamType ;
    skos:broader ns1:datasetStream ;
    skos:definition "An RDF named graph stream is an RDF dataset stream in which every element has exactly one named RDF graph pair <n, G>, where G is an RDF graph, and n is the graph name. Apart from graph G, the dataset may contain any number of triples in the default graph."@en ;
    skos:example <https://w3id.org/np/RAxK3wEoSabXMV2_s24gd27O8rzsUFceYeMKn5s04cnkk> ;
    skos:inScheme onto: ;
    skos:narrower ns1:timestampedNamedGraphStream ;
    skos:note "A stream of datasets which have one named graph."@en ;
    skos:prefLabel "RDF named graph stream"@en ;
    ns1:canBeFlattenedInto ns1:flatQuadStream ;
    ns1:hasElementType ns1:dataset .

ns1:quad a owl:NamedIndividual,
        ns1:RdfElementType ;
    skos:definition <https://www.w3.org/TR/2023/WD-rdf12-concepts-20231013/#section-dataset-quad> ;
    skos:note "RDF quad, as defined by the RDF 1.2 Concepts and Abstract Syntax W3C Working Draft 13 October 2023."@en ;
    skos:prefLabel "RDF quad"@en .

ns1:triple a owl:NamedIndividual,
        ns1:RdfElementType ;
    skos:definition <https://www.w3.org/TR/rdf11-concepts/#section-triples> ;
    skos:note "RDF triple, as defined by the RDF 1.1 Concepts and Abstract Syntax W3C Recommendation."@en ;
    skos:prefLabel "RDF triple"@en .

ns1:AbstractRdfStreamType a owl:Class ;
    rdfs:label "Abstract RDF stream type"@en ;
    rdfs:comment "Class for abstract RDF stream types in the taxonomy. Instances of this class have abstract definitions, i.e., they cannot be used to annotate real streams. They are only intended to be used for reasoning about stream types."@en ;
    rdfs:subClassOf ns1:RdfStreamType ;
    owl:disjointWith ns1:ConcreteRdfStreamType .

ns1:RdfStreamType a owl:Class ;
    rdfs:label "RDF stream type"@en ;
    rdfs:comment "Base class for RDF stream types. This class should not be used directly – use instead either stax:AbstractRdfStreamType or stax:ConcreteRdfStreamType."@en ;
    rdfs:subClassOf skos:Concept .

ns1:RdfStreamTypeUsage a owl:Class ;
    rdfs:label "RDF stream type usage"@en ;
    rdfs:comment "Class for instances of using an RDF stream type, in a program, an academic paper, or elsewhere. This class is suitable for annotating both theoretical uses and practical ones, i.e., real streams or datasets.\\n\\nInstances of this class should have the stax:hasStreamType property pointing to a concrete stream type. The stax:usedIn property is recommended to indicate where the stream is used – alternatively you can use its inverse (stax:hasStreamTypeUsage). The use of other properties (e.g., rdfs:label, rdfs:comment) is encouraged to give more context about the usage.\\n\\nNote that \"stream type usage\" is a subjective assertion and instances of this class may be annotated with additional provenance properties to explain who made the assertion. There can be multiple views on what type of stream is in use, depending on the involved actor, processing step, etc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:ConcreteRdfStreamType ;
            owl:onProperty ns1:hasStreamType ] ;
    skos:example <https://w3id.org/stax/dev/use-it/> .

ns1:flatStream a owl:NamedIndividual,
        skos:Concept,
        ns1:AbstractRdfStreamType ;
    skos:broader ns1:rdfStream ;
    skos:definition "A flat RDF stream is an RDF stream whose elements are statements (either RDF triples or RDF quads)."@en ;
    skos:inScheme onto: ;
    skos:narrower ns1:flatQuadStream,
        ns1:flatTripleStream ;
    skos:note "Abstract flat RDF stream type."@en ;
    skos:prefLabel "Flat RDF stream"@en .

ns1:flatTripleStream a owl:NamedIndividual,
        skos:Concept,
        ns1:ConcreteRdfStreamType ;
    skos:broader ns1:flatStream ;
    skos:definition "A flat RDF triple stream is a flat RDF stream whose elements are triples."@en ;
    skos:example <https://w3id.org/np/RAelRRiQeq2oSXNR-qqrB5dQ6g7Lait55srza_sfz6Jzs>,
        <https://w3id.org/np/RAsiMOcZpJwtQVyiIBvn5-K1AvCcXmU8axm9VY4A7AY-k> ;
    skos:inScheme onto: ;
    skos:note "A stream of triple statements."@en ;
    skos:prefLabel "Flat RDF triple stream"@en ;
    ns1:canBeGroupedInto ns1:graphStream ;
    ns1:canBeTriviallyExtendedInto ns1:flatQuadStream ;
    ns1:hasElementType ns1:triple .

ns1:graph a owl:NamedIndividual,
        ns1:RdfElementType ;
    skos:definition <https://www.w3.org/TR/rdf11-concepts/#section-rdf-graph> ;
    skos:note "RDF graph, as defined by the RDF 1.1 Concepts and Abstract Syntax W3C Recommendation."@en ;
    skos:prefLabel "RDF graph"@en ;
    skos:relatedMatch <http://www.w3.org/ns/sparql-service-description#Graph> .

ns1:graphStream a owl:NamedIndividual,
        skos:Concept,
        ns1:ConcreteRdfStreamType ;
    skos:broader ns1:groupedStream ;
    skos:definition "An RDF graph stream is a grouped RDF stream whose elements are unnamed (default) RDF graphs."@en ;
    skos:example <https://w3id.org/np/RA2LEhdLOYY_c9YgGIwu9TrzHVFPQcpE2vMnAbPghQY60>,
        <https://w3id.org/np/RA9jYlusATe999AN0jb6fn4eR_H4Q23xhnwU4xSwuUxQw> ;
    skos:inScheme onto: ;
    skos:narrower ns1:subjectGraphStream ;
    skos:note "A stream of RDF graphs."@en ;
    skos:prefLabel "RDF graph stream"@en ;
    ns1:canBeFlattenedInto ns1:flatTripleStream ;
    ns1:canBeTriviallyExtendedInto ns1:datasetStream ;
    ns1:hasElementType ns1:graph .

ns1:groupedStream a owl:NamedIndividual,
        skos:Concept,
        ns1:AbstractRdfStreamType ;
    skos:broader ns1:rdfStream ;
    skos:definition "A grouped RDF stream is an RDF stream whose elements are either RDF graphs or RDF datasets."@en ;
    skos:inScheme onto: ;
    skos:narrower ns1:datasetStream,
        ns1:graphStream ;
    skos:note "Abstract grouped RDF stream type."@en ;
    skos:prefLabel "Grouped RDF stream"@en .

ns1:hasElementType a owl:ObjectProperty ;
    rdfs:label "has element type"@en ;
    rdfs:comment "For an RDF stream type, indicates the base (primitive) type of elements in the stream (e.g., triple, quad, graph, dataset)."@en ;
    rdfs:domain ns1:ConcreteRdfStreamType ;
    rdfs:range ns1:RdfElementType ;
    owl:propertyChainAxiom ( skos:broaderTransitive ns1:hasElementType ) .

ns1:rdfStream a owl:NamedIndividual,
        skos:Concept,
        ns1:AbstractRdfStreamType ;
    skos:definition "An RDF stream is an ordered, potentially infinite sequence of RDF stream elements."@en ;
    skos:narrower ns1:flatStream,
        ns1:groupedStream ;
    skos:note "Base abstract RDF stream type."@en ;
    skos:prefLabel "RDF stream"@en ;
    skos:topConceptOf onto: .

ns1:streamTypeSemanticRelation a owl:ObjectProperty ;
    rdfs:label "is in stream type semantic relation with"@en ;
    rdfs:comment "This property should not be used directly, but as a super-property for all properties denoting a relationship of meaning between RDF stream types."@en ;
    rdfs:domain ns1:ConcreteRdfStreamType ;
    rdfs:range ns1:ConcreteRdfStreamType ;
    rdfs:subPropertyOf skos:semanticRelation .

ns1:dataset a owl:NamedIndividual,
        ns1:RdfElementType ;
    skos:definition <https://www.w3.org/TR/rdf11-concepts/#section-dataset> ;
    skos:note "RDF dataset, as defined by the RDF 1.1 Concepts and Abstract Syntax W3C Recommendation."@en ;
    skos:prefLabel "RDF dataset"@en ;
    skos:relatedMatch <http://www.w3.org/ns/sparql-service-description#Dataset> .

ns1:datasetStream a owl:NamedIndividual,
        skos:Concept,
        ns1:ConcreteRdfStreamType ;
    skos:broader ns1:groupedStream ;
    skos:definition "An RDF dataset stream is a grouped RDF stream whose elements are RDF datasets."@en ;
    skos:example <https://w3id.org/np/RAcku4ZQ6KWKFF2uLthK3mqCCNfWbrEeN643SVXwjXseE>,
        <https://w3id.org/np/RAq7ctp_pHq3u76I54CU9S4WA4L9wQFCnmj3DJyrfrL58> ;
    skos:inScheme onto: ;
    skos:narrower ns1:namedGraphStream ;
    skos:note "A stream of RDF datasets."@en ;
    skos:prefLabel "RDF dataset stream"@en ;
    ns1:canBeFlattenedInto ns1:flatQuadStream ;
    ns1:hasElementType ns1:dataset .

ns1:flatQuadStream a owl:NamedIndividual,
        skos:Concept,
        ns1:ConcreteRdfStreamType ;
    skos:broader ns1:flatStream ;
    skos:definition "A flat RDF quad stream is a flat RDF stream whose elements are quads."@en ;
    skos:example <https://w3id.org/np/RAZIs-6LyJuxrn-osVbEdxEoXmGsC1g-8m3n8LYAZ6sUI> ;
    skos:inScheme onto: ;
    skos:note "A stream of quad statements."@en ;
    skos:prefLabel "Flat RDF quad stream"@en ;
    ns1:canBeGroupedInto ns1:datasetStream ;
    ns1:hasElementType ns1:quad .

ns1:RdfElementType a owl:Class ;
    rdfs:label "RDF element type"@en ;
    rdfs:comment "Class for base types of elements in RDF streams. There are four instances of this class (triple, quad, graph, dataset) and they should not be further specialized. The instances of this class do NOT form a taxonomical structure."@en ;
    owl:disjointWith ns1:RdfStreamType ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:dataset ns1:graph ns1:quad ns1:triple ) ] .

onto: a owl:NamedIndividual,
        owl:Ontology,
        skos:ConceptScheme ;
    dc:description "RDF-STaX is an OWL 2 DL ontology that enables describing the types of RDF streams and defines relations between them."@en ;
    dc:title "RDF Stream Taxonomy (RDF-STaX)"@en ;
    dcterms:contributor [ foaf:homepage <https://orcid.org/0000-0003-0869-3836> ;
            foaf:name "Paweł Szmeja" ] ;
    dcterms:created "2023-10-22T00:00:00"^^xsd:dateTime ;
    dcterms:creator [ foaf:homepage <https://orcid.org/0000-0002-2543-9461> ;
            foaf:name "Piotr Sowiński" ;
            foaf:nick "Ostrzyciel" ] ;
    dcterms:issued "2023-10-23T00:00:00"^^xsd:dateTime ;
    dcterms:license <https://spdx.org/licenses/CC-BY-4.0> ;
    dcterms:modified "2023-12-28T14:39:50"^^xsd:dateTime ;
    dcterms:publisher <https://orcid.org/0000-0002-2543-9461> ;
    dcterms:source <https://github.com/RDF-STaX/rdf-stax.github.io/tree/main> ;
    ns3:status <http://purl.org/ontology/bibo/status/published> ;
    vann:preferredNamespacePrefix "stax" ;
    vann:preferredNamespaceUri ns1: ;
    ns2:citation "Please cite this ontology according to the instructions here: https://w3id.org/stax/dev/licensing/"@en ;
    owl:imports <http://www.w3.org/TR/skos-reference/skos-owl1-dl.rdf> ;
    owl:versionIRI <https://w3id.org/stax/dev/ontology> ;
    owl:versionInfo "dev" ;
    skos:altLabel "RDF-STaX"@en ;
    skos:hasTopConcept ns1:rdfStream ;
    skos:prefLabel "RDF Stream Taxonomy"@en ;
    foaf:homepage <https://w3id.org/stax/dev> ;
    foaf:logo <https://w3id.org/stax/dev/assets/logo_color.svg> .

ns1:ConcreteRdfStreamType a owl:Class ;
    rdfs:label "Concrete RDF stream type"@en ;
    rdfs:comment "Class for the concrete RDF stream types in the taxonomy. Instances of this class have concrete definitions, and they can be used to annotate real streams."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:RdfElementType ;
            owl:onProperty ns1:hasElementType ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasElementType ;
            owl:someValuesFrom ns1:RdfElementType ],
        ns1:RdfStreamType .

