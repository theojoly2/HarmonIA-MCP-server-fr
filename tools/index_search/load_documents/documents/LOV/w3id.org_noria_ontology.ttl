@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://purl.org/ontology/bibo/> .
@prefix onto: <https://w3id.org/noria/ontology/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/devops-infra/product#ServiceInstance> owl:equivalentClass onto:Service .

foaf:depiction a owl:AnnotationProperty .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual,
        owl:Ontology ;
    dcterms:creator "Lionel Tailhardat (https://orcid.org/0000-0001-5887-899X)",
        "Raphaël Troncy (https://orcid.org/0000-0003-0457-1436)",
        "Yoan Chabot (https://orcid.org/0000-0001-5639-1504)" ;
    dcterms:description "The NORIA-O project is a data model for IT networks, events and operations information.\\nThe ontology is developed using web technologies (e.g. RDF, OWL, SKOS) and is intended as a structure for realizing an IT Service Management (ITSM) Knowledge Graph (KG) for Anomaly Detection (AD) and Risk Management applications.\\nThe model has been developed in collaboration with operational teams, and in connection with third parties linked vocabularies.\\n\\nAlignment with third parties vocabularies is implemented on a per class or per property basis when relevant (e.g. with `rdfs:subClassOf`, `owl:equivalentClass`).\\nDirections for direct instanciation of these vocabularies are provided for cases where implementing a class/property alignment is redundant.\\nAlignment holds for the following vocabulary releases:\\n- [BBO](https://hal.archives-ouvertes.fr/hal-02365012/) 1.0.0\\n- [BOT](https://w3id.org/bot/) 0.3.2\\n- [DevOps-Infra](https://oeg-upm.github.io/devops-infra/) 1.0.0\\n- [FOLIO](https://github.com/IBCNServices/Folio-Ontology) 1.0.0\\n- [ORG](https://www.w3.org/TR/vocab-org/) 0.8\\n- [PEP](https://w3id.org/pep/) 1.1\\n- [SEAS](https://w3id.org/seas/) 1.1\\n- [SLOGERT](https://sepses.ifs.tuwien.ac.at/ns/log/index-en.html) 1.1.0\\n- [UCO](https://github.com/ucoProject/uco) Release-0.8.0\\n"@en ;
    dcterms:issued "2022-05-10"^^xsd:date ;
    dcterms:license <https://spdx.org/licenses/BSD-4-Clause> ;
    dcterms:modified "2022-12-15"^^xsd:date ;
    dcterms:publisher <https://www.orange.com/> ;
    dcterms:title "The NORIA Ontology"@en ;
    ns2:status <http://purl.org/ontology/bibo/status/nonPeerReviewed> ;
    vann:preferredNamespacePrefix "noria" ;
    vann:preferredNamespaceUri "https://w3id.org/noria/ontology/" ;
    rdfs:seeAlso <https://w3id.org/noria/doc/> ;
    owl:imports onto:ApplicationOntology-0.2,
        onto:CoreOntology-0.2,
        onto:DocumentOntology-0.2,
        onto:LocationOntology-0.2,
        onto:NotificationOntology-0.2,
        onto:ObservableOntology-0.2,
        onto:ResourceOntology-0.2 ;
    owl:incompatibleWith onto:noria-0.1 ;
    owl:priorVersion onto:noria-0.1 ;
    owl:versionIRI onto:noria-0.2 ;
    owl:versionInfo "v0.2" ;
    foaf:depiction <https://github.com/Orange-OpenSource/noria-ontology/raw/master/dataset/noria-0.2/noria-ontology-UC.pnghttps://raw.githubusercontent.com/Orange-OpenSource/noria-ontology/master/dataset/noria-0.2/noria-ontology-UC.png> .

onto:AnomalyPattern a owl:Class ;
    rdfs:label "AnomalyPattern" ;
    rdfs:comment "An abstract class for grouping observables and events that, when satisfied by the existence of some instance/value, represents the occurrence of a (complex) fault/failure mode."@en ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:subClassOf <http://IBCNServices.github.io/Folio-Ontology/Folio.owl#FailureMode>,
        onto:ProceduralObject ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- Renamed AnomalyPattern from AnomalyMode.\\n- Adding rdfs:subClassOf folio:FailureMode.\\n" .

onto:CorporateUserIdentifier a owl:Class ;
    rdfs:label "CUid" ;
    rdfs:comment "The Corporate User Identifier (CUid) is the unique identifier of a Person as a member of Organization (i.e. an Employee). It is also the main account of this Person for connecting to the organization's IT resources, including to its personal computer (PC).\\n\\nAlignment:\\n- *FOAF*:\\n  - The `foaf:accountName` allows for asserting the login identifier of an instance of this class.\\n  - The `foaf:holdsAccount` property allows for relating an employee entity to an instance of this class.\\n- *UCO*:\\n  - A CUid is equivalent to a `observable:UserAccount`.\\n  - The `observable:accountLogin` and `observable:accountIdentifier` can be used in parallel to `foaf:accountName` for asserting the the login identifier.\\n  - The Person (`foaf:Agent`) holding this CUid is also a `observable:Contact`.\\n"@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subClassOf foaf:OnlineAccount,
        <https://unifiedcyberontology.org/ontology/uco/observable#UserAccount> ;
    ns1:term_status "stable" ;
    skos:changeNote "Change in v0.2:\\n- alignment with foaf of the previously available noria:employeeId property." .

onto:DocumentAttachment a owl:Class ;
    rdfs:label "DocumentAttachment" ;
    rdfs:comment "A file attachment.\\n\\nAlignment:\\n- *DCMI*: from the DCMI Abstract Model perspective, a DocumentAttachment is a described resource, hence DC terms apply:\\n  - troubleTicketAttachmentForTicket <=> http://purl.org/dc/terms/isPartOf : The TroubleTicket this file is part of.\\n  - changeRequestAttachment <=> http://purl.org/dc/terms/isPartOf : The TroubleTicket this file is part of.\\n- *BBO*: a DocumentAttachment is a DocumentResource in the sense that it is the result of the Incident Management Process (IMP) or Change Management Process (CMP) and can be used as an input for another activity. From the BPMN 2.0 perspective, a DocumentAttachment is a DataObject.\\n    "@en ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:subClassOf onto:DynamicElement,
        <https://www.irit.fr/recherches/MELODI/ontologies/BBO#DocumentResource> ;
    ns1:term_status "unstable" ;
    skos:example "Picture of broken device, scanning of a bill or charge, network diagram, operation plan, location map." .

onto:ProceduralElement a owl:Class ;
    rdfs:label "ProceduralElement"@en ;
    rdfs:comment "Abstract class for (predeﬁned/computed) operational process (a.k.a. *Procedural facet*)."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subClassOf onto:ManagedElement ;
    ns1:term_status "stable" ;
    skos:example "Incident diagnosis procedure, cyber attack scenario, network route fail-over algorithm"@en .

onto:Room a owl:Class ;
    rdfs:label "Room" ;
    rdfs:comment "A part of the physical world or a virtual world whose 3D spatial extent is bounded actually or theoretically, and provides for certain functions within the zone it is contained in.\\n\\nAlignment:\\n- *BOT*: A Room is a specialization of a `bot:Space` for common sense understanding.\\n"@en ;
    rdfs:isDefinedBy onto:LocationOntology ;
    rdfs:seeAlso <https://w3id.org/bot#Space> ;
    rdfs:subClassOf <https://w3id.org/bot#Space> ;
    ns1:term_status "stable" ;
    skos:example "Server room 314"@en,
        "SALLE STOCKAGE RESEAU 314"@fr .

onto:StructuralObservable a owl:Class ;
    rdfs:label "StructuralObservable"@en ;
    rdfs:comment "An abstract class for ICT systems's properties that should be defined as classes for extended description capability."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subClassOf onto:Property ;
    ns1:term_status "unstable" ;
    skos:example "Time context of the observable value"@en .

onto:actionCorrelatedOperationPlan a owl:ObjectProperty ;
    rdfs:label "actionCorrelatedOperationPlan" ;
    rdfs:comment "The Operation Plan (procedure) guiding the execution of the given Action."@en ;
    rdfs:domain onto:ChangeAction,
        onto:CorrectiveMaintenanceAction ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range onto:OperationPlan ;
    rdfs:subPropertyOf <https://w3id.org/pep/usedProcedure> ;
    ns1:term_status "unstable" .

onto:agentInstructions a owl:DatatypeProperty ;
    rdfs:label "agentInstructions" ;
    rdfs:comment "Instructions for involving the Agent (Team, Group, Employee)."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" ;
    skos:changeNote "Change in v0.2:\\n- rdfs:domain moved from noria:Employee to foaf:Agent.\\n- name and label moved from teamInstructions to agentInstructions.\\n- adding rdfs:subPropertyOf observable:contactNote.\\n" ;
    skos:example "Use the Ticketing system + hotline phone number for national L2 and L3 issues."@en .

onto:agentManagesResource a owl:ObjectProperty ;
    rdfs:label "agentManagesResource" ;
    rdfs:comment "The Network Element (IT Resource) the Agent is responsible of (supervises).\\n\\nAlignment:\\n- *FOAF*: A team may be interested into following the state of some resources, hence this property is semantically akin to `foaf:topic_interest`.\\n"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:subPropertyOf foaf:topic_interest ;
    owl:inverseOf onto:resourceManagedBy ;
    ns1:term_status "stable" ;
    skos:changeNote "Change in v0.2:\\n- rdfs:domain moved from noria:Employee to foaf:Agent.\\n- name and label moved from teamManagesResource to agentManagesResource.\\n- Removing rdfs:range noria:Resource for noria:Resource and noria:NetworkLink compatibility." .

onto:agentPreferredContactMethod a owl:ObjectProperty ;
    rdfs:label "agentPreferredContactMethod" ;
    rdfs:comment "The preferred contact method to reach the Agent (Team, Group, Employee)."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/org/agent-contact-method> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    ns1:term_status "stable" ;
    skos:changeNote "Change in v0.2:\\n- rdfs:domain moved from noria:Employee to foaf:Agent.\\n- name and label moved from employeePreferredContactMethod to agentPreferredContactMethod.\\n- adding rdfs:subPropertyOf observable:contactNote.\\n" ;
    skos:example "Phone, e-mail"@en .

onto:agentWorkingHours a owl:DatatypeProperty ;
    rdfs:label "agentWorkingHours" ;
    rdfs:comment "The Working Hours for reaching the Agent (Team, Employee, etc.)."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable" ;
    skos:changeNote "Change in v0.2:\\n- rdfs:domain moved from noria:Employee to foaf:Agent.\\n- name and label moved from teamWorkingHours to agentWorkingHours." ;
    skos:example "8:00 am - 12:00 am / 1:00 pm - 5:30 pm (Mon --> Fri)"@en,
        "8H-12H/13H-17H30 (lun --> ven)"@fr .

onto:alarmMitigatedBy a owl:ObjectProperty ;
    rdfs:label "alarmMitigatedBy" ;
    rdfs:comment "The ProcedureExecutionContainer (i.e. the set of Procedure Execution(s)) that led to clear the alarm and/or solve the issue.\\n\\nThis allows, for example, the timely reporting of changing conditions prevalent at the time of the alarm."@en ;
    rdfs:domain onto:EventRecord ;
    rdfs:isDefinedBy onto:NotificationOntology ;
    rdfs:range <https://w3id.org/pep/ProcedureExecutionContainer> ;
    ns1:term_status "stable" ;
    skos:example "ProcedureExecutionContainer(x)\\n    .ldp:member EventRecord(y)\\n        .hasCommand='ip address 10.1.5.1 255.255.255.0'\\n        .hasResult='SYS-5-CONFIG_I: Configured from console by vty2 (10.34.195.36)'\\n" .

onto:alarmMonitoredAttribute a owl:ObjectProperty ;
    rdfs:label "alarmMonitoredAttribute" ;
    rdfs:comment "The Monitored attributes parameter, when present, defines one or more attributes of the managed object and their corresponding values at the time of the alarm.\\nManaged object definers may specify the set of attributes which are of interest, if any.\\nThis allows, for example, the timely reporting of changing conditions prevalent at the time of the alarm.\\n"@en ;
    rdfs:domain onto:EventRecord ;
    rdfs:isDefinedBy onto:NotificationOntology,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-monitoredAttributes>,
        <https://www.itu.int/rec/T-REC-X.733-199202-I/> ;
    ns1:term_status "unstable" .

onto:alarmProposedRepairAction a owl:ObjectProperty ;
    rdfs:label "alarmProposedRepairAction" ;
    rdfs:comment "This parameter, when present, is used if the cause is known and the system being managed can suggest one or more solutions.\\nThis parameter is a set of possibilities specified by the object class definer.\\n"@en ;
    rdfs:domain onto:EventRecord ;
    rdfs:isDefinedBy onto:NotificationOntology,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-proposedRepairActions>,
        <https://www.itu.int/rec/T-REC-X.733-199202-I/> ;
    rdfs:range <https://w3id.org/pep/Procedure> ;
    ns1:term_status "stable" ;
    skos:example "Switch to standby equipment, retry to connect, replace media, etc."@en .

onto:alarmSeverity a owl:ObjectProperty ;
    rdfs:label "alarmSeverity" ;
    rdfs:comment "Indication of how it is perceived that the capability of the managed object has been affected, or how serious are the service affecting conditions (including for security alarms)."@en ;
    rdfs:domain onto:EventRecord ;
    rdfs:isDefinedBy onto:NotificationOntology,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-perceivedSeverity>,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-securityAlarmSeverity>,
        <https://www.itu.int/rec/T-REC-X.733-199202-I/> ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/Notification/Severity/PerceivedSeverity> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf <http://IBCNServices.github.io/Folio-Ontology/Folio.owl#hasCriticality>,
        dcterms:type ;
    ns1:term_status "stable" ;
    skos:changeNote "Changes in v0.2:\\n- Changed owl:hasValue restriction to <Notification/Severity/PerceivedSeverity> in place of <Notification/PerceivedSeverity>.\\n- Adding rdfs:subPropertyOf dcterms:type.\\n- Adding rdfs:subPropertyOf folio:hasCriticality.\\n- Merging the noria:securityAlarmSeverity.\\n" ;
    skos:example "Critical, Major, Minor, Warning."@en .

onto:applicationBusinessImportance a owl:ObjectProperty ;
    rdfs:label "applicationBusinessImportance" ;
    rdfs:comment "The importance of the Application from the business impact perspective for risk assessment analysis and incident management prioritization."@en ;
    rdfs:domain onto:Application ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/application/business-importance> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    ns1:term_status "unstable" ;
    skos:changeNote "Introduced in v0.2" .

onto:applicationFunctionalDomain a owl:DatatypeProperty ;
    rdfs:label "applicationFunctionalDomain" ;
    rdfs:comment "The functional domain of the Application for describing the organization’s activities from a system point of view.\\n\\nAlignment:\\n- *tmforum*: the `noria:applicationFunctionalDomain` is equivalent to the *Domain* concept of the ODA Functional Framework.\\n"@en ;
    rdfs:domain onto:Application ;
    rdfs:isDefinedBy onto:ApplicationOntology,
        <https://www.tmforum.org/oda/information-systems/information-framework-sid/> ;
    ns1:term_status "unstable" ;
    skos:changeNote "Introduced in v0.2" ;
    skos:example "- Market and Customer Relationship Management domain\\n- Service Development, Management and Operations\\n- Resource Development, Management and Operations" .

onto:applicationFunctionalSubDomain a owl:DatatypeProperty ;
    rdfs:label "applicationFunctionalSubDomain" ;
    rdfs:comment "The functional sub-domain of the Application for describing the organization’s activities from a system point of view.\\n\\nAlignment:\\n- *tmforum*: the `noria:applicationFunctionalSubDomain` is equivalent to *Aggregate Business Entities* (ABEs) and *Business Entities* (BEs) of the ODA Functional Framework.\\n"@en ;
    rdfs:domain onto:Application ;
    rdfs:isDefinedBy onto:ApplicationOntology,
        <https://www.tmforum.org/oda/information-systems/information-framework-sid/> ;
    ns1:term_status "unstable" ;
    skos:changeNote "Introduced in v0.2" ;
    skos:example "- Human Resource Management\\n- Offer and Product Operational Analysis\\n- Resource Repository Management" .

onto:applicationModelIdentifier a owl:DatatypeProperty ;
    rdfs:label "applicationModelIdentifier" ;
    rdfs:comment "Application model code."@en ;
    rdfs:domain onto:Application ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "stable" .

onto:applicationModuleAdministrationLeader a owl:ObjectProperty ;
    rdfs:label "applicationModuleAdministrationLeader" ;
    rdfs:comment "Administration leader."@en,
        "Responsable de l'entité exploitante."@fr ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf onto:applicationModuleRelatedParty ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- rdfs:range foaf:Agent in place of noria:Employee.\\n" .

onto:applicationModuleAdministrationTeam a owl:ObjectProperty ;
    rdfs:label "applicationModuleAdministrationTeam" ;
    rdfs:comment "Administration team."@en,
        "Entité exploitante."@fr ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range org:OrganizationalUnit ;
    rdfs:subPropertyOf onto:applicationModuleRelatedParty ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- rdfs:range org:OrganizationalUnit in place of noria:Team.\\n" .

onto:applicationModuleHotlineEnabled a owl:DatatypeProperty ;
    rdfs:label "applicationModuleHotlineEnabled" ;
    rdfs:comment "Hotline enabled for issues on a given ApplicationModule."@en,
        "Possibilité d'appel de l'astreinte applicative."@fr ;
    rdfs:domain onto:ApplicationModule ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range xsd:boolean ;
    ns1:term_status "unstable" .

onto:applicationModuleHotlineGroup a owl:ObjectProperty ;
    rdfs:label "applicationModuleHotlineGroup" ;
    rdfs:comment "Hotline team."@en,
        "Equipe d'astreinte applicative."@fr ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range org:OrganizationalUnit ;
    rdfs:subPropertyOf onto:applicationModuleRelatedParty ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- rdfs:range org:OrganizationalUnit in place of noria:Team.\\n" .

onto:applicationModuleIdentifier a owl:DatatypeProperty ;
    rdfs:label "applicationModuleIdentifier"@en ;
    rdfs:comment "Application module code."@en ;
    rdfs:domain onto:ApplicationModule ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "stable" .

onto:applicationModuleName a owl:DatatypeProperty ;
    rdfs:label "applicationModuleName" ;
    rdfs:comment "The name of the Application module."@en ;
    rdfs:domain onto:ApplicationModule ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:functionalElementDistinguishedName ;
    ns1:term_status "stable" ;
    skos:example "CONCAT(\\n    Application().applicationModelIdentifier(),\\n    \"_\",\\n    ApplicationModule().applicationModuleIdentifier()\\n)"@en .

onto:applicationModuleOf a owl:ObjectProperty ;
    rdfs:label "applicationModuleOf" ;
    rdfs:comment "A child/parent relationship between a specific and managed instance of an Application (i.e. an Application Module) and the Application."@en ;
    rdfs:domain onto:ApplicationModule ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:subPropertyOf <https://w3id.org/seas/subSystemOf> ;
    ns1:term_status "stable" .

onto:applicationModuleSlaLevel a owl:ObjectProperty ;
    rdfs:label "applicationModuleSlaLevel" ;
    rdfs:comment "SLA level."@en,
        "Niveau de service."@fr ;
    rdfs:domain onto:ApplicationModule ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/application/sla-level> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    ns1:term_status "unstable" .

onto:applicationModuleSlaLevelDate a owl:DatatypeProperty ;
    rdfs:label "applicationModuleSlaLevelDate" ;
    rdfs:comment "SLA Level date, the date at which the SLA Level has been set or updated."@en,
        "Date du Niveau de service."@fr ;
    rdfs:domain onto:ApplicationModule ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:subPropertyOf time:inXSDDateTimeStamp ;
    ns1:term_status "unstable" .

onto:applicationModuleStatus a owl:ObjectProperty ;
    rdfs:label "applicationModuleStatus" ;
    rdfs:comment "Status of the Application Module."@en,
        "Etat de service du Module Applicatif."@fr ;
    rdfs:domain onto:ApplicationModule ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/application/status> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    ns1:term_status "unstable" ;
    skos:example "In Production"@en,
        "En Production"@fr .

onto:applicationModuleSupportGroup a owl:ObjectProperty ;
    rdfs:label "applicationModuleSupportGroup" ;
    rdfs:comment "Level 1 support team."@en,
        "Entité support: Point d'Entrée Interface Technique (PEIT) - Exploitant N1."@fr ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range org:OrganizationalUnit ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- rdfs:range org:OrganizationalUnit in place of noria:Team.\\n" .

onto:applicationModuleSupportLeader a owl:ObjectProperty ;
    rdfs:label "applicationModuleSupportLeader" ;
    rdfs:comment "Support leader."@en,
        "Responsable de l'entité support."@fr ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf onto:applicationModuleRelatedParty ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- rdfs:range foaf:Agent in place of noria:Employee.\\n" .

onto:applicationModuleSupportTeam a owl:ObjectProperty ;
    rdfs:label "applicationModuleSupportTeam" ;
    rdfs:comment "Level 2 Support Team."@en,
        "Entité support : Soutien Applicatif Technique (SAT) - Exploitant N2."@fr ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range org:OrganizationalUnit ;
    rdfs:subPropertyOf onto:applicationModuleRelatedParty ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- rdfs:range org:OrganizationalUnit in place of noria:Team.\\n" .

onto:applicationNumericalIdentifier a owl:DatatypeProperty ;
    rdfs:label "applicationNumericalIdentifier" ;
    rdfs:comment "Application numerical identifier, the numerical identifier of the Application within the Information System."@en ;
    rdfs:domain onto:Application ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "unstable" .

onto:applicationShortIdentifier a owl:DatatypeProperty ;
    rdfs:label "applicationShortIdentifier" ;
    rdfs:comment "Application short identifier, a short string identifier of Application within the Information System."@en ;
    rdfs:domain onto:Application ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier,
        onto:functionalElementDistinguishedName ;
    ns1:term_status "stable" .

onto:applicationType a owl:ObjectProperty ;
    rdfs:label "applicationType" ;
    rdfs:comment "The type of the Application."@en ;
    rdfs:domain onto:Application ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/application/type> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" .

onto:changeRequestActorParty a owl:ObjectProperty ;
    rdfs:label "changeRequestActorParty" ;
    rdfs:comment "The actor of the Change Request."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf dcterms:contributor,
        onto:changeRequestRelatedParty ;
    ns1:term_status "stable" .

onto:changeRequestActualEndTime a owl:DatatypeProperty ;
    rdfs:label "changeRequestActualEndTime" ;
    rdfs:comment "Date and time on which the Change Request implementation has been completed. It is displayed only after the Change Request implementation has been completed actually."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "stable" .

onto:changeRequestActualStartTime a owl:DatatypeProperty ;
    rdfs:label "changeRequestActualStartTime" ;
    rdfs:comment "Date and time on which the Change Request implementation has started. It is displayed only after the Change Request implementation has started actually."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "stable" .

onto:changeRequestCategory a owl:ObjectProperty ;
    rdfs:label "changeRequestCategory" ;
    rdfs:comment "Nature of the Change Request"@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/ChangeRequest/category> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Internal intervention, Third party intervention, Customer intervention, Change requested by customer"@en .

onto:changeRequestChangeCause a owl:ObjectProperty ;
    rdfs:label "changeRequestChangeCause" ;
    rdfs:comment "Cause of (reason for) the Change Request."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/ChangeRequest/cause> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Configuration, Preventative maintenance, Software upgrade, Network extension, etc."@en .

onto:changeRequestImpact a owl:ObjectProperty ;
    rdfs:label "changeRequestImpact" ;
    rdfs:comment "Set of physical/logical entities on which the Change Request is carried-out."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range onto:Application,
        onto:ApplicationModule,
        onto:Resource,
        onto:Service ;
    rdfs:subPropertyOf dcterms:relation,
        onto:eventRelatedElement ;
    ns1:term_status "stable" ;
    skos:example "Resource(s), Application(s), Service(s)"@en .

onto:changeRequestInitiatorParty a owl:ObjectProperty ;
    rdfs:label "changeRequestInitiatorParty" ;
    rdfs:comment "The agent initiating the Change Request."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf dcterms:contributor,
        onto:changeRequestRelatedParty ;
    ns1:term_status "stable" .

onto:changeRequestIsRegulated a owl:DatatypeProperty ;
    rdfs:label "changeRequestIsRegulated" ;
    rdfs:comment "If *true*, the Change Request is subject to special regulations."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:boolean ;
    ns1:term_status "unstable" .

onto:changeRequestOutageDuration a owl:DatatypeProperty ;
    rdfs:label "changeRequestOutageDuration" ;
    rdfs:comment "Expected duration of the outage, if any involved by the Change Request type."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:duration ;
    rdfs:subPropertyOf dcterms:extent ;
    ns1:term_status "stable" .

onto:changeRequestPilotParty a owl:ObjectProperty ;
    rdfs:label "changeRequestPilotParty" ;
    rdfs:comment "The pilot of the Change Request."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf dcterms:contributor,
        onto:changeRequestRelatedParty ;
    ns1:term_status "stable" .

onto:changeRequestPlannedEndTime a owl:DatatypeProperty ;
    rdfs:label "changeRequestPlannedEndTime" ;
    rdfs:comment "Date and time on which is planned the end of the implementation of the Change Request. It is displayed only before the Change Request implementation is completed."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "stable" .

onto:changeRequestPlannedStartTime a owl:DatatypeProperty ;
    rdfs:label "changeRequestPlannedStartTime" ;
    rdfs:comment "Date and time on which is planned the end of the implementation of the Change Request. It is displayed only before the Change Request implementation is completed."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "stable" .

onto:changeRequestSpecification a owl:ObjectProperty ;
    rdfs:label "changeRequestSpecification" ;
    rdfs:comment "An item of the standard operation plan catalog for recurring activities."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/ChangeRequest/specification> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "unstable" .

onto:changeRequestStatusCurrent a owl:ObjectProperty ;
    rdfs:label "changeRequestStatusCurrent" ;
    rdfs:comment "The current status of the Change Request."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/ChangeRequest/status> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    ns1:term_status "stable" .

onto:changeRequestType a owl:ObjectProperty ;
    rdfs:label "changeRequestType" ;
    rdfs:comment "The type of the request describes the a priori impact and risk level of the Change Request."@en ;
    rdfs:domain onto:ChangeRequest ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/ChangeRequest/type> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" .

onto:clusterController a owl:ObjectProperty ;
    rdfs:label "clusterController" ;
    rdfs:comment "Relates a Resource that is part of a cluster with the cluster controller."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range onto:Resource ;
    rdfs:subPropertyOf <https://w3id.org/seas/subSystemOf> ;
    ns1:term_status "unstable" ;
    skos:changeNote "Introduced in v0.2" ;
    skos:example "Resource(\"cluster-01\").clusterController(\"virtual-center-01\")" .

onto:documentExternalId a owl:DatatypeProperty ;
    rdfs:label "documentExternalId" ;
    rdfs:comment "ID given by the requestor to facilitate the relationship set up and searches afterwards."@en ;
    rdfs:domain onto:ChangeRequest,
        onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "stable" ;
    skos:example "Customer reference, Identifier coming from an external system, etc."@en .

onto:documentHRef a owl:DatatypeProperty ;
    rdfs:label "documentHRef" ;
    rdfs:comment "Hyperlink to the TroubleTicket or ChangeRequest entity in the originating information system."@en ;
    rdfs:domain onto:ChangeRequest,
        onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf dcterms:source ;
    ns1:term_status "stable" .

onto:locatedAtLocus a owl:ObjectProperty ;
    rdfs:label "locatedAtLocus" ;
    rdfs:comment "A uniquely identified space of the Resource within a given Room.\\n\\nAlignment:\\n- *UCO*: This property enables linking a concrete `Resource` instance to some location, hence it relates to `observable:location`.\\n- *BOT*: This property is akin to the inverse of `bot:hasElement`.\\n"@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range onto:Locus ;
    rdfs:subPropertyOf <https://unifiedcyberontology.org/ontology/uco/observable#location> ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:range noria:Locus.\\n- Adding rdfs:subPropertyOf observable:location.\\n" ;
    skos:example "Line: L, Column:6, in Room:Server room 314."@en,
        "Ligne:L, Colonne:6, en Salle:SALLE STOCKAGE RESEAU 314."@fr .

onto:locusLine a owl:DatatypeProperty ;
    rdfs:label "locusLine" ;
    rdfs:comment "The line identifier in a `noria:Room` for a Locus defined by Cartesian coordinates."@en ;
    rdfs:domain onto:Locus ;
    rdfs:isDefinedBy onto:LocationOntology ;
    ns1:term_status "unstable" ;
    skos:changeNote "Addition in v0.2." ;
    skos:example "Line:L, in Room:Server room 314."@en .

onto:locusRow a owl:DatatypeProperty ;
    rdfs:label "locusLine" ;
    rdfs:comment "The row identifier in a `noria:Room` for a Locus defined by Cartesian coordinates."@en ;
    rdfs:domain onto:Locus ;
    rdfs:isDefinedBy onto:LocationOntology ;
    ns1:term_status "unstable" ;
    skos:changeNote "Addition in v0.2." ;
    skos:example "Column:6, in Room:Server room 314."@en .

onto:logOriginatingAgent a owl:ObjectProperty ;
    rdfs:label "logOriginatingAgent" ;
    rdfs:comment "The Agent at the origin of the Log record whenever it represents some action carried out on the ICT system. This includes information about the service user associated with the service request that caused a security alarm."@en ;
    rdfs:domain onto:EventRecord ;
    rdfs:isDefinedBy onto:NotificationOntology,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-serviceUser>,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-sourceIndicator> ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf dcterms:creator,
        prov:wasAttributedTo,
        onto:eventRelatedParty,
        <https://w3id.org/pep/madeBy> ;
    ns1:term_status "stable" ;
    skos:changeNote "Changes in v0.2:\\n- rdfs:range foaf:Agent in place of rdfs:range noria:Employee.\\n- Adding rdfs:subPropertyOf dcterms:creator.\\n- Adding rdfs:subPropertyOf prov:wasAttributedTo.\\n- Merging the noria:alarmServiceUser.\\n" ;
    skos:example "A employee or maintenance bot that carried-out a change or corrective maintenance action. A service user that carried-out SQL Injection."@en .

onto:logOriginatingManagedObject a owl:ObjectProperty ;
    rdfs:label "logOriginatingManagedObject" ;
    rdfs:comment "The Managed Object entity at the origin of the Log record. This includes information about the service provider associated with the service request that caused a security alarm."@en ;
    rdfs:domain onto:EventRecord ;
    rdfs:isDefinedBy onto:NotificationOntology,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-SecurityAlarmDetector>,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-managedObjectInstance>,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-serviceProvider>,
        <https://www.itu.int/rec/T-REC-X.733-199202-I/> ;
    rdfs:range onto:Application,
        onto:Resource ;
    rdfs:subPropertyOf <http://IBCNServices.github.io/Folio-Ontology/Folio.owl#happenedAt>,
        dcterms:creator,
        prov:wasAttributedTo,
        onto:eventRelatedElement,
        <https://w3id.org/pep/madeBy>,
        <https://w3id.org/sepses/ns/log#hasSourceHost> ;
    ns1:term_status "stable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:subPropertyOf dcterms:creator.\\n- Adding rdfs:subPropertyOf prov:wasAttributedTo.\\n- Adding rdfs:subPropertyOf folio:happenedAt.\\n- Adding rdfs:subPropertyOf log:hasSourceHost.\\n- Adding reference to ITU-T X721 SecurityAlarmDetector.\\n- Adding reference to ITU-T X721 serviceProvider.\\n- Merging the noria:serviceProvider.\\n" ;
    skos:example "A named Resource, Application, Security Alarm Detector, etc."@en .

onto:logOriginatingManagementSystem a owl:ObjectProperty ;
    rdfs:label "logOriginatingManagementSystem" ;
    rdfs:comment "The Management System that receives, processes and forwards the Log record."@en ;
    rdfs:domain onto:EventRecord ;
    rdfs:isDefinedBy onto:NotificationOntology ;
    rdfs:range onto:Application ;
    rdfs:subPropertyOf dcterms:creator,
        prov:wasAttributedTo,
        onto:eventRelatedElement ;
    ns1:term_status "stable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:subPropertyOf dcterms:creator.\\n- Adding rdfs:subPropertyOf prov:wasAttributedTo.\\n- Adding rdfs:subPropertyOf noria:eventRelatedElement.\\n" ;
    skos:example "A named instance of Network Management System (NMS), Security Information and Event Monitoring system (SIEM), etc."@en .

onto:logText a owl:DatatypeProperty ;
    rdfs:label "logText" ;
    rdfs:comment "Textual information describing the logged event." ;
    rdfs:domain onto:EventRecord ;
    rdfs:isDefinedBy onto:NotificationOntology,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-additionalText> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title,
        <https://w3id.org/pep/hasSimpleResult>,
        <https://w3id.org/sepses/ns/log#msg> ;
    ns1:term_status "stable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:subPropertyOf dcterms:title.\\n- Adding rdfs:subPropertyOf pep:hasSimpleResult.\\n- Adding rdfs:subPropertyOf log:msg.\\n" .

onto:loggingTime a owl:DatatypeProperty ;
    rdfs:label "loggingTime" ;
    rdfs:comment "The Date on which the log record was created in the system." ;
    rdfs:domain onto:EventRecord ;
    rdfs:isDefinedBy onto:NotificationOntology,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-loggingTime> ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:created,
        <https://w3id.org/sepses/ns/log#time> ;
    ns1:term_status "stable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:subPropertyOf dcterms:created.\\n- Adding rdfs:subPropertyOf log:time.\\n" .

onto:networkInterfaceAdministrativeStatus a owl:ObjectProperty ;
    rdfs:label "networkInterfaceAdministrativeStatus" ;
    rdfs:comment "The administrative status of the Network Interface."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ObservableOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/Resource/AdministrativeState> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf onto:structuralElementObservable ;
    ns1:term_status "stable" ;
    skos:example "up, down" .

onto:networkInterfaceConnects a owl:ObjectProperty ;
    rdfs:label "networkInterfaceConnects" ;
    rdfs:comment "The Network Link the Network Interface is attached-to."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range onto:NetworkLink ;
    rdfs:subPropertyOf <https://w3id.org/seas/connectsSystemAt> ;
    ns1:term_status "stable" .

onto:networkInterfaceDescription a owl:DatatypeProperty ;
    rdfs:label "networkInterfaceDescription" ;
    rdfs:comment "A human-readable/editable text that describes the network interface. The information included in the description depends on the capabilities of the Resource's operating system."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:networkInterfaceLaserRxHighPowerWarningThreshold a owl:DatatypeProperty ;
    rdfs:label "networkInterfaceLaserRxHighPowerWarningThreshold" ;
    rdfs:comment "The high received power notification threshold."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ObservableOntology ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf onto:structuralElementObservableData ;
    ns1:term_status "unstable" .

onto:networkInterfaceLaserRxLowPowerWarningThreshold a owl:DatatypeProperty ;
    rdfs:label "networkInterfaceLaserRxLowPowerWarningThreshold" ;
    rdfs:comment "The low received power notification threshold."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ObservableOntology ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf onto:structuralElementObservableData ;
    ns1:term_status "unstable" .

onto:networkInterfaceLaserRxOpticalPower a owl:DatatypeProperty ;
    rdfs:label "networkInterfaceLaserRxOpticalPower" ;
    rdfs:comment "The received optical power measure of the Network Interface, in dBm."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ObservableOntology ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf onto:structuralElementObservableData ;
    ns1:term_status "unstable" ;
    skos:example "Rx = -3.58 dBm" .

onto:networkInterfaceLaserRxOpticalPowerAverage a owl:DatatypeProperty ;
    rdfs:label "networkInterfaceLaserRxOpticalPowerAverage" ;
    rdfs:comment "The average received optical power of the Network Interface, in dBm."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ObservableOntology ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf onto:structuralElementObservableData ;
    ns1:term_status "unstable" .

onto:networkInterfaceLaserTxOpticalPower a owl:DatatypeProperty ;
    rdfs:label "networkInterfaceLaserTxOpticalPower" ;
    rdfs:comment "The emitted optical power measure of the Network Interface, in dBm."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ObservableOntology ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf onto:structuralElementObservableData ;
    ns1:term_status "unstable" ;
    skos:example "Tx = -2.13 dBm" .

onto:networkInterfaceOf a owl:ObjectProperty ;
    rdfs:label "networkInterfaceOf" ;
    rdfs:comment "The Resource the Network Interface is part-of."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range onto:Resource ;
    rdfs:subPropertyOf <https://w3id.org/seas/connectionPointOf> ;
    ns1:term_status "stable" .

onto:networkInterfaceOperationalStatus a owl:ObjectProperty ;
    rdfs:label "networkInterfaceOperationalStatus" ;
    rdfs:comment "The operational status of the Network Interface."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ObservableOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/Resource/OperationalState> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf onto:structuralElementObservable ;
    ns1:term_status "stable" ;
    skos:example "up, down" .

onto:networkInterfaceRoutingPriorityMetric a owl:DatatypeProperty ;
    rdfs:label "networkInterfaceRoutingPriorityMetric" ;
    rdfs:comment "The metric value associated to the Network Interface for some routing protocol."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ObservableOntology ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf onto:structuralElementObservableData ;
    ns1:term_status "stable" ;
    skos:example "IS-IS route priority=122" .

onto:networkInterfaceType a owl:ObjectProperty ;
    rdfs:label "networkInterfaceType" ;
    rdfs:comment "The type of the Network Interface."@en ;
    rdfs:domain onto:NetworkInterface ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    ns1:term_status "unstable" ;
    skos:example "physical, subinterface, virtual"@en .

onto:networkLinkId a owl:DatatypeProperty ;
    rdfs:label "networkLinkId" ;
    rdfs:comment "The UID of the NetworkLink."@en ;
    rdfs:domain onto:NetworkLink ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "stable" .

onto:networkLinkInstallationDate a owl:DatatypeProperty ;
    rdfs:label "networkLinkInstallationDate" ;
    rdfs:comment "The installation date of the NetworkLink."@en ;
    rdfs:domain onto:NetworkLink ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range xsd:dateTime ;
    ns1:term_status "stable" .

onto:networkLinkTerminationResource a owl:ObjectProperty ;
    rdfs:label "networkLinkTerminationResource" ;
    rdfs:comment "Link termination Resource, the Resource at some end fo the Network Link."@en ;
    rdfs:domain onto:NetworkLink ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range onto:Resource ;
    rdfs:subPropertyOf <https://w3id.org/seas/connectsSystem> ;
    ns1:term_status "stable" .

onto:networkLinkType a owl:DatatypeProperty ;
    rdfs:label "networkLinkType" ;
    rdfs:comment "A description of the type of the Network Link."@en ;
    rdfs:domain onto:NetworkLink ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range xsd:string ;
    ns1:term_status "unstable" .

onto:operationPlanPostCondition a owl:ObjectProperty ;
    rdfs:label "operationPlanPostCondition" ;
    rdfs:comment "The ActionPostCondition to check/that would be observed whenever the OperationPlan is carried out.\\n\\nAlignment:\\n- *PEP*: OperationPlan (Procedures) may be linked to some description of the output, hence `operationPlanPostCondition` is a kind of `pep:hasOutput`.\\n- *BBO*: From the BPMN perspective, the `operationPlanPostCondition` is the description of what should be observed to after the realization of a given Task, hence it is a kind of `BBO:has_completionCondition`.\\n"@en ;
    rdfs:domain onto:OperationPlan ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range onto:ActionPostCondition ;
    rdfs:subPropertyOf <https://w3id.org/pep/hasOutput>,
        <https://www.irit.fr/recherches/MELODI/ontologies/BBO#has_completionCondition> ;
    ns1:term_status "stable" ;
    skos:changeNote "Change in v0.2:\\n- Adding pep:hasOutput.\\n- Adding rdfs:subPropertyOf BBO::has_completionCondition.\\n" .

onto:operationPlanPreCondition a owl:ObjectProperty ;
    rdfs:label "operationPlanPreCondition" ;
    rdfs:comment "The ActionPreCondition to check/that would be checked whenever the OperationPlan will be executed/is executed.\\n\\nAlignment:\\n- *PEP*: OperationPlan (Procedures) may be linked to some description of the input, hence `operationPlanPreCondition` is a kind of `pep:hasInput`.\\n- *BBO*: From the BPMN perspective, the `operationPlanPreCondition` is the description of what may activate the realization of a given Task, hence it is a kind of `BBO:has_activationCondition`.\\n"@en ;
    rdfs:domain onto:OperationPlan ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range onto:ActionPreCondition ;
    rdfs:subPropertyOf <https://w3id.org/pep/hasInput>,
        <https://www.irit.fr/recherches/MELODI/ontologies/BBO#has_activationCondition> ;
    ns1:term_status "stable" ;
    skos:changeNote "Change in v0.2:\\n- Adding pep:hasInput.\\n- Adding rdfs:subPropertyOf BBO::has_activationCondition.\\n" .

onto:problemResponsibility a owl:ObjectProperty ;
    rdfs:label "problemResponsibility"@en ;
    rdfs:comment "The *final* area of responsibility identified for the incident."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/problemResponsibility> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:seeAlso onto:troubleTicketCause ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Customer, Managed access equipment on customer's premises, Managed backbone networks, Managed specific networks, Contract application-hosting services, Ill-defined, etc." .

onto:productManufacturedBy a owl:ObjectProperty ;
    rdfs:label "productManufacturedBy" ;
    rdfs:comment "The Manufacturer of the Product Model."@en ;
    rdfs:domain onto:ProductModel ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range org:Organization ;
    ns1:term_status "stable" ;
    skos:changeNote "Change in v0.2:\\n- property name and label changed from noria:manufacturedBy to noria:productManufacturedBy.\\n- rdfs:range moved from noria:Manufacturer to org:Organization.\\n" .

onto:resourceForApplication a owl:ObjectProperty ;
    rdfs:label "resourceForApplication" ;
    rdfs:comment "The Application this Resource is contributing to, whatever the Application type."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range onto:Application ;
    rdfs:subPropertyOf <https://w3id.org/seas/subSystemOf> ;
    ns1:term_status "stable" ;
    skos:example "Corporate Internet access Infrastructure, Clock synchronization Service"@en .

onto:resourceHostName a owl:DatatypeProperty ;
    rdfs:label "resourceHostName" ;
    rdfs:comment "The hostname (nodename) of the Resource."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Hostname> ;
    rdfs:subPropertyOf dcterms:identifier,
        <https://unifiedcyberontology.org/ontology/uco/observable#hostname>,
        onto:structuralElementDistinguishedName,
        <https://w3id.org/sepses/ns/log#host> ;
    ns1:term_status "stable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:subPropertyOf log:host.\\n- Adding rdfs:subPropertyOf observable:hostname.\\n" .

onto:resourceInstallationDate a owl:DatatypeProperty ;
    rdfs:label "resourceInstallationDate" ;
    rdfs:comment "The installation date of the Resource."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range xsd:dateTime ;
    ns1:term_status "stable" .

onto:resourceLogisticId a owl:DatatypeProperty ;
    rdfs:label "resourceLogisticId" ;
    rdfs:comment "The logistic UID of the Resource (a.k.a. asset tag)."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "stable" .

onto:resourceManagementIPAddress a owl:ObjectProperty ;
    rdfs:label "resourceManagementIPAddress" ;
    rdfs:comment "Specifies the IP address for remote management of the Resource, if relevant."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:subPropertyOf <https://unifiedcyberontology.org/ontology/uco/observable#ipAddress> ;
    ns1:term_status "unstable" ;
    skos:changeNote "Introduced in v0.2" ;
    skos:example "- IPv4: 192.168.1.25.\\n- IPv6: 2001:0db8:0000:0000:0000:8a2e:0370:7334"@en .

onto:resourceProductModel a owl:ObjectProperty ;
    rdfs:label "resourceProductModel" ;
    rdfs:comment "The product model of the Resource."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range onto:ProductModel ;
    ns1:term_status "stable" .

onto:resourceSerialNumber a owl:DatatypeProperty ;
    rdfs:label "resourceSerialNumber" ;
    rdfs:comment "The serial number of the Resource."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "stable" .

onto:resourceType a owl:ObjectProperty ;
    rdfs:label "resourceType" ;
    rdfs:comment "The type of the Network Element Resource."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/Resource/type> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    ns1:term_status "stable" .

onto:resourceUsageState a owl:ObjectProperty ;
    rdfs:label "resourceUsageState" ;
    rdfs:comment "The production state of the Resource."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/Resource/LifecycleState> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    ns1:term_status "stable" .

onto:serviceType a owl:ObjectProperty ;
    rdfs:label "serviceType" ;
    rdfs:comment "The type of the Service."@en ;
    rdfs:domain onto:Service ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/service/type> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "unstable" ;
    skos:changeNote "Introduced in v0.2" .

onto:siteId a owl:DatatypeProperty ;
    rdfs:label "siteId" ;
    rdfs:comment "A unique identifier of a Site."@en ;
    rdfs:domain <https://w3id.org/bot#Site> ;
    rdfs:isDefinedBy onto:LocationOntology ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "unstable" ;
    skos:changeNote "Change in v0.2: rdfs:range moved from noria:Site to bot:Site." .

onto:sitePrincipalAddressCityName a owl:DatatypeProperty ;
    rdfs:label "sitePrincipalAddressCityName" ;
    rdfs:comment "City Name for a Site.\\n\\nAlignment:\\n- *GeoNames*: a `P` class `gn:Feature` (city, village, etc.) may correspond to this property."@en ;
    rdfs:domain <https://w3id.org/bot#Site> ;
    rdfs:isDefinedBy onto:LocationOntology ;
    rdfs:subPropertyOf onto:sitePrincipalAddress ;
    ns1:term_status "unstable" ;
    skos:changeNote "Change in v0.2: rdfs:range moved from noria:Site to bot:Site." .

onto:sitePrincipalAddressCountry a owl:DatatypeProperty ;
    rdfs:label "sitePrincipalAddressCountry" ;
    rdfs:comment "Country name or code for a Site.\\n\\nAlignment:\\n- *GeoNames*:\\n  - a `A` class `gn:Feature` (country, state, region, etc.) may correspond to this property.\\n  - prefer ISO 3166 values for easier matching with `gn:countryCode`.\\n"@en ;
    rdfs:domain <https://w3id.org/bot#Site> ;
    rdfs:isDefinedBy onto:LocationOntology ;
    rdfs:subPropertyOf onto:sitePrincipalAddress,
        <https://www.geonames.org/ontology#countryCode> ;
    ns1:term_status "unstable" .

onto:sitePrincipalAddressPostalCode a owl:DatatypeProperty ;
    rdfs:label "sitePrincipalAddressPostalCode" ;
    rdfs:comment "Postal Code for a Site.\\n\\nAlignment:\\n- *GeoNames*: *ADM2*, *ADM3* or *ADM4* annotations may correspond to this property, depending on the considered country."@en ;
    rdfs:domain <https://w3id.org/bot#Site> ;
    rdfs:isDefinedBy onto:LocationOntology ;
    rdfs:subPropertyOf onto:sitePrincipalAddress,
        <https://www.geonames.org/ontology#postalCode> ;
    ns1:term_status "unstable" ;
    skos:changeNote "Change in v0.2: rdfs:range moved from noria:Site to bot:Site." .

onto:sitePrincipalAddressStreet a owl:DatatypeProperty ;
    rdfs:label "sitePrincipalAddressStreet" ;
    rdfs:comment "Street for a Site."@en ;
    rdfs:domain <https://w3id.org/bot#Site> ;
    rdfs:isDefinedBy onto:LocationOntology ;
    rdfs:subPropertyOf onto:sitePrincipalAddress ;
    ns1:term_status "unstable" .

onto:siteType a owl:DatatypeProperty ;
    rdfs:label "siteType" ;
    rdfs:comment "The type of a Site."@en ;
    rdfs:domain <https://w3id.org/bot#Site> ;
    rdfs:isDefinedBy onto:LocationOntology ;
    ns1:term_status "unstable" ;
    skos:changeNote "Change in v0.2: rdfs:range moved from noria:Site to bot:Site." ;
    skos:example "building, data center, rack" .

onto:structuralObservableOf a owl:ObjectProperty ;
    rdfs:label "structuralObservableOf"@en ;
    rdfs:comment "Relates some `StructuralObservable` instance to some `StructuralElement` instance."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    owl:inverseOf onto:structuralElementProperty ;
    ns1:term_status "unstable" .

onto:troubleTicketCharacteristic a owl:ObjectProperty ;
    rdfs:label "troubleTicketCharacteristic" ;
    rdfs:comment "A list of Characteristics of the ticket (TroubleTicketCharacteristic [*]). The Trouble ticket specific characteristics"@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    ns1:term_status "unstable" .

onto:troubleTicketCommittedRestorationDateTime a owl:DatatypeProperty ;
    rdfs:label "troubleTicketCommittedRestorationDateTime" ;
    rdfs:comment "The Customer Commitment Deadline Date (calculated on product information)."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "stable" .

onto:troubleTicketCriticity a owl:ObjectProperty ;
    rdfs:label "troubleTicketCriticity"@en ;
    rdfs:comment "The ticket criticity from the customer impact perspective."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/category> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "unstable" ;
    skos:example "Interrupted service, Corrupted service, Working backup, etc."@en .

onto:troubleTicketDetectionDateTime a owl:DatatypeProperty ;
    rdfs:label "troubleTicketDetectionDateTime" ;
    rdfs:comment "The date on which the trouble was discovered."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "stable" .

onto:troubleTicketFreezeItem a owl:ObjectProperty ;
    rdfs:label "troubleTicketFreezeItem"@en ;
    rdfs:comment "The ticket freeze period history."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:seeAlso onto:documentStatusHistory ;
    ns1:term_status "unstable" ;
    skos:example "A list of `noria:EventRecord` specifically describing the freeze periods for the given `noria:TroubleTicket`." .

onto:troubleTicketImpacts a owl:ObjectProperty ;
    rdfs:label "troubleTicketImpacts"@en ;
    rdfs:comment "A list of resources or services (applications) impacted by the trouble."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:seeAlso onto:troubleTicketRelatedResource,
        onto:troubleTicketRelatedService ;
    rdfs:subPropertyOf dcterms:relation ;
    ns1:term_status "unstable" ;
    skos:example "TroubleTicket.troubleTicketImpacts({Application [*], Resource [*]})" .

onto:troubleTicketIsNotificationEnable a owl:DatatypeProperty ;
    rdfs:label "troubleTicketIsNotificationEnable" ;
    rdfs:comment "The *enable* or *disable* external notification on trouble ticket events."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:boolean ;
    ns1:term_status "stable" .

onto:troubleTicketNoteCommentType a owl:ObjectProperty ;
    rdfs:label "troubleTicketNoteCommentType" ;
    rdfs:comment "The comment provenance type and/or disclosure rules family."@en ;
    rdfs:domain onto:TroubleTicketNote ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/commentType> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Customer, Group, Internal, System, etc."@en .

onto:troubleTicketNoteCorrelatedExecution a owl:ObjectProperty ;
    rdfs:label "troubleTicketNoteCorrelatedExecution" ;
    rdfs:comment "The correlated *ProcedureExecutionContainer* corresponding to the corrective maintenance actions depicted in the Trouble Ticket Note (i.e. the set of `EventRecord` about interactions with the system and as notified by the system).\\n\\nFrom a practical perspective, relating a `noria:TroubleTicketNote` to a `pep:ProcedureExecutionContainer` is akin to show off the materialization of a corrective maintenance action from the technical perspective.\\nNote that for actions undoubtedly related to a given trouble ticket note (i.e. that can be asserted without mining for execution context candidates), one can avoid using `troubleTicketNoteCorrelatedExecution` by directly relating the note to `EventRecord` with `ldp:member` as `TroubleTicket` and `TroubleTicketNote` are themselves subclasses of `pep:ProcedureExecutionContainer`.\\n"@en ;
    rdfs:domain onto:TroubleTicketNote ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range <https://w3id.org/pep/ProcedureExecutionContainer> ;
    rdfs:subPropertyOf dcterms:relation ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding the troubleTicketNoteCorrelatedExecution property.\\n" .

onto:troubleTicketNoteOperationType a owl:ObjectProperty ;
    rdfs:label "troubleTicketNoteOperationType" ;
    rdfs:comment "The operation type of the note." ;
    rdfs:domain onto:TroubleTicketNote ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/operationType> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Inward customer comments, Local customer call back, Tests and measurements, Diagnosis, etc."@en .

onto:troubleTicketOrigin a owl:ObjectProperty ;
    rdfs:label "troubleTicketOrigin" ;
    rdfs:comment "The person or group family at the origin of the creation of the Trouble Ticket."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/origin> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "unstable" ;
    skos:example "Customer, Supervision, Internal, Carrier, User, Partners" .

onto:troubleTicketPartyIntervention a owl:ObjectProperty ;
    rdfs:label "troubleTicketPartyIntervention"@en ;
    rdfs:comment "The history of groups activation and responsibility transfer."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    ns1:term_status "unstable" .

onto:troubleTicketPlannedRestorationDateTime a owl:DatatypeProperty ;
    rdfs:label "troubleTicketPlannedRestorationDateTime" ;
    rdfs:comment "Confirmed to customer planned restoration date ATR (Actual Time to Restore (ATR))."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "stable" .

onto:troubleTicketPriority a owl:ObjectProperty ;
    rdfs:label "troubleTicketPriority"@en ;
    rdfs:comment "The trouble management priority."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/priority> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "P1, P2, P3, P4" .

onto:troubleTicketRelatedParty a owl:ObjectProperty ;
    rdfs:label "troubleTicketRelatedParty" ;
    rdfs:comment "The related party(ies) that are associated to the ticket."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf onto:eventRelatedParty ;
    ns1:term_status "unstable" .

onto:troubleTicketSeverity a owl:ObjectProperty ;
    rdfs:label "troubleTicketSeverity" ;
    rdfs:comment "The criticity of the incident.\\n\\nThe classification (severity) of the Incident may be defined in accordance with Service Level Agreement (SLA) requirements.\\nThe thresholds of Incident resolution depend on standards defined per service type.\\nWhen the thresholds are exceeded, specific process of escalation may be activated."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/severity> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Minor, Major, Blocking, etc."@en .

onto:troubleTicketStatusCurrent a owl:ObjectProperty ;
    rdfs:label "troubleTicketStatusCurrent" ;
    rdfs:comment "The current activity status of the trouble ticket."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/status> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    ns1:term_status "stable" ;
    skos:example "Initialised, InProgress, Frozen, Restored, Resolved, Closed" .

onto:troubleTicketSupervisionTool a owl:DatatypeProperty ;
    rdfs:label "troubleTicketSupervisionTool" ;
    rdfs:comment "Supervision tool which detected the problem."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:source ;
    ns1:term_status "unstable" .

onto:troubleTicketTargetRestorationDateTime a owl:DatatypeProperty ;
    rdfs:label "troubleTicketTargetRestorationDateTime" ;
    rdfs:comment "The Customer initial restoration date Estimated Time to Restore (ETR)."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "stable" .

onto:troubleTicketTrigger a owl:ObjectProperty ;
    rdfs:label "troubleTicketTrigger" ;
    rdfs:comment "The EventRecord at the origin of the creation of the Trouble Ticket."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range onto:EventRecord ;
    rdfs:subPropertyOf dcterms:source ;
    ns1:term_status "stable" ;
    skos:example "EventRecord(<event/LOG_srvz01.dfg0f873c811_C015FWR080_2020-11-25>)" .

onto:troubleTicketType a owl:ObjectProperty ;
    rdfs:label "troubleTicketType" ;
    rdfs:comment "The ticket type."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/type> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Failure, Long period assistance, Assistance, Installation, Maintenance, Parametrization, etc."@en .

onto:troubleTicketUrgency a owl:ObjectProperty ;
    rdfs:label "troubleTicketUrgency" ;
    rdfs:comment "The priority level of the incident."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/urgency> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Immediate Intervention, Deferred Intervention, (State of) Emergency, No intervention, etc." .

onto:virtualServerStatus a owl:ObjectProperty ;
    rdfs:label "virtualServerStatus" ;
    rdfs:comment "The operational status of the Virtual Server."@en ;
    rdfs:domain onto:Resource ;
    rdfs:isDefinedBy onto:ObservableOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/Resource/OperationalState> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:subPropertyOf onto:structuralElementObservable ;
    ns1:term_status "unstable" .

onto:ActionPostCondition a owl:Class ;
    rdfs:label "ActionPostCondition" ;
    rdfs:comment "Set of Post Conditions or Potential outcomes that the execution of some OperationPlan may satisfy/lead to/confirm/solve.\\n\\nFrom the *ChangeRequest* perspective this enables to declare what to observe in order to confirm that the Procedure reached its goal; from the *TroubleTicket* perspective this enables to capitalize on expectations and outcomes for a given Procedure."@en ;
    rdfs:isDefinedBy <https://en.wikipedia.org/wiki/Hoare_logic>,
        onto:DocumentOntology ;
    rdfs:subClassOf onto:ProceduralObject ;
    ns1:term_status "unstable" ;
    skos:example "In an Incident Management context, the materialization to expect, such as:\\n- 'service restored',\\n- 'traffic down',\\n- 'Customer or a probe with that traffic coming up after some CLI command'." .

onto:ActionPreCondition a owl:Class ;
    rdfs:label "ActionPreCondition" ;
    rdfs:comment "Set of Pre Conditions or Hypothesis enabling/leading to the potential execution of some OperationPlan."@en ;
    rdfs:isDefinedBy <https://en.wikipedia.org/wiki/Hoare_logic>,
        onto:DocumentOntology ;
    rdfs:subClassOf onto:ProceduralObject ;
    ns1:term_status "unstable" ;
    skos:example "In an Incident Management context: when in situation X, shut link may help"@en .

onto:Property a owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:comment "An abstract representation of qualifiable, quantifiable, observable or operable qualities of some Element."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subClassOf <https://w3id.org/seas/Property> ;
    ns1:term_status "unstable" .

onto:documentStatusHistory a owl:ObjectProperty ;
    rdfs:label "documentStatusHistory" ;
    rdfs:comment "The status change history of the document as recorded by the system's logging feature."@en ;
    rdfs:domain onto:ChangeRequest,
        onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range onto:EventRecord ;
    rdfs:subPropertyOf dcterms:references ;
    ns1:term_status "stable" ;
    skos:example "EventRecord\\n    .loggingTime(\"2019-01-23T11:58:00Z\")\\n    .logOriginatingManagementSystem(</object/APP_MyOSS>)\\n    .references(</document/TT_2019-01-23_Resource1>)\\n    .title(\"InProgress\")\\n    .type </kos/Notification/EventType/stateChange>" .

onto:problemCategory a owl:ObjectProperty ;
    rdfs:label "problemCategory"@en ;
    rdfs:comment "The *final* nature (for product ticket class) or technical impact (for resource ticket class) of the incident category of any Trouble Ticket or Incident Ticket."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/trouble-category> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:seeAlso onto:troubleTicketCategory ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Isolated customer site, Total breakdown, Working backup, Downgrading equipment, Inaccessible destination, etc." .

onto:resourceManagedBy a owl:ObjectProperty ;
    rdfs:label "resourceManagedBy" ;
    rdfs:comment "The Support team or Owner of the Network Element (IT Resource)."@en ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:subPropertyOf onto:elementManagedBy ;
    ns1:term_status "stable" ;
    skos:changeNote "Change in v0.2:\\n- rdfs:range moved from noria:Team and noria:Organization to foaf:Agent.\\n- Removing rdfs:range foaf:Agent as it is already defined by noria:elementManagedBy.\\n- Removing rdfs:domain noria:Resource for noria:Resource and noria:NetworkLink compatibility." ;
    skos:example "- Resource(\"DNS server\").resourceManagedBy(\"DNS admin team\")\\n- NetworkLink(\"WAN Paris-Papeete\").resourceManagedBy(\"International backbone support team\")" .

onto:structuralElementDistinguishedName a owl:DatatypeProperty ;
    rdfs:label "structuralElementDistinguishedName"@en ;
    rdfs:comment "The Distinguished Name of the Structural Element Instance (i.e. unique identifier)."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subPropertyOf onto:elementDistinguishedName ;
    ns1:term_status "unstable" .

onto:troubleTicketCategory a owl:ObjectProperty ;
    rdfs:label "troubleTicketCategory"@en ;
    rdfs:comment "The *initial* nature (for product ticket class) or technical impact (for resource ticket class) of the incident category of any Trouble Ticket or Incident Ticket."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( skos:Concept [ a owl:Restriction ;
                        owl:hasValue <https://w3id.org/noria/kos/TroubleTicket/trouble-category> ;
                        owl:onProperty skos:inScheme ] ) ] ;
    rdfs:seeAlso onto:problemCategory ;
    rdfs:subPropertyOf dcterms:type ;
    ns1:term_status "stable" ;
    skos:example "Isolated customer site, Total breakdown, Working backup, Downgrading equipment, Inaccessible destination, etc." .

onto:troubleTicketCause a owl:DatatypeProperty ;
    rdfs:label "troubleTicketCause"@en ;
    rdfs:comment "The cause(s) defined for the trouble, in plain text."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:subPropertyOf dcterms:description ;
    ns1:term_status "stable" ;
    skos:example "SSH authentication failure due to loss of sync to NTP server and internal clock drift." .

onto:troubleTicketRelatedResource a owl:ObjectProperty ;
    rdfs:label "troubleTicketRelatedResource" ;
    rdfs:comment "The Resource entity on which the trouble ticket has been created."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range onto:Resource ;
    rdfs:subPropertyOf dcterms:relation,
        onto:eventRelatedElement ;
    ns1:term_status "stable" .

onto:troubleTicketRelatedService a owl:ObjectProperty ;
    rdfs:label "troubleTicketRelatedService" ;
    rdfs:comment "The *Application* or *Service* entity on which trouble ticket has been created."@en ;
    rdfs:domain onto:TroubleTicket ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:range onto:Application,
        onto:ApplicationModule,
        onto:Service ;
    rdfs:subPropertyOf dcterms:relation,
        onto:eventRelatedElement ;
    ns1:term_status "unstable" ;
    skos:example "- TroubleTicket.troubleTicketImpacts(\"syslog-ng\")\\n  Application(\"syslog-ng\").applicationType(<kos/application/type/service-platform>)\\n\\n- TroubleTicket.troubleTicketImpacts(\"Corporate Internet access Infrastructure\")\\n  Application(\"Corporate Internet access Infrastructure\").applicationType(<kos/application/type/infrastructure>)\\n" .

onto:ProductModel a owl:Class ;
    rdfs:label "ProductModel" ;
    rdfs:comment "The Product Model of some Resource as per the Manufacturer's naming."@en ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:subClassOf onto:StructuralProperty ;
    ns1:term_status "stable" .

onto:elementDistinguishedName a owl:DatatypeProperty ;
    rdfs:label "elementDistinguishedName"@en ;
    rdfs:comment "The Distinguished Name of the Element Instance (i.e. unique identifier)."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    ns1:term_status "unstable" .

onto:elementManagedBy a owl:ObjectProperty ;
    rdfs:label "elementManagedBy" ;
    rdfs:comment "The Agent or Owner of the Managed Element.\\n\\nAlignment:\\n- *ORG*: the *elementManagedBy* property can range an `org:Organization` or `org:OrganizationalUnit` entity as the ORG data model defines these class as subClassOf `foaf:Agent` (see [org:Organization](https://www.w3.org/TR/vocab-org/#org:Organization)).\\n"@en ;
    rdfs:domain onto:ManagedElement ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:range foaf:Agent ;
    ns1:term_status "stable" ;
    skos:changeNote "Introduced in v0.2." .

onto:elementProperty a owl:ObjectProperty ;
    rdfs:label "elementProperty"@en ;
    rdfs:comment "An abstract representation of a relationship between some Element instance and some Property instance."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subPropertyOf <https://w3id.org/seas/hasProperty> ;
    ns1:term_status "unstable" .

onto:eventRelatedParty a owl:ObjectProperty ;
    rdfs:label "eventRelatedParty" ;
    rdfs:comment "Party playing a role (stakeholders) in the life cycle of a given event instance or time-dependant entity."@en ;
    rdfs:domain onto:DynamicElement ;
    rdfs:isDefinedBy onto:CoreOntology ;
    ns1:term_status "unstable" .

onto:functionalElementDistinguishedName a owl:DatatypeProperty ;
    rdfs:label "functionalElementDistinguishedName"@en ;
    rdfs:comment "The Distinguished Name of the Functional Element Instance (i.e. unique identifier)."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subPropertyOf onto:elementDistinguishedName ;
    ns1:term_status "unstable" .

onto:Locus a owl:Class ;
    rdfs:label "Locus" ;
    rdfs:comment "A uniquely identified space for Resources within a given Room.\\n\\nAlignment:\\n- *BOT*:\\n  - The relationship to the Locus of a Room is available with the `bot:containsZone` property.\\n  - Approximating the geographical coordinates of a Locus is feasible through transitive inference over the `bot:hasZeroPoint` of the parent `bot:Site` (considering the GeoNames database this would to a `(bot:Site)=[bot:hasZeroPoint]=>(gn:Feature)` path towards `wgs84_pos:lat` or `wgs84_pos:long` values).\\n- *ORG*: Note that, at instanciation time, `bot:Site` entities may also be `org:Site` (see https://www.w3.org/TR/vocab-org/#org:Site) in order to allow for an Organization (including teams, persons, manufacturers) to be localized (e.g. see `org:basedAt`), and hence allow for intervention distance/time calculus or threat calculus with respect to a given Locus.\\n"@en ;
    rdfs:isDefinedBy onto:LocationOntology ;
    rdfs:seeAlso <https://w3id.org/bot#Space> ;
    rdfs:subClassOf <https://w3id.org/bot#Space> ;
    ns1:term_status "stable" ;
    skos:changeNote "Introduced in v0.2" ;
    skos:example "Line:L, Column:6, in Room:Server room 314."@en,
        "Ligne:L, Colonne:6, en Salle:SALLE STOCKAGE RESEAU 314."@fr .

onto:OperationPlan a owl:Class ;
    rdfs:label "OperationPlan" ;
    rdfs:comment "An abstract class representing a formal set of operations to be carried out in a standardized/controlled way."@en ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:subClassOf <http://IBCNServices.github.io/Folio-Ontology/Folio.owl#ControlMethod>,
        onto:ProceduralObject,
        <https://w3id.org/pep/Procedure> ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:subClassOf folio:ControlMethod.\\n" ;
    skos:example "A system upgrade procedure, a network traffic fail-over activation, the control method for qualifying some system fault."@en .

onto:TroubleTicketNote a owl:Class ;
    rdfs:label "TroubleTicketNote" ;
    rdfs:comment "A trouble ticket note represents a record used for reporting and information sharing during the incident management process for a given Trouble Ticket.\\n\\nAlignment:\\n- *DCMI*: from the DCMI Abstract Model perspective, a TroubleTicketNote is a described resource, hence DC terms apply:\\n  - troubleTicketNoteDate <=> http://purl.org/dc/terms/created : The recording date of the TroubleTicketNote.\\n  - troubleTicketNoteAuthor <=> http://purl.org/dc/terms/creator : The Author of the TroubleTicketNote.\\n  - troubleTicketNoteText <=> http://purl.org/dc/terms/description : The content of the TroubleTicketNote.\\n  - troubleTicketNoteForTicket <=> http://purl.org/dc/terms/isPartOf : The TroubleTicket this note is part of.\\n  - troubleTicketNoteCorrelatedNotifications <=> http://purl.org/dc/terms/relation : EventRecord(s) instances or identifiers that are considered to be correlated to this TroubleTicketNote.\\n- *BBO*: a TroubleTicketNote is a DocumentResource in the sense that it is the result of the Incident Management process and can be used as an input for another activity. From the BPMN 2.0 perspective, a TroubleTicketNote is a DataObject.\\n- *PEP*: a TroubleTicketNote is a context for (potentially) many *CorrectiveMaintenanceAction* to occur; hence it relates to a `pep:ProcedureExecutionContainer`, which in turns enable to track the corresponding `EventRecord` through the `ldp:member` property.\\n"@en ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:subClassOf onto:DynamicElement,
        <https://w3id.org/pep/ProcedureExecutionContainer>,
        <https://www.irit.fr/recherches/MELODI/ontologies/BBO#DocumentResource> ;
    ns1:term_status "stable" ;
    skos:example "We shut interface ge-0-0-1 of Router1 in order to force route on Router2.\\n2.6Gb traffic measured at 10:28.\\nCustomer has confirmed that the service is restored." .

onto:structuralElementObservable a owl:ObjectProperty ;
    rdfs:label "structuralElementObservable"@en ;
    rdfs:comment "An abstract representation of a relationship between some StructuralElement instance and some StructuralObservable instance."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subPropertyOf onto:elementProperty ;
    ns1:term_status "unstable" .

onto:FunctionalElement a owl:Class ;
    rdfs:label "FunctionalElement"@en ;
    rdfs:comment "Abstract class for services and broadcasting zones above the *Structural* facet (a.k.a. *Functional facet*)."@en ;
    rdfs:subClassOf onto:ManagedElement ;
    ns1:term_status "stable" .

onto:Service a owl:Class ;
    rdfs:label "Service"@en ;
    rdfs:comment "Service is an abstract base class for defining the Service hierarchy, i.e. the composition of assets (a.k.a. asset chain, service function chain) for providing a end-to-end data path or processing for some specific Customer or purpose.\\n\\nUsage notes:\\n- The `noria:Service` is loosely defined as per the way to group underpinning assets. The typical usage is to assert `noria:ApplicationModule` entities as `seas:subSystemOf` a given `noria:Service`.\\n- The network topology related to a given `noria:Service` is inferred from the set of resources, network interfaces and network links included in each Application that is part of the Service.\\n  We remark here that, although deterministic, the data path granularity calculus for some communication session (e.g. a time-bounded IP/http query with its response) depends on the specificity of the resources included in `ApplicationModule` instances.\\n  For example, the resulting granularity for a \"national IP backbone infrastructure\" application instance will correspond to the [routing domain](https://en.wikipedia.org/wiki/Routing_domain).\\n\\nAlignment:\\n- *SEAS*: A `noria:Service` allows for grouping components, hence it is a subclass of `seas:System`.\\n- *DevOps-Infra*:\\n  - The `noria:Service` is a concrete instance of a set of deployment models, hence it relates to `devopsprod:ServiceInstance`.\\n  - A `noria:Service.serviceType(<kos/service/type/CustomerFacingService>)` relates to the `devopsprod:BusinessProductInstance` concept.\\n- *tmforum*:\\n  - The `noria:Service` is equivalent to the `Service` object from the *[TMF 638 - Service Inventory](https://github.com/tmforum-apis/TMF638_ServiceInventory)* API.\\n  - Using the `noria:serviceType` relates to asserting the `CustomerFacingService` or `ResourceFacingService` Service subclasses notions of the *TMF 638 - Service Inventory* API (i.e. as either being possibly visible and usable by a Customer or not).\\n- *IETF*: Assuming a group *Service Functions* (SFs), the `noria:Service` concept relates to the *Service Function Chain (SFC)* definition from the [RFC 7665: SFC Architecture](https://www.rfc-editor.org/rfc/rfc7665) (see also [ITU-T X.1045](https://handle.itu.int/11.1002/1000/14043) for complementary SFC definition).\\n"@en ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:seeAlso <https://github.com/tmforum-apis/TMF638_ServiceInventory>,
        <https://handle.itu.int/11.1002/1000/14043>,
        <https://www.rfc-editor.org/rfc/rfc7665> ;
    rdfs:subClassOf onto:FunctionalElement,
        <https://w3id.org/seas/System> ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- Further definition, notably with rdfs:seeAlso relationships.\\n- Adding owl:equivalentClass devopsprod:ServiceInstance.\\n" ;
    skos:example "End-to-end data path for some specific customer"@fr .

onto:StructuralElement a owl:Class ;
    rdfs:label "StructuralElement"@en ;
    rdfs:comment "Abstract class for physical/logical ICT systems's assets and relations (a.k.a. *Structural facet*)."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subClassOf onto:ManagedElement,
        <https://w3id.org/seas/System> ;
    ns1:term_status "stable" ;
    skos:example "router xxx, virtual machine yyy, link zzz entities; is_a, connected_to or part_of properties"@en .

onto:sitePrincipalAddress a owl:DatatypeProperty ;
    rdfs:label "sitePrincipalAddress" ;
    rdfs:comment "Street address of a Site."@en ;
    rdfs:domain <https://w3id.org/bot#Site> ;
    rdfs:isDefinedBy onto:LocationOntology ;
    ns1:term_status "unstable" ;
    skos:changeNote "Change in v0.2: rdfs:range moved from noria:Site to bot:Site." .

onto:ManagedElement a owl:Class ;
    rdfs:label "ManagedElement"@en ;
    rdfs:comment "Top abstract class of NORIA Cyber/Physical concepts for describing, managing and analyzing ICT systems."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subClassOf <https://w3id.org/seas/FeatureOfInterest> ;
    ns1:term_status "stable" .

onto:NetworkLink a owl:Class ;
    rdfs:label "NetworkLink" ;
    rdfs:comment "A physical or logical Link between Resources.\\n\\nUsage notes:\\n- The organizational unit in charge of the Network Link (i.e. the Support team or Owner of the Network Link) can be set with the `noria:resourceManagedBy` property.\\n"@en ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:subClassOf onto:StructuralElement,
        <https://w3id.org/seas/CommunicationConnection> ;
    ns1:term_status "stable" ;
    skos:example "Optical fiber, L2TP connection, etc."@en .

onto:applicationModuleRelatedParty a owl:ObjectProperty ;
    rdfs:label "applicationModuleRelatedParty" ;
    rdfs:comment "Generic property for linking a party playing a role in the management of the Application Module."@en ;
    rdfs:domain onto:ApplicationModule ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:subPropertyOf onto:elementManagedBy ;
    ns1:term_status "unstable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:subPropertyOf noria:elementManagedBy." .

onto:eventRelatedElement a owl:ObjectProperty ;
    rdfs:label "eventRelatedElement" ;
    rdfs:comment "The structural or functional element instance some event or time-dependant entity is related with."@en ;
    rdfs:domain onto:DynamicElement ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:range onto:FunctionalElement,
        onto:StructuralElement ;
    ns1:term_status "unstable" .

onto:structuralElementObservableData a owl:DatatypeProperty ;
    rdfs:label "structuralElementObservableData"@en ;
    rdfs:comment "An abstract representation of a relationship between some StructuralElement instance and some literal data."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subPropertyOf onto:elementProperty ;
    ns1:term_status "unstable" .

onto:DynamicElement a owl:Class ;
    rdfs:label "DynamicElement"@en ;
    rdfs:comment "Abstract class for time-related entities and their potential chaining (a.k.a. *Dynamic facet*)."@en ;
    rdfs:isDefinedBy onto:CoreOntology ;
    rdfs:subClassOf onto:ManagedElement ;
    ns1:term_status "stable" ;
    skos:example "An alarm with happens_on or followed_by properties" .

onto:ObservableOntology a <http://purl.org/vocommons/voaf#Vocabulary> .

onto:ApplicationModule a owl:Class ;
    rdfs:label "ApplicationModule" ;
    rdfs:comment "A specific and managed instance of an Application."@en ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:subClassOf onto:FunctionalElement,
        <https://w3id.org/seas/System> ;
    skos:example "- Development instance of the RLOGS (Centralization of real time logs) Application.\\n- B2B instance of the DMZ VoIP (shared management zone / platform for Voice over IP services) Application." .

onto:NotificationOntology a <http://purl.org/vocommons/voaf#Vocabulary> ;
    dcterms:creator <https://orcid.org/0000-0001-5639-1504>,
        <https://orcid.org/0000-0001-5887-899X>,
        <https://orcid.org/0000-0003-0457-1436> ;
    dcterms:title "The NORIA Notification Ontology"@en .

onto:EventRecord a owl:Class ;
    rdfs:label "EventRecord" ;
    rdfs:comment "This managed object represents the information stored in the log as a result of receiving notifications or incoming event reports.\\n\\nIn that sense it is an abstract object with basic properties (e.g. event type, logging time, provenance system, message) to interpret in the context of its properties and relationships.\\nFor example, an *EventRecord* instance `log1` originating from the managed resource `R1` and describing a network interface state change on the Resource is fetched from a syslog-ng platform `Mon1` (i.e. the originating management system).\\nA related *EventRecord* instance `alarm1` with `noria:alarmSeverity = Critical` and originating managed resource `R1` is triggered by a Network Monitoring System `NMS1` (i.e. the originating management system) for presentation to the Technical Support Center.\\n\\nConsidering possible combinations of properties' objects and values, a `noria:EventRecord` allows for describing:\\n- both informational and alarm notifications (this rely on `skos:ConceptScheme` over the `dcterms:type` of the `noria:EventRecord`),\\n- notifications that affect both the network infrastructure (e.g. network interface down), network applications/services (e.g. timeout, k-out-of-n) and the Operation Support System (OSS) itself (e.g. updating a `noria:TroubleTicketNote`),\\n- notifications originating from both onboard signaling (e.g. [SNMP Trap](https://en.wikipedia.org/wiki/Simple_Network_Management_Protocol)), probes (e.g. [NIDS](https://en.wikipedia.org/wiki/Intrusion_detection_system)), the monitoring system (e.g. threshold overrun, business rules) and inference engines (e.g. NORIA-AD).\\n\\nAlignment:\\n- *DCMI*: from the DCMI Abstract Model perspective, a EventRecord is a described resource, hence DC terms apply:\\n  - *logRecordId* <=> http://purl.org/dc/terms/identifier : Identifier of notification or log record, as defined by <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-logRecordId>.\\n  - *logInformation* <=> http://purl.org/dc/terms/description : Additional information describing the logged event, as defined by <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-additionalInformation>.\\n  - *logType* <=> http://purl.org/dc/terms/type : The Type of the Event (e.g. General Operation Alarm, State Change, etc.), as defined by the NORIA `kos/Notification/EventType` concept scheme.\\n  - *alarmCorrelatedNotifications* <=> http://purl.org/dc/terms/relation : EventRecord instances or identifiers that are considered to be correlated to this EventRecord, as defined by <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-correlatedNotifications>.\\n  - *alarmOwner* <=> http://purl.org/dc/terms/mediator : The Support team member who acknowledged an Alarm Event Record.\\n  - *alarmProbableCause* <=> http://purl.org/dc/terms/conformsTo : The asserted or inferred cause of the Alarm Event Record, as defined by the NORIA `kos/Notification/ProbableCause` and `kos/Notification/SecurityAlarmCause` concept schemes.\\n    Asserting the Alarm cause is equivalent to directly connecting the Alarm, as a fault (issue, incident) artefact, to some phenomenon interpretation.\\n    Inferring the Alarm cause is equivalent to guessing the phenomenon origin through Root Cause Analysis (RCA) or some probabilistic approach.\\n- *BBO*: an EventRecord is a `BBO:DocumentResource` in the sense that it is the result of the Event Management process and can be used as an input for another activity. From the BPMN 2.0 perspective, an EventRecord is a `DataObject`.\\n- *PEP*: an EventRecord is an artefact of the realization of a `pep:Procedure`, hence it is a specialization of a `pep:ProcedureExecution` for the NORIA context.\\n- *SLOGERT*: an EventRecord is equivalent to a `log:Event`.\\n"@en ;
    rdfs:isDefinedBy onto:NotificationOntology,
        <https://www.itu.int/ITU-T/formal-language/itu-t/x/x721/1992/x721.html#-eventLogRecord>,
        <https://www.itu.int/rec/T-REC-X.733-199202-I/> ;
    rdfs:subClassOf <https://unifiedcyberontology.org/ontology/uco/observable#EventRecord>,
        onto:DynamicElement,
        <https://w3id.org/pep/ProcedureExecution>,
        <https://w3id.org/sepses/ns/log#Event>,
        <https://www.irit.fr/recherches/MELODI/ontologies/BBO#DocumentResource> ;
    ns1:term_status "stable" ;
    skos:changeNote "Changes in v0.2:\\n- EventRecord introduced, replacing noria:EventLog.\\n- Removing many related properties to the benefit of direct instanciation with dcterms properties.\\n- Adding rdfs:subClassOf BBO:DocumentResource.\\n- Adding rdfs:subClassOf pep:ProcedureExecution.\\n- Adding rdfs:subClassOf log:Event.\\n" ;
    skos:example "- A network router event with\\n  loggingTime=`2022-01-01T17:12:00,259Z` and\\n  logText=`LINEPROTO-5-UPDOWN: Line protocol on Interface GigabitEthernet0/0/1, changed state to up`.\\n- A configuration change event on network router with\\n  pep:hasCommand='no shutdown' and\\n  logText='SYS-5-CONFIG_I: Configured from console by vty2 (10.34.195.36)'\\n  and logOriginatingManagedObject=<object/NE_R1>.\\n"@en .

onto:LocationOntology a <http://purl.org/vocommons/voaf#Vocabulary> .

onto:Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "An abstract system based on data processing and presentation."@en ;
    rdfs:isDefinedBy onto:ApplicationOntology ;
    rdfs:subClassOf <https://unifiedcyberontology.org/ontology/uco/observable#Application>,
        onto:FunctionalElement,
        <https://w3id.org/seas/System> ;
    ns1:term_status "stable" ;
    skos:example "- RLOGS: Centralization of real time logs.\\n- DMZ VoIP: shared management zone / platform for Voice over IP services." .

onto:NetworkInterface a owl:Class ;
    rdfs:label "NetworkInterface" ;
    rdfs:comment "A Network Interface of some Resource (e.g. server, router, virtual routing and forwarding (VRF) instance), and of some type (e.g. physical, virtual).\\n\\nUsage notes:\\n- The name of the Network Interface (aka. networkInterfaceName, such as `ge-0/0/0.3013` or `ae52.3028`) can be set with the `rdfs:label` property.\\n"@en ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:subClassOf <https://unifiedcyberontology.org/ontology/uco/observable#NetworkInterface>,
        onto:StructuralElement,
        <https://w3id.org/seas/CommunicationConnectionPoint> ;
    ns1:term_status "stable" ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:subClassOf observable:NetworkInterface.\\n" .

onto:ChangeRequest a owl:Class ;
    rdfs:label "ChangeRequest" ;
    rdfs:comment "A Change Request represents a record used for reporting and managing change activities on services and resources. It is a key artefact to the Change Management process. Change Management process is to respond to the customer’s changing business requirements while maximizing value and reducing incidents, disruption and network.\\n\\nAlignment:\\n- *DCMI*: from the DCMI Abstract Model perspective, a ChangeRequest is a described resource, hence DC terms apply:\\n  - changeRequestId <=> http://purl.org/dc/terms/identifier : Identifier of the ChangeRequest.\\n  - changeRequestCreationDateTime <=> http://purl.org/dc/terms/created : The Date and time on which the ChangeRequest was created in the system.\\n  - changeRequestLastUpdate <=> http://purl.org/dc/terms/modified : The date and time on which the ChangeRequest was last updated.\\n  - changeRequestDescription <=> http://purl.org/dc/terms/description : Extended description of the change to be made.\\n  - changeRequestNote <=> http://purl.org/dc/terms/hasPart : A list of customer or internal comments.\\n  - changeRequestAttachment <=> http://purl.org/dc/terms/hasPart : DocumentAttachment(s) that are associated to the ChangeRequest.\\n  - changeRequestDuration <=> http://purl.org/dc/terms/extent (optional)\\n  - changeRequestRelatedParty <=> http://purl.org/dc/terms/contributor : Party playing a role in the ChangeRequest, whether it be an unqualified role (i.e. direct usage of dcterms:contributor) or a qualified role (i.e. sub-properties such as noria:changeRequestInitiatorParty).\\n  - changeRequestCorrelatedNotifications <=> http://purl.org/dc/terms/relation : EventRecord(s) instances or identifiers that are considered to be correlated to this ChangeRequest.\\n- *PEP*: a ChangeRequest is a context for (potentially) many *ChangeAction* to occur; hence it relates to a `pep:ProcedureExecutionContainer`.\\n- *BBO*: a ChangeRequest is a DocumentResource in the sense that it is the result of the Change Management process and can be used as an input for another activity. From the BPMN 2.0 perspective, a ChangeRequest is a DataObject.\\n"@en ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:subClassOf onto:DynamicElement,
        <https://w3id.org/pep/ProcedureExecutionContainer>,
        <https://www.irit.fr/recherches/MELODI/ontologies/BBO#DocumentResource> ;
    owl:disjointWith onto:TroubleTicket ;
    ns1:term_status "stable" .

onto:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "General resource record of the Communication Device kind from the logistics park. It is a managed entity that can be either Physical or Virtual.\\n\\nAlignment:\\n- *SEAS*: Whenever a Resource individual is an assembly of other resources (e.g. a server rack) or is part of an assembly (e.g. a server blade), the Resource individual can also be declared as a `seas:System` in order to benefit of the `seas:subSystemOf` relation.\\n  For example, Resources may be grouped in some `noria:Service` class for providing both an end-to-end analysis of the data path (i.e. Communication Devices + Connections) and an abstract object linked to some end user (e.g. Customer).\\n- *BOT*: A `noria:Resource` is a sub-class of `bot:Element` for setting instances in the context of a physical environment (e.g. in a building).\\n- *SLOGERT*: A `noria:Resource` is equivalent to a `log:Host`.\\n- *UCO*: A `noria:Resource` is equivalent to an UCO's observable `Device`.\\n"@en ;
    rdfs:isDefinedBy onto:ResourceOntology ;
    rdfs:seeAlso <https://w3id.org/noria/kos/Resource/> ;
    rdfs:subClassOf <https://unifiedcyberontology.org/ontology/uco/observable#Device>,
        <https://w3id.org/bot#Element>,
        onto:StructuralElement,
        <https://w3id.org/seas/CommunicationDevice>,
        <https://w3id.org/seas/System>,
        <https://w3id.org/sepses/ns/log#Host> ;
    ns1:term_status "stable" ;
    skos:altLabel "ICT resource."@en,
        "Elément structurant informatique et télécoms."@fr ;
    skos:changeNote "Changes in v0.2:\\n- Adding rdfs:subClassOf bot:Element.\\n- Adding rdfs:subClassOf observable:Device.\\n- Adding rdfs:subClassOf log:Host.\\n" .

onto:CoreOntology a <http://purl.org/vocommons/voaf#Vocabulary> .

onto:ApplicationOntology a <http://purl.org/vocommons/voaf#Vocabulary> .

onto:ResourceOntology a <http://purl.org/vocommons/voaf#Vocabulary> .

onto:TroubleTicket a owl:Class ;
    rdfs:label "TroubleTicket" ;
    rdfs:comment "A trouble ticket represents a record used for reporting and managing the resolution of resource problems. Main trouble ticket attributes are its description, severity, type, priority, related dates (created, target resolution, resolution, etc.), state and related information (change reason, change date), related parties (originator, owner, pilot), notes, trouble causes and impacts.\\n\\nAlignment:\\n- *DCMI*: from the DCMI Abstract Model perspective, a TroubleTicket is a described resource, hence DC terms apply:\\n  - troubleTicketId <=> http://purl.org/dc/terms/identifier : Identifier of the trouble ticket.\\n  - troubleTicketCreationDateTime <=> http://purl.org/dc/terms/created : The Date on which the TroubleTicket was created in the ticketing system.\\n  - troubleTicketLastUpdate <=> http://purl.org/dc/terms/modified : The date and time that the TroubleTicket was last updated.\\n  - troubleTicketName <=> http://purl.org/dc/terms/title : Name of the TroubleTicket, typically a short description provided by the user that create the ticket or complementary data\\n  - troubleTicketDescription <=> http://purl.org/dc/terms/description : Extended description of the trouble or issue.\\n  - troubleTicketNote <=> http://purl.org/dc/terms/hasPart : The TroubleTicketNote(s) that are associated to the TroubleTicket.\\n  - troubleTicketAttachment <=> http://purl.org/dc/terms/hasPart : The DocumentAttachment(s) that are associated to the TroubleTicket.\\n  - troubleTicketRelationshipParentOf <=> http://purl.org/dc/terms/hasPart : The TroubleTicket(s) this ticket is parent of (TicketRelationship).\\n  - troubleTicketRelationshipChildOf <=> http://purl.org/dc/terms/isPartOf : The TroubleTicket this ticket is the child of (TicketRelationship).\\n  - troubleTicketDuration <=> http://purl.org/dc/terms/extent (optional) : The overall duration of the incident management process, typically in ISO 8601 duration format. Can be useful for computing Mean Time To Repair (MTTR) values for a given `problemCategory`.\\n  - troubleTicketCorrelatedNotifications <=> http://purl.org/dc/terms/relation : EventRecord(s) instances or identifiers that are considered to be correlated to this TroubleTicket/TroubleTicketNote.\\n- *BBO*: a TroubleTicket is a DocumentResource in the sense that it is the result of the Incident Management process and can be used as an input for another activity. From the BPMN 2.0 perspective, a TroubleTicket is a DataObject.\\n- *PEP*: a TroubleTicketNote is a context for (potentially) many *CorrectiveMaintenanceAction* to occur; hence it relates to a `pep:ProcedureExecutionContainer`, which in turns enable to track the corresponding `EventRecord` through the `ldp:member` property.\\n    "@en ;
    rdfs:isDefinedBy onto:DocumentOntology ;
    rdfs:seeAlso <https://wiki.en.it-processmaps.com/index.php/Incident_Management>,
        <https://www.dublincore.org/specifications/dublin-core/abstract-model/>,
        <https://www.omg.org/spec/BPMN/2.0/PDF#G11.91167> ;
    rdfs:subClassOf onto:DynamicElement,
        <https://w3id.org/pep/ProcedureExecutionContainer>,
        <https://www.irit.fr/recherches/MELODI/ontologies/BBO#DocumentResource> ;
    ns1:term_status "stable" .

onto:DocumentOntology a <http://purl.org/vocommons/voaf#Vocabulary> ;
    dcterms:description "The Document Ontology defines the TroubleTicket and ChangeRequest objects.\\nThese are data resource (i.e. the result of a process) for efficient Incident Management and Change Management."@en .

