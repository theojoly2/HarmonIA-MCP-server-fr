<http://salt.semanticauthoring.org/ontologies/sdo> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/tudor-groza>,
        <https://plus.google.com/111185521388256403855> ;
    dcterms:description "The SALT Document Ontology captures the linear structure of the publication, in addition to the identification and revisioning information of the publication's content."@en ;
    dcterms:modified "2009-06-15"^^xsd:date ;
    dcterms:title "SALT Document Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-11-26"^^xsd:date ;
            ns2:text "The vocabulary still offline and one of the creator contacted." ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2015-04-14"^^xsd:date ;
            ns2:text "Creators contacted to make a decision as it is still offline." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-06-05"^^xsd:date ;
            ns2:text "A very interesting vocabulary allowing to track the life cycle of a document at an arbitrary level of granularity. It has to be integrated by a document edition platform generating automatically the annotations. Such an environment for LaTeX is available at http://salt.semanticauthoring.org/development.html" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-05"^^xsd:date ;
            ns2:text "This vocabulary is waiting for a new home, its domain has changed owner." ] ;
    vann:preferredNamespacePrefix "sdo" ;
    vann:preferredNamespaceUri "http://salt.semanticauthoring.org/ontologies/sdo#" ;
