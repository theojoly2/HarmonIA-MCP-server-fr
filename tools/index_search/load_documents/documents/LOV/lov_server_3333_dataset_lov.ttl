<http://purl.oclc.org/NET/ssnx/meteo/aws> a ns1:Vocabulary ;
    dcterms:creator <http://google.com/+LaurentLefort> ;
    dcterms:description "This ontology is part of the Agriculture Meteorology example showcasing the ontology developed by the W3C Semantic Sensor Networks incubator group (SSN-XG). It is published here in order to generalize the potential usage and the alignment with other standardization efforts of the SSN ontology."@en ;
    dcterms:issued "2010-09-20"^^xsd:date ;
