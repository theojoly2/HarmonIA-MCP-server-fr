    ns1:reusedByVocabularies "0"^^xsd:int ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/istex/ontology/master/istexXML.owl> ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/istex/versions/2018-12-17.n3> ;
    dcat:keyword "Academy",
        "Metadata",
        "Press" ;
    foaf:homepage "https://data.istex.fr/ontology/istex/" .

