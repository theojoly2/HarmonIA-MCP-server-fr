<http://schema.org/> a ns1:Vocabulary ;
    dcterms:contributor <http://dbpedia.org/resource/Google>,
        <http://dbpedia.org/resource/Microsoft>,
        <http://dbpedia.org/resource/Yahoo!>,
        <http://dbpedia.org/resource/Yandex>,
        <https://www.linkedin.com/in/danbri/> ;
    dcterms:description "Search engines including Bing, Google, Yahoo! and Yandex rely on schema.org markup to improve the display of search results, making it easier for people to find the right web pages."@en ;
    dcterms:issued "2012-04-26"^^xsd:date ;
    dcterms:modified "2020-03-10"^^xsd:date ;
    dcterms:title "Schema.org vocabulary"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2020-03-20"^^xsd:date ;
            ns2:text "Added versions 5.0, 6.0 and 7.0" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2019-10-16"^^xsd:date ;
            ns2:text "Added versions 3.7, 3.8, 3.9 and 4.0. Also added Yandex as contributor" ],
        [ a ns2:Review ;
            ns3:creator <http://google.com/+PierreYvesVandenbussche> ;
            ns3:date "2019-05-03"^^xsd:date ;
            ns2:text "Added versions 3.5 and 3.6" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2018-04-23"^^xsd:date ;
            ns2:text "Annual review - OK" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-08-10"^^xsd:date ;
            ns2:text "Added two versions 3.0 and 3.1. Also the versions can be obtained directly in Github at this link https://github.com/schemaorg/schemaorg/tree/sdo-makemake/data/releases/" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-05-19"^^xsd:date ;
            ns2:text "Since version 2.0 release, schema.org has a documentation page for releases and version history at https://schema.org/docs/releases.html" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-09-01"^^xsd:date ;
            ns2:text "Added equivalences with other vocabularies, introduced in v1.6." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-07-28"^^xsd:date ;
            ns2:text "We now provide for this important and evergrowing vocabulary a full history with a diff file between successive versions. This feature is planned to be available for all vocabularies in the next LOV version." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-07-23"^^xsd:date ;
            ns2:text "Schema.org is not only a central tool for semantic markup on the Web, supported by major search engines, it's also a reference general vocabulary for a growing number of other vocabularies." ] ;
