    dcterms:title "The RDF Concepts Vocabulary"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2021-03-07"^^xsd:date ;
            ns2:text "New additions to RDF in 2019 ( rdf:JSON, rdf:direction) without proper metadata (https://w3c.github.io/rdf-star/Minutes/2021-03-05.html#t04). That's not what we can call best practice publishing from W3C vocabulary. Who is to blame? :)" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2017-03-09"^^xsd:date ;
            ns2:text "Annual review OK." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-07-11"^^xsd:date ;
            ns2:text "Annual review OK." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-13"^^xsd:date ;
            ns2:text "The vocabulary of vocabularies is itself linked to others that build on it : it relies on RDFS as well as OWL and Dublin Core for metadata in the latest version. The namespace is keeping track of the first release 1999-02-22. If a vocabulary in LOV pretends it was issued before this date, it's certainly a bug." ] ;
