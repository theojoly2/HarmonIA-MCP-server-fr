<http://www.ics.forth.gr/isl/oae/core> a ns1:Vocabulary ;
    dcterms:contributor <http://users.ics.forth.gr/~tzitzik/> ;
    dcterms:creator <http://users.ics.forth.gr/~fafalios/> ;
    dcterms:description "The Open NEE Model defines an extension of the Open Annotation Data Model (http://www.openannotation.org/spec/core) that allows describing in RDF the result of a Named Entity Extraction (NEE) process, enabling thereby an application to run advanced (SPARQL) queries over the annotated data. The model also exploits the Open NEE Configuration Model (http://www.ics.forth.gr/isl/oncm) for relating the output of a NEE process with an applied configuration (serving provenance information to the output of the entire NEE process)."@en ;
    dcterms:issued "2015-02-04"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2015-03-25"^^xsd:date ;
    dcterms:title "Open NEE Model"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2016-05-10"^^xsd:date ;
            ns2:text "Annual review OK." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-03-25"^^xsd:date ;
            ns2:text "Relies on Open Annotation and Open NEE Configuration Model. As the latter, lacks time metadata and versIon history." ] ;
    vann:preferredNamespacePrefix "oae" ;
    vann:preferredNamespaceUri "http://www.ics.forth.gr/isl/oae/core#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/oae/versions/2015-03-25.n3> ;
    dcat:keyword "Metadata" .

