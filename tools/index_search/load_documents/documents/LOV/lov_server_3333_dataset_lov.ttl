<http://purl.org/net/soron> a ns1:Vocabulary ;
    dcterms:creator <http://purl.org/net/fjcp_foaf> ;
    dcterms:description "The Social Relationships ONtology (SORON) attempts to describe the different types of social relationships in society (both objective and subjective). Current version focuses on inter-personal 1:1 relationships (except family relationships). Other types of relationships may be covered in later versions. It complements FOAF and RELATIONSHIP ontologies."@en ;
    dcterms:issued "2015-05-12"^^xsd:date ;
