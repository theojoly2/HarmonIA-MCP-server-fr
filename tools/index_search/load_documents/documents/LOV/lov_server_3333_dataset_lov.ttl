<http://purl.oclc.org/NET/mvco.owl> a ns1:Vocabulary ;
    dcterms:description "The Media Value Chain Ontology (MVCO) is an ontology for formalizing the representation of the Media Value Chain. It couples naturally with the MPEG-21 multimedia framework, and its standardization as Part 19 of this ISO/IEC standard is underway (at the editing time of this document)."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2010-05-06"^^xsd:date ;
    dcterms:publisher <http://dmag.ac.upc.edu/> ;
    dcterms:title "Media Value Chain Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2016-01-07"^^xsd:date ;
            ns2:text "Annual review ok." ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2013-10-29"^^xsd:date ;
            ns2:text "Latest version is from 3 years ago. It does not have any in/out links. It is used in 0 datasets. The HTML documentation is lost or not linked from LOV." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2012-03-05"^^xsd:date ;
            ns2:text "Links to mo, frbr, cc and foaf are suggested by the HTML documentation, but not asserted in the RDF file." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-11-20"^^xsd:date ;
            ns2:text "Annual review. Added link to the documentation" ] ;
