    dcterms:description "This ontology was designed to conceptualize symbolic meanings following Baudrillard's Simulacra and Simulation theory. Symbols, their meaning, the context in which the symbolic meaning (or simulation) exists and the source of the simulation are linked to a N-ary Simulation Class."@en ;
    dcterms:issued "2021-09-12"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2023-01-10"^^xsd:date ;
