<http://www.ontologydesignpatterns.org/cp/owl/semiotics.owl> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/aldo-gangemi> ;
    dcterms:description "A content ontology pattern that encodes a basic semiotic theory, by reusing the situation pattern. The basic classes are: Expression, Meaning, Reference (the semiotic triangle), LinguisticAct (for the pragmatics), and Agent.\\nA linguistic act is said to be context for expressions, with their meanings and references, and agents involved.\\nBased on this pattern, several specific linguistic acts, such as 'tagging', 'translating', 'defining', 'formalizing', etc. can be defined, so constituting a formal vocabulary for a pragmatic web."@en ;
    dcterms:issued "2007-01-01"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng>,
        <http://id.loc.gov/vocabulary/iso639-2/ita> ;
    dcterms:modified "2007-01-01"^^xsd:date ;
    dcterms:title "A content ontology pattern that encodes a basic semiotic theory, by reusing the situation pattern."@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2021-06-02"^^xsd:date ;
            ns2:text "Ontology added into LOV" ] ;
    vann:preferredNamespacePrefix "semiotics" ;
    vann:preferredNamespaceUri "http://www.ontologydesignpatterns.org/cp/owl/semiotics.owl#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "1"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/semiotics/versions/2007-01-01.n3> ;
    dcat:keyword "General & Upper",
        "Metadata" .

