        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-05-21"^^xsd:date ;
            ns2:text "Annual review, no change" ],
        [ a ns2:Review ;
            ns3:creator <https://plus.google.com/107915931756113239056> ;
            ns3:date "2014-05-26"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2013-05-26"^^xsd:date ;
            ns2:text "This ontology deals with the notion of reified events. It defines one main concept Event that may have a location, a time, active agents, factors and products." ] ;
