<http://purl.org/goodrelations/v1> a ns1:Vocabulary ;
    dcterms:creator <https://orcid.org/0000-0001-5031-7266> ;
    dcterms:description "The GoodRelations ontology provides the vocabulary for annotating e-commerce offerings (1) to sell, lease, repair, dispose, or maintain commodity products and (2) to provide commodity services."@en ;
    dcterms:issued "2008-07-31"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2011-09-30"^^xsd:date ;
    dcterms:title "The GoodRelations Ontology for Semantic Web-based E-Commerce"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-02-18"^^xsd:date ;
            ns2:text "Annul review - OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-03-12"^^xsd:date ;
            ns2:text "Annual review - OK" ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2013-06-24"^^xsd:date ;
            ns2:text "A number of ontologies rely on gr to represent specific products." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-03-27"^^xsd:date ;
            ns2:text "A de facto standard, now completely aligned with schema.org" ] ;
    vann:preferredNamespacePrefix "gr" ;
    vann:preferredNamespaceUri "http://purl.org/goodrelations/v1#" ;
    ns1:occurrencesInDatasets "125243"^^xsd:int ;
    ns1:reusedByDatasets "20"^^xsd:int ;
