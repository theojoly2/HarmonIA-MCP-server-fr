<https://w3id.org/icon/ontology/> a ns1:Vocabulary ;
    dcterms:contributor <http://data.semanticweb.org/person/aldo-gangemi>,
        <https://orcid.org/0000-0001-9195-8203> ;
    dcterms:creator <https://orcid.org/0000-0002-9152-4402> ;
    dcterms:description "The ICON ontology deals with high granularity art interpretation. It was developed by conceptualizing Panofsky's theory of levels of interpretation, therefore artworks can be described according to Pre-iconographical, Iconographical and Iconological information."@en ;
    dcterms:issued "2022-04-12"^^xsd:date ;
