            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2019-10-21"^^xsd:date ;
            ns2:text "Annual review - OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-05-04"^^xsd:date ;
            ns2:text "New publication with improved metadata. Various concept schemes using this vocabulary are available at http://data.nature.com/downloads/latest/." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-07-27"^^xsd:date ;
            ns2:text "Annual review - no change. Still no metadata available. The vocabulary is used by data at http://data.nature.com/." ],
