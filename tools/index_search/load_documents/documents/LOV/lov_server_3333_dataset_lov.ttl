<http://www.ontologydesignpatterns.org/cp/owl/sequence.owl> a ns1:Vocabulary ;
    dcterms:contributor <http://data.semanticweb.org/person/aldo-gangemi> ;
    dcterms:creator <http://data.semanticweb.org/person/valentina-presutti> ;
    dcterms:description "Intended to represent sequence schemas. It defines the notion of transitive and intransitive precedence and their inverses.  It can then be used between tasks, processes, time intervals, spatially locate objects, situations, etc."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng>,
        <http://id.loc.gov/vocabulary/iso639-2/ita> ;
    dcterms:modified "2011-01-30"^^xsd:date ;
    dcterms:title "Sequence Pattern"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-01-14"^^xsd:date ;
            ns2:text "Annual review OK." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-10-09"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-08-30"^^xsd:date ;
            ns2:text "Linked to other patterns in the same namespace, all extracted from DOLCE." ] ;
    vann:preferredNamespacePrefix "seq" ;
    vann:preferredNamespaceUri "http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/seq/versions/2011-01-30.n3> ;
    dcat:keyword "Support" .

