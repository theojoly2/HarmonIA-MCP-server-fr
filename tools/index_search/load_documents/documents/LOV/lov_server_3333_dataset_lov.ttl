dcam: a ns1:Vocabulary ;
    dcterms:creator <http://purl.org/dc/aboutdcmi#DCMI>,
        <https://plus.google.com/106477499652657442659>,
        <https://plus.google.com/117927624031668323569> ;
    dcterms:description "An abstract model for Dublin Core metadata"@en ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2012-06-13"^^xsd:date ;
    dcterms:publisher <http://purl.org/dc/aboutdcmi#DCMI> ;
    dcterms:title "DCMI Abstract Model"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2019-10-21"^^xsd:date ;
            ns2:text "Annual review - OK" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-09-26"^^xsd:date ;
            ns2:text "Annual review - No change" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-07-02"^^xsd:date ;
            ns2:text "As its name suggests, this is more an abstract, high-level model than a directly reusable vocabulary. It's included here for its historical importance in the theoretical research around metadata, and the many questions it raises, many of them still in discussion. See http://wiki.dublincore.org/index.php/DCAM_Revision. Note that the namespace currently redirects to  \\thttp://dublincore.org/documents/dcmi-terms/ which defines in a single document several DCMI namespaces (DC Elements, DC Terms, DC Type and DCAM)." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-07-29"^^xsd:date ;
            ns2:text "Annual review - no change" ] ;
    vann:preferredNamespacePrefix "dcam" ;
    vann:preferredNamespaceUri "http://purl.org/dc/dcam/" ;
    ns1:occurrencesInDatasets "27"^^xsd:int ;
    ns1:reusedByDatasets "3"^^xsd:int ;
    ns1:reusedByVocabularies "5"^^xsd:int ;
    ns1:usageInDataset [ a ns1:DatasetOccurrences ;
