foaf: a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/libby-miller>,
        <https://www.linkedin.com/in/danbri/> ;
    dcterms:description "FOAF is a project devoted to linking people and information using the Web. Regardless of whether information is in people's heads, in physical or digital documents, or in the form of factual data, it can be linked."@en ;
    dcterms:modified "2014-01-14"^^xsd:date ;
    dcterms:publisher <https://www.linkedin.com/in/danbri/> ;
    dcterms:title "Friend of a Friend vocabulary"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2019-10-17"^^xsd:date ;
            ns2:text "No updates since 2014" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-12-16"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-01-15"^^xsd:date ;
            ns2:text "Looking forward for v1.0 :)" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-12-16"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-06-04"^^xsd:date ;
            ns2:text "From the specification : \"FOAF has been evolving gradually since its creation in mid-2000. There is now a stable core of classes and properties that will not be changed, beyond modest adjustments to their documentation to track implementation feedback and emerging best practices.\"" ] ;
    vann:preferredNamespacePrefix "foaf" ;
    vann:preferredNamespaceUri "http://xmlns.com/foaf/0.1/" ;
