<http://linkedscience.org/lsc/ns#> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/tomi-kauppinen>,
        <https://plus.google.com/114873600462583384483> ;
    dcterms:description "LSC, the Linked Science Core Vocabulary, is a lightweight vocabulary providing terms to enable publishers and researchers to relate things in science to time, space, and themes."@en ;
    dcterms:issued "2011-05-26"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2011-11-29"^^xsd:date ;
    dcterms:title "Linked Science Core Vocabulary"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-08-28"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-24"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-06-25"^^xsd:date ;
            ns2:text "A small generic vocabulary for description of scientific research concepts, such as hypotheses, methods, results and publications. Most of those concepts seem already described in other vocabularies, and maybe too generic for efficient direct use. Could be extended and specialized for specific domains." ] ;
    vann:preferredNamespacePrefix "lsc" ;
    vann:preferredNamespaceUri "http://linkedscience.org/lsc/ns#" ;
    dcat:distribution [ a dcat:Distribution ;
            dcterms:issued "2011-05-25"^^xsd:date ;
            dcterms:title "v2011-05-26" ],
        <https://lov.linkeddata.es/dataset/lov/vocabs/lsc/versions/2011-11-29.n3> ;
    dcat:keyword "Methods" .

