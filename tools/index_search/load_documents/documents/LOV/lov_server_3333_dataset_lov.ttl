<http://kdo.render-project.eu/kdo#> a ns1:Vocabulary ;
    dcterms:creator <http://render-project.eu/> ;
    dcterms:description "The Knowledge Diversity Ontology aims at providing a vocabulary that describes different dimensions of knowledge diversity of the Web. To support the representation of diversity information, the conceptual model of the Knowledge Diversity Ontology includes concepts and relations that were identified and modelled by focusing on real world scenarios in context of customer feedback, news, and Wikipedia opinion mining as well as content and sentiment analysis."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2014-06-06"^^xsd:date ;
    dcterms:title "The Knowledge Diversity Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-08-28"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-07-05"^^xsd:date ;
            ns2:text "Comment in the RDF file reads : \"This ontology is currently under development in context with the RENDER project.\" The documentation page for the ontology at http://kdo.render-project.eu says \"has been developed\". It's unclear if the source of this documentation is the file available at the namespace, and if it is a final deliverable of the project, due to end in september 2013." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-06"^^xsd:date ;
            ns2:text "Annual review - Fixed version history" ] ;
    vann:preferredNamespacePrefix "kdo" ;
    vann:preferredNamespaceUri "http://kdo.render-project.eu/kdo#" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/kdo/versions/2012-05-15.n3>,
        <https://lov.linkeddata.es/dataset/lov/vocabs/kdo/versions/2012-10-03.n3>,
        <https://lov.linkeddata.es/dataset/lov/vocabs/kdo/versions/2014-06-07.n3> ;
    dcat:keyword "Quality" .

