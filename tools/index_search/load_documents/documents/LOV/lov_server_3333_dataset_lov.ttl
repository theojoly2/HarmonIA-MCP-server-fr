<http://purl.org/muto/core> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/steffen-lohmann> ;
    dcterms:description "The Modular and Unified Tagging Ontology (MUTO) is an ontology for tagging and folksonomies. It is based on a thorough review of earlier tagging ontologies and unifies core concepts in one consistent schema. It supports different forms of tagging, such as common, semantic, group, private, and automatic tagging, and is easily extensible."@en ;
    dcterms:issued "2011-11-16"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2011-11-16"^^xsd:date ;
    dcterms:title "Modular Unified Tagging Ontology (MUTO)"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-07-31"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-06-25"^^xsd:date ;
            ns2:text "Tries to take the best of all previous tagging vocabularies. The documentation includes a detailed review of those predecessors, and mappings are formally defined at http://purl.org/muto/mappings#" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-24"^^xsd:date ;
            ns2:text "Annual review OK" ] ;
    vann:preferredNamespacePrefix "muto" ;
    vann:preferredNamespaceUri "http://purl.org/muto/core#" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/muto/versions/2011-11-16.n3> ;
    dcat:keyword "Tag" ;
    foaf:homepage "http://purl.org/muto" .

