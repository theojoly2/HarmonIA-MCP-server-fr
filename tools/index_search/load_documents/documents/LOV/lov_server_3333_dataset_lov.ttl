<http://purl.org/oslo/ns/localgov> a ns1:Vocabulary ;
    dcterms:creator <http://about.me/raf.buyle>,
        <http://www.v-ict-or.be/>,
        <https://plus.google.com/100657774585364184497> ;
    dcterms:description "This version of the OSLO Exchange Standard provides a minimum set of classes and properties for describing a natural person, i.e. the individual as opposed to any role they may play in society or the relationships they have to other people, organisations and property; all of which contribute significantly to the broader concept of identity. The vocabulary is closely integrated with the Person, Organisation and Location Vocabularies published by the W3C in the Gov Linked Data Project. The OSLO specification is the result of a public-private partnership initiated by V-ICT-OR, the Flemish Organization for ICT in Local Government."@en ;
    dcterms:issued "2013-09-30"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng>,
        <http://id.loc.gov/vocabulary/iso639-2/fra> ;
    dcterms:modified "2014-05-30"^^xsd:date ;
    dcterms:title "OSLO Exchange Standard"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-08-28"^^xsd:date ;
            ns2:text "Fixed version history." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-09"^^xsd:date ;
            ns2:text "References also the obsolete provisional namespace http://www.w3.org/ns/legal#, and the 404 namespace http://purl.org/vocab/cpsv#." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-10-07"^^xsd:date ;
            ns2:text "Relies on many other vocabularies, including some still in development in the W3C Government Linked Data effort, which are not yet included in LOV." ] ;
    vann:preferredNamespacePrefix "oslo" ;
    vann:preferredNamespaceUri "http://purl.org/oslo/ns/localgov#" ;
    rdfs:isDefinedBy <http://purl.org/oslo/ns/localgov> ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/oslo/versions/2013-09-30.n3>,
        <https://lov.linkeddata.es/dataset/lov/vocabs/oslo/versions/2014-05-30.n3> ;
    dcat:keyword "Society" .

<http://purl.org/spar/datacite> a ns1:Vocabulary ;
