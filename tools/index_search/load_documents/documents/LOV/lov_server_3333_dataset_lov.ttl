<https://www.w3.org/ns/pim/space> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/tim-berners-lee> ;
    dcterms:description "This ontology is for use in describing\\nWorkspaces.  Workspaces are places where data is stored and associated policies of privacy.\\nA given application typically stores information in several different\\nworkspaces, some being user private, some shared, and some public.\\nit is crucial that the user has easy control over the destiny of information."@en ;
    dcterms:issued "2021-10-01"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2021-10-01"^^xsd:date ;
    dcterms:publisher <http://www.w3.org/data#W3C> ;
    dcterms:title "An ontology for describing Workspaces."@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2024-01-11"^^xsd:date ;
            ns2:text "An ontology implemented by Sir Tim himself." ] ;
    vann:preferredNamespacePrefix "ws" ;
    vann:preferredNamespaceUri "http://www.w3.org/ns/pim/space#" ;
