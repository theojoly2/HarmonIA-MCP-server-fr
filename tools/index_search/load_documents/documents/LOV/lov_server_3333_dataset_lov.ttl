            ns3:date "2014-11-20"^^xsd:date ;
            ns2:text "Annual review. Time passes by, and the time and calendar vocabularies are still in statu quo ante. This one is more than 10 yeras old now, and still not much used." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2012-10-26"^^xsd:date ;
            ns2:text "Seems obsolete and replaced by http://www.w3.org/2002/12/cal/icaltzd, used in the W3C note (2005-09-29) at http://www.w3.org/TR/rdfcal/. But neither vocabulary makes any reference to the other one. http://www.w3.org/2002/12/cal/icaltzd has been removed from LOV because the file contains errors, but this namespace seems nevertheless still used by applications such as Tabulator (source : Masahide Kansaki)" ] ;
    vann:preferredNamespacePrefix "cal" ;
    vann:preferredNamespaceUri "http://www.w3.org/2002/12/cal/ical#" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/cal/versions/2004-04-07.n3>,
        <https://lov.linkeddata.es/dataset/lov/vocabs/cal/versions/2015-01-11.n3> ;
    dcat:keyword "Time" ;
    foaf:homepage "http://www.w3.org/TR/rdfcal/" .

