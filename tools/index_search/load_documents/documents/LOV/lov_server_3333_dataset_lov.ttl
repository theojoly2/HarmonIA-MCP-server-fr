<http://purl.oclc.org/NET/ssnx/qu/qu> a ns1:Vocabulary ;
    dcterms:creator <http://google.com/+LaurentLefort>,
        <http://ontolog.cim3.net/cgi-bin/wiki.pl?HansPeter_De_Koning>,
        <http://ontolog.cim3.net/cgi-bin/wiki.pl?NicolasRouquette>,
        <http://ontolog.cim3.net/cgi-bin/wiki.pl?RogerBurkhart>,
        <http://www.informatik.uni-trier.de/~ley/pers/hd/e/Espinoza:Hu=aacute=scar> ;
    dcterms:description "This ontology is partially based on the SysML QUDV (Quantities, Units, Dimensions and Values) proposed by a working group of the SysML 1.2 Revision Task Force (RTF), working in close coordination with the OMG MARTE specification group.\\nIn order to generalize its potential usage and alignment with other standardization efforts concerning quantities and units, the QU ontology has been further developed as a complement to the Agriculture Meteorology example showcasing the ontology developed by the W3C Semantic Sensor Networks incubator group (SSN-XG)."@en ;
    dcterms:issued "2009-08-25"^^xsd:date ;
    dcterms:modified "2011-06-19"^^xsd:date ;
    dcterms:title "Quantity Kinds and Units"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-07-18"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-03-10"^^xsd:date ;
            ns2:text "A very generic vocabulary intended to be extendable to any kind of units and measures. Includes expression of relationships and conversions between different units." ] ;
    vann:preferredNamespacePrefix "qu" ;
    vann:preferredNamespaceUri "http://purl.oclc.org/NET/ssnx/qu/qu#" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/qu/versions/2011-06-20.n3> ;
    dcat:keyword "Methods" .

<http://purl.org/nemo/gufo#> a ns1:Vocabulary ;
    dcterms:creator <https://orcid.org/0000-0002-3452-553X>,
        <https://orcid.org/0000-0002-4408-7553>,
        <https://orcid.org/0000-0002-5385-5761>,
        <https://orcid.org/0000-0002-9819-3781> ;
    dcterms:description "The objective of gUFO is to provide a lightweight implementation of the Unified Foundational Ontology (UFO) [1-5] suitable for Semantic Web OWL 2 DL applications. \\n\\nIntended users are those implementing UFO-based lightweight ontologies that reuse gUFO by specializing and instantiating its elements.\\n\\nThere are three implications of the use of the term lightweight. First of all, we have employed little expressive means in an effort to retain computational properties for the resulting OWL ontology. Second, we have selected a subset of UFO-A [1, 2] and UFO-B [3] to include here. In particular, there is minimalistic support for UFO-B (only that which is necessary to establish the participation of objects in events and to capture historical dependence between events). Third, a lightweight ontology, differently from a reference ontology, is designed with the purpose of providing an implementation artifact to structure a knowledge base (or knowledge graph). This has driven a number of pragmatic implementation choices which are discussed in comments annotated to the various elements of this implementation. \\n\\nThe 'g' in gUFO stands for gentle. At the same time, \"gufo\" is the Italian word for \"owl\".\\n\\n\\nFor the source repository, see: <https://github.com/nemo-ufes/gufo>"@en ;
    dcterms:issued "2019-11-11"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2019-11-11"^^xsd:date ;
    dcterms:title "gUFO: A Lightweight Implementation of the Unified Foundational Ontology (UFO)"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2021-11-27"^^xsd:date ;
            ns2:text "Added into LOV" ] ;
    vann:preferredNamespacePrefix "gufo" ;
    vann:preferredNamespaceUri "http://purl.org/nemo/gufo#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "1"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/gufo/versions/2019-11-11.n3> ;
    dcat:keyword "Events",
        "General & Upper" ;
    foaf:homepage "https://github.com/nemo-ufes/gufo" .

<http://purl.org/net/vocab/2004/03/label> a ns1:Vocabulary ;
    dcterms:creator <http://google.com/+MortenHøybyeFrederiksen> ;
    dcterms:description "Term definitions for singular and plural label properties"@en ;
    dcterms:issued "2004-03-28"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/dan>,
        <http://id.loc.gov/vocabulary/iso639-2/eng>,
        <http://id.loc.gov/vocabulary/iso639-2/spa> ;
    dcterms:modified "2004-03-28"^^xsd:date ;
    dcterms:title "label"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-07-17"^^xsd:date ;
            ns2:text "Annual review OK. The vocabulary is 503 as of today." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-07-16"^^xsd:date ;
            ns2:text "Like a few early RDF vocabularies, this one is explicitly importing RDFS and OWL. This is not considered a good practice anymore." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-05-22"^^xsd:date ;
            ns2:text "A small, quite old vocabulary. Relies on a rather vague notion of \"RDF term\". Certainly made obsolete by more recent and more expressive ways to handle the terminological information, such as lvont or skosxl." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-06"^^xsd:date ;
            ns2:text "Annual review : the vocabulary is temporary offline, this should be fixed any time according to the publisher." ] ;
    vann:preferredNamespacePrefix "label" ;
    vann:preferredNamespaceUri "http://purl.org/net/vocab/2004/03/label#" ;
    ns1:occurrencesInDatasets "4"^^xsd:int ;
    ns1:reusedByDatasets "2"^^xsd:int ;
    ns1:reusedByVocabularies "1"^^xsd:int ;
    ns1:usageInDataset [ a ns1:DatasetOccurrences ;
            ns1:inDataset <http://datahub.io/dataset/aksworg.ttl> ;
            ns1:occurrences "2"^^xsd:int ],
        [ a ns1:DatasetOccurrences ;
            ns1:inDataset <http://datahub.io/dataset/aksworg.rdf> ;
            ns1:occurrences "2"^^xsd:int ] ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/label/versions/2004-03-28.n3> ;
    dcat:keyword "Vocabularies" .

