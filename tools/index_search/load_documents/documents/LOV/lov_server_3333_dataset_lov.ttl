    dcat:keyword "IoT" .

<https://w3id.org/CEMontology> a ns1:Vocabulary ;
    dcterms:contributor <http://personale.unimore.it/rubrica/dettaglio/frollo>,
        <http://personale.unimore.it/rubrica/dettaglio/laurapo> ;
    dcterms:description "The Crime Event Model is an ontology for the representation of crime events extracted from local newspapers. It could be employed for Crime Analysis purposes: extracting crime information from newspapers and enriching them with proper machine-readable semantics is a critical task to help law enforcement agencies at preventing crime, supporting criminal investigations and evaluating the action of law enforcement agencies themselves. The model is based on the fundamental 5W1H journalistic questions, that are Who?, What?, When?, Where?, Why? and How?. Another important requirement was the attempt to exploit existing knowledge graphs and ontologies such as the Simple Event Model (SEM) Ontology and the Schema.org data model for interoperability and interconnection."@en ;
    dcterms:issued "2022-06-14"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2022-06-14"^^xsd:date ;
    dcterms:publisher <https://www.unimore.it/> ;
    dcterms:title "Crime Event Model (CEM)"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2022-12-03"^^xsd:date ;
            ns2:text "Ontology added to LOV, but waiting to have the authors and contributors since it says \"blind\"" ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2023-03-15"^^xsd:date ;
            ns2:text "Contributors added." ] ;
    vann:preferredNamespacePrefix "cem" ;
    vann:preferredNamespaceUri "https://w3id.org/CEMontology/" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    rdfs:isDefinedBy <http://crimeanalytics.it/cem-reference/cem.owl> ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/cem/versions/2022-06-14.n3> ;
    dcat:keyword "Events",
        "Methods" .

<https://w3id.org/CPSWatch> a ns1:Vocabulary ;
    dcterms:creator <https://orcid.org/0009-0003-2548-8225> ;
    dcterms:description "This ontology defines a vocabulary for describing cyber physical systems for monitoring purpose. It contains two main concepts: CPSWatch#MonitoredSystem that is a top level description of a System that is modeled and CPSWatch#MonitoringSensor that is a top level description of a sensor used to monitor the CPSWatch#MonitoredSystem."@en ;
    dcterms:issued "2023-12-07"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
