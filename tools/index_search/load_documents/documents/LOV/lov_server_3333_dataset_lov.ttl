<http://www.w3.org/2006/time> a ns1:Vocabulary ;
    dcterms:contributor <mailto:chris.little@metoffice.gov.uk> ;
    dcterms:creator <http://orcid.org/0000-0002-3884-3420>,
        <mailto:fengpan@microsoft.com>,
        <mailto:hobbs@isi.edu> ;
    dcterms:description "This vocabulary defines temporal entities such as time intervals, their properties and relationships."@en ;
    dcterms:issued "2006-09-26"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/ara>,
        <http://id.loc.gov/vocabulary/iso639-2/deu>,
        <http://id.loc.gov/vocabulary/iso639-2/eng>,
        <http://id.loc.gov/vocabulary/iso639-2/fra>,
        <http://id.loc.gov/vocabulary/iso639-2/ita>,
        <http://id.loc.gov/vocabulary/iso639-2/jpn>,
        <http://id.loc.gov/vocabulary/iso639-2/kau>,
        <http://id.loc.gov/vocabulary/iso639-2/nld>,
        <http://id.loc.gov/vocabulary/iso639-2/pol>,
        <http://id.loc.gov/vocabulary/iso639-2/por>,
        <http://id.loc.gov/vocabulary/iso639-2/rus>,
        <http://id.loc.gov/vocabulary/iso639-2/spa>,
        <http://id.loc.gov/vocabulary/iso639-2/zho> ;
    dcterms:modified "2017-04-06"^^xsd:date ;
    dcterms:publisher <http://www.w3.org/data#W3C> ;
    dcterms:title "Time Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <http://google.com/+PierreYvesVandenbussche> ;
            ns3:date "2017-08-09"^^xsd:date ;
            ns2:text "The new version includes updates in 2016-2017: \\n- initial update of OWL-Time - modified to support arbitrary temporal reference systems\\n- adjust range of time:timeZone to time:TimeZone, moved up from the tzont ontology.\\n- restore time:Year and time:January which were present in the 2006 version of the ontology, but now marked deprecated.\\n- intervalIn, intervalDisjoint, monthOfYear added; TemporalUnit subclass of TemporalDuration\\n- hasTime, hasXSDDuration added; Number removed; all duration elements changed to xsd:decimal\\n- Update of OWL-Time ontology, extended to support general temporal reference systems." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-07-08"^^xsd:date ;
            ns2:text "A new revised version is on the way at http://w3c.github.io/sdw/time/ by the SDW WG. See https://raw.githubusercontent.com/w3c/sdw/gh-pages/time/rdf/time.ttl" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-05-01"^^xsd:date ;
            ns2:text "... the more things change, the more they are the same. Why is time so badly ignored by the linked data community? Too complicated?" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-05-21"^^xsd:date ;
            ns2:text "Another year has passed, but time has not moved forward ..." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-05-22"^^xsd:date ;
            ns2:text "This important vocabulary is much reused, but is unfortunately stuck on the W3C track at \"Working Draft\" stage, and badly needs to move forward." ] ;
    vann:preferredNamespacePrefix "time" ;
    vann:preferredNamespaceUri "http://www.w3.org/2006/time#" ;
    ns1:occurrencesInDatasets "827778"^^xsd:int ;
