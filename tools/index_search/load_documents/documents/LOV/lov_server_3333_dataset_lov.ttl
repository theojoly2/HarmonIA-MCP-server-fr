<http://purl.org/cwmo/#> a ns1:Vocabulary ;
    dcterms:creator <https://gabriel-alex.github.io/> ;
    dcterms:description "Creative Workshop Management Ontology (CWMO) - an ontology designed to describe the creative workshop domain, to permit reasoning on creative method and to describe resources gathered inside Creative Support System. The primary goal of the ontology is to cover all knowledge about creative workshop and creative method necessary for Creative support system. The second goal is to provide interoperability between distributed Creative Support System."@en ;
    dcterms:issued "2017-02-16"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng>,
        <http://id.loc.gov/vocabulary/iso639-2/fra> ;
    dcterms:modified "2017-02-16"^^xsd:date ;
    dcterms:title "Creative Workshop Management Ontology (CWMO)"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2017-04-04"^^xsd:date ;
            ns2:text "An Ontology to represent the knowledge domain of a creative workshop, presented at the The 12th International Conference on Signal Image Technology. It reuses this ontology http://www.gi2mo.org/0.6/ns.html# that need to be added into the ecosystem. There are typos in the foaf namespace" ] ;
    vann:preferredNamespacePrefix "cwmo" ;
    vann:preferredNamespaceUri "http://purl.org/cwmo/#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    rdfs:isDefinedBy <https://gabriel-alex.github.io/cwmo/CWMO-042.owl> ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/cwmo/versions/2017-02-16.n3> ;
    dcat:keyword "Image",
        "Multimedia" .

