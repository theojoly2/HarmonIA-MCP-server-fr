            ns2:text "A module of the new SEAS vocabulary" ] ;
    vann:preferredNamespacePrefix "foio" ;
    vann:preferredNamespaceUri "https://w3id.org/seas/FeatureOfInterestOntology/" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
