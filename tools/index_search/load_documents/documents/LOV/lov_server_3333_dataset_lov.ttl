<http://spi-fm.uca.es/spdef/models/genericTools/vmm/1.0> a ns1:Vocabulary ;
    dcterms:creator <https://plus.google.com/106519148652566330800> ;
    dcterms:description "In Software Engineering, as well as in other disciplines, it is common to use model-editing tools using a visual language. In particular, the editing tools allow you to design UML software models, so that let you manage much of the work products of a project. From the study of several UML tools, such as Enterprise Architect, Visual Paradigm for UML or Rational Rose, this vocabulary has been defined. This vocabulary represents the basic structure of these UML tools, but does not exclude others that allow you to use other visual languages for modeling software systems or other entities."@en ;
    dcterms:issued "2013-12-15"^^xsd:date ;
    dcterms:modified "2013-12-15"^^xsd:date ;
    dcterms:title "Visual Modeling tool Model"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2025-07-14"^^xsd:date ;
            ns2:text "Ontology URI is 404 at the time of reviewing the record." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-08-21"^^xsd:date ;
            ns2:text "Removed Spanish description for UI. Also fixed version history." ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2014-01-10"^^xsd:date ;
            ns2:text "English description added." ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2013-12-19"^^xsd:date ;
            ns2:text "Part of a family of vocabularies developed by the Software Process Deployment and Evaluation Framework project." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-17"^^xsd:date ;
            ns2:text "Latest version has minor changes. No change in the metadata (version number and date)." ] ;
    vann:preferredNamespacePrefix "vmm" ;
    vann:preferredNamespaceUri "http://spi-fm.uca.es/spdef/models/genericTools/vmm/1.0#" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/vmm/versions/2013-12-15.n3> ;
    dcat:keyword "PLM" .

