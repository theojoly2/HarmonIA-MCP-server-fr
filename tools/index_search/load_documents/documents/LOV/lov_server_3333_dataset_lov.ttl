<http://purl.org/ontology/storyline> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/jarred-mcginnis>,
        <http://google.com/+JeremyTarling>,
        <https://plus.google.com/117790372940620323498> ;
    dcterms:description "The News Storyline Ontology is a generic model for describing and organising the stories news organisations tell. The ontology is intended to be flexible to support any given news or media publisher's approach to handling news stories. At the heart of the ontology, is the concept of Storyline."@en ;
    dcterms:issued "2013-04-30"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2013-05-01"^^xsd:date ;
    dcterms:title "A News Storyline Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-04-21"^^xsd:date ;
            ns2:text "Cleaned version history, kept only the last version." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-05-18"^^xsd:date ;
            ns2:text "Updated version history. Versions 0.2 and 0.3 have the same date." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2013-10-24"^^xsd:date ;
            ns2:text "A nice and well designed vocabulary for journalists that pull together information, facts, opinion, quotes, and data to explain the significance of world events and their context to create a narrative and/or storyline." ] ;
