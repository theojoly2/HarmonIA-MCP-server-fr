<http://purl.org/iot/ontology/fiesta-iot> a ns1:Vocabulary ;
    dcterms:contributor <https://garvitabajaj.wordpress.com/> ;
    dcterms:creator <http://personal.ee.surrey.ac.uk/Personal/T.Elsaleh/>,
        <https://mimove.inria.fr/members/rachit-agarwal/>,
        <https://plus.google.com/107915931756113239056>,
        <https://www.researchgate.net/profile/David_Gomez_Fernandez>,
        <https://www.researchgate.net/profile/Jorge_Lanza>,
        <https://www.researchgate.net/profile/Luis_Sanchez19> ;
    dcterms:description "The  FIESTA-IoT ontology takes inspiration from the well-known Noy et al. methodology  for reusing and interconnecting existing ontologies. To build the ontology, we leverage a number of core concepts from various mainstream ontologies and taxonomies, such as Semantic Sensor Network (SSN), M3-lite (a lite version of M3 ontology), WGS84, IoT-lite, Time, and DUL ontology."@en ;
    dcterms:issued "2016-04-28"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2017-02-09"^^xsd:date ;
    dcterms:title "FIESTA-IoT Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2017-04-04"^^xsd:date ;
            ns2:text "The FIESTA-IoT Ontology  is framed within the EU H2020 FIESTA-IoT project, that aims to seamlessly support the federation of testbeds through the usage of semantic-based technologies. I hope they will have a smart documentation to help user understanding the concepts. The ontolgy is using an ontology which is not currently online. See: http://www.onem2m.org/ontology/Base_Ontology/base_ontology#. Statatics are not showing up in the interface, we should try to fix the issue." ] ;
    vann:preferredNamespacePrefix "fiesta-iot" ;
    vann:preferredNamespaceUri "http://purl.org/iot/ontology/fiesta-iot#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    rdfs:isDefinedBy <http://ontology.fiesta-iot.eu/ontologyDocs/fiesta-iot.owl> ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/fiesta-iot/versions/2017-02-09.n3> ;
    dcat:keyword "IoT" .

