<http://data.press.net/ontology/stuff/> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/jarred-mcginnis>,
        <http://uk.linkedin.com/in/pauliharman>,
        <https://plus.google.com/117790372940620323498> ;
    dcterms:description "Press.net Stuff Ontology models real world entities. There are two kinds of stuff: tangibles and intangibles. Tangible stuff includes persons, locations and organizations. Intangibles are abstract concepts such as smoking, feminism or love."@en ;
    dcterms:issued "2011-07-28"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2012-06-17"^^xsd:date ;
    dcterms:title "Press.net Stuff Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2018-04-10"^^xsd:date ;
            ns2:text "Annual review - OK" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-08-01"^^xsd:date ;
            ns2:text "Annual review - OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-07-02"^^xsd:date ;
            ns2:text "The tangible/intangible distinction seems to belong to a very abstract level of upper ontology, but this vocabulary has a very pragmatic approach to this distinction." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-07-28"^^xsd:date ;
            ns2:text "Annual review - no change" ] ;
    vann:preferredNamespacePrefix "pns" ;
    vann:preferredNamespaceUri "http://data.press.net/ontology/stuff/" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/pns/versions/2012-06-18.n3> ;
