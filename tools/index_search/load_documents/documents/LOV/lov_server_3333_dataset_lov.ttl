<http://www.w3.org/2001/sw/hcls/ns/transmed/> a ns1:Vocabulary ;
    dcterms:creator <http://google.com/+MScottMarshall>,
        <http://orcid.org/0000-0001-5985-7429>,
        <http://plus.google.com/116931802472607378324>,
        <http://www.researchgate.net/profile/Julia_Kozlovsky>,
        <https://orcid.org/0000-0003-4727-9435> ;
    dcterms:description "The Translational Medicine Ontology (TMO) is a high-level, patient-centric ontology that extends existing domain ontologies to integrate data across aspects of drug discovery and clinical practice. The ontology has been developed by participants in the World Wide Web Consortium's Semantic Web for Health Care and Life Sciences Interest Group"@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2012-07-02"^^xsd:date ;
    dcterms:publisher <http://www.w3.org/blog/hcls/> ;
    dcterms:title "Translational Medicine Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-10-07"^^xsd:date ;
            ns2:text "Offline as of this annual review time" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-04-17"^^xsd:date ;
            ns2:text "Added creators and publishers. This vocabulary is maintained on Google Code, which is closing soon. Editors contacted to know where it will be moved to." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-05-18"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-05-20"^^xsd:date ;
            ns2:text "This vocabulary relies on a few other, very specific OBO vocabularies, which have not been included in LOV." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-05-19"^^xsd:date ;
            ns2:text "Classes and properties are not declared under the declared xmlns http://www.w3.org/2001/sw/hcls/ns/transmed/tmo#, but directly under http://www.w3.org/2001/sw/hcls/ns/transmed/. The later is therefore taken here as the \"actual\" vocabulary namespace and URI. Both URI are de-referencable to the same RDF file anyway." ] ;
    vann:preferredNamespacePrefix "tmo" ;
    vann:preferredNamespaceUri "http://www.w3.org/2001/sw/hcls/ns/transmed/" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/tmo/versions/2012-07-03.n3> ;
    dcat:keyword "Health" .

