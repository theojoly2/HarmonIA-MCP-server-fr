<http://data.semanticweb.org/ns/swc/ontology> a ns1:Vocabulary ;
    dcterms:creator <https://plus.google.com/101452739292831400665>,
        <https://plus.google.com/104562438783848730256>,
        <https://plus.google.com/117822622810723317855> ;
    dcterms:description "The Semantic Web Conference ontology (SWC) is an ontology for describing academic conferences"@en ;
    dcterms:issued "2007-05-31"^^xsd:date ;
    dcterms:modified "2009-05-11"^^xsd:date ;
    dcterms:title "Semantic Web Conference Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-07-11"^^xsd:date ;
            ns2:text "Annual review OK!" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-06-05"^^xsd:date ;
            ns2:text "This vocabulary is the fruit of the \"eat our own dog food\" principle, which has been derided by some, showing it as a proof that the Semantic Web tools and community were good only at auto-reference exercices, and useless in \"real life\". Which was not completely wrong at some point, but is now part of history." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-05"^^xsd:date ;
            ns2:text "Annual review OK" ] ;
