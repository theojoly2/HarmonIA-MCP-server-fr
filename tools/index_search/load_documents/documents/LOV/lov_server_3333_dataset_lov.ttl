<https://w3id.org/squap/> a ns1:Vocabulary ;
    dcterms:description "Quality, architecture, and process are considered the keystones of software engineering. ISO defines them in three separate standards. However, their interaction has been poorly studied, so far. The SQuAP model (Software Quality, Architecture, Process) describes twenty-eight main factors that impact on software quality in banking systems, and each factor is described as a relation among some characteristics from the three ISO standards. Hence, SQuAP makes such relations emerge rigorously, although informally. SQaAP-Ont is an OWL ontology that formalises those relations in order to represent and reason via Linked Data about software engineering in a three-dimensional model consisting of quality, architecture, and process characteristics."@en ;
    dcterms:issued "2018-05-15"^^xsd:date ;
    dcterms:modified "2019-07-16"^^xsd:date ;
    dcterms:title "SQuAP Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://es.linkedin.com/in/albafernandezizquierdo> ;
            ns3:date "2019-07-16"^^xsd:date ;
            ns2:text "Added to LOV" ] ;
    vann:preferredNamespacePrefix "sw-quality" ;
    vann:preferredNamespaceUri "https://w3id.org/squap/SoftwareQuality/" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/sw-quality/versions/2019-07-16.n3> ;
    dcat:keyword "Industry",
        "Quality" .

