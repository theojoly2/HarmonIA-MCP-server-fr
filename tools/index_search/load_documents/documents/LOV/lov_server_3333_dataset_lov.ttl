    dcterms:title "Linking Ancient World Data Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-01-25"^^xsd:date ;
