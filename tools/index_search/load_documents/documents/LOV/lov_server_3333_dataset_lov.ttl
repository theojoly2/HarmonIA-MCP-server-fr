        <https://plus.google.com/110226223773711201876> ;
    dcterms:creator <http://data.semanticweb.org/person/konstantinos-kotis> ;
    dcterms:description "Simple ontology developed for integration purposes. Describe helpdesk entities used to record support tickets for diagnosis and resolve purpuses. The ontology re-uses a) W3C ORG and REGORG ontologies, b) DUL upper ontology, and c) GoodRelations ontology."@en ;
    dcterms:issued "2013-04-10"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/ell>,
        <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2013-04-24"^^xsd:date ;
    dcterms:title "HelpDesk support Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-01-18"^^xsd:date ;
            ns2:text "Annual review- no change" ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2013-08-31"^^xsd:date ;
            ns2:text "There is no content negotiation implemented." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-11-04"^^xsd:date ;
            ns2:text "Annual review OK" ] ;
    vann:preferredNamespacePrefix "hdo" ;
    vann:preferredNamespaceUri "http://www.samos.gr/ontologies/helpdeskOnto.owl#" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/hdo/versions/2013-04-25.n3> ;
    dcat:keyword "Support" ;
    foaf:homepage "http://www.samos.gr/ontologies/helpdeskOnto.html" .

<http://www.sealitproject.eu/ontology/> a ns1:Vocabulary ;
    dcterms:creator <https://orcid.org/0000-0001-5086-7284>,
        <https://orcid.org/0000-0002-6006-0844>,
        <https://orcid.org/0000-0003-2788-526X> ;
    dcterms:description "The SeaLiT Ontology is a formal ontology intended to facilitate the integration, mediation and interchange of heterogeneous information related to maritime history. It aims at providing the semantic definitions needed to transform disparate, localised information sources of maritime history into a coherent global resource. It also serves as a common language for domain experts and IT developers to formulate requirements and to agree on system functionalities with respect to the correct handling of historical information. The ontology uses and extends the CIDOC Conceptual Reference Model (ISO 21127:2014), in particular version 7.1.1, as a general ontology of human activity, things and events happening in space and time."@en ;
    dcterms:issued "2022-06-21"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2022-06-01"^^xsd:date ;
    dcterms:title "SeaLiT Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2022-09-21"^^xsd:date ;
            ns2:text "Ontology added in LOV" ] ;
    vann:preferredNamespacePrefix "sealit" ;
    vann:preferredNamespaceUri "http://www.sealitproject.eu/ontology/" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/sealit/versions/2022-06-02.n3> ;
    dcat:keyword "Events",
        "Travel" .

