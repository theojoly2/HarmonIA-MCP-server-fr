<http://umbel.org/umbel> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/michael-bergman>,
        <https://plus.google.com/113451969262574338906> ;
    dcterms:description "UMBEL provides a general vocabulary of classes and predicates for describing domain ontologies, with the specific aim of promoting interoperability with external datasets and domains."@en ;
    dcterms:issued "2008-07-16"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2014-08-27"^^xsd:date ;
    dcterms:title "Upper Mapping and Binding Exchange Layer"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2020-08-06"^^xsd:date ;
            ns2:text "Umbel has been retired on the end of 2019(and the domain name has been bought) see https://www.mkbergman.com/2229/umbel-to-be-retired-by-end-of-2019/. The successor seems to be KBpedia at https://github.com/Cognonto/kbpedia" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2018-04-23"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-07-31"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-07-30"^^xsd:date ;
            ns2:text "Updated version history from GitHub information. No date in the RDF file, no change of version number since first v1 release." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-12-16"^^xsd:date ;
            ns2:text "UMBEL has made an impressive effort to provide interlinking and inteoperability of vocabularies, but its adoption in data does not seem to have happened yet." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2012-10-04"^^xsd:date ;
            ns2:text "The time line is the one of UMBEL globally, the UMBEL vocabulary being only a part of it. See http://umbel.org/ and http://techwiki.umbel.org/index.php/UMBEL_-_Annex_B for more details." ] ;
