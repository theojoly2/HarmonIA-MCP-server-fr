dc: a ns1:Vocabulary ;
    dcterms:creator <http://purl.org/dc/aboutdcmi#DCMI> ;
    dcterms:description "The Dublin Core Metadata Element Set is a vocabulary of fifteen properties for use in resource description. The name \"Dublin\" is due to its origin at a 1995 invitational workshop in Dublin, Ohio; \"core\" because its elements are broad and generic, usable for describing a wide range of resources."@en ;
    dcterms:issued "2012-06-14"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2012-06-13"^^xsd:date ;
    dcterms:publisher <http://purl.org/dc/aboutdcmi#DCMI> ;
    dcterms:title "Dublin Core Metadata Element Set"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2019-10-21"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-07-11"^^xsd:date ;
            ns2:text "Annual review done! Added the first issue date in this review." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-13"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-06-17"^^xsd:date ;
            ns2:text "Although \"dc\" is often used as the prefix for this vocabulary, it's also sometimes used for DC terms, so we preferred to use the less ambiguous \"dce\" and \"dcterms\" in LOV. See usage at http://prefix.cc/dc, http://prefix.cc/dce, http://prefix.cc/dcterms, and more discussion at http://bit.ly/uPuUTT." ] ;
    vann:preferredNamespacePrefix "dce" ;
    vann:preferredNamespaceUri "http://purl.org/dc/elements/1.1/" ;
