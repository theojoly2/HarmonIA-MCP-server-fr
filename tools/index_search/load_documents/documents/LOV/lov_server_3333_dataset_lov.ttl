        <http://id.loc.gov/vocabulary/iso639-2/spa> ;
    dcterms:modified "2020-02-04"^^xsd:date ;
    dcterms:publisher <https://www.w3.org/2017/dxwg/wiki/Main_Page> ;
    dcterms:title "Data Catalog Vocabulary"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2020-11-01"^^xsd:date ;
            ns2:text "Review - OK" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2020-03-26"^^xsd:date ;
            ns2:text "New version REC at https://www.w3.org/TR/vocab-dcat-2/. his new version of the vocabulary updates and expands the original but preserves backward compatibility." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2019-01-24"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2017-01-02"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-10-14"^^xsd:date ;
            ns2:text "Annual review - OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-06"^^xsd:date ;
            ns2:text "New versions since date of W3C Recommendation adding labels and comments in various languages, but no change in the URIs and semantics." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2014-11-06"^^xsd:date ;
            ns2:text "Added the implementation report of DCAT in rdfs:seeAlso property, instead of the link to the file in mercury previously at http://dvcs.w3.org/hg/gld/raw-file/default/dcat/index.html" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-03-03"^^xsd:date ;
            ns2:text "DCAT is a W3C Recommendation since 16 January 2014." ],
        [ a ns2:Review ;
            ns3:creator <http://google.com/+PierreYvesVandenbussche> ;
            ns3:date "2013-09-25"^^xsd:date ;
            ns2:text "RDF file has been synchronised and labels translated on 2013-09-25" ] ;
