<http://data.cochrane.org/ontologies/pico/> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/silver-oliver>,
        <https://plus.google.com/117790372940620323498>,
        <https://www.linkedin.com/in/julian-everett-1b50312b>,
        <mailto:cmavergames@cochrane.org>,
        <mailto:lbecker@cochrane.org> ;
    dcterms:description "The PICO ontology provides a machine accessible version of the PICO framework. It essentially provides a model for describing evidence in a consistent way. The model allows the specifying of complex populations, detailed interventions and their comparisons as well as the outcomes considered. The PICO ontology was originally designed to model the questions asked and answered in Cochrane's systematic reviews. As a leader in the field of evidence based healthcare Cochrane uses the PICO model when framing and publishing evidence based questions. The PICO model is widely adopted for describing healthcare evidence, furthermore is equally applicable in other evidence-based domains. It essentially provides a model for describing evidence in a consistent way."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2019-09-06"^^xsd:date ;
    dcterms:publisher <https://www.cochrane.org/> ;
    dcterms:title "Cochrane PICO Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <http://google.com/+PierreYvesVandenbussche> ;
            ns3:date "2020-04-10"^^xsd:date ;
            ns2:text "The PICO ontology allows to represent the PICO process in LD. https://en.wikipedia.org/wiki/PICO_process" ] ;
    vann:preferredNamespacePrefix "pico" ;
    vann:preferredNamespaceUri "http://data.cochrane.org/ontologies/pico/" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/pico/versions/2019-09-06.n3> ;
    dcat:keyword "Health",
