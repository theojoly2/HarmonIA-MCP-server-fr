        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-06-08"^^xsd:date ;
            ns2:text "The Machine-to-Machine Measurement (M3) lite taxonomy is designed for the FIESTA-IOT H2020 EU project to enables semantically annotating heterogeneous IoT." ] ;
    vann:preferredNamespacePrefix "m3lite" ;
    vann:preferredNamespaceUri "http://purl.org/iot/vocab/m3-lite#" ;
