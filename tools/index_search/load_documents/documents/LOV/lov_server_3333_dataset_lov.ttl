<http://semanticscience.org/ontology/sio.owl> a ns1:Vocabulary ;
    dcterms:creator <https://orcid.org/0000-0003-4727-9435> ;
    dcterms:description "The semanticscience integrated ontology (SIO) provides a simple, integrated ontology (types, relations) for objects, processes and their attributes. This project provides foundational support for the Bio2RDF (http://bio2rdf.org) and SADI (http://sadiframework.org) projects."@en ;
    dcterms:issued "2010-03-28"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2016-09-27"^^xsd:date ;
    dcterms:title "Semanticscience Integrated Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-11-26"^^xsd:date ;
            ns2:text "Added new version detected" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-04-22"^^xsd:date ;
            ns2:text "Updated version history, but still no date in the files and some version number are missing. To check with the publisher." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-12-05"^^xsd:date ;
            ns2:text "Despite the \"simple\" in the description, actually a rich and expressive vocabulary to describe science facts in various fields." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-05-18"^^xsd:date ;
            ns2:text "Date of the last version is the one of upload. No date in the vocabulary file. The LOV-Bot has missed a few versions." ] ;
    vann:preferredNamespacePrefix "sio" ;
    vann:preferredNamespaceUri "http://semanticscience.org/resource/" ;
