<http://rdf.muninn-project.org/ontologies/appearances> a ns1:Vocabulary ;
    dcterms:creator <http://rdf.muninn-project.org/ontologies/appearances#adriel>,
        <http://rdf.muninn-project.org/ww1/2011/11/11/Person/Warren> ;
    dcterms:description "Appearances is an ontology that grew out of the need to record personal appearance details about individuals while taking into account errors of perception and translation between various diffferent standards. Originally it was meant to record physical caracteristics of Great War soldiers from their medical files, but it became evident that the resource was also useful for other purposes."@en ;
    dcterms:issued "2012-11-15"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng>,
        <http://id.loc.gov/vocabulary/iso639-2/fra> ;
    dcterms:modified "2012-11-15"^^xsd:date ;
