<http://www.w3.org/2001/02pd/rec54#> a ns1:Vocabulary ;
    dcterms:description "This is (the start of) an event-based model of the W3C process; e.g. RECdd is the class of Recommendation Director's Decisions; \\ti.e. messages to w3c-ac-members announcing a new W3C Recommendation."@en ;
    dcterms:issued "2003-09-14"^^xsd:date ;
    dcterms:modified "2014-06-11"^^xsd:date ;
    dcterms:publisher <http://www.w3.org/data#W3C> ;
    dcterms:title "Model of the W3C Process"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-08-28"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-23"^^xsd:date ;
            ns2:text "Yet another vocabulary in W3C namespace with not-so-good publication practice. No use of owl:Ontology to support metadata, classes and properties not declared explicitly must be inferred from RDFS semantics (presence of rdfs:subClassOf or rdfs:domain predicates)" ] ;
    vann:preferredNamespacePrefix "rec54" ;
    vann:preferredNamespaceUri "http://www.w3.org/2001/02pd/rec54#" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/rec54/versions/2014-06-12.n3> ;
    dcat:keyword "Metadata" .

