    dcterms:description "The Cochrane Core ontology describes the entities and concepts that exist in the domain of evidence based healthcare. It is used for the construction of the Cochrane Linked Data Vocabulary containing some 400k terms including Interventions (Drugs, Procedures etc), Populations (Age, Sex, Condition), and clinical Outcomes."@en ;
    dcterms:issued "2014-02-06"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2019-09-06"^^xsd:date ;
    dcterms:publisher <https://www.cochrane.org/> ;
    dcterms:title "Cochrane Core Vocabulary Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <http://google.com/+PierreYvesVandenbussche> ;
            ns3:date "2020-04-10"^^xsd:date ;
            ns2:text "Vocabulary to describe the domain of evidence based healthcare including Interventions (Drugs, Procedures etc), Populations (Age, Sex, Condition), and clinical Outcomes" ] ;
    vann:preferredNamespacePrefix "cochrane" ;
    vann:preferredNamespaceUri "http://data.cochrane.org/ontologies/core/" ;
