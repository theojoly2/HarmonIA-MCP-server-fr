<http://xmlns.com/wot/0.1/> a ns1:Vocabulary ;
    dcterms:description "Web Of Trust (wot) RDF vocabulary, described using W3C RDF Schema and the Web Ontology Language."@en ;
    dcterms:issued "2004-02-23"^^xsd:date ;
    dcterms:modified "2004-02-23"^^xsd:date ;
    dcterms:title "Web Of Trust"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2025-07-11"^^xsd:date ;
            ns2:text "Annual review. No changes." ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2022-09-16"^^xsd:date ;
            ns2:text "No change." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2017-10-10"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-07-19"^^xsd:date ;
            ns2:text "Annual review done!" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-07-16"^^xsd:date ;
            ns2:text "Like a few early RDF vocabularies, this one is explicitly importing RDFS and OWL. This is not considered a good practice anymore." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-06-05"^^xsd:date ;
            ns2:text "A precursor of various provenance and security vocabularies, with a focus on encryption and signature. Hosted in the DNS xmlns.com, currently owned by the FOAF Project (Dan Brickley). The RDFS file is linked from the html page, but no content negotiation is set up." ] ;
    vann:preferredNamespacePrefix "wot" ;
    vann:preferredNamespaceUri "http://xmlns.com/wot/0.1/" ;
    rdfs:isDefinedBy <http://xmlns.com/wot/0.1/index.rdf> ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/wot/versions/2004-02-23.n3> ;
    dcat:keyword "Quality",
        "Security" .

