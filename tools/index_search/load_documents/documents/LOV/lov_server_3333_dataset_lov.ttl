<https://w3id.org/vocab/olca> a ns1:Vocabulary ;
    dcterms:contributor <http://data.semanticweb.org/person/carlos-tejo-alonso>,
        <https://orcid.org/0000-0003-1562-6922> ;
    dcterms:creator <http://data.semanticweb.org/person/bernard-vatant> ;
    dcterms:description "A vocabulary defining annotations enabling loose coupling between classes and properties in ontologies. Those annotations define with some accuracy the expected use of properties, in particular across vocabularies, without the formal constraints entailed by the use of OWL or RDFS constructions"@en ;
    dcterms:issued "2013-02-07"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2020-05-31"^^xsd:date ;
    dcterms:title "Ontology Loose Coupling Annotation"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2020-06-01"^^xsd:date ;
            ns2:text "New URI now pointing to w3id.org/vocab/olca to solve conneg issues." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-01-31"^^xsd:date ;
            ns2:text "Dereferencing issue with the new namespace." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-11-24"^^xsd:date ;
            ns2:text "The html publication was relying on Parrot, but this service has some issues. No html documentation for now, only the Turtle file." ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2013-09-02"^^xsd:date ;
            ns2:text "Blog post about olca: http://bvatant.blogspot.com.es/2013/02/schemaorg-and-ontology-loose-coupling.html" ] ;
    vann:preferredNamespacePrefix "olca" ;
    vann:preferredNamespaceUri "https://w3id.org/vocab/olca#" ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/olca/versions/2013-02-07.n3>,
        <https://lov.linkeddata.es/dataset/lov/vocabs/olca/versions/2020-05-31.n3> ;
    dcat:keyword "Metadata" .

