<http://purl.org/reco#> a ns1:Vocabulary ;
    dcterms:description "The RECO ontology defines the vocabulary for representing preferences-as-constraints and preferences-as-ratings as RDF graphs. This lightweight vocabulary provides domain-independent means to describe user profiles in a coherent and context-aware way. RECO has been designed as an extension of both Friend-Of-A-Friend (FOAF) and Who Am I! (WAI) ontologies."@en ;
    dcterms:issued "2011-08-01"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2011-08-01"^^xsd:date ;
    dcterms:title "RECommendations Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-09-09"^^xsd:date ;
            ns2:text "Annual review - ok" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-04-03"^^xsd:date ;
            ns2:text "This vocabulary is a good starting point for modeling user profiles. However, it needs better metadata to be fully LOV compliant." ] ;
    vann:preferredNamespacePrefix "reco" ;
    vann:preferredNamespaceUri "http://purl.org/reco#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/reco/versions/2011-08-01.n3> ;
