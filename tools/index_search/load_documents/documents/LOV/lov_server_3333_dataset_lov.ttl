<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/aldo-gangemi> ;
    dcterms:description "The DOLCE+DnS Ultralite ontology. It is a simplification of some parts of the DOLCE Lite-Plus library (cf. http://www.ontologydesignpatterns.org/ont/dul/DLP397.owl)"@en ;
    dcterms:issued "2009-06-05"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng>,
        <http://id.loc.gov/vocabulary/iso639-2/ita> ;
