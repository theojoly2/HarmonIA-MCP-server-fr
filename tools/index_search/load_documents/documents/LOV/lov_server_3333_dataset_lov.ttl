<http://www.w3.org/ns/dx/prof> a ns1:Vocabulary ;
    dcterms:contributor <http://orcid.org/0000-0002-3884-3420>,
        <http://orcid.org/0000-0002-8742-7730>,
        <https://orcid.org/0000-0003-3499-8262> ;
    dcterms:creator <https://orcid.org/0000-0002-7878-2693> ;
    dcterms:description "This vocabulary is for describing relationships between standards/specifications, profiles of them and supporting artifacts such as validating resources.\\n\\nThis model starts with [http://dublincore.org/2012/06/14/dcterms#Standard](dct:Standard) entities which can either be Base Specifications (a standard not profiling any other Standard) or Profiles (Standards which do profile others). Base Specifications or Profiles can have Resource Descriptors associated with them that defines implementing rules for the it. Resource Descriptors must indicate the role they play (to guide, to validate etc.) and the formalism they adhere to (dct:format) to allow for content negotiation. A vocabulary of Resource Roles are provided alongside this vocabulary but that list is extensible."@en ;
    dcterms:issued "2018-02-16"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2018-02-16"^^xsd:date ;
    dcterms:publisher <https://www.w3.org/2017/dxwg/> ;
    dcterms:title "Profiles Vocabulary"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2020-08-14"^^xsd:date ;
            ns2:text "Ontology added into LOV" ] ;
    vann:preferredNamespacePrefix "prof" ;
    vann:preferredNamespaceUri "http://www.w3.org/ns/dx/prof/" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/prof/versions/2018-02-16.n3> ;
    dcat:keyword "Metadata",
        "RDF" .

