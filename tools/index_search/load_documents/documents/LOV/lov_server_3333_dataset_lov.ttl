<http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation.owl> a ns1:Vocabulary ;
    dcterms:creator <http://eil.utoronto.ca/profiles/foxpro.html> ;
    dcterms:description "Global City Indicator Foundation Ontology developed by the Information Engineering Group, Mechanical & Industrial Engineering, University of Toronto. Contains the foundation ontologies required to represent ISO 37120 city indicators, including Placenames, Time, Measurement, Provenance, Statistics, Validity and Trust. See: Fox, M.S., (2013), \"A Foundation Ontology for Global City Indicators\", Global City Institute Working Paper, Vol. 1, No.4, pp. 1-45. Global Cities Institute, University of Toronto. Updated 24 June 2014: http://www.eil. Based on the Global City Indicators Facility, University of Toronto: http://www.cityindicators.org/Deliverables/Core%20and%20Supporting%20Indicators%20Table%20SEPTEMBER%202011.pdf.\\n\\nContact: Mark S. Fox, msf@eil.utoronto.ca"@en ;
    dcterms:issued "2015-04-14"^^xsd:date ;
    dcterms:modified "2015-04-15"^^xsd:date ;
    dcterms:title "Global City Indicator Foundation Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-04-15"^^xsd:date ;
            ns2:text "An ontology with application in the domain of Smart cities to capture global indicators. Few metadata are expected in the vocabulary to improve its discovery and maintenance, as well as the submission of external ontologies reused by the current version of the vocabulary." ] ;
    vann:preferredNamespacePrefix "gci" ;
    vann:preferredNamespaceUri "http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation.owl#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/gci/versions/2015-04-15.n3> ;
    dcat:keyword "Society" .

<http://ontology.eil.utoronto.ca/ISO37120.owl> a ns1:Vocabulary ;
    dcterms:creator <http://eil.utoronto.ca/profiles/foxpro.html> ;
    dcterms:description "ISO 37120 – Sustainable Development and Resilience of Communities – Indicators for City Services and Quality of Life (under TC268)\\n\\nhttp://ontology.eil.utoronto.ca/ISO37120.html\\n\\nThis OWL file defines a class for each indicator defined in the ISO 37120 standard.  Names for each indicator are provided.  Text definitions are provided only for Economy, Education and Energy indicators, due to copyright restrictions imposed by ISO.  This file is meant to provide a single URI for each indicator.\\n\\nAn ontology for representing an indicator's supporting data plus meta information such as provenance, validity and trust can be found in:\\nhttp://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation.owl\\n\\nDocumentation of the ontology can be found in:\\nhttp://eil.utoronto.ca/smartcities/papers/GCI-Foundation-Ontology.pdf"@en ;
    dcterms:issued "2015-04-13"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2016-08-12"^^xsd:date ;
    dcterms:title "ISO 37120 indicator URIs"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-10-31"^^xsd:date ;
            ns2:text "Added a new version of the vocabulary." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-04-14"^^xsd:date ;
            ns2:text "This vocabulary reuses many other vocabularies for the Smart Cities domain. The documentation of the ontology can be found in the following paper:\\nhttp://eil.utoronto.ca/smartcities/papers/GCI-Foundation-Ontology.pdf" ] ;
    vann:preferredNamespacePrefix "iso37120" ;
    vann:preferredNamespaceUri "http://ontology.eil.utoronto.ca/ISO37120.owl#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/iso37120/versions/2015-04-13.n3>,
        <https://lov.linkeddata.es/dataset/lov/vocabs/iso37120/versions/2016-08-12.n3> ;
    dcat:keyword "General & Upper",
        "Society" ;
    foaf:homepage "http://ontology.eil.utoronto.ca/ISO37120.html" .

<http://ontology.eil.utoronto.ca/open311.owl> a ns1:Vocabulary ;
    dcterms:creator <http://eil.utoronto.ca/profiles/foxpro.html>,
        <soroosh@cs.toronto.edu> ;
    dcterms:description "Open 311 Ontology\\n\\nThis ontology generalizes the concepts that appear in 311 open data files published by several cities (Toronto, New York, Chicago, Vancouver) across North America.  It provides a generis representation of 311 data that other cities can map their data onto and be used as a means of achieving interoperability."@en ;
    dcterms:issued "2014-08-03"^^xsd:date ;
    dcterms:title "Open 311 Ontology: An Ontology for publishing a city's non-emergency events."@en ;
