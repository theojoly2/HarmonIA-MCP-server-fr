<http://ns.inria.fr/ludo> a ns1:Vocabulary ;
    dcterms:creator <http://oscarrodriguez.me/>,
        <https://orcid.org/0000-0001-5959-5561> ;
    dcterms:description "Ludo is an ontology created to enable the description and representation of Serious Games that use structured data published on the Web through the Linked Data as a knowledge base. From the representation of the players’ profile and their contextual information whithin the game, it is possible to generate personalized recommendations of related educational resources in order to stimulate the learning process while playing."@en ;
    dcterms:issued "2015-02-01"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2016-05-10"^^xsd:date ;
    dcterms:publisher <http://dbpedia.org/resource/National_Institute_for_Research_in_Computer_Science_and_Control> ;
    dcterms:title "Ludo Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-05-12"^^xsd:date ;
            ns2:text "LUDO is a modularize vocabulary where the main RDF file contains only imports to our other resulting module." ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2016-05-10"^^xsd:date ;
            ns2:text "Added into LOV" ] ;
    vann:preferredNamespacePrefix "ludo" ;
    vann:preferredNamespaceUri "http://ns.inria.fr/ludo" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/ludo/versions/2016-05-10.n3> ;
    dcat:keyword "Games" .

<http://ns.inria.fr/ludo/v1/virtualcontext#> a ns1:Vocabulary ;
    dcterms:creator <http://oscarrodriguez.me/>,
        <https://orcid.org/0000-0001-5959-5561> ;
    dcterms:description "Given the increasing amount of structured data published on the Web, many possibilities are open for creating new types of games that use resources from the Web of Data. In particular, if we consider the subcategory of Serious Games in which the object of the game is to educate the user through the interactive discovery of real-life concepts (associated to Semantic Web resources), the inclusion of a semantic representation of the user profile and his contextual information becomes an important element to recommend the user more accurate concepts. Ludo is an ontology that allows the creation of Serious Games with those characteristics."@en,
        "This vocabulary is a component of Ludo. It was created to describe and represent the virtual context of a game player in a serious game."@en ;
    dcterms:issued "2016-02-01"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2016-08-26"^^xsd:date ;
    dcterms:publisher <http://dbpedia.org/resource/National_Institute_for_Research_in_Computer_Science_and_Control> ;
    dcterms:title "Ludo - Virtual Context"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2016-08-26"^^xsd:date ;
            ns2:text "Included in LOV. This is one of the ontologies imported by LUDO." ] ;
    vann:preferredNamespacePrefix "ludo-vc" ;
    vann:preferredNamespaceUri "http://ns.inria.fr/ludo/v1/virtualcontext#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/ludo-vc/versions/2016-08-26.n3> ;
    dcat:keyword "Games" .

