<http://vocab.deri.ie/void> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/jun-zhao>,
        <http://data.semanticweb.org/person/keith-alexander>,
        <http://richard.cyganiak.de/foaf.rdf#cygri>,
        <https://plus.google.com/102497386507936526460> ;
    dcterms:description "The Vocabulary of Interlinked Datasets (VoID) is an RDF Schema vocabulary for expressing metadata about RDF datasets."@en ;
    dcterms:issued "2010-01-26"^^xsd:date ;
    dcterms:modified "2011-03-06"^^xsd:date ;
    dcterms:title "Vocabulary of Interlinked Datasets"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2017-04-06"^^xsd:date ;
            ns2:text "No changes." ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2015-07-02"^^xsd:date ;
            ns2:text "http://rdfs.org/ns/void# does not seem to be working" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-05-04"^^xsd:date ;
            ns2:text "VoID is specified by a W3C Interest Group Note at http://www.w3.org/TR/void/, which is stable, including the namespace http://rdfs.org/ns/void#. This namespace used to redirect to http://vocab.deri.ie/void, which is declaring itself as the vocabulary URI in the RDF file. Unfortunately both URI and namespace are offline at the moment, future of vocab.deri.ie being unknown." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-04"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2013-06-03"^^xsd:date ;
            ns2:text "It is important to understand the relationship beween VoID and DCAT: In short, VoID is for data in RDF format, while DCAT is neutral with regards to format. (See the introduction section of DCAT vocabulary: http://www.w3.org/TR/vocab-dcat/)" ] ;
    vann:preferredNamespacePrefix "void" ;
    vann:preferredNamespaceUri "http://rdfs.org/ns/void#" ;
