<http://creativecommons.org/ns> a ns1:Vocabulary ;
    dcterms:description "The Creative Commons Rights Expression Language (CC REL) lets you describe copyright licenses in RDF"@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2008-03-03"^^xsd:date ;
    dcterms:publisher <http://dbpedia.org/resource/Creative_Commons> ;
    dcterms:title "Creative Commons Rights Expression Language"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2024-07-18"^^xsd:date ;
            ns2:text "Annual review OK." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-01-09"^^xsd:date ;
            ns2:text "Annual review OK." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-10-10"^^xsd:date ;
            ns2:text "A de facto standard for representation of rights. Used so far in the metadata of less than 10% of the LOV vocabularies, showing that most vocabulary publishers have no clear license or rights policy on their publication." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2012-01-18"^^xsd:date ;
            ns2:text "This vocabulary is still referenced by many other vocabularies through its historical URI http://web.resource.org/cc/. This URI is redirected, but should not be used anymore." ],
        [ a ns2:Review ;
