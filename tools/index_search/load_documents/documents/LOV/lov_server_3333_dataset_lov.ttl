    dcterms:title "FRAD model"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-08-01"^^xsd:date ;
            ns2:text "One update of the property without propagation to the vocabulary." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-12-04"^^xsd:date ;
            ns2:text "The namespace http://iflastandards.info/ns/ is dedicated to FRBR family of standards,and maintained in the Open Metadata Registry. Versioning policy at element level, history can be found using the RSS feed http://metadataregistry.org/schemahistory/feed/schema_id/24.rdf" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-23"^^xsd:date ;
            ns2:text "References http://metadataregistry.org/uri/profile/RegAp/ which is 404." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-23"^^xsd:date ;
            ns2:text "Added link to FRBRer" ] ;
    vann:preferredNamespacePrefix "frad" ;
    vann:preferredNamespaceUri "http://iflastandards.info/ns/fr/frad/" ;
    ns1:occurrencesInDatasets "454618"^^xsd:int ;
    ns1:reusedByDatasets "1"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    ns1:usageInDataset [ a ns1:DatasetOccurrences ;
