    dcterms:creator <http://d-nb.info/standards/elementset/agrelon#aenneLoehden> ;
    dcterms:description "The ontology of agent relationships, AgRelOn, defines relations of persons to other persons and to organisations"@en ;
    dcterms:issued "2011-06-30"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/deu>,
        <http://id.loc.gov/vocabulary/iso639-2/eng>,
        <http://id.loc.gov/vocabulary/iso639-2/ita>,
        <http://id.loc.gov/vocabulary/iso639-2/spa> ;
    dcterms:modified "2019-06-13"^^xsd:date ;
    dcterms:publisher <http://viaf.org/viaf/135877573> ;
    dcterms:title "Agent Relationship Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2022-09-16"^^xsd:date ;
            ns2:text "New version added. I can't find the code for v1.4" ],
        [ a ns2:Review ;
            ns3:creator <http://google.com/+PierreYvesVandenbussche> ;
            ns3:date "2016-01-05"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-09-02"^^xsd:date ;
            ns2:text "Defines a rich variety of specific relationships, which are modeled as classes. This modeling option allows representation of n-ary relationships and subsumption of relationship types. The counterpart is no link with other, simpler vocabularies in the same field (such as foaf or org)" ] ;
