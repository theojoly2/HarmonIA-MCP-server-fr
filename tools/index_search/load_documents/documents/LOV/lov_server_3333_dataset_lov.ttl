<http://www.w3.org/2006/vcard/ns> a ns1:Vocabulary ;
    dcterms:creator <http://google.com/+NormanWalsh>,
        <http://viaf.org/viaf/4700567>,
        <https://au.linkedin.com/in/riannella>,
        <https://plus.google.com/110896655318036448455> ;
    dcterms:description "This ontology models and represents vCards in RDF using current best practices"@en ;
    dcterms:issued "2001-02-22"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2014-05-21"^^xsd:date ;
    dcterms:publisher <http://www.w3.org/data#W3C> ;
    dcterms:title "An Ontology for vCards"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-07-08"^^xsd:date ;
            ns2:text "Still missing metadata. No changes." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-05-04"^^xsd:date ;
            ns2:text "Still no metadata, but the current version has a  owl:versionInfo \"Final\". Which I suppose means \"stable\"." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-05-22"^^xsd:date ;
            ns2:text "New version" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-05-13"^^xsd:date ;
            ns2:text "New W3C Draft, no metadata whatsoever in the RDF file." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-03-27"^^xsd:date ;
            ns2:text "Version history updated, added first historical 2001 version." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2013-05-24"^^xsd:date ;
            ns2:text "This version of vCard is still a draft, updating the previous version by aligning it with the latest IETF vCard specification (RFC6350). So, it is still a work in progress." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-09-29"^^xsd:date ;
            ns2:text "It's really too bad that this important vocabulary, published under the W3C namespace, does not reuse any external vocabulary, and does not provide any metadata." ] ;
    vann:preferredNamespacePrefix "vcard" ;
    vann:preferredNamespaceUri "http://www.w3.org/2006/vcard/ns#" ;
