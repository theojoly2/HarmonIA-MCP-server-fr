<https://www.gleif.org/ontology/ReportingException/> a ns1:Vocabulary ;
    dcterms:contributor <http://purl.org/bryon>,
        <http://www.workingontologist.com>,
        <https://www.linkedin.com/in/peterivett/> ;
    dcterms:creator <https://www.gleif.org/ontology/Base/GLEIF> ;
    dcterms:description "Ontology for representing exceptions to reporting of parents, for entities registered with a Legal Entity Identifier. The Global Legal Identifier System (GLEIS) requires that legal entities with an LEI provide information on their ultimate and direct accounting consolidating parents. Relationship reporting is mandatory with exceptions allowed for certain well-defined reasons. This ontology provides a simple structure for recording reasons for each exception by LEI."@en ;
    dcterms:issued "2019-02-01"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2019-02-01"^^xsd:date ;
    dcterms:title "Global Legal Entity Identifier Foundation Reporting Exception Ontology"@en ;
