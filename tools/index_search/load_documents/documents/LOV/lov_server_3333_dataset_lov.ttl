<http://reference.data.gov.au/def/ont/dataset> a ns1:Vocabulary ;
    dcterms:contributor <http://orcid.org/0000-0002-3884-3420>,
        <http://orcid.org/0000-0002-8742-7730>,
        <http://reference.data.gov.au/def/ont/d.lowe@bom.gov.au>,
        <https://plus.google.com/104729820378064014174> ;
    dcterms:description "The data.gov.au Dataset Ontology is an OWL ontology designed to describe the characteristics of datasets published on data.gov.au.\\n\\nThe ontology contains elements which describe the publication, update, origin, governance, spatial and temporal coverage and other contextual information about the dataset. The ontology also covers aspects of organisational custodianship and governance.\\n \\nBy using this ontology to describe datasets on data.gov.au publishers increase discoverability and enable the consumption of this information in other applications/systems as Linked Data. It further enables decentralised publishing of catalogs and facilitates federated dataset search across sites, e.g. in datasets that are published by the States.\\n \\nOther publishers of Linked Data may make assertions about data published using this ontology, e.g. they may publish information about the use of the dataset in other applications."@en ;
    dcterms:issued "2015-06-19"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2015-06-19"^^xsd:date ;
    dcterms:title "Dataset Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2018-04-19"^^xsd:date ;
            ns2:text "The data.gov.au Dataset Ontology is an OWL ontology designed to describe the characteristics of datasets published on data.gov.au" ] ;
    vann:preferredNamespacePrefix "donto" ;
    vann:preferredNamespaceUri "http://reference.data.gov.au/def/ont/dataset#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/donto/versions/2015-06-19.n3> ;
    dcat:keyword "Government",
        "Metadata" ;
    foaf:homepage "https://github.com/AGLDWG/dataset-ont" .

<http://reference.data.gov.au/def/ont/iso19160-1-address> a ns1:Vocabulary ;
    dcterms:creator <http://orcid.org/0000-0002-8742-7730> ;
    dcterms:description "This ontology is a version of the ISO TC211, Group for Ontology Management (GOM)'s OWL ontology interpretation of the ISO19160-1:2015 \"Addressing -- Part 1: Conceptual model\" standard (see https://www.iso.org/standard/61710.html) taken from that ontology's source code, published at https://github.com/ISO-TC211/GOM/tree/master/isotc211_GOM_harmonizedOntology/19160-1/2015."@en ;
    dcterms:issued "2017-11-27"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2017-11-27"^^xsd:date ;
    dcterms:title "ISO19160-1:2015 Address ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://www.linkedin.com/in/gabrielkepeklian> ;
            ns3:date "2017-12-25"^^xsd:date ;
            ns2:text "This version uses different URIs for the ontology so that they can be made to resolve through the Australian Government Linked Data Working Groups redirect services where the original ontology's URIs do not resolve.\\nThis version adds some metadata, such as this explanation, some further annotation properties to better display elements of the ontology and includes a human-readable (HTML) version of the ontology generated from the RDF version." ] ;
    vann:preferredNamespacePrefix "isoadr" ;
    vann:preferredNamespaceUri "http://reference.data.gov.au/def/ont/iso19160-1-address#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/isoadr/versions/2017-11-27.n3> ;
    dcat:keyword "Geography",
        "Quality",
        "Tag",
        "Vocabularies" ;
    foaf:homepage "http://pid.data.gov.au/websrv/reference/def/ont/iso19160-1-address/ont.ttl" .

