    ns2:hasReview [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-06-02"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-06-02"^^xsd:date ;
            ns2:text "Yet another small vocabulary at vocab.org. Should be stable and unlikely to evolve beyond this version 1.0. Mentions \"Chris Wallace\" in the list of authors, but this name could not be matched to any reliable URI." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-03"^^xsd:date ;
            ns2:text "Annual review - no change" ] ;
