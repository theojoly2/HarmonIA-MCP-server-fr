<http://www.w3.org/2003/01/geo/wgs84_pos> a ns1:Vocabulary ;
    dcterms:contributor <http://data.semanticweb.org/person/tim-berners-lee>,
        <https://www.linkedin.com/in/danbri/> ;
    dcterms:description "A vocabulary for representing latitude, longitude and   altitude information in the WGS84 geodetic reference datum."@en ;
    dcterms:issued "2003-01-10"^^xsd:date ;
    dcterms:modified "2009-04-19"^^xsd:date ;
    dcterms:publisher <http://www.w3.org/data#W3C> ;
    dcterms:title "WGS84 Geo Positioning"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-06-21"^^xsd:date ;
            ns2:text "Annual review - no changes." ],
        [ a ns2:Review ;
            ns3:creator <https://w3id.org/people/mpoveda/> ;
            ns3:date "2015-05-05"^^xsd:date ;
            ns2:text "Annual review -  no change. Website added." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-06-04"^^xsd:date ;
            ns2:text "Pretty basic but very much used in linked data, and reused in many vocabularies. While being published in the W3C namespace and wearing the signature of Sir Tim Berners-Lee himself, this vocabulary has no official status whatsoever. It's, like FOAF, a good exemple of de facto standard." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-04"^^xsd:date ;
            ns2:text "Annual review - no change" ] ;
    vann:preferredNamespacePrefix "geo" ;
    vann:preferredNamespaceUri "http://www.w3.org/2003/01/geo/wgs84_pos#" ;
    ns1:occurrencesInDatasets "711166"^^xsd:int ;
    ns1:reusedByDatasets "49"^^xsd:int ;
    ns1:reusedByVocabularies "27"^^xsd:int ;
