    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/s4inma/versions/2019-04-30.n3> ;
    dcat:keyword "Industry",
        "IoT" .

