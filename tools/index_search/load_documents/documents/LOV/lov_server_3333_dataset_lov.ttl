<http://purl.org/healthcarevocab/v1> a ns1:Vocabulary ;
    dcterms:creator <http://www.brunni.de/> ;
    dcterms:description "Ontology for healthcare metadata - especially metadata found in DICOM files (Digital Imaging and Communications in Medicine, see http://dicom.nema.org/). Author: Michael Brunnbauer, Bonubase GmbH (www.bonubase.com). The author's email address is brunni@netestate.de. See http://purl.org/healthcarevocab/v1help for explanations."@en ;
    dcterms:issued "2013-04-29"^^xsd:date ;
    dcterms:modified "2015-01-11"^^xsd:date ;
    dcterms:title "Healthcare metadata - DICOM ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-12-26"^^xsd:date ;
            ns2:text "Annual review OK. This page http://purl.org/healthcarevocab/v1help  explains the concepts of the vocabulary." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2013-07-13"^^xsd:date ;
            ns2:text "This vocabulary is a starter for DICOM experts. It has many long names and special conventions for naming classes/properties. It could have been great to have more comments and more use of external taxonomies." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-07-28"^^xsd:date ;
            ns2:text "By far the largest vocabulary in LOV, actually a candidate to be removed given this very size." ] ;
    vann:preferredNamespacePrefix "dicom" ;
    vann:preferredNamespaceUri "http://purl.org/healthcarevocab/v1#" ;
    rdfs:isDefinedBy <http://purl.org/healthcarevocab/v1> ;
