<https://w3id.org/seas/SystemOntology> a ns1:Vocabulary ;
    dcterms:creator <http://maxime-lefrancois.info#me> ;
    dcterms:description "The System Ontology defines Systems, Connections between systems, and Connection Points at which systems may be connected. This ontology is then specialized for multiple domains. For example:\\n\\n- In electric energy: \\n    - power systems consume, produce, store, and exchange electricity;\\n    - power connections are where electricity flows between systems;\\n    - power connection points are plugs, sockets, or power busses.\\n- In the electricity market:\\n    - players and markets are systems;\\n    - connections are contracts or transactions between two players, or between a player and a market;\\n    - connection points include offers and bids."@en ;
    dcterms:issued "2016-06-06"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2016-12-09"^^xsd:date ;
    dcterms:title "The SEAS System ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-12-09"^^xsd:date ;
            ns2:text "System Ontology module for the SEAS ontology" ] ;
    vann:preferredNamespacePrefix "seas-sys" ;
    vann:preferredNamespaceUri "https://w3id.org/seas/" ;
