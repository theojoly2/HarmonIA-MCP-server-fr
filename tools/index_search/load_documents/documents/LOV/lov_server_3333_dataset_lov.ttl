    dcat:keyword "Geography" ;
    foaf:homepage "http://linkedgeodata.org/Datasets" .

<http://lod.taxonconcept.org/ontology/txn.owl> a ns1:Vocabulary ;
    dcterms:creator <http://google.com/+PeterDeVriesWI> ;
    dcterms:description "This ontology and the related TaxonConcept data set mints identifiers that are tied to a specific species concept which can have several names and classifications."@en ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2013-05-19"^^xsd:date ;
    dcterms:publisher <http://lod.taxonconcept.org/ontology/txn.owl#TaxonConcept_Knowledge_Base_Project> ;
    dcterms:title "TaxonConcept Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2022-09-06"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-08-12"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-03-28"^^xsd:date ;
            ns2:text "Annual review - no change" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-05-19"^^xsd:date ;
            ns2:text "This vocabulary has an active policy of reusing as many as possible LOV vocabularies. The domain covered (living species and their observation) links biological taxonomy to geography (where the species are observed), people (making the observation), and methods. The approach should be usefully portable to other science domains. The version history has to be completed." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-04-17"^^xsd:date ;
            ns2:text "Annual review OK" ] ;
    vann:preferredNamespacePrefix "txn" ;
    vann:preferredNamespaceUri "http://lod.taxonconcept.org/ontology/txn.owl#" ;
    ns1:occurrencesInDatasets "37"^^xsd:int ;
    ns1:reusedByDatasets "2"^^xsd:int ;
    ns1:reusedByVocabularies "1"^^xsd:int ;
    ns1:usageInDataset [ a ns1:DatasetOccurrences ;
            ns1:inDataset <http://datahub.io/dataset/geospecies.8.rdf> ;
            ns1:occurrences "1"^^xsd:int ],
        [ a ns1:DatasetOccurrences ;
            ns1:inDataset <http://datahub.io/dataset/taxonconcept.0.rdf> ;
            ns1:occurrences "36"^^xsd:int ] ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/txn/versions/2012-05-25.n3>,
        <https://lov.linkeddata.es/dataset/lov/vocabs/txn/versions/2012-07-05.n3>,
