<http://bblfish.net/work/atom-owl/2006-06-06/> a ns1:Vocabulary ;
    dcterms:contributor <http://data.semanticweb.org/person/danny-ayers> ;
    dcterms:creator <https://plus.google.com/109693896432057207496> ;
    dcterms:description "The AtomOWL ontology is inspired from the work done by the atom working group. This ontology is working off the rfc 4287 published among othe places at http://www.atompub.org/rfc4287.html . The AtomOWL ontology uses as much as possible the same terms as the format there to make the relation easy to understand. The AtomOWL name space is slightly different from the atom namespace [see post http://www.imc.org/atom-syntax/mail-archive/msg16476.html]. But this is a good thing as it helps distinguish the ontology from the rfc 4287 serialisation."@en ;
    dcterms:issued "2005-10-22"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2006-06-26"^^xsd:date ;
    dcterms:title "Atom Syndication Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2024-07-18"^^xsd:date ;
            ns2:text "Problem to access the ontology" ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-10-06"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-04-03"^^xsd:date ;
            ns2:text "Fixed version history" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-04-09"^^xsd:date ;
            ns2:text "Annual review OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-04-13"^^xsd:date ;
            ns2:text "Vocabulary inserted into the LOV ecosystem. Other preliminary versions are available at the vocabulary homepage." ] ;
    vann:preferredNamespacePrefix "awol" ;
    vann:preferredNamespaceUri "http://bblfish.net/work/atom-owl/2006-06-06/#" ;
    rdfs:isDefinedBy <http://bblfish.net/work/atom-owl/2006-06-06/AtomOwl.ttl> ;
