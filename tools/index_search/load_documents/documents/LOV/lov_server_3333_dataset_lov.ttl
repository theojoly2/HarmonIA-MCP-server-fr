<http://ontology.eil.utoronto.ca/icontact.owl> a ns1:Vocabulary ;
    dcterms:creator <http://eil.utoronto.ca/profiles/foxpro.html> ;
    dcterms:description "This ontology provides basic classes and more detailed properties for  representating international street addresses, phone numbers and emails.  Rather than using existing ontologies, such as vcard, it was decided to create a new one as the vcard and foaf ignore the details of international addresses, phone numbers, etc."@en ;
    dcterms:issued "2015-04-16"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2015-04-16"^^xsd:date ;
    dcterms:title "International Contact Ontology: Addresses, phone numbers and emails."@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-04-21"^^xsd:date ;
            ns2:text "Yet another vocabulary for addresses and contacts, but providing expressivity for details such as operating days and hours for a contact, not necessarily found in other similar vocabularies." ] ;
    vann:preferredNamespacePrefix "ic" ;
    vann:preferredNamespaceUri "http://ontology.eil.utoronto.ca/icontact.owl#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
