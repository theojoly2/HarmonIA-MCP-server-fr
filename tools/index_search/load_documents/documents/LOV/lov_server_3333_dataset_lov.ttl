            ns2:text "Review according to final W3C recommendation." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-18"^^xsd:date ;
            ns2:text "Annual review OK" ] ;
