<http://purl.org/NET/c4dm/event.owl> a ns1:Vocabulary ;
    dcterms:creator <http://data.semanticweb.org/person/yves-raimond>,
        <https://lov.linkeddata.es/dataset/lov/lov.rdf#SamerAbdallah> ;
    dcterms:description "This ontology deals with the notion of reified events - events seen as first-class objects."@en ;
    dcterms:issued "2004-09-30"^^xsd:date ;
    dcterms:modified "2007-10-24"^^xsd:date ;
    dcterms:title "The Event Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
