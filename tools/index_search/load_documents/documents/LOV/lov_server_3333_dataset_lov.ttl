    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-01-23"^^xsd:date ;
            ns2:text "Fixed version history." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2012-09-26"^^xsd:date ;
            ns2:text "One would think that LoC, as the largest library in the world, would add minimal metadata to their vocabularies. This is unfortunately not the case. No history of this vocabulary is available." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-07-30"^^xsd:date ;
            ns2:text "Updated version history" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-08-26"^^xsd:date ;
            ns2:text "Quite similar to the RDA Roles vocabulary, with whom it shares more than 100 properies with the same label in the same context. Unfortunately those vocabularies are not linked." ] ;
