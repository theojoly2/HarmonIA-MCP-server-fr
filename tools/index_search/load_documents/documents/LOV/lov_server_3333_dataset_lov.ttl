<http://iflastandards.info/ns/fr/frad/> a ns1:Vocabulary ;
    dcterms:creator <https://plus.google.com/106472197598391391487> ;
    dcterms:description "This is the element set of native RDF classes and properties described in the Functional Requirements for Authority Data model. The model also uses elements previously described in the Functional Requirements for Bibliographic Records (FRBR) entity-relationship model."@en ;
