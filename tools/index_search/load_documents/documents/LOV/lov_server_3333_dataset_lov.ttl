    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2022-03-11"^^xsd:date ;
            ns2:text "The ontology is not available anymore as for today, 2022/03/11." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2019-10-21"^^xsd:date ;
            ns2:text "No available at the time of this review." ],
        [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2015-07-11"^^xsd:date ;
            ns2:text "Annual Review OK. It's still difficult to dereference the ontology from the URI." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2012-02-15"^^xsd:date ;
            ns2:text "Although this vocabulary does not match usual criteria of admission into LOV it has its place given its specific qualities of crowdsourcing and numerous multilingual labels, and the fact that it is backing a huge dataset." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-10-11"^^xsd:date ;
            ns2:text "Unfortunately the ontology as a whole has been off-line for months, only the separate elements are dereferenceable. The figures provided here (number of classes and properties) are therefore completely outdated." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-06-19"^^xsd:date ;
            ns2:text "Uploaded version from http://downloads.linkedgeodata.org/releases/2013-08-14/. Unfortunately this ontology is provided as a nt.gz archive. The namepsace is not available at review time, and it's unclear if it points to the current version. Updated figures from the uploaded version." ] ;
