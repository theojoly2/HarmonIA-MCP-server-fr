<https://w3id.org/cto> a ns1:Vocabulary ;
    dcterms:creator <https://www.researchgate.net/profile/Mathias_Bonduel> ;
    dcterms:description "The Construction Tasks Ontology (CTO) describes tasks operating on construction elements, spatial zones and/or damages.  The tasks are either planned or executed depending on the dataset metadata context of the dataset its used in. Five different types of tasks are defined: instalment, removal, modification, repair and inspection. \\nConsequences of tasks on the dataset, i.e. added and/or deleted triples, are modeled using reified statements. The tasks can link to a reified statement using the CTO relations."@en ;
    dcterms:issued "2020-12-18"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2021-02-26"^^xsd:date ;
    dcterms:title "CTO: Construction Tasks Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://es.linkedin.com/in/albafernandezizquierdo> ;
            ns3:date "2021-02-26"^^xsd:date ;
            ns2:text "Added to LOV" ] ;
    vann:preferredNamespacePrefix "cto" ;
    vann:preferredNamespaceUri "https://w3id.org/cto#" ;
    ns1:occurrencesInDatasets "0"^^xsd:int ;
    ns1:reusedByDatasets "0"^^xsd:int ;
    ns1:reusedByVocabularies "0"^^xsd:int ;
    dcat:distribution <https://lov.linkeddata.es/dataset/lov/vocabs/cto/versions/2021-02-26.n3> ;
    dcat:keyword "Industry" .

