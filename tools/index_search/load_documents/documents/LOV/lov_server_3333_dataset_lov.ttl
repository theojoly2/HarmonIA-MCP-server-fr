    dcterms:description "The Press.net Classification Ontology allows assets to be holistically classified using a controlled vocabulary or taxonomy."@en ;
    dcterms:issued "2011-07-27"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
    dcterms:modified "2012-09-24"^^xsd:date ;
    dcterms:title "Press.net Classification Ontology"@en ;
    ns2:hasReview [ a ns2:Review ;
            ns3:creator <https://orcid.org/0000-0003-1562-6922> ;
            ns3:date "2016-08-12"^^xsd:date ;
            ns2:text "Annual review - OK" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2015-03-25"^^xsd:date ;
            ns2:text "Annual review, no change" ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2013-04-14"^^xsd:date ;
            ns2:text "Relies on a PROTON module (protonsys) under the namespace http://proton.semanticweb.org/protonsys which seems deprecated, but versioning of PROTON is quite confusing." ],
        [ a ns2:Review ;
            ns3:creator <http://data.semanticweb.org/person/bernard-vatant> ;
            ns3:date "2014-04-09"^^xsd:date ;
            ns2:text "Annual review OK" ] ;
