    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/augmentedByExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/guide> ;
    skos:definition "An expression of a work that guides a user through the use of the predominant work, using notes, learning and study aids, exercises, problems, questions and answers, instructor or student materials, etc."@en .

<http://rdvocab.info/RDARelationshipsWEMI/guideToExpression> a rdf:Property ;
    rdfs:label "Guide to (Expression)"@en ;
    ns1:name "guideToExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
