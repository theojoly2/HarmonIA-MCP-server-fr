<http://rdvocab.info/RDARelationshipsWEMI/freelyTranslatedAsWork> a rdf:Property ;
    rdfs:label "Freely translated as (Work)"@en ;
    ns1:name "freelyTranslatedAsWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
