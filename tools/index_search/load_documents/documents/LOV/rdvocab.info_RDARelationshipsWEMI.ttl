        <http://rdvocab.info/RDARelationshipsWEMI/freeTranslationOf> ;
    skos:definition "An expression of a work that has been translated freely, preserving the spirit of the original, but not its linguistic details."@en .

<http://rdvocab.info/RDARelationshipsWEMI/freeTranslationOfWork> a rdf:Property ;
    rdfs:label "Free translation of (Work)"@en ;
    ns1:name "freeTranslationOfWork"@en ;
