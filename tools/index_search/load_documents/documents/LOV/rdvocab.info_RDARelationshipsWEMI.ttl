    skos:definition "A work that created by freely rendering the source work into another language, preserving the spirit of the original, but not its linguistic details."@en .

<http://rdvocab.info/RDARelationshipsWEMI/guideExpression> a rdf:Property ;
    rdfs:label "Guide (Expression)"@en ;
    ns1:name "guideExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
