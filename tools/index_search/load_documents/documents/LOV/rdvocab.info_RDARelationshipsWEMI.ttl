    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/augmentationOfWork>,
        <http://rdvocab.info/RDARelationshipsWEMI/guideTo> ;
    skos:definition "A work that is augmented by another work comprising material to help the user of the augmented work, such as notes, learning and study aids, exercises, problems, questions and answers, instructor or student materials, etc."@en .

<http://rdvocab.info/RDARelationshipsWEMI/guideWork> a rdf:Property ;
    rdfs:label "Guide (Work)"@en ;
    ns1:name "guideWork"@en ;
