@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://rdvocab.info/RDARelationshipsWEMI/abstractedIn> a rdf:Property ;
    rdfs:label "Abstracted in"@en ;
    ns1:name "abstractedIn"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/RDARelationshipsWEMI/abstractedInExpression> a rdf:Property ;
    rdfs:label "Abstracted in (Expression)"@en ;
    ns1:name "abstractedInExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "An expression of a work (an abstracting and indexing service) that abstracts the contents of a source entity."@en .

<http://rdvocab.info/RDARelationshipsWEMI/abstractedInWork> a rdf:Property ;
    rdfs:label "Abstracted in (Work)"@en ;
    ns1:name "abstractedInWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A work (an abstracting and indexing service) that abstracts the contents of a source entity."@en .

<http://rdvocab.info/RDARelationshipsWEMI/exemplarOfManifestation> a rdf:Property ;
    rdfs:label "Exemplar of manifestation"@en ;
    ns1:name "exemplarOfManifestation"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Manifestation> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A single exemplar or instance of a manifestation."@en .

<http://rdvocab.info/RDARelationshipsWEMI/expressionManifested> a rdf:Property ;
    rdfs:label "Expression manifested"@en ;
    ns1:name "expressionManifested"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Manifestation> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A physical embodiment of an expression."@en .

<http://rdvocab.info/RDARelationshipsWEMI/expressionOfWork> a rdf:Property ;
    rdfs:label "Expression of work"@en ;
    ns1:name "expressionOfWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A realization of the work in a form of alpha-numeric, musical or choreographic notation, sound, image, object, movement, etc., or any combination of such forms."@en .

<http://rdvocab.info/RDARelationshipsWEMI/manifestationExemplified> a rdf:Property ;
    rdfs:label "Manifestation exemplified"@en ;
    ns1:name "manifestationExemplified"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Item> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "The manifestation exemplified by an item."@en .

<http://rdvocab.info/RDARelationshipsWEMI/manifestationOfWork> a rdf:Property ;
    rdfs:label "Manifestation of work"@en ;
    ns1:name "manifestationOfWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A physical embodiment of an expression of a work."@en .

<http://rdvocab.info/RDARelationshipsWEMI/sequentialRelationshipItem> a rdf:Property ;
    rdfs:label "Sequential relationship (Item)"@en ;
    ns1:name "sequentialRelationshipItem"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Item> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/sequentialRelationship> .

<http://rdvocab.info/RDARelationshipsWEMI/sequentialRelationshipManifestation> a rdf:Property ;
    rdfs:label "Sequential relationship (Manifestation)"@en ;
    ns1:name "sequentialRelationshipManifestation"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Manifestation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/sequentialRelationship> .

<http://rdvocab.info/RDARelationshipsWEMI/workManifested> a rdf:Property ;
    rdfs:label "Work manifested"@en ;
    ns1:name "workManifested"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Manifestation> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A work embodied in a manifestation."@en .

<http://rdvocab.info/RDARelationshipsWEMI/alsoIssuedAs> a rdf:Property ;
    rdfs:label "Also issued as"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/alsoIssuedAsManifestation> ;
    ns1:name "alsoIssuedAs"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/RDARelationshipsWEMI/derivativeRelationshipExpression> a rdf:Property ;
    rdfs:label "Derivative relationship (Expression)"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/abridgedAsExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/abstractExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/adaptedAsExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/basedOnExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/basisForLibrettoExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/choreographyExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/digestExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/expandedAsExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/freelyTranslatedAsExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/imitatedAsExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/indexedInExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/musicalArrangementExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/musicalSettingExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/musicalVariationsExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/paraphrasedAsExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/remadeAsExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/summaryExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/translatedAsExpression> ;
    ns1:name "derivativeRelationshipExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/derivativeRelationship> ;
    skos:definition "An expression that is a modification of a source entity."@en .

<http://rdvocab.info/RDARelationshipsWEMI/descriptiveRelationshipsItem> a rdf:Property ;
    rdfs:label "Descriptive relationships (Item)"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/descriptionOfItem> ;
    ns1:name "descriptiveRelationshipsItem"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Item> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/descriptiveRelationships> .

<http://rdvocab.info/RDARelationshipsWEMI/descriptiveRelationshipsManifestation> a rdf:Property ;
    rdfs:label "Descriptive relationships (Manifestation)"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/descriptionOfManifestation> ;
    ns1:name "descriptiveRelationshipsManifestation"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Manifestation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/descriptiveRelationships> .

<http://rdvocab.info/RDARelationshipsWEMI/dramatizationOfExpression> a rdf:Property ;
    rdfs:label "Dramatization of (Expression)"@en ;
    ns1:name "dramatizationOfExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/dramatizationOf> ;
    skos:definition "An expression of a work that has been adapted as a drama."@en .

<http://rdvocab.info/RDARelationshipsWEMI/equivalenceRelationshipsItem> a rdf:Property ;
    rdfs:label "Equivalence relationships (Item)"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/reproductionOfItem> ;
    ns1:name "equivalenceRelationshipsItem"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Item> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/equivalenceRelationships> ;
    skos:definition "An item embodying the same expression of a work."@en .

<http://rdvocab.info/RDARelationshipsWEMI/equivalenceRelationshipsManifestation> a rdf:Property ;
    rdfs:label "Equivalence relationships (Manifestation)"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/alsoIssuedAsManifestation>,
        <http://rdvocab.info/RDARelationshipsWEMI/mirrorSiteManifestation>,
        <http://rdvocab.info/RDARelationshipsWEMI/reproducedAsManifestation>,
        <http://rdvocab.info/RDARelationshipsWEMI/reproductionOfManifestation> ;
    ns1:name "equivalenceRelationshipsManifestation"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Manifestation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/equivalenceRelationships> ;
    skos:definition "A manifestation embodying the same expression of a work."@en .

<http://rdvocab.info/RDARelationshipsWEMI/filmedWithManifestation> a rdf:Property ;
    rdfs:label "Filmed with (Manifestation)"@en ;
    ns1:name "filmedWithManifestation"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Manifestation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/issuedWithManifestation> ;
    skos:definition "A manifestation that is issued on the same carrier with the manifestation being described."@en .

<http://rdvocab.info/RDARelationshipsWEMI/librettoForExpression> a rdf:Property ;
    rdfs:label "Libretto for (Expression)"@en ;
    ns1:name "librettoForExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/librettoFor> ;
    skos:definition "An expression of a musical work such as an opera or other work for the musical stage, or an oratorio, that uses the text of the related work."@en .

<http://rdvocab.info/RDARelationshipsWEMI/motionPictureAdaptationOfExpression> a rdf:Property ;
    rdfs:label "Motion picture adaptation of (Expression)"@en ;
    ns1:name "motionPictureAdaptationOfExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/motionPictureAdaptationOf> ;
    skos:definition "An expression of a work that has been adapted as a motion picture."@en .

<http://rdvocab.info/RDARelationshipsWEMI/novelizationOfExpression> a rdf:Property ;
    rdfs:label "Novelization of (Expression)"@en ;
    ns1:name "novelizationOfExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/novelizationOf> ;
    skos:definition "An expression of a work that has been adapted as a novel."@en .

<http://rdvocab.info/RDARelationshipsWEMI/numberingOfPart> a rdf:Property ;
    rdfs:label "Numbering of part"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/numberingOfPartWork> ;
    ns1:name "numberingOfPart"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/RDARelationshipsWEMI/relatedWork> a rdf:Property ;
    rdfs:label "Related work"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/numberingOfPartWork> ;
    ns1:name "relatedWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A work related to the work represented by an identifier, a preferred access point, or a description (e.g., an adaptation, commentary, supplement, sequel, part of a larger work)."@en .

<http://rdvocab.info/RDARelationshipsWEMI/sequentialRelationshipExpression> a rdf:Property ;
    rdfs:label "Sequential relationship (Expression)"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/precededByExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/succeededByExpression> ;
    ns1:name "sequentialRelationshipExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/sequentialRelationship> .

<http://rdvocab.info/RDARelationshipsWEMI/sequentialRelationshipWork> a rdf:Property ;
    rdfs:label "Sequential relationship (Work)"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/precededByWork>,
        <http://rdvocab.info/RDARelationshipsWEMI/prequelWork>,
        <http://rdvocab.info/RDARelationshipsWEMI/succeededByWork> ;
    ns1:name "sequentialRelationshipWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/sequentialRelationship> .

<http://rdvocab.info/RDARelationshipsWEMI/summaryWork> a rdf:Property ;
    rdfs:label "Summary (Work)"@en ;
    ns1:name "summaryWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/derivativeWork> ;
    skos:definition "A work that comprises a brief recapitulation of the content of the source work."@en .

<http://rdvocab.info/RDARelationshipsWEMI/televisionAdaptationOfExpression> a rdf:Property ;
    rdfs:label "Television adaptation of (Expression)"@en ;
    ns1:name "televisionAdaptationOfExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/televisionAdaptationOf> ;
    skos:definition "An expression of a work that has been adapted as a television\\nprogram."@en .

<http://rdvocab.info/RDARelationshipsWEMI/verseAdaptationOfExpression> a rdf:Property ;
    rdfs:label "Verse adaptation of (Expression)"@en ;
    ns1:name "verseAdaptationOfExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/verseAdaptationOf> ;
    skos:definition "An expression of a work that has been adapted as a literary composition in verse form."@en .

<http://rdvocab.info/RDARelationshipsWEMI/BasisForLibrettoWork> a rdf:Property ;
    rdfs:label "Basis for libretto (Work)"@en ;
    ns1:name "BasisForLibrettoWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/basisForLibretto>,
        <http://rdvocab.info/RDARelationshipsWEMI/derivativeWork> ;
    skos:definition "A work that comprises the text of an opera or other work for the musical stage, or an oratorio, based on the source work."@en .

<http://rdvocab.info/RDARelationshipsWEMI/abridgedAs> a rdf:Property ;
    rdfs:label "Abridged as"@en ;
    ns1:hasSubproperty <http://rdvocab.info/RDARelationshipsWEMI/abridgedAsExpression>,
        <http://rdvocab.info/RDARelationshipsWEMI/abridgedAsWork> ;
    ns1:name "abridgedAs"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: .

<http://rdvocab.info/RDARelationshipsWEMI/abridgedAsExpression> a rdf:Property ;
    rdfs:label "Abridged as (Expression)"@en ;
    ns1:name "abridgedAsExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/abridgedAs>,
        <http://rdvocab.info/RDARelationshipsWEMI/derivativeExpression> ;
    skos:definition "An expression of a work that shortens the source entity without changing the general meaning or manner of presentation."@en .

<http://rdvocab.info/RDARelationshipsWEMI/abridgedAsWork> a rdf:Property ;
    rdfs:label "Abridged as (Work)"@en ;
    ns1:name "abridgedAsWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/abridgedAs>,
        <http://rdvocab.info/RDARelationshipsWEMI/derivativeWork> ;
    skos:definition "A work that shortens the source work without changing the general meaning or manner of presentation."@en .

<http://rdvocab.info/RDARelationshipsWEMI/abridgementOfExpression> a rdf:Property ;
    rdfs:label "Abridgement of (Expression)"@en ;
    ns1:name "abridgementOfExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/abridgementOf>,
        <http://rdvocab.info/RDARelationshipsWEMI/basedOnExpression> ;
    skos:definition "An expression of a work that has been abridged, i.e., shortened without changing the general meaning or manner of presentation of the source work."@en .

<http://rdvocab.info/RDARelationshipsWEMI/abridgementOfWork> a rdf:Property ;
    rdfs:label "Abridgement of (Work)"@en ;
    ns1:name "abridgementOfWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/abridgementOf>,
        <http://rdvocab.info/RDARelationshipsWEMI/basedOnWork> ;
    skos:definition "A work that has been abridged, i.e., shortened without changing the general meaning or manner of presentation of the source work."@en .

<http://rdvocab.info/RDARelationshipsWEMI/absorbedByExpression> a rdf:Property ;
    rdfs:label "Absorbed by (Expression)"@en ;
    ns1:name "absorbedByExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/absorbedBy>,
        <http://rdvocab.info/RDARelationshipsWEMI/succeededByExpression> ;
    skos:definition "An expression of a work that incorporates another entity."@en .

<http://rdvocab.info/RDARelationshipsWEMI/absorbedByWork> a rdf:Property ;
    rdfs:label "Absorbed by (Work)"@en ;
    ns1:name "absorbedByWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/absorbedBy>,
        <http://rdvocab.info/RDARelationshipsWEMI/succeededByWork> ;
    skos:definition "A work that incorporates another work."@en .

<http://rdvocab.info/RDARelationshipsWEMI/absorbedExpression> a rdf:Property ;
    rdfs:label "Absorbed (Expression)"@en ;
    ns1:name "absorbedExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/RDARelationshipsWEMI/absorbed>,
