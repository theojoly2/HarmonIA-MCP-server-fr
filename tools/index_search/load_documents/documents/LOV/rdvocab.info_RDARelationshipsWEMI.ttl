    skos:definition "A work that has been translated freely, preserving the spirit of the original, but not its linguistic details."@en .

<http://rdvocab.info/RDARelationshipsWEMI/freelyTranslatedAsExpression> a rdf:Property ;
    rdfs:label "Freely translated as (Expression)"@en ;
    ns1:name "freelyTranslatedAsExpression"@en ;
