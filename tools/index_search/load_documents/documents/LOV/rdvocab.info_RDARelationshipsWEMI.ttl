<http://rdvocab.info/RDARelationshipsWEMI/freeTranslationOfExpression> a rdf:Property ;
    rdfs:label "Free translation of (Expression)"@en ;
    ns1:name "freeTranslationOfExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
