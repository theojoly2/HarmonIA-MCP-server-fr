onto:ADL a owl:Class ;
    rdfs:label "ADL" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom onto:string ;
            owl:onProperty onto:has_Time ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_Time ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_have_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:Last_Activity ;
            owl:onProperty onto:has_Collect ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_Collect ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:Date ;
            owl:onProperty onto:has_have_date ],
        onto:Any .

onto:Bathroom_Activity a owl:Class ;
    rdfs:label "Bathroom_Activity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom onto:Bathroom ;
            owl:onProperty onto:has_location ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_location ],
        onto:Location_based_Activity .

onto:Sit a owl:Class ;
    rdfs:label "Sit" ;
    rdfs:subClassOf onto:Human_Posture .

onto:Activity_Log a owl:Class ;
    rdfs:label "Activity_Log" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_Time ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:string ;
            owl:onProperty onto:has_Time ],
        onto:Any .

onto:Entertainment a owl:Class ;
    rdfs:label "Entertainment" ;
    rdfs:subClassOf onto:Electric_Appliance .

onto:InferredActivity a owl:Class ;
    rdfs:label "InferredActivity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom onto:string ;
            owl:onProperty onto:has_rec_act_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:string ;
            owl:onProperty onto:has_rec_act_id ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_rec_act_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:Functional_Activity ;
            owl:onProperty onto:has_Have_activity ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_Have_activity ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_rec_act_id ],
        onto:Any .

onto:Last_Object a owl:Class ;
    rdfs:label "Last_Object" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_Object_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:integer ;
            owl:onProperty onto:has_Object_ID ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:ObjectInstance ;
            owl:onProperty onto:has_Object_info ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_Object_ID ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:string ;
            owl:onProperty onto:has_Object_name ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_Object_info ],
        onto:Activity_Log .

onto:has_Object_ID a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Last_Object onto:Object ) ] ;
