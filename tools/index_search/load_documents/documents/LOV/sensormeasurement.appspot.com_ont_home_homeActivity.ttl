onto:Cooking a owl:Class ;
    rdfs:label "Cooking" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:has_use ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:Refrigerator ;
            owl:onProperty onto:has_use ],
        [ a owl:Restriction ;
            owl:allValuesFrom onto:Electric_Stove ;
            owl:onProperty onto:has_use ],
        onto:Kitchen_Activity .

