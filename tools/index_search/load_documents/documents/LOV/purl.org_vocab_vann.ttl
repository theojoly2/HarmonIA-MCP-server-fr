@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://web.resource.org/cc/> .
@prefix onto: <http://purl.org/vocab/vann/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<file:///var/www/vocab.org/www/htdocs/vann/> a ns1:Work ;
    dcterms:type dcmitype:Text ;
    ns1:license <http://creativecommons.org/licenses/by/1.0/> .

onto:changes a owl:AnnotationProperty ;
    rdfs:label "Changes"@en ;
    rdfs:comment "A reference to a resource that describes changes between this version of a vocabulary and the previous."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:example a owl:AnnotationProperty ;
    rdfs:label "Example"@en ;
    rdfs:comment "A reference to a resource that provides an example of how this resource can be used."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:preferredNamespacePrefix a owl:AnnotationProperty ;
    rdfs:label "Preferred Namespace Prefix"@en ;
    rdfs:comment "The preferred namespace prefix to use when using terms from this vocabulary in an XML document."@en ;
    rdfs:isDefinedBy onto: .

onto:preferredNamespaceUri a owl:AnnotationProperty ;
    rdfs:label "Preferred Namespace Uri"@en ;
    rdfs:comment "The preferred namespace URI to use when using terms from this vocabulary in an XML document."@en ;
    rdfs:isDefinedBy onto: .

onto:termGroup a owl:AnnotationProperty ;
    rdfs:label "Term Group"@en ;
    rdfs:comment "A group of related terms in a vocabulary."@en ;
    rdfs:isDefinedBy onto: .

onto:usageNote a owl:AnnotationProperty ;
    rdfs:label "Usage Note"@en ;
    rdfs:comment "A reference to a resource that provides information on how this resource is to be used."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:seeAlso .

<http://vocab.org/vann/.rdf> a dcmitype:Text,
        foaf:Document ;
    dcterms:hasFormat <http://vocab.org/vann/.html>,
        <http://vocab.org/vann/.json>,
        <http://vocab.org/vann/.turtle> ;
    foaf:primaryTopic onto: ;
    foaf:topic onto: .

<http://creativecommons.org/licenses/by/1.0/> a ns1:License ;
    ns1:permits ns1:DerivativeWorks,
        ns1:Distribution,
        ns1:Reproduction ;
    ns1:requires ns1:Attribution,
        ns1:Notice .

<http://iandavis.com/id/me> a foaf:Person ;
    foaf:name "Ian Davis" .

<http://vocab.org/vann/.html> a dcmitype:Text,
        foaf:Document ;
    rdfs:label "HTML" ;
    dc:format "text/html" .

<http://vocab.org/vann/.json> a dcmitype:Text,
        foaf:Document ;
    rdfs:label "JSON" ;
    dc:format "application/json" .

<http://vocab.org/vann/.turtle> a dcmitype:Text,
        foaf:Document ;
    rdfs:label "Turtle" ;
    dc:format "text/plain" .

onto: a owl:Ontology ;
    dcterms:creator <http://iandavis.com/id/me> ;
    dcterms:date "2010-06-07" ;
    dcterms:description "This document describes a vocabulary for annotating descriptions of vocabularies with examples and usage notes."@en ;
    dcterms:identifier "http://purl.org/vocab/vann/vann-vocab-20050401" ;
    dcterms:isVersionOf onto: ;
    dcterms:replaces onto:vann-vocab-20040305 ;
    dcterms:rights "Copyright © 2005 Ian Davis" ;
    dcterms:title "VANN: A vocabulary for annotating vocabulary descriptions"@en ;
    onto:preferredNamespacePrefix "vann" ;
    onto:preferredNamespaceUri "http://purl.org/vocab/vann/" .

