@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/ipo/core#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <http://purl.org/ipo/core> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

ns1:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "A set of steps that perform an activity, but does not aim to solve a particular Issue.\\nCan be used to group multiple steps that are repeated in various Procedures to facilitate reuse."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:CompoundAction ;
    owl:disjointWith ns1:Procedure .

ns1:activates a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "activates"@en ;
    rdfs:comment "Indicates the action to be activated by a Step."@en ;
    rdfs:domain ns1:Step ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Action .

ns1:canDirectlyCause a owl:ObjectProperty ;
    rdfs:label "canDirectlyCause"@en ;
    rdfs:comment "An Issue can directly cause another Issue.\\nThis property aims to express a possible causal relationship, where an Issue can be direct cause of another Issue. For example, flu disease can cause pneumonia, i.e., in some cases, flu causes pneumonia and in another cases not."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:canCause ;
    owl:inverseOf ns1:canBeDirectlyCausedBy .

ns1:canDirectlyDependOn a owl:ObjectProperty ;
    rdfs:label "canDirectlyDependOn"@en ;
    rdfs:comment "Indicates that an Issue can directly depend on another Issue.\\nFor example, pneumonia can directly depend that the flu is cured to finally be treated."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:canDependOn ;
    owl:inverseOf ns1:canBeDirectDependenceOf .

ns1:causativeAssetOf a owl:ObjectProperty ;
    rdfs:label "causativeAssetOf"@en ;
    rdfs:comment "This property relates a Asset with a Issue caused by this Asset. For example, a virus associated with a disease caused by it."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:assetOf ;
    owl:inverseOf ns1:hasCausativeAsset .

ns1:depictionOf a owl:ObjectProperty ;
    rdfs:label "depictionOf"@en ;
    rdfs:comment "Indicates a IssueEntity illustrated by the image.\\nThis property is functional, i.e., an Image is related by this property with only one IssueEntity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf foaf:depicts ;
    owl:inverseOf ns1:hasDepiction .

ns1:directlyCauses a owl:ObjectProperty ;
    rdfs:label "directlyCauses"@en ;
    rdfs:comment "This property indicates that an Issue directly causes another Issue."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:causes ;
    owl:inverseOf ns1:directlyCausedBy .

ns1:directlyDependsOn a owl:ObjectProperty ;
    rdfs:label "directlyDependsOn"@en ;
    rdfs:comment "This relation indicates that a issue directly depends on another Issue."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:dependsOn ;
    owl:inverseOf ns1:directDependenceOf .

ns1:false a ns1:BooleanExpression,
        owl:NamedIndividual .

ns1:goal a owl:DatatypeProperty ;
    rdfs:label "goal"@en ;
    rdfs:comment "Indicates the description of the goal to be reached after the execution of Procedure."@en ;
    rdfs:domain ns1:Procedure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

ns1:hasDirectCategory a owl:ObjectProperty ;
    rdfs:label "hasDirectCategory"@en ;
    rdfs:comment "Indicates a category (skos: Concept) directly related to a IssueEntity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:hasCategory ;
    owl:inverseOf ns1:directCategoryOf .

ns1:hasIncoming a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasIncoming"@en ;
    rdfs:comment "Indicates the Transition that starts the execution of this Step."@en ;
    rdfs:domain ns1:Step ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Transition ;
    owl:inverseOf ns1:hasTarget .

ns1:hasMaker a owl:ObjectProperty ;
    rdfs:label "hasMaker"@en ;
    rdfs:comment "Indicates a Person or Organization (Party) who created or registered the IssueEntity. This property is also used by Asset class to relate to its manufacturer, developer, inventor, etc."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Asset ns1:IssueEntity ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Party ;
    rdfs:subPropertyOf foaf:maker ;
    owl:inverseOf ns1:makerOf .

ns1:hasMember a owl:ObjectProperty ;
    rdfs:label "hasMember"@en ;
    rdfs:comment "Indicates a Person who is a member of this Organization or another Organization that is member of this Organization, representing here a department or business unit.\\n"@en ;
    rdfs:domain ns1:Organization ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Party ;
    owl:inverseOf ns1:memberOf .

ns1:hostAssetOf a owl:ObjectProperty ;
    rdfs:label "hostAssetOf"@en ;
    rdfs:comment "Relates an Asset with a Issue that occurs in it.\\nThis property can be used to relate a person with a disease whose the person is where the disease occurs."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:assetOf ;
    owl:inverseOf ns1:hasHostAsset .

ns1:true a ns1:BooleanExpression,
        owl:NamedIndividual .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

dcterms:description a owl:DatatypeProperty .

dcterms:title a owl:DatatypeProperty .

ns1:Task a owl:Class ;
    rdfs:label "Task"@en ;
    rdfs:comment "One elementary and single action.\\nBeing an elementary task, it can not be decomposed into simpler actions."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Action .

ns1:canBeDirectDependenceOf a owl:ObjectProperty ;
    rdfs:label "canBeDirectDependenceOf"@en ;
    rdfs:comment "This property indicates an Issue that can be direct dependence of another Issue."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:canBeDependenceOf .

ns1:canBeDirectlyCausedBy a owl:ObjectProperty ;
    rdfs:label "canBeDirectlyCausedBy"@en ;
    rdfs:comment "An Issue can be  directly caused by another Issue."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:canBeCausedBy .

ns1:canCause a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "canCause"@en ;
    rdfs:comment "An Issue can cause another Issue directly or indirectly. \\nThis property aims to express a possible causal relationship and has the characteristic of transitivity, i.e., the Issue \"A\" can cause the Issue \"B\" and the Issue \"B\" can cause the Issue \"C\", then the Issue \"A\" can cause the Issue \"C\"."@en ;
    rdfs:domain ns1:Issue ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Issue ;
    owl:inverseOf ns1:canBeCausedBy .

ns1:canDependOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "canDependOn"@en ;
    rdfs:comment "Indicates that an Issue can depend on another Issue directly or indirectly.\\nThis property can express a dependency relationship between Issues and has the characteristic of transitivity, i.e., the Issue \"A\" can depend on the Issue \"B\" and the Issue \"B\" can depend on \"C\", then the Issue \"A\" can depend on the Issue \"C\"."@en ;
    rdfs:domain ns1:Issue ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Issue ;
    owl:inverseOf ns1:canBeDependenceOf .

ns1:categoryOf a owl:ObjectProperty ;
    rdfs:label "categoryOf"@en ;
    rdfs:comment "Indicates a IssueEntity classified in a skos:Concept."@en ;
    rdfs:isDefinedBy onto: ;
    owl:inverseOf ns1:hasCategory .

ns1:causes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "causes"@en ;
    rdfs:comment "Indicates that an Issue causes another Issue directly or indirectly.\\nThis property expresses a causal relationship between Issues and have the characteristic of transitivity, i.e., if the Issue \"A\" causes Issue \"B\" and the Issue \"B\" causes Issue \"C\", then the Issue \"A\" causes Issue \"C\"."@en ;
    rdfs:domain ns1:Issue ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Issue ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ns1:causedBy .

ns1:dependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "dependsOn"@en ;
    rdfs:comment "This property indicates that an Issue depends on another Issue directly or indirectly.\\nThis property expresses a dependence relationship between Issues and has the characteristic of transitivity, i.e. , if Issue \"A\" depends on the Issue \"B\", and the Issue \"B\" depends on Issue \"C\", then the Issue \"A\" depends on Issue \"C\"."@en ;
    rdfs:domain ns1:Issue ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Issue ;
    owl:inverseOf ns1:dependenceOf .

ns1:directCategoryOf a owl:ObjectProperty ;
    rdfs:label "directCategoryOf"@en ;
    rdfs:comment "Indicates a IssueEntity directly classified in a skos:Concept."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:categoryOf .

ns1:directDependenceOf a owl:ObjectProperty ;
    rdfs:label "directDependenceOf"@en ;
    rdfs:comment "Indicates that a Issue is direct dependence of another Issue."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:dependenceOf .

ns1:directlyCausedBy a owl:ObjectProperty ;
    rdfs:label "directlyCausedBy"@en ;
    rdfs:comment "Indicates that an Issue is directly caused by another Issue."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:causedBy .

ns1:hasCausativeAsset a owl:ObjectProperty ;
    rdfs:label "hasCausativeAsset"@en ;
    rdfs:comment "Indicates an Asset that is the causer of the Issue."@en ;
    rdfs:domain ns1:Issue ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:hasAsset .

ns1:hasDepiction a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasDepiction"@en ;
    rdfs:comment "Indicates an image that illustrates the IssueEntity.\\nSeeking a better description of IssueEntity, one can make use of this property to relate an illustrative image. For example, an image of a software screen containing an error occurred can help describe the problem."@en ;
    rdfs:domain ns1:IssueEntity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Image ;
    rdfs:subPropertyOf foaf:depiction .

ns1:hasFirstStep a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasFirstStep"@en ;
    rdfs:comment "A CompoundAction has one or more steps, so this property indicates the first step should be executed."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:hasStep .

ns1:hasGuardCondition a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasGuardCondition"@en ;
    rdfs:comment "Indicates a BooleanExpression for that a Transition occurs.\\nFor example, a Transition can have as guardCondition that the Step of origin be executed 10 times. So while this Step does is not executes 10 times, will not be started the Step of destination. This example illustrates a repeating structure within the workflow."@en ;
    rdfs:domain ns1:Transition ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:BooleanExpression .

ns1:hasHostAsset a owl:ObjectProperty ;
    rdfs:label "hasHostAsset"@en ;
    rdfs:comment "Indicates an Asset that is the host (harbourer) of the Issue."@en ;
    rdfs:domain ns1:Issue ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:hasAsset .

ns1:hasOutcoming a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasOutcoming"@en ;
    rdfs:comment "Indicates the Transition that occurs after execution of this Step and that activates the next Step to be executed."@en ;
    rdfs:domain ns1:Step ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Transition ;
    owl:inverseOf ns1:hasSource .

ns1:hasPostCondition a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasPostCondition"@en ;
    rdfs:comment "Indicates a postcondition (effect) will be reached after executing the Action."@en ;
    rdfs:domain ns1:Action ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:BooleanExpression .

ns1:hasPreCondition a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasPreCondition"@en ;
    rdfs:comment "Indicates a precondition for the Action be executed.\\n\\nA precondition may represent a prerequisite for execution of the Action, without which it is not guaranteed correct execution."@en ;
    rdfs:domain ns1:Action ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:BooleanExpression .

ns1:indicates a owl:ObjectProperty ;
    rdfs:label "indicates"@en ;
    rdfs:comment "This property relates a Issue indicated by this Symptom.\\nA Symptom may indicate many Issues, such as a Symptom of fever can indicate many diseases."@en ;
    rdfs:domain ns1:Symptom ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Issue ;
    owl:inverseOf ns1:indicatedBy .

ns1:makerOf a owl:ObjectProperty ;
    rdfs:label "makerOf"@en ;
    rdfs:comment "This property can be used to indicates an Asset created/manufactured by Party or a IssueEntity created/registered by the Party."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf foaf:made .

ns1:memberOf a owl:ObjectProperty ;
    rdfs:label "memberOf"@en ;
    rdfs:comment "Indicates a organization that the Party is participant.\\nThis property can be used to indicates that an employee is a member of an organization.\\nAnother approach is to use this property to relate two organizations thus representing a department that is a member of his company."@en ;
    rdfs:isDefinedBy onto: .

ns1:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Indicates a name to identify something."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

ns1:solvedBy a owl:ObjectProperty ;
    rdfs:label "solvedBy"@en ;
    rdfs:comment "Indicates a solution (Procedure) for this Issue."@en ;
    rdfs:isDefinedBy onto: .

ns1:solves a owl:ObjectProperty ;
    rdfs:label "solves"@en ;
    rdfs:comment "Indicates a Issue that this Procedure solves."@en ;
    rdfs:domain ns1:Procedure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Issue ;
    owl:inverseOf ns1:solvedBy .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

skos:broaderTransitive a owl:ObjectProperty .

foaf:Agent a owl:Class .

foaf:Image a owl:Class .

foaf:Organization a owl:Class .

foaf:Person a owl:Class .

foaf:depiction a owl:ObjectProperty .

foaf:depicts a owl:ObjectProperty .

foaf:made a owl:ObjectProperty .

foaf:maker a owl:ObjectProperty .

ns1:Asset a owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "Any \"thing\" that a IssueEntity is related. \\nFor example, a problem (disease) diagnosed in a patient, can have a virus and the patient as Asset, since the virus is the causative agent of the problem and the patient is the host in which the problem manifests itself.\\nAn Asset can be a person, an object, a report, a document, etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:title ;
            owl:someValuesFrom xsd:string ] .

ns1:Image a owl:Class ;
    rdfs:label "Image"@en ;
    rdfs:comment "An artifact that illustrates or records a visual perception.\\n\\nIt can be used to illustrate a IssueEntity seeking a better understanding of it."@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass foaf:Image .

ns1:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "Represents a group of people organized aiming at a common goal: social, commercial or political.\\nCan be used, for example, to represent a company that manufactures an Asset."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Party ;
    owl:disjointWith ns1:Person ;
    owl:equivalentClass foaf:Organization .

ns1:assetOf a owl:ObjectProperty ;
    rdfs:label "assetOf"@en ;
    rdfs:comment "Indicates a IssueEntity that is related to the Asset.\\nThis property can be used to facilitate retrieval records of problems related to the Asset."@en ;
    rdfs:isDefinedBy onto: ;
    owl:inverseOf ns1:hasAsset .

ns1:canBeCausedBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "canBeCausedBy"@en ;
    rdfs:comment "The Issue can be caused by another Issue directly or indirectly.\\nThis property is transitive, i.e., if the issue \"A\" can be caused by the issue \"B\" and the issue \"B\" can be caused by the issue \"C\", then the issue \"A\" can be caused by the issue \"C\"."@en ;
    rdfs:isDefinedBy onto: .

ns1:canBeDependenceOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "canBeDependenceOf"@en ;
    rdfs:comment "Indicates that an Issue can be a dependence of another Issue directly or indirectly.\\nThis property is also transitive, i.e., if the issue \"A\" can be dependence of the issue \"B\" and the issue \"B\" can be dependence of the issue \"C\", then the issue \"A\" can be dependence of the issue \"C\"."@en ;
    rdfs:isDefinedBy onto: .

ns1:causedBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "causedBy"@en ;
    rdfs:comment "Indicates that an Issue is caused by another Issue directly or indirectly.\\nThis property also has a transitive characteristic, i.e., if the Issue \"A\" is caused by Issue \"B\" and the Issue \"B\" is caused by Issue \"C\", then the Issue \"A\" is caused by Issue \"C\"."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns1:dependenceOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "dependenceOf"@en ;
    rdfs:comment "Indicates that an Issue is a dependence of another Issue directly or indirectly. \\nThis property also has a transitive characteristic, i.e. , if Issue \"A\" is dependence of the Issue \"B\", and the Issue \"B\" is dependence of Issue \"C\", then the Issue \"A\" is dependence of Issue \"C\"."@en ;
    rdfs:isDefinedBy onto: .

ns1:description a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Indicates text that describes something in detail."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description,
        rdfs:comment .

ns1:hasSource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasSource"@en ;
    rdfs:comment "Indicates the Step of origin of this Transition."@en ;
    rdfs:isDefinedBy onto: .

ns1:indicatedBy a owl:ObjectProperty ;
    rdfs:label "indicatedBy"@en ;
    rdfs:comment "Indicates a Symptom of this Issue."@en ;
    rdfs:isDefinedBy onto: .

ns1:title a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    rdfs:comment "Title (word or phrase) that briefly describes something."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title,
        rdfs:label .

skos:Concept a owl:Class .

ns1:CompoundAction a owl:Class ;
    rdfs:label "CompoundAction"@en ;
    rdfs:comment "An action composed of several other actions. A CompoundAction may have the goal of solving one or more Issues, representing a Procedure or not having an explicit goal, just be a group of Actions to be reused, behaving as an Activity. A CompoundAction has one or more execution steps that activate one Action (Task or other CompoundAction), thus allowing, that a compoundAction reuse another.\\nA CompoundAction can be used to create a workflow structure, aimed at better structuring of actions that compose it."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasFirstStep ;
            owl:someValuesFrom ns1:Step ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasStep ;
            owl:someValuesFrom ns1:Step ],
        ns1:Action ;
    owl:disjointWith ns1:Task .

ns1:Procedure a owl:Class ;
    rdfs:label "Procedure"@en ;
    rdfs:comment "A sequence of steps which, after executed solve one or more Issues.\\nA procedure has a number of steps that are executed in a specific sequence, one seeking to solve Issue."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:solves ;
            owl:someValuesFrom ns1:Issue ],
        ns1:CompoundAction .

ns1:Symptom a owl:Class ;
    rdfs:label "Symptom"@en ;
    rdfs:comment "Represents a sign or indication of one or more Issues. Something that is perceived when a problem occurs.\\n"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:indicates ;
            owl:someValuesFrom ns1:Issue ],
        ns1:IssueEntity .

ns1:hasAsset a owl:ObjectProperty ;
    rdfs:label "hasAsset"@en ;
    rdfs:comment "Indicates an Asset to IssueEntity, i.e., any \"thing\" which is related to IssueEntity."@en ;
    rdfs:domain ns1:IssueEntity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Asset .

ns1:hasCategory a owl:ObjectProperty ;
    rdfs:label "hasCategory"@en ;
    rdfs:comment "Indicates a category (skos: Concept) directly or indirectly related to a IssueEntity.\\nThe Concept class of SKOS ontology has properties that allow you to create hierarchies of categories (Concepts), still allowing express transitivity between categories. This approach should be used as an alternative to classification by subclass of IssueEntity when it are not intrinsic classifications, just grouping. For example, in the field of medicine, disease can be grouped as viral diseases, bacterial diseases, etc."@en ;
    rdfs:domain ns1:IssueEntity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    owl:propertyChainAxiom ( ns1:hasCategory skos:broaderTransitive ) .

ns1:hasStep a owl:ObjectProperty ;
    rdfs:label "hasStep"@en ;
    rdfs:comment "Indicates a Step that composes the compoundAction."@en ;
    rdfs:domain ns1:CompoundAction ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Step ;
    owl:propertyChainAxiom ( ns1:hasStep ns1:hasOutcoming ns1:hasTarget ) .

ns1:hasTarget a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasTarget"@en ;
    rdfs:comment "Indicates the Step of destination of this Transition."@en ;
    rdfs:isDefinedBy onto: .

ns1:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "This class represents a person.\\nCan be used, for example, to represent a person who works in an Organization, produces some Asset or records an IssueEntity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Party ;
    owl:equivalentClass foaf:Person .

ns1:Transition a owl:Class ;
    rdfs:label "Transition"@en ;
    rdfs:comment "An Transition represents a transition (passage) between two Steps. Each Transition has a Step of origin (source) and a Step of destination (target). A Transition has a guard condition that specifies a boolean condition for that the Transition to occur.\\nThrough the guard condition, can be implemented, in a simplified way, a workflow, establishing decision structures, repetition, choice, etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasGuardCondition ;
            owl:someValuesFrom ns1:BooleanExpression ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasTarget ;
            owl:someValuesFrom ns1:Step ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasSource ;
            owl:someValuesFrom ns1:Step ] .

ns1:Party a owl:Class ;
    rdfs:label "Party"@en ;
    rdfs:comment "A class representing a Person or an Organization, and it assumes a role of agent within the treated domain."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:name ;
            owl:someValuesFrom xsd:string ],
        foaf:Agent ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ns1:Organization ns1:Person ) ] .

ns1:Action a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "Represents an action to be performed. An Action can only be a primitive action (Task) or a set of actions (CompoundAction).\\nAn Action has a precondition that will enable the execution of the Action, and a postcondition (effect) which will be validated after running the Action."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasPreCondition ;
            owl:someValuesFrom ns1:BooleanExpression ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasPostCondition ;
            owl:someValuesFrom ns1:BooleanExpression ],
        ns1:IssueEntity .

ns1:IssueEntity a owl:Class ;
    rdfs:label "IssueEntity"@en ;
    rdfs:comment "A generic class representing the three main concepts within the domain of ontology: Symptom, Problem and Action."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:description ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns1:title ;
            owl:someValuesFrom xsd:string ] .

ns1:BooleanExpression a owl:Class ;
    rdfs:label "BooleanExpression"@en ;
    rdfs:comment "A logical expression whose value is true or false, aiming to validate a Transition between two Steps, or serve with a pre-condition for the execution of a Action or serve as a post-condition to validate the execution of an Action.\\nThis class has a description of the expression and two possible values: true or false. For these values, two instances are designed to be reused."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:description ;
            owl:someValuesFrom xsd:string ] .

ns1:Step a owl:Class ;
    rdfs:label "Step"@en ;
    rdfs:comment "A step to be performed within a CompoundAction. Every Step has an Action to be performed and a Transition to another Step to be performed after completing the execution of the Action. \\nWith Steps is possible to establish an order for the execution of Actions, as each Step has a Transition that sets the Step of origin and destination. Once a CompoundAction has an initial Step (IPO: hasFirstStep), from this Step can be run all other steps that composes the compoundAction following the Transition between them."@en ;
    rdfs:isDefinedBy onto: .

ns1:Issue a owl:Class ;
    rdfs:label "Issue"@en ;
    rdfs:comment "A problem or issue to be resolved. For example, something that is not operating normally or a hindrance to performing some task.\\nA Issue can be cause and/or caused, directly or indirectly, by another Issue, the same that the Issue A can depend on the Issue B, needing that the Issue B be solved before solving Issue A.\\nThe Issue can have a set of Actions (Procedures) that will fix it and also a Issue can be indicated by several Symptoms, where a set of Symptoms can identify a Issue."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:indicatedBy ;
            owl:someValuesFrom ns1:Symptom ],
        ns1:IssueEntity .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual,
        owl:Ontology ;
    rdfs:label "IPO - Issue Procedure Ontology"^^xsd:string ;
    ns2:license <http://creativecommons.org/licenses/by/3.0/> ;
    dc:creator "Mark Douglas de Azevedo Jacyntho"^^xsd:string,
        "Matheus Dimas de Morais"^^xsd:string ;
    dc:description <http://ipocore.sourceforge.net/1.2.0/ipo.png>,
        "The conceptual model of the Issue Procedure Ontology can be seen below, where their classes and properties are presented by means of a UML class diagram.\\nFor better understanding, the ontology can be divided into four modules:\\nIssueEntity\\nClasses: IssueEntity, Asset, Image, skos:Concept.\\n\\nProperties: directCategoryOf, hasDirectCategory, categoryOf, hasCategory, hasMaker, makerOf, hasAsset, assetOf, hasDepiction, depictionOf, title, description.\\n\\nPersons and Organizations\\nClasses: Party, Person e Organization\\n\\nProperties: hasMember, memberOf, name.\\n\\nProblems and Symptoms\\nClasses: Symptom, Issue.\\n\\nProperties: directlyCauses, directlyCausedBy, causes, causedBy, dependenceOf, dependsOn, directDependenceOf, directlyDependsOn, canDirectlyCause, canBeDirectlyCausedBy, canCause, canBeCausedBy, canBeDependenceOf, canDependOn, canBeDirectDependenceOf, canDirectlyDependOn, indicatedBy, indicates, hasCausativeAsset, causativeAssetOf, hasHostAsset, hostAssetOf.\\n\\nProblems and Solutions\\nClasses: Action, Task, CompoundAction, Procedure, Activity, Step, Transition, BooleanExpression.\\n\\nProperties: solves, solvedBy, hasFirstStep, hasStep, activates, hasSource, hasTarget, hasIncoming, hasOutcoming, hasGuardCondition, hasPostCondition, hasPreCondition, goal.\\n\\nClassifying a IssueEntity\\nThere are two ways of classifying a IssueEntity:\\n1 - A non-intrinsic classification, ie, a classification aiming a simple grouping of IssueEntities, where the IPO ontology provides ipo use of the property \"ipo:hasCategory\" linking to \"skos:Concept\", enabling the creation of schemes of categories and subcategories.\\n2 - A classification that is intrinsic to a IssueEntity, so that classification implies the creation of subclasses of IssueEntity with specific restrictions. For example, the \"Hard Disk Problem\" class being defined by a specific restriction that is being linked to at least one of the symptoms \"Error Reading File\" or \"Error Writing File\" (instances of Symptom class). Thus, resources can be classified based on the description of their symptoms, as an instance of the new class of \"Hard Disk Problem\" (HD)."^^xsd:string ;
    dc:language "en" ;
    dc:modified "2015-07-30"^^xsd:date ;
    dc:title "IPO - Issue Procedure Ontology"^^xsd:string ;
    dcterms:issued "2014-11-21"^^xsd:date ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:rights "This work is distributed under a Creative Commons Attribution License (http://creativecommons.org/licenses/by/3.0/)."@en ;
    vann:preferredNamespacePrefix "ipo" ;
    vann:preferredNamespaceUri "http://purl.org/ipo/core#" ;
    rdfs:comment "Vocabulary for describing issues (or problems) and corresponding symptoms and solutions to a broad variety of contexts. It is intended to provide a generic, reusable core ontology that can be extended or specialized for use in domain-specific situations, aimed at supporting linked data publishing. The solutions are represented by procedures, which are possible workflows for solving corresponding issues."^^xsd:string ;
    owl:versionIRI <http://purl.org/ipo/core/1.2.0> ;
    owl:versionInfo "1.2.0"^^xsd:string .

[] a ns1:Person .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Action ns1:Issue ns1:Symptom ) .

[] ns1:name "Mark Douglas de Azevedo Jacyntho"^^xsd:string .

[] ns1:name "Matheus Dimas de Morais"^^xsd:string .

[] a ns1:Person .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:BooleanExpression ns1:Image ns1:IssueEntity ns1:Party ns1:Step ns1:Transition skos:Concept ) .

