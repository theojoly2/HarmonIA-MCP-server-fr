@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <http://dati.isprambiente.it/ontology/core#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "Ispra Ontology"@en ;
    ns2:license <http://creativecommons.org/licenses/by/4.0/deed.it> ;
    dc:creator <http://regesta.exe/>,
        <http://www.isprambiente.gov.it/it/> ;
    dc:date "2015/12/14" ;
    dc:publisher <http://www.isprambiente.gov.it/it/> ;
    dc:title "Ispra Ontology"@en ;
    vann:preferredNamespacePrefix "ispra" ;
    vann:preferredNamespaceUri "http://dati.isprambiente.it/ontology/core#" ;
    owl:versionInfo "0.1.0" .

onto:Accelerometer a owl:Class ;
    rdfs:label "Accelerometer"@en ;
    rdfs:comment "Instrument"@en ;
    rdfs:subClassOf onto:Instrument ;
    ns1:term_status "stable" .

onto:AirPres a owl:Class ;
    rdfs:label "Atmospheric Pressure"@en ;
    rdfs:comment "Meteorological Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:AirTemp a owl:Class ;
    rdfs:label "Air Temperature"@en ;
    rdfs:comment "Meteorological Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:Anemometer a owl:Class ;
    rdfs:label "Anemometer"@en ;
    rdfs:comment "Instrument"@en ;
    rdfs:subClassOf onto:Instrument ;
    ns1:term_status "stable" .

onto:Barometer a owl:Class ;
    rdfs:label "Barometer"@en ;
    rdfs:comment "Instrument"@en ;
    rdfs:subClassOf onto:Instrument ;
    ns1:term_status "stable" .

onto:Conductivity a owl:Class ;
    rdfs:label "Conductivity"@en ;
    rdfs:comment "Quality Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:GeoFeature a owl:Class ;
    rdfs:label "Geographical feature"@en ;
    rdfs:subClassOf <http://www.geonames.org/ontology#Feature> ;
    ns1:term_status "stable" .

onto:Hydrometer a owl:Class ;
    rdfs:label "Hydrometer"@en ;
    rdfs:comment "Instrument"@en ;
    rdfs:subClassOf onto:Instrument ;
    ns1:term_status "stable" .

onto:HydrometricLevel a owl:Class ;
    rdfs:label "Hydrometric Level"@en ;
    rdfs:comment "Oceanographic Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:Hygrometer a owl:Class ;
    rdfs:label "Hygrometer"@en ;
    rdfs:comment "Instrument"@en ;
    rdfs:subClassOf onto:Instrument ;
    ns1:term_status "stable" .

onto:Intervention a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "A single action, funded under a plan for hydrogeological risk mitigation. It may consist of one or more related projects."@en ;
    rdfs:subClassOf <http://purl.org/procurement/public-contracts#Contract> ;
    ns1:term_status "stable" .

onto:MarineIndicator a owl:Class ;
    rdfs:label "Marine Indicator"@en ;
    rdfs:subClassOf onto:Indicator ;
    ns1:term_status "stable" .

onto:MultiParameterProbe a owl:Class ;
    rdfs:label "Multi Parameter Probe"@en ;
    rdfs:comment "Instrument"@en ;
    rdfs:subClassOf onto:Instrument ;
    ns1:term_status "stable" .

onto:PH a owl:Class ;
    rdfs:label "PH"@en ;
    rdfs:comment "Quality Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:Redox a owl:Class ;
    rdfs:label "Redox"@en ;
    rdfs:comment "Quality Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:RelativeHumidity a owl:Class ;
    rdfs:label "Relative Humidity"@en ;
    rdfs:comment "Meteorological Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:SoilUseIndicator a owl:Class ;
    rdfs:label "Use soil Indicator"@en ;
    rdfs:subClassOf onto:Indicator ;
    ns1:term_status "stable" .

onto:Sst a owl:Class ;
    rdfs:label "Sea Surface Temperature"@en ;
    rdfs:comment "Oceanographic Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:Termometer a owl:Class ;
    rdfs:label "Termometer"@en ;
    rdfs:comment "Instrument"@en ;
    rdfs:subClassOf onto:Instrument ;
    ns1:term_status "stable" .

onto:WaterTemperature a owl:Class ;
    rdfs:label "Water Temperature"@en ;
    rdfs:comment "Oceanographic Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:Wave a owl:Class ;
    rdfs:label "Wave"@en ;
    rdfs:comment "Oceanographic Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:Wind a owl:Class ;
    rdfs:label "Wind"@en ;
    rdfs:comment "Meteorological Parameter"@en ;
    rdfs:subClassOf onto:Parameter ;
    ns1:term_status "stable" .

onto:amountFinanced a owl:DatatypeProperty ;
    rdfs:label "Amount financed"@en ;
    rdfs:comment "Amount financed (in Euros)"@en ;
    rdfs:domain onto:Contract ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:averagingPeriod a owl:DatatypeProperty ;
    rdfs:label "Averaging Period"@en ;
    rdfs:comment "Frequency of final outputs (in Minutes or Hours)"@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:belongsTo a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Belongs to"@en ;
    rdfs:domain dcmitype:Collection ;
    rdfs:range org:OrganizationalUnit ;
    ns1:term_status "stable" .

onto:certainty a owl:ObjectProperty ;
    rdfs:label "Certainty"@en ;
    rdfs:comment "Certainty level of the observed data. It is defined as numerical scale starting from 0 (raw data). Eg L0, L1, L2, etc."@en ;
    rdfs:domain onto:MeasurementCollection ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:code a owl:DatatypeProperty ;
    rdfs:label "Code"@en ;
    rdfs:comment "ID code of the measurement station as assigned by national or international organizations."@en ;
    rdfs:domain onto:MeasureStation ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:contractingAuthority a owl:ObjectProperty ;
    rdfs:label "Contracting authority"@en ;
    rdfs:comment "This property connects class contract with a generic entity involved, with specific role, in the contract."@en ;
    rdfs:domain onto:Contract ;
    rdfs:range onto:AuthorityKind ;
    ns1:term_status "stable" .

onto:cup a owl:DatatypeProperty ;
    rdfs:label "Project Unit Code"@en ;
    rdfs:comment "It consists of a string of 15 alphanumeric characters, which accompanies each contract from the stage of formal resource allocation."@en ;
    rdfs:domain onto:Contract ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:diameter a owl:DatatypeProperty ;
    rdfs:label "Diameter"@en ;
    rdfs:comment "Diameter of the measure station."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:directionalResolution a owl:DatatypeProperty ;
    rdfs:label "Directional resolution"@en ;
    rdfs:comment "Directional resolution in degrees North (Omni-directional if 360ÃÂ°N)."@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:entity a owl:ObjectProperty ;
    rdfs:label "Entity"@en ;
    rdfs:comment "This property connects class AuthorityKind with the entity."@en ;
    rdfs:domain onto:AuthorityKind ;
    rdfs:range <http://purl.org/goodrelations/v1#BusinessEntity> ;
    ns1:term_status "stable" .

onto:generatedBy a owl:ObjectProperty ;
    rdfs:label "Generated by"@en ;
    rdfs:comment "Instruments that generate the measure."@en ;
    rdfs:domain onto:MeasurementCollection ;
    rdfs:range onto:Instrument ;
    ns1:term_status "stable" .

onto:hasAgreement a owl:ObjectProperty ;
    rdfs:label "Ha un accordo quadro"@en ;
    rdfs:comment "This property connects the contract with its framework agreement."@en ;
    rdfs:domain onto:Contract ;
    rdfs:range <http://purl.org/procurement/public-contracts#FrameworkAgreement> ;
    ns1:term_status "stable" .

onto:hasEconomicIndicator a owl:ObjectProperty ;
    rdfs:label "Has economic indicator"@en ;
    rdfs:comment "This property connects the Contract to its Economic Indicator"@en ;
    rdfs:domain onto:Contract ;
    rdfs:range onto:EconomicIndicator ;
    ns1:term_status "stable" .

onto:hasIter a owl:ObjectProperty ;
    rdfs:label "Has iter"@en ;
    rdfs:comment "This property connects the class Contract with its formal procedural steps."@en ;
    rdfs:domain onto:Contract ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:hasModel a owl:ObjectProperty ;
    rdfs:label "Has measure station model"@en ;
    rdfs:comment "This property connects the Measure Station with its model."@en ;
    rdfs:domain onto:MeasureStation ;
    rdfs:range onto:Model ;
    ns1:term_status "stable" .

onto:hasStep a owl:ObjectProperty ;
    rdfs:label "Has step"@en ;
    rdfs:comment "This property connects the Concept of the formal procedure with its relative steps."@en ;
    rdfs:domain onto:LotStep ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:hullType a owl:DatatypeProperty ;
    rdfs:label "Hull Type"@en ;
    rdfs:comment "Hull type of the measure station."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:instabilityGroup a owl:DatatypeProperty ;
    rdfs:label "Instability group"@en ;
    rdfs:domain onto:Instability ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:instabilityRelatedTo a owl:ObjectProperty ;
    rdfs:label "Instability related to"@en ;
    rdfs:comment "This property connects the class Instability to the contract."@en ;
    rdfs:domain onto:Instability ;
    rdfs:range onto:Contract ;
    ns1:term_status "stable" .

onto:instabilityType a owl:ObjectProperty ;
    rdfs:label "Instability type"@en ;
    rdfs:comment "This property connects the class Instability to the more specific Concept of instability."@en ;
    rdfs:domain onto:Instability ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:isDataOf a owl:ObjectProperty ;
    rdfs:label "Observed Parameter"@en ;
    rdfs:comment "This property connects the measured data in a given period with an observed parameter (eg. Wind, Wave) in a given place."@en ;
    rdfs:domain onto:MeasurementCollection ;
    rdfs:range onto:Parameter ;
    ns1:term_status "stable" .

onto:isDistrictAuthority a owl:DatatypeProperty ;
    rdfs:label "Is district authority"@en ;
    rdfs:comment "Boolean property that states if the authority act as district authority."@en ;
    rdfs:domain onto:AuthorityKind ;
    rdfs:range xsd:boolean ;
    ns1:term_status "stable" .

onto:isLotOf a owl:ObjectProperty ;
    rdfs:label "Is lot of"@en ;
    rdfs:comment "This property connects the Lot to the Contract."@en ;
    rdfs:domain onto:Contract ;
    rdfs:range onto:Contract ;
    ns1:term_status "stable" .

onto:isPrimary a owl:DatatypeProperty ;
    rdfs:label "Is primary instruments"@en ;
    rdfs:comment "Boolean value identifing the primary measuring instrument (TRUE) and any secondary instruments (FALSE) used in case of malfunctions or for backup and validation."@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range xsd:boolean ;
    ns1:term_status "stable" .

onto:iterStepType a owl:ObjectProperty ;
    rdfs:label "Iter step type"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:levelling a owl:DatatypeProperty ;
    rdfs:label "Levelling"@en ;
    rdfs:comment "Levelling activity useful to the definition of the referring level."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:levellingTime a owl:DatatypeProperty ;
    rdfs:label "Levelling Time"@en ;
    rdfs:comment "Time (Year) of the levelling activities."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:lithologyRelatedTo a owl:ObjectProperty ;
    rdfs:label "Lithology related to"@en ;
    rdfs:comment "This property connects the Lithology to the Contract."@en ;
    rdfs:domain onto:Lithology ;
    rdfs:range onto:Contract ;
    ns1:term_status "stable" .

onto:lithologyType a owl:ObjectProperty ;
    rdfs:label "Lithology type"@en ;
    rdfs:comment "This property connects the Lithology to the specific concept."@en ;
    rdfs:domain onto:Lithology ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:location a owl:DatatypeProperty ;
    rdfs:label "Location"@en ;
    rdfs:comment "Place in which the station is installed (in the case of tide gauges this place is related to the sea area in front of the station)."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:lot a owl:ObjectProperty ;
    rdfs:label "Lot"@en ;
    rdfs:comment "This property connects the class Lot Step to the contract."@en ;
    rdfs:domain onto:LotStep ;
    rdfs:range onto:Contract ;
    ns1:term_status "stable" .

onto:manufacturer a owl:DatatypeProperty ;
    rdfs:label "Manufacturer"@en ;
    rdfs:comment "Manufacter and model of the measure station."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:measuredBy a owl:ObjectProperty ;
    rdfs:label "Measured by"@en ;
    rdfs:comment "It identifies the instrument located in a station in a given place that measures a parameter (eg. Wind, Wave)."@en ;
    rdfs:domain onto:Parameter ;
    rdfs:range onto:Instrument ;
    ns1:term_status "stable" .

onto:measurementHeight a owl:DatatypeProperty ;
    rdfs:label "Measurement Height"@en ;
    rdfs:comment "Instrument height above the reference level."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:measurementPeriod a owl:DatatypeProperty ;
    rdfs:label "Measurement Period"@en ;
    rdfs:comment "Measurement Period related to the measure (Month-Year)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:IndicatorCollection onto:MeasurementCollection ) ] ;
    rdfs:range xsd:gYearMonth ;
    ns1:term_status "stable" .

onto:measures a owl:ObjectProperty ;
    rdfs:label "Measures"@en ;
    rdfs:comment "It connects the measure station with the observed parameter (eg. Wind, Wave) in a given place."@en ;
    rdfs:domain onto:MeasureStation ;
    rdfs:range onto:Parameter ;
    ns1:term_status "stable" .

onto:mooringType a owl:DatatypeProperty ;
    rdfs:label "Mooring Type"@en ;
    rdfs:comment "Mooring type of the measure station."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:officialInstabilityType a owl:DatatypeProperty ;
    rdfs:label "Official instability type"@en ;
    rdfs:comment "Type of instability declared in the decree"@en ;
    rdfs:domain onto:Contract ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:operationalStatus a owl:ObjectProperty ;
    rdfs:label "Operational Status"@en ;
    rdfs:comment "It indicates the operational status of the measure station (Operational, Ceased, etc.)."@en ;
    rdfs:domain onto:MeasureStation ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:parameterReported a owl:DatatypeProperty ;
    rdfs:label "Parameters reported"@en ;
    rdfs:comment "Set of parameters measured by the instrument."@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:phase a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "Phase"@en ;
    rdfs:range xsd:string,
        skos:Concept ;
    ns1:term_status "stable" .

onto:placedOn a owl:ObjectProperty ;
    rdfs:label "Placed on"@en ;
    rdfs:comment "Measure station that includes the instrument."@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range onto:MeasureStation ;
    ns1:term_status "stable" .

onto:positioningSystem a owl:DatatypeProperty ;
    rdfs:label "Positioning System"@en ;
    rdfs:comment "Positioning System installed on the measure station."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:primaryGeographicalFeature a owl:ObjectProperty ;
    rdfs:label "Primary geographical feature"@en ;
    rdfs:comment "Primary geographical feature of a Contract"@en ;
    rdfs:domain onto:Contract ;
    rdfs:range onto:Place ;
    ns1:term_status "stable" .

onto:repairCategory a owl:ObjectProperty ;
    rdfs:label "Repair category"@en ;
    rdfs:domain onto:Repair ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:repairGroup a owl:ObjectProperty ;
    rdfs:label "Repair group"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:repairRelatedTo a owl:ObjectProperty ;
    rdfs:label "Repair related to"@en ;
    rdfs:comment "This property connects the Repair to the Contract."@en ;
    rdfs:domain onto:Repair ;
    rdfs:range onto:Contract ;
    ns1:term_status "stable" .

onto:repairType a owl:ObjectProperty ;
    rdfs:label "Repair type"@en ;
    rdfs:comment "This property connects the Repair to a concept of a specific vocabulary."@en ;
    rdfs:domain onto:Repair ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:role a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "Role"@en ;
    rdfs:comment "The role of Entity in Authority kind class."@en ;
    rdfs:domain onto:AuthorityKind ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:secondaryGeographicalFeature a owl:ObjectProperty ;
    rdfs:label "Secondary geographical feature"@en ;
    rdfs:comment "Secondary geographical feature of a Contract"@en ;
    rdfs:domain onto:Contract ;
    rdfs:range onto:Place ;
    ns1:term_status "stable" .

onto:sensorModel a owl:DatatypeProperty ;
    rdfs:label "Sensor Model"@en ;
    rdfs:comment "Sensor/Instrument Model."@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:sensorSamplingFrequency a owl:DatatypeProperty ;
    rdfs:label "Sensor Sampling Frequency"@en ;
    rdfs:comment "Observation sampling of the instrumen (in hertz)."@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:structure a owl:DatatypeProperty ;
    rdfs:label "Structure"@en ;
    rdfs:comment "Material or building type of the measure station."@en ;
    rdfs:domain onto:Model ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:typeOfDataStation a owl:ObjectProperty ;
    rdfs:label "Type of Data Station"@en ;
    rdfs:comment "Type of Data Station."@en ;
    rdfs:domain onto:MeasureStation ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

onto:waveHeightReported a owl:DatatypeProperty ;
    rdfs:label "Wave Height Reported"@en ;
    rdfs:comment "Wave height parameters reported by the instrument."@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:wavePeriodReported a owl:DatatypeProperty ;
    rdfs:label "Wave Period Reported"@en ;
    rdfs:comment "Wave period parameters reported by the instrument."@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:wmoSensorCode a owl:DatatypeProperty ;
    rdfs:label "Wmo Sensor Code"@en ;
    rdfs:comment "It connects the intrument with the analogous concept as defined by WMO."@en ;
    rdfs:domain onto:Instrument ;
    rdfs:range xsd:anyURI ;
    ns1:term_status "stable" .

ns1:term_status a owl:AnnotationProperty .

onto:EconomicIndicator a owl:Class ;
    rdfs:label "Economic Indicator"@en ;
    rdfs:comment "Parameter of the project economic framework."@en ;
    rdfs:subClassOf onto:Indicator ;
    ns1:term_status "stable" .

onto:IndicatorCollection a owl:Class ;
    rdfs:label "Indicator Collection"@en ;
    ns1:term_status "stable" .

dcmitype:Collection a owl:Class .

<http://purl.org/goodrelations/v1#BusinessEntity> a owl:Class ;
    ns1:term_status "stable" .

<http://purl.org/procurement/public-contracts#Contract> a owl:Class .

<http://purl.org/procurement/public-contracts#FrameworkAgreement> a owl:Class ;
    ns1:term_status "stable" .

<http://regesta.exe/> a owl:NamedIndividual,
        foaf:Organization .

<http://www.geonames.org/ontology#Feature> a owl:Class .

xsd:gYearMonth a rdfs:Datatype .

org:OrganizationalUnit a owl:Class ;
    ns1:term_status "stable" .

onto:Lithology a owl:Class ;
    rdfs:label "Lithology"@en ;
    rdfs:comment "Lithology as stated in the project."@en ;
    ns1:term_status "stable" .

onto:LotStep a owl:Class ;
    rdfs:label "Lot step"@en ;
    ns1:term_status "stable" .

onto:Place a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "TBC"@en ;
    ns1:term_status "stable" .

<http://www.isprambiente.gov.it/it/> a owl:NamedIndividual,
        foaf:Organization .

foaf:Organization a owl:Class .

onto:Indicator a owl:Class ;
    rdfs:label "Indicator"@en ;
    ns1:term_status "stable" .

onto:Instability a owl:Class ;
    rdfs:label "Instability"@en ;
    rdfs:comment "Type of instability phenomenon shown in the drawings or observed by site visit."@en ;
    ns1:term_status "stable" .

onto:Repair a owl:Class ;
    rdfs:label "Repair"@en ;
    rdfs:comment "Type of protection works."@en ;
    ns1:term_status "stable" .

onto:AuthorityKind a owl:Class ;
    rdfs:label "Authority kind"@en ;
    rdfs:comment "Involved authorities and role played."@en ;
    ns1:term_status "stable" .

onto:MeasurementCollection a owl:Class ;
    rdfs:label "Measurement Collection"@en ;
    rdfs:comment "Set of measures and metadata in a specified period regarding an observed parameter (eg. Wind, Wave) in a given place"@en ;
    ns1:term_status "stable" .

onto:MeasureStation a owl:Class ;
    rdfs:label "Measure Station"@en ;
    rdfs:comment "Facility with instruments and equipment for monitoring in a given place, for a determined period, relatively to its foundamental parameters."@en ;
    ns1:term_status "stable" .

onto:Model a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "Type of measuring station (ispra-core: Measure Station) including a set of its main characteristics (size, construction, etc.)"@en ;
    ns1:term_status "stable" .

onto:Parameter a owl:Class ;
    rdfs:label "Parameter"@en ;
    ns1:term_status "stable" .

onto:Contract a owl:Class ;
    rdfs:label "Contract"@en ;
    ns1:term_status "stable" .

skos:Concept a owl:Class ;
    ns1:term_status "stable" .

