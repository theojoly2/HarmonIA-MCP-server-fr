@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://protege.stanford.edu/plugins/owl/protege#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://ontology.cybershare.utep.edu/resource/dbowl/AggregationRelationMapping> a owl:Class ;
    rdfs:label "Aggregation Relation Mapping."^^xsd:string ;
    rdfs:comment "A mapping from a relational database element to the parthood (i.e. hasPart) relation between to cclasses."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/BinaryObjectPropertyMapping> a owl:Class ;
    rdfs:label "Binary Object Property mapping."^^xsd:string ;
    rdfs:comment "A mapping from a relational database element to a set of two inverse object properties in RDF/OWL."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/EnnumerationPropertyRangeMapping> a owl:Class ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/PropertyRangeMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/EntityConceptMapping> a owl:Class ;
    rdfs:label "A mapping from an entity or relation from a relational database to a concept/class in RDF/OWL that will represent an entity."^^xsd:string,
        "Entity Concept Mapping."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ConceptMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/FunctionalDatatypePropertyMapping> a owl:Class ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DatatypePropertyMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/FunctionalObjectPropertyMapping> a owl:Class ;
    rdfs:comment "A mapping from a relational database element to an object property asserted as functional."^^xsd:string,
        "Functional Object Property Mapping."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/InverseFunctionalObjectPropertyMapping> a owl:Class ;
    rdfs:label "Inverse Functional Object Property Mapping."^^xsd:string ;
    rdfs:comment "A mapping from a relational database element to an object property asserted as inverse functional."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/PropertyDomainMapping> a owl:Class ;
    rdfs:label "Property Domain Mapping"^^xsd:string ;
    rdfs:comment "A mapping from a relational database element as the domain of an object property."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/RelationConceptMapping> a owl:Class ;
    rdfs:label "Relation Concept Mapping."^^xsd:string ;
    rdfs:comment "A mapping from an entity or relation from a relational database to a concept/class in RDF/OWL that will represent a relationship."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ConceptMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/SpecificRelationMapping> a owl:Class ;
    rdfs:label "A mapping from a relational database element to the subclass (i.e. is-a) relation between to classes."^^xsd:string,
        "Specific Relation Mapping."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/SymmetricObjectPropertyMapping> a owl:Class ;
    rdfs:label "Symmetric Object Property Mapping"^^xsd:string ;
    rdfs:comment "A mapping from a relational database element to an object property asserted as symmetric."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/TransitiveObjectPropertyMapping> a owl:Class ;
    rdfs:label "Transitive Object Property Mapping."^^xsd:string ;
    rdfs:comment "A mapping from a relational database element to an object property asserted as transitive."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/UnaryObjectPropertyMapping> a owl:Class ;
    rdfs:comment "A mapping from a relational database element to one object property, i.e. an inverse object property will not be created."^^xsd:string,
        "Unary Object Property Mapping"^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/VirtualCollectionMapping> a owl:Class ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/VirtualMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/VirtualConceptMapping> a owl:Class ;
    rdfs:label "Virtual concept mapping"^^xsd:string ;
    rdfs:comment "A virtual concept mapping will map a database query description into a concept that is defined by the constraints defined in the query."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/VirtualMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/VirtualPropertyMapping> a owl:Class ;
    rdfs:label "Virtual property mapping"^^xsd:string ;
    rdfs:comment "A virtual property mapping will map a view to an object property restricted by a condition or a projection. This is used to map views that contain relations that were mapped as binary object properties and not as concepts."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/VirtualMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/equivalentClassMapping> a owl:ObjectProperty ;
    rdfs:label "equivalent class mapping"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/exactly1CardinalityRestriction> a owl:ObjectProperty ;
    rdfs:label "exactly one restriction"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/existsSomeRestriction> a owl:ObjectProperty ;
    rdfs:label "exists some restriction"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasAggregateFunctionMapping> a owl:DatatypeProperty .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasDomainMapping> a owl:ObjectProperty ;
    rdfs:label "has domain mapping"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasGroupingAttributeMapping> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://ontology.cybershare.utep.edu/resource/dbowl/isCollectionOfMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasInversePropertyMapping> a owl:ObjectProperty ;
    rdfs:label "has inverse property mapping"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasPartMapping> a owl:ObjectProperty ;
    rdfs:label "has part mapping"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasPropertyMapping> a owl:ObjectProperty .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasRangeMapping> a owl:ObjectProperty ;
    rdfs:label "has range mapping"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasTypeMapping> a owl:ObjectProperty ;
    rdfs:label "has type mapping"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/isSubClassOfDomainOfMapping> a owl:ObjectProperty ;
    owl:inverseOf <http://ontology.cybershare.utep.edu/resource/dbowl/hasSubClassOfDomainMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/isSubClassOfRangeOfMapping> a owl:ObjectProperty ;
    owl:inverseOf <http://ontology.cybershare.utep.edu/resource/dbowl/hasSubClassOfRangeMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/max0CardinalityRestriction> a owl:ObjectProperty ;
    rdfs:label "max 0 restriction"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/max1CardinalityRestriction> a owl:ObjectProperty ;
    rdfs:label "max 1 restriction"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/min0CardinalityRestriction> a owl:ObjectProperty ;
    rdfs:label "min 0 restriction"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/min1CardinalityRestriction> a owl:ObjectProperty ;
    rdfs:label "min 1 restriction"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/onlyFromPropertyRestriction> a owl:ObjectProperty ;
    rdfs:label "only from restriction"^^xsd:string .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

<http://ontology.cybershare.utep.edu/resource/dbowl/DatatypePropertyMapping> a owl:Class ;
    rdfs:label "Datatype property mapping."^^xsd:string ;
    rdfs:comment "A mapping from a relational database element to a datatype property in RDF/OWL."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/PropertyRangeMapping> a owl:Class ;
    rdfs:label "Property Range Mapping"^^xsd:string ;
    rdfs:comment "A mapping from a relational database element as the range of an object property."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasSubClassOfDomainMapping> a owl:ObjectProperty .

<http://ontology.cybershare.utep.edu/resource/dbowl/hasSubClassOfRangeMapping> a owl:ObjectProperty .

<http://ontology.cybershare.utep.edu/resource/dbowl/isCollectionOfMapping> a owl:ObjectProperty .

<http://ontology.cybershare.utep.edu/dbowl/relational-to-ontology-mapping-primitive.owl> a owl:Ontology ;
    ns2:license "http://creativecommons.org/licenses/by/3.0/"^^xsd:anyURI ;
    ns1:defaultLanguage "en" ;
    dc:contributor "Contributors are those that engage in discussions during the development of this ontology (in alphabetical order):\\n\\t\\tmichel dumontier\\n\\t\\tluis garnica\\n\\t\\t"^^xsd:string ;
    dc:creator "http://cybershare.utep.edu"^^xsd:anyURI,
        "Natalia Villanueva-Rosales"@en,
        "iLink @ UTEP"@en ;
    dc:description "\\n\\t\\tPrimitive ontology for database to Semantic Web mapping which subsumes classes that\\n\\t\\trepresent mappings to explicit OWL constructs, such as OWL class, object property, data\\n\\t\\tproperty, etc. Classes in this ontology are populated by individuals representing components of the database schema being mapped.\\n\\t\\t"@en ;
    dc:issued "2016-03-01"^^xsd:date ;
    dc:rights "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/3.0/]."^^xsd:string ;
    dc:title "Relational to Ontology Mapping Primitive"@en ;
    dcterms:identifier "relational-to-ontology-mapping-primitive.owl" ;
    dcterms:modified "2016-04-01"^^xsd:date ;
    vann:preferredNamespacePrefix "dbowl"@en ;
    vann:preferredNamespaceUri "http://ontology.cybershare.utep.edu/dbowl/"^^xsd:string ;
    rdfs:isDefinedBy <http://ontology.cybershare.utep.edu/dbowl/relational-to-ontology-mapping-primitive.owl> ;
    owl:versionIRI <http://ontology.cybershare.utep.edu/dbowl/relational-to-ontology-mapping-primitive.owl> ;
    owl:versionInfo "2.0"^^xsd:string .

<http://ontology.cybershare.utep.edu/resource/dbowl/ConceptMapping> a owl:Class ;
    rdfs:label "A mapping from an entity or relation from a relational database to a concept/class in RDF/OWL."^^xsd:string,
        "Concept Mapping."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/VirtualMapping> a owl:Class ;
    rdfs:label "Dabatase virtual concept mapping"^^xsd:string ;
    rdfs:comment "A virtual mapping will create concepts that will not be populated from the database. Instead, it will contain the restrictions that will define the membership for that concept. They can be used to map restrictions described in views, queries, etc."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping> a owl:Class ;
    rdfs:label "Object Property Mapping."^^xsd:string ;
    rdfs:comment "A mapping from a relational database element to an object property in RDF/OWL."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> .

<http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> a owl:Class ;
    rdfs:label "Database to Semantic Web mapping"^^xsd:string ;
    rdfs:comment "A mapping from an relational model to a Semantic Web ontology."^^xsd:string .

