    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#title> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#mainOriginalTitle> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#owns> a rdf:Property ;
    rdfs:label "Owns"@en ;
    rdfs:comment "To identify the service (s) that an Agent\\n            (Contact/person or Organisation) owns."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Service> ;
    rdfs:subPropertyOf dc:relation ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isOwnedBy> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#packageByteSize> a rdf:Property ;
    rdfs:label "Package size (in bytes)"@en ;
    rdfs:comment "The size of a media package in\\n            Bytes."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:long .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#packageName> a rdf:Property ;
    rdfs:label "Package name"@en ;
    rdfs:comment "The name attributed to a\\n            package."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:long .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#partDefinition> a rdf:Property ;
    rdfs:label "Part definition"@en ;
    rdfs:comment "A definition associated with the Part."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Part> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#partName> a rdf:Property ;
    rdfs:label "Part name"@en ;
    rdfs:comment "A name by which the Part is identified."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Part> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#partNumber> a rdf:Property ;
    rdfs:label "Part number"@en ;
    rdfs:comment "The number associated to a Part as one among\\n            many."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Part> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#partTotalNumber> a rdf:Property ;
    rdfs:label "Total number of parts"@en ;
    rdfs:comment "The total number of Parts associated with a\\n            BusinessObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Part> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#playlist> a rdf:Property ;
    rdfs:label "Playlist"@en ;
    rdfs:comment "To describe a playlist."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateAddressArea> a rdf:Property ;
    rdfs:label "Area code"@en ;
    rdfs:comment "To provide the Area part of an\\n            Adrress."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateMailAddress> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateAddressCountry> a rdf:Property ;
    rdfs:label "Country"@en ;
    rdfs:comment "To provide the country name and or country\\n            code."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateMailAddress> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateAddressLine> a rdf:Property ;
    rdfs:label "Address line"@en ;
    rdfs:comment "To write address line with e.g. the street name\\n            and number."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateMailAddress> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateAddressLocality> a rdf:Property ;
    rdfs:label "Locality"@en ;
    rdfs:comment "To provide the name of a city, viallge,\\n            etc."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateMailAddress> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateAddressPostalCode> a rdf:Property ;
    rdfs:label "Postal code"@en ;
    rdfs:comment "To provide an address postal\\n            code."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateMailAddress> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateEmailAddress> a rdf:Property ;
    rdfs:label "Private email"@en ;
    rdfs:comment "To provide the private email address of an\\n            agent (Contact/person)"@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentEmailAddress> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateHomepage> a rdf:Property ;
    rdfs:label "Homepage (private)"@en ;
    rdfs:comment "To provide an private web homepage of an Agent\\n            (Contact/person)."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentWebHomepage> ;
    owl:equivalentProperty foaf:homepage .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateMobileTelephoneNumber> a rdf:Property ;
    rdfs:label "Mobile (private)"@en ;
    rdfs:comment "To provide the private mobile telephone number\\n            of an agent (Contact/person)."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentMobileTelephoneNumber> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateTelephoneNumber> a rdf:Property ;
    rdfs:label "Telephone (private)"@en ;
    rdfs:comment "To provide the private telephone number of an\\n            Agent (Contact/person)."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentTelephoneNumber> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#promotionalInformation> a rdf:Property ;
    rdfs:label "Promotional information"@en ;
    rdfs:comment "To provide textual promotional information."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#pubStatus> a rdf:Property ;
    rdfs:label "Publication status"@en ;
    rdfs:comment "To indicate a publication status."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#publicationChannelName> a rdf:Property ;
    rdfs:label "Publication channel name"@en ;
    rdfs:comment "To provide a name to a PublicationChannel e.g. a TV channel or website."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationChannel> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#publicationEndDateTime> a rdf:Property ;
    rdfs:label "Publication end date & time"@en ;
    rdfs:comment "The actual end date and time of a PublicationEvent."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> ;
    rdfs:range xsd:dateTime .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#publicationEventName> a rdf:Property ;
    rdfs:label "Publication event name"@en ;
    rdfs:comment "To provide a name to a PublicationEvent."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#publicationScheduleDate> a rdf:Property ;
    rdfs:label "schedule date"@en ;
    rdfs:comment "To express specifically the schedule date to which a PublicationEvent is related in particular if the broacdast time is after midnight. For example, the schedule date would be May 29th and the programme is published at 1 am on May 30th, while still associated in the schedule with the night of May 29th."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> ;
    rdfs:range xsd:date .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#publicationStartDateTime> a rdf:Property ;
    rdfs:label "Publication start date & time"@en ;
    rdfs:comment "The actual start date and time of a PublicationEvent."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> ;
    rdfs:range xsd:dateTime .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#publishedEndDateTime> a rdf:Property ;
    rdfs:label "Publication end date & time"@en ;
    rdfs:comment "The end date and time of a PublicationEvent as\\n            scheduled."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> ;
    rdfs:range xsd:dateTime .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#publishedStartDateTime> a rdf:Property ;
    rdfs:label "Publication start date & time"@en ;
    rdfs:comment "The start date and time of a PublicationEvent\\n            as scheduled."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> ;
    rdfs:range xsd:dateTime .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#publishedTitle> a rdf:Property ;
    rdfs:label "Published title."@en ;
    rdfs:comment "The title used to identify the work at publication time."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:title .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ratingScaleMax> a rdf:Property ;
    rdfs:label "Rating scale (top value)"@en ;
    rdfs:comment "The maximum value of the scale used for rating\\n            a media resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#ratingScaleMax> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ratingScaleMin> a rdf:Property ;
    rdfs:label "Rating scale (min. value)"@en ;
    rdfs:comment "The minimum value of the scale used for rating\\n            a Resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#ratingScaleMin> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ratingSystemEnvironment> a rdf:Property ;
    rdfs:label "Rating environment"@en ;
    rdfs:comment "To identify the environment in which rating applies."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasRatingSystem> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ratingSystemName> a rdf:Property ;
    rdfs:label "Rating system"@en ;
    rdfs:comment "To identify a rating system by its name."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasRatingSystem> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ratingValue> a rdf:Property ;
    rdfs:label "Rating"@en ;
    rdfs:comment "To express a free text rating value defined in\\n            a rating classification scheme."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#ratingValue> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#reason> a rdf:Property ;
    rdfs:label "Reason"@en ;
    rdfs:comment "To provide a reason for which Rating as been attributed as provided."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#references> a rdf:Property ;
    rdfs:label "References"@en ;
    rdfs:comment "To express a reference between Assets, BusinessObjects or Resources."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#regionDelimX> a rdf:Property ;
    rdfs:label "Region delimiter (x-axis)"@en ;
    rdfs:comment "To define the bottom right corner of a zone on\\n            the x-axis. If present with regionDelimY, the zone definition is complemented by the\\n            associated values of the height and width."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#regionDelimY> a rdf:Property ;
    rdfs:label "Region delimiter (y-axis)"@en ;
    rdfs:comment "To define the bottom right corner of a zone on\\n            the y-axis. If present with regionDelimX, the zone definition is complemented by the\\n            associated values of the height and width."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#relatedLink> a rdf:Property ;
    rdfs:label "Related resources"@en ;
    rdfs:comment "To provide a link to a web resource containing\\n            information related to an Agent (Contact/person or Organisation)."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:anyURI .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#replaces> a rdf:Property ;
    rdfs:label "Replaces"@en ;
    rdfs:comment "To identify substitution."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#requires> a rdf:Property ;
    rdfs:label "Requires"@en ;
    rdfs:comment "To express dependency."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#resourceDescription> a rdf:Property ;
    rdfs:label "Resource description"^^xsd:string ;
    rdfs:comment "This can be specialised by using sub-properties\\n            like defined in http://www.ebu.ch/metadata/cs/web/ebu_DescriptionTypeCodeCS_p.xml.htm\\n            implemented as examples as e.g. 'summary' or\\n            'script'."^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:description .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#resourceName> a rdf:Property ;
    rdfs:label "Resource description"@en ;
    rdfs:comment "A name by which the resource can be identified."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#review> a rdf:Property ;
    rdfs:label "Review"@en ;
    rdfs:comment "To provide a text for a review."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#rightsExpression> a rdf:Property ;
    rdfs:label "Rights expression"@en ;
    rdfs:comment "The expression of Rights as free\\n            text."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#rightsLink> a rdf:Property ;
    rdfs:label "Rights web resource"@en ;
    rdfs:comment "A link to e.g. a webpage where an expression of\\n            the rights can be found and consulted."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> ;
    rdfs:range xsd:anyURI .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#roleDefinition> a rdf:Property ;
    rdfs:label "Role definition"@en ;
    rdfs:comment "To provide a definition for a role"@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Role> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#sampleRate> a rdf:Property ;
    rdfs:label "Sample Rate"@en ;
    rdfs:comment "The frequency at which audio is sampled per second. Also called sampling rate."@en ;
    rdfs:range xsd:integer ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#samplingRate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#sampleSize> a rdf:Property ;
    rdfs:label "Sample size"@en ;
    rdfs:comment "The size of an audio sample in\\n            bits. Also called bit depth."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioFormat> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#sampleType> a rdf:Property ;
    rdfs:label "Sample type"@en ;
    rdfs:comment "The type of audio sample."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioFormat> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#scanningFormat> a rdf:Property ;
    rdfs:label "Sampling format"@en ;
    rdfs:comment "To define the scanning format for a\\n            MediaResource. For video, the two main values are \"interlaced\" or\\n            \"progressive\"."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoFormat> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#script> a rdf:Property ;
    rdfs:label "Script"@en ;
    rdfs:comment "To provide a script."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#shotlog> a rdf:Property ;
    rdfs:label "Shot log"@en ;
    rdfs:comment "Provides a shot-by-shot description of resource content."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#signingSource> a rdf:Property ;
    rdfs:label "Signing source"@en ;
    rdfs:comment "To identify the source of the signing\\n            resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Signing> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#startNormalPlayTime> a rdf:Property ;
    rdfs:label "Start time (time)"@en ;
    rdfs:comment "The start time expressed using a time\\n            expression."@en ;
    rdfs:range xsd:time ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#start> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#startNumberEditUnits> a rdf:Property ;
    rdfs:label "Start time (edit units)"@en ;
    rdfs:comment "A start time expressed as a number of edit\\n            units."@en ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#start> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#startTimecode> a rdf:Property ;
    rdfs:label "Start time (timecode)"@en ;
    rdfs:comment "A start time expressed as\\n            timecode."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#start> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#storageDefinition> a rdf:Property ;
    rdfs:label "Storage definition"@en ;
    rdfs:comment "To provide a definition for storage."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#StorageType> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#subtitle> a rdf:Property ;
    rdfs:label "Subtitle"@en ;
    rdfs:comment "A complementary subtitle."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#alternativeTitle> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#subtitlingSource> a rdf:Property ;
    rdfs:label "Subtitling source"@en ;
    rdfs:comment "To identify the source of the Subtitling\\n            resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Subtitling> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#summary> a rdf:Property ;
    rdfs:label "Summary"@en ;
    rdfs:comment "To provide a summary."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#synopsis> a rdf:Property ;
    rdfs:label "Synopsis"@en ;
    rdfs:comment "To provide a summary."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#tableOfContent> a rdf:Property ;
    rdfs:label "Table of Content"@en ;
    rdfs:comment "To provide a Table of Content."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#targetAudienceSystem> a rdf:Property ;
    rdfs:label "Target audience system"@en ;
    rdfs:comment "To define the system used to provide a TargetAudience."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#audienceLevel> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#textualAnnotation> a rdf:Property ;
    rdfs:label "Note"@en ;
    rdfs:comment "The value of an Annotation as free\\n            text."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Annotation> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#trackDefinition> a rdf:Property ;
    rdfs:label "Definition"@en ;
    rdfs:comment "To provide a definition associated to a\\n            Track."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Track> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#trackName> a rdf:Property ;
    rdfs:label "Track name"@en ;
    rdfs:comment "The name attributed to a Track."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Track> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#trackName> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#translationTitle> a rdf:Property ;
    rdfs:label "Translation title"@en ;
    rdfs:comment "A translated version of the title."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#alternativeTitle> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#versionTitle> a rdf:Property ;
    rdfs:label "Version title"@en ;
    rdfs:comment "An alternative title specific to a verison of content."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#alternativeTitle> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#width> a rdf:Property ;
    rdfs:label "Width"@en ;
    rdfs:comment "The width of e.g. a video frame typically\\n            expressed as a number of pixels, or picture/image in millimeters."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:integer ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#frameWidth> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#widthUnit> a rdf:Property ;
    rdfs:label "Width unit"@en ;
    rdfs:comment "The unit used to measure a width e.g. in pixels\\n            or number of lines or millimeters or else."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#wordCount> a rdf:Property ;
    rdfs:label "Word count"@en ;
    rdfs:comment "The number of words contained in a\\n            document."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Document> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#workingTitle> a rdf:Property ;
    rdfs:label "Working title"@en ;
    rdfs:comment "A title used while content is not complete."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#alternativeTitle> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#wrappingType> a rdf:Property ;
    rdfs:label "Wrapping type"@en ;
    rdfs:comment "To provide additional information on the\\n            wrapping type of ancillary data."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AncillaryData> ;
    rdfs:range xsd:string .

