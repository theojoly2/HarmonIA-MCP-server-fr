@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:Agent a rdfs:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "A resource that acts or has the power to act."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.bbc.co.uk/ontologies/coreconcepts/Event> a rdfs:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "Music events, historic events, sports events, politics events, e.t.c."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Event> .

<http://www.bbc.co.uk/ontologies/coreconcepts/Organisation> a rdfs:Class ;
    rdfs:label "Organisation"@en ;
    rdfs:comment "E.g., Businesses."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Organisation> .

<http://www.bbc.co.uk/ontologies/coreconcepts/Person> a rdfs:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "all types of people such as politicians, athletes, historic figures, contributors in programmes e.t.c."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> .

<http://www.bbc.co.uk/ontologies/coreconcepts/Place> a rdfs:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "Another type of location."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Location> .

<http://www.bbc.co.uk/ontologies/coreconcepts/Theme> a rdfs:Class ;
    rdfs:label "Theme"@en ;
    rdfs:comment "This concept is used to represent intangible things or abstract concepts. For example, Financial Crisis, Midwifery, Happiness."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Keyword> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AccessConditions> a rdfs:Class ;
    rdfs:label "Access conditions"@en ;
    rdfs:comment "The conditions under which content can be accessed."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Affiliation> a rdfs:Class ;
    rdfs:label "Affiliation"@en ;
    rdfs:comment "An Organisation to which a Contact is affiliated (with period of validity)."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Organisation> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> a rdfs:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "A person / contact or organisation."@en ;
    rdfs:subClassOf foaf:Agent .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AncillaryData> a rdfs:Class ;
    rdfs:label "Ancillary data"@en ;
    rdfs:comment "Any ancillary data provided with the content\\n            other than captioning and subtitling."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DataTrack> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AncillaryDataFormat> a rdfs:Class ;
    rdfs:label "Ancillary data format"@en ;
    rdfs:comment "To define the format of AncillaryData such as\\n            legacy data used to be carried in vertical blanking intervals. This is provided as free\\n            text in an annotation label or as an identifier pointing to a term in a classification\\n            scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DataFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Annotation> a rdfs:Class ;
    rdfs:label "Annotation"@en ;
    rdfs:comment "A set of descriptive or technical metadata.\\n            Annotation can also be made in the form of a document or media resource such as an or\\n            video audio file . An annotation can exist on its own and be related / associated to\\n            other editorial objects or resources."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> a rdfs:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "The Class \"Asset\" is an\\n            object to which an identifier will be associated at commissioning. It will serve as a\\n            central reference point to manage rights associated to EditorialObjects, Resources,\\n            MediaResources or Essences, and PublicationEvents (distribution and exploitation\\n            conditions)."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudienceRating> a rdfs:Class ;
    rdfs:label "Audience rating"@en ;
    rdfs:comment "The audience by which the Resource can be\\n            seen according to ratings like MPAA  (http://en.wikipedia.org/wiki/Motion_picture_rating_system) or other organisational / national / local standards."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioChannel> a rdfs:Class ;
    rdfs:label "Audio channel"^^xsd:string ;
    rdfs:comment "An audioChannel represents a single sequence of audio samples. It\\r\\n\\t\\t\\t\\tis sub-divided in the time domain into audioBlocks, which is must contain at\\r\\n\\t\\t\\t\\tleast one of. The typeDefintion of the audioChannel format specifies the type of\\r\\n\\t\\t\\t\\taudio it is describing, and also determines which parameters are used within its\\r\\n\\t\\t\\t\\taudioBlock children."^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Essence> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioContent> a rdfs:Class ;
    rdfs:label "Audio content"@en ;
    rdfs:comment "An audioContent defines one component of a programme (e.g. background\\r\\n\\t\\t\\t\\tmusic), its association with an audioGroup (e.g. a 2.0 audioPackFormat of\\r\\n\\t\\t\\t\\taudioChannelFormats for stereo reproduction), its association with an\\r\\n\\t\\t\\t\\taudioStreamFormat, and its set of loudness parameters."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioProgramme> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioDescription> a rdfs:Class ;
    rdfs:label "Audio description"^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioTrack> ;
    skos:prefLabel "Audio description"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioEncodingFormat> a rdfs:Class ;
    rdfs:label "Audio encoding format"@en ;
    rdfs:comment "The encoding format for the audio."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EncodingFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioFormat> a rdfs:Class ;
    rdfs:label "Audio Format"@en ;
    rdfs:comment "The technical characteristics of an\\n            AudioResource such as the sampleRate. This is provided as free text in an annotation\\n            label or as an identifier pointing to a term in a classification scheme e.g.\\n            http://www.ebu.ch/metadata/ontologies/skos/ebu_AudioFormatCodeCS.rdf."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioPackFormat> a rdfs:Class ;
    rdfs:label "Audio pack format"@en ;
    rdfs:comment "The format of an AudioPack. Examples of audioPackFormats are 'stereo' and '5.1' for channel-based formats."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioProgramme> a rdfs:Class ;
    rdfs:label "Audio programme"@en ;
    rdfs:comment "A set of one or more audioContent that derive from the same material,\\r\\n\\t\\t\\t\\ti.e. an audioMultiplex, and the definition of its multiplexed audioContents (e.g.\\r\\n\\t\\t\\t\\tforeground and commentary, background music)."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Programme> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioStream> a rdfs:Class ;
    rdfs:label "Audio stream"@en ;
    rdfs:comment "An audioStreamFormat describes a decodable signal - PCM signal or a Dolby E stream for example. It is composed of one or more AudioTracks."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Stream> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioStreamFormat> a rdfs:Class ;
    rdfs:label "Audio stream format"@en ;
    rdfs:comment "The format of an AudioStream, e.g. PCM_FrontLeft or Dolby E."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioTrack> a rdfs:Class ;
    rdfs:label "Audio track"@en ;
    rdfs:comment "An audioTrack is the basic audio data container of a medium. Attribute is\\r\\n\\t\\t\\t\\tan unambiguous reference to this container in a given medium."@en,
        "An audioTrack object defines a component of an audioStream.\\r\\n\\t\\t\\t\\tA single set of samples or data in the storage medium."@en,
        "Represents a physical container or carrier to hold an audio stream. This\\r\\n\\t\\t\\t\\tshould be usually defined by many attributes such as ID, format (e.g. 48 kHz/24\\r\\n\\t\\t\\t\\tbits), linkage information (e.g. odd/even)…"@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Track> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioTrackFormat> a rdfs:Class ;
    rdfs:label "Audio track format"@en ;
    rdfs:comment "The format of an AudioTrack e.g. PCM_FrontLeft."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BibliographicalObject> a rdfs:Class ;
    rdfs:label "Bibliographical object"^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    skos:prefLabel "Bibliographical object"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Brand> a rdfs:Class ;
    rdfs:label "Brand"^^xsd:string ;
    rdfs:comment "A group of EditorialObjects having a Brand as a\\n            common denominator"^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Group> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> a rdfs:Class ;
    rdfs:label "Business Object"@en ;
    rdfs:comment "An image, a document, an annotation\\n            (descriptive textual metadata or audio/video tag), a tag (time related in audiovisual\\n            media resources), or an audiovisual media resource (optionally composed of one or more\\n            fragment / part and / or audio, video data tracks). Other types of BusinessObjects may\\n            be defined as subclasses."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Captioning> a rdfs:Class ;
    rdfs:label "Captioning"@en ;
    rdfs:comment "To signal the presence of hard of hearing\\n            captioning."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DataTrack> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#CaptioningFormat> a rdfs:Class ;
    rdfs:label "Captioning format"@en ;
    rdfs:comment "To define the format of captioning.\\n            Captioning's main use isfor hard of hearing transcription. This is provided as\\n            free text in an annotation label or as an identifier pointing to a term in a\\n            classification scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DataFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Cast> a rdfs:Class ;
    rdfs:label "Cast member"@en ;
    rdfs:comment "A member of the cast list (a list of performers/actors and associated fictitious\\n            characters)."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Character> a rdfs:Class ;
    rdfs:label "Character"@en ;
    rdfs:comment "E.g. a fictitious contact / person."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ClosedCaptions> a rdfs:Class ;
    rdfs:label "Closed caption"@en ;
    rdfs:comment "Closed captioning is provided as separate\\n            content."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Captioning> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ClosedSubtitling> a rdfs:Class ;
    rdfs:label "Closed subtitling"@en ;
    rdfs:comment "Closed subtitles are provided as separate\\n            content."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Subtitling> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Codec> a rdfs:Class ;
    rdfs:label "Codec"@en ;
    rdfs:comment "To provide information on a codec."@en ;
    rdfs:subClassOf skos:Concept .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Collection> a rdfs:Class ;
    rdfs:label "Collection"^^xsd:string ;
    rdfs:comment "A group of EditorialObjects. There can be many\\n            types of collections for which specific sub-classes should be defined. In the worl of\\n            archives, A collection corresponds to all items belonging to an individual /\\n            collector."^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Group> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ColourSpace> a rdfs:Class ;
    rdfs:label "Colour space"@en ;
    rdfs:comment "The CoulourSpace of a VideoResource. A\\n            ColourSpace is defined as free text in an annotation label or as an identifier pointing\\n            to a term in a classification scheme such as\\n            http://www.ebu.ch/metadata/ontologies/skos/ebu_ColourCodeCS.rdf."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Component> a rdfs:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "A component e.g. audio, video, data or else or a MediaResource or Essence."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Essence> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> a rdfs:Class ;
    rdfs:label "Contact"@en ;
    rdfs:comment "A physical person."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ContainerFormat> a rdfs:Class ;
    rdfs:label "Container format"@en ;
    rdfs:comment "The container or wrapper format used to package\\n            audio, video and data components of a Mediaresource. The format is defined as free text\\n            or pointing at a term in a classification scheme e.g.\\n            http://www.ebu.ch/metadata/ontologies/skos/ebu_ContainerFormatCS.rdf."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ContainerMimeType> a rdfs:Class ;
    rdfs:label "Container Mime type"@en ;
    rdfs:comment "The definition of the container if available as\\n            a MIME type. This is provided as free text in an annotation label or as an identifier\\n            pointing to a term in a classification scheme. For more information:\\n            http://www.iana.org/assignments/media-types/application/index.html."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Copyright> a rdfs:Class ;
    rdfs:label "Copyright"@en ;
    rdfs:comment "To provide a copyright\\n            statement."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#CoverageRestrictions> a rdfs:Class ;
    rdfs:label "Coverage restrictions"@en ;
    rdfs:comment "To provide information on possible restrictions\\n            regarding the temporal and spatial coverage for publication."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Crew> a rdfs:Class ;
    rdfs:label "Crew member"@en ;
    rdfs:comment "Crew member."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DataFormat> a rdfs:Class ;
    rdfs:label "Data format"@en ;
    rdfs:comment "To provide addtional technical information on\\n            the characteristics of data streams in a MediaResource including but not limited to\\n            AncillaryData, Subtilting and Captioning. Additional specific data format may be defined\\n            as subclasses of DataFormat."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DataTrack> a rdfs:Class ;
    rdfs:label "Data track"@en ;
    rdfs:comment "Ancillary data track e.g. ¨captioning\"\\n            or \"subtitling\" in addition to video and audio tracks."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Track> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Department> a rdfs:Class ;
    rdfs:label "Department"@en ;
    rdfs:comment "A department within and\\n            organisation."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Organisation> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DepictedEvent> a rdfs:Class ;
    rdfs:label "Depicted Event"@en ;
    rdfs:comment "A DepictedEVent is fictitious or historical or\\n            other sort of Event that the content of the BusinessObject or resource relates\\n            to."@en ;
    rdfs:subClassOf <http://www.bbc.co.uk/ontologies/coreconcepts/Event> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Disclaimer> a rdfs:Class ;
    rdfs:label "Disclaimer"@en ;
    rdfs:comment "To provide a disclaimer of any\\n            form."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Document> a rdfs:Class ;
    rdfs:label "Document"@en ;
    rdfs:comment "To describe a publication in the form of a\\n            document e.g. a html webpage (news item) or a pdf document e.g. a script."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DocumentFormat> a rdfs:Class ;
    rdfs:label "Document format"@en ;
    rdfs:comment "To provide technical information about the\\n            format of a document such as the orientation. This is provided as free text in an\\n            annotation label or as an identifier pointing to a term in a classification\\n            scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Dopesheet> a rdfs:Class ;
    rdfs:label "Dopesheet"@en ;
    rdfs:comment "Provides additional information about a NewsItem, e.g. date and place, subject."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Document> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> a rdfs:Class ;
    rdfs:label "Editorial Object"@en ;
    rdfs:comment "In the audiovisual domain, the Class\\n            EditorialObject transforms a commissioned concept into an editorial definition of a\\n            MediaResource before fabrication (in the Production Domain) and Distribution (in the\\n            Distribution Domain). An EditorialObject is a set of descriptive metadata summarising\\n            e.g. editing decisions. An EditorialObject can also be a part of an EditorialObject,\\n            which is defined by its start time and duration. An EditorialObject can also be a group\\n            of EditorialObjects. For example a series composed of episodes is defined as an\\n            EditorialObject."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EncodingFormat> a rdfs:Class ;
    rdfs:label "Encoding"@en ;
    rdfs:comment "To provide a definition of the encoding format\\n            for audio and video. This is provided as free text in an annotation label or as an\\n            identifier pointing to a term in a classification scheme e.g.\\n            http://www.ebu.ch/metadata/ontologies/skos/ebu_AudioCompressionCodeCS.rdf or\\n            http://www.ebu.ch/metadata/ontologies/skos/ebu_VideoCompressionCodeCS.rdf."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Essence> a rdfs:Class ;
    rdfs:label "Essence"@en ;
    rdfs:comment "In some audiovisual standardisation groups,\\n            Essence is preferred to MediaResource. In also has subclasses well known as MediaObject\\n            clustered in AudioObjects and VideoObjects."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Event> a rdfs:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "Additional types of event shall be defined as\\n            new sub-classes of event."@en,
        "An event related to the media resource, e.g.\\n            depicted in the resource (possibly fictional), etc."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ExploitationIssues> a rdfs:Class ;
    rdfs:label "Exploitation issues"@en ;
    rdfs:comment "To highlight potential exploitation\\n            issues."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Feature> a rdfs:Class ;
    rdfs:label "Feature"^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> ;
    skos:prefLabel "Feature"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#FileFormat> a rdfs:Class ;
    rdfs:label "File format"@en ;
    rdfs:comment "A file format for Resources other than\\n            audiovisual resources. The format is defined as free text or pointing at a term in a\\n            classification scheme e.g.\\n            http://www.ebu.ch/metadata/ontologies/skos/ebu_FileFormatCS.rdf."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> a rdfs:Class ;
    rdfs:label "Format"@en ;
    rdfs:comment "The format provides technical information on\\n            the format of a Resource. A BusinessObject can be instantiated in a variety of Resources\\n            each in a particular Format. Other specific data formats may be defined as subclasses of\\n            format."@en ;
    rdfs:subClassOf skos:Concept .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Generation> a rdfs:Class ;
    rdfs:label "Generation"^^xsd:string ;
    rdfs:comment "Identifies the generation of a version of a resource, i.e. master, edit master, distribution copy, etc."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> ;
    skos:prefLabel "Generation"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Genre> a rdfs:Class ;
    rdfs:label "Genre"@en ;
    rdfs:comment "This class shall be used to provide information\\n            on the genre of the BusinessObject or Resource. This is provided as free text in an\\n            annotation label or as an identifier pointing to a term in a classification scheme e.g.\\n            http://www.ebu.ch/metadata/ontologies/skos/ebu_ContentGenreCS.rdf or\\n            http://www.ebu.ch/metadata/ontologies/skos/ebu_EditorialFormatCodeCS.rdf."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Type> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Group> a rdfs:Class ;
    rdfs:label "Group"@en ;
    rdfs:comment "To define a collection / group of media\\n            resources, for example a series made of episodes."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#IPRRestrictions> a rdfs:Class ;
    rdfs:label "IPR restrictions"@en ;
    rdfs:comment "To provide information on intellectual\\n            property."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Image> a rdfs:Class ;
    rdfs:label "Image"^^xsd:string ;
    rdfs:comment "A still image / thumbnail / key frame / logo\\n            related to the media resource or being the media resource itself"^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ImageFormat> a rdfs:Class ;
    rdfs:label "Image format"@en ;
    rdfs:comment "To provide technical information about the\\n            format of an image such as the orientation. This is provided as free text in an\\n            annotation label or as an identifier pointing to a term in a classification\\n            scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Item> a rdfs:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "An item e.g. newsItem or sportItem"@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#KeyCareerEvent> a rdfs:Class ;
    rdfs:label "Key career event"^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#KeyEvent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#KeyEvent> a rdfs:Class ;
    rdfs:label "Key event"^^xsd:string ;
    rdfs:subClassOf <http://www.bbc.co.uk/ontologies/coreconcepts/Event> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#KeyPersonalEvent> a rdfs:Class ;
    rdfs:label "Key personal event"^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#KeyEvent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Keyframe> a rdfs:Class ;
    rdfs:label "key frame"@en ;
    rdfs:comment "A key frame is a frame extarcted from video,\\n            e.g. representative of a part of a MediaResource."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Picture> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Keyword> a rdfs:Class ;
    rdfs:label "Keyword"@en ;
    rdfs:comment "To proivde keywords and define key concepts\\n            illustrating the content of the Resource or EditorialObject. This is provided as free\\n            text in an annotation label or as an identifier pointing to a term in a classification\\n            scheme."@en ;
    rdfs:subClassOf skos:Concept .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Language> a rdfs:Class ;
    rdfs:label "Language"@en ;
    rdfs:comment "To provide information on languages present in\\n            the BusinessObject and its purpose. This is provided as free text in an annotation label\\n            or as an identifier pointing to a term in a classification scheme.Other language\\n            specific types may be added as subclasses of language."@en ;
    rdfs:subClassOf skos:Concept .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Location> a rdfs:Class ;
    rdfs:label "Location"^^xsd:string ;
    rdfs:comment "A location related to the media resource, e.g.\\n            depicted in the resource (possibly fictional) or where the resource was created\\n            (shooting location), etc."@en,
        "A type of location is defined as a sub-class of \\n            location."@en,
        "This is provided as free text in an annotation\\n            label or as an identifier pointing to a term in a classification scheme."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Logo> a rdfs:Class ;
    rdfs:label "Logo"@en ;
    rdfs:comment "A Logo allows to visually identify an\\n            organisation, publicationService, publicationChannel, or ratings /\\n            parentalGuidance"@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Picture> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaFragment> a rdfs:Class ;
    rdfs:label "Media Fragment"@en ;
    rdfs:comment "A MediaFragment is a temporal or spatial segment of a resource identified by a MediaGragment URI (http://www.w3.org/2008/WebVideo/Fragments/WD-media-fragments-spec/)."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> a rdfs:Class ;
    rdfs:label "Media Resource"@en ;
    rdfs:comment "The use of MediaResource is reserved to\\n            audiovisual content."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Medium> a rdfs:Class ;
    rdfs:label "Medium"@en ;
    rdfs:comment "To provide information on the medium formats in\\n            which the resource is available. This is provided as free text in an annotation label or\\n            as an identifier pointing to a term in a classification scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MetadataTrack> a rdfs:Class ;
    rdfs:label "Metadata track"^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Track> ;
    skos:prefLabel "Metadata track"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MimeType> a rdfs:Class ;
    rdfs:label "Mime type"@en ;
    rdfs:comment "The definition of the container if available as\\n            a MIME type. This is provided as free text in an annotation label or as an identifier\\n            pointing to a term in a classification scheme. For more information:\\n            http://www.iana.org/assignments/media-types/index.html."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#NewsItem> a rdfs:Class ;
    rdfs:label "News Item"@en ;
    rdfs:comment "A NewsItem aggregates all information about a particular news event."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Item> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#ObjectType> a rdfs:Class ;
    rdfs:label "Object type"@en ;
    rdfs:comment "To specify the type of BusinessObject e.g. and\\n            EditorialObject of type \"programme\" or clip\". This is\\n            provided as free text in an annotation label or as an identifier pointing to a term in a\\n            classification scheme e.g.\\n            http://www.ebu.ch/metadata/ontologies/skos/ebu_ObjectTypeCodeCS.rdf."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Type> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#OpenCaptions> a rdfs:Class ;
    rdfs:label "Open captions"@en ;
    rdfs:comment "Open Captions are burned in the\\n            image."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Captioning> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#OpenSubtitling> a rdfs:Class ;
    rdfs:label "Open subtitling"@en ;
    rdfs:comment "Open subtitles are burned in the\\n            image."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Subtitling> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Organisation> a rdfs:Class ;
    rdfs:label "Organisation"@en ;
    rdfs:comment "An organisation (business, corporation, federation, etc.) or moral agent (gvernment body)."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#OriginalLanguage> a rdfs:Class ;
    rdfs:comment "The original language in which the\\n            BusinessObject or Resource has been created and released. This is provided as free text\\n            in an annotation label or as an identifier pointing to a term in a classification\\n            scheme."^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Language> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Part> a rdfs:Class ;
    rdfs:label "Part, Fragment, Segment"@en ;
    rdfs:comment "A Fragment is a particular section of a\\n            MediaResource identified by a start and end time or duration. Fragment can also be\\n            called segment or part."@en,
        "One of more media fragment (audio, video, data)\\n            composing an audiovisual media resource. In other ontolgies fragment is often referred\\n            to e.g. as a 'part' or 'segment' or\\n            'fragment'."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Pictogram> a rdfs:Class ;
    rdfs:label "Pictogram"@en ;
    rdfs:comment "A visual / graphical representation of a concept."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Picture> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Picture> a rdfs:Class ;
    rdfs:label "Picture"@en ;
    rdfs:comment "A photography, a logo, a pictogram, etc."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Programme> a rdfs:Class ;
    rdfs:label "Programme"@en ;
    rdfs:comment "An EditorialObject corresponding to a\\n            MediaResource ready for publication."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationChannel> a rdfs:Class ;
    rdfs:label "Publication Channel"@en ;
    rdfs:comment "The name of the channel through which a\\n            Resource has been published as a PublicationEvent. A PublicationChannel can use a\\n            variety of medias e.g. broadcast or online."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> a rdfs:Class ;
    rdfs:label "Publication Event"@en ;
    rdfs:comment "To describe any manifestation of a media\\n            resource on any media (live, on demand, catch-up TV, etc.) and the appropriate\\n            PublciationChannel."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationHistory> a rdfs:Class ;
    rdfs:label "Publication History"@en ;
    rdfs:comment "A collection of PublicationEvents through which\\n            a resource has been published."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationPlanning> a rdfs:Class ;
    rdfs:label "Publication History"@en ;
    rdfs:comment "A collection of PublicationEvents organised as a PublicationPlanning."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#RadioProgramme> a rdfs:Class ;
    rdfs:label "Radio Programme"@en ;
    rdfs:comment "A programme for distribution on radio\\n            channels."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Programme> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> a rdfs:Class ;
    rdfs:label "Rating"@en ;
    rdfs:comment "All the information about the rating/evaluation\\n            given to a media resource by an Agent i.e. a person/Contact or\\n            Organisation."@en,
        "This is provided as free text in an annotation\\n            label or as an identifier pointing to a term in a classification scheme."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> a rdfs:Class ;
    rdfs:label "Resource"@en ;
    rdfs:comment "A manifestation of a\\n            BusinessObject."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> a rdfs:Class ;
    rdfs:label "Rights"@en ;
    rdfs:comment "To provide information on the rights, including\\n            intellectual property, related to a BusinessObject or Resource."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#RightsClearance> a rdfs:Class ;
    rdfs:comment "To signal that rights have been cleared (or\\n            not)"@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Role> a rdfs:Class ;
    rdfs:label "Role"@en ;
    rdfs:comment "To define the role / action of an agent. This\\n            is provided as free text in an annotation label or as an identifier pointing to a term\\n            in a classification scheme."@en ;
    rdfs:subClassOf skos:Concept .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Season> a rdfs:Class ;
    rdfs:label "Season"^^xsd:string ;
    rdfs:comment "A series can be composed of one or more seasons\\n            clustering a certain number of episodes. Fro this reason, seasons are related to series\\n            using the isRelatedTo property."^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Group> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Series> a rdfs:Class ;
    rdfs:label "Series"^^xsd:string ;
    rdfs:comment "Series is a particular type of collection. TV\\n            or Radio Series are composed of Episodes."^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Group> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Service> a rdfs:Class ;
    rdfs:label "Service"@en ;
    rdfs:comment "A service is the umbrella under which one or\\n            more PublicationChannel is operated."@en ;
    rdfs:subClassOf owl:Thing .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Signing> a rdfs:Class ;
    rdfs:label "Signing"@en ;
    rdfs:comment "To signal the presence of Signing for hard of\\n            hearing users. The type of Signing (e.g. incursted in or else) or language of Signing\\n            can be specified using the appropriate properties."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoTrack> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#SigningFormat> a rdfs:Class ;
    rdfs:label "Signing format"@en ;
    rdfs:comment "To provide additional information on the\\n            signing format. This is provided as free text in an annotation label or as an identifier\\n            pointing to a term in a classification scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#SportItem> a rdfs:Class ;
    rdfs:label "Sport item"@en ;
    rdfs:comment "A SportItem aggregates all information about a sport event."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Item> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Staff> a rdfs:Class ;
    rdfs:label "Staff member."@en ;
    rdfs:comment "Staff member."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Standard> a rdfs:Class ;
    rdfs:label "Standard"^^xsd:string ;
    rdfs:comment "identifies the technical video standard of a resource, i.e. NTSC or PAL."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> ;
    skos:prefLabel "Standard"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#StorageType> a rdfs:Class ;
    rdfs:label "Storage type"@en ;
    rdfs:comment "The type of storage used for the repository.\\n            This is provided as free text in an annotation label or as an identifier pointing to a\\n            term in a classification scheme."@en ;
    rdfs:subClassOf skos:Concept .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Stream> a rdfs:Class ;
    rdfs:label "Stream"@en ;
    rdfs:comment "A continuous stream of bits."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Component> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Subject> a rdfs:Class ;
    rdfs:label "Subject"@en ;
    rdfs:comment "A term describing the topic covered by the\\n            BusinessObject or resource. This is provided as free text in an annotation label or as\\n            an identifier pointing to a term in a classification scheme."@en ;
    rdfs:subClassOf skos:Concept .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Subtitling> a rdfs:Class ;
    rdfs:label "Subtitling"@en ;
    rdfs:comment "To signal the presence of subtitles for\\n            translation in alternative languages."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DataTrack> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#SubtitlingFormat> a rdfs:Class ;
    rdfs:label "Subtitling format"@en ;
    rdfs:comment "To define the format of subtitling.\\n            subtitling's main use isfor translation. This is provided as free text in an\\n            annotation label  or as an identifier pointing to a term in a classification\\n            scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DataFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#TVProgramme> a rdfs:Class ;
    rdfs:label "TV Programme"@en ;
    rdfs:comment "A programme for distribution on television\\n            channels."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Programme> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Tag> a rdfs:Class ;
    rdfs:label "Tag"^^xsd:string ;
    rdfs:comment "An annotation specific to a particular\\n            timestamp in audiovisual MediaResources."^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Annotation> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Thumbnail> a rdfs:Class ;
    rdfs:label "Thumbnail"@en ;
    rdfs:comment "A thumbnail is a low resolution picture that\\n            can be associated with EditorialObjects or e.g. MediaResources or\\n            Contacts."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Picture> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#TimecodeTrack> a rdfs:Class ;
    rdfs:label "Timecode track"^^xsd:string ;
    rdfs:comment "A track with timecode information."^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Track> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Topic> a rdfs:Class ;
    rdfs:label "Topic"@en ;
    rdfs:comment "A type subject for use in some contexts. This\\n            is provided as free text in an annotation label or as an identifier pointing to a term\\n            in a classification scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Subject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Track> a rdfs:Class ;
    rdfs:label "Track"@en ;
    rdfs:comment "Audiovisual content can be composed of audio,\\n            video and data Tracks (including captioning and subtitling)."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Essence> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Type> a rdfs:Class ;
    rdfs:label "Type"@en ;
    rdfs:comment "An expression of type in textual form or as a term from a classification scheme."@en ;
    rdfs:subClassOf skos:Concept .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#UsageRights> a rdfs:Class ;
    rdfs:label "Usage rights"@en ;
    rdfs:comment "Usage rights associated with content."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoEncodingFormat> a rdfs:Class ;
    rdfs:label "Video encoding format"@en ;
    rdfs:comment "The encoding format of the video."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EncodingFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoFormat> a rdfs:Class ;
    rdfs:label "Video format"@en ;
    rdfs:comment "To provide additional technical information\\n            about a video resource such as the frame rate. This is provided as free text in an\\n            annotation label or as an identifier pointing to a term in a classification\\n            scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Format> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoStream> a rdfs:Class ;
    rdfs:label "Video stream"@en ;
    rdfs:comment "A decodable video stream of bits."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Stream> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoTrack> a rdfs:Class ;
    rdfs:label "Video track"@en ;
    rdfs:comment "A specialisation of Track for Video to provide\\n            a link to specific data properties such as frameRate, etc. Signing is another possible\\n            example of video track. Specific VideoTracks such as Signing can be defined as sub\\n            VideoTracks.. In advanced systems, different VideoTracks can be used to provide e.g.\\n            different viewing angles."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Track> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#YouTubeVideo> a rdfs:Class ;
    rdfs:label "You tube video"^^xsd:string ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#audienceLevel> a rdfs:Class ;
    rdfs:label "Target audience"@en ;
    rdfs:comment "The target audience (target region, target\\n            audience category but also parental guidance recommendation) for which the media\\n            resource is intended."@en,
        "This is provided as free text in an annotation\\n            label or as an identifier pointing to a term in a classification scheme."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Type> .

foaf:Agent a rdfs:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "A person or Organisation."@en ;
    rdfs:subClassOf dc:Agent .

foaf:Group a rdfs:Class ;
    rdfs:label "Group"@en ;
    rdfs:comment "A group of Agents."@en ;
    rdfs:subClassOf owl:Thing .

foaf:Organization a rdfs:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "An organisation (business, corporation, federation, etc.) or moral agent (gvernment body)."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Organisation> .

foaf:img a rdfs:Class ;
    rdfs:label "Image"@en ;
    rdfs:comment "Animage to represent something."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Picture> .

foaf:person a rdfs:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "all types of people such as politicians, athletes, historic figures, contributors in programmes e.t.c."@en ;
    rdfs:subClassOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> .

dc:rights a rdf:Property ;
    rdfs:label "Rights"@en ;
    rdfs:comment "Rights information related to an Asset, aPublicationEvent, a BusinessObject or a resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> ) ] .

dcterms:contributor a rdf:Property ;
    rdfs:label "contributor"@en .

dcterms:coverage a rdf:Property ;
    rdfs:label "coverage"@en .

dcterms:creator a rdf:Property ;
    rdfs:label "Creator"@en .

dcterms:description a rdf:Property ;
    rdfs:label "Description"@en ;
    rdfs:range xsd:string .

dcterms:format a rdf:Property ;
    rdfs:label "format"@en .

dcterms:language a rdf:Property ;
    rdfs:label "language"@en .

dcterms:publisher a rdf:Property ;
    rdfs:label "Publisher"@en .

dcterms:relation a rdf:Property ;
    rdfs:label "Relation"@en .

dcterms:rights a rdf:Property ;
    rdfs:label "Rights"@en .

dcterms:source a rdf:Property ;
    rdfs:label "Source"@en .

dcterms:subject a rdf:Property ;
    rdfs:label "Subject"@en .

dcterms:title a rdf:Property ;
    rdfs:label "Title"@en ;
    rdfs:range xsd:string .

dcterms:type a rdf:Property ;
    rdfs:label "type"@en .

<http://www.bbc.co.uk/ontologies/coreconcepts/dateOfBirth> a rdf:Property ;
    rdfs:label "Date of birth"@en ;
    rdfs:comment "The date when a Contact/Person is born."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:subPropertyOf dc:date .

<http://www.bbc.co.uk/ontologies/coreconcepts/dateOfDeath> a rdf:Property ;
    rdfs:label "Date of death"@en ;
    rdfs:comment "The date when a Contact/Person has passed away."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:subPropertyOf dc:date .

<http://www.bbc.co.uk/ontologies/coreconcepts/gender> a rdf:Property ;
    rdfs:label "Gender"@en ;
    rdfs:comment "The gender of a person e.g. male or female."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:range xsd:string .

<http://www.bbc.co.uk/ontologies/coreconcepts/placeOfBirth> a rdf:Property ;
    rdfs:label "Place of birth"@en ;
    rdfs:comment "The place where a person is born."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> .

<http://www.bbc.co.uk/ontologies/coreconcepts/placeOfDeath> a rdf:Property ;
    rdfs:label "Place of death"@en ;
    rdfs:comment "The place where a person has passed away."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> .

<http://www.bbc.co.uk/ontologies/coreconcepts/primaryTopic> a rdf:Property ;
    rdfs:label "Primary topic"@en ;
    rdfs:comment "The main subject of interest."@en ;
    rdfs:subPropertyOf dc:description .

<http://www.bbc.co.uk/ontologies/coreconcepts/slug> a rdf:Property ;
    rdfs:label "Slug"@en ;
    rdfs:comment "One or more keywords."@en ;
    rdfs:subPropertyOf dc:description .

onto: a owl:Ontology ;
    ns2:licence "http://creativecommons.org/licenses/by-sa/3.0/"^^xsd:string ;
    dc:contributor "Adam Wead, Penn State University"@en-us,
        "Casey Davis, WGBH"@en-us,
        "Chuck McCallum, WGBH"@en-us,
        "Cliff Ingham, City of Bloomington"@en-us,
        "Drew Myers, WGBH"@en-us,
        "Glenn Clatworthy, PBS"@en-us,
        "Jack Brighton, WILL Public Media"@en-us,
        "Julie Hardesty, Indian University Library"@en-us,
        "Kara vam Malssen, AV Preserve"@en-us,
        "Karen Cariani, WGBH"@en-us,
        "Laurence Cook, metaCirque"@en-us,
        "Michael J. Giarlo, Penn State University"@en-us,
        "Peggy Griesinger, George Mason University Libraries"@en-us,
        "Rebecca Fraimow, WGBH"@en-us,
        "Rebecca Guenther, Rebecca Guenther Consulting"@en-us,
        "Sadie Roosa, WGBH"@en-us,
        "Valerie J. Miller, PBS"@en-us ;
    dc:description "The development of the EBUCore ontology is now a joint effort of the EBUCore and PBCore communities."^^xsd:string,
        "Guidelines: for the purpose of flexibility and interoperability with a wider range of implementations, some properties purposefully do not have a range and accept either a resource or a literal.  When a resource is used, it is recommended to reuse objects defined in the model (e.g. pair hasEvent/Event or hasRole/Role). Example 1: x hasRole 'actor'. Example 2: x hasRole _:Role_1 (a reference to the Concept Id from a SKOS Role vocabulary defined in the ontology)."@en,
        "Note to implementers: The EBUCore ontology is used by a variety of users with different needs. Several EBUCore properties have no range to allow different implementations using entities or literals. As an implementer, it is your choice to go for one or the other for each property to have consistent expectations when parsing individuals. EBUCore also provides different classes defined as subclasses of skos:Concept. You can use these classes as entities in range of several properties currently left without range. EBUCore is expressed in RDF in order to facilitate such modelling and flexibility. As a consequence, propoerties appear in the documentation as annotation properties."@en,
        "The EBUCore has been designed to make users benefit from the flexibility of RDF to adapt the names of Classes and properties to their respective needs. This means users are welcome to add their own subclasses (e.g. to define the most appropriate BusinessObjects or Resources or Agents) and subproperties."@en ;
    dc:rights "Copyright 2015 EBU"@en ;
    dc:title "EBUCore - the Dublin Core for media"@en ;
    dcterms:issued "2013-01-01"^^xsd:date ;
    dcterms:modified "2015-08-04"^^xsd:date ;
    vann:preferredNamespaceUri "http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#"^^xsd:string ;
    owl:backwardCompatibleWith <http://www.ebu.ch/metadata/ontologies/ebucore/20150122/ebucore_2015_05_20.rdf> ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ;
    owl:priorVersion <http://www.ebu.ch/metadata/ontologies/ebucore/20150122/ebucore_2015_05_20.rdf> ;
    owl:versionInfo "Add \"Feature\" as sub-class of EditorialObject"@en,
        "Added eventPeriod property."@en,
        "EBUCore based on Dublin Core + SKOS + some BBC Core Concepts + basic FOAF properties  + equivalences to W3C MA-ONT"@en,
        "Improve the relations around the notions of \"hasContributor\", \"Character\", \"Cast\"."@en,
        "Leftovers from object audio components removed."@en,
        "More consistency on opening property ranges to allow resources or literals."@en,
        "New hasAudioDescription property pointing to a resource (new AudioDescription as subclass of audioTrack) or a presence flag"@en,
        "PBCore updates:  dateBroadcast, dateLicenced, endLicencedate, dateDistributed, dateDeleted, dateIngested, dateMigrated, dateNormalized, dateTransferred, dateValidated, shotlog, folksonomy, clonedTo/isClonedFrom, dubbedTo/isDubbedfrom, derivedTo/isDerivedFrom, playbackSpeed, framesPerSecond, inchesPerSecond, hasGeneration, hasStandard, dimensions."@en,
        "Version 1.6"@en,
        "hasCaptioning, hasSigning, hasSubtitling: the range is either a resource or a literal/boolean indicating the presence/absence thereof"@en ;
    ns1:term_status "stable"@en .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#DID> a rdf:Property ;
    rdfs:label "DID"@en ;
    rdfs:comment "The Data Identifier word (along with the SDID,\\n            if used), indicates the type of ancillary data that the packet corresponds\\n            to."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AncillaryData> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#SDID> a rdf:Property ;
    rdfs:label "SDID"@en ;
    rdfs:comment "Secondary data identification word for\\n            ancillary data. Send mode identifier. An identifier which indicates the transmission\\n            timing for closed caption data."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AncillaryData> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#abridgedTitle> a rdf:Property ;
    rdfs:label "Abridged title"@en ;
    rdfs:comment "A shorter version of the title."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#alternativeTitle> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#abstract> a rdf:Property ;
    rdfs:label "Abstract"@en ;
    rdfs:comment "To provide a brief summary."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#adultContent> a rdf:Property ;
    rdfs:label "adult content"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range xsd:boolean .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#affiliationEndDate> a rdf:Property ;
    rdfs:label "Affiliation start date"@en ;
    rdfs:comment "The date when a Contact left an Organisation"@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Affiliation> ;
    rdfs:range xsd:date .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#affiliationStartDate> a rdf:Property ;
    rdfs:label "Affiliation start date"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Affiliation> ;
    rdfs:range xsd:date .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentCountryOfResidence> a rdf:Property ;
    rdfs:label "agent country of residence"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentNationality> a rdf:Property ;
    rdfs:label "agent nationality"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentNickname> a rdf:Property ;
    rdfs:label "Nickname"@en ;
    rdfs:comment "To provide a nickname of a Contact/person."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentPictureIdLocator> a rdf:Property ;
    rdfs:label "agent picture id locator"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#locator> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#appliesOutOf> a rdf:Property ;
    rdfs:label "Exclusion area"@en ;
    rdfs:comment "To define the Location (e.g. country, region) to which Rating and TargetAudience do NOT apply."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#audienceLevel> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#appliesTo> a rdf:Property ;
    rdfs:label "Coverage"@en ;
    rdfs:comment "To define the location/region to which Rating and TargetAudience apply."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#audienceLevel> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#aspectRatio> a rdf:Property ;
    rdfs:label "Aspect ratio"@en ;
    rdfs:comment "To provide the aspect ratio of a video frame or\\n            image. Several types of different aspect ration can apply to the same video image. If\\n            necessary, specialised aspect ratios can be defined as subproperties."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Picture> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoTrack> ) ] ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#audioChannelNumber> a rdf:Property ;
    rdfs:label "Audio channel number"@en ;
    rdfs:comment "The total number of audio channels contained in\\n            the MediaResource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range xsd:nonNegativeInteger .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#audioTrackConfiguration> a rdf:Property ;
    rdfs:label "Audio track configuration"^^xsd:string ;
    rdfs:comment "To provide the configuration of an audio track\\n            (e.g. stereo pair) in a MediaResource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#bitDepth> a rdf:Property ;
    rdfs:label "Bit depth"@en ;
    rdfs:comment "To provide the audio encoding bit depth. Also called sample size."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#bitRate> a rdf:Property ;
    rdfs:label "Bitrate"^^xsd:string ;
    rdfs:comment "To provide the bitrate at which the\\n            MediaResource can be played in bits/second. Current bitrate if constant, and average bitrate if variable."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range xsd:nonNegativeInteger ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#averageBitRate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#bitRateMax> a rdf:Property ;
    rdfs:label "Maximum bitrate"@en ;
    rdfs:comment "The maximum bitrate when variable, in bits per second."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#bitRateMode> a rdf:Property ;
    rdfs:label "Bitrate mode"@en ;
    rdfs:comment "A flag to indicate if the bit rate is fixed or\\n            variable."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#bookmark> a rdf:Property ;
    rdfs:label "Bookmark"@en ;
    rdfs:comment "To provide a bookmark."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#businessObjectName> a rdf:Property ;
    rdfs:label "Name"@en ;
    rdfs:comment "A name attributed to a\\n            BusinessObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#captioningSource> a rdf:Property ;
    rdfs:label "Captioning source"@en ;
    rdfs:comment "To provide information on the source of a\\n            captioning file."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#codecFamily> a rdf:Property ;
    rdfs:label "Codec family"@en ;
    rdfs:comment "To provide information on the product family of the Codec."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Codec> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#codecName> a rdf:Property ;
    rdfs:label "Codec name"@en ;
    rdfs:comment "To provide a name for the Codec, e.g. a product name."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Codec> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#codecVendor> a rdf:Property ;
    rdfs:label "Codec vendor"@en ;
    rdfs:comment "To provide a name for the vendor of the Codec."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Codec> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#codecVersion> a rdf:Property ;
    rdfs:label "Codec version"@en ;
    rdfs:comment "To provide information on the version of the Codec."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Codec> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#comments> a rdf:Property ;
    rdfs:label "Comments"@en ;
    rdfs:comment "To provide a comment."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#contactEducation> a rdf:Property ;
    rdfs:label "Education"@en ;
    rdfs:comment "The education details of a Contact /\\n            person."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#contactFamilyInformation> a rdf:Property ;
    rdfs:label "Family information"@en ;
    rdfs:comment "Information on the family of a Contact /\\n            person."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#contactHobbies> a rdf:Property ;
    rdfs:label "Hobbies"@en ;
    rdfs:comment "The hobbies of a Contact /\\n            person."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#contactMaritalStatus> a rdf:Property ;
    rdfs:label "Marital status"@en ;
    rdfs:comment "The marital status of a Contact /\\n            person."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#contactOccupation> a rdf:Property ;
    rdfs:label "Occupation"@en ;
    rdfs:comment "The job / occupation name of a Contact /\\n            person."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#contactUsername> a rdf:Property ;
    rdfs:label "Username"@en ;
    rdfs:comment "The username by which a Contact / person is\\n            known e.g. when attributing a rating value."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty foaf:nick .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateBroadcast> a rdf:Property ;
    rdfs:label "Broadcast date"^^xsd:string ;
    rdfs:comment "The date when the resource was first broadcast publicly on television or radio."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateCreated> a rdf:Property ;
    rdfs:label "Creation date/time"^^xsd:string ;
    rdfs:comment "The date of creation of the Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateDeleted> a rdf:Property ;
    rdfs:label "Deletion date"^^xsd:string ;
    rdfs:comment "The date when the resource was removed from institutional holdings."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateDigitised> a rdf:Property ;
    rdfs:label "Digitisation date/time"^^xsd:string ;
    rdfs:comment "To provide the date of digitisation of the Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateDistributed> a rdf:Property ;
    rdfs:label "Distribution date"^^xsd:string ;
    rdfs:comment "The date when the resource was first made available to the public for purchase, download, or online access."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateIngested> a rdf:Property ;
    rdfs:label "Ingest date"^^xsd:string ;
    rdfs:comment "The date when the resource was removed from institutional holdings."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateIssued> a rdf:Property ;
    rdfs:label "Publication date/time"^^xsd:string ;
    rdfs:comment "To provide the date of release of the Resource."@en ;
    rdfs:subPropertyOf dcterms:issued ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#releaseDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateLicenced> a rdf:Property ;
    rdfs:label "License start date"^^xsd:string ;
    rdfs:comment "The date when the license for the resource begins."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateMigrated> a rdf:Property ;
    rdfs:label "Migration date"^^xsd:string ;
    rdfs:comment "The date when the resource was copied or converted from an obsolete or endangered original format to a more updated format for preservation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateModified> a rdf:Property ;
    rdfs:label "Modification date/time"^^xsd:string ;
    rdfs:comment "To indicate the date at which the Resource has been modified."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dcterms:modified .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateNormalized> a rdf:Property ;
    rdfs:label "Normalization date"^^xsd:string ;
    rdfs:comment "The date when the resource was converted from its original format into a format pre-selected by the institution for preservation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateTransferred> a rdf:Property ;
    rdfs:label "Transfer date"^^xsd:string ;
    rdfs:comment "The date when the resource was moved from one digital or physical location to another."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dateValidated> a rdf:Property ;
    rdfs:label "Validation date"^^xsd:string ;
    rdfs:comment "The most recent date when the resource was confirmed to be valid through manual or digital QC."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:date ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#creationDate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dimensions> a rdf:Property ;
    rdfs:label "Dimensions"@en ;
    rdfs:comment "Describes the physical dimensions of a media resource, with units of measure concatenated to become part of the value."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:double .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dopesheet> a rdf:Property ;
    rdfs:label "Dopesheet"@en ;
    rdfs:comment "To provide a dopesheet with a title and brief description for news."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationNormalPlayTime> a rdf:Property ;
    rdfs:label "Duration (time)"^^xsd:string ;
    rdfs:comment "To provide a duration as normal\\n            time."@en ;
    rdfs:range xsd:time ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#duration> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationNumberEditUnit> a rdf:Property ;
    rdfs:label "Duration (edit units)"^^xsd:string ;
    rdfs:comment "To provide a duration as a number of EditUnits\\n            which value is for instance the inverse of the audio sample rate or video frame\\n            rate."@en ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#duration> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationPublishedNormalPlayTime> a rdf:Property ;
    rdfs:label "Published duration (time)"@en ;
    rdfs:comment "To provide a published duration as normal\\n            time."@en ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationPublished> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationPublishedNumberEditUnit> a rdf:Property ;
    rdfs:label "Published duration (edit units)"@en ;
    rdfs:comment "To provide a published duration as a number of EditUnits\\n            which value is for instance the inverse of the audio sample rate or video frame\\n            rate."@en ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationPublished> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationPublishedTimecode> a rdf:Property ;
    rdfs:label "Published duration (timecode)"@en ;
    rdfs:comment "The published duration expressed as a\\n            timecode."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationPublished> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationTimecode> a rdf:Property ;
    rdfs:label "Duration (timecode)"^^xsd:string ;
    rdfs:comment "The duration expressed as a\\n            timecode."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#duration> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#editUnit> a rdf:Property ;
    rdfs:label "Edit unit"@en ;
    rdfs:comment "The edit unit is e.g. the inverse of the audio\\n            sample rate or video frame rate."@en ;
