    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#end> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#endNumberEditUnits> a rdf:Property ;
    rdfs:label "End time (edit units)"@en ;
    rdfs:comment "A start time expressed as a number of edit\\n            units."@en ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#end> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#endTimecode> a rdf:Property ;
    rdfs:label "End time (timecode)"@en ;
    rdfs:comment "A start time expressed as\\n            timecode."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#end> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#eventDescription> a rdf:Property ;
    rdfs:label "Description"@en ;
    rdfs:comment "To provide a deescription for an\\n            Event."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Event> ;
