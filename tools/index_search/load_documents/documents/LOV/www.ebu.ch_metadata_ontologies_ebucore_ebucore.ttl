<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#eventEndDate> a rdf:Property ;
    rdfs:label "Event end date"@en ;
    rdfs:comment "The end date of an Event."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Event> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#eventName> a rdf:Property ;
    rdfs:label "Event name"@en ;
    rdfs:comment "To provide a name for an Event."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Event> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#eventPeriod> a rdf:Property ;
