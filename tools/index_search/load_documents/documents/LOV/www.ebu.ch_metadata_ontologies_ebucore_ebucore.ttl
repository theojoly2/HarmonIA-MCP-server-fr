    rdfs:comment "To identify Contact/persons being fictitious."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Character> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isMemberOf> a rdf:Property ;
    rdfs:label "Member of"@en ;
    rdfs:comment "To identify a Group to which an EidtorialObject is a member of."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Group> ;
