foaf:age a rdf:Property ;
    rdfs:label "age"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentAge> .

foaf:member a rdf:Property ;
    rdfs:label "Group member"@en ;
    rdfs:comment "To identify an Agent member of a Group."@en ;
    rdfs:domain foaf:Group ;
    rdfs:range foaf:Agent .

foaf:name a rdf:Property ;
    rdfs:label "Name"@en ;
    rdfs:comment "To name an Agent."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range xsd:string .

dc:creator a rdf:Property ;
    rdfs:label "Creator"@en ;
    rdfs:comment "A creator of content such as a director or a producer."@en ;
    rdfs:subPropertyOf dc:contributor .

dc:format a rdf:Property ;
    rdfs:label "Format"@en ;
    rdfs:comment "Information about the Format of a Resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> .

dc:identifier a rdf:Property ;
    rdfs:label "identifier"@en ;
    rdfs:comment "An identifier associated with a BusinessObject or a resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range xsd:anyURI .

dc:language a rdf:Property ;
    rdfs:label "Language"@en ;
    rdfs:comment "A Languages used in the BusinessObject or Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] .

dc:publisher a rdf:Property ;
    rdfs:label "Publisher"@en ;
    rdfs:comment "An Agent involved in the distribution of content."@en ;
    rdfs:subPropertyOf dc:contributor .

dc:source a rdf:Property ;
    rdfs:label "Source"@en ;
    rdfs:comment "To identify a Resource as the source of another Resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> .

dc:subject a rdf:Property ;
    rdfs:label "Subject"@en ;
    rdfs:comment "To associate a Subject or topic addressed by a\\r\\n            BusinessObject / Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] .

dc:type a rdf:Property ;
    rdfs:label "type"@en ;
    rdfs:comment "A concept associated with a BusinessObject or Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] .

dcterms:alternative a rdf:Property ;
    rdfs:label "Alternative title"@en ;
    rdfs:comment "An alternative to the title."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:range xsd:string .

dcterms:issued a rdf:Property ;
    rdfs:label "Issued"@en ;
    rdfs:subPropertyOf dc:date .

dcterms:modified a rdf:Property ;
    rdfs:label "Modified"@en ;
    rdfs:subPropertyOf dc:date .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentAge> a rdf:Property ;
    rdfs:label "Age"@en ;
    rdfs:comment "The age of a Contact/Person"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#clonedTo> a rdf:Property ;
    rdfs:label "Cloned to"@en ;
    rdfs:comment "Identifies relationship between a digital instantiation of a resource and its direct copy, with no generational loss."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isClonedFrom> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#derivedTo> a rdf:Property ;
    rdfs:label "Derived to"@en ;
    rdfs:comment "Identifies a content-based relationship between two resources."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isDerivedFrom> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dubbedTo> a rdf:Property ;
    rdfs:label "Dubbed to"@en ;
    rdfs:comment "Identifies relationship between a physical instantiation of a resource and a duplicate physical copy that may involve generational loss."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isDubbedFrom> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#familyName> a rdf:Property ;
    rdfs:label "Family name"@en ;
    rdfs:comment "To provide a family name / last name."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentName> ;
    owl:equivalentProperty foaf:familyName .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#givenName> a rdf:Property ;
    rdfs:label "Given name"@en ;
    rdfs:comment "To provide one or more given names."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentName> ;
    owl:equivalentProperty foaf:givenName .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasEpisode> a rdf:Property ;
    rdfs:label "Episode"@en ;
    rdfs:comment "To identify an episode of a\\n            Series or a Season."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Season> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Series> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Programme> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isEpisodeOf> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasKeyword> a rdf:Property ;
    rdfs:label "Keyword"@en ;
    rdfs:comment "To associate a concept, descriptive phrase or\\n            Keyword that specifies the topic of the BusinessObject or Annotation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Annotation> ) ] ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasKeyword> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasLanguage> a rdf:Property ;
    rdfs:label "Language"@en ;
    rdfs:comment "To associate a Language to a Resource or\\n            BusinessObject. A controlled vocabulary based on BCP 47 is recommended. This\\n            property can also be used to identify the presence of sign language (RFC 5646). By\\n            inheritance, the hasLanguage property applies indifferently at the MediaResource /\\n            Fragment / Track levels at which the usage is being defined. Best practice recommends to\\n            use to best possible level of granularity fo describe the usage of language within a\\n            MediaResource including at Fragment and Track levels."@en ;
    rdfs:subPropertyOf dc:language ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasLanguage> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMember> a rdf:Property ;
    rdfs:label "Member."@en ;
    rdfs:comment "To establish group/collection relationship between EditorialObjects."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Group> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasSeason> a rdf:Property ;
    rdfs:label "Season"@en ;
    rdfs:comment "The Season of a Series."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Series> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Season> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isSeasonOf> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasSubject> a rdf:Property ;
    rdfs:label "Subject"@en ;
    rdfs:comment "To associate a Subject addressed with a\\n            BusinessObject / Resource."@en ;
    rdfs:subPropertyOf dc:subject .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasVersion> a rdf:Property ;
    rdfs:label "Version"@en ;
    rdfs:comment "To identify another version of an Asset, BusinessObject or Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isVersionOf> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasVideoFormat> a rdf:Property ;
    rdfs:label "Video format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isClonedFrom> a rdf:Property ;
    rdfs:label "Cloned from"@en ;
    rdfs:comment "Identifies relationship between a digital instantiation of a resource and its direct copy, with no generational loss."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#clonedTo> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isDerivedFrom> a rdf:Property ;
    rdfs:label "Derived from"@en ;
    rdfs:comment "Identifies a content-based relationship between two resources."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#derivedTo> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isDubbedFrom> a rdf:Property ;
    rdfs:label "Dubbed from"@en ;
    rdfs:comment "Identifies relationship between a physical instantiation of a resource and a duplicate physical copy that may involve generational loss."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#dubbedTo> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isEpisodeOf> a rdf:Property ;
    rdfs:label "Parent season"@en ;
    rdfs:comment "The Episode of a Series or a Season."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Programme> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Season> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Series> ) ] ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasEpisode> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isMediaFragmentOf> a rdf:Property ;
    rdfs:label "Source"@en ;
    rdfs:comment "To identify the MediaResource to which the MediaFragment belongs to."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaFragment> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedResource> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#isFragmentOf> ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMediaFragment> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isOwnedBy> a rdf:Property ;
    rdfs:label "Owner"@en ;
    rdfs:comment "To identify the Agent (Contact/person or\\n            Organisation) who owns a Service operating a PublicationChannel."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Service> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isSeasonOf> a rdf:Property ;
    rdfs:label "Parent Series"@en ;
    rdfs:comment "The Season of a Series."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Season> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Series> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasSeason> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isVersionOf> a rdf:Property ;
    rdfs:label "Version of"@en ;
    rdfs:comment "To identify related versions."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasVersion> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#locator> a rdf:Property ;
    rdfs:label "Locator"^^xsd:string ;
    rdfs:comment "A locator from where the Resource can be accessed."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#locator> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#nameTitle> a rdf:Property ;
    rdfs:label "Salutation title"@en ;
    rdfs:comment "To provide a salutation title e.g M. Ms, Dr, Pr."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentName> ;
    owl:equivalentProperty foaf:title .

<http://www.w3.org/ns/ma-ont#averageBitRate> a rdf:Property ;
    rdfs:label "Average bit rate"^^xsd:string ;
    rdfs:comment "The average bit rate as defined in the media annotation ontology (ma-ont) http://www.w3.org/TR/mediaont-10/"^^xsd:string ;
    rdfs:range xsd:integer ;
    skos:prefLabel "Average bit rate"^^xsd:string .

<http://www.w3.org/ns/ma-ont#hasPermissions> a rdf:Property ;
    rdfs:label "Permissions"^^xsd:string ;
    rdfs:comment "To define permissions as defined in the W3C media ontology (ma-ont)"^^xsd:string ;
    skos:prefLabel "Permissions"^^xsd:string .

<http://www.w3.org/ns/ma-ont#isRelatedTo> a rdf:Property ;
    rdfs:label "Relation"^^xsd:string ;
    rdfs:comment "To define relations as defined in the W3C media ontology (ma-ont)"^^xsd:string ;
    skos:prefLabel "Relation"^^xsd:string .

foaf:familyName rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#familyName> .

foaf:givenName rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#givenName> .

foaf:title rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#nameTitle> .

dc:title a rdf:Property ;
    rdfs:label "Title"^^xsd:string ;
    rdfs:comment "The title by which a BusinessObject is known."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentAddress> a rdf:Property ;
    rdfs:label "Address"@en ;
    rdfs:comment "To provide the address of an Agent\\n            (Contact/person or organisation)."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentEmailAddress> a rdf:Property ;
    rdfs:label "Email"@en ;
    rdfs:comment "To provide the email address of an agent\\n            (Contact/person or organisation)."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty foaf:mbox .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentMobileTelephoneNumber> a rdf:Property ;
    rdfs:label "Mobile"@en ;
    rdfs:comment "To provide the mobile telephone number of an\\n            Agent (Contact/person or organisation)"@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentTelephoneNumber> a rdf:Property ;
    rdfs:label "Telephone"@en ;
    rdfs:comment "To provide the telephone number of an Agent\\n            (Contact/person or Organisation)."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentWebHomepage> a rdf:Property ;
    rdfs:label "Homepage"@en ;
    rdfs:comment "To provide the address of the webpage of an\\n            Agent (Contact/person or Organisation)."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:anyURI ;
    owl:equivalentProperty foaf:homepage .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#frequency> a rdf:Property ;
    rdfs:label "Frequency"@en ;
    rdfs:comment "To provide the frequency of an AudioChannel filter"@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioChannel> ;
    rdfs:range xsd:integer .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasEncodingFormat> a rdf:Property ;
    rdfs:label "Encoding format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMediaFragment> a rdf:Property ;
    rdfs:label "Part"@en ;
    rdfs:comment "To define Parts (segments, fragments, etc.)\\n            withiin a MediaResource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaFragment> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedResource> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasFragment> ;
    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isMediaFragmentOf> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedEvent> a rdf:Property ;
    rdfs:label "has related event"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Event> ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRights> a rdf:Property ;
    rdfs:label "Rights"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    skos:prefLabel "Rights"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#playbackSpeed> a rdf:Property ;
    rdfs:label "Playback speed"@en ;
    rdfs:comment "Identifies the rate of units against time at which the resource should be played back for human consumption.  If the unit of measure is known, use sub-properties framesPerSecond or inchesPerSecond."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:double ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#frameRate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#title> a rdf:Property ;
    rdfs:label "Title"@en ;
    rdfs:comment "All value of the EBU title status\\n            classification scheme\\n            (http://www.ebu.ch/metadata/cs/web/ebu_TitleStatusCodeCS_p.xml.htm) are candidates\\n            subproperties of the title property as implemented for an example with\\n            alternativeTitle."@en,
        "Specifies the title or name given to the\\n            resource.  A root for the definition of subproperties defining ebucore titles of different types. The ebucore title type can be used to define sub-properties to optionally refine the category of\\n            the title."@en ;
    rdfs:subPropertyOf dc:title ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#title> .

dc:contributor a rdf:Property ;
    rdfs:label "Contributor"@en ;
    rdfs:comment "An Agent who has participated in any phase of management of a BusinessObject or Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentName> a rdf:Property ;
    rdfs:label "Name"@en ;
    rdfs:comment "To provide the full name of Contact/person - family and given name."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#duration> a rdf:Property ;
    rdfs:label "Duration"@en ;
    rdfs:comment "To provide information on the duration of a MediaResource. It corresponds to 'duration' in the\\n            Ontology for Media Resources."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> ) ] ;
    rdfs:range rdfs:Literal ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#duration> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#durationPublished> a rdf:Property ;
    rdfs:label "Published Duration"@en ;
    rdfs:comment "To provide information on the published / announced duration of an EditorialObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> ;
    rdfs:range rdfs:Literal .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#end> a rdf:Property ;
    rdfs:label "End time"@en ;
    rdfs:comment "The start point of the media\\n            resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range rdfs:Literal .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasDataFormat> a rdf:Property ;
    rdfs:label "Data format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasType> a rdf:Property ;
    rdfs:label "Type"@en ;
    rdfs:comment "To define a type of BusinessObject is not declared as a subClass of BusinessObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:subPropertyOf dc:type .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#start> a rdf:Property ;
    rdfs:label "Start time"@en ;
    rdfs:comment "The start point of the MediaResource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> ) ] ;
    rdfs:range rdfs:Literal .

dc:coverage a rdf:Property ;
    rdfs:label "Coverage"@en ;
    rdfs:comment "A property to identify the Events and or\\r\\n            Locations, all real or fictional, covered by the \\r\\n            BusinessObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> .

dc:description a rdf:Property ;
    rdfs:label "Description"^^xsd:string ;
    rdfs:comment "A description of the BusinessObject or Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#alternativeTitle> a rdf:Property ;
    rdfs:label "Alternative title"@en ;
    rdfs:comment "To provide an alternative title."@en ;
    rdfs:subPropertyOf dcterms:alternative ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#alternativeTitle> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#locationAddress> a rdf:Property ;
    rdfs:label "Address"@en ;
    rdfs:comment "To provide the address of a\\n           Location."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Location> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#officeMailAddress> a rdf:Property ;
    rdfs:label "Office mail address"@en ;
    rdfs:comment "To provide the professional / office address of\\n            an agent (Contact/person or organisation)."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentAddress> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#privateMailAddress> a rdf:Property ;
    rdfs:label "Private mail address"@en ;
    rdfs:comment "To provide the private / personal address of an\\n            agent (Contact/person)."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#agentAddress> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#loudnessParameters> a rdf:Property ;
    rdfs:label "loudness parameters"@en ;
    rdfs:comment "All the parameters for measurement of loudness at the AudioContent or AudioProgramme level."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioContent> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioProgramme> ) ] ;
    rdfs:range rdfs:Literal .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedResource> a rdf:Property ;
    rdfs:label "Related resource"^^xsd:string ;
    rdfs:comment "To identify a Resource associated with an Asset or a BusinessObject or a PublicationEvent or another Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:subPropertyOf dc:relation ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasRelatedResource> .

skos:Concept rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> a rdf:Property ;
    rdfs:label "Editorial object"@en ;
    rdfs:comment "EditorialObjects can be related to other BusinessOjects, Assets (and associated rights), PublicationEvents(defined when commissioning the EditorialObject before it is instantiated as a Resource (manifestation), or Resources, or Ratings."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> a rdf:Property ;
    rdfs:label "Description"^^xsd:string ;
    rdfs:comment "This can be specialised by using sub-properties\\n            like defined in http://www.ebu.ch/metadata/cs/web/ebu_DescriptionTypeCodeCS_p.xml.htm\\n            implemented as examples as e.g. 'summary' or\\n            'script'."^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:description ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> a rdf:Property ;
    rdfs:label "Format"@en ;
    rdfs:comment "A property to define the Format of a Resource."@en ;
    rdfs:subPropertyOf dc:format ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasFormat> .

dc:date a rdf:Property ;
    rdfs:label "date"@en ;
    rdfs:comment "A date associated with the BusinessObject, Resource or Contact/Person."@en ;
    rdfs:range xsd:date .

dc:relation a rdf:Property ;
    rdfs:label "Relation"@en ;
    rdfs:comment "A relation between BusinessObjects and resources."@en .

