    owl:inverseOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMember> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isNextInSequence> a rdf:Property ;
    rdfs:label "Next"^^xsd:string ;
    rdfs:comment "A link to a an BusinessObject or a Resource following the current BusinessObject or Resource in an ordered sequence"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isOperatedBy> a rdf:Property ;
