<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#eventDuration> a rdf:Property ;
    rdfs:label "Duration"^^xsd:string ;
    rdfs:comment "The duration of an event."^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Event> ;
