    rdfs:comment "The start date of an Event."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Event> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#fictitious> a rdf:Property ;
    rdfs:label "Fictitious agent indicator"@en ;
    rdfs:comment "A flag to indicate if an agent of fictitious\\n            (set to true)."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range xsd:boolean .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#fileSize> a rdf:Property ;
    rdfs:label "File size"@en ;
    rdfs:comment "Provides the size of a MediaResource in bytes."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:double .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#filename> a rdf:Property ;
    rdfs:label "File name"@en ;
    rdfs:comment "The name of the file containing the\\n            Resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#folksonomy> a rdf:Property ;
    rdfs:label "Folksonomy"@en ;
    rdfs:comment "Provides a user/audience-generated description, tag, or label for resource content."@en .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#followsInSequence> a rdf:Property ;
    rdfs:label "Previous"^^xsd:string ;
    rdfs:comment "A link to a an BusinessObject or a Resource preceding the current BusinessObject or Resource in an ordered sequence"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#frameRate> a rdf:Property ;
    rdfs:label "Frame rate"@en ;
    rdfs:comment "The frame rate of the video signal in frame per second."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoTrack> ;
    rdfs:range xsd:double ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#frameRate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#frameSizeUnit> a rdf:Property ;
    rdfs:label "Frame size unit"@en ;
    rdfs:comment "The unit used to express the frame width or\\n            height. The unit by default is 'pixel'."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#VideoTrack> ;
    rdfs:range xsd:string ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#frameSizeUnit> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#framesPerSecond> a rdf:Property ;
    rdfs:label "Frames per second"@en ;
    rdfs:comment "Identifies the frames per second at which a visual resource should be played back for human consumption."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#playbackSpeed> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#frameRate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#groupDescription> a rdf:Property ;
    rdfs:label "Group description"@en ;
    rdfs:comment "A textual description of a\\n            Group."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Group> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#groupName> a rdf:Property ;
    rdfs:label "Group name"@en ;
    rdfs:comment "The name attributed to a Group."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Group> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAffiliation> a rdf:Property ;
    rdfs:label "Affiliation"@en ;
    rdfs:comment "A property to establish the relation between a\\n            Contact/person and an Organisation."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Organisation> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAncillaryData> a rdf:Property ;
    rdfs:label "Ancillary data"@en ;
    rdfs:comment "A property to signal the presence of\\n            AncillaryData associated with the EditorialObject and / or MediaResource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AncillaryData> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAncillaryDataFormat> a rdf:Property ;
    rdfs:label "Ancillary data format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasDataFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAnnotation> a rdf:Property ;
    rdfs:label "Annotation"@en ;
    rdfs:comment "A property to signal the presence of Annotation\\n            information associated with an EditorialObject and / or a MediaResource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAnnotationSource> a rdf:Property ;
    rdfs:label "Annotation Source"@en ;
    rdfs:comment "To identify the Agent, Contact/person or\\n            Organisation who has provided the Annotation."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Annotation> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAudioDescription> a rdf:Property ;
    rdfs:label "Audio description"@en ;
    rdfs:comment "To signal the presence of\\n            AudioDescription."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAudioEncodingFormat> a rdf:Property ;
    rdfs:label "Audio encoding format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasEncodingFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasAudioFormat> a rdf:Property ;
    rdfs:label "Audio format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCaptioning> a rdf:Property ;
    rdfs:label "Captioning"@en ;
    rdfs:comment "To signal the presence of\\n            Captioning."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCaptioningFormat> a rdf:Property ;
    rdfs:label "Captioning format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasDataFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCastMember> a rdf:Property ;
    rdfs:label "Cast member"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    skos:prefLabel "Cast member"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCharacter> a rdf:Property ;
    rdfs:label "Character"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    skos:prefLabel "Character"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCodec> a rdf:Property ;
    rdfs:label "Encoder"^^xsd:string ;
    rdfs:comment "To identify the Codec with which the Resource has been encoded."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasCompression> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasColourSpace> a rdf:Property ;
    rdfs:label "Colour space"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasContact> a rdf:Property ;
    rdfs:label "Contact"@en ;
    rdfs:comment "To provide information on a Contact for an\\n            Organisation or a physical person (e.g. the agent of an actor)."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasContainerFormat> a rdf:Property ;
    rdfs:label "Container format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasContainerMimeType> a rdf:Property ;
    rdfs:label "Mime type"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasContributor> a rdf:Property ;
    rdfs:label "Contributor"@en ;
    rdfs:comment "To provide information on Contacts/persons or\\n            Organisations who have contributed to the BusinessObject or Resource."@en ;
    rdfs:subPropertyOf dc:contributor ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasContributor> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCoverage> a rdf:Property ;
    rdfs:label "Coverage"@en ;
    rdfs:comment "A property to identify the Events and or\\n            Locations, all real or fictional, covered by the \\n            BusinessObject."@en ;
    rdfs:subPropertyOf dc:coverage ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasRelatedLocation> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCreationLocation> a rdf:Property ;
    rdfs:label "Creation location"@en ;
    rdfs:comment "The Location where content has been created."@en ;
    rdfs:subPropertyOf dc:coverage .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCreator> a rdf:Property ;
    rdfs:label "Creator"@en ;
    rdfs:comment "To identify an Agent involved in the creation of the Resource or BusinessObject."@en ;
    rdfs:subPropertyOf dc:creator ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasCreator> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasCrewMember> a rdf:Property ;
    rdfs:label "Crew member"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    skos:prefLabel "Crew member"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasDepartment> a rdf:Property ;
    rdfs:label "Department"@en ;
    rdfs:comment "To identify Departments within an\\n            Organisation."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Organisation> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasDocumentFormat> a rdf:Property ;
    rdfs:label "has document format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasDopesheet> a rdf:Property ;
    rdfs:label "Dopesheet"@en ;
    rdfs:comment "To associate a Dopesheet with a NewsItem."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#NewsItem> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasEvent> a rdf:Property ;
    rdfs:label "Event"@en ;
    rdfs:comment "To associate an Event with a\\n            Location."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Location> ;
    rdfs:subPropertyOf dc:coverage .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFileFormat> a rdf:Property ;
    rdfs:label "File format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasGeneration> a rdf:Property ;
    rdfs:label "Generation"@en ;
    rdfs:comment "Identifies the generation of a version of a resource, i.e. master, edit master, distribution copy, etc."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasGenre> a rdf:Property ;
    rdfs:label "Genre"@en ;
    rdfs:comment "To define a Genre/category associated to the\\n            BusinesssObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasType> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasGenre> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasHomepage> a rdf:Property ;
    rdfs:label "Homepage"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedResource> ;
    skos:prefLabel "Homepage"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasIdPicture> a rdf:Property ;
    rdfs:label "Id picture"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Contact> ;
    skos:prefLabel "Id picture"^^xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasImageFormat> a rdf:Property ;
    rdfs:label "Image format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasKeyCareerEvent> a rdf:Property ;
    rdfs:label "Career event"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#KeyCareerEvent> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedEvent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasKeyPersonalEvent> a rdf:Property ;
    rdfs:label "Personal event"^^xsd:string ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#KeyPersonalEvent> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedEvent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasLocation> a rdf:Property ;
    rdfs:label "Location"@en ;
    rdfs:comment "To associate a Location with a BusinessObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Event> ;
    rdfs:subPropertyOf dc:coverage .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasLogo> a rdf:Property ;
    rdfs:label "Logo"@en ;
    rdfs:comment "Logos can be used in a variety of contexts.\\n            Logo can be associated with an Organisation or a Service or a PublicationChannel."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationChannel> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Service> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Organisation> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMedium> a rdf:Property ;
    rdfs:label "Medium"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMetadataAttributor> a rdf:Property ;
    rdfs:label "Metadata attributor"@en ;
    rdfs:comment "To identify the Agent (Contact/person or\\n            Organisation) who has created the metadata."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Subject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMimeType> a rdf:Property ;
    rdfs:label "Mime type"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasObjectType> a rdf:Property ;
    rdfs:label "Object/asset type"^^xsd:string ;
    rdfs:comment "To define an ObjectType for the BusinessObject\\n             (e.g. book, report, programme, clip) if not defined as a subClass of BusinessObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasType> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasOriginalLanguage> a rdf:Property ;
    rdfs:label "Original language"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasLanguage> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasPart> a rdf:Property ;
    rdfs:label "Part"@en ;
    rdfs:comment "To define Parts (segments, fragments, etc.)\\n            within a BusinessObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasPictogram> a rdf:Property ;
    rdfs:label "Pictogram"@en ;
    rdfs:comment "To provide a visual representation of  TargetAudience or Rating."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#audienceLevel> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasPublicationChannel> a rdf:Property ;
    rdfs:label "Publication channel"@en ;
    rdfs:comment "To associate a PublicationEvent with a\\n            PublicationChannel."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationChannel> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasPublicationEvent> a rdf:Property ;
    rdfs:label "Publication event"@en ;
    rdfs:comment "To associate PublicationEvents with\\n            PublicationChannels or as elements of a PublicationHistory or PublicationPlanning."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationChannel> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationHistory> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationPlanning> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasPublicationHistory> a rdf:Property ;
    rdfs:label "has publication history"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationHistory> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasPublisher> a rdf:Property ;
    rdfs:label "Publisher"@en ;
    rdfs:comment "To identify an Agent involved in the publication of the Resource or BusinessObject."@en ;
    rdfs:subPropertyOf dc:publisher ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasPublisher> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRating> a rdf:Property ;
    rdfs:label "Rating"@en ;
    rdfs:comment "To identify the presence of Rating attributed\\n            to a Resource or BusinessObject."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasRating> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRatingSource> a rdf:Property ;
    rdfs:label "Rating provider"@en ;
    rdfs:comment "To identify an Agent (Contact/person or\\n            Organisation) who has proposed a Rating."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rating> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedAudioChannel> a rdf:Property ;
    rdfs:label "Audio channel"@en ;
    rdfs:comment "To associate an AudioChannel with an AudioPack or an AudioStream."@en ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioChannel> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedResource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedAudioContent> a rdf:Property ;
    rdfs:label "Audio content"@en ;
    rdfs:comment "To identify the AudioContent associated with an AudioProgramme."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioProgramme> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioContent> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedAudioObject> a rdf:Property ;
    rdfs:label "Audio object"@en ;
    rdfs:comment "To identify AudioObjects associated with AudioContent or other AudioObjects."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedAudioStream> a rdf:Property ;
    rdfs:label "Audio stream"@en ;
    rdfs:comment "To associate an AudioStream with an AudioTrack."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioTrack> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioStream> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedResource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedAudioTrack> a rdf:Property ;
    rdfs:label "Audio track"@en ;
    rdfs:comment "To associate an AudioTrack with an AudioStream or an AudioTrackUID."@en ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#AudioTrack> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedResource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedImage> a rdf:Property ;
    rdfs:label "Image"@en ;
    rdfs:comment "To associate an Image with a BusinessObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Image> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedLocation> a rdf:Property ;
    rdfs:label "has related event"^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Location> ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedMediaFragment> a rdf:Property ;
    rdfs:label "Media fragment"@en ;
    rdfs:comment "To associate a Part of an EditorialObject with a MediaFragment within the association MediaResource instantiating the EditorialObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Part> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaFragment> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMediaFragment> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedPicture> a rdf:Property ;
    rdfs:label "Picture"@en ;
    rdfs:comment "To associate a Picture with a BusinessObject or a Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Picture> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedResource> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasRelatedImage> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedPublicationEvent> a rdf:Property ;
    rdfs:label "Publication event"@en ;
    rdfs:comment "To identify the PublicationEvent associated with a MediaResource (manifestation of an EditorialObject)."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#PublicationEvent> ;
    rdfs:subPropertyOf dc:relation .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRightsContact> a rdf:Property ;
    rdfs:label "Contact"@en ;
    rdfs:comment "To identify a Contact/person who can provide\\n            assistance / guidance regarding the associated Rights."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRightsHolder> a rdf:Property ;
    rdfs:label "Rights holder"@en ;
    rdfs:comment "To identify an Agent (Contact/person or\\n            Organisation) having/managing Rights."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Rights> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRole> a rdf:Property ;
    rdfs:label "Role"@en ;
    rdfs:comment "To define the role of an Agent (Contact/person\\n            or Organisation). The association in a particular context is made by declaring the hasCastRole  associated with the BusinessObject."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasSigning> a rdf:Property ;
    rdfs:label "Accessibility - signing"@en ;
    rdfs:comment "To identify the presence of Signing associated\\n            to the BusinessObject/Resource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ) ] ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasSigning> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasSigningFormat> a rdf:Property ;
    rdfs:label "Signing format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasVideoFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasSource> a rdf:Property ;
    rdfs:label "Source"@en ;
    rdfs:comment "To identify a Resource as the source of another Resource."@en ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:subPropertyOf dc:source ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasSource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasStaff> a rdf:Property ;
    rdfs:label "Staff"@en ;
    rdfs:comment "To identify staff working within an Organisation."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Organisation> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasStandard> a rdf:Property ;
    rdfs:label "Standard"@en ;
    rdfs:comment "Identifies the technical video standard of a resource, i.e. NTSC or PAL."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasStorageType> a rdf:Property ;
    rdfs:label "Storage type"^^xsd:string ;
    rdfs:comment "To define a particular type of storage /\\n            repository associated with the Locator from where a Resource can be\\n            accessed."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasSubtitling> a rdf:Property ;
    rdfs:label "Subtitling"@en ;
    rdfs:comment "To signal the presence of Subtitling associated\\n            with the EditorialObject or MediaResource."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#EditorialObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ) ] ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasSubtitling> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasSubtitlingFormat> a rdf:Property ;
    rdfs:label "Subtitling format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasDataFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasTargetAudience> a rdf:Property ;
    rdfs:label "Target audience"^^xsd:string ;
    rdfs:comment "To associate a TargetAudience (e.g. for\\n            parental guiddance or targeting a particular social group) with a\\n            BusinessObject/Resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasType> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasTargetAudience> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasTheme> a rdf:Property ;
    rdfs:label "Theme"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasKeyword> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasTopic> a rdf:Property ;
    rdfs:label "Topic"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasSubject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasTrack> a rdf:Property ;
    rdfs:label "Track"@en ;
    rdfs:comment "To associate audio/data/video tracks with a MediaResource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#MediaResource> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Track> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedResource> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasTrack> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasVideoEncodingFormat> a rdf:Property ;
    rdfs:label "Video encoding format"^^xsd:string ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasEncodingFormat> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hashValue> a rdf:Property ;
    rdfs:label "Hash code"@en ;
    rdfs:comment "The hash value associated to a Resource. There\\n            are different methods / algorithms to calculate hash values, which can be defined as\\n            subproperties."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#height> a rdf:Property ;
    rdfs:label "Height"@en ;
    rdfs:comment "The height of e.g. a video frame typically\\n            expressed as a number of lines or the height of a picture/image expressed in millimeters\\n            or else."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:integer ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#frameHeight> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#heightUnit> a rdf:Property ;
    rdfs:label "Height unit"@en ;
    rdfs:comment "The unit used to measure a Height e.g. in\\n            pixels or number of lines or millimeters or else."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:string .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#highPass> a rdf:Property ;
    rdfs:label "High pass frequency"@en ;
    rdfs:comment "The high pass frequency of the AudioChannel filter."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#frequency> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#highlights> a rdf:Property ;
    rdfs:label "Highlights"@en ;
    rdfs:comment "To provide highlights."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#description> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#holdsRightsOver> a rdf:Property ;
    rdfs:label "Asset, resource, object"@en ;
    rdfs:comment "To identify a BusinessObject or Resource on\\n            which an Agent (Contact/person or Organisation) holds Rights."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Agent> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Asset> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ) ] .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#identifier> a rdf:Property ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "Corresponds to 'identifier'\\n            in the W3C Ontology for Media Annotation. The URI may be used to express an alternative\\n            identifier of the resource, or to share an identifier used by other instances of the\\n            same resource (equivalent to the fucntionality owl:sameAs)."@en,
        "This property is intended to provide an\\n            alternative identifier for the resource, which has no URI counterpart. In the case where\\n            the alternative identifier can be expressed as a URI, it is recommended to use\\n            owl:sameAs instead."@en ;
    rdfs:subPropertyOf dc:identifier .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#inchesPerSecond> a rdf:Property ;
    rdfs:label "Inches per second"@en ;
    rdfs:comment "Identifies the inches per second at which an analog audio tape should be played back for human consumption."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#playbackSpeed> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#frameRate> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#instantiates> a rdf:Property ;
    rdfs:label "Business object"@en ;
    rdfs:comment "To link a particular manifestation of a\\n            BusinessObject to the corresponding Resource."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> ;
    rdfs:range <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#BusinessObject> ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRelatedBusinessObject> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isAgent> a rdf:Property ;
    rdfs:label "Agent"@en ;
    rdfs:comment "To identify a Contact/person or Organisation as part of a cast list."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Cast> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isCharacter> a rdf:Property ;
    rdfs:label "Character"@en ;
    rdfs:comment "To identify the character personified by a Cast individual."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Cast> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isCopyrightedBy> a rdf:Property ;
    rdfs:label "Copyright"@en ;
