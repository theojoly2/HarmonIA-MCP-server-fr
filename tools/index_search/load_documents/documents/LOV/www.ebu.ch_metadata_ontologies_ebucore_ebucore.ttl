    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRights> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#isCopyrightedBy> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isCoveredBy> a rdf:Property ;
    rdfs:label "Rights"@en ;
    rdfs:comment "The Rights or policy applicable to the\\n            BusinessObject, Asset, Resource or PublicationEvent."@en ;
    rdfs:subPropertyOf <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasRights> ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#hasPermissions>,
        <http://www.w3.org/ns/ma-ont#hasPolicy> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isFictitiousContact> a rdf:Property ;
