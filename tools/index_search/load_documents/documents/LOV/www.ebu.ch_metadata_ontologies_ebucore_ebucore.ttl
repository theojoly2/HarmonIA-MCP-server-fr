    rdfs:subPropertyOf dc:relation ;
    owl:equivalentProperty <http://www.w3.org/ns/ma-ont#isRelatedTo> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isReplacedBy> a rdf:Property ;
