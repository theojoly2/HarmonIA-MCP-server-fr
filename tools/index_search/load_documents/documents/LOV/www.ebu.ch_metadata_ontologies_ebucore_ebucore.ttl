<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#encodingLevel> a rdf:Property ;
    rdfs:label "Encoding level"@en ;
    rdfs:comment "The encoding level."@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#encodingProfile> a rdf:Property ;
    rdfs:label "Encoding profile"@en ;
    rdfs:comment "The encoding profile"@en ;
    rdfs:domain <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#Resource> .

<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#endLicenceDate> a rdf:Property ;
