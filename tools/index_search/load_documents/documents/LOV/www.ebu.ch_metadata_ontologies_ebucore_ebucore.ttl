<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#isReferencedBy> a rdf:Property ;
    rdfs:label "Related object, resource"@en ;
    rdfs:comment "To express references across Assets, BusinessObjects or Resources."@en ;
    rdfs:domain [ a owl:Class ;
