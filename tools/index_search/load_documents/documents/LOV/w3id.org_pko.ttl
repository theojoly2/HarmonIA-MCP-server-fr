        foaf:Person ;
    foaf:name "Irene Celino"@en .

<https://orcid.org/0000-0002-8235-7331> a owl:NamedIndividual,
        foaf:Person ;
    foaf:name "Mario Scrocca"@en .

<https://orcid.org/0000-0002-9066-1229> a owl:NamedIndividual,
        foaf:Person ;
    foaf:name "Antonia Azzini"@en .

<https://orcid.org/0000-0003-1427-3723> a owl:NamedIndividual,
        foaf:Person ;
    foaf:name "Valentina Anita Carriero"@en .

<https://ror.org/046bfkz44> a owl:NamedIndividual,
        foaf:Organization ;
    foaf:name "Cefriel"@en .

<https://w3id.org/pko#Action> a owl:Class ;
    rdfs:label "Action" ;
    rdfs:comment "This class represents an Action performed by a human Agent."@en ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents an action that needs to be performed by a human Agent (a Person) for executing a Step of a Procedure."@en .

<https://w3id.org/pko#ExpertiseLevel> a owl:Class ;
    rdfs:label "Expertise Level" ;
    rdfs:comment "This class represents the Expertise Level of an Agent with respect to certain activities/responsibilities."@en ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents the expertise level linked to a Step, or MultiStep, of a Procedure, meaning that the Step, or MultiStep, is targeted at persons with a certain level of expertise (e.g., junior, senior)."@en .

<https://w3id.org/pko#FAQCategory> a owl:Class ;
    rdfs:label "F A Q Category" ;
    rdfs:comment "This class represents the Category of a Frequently Asked Question (FAQ)."@en .

<https://w3id.org/pko#FAQTarget> a owl:Class ;
    rdfs:label "F A Q Target" ;
    rdfs:comment "This class represents the Target of a Frequently Asked Question (FAQ)."@en .

<https://w3id.org/pko#Function> a owl:Class ;
    rdfs:label "Function" ;
    rdfs:comment "This class represents a Function performed by a Software Agent."@en ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents a function that needs to be performed by a Software Agent for executing a Step of a Procedure."@en .

<https://w3id.org/pko#ProcedureType> a owl:Class ;
    rdfs:label "Procedure Type" ;
    rdfs:comment "This class represents the Type of a Procedure."@en ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), an example of Procedure Type is LOTO Procedure."@en .

<https://w3id.org/pko#hasStep> a owl:ObjectProperty ;
    rdfs:label "has step" ;
    rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure or a MultiStep to its Steps."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/net/p-plan#MultiStep> <https://w3id.org/pko#Procedure> ) ] ;
    rdfs:range <http://purl.org/net/p-plan#Step> ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure or a MultiStep to its Steps."@en .

<https://w3id.org/pko#isCurrentVersionOf> a owl:ObjectProperty ;
    rdfs:label "is current version of" ;
    rdfs:domain <https://w3id.org/pko#Procedure> ;
    rdfs:range <https://w3id.org/pko#Procedure> .

<https://w3id.org/pko#isStepVerificationOf> a owl:ObjectProperty ;
    rdfs:label "is step verification of" ;
    rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Verification, that is the way in which the execution of the step can be verified, to the Step it verifies."@en ;
    rdfs:domain <https://w3id.org/pko#StepVerification> ;
    rdfs:range <http://purl.org/net/p-plan#Step> ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Verification, that is the way in which the execution of the step can be verified, to the Step it verifies."@en .

<https://w3id.org/pko#nextVersion> a owl:ObjectProperty ;
    rdfs:label "next version" ;
    rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a version of a Procedure to its direct next version of the same Procedure."@en ;
    rdfs:domain <https://w3id.org/pko#Procedure> ;
    rdfs:range <https://w3id.org/pko#Procedure> ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a version of a Procedure to its direct next version of the same Procedure."@en .

<https://w3id.org/pko#previousStep> a owl:ObjectProperty ;
    rdfs:label "previous step" ;
    rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to its direct previous Step."@en ;
    rdfs:domain <http://purl.org/net/p-plan#Step> ;
    rdfs:range <http://purl.org/net/p-plan#Step> ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to its direct previous Step."@en .

<https://w3id.org/pko#previousStepExecution> a owl:ObjectProperty ;
    rdfs:label "previous step execution" ;
    rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to its direct previous Step Execution."@en ;
    rdfs:domain <https://w3id.org/pko#StepExecution> ;
    rdfs:range <https://w3id.org/pko#StepExecution> ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to its direct previous Step Execution."@en .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:label "was associated with" ;
    dcam:domainIncludes prov:Activity ;
    dcam:rangeIncludes prov:Agent ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Activity (either a Procedure Execution or a Step Execution) to an Agent that had some role/responsibility in that Activity."@en .

<https://w3id.org/pko#ProcedureExecution> a owl:Class ;
    rdfs:label "Procedure Execution" ;
    rdfs:comment "A Procedure Execution is an Activity representing the execution of a certain Procedure, performed by one or more Agents, during a time interval."@en ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/pko#StepVerification> a owl:Class ;
    rdfs:label "Step Verification" ;
    rdfs:comment "A Step Verification is a description of the way in which the execution of a Step can be verified."@en ;
    rdfs:subClassOf <http://purl.org/net/p-plan#Step> .

dcterms:PeriodOfTime a owl:Class ;
    rdfs:label "Period Of Time" .

<http://purl.org/net/p-plan#MultiStep> a owl:Class ;
    rdfs:label "Multi Step" .

<http://purl.org/net/p-plan#Variable> a owl:Class ;
    rdfs:label "Variable" .

owl:Thing a owl:Class ;
    rdfs:label "Thing" .

time:Duration a owl:Class ;
    rdfs:label "Duration" .

prov:Entity a owl:Class ;
    rdfs:label "Entity" .

<http://purl.org/spar/pro/RoleInTime> a owl:Class ;
    rdfs:label "Role In Time" .

prov:InstantaneousEvent a owl:Class ;
    rdfs:label "Instantaneous Event" .

<https://w3id.org/pko#Error> a owl:Class ;
    rdfs:label "Error" ;
    rdfs:comment "This class represents an Error that can be encountered while executing an activity."@en ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents an error that an Agent can encounter during a Procedure or Step Execution. An Error can be associated with a description, an error code, and an error cause. The Procedure may contain a (fallback) step to address such error."@en .

<https://w3id.org/pko#FrequentlyAskedQuestion> a owl:Class ;
    rdfs:label "Frequently Asked Question" ;
    rdfs:comment "A Frequently Asked Question (FAQ) is a Resource representing a question that people often ask about a particular resource, and the answer to the question."@en ;
    rdfs:subClassOf dcat:Resource ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents a Frequently Asked Question (FAQ) of a Procedure, and is described with an identifier, a question, an answer, and is linked to a FAQ Category and a FAQ Target."@en .

<https://w3id.org/pko#ProcedureExecutionStatus> a owl:Class ;
    rdfs:label "Procedure Execution Status" ;
    rdfs:comment "This class represents the Status of the Procedure Execution (e.g., in progress, completed, paused, cancelled)."@en ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), a Procedure Execution is linked to its Procedure Execution Status with the property adms:status."@en .

<https://w3id.org/pko#UserFeedbackOccurrence> a owl:Class ;
    rdfs:label "User Feedback Occurrence" ;
    rdfs:comment "This class represents the occurrence of a feedback that was provided by a user during an activity."@en ;
    rdfs:subClassOf prov:InstantaneousEvent ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents the occurrence of a feedback provided by an Agent during the Procedure or Step Execution. The User Feedback Occurrence is associated with the feedback, that is about either the Procedure or the Procedure Execution, and is linked to the Agent providing the feedback."@en .

<https://w3id.org/pko#UserQuestionOccurrence> a owl:Class ;
    rdfs:label "User Question Occurrence" ;
    rdfs:comment "This class represents the occurrence of a question that an Agent came up with during the Procedure or Step Execution."@en ;
    rdfs:subClassOf prov:InstantaneousEvent ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents the occurrence of a question that an Agent came up with during the Procedure or Step Execution. The User Question Occurrence is associated with the question, and is linked to the Agent asking the question. Also, it can be linked to a Resource addressing the question."@en .

foaf:Person a owl:Class .

<https://w3id.org/pko#ProcedureStatus> a owl:Class ;
    rdfs:label "Procedure Status" ;
    rdfs:comment "This class represents the Status of the Procedure (e.g.,draft, validated)."@en ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), a Procedure  is linked to its Procedure Status with the property adms:status."@en .

<https://w3id.org/pko#IssueOccurrence> a owl:Class ;
    rdfs:label "Issue Occurrence" ;
    rdfs:comment "This class represents the occurrence of an issue during an Activity."@en ;
    rdfs:subClassOf prov:InstantaneousEvent ;
    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents the occurrence of an issue during the Procedure or Step Execution. The Issue Occurrence is associated with the cause as identified and defined by the Agent, the solution as identified and applied by the Agent, and is linked to the Agent that encountered the issue."@en .

<https://w3id.org/pko#StepExecution> a owl:Class ;
    rdfs:label "Step Execution" ;
    rdfs:comment "A Procedure Execution is an Activity representing the execution of a certain Step of a Procedure, performed by one or more Agents, during a time interval."@en ;
    rdfs:subClassOf prov:Activity .

prov:Agent a owl:Class ;
    rdfs:label "Agent" .

prov:Activity a owl:Class ;
    rdfs:label "Activity" .

dcat:Resource a owl:Class ;
    rdfs:label "Resource" .

<https://w3id.org/pko#Procedure> a owl:Class ;
    rdfs:label "Procedure" ;
    rdfs:comment "A Procedure represents a sequence of actions to be executed in order to achieve a desired outcome."@en ;
    rdfs:subClassOf <http://purl.org/net/p-plan#Plan>,
        dcat:Resource .

<http://purl.org/net/p-plan#Step> a owl:Class ;
    rdfs:label "Step" .

