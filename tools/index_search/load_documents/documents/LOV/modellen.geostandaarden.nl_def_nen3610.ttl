<http://modellen.geostandaarden.nl/def/nen3610#RegistratieveRuimte> a owl:Class ;
    rdfs:label "RegistratieveRuimte" ;
    ns1:alias "Registratieve ruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Registratieve ruimte omvat objecten die onder de wet- of regelgeving vallen of die voor bedrijfsvoering administratief van belang zijn. In veel gevallen zal een dergelijk gebied ook een registratieve aanduiding of registratief nummer hebben. Voorbeelden zijn: gemeente Delft, postcodegebied 2345, politieregio Haaglanden, veiligheidsregio Gelderland-Midden, Nationaal Park De Hoge Veluwe, kadastraal perceel." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/registratieve_ruimte> ;
    rdfs:comment "Op basis van wet- of regelgeving afgebakende ruimte die als eenheid geldt van politiek-bestuurlijke verantwoordelijkheid of voor bedrijfsvoering." ;
    rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel> ;
    rdfs:subClassOf <http://modellen.geostandaarden.nl/def/nen3610#VirtueleRuimte> ;
    skos:notation "RegistratieveRuimte" .

<http://modellen.geostandaarden.nl/def/nen3610#Scheepvaartruimte> a owl:Class ;
    rdfs:label "Scheepvaartruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Scheepvaartruimte wordt gebruikt door allerlei soorten schepen." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/scheepvaartruimte> ;
    rdfs:comment "Verkeerruimte voor voertuigen die zich over water verplaatsen." ;
    rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel> ;
    rdfs:subClassOf <http://modellen.geostandaarden.nl/def/nen3610#Verkeerruimte> ;
    skos:notation "Scheepvaartruimte" .

<http://modellen.geostandaarden.nl/def/nen3610#Spoorverkeerruimte> a owl:Class ;
    rdfs:label "Spoorverkeerruimte" ;
    ns1:alias "Spoorverkeerruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Spoorverkeerruimte wordt gebruikt door bijvoorbeeld treinen, trams en metro's." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/spoorverkeerruimte> ;
    rdfs:comment "Verkeerruimte voor voertuigen die zich over rails verplaatsen." ;
    rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel> ;
    rdfs:subClassOf <http://modellen.geostandaarden.nl/def/nen3610#Verkeerruimte> ;
    skos:notation "Spoorverkeerruimte" .

<http://modellen.geostandaarden.nl/def/nen3610#Verharding> a owl:Class ;
    rdfs:label "Verharding" ;
    ns1:alias "Verharding" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Een verharding is fysiek begrensd aanwezig. Het type gebruik van de verharding kan meervoudig zijn en hoeft niet de fysieke begrenzing te volgen." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/verharding> ;
    rdfs:comment "Een door egaliseren, verstevigen en/of verruwen voor het beoogde gebruik geschikt gemaakt oppervlak, bestaande uit in een of meer lagen over een bodem of onderliggende constructie aangelegd materiaal." ;
    rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel> ;
    rdfs:subClassOf <http://modellen.geostandaarden.nl/def/nen3610#Constructie> ;
    skos:notation "Verharding" .

<http://modellen.geostandaarden.nl/def/nen3610#VoidReasonValue> a owl:Class ;
    rdfs:label "VoidReasonValue" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject false ;
    ns1:toelichting "Deze codelijst moet extern worden gepubliceerd." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/mogelijk_geen_waarde> ;
    rdfs:comment "Reden waarom een 'nil'-waarde is ingevuld." ;
    rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/Waardelijsten> ;
    rdfs:subClassOf skos:Concept ;
    skos:notation "VoidReasonValue" .

<http://modellen.geostandaarden.nl/def/nen3610#Waterverplaatsingsruimte> a owl:Class ;
    rdfs:label "Waterverplaatsingsruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Een waterverplaatsingsruimte realiseert het hydrologisch aspect van water en met name de oppervlaktewaterhydrologie. Het benoemt de ruimte die wordt gebruikt voor o.a. afwatering, watertoevoer en drainage." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/waterverplaatsingsruimte> ;
    rdfs:comment "Transportruimte waardoor water zich verplaatst." ;
    rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel> ;
    rdfs:subClassOf <http://modellen.geostandaarden.nl/def/nen3610#Transportruimte> ;
    skos:notation "Waterverplaatsingsruimte" .

