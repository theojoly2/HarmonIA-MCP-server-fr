    rdfs:label "Wegverkeerruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Wegverkeerruimten worden gebruikt door bijvoorbeeld voetgangers, fietsers en autoverkeer." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/wegverkeerruimte> ;
    rdfs:comment "Verkeerruimte voor weggebruikers die zich over wegen verplaatsen." ;
    rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel> ;
    rdfs:subClassOf <http://modellen.geostandaarden.nl/def/nen3610#Verkeerruimte> ;
    skos:notation "Wegverkeerruimte" .

