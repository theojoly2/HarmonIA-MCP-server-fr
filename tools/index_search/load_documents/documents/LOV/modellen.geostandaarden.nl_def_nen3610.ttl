@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://bp4mc2.org/def/mim#> .
@prefix onto: <http://modellen.geostandaarden.nl/def/nen3610> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    owl:imports <http://modellen.geostandaarden.nl/def/nen3610/Basisinformatie-elementen>,
        <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>,
        <http://modellen.geostandaarden.nl/def/nen3610/Waardelijsten> ;
    sh:declare [ sh:namespace "http://modellen.geostandaarden.nl/def/nen3610#" ;
            sh:prefix "nen3610" ] .

<http://modellen.geostandaarden.nl/nen3610/id/shape/Begroeiing> a sh:NodeShape ;
    rdfs:label "Begroeiing" ;
    ns1:alias "Begroeiing" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Begroeiing kan dus spontaan of natuurlijk zijn (vegetatie), maar ook door menselijk toedoen tot stand zijn gekomen (aanplant of beplanting) of combinaties daarvan." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/begroeiing> ;
    rdfs:comment "Planten die op natuurlijke wijze zijn ontstaan of door mensen zijn aangeplant." ;
    skos:notation "Begroeiing" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#Begroeiing> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/Bodem> a sh:NodeShape ;
    rdfs:label "Bodem" ;
    ns1:alias "Bodem" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Bodem verwijst naar een typering en/of benoeming van het aardoppervlak, waarbij de bodem doorloopt onder het oppervlaktewater.  Bodem omvat ook de daaronder liggende bodemmaterialen met indelingen die kunnen verschillen per vakgebied zoals bijvoorbeeld bodemkunde, geologie, geohydrologie en geomorfologie." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/bodem> ;
    rdfs:comment "Bovenste deel van de aarde, exclusief oppervlaktewater." ;
    skos:notation "Bodem" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#Bodem> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/Constructie> a sh:NodeShape ;
    rdfs:label "Constructie" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Constructie kan boven- en ondergrondse objecten betreffen. Voorbeelden zijn: huis, brug, asfalt, waterleiding, fabriek, mijnstelsel." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/constructie> ;
    rdfs:comment "Gebouwd object dat direct of indirect met de bodem is verbonden en bedoeld is om ter plaatse te functioneren." ;
    skos:notation "Constructie" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#Constructie> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/FunctioneleRuimte> a sh:NodeShape ;
    rdfs:label "FunctioneleRuimte" ;
    ns1:alias "Functionele ruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Een functionele ruimte wordt gebruikt om een (gebruiks)functie aan een ruimte toe te kennen. Het functionele gebruik van de ruimte volgt niet altijd de fysieke begrenzing van re�le objecten." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/functionele_ruimte> ;
    rdfs:comment "Ruimte met een specifieke functie." ;
    skos:notation "FunctioneleRuimte" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#FunctioneleRuimte> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/Gebouw> a sh:NodeShape ;
    rdfs:label "Gebouw" ;
    ns1:alias "Gebouw" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Voorbeelden zijn: huis, schuur, flatgebouw, huizenblok, fabriek." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/gebouw> ;
    rdfs:comment "Overdekte en geheel of gedeeltelijk met wanden omsloten constructie bedoeld voor het in een afgeschermde omgeving onderbrengen van mensen, dieren of voorwerpen of voor de productie van goederen." ;
    skos:notation "Gebouw" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#Gebouw> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/GeoObject> a sh:NodeShape ;
    rdfs:label "GeoObject" ;
    ns1:alias "Geo-object" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Van dit objecttype worden geen directe instanties gemaakt. Indien een object een geo-object is, is het altijd een instantie van een subklasse van GeoObject. Alle subklassen van GeoObject hebben conform MIM het stereotype �Objecttype�. Voor publicatie conform NEN-EN-ISO 19109:2015 is het stereotype �FeatureType� verplicht. Binnen de context van NEN 3610 is �Objecttype� het equivalent van �FeatureType�." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/geo-object> ;
    rdfs:comment "Een fenomeen in de werkelijkheid dat direct of indirect is geassocieerd met een locatie relatief ten opzichte van de aarde." ;
    skos:notation "GeoObject" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#GeoObject> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/GeografischeRuimte> a sh:NodeShape ;
    rdfs:label "GeografischeRuimte" ;
    ns1:alias "Geografische ruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "De grenzen zijn niet altijd exact vastgesteld. Voorbeelden zijn: Noordoostpolder, Midden-Nederland, rivierengebied, Veluwe, Zuid-Limburg, kustgebied. " ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/geografische_ruimte> ;
    rdfs:comment "Ruimte die bekendstaat onder een vanuit de historie of het gebruik bekende benaming of een fysisch-geografische samenhang, al dan niet met zijn omgeving, kent." ;
    skos:notation "GeografischeRuimte" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#GeografischeRuimte> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/IdentificeerbaarObject> a sh:NodeShape ;
    rdfs:label "IdentificeerbaarObject" ;
    ns1:datumOpname "20221216" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "De klasse wordt als superklasse gebruikt voor alle objecttypen waarvan de instanties identificeerbaar moeten zijn." ;
    rdfs:comment "Klasse opgenomen om identificatie-attributen in te defini�ren." ;
    skos:notation "IdentificeerbaarObject" ;
    sh:property [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:identificerend true ;
            ns1:indicatieFormeleHistorie false ;
            ns1:patroon "Alleen de volgende karakters mogen in een waarde van het attribuut identificatie voorkomen: {'A' ... 'Z', 'a' ... 'z', '0' ... '9', '_', '-', ',', '.', '/', ':'}" ;
            ns1:toelichting "?identificatie' is de identificatiecode die een object heeft binnen een registratie of binnen een ketenproces voor data-uitwisseling. Binnen de registratie of de data-uitwisseling is het object uniek identificeerbaar. In combinatie met het attribuut domein wordt een object hiermee uniek identificeerbaar op het niveau van verschillende registraties, uitwisselprocessen en ook wereldwijd uniek.\\r\\nDe reguliere expressie voor de toegestane tekens is: ([a-z]|[A-Z]|[0-9]|\\\\\\\\_|\\\\\\\\-|\\\\\\\\,|\\\\\\\\.|\\\\\\\\:|\\\\\\\\/)+" ;
            dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/identificatie> ;
            rdfs:comment "Unieke identificatiecode van een informatieobject binnen de context van een registratie.\\r\\nToelichting:  ?identificatie' is de identificatiecode die een object heeft binnen een registratie of binnen een ketenproces voor data-uitwisseling. Binnen de registratie of de data-uitwisseling is het object uniek identificeerbaar. In combinatie met het attribuut domein wordt een object hiermee uniek identificeerbaar op het niveau van verschillende registraties, uitwisselprocessen en ook wereldwijd uniek.\\r\\nDe reguliere expressie voor de toegestane tekens is: ([a-z]|[A-Z]|[0-9]|\\\\\\\\_|\\\\\\\\-|\\\\\\\\,|\\\\\\\\.|\\\\\\\\:|\\\\\\\\/)+" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "identificatie" ;
            sh:nodeKind sh:Literal ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#identificatie> ;
            sh:pattern "([a-z]|[A-Z]|[0-9]|\\\\\\\\_|\\\\\\\\-|\\\\\\\\,|\\\\\\\\.|\\\\\\\\:|\\\\\\\\/)+" ],
        [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:indicatieFormeleHistorie false ;
            ns1:toelichting "De registratiegegevens zijn de versie en tijdlijngegevens die horen bij het registreren van ��n versie van het informatieobject. Ze horen als metadata bij de gegevensset van het informatieobject." ;
            sh:class <http://modellen.geostandaarden.nl/def/nen3610#Registratie> ;
            sh:maxCount 1 ;
            sh:name "registratiegegevens" ;
            sh:nodeKind sh:IRI ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#registratiegegevens> ],
        [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:identificerend true ;
            ns1:indicatieFormeleHistorie false ;
            ns1:patroon "Alleen de volgende karakters mogen in een waarde van het attribuut domein voorkomen: {'A' ... 'Z', 'a' ... 'z', '0' ... '9', '_', '-', ',', '.', '/', ':'}" ;
            ns1:toelichting "Het attribuut domein is een unieke verwijzing naar de registratie- of ketenprocesverantwoordelijke entiteit die de identificatie uitdeelt of regels daartoe heeft opgesteld. In combinatie met het attribuut identificatie wordt een object hiermee uniek identificeerbaar op het niveau van verschillende registraties en ook mondiaal uniek." ;
            dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/domein> ;
            rdfs:comment "Aanduiding van het domein waarbinnen de identificatie uniek is." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "domein" ;
            sh:nodeKind sh:Literal ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#domein> ;
            sh:pattern "([a-z]|[A-Z]|[0-9]|\\\\\\\\_|\\\\\\\\-|\\\\\\\\,|\\\\\\\\.|\\\\\\\\:|\\\\\\\\/)+" ] ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#IdentificeerbaarObject> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/JuridischeRuimte> a sh:NodeShape ;
    rdfs:label "JuridischeRuimte" ;
    ns1:alias "Juridische ruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Juridische ruimte omvat objecten die zijn gekoppeld aan wet- en beleidsinformatie die aangeeft wat waar krachtens wetgeving of wettelijk beleid is geformuleerd. Voorbeelden zijn: benoeming van ruimten en gebieden in bijvoorbeeld omgevingsvisie, omgevingsverordening, waterschapsverordening, projectbesluit." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/juridische_ruimte> ;
    rdfs:comment "Ruimte waar een juridisch instrument beleid of regelgeving toepast." ;
    skos:notation "JuridischeRuimte" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#JuridischeRuimte> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/Kunstwerk> a sh:NodeShape ;
    rdfs:label "Kunstwerk" ;
    ns1:alias "Kunstwerk" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Hieronder vallen overbruggingen, waterstaatkundige werken en waterkerende constructies. Overbruggingen kunnen zijn: brug, viaduct, aquaduct enz. Een voorbeeld van een waterstaatkundig werk is een sluis. Voorbeelden van waterkerende constructies zijn stuw en vaste dam." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/kunstwerk> ;
    rdfs:comment "Civiel-technische constructie voor de infrastructuur van wegen, water, spoorbanen, waterkeringen en/of leidingen." ;
    skos:notation "Kunstwerk" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#Kunstwerk> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/Leiding> a sh:NodeShape ;
    rdfs:label "Leiding" ;
    ns1:alias "Leiding" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Voorbeelden zijn: hoogspanningsleiding, riool, waterleiding, glasvezelkabel, gasleiding." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/leiding> ;
    rdfs:comment "Een geheel van geleiders of een ruimte die voorzien is van ��n ommanteling en bestemd is voor transport van materie, data en/of energie." ;
    skos:notation "Leiding" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#Leiding> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/Luchtvaartruimte> a sh:NodeShape ;
    rdfs:label "Luchtvaartruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Luchtvaartruimte wordt bijvoorbeeld gebruikt door allerlei soorten vliegtuigen en helikopters." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/luchtvaartruimte> ;
    rdfs:comment "Verkeerruimte voor voertuigen die zich door de lucht verplaatsen." ;
    skos:notation "Luchtvaartruimte" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#Luchtvaartruimte> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/Oppervlaktewater> a sh:NodeShape ;
    rdfs:label "Oppervlaktewater" ;
    ns1:alias "Oppervlaktewater" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Grondwater maakt geen deel uit van de superklasse." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/oppervlaktewater> ;
    rdfs:comment "Massa van water dat de bodem bedekt of in normale omstandigheden kan bedekken." ;
    skos:notation "Oppervlaktewater" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#Oppervlaktewater> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/ReeelObject> a sh:NodeShape ;
    rdfs:label "ReeelObject" ;
    ns1:alias "Re�el object" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Een re�el of fysiek object is een tastbaar begrensd object dat gekenmerkt wordt door zijn materiele samenstelling en structuur." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/reeel_object> ;
    rdfs:comment "Geo-object dat zich geheel materieel manifesteert." ;
    skos:notation "ReeelObject" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#ReeelObject> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/Registratie> a sh:NodeShape ;
    rdfs:label "Registratie" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject false ;
    ns1:toelichting "Bij het registreren van een object als informatieobject horen een aantal metadata die hier betrekking op hebben, zoals versie en registratie van tijdlijngegevens." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/objectregistratie> ;
    rdfs:comment "Vastlegging van een versie van een set gegevens." ;
    skos:notation "Registratie" ;
    sh:property [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:indicatieFormeleHistorie false ;
            ns1:toelichting "Er zijn verschillende datatypen voor de representatie van een tijdsaanduiding: afhankelijk van de gebruikerswensen m.b.t. granulariteit kan o.a. worden gekozen uit typen TM_Instant, Date of DateTime." ;
            dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/object_begintijd> ;
            rdfs:comment "Tijdsaanduiding waarop het object in de werkelijkheid is ontstaan." ;
            sh:datatype xsd:dateTime ;
            sh:group <http://modellen.geostandaarden.nl/nen3610/id/shape/Levensduur> ;
            sh:maxCount 1 ;
            sh:name "objectBeginTijd" ;
            sh:nodeKind sh:Literal ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#objectBeginTijd> ],
        [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:indicatieFormeleHistorie false ;
            ns1:toelichting "Vanaf het begin van deze tijdsaanduiding is de instantie niet meer geldig. Er zijn verschillende datatypen voor de representatie van een tijdsaanduiding: afhankelijk van de gebruikerswensen m.b.t. granulariteit kan o.a. worden gekozen uit typen TM_Instant, Date of DateTime. Het eind van de periode is tot het begin van de tijdsaanduiding; het ?tot-moment'." ;
            dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/eind_geldigheid> ;
            rdfs:comment "Eind van de periode waarop deze versie van het informatieobject geldig is. De periode is tot aan deze tijdsaanduiding. Wanneer deze waarde niet is ingevuld, is de versie nog geldig." ;
            sh:datatype xsd:date ;
            sh:group <http://modellen.geostandaarden.nl/nen3610/id/shape/TijdlijnGeldigheid> ;
            sh:maxCount 1 ;
            sh:name "eindGeldigheid" ;
            sh:nodeKind sh:Literal ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#eindGeldigheid> ],
        [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:indicatieFormeleHistorie false ;
            ns1:toelichting "Er zijn verschillende datatypen voor de representatie van een tijdsaanduiding: afhankelijk van de gebruikerswensen m.b.t. granulariteit kan o.a. worden gekozen uit typen TM_Instant, Date of DateTime." ;
            dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/object_eindtijd> ;
            rdfs:comment "Tijdsaanduiding waarop het object in de werkelijkheid niet meer geldig is." ;
            sh:datatype xsd:dateTime ;
            sh:group <http://modellen.geostandaarden.nl/nen3610/id/shape/Levensduur> ;
            sh:name "objectEindTijd" ;
            sh:nodeKind sh:Literal ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#objectEindTijd> ],
        [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:indicatieFormeleHistorie false ;
            ns1:toelichting "Er zijn verschillende datatypen voor de representatie van een tijdsaanduiding: afhankelijk van de gebruikerswensen m.b.t. granulariteit kan o.a. worden gekozen uit typen TM_Instant, Date of DateTime. De start van een periode is het begin van de tijdsaanduiding; het ?vanaf-moment'. Bij een datum (date) is dat het begin van die dag." ;
            dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/begin_geldigheid> ;
            rdfs:comment "Start van de periode waarop deze versie van het informatieobject geldig is." ;
            sh:datatype xsd:date ;
            sh:group <http://modellen.geostandaarden.nl/nen3610/id/shape/TijdlijnGeldigheid> ;
            sh:maxCount 1 ;
            sh:name "beginGeldigheid" ;
            sh:nodeKind sh:Literal ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#beginGeldigheid> ],
        [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:indicatieFormeleHistorie false ;
            ns1:toelichting "Vanaf deze tijdsaanduiding is deze versie van het informatieobject niet meer  actueel in de registratie. Met actueel wordt bedoeld dat er geen nieuwere versie 4 in de registratie is voor dit informatieobject. Aan een lege eindregistratie is ook te zien dat het de actuele versie betreft. Er zijn verschillende datatypen voor de representatie van een tijdsaanduiding: afhankelijk van de gebruikerswensen m.b.t. granulariteit kan o.a. worden gekozen uit typen TM_Instant, Date of DateTime. Voor tijdstipRegistratie zal DateTime in vrijwel alle gevallen de beste keuze zijn. \\r\\n\\r\\nWanneer bepaalde gegevens op de tijdlijn geldigheid niet meer geldig zijn, te herkennen aan de eindGeldigheid van een versie, wordt bij het vullen van de eindGeldigheid tegelijkertijd ook altijd de eindRegistratie gevuld zodat het duidelijk is vanaf welk moment op de tijdlijn registratie deze gegevens niet meer actueel zijn. De eindRegistratie geeft dus aan wanneer er geregistreerd is dat deze gegevens niet meer actueel zijn." ;
            dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/eind_registratie> ;
            rdfs:comment "Eind van de periode dat deze versie van het informatieobject actueel is in de registratie. De periode is tot aan deze tijdsaanduiding. Wanneer deze waarde niet is ingevuld, is de versie nog actueel." ;
            sh:datatype xsd:dateTime ;
            sh:group <http://modellen.geostandaarden.nl/nen3610/id/shape/TijdlijnRegistratie> ;
            sh:maxCount 1 ;
            sh:name "eindRegistratie" ;
            sh:nodeKind sh:Literal ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#eindRegistratie> ],
        [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:indicatieFormeleHistorie false ;
            ns1:patroon "Waarde van attribuut versie mag maximaal 50 karakters bevatten." ;
            ns1:toelichting "Een versie van een informatieobject is een toestand van een informatieobject met zijn gegevens op een bepaald moment in de tijd. Het attribuut versie maakt geen deel uit van de identificatie van het object, maar kan worden gebruikt om verschillende instanties van hetzelfde informatieobject te identificeren." ;
            dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/versie> ;
            rdfs:comment "Versieaanduiding van een informatieobject." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 50 ;
            sh:minLength 1 ;
            sh:name "versie" ;
            sh:nodeKind sh:Literal ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#versie> ],
        [ ns1:authentiek ns1:OverigeAuthenticiteit ;
            ns1:datumOpname "20220601" ;
            ns1:herkomst "nen 3610" ;
            ns1:herkomstDefinitie "nen 3610" ;
            ns1:indicatieFormeleHistorie false ;
            ns1:toelichting "Er zijn verschillende datatypen voor de representatie van een tijdsaanduiding: afhankelijk van de gebruikerswensen m.b.t. granulariteit kan o.a. worden gekozen uit typen TM_Instant, Date of DateTime. Voor tijdstip registratie zal DateTime in vrijwel alle gevallen de beste keuze zijn." ;
            dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/tijdstip_registratie> ;
            rdfs:comment "Tijdsaanduiding van het moment waarop deze versie van het informatieobject is opgenomen in de registratie." ;
            sh:datatype xsd:dateTime ;
            sh:group <http://modellen.geostandaarden.nl/nen3610/id/shape/TijdlijnRegistratie> ;
            sh:maxCount 1 ;
            sh:name "tijdstipRegistratie" ;
            sh:nodeKind sh:Literal ;
            sh:path <http://modellen.geostandaarden.nl/def/nen3610#tijdstipRegistratie> ] ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#Registratie> .

<http://modellen.geostandaarden.nl/nen3610/id/shape/RegistratieveRuimte> a sh:NodeShape ;
    rdfs:label "RegistratieveRuimte" ;
    ns1:alias "Registratieve ruimte" ;
    ns1:datumOpname "20220601" ;
    ns1:herkomst "nen 3610" ;
    ns1:herkomstDefinitie "nen 3610" ;
    ns1:indicatieAbstractObject true ;
    ns1:toelichting "Registratieve ruimte omvat objecten die onder de wet- of regelgeving vallen of die voor bedrijfsvoering administratief van belang zijn. In veel gevallen zal een dergelijk gebied ook een registratieve aanduiding of registratief nummer hebben. Voorbeelden zijn: gemeente Delft, postcodegebied 2345, politieregio Haaglanden, veiligheidsregio Gelderland-Midden, Nationaal Park De Hoge Veluwe, kadastraal perceel." ;
    dcterms:subject <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/registratieve_ruimte> ;
    rdfs:comment "Op basis van wet- of regelgeving afgebakende ruimte die als eenheid geldt van politiek-bestuurlijke verantwoordelijkheid of voor bedrijfsvoering." ;
    skos:notation "RegistratieveRuimte" ;
    sh:targetClass <http://modellen.geostandaarden.nl/def/nen3610#RegistratieveRuimte> .

