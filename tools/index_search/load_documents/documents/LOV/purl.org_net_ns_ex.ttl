@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/net/ns/ontology-annot#> .
@prefix ns2: <http://purl.org/net/ns/ex#> .
@prefix onto: <http://purl.org/net/ns/ex> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ns2:code a owl:AnnotationProperty ;
    rdfs:label "Code" ;
    rdfs:comment "Has an example code of an RDF/XML statements that use the schema. Content may be CDATA section or rdf:parseType=\"Literal\"." ;
    rdfs:isDefinedBy onto: .

ns2:example a owl:AnnotationProperty ;
    rdfs:label "Example" ;
    rdfs:comment "The subject has an Example. Use to include example(s) in a term definition." ;
    rdfs:isDefinedBy onto: .

ns2:exampleOf a owl:AnnotationProperty ;
    rdfs:label "Example of" ;
    rdfs:comment "The subject is an example of the object vocabulary." ;
    rdfs:isDefinedBy onto: .

ns2:image a owl:AnnotationProperty ;
    rdfs:label "Image" ;
    rdfs:comment "A pointer to an image that helps to understand the vocabulary." ;
    rdfs:isDefinedBy onto: .

ns2:pfx a owl:AnnotationProperty ;
    rdfs:label "Prefix" ;
    rdfs:comment "A prefix used in the example to represent the schema namespace. A rendaring application may use this value to distinguish target terms in the example." ;
    rdfs:isDefinedBy onto: .

ns2:trial a owl:AnnotationProperty ;
    rdfs:label "Trial" ;
    rdfs:comment "A pointer to a real example or a trial page." ;
    rdfs:isDefinedBy onto: .

ns2:Example a owl:Class ;
    rdfs:label "Example" ;
    rdfs:comment "A class represents one example." ;
    rdfs:isDefinedBy onto: .

<urn:pin:MK705> a foaf:Person ;
    rdfs:seeAlso <http://www.kanzaki.com/info/webwho.rdf> ;
    foaf:homepage <http://www.kanzaki.com/> .

onto: a owl:Ontology ;
    rdfs:label "Example vocabulary" ;
    ns1:created "2003-07-04" ;
    ns1:creator <urn:pin:MK705> ;
    ns1:modified "2007-12-13" ;
    rdfs:comment "Vocabulary to include sample codes in a schema. Can work with XSLT (http://purl.org/net/ns/ns-schema.xsl) to present schema as XHTML list with examples." ;
    owl:imports <http://www.kanzaki.com/ns/dliser.rdf> ;
    owl:versionInfo "Version 0.35" .

[] a ns2:Example ;
    ns2:code "\\n<ex:Example>\\n <rdfs:comment>An example to use Dublin Core vocabulary.</rdfs:comment>\\n <rdfs:comment xml:lang=\"ja\">ダブリンコア語彙を使う例</rdfs:comment>\\n <ex:pfx>dc:</ex:pfx>\\n <ex:code rdf:parseType=\"Literal\">\\n  <rdf:Description rdf:about=\"http://www.kanzaki.com/\">\\n   <dc:title>The Web KANZAKI</dc:title>\\n   <dc:creator>Masahide Kanzaki</dc:creator>\\n  </rdf:Description>\\n </ex:code>\\n <ex:exampleOf rdf:resource=\"\"/>\\n</ex:Example>\\n " ;
    ns2:exampleOf onto: ;
    ns2:pfx "ex:" ;
    rdfs:comment "An example included in a schema definition." .

