@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/11/swrl#> .
@prefix ns2: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix ns4: <http://gbol.life/ontology/bibo#> .
@prefix onto: <https://w3id.org/tribont/equipment> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns3:license a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

owl:cardinality a owl:AnnotationProperty .

owl:maxCardinality a owl:AnnotationProperty .

owl:qualifiedCardinality a owl:AnnotationProperty .

ns2:term_status a owl:AnnotationProperty .

onto: a owl:Ontology ;
    ns3:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    ns4:status "published" ;
    dcterms:bibliographicCitation "Work in progress" ;
    dcterms:contributor "Izaskun Fernandez (Tekniker) \\nDomain expert:Iban Quintana (Tekniker) \\nDomain expert:Xana Fernandez (Tekniker)"@en ;
    dcterms:created "2023-06-02" ;
    dcterms:creator "Patricia Casla (Tekniker)"@en ;
    dcterms:description "The goal of this module is to represent the equipment hierarchy model involved in the tribological experiments."@en ;
    dcterms:issued "2023-06-02" ;
    dcterms:publisher "Tekniker" ;
    dcterms:title "Equipment module" ;
    vann:preferredNamespacePrefix "equipment" ;
    vann:preferredNamespaceUri "https://w3id.org/tribont/equipment" ;
    owl:imports <https://w3id.org/tribont/core> ;
    owl:versionInfo 1.0 .

<https://w3id.org/tribont/equipment#AbrasionTester> a owl:Class ;
    rdfs:label "AbrasionTester" ;
    rdfs:comment " An equipment that measures the abrasion resistance of something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#MeasuringEquipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#EquipmentStandard> a owl:Class ;
    rdfs:label "EquipmentStandard" ;
    rdfs:comment "A document approved by a recognized body that provides common to by fullfiled by an equipment." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#Standard> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#HardnessTester> a owl:Class ;
    rdfs:label "HardnessTester" ;
    rdfs:comment "An equipment that measures the hardness of a material, " ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#HardnessProperty> ;
            owl:onProperty <https://w3id.org/tribont/core#isCharacterisedByOutputMeasure> ],
        <https://w3id.org/tribont/equipment#MeasuringEquipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#HardnessTesterClass> a owl:Class ;
    rdfs:label "HardnessTesterClass" ;
    rdfs:comment "An aggrupation of hardness testers with a set of common atributes of characteristics." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#MeasuringEquipmentClass> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#MachineryBook> a owl:Class ;
    rdfs:label "MachineryBook" ;
    rdfs:comment "A document providing all the relevant information of the technical characteristics of an equipment, and describes how and when to use and mantain it. " ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#TechnicalDocument> ;
    owl:disjointWith <https://w3id.org/tribont/equipment#ManufacturerDataSheet> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#OpticalProfilometer> a owl:Class ;
    rdfs:label "OpticalProfilometer" ;
    rdfs:comment "An equipment used to measure precisely surface profiles." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#MeasuringEquipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#Scale> a owl:Class ;
    rdfs:label "Scale" ;
    rdfs:comment "An equipment used to measure the weigth of somebody or something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Weight> ;
            owl:onProperty <https://w3id.org/tribont/core#isCharacterisedByOutputMeasure> ],
        <https://w3id.org/tribont/equipment#MeasuringEquipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#ScanningElectronMicroscope> a owl:Class ;
    rdfs:label "ScanningElectronMicroscope" ;
    rdfs:comment "An equipment used to assess the materials surfaces by producing images of a sample." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#MeasuringEquipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#ScratchTester> a owl:Class ;
    rdfs:label "ScratchTester" ;
    rdfs:comment "An equipment used to assess the coating adhesion." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#MeasuringEquipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#Tribometer> a owl:Class ;
    rdfs:label "Tribometer" ;
    rdfs:comment "An equipment used to measure tribological properties (e.g. friction coefficients, wear, etc.) by simulating the interaction of between two surfaces in contact under specific operation conditions." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/equipment#holdsStaticSampleBody> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/tribont/equipment#holdsStaticSampleBody> ;
            owl:someValuesFrom <https://w3id.org/tribont/core#Body> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/tribont/equipment#holdsMovingSampleBody> ;
            owl:someValuesFrom <https://w3id.org/tribont/core#Body> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#TribologicalProperty> ;
            owl:onProperty <https://w3id.org/tribont/core#isCharacterisedByOutputMeasure> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/equipment#holdsMovingSampleBody> ],
        <https://w3id.org/tribont/equipment#ExperimentalEquipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#TribometerClass> a owl:Class ;
    rdfs:label "TribometerClass" ;
    rdfs:comment "An aggrupation of tribometers with a set of common atributes of characteristics." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/equipment#holdsStaticSampleBody> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/equipment#holdsMovingSampleBody> ],
        <https://w3id.org/tribont/equipment#ExperimentalEquipmentClass> ;
    ns2:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#Property> a owl:Class .

<https://w3id.org/isCharacterisedBy#Unit> a owl:Class .

<https://w3id.org/tribont/core#HardnessProperty> a owl:Class .

<https://w3id.org/tribont/core#OperationProperty> a owl:Class .

<https://w3id.org/tribont/core#Role> a owl:Class .

<https://w3id.org/tribont/core#TechnicalProperty> a owl:Class .

<https://w3id.org/tribont/core#TribologicalProperty> a owl:Class .

<https://w3id.org/tribont/core#Weight> a owl:Class .

<https://w3id.org/tribont/core#longName> a owl:DatatypeProperty .

<https://w3id.org/tribont/core#shortNam> a owl:DatatypeProperty .

<https://w3id.org/tribont/equipment#ExperimentalEquipment> a owl:Class ;
    rdfs:label "ExperimentalEquipment" ;
    rdfs:comment "An equipment that reproduces certain operation conditions for experimentation purposes." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#Equipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#ExperimentalEquipmentClass> a owl:Class ;
    rdfs:label "ExperimentalEquipmentClass" ;
    rdfs:comment "An aggrupation of experimental equipments with a set of common atributes of characteristics." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#EquipmentClass> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#ManufacturerDataSheet> a owl:Class ;
    rdfs:label "ManufacturerDataSheet" ;
    rdfs:comment "A document provided by the manufacturer that includes a summary of technical characteristics, and describes how and when to use something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#TechnicalDocument> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#MeasuringEquipmentClass> a owl:Class ;
    rdfs:label "MeasuringEquipmentClass" ;
    rdfs:comment "An aggrupation of measuring equipment with a set of common atributes of characteristics." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#EquipmentClass> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#OpticalMicroscope> a owl:Class ;
    rdfs:label "OpticalMicroscope" ;
    rdfs:comment "An equipment used to assess surfaces by magnifying images with visible light." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/equipment#OpticalMicroscope> ;
            owl:onProperty <https://w3id.org/tribont/core#isCharacterisedByOperationCondition> ],
        <https://w3id.org/tribont/equipment#MeasuringEquipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#executionDate> a owl:DatatypeProperty ;
    rdfs:label "executionDate" ;
    rdfs:comment "The date when a specific action has been performed." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#isHeldMovingSampleBodyBy> a owl:ObjectProperty ;
    rdfs:label "isHeldMovingSampleBodyBy" ;
    rdfs:comment "Relationship between a movig sample body and the equipment that hold it." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subPropertyOf <https://w3id.org/tribont/equipment#isHeldSampleBodyBy> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#isHeldStaticSampleBodyBy> a owl:ObjectProperty ;
    rdfs:label "isHeldStaticSampleBodyBy" ;
    rdfs:comment "Relationship between astatic  sample body and the equipment that hold it." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subPropertyOf <https://w3id.org/tribont/equipment#isHeldSampleBodyBy> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#validityDate> a owl:DatatypeProperty ;
    rdfs:label "validityDate" ;
    rdfs:comment "The date until which a given action is valid and after which it is necessary to repeat it." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/core#Standard> a owl:Class .

<https://w3id.org/tribont/core#hasLocation> a owl:ObjectProperty .

<https://w3id.org/tribont/core#hasManufacturer> a owl:ObjectProperty .

<https://w3id.org/tribont/core#isCharacterisedByOperationCondition> a owl:ObjectProperty .

<https://w3id.org/tribont/equipment#CalibrationDocument> a owl:Class ;
    rdfs:label "CalibrationDocument" ;
    rdfs:comment "A document that contains all the relevant information related to a specific calibration." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#Document> ;
    owl:disjointWith <https://w3id.org/tribont/equipment#TechnicalDocument> ;
    ns2:term_status "Testing" .

<urn:swrl:var#c> a ns1:Variable .

<urn:swrl:var#m> a ns1:Variable .

<urn:swrl:var#mp> a ns1:Variable .

<urn:swrl:var#p> a ns1:Variable .

<https://w3id.org/isCharacterisedBy#SubjectOfInterest> a owl:Class .

<https://w3id.org/tribont/core#Company> a owl:Class .

<https://w3id.org/tribont/core#Document> a owl:Class .

<https://w3id.org/tribont/equipment#Calibration> a owl:Class ;
    rdfs:label "Calibration" ;
    rdfs:comment "The action or process of calibrating something to maintain accuracy, and repeatability in measurements, assuring reliable results." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <https://w3id.org/tribont/equipment#validityDate> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/equipment#CalibrationDocument> ;
            owl:onProperty <https://w3id.org/tribont/core#hasDocument> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <https://w3id.org/tribont/equipment#executionDate> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#hasCalibration> a owl:ObjectProperty ;
    rdfs:label "hasCalibration" ;
    rdfs:comment "The relation between a specific equipment and the calibrations performed on it." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#holdsMovingSampleBody> a owl:ObjectProperty ;
    rdfs:label "holdsMovingSampleBody" ;
    rdfs:comment "Relationship between an equipment and the moving sample  body it can hold" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subPropertyOf <https://w3id.org/tribont/equipment#holdsSampleBody> ;
    owl:inverseOf <https://w3id.org/tribont/equipment#isHeldMovingSampleBodyBy> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#holdsStaticSampleBody> a owl:ObjectProperty ;
    rdfs:label "holdsStaticSampleBody" ;
    rdfs:comment "Relationship between an equipment and the static sample  body it can hold" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subPropertyOf <https://w3id.org/tribont/equipment#holdsSampleBody> ;
    owl:inverseOf <https://w3id.org/tribont/equipment#isHeldStaticSampleBodyBy> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#isHeldSampleBodyBy> a owl:ObjectProperty ;
    rdfs:label "isHeldSampleBodyBy" ;
    rdfs:comment "Relationship between a sample body and the equipment that hold it." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    ns2:term_status "Testing" .

<https://w3id.org/isCharacterisedBy#belongsTo> a owl:ObjectProperty .

<https://w3id.org/tribont/core#isCharacterisedByOutputMeasure> a owl:ObjectProperty .

<https://w3id.org/tribont/equipment#EquipmentClass> a owl:Class ;
    rdfs:label "EquipmentClass" ;
    rdfs:comment "An aggrupation of equipments with a set of common atributes of characteristics." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/tribont/equipment#purpose> ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/equipment#TechnicalDocument> ;
            owl:onProperty <https://w3id.org/tribont/core#hasDocument> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/tribont/equipment#measuringPrinciple> ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/tribont/core#hasDocument> ;
            owl:someValuesFrom <https://w3id.org/tribont/equipment#TechnicalDocument> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/equipment#holdsSampleBody> ],
        <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#holdsSampleBody> a owl:ObjectProperty ;
    rdfs:label "holdsSampleBody" ;
    rdfs:comment "Relationship between an equipment and the sample body it can hold" ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    owl:inverseOf <https://w3id.org/tribont/equipment#isHeldSampleBodyBy> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#measuringPrinciple> a owl:DatatypeProperty ;
    rdfs:label "measuringPrinciple" ;
    rdfs:comment "The measuring principle followed by an equipment." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#purpose> a owl:DatatypeProperty ;
    rdfs:label "purpose" ;
    rdfs:comment "The puspose of an equipment." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    ns2:term_status "Testing" .

<urn:swrl:var#d> a ns1:Variable .

<https://w3id.org/tribont/equipment#MeasuringEquipment> a owl:Class ;
    rdfs:label "MeasuringEquipment" ;
    rdfs:comment "An equipment used to measure technical attributes or characteristics of something." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/equipment#Equipment> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#TechnicalDocument> a owl:Class ;
    rdfs:label "TechnicalDocument" ;
    rdfs:comment "Information on how to to use and maintain something as for e.g. drawings, manuals, technical reports, etc." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf <https://w3id.org/tribont/core#Document> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/equipment#Equipment> a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:comment "An object which is instrumental for reaching a particular purpose through its characteristic functioning process." ;
    rdfs:isDefinedBy "https://w3id.org/tribont/equipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/tribont/core#hasDocument> ;
            owl:someValuesFrom <https://w3id.org/tribont/equipment#TechnicalDocument> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Body> ;
            owl:onProperty <https://w3id.org/tribont/equipment#holdsSampleBody> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#TechnicalProperty> ;
            owl:onProperty <https://w3id.org/tribont/core#isCharacterisedByOutputMeasure> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#Company> ;
            owl:onProperty <https://w3id.org/tribont/core#hasLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/equipment#Calibration> ;
            owl:onProperty <https://w3id.org/tribont/equipment#hasCalibration> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/tribont/equipment#purpose> ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/core#Company> ;
            owl:onProperty <https://w3id.org/tribont/core#hasLocation> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://w3id.org/tribont/equipment#CalibrationDocument> <https://w3id.org/tribont/equipment#TechnicalDocument> ) ] ;
            owl:onProperty <https://w3id.org/tribont/core#hasDocument> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/tribont/core#longName> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/tribont/core#shortNam> ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/tribont/core#OperationProperty> ;
            owl:onProperty <https://w3id.org/tribont/core#isCharacterisedByOperationCondition> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/tribont/equipment#measuringPrinciple> ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/tribont/equipment#Calibration> ;
            owl:onProperty <https://w3id.org/tribont/equipment#hasCalibration> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <https://w3id.org/isCharacterisedBy#SubjectOfInterest> ;
    ns2:term_status "Testing" .

<https://w3id.org/tribont/core#Body> a owl:Class .

<https://w3id.org/tribont/core#hasDocument> a owl:ObjectProperty .

<urn:swrl:var#eqc> a ns1:Variable .

<urn:swrl:var#eq> a ns1:Variable .

[] owl:cardinality "1"^^xsd:nonNegativeInteger .

[] a owl:AllDisjointClasses ;
