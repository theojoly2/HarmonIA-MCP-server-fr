@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:contributor a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:date a owl:DatatypeProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

<https://w3id.org/AIRO> a owl:Ontology ;
    rdfs:label "AI Risk Ontology"@en ;
    dcterms:contributor "Dave Lewis",
        "Harshvardhan J. Pandit" ;
    dcterms:creator "Delaram Golpayegani" ;
    dcterms:description "AIRO represents AI risk concepts and relations based on the AI Act draft and ISO 31000 standard series."@en ;
    dcterms:issued "2021-01-20T09:00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2021-07-01T17:01:00"^^xsd:dateTime ;
    dcterms:publisher "ADAPT Centre, Trinity College Dublin" ;
    dcterms:title "AIRO" ;
    owl:versionInfo 0.2 .

<https://w3id.org/AIRO#AIHardware> a owl:Class ;
    rdfs:label "AI Hardware"@en ;
    rdfs:comment "Hardware on which the AI system run."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AIComponent> .

<https://w3id.org/AIRO#AdmissionTestAssessment> a owl:Class ;
    rdfs:label "Admission Test Assessment"@en ;
    rdfs:comment "Refers to the assessment of participants in tests  required for admission to educational institutions."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AssessmentForEducation> .

<https://w3id.org/AIRO#AdversarialAttack> a owl:Class ;
    rdfs:label "Adversarial Attack"@en ;
    rdfs:comment "inputs designed to cause the model to make a mistake"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Attack> .

<https://w3id.org/AIRO#AdvertisingVacancies> a owl:Class ;
    rdfs:label "Advertising Vacancies"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AssessmentForRecuitment> .

<https://w3id.org/AIRO#Alogorithm-RelatedRiskSource> a owl:Class ;
    rdfs:label "Algorithm-Related Risk Source"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#RiskSource> .

<https://w3id.org/AIRO#ApplicationFiltering> a owl:Class ;
    rdfs:label "Application Filtering"@en ;
    rdfs:comment "Filtering applications for recruitment or selection of natural persons."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AssessmentForRecuitment> .

<https://w3id.org/AIRO#ApplicationScreening> a owl:Class ;
    rdfs:label "Application Screening"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AssessmentForRecuitment> .

<https://w3id.org/AIRO#ApplyingLawToFacts> a owl:Class ;
    rdfs:label "Applying The Law to Facts"@en ;
    rdfs:comment "Refers to the application of the law to a concrete set of facts."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#KnowledgeReasoning> .

<https://w3id.org/AIRO#Approval> a owl:Class ;
    rdfs:label "Approval"@en ;
    rdfs:comment "Represents approval or refusual of a request, excutation of process, etc. to prevent or mitigate a risk."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#ManualControl> .

<https://w3id.org/AIRO#AssessingHealthRisk> a owl:Class ;
    rdfs:label "Assessing Health Risk"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#IndividualRiskAssessment> .

<https://w3id.org/AIRO#AssessingPastCriminalBehaviour> a owl:Class ;
    rdfs:label "Assessing Past Criminal Behaviour"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Assessment> .

<https://w3id.org/AIRO#AssessingRiskForPotentialVictimsOfCriminalOffences> a owl:Class ;
    rdfs:label "Assessing Risk For Potential Victims Of Criminal Offences"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#IndividualRiskAssessment> .

<https://w3id.org/AIRO#AssessingRiskOfIrregularImmigration> a owl:Class ;
    rdfs:label "Assessing Risk Of Irregular Immigration"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#IndividualRiskAssessment> .

<https://w3id.org/AIRO#AssessingRiskOfOffending> a owl:Class ;
    rdfs:label "Assessing Risk Of Offending"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#IndividualRiskAssessment> .

<https://w3id.org/AIRO#AssessingRiskOfReoffending> a owl:Class ;
    rdfs:label "Assessing Risk Of Reoffending"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#IndividualRiskAssessment> .

<https://w3id.org/AIRO#AssessingSecurityRisk> a owl:Class ;
    rdfs:label "Assessing Security Risk"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#IndividualRiskAssessment> .

<https://w3id.org/AIRO#AssessingTestsRequiredForAdmission> a owl:Class ;
    rdfs:label "Assessing Tests Required For Admission"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#StudentAssessment> .

<https://w3id.org/AIRO#AssigningPeopleToEducationalInstitutions> a owl:Class ;
    rdfs:label "Assigning People To Educational Institutions"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AssessmentForEducation> .

<https://w3id.org/AIRO#AsylumApplicationExamination> a owl:Class ;
    rdfs:label "Asylum Application Examination"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#ApplicationExamination> .

<https://w3id.org/AIRO#AsylumSeeker> a owl:Class ;
    rdfs:label "Asylum Seeker"@en ;
    rdfs:comment "A person who has applied for asylum."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Applicant> .

<https://w3id.org/AIRO#AutomatedControl> a owl:Class ;
    rdfs:label "Automated Control"@en ;
    rdfs:comment "Represents controls that do not involve human intervention."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Control> ;
    owl:disjointWith <https://w3id.org/AIRO#ManualControl> .

<https://w3id.org/AIRO#BayesianEstimation> a owl:Class ;
    rdfs:label "Bayesian Estimation"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#StatisticalApproach> .

<https://w3id.org/AIRO#Bias> a owl:Class ;
    rdfs:label "Bias"@en ;
    rdfs:comment "Systematic difference in treatment of certain objects, people, or groups in comparison to others [ISO 22989]"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#BiasConsequence> .

<https://w3id.org/AIRO#BiasDetection> a owl:Class ;
    rdfs:label "Bias Detection"@en ;
    rdfs:comment "Represens controls that are applied to detect bias in datasets, models, algorithms, ect."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#DetectionControl> .

<https://w3id.org/AIRO#BiasedTestingDataSet> a owl:Class ;
    rdfs:label "Biased Testing Data Set"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#TestingDataRiskSource> .

<https://w3id.org/AIRO#BiasedTrainingDataSet> a owl:Class ;
    rdfs:label "Biased Training Data Set"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#TrainingDataRiskSource> .

<https://w3id.org/AIRO#BiasedValidationDataSet> a owl:Class ;
    rdfs:label "Biased Validation Data Set"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#ValidationDataRelatedSource> .

<https://w3id.org/AIRO#BiomerticCategorisation> a owl:Class ;
    rdfs:label "Biometric Categorisation"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#MakingDecision> .

<https://w3id.org/AIRO#BiometricIdnetification> a owl:Class ;
    rdfs:label "Biometric Identification"@en ;
    rdfs:comment "Identifaction of natural persons using biometric data."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#MakingDecision> .

<https://w3id.org/AIRO#Blueprint> a owl:Class ;
    rdfs:label "Blueprint"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Document> .

<https://w3id.org/AIRO#Child> a owl:Class ;
    rdfs:label "Child"@en ;
    rdfs:comment "An individual human being who is below the age of 18 (according to the UN Convention on the Rights of the Child)"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Person> .

<https://w3id.org/AIRO#CompetentPublicAuthority> a owl:Class ;
    rdfs:label "Competent Public Authority"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#PublicAuthority> .

<https://w3id.org/AIRO#Content> a owl:Class ;
    rdfs:label "Content"@en ;
    rdfs:comment "Content generated using an AI system."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Output> .

<https://w3id.org/AIRO#CreditworthinessAssessment> a owl:Class ;
    rdfs:label "Creditworthiness Assessment"@en ;
    rdfs:comment "Refers to the evaluation the creditworthiness of natural persons or establishing their credit score."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Assessment> .

<https://w3id.org/AIRO#Cyberattack> a owl:Class ;
    rdfs:label "Cyberattack"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Attack> .

<https://w3id.org/AIRO#DataAccuracy> a owl:Class ;
    rdfs:label "Data Accuracy"@en ;
    rdfs:comment "Indicates the degree to which data has attributes that correctly represent the true value of the intended attribute of a concept or event in a specific context of use. [ISO 22989, 3.4.3]"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Accuracy> .

<https://w3id.org/AIRO#DataPoisoning> a owl:Class ;
    rdfs:label "Data Poisoning"@en ;
    rdfs:comment "Attack trying to manipulate the training dataset"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Attack> .

<https://w3id.org/AIRO#Datasheet> a owl:Class ;
    rdfs:label "Datasheet"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Document> .

<https://w3id.org/AIRO#Death> a owl:Class ;
    rdfs:label "Death"@en ;
    rdfs:comment "Represents death of a person caused by AI."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#WellbeingImpact> .

<https://w3id.org/AIRO#Decision> a owl:Class ;
    rdfs:label "Decision"@en ;
    rdfs:comment "Decision generated by an AI system."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Output> .

<https://w3id.org/AIRO#DecreasedRobustness> a owl:Class ;
    rdfs:label "Decreased Robustness"@en ;
    rdfs:comment "Indicates decreased level of system's robustness resulted from materialisation of a risk."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#PerformanceConsequence> .

<https://w3id.org/AIRO#DecreasedSecurity> a owl:Class ;
    rdfs:label "Decreased Security"@en ;
    rdfs:comment "Indicates decreased level of security of the AI system resulted from materialisation of a risk."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#PerformanceConsequence> .

<https://w3id.org/AIRO#DeepFakeDetection> a owl:Class ;
    rdfs:label "Deep Fake Detection"@en ;
    rdfs:comment "Dectection of content that is generated using deep fake."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Detection> .

<https://w3id.org/AIRO#Defendant> a owl:Class ;
    rdfs:label "Defendant"@en ;
    rdfs:comment "A person who is being accused of criminal offences."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Person> .

<https://w3id.org/AIRO#DegradedAccuracy> a owl:Class ;
    rdfs:label "Degraded Accuracy"@en ;
    rdfs:comment "Indicates decreased level of system's accuracy resulted from materialisation of a risk."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#PerformanceConsequence> .

<https://w3id.org/AIRO#DesignSpecification> a owl:Class ;
    rdfs:label "Design Specification"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Document> .

<https://w3id.org/AIRO#DetectingNon-AuthenticDocuments> a owl:Class ;
    rdfs:label "Detecting Non-Authentic Documents"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Detection> .

<https://w3id.org/AIRO#DetermineCreditScore> a owl:Class ;
    rdfs:label "Determine Credit Score"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Assessment> .

<https://w3id.org/AIRO#DeterminingAccessToEducation> a owl:Class ;
    rdfs:label "Determining Access To Education"@en ;
    rdfs:comment "Refers to the purpose of determining access or assigning natural persons to educational and vocational training institutions."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AssessmentForEducation> .

<https://w3id.org/AIRO#DiscoveringHiddenRelationshipsRelatedToCrime> a owl:Class ;
    rdfs:label "Discovering Hidden Relationships Related To Crime"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#CrimeAnalytics> .

<https://w3id.org/AIRO#DispatchingEmergencyService> a owl:Class ;
    rdfs:label "Dispacthing Emergency Service"@en ;
    rdfs:comment "Dispatching of emergency first response services, including by firefighters and medical aid."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Planning> .

<https://w3id.org/AIRO#DisruptionOfOperationOfCriticalInfrastructure> a owl:Class ;
    rdfs:label "Disruption Of Operation Of Critical Infrastructure"@en ;
    rdfs:comment "Represents disruption of management and operation of critical infrastructure."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#ImpactOnFacility> .

<https://w3id.org/AIRO#DistortionInHumanBehaviour> a owl:Class ;
    rdfs:label "Distortion In Human Behaviour"@en ;
    rdfs:comment "Represents adverse impacts of AI on human behaviour."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#WellbeingImpact> .

<https://w3id.org/AIRO#EUDeclarationOfConformity> a owl:Class ;
    rdfs:label "EU Declaration Of Conformity"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Document> .

<https://w3id.org/AIRO#EliminationControl> a owl:Class ;
    rdfs:label "Elimination Control"@en ;
    rdfs:comment "Represents controls that applied to prevent an event from happening."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Control> .

<https://w3id.org/AIRO#EmotionRecognition> a owl:Class ;
    rdfs:label "Emotion Recognition"@en ;
    rdfs:comment "Refers to the detection of the emotional state of a natural person."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Detection> .

<https://w3id.org/AIRO#Employee> a owl:Class ;
    rdfs:label "Employee"@en ;
    rdfs:comment "Persons in work-related contractual relationships."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Person> .

<https://w3id.org/AIRO#EmployeeBehaviourMonitoring> a owl:Class ;
    rdfs:label "Employee Behaviour Monitoring"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#EmployeeMonitoring> .

<https://w3id.org/AIRO#EmployeeEvaluation> a owl:Class ;
    rdfs:label "Employee Evaluation"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AssessmentForRecuitment> .

<https://w3id.org/AIRO#EmployeePerformanceMonitoring> a owl:Class ;
    rdfs:label "Employee Performance Monitoring"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#EmployeeMonitoring> .

<https://w3id.org/AIRO#EnvironmentalDamage> a owl:Class ;
    rdfs:label "Environmental Damage"@en ;
    rdfs:comment "Represents the deterioration of the environment caused by AI."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#EnvironmentalImpact> .

<https://w3id.org/AIRO#ErrorInDataCollection> a owl:Class ;
    rdfs:label "Error In Data Collection"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#DataSet-RelatedRiskSource> .

<https://w3id.org/AIRO#ErrorInDataPrepration> a owl:Class ;
    rdfs:label "Error In Data Prepration"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#DataSet-RelatedRiskSource> .

<https://w3id.org/AIRO#ErrorInInputData> a owl:Class ;
    rdfs:label "Error In Input Data"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#InputDataRiskSource> .

<https://w3id.org/AIRO#ErrorInTestingDataSet> a owl:Class ;
    rdfs:label "Error In Testing Data Set"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#TestingDataRiskSource> .

<https://w3id.org/AIRO#ErrorInTrainingDataSet> a owl:Class ;
    rdfs:label "Error In Training Data Set"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#TrainingDataRiskSource> .

<https://w3id.org/AIRO#ErrorInValidationDataSet> a owl:Class ;
    rdfs:label "Error In Validation Data Set"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#ValidationDataRelatedSource> .

<https://w3id.org/AIRO#EvaluatingBehaviourOfEmployee> a owl:Class ;
    rdfs:label "Evaluating Behaviour Of Employee"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AssessmentOfEmployee> .

<https://w3id.org/AIRO#EvaluatingPerformanceOfEmployee> a owl:Class ;
    rdfs:label "Evaluating Performance Of Employee"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AssessmentOfEmployee> .

<https://w3id.org/AIRO#EvaluatingReliabilityOfEvidence> a owl:Class ;
    rdfs:label "Evaluating Reliability Of Evidence"@en ;
    rdfs:comment "Refers to the evaluation of the reliability of evidence in the course of investigation or prosecution of criminal offences."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Assessment> .

<https://w3id.org/AIRO#ExpectedLifetime> a owl:Class ;
    rdfs:label "Expected Lifetime"@en ;
    rdfs:comment "Represents the expected lifetime of a system."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AISystemIndicator> .

<https://w3id.org/AIRO#FacialRecognition> a owl:Class ;
    rdfs:label "Facial Recognition"@en ;
    rdfs:comment "Automatic pattern recognition comparing stored images of human faces with the image of an actual face, indicating any matching, if it exists, and any data, if they exist, identifying the person to whom the face belongs [Source: ISO 5127:2017, 3.1.12.09]."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AIApplication> .

<https://w3id.org/AIRO#Firefighter> a owl:Class ;
    rdfs:label "Firefighter"@en ;
    rdfs:comment "A person who works as a firefighter."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AIUser> .

<https://w3id.org/AIRO#FundamentalRight> a owl:Class ;
    rdfs:label "Fundamental Right"@en ;
    rdfs:comment "Represents a right, freedom, or principle set out in the EU Charter of Fundamental Rights."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#AreaOfImpact> .

<https://w3id.org/AIRO#GeneratingAudioContent> a owl:Class ;
    rdfs:label "Generating Audio Content"@en ;
    rdfs:comment "Refers to manipulating or generating audio content."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#GeneratingContent> .

<https://w3id.org/AIRO#GeneratingImageContent> a owl:Class ;
    rdfs:label "Generating Image Content"@en ;
    rdfs:comment "Refers to manipulating or generating image content."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#GeneratingContent> .

<https://w3id.org/AIRO#GeneratingVideoContent> a owl:Class ;
    rdfs:label "Generating Video Content"@en ;
    rdfs:comment "Refers to manipulating or generating video content."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#GeneratingContent> .

<https://w3id.org/AIRO#GrantingPublicAssistanceServices> a owl:Class ;
    rdfs:label "Granting Public Assistance Services"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#MakingDecision> .

<https://w3id.org/AIRO#HarmonisedStandard> a owl:Class ;
    rdfs:label "Harmonised Standard"@en ;
    rdfs:comment "a European standard as defined in Article 2(1)(c) of Regulation (EU) No 1025/2012" ;
    rdfs:subClassOf <https://w3id.org/AIRO#Standard> .

<https://w3id.org/AIRO#HumanBehaviour> a owl:Class ;
    rdfs:label "Human Behaviour"@en ;
    rdfs:comment "Represents the way a person acts."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#HealthAndSafety> .

<https://w3id.org/AIRO#HumanOversightMeasure> a owl:Class ;
    rdfs:label "Human Oversight Measure"@en ;
    rdfs:comment "Represents measures for overseening the system by natural persons to detect, prevent or minimise risk."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#SemiAutomatedControl> .

<https://w3id.org/AIRO#IdentifyingUnkownPatternsOfCrime> a owl:Class ;
    rdfs:label "Identifying Unkown Patterns Of Crime"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#CrimeAnalytics> .

<https://w3id.org/AIRO#ImmigrationEligibilityAssessment> a owl:Class ;
    rdfs:label "Immigration Eligibility Assessment"@en ;
    rdfs:comment "Examination of applications for asylum, visa and residence permits and associated complaints"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Assessment> .

<https://w3id.org/AIRO#IncompetenceOfHumanOversightActors> a owl:Class ;
    rdfs:label "Incompetence Of Human Oversight Actors"@en ;
    rdfs:comment "Refers to incompentece of individuals to whom human oversight is assigned."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#OrganisationalRiskSource> .

<https://w3id.org/AIRO#IncompletenessOfTestingDataSet> a owl:Class ;
    rdfs:label "Incompleteness Of Testing Data Set"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#TestingDataRiskSource> .

<https://w3id.org/AIRO#IncompletenessOfTrainingDataSet> a owl:Class ;
    rdfs:label "Incompleteness Of Training Data Set"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#TrainingDataRiskSource> .

<https://w3id.org/AIRO#IncompletenessOfValidationDataSet> a owl:Class ;
    rdfs:label "Incompleteness Of Validation Data Set"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#ValidationDataRelatedSource> .

<https://w3id.org/AIRO#InductiveProgramming> a owl:Class ;
    rdfs:label "Inductive Programming"@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#KnowledgeBasedApproach> .

<https://w3id.org/AIRO#Injury> a owl:Class ;
    rdfs:label "Physical Injury"@en ;
    rdfs:comment "Represents physical injuries caused by AI."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#WellbeingImpact> .

<https://w3id.org/AIRO#InputData> a owl:Class ;
    rdfs:label "Input Data"@en ;
    rdfs:comment "Data for which an AI system calculates a predicted output or inference [Source: ISO/IEC FDIS 22989, 3.2.9]."@en ;
    rdfs:subClassOf <https://w3id.org/AIRO#Data> .

