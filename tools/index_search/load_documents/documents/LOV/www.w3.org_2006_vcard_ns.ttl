    rdfs:label "language"@en ;
    rdfs:comment "To specify the language that may be used for contacting the object. May also be used as a property parameter."@en ;
    rdfs:isDefinedBy onto: .

<http://www.w3.org/2006/vcard/ns#latitude> a owl:DatatypeProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "This data property has been deprecated. See hasGeo"@en ;
    rdfs:isDefinedBy onto: ;
    owl:deprecated true .

<http://www.w3.org/2006/vcard/ns#longitude> a owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "This data property has been deprecated. See hasGeo"@en ;
    rdfs:isDefinedBy onto: ;
    owl:deprecated true .

<http://www.w3.org/2006/vcard/ns#mailer> a owl:DatatypeProperty ;
    rdfs:label "mailer"@en ;
    rdfs:comment "This data property has been deprecated"@en ;
    rdfs:isDefinedBy onto: ;
    owl:deprecated true .

<http://www.w3.org/2006/vcard/ns#note> a owl:DatatypeProperty ;
    rdfs:label "note"@en ;
    rdfs:comment "A note associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#org> a owl:ObjectProperty ;
    rdfs:label "organization"@en ;
    rdfs:comment "This object property has been mapped. Use the organization-name data property."@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#organization-name> .

<http://www.w3.org/2006/vcard/ns#organization-unit> a owl:DatatypeProperty ;
    rdfs:label "organizational unit name"@en ;
    rdfs:comment "To specify the organizational unit name associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.w3.org/2006/vcard/ns#organization-name> .

<http://www.w3.org/2006/vcard/ns#post-office-box> a owl:DatatypeProperty ;
    rdfs:label "post office box"@en ;
    rdfs:comment "This data property has been deprecated"@en ;
    rdfs:isDefinedBy onto: ;
    owl:deprecated true .

<http://www.w3.org/2006/vcard/ns#prodid> a owl:DatatypeProperty ;
    rdfs:label "product id"@en ;
    rdfs:comment "To specify the identifier for the product that created the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#rev> a owl:DatatypeProperty ;
    rdfs:label "revision"@en ;
    rdfs:comment "To specify revision information about the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:dateTime .

<http://www.w3.org/2006/vcard/ns#role> a owl:DatatypeProperty ;
    rdfs:label "role"@en ;
    rdfs:comment "To specify the function or part played in a particular situation by the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#sort-string> a owl:DatatypeProperty ;
    rdfs:label "sort as"@en ;
    rdfs:comment "To specify the string to be used for national-language-specific sorting. Used as a property parameter only."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#title> a owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    rdfs:comment "To specify the position or job of the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#tz> a owl:DatatypeProperty ;
    rdfs:label "time zone"@en ;
    rdfs:comment "To indicate time zone information that is specific to the object. May also be used as a property parameter."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#value> a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "Used to indicate the literal value of a data property that requires property parameters"@en ;
    rdfs:isDefinedBy onto: .

<http://www.w3.org/2006/vcard/ns#Address> a owl:Class ;
    rdfs:label "Address"@en ;
    rdfs:comment "To specify the components of the delivery address for the  object"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#country-name> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#country-name> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#locality> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#locality> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#postal-code> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#postal-code> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#region> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#region> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#street-address> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#street-address> ] ) ] ) ] .

<http://www.w3.org/2006/vcard/ns#Email> a owl:Class ;
    rdfs:label "Email"@en ;
    rdfs:comment "To specify the electronic mail address for communication with the object the vCard represents. Use the hasEmail object property."@en ;
    rdfs:isDefinedBy onto: ;
    owl:deprecated true .

<http://www.w3.org/2006/vcard/ns#Group> a owl:Class ;
    rdfs:label "Group"@en ;
    rdfs:comment "Object representing a group of persons or entities.  A group object will usually contain hasMember properties to specify the members of the group."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Kind> ;
    owl:disjointWith <http://www.w3.org/2006/vcard/ns#Individual>,
        <http://www.w3.org/2006/vcard/ns#Location>,
        <http://www.w3.org/2006/vcard/ns#Organization> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#hasMember> ;
                        owl:someValuesFrom <http://www.w3.org/2006/vcard/ns#Kind> ] [ a owl:Restriction ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass <http://www.w3.org/2006/vcard/ns#Kind> ;
                        owl:onProperty <http://www.w3.org/2006/vcard/ns#hasMember> ] ) ] .

<http://www.w3.org/2006/vcard/ns#Individual> a owl:Class ;
    rdfs:label "Individual"@en ;
    rdfs:comment "An object representing a single person or entity"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Kind> ;
    owl:disjointWith <http://www.w3.org/2006/vcard/ns#Location>,
        <http://www.w3.org/2006/vcard/ns#Organization> .

<http://www.w3.org/2006/vcard/ns#Name> a owl:Class ;
    rdfs:label "Name"@en ;
    rdfs:comment "To specify the components of the name of the object"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#additional-name> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#additional-name> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#family-name> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#family-name> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#given-name> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#given-name> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorific-prefix> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorific-prefix> ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorific-suffix> ;
                                    owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty <http://www.w3.org/2006/vcard/ns#honorific-suffix> ] ) ] ) ] .

<http://www.w3.org/2006/vcard/ns#VCard> a owl:Class ;
    rdfs:label "VCard"@en ;
    rdfs:comment "The vCard class is  equivalent to the new Kind class, which is the parent for the four explicit types of vCards (Individual, Organization, Location, Group)"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass <http://www.w3.org/2006/vcard/ns#Kind> .

<http://www.w3.org/2006/vcard/ns#fn> a owl:DatatypeProperty ;
    rdfs:label "formatted name"@en ;
    rdfs:comment "The formatted text corresponding to the name of the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#hasAddress> a owl:ObjectProperty ;
    rdfs:label "has address"@en ;
    rdfs:comment "To specify the components of the delivery address for the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Address> .

<http://www.w3.org/2006/vcard/ns#hasEmail> a owl:ObjectProperty ;
    rdfs:label "has email"@en ;
    rdfs:comment "To specify the electronic mail address for communication with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Email> .

<http://www.w3.org/2006/vcard/ns#hasGeo> a owl:ObjectProperty ;
    rdfs:label "has geo"@en ;
    rdfs:comment "To specify information related to the global positioning of the object. May also be used as a property parameter."@en ;
    rdfs:isDefinedBy onto: .

<http://www.w3.org/2006/vcard/ns#hasKey> a owl:ObjectProperty ;
    rdfs:label "has key"@en ;
    rdfs:comment "To specify a public key or authentication certificate associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#key> .

<http://www.w3.org/2006/vcard/ns#hasLogo> a owl:ObjectProperty ;
    rdfs:label "has logo"@en ;
    rdfs:comment "To specify a graphic image of a logo associated with the object "@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#logo> .

<http://www.w3.org/2006/vcard/ns#hasName> a owl:ObjectProperty ;
    rdfs:label "has name"@en ;
    rdfs:comment "To specify the components of the name of the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Name> ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#n> .

<http://www.w3.org/2006/vcard/ns#hasPhoto> a owl:ObjectProperty ;
    rdfs:label "has photo"@en ;
    rdfs:comment "To specify an image or photograph information that annotates some aspect of the object"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#photo> .

<http://www.w3.org/2006/vcard/ns#hasSound> a owl:ObjectProperty ;
    rdfs:label "has sound"@en ;
    rdfs:comment "To specify a digital sound content information that annotates some aspect of the object"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#sound> .

<http://www.w3.org/2006/vcard/ns#hasTelephone> a owl:ObjectProperty ;
    rdfs:label "has telephone"@en ;
    rdfs:comment "To specify the telephone number for telephony communication with the object"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#tel> .

<http://www.w3.org/2006/vcard/ns#hasURL> a owl:ObjectProperty ;
    rdfs:label "has url"@en ;
    rdfs:comment "To specify a uniform resource locator associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#url> .

<http://www.w3.org/2006/vcard/ns#key> a owl:ObjectProperty ;
    rdfs:label "key"@en ;
    rdfs:comment "This object property has been mapped"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#hasKey> .

<http://www.w3.org/2006/vcard/ns#logo> a owl:ObjectProperty ;
    rdfs:label "logo"@en ;
    rdfs:comment "This object property has been mapped"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#hasLogo> .

<http://www.w3.org/2006/vcard/ns#n> a owl:ObjectProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "This object property has been mapped"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#hasName> .

<http://www.w3.org/2006/vcard/ns#nickname> a owl:DatatypeProperty ;
    rdfs:label "nickname"@en ;
    rdfs:comment "The nick name associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#photo> a owl:ObjectProperty ;
    rdfs:label "photo"@en ;
    rdfs:comment "This object property has been mapped"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#hasPhoto> .

<http://www.w3.org/2006/vcard/ns#sound> a owl:ObjectProperty ;
    rdfs:label "sound"@en ;
    rdfs:comment "This object property has been mapped"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#hasSound> .

<http://www.w3.org/2006/vcard/ns#tel> a owl:ObjectProperty ;
    rdfs:label "telephone"@en ;
    rdfs:comment "This object property has been mapped"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#hasTelephone> .

<http://www.w3.org/2006/vcard/ns#url> a owl:ObjectProperty ;
    rdfs:label "url"@en ;
    rdfs:comment "This object property has been mapped"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentProperty <http://www.w3.org/2006/vcard/ns#hasURL> .

<http://www.w3.org/2006/vcard/ns#Location> a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "An object representing a named geographical place"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Kind> ;
    owl:disjointWith <http://www.w3.org/2006/vcard/ns#Organization> .

<http://www.w3.org/2006/vcard/ns#additional-name> a owl:DatatypeProperty ;
    rdfs:label "additional name"@en ;
    rdfs:comment "The additional name associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#country-name> a owl:DatatypeProperty ;
    rdfs:label "country name"@en ;
    rdfs:comment "The country name associated with the address of the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#family-name> a owl:DatatypeProperty ;
    rdfs:label "family name"@en ;
    rdfs:comment "The family name associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#given-name> a owl:DatatypeProperty ;
    rdfs:label "given name"@en ;
    rdfs:comment "The given name associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#hasMember> a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:comment "To include a member in the group this object represents. (This property can only be used by Group individuals)"@en ;
    rdfs:domain <http://www.w3.org/2006/vcard/ns#Group> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Kind> .

<http://www.w3.org/2006/vcard/ns#honorific-prefix> a owl:DatatypeProperty ;
    rdfs:label "honorific prefix"@en ;
    rdfs:comment "The honorific prefix of the name associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#honorific-suffix> a owl:DatatypeProperty ;
    rdfs:label "honorific suffix"@en ;
    rdfs:comment "The honorific suffix of the name associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#locality> a owl:DatatypeProperty ;
    rdfs:label "locality"@en ;
    rdfs:comment "The locality (e.g. city or town) associated with the address of the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#organization-name> a owl:DatatypeProperty ;
    rdfs:label "organization name"@en ;
    rdfs:comment "To specify the organizational name associated with the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#postal-code> a owl:DatatypeProperty ;
    rdfs:label "postal code"@en ;
    rdfs:comment "The postal code associated with the address of the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#region> a owl:DatatypeProperty ;
    rdfs:label "region"@en ;
    rdfs:comment "The region (e.g. state or province) associated with the address of the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#street-address> a owl:DatatypeProperty ;
    rdfs:label "street address"@en ;
    rdfs:comment "The street address associated with the address of the object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://www.w3.org/2006/vcard/ns#Organization> a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "An object representing an organization.  An organization is a single entity, and might represent a business or government, a department or division within a business or government, a club, an association, or the like.\\n"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.w3.org/2006/vcard/ns#Kind> .

<http://www.w3.org/2006/vcard/ns#Gender> a owl:Class ;
    rdfs:label "Gender"@en ;
    rdfs:comment "Used for gender codes. The URI of the gender code must be used as the value for Gender."@en ;
    rdfs:isDefinedBy onto: .

<http://www.w3.org/2006/vcard/ns#Kind> a owl:Class ;
    rdfs:label "Kind"@en ;
    rdfs:comment "The parent class for all objects"@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://www.w3.org/2006/vcard/ns#fn> ],
        <http://www.w3.org/2006/vcard/ns#VCard> .

<http://www.w3.org/2006/vcard/ns#Type> a owl:Class ;
    rdfs:label "Type"@en ;
    rdfs:comment "Used for type codes. The URI of the type code must be used as the value for Type."@en ;
    rdfs:isDefinedBy onto: .

<http://www.w3.org/2006/vcard/ns#TelephoneType> a owl:Class ;
    rdfs:label "Phone"@en ;
    rdfs:comment "Used for telephone type codes. The URI of the telephone type code must be used as the value for the Telephone Type."@en ;
    rdfs:isDefinedBy onto: .

<http://www.w3.org/2006/vcard/ns#RelatedType> a owl:Class ;
    rdfs:label "Relation Type"@en ;
    rdfs:comment "Used for relation type codes. The URI of the relation type code must be used as the value for the Relation Type."@en ;
    rdfs:isDefinedBy onto: .

onto: a owl:Ontology ;
    rdfs:label "Ontology for vCard"@en ;
    rdfs:comment "Ontology for vCard based on RFC6350"@en ;
    owl:versionInfo "Final"@en .

