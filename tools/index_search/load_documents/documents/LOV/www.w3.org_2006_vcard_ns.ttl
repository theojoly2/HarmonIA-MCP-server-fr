    rdfs:label "has language"@en ;
    rdfs:comment "Used to support property parameters for the language data property"@en ;
    rdfs:isDefinedBy onto: .

<http://www.w3.org/2006/vcard/ns#hasLocality> a owl:ObjectProperty ;
