@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://purl.org/voc/summa/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:description a owl:DatatypeProperty .

dcterms:modified a owl:DatatypeProperty .

dcterms:title a owl:DatatypeProperty .

onto:entity a owl:ObjectProperty ;
    rdfs:label "entity"@en ;
    rdfs:domain onto:Summary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Resource .

onto:fixedProperty a owl:ObjectProperty ;
    rdfs:label "fixed property"@en ;
    rdfs:domain onto:Summary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:Property .

onto:group a owl:ObjectProperty ;
    rdfs:label "group"@en ;
    rdfs:domain rdf:Statement ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SummaryGroup .

onto:language a owl:DatatypeProperty ;
    rdfs:label "langauge"@en ;
    rdfs:domain onto:Summary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:maxHops a owl:DatatypeProperty ;
    rdfs:label "maximum number of hops"@en ;
    rdfs:domain onto:Summary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:positiveInteger .

onto:path a owl:ObjectProperty ;
    rdfs:label "path"@en ;
    rdfs:domain rdf:Statement ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:Statement .

onto:statement a owl:ObjectProperty ;
    rdfs:label "statement"@en ;
    rdfs:domain onto:Summary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:Statement .

onto:topK a owl:DatatypeProperty ;
    rdfs:label "top k"@en ;
    rdfs:domain onto:Summary ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:positiveInteger .

vann:preferredNamespacePrefix a owl:DatatypeProperty .

vann:preferredNamespaceUri a owl:DatatypeProperty .

onto:SummaryGroup a owl:Class ;
    rdfs:label "summary group"@en ;
    rdfs:isDefinedBy onto: .

onto:Summary a owl:Class ;
    rdfs:label "summary"@en ;
    rdfs:isDefinedBy onto: .

onto: a owl:Ontology ;
    rdfs:label "summa" ;
    dcterms:description "The SUMMA Vocabulary enables to request and represent summarized RDf resources. It should be used in context to the SUMMA API definition."@en ;
    dcterms:modified "2015-04-11"^^xsd:date ;
    dcterms:title "SUMMA Vocabulary"@en ;
    vann:preferredNamespacePrefix "summa" ;
    vann:preferredNamespaceUri "http://purl.org/voc/summa/" ;
    rdfs:seeAlso onto: ;
    owl:versionInfo "v0.1" .

