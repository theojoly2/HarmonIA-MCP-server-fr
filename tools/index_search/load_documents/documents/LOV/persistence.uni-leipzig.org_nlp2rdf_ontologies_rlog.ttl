@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "RLOG - an RDF Logging Ontology"@en ;
    dc:contributor "TODO" ;
    dc:creator "Sebastian Hellmann" ;
    dc:description "We built this ontology by looking at log4j version 1.2 and version 2 beta: http://logging.apache.org/log4j/2.x/manual/layouts.html, http://logging.apache.org/log4j/1.2/apidocs/org/apache/log4j/PatternLayout.html \\r\\n\\tIs this complete? No! But it will be sufficient for most use cases, please feel free to extend and adapt the ontology, if you need more. \\r\\n    Loglevels: TRACE, DEBUG, INFO, WARN, ERROR and FATAL\\r\\n    \\r\\n    Feedback\\r\\n\\tIf you'd like to leave feedback, please open an issue on GitHub (https://github.com/NLP2RDF/ontologies/issues) and read the README (https://github.com/NLP2RDF/ontologies#readme) or write an email to the mailing list: http://lists.informatik.uni-leipzig.de/mailman/listinfo/nlp2rdf\\r\\n\\r\\n\\tVersioning process is explained here: http://persistence.uni-leipzig.org/nlp2rdf/specification/version.html\\r\\n    \\r\\n    Changelog:\\r\\n    * 1.0.0 initial version\\r\\n    * 1.0.1 added Error Code class and errcode property\\r\\n    * 1.1.0 change Error Code class to Status Code\\r\\n    "@en ;
    dc:publisher "AKSW, University Leipzig" ;
    dc:rights "This ontology is licensed under Apache 2.0 (http://www.apache.org/licenses/LICENSE-2.0) and CC-BY (http://creativecommons.org/licenses/by/3.0/)"@en ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/>,
        <http://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:title "RLOG - an RDF Logging Ontology"@en ;
    vann:changes <https://github.com/NLP2RDF/persistence.uni-leipzig.org/commits/master/ontologies/rlog> ;
    vann:preferredNamespacePrefix "rlog" ;
    vann:preferredNamespaceUri "http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#" ;
    rdfs:comment "This is a helper ontology for NIF 2.0 to be able to log errors and warning messages."@en ;
    owl:versionIRI <https://github.com/NLP2RDF/ontologies/blob/master/rlog/rlog.ttl> ;
    owl:versionInfo "1.1.0" .

onto:ALL a onto:Level,
        owl:NamedIndividual ;
    rdfs:label "ALL"@en ;
    onto:priority "0"^^xsd:int ;
    rdfs:comment "The ALL has the lowest possible rank and is intended to turn on all logging."@en .

onto:DEBUG a onto:Level,
        owl:NamedIndividual ;
    rdfs:label "DEBUG"@en ;
    onto:priority "2"^^xsd:int ;
    rdfs:comment "The DEBUG Level designates fine-grained informational events that are most useful to debug an application."@en .

onto:ERROR a onto:Level,
        owl:NamedIndividual ;
    rdfs:label "ERROR"@en ;
    onto:priority "5"^^xsd:int ;
    rdfs:comment "The ERROR level designates error events that might still allow the application to continue running."@en .

onto:FATAL a onto:Level,
        owl:NamedIndividual ;
    rdfs:label "FATAL"@en ;
    onto:priority "6"^^xsd:int ;
    rdfs:comment "The FATAL level designates very severe error events that will presumably lead the application to abort."@en .

onto:OFF a onto:Level,
        owl:NamedIndividual ;
    rdfs:label "OFF"@en ;
    onto:priority "7"^^xsd:int ;
    rdfs:comment "The OFF has the highest possible rank and is intended to turn off logging."@en .

onto:TRACE a onto:Level,
        owl:NamedIndividual ;
    rdfs:label "TRACE"@en ;
    onto:priority "1"^^xsd:int ;
    rdfs:comment "The TRACE Level designates finer-grained informational events than the DEBUG."@en .

onto:WARN a onto:Level,
        owl:NamedIndividual ;
    rdfs:label "WARN"@en ;
    onto:priority "4"^^xsd:int ;
    rdfs:comment "The WARN level designates potentially harmful situations."@en .

onto:className a owl:DatatypeProperty ;
    rdfs:label "class name"@en ;
    rdfs:comment "Outputs the fully qualified class name of the caller issuing the logging request."@en ;
    rdfs:domain onto:Entry .

onto:codeId a owl:DatatypeProperty ;
    rdfs:label "code id"@en ;
    rdfs:comment "The numerical value of the code, e.g. 200, 404 or 42."@en ;
    rdfs:domain onto:StatusCode .

onto:date a owl:DatatypeProperty ;
    rdfs:label "Logging datetime (or just date)"@en ;
    rdfs:domain onto:Entry ;
    rdfs:range xsd:dateTime .

onto:hasCode a owl:ObjectProperty ;
    rdfs:label "has code"@en ;
    rdfs:comment "Links a log message to a status code."@en ;
    rdfs:domain onto:Entry ;
    rdfs:range onto:StatusCode .

onto:level a owl:ObjectProperty ;
    rdfs:label "logLevel"@en ;
    rdfs:domain onto:Entry ;
    rdfs:range onto:Level .

onto:message a owl:DatatypeProperty ;
    rdfs:label "Logging message"@en ;
    rdfs:domain onto:Entry .

onto:mylog1 a onto:Entry ;
    onto:className "org.nlp2rdf.core.SPARQLValidator" ;
    onto:date "2013-06-08T17:00:00+00:00"^^xsd:dateTime ;
    onto:level onto:INFO ;
    onto:message "Example log message, put whatever you want."@en ;
    onto:resource <http://example.org/aResourceRelatedToThisLogEntry> .

onto:priority a owl:DatatypeProperty ;
    rdfs:label "logLevel"@en ;
    rdfs:comment "Attention: the ids here can change, they are just used to define an order over the levels!"@en ;
    rdfs:domain onto:Level ;
    rdfs:range xsd:int .

onto:resource a owl:ObjectProperty ;
    rdfs:label "an associated resource"@en ;
    rdfs:comment "If we mix normal and log output, this can be used to refer to the resource in the RDF the error is connected to. "@en ;
    rdfs:domain onto:Entry .

onto:INFO a onto:Level,
        owl:NamedIndividual ;
    rdfs:label "INFO"@en ;
    onto:priority "3"^^xsd:int ;
    rdfs:comment "The INFO level designates informational messages that highlight the progress of the application at coarse-grained level."@en .

onto:StatusCode a owl:Class ;
    rdfs:label "Status Code"@en ;
    rdfs:comment "A status code which can occur in an application. Instances of this class must put the name of the status as rdfs:label and describe it with rdfs:comment."@en .

onto:Entry a owl:Class ;
    rdfs:label "Log Entry"@en ;
    rdfs:comment "An entry in a log."@en .

onto:Level a owl:Class ;
    rdfs:label "Log Level"@en ;
    rdfs:comment "look here: http://logging.apache.org/log4j/1.2/apidocs/org/apache/log4j/Level.html "@en .

