@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

schema:DataType a rdfs:Class ;
    rdfs:label "Data Type"@en ;
    rdfs:comment "Encompasses basic data types for typing literals."@en ;
    rdfs:isDefinedBy schema: .

schema:Date a rdfs:Class ;
    rdfs:label "Date"@en ;
    rdfs:comment "General class for all literals indicating a data."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:DataType .

schema:DateTime a rdfs:Class ;
    rdfs:label "Date and Time"@en ;
    rdfs:comment "General class for all literals indicating a data and a time."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:DataType .

schema:Text a rdfs:Class ;
    rdfs:label "Text"@en ;
    rdfs:comment "General class for all literals being of any textual Datatype."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:DataType .

schema:URL a rdfs:Class ;
    rdfs:label "URL"@en ;
    rdfs:comment "General class for all literals being an URL."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:Text .

<https://bmake.th-brandenburg.de/spv#Critique> a owl:Class ;
    rdfs:label "Critique"@en ;
    rdfs:comment "Unformalized list of critical issues observed in an analyzed scientific paper."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:subClassOf schema:ItemList ;
    ns1:term_status "stable" .

<https://bmake.th-brandenburg.de/spv#FutureWork> a owl:Class ;
    rdfs:label "Future Work"@en ;
    rdfs:comment "Unformalized list of future work announced in an analyzed scientific paper."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:subClassOf schema:ItemList ;
    ns1:term_status "stable" .

<https://bmake.th-brandenburg.de/spv#ResActTypeAnalyze> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "analyze"@en ;
    rdfs:comment "examine something systematically and in detail"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeCollect> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "collect"@en ;
    rdfs:comment "collect all parts or aspects of a complex object"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeConceptualize> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "conceptualize"@en ;
    rdfs:comment "define the essential terms (concepts) and relations of a domain"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeConstruct> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "construct"@en ;
    rdfs:comment "create something according to certain design or architectural principles"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeDefine> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "define"@en ;
    rdfs:comment "unambiguously describe or explain a concept"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeDesign> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "design"@en ;
    rdfs:comment "basically design an object, mostly according to appropriate design principles"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> .

<https://bmake.th-brandenburg.de/spv#ResActTypeDevelop> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "develop"@en ;
    rdfs:comment "create something new, mostly using specialist methods and tools"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeElicit> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "elicit"@en ;
    rdfs:comment "capture characteristics of objects under examination (eg by measurement)"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeEnhance> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "enhance"@en ;
    rdfs:comment "improve an object in certain features or aspects"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeEvaluate> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "evaluate"@en ;
    rdfs:comment "assess a quantitative or qualitative property of an object"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeExtend> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "extend"@en ;
    rdfs:comment "extend an object by properties or in its scope of functions or services"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeExtract> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "extract"@en ;
    rdfs:comment "separate defined parts of a complex object and provide them in a suitable form"@en ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeImplement> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "implement"@en ;
    rdfs:comment "implement a designed object technically"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeIntegrate> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "integrate"@en ;
    rdfs:comment "merge several objects into a single unit"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeProve> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "prove"@en ;
    rdfs:comment "investigate how an object meets certain requirements; whether a statement (about an object) is true"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeProvide> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "provide"@en ;
    rdfs:comment "provide an object in a suitable manner for use"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResActTypeStructure> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    rdfs:label "structure"@en ;
    rdfs:comment "systematically organize parts, aspects or the like of a complex object"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactApplication> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Application"@en ;
    rdfs:comment "software artifact with a certain range of functions"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactBlueprint> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Blueprint"@en ;
    rdfs:comment "model or technical design of an object"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactBusinessProcess> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Business Process"@en ;
    rdfs:comment "set of interacting and interdependent activities that converts input to output"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactDevFramework> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Development Framework"@en ;
    rdfs:comment "complex (technical) environment for the development of applications and IT systems"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactDocumentation> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Documentation"@en ;
    rdfs:comment "technical, formal or semi-formal description of an object and the circumstances of its development or function"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactITSystem> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "IT System"@en ;
    rdfs:comment "complex object of information technology whose parts interact and form a desing-related and functional whole"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactInfrastructure> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "IT Infrastructure"@en ;
    rdfs:comment "a combined set of hardware, software, networks, facilities, etc. (including all of the information technology), in order to develop, test, deliver, monitor, control or support IT services"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactLinkedData> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Linked Data"@en ;
    rdfs:comment "standard-based, structured data, mostly based on the Semantic Web stack"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactMethod> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Method"@en ;
    rdfs:comment "prescription of procedures or activities which is aimed at a specific result under appropriate conditions"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactModelingLanguage> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Modeling Language"@en ;
    rdfs:comment "collection of syntactic rules (grammar) and semantic specifications for representing objects of a particular domain"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactNLPArtifact> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "NLP Artifact"@en ;
    rdfs:comment "result of a process of manipulation of natural language objects"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactOntology> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Ontology"@en ;
    rdfs:comment "semantic network of different configuration stages; up to formally specified conceptualizations of a domain"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactPolicy> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Policy"@en ;
    rdfs:comment "basic precepts in a particular field of action"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactRequirements> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Requirements"@en ;
    rdfs:comment "characteristics or features of an object required by potential users"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactStandard> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Standard, Guideline"@en ;
    rdfs:comment "specific reference or prescription for actions in a particular field of action"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactSystem> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "System"@en ;
    rdfs:comment "complex object whose parts interact and form a desing-related and functional whole"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactTermDefinition> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Term Definition"@en ;
    rdfs:comment "Unambiguously described or explained technical or business term"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResArtifactWorkflow> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    rdfs:label "Workflow"@en ;
    rdfs:comment "clearly specified sequence of activities to achieve a desired target state"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "testing" .

<https://bmake.th-brandenburg.de/spv#ResMethActionResearch> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Action Research (Wilde/Hess)"@en ;
    rdfs:comment "Solving a practice problem by a mixed group of scientists and practical experts. Several cycles of analysis, action and evaluation steps, each with a low level of structured instruments such as group discussions or planning games, are conducted."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethArgumentDedAnalysis> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Argumentative Deductive Analysis (Wilde/Hess)"@en ;
    rdfs:comment "Pure-language logical-deductive inferencing (as, for example, in philosophy)"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethCaseStudy> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Case Study (Wilde/Hess)"@en ;
    rdfs:comment "The case study usually examines complex, difficult-to-distinguish phenomena in their natural context. It represents a special form of the qualitative-empirical methodology, which is investigated intensively by a few feature-bearers. It is either the objective examination of theses (behavioral approach) or the interpretation of behavioral patterns as the phenotypes of the realities constructed by the subjects (construction-oriented access)."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethConceptualDedAnalysis> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Conceptual Deductive Analysis (Wilde/Hess)"@en ;
    rdfs:comment "Logic-deductive inferencing using semiformal models"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethDesignScience> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Design Science (Hevner)"@en ;
    rdfs:comment "Design Science is an outcome-based information technology research methodology, which offers specific guidelines for evaluation and iteration within research projects."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/978-1-4419-5653-8_2" .

<https://bmake.th-brandenburg.de/spv#ResMethEthnography> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Ethnography (Wilde/Hess)"@en ;
    rdfs:comment "Ethnography would like to generate insights through participatory observation. The difference to the case study lies in the very high extent in which the researcher is integrated into the investigated social environment. There is a very small objective distance."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethFieldExperiment> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Field Experiment (Wilde/Hess)"@en ;
    rdfs:comment "The field experiment investigates causal relationships in a controlled environment by manipulating an experimental variable in a repeatable manner and measuring the effect of manipulation. The object to be investigated is examined in its natural environment (in the 'field'), whereby the possibilities of environmental control are significantly influenced."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z>" .

<https://bmake.th-brandenburg.de/spv#ResMethFormalDedAnalysis> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Formal Deductive Analysis (Wilde/Hess)"@en ;
    rdfs:comment "Logic-deductive inferencing using mathematical-formal models"@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethGroundedTheory> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Grounded Theory (Wilde/Hess)"@en ;
    rdfs:comment "The Grounded Theory aims at the inductive acquisition of new theories by intensive observation of the object of investigation in the field. The various procedures for coding and evaluating the predominantly qualitative data are precisely specified."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethLabExperiment> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Laboratory Experiment (Wilde/Hess)"@en ;
    rdfs:comment "The laboratory experiment investigates causal relationships in a controlled environment by manipulating an experimental variable in a repetitive manner and measuring the effect of manipulation. The object to be investigated is examined in an artificial environment (in the 'laboratory'), whereby the possibilities of environmental control are significantly influenced."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethLiteratureAnalysis> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Literature Analysis (Machi/McEvoy)"@en ;
    rdfs:comment "A literature review is a written document that presents a logically argued case founded on a comprehensive understanding of the current state of knowledge about a topic of study. This case establishes a convincing thesis to answer the study’s question."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "https://lccn.loc.gov/2015048510" .

<https://bmake.th-brandenburg.de/spv#ResMethPrototyping> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Prototyping (Wilde/Hess)"@en ;
    rdfs:comment "A preliminary version of an application system is developed and evaluated. Both steps can generate new insights."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z>" .

<https://bmake.th-brandenburg.de/spv#ResMethQualitativeResearch> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Qualitative Research (Wilde/Hess)"@en ;
    rdfs:comment "This method integrates survey techniques such as questionnaires, interviews, Delphi method, content analyzes, etc. into an aggregate. It comprises a one-time survey over several individuals, which is subsequently coded and evaluated qualitatively. The result is a cross-section profile characteristic for the sample participants, which usually allows conclusions to be drawn on the total population."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethQuantitativeResearch> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Quantitative Research (Wilde/Hess)"@en ;
    rdfs:comment "This method integrates survey techniques such as questionnaires, interviews, Delphi method, content analyzes, etc. into an aggregate. It comprises a one-time survey over several individuals, which is subsequently coded and evaluated quantatively. The result is a cross-section profile characteristic for the sample participants, which usually allows conclusions to be drawn on the total population."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethReferenceModeling> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Reference Modeling (Wilde/Hess)"@en ;
    rdfs:comment "The reference modeling produces inductively (out of observations) or deductively (eg from theories or models) mostly simplified and optimized projections (ideal concepts) of systems, in order to deepen existing knowledge and generate design templates from this."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResMethSimulation> a owl:NamedIndividual,
        <https://bmake.th-brandenburg.de/spv#ResearchMethod> ;
    rdfs:label "Simulation (Wilde/Hess)"@en ;
    rdfs:comment "The simulation models the behavior of the system to be investigated formally and compares environmental conditions with certain assignments of the model parameters. Both the model construction and the observation of the endogenous model parameters allow to gain insights."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    ns1:term_status "stable" ;
    schema:url "http://doi.org/10.1007/s11576-007-0064-z" .

<https://bmake.th-brandenburg.de/spv#ResearchFindings> a owl:Class ;
    rdfs:label "Research Findings"@en ;
    rdfs:comment "Unformalized list of research findings documented in an analyzed scientific paper."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:subClassOf schema:ItemList ;
    ns1:term_status "stable" .

<https://bmake.th-brandenburg.de/spv#ResearchMethods> a owl:Class ;
    rdfs:label "Research Methods"@en ;
    rdfs:comment "List of formalized research methods applied in an analyzed scientific paper."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:subClassOf schema:ItemList ;
    ns1:term_status "stable" .

<https://bmake.th-brandenburg.de/spv#ResearchObjectives> a owl:Class ;
    rdfs:label "Research Objectives"@en ;
    rdfs:comment "List of formalized research objectives targeted in an analyzed scientific paper."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:subClassOf schema:ItemList ;
    ns1:term_status "stable" .

<https://bmake.th-brandenburg.de/spv#researchActionType> a owl:ObjectProperty ;
    rdfs:label "research action type"@en ;
    rdfs:comment "Is used in combination with research action type to indicate a research objective of a scientific paper."@en ;
    rdfs:domain <https://bmake.th-brandenburg.de/spv#ResearchObjective> ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:range <https://bmake.th-brandenburg.de/spv#ResearchActionType> ;
    ns1:term_status "stable" .

<https://bmake.th-brandenburg.de/spv#researchArtifact> a owl:ObjectProperty ;
    rdfs:label "research artifact"@en ;
    rdfs:comment "Is used in combination with research action type to indicate a research objective of a scientific paper."@en ;
    rdfs:domain <https://bmake.th-brandenburg.de/spv#ResearchObjective> ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:range <https://bmake.th-brandenburg.de/spv#ResearchArtifact> ;
    ns1:term_status "stable" .

schema:about a owl:ObjectProperty ;
    rdfs:label "about"@en ;
    rdfs:comment "Is used to relate to subject matters of a creative work, mainly a scientific paper. Here mainly used to relate to blank or abstract nodes of type schema:ItemList for specifying lists of characteristics of a scientific paper, like research findings, research methods and research objectives."@en ;
    rdfs:domain schema:CreativeWork ;
    rdfs:isDefinedBy schema: ;
    rdfs:range owl:Thing .

schema:additionalName a owl:DatatypeProperty ;
    rdfs:label "additional name"@en ;
    rdfs:comment "The additional name for person, can be used for a middle name."@en ;
    rdfs:domain schema:Person ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:affiliation a owl:ObjectProperty ;
    rdfs:label "affiliation"@en ;
    rdfs:comment "Is used to indicate the affiliation of a person to an organization."@en ;
    rdfs:domain schema:Person ;
    rdfs:range schema:Organization .

schema:alternateName a owl:DatatypeProperty ;
    rdfs:label "alternative name"@en ;
    rdfs:comment "General datatype property, potentially usable for specifying alternative names of a resource."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:alternativeHeadline a owl:DatatypeProperty ;
    rdfs:label "alternative headline"@en ;
    rdfs:comment "A secondary title of a scientific paper."@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:attendee a owl:ObjectProperty ;
    rdfs:label "attendee"@en ;
    rdfs:comment "Is used to indicate a person attending a conference."@en ;
    rdfs:domain schema:PublicationEvent ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Person .

schema:author a owl:ObjectProperty ;
    rdfs:label "author"@en ;
    rdfs:comment "Is used to indicate a author of a scientific paper."@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Person .

schema:award a owl:DatatypeProperty ;
    rdfs:label "award"@en ;
    rdfs:comment "An award won by or for this scientific paper."@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:citation a owl:ObjectProperty ;
    rdfs:label "citation"@en ;
    rdfs:comment "Is used to create references of a scientific paper to other items of creative work (particularly other papers)."@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:isDefinedBy schema: ;
    rdfs:range xsd:string .

schema:contributor a owl:ObjectProperty ;
    rdfs:label "contributor"@en ;
    rdfs:comment "Is used to indicate a person contributing to a conference."@en ;
    rdfs:domain schema:PublicationEvent ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Person .

schema:dateCreated a owl:DatatypeProperty ;
    rdfs:label "date created"@en ;
    rdfs:comment "The date on which the CreativeWork was created or the item was added to a DataFeed."@en ;
    rdfs:domain schema:CreativeWork ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Date .

schema:dateModified a owl:DatatypeProperty ;
    rdfs:label "date modified"@en ;
    rdfs:comment "The date on which the CreativeWork was modified or the item's entry was modified within a DataFeed."@en ;
    rdfs:domain schema:CreativeWork ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Date .

schema:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "General datatype property, potentially usable for description of all resources."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:editor a owl:ObjectProperty ;
    rdfs:label "editor"@en ;
    rdfs:comment "Is used to indicate an editor of a scientific paper or conference proceedings."@en ;
    rdfs:domain schema:CreativeWork ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Person .

schema:email a owl:DatatypeProperty ;
    rdfs:label "email"@en ;
    rdfs:comment "Email address of a person or an organization."@en ;
    rdfs:domain [ owl:unionOf ( schema:Person schema:Organization ) ] ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:endTime a owl:DatatypeProperty ;
    rdfs:label "end time"@en ;
    rdfs:comment "The end time of some event."@en ;
    rdfs:domain schema:Event ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:DateTime .

schema:familyName a owl:DatatypeProperty ;
    rdfs:label "family name"@en ;
    rdfs:comment "The last name of a person."@en ;
    rdfs:domain schema:Person ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:faxNumber a owl:DatatypeProperty ;
    rdfs:label "fax number"@en ;
    rdfs:comment "Fax number of a person or an organization."@en ;
    rdfs:domain [ owl:unionOf ( schema:Person schema:Organization ) ] ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:givenName a owl:DatatypeProperty ;
    rdfs:label "given name"@en ;
    rdfs:comment "The first name of a person."@en ;
    rdfs:domain schema:Person ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:headline a owl:DatatypeProperty ;
    rdfs:label "headline"@en ;
    rdfs:comment "Headline or title of a scientific paper."@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:honoricPrefix a owl:DatatypeProperty ;
    rdfs:label "honoric prefix"@en ;
    rdfs:comment "An honorific prefix preceding a person's name such as Dr/Mrs/Mr."@en ;
    rdfs:domain schema:Person ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:honoricSuffix a owl:DatatypeProperty ;
    rdfs:label "honoric suffix"@en ;
    rdfs:comment "An honorific suffix preceding a person's name such as M.D. /PhD/MSCSW."@en ;
    rdfs:domain schema:Person ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:image a owl:DatatypeProperty ;
    rdfs:label "image"@en ;
    rdfs:comment "General datatype property, potentially usable for relating an image of a resource."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:URL .

schema:inLanguage a owl:DatatypeProperty ;
    rdfs:label "in language"@en ;
    rdfs:comment "The language of the content or performance or used in an event."@en ;
    rdfs:domain [ owl:unionOf ( schema:Event schema:CreativeWork ) ] ;
    rdfs:range schema:Language .

schema:isPartOf a owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    rdfs:comment "Is used to indicate the proceedings where a scientific paper is published."@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:CreativeWorkSeries .

schema:itemListElement a rdf:Property ;
    rdfs:label "item list element"@en ;
    rdfs:comment "For itemListElement values can be used simple strings or existing entities."@en ;
    rdfs:domain schema:ItemList ;
    rdfs:isDefinedBy schema: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( xsd:string owl:Thing ) ] .

schema:jobTitle a owl:DatatypeProperty ;
    rdfs:label "job title"@en ;
    rdfs:comment "The job title of the person (for example, Knowledge Engineer)."@en ;
    rdfs:domain schema:Person ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:keywords a owl:DatatypeProperty ;
    rdfs:label "keywords"@en ;
    rdfs:comment "Keywords or tags used to describe the content of a creative work. Multiple entries in a keywords list are typically delimited by commas."@en ;
    rdfs:domain schema:CreativeWork ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:legalName a owl:DatatypeProperty ;
    rdfs:label "legal name"@en ;
    rdfs:comment "The legal name of an organization."@en ;
    rdfs:domain schema:Organization ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:location a owl:ObjectProperty ;
    rdfs:label "location"@en ;
    rdfs:comment "Is used for different purposes to refer to a geographical place, e. g. for event locations (termporal) or for organization locations (permanent)."@en ;
    rdfs:domain [ owl:unionOf ( schema:Organization schema:Event ) ] ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Place .

schema:logo a owl:DatatypeProperty ;
    rdfs:label "logo"@en ;
    rdfs:comment "An associated logo of an organization."@en ;
    rdfs:domain schema:Organization ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:URL .

schema:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "General datatype property, potentially usable for specifying the name of a resource."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:organizer a owl:ObjectProperty ;
    rdfs:label "organizer"@en ;
    rdfs:comment "Is used to indicate a person or an organization organizing a conference."@en ;
    rdfs:domain schema:PublicationEvent ;
    rdfs:isDefinedBy schema: ;
    rdfs:range [ owl:unionOf ( schema:Person schema:Organization ) ] .

schema:pageEnd a owl:DatatypeProperty ;
    rdfs:label "end page"@en ;
    rdfs:comment "The page on which the scientific paper ends."@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:isDefinedBy schema: ;
    rdfs:range xsd:string .

schema:pageStart a owl:DatatypeProperty ;
    rdfs:label "start page"@en ;
    rdfs:comment "The page on which the scientific paper starts."@en ;
    rdfs:domain schema:ScholarlyArticle ;
    rdfs:isDefinedBy schema: ;
    rdfs:range xsd:string .

schema:publisher a owl:ObjectProperty ;
    rdfs:label "publisher"@en ;
    rdfs:comment "Is used to indicate a publishing organization of a scientific paper or conference proceedings."@en ;
    rdfs:domain schema:CreativeWork ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Organization .

schema:recordedIn a owl:ObjectProperty ;
    rdfs:label "recorded in"@en ;
    rdfs:comment "Is used to relate a conference to the corresponding proceedings."@en ;
    rdfs:domain schema:PublicationEvent ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:CreativeWorkSeries .

schema:sameAs a owl:DatatypeProperty ;
    rdfs:label "same as"@en ;
    rdfs:comment "General datatype property, potentially usable for relating one resource to a URL representing the same resource."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:URL .

schema:startTime a owl:DatatypeProperty ;
    rdfs:label "start time"@en ;
    rdfs:comment "The start time of some event."@en ;
    rdfs:domain schema:Event ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:DateTime .

schema:telephone a owl:DatatypeProperty ;
    rdfs:label "telephone"@en ;
    rdfs:comment "Telephone number of a person or an organization."@en ;
    rdfs:domain [ owl:unionOf ( schema:Person schema:Organization ) ] ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:text a owl:DatatypeProperty ;
    rdfs:label "text"@en ;
    rdfs:comment "The textual content of this creative work."@en ;
    rdfs:domain schema:CreativeWork ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:Text .

schema:url a owl:ObjectProperty ;
    rdfs:label "url"@en ;
    rdfs:comment "General datatype property, potentially usable for specifying the URL of a resource."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:range schema:URL .

<http://www.wikidata.org/entity/Q1391182> a schema:Organization ;
    rdfs:label "BUAS - Brandenburg University of Applied Sciences"@en ;
    schema:url "http://th-brandenburg.de" .

schema:Language a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:comment "Natural languages such as Spanish, German, Hindi, English, etc."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:Intangible .

schema:Place a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "Here used for specifying the locations of conferences and organizations."@en ;
    rdfs:isDefinedBy schema: .

schema:StructuredValue a owl:Class ;
    rdfs:label "Structured Value"@en ;
    rdfs:comment "Structured values are used when the value of a property has a more complex structure than simply being a textual value or a reference to another thing. Here used for specifying research objectives characterized by research actions applied to research artifacts."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:Intangible .

<https://www.th-brandenburg.de/mitarbeiterseiten/fbw/vera-meister/> a schema:Person ;
    schema:name "Vera G. Meister" .

<https://bmake.th-brandenburg.de/spv#ResearchObjective> a owl:Class ;
    rdfs:label "Research Objective"@en ;
    rdfs:comment "Abstract class for modeling an elicited research objective comprising a specific research activity and a research artifact to which the activity is applied."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:subClassOf schema:StructuredValue ;
    ns1:term_status "stable" .

schema:CreativeWorkSeries a owl:Class ;
    rdfs:label "Creative Work Series"@en ;
    rdfs:comment "The class of Conference proceedings - regardless of the publication format."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:CreativeWork .

schema:Enumeration a owl:Class ;
    rdfs:label "Enumeration"@en ;
    rdfs:comment "Enumerations of aspects specifying a scientific paper, like research methods, research artifacts and research action types."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:Intangible .

schema:Intangible a owl:Class ;
    rdfs:label "Intangible"@en ;
    rdfs:comment "A utility class that serves as the umbrella for a number of 'intangible' things such as quantities, structured values, etc. (taken from schema.org)."@en ;
    rdfs:isDefinedBy schema: .

schema:PublicationEvent a owl:Class ;
    rdfs:label "Publication Event"@en ;
    rdfs:comment "The class of scientific conferences."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:Event .

schema:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "Here used primarily for scientific conferences."@en ;
    rdfs:isDefinedBy schema: .

schema:ItemList a owl:Class ;
    rdfs:label "Item List"@en ;
    rdfs:comment "Lists of aspects specifying a scientific paper, like research methods, research findings, research objectives, and future work."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:Intangible .

schema:ScholarlyArticle a owl:Class ;
    rdfs:label "Scholarly Article"@en ;
    rdfs:comment "The class of scientific papers."@en ;
    rdfs:isDefinedBy schema: ;
    rdfs:subClassOf schema:CreativeWork .

schema:CreativeWork a owl:Class ;
    rdfs:label "Creative Work"@en ;
    rdfs:comment "Here used primarily for scientific papers, conference proceeding and related creative work."@en ;
    rdfs:isDefinedBy schema: .

schema:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "Here used for two objectives: (i) to denote the affiliations of authors and other person and (ii) to indicate publishers and conference organizers."@en ;
    rdfs:isDefinedBy schema: .

<https://bmake.th-brandenburg.de/spv#ResearchMethod> a owl:Class ;
    rdfs:label "Research Method"@en ;
    rdfs:comment "Research method applied in an analyzed scientific paper taken from a list of all relevant research methods used in Information Systems."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:subClassOf schema:Enumeration ;
    ns1:term_status "stable" .

schema:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "Mainly used for identifying authors, editors, attendees, contributers, organizers and other human agents."@en ;
    rdfs:isDefinedBy schema: .

<https://bmake.th-brandenburg.de/spv#ResearchActionType> a owl:Class ;
    rdfs:label "Research Action Type"@en ;
    rdfs:comment "The activity aspect of an elecited research objective taken from the list of types of research & development actions applied in Information Systems."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:subClassOf schema:Enumeration ;
    ns1:term_status "stable" .

<https://bmake.th-brandenburg.de/spv#ResearchArtifact> a owl:Class ;
    rdfs:label "Rresearch Artifact"@en ;
    rdfs:comment "The artifact aspect of an elicited research objective taken from the list of all types of research & development artifacts characteristic for Information Systems."@en ;
    rdfs:isDefinedBy <https://bmake.th-brandenburg.de/spv#> ;
    rdfs:subClassOf schema:Enumeration ;
    ns1:term_status "stable" .

<https://bmake.th-brandenburg.de/spv#> a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "spv vocabulary (BMaKE)"@en ;
    ns2:license <http://creativecommons.org/licenses/by/3.0/> ;
    dc:creator <https://www.th-brandenburg.de/mitarbeiterseiten/fbw/vera-meister/> ;
    dc:description <https://bmake.th-brandenburg.de/downloads/scholarlyPapers_schema.svg>,
        "The main contribution of this vocabulary are five specific classes for structuring and collecting the following qualitative characteristics of scholarly papers: research objectives, research methods, research findings, future work, critique. An additional inner structure is proposed for research objectives, qualifying them as schema:StructuredValue and combining them from two lists: research action types and research artifacts. The specific classes are subclasses of schema:ItemList. In addition, the classes for research methods, research action types and research artifacts are declared as subclasses of enumeration. Thus the typical methods, activities and research artifacts of the research area can be listed in the vocabulary itself."@en ;
    dc:issued "2017-06-05"^^xsd:date ;
    dc:modified "2017-08-08"^^xsd:date ;
    dc:publisher <http://www.wikidata.org/entity/Q1391182> ;
    dc:rights "Copyright © 2017 BMaKE, THB" ;
    dc:title "Scholarly Papers Vocabulary with Focus on Qualtitative Analysis" ;
    vann:preferredNamespacePrefix "spv" ;
    vann:preferredNamespaceUri "https://bmake.th-brandenburg.de/spv#" ;
    rdfs:comment "This vocabulary is mainly defined under the reuse of schema.org classes, relations and attributes. It is aimed at the support of research groups in the field of Business Modeling and Knowledge Engineering (BMaKE) in their collaborative work for qualitatively analyzing scholarly papers as well as sharing the results of that analyses and judgements. The vocabulary is meant to be used at first as schema for OntoWiki. Since this system doesn't process blank nodes in the intended way, the abstract nodes for specifying qualitative aspects of scholarly papers shall be modeled explicitely."@en ;
    owl:versionInfo "v 0.3 - refinement for SemSci2017 workshop."@en ;
    skos:prefLabel "spv ontology"@en .

