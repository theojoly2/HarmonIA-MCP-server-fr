    rdfs:comment "A document which does have an author and title, but hasn't been formally published."^^xsd:string ;
    rdfs:subClassOf <http://sw-portal.deri.org/ontologies/swportal#IndividualPublication> .

<http://sw-portal.deri.org/ontologies/swportal#WorkPackage> a owl:Class ;
