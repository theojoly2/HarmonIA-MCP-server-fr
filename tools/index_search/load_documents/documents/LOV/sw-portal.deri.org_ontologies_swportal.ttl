    dc:format "application/rdf+xml" ;
    dc:publisher "DERI International" ;
    dc:rights "http://www.deri.org/privacy.html" ;
    dc:title "Version"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#FunctionalProperty" ;
    rdfs:comment "The version number of a document or tool."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://sw-portal.deri.org/ontologies/swportal#Unpublished> <http://sw-portal.deri.org/ontologies/swportal#Tool> ) ] ;
    rdfs:range xsd:float .

<http://sw-portal.deri.org/ontologies/swportal#isVolume> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Volume"@en ;
    dc:coverage "world" ;
    dc:creator "DERI International" ;
    dc:date "2004-10-20" ;
    dc:description "The volume of a journal or a multi-volume book."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "DERI International" ;
    dc:rights "http://www.deri.org/privacy.html" ;
    dc:title "Volume"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#DatatypeProperty" ;
    rdfs:comment "The volume of a journal or a multi-volume book."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://sw-portal.deri.org/ontologies/swportal#Book> <http://sw-portal.deri.org/ontologies/swportal#Proceedings> <http://sw-portal.deri.org/ontologies/swportal#Volume> ) ] ;
    rdfs:range xsd:nonNegativeInteger .

<http://sw-portal.deri.org/ontologies/swportal#makesProducts> a owl:ObjectProperty ;
    rdfs:label "Products"@en ;
    dc:coverage "world" ;
    dc:creator "DERI International" ;
    dc:date "2004-10-20" ;
    dc:description "This property defines the products of a company."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "DERI International" ;
    dc:rights "http://www.deri.org/privacy.html" ;
    dc:title "Products"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "This property defines the products of a company."^^xsd:string ;
    rdfs:domain <http://sw-portal.deri.org/ontologies/swportal#Company> ;
    rdfs:range owl:Thing .

<http://sw-portal.deri.org/ontologies/swportal#onPages> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Pages"@en ;
    dc:coverage "world" ;
    dc:creator "DERI International" ;
    dc:date "2004-10-20" ;
    dc:description "One or more page numbers or range of numbers, such as 42--111 or 7,41,73--97 or 43+ (the `+' in this last example indicates pages following that don't form a simple range). To make it easier to maintain Scribe-compatible databases, the standard styles convert a single dash (as in 7-33) to the double dash used in TeX to denote number ranges (as in 7--33)."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "DERI International" ;
    dc:rights "http://www.deri.org/privacy.html" ;
    dc:title "Pages"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#DatatypeProperty" ;
    rdfs:comment "One or more page numbers or range of numbers, such as 42--111 or 7,41,73--97 or 43+ (the `+' in this last example indicates pages following that don't form a simple range). To make it easier to maintain Scribe-compatible databases, the standard styles convert a single dash (as in 7-33) to the double dash used in TeX to denote number ranges (as in 7--33)."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://sw-portal.deri.org/ontologies/swportal#Inbook> <http://sw-portal.deri.org/ontologies/swportal#Inproceedings> <http://sw-portal.deri.org/ontologies/swportal#Article> ) ] ;
    rdfs:range xsd:nonNegativeInteger .

<http://sw-portal.deri.org/ontologies/swportal#publishedBy> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Publisher"@en ;
    dc:coverage "world" ;
    dc:creator "DERI International" ;
    dc:date "2004-10-20" ;
    dc:description "The instance of <link>Publisher</link> which published this document."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "DERI International" ;
    dc:rights "http://www.deri.org/privacy.html" ;
    dc:title "Publisher"@EN ;
