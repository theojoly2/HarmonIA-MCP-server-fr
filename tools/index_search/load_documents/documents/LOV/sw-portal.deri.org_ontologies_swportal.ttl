    rdfs:comment "The instance of <link>Publisher</link> which published this document."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://sw-portal.deri.org/ontologies/swportal#Proceedings> <http://sw-portal.deri.org/ontologies/swportal#Book> ) ] ;
    rdfs:range <http://sw-portal.deri.org/ontologies/swportal#PublishingCompany> .

foaf:firstName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "First Name"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"The first name of a person.\" NOTE: the naming substructure of foaf is currently quite unstable."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "First Name"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#DatatypeProperty" ;
    rdfs:comment "\"The first name of a person.\" NOTE: the naming substructure of foaf is currently quite unstable."^^xsd:string ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

foaf:knows a owl:ObjectProperty ;
    rdfs:label "Knows"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"A person known by this person (indicating some level of reciprocated interaction between the parties).\""@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Knows"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "\"A person known by this person (indicating some level of reciprocated interaction between the parties).\""^^xsd:string ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

foaf:made a owl:ObjectProperty ;
    rdfs:label "Made"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"Something that was made by this agent.\" In the context of the SWPortal ontology, this could e.g. be an <link>Tool</link>."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Made"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "\"Something that was made by this agent.\" In the context of the SWPortal ontology, this could e.g. be an <link>Tool</link>."^^xsd:string ;
    rdfs:domain foaf:Agent ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://sw-portal.deri.org/ontologies/swportal#Tool> foaf:Document <http://sw-portal.deri.org/ontologies/swportal#Book> ) ] .

foaf:mbox a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Email"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"A personal mailbox, i.e. an internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that there is (across time and change) at most one individual that ever has any particular value for <link>foaf:mbox</link>.\" Because we switched over to OWL Lite– ,we don’t have functional properties anymore. However, we recommend to the users of this ontology to apply this property like it is described in the FOAF specification."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Email"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "\"A personal mailbox, i.e. an internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that there is (across time and change) at most one individual that ever has any particular value for <link>foaf:mbox</link>.\" Because we switched over to OWL Lite– ,we don’t have functional properties anymore. However, we recommend to the users of this ontology to apply this property like it is described in the FOAF specification."^^xsd:string ;
    rdfs:domain foaf:Agent ;
    rdfs:range rdfs:Literal .

foaf:member a owl:ObjectProperty ;
    rdfs:label "Member"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"Indicates a member of a Group.\" This property relates a set of agents to a group. These are the members of that group."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Member"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "\"Indicates a member of a Group.\" This property relates a set of agents to a group. These are the members of that group."^^xsd:string ;
    rdfs:domain foaf:Group ;
    rdfs:range foaf:Agent .

foaf:name a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Complete Name"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"The name of some thing.\""@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Complete Name"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#FunctionalProperty" ;
    rdfs:comment "\"The name of some thing.\""^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( foaf:Agent <http://sw-portal.deri.org/ontologies/swportal#Location> <http://sw-portal.deri.org/ontologies/swportal#Tool> <http://sw-portal.deri.org/ontologies/swportal#Event> ) ] ;
    rdfs:range xsd:string .

foaf:pastProject a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Past Project"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"A project this person has previously worked on.\" NOTE: foaf defines the range as <link>foaf:Person</link> - we decided to change this to the more general <link>foaf:Agent</link>, since other types of Agents (e.g. a company) can also have projects."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Past Project"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "\"A project this person has previously worked on.\" NOTE: foaf defines the range as <link>foaf:Person</link> - we decided to change this to the more general <link>foaf:Agent</link>, since other types of Agents (e.g. a company) can also have projects."^^xsd:string ;
    rdfs:domain foaf:Agent ;
    rdfs:range foaf:Project .

foaf:phone a owl:ObjectProperty ;
    rdfs:label "Telephone"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"The foaf:phone of something is a phone, typically identified using the tel: URI  scheme.\" The tel: URI scheme is defined in http://www.ietf.org/rfc/rfc2806.txt."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Telephone"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "\"The foaf:phone of something is a phone, typically identified using the tel: URI  scheme.\" The tel: URI scheme is defined in http://www.ietf.org/rfc/rfc2806.txt."^^xsd:string ;
    rdfs:domain foaf:Agent ;
    rdfs:range rdfs:Literal .

foaf:surname a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Surname"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"The surname of a person.\" NOTE: the naming substructure of foaf is currently quite unstable."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Surname"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#DatatypeProperty" ;
    rdfs:comment "\"The surname of a person.\" NOTE: the naming substructure of foaf is currently quite unstable."^^xsd:string ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:string .

foaf:theme a owl:ObjectProperty ;
    rdfs:label "Theme"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"A theme. The foaf:theme property is rarely used and under-specified. The intention was to use it to characterise interest / themes associated with projects and groups. Further work is need to meet these goals.\" NOTE: This property is only listed for comparison with goal."@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Theme"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "\"A theme. The foaf:theme property is rarely used and under-specified. The intention was to use it to characterise interest / themes associated with projects and groups. Further work is need to meet these goals.\" NOTE: This property is only listed for comparison with goal."^^xsd:string ;
    rdfs:domain foaf:Group ;
    rdfs:range owl:Thing .

foaf:topic a owl:ObjectProperty ;
    rdfs:label "Topic"@en ;
    dc:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
        "http://www.w3.org/RDF/Interest/" ;
    dc:coverage "world" ;
    dc:creator "Dan Brickley",
        "Libby Miller" ;
    dc:description "\"A topic of some page or document. The <link>foaf:topic</link> property relates a document to a thing that the document is about. As such it is an inverse to the foaf:page property, which relates a thing to a document about that thing.\""@EN ;
    dc:format "application/rdf+xml" ;
    dc:publisher "Dan Brickley",
        "Libby Miller" ;
    dc:title "Topic"@EN ;
    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "\"A topic of some page or document. The <link>foaf:topic</link> property relates a document to a thing that the document is about. As such it is an inverse to the foaf:page property, which relates a thing to a document about that thing.\""^^xsd:string ;
    rdfs:domain foaf:Document ;
    rdfs:range owl:Thing .

