    dc:type "http://www.w3.org/2002/07/owl#ObjectProperty" ;
    rdfs:comment "The deliverables for this project. The inverse is <link>forProject</link>."^^xsd:string ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://sw-portal.deri.org/ontologies/swportal#Cluster> <http://sw-portal.deri.org/ontologies/swportal#TemporaryGroup> ) ] ;
    rdfs:range <http://sw-portal.deri.org/ontologies/swportal#Deliverable> ;
    owl:inverseOf <http://sw-portal.deri.org/ontologies/swportal#forProject> .

<http://sw-portal.deri.org/ontologies/swportal#drivenBy> a owl:ObjectProperty ;
    rdfs:label "Driven by"@en ;
