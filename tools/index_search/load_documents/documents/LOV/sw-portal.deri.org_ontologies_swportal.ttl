    rdfs:subClassOf <http://sw-portal.deri.org/ontologies/swportal#IndividualPublication> .

<http://sw-portal.deri.org/ontologies/swportal#Topic> a owl:Class ;
    rdfs:label "Topic"@en ;
    dc:coverage "world" ;
    dc:creator "DERI International" ;
    dc:date "2004-10-20" ;
    dc:description "All research topics inherit from this concept. This should serve as a plugin point for the research topic ontology."@EN ;
