@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://ontology.ethereal.cz/irao> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://ontology.ethereal.cz/irao/API> a owl:Class ;
    rdfs:label "API"@en ;
    rdfs:comment "An API is a type of service-based research artifact"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/Service> .

<http://ontology.ethereal.cz/irao/AnnotatedDataset> a owl:Class ;
    rdfs:label "Annotated Dataset"@en ;
    rdfs:comment "A dataset which was processed for AI or machine learning"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/Dataset> .

<http://ontology.ethereal.cz/irao/ApplicationFramework> a owl:Class ;
    rdfs:label "Application Framework"@en ;
    rdfs:comment "A framework that is used by applications"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/SoftwareFramework> .

<http://ontology.ethereal.cz/irao/ConferencePaper> a owl:Class ;
    rdfs:label "Conference paper"@en ;
    rdfs:comment "A paper or article published at a scientific conference"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/Publication> .

<http://ontology.ethereal.cz/irao/Middleware> a owl:Class ;
    rdfs:label "Middleware"@en ;
    rdfs:comment "A middleware is a type of software that is used to connect software components in to a system"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/Software> .

<http://ontology.ethereal.cz/irao/SyntheticDataset> a owl:Class ;
    rdfs:label "Synthetic Dataset"@en ;
    rdfs:comment "Synthetic datasets are generated through computer programs, instead of being composed through the documentation of real-world events"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/Dataset> .

<http://ontology.ethereal.cz/irao/Thesis> a owl:Class ;
    rdfs:label "Thesis"@en ;
    rdfs:comment "A thesis as a type of scientific or academic publication or dissertation is a document submitted in support of candidature for an academic degree or professional qualification presenting the author's research and findings"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/Publication> .

<http://ontology.ethereal.cz/irao/Vocabulary> a owl:Class ;
    rdfs:label "Vocabulary"@en ;
    rdfs:comment "A vocabulary is used to provide a range of commonly used terms and their definitions"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/WebFramework> a owl:Class ;
    rdfs:label "Web Framework"@en ;
    rdfs:comment "A web framework is a type of software framework that is used to develop applications on the web"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/SoftwareFramework> .

<http://ontology.ethereal.cz/irao/Workflow> a owl:Class ;
    rdfs:label "Workflow"@en ;
    rdfs:comment "A workflow is a sequence of interrelated, orchestrated and repeatable tasks"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/accessibility#API> a <http://ontology.ethereal.cz/irao/Accessibility>,
        owl:NamedIndividual ;
    rdfs:label "API"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/accessibility#Download> a <http://ontology.ethereal.cz/irao/Accessibility>,
        owl:NamedIndividual ;
    rdfs:label "Download"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/accessibility#OpenData> a <http://ontology.ethereal.cz/irao/Accessibility>,
        owl:NamedIndividual ;
    rdfs:label "Open Data"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/accessibility#OpenSource> a <http://ontology.ethereal.cz/irao/Accessibility>,
        owl:NamedIndividual ;
    rdfs:label "Opensource"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/designquality#FAIR> a <http://ontology.ethereal.cz/irao/DesignQuality>,
        owl:NamedIndividual ;
    rdfs:label "FAIR"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/designquality#Reuse> a <http://ontology.ethereal.cz/irao/DesignQuality>,
        owl:NamedIndividual ;
    rdfs:label "Reuse"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/developmentstatus#alpha> a <http://ontology.ethereal.cz/irao/DevelopmentStatus>,
        owl:NamedIndividual ;
    rdfs:label "Alpha"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/developmentstatus#beta> a <http://ontology.ethereal.cz/irao/DevelopmentStatus>,
        owl:NamedIndividual ;
    rdfs:label "Beta"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/developmentstatus#release> a <http://ontology.ethereal.cz/irao/DevelopmentStatus>,
        owl:NamedIndividual ;
    rdfs:label "Release"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/hasAccessibility> a owl:ObjectProperty ;
    rdfs:label "has accessibility"@en ;
    rdfs:comment "This property specifies the accessibility of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Accessibility> .

<http://ontology.ethereal.cz/irao/hasAffiliation> a owl:ObjectProperty ;
    rdfs:label "has affiliation"@en ;
    rdfs:comment "This property specifies the affiliation of a researcher"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Researcher> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Affiliation> .

<http://ontology.ethereal.cz/irao/hasAuthor> a owl:ObjectProperty ;
    rdfs:label "has author"@en ;
    rdfs:comment "This property specifies the author of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person .

<http://ontology.ethereal.cz/irao/hasDesign> a owl:ObjectProperty ;
    rdfs:label "has design"@en ;
    rdfs:comment "This property specifies the design of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/DesignQuality> .

<http://ontology.ethereal.cz/irao/hasDesignQuality> a owl:ObjectProperty ;
    rdfs:label "has design quality"@en ;
    rdfs:comment "This property specifies the design quality of a design"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Design> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/DesignQuality> .

<http://ontology.ethereal.cz/irao/hasDevelopmentStatus> a owl:ObjectProperty ;
    rdfs:label "has development status"@en ;
    rdfs:comment "This property specifies the development status of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/DevelopmentStatus> .

<http://ontology.ethereal.cz/irao/hasDomain> a owl:ObjectProperty ;
    rdfs:label "has domain"@en ;
    rdfs:comment "This property specifies the research domain of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/ResearchDomain> .

<http://ontology.ethereal.cz/irao/hasField> a owl:ObjectProperty ;
    rdfs:label "has field"@en ;
    rdfs:comment "This property specifies the research field of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/ResearchField> .

<http://ontology.ethereal.cz/irao/hasFollowedProtocol> a owl:ObjectProperty ;
    rdfs:label "has followed protocol"@en ;
    rdfs:comment "This property specifies the protocol that a benchmark follows"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Benchmark> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Protocol> .

<http://ontology.ethereal.cz/irao/hasFramework> a owl:ObjectProperty ;
    rdfs:label "has framework"@en ;
    rdfs:comment "This property specifies the framework used by a software"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Software> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Framework> .

<http://ontology.ethereal.cz/irao/hasLicense> a owl:ObjectProperty ;
    rdfs:label "has license"@en ;
    rdfs:comment "This property specifies the license of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/License> .

<http://ontology.ethereal.cz/irao/hasLicenseType> a owl:ObjectProperty ;
    rdfs:label "has license type"@en ;
    rdfs:comment "This property specifies the type of a license"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/License> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/LicenseType> .

<http://ontology.ethereal.cz/irao/hasMaintainer> a owl:ObjectProperty ;
    rdfs:label "is maintained by"@en ;
    rdfs:comment "This property specifies the maintainer of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Researcher> .

<http://ontology.ethereal.cz/irao/hasMeasuringSystem> a owl:ObjectProperty ;
    rdfs:label "has measuring system"@en ;
    rdfs:comment "This property specifies a system that measures a benchmark"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Benchmark> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/System> .

<http://ontology.ethereal.cz/irao/hasMethodology> a owl:ObjectProperty ;
    rdfs:label "has methodology"@en ;
    rdfs:comment "This property specifies the methodology used by a research artifact"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://ontology.ethereal.cz/irao/Dataset> <http://ontology.ethereal.cz/irao/Framework> <http://ontology.ethereal.cz/irao/Protocol> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Methodology> .

<http://ontology.ethereal.cz/irao/hasOpenStandard> a owl:ObjectProperty ;
    rdfs:label "has open standard"@en ;
    rdfs:comment "This property specifies the open standard used by a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/OpenStandard> .

<http://ontology.ethereal.cz/irao/hasProducedDataset> a owl:ObjectProperty ;
    rdfs:label "has produced dataset"@en ;
    rdfs:comment "This property specifies the dataset which us produced by a benchmark"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Benchmark> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Dataset> .

<http://ontology.ethereal.cz/irao/hasPublication> a owl:ObjectProperty ;
    rdfs:label "has publication"@en ;
    rdfs:comment "This property specifies the publication of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Publication> .

<http://ontology.ethereal.cz/irao/hasReferredBenchmark> a owl:ObjectProperty ;
    rdfs:label "has referred benchmark"@en ;
    rdfs:comment "This property specifies a benchmark referred by another benchmark"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Benchmark> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Benchmark> .

<http://ontology.ethereal.cz/irao/hasRepositoryType> a owl:ObjectProperty ;
    rdfs:label "has repository type"@en ;
    rdfs:comment "This property specifies the repository type of a research artifact repository"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Repository> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/RepositoryType> .

<http://ontology.ethereal.cz/irao/hasResearchArea> a owl:ObjectProperty ;
    rdfs:label "has research area"@en ;
    rdfs:comment "This property specifies the research area of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://cso.kmi.open.ac.uk/schema/cso#Topic> .

<http://ontology.ethereal.cz/irao/hasResearchOutput> a owl:ObjectProperty ;
    rdfs:label "has research output"@en ;
    rdfs:comment "This property specifies the research output of a research project"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchProject> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/ResearchOutput> .

<http://ontology.ethereal.cz/irao/hasTopic> a owl:DatatypeProperty ;
    rdfs:label "has topic"@en ;
    rdfs:comment "This property specifies the topic of a publication"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Publication> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://ontology.ethereal.cz/irao/hasURL> a owl:DatatypeProperty ;
    rdfs:label "has URL"@en ;
    rdfs:comment "This property specifies the resource URL of a publication, repository or research artifact"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://ontology.ethereal.cz/irao/Publication> <http://ontology.ethereal.cz/irao/Repository> <http://ontology.ethereal.cz/irao/ResearchArtifact> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI .

<http://ontology.ethereal.cz/irao/hasUsedFramework> a owl:ObjectProperty ;
    rdfs:label "has used framework"@en ;
    rdfs:comment "This property specifies the framework used by a research artifact like software or system"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://ontology.ethereal.cz/irao/Framework> <http://ontology.ethereal.cz/irao/Software> <http://ontology.ethereal.cz/irao/System> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Framework> .

<http://ontology.ethereal.cz/irao/hasUsedMethodology> a owl:ObjectProperty ;
    rdfs:label "has used methodology"@en ;
    rdfs:comment "This property specifies the methodology used in a research artifact like framework or dataset"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://ontology.ethereal.cz/irao/Dataset> <http://ontology.ethereal.cz/irao/Framework> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Methodology> .

<http://ontology.ethereal.cz/irao/hasUsedOntologyDesignPattern> a owl:ObjectProperty ;
    rdfs:label "has used ontology design pattern"@en ;
    rdfs:comment "This property specifies the ontology design pattern of an ontology or another ontology design pattern"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://ontology.ethereal.cz/irao/Ontology> <http://ontology.ethereal.cz/irao/OntologyDesignPattern> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/OntologyDesignPattern> .

<http://ontology.ethereal.cz/irao/hasVersion> a owl:DatatypeProperty ;
    rdfs:label "has version"@en ;
    rdfs:comment "This property specifies the version of a research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://ontology.ethereal.cz/irao/isDescribedBy> a owl:ObjectProperty ;
    rdfs:label "is described by"@en ;
    rdfs:comment "This property specifies the data model of a dataset"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Dataset> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/DataModel> .

<http://ontology.ethereal.cz/irao/isFollowedBy> a owl:ObjectProperty ;
    rdfs:label "is followed by"@en ;
    rdfs:comment "This property specifies that a research project is followed by another research project"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchProject> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/ResearchProject> .

<http://ontology.ethereal.cz/irao/isPartOfSystem> a owl:ObjectProperty ;
    rdfs:label "is part of system"@en ;
    rdfs:comment "This property specifies the system which a software is part of"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/Software> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/System> .

<http://ontology.ethereal.cz/irao/isPublishedAt> a owl:ObjectProperty ;
    rdfs:label "is published at"@en ;
    rdfs:comment "This property specifies the repository that a research artifact is published at"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/Repository> .

<http://ontology.ethereal.cz/irao/isUsedBy> a owl:ObjectProperty ;
    rdfs:label "is used by"@en ;
    rdfs:comment "This property specifies that a research artifact is used by another research artifact"@en ;
    rdfs:domain <http://ontology.ethereal.cz/irao/ResearchArtifact> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://ontology.ethereal.cz/irao/ResearchArtifact> .

<http://ontology.ethereal.cz/irao/openstandard#RDF> a <http://ontology.ethereal.cz/irao/OpenStandard>,
        owl:NamedIndividual ;
    rdfs:label "RDF"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/openstandard#RDFS> a <http://ontology.ethereal.cz/irao/OpenStandard>,
        owl:NamedIndividual ;
    rdfs:label "RDFS"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/openstandard#SKOS> a <http://ontology.ethereal.cz/irao/OpenStandard>,
        owl:NamedIndividual ;
    rdfs:label "SKOS"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/openstandard#SPARQL> a <http://ontology.ethereal.cz/irao/OpenStandard>,
        owl:NamedIndividual ;
    rdfs:label "SPARQL"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/openstandard#XML> a <http://ontology.ethereal.cz/irao/OpenStandard>,
        owl:NamedIndividual ;
    rdfs:label "XML"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/repositorytype#KnowledgeBase> a <http://ontology.ethereal.cz/irao/RepositoryType>,
        owl:NamedIndividual ;
    rdfs:label "Knowledge base"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/repositorytype#VersionControlHosting> a <http://ontology.ethereal.cz/irao/RepositoryType>,
        owl:NamedIndividual ;
    rdfs:label "Version control hosting"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/Affiliation> a owl:Class ;
    rdfs:label "Affiliation"@en ;
    rdfs:comment "An affiliation of the author, it maybe a company or an institution"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/Design> a owl:Class ;
    rdfs:label "Design"@en ;
    rdfs:comment "A plan or specification for the construction or production of a research artifact"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/LicenseType> a owl:Class ;
    rdfs:label "License type"@en ;
    rdfs:comment "The type of a license"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/Model> a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "A model is a type of research artifact that can be used to describe other artifacts such as a dataset or a software"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/Ontology> a owl:Class ;
    rdfs:label "Ontology"@en ;
    rdfs:comment "An ontology is a type of data model used to describe linked datasets"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/DataModel> .

<http://ontology.ethereal.cz/irao/ResearchDomain> a owl:Class ;
    rdfs:label "Research Domain"@en ;
    rdfs:comment "A research domain is the domain of interest of a research project"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/ResearchField> a owl:Class ;
    rdfs:label "Research Field"@en ;
    rdfs:comment "A research field is the field of interest of a research project"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/Service> a owl:Class ;
    rdfs:label "Service"@en ;
    rdfs:comment "A service is a type of software that provides e.g. data or some type of functionalities"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/Software> .

<https://cs.dbpedia.org/page/Vysok%C3%A1_%C5%A1kola_ekonomick%C3%A1_v_Praze> a foaf:Organization .

<https://nb.vse.cz/~svatek/> a foaf:Person .

<https://www.linkedin.com/in/nvbach91/> a foaf:Person .

<http://ontology.ethereal.cz/irao/DataModel> a owl:Class ;
    rdfs:label "Data model"@en ;
    rdfs:comment "A data model such as schema and ontologies"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/Model> .

<http://ontology.ethereal.cz/irao/License> a owl:Class ;
    rdfs:label "License"@en ;
    rdfs:comment "A license authorizes the use, performace, or release of a research artifact"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/Methodology> a owl:Class ;
    rdfs:label "Methodology"@en ;
    rdfs:comment "Methodology is a type of research artifact"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/OntologyDesignPattern> a owl:Class ;
    rdfs:label "Ontology design pattern"@en ;
    rdfs:comment "An ontology design pattern is a pattern used in designing ontologies"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/Protocol> a owl:Class ;
    rdfs:label "Protocol"@en ;
    rdfs:comment "A protocol is used to provide guidelines to execute certain tasks"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/Researcher> a owl:Class ;
    rdfs:label "Researcher"@en ;
    rdfs:comment "A researcher is a person doing research"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf foaf:Person .

<http://ontology.ethereal.cz/irao/SoftwareFramework> a owl:Class ;
    rdfs:label "Software Framework"@en ;
    rdfs:comment "A software framework is a type of software that provides guidelines for the development of new softwares"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/Framework> .

<http://ontology.ethereal.cz/irao/Repository> a owl:Class ;
    rdfs:label "Repository"@en ;
    rdfs:comment "A repository is an online storage for the deposit of research artifacts such as datasets and vocabularies"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/RepositoryType> a owl:Class ;
    rdfs:label "Repository Type"@en ;
    rdfs:comment "A repository type can be a knowledge base, knowledge graph, version control hosting, etc."@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/ResearchOutput> a owl:Class ;
    rdfs:label "Research output"@en ;
    rdfs:comment "A research output is the result of a research project"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/ResearchProject> a owl:Class ;
    rdfs:label "Research project"@en ;
    rdfs:comment "A research project is a project within the research domain with the endeavor of achieving scientific results"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vivoweb.org/ontology/core#Project> .

<http://ontology.ethereal.cz/irao/System> a owl:Class ;
    rdfs:label "System"@en ;
    rdfs:comment "A system is a group of interacting or interrelated informatics components that form a unified whole"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/DesignQuality> a owl:Class ;
    rdfs:label "Design quality"@en ;
    rdfs:comment "A design quality involves the usage of recommended standards, protocols, frameworks, methodologies"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/DevelopmentStatus> a owl:Class ;
    rdfs:label "Development status"@en ;
    rdfs:comment "The development status of a research artifact, informing about its maturity"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/Accessibility> a owl:Class ;
    rdfs:label "Accessibility"@en ;
    rdfs:comment "A research artifact can be made accessible via download or some kind of API, etc."@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/Benchmark> a owl:Class ;
    rdfs:label "Benchmark"@en ;
    rdfs:comment "A benchmark is a type of comparison and measuring with metrics, producing datasets and algorithms for comprehensive and systematic evaluation of existing and future systems"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/Publication> a owl:Class ;
    rdfs:label "Publication"@en ;
    rdfs:comment "A publication makes content and research results available to the general public via publication venues such as journals, books, websites, etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/ResearchOutput> .

<http://ontology.ethereal.cz/irao/Software> a owl:Class ;
    rdfs:label "Software"@en ;
    rdfs:comment "A software is a type of informatics research artifact"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/Dataset> a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A dataset containing the gathered or generated data about some topic"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/Framework> a owl:Class ;
    rdfs:label "Framework"@en ;
    rdfs:comment "The framework is a type of an informatics research artifact"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> .

<http://ontology.ethereal.cz/irao/OpenStandard> a owl:Class ;
    rdfs:label "Open Standard"@en ;
    rdfs:comment "A open standard is a standard used to provide guidelines for the development and operations of artifacts and systems"@en ;
    rdfs:isDefinedBy onto: .

<http://ontology.ethereal.cz/irao/InformaticsResearchArtifact> a owl:Class ;
    rdfs:label "Informatics Research Artifact"@en ;
    rdfs:comment "An informatics research artifact is a research artifact in the informatics field"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/ResearchArtifact> .

<http://ontology.ethereal.cz/irao/ResearchArtifact> a owl:Class ;
    rdfs:label "Research Artifact"@en ;
    rdfs:comment "A research artifact is a direct output or result of a research project"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://ontology.ethereal.cz/irao/ResearchOutput> .

