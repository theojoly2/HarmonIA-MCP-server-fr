            owl:allValuesFrom [ a owl:Restriction ;
                    owl:onProperty <https://w3id.org/list#hasNext> ;
                    owl:someValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcLengthMeasure_List> ] ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#coordinates_IfcCartesianPoint> ],
