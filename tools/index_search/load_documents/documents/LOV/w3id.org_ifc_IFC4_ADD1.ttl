        <https://w3id.org/ifc/IFC4_ADD1#IfcIndexedPolyCurve>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcTrimmedCurve> .

<https://w3id.org/ifc/IFC4_ADD1#IfcPositivePlaneAngleMeasure> a owl:Class ;
