            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#predefinedType_IfcStructuralSurfaceAction> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcProjectedOrTrueLengthEnum> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#projectedOrTrue_IfcStructuralSurfaceAction> ],
