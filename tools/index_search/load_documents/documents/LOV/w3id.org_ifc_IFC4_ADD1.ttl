            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#pointParameterV_IfcPointOnSurface> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcSurface> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#basisSurface_IfcPointOnSurface> ],
        [ a owl:Restriction ;
