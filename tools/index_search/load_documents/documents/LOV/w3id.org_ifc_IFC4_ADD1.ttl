        <https://w3id.org/ifc/IFC4_ADD1#IfcDuctFittingType>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcJunctionBoxType> .

<https://w3id.org/ifc/IFC4_ADD1#IfcPointOnSurface> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcParameterValue> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#pointParameterU_IfcPointOnSurface> ],
        [ a owl:Restriction ;
