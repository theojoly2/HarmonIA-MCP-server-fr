                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
                            owl:onProperty <https://w3id.org/list#hasNext> ] ;
                    owl:onProperty <https://w3id.org/list#hasNext> ] ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#coordinates_IfcCartesianPoint> ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcLengthMeasure_List> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#coordinates_IfcCartesianPoint> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
