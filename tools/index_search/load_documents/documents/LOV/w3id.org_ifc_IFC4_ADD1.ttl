<https://w3id.org/ifc/IFC4_ADD1#IfcCableCarrierSegment> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcCableCarrierSegmentTypeEnum> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#predefinedType_IfcCableCarrierSegment> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcCableCarrierSegmentTypeEnum> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#predefinedType_IfcCableCarrierSegment> ],
        <https://w3id.org/ifc/IFC4_ADD1#IfcFlowSegment> ;
    owl:disjointWith <https://w3id.org/ifc/IFC4_ADD1#IfcCableSegment>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcDuctSegment>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcPipeSegment> .

<https://w3id.org/ifc/IFC4_ADD1#IfcCableSegment> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcCableSegmentTypeEnum> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#predefinedType_IfcCableSegment> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcCableSegmentTypeEnum> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#predefinedType_IfcCableSegment> ],
        <https://w3id.org/ifc/IFC4_ADD1#IfcFlowSegment> ;
    owl:disjointWith <https://w3id.org/ifc/IFC4_ADD1#IfcCableCarrierSegment>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcDuctSegment>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcPipeSegment> .

<https://w3id.org/ifc/IFC4_ADD1#IfcCartesianTransformationOperator3D> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcDirection> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#axis3_IfcCartesianTransformationOperator3D> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcDirection> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#axis3_IfcCartesianTransformationOperator3D> ],
        <https://w3id.org/ifc/IFC4_ADD1#IfcCartesianTransformationOperator> ;
    owl:disjointWith <https://w3id.org/ifc/IFC4_ADD1#IfcCartesianTransformationOperator2D> .

<https://w3id.org/ifc/IFC4_ADD1#IfcCompressorType> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcCompressorTypeEnum> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#predefinedType_IfcCompressorType> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcCompressorTypeEnum> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#predefinedType_IfcCompressorType> ],
        <https://w3id.org/ifc/IFC4_ADD1#IfcFlowMovingDeviceType> ;
    owl:disjointWith <https://w3id.org/ifc/IFC4_ADD1#IfcFanType>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcPumpType> .

<https://w3id.org/ifc/IFC4_ADD1#IfcContextDependentUnit> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcLabel> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#name_IfcContextDependentUnit> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcLabel> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#name_IfcContextDependentUnit> ],
        <https://w3id.org/ifc/IFC4_ADD1#IfcNamedUnit>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcResourceObjectSelect> ;
    owl:disjointWith <https://w3id.org/ifc/IFC4_ADD1#IfcConversionBasedUnit>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcSIUnit> .

<https://w3id.org/ifc/IFC4_ADD1#IfcDistributionPort> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcFlowDirectionEnum> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#flowDirection_IfcDistributionPort> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcDistributionPortTypeEnum> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#predefinedType_IfcDistributionPort> ],
        [ a owl:Restriction ;
