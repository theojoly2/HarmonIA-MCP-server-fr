<https://w3id.org/ifc/IFC4_ADD1#IfcPolyline> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:onProperty <https://w3id.org/list#hasNext> ;
                    owl:someValuesFrom [ a owl:Restriction ;
                            owl:onProperty <https://w3id.org/list#hasNext> ;
                            owl:someValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcCartesianPoint_List> ] ] ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#points_IfcPolyline> ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcCartesianPoint_List> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#points_IfcPolyline> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcCartesianPoint_List> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#points_IfcPolyline> ],
        <https://w3id.org/ifc/IFC4_ADD1#IfcBoundedCurve> ;
    owl:disjointWith <https://w3id.org/ifc/IFC4_ADD1#IfcBSplineCurve>,
