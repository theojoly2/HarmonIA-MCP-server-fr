            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <https://w3id.org/ifc/IFC4_ADD1#IfcPoint> ;
    owl:disjointWith <https://w3id.org/ifc/IFC4_ADD1#IfcCartesianPoint>,
