        <https://w3id.org/ifc/IFC4_ADD1#IfcPlaneAngleMeasure> .

<https://w3id.org/ifc/IFC4_ADD1#IfcPropertySet> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcProperty> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#hasProperties_IfcPropertySet> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcProperty> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#hasProperties_IfcPropertySet> ],
        <https://w3id.org/ifc/IFC4_ADD1#IfcPropertySetDefinition> ;
    owl:disjointWith <https://w3id.org/ifc/IFC4_ADD1#IfcPreDefinedPropertySet>,
