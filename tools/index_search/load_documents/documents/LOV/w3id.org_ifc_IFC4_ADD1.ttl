<https://w3id.org/ifc/IFC4_ADD1#IfcSurfaceSide> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/express#ENUMERATION> .

<https://w3id.org/ifc/IFC4_ADD1#IfcSurfaceStyle> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcSurfaceStyleElementSelect> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#styles_IfcSurfaceStyle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcSurfaceStyleElementSelect> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#styles_IfcSurfaceStyle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcSurfaceSide> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#side_IfcSurfaceStyle> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcSurfaceStyleElementSelect> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#styles_IfcSurfaceStyle> ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcSurfaceSide> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#side_IfcSurfaceStyle> ;
