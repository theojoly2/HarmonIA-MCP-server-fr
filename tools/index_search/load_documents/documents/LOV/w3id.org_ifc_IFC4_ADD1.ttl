            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#basisSurface_IfcPointOnSurface> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcParameterValue> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#pointParameterU_IfcPointOnSurface> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
