<https://w3id.org/ifc/IFC4_ADD1#IfcSurfaceTexture> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcIdentifier_List> ;
