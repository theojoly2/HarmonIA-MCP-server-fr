            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#projectedOrTrue_IfcStructuralCurveAction> ],
        <https://w3id.org/ifc/IFC4_ADD1#IfcStructuralAction> ;
    owl:disjointWith <https://w3id.org/ifc/IFC4_ADD1#IfcStructuralPointAction>,
        <https://w3id.org/ifc/IFC4_ADD1#IfcStructuralSurfaceAction> .

<https://w3id.org/ifc/IFC4_ADD1#IfcStructuralLoad> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/ifc/IFC4_ADD1#IfcLabel> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#name_IfcStructuralLoad> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcLabel> ;
            owl:onProperty <https://w3id.org/ifc/IFC4_ADD1#name_IfcStructuralLoad> ],
        [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/ifc/IFC4_ADD1#IfcStructuralLoadConfiguration> <https://w3id.org/ifc/IFC4_ADD1#IfcStructuralLoadOrResult> ) ] .

<https://w3id.org/ifc/IFC4_ADD1#IfcStructuralSurfaceAction> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/ifc/IFC4_ADD1#IfcProjectedOrTrueLengthEnum> ;
