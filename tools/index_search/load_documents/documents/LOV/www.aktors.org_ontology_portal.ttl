ns1:Collaborative-Hypermedia a ns1:Research-Area ;
    ns1:sub-area-of ns1:Hypermedia ;
    rdfs:isDefinedBy onto: .

ns1:DEng a ns1:Academic-Degree ;
    rdfs:isDefinedBy onto: .

ns1:Daily-Newspaper a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.aktors.org/ontology/support#twentyfour-hour-duration> ;
            owl:onProperty ns1:has-periodicity ],
        ns1:Newspaper .

ns1:Distance-Teaching-University a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:University .

