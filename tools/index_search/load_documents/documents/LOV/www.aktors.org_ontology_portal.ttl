    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Generic-Area-Of-Interest .

ns1:Charitable-Organization a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Non-Profit-Organization .

ns1:Civil-Service a owl:Class ;
