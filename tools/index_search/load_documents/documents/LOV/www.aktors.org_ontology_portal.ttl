    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Working-Person .

ns1:Semantic-Web-Area a ns1:Research-Area ;
    ns1:sub-area-of ns1:Web-Research-Area ;
    rdfs:isDefinedBy onto: .

ns1:Sending-An-Email a owl:Class ;
    rdfs:comment "a generalized transfer in which information is passed from main agent to one or more recipient agents.  examples include giving a tutorial." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Email-Message ;
            owl:onProperty ns1:information-object-being-transferred ],
        [ a owl:Restriction ;
            owl:hasValue ns1:Email-Medium ;
            owl:onProperty ns1:information-transfer-medium-used ],
        ns1:Information-Transfer-Event .

ns1:Senior-Lecturer-In-Academia a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Academic .

ns1:Senior-Research-Fellow-In-Academia a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Researcher-In-Academia .

ns1:Sir a ns1:Appellation ;
    rdfs:isDefinedBy onto: .

ns1:Small-Or-Medium-Sized-Organization a owl:Class ;
    rdfs:label "Small or Medium-sized Organization" ;
    rdfs:comment "SME are important, so we define a class to represent them explicitly. In some case we might not know or we do not want to bother specifying excatly whether something is a small-organization or a medium-organization. Hence, we can just say 'x is a SME' without going into further detail." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:oneOf ( ns1:medium-size ns1:small-size ) ] ;
            owl:onProperty ns1:has-size ],
        ns1:Organization .

ns1:Software-Visualization a ns1:Research-Area ;
    ns1:sub-area-of ns1:Human-Computer-Interaction ;
    rdfs:isDefinedBy onto: .

ns1:Specification-Language a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Specification-Or-Computing-Language .

ns1:System-Administrator a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Employee .

ns1:Technical-Report-Reference a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Publication-Reference .

ns1:Telepresence-Research-Area a ns1:Research-Area ;
    rdfs:isDefinedBy onto: .

ns1:Thesis-Reference a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Publication-Reference .

ns1:Town a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Municipal-Unit .

ns1:Transportation-Device a owl:Class ;
    rdfs:comment "Something tangible designed to transport people, animals, objects from A to B. For instance a bycicle, a car, a boat, etc." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Generalised-Means-Of-Transport,
        <http://www.aktors.org/ontology/support#Tangible-Thing> .

ns1:Village a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Municipal-Unit .

ns1:Web-Based-Editor a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Editor .

ns1:Web-Browser a owl:Class ;
    rdfs:comment "A web browser is not a web-based system!" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Implemented-System .

ns1:Workshop a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Workshop-Proceedings-Reference ;
            owl:onProperty ns1:published-proceedings ],
        ns1:Meeting-Taking-Place,
        ns1:Publication-Type-Event .

ns1:address-area a owl:ObjectProperty ;
    rdfs:domain ns1:Address ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Local-District .

ns1:address-building a owl:DatatypeProperty ;
    rdfs:domain ns1:Address ;
    rdfs:isDefinedBy onto: .

ns1:address-city-or-village a owl:ObjectProperty ;
    rdfs:domain ns1:Address ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Municipal-Unit .

ns1:address-country a owl:ObjectProperty ;
    rdfs:domain ns1:Address ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Country .

ns1:address-number a owl:DatatypeProperty ;
    rdfs:domain ns1:Address ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:nonNegativeInteger .

ns1:address-postcode a owl:DatatypeProperty ;
    rdfs:domain ns1:Address ;
    rdfs:isDefinedBy onto: .

ns1:address-pretty-label a owl:DatatypeProperty ;
    rdfs:domain ns1:Address ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.aktors.org/ontology/support#has-pretty-name> .

ns1:address-region a owl:ObjectProperty ;
    rdfs:domain ns1:Address ;
    rdfs:isDefinedBy onto: ;
