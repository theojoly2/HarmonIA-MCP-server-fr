    ns1:sub-area-of ns1:Knowledge-Modelling ;
    rdfs:isDefinedBy onto: .

ns1:Organizational-Learning a ns1:Research-Area ;
    ns1:sub-area-of ns1:Learning-Research-Area ;
    rdfs:isDefinedBy onto: .

ns1:Partnership a owl:Class ;
    rdfs:comment "A partnership is not necessarily a company, e.g. a consultancy firm is not a company" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Profit-Organization .

ns1:PhD a ns1:Academic-Degree ;
    rdfs:isDefinedBy onto: .

ns1:Political-Organization a owl:Class ;
    rdfs:label "Political Organization" ;
    rdfs:comment "An organization which has a political connotation" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Organization .

ns1:Private-Company a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Company .

