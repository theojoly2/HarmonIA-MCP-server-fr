ns1:runs-on-operating-system-on-server-side a owl:ObjectProperty ;
    rdfs:domain ns1:Web-Based-System ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Operating-System ;
    rdfs:subPropertyOf ns1:runs-on-operating-system .

ns1:sender-of-message a owl:ObjectProperty ;
    rdfs:domain ns1:Message ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Generic-Agent .

