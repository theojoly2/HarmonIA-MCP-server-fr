    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Learning-Centred-Organization .

ns1:Social-Gathering a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Event .

ns1:Student a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Educational-Organization-Unit ;
            owl:onProperty ns1:studies-in-unit ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:studies-in-unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Educational-Organization ;
            owl:onProperty ns1:studies-at ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:studies-at ],
        ns1:Affiliated-Person .

ns1:Temporary-Contract a ns1:Employment-Contract-Type ;
    rdfs:isDefinedBy onto: .

