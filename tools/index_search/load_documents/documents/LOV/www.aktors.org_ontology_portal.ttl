    ns1:sub-area-of ns1:Knowledge-Management ;
    rdfs:isDefinedBy onto: .

ns1:Knowledge-Publishing a ns1:Research-Area ;
    ns1:sub-area-of ns1:Knowledge-Management ;
    rdfs:isDefinedBy onto: .

ns1:Knowledge-Retrieval a ns1:Research-Area ;
    ns1:sub-area-of ns1:Knowledge-Management ;
    rdfs:isDefinedBy onto: .

