    rdfs:domain ns1:Country ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Capital-City ;
    owl:inverseOf ns1:is-capital-of .

ns1:has-date a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:has-place-of-publication a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:headed-by a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Affiliated-Person .

ns1:included-in-publication a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:information-object-being-transferred a owl:ObjectProperty ;
    rdfs:domain ns1:Information-Transfer-Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Information-Bearing-Object .

ns1:information-transfer-medium-used a owl:ObjectProperty ;
    rdfs:domain ns1:Information-Transfer-Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Information-Transfer-Medium ;
    rdfs:subPropertyOf ns1:means-of-transport-used .

ns1:is-capital-of a owl:ObjectProperty ;
    rdfs:domain ns1:Capital-City ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Country ;
    owl:inverseOf ns1:has-capital .

ns1:large-size a ns1:Organization-Size ;
    rdfs:label "large" ;
    rdfs:comment "An organization with more than 250 employees" ;
    rdfs:isDefinedBy onto: .

ns1:location-at-end a owl:ObjectProperty ;
    rdfs:domain ns1:Event-Involving-Movement ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Location ;
    rdfs:subPropertyOf ns1:has-location .

ns1:location-at-start a owl:ObjectProperty ;
    rdfs:domain ns1:Event-Involving-Movement ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Location ;
    rdfs:subPropertyOf ns1:has-location .

ns1:means-of-transport-used a owl:ObjectProperty ;
    rdfs:domain ns1:Event-Involving-Movement ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Generalised-Means-Of-Transport .

ns1:micro-size a ns1:Organization-Size ;
    rdfs:label "micro" ;
    rdfs:comment "An organization with no more than 10 employees.  It also has to be independent, i.e., less than 25% owned by one enterprise (or jointly by several enterprises) falling outside the definition of micro-sized enterprise." ;
    rdfs:isDefinedBy onto: .

ns1:organization-part-of a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:produces-output a owl:ObjectProperty ;
    rdfs:domain ns1:Activity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.aktors.org/ontology/support#Thing> .

ns1:published-by a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:requires-hardware-platform a owl:ObjectProperty ;
    rdfs:domain ns1:Implemented-System ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Hardware-Platform .

ns1:requires-software-technology a owl:ObjectProperty ;
    rdfs:domain ns1:Implemented-System ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Software-Technology .

ns1:runs-on-operating-system a owl:ObjectProperty ;
    rdfs:domain ns1:Implemented-System ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Operating-System .

ns1:sender-of-information a owl:ObjectProperty ;
    rdfs:domain ns1:Information-Transfer-Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Generic-Agent ;
    rdfs:subPropertyOf ns1:has-main-agent .

ns1:sub-area-of a owl:ObjectProperty ;
    rdfs:domain ns1:Generic-Area-Of-Interest ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Generic-Area-Of-Interest .

ns1:supports-language a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Programming-Environment ns1:Editor ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Specification-Or-Computing-Language .

ns1:very-large-size a ns1:Organization-Size ;
    rdfs:label "very large" ;
    rdfs:comment "An organization with over 10000 employees" ;
    rdfs:isDefinedBy onto: .

ns1:Academic-Unit a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:University ;
            owl:onProperty ns1:unit-of-organization ],
        ns1:Educational-Organization-Unit .

ns1:Attending-An-Event a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Event .

ns1:Book-Reference a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Publishing-House ;
            owl:onProperty ns1:published-by ],
        ns1:Publication-Reference .

ns1:Capital-City a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:City .

ns1:Company a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Profit-Organization .

ns1:Computing-Technology a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Technology .

ns1:Editor a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Implemented-System .

ns1:Event-Involving-Production a owl:Class ;
    rdfs:comment "When something is produced" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Event .

ns1:Geographical-Region a owl:Class ;
    rdfs:comment "'Real' geographical regions" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Location,
        <http://www.aktors.org/ontology/support#Tangible-Thing> .

ns1:Government-Organization a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Non-Profit-Organization .

ns1:Information-Transfer-Medium a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Generalised-Means-Of-Transport .

ns1:Knowledge-Modelling a ns1:Research-Area ;
    ns1:sub-area-of ns1:Knowledge-Management ;
    rdfs:isDefinedBy onto: .

ns1:Learning-Centred-Organization a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Organization .

ns1:Non-Profit-Organization a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Organization .

ns1:Researcher a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Working-Person .

ns1:Work-Status a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing> ;
    owl:oneOf ( ns1:Full-Time ns1:Part-Time ) .

ns1:contains-article a owl:ObjectProperty ;
    rdfs:subPropertyOf ns1:contains-publication .

ns1:has-location a owl:ObjectProperty ;
    rdfs:comment "The location at which an event takes place" ;
    rdfs:domain ns1:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Location .

ns1:has-other-agents-involved a owl:ObjectProperty ;
    rdfs:comment "Other agents involved in the event" ;
    rdfs:domain ns1:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Generic-Agent .

ns1:has-project-member a owl:ObjectProperty ;
    rdfs:domain ns1:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person .

ns1:involves-organization a owl:ObjectProperty ;
    rdfs:domain ns1:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization .

ns1:medium-size a ns1:Organization-Size ;
    rdfs:label "medium" ;
    rdfs:comment "An organization with no more than 250 employees.  It also has to be independent, i.e., less than 25% owned by one enterprise (or jointly by several enterprises) falling outside the definition of medium-sized enterprise. Finally, either the turnover total must be less than 40M Euros or the balance sheet total must be less than 27M Euros." ;
    rdfs:isDefinedBy onto: .

ns1:owned-by a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Information-Bearing-Object ns1:Technology ns1:Method ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Legal-Agent .

ns1:published-proceedings a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:event-product .

ns1:small-size a ns1:Organization-Size ;
    rdfs:label "small" ;
    rdfs:comment "An organization with no more than 50 employees.  It also has to be independent, i.e., less than 25% owned by one enterprise (or jointly by several enterprises) falling outside the definition of small-sized enterprise. Finally, either the turnover total must be less than 7M Euros or the balance sheet total must be less than 5M Euros." ;
    rdfs:isDefinedBy onto: .

ns1:studies-in-unit a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:has-affiliation-to-unit .

ns1:thing-acted-on a owl:ObjectProperty ;
    rdfs:comment "What is being transferred" ;
    rdfs:domain ns1:Generalized-Transfer ;
    rdfs:isDefinedBy onto: .

ns1:unit-of-organization a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization .

ns1:Abstract-Information a owl:Class ;
    rdfs:comment "Information in general, independent of an object in which it is encoded. Whatever is transferred in an information-transfer event. It is clearly an intangible thing" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing> .

ns1:Award a owl:Class ;
    rdfs:comment "An award is an intangible thing, even if the piece of paper which is often associated with an award is tangible.  What about the virtual piece of paper in the virtual degree ceremony?  I guess that ought to be an intangible" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing> .

ns1:Conferring-An-Award a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Generalized-Transfer .

ns1:Currency a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Information-Bearing-Object .

ns1:Educational-Employee a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:works-for ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Educational-Organization ;
            owl:onProperty ns1:works-for ],
        ns1:Employee .

ns1:Educational-Organization-Unit a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Educational-Organization ;
            owl:onProperty ns1:unit-of-organization ],
        ns1:Organization-Unit .

ns1:Employment-Contract-Type a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing> ;
    owl:oneOf ( ns1:Permanent-Contract ns1:Temporary-Contract ) .

ns1:Gender a owl:Class ;
    rdfs:comment "HPKB says that genders are intangible..Uhm..." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing> ;
    owl:oneOf ( ns1:Male-Gender ns1:Female-Gender ) .

ns1:Generalised-Means-Of-Transport a owl:Class ;
    rdfs:comment "This is a generic class to catch all sorts of borderline and metaphorical ways to carry things from A to B" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Thing> .

ns1:Geopolitical-Entity a owl:Class ;
    rdfs:comment "A geopolitical entity is a geographical area which is associated with some sort of political structure. For instance, Russia, Italy, The-city-of-Messina, etc. A geopolitical entity can be also seen as an agent - e.g., France declared war to Spain" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Generic-Agent,
        ns1:Geographical-Region .

ns1:Government a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Government-Organization .

ns1:Hardware-Platform a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Hardware-Technology .

ns1:Hypermedia a ns1:Research-Area ;
    rdfs:isDefinedBy onto: .

ns1:Journal a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Publication ;
            owl:onProperty ns1:contains-article ],
        ns1:Composite-Publication,
        ns1:Serial-Publication ;
    owl:disjointWith ns1:Magazine,
        ns1:Newspaper .

ns1:Magazine a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Publication ;
            owl:onProperty ns1:contains-article ],
        ns1:Composite-Publication,
        ns1:Serial-Publication ;
    owl:disjointWith ns1:Journal,
        ns1:Newspaper .

ns1:Operating-System a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Implemented-System .

ns1:Publication-Type-Event a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Publication ;
            owl:onProperty ns1:event-product ],
        ns1:Event-Involving-Production .

ns1:Researcher-In-Academia a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Academic,
        ns1:Researcher .

ns1:Serial-Publication a owl:Class ;
    rdfs:comment "This used to be called periodical publication.  However, many periodicals do not appear at fixed intervals, which is why librarians refer to them as serials. So, we now use the concept of serial publication and the has-periodicity slot has been removed" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Publication ;
    owl:unionOf ( ns1:Journal ns1:Magazine ns1:Newspaper ) .

ns1:Visiting-Researcher a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Affiliated-Person,
        ns1:Researcher .

ns1:Working-Person a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Person .

ns1:event-product a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Event-Involving-Production .

ns1:has-affiliation-to-unit a owl:ObjectProperty ;
    rdfs:domain ns1:Affiliated-Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization-Unit .

ns1:has-main-agent a owl:ObjectProperty ;
    rdfs:comment "The agents causing the event to happen, if they are known." ;
    rdfs:domain ns1:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Generic-Agent .

ns1:has-periodicity a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:has-size a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization-Size .

ns1:has-sub-unit a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization-Unit .

ns1:studies-at a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:has-affiliation .

ns1:Composite-Publication a owl:Class ;
    rdfs:comment "A publication which contains items which cane be themselves referenced through a publication reference.  Composite publications include newspapers, magazines and journals. A book which is a collection of articles is a composite publication, a monograph is not" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Publication ;
            owl:onProperty ns1:contains-publication ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:contains-publication ] .

ns1:Event-Involving-Movement a owl:Class ;
    rdfs:comment "This is an event in which the main agent (plus maybe others) goes from some place to another" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:location-at-end ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:location-at-start ],
        ns1:Event .

ns1:Generalized-Transfer a owl:Class ;
    rdfs:comment "An event in which the main agent transfers something (the thing-acted-on, tangible or intangible) to one or more recipient agents. Note that we do not say anything about whether the original agent still retain the thing-acted-on.  In some cases this is clearly true ('I pass my wisdom on to my daughter'), in other cases it is not (I give you my wallet)." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Event-Involving-Movement .

ns1:Higher-Educational-Organization a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Educational-Organization .

ns1:Meeting-Taking-Place a owl:Class ;
    rdfs:comment "A meeting type of event. Note that both attendee and organizer have multiple cardinality" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Social-Gathering .

ns1:Municipal-Unit a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Geopolitical-Entity .

ns1:Newspaper a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:News-Item ;
            owl:onProperty ns1:contains-news-item ],
        ns1:Composite-Publication,
        ns1:Periodical-Publication ;
    owl:disjointWith ns1:Journal,
        ns1:Magazine .

ns1:Profit-Organization a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Organization .

ns1:Specification-Or-Computing-Language a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Software-Technology .

ns1:University a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Higher-Educational-Organization .

ns1:contains-publication a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:has-affiliation a owl:ObjectProperty ;
    rdfs:domain ns1:Affiliated-Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization .

ns1:works-for a owl:ObjectProperty ;
    rdfs:domain ns1:Employee ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization ;
    rdfs:subPropertyOf ns1:has-affiliation .

ns1:Academic a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Higher-Educational-Organization ;
            owl:onProperty ns1:works-for ],
        ns1:Educational-Employee .

ns1:Activity a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Temporal-Thing> .

ns1:Educational-Organization a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Learning-Centred-Organization .

ns1:Generic-Area-Of-Interest a owl:Class ;
    rdfs:comment "A generic class to specify generic areas for research or business initiatives. For instance, the area in which a project is situated" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing> .

ns1:Legal-Agent a owl:Class ;
    rdfs:label "Legal Agent" ;
    rdfs:comment "Some agents have legal status: definitely organizations and people, anybody else?" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Generic-Agent .

ns1:Location a owl:Class ;
    rdfs:comment "A generic class for locations.  It includes both real and fantastic places" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Tangible-Thing> .

ns1:Message a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Information-Bearing-Object .

ns1:Software-Technology a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Computing-Technology .

ns1:has-author a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Information-Bearing-Object ns1:Publication-Reference ns1:Technology ns1:Method ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Generic-Agent .

ns1:Country a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Geopolitical-Entity .

ns1:Information-Transfer-Event a owl:Class ;
    rdfs:comment "A generalized transfer in which information is passed from main agent to one or more recipient agents.  Examples include giving a tutorial." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Generalized-Transfer .

ns1:Project a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:Event ns1:Technology ns1:Method ns1:Organization ns1:Information-Bearing-Object ) ] ;
            owl:onProperty ns1:produces-output ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:has-project-member ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:involves-organization ],
        ns1:Activity .

ns1:Software-Status a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing> .

ns1:Web-Based-System a owl:Class ;
    rdfs:comment "A system which is accessible through the web" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Implemented-System .

ns1:has-publication-reference a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:Academic-Degree a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Degree .

ns1:Knowledge-Management a ns1:Research-Area ;
    rdfs:isDefinedBy onto: .

ns1:Method a owl:Class ;
    rdfs:comment "Merrian-Webster has a good set of definitions for a method. They say it is 'a systematic procedure, technique, or mode of inquiry employed by or proper to a particular discipline or art;  a systematic plan followed in presenting material for instruction; a way, technique, or process of or for doing something; a body of skills or techniques'. This is very much also what we mean by method." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Organization ;
            owl:onProperty ns1:owned-by ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:has-author ],
        <http://www.aktors.org/ontology/support#Intangible-Thing> .

ns1:Organization-Size a owl:Class ;
    rdfs:label "Organization Size" ;
    rdfs:comment "We use EU guidelines to distinguish between different organization sizes" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing> ;
    owl:oneOf ( ns1:very-large-size ns1:large-size ns1:medium-size ns1:small-size ns1:micro-size ) .

ns1:Publication a owl:Class ;
    rdfs:comment "A publication is something which has one or more publication references. A publication can be both an article in a journal or a journal itself. The distinction between publication and publication-reference makes it possible to distinguish between multiple occurrences of the sam publication, for instance in different media" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Publication-Reference ;
            owl:onProperty ns1:has-publication-reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Publication-Reference ;
            owl:onProperty ns1:cites-publication-reference ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:has-publication-reference ],
        ns1:Information-Bearing-Object .

ns1:Technology a owl:Class ;
    rdfs:comment "By technology we mean engineered applications of science. I guess we are probably confining ourselves to tangible things but as I am not sure I will use thing as the direct superclass - e.g., an algorithm is an intangible thing, but it could be seen as a technology, if we give a broad interpretation of the term" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Generic-Agent ;
            owl:onProperty ns1:has-author ],
        <http://www.aktors.org/ontology/support#Thing> .

ns1:Affiliated-Person a owl:Class ;
    rdfs:comment "A person which has an affiliation with some organization. For instance employees are affiliated to the organization they work for, students to the institution where they are studying, etc. A person can have multiple affiliations, which means that there is no constraint relating the values of slot has-affiliation-to-unit to the values of slot has-affiliation" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:has-affiliation ],
        ns1:Person .

ns1:Appellation a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing> .

ns1:Employee a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Affiliated-Person,
        ns1:Working-Person .

ns1:Event a owl:Class ;
    rdfs:comment "This is a minimalist definition of class event.  We start with the very basic and we will then add slots as we specialise this definition for specific classes of events. The fillers of slots has-other-agents-involved and has-main-agent should not intersect" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Temporal-Thing> .

ns1:Address a owl:Class ;
    rdfs:comment "A generic class for addresses, whether email or postal. We see an address as abstract information and therefore it is an intangible thing" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Abstract-Information .

ns1:Implemented-System a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Software-Technology .

ns1:Information-Bearing-Object a owl:Class ;
    rdfs:comment "This notion comes from Cyc.  It is useful to group together all information bearing entities, including video, audio and documents. An information bearing object may have an author (a generic agent) and may be owned by a legal agent. It is a tangible object" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Legal-Agent ;
            owl:onProperty ns1:owned-by ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Generic-Agent ;
            owl:onProperty ns1:has-author ],
        <http://www.aktors.org/ontology/support#Tangible-Thing> .

ns1:Organization-Unit a owl:Class ;
    rdfs:comment "An organization may have a number of units. Units may themselves have sub-units" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Generic-Agent .

ns1:Publication-Reference a owl:Class ;
    rdfs:comment "we have decided that a publication reference is an intangible, abstract information" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Generic-Agent ;
            owl:onProperty ns1:has-author ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Location ;
            owl:onProperty ns1:has-place-of-publication ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://www.aktors.org/ontology/support#Calendar-Date> ;
            owl:onProperty ns1:has-date ],
        ns1:Abstract-Information .

ns1:Generic-Agent a owl:Class ;
    rdfs:label "Generic Agent" ;
    rdfs:comment "This is a generic notion, an agent can be an organization, a person an animal, a software agent, etc" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.aktors.org/ontology/support#Temporal-Thing> .

ns1:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An organization is a type of legal agent" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Organization-Size ;
            owl:onProperty ns1:has-size ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Organization-Unit ;
            owl:onProperty ns1:has-sub-unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Affiliated-Person ;
            owl:onProperty ns1:affiliated-person ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:has-size ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Organization ;
            owl:onProperty ns1:organization-part-of ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Affiliated-Person ;
            owl:onProperty ns1:headed-by ],
        ns1:Legal-Agent .

ns1:Person a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Legal-Agent,
        <http://www.aktors.org/ontology/support#Tangible-Thing> .

ns1:Research-Area a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Research-Area ;
            owl:onProperty ns1:sub-area-of ],
        ns1:Generic-Area-Of-Interest .

onto: a owl:Ontology ;
    rdfs:label "AKT Reference Ontology (Portal Ontology)" ;
    dc:creator "AKT Project",
        "Enrico Motta (OCML version)",
        "Nick Gibbins (OWL translation)" ;
    dc:description "The AKT Reference Ontology has been designed to support the AKT-2 demonstrator (\"AKTive Portal\"), and subsequent activities. The ontology, designed by the AKT-2 group and codified by Enrico Motta, extends Version 1."@en ;
    dc:source <http://d3e.open.ac.uk/akt/2002/ref-onto.html> ;
    dc:title "AKT Reference Ontology (Portal Ontology)"@en ;
    dcterms:created "2003-02-10" ;
    rdfs:seeAlso <http://d3e.open.ac.uk/akt/2002/ref-onto.html> ;
    owl:imports <http://www.aktors.org/ontology/support> ;
    owl:versionInfo "2.0" .

