@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.aktors.org/ontology/portal#> .
@prefix onto: <http://www.aktors.org/ontology/portal> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

ns1:Adaptive-Hypermedia a ns1:Research-Area ;
    ns1:sub-area-of ns1:Hypermedia ;
    rdfs:isDefinedBy onto: .

ns1:Agent-Based-Computing a ns1:Research-Area ;
    rdfs:isDefinedBy onto: .

ns1:Alpha-Version a ns1:Software-Status ;
    rdfs:isDefinedBy onto: .

ns1:Article-Reference a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Publication-Reference .

ns1:Artificial-Intelligence-Research-Area a ns1:Research-Area ;
    rdfs:isDefinedBy onto: .

ns1:Attending-A-Conference a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Conference ;
            owl:onProperty ns1:event-attended ],
        ns1:Attending-An-Event .

ns1:BA a ns1:Academic-Degree ;
    rdfs:isDefinedBy onto: .

ns1:BSc a ns1:Academic-Degree ;
    rdfs:isDefinedBy onto: .

ns1:Beta-Version a ns1:Software-Status ;
