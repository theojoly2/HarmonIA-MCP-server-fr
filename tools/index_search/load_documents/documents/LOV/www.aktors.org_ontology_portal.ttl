    rdfs:domain ns1:University ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:University-Faculty .

ns1:has-fax-number a owl:DatatypeProperty ;
    rdfs:isDefinedBy onto: .

ns1:has-gender a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Gender .

ns1:has-goals a owl:DatatypeProperty ;
    rdfs:domain ns1:Project ;
    rdfs:isDefinedBy onto: .

ns1:has-government a owl:ObjectProperty ;
    rdfs:domain ns1:Country ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Government .

ns1:has-job-title a owl:DatatypeProperty ;
    rdfs:domain ns1:Employee ;
    rdfs:isDefinedBy onto: .

ns1:has-leading-organization a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:involves-organization .

ns1:has-page-numbers a owl:DatatypeProperty ;
    rdfs:isDefinedBy onto: .

ns1:has-postal-address a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Postal-Address .

ns1:has-project-leader a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
