    rdfs:isDefinedBy onto: .

ns1:Edited-Book a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:has-publication-reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Edited-Book-Reference ;
            owl:onProperty ns1:has-publication-reference ],
        ns1:Publication .

ns1:Experimental-Version a ns1:Software-Status ;
    rdfs:isDefinedBy onto: .

ns1:Financial-Award a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Award .

