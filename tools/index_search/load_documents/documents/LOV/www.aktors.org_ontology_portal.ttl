    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Publication-Reference .

ns1:Web-Research-Area a ns1:Research-Area ;
    rdfs:isDefinedBy onto: .

ns1:Web-Site a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Implemented-System,
        ns1:Information-Bearing-Object .

ns1:Workshop-Proceedings-Reference a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Publication-Reference .

ns1:affiliated-person a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:cites-publication-reference a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:contains-news-item a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:contains-publication .

ns1:edited-by a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns1:has-author .

ns1:event-attended a owl:ObjectProperty ;
    rdfs:domain ns1:Attending-An-Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Event .

