ns1:has-research-interest a owl:ObjectProperty ;
    rdfs:comment "People and in general even organizations and organization units may have research interests.  This relation shoudl be used to specify them" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Organization-Unit ns1:Organization ns1:Person ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Research-Area .

ns1:has-speaker a owl:ObjectProperty ;
    rdfs:domain ns1:Giving-A-Talk ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:sender-of-information .

ns1:has-status a owl:ObjectProperty ;
    rdfs:comment "Whether the software is released, alpha or beta" ;
    rdfs:domain ns1:Implemented-System ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Software-Status .

ns1:has-sub-activity a owl:ObjectProperty ;
    rdfs:domain ns1:Activity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Activity .

ns1:has-supervisor a owl:ObjectProperty ;
    rdfs:domain ns1:PhD-Student ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person .

ns1:has-support-unit a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Academic-Support-Unit ;
    rdfs:subPropertyOf ns1:has-sub-unit .

ns1:has-telephone-number a owl:DatatypeProperty ;
    rdfs:isDefinedBy onto: .

ns1:has-title a owl:DatatypeProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.aktors.org/ontology/support#has-pretty-name> .

ns1:has-vice-chancellor a owl:ObjectProperty ;
    rdfs:domain ns1:University ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Educational-Employee .

ns1:has-web-address a owl:DatatypeProperty ;
    rdfs:label "has web address" ;
    rdfs:isDefinedBy onto: .

ns1:information-being-transferred a owl:ObjectProperty ;
    rdfs:domain ns1:Information-Transfer-Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Abstract-Information ;
    rdfs:subPropertyOf ns1:thing-acted-on .

ns1:issued-by a owl:ObjectProperty ;
    rdfs:domain ns1:Currency ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Government .

ns1:meeting-attendee a owl:ObjectProperty ;
    rdfs:domain ns1:Meeting-Taking-Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:has-other-agents-involved .

ns1:meeting-organizer a owl:ObjectProperty ;
    rdfs:domain ns1:Meeting-Taking-Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:has-main-agent .

ns1:method-builds-on a owl:ObjectProperty ;
    rdfs:domain ns1:Method ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Method .

ns1:organization-being-visited a owl:ObjectProperty ;
    rdfs:domain ns1:Visiting-Researcher ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization ;
    rdfs:subPropertyOf ns1:has-affiliation .

ns1:organization-unit-being-visited a owl:ObjectProperty ;
    rdfs:domain ns1:Visiting-Researcher ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization-Unit ;
    rdfs:subPropertyOf ns1:has-affiliation-to-unit .

ns1:person-being-visited a owl:ObjectProperty ;
    rdfs:domain ns1:Visiting-Researcher ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person .

ns1:project-involves-organization-unit a owl:ObjectProperty ;
    rdfs:comment "It is sufficient that somebody in unit ?u works in project ?p" ;
    rdfs:domain ns1:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization-Unit .

ns1:published-book a owl:ObjectProperty ;
    rdfs:domain ns1:Book-Publishing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Book ;
    rdfs:subPropertyOf ns1:event-product .

ns1:recipient-agents a owl:ObjectProperty ;
    rdfs:comment "The agents which receive the thing-acted-on" ;
    rdfs:domain ns1:Generalized-Transfer ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Generic-Agent ;
    rdfs:subPropertyOf ns1:has-other-agents-involved .

ns1:recipient-of-message a owl:ObjectProperty ;
    rdfs:domain ns1:Message ;
    rdfs:isDefinedBy onto: ;
