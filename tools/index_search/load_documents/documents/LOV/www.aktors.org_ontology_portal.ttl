        <http://www.aktors.org/ontology/support#Physical-Quantity> .

ns1:Article-In-A-Composite-Publication a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Composite-Publication ;
            owl:onProperty ns1:included-in-publication ],
        ns1:Publication .

ns1:Awarding-Body a owl:Class ;
    rdfs:comment "Legal agents can be either organizations or people. An awarding body is normally an organization, an individual, or a bunch of people" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Legal-Agent .

ns1:Book a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:has-publication-reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Book-Reference ;
            owl:onProperty ns1:has-publication-reference ],
        ns1:Publication .

ns1:Book-Publishing a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Publication-Type-Event .

