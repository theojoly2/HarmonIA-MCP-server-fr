    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Technology ns1:Method ns1:Project ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Generic-Area-Of-Interest .

ns1:affiliated-people a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Affiliated-Person .

ns1:confers-award a owl:ObjectProperty ;
    rdfs:domain ns1:Conferring-An-Award ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Award ;
    rdfs:subPropertyOf ns1:thing-acted-on .

ns1:contains-property a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:family-name a owl:DatatypeProperty ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: .

ns1:full-name a owl:DatatypeProperty ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.aktors.org/ontology/support#has-pretty-name> .

ns1:funding-source a owl:ObjectProperty ;
    rdfs:domain ns1:Project ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Organization .

ns1:given-name a owl:DatatypeProperty ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: .

ns1:government-of-country a owl:ObjectProperty ;
    rdfs:domain ns1:Government ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Country .

ns1:has-ISBN-number a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: .

ns1:has-URL a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Web-Reference ns1:Web-Site ) ] ;
    rdfs:isDefinedBy onto: .

ns1:has-academic-degree a owl:ObjectProperty ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Academic-Degree .

