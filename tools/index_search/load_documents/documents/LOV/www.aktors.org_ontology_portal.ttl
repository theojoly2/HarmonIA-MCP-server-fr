    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Municipal-Unit .

ns1:Computing-Research-Area a ns1:Research-Area ;
    rdfs:isDefinedBy onto: .

ns1:Conference a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Conference-Proceedings-Reference ;
            owl:onProperty ns1:published-proceedings ],
        ns1:Meeting-Taking-Place,
