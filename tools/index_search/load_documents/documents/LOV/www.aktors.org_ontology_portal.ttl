    rdfs:isDefinedBy onto: .

ns1:Mr a ns1:Appellation ;
    rdfs:isDefinedBy onto: .

ns1:Mrs a ns1:Appellation ;
    rdfs:isDefinedBy onto: .

ns1:Ms a ns1:Appellation ;
    rdfs:isDefinedBy onto: .

