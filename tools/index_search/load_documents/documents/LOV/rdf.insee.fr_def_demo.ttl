@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix ns2: <http://www.w3.org/ns/adms#> .
@prefix ns3: <http://purl.org/vocommons/voaf#> .
@prefix onto: <http://rdf.insee.fr/def/demo> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://rdf.insee.fr/def/demo#date> a owl:DatatypeProperty ;
    rdfs:label "date de référence"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/demo#PopulationLegale> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:date .

<http://rdf.insee.fr/def/demo#population> a owl:ObjectProperty ;
    rdfs:label "population"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/geo#TerritoireFrancais> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf.insee.fr/def/demo#PopulationLegale> .

<http://rdf.insee.fr/def/demo#populationCompteeAPart> a owl:DatatypeProperty ;
    rdfs:label "population comptée à part"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/demo#PopulationLegale> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:nonNegativeInteger ;
    ns2:relatedWebPage <http://insee.fr/fr/methodes/definitions/popul-comptee-a-part-rrp.htm> .

<http://rdf.insee.fr/def/demo#populationMunicipale> a owl:DatatypeProperty ;
    rdfs:label "population municipale"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/demo#PopulationLegale> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:nonNegativeInteger ;
    ns2:relatedWebPage <http://insee.fr/fr/methodes/definitions/population-municipale-rrp.htm> .

<http://rdf.insee.fr/def/demo#populationTotale> a owl:DatatypeProperty ;
    rdfs:label "population totale"@fr ;
    rdfs:domain <http://rdf.insee.fr/def/demo#PopulationLegale> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:nonNegativeInteger ;
    ns2:relatedWebPage <http://insee.fr/fr/methodes/definitions/population-totale-rrp.htm> .

<http://rdf.insee.fr/def/geo#TerritoireFrancais> a owl:Class .

<http://rdf.insee.fr/def/demo#PopulationLegale> a owl:Class ;
    rdfs:label "Population légale"@fr ;
    rdfs:comment "Population légale datée et déclinée en 'municipale', 'comptée à part' et 'totale'"@fr ;
    rdfs:isDefinedBy onto: .

onto: a ns3:Vocabulary,
        owl:Ontology ;
    ns1:license <http://www.data.gouv.fr/Licence-Ouverte-Open-Licence> ;
    dc:rights "Copyright © 2013 INSEE" ;
    dcterms:creator [ a foaf:Person ;
            foaf:name "Franck Cotton" ],
        [ a foaf:Person ;
            foaf:name "Franck Cotton" ] ;
    dcterms:description "Ontologie des classes et propriétés utilisées pour la démographie, notamment le recensement de la population"@fr ;
    dcterms:issued "2012-08-14" ;
    dcterms:modified "2012-12-26" ;
    dcterms:publisher <http://dbpedia.org/resource/INSEE> ;
    dcterms:title "Ontologie démographique de l'INSEE"@fr ;
    vann:preferredNamespacePrefix "idemo" ;
    vann:preferredNamespaceUri <http://rdf.insee.fr/def/demo#> ;
    ns3:classNumber 1 ;
    ns3:propertyNumber 5 ;
    owl:versionInfo "Version 0.3 - 2012-12-26" .

