<http://dbpedia.org/resource/University_of_Bonn> a dcterms:Agent,
        foaf:Organization ;
    rdfs:label "University of Bonn" .

onto:Action a owl:Class ;
    rdfs:label "Action"@en ;
    dcterms:created "2017-06-23"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Action that is done."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

<http://purl.org/goodrelations/v1#BusinessEntity> a owl:class ;
    rdfs:label "Business entity"@en ;
    rdfs:comment "An instance of this class represents the legal agent making (or seeking) a particular offering. This can be a legal body or a person. A business entity has at least a primary mailing address and contact details. For this, typical address standards (vCard) and location data (geo, WGS84) can be attached. Note that the location of the business entity is not necessarily the location from which the product or service is being available."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1#> .

onto:AccessCondition a owl:Class ;
    rdfs:label "Access condition"@en ;
    dcterms:created "2017-08-29"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "A condition that has to be fullfilled to get access to a civic structure."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

ns2:Place a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "Entities that have a somewhat fixed, physical extension."@en ;
    rdfs:isDefinedBy ns2: .

<https://ns.eccenca.com/eccenca-GmbH> a dcterms:Agent,
        foaf:Organization ;
    foaf:name "eccenca GmbH" .

onto:TimeSpecification a owl:Class ;
    rdfs:label "Time specification"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Specific time a price specification is due for."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

ns2:PriceSpecification a owl:Class ;
    rdfs:label "Price specification"@en ;
    rdfs:comment "A structured value representing a price or price range for an item."@en ;
    rdfs:isDefinedBy ns2: .

ns2:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:comment "A vehicle is a device that is designed or used to transport people or cargo over land, water, air, or through space."@en ;
    rdfs:isDefinedBy ns2: .

onto:UserGroup a owl:Class ;
    rdfs:label "User group"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "A group of users having a common characteristic."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

ns2:CivicStructure a owl:Class ;
    rdfs:label "Civic structure"@en ;
    rdfs:comment "A public structure, such as a town hall or concert hall, parking facility or charging point."@en ;
    rdfs:isDefinedBy ns2: ;
    rdfs:subClassOf ns2:Place .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    rdfs:label "MobiVoc: Open Mobility Vocabulary"@en ;
    ns3:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:contributor <http://eis.iai.uni-bonn.de/NiklasPetersen>,
        <http://purl.org/net/clange>,
        <http://sebastian.tramp.name> ;
    dcterms:created "2014-08-05"^^xsd:date ;
    dcterms:creator <https://ns.eccenca.com/aweilandt>,
        <https://ns.eccenca.com/mbruemmer> ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    dcterms:publisher <https://ns.eccenca.com/eccenca-GmbH> ;
    vann:preferredNamespacePrefix "mv" ;
    vann:preferredNamespaceUri "http://schema.mobivoc.org/" ;
    void:vocabulary vann:,
        foaf: ;
    rdfs:comment "Our goal is to significantly improve the data mobility between all stakeholders by providing a standardized vocabulary using Semantic Web technologies and ontologies. For the open vocabulary covering various mobility aspects we use RDF (Resource Description Framework) - a recommended specification of the World Wide Web Consortium (W3C) and the so-called lingua franca for the integration of data and web. We invite everyone who is interested to join our MobiVoc initiative and to participate in the development of the Open Mobility Vocabulary." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "v1.0.0" .

