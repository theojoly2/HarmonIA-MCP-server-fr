onto:ParkingLot a rdfs:Class,
        owl:Class ;
    rdfs:label "Parking lot"@en ;
    dcterms:created "2017-05-30"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Parking area on a single groundfloor level that is usually located outdoor." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ParkingFacility ;
    ns1:term_status "stable" ;
    skos:altLabel "car lot"@en ;
    skos:prefLabel "Car park"@en-uk,
        "Parking lot"@en-us .

onto:ParkingSpace a rdfs:Class,
        owl:Class ;
    rdfs:label "Parking space"@en ;
    dcterms:created "2017-05-10"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "A parking space is a location that is designated for parking a vehicle. A parking space has a certain size, is sometimes marked and can be located at roadside or inside a parking facility. Depending on the location of the parking space, there can be regulations regarding the time allowed to park and a fee paid to use the parking space."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns2:CivicStructure ;
    ns1:term_status "stable" ;
    skos:prefLabel "Parking space"@en .

onto:Plug a rdfs:Class,
        owl:Class ;
    rdfs:label "Plug"@en ;
    rdfs:comment "Component of a charger to connect an electric vehicle. There are different plug types used for charging electric vehicles." ;
    rdfs:isDefinedBy onto: .

onto:PlugType a rdfs:Class,
        owl:Class ;
    rdfs:label "Plug type"@en ;
    rdfs:comment "Type of a plug that is used to connect electric vehicles." ;
    rdfs:isDefinedBy onto: .

onto:RealTimeCapacity a rdfs:Class,
        owl:Class ;
    rdfs:label "Real time capacity"@en ;
    dcterms:created "2017-04-05"^^xsd:date,
        "2017-05-15"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Real-time capacity of a civic structure."@en,
        "Real-time capacity of a parking facility or parking space."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Capacity ;
    ns1:term_status "stable" .

onto:UndergroundParkingGarage a rdfs:Class,
        owl:Class ;
    rdfs:label "Underground parking garage"@en ;
    dcterms:created "2017-04-13"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Parking facility with one or more levels below the surface and none above ground." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ParkingFacility ;
    ns1:term_status "stable" ;
    skos:prefLabel "Underground parking garage"@en .

