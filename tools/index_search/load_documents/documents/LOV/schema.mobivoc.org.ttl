onto:ArrangementPattern a rdfs:Class,
        owl:Class ;
    rdfs:label "Arrangement pattern"@en ;
    dcterms:created "2017-05-10"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Pattern how parking spaces are arranged in a parking facility or at roadside."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:AutomatedParkingGarage a rdfs:Class,
        owl:Class ;
    rdfs:label "Automated parking garage"@en ;
    dcterms:created "2017-04-13"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Parking garage with an automated parking system that automatically moves cars to the available parking space somewhere in the garage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ParkingFacility ;
    ns1:term_status "stable" .

onto:BicycleParkingStation a rdfs:Class,
        owl:Class ;
    rdfs:label "Bicycle parking station"@en ;
    dcterms:created "2017-05-10"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Building or structure designed for use as a bicycle parking facility."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ParkingFacility ;
    ns1:term_status "stable" .

onto:Capacity a rdfs:Class,
        owl:Class ;
    rdfs:label "Capacity"@en ;
    dcterms:created "2017-04-13"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Capacity of a civic structure."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:Charger a rdfs:Class,
        owl:Class ;
    rdfs:label "Charger"@en ;
    rdfs:comment "Component of a charging point used to charge electric vehicles. A charging point can have one or more chargers." ;
    rdfs:isDefinedBy onto: .

onto:ChargingPoint a rdfs:Class,
        owl:Class ;
    rdfs:label "Charging point"@en ;
    rdfs:comment "Civic structure that supplies electric energy for the recharging of electric vehicles." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns2:CivicStructure .

onto:CivicStructureStatus a rdfs:Class,
        owl:Class ;
    rdfs:label "Civic structure status"@en ;
    dcterms:created "2018-01-11"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Status information of a civic structure." ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:ParkingFacility a rdfs:Class,
        owl:Class ;
    rdfs:label "Parking facility"@en ;
    dcterms:created "2014-10-16"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Any facility or area assigned for parking vehicles. A parking facility can provide one or more parking spaces."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns2:CivicStructure ;
    owl:equivalentClass ns2:ParkingFacility ;
    ns1:term_status "stable" .

onto:ParkingFacilityConnection a rdfs:Class,
        owl:Class ;
    rdfs:label "Parking facility connections"@en ;
    dcterms:created "2017-06-09"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Transport connections available at the parking facility (e.g. Park & Ride)." ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:ParkingFacilityEntrance a rdfs:Class,
        owl:Class ;
    rdfs:label "Entrance"@en ;
    dcterms:created "2017-05-10"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Entrance of a parking facility where vehicles can enter the parking facility."@en ;
