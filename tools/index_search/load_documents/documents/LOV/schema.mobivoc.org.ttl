    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Features of the parking facility (e.g. parking for disabled people)." ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:ParkingGarage a rdfs:Class,
        owl:Class ;
    rdfs:label "Parking garage"@en ;
    dcterms:created "2017-04-13"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "A single level or multilevel parking building to park at." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:ParkingFacility ;
    ns1:term_status "stable" ;
    skos:altLabel "Car park"@en,
        "Parking building"@en,
        "Parking structure"@en ;
