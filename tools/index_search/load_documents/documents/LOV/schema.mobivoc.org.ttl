onto:ParallelParking a onto:ArrangementPattern ;
    rdfs:label "Parallel parking"@en ;
    dcterms:created "2017-05-10"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "With parallel parking, vehicles are arranged in a line, with the front of one vehicle facing the back of an adjacent one. This is done parallel to a curb, when one is provided. Parallel parking is the most common mode of roadside parking for vehicles."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" ;
    skos:prefLabel "Parallel parking"@en .

