onto:level a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "level"@en ;
    dcterms:created "2018-01-11"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the level of a parking facility the parking space is located in."@en ;
    rdfs:domain onto:ParkingSpace ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    ns1:term_status "stable" .

onto:maximumValue a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "maximum value"@en ;
    dcterms:created "2015-05-15"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the maximum value of the capacity."@en ;
    rdfs:domain onto:Capacity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    ns1:term_status "stable" .

onto:model a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "model"@en ;
    rdfs:comment "Indicates the charger model of the charging point." ;
    rdfs:domain onto:Charger ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:name a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    dcterms:created "2017-04-13"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Name of the civic structure or facility." ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:numberOfLevels a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "number of levels"@en ;
    dcterms:created "2018-01-11"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the total number of levels a parking facility has."@en ;
    rdfs:domain onto:ParkingFacility ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    ns1:term_status "stable" .

onto:ocmConnectionID a owl:AnnotationProperty ;
    rdfs:label "ocm connection ID"@en ;
    rdfs:comment "The OpenChargeMap ID used for the Connection / Plug." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

onto:operatedBy a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "operated by"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "The operator of a civic structure or facility. Operator and owner can be different business entitites."@en ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/goodrelations/v1#BusinessEntity> ;
    ns1:term_status "stable" .

onto:overnight a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "overnight"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates that a time period overnight is possible." ;
    rdfs:domain onto:TimeSpecification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    ns1:term_status "stable" .

onto:ownedBy a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    dcterms:created "2017-04-05"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "The owner of a civic structure or facility. Owner and operator can be different business entities."@en ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/goodrelations/v1#BusinessEntity> ;
    ns1:term_status "stable" .

onto:parkingSpace a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "parking space"@en ;
    dcterms:created "2017-05-15"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Relates the parking facility to a contained parking space."@en ;
    rdfs:domain onto:ParkingFacility ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ParkingSpace ;
    ns1:term_status "stable" .

onto:picture a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "picture"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "URL of the picture of a civic structure or facility."@en ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:plug a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "plug"@en ;
    rdfs:comment "Indicates the plugs available at a charger." ;
    rdfs:domain onto:Charger ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Plug .

onto:plugType a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "plug type"@en ;
    rdfs:comment "Indicates the type of a plug." ;
    rdfs:domain onto:Plug ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:PlugType .

onto:powerInKW a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "power in kW"@en ;
    rdfs:comment "Indicates the power of a charger or plug in kilowatts." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Plug onto:Charger ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:double .

onto:price a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "price"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates that a civic structure can be used for a specific price."@en ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns2:PriceSpecification ;
    ns1:term_status "stable" .

onto:queuingTime a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "queuing time"@en ;
    dcterms:created "2017-05-15"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "The current queuing time (duration) for entering the parking facility." ;
    rdfs:domain onto:ParkingFacility ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:rateOfOccupancy a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "rate of occupancy"@en ;
    dcterms:created "2017-05-10"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the percentage value of parking spaces occupied in a parking facility." ;
    rdfs:domain onto:ParkingFacility ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:threePhasedCurrentAvailable a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "three-phased current available"@en ;
    rdfs:comment "Indicates whether three-phased current is available." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Plug onto:Charger ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

onto:timeEndValue a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "time end value"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the end value of a time period." ;
    rdfs:domain onto:TimeSpecification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    ns1:term_status "stable" .

onto:timeStartValue a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "time start value"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the start value of a time period." ;
    rdfs:domain onto:TimeSpecification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:float ;
    ns1:term_status "stable" .

onto:timeUnit a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "time unit"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the time unit a value is specified for." ;
    rdfs:domain onto:TimeSpecification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    ns1:term_status "stable" .

onto:totalCapacity a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "total capacity"@en ;
    dcterms:created "2017-05-10"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the total number of parking spaces of a parking facility." ;
    rdfs:domain onto:ParkingFacility ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    ns1:term_status "stable" .

onto:unspecifiedCharge a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "unspecified charge"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates that a charge has to be paid for the usage of the civic structure." ;
    rdfs:domain ns2:PriceSpecification ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    ns1:term_status "stable" .

onto:validForUserGroup a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "valid for user group"@en ;
    dcterms:created "2017-09-01"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates that an entity is valid for a specific group of users."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:AccessCondition ns2:PriceSpecification onto:Capacity ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:UserGroup ;
    ns1:term_status "stable" .

onto:validForVehicle a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "valid for vehicle"@en ;
    dcterms:created "2017-08-29"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates that an entity is valid for a specific type of vehicle."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:AccessCondition ns2:PriceSpecification onto:Capacity ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns2:Vehicle ;
    ns1:term_status "stable" .

onto:vehicleHeightLimitInM a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "vechicle height limit"@en ;
    dcterms:created "2017-04-13"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the height limit in meter for vehicles using the parking facility." ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal ;
    ns1:term_status "stable" .

onto:vehicleLengthLimitInM a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "vehicle length limit"@en ;
    dcterms:created "2017-04-13"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the length limit in meter for vehicles using the parking facility." ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal ;
    ns1:term_status "stable" .

onto:vehicleWidthLimitInM a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "vehicle width limit"@en ;
    dcterms:created "2017-06-07"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "Indicates the width limit in meter for vehicles using the parking facility." ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal ;
    ns1:term_status "stable" .

onto:voltageInV a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "voltage in V"@en ;
    rdfs:comment "Indicates the voltage of a charger or plug in volt." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onto:Plug onto:Charger ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:double .

ns2:acceptedPaymentMethod a owl:ObjectProperty ;
    rdfs:label "accepted payment method"@en ;
    rdfs:comment "The payment method(s) accepted by seller for this offer."@en ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:PaymentMethod .

ns2:address a owl:ObjectProperty ;
    rdfs:label "address"@en ;
    rdfs:comment "Physical address of the item."@en ;
    rdfs:domain ns2:Place ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:PostalAddress .

ns2:openingHoursSpecification a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "opening hours specification"@en ;
    rdfs:comment "Indicates the general opening hours for a business or civic structure."@en ;
    rdfs:domain ns2:CivicStructure ;
    rdfs:isDefinedBy ns2: ;
    rdfs:range ns2:OpeningHoursSpecification .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude of a place."@en ;
    rdfs:domain ns2:Place ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ;
    rdfs:range xsd:string .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude of a place."@en ;
    rdfs:domain ns2:Place ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ;
    rdfs:range xsd:string .

