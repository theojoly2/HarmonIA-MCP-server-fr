onto:PerpendicularParking a onto:ArrangementPattern ;
    rdfs:label "Perpendicular parking"@en ;
    dcterms:created "2017-05-10"^^xsd:date ;
    dcterms:modified "2018-01-12"^^xsd:date ;
    rdfs:comment "With perpendicular parking, vehicles are parked side to side, perpendicular to an aisle, curb, or wall. This type of parking is commonly used in parking lots and parking facilities."@en ;
