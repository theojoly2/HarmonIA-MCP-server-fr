@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#BoundingPolygon> a owl:Class ;
    rdfs:label "Bounding polygon"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#Object> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#polygon> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#polygon> ],
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicExtent> ;
    skos:notation "EX_BoundingPolygon"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicDescription> a owl:Class ;
    rdfs:label "Geographic description"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#geographicIdentifier> ],
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicExtent> ;
    skos:notation "EX_GeographicDescription"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#SpatialTemporalExtent> a owl:Class ;
    rdfs:label "Spatial and temporal extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#spatialExtent> ],
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#TemporalExtent> ;
    skos:notation "EX_SpatialTemporalExtent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#description> a owl:DatatypeProperty ;
    rdfs:label "description"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#Extent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#eastBoundLongitude> a owl:DatatypeProperty ;
    rdfs:label "east bound longitude"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicBoundingBox> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#extent> a owl:ObjectProperty ;
    rdfs:label "extent"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#TemporalExtent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#Primitive> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#extentTypeCode> a owl:DatatypeProperty ;
    rdfs:label "extent type code"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicExtent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#geographicIdentifier> a owl:ObjectProperty ;
    rdfs:label "geographic identifier"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicDescription> ;
    rdfs:isDefinedBy onto: .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#maximumValue> a owl:DatatypeProperty ;
    rdfs:label "maximum value"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#VerticalExtent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:double .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#minumumValue> a owl:DatatypeProperty ;
    rdfs:label "minumu value"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#VerticalExtent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:double .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#northBoundLatitude> a owl:DatatypeProperty ;
    rdfs:label "north bound latitude"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicBoundingBox> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#southBoundLatitude> a owl:DatatypeProperty ;
    rdfs:label "south bound latitude"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicBoundingBox> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#spatialExtent> a owl:ObjectProperty ;
    rdfs:label "spatial extent"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#SpatialTemporalExtent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicExtent> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#verticalCRS> a owl:ObjectProperty ;
    rdfs:label "vertical CRS"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#VerticalExtent> ;
    rdfs:isDefinedBy onto: .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#westBoundLongitude> a owl:DatatypeProperty ;
    rdfs:label "west bound longitude"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicBoundingBox> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#geographicElement> a owl:ObjectProperty ;
    rdfs:label "geographic element"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#Extent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicExtent> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#polygon> a owl:ObjectProperty ;
    rdfs:label "polygon"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#BoundingPolygon> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#Object> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#temporalElement> a owl:ObjectProperty ;
    rdfs:label "temporal element"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#Extent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#TemporalExtent> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#verticalElement> a owl:ObjectProperty ;
    rdfs:label "vertical element"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#Extent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#VerticalExtent> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#Extent> a owl:Class ;
    rdfs:label "Extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#verticalElement> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#VerticalExtent> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#verticalElement> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicExtent> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#geographicElement> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#geographicElement> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#TemporalExtent> ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#temporalElement> ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#temporalElement> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#description> ] ;
    skos:notation "EX_Extent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicBoundingBox> a owl:Class ;
    rdfs:label "Geographic bounding box"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#northBoundLatitude> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#southBoundLatitude> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#westBoundLongitude> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#eastBoundLongitude> ],
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicExtent> ;
    skos:notation "EX_GeographicBoundingBox"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#TemporalExtent> a owl:Class ;
    rdfs:label "Temporal extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#extent> ] ;
    skos:notation "EX_TemporalExtent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#VerticalExtent> a owl:Class ;
    rdfs:label "Vertical extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#maximumValue> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#minumumValue> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#verticalCRS> ] ;
    skos:notation "EX_VerticalExtent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicExtent> a owl:Class ;
    rdfs:label "Geographic extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#extentTypeCode> ] ;
    skos:notation "EX_GeographicExtent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName> .

onto: a owl:Ontology ;
    dc:creator "Simon Jonathan David COX\\r\\nCSIRO"^^xsd:string ;
    dc:date "2012-05-25T00:00:00"^^xsd:dateTime ;
    dc:description " An OWL representation of parts of the Geographic Metadata model described in ISO 19115:2003 with Corrigendum 2006 - EX Package"^^xsd:string ;
    dc:source "ISO 19115:2003\\r\\nISO 19115:2006 Corrigendum"^^xsd:string ;
    dc:title "OWL representation of ISO 19115 (Geographic Information - Metadata - Extent package)"^^xsd:string ;
    dcterms:created "2012-05-18T00:00:00"^^xsd:dateTime ;
    dcterms:hasPart <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#BoundingPolygon>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#Extent>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicBoundingBox>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicDescription>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#GeographicExtent>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#SpatialTemporalExtent>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#TemporalExtent>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#VerticalExtent>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#description>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#eastBoundLongitude>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#extent>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#extentTypeCode>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#geographicElement>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#geographicIdentifier>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#maximumValue>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#minumumValue>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#northBoundLatitude>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#polygon>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#southBoundLatitude>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#spatialExtent>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#temporalElement>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#verticalCRS>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#verticalElement>,
        <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#westBoundLongitude> ;
    dcterms:modified "2012-10-26T00:00:00"^^xsd:dateTime ;
    owl:imports <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry>,
        <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>,
        <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic> ;
    owl:priorVersion <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201210/ISOTC211/HM/extent.rdf> ;
    owl:versionIRI <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201305/ISOTC211/HM/extent.rdf> .

