ns1:CLASS a owl:NamedIndividual,
        ns1:FundedProject ;
    rdfs:label "CLASS"@en,
        "CLASS"@fr ;
    dcterms:description "CLASS will deliver the knowledge and understanding of the Atlantic Ocean system that society needs to make evidence-based decisions regarding ocean management.\\n\\nWe aim to address key knowledge gaps in our understanding of ocean variability, climate regulation and ocean services, and to assess how the ocean will evolve as a result of climate change and intensified human exploitation.\\n\\nCLASS will be delivered through an Atlantic focused science programme, building on sustained ocean observation, world class model development and state of the art technology, delivered through Marine National Capability underpinning activities." ;
    dcterms:title "CLASS (Climate Linked Atlantic Sector Science)"@en,
        "CLASS (Climate Linked Atlantic Sector Science)"@fr ;
    ns7:endDate "2024-04"^^xsd:gYearMonth ;
    ns7:startDate "2018-04"^^xsd:gYearMonth ;
    skos:altLabel "Climate Linked Atlantic Sector Science"@en ;
    skos:definition "CLASS will deliver the knowledge and understanding of the Atlantic Ocean system that society needs to make evidence-based decisions regarding ocean management.\\n\\nWe aim to address key knowledge gaps in our understanding of ocean variability, climate regulation and ocean services, and to assess how the ocean will evolve as a result of climate change and intensified human exploitation.\\n\\nCLASS will be delivered through an Atlantic focused science programme, building on sustained ocean observation, world class model development and state of the art technology, delivered through Marine National Capability underpinning activities."@en ;
    skos:note "CLASS"@en ;
    skos:prefLabel "CLASS"@en,
        "CLASS"@fr ;
    foaf:homepage <https://projects.noc.ac.uk/class-project/> ;
    ns1:hasCountry ns1:United_Kingdom ;
    ns1:hasLogo <https://raw.githubusercontent.com/emso-eric/oso-ontology/8c80fcae432da3c2aec4f14049a6832a18edd971/images/class.jpg> .

