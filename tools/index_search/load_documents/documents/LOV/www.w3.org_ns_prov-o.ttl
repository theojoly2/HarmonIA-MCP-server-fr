ns1:MARMOR a owl:NamedIndividual,
        ns1:FundedProject ;
    rdfs:label "MARMOR"@en,
        "MARMOR"@fr ;
    skos:altLabel "Marine Advanced Geophysical Research Equipment and Mayotte Multidisciplinary Observatory for Research and Response"@en ;
    skos:definition "MARMOR (Marine Advanced Geophysical Research Equipment and Mayotte Multidisciplinary Observatory for Research and Response) is an eight-year project funded by the ANR.\\n                           \\n                           The MARMOR project has two objectives:\\n                           \\n                           to structure the French scientific community by providing the Epos-France research infrastructure (formerly Résif) with the equipment required to conduct high-level research using submarine seismology and geodesy tools,\\n\\n                           to establish an underwater observation infrastructure in Mayotte in order to ensure continuous, real-time, 24/7 seismological monitoring and to support multidisciplinary research on the phenomena associated with the ongoing seismo-volcanic crisis."@en,
        "MARMOR (Marine Advanced Geophysical Research Equipment and Mayotte Multidisciplinary Observatory for Research and Response) est un projet d’une durée de huit ans financé par l’ANR.\\n\\n                           Le projet MARMOR a un double objectif :\\n\\n                           structurer la communauté scientifique française en fournissant à l’infrastructure de recherche Epos-France (anciennement Résif) les équipements nécessaires pour conduire des recherches d’excellence utilisant les outils de la sismologie et de la géodésie sous-marines,\\n\\n                           mettre en place une infrastructure d’observation sous-marine à Mayotte afin d’assurer une surveillance sismologique continue, en temps réel et 24/7, et de conduire des recherches multidisciplinaires sur les phénomènes associés à la crise sismo-volcanique en cours."@fr ;
    skos:prefLabel "MARMOR"@en,
        "MARMOR"@fr ;
    foaf:homepage <https://www.marmor-project.org/fr> ;
    ns1:hasCountry ns1:France ;
    ns1:hasLocation ns1:Mayotte ;
    ns1:hasLogo <https://raw.githubusercontent.com/emso-eric/oso-ontology/abf95792c97c0f711a285e2cd6e21ff20ff87009/images/marmor.png> .

