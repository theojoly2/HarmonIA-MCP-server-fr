    ns3:URI <https://w3id.org/earthsemantics/OSO> ;
    ns3:acronym "OSO" ;
    ns3:creationDate "2025-04-04"^^xsd:date ;
    ns3:description "Ontology describing marine observatories (Regional Facilities, Sites, Platforms) to support FAIR data management and interoperability, particularly in the EMSO ERIC context."@en,
        "Ontologie décrivant les observatoires marins (infrastructures régionales, sites, plateformes) pour soutenir la gestion FAIR des données et l’interopérabilité, notamment dans le cadre d’EMSO ERIC."@fr ;
    ns3:designedForOntologyTask ns3:AnnotationTask,
        ns3:IndexingTask,
        ns3:IntegrationTask,
        ns3:QueryFormulationTask ;
    ns3:documentation <https://emso-eric.github.io/oso-ontology/>,
        <https://github.com/emso-eric/oso-ontology> ;
    ns3:endorsedBy ns1:EMSO_DMSG ;
    ns3:hasDomain <https://data.earthportal.eu/categories/CLIMATE>,
        <https://data.earthportal.eu/categories/EARTH>,
        <https://data.earthportal.eu/categories/ENV>,
        "Marine Research Infrastructures"@en,
        "Infrastructures de recherche marine"@fr ;
    ns3:hasFormalityLevel <http://w3id.org/nkos/nkostype#ontology> ;
    ns3:hasOntologyLanguage "OWL" ;
    ns3:hasOntologyName "Observatories of the Seas Ontology (OSO)"@en,
        "Ontologie des observatoires marins (OSO)"@fr ;
    ns3:hasOntologySyntax <http://www.w3.org/ns/formats/Turtle> ;
    ns3:hasOntologyType "Application ontology" ;
    ns3:keywords "marine observatories, FAIR data, EMSO, research infrastructures, ontology, underwater observatories"@en,
        "observatoires marins, données FAIR, EMSO, infrastructures de recherche, ontologie, observatoires sous-marins"@fr ;
    ns3:name "Observatories of the Seas Ontology"@en,
        "Ontologie des observatoires marins"@fr ;
    ns3:naturalLanguage "el",
        "en",
        "es",
        "fr",
        "it",
        "no",
        "pt",
        "ro" ;
    ns3:ontologyPurpose "Describe the structure and key components of marine observatories to improve data management, interoperability, and reuse, especially in the EMSO research infrastructure context."@en,
        "Décrire la structure et les composants clés des observatoires marins afin d'améliorer la gestion, l'interopérabilité et la réutilisation des données, notamment dans le cadre de l'infrastructure de recherche EMSO."@fr ;
    ns3:reference <https://doi.org/10.25504/FAIRsharing.654931>,
        <https://doi.org/10.5281/zenodo.19497913>,
        <https://earthportal.eu/ontologies/OSO>,
        <https://github.com/emso-eric/oso-ontology>,
        <https://www.emso-fr.org/Data/Observatories-of-Seas-Ontology> ;
    ns3:resourceLocator <https://w3id.org/earthsemantics/OSO> ;
    ns3:status "Published" ;
    ns3:useImports rdfs:,
        owl:,
        skos:,
        foaf: ;
    ns3:usedOntologyEngineeringMethodology "Co-construction with domain experts and iterative alignment with reference ontologies"@en,
        "Co-construction avec des experts métier et alignement itératif avec des ontologies de référence"@fr ;
    ns3:usedOntologyEngineeringTool "Protégé 5.6.9",
        "VSCodium 1.92.2" ;
    ns3:version "1.0.3" ;
    dcterms:abstract "The OSO ontology structures marine observatories into three hierarchical levels: Regional Facilities, Sites, and Platforms. It supports FAIR data management, interoperability, and integration of heterogeneous marine infrastructure information, particularly within the EMSO ERIC framework."@en,
        "L'ontologie OSO structure les observatoires marins en trois niveaux hiérarchiques : infrastructures régionales, sites et plateformes. Elle soutient la gestion FAIR des données, l'interopérabilité et l'intégration des informations sur les infrastructures marines, notamment dans le cadre d'EMSO ERIC."@fr ;
    dcterms:bibliographicCitation "Observatories of the Seas Ontology (OSO), version 1.0.3 EMSO ERIC / Ifremer. FAIRsharing DOI: 10.25504/FAIRsharing.654931."@en ;
    dcterms:conformsTo <https://semver.org/>,
        <https://www.conventionalcommits.org/>,
        <https://www.w3.org/TR/owl2-overview/>,
        <https://www.w3.org/TR/prov-o/>,
        <https://www.w3.org/TR/skos-reference/>,
        <https://www.w3.org/TR/sparql11-query/>,
        <https://www.w3.org/TR/vocab-dcat-3/> ;
    dcterms:contributor ns1:EMSO_DMSG ;
    dcterms:coverage "Global, with a focus on European Seas and marine research infrastructures"@en,
        "Couverture mondiale, avec un focus sur les mers européennes et les infrastructures de recherche marines"@fr ;
    dcterms:created "2025-04-04"^^xsd:date ;
    dcterms:creator <https://orcid.org/0009-0008-1759-5254> ;
    dcterms:description "Ontology describing coastal and open seas observatories, including all EMSO observatories as part of the European Multidisciplinary Seafloor and Water Column Observatories infrastructure. Not to be confused with the OpenScienceOntology (OSO)."@en,
        "Ontologie décrivant les observatoires marins côtiers et hauturiers, incluant l’ensemble des observatoires EMSO, dans le cadre de l'infrastructure européenne multidisciplinaire dédiée aux fonds marins et à la colonne d’eau. À ne pas confondre avec l'OpenScienceOntology (OSO)."@fr ;
    dcterms:hasFormat <https://earthportal.eu/ontologies/OSO.owl>,
        <https://earthportal.eu/ontologies/OSO.ttl>,
        <https://raw.githubusercontent.com/emso-eric/oso-ontology/main/OSO.ttl> ;
    dcterms:hasVersion <https://w3id.org/earthsemantics/OSO/1.0.3> ;
