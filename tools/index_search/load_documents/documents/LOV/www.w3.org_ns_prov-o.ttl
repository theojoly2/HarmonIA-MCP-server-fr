ns1:Marha a owl:NamedIndividual,
        ns1:FundedProject ;
    rdfs:label "LIFE Marha"@en,
        "LIFE Marha"@fr ;
    dcterms:description "The LIFE Integrated Project Marha (Marine Habitats) aims to restore and maintain the favourable conservation status of natural marine habitats in mainland France. From 2018 to 2025, more than 650 actions involving assessment, experimentation, management, awareness-raising and training were implemented, mobilising all stakeholders involved in the management of Natura 2000 marine sites."@en,
        "Le projet LIFE intégré Marha (Marine Habitats) vise à rétablir et à maintenir le bon état de conservation des habitats naturels marins en France hexagonale. De 2018 à 2025, plus de 650 actions d’évaluation, d’expérimentation, de gestion, de sensibilisation et de formation ont été mises en œuvre, en mobilisant l’ensemble des acteurs impliqués dans la gestion des sites Natura 2000 en mer."@fr ;
    dcterms:title "LIFE Marha"@en,
        "LIFE Marha"@fr ;
    skos:prefLabel "LIFE Marha"@en,
        "LIFE Marha"@fr ;
    foaf:homepage <https://www.life-marha.fr/> ;
    ns1:Project_is_led_by_an_Organization ns1:Office_français_de_la_biodiversité ;
    ns1:hasCountry ns1:France ;
    ns1:hasLogo <https://raw.githubusercontent.com/emso-eric/oso-ontology/574ea01da2510994a290bef4699695d5e0fd86dc/images/life_marha.jpg> .

