ns1:EMSO-France a owl:NamedIndividual,
        ns1:ResearchInfrastructure ;
    rdfs:label "EMSO-France"@en,
        "EMSO-France"@fr ;
    dcterms:description "EMSO-France Research Infrastructure, included in the MESR roadmap, coordinates French initiatives on underwater observatories within the European programme and promotes their openness to a wide range of teams and disciplines. France’s involvement is driven by its expertise in data management, technological innovation, and the strategic selection of observatory deployment sites:\\n                                    \\n                                    the Azores site on the Mid-Atlantic Ridge, within Portugal’s EEZ,\\n                                    the Ligurian Sea site, east on the Nice slope and west in the deep continental margin area, linked to the IN2P3 neutrino telescope,\\n                                    the Marmara Sea site along the North Anatolian Fault,\\n                                    the Iroise Sea test site, initially located offshore Molène, currently being relocated to Brest harbour."@en,
        "L’infrastructure de recherche EMSO-France, inscrite dans la feuille de route du MESR, coordonne les initiatives françaises sur les observatoires sous-marins du programme européen et favorise leur ouverture à un large éventail d’équipes et de disciplines. L’engagement de la France repose sur son expertise en gestion de données, en innovation technologique et sur le choix stratégique des sites d’implantation des observatoires :\\n                                    \\n                                    le site des Açores sur la dorsale médio-atlantique, dans la ZEE du Portugal,\\n                                    le site de la mer Ligure, à l’est sur la pente de Nice et à l’ouest dans la zone profonde du talus continental, en lien avec le télescope à neutrinos de l’IN2P3,\\n                                    le site de la mer de Marmara sur la faille nord-anatolienne,\\n                                    le site d’essai en mer d’Iroise, initialement au large de Molène, en cours de relocalisation en rade de Brest."@fr ;
    dcterms:identifier <https://ror.org/0312sjw67> ;
    skos:altLabel "European Multidisciplinary Seafloor and Water Column Observatory – France"@en ;
    skos:prefLabel "EMSO-France"@en,
        "EMSO-France"@fr ;
    foaf:homepage <https://www.emso-fr.org/>,
        <https://www.emso-fr.org/fr> ;
    ns1:RegionalFacilityisledby ns1:Dominique_LEFEVRE,
        ns1:Nadine_LANTERI ;
    ns1:hasCountry ns1:France ;
    ns1:isManagedBy ns1:CNRS,
        ns1:Ifremer .

