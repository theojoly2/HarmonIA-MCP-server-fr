    dcterms:issued "2025-04-04"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-04-16"^^xsd:date ;
    dcterms:publisher <https://ror.org/04xkqms46> ;
    dcterms:title "Observatories of the Seas Ontology dataset"@en ;
    ns6:previousVersion <https://doi.org/10.5281/zenodo.19497913>,
        <https://w3id.org/earthsemantics/OSO/1.0.2> ;
    ns6:version "1.0.3" ;
    void:sparqlEndpoint <https://virtuoso.ifremer.fr/oso/sparql> ;
    dcat:accessURL <https://virtuoso.ifremer.fr/oso/sparql> ;
    dcat:contactPoint [ a ns2:Kind ;
            ns2:fn "EMSO Data Management Service Group" ;
            ns2:hasEmail <mailto:emso.dmsg@emso-eu.org> ;
            ns2:hasOrganizationName "EMSO ERIC" ],
        [ a ns2:Kind ;
            ns2:fn "EMSO Data Management Service Group" ;
            ns2:hasEmail <mailto:emso.dmsg@emso-eu.org> ;
            ns2:hasOrganizationName "EMSO ERIC" ] ;
    dcat:distribution <https://earthportal.eu/ontologies/OSO.owl>,
        <https://earthportal.eu/ontologies/OSO.ttl>,
        <https://raw.githubusercontent.com/emso-eric/oso-ontology/main/OSO.ttl> ;
    dcat:landingPage <https://earthportal.eu/ontologies/OSO> ;
    dcat:theme <https://data.earthportal.eu/categories/CLIMATE>,
        <https://data.earthportal.eu/categories/EARTH>,
        <https://data.earthportal.eu/categories/ENV> ;
    prov:generatedAtTime "2026-04-16"^^xsd:date ;
    prov:wasAttributedTo <https://ror.org/04xkqms46> ;
    prov:wasDerivedFrom <https://w3id.org/earthsemantics/OSO/1.0.2> ;
    foaf:primaryTopic <https://w3id.org/earthsemantics/OSO> .

