ns1:Atlantic_Whale_Deal a owl:NamedIndividual,
        ns1:FundedProject ;
    rdfs:label "Atlantic Whale Deal"@en,
        "Atlantic Whale Deal"@fr ;
    dcterms:description "The ATLANTIC WHALE DEAL aims to make sure that ships don't accidentally hit whales in the Atlantic Area.\\n\\nPartners from different countries are working together to prevent these collisions that can damage biodiversity, trying out new and smart technologies to reduce ship strikes. They want to help the environment by capturing carbon (which is good for the planet) and making sure the ecosystem works well. This involves localization techniques to find whales, making maps to show where there's a risk of collisions, and creating tools to reduce noise in the ocean.\\n\\n\\nA team of experts in physics, engineering, biology, statistics, design, and social economics from four countries is teaming up with different organizations like the government, non-profit groups, schools, and businesses. The goal is to find solutions that work well and help society while also taking care of the planet.\\n\\nATLANTIC WHALE DEAL believes that by protecting whales, they're also making a positive impact on the world by keeping the environment healthy and preserving biodiversity." ;
    dcterms:title "Atlantic Whale Deal"@en,
        "Atlantic Whale Deal"@fr ;
    ns7:endDate "2026-11-30"^^xsd:date ;
    ns7:startDate "2023-12-01"^^xsd:date ;
    skos:prefLabel "Atlantic Whale Deal"@en,
        "Atlantic Whale Deal"@fr ;
    foaf:homepage <https://www.atlanticarea.eu/discover-our-projects/approved-projects/atlantic-whale-deal> ;
    ns1:Project_is_led_by_an_Organization ns1:ARDITI ;
    ns1:hasCountry ns1:France,
        ns1:Ireland,
        ns1:Portugal,
        ns1:Spain ;
    ns1:hasLogo <https://raw.githubusercontent.com/emso-eric/oso-ontology/31fa81e305eb2c35f5cc8e003cf578c505b8ffa1/images/AtlanticWhaleDeal.png> ;
    ns1:hasSpatialExtent ns1:AtlanticWhaleDealbbox .

