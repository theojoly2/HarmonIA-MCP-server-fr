ns1:Black_Sea a owl:NamedIndividual,
        ns1:RegionalFacility ;
    rdfs:label "Black Sea"@en,
        "Black Sea"@fr ;
    dcterms:spatial <http://dbpedia.org/resource/Black_Sea> ;
    rdfs:comment "The Black Sea is one of the largest regional seas of the Eurasian continent and unique in many of its geographical, geological, biological, hydrographical and socio-political characteristics. With anoxic conditions in the deep, problems with invasive species and high sediment loads delivered to the system, this area has unique problems requiring long-term stations. The Black Sea is located in a geological complex area, where three major tectonic plates (Eurasian, Anatolian, Arabian) interact. Geo hazards, such as earthquarkes, submarine landslide, displacement along active faults, are present and are possible triggers of tsunami, together with extreme meteorological events."@en,
        "The Black Sea is one of the largest regional seas of the Eurasian continent and unique in many of its geographical, geological, biological, hydrographical and socio-political characteristics. With anoxic conditions in the deep, problems with invasive species and high sediment loads delivered to the system, this area has unique problems requiring long-term stations. The Black Sea is located in a geological complex area, where three major tectonic plates (Eurasian, Anatolian, Arabian) interact. Geo hazards, such as earthquarkes, submarine landslide, displacement along active faults, are present and are possible triggers of tsunami, together with extreme meteorological events."@fr ;
    skos:prefLabel "Black Sea"@en,
        "Black Sea"@fr ;
    ns1:DistanceFromLand 97 ;
    ns1:RegionalFacility_is_linked_to_a_project ns1:EUXINUS ;
    ns1:containsSite ns1:EuxRo01,
        ns1:EuxRo02,
        ns1:EuxRo03 ;
    ns1:dateFirstDeployment "2013-06-01"^^xsd:date ;
    ns1:hasBoundingBox ns1:Black_Sea_RF_bbox ;
    ns1:hasERICMembership ns1:Black_Sea_EMSO_membership ;
    ns1:hasRegionalTeamLeader ns1:Vlad_Rădulescu ;
    ns1:ledByOrganization ns1:GeoEcoMar ;
    ns1:maxWaterDepth 95 ;
    ns1:minWaterDepth 15 .

