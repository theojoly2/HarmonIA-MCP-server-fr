        onto:,
        foaf: ;
    owl:priorVersion <https://w3id.org/earthsemantics/OSO/1.0.2> ;
    owl:versionInfo "1.0.3 – metadata cleanup, FAIR improvements, and publication fixes"@en,
        "1.0.3 – Nettoyage des métadonnées, améliorations FAIR et corrections de publication"@fr ;
    skos:altLabel "OSO",
        "Open Seas Observatories"@en ;
    skos:definition "This ontology aims to describe underwater observatories, in particular those associated with the European Multidisciplinary Seafloor and Water Column Observatories (EMSO), which has been a European Research Infrastructure Consortium (ERIC) since 2016."@en,
        "Cette ontologie vise à décrire les observatoires sous-marins, en particulier ceux associés au réseau européen d'observatoires multidisciplinaires des fonds marins et de la colonne d'eau (EMSO), qui constitue un consortium européen d'infrastructures de recherche (ERIC) depuis 2016."@fr ;
    skos:hiddenLabel "Ontology for Scenario Orchestration"@en,
        "OpenScienceOntology"@en ;
    skos:prefLabel "Observatories of the Seas Ontology"@en,
        "Ontologie des observatoires marins"@fr ;
    skos:scopeNote "Not to be confused with OpenScienceOntology (OSO) or Ontology for Scenario Orchestration (OSO)."@en,
        "À ne pas confondre avec OpenScienceOntology (OSO) ni avec Ontology for Scenario Orchestration (OSO)."@fr ;
    ns10:identifier [ a ns10:Identifier ;
            skos:notation "10.25504/FAIRsharing.654931" ;
            skos:prefLabel "FAIRsharing DOI for OSO"@en ],
        [ a ns10:Identifier ;
            skos:notation "10.25504/FAIRsharing.654931" ;
            skos:prefLabel "FAIRsharing DOI for OSO"@en ] ;
