<http://brt.basisregistraties.overheid.nl/id/begrip/Relief> a skos:Concept ;
    rdfs:label "relief" ;
    dcterms:source <jci1.3:c:BWBR0004541&hoofdstuk=6a&artikel=98a&lid=g> ;
    skos:broader <http://brt.basisregistraties.overheid.nl/id/begrip/GeografischObject>,
        <http://brt.basisregistraties.overheid.nl/id/begrip/Top10nlObject> ;
    skos:definition "object dat tot doel heeft hoogteverschillen in het landschap te representeren." ;
    skos:inScheme <http://brt.basisregistraties.overheid.nl/id/begrippenkader/top10nl> ;
    skos:prefLabel "relief" ;
    skos:scopeNote "Onder de klasse Relief vallen objecten die een hoogteverschil in het terrein kenmerken, zoals dijken en taluds" .

<http://brt.basisregistraties.overheid.nl/id/begrip/Functie_waterdeel> a skos:Concept ;
    rdfs:label "functie (waterdeel)" ;
