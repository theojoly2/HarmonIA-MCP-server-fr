<http://brt.basisregistraties.overheid.nl/id/begrip/Waterdeel> a skos:Concept ;
    rdfs:label "waterdeel" ;
    dcterms:source <jci1.3:c:BWBR0004541&hoofdstuk=6a&artikel=98a&lid=c> ;
    skos:broader <http://brt.basisregistraties.overheid.nl/id/begrip/GeografischObject>,
