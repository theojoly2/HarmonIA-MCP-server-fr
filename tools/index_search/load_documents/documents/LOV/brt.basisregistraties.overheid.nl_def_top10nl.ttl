<http://brt.basisregistraties.overheid.nl/id/begrip/Inrichtingselement> a skos:Concept ;
    rdfs:label "inrichtingselement" ;
    dc:source "NEN3610:2011" ;
    dcterms:source <jci1.3:c:BWBR0004541&hoofdstuk=6a&artikel=98a&lid=f> ;
    skos:broader <http://brt.basisregistraties.overheid.nl/id/begrip/GeografischObject>,
        <http://brt.basisregistraties.overheid.nl/id/begrip/Top10nlObject> ;
    skos:definition "Ruimtelijk object, punt- of lijnvormig, al dan niet ter detaillering dan wel ter inrichting van de overige benoemde ruimtelijke objecten of andere inrichtingselementen." ;
    skos:inScheme <http://brt.basisregistraties.overheid.nl/id/begrippenkader/top10nl> ;
    skos:prefLabel "inrichtingselement" .

<http://brt.basisregistraties.overheid.nl/id/begrip/FunctioneelGebied> a skos:Concept ;
