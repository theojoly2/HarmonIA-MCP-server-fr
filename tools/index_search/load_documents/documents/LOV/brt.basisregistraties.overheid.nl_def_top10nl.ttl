    skos:prefLabel "top10nl object" ;
    skos:scopeNote "De abstracte klasse _Top10nlObject  heeft alle attributen die TOP10NL objecten gemeenschappelijk hebben, zoals identificatie" .

<http://brt.basisregistraties.overheid.nl/id/begrip/Terrein> a skos:Concept ;
    rdfs:label "terrein" ;
    dc:source "NEN3610:2011" ;
    dcterms:source <jci1.3:c:BWBR0004541&hoofdstuk=6a&artikel=98a&lid=e> ;
    skos:broader <http://brt.basisregistraties.overheid.nl/id/begrip/GeografischObject>,
        <http://brt.basisregistraties.overheid.nl/id/begrip/Top10nlObject> ;
    skos:definition "Zichtbaar begrensd stuk grond, niet zijnde een van de andere opdelende ruimtelijke objecten (wegdeel of waterdeel)." ;
    skos:inScheme <http://brt.basisregistraties.overheid.nl/id/begrippenkader/top10nl> ;
    skos:prefLabel "terrein" .

<http://brt.basisregistraties.overheid.nl/id/begrip/Wegdeel> a skos:Concept ;
    rdfs:label "wegdeel" ;
    dcterms:source <jci1.3:c:BWBR0004541&hoofdstuk=6a&artikel=98a&lid=a> ;
    skos:broader <http://brt.basisregistraties.overheid.nl/id/begrip/GeografischObject>,
        <http://brt.basisregistraties.overheid.nl/id/begrip/Top10nlObject>,
        <http://brt.basisregistraties.overheid.nl/id/begrip/Weg> ;
    skos:definition "Kleinste functioneel onafhankelijk stukje weg met gelijkblijvende, homogene eigenschappen en relaties voor wegverkeer en vliegverkeer te land." ;
    skos:inScheme <http://brt.basisregistraties.overheid.nl/id/begrippenkader/top10nl> ;
    skos:prefLabel "wegdeel" .

