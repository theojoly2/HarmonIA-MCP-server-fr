    skos:prefLabel "plaats" ;
    skos:scopeNote "Voorbeelden zijn woonkernen, gehuchten en stadsdelen, al dan niet omsloten met blauwe of witte plaatsnaamborden." .

<http://brt.basisregistraties.overheid.nl/id/begrip/Spoorbaandeel> a skos:Concept ;
    rdfs:label "spoorbaandeel" ;
    dcterms:source <jci1.3:c:BWBR0004541&hoofdstuk=6a&artikel=98a&lid=b> ;
    skos:broader <http://brt.basisregistraties.overheid.nl/id/begrip/GeografischObject>,
