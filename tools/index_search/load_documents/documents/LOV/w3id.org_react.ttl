@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix ns3: <http://purl.org/ontology/bibo/> .
@prefix onto: <https://w3id.org/react> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns2:license a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

ns3:status a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

ns1:term_status a owl:AnnotationProperty .

<https://w3id.org/hpont#HeatPumpSystem> rdfs:subClassOf <https://w3id.org/eep#Executor> .

onto: a owl:Ontology ;
    ns2:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcterms:created "2021-06-01"^^xsd:string ;
    dcterms:creator "Iker Esnaola-Gonzalez <mailto:iker.esnaola@tekniker.es>"^^xsd:string ;
    dcterms:description "The REACT Ontology"^^xsd:string,
        "The REACT ontology aims to represent all the necessary knowledge to support the achievement of island energy independence through renewable energy generation and storage, a demand response platform, and promoting user engagement in a local energy community.\\n\\nThe REACT ontology has been developed as part of the REACT project which has received funding from the European Union’s Horizon 2020 research and innovation programme under grant agreement no. 824395."@en ;
    dcterms:issued "2021-09-14"@en ;
    dcterms:title "The REACT Ontology"@en ;
    ns3:status "Work in Progress"@en ;
    vann:preferredNamespacePrefix "react"^^xsd:string ;
    vann:preferredNamespaceUri <https://w3id.org/react#> ;
    owl:imports <https://w3id.org/affectedBy>,
        <https://w3id.org/bot-0.3.2>,
        <https://w3id.org/eep>,
        <https://w3id.org/hpont> ;
    owl:versionInfo "0.3"@en .

<https://w3id.org/react#equipmentCategory> a owl:DatatypeProperty ;
    rdfs:label "equipment Category"@en ;
    rdfs:comment "Category to which a given equipment (eep:Executor) belongs to"@en ;
    rdfs:domain <https://w3id.org/eep#Executor> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#hasAccessType> a owl:DatatypeProperty ;
    rdfs:label "has Access Type"@en ;
    rdfs:comment "The type of acces of a given Execution"@en ;
    rdfs:domain <https://w3id.org/eep#Execution> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasBatteryCapacity> a owl:DatatypeProperty ;
    rdfs:label "has Battery Capacity"@en ;
    rdfs:comment "The nominal charge stored by a given Battery."@en ;
    rdfs:domain <https://w3id.org/react#Battery> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasDemandEnergyCarrier> a owl:DatatypeProperty ;
    rdfs:label "has Demand Energy Carrier"@en ;
    rdfs:comment "Energy carriers present in a given facility (bot:Space) as demand"@en ;
    rdfs:domain <https://w3id.org/bot#Space> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasElectricitySupplier> a owl:DatatypeProperty ;
    rdfs:label "has Electricity Supplier"@en ;
    rdfs:comment "Information of the Electricity Supplier of a given facility (bot:Space)"@en ;
    rdfs:domain <https://w3id.org/bot#Space> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#hasEnergy> a owl:DatatypeProperty ;
    rdfs:label "has Energy"@en ;
    rdfs:comment "The nominal energy of a given Equipment (eep:Executor)"@en ;
    rdfs:domain <https://w3id.org/eep#Executor> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasGenerationEnergyCarrier> a owl:DatatypeProperty ;
    rdfs:label "has Generation Energy Carrier"@en ;
    rdfs:comment "Energy carriers present in a given facility (bot:Space) as local generators"@en ;
    rdfs:domain <https://w3id.org/bot#Space> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasGridCode> a owl:DatatypeProperty ;
    rdfs:label "has Grid Code"@en ;
    rdfs:comment "Code to uniquely identify electricity supply points such as individual domestic residences"@en ;
    rdfs:domain <https://w3id.org/bot#Space> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#hasGridType> a owl:DatatypeProperty ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#hasInstallationDate> a owl:DatatypeProperty ;
    rdfs:label "has Installation Date"^^xsd:string ;
    rdfs:comment "Date when a given Equipment (eep:Executor) was installed."@en ;
    rdfs:domain <https://w3id.org/eep#Executor> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasMaxChargePower> a owl:DatatypeProperty ;
    rdfs:label "has Max Charge Power"@en ;
    rdfs:comment "Maximum charging power"@en ;
    rdfs:domain <https://w3id.org/react#Battery> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#hasMaxDischargePower> a owl:DatatypeProperty ;
    rdfs:label "has Max Discharge Power"@en ;
    rdfs:comment "Maximum discharging power"@en ;
    rdfs:domain <https://w3id.org/react#Battery> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#hasMaxGridExport> a owl:DatatypeProperty ;
    rdfs:label "has Max Grid Export"@en ;
    rdfs:comment "Maximum power fed"@en ;
    rdfs:domain <https://w3id.org/bot#Space> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#hasMaxGridImport> a owl:DatatypeProperty ;
    rdfs:label "has Max Grid Import"@en ;
    rdfs:comment "Maximum power drawn from the grid"@en ;
    rdfs:domain <https://w3id.org/bot#Space> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#hasMeasurementIndex> a owl:DatatypeProperty ;
    rdfs:label "has Measurement Index"@en ;
    rdfs:comment "Measurement index of an Execution or a set of Executions. Measurement index for scalar values is set to 1. For vector values (e.g. 3-phase measurement), it is set to the corresponding value: 1,2,3…"@en ;
    rdfs:domain <https://w3id.org/eep#Execution> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasModuleQuantity> a owl:DatatypeProperty ;
    rdfs:label "has Module Quantity"@en ;
    rdfs:comment "The quantity of modules that composes a given energy storage or production system"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/react#Battery> <https://w3id.org/react#PVSystem> ) ] ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasSamplingMethod> a owl:DatatypeProperty ;
    rdfs:label "has Sampling Method"@en ;
    rdfs:comment "Sampling method of a given Execution"@en ;
    rdfs:domain <https://w3id.org/eep#Execution> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasSerialNumber> a owl:DatatypeProperty ;
    rdfs:label "has Serial Number"@en ;
    rdfs:comment "Unique identifier of a phyisical equipment (eep:Executor)"@en ;
    rdfs:domain <https://w3id.org/eep#Executor> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#hasTechnology> a owl:DatatypeProperty ;
    rdfs:label "has Technology"@en ;
    rdfs:comment "Base technology of a given Equipment (eep:Executor)"@en ;
    rdfs:domain <https://w3id.org/eep#Executor> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasTotalProductionCapacity> a owl:DatatypeProperty ;
    rdfs:label "has Total Production Capacity"@en ;
    rdfs:comment "The nominal total production capacity of a given production system"@en ;
    rdfs:domain <https://w3id.org/react#PVSystem> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasTotalStorageCapacity> a owl:DatatypeProperty ;
    rdfs:label "has Total Storage Capacity"@en ;
    rdfs:comment "The nominal total storage capacity of a given storage system"@en ;
    rdfs:domain <https://w3id.org/react#Battery> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#hasVoltage> a owl:DatatypeProperty ;
    rdfs:label "has Voltage"^^xsd:string ;
    rdfs:comment "The nominal voltage of a Battery."@en ;
    rdfs:domain <https://w3id.org/react#Battery> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "stable"^^xsd:string .

<https://w3id.org/react#isCurtailable> a owl:DatatypeProperty ;
    rdfs:label "is Curtailable"@en ;
    rdfs:comment "Whether a PV system has the possibility of curtailment or not"@en ;
    rdfs:domain <https://w3id.org/react#PVSystem> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    ns1:term_status "testing"^^xsd:string .

<https://w3id.org/react#isManagedBy> a owl:ObjectProperty ;
    rdfs:label "isManagedBy"@en ;
    rdfs:comment "Relationship between an Executor and another Executor that manages it."@en ;
    rdfs:domain <https://w3id.org/eep#Executor> ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    rdfs:range <https://w3id.org/eep#Executor> ;
    ns1:term_status "stable"^^xsd:string .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

<https://w3id.org/react#PVSystem> a owl:Class ;
    rdfs:label "PV System"@en ;
    rdfs:comment "A system composed of one or more solar panels combined that use energy from the sun to generate electricity"@en ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    rdfs:subClassOf <https://w3id.org/eep#Executor> ;
    ns1:term_status "testing"@en .

<https://w3id.org/bot#Space> a owl:Class .

<https://w3id.org/react#Battery> a owl:Class ;
    rdfs:label "Battery"@en ;
    rdfs:comment "A unit that creates electrical energy from stored chemical energy"@en ;
    rdfs:isDefinedBy <https://w3id.org/react#> ;
    rdfs:subClassOf <https://w3id.org/eep#Executor> ;
    ns1:term_status "testing"@en .

<https://w3id.org/react#> a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual .

