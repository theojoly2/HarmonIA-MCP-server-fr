    ns1:elucidation "EXPECTED ratio between increased length and initial length after breakage AFTER CURING."@en ;
    rdfs:comment "EXPECTED ratio between increased length and initial length after breakage AFTER CURING."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#PrepregProperty> ;
