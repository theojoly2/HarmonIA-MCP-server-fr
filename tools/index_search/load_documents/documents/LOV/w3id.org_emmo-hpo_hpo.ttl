@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://w3id.org/emmo#> .
@prefix ns2: <http://purl.org/ontology/bibo/> .
@prefix onto: <http://w3id.org/emmo-hpo/hpo> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:elucidation owl:equivalentProperty ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 .

ns1:example owl:equivalentProperty ns1:EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a .

onto: a owl:Ontology ;
    dcterms:abstract "The Hyperdimensional Polymer Ontology (HPO) is an ontology meant to capture the staggering diversity of polymeric materials and their applications."@en ;
    dcterms:bibliographicCitation "Work under review - not available yet" ;
    dcterms:contributor <https://orcid.org/0000-0002-4181-2852>,
        <https://orcid.org/0000-0002-5174-8508>,
        <https://orcid.org/0000-0002-9668-6961> ;
    dcterms:created "2023-12-22" ;
    dcterms:creator <https://orcid.org/0000-0002-4181-2852>,
        <https://orcid.org/0000-0002-5174-8508>,
        <https://orcid.org/0000-0002-9668-6961> ;
    dcterms:description "An ontology to capture the staggering diversity of polymeric materials and their applications."@en ;
    dcterms:issued "2024-04-12" ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode" ;
    dcterms:modified "2024-04-12" ;
    dcterms:publisher "EMMC ASBL" ;
    dcterms:source "" ;
    dcterms:title "Hyperdimensional Polymer Ontology"@en ;
    ns2:doi "" ;
    ns2:status "" ;
    vann:preferredNamespacePrefix "hpo"@en ;
    vann:preferredNamespaceUri "http://w3id.org/emmo-hpo/hpo" ;
    rdfs:comment "Contacts:\\n\\tGerhard Goldbeck\\n\\tGoldbeck Consulting Ltd (UK)\\n\\temail: gerhard@goldbeck-consulting.com"@en ;
    owl:backwardCompatibleWith "" ;
    owl:imports <http://w3id.org/emmo-chameo/chameo>,
        <http://w3id.org/emmo/perspectives/physicalistic> ;
    owl:priorVersion "" ;
    owl:versionIRI <http://w3id.org/emmo-hpo/1.0.0-beta1/hpo> ;
    owl:versionInfo "1.0.0" ;
    foaf:logo "" .

<http://w3id.org/emmo-hpo/hpo#AdditionPolymer> a owl:Class ;
    rdfs:label "AdditionPolymer"@en ;
    ns1:elucidation "A polymer obtained through an addition reaction, that is, a reaction involving the creation of a single bond between the atoms of different molecules which are involved in a double or triple bond."@en ;
    rdfs:comment "A polymer obtained through an addition reaction, that is, a reaction involving the creation of a single bond between the atoms of different molecules which are involved in a double or triple bond."@en ;
    rdfs:subClassOf ns1:PolymericMaterial ;
    skos:prefLabel "AdditionPolymer"@en .

<http://w3id.org/emmo-hpo/hpo#BranchedChainPolymer> a owl:Class ;
    rdfs:label "BranchedChainPolymer"@en ;
    ns1:elucidation "A polymer whose molecular structure is characterised by a regular or irregular attachment of side chains to the main backbone chain. ."@en ;
    ns1:example "Glycogen, Star-polymers."@en ;
    rdfs:comment "A polymer whose molecular structure is characterised by a regular or irregular attachment of side chains to the main backbone chain. ."@en ;
    rdfs:subClassOf ns1:PolymericMaterial,
        <http://w3id.org/emmo-hpo/hpo#Branched> ;
    skos:prefLabel "BranchedChainPolymer"@en .

<http://w3id.org/emmo-hpo/hpo#COMPEVODSCAnalysis> a owl:Class ;
    rdfs:label "COMPEVODSCAnalysis"@en ;
    ns1:elucidation "Experimental procedure for resin reactivity measurement."@en ;
    rdfs:comment "Experimental procedure for resin reactivity measurement."@en ;
    rdfs:subClassOf ns1:Measurement ;
    skos:prefLabel "COMPEVODSCAnalysis"@en .

<http://w3id.org/emmo-hpo/hpo#CatalystCommercialName> a owl:Class ;
    rdfs:label "CatalystCommercialName"@en ;
    ns1:elucidation "Catalyst suppliers trade name for the purchased catalyst formulation."@en ;
    rdfs:comment "Catalyst suppliers trade name for the purchased catalyst formulation."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CatalystProperty> ;
    skos:prefLabel "CatalystCommercialName"@en .

<http://w3id.org/emmo-hpo/hpo#CatalystDensity> a owl:Class ;
    rdfs:label "CatalystDensity"@en ;
    ns1:elucidation "Mass density of the catalyst."@en ;
    rdfs:comment "Mass density of the catalyst."@en ;
    rdfs:subClassOf ns1:Density,
        <http://w3id.org/emmo-hpo/hpo#CatalystProperty> ;
    skos:prefLabel "CatalystDensity"@en .

<http://w3id.org/emmo-hpo/hpo#CatalystMolecularWeight> a owl:Class ;
    rdfs:label "CatalystMolecularWeight"@en ;
    ns1:elucidation "Average molecular weight of the catalyst molecular consituents."@en ;
    rdfs:comment "Average molecular weight of the catalyst molecular consituents."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CatalystProperty> ;
    skos:prefLabel "CatalystMolecularWeight"@en .

<http://w3id.org/emmo-hpo/hpo#CatalystViscosity> a owl:Class ;
    rdfs:label "CatalystViscosity"@en ;
    ns1:elucidation "Catalyst viscosity at 25°C."@en ;
    rdfs:comment "Catalyst viscosity at 25°C."@en ;
    rdfs:subClassOf ns1:DynamicViscosity,
        <http://w3id.org/emmo-hpo/hpo#CatalystProperty> ;
    skos:prefLabel "CatalystViscosity"@en .

<http://w3id.org/emmo-hpo/hpo#CoPolymer> a owl:Class ;
    rdfs:label "CoPolymer"@en ;
    ns1:elucidation "A polymer derived from the polymerisation of more than one species of monomer."@en ;
    rdfs:comment "A polymer derived from the polymerisation of more than one species of monomer."@en ;
    rdfs:subClassOf ns1:PolymericMaterial,
        ns1:TotalComposition ;
    skos:prefLabel "CoPolymer"@en .

<http://w3id.org/emmo-hpo/hpo#CompositeLaminateBulkPorosity> a owl:Class ;
    rdfs:label "CompositeLaminateBulkPorosity"@en ;
    ns1:elucidation "After performing a cross-cut perpendicular to the specimen surface, based on a light microscopy image, the apparent surface area fraction occupied by pores is evaluated."@en ;
    rdfs:comment "After performing a cross-cut perpendicular to the specimen surface, based on a light microscopy image, the apparent surface area fraction occupied by pores is evaluated."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
    skos:prefLabel "CompositeLaminateBulkPorosity"@en .

<http://w3id.org/emmo-hpo/hpo#CompositeLaminateSurfaceRegionPorosity> a owl:Class ;
    rdfs:label "CompositeLaminateSurfaceRegionPorosity"@en ;
    ns1:elucidation "Based on a light microscopy image of the smoother surface (i.e. the one visible to a user) of the composite laminate, the apparent surface area fraction occupied by pores is evaluated."@en ;
    rdfs:comment "Based on a light microscopy image of the smoother surface (i.e. the one visible to a user) of the composite laminate, the apparent surface area fraction occupied by pores is evaluated."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
    skos:prefLabel "CompositeLaminateSurfaceRegionPorosity"@en .

<http://w3id.org/emmo-hpo/hpo#CompositeLaminateVisualSurfaceFinish> a owl:Class ;
    rdfs:label "CompositeLaminateVisualSurfaceFinish"@en ;
    ns1:elucidation "Using a (set of) specimen illumination settings, the appearance is compared with the appearance of a specified set of (reference) specimens."@en ;
    rdfs:comment "Using a (set of) specimen illumination settings, the appearance is compared with the appearance of a specified set of (reference) specimens."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
    skos:prefLabel "CompositeLaminateVisualSurfaceFinish"@en .

<http://w3id.org/emmo-hpo/hpo#CondensationPolymer> a owl:Class ;
    rdfs:label "CondensationPolymer"@en ;
    ns1:elucidation "A polymer obtained through a condensation reaction, that is, where two molecules form a chemical bond by eliminating a small molecule such as water."@en ;
    rdfs:comment "A polymer obtained through a condensation reaction, that is, where two molecules form a chemical bond by eliminating a small molecule such as water."@en ;
    rdfs:subClassOf ns1:PolymericMaterial ;
    skos:prefLabel "CondensationPolymer"@en .

<http://w3id.org/emmo-hpo/hpo#CoverReleaseLayerIdentifier> a owl:Class ;
    rdfs:label "CoverReleaseLayerIdentifier"@en ;
    ns1:elucidation "Commercial name of the applied consumable (product), differentiating available product providers and product lots."@en ;
    rdfs:comment "Commercial name of the applied consumable (product), differentiating available product providers and product lots."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CoverReleaseLayerProperty> ;
    skos:prefLabel "CoverReleaseLayerIdentifier"@en .

<http://w3id.org/emmo-hpo/hpo#CoverToolHoleDistance> a owl:Class ;
    rdfs:label "CoverToolHoleDistance"@en ;
    ns1:elucidation "Average distance between holes."@en ;
    rdfs:comment "Average distance between holes."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CoverToolProperty> ;
    skos:prefLabel "CoverToolHoleDistance"@en .

<http://w3id.org/emmo-hpo/hpo#CoverToolLength> a owl:Class ;
    rdfs:label "CoverToolLength"@en ;
    ns1:elucidation "Length (contributing to the size of the tool)."@en ;
    rdfs:comment "Length (contributing to the size of the tool)."@en ;
    rdfs:subClassOf ns1:Length,
        <http://w3id.org/emmo-hpo/hpo#CoverToolProperty> ;
    skos:prefLabel "CoverToolLength"@en .

<http://w3id.org/emmo-hpo/hpo#CoverToolNumberOfHoles> a owl:Class ;
    rdfs:label "CoverToolNumberOfHoles"@en ;
    ns1:elucidation "Amount of holes."@en ;
    rdfs:comment "Amount of holes."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CoverToolProperty> ;
    skos:prefLabel "CoverToolNumberOfHoles"@en .

<http://w3id.org/emmo-hpo/hpo#CoverToolSizeOfHoles> a owl:Class ;
    rdfs:label "CoverToolSizeOfHoles"@en ;
    ns1:elucidation "Average diameter of holes."@en ;
    rdfs:comment "Average diameter of holes."@en ;
    rdfs:subClassOf ns1:Diameter,
        <http://w3id.org/emmo-hpo/hpo#CoverToolProperty> ;
    skos:prefLabel "CoverToolSizeOfHoles"@en .

<http://w3id.org/emmo-hpo/hpo#CoverToolWidth> a owl:Class ;
    rdfs:label "CoverToolWidth"@en ;
    ns1:elucidation "Width (contributing to the size of the tool)."@en ;
    rdfs:comment "Width (contributing to the size of the tool)."@en ;
    rdfs:subClassOf ns1:Width,
        <http://w3id.org/emmo-hpo/hpo#CoverToolProperty> ;
    skos:prefLabel "CoverToolWidth"@en .

<http://w3id.org/emmo-hpo/hpo#CrosslinkedPolymer> a owl:Class ;
    rdfs:label "CrosslinkedPolymer"@en ;
    ns1:elucidation "A polymer whose molecular structure is characterised by additional covalent bonds connecting several chains together."@en ;
    ns1:example "Bakelite, vulcanised rubber."@en ;
    rdfs:comment "A polymer whose molecular structure is characterised by additional covalent bonds connecting several chains together."@en ;
    rdfs:subClassOf ns1:PolymericMaterial,
        <http://w3id.org/emmo-hpo/hpo#Crosslinked> ;
    skos:prefLabel "CrosslinkedPolymer"@en .

<http://w3id.org/emmo-hpo/hpo#DegassingStepDuration> a owl:Class ;
    rdfs:label "DegassingStepDuration"@en ;
    ns1:elucidation "Duration of the degassing."@en ;
    rdfs:comment "Duration of the degassing."@en ;
    rdfs:subClassOf ns1:Duration,
        <http://w3id.org/emmo-hpo/hpo#ComponentManufacturingProperty> ;
    skos:prefLabel "DegassingStepDuration"@en .

<http://w3id.org/emmo-hpo/hpo#Elastomer> a owl:Class ;
    rdfs:label "Elastomer"@en ;
    ns1:elucidation "A polymer characterised by weak intermolecular forces and viscoelasticity."@en ;
    ns1:example "Neoprene, rubber."@en ;
    rdfs:comment "A polymer characterised by weak intermolecular forces and viscoelasticity."@en ;
    rdfs:subClassOf ns1:PolymericMaterial ;
    skos:prefLabel "Elastomer"@en .

<http://w3id.org/emmo-hpo/hpo#ElongationAtBreak> a owl:Class ;
    rdfs:label "ElongationAtBreak"@en ;
    ns1:elucidation "Ratio between increased length and initial length after breakage."@en ;
    rdfs:comment "Ratio between increased length and initial length after breakage."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
    skos:prefLabel "ElongationAtBreak"@en .

<http://w3id.org/emmo-hpo/hpo#Fibre> a owl:Class ;
    rdfs:label "Fibre"@en ;
    ns1:elucidation "A polymer characterised by strong intermolecular forces and high tensile strength."@en ;
    ns1:example "Cotton, Nylon."@en ;
    rdfs:comment "A polymer characterised by strong intermolecular forces and high tensile strength."@en ;
    rdfs:subClassOf ns1:PolymericMaterial ;
    skos:prefLabel "Fibre"@en .

<http://w3id.org/emmo-hpo/hpo#FibreDensity> a owl:Class ;
    rdfs:label "FibreDensity"@en ;
    ns1:elucidation "Mass per unit volume of the facbric."@en ;
    rdfs:comment "Mass per unit volume of the facbric."@en ;
    rdfs:subClassOf ns1:Density,
        <http://w3id.org/emmo-hpo/hpo#TextileFabricProperty> ;
    skos:prefLabel "FibreDensity"@en .

<http://w3id.org/emmo-hpo/hpo#FibreDiameter> a owl:Class ;
    rdfs:label "FibreDiameter"@en ;
    ns1:elucidation "Diameter of the fibre composing the fabric."@en ;
    rdfs:comment "Diameter of the fibre composing the fabric."@en ;
    rdfs:subClassOf ns1:Diameter,
        <http://w3id.org/emmo-hpo/hpo#TextileFabricProperty> ;
    skos:prefLabel "FibreDiameter"@en .

<http://w3id.org/emmo-hpo/hpo#FibreIdentifier> a owl:Class ;
    rdfs:label "FibreIdentifier"@en ;
    ns1:elucidation "Commercial name of the applied consumable (product), differentiating available product providers and product lots."@en ;
    rdfs:comment "Commercial name of the applied consumable (product), differentiating available product providers and product lots."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#TextileFabricProperty> ;
    skos:prefLabel "FibreIdentifier"@en .

<http://w3id.org/emmo-hpo/hpo#FibreVolumeContent> a owl:Class ;
    rdfs:label "FibreVolumeContent"@en ;
    ns1:elucidation "Ratio between the volume of fibre and the volume of the composite laminate."@en ;
    rdfs:comment "Ratio between the volume of fibre and the volume of the composite laminate."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
    skos:prefLabel "FibreVolumeContent"@en .

<http://w3id.org/emmo-hpo/hpo#Filler> a owl:Class ;
    rdfs:label "Filler"@en ;
    ns1:elucidation "A material (usually low cost) added to a resin to extend it, or give special properties"@en ;
    rdfs:comment "A material (usually low cost) added to a resin to extend it, or give special properties"@en ;
    rdfs:isDefinedBy "https://compositesuk.co.uk/composite-materials/glossary-of-terms/"^^xsd:anyURI ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#ResinIngredient> ;
    skos:prefLabel "Filler"@en .

<http://w3id.org/emmo-hpo/hpo#FinalStepPressure> a owl:Class ;
    rdfs:label "FinalStepPressure"@en ;
    ns1:elucidation "Final pressure of the container during step."@en ;
    rdfs:comment "Final pressure of the container during step."@en ;
    rdfs:subClassOf ns1:Pressure,
        <http://w3id.org/emmo-hpo/hpo#ComponentManufacturingProperty> ;
    skos:prefLabel "FinalStepPressure"@en .

<http://w3id.org/emmo-hpo/hpo#FinalStepTemperature> a owl:Class ;
    rdfs:label "FinalStepTemperature"@en ;
    ns1:elucidation "Final temperature of the container during step."@en ;
    rdfs:comment "Final temperature of the container during step."@en ;
    rdfs:subClassOf ns1:ThermodynamicTemperature,
        <http://w3id.org/emmo-hpo/hpo#ComponentManufacturingProperty> ;
    skos:prefLabel "FinalStepTemperature"@en .

<http://w3id.org/emmo-hpo/hpo#FlexualModulus> a owl:Class ;
    rdfs:label "FlexualModulus"@en ;
    ns1:elucidation "Tangent of the stress-strain curve under flexural stress."@en ;
    rdfs:comment "Tangent of the stress-strain curve under flexural stress."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
    skos:prefLabel "FlexualModulus"@en .

<http://w3id.org/emmo-hpo/hpo#FlexuralStrength> a owl:Class ;
    rdfs:label "FlexuralStrength"@en ;
    ns1:elucidation "Maximum value of the stress-strain curve under flexural stress."@en ;
    rdfs:comment "Maximum value of the stress-strain curve under flexural stress."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
    skos:prefLabel "FlexuralStrength"@en .

<http://w3id.org/emmo-hpo/hpo#FormulatedResinCuringTemperature> a owl:Class ;
    rdfs:label "FormulatedResinCuringTemperature"@en ;
    ns1:elucidation "Temperature required to start the process of cure of the resin."@en ;
    rdfs:comment "Temperature required to start the process of cure of the resin."@en ;
    rdfs:subClassOf ns1:ThermodynamicTemperature,
        <http://w3id.org/emmo-hpo/hpo#FormulatedResinProperty> ;
    skos:prefLabel "FormulatedResinCuringTemperature"@en .

<http://w3id.org/emmo-hpo/hpo#FormulatedResinCuringTime> a owl:Class ;
    rdfs:label "FormulatedResinCuringTime"@en ;
    ns1:elucidation "Time at which the curing temperature must be held to achieve a certain level of cure."@en ;
    rdfs:comment "Time at which the curing temperature must be held to achieve a certain level of cure."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#FormulatedResinProperty> ;
    skos:prefLabel "FormulatedResinCuringTime"@en .

<http://w3id.org/emmo-hpo/hpo#FormulatedResinGlassTransitionTemperature> a owl:Class ;
    rdfs:label "FormulatedResinGlassTransitionTemperature"@en ;
    ns1:elucidation "Process in which a polymer melt changes on cooling to a polymer glass or a polymer glass changes on heating to a polymer melt."@en ;
    rdfs:comment "Process in which a polymer melt changes on cooling to a polymer glass or a polymer glass changes on heating to a polymer melt."@en ;
    rdfs:subClassOf ns1:ThermodynamicTemperature,
        <http://w3id.org/emmo-hpo/hpo#FormulatedResinProperty> ;
    skos:prefLabel "FormulatedResinGlassTransitionTemperature"@en .

<http://w3id.org/emmo-hpo/hpo#FormulatedResinSpecificCondensateFormation> a owl:Class ;
    rdfs:label "FormulatedResinSpecificCondensateFormation"@en ;
    ns1:elucidation "Mass of water released per mass of resin throughout the applied chemical (curing) reaction."@en ;
    rdfs:comment "Mass of water released per mass of resin throughout the applied chemical (curing) reaction."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#FormulatedResinProperty> ;
    skos:prefLabel "FormulatedResinSpecificCondensateFormation"@en .

<http://w3id.org/emmo-hpo/hpo#FormulatedResinViscosity> a owl:Class ;
    rdfs:label "FormulatedResinViscosity"@en ;
    ns1:elucidation "Dynamic viscosity of the resin."@en ;
    rdfs:comment "Dynamic viscosity of the resin."@en ;
    rdfs:subClassOf ns1:DynamicViscosity,
        <http://w3id.org/emmo-hpo/hpo#FormulatedResinProperty> ;
    skos:prefLabel "FormulatedResinViscosity"@en .

<http://w3id.org/emmo-hpo/hpo#FormulatedResinWaterContent> a owl:Class ;
    rdfs:label "FormulatedResinWaterContent"@en ;
    ns1:elucidation "Weight percentage of (dissolved and freezable) water in the base resin."@en ;
    rdfs:comment "Weight percentage of (dissolved and freezable) water in the base resin."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#FormulatedResinProperty> ;
    skos:prefLabel "FormulatedResinWaterContent"@en .

<http://w3id.org/emmo-hpo/hpo#GlassTransitionTemperature> a owl:Class ;
    rdfs:label "GlassTransitionTemperature"@en ;
    ns1:elucidation "Temperature for transition from glassy state into a viscous one."@en ;
    rdfs:comment "Temperature for transition from glassy state into a viscous one."@en ;
    rdfs:subClassOf ns1:ThermodynamicTemperature,
        <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
    skos:prefLabel "GlassTransitionTemperature"@en .

<http://w3id.org/emmo-hpo/hpo#HeatingRateDuringStep> a owl:Class ;
    rdfs:label "HeatingRateDuringStep"@en ;
    ns1:elucidation "Heating rate during step."@en ;
    rdfs:comment "Heating rate during step."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#ComponentManufacturingProperty> ;
    skos:prefLabel "HeatingRateDuringStep"@en .

<http://w3id.org/emmo-hpo/hpo#HomoPolymer> a owl:Class ;
    rdfs:label "HomoPolymer"@en ;
    ns1:elucidation "A polymer derived from the polymerisation of one kind of monomer."@en ;
    rdfs:comment "A polymer derived from the polymerisation of one kind of monomer."@en ;
    rdfs:subClassOf ns1:PolymericMaterial,
        ns1:TotalComposition ;
    skos:prefLabel "HomoPolymer"@en .

<http://w3id.org/emmo-hpo/hpo#InitialStepPressure> a owl:Class ;
    rdfs:label "InitialStepPressure"@en ;
    ns1:elucidation "Pressure during step."@en ;
    rdfs:comment "Pressure during step."@en ;
    rdfs:subClassOf ns1:Pressure,
        <http://w3id.org/emmo-hpo/hpo#ComponentManufacturingProperty> ;
    skos:prefLabel "InitialStepPressure"@en .

<http://w3id.org/emmo-hpo/hpo#InitialStepTemperature> a owl:Class ;
    rdfs:label "InitialStepTemperature"@en ;
    ns1:elucidation "Initial temperature of the container during step."@en ;
    rdfs:comment "Initial temperature of the container during step."@en ;
    rdfs:subClassOf ns1:ThermodynamicTemperature,
        <http://w3id.org/emmo-hpo/hpo#ComponentManufacturingProperty> ;
    skos:prefLabel "InitialStepTemperature"@en .

<http://w3id.org/emmo-hpo/hpo#InterlaminarShearStrength> a owl:Class ;
    rdfs:label "InterlaminarShearStrength"@en ;
    ns1:elucidation "Mechanical property associated with the matrix-fibre interaction."@en ;
    rdfs:comment "Mechanical property associated with the matrix-fibre interaction."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
    skos:prefLabel "InterlaminarShearStrength"@en .

<http://w3id.org/emmo-hpo/hpo#LinearPolymer> a owl:Class ;
    rdfs:label "LinearPolymer"@en ;
    ns1:elucidation "A polymer whose molecular structure is characterised by a linear chain of repeating units."@en ;
    ns1:example "Polyethylene, polystyrene."@en ;
    rdfs:comment "A polymer whose molecular structure is characterised by a linear chain of repeating units."@en ;
    rdfs:subClassOf ns1:PolymericMaterial,
        <http://w3id.org/emmo-hpo/hpo#Linear> ;
    skos:prefLabel "LinearPolymer"@en .

<http://w3id.org/emmo-hpo/hpo#Monomer> a owl:Class ;
    rdfs:label "Monomer"@en ;
    ns1:elucidation "A single molecule that reacts with like or unlike molecules to form a polymer. "@en ;
    rdfs:comment "A single molecule that reacts with like or unlike molecules to form a polymer. "@en ;
    rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#ResinIngredient> ;
    skos:prefLabel "Monomer"@en .

<http://w3id.org/emmo-hpo/hpo#MouldReleaseLayerIdentifier> a owl:Class ;
