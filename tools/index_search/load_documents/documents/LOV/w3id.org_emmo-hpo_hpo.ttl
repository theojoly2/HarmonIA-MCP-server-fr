<http://w3id.org/emmo-hpo/hpo#Catalyst> a owl:Class ;
    rdfs:label "Catalyst"@en ;
    ns1:elucidation "A substance that increases the rate of a reaction without modifying the overall standard Gibbs energy change in the reaction."@en ;
    rdfs:comment "A substance that increases the rate of a reaction without modifying the overall standard Gibbs energy change in the reaction."@en ;
    rdfs:seeAlso "https://doi.org/10.1351/goldbook.C00876"@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#ResinIngredient> ;
    skos:prefLabel "Catalyst"@en .

<http://w3id.org/emmo-hpo/hpo#CoverReleaseLayer> a owl:Class ;
    rdfs:label "CoverReleaseLayer"@en ;
    ns1:elucidation "A release layer applied to a cover placed over the laminate."@en ;
    rdfs:comment "A release layer applied to a cover placed over the laminate."@en ;
    rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#ReleaseLayer> ;
    skos:prefLabel "CoverReleaseLayer"@en .

<http://w3id.org/emmo-hpo/hpo#CoverTool> a owl:Class ;
    rdfs:label "CoverTool"@en ;
    ns1:elucidation "The mold, either one- or two-sided and either open or closed, in or upon which composite material is placed in order to make a part."@en ;
    rdfs:comment "The mold, either one- or two-sided and either open or closed, in or upon which composite material is placed in order to make a part."@en ;
    rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI ;
    rdfs:subClassOf ns1:Tool ;
    skos:prefLabel "CoverTool"@en .

<http://w3id.org/emmo-hpo/hpo#MouldReleaseLayer> a owl:Class ;
    rdfs:label "MouldReleaseLayer"@en ;
    ns1:elucidation "A lubricant used to prevent a part from sticking to a mold surface."@en ;
    rdfs:comment "A lubricant used to prevent a part from sticking to a mold surface."@en ;
    rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#ReleaseLayer> ;
    skos:prefLabel "MouldReleaseLayer"@en .

<http://w3id.org/emmo-hpo/hpo#MouldTool> a owl:Class ;
    rdfs:label "MouldTool"@en ;
    ns1:elucidation "An enclosed cavity or open form from which a composite component takes its shape, size and exterior surface appearance (also known as a tool)."@en ;
    rdfs:comment "An enclosed cavity or open form from which a composite component takes its shape, size and exterior surface appearance (also known as a tool)."@en ;
    rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI ;
    rdfs:subClassOf ns1:Tool ;
    skos:prefLabel "MouldTool"@en .

<http://w3id.org/emmo-hpo/hpo#MouldToolProperty> a owl:Class ;
    rdfs:label "MouldToolProperty"@en ;
    ns1:elucidation "A collection of the properties of moulds or tools."@en ;
    rdfs:comment "A collection of the properties of moulds or tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/emmo-hpo/hpo#MouldTool> ;
            owl:onProperty [ owl:inverseOf ns1:hasProperty ] ],
        ns1:Objective ;
    skos:prefLabel "MouldToolProperty"@en .

<http://w3id.org/emmo-hpo/hpo#Prepreg> a owl:Class ;
    rdfs:label "Prepreg"@en ;
    ns1:elucidation "A factory-made combination of reactive resins and reinforcing fibres, plus other necessary additive chemicals, ready to be moulded."@en ;
    rdfs:comment "A factory-made combination of reactive resins and reinforcing fibres, plus other necessary additive chemicals, ready to be moulded."@en ;
    rdfs:isDefinedBy "https://compositesuk.co.uk/composite-materials/glossary-terms"^^xsd:anyURI ;
    rdfs:subClassOf ns1:ManufacturedProduct ;
    skos:prefLabel "Prepreg"@en .

<http://w3id.org/emmo-hpo/hpo#PrepregRoll> a owl:Class ;
    rdfs:label "PrepregRoll"@en ;
    ns1:elucidation "A roll of prepreg material."@en ;
    rdfs:comment "A roll of prepreg material."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:hasNext ] ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#FormulatedResin> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:hasNext ] ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#TextileFabric> ],
        <http://w3id.org/emmo-hpo/hpo#Prepreg> ;
    skos:prefLabel "PrepregRoll"@en .

<http://w3id.org/emmo-hpo/hpo#SkeletalFormula> a owl:Class ;
    rdfs:label "SkeletalFormula"@en ;
    ns1:elucidation "A 2-dimensional representation of chemical structures of organic compounds, showing the chemical bonds as lines, carbon atoms as vertices, and hetero atoms with labels. Hydrogen atoms are omitted in the representation since their presence can be derived from the valence of carbon atoms."@en ;
    rdfs:comment "A 2-dimensional representation of chemical structures of organic compounds, showing the chemical bonds as lines, carbon atoms as vertices, and hetero atoms with labels. Hydrogen atoms are omitted in the representation since their presence can be derived from the valence of carbon atoms."@en ;
    rdfs:subClassOf ns1:ChemicalRepresentation ;
    skos:prefLabel "SkeletalFormula"@en .

<http://w3id.org/emmo-hpo/hpo#TextileFabric> a owl:Class ;
    rdfs:label "TextileFabric"@en ;
    ns1:elucidation "A planar textile constructed with fibres (or yarns), which can be either woven (interlaced using a weaving process) or non-woven (not interlaced)."@en ;
    rdfs:comment "A planar textile constructed with fibres (or yarns), which can be either woven (interlaced using a weaving process) or non-woven (not interlaced)."@en ;
    rdfs:subClassOf ns1:ManufacturedProduct,
        ns1:Material ;
    skos:prefLabel "TextileFabric"@en .

