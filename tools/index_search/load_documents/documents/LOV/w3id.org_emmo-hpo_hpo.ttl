<http://w3id.org/emmo-hpo/hpo#FormulatedResin> a owl:Class ;
    rdfs:label "FormulatedResin"@en ;
    ns1:elucidation "A manufactured mixture of a resin and ingredients."@en ;
    rdfs:comment "A manufactured mixture of a resin and ingredients."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:hasNext ] ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#Resin> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:hasNext ] ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#Catalyst> ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:hasNext ] ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#Additive> ],
        ns1:ManufacturedMaterial,
        ns1:Mixture,
        <http://w3id.org/emmo-hpo/hpo#Resin> ;
