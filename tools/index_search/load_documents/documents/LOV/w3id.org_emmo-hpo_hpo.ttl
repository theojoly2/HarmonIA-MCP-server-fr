    ns1:elucidation "Solvents, such as water and alcohol, in a sizing or resin formulation that can be vaporized at ambient or slightly elevated temperatures."@en ;
    rdfs:comment "Solvents, such as water and alcohol, in a sizing or resin formulation that can be vaporized at ambient or slightly elevated temperatures."@en ;
    rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#ResinIngredient> ;
    skos:altLabel "Solvent"@en ;
    skos:prefLabel "Volatile"@en .

