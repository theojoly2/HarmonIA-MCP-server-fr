    ns1:elucidation "The storage modulus in viscoelastic materials measure the stored energy representing the elastic portion."@en ;
    rdfs:comment "The storage modulus in viscoelastic materials measure the stored energy representing the elastic portion."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#CompositeLaminateProperty> ;
