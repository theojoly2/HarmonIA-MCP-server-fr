<http://w3id.org/emmo-hpo/hpo#Additive> a owl:Class ;
    rdfs:label "Additive"@en ;
    ns1:elucidation "A term used for a large number of specialist chemicals which are added to compounds to impart specific properties."@en ;
    ns1:example "An additive can provide flame retardancy and UV resistance properties to a resin."@en ;
    rdfs:comment "A term used for a large number of specialist chemicals which are added to compounds to impart specific properties."@en ;
    rdfs:isDefinedBy "https://compositesuk.co.uk/composite-materials/glossary-terms"^^xsd:anyURI ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#ResinIngredient> ;
    skos:prefLabel "Additive"@en .

<http://w3id.org/emmo-hpo/hpo#CompositeLaminate> a owl:Class ;
    rdfs:label "CompositeLaminate"@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:hasNext ] ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#StackedPrepreg> ],
        ns1:ManufacturedProduct ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://w3id.org/emmo-hpo/hpo#Composite> <http://w3id.org/emmo-hpo/hpo#Laminate> ) ] ;
    skos:prefLabel "CompositeLaminate"@en .

<http://w3id.org/emmo-hpo/hpo#ManufacturingLine> a owl:Class ;
    rdfs:label "ManufacturingLine"@en ;
    ns1:elucidation "A manufacturing line is a set of sequential operations in a factory where materials are processed, assembled, and/or refined to produce a finished product or an intermediate product for further processing."@en ;
    rdfs:comment "A manufacturing line is a set of sequential operations in a factory where materials are processed, assembled, and/or refined to produce a finished product or an intermediate product for further processing."@en ;
    rdfs:subClassOf ns1:ManufacturingSystem ;
    skos:prefLabel "ManufacturingLine"@en .

<http://w3id.org/emmo-hpo/hpo#PrepregPiece> a owl:Class ;
    rdfs:label "PrepregPiece"@en ;
    ns1:elucidation "A prepreg a piece cut from a prepreg roll, which can be stacked."@en ;
    rdfs:comment "A prepreg a piece cut from a prepreg roll, which can be stacked."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:hasNext ] ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#PrepregRoll> ],
        <http://w3id.org/emmo-hpo/hpo#Prepreg> ;
    skos:altLabel "Ply"@en,
        "PrepregPart"@en ;
    skos:prefLabel "PrepregPiece"@en .

<http://w3id.org/emmo-hpo/hpo#ReleaseLayer> a owl:Class ;
    rdfs:label "ReleaseLayer"@en ;
    ns1:elucidation "A specially formulated material placed between the mold and uncured resin/fiber (usually sprayed or painted on the mold surface) to prevent permanent bonding between the two during cure and facilitates demolding after cure."@en ;
    rdfs:comment "A specially formulated material placed between the mold and uncured resin/fiber (usually sprayed or painted on the mold surface) to prevent permanent bonding between the two during cure and facilitates demolding after cure."@en ;
    rdfs:isDefinedBy "https://compositesuk.co.uk/composite-materials/glossary-terms"^^xsd:anyURI ;
    rdfs:subClassOf ns1:ManufacturedProduct,
        ns1:Material ;
    skos:prefLabel "ReleaseLayer"@en .

