<http://w3id.org/emmo-hpo/hpo#Resin> a owl:Class ;
    rdfs:label "Resin"@en ;
    ns1:elucidation "Soft solid or highly viscous substance, usually containing prepolymers with reactive groups."@en ;
    rdfs:comment "Soft solid or highly viscous substance, usually containing prepolymers with reactive groups."@en ;
