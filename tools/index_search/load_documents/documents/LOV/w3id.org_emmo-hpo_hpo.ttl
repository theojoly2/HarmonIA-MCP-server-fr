    ns1:elucidation "Arrangement of ply prepregs in a laminate."@en ;
    rdfs:comment "Arrangement of ply prepregs in a laminate."@en ;
    rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
