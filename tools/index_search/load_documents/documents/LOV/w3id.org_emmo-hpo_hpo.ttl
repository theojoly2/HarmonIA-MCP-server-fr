<http://w3id.org/emmo-hpo/hpo#Prepregging> a owl:Class ;
    rdfs:label "Prepregging"@en ;
    ns1:elucidation "The process of prepreg manufacturing."@en ;
    rdfs:comment "The process of prepreg manufacturing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasManufacturedOutput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#PrepregRoll> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasParticipant ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#PrepregLine> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasInput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#TextileFabric> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasInput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#FormulatedResin> ],
        ns1:Manufacturing ;
    skos:prefLabel "Prepregging"@en .

<http://w3id.org/emmo-hpo/hpo#ResinComposition> a owl:Class ;
