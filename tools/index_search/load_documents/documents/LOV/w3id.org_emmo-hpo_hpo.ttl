    ns1:elucidation "Effective and anisotropic proportionality constant between the molar (or mass) flux due to molecular diffusion (out of the prepreg specimen)."@en ;
    rdfs:comment "Effective and anisotropic proportionality constant between the molar (or mass) flux due to molecular diffusion (out of the prepreg specimen)."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#PrepregProperty> ;
