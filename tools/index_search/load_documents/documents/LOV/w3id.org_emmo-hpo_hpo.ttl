<http://w3id.org/emmo-hpo/hpo#Branched> a owl:Class ;
    rdfs:label "Branched"@en ;
    ns1:elucidation "A class of structures characterised by a branched skeleton."@en ;
    rdfs:comment "A class of structures characterised by a branched skeleton."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#SkeletalFormula> ;
    skos:prefLabel "Branched"@en .

<http://w3id.org/emmo-hpo/hpo#ComponentManufacturing> a owl:Class ;
    rdfs:label "ComponentManufacturing"@en ;
    ns1:elucidation "The manufacturing of a component made of a composite material."@en ;
    rdfs:comment "The manufacturing of a component made of a composite material."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasStage ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#ShapingAndCuring> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasStage ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#Stacking> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasParticipant ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#ComponentManufacturingLine> ],
        ns1:Manufacturing ;
    skos:prefLabel "ComponentManufacturing"@en .

<http://w3id.org/emmo-hpo/hpo#ComponentManufacturingLine> a owl:Class ;
    rdfs:label "ComponentManufacturingLine"@en ;
    ns1:elucidation "A manufacturing line processing a composite material into a component."@en ;
    rdfs:comment "A manufacturing line processing a composite material into a component."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasConstituent ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#MouldReleaseLayer> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasConstituent ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#CoverTool> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasConstituent ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#CoverReleaseLayer> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasConstituent ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#MouldTool> ],
        <http://w3id.org/emmo-hpo/hpo#ManufacturingLine> ;
    skos:prefLabel "ComponentManufacturingLine"@en .

<http://w3id.org/emmo-hpo/hpo#Composite> a owl:Class ;
    rdfs:label "Composite"@en ;
    ns1:elucidation "A material made up of resin and reinforcement (usually fibre)."@en ;
    rdfs:comment "A material made up of resin and reinforcement (usually fibre)."@en ;
    rdfs:isDefinedBy "https://compositesuk.co.uk/composite-materials/glossary-terms"^^xsd:anyURI ;
    rdfs:subClassOf ns1:ManufacturedMaterial ;
    skos:prefLabel "Composite"@en .

<http://w3id.org/emmo-hpo/hpo#CoverReleaseLayerProperty> a owl:Class ;
    rdfs:label "CoverReleaseLayerProperty"@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/emmo-hpo/hpo#CoverReleaseLayer> ;
            owl:onProperty [ owl:inverseOf ns1:hasProperty ] ],
        ns1:Objective ;
    skos:prefLabel "CoverReleaseLayerProperty"@en .

<http://w3id.org/emmo-hpo/hpo#Crosslinked> a owl:Class ;
    rdfs:label "Crosslinked"@en ;
    ns1:elucidation "A class of structures characterised by a bond or a short sequence of bonds connecting different macromolecules."@en ;
    rdfs:comment "A class of structures characterised by a bond or a short sequence of bonds connecting different macromolecules."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#SkeletalFormula> ;
    skos:prefLabel "Crosslinked"@en .

<http://w3id.org/emmo-hpo/hpo#Laminate> a owl:Class ;
    rdfs:label "Laminate"@en ;
    ns1:elucidation "The structure resulting from the curing of multiple stacked prepreg plies."@en ;
    rdfs:comment "The structure resulting from the curing of multiple stacked prepreg plies."@en ;
    rdfs:isDefinedBy "https://compositesuk.co.uk/composite-materials/glossary-terms"^^xsd:anyURI ;
    rdfs:subClassOf ns1:ManufacturedMaterial ;
    skos:prefLabel "Laminate"@en .

<http://w3id.org/emmo-hpo/hpo#Linear> a owl:Class ;
    rdfs:label "Linear"@en ;
    ns1:elucidation "A class of structures characterised by a linear skeleton."@en ;
    rdfs:comment "A class of structures characterised by a linear skeleton."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#SkeletalFormula> ;
    skos:prefLabel "Linear"@en .

<http://w3id.org/emmo-hpo/hpo#MouldReleaseLayerProperty> a owl:Class ;
    rdfs:label "MouldReleaseLayerProperty"@en ;
    ns1:elucidation "A collection of the properties of the release layer of a mould or tool."@en ;
    rdfs:comment "A collection of the properties of the release layer of a mould or tool."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/emmo-hpo/hpo#MouldReleaseLayer> ;
            owl:onProperty [ owl:inverseOf ns1:hasProperty ] ],
        ns1:Objective ;
    skos:prefLabel "MouldReleaseLayerProperty"@en .

<http://w3id.org/emmo-hpo/hpo#PrepregLine> a owl:Class ;
    rdfs:label "PrepregLine"@en ;
    ns1:elucidation "A manufacturing line processing a prepreg for later use."@en ;
    rdfs:comment "A manufacturing line processing a prepreg for later use."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#ManufacturingLine> ;
    skos:prefLabel "PrepregLine"@en .

<http://w3id.org/emmo-hpo/hpo#ResinMixer> a owl:Class ;
    rdfs:label "ResinMixer"@en ;
    ns1:elucidation "A batch resin mixer."@en ;
    rdfs:comment "A batch resin mixer."@en ;
    rdfs:subClassOf ns1:ManufacturingDevice ;
    skos:prefLabel "ResinMixer"@en .

<http://w3id.org/emmo-hpo/hpo#ShapingAndCuring> a owl:Class ;
    rdfs:label "ShapingAndCuring"@en ;
    ns1:elucidation "The process of shaping composite materials into a solid mass of prescribed shape and size, using a mold or tool."@en ;
    rdfs:comment "The process of shaping composite materials into a solid mass of prescribed shape and size, using a mold or tool."@en ;
    rdfs:isDefinedBy "https://www.compositesworld.com/glossary"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasManufacturedOutput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#CompositeLaminate> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasInput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#StackedPrepreg> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasParticipant ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#CoverReleaseLayer> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasParticipant ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#MouldReleaseLayer> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasParticipant ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#CoverTool> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasParticipant ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#MouldTool> ],
        ns1:Manufacturing ;
    skos:altLabel "Moulding"@en ;
    skos:prefLabel "ShapingAndCuring"@en .

<http://w3id.org/emmo-hpo/hpo#Stacking> a owl:Class ;
    rdfs:label "Stacking"@en ;
    ns1:elucidation "An arrangement of prepreg parts (ply) orientations and material components in a laminate specified with respect to some reference direction."@en ;
    rdfs:comment "An arrangement of prepreg parts (ply) orientations and material components in a laminate specified with respect to some reference direction."@en ;
    rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasInput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#PrepregRoll> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasManufacturedOutput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#StackedPrepreg> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasParticipant ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#PrepregPiece> ],
        ns1:Manufacturing ;
    skos:prefLabel "Stacking"@en .

<http://w3id.org/emmo-hpo/hpo#ThermosettingPolymer> a owl:Class ;
    rdfs:label "ThermosettingPolymer"@en ;
    ns1:elucidation "A polymer that becomes irreversibly hard by creating an extensive network of cross-linking between the individual chains."@en ;
    ns1:example "Epoxy resins, Polyurethanes."@en ;
    rdfs:comment "A polymer that becomes irreversibly hard by creating an extensive network of cross-linking between the individual chains."@en ;
    rdfs:subClassOf ns1:PolymericMaterial ;
    skos:prefLabel "ThermosettingPolymer"@en .

