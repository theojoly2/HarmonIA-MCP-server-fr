<http://w3id.org/emmo-hpo/hpo#ResinPreparation> a owl:Class ;
    rdfs:label "ResinPreparation"@en ;
    ns1:elucidation "Preparing a resin involves mixing the precursor (monomers) with a hardener or a catalyst, fillers, and additives."@en ;
    rdfs:comment "Preparing a resin involves mixing the precursor (monomers) with a hardener or a catalyst, fillers, and additives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasParticipant ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#ResinMixer> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasManufacturedOutput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#FormulatedResin> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasInput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#Catalyst> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasInput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#Additive> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasInput ;
            owl:someValuesFrom <http://w3id.org/emmo-hpo/hpo#Resin> ],
        ns1:Manufacturing ;
    skos:prefLabel "ResinPreparation"@en .

<http://w3id.org/emmo-hpo/hpo#ResinReactivity> a owl:Class ;
