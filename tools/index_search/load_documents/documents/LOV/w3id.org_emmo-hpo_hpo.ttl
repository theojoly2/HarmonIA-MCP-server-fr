<http://w3id.org/emmo-hpo/hpo#ThermoplasticPolymer> a owl:Class ;
    rdfs:label "ThermoplasticPolymer"@en ;
    ns1:elucidation "A polymer that becomes pliable and mouldable (i.e. plastic) above a certain temperature, and that reversibly solidifies upon cooling. Thermoplastics typically have linear chains and high molecular weight, increasing the strength of intermolecular interactions."@en ;
    ns1:example "Polyacrylic acids, Polylactic acid, Polycarbonate."@en ;
    rdfs:comment "A polymer that becomes pliable and mouldable (i.e. plastic) above a certain temperature, and that reversibly solidifies upon cooling. Thermoplastics typically have linear chains and high molecular weight, increasing the strength of intermolecular interactions."@en ;
    rdfs:subClassOf ns1:PolymericMaterial ;
    skos:prefLabel "ThermoplasticPolymer"@en .

