    ns1:elucidation "Characteristic temperature (range) of the process in which a polymer melt changes on cooling to a polymer glass or a polymer glass changes on heating to a polymer melt."@en ;
    rdfs:comment "Characteristic temperature (range) of the process in which a polymer melt changes on cooling to a polymer glass or a polymer glass changes on heating to a polymer melt."@en ;
    rdfs:subClassOf ns1:ThermodynamicTemperature,
        <http://w3id.org/emmo-hpo/hpo#PrepregProperty> ;
