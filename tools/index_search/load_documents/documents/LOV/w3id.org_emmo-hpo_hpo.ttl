    rdfs:comment "Weight percentage of water in the prepreg (that can be dried and is not formed during the curing reaction)."@en ;
    rdfs:subClassOf <http://w3id.org/emmo-hpo/hpo#PrepregProperty> ;
    skos:prefLabel "PrepregWaterContent"@en .

<http://w3id.org/emmo-hpo/hpo#PrepregWaterDiffusionCoefficient> a owl:Class ;
