@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://metadataregistry.org/uri/profile/RegAp/> .
@prefix onto: <http://rdvocab.info/uri/schema/FRBRentitiesRDA> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> a owl:Class ;
    rdfs:label "Expression"@en ;
    ns1:name "Expression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "The intellectual or artistic realization of a work in the form of alpha-numeric, musical, or choreographic notation, sound, image, object, movement, etc., or any combination of such forms."@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Item> a owl:Class ;
    rdfs:label "Item"@en ;
    ns1:name "Item"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A single exemplar of a manifestation. "@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Manifestation> a owl:Class ;
    rdfs:label "Manifestation"@en ;
    ns1:name "Manifestation"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "The physical embodiment of an expression of a work. "@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Name> a owl:Class ;
    rdfs:label "Name"@en ;
    ns1:name "Name"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A word, character, or group of words and/or characters by which a person, family, or corporate body is known."@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> a owl:Class ;
    rdfs:label "Work"@en ;
    ns1:name "Work"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A distinct intellectual or artistic creation. "@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Concept> a owl:Class ;
    rdfs:label "Concept"@en ;
    ns1:name "Concept"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Subject> ;
    skos:definition "An abstract notion or idea."@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody> a owl:Class ;
    rdfs:label "Corporate Body"@en ;
    ns1:name "CorporateBody"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Agent> ;
    skos:definition "An organization or group of individuals and/or organizations acting as a unit."@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Event> a owl:Class ;
    rdfs:label "Event"@en ;
    ns1:name "Event"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Subject> ;
    skos:definition "An action or occurrence."@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Family> a owl:Class ;
    rdfs:label "Family"@en ;
    ns1:name "Family"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Agent> .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Object> a owl:Class ;
    rdfs:label "Object"@en ;
    ns1:name "Object"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Subject> ;
    skos:definition "A material thing."@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> a owl:Class ;
    rdfs:label "Person"@en ;
    ns1:name "Person"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Agent> ;
    skos:definition "An individual."@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Place> a owl:Class ;
    rdfs:label "Place"@en ;
    ns1:name "Place"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Subject> ;
    skos:definition "A location."@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Agent> a owl:Class ;
    rdfs:label "Agent"@en ;
    ns1:hasSubClass <http://rdvocab.info/uri/schema/FRBRentitiesRDA/CorporateBody>,
        <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Family>,
        <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Person> ;
    ns1:name "Agent"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:scopeNote "Based on FRBRoo/CIDOC-CRM concept of E39 Actor as agent."@en .

<http://rdvocab.info/uri/schema/FRBRentitiesRDA/Subject> a owl:Class ;
    rdfs:label "Subject"@en ;
    ns1:hasSubClass <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Concept>,
        <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Event>,
        <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Object>,
        <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Place> ;
    ns1:name "Subject"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: .

<http://metadataregistry.org/uri/RegStatus/1002> a skos:Concept ;
    skos:prefLabel "New-Proposed"@en .

onto: dc:title "FRBR Entities for RDA"@en ;
    skos:note "Registration of FRBR entities for use in RDA.  "@en .

