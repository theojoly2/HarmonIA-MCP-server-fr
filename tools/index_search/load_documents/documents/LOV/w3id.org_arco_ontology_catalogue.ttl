ns1:referenceProject a owl:DatatypeProperty ;
    rdfs:label "reference project"@en ;
    rdfs:comment "This property represents the reference project of a record about a cultural property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:AlternativeIdentifier ns1:CulturalPropertyRecord ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACC/ACCP; AC/ACS/ACSP" .

<https://w3id.org/arco/ontology/context-description/isAgentRelatedTo> a owl:ObjectProperty .

<https://w3id.org/italia/onto/RO/hasRiT> a owl:ObjectProperty .

ns1:PrivacyReason a owl:Class ;
    rdfs:label "Privacy reason"@en ;
    rdfs:comment "This class represents the reason for the adoption of a specific access profile for a catalogue record."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:isPrivacyReasonOf ;
            owl:someValuesFrom ns1:AccessProfile ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS/ADSM" .

ns1:isPreviousVersionOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is previous version of"@en ;
    ns2:isNativeTo <https://w3id.org/arco/pattern/catalogue-record-sequence/> ;
    rdfs:comment "Property used to associate a catalogue record version one of its next version."@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CatalogueRecordVersion ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/precedes> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/hasRelatedAgent> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/hasCharacteristic> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/isCharacteristicOf> a owl:ObjectProperty .

<https://w3id.org/italia/onto/RO/TimeIndexedRole> a owl:Class .

<https://w3id.org/italia/onto/TI/TimeInterval> a owl:Class .

<https://w3id.org/italia/onto/l0/Characteristic> a owl:Class .

ns1:AlternativeIdentifier a owl:Class ;
    rdfs:label "Alternative Identifier"@en ;
    rdfs:comment "This class represents an identifier of a catalogue record in information systems other than ICCD."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:isAlternativeIdentifierOf ;
            owl:someValuesFrom ns1:CatalogueRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns1:referenceProject ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACC" .

ns1:InformationForm a owl:Class ;
    rdfs:label "Information form"@en ;
    rdfs:comment "This class represents an information form, an ICCD standard for cultural heritage census and reporting activities, used to acquire information for any type of entity, with a minimum set of mandatory standardized data."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns1:informationFormIdentifier ],
        [ a owl:Restriction ;
            owl:onProperty ns1:describes ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasvesale 4.00: AC/MOD" .

ns1:describes a owl:ObjectProperty ;
    rdfs:label "describes"@en ;
    rdfs:comment "This property was created as a generic property for specific subproperties, and represents the relationship between an entity that describes another entity."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    owl:inverseOf ns1:isDescribedBy ;
    owl:versionInfo "stable"@en .

ns1:CulturalPropertyRecord a owl:Class ;
    rdfs:label "Catalogue property record"@en ;
    rdfs:comment "This class represents a record describing a cultural property for purposes other than cataloguing cultural heritage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:describes ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:culturalPropertyRecordIdentifier ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns1:referenceProject ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACS" .

ns1:AdditionalFormType a owl:Class ;
    rdfs:label "Additional form type"@en ;
    rdfs:comment "This class represents the additional form type (Stratigraphic Unit, Wall Typology, Epigraphy)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:isAdditionalFormTypeOf ;
            owl:someValuesFrom ns1:AdditionalForm ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP/APPT" .

ns1:CataloguingLevel a owl:Class ;
    rdfs:label "Cataloguing level"@en ;
    rdfs:comment "This class represents the cataloguing level, defining the level of detail of the survey carried out on the cultural property (Minimum, Medium, Detailed)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:isCataloguingLevelOf ;
            owl:someValuesFrom ns1:CatalogueRecord ],
        <https://w3id.org/italia/onto/l0/Characteristic> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:C ns1:I ns1:P ) ] ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CD/LIR" .

<https://w3id.org/italia/onto/l0/Object> a owl:Class .

ns1:AdditionalForm a owl:Class ;
    rdfs:label "Additional form"@en ;
    rdfs:comment "This class represents an additional form, that describes specific information about a cultural property (epigraphic documents, stratigraphy, unit, wall typology)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasAdditionalFormType ;
            owl:someValuesFrom ns1:AdditionalFormType ],
        [ a owl:Restriction ;
            owl:onProperty ns1:describes ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:additionalFormIdentifier ;
            owl:someValuesFrom rdfs:Literal ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:disjointWith ns1:InformationForm ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP" .

ns1:PrivacyLevel a owl:Class ;
    rdfs:label "Privacy level"@en ;
    rdfs:comment "This class represents the privacy level of the data recorded in a catalogue record (Minimum, Medium, Maximum)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:isPrivacyLevelOf ;
            owl:someValuesFrom ns1:AccessProfile ],
        <https://w3id.org/italia/onto/l0/Characteristic> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS/ADSP" .

<https://w3id.org/italia/onto/l0/identifier> a owl:DatatypeProperty .

<http://dati.beniculturali.it/cis/CulturalEntity> a owl:Class .

ns1:AccessProfile a owl:Class ;
    rdfs:label "Access profile"@en ;
    rdfs:comment "This class represents the access profile to the data recorded in a catalogue record, giving instructions for public dissemination of data on the web."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/expiryDate> ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasPrivacyReason ;
            owl:someValuesFrom ns1:PrivacyReason ],
        [ a owl:Restriction ;
            owl:onProperty ns1:isAccessProfileOf ;
            owl:someValuesFrom ns1:CatalogueRecord ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasPrivacyLevel ;
            owl:someValuesFrom ns1:PrivacyLevel ],
        <https://w3id.org/italia/onto/l0/Characteristic> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS" .

ns1:hasCataloguingAgent a owl:ObjectProperty ;
    rdfs:label "has cataloguing agent"@en ;
    rdfs:comment "This property is used to associate a catalogue record to an agent playing a role in cataloguing activities."@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf ns1:isCataloguingAgentOf ;
    owl:propertyChainAxiom ( <https://w3id.org/italia/onto/RO/hasRiT> <https://w3id.org/italia/onto/RO/isRoleInTimeOf> ) ;
    owl:versionInfo "stable"@en .

ns1:isCataloguingAgentOf a owl:ObjectProperty ;
    rdfs:label "is cataloguing agent of"@en ;
    rdfs:comment "This property, inverse of \"has cataloguin agent\", is used to associate an agent playing a role in cataloguing activities to the catalogue record."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CatalogueRecordVersion ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/isAgentRelatedTo> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/l0/Agent> a owl:Class .

ns1:CatalogueRecordVersion a owl:Class ;
    rdfs:label "Catalogue record version"@en ;
    rdfs:comment "This class represents a version (after creation, editing, updating) of a catalogue record on a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/TI/TimeInterval> ;
            owl:onProperty ns1:editedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CatalogueRecordVersion ;
            owl:onProperty ns1:isImmediatePreviousVersionOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CatalogueRecordVersion ;
            owl:onProperty ns1:isPreviousVersionOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CatalogueRecord ;
            owl:onProperty ns1:isCatalogueRecordVersionOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty ns1:hasCataloguingAgent ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CatalogueRecordVersion ;
            owl:onProperty ns1:hasPreviousVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CatalogueRecordVersion ;
            owl:onProperty ns1:hasImmediatePreviousVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/RO/TimeIndexedRole> ;
            owl:onProperty ns1:hasCatalogueRecordVersionRiT ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/CMP; CM/RVM; CM/AGG" .

ns1:CatalogueRecord a owl:Class ;
    rdfs:label "Catalogue record"@en ;
    dc:description "An example of usage of the class 'Catalogue Record' is the following:\\nresource:CatalogueRecordS/0500212038\\n        a           cat:CatalogueRecordS ;\\n        rdfs:label  \"Catalogue record n: 0500212038\"@en ;\\n        cat:catalogueRecordIdentifier \"0500212038\" ;\\n        cat:describesCulturalProperty resource:HistoricOrArtisticProperty/0500212038 ;\\n        cat:hasAccessProfile resource:AccessProfile/0500212038-1 ;\\n        cat:hasCatalogueRecordVersion resource:CatalogueRecordVersion/0500212038-rvm , resource:CatalogueRecordVersion/0500212038-agg-1 , resource:CatalogueRecordVersion/0500212038-compilation ;\\n        cat:hasCataloguingLevel\\n                cat:C ;\\n        cat:systemRecordCode \"ICCD8403091\" ;\\n        core:note>  \"Number of negative by \"Museco Civico\": MCBas G/ DLXXXIX/ 3775\" ."@en ;
    rdfs:comment "This class represents a catalogue record, that is a descriptive model collecting and organising information on a cultural property, and which can have more than one version (after editing and updating)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns1:catalogueRecordIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CatalogueRecordVersion ;
            owl:onProperty ns1:hasCatalogueRecordVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ;
            owl:onProperty ns1:describesCulturalProperty ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns1:systemRecordCode ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasAccessProfile ;
            owl:someValuesFrom ns1:AccessProfile ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

onto: a owl:Ontology ;
    rdfs:label "Catalogue Ontology (ArCo network)"@en ;
    ns2:reusesPatternAsTemplate <http://ontologydesignpatterns.org/cp/owl/classification.owl>,
        <http://ontologydesignpatterns.org/cp/owl/sequence.owl> ;
    dc:creator "Aldo Gangemi (ISTC-CNR, STLab)",
        "Andrea Nuzzolese (ISTC-CNR, STLab)",
        "Chiara Veninata (MiBACT, ICCD)",
        "Ludovica Marinucci (ISTC-CNR, STLab)",
        "Maria Letizia Mancinelli (MiBACT, ICCD)",
        "Valentina Carriero (ISTC-CNR, STLab)",
        "Valentina Presutti (ISTC-CNR, STLab)" ;
    dc:description "The Catalogue module allows the description of concepts related to the Italian General Catalogue of Cultural Heritage (ICCD-MiBAC), and in particular catalogue records, that is XML files recording all data gathered by a cataloguer on a particular cultural property."@en ;
    dc:language <http://publications.europa.eu/resource/authority/language/ENG>,
        <http://publications.europa.eu/resource/authority/language/ITA> ;
    dc:title "Catalogue Ontology (ArCo network)"@en ;
    dcterms:issued "2018-03-07" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/>,
        <https://w3id.org/italia/controlled-vocabulary/licences/A31_CCBYSA40> ;
    dcterms:modified "2019-06-01" ;
    rdfs:comment "The Catalogue module allows the description of concepts related to the Italian General Catalogue of Cultural Heritage (ICCD-MiBAC), and in particular catalogue records, that is XML files recording all data gathered by a cataloguer on a particular cultural property.\\nIn this module are used as template the following Ontology Design Patterns:\\n- http://www.ontologydesignpatterns.org/cp/owl/classification.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/sequence.owl"@en ;
    owl:imports <https://w3id.org/arco/ontology/core> ;
    owl:versionInfo "Version 1.0"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( <http://dati.beniculturali.it/cis/CulturalEntity> ns1:AlternativeIdentifier ns1:CatalogueRecord ns1:CatalogueRecordVersion ns1:CulturalPropertyRecord ns1:InformationForm ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:CatalogueRecordA ns1:CatalogueRecordAT ns1:CatalogueRecordBDI ns1:CatalogueRecordBDM ns1:CatalogueRecordBNB ns1:CatalogueRecordBNM ns1:CatalogueRecordBNP ns1:CatalogueRecordBNPE ns1:CatalogueRecordBNPL ns1:CatalogueRecordBNZ ns1:CatalogueRecordCA ns1:CatalogueRecordCNS ns1:CatalogueRecordD ns1:CatalogueRecordF ns1:CatalogueRecordFF ns1:CatalogueRecordMA ns1:CatalogueRecordMI ns1:CatalogueRecordNU ns1:CatalogueRecordOA ns1:CatalogueRecordOAC ns1:CatalogueRecordPG ns1:CatalogueRecordPST ns1:CatalogueRecordRA ns1:CatalogueRecordS ns1:CatalogueRecordSAS ns1:CatalogueRecordSI ns1:CatalogueRecordSM ns1:CatalogueRecordSMO ns1:CatalogueRecordTMA ns1:CatalogueRecordVeAC ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:AccessProfile ns1:CataloguingLevel ns1:PrivacyLevel ) .

