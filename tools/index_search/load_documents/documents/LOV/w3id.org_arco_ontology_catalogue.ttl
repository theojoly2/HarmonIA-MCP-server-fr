@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/arco/ontology/catalogue/> .
@prefix ns2: <http://ontologydesignpatterns.org/opla/> .
@prefix onto: <https://w3id.org/arco/ontology/catalogue> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ns2:isNativeTo a owl:AnnotationProperty .

ns2:reusesPatternAsTemplate a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

ns1:CatalogueRecordE a owl:Class ;
    rdfs:label "Ethnology catalogue record"@en ;
    rdfs:comment "This class represents the catalogue record describing Ethnology."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:CatalogueRecord ;
    owl:versionInfo "stable"@en .

ns1:ComplexCPCatalogueRecord a owl:Class ;
    rdfs:label "Complex cultural property catalogue record"@en ;
    rdfs:comment "This class represents a catalogue record describing a complex cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:CatalogueRecord ;
    owl:versionInfo "stable"@en .

ns1:EpigraphyForm a owl:NamedIndividual,
        ns1:AdditionalFormType ;
    rdfs:label "Epigraphy form"@en .

ns1:ICCDIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ICCD identifier"@en ;
    rdfs:comment "This property represents the identifier assigned to a cultural property by ICCD."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en .

ns1:MaximumPrivacy a owl:NamedIndividual,
        ns1:PrivacyLevel ;
    rdfs:label "Maximum privacy"@en .

ns1:MediumPrivacy a owl:NamedIndividual,
        ns1:PrivacyLevel ;
    rdfs:label "Medium privacy"@en .

ns1:MinimumPrivacy a owl:NamedIndividual,
        ns1:PrivacyLevel ;
    rdfs:label "Minimum privacy"@en .

ns1:StratigraphicUnitForm a owl:NamedIndividual,
        ns1:AdditionalFormType ;
    rdfs:label "Stratigraphic Unit form"@en .

ns1:WallTypologyForm a owl:NamedIndividual,
        ns1:AdditionalFormType ;
    rdfs:label "Wall Typology form"@en .

ns1:deletedICCDIdentifier a owl:DatatypeProperty ;
    rdfs:label "deleted ICCD identifier"@en ;
    rdfs:comment "This property represents the ICCD's identifier deleted for many reasons, used to search for obsolete catalogue records."@en ;
    rdfs:domain ns1:CatalogueRecord ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en .

ns1:hasAdditionalFormResponsibleAgent a owl:ObjectProperty ;
    rdfs:label "has additional form responsible agent"@en ;
    rdfs:comment "This property relates an additional form to the responsible agent of that form in the SIGECweb."@en ;
    rdfs:domain ns1:AdditionalForm ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf ns1:isAdditionalFormResponsibleAgentOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP/APPE" .

ns1:hasAlternativeIdentifier a owl:ObjectProperty ;
    rdfs:label "has alternative identifier"@en ;
    rdfs:comment "Property used to associate a catalogue record with an identifier created in the context of information systems other than ICCD's SIGECweb."@en ;
    rdfs:domain ns1:CatalogueRecord ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AlternativeIdentifier ;
    owl:inverseOf ns1:isAlternativeIdentifierOf ;
    owl:versionInfo "stable"@en .

ns1:hasCataloguingLevel a owl:ObjectProperty ;
    rdfs:label "has cataloguing level"@en ;
    rdfs:domain ns1:CatalogueRecord ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CataloguingLevel ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCharacteristic> ;
    owl:inverseOf ns1:isCataloguingLevelOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CD/LIR" .

ns1:hasCulturalPropertyRecordResponsibleAgent a owl:ObjectProperty ;
    rdfs:label "has cultural property record responsible agent"@en ;
    rdfs:comment "This property relates a cultural property record to the agency or the person that created that record or manages the database where the record is."@en ;
    rdfs:domain ns1:CulturalPropertyRecord ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf ns1:isResponsibleAgentOfCulturalPropertyRecord ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACS/ACSE" .

ns1:hasDigitalTranscriptionOperator a owl:ObjectProperty ;
    rdfs:label "has digital transcription operator"@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf ns1:hasCataloguingAgent ;
    owl:inverseOf ns1:isDigitalTranscriptionOperatorOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/RVM/RVMN" .

ns1:hasDigitalTranscriptionResponsibleAgent a owl:ObjectProperty ;
    rdfs:label "has digital transcription responsible agent"@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf ns1:hasCataloguingAgent ;
    owl:inverseOf ns1:isDigitalTranscriptionResponsibleAgentOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/RVM/RVME" .

ns1:hasOfficialInCharge a owl:ObjectProperty ;
    rdfs:label "has official in charge"@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf ns1:hasCataloguingAgent ;
    owl:inverseOf ns1:isOfficialInChargeOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/FUR" .

ns1:hasResponsibleResearchAndCompilation a owl:ObjectProperty ;
    rdfs:label "has responsible research and compilation"@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf ns1:hasCataloguingAgent ;
    owl:inverseOf ns1:isResponsibleResearchAndCompilationOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/CMP/CMPN" .

ns1:hasScientificDirector a owl:ObjectProperty ;
    rdfs:label "has scientific director"@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf ns1:hasCataloguingAgent ;
    owl:inverseOf ns1:isScientificDirectorOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/RSR" .

ns1:hasUpdateOfficialInCharge a owl:ObjectProperty ;
    rdfs:label "has update official in charge"@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf ns1:hasCataloguingAgent ;
    owl:inverseOf ns1:isUpdateOfficialInChargeOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/AGG/AGGF" .

ns1:hasUpdateResponsibleAgent a owl:ObjectProperty ;
    rdfs:label "has update responsible agency or person"@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf ns1:hasCataloguingAgent ;
    owl:inverseOf ns1:isUpdateResponsibleAgentOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/AGG/AGGE" .

ns1:hasUpdateResponsibleResearchAndCompilation a owl:ObjectProperty ;
    rdfs:label "has update responsible research and compilation"@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf ns1:hasCataloguingAgent ;
    owl:inverseOf ns1:isUpdateResponsibleResearchAndCompilationOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/AGG/AGGN" .

ns1:hasUpdateScientificRevisor a owl:ObjectProperty ;
    rdfs:label "has update scientific revisor"@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf ns1:hasCataloguingAgent ;
    owl:inverseOf ns1:isUpdateScientificRevisorOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/AGG/AGGR" .

ns1:iccdNormTag a owl:AnnotationProperty ;
    rdfs:label "ICCD norm tag"@en ;
    rdfs:comment "This property annotates the field or the fields of the ICCD regulation to which a specific class or property refers."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

ns1:isRelatedToAdditionalForm a owl:ObjectProperty ;
    rdfs:label "is related to additional form"@en ;
    rdfs:comment "This property relates a cultural property to an additional form."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AdditionalForm ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP" .

ns1:isRelatedToInformationForm a owl:ObjectProperty ;
    rdfs:label "is related to information form"@en ;
    rdfs:comment "This property relates a cultural property to an information form."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:InformationForm ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasvesale 4.00: AC/MOD" .

ns1:localIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "This property represents a unique identifier of an entity, within a local inventory."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en .

ns1:recoveredData a owl:DatatypeProperty ;
    rdfs:label "recovered data"@en ;
    rdfs:comment "This property represents information extracted from versions of a catalogue record using obsolete standards."@en ;
    rdfs:domain ns1:CatalogueRecord ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AN/RDP" .

ns1:C a owl:NamedIndividual,
        ns1:CataloguingLevel ;
    rdfs:label "Detailed Level"@en ;
    owl:versionInfo "stable"@en .

