ns1:additionalFormIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "additional form identifier"@en ;
    rdfs:comment "This property represents the additional form identifier."@en ;
    rdfs:domain ns1:AdditionalForm ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP/APPC" .

ns1:catalogueRecordIdentifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "catalogue record identifier"@en ;
    rdfs:comment "This property represents the identifier of a catalogue record describing a cultural property."@en ;
    rdfs:domain ns1:CatalogueRecord ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en .

ns1:culturalPropertyRecordIdentifier a owl:DatatypeProperty ;
    rdfs:label "cultural property record identifier"@en ;
    rdfs:comment "This property is used to associate the identifier to a catalogue record that analyze the cultural property for reasons other than cataloguing the cultural heritage."@en ;
    rdfs:domain ns1:CulturalPropertyRecord ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACS/ACSC" .

ns1:describesCulturalProperty a owl:ObjectProperty ;
    rdfs:label "describes"@en ;
    rdfs:comment "Property used to associate the catalogue record with the cultural property that the catalogue record describes."@en ;
    rdfs:domain ns1:CatalogueRecord ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf ns1:describes ;
    owl:inverseOf ns1:isDescribedByCatalogueRecord ;
    owl:versionInfo "stable"@en .

ns1:editedAtTime a owl:ObjectProperty ;
    rdfs:label "edited at time"@en ;
    rdfs:comment "Property used to associate a catalogue record version with the time interval in which it was edited."@en ;
    rdfs:domain ns1:CatalogueRecordVersion ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/TI/TimeInterval> ;
    owl:inverseOf ns1:editingTimeOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "CM/CMP/CMPD; CM/RVM/RVMD; CM/AGG/AGGD" .

ns1:editingTimeOf a owl:ObjectProperty ;
    rdfs:label "editing time of"@en ;
    rdfs:comment "This is the inverse property of \"edited at time\"."@en ;
    rdfs:domain <https://w3id.org/italia/onto/TI/TimeInterval> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CatalogueRecordVersion ;
    owl:versionInfo "stable"@en .

ns1:hasAccessProfile a owl:ObjectProperty ;
    rdfs:label "has access profile"@en ;
    rdfs:domain ns1:CatalogueRecord ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AccessProfile ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCharacteristic> ;
    owl:inverseOf ns1:isAccessProfileOf ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS" .

ns1:hasAdditionalFormType a owl:ObjectProperty ;
    rdfs:label "has additional form type"@en ;
    rdfs:comment "This property relates an additional form to its type (Stratigraphic Unit, Epigraphy, Wall Typology)."@en ;
