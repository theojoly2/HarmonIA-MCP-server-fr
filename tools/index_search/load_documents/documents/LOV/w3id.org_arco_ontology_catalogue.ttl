    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AccessProfile ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isCharacteristicOf> ;
    owl:versionInfo "stable"@en .

ns1:isPrivacyReasonOf a owl:ObjectProperty ;
