@prefix ns1: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix onto: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:coversRequirements a owl:AnnotationProperty .

ns1:extractedFrom a owl:AnnotationProperty .

ns1:hasConsequences a owl:AnnotationProperty .

ns1:hasIntent a owl:AnnotationProperty .

ns1:relatedCPs a owl:AnnotationProperty .

ns1:scenarios a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

<http://www.ontologydesignpatterns.org/cp/owl/participation.owl#hasParticipant> a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object> ;
    owl:inverseOf <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#isParticipantIn> .

<http://www.ontologydesignpatterns.org/cp/owl/participation.owl#isParticipantIn> a owl:ObjectProperty ;
    rdfs:label "is participant in"@en ;
    rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event> .

<http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event> a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "Any physical, social, or mental process, event, or state." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#hasParticipant> ;
            owl:someValuesFrom <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object> ] ;
    owl:disjointWith <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object> .

onto: a owl:Ontology ;
    rdfs:label "participation"^^rdf:PlainLiteral ;
    ns1:coversRequirements "Which objects do participate in this event? Which events do this object participate in?"^^xsd:string ;
    ns1:extractedFrom "http://ontologydesignpatterns.org/ont/dul/DUL.owl"^^rdf:PlainLiteral ;
    ns1:hasConsequences "It is possible to model whatever relation between objects and events. Using cardinality restrictions appropriately allows to limit the number of participants, e.g. 'life of' is a specialization of this pattern that requires a functional object property (cardinality 1. . .1).\\nThis is a non-temporal version of the particpation relation. If we need a time-indexed relation, use http://ontologydesignpatterns.owl/cp/owl/timeindexedparticipation.owl"^^xsd:string ;
    ns1:hasIntent "To represent participation of an object in an event."^^xsd:string ;
    ns1:relatedCPs "Time indexed participation"^^rdf:PlainLiteral,
        "Co-participation allows to model the relation between two objects that \\npar ticipate in a same event (implicitly); n-ary participation allows to model par ticipation over different dimensions e.g., temporal, spatial, etc., as well as explicitly relate more than one object to the same event; object role, n-ary classiﬁcation are examples of CPs that can be composed with this CP."^^xsd:string ;
    ns1:scenarios "Aldo Gangemi participated in the premiere of La Dolce Vita."^^xsd:string ;
    rdfs:comment "The basic participation pattern, without temporal indexing. \\nIt clones equivalent elements from DOLCE-UltraLite."^^rdf:PlainLiteral ;
    owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
    owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string,
        "1.1\\n- Improved annotation\\n1.0 \\n- Created by Aldo Gangemi and Valentina Presutti"^^xsd:string .

<http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object> a owl:Class ;
    rdfs:label "Object"@en ;
    rdfs:comment "Any physical, social, or mental object, or substance" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#isParticipantIn> ;
            owl:someValuesFrom <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event> ] .

