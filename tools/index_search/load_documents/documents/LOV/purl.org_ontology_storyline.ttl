@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://www.bbc.co.uk/ontologies/provenance/> .
@prefix onto: <http://purl.org/ontology/storyline> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.org/ontology/storyline/Event> a owl:Class ;
    rdfs:label "Event"@en-gb ;
    rdfs:comment "A newsworthy event. An un-disputable real world event."@en-gb ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/storyline/StorylineComponent> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/attributedTo> a owl:ObjectProperty ;
    rdfs:label "attributedTo"@en-gb ;
    rdfs:comment "Associates a storyline to its attribution. Provides for interpretation provenance through attribution"@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/Storyline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/ontology/storyline/Attribution> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/comment> a owl:AnnotationProperty ;
    rdfs:label "comment"@en-gb ;
    rdfs:comment "An editorial comment on a storyline"@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/Storyline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf rdfs:comment ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/contains> a owl:ObjectProperty ;
    rdfs:label "contains"@en-gb ;
    rdfs:comment "Associates a Slot to a StorylineComponent contained therein. Can be a news event or another storyline"@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/StorylineSlot> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/ontology/storyline/StorylineComponent> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/dateCreated> a owl:DatatypeProperty ;
    rdfs:label "dateCreated"@en-gb ;
    rdfs:comment "The date a storyline was created"@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/StorylineComponent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:dateTime ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/follows> a owl:ObjectProperty ;
    rdfs:label "follows"@en-gb ;
    rdfs:comment "Allows one or more slots to be sequenced. Slot A follows Slot B."@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/StorylineSlot> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/ontology/storyline/StorylineSlot> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/hasChapter> a owl:ObjectProperty ;
    rdfs:label "hasChapter"@en-gb ;
    rdfs:comment "Associates a slot to a storyline as a chapter of an existing storyline."@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/Storyline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/ontology/storyline/StorylineSlot> ;
    rdfs:subPropertyOf <http://purl.org/ontology/storyline/hasSlot> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/hasDevelopment> a owl:ObjectProperty ;
    rdfs:label "hasDevelopment"@en-gb ;
    rdfs:comment "Associates a slot to a storyline as a development of an existing storyline."@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/Storyline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/ontology/storyline/StorylineSlot> ;
    rdfs:subPropertyOf <http://purl.org/ontology/storyline/hasSlot> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/hasUpdate> a owl:ObjectProperty ;
    rdfs:label "hasUpdate"@en-gb ;
    rdfs:comment "Associates a slot to a storyline as an update to an existing storyline."@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/Storyline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/ontology/storyline/StorylineSlot> ;
    rdfs:subPropertyOf <http://purl.org/ontology/storyline/hasSlot> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/index> a owl:DatatypeProperty ;
    rdfs:label "index"@en-gb ;
    rdfs:comment "A slot index. Allows slots to be ordered numerically"@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/StorylineSlot> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/synopsis> a owl:DatatypeProperty ;
    rdfs:label "synopsis"@en-gb ;
    rdfs:comment "The synopsis of a storyline"@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/Storyline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/time> a owl:ObjectProperty ;
    rdfs:label "time"@en-gb ;
    rdfs:comment "The time of a slot. A Temporal entity, an interval. Allows slots to be ordered temporally."@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/StorylineSlot> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range time:TemporalEntity ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/title> a owl:AnnotationProperty ;
    rdfs:label "title"@en-gb ;
    rdfs:comment "A title of a storyline"@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/Storyline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf rdfs:label ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/topic> a owl:ObjectProperty ;
    rdfs:label "topic"@en-gb ;
    rdfs:comment "Associates a slot to a topic"@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/Storyline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/ontology/storyline/Topic> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/Attribution> a owl:Class ;
    rdfs:label "Attribution"@en-gb ;
    rdfs:comment "Attribution of a storyline used for attributing the interpretation of the storyline to some agent. An interface class, that doesn't restrict the implementation of an attribution."@en-gb ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/Topic> a owl:Class ;
    rdfs:label "Topic"@en-gb ;
    rdfs:comment "The topic of a storyline. An interface to some concept in a knowledge domain."@en-gb ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/hasSlot> a owl:ObjectProperty ;
    rdfs:label "hasSlot"@en-gb ;
    rdfs:comment "Associates a slot to a storyline. A storyline can have many slots"@en-gb ;
    rdfs:domain <http://purl.org/ontology/storyline/Storyline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://purl.org/ontology/storyline/StorylineSlot> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/StorylineComponent> a owl:Class ;
    rdfs:label "StorylineComponent"@en-gb ;
    rdfs:comment "An abstract parent class of storyline components."@en-gb ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/Storyline> a owl:Class ;
    rdfs:label "Storyline"@en-gb ;
    rdfs:comment "A news storyline."@en-gb ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://purl.org/ontology/storyline/StorylineComponent> ;
    ns1:term_status "testing" .

<http://purl.org/ontology/storyline/StorylineSlot> a owl:Class ;
    rdfs:label "StorylineSlot"@en-gb ;
    rdfs:comment "A storyline slot, used as a container for storyline components."@en-gb ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "testing" .

onto: a ns2:Ontology,
        owl:Ontology ;
    rdfs:label "Storyline Ontology"@en-gb ;
    dc:contributor "Dan Brickley"@en-gb,
        "Helen Lippell"@en-gb,
        "Matt Chadburn"@en-gb,
        "Michael Smethurst"@en-gb,
        "Paul Rissen"@en-gb,
        "Sebastien Cevey"@en-gb,
        "Tom Leitch"@en-gb ;
    dc:creator <http://uk.linkedin.com/in/jarredmcginnis>,
        <http://uk.linkedin.com/in/paulwilton>,
        <http://www.bbc.co.uk/blogs/internet/authors/Jeremy_Tarling> ;
    dc:date "2013-05-01"^^xsd:date ;
    dc:description "An ontology to represent News Storylines."@en-gb ;
    dc:rights "This ontology is distributed under the Creative Commons SA-3.0 license"@en-gb ;
    dc:title "A News Storyline Ontology"@en-gb ;
    dcterms:license <http://creativecommons.org/licenses/by-sa/3.0/> ;
    ns2:canonicalLocation "https://repo.dev.bbc.co.uk/services/linked-data/ontologies/domain/news/storyline-0.3.ttl"^^xsd:string ;
    ns2:changeReason "added nsl:createdDate, moved domain of nsl:time to nsl:StorylineSLot"@en-gb ;
    ns2:provided "2014-04-10T09:56:56+00:00"^^xsd:dateTime ;
    ns2:provider <mailto:sam.starling@bbc.co.uk> ;
    ns2:public true ;
    ns2:slug "storyline"^^xsd:string ;
    ns2:version 3e-01 ;
    rdfs:comment "An ontology to represent News Storylines."@en-gb ;
    owl:priorVersion <http://purl.org/ontology/storyline/0.2> ;
    owl:versionIRI <http://purl.org/ontology/storyline/0.3> ;
    owl:versionInfo "0.3"^^xsd:string .

