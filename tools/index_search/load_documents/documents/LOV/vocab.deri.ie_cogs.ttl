    foaf:name "DERI, NUI Galway" .

<http://vocab.deri.ie/cogs#associatedEndpoint> a rdf:Property ;
    rdfs:label "associatedEndpoint" ;
    rdfs:range <http://vocab.deri.ie/cogs#Endpoint> .

<http://vocab.deri.ie/cogs#associatedGraph> a rdf:Property ;
    rdfs:label "associatedGraph" ;
    rdfs:range <http://vocab.deri.ie/cogs#RDFNamedGraph> .

<http://vocab.deri.ie/cogs#dependsOn> a rdf:Property ;
    rdfs:label "dependsOn" ;
    rdfs:domain <http://vocab.deri.ie/cogs#Job> ;
    rdfs:range <http://vocab.deri.ie/cogs#Job> .

<http://vocab.deri.ie/cogs#hasEndPoint> a rdf:Property ;
    rdfs:label "hasEndPoint" ;
    rdfs:comment "Last process in a transformation workflow." ;
    rdfs:domain <http://vocab.deri.ie/cogs#Transformation> ;
    rdfs:range <http://vocab.deri.ie/cogs#Transformation> .

<http://vocab.deri.ie/cogs#hasStartPoint> a rdf:Property ;
    rdfs:label "hasStartPoint" ;
    rdfs:comment "First process in a transformation workflow." ;
    rdfs:domain <http://vocab.deri.ie/cogs#Transformation> ;
    rdfs:range <http://vocab.deri.ie/cogs#Transformation> .

<http://vocab.deri.ie/cogs#isExpressedBy> a rdf:Property ;
    rdfs:label "isExpressedBy" ;
    rdfs:comment "This property allows the association between an abstract representation of a Transformation and an encapsulated computational artifact artifact (e.g. code, binary)." ;
    rdfs:domain <http://vocab.deri.ie/cogs#Transformation> .

<http://vocab.deri.ie/cogs#precededBy> a rdf:Property ;
    rdfs:label "precededBy" ;
    rdfs:comment "Defines the ordering among two processes" ;
    rdfs:subPropertyOf owl:topObjectProperty .

