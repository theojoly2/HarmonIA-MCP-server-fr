@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://creativecommons.org/ns#> .
@prefix onto: <http://linkeddata.finki.ukim.mk/lod/ontology/cfrl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

onto: a owl:Ontology ;
    ns1:license <https://creativecommons.org/licenses/by/3.0/> ;
    dcterms:contributor <https://plus.google.com/+MilosJovanovik> ;
    dcterms:creator <https://plus.google.com/+BojanNajdenov> ;
    dcterms:description "An ontology for interlinking Companies with their Financial Reports and Loans and Credits." ;
    dcterms:issued "2014-09-01" ;
    dcterms:modified "2016-08-28" ;
    dcterms:publisher <http://finki.ukim.mk/> ;
    dcterms:rights "Copyright 2014, Bojan Najdenov" ;
    dcterms:title "Corporate Financial Reports and Loans Ontology" ;
    vann:preferredNamespacePrefix "cfrl" ;
    vann:preferredNamespaceUri "http://linkeddata.finki.ukim.mk/lod/ontology/cfrl#" ;
    rdfs:comment "The Corporate Financial Reports and Loans Ontology (CFRL)." ;
    owl:versionInfo "1.1" .

onto:hasLoan a owl:ObjectProperty ;
    rdfs:comment "This property links a Company with a Loan instance." ;
    rdfs:domain <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    rdfs:range qb:Observation .

onto:hasReport a owl:ObjectProperty ;
    rdfs:comment "This property links a Company with a Financial Report instance." ;
    rdfs:domain <http://www.w3.org/ns/regorg#RegisteredOrganization> ;
    rdfs:range <http://www.xbrlsite.com/2013/FinancialReportOntology#FundamentalAccountingConcept> .

qb:Observation a owl:Class .

<http://www.xbrlsite.com/2013/FinancialReportOntology#FundamentalAccountingConcept> a owl:Class .

<http://www.w3.org/ns/regorg#RegisteredOrganization> a owl:Class .

