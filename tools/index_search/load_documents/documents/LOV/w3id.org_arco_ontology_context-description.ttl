<https://w3id.org/arco/ontology/context-description/AgeOfDeathInterpretation> a owl:Class ;
    rdfs:label "Age of death interpretation"@en ;
    rdfs:comment "This class represents the interpretation of the age of death of an anthropological material."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/ageOfDeath> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isAgeOfDeathInterpretationOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/context-description/Interpretation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT: DA/SEM" .

<https://w3id.org/arco/ontology/context-description/AlternativeAuthorshipAttribution> a owl:Class ;
    rdfs:label "Alternative Authorship Attribution"@en ;
    rdfs:comment "This class represents an authorship attribution alternative to the preferred one."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAttributedAuthor> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/l0/Agent> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/authorIntervention> ],
        <https://w3id.org/arco/ontology/context-description/AuthorshipAttribution> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "AU/AAT" .

<https://w3id.org/arco/ontology/context-description/ArchivalRecord> a owl:Class ;
    rdfs:label "Archival record"@en ;
    ns3:isNativeTo <http://mklab.iti.gr/pericles/BornDigitalArchives_ODP.owl> ;
    rdfs:comment "This class represents the archival record that is part of an archival record set."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/archivalRecordIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> ;
            owl:onProperty <https://w3id.org/arco/ontology/core/isPartOf> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: UB/UBF" .

<https://w3id.org/arco/ontology/context-description/ArchivalSeries> a owl:Class ;
    rdfs:label "Archival series"@en ;
    ns3:isNativeTo <http://mklab.iti.gr/pericles/BornDigitalArchives_ODP.owl> ;
    rdfs:comment "This class represents an archival series."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ArchivalSubseries> ;
            owl:onProperty <https://w3id.org/arco/ontology/core/hasComponent> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ArchivalFonds> ;
            owl:onProperty <https://w3id.org/arco/ontology/core/isComponentOf> ],
        <https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: UB/UBF/UBFS" .

<https://w3id.org/arco/ontology/context-description/CulturalPropertyEstimate> a owl:Class ;
    rdfs:label "Cultural property estimate"@en ;
    rdfs:comment "This class represents the estimate of a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/estimatedCulturalPropertyValue> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isCulturalPropertyEstimateOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/context-description/Estimate> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: UB/STI" .

<https://w3id.org/arco/ontology/context-description/CulturalScopeAttribution> a owl:Class ;
    rdfs:label "Cultural Scope Attribution"@en ;
    rdfs:comment "This class represents the attribution of a cultural scope, to which the cultural property is related (e.g.: neoclassical, Milanese manifacturing, etc.)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCulturalScope> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/CulturalScope> ],
        <https://w3id.org/arco/ontology/context-description/AuthorshipAttribution> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "AU/ATB" .

<https://w3id.org/arco/ontology/context-description/EligibleIntervention> a owl:Class ;
    rdfs:label "Eligible intervention"@en ;
    rdfs:comment "This class represents the intervention considered eligible by a specific urban planning instrument related to a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/UrbanPlanningInstrument> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isInterventionEligibleBy> ],
        <https://w3id.org/arco/ontology/context-description/Intervention> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/STU/STUN" .

<https://w3id.org/arco/ontology/context-description/FindingContextType> a owl:Class ;
    rdfs:label "Finding context type"@en ;
    rdfs:comment "This class represents the type of finding context of a cultural property, and in particular of an anthropological material (e.g.: individual burial, common burial, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT 3.01: OG/OGC/OGCT" .

<https://w3id.org/arco/ontology/context-description/Fruition> a owl:Class ;
    rdfs:label "Fruition"@en ;
    rdfs:comment "This class represents a circumstance in which a garment, catalogued as a cultural property, was worn by one or more people."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isFruitionOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Circumstance> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCircumstance> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasUser> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/l0/Agent> ],
        <https://w3id.org/arco/ontology/context-description/Interpretation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa VeAC: AU/FRU" .

<https://w3id.org/arco/ontology/context-description/GraphicOrCartographicDocumentation> a owl:Class ;
    rdfs:label "Graphic and cartographic documentation"@en ;
    rdfs:comment "This class represents the graphic or cartographic documentation of an object, e.g. a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Scale> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasScale> ],
        <https://w3id.org/arco/ontology/context-description/Documentation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/PaleopathologySurvey> a owl:Class ;
    rdfs:label "Paleopathology survey"@en ;
    rdfs:comment "This class represents a particular type of survey on a cultural property, that is a survey in which is possible to make a diagnosis of a paleopathology of an anthropological material."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/diagnosis> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SurveyMethod> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyMethod> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/refersToSurveys> ],
        <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT: PT" .

<https://w3id.org/arco/ontology/context-description/PreferredAuthorshipAttribution> a owl:Class ;
    rdfs:label "Preferred Authorship Attribution"@en ;
    rdfs:comment "This class represents the preferred authorship attribution, most accredited or convincing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/authorIntervention> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAttributedAuthor> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/l0/Agent> ],
        <https://w3id.org/arco/ontology/context-description/AuthorshipAttribution> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "AU/AUT" .

<https://w3id.org/arco/ontology/context-description/PrintInPublication> a owl:Class ;
    rdfs:label "Print in publication"@en ;
    rdfs:comment "This class represents a publication of which a print is, or was, part."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/DerivatedWork> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/SECCategory> a owl:Class ;
    rdfs:label "SEC Category"@en ;
    rdfs:comment "This class represents the patrimonial category of a cultural property, referring to the SEC classification 1995."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/CurrentInventory> ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/arco/ontology/context-description/hasSECCategory> ] ],
        <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: UB/INP/INPZ" .

<https://w3id.org/arco/ontology/context-description/SexInterpretation> a owl:Class ;
    rdfs:label "Sex interpretation"@en ;
    rdfs:comment "This class represents the interpretation of the sex of an anthropological material."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isSexInterpretationOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/sex> ;
            owl:someValuesFrom rdfs:Literal ],
        <https://w3id.org/arco/ontology/context-description/Interpretation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT: DA/STS" .

<https://w3id.org/arco/ontology/context-description/SourceAndDocument> a owl:Class ;
    rdfs:label "Source and document"@en ;
    rdfs:comment "This class represents source and document related to an object, e.g. a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/folio> ],
        <https://w3id.org/arco/ontology/context-description/Documentation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/UserSocialCategory> a owl:Class ;
    rdfs:label "User social category"@en ;
    rdfs:comment "This class represents the social category of a user (e.g. of a cultural property)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/hasActivityOperator> a owl:ObjectProperty ;
    rdfs:label "has activity operator"@en ;
    rdfs:comment "This property relates an activity to the agent who performed the activity. In the ontology this relationship is modelled also by the class AgentRole which allows more expressiveness."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Activity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isActivityOperatorOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/hasAuthor> a owl:ObjectProperty ;
    rdfs:label "has author"@en ;
    rdfs:comment "This property relates a entity (i.e. documentation, cultural entity, etc.) to its author."@en,
        "This property relates an entity to its author."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isAuthorOf> ;
    owl:propertyChainAxiom ( <https://w3id.org/arco/ontology/context-description/hasAuthorshipAttribution> <https://w3id.org/arco/ontology/context-description/hasAttributedAuthor> ) ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/hasCircumstance> a owl:ObjectProperty ;
    rdfs:label "has circumstance"@en ;
    rdfs:comment "This property relates a situation to the circumstance which led to the situation. For example it can connect a situation where is indicated a cultural entity's committment to its circumstance."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasSituation> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isCircumstanceOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: UT/UTU/UTUO; normativa BDM: UT/UTO; AU/CMM/CMMC; normativa VeAC: AU/FRU/FRUC; normativa F: LR/LRO - ICCD Normativa MI: AU/DDC/DDCC" .

<https://w3id.org/arco/ontology/context-description/hasFormat> a owl:ObjectProperty ;
    rdfs:label "has format"@en ;
    rdfs:comment "This property relates the documentation to its format."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Documentation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/Format> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasDescription> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isFormatOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: DO/FTA/FTAF, DO/DRA/DRAF, DO/DNT/FNTR" .

<https://w3id.org/arco/ontology/context-description/hasSurveyMethod> a owl:ObjectProperty ;
    rdfs:label "has survey method"@en ;
    rdfs:comment "This property relates a survey to the method adopted in the survey."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Survey> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/SurveyMethod> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasMethod> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isSurveyMethodOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/RCG/RCGM; RE/DSC/DSCM - ICCD Normativa AT: PT/PTC/PTCM" .

<https://w3id.org/arco/ontology/context-description/hasSurveyScientificDirector> a owl:ObjectProperty ;
    rdfs:label "has survey scientific director"@en ;
    rdfs:comment "This property relates a survey to its scientific director."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Survey> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isSurveyScientificDirectorOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/RCG/RCGA; RE/DSC/DSCA; RE/FOI/FOIS" .

<https://w3id.org/arco/ontology/context-description/hasTitle> a owl:ObjectProperty ;
    rdfs:label "has title"@en ;
    rdfs:comment "This property relates an object to its title."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/Title> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isTitleOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isAuthorshipAttributionOf> a owl:ObjectProperty ;
    rdfs:label "is authorship attribution of"@en ;
    rdfs:comment "Property that links an authorship attribution referred to a cultural entity to that cultural entity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/AuthorshipAttribution> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AU/AUT; AU/ATB; AU/AAT" .

<https://w3id.org/arco/ontology/context-description/isDocumentationOf> a owl:ObjectProperty ;
    rdfs:label "is documentation of"@en ;
    rdfs:comment "This property relates a documentation to an entity. For example, it can relates a documentation concerning a cultural property described in a catalogue record to that cultural property."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Documentation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isEstimateOf> a owl:ObjectProperty ;
    rdfs:label "is estimate of"@en ;
    rdfs:comment "This property relates an estimate of an entity to that entity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Estimate> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/core/Concept> a owl:Class .

<https://w3id.org/arco/ontology/core/isConceptOf> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/note> a owl:DatatypeProperty .

<https://w3id.org/italia/onto/TI/atTime> a owl:ObjectProperty .

<https://w3id.org/italia/onto/TI/date> a owl:DatatypeProperty .

<https://w3id.org/italia/onto/TI/time> a owl:DatatypeProperty .

<https://w3id.org/italia/onto/l0/Collection> a owl:Class .

ns1:ICCDIdentifier a owl:DatatypeProperty .

ns1:localIdentifier a owl:DatatypeProperty .

<https://w3id.org/arco/ontology/context-description/AcquisitionType> a owl:Class ;
    rdfs:label "Acquisition type"@en ;
    rdfs:comment "This class represents the type of acquisition (e.g. purchase, donation, etc.) of a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/ACQ/ACQT" .

<https://w3id.org/arco/ontology/context-description/ArchaeologicalPropertySurveyType> a owl:Class ;
    rdfs:label "Archaeological property survey type"@en ;
    rdfs:comment "This class represents the type of archaeological property survey."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT 3.01: IN/INI/INIT" .

<https://w3id.org/arco/ontology/context-description/ArchaeometricDiagnosticSurveyType> a owl:Class ;
    rdfs:label "Archaeometric diagnostic survey type"@en ;
    rdfs:comment "This class represents the type of archaeometric and diagnostic survey (e.g. coring)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/BibliographyType> a owl:Class ;
    rdfs:label "Bibliography type"@en ;
    rdfs:comment "This class represents the type of bibliography."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:disjointWith <https://w3id.org/arco/ontology/context-description/DocumentationType> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ChangeOfAvailabilityType> a owl:Class ;
    rdfs:label "Change of availability type"@en ;
    rdfs:comment "This class represents the type of change of availability of a cultural property (e.g. theft, distruction)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/ALN/ALNT" .

<https://w3id.org/arco/ontology/context-description/Copy> a owl:Class ;
    rdfs:label "Copy"@en ;
    rdfs:comment "This class represents the copy of a cultural property, e.g. a copy of a photography or a print."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/DerivatedWork> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/CulturalPropertyStage> a owl:Class ;
    rdfs:label "Cultural property stage"@en ;
    rdfs:comment "This class represents the stage of the catalogued cultural property related to the object which constitutes its preparatory or final stage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/RelatedWorkSituation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isCulturalPropertyStageIn> ],
        <https://w3id.org/arco/ontology/core/CulturalEntityCharacteristic> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/CulturalScope> a owl:Class ;
    rdfs:label "Cultural Scope"@en ;
    rdfs:comment "This class represents the cultural scope related to a cultural property (e.g.: neoclassical, Milanese manifacturing, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isCulturalScopeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/CulturalScopeAttribution> ],
        <https://w3id.org/italia/onto/l0/Topic> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AU/ATB" .

<https://w3id.org/arco/ontology/context-description/DerivatedWorkType> a owl:Class ;
    rdfs:label "Derivated work type"@en ;
    rdfs:comment "This class represents the type of derivated work of a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/DocumentationCategory> a owl:Class ;
    rdfs:label "Documentation category"@en ;
    rdfs:comment "This class represents the category associated to a documentation (e.g. attached documentation, existing documentation)."@en ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Genus> a owl:Class ;
    rdfs:label "Genus"@en ;
    rdfs:comment "This class represents one level of a biological taxon, the genus."@en ;
    rdfs:isDefinedBy <https://w3di.org/arco/ontology/context-description/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isGenusIn> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/BiologicalTaxon> ],
        <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT: OG/OGS/OGSG" .

<https://w3id.org/arco/ontology/context-description/InterventionType> a owl:Class ;
    rdfs:label "Intervention type"@en ;
    rdfs:comment "This class represents the type of intervention on a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/LaboratoryTest> a owl:Class ;
    rdfs:label "Laboratory test"@en ;
    rdfs:comment "This class represents a particular type of survey on a cultural property, that is a laboratory test."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/claySpecifications> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/LaboratoryTestType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasLaboratoryTestType> ],
        <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normative NU, RA, BNB, MA, CA: RS/ALB" .

<https://w3id.org/arco/ontology/context-description/LaboratoryTestType> a owl:Class ;
    rdfs:label "Laboratory test type"@en ;
    rdfs:comment "This class represents the type of laboratory test (es.: chemical analysis)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normative NU, RA, BNB, MA, CA: RS/ALB/ALBT" .

<https://w3id.org/arco/ontology/context-description/Membership> a owl:Class ;
    rdfs:label "Membership"@en ;
    dc:description "An example of usage of one of the subclasses of the class 'Membership' is the following: resource:CollectionMembership/0300633618-collection-membership-1\\n        a    cd:CollectionMembership ;\\n        rdfs:label  \"Collection membership 1 of cultural property: 0300633618\"@en ;\\n        cd:hasCollection resource:CollectionOfCulturalEntities/collezione-mingozzi ;\\n        cd:hasMemberOfCollection resource:ScientificOrTechnologicalHeritage/0300633618 ;\\n        tiapit:atTime resource:TimeInterval/1967 ."@en ;
    rdfs:comment "This class represents the concept of membership."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ObservationSurveyType> a owl:Class ;
    rdfs:label "Observation survey type"@en ;
    rdfs:comment "This class represents the type of observation survey (in the context / out of the context)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa BDI 4.00: LA/PRM" .

<https://w3id.org/arco/ontology/context-description/ReproductionPosition> a owl:Class ;
    rdfs:label "Reproduction position"@en ;
    rdfs:comment "This class represents the phisical position of a printed reproduction in a publication."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isReproductionPositionOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/Reproduction> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/pageOrTableNumber> ],
        <https://w3id.org/italia/onto/l0/Location> ;
    owl:disjointWith <https://w3id.org/arco/ontology/context-description/StratigraphicUnit> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ResponsibilityType> a owl:Class ;
    rdfs:label "Responsibility type"@en ;
    rdfs:comment "This class represents the type of responsibility related to the production and dissemination of photographic heritage (e.g.: printer, editor)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normative F e FF: PD/PDF/PDFR" .

<https://w3id.org/arco/ontology/context-description/SECIdentifier> a owl:Class ;
    rdfs:label "SEC Identifier"@en ;
    rdfs:comment "This class represents the patrimonial code of a cultural property, referring to the SEC classification 1995."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: UB/INP/INPS" .

<https://w3id.org/arco/ontology/context-description/Scale> a owl:Class ;
    rdfs:label "Scale"@en ;
    rdfs:comment "This class represents the representative scale of a graphic or cartographic documentation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isScaleOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/GraphicOrCartographicDocumentation> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DO/DRA/DRAS" .

<https://w3id.org/arco/ontology/context-description/Species> a owl:Class ;
    rdfs:label "Species"@en ;
    rdfs:comment "This class represents one level of a biological taxon, the species."@en ;
    rdfs:isDefinedBy <https://w3di.org/arco/ontology/context-description/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isSpeciesIn> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/BiologicalTaxon> ],
        <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT: OG/OGS/OGSN" .

<https://w3id.org/arco/ontology/context-description/StratigraphicUnit> a owl:Class ;
    rdfs:label "Stratigraphic unit"@en ;
    rdfs:comment "This class represents a stratigraphic unit from which a cultural property may come from."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ArchaeologicalExcavation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isStratigraphicUnitOf> ],
        <https://w3id.org/italia/onto/l0/Location> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/DSC/DSCU" .

<https://w3id.org/arco/ontology/context-description/Subspecies> a owl:Class ;
    rdfs:label "Subspecies"@en ;
    rdfs:comment "This class represents one level of a biological taxon, the subspecies."@en ;
    rdfs:isDefinedBy <https://w3di.org/arco/ontology/context-description/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isSubspeciesIn> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/BiologicalTaxon> ],
        <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT: OG/OGS/OGST" .

<https://w3id.org/arco/ontology/context-description/Tomb> a owl:Class ;
    rdfs:label "Tomb"@en ;
    rdfs:comment "This class represents a tomb."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isTombOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/ArchaeologicalExcavation> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/DSC/DSCS" .

<https://w3id.org/arco/ontology/context-description/hasAttributedAuthor> a owl:ObjectProperty ;
    rdfs:label "has attributed author"@en ;
    rdfs:comment "This property relates a situation where an autorship is attributed to a cultural entity's author."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/arco/ontology/context-description/AlternativeAuthorshipAttribution> <https://w3id.org/arco/ontology/context-description/PreferredAuthorshipAttribution> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isAttributedAuthorIn> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "AU/AUT/AUTN (+ AU/AUT/AUTS); AU/AAT; AU/AAT/AATN" .

<https://w3id.org/arco/ontology/context-description/hasSurveyMotivation> a owl:ObjectProperty ;
    rdfs:label "has survey motivation"@en ;
    rdfs:comment "This property relates an archeological, archaeometric or diagnostic survey or a photo interpretation rendering to the the main motivation that led to it."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/arco/ontology/context-description/ArchaeologicalExcavation> <https://w3id.org/arco/ontology/context-description/ArchaeologicalFieldSurvey> <https://w3id.org/arco/ontology/context-description/ArchaeometricDiagnosticSurvey> <https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/SurveyMotivation> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasDescription> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isSurveyMotivationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/title> a owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    rdfs:comment "This property represents the title of a cultural property."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/core/hasCategory> a owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range <https://w3id.org/arco/ontology/core/Category> .

<https://w3id.org/arco/ontology/core/hasConcept> a owl:ObjectProperty .

<https://w3id.org/italia/onto/TI/TimeInterval> a owl:Class .

<https://w3id.org/italia/onto/l0/Description> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/l0/Object> .

<https://w3id.org/italia/onto/l0/hasDescription> a owl:ObjectProperty ;
    owl:inverseOf <https://w3id.org/italia/onto/l0/isDescriptionOf> .

<https://w3id.org/arco/ontology/context-description/ArchaeologicalFieldSurvey> a owl:Class ;
    rdfs:label "Archaeological field survey"@en ;
    rdfs:comment "This class represents a particular type of survey on a cultural property, that is an archaeological field survey, limited to the surface."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/environmentalState> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityResponsible> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyScientificDirector> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/archeologicalFieldSurveyLocalIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SurveyMethod> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyMethod> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/archaeologicalFieldSurveyICCDIdentifier> ],
        <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/RCG" .

<https://w3id.org/arco/ontology/context-description/ArchaeologicalPropertySurvey> a owl:Class ;
    rdfs:label "Archaeological property survey"@en ;
    rdfs:comment "This class represents a particular type of survey on a cultural property, that is a survey on anthropological materials (e.g.: chemical analysis, histological analysis, CT scan, etc.)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/technicalDocumentation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ArchaeologicalPropertySurveyType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasArchaeologicalPropertySurveyType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SurveyMotivation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyMotivation> ],
        <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT 3.01: IN/INI" .

<https://w3id.org/arco/ontology/context-description/ArchaeometricDiagnosticSurvey> a owl:Class ;
    rdfs:label "Archaeometric and diagnostic survey"@en ;
    rdfs:comment "This class represents a particular type of survey on a cultural property, that is an archaeometric and diagnostic survey (coring, geophysical prospecting, etc.)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SurveyMotivation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyMotivation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/report> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivitySponsor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ArchaeometricDiagnosticSurveyType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasArchaeometricDiagnosticSurveyType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityResponsible> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityOperator> ],
        <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ChangeOfAvailability> a owl:Class ;
    rdfs:label "Change of availability"@en ;
    dc:description "An example of usage of the class 'Change of availability' is the following: resource:ChangeOfAvailability/0900041230-change-of-availability\\n        a  cd:ChangeOfAvailability ;\\n        rdfs:label \"Change of availability of cultural property: 0900041230\"@en ;\\n        cd:hasChangeOfAvailabilityType resource:ChangeOfAvailabilityType/furto ;\\n        tiapit:time \"1998/11/15\" ."@en ;
    rdfs:comment "This class represents the change of availability of a cultural property (e.g.: theft, distruction, rescue, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isChangeOfAvailabilityOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasChangeOfAvailabilityType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/ChangeOfAvailabilityType> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/ALN" .

<https://w3id.org/arco/ontology/context-description/Commission> a owl:Class ;
    rdfs:label "Commission"@en ;
    rdfs:comment "This class represents the commission of a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCommittent> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Circumstance> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCircumstance> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isCommissionOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/context-description/Interpretation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AU/CMM" .

<https://w3id.org/arco/ontology/context-description/Estimate> a owl:Class ;
    rdfs:label "Estimate"@en ;
    rdfs:comment "This class represents the concept of estimate."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isEstimateOf> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/estimatedValue> ;
            owl:someValuesFrom rdfs:Literal ],
        <https://w3id.org/arco/ontology/context-description/Interpretation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/InterpretationCriterion> a owl:Class ;
    rdfs:label "Interpretation criterion"@en ;
    rdfs:comment "This class represents the criterion that motivated an interpretation (e.g. inscription, bibliography, documentation)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isInterpretationCriterionOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AU/AUT/AUTM; AU/CMM/CMMF; AU/AAT/AATM; AU/ATB/ATBM; DT/DTM/DTMM; SG/SGT/SGTL - Normativa VeAC: AU/FRU/FRUF - Normativa MI 3.00: AU/DC/DDCF" .

<https://w3id.org/arco/ontology/context-description/LegalSituation> a owl:Class ;
    rdfs:label "Legal situation"@en ;
    dc:description "An example of usage of the class \"Legal situation\" is the following:\\nresource:LegalSituation/1400054721-legal-situation-proprieta-stato\\n        a  cd:LegalSituation ;\\n        rdfs:label  \"Legal situation of cultural property 1400054721: State property\"@en ;\\n        cd:hasOwner resource:Agent/ministero-beni-culturali ."@en ;
    rdfs:comment "This class represents the legal situation of a cultural property, related to the owner."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isLegalSituationOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasOwner> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/CDG/CDGG" .

<https://w3id.org/arco/ontology/context-description/PhotographicSeries> a owl:Class ;
    rdfs:label "Photographic series"@en ;
    rdfs:comment "This class represents a photographic series, that is a set of photographs created or published as a unit, from a library sciences point of view."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/PhotographicSeriesMembership> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isPhotographicSeriesIn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/PhotographicSubseries> ;
            owl:onProperty <https://w3id.org/arco/ontology/core/hasPart> ],
        <https://w3id.org/italia/onto/l0/Collection> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: PD/SFI" .

<https://w3id.org/arco/ontology/context-description/PreparatoryOrFinalWork> a owl:Class ;
    rdfs:label "Preparatory or final work"@en ;
    dc:description "An example of usage of the class 'Preparatory or final work' is the following::\\nresource:PreparatoryOrFinalWork/0500212038-disegno\\n        a           cd:PreparatoryOrFinalWork ;\\n        rdfs:label  \"Preparatory or final work 1 of cultural property 0500212038: disegno\"@en ;\\n        cd:hasAuthor resource:Agent/tiziano-vecellio ;\\n        cd:hasDating resoruce:Dating/0500212038-disegno ."@en ;
    rdfs:comment "This class represents an entity related to a cultural property, that is its preparatory or final stage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/preparatoryOrFinalWorkRecordIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/preparatoryOrFinalWorkLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Dating> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasDating> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAuthor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/preparatoryOrFinalWorkPreviousLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Inventory> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasInventory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Title> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasTitle> ],
        <http://dati.beniculturali.it/cis/CulturalEntity> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normative F, RA, SMO, PST, S, OAC, OA, MI, D, NU: RO/ROF" .

<https://w3id.org/arco/ontology/context-description/SurveyMethod> a owl:Class ;
