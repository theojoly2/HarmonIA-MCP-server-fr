    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AU/AUT/AUTJ; DO/BIB/BIBJ; RE/RCG/RCGJ; RE/DSC/DSCJ - ICCD Normativa F: PD/PDF/PDFJ" .

<https://w3id.org/arco/ontology/context-description/hasCulturalScope> a owl:ObjectProperty ;
    rdfs:label "has cultural scope"@en ;
    rdfs:comment "This property relates a situation, where a cultural scope is attributed to a cultural entity, to the cultural scope."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/CulturalScopeAttribution> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/CulturalScope> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasTopic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isCulturalScopeOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AU/ATB" .

<https://w3id.org/arco/ontology/context-description/hasInterpretationCriterion> a owl:ObjectProperty ;
    rdfs:label "has interpretation criterion"@en ;
    rdfs:comment "This property relates an authorship, dating, commission, or other interpretation situations, to the reason or criterion which led to that interpretation."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/InterpretationCriterion> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasDescription> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isInterpretationCriterionOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AU/AUT/AUTM; AU/CMM/CMMF; AU/AAT/AATM; AU/ATB/ATBM; DT/DTM/DTMM; SG/SGT/SGTL - ICCD Normativa F: PD/PDF/PDFM - ICCD Normativa VeAC: AU/FRU/FRUF - CCD Normative F, RA, SMO, PST, S, OAC, OA, MI, D, NU: RO/ROF/ROFM" .

<https://w3id.org/arco/ontology/context-description/hasReliability> a owl:ObjectProperty ;
    rdfs:label "has reliability"@en ;
    rdfs:comment "This property relates a photo interpretation rendering survey to the reliability of the information collected during the survey."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/Reliability> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCharacteristic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isReliabilityOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/FOI/FOIO" .

<https://w3id.org/arco/ontology/context-description/hasSECCategory> a owl:ObjectProperty ;
    rdfs:label "has SEC category"@en ;
    rdfs:comment "This property relates a current inventory to the patrimonial category attributed to the cultural property based on the SEC classification."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/CurrentInventory> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/SECCategory> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCategory> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isAcquisitionOf> a owl:ObjectProperty ;
    rdfs:label "is acquisition of"@en ;
    rdfs:comment "This property relates an acquisition event to the cultural entity involved in the acquisition."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Acquisition> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/ACQ" .

<https://w3id.org/arco/ontology/context-description/isAgeOfDeathInterpretationOf> a owl:ObjectProperty ;
    rdfs:label "is age of death interpretation of"@en ;
    rdfs:comment "This property relates the age of death interpretation of an antropologic artifact to the its antropologic artifact."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/AgeOfDeathInterpretation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isAnomalyOf> a owl:ObjectProperty ;
    rdfs:label "is anomaly of"@en ;
    rdfs:comment "This property relates an anomaly revealed by a photo interepretation rendering to the related survey."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Anomaly> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isAttributedAuthorIn> a owl:ObjectProperty ;
    rdfs:label "is attributed author in"@en ;
    rdfs:comment "This is the inverse property of \"has attributed author\"."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/arco/ontology/context-description/AlternativeAuthorshipAttribution> <https://w3id.org/arco/ontology/context-description/PreferredAuthorshipAttribution> ) ] ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/isAgentRelatedTo> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isBibliographyOf> a owl:ObjectProperty ;
    rdfs:label "is bibliography of"@en ;
    rdfs:comment "This property relates a bibliography to the entity which is referred to."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Bibliography> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DO/BIB; RE/RCG/RCGS" .

<https://w3id.org/arco/ontology/context-description/isBiologicalTaxonOf> a owl:ObjectProperty ;
    rdfs:label "is biological taxon of"@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/BiologicalTaxon> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isClassificationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isChangeOfAvailabilityOf> a owl:ObjectProperty ;
    rdfs:label "is change of availability of"@en ;
    rdfs:comment "This property relates a change of availability to a cultural entity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/ChangeOfAvailability> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isCircumstanceOf> a owl:ObjectProperty ;
    rdfs:label "is circumstance of"@en ;
    rdfs:comment "This property, inverse of 'has circumstance' relates the circumstance which led to a situation (e.g. a cultural entity committment, a cultural entity use, etc.) to the related situation."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isCoinIssuanceOf> a owl:ObjectProperty ;
    rdfs:label "is coin issuance of"@en ;
    rdfs:comment "This is the inverse property of \"has coin issuance\"."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/CoinIssuance> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://dati.beniculturali.it/cis/CulturalEntity> <https://w3id.org/arco/ontology/denotative-description/Counterstamp> ) ] ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isCommissionOf> a owl:ObjectProperty ;
    rdfs:label "is commission of"@en ;
    rdfs:comment "This property relates a commission to the cultural entity that was commissioned."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Commission> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isCopyrightOf> a owl:ObjectProperty ;
    rdfs:label "is copyright of"@en ;
    rdfs:comment "This is the inverse property of \"is copyright of\"."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Copyright> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isCulturalPropertyEstimateOf> a owl:ObjectProperty ;
    rdfs:label "is cultural property estimate of"@en ;
    rdfs:comment "This property relates a cultural property estimate to the estimated cultural property."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/CulturalPropertyEstimate> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/isEstimateOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isCulturalPropertyStageIn> a owl:ObjectProperty ;
    rdfs:label "is cultural property stage in"@en ;
    rdfs:comment "This cultural property relates the stage of a cultural property referring to another entity (preparatory or final work) to this relationship between the two entities."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/CulturalPropertyStage> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/RelatedWorkSituation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normative RA, SMO, PST, S, OAC, OA, MI, D, NU, F: RO/ROF/ROFF" .

<https://w3id.org/arco/ontology/context-description/isCulturalScopeOf> a owl:ObjectProperty ;
    rdfs:label "is cultural scope of"@en ;
