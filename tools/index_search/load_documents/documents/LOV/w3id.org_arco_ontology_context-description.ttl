    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isCharacteristicOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isResearchOn> a owl:ObjectProperty ;
    rdfs:label "is research on"@en ;
    rdfs:comment "This property relates a research from which has been produced a cultural entity's catalogue record, to the cultural entity."@en ;
