<https://w3id.org/arco/ontology/context-description/stripRunAndFrameNumber> a owl:DatatypeProperty ;
    rdfs:label "strip run/frame number"@en ;
    rdfs:comment "This property represents aerial photos information about run and frame."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/PhotographicDocumentation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/surveyImageIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "survey image identifier"@en ;
    rdfs:comment "This property represents the identification code that identifies the image examined during a photo-interpretation or photo-restoration investigation."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/SurveyImage> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/FOI/FOID" .

<https://w3id.org/arco/ontology/context-description/technicalDocumentation> a owl:DatatypeProperty ;
    rdfs:label "technical documentation"@en ;
    rdfs:comment "This property represents documentation relating to information collected during survey on anthropological evidence."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/ArchaeologicalPropertySurvey> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT 3.01: IN/INI/INIZ" .

<https://w3id.org/arco/ontology/context-description/useConditions> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "use conditions"@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Use> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: UT/UTU/UTUM - BDM 2.00: UT/UTM - SMO, PTS 3.01: DA/UTM" .

<https://w3id.org/arco/ontology/core/AgentRole> a owl:Class .

<https://w3id.org/arco/ontology/core/Classification> a owl:Class .

<https://w3id.org/arco/ontology/core/description> a owl:DatatypeProperty .

<https://w3id.org/arco/ontology/core/hasAgent> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/hasClassification> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/hasLocation> a owl:ObjectProperty .

<https://w3id.org/italia/onto/l0/Characteristic> a owl:Class .

<https://w3id.org/italia/onto/l0/hasTopic> a owl:ObjectProperty ;
    owl:inverseOf <https://w3id.org/italia/onto/l0/isTopicOf> .

<https://w3id.org/arco/ontology/context-description/AlternativeDating> a owl:Class ;
    rdfs:label "Alternative dating"@en ;
    rdfs:comment "This class represents an alternative dating of a cultural property (e.g.: an obsolete dating, a dating based on another method of dating)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAlternativeDatingType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/AlternativeDatingType> ],
        <https://w3id.org/arco/ontology/context-description/Dating> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ArchivalFonds> a owl:Class ;
    rdfs:label "Archival fonds"@en ;
    ns3:isNativeTo <http://mklab.iti.gr/pericles/BornDigitalArchives_ODP.owl> ;
    rdfs:comment "This class represents an archival fonds."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ArchivalSeries> ;
            owl:onProperty <https://w3id.org/arco/ontology/core/hasComponent> ],
        <https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: UB/UBF/UBFP" .

<https://w3id.org/arco/ontology/context-description/ArchivalSubseries> a owl:Class ;
    rdfs:label "Archival subseries"@en ;
    rdfs:comment "This class represents an archival subseries, that is component of an archival series."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ArchivalSeries> ;
            owl:onProperty <https://w3id.org/arco/ontology/core/isComponentOf> ],
        <https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: UB/UBF/UBFT" .

<https://w3id.org/arco/ontology/context-description/DetectionMethod> a owl:Class ;
    rdfs:label "Detection Method"@en ;
    rdfs:comment "This class represents the method of detection that allowed the detection of a cultural property and which is indicative of the type and consistency of some information in the catalogue record that describes it (e.g.: coring, archive data, oral sources)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isDetectionMethodOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/core/Method> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/OGM" .

<https://w3id.org/arco/ontology/context-description/NumismaticSeries> a owl:Class ;
    rdfs:label "Numismatic series"@en ;
    rdfs:comment "This class represents the series which a particular coin is part of."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCoinMember> ],
        <https://w3id.org/italia/onto/l0/Collection> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa NU: OG/OGT/OGTR" .

<https://w3id.org/arco/ontology/context-description/PhotographicDocumentation> a owl:Class ;
    rdfs:label "Photographic documentation"@en ;
    rdfs:comment "This class represents the photographic documentation of an object, e.g. a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/caption> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/stripRunAndFrameNumber> ],
        <https://w3id.org/arco/ontology/context-description/Documentation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Profession> a owl:Class ;
    rdfs:label "Profession"@en ;
    rdfs:comment "This class represents the role of a cultural entity's user."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/italia/onto/RO/Role> ;
    owl:disjointWith <https://w3id.org/arco/ontology/context-description/UseFunction> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ReferenceCatalogue> a owl:Class ;
    rdfs:label "Reference catalogue"@en ;
    rdfs:comment "This class represents the reference catalogue that cites the copy of a print."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isReferenceCatalogueOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/Copy> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Subject> a owl:Class ;
    rdfs:label "Subject"@en ;
    rdfs:comment "This class represents the subject of a cultural property, or its ornamental motif."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isSubjectOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/italia/onto/l0/Topic> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: DA/AID/AIDI - Normativa F: SG/SGT/SGTI - Altre normative di versioni precedenti alla 4.00: OG/SGT/SGTI - ICCD Normative F, RA, SMO, PST, S, OAC, OA, MI, D, NU: RO/ROF/ROFS" .

<https://w3id.org/arco/ontology/context-description/authorIntervention> a owl:DatatypeProperty ;
    rdfs:label "author intervention"@en ;
    rdfs:comment "This property represents specifications relating to the intervention carried out by the author on the cultural property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/arco/ontology/context-description/AlternativeAuthorshipAttribution> <https://w3id.org/arco/ontology/context-description/PreferredAuthorshipAttribution> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "AU/AUT/AUTY" .

<https://w3id.org/arco/ontology/context-description/estimatedCulturalPropertyValue> a owl:DatatypeProperty ;
    rdfs:label "cultural property value"@en ;
    rdfs:comment "This property represents cultural entity's economic value.. The value is preceded by the currency specification."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/CulturalPropertyEstimate> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/estimatedValue> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: UB/COL/COLV; UB/INP/INP/INPA; UB/STI" .

<https://w3id.org/arco/ontology/context-description/estimatedValue> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "estimated value"@en ;
    rdfs:comment "This property represents the value estimated in the context of an estimate process."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Estimate> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/hasActivitySponsor> a owl:ObjectProperty ;
    rdfs:label "has activity sponsor"@en ;
    rdfs:comment "This property relates an activity to its investor. The investor may be an institution or an agent."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Activity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isActivitySponsorOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RS/RST/RSTR; RE/IND/INDR" .

<https://w3id.org/arco/ontology/context-description/hasAnomalyOrigin> a owl:ObjectProperty ;
    rdfs:label "has anomaly origin"@en ;
    rdfs:comment "This property relates an anomaly detected during a photo interpretation or rendering survey to the origin of the anomaly (e.g. natural, unsure)."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Anomaly> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/AnomalyOrigin> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCharacteristic> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isAnomalyOriginOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/FOI/FOIA" .

<https://w3id.org/arco/ontology/context-description/hasAuthorityFileCataloguingAgency> a owl:ObjectProperty ;
    rdfs:label "has authority file cataloguing agency"@en ;
    rdfs:comment "This property relates an entity described in a authority file to the file's cataloguing institution."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
