    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isResponsibleForInsertionOf> a owl:ObjectProperty ;
    rdfs:label "is responsible for insertion of"@en ;
    rdfs:comment "This property relates the agent responsible for the cultural entity's inventory to the current inventory."@en ;
