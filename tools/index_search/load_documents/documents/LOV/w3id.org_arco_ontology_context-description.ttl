    ns1:iccdNormTag "ICCD Normativa SM e BDM 4.00: DR/DRT" .

<https://w3id.org/arco/ontology/context-description/hasResponsibility> a owl:ObjectProperty ;
    rdfs:label "has responsibility"@en ;
    rdfs:comment "This property relates a photographic cultural entity (photography or photographic fond) to the responsibility attribution of an agent. The agent is in charge of the production or disclosure process which characterises photographic heritage (i.e. printers, editors, distributors, sposors, collection responsibles etc.)"@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto:,
        "This property relates a photographic heritage to the the attribution of a responsibility to an agent, relating to the activities of production and dissemination of photographic heritage (e.g.: committent, editor, printer, dedicatee, etc.)."@en ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/Responsibility> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isResponsibilityFor> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: PD/PDF" .

<https://w3id.org/arco/ontology/context-description/hasSexInterpretation> a owl:ObjectProperty ;
    rdfs:label "has sex interpretation"@en ;
    rdfs:comment "This property relates an antropologic artifact to its sex estimate."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/SexInterpretation> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasSituation> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isSexInterpretationOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT: DA/STS" .

<https://w3id.org/arco/ontology/context-description/hasSubject> a owl:ObjectProperty ;
    rdfs:label "has subject"@en ;
    rdfs:comment "This property relates a cultural property or a preparatory or final work of a cultural property to ist subject or ornamental motif."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/Subject> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isSubjectOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: DA/AID/AIDI - Normativa F: SG/SGT/SGTI - Altre normative di versioni precedenti alla 4.00: OG/SGT/SGTI - ICCD Normative F, RA, SMO, PST, S, OAC, OA, MI, D, NU: RO/ROF/ROFS" .

<https://w3id.org/arco/ontology/context-description/hasSurvey> a owl:ObjectProperty ;
    rdfs:label "has survey"@en ;
    rdfs:comment "This property relates a cultural entity's acquisition to its acquisition type."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isSurveyOn> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE; CM/ISP - ICCD Normative NU, RA, BNB, MA, CA: RS/ALB - ICCD Normativa AT 3.00: IN/INI - Normativa BDM e SM 4.00: DR" .

<https://w3id.org/arco/ontology/context-description/hasUrbanPlanningInstrument> a owl:ObjectProperty ;
    rdfs:label "has urban planning instrument"@en ;
    rdfs:comment "This class relates a cultural property to the related urban planning instrument."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/UrbanPlanningInstrument> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isUrbanPlanningInstrumentOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/STU" .

<https://w3id.org/arco/ontology/context-description/hasUse> a owl:ObjectProperty ;
    rdfs:label "has use"@en ;
    rdfs:comment "This property relates a cultural entity to its use."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/Use> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasDescription> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isUseOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/hasUserSocialCategory> a owl:ObjectProperty ;
    rdfs:label "has user social category"@en ;
    rdfs:comment "This property relates the user of a cultural property to its social category."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/UserSocialCategory> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCategory> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/historicalBiographicalInformation> a owl:DatatypeProperty ;
    rdfs:comment "This property represents historical biographical information about an agent."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

<https://w3id.org/arco/ontology/context-description/historicalInformation> a owl:DatatypeProperty ;
    rdfs:label "historical information"@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/NSC" .

<https://w3id.org/arco/ontology/context-description/iconclassCode> a owl:DatatypeProperty ;
    rdfs:label "Iconclass Code"@en ;
    rdfs:comment "This property represents the Iconclass code, for describing the subject or ornamental motif represented by the cultural property."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/informationGatheredOnSite> a owl:DatatypeProperty ;
    rdfs:label "information gathered on site"@en ;
    rdfs:comment "This property represents information collected on the place where the cultural entity is located or on the place where it was detected."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/NRL" .

<https://w3id.org/arco/ontology/context-description/involves> a owl:ObjectProperty ;
    rdfs:label "involves"@en ;
    rdfs:comment "This is the inverse property of 'is involved in', which relates a cultural entity to another involved cultural entity (e.g. immaterial)."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/isWorkRelatedTo> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isInvolvedIn> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isKeptIn> a owl:DatatypeProperty ;
    rdfs:label "is kept in"@en ;
    rdfs:comment "This property represents the location of the asset in its environment, i.e. the place where it is stored when not in use."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Use> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isLocatedIn> a owl:ObjectProperty ;
    rdfs:label "is located in"@en ;
    rdfs:comment "This property relates a cultural entity to a connected cultural entity which constitutes its location area."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedWork> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isLocationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isReproducedBy> a owl:ObjectProperty ;
    rdfs:label "is reproduced by"@en ;
    rdfs:comment "This property relates a print to the reproduction of that print in a publication."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/Reproduction> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/reproduces> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa S 3: RO/ADL" .

<https://w3id.org/arco/ontology/context-description/isReusedBy> a owl:ObjectProperty ;
    rdfs:label "is reused by"@en ;
    rdfs:comment "This property relates a cultural entity to a connected cultural entity that reuse it or a part of it."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedWork> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/reuses> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/numberInCirculation> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number in circulation"@en ;
    rdfs:comment "This property represents photograph copies numbering."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: PD/TRT; ICCD Normativa S: PD/TRT/TRTN" .

<https://w3id.org/arco/ontology/context-description/parallelTitle> a owl:DatatypeProperty ;
    rdfs:label "parallel title"@en ;
    rdfs:comment "This property represents the parallel title of a cultural property."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/title> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa F: SG/SGL/SGLL - Normative S e MI: OG/SGT/SGTR" .

<https://w3id.org/arco/ontology/context-description/photographicSubseriesItemNumber> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "photographic subseries item number"@en ;
    rdfs:comment "This property represents numbering of the photograph within the editorial photographic subseries."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/PhotographicSeriesMembership> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    ns1:iccdNormTag "ICCD Normativa F: PD/SSI/SSIN" .

<https://w3id.org/arco/ontology/context-description/properTitle> a owl:DatatypeProperty ;
    rdfs:label "propert title"@en ;
    rdfs:comment "This property represents the proper title of a cultural property."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/title> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normative S e MI: OG/SGT/SGTP - Normativa F: SG/SGL/SGLT" .

<https://w3id.org/arco/ontology/context-description/relatedWorkNote> a owl:DatatypeProperty ;
    rdfs:label "related work note"@en ;
    rdfs:comment "This property represents general notes on the relationships established between the property in question and other works."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/note> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RV/REZ" .

<https://w3id.org/arco/ontology/context-description/relevantLegalAct> a owl:DatatypeProperty ;
    rdfs:label "relevant legal act"@en ;
    rdfs:comment "This property represents any references to documents that affect cultural entity acquisition."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/CurrentInventory> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: IUB/INP/INPO" .

<https://w3id.org/arco/ontology/context-description/specificTime> a owl:ObjectProperty ;
    rdfs:label "specific time"@en ;
    rdfs:comment "This property relates the event (creation, distruction) to which a dating of a cultural property is related to the \"specific time\", as the dating expressed in year or as a date yyyy/mm/dd."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/TI/TimeInterval> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/TI/atTime> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/specificTimeOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: DT/DTS/DTSI + DT/DTS/DTSV + DT/DTS/DTSF + DT/DTS/DTSL" .

<https://w3id.org/arco/ontology/context-description/subject> a owl:DatatypeProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "This property represents the subject of a cultural property, or its ornamental motif."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/taxonAuthorAndDate> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "taxon author and date"@en ;
    rdfs:comment "This property represents the author that described the species and the date of description."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/BiologicalTaxon> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT: OG/OGS/OGSA" .

<https://w3id.org/arco/ontology/context-description/ConservationIntervention> a owl:Class ;
    rdfs:label "Conservation Intervention"@en ;
    rdfs:comment "This class represents a conservation intervention on a cultural property (e.g.: microclimatic inspection, mechanical cleaning or with chemicals, pest control, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/framework> ],
        <https://w3id.org/arco/ontology/context-description/Intervention> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/IndeterminateCircumstance> a owl:Class ;
    rdfs:label "Indeterminate circumstance"@en ;
    rdfs:comment "This class represents an indeterminate circumstance, when the cultural property is not related to a determinate circumstance, but takes place in an extemporaneous and contingent way (e.g.: a musical performance, a narration, a game)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    owl:disjointWith <https://w3id.org/arco/ontology/context-description/LifeCycleCircumstance>,
        <https://w3id.org/arco/ontology/context-description/ProductionCycleCircumstance>,
        <https://w3id.org/arco/ontology/context-description/SeasonCycleCircumstance>,
        <https://w3id.org/arco/ontology/context-description/SocialInteractionCircumstance>,
        <https://w3id.org/arco/ontology/context-description/WorkCircumstance>,
        <https://w3id.org/arco/ontology/context-description/YearCycleCircumstance> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa BDI 4.00: CA/CAO/CAOI" .

<https://w3id.org/arco/ontology/context-description/Inspection> a owl:Class ;
    rdfs:label "Inspection"@en ;
    rdfs:comment "This class represents a particular type of survey on a cultural property, that is an inspection carried out to verify the condition of a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityResponsible> ],
        <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CM/ISP" .

<https://w3id.org/arco/ontology/context-description/LifeCycleCircumstance> a owl:Class ;
    rdfs:label "Life cycle circumstance"@en ;
    rdfs:comment "This class represents a circumstance related to life cycles (ceremonies, custom, celebration)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa BDI 4.00: CA/CAO/CAOV" .

<https://w3id.org/arco/ontology/context-description/PhotographicSubseries> a owl:Class ;
    rdfs:label "Photographic subseries"@en ;
    rdfs:comment "This class represents a photographic subseries, that is a component of a photographic series."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/PhotographicSeries> ;
            owl:onProperty <https://w3id.org/arco/ontology/core/isPartOf> ],
        <https://w3id.org/arco/ontology/context-description/PhotographicSeries> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: PD/SSI" .

<https://w3id.org/arco/ontology/context-description/PreparatoryWork> a owl:Class ;
    rdfs:label "Preparatory work"@en ;
    rdfs:comment "This class represents an entity related to a cultural property, as its preparatory stage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/PreparatoryOrFinalWork> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ProductionCycleCircumstance> a owl:Class ;
    rdfs:label "Production cycle circumstance"@en ;
    rdfs:comment "This class represents a circumstance related to production cycles (sericulture, cereal crop, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa BDI 4.00: CA/CAO/CAOP" .

<https://w3id.org/arco/ontology/context-description/RCSReason> a owl:DatatypeProperty ;
    rdfs:label "RCS reason"@en ;
    rdfs:comment "This property represents the code of the RCS causal (Central State Accounting Office) of increasing or decreasing property value."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/CurrentInventory> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: UB/INP/INPU" .

<https://w3id.org/arco/ontology/context-description/SeasonCycleCircumstance> a owl:Class ;
    rdfs:label "Season cycle circumstance"@en ;
    rdfs:comment "This class represents a circumstance related to seasonal cycles, referred to: subject of popular belief, myth, science; poetry, prose, songs, art, ritual; practical activities, behaviour, phenomena connected to specific cycles, days, months, seasons; fortunate or unfortunate days and periods."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa BDI 4.00: CA/CAO/CAOS" .

<https://w3id.org/arco/ontology/context-description/SocialInteractionCircumstance> a owl:Class ;
    rdfs:label "Social interaction circumstance"@en ;
    rdfs:comment "This class represents a circumstance related to social interaction (dances, pubs, wakes)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa BDI 4.00: CA/CAO/CAOQ" .

<https://w3id.org/arco/ontology/context-description/WorkCircumstance> a owl:Class ;
    rdfs:label "Work circumstance"@en ;
    rdfs:comment "This class represents a circumstance related to work (e.g.: agriculture, bakery)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa BDI 4.00: CA/CAO/CAOL" .

<https://w3id.org/arco/ontology/context-description/YearCycleCircumstance> a owl:Class ;
    rdfs:label "Year cycle circumstance"@en ;
    rdfs:comment "This class represents a circumstance related to year cycles (e.g.: autumnal equinox, New Year's Eve, Lent, Ramadan, carnival, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa BDI 4.00: CA/CAO/CAOA" .

<https://w3id.org/arco/ontology/context-description/abbreviation> a owl:DatatypeProperty ;
    rdfs:label "abbreviation"@en ;
    rdfs:comment "This property represents the abbreviation that identifies the bibliographic reference."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Bibliography> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/acquisitionLocation> a owl:DatatypeProperty ;
    rdfs:label "acquisition location"@en ;
    rdfs:comment "This property represents the place where an acquisition event, generally expressed, based on the available data, took place, in the form: \"Region / abbreviation province / full name of the Municipality / locality or toponym\""@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Acquisition> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/ACQ/ACQL" .

<https://w3id.org/arco/ontology/context-description/ageOfDeath> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "estimated age of death"@en ;
    rdfs:comment "This property represents an anthropological finding estimated age of death."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/AgeOfDeathInterpretation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/archaeologicalExcavationICCDIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "archaeological excavation ICCD identifier"@en ;
    rdfs:comment "This property represents the code, assigned by the ICCD, which identifies the archaeological excavation unequivocally at national level."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/ArchaeologicalExcavation> ;
