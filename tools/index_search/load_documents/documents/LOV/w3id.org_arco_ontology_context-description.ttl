    rdfs:comment "ICCD Normativa Trasversale 4.00: RE/IND/INDT - ICCD Normativa AT 3.00: IN/INI/INIR",
        "This property represents the report of a anthropological finding's archaeometric and diagnostic investigation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/arco/ontology/context-description/ArchaeologicalPropertySurvey> <https://w3id.org/arco/ontology/context-description/ArchaeometricDiagnosticSurvey> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/reproduces> a owl:ObjectProperty ;
    rdfs:label "reproduces"@en ;
    rdfs:comment "This property relates the reproduction of an print in a publication to the print itself."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Reproduction> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
