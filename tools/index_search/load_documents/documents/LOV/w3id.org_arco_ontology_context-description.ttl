<https://w3id.org/arco/ontology/context-description/CollectionMembership> a owl:Class ;
    rdfs:label "Collection Membership"@en ;
    rdfs:comment "This class represents the membership of a cultural property in a collection."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/collectionUnitIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/estimatedCulturalPropertyValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://dati.beniculturali.it/cis/CollectionCulEnt> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCollection> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/collectionLeavingReason> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasMemberOfCollection> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/TI/TimeInterval> ;
            owl:onProperty <https://w3id.org/italia/onto/TI/atTime> ],
        <https://w3id.org/arco/ontology/context-description/Membership> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "UB/COL" .

<https://w3id.org/arco/ontology/context-description/Copyright> a owl:Class ;
    rdfs:label "Copyright"@en ;
    rdfs:comment "This class represents the copyright of an object, e.g. a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isCopyrightOf> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/expiryDate> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCopyrightHolder> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/l0/Agent> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F 4.00 e OAC: TU/CPR" .

<https://w3id.org/arco/ontology/context-description/Edition> a owl:Class ;
    rdfs:label "Edition"@en ;
    rdfs:comment "This class represents the edition of an entity (e.g. the print edition of a cultural property)."@en ;
    rdfs:isDefinedBy "https://w3id.org/arco/context-description/" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasEditor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAuthor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSecondaryAuthor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/italia/onto/TI/time> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Title> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasTitle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/editionLocation> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isEditionOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/FindingContext> a owl:Class ;
    rdfs:label "Finding context"@en ;
    rdfs:comment "This class represents the context (type of context, associated objects) in which a cultural property (in particular, an anthropological material) is found."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Object> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAssociatedObject> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasFindingContextType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/FindingContextType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/core/specifications> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isFindingContextOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT 3.01: OG/OGC" .

<https://w3id.org/arco/ontology/context-description/Format> a owl:Class ;
    rdfs:label "Format"@en ;
    rdfs:comment "This class represents the documentation format (e.g. jpeg, pdf, MP4)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isFormatOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/Documentation> ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DO/FTA/FTAF, DO/DRA/DRAF, DO/FNT/FNTR (+ DO/VDC/VDCP, DO/REG/REGP)" .

<https://w3id.org/arco/ontology/context-description/SurveyImage> a owl:Class ;
    rdfs:label "Survey Image"@en ;
    rdfs:comment "This class represents the image analysed during a photo interpretation or rendering survey."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isSurveyImageOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/surveyImageIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SurveyImageType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyImageType> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/FOI/FOIT + FOID" .

<https://w3id.org/arco/ontology/context-description/SurveyImageType> a owl:Class ;
    rdfs:label "Survey image type"@en ;
    rdfs:comment "This class represents the type of image analysed during a photo interpretation or rendering survey (aerial photograph, satellite photograph)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/FOI/FOIT" .

<https://w3id.org/arco/ontology/core/Category> a owl:Class .

<https://w3id.org/arco/ontology/context-description/AlternativeDatingType> a owl:Class ;
    rdfs:label "Alternative dating type"@en ;
    rdfs:comment "This class represents the type of alternative dating of a cultural property (different dating, obsolete dating, other method dating)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/AnomalyType> a owl:Class ;
    rdfs:label "Anomaly type"@en ;
    rdfs:comment "This class represents the type of anomaly (line anomaly, point anomaly, polygon anomaly) observed during a photo interpretation or rendering survey."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/FOI/FOIQ" .

<https://w3id.org/arco/ontology/context-description/ArchivalRecordSetMembership> a owl:Class ;
    rdfs:label "Archival record set membership"@en ;
    rdfs:comment "This class represents the membership of a cultural property in an archival record set."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasArchivalRecordSet> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasMemberOfArchivalRecordSet> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/archivalRecordSetTitle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/archivalRecordLocation> ],
        <https://w3id.org/arco/ontology/context-description/Membership> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: UB/UBF" .

<https://w3id.org/arco/ontology/context-description/Dating> a owl:Class ;
    rdfs:label "Dating"@en ;
    rdfs:comment "This class represents the dating of an entity, that is information about the chronology of the entity (e.g.: a cultural property), referring to a particular event (e.g.: the creation of the cultural property, its distruction, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isDatingOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/EventOrSituation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasDatingEvent> ],
        <https://w3id.org/arco/ontology/context-description/Interpretation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: DT - ICCD Normative F, RA, SMO, PST, S, OAC, OA, MI, D, NU: RO/ROF/ROFD" .

<https://w3id.org/arco/ontology/context-description/DocumentationType> a owl:Class ;
    rdfs:label "Documentation type"@en ;
    rdfs:comment "This class represents the type of documentation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Intervention> a owl:Class ;
    rdfs:label "Intervention"@en ;
    dc:description "An example of usage of the class 'Intervention' is the following:\\nresource:Intervention/0800640527-10-intervention-1\\n        a           cd:Intervention ;\\n        rdfs:label  \"Intervention 1 on cultural property 0800640527-10\"@en ;\\n        cd:hasActivityOperator resource:Agent/tonelli-elvira ;\\n        cd:hasActivityResponsible resource:Agent/soprintendenza-per-i-beni-ambientali-ed-architettonici-di-bologna-modena-e-reggio-emilia ;\\n        cd:hasInterventionType resource:InterventionType/restauro ;\\n        tiapit:atTime resource:TimeInterval/1994 ."@en ;
    rdfs:comment "This class represents an intervention on a cultural property, that is an activity carried out for its conservation or for other purposes: conservation interventions, reprocessing, restoring, etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isInterventionOn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivitySponsor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/core/specifications> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/core/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityOperator> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/InterventionType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasInterventionType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/core/AgentRole> ;
            owl:onProperty <https://w3id.org/arco/ontology/core/hasAgentRole> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityResponsible> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/TI/TimeInterval> ;
            owl:onProperty <https://w3id.org/italia/onto/TI/atTime> ],
        <https://w3id.org/italia/onto/l0/Activity> ;
    owl:disjointWith <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Reliability> a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "This class represents the reliability level of detected information relative to photo interpretation rendering."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering> ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/arco/ontology/context-description/hasReliability> ] ],
        <https://w3id.org/italia/onto/l0/Characteristic> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/FOI/FOIO" .

<https://w3id.org/arco/ontology/context-description/Research> a owl:Class ;
    rdfs:label "Research"@en ;
    rdfs:comment "This class represents the research in which the catalogue record describing a cultural property was recorded (e.g.: a cataloguing campaign). The research can be related to the observation survey on musical heritage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/onto/l0/name> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ObservationSurvey> ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/arco/ontology/context-description/isRelatedToResearch> ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasResearchScientificDirector> ],
        <https://w3id.org/italia/onto/l0/Activity> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa SM e BDM 4.00: DR/DRT" .

<https://w3id.org/arco/ontology/context-description/Responsibility> a owl:Class ;
    rdfs:label "Responsibility"@en ;
    rdfs:comment "This class represents the attribution of a responsibility to an agent, relating to the activities of production and dissemination of photographic heritage (e.g.: committent, editor, printer, dedicatee, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasResponsibilityType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/ResponsibilityType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAuthorityFileCataloguingAgency> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isResponsibilityFor> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAgentWithResponsibility> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/l0/Agent> ],
        <https://w3id.org/arco/ontology/context-description/Interpretation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normative F e FF: PD/PDF" .

<https://w3id.org/arco/ontology/context-description/SurveyMotivation> a owl:Class ;
    rdfs:label "Survey Motivation"@en ;
    rdfs:comment "This class represents the main motivation of a survey."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isSurveyMotivationOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/Survey> ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/UrbanPlanningInstrument> a owl:Class ;
    rdfs:label "Urban planning instrument"@en ;
    rdfs:comment "This class represents a urban planning instrument, related to a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isUrbanPlanningInstrumentOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasIssuingAgency> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/EligibleIntervention> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasEligibleIntervention> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/STU" .

<https://w3id.org/arco/ontology/context-description/hasActivityResponsible> a owl:ObjectProperty ;
    rdfs:label "has activity responsible"@en ;
    rdfs:comment "This property relates an activity to the institution or the survey's responsible entity. In the ontology this relationship is modelled also by the class AgentRole which allows more expressiveness."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Activity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isActivityResponsibleOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/RCG/RCGR; RE/DSC/DSCF; RE/IND/INDE; RE/FOI/FOIE - Normativa SM e BDM 4.00: DR/DRV" .

<https://w3id.org/arco/ontology/context-description/hasRelatedWork> a owl:ObjectProperty ;
    rdfs:label "has related work"@en ;
    rdfs:comment "This property relates a cultural property to a related work (e.g. copy, preparatory work)."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isWorkRelatedTo> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/core/specifications> a owl:DatatypeProperty .

<https://w3id.org/arco/ontology/context-description/Acquisition> a owl:Class ;
    rdfs:label "Acquisition"@en ;
    dc:description "An example of usage of the class 'Acquisition' is the following:\\n\\nresource:Acquisition/1200865053-acquisition-1\\n        a  cd:Acquisition ;\\n        rdfs:label  \"Acquisition 1 of cultural property: 1200865053\"@it ;\\n        cd:hasAcquisitionType resource:AcquisitionType/donazione ;\\n        cd:hasPreviousOwner resource:Agent/auriti-giacinto ;\\n        tiapit:time \"1963\" ."@en ;
    rdfs:comment "This class represents a situation in which a cultural property is acquired, passing from an owner to another, and has a particular legal situation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAcquisitionType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/AcquisitionType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isAcquisitionOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasPreviousOwner> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/acquisitionLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/italia/onto/TI/time> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/ACQ" .

<https://w3id.org/arco/ontology/context-description/AuthorshipAttribution> a owl:Class ;
    rdfs:label "Authorship Attribution"@en ;
    rdfs:comment "This class represents the attribution of authorship or a responsibility for the creation of a cultural property, referring to the agents that played a role in the creation of the cultural property or to the reference cultural scope."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAuthorityFileCataloguingAgency> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/RO/Role> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasInterventionRole> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAttributedAuthor> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isAuthorshipAttributionOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/CulturalScope> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCulturalScope> ],
        <https://w3id.org/arco/ontology/context-description/Interpretation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: AU/AAT; AU/ATB; AU/AUT" .

<https://w3id.org/arco/ontology/context-description/Bibliography> a owl:Class ;
    rdfs:label "Bibliography"@en ;
    rdfs:comment "This class represents the bibliography of an entity, e.g. a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isBibliographyOf> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/BibliographyCategory> ;
            owl:onProperty <https://w3id.org/arco/ontology/core/hasCategory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/bibliographyICCDIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/BibliographyType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasBibliographyType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/completeBibliographicReference> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Edition> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasEdition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://w3id.org/italia/onto/SM/URL> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/abbreviation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/core/specifications> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/DerivatedWork> a owl:Class ;
    rdfs:label "Derivated work"@en ;
    rdfs:comment "This class represents a derivated work of a cultural property (copy, reuse, facsimile, forgery), created by the same author or by another author."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAuthor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/DerivatedWorkType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasDerivatedWorkType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/derivatedWorkLocation> ],
        <http://dati.beniculturali.it/cis/CulturalEntity> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa S 3: RO/COP - Normativa F: RO/CRF - Normative RA, SMO, PST, OAC, OA, MI, D, NU: RO/REI - Normative CA, MA: RO/RIU" .

<https://w3id.org/arco/ontology/context-description/ExportImportCertification> a owl:Class ;
    rdfs:label "Export import certification"@en ;
    rdfs:comment "This class represents the export/import certification of a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasExportImportCertificationType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/ExportImportCertificationType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isExportImportCertificationOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasExportOffice> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/ESP" .

<https://w3id.org/arco/ontology/context-description/Interpretation> a owl:Class ;
    rdfs:label "Interpretation"@en ;
    dc:description "An example of usage of one of the subclasses of the class 'Interpretation' is the following:\\nresource:PreferredAuthorshipAttribution/1200865600-1 a           cd:PreferredAuthorshipAttribution ;\\n        rdfs:label  \"Preferred authorship attribution of cultural property: 1200865600\"@en ;\\n        cd:hasAttributedAuthor resource:Agent/cavaceppi-bartolomeo-1717-1799 ;\\n        cd:hasSource resource:Source/documentation ."@en ;
    rdfs:comment "This class represents a situation in which pieces of information related to an object (e.g.: a cultural property) are detected and recorded by an agent, based on a specific source or motivation (e.g.:ithe authorship attribution, commission, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasInterpretationCriterion> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/InterpretationCriterion> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Inventory> a owl:Class ;
    rdfs:label "Inventory"@en ;
    rdfs:comment "This class represents an inventory about a cultural property or about an entity or an activity related to the cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasInventoryIdentifierResponsible> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isInventoryOf> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/inventoryIdentifier> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/inventoryLocation> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/PhotographicSeriesMembership> a owl:Class ;
    rdfs:label "Photographic series membership"@en ;
    rdfs:comment "This class represents the membership of photographic heritage in a photographic series, as a unit."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/photographicSeriesItemNumber> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasPhotographicSeries> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/PhotographicSeries> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasMemberOfPhotographicSeries> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/context-description/Membership> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: PD/SFI; PD/SSI" .

<https://w3id.org/arco/ontology/context-description/ProtectiveMeasure> a owl:Class ;
    rdfs:label "Protective measure"@en ;
    rdfs:comment "This class represents the protective measure, national or international, related to a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/openingNoticeDate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/issueDate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/registrationDateOrGU> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasProponentAgency> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/noticeDate> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isProtectiveMeasureOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/NVC" .

<https://w3id.org/arco/ontology/context-description/RelatedWorkSituation> a owl:Class ;
    rdfs:label "Related work situation"@en ;
    dc:description "An example of usage of the class 'Related work situation' is the following:\\nresource:RelatedWorkSituation/0300199368-preparatory-final-work-1\\n        a  cd:RelatedWorkSituation ;\\n        rdfs:label  \"Relation 1 between the cultural property 0300199368 and preparatory or final work\"@en  ;\\n      cd:hasCulturalPropertyStage resource:CulturalPropertyStage/bozzetto ;\\n        cd:hasRelatedWork resource:FinalWork/0300199368-dipinto ."@en ;
    rdfs:comment "This class represents a situation in which a cultural property is related to another work, that could even be another cultural property. The cultural property stage is defined referring to this relationship with a related work, that can represent a preparatory, a final phase or a derivation of the cultural property. When the relationship is between two cultural properties, when possible, the nature of the relationship is specified (e.g.: finding location)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/CulturalPropertyStage> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCulturalPropertyStage> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isRelatedWorkSituationOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/involvesRelatedWork> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Title> a owl:Class ;
    rdfs:label "Title"@en ;
    rdfs:comment "This class represents the title of an object, e.g. the title of the subject represented by a cultural property, or the title of a photographic series, etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/TitleType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasTitleType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/core/specifications> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isTitleOf> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/InterpretationCriterion> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasInterpretationCriterion> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/UseType> a owl:Class ;
    rdfs:label "Use type"@en ;
    rdfs:comment "This class represents the type of use of a cultural property (current, previous, historical)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: UT/UTU/UTUT" .

<https://w3id.org/arco/ontology/context-description/isWorkRelatedTo> a owl:ObjectProperty ;
    rdfs:label "is work related to"@en ;
    rdfs:comment "This is the inverse property of \"has related work\"."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Anomaly> a owl:Class ;
    rdfs:label "Anomaly"@en ;
    rdfs:comment "This class represents an anomaly detected during a photo interpretation or rendering."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/AnomalyOrigin> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAnomalyOrigin> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/AnomalyType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAnomalyType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isAnomalyOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/FOI/FOIA" .

<https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> a owl:Class ;
    rdfs:label "Archival record set"@en ;
    ns3:isNativeTo <http://mklab.iti.gr/pericles/BornDigitalArchives_ODP.owl> ;
    dc:description "An example of usage of on of the subclasses of the class 'Archival Record Set' is the following:\\nresource:ArchivalSubseries/museo-civico-romano\\n        a           cd:ArchivalSubseries ;\\n        rdfs:label  \"Museo Civico Romano\" ;\\n        cd:isArchivalRecordSetIn resource:ArchivalRecordSetMembership/1201251092 ;\\n        core:isComponentOf resource:ArchivalSeries/brescia ."@en ;
    rdfs:comment "This class represents an archival record set (fonds, series, subseries) of which a cultural property can be member."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Title> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasTitle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/archivalRecordSetIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://w3id.org/arco/ontology/context-description/ArchivalRecord> <https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> ) ] ;
            owl:onProperty <https://w3id.org/arco/ontology/core/hasPart> ],
        <https://w3id.org/italia/onto/l0/Collection> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: UB/UBF" .

<https://w3id.org/arco/ontology/context-description/ObservationSurvey> a owl:Class ;
    rdfs:label "Observation survey"@en ;
    rdfs:comment "This class represents a particular type of survey on a cultural property, that is an observation survey: the observation of musical heritage or demoethnoanthropological heritage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveySoundEngineer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Research> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isRelatedToResearch> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyPhotographer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityOperator> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityResponsible> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ObservationSurveyType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasObservationSurveyType> ],
        <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa SM e BDM 4.00: DR" .

<https://w3id.org/arco/ontology/context-description/Reproduction> a owl:Class ;
    rdfs:label "Reproduction"@en ;
    rdfs:comment "This class represents the reproduction of an image, that is, or was, part of a publication."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isReproductionOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/PrintInPublication> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ReproductionPosition> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasReproductionPosition> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/l0/Activity> a owl:Class .

<https://w3id.org/italia/onto/l0/identifier> a owl:DatatypeProperty .

<https://w3id.org/arco/ontology/context-description/CurrentInventory> a owl:Class ;
    rdfs:label "Current Inventory"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSECIdentifier> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/SECIdentifier> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/culturalPropertyInventoryDescription> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasResponsibleForInsertion> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/l0/Agent> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSECCategory> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/SECCategory> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/provenance> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/methodOfInsertion> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/RCSReason> ;
            owl:someValuesFrom rdfs:Literal ],
        <https://w3id.org/arco/ontology/context-description/Inventory> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ExportImportCertificationType> a owl:Class ;
    rdfs:label "Export import certification type"@en ;
    rdfs:comment "This class represents the type of export/import certification of a cultural property (e.g.: temporary movement certification, temporary export license, free movement certification, etc.)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/ESP/ESPT" .

<https://w3id.org/arco/ontology/context-description/UseTypeSpecification> a owl:Class ;
    rdfs:label "Use type specification"@en ;
    rdfs:comment "This class represents the specification of the type of use of a cultural property (e.g. building, ornamental, structural, instrumental)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/core/Situation> a owl:Class .

<https://w3id.org/arco/ontology/context-description/ArchaeologicalExcavation> a owl:Class ;
    rdfs:label "Archaeological excavation"@en ;
    rdfs:comment "This class represents a particular type of survey on a cultural property, that is an archaeological (stratigraphic) excavation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityResponsible> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SurveyMotivation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyMotivation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/areaRoomSquare> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/StratigraphicUnit> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasStratigraphicUnit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Tomb> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasTomb> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/archaeologicalExcavationICCDIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyScientificDirector> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SurveyMethod> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyMethod> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/archaeologicalExcavationLocalIdentifier> ],
        <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/DSC" .

<https://w3id.org/arco/ontology/context-description/CoinIssuance> a owl:Class ;
    rdfs:label "Coin issuance"@en ;
    rdfs:comment "This class represents the issuance of a coin, at a particular time and with different agents participanting to it (Mint, Issuing State, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasIssuingState> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasMinter> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isCoinIssuanceOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasMint> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasIssuer> ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Use> a owl:Class ;
    rdfs:label "Use"@en ;
    rdfs:comment "This class represents the use of a cultural property, that can change over time, depending on the circumstances and on which parts of the cultural property are used."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Circumstance> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCircumstance> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasUseFunction> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/UseFunction> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isUseOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/UseType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasUseType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/useFunction> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/useConditions> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/UseTypeSpecification> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasUseTypeSpecification> ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: UT" .

<https://w3id.org/arco/ontology/context-description/BiologicalTaxon> a owl:Class ;
    rdfs:label "Biological taxon"@en ;
    rdfs:comment "This class represents a biological taxon."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/arco/ontology/context-description/Genus> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasGenus> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/arco/ontology/context-description/Species> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSpecies> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass <https://w3id.org/arco/ontology/context-description/Subspecies> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSubspecies> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isBiologicalTaxonOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/arco/ontology/core/Classification> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT: OG/OGS" .

<https://w3id.org/arco/ontology/context-description/PhotoInterpretationRendering> a owl:Class ;
    rdfs:label "Photo interpretation and rendering"@en ;
    rdfs:comment "This class represents a particular type of survey on a cultural property, that is photo interpretation and rendering."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SurveyImage> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyImage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SurveyMotivation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyMotivation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Anomaly> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAnomaly> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurveyScientificDirector> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Reliability> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasReliability> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/overlapSpecifications> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasActivityResponsible> ],
        <https://w3id.org/arco/ontology/context-description/Survey> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE/FOI" .

<https://w3id.org/arco/ontology/context-description/TitleType> a owl:Class ;
    rdfs:label "Title Type"@en ;
    rdfs:comment "This class represents the type of an object title (e.g. original, alternative)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/core/isSituationOf> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/hasSituation> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/context-description/Circumstance> a owl:Class ;
    rdfs:label "Circumstance"@en,
        "Occasion"@en ;
    rdfs:comment "This class represents a circumstance that influenced a particular situation, e.g. the circumstance for which a cultural property was commissioned, tha circumstance in which a cultural property was used, etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/CircumstanceType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCircumstanceType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isCircumstanceOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/arco/ontology/core/Situation> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: UT/UTU/UTUO - Normativa BDM: UT/UTO; AU/CMM/CMMC - Normativa VeAC: AU/FRU/FRUC - Normativa F: LR/LRO - Normativa BDI: CA" .

<https://w3id.org/arco/ontology/core/hasType> a owl:ObjectProperty .

<https://w3id.org/italia/onto/l0/Object> a owl:Class .

<https://w3id.org/arco/ontology/context-description/Documentation> a owl:Class ;
    rdfs:label "Documentation"@en ;
    dc:description "An example of usage of one of the subclasses of the class 'Documentation' is the following:\\nresource:AudioDocumentation/1200924650-audio-documentation-1\\n        a   cd:AudioDocumentation ;\\n        rdfs:label  \"Audio documentation 1 of cultural property: 1200924650\"@en ;\\n        cd:documentationIdentifier \"New_1401358982589\" ;\\n        cd:hasDocumentationType resource:DocumentationType/cassetta-dat ;\\n        cd:hasFormat resource:Format/cassetta-dat ;\\n        core:hasCategory cd:AttachedDocumentation ."@en,
        "Un esempio d'uso di una delle sottoclassi della classe 'Documentazione' è il seguente:\\nresource:AudioDocumentation/1200924650-audio-documentation-1\\n        a   cd:AudioDocumentation ;\\n        rdfs:label  \"Documentazione audio 1 del bene culturale: 1200924650\"@it ;\\n        cd:documentationIdentifier \"New_1401358982589\" ;\\n        cd:hasDocumentationType resource:DocumentationType/cassetta-dat ;\\n        cd:hasFormat resource:Format/cassetta-dat ;\\n        core:hasCategory cd:AttachedDocumentation ."@en ;
    rdfs:comment "This class represents the documentation, with subclasses for each specific type of documentation (images, drawings, audio, video, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/digitalFilename> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/core/specifications> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Format> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasFormat> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isDocumentationOf> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/DocumentationType> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasDocumentationType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/documentationIdentifier> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://w3id.org/italia/onto/SM/URL> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/rights> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Survey> a owl:Class ;
    rdfs:label "Survey"@en ;
    dc:description "An example of usage of one of the subclasses of the class 'Survey' is the following:\\nresource:ArchaeologicalExcavation/0500590557-survey-1\\n        a           cd:ArchaeologicalExcavation ;\\n        rdfs:label  \"Archaeological excavation 1 of cultural property 0500590557: Monselice, via Valli\"@en ;\\n        cd:hasActivityResponsible resource:Agent/sba ;\\n        cd:hasStratigraphicUnit resource:StratigraphicUnit/325 ;\\n        cd:hasSurveyMethod resource:SurveyMethod/scavo-stratigrafico ;\\n        cd:hasSurveyMotivation resource:SurveyMotivation/opere-pubbliche ; cd:hasSurveyScientificDirector resource:Agent/bianchin-citton-elodia ;\\n        core:hasAgentRole resource:AgentRole/0500590557-archaeological-excavation-1-activity-responsible , resource:AgentRole/0500590557-archaeological-excavation-1-scientific-director ;\\n        tiapit:time \"2004\" ."@en ;
    rdfs:comment "This class represents a survey carried out on a cultural property, that is an activity related to a cultural property and carried out for its identification, study or observation of its technical characteristics."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isSurveyOn> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        <https://w3id.org/italia/onto/l0/Activity> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RE; CM/ISP - ICCD Normative NU, RA, BNB, MA, CA: RS/ALB - ICCD Normativa AT 3.00: IN/INI - ICCD Normativa SM: DR" .

<https://w3id.org/arco/ontology/core/Type> a owl:Class .

<https://w3id.org/arco/ontology/context-description/hasRelatedAgent> a owl:ObjectProperty ;
    rdfs:label "has related agent"@en ;
    rdfs:comment "This property is used to associate an entity of any kind to an agent related to that entity in some way. It is used when it is not possible to express the relation in a more specific way."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/context-description/isAgentRelatedTo> ;
    owl:propertyChainAxiom ( <https://w3id.org/arco/ontology/core/hasAgentRole> <https://w3id.org/arco/ontology/core/hasAgent> ) ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: AU/NMC" .

<https://w3id.org/arco/ontology/context-description/isAgentRelatedTo> a owl:ObjectProperty ;
    rdfs:label "is agent related to"@en ;
    rdfs:comment "This property is used to associate an agent related in some way to an entity of any kind to that entity. It is used when it is not possible to express the relation in a more specific way."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/l0/Agent> a owl:Class .

<http://dati.beniculturali.it/cis/CulturalEntity> a owl:Class .

onto: a owl:Ontology ;
    rdfs:label "Context Description Ontology (ArCo network)"@en ;
    dc:creator "Aldo Gangemi (ISTC-CNR, STLab)",
        "Andrea Nuzzolese (ISTC-CNR, STLab)",
        "Chiara Veninata (MiBACT, ICCD)",
        "Ludovica Marinucci (ISTC-CNR, STLab)",
        "Marialetizia Mancinelli (MiBACT, ICCD)",
        "Valentina Carriero (ISTC-CNR, STLab)",
        "Valentina Presutti (ISTC-CNR, STLab)" ;
    dc:description "The Context Description module includes models for the context of a cultural property, in a broad sense: agents (e.g.: author, collector, copyright holder), objects (e.g.: inventories, bibliography, protective measures, other cultural properties, collections etc.), activities (e.g.: surveys, conservation interventions), situations (e.g.: commission, coin issuance, estimate, legal situation) related, involved or involving the cultural property. Thus it represents attributes that do not result from a measurement of features in a cultural property, but are associated with it."@en ;
    dc:language <http://publications.europa.eu/resource/authority/language/ENG>,
        <http://publications.europa.eu/resource/authority/language/ITA> ;
    dc:title "Context Description Ontology (ArCo network)"@en ;
    dcterms:issued "2018-03-07" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/>,
        <https://w3id.org/italia/controlled-vocabulary/licences/A31_CCBYSA40> ;
    dcterms:modified "2019-06-01" ;
    ns2:reusesPatternAsTemplate <http://mklab.iti.gr/pericles/BornDigitalArchives_ODP.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/classification.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/countingas.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/place.owl#>,
        <http://www.ontologydesignpatterns.org/cp/owl/situation.owl> ;
    rdfs:comment "The Context Description module includes models for the context of a cultural property, in a broad sense: agents (e.g.: author, collector, copyright holder), objects (e.g.: inventories, bibliography, protective measures, other cultural properties, collections etc.), activities (e.g.: surveys, conservation interventions), situations (e.g.: commission, coin issuance, estimate, legal situation) related, involved or involving the cultural property. Thus it represents attributes that do not result from a measurement of features in a cultural property, but are associated with it.\\nIn this module are used as template the following Ontology Design Patterns:\\n- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/countingas.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/classification.owl\\n- http://mklab.iti.gr/pericles/BornDigitalArchives_ODP.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/place.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/situation.owl"@en ;
    owl:imports <https://w3id.org/arco/ontology/catalogue>,
        <https://w3id.org/arco/ontology/core> ;
    owl:versionInfo "Version 1.0"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/context-description/Intervention> <https://w3id.org/arco/ontology/context-description/Research> <https://w3id.org/arco/ontology/context-description/Survey> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/context-description/AcquisitionType> <https://w3id.org/arco/ontology/context-description/AlternativeDatingType> <https://w3id.org/arco/ontology/context-description/AnomalyType> <https://w3id.org/arco/ontology/context-description/ArchaeologicalPropertySurveyType> <https://w3id.org/arco/ontology/context-description/ArchaeometricDiagnosticSurveyType> <https://w3id.org/arco/ontology/context-description/BibliographyType> <https://w3id.org/arco/ontology/context-description/ChangeOfAvailabilityType> <https://w3id.org/arco/ontology/context-description/CircumstanceType> <https://w3id.org/arco/ontology/context-description/DerivatedWorkType> <https://w3id.org/arco/ontology/context-description/DocumentationType> <https://w3id.org/arco/ontology/context-description/ExportImportCertificationType> <https://w3id.org/arco/ontology/context-description/InterventionType> <https://w3id.org/arco/ontology/context-description/LaboratoryTestType> <https://w3id.org/arco/ontology/context-description/ObservationSurveyType> <https://w3id.org/arco/ontology/context-description/ResponsibilityType> <https://w3id.org/arco/ontology/context-description/SurveyImageType> <https://w3id.org/arco/ontology/context-description/TitleType> <https://w3id.org/arco/ontology/context-description/UseType> <https://w3id.org/arco/ontology/context-description/UseTypeSpecification> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/context-description/ArchivalRecordSetMembership> <https://w3id.org/arco/ontology/context-description/CollectionMembership> <https://w3id.org/arco/ontology/context-description/PhotographicSeriesMembership> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/context-description/Format> <https://w3id.org/arco/ontology/context-description/InterpretationCriterion> <https://w3id.org/arco/ontology/context-description/SurveyMotivation> <https://w3id.org/arco/ontology/context-description/Use> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/context-description/BibliographyCategory> <https://w3id.org/arco/ontology/context-description/DocumentationCategory> <https://w3id.org/arco/ontology/context-description/SECIdentifier> <https://w3id.org/arco/ontology/context-description/UserSocialCategory> ) .

[] a owl:AllDisjointClasses ;
