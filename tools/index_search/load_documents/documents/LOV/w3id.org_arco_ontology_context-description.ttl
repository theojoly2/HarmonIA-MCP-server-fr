@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/arco/ontology/catalogue/> .
@prefix ns2: <http://www.ontologydesignpatterns.org/opla/> .
@prefix ns3: <http://ontologydesignpatterns.org/opla/> .
@prefix onto: <https://w3id.org/arco/ontology/context-description> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns3:isNativeTo a owl:AnnotationProperty .

ns3:reusesPatternAsTemplate a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

ns2:reusesPatternAsTemplate a owl:AnnotationProperty .

xsd:date a rdfs:Datatype .

ns1:iccdNormTag a owl:AnnotationProperty .

<https://w3id.org/arco/ontology/context-description/AccompanyingBibliography> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/BibliographyCategory> ;
    rdfs:label "Accompanying bibliography"@en ;
    rdfs:comment "This individual represents the definition relative to the genre of bibliography."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/AerialPhotograph> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/SurveyImageType> ;
    rdfs:label "Aerial photograph"@en .

<https://w3id.org/arco/ontology/context-description/AlternativeTitle> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/TitleType> ;
    rdfs:label "Alternative title"@en ;
    rdfs:comment "Represents subject's alternative title."@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: DA/AID/AIDN" .

<https://w3id.org/arco/ontology/context-description/AnthropicOrigin> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/AnomalyOrigin> ;
    rdfs:label "Anthropic origin"@en .

<https://w3id.org/arco/ontology/context-description/AttachedDocumentation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/DocumentationCategory> ;
    rdfs:label "Attached documentation"@en ;
    rdfs:comment "This individual represents documenation definition included inside catalog."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/AttributedTitle> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/TitleType> ;
    rdfs:label "Attributed title"@en ;
    rdfs:comment "Represents an attributed title of a photograph, that is a title taken from archival, bibliographic, oral or iconographic sources, or created based on picture contents."@en .

<https://w3id.org/arco/ontology/context-description/AudioDocumentation> a owl:Class ;
    rdfs:label "Audio documentation"@en ;
    rdfs:comment "This class represents the audio documentation of an object, e.g. a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasFormat> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/arco/ontology/context-description/DocumentationType> <https://w3id.org/arco/ontology/context-description/Format> ) ] ],
        <https://w3id.org/arco/ontology/context-description/Documentation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/BuildingUse> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseTypeSpecification> ;
    rdfs:label "Building use"@en ;
    rdfs:comment "This individual represents cultural entity  building use specifications."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/CivilCircumstance> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/CircumstanceType> ;
    rdfs:label "Civil circumstance"@en .

<https://w3id.org/arco/ontology/context-description/ComparativeBibliography> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/BibliographyCategory> ;
    rdfs:label "Comparative bibliography"@en ;
    rdfs:comment "This individual represents the definition relative to the kind of bibliography used for comparisons."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/CurrentUse> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseType> ;
    rdfs:label "Current use"@en ;
    rdfs:comment "This individual represents cultural entity current use."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/DecentReliability> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/Reliability> ;
    rdfs:label "Decent reliability"@en .

<https://w3id.org/arco/ontology/context-description/DeliveryConfirmationCertification> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/ExportImportCertificationType> ;
    rdfs:label "Delivery confirmation certification"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/DifferentDating> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/AlternativeDatingType> ;
    rdfs:label "Different dating"@en ;
    rdfs:comment "This individual represents a different type of dating than the one present in cultural entity's chronological information."@en ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: DT/ADT/ADTT."@en .

<https://w3id.org/arco/ontology/context-description/EpigraphicUse> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseTypeSpecification> ;
    rdfs:label "Epigraphic"@en ;
    rdfs:comment "This individual represents cultural entity's epigraphic use."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ExcellentReliability> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/Reliability> ;
    rdfs:label "Excellent reliability"@en .

<https://w3id.org/arco/ontology/context-description/ExistingDocumentation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/DocumentationCategory> ;
    rdfs:label "Existing documentation"@en ;
    rdfs:comment "This individual represents documentation definition that is only mentioned."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ExpiredCopyright> a owl:Class ;
    rdfs:label "Expired Copyright"@en ;
    rdfs:comment "This class represents an expired copyright, related to an object, e.g. a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Copyright> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F 4.00 e OAC: TU/CPR (if CPRD = 'scaduti' or 'diritti scaduti' or 'in pubblico dominio')" .

<https://w3id.org/arco/ontology/context-description/Facsimile> a owl:Class ;
    rdfs:label "Facsimile"@en ;
    rdfs:comment "This class represents a facsimile of a cultural property, and in particular of a photography, that has the same format and technique."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/DerivatedWork> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/FairMarketCircumstance> a owl:Class ;
    rdfs:label "Fair market circumstance"@en ;
    rdfs:comment "This class represents a circumstance related to fairs, markets, festivals."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Circumstance> ;
    owl:disjointWith <https://w3id.org/arco/ontology/context-description/IndeterminateCircumstance> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa BDI 4.00: CA/CAO/CAOF" .

<https://w3id.org/arco/ontology/context-description/FilmDocumentation> a owl:Class ;
    rdfs:label "Video documentation"@en ;
    rdfs:comment "This class represents the film documentation of an object, e.g. a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasFormat> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <https://w3id.org/arco/ontology/context-description/DocumentationType> <https://w3id.org/arco/ontology/context-description/Format> ) ] ],
        <https://w3id.org/arco/ontology/context-description/Documentation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/FinalWork> a owl:Class ;
    rdfs:label "Final work"@en ;
    rdfs:comment "This class represents an entity related to a cultural property, as its final stage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/PreparatoryOrFinalWork> ;
    owl:disjointWith <https://w3id.org/arco/ontology/context-description/PreparatoryWork> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/Forgery> a owl:Class ;
    rdfs:label "Forgery"@en ;
    rdfs:comment "This class represents a forgery of a cultural property, that is a copy of a cultural property for which the author doesn't declare the original author."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/DerivatedWork> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/FreeMovementCertification> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/ExportImportCertificationType> ;
    rdfs:label "Free movement certification"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/GoodReliability> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/Reliability> ;
    rdfs:label "Good reliability"@en .

<https://w3id.org/arco/ontology/context-description/HistoricalUse> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseType> ;
    rdfs:label "Historical use"@en ;
    rdfs:comment "This individual represents cultural enity's historical use."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/HistoricizedTitle> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/TitleType> ;
    rdfs:label "Historicized title"@en .

<https://w3id.org/arco/ontology/context-description/ImportConfirmationCertification> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/ExportImportCertificationType> ;
    rdfs:label "Import confirmation certification"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/InstrumentalUse> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseTypeSpecification> ;
    rdfs:label "Instrumental"@en ;
    rdfs:comment "This individual represents cultural entity instrumental use specifications."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/InsufficientReliability> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/Reliability> ;
    rdfs:label "Insufficient reliability"@en .

<https://w3id.org/arco/ontology/context-description/LineAnomaly> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/AnomalyType> ;
    rdfs:label "Line anomaly"@en .

<https://w3id.org/arco/ontology/context-description/MainTitle> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/TitleType> ;
    rdfs:label "Main title"@en ;
    rdfs:comment "This individual represents publication main title."@en .

<https://w3id.org/arco/ontology/context-description/MultimediaDocumentation> a owl:Class ;
    rdfs:label "Multimedia documentation"@en ;
    rdfs:comment "This class represents the multimedia documentation of an object, e.g. a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Documentation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/NaturalOrigin> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/AnomalyOrigin> ;
    rdfs:label "Natural origin"@en .

<https://w3id.org/arco/ontology/context-description/NoLongerInPublication> a owl:Class ;
    rdfs:label "Print no longer in publication"@en ;
    rdfs:comment "This class represents a print that is no longer was a part of a publication."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Reproduction> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ObsoleteDating> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/AlternativeDatingType> ;
    rdfs:label "Obsolete dating"@en ;
    rdfs:comment "This individual represents an obsolete dating."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/OriginalTitle> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/TitleType> ;
    rdfs:label "Original title"@en .

<https://w3id.org/arco/ontology/context-description/OrnamentalUse> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseTypeSpecification> ;
    rdfs:label "Ornamental"@en ;
    rdfs:comment "This individual represents cultural entity's ornamental use specifications."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/OtherMethodOfDating> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/AlternativeDatingType> ;
    rdfs:label "Other method of dating"@en ;
    rdfs:comment "This individual represents a different type of dating method than the one present in cultural entity's chronological information."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ParallelTitle> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/TitleType> ;
    rdfs:label "Parallel title"@en ;
    rdfs:comment "I represents a parallel title, that is main title translated into other languages and presented as equivalent."@en ;
    ns1:iccdNormTag "Normativa F: SG/SGL/SGLL - Normative S e MI: OG/SGT/SGTR" .

<https://w3id.org/arco/ontology/context-description/PermanentExportLicense> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/ExportImportCertificationType> ;
    rdfs:label "Permanent export license"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/PointAnomaly> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/AnomalyType> ;
    rdfs:label "Point anomaly"@en .

<https://w3id.org/arco/ontology/context-description/PolygonAnomaly> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/AnomalyType> ;
    rdfs:label "Polygon anomaly"@en .

<https://w3id.org/arco/ontology/context-description/PreviousUse> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseType> ;
    rdfs:label "Previous use"@en ;
    rdfs:comment "This individual represents cultural enity's previous use."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/ProperTitle> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/TitleType> ;
    rdfs:label "Proper title"@en ;
    rdfs:comment "It represents the title proper to subject of a print, an engraved matrix or a photograph."@en ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normative S e MI: OG/SGT/SGTP - Normativa F: SFG/SGL/SGLT" .

<https://w3id.org/arco/ontology/context-description/ReligiousCircumstance> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/CircumstanceType> ;
    rdfs:label "Religious circumstance"@en .

<https://w3id.org/arco/ontology/context-description/Reuse> a owl:Class,
        owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseTypeSpecification> ;
    rdfs:label "Reuse"@en ;
    rdfs:comment "This class represents cultural entity's reuse."@en,
        "This class represents the reuse of a cultural property or of one of its parts."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/DerivatedWork> ;
    owl:versionInfo "provvisoria"@en,
        "stable"@en ;
    ns1:iccdNormTag "ICCD Normative RA, SMO, PST,  OAC, OA, MI, NU: RO/REI - ICCD Normative CA, MA: RO/RIU - ICCD Normativa F: ROP/CRF/CRFT = 'reimpiego'" .

<https://w3id.org/arco/ontology/context-description/SameAuthorCopy> a owl:Class ;
    rdfs:label "Same author copy"@en ;
    rdfs:comment "This class represents a copy of a cultural property created by the same author of the original cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/context-description/Copy> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/SatellitePhotograph> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/SurveyImageType> ;
    rdfs:label "Satellite photograph"@en .

<https://w3id.org/arco/ontology/context-description/SecondaryTitle> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/TitleType> ;
    rdfs:label "Secondary title"@en ;
    rdfs:comment "This individual represents publication's secondary title."@en ;
    ns1:iccdNormTag "ICCD Normative VeAC e AT 3.01: DO/BSE/BSEC" .

<https://w3id.org/arco/ontology/context-description/SpecificBibliography> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/BibliographyCategory> ;
    rdfs:label "Specific bibliography"@en ;
    rdfs:comment "This individual represents the definition related to the kind of bibliography that specifically concerns the subject under examination."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/StructuralUse> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseTypeSpecification> ;
    rdfs:label "Structural use"@en ;
    rdfs:comment "This individual represents cultural entity's structural use specifications."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/TemporaryExportLicense> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/ExportImportCertificationType> ;
    rdfs:label "Temporary export license"@en,
        "unstable"@en .

<https://w3id.org/arco/ontology/context-description/TemporaryMovementCertification> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/ExportImportCertificationType> ;
    rdfs:label "Temporary movement certification"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/UncertainOrigin> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/AnomalyOrigin> ;
    rdfs:label "Uncertain origin"@en .

<https://w3id.org/arco/ontology/context-description/UseTypeUnavailable> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/context-description/UseType> ;
    rdfs:label "Use type unavailable"@en ;
    rdfs:comment "This individual represents the lack of available data regarding the type of use of a cultural entity."@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/address> a owl:DatatypeProperty ;
    rdfs:label "address"@en ;
    rdfs:comment "This property represents a specific type of contact at which the agent is available."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/contacts> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/CDG/CDGI" .

<https://w3id.org/arco/ontology/context-description/agentDate> a owl:DatatypeProperty ;
    rdfs:label "agent date"@en ;
    rdfs:comment "This property allows you to associate generic chronological indications to an agent."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/agentLocalIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "agent local identifier"@en ;
    rdfs:comment "This property represents the identification code, which identifies the author's reference unambiguously in the context of a local repertoire, of an agent."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:localIdentifier ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AU/AUT/AUTH - ICCD Normativa F 4.00: RO/CRF/CRFX; PD/PDF/PDFH - ICCD Normativa F 3.00: RO/CRF/CRFH" .

<https://w3id.org/arco/ontology/context-description/alternativeTitle> a owl:DatatypeProperty ;
    rdfs:label "alternative title"@en ;
    rdfs:comment "This property represents an entity's alternative title."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/title> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: DA/AID/AIDN" .

<https://w3id.org/arco/ontology/context-description/attributedTitle> a owl:DatatypeProperty ;
    rdfs:label "attributed title"@en ;
    rdfs:comment "This property represents an attributed title of a photograph, that is a title taken from archival, bibliographic, oral or iconographic sources, or created based on picture contents."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/title> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa F: SG/SGL/SGLA" .

<https://w3id.org/arco/ontology/context-description/authorICCDIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "author ICCD identifier"@en ;
    rdfs:comment "This property allows you to associate the unique ICCD code with an author."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:ICCDIdentifier ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: AU/AUT/AUTK" .

<https://w3id.org/arco/ontology/context-description/bibliographyLocalIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "bibliography local identifier"@en ;
    rdfs:comment "This property represents a numerical or alphanumeric sequence that uniquely identifies the bibliographic reference within a local repertoire."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/context-description/Bibliography> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:localIdentifier ;
    owl:versionInfo "stable"@en ;
