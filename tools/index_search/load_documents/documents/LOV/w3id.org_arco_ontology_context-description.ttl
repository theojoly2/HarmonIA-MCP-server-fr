    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/NVC/NVCD" .

<https://w3id.org/arco/ontology/context-description/openingNoticeDate> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "opening notice date"@en ;
    rdfs:comment "This property represents date of interest declaration communication to the owner or holder."@en ;
