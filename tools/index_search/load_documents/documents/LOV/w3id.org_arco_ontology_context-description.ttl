    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isProponentAgencyOf> a owl:ObjectProperty ;
    rdfs:label "is proponent agency of"@en ;
    rdfs:comment "This property relates an agent that is a proponent agency of a protective measure of a cultural property to the protective measure or to the cultural entity itself. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://dati.beniculturali.it/cis/CulturalEntity> <https://w3id.org/arco/ontology/context-description/ProtectiveMeasure> ) ] ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/isAgentRelatedTo> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: TU/NVC/NVCA" .

<https://w3id.org/arco/ontology/context-description/isRelatedWorkInvolvedIn> a owl:ObjectProperty ;
    rdfs:label "is related work involved in"@en ;
    rdfs:comment "This property relates a work related to a cultural property (e.g.: a preparatory work, a prototype, a copy, a reuse, etc.) to the situation in which that work is related to the cultural property itself."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/context-description/RelatedWorkSituation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/context-description/isReliabilityOf> a owl:ObjectProperty ;
    rdfs:label "is reliability of"@en ;
