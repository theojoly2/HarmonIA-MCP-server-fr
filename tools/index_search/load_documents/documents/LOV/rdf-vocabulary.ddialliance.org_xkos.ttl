@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://purl.org/vocommons/voaf#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <http://rdf-vocabulary.ddialliance.org/xkos> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://rdf-vocabulary.ddialliance.org/xkos#ClassificationLevel> a rdfs:Class,
        owl:Class ;
    rdfs:label "Classification level"@en,
        "Niveau de nomenclature"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf skos:Collection .

<http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation> a rdfs:Class,
        owl:Class ;
    rdfs:label "Concept association"@en,
        "Association de concepts"@fr ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/xkos#Correspondence> a rdfs:Class,
        owl:Class ;
    rdfs:label "Correspondence"@en,
        "Correspondance"@fr ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/xkos#ExplanatoryNote> a rdfs:Class,
        owl:Class ;
    rdfs:label "Explanatory note"@en,
        "Note explicative"@fr ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/xkos#additionalContentNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "additional content"@en,
        "contenu limite"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#inclusionNote> .

<http://rdf-vocabulary.ddialliance.org/xkos#after> a rdf:Property,
        owl:TransitiveProperty ;
    rdfs:label "after"@en,
        "après"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#temporal> .

<http://rdf-vocabulary.ddialliance.org/xkos#before> a rdf:Property,
        owl:TransitiveProperty ;
    rdfs:label "before"@en,
        "avant"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#temporal> .

<http://rdf-vocabulary.ddialliance.org/xkos#belongsTo> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "belongs to"@en,
        "appartient à"@fr ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:isDefinedBy onto: .

<http://rdf-vocabulary.ddialliance.org/xkos#caseLaw> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "case law"@en,
        "jurisprudence"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:note .

<http://rdf-vocabulary.ddialliance.org/xkos#causedBy> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "caused by"@en,
        "est causé par"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#causal> .

<http://rdf-vocabulary.ddialliance.org/xkos#causes> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "causes"@en,
        "est la cause de"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#causal> .

<http://rdf-vocabulary.ddialliance.org/xkos#classifiedUnder> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "classified under"@en,
        "classé sous"@fr ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/xkos#compares> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "compares"@en,
        "compare"@fr ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/xkos#Correspondence> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:ConceptScheme .

<http://rdf-vocabulary.ddialliance.org/xkos#coreContentNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "core content"@en,
        "contenu central"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#inclusionNote> .

<http://rdf-vocabulary.ddialliance.org/xkos#coversExhaustively> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "covers exhaustively"@en,
        "couvre exhaustivement"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#covers> .

<http://rdf-vocabulary.ddialliance.org/xkos#coversMutuallyExclusively> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "covers mutually exclusively"@en,
        "couvre sans recouvrement"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#covers> .

<http://rdf-vocabulary.ddialliance.org/xkos#depth> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "depth"@en,
        "profondeur"@fr ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/xkos#ClassificationLevel> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:positiveInteger .

<http://rdf-vocabulary.ddialliance.org/xkos#disjoint> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "disjoint from"@en,
        "disjoint de"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:related .

<http://rdf-vocabulary.ddialliance.org/xkos#exclusionNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "exclusions"@en,
        "exclusions"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:scopeNote .

<http://rdf-vocabulary.ddialliance.org/xkos#levels> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "level list"@en,
        "liste des niveaux"@fr ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:List .

<http://rdf-vocabulary.ddialliance.org/xkos#madeOf> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "made of"@en,
        "comprend"@fr ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/xkos#Correspondence> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation> .

<http://rdf-vocabulary.ddialliance.org/xkos#maxLength> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "maximum length"@en,
        "longueur maximale"@fr ;
    rdfs:domain <http://www.w3.org/2008/05/skos-xl#Label> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:positiveInteger .

<http://rdf-vocabulary.ddialliance.org/xkos#next> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "next"@en,
        "suivant"@fr ;
    rdfs:comment "successeur immédiat dans la séquence",
        "immediate successor in the sequence"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#succeeds> .

<http://rdf-vocabulary.ddialliance.org/xkos#notationPattern> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "code pattern"@en,
        "gabarit de code"@fr ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/xkos#ClassificationLevel> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://rdf-vocabulary.ddialliance.org/xkos#numberOfLevels> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "number of levels"@en,
        "nombre de niveaux"@fr ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:positiveInteger .

<http://rdf-vocabulary.ddialliance.org/xkos#organizedBy> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "organized by"@en,
        "organisé en"@fr ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/xkos#ClassificationLevel> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/xkos#plainText> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "plain text"@en,
        "texte brut"@fr ;
    rdfs:comment "This property is expected to store plain text literals, without HTML or XML markup."@en ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/xkos#ExplanatoryNote> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdf:PlainLiteral .

<http://rdf-vocabulary.ddialliance.org/xkos#previous> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "previous"@en,
        "précédent"@fr ;
    rdfs:comment "immediate predecessor in the sequence"@en,
        "prédécesseur immédiat dans la séquence"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#precedes> .

<http://rdf-vocabulary.ddialliance.org/xkos#sourceConcept> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "source concept"@en,
        "concept source"@fr ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/xkos#supersedes> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "supersedes"@en,
        "remplace"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#follows> ;
    skos:exactMatch dcterms:replaces .

<http://rdf-vocabulary.ddialliance.org/xkos#targetConcept> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "target concept"@en,
        "concept cible"@fr ;
    rdfs:domain <http://rdf-vocabulary.ddialliance.org/xkos#ConceptAssociation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/xkos#variant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "variant"@en,
        "variante"@fr ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:ConceptScheme .

<http://rdf-vocabulary.ddialliance.org/xkos#follows> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "follows"@en,
        "suit"@fr ;
    rdfs:domain skos:ConceptScheme ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:ConceptScheme .

<http://rdf-vocabulary.ddialliance.org/xkos#generalizes> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "generalizes"@en,
        "généralise"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:narrower ;
    owl:equivalentProperty <http://purl.org/iso25964/skos-thes#narrowerGeneric> ;
    owl:inverseOf <http://rdf-vocabulary.ddialliance.org/xkos#specializes> .

<http://rdf-vocabulary.ddialliance.org/xkos#hasPart> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has part"@en,
        "a pour partie"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:narrower ;
    owl:equivalentProperty <http://purl.org/iso25964/skos-thes#narrowerPartitive> ;
    owl:inverseOf <http://rdf-vocabulary.ddialliance.org/xkos#isPartOf> ;
    skos:exactMatch dcterms:hasPart .

<http://rdf-vocabulary.ddialliance.org/xkos#isPartOf> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "is a part of"@en,
        "est une partie de"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:broader ;
    owl:equivalentProperty <http://purl.org/iso25964/skos-thes#broaderPartitive> ;
    owl:inverseOf <http://rdf-vocabulary.ddialliance.org/xkos#hasPart> ;
    skos:exactMatch dcterms:isPartOf .

<http://rdf-vocabulary.ddialliance.org/xkos#precedes> a rdf:Property,
        owl:TransitiveProperty ;
    rdfs:label "precedes"@en,
        "précède"@fr ;
    rdfs:comment "predecessor in the sequence"@en,
        "prédécesseur dans la séquence"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#sequential> .

<http://rdf-vocabulary.ddialliance.org/xkos#specializes> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "specializes"@en,
        "spécialise"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:broader ;
    owl:equivalentProperty <http://purl.org/iso25964/skos-thes#broaderGeneric> ;
    owl:inverseOf <http://rdf-vocabulary.ddialliance.org/xkos#generalizes> .

<http://rdf-vocabulary.ddialliance.org/xkos#succeeds> a rdf:Property,
        owl:TransitiveProperty ;
    rdfs:label "succeeds"@en,
        "succède à"@fr ;
    rdfs:comment "successeur dans la séquence",
        "successor in the sequence"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#sequential> .

<http://rdf-vocabulary.ddialliance.org/xkos#causal> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has causal"@en,
        "en relation causale"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:related .

<http://rdf-vocabulary.ddialliance.org/xkos#covers> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "covers"@en,
        "couvre"@fr ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( skos:ConceptScheme <http://rdf-vocabulary.ddialliance.org/xkos#ClassificationLevel> ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept .

<http://rdf-vocabulary.ddialliance.org/xkos#inclusionNote> a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "inclusions"@en,
        "inclusions"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:scopeNote .

<http://rdf-vocabulary.ddialliance.org/xkos#temporal> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has temporal"@en,
        "en relation temporelle"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdf-vocabulary.ddialliance.org/xkos#sequential> .

<http://rdf-vocabulary.ddialliance.org/xkos#sequential> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has sequential"@en,
        "en relation séquentielle"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf skos:related .

onto: a ns1:Vocabulary,
        owl:Ontology ;
    ns2:license <http://creativecommons.org/licenses/by/4.0/> ;
    dc:contributor "Daniel Gillman",
        "Jannik Jensen",
        "R.T.A.M. Grim",
        "Richard Cyganiak",
        "Thomas Bosch",
        "Wendy L. Thomas",
        "Yves Jaques" ;
    dc:creator "Franck Cotton" ;
    dc:rights "Copyright © 2016 The DDI Alliance" ;
    dc:title "XKOS: an SKOS extension for representing statistical classifications"@en,
        "XKOS : une extension de SKOS pour la représentation des nomenclatures statistiques"@fr ;
    vann:preferredNamespacePrefix "xkos" ;
    vann:preferredNamespaceUri <http://rdf-vocabulary.ddialliance.org/xkos#> ;
    ns1:classNumber 4 ;
    ns1:extends <http://www.w3.org/2004/02/skos/core> ;
    ns1:propertyNumber 40 ;
    rdfs:comment "This ontology is based on work initiated at Dagstuhl Schloss in September 2011"@en,
        "Cette ontologie est basée sur le travail commencé à Dagstuhl Schloss en septembre 2011"@fr ;
    owl:versionInfo "Version 1.0.1 - 2014-11-26",
        "Version 1.0.2 - 2016-03-15",
        "Version 1.0.3 - 2016-03-15",
        "Version 1.1 - 2016-03-20" .

