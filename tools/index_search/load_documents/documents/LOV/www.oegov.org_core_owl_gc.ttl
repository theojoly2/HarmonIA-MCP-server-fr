owl:Ontology rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:AttributedSource ;
            owl:onProperty ns2:attributedSource ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns1:license ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:License ;
            owl:onProperty ns1:license ] .

ns1:License a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns1:image ] .

ns1:license a owl:ObjectProperty .

ns2:AttributedSource a owl:Class ;
    rdfs:label "Attributed Source"^^xsd:string ;
    rdfs:comment "The name, url and other details of an attribution."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns2:pointOfContact ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns1:attributionURL ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty ns1:attributionName ],
        owl:Thing .

ns2:Category a owl:Class ;
    rdfs:label "Category"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns2:Category ;
            owl:onProperty ns2:subCategory ],
        owl:Thing .

ns2:url a owl:DatatypeProperty ;
    rdfs:label "url"^^xsd:string ;
    rdfs:range xsd:anyURI .

ns2:Quarter a owl:Class ;
    rdfs:label "Quarter"^^xsd:string ;
    rdfs:subClassOf ns2:Period ;
    owl:oneOf ( ns2:Q1 ns2:Q2 ns2:Q3 ns2:Q4 ) .

xsd:date rdfs:subClassOf ns2:DateUnion .

ns2:PoliticalSystem a owl:Class ;
    rdfs:label "Political system"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

ns2:date a owl:DatatypeProperty ;
    rdfs:label "date"^^xsd:string ;
    rdfs:range ns2:DateUnion .

ns2:DateUnion a rdfs:Datatype ;
    rdfs:subClassOf rdfs:Resource .

ns2:DataFormat a owl:Class ;
    rdfs:label "Data Format"^^xsd:string ;
    rdfs:subClassOf ns2:Category .

