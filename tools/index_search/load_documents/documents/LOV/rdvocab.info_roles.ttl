    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/roles/creator> ;
    skos:definition "A jurisdiction enacting a law, regulation, constitution, court rule, etc."@en .

<http://rdvocab.info/roles/engraver> a rdf:Property ;
    rdfs:label "Engraver"@en ;
