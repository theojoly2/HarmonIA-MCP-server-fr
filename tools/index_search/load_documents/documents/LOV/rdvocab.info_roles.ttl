<http://rdvocab.info/roles/composerExpression> a rdf:Property ;
    rdfs:label "Composer (Expression)"@en ;
    ns1:name "composerExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Expression> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/roles/contributor> ;
    skos:definition "A person, family, or corporate body contributing to an expression by composing new music to substitute for the original music, or by composing new music to supplement the existing music."@en .

<http://rdvocab.info/roles/composerOfAdditionalMusic> a rdf:Property ;
    rdfs:label "Composer of Additional Music"@en ;
    ns1:hasSubproperty <http://rdvocab.info/roles/composerOfAdditionalMusicExpression> ;
    ns1:name "composerOfAdditionalMusic"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
    rdfs:isDefinedBy onto: ;
    skos:definition "A person, family, or corporate body contributing to an expression of a musical work by composing accompaniments or additional parts (e.g., vocal/instrumental parts, musical numbers) that supplement the music written by the original composer."@en .

<http://rdvocab.info/roles/composerOfAdditionalMusicExpression> a rdf:Property ;
