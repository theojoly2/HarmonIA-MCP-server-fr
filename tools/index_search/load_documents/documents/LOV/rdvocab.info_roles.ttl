<http://rdvocab.info/roles/illustratorExpression> a rdf:Property ;
    rdfs:label "Illustrator (Expression)"@en ;
    ns1:name "illustratorExpression"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
