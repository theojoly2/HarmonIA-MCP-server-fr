    rdfs:isDefinedBy onto: .

<http://rdvocab.info/roles/directorOfPhotographyWork> a rdf:Property ;
    rdfs:label "Director of photography (Work)"@en ;
    ns1:name "directorOfPhotographyWork"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1002> ;
