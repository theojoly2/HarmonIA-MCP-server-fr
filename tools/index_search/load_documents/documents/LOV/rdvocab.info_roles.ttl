    rdfs:domain <http://rdvocab.info/uri/schema/FRBRentitiesRDA/Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://rdvocab.info/roles/degreeGrantingInstitution> ;
    skos:definition "A corporate body granting an academic degree, based in part on the submission of a thesis, dissertation, etc."@en .

<http://rdvocab.info/roles/depositor> a rdf:Property ;
