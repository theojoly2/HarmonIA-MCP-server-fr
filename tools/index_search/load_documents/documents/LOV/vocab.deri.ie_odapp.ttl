@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/adms#> .
@prefix onto: <http://vocab.deri.ie/odapp> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://vocab.deri.ie/odapp#AppType> a rdfs:Class,
        owl:Class ;
    rdfs:label "application type" ;
    rdfs:comment "describes the type of the application (e.g. mobile app, desktop app, etc...)" .

<http://vocab.deri.ie/odapp#FreeApp> a rdfs:Class,
        owl:Class ;
    rdfs:label "free application" ;
    rdfs:comment "a free application" .

<http://vocab.deri.ie/odapp#PaidApp> a rdfs:Class,
        owl:Class ;
    rdfs:label "paid application" ;
    rdfs:comment "a paid application" .

<http://vocab.deri.ie/odapp#Price> a rdfs:Class,
        owl:Class ;
    rdfs:label "application price" ;
    rdfs:comment "An application price" .

<http://vocab.deri.ie/odapp#DERI%2C%20NUI%20Galway> a dcterms:Agent ;
    foaf:homepage <http://deri.ie/>,
        <http://www.deri.ie/> ;
    foaf:member <http://vocab.deri.ie/odapp#fadmaa>,
        <http://vocab.deri.ie/odapp#gofshu>,
        <http://vocab.deri.ie/odapp#niklou> ;
    foaf:name "DERI, NUI Galway" .

<http://vocab.deri.ie/odapp#appType> a rdf:Property ;
    rdfs:label "application type" ;
    rdfs:range <http://vocab.deri.ie/odapp#AppType> .

<http://vocab.deri.ie/odapp#price> a rdf:Property ;
    rdfs:label "application price" ;
    rdfs:comment "relationship between the admssw:SoftwareRelease and odap:Price" ;
    rdfs:domain <http://vocab.deri.ie/odapp#PaidApp> ;
    rdfs:range <http://vocab.deri.ie/odapp#Price> .

<http://vocab.deri.ie/odapp#rdf> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    ns1:accessURL "http://vocab.deri.ie/odapp.rdf" ;
    ns1:status <http://purl.org/adms/status/Completed> .

<http://vocab.deri.ie/odapp#ttl> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    ns1:accessURL "http://vocab.deri.ie/odapp.ttl" ;
    ns1:status <http://purl.org/adms/status/Completed> .

<http://vocab.deri.ie/odapp#uses> a rdf:Property ;
    rdfs:label "uses dataset" ;
    rdfs:comment "describes a dataset that is used by the application" ;
    rdfs:domain rdfs:Resource .

<http://vocab.deri.ie/odapp#deilee> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "Deirdre Lee" .

<http://vocab.deri.ie/odapp#fadmaa> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:mbox <mailto:fadi.maali@deri.org> ;
    foaf:name "Fadi Maali" .

<http://vocab.deri.ie/odapp#gofshu> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:mbox <mailto:gofran.shukair@deri.org> ;
    foaf:name "Gofran Shukair" .

<http://vocab.deri.ie/odapp#niklou> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "Nikos Loutas" .

onto: a owl:Ontology,
        ns1:SemanticAsset ;
    dc:creator <http://vocab.deri.ie/odapp#deilee>,
        <http://vocab.deri.ie/odapp#fadmaa>,
        <http://vocab.deri.ie/odapp#gofshu>,
        <http://vocab.deri.ie/odapp#niklou> ;
    dcterms:created "2012-07-04"^^xsd:date ;
    dcterms:description "This is an early version of a vocabulary to describe \"open data applications\" i.e. applications built using open data. Examples of such applications are listed on government open data catalogues and participant on open data competitions." ;
    dcterms:modified "2012-07-17"^^xsd:date ;
    dcterms:partOf <http://vocab.deri.ie> ;
    dcterms:publisher "http://vocab.deri.ie/odapp#DERI%2C%20NUI%20Galway" ;
    dcterms:status <http://purl.org/adms/status/UnderDevelopment> ;
    dcterms:title "Open Data Applications Vocabulary" ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:preferredNamespacePrefix "odapp" ;
    vann:preferredNamespaceUri "http://vocab.deri.ie/odapp#" ;
    foaf:homepage onto:.html .

