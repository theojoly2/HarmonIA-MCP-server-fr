@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.loted.eu/ontology> a owl:Ontology .

<http://www.loted.eu/ontology#1-MinistryOrAnyOtherNationalOrFederalAuthority> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#2-ArmedForces> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#3-RegionalOrLocalAuthority> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#4-Utilities> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#5-EuropeanInstitution/AgencyOrInternationalOrganization> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#6-BodyGovernedByPublicLaw> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#7-NotApplicable> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#8-Other> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#AC> a owl:ObjectProperty ;
    rdfs:label "Award criteria"@en,
        "Critères d'attribution"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#AwardCriteria> .

<http://www.loted.eu/ontology#AU> a owl:ObjectProperty ;
    rdfs:label "Authority name"@en,
        "Nom pourvoir adjudicateur"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#CY> a owl:ObjectProperty ;
    rdfs:label "Country"@en,
        "Pays"@fr ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.loted.eu/ontology#Authority> <http://www.loted.eu/ontology#Place> ) ] ;
    rdfs:range <http://www.loted.eu/ontology#Country> .

<http://www.loted.eu/ontology#DR> a owl:DatatypeProperty ;
    rdfs:label "Document received"@en,
        "Document reçu"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#DS> a owl:DatatypeProperty ;
    rdfs:label "Document sent"@en,
        "Document envoyé"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#DT> a owl:DatatypeProperty ;
    rdfs:label "Deadline"@en,
        "Date limite"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#HD> a owl:DatatypeProperty ;
    rdfs:label "Heading"@en,
        "Heading"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#IA> a owl:DatatypeProperty ;
    rdfs:label "Internet address (URL)"@en,
        "Adresse Internet (URL)"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Authority> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#MA> a owl:ObjectProperty ;
    rdfs:label "Main activity"@en,
        "Activité principale"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Authority> ;
    rdfs:range <http://www.loted.eu/ontology#MainActivity> .

<http://www.loted.eu/ontology#N-NationalOrFederalAgency/Office> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#NC> a owl:ObjectProperty ;
    rdfs:label "Contract"@en,
        "Marché"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#Contract> .

<http://www.loted.eu/ontology#ND> a owl:DatatypeProperty ;
    rdfs:label "Document Number"@en,
        "Numéro de document"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#Num> a owl:DatatypeProperty ;
    rdfs:label "OJ S"@en,
        "JO S"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#OfficialJournal> ;
    rdfs:range xsd:integer .

<http://www.loted.eu/ontology#OC> a owl:DatatypeProperty ;
    rdfs:label "Original CPV code"@en,
        "Ancien code CPV"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#OJ> a owl:ObjectProperty ;
    rdfs:label "OJ S"@en,
        "JO S"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#OfficialJournal> .

<http://www.loted.eu/ontology#OL> a owl:ObjectProperty ;
    rdfs:label "Original language"@en,
        "Langue originale"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#Language> .

<http://www.loted.eu/ontology#PC> a owl:DatatypeProperty ;
    rdfs:label "CPV code"@en,
        "Code CPV"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#PD> a owl:DatatypeProperty ;
    rdfs:label "Pubblication date"@en,
        "Date de publication"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#PR> a owl:ObjectProperty ;
    rdfs:label "Procedure"@en,
        "Procédure"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#Procedure> .

<http://www.loted.eu/ontology#R-RegionalOrLocalAgency/Office> a owl:Class ;
    rdfs:subClassOf <http://www.loted.eu/ontology#Authority> .

<http://www.loted.eu/ontology#RP> a owl:ObjectProperty ;
    rdfs:label "Regulation"@en,
        "Organisation"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#Regulation> .

<http://www.loted.eu/ontology#TD> a owl:ObjectProperty ;
    rdfs:label "Document"@en,
        "Document"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#Document> .

<http://www.loted.eu/ontology#TI> a owl:DatatypeProperty ;
    rdfs:label "Title"@en,
        "Titre"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range xsd:string .

<http://www.loted.eu/ontology#TW> a owl:ObjectProperty ;
    rdfs:label "Place"@en,
        "Localité"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#Place> .

<http://www.loted.eu/ontology#TY> a owl:ObjectProperty ;
    rdfs:label "Type of bid"@en,
        "Type de procédure"@fr ;
    rdfs:domain <http://www.loted.eu/ontology#Tender> ;
    rdfs:range <http://www.loted.eu/ontology#TypeOfBid> .

rdfs:label a owl:AnnotationProperty .

<http://www.loted.eu/ontology#AwardCriteria> a owl:Class .

<http://www.loted.eu/ontology#Contract> a owl:Class .

<http://www.loted.eu/ontology#Country> a owl:Class .

<http://www.loted.eu/ontology#Document> a owl:Class .

<http://www.loted.eu/ontology#Language> a owl:Class .

<http://www.loted.eu/ontology#MainActivity> a owl:Class .

<http://www.loted.eu/ontology#Procedure> a owl:Class .

<http://www.loted.eu/ontology#Regulation> a owl:Class .

<http://www.loted.eu/ontology#TypeOfBid> a owl:Class .

<http://www.loted.eu/ontology#OfficialJournal> a owl:Class .

<http://www.loted.eu/ontology#Place> a owl:Class .

<http://www.loted.eu/ontology#Authority> a owl:Class .

<http://www.loted.eu/ontology#Tender> a owl:Class .

