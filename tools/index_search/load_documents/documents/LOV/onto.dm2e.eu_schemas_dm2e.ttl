@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://onto.dm2e.eu/schemas/dm2e> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://onto.dm2e.eu/schemas/dm2e/Collection> a rdfs:Class,
        owl:Class ;
    rdfs:label "Collection" ;
    rdfs:comment "The collection of CHOs as provided by a data provider." .

<http://onto.dm2e.eu/schemas/dm2e/DataResource> a rdfs:Class,
        owl:Class ;
    rdfs:label "DataResource" ;
    rdfs:comment "The dataset that contains the RDF statements provided in via this data resource." ;
    rdfs:subClassOf foaf:Document .

<http://onto.dm2e.eu/schemas/dm2e/Document> a rdfs:Class,
        owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "ProvidedCHO of type document. Unlike foaf:Document, dm2e:Document refers to a physical document." .

<http://onto.dm2e.eu/schemas/dm2e/File> a rdfs:Class,
        owl:Class ;
    rdfs:label "File" ;
    rdfs:comment "Archival Item." .

<http://onto.dm2e.eu/schemas/dm2e/Fragment> a rdfs:Class,
        owl:Class ;
    rdfs:label "Fragment" ;
    rdfs:comment "A physical fragment of a document, e.g. a collection of pages of a manuscript." .

<http://onto.dm2e.eu/schemas/dm2e/Manuscript> a rdfs:Class,
        owl:Class ;
    rdfs:label "Manuscript" ;
    rdfs:comment "ProvidedCHO of type manuscript, e.g. Wittgensteins brown book. Not equivalent to bibo:Manuscript. Not equivalent to bibo:Manuscript." .

<http://onto.dm2e.eu/schemas/dm2e/Page> a rdfs:Class,
        owl:Class ;
    rdfs:label "Page" ;
    rdfs:comment "One side of a sheet of paper. Can be part of another CHO, e.g. dm2e:Manuscript." .

<http://onto.dm2e.eu/schemas/dm2e/Paragraph> a rdfs:Class,
        owl:Class ;
    rdfs:label "Paragraph" ;
    rdfs:comment "ProvidedCHO of type paragraph. Can be part of another (textual) CHO, e.g. dm2e:Manuscript." .

<http://onto.dm2e.eu/schemas/dm2e/Photo> a rdfs:Class,
        owl:Class ;
    rdfs:label "Photo" ;
    rdfs:comment "ProvidedCHO of type photo." ;
    rdfs:subClassOf foaf:Image .

<http://onto.dm2e.eu/schemas/dm2e/Poster> a rdfs:Class,
        owl:Class ;
    rdfs:label "Poster" ;
    rdfs:comment "ProvidedCHO of type poster. Basically any piece of printed paper (often on a large sheet) that can be attached to a wall. dm2e:Poster does also include, but is not restricted to, conference posters." .

<http://onto.dm2e.eu/schemas/dm2e/Work> a rdfs:Class,
        owl:Class ;
    rdfs:label "Work" ;
    rdfs:comment "A non-physical piece of work of an agent, e.g. the theoretical concept of a manuscript." .

<http://onto.dm2e.eu/schemas/dm2e#IBI> a dcterms:Agent ;
    foaf:homepage onto: ;
    foaf:member <http://onto.dm2e.eu/schemas/dm2e#s.hennicke> ;
    foaf:name "IBI" .

<http://onto.dm2e.eu/schemas/dm2e#School%20for%20Library%20and%20Information%20Science> a dcterms:Agent ;
    foaf:homepage <http://www.ibi.hu-berlin.de> ;
    foaf:member <http://onto.dm2e.eu/schemas/dm2e#JIwanowa> ;
    foaf:name "School for Library and Information Science" .

<http://onto.dm2e.eu/schemas/dm2e#rdf> dcterms:FileFormat onto: .

<http://onto.dm2e.eu/schemas/dm2e#ttl> dcterms:FileFormat onto: .

<http://onto.dm2e.eu/schemas/dm2e/artist> a rdf:Property ;
    rdfs:label "artist" ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf dc:creator .

<http://onto.dm2e.eu/schemas/dm2e/callNumber> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "callNumber" ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier .

<http://onto.dm2e.eu/schemas/dm2e/composer> a rdf:Property ;
    rdfs:label "composer" ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf dc:creator .

<http://onto.dm2e.eu/schemas/dm2e/copyist> a rdf:Property ;
    rdfs:label "copyist" ;
    rdfs:range foaf:Person .

<http://onto.dm2e.eu/schemas/dm2e/cover> a rdf:Property ;
    rdfs:label "cover" ;
    rdfs:subPropertyOf dc:description .

<http://onto.dm2e.eu/schemas/dm2e/displayLevel> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "displayLevel" ;
    rdfs:range xsd:boolean .

<http://onto.dm2e.eu/schemas/dm2e/explicit> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "explicit" ;
    rdfs:comment "Final words of a manuscript. A language tag in ISO 639-2 should be added to the Literal." ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://onto.dm2e.eu/schemas/dm2e/genre> a rdf:Property ;
    rdfs:label "genre" ;
    rdfs:subPropertyOf dc:type .

<http://onto.dm2e.eu/schemas/dm2e/hasAnnotatableVersionAt> a rdf:Property ;
    rdfs:label "hasAnnotatableVersionAt" .

<http://onto.dm2e.eu/schemas/dm2e/holdingInstitution> a rdf:Property ;
    rdfs:label "holdingInstitution" ;
    rdfs:range foaf:Organization .

<http://onto.dm2e.eu/schemas/dm2e/honoree> a rdf:Property ;
    rdfs:label "honoree" ;
    rdfs:range foaf:Person .

<http://onto.dm2e.eu/schemas/dm2e/illustration> a rdf:Property ;
    rdfs:label "illustration" ;
    rdfs:comment "Generic description of illustrations in the CHO." ;
    rdfs:subPropertyOf dc:description .

<http://onto.dm2e.eu/schemas/dm2e/incipit> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "incipit" ;
    rdfs:comment "Opening words of a manuscript. A language tag in ISO 639-2 should be added to the Literal." ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://onto.dm2e.eu/schemas/dm2e/levelOfHierarchy> a rdf:Property ;
    rdfs:label "levelOfHierarchy" .

<http://onto.dm2e.eu/schemas/dm2e/modeOfAcquisition> a rdf:Property ;
    rdfs:label "modeOfAcquisition" ;
    rdfs:subPropertyOf dcterms:provenance .

<http://onto.dm2e.eu/schemas/dm2e/owner> a rdf:Property ;
    rdfs:label "owner" .

<http://onto.dm2e.eu/schemas/dm2e/pageDimension> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "page dimension" ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:extent .

<http://onto.dm2e.eu/schemas/dm2e/painter> a rdf:Property ;
    rdfs:label "painter" ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf dc:contributor .

<http://onto.dm2e.eu/schemas/dm2e/portrayed> a rdf:Property ;
    rdfs:label "portrayed" ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf <http://onto.dm2e.eu/schemas/dm2e/mentioned> .

<http://onto.dm2e.eu/schemas/dm2e/previousOwner> a rdf:Property ;
    rdfs:label "previous owner" .

<http://onto.dm2e.eu/schemas/dm2e/principal> a rdf:Property ;
    rdfs:label "principal" .

<http://onto.dm2e.eu/schemas/dm2e/printedAt> a rdf:Property ;
    rdfs:label "printed at" ;
    rdfs:subPropertyOf dcterms:spatial .

<http://onto.dm2e.eu/schemas/dm2e/publishedAt> a rdf:Property ;
    rdfs:label "published at" ;
    rdfs:subPropertyOf dcterms:spatial .

<http://onto.dm2e.eu/schemas/dm2e/refersTo> a rdf:Property ;
    rdfs:label "refers to" ;
    rdfs:subPropertyOf dcterms:references .

<http://onto.dm2e.eu/schemas/dm2e/scopeNote> a rdf:Property ;
    rdfs:label "scopeNote" ;
    rdfs:comment "This property describes the dm2e-specific usage of the resource." .

<http://onto.dm2e.eu/schemas/dm2e/shelfmarkLocation> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "shelfmarkLocation" ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://onto.dm2e.eu/schemas/dm2e/sponsor> a rdf:Property ;
    rdfs:label "sponsor" .

<http://onto.dm2e.eu/schemas/dm2e/subtitle> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "subtitle" ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:title .

<http://onto.dm2e.eu/schemas/dm2e/support> a rdf:Property ;
    rdfs:label "support" ;
    rdfs:subPropertyOf dc:description .

<http://onto.dm2e.eu/schemas/dm2e/watermark> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "watermark" ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://onto.dm2e.eu/schemas/dm2e/writer> a rdf:Property ;
    rdfs:label "writer" ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf dc:creator .

<http://onto.dm2e.eu/schemas/dm2e/writtenAreaDimension> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "written area dimension" ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:extent .

<http://onto.dm2e.eu/schemas/dm2e/writtenAt> a rdf:Property ;
    rdfs:label "written at" ;
    rdfs:subPropertyOf dcterms:spatial .

<http://onto.dm2e.eu/schemas/dm2e#Evelyn> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "Evelyn Dröge" .

<http://onto.dm2e.eu/schemas/dm2e#konstantin> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "Konstantin Baierer" .

<http://onto.dm2e.eu/schemas/dm2e/mentioned> a rdf:Property ;
    rdfs:label "mentioned" .

<http://onto.dm2e.eu/schemas/dm2e#JIwanowa> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "Julia Iwanowa" .

<http://onto.dm2e.eu/schemas/dm2e#s.hennicke> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:name "Steffen Hennicke" .

onto: a owl:Ontology ;
    dc:creator <http://onto.dm2e.eu/schemas/dm2e#Evelyn>,
        <http://onto.dm2e.eu/schemas/dm2e#JIwanowa>,
        <http://onto.dm2e.eu/schemas/dm2e#konstantin>,
        <http://onto.dm2e.eu/schemas/dm2e#s.hennicke> ;
    dcterms:created "2015-01-20"^^xsd:date ;
    dcterms:description "The DM2E model is a specialisation of the Europeana Data Model (EDM) and can be used for the description of manuscripts in the cultural heritage domain." ;
    dcterms:modified "2015-01-20"^^xsd:date ;
    dcterms:partOf <http://onto.dm2e.eu> ;
    dcterms:publisher "http://onto.dm2e.eu/schemas/dm2e#School%20for%20Library%20and%20Information%20Science" ;
    dcterms:status <http://purl.org/adms/status/UnderDevelopment> ;
    dcterms:title "DM2E model" ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:preferredNamespacePrefix "dm2e" ;
    vann:preferredNamespaceUri "http://onto.dm2e.eu/schemas/dm2e/" ;
    foaf:homepage onto:.html .

