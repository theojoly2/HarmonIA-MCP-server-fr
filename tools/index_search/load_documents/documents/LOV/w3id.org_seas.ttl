onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    ns1:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:contributor [ a foaf:Person ;
            foaf:name "Lynda Temal" ],
        [ a foaf:Person ;
            foaf:name "Erkki Siira" ],
        [ a foaf:Person ;
            foaf:name "Gabriel Santos" ],
        [ a foaf:Person ;
            foaf:name "Francisco Silva" ],
        [ a foaf:Person ;
            foaf:name "Hannu JÃ¤rvinen" ],
        [ a foaf:Person ;
            foaf:name "Marc Girod-Genet" ],
        [ a foaf:Person ;
            foaf:name "Takoua Ghariani" ],
        [ a foaf:Person ;
            foaf:name "Antoine Zimmermann" ],
        [ a foaf:Person ;
            foaf:name "Brigida Teixeira" ],
        <http://www.vtt.fi/JarmoKalaoja> ;
    dcterms:creator <http://maxime-lefrancois.info/me#> ;
    dcterms:description "The main SEAS ontology glues together all of the SEAS modules.\\n\\nSEAS ontology modules are organized on top of a core of three main modules:\\n\\n- the [seas:FeatureOfInterestOntology](https://w3id.org/seas/FeatureOfInterestOntology) describes feature of interests and their properties;\\n- the [seas:EvaluationOntology](https://w3id.org/seas/EvaluationOntology) describes evaluations of these properties;\\n- the [seas:SystemOntology](https://w3id.org/seas/SystemOntology) describes virtually isolated systems that share connections with other systems;\\n\\nOn top of the seas:SystemOntology module, various vertical domain ontologies are defined for specific sub classes of systems and why they may be connected:\\n\\n- the [`seas:AreaOntology`](https://w3id.org/seas/AreaOntology) describes Zone systems:\\n    - a zone may be linked by a crossable connection with another zone;\\n    - a zone may be a sub-zone of another zone;\\n    - zones are quantified in terms of area, population, and humidity.\\n- more module descriptions to come soon...\\n\\nWe furthermore encourage the use of the following external ontologies:\\n\\n- [the RDFP Presentation ontology](https://w3id.org/rdfp/) describes how RDF graphs can be validated, interpreted from web resource representations, or serialized as resource representations;\\n- [the Process Execution Platform ontology](https://w3id.org/pep/) generalizes the core of the [SSN](http://www.w3.org/TR/vocab-ssn/) and the [SAN](https://www.irit.fr/recherches/MELODI/ontologies/SAN.owl) ontologies.\\n"@en ;
    dcterms:issued "2016-05-25"^^xsd:date ;
    dcterms:title "SEAS Ontology"@en ;
    vann:preferredNamespacePrefix "seas" ;
    vann:preferredNamespaceUri onto: ;
    owl:imports onto:ArchitectureOntology-2.0,
        onto:BatteryOntology-1.0,
        onto:BooleanPropertyOntology-1.0,
        onto:BuildingOntology-1.0,
        onto:ComfortOntology-1.0,
        onto:ComplexOntology-1.0,
        onto:DeviceOntology-1.0,
        onto:ElectricPowerSystemOntology-1.0,
        onto:ElectricVehicleOntology-1.0,
        onto:EnergyFormOntology-1.0,
        onto:EvaluationOntology-1.0,
        onto:FailableSystemOntology-1.0,
        onto:FeatureOfInterestOntology-1.0,
        onto:FlexibilityOntology-1.0,
        onto:ForecastingOntology-1.0,
        onto:GreenKPIOntology-1.0,
        onto:OfferingOntology-1.0,
        onto:OperatingOntology-1.0,
        onto:OptimizationOntology-1.0,
        onto:PeriodicSignalOntology-1.0,
        onto:PhotovoltaicOntology-1.0,
        onto:PlayerOntology-1.0,
        onto:StatisticsOntology-1.0,
        onto:SystemOntology-1.0,
        onto:ThermodynamicSystemOntology-1.0,
        onto:TimeOntology-1.0,
        onto:TradingOntology-1.0,
        onto:ZoneLightingOntology-1.0,
        onto:ZoneOntology-1.0 ;
    owl:priorVersion onto:seas-0.9 ;
    owl:versionIRI onto:seas-1.0 ;
    owl:versionInfo "v1.0" .

foaf:Person a owl:Class .

