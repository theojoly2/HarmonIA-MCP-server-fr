<https://w3id.org/arco/ontology/arco/ArchaeologicalMaterialCategory> a owl:Class ;
    rdfs:label "Archaeological material category"@en ;
    rdfs:comment "This class represents the category of an archaeological material, that is part of a lot of archaeological materials (e.g.: ceramics, plaster, lithic materials, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isArchaeologicalMaterialCategoryOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/ArchaeologicalMaterial> ],
        <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa TMA: MA/MAC/MACC" .

<https://w3id.org/arco/ontology/arco/CulturalPropertyCollection> a owl:Class ;
    rdfs:label "Cultural Property Collection"@en ;
    rdfs:comment "This class represents a complex cultural property, when it is a series or a set."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/numberOfMembers> ],
        <https://w3id.org/italia/onto/l0/Collection> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/PhotographicHeritageClassificationType> a owl:Class ;
    rdfs:label "Photographic heritage classification type"@en ;
    rdfs:comment "This class represents photographic property's classification type,, according to to other classification systems as Iconclass. The system has to be recognised and used at national or preferably international level."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isPhotographicHeritageClassificationTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/PhotographicHeritageClassification> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: SG/CLF/CLFT" .

<https://w3id.org/arco/ontology/arco/ThematicCategory> a owl:Class ;
    rdfs:label "Thematic category"@en ;
    rdfs:comment "This class represents the thematic category associated to a cartographic classification of a cultural property (e.g.: Architecture)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isThematicCategoryOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CartographicClassification> ],
        <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CT/CTM/CTMC" .

<https://w3id.org/arco/ontology/arco/isRelatedAgencyOf> a owl:ObjectProperty ;
    rdfs:label "is related agency of"@en ;
    rdfs:comment "This property, inverse of \"has related agency\", relates an agency that plays a role related to a cultural property to that cultural property. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    owl:versionInfo "stable"@en .

