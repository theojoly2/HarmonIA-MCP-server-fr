<https://w3id.org/arco/ontology/arco/CulturalPropertyCataloguingCategory> a owl:Class ;
    rdfs:label "Cultural property cataloguing category"@en ;
    rdfs:comment "This class represents a cultural property category based on a subjective evaluation of the cataloguing agent, during the cataloguing process."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isCulturalPropertyCataloguingCategoryOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CulturalProperty> ],
        <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/OGT/OGTV" .

<https://w3id.org/arco/ontology/arco/CulturalPropertyCategory> a owl:Class ;
    rdfs:label "Cultural Property Category"@en ;
    rdfs:comment "This class represents the category of a cultural property, which contains the information that allows us to frame the terminological identification of the properties catalogued in the context of a wider and more complex semantic structure."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/italia/onto/l0/name> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isCulturalPropertyCategoryOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CulturalProperty> ],
        <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/CulturalPropertyInventoryCategory> a owl:Class ;
    rdfs:label "Cultural property inventory category"@en ;
    rdfs:comment "This class represents a category of a numismatic property, related to a classification based on an inventory approved by the specific subject area."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isCulturalPropertyInventoryCategoryOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CulturalProperty> ],
        <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/OGT/OGTS" .

<https://w3id.org/arco/ontology/arco/CulturalPropertyPart> a owl:Class ;
    rdfs:label "Cultural Property Part"@en ;
    rdfs:comment "This class represents a generic part of a cultural property, to which some specific information is referred."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/numberOfCulturalPropertyParts> ],
        <http://dati.beniculturali.it/cis/CulturalEntity> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/NumismaticPropertyCategory> a owl:Class ;
    rdfs:label "Numismatic property classification"@en ;
    rdfs:comment "This class represents a functional category of a numismatic property, referring to a classification related to the function or the commission of the cultural property, according to the most common classifications."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isNumismaticPropertyCategoryOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/NumismaticProperty> ],
        <https://w3id.org/arco/ontology/core/Category> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa NU 4.00: OG/OGT/OGTH" .

<https://w3id.org/arco/ontology/arco/RFId> a owl:Class ;
    rdfs:label "RFId Identifier"@en ;
    rdfs:comment "This class represents the radio-frequency identification (RFID)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isRFIdOf> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/core/note> ] ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: RF/RFI" .

<https://w3id.org/arco/ontology/arco/ReferenceCoinLegend> a owl:Class ;
    rdfs:label "Reference coin legend"@en ;
    rdfs:comment "This class represents the reference coin legend."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isReferenceCoinLegendOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/NumismaticProperty> ],
        <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa NU: OG/OGT/OGTL" .

<https://w3id.org/arco/ontology/arco/hasCulturalPropertyComponent> a owl:ObjectProperty ;
    rdfs:label "has cultural property component"@en ;
    rdfs:comment "This property relates a cultural property to its components."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/ComplexCulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalPropertyComponent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasComponent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isCulturalPropertyComponentOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "OG/OGT/OGTP" .

<https://w3id.org/arco/ontology/arco/hasRelatedAgency> a owl:ObjectProperty ;
    rdfs:label "has related agency"@en ;
    rdfs:comment "This property relates a cultural property to an agency that plays a role related to the cultural property. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isRelatedAgencyOf> ;
    owl:propertyChainAxiom ( <https://w3id.org/arco/ontology/core/hasAgentRole> <https://w3id.org/arco/ontology/core/hasAgent> ) ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/isArchaeologicalMaterialCategoryOf> a owl:ObjectProperty ;
    rdfs:label "is archaeological material category of"@en ;
    rdfs:comment "This is the inverse property of \"has archaeological material category of\"."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/ArchaeologicalMaterialCategory> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/ArchaeologicalMaterial> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isCategoryOf> ;
    owl:versionInfo "stable"@en .

