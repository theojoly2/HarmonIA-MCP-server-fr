@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/arco/ontology/catalogue/> .
@prefix ns2: <http://ontologydesignpatterns.org/opla/> .
@prefix onto: <https://w3id.org/arco/ontology/arco> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://dati.beniculturali.it/cis/GeographicalFeature> a owl:Class .

<http://dati.beniculturali.it/cis/isRelatedToRiT> a owl:ObjectProperty .

ns2:isNativeTo a owl:AnnotationProperty .

ns2:reusesPatternAsTemplate a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

<https://w3id.org/arco/ontology/arco/ArchitecturalOrLandscapeHeritage> a owl:Class ;
    rdfs:label "Architectural or Landscape Heritage"@en ;
    rdfs:comment "This class represents an architectural or landscape heritage. Architecture: monumental complexes, public and religious buildings, noble residences, fortified architectures, private buildings, rural buildings, industrial archeology buildings characterized by particular historical and artistic importance. Historical centers: urban settlement structures older than the municipal territories, characterized by particularly important historical artistic testimonies. Parks and gardens: green spaces of particular historical, artistic and environmental importance. Examples of this type of cultural heritage are gardens and parks annexed to noble properties, vegetable gardens and botanical gardens, urban parks, green areas included in archaeological sites, but also small private gardens, cloisters and courtyards, cemeteries, always if characterized by particular historical and artistic relevance."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/arco/ImmovableCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/DemoEthnoAnthropologicalHeritage> a owl:Class ;
    rdfs:label "Demo-ethno-anthropological Heritage"@en ;
    rdfs:comment "This class represents a demo-ethno-anthropological heritage, both tangible and intangible. The intangible demoetnoanthropological properties are cultural properties consisting of unique and unrepeatable performances, structurally connected to the territory and to socially shared custom, transmitted through orality and bodily techniques, both in Italy and in Europe and beyond Europe (non-verbal communications, dances, parties and ceremonies, games, oral letters, music, customary norms, performances and shows, knowledge, techniques). Demo-ethno-anthropological tangible properties are cultural properties whose construction and/or use are structurally associated with a socially shared custom, transmitted through orality and bodily techniques, both in the Italian and European and extra-European areas (clothing and body ornaments, furnishings and furnishings, means of transport, rituals, instruments and accessories, properties on the territory)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Documentation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasPrimaryDocumentation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Research> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasResearch> ],
        <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/HistoricOrArtisticProperty> a owl:Class ;
    rdfs:label "Historic Or Artistic Property"@en ;
    rdfs:comment "This class represents an historic or artistic property: drawing, printing plate, (contemporary) artworks, print, historic and contemporary garment. Drawings: works done by hand on any support (paper, cardboard, plaster, wood, parchment, stone, silk, table, canvas, etc.) and with special tools (charcoal, chalk, ink, pencil, pastel, pen etc.) and technical specifications (watercolor, blood, etc.). Printing plates: plates of various materials (steel, wood, linoleum, brass, stone, copper zinc, etc.) on which pictorial representations are traced with particular tools (burin, steel or diamond points, punches, scrapers, etc.) and with technical specifications for etching (etching, aquatint, lithography, halftone, screen printing, silica, zincography, etc.). Artworks: movable cultural properties that are integral part of artistic and historical monuments or coming from the dismemberment of the monuments themselves, preserved in collections, museums and art galleries (weapons and armor, civil and religious furnishings, objects for worship, everyday objects, paintings, fabrics and tapestries, walls, etc.). Contemporary artworks: cultural properties representative of the new artistic currents of the centuries XX and XXI (assembly, computer art, installation, environmental installation, audio installation, video installation, interactive multimedia installation, kinetic-visual work, performance, ready-made, virtual reality, video art, etc.). Prints: specimens created through this process: equal copies of pictorial representations on paper, cardboard, leather, parchment, silk, etc. are obtained from a printing plate, with various engraving techniques (etching, aquatint, lithography, zincography, etc.). Historic and contemporary garments: clothes and costumes for men's, women's and children's clothing for civil use, connected to the main intended use and to different occasions of private and social life, according to the historical typologies of the XVIII, XIX and XX centuries (dresses, underwear, hosiery, trousers, shirts, costumes, headphones, skirts, jackets, aprons, liveries, sweaters, cloaks, shawls, scarves, veils, etc.)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Fruition> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasFruition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/numberInCirculation> ],
        <https://w3id.org/arco/ontology/arco/MovableCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/IntangibleCulturalProperty> a owl:Class ;
    rdfs:label "Intangible Cultural Property"@en ;
    rdfs:comment "This class represents an intangible cultural property, that part of cultural heritage represented by ephemeral performances of traditional manifestations, techniques, knowledge (festivals, musical and dance performances, theatrical performances, craft techniques, oral literature, etc.), when they occur and of which it is possible to keep memory only through the audio-visual recording that fixes them permanently, crystallizing them."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    owl:disjointWith <https://w3id.org/arco/ontology/arco/TangibleCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/NaturalHeritage> a owl:Class ;
    rdfs:label "Natural Heritage"@en ;
    rdfs:comment "This class represents a natural heritage, related to botany, mineralogy, paleontology, petrology, planetary science, zoology. Botany: specimens of the plant world from botanical collections (collections of dried plants: herbaria). Mineralogy: specimens of minerals from collections of mineralogy (Augite, Goethite, box of quartz etc.). Paleontology: fossil finds (animals, plants, ichnofossils, samples and microscope preparations, etc.). Petrology: specimens of rocks from collections (Riolite, Trachiandesite etc.). Planetology: meteorites from collections (Aubrite, Ureilite, Eucrite, etc.). Zoology: specimens of the animal world from zoology collections (ustiolo, shrew, mammal, arthropod, butterfly box, elmintological collection, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/arco/MovableCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/archaeologicalSiteIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "archaeological site identifier"@en ;
    rdfs:comment "This property represents the archaeological site identifier."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/ArchaeologicalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa SAS: OG/OGT/OGTI" .

<https://w3id.org/arco/ontology/arco/definitionAndPositionOfComponents> a owl:DatatypeProperty ;
    rdfs:label "definition and position of components"@en ;
    rdfs:comment "This property represents information on definition and position of the components of a complex cultural property."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/ComplexCulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/OGC/OGCD" .

<https://w3id.org/arco/ontology/arco/digitalPhotographNote> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "digital photograph note"@en ;
    rdfs:comment "This property represents notes on a digital photograph."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/PhotographicHeritage> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/note> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: MT/FVC/FVCV" .

<https://w3id.org/arco/ontology/arco/endTime> a owl:DatatypeProperty ;
    rdfs:label "end time"@en ;
    rdfs:comment "This property represents the end time of a time interval, according to different criteria and level of detail (century, century interval, year, yyyy/mm/dd, historical period, etc.)."@en ;
    rdfs:domain <https://w3id.org/italia/onto/TI/TimeInterval> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/TI/time> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/hasAlternativeDiscipline> a owl:ObjectProperty ;
    rdfs:label "has alternative discipline"@en ;
    rdfs:comment "This property relates a cultural property to a related scientific discipline, alternative to the main one."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/SubjectDiscipline> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isAlternativeDisciplineOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa PST: CT/CTA" .

<https://w3id.org/arco/ontology/arco/hasCartographicClassification> a owl:ObjectProperty ;
    rdfs:label "has cartographic classification"@en ;
    rdfs:comment "This property relates a cultural property to its cartographic classification."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CartographicClassification> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasClassification> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isCartographicClassificationOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CT" .

<https://w3id.org/arco/ontology/arco/hasCataloguingAgency> a owl:ObjectProperty ;
    rdfs:label "has cataloguing agency"@en ;
    rdfs:comment "This property relates a cultural property to its cagaloguing agency. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/arco/hasRelatedAgency> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isCataloguingAgencyOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CD/ESC" .

<https://w3id.org/arco/ontology/arco/hasCulturalPropertyCataloguingCategory> a owl:ObjectProperty ;
    rdfs:label "has cultural property cataloguing category"@en ;
    rdfs:comment "This property relates a cultural property to a category based on a subjective evaluation of the cataloguing agent, during the cataloguing process."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalPropertyCataloguingCategory> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCategory> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isCulturalPropertyCataloguingCategoryOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/OGT/OGTV" .

<https://w3id.org/arco/ontology/arco/hasCulturalPropertyCategory> a owl:ObjectProperty ;
    rdfs:label "has cultural property category"@en ;
    rdfs:comment "This property relates a cultural property to its category."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalPropertyCategory> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCategory> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isCulturalPropertyCategoryOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/hasCulturalPropertyInventoryCategory> a owl:ObjectProperty ;
    rdfs:label "has cultural property inventory category"@en ;
    rdfs:comment "This property relates a cultural property to a category based on a classification related to an inventory approved by the specific subject area."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalPropertyInventoryCategory> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCategory> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isCulturalPropertyInventoryCategoryOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/OGT/OGTS" .

<https://w3id.org/arco/ontology/arco/hasHeritageProtectionAgency> a owl:ObjectProperty ;
    rdfs:label "has heritage protection agency"@en ;
    rdfs:comment "This property relates a cultural property to its heritage protection agency. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/arco/hasRelatedAgency> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isHeritageProtectionAgencyOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CD/ECP" .

<https://w3id.org/arco/ontology/arco/hasMainDiscipline> a owl:ObjectProperty ;
    rdfs:label "has main discipline"@en ;
    rdfs:comment "This property relates a cultural property to the main related scientific discipline."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/SubjectDiscipline> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isMainDisciplineOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa PST: CT/CTP" .

<https://w3id.org/arco/ontology/arco/hasMibacScopeOfProtection> a owl:ObjectProperty ;
    rdfs:label "has MiBAC scope of protection"@en ;
    rdfs:comment "This property relates a cultural property to ist MiBAC scope of protection"@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/MibacScopeOfProtection> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isMibacScopeOfProtectionOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/AMB" .

<https://w3id.org/arco/ontology/arco/hasRFId> a owl:ObjectProperty ;
    rdfs:label "has RFId identifier"@en ;
    rdfs:comment "This property relates an object to an RFId."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/RFId> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isRFIdOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/hasReferenceCoinLegend> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has reference coin legend"@en ;
    rdfs:comment "This property relates a numismatic property with its reference coin legend."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/NumismaticProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/ReferenceCoinLegend> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasConcept> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isReferenceCoinLegendOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa NU: OG/OGT/OGTL" .

<https://w3id.org/arco/ontology/arco/internationalIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "international identifier"@en ;
    rdfs:comment "This property represents the international identifier of a scientific or technological heritage. More info can be found at https://www.isin.org/"@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/ScientificOrTechnologicalHeritage> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa PST: AC/ACI" .

<https://w3id.org/arco/ontology/arco/musicalInstrumentNote> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "musical instrument note"@en ;
    rdfs:comment "This property represents notes on a musical instrument."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/MusicHeritage> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/note> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa SM 4.00: AA/AAS" .

<https://w3id.org/arco/ontology/arco/startTime> a owl:DatatypeProperty ;
    rdfs:label "start time"@en ;
    rdfs:comment "This property represents the start time of a time interval, according to different criteria and level of detail (century, century interval, year, yyyy/mm/dd, historical period, etc.)."@en ;
    rdfs:domain <https://w3id.org/italia/onto/TI/TimeInterval> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/TI/time> ;
    owl:versionInfo "stable"@en .

ns1:iccdNormTag a owl:AnnotationProperty .

<https://w3id.org/arco/ontology/denotative-description/TechnicalDetailOccurrence> a owl:Class .

<https://w3id.org/italia/onto/CLV/Feature> a owl:Class .

<https://w3id.org/italia/onto/RO/Role> a owl:Class .

<https://w3id.org/italia/onto/RO/isRoleInTimeOf> a owl:ObjectProperty .

<https://w3id.org/italia/onto/l0/Characteristic> a owl:Class .

<https://w3id.org/italia/onto/l0/Description> a owl:Class .

<https://w3id.org/italia/onto/l0/Topic> a owl:Class .

<https://w3id.org/arco/ontology/arco/AlternativeMusicalInstrumentClassification> a owl:Class ;
    rdfs:label "Alternative musical instrument classification"@en ;
    rdfs:comment "This class represents a classification different from the Hornbostel-Sachs classification."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/taxon> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Bibliography> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasBibliography> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAuthor> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/l0/Agent> ],
        <https://w3id.org/arco/ontology/arco/MusicalInstrumentClassification> ;
    owl:disjointWith <https://w3id.org/arco/ontology/arco/HornbostelSachsClassification> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa SM 4.00: CL/CLA" .

<https://w3id.org/arco/ontology/arco/ArchaeologicalProperty> a owl:Class ;
    rdfs:label "Archaeological Property"@en ;
    rdfs:comment "This class represents an archaeological cultural property, consisting of archaeological complexes, archaeological monuments, anthropological materials, archaeological objects, stratigraphic records, archaeological sites, archaeological materials tables. Archaeological complexes: monumental complexes consisting of several building units (inhabited areas, fortified centers, sanctuaries, thermal complexes, etc.), catalogued regardless of their current conservation status. Archaeological monuments: single building units (a tower, a domus, a temple, etc.) catalogued regardless of their current conservation status. Anthropological materials: biological evidence related to archaeological and paleontological contexts. Archaeological objects: movable properties of archaeological origin (jewelry and jewelry, clothing, furnishings, architectural elements, paintings, archeobotanical and archeozoological objects, sculpture, tools and everyday objects, etc.). Stratigraphic records: stratigraphic sequences found in archaeological excavation contexts. Archaeological sites: portions of territory that preserve archaeological evidence. Archaeological materials tables: lots of archaeological materials."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/SexEstimate> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSexEstimate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Location> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasStratigraphicRoom> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/SampleCollected> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasSampleCollected> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Location> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasStratigraphicSquare> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/FindingContext> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasFindingContext> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/BiologicalTaxonomy> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasBiologicalTaxonomy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/anthropologicalMaterialMorphology> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/AgeOfDeathEstimate> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAgeOfDeathEstimate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Location> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasStratigraphicArea> ],
        <https://w3id.org/arco/ontology/arco/TangibleCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/ArchaeologicalScope> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/arco/MibacScopeOfProtection> ;
    rdfs:label "Archeaological"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/ArchitecturalLandscapeScope> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/arco/MibacScopeOfProtection> ;
    rdfs:label "Architectural or Landscape"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/EthnoAnthropologicalScope> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/arco/MibacScopeOfProtection> ;
    rdfs:label "Ethno-anthropological"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/HSDefinition> a owl:DatatypeProperty ;
    rdfs:label "Hornbostel-Sachs definition"@en ;
    rdfs:comment "This property represents the definition associated to a musical instrument, according to the Hornbostel-Sachs classification."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/HornbostelSachsClassification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa SM 4.00: CL/CHS/CHSD" .

<https://w3id.org/arco/ontology/arco/HSEdition> a owl:DatatypeProperty ;
    rdfs:label "Hornbostel-Sachs edition"@en ;
    rdfs:comment "This property represents the edition Horbonstel-Sachs used for classifying a musical instrument."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/HornbostelSachsClassification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa SM 4.00: CL/CHS/CHSE" .

<https://w3id.org/arco/ontology/arco/HSNumber> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Hornbostel-Sachs number"@en ;
    rdfs:comment "This property represents the numerical code associated to a musical instrument according to a specific edition of the Hornbostel-Sachs classification."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/HornbostelSachsClassification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa SM 4.00: CL/CHS/CHSN" .

<https://w3id.org/arco/ontology/arco/HistoricalArtisticScope> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/arco/MibacScopeOfProtection> ;
    rdfs:label "Historical Artistic"@en ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/ImmovableCulturalProperty> a owl:Class ;
    rdfs:label "Immovable Cultural Property"@en ;
    rdfs:comment "This class represents an immovable cultural property, a property fastened and/or incorporated into the ground (buildings, monumental complexes, territorial areas, etc.) which generally has a significant spatial extent."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/arco/TangibleCulturalProperty> ;
    owl:disjointWith <https://w3id.org/arco/ontology/arco/MovableCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/ScientificOrTechnologicalHeritage> a owl:Class ;
    rdfs:label "Scientific Or Technological Heritage"@en ;
    rdfs:comment "This class represents a scientific and technological heritage, that is instruments of interest to the history of science and technology (astronomical, laboratory, measurement, etc.) relevant to any age and related to specific scientific disciplines (flat-mirror luminaire rotating, apparatus for the colored rings of Newton, bell of Savart, Farina clock, solar clock, pendulum, sextant, telescope, etc.); machines and machinery, means of transport, etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/arco/MovableCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/cartographicSymbolIdentifier> a owl:DatatypeProperty ;
    rdfs:label "cartographic symbol identifier"@en ;
    rdfs:comment "This property represents the identifier associated to the cartographic symbol."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CartographicSymbol> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CT/CTM/CTMS" .

<https://w3id.org/arco/ontology/arco/catalogueNumber> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "catalogue number"@en ;
    rdfs:comment "This property represents the general catalogue number associated to a cultural property described by a catalogue record."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CD/NCT/NCTN" .

<https://w3id.org/arco/ontology/arco/classifiedSubject> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "classified subject"@en ;
    rdfs:comment "This property represents the subject of a photographic heritage as described in a photographic heritage classification other than Iconclass."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/PhotographicHeritageClassification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F 4.00: SG/CLF/CLFS" .

<https://w3id.org/arco/ontology/arco/hasArchaeologicalMaterialCategory> a owl:ObjectProperty ;
    rdfs:label "has archaeological material category"@en ;
    rdfs:comment "This property relates the archaeological material to its category (e.g.: ceramics, plaster, lithic materials, etc.)"@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/ArchaeologicalMaterial> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/ArchaeologicalMaterialCategory> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCategory> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isArchaeologicalMaterialCategoryOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa TMA: MA/MAC/MACC" .

<https://w3id.org/arco/ontology/arco/hasCartographicSymbol> a owl:ObjectProperty ;
    rdfs:label "has cartographic symbol"@en ;
    rdfs:comment "This property relates a cartographic classification of a cultural property to the cartographic symbol related to the theme."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CartographicClassification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CartographicSymbol> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasConcept> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isCartographicSymbolOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CT/CTM/CTMD" .

<https://w3id.org/arco/ontology/arco/hasCartographicTheme> a owl:ObjectProperty ;
    rdfs:label "has cartographic theme"@en ;
    rdfs:comment "This property relates a cartographic classification of a cultural property to the cartographic theme."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CartographicClassification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CartographicTheme> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasConcept> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isCartographicThemeOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CT/CTM/CTMT" .

<https://w3id.org/arco/ontology/arco/hasCulturalPropertyResidual> a owl:ObjectProperty ;
    rdfs:label "has cultural property residual"@en ;
    rdfs:comment "This property relates a cultural property to its residual."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalPropertyResidual> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasPart> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isCulturalPropertyResidualOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "OG/OGT/OGTW" .

<https://w3id.org/arco/ontology/arco/hasMusicalInstrumentClassification> a owl:ObjectProperty ;
    rdfs:label "has musical instrument classification"@en ;
    rdfs:comment "This property connects a cultural entity to a classification through which the instrument can be coded."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/MusicHeritage> ;
    rdfs:isDefinedBy <https://w3id.org/arco/arco/> ;
    rdfs:range <https://w3id.org/arco/ontology/arco/MusicalInstrumentClassification> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasClassification> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isMusicalInstrumentClassificationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/hasNumismaticPropertyCategory> a owl:ObjectProperty ;
    rdfs:label "has numismatic property category"@en ;
    rdfs:comment "This property relates a numismatic property to one of its categories."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/NumismaticProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/NumismaticPropertyCategory> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCategory> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isNumismaticPropertyCategoryOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa NU 4.00: OG/OGT/OGTH" .

<https://w3id.org/arco/ontology/arco/hasPhotographicHeritageClassification> a owl:ObjectProperty ;
    rdfs:label "has photographic heritage classification"@en ;
    rdfs:comment "This property connects a photographic property to a photographic property's classification, according to to other classification systems as Iconclass. The system has to be recognised and used at national or preferably international level."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/PhotographicHeritage> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/PhotographicHeritageClassification> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasClassification> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isPhotographicHeritageClassificationOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F 4.00: SG/CLF" .

<https://w3id.org/arco/ontology/arco/hasPhotographicHeritageClassificationType> a owl:ObjectProperty ;
    rdfs:label "has photographic heritage classification type"@en ;
    rdfs:comment "This property connects a photographic property's classification to the classification type, according to to other classification systems as Iconclass. The system has to be recognised and used at national or preferably international level."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/PhotographicHeritageClassification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/PhotographicHeritageClassificationType> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasType> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isPhotographicHeritageClassificationTypeOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F: SG/CLF/CLFT" .

<https://w3id.org/arco/ontology/arco/hasThematicCategory> a owl:ObjectProperty ;
    rdfs:label "has thematic category"@en ;
    rdfs:comment "This property relates a cartographic classification of a cultural property to the thematic category."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CartographicClassification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/ThematicCategory> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCategory> ;
    owl:inverseOf <https://w3id.org/arco/ontology/arco/isThematicCategoryOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CT/CTM/CTMC" .

<https://w3id.org/arco/ontology/arco/isAlternativeDisciplineOf> a owl:ObjectProperty ;
    rdfs:label "is alternative discipline of"@en ;
    rdfs:comment "This property relates a scientific discipline, alternative to the main one, related to a cultural property to that cultural property."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/SubjectDiscipline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/isCataloguingAgencyOf> a owl:ObjectProperty ;
    rdfs:label "is cataloguing agency of"@en ;
    rdfs:comment "This property relates a cagaloguing agency to the catalogued cultural property. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/arco/isRelatedAgencyOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CD/ESC" .

<https://w3id.org/arco/ontology/arco/isHeritageProtectionAgencyOf> a owl:ObjectProperty ;
    rdfs:label "is heritage protection agency of"@en ;
    rdfs:comment "This property relates an heritage protection agency to the cultural property. The relation is declared in the name of the property, but within the ontology this relation is also modeled, in a more expressive way, through the class AgentRole."@en ;
    rdfs:domain <https://w3id.org/italia/onto/l0/Agent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/arco/isRelatedAgencyOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CD/ECP" .

<https://w3id.org/arco/ontology/arco/isMainDisciplineOf> a owl:ObjectProperty ;
    rdfs:label "is main discipline of"@en ;
    rdfs:comment "This property relates the main scientific discipline related to a cultural property to that cultural property."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/SubjectDiscipline> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/numberOfArchaeologicalMaterials> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number of archeological materials"@en ;
    rdfs:comment "This property represents the total quantity of an archaeological material that is part of a lot of archaeological materials."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/ArchaeologicalMaterial> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/arco/numberOfParts> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa TMA: MA/MAC/MACQ" .

<https://w3id.org/arco/ontology/arco/numberOfComponents> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number of components"@en ;
    rdfs:comment "This property represents the number of components of a complex cultural property."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/ComplexCulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/arco/numberOfParts> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/QNT/QNTN; OG/QNT/QNTI; OG/QNT/QNTS" .

<https://w3id.org/arco/ontology/arco/numberOfCulturalPropertyParts> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number of cultural property part"@en ;
    rdfs:comment "This property represents the number of specimens of the same cultural property part (es.: the number of the teeth of an anthropological material)."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalPropertyPart> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/arco/numberOfParts> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa AT 3.01: EL/ELE/ELEM" .

<https://w3id.org/arco/ontology/arco/numberOfMembers> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number of members"@en ;
    rdfs:comment "This property represents the number of members of a cultural property that is a collection (e.g.: series)"@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalPropertyCollection> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/arco/numberOfParts> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: OG/QNT/QNTN; OG/QNT/QNTI; OG/QNT/QNTS" .

<https://w3id.org/arco/ontology/arco/numberOfResiduals> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number of cultural property residual parts"@en ;
    rdfs:comment "This property represents the number of residuals (only if more than one) of a cultural property."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalPropertyResidual> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/arco/numberOfParts> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "OG/QNT/QNTR" .

<https://w3id.org/arco/ontology/arco/regionIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "region identifier"@en ;
    rdfs:comment "This property represents the \"region identifier\" associated to a cultural property described by a catalogue record."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CD/NCT/NCTN" .

<https://w3id.org/arco/ontology/arco/suffix> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "suffix"@en ;
    rdfs:comment "This property represents the \"suffix\" associated to a cultural property described by a catalogue record."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CD/NCT/NCTS" .

<https://w3id.org/arco/ontology/arco/taxon> a owl:DatatypeProperty ;
    rdfs:label "taxon"@en ;
    rdfs:comment "This property represents the taxon code and the taxon definition associated to the musical instrument, according to a musical instrument classification."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/AlternativeMusicalInstrumentClassification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa SM 4.00: CL/CLA/CLAT" .

<https://w3id.org/arco/ontology/arco/uniqueIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "unique identifier"@en ;
    rdfs:comment "This property represents the unique identifier (derived as the concatenation of the region identifier, the catalogue number and the suffix) of a cultural property describey by a catalogue record."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: concat(CD/NCT/NCTR + CD/NCT/NCTN + CD/NCT/NCTS)" .

