    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/arco/ComplexCulturalProperty> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isPartOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "OG/OGT/OGTP" .

