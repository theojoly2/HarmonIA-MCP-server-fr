<https://w3id.org/arco/ontology/arco/ArchaeologicalMaterial> a owl:Class ;
    rdfs:label "Archaeological material"@en ;
    rdfs:comment "This class represents an archaeological material, that is a part of a lot of archaeological materials."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasArchaeologicalMaterialCategory> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/ArchaeologicalMaterialCategory> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/numberOfArchaeologicalMaterials> ;
            owl:someValuesFrom xsd:integer ],
        <https://w3id.org/arco/ontology/arco/CulturalPropertyPart> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa TMA: MA" .

<https://w3id.org/arco/ontology/arco/CartographicSymbol> a owl:Class ;
    rdfs:label "Cartographic symbol"@en ;
    rdfs:comment "This class represents the symbol used to represent the cultural property on a cartographic base map, referring to the cartographic theme."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/cartographicSymbolIdentifier> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isCartographicSymbolOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CartographicClassification> ],
        <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CT/CTM/CTMD" .

<https://w3id.org/arco/ontology/arco/CartographicTheme> a owl:Class ;
    rdfs:label "Cartographic theme"@en ;
    rdfs:comment "This class represents the cartographic theme associated to a cartographic classification of a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isCartographicThemeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CartographicTheme> ],
        <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CT/CTM/CTMT" .

<https://w3id.org/arco/ontology/arco/CulturalPropertyComponent> a owl:Class ;
    rdfs:label "Cultural Property Component"@en ;
    rdfs:comment "This class represents a component of a complex cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isCulturalPropertyComponentOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/ComplexCulturalProperty> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/positionInComplexCulturalProperty> ],
        <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "OG/OGT/OGTP" .

<https://w3id.org/arco/ontology/arco/CulturalPropertyResidual> a owl:Class ;
    rdfs:label "Cultural Property Residual"@en ;
    rdfs:comment "This class represents the residual part of a cultural property, that is what's left of the original cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isCulturalPropertyResidualOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CulturalProperty> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/numberOfResiduals> ],
        <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "OG/OGT/OGTW" .

<https://w3id.org/arco/ontology/arco/HornbostelSachsClassification> a owl:Class ;
    rdfs:label "Hornbostel-Sachs classification"@en ;
    rdfs:comment "This class represents the Hornbostel-Sachs classification of a musical instrument."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/HSEdition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/HSDefinition> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/HSNumber> ;
            owl:someValuesFrom rdfs:Literal ],
        <https://w3id.org/arco/ontology/arco/MusicalInstrumentClassification> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa SM 4.00: CL/CHS" .

<https://w3id.org/arco/ontology/arco/MusicHeritage> a owl:Class ;
    rdfs:label "Music Heritage"@en ;
    rdfs:comment "This class represents a music heritage. Musical instruments: objects created specifically to produce sounds according to different musical cultures, without space-time limits (instruments and accessories of archaeological, artistic, ethno-anthropological interest). Musical instruments-Organ: an object created to produce sounds, consisting of a series of metal rods, of different shape, length and diameter, in which a quantity of air is introduced, by means of a bellows or other mechanism, regulated by one or more keyboards and a pedal board (accompanied by accessories), characterized by specific morphological-decorative and phonic-instrumental aspects (hydraulic organ, positive organ, portative organ, electronic organ, etc.)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Research> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasResearch> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/Accessory> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasAccessory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/arco/MusicalInstrumentClassification> ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasMusicalInstrumentClassification> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasMusicalEnsemble> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasMusician> ],
        <https://w3id.org/arco/ontology/arco/MovableCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/PhotographicHeritage> a owl:Class ;
    rdfs:label "Photographic Heritage"@en ;
    rdfs:comment "This class represents a photographic heritage. Photographs: negative, positive, photographic processes that give rise to unique products (daguerreotypes, ferrotypes, polaroids, chimigrams, etc.), digital photography; complex elements like albums, folders, photomontages, panoramas, porfolii. Photographic funds: conceptual entities that are characterized by the accumulation of multiple homogeneous or heterogeneous physical units from the point of view of the materials that compose them and which represent in their totality a cultural heritage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/numberInCirculation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/arco/PhotographicHeritageClassification> ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasPhotographicHeritageClassification> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Responsibility> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasResponsibility> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://w3id.org/arco/ontology/context-description/ArchivalRecord> <https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> ) ] ;
            owl:onProperty <https://w3id.org/arco/ontology/core/hasPart> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/PhotographicSeriesMembership> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isMemberOfPhotographicSeries> ],
        <https://w3id.org/arco/ontology/arco/MovableCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/TangibleCulturalProperty> a owl:Class ;
    rdfs:label "Tangible Cultural Property"@en ;
    rdfs:comment "This class represents a tangible cultural property, either immovable or movable."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/ComplexCulturalProperty> a owl:Class ;
    rdfs:label "Complex Cultural Property"@en ;
    rdfs:comment "This class represents a complex cultural property, that consists of different components."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/arco/CulturalProperty> ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/arco/ontology/arco/CulturalPropertyCollection> [ a owl:Restriction ;
                        owl:onProperty <https://w3id.org/arco/ontology/arco/hasCulturalPropertyComponent> ;
                        owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CulturalPropertyComponent> ] ) ] ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/numberOfParts> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "number of parts"@en ;
    rdfs:comment "This property represents the number of parts of an entity."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/MibacScopeOfProtection> a owl:Class ;
    rdfs:label "MiBAC Scope of protection"@en ;
    rdfs:comment "This class represents the MiBAC scope of protection (historical artistic, ethoanthropological, architectural landscape, archaeological) of a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isMibacScopeOfProtectionOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CulturalProperty> ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <https://w3id.org/arco/ontology/arco/ArchaeologicalScope> <https://w3id.org/arco/ontology/arco/ArchitecturalLandscapeScope> <https://w3id.org/arco/ontology/arco/EthnoAnthropologicalScope> <https://w3id.org/arco/ontology/arco/HistoricalArtisticScope> ) ] ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/MusicalInstrumentClassification> a owl:Class ;
    rdfs:label "Musical instrument classification"@en ;
    rdfs:comment "This class represents a classification concerning a musical instrument, concerning the Hornbostel-Sachs classification or possibily other classifications."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isMusicalInstrumentClassificationOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/MusicHeritage> ],
        <https://w3id.org/arco/ontology/core/CulturalEntityClassification> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "Normativa SM 4.00: CL" .

<https://w3id.org/arco/ontology/core/Category> a owl:Class .

<https://w3id.org/arco/ontology/core/hasCategory> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/isCategoryOf> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/arco/MovableCulturalProperty> a owl:Class ;
    rdfs:label "Movable Cultural Property"@en ;
    rdfs:comment "This class represents a movable cultural property, that is, an object or an artefact that can be moved in various ways. Movable cultural properties may be \"immobilized by destination\", i.e. incorporated firmly in the context in which they are located."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/CollectionMembership> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isMemberOfCollection> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Estimate> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasEstimate> ],
        <https://w3id.org/arco/ontology/arco/TangibleCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/NumismaticProperty> a owl:Class ;
    rdfs:label "Numismatic Property"@en ;
    rdfs:comment "This class represents a numismatic property, that is coins and other objects of numismatic interest (premonetal and paramonetal finds, coinage and monetary punches, weights for monetary control, seals and medals), pertinent to any age."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/arco/NumismaticProperty> ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasNumismaticPropertyCategory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/NumismaticSeries> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isCoinMemberOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/CoinIssuance> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCoinIssuance> ],
        <https://w3id.org/arco/ontology/arco/MovableCulturalProperty> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/arco/PhotographicHeritageClassification> a owl:Class ;
    rdfs:label "Photographic heritage classification"@en ;
    rdfs:comment "This class represents a photographic entity's classification accorting to other classification systems as Iconclass. The system has to be recognised and used at national or preferably international level."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isPhotographicHeritageClassificationOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/PhotographicHeritage> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/classifiedSubject> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasPhotographicHeritageClassificationType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/PhotographicHeritageClassificationType> ],
        <https://w3id.org/arco/ontology/core/CulturalEntityClassification> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa F 4.00: SG/CLF" .

<https://w3id.org/italia/onto/l0/identifier> a owl:DatatypeProperty .

<https://w3id.org/italia/onto/l0/Agent> a owl:Class .

<https://w3id.org/arco/ontology/arco/CartographicClassification> a owl:Class ;
    rdfs:label "Cartographic classification"@en ;
    rdfs:comment "This class represents a cartographic classification of a cultural property, referring to the cartographic representation on specific thematic levels, based on a standard or a classification defined by the cataloguing agency."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/isCartographicClassificationOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CulturalProperty> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/arco/ThematicCategory> ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasThematicCategory> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasCartographicTheme> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CartographicTheme> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasCartographicSymbol> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/arco/CartographicSymbol> ],
        <https://w3id.org/arco/ontology/core/CulturalEntityClassification> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: CT" .

<https://w3id.org/arco/ontology/arco/CulturalProperty> a owl:Class ;
    rdfs:label "Cultural Property"@en ;
    rdfs:comment "This class represents a cultural property, both tangible and intangible. A cultural property is the legacy, tangible or intangible, recognised as part of the national cultural heritage, since it helps know and reconstruct the history and the landscape."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/AuthorshipAttribution> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAuthorshipAttribution> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/informationGatheredOnSite> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/IconographicOrDecorativeApparatus> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasIconographicOrDecorativeApparatus> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAvailability> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasCulturalPropertyAvailability> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/catalogueNumber> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/Orientation> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasOrientation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasLocationSubject> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Intervention> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasIntervention> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalEntityTechnicalStatus> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasTechnicalStatus> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/AffixedElement> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasAffixedElement> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:InformationForm ;
            owl:onProperty ns1:isRelatedToInformationForm ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Acquisition> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasAcquisition> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/numberOfComponents> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/arco/CulturalPropertyResidual> ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasCulturalPropertyResidual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:AdditionalForm ;
            owl:onProperty ns1:isRelatedToAdditionalForm ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/location/CadastralIdentity> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasCadastralIdentity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/CollectionMembership> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/isMemberOfCollection> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/LegalSituation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasLegalSituation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/DetectionMethod> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasDetectionMethod> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ExportImportCertification> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasExportImportCertification> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAccessibility> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasCulturalPropertyAccessibility> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/storageConditions> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/UrbanPlanningInstrument> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasUrbanPlanningInstrument> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/DesignationInTime> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasDesignationInTime> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/uniqueIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Survey> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSurvey> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Use> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasUse> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ChangeOfAvailability> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasChangeOfAvailability> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/location/TypeOfContext> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasTypeOfContext> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyType> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasCulturalPropertyType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/rights> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Inventory> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasInventory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/historicalInformation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Commission> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasCommission> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/CLV/Address> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasCulturalPropertyAddress> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/CLV/Geometry> ;
            owl:onProperty <https://w3id.org/italia/onto/CLV/hasGeometry> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/MeasurementCollection> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasMeasurementCollection> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/FunctionalPurpose> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasFunctionalPurpose> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/proposedIntervention> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/arco/CulturalPropertyComponent> ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/hasCulturalPropertyComponent> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/suffix> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasDocumentation> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/context-description/Documentation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasTimeIndexedTypedLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/RelatedWorkSituation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasRelatedWorkSituation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/ProtectiveMeasure> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasProtectiveMeasure> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Subject> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasSubject> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Dating> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasDating> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/subject> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/denotative-description/ConservationStatus> ;
            owl:onProperty <https://w3id.org/arco/ontology/denotative-description/hasConservationStatus> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Title> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasTitle> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/arco/ontology/arco/regionIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/Bibliography> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasBibliography> ],
        <http://dati.beniculturali.it/cis/CulturalEntity> ;
    owl:versionInfo "stable"@en .

onto: a owl:Ontology ;
    rdfs:label "ArCo Ontology (ArCo network)"@en ;
    ns2:reusesPatternAsTemplate <http://www.ontologydesignpatterns.org/cp/owl/classification.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/componency.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/partof.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/situation.owl> ;
    dc:creator "Aldo Gangemi (ISTC-CNR, STLab)",
        "Andrea Nuzzolese (ISTC-CNR, STLab)",
        "Chiara Veninata (MiBAC, ICCD)",
        "Ludovica Marinucci (ISTC-CNR, STLab)",
        "Maria Letizia Mancinelli (MiBAC, ICCD)",
        "Valentina Carriero (ISTC-CNR, STLab)",
        "Valentina Presutti (ISTC-CNR, STLab)" ;
    dc:description "The ArCo module is the root of the network ArCo - Architecture of Knowledge. It imports all the other modules and models top-level distinctions from the cultural heritage domain."@en ;
    dc:language <http://publications.europa.eu/resource/authority/language/ENG>,
        <http://publications.europa.eu/resource/authority/language/ITA> ;
    dc:title "ArCo Ontology (ArCo network)"@en ;
    dcterms:issued "2019-03-05" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/>,
        <https://w3id.org/italia/controlled-vocabulary/licences/A31_CCBYSA40> ;
    dcterms:modified "2019-06-01" ;
    rdfs:comment "The ArCo module is the root of the network ArCo - Architecture of Knowledge. It imports all the other modules and models top-level distinctions from the cultural heritage domain.\\nIn this module are used as template the following Ontology Design Patterns:\\n- http://www.ontologydesignpatterns.org/cp/owl/classification.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/componency.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/partof.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/situation.owl"@en ;
    owl:imports <https://w3id.org/arco/ontology/catalogue>,
        <https://w3id.org/arco/ontology/context-description>,
        <https://w3id.org/arco/ontology/cultural-event>,
        <https://w3id.org/arco/ontology/denotative-description>,
        <https://w3id.org/arco/ontology/location> ;
    owl:versionInfo "Version 1.0"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/arco/CulturalPropertyCollection> <https://w3id.org/arco/ontology/context-description/ArchivalRecordSet> <https://w3id.org/arco/ontology/denotative-description/MeasurementCollection> <https://w3id.org/arco/ontology/denotative-description/SampleCollected> <https://w3id.org/arco/ontology/location/Coordinates> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/context-description/Reliability> <https://w3id.org/arco/ontology/denotative-description/AgeRange> <https://w3id.org/arco/ontology/denotative-description/FontStyle> <https://w3id.org/arco/ontology/denotative-description/Orientation> <https://w3id.org/arco/ontology/location/Altitude> <https://w3id.org/arco/ontology/location/TypeOfContext> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/context-description/CulturalPropertyStage> <https://w3id.org/arco/ontology/denotative-description/CommunicationMedium> <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAccessibility> <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAvailability> <https://w3id.org/arco/ontology/denotative-description/FunctionalPurpose> <https://w3id.org/arco/ontology/denotative-description/Legibility> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/context-description/AnomalyOrigin> <https://w3id.org/arco/ontology/denotative-description/CommunicationMedium> <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAccessibility> <https://w3id.org/arco/ontology/denotative-description/CulturalPropertyAvailability> <https://w3id.org/arco/ontology/denotative-description/FunctionalPurpose> <https://w3id.org/arco/ontology/denotative-description/Legibility> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/context-description/Reliability> <https://w3id.org/arco/ontology/core/CulturalEntityCharacteristic> <https://w3id.org/arco/ontology/denotative-description/AgeRange> <https://w3id.org/arco/ontology/denotative-description/FontStyle> <https://w3id.org/arco/ontology/denotative-description/Orientation> <https://w3id.org/arco/ontology/location/Altitude> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://w3id.org/arco/ontology/arco/CartographicClassification> <https://w3id.org/arco/ontology/arco/MusicalInstrumentClassification> <https://w3id.org/arco/ontology/arco/PhotographicHeritageClassification> ) .

