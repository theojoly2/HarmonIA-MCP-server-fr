onto:Freezer a owl:Class ;
    rdfs:label "Freezer"@en ;
    ns1:category <http://purl.org/opdm/category/google#Home_and_Garden_Kitchen_and_Dining_KitchenAppliances_Freezers> ;
    rdfs:comment "A generic dedicated Freezer (with no Fridge unit) as a product type"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:FridgeFreezer ;
    foaf:depiction <http://upload.wikimedia.org/wikipedia/commons/2/21/2011-05-09_14-56-45_407.jpg> .

onto:FrenchDoor a onto:StyleOfUnit ;
    rdfs:label "FrenchDoor"@en ;
    rdfs:comment "It represents a french-door type of fridge."@en ;
    rdfs:isDefinedBy onto: .

onto:Fridge a owl:Class ;
    rdfs:label "Fridge"@en ;
    ns1:category <http://purl.org/opdm/category/google#Home_and_Garden_Kitchen_and_Dining_KitchenAppliances_Refrigerators> ;
    rdfs:comment "A generic Fridge with no Freezer unit as a product type"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:FridgeFreezer ;
    skos:altLabel "Refrigerator"@en ;
    foaf:depiction <http://upload.wikimedia.org/wikipedia/commons/2/21/2011-05-09_14-56-45_407.jpg> .

