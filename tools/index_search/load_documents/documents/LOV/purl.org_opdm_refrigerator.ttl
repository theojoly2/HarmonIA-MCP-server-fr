onto:antibacterial a owl:DatatypeProperty ;
    rdfs:label "Antibacterial"@en ;
    ns1:isConfiguredBy [ a ns1:MetadataContainer ;
            ns1:attributePosition 0 ;
            ns1:exampleOfUsage "The value of this property is a boolean (true/false - xsd:boolean)."^^xsd:string ;
            ns1:inProfile ns1:DefaultProfile ;
            ns1:priority 0 ;
            ns1:rankingDirection "DESC"^^xsd:string ],
        [ a ns1:MetadataContainer ;
            ns1:attributePosition 0 ;
            ns1:exampleOfUsage "The value of this property is a boolean (true/false - xsd:boolean)."^^xsd:string ;
            ns1:inProfile ns1:DefaultProfile ;
            ns1:priority 0 ;
            ns1:rankingDirection "DESC"^^xsd:string ] ;
    ns1:maxCardinality "1"^^xsd:string ;
    ns1:minCardinality "0"^^xsd:string ;
    rdfs:comment "This property specifies whether the fridge/freezer is equipped with an antibacterial detector system or not."@en ;
    rdfs:domain onto:FridgeFreezer ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:datatypeProductOrServiceProperty .

onto:capableOfACS a owl:DatatypeProperty ;
    rdfs:label "Capable of ACS"@en ;
    ns1:isConfiguredBy [ a ns1:MetadataContainer ;
            ns1:attributePosition 0 ;
            ns1:exampleOfUsage "The value of this property is a boolean (true/false - xsd:boolean)."^^xsd:string ;
            ns1:inProfile ns1:DefaultProfile ;
            ns1:priority 0 ;
            ns1:rankingDirection "DESC"^^xsd:string ],
        [ a ns1:MetadataContainer ;
            ns1:attributePosition 0 ;
            ns1:exampleOfUsage "The value of this property is a boolean (true/false - xsd:boolean)."^^xsd:string ;
            ns1:inProfile ns1:DefaultProfile ;
            ns1:priority 0 ;
            ns1:rankingDirection "DESC"^^xsd:string ] ;
    ns1:maxCardinality "1"^^xsd:string ;
    ns1:minCardinality "0"^^xsd:string ;
    rdfs:comment "This property specifies whether the fridge/freezer is equipped with an Advanced Control System (ACS) or not. ACS allows the fridge/freezer to maintain the desired internal temperature safe from variations in the external termperature."@en ;
    rdfs:domain onto:FridgeFreezer ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf ns2:datatypeProductOrServiceProperty .

