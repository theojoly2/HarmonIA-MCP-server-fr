@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/opdm/utility#> .
@prefix ns2: <http://purl.org/goodrelations/v1#> .
