onto:consumptionOfEnergy a owl:ObjectProperty ;
    rdfs:label "Consumption of energy"@en ;
    ns1:isConfiguredBy [ a ns1:MetadataContainer ;
            ns1:attributePosition 0 ;
            ns1:exampleOfUsage "The value of this property is an individual of the gr:QuantitativeValue class."^^xsd:string ;
            ns1:inProfile ns1:DefaultProfile ;
            ns1:priority 0 ;
            ns1:rankingDirection "DESC"^^xsd:string ],
        [ a ns1:MetadataContainer ;
            ns1:attributePosition 0 ;
            ns1:exampleOfUsage "The value of this property is an individual of the gr:QuantitativeValue class."^^xsd:string ;
            ns1:inProfile ns1:DefaultProfile ;
            ns1:priority 0 ;
            ns1:rankingDirection "DESC"^^xsd:string ] ;
    ns1:maxCardinality "1"^^xsd:string ;
    ns1:minCardinality "0"^^xsd:string ;
    ns1:recommendedRangeOfMeasure [ a ns2:QuantitativeValue ;
            ns2:hasMaxValue 0 ;
            ns2:hasMinValue 0 ],
        [ a ns2:QuantitativeValue ;
            ns2:hasMaxValue 0 ;
            ns2:hasMinValue 0 ] ;
    ns1:recommendedUnitOfMeasure "KWH"^^xsd:string ;
    rdfs:comment "The consumption of energy of the fridge/freezer in kilowatt hour (in a year) - UN/CEFACT common code: KWH."@en ;
    rdfs:domain onto:FridgeFreezer ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns2:QuantitativeValue ;
    rdfs:subPropertyOf ns2:quantitativeProductOrServiceProperty .

