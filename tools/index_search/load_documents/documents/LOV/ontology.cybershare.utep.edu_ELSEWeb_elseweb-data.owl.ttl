@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://semanticscience.org/resource/> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix ns3: <http://protege.stanford.edu/plugins/owl/protege#> .
@prefix ns4: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#> .
@prefix onto: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns4:ComplexDerivedUnit a owl:Class ;
    rdfs:label "complexed derived unit"^^xsd:string ;
    rdfs:comment "A unit that is calculated from defined operations."^^xsd:string ;
    rdfs:subClassOf ns4:Unit .

ns4:GeoTIFF a ns4:PayloadFormat,
        owl:NamedIndividual .

ns4:NamedGeographicRegion a owl:Class ;
    rdfs:label "named geographic region"^^xsd:string ;
    ns1:example "North America, Great Lakes, Indonesia"^^xsd:string ;
    rdfs:comment "A geographic region specified by a name."^^xsd:string ;
    rdfs:subClassOf ns4:GeographicRegion .

ns4:WCSDataset a owl:Class ;
    rdfs:label "wcs raster dataset"^^xsd:string ;
    rdfs:comment "A WCS raster dataset is composed by all possible datasets provided by a WCS service manifestation depending on the parameters set in a service call. "^^xsd:string ;
    rdfs:subClassOf ns4:RasterDataset ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:hasManifestation ;
            owl:someValuesFrom ns4:WCSManifestation ] .

ns4:WCSResponse a owl:Class ;
    rdfs:label "wcs raster response"^^xsd:string ;
    rdfs:comment "A specific raster dataset returned by calling a WCS service with specific parameters."^^xsd:string ;
    rdfs:subClassOf ns4:RasterDataset ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:hasManifestation ;
            owl:someValuesFrom ns4:WCSResponseManifestation ] .

ns4:WFSDataset a owl:Class ;
    rdfs:label "wfs vector dataset"^^xsd:string ;
    ns1:comment "A WFS vector dataset is composed by all possible datasets provided by a WFS service manifestation depending on the parameters set in a service call. "^^xsd:string ;
    rdfs:subClassOf ns4:VectorDataset ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:hasManifestation ;
            owl:someValuesFrom ns4:WFSManifestation ] .

ns4:WFSResponse a owl:Class ;
    rdfs:label "wfs vector response"^^xsd:string ;
    ns1:comment "A specific vector dataset returned by calling a WFS service with specific parameters."^^xsd:string ;
    rdfs:subClassOf ns4:VectorDataset ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:hasManifestation ;
            owl:someValuesFrom ns4:WFSResponseManifestation ] .

ns4:esri-grid a ns4:PayloadFormat,
        owl:NamedIndividual .

ns4:esri-shapefile a ns4:PayloadFormat,
        owl:NamedIndividual .

ns4:hdf5 a ns4:PayloadFormat,
        owl:NamedIndividual .

ns4:tiff-container a owl:NamedIndividual ;
    ns4:hasPayloadFormat <http://provenanceweb.org/format/mime/image/tiff> .

<http://provenanceweb.org/format/mime/image/gif> a ns4:PayloadFormat,
        owl:NamedIndividual .

<http://provenanceweb.org/format/mime/image/jpeg> a ns4:PayloadFormat,
        owl:NamedIndividual .

<http://provenanceweb.org/format/mime/image/png> a ns4:PayloadFormat,
        owl:NamedIndividual .

<http://provenanceweb.org/format/mime/image/vnd.wap.wbmp> a ns4:PayloadFormat,
        owl:NamedIndividual .

<http://provenanceweb.org/format/mime/text/csv> a ns4:PayloadFormat,
        owl:NamedIndividual .

<http://provenanceweb.org/format/mime/text/xml> a ns4:MetadataFormat,
        owl:NamedIndividual .

ns1:comment a owl:AnnotationProperty .

ns1:example a owl:AnnotationProperty .

ns4:Duration a owl:Class ;
    rdfs:label "duration"^^xsd:string ;
    rdfs:comment "Time period defined by a start and end time."^^xsd:string ;
    rdfs:subClassOf ns4:TimePeriod .

ns4:Instant a owl:Class ;
    rdfs:label "instant"^^xsd:string ;
    ns1:comment "A time period with the same start and end time."^^xsd:string ;
    rdfs:subClassOf ns4:TimePeriod .

ns4:MetadataFormat a owl:Class ;
    rdfs:label "metadata format"^^xsd:string ;
    ns1:example "XML, RDF."^^xsd:string ;
    rdfs:comment "Describes the format of the metadata included in a file."^^xsd:string ;
    rdfs:subClassOf ns4:Format .

ns4:ServiceManifestation a owl:Class ;
    rdfs:label "service manifestation"^^xsd:string ;
    rdfs:comment "A service manifestation provides the information required to execute a service over the web. In particular, a service that will return a dataset."^^xsd:string ;
    rdfs:subClassOf ns4:DatasetManifestation .

ns4:Theme a owl:Class ;
    rdfs:label "theme"^^xsd:string ;
    ns1:example "vegetation"^^xsd:string ;
    rdfs:comment "Metadata describing the information captured in a dataset."^^xsd:string .

ns4:WCSManifestation a owl:Class ;
    rdfs:label "wcs service manifestation"^^xsd:string ;
    rdfs:comment "A WCS service, located in a specific URL, that will return a dataset."^^xsd:string ;
    rdfs:subClassOf ns4:OGCServiceManifestation .

ns4:WCSResponseManifestation a owl:Class ;
    rdfs:label "wcs response manifestation"^^xsd:string ;
    ns1:example "A WCS service, in a described URL, will return a MODIS dataset encoded in a specific format."^^xsd:string ;
    rdfs:comment "Provides information about the file that is returned by a Web coverage service, including the format."^^xsd:string ;
    rdfs:subClassOf ns4:OGCResponseManifestation .

ns4:WFSManifestation a owl:Class ;
    rdfs:label "wfs service manifestation"^^xsd:string ;
    rdfs:comment "A WCS service, located in a specific URL, that will return a dataset."^^xsd:string ;
    rdfs:subClassOf ns4:OGCServiceManifestation .

ns4:WFSResponseManifestation a owl:Class ;
    rdfs:label "wfs response manifestation"^^xsd:string ;
    ns1:example "A MODIS dataset, encoded in a specific format, and returned by a WFS service."^^xsd:string ;
    rdfs:comment "Provides information about the file that is returned by a Web coverage service, including the format."^^xsd:string ;
    rdfs:subClassOf ns4:OGCResponseManifestation .

ns4:capturesCharacteristic a owl:ObjectProperty ;
    rdfs:label "captures characteristic" ;
    rdfs:domain ns4:DataBand ;
    rdfs:range ns4:Characteristic .

ns4:containsFeatureSet a owl:ObjectProperty ;
    rdfs:label "contains feature set" ;
    rdfs:domain ns4:Layer ;
    rdfs:range ns4:FeatureSet .

ns4:coversRegion a owl:ObjectProperty ;
    rdfs:label "covers region" ;
    rdfs:domain ns4:GeospatialDataset ;
    rdfs:range ns4:GeographicRegion .

ns4:coversTimePeriod a owl:ObjectProperty ;
    rdfs:label "covers time period" ;
    rdfs:domain ns4:GeospatialDataset ;
    rdfs:range ns4:TimePeriod .

ns4:hasBandIdentification a owl:ObjectProperty ;
    rdfs:label "has band identification" ;
    rdfs:domain ns4:Band ;
    rdfs:range ns4:BandIdentification .

ns4:hasBandName a owl:DatatypeProperty ;
    rdfs:label "has band name" ;
    rdfs:domain ns4:BandIdentification ;
    rdfs:range rdfs:Literal .

ns4:hasCapabilitiesDocumentURL a owl:DatatypeProperty ;
    rdfs:label "has capabilities document url" ;
    rdfs:domain ns4:OGCServiceManifestation ;
    rdfs:range rdfs:Literal .

ns4:hasDataBand a owl:ObjectProperty ;
    rdfs:label "has data band" ;
    rdfs:domain ns4:RasterDataset ;
    rdfs:range ns4:DataBand .

ns4:hasDateTime a owl:DatatypeProperty ;
    rdfs:label "has date time" ;
    rdfs:domain ns4:Date ;
    rdfs:range xsd:dateTime .

ns4:hasEPSGCode a owl:DatatypeProperty ;
    rdfs:label "has epsg code" ;
    rdfs:domain ns4:Projection ;
    rdfs:range xsd:int .

ns4:hasEndDate a owl:ObjectProperty ;
    rdfs:label "has end date" ;
    rdfs:domain ns4:DateRange ;
    rdfs:range ns4:Date ;
    rdfs:subPropertyOf ns4:hasDate .

ns4:hasFileDownloadURL a owl:DatatypeProperty ;
    rdfs:label "has file download url" ;
    rdfs:domain ns4:FileManifestation ;
    rdfs:range rdfs:Literal .

ns4:hasGeospatialProjection a owl:ObjectProperty ;
    rdfs:label "has geospatial projection" ;
    rdfs:domain ns4:GeospatialDataset ;
    rdfs:range ns4:Projection .

ns4:hasLandingPageURL a owl:DatatypeProperty ;
    rdfs:label "has landing page url" ;
    rdfs:domain ns4:FileManifestation ;
    rdfs:range rdfs:Literal .

ns4:hasLayer a owl:ObjectProperty ;
    rdfs:label "has layer" ;
    rdfs:domain ns4:VectorDataset ;
    rdfs:range ns4:Layer .

ns4:hasLeftLongitude a owl:DatatypeProperty ;
    rdfs:label "has left longitude" ;
    rdfs:domain ns4:BoxedGeographicRegion ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf ns4:hasLatitude .

ns4:hasLowerLatitude a owl:DatatypeProperty ;
    rdfs:label "has lower latitude" ;
    rdfs:domain ns4:BoxedGeographicRegion ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf ns4:hasLongitude .

ns4:hasMaximumValue a owl:DatatypeProperty ;
    rdfs:label "has maximum value" ;
    rdfs:domain ns4:DataBand ;
    rdfs:range xsd:double .

ns4:hasMinimumValue a owl:DatatypeProperty ;
    rdfs:label "has minimum value" ;
    rdfs:domain ns4:DataBand ;
    rdfs:range xsd:double .

ns4:hasNoDataValue a owl:DatatypeProperty ;
    rdfs:label "has no data value" ;
    rdfs:domain ns4:DataBand ;
    rdfs:range xsd:double .

ns4:hasPayloadFormat a owl:ObjectProperty ;
    rdfs:label "has payload format" ;
    rdfs:domain ns4:ContainerFormat ;
    rdfs:range ns4:PayloadFormat .

ns4:hasResolution a owl:DatatypeProperty ;
    rdfs:label "has resolution" ;
    rdfs:domain ns4:DataBand ;
    rdfs:range xsd:double .

ns4:hasRightLongitude a owl:DatatypeProperty ;
    rdfs:label "has right longitude" ;
    rdfs:domain ns4:BoxedGeographicRegion ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf ns4:hasLatitude .

ns4:hasStartDate a owl:ObjectProperty ;
    rdfs:label "has start date" ;
    rdfs:domain ns4:DateRange ;
    rdfs:range ns4:Date ;
    rdfs:subPropertyOf ns4:hasDate .

ns4:hasTheme a owl:ObjectProperty ;
    rdfs:label "has theme" ;
    rdfs:domain ns4:GeospatialDataset .

ns4:hasUnits a owl:ObjectProperty ;
    rdfs:label "has units" ;
    rdfs:domain ns4:DataBand ;
    rdfs:range ns4:Unit .

ns4:hasUpperLatitude a owl:DatatypeProperty ;
    rdfs:label "has upper latitude" ;
    rdfs:domain ns4:BoxedGeographicRegion ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf ns4:hasLongitude .

<http://provenanceweb.org/format/mime/image/tiff> a ns4:PayloadFormat,
        owl:NamedIndividual .

onto: a owl:Ontology ;
    ns2:license "http://creativecommons.org/licenses/by/3.0/"^^xsd:anyURI ;
    ns3:defaultLanguage "en" ;
    dc:contributor "Contributors are those that engage in discussions during the development of this ontology (in alphabetical order):\\nkarl benedict\\nluis garnica\\ncj grady\\nbill hudspeth\\ndeana pennington\\nsoren scott\\naimee stewart"^^xsd:string ;
    dc:creator "http://cybershare.utep.edu"^^xsd:anyURI,
        "ELSEWeb team"@en,
        "Natalia Villanueva-Rosales"@en,
        "Nicholas del Rio"@en ;
    dc:description "The ELSEWeb Data ontology provides simple classes for describing datasets. This project provides foundational support for the ELSEWeb project(http://elseweb.cybershare.utep.edu/).\\nwebsite: http://elseweb.cybershare.utep.edu/ontologies\\nemail: nvillanuevarosales@utep.edu\\n"@en ;
    dc:issued "2014-05-01"^^xsd:date ;
    dc:rights "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/3.0/]."^^xsd:string ;
    dc:title "ELSEWeb Data Ontology"@en ;
    dcterms:identifier "elseweb-data.owl" ;
    dcterms:modified "2015-09-24"^^xsd:date ;
    vann:preferredNamespacePrefix "elseweb-data"@en ;
    vann:preferredNamespaceUri "http://ontology.cybershare.utep.edu/ELSEWeb/"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:versionIRI onto: ;
    owl:versionInfo "1.2"^^xsd:string .

ns4:Band a owl:Class ;
    rdfs:label "band"^^xsd:string ;
    ns1:example "A satellite image composed of more than one measured value at different wavelengths of the electromagnetic spectrum for each pixel in the image."^^xsd:string ;
    rdfs:comment "A band is one component of a multi-characteristic dataset."^^xsd:string ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:hasBandIdentification ;
            owl:someValuesFrom ns4:BandIdentification ] .

ns4:Characteristic a owl:Class ;
    rdfs:label "characteristic"^^xsd:string ;
    ns1:comment "A characteristic, following OBOE guidelines,  represents a property of an entity that can be measured. "^^xsd:string ;
    ns1:example "Temperature of air."^^xsd:string .

ns4:ContainerFormat a owl:Class ;
    rdfs:label "container format"^^xsd:string ;
    rdfs:comment "Describes how the data and metadata are included in a file."^^xsd:string ;
    rdfs:subClassOf ns4:Format ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass ns4:PayloadFormat ;
            owl:onProperty ns4:hasPayloadFormat ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ns4:FeatureSet a owl:Class ;
    rdfs:label "feature set"^^xsd:string ;
    rdfs:comment "A set of geometric features or characteristics observed from an entity. This class is equivalent to the notion of an ArcGIS feature"^^xsd:string ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:representsEntity ;
            owl:someValuesFrom ns4:Entity ] .

ns4:OGCResponseManifestation a owl:Class ;
    rdfs:label "ogc response manifestation"^^xsd:string ;
    rdfs:comment "Provides information about a file that is returned from a web service using OGC standards, including the container format."^^xsd:string ;
    rdfs:subClassOf ns4:FileManifestation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass ns4:ContainerFormat ;
            owl:onProperty ns4:encodedInFormat ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ns4:encodedInFormat a owl:ObjectProperty ;
    rdfs:label "enconded in format" ;
    rdfs:domain ns4:DatasetManifestation ;
    rdfs:range ns4:Format .

ns4:hasDate a owl:ObjectProperty ;
    rdfs:label "has date" .

ns4:hasLatitude a owl:DatatypeProperty ;
    rdfs:label "has latitude" .

ns4:hasLongitude a owl:DatatypeProperty ;
    rdfs:label "has longitude" .

ns4:representsEntity a owl:ObjectProperty ;
    rdfs:label "represents entity" ;
    rdfs:domain ns4:DataBand ;
    rdfs:range ns4:Entity .

ns4:BandIdentification a owl:Class ;
    rdfs:label "band identification"^^xsd:string ;
    ns1:comment "An identifier used to identify a specific band."^^xsd:string ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:hasBandName ;
            owl:someValuesFrom rdfs:Literal ] .

ns4:DateRange a owl:Class ;
    rdfs:label "date range"^^xsd:string ;
    rdfs:comment "Time period defined by an start and end date."^^xsd:string ;
    rdfs:subClassOf ns4:Duration ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onClass ns4:Date ;
                        owl:onProperty ns4:hasEndDate ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass ns4:Date ;
                        owl:onProperty ns4:hasStartDate ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

ns4:Entity a owl:Class ;
    rdfs:label "entity"^^xsd:string ;
    ns1:example "Air"^^xsd:string ;
    rdfs:comment "Following the definition of OBOE and SIO, an entity denotes a concrete or conceptual object that has been observed (e.g., a tree, a community, an ecological process). "^^xsd:string .

ns4:FileManifestation a owl:Class ;
    rdfs:label "file manifestation"^^xsd:string ;
    rdfs:comment "A file manifestation provides the information required to retrieve a file over the web, including the format and the URL where the file is available."^^xsd:string ;
    rdfs:subClassOf ns4:DatasetManifestation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onClass ns4:Format ;
                        owl:onProperty ns4:encodedInFormat ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onProperty ns4:hasLandingPageURL ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns4:hasFileDownloadURL ] ) ] .

ns4:GeographicRegion a owl:Class ;
    rdfs:label "geographic region"^^xsd:string ;
    ns1:comment "A geographic region, aligned to DCAT location, is a spatial region or named place."^^xsd:string ;
    ns1:example "America"^^xsd:string .

ns4:Layer a owl:Class ;
    rdfs:label "layer"^^xsd:string ;
    ns1:example "A dataset that quanifies temperature at many spatial locations" ;
    rdfs:comment "A layer is a set of environmental information quantifying the value of a single characteristic through space, used to compose a climate scenario to generate a model."^^xsd:string ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:containsFeatureSet ;
            owl:someValuesFrom ns4:FeatureSet ] .

ns4:OGCServiceManifestation a owl:Class ;
    rdfs:label "OGC  service manifestation"^^xsd:string ;
    rdfs:comment "Provides information about a service that can be executed over the web  using OGC standards, including the URL where the service is located."^^xsd:string ;
    rdfs:subClassOf ns4:ServiceManifestation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:hasCapabilitiesDocumentURL ;
            owl:someValuesFrom rdfs:Literal ] .

ns4:Projection a owl:Class ;
    rdfs:label "projection"^^xsd:string ;
    rdfs:comment "Processing of datasets, where a set of rules generated by a model are applied onto a climate scenario of related environmental layers."^^xsd:string ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ns4:hasEPSGCode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ns4:RasterDataset a owl:Class ;
    rdfs:label "raster dataset"^^xsd:string ;
    ns1:example "satellite imagery, aerial photographs."^^xsd:string ;
    rdfs:comment "A raster dataset is a geospatial dataset that organizes information as the value of a single characteristic at every location in space, such as temperature. Multiple raster datasets can be combined into a single dataset as bands of information."^^xsd:string ;
    rdfs:subClassOf ns4:GeospatialDataset ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:hasDataBand ;
            owl:someValuesFrom ns4:DataBand ] .

ns4:TimePeriod a owl:Class ;
    rdfs:label "time period"^^xsd:string ;
    ns1:comment "Following DCAT's descriptions, a time period is a temporal period that the dataset covers."^^xsd:string .

ns4:Unit a owl:Class ;
    rdfs:label "unit"^^xsd:string ;
    ns1:example "Meter"^^xsd:string ;
    rdfs:comment "A subclass of SIO's class unit of measurement. A unit is a a definite magnitude of a physical quantity."^^xsd:string .

ns4:VectorDataset a owl:Class ;
    rdfs:label "vector dataset"^^xsd:string ;
    ns1:comment "A dataset that represents values using points, lines and polygons."^^xsd:string ;
    rdfs:subClassOf ns4:GeospatialDataset ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns4:hasLayer ;
            owl:someValuesFrom ns4:Layer ] .

ns4:BoxedGeographicRegion a owl:Class ;
    rdfs:label "boxed geographic region"^^xsd:string ;
    ns1:example "The region specified by the bounds (N,E,S,W): 49.39, -78.75, 32.25, -120.24"^^xsd:string ;
    rdfs:comment "A geographic region that is specified by left longitude, lower latitude, right longitude and upper latitude."^^xsd:string ;
    rdfs:subClassOf ns4:GeographicRegion ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns4:hasLeftLongitude ;
                        owl:someValuesFrom xsd:double ] [ a owl:Restriction ;
                        owl:onProperty ns4:hasLowerLatitude ;
                        owl:someValuesFrom xsd:double ] [ a owl:Restriction ;
                        owl:onProperty ns4:hasRightLongitude ;
                        owl:someValuesFrom xsd:double ] [ a owl:Restriction ;
                        owl:onProperty ns4:hasUpperLatitude ;
                        owl:someValuesFrom xsd:double ] ) ] .

ns4:DatasetManifestation a owl:Class ;
    rdfs:label "dataset manifestation"^^xsd:string ;
    ns1:example "A donwnloadable RGIS WCS data set."^^xsd:string ;
    rdfs:comment "A dataset manifestation, that follows the description of a DCAT Distribution, provides the information to retrieve a dataset, including the fomat, endpoint, etc."^^xsd:string .

ns4:Date a owl:Class ;
    rdfs:label "date"^^xsd:string ;
    ns1:comment "A period of time with the same start and end time."^^xsd:string ;
    rdfs:subClassOf ns4:Instant ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty ns4:hasDateTime ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ns4:Format a owl:Class ;
    rdfs:label "format"^^xsd:string ;
    ns1:example "tiff"^^xsd:string ;
    rdfs:comment "The arrangement of data for computer input or output."^^xsd:string .

ns4:hasManifestation a owl:ObjectProperty ;
    rdfs:label "has manifestation" ;
    rdfs:domain ns4:GeospatialDataset ;
    rdfs:range ns4:DatasetManifestation .

ns4:GeospatialDataset a owl:Class ;
    rdfs:label "geospatial dataset"^^xsd:string ;
    rdfs:comment "A geospatial dataset contains data that covers a specified geographic region and specifies how a measured characteristic varies across that region, for a specific date range. It has a specific manifestation, a theme, and a geospatial projection"^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns4:coversRegion ;
                        owl:someValuesFrom ns4:BoxedGeographicRegion ] [ a owl:Restriction ;
                        owl:onProperty ns4:hasManifestation ;
                        owl:someValuesFrom ns4:DatasetManifestation ] [ a owl:Restriction ;
                        owl:onProperty ns4:hasTheme ;
                        owl:someValuesFrom ns4:Theme ] [ a owl:Restriction ;
                        owl:onClass ns4:DateRange ;
                        owl:onProperty ns4:coversTimePeriod ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass ns4:Projection ;
                        owl:onProperty ns4:hasGeospatialProjection ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

ns4:DataBand a owl:Class ;
    rdfs:label "data band"^^xsd:string ;
    ns1:comment "A databand will contain data about a specific characteristic of an entity. It uses a specific unit and resolution."^^xsd:string ;
    ns1:example "A databand can capture air temperature in Farenheit degrees with a resolution of 250m."^^xsd:string ;
    rdfs:subClassOf ns4:Band ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onClass ns4:Characteristic ;
                        owl:onProperty ns4:capturesCharacteristic ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass ns4:Unit ;
                        owl:onProperty ns4:hasUnits ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass ns4:Entity ;
                        owl:onProperty ns4:representsEntity ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange xsd:double ;
                        owl:onProperty ns4:hasMaximumValue ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange xsd:double ;
                        owl:onProperty ns4:hasMinimumValue ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange xsd:double ;
                        owl:onProperty ns4:hasNoDataValue ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange xsd:double ;
                        owl:onProperty ns4:hasResolution ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

ns4:PayloadFormat a owl:Class ;
    rdfs:label "payload format"^^xsd:string ;
    ns1:comment "Describes the format of a payload."^^xsd:string ;
    ns1:example "tiff, hdf5"^^xsd:string ;
    rdfs:subClassOf ns4:Format .

