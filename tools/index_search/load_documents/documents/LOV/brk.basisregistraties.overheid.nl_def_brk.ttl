<http://brk.basisregistraties.overheid.nl/id/structuur/Geometry> a sh:NodeShape ;
    sh:name "ogc:Geometry" ;
    sh:targetClass geo:Geometry .

<http://brk.basisregistraties.overheid.nl/id/structuur/KadastraleGrens> a sh:NodeShape ;
    sh:property <http://brk.basisregistraties.overheid.nl/id/structuur/KadastraleGrens_grenslijn>,
        <http://brk.basisregistraties.overheid.nl/id/structuur/KadastraleGrens_typeGrens> ;
    sh:targetClass <http://brk.basisregistraties.overheid.nl/def/brk#KadastraleGrens> .

<http://brk.basisregistraties.overheid.nl/id/structuur/Perceel> a sh:NodeShape ;
    sh:property <http://brk.basisregistraties.overheid.nl/id/structuur/Perceel_begrenzingPerceel>,
        <http://brk.basisregistraties.overheid.nl/id/structuur/Perceel_kadastraleGemeente>,
        <http://brk.basisregistraties.overheid.nl/id/structuur/Perceel_kadastraleGrootte>,
        <http://brk.basisregistraties.overheid.nl/id/structuur/Perceel_perceelnummer>,
        <http://brk.basisregistraties.overheid.nl/id/structuur/Perceel_perceelnummerRotatie>,
        <http://brk.basisregistraties.overheid.nl/id/structuur/Perceel_plaatscoordinaten>,
        <http://brk.basisregistraties.overheid.nl/id/structuur/Perceel_sectie>,
        <http://brk.basisregistraties.overheid.nl/id/structuur/Perceel_soortGrootte> ;
    sh:targetClass <http://brk.basisregistraties.overheid.nl/def/brk#Perceel> .

<http://brk.basisregistraties.overheid.nl/def/brk#KadastraleGrens> a owl:Class ;
    rdfs:label "KadastraleGrens" ;
    dcterms:subject <http://brk.basisregistraties.overheid.nl/id/begrip/Kadastrale_grens> ;
    rdfs:isDefinedBy onto: .

<http://brk.basisregistraties.overheid.nl/def/brk#Perceel> a owl:Class ;
    rdfs:label "Perceel" ;
    dcterms:subject <http://brk.basisregistraties.overheid.nl/id/begrip/Perceel> ;
