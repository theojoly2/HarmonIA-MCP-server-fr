@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://semanticscience.org/resource/> .
@prefix ns2: <http://protege.stanford.edu/plugins/owl/protege#> .
@prefix ns3: <http://creativecommons.org/ns#> .
@prefix onto: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ExecutedExperimentSpecification> a owl:Class ;
    rdfs:label "executed experiment specification"^^xsd:string ;
    ns1:comment "An executed experiment specification provides an experiment result."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ExecutableExperimentSpecification> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasExperimentResult> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ExperimentResult> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ExecutedWCSDataset> a owl:Class ;
    rdfs:label "executed wcs dataset"^^xsd:string ;
    ns1:comment "A dataset that is the output of a WCS service."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#InputWCSDataset> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasWCSResponse> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#WCSResponse> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ExtractedWCSResponse> a owl:Class ;
    rdfs:label "extracted wcs response"^^xsd:string ;
    ns1:comment "The TIFF dataset that contains the extracted payload from a WCS response."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#WCSResponse> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasExtractedPayload> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#TIFFDataset> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#InputWCSDatasetExperimentSpecification> a owl:Class ;
    rdfs:label "input wcs dataset experiment specification"^^xsd:string ;
    ns1:comment "An experiment specification that provides an input wcs dataset."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#JSONExperimentSpecification> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasInputWCSDataset> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#InputWCSDataset> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperSoftware> a owl:Class ;
    rdfs:label "lifemapper software"^^xsd:string ;
    ns1:comment "A species modelling software provided by lifemapper."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingSoftware> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#PostedScenario> a owl:Class ;
    rdfs:label "posted scenario"^^xsd:string ;
    ns1:comment "A scenario that has been posted."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#UnpostedScenario> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasPublishedScenario> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Scenario> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#PostedTIFFDataset> a owl:Class ;
    rdfs:label "posted tiff dataset"^^xsd:string ;
    rdfs:comment "A TIFF dataset with information about the layers it contains."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#TIFFDataset> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasPublishedLayer> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Layer> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#SpeciesOccurrenceDataset> a owl:Class ;
    rdfs:label "species occurrence dataset" ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#VectorDataset> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasLayer> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#SpeciesOccurrenceLayer> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasDefaultValue> a owl:DatatypeProperty ;
    rdfs:label "has default value" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasModellingScenario> a owl:ObjectProperty ;
    rdfs:label "has modelling scenario" ;
    owl:inverseOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#isModellingScenarioOf> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#specifiesProjectionScenario> a owl:ObjectProperty ;
    rdfs:label "specifies projection scenario" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#BoxedGeographicRegion> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#FeatureSet> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#FileManifestation> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Layer> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#VectorDataset> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#WCSResponseManifestation> a owl:Class .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#containsFeatureSet> a owl:ObjectProperty ;
    rdfs:label "contains feature set" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#coversRegion> a owl:ObjectProperty ;
    rdfs:label "covers region" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasLayer> a owl:ObjectProperty ;
    rdfs:label "has layer" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#representsEntity> a owl:ObjectProperty ;
    rdfs:label "represents entity" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl> a owl:Ontology ;
    ns3:license "http://creativecommons.org/licenses/by/3.0/"^^xsd:anyURI ;
    ns2:defaultLanguage "en" ;
    dc:contributor "Contributors are those that engage in discussions during the development of this ontology (in alphabetical order):\\nkarl benedict\\nluis garnica\\ncj grady\\nbill hudspeth\\ndeana pennington\\nsoren scott\\naimee stewart"^^xsd:string ;
    dc:creator "http://cybershare.utep.edu"^^xsd:anyURI,
        "ELSEWeb team"@en,
        "Natalia Villanueva-Rosales"@en,
        "Nicholas del Rio"@en ;
    dc:description "The ELSEWeb Lifemapper ontology provides classes for describing biodiversity modelling services provided by Lifemapper. This project provides  support for the ELSEWeb project(http://elseweb.cybershare.utep.edu/).\\nwebsite: http://elseweb.cybershare.utep.edu/ontologies\\nemail: nvillanuevarosales@utep.edu\\n"@en ;
    dc:issued "2014-05-01"^^xsd:date ;
    dc:rights "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/3.0/]."^^xsd:string ;
    dc:title "ELSEWeb Lifemapper Ontology"@en ;
    dcterms:identifier "elseweb-lifemapper.owl" ;
    dcterms:modified "2015-09-24"^^xsd:date ;
    vann:preferredNamespacePrefix "elseweb-lifemapper"@en ;
    vann:preferredNamespaceUri "http://ontology.cybershare.utep.edu/ELSEWeb/"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:imports <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl>,
        <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl> ;
    owl:versionIRI onto: ;
    owl:versionInfo "1.2"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ExperimentResult> a owl:Class ;
    rdfs:label "experiment result"^^xsd:string ;
    rdfs:comment "An experiment result provides a result ID and a URL where the result of an experiment can be retrieved."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasExperimentResultID> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasExperimentResultURL> ;
                        owl:someValuesFrom rdfs:Literal ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#JSONExperimentSpecification> a owl:Class ;
    rdfs:label "json experiment specification"^^xsd:string ;
    ns1:comment "The location of an experiment specification in the JSON format."^^xsd:string ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasJSONExperimentSpecificationURL> ;
            owl:someValuesFrom rdfs:Literal ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperParameter> a owl:Class ;
    rdfs:label "lifemapper parameter"^^xsd:string ;
    ns1:comment "A species modelling parameter that controls the behavior of a lifemapper algorithm."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingParameter> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#boundToValue> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#hasParameterName> ;
                        owl:someValuesFrom rdfs:Literal ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperParameters> a owl:Class ;
    rdfs:label "lifemapper parameters"^^xsd:string ;
    ns1:comment "A set of parameters that controls the behaviour of a specific lifemapper algorithm."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingParameters> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#hasParameterMember> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperParameter> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ModellingScenario> a owl:Class ;
    rdfs:label "modelling scenario"^^xsd:string ;
    ns1:comment "A modelling scenario provides the specification of an experiment that can be executed."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Scenario> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#isModellingScenarioOf> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ExecutableExperimentSpecification> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ScenarioLayer> a owl:Class ;
    rdfs:label "scenario layer"^^xsd:string ;
    ns1:comment "A layer that composes a scenario."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Layer> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#isScenarioLayerOf> ;
            owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#UnpostedScenario> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#SpeciesOccurrenceLayer> a owl:Class ;
    rdfs:label "A layer containing data about species ocurrence.",
        "species occurrence layer" ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Layer> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#SpeciesOccurrenceSet> ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#containsFeatureSet> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#describesBehaviorOf> a owl:ObjectProperty ;
    rdfs:label "describes behavior of" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ParameterDescriptions> ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperAlgorithm> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasAlgorithmCode> a owl:DatatypeProperty ;
    rdfs:label "has algorithm code" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperAlgorithm> ;
    rdfs:range rdfs:Literal .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasExperimentResult> a owl:ObjectProperty ;
    rdfs:label "has experiment result" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasExperimentResultID> a owl:DatatypeProperty ;
    rdfs:label "has experiment result id" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasExperimentResultURL> a owl:DatatypeProperty ;
    rdfs:label "has experiment result url" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasExtractedPayload> a owl:ObjectProperty ;
    rdfs:label "has extracted payload" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasGenusName> a owl:DatatypeProperty ;
    rdfs:label "has genus name" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Species> ;
    rdfs:range rdfs:Literal .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasInputWCSDataset> a owl:ObjectProperty ;
    rdfs:label "has input wcs dataset" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLayerID> a owl:DatatypeProperty ;
    rdfs:label "has layer id" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLayerURL> a owl:DatatypeProperty ;
    rdfs:label "has layer url" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLowerBoundInclusive> a owl:DatatypeProperty ;
    rdfs:label "has lower bound inclusive" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasNumberOfOccurrences> a owl:DatatypeProperty ;
    rdfs:label "has number of occurrences" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#SpeciesOccurrenceSet> ;
    rdfs:range xsd:integer .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasOccurrenceOfSpecies> a owl:ObjectProperty ;
    rdfs:label "has occurrence of species" ;
    rdfs:subPropertyOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#representsEntity> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasOccurrenceSetID> a owl:DatatypeProperty ;
    rdfs:label "has occurrence set id" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#SpeciesOccurrenceSet> ;
    rdfs:range rdfs:Literal .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasParameterClass> a owl:DatatypeProperty ;
    rdfs:label "has parameter class" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasParameterCollectionClass> a owl:DatatypeProperty ;
    rdfs:label "has parameter collection class" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasParameterDescription> a owl:ObjectProperty ;
    rdfs:label "has parameter description" ;
    rdfs:domain <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ParameterDescriptions> ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ParameterDescription> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasPublishedLayer> a owl:ObjectProperty ;
    rdfs:label "has published layer" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasPublishedScenario> a owl:ObjectProperty ;
    rdfs:label "has published scenario" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasScenarioID> a owl:DatatypeProperty ;
    rdfs:label "has scenario id" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasScenarioURL> a owl:DatatypeProperty ;
    rdfs:label "has scenario url" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasUpperBoundInclusive> a owl:DatatypeProperty ;
    rdfs:label "has upper bound inclusive" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasWCSResponse> a owl:ObjectProperty ;
    rdfs:label "has wcs response" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#isScenarioLayerOf> a owl:ObjectProperty ;
    rdfs:label "is scenario layer of" ;
    owl:inverseOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasScenarioLayer> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#specifiesModellingAlgorithm> a owl:ObjectProperty ;
    rdfs:label "specifies modelling algorithm" ;
    rdfs:range <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperAlgorithm> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#specifiesModellingScenario> a owl:ObjectProperty ;
    rdfs:label "specifies modelling scenario" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#specifiesOccurrenceSet> a owl:ObjectProperty ;
    rdfs:label "specifies occurrence set" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ExecutableExperimentSpecification> a owl:Class ;
    rdfs:label "executable experiment specification"^^xsd:string ;
    ns1:comment "An executable experiment specification specifies a modelling algorithm, a modelling scenario and an ocurrence set to generate a species distribution model."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#specifiesModellingAlgorithm> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperAlgorithm> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#specifiesModellingScenario> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ModellingScenario> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#specifiesOccurrenceSet> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#SpeciesOccurrenceSet> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#InputWCSDataset> a owl:Class ;
    rdfs:label "input wcs dataset"^^xsd:string ;
    ns1:comment "A dataset that is required as an input to a WCS service."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#coversRegion> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#BoxedGeographicRegion> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasManifestation> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISWCSManifestation> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasJSONExperimentSpecificationURL> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLayerUnits> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasTypeCode> ;
                        owl:someValuesFrom xsd:integer ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Layer> a owl:Class ;
    rdfs:label "layer"^^xsd:string ;
    ns1:comment "A unit of data (i.e. dataset) that is used as a component of a scenario specification."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasJSONExperimentSpecificationURL> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLayerID> ;
                        owl:someValuesFrom xsd:integer ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLayerURL> ;
                        owl:someValuesFrom rdfs:Literal ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ParameterDescription> a owl:Class ;
    rdfs:label "parameter description"^^xsd:string ;
    ns1:comment "The description of an algorithm parameter."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasParameterClass> ;
                        owl:someValuesFrom xsd:anyURI ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLowerBoundInclusive> ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasUpperBoundInclusive> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ParameterDescriptions> a owl:Class ;
    rdfs:label "parameter descriptions"^^xsd:string ;
    ns1:comment "A set of parameter descriptions."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#describesBehaviorOf> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperAlgorithm> ] [ a owl:Restriction ;
                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onClass <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ParameterDescription> ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasParameterDescription> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasParameterCollectionClass> ;
                        owl:someValuesFrom xsd:anyURI ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Species> a owl:Class ;
    rdfs:label "species"^^xsd:string ;
    ns1:comment "A group of living organisms which is the principal natural taxonomic unit."^^xsd:string,
        "Erinus alpinus"^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Entity> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasGenusName> ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#TIFFDataset> a owl:Class ;
    rdfs:label "tiff dataset"^^xsd:string ;
    ns1:comment "A dataset that is represented in TIFF format and provides the location where it can be retrieved, the units of the layers and the type code."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasManifestation> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#FileManifestation> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasJSONExperimentSpecificationURL> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLayerUnits> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasTypeCode> ;
                        owl:someValuesFrom xsd:integer ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#UnpostedScenario> a owl:Class ;
    rdfs:label "unposted scenario"^^xsd:string ;
    ns1:comment "A scenario that has not been posted and is composed by some scenario layer and has a JSON experiment specification URL."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasScenarioLayer> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ScenarioLayer> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasJSONExperimentSpecificationURL> ;
                        owl:someValuesFrom rdfs:Literal ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#WCSResponse> a owl:Class ;
    rdfs:label "wcs response"^^xsd:string ;
    ns1:comment "A response obtained from a WCS server, including the response manifestation, the experiment specification URL, layer units and type code."^^xsd:string ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasManifestation> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#WCSResponseManifestation> ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasJSONExperimentSpecificationURL> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLayerUnits> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasTypeCode> ;
                        owl:someValuesFrom xsd:integer ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasScenarioLayer> a owl:ObjectProperty ;
    rdfs:label "has scenario layer" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#isModellingScenarioOf> a owl:ObjectProperty ;
    rdfs:label "is modelling scenaio of" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Scenario> a owl:Class ;
    rdfs:label "scenario"^^xsd:string ;
    ns1:comment "A modelling scenario that provides the URL of the specification, an scenario ID and a URL where it can be retrieved."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Scenario> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasJSONExperimentSpecificationURL> ;
                        owl:someValuesFrom rdfs:Literal ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasScenarioID> ;
                        owl:someValuesFrom xsd:integer ] [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasScenarioURL> ;
                        owl:someValuesFrom rdfs:Literal ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasLayerUnits> a owl:DatatypeProperty ;
    rdfs:label "has layer units" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasTypeCode> a owl:DatatypeProperty ;
    rdfs:label "has type code" .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#SpeciesOccurrenceSet> a owl:Class ;
    rdfs:label "species ocurrence set"^^xsd:string ;
    ns1:comment "An species ocurrence set provides a set of species ocurrences required to generate a disctibution model."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#FeatureSet> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasOccurrenceOfSpecies> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#Species> ] [ a owl:Restriction ;
                        owl:onDataRange xsd:integer ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasNumberOfOccurrences> ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasOccurrenceSetID> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperAlgorithm> a owl:Class ;
    rdfs:label "lifemapper algorithm"^^xsd:string ;
    ns1:comment "A species modelling algorithm provided by lifemapper that is controlled by lifemapper parameters."^^xsd:string ;
    rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingAlgorithm> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#behaviorControlledBy> ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperParameters> ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasAlgorithmCode> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#hasJSONExperimentSpecificationURL> a owl:DatatypeProperty ;
    rdfs:label "has json experiment specification  url" .

