@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://def.isotc211.org/iso19150/-2/2012/base#> .
@prefix onto: <http://reference.data.gov.au/def/ont/iso19160-1-address> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:aggregationType a owl:AnnotationProperty ;
    rdfs:label "aggregation type"@en .

ns1:associationName a owl:AnnotationProperty ;
    rdfs:label "assocation name"@en .

ns1:constraint a owl:AnnotationProperty ;
    rdfs:label "constraint"@en .

onto: a owl:Ontology ;
    rdfs:label "ISO19160-1:2015 Address ontology" ;
    dc:contributor "Australian Government Linked Data Working Group"^^xsd:string,
        "Nicholas Car"^^xsd:string ;
    dc:creator "ISO TC211, Group for Ontology Management"^^xsd:string ;
    dc:publisher "Australian Government Linked Data Working Group"^^xsd:string ;
    dcterms:created "2017-11-27"^^xsd:date ;
    dcterms:source "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:comment "This ontology is a version of the ISO TC211, Group for Ontology Management (GOM)'s OWL ontology interpretation of the ISO19160-1:2015 \"Addressing -- Part 1: Conceptual model\" standard (see https://www.iso.org/standard/61710.html) taken from that ontology's source code, published at https://github.com/ISO-TC211/GOM/tree/master/isotc211_GOM_harmonizedOntology/19160-1/2015.\\n\\nThis version uses different URIs for the ontology so that they can be made to resolve through the Australian Government Linked Data Working Groups redirect services where the original ontology's URIs do not resolve.\\n\\nThis ontology also has had the code lists removed thus preserving the data model but not the vocabularies. The code lists are published separately at http://reference.data.gov.au/def/ont/iso19160-1-address/codelist.\\n\\nAdditionally, this version adds some metadata, such as this explanation, some further annotation properties to better display elements of the ontology and includes a human-readable (HTML) version of the ontology generated from the RDF version.\\n\\nAs the GOM's version of the ontology evolves, we will keep this version up-to-date as we intend to only publish an easier-to-access version of their ontology here, not to profile it."@en ;
    owl:imports <http://def.isotc211.org/iso19150/-2/2012/base>,
        <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses>,
        <http://def.isotc211.org/iso19160/-1/2015/Profile_Minimal> ;
    owl:versionIRI <http://reference.data.gov.au/def/ont/iso19160-1-address/1.1> ;
    owl:versionInfo "1.1"^^xsd:string .

skos:definition a owl:AnnotationProperty .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.business_branch> a owl:ObjectProperty ;
    rdfs:label "business"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#BusinessRegister> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.business_headOffice> a owl:ObjectProperty ;
    rdfs:label "business"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#BusinessRegister> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.childAddress> a owl:ObjectProperty ;
    rdfs:label "child address"@en ;
    ns1:associationName "parent" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/iso19160-1-address#Address.parentAddress> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.client> a owl:ObjectProperty ;
    rdfs:label "client"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#Client> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.employee> a owl:ObjectProperty ;
    rdfs:label "employee"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#Employee> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.position> a owl:ObjectProperty ;
    rdfs:label "position"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressPosition> ;
    skos:definition "Geometry (coordinates) that represents the address location."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.specification> a owl:ObjectProperty ;
    rdfs:label "specification"@en ;
    ns1:associationName "specifies" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressSpecification> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.theAddressAlias> a owl:ObjectProperty ;
    rdfs:label "the address alias"@en ;
    ns1:associationName "alias" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressAlias> ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressAlias.address>,
        <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressAlias.aliasAddress> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.theAddressedPeriod> a owl:ObjectProperty ;
    rdfs:label "the addressed period"@en ;
    ns1:associationName "allows unambiguous determination" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressedPeriod> ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressedPeriod.address> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.referenceObject> a owl:ObjectProperty ;
    rdfs:label "reference object"@en ;
    ns1:associationName "references" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#ReferenceObject> ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/iso19160-1-address#ReferenceObject.addressComponent> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressProvenance.lineage> a owl:ObjectProperty ;
    rdfs:label "lineage"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressProvenance> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19115/-1/2014/LineageInformation#LI_Lineage> ;
    skos:definition "Provenance, source(s) and production process(es) used in producing an address or address component."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressSpecification.classSpecification> a owl:ObjectProperty ;
    rdfs:label "class specification"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressSpecification> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressClassSpecification> ;
    skos:definition "Information about one or more address classes, such as typology and valid component types." .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressableObject.childAddressableObject> a owl:ObjectProperty ;
    rdfs:label "child addressable object"@en ;
    ns1:associationName "parent" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressableObject> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressableObject> ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressableObject.parentAddressableObject> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressableObject.theAddressedPeriod> a owl:ObjectProperty ;
    rdfs:label "the addressed period"@en ;
    ns1:associationName "allows unambiguous determination" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressableObject> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressedPeriod> ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressedPeriod.addressedObject> .

<http://def.isotc211.org/iso19103/2015/AnyType#Any> a owl:Class .

<http://def.isotc211.org/iso19115/-1/2014/CitationAndResponsiblePartyInformation#CI_Citation> a owl:Class .

<http://def.isotc211.org/iso19115/-1/2014/LineageInformation#LI_Lineage> a owl:Class .

<http://def.isotc211.org/iso19135/2005/ProceduresForItemRegistration#RE_Locale> a owl:Class .

<http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#Client> a owl:Class .

<http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#Employee> a owl:Class .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.addressComponent> a owl:ObjectProperty ;
    rdfs:label "address component"@en ;
    ns1:aggregationType "partOfSharedAggregation" ;
    ns1:associationName "comprises" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.class> a owl:ObjectProperty ;
    rdfs:label "class"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressClass> ;
    skos:definition "Code that specifies the address class to which the address belongs."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.id> a owl:ObjectProperty ;
    rdfs:label "id"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19152/2012/SpecialClasses#Oid> ;
    skos:definition "Unique character string that identifies the address."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.lifecycleStage> a owl:ObjectProperty ;
    rdfs:label "lifecycle stage"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressLifecycleStage> ;
    skos:definition "Code that specifies the phase an address has reached in its lifecycle."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.lifespan> a owl:ObjectProperty ;
    rdfs:label "lifespan"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#Lifespan> ;
    skos:definition "Information about the period over which an address exists"@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.locale> a owl:ObjectProperty ;
    rdfs:label "locale"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19135/-1/2015/ExtendedModel#RE_Locale> ;
    skos:definition "A set or parameters that specify the cultural and linguistic environment."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.preferenceLevel> a owl:DatatypeProperty ;
    rdfs:label "preference level"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range xsd:integer ;
    skos:definition "Indicates the ranking of the address in a set of address aliases. 1 indicates highest ranking.\\n\\nEXAMPLE 1 A building on a street corner could be referenced by two addresses. One of them could have its preferenceLevel set to 1.\\n\\nEXAMPLE 2 In Switzerland, addresses containing German and French names, e.g. Biel (German) and Bienne (French), are different addresses with the same preference level."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.provenance> a owl:ObjectProperty ;
    rdfs:label "provenance"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressProvenance> ;
    skos:definition "Information about the source or origin of the address, such as the authority who assigned the address, the owner of the address data instance, and lineage of the address."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#Address.status> a owl:ObjectProperty ;
    rdfs:label "status"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#Address> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressStatus> ;
    skos:definition "Code that specifies the nature of the address assignment."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressAlias.type> a owl:ObjectProperty ;
    rdfs:label "type"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressAlias> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressAliasType> ;
    skos:definition "Code that specifies which justification for an alias applies to the address at the destination end of the association. The default value is unspecifiedAlias."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressAliasType> a owl:Class ;
    rdfs:label "Address Alias Type"@en ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:subClassOf skos:Concept .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressClassSpecification.class> a owl:ObjectProperty ;
    rdfs:label "class"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressClassSpecification> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressClass> ;
    skos:definition "Code that specifies the address class to which the address belongs."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressClassSpecification.component> a owl:ObjectProperty ;
    rdfs:label "component"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressClassSpecification> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponentType> ;
    skos:definition "The set of one or more address component types that may be considered together in various combinations to constitute an address of this class."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressClassSpecification.typology> a owl:ObjectProperty ;
    rdfs:label "typology"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressClassSpecification> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressTypology> ;
    skos:definition "Code that specifies the type of address class."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.id> a owl:ObjectProperty ;
    rdfs:label "id"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19152/2012/SpecialClasses#Oid> ;
    skos:definition "Unique character string that identifies the address component."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.lifecycleStage> a owl:ObjectProperty ;
    rdfs:label "lifecycle stage"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressLifecycleStage> ;
    skos:definition "Code that specifies the phase an address component has reached in its lifecycle."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.lifespan> a owl:ObjectProperty ;
    rdfs:label "lifespan"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#Lifespan> ;
    skos:definition "Information about the period over which an address component exists.\\n\\nNOTE See Annex D for lifecycle examples of an address component."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.locale> a owl:ObjectProperty ;
    rdfs:label "locale"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19135/-1/2015/ExtendedModel#RE_Locale> ;
    skos:definition "A set of parameters that specify the cultural and linguistic environment."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.provenance> a owl:ObjectProperty ;
    rdfs:label "provenance"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressProvenance> ;
    skos:definition "Information about the source or origin of the address component, such as the authority who assigned the address component value, the owner of the address component data instance, and the lineage of the address component."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.scopeComponent> a owl:ObjectProperty ;
    rdfs:label "scope component"@en ;
    ns1:associationName "withinScopeOf" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    owl:inverseOf <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.valueComponent> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.type> a owl:ObjectProperty ;
    rdfs:label "type"@en ;
    ns1:constraint "type is mandatory if there are no subclasses of AddressableObject" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponentType> ;
    skos:definition "Code that specifies the kind of address component."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.valueComponent> a owl:ObjectProperty ;
    rdfs:label "value component"@en ;
    ns1:associationName "withinScopeOf" ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent.valueInformation> a owl:ObjectProperty ;
    rdfs:label "value information"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponent> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponentValue> ;
    skos:definition "Value of and information about one or more address component values."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponentValue.locale> a owl:ObjectProperty ;
    rdfs:label "locale"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponentValue> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range <http://def.isotc211.org/iso19135/2005/ProceduresForItemRegistration#RE_Locale> ;
    skos:definition "A set of parameters that specify the cultural and linguistic environment."@en .

<http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponentValue.preferenceLevel> a owl:DatatypeProperty ;
    rdfs:label "preference level"@en ;
    rdfs:domain <http://reference.data.gov.au/def/ont/iso19160-1-address#AddressComponentValue> ;
    rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/" ;
    rdfs:range xsd:integer ;
    skos:definition "Indicates the ranking of the address component in a set of alternatives. 1 indicates highest ranking.\\n\\nEXAMPLE 1 A building on a street corner could be referenced by two addresses, each with a different component value for the thoroughfare name address component. For one of them the preferenceLevel could be set to 1.\\n\\nEXAMPLE 2 In Switzerland, Biel (German) and Bienne (French) are different address components with the same preference level."@en .

