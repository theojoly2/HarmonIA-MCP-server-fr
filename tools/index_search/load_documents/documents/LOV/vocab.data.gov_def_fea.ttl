@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://vocab.data.gov/def/fea> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://vocab.data.gov/def/fea#Agency> a rdfs:Class,
        owl:Class ;
    rdfs:label "Agency" ;
    rdfs:comment "An agency of the US government" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#GovernmentBody>,
        <http://vocab.data.gov/def/fea#ValuePoint> .

<http://vocab.data.gov/def/fea#Board> a rdfs:Class,
        owl:Class ;
    rdfs:label "Board" ;
    rdfs:comment "US government board" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#GovernmentBody> .

<http://vocab.data.gov/def/fea#Budget> a rdfs:Class,
        owl:Class ;
    rdfs:label "Budget" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_EnterpriseConcept> .

<http://vocab.data.gov/def/fea#Citizen> a rdfs:Class,
        owl:Class ;
    rdfs:label "Citizen" ;
    rdfs:comment "Citizen of the United States of Americe" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#Party> .

<http://vocab.data.gov/def/fea#CivilServant> a rdfs:Class,
        owl:Class ;
    rdfs:label "Civil Servant" ;
    rdfs:comment "An employee of the US Government" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#Party> .

<http://vocab.data.gov/def/fea#Commission> a rdfs:Class,
        owl:Class ;
    rdfs:label "Commission" ;
    rdfs:comment "Us government commission" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#GovernmentBody> .

<http://vocab.data.gov/def/fea#Company> a rdfs:Class,
        owl:Class ;
    rdfs:label "Company" ;
    rdfs:comment "A commercial organization" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#IndustryBody> .

<http://vocab.data.gov/def/fea#Council> a rdfs:Class,
        owl:Class ;
    rdfs:label "Council" ;
    rdfs:comment "US Government council" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#GovernmentBody> .

<http://vocab.data.gov/def/fea#Customer> a rdfs:Class,
        owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "The diverse nature of federal programs means that there are many customers spanning the citizen, business, other government, and internal categories.  Some customers\\nreceive direct government services, such as veterans receiving health care from the Veterans Health Administration. Other â€œcustomersâ€ are those subject to regulatory activities, such as large businesses conforming to safety regulations administered by the Occupational Safety and Health Administration. Importantly, the citizen is generally considered to be the ultimate â€œcustomerâ€ of government activities regardless of the nature of the customer relationship.\\nPRM volume 1, p.14" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#ValuePoint> .

<http://vocab.data.gov/def/fea#ExecutiveAgency> a rdfs:Class,
        owl:Class ;
    rdfs:label "Executive Agency" ;
    rdfs:comment "Executive Agency of the US government" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#Agency> .

<http://vocab.data.gov/def/fea#FEA_ArchitectureConcept> a rdfs:Class,
        owl:Class ;
    rdfs:label "FEA Architecture Concept" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_Concept> .

<http://vocab.data.gov/def/fea#FEA_Concept> a rdfs:Class,
        owl:Class ;
    rdfs:label "FEA Concept" ;
    rdfs:isDefinedBy onto: .

<http://vocab.data.gov/def/fea#FEA_EnterpriseConcept> a rdfs:Class,
        owl:Class ;
    rdfs:label "FEA Enterprise Concept" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_Concept> .

<http://vocab.data.gov/def/fea#FEA_Model> a rdfs:Class,
        owl:Class ;
    rdfs:label "FEA Model" ;
    rdfs:comment "1, the FEA is being constructed through a collection of interrelated\\nâ€œreference modelsâ€ designed to facilitate cross-agency analysis and the identification of duplicative investments, gaps, and opportunities for collaboration within and across Federal Agencies." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_ArchitectureConcept> .

<http://vocab.data.gov/def/fea#FEA_TechnologyConcept> a rdfs:Class,
        owl:Class ;
    rdfs:label "FEA Technology Concept" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_Concept> .

<http://vocab.data.gov/def/fea#FederalEnterpriseArchitecture> a rdfs:Class,
        owl:Class ;
    rdfs:label "Federal Enterprise Architecture" ;
    rdfs:comment "To facilitate efforts to transform the Federal Government to one that is citizen-centered, results-oriented, and market-based, the Office of Management and Budget (OMB) is developing the Federal Enterprise Architecture (FEA), a business-based framework for Governmentwide improvement." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_ArchitectureConcept> .

<http://vocab.data.gov/def/fea#GovernmentBody> a rdfs:Class,
        owl:Class ;
    rdfs:label "Government Body" ;
    rdfs:comment "Any US government organization" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#OrganizationEntity> .

<http://vocab.data.gov/def/fea#HumanResource> a rdfs:Class,
        owl:Class ;
    rdfs:label "Human Resource" ;
    rdfs:comment "This class refers to the workforce" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#Resource> .

<http://vocab.data.gov/def/fea#IT_Initiative> a rdfs:Class,
        owl:Class ;
    rdfs:label "IT Initiative" ;
    rdfs:comment "A program of work that implements information technology based capabilities." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_EnterpriseConcept> .

<http://vocab.data.gov/def/fea#IndependentAgency> a rdfs:Class,
        owl:Class ;
    rdfs:label "Independent Agency" ;
    rdfs:comment "Independent Agency of the US government" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#Agency> .

<http://vocab.data.gov/def/fea#IndustryBody> a rdfs:Class,
        owl:Class ;
    rdfs:label "Industry Body" ;
    rdfs:comment "Any non government organization" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#OrganizationEntity> .

<http://vocab.data.gov/def/fea#Mission> a rdfs:Class,
        owl:Class ;
    rdfs:label "Mission" ;
    rdfs:comment "Missions are carried out by the organizational entities" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_EnterpriseConcept> .

<http://vocab.data.gov/def/fea#Office> a rdfs:Class,
        owl:Class ;
    rdfs:label "Office" ;
    rdfs:comment "US government office" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#GovernmentBody> .

<http://vocab.data.gov/def/fea#OrganizationEntity> a rdfs:Class,
        owl:Class ;
    rdfs:label "Organization Entity" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#Party> .

<http://vocab.data.gov/def/fea#OtherFixedAsset> a rdfs:Class,
        owl:Class ;
    rdfs:label "Other Fixed Asset" ;
    rdfs:comment "This class includes any fixed assets such as vehicle fleets, facilities and other equipment." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#Resource> .

<http://vocab.data.gov/def/fea#Partition> a rdfs:Class,
        owl:Class ;
    rdfs:label "Partition" ;
    rdfs:comment "Each reference model has an extensional  property based on partitioning. This reveals implicit semantics in each reference model.\\n" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_ArchitectureConcept> .

<http://vocab.data.gov/def/fea#Party> a rdfs:Class,
        owl:Class ;
    rdfs:label "Party" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#Customer>,
        <http://vocab.data.gov/def/fea#FEA_EnterpriseConcept> .

<http://vocab.data.gov/def/fea#Process> a rdfs:Class,
        owl:Class ;
    rdfs:label "Process" ;
    rdfs:comment "The BRM includes a Mode of Delivery Business Area that is designed to identify at a very high level the process that is being used to achieve an intended purpose.\\nPRM volume 1, p.16" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#ValuePoint> .

<http://vocab.data.gov/def/fea#QuasiOfficialAgency> a rdfs:Class,
        owl:Class ;
    rdfs:label "Quasi Official Agency" ;
    rdfs:comment "Quasi Official Agency of the US government" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#Agency> .

<http://vocab.data.gov/def/fea#Resource> a rdfs:Class,
        owl:Class ;
    rdfs:label "Resource" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#ValuePoint> .

<http://vocab.data.gov/def/fea#Standard> a rdfs:Class,
        owl:Class ;
    rdfs:label "Standard" ;
    rdfs:comment "Technology standard" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_TechnologyConcept> .

<http://vocab.data.gov/def/fea#StrategicOutcome> a rdfs:Class,
        owl:Class ;
    rdfs:label "Strategic Outcome" ;
    rdfs:comment "Strategic Outcomes represent broad, policy priorities that drive the direction of government (such as to Secure the Homeland or Expand E-Government).\\nPRM volume 1, p.13" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#ValuePoint> .

<http://vocab.data.gov/def/fea#Technology> a rdfs:Class,
        owl:Class ;
    rdfs:label "Technology" ;
    rdfs:comment "Technology means Information Technology" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_TechnologyConcept>,
        <http://vocab.data.gov/def/fea#ValuePoint> .

<http://vocab.data.gov/def/fea#ValuePoint> a rdfs:Class,
        owl:Class ;
    rdfs:label "ValuePoint" ;
    rdfs:comment "The point at which value is measured." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://vocab.data.gov/def/fea#FEA_EnterpriseConcept> .

<http://vocab.data.gov/def/fea#allignedWith> a rdf:Property ;
    rdfs:label "allignedWith" ;
    rdfs:isDefinedBy onto: .

<http://vocab.data.gov/def/fea#buildsOn> a rdf:Property ;
    rdfs:label "buildsOn" ;
    rdfs:domain <http://vocab.data.gov/def/fea#Partition> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.data.gov/def/fea#Partition> .

<http://vocab.data.gov/def/fea#comprises> a rdf:Property ;
    rdfs:label "comprises" ;
    rdfs:isDefinedBy onto: .

<http://vocab.data.gov/def/fea#date> a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "date" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:date .

<http://vocab.data.gov/def/fea#dependsOn> a rdf:Property ;
    rdfs:label "dependsOn" ;
    rdfs:domain <http://vocab.data.gov/def/fea#Partition> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.data.gov/def/fea#Partition> .

<http://vocab.data.gov/def/fea#description> a rdf:Property,
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "description" ;
    rdfs:domain <http://vocab.data.gov/def/fea#FEA_Concept> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://vocab.data.gov/def/fea#drawsUpon> a rdf:Property ;
    rdfs:label "drawsUpon" ;
    rdfs:domain <http://vocab.data.gov/def/fea#FEA_Model> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.data.gov/def/fea#FEA_Model> .

<http://vocab.data.gov/def/fea#hasIntent> a rdf:Property,
        owl:FunctionalProperty ;
    rdfs:label "hasIntent" ;
    rdfs:domain <http://vocab.data.gov/def/fea#OrganizationEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.data.gov/def/fea#Mission> .

<http://vocab.data.gov/def/fea#intentOf> a rdf:Property,
        owl:InverseFunctionalProperty ;
    rdfs:label "intentOf" ;
    rdfs:domain <http://vocab.data.gov/def/fea#Mission> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.data.gov/def/fea#OrganizationEntity> .

<http://vocab.data.gov/def/fea#isComprisedOf> a rdf:Property ;
    rdfs:label "isComprisedOf" ;
    rdfs:isDefinedBy onto: .

<http://vocab.data.gov/def/fea#isPartOf> a rdf:Property ;
    rdfs:label "is part of" ;
    rdfs:comment "used to describe part of relationships, such as, for example, the fact that one organization is part of another (departmental hierarchy)." ;
    rdfs:isDefinedBy onto: .

<http://vocab.data.gov/def/fea#mnemonic> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "mnemonic" ;
    rdfs:domain <http://vocab.data.gov/def/fea#FEA_Concept> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string .

<http://vocab.data.gov/def/fea#supportedBy> a rdf:Property ;
    rdfs:label "supportedBy" ;
    rdfs:isDefinedBy onto: .

<http://vocab.data.gov/def/fea#undertakenBy> a rdf:Property ;
    rdfs:label "undertakenBy" ;
    rdfs:domain <http://vocab.data.gov/def/fea#IT_Initiative> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.data.gov/def/fea#Agency> .

<http://vocab.data.gov/def/fea#undertakes> a rdf:Property ;
    rdfs:label "undertakes" ;
    rdfs:domain <http://vocab.data.gov/def/fea#Agency> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://vocab.data.gov/def/fea#IT_Initiative> .

<http://vocab.data.gov/def/fea#> a foaf:Person .

