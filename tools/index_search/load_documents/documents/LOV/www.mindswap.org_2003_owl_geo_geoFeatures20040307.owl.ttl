@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix onto: <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    dc:creator "Femke Reitsma" ;
    dc:date "20th February 2004" ;
    rdfs:comment "This ontology contains geographic feature classes and associated properties including classes\\nand properties for describing the spatial location of the geographic feature.  The classes and properties have been defined based\\non an ESRI dataset." ;
    owl:versionInfo "Version 0.01" .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Administrative_Region> a owl:Class ;
    rdfs:label "Administrative Region" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Administrative_Subdivision> a owl:Class ;
    rdfs:label "Administrative Subdivision" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Area> a owl:Class ;
    rdfs:label "Area" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Autonomous_Community> a owl:Class ;
    rdfs:label "Autonomous Community" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Autonomous_Municipality> a owl:Class ;
    rdfs:label "Autonomous Municipality" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Autonomous_Region> a owl:Class ;
    rdfs:label "Autonomous Region" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Building> a owl:Class ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Canton> a owl:Class ;
    rdfs:label "Canton" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Capital_City> a owl:Class ;
    rdfs:label "Capital City" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Capital_Municipality> a owl:Class ;
    rdfs:label "Capital Municipality" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Capital_Territory> a owl:Class ;
    rdfs:label "Capital Territory" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Constitutional_Province> a owl:Class ;
    rdfs:label "Constitutional Province" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#County> a owl:Class ;
    rdfs:label "County" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Department> a owl:Class ;
    rdfs:label "Department" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#District> a owl:Class ;
    rdfs:label "District" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Division> a owl:Class ;
    rdfs:label "Division" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Economic_Prefecture> a owl:Class ;
    rdfs:label "Economic Prefecture" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Emirate> a owl:Class ;
    rdfs:label "Emirate" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Federal_Dependencies> a owl:Class ;
    rdfs:label "Federal Dependencies" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Federal_District> a owl:Class ;
    rdfs:label "Federal District" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Federal_Status_City> a owl:Class ;
    rdfs:label "Federal Status City" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Federal_Territory> a owl:Class ;
    rdfs:label "Federal Territory" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Governorate> a owl:Class ;
    rdfs:label "Governorate" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Independent_Town> a owl:Class ;
    rdfs:label "Independent Town" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Intendancy> a owl:Class ;
    rdfs:label "Intendancy" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Linestring> a owl:Class ;
    rdfs:label "Linestring" ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#coordinates> ],
        <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#MultiLinestring> a owl:Class ;
    rdfs:label "MultiLinestring" ;
    rdfs:comment "a collection of polylines" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#coordinates> ],
        <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#MultiPoint> a owl:Class ;
    rdfs:label "MultiPoint" ;
    rdfs:comment "a collection of points" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#coordinates> ],
        <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#MultiPolygon> a owl:Class ;
    rdfs:label "MultiPolygon" ;
    rdfs:comment "a collection of polygons" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#coordinates> ],
        <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Municipality> a owl:Class ;
    rdfs:label "Municipality" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#National_District> a owl:Class ;
    rdfs:label "National District" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#National_Territory> a owl:Class ;
    rdfs:label "National Territory" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Pakistan-administered> a owl:Class ;
    rdfs:label "Pakistan-administered" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Parish> a owl:Class ;
    rdfs:label "Parish" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Point> a owl:Class ;
    rdfs:label "Point" ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#coordinates> ],
        <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Polygon> a owl:Class ;
    rdfs:label "Polygon" ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#coordinates> ],
        <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Prefecture> a owl:Class ;
    rdfs:label "Prefecture" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Province> a owl:Class ;
    rdfs:label "Province" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Region> a owl:Class ;
    rdfs:label "Region" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Republic> a owl:Class ;
    rdfs:label "Republic" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Special_City> a owl:Class ;
    rdfs:label "Special City" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Special_District> a owl:Class ;
    rdfs:label "Special District" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Special_Municipality> a owl:Class ;
    rdfs:label "Special Municipality" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Special_Region> a owl:Class ;
    rdfs:label "Special Region" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#State> a owl:Class ;
    rdfs:label "State" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Territory> a owl:Class ;
    rdfs:label "Territory" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Town> a owl:Class ;
    rdfs:label "Town" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Union_Territory> a owl:Class ;
    rdfs:label "Union Territory" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Zone> a owl:Class ;
    rdfs:label "Zone" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#admin_name> a owl:DatatypeProperty ;
    rdfs:label "admin_name" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#City> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#city_name> a owl:DatatypeProperty ;
    rdfs:label "city_name" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#City> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#cntry_name> a owl:DatatypeProperty ;
    rdfs:label "cntry_name" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#City> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#curr_code> a owl:DatatypeProperty ;
    rdfs:label "curr_code" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Country> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#curr_type> a owl:DatatypeProperty ;
    rdfs:label "curry_type" ;
    rdfs:comment "Type of currency in country" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Country> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#fips_admin> a owl:DatatypeProperty ;
    rdfs:label "fips_admin" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#fips_cntry> a owl:DatatypeProperty ;
    rdfs:label "fips_cntry" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#gmi_admin> a owl:DatatypeProperty ;
    rdfs:label "gmi_admin" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#gmi_cntry> a owl:DatatypeProperty ;
    rdfs:label "gmi_cntry" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#hasSpatialLocation> a owl:ObjectProperty ;
    rdfs:label "hasSpatialLocation" ;
    rdfs:comment "hasSpatialLocation defines the qualitative location of some spatial thing" ;
    rdfs:domain owl:Thing ;
    rdfs:range <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialThing> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#iso_2digit> a owl:DatatypeProperty ;
    rdfs:label "ISO_2DIGIT" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#iso_3digit> a owl:DatatypeProperty ;
    rdfs:label "ISO_3DIGIT" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#pop_admin> a owl:DatatypeProperty ;
    rdfs:label "pop_admin" ;
    rdfs:comment "Population of the administrative unit" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#pop_class> a owl:DatatypeProperty ;
    rdfs:label "pop_class" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#City> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#pop_cntry> a owl:DatatypeProperty ;
    rdfs:label "pop_admin" ;
    rdfs:comment "Population of the country" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#Country> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#pop_rank> a owl:DatatypeProperty ;
    rdfs:label "pop_rank" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#City> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#port_id> a owl:DatatypeProperty ;
    rdfs:label "port_id" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#City> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#shape> a owl:ObjectProperty ;
    rdfs:label "shape" ;
    rdfs:comment "The property shape associates a geographic feature with a Spatial Description defined by a blank node" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> ;
    rdfs:range <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#sovereign> a owl:DatatypeProperty ;
    rdfs:label "sovereign" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#sqkm> a owl:DatatypeProperty ;
    rdfs:label "sqkm" ;
    rdfs:comment "Area in square kilometers" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#status> a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:comment "" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#City> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#type_loc> a owl:DatatypeProperty ;
    rdfs:label "type_loc" ;
    rdfs:comment "Type of administrative unit in language of country" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#xyCoordinates> a owl:DatatypeProperty ;
    rdfs:label "coordinates" ;
    rdfs:comment "xyCoordinates define the x,y location of a spatial thing.  They must be ordered as \"x,y x,y x,y ...\"" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#CoordinateOrigin>,
        <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> ;
    rdfs:range xsd:string .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#xyzCoordinates> a owl:DatatypeProperty ;
    rdfs:label "coordinates" ;
    rdfs:comment "xyCoordinates define the x,y,z location of a spatial thing.  They must be ordered as \"x,y,z x,y,z x,y,z...\"" ;
    rdfs:domain <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#CoordinateOrigin>,
        <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> ;
    rdfs:range xsd:string .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialThing> a owl:Class ;
    rdfs:label "SpatialThing" ;
    rdfs:comment "A spatial thing is the simplest thing that has some spatial characteristics" ;
    rdfs:subClassOf owl:Thing .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#City> a owl:Class ;
    rdfs:label "City" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialDescription> a owl:Class ;
    rdfs:label "SpatialDescription" ;
    rdfs:comment "A spatial description is a class of spatial descriptors used to describe the\\n\\tspatial shape of a SpatialThing in terms of coordinates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#hasCoordinateSystem> ] .

<http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> a owl:Class ;
    rdfs:label "GeographicFeature" ;
    rdfs:comment "cities, countries, admin units, and continents are subclasses of GeographicFeature" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#SpatialThing> .

[] a owl:Class ;
    rdfs:label "Country" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

[] a owl:Class ;
    rdfs:label "Street" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

[] a owl:Class ;
    rdfs:label "Continent" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

[] a owl:Class ;
    rdfs:label "Park" ;
    rdfs:subClassOf <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature> .

