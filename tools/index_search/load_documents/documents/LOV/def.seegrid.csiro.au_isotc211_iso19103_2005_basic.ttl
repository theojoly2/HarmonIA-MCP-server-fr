@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Acceleration> a owl:Class ;
    rdfs:label "Acceleration"@en ;
    rdfs:comment "Measure of rate of change of velocity"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Angle> a owl:Class ;
    rdfs:label "Angle" ;
    rdfs:comment "measure of arc length or rotation"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#AngularVelocity> a owl:Class ;
    rdfs:label "AngularVelocity"^^xsd:string ;
    rdfs:comment "Measure of rate of change of angular position"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Area> a owl:Class ;
    rdfs:label "Area" ;
    rdfs:comment "Measure of 2-D extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Boolean> a rdfs:Datatype ;
    rdfs:label "boolean"^^xsd:string ;
    rdfs:comment "Truth value. Most valuable in the predicate calculus, where items are either True or False, unless they are ill formed."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass xsd:boolean .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#CharacterString> a rdfs:Datatype ;
    rdfs:label "characterString"^^xsd:string ;
    rdfs:comment "sequence of characters"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass xsd:string .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Currency> a owl:Class ;
    rdfs:label "Currency" ;
    rdfs:comment "Measure of exchange value"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Date> a rdfs:Datatype ;
    rdfs:label "date"^^xsd:string ;
    rdfs:comment "Temporal position expressed with precision of days"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass xsd:date .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#DateTime> a rdfs:Datatype ;
    rdfs:label "dateTime"^^xsd:string ;
    rdfs:comment "Temporal position expressed as a time and date"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass xsd:dateTime .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Decimal> a rdfs:Datatype ;
    rdfs:label "decimal"^^xsd:string ;
    rdfs:comment "The usually finite representation of a decimal number. It differs from the common binary Real implementation in that it can represent 1/10 (one-tenth) without error, while binary real representation can only represent powers of 1/2 (one-half) exactly. Since many currencies are decimal, these representations are preferred in dealing with such moneys. This is also true for mile markers, which are often given in decimals.\\r\\n\\r\\nCan be thought of as an integer part followed by a fractional part given in multiples of powers of 1/10 (tenths)."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass xsd:decimal .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Distance> a owl:Class ;
    rdfs:label "Distance" ;
    rdfs:comment "Measure of spatial separation along some 1-D manifold"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Length> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Integer> a rdfs:Datatype ;
    rdfs:label "integer"^^xsd:string ;
    rdfs:comment "An exact integer value, with no fractional part."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass xsd:integer .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#LocalName> a rdfs:Datatype ;
    rdfs:label "localName"^^xsd:string ;
    rdfs:comment "Name in some local context"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass xsd:NCName .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Mass> a owl:Class ;
    rdfs:label "Mass" ;
    rdfs:comment "Measure of amount of substance"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Real> a rdfs:Datatype ;
    rdfs:label "realNumber"^^xsd:string ;
    rdfs:comment "The common binary Real finite implementation using base 2. Since such reals can approximate any measure where absolute accuracy is not possible, this form of numeric is most often used for measures. In cases were absolute accuracy is needed, such as currencies, then a decimal representation may be preferred (assuming the currency is decimal, such as the US dollar, British pound, etc.). Where there are no subunits possible, Integer numbers may be preferred.  \\n\\nCan be thought of as an integer part followed by a fractional part given in multiples of powers of 1/2 (halves)."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:unionOf ( xsd:double xsd:float ) ],
        [ a rdfs:Datatype ;
            owl:unionOf ( xsd:double xsd:float ) ] .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Scale> a owl:Class ;
    rdfs:label "Scale" ;
    rdfs:comment "Factor by which a representation should be magnified to match the geomstric size of the thing it represents."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Time> a owl:Class ;
    rdfs:label "Time" ;
    rdfs:comment "Measure of temporal extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Velocity> a owl:Class ;
    rdfs:label "Velocity" ;
    rdfs:comment "Measure of rate of change of position"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Volume> a owl:Class ;
    rdfs:label "Volume" ;
    rdfs:comment "Measure of 3-D extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> ;
    skos:notation "Volume"^^<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#ISOClassName> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Weight> a owl:Class ;
    rdfs:label "Weight" ;
    rdfs:comment "Measure of force due to a mass in a specific gravitational field"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#measure> a owl:ObjectProperty ;
    rdfs:label "measure"^^xsd:string ;
    rdfs:comment "The value of this property is a scaled number"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Length> a owl:Class ;
    rdfs:label "Length" ;
    rdfs:comment "Measure of 1-D extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Number> a rdfs:Datatype ;
    rdfs:label "Number"^^xsd:string ;
    rdfs:comment "Note: integer is a specialization of decimal"^^xsd:string,
        "The set of numbers"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:unionOf ( xsd:double xsd:float xsd:decimal ) ],
        [ a rdfs:Datatype ;
            owl:unionOf ( xsd:double xsd:float xsd:decimal ) ] .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#UnitOfMeasure> a owl:Class ;
    rdfs:label "Unit of measure"^^xsd:string ;
    rdfs:comment "Scale for a number describing size or extent"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    owl:disjointWith <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Vector> a owl:Class ;
    rdfs:label "Vector"^^xsd:string ;
    rdfs:comment "A vector is a sequence of a fixed length of Numbers. Normally, the numbers represent some measures, and thus vectors are often used where records of Numbers would be more appropriate. In geometry for example, direct positions are given by undistinguished coordinate vectors, which can be interpreted through the use of coordinate reference systems."^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#ordinates> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#dimension> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#ordinates> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#dimension> ] .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#dimension> a owl:DatatypeProperty ;
    rdfs:label "dimension"^^xsd:string ;
    rdfs:comment "Number of components in the vector"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Vector> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:positiveInteger .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#ordinates> a owl:DatatypeProperty ;
    rdfs:label "ordinates"^^xsd:string ;
    rdfs:comment "Numerical values of the vector components"^^xsd:string ;
    rdfs:domain <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Vector> ;
    rdfs:isDefinedBy onto: .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#uom> a owl:ObjectProperty ;
    rdfs:label "unit of measure"^^xsd:string ;
    rdfs:comment "The value of this property designates the units of measure or scale for the quantity"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#UnitOfMeasure> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#value> a owl:DatatypeProperty ;
    rdfs:label "value"^^xsd:string ;
    rdfs:comment "The value of this property is a number"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Number> .

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure> a owl:Class ;
    rdfs:label "Measure"@en,
        "Mesure"@fr ;
    rdfs:comment "Scaled number"^^xsd:string ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#uom> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#uom> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#value> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#value> ] ;
    owl:disjointWith <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#UnitOfMeasure> .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:Ontology ;
    dc:creator "Simon Jonathan David COX, CSIRO Australia"^^xsd:string ;
    dc:description "An OWL representation of (some of) the basic types described in ISO 19103:2005, required as primitives in other ontologies based on ISO 19100 series standards."^^xsd:string ;
    dc:rights "Copyright © 2012-2013 CSIRO"^^xsd:string ;
    dc:source "ISO 19103:2005"^^xsd:string ;
    dc:title "OWL representation of ISO 19103 (Basic types package)"^^xsd:string ;
    dcterms:created "2011"^^xsd:string ;
    dcterms:hasPart <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Acceleration>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Angle>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#AngularVelocity>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Area>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Boolean>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#CharacterString>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Currency>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Date>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#DateTime>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Decimal>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Distance>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Integer>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Length>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#LocalName>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Mass>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Measure>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Number>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Real>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Scale>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Time>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#UnitOfMeasure>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Vector>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Velocity>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Volume>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#Weight>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#dimension>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#measure>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#ordinates>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#uom>,
        <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#value> ;
    dcterms:license <http://creativecommons.org/licenses/by/3.0/> ;
    dcterms:modified "2013-11-14"^^xsd:string ;
    vann:preferredNamespacePrefix "basic"^^xsd:string ;
    vann:preferredNamespaceUri <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#> ;
    rdfs:comment "An OWL representation of (some of) the basic types described in ISO 19103:2005, required as primitives in other ontologies based on ISO 19100 series standards. \\r\\n\\r\\nThis vocabulary is provisional, pending finalization of ISO 19150-2.\\r\\n\\r\\nThe URI stem http://def.seegrid.csiro.au/isotc211/ is temporary. The vocabulary is expected to be ultimately published in the domain http://def.isotc211.org/"^^xsd:string ;
    owl:imports dc: ;
    owl:priorVersion <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201305/ISOTC211/HM/basic.rdf> ;
    owl:versionIRI <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201311/ISOTC211/HM/basic.rdf> .

