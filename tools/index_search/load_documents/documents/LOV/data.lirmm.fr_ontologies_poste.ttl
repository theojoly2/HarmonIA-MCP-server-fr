@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/adms#> .
@prefix onto: <http://data.lirmm.fr/ontologies/poste> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.lirmm.fr/ontologies/poste#AgencePostaleCommunale> a rdfs:Class,
        owl:Class ;
    rdfs:label "Agence postale communale" ;
    rdfs:comment "Site représentant une agence communale" ;
    rdfs:subClassOf <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#BureauPoste> a rdfs:Class,
        owl:Class ;
    rdfs:label "Bureau de poste" ;
    rdfs:comment "Site représentant un bureau de poste" ;
    rdfs:subClassOf <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#PosteOrganisation> a rdfs:Class,
        owl:Class ;
    rdfs:label "Organisation de la poste" ;
    rdfs:comment "Organisation de la poste en France" .

<http://data.lirmm.fr/ontologies/poste#RelaisCommercant> a rdfs:Class,
        owl:Class ;
    rdfs:label "Relais commerçant" ;
    rdfs:comment "Site représentant un relais poste commerçant" ;
    rdfs:subClassOf <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#> a owl:Ontology ;
    rdfs:label "Ontologie de la Poste"@fr ;
    dcterms:created "2012-09-25"^^xsd:date ;
    dcterms:creator <http://data.semanticweb.org/person/raphael-troncy>,
        <http://www.eurecom.fr/~atemezin> ;
    dcterms:license <http://www.opendatacommons.org/licenses/pddl/1.0/> ;
    dcterms:modified "2012-09-26"^^xsd:date,
        "2012-09-27"^^xsd:date,
        "2012-09-28"^^xsd:date,
        "2013-02-03"^^xsd:date,
        "2013-05-02"^^xsd:date,
        "2013-05-25"^^xsd:date ;
    dcterms:publisher <http://data.semanticweb.org/organization/eurecom> ;
    rdfs:comment "Vocabulaire décrivant la répartition des points de contact du réseau postal en France métropolitaine, Guadeloupe, Guyane, La Réunion, Martinique, Mayotte, Monaco, Monte-Carlo et Saint-Pierre et Miquelon"@fr ;
    rdfs:seeAlso onto:.html,
        <http://www.data.gouv.fr/donnees/view/Liste-des-points-de-contact-du-r%C3%A9seau-postal-fran%C3%A7ais-551640?xtmc=paris&xtcr=7>,
        <http://www.data.gouv.fr/var/download/fbd8ad620e37a6cf8165e5619a687ccd.pdf> ;
    owl:versionInfo "0.3" .

<http://data.lirmm.fr/ontologies/poste#affranchissementLibreService> a rdf:Property ;
    rdfs:label "Affranchissement libre service" ;
    rdfs:comment "Présence ou non d'un automate d'affranchissement libre service." ;
    rdfs:domain <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#changeurMonnaie> a rdf:Property ;
    rdfs:label "changeur monnaie" ;
    rdfs:comment "changeur de monnaie" ;
    rdfs:domain <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#codePostal> a rdf:Property ;
    rdfs:label "Code postal" ;
    rdfs:comment "code postal du point de contact" ;
    rdfs:domain <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#complementAdresse> a rdf:Property ;
    rdfs:label "Complement Adresse" ;
    rdfs:comment "Indication de precisant la structure d'accueil de l'agence, MAIRIE, HOTEL, TABAC" ;
    rdfs:domain <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#distributeur> a rdf:Property ;
    rdfs:label "Distributeur de billets automatique" ;
    rdfs:comment "Présence ou non d'un distributeur automatique de billets (DAB)." ;
    rdfs:domain <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#monnaieParis> a rdf:Property ;
    rdfs:label "Monnaie Paris" ;
    rdfs:domain <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#photocopieur> a rdf:Property ;
    rdfs:label "Photocopieur" ;
    rdfs:comment "Présence ou non d'un photocopieur accessible au public." ;
    rdfs:domain <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#rdf> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    dcterms:license <http://creativecommons.org/licenses/by-sa/3.0/> ;
    ns1:accessURL "http://data.lirmm.fr/ontologies/poste.rdf" ;
    ns1:status <http://purl.org/adms/status/Completed> .

<http://data.lirmm.fr/ontologies/poste#rechargeMoneo> a rdf:Property ;
    rdfs:label "Recharge moneo" ;
    rdfs:comment "Présence ou non de chargeurs de monnaie. Ils permettent aux clients de s'approvisionner en monnaie." ;
    rdfs:domain <http://data.lirmm.fr/ontologies/poste#PosteOrganisation> .

<http://data.lirmm.fr/ontologies/poste#ttl> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    dcterms:license <http://creativecommons.org/licenses/by-sa/3.0/> ;
    ns1:accessURL "http://data.lirmm.fr/ontologies/poste.ttl" ;
    ns1:status <http://purl.org/adms/status/Completed> .

<http://data.lirmm.fr/ontologies/poste#ghislain> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:nick "ghislain" .

<http://data.semanticweb.org/organization/eurecom> a org:Organization ;
    foaf:name "EURECOM" .

<http://data.semanticweb.org/person/raphael-troncy> a foaf:Person ;
    foaf:name "Raphael Troncy" .

<http://www.eurecom.fr/~atemezin> a foaf:Person ;
    foaf:name "Ghislain Auguste Atemezing" .

onto: a owl:Ontology,
        ns1:SemanticAsset ;
    dc:creator <http://data.lirmm.fr/ontologies/poste#ghislain> ;
    dc:license "http://creativecommons.org/licenses/by-sa/3.0/" ;
    dcterms:created "2012-09-28"^^xsd:date ;
    dcterms:description "Vocabulaire décrivant la répartition des points de contact du réseau postal en France métropolitaine, Guadeloupe, Guyane, La Réunion, Martinique, Mayotte, Monaco, Monte-Carlo et Saint-Pierre et Miquelon." ;
    dcterms:modified "2014-05-21"^^xsd:date ;
    dcterms:partOf <http://data.lirmm.fr/ontologies> ;
    dcterms:status <http://purl.org/adms/status/UnderDevelopment> ;
    dcterms:title "Ontologie de la Poste" ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:preferredNamespacePrefix "poste" ;
    vann:preferredNamespaceUri "http://data.lirmm.fr/ontologies/poste#" ;
    foaf:homepage onto:.html .

