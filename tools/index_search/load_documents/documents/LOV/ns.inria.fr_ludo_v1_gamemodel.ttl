<http://ns.inria.fr/ludo/v1/gamemodel> a owl:Ontology .

onto:Button a owl:Class ;
    rdfs:label "Button"@en ;
    rdfs:comment "Button"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:GUIComponent,
        owl:Thing ;
    ns1:term_status "stable" .

onto:Checkbox a owl:Class ;
    rdfs:label "Checkbox"@en ;
    rdfs:comment "Checkbox"@en ;
