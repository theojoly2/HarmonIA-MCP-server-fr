    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:GameResult ;
    owl:disjointWith onto:RawResult ;
    ns1:term_status "stable" .

onto:ObjectImage a owl:Class ;
    rdfs:label "Object Image"@en ;
    rdfs:comment "The object image is represented using one or more image components"@en ;
