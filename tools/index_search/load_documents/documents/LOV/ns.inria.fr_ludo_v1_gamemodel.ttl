    rdfs:label "Interaction Rule Subject"@en ;
    rdfs:comment "Interaction Rule Subject"@en ;
    rdfs:domain onto:GameInteractionRule ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:GameObject ;
    ns1:term_status "stable" .

