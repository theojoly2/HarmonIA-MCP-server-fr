<http://www.ontotext.com/proton/protonext#GovernmentAgency> a owl:Class ;
    rdfs:label "Government"@en ;
    rdfs:comment "A government agency is a permanent or semi-permanent organization in the machinery of government that is responsible for the oversight and administration of specific functions, such as an intelligence agency. DBPedia"@en,
        "The governmental cabinet"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#GovernmentOrganization> .

<http://www.ontotext.com/proton/protonext#GovernmentBuilding> a owl:Class ;
