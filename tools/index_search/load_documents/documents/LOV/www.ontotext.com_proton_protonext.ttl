    rdfs:label "Hockey player"@en,
        "Ice hockey player"@en ;
    rdfs:comment "The profession of ice hockey player"@en .

<http://www.ontotext.com/proton/protonext#Icecap> a owl:Class ;
    rdfs:label "Icecap"@en ;
    rdfs:comment "A dome-shaped mass of glacial ice covering an area of mountain summits or other high lands; smaller than an ice sheet"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Ideology> a owl:Class ;
    rdfs:label "Ideology"@en ;
    rdfs:comment "An ideology is a set of ideas that constitute one's goals, expectations, and actions. Wikipedia."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialAbstraction> .

<http://www.ontotext.com/proton/protonext#ImageDocument> a owl:Class ;
