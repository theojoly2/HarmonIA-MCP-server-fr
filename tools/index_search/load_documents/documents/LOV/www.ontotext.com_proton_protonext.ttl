    rdfs:comment "Any Hockey team"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Team> .

<http://www.ontotext.com/proton/protonext#Holiday> a owl:Class ;
    rdfs:label "Holiday"@en ;
    rdfs:comment "A Holiday is a day designated as having special significance for which individuals, a government, or a religious group have deemed that observance is warranted. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Date> .

<http://www.ontotext.com/proton/protonext#HomePage> a owl:Class ;
    rdfs:label "Home Page"@en ;
    rdfs:comment "The web page address of a page that is considered main for a web cite."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WebPage> .

<http://www.ontotext.com/proton/protonext#Hospital> a owl:Class ;
    rdfs:label "Hospital"@en ;
    rdfs:comment "Any Hospital, a building which is a hospital."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#Hotel> a owl:Class ;
    rdfs:label "Hotel"@en ;
    rdfs:comment "A hotel is an establishment that provides paid lodging on a short-term basis. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#IPAddress> a owl:Class ;
    rdfs:label "IP Address"@en ;
    rdfs:comment "An Internet Protocol address (IP address) is a numerical label assigned to each device (e.g., computer, printer) participating in a computer network that uses the Internet Protocol for communication. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#InternetAddress> .

<http://www.ontotext.com/proton/protonext#ISBN> a owl:DatatypeProperty ;
    rdfs:label "ISBN"@en ;
    rdfs:comment "The ISBN (International Standard Book Number) is a unique machine-readable identification number, which marks any book unmistakably."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Book> ;
    rdfs:subPropertyOf ns1:informationResourceIdentifier .

<http://www.ontotext.com/proton/protonext#ISSN> a owl:DatatypeProperty ;
    rdfs:label "ISSN"@en ;
    rdfs:comment "The ISSN (International Standard Serial Number) is an eight-digit number which identifies periodical publications as such, including electronic serials. More than one million ISSN numbers have so far been assigned."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#PeriodicalPublication> ;
    rdfs:subPropertyOf ns1:informationResourceIdentifier .

