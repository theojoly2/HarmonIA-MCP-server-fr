    rdfs:comment "The relationship between an object and an agent who owns it."@en ;
    rdfs:domain ns1:Object ;
    rdfs:range ns1:Agent .

<http://www.ontotext.com/proton/protonext#ownershipOf> a owl:ObjectProperty ;
    rdfs:label "Ownership"@en ;
    rdfs:comment "The relationship between an object being a property/possessions of somebody."@en ;
    rdfs:domain ns1:Object ;
    rdfs:range <http://www.ontotext.com/proton/protonext#Possession> .

<http://www.ontotext.com/proton/protonext#partOfPostalAddress> a owl:ObjectProperty ;
