@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://www.ontotext.com/proton/protontop#> .
@prefix onto: <http://www.ontotext.com/proton/protonext> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

onto: a owl:Ontology ;
    rdfs:label "Proton Ontology" ;
    dc:creator "Ontotext (Ivan Terziev, Atanas Kiryakov, Kiril Simov, Dimitar Manov, Mariana Damova, Svetoslav Petrov) " ;
    dc:rights "Proton ontology is available under the Creative Commons Attribution 3.0 Unported license; see http://creativecommons.org/licenses/by/3.0/. In a nutshell, you are free to copy, distribute and transmit the work; to remix/adapt the work (e.g. to import the ontology and create specializations of its elements), as long as you attribute the work in the manner specified by the author or licensor (but not in any way that suggests that they endorse you or your use of the work). Proper Attribution: Simply include the statement This work is based on Proton ontology, developed by Ontotext and link back to http://www.ontotext.com/proton-ontology" ;
    dc:subject "Upper-level ontology with extensions to handle Linked Open Data (LOD)" ;
    dc:title "Proton" ;
    rdfs:comment "PROTON (Proto Ontology), Extent module" ;
    owl:imports <http://www.ontotext.com/proton/protontop> ;
    owl:versionInfo "3.0" .

<http://www.ontotext.com/proton/protonext#ATM> a owl:Class ;
    rdfs:label "Automatic Teller Machine (ATM)"@en ;
    rdfs:comment "An unattended electronic machine in a public place, connected to a data system and related equipment and activated by a bank customer to obtain cash withdrawals and other banking services."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TelecomFacility> .

<http://www.ontotext.com/proton/protonext#AcademicJournal> a owl:Class ;
    rdfs:label "Academic journal"@en ;
    rdfs:comment "A journal publishing scientific articles"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Magazine> .

<http://www.ontotext.com/proton/protonext#Accident> a owl:Class ;
    rdfs:label "Accident"@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#Actor> a <http://www.ontotext.com/proton/protonext#ArtProfession> ;
    rdfs:label "Actor"@en ;
    rdfs:comment "Any actor acts in a dramatic production and who works in film, television, theatre, or radio in that capacity. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#AdministrativeRegion> a owl:Class ;
    rdfs:label "Administrative Region"@en ;
    rdfs:comment "Any administrative region. NIMA GNS designators - PCLIX"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PopulatedPlace> .

<http://www.ontotext.com/proton/protonext#AgriculturalColony> a owl:Class ;
    rdfs:label "Agricultural Colony"@en ;
    rdfs:comment "A tract of land set aside for agricultural settlement. NIMA GNS designator L.AGRC."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#AgriculturalFacility> a owl:Class ;
    rdfs:label "Agricultural Facility"@en ;
    rdfs:comment "An agricultural facility; a building and/or tract of land used for improving agriculture"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#Airbase> a owl:Class ;
    rdfs:label "Airbase"@en ;
    rdfs:comment "An area used to store supplies, provide barracks for air force personnel, hangars and runways for aircraft, and from which operations are initiated"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MilitaryAreas> .

<http://www.ontotext.com/proton/protonext#Airline> a owl:Class ;
    rdfs:label "Airline"@en ;
    rdfs:comment "A company providing air transport services."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Company> .

<http://www.ontotext.com/proton/protonext#AirplaneEngine> a owl:Class ;
    rdfs:label "Airplane Engine"@en ;
    rdfs:comment "Engines of airplanes"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Machine> .

<http://www.ontotext.com/proton/protonext#AirplaneModel> a owl:Class ;
    rdfs:label "Airplane Model"@en ;
    rdfs:comment "A concrete model of an airplane which determines the main features of any airplane of this model. For example, Boeing 737, Airbus A330, etc."@en ;
    rdfs:subClassOf ns1:ProductModel .

<http://www.ontotext.com/proton/protonext#AlcoholicBeverage> a owl:Class ;
    rdfs:label "Alcoholic Beverage"@en ;
    rdfs:comment "A type (specific receipe) for a beverage. For instance: Guiness Beer, Absolut Currant, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Beverage> .

<http://www.ontotext.com/proton/protonext#Ambassador> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Ambassador"@en ;
    rdfs:comment "Any ambassador, a title of a position of representing a country abroad"@en .

<http://www.ontotext.com/proton/protonext#AmericanFootballLeague> a owl:Class ;
    rdfs:label "American Football League"@en ;
    rdfs:comment "Any American football league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#AmericanFootballPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "American Football Player"@en ;
    rdfs:comment "Any player of American football."@en .

<http://www.ontotext.com/proton/protonext#AmericanFootballTeam> a owl:Class ;
    rdfs:label "American Football Team"@en ;
    rdfs:comment "Any American Football Team"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Team> .

<http://www.ontotext.com/proton/protonext#Amphibian> a owl:Class ;
    rdfs:label "Amphibian"@en ;
    rdfs:comment "Amphibian denotes animals such as frogs, salamanders, and caecilians, that are ectothermic (or cold-blooded) animals and metamorphose from a juvenile water-breathing form, either to an adult air-breathing form, or to a paedomorph that retains some juvenile characteristics. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Animal> .

<http://www.ontotext.com/proton/protonext#AmusementPark> a owl:Class ;
    rdfs:label "Amusement Park"@en ;
    rdfs:comment "(ADL FT) Commercially operated enterprises that offer rides, games, and other forms of entertainment. NIMA GNS designator - no equivalents."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#RecreationalFacility> .

<http://www.ontotext.com/proton/protonext#Announcement> a owl:Class ;
    rdfs:label "Announcement"@en ;
    rdfs:comment "A formal public statement; \"the government made an announcement about the changes in the drug war\" ; \"a declaration of independence\".) WordNet 1.7.1"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PublishedMaterial> .

<http://www.ontotext.com/proton/protonext#Arachnid> a owl:Class ;
    rdfs:label "Arachnid"@en ;
    rdfs:comment "Arachnid denotes a class of joint-legged invertebrate animals in the subphylum Chelicerata. All arachnids have eight legs, although in some species the front pair may convert to a sensory function. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Animal> .

<http://www.ontotext.com/proton/protonext#Arch> a owl:Class ;
    rdfs:label "Arch"@en ;
    rdfs:comment "A natural or man-made structure in the form of an arch"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Archaea> a owl:Class ;
    rdfs:label "Archaea"@en ;
    rdfs:comment "Archaea (archeon) are a group of single-celled microorganisms without a cell nucleus or any other membrane-bound organelles (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LivingObject> .

<http://www.ontotext.com/proton/protonext#Archipelago> a owl:Class ;
    rdfs:label "Archipelago"@en ;
    rdfs:comment "(ADL FT) Seas or areas in a sea that contain numerous islands; also, the island groups themselves. NIMA GNS designator - no equivalent."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Arena> a owl:Class ;
    rdfs:label "Arena"@en ;
    rdfs:comment "Any arena"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#Art> a owl:Class ;
    rdfs:label "Art"@en ;
    rdfs:comment "Art is the product or process of deliberately arranging items (often with symbolic significance) in a way that influences and affects one or more of the senses, emotions, and intellect. Wikipedia."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialAbstraction> .

<http://www.ontotext.com/proton/protonext#Artery> a owl:Class ;
    rdfs:label "Artery"@en ;
    rdfs:comment "Any artery as a part of the body."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BodyPart> .

<http://www.ontotext.com/proton/protonext#ArtificialSatellite> a owl:Class ;
    rdfs:label "Artificial Satellite"@en ;
    rdfs:comment "A satellite created by humans"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Satellite> .

<http://www.ontotext.com/proton/protonext#Artist> a <http://www.ontotext.com/proton/protonext#ArtProfession> ;
    rdfs:label "Artist"@en ;
    rdfs:comment "Any artist a profession engaging in a broad spectrum of activities related to creating art, practicing the arts and/or demonstrating an art. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#Asteroid> a owl:Class ;
    rdfs:label "Asteroid"@en ;
    rdfs:comment "Asteroids are a class of small Solar System bodies in orbit around the Sun. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#AstronomicalObject> .

<http://www.ontotext.com/proton/protonext#Astronaut> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Astronaut"@en ;
    rdfs:comment "Any astronaut, a profession allowing to command, pilot, or serve as a crew member of a spacecraft. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#Athlete> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Athlete"@en ;
    rdfs:comment "Any athlete, a profession involving sport activities."@en .

<http://www.ontotext.com/proton/protonext#Atoll> a owl:Class ;
    rdfs:label "Atoll"@en ;
    rdfs:comment "Any atoll"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Island> .

<http://www.ontotext.com/proton/protonext#AustralianFootballLeague> a owl:Class ;
    rdfs:label "Australian Football League"@en ;
    rdfs:comment "Any Australian football league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#AustralianRulesFootballPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Australian rules football player"@en ;
    rdfs:comment "The profession of an australian rules football player"@en .

<http://www.ontotext.com/proton/protonext#AutoRacingLeague> a owl:Class ;
    rdfs:label "Auto Racing League"@en ;
    rdfs:comment "Any Auto Racing league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#AutomobileEngine> a owl:Class ;
    rdfs:label "Automobile Engine"@en ;
    rdfs:comment "Engines of automobiles"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Machine> .

<http://www.ontotext.com/proton/protonext#Award> a owl:Class ;
    rdfs:label "Award"@en ;
    rdfs:comment "Any award. An award is something given to a person or a group of people to recognize excellence in a certain field; a certificate of excellence, for example trophies, titles, medals, badges, etc."@en ;
    rdfs:subClassOf ns1:Abstract .

<http://www.ontotext.com/proton/protonext#Bacteria> a owl:Class ;
    rdfs:label "Bacteria"@en ;
    rdfs:comment "Bacteria is a single-celled, prokaryote microorganisms, typically a few micrometres in length (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LivingObject> .

<http://www.ontotext.com/proton/protonext#BadmintonPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Badminton player"@en ;
    rdfs:comment "The profession of badminton player"@en .

<http://www.ontotext.com/proton/protonext#Band> a owl:Class ;
    rdfs:label "Band"@en ;
    rdfs:comment "Any band, a group performing music or other activity together."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#Bank> a owl:Class ;
    rdfs:label "Bank"@en ;
    rdfs:comment "A business establishment in which money is kept for saving or commercial purposes or is invested, supplied for loans, or exchanged."@en,
        "A company providing financial services like credits, deposits, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building>,
        <http://www.ontotext.com/proton/protonext#Company> .

<http://www.ontotext.com/proton/protonext#Barracks> a owl:Class ;
    rdfs:label "Barracks"@en ;
    rdfs:comment "A building for lodging military personnel"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MilitaryAreas> .

<http://www.ontotext.com/proton/protonext#BaseballLeague> a owl:Class ;
    rdfs:label "Baseball League"@en ;
    rdfs:comment "Any Baseball league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#BaseballPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Baseball player"@en ;
    rdfs:comment "The profession of baseball player"@en .

<http://www.ontotext.com/proton/protonext#BaseballTeam> a owl:Class ;
    rdfs:label "Baseball Team"@en ;
    rdfs:comment "Any Baseball team"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Team> .

<http://www.ontotext.com/proton/protonext#BasketballLeague> a owl:Class ;
    rdfs:label "Basketball League"@en ;
    rdfs:comment "Any Basketball league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#BasketballPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Basketball player"@en ;
    rdfs:comment "The profession of basketball player"@en .

<http://www.ontotext.com/proton/protonext#BasketballTeam> a owl:Class ;
    rdfs:label "Basketball Team"@en ;
    rdfs:comment "Any basketball team"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Team> .

<http://www.ontotext.com/proton/protonext#Battlefield> a owl:Class ;
    rdfs:label "Battlefield"@en ;
    rdfs:comment "A site of a land battle of historical importance. NIMA GNS designator L.BTL."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#HistoricPlace> .

<http://www.ontotext.com/proton/protonext#Beach> a owl:Class ;
    rdfs:label "Beach"@en ;
    rdfs:comment "(ADL FT) Sloping shores along a body of water that is washed by waves or tides and is usually covered by sand or gravel. ... We use this category for sandy areas; and for strands. NIMA GNS designator BCH, BCHS."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Beacon> a owl:Class ;
    rdfs:label "Beacon"@en ;
    rdfs:comment "A fixed artificial navigation mark"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#Bight> a owl:Class ;
    rdfs:label "Bight"@en ;
    rdfs:comment "An open body of water forming a slight recession in a coastline"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#BiologicalDatabase> a owl:Class ;
    rdfs:label "Biological Database"@en ;
    rdfs:comment "A database containing information about biological entities."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Database> .

<http://www.ontotext.com/proton/protonext#Bird> a owl:Class ;
    rdfs:label "Bird"@en ;
    rdfs:comment "Bird denotes feathered, winged, bipedal, endothermic (warm-blooded), egg-laying, vertebrate animals. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Animal> .

<http://www.ontotext.com/proton/protonext#Bishop> a <http://www.ontotext.com/proton/protonext#ClericTitle> ;
    rdfs:label "Bishop"@en ;
    rdfs:comment "Any bishop, an official in the Roman-Catholic church."@en .

<http://www.ontotext.com/proton/protonext#BoardMeeting> a owl:Class ;
    rdfs:label "Board Meeting"@en ;
    rdfs:comment "A meeting whose main participants are members of a board."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Meeting> .

<http://www.ontotext.com/proton/protonext#BoardMember> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Board Member"@en ;
    rdfs:comment "Any board member, a title of the member of the board of any board"@en .

<http://www.ontotext.com/proton/protonext#Bog> a owl:Class ;
    rdfs:label "Bog"@en ;
    rdfs:comment "http://www.eionet.europa.eu/gemet/concept?ns=1&cp=12161. NIMA GNS designator H.BOG."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Bone> a owl:Class ;
    rdfs:label "Bone"@en ;
    rdfs:comment "Any bone as a part of the body."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BodyPart> .

<http://www.ontotext.com/proton/protonext#Boxer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Boxer"@en ;
    rdfs:comment "The profession of boxer"@en .

<http://www.ontotext.com/proton/protonext#BoxingLeague> a owl:Class ;
    rdfs:label "Boxing League"@en ;
    rdfs:comment "Any Boxing league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#Brain> a owl:Class ;
    rdfs:label "Brain"@en ;
    rdfs:comment "Any brain as a part of the body."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BodyPart> .

<http://www.ontotext.com/proton/protonext#Breakwater> a owl:Class ;
    rdfs:label "Breakwater"@en ;
    rdfs:comment "A structure erected to break the force of waves at the entrance to a harbor or port"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#Bridge> a owl:Class ;
    rdfs:label "Bridge"@en ;
    rdfs:comment "(ADL FT) Structures erected over a depression or obstacle to carry traffic. [USGS Circ 1048] We use this category for covered bridges; for drawbridges; for overpasses; for trestles; and for viaducts. NIMA GNS designator BDG, BDGQ."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TransportFacility> .

<http://www.ontotext.com/proton/protonext#BritishRoyalty> a <http://www.ontotext.com/proton/protonext#NobeltyTitle> ;
    rdfs:label "British Royalty"@en ;
    rdfs:comment "Any British Royalty, a title of a memebr of the British royal family."@en .

<http://www.ontotext.com/proton/protonext#BroadcastNetwork> a owl:Class ;
    rdfs:label "Broadcast network"@en ;
    rdfs:comment "A broadcast network is an organization, such as a corporation or other voluntary association, that provides live television or recorded content, such as movies, newscasts, sports, Public affairs programming, and other television programs for broadcast over a group of radio stations or television stations. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Broadcaster> .

<http://www.ontotext.com/proton/protonext#BullFighter> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Bull Fighter"@en,
        "BullFighter"@en ;
    rdfs:comment "Professional toreros (also called matadors) who execute various formal moves which can be interpreted and innovated according to the bullfighter's style or school. Wikipedia"@en .

<http://www.ontotext.com/proton/protonext#BushLand> a owl:Class ;
    rdfs:label "Bush"@en ;
    rdfs:comment "A small clump of conspicuous bushes in an otherwise bare area"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#CEO> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "CEO"@en ;
    rdfs:comment "Any CEO, a title of a chief executive officer of an organization."@en .

<http://www.ontotext.com/proton/protonext#CalendarMonth> a owl:Class ;
    rdfs:label "Calendar Month"@en ;
    rdfs:comment "A specific month of the year, such as: Jan., Feb., etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TemporalAbstraction> .

<http://www.ontotext.com/proton/protonext#CalendarYear> a owl:Class ;
    rdfs:label "Calendar Year"@en ;
    rdfs:comment "A specific year, such as 2000, taken as a time interval"@en ;
    rdfs:subClassOf ns1:TimeInterval .

<http://www.ontotext.com/proton/protonext#Camp> a owl:Class ;
    rdfs:label "Camp"@en ;
    rdfs:comment "(ADL FT) Designated areas on which primitive structure(s) are erected for temporary shelter or where recreational vehicles are temporarily parked. [USGS Circ 1048] We use this category for campgrounds; for camping sites; for logging camps; for oil camps; for refugee camps; for RV parks; and for trailer parks (recreational). NIMA GNS designators CMP, CMPL, CMPLA, CMPO, CMPQ, CMPRF."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#RecreationalFacility> .

<http://www.ontotext.com/proton/protonext#CanadianFootballLeague> a owl:Class ;
    rdfs:label "Canadian Football League"@en ;
    rdfs:comment "Any Canadian Football league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#CanadianFootballPlayer> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Canadian Football Player"@en ;
    rdfs:comment "Any player of Canadian football."@en .

<http://www.ontotext.com/proton/protonext#CanadianFootballTeam> a owl:Class ;
    rdfs:label "Canadian Football Team"@en ;
    rdfs:comment "Any Canadian Football Team"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Team> .

<http://www.ontotext.com/proton/protonext#Canyon> a owl:Class ;
    rdfs:label "Canyon"@en ;
    rdfs:comment "(ADL FT) Relatively narrow, deep depressions with steep sides, the bottom of which generally has a continuous slope ... We use this category for barrancas; for chasms; for flumes (natural); for gorges; for gulches; for quebradas; and for ravines. NIMA GNS designator CNSU, CNYN, CNYU, GRGE, RAVU, RVN."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Valley> .

<http://www.ontotext.com/proton/protonext#Cape> a owl:Class ;
    rdfs:label "Cape"@en ;
    rdfs:comment "(ADL FT) Projection of land extending into a body of water that prominently marks a change in or interrupts the coastal trend of that water body. We use this category for headlands; for peninsulas; for points (physiographic); and for promontories. NIMA GNS designator CAPE, HDLD, PROM."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Car> a owl:Class ;
    rdfs:label "Car"@en ;
    rdfs:comment "Any automoabile car."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Vehicle> .

<http://www.ontotext.com/proton/protonext#Cardinal> a <http://www.ontotext.com/proton/protonext#ClericTitle> ;
    rdfs:label "Cardinal"@en ;
    rdfs:comment "Any Cardinal, a high official in the Roman-Catholic church."@en .

<http://www.ontotext.com/proton/protonext#Cave> a owl:Class ;
    rdfs:label "Cave"@en ;
    rdfs:comment "(ADL FT) Natural underground passageways or chambers, or hollowed out cavities in the side of a cliff. ... We use this category for cave entrances; for caverns; for grottoes; for natural tunnels; and for underground lakes. NIMA GNS designator CAVE."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Chancellor> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Chancellor"@en ;
    rdfs:comment "Any Chancellor, a title of various official positions in the governments of many nations. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#Channel> a owl:Class ;
    rdfs:label "Channel"@en ;
    rdfs:comment "(ADL FT) (a) Relatively narrow seas or stretches of water between two close landmasses and connecting two larger bodies of water; (b) Deeper parts of a moving body of water (as bays, estuaries, or straits) through which the main current flows or which affords the best passage through an area otherwise too shallow to navigate. ... We use this category for chutes (hydrographic); for cutoffs (hydrographic); for inlets; for lake channels; for marine channels; for narrows (hydrographic); for navigation channels; for reaches (hydrographic); for sounds (bodies of water); and for straits. NIMA GNS designators CHN, CHNL, CHNM, CHNN, STRT."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Canal> .

<http://www.ontotext.com/proton/protonext#Charity> a owl:Class ;
    rdfs:label "Charity"@en ;
    rdfs:comment "Any Charity, an organization involved in the practice of benevolent giving and caring. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Non-ProfitOrganisation> .

<http://www.ontotext.com/proton/protonext#ChemicalElement> a owl:Class ;
    rdfs:label "Chemical element"@en ;
    rdfs:comment "A chemical element is a pure chemical substance consisting of one type of atom distinguished by its atomic number, which is the number of protons in its nucleus. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ChemicalSubstance> .

<http://www.ontotext.com/proton/protonext#ChessPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Chess player"@en ;
    rdfs:comment "The profession of a chess player"@en .

<http://www.ontotext.com/proton/protonext#ChristianPatriarch> a <http://www.ontotext.com/proton/protonext#ClericTitle> ;
    rdfs:label "Christian Patriarch"@en,
        "Patriarch"@en ;
    rdfs:comment "Any Christian Patriarch."@en .

<http://www.ontotext.com/proton/protonext#Coast> a owl:Class ;
    rdfs:label "Coast"@en ;
    rdfs:comment "(ADL FT: Coastal Zones) Strips of land (of indefinite width) that extend from the low-tide line inland to the first major change in landform features. [Adapted from Glossary of Geology, 4th ed.] We use this category for coastal plains; for coasts; for intertidal zones; for offshore areas; for shorelines; and for shores. NIMA GNS designators CST, SHOR."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#CoconutGrove> a owl:Class ;
    rdfs:label "Coconut grove"@en ;
    rdfs:comment "A planting of coconut trees"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#College> a owl:Class ;
    rdfs:label "College"@en ;
    rdfs:comment "An education organization between the school and the university. In some cases it is a part of university."@en,
        "College"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#EducationalOrganization> .

<http://www.ontotext.com/proton/protonext#Colour> a owl:Class ;
    rdfs:label "Colour"@en ;
    rdfs:comment "Any colour, a visual perceptual property, e.g. red, blue, yellow, etc. (Wikipedia)"@en ;
    rdfs:subClassOf ns1:Abstract .

<http://www.ontotext.com/proton/protonext#Comedian> a <http://www.ontotext.com/proton/protonext#ArtProfession> ;
    rdfs:label "Comedian"@en ;
    rdfs:comment "The profession of a comedian"@en .

<http://www.ontotext.com/proton/protonext#ComicsCharacter> a owl:Class ;
    rdfs:label "Comics character"@en ;
    rdfs:comment "A character from a comics."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#FictionalCharacter> .

<http://www.ontotext.com/proton/protonext#ComicsCreator> a <http://www.ontotext.com/proton/protonext#ArtProfession> ;
    rdfs:label "Comics creator "@en ;
    rdfs:comment "The profession of comics creator "@en .

<http://www.ontotext.com/proton/protonext#Commander> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Commander"@en ;
    rdfs:comment "Any commander, title of being commander or having a leading role in a military unit or other organization."@en .

<http://www.ontotext.com/proton/protonext#Concert> a owl:Class ;
    rdfs:label "Concert"@en ;
    rdfs:comment "An art performance consisting of playing music."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ArtPerformance> .

<http://www.ontotext.com/proton/protonext#Confluence> a owl:Class ;
    rdfs:label "Confluence"@en ;
    rdfs:comment "in geography, describes the meeting of two or more bodies of water. The opposite of a watershed. NIMA GNS designator H.CNFL."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Congressman> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Congressman"@en ;
    rdfs:comment "Any Congressman, a title of a position in congress."@en .

<http://www.ontotext.com/proton/protonext#Continent> a owl:Class ;
    rdfs:label "Continent"@en ;
    rdfs:comment "(ADL FT) Earth's major land masses, including both dry land and continental shelves. NIMA GNS designator - no equivalent."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion>,
        <http://www.ontotext.com/proton/protonext#PopulatedPlace> .

<http://www.ontotext.com/proton/protonext#ContinentalShelf> a owl:Class ;
    rdfs:label "Shelf"@en ;
    rdfs:comment "A zone adjacent to a continent (or around an island) that extends from the low water line to a depth at which there is usually a marked increase of slope towards oceanic depths"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Contract> a owl:Class ;
    rdfs:label "Contract"@en ;
    rdfs:comment "Any sort of contract or treaty, as well, as other documents signed or otherwise accepted by more than one agent."@en ;
    rdfs:subClassOf ns1:Document .

<http://www.ontotext.com/proton/protonext#CountryCapital> a owl:Class ;
    rdfs:label "Country Capital"@en ;
    rdfs:comment "A capital of a Country. NIMA GNS designator PPLC."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Capital> .

<http://www.ontotext.com/proton/protonext#County> a owl:Class ;
    rdfs:label "County"@en ;
    rdfs:comment "(ADL FT: Countries, 2nd order divisions) Second-order divisions of a nation such as parishes, boroughs, counties, municipios, or judicial divisions, and independent cities such as those in Maryland, Missouri, Nevada, and Virginia. [Adapted from USGS Circ 1048] We use this category for boroughs; for counties; for judicial divisions; for municipios; for parishes; and for second-order administrative divisions. NIMA GNS designator ADM2."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PoliticalRegion>,
        <http://www.ontotext.com/proton/protonext#PopulatedPlace> .

<http://www.ontotext.com/proton/protonext#Cove> a owl:Class ;
    rdfs:label "Cove"@en ;
    rdfs:comment "a small type of bay or coastal inlet. http://www.eionet.europa.eu/gemet/concept/10142 NIMA GNS designator H.COVE."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Bay> .

<http://www.ontotext.com/proton/protonext#Crater> a owl:Class ;
    rdfs:label "Crater"@en ;
    rdfs:comment "(ADL FT) Circular-shaped depressions at the summit of a volcanic core or on the surface of the land caused by the impact of a meteorite; man-made depressions caused by an explosion. ... We use this category for calderas. NIMA GNS designator CRTR, CLDA."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Creek> a owl:Class ;
    rdfs:label "Creek"@en ;
    rdfs:comment "(ADL FT: Guts) Relatively small coastal waterways connecting larger bodies of water or other waterways. NIMA GNS designator CRKT, INLT."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#CricketLeague> a owl:Class ;
    rdfs:label "Cricket League"@en ;
    rdfs:comment "Any Cricket league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#Cricketer> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Cricketer "@en ;
    rdfs:comment "The profession of cricketer"@en .

<http://www.ontotext.com/proton/protonext#Crustacean> a owl:Class ;
    rdfs:label "Crustacean"@en ;
    rdfs:comment "Crustaceans denotes a group of arthropods animals, which includes crabs, lobsters, crayfish, shrimp, krill and barnacles. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Animal> .

<http://www.ontotext.com/proton/protonext#CultivatedArea> a owl:Class ;
    rdfs:label "Cultivated area"@en ;
    rdfs:comment "An area under cultivation"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#CurlingLeague> a owl:Class ;
    rdfs:label "Curling League"@en ;
    rdfs:comment "Any Curling league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#DayOfMonth> a owl:Class ;
    rdfs:label "Day of Month"@en ;
    rdfs:comment "A specific day of a given month. The days are numbered from 1 to 28, 29, 30, or 31 depending on the month and the year."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TemporalAbstraction> .

<http://www.ontotext.com/proton/protonext#DayOfWeek> a owl:Class ;
    rdfs:label "Day of Week"@en ;
    rdfs:comment "A specific day of the week. The week has seven days: Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, and Sunday."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TemporalAbstraction> .

<http://www.ontotext.com/proton/protonext#DayTime> a owl:Class ;
    rdfs:label "Daytime"@en ;
    rdfs:comment "Specific time (point) during the day, when the day is not specified. Like in \"the supermarket is closing 20:30 p.m.\""@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TemporalAbstraction> .

<http://www.ontotext.com/proton/protonext#Delta> a owl:Class ;
    rdfs:label "Delta"@en,
        "Delta of a River"@en ;
    rdfs:comment "(ADL FT) Flat plains formed by alluvial deposits at the mouth of a stream. NIMA GNS designator DLTA."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Deputy> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Deputy"@en ;
    rdfs:comment "The occupation of deputy"@en .

<http://www.ontotext.com/proton/protonext#Desert> a owl:Class ;
    rdfs:label "Desert"@en ;
    rdfs:comment "(ADL FT) Regions rendered barren or partially barren by environmental extremes, especially by low rainfall. [USGS Circ 1048] We use this category for arid regions; for bajadas; for rock deserts; for sandy areas; for sandy deserts; and for stony deserts. NIMA GNS designators DSRT, ERG, HMDA, REG."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#Disease> a owl:Class ;
    rdfs:label "Disease"@en ;
    rdfs:comment "A specific sort of desease, such as AIDS, SARS, Parcinson, etc. The instances of those class can often by considered as terms instead of entities, but in all cases, those are the general phenomena, not the particular situations when somebody is suffering the disease."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#Ditch> a owl:Class ;
    rdfs:label "Ditch"@en ;
    rdfs:comment "A ditch is usually defined as a small to moderate depression created to channel water.(Wikipedia). http://www.eionet.europa.eu/gemet/concept/2276. NIMA GNS designators H.DTCH, H.DTCHD, H.DTCHI, H.DTCHM."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Canal>,
        <http://www.ontotext.com/proton/protonext#HydrographicStructure> .

<http://www.ontotext.com/proton/protonext#Division> a owl:Class ;
    rdfs:label "Division"@en ;
    rdfs:comment "Branch, division, department, laboratory, etc. within an organisation. Usually, not a legal agent and not independent."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#DrainageBasin> a owl:Class ;
    rdfs:label "Drainage Basin"@en ;
    rdfs:comment "An area drained by a stream. NIMA GNS designator L.BSND."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Drug> a owl:Class ;
    rdfs:label "Drug"@en ;
    rdfs:comment "A chemical substance used to improve the health condition of a person, animal, etc. For example, Aspirin, Viagra, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ChemicalCompound> .

<http://www.ontotext.com/proton/protonext#Election> a owl:Class ;
    rdfs:label "Election"@en ;
    rdfs:comment "Generic concept of Election which is normally held at regular periods of time, president elections of the US, municipal elections, etc.."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#RecurringEvent> .

<http://www.ontotext.com/proton/protonext#ElectionOccurrence> a owl:Class ;
    rdfs:label "Election"@en ;
    rdfs:comment "Election happening at a particular date."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#EmbryoBodyPart> a owl:Class ;
    rdfs:label "Embryo Body Part"@en ;
    rdfs:comment "Embryology is a science that studies the development of the embryo. This class denotes different composing substances/elements of the embryo and related body parts, and hence is referred to as a body part. It is inspired form DBPedia Embryology/AnatomicalStructure, which has instances as Blastocyst, Amniotic cavity, Vitelline membrane, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BodyPart> .

<http://www.ontotext.com/proton/protonext#Estuary> a owl:Class ;
    rdfs:label "Estuary"@en ;
    rdfs:comment "A partly enclosed coastal body of water with one or more rivers or streams flowing into it, and with a free connection to the open sea. NIMA GNS designator H.ESTY."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#EthnicGroup> a owl:Class ;
    rdfs:label "Ethnic Group"@en ;
    rdfs:comment "Any ethnic group. A group of people whose members identify with each other, through a common heritage, often consisting of a common language, a common culture (often including a shared religion) and an ideology that stresses common ancestry or endogamy. (Wikipedia)."@en ;
    rdfs:subClassOf ns1:Group .

<http://www.ontotext.com/proton/protonext#FInlet> a owl:Class ;
    rdfs:label "Former Inlet"@en ;
    rdfs:comment "An inlet which has been filled in, or blocked by deposits"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#FashionModel> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Model"@en ;
    rdfs:comment "Any model, a profession involving posing to draw attention to a particualr object or cause."@en .

<http://www.ontotext.com/proton/protonext#FestivalOccurrence> a owl:Class ;
    rdfs:label "Festival Held at a Particular Time"@en ;
    rdfs:comment "An occurrence of a Festival or holiday, Sofia Film Festival 2011, Christmas of 2010 or St. Valentine's Day of 2011."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#FieldHockeyLeague> a owl:Class ;
    rdfs:label "Field Hockey League"@en ;
    rdfs:comment "Any Field Hockey league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#FigureSkater> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Figure skater"@en ;
    rdfs:comment "The profession of figure skater"@en .

<http://www.ontotext.com/proton/protonext#FilmFestival> a owl:Class ;
    rdfs:label "Film Festival"@en ;
    rdfs:comment "Any festival involving showing a film."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Festival> .

<http://www.ontotext.com/proton/protonext#Fish> a owl:Class ;
    rdfs:label "Fish"@en ;
    rdfs:comment "A fish is any gill-bearing aquatic vertebrate (or craniate) animal that lacks limbs with digits. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Animal> .

<http://www.ontotext.com/proton/protonext#FishingArea> a owl:Class ;
    rdfs:label "Fishing Area"@en ;
    rdfs:comment "A bank or area where fishermen go to catch fish. NIMA GNS designator H.FISH."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Fjord> a owl:Class ;
    rdfs:label "Fjord"@en ;
    rdfs:comment "(ADL FT) Long narrow glacially-eroded inlets of the sea, U-shaped and steep-walled, generally several hundred meters deep, between high rocky cliffs or slopes along a mountainous coast. ... We use this category for fiords; and for lochs. NIMA GNS designator FJD, FJDS."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Bay> .

<http://www.ontotext.com/proton/protonext#Food> a owl:Class ;
    rdfs:label "Food"@en ;
    rdfs:comment "Food is any eatable or drinkable substance that is normally consumed by humans. DBPedia"@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#FootballMatch> a owl:Class ;
    rdfs:label "Football match"@en ;
    rdfs:comment "Any instance of a soccer match."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportGame> .

<http://www.ontotext.com/proton/protonext#Forest> a owl:Class ;
    rdfs:label "Forest"@en ;
    rdfs:comment "(ADL FT) Dense growths of trees, plants, and underbrush covering a large area. [American Heritage Dic. of the English Language, 4th ed.] We use this category for forest reserves; and for national forests. Omitted ADL sub-classes: Petrified forests, Rain forests, Woods (the sub-classes collapsed here). NIMA GNS designator FRST, FRSTF, GDVC, GRVO, GRVP, GRVPN, TREE."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#ForestClearing> a owl:Class ;
    rdfs:label "Clearing"@en ;
    rdfs:comment "An area in a forest with trees removed. NIMA GNS designator L.CLG."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#FormulaOneRacer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Formula one racer"@en ;
    rdfs:comment "The profession of formula one racer"@en .

<http://www.ontotext.com/proton/protonext#Fungus> a owl:Class ;
    rdfs:label "Fungus"@en ;
    rdfs:comment "Fungus is a member of a large group of eukaryotic organisms that includes microorganisms such as yeasts and molds (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LivingObject> .

<http://www.ontotext.com/proton/protonext#GaelicGamesPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Gaelic games player"@en ;
    rdfs:comment "The profession of gaelic games player"@en .

<http://www.ontotext.com/proton/protonext#Galaxy> a owl:Class ;
    rdfs:label "Galaxy"@en ;
    rdfs:comment "A galaxy is a massive, gravitationally bound system that consists of stars and stellar remnants, an interstellar medium of gas and dust, and an important but poorly understood component tentatively dubbed dark matter. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#AstronomicalObject> .

<http://www.ontotext.com/proton/protonext#Gap> a owl:Class ;
    rdfs:label "Gap"@en ;
    rdfs:comment "(ADL FT) Ravines or gorges cut deeply through mountain ridges, or between hills or mountains. We use this category for cols; for defiles; for passes; for saddles (physiographic); and for sills (physiographic). NIMA GNS designator GAP, GAPU, GAPF, PASS, SILL, SILU."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Gene> a owl:Class ;
    rdfs:label "Gene"@en ;
    rdfs:comment "A gene is a molecular unit of heredity of a living organism. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiologicalSubstance> .

<http://www.ontotext.com/proton/protonext#GeographicLocation> a owl:Class ;
    rdfs:label "Geographic Region"@en ;
