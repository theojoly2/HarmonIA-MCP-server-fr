<http://www.ontotext.com/proton/protonext#Gulf> a owl:Class ;
    rdfs:label "Gulf"@en ;
    rdfs:comment "(ADL FT) Largest of various forms of inlets of the sea; usually larger, more enclosed, and more deeply indented than bays. NIMA GNS designator GULF."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Bay> .

<http://www.ontotext.com/proton/protonext#Guyot> a owl:Class ;
    rdfs:label "Guyot"@en,
        "Tablemount"@en ;
