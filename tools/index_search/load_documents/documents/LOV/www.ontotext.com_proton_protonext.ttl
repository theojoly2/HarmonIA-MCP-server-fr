    rdfs:subClassOf ns1:Document .

<http://www.ontotext.com/proton/protonext#InlineHockeyLeague> a owl:Class ;
    rdfs:label "Inline Hockey League"@en ;
    rdfs:comment "Any Inline Hockey league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#Insect> a owl:Class ;
    rdfs:label "Insect"@en ;
    rdfs:comment "Insects are a class within the arthropods that have a chitinous exoskeleton, a three-part body (head, thorax, and abdomen), three pairs of jointed legs, compound eyes, and two antennae. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Animal> .

<http://www.ontotext.com/proton/protonext#Institute> a owl:Class ;
    rdfs:label "Institute"@en ;
    rdfs:comment "A research organization devoted primarily on search in some scientific research."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ResearchOrganization> .

<http://www.ontotext.com/proton/protonext#InsuranceCompany> a owl:Class ;
    rdfs:label "Insurance Company"@en ;
    rdfs:comment "A company providing insurance services agains different dangerous or risky events."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Company> .

<http://www.ontotext.com/proton/protonext#InternationalOrganization> a owl:Class ;
    rdfs:label "International Organization"@en ;
    rdfs:comment "Legal international organization. Legal in this case means officially recognized by more than one government."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#InternetDomain> a owl:Class ;
    rdfs:label "Internet Domain"@en ;
    rdfs:comment "A domain name is an identification string that defines the area of administrative autonomy, authority, or control in the Internet. Wikipedia."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#InternetAddress> .

<http://www.ontotext.com/proton/protonext#IrrigationSystem> a owl:Class ;
    rdfs:label "Irrigation System"@en ;
    rdfs:comment "A network of ditches and one or more of the following elements: water supply, reservoir, canal, pump, well, drain, etc. NIMA GNS designator H.SYSI."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Isthmus> a owl:Class ;
    rdfs:label "Isthmus"@en ;
    rdfs:comment "(ADL FT) Narrow sections of land in a body of water connecting two larger land areas. NIMA GNS designator ISTH."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Journalist> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Journalist"@en ;
    rdfs:comment "Any journalist, a profession of collecting and disseminating information about current events, people, trends, and issues. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#Judge> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Judge"@en ;
    rdfs:comment "Any judge, a profession of presiding over a court of law, either alone or as part of a panel of judges. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#Jungle> a owl:Class ;
    rdfs:label "Jungle"@en ;
    rdfs:comment "(ADL FT) Tropical regions of wild, tangled, dense vegetation. NIMA GNS designator - no equivalent."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#LacrosseLeague> a owl:Class ;
    rdfs:label "Lacrosse League"@en ;
    rdfs:comment "Any Lacrosse league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#Lagoon> a owl:Class ;
    rdfs:label "Lagoon"@en ;
    rdfs:comment "A body of water cut off from the open sea by coral reefs or sand bars. http://www.eionet.europa.eu/gemet/concept/4589. NIMA GNS designator H.LGN, H.LGNS, H.LGNX."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#LandArea> a owl:Class ;
    rdfs:label "Area"@en ;
    rdfs:comment "A tract of land without homogeneous character or boundaries. NIMA GNS designator L.AREA."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#LaunchFacility> a owl:Class ;
    rdfs:label "Launch Facility"@en ;
    rdfs:comment "(ADL FT) Areas from which rockets/missiles may be housed and projected, usually equipped with associated buildings and facilities. [USGS Circ 1048] We use this category for missile sites. NIMA GNS designator - no equivalent."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TransportFacility> .

<http://www.ontotext.com/proton/protonext#LawFirm> a owl:Class ;
    rdfs:label "Law firm"@en ;
    rdfs:comment "A law firm is a business entity formed by one or more lawyers to engage in the practice of law. The primary service provided by a law firm is to advise clients (individuals or corporations) about their legal rights and responsibilities, and to represent their clients in civil or criminal cases, business transactions, and other matters in which legal advice and other assistance are sought. DBPedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Company> .

<http://www.ontotext.com/proton/protonext#Lawyer> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Lawyer"@en ;
    rdfs:comment "Any lawyer, a profession of according to Black's Law Dictionary, is a person learned in the law; as an attorney, counsel or solicitor; a person who is practicing law. of judges. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#LegalCases> a owl:Class ;
    rdfs:label "Legal Cases"@en ;
    rdfs:comment "Denotes concrete legal cases, such as Dennis v. United States, Francis v. Resweber, United_States v. Virginia, etc."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#Legislation> a owl:Class ;
    rdfs:label "Legislation"@en ;
    rdfs:comment "Various sorts of legislative documents, including consitutions, laws, etc."@en ;
    rdfs:subClassOf ns1:InformationResource .

<http://www.ontotext.com/proton/protonext#Library> a owl:Class ;
    rdfs:label "Library"@en ;
    rdfs:comment "A collection of books, journals, audio and video materials, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ResourceCollection> .

<http://www.ontotext.com/proton/protonext#LibraryBuilding> a owl:Class ;
    rdfs:label "Library"@en ;
    rdfs:comment "A building in which library organization is housed."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#LibraryOrganization> a owl:Class ;
    rdfs:label "Library"@en ;
    rdfs:comment "An education organization teaching pupils from first grade to tenth/eleventh/twelfth grade. It could be a primary school, or a secondary school."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#EducationalOrganization> .

<http://www.ontotext.com/proton/protonext#Lieutenant> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Lieutenant"@en ;
    rdfs:comment "Any lieutenant, title in a military unit."@en .

<http://www.ontotext.com/proton/protonext#LightHouse> a owl:Class ;
    rdfs:label "Lighthouse"@en ;
    rdfs:comment "A tower, building, or other type of structure designed to emit light from a system of lamps and lenses and used as an aid to navigation for maritime pilots at sea or on inland waterways"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ReferenceLocation> .

<http://www.ontotext.com/proton/protonext#LocalCapital> a owl:Class ;
    rdfs:label "Local Capital"@en ;
    rdfs:comment "A capital of a Province or smaller administrative region. NIMA GNS designator PPLA."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Capital> .

<http://www.ontotext.com/proton/protonext#Lock> a owl:Class ;
    rdfs:label "Lock"@en ;
    rdfs:comment "(ADL FT) Stretches of water in canals, streams, or docks, enclosed by gates at each end, and used in raising and lowering boats as they pass from one water level to another. NIMA GNS designator LOCK."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#HydrographicStructure>,
        <http://www.ontotext.com/proton/protonext#TransportFacility> .

<http://www.ontotext.com/proton/protonext#Locomotive> a owl:Class ;
    rdfs:label "Locomotive"@en ;
    rdfs:comment "Locomotive, a railway vehicle that provides the motive power for a train. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Vehicle> .

<http://www.ontotext.com/proton/protonext#LymphNode> a owl:Class ;
    rdfs:label "Lymphatic Node"@en ;
    rdfs:comment "Lymph is a general concept gathering all lymph nodes of the body."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BodyPart> .

<http://www.ontotext.com/proton/protonext#MagazineIssue> a owl:Class ;
    rdfs:label "Magazine Issue"@en ;
    rdfs:comment "A specific issue of a magazine, journal or digest."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#IssueOfPeriodical>,
        <http://www.ontotext.com/proton/protonext#ResourceCollection> .

<http://www.ontotext.com/proton/protonext#Manager> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Manager"@en ;
    rdfs:comment "Any manager, the title of a management position in an organization."@en .

<http://www.ontotext.com/proton/protonext#Market> a owl:Class ;
    rdfs:label "Market"@en ;
    rdfs:comment "In contrast to IndustrySector, the market is determined by the customers instead of the business or the manifacturers. The market can be defined in terms of types of goods/services, geographic region, price levels and typical customer behaviours. Corresponding to the third sense in WordNet 1.7.1 \"the customers for a particular product or service\"."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BusinessAbstraction> .

<http://www.ontotext.com/proton/protonext#Marsh> a owl:Class ;
    rdfs:label "Marsh"@en ;
    rdfs:comment "An area of open ground overlaid with wet peaty soils; a wetland dominated by grass-like vegetation; a flat area, subject to periodic salt water inundation, dominated by grassy salt-tolerant plants; a salt flat or salt encrusted plain subject to periodic inundation from flooding or high tides"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#MartialArtist> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Martial artist"@en ;
    rdfs:comment "The profession of a martial artist"@en .

<http://www.ontotext.com/proton/protonext#Mayor> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Mayor"@en ;
    rdfs:comment "Any Mayor, a title of the head of a municipality."@en .

<http://www.ontotext.com/proton/protonext#Meadow> a owl:Class ;
    rdfs:label "Meadow"@en ;
    rdfs:comment "A small, poorly drained area dominated by grassy vegetation"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#MeetingProceedings> a owl:Class ;
    rdfs:label "Meeting Proceedings"@en ;
    rdfs:comment "A collection of articles or presentations published as a book."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Book>,
        <http://www.ontotext.com/proton/protonext#ResourceCollection> .

<http://www.ontotext.com/proton/protonext#MemberOfParliament> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Member of Parliament"@en ;
    rdfs:comment "Any member of parliament, a title of a member of parliament."@en .

<http://www.ontotext.com/proton/protonext#Message> a owl:Class ;
    rdfs:label "Message"@en ;
    rdfs:comment "A written message, including various postings in newspapers or public sources, job position adverts, etc."@en ;
    rdfs:subClassOf ns1:Document .

<http://www.ontotext.com/proton/protonext#MilitaryCommand> a owl:Class ;
    rdfs:label "Military Command"@en ;
    rdfs:comment "Any military command, the organization which has a commanding role in a military organization."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MilitaryUnit> .

<http://www.ontotext.com/proton/protonext#MilitaryPerson> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Military Person"@en ;
    rdfs:comment "Any occupation involving service in the military."@en .

<http://www.ontotext.com/proton/protonext#MineSite> a owl:Class ;
    rdfs:label "Mine Site"@en ;
    rdfs:comment "(ADL FT) Places or areas from which commercial minerals are or were removed by excavation from the Earth. [Adapted from USGS Feature Class Definitions <http://mapping.usgs.gov/www/ti/GNIS/gnis_users_guide_appendixc.html>] We use this category for adits (mine sites); for chrome mines; for coal mines; for collieries; for copper mines; for diatomite mines; for gold mines; for gravel pits; for iron mines; for lead mines; for mine entrances; for mine shafts; for mines; for mining areas; for mining camps; for nickel mines; for open pit mines; for placer mines; for quarries; for salt mines; for strip mines; and for tin mines. NIMA GNS designators MN, MNA, MNAU, MNC, MNCR, MNDT, MNCU, MNFE, MNN, MNNI, MNPB, MNPL. MNQ, MNSN."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#MixedMartialArtsLeague> a owl:Class ;
    rdfs:label "Mixed Martial Arts League"@en ;
    rdfs:comment "Any Mixed Martial Arts league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#Mollusca> a owl:Class ;
    rdfs:label "Mollusca"@en ;
    rdfs:comment "Mollusca is a large phylum of invertebrate animals. This is the largest marine phylum, comprising about 23% of all the named marine organisms. Numerous molluscs also live in freshwater and terrestrial habitats. Molluscs are highly diverse, not only in size and in anatomical structure, but also in behaviour and in habitat. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Animal> .

<http://www.ontotext.com/proton/protonext#Monarch> a <http://www.ontotext.com/proton/protonext#NobeltyTitle> ;
    rdfs:label "Monarch"@en ;
    rdfs:comment "Any Monarch, a title of a head of state in a monarchy."@en .

<http://www.ontotext.com/proton/protonext#Money> a owl:Class ;
    rdfs:label "Money"@en ;
    rdfs:comment "A specific amount of money in specific currency"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialAbstraction> .

<http://www.ontotext.com/proton/protonext#Month> a owl:Class ;
    rdfs:label "Month"@en ;
    rdfs:comment "A specific month, like Dec 2000, as a time period."@en ;
    rdfs:subClassOf ns1:TimeInterval .

<http://www.ontotext.com/proton/protonext#Monument> a owl:Class ;
    rdfs:label "Monument"@en ;
    rdfs:comment "(ADL FT) Structures erected as memorials. [Adapted from American Heritage Dic. of the English Language, 4th ed.] We use this category for cairns; for landmarks (monuments); for memorials; for national monuments; for pyramids; for shrines; for statues; and for tombs. NIMA GNS designators MNMT, PYR, PYRS, CARN."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#MotorcycleRacingLeague> a owl:Class ;
    rdfs:label "Motorcycle Racing League"@en ;
    rdfs:comment "Any Motorcycle Racing league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#MountainPass> a owl:Class ;
    rdfs:label "Mountain Pass"@en ;
    rdfs:comment "Any mountain pass. NIMA GNS designators - no direct equivalents"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#MountainRange> a owl:Class ;
    rdfs:label "Mountain Range"@en ;
    rdfs:comment "(ADL FT) (a) Chains of hills or mountains; (b) somewhat linear, complex mountainous or hilly areas. ... We use this category for ranges (physiographic); and for sierra. NIMA GNS designator RNGU."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Mountain> .

<http://www.ontotext.com/proton/protonext#MountainSummit> a owl:Class ;
    rdfs:label "Mountain Summit"@en ;
    rdfs:comment "(ADL FT) Peaks of mountains. [USGS Circ 1048] We use this category for ahus; for mountain crests; for nunataks; for peaks; and for summits. NIMA GNS designators PK, PKS, PKSU, PKU."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Mountain> .

<http://www.ontotext.com/proton/protonext#Movie> a owl:Class ;
    rdfs:label "Movie"@en ;
    rdfs:comment "A film, also called a movie or motion picture, is a series of still or moving images. Wikipedia."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaProduct> .

<http://www.ontotext.com/proton/protonext#MudFlat> a owl:Class ;
    rdfs:label "Mud Flat"@en ;
    rdfs:comment "A relatively level area of mud either between high and low tide lines, or subject to flooding; a large flat area of mud or sand attached to the shore and alternately covered and uncovered by the tide; a tropical tidal mud flat characterized by mangrove vegetation"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Muscle> a owl:Class ;
    rdfs:label "Muscle"@en ;
    rdfs:comment "Any muscle of a body."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BodyPart> .

<http://www.ontotext.com/proton/protonext#Museum> a owl:Class ;
    rdfs:label "Museum"@en ;
    rdfs:comment "Any museum, an institution that houses and cares for a collection of artifacts and other objects of scientific, artistic, or historical importance and makes them available for public viewing through exhibits that may be permanent or temporary. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#MusicCompany> a owl:Class ;
    rdfs:label "Musical Company"@en ;
    rdfs:comment "Any Musical company, a company involved in the music business, e.g. sells compositions, recordings and performances of music, like Soni Music Entertainment."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#EntertainmentCompany> .

<http://www.ontotext.com/proton/protonext#MusicFestival> a owl:Class ;
    rdfs:label "Music Festival"@en ;
    rdfs:comment "Any festival involving playing music."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Festival> .

<http://www.ontotext.com/proton/protonext#MusicGenre> a owl:Class ;
    rdfs:label "Music Genre"@en ;
    rdfs:comment "Any genre which pertians to music, e.g. classical, folk, pop, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Genre> .

<http://www.ontotext.com/proton/protonext#Musical> a owl:Class ;
    rdfs:label "Musical"@en ;
    rdfs:comment "Musical is a form of theatre or movie combining music, songs, spoken dialogue and dance. (Wikipedia)"@en ;
    rdfs:subClassOf ns1:ProductModel .

<http://www.ontotext.com/proton/protonext#Musician> a <http://www.ontotext.com/proton/protonext#ArtProfession> ;
    rdfs:label "Musician"@en ;
    rdfs:comment "Any musician, a profession of writing, performing, or making music. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#Narrows> a owl:Class ;
    rdfs:label "Narrows"@en ;
    rdfs:comment "A tidal strait. NIMA GNS designator H.NRWS."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#NascarDriver> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Nascar driver"@en ;
    rdfs:comment "The profession of nascar driver"@en .

<http://www.ontotext.com/proton/protonext#NationalCollegiateAthleticAssociationAthlete> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "National collegiate athletic association athlete"@en ;
    rdfs:comment "The profession of national collegiate athletic association athlete"@en .

<http://www.ontotext.com/proton/protonext#NaturalPhenomenon> a owl:Class ;
    rdfs:label "Natural Phenomenon"@en ;
    rdfs:comment "Such as particular disease, the Gulfstream and other similar natural abstractions. The particular events or objects which could instantiate an abstract natural phenomena (i.e. specific sickness event caused by a disease) are not instances of this class."@en ;
    rdfs:subClassOf ns1:Abstract .

<http://www.ontotext.com/proton/protonext#NaturalSatellite> a owl:Class ;
    rdfs:label "Natural Satellite"@en ;
    rdfs:comment "A satellite which is not a direct result of human activity"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Satellite> .

<http://www.ontotext.com/proton/protonext#Nerve> a owl:Class ;
    rdfs:label "Nerve"@en ;
    rdfs:comment "Nerve is a general concept gathering all nerves of a body."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BodyPart> .

<http://www.ontotext.com/proton/protonext#NewsAgency> a owl:Class ;
    rdfs:label "News agency"@en ;
    rdfs:comment "A news agency is an organization of journalists established to supply news reports to news organizations: newspapers, magazines, and radio and television broadcasters. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaCompany> .

<http://www.ontotext.com/proton/protonext#Newspaper> a owl:Class ;
    rdfs:label "Newspaper"@en ;
    rdfs:comment "A newspaper abstracted from its organizational and ownership aspects as well as from a specific issue or paper body."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PeriodicalPublication> .

<http://www.ontotext.com/proton/protonext#NewspaperIssue> a owl:Class ;
    rdfs:label "Newspaper Issue"@en ;
    rdfs:comment "A specific issue of a newspaper."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#IssueOfPeriodical>,
        <http://www.ontotext.com/proton/protonext#ResourceCollection> .

<http://www.ontotext.com/proton/protonext#NonAlcoholicBeverage> a owl:Class ;
    rdfs:label "Non Alcoholic Beverage"@en ;
    rdfs:comment "A type (specific receipe) for a beverage. For instance: Coca Cola, Schweppes, Apple Juice, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Beverage> .

<http://www.ontotext.com/proton/protonext#NonGeographicLocation> a owl:Class ;
    rdfs:label "Non-Geographic Location"@en ;
    rdfs:comment "A non-geographic region in some 3D space. The Longitude and Latitude properties for such objects could be void."@en ;
    rdfs:subClassOf ns1:Location .

<http://www.ontotext.com/proton/protonext#Oasis> a owl:Class ;
    rdfs:label "Oasis"@en ;
    rdfs:comment "(ADL FT) Fertile, vegetated areas in the midst of a desert, where the water table has come close enough to the surface for wells and springs or seepages to exist, thus making them suitable for human habitation. NIMA GNS designator OAS."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#Ocean> a owl:Class ;
    rdfs:label "Ocean"@en ;
    rdfs:comment "(ADL FT) Continuous salt-water bodies that surround the continents and fill the Earth's great depressions. NIMA GNS designator OCN"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Sea> .

<http://www.ontotext.com/proton/protonext#Offer> a owl:Class ;
    rdfs:label "Offer"@en ;
    rdfs:comment "Something offered (as a proposal or bid), WordNet 1.7.1. An offer is a statement made by the offerer to a specific agent or without recepient."@en ;
    rdfs:subClassOf ns1:Statement .

<http://www.ontotext.com/proton/protonext#OfficialPoliticalMeeting> a owl:Class ;
    rdfs:label "Official Political Meeting"@en ;
    rdfs:comment "A meeting whose main participants are political entities playing official roles within it."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Meeting> .

<http://www.ontotext.com/proton/protonext#OlympicGames> a owl:Class ;
    rdfs:label "Olympic Games"@en ;
    rdfs:comment "The institution of Olympic Games held every 4 years"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#RecurringEvent> .

<http://www.ontotext.com/proton/protonext#OlympicGamesOccurrence> a owl:Class ;
    rdfs:label "Olympic Games"@en ;
    rdfs:comment "A specific issue of the games, like Athens 2004"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportEvent> .

<http://www.ontotext.com/proton/protonext#OperaPerformance> a owl:Class ;
    rdfs:label "Opera Performance"@en ;
    rdfs:comment "An art performance following an opera music and script."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ArtPerformance> .

<http://www.ontotext.com/proton/protonext#Orchard> a owl:Class ;
    rdfs:label "Orchard"@en ;
    rdfs:comment "A planting of fruit or nut trees"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#Order> a owl:Class ;
    rdfs:label "Order"@en ;
    rdfs:comment "A statement used to request someone to supply something in return for payment and providing specifications and quantities. WordNet 2.1."@en ;
    rdfs:subClassOf ns1:Statement .

<http://www.ontotext.com/proton/protonext#Overfalls> a owl:Class ;
    rdfs:label "Overfalls"@en ;
    rdfs:comment "An area of breaking waves caused by the meeting of currents or by waves moving against the current. NIMA GNS designator H.OVF."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#PaintballLeague> a owl:Class ;
    rdfs:label "Paintball League"@en ;
    rdfs:comment "Any Paintball league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#Painting> a owl:Class ;
    rdfs:label "painting"@en ;
    rdfs:comment "Any painting, the results of a practice of applying paint, pigment, color or other medium[1] to a surface (support base). (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PieceOfArt> .

<http://www.ontotext.com/proton/protonext#Parish> a owl:Class ;
    rdfs:label "Parish"@en ;
    rdfs:comment "A district of religious land. NIMA GNS designator A.PRSH."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PopulatedPlace> .

<http://www.ontotext.com/proton/protonext#Park> a owl:Class ;
    rdfs:label "Park"@en ;
    rdfs:comment "(ADL FT) Places or areas developed for public use or recreation. [USGS Circ 1048] We use this category for arboretums; for botanical gardens; for commemorative areas; for commons; for gardens; for marine parks; for national forests; for national parks; for national seashores; for park gates; for picnic areas; for playgrounds; for provincial parks; for public use areas; for recreation areas; for rest areas; for scenic areas; for state forests; for state parks; for urban parks; for village squares; for wilderness areas; for zoological gardens; and for zoos. Omitted sub-classes: Viewing locations. NIMA GNS designators PRK, PRKHQ, PRKGT"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#Parliament> a owl:Class ;
    rdfs:label "Parliament"@en ;
    rdfs:comment "A legislative assembly representative at national or regional level. It can also be called Senate, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PoliticalEntity> .

<http://www.ontotext.com/proton/protonext#Patent> a owl:Class ;
    rdfs:label "Patent"@en ;
    rdfs:comment "A registered (or awaiting registration) patent for specific invention or design."@en ;
    rdfs:subClassOf ns1:InformationResource .

<http://www.ontotext.com/proton/protonext#Peninsula> a owl:Class ;
    rdfs:label "Peninsula"@en ;
    rdfs:comment "A land region surrounded by water from most sides, but having land connect to bigger land region. NIMA GNS designator PEN, PENX."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Percent> a owl:Class ;
    rdfs:label "Percent"@en ;
    rdfs:comment "A specific percent value"@en ;
    rdfs:subClassOf ns1:Number .

<http://www.ontotext.com/proton/protonext#PerformanceSite> a owl:Class ;
    rdfs:label "Performance Site"@en ;
    rdfs:comment "Buildings where cultural events are presented before an audience. We use this category for amphitheaters; for amphitheatres; for auditoriums; for bowls (performance); for coliseums; for concert halls; for opera houses; for playhouses; for recital halls; for stages (performance); for symphony halls; for theaters; and for theatres. NIMA GNS designator AMTH."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building>,
        <http://www.ontotext.com/proton/protonext#RecreationalFacility> .

<http://www.ontotext.com/proton/protonext#PetroleumBasin> a owl:Class ;
    rdfs:label "Petroleum Basin"@en ;
    rdfs:comment "An area underlain by an oil-rich structural basin. NIMA GNS designator L.BSNP."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#OilField> .

<http://www.ontotext.com/proton/protonext#Philosopher> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Philosopher"@en ;
    rdfs:comment "Any philosopher, a profession of studying of general and fundamental problems, such as those connected with existence, knowledge, values, reason, mind, and language."@en .

<http://www.ontotext.com/proton/protonext#Pipeline> a owl:Class ;
    rdfs:label "Pipeline"@en ;
    rdfs:comment "(ADL FT) Tubular conduits of substantial length, with pumps, valves, and control devices, for conveying fluids, gases, or finely divided solids. [USGS Circ 1048] We use this category for compressor stations; for gas pipelines; for oil pipeline junctions; for oil pipeline terminals; for oil pipelines; for oil pumping stations; for pump houses; for pumphouses; for pumping stations; and for water pumping stations. NIMA GNS designators OILP, OILJ, TRMO, PMPO, PMPW."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TransportFacility> .

<http://www.ontotext.com/proton/protonext#Plain> a owl:Class ;
    rdfs:label "Plain"@en ;
    rdfs:comment "(ADL FT) Regions of general uniform slope, comparatively level and of considerable extent. [USGS Circ 1048] We use this category for interfluves; and for llanos. NIMA GNS designators PLN, PLNU, PLNX, INTF."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Planet> a owl:Class ;
    rdfs:label "Planet"@en ;
    rdfs:comment "Any of the celestial bodies (other than comets or satellites) that revolve around the sun in the solar system. Definition partly derived from WordNet 1.7"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#AstronomicalObject> .

<http://www.ontotext.com/proton/protonext#Plateau> a owl:Class ;
    rdfs:label "Plateau"@en ;
    rdfs:comment "(ADL FT) Comparatively flat areas of great extent and elevation; specif. extensive land regions considerably above the adjacent country or above sea level; commonly limited on at least one side by an abrupt descent, have flat or nearly smooth surfaces but are often dissected by deep valleys and surmounted by high hills or mountains, and have a large part of their total surface at or near the summit level. We use this category for table mountains; and for tablelands. The ADL type Mesas, collapsed here. NIMA GNS designators PLAT, PLTX, PLTU, MESA, MESU, TMSU, TMST."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Play> a owl:Class ;
    rdfs:label "Play"@en ;
    rdfs:comment "A play is a form of literature written by a playwright, usually consisting of scripted dialogue between characters, intended for theatrical performance rather than just reading. DBPedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PublishedMaterial> .

<http://www.ontotext.com/proton/protonext#PlayboyPlaymate> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Playboy playmate"@en ;
    rdfs:comment "The occupation of playboy playmate"@en .

<http://www.ontotext.com/proton/protonext#PokerPlayer> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Poker player"@en ;
    rdfs:comment "The profession of a poker player"@en .

<http://www.ontotext.com/proton/protonext#PolishKing> a <http://www.ontotext.com/proton/protonext#NobeltyTitle> ;
    rdfs:label "Polish king"@en ;
    rdfs:comment "A title of Polish kings."@en .

<http://www.ontotext.com/proton/protonext#PoliticalParty> a owl:Class ;
    rdfs:label "Political Party"@en ;
    rdfs:comment "An organization to gain political power. Definition taken from WordNet 1.7"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PoliticalEntity> .

<http://www.ontotext.com/proton/protonext#Politician> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Politician"@en ;
    rdfs:comment "Any Politician, a profession of participating in the political life of a given society."@en .

<http://www.ontotext.com/proton/protonext#PoloLeague> a owl:Class ;
    rdfs:label "Polo League"@en ;
    rdfs:comment "Any Polo league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#Pond> a owl:Class ;
    rdfs:label "Pond"@en ;
    rdfs:comment "A pond is a body of standing water, either natural or man-made, that is usually smaller than a lake. (Wikipedia). http://www.eionet.europa.eu/gemet/concept/6507. NIMA GNS designator H.PND, H.PNDI, H.PNDN, H.PNDNI, H.PNDS, H.PNDSF, H.PNDSI, H.PNDSN, H.MFGN."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Pool> a owl:Class ;
    rdfs:label "Pool"@en ;
    rdfs:comment "A small and comparatively still, deep part of a larger body of water. NIMA GNS designator H.POOL, H.POOLI."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Pope> a <http://www.ontotext.com/proton/protonext#ClericTitle> ;
    rdfs:label "Pope"@en ;
    rdfs:comment "Any Pope. the head of the Roman-Catholic church."@en .

<http://www.ontotext.com/proton/protonext#PopulatedPlaceName> a owl:Class ;
    rdfs:label "City Name"@en,
        "Country Name"@en,
        "Name of a Populated Place"@en,
        "Town Name"@en,
        "Village Name"@en ;
    rdfs:comment "Part of a postal address denoting the name of a village, town, city, country, etc."@en ;
    rdfs:subClassOf ns1:ContactInformation .

<http://www.ontotext.com/proton/protonext#PowerStation> a owl:Class ;
    rdfs:label "Power station"@en ;
    rdfs:comment "Any power station"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#President> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "President"@en ;
    rdfs:comment "Any president, a title of a president of a country or an organization."@en .

<http://www.ontotext.com/proton/protonext#Priest> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Priest"@en ;
    rdfs:comment "Any priest, a professsion of a person who is authorized to perform the sacred rites of a religion. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#PrimeMinister> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Prime Minister"@en ;
    rdfs:comment "Any prime minister, a title Prime minister of a country."@en .

<http://www.ontotext.com/proton/protonext#ProgrammingLanguage> a owl:Class ;
    rdfs:label "Programming language"@en ;
    rdfs:comment "A formal language for encoding of computer programs."@en ;
    rdfs:subClassOf ns1:Abstract .

<http://www.ontotext.com/proton/protonext#Project> a owl:Class ;
    rdfs:label "Project"@en ;
    rdfs:comment "A project is carefully planned event to achieve a particular aim. Based on Wikipedia."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#ProtectedArea> a owl:Class ;
    rdfs:label "Protected Area"@en ;
    rdfs:comment "Any Protected Area, an area which benefits of special attention and is with limited access or protected in other ways."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LocationOfSpecialInterest> .

<http://www.ontotext.com/proton/protonext#Protein> a owl:Class ;
    rdfs:label "Protein"@en ;
    rdfs:comment "Denotes any protein as a biological substance."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiologicalSubstance> .

<http://www.ontotext.com/proton/protonext#Province> a owl:Class ;
    rdfs:label "Province"@en ;
    rdfs:comment "(ADL FT: Countries, 1st Order Divisions) First-order divisions of a nation. [USGS Circ 1048] We use this category for cantons; for first-order administrative divisions; for provinces; for states; and for territories. NIMA GNS designator ADM1. Also corresponds to the FIPS 10-4 principal administrative division defined as \"an administrative area directly subordinate to the pertinent governing authority \" NIMA GNS designator ADM1."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PoliticalRegion>,
        <http://www.ontotext.com/proton/protonext#PopulatedPlace> .

<http://www.ontotext.com/proton/protonext#PublishingCompany> a owl:Class ;
    rdfs:label "Publishing Company"@en ;
    rdfs:comment "An organization which main activity is mass publishing of information. Often, the publishers issue periodic and/or non-periodic documents on paper media. While on-line publishing is considered a typical activity for publishers, the streaming electronic media such as TV and Radio Stations are not."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaCompany> .

<http://www.ontotext.com/proton/protonext#Quarter> a owl:Class ;
    rdfs:label "Quarter"@en ;
    rdfs:comment "A specific quarter of a specific year, such as Q4 1999"@en ;
    rdfs:subClassOf ns1:TimeInterval .

<http://www.ontotext.com/proton/protonext#RaceCourse> a owl:Class ;
    rdfs:label "Race Course"@en ;
    rdfs:comment "A racecourse is a horse racing track."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportFacility> .

<http://www.ontotext.com/proton/protonext#RadioCompany> a owl:Class ;
    rdfs:label "Radio company"@en ;
    rdfs:comment "A company that broadcasts audio content."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Broadcaster> .

<http://www.ontotext.com/proton/protonext#RadioControlledRacingLeague> a owl:Class ;
    rdfs:label "Radio Controlled Racing League"@en ;
    rdfs:comment "Any Radio Controlled Racing league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#RadioStation> a owl:Class ;
    rdfs:label "Radio Station"@en ;
    rdfs:comment "A brand of a radio station."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaBrand> .

<http://www.ontotext.com/proton/protonext#RailroadTunnel> a owl:Class ;
    rdfs:label "Railroad Tunnel"@en ;
    rdfs:comment "A tunnel for trains. NIMA GNS designator RTNL."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#RailroadFacility>,
        <http://www.ontotext.com/proton/protonext#Tunnel> .

<http://www.ontotext.com/proton/protonext#Ramp> a owl:Class ;
    rdfs:label "Ramp"@en ;
    rdfs:comment "A gentle slope connecting areas of different elevations"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Rapids> a owl:Class ;
    rdfs:label "Rapids"@en ;
    rdfs:comment "A turbulent section of a stream associated with a steep, irregular stream bed. NIMA GNS designator H.RPDS."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Reef> a owl:Class ;
    rdfs:label "Reef"@en ;
    rdfs:comment "(ADL FT) Chains of rocks or coral at or near the surface of water. [USGS Circ 1048] We use this category for barrier reefs; and for fringing reefs. Collapsed ADL sub-class: Coral Reefs. NIMA GNS designator RF, RFSU, RFU, RFC, H.RFX."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Referee> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Referee"@en ;
    rdfs:comment "A referee is the person of authority, in a variety of sports, who is responsible for presiding over the game from a neutral point of view. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#ReligiousLocation> a owl:Class ;
    rdfs:label "Religious Location"@en ;
    rdfs:comment "Things like Monastery, Church"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#ReligiousOrganization> a owl:Class ;
    rdfs:label "Religious Organization"@en ;
    rdfs:comment "Organization which offers ideas and opinions about life. Just joking."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#Report> a owl:Class ;
    rdfs:label "Report"@en ;
    rdfs:comment "A document describing the result of some event."@en ;
    rdfs:subClassOf ns1:Document .

<http://www.ontotext.com/proton/protonext#Reptile> a owl:Class ;
    rdfs:label "Reptile"@en ;
    rdfs:comment "Reptiles are animals in the class Reptilia. They are characterized by breathing air, laying shelled eggs, and having skin covered in scales and/or scutes. Reptiles are classically viewed as having a \"cold-blooded\" metabolism. They are tetrapods. Modern reptiles inhabit every continent with the exception of Antarctica. Example of an reptile is the crocodile. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Animal> .

<http://www.ontotext.com/proton/protonext#Reserve> a owl:Class ;
    rdfs:label "Reserve"@en ;
    rdfs:comment "(ADL FT) Areas set aside for the preservation of fauna, flora, and their natural habitats. [Macmillan Encyc., 2001] We use this category for agricultural reserves; for conservation areas; for demonstration areas; for environmental areas; for forest reserves; for game management areas; for hunting reserves; for management areas (reserves); for natural areas; for nature reserves; for palm tree reserves; for preserves; for primitive areas; for protected areas; for reservations (nature sites); for road less areas; for sanctuaries (wildlife); for wildlife areas; for wildlife refuges; and for wildlife reserves. NIMA GNS designators RES, RESA, RESF, RESH, RESN, RESP, RESV, RESW."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#Reservoir> a owl:Class ;
    rdfs:label "Reservoir"@en ;
    rdfs:comment "(ADL FT) Artificially impounded bodies of water. We use this category for covered reservoirs; and for intermittent reservoirs. (incl. dams) NIMA GNS designator RSV, RSVI."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#HydrographicStructure>,
        <http://www.ontotext.com/proton/protonext#Lake> .

<http://www.ontotext.com/proton/protonext#Restaurant> a owl:Class ;
    rdfs:label "Restaurant"@en ;
    rdfs:comment "Any restaurant, a place where food, drink and dessert to customers is prepared and served in return for money. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#Ridge> a owl:Class ;
    rdfs:label "Ridge"@en ;
    rdfs:comment "(ADL FT) Elevations with a narrow, elongated crest which can be part of a hill or mountain. ... We use this category for aretes; for beach ridges; for cuestas; for eskers; for hogbacks; for icecap ridges; for rises (seafloor); and for spurs (physiographic). Omitted ADL sub-classes: Drumlin. NIMA GNS designators RDGB, RDGE, RDGG, RDGU, RISU, SPRU, SPUR."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Mountain> .

<http://www.ontotext.com/proton/protonext#River> a owl:Class ;
    rdfs:label "River"@en ;
    rdfs:comment "(ADL FT) Natural freshwater surface streams of considerable volume and a permanent or seasonal flow, moving in a definite channel toward a sea, lake, or another river; any large streams, or ones larger than brooks or creeks, such as the trunk stream and larger branches of a drainage system. We use this category for rios. NIM GNS designators ... no direct equivalents!"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Stream> .

<http://www.ontotext.com/proton/protonext#RiverCutoff> a owl:Class ;
    rdfs:label "Cutoff"@en ;
    rdfs:comment "A new channel cut by a river across the neck of an oxbow. NIMA GNS designator H.CUTF."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#RugbyClub> a owl:Class ;
    rdfs:label "Rugby Club"@en ;
    rdfs:comment "A rugby team"@en,
        "A sport club that organizes the playing of rugby."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportClub> .

<http://www.ontotext.com/proton/protonext#RugbyLeague> a owl:Class ;
    rdfs:label "Rugby League"@en ;
    rdfs:comment "Any Rugby League"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#RugbyPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Rugby player"@en ;
    rdfs:comment "The profession of rugby player"@en .

<http://www.ontotext.com/proton/protonext#Saddleback> a owl:Class ;
    rdfs:label "Saddle"@en ;
    rdfs:comment "A low part, resembling in shape a saddle, in a ridge or between contiguous seamounts"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Saint> a owl:Class ;
    rdfs:label "Saint"@en ;
    rdfs:comment "Any saint, a holy person, in whom Christ dwells, whether in heaven or in earth."@en ;
    rdfs:subClassOf ns1:Person .

<http://www.ontotext.com/proton/protonext#Sale> a owl:Class ;
    rdfs:label "Sale"@en ;
    rdfs:comment "Any event in which a participant is receiving a good from another participant of the event on the basis of some payment."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#School> a owl:Class ;
    rdfs:label "School"@en ;
    rdfs:comment "An education organization teaching pupils from first grade to tenth/eleventh/twelfth grade. It could be a primary school, or a secondary school."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#EducationalOrganization> .

<http://www.ontotext.com/proton/protonext#Science> a owl:Class ;
    rdfs:label "Science"@en ;
    rdfs:comment "A well established, big research area"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ResearchArea> .

<http://www.ontotext.com/proton/protonext#Scientist> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Scientist"@en ;
    rdfs:comment "Any scientist, a profession of studying and making research on a particualr subject."@en .

<http://www.ontotext.com/proton/protonext#Scrubland> a owl:Class ;
    rdfs:label "Scrubland"@en ;
    rdfs:comment "An area of low trees, bushes, and shrubs stunted by some environmental limitation"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#Sculpture> a owl:Class ;
    rdfs:label "Sculpture"@en ;
    rdfs:comment "Any sculpture, three-dimensional artwork created by shaping or combining hard materials. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PieceOfArt> .

<http://www.ontotext.com/proton/protonext#SeaSound> a owl:Class ;
    rdfs:label "Sound"@en ;
    rdfs:comment "A long arm of the sea forming a channel between the mainland and an island or islands; or connecting two larger bodies of water. NIMA GNS designator H.SD."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#SeaTongue> a owl:Class ;
    rdfs:label "Tongue"@en ;
    rdfs:comment "An elongate (tongue-like) extension of a flat sea floor into an adjacent higher feature"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#SeaTrench> a owl:Class ;
    rdfs:label "Trench"@en ;
    rdfs:comment "A long, narrow, characteristically very deep and asymmetrical depression of the sea floor, with relatively steep sides"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#SeaTrough> a owl:Class ;
    rdfs:label "Trough"@en ;
    rdfs:comment "A long depression of the sea floor characteristically flat bottomed and steep sided, and normally shallower than a trench"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Seachannels> a owl:Class ;
    rdfs:label "Seachannels"@en ;
    rdfs:comment "Continuously sloping, elongated depressions commonly found in fans or plains and customarily bordered by levees on one or two sides (U.SCSU; U.SCSU)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Seamount> a owl:Class ;
    rdfs:label "Seamount"@en ;
    rdfs:comment "An elevation rising generally more than 1,000 meters and of limited extent across the summit. (U.SMSU; U.SMU)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Season> a owl:Class ;
    rdfs:label "Season"@en ;
    rdfs:comment "One of the seasons of the year. In the places with a temperate climate there are four seasons: spring, summer, autumn, and winter."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TemporalAbstraction> .

<http://www.ontotext.com/proton/protonext#Senator> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Senator"@en ;
    rdfs:comment "Any Senator, a title of the member of the senat."@en .

<http://www.ontotext.com/proton/protonext#Ship> a owl:Class ;
    rdfs:label "Ship"@en ;
    rdfs:comment "A vehicle which moves on water."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Vehicle> .

<http://www.ontotext.com/proton/protonext#Shoal> a owl:Class ;
    rdfs:label "Shoal"@en ;
    rdfs:comment "Hazards to surface navigation composed of unconsolidated material. (U.SHSU; U.SHLU)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#ShoppingMall> a owl:Class ;
    rdfs:label "Shopping Mall"@en ;
    rdfs:comment "Any Shopping Mall, a building which is a shopping mall"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#SingleAlbum> a owl:Class ;
    rdfs:label "Single"@en ;
    rdfs:comment "A representative for a musician album."@en,
        "Any Single Album"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Album>,
        <http://www.ontotext.com/proton/protonext#SingleSongOrAlbum> .

<http://www.ontotext.com/proton/protonext#SingleSong> a owl:Class ;
    rdfs:label "Single"@en ;
    rdfs:comment "A representative for an album or a musician song."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SingleSongOrAlbum>,
        <http://www.ontotext.com/proton/protonext#Song> .

<http://www.ontotext.com/proton/protonext#SiteOfSpecialScientificInterest> a owl:Class ;
    rdfs:label "Site of Special Scientific Interest"@en ;
    rdfs:comment "Any sites of special scientific interest, a place with scientific value, where some scientific activities or experiments are carried out, or which is observed for scientific reasons."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LocationOfSpecialInterest> .

<http://www.ontotext.com/proton/protonext#SkiArea> a owl:Class ;
    rdfs:label "Ski Area"@en ;
    rdfs:comment "Any Ski Area, a mounatain area (usually) where there re ski resorts or one can ski."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Skyscraper> a owl:Class ;
    rdfs:label "Skyscraper"@en ;
    rdfs:comment "Any Skyscraper, a highrise building, usually in downtown city areas."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#SnookerPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Snooker player"@en ;
    rdfs:comment "A profession of a sportsman that plays snooker, which is a billiard derivate. From DBPedia"@en .

<http://www.ontotext.com/proton/protonext#SoccerClub> a owl:Class ;
    rdfs:label "Soccer Club"@en ;
    rdfs:comment "A soccer (football) team"@en,
        "A sport club that organizes the playing of soccer."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportClub> .

<http://www.ontotext.com/proton/protonext#SoccerLeague> a owl:Class ;
    rdfs:label "Soccer League"@en ;
    rdfs:comment "Any Soccer league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#SoccerManager> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Soccer Manager"@en ;
    rdfs:comment "Any soccer manager, the title of a manager of a soccer team."@en .

<http://www.ontotext.com/proton/protonext#SoccerPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Soccer player"@en ;
    rdfs:comment "The profession of soccer player"@en .

<http://www.ontotext.com/proton/protonext#SoftballLeague> a owl:Class ;
    rdfs:label "Softball League"@en ;
    rdfs:comment "Any Softball league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#SoftwareAgent> a owl:Class ;
    rdfs:label "Software Agent" ;
    rdfs:comment "An artificial agent which operates in a software environment." ;
    rdfs:subClassOf ns1:Agent .

<http://www.ontotext.com/proton/protonext#SpaceMission> a owl:Class ;
    rdfs:label "Space Mission"@en ;
    rdfs:comment "Any Mission in space in which space shuttles or space crafts are involved."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#SpaceShuttle> a owl:Class ;
    rdfs:label "Space Shuttle"@en ;
    rdfs:comment "A Spaceshuttle is a reusable launch system and orbital spacecraft operated by the U.S. National Aeronautics and Space Administration (NASA) (Wikipedia)."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Spacecraft> .

<http://www.ontotext.com/proton/protonext#SpaceStation> a owl:Class ;
    rdfs:label "Space Station"@en ;
    rdfs:comment "Any Spacestation. A space station (also called an orbital station) is a manned satellite designed to remain in space. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Spacecraft> .

<http://www.ontotext.com/proton/protonext#SpeedwayLeague> a owl:Class ;
    rdfs:label "Speedway League"@en ;
    rdfs:comment "Any Speedway league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#SpeedwayTeam> a owl:Class ;
    rdfs:label "Speedway team"@en ;
    rdfs:comment "Any speedway team"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Team> .

<http://www.ontotext.com/proton/protonext#Sport> a owl:Class ;
    rdfs:label "Sport"@en ;
    rdfs:comment "A specific type of sport game"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialAbstraction> .

<http://www.ontotext.com/proton/protonext#SportsFederation> a owl:Class ;
    rdfs:label "Sports Federation"@en ;
    rdfs:comment "An organization representing which controls the practice of some sport on national, regional or international level."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportOrganization> .

<http://www.ontotext.com/proton/protonext#Stadium> a owl:Class ;
    rdfs:label "Stadium"@en ;
    rdfs:comment "A special sort of sport building, usually for open-air sports such as soccer."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportBuilding> .

<http://www.ontotext.com/proton/protonext#Star> a owl:Class ;
    rdfs:label "Star"@en ;
    rdfs:comment "An astronomic object of hot gases that radiates energy derived from thermonuclear reactions in the interior. Definition partly derived from WordNet 1.7"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#AstronomicalObject> .

<http://www.ontotext.com/proton/protonext#Station> a owl:Class ;
    rdfs:label "Station"@en ;
    rdfs:comment "Any station, a place where busses, trains, sheeps, boats, etc. stop, like railway station, bussstop, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#StockExchange> a owl:Class ;
    rdfs:label "Stock Exchange"@en ;
    rdfs:comment "Stock Exchange where public companies are traded, e. g. Nasdaq, NYSE, etc."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#StockExchangeIndex> a owl:Class ;
    rdfs:label "Stock Exchange Index"@en ;
    rdfs:comment "A stock exchange/market index is a method of measuring a section of the stock market. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BusinessAbstraction> .

<http://www.ontotext.com/proton/protonext#Street> a owl:Class ;
    rdfs:label "Street"@en ;
    rdfs:comment "The general notion for a roadway within a city or village, often, surrounded by buildings. We put here boulevards, streets, avenues, etc. NIMA GNS designator - missing."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Roadway> .

<http://www.ontotext.com/proton/protonext#StreetName> a owl:Class ;
    rdfs:label "Street Name"@en ;
    rdfs:comment "Part of a postal address denoting the street name."@en ;
    rdfs:subClassOf ns1:ContactInformation .

<http://www.ontotext.com/proton/protonext#StreetNumber> a owl:Class ;
    rdfs:label "Street Number"@en ;
    rdfs:comment "Part of a postal address denoting the street number."@en ;
    rdfs:subClassOf ns1:ContactInformation .

<http://www.ontotext.com/proton/protonext#Swimmer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Swimmer"@en ;
    rdfs:comment "The profession of swimmer"@en .

<http://www.ontotext.com/proton/protonext#TVChannel> a owl:Class ;
    rdfs:label "TV Channel"@en ;
    rdfs:comment "A brand of a television channel."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaBrand> .

<http://www.ontotext.com/proton/protonext#TVCompany> a owl:Class ;
    rdfs:label "TV company"@en ;
    rdfs:comment "A company that broadcasts audio and video content."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Broadcaster> .

<http://www.ontotext.com/proton/protonext#Telecom> a owl:Class ;
    rdfs:label "Telecom"@en ;
    rdfs:comment "A telecommunications company"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Company> .

<http://www.ontotext.com/proton/protonext#TelevisionEpisode> a owl:Class ;
    rdfs:label "Television Episode"@en ;
    rdfs:comment "Denotes any episod of any television series."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TelevisionProduct> .

<http://www.ontotext.com/proton/protonext#TelevisionShow> a owl:Class ;
    rdfs:label "Television Show"@en ;
    rdfs:comment "Any television show"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TelevisionProduct> .

<http://www.ontotext.com/proton/protonext#TennisLeague> a owl:Class ;
    rdfs:label "Tennis League"@en ;
    rdfs:comment "Any Tennis league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#TennisPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Tennis player"@en ;
    rdfs:comment "The profession of tennis player"@en .

<http://www.ontotext.com/proton/protonext#Territory> a owl:Class ;
    rdfs:label "Territory"@en ;
    rdfs:comment "Territory a region of land which can be a part of contry that is non-sovereign or a geographic region determined by some charateristics. (Wikipedia) (http://www.eionet.europa.eu/gemet/concept?ns=1&cp=8401. NIMA GNS designator A.TERR."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#TheatrePerformance> a owl:Class ;
    rdfs:label "Theatre Performance"@en ;
    rdfs:comment "An art performance following a stage play."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ArtPerformance> .

<http://www.ontotext.com/proton/protonext#TimeZone> a owl:Class ;
    rdfs:label "Time Zone"@en ;
    rdfs:comment "A time zone is a region on Earth that has a uniform standard time for legal, commercial, and social purposes. Wikipedia."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TemporalAbstraction> .

<http://www.ontotext.com/proton/protonext#Tournament> a owl:Class ;
    rdfs:label "Tournament"@en ;
    rdfs:comment "A Tournament which is held regularly at particular time intervals, every year, every week, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#RecurringEvent> .

<http://www.ontotext.com/proton/protonext#TournamentOccurrence> a owl:Class ;
    rdfs:label "Tournament"@en ;
    rdfs:comment "A Tournament held at a particular time"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportEvent> .

<http://www.ontotext.com/proton/protonext#Tower> a owl:Class ;
    rdfs:label "Tower"@en ;
    rdfs:comment "(ADL FT) Manmade structures, higher than their diameter, generally used for observation, storage, or electronic transmission. We use this category for carillons; for fire lookouts; and for pagodas. NIMA GNS designator TOWR."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building> .

<http://www.ontotext.com/proton/protonext#Town> a owl:Class ;
    rdfs:label "Town"@en ;
    rdfs:comment "Any town"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Settlement> .

<http://www.ontotext.com/proton/protonext#TradeUnion> a owl:Class ;
    rdfs:label "Trade Union"@en ;
    rdfs:comment "Any Trade Union, an organization of workers that have banded together to achieve common goals such as better working conditions. (Wikipedia)"@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#Tundra> a owl:Class ;
    rdfs:label "Tundra"@en ;
    rdfs:comment "(ADL FT) Treeless, level, or gently rolling plains characteristic of arctic or subarctic regions, having a permanently frozen subsoil, and usually supporting low growing vegetation such as lichens, mosses, and stunted shrubs. [USGS Circ 1048] We use this category for Arctic land. NIMA GNS designator TUND, LAND."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#University> a owl:Class ;
    rdfs:label "University"@en ;
    rdfs:comment "An educational organization higher than school."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#EducationalOrganization>,
        <http://www.ontotext.com/proton/protonext#ResearchOrganization> .

<http://www.ontotext.com/proton/protonext#UrbanDistrict> a owl:Class ;
    rdfs:label "Urban District"@en ;
    rdfs:comment "(ADL FT: Countries, 3rd order divisions) Minor civil units. [USGS Circ 1048] We use this category for barrios; for precincts; for third-order administrative divisions; and for townships. NIMA GNS designator ADM3."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PoliticalRegion>,
        <http://www.ontotext.com/proton/protonext#PopulatedPlace> .

<http://www.ontotext.com/proton/protonext#Vein> a owl:Class ;
    rdfs:label "Vein"@en ;
    rdfs:comment "Vein is a general concept gathering all veins of a body."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BodyPart> .

<http://www.ontotext.com/proton/protonext#VicePresident> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Vice President"@en ;
    rdfs:comment "Any Vice President, the title of a vice president in a country or in an organization."@en .

<http://www.ontotext.com/proton/protonext#VicePrimeMinister> a <http://www.ontotext.com/proton/protonext#JobTitle> ;
    rdfs:label "Vice Prime Minister"@en ;
    rdfs:comment "Any Vice Prime Minister, the title of a vice prime minister in a country."@en .

<http://www.ontotext.com/proton/protonext#VideoGame> a owl:Class ;
    rdfs:label "Video Game"@en ;
    rdfs:comment "Any electronic game that involves interaction with a user interface to generate visual feedback on a video device. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Software> .

<http://www.ontotext.com/proton/protonext#VideogamesLeague> a owl:Class ;
    rdfs:label "Videogames League"@en ;
    rdfs:comment "Any Videogames league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#Village> a owl:Class ;
    rdfs:label "Village"@en ;
    rdfs:comment "Any village"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Settlement> .

<http://www.ontotext.com/proton/protonext#Vineyard> a owl:Class ;
    rdfs:label "Vineyard"@en ;
    rdfs:comment "Plantings of grapevines"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BiogeographicRegion> .

<http://www.ontotext.com/proton/protonext#Volcano> a owl:Class ;
    rdfs:label "Volcano"@en ;
    rdfs:comment "(ADL FT) Vents in the surface of the Earth through which magma and associated gases erupt; also, the forms or structures, usually conical, that are produced by the erupted material. NIMA GNS designator VLC."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Mountain> .

<http://www.ontotext.com/proton/protonext#VolleyballLeague> a owl:Class ;
    rdfs:label "Volleyball League"@en ;
    rdfs:comment "Any Volleyball league"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportsLeague> .

<http://www.ontotext.com/proton/protonext#VolleyballPlayer> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Snooker player"@en ;
    rdfs:comment "A profession of a volleyball player."@en .

<http://www.ontotext.com/proton/protonext#Wadi> a owl:Class ;
    rdfs:label "Wadi"@en ;
    rdfs:comment "A valley or ravine, bounded by relatively steep banks. NIMA GNS designator H.WAD, H.WADB, H.WADJ, H.WADM, H.WADS, H.WADX."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#WaterBank> a owl:Class ;
    rdfs:label "Water Bank"@en ;
    rdfs:comment "(ADL FT: Banks) Sloping margins of, or the ground bordering, a stream, and serving to confine the water to the natural channel during the normal course of flow. [Glossary of Geology, 4th ed.] We use this category for stream banks. NIMA GNS designator BKSU, BNK, BNKR, BNKU, BNKX."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#WaterCurrent> a owl:Class ;
    rdfs:label "Current"@en ;
    rdfs:comment "A net transport of ocean water along a definable path. http://www.eionet.europa.eu/gemet/concept/5792 NIMA GNS designator H.CRNT."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#WaterReach> a owl:Class ;
    rdfs:label "Reach"@en ;
    rdfs:comment "A straight section of a navigable stream or channel between two bends. NIMA GNS designator H.RCH."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#WaterTank> a owl:Class ;
    rdfs:label "Water Tank"@en ;
    rdfs:comment "A contained pool or tank of water at, below, or above ground level. NIMA GNS designator H.RSVT."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#HydrographicStructure>,
        <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Watercourse> a owl:Class ;
    rdfs:label "Watercourse"@en ;
    rdfs:comment "A natural, well-defined channel produced by flowing water, or an artificial channel designed to carry flowing water. NIMA GNS designator H.WTRC."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#HydrographicStructure>,
        <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Waterfalls> a owl:Class ;
    rdfs:label "Waterfalls"@en ;
    rdfs:comment "(ADL FT) Perpendicular or very steep falls of water in the course of a stream. ... We use this category for cascades; for cataracts; and for falls. NIMA GNS designator FLLS, FLLSX"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Waterhole> a owl:Class ;
    rdfs:label "Waterhole"@en ;
    rdfs:comment "A natural hole, hollow, or small depression that contains water, used by man and animals, especially in arid areas. NIMA GNS designator H.WTRH."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#WeaponModelOrSystem> a owl:Class ;
    rdfs:label "Weapon Model or System"@en ;
    rdfs:comment "A concrete model of a weapon that determines its main features. For example, Patriot, SU-28, and Kalashnikov."@en ;
    rdfs:subClassOf ns1:ProductModel .

<http://www.ontotext.com/proton/protonext#Week> a owl:Class ;
    rdfs:label "Week"@en ;
    rdfs:comment "A specific week of a specific year (say the 41st of 2001)"@en ;
    rdfs:subClassOf ns1:TimeInterval .

<http://www.ontotext.com/proton/protonext#Well> a owl:Class ;
    rdfs:label "Well"@en ;
    rdfs:comment "A cylindrical hole, pit, or tunnel drilled or dug down to a depth from which water, oil, or gas can be pumped or brought to the surface. NIMA GNS designator H.WLL, H.WLLQ, H.WLLS."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#HydrographicStructure>,
        <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Whirlpool> a owl:Class ;
    rdfs:label "Whirlpool"@en ;
    rdfs:comment "A turbulent, rotating movement of water in a stream. NIMA GNS designator H.WHRL."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#WineRegion> a owl:Class ;
    rdfs:label "Wine Region"@en ;
    rdfs:comment "Any Wine Region, a region where wine is produced."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#WorldHeritageSite> a owl:Class ;
    rdfs:label "World Heritage Site"@en ;
    rdfs:comment "Any world heritage site, a old site with historic value of world magnitude to be preserved."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LocationOfSpecialInterest> .

<http://www.ontotext.com/proton/protonext#Wrestler> a <http://www.ontotext.com/proton/protonext#Sportsman> ;
    rdfs:label "Wrestler"@en ;
    rdfs:comment "The profession of wrestler"@en .

<http://www.ontotext.com/proton/protonext#Writer> a <http://www.ontotext.com/proton/protonext#ArtProfession> ;
    rdfs:label "Writer"@en ;
    rdfs:comment "Any writer, a profession of producing literary content. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#ZipCode> a owl:Class ;
    rdfs:label "ZipCode"@en ;
    rdfs:comment "Part of a postal address denoting the zip code."@en ;
    rdfs:subClassOf ns1:ContactInformation .

<http://www.ontotext.com/proton/protonext#Zone> a owl:Class ;
    rdfs:label "Zone"@en ;
    rdfs:comment "A land region defined to play a role. For example, a buffer between two nations in which military presence is minimal or absent or zone around the site of the Chernobyl disaster to protect people from radiation. (NIMA GNS designator A.ZN, A.ZNB."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#accountProvider> a owl:ObjectProperty ;
    rdfs:label "Account Provider"@en ;
    rdfs:comment "A relation between an account and an agent (usually organization) providing and managing it"@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Account> ;
    rdfs:range ns1:Agent .

<http://www.ontotext.com/proton/protonext#acquired> a owl:ObjectProperty ;
    rdfs:label "Acquired"@en ;
    rdfs:comment "The participant of an acquirement event which became a property of another participant in this event."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Acquirement> ;
    rdfs:range ns1:Organization .

<http://www.ontotext.com/proton/protonext#acquirer> a owl:ObjectProperty ;
    rdfs:label "Acquirer"@en ;
    rdfs:comment "The participant of an acquirement event which became an owner of another participant in this event."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Acquirement> ;
    rdfs:range ns1:Organization .

<http://www.ontotext.com/proton/protonext#activeInSector> a owl:ObjectProperty ;
    rdfs:label "Active in Sector"@en ;
    ns1:transitiveOver <http://www.ontotext.com/proton/protonext#subSectorOf> ;
    rdfs:comment "Denotes that the organization is active within the industry sector"@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#CommercialOrganization> ;
    rdfs:range <http://www.ontotext.com/proton/protonext#IndustrySector> .

<http://www.ontotext.com/proton/protonext#appointedBy> a owl:ObjectProperty ;
    rdfs:label "Appointed by"@en ;
    rdfs:comment "A concrete job position appointed by a given person."@en ;
    rdfs:domain ns1:JobPosition ;
    rdfs:range ns1:Person .

<http://www.ontotext.com/proton/protonext#appointmentFor> a owl:ObjectProperty ;
    rdfs:label "Posision"@en ;
    rdfs:comment "A concrete job position which is assigned to the position available in a given organization."@en ;
    rdfs:domain ns1:JobPosition ;
    rdfs:range <http://www.ontotext.com/proton/protonext#PositionOrganization> .

<http://www.ontotext.com/proton/protonext#architect> a owl:ObjectProperty ;
    rdfs:label "Architect"@en ;
    rdfs:comment "The relation between a facility and its architect."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Facility> ;
    rdfs:range [ a owl:Restriction ;
            owl:hasValue <http://www.ontotext.com/proton/protonext#Architect> ;
            owl:onProperty <http://www.ontotext.com/proton/protonext#hasProfession> ],
        [ a owl:Restriction ;
            owl:hasValue <http://www.ontotext.com/proton/protonext#Architect> ;
            owl:onProperty <http://www.ontotext.com/proton/protonext#hasProfession> ] .

<http://www.ontotext.com/proton/protonext#birthDate> a owl:DatatypeProperty ;
    rdfs:label "Birthday"@en ;
    rdfs:comment "The relation between a person and the date he/she is born."@en ;
    rdfs:domain ns1:Person .

<http://www.ontotext.com/proton/protonext#carAssemblyIn> a owl:ObjectProperty ;
    rdfs:label "Car Assembly in"@en ;
    rdfs:comment "The relation between a car model and the country it is assembled in."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#CarModel> ;
    rdfs:range <http://www.ontotext.com/proton/protonext#Country> .

<http://www.ontotext.com/proton/protonext#causeOfDeath> a owl:ObjectProperty ;
    rdfs:label "Cause of a Death"@en ;
    rdfs:comment "Any cause of death."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Death> ;
    rdfs:range ns1:Event .

<http://www.ontotext.com/proton/protonext#combatantFrom> a owl:ObjectProperty ;
    rdfs:label "Combatant from"@en ;
    rdfs:comment "the relation between a military unit and the organization it represents in a military conflict."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#MilitaryUnit> ;
    rdfs:range ns1:Organization ;
    rdfs:subPropertyOf ns1:partOf .

<http://www.ontotext.com/proton/protonext#compliantWithSchema> a owl:ObjectProperty ;
    rdfs:label "Compliant with Schema"@en ;
    rdfs:comment "It links a dataset with a schema it complies to."@en ;
    rdfs:domain ns1:InformationResource ;
    rdfs:range <http://www.ontotext.com/proton/protonext#DataSchema> .

<http://www.ontotext.com/proton/protonext#conflictCombatant> a owl:ObjectProperty ;
    rdfs:label "Combatant"@en ;
    rdfs:comment "The relation between a military organization, which participates as a combatant in a military conflict"@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#MilitaryConflict> ;
    rdfs:range <http://www.ontotext.com/proton/protonext#MilitaryOrganization> ;
    rdfs:subPropertyOf ns1:hasParticipant .

<http://www.ontotext.com/proton/protonext#containsLocation> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Contains a Location"@en ;
    rdfs:comment "Relation between two locations where the first contains the other."@en,
        "The relation between a location and another location that is contained by the first one."@en ;
    rdfs:domain ns1:Location ;
    rdfs:range ns1:Location ;
    owl:inverseOf ns1:subRegionOf,
        ns1:subРegionOf .

<http://www.ontotext.com/proton/protonext#currentFrequency> a owl:DatatypeProperty ;
    rdfs:label "Current Frequency"@en ;
    rdfs:comment "The relation between a recurring event and its frequency."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#RecurringEvent> .

<http://www.ontotext.com/proton/protonext#datePublished> a owl:DatatypeProperty ;
    rdfs:label "Date Published"@en ;
    rdfs:comment "Typically, associated with the creation or availability of the resource. Recommended best practice for encoding the date value is defined in a profile of ISO 8601 [W3CDTF] and includes (among others) dates of the form YYYY-MM-DD. This date is related to an event of publishing which here is implicit. If necessary for the task it can be made explicit in an extension of the ontology."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#PublishedMaterial> ;
    rdfs:subPropertyOf ns1:hasDate .

<http://www.ontotext.com/proton/protonext#deathDate> a owl:DatatypeProperty ;
    rdfs:label "Deathday"@en ;
    rdfs:comment "The relation between a person and the date he/she died."@en ;
    rdfs:domain ns1:Person .

<http://www.ontotext.com/proton/protonext#deathPlace> a owl:ObjectProperty ;
    rdfs:label "Place of Death"@en ;
    rdfs:comment "The relation between a person and the place he/she died."@en ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Location .

<http://www.ontotext.com/proton/protonext#designerOfFacility> a owl:ObjectProperty ;
    rdfs:label "Designer"@en ;
    rdfs:comment "Any author of engineering and architecture designs. The relation between an author and the facility he has designed."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:range <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#districtRepresented> a owl:ObjectProperty ;
    rdfs:label "Represented District"@en ;
    rdfs:comment "the relation between an official position, usually political and the location it represents. The district represented by an official position, usually political."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#OfficialPosition> ;
    rdfs:range ns1:Location .

<http://www.ontotext.com/proton/protonext#finalOccuranceDate> a owl:DatatypeProperty ;
    rdfs:label "Date of Last Occurance"@en ;
    rdfs:comment "The date of the last occurrence of a recurring event."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#RecurringEvent> ;
    rdfs:subPropertyOf ns1:endTime .

<http://www.ontotext.com/proton/protonext#firstOccuranceDate> a owl:DatatypeProperty ;
    rdfs:label "Date of First Occurance"@en ;
    rdfs:comment "The date of the first occurrence of a recurring event."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#RecurringEvent> ;
    rdfs:subPropertyOf ns1:startTime .

<http://www.ontotext.com/proton/protonext#fiscalNetIncome> a owl:DatatypeProperty ;
    rdfs:label "fiscal net income"@en ;
    rdfs:comment "Net Income last year."@en ;
