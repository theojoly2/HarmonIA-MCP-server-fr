<http://www.ontotext.com/proton/protonext#tradedOn> a owl:ObjectProperty ;
    rdfs:label "Traded on"@en ;
    rdfs:comment "Relates the Public Company to the Stock Exchange where it is traded"@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#PublicCompany> .

<http://www.ontotext.com/proton/protonext#transmission> a owl:DatatypeProperty ;
    rdfs:label "transmission"@en ;
    rdfs:comment "Describes the transmission type of a given car model"@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#CarModel> .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

<http://www.ontotext.com/proton/protonext#Account> a owl:Class ;
    rdfs:label "Account"@en ;
    rdfs:comment "An explicit agreement between agents. Typically, service providers (e.g. banks or ISPs) provide accounts to their customers or users, which are considered account owners. The existence of the account depends on the provider, even though the user owns it in some metaphoric sense. Examples could be bank, ISP, e-Commerce, ICQ, email accounts. The accounts are usually aligned with a sort of contract."@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#Activity> a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "Each activity is a Happening which involves volition and participants. It has temporal dimension. It is distinguished from Events by the fact that the activity does not trigger change of state and does not have a conceptual end point."@en ;
    rdfs:subClassOf ns1:Happening .

<http://www.ontotext.com/proton/protonext#Airport> a owl:Class ;
    rdfs:label "Airport"@en ;
    rdfs:comment "An airport, including heliports. NIMA GNS designators AIRP, AIRH."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TransportFacility> .

<http://www.ontotext.com/proton/protonext#Album> a owl:Class ;
    rdfs:label "Album"@en ;
    rdfs:comment "An recording of a several songs. Usually from the same singer."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#AudioRecording> .

<http://www.ontotext.com/proton/protonext#Brand> a owl:Class ;
    rdfs:label "Brand"@en ;
    rdfs:comment "The American Marketing Association defines a brand as a \"Name, term, design, symbol, or any other feature that identifies one seller's good or service as distinct from those of other sellers.\" Wikipedia. Examples: Dodge and Milka"@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#CelebrityTitle> a owl:Class ;
    rdfs:label "Celebrity"@en ;
    rdfs:comment "The social function of celebrity, a status of notoriety in the society."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialFunction> .

<http://www.ontotext.com/proton/protonext#DataSchema> a owl:Class ;
    rdfs:label "Data Schema"@en ;
    rdfs:comment "A particular notation for representation, standardization, and/or structuring of infomation. It can range from db schema, through ontology, to any sort of taxonomies, nomenclatures and subject hierarchies. Examples are Dublin Core, KIMO, SIC, XML, RDFS"@en ;
    rdfs:subClassOf ns1:InformationResource .

<http://www.ontotext.com/proton/protonext#Database> a owl:Class ;
    rdfs:label "Database"@en ;
    rdfs:comment "A dataset loaded in a system supporting search, update and other operations over the information in the dataset."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Dataset> .

<http://www.ontotext.com/proton/protonext#Dataset> a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A dataset is information encoded in a defined structure (for example, lists, tables, and databases), intended to be useful for direct machine processing (DCMI Type.) Somehow structured and interrelated body of information, data, or knowledge. This includes databases, knowledge bases, catalogues, registries, specific lists, etc. All tangible aspects (like media or host) are irrelevant for this class - it only considers the abstract information. What can be considered as a single document is outside the scope of this class, although it can be comprehensive in terms of size and structure."@en ;
    rdfs:subClassOf ns1:InformationResource .

<http://www.ontotext.com/proton/protonext#Date> a owl:Class ;
    rdfs:label "Date"@en ;
    rdfs:comment "A specific date, as 12th of April, 1956, as the time period (the 24 hours of the day)"@en ;
    rdfs:subClassOf ns1:TimeInterval .

<http://www.ontotext.com/proton/protonext#Death> a owl:Class ;
    rdfs:label "Death"@en ;
    rdfs:comment "The event to die."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#EMail> a owl:Class ;
    rdfs:label "E-mail"@en ;
    rdfs:comment "An identifier that determines a electronic mail box."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#InternetAddress> .

<http://www.ontotext.com/proton/protonext#ElectronicMap> a owl:Class ;
    rdfs:label "Map"@en ;
    rdfs:comment "A webpage of a map"@en ;
    rdfs:subClassOf ns1:Document .

<http://www.ontotext.com/proton/protonext#EntertainmentCompany> a owl:Class ;
    rdfs:label "Entertainment Company"@en ;
    rdfs:comment "Any Entertainment Company, a company involved in the entertainment business, e.g. Warner Brothers, MTV, Lido, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Company> .

<http://www.ontotext.com/proton/protonext#FaxNumber> a owl:Class ;
    rdfs:label "Fax Number"@en ;
    rdfs:comment "A phone number connected to a fax machine."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PhoneNumber> .

<http://www.ontotext.com/proton/protonext#FictionalCharacter> a owl:Class ;
    rdfs:label "Fictional Character"@en ;
    rdfs:comment "The characters in fictional artwork like movies, books, etc"@en ;
    rdfs:subClassOf ns1:Person .

<http://www.ontotext.com/proton/protonext#FloweringPlant> a owl:Class ;
    rdfs:label "Flowering plant"@en ;
    rdfs:comment "Any flowering plant"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Plant> .

<http://www.ontotext.com/proton/protonext#Game> a owl:Class ;
    rdfs:label "Game"@en ;
    rdfs:comment "Game. Activity involving participants usually divided in teams, which obeys particualr rules, and has often a winner."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Activity> .

<http://www.ontotext.com/proton/protonext#HistoricPlace> a owl:Class ;
    rdfs:label "Historic Place"@en ;
    rdfs:comment "Any Historic Place, an old place with historic value."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LocationOfSpecialInterest> .

<http://www.ontotext.com/proton/protonext#InformationSpace> a owl:Class ;
    rdfs:label "Information Space" ;
    rdfs:subClassOf ns1:Agent .

<http://www.ontotext.com/proton/protonext#Island> a owl:Class ;
    rdfs:label "Island"@en ;
    rdfs:comment "(ADL FT) Tracts of land smaller than a continent, surrounded by the water of an ocean, sea, lake or stream. [Glossary of Geology, 4th ed.] We use this category for atolls; for cays; for island arcs; for isles; for islets; for keys (islands); for land-tied islands; and for mangrove islands. NIMA GNS designator ISL, ISLF, ISLM, ISLS, ISLT, ISLX"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Lake> a owl:Class ;
    rdfs:label "Lake"@en ;
    rdfs:comment "(ADL FT) Use 'reservoirs' for human engineered lakes. Natural inland bodies of standing water, generally of appreciable size, occupying a depression in the Earth's surface. [Adapted from Glossary of Geology, 4th ed.] We use this category for beaver ponds; for crater lakes; for dry lakes; for fish ponds; for fishponds; for inland seas; for intermittent lakes; for intermittent oxbow lakes; for intermittent ponds; for intermittent pools; for intermittent salt lakes; for intermittent salt ponds; for lagoons; for laguna; for lake beds; for lochs; for millponds; for oxbow lakes; for ponds; for pools (water bodies); for salt evaporation ponds; for salt lakes; for salt ponds; and for tarns. NIMA GNS designators LBED, LK, LKC, LKI, LKN, LKNI, LKO, LKOI, LKS, LKSB, LKSC, LKSI, LKSN, LKSNI, LKX"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Magazine> a owl:Class ;
    rdfs:label "Magazine"@en ;
    rdfs:comment "A periodic paperback publication; \"it takes several years before a magazine starts to break even or make money\"), WordNet 1.7.1. This includes also journals and digests. The specific issues typically contain a number of different articles."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PeriodicalPublication> .

<http://www.ontotext.com/proton/protonext#Mammal> a owl:Class ;
    rdfs:label "Mammal"@en ;
    rdfs:comment "Mammals are members of a class of air-breathing vertebrate animals characterized by the possession of hair, three middle ear bones, and mammary glands functional in mothers with young. Most mammals also possess sweat glands and specialized teeth, and the largest group of mammals, the placentals, have a placenta which feeds the offspring during gestation. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Animal> .

<http://www.ontotext.com/proton/protonext#MilitaryConflict> a owl:Class ;
    rdfs:label "Military Conflict"@en ;
    rdfs:comment "An event of organized, armed, and often prolonged conflict carried on between states, nations, or other parties. Wikipedia."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#Ministry> a owl:Class ;
    rdfs:label "Ministry"@en ;
    rdfs:comment "(Department) A specific ministry or department, structural unit of the government of specific country with focus and authority on specific problems of the country."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#GovernmentOrganization> .

<http://www.ontotext.com/proton/protonext#MusicalComposition> a owl:Class ;
    rdfs:label "Musical Composition"@en ;
    rdfs:comment "An original piece of music."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaProduct> .

<http://www.ontotext.com/proton/protonext#MusicalInstrument> a owl:Class ;
    rdfs:label "Musical Instrument"@en ;
    rdfs:comment "Musical Instrument, a device created or adapted for the purpose of making musical sounds. (Wikipedia)"@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#Nationality> a owl:Class ;
    rdfs:label "Nationality" ;
    rdfs:comment "Any nationality. In most cases it is connected with a country name, but there are notionalities without countries - Kurd, etc."@en ;
    rdfs:subClassOf ns1:Abstract .

<http://www.ontotext.com/proton/protonext#Non-ProfitOrganisation> a owl:Class ;
    rdfs:label "Non-Orofit Organisation"@en ;
    rdfs:comment "Any Non-Profit Organization, an organization that does not distribute its surplus funds to owners or shareholders, but instead uses them to help pursue its goals. (Wikipedia)"@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#OilField> a owl:Class ;
    rdfs:label "Oil Field"@en ;
    rdfs:comment "(ADL FT) Areas with reserves of recoverable petroleum or where petroleum has been removed from the Earth. ... We use this category for gas fields; for gasfields; for oilfields; for petroleum fields; and for storage fields (petroleum). NIMA GNS designator CMPO, OILF, OILQ, OILW, PMPO, GASF."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#OutOfLawsTitle> a owl:Class ;
    rdfs:label "Criminal"@en ;
    rdfs:comment "Criminal, the social function of a person who has committed a crime and is out of the law."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialFunction> .

<http://www.ontotext.com/proton/protonext#Plant> a owl:Class ;
    rdfs:label "Plant"@en ;
    rdfs:comment "Plants are living organisms. They include familiar organisms such as trees, flowers, herbs, bushes, grasses, vines, ferns, mosses, and green algae. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LivingObject> .

<http://www.ontotext.com/proton/protonext#Possession> a owl:Class ;
    rdfs:label "Possessions"@en ;
    rdfs:comment "Any property, e.g. possessions, the situation of owning an object."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BusinessAbstraction> .

<http://www.ontotext.com/proton/protonext#PostalAddress> a owl:Class ;
    rdfs:label "Postal Address"@en ;
    rdfs:comment "An address of a geographical place - usually a building. A postal address consists, usually, of a country name, zip code, city/village name, street name and number, a person name."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Address> .

<http://www.ontotext.com/proton/protonext#RailroadFacility> a owl:Class ;
    rdfs:label "Railroad Facility"@en ;
    rdfs:comment "(ADL FT: Railroad Features) We use this category for metro rail stations; for railroad junctions; for railroad sidings; for railroad spurs; for railroad stations; for railroad stops; for railroad switches; for railroad yards; for railways; for subway stations; for switches (railroad); and for tramways. NIMA GNS designator RJCT, RR, RRQ, RSD, RSGNL, RSTN, RSTNQ, RSTP, RSTPQ, RYD."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TransportFacility> .

<http://www.ontotext.com/proton/protonext#ReferenceLocation> a owl:Class ;
    rdfs:label "Reference Location"@en ;
    rdfs:comment "(ADL FT) We use this category for astronomical stations; for beacons; for bench marks; for boundaries; for boundary markers; for buoys; for control points; for geodectic stations; for geographic centers; for landmarks (reference locations); for light houses; for light stations; for lighthouses; for markers; for milestones; for plaques; for poles (sphere); for triangulation stations; and for walls. NIMNA GNS designators LTHSE, BP, TRIG."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#ResearchArea> a owl:Class ;
    rdfs:label "Research Area"@en ;
    rdfs:comment "Specific research area, topic or field."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialAbstraction> .

<http://www.ontotext.com/proton/protonext#Roadway> a owl:Class ;
    rdfs:label "Roadway"@en ;
    rdfs:comment "(ADL FT) Open ways for passage of vehicles. [USGS Circ 1048] We use this category for caravan routes; for causeways; for drives; for highways; for intersections; for parkways; for road bends; for road cuts; for road junctions; for roads; for streets; and for traffic circles. NIMA GNS designators CSWY, CSWYQ, RD, RDA, RDB, RDCUT, RDJCT, RDST, RTE, STKR."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TransportFacility> .

<http://www.ontotext.com/proton/protonext#Sea> a owl:Class ;
    rdfs:label "Sea"@en ;
    rdfs:comment "(ADL FT) Large bodies of salt water. NIMA GNS designator SEA"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Section> a owl:Class ;
    rdfs:label "Section" ;
    rdfs:comment "An area of a document that can be considered a document in itself. Compare with pext:Mention, which is also an area of a document. Imported from the iSIM ontology."@en ;
    rdfs:subClassOf ns1:InformationResource .

<http://www.ontotext.com/proton/protonext#Software> a owl:Class ;
    rdfs:label "Software"@en ;
    rdfs:comment "Software is a collection of computer programs and related data that provide the instructions telling a computer what to do. (Wikipedia)"@en ;
    rdfs:subClassOf ns1:ProductModel .

<http://www.ontotext.com/proton/protonext#Song> a owl:Class ;
    rdfs:label "Song"@en ;
    rdfs:comment "An recording of a song."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#AudioRecording> .

<http://www.ontotext.com/proton/protonext#SportBuilding> a owl:Class ;
    rdfs:label "Sport Building"@en ;
    rdfs:comment "A building providing facilities for practice of sport(s)."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Building>,
        <http://www.ontotext.com/proton/protonext#SportFacility> .

<http://www.ontotext.com/proton/protonext#Spring> a owl:Class ;
    rdfs:label "Spring"@en ;
    rdfs:comment "(ADL FT) Places where underground water flows naturally to the surface of the Earth. ... We use this category for mineral springs; and for sulfur springs. NIMA GNS designators SPNG, SPNS, SPNT."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Stream> a owl:Class ;
    rdfs:label "Stream"@en ;
    rdfs:comment "(ADL FT) Linear bodies of water flowing on the Earth's surface. We use this category for anabranches; for brooks; for burns (hydrographic); for confluences; for creeks; for distributaries; for dry stream beds; for forks (physiographic features); for intermittent streams; for lost rivers; for meanders; for stream bends; for stream mouths; for tidal creeks; for tributaries; and for watercourses. NIMA GNS designators STM, STMA, STMB, STMC, STMD, STMH, STMI, STMIX, STMM, STMQ, STMS, STMSB, STMX"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#TelecomFacility> a owl:Class ;
    rdfs:label "Telecom Facility"@en ;
    rdfs:comment "(ADL FT: Telecommunication Features) We use this category for antenna field sites; for communication centers; for radio stations; for television stations; and for transmission lines. NIMA GNS designators COMC, STNR, STNS."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#Tunnel> a owl:Class ;
    rdfs:label "Tunnel"@en ;
    rdfs:comment "(ADL FT) Underground or underwater passages. [USGS Circ 1048] We use this category for canal tunnels; for railroad tunnels; and for road tunnels. NIMA GNS designator TNL, TNLC, TNLN, TNLRD, TNLS"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#TransportFacility> .

<http://www.ontotext.com/proton/protonext#User> a owl:Class ;
    rdfs:label "User" ;
    rdfs:subClassOf ns1:Agent .

<http://www.ontotext.com/proton/protonext#Valley> a owl:Class ;
    rdfs:label "Valley"@en ;
    rdfs:comment "(ADL FT) Low-lying land bordered by higher ground; especially elongate, relatively large gently sloping depressions of the Earth's surface, commonly situated between two mountains or between ranges of hills or mountains, and often containing a stream with an outlet. [Glossary of Geology, 4th ed.] We use this category for forks (physiographic features); for glens; for hanging valleys; for hollows; for median valleys; and for shelf valleys (seafloor). NIMA GNS designators VAL, VALG, VALU, VALS, VALX, VLSU, FRKU, FRSU, MDVU, SHVU."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#authorOf> a owl:ObjectProperty ;
    rdfs:label "Author"@en ;
    rdfs:comment "Any author of a product. Links any object to its author (producer)."@en ;
    rdfs:domain ns1:Object ;
    rdfs:range ns1:Agent ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#isAuthorOf> .

<http://www.ontotext.com/proton/protonext#birthPlace> a owl:ObjectProperty ;
    rdfs:label "Place of Birth"@en ;
    rdfs:comment "The relation between a person and the place he/she is born."@en ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:Location .

<http://www.ontotext.com/proton/protonext#hasEndOffset> a owl:DatatypeProperty ;
    rdfs:label "hasEndOffset" ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Mention> .

<http://www.ontotext.com/proton/protonext#hasMinister> a owl:ObjectProperty ;
    rdfs:label "has Minister"@en ;
    rdfs:comment "The relation between a minister and his/her ministry."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Ministry> ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:hasEmployee .

<http://www.ontotext.com/proton/protonext#hasSocialPositionCelebrity> a owl:ObjectProperty ;
    rdfs:label "has Social Position Celebrity"@en ;
    rdfs:comment "The relation between a person and the social position of Celebrity he has."@en ;
    rdfs:domain ns1:Person ;
    rdfs:range <http://www.ontotext.com/proton/protonext#Celebrity> ;
    rdfs:subPropertyOf ns1:hasSocialPosition ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#socialPositionCelebrity> .

<http://www.ontotext.com/proton/protonext#hasSocialPositionCleric> a owl:ObjectProperty ;
    rdfs:label "has Social Position Cleric"@en ;
    rdfs:comment "The relation between a person and the social position of Cleric he has."@en ;
    rdfs:domain ns1:Person ;
    rdfs:range <http://www.ontotext.com/proton/protonext#Cleric> ;
    rdfs:subPropertyOf ns1:hasSocialPosition ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#socialPositionCleric> .

<http://www.ontotext.com/proton/protonext#hasSocialPositionNobelty> a owl:ObjectProperty ;
    rdfs:label "has Social Position Nobelty"@en ;
    rdfs:comment "The relation between a person and the social position of Nobelty he has."@en ;
    rdfs:domain ns1:Person ;
    rdfs:range <http://www.ontotext.com/proton/protonext#Nobelty> ;
    rdfs:subPropertyOf ns1:hasSocialPosition ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#socialPositionNobelty> .

<http://www.ontotext.com/proton/protonext#hasSocialPositionOutOfLaws> a owl:ObjectProperty ;
    rdfs:label "has Social Position OutOfLaws"@en ;
    rdfs:comment "The relation between a person and the social position of OutOfLaws he has."@en ;
    rdfs:domain ns1:Person ;
    rdfs:range <http://www.ontotext.com/proton/protonext#OutOfLaws> ;
    rdfs:subPropertyOf ns1:hasSocialPosition ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#socialPositionOutOfLaws> .

<http://www.ontotext.com/proton/protonext#hasStartOffset> a owl:DatatypeProperty ;
    rdfs:label "hasStartOffset" ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Mention> .

<http://www.ontotext.com/proton/protonext#isAuthorOf> a owl:ObjectProperty ;
    rdfs:label "Author"@en ;
    rdfs:comment "Any author of a product. Links an author (producer) to its creation ."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:range ns1:Object ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#authorOf> .

<http://www.ontotext.com/proton/protonext#socialPositionCelebrity> a owl:ObjectProperty ;
    rdfs:label "Social Position Holder Celebrity"@en ;
    rdfs:comment "The relation between a social position of Celebrity and the person who has it."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Celebrity> ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:socialPositionHolder ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#hasSocialPositionCelebrity> .

<http://www.ontotext.com/proton/protonext#socialPositionCleric> a owl:ObjectProperty ;
    rdfs:label "Social Position Cleric"@en ;
    rdfs:comment "The relation between a social position of Cleric and the person who has it."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Cleric> ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:socialPositionHolder ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#hasSocialPositionCleric> .

<http://www.ontotext.com/proton/protonext#socialPositionNobelty> a owl:ObjectProperty ;
    rdfs:label "Social Position Holder Nobelty"@en ;
    rdfs:comment "The relation between a social position of Nobelty and the person who has it."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#Nobelty> ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:socialPositionHolder ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#hasSocialPositionNobelty> .

<http://www.ontotext.com/proton/protonext#socialPositionOutOfLaws> a owl:ObjectProperty ;
    rdfs:label "Social Position Holder OutOfLaws"@en ;
    rdfs:comment "The relation between a social position of OutOfLaws and the person who has it."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#OutOfLaws> ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:socialPositionHolder ;
    owl:inverseOf <http://www.ontotext.com/proton/protonext#hasSocialPositionOutOfLaws> .

<http://www.ontotext.com/proton/protonext#subSectorOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Subsector of"@en ;
    rdfs:comment "The general part-of relation that takes place between a whole and each of its parts. It has number of specializations."@en ;
    rdfs:domain <http://www.ontotext.com/proton/protonext#IndustrySector> ;
    rdfs:range <http://www.ontotext.com/proton/protonext#IndustrySector> ;
    rdfs:subPropertyOf ns1:partOf .

<http://www.ontotext.com/proton/protonext#Acquirement> a owl:Class ;
    rdfs:label "Acquirement"@en ;
    rdfs:comment "The event of the acquiring of one organization by another."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#Architect> a <http://www.ontotext.com/proton/protonext#Profession> ;
    rdfs:label "Architect"@en ;
    rdfs:comment "Any architect, a profession of planning, design and oversight of the construction of buildings. (Wikipedia)"@en .

<http://www.ontotext.com/proton/protonext#Article> a owl:Class ;
    rdfs:label "Article"@en ;
    rdfs:comment "A relatively short document published as a part of Resource Collection."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PublishedMaterial> .

<http://www.ontotext.com/proton/protonext#Beverage> a owl:Class ;
    rdfs:label "Beverage"@en ;
    rdfs:comment "Any liquid suitable for drinking (WordNet, 1.7). The instances of this class are types of drinks, specific receipts. For instance: Diet Coke, Bacardi Spice."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ChemicalCompound> .

<http://www.ontotext.com/proton/protonext#BiologicalSubstance> a owl:Class ;
    rdfs:label "Biological Substance"@en ;
    rdfs:comment "Any substance or element that has biological nature or origine."@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#Book> a owl:Class ;
    rdfs:label "Book"@en ;
    rdfs:comment "A relatively large published document. It may or may not have chapters. There could be series of books considered as volumes of a single one."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PublishedMaterial> .

<http://www.ontotext.com/proton/protonext#Canal> a owl:Class ;
    rdfs:label "Canal"@en ;
    rdfs:comment "(ADL FT) Artificial waterways with no flow or a controlled flow used for navigation (canal), or for draining or irrigating land (ditch). We use this category for canal bends; for canalized streams; for ditch mouths; for ditches; for drainage canals; for drainage ditches; for drains (channels); for flumes (manmade); for irrigation canals; for irrigation ditches; for irrigation systems; for laterals; for navigation canals; and for underground irrigation canals. NIMA GNS designators CNL,CNLA, CNLB, CNLD, CNLI, CNLN, CNLQ, CNLSB, CNLX."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#HydrographicStructure>,
        <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#CarModel> a owl:Class ;
    rdfs:label "Car Model"@en ;
    rdfs:comment "A concrete model of a car which determines the main features of any car of this model. For example, Ford-T or BMW Z3."@en ;
    rdfs:subClassOf ns1:ProductModel .

<http://www.ontotext.com/proton/protonext#ChemicalCompound> a owl:Class ;
    rdfs:label "Chemical Compound"@en ;
    rdfs:comment "A specific chemical compound, such as H2O or Zarin."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#ChemicalSubstance>,
        ns1:ProductModel .

<http://www.ontotext.com/proton/protonext#ChemicalSubstance> a owl:Class ;
    rdfs:label "Chemical substance"@en ;
    rdfs:comment "Any substance or element that has chemical nature."@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#City> a owl:Class ;
    rdfs:label "City"@en ;
    rdfs:comment "(ADL FT) For smaller, less formally established communities, use 'populated places'. For independent cities, use 'countries, 2nd order divisions. Incorporated populated places. [Adapted from USGS Circ 1048] We use this category for municipalities; for towns; and for urban areas. NIMA GNS designator PPL."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Settlement> .

<http://www.ontotext.com/proton/protonext#Currency> a owl:Class ;
    rdfs:label "Currency"@en ;
    rdfs:comment "Specific currency, usually national"@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#Device> a owl:Class ;
    rdfs:label "Device" ;
    rdfs:subClassOf ns1:ProductModel .

<http://www.ontotext.com/proton/protonext#Festival> a owl:Class ;
    rdfs:label "Festival"@en ;
    rdfs:comment "Any widely recognized festival or holiday, such as, Christmas or St. Valentine's Day."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#RecurringEvent> .

<http://www.ontotext.com/proton/protonext#Genre> a owl:Class ;
    rdfs:label "Genre"@en ;
    rdfs:comment "Any Genre. Denotes any category of literature as well as various other forms of art or culture, e.g., music, based on some loose set of stylistic criteria. Genres are formed by conventions that change over time as new genres are invented and the use of old ones are discontinued. (Wikipedia)"@en ;
    rdfs:subClassOf ns1:Abstract .

<http://www.ontotext.com/proton/protonext#Human> a owl:Class ;
    rdfs:label "Human"@en ;
    rdfs:comment "Human is a mammal referred to Primate. Also of the sort of hommo sapiens. It has two subClasses: Man and Woman."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Mammal> .

<http://www.ontotext.com/proton/protonext#InformationSpaceProfile> a owl:Class ;
    rdfs:label "Information Space Profile" ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Profile> .

<http://www.ontotext.com/proton/protonext#Machine> a owl:Class ;
    rdfs:label "Device"@en,
        "Machine"@en ;
    rdfs:comment "Any produced device with particular purpose that uses energy to perform some activity. The device has parts that perform or assist in performing any type of work. (Wikipedia)"@en ;
    rdfs:subClassOf ns1:ProductModel .

<http://www.ontotext.com/proton/protonext#Meeting> a owl:Class ;
    rdfs:label "Meeting"@en ;
    rdfs:comment "A meeting is a gathering of two or more people that has been convened for the purpose of achieving a common goal through verbal interaction, such as sharing information or reaching an agreement. Wikipedia."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#MilitaryAreas> a owl:Class ;
    rdfs:label "Military Areas"@en ;
    rdfs:comment "(ADL FTT) We use this category for air force bases; for army facilities; for arsenals; for artillery ranges; for barracks; for bases (military); for camps (military); for forts; for infantry camps; for maneuver areas; for military bases; for military installations; for national guard facilities; and for naval bases. The following NIMA designators fit here: MILB, INSM, SCHM. The following ADL types are skipped as irrelevant: Cadastral areas,"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PoliticalRegion> .

<http://www.ontotext.com/proton/protonext#MilitaryOrganization> a owl:Class ;
    rdfs:label "Military Organisation"@en ;
    rdfs:comment "Any military organisation, the structuring of the armed forces of a state so as to offer military capability required by the national defence policy. (Wikipedia)"@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#OfficialPosition> a owl:Class ;
    rdfs:label "Official Position"@en ;
    rdfs:comment "A job position having a representative function with respect to an organization. Usually this is a position within a governmental organization."@en ;
    rdfs:subClassOf ns1:JobPosition .

<http://www.ontotext.com/proton/protonext#PhoneNumber> a owl:Class ;
    rdfs:label "Phone Number"@en ;
    rdfs:comment "A sequence of digits which represents an address of a telephone device within a telephone net."@en ;
    rdfs:subClassOf ns1:ContactInformation .

<http://www.ontotext.com/proton/protonext#PieceOfArt> a owl:Class ;
    rdfs:label "Piece of Art"@en ;
    rdfs:comment "An artifact, namely a piece of art, usually, matterial object. Typical instances are paintings and sculptures. Corresponds to the Wordnet 1.7.1 synset \"art, fine art - the products of human creativity; works of art collectively; \"an art exhibition\"@en ; \"a fine collection of art\")\""@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#PoliticalEntity> a owl:Class ;
    rdfs:label "Political Entity"@en ;
    rdfs:comment "Any organization which has a political functions."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#Profile> a owl:Class ;
    rdfs:label "Profile" ;
    rdfs:subClassOf ns1:InformationResource .

<http://www.ontotext.com/proton/protonext#PublicCompany> a owl:Class ;
    rdfs:label "Public Company"@en ;
    rdfs:comment "Company which is publicly traded on a Stock Exchange."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Company> .

<http://www.ontotext.com/proton/protonext#ResearchOrganization> a owl:Class ;
    rdfs:label "Research Organization"@en ;
    rdfs:comment "An organization performing scientific research."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#Satellite> a owl:Class ;
    rdfs:label "Satellite"@en ;
    rdfs:comment "An astronomic object orbiting around a planet or star. Definition partly derived from WordNet 1.7"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#AstronomicalObject> .

<http://www.ontotext.com/proton/protonext#SingleSongOrAlbum> a owl:Class ;
    rdfs:label "Single"@en ;
    rdfs:comment "Any Single Song and Album"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#AudioRecording> .

<http://www.ontotext.com/proton/protonext#Spacecraft> a owl:Class ;
    rdfs:label "Spacecraft"@en ;
    rdfs:comment "[WN1.7] Space vehicle - a craft capable of traveling in outer space; technically a satellite around the sun."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Vehicle> .

<http://www.ontotext.com/proton/protonext#SportFacility> a owl:Class ;
    rdfs:label "Sport Facility"@en ;
    rdfs:comment "(ADL FT) Fields, centers, or open areas maintained for the purpose of holding sporting events and activities. [USGS Circ 1048] We use this category for aquatic centers; for arenas; for athletic complexes; for athletic fields; for ball parks; for baseball fields; for dragways; for equestrian centers; for fields; for football fields; for golf clubs; for golf courses; for gymnasiums; for natatoriums; for physical education facilities; for pistol ranges (sport); for polo fields; for pools, swimming; for race tracks; for racecourses; for racetracks; for raceways; for rifle ranges; for rodeo grounds; for shooting ranges (sport); for skeet shooting ranges; for ski areas; for ski facilities; for ski trails; for speedways; for stadiums; for swim clubs; for swimming pools; for tennis clubs; and for tennis courts. NIMA GNS designators RECG, RECR, STDM, ATHF."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#RecreationalFacility> .

<http://www.ontotext.com/proton/protonext#SportGame> a owl:Class ;
    rdfs:label "Sport Game"@en ;
    rdfs:comment "A sport game is any instance of a sport event, where teams or individuals gather to play according to particular predetermined rules, such as soccer match, tennis match, car race, etc. It can also denote the activity of playing a particular sport game."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Game>,
        <http://www.ontotext.com/proton/protonext#SportEvent> .

<http://www.ontotext.com/proton/protonext#SportGamePoint> a owl:Class ;
    rdfs:label "Sport Game Point"@en ;
    rdfs:comment "Denotes a point scored in a given sport game."@en ;
    rdfs:subClassOf ns1:Situation .

<http://www.ontotext.com/proton/protonext#TelevisionProduct> a owl:Class ;
    rdfs:label "Television Product"@en ;
    rdfs:comment "Denotes programms produced in the television and for television airing."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaProduct> .

<http://www.ontotext.com/proton/protonext#WebPage> a owl:Class ;
    rdfs:label "Web Page"@en ;
    rdfs:comment "The internet address of a web page on the net."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#InternetAddress> .

<http://www.ontotext.com/proton/protonext#hasInternetAddress> a owl:ObjectProperty ;
    rdfs:label "has Internet Address"@en ;
    rdfs:comment "Relates an object to its internet address."@en ;
    rdfs:range <http://www.ontotext.com/proton/protonext#InternetAddress> ;
    rdfs:subPropertyOf ns1:hasContactInfo .

<http://www.ontotext.com/proton/protonext#hasPhone> a owl:ObjectProperty ;
    rdfs:label "has Phone"@en ;
    rdfs:comment "Relates an object (usually a person or an organization) to its telephone number."@en ;
    rdfs:range <http://www.ontotext.com/proton/protonext#PhoneNumber> ;
    rdfs:subPropertyOf ns1:hasContactInfo .

<http://www.ontotext.com/proton/protonext#hasProfession> a owl:ObjectProperty ;
    rdfs:label "has Profession"@en ;
    rdfs:comment "A relation between a person and his/her profession."@en ;
    rdfs:domain ns1:Person ;
    rdfs:range <http://www.ontotext.com/proton/protonext#Profession> .

<http://www.ontotext.com/proton/protonext#Address> a owl:Class ;
    rdfs:label "Address"@en ;
    rdfs:comment "Any sort of address, specifying how to locate something somewhere."@en ;
    rdfs:subClassOf ns1:ContactInformation .

<http://www.ontotext.com/proton/protonext#ArtPerformance> a owl:Class ;
    rdfs:label "Art Performance"@en ;
    rdfs:comment "A specific performance taking place at some moment, somewhere. Quite often starting at 19:00 in the theatre, stadium, etc."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#AudioRecording> a owl:Class ;
    rdfs:label "Audio Recording"@en ;
    rdfs:comment "An recording of a piece of music."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MusicalComposition> .

<http://www.ontotext.com/proton/protonext#Bay> a owl:Class ;
    rdfs:label "Bay"@en ;
    rdfs:comment "(ADL FT) Indentations of a coastline or shoreline enclosing a part of a body of water; bodies of water partly surrounded by land. We use this category for bahias; for coves; and for embayments. NIMA GNS designators BAY, BAYS."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#WaterRegion> .

<http://www.ontotext.com/proton/protonext#Broadcaster> a owl:Class ;
    rdfs:label "Broadcaster"@en ;
    rdfs:comment "A company that broadcasts audio or video content to a dispersed audience via any audio visual medium. Wikipedia"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaCompany> .

<http://www.ontotext.com/proton/protonext#Capital> a owl:Class ;
    rdfs:label "Capital"@en ;
    rdfs:comment "(ADL FT) Towns or cities that are the official seats of government in a political entity, such as a state or nation. [American Heritage Dic. of the English Language, 4th ed.] We use this category for county seats; for national capitals; and for state capitals. NIMA GNS designators PPLC, PPLA"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#City> .

<http://www.ontotext.com/proton/protonext#Celebrity> a owl:Class ;
    rdfs:label "Celebrity"@en ;
    rdfs:comment "The situation of holding a position in a society as celebrity."@en ;
    rdfs:subClassOf ns1:SocialPosition .

<http://www.ontotext.com/proton/protonext#Cleric> a owl:Class ;
    rdfs:label "Cleric"@en ;
    rdfs:comment "The situation of holding a position in society as cleric."@en ;
    rdfs:subClassOf ns1:SocialPosition .

<http://www.ontotext.com/proton/protonext#IssueOfPeriodical> a owl:Class ;
    rdfs:label "Issue of Periodical"@en ;
    rdfs:comment "A specific issue, number, and/or volume of periodical publication such as magazine."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PublishedMaterial> .

<http://www.ontotext.com/proton/protonext#MediaBrand> a owl:Class ;
    rdfs:label "Media Brand"@en ;
    rdfs:comment "A brand of a media company."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Brand> .

<http://www.ontotext.com/proton/protonext#MediaCompany> a owl:Class ;
    rdfs:label "Media Company"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Company> .

<http://www.ontotext.com/proton/protonext#MilitaryUnit> a owl:Class ;
    rdfs:label "Military Unit"@en ;
    rdfs:comment "Any military unit, a smaller military organization."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MilitaryOrganization> .

<http://www.ontotext.com/proton/protonext#Nobelty> a owl:Class ;
    rdfs:label "Nobelty"@en ;
    rdfs:comment "The situation of holding a position in society as nobelty."@en ;
    rdfs:subClassOf ns1:SocialPosition .

<http://www.ontotext.com/proton/protonext#OutOfLaws> a owl:Class ;
    rdfs:label "OutOfLaws"@en ;
    rdfs:comment "The situation of holding a position in a society as out of law."@en ;
    rdfs:subClassOf ns1:SocialPosition .

<http://www.ontotext.com/proton/protonext#PositionOrganization> a owl:Class ;
    rdfs:label "Position in an organization"@en ;
    rdfs:comment "The situation of a job position which is available in a particular organization, such as CEO, CTO, executive assistant, etc."@en ;
    rdfs:subClassOf ns1:Situation .

<http://www.ontotext.com/proton/protonext#Settlement> a owl:Class ;
    rdfs:label "Settlement"@en ;
    rdfs:comment "Describes a populated place with organisation, like city, village, town"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PopulatedPlace> .

<http://www.ontotext.com/proton/protonext#SportClub> a owl:Class ;
    rdfs:label "Sport Club"@en ;
    rdfs:comment "A sports club, football club or F1 team. Those should be considered commercial although in many cases they are not run for profit."@en,
        "An organization arranging the practice of some sports by teams or individuals."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Company>,
        <http://www.ontotext.com/proton/protonext#SportOrganization> .

<http://www.ontotext.com/proton/protonext#SportEvent> a owl:Class ;
    rdfs:label "Sport Event"@en ;
    rdfs:comment "An event involving use, maintain or improve of physical fitness of its participants. Usually it is organized."@en ;
    rdfs:subClassOf ns1:Event .

<http://www.ontotext.com/proton/protonext#SportOrganization> a owl:Class ;
    rdfs:label "Sport Organization"@en ;
    rdfs:comment "An organization (local, national or international) which main activity is related to one or more sports. Those could be clubs, as well, as all the sorts of federations."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#BusinessAbstraction> a owl:Class ;
    rdfs:label "Business Abstraction"@en ;
    rdfs:comment "An abstraction related to business."@en ;
    rdfs:subClassOf ns1:Abstract .

<http://www.ontotext.com/proton/protonext#Country> a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "(ADL FTT) Territory occupied by a large group of people organized under a single, usually independent government, and recognized internationally as a country. [Adapted from American Heritage Dic. of the English Language, 4th ed.] We use this category for nations; and for republics. NIMA GNS designators PCL, PCLD, PCLF, PCLI, PCLS. FIPS 10-4 is applicable, difining: Basic geopolitical entities assigned country codes include the following categories: (a) independent states; (b) dependent areas; (c) areas of quasi-independence, non-contiguous territories, possessions without populations, areas with special sovereignty associations, areas without sovereignty; (d) political regimes not recognized by the United States; and (e) outlying areas of the United States. The list of basic entities provides complete coverage of the land areas of the world without overlap or duplication."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#PoliticalRegion>,
        <http://www.ontotext.com/proton/protonext#PopulatedPlace> .

<http://www.ontotext.com/proton/protonext#EducationalOrganization> a owl:Class ;
    rdfs:label "Educational Organization"@en ;
    rdfs:comment "An organization devoted to teaching activities."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#LocationOfSpecialInterest> a owl:Class ;
    rdfs:label "Location of Special Interest"@en ;
    rdfs:comment "Any place with some particular value, which triggers interest."@en ;
    rdfs:subClassOf ns1:Location .

<http://www.ontotext.com/proton/protonext#MediaProduct> a owl:Class ;
    rdfs:label "Media Product"@en ;
    rdfs:comment "A mass media product (for instance a newspaper) abstracted from its organizational and ownership aspects (i.e. from its publisher) and considered more as a social phenomenon, partly a brand."@en ;
    rdfs:subClassOf ns1:ProductModel .

<http://www.ontotext.com/proton/protonext#Mention> a owl:Class ;
    rdfs:label "Section" ;
    rdfs:comment "An area of a document that can be considered a mention of something."@en ;
    rdfs:subClassOf ns1:InformationResource .

<http://www.ontotext.com/proton/protonext#Mountain> a owl:Class ;
    rdfs:label "Mountain"@en ;
    rdfs:comment "(ADL FT) Landmasses that project conspicuously above their surroundings. [USGS Circ 1048] We use this category for cerros; for cordilleras; for foothills; for hills; for knolls; for mounds; and for mounts. Omitted ADL sub-classes: Continental divides. NIMA GNS designator MT, MTS, MTSU, MTU, MND, KNLU, KNSU, CDAU, HLL, HLLS, HLLU, HLSU."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#NobeltyTitle> a owl:Class ;
    rdfs:label "Nobelty"@en ;
    rdfs:comment "The social function of a nobelty."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialFunction> .

<http://www.ontotext.com/proton/protonext#PeriodicalPublication> a owl:Class ;
    rdfs:label "Periodical Publication"@en ;
    rdfs:comment "A periodical publication, disregarding its specific issues, numbers, volumes, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaBrand> .

<http://www.ontotext.com/proton/protonext#RecreationalFacility> a owl:Class ;
    rdfs:label "Recreational Facility"@en ;
    rdfs:comment "(ADL FT) We use this category for access areas; for access sites; for boardwalks; for casinos; for clubs (recreational); for country clubs; for fairgrounds; for fishing areas; for fishing lodges; for fitness centers; for gun clubs; for hunt posts; for hunting lodges; for ice skating rinks; for playgrounds; for recreation sites; for resorts; for riding stables; for spas; for sportsman lodges; for stables; for yacht clubs; for youth centers; and for youth facilities. NIMA GNS designators - no direct equivalents."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#RegionMention> a owl:Class ;
    rdfs:label "Region Mention" ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Mention> .

<http://www.ontotext.com/proton/protonext#Vehicle> a owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:comment "Any sort of specific vehicle, mean of transportation."@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#AstronomicalObject> a owl:Class ;
    rdfs:label "Astronomical Object"@en ;
    rdfs:comment "Any object studied by astronomers, (usually quite large natural and inanimate) object that is located in the physical universe and is not on the surface of the Earth. Definition partly derived from OpenCyc 0.7"@en ;
    rdfs:subClassOf ns1:Location .

<http://www.ontotext.com/proton/protonext#ClericTitle> a owl:Class ;
    rdfs:label "Cleric"@en ;
    rdfs:comment "The social function of a cleric, involving the church."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialFunction> .

<http://www.ontotext.com/proton/protonext#CommercialOrganization> a owl:Class ;
    rdfs:label "Commercial Organization"@en ;
    rdfs:comment "Organization that buys or sells goods or services for a profit. It may also be a Business or it may merely be a sub-organization of a Business entity."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#GovernmentOrganization> a owl:Class ;
    rdfs:label "Government Organization"@en ;
    rdfs:comment "The government of a country, i.e. the authorized country administration, without account for a specific government elected and being in power for some period. This notion of government groups all the administration, including any sort of ministries, agencies, commissions, etc."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#IndustrySector> a owl:Class ;
    rdfs:label "Industry Sector"@en ;
    rdfs:comment "A classification of companies that have similar production processes, similar products, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#BusinessAbstraction> .

<http://www.ontotext.com/proton/protonext#InternetAddress> a owl:Class ;
    rdfs:label "Internet Address"@en ;
    rdfs:comment "An identifier that determines a resource on the Internet."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Address> .

<http://www.ontotext.com/proton/protonext#LivingObject> a owl:Class ;
    rdfs:label "Living Object"@en ;
    rdfs:comment "Living object is any organism which is living, e.g. breathing and regular lifecycle."@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#Man> a owl:Class ;
    rdfs:label "Man"@en ;
    rdfs:comment "A male human."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Human>,
        ns1:Person .

<http://www.ontotext.com/proton/protonext#ResourceCollection> a owl:Class ;
    rdfs:label "Resource Collection"@en ;
    rdfs:comment "A collection is an aggregation of information resources. The term collection means that the resource is described as a group; its parts may be separately described and navigated. (DCMI type Collection)"@en ;
    rdfs:subClassOf ns1:InformationResource .

<http://www.ontotext.com/proton/protonext#Woman> a owl:Class ;
    rdfs:label "Woman"@en ;
    rdfs:comment "A female human."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Human>,
        ns1:Person .

<http://www.ontotext.com/proton/protonext#hasSocialFunctionTitle> a owl:ObjectProperty ;
    rdfs:label "has Title"@en ;
    rdfs:comment "Generic property relating a Social Position to its name defined as an instance of a sub-class of pext:SocialFunction"@en ;
    rdfs:domain ns1:SocialPosition ;
    rdfs:range <http://www.ontotext.com/proton/protonext#SocialFunction> .

<http://www.ontotext.com/proton/protonext#ArtProfession> a owl:Class ;
    rdfs:label "Sportsman"@en ;
    rdfs:comment "A profession in the area of art."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Profession> .

<http://www.ontotext.com/proton/protonext#PoliticalRegion> a owl:Class ;
    rdfs:label "Political Region"@en ;
    rdfs:comment "(ADL, Political Entity) We use this category for commonwealths; for dependent political entities; for freely associated states; for independent political entities; for oblasts; for political entities; and for semi-independent political entities. Sub-classes omitted: Countries, 4th order divisions. NIMA GNS class: A, Administrative Boundary Features."@en ;
    rdfs:subClassOf ns1:Location .

<http://www.ontotext.com/proton/protonext#SocialAbstraction> a owl:Class ;
    rdfs:label "Social Abstraction"@en ;
    rdfs:comment "Any sort of general social phenomenon, such as particular sort of art or science"@en ;
    rdfs:subClassOf ns1:Abstract .

<http://www.ontotext.com/proton/protonext#Team> a owl:Class ;
    rdfs:label "Team"@en ;
    rdfs:comment "A group of people gathered for some task, say a project. Teams are usually not formally established and not meant to perform as a single agent for purposes outside the scope of their task. Teams may \"live\" within organizations, spread between multiple organizations, or be independent form any organization."@en ;
    rdfs:subClassOf ns1:Organization .

<http://www.ontotext.com/proton/protonext#TemporalAbstraction> a owl:Class ;
    rdfs:label "Temporal Abstraction"@en ;
    rdfs:comment "Any sort of abstraction used to refer to specific periods of time. Thus, the month of September is an instance of this class, while Sept 1989 is not (it is a specific TimeInterval, and thus not abstract)"@en ;
    rdfs:subClassOf ns1:Abstract .

<http://www.ontotext.com/proton/protonext#UserProfile> a owl:Class ;
    rdfs:label "User Profile" ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Profile> .

<http://www.ontotext.com/proton/protonext#PublishedMaterial> a owl:Class ;
    rdfs:label "Published Material"@en ;
    rdfs:comment "A document that is published or intended for publishing"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#MediaProduct>,
        ns1:Document .

<http://www.ontotext.com/proton/protonext#SocialFunction> a owl:Class ;
    rdfs:label "Social Function"@en ;
    rdfs:comment "The name of a function a person has in the society like nobely, job title, celebrity, etc."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialAbstraction> .

<http://www.ontotext.com/proton/protonext#BodyPart> a owl:Class ;
    rdfs:label "Body Part"@en ;
    rdfs:comment "Any part of the body of any living entity"@en ;
    rdfs:subClassOf ns1:Object .

<http://www.ontotext.com/proton/protonext#HydrographicStructure> a owl:Class ;
    rdfs:label "Hydrographic Structure"@en ;
    rdfs:comment "(ADL FT) For constructed bodies of water. For natural water bodies, use 'hydrographic features'. We use this category for boat landings; for boat launches; for boat ramps; for sluices; and for water mills. Many sub-classes omitted; those considered are also made sub-classes of WaterRegion. NIMA GNS ... no direct equivalent."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#PopulatedPlace> a owl:Class ;
    rdfs:label "Populated Place"@en ;
    rdfs:comment "(ADL FT) Places or areas with clustered or scattered buildings and a permanent human population. ... We use this category for agricultural colonies; for communes; for communities; for hamlets; for homesteads; for locales; for localities; for metropolitan areas; for populated localities; for ppl; for pueblos; for settlements; for suburbs; for villages; and with religious facilities for religious populated places. NIMA GNS designator PPL, PPL(x)"@en ;
    rdfs:subClassOf ns1:Location .

<http://www.ontotext.com/proton/protonext#RecurringEvent> a owl:Class ;
    rdfs:label "Recurring Event"@en ;
    rdfs:comment "Recurring sequence of events, such as Olympic Games, etc.."@en ;
    rdfs:subClassOf ns1:Happening .

<http://www.ontotext.com/proton/protonext#TransportFacility> a owl:Class ;
    rdfs:label "Transport Facility"@en ;
    rdfs:comment "(ADL FT: Transportation Features) We use this category for air routes; for caravan routes; for corridors; for crossings; for depots; for ferries; for fords (crossings); for fuel depots; for gates (manmade); for halting places (transportation); for highway maintenance sites; for portages; for rest houses; for routes; for ship tracks; for stock routes; for terminals (transportation); and for transit facilities. Omitted sub-classes: Aqueducts, Cableways, Parking Sites. NIMA GNS designator - no direct equivalents."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#Animal> a owl:Class ;
    rdfs:label "Animal"@en ;
    rdfs:comment "Animals are a major group of multicellular, eukaryotic organisms. Their body plan eventually becomes fixed as they develop. Most animals are motile. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LivingObject> .

<http://www.ontotext.com/proton/protonext#Company> a owl:Class ;
    rdfs:label "Company"@en ;
    rdfs:comment "A private, legal, corporate entity with the legal rights to own property, manage itself, and sue or be sued. It is established by a charter or registration granted by the government."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#CommercialOrganization> .

<http://www.ontotext.com/proton/protonext#BiogeographicRegion> a owl:Class ;
    rdfs:label "Biogeographic Region"@en ;
    rdfs:comment "(ADL FT) Geographic regions characterized chiefly by the dominant forms of plant life and the prevailing climate. [Adapted from American Heritage Dict. of the English Language, 4th ed.] We use this category for biomes; for ecoregions; and for vegetation. Omitted ADL sub-classes: Barren lands, Grasslands, Habitats, Snow Regions, Wetlands. NIMA GNS designator - no equivalent. Some correspondence to class Hypsographic Features."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#LandRegion> .

<http://www.ontotext.com/proton/protonext#Building> a owl:Class ;
    rdfs:label "Building"@en ;
    rdfs:comment "(ADL FT) Permanent constructions that are roofed and usually walled. [USGS Circ 1048] We use this category for administrative facilities; for administrative facilities; for animal pounds; for animal shelters; for aquariums; for barns; for border posts; for cabins; for castles; for city halls; for civic centers; for civil buildings; for club houses; for coast guard stations; for commissaries; for community centers; for community houses; for conference facilities; for consulates; for convention centers; for customs houses; for customs posts; for depots; for embassy buildings; for exhibition buildings; for facilities; for facility centers; for fire stations; for firehouses; for forest stations; for government buildings; for guard stations; for halls; for headquarters; for hostels; for hotels; for houses; for inns; for inspection stations; for legation buildings; for lodges; for missions; for motels; for neighborhood centers; for offices; for park headquarters; for patrol posts; for pavilions; for planetariums; for plazas; for police posts; for public buildings; for ranger stations; for restaurants; for shelters; for shops; for stations; for structures; for student unions; for studios; for substations; for taverns; for town halls; for trading posts; for treatment plants; for United States Government establishments; for visitor centers; for walls; and for warehouses NIMA GNS designator BLDG."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Facility> .

<http://www.ontotext.com/proton/protonext#Facility> a owl:Class ;
    rdfs:label "Facility"@en ;
    rdfs:comment "(ADL FT: Manmade Features, no def) Any regions and locations determined artificially, as a result of human activity. Many of the ADL sub-classes are omitted. NIMA GNS - no direct equivalent, although many sub-types are defined as classes (S, R) and designators."@en ;
    rdfs:subClassOf ns1:Location .

<http://www.ontotext.com/proton/protonext#Profession> a owl:Class ;
    rdfs:label "Profession"@en ;
    rdfs:comment "A profession is a vocation founded upon specialized educational training. Wikipedia."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialFunction> .

<http://www.ontotext.com/proton/protonext#JobTitle> a owl:Class ;
    rdfs:label "Job Title"@en ;
    rdfs:comment "The name of a position a person holds within an organization."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SocialFunction> .

<http://www.ontotext.com/proton/protonext#Sportsman> a owl:Class ;
    rdfs:label "Sportsman"@en ;
    rdfs:comment "A profession of a person involved in a sport."@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#Profession> .

<http://www.ontotext.com/proton/protonext#SportsLeague> a owl:Class ;
    rdfs:label "Sports League"@en ;
    rdfs:comment "Any sports league, a group of sports teams or individual athletes that compete against each other in a specific sport. (Wikipedia)"@en ;
    rdfs:subClassOf <http://www.ontotext.com/proton/protonext#SportOrganization> .

<http://www.ontotext.com/proton/protonext#WaterRegion> a owl:Class ;
    rdfs:label "Water Region"@en ;
    rdfs:comment "(ADL FT: Hydrographic Features) For natural bodies of water. For constructed waterways, reservoirs, and such, use 'hydrographic structures'. We use this category for bodies of water; for eddies; for fluvial features; for marine features; for overfalls; for upwellings; for water bodies; for waterholes; and for whirlpools. Many of the ADL hydrographic features ignored. NIMA GNS class H."@en ;
    rdfs:subClassOf ns1:Location .

<http://www.ontotext.com/proton/protonext#LandRegion> a owl:Class ;
    rdfs:label "Land Region"@en ;
    rdfs:comment "Any sort of land regions which are sort of natural, i.e. excluding urban areas, political and administrative regions. It combines number of ADL feature types under Physiographic features and Regions. Omitted ADL sub-classes: Badlands, Bars, Basins, Bight, Cirques, Cliffs, Dunes, Flats, Karst areas. Ledges, Massifs, Mineral deposit areas, Moraines, Natural rock formations, Arches, Playas, Seafloor Features, Tectonic features, Volcanic features (Volcano put under Mountain), Subcontinents. NIMA GNS designators FSR, FURU, HMCK, PLDR, RKFL, SINK, SLID, SLP, SLPU, TERU, TRR."@en ;
    rdfs:subClassOf ns1:Location .

