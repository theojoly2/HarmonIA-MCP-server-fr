onto:hasEmergencyPlan a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Existence of emergency plan"@en ;
    onto:XMLName "ITU_EmergencyPlan" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Mandatory for tunnels longer than 1 km"@en ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.8.9",
        "1.2.1.0.5.6",
        "1.2.2.0.5.6" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasEmergencyPlan>,
        <http://data.europa.eu/949/shapes/HasEmergencyPlanApplicability> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2021-08-10"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
    rdfs:comment "Indication whether emergency plan exists."@en ;
