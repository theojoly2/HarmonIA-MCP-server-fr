onto:structureCheckLocation a owl:DatatypeProperty ;
    rdfs:label "Railway location of structures requiring specific checks"@en ;
    onto:XMLName "IPP_StructureCheckLoc" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "This information is to be linked with parameter 1.1.1.1.2.4.4"@en ;
    onto:legalDeadline "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.1.2.4.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/StructureCheckLocation> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:relation onto:compatibilityProcedureDocument ;
    rdfs:comment "Localisation of structures requiring specific checks"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf onto:performanceDataParameter ;
    ns1:term_status "stable" ;
    skos:example "The IM A knows that its bridge X might have problems with combination of speed and load above a certain limit values Z, and for that the IM A has a specific procedure W for the check to be done; if the vehicle operation is intended to be within this case (above the limit Z), then RU shall proceed in accordance to the procedure W; therefore the bridge X shall be referred to in the parameter of the RINF:  1.1.1.1.2.4.3 / Railway location of structures requiring specific checks." ;
    skos:scopeNote "The railway location identifies the location of the structure in the system of reference of the line to which the track belongs."@en .

