onto:trainIntegrityOnBoardRequired a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Train integrity confirmation from on-board (not from driver) necessary for line access"@en ;
    onto:XMLName "CPE_IntegrityConfirmation" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value has to be provided when ETCS Level 2 is present, ETCS Baseline > 4 MR1 and IM confirms train integrity function is required)."@en,
        "Parameter only applicable when ETCS Baseline > 4 MR1 with operation requiring train integrity."@en ;
    onto:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.3.2.8",
        "1.2.1.1.1.8" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrainIntegrityOnBoardRequired> ;
    onto:tsiOPEAppendixD2Index "3.4.11" ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-31"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether train confirmation from on-board is required to access the line for safety reasons."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "N" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Optional" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Y" ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:subPropertyOf onto:tsiCompliantTrainProtectionSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "In hybrid operation, the confirmation can be optional. \\nSee also: TSI CCS BDC 4.2.2 (Managing information about the completeness of the train (not from driver))"@en .

