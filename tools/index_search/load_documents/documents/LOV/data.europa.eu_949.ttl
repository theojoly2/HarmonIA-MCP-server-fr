    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf onto:signalDataParameter,
        onto:tunnelDataParameter ;
    ns1:term_status "stable" ;
    skos:altLabel "Railway location of Operational point"@en ;
    skos:scopeNote "For walkways: Value provided in Kilometric point of the start of the walkway and the length in m. Repeatable values for each location.\\nFor rescue points: Value provided in Kilometric point of the start of the point of evacuation and rescue point and the length in m. Repeatable values for each location.\\nFor signals: Relative position to the line identified under parameter 1.1.0.0.0.2, given in km ([reference point, via era:referent] / [NNN.NNN] )."@en .

