onto:localRulesOrRestrictions a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Existence of rules and restrictions of a strictly local nature"@en ;
    onto:XMLName "RUL_LocalRulesOrRestrictions" ;
    onto:applicable "Y/N" ;
    onto:formatNote "Y/N" ;
    onto:legalDeadline "1 January 2021"@en ;
    onto:rinfIndex "1.1.1.4.1",
        "1.2.3.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LocalRulesOrRestrictions> ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "Existence of rules and restrictions of a strictly local nature"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:OperationalPoint ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first onto:RunningTrack ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf onto:rulesDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "There is a general obligation for Member States to notify existing national rules but:  Member States may decide not to notify rules and restrictions of a strictly local nature. In such cases, Member States shall mention those rules and restrictions in the registers of infrastructure. \\nIn this eventuality, this parameter allows the IM accordingly to its Member State decision to declare the existence of such rules and to provide them with the parameter 'Documents regarding the rules or restrictions of a strictly local nature available by the IM'"@en .

onto:localRulesOrRestrictionsDoc a owl:ObjectProperty ;
    rdfs:label "Documents regarding the rules or restrictions of a strictly local nature available by the IM"@en ;
    onto:XMLName "RUL_LocalRulesOrRestrictionsDocRef" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Mandatory to provide at least a document if parameter \"Existence of rules and restrictions of a strictly local nature\" value is boolean \"Yes\""@en ;
    onto:legalDeadline "1 January 2021"@en ;
    onto:rinfIndex "1.1.1.4.2",
        "1.2.3.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LocalRulesOrRestrictionsDoc>,
        <http://data.europa.eu/949/shapes/LocalRulesOrRestrictionsDocApplicability> ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:modified "2023-01-20"^^xsd:date,
        "2024-04-23"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "Electronic document available from the IM stored by the Agency providing additional information."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:OperationalPoint ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first onto:RunningTrack ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:seeAlso "IOD: Notification of national rules Art 14. 11" ;
    rdfs:subPropertyOf onto:rulesObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote "The value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link.\\n\\nIOD: Notification of national rules Art 14. 11. Member States may decide not to notify rules and restrictions of a strictly local nature. In such cases, Member States shall mention those rules and restrictions in the registers of infrastructure referred to in Article 49"@en .

