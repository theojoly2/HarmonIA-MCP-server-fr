    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation onto:trainDetectionSystemType ;
