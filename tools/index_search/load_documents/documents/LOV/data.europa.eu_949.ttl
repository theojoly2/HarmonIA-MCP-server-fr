onto:track a owl:ObjectProperty ;
    rdfs:label "Track"@en ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:isReplacedBy onto:hasPart ;
    dcterms:modified "2021-09-09"^^xsd:date,
        "2024-11-11"^^xsd:date ;
    rdfs:comment "Reference to a related railway track."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:OperationalPoint ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:SectionOfLine ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first onto:Signal ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:RunningTrack ;
    owl:deprecated true ;
    ns1:term_status "stable" .

onto:trackLoadCapability a owl:ObjectProperty ;
    rdfs:label "Load capability"@en ;
    onto:XMLName "IPP_LoadCap" ;
    onto:applicable "Y" ;
    onto:formatNote "The value of this parameter is an instance of the era:LoadCapability class which consists of 2 properties:\\n- era:loadCapabilityLineCategory - as a taxonomy of load models representing line category \\n- era:loadCapabilitySpeed - integer for the value of speed [km/h] permitted for a specific load model\\n\\nFor RINF XML data sets:\\nAs long as the data provision through XML data sets is allowed, the data format is:\\n[CCCC] [NNN],\\nwhere:\\n- [CCCC] is a single selection from the predefined list of load models representing line category \\n- [NNN] is the value of speed [km/h] permitted for a specific load model."@en ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.2.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrackLoadCapability> ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/KiloM-PER-HR> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2023-01-20"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:replaces onto:loadCapability ;
    rdfs:comment "Relates the track with the class LoadCapability. A combination of the line category and speed at the weakest point of the track."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:LoadCapability ;
    rdfs:seeAlso "INF TSI: 4.2.1, 4.2.7.1, 4.2.7.2, 4.2.7.4\\nAnnex D1 OPE TSI" ;
    rdfs:subPropertyOf onto:performanceObjParameter ;
    ns1:term_status "stable" ;
    skos:example "The set of selected data may include: B2-160, D4-120 and E5-100\\nWhen classifying infrastructure lines into line categories, the following options shall be used by the infrastructure manager to optimize freight traffic:\\nOption 1: determination of the line category at maximum freight traffic speed (maximum 120 Km/h)\\nOption 2: determination of a line category at an associated lower speed (less than the maximum freight traffic speed)\\nExample of option 1 (Annex F of EN 15528:2021): In a given track, if the traffic is mixed, the local speed of the line is 90 Km/h and the determined line category is D4 at a maximum of 90 Km/h, the information displayed should be: D4/90.\\nExample of option 2 (Annex F of EN 15528:2021): In a given track, if the traffic is mixed, the local speed of the line is 120 Km/h and the determined line category is C4 at a maximum of 120 Km/h and D4 at maximum of 90 Km/h, the information displayed should be: C4/120 and D4/90." ;
    skos:scopeNote "At this step, RINF does not allow to enter additional data referred to additional speed regulations and operating requirements relating to locomotives (e.g., locomotive classes and associated maximum speed) or traffic types (e.g., maximum speed of freight traffic or passenger traffic).\\n\\nThe load capability describes the weakest point of this track within this section of line (which is normally a bridge or other sub-track structure). \\nIt is expressed as a combination of the line category and speed permitted for trains exerting loads defined for this line category.\\nThe result of the classification process is set out in EN 15528:2021 (Annex A) and referred to in that standard as Line Category. \\n\\nThe Load capability for UK in respect of Northern Ireland consists of RA and speed in miles per hour. RA shall be applied according to UK Railway Group Standard GE/RT8006, Issue Two, September 2010.\\n\\nMore than one combination may be published for the same track if applicable, but it has to be done by repetition of the parameter with one value selected only  that is why Y is given in line Can be repeated.\\nFor the following cases, it is not possible to use EN 15528:2021 categories of line classification:\\n- TSI categories of line P1520 and F1520 (passenger traffic or freight traffic at any speed)\\n- TSI categories of line P1600 and F1600 (passenger traffic or freight traffic at any speed)\\n\\nWhen more than one value of the parameter has to be published, then parameter has to be repeated as many times as many values of the parameter will be published."@en .

onto:trackPhaseInfo a owl:ObjectProperty ;
    rdfs:label "Information on phase separation"@en ;
    onto:XMLName "EOS_InfoPhase" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "A value is mandatory only if 1.1.1.2.4.1.1 parameter \"Phase separation\" value is \"Y\" (true), otherwise applicability flag is \"N\" (not applicable)"@en ;
    onto:formatNote "In RDF the range is an instance of the era:PhaseInfo class with all its properties.\\n\\nFor RINF XML data sets:\\nAs long as the data provision through XML data sets is allowed, the data format is a character string with the following structure: distance type [MIN/MAX] + length [NNN] + switch off breaker [Y/N] + lower pantograph [Y/N] + km [NNN.NNN]. The structure of the string is as follows:\\n- distance type [MIN/MAX] - single selection of 'MIN=minimum' or 'MAX=maximum' to show whether the length is a minimum distance between the inner contact strips of the pantographs or a maximum distance between the outer contact strips of the pantographs. Multiple strings for this parameter are accepted;\\n- length [NNN] - the length of the phase separation in meters;\\n- switch off breaker [Y/N], single selection of 'yes' or 'no' to show whether the breaker has to be switched off; \\n- lower pantograph [Y/N], single selection of 'yes' or 'no' to show whether the pantograph has to be lowered,  \\n- Km [NNN.NNN] - the location from the start of the line where the new value is valid."@en ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.2.4.1.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrackPhaseInfo>,
        <http://data.europa.eu/949/shapes/TrackPhaseInfoApplicability> ;
    dcterms:created "2023-04-05"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-06-09"^^xsd:date ;
    dcterms:replaces onto:phaseInfo ;
    rdfs:comment "Relates the Track with PhaseInfo. Indication of required several information on phase separation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:PhaseInfo ;
    rdfs:seeAlso "ENE TSI: 4.2.15" ;
    rdfs:subPropertyOf onto:oclSeparationSectionsObjParameter ;
    ns1:term_status "stable" .

onto:trackResistanceToAppliedLoadsDataParameter a owl:DatatypeProperty ;
    rdfs:label "Track resistance to applied loads"@en ;
    onto:rinfIndex "1.1.1.1.6" ;
    dcterms:created "2024-10-31"^^xsd:date ;
