onto:gaugingCheckLocation a owl:DatatypeProperty ;
    rdfs:label "Railway location of particular points requiring specific checks"@en ;
    onto:XMLName "ILL_GaugeCheckLoc" ;
    onto:applicable "Y/N" ;
    onto:legalDeadline "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.1.3.1.2",
        "1.2.1.0.3.5" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GaugingCheckLocation> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-11-19"^^xsd:date ;
    rdfs:comment "Location of particular points requiring specific checks due to deviations from gauging referred to in parameter \"Gauging\""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:lineLayoutDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "This parameter is applicable when the IM wants to highlight a particular point requiring checks and provide info via parameter 'Document with the transversal section of the particular points requiring specific checks'.\\n\\nThe railway location identifies the location of the structure in the system of reference of the line to which the track belongs.\\n\\nThe location (generally the distance from the origin of the line to the point of interest for the specific check) on a line is given in kilometres with decimals (precision of 0.001)."@en .

onto:gaugingProfile a owl:ObjectProperty ;
    rdfs:label "Gauging"@en ;
    onto:XMLName "ILL_Gauging" ;
    onto:applicable "Y" ;
    onto:eratvIndex "3.1.2.3",
        "4.2.1" ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/gaugings/GaugingProfiles> ;
    onto:legalDeadline "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.1.3.1.1",
        "1.2.1.0.3.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GaugingProfile>,
        <http://data.europa.eu/949/shapes/GaugingProfileSKOS> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-06-26"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-08"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28>,
        <http://data.europa.eu/eli/reg/2014/1302/2023-09-28> ;
    rdfs:comment "Gauges as defined in European standard or other local gauges, including lower or upper part."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first onto:VehicleType ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2022-11/list_harmonised_national_restriction_codes_en.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:lineLayoutObjParameter,
        onto:vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "It is possible to include additional values than the already identified and included in the concept scheme. They will be introduced by the Agency on request via a process of change request.\\n\\n                   UK in respect of the Northern Ireland have a reference profile, but defined based on national rule:\\n7.3.2.2 Specific case Ireland and UK for Northern Ireland ('P')\\nIt is permissible for the reference profile of the upper and the lower part of the unit to be established in accordance with the national technical rules notified for this purpose.\\n\\n                   See also: \\n- Annex D1 OPE TSI\\n- INF TSI: 4.2.3.1, 4.2.3.2 "@en .

onto:gaugingTransversalDocument a owl:ObjectProperty ;
    rdfs:label "Document with the transversal section of the particular points requiring specific checks"@en ;
    onto:XMLName "ILL_GaugeCheckDocRef" ;
    onto:applicable "Y/N" ;
    onto:legalDeadline "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.1.3.1.3",
        "1.2.1.0.3.6" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GaugingTransversalDocument> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2024-04-23"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    rdfs:comment "Electronic document available from the IM stored by the Agency with the transversal section of the particular points requiring specific checks due to deviations from gauging referred to in parameter \"Gauging\". Where relevant, guidance for the check with the particular point may be attached to the document with the transversal section."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:subPropertyOf onto:lineLayoutObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote "The value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link."@en .

onto:gprsImplementationArea a owl:DatatypeProperty ;
    rdfs:label "Area of implementation of GPRS"@en ;
    onto:XMLName "CRG_GPRSAreaOfImpl" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "GSM-R, ETCS L2 and GPRS for ETCS must be installed for this parameter to be applicable."@en ;
    onto:legalDeadline "1 January 2021"@en,
        "12 months after publication of Article 7 Guide for OP tracks"@en ;
    onto:rinfIndex "1.1.1.3.3.3.3",
        "1.2.1.1.2.3.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GprsImplementationArea>,
        <http://data.europa.eu/949/shapes/GprsImplementationAreaApplicability> ;
