onto:lineReferenceTunnelEnd a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "End of tunnel kilometer"@en ;
    onto:XMLName "SOLTunnelEnd" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.8.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LineReferenceTunnelEnd> ;
    dcterms:created "2024-02-05"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date,
        "2024-10-24"^^xsd:date,
        "2024-11-29"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    dcterms:replaces onto:tunnelKilometerEnd ;
    rdfs:comment "Part of the End of tunnel that indicates the km of the line at the end of a tunnel.\\n\\nThe End of tunnel is the Geographical coordinates in decimal degrees and km of the line at the end of a tunnel."@en ;
    rdfs:domain onto:Tunnel ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:NetPointReference ;
    rdfs:subPropertyOf onto:tunnelObjParameter ;
    ns1:term_status "stable" ;
    skos:example "Kilometer=`0.270`" ;
    skos:scopeNote "Parameters of this group (from 1.1.1.1.8.1 to 1.1.1.1.8.13) are only applicable if tunnels exist on the SoL"@en .

onto:lineReferenceTunnelStart a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Start of tunnel kilometer"@en ;
    onto:XMLName "SOLTunnelStart" ;
    onto:applicable "Y" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.8.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LineReferenceTunnelStart> ;
    dcterms:created "2024-02-05"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date,
        "2024-10-24"^^xsd:date,
        "2024-11-29"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    dcterms:replaces onto:tunnelKilometerStart ;
    rdfs:comment "Part of the Start of tunnel that indicates the km of the line at the beginning of a tunnel.\\n\\nThe Start of tunnel is the Geographical coordinates in decimal degrees and km of the line at the beginning of a tunnel."@en ;
    rdfs:domain onto:Tunnel ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:NetPointReference ;
    rdfs:subPropertyOf onto:tunnelObjParameter ;
    ns1:term_status "stable" ;
    skos:example "Kilometer=`0.895`" ;
    skos:scopeNote "Geographical coordinates according to the standard World Geodetic System (WGS).  Precision for both geographical latitude and geographical longitude is assumed as [NN.NNNNNNN] in degrees with decimals what gives discretion of 10 cm in the network.\\nKilometre shall concern the national line identification given in 1.1.0.0.0.2\\nLocation of the point which is assumed to be the beginning of the tunnel it is the point on the track centre line where is laid the vertical shadow of the extreme part of the tunnel s portal."@en .

