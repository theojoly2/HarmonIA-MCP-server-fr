onto:etcsDegradedSituation a owl:ObjectProperty ;
    rdfs:label "ETCS level for degraded situation"@en ;
    onto:XMLName "CLD_ETCSSituation" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "Mandatory when ETCS is present. "@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-situation/ETCSSituations> ;
    onto:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.3.10.1",
        "1.2.1.1.9.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsDegradedSituation>,
        <http://data.europa.eu/949/shapes/EtcsDegradedSituationApplicability>,
        <http://data.europa.eu/949/shapes/EtcsDegradedSituationSKOS> ;
    onto:tsiOPEAppendixD2Index "3.4.1" ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation onto:etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2023-09-28>,
        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "ERTMS / ETCS application level for degraded situation related to the track side equipment."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/reg_impl/2019/773/oj"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:lineSideSystemDegradedSituationObjParameter ;
    ns1:term_status "stable" ;
    skos:example "Level 1 as a degraded mode for Level 2." ;
    skos:scopeNote "System for degraded situation. \\n\\nIn case of failure of the ETCS Level for normal operation, train movement can be supervised in another ETCS Level. \\n\\nIf parameter 1.1.1.3.2.1 is not used (no ETCS), no degradation is possible, so only \"none\" level is possible for degraded .\\nIt assumed that the degraded level has to be lower than the actual operating level.\\nSee also TSI OPE 4.2.3.6. Degraded operation."@en .

