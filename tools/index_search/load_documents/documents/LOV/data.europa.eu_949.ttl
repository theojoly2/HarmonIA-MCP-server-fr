        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/776/oj> ;
    rdfs:comment "A unit of track comprising two fixed rails (stock rails) and two movable rails (switch rails) used to direct vehicles from one track to another track."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:InfrastructureElement ;
    owl:disjointWith onto:Track,
        onto:Tunnel ;
    ns1:term_status "stable" .

onto:tsiCompliantTrainProtectionSystemObjParameter a owl:ObjectProperty ;
    rdfs:label "TSI compliant train protection system (ETCS)"@en ;
    onto:rinfIndex "1.1.1.3.2",
        "1.2.1.1.1" ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf onto:ccsSubsystemObjParameter .

onto:tunnelDataParameter a owl:DatatypeProperty ;
    rdfs:label "Tunnel"@en ;
    onto:rinfIndex "1.1.1.1.8",
        "1.2.1.0.5",
        "1.2.2.0.5" ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf onto:infraSubsystemDataParameter .

onto:ContactLineSystem a owl:Class ;
    rdfs:label "Contact Line System"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ContactLineSystemShape> ;
    dcterms:created "2021-08-04"^^xsd:date ;
    dcterms:modified "2021-08-04"^^xsd:date ;
    rdfs:comment "System that is used to transmit electrical energy to road or rail vehicles."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:trainDetectionSystemType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Type of train detection system"@en ;
    onto:XMLName "CTD_DetectionSystem" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "Not all parameters are applicable to all types of train detection systems; it depends on the applicability condition."@en ;
    onto:eratvIndex "4.14.1" ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/train-detection/TrainDetectionSystems> ;
    onto:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.3.7.1.1",
        "1.2.1.1.3.1.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrainDetectionSystemType>,
        <http://data.europa.eu/949/shapes/TrainDetectionSystemTypeSKOS> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2021-08-07"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    rdfs:comment "Indication of types of train detection systems installed."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:TrainDetectionSystem ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:VehicleType ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf onto:otherTrainDetectionSystemsObjParameter,
        onto:vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "Explanation on data presentation: \\nThe option of \"wheel detector\" has to be also selected for: wheel sensor for axle counter, pedal or treadle."@en,
        "Verification of compliance with TSI includes application of notified national rules (when they exist).\\n\\nExplanation on data presentation: \\nThe option of \"wheel detector\" has to be also selected for: wheel sensor for axle counter, pedal or treadle.\\n\\nIf there is no train detection system (if this parameters is not applicable) it has an impact on parameters \"Type of track circuits or axle counter to which specific checks are needed\" and \"Document with the procedure(s) related to the type of train detection systems declared in 1.1.1.3.7.1.2 ( 1.2.1.1.6.1, if in OP)\", making them also not applicable."@en .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "An unambiguous reference to the resource within a given context."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal ;
    skos:example "Examples include International Standard Book Number (ISBN), Digital Object Identifier (DOI), and Uniform Resource Name (URN)." .

onto:PrimaryLocation a owl:Class ;
    rdfs:label "Primary Location"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PrimaryLocationShape> ;
    dcterms:modified "2024-10-28"^^xsd:date,
        "2025-03-01"^^xsd:date,
        "2025-06-06"^^xsd:date ;
    rdfs:comment "Primary Location is a place used by IM to define a path for a train in TAF/TAP TSI framework/messages. This location is a rail point inside the rail network where train starts, ends, stops, or runs through or change line. This location must be managed by an Infrastructure Manager (IM) identified by company code.\\n\\nPrimary locations are identified by single and unique Primary Location codes. Primary location code is allocated based on processes defined by national entity. Primary location codes are used in any kind of TAF/TAP communication.\\n\\nSee: Handbook 9.3.3 / page 60"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso "http://taf-jsg.info/wp-content/uploads/2025/07/JSG-Handbook-3.7-with-XSD-3.5.1.0.pdf"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom onto:NetPointReference ;
            owl:onProperty onto:netReference ],
        onto:InfrastructureElement ;
    owl:disjointWith onto:RadioBlockCenter,
        onto:SectionOfLine,
        onto:Signal,
        onto:SpecialArea,
        onto:SubsidiaryLocation,
        onto:Switch,
        onto:Track,
        onto:Tunnel ;
    skos:example "Primary locations are for example: stations, yards, halts, handover points, border points, open access terminals. "@en .

onto:Signal a owl:Class ;
    rdfs:label "Signal"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SignalShape> ;
    dcterms:created "2021-04-01"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2023-09-28> ;
    rdfs:comment "A railway signal is a visual display device (next to the tracks or via a DMI in the cabin) that conveys instructions or provides advance warning of instructions regarding the driver's authority to proceed."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf"^^xsd:anyURI ;
    rdfs:subClassOf onto:InfrastructureElement ;
    owl:disjointWith onto:SpecialArea,
        onto:Switch,
        onto:Track,
        onto:Tunnel ;
    ns1:term_status "stable" ;
    skos:definition "Apparatus by means of which a conventional visual or acoustic indication is given, generally concerning the movements/movement authorities of railway vehicles."@en .

onto:contactLineSystemType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Type of contact line system"@en ;
    onto:XMLName "ECS_SystemType" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "If this parameter is repeated, parameters 1.1.1.2.2.1.2, and 1.1.1.2.2.2 shall be created also for the corresponding type. These two parameters are to be considered children of the current. "@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/contact-line-systems/ContactLineSystems> ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.2.2.1.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ContactLineSystemType>,
        <http://data.europa.eu/949/shapes/ContactLineSystemTypeNotElectrifiedApplicability>,
        <http://data.europa.eu/949/shapes/ContactLineSystemTypeSKOS>,
        <http://data.europa.eu/949/shapes/ContactLineSystemTypeThirdOrFourthRailApplicability> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2021-08-06"^^xsd:date ;
    dcterms:modified "2021-08-06"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment "Indication of the type of the contact line system."@en ;
    rdfs:domain onto:ContactLineSystem ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf onto:contactLineSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "When the value is \"not electrified\", then all parameters 1.1.1.2.2.1.2 - 1.1.1.2.5.3 are not applicable. \\nWhen the value is “Third Rail” or “Fourth Rail”, then parameters 1.1.1.2.2.3, 1.1.1.2.2.5 - 1.1.1.2.4.2.3, 1.1.1.2.5.2 and 1.1.1.2.5.3 are not applicable\\n\\nFor RINF XML data sets:\\nAs long as the data provision through XML data sets is allowed, if this parameter is repeated, parameters 1.1.1.2.2.1.2, 1.1.1.2.2.2, 1.1.1.2.2.4 and 1.1.1.2.5.1 shall be created also for the corresponding type. These four parameters are to be considered children of the current. \\nFor grouping “children” parameters of the current parameter, an XML attribute called “set” must be declared at the parent and children levels with the same keyword value."@en .

onto:Siding a owl:Class ;
    rdfs:label "Siding"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SidingShape> ;
    dcterms:created "2021-08-10"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2020-06-16> ;
    rdfs:comment "Sidings are all those tracks where running trains in service movements ends and which are not used for operational routing of a train."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Track ;
    owl:disjointWith onto:Signal,
        onto:Switch,
        onto:Tunnel ;
    ns1:term_status "stable" ;
    skos:definition "Siding - Any track(s) within an operational point which is not used for operational routing of a train."@en .

onto:Document a owl:Class ;
    rdfs:label "ERA Document"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/DocumentShape> ;
    dcterms:created "2024-04-23"^^xsd:date ;
    rdfs:comment "Document in any of the ERA systems, e.g. reference document in RINF."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf foaf:Document ;
    ns1:term_status "stable" .

onto:networkStatementsDataCharacteristic a owl:DatatypeProperty ;
    rdfs:label "Network statements characteristic" ;
    dcterms:created "2025-09-29"^^xsd:date ;
    rdfs:isDefinedBy onto: .

onto:Track a owl:Class ;
    rdfs:label "Track"@en ;
    dcterms:created "2024-11-20"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "A pair of rails over which rail borne vehicles can run."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:InfrastructureElement ;
    owl:disjointWith onto:Tunnel .

onto:OperationalPoint a owl:Class ;
    rdfs:label "Operational Point"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OperationalPointShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "An operational point (OP) means any location for train service operations, where train services may begin and end or change route, and where passenger or freight services may be provided; operational point also means any location at boundaries between Member States or infrastructure managers."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:InfrastructureElement ;
    owl:disjointWith onto:PlatformEdge,
        onto:PrimaryLocation,
        onto:RadioBlockCenter,
        onto:SectionOfLine,
        onto:Signal,
        onto:SpecialArea,
        onto:Switch,
        onto:Track,
        onto:Tunnel ;
    ns1:term_status "stable" .

onto:TrainDetectionSystem a owl:Class ;
    rdfs:label "Train Detection System"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrainDetectionSystemShape> ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2021-08-07"^^xsd:date ;
    rdfs:comment "Safety system used to detect the presence of vehicles on the railway track."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:SectionOfLine a owl:Class ;
    rdfs:label "Section Of Line"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SectionOfLineShape> ;
    dcterms:created "2021-04-02"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "A section of line means the part of line between adjacent operational points and may consist of several tracks."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass onto:OperationalPoint ;
            owl:onProperty onto:opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass onto:OperationalPoint ;
            owl:onProperty onto:opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass onto:LinearPositioningSystem ;
            owl:onProperty onto:nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        onto:InfrastructureElement ;
    owl:disjointWith onto:Signal,
        onto:SpecialArea,
        onto:Switch,
        onto:Track,
        onto:Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "Each network shall be described using as many SoLs as necessary. Each SoL   is generated and identified by OP IDs at start and at end. A SoL only belongs to one Line."@en .

onto:vehicleTypeTechnicalObjectCharacteristic a owl:ObjectProperty ;
    rdfs:label "Vehicle type technical characteristic"@en ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy onto: .

onto:InfrastructureElement a owl:Class ;
    rdfs:label "Infrastructure element"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InfrastructureElementShape> ;
    dcterms:created "2022-07-07"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-10-28"^^xsd:date,
        "2025-04-30"^^xsd:date ;
    rdfs:comment "This class encompasses all those classes that represent features that are  implemented in the European railway infrastructure. It is a subclass of the ERA Feature that has a spatial representation. It covers tracks, platforms, signals, tunnels, operational points, and sections of line.\\nA feature that belongs to the infrastructure can be abstracted (hasAbstraction) as a topological object. It also is related to the infrastructure manager through the property infrastructureMgr."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Feature .

onto:etcsLevelType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "European Train Control System (ETCS) level"@en ;
    onto:XMLName "CPE_Level" ;
    onto:applicable "Y/N" ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-levels/ETCSLevels> ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.3.2.1",
        "1.2.1.1.1.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsLevelType>,
        <http://data.europa.eu/949/shapes/EtcsLevelTypeSKOS> ;
    onto:tsiOPEAppendixD2Index "3.2.7" ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-08-13"^^xsd:date,
        "2025-01-23"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:cantDeficiencyBasicSSP,
        onto:etcsBaseline,
        onto:etcsDegradedSituation,
        onto:etcsMVersion,
        onto:etcsSystemCompatibility,
        onto:etcsTransmittedTrackConditions,
        onto:gsmRActiveMobiles,
        onto:rbcID,
        onto:rbcPhone ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "ETCS application level related to the track side equipment."@en ;
    rdfs:domain onto:ETCS ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "TSI CCS (Subset-026, Chapter 2, 2.6)" ;
    rdfs:subPropertyOf onto:tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "The different ERTMS / ETCS application levels are a way to express the possible operating relationships between track and train. \\n  \\nLevel definitions are principally related to the track side equipment used, to the way the track side information reaches the on-board units and to which functions are processed in the track side and in the on-board equipment respectively.\\n\\nIf ETCS is on the trackside (one or more levels are selected), all other ETCS parameters (from 1.1.1.3.2.2 to 1.1.1.3.2.10) are applicable and mandatory to be populated with values .\\nIf the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter is “N”(not applicable). \\n\\nThe ETCS value NTC is only relevant when the line is dual equipped with ETCS (i.e., balises are placed in the track) and Class B system, and both systems are in operation at the same time. \\nIn those cases, this parameter should be filled relevant ETCS Level and repeated with the value NTC.\\n  \\nIf the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter etcsLevelType should not be used. \\n\\nIf operation in the line is authorised for ETCS and non ETCS vehicles using class B system, Parameter 1.1.1.3.5.3 shall also be used in combination with 1.1.1.3.2.1.\\nSee: TSI CCS (Subset-026, Chapter 2, 2.6)"@en .

onto:Tunnel a owl:Class ;
    rdfs:label "Tunnel"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TunnelShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
    rdfs:comment "A railway tunnel is an excavation or a construction around the track provided to allow the railway to pass for example higher land, buildings or water."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:InfrastructureElement ;
    ns1:term_status "stable" ;
    skos:definition "A railway tunnel is an excavation or a construction around the track provided to allow the railway to pass for example higher land, buildings or water. \\n\\nThe length of a tunnel is defined as the length of the fully enclosed section, measured at rail level. A tunnel in the context of this TSI is 0.1 km or longer. \\nWhere certain requirements apply only to longer tunnels, thresholds are mentioned in the relevant clauses."@en .

onto:vehicleTypeTechnicalDataCharacteristic a owl:DatatypeProperty ;
    rdfs:label "Vehicle type technical characteristic"@en ;
    rdfs:isDefinedBy onto: .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en .

onto:RunningTrack a owl:Class ;
    rdfs:label "Running track"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RunningTrackShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    rdfs:comment "A running track means any track used for train service movements; passing loops and meeting loops on plain line or track connections only required for train operation are not published"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Track ;
    owl:disjointWith onto:Siding,
        onto:Signal,
        onto:Switch,
        onto:Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "There might be more than one track within the Section of Line, so then the whole set of data for track has to be repeated for each track within the SoL."@en .

onto:VehicleType a owl:Class ;
    rdfs:label "Vehicle Type"@en ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2020-07-29"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-06-03"^^xsd:date ;
    rdfs:comment "A vehicle type that has been authorized to operate on the EU railway infrastructure. Type means a vehicle type defining the basic design characteristics of the vehicle as covered by a type or design examination certificate described in the relevant verification module. \\n\\nBasic design characteristics means the parameters that are used to identify the vehicle type as specified in the issued vehicle type authorisation and recorded in the European Register of Authorised Vehicle Types ('ERATV').\\n\\nThe above mentioned certificate should be documented using era:certificate.\\n"@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:CommonCharacteristicsSubset a owl:Class ;
    rdfs:label "Subset with common characteristics"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CommonCharacteristicsSubsetShape> ;
    dcterms:created "2022-11-04"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-10-31"^^xsd:date,
        "2025-08-26"^^xsd:date,
        "2026-01-11"^^xsd:date ;
    rdfs:comment "A set of different infrastructure objects sharing the same common technical characteristics. The parameters may not be restricted to only one railway subsystem, but it can include common characteristics from each one of them (infrastructure, energy, track-side CCS)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Feature ;
    ns1:term_status "stable" .

onto: a owl:Ontology ;
    rdfs:label "ERA Ontology"@en ;
    ns2:license <http://data.europa.eu/eli/dec_impl/2017/863/oj> ;
    dcterms:contributor [ org:memberOf <http://publications.europa.eu/resource/authority/corporate-body/ERA> ;
            foaf:name "Maarten Duhoux" ],
