onto:demonstrationINF a owl:DatatypeProperty ;
    rdfs:label "EI declaration of demonstration (as defined in Commission 2014/881/EU (2)) relating to compliance with the requirements from TSIs applicable to infrastructure subsystem"@en ;
    onto:XMLName "IDE_EIDemonstration" ;
    onto:applicable "Y/N" ;
    onto:formatNote "CC/RRRRRRRRRRRRRR/YYYY/NNNNNN" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.1.2",
        "1.2.1.0.1.2",
        "1.2.2.0.1.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/DemonstrationINF>,
        <http://data.europa.eu/949/shapes/DemonstrationINFS> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reco/2014/881/oj>,
        <http://data.europa.eu/eli/reg_impl/2019/777/2023-09-28> ;
    rdfs:comment "Unique number for EI declarations following the same format requirements as specified for EC declarations in Annex VII of Commission Implementing Regulation (EU) 2019/250."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:infraSubsystemDeclarationsVerificationTrackDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "EI declaration of demonstration (as defined Commission 2014/881/EU) for track relating to compliance with the requirements from TSIs applicable to infrastructure subsystem.\\n\\nIt may happen that several EI declarations were issued - then parameter has to be repeated as many times as many declarations were issued.\\n\\nThe procedure for demonstration that existing network fits to requirements of the TSIs is executed on voluntary basis, so when EI declaration do not exist then the parameter is optional. If EI declaration was not issued, then field shall be left empty. "@en,
        "It may happen that several EI declarations were issued - then parameter has to be repeated as many times as many declarations were issued.\\n\\nThe procedure for demonstration that existing network fits to requirements of the TSIs is executed on voluntary basis, so when EI declaration do not exist then the parameter is optional. If EI declaration was not issued, then field shall be left empty. "@en .

onto:demonstrationSRT a owl:DatatypeProperty ;
    rdfs:label "EI declaration of demonstration (as defined in Recommendation 2014/881/EU) relating to compliance with the requirements from TSIs applicable to railway tunnel"@en ;
    onto:XMLName "ITU_EIDemonstration" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote " Applicable in case when the demonstration was executed and EI declaration was issued.\\n \\nThe procedure for demonstration that existing network fits to requirements of the TSIs is executed on voluntary bases, so when EI declaration do not exist then the parameter is optional."@en ;
    onto:formatNote "CC/RRRRRRRRRRRRRR/YYYY/NNNNNN" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.8.6",
        "1.2.1.0.5.4",
        "1.2.2.0.5.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/DemonstrationSRT> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-06-26"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reco/2014/881/oj>,
        <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
    rdfs:comment "Unique number for EI declarations following the same format requirements as specified for EC declarations in Annex VII of Commission Implementing Regulation (EU) 2019/250."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:Tunnel ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "[22] Recommendation 2014/881/EU" ;
    rdfs:subPropertyOf onto:tunnelDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "(SRT) in title means that here we include only declarations concerning requirements of SRT TSI for infrastructure system on the specific track.\\nParameter shall be repeated when different EI declarations were issued for different elements of infrastructure subsystem on the specific track in the tunnel.\\nIt may happen that several EI declarations were issued   then parameter has to be repeated as many times as many declarations were issued.\\nThe procedure for demonstration that existing network fits to requirements of the TSIs is executed on voluntary bases, so when EI declaration do not exist then the parameter is optional. "@en .

