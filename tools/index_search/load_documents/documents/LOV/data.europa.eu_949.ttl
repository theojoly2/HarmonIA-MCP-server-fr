                            rdf:rest [ a rdf:List ;
                                    rdf:first onto:VehicleType ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "Referenced in Appendix A-1, index [E] and index [F]"@en ;
    rdfs:subPropertyOf onto:tsiCompliantRadioObjParameter,
