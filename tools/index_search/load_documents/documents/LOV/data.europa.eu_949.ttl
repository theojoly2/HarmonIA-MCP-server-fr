onto:maxPermittedTrainLength a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum train length allowed"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "Applicable only to sections of lines belonging to TEN-T corridors. \\n                            It applies to sections of lines where tracks have a TEN classification (1.1.1.1.2.1) that is neither 'off-TEN' nor not applicable ('N')"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaxPermittedTrainLength>,
        <http://data.europa.eu/949/shapes/MaxPermittedTrainLengthApplicability> ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    dcterms:created "2025-11-25"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2024/1679/oj> ;
    rdfs:comment "Maximum train length in meters allowed on a section of line, without special permission, for the operation of freight trains. \\n                            In accordance with Regulation (EU) 2024/1679, Article 15(2)(c), this maximum length must be supported by the infrastructure manager's ability \\n                            to allocate sufficient train paths for freight trains of at least 740 meters (including the locomotive or locomotives), as required for the TEN-T network."@en ;
    rdfs:domain onto:RunningTrack ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf onto:length ;
    skos:scopeNote "The specific allocation requirements for single and double-track lines are as follows:\\n                            - Double-track lines: At least one train path every 2 hours per direction on average daily.\\n                            - Single-track lines: At least one train path every 3 hours per direction, with a minimum of 12 daily train paths allocated.\\n                            These allocation conditions must be met if requested by a railway undertaking, as specified in Regulation (EU) 2024/1679, Article 16(2)(b)(i)-(ii)."@en .

