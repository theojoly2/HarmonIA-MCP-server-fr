onto:errorCorrectionsOnboard a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Error corrections required for the on-board ETCS, GSM-R and/or ATO function"@en ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/error-corrections/OnboardErrorCorrections> ;
    onto:legalDeadline "12 months after the entry into force of TSI CCS and at least 12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.3.1.2",
        "1.2.1.1.1.19" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ErrorCorrectionsOnboard>,
        <http://data.europa.eu/949/shapes/ErrorCorrectionsOnboardSKOS> ;
    dcterms:created "2024-04-18"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:replaces onto:ertmsErrorCorrectionsOnBoard,
        onto:etcsErrorCorrectionsOnboard,
        onto:gsmrErrorCorrectionsOnboard ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "List of unacceptable errors impacting the IM network that are required to be solved in the on-board according to the TSI CCS point 7.2.10.3 specification maintenance point (ETCS, GSM-R and/or ATO). An additional parameter (era:errorCorrectionsOnboardExplanation) must document if a non-implemented CR has been accepted by the IM."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf onto:ccsSubsystemDeclarationsVerificationTrackObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "This parameter should be limited to those required for the onboard, in order to allow normal service as defined in Art. 10 CR. The values will come from a list.\\nIM's may choose to make available the optional ETCS error corrections as well, but this should be done using other means than the RINF register.\\nThis parameter should also be understood as ETCS, ATO and GSM-R related error corrections required for the on-board. pending a formal update and approval of the relevant legislative annex.\\nFor the specific track the error corrections to be applied is one list only."@en .

