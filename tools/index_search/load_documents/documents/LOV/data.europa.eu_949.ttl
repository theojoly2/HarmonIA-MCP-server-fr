onto:hasBallast a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Existence of ballast"@en ;
    onto:XMLName "ITP_Ballast" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Mandatory for tracks with permitted speed (parameter 1.1.1.1.2.5) greater than 250km/h"@en ;
    onto:formatNote "in XML: Y/N" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.4.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasBallast>,
        <http://data.europa.eu/949/shapes/HasBallastApplicability> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2021-09-10"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "Specifies whether track construction is with sleepers embedded in ballast or not."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "Loc&Pas TSI 4.2.6.2.5\\nINF TSI : 4.2.10.3" ;
    rdfs:subPropertyOf onto:trackDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "This parameter is related to phenomena of ballast pick-up observed for the high-speed traffic.\\nRequirements regarding ballast pick-up reduction at infrastructure subsystem level only applies to lines intended to be operated at speed greater than 250 km/h and is an open point in INF TSI: 4.2.10.3\\nThe parameter is about the phenomenon of ballast pick-up observed for the high-speed traffic, not about the ballast itself. \\nAs so far any specifications for mitigation of the problem were disclosed, the only information from RINF will be data about the network where the problems may be faced."@en .

