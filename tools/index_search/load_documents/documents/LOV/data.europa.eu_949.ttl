    rdfs:comment "Indication whether rules exist and are compliant with the TSI."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    owl:deprecated true ;
    ns1:term_status "stable" ;
    skos:scopeNote "Compatibility with track circuits and wheel detectors of axle counters. The harmonics in the traction current in the rails can interfere with the operation of track circuits. The DC current in the rails may saturate the detectors of the axle counters, preventing their  operation. \\n none  shall be selected when respective national rules do not exist."@en .

