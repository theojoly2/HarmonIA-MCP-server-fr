onto:canonicalURI a owl:AnnotationProperty ;
    rdfs:label "Canonical URI"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CanonicalURI> ;
    dcterms:created "2022-12-13"^^xsd:date ;
    dcterms:modified "2024-02-06"^^xsd:date ;
    rdfs:comment "The canonical URI is defined for each instance of an Infrastructure element, e.g. section of line, operational point, track, tunnel, siding.\\nObjects of the infrastructure generated through RML mappings include (when provided) their validity start and end dates. With its identifier, plus all identifiers of its \"parent\" elements, and its validity dates, a hash URI is generated.\\nThe canonical URI is the element's URI with its identifiers and without the validity dates. All of the hash URIs of an element point to its canonical URI.\\nAdditionally, SoLs point to the canonical URIs of their start OP and end OP."@en ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI .

onto:cantDefficiency a owl:DatatypeProperty ;
    rdfs:label "Cant defficiency"@en ;
    onto:eratvIndex "4.6.1" ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    dcterms:created "2021-08-26"^^xsd:date ;
    dcterms:modified "2021-08-26"^^xsd:date,
        "2024-06-26"^^xsd:date,
        "2025-03-05"^^xsd:date ;
    rdfs:comment "Cant deficiency (maximum uncompensated lateral acceleration) for which the vehicle has been assessed. For dual gauge vehicles values for each gauge have to be indicated."@en ;
    rdfs:domain onto:VehicleType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf onto:vehicleTypeTechnicalDataCharacteristic ;
    owl:deprecated true ;
    ns1:term_status "stable" .

onto:cantDeficiency a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Cant deficiency"@en ;
    onto:XMLName "ITP_CantDeficiency" ;
    onto:applicable "Y" ;
    onto:formatNote "+/-NNN" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.4.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CantDeficiency> ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-10"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "Maximum cant deficiency expressed in millimetres defined as difference between the applied cant and a higher equilibrium cant the line has been designed for."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "INF TSI: 4.2.4.3" ;
    rdfs:subPropertyOf onto:trackDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "In case of positive value of cant deficiency or zero symbol  '+' shall be applied. In case of negative cant deficiency symbol '-' has to be selected. Value of the cant deficiency shall be given in millimetres. In case of lateral uncompensated acceleration on a 1435 mm track gauge of 1.0 m/s2 the value of 153 mm may be published."@en .

onto:carrierLinearElement a owl:ObjectProperty ;
