onto:etcsRestrictionsConditionsDoc a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "document with operating restrictions or conditions"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsRestrictionsConditionsDoc>,
        <http://data.europa.eu/949/shapes/EtcsRestrictionsConditionsDocApplicability> ;
    dcterms:modified "2025-02-28"^^xsd:date,
        "2025-05-05"^^xsd:date ;
    rdfs:comment "Indication of the document where restrictions or conditions due to partial compliance with the TSI CCS are described."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:Track ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:seeAlso "https://www.era.europa.eu/content/certification-issues"^^xsd:anyURI,
        "https://www.era.europa.eu/system/files/2022-11/restrictions_and_added_functions_en_1.doc"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:tsiCompliantTrainProtectionSystemObjParameter ;
    skos:scopeNote "If not `false` (property hasEtcsRestrictionsConditions), a link to the conditions must be provided. The RU has to contact the IM to be informed about these conditions.\\nThese conditions and restrictions of use are considered in section 6.4 of the CCS TSI. They should be described using the template available on Agency website (Certification and deviations - Guidelines for using the ERA template) with the following link.                                  \\n\\nThe value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link."@en .

onto:etcsSystemFunctionalitiesNextFiveYears a owl:DatatypeProperty ;
    rdfs:label "ETCS system version 2.2 or 3.0 functionalities to be required in the next 5 years"@en ;
    onto:applicable "N" ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
