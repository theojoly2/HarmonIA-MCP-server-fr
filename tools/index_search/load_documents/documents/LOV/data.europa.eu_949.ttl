                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:unsignedInt ;
            owl:withRestrictions [ a rdf:List ;
                    rdf:first [ xsd:minInclusive "0"^^xsd:unsignedInt ] ;
                    rdf:rest [ a rdf:List ;
                            rdf:first [ xsd:maxInclusive "600"^^xsd:unsignedInt ] ;
                            rdf:rest () ] ] ] ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:etcsNationalValuesDataParameter ;
