    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmRActiveMobiles>,
        <http://data.europa.eu/949/shapes/GsmRActiveMobilesApplicability>,
        <http://data.europa.eu/949/shapes/GsmRActiveMobilesSKOS> ;
    dcterms:created "2021-08-08"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date ;
    dcterms:relation onto:etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Number of simultaneous communication session on board for ETCS level 2 required for a smooth running of the train. This relates to the radio block centre (RBC) handling of communication sessions. Not safety critical and no matter of interoperability."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf onto:tsiCompliantRadioObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "In case there is no ETCS Level 2 in the line, do this parameter must be flagged as Not Applicable.\\nIn case there is ETCS Level 2 in the line, the minimum number of EDOR required on board would be 1. \\nIn case ETCS baseline 3 release 2 or baseline 4 is selected, select \"2\" .\\nPlease select \" 1\"  or \"2\" , taking into account that TSI compliant trains may only be fitted with 1 EDOR."@en .

onto:gsmrErrorCorrectionsOnboard a owl:DatatypeProperty ;
    rdfs:label "(Deprecated) GSM-R error corrections required for the on-board"@en ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:isReplacedBy onto:errorCorrectionsOnboard ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date ;
