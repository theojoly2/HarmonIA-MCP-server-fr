onto:areaBoardingAid a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Range of use of the platform boarding aid"@en ;
    onto:XMLName "IPL_AreaBoardingAid" ;
    onto:applicable "Y/N" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.2.1.0.6.7" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AreaBoardingAid> ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    dcterms:created "2021-08-02"^^xsd:date ;
    dcterms:modified "2023-01-20"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "Information of the train access level for which the boarding aid can be used."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:PlatformEdge ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf onto:platformDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Information of the train access level for which the boarding aid can be used. Data is presented as the vertical difference that is overcome by the platform boarding aid in millimetres. The value “0” means that the platform is not equipped with a platform boarding aid."@en .

onto:assistanceStartingTrain a owl:DatatypeProperty,
