onto:tsiMagneticFields a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Existence and TSI compliance of rules for magnetic fields emitted by a vehicle"@en ;
    onto:XMLName "CEI_TSIMagneticFields" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "Applicable ( Y ) only when for parameter 1.1.1.3.7.1 the selected option is wheel detector. The parameter is not applicable when the rules do not exist."@en ;
    onto:formatNote "Y/N" ;
    onto:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.3.9.1",
        "1.2.1.1.8.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TsiMagneticFields>,
        <http://data.europa.eu/949/shapes/TsiMagneticFieldsApplicability> ;
    dcterms:created "2024-04-18"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date,
        "2025-02-18"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:trainDetectionSystemType ;
    dcterms:replaces onto:TSIMagneticFields ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether rules exist and are compliant with the TSI."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:relatedElectromagneticInterferencesDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "The electromagnetic fields generated by rolling stock can interfere with the operation of axle counters and wheel detectors. \\n                      'True' means the rules exist and are compliant with the frequency management specified in the TSI.\\n                      'False' means the rules exist and are not compliant with the frequency management specified in the TSI.\\n\\n                      Verification of compliance with TSI includes application of notified national rules (when they exist) in case of part covered by open point."@en .

