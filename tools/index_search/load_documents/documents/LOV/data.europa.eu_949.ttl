        "2024-11-18"^^xsd:date,
        "2024-11-29"^^xsd:date,
        "2025-02-18"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:replaces onto:lineNationalId,
        onto:lineReference ;
    rdfs:comment "Indicates a relationship with a national railway line at a specific kilometer point.\\nFor a Section of Line: unique line identification or unique line number within Member State."@en ;
