onto:hasLRS a owl:ObjectProperty ;
    rdfs:label "has linear referencing system"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasLrsCoordinate> ;
    dcterms:created "2024-11-29"^^xsd:date ;
