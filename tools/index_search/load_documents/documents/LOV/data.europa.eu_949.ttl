onto:etcsBaseline a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "ETCS baseline"@en ;
    onto:XMLName "CPE_Baseline" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    onto:eratvIndex "4.13.1.2" ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-baselines/ETCSBaselines> ;
    onto:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.3.2.2",
        "1.2.1.1.1.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsBaseline>,
        <http://data.europa.eu/949/shapes/EtcsBaselineApplicability>,
        <http://data.europa.eu/949/shapes/EtcsBaselineSKOS> ;
    onto:tsiOPEAppendixD2Index "3.2.7" ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2021-08-31"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation onto:etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "ETCS baseline installed lineside."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:ETCS ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:VehicleType ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "TSI CCS (Table A2)" ;
    rdfs:subPropertyOf onto:tsiCompliantTrainProtectionSystemObjParameter,
        onto:vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "The ETCS baseline needs to be provided for each available ETCS Level. See: TSI CCS (Table A2)"@en .

onto:gprsForETCS a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "GPRS for ETCS"@en ;
    onto:XMLName "CRG_GPRSForETCS" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "GSM-R and ETCS L2 must be installed for this parameter to be applicable."@en ;
    onto:legalDeadline "1 January 2021"@en,
        "12 months after publication of Article 7 Guide for OP tracks"@en ;
    onto:rinfIndex "1.1.1.3.3.3.2",
        "1.2.1.1.2.3.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GprsForETCS>,
        <http://data.europa.eu/949/shapes/GprsForETCSApplicability> ;
    dcterms:created "2021-08-08"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation onto:etcsLevelType,
        onto:gprsForETCS ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication if GPRS can be used for ETCS"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf onto:tsiCompliantRadioDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Sections of EIRENE and ETCS subsets for trackside in TSI"@en .

onto:hasPart a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasPart>,
        <http://data.europa.eu/949/shapes/HasPartOP>,
        <http://data.europa.eu/949/shapes/HasPartSoL> ;
    dcterms:created "2024-05-24"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-02-18"^^xsd:date,
        "2025-07-24"^^xsd:date ;
    dcterms:replaces onto:siding,
        onto:track ;
    rdfs:comment "Indicates that an infrastructure element is composed of one or more other (distinct) infrastructure elements.\\nThis property is used to represent part-whole relationships between infrastructure elements.\\nAn element cannot be a part of itself."@en ;
    rdfs:domain onto:InfrastructureElement ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:InfrastructureElement ;
    owl:inverseOf onto:isPartOf .

onto:lineLayoutDataParameter a owl:DatatypeProperty ;
    rdfs:label "Line layout"@en ;
    onto:rinfIndex "1.1.1.1.3",
        "1.2.1.0.3" ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf onto:infraSubsystemDataParameter .

onto:loadCapability a owl:ObjectProperty ;
    rdfs:label "Load Capability"@en ;
    onto:XMLName "IPP_LoadCap" ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/load-capabilities/LoadCapabilities> ;
    onto:rinfIndex "1.1.1.1.2.4" ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:isReplacedBy onto:LoadCapability,
        onto:loadCapabilityLineCategory,
        onto:loadCapabilitySpeed,
        onto:trackLoadCapability ;
    dcterms:modified "2023-01-20"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    rdfs:comment "A combination of the line category and speed at the weakest point of the track. The reason for deprecation is that the load capability property 1.1.1.1.2.4 was defined incorrectly as a SKOS property. It is composed of two values: (1)  line category, and (2) speed. Only line category is a list of predefined values (SKOS), whereas speed is an integer (according to the RINF application guide)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    owl:deprecated true ;
    ns1:term_status "stable" .

onto:maximumSpeedAndCantDeficiency a owl:DatatypeProperty ;
    rdfs:label "Maximum speed and cant deficiency"@en ;
    onto:eratvIndex "4.6.4" ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:isReplacedBy onto:MaximumSpeedAndCantDeficiency,
        onto:vehicleTypeMaximumCantDeficiency,
        onto:vehicleTypeMaximumSpeed,
        onto:vehicleTypeMaximumSpeedAndCantDeficiency ;
    dcterms:modified "2023-04-05"^^xsd:date ;
    rdfs:comment "Combination of maximum speed and maximum cant deficiency for which the vehicle was assessed.\\n\\nThis property was before an object skos property. The values for this property do not come from a list of predefined values. Thus, the original object property was replaced by this datatype property with range xsd:string.\\nDeprecated because of replacement by a class and two integer properties. The reason is that the property represents two concepts: [number] km/h for maximum speed - [number] mm for maximum cant deficiency."@en ;
    rdfs:domain onto:VehicleType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    ns1:term_status "stable" .

onto:otherTrainDetectionSystemsObjParameter a owl:ObjectProperty ;
