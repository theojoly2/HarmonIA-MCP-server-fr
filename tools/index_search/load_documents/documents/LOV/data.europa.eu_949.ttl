    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI ;
    owl:deprecated true ;
    ns1:term_status "stable" .

onto:hasEtcsNationalPacket44 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has ETCS national packet 44 application implemented"@en ;
    onto:XMLName "CPE_NatApplication" ;
    onto:dependencyNote "Only applicable when selected value for 1.1.1.3.2.1 (ETCS present)."@en ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.3.2.5",
        "1.2.1.1.1.5" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasEtcsNationalPacket44>,
        <http://data.europa.eu/949/shapes/HasEtcsNationalPacket44Applicability> ;
    dcterms:created "2024-11-20"^^xsd:date ;
    dcterms:modified "2025-05-05"^^xsd:date ;
    dcterms:replaces onto:etcsNationalPacket44 ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether data for national packet 44 applications is transmitted between track and train."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:Track ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:tsiCompliantTrainProtectionSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Value can be `false` or a link to the implemented functions. The hasEtcsNationalPacket44 property represents the true or false value. The etcsNationalPacket44Function represents the functions.\\n\\nPackets 44 are the means to transmit data for national applications between train and track and vice versa, using the data transmission facilities included within the ETCS. \\nNID_XUSER values managed by ERA in a document about ETCS variables available on ERA website. \\n\\nSee: TSI CCS (7.4.3 & 6.2.4.2)."@en .

