onto:etcsNationalPacket44Function a owl:ObjectProperty ;
    rdfs:label "ETCS national packet 44 application implemented"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-national-packet-44-functions/ETCSNationalPacket44Functions> ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsNationalPacket44Function>,
        <http://data.europa.eu/949/shapes/EtcsNationalPacket44FunctionSKOS> ;
    dcterms:created "2024-11-20"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-05-05"^^xsd:date ;
    dcterms:relation onto:etcsLevelType ;
    dcterms:replaces onto:etcsNationalPacket44 ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether data for national applications is transmitted between track and train."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:Track ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Value can be `false` or a link to the implemented functions.\\n\\nPackets 44 are the means to transmit data for national applications between train and track and vice versa, using the data transmission facilities included within the ETCS. \\nNID_XUSER values managed by ERA in a document about ETCS variables available on ERA website. \\n\\nSee: TSI CCS (7.4.3 & 6.2.4.2)"@en .

onto:etcsSystemCompatibility a owl:ObjectProperty ;
    rdfs:label "ETCS system compatibility"@en ;
    onto:XMLName "CPE_SystemCompatibility" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    onto:eratvIndex "4.13.1.8" ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-system-compatibilities/ETCSSystemCompatibilities> ;
    onto:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.3.2.9",
        "1.2.1.1.1.9" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsSystemCompatibility>,
        <http://data.europa.eu/949/shapes/EtcsSystemCompatibilityApplicability>,
        <http://data.europa.eu/949/shapes/EtcsSystemCompatibilitySKOS> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-31"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation onto:etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/776/oj>,
        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "ETCS requirements used for demonstrating technical compatibility."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:ETCS ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:VehicleType ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI,
        "https://www.era.europa.eu/system/files/2023-05/esc-rsc_technical_document_en.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:tsiCompliantTrainProtectionSystemObjParameter,
        onto:vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "The Values \"Not defined\" or \"ESC-EU-0\" should not be combined with other values.\\n\\nFor application in CCS Onboard:\\nThe vehicles are considered compatible with the infrastructure for this parameter, if their parameter value matches any of the values declared on the trackside. \\n\\nFor application in CCS Trackside:\\nThe Infrastructure Manager is responsible for defining the ESC type(s). All sections of the Union network which require the same set of checks for the demonstration of ESC shall have the same ESC type.\\n\\nSee: TSI CCS, Appendix A, Table A 1, 4.2.17 a.\\nThe list of ESC Types is published and maintained by the European Union Agency for Railways in the technical document \"ESC/RSC technical document, TD/011REC1028\". \\nThe Agency shall assess the checks unless they have been assessed by a NoBo as required in Table 6.3 row 10. \\nThe assessment by the Agency shall be done within 2 months of receipt thereof, unless a longer period is agreed between the Agency and the Infrastructure Manager but not exceeding 4 months in total. \\nThe technical document will be updated within 10 working days after positive assessment.\\n\\nThe ESC Types shall only be used when published with status \"Valid\" in the Agency Technical document referred above."@en .

