    rdfs:comment "The maximum magnetic field limits allowed for axle counters (in dB µA/m) for a defined frequency band.\\nIt should be provided in 3 directions."@en ;
    rdfs:domain onto:TrainDetectionSystem ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:MaximumMagneticField ;
