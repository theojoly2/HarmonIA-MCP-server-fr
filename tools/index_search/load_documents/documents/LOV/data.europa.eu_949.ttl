            foaf:name "Polymnia Vasilopoulou" ],
        [ org:memberOf <http://publications.europa.eu/resource/authority/corporate-body/ERA> ;
            foaf:name "Marina Aguado" ],
        <http://data.europa.eu/949/_:genid-nodeid-node1jfsuh0nsx2>,
        <http://data.europa.eu/949/_:genid-nodeid-node1jfsuh0nsx3>,
        <http://data.europa.eu/949/_:genid-nodeid-node1jfsuh0nsx4> ;
    dcterms:creator [ dcterms:source <https://orcid.org/0000-0003-1562-6922> ;
            org:memberOf <http://publications.europa.eu/resource/authority/corporate-body/ERA> ;
            foaf:name "Ghislain Atemezing" ],
        [ org:memberOf <http://publications.europa.eu/resource/authority/corporate-body/ERA> ;
            foaf:name "Dragos Patru" ] ;
    dcterms:issued "2024-04-18"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date,
        "2024-05-24"^^xsd:date,
        "2024-06-03"^^xsd:date,
        "2024-06-05"^^xsd:date,
        "2024-07-05"^^xsd:date,
        "2024-08-02"^^xsd:date,
        "2024-08-12"^^xsd:date,
        "2024-08-13"^^xsd:date,
        "2024-09-19"^^xsd:date,
