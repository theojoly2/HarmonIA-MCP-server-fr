onto:lengthOfPlatform a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Usable length of platform"@en ;
    onto:XMLName "IPL_Length" ;
    onto:applicable "Y/N" ;
    onto:formatNote "NNNN" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.2.1.0.6.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LengthP> ;
    onto:tsiOPEAppendixD2Index "2.3.6",
        "3.2.3" ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2024-05-16"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28>,
        <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "The maximum continuous length (expressed in metres) of that part of platform in front of which a train is intended to remain stationary in normal operating conditions for passengers to board and alight from the train, making appropriate allowance for stopping tolerances."@en ;
    rdfs:domain onto:PlatformEdge ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:double ;
    rdfs:seeAlso "INF TSI: 4.2.1, 4.2.9.1 \\nOPE TSI: 4.2.2.5.2, 4.2.2.7.2" ;
    rdfs:subPropertyOf onto:length,
        onto:platformDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Platform dimensions are always related to one neighbouring track at a time.\\nSo, if two tracks are along a platform, this platform should be divided into two RINF platforms to have precise description of each."@en .

