    onto:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.3.2.3",
        "1.2.1.1.1.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsInfillLineAccess>,
        <http://data.europa.eu/949/shapes/EtcsInfillLineAccessApplicability> ;
