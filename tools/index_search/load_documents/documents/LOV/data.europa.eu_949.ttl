onto:opEnd a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Operational point at end of section of line"@en ;
    onto:XMLName "SOLOPEnd" ;
    onto:applicable "Y" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.0.0.0.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OpEnd>,
        <http://data.europa.eu/949/shapes/OpEndExists> ;
    onto:tsiOPEAppendixD2Index "3.1.2" ;
    dcterms:created "2021-09-09"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Operational point at the end of section of line (kilometres increasing from start OP to the end OP)."@en ;
    rdfs:domain onto:SectionOfLine ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OperationalPoint ;
    rdfs:subPropertyOf onto:solGenericObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Each SoL may have only one end OP, and each OP has unique OP ID within the MS. The “uniqueOPID” is defined in parameter 1.2.0.0.0.2.\\nEach SoL has the principal direction of the traffic defined by increasing kilometres running from the start OP to the end OP.\\nThat is why the end OP is always located at highest kilometre of the line within the SoL.\\nNo validation will be performed by RINF application regarding which is the start and which the end OP. This requires IM's verification. "@en .

onto:opStart a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Operational point at start of section of line"@en ;
    onto:XMLName "SOLOPStart" ;
    onto:applicable "Y" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.0.0.0.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OpStart>,
        <http://data.europa.eu/949/shapes/OpStartExists> ;
    onto:tsiOPEAppendixD2Index "3.1.1" ;
    dcterms:created "2021-09-09"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Operational point at the start of section of line (kilometres increasing from start OP to the end OP)."@en ;
    rdfs:domain onto:SectionOfLine ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:OperationalPoint ;
    rdfs:subPropertyOf onto:solGenericObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Each SoL may have only one start OP, and each OP has unique OP ID within the MS. The “uniqueOPID” is defined in parameter 1.2.0.0.0.2.\\nEach SoL has the principal direction of the traffic defined by increasing kilometres running from the start OP to the end OP.\\nThat is why the start OP is always located at lowest kilometre of the line within the SoL.\\nNo validation will be performed by RINF application regarding which is the start and which the end OP. This requires IM's verification. "@en .

onto:openingHoursLimitation a owl:DatatypeProperty ;
