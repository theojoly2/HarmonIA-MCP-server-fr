onto:trackSystemSeparationInfo a owl:ObjectProperty ;
    rdfs:label "Information on system separation"@en ;
    onto:XMLName "EOS_InfoSystem" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Mandatory if there is an indication of existence of system separation (parameter 1.1.1.2.4.2.1)"@en ;
    onto:formatNote "In RDF, the range is an instance of the era:SystemSeparationInfo class with all its properties.\\n\\nFor RINF XML data sets:\\nAs long as the data provision through XML data sets is allowed, the data format is a character string with the following structure: length [NNN] + switch off breaker [Y/N] + lower pantograph [Y/N] + km [NNN.NNN] " ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.2.4.2.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrackSystemSeparationInfo>,
        <http://data.europa.eu/949/shapes/TrackSystemSeparationInfoApplicability> ;
    dcterms:created "2023-04-05"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-06-09"^^xsd:date ;
    dcterms:replaces onto:systemSeparationInfo ;
    rdfs:comment "Indication of required several information on system separation"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:SystemSeparationInfo ;
    rdfs:seeAlso "ENE TSI: 4.2.16" ;
    rdfs:subPropertyOf onto:oclSeparationSectionsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Length - the length of the system separation in meters\\nSwitch off breaker - single selection of  Y=yes  or  N=no  to show whether the breaker has to be switched off\\nLower pantograph - single selection of  Y=yes  or  N=no  to show whether the pantograph has to be lowered\\nKm - the location from the start of the line where the new value is valid "@en .

onto:trainDetectionSystemSpecificCheckDocument a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Document with the procedure(s) related to the type of train detection systems declared in \"Type of track circuits or axle counters to which specific checks are needed\""@en ;
    onto:XMLName "CTD_TCCheckDocRef" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "It is applicable only when parameter \"Type of train detection system\" is applicable"@en ;
    onto:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.3.7.1.3",
        "1.2.1.1.6.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrainDetectionSystemSpecificCheckDocument>,
        <http://data.europa.eu/949/shapes/TrainDetectionSystemSpecificCheckDocumentApplicability> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-04-23"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:relation onto:trainDetectionSystemType ;
    rdfs:comment "Electronic document from the IM stored by the Agency with precise values in accordance with TSI CCS Article13 and the specification referenced in Appendix A-1, index [D], for the specific check to be performed for train detection systems identified in parameter \"Type of track circuits or axle counters to which specific checks are needed\"."@en ;
    rdfs:domain onto:TrainDetectionSystem ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:otherTrainDetectionSystemsObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote "The value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link."@en .

