onto:maxCurrentStandstillPantograph a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum current at standstill per pantograph"@en ;
    onto:XMLName "ECS_MaxStandstillCurrent" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "This parameter is applicable only the type of contact line system is 'Overhead contact line (OCL)'\\nIn sidings, it may be not applicable, in the following cases:\\n- siding is not electrified\\n- Siding is destined to freight traffic, whose trains have a low consumption in stationary (the maximum demand of energy is due to air conditioning systems, which is not significant in these trains).\\n- Siding is used in access to depots or workshops."@en ;
    onto:eratvIndex "4.10.4" ;
    onto:formatNote "NNN" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest for DC systems\\n30 June 2024 for AC systems"@en ;
    onto:rinfIndex "1.1.1.2.2.3",
        "1.2.2.0.6.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaxCurrentStandstillPantograph>,
        <http://data.europa.eu/949/shapes/MaxCurrentStandstillPantographApplicability>,
        <http://data.europa.eu/949/shapes/MaxCurrentStandstillPantographS> ;
    onto:tsiOPEAppendixD2Index "3.3.8" ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/A> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-25"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-05-16"^^xsd:date,
        "2024-09-25"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:contactLineSystemType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Indication of the maximum allowable train current at standstill expressed in amperes."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:ContactLineSystem ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:Siding ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first onto:VehicleType ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "ENE TSI: 4.2.5, LOC&PAS TSI: 4.2.8.2.5" ;
    rdfs:subPropertyOf onto:contactLineSystemDataParameter,
        onto:vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "Parameter related to current taken by the vehicle when it is not in a traction or regenerative mode, e.g. preheating, air-condition, etc.\\nDue to operational reasons, trains can get stuck on SoL for hours, and in some cases, this parameter is even the reason the air-condition is shut down"@en .

