    rdfs:range xsd:double ;
    rdfs:subPropertyOf onto:contactLineSystemDataParameter,
        onto:vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "The value given can be design value or the last known measured value. If there is no change in height, nominal value will be given. \\n\\nValues shall be given in metres with precision of 0.01 m."@en .

