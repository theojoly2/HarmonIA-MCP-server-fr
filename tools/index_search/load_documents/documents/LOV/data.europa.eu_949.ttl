    rdfs:subPropertyOf onto:performanceDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "(TSI INF 4.2.7.1.2(2)) Applicable if the maximum permitted speed of the running track is more than 200km/h and the structures within the section of line are all compatible with the High Speed Load Model (HSLM); information regarding the procedure to be used to perform the dynamic compatibility check shall be provided as well."@en .

onto:hotAxleBoxDetectorDirection a owl:FunctionalProperty,
