onto:compatibilityProcedureDocument a owl:ObjectProperty ;
    rdfs:label "Document with the procedure(s) for static and dynamic route compatibility checks"@en ;
    onto:XMLName "IPP_StructureCheckDocRef" ;
    onto:applicable "Y/N" ;
    onto:legalDeadline "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.1.2.4.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CompatibilityProcedureDocument> ;
