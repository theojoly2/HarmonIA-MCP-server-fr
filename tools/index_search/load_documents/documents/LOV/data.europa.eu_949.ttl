onto:organisationCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "organisation code" ;
    onto:XMLName "OPSidingIMCode",
        "OPSidingTunnelIMCode",
        "OPTrackIMCode",
        "OPTrackPlatformIMCode",
        "OPTrackTunnelIMCode",
        "SOLIMCode",
        "SOLTunnelIMCode" ;
    onto:applicable "Y" ;
    onto:formatNote "AAAA" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.0.0.0.1",
        "1.1.1.1.8.1",
        "1.2.1.0.0.1",
        "1.2.1.0.5.1",
        "1.2.1.0.6.1",
        "1.2.2.0.0.1",
        "1.2.2.0.5.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OrganisationCode> ;
    onto:tsiOPEAppendixD2Index "1.1" ;
    dcterms:created "2024-06-03"^^xsd:date ;
    dcterms:modified "2024-11-06"^^xsd:date,
        "2024-11-12"^^xsd:date,
        "2025-02-18"^^xsd:date,
        "2025-03-08"^^xsd:date,
        "2025-11-27"^^xsd:date ;
    dcterms:replaces onto:imCode ;
    dcterms:source <http://data.europa.eu/eli/dec_impl/2018/1614>,
        <http://data.europa.eu/eli/dir/2012/34/oj>,
        <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Four alpha-numeric code allocated by ERA to a body. It represents the Infrastructure Manager (IM) code in RINF.\\nInfrastructure manager means any body or firm responsible in particular for establishing, managing and maintaining railway infrastructure, including traffic management and control-command signalling; \\nthe functions of the infrastructure manager on a network or part of a network may be allocated to different bodies or firms. Definition in (Article 3(2))"@en,
        "Infrastructure manager means any body or undertaking that is responsible in particular for establishing and maintaining railway infrastructure or a part thereof."@en ;
    rdfs:domain onto:Body ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/dir/2012/34/oj#d1e885-32-1"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:platformDataParameter,
        onto:sidingDataParameter,
        onto:solGenericDataParameter,
        onto:trackGenericDataParameter,
        onto:tunnelDataParameter,
        dcterms:identifier ;
    skos:altLabel "IM's code"@en ;
    skos:example "Simplified example:\\n:ABCD_IM rdf:type era:OrganisationRole;\\n\\tera:hasOrganisationRole era-skos:InfrastructureManager ;\\n  era:roleOf :ABCD .\\n:ABCD rdf:type era:Organisation ;\\n\\t  era:organisationCode \"ABCD\" ;\\n    era:role :ABCD_IM .\\n\\n:0000_IM rdf:type era:OrganisationRole;\\n\\tera:hasOrganisationRole era-skos:InfrastructureManager.\\n\\tera:roleOf :0000_ORG.\\n:0000_ORG rdf:type era:Body;\\n     era:organisationCode \"0000\".\\n\\n#IM Code parameter - directly attached to a track\\n:track2 rdf:type era:RunningTrack;\\n\\tera:infrastructureManager :0000_IM." ;
    skos:scopeNote "The Code is a unique identifier for the Infrastructure Manager and it shall be verified on national level. \\n- If the IM is subject to TAF/TAP TSIs, it corresponds to the code used in TAF/TAP TSIs. \\n- In other cases, it corresponds to the \"organisation code\" assigned by the Agency for the specific needs of the RINF.\\nEach Section of Line shall concern only one IM.\\nTo be able to follow the \"only once\" principle, the infrastructure manager code is a property of the organisation having the role of infrastructuer manager. For data provision, a subset of elements with common characteristics should be created with the era:infrastructureManager property having as value the instance of the infrastructure mananger role."@en .

onto:otherCantDeficiencyBasicSSP a owl:ObjectProperty ;
    rdfs:label "Other Cant Deficiency train categories for which the ETCS trackside is configured to provide SSP"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/cant-deficiencies/CantDeficiencies> ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.3.2.14.1",
        "1.2.1.1.1.14.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OtherCantDeficiencyBasicSSP>,
        <http://data.europa.eu/949/shapes/OtherCantDeficiencyBasicSSPApplicability>,
        <http://data.europa.eu/949/shapes/OtherCantDeficiencyBasicSSPSKOS> ;
    onto:tsiOPEAppendixD3Index "1.3" ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:cantDeficiencyBasicSSP,
        onto:etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Essential information for drivers of trains with a worse (lower) tolerated cant deficiency than those for which the ETCS trackside provides SSP (Static Speed Profiles) in conjunction with parameter \"Cant Deficiency used for the basic SSP\".\\nAccording to the specification referenced in Appendix A-1, index [C]"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "unstable" ;
    skos:scopeNote "The values indicated in millimetres correspond to tracks with UIC gauge. For tracks with a gauge different from UIC, the values provided here are the equivalent ones for UIC gauge, as the actual physical cant deficiency values differ. Please refer to parameter 1.1.1.1.4.2 for more details.\\n\\nSubset-026 (3.11.3.2.1.1) definition: b) The \"other specific\" SSP categories: it groups all other specific SSP categories corresponding to the other international train categories."@en .

