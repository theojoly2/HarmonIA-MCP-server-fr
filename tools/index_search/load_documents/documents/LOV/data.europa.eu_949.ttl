onto:maximumAltitude a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum altitude"@en ;
    onto:XMLName "IPP_MaxAltitude" ;
    onto:applicable "Y/N" ;
    onto:formatNote "[+/-][NNNN]" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
