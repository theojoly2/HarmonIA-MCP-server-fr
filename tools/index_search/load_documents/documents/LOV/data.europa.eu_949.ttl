onto:cantDeficiencyBasicSSP a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Cant Deficiency used for the basic SSP"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/cant-deficiencies/CantDeficiencies> ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.3.2.14",
        "1.2.1.1.1.14" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CantDeficiencyBasicSSP>,
        <http://data.europa.eu/949/shapes/CantDeficiencyBasicSSPApplicability>,
        <http://data.europa.eu/949/shapes/CantDeficiencyBasicSSPSKOS> ;
    onto:tsiOPEAppendixD3Index "1.3" ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:etcsLevelType,
        onto:otherCantDeficiencyBasicSSP ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Essential information for railway undertakings with a worse (lower) tolerated cant deficiency than those for which the ETCS trackside provides SSP (Static Speed Profiles) in conjunction with parameter \"Other Cant Deficiency train categories for which the ETCS trackside is configured to provide SSP\"."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:subPropertyOf onto:tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "The values indicated in millimetres correspond to tracks with UIC gauge. For tracks with a gauge different from UIC, the values provided here are the equivalent ones for UIC gauge, as the actual physical cant deficiency values differ. Please refer to parameter 1.1.1.1.4.2 for more details.\\n                           Subset-026 (3.11.3.2.1.1) definition:\\na) The \"Cant Deficiency\" SSP categories: the cant deficiency value assigned to one category shall define the maximum speed, determined by suspension design, at which a particular train can traverse a curve and thus can be used to set a specific speed limit in a curve with regards to this category."@en .

