onto:LinearElementSection a owl:Class ;
    rdfs:label "Linear Element Section"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LinearElementSectionShape> ;
    rdfs:comment "Represents a section of a linear element."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:LinearElement ;
    skos:scopeNote "A linear element section is a finer granularity of a linear element, representing a specific portion of it. This concept is introduced to address the cases when a linear element needs to be split such as a part of it is used by a net referencing (more in the paragraph describing the positioning on the network). By using start and end offsets measured from origin of the element in ascending order, sections eliminate the need for intrinsic coordinates and instead rely on distances along the linear element."@en .

onto:LinearPositioningSystemCoordinate a owl:Class ;
    rdfs:label "Linear Positioning System Coordinate"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LinearPositioningSystemCoordinateShape> ;
    dcterms:created "2024-11-29"^^xsd:date ;
    rdfs:comment "Represents coordinates in a linear positioning system."@en ;
    rdfs:isDefinedBy onto: .

onto:LinesideDistanceIndication a owl:Class ;
    rdfs:label "Lineside indications of distance"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LinesideDistanceIndicationShape> ;
    dcterms:created "2024-12-12"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date ;
    rdfs:comment "Frequency, appearance and positioning of a sign indicating distance as reference post. Two types of signs are normally available: kilometre post and hectometre post.\\n- A kilometre post is a lineside sign indicating the distance from a specific point, usually being the starting point of the railway line.\\n- A hectometre post is a lineside sign indicating a relative distance."@en ;
    rdfs:isDefinedBy onto: .

onto:LoadCapability a owl:Class ;
    rdfs:label "Load capability"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LoadCapabilityShape> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-09-19"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    dcterms:replaces onto:loadCapability ;
    rdfs:comment "A combination of the line category and speed at the weakest point of the track. \\nEach track can have several load capability (structured) values, and each one has values for load model line category and load model speed."@en,
        "This class together with properties loadCapabilityLineCategory and loadCapabilitySpeed replaces the previous loadCapability SKOS property."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" ;
    skos:scopeNote "At this step, RINF does not allow to enter additional data referred to additional speed regulations and operating requirements relating to locomotives (e.g., locomotive classes and associated maximum speed) or traffic types (e.g., maximum speed of freight traffic or passenger traffic).\\n\\nThe load capability describes the weakest point of this track within this section of line (which is normally a bridge or other sub-track structure). It is expressed as a combination of the line category and speed permitted for trains exerting loads defined for this line category. The result of the classification process is set out in EN 15528:2021 (Annex A) and referred to in that standard as “Line Category”. \\n\\nIt represents the ability of the infrastructure to withstand the vertical loads imposed by vehicles on the track for regular service as a combination of Line Category with a permitted speed according to EN 15528:2021\\n\\nMore than one combination may be published for the same track if applicable, but it has to be done by repetition of the parameter with one value selected only - that is why 'Y' is given in line 'Can be repeated'.\\n\\nFor the following cases, it is not possible to use EN 15528:20021categories of line classification:\\n- TSI categories of line P1520 and F1520 (passenger traffic or freight traffic at any speed)\\n- TSI categories of line P1600 and F1600 (passenger traffic or freight traffic at any speed)"@en .

onto:MaximumMagneticField a owl:Class ;
    rdfs:label "Maximum magnetic field"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumMagneticFieldShape> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:relation onto:trainDetectionSystemType ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:MaximumSpeedAndCantDeficiency a owl:Class ;
    rdfs:label "Maximum speed and cant deficiency"@en ;
    dcterms:created "2023-04-05"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date ;
    dcterms:replaces onto:maximumSpeedAndCantDeficiency ;
    rdfs:comment "Combination of maximum speed and maximum cant deficiency for which the vehicle was assessed."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:MinVehicleImpedance a owl:Class ;
    rdfs:label "Minimum Vehicle Impedance"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinVehicleImpedanceShape> ;
    dcterms:created "2024-05-30"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Impedance as defined in the TSI CCS (Annex I, Appendix A, Table A.2 -Index 77).\\n\\nMinimum vehicle impedance (between wheels and pantograph) (only for vehicles equipped for 1500V or 3000V DC).\\n\\nPer Voltage:\\n[1500]: [CCCC]+[ZZZZ], with input capacitance [CCCC](Cin) and input impedance [ZZZZ](Zin)\\n[3000]: [CCCC]+[ZZZZ], idem."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index077_-_ERA_ERTMS_033281_v5.pdf"^^xsd:anyURI ;
    ns1:term_status "stable" ;
    skos:scopeNote "The MinVehicleImpedance class is applicable for track circuits."@en .

onto:NetBasicReference a owl:Class ;
    rdfs:label "Net Basic Reference"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetBasicReferenceShape> ;
    dcterms:created "2024-11-29"^^xsd:date ;
    rdfs:comment "Basic positioning reference within the ERA ontology. It represents different types of geographical locations. Geographical coordinates are provided according to the standard World Geodetic System (WGS84)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso "https://wiki.railtopomodel.org/wiki/Object_positioning_in_the_network"^^xsd:anyURI ;
    rdfs:subClassOf onto:Feature ;
    skos:scopeNote ""@en .

onto:Orientation a owl:Class ;
    rdfs:label "Orientation"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OrientationShape> ;
    rdfs:comment "Represents the orientation of a railway object in relation to a carrier linear element. It can be described by direction, orientation and side."@en ;
    rdfs:isDefinedBy onto: .

onto:ParameterApplicability a owl:Class ;
    rdfs:label "Parameter applicability"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ParameterApplicabilityShape> ;
    dcterms:modified "2024-10-28"^^xsd:date ;
    rdfs:comment "Applicability interval defines the date interval in which a characteristic of an infrastructure element is applicable. This interval can be applied for any of the technical characteristics or general information of infrastructure elements. This helps identifying planned changes applied to technical parameters over time."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:TemporalFeature .

onto:RaisedPantographsDistanceAndSpeed a owl:Class ;
    rdfs:label "Requirements for number of raised pantographs and spacing between them, at the given speed"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RaisedPantographsDistanceAndSpeedShape> ;
    dcterms:created "2023-04-05"^^xsd:date ;
    rdfs:comment "Indication of maximum number of raised pantographs per train allowed and minimum spacing centre line to centre line of adjacent pantograph heads, expressed in metres, at the given speed.\\nEach track can have several raised pantographs per train allowed (structured) values, and each one has values for number of pantographs, minimum distance between pantographs, in metres, and speed considered in km/h."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" ;
    skos:scopeNote "This class gives the information about the number of pantographs and the distance between them at a given speed for which the Overhead Contact Line (OCL) has been designed.\\nAs for different speeds different combinations of number of pantographs and distance between them may exist, so this class can be repeated to present all of them."@en .

onto:ReferenceBorderPoint a owl:Class ;
    rdfs:label "Reference border point"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ReferenceBorderPointShape> ;
    dcterms:created "2024-10-24"^^xsd:date ;
    dcterms:modifed "2025-02-24"^^xsd:date ;
    dcterms:replaces onto:borderPointOf,
        onto:opInfoPerCountry ;
    rdfs:comment "List of reference border points that are specified in the RINF Application Guide."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Feature .

onto:TENTCorridor a owl:Class ;
    rdfs:label "TEN-T Corridor"@en ;
    dcterms:created "2025-11-17"^^xsd:date ;
    rdfs:comment "Represents the TEN-T network classification of an element, including its network level, type of traffic, and associated European transport corridors."@en ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" .

onto:energySubsystemObjParameter a owl:ObjectProperty ;
    rdfs:label "Energy subsystem"@en ;
    onto:rinfIndex "1.1.1.2" ;
    dcterms:created "2024-10-31"^^xsd:date ;
