onto:automaticDroppingDeviceRequired a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Automatic dropping device required"@en ;
    onto:XMLName "ERS_AutoDropRequired" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "A value is mandatory if the value  Overhead contact line (OCL)  is selected for parameter \"Type of contact line system\""@en ;
    onto:formatNote "Y/N" ;
