onto:minVehicleImpedance a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Vehicle impedance"@en ;
    onto:XMLName "CCD_VehicleImpedance" ;
    onto:applicable "Y/N/NYA" ;
