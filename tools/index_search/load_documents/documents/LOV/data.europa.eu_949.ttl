    onto:rinfIndex "1.1.1.1.6.3",
        "1.2.1.0.4.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MagneticBraking>,
        <http://data.europa.eu/949/shapes/MagneticBrakingSKOS> ;
    onto:tsiOPEAppendixD2Index "3.4.6" ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2022-09-12"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28>,
        <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Indication of limitations on the use of magnetic brakes."@en ;
