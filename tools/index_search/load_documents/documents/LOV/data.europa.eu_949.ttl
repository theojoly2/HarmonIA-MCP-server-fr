ns2:license a owl:AnnotationProperty .

onto:XMLName a owl:AnnotationProperty ;
    rdfs:label "XML name"@en ;
    dcterms:created "2023-05-26"^^xsd:date ;
    dcterms:modified "2024-08-13"^^xsd:date ;
    rdfs:comment "Corresponding XML name as indicated in the RINF application guide"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://www.era.europa.eu/sites/default/files/registers/docs/rinf_application_guide_for_register_en.pdf"^^xsd:anyURI .

onto:accelerationLevelCrossing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Acceleration allowed near level crossing"@en ;
    onto:XMLName "IHS_AccelerationLevelCrossing" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Mandatory value when the level crossing is defined"@en ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.7.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AccelerationLevelCrossing>,
        <http://data.europa.eu/949/shapes/AccelerationLevelCrossingApplicability> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    rdfs:comment "Existence of limit for acceleration of train if stopping or recovering speed close to a level crossing expressed in a specific reference acceleration curve."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:Track ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:subPropertyOf onto:healthSafetyAndEnvironmentObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "The value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link."@en .

onto:additionalBrakingInformationDocument a owl:ObjectProperty ;
    rdfs:label "Documents available by the IM relating to braking performance"@en ;
    onto:XMLName "CBP_BrakePerfDocRef" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Only applicable when for parameter 1.1.1.3.11.2 True is selected"@en ;
    onto:legalDeadline "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.3.11.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocument>,
        <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocumentApplicability> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-23"^^xsd:date ;
    rdfs:comment "Electronic document available in two EU languages from the IM stored by the Agency providing additional information as defined in point (2) of point 4.2.2.6.2 of TSI OPE."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:subPropertyOf onto:brakeRelatedObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote "The value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link."@en .

