onto:frenchTrainDetectionSystemLimitationNumber a owl:ObjectProperty ;
    rdfs:label "Section with train detection limitation number, only for French network"@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/train-detection-numbers/FrenchTrainDetectionSystemLimitationNumbers> ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/FrenchTrainDetectionSystemLimitationNumber>,
        <http://data.europa.eu/949/shapes/FrenchTrainDetectionSystemLimitationNumberSKOS> ;
    dcterms:created "2023-04-05"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date,
        "2025-02-18"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:relation onto:frenchTrainDetectionSystemLimitationApplicable,
        onto:tdsFrenchTrainDetectionSystemLimitation ;
    dcterms:replaces onto:frenchTrainDetectionSystemLimitation ;
    rdfs:comment "Part of the section with train detection limitation that indicates the type of train detection limitation.\\n\\nSpecific for route compatibility check on French network.\\n\\nSections with:\\n[1] Tonnage circulated per track is inferior to 15000 tons/day/track\\n[2] Directional Interlocking\\n[3] 45-second delay for directional interlocking\\n[4] Installation with track circuit announcement\\n[5] Absence of a shunting assistance pedal in the normal direction of circulation for non-reversible double track lines\\n[6] Absence of a shunting assistance pedal regardless of the direction of traffic for single track lines and tracks for two way working\\n[7] Absence of a pedal announcement mechanism\\n[8] 45-second delay for specific announcement reset devices"@en ;
    rdfs:domain onto:FrenchTrainDetectionSystemLimitation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    ns1:term_status "stable" .

