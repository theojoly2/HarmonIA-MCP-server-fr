    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf onto:vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" .

onto:gsmRSetsInDrivingCab a owl:DatatypeProperty ;
    rdfs:label "GSM-R sets in driving cab"@en ;
    onto:eratvIndex "4.13.2.2" ;
    dcterms:created "2021-08-31"^^xsd:date ;
