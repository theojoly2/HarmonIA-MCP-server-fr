    rdfs:subPropertyOf onto:trackResistanceToAppliedLoadsObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "This property has been modified to be a RINF parameter (its eratvIndex is deleted). It is treated as a SKOS by RINF and as a boolean by ERATV. A new ERATV datatype property has been defined, magneticBrakingFitted with boolean values."@en .

onto:magneticBrakingConditionsDocument a owl:ObjectProperty ;
    rdfs:label "Document with the conditions for the use of magnetic brakes"@en ;
    onto:XMLName "ILR_MBDocRef" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Mandatory value to be provided when 1.1.1.1.6.3 / Use of magnetic brakes is 'allowed under conditions' or 'allowed under conditions only for emergency brake'."@en ;
    onto:legalDeadline "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.1.6.5" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MagneticBrakingConditionsDocument>,
        <http://data.europa.eu/949/shapes/MagneticBrakingConditionsDocumentApplicability> ;
    onto:tsiOPEAppendixD2Index "3.4.6" ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date,
        "2024-04-23"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Electronic document available in two EU languages from the IM stored by the Agency with conditions for the use of magnetic brakes identified in 1.1.1.1.6.3."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:subPropertyOf onto:trackResistanceToAppliedLoadsObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote "If there exist conditions to allow the use of magnetic brakes.\\n\\nThe value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link."@en .

