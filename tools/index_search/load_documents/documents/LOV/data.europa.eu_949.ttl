onto:minimumWheelDiameter a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Minimum wheel diameter for fixed obtuse crossings"@en ;
    onto:XMLName "ISC_MinWheelDiaFixObtuseCrossings" ;
    onto:applicable "Y" ;
    onto:eratvIndex "4.8.2" ;
    onto:formatNote "NNN" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.5.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinimumWheelDiameter> ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-10"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "Maximum unguided length of fixed obtuse crossings is based on a minimum wheel diameter in service expressed in millimetres."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first onto:VehicleType ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "INF TSI:  4.2.5.3" ;
    rdfs:subPropertyOf onto:switchesAndCrossingsDataParameter,
        onto:vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "The minimum TSI value is 330 mm and this shall be used as a default value unless advised otherwise. If the value of the wheel diameter is bigger than 330 mm, it has to be specified.\\nNew lines are assumed to be compliant with the TSI INF. When the line is compliant to TSI the default value of 330 mm has to be presented."@en .

