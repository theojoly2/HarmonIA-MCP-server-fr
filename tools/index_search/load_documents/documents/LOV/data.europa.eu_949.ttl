onto:linesideDistanceIndication a owl:ObjectProperty ;
    rdfs:label "Lineside distance indication"@en ;
    onto:XMLName "SOL_LineDistIndication" ;
    onto:formatNote "[NNNN] frequency in meters\\nAppearance - selectable list\\n[L/R] - the side along the track where the lineside indication is positioned (left or right)"@en ;
    onto:rinfIndex "1.1.1.0.0.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LinesideDistanceIndicationCCS>,
        <http://data.europa.eu/949/shapes/LinesideDistanceIndicationRT> ;
    onto:tsiOPEAppendixD2Index "3.1.3" ;
    dcterms:created "2024-12-12"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "Indication of types of appearance of track lineside distance indications."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:LinesideDistanceIndication ;
    rdfs:subPropertyOf onto:trackGenericObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Frequency, appearance and positioning of a sign indicating distance as reference post. Two types of sign are normally available: kilometer post and hectometer post.\\n- A kilometer post is a lineside sign indicating the distance from a specific point, usually being the strarting point of the railway line.\\n- An hectometer post is a lineside sign indicating a relative distance."@en .

