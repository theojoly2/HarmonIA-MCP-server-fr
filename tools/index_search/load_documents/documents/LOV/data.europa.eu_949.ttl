onto:instructionsSwitchRadioSystems a owl:ObjectProperty ;
    rdfs:label "Special instructions to switch over between different radio systems"@en ;
    onto:XMLName "CTS_SwitchRadioSystemCondition" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "Applicable when at least two different radio systems exist. "@en ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.3.8.2.1",
        "1.2.1.1.7.2.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InstructionsSwitchRadioSystems>,
        <http://data.europa.eu/949/shapes/InstructionsSwitchRadioSystemsApplicability> ;
    onto:tsiOPEAppendixD2Index "3.4.4" ;
    dcterms:created "2022-10-28"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-11-04"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>,
        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Name and/or reference of the document specifying the Special instructions to switch over between different radio systems."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:subPropertyOf onto:transitionsBetweenSystemsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "The details of the conditions to switch radio systems must be published.\\n\\nThe value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link."@en .

onto:isQuietRoute a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Belonging to a quieter route"@en ;
    onto:XMLName "IHS_QuietRoute" ;
    onto:applicable "Y" ;
    onto:formatNote "in XML: Y/N" ;
    onto:legalDeadline "1 January 2021"@en ;
    onto:rinfIndex "1.1.1.1.7.11" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/IsQuietRoute> ;
    dcterms:created "2020-11-04"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment "Belonging to a 'quieter route' in accordance with Article 5b of TSI NOI."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "Art 5b of Regulation (EU) 1304/2014 (amended by Regulation (EU) 2019/774) of 16 May 2019" ;
    rdfs:subPropertyOf onto:healthSafetyAndEnvironmentDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Art 5B: A quieter route means a part of the railway infrastructure with a minimum length of 20 km on which the average number of daily operated freight trains during the night-time as defined in national legislation transposing Directive 2002/49/EC of the European Parliament and of the Council (5) was higher than 12. The freight traffic in the years 2015, 2016 and 2017 shall be the basis for the calculation of that average number. In case the freight traffic due to exceptional circumstances diverges in a given year from that average number by more than 25 %, the Member State concerned can calculate the average number on the basis of the remaining two years.\\nArt 5.C 1:   Member States shall designate quieter routes in accordance with Article 5b and the procedure set out in Appendix D.1 of the Annex. They shall provide the European Union Agency for Railways ( the Agency ) with a list of quieter routes six months after the date of publication of this Regulation at the latest. The Agency shall publish those lists on its website."@en .

onto:kilometer a owl:DatatypeProperty ;
    rdfs:label "kilometer number"@en ;
    onto:XMLName "OPRailwayLocation" ;
    onto:applicable "Y/N" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.2.0.0.0.6" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/Kilometer> ;
    onto:tsiOPEAppendixD2Index "2.2.2" ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/KiloM> ;
    dcterms:created "2021-01-29"^^xsd:date ;
    dcterms:modified "2021-01-29"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-10-24"^^xsd:date,
        "2025-01-30"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Kilometer number of the kilometric post related to line identification defining the location of an infrastructure element."@en ;
