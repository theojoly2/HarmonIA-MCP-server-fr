            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ETCS ;
    ns1:term_status "stable" ;
    skos:scopeNote "It can be repeated as many times as the number of different ETCS levels are present.\\n\\nFor RDF data provision:\\nThe value of this property is an instance of the era:ETCS, which has as properties the parameters 1.1.1.3.2.1 and 1.1.1.3.2.2.\\n\\nFor RINF XML data sets:\\nAs long as the data provision through XML data sets is allowed, this property is the equivalent of the \"Set\" attribute, grouping parameters 1.1.1.3.2.1 and 1.1.1.3.2.2."@en .

