onto:uopid a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Unique OP ID"@en ;
    onto:XMLName "UniqueOPID" ;
    onto:applicable "Y" ;
    onto:formatNote "CCAAAAAAAAAA\\nThe first part  CC  is the country code in two-letter system of ISO.  \\nThe second part is alphanumeric OP code within the MS. \\nFor example, an OP code could be current abbreviation of name used in route books.\\nIn case of borders point, the code is to be selected in the corresponding list in annex 5.1" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.2.0.0.0.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/BorderPointUopidPrefix>,
        <http://data.europa.eu/949/shapes/BorderPointValidCodeAndCoordinates>,
        <http://data.europa.eu/949/shapes/UopidP> ;
    onto:tsiOPEAppendixD2Index "2.2.2" ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-24"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Code composed of country code and alphanumeric operational point code."@en ;
    rdfs:domain onto:OperationalPoint ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "ISO 3166-1 alpha 2" ;
    rdfs:subPropertyOf onto:opGenericDataParameter,
        dcterms:identifier ;
    ns1:term_status "stable" ;
    skos:scopeNote "Explanation on data presentation: The first two characters represent the country code in two-letter system of ISO. \\nThe second part  AAAAAAAAAA  is maximum 10 Characters String corresponding to OP code within the MS. \\n'LUAB4' or 'LUAB46TH-G' or 'LUAB4/-_ERT7' are accepted by the validation process.\\nIn case of  borders point , the code is to be selected in the corresponding list in annex 5.1 (this first part  AA  is EU. The second part is  AAAAAAAAAA ). Any OP ID that is not referenced in the annex 5.1 will not be accepted by the validation process.\\nIn case of  domestic borders point , the code will be selected in the corresponding list in annex 5.2 that will be developed later.\\nAny OP ID that is not referenced in the annex 5.1 will not be accepted by the validation process.\\nThe provided OP ID must be unique within each Member State. The validation has to be made nationally by NRE. The exceptions are  Border point  and  domestic border point  that must be referenced in annex 5.1."@en .

onto:usedInRCCCalculations a owl:AnnotationProperty ;
