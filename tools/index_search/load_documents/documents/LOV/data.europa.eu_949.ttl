            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "INF TSI: 4.2.6.2.2 (2)\\nOPE TSI: 4.2.2.6.2 (1) (iv)" ;
    rdfs:subPropertyOf onto:trackObjParameter,
        onto:trackResistanceToAppliedLoadsObjParameter ;
    ns1:term_status "stable" ;
    skos:editorialNote "This property has been modified to be a RINF parameter (its eratvIndex is deleted). It is treated as a SKOS by RINF and as a boolean by ERATV. A new ERATV datatype property has been defined, eddyCurrentBrakingFitted with boolean values."@en ;
    skos:scopeNote "The use of both brakes is allowed or not under exterior conditions (depending on the features of the train engines for example).\\nThe RINF can't be filled without more precisions."@en .

onto:eddyCurrentBrakingConditionsDocument a owl:ObjectProperty ;
    rdfs:label "Document with the conditions for the use of eddy current brakes"@en ;
