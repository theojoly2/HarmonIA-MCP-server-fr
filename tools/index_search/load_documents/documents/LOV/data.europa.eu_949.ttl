onto:tdsFrenchTrainDetectionSystemLimitation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Section with train detection limitation"@en ;
    onto:XMLName "CTD_TCLimitation" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "Only applicable on running tracks in France"@en ;
    onto:formatNote "The value of this parameter is an instance of the era:FrenchTrainDetectionSystemLimitation class with all its properties:\\n - true/false for the existence of a section with train detection limitation\\n - list of values from 1 to 8 defined in the taxonomy" ;
    onto:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "16 January 2020"@en ;
    onto:rinfIndex "1.1.1.3.7.1.4",
        "1.2.1.1.6.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TdsFrenchTrainDetectionSystemLimitation> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2023-04-05"^^xsd:date ;
    dcterms:modified "2025-02-18"^^xsd:date,
        "2025-03-04"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:relation onto:frenchTrainDetectionSystemLimitationApplicable,
        onto:frenchTrainDetectionSystemLimitationNumber ;
    dcterms:replaces onto:frenchTrainDetectionSystemLimitation ;
    rdfs:comment "Specific for route compatibility check on French network."@en ;
    rdfs:domain onto:TrainDetectionSystem ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:FrenchTrainDetectionSystemLimitation ;
    rdfs:subPropertyOf onto:otherTrainDetectionSystemsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Relates the class train detection system with the class that represents the section with train detection limitation. Select the special condition as applicable through National Rule from the List.\\n\\nFor RINF XML data sets:\\nAs long as the data provision through XML data sets is allowed, the data format is a character string with the following structure: \\n[Y/N]+[N]\\nwhere:\\n- [Y/N] - is the existence of section with train detection limitation\\n- [N] is a number from 1 to 8 referring to sections with:\\n    [1] Tonnage circulated per track is inferior to 15000 tons/day/track\\n    [2] Directional Interlocking\\n    [3] 45-second delay for directional interlocking\\n    [4] Installation with track circuit announcement\\n    [5] Absence of a shunting assistance pedal in the normal direction of circulation for non-reversible double track lines\\n    [6] Absence of a shunting assistance pedal regardless of the direction of traffic for single track lines and tracks for two way working\\n    [7] Absence of a pedal announcement mechanism\\n    [8] 45-second delay for specific announcement reset devices."@en .

