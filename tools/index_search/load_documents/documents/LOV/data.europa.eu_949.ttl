onto:conditionalRegenerativeBrake a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Permission for regenerative braking"@en ;
    onto:XMLName "ECS_RegenerativeBraking" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable. "@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/regenerative-braking/RegenerativeBraking> ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.2.2.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionalRegenerativeBrake>,
        <http://data.europa.eu/949/shapes/ConditionalRegenerativeBrakeSKOS> ;
    onto:tsiOPEAppendixD2Index "3.3.7" ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2023-01-20"^^xsd:date,
        "2024-09-25"^^xsd:date,
        "2024-12-10"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:contactLineSystemType ;
    rdfs:comment "Indication whether regenerative braking is permitted, not permitted, or permitted under specific conditions."@en ;
    rdfs:domain onto:ContactLineSystem ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf onto:trackObjParameter,
        onto:trackResistanceToAppliedLoadsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "When regenerative braking is \"allowed under conditions\", a document must be provided under 1.1.1.2.2.4.1.\\n\\nFor RINF XML data sets:\\nAs long as the data provision through XML data sets is allowed, an XML attribute called “Set” will be used to link the value of this parameter to the parameter 1.1.1.2.2.1.1 / ECS_SystemType"@en .

onto:conditionsAppliedRegenerativeBraking a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Conditions applying in regards to regenerative braking"@en ;
    onto:XMLName "ECS_ConditionRegBraking" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable. Mandatory when parameter 1.1.1.2.2.4 announces Conditions."@en ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.2.2.4.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsAppliedRegenerativeBraking>,
        <http://data.europa.eu/949/shapes/ConditionsAppliedRegenerativeBrakingApplicability> ;
    onto:tsiOPEAppendixD2Index "3.3.7" ;
    dcterms:created "2022-11-10"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-11-04"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:contactLineSystemType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>,
        <http://data.europa.eu/eli/reg_impl/2019/777/2023-09-28> ;
    rdfs:comment "Name and/or reference of the document specifying the conditions applying in regards to regenerative braking."@en ;
    rdfs:domain onto:ContactLineSystem ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:subPropertyOf onto:contactLineSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "The value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link."@en .

onto:conditionsChargingElectricEnergyStorage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Permitted conditions for charging electric energy storage for traction purposes at standstill"@en ;
    onto:applicable "Y/N" ;
    onto:legalDeadline "Contrary to the Regulation, the deadline is not 30 June 2024 at the latest, but 12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.2.1.0.7.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsChargingElectricEnergyStorage> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    rdfs:comment "Conditions set by IMs according to a standardised document"@en ;
    rdfs:domain onto:ContactLineSystem ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf onto:contactLineSystemDataParameter ;
    ns1:term_status "stable" .

onto:conditionsSwitchClassBSystems a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Special technical conditions required to switch over between ERTMS/ETCS and Class B systems"@en ;
    onto:XMLName "CTS_SwitchERTMSClassBCondition" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "Applicable when at least two different class of protection systems exist."@en ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.3.8.3",
        "1.2.1.1.7.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsSwitchClassBSystems>,
        <http://data.europa.eu/949/shapes/ConditionsSwitchClassBSystemsApplicability> ;
    onto:tsiOPEAppendixD2Index "3.4.3" ;
    dcterms:created "2022-10-28"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-11-04"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:ETCS,
        onto:switchProtectControlWarning ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>,
        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Name and/or reference of the document specifying the Special technical conditions required to switch over between ERTMS/ETCS and Class B systems."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Document ;
    rdfs:subPropertyOf onto:transitionsBetweenSystemsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "The details of the conditions to switch between Class B train protection systems must be published.\\n\\nThe value of this parameter should be either a reference to a file name or an external link to a document. \\nIf a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the \"Reference Documents Management\" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. \\nIf an external link is provided, the IM must ensure that the document is available at the provided link."@en .

onto:conditionsTrainFormation a owl:DatatypeProperty ;
    rdfs:label "Conditions train formation"@en ;
    onto:eratvIndex "4.1.4" ;
    dcterms:created "2021-08-25"^^xsd:date ;
    dcterms:modified "2021-08-25"^^xsd:date ;
    rdfs:comment "Conditions of use regarding train formation."@en ;
    rdfs:domain onto:VehicleType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf onto:vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" .

onto:conditionsUseReflectivePlates a owl:ObjectProperty ;
    rdfs:label "Conditions for use of reflective plates"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value is mandatory if the value of parameter \"Permit of use of reflective plates\" is boolean \"Yes\""@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/conditions-use-reflective-plates/ConditionsUseReflectivePlates> ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.1.7.12.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsUseReflectivePlates>,
        <http://data.europa.eu/949/shapes/ConditionsUseReflectivePlatesSKOS> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-09-24"^^xsd:date,
        "2026-01-22"^^xsd:date ;
    rdfs:comment "Details of any conditions for using the reflective plates on freight corridors. Specific case for Portugal and Spain until 1.1.2025 and Belgium and France until 1.1.2026."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "4.2.2.1.3.2 of TSI OPE (Commission Implementing Regulation (EU) 2019/773 of 16 May 2019)" ;
    rdfs:subPropertyOf onto:healthSafetyAndEnvironmentObjParameter ;
    owl:deprecated true ;
    ns1:term_status "archaic" ;
    skos:scopeNote "From TSI OPE: Member States shall in particular endeavour to permit the use of reflective plates on rail freight corridors, with a view to prioritise the current bottlenecks. These sections and details of any conditions pertaining to them shall be recorded in the RINF. Until the information is encoded in RINF, the infrastructure manager shall ensure the information is communicated to railway undertakings by other appropriate means. The infrastructure manager shall identify the sections of lines on which 2 steady red lights are required in the RINF. "@en .

onto:connectedTo a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "connected to"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.0.1.2",
        "1.2.4.1" ;
    dcterms:created "2025-03-10"^^xsd:date ;
    rdfs:comment "Represents a bidirectional connection between two Track instances."@en ;
    rdfs:domain onto:Track ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Track ;
    rdfs:seeAlso onto:NetElement,
        onto:NetRelation ;
    rdfs:subPropertyOf onto:trackGenericObjParameter ;
    ns1:term_status "stable" ;
    skos:altLabel "Internal connection"@en,
        "Tracks connectivity to operational points"@en ;
    skos:example "Track_A connectedTo Track_B implies Track_B connectedTo Track_A."@en ;
    skos:scopeNote "This property defines a connection between two tracks. It is symmetric, meaning if a track A is connected to track B, then track B is also connected to track A. A track cannot be connected to itself (irreflexive property).\\nUsed to indicate connectivity between track instances in a network, ensuring that connections are non-self-referential and in the normal running direction of the track.\\n\\nThis is a simplistic representation of the internal connectivity of the tracks in an operational point or the connectivity of the tracks between operational points and sections of line.\\nFor a more detailed representation of connectivity and navigability, this information should be available on the topology of the network."@en .

onto:contactLineSystem a owl:ObjectProperty ;
    rdfs:label "contact line system"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ContactLineSystem> ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment "System that is used to transmit electrical energy to road or rail vehicles."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:ContactLineSystem ;
    ns1:term_status "stable" ;
    skos:scopeNote "It can be repeated as many times as the number of different contact line system types are present.\\n\\nFor RDF data provision:\\nThe value of this property is an instance of the era:ContactLineSystem, which has as properties the parameters 1.1.1.2.2.1.2, 1.1.1.2.2.2, 1.1.1.2.2.4 and 1.1.1.2.5.1.\\n\\nFor RINF XML data sets:\\nAs long as the data provision through XML data sets is allowed, this property is the equivalent of the \"Set\" attribute, grouping parameters 1.1.1.2.2.1.2, 1.1.1.2.2.2, 1.1.1.2.2.4 and 1.1.1.2.5.1."@en .

onto:contactStripMaterial a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Permitted contact strip material"@en ;
    onto:XMLName "EPA_StripMaterial" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Mandatory only if “Overhead contact line (OCL)” is selected in 1.1.1.2.2.1.1, otherwise the parameter is not applicable."@en ;
    onto:eratvIndex "4.10.10" ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/contact-strip-materials/ContactStripMaterials> ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.2.3.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ContactStripMaterialApplicability>,
        <http://data.europa.eu/949/shapes/ContactStripMaterialSKOS> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-25"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-09-25"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:contactLineSystemType ;
    rdfs:comment "Indication of which contact strip materials are permitted to be used."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first onto:VehicleType ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "LOC&PAS TSI: 4.2.8.2.9.4.2" ;
    rdfs:subPropertyOf onto:pantographObjParameter,
        onto:vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "[NN] for impregnated carbon concern the metallic content in %. In case of selection of this option, the respective value of the metallic content has to be added. [NN] is the maximum percentage allowed. \\n\\nIn case of permitted material different than specified in predefined list, send ERA a change request.\\n\\nWhen more than one value of the parameter has to be published, then parameter will to be repeated as many times as the number of values."@en .

onto:contactStripMaterialMetallicContent a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Contact strip material metallic content"@en ;
    onto:XMLName "EPA_StripMaterial" ;
    onto:dependencyNote "Mandatory only if impregnated carbon ([NN] % of metallic content)” is selected in 1.1.1.2.3.4, otherwise no value should be provided"@en ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.2.3.4" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ContactStripMaterialMetallicContent> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2023-01-25"^^xsd:date ;
    dcterms:modified "2024-09-25"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation onto:contactLineSystemType ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1302/2023-09-28> ;
    rdfs:comment "Indication of max. percentage of contact strip material Impregnated Carbon permitted to be used." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "LOC&PAS TSI: 4.2.8.2.9.4.2" ;
    rdfs:subPropertyOf onto:pantographDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "In case that the value of the property era:contactStripMaterial is \"impregnated carbon\", it is the metallic content in % (this value must be added). This is the maximum percentage allowed."@en .

onto:containerHandlingFlag a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "container handling flag"@en ;
