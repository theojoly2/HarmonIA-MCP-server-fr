        <http://data.europa.eu/949/shapes/AutomaticDroppingDeviceRequiredApplicability> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-25"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date ;
    rdfs:comment "Indication of whether an automatic dropping device (ADD) required on the vehicle."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "LOC&PAS TSI: 4.2.8.2.9.10\\nEN 50206-1:2010" ;
    rdfs:subPropertyOf onto:requirementsRollingStockDataParameter ;
    ns1:term_status "stable" .

