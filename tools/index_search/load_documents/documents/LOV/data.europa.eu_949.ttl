        onto:SpecialArea,
        onto:Switch,
        onto:Track,
        onto:Tunnel ;
    ns1:term_status "stable" .

onto:Switch a owl:Class ;
    rdfs:label "Switch"@en ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SwitchShape> ;
