    onto:rinfIndex "1.1.1.2.3.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrackRaisedPantographDistanceAndSpeedApplicability>,
        <http://data.europa.eu/949/shapes/TrackRaisedPantographsDistanceAndSpeed> ;
