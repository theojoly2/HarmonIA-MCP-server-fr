onto:errorCorrectionsOnboardExplanation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Reasons for Error corrections required, but accepted by the IM for the on-board ETCS, GSM-R and/or ATO function"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    onto:legalDeadline "12 months after the entry into force of TSI CCS and at least 12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.3.1.2",
        "1.2.1.1.1.19" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ErrorCorrectionsOnboardExplanation> ;
    dcterms:created "2024-04-18"^^xsd:date ;
    rdfs:comment "Explanation on why a mandatory onboard CR required to be solved in the on-board (ETCS, GSM-R and/or ATO) was accepted by the IM."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
