            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:PlatformEdge ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf onto:platformDataParameter ;
    ns1:term_status "stable" .

onto:atoCommunicationSystem a owl:ObjectProperty ;
    rdfs:label "ATO communication system"@en ;
    onto:XMLName "CAO_ATOCommSystem" ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "Applicable when 'ATO Grade of Automation' is applicable"@en ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/ato-commsys/ATOCommSystem> ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.3.13.3",
        "1.2.1.1.10.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AtoCommunicationSystem>,
        <http://data.europa.eu/949/shapes/AtoCommunicationSystemSKOS> ;
    onto:tsiOPEAppendixD2Index "3.4.9" ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date,
        "2024-12-05"^^xsd:date ;
    dcterms:relation onto:atoGradeAutomation,
        onto:etcsBaseline ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Supported ATO communication systems from trackside."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf onto:automatedTrainOperationObjParameter ;
    ns1:term_status "unstable" ;
    skos:scopeNote "ATO system communication system to the specification referenced in TSI CCS (4.2.4 & 4.2.19).\\n                           Parameter only applicable when ETCS Baseline > 4 MR1 and ATO is implemented"@en .

onto:atoErrorCorrectionsOnboard a owl:DatatypeProperty ;
    rdfs:label "(Deprecated) ATO error corrections required for the on-board. Use: errorCorrectionsOnboard"@en ;
