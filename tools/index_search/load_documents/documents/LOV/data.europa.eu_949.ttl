    rdfs:label "Signal orientation"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/orientations/OrientationDirections> ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.3.14.3",
        "1.2.1.0.8.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SignalOrientation>,
        <http://data.europa.eu/949/shapes/SignalOrientationSKOS> ;
    onto:tsiOPEAppendixD2Index "2.2.3",
        "2.3.3" ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2024-04-18"^^xsd:date ;
    dcterms:relation onto:signalId ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Relative position to the line of reference, given in km and indication if the signal refers to normal or opposite track direction"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:Signal ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf onto:signalObjParameter ;
    ns1:term_status "unstable" ;
    skos:example "@prefix era: <http://era.europa.eu/949/> .\\n@prefix era-orient: <http://data.europa.eu/949/concepts/orientations/> .\\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\n\\nera:signal1 a era:Signal ;\\n    #signal's position\\n    era:netReference [\\n        a era:NetPointReference ;\\n        era:hasLrsCoordinate [\\n            a era:LinearPositioningSystemCoordinate ;\\n            era:kmPost era:kp5 ;\\n            era:offsetFromKilometricPost 231;\\n            rdfs:label \"5+231\"@en ;\\n        ]\\n    ];\\n    #signal's orientation (Normal)\\n    era:signalOrientation era-orient:00.\\n\\nera:kp5 a era:KilometricPost ;\\n    era:hasLRS [\\n        a era:LinearPositioningSystem ;\\n        era:lineId \"National line 1\"\\n    ] ;\\n    era:kmPostName \"km 5\" ;\\n    era:measuredDistance 4995 ." ;
    skos:scopeNote "Indication if the signal is applicable for operation on normal, opposite track direction or if it contains bidirectionally valid information (radio-based system only).\\n\\nThe position of the signal is given in relation to a line reference, using the era:netReference property. In general it represents the kilometric point on the main line where the signal is positioned, or a distance from an origin point, when there are no kilometric posts available on the tracks/sidings. See the example."@en .

