onto:length a owl:DatatypeProperty ;
    rdfs:label "Length"@en ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2021-04-01"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-11-04"^^xsd:date ;
    rdfs:comment "Generic super-property for different types of length"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:seeAlso "ERA" ;
    ns1:term_status "stable" ;
    skos:scopeNote "Position of the start of the walkway:  [integer] m (from the same origin point of the kilometer post.)\\nLenght of the walkway: [integer] m"@en,
        "The length can be \\n- a section of line (For operational length, use era:lengthOfSectionOfLine), \\n- a tunnel (For operational length, use era:lengthOfTunnel), \\n- a platform (For its usable length, use era:lengthOfPlatform), \\n- a siding (For its usable length, use era:lengthOfSiding), and \\n- length of other areas such as \\n  - a non-stopping area (accuracy +- 10m), \\n  - a walkway, \\n  - an evacuation and rescue point.\\n- a vehicle length."@en .

