onto:nationalRollingStockFireCategory a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "National fire category of rolling stock required"@en ;
    onto:XMLName "ITU_NatFireCatReq" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Mandatory for tunnels without value for 1.1.1.8.10 and where national values exist."@en ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.8.11",
        "1.2.1.0.5.8",
        "1.2.2.0.5.8" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NationalRollingStockFireCategory>,
        <http://data.europa.eu/949/shapes/NationalRollingStockFireCategoryApplicability> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
    rdfs:comment "Categorisation of how a passenger train with a fire on board will continue to operate for a defined time period - according to national rules if they exist."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:Tunnel ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "SRT TSI: 4.2.3.3.4\\n                                     LOC&PAS TSI : 4.2.10.4.4" ;
    rdfs:subPropertyOf onto:tunnelDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Data shall include both the category and brief name of the document introducing the categorisation.\\nA value is mandatory only for tunnels when the value of the parameter 1.1.1.1.8.10 is  none  and national rules exist.\\nIt may be not applicable when respective national rules do not exist"@en .

onto:nationalValuesBrakeModel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "National Values used for the brake model"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
