    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PlatformHeightP>,
        <http://data.europa.eu/949/shapes/PlatformHeightSKOS> ;
    onto:tsiOPEAppendixD2Index "2.3.7" ;
