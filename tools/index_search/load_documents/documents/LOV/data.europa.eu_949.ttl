onto:permitUseReflectivePlates a owl:DatatypeProperty ;
    rdfs:label "Permit of use of reflective plates"@en ;
    onto:applicable "Y/N/NYA" ;
    onto:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    onto:rinfIndex "1.1.1.1.7.12" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PermitUseReflectivePlates> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    dcterms:modified "2025-09-22"^^xsd:date,
        "2026-01-22"^^xsd:date ;
    rdfs:comment "Sections where is permitted to use the reflective plates on rail freight corridors, with a view to prioritise the current bottlenecks. Specific case for Belgium, France, Italy, Portugal and Spain until 1.1.2026"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "4.2.2.1.3.2 of TSI OPE (Commission Implementing Regulation (EU) 2019/773 of 16 May 2019)" ;
    rdfs:subPropertyOf onto:healthSafetyAndEnvironmentDataParameter ;
    owl:deprecated true ;
    ns1:term_status "archaic" ;
    skos:scopeNote "From TSI OPE: Member States shall in particular endeavour to permit the use of reflective plates on rail freight corridors, with a view to prioritise the current bottlenecks. These sections and details of any conditions pertaining to them shall be recorded in the RINF. Until the information is encoded in RINF, the infrastructure manager shall ensure the information is communicated to railway undertakings by other appropriate means. The infrastructure manager shall identify the sections of lines on which 2 steady red lights are required in the RINF. "@en .

onto:permittedContactForce a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Contact force permitted"@en ;
    onto:XMLName "ERS_ContactForce" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "A value is mandatory if the value  Overhead contact line (OCL)  is selected for parameter \"Type of contact line system\""@en ;
    onto:formatNote "The force is either given as: a value of the static force and of the maximum force expressed in newtons, or as a formula for function of the speed" ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.2.5.2" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PermittedContactForce>,
        <http://data.europa.eu/949/shapes/PermittedContactForceApplicability> ;
    onto:unitOfMeasure <http://qudt.org/vocab/unit/N> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-25"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date ;
    rdfs:comment "Indication of contact force allowed expressed in newton."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest () ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "LOC&PAS TSI: 4.2.8.2.9.6\\nENE TSI: 4.2.11\\nEN 50367:2020+A1:2022 Table 6" ;
    rdfs:subPropertyOf onto:requirementsRollingStockDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "The formula of the function shall represent the curve describing the value of the contact force in relation to the speed.\\nStatic and maximum forces are given only for the maximum permitted line speed (see parameter number 1.1.1.1.2.5)."@en .

