    onto:inSkosConceptScheme <http://data.europa.eu/949/concepts/rail-inclinations/RailInclinations> ;
    onto:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    onto:rinfIndex "1.1.1.1.4.3" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RailInclination>,
        <http://data.europa.eu/949/shapes/RailInclinationSKOS> ;
    onto:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2022-10-20"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "An angle defining the inclination of the head of a rail relative to the running surface."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf [ a rdf:List ;
                    rdf:first onto:CommonCharacteristicsSubset ;
                    rdf:rest [ a rdf:List ;
                            rdf:first onto:RunningTrack ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first onto:VehicleType ;
                                    rdf:rest () ] ] ] ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "INF TSI:4.2.4.7" ;
    rdfs:subPropertyOf onto:trackObjParameter,
        onto:vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote "This inclination is in most cases expressed for MS globally, but anyway it requires presentation for the specific track, when in one SoL more values occur.\\nAn angle defining the inclination of the head of a rail when installed in the track relative to the plane of the rails (running surface), equal to the angle between the axis of symmetry of the rail (or of an equivalent symmetrical rail having the same rail head profile) and the perpendicular to the plane of the rails. The typical values for the railway inclination are 1:20, 1:30, 1:40."@en .

