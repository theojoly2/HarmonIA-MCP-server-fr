onto:complianceInfTsi a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Compliance of the tunnel with TSI INF"@en ;
    onto:XMLName "ITU_TSITunnel" ;
    onto:applicable "Y/N" ;
    onto:dependencyNote "Mandatory if the speed of the line is equal or greater than 200km/h "@en ;
    onto:legalDeadline "1 January 2021"@en ;
    onto:rinfIndex "1.1.1.1.8.8.1" ;
    onto:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ComplianceInfTsiApplicability>,
        <http://data.europa.eu/949/shapes/ComplianceInfTsiP> ;
