@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://purl.org/net/ns/ex#> .
@prefix ns2: <http://purl.org/net/ns/ontology-annot#> .
@prefix onto: <http://www.kanzaki.com/ns/music> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

dcterms:alternative a owl:DatatypeProperty .

dcterms:description a owl:ObjectProperty .

<http://www.kanzaki.com/ns/music#A-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "A dur" ;
    dcterms:alternative "A major" ;
    dcterms:description <http://en.wikipedia.org/wiki/A_major> ;
    rdfs:comment "Major key based on A, whose key signature has 3 sharps." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Alto> a owl:Class ;
    rdfs:label "Alto" ;
    rdfs:comment "An Alto singer" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Singer> .

<http://www.kanzaki.com/ns/music#As-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "As dur" ;
    dcterms:alternative "A-Flat major" ;
    dcterms:description <http://en.wikipedia.org/wiki/A_flat_major> ;
    rdfs:comment "Major key based on A flat, whose key signature has 4 flats." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#B-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "B dur" ;
    dcterms:alternative "B-Flat major" ;
    dcterms:description <http://en.wikipedia.org/wiki/B_flat_major> ;
    rdfs:comment "Major key based on B flat, whose key signature has 2 flats." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Ballet> a owl:Class ;
    rdfs:label "Ballet (Work)" ;
    rdfs:comment "A musical work for a dance form featuring a staged presentation of group or solo dancing. Note 'Ballet_Event' in this vocabulary describes the performance of a ballet." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Oeuvre> .

<http://www.kanzaki.com/ns/music#BalletCompany> a owl:Class ;
    rdfs:label "Ballet Company" ;
    rdfs:comment "A musical group that performs ballet works." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#MusicalGroup> .

<http://www.kanzaki.com/ns/music#Ballet_Performance> a owl:Class,
        owl:DeprecatedClass ;
    owl:equivalentClass <http://www.kanzaki.com/ns/music#Ballet_Event> .

<http://www.kanzaki.com/ns/music#Baritone> a owl:Class ;
    rdfs:label "Baritone" ;
    rdfs:comment "A Baritone singer" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Singer> .

<http://www.kanzaki.com/ns/music#Bass> a owl:Class ;
    rdfs:label "Bass" ;
    rdfs:comment "A Bass singer" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Singer> .

<http://www.kanzaki.com/ns/music#BassClarinettist> a owl:Class ;
    rdfs:label "Bass_Clarinettist" ;
    rdfs:comment "A Bass Clarinet player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#BassClarinet> ],
        <http://www.kanzaki.com/ns/music#Clarinettist> .

<http://www.kanzaki.com/ns/music#BassetHorn> a owl:Class ;
    rdfs:label "Basset Horn" ;
    rdfs:comment "A larger member of the clarinet family, typically in lower F, and has darker and less brilliant timbre." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Clarinet> .

<http://www.kanzaki.com/ns/music#C-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "C dur" ;
    dcterms:alternative "C major" ;
    dcterms:description <http://en.wikipedia.org/wiki/C_major> ;
    rdfs:comment "Major key based on C, whose key signature has no sharp or flat." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Cantata> a owl:Class ;
    rdfs:label "Cantata" ;
    rdfs:comment "A vocal composition accompanied by instruments and generally containing more than one movement." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Choral_Music> .

<http://www.kanzaki.com/ns/music#CelestaPlayer> a owl:Class ;
    rdfs:label "CelestaPlayer" ;
    rdfs:comment "A Celesta player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Celesta> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#Cellist> a owl:Class ;
    rdfs:label "Cellist" ;
    rdfs:comment "A Cello player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Cello> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#Ces-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "Ces dur" ;
    dcterms:alternative "C-Flat major" ;
    dcterms:description <http://en.wikipedia.org/wiki/C_flat_major> ;
    rdfs:comment "Major key based on C flat, whose key signature has 7 flats." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Choreographer> a owl:Class ;
    rdfs:label "Choreographer" ;
    rdfs:comment "someone who creates new dances, or directs an opera" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Director> .

<http://www.kanzaki.com/ns/music#Chorus> a owl:Class ;
    rdfs:label "Chorus" ;
    rdfs:comment "A musical group of singers." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#MusicalGroup> .

<http://www.kanzaki.com/ns/music#Cis-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "Cis dur" ;
    dcterms:alternative "C-Sharp major" ;
    dcterms:description <http://en.wikipedia.org/wiki/C_sharp_major> ;
    rdfs:comment "Major key based on C sharp, whose key signature has 7 sharps." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Composer> a owl:Class ;
    rdfs:label "Composer" ;
    rdfs:comment "A person (or any agent) who composed art works" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Artist> .

<http://www.kanzaki.com/ns/music#Concert> a owl:Class ;
    rdfs:label "Concert" ;
    rdfs:comment "An event of musical performance by players or singers not involving theatrical staging" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Event> .

<http://www.kanzaki.com/ns/music#Concerto> a owl:Class ;
    rdfs:label "Concerto" ;
    rdfs:comment "A composition for orchestra and a soloist" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Orchestral_Work> .

<http://www.kanzaki.com/ns/music#Conductor> a owl:Class ;
    rdfs:label "Conductor" ;
    rdfs:comment "A Conductor" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Director>,
        <http://www.kanzaki.com/ns/music#Musician> .

<http://www.kanzaki.com/ns/music#Contrabassist> a owl:Class ;
    rdfs:label "Contrabassist" ;
    rdfs:comment "A Contrabass player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Contrabass> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#ContrafagottoPlayer> a owl:Class ;
    rdfs:label "ContrafagottoPlayer" ;
    rdfs:comment "A Contrafagotto player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Contrafagotto> ],
        <http://www.kanzaki.com/ns/music#Bassoonist> .

<http://www.kanzaki.com/ns/music#Countertenor> a owl:Class ;
    rdfs:label "Countertenor" ;
    rdfs:comment "A Countertenor singer" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Singer> .

<http://www.kanzaki.com/ns/music#D-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "D dur" ;
    dcterms:alternative "D major" ;
    dcterms:description <http://en.wikipedia.org/wiki/D_major> ;
    rdfs:comment "Major key based on D, whose key signature has 2 sharps." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Des-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "Des dur" ;
    dcterms:alternative "D-Flat major" ;
    dcterms:description <http://en.wikipedia.org/wiki/D_flat_major> ;
    rdfs:comment "Major key based on D flat, whose key signature has 5 flats." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#E-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "E dur" ;
    dcterms:alternative "E major" ;
    dcterms:description <http://en.wikipedia.org/wiki/E_major> ;
    rdfs:comment "Major key based on E, whose key signature has 4 sharps." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#EnglishHornPlayer> a owl:Class ;
    rdfs:label "English Horn player" ;
    rdfs:comment "An English Horn player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#EnglishHorn> ],
        <http://www.kanzaki.com/ns/music#Oboist> .

<http://www.kanzaki.com/ns/music#Ensemble> a owl:Class ;
    rdfs:label "Ensemble" ;
    rdfs:comment "A musical group which perfroms in relatively small size, particularly chamber music" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#MusicalGroup> .

<http://www.kanzaki.com/ns/music#Es-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "Es dur" ;
    dcterms:alternative "E-Flat major" ;
    dcterms:description <http://en.wikipedia.org/wiki/E_flat_major> ;
    rdfs:comment "Major key based on E flat, whose key signature has 3 flats." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#F-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "F dur" ;
    dcterms:alternative "F major" ;
    dcterms:description <http://en.wikipedia.org/wiki/F_major> ;
    rdfs:comment "Major key based on F, whose key signature has 1 flat." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Fis-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "Fis dur" ;
    dcterms:alternative "F-Sharp major" ;
    dcterms:description <http://en.wikipedia.org/wiki/F_sharp_major> ;
    rdfs:comment "Major key based on F sharp, whose key signature has 6 sharps." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#G-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "G dur" ;
    dcterms:alternative "G major" ;
    dcterms:description <http://en.wikipedia.org/wiki/G_major> ;
    rdfs:comment "Major key based on G, whose key signature has 1 sharp." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Ges-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "Ges dur" ;
    dcterms:alternative "G-Flat major" ;
    dcterms:description <http://en.wikipedia.org/wiki/G_flat_major> ;
    rdfs:comment "Major key based on G flat, whose key signature has 6 flats." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Guitarist> a owl:Class ;
    rdfs:label "Guitarist" ;
    rdfs:comment "A Guitar player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Guitar> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#H-dur> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "H dur" ;
    dcterms:alternative "B major" ;
    dcterms:description <http://en.wikipedia.org/wiki/B_major> ;
    rdfs:comment "Major key based on B, whose key signature has 5 sharps." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Harpist> a owl:Class ;
    rdfs:label "Harpist" ;
    rdfs:comment "A Harp player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Harp> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#Harpsichord> a owl:Class ;
    rdfs:label "Harpsichord" ;
    rdfs:comment "A keyboard instrument whose strings are plucked by means of quills or plectrums. Cembalo." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Keyboard_Instrument> .

<http://www.kanzaki.com/ns/music#Hornist> a owl:Class ;
    rdfs:label "Hornist" ;
    rdfs:comment "A Horn player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Horn> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#Mandolin> a owl:Class ;
    rdfs:label "Mandolin" ;
    rdfs:comment "A pear-shaped small stringed instrument descended from the lute, played with a pick." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#String_Instrument> .

<http://www.kanzaki.com/ns/music#MezzoSoprano> a owl:Class ;
    rdfs:label "Mezzo Soprano" ;
    rdfs:comment "A Mezzo Soprano singer" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Singer> .

<http://www.kanzaki.com/ns/music#Movement> a owl:Class ;
    rdfs:label "Movement" ;
    rdfs:comment "A subsection of a musical work. Typically a movement of a symphony, but also a piece of suit, etc." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Work> .

<http://www.kanzaki.com/ns/music#MusicDirector> a owl:Class ;
    rdfs:label "Music Director" ;
    rdfs:comment "The person who leads a musical group" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Director>,
        <http://www.kanzaki.com/ns/music#Musician> .

<http://www.kanzaki.com/ns/music#Opera> a owl:Class ;
    rdfs:label "Opera (Work)" ;
    rdfs:comment "A musical work with drama, song, chorus and orchestral music. Note 'Opera_Event' in this vocabulary describes the performance of an opera." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Oeuvre> .

<http://www.kanzaki.com/ns/music#OperaCompany> a owl:Class ;
    rdfs:label "Opera Company" ;
    rdfs:comment "A musical group that performs opera works." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#MusicalGroup> .

<http://www.kanzaki.com/ns/music#Opera_Performance> a owl:Class,
        owl:DeprecatedClass ;
    owl:equivalentClass <http://www.kanzaki.com/ns/music#Opera_Event> .

<http://www.kanzaki.com/ns/music#Oratorio> a owl:Class ;
    rdfs:label "Oratorio" ;
    rdfs:comment "A large musical composition for orchestra, vocal soloists and chorus" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Choral_Music> .

<http://www.kanzaki.com/ns/music#Orchestra> a owl:Class ;
    rdfs:label "Orchestra" ;
    rdfs:comment "A musical group which perfroms large scale symphonic works" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#MusicalGroup> .

<http://www.kanzaki.com/ns/music#Overture> a owl:Class ;
    rdfs:label "Overture" ;
    rdfs:comment "An orchestral music composed for the opening of an opera or oratorio, often played as an independend work in concerts" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Orchestral_Work> .

<http://www.kanzaki.com/ns/music#Part> a owl:Class ;
    rdfs:label "Part" ;
    rdfs:comment "A music for a particular instrument or voice taken from a full score (Note: in this ontology, Part is not a division of an orchestra)." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Written_Representation> .

<http://www.kanzaki.com/ns/music#Percussionist> a owl:Class ;
    rdfs:label "Percussionist" ;
    rdfs:comment "A Percussion player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Percussion> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#Pianist> a owl:Class ;
    rdfs:label "Pianist" ;
    rdfs:comment "A Piano player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Piano> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#PiccoloPlayer> a owl:Class ;
    rdfs:label "Piccolo player" ;
    rdfs:comment "A Piccolo flute player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Piccolo> ],
        <http://www.kanzaki.com/ns/music#Flutist> .

<http://www.kanzaki.com/ns/music#Recital> a owl:Class ;
    rdfs:label "Recital" ;
    rdfs:comment "An event of musical performance especially by soloists" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Event> .

<http://www.kanzaki.com/ns/music#Religious_Music> a owl:Class ;
    rdfs:label "Religious Music" ;
    rdfs:comment "A genre of music composed for performance as part of religious ceremonies" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Oeuvre> .

<http://www.kanzaki.com/ns/music#Saxophone> a owl:Class ;
    rdfs:label "Saxophone" ;
    rdfs:comment "A woodwind instrument with a single-reed mouthpiece and a (usually curved) conical metal tube, including soprano, alto, tenor, and baritone sizes." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Woodwind_Instrument> .

<http://www.kanzaki.com/ns/music#Score> a owl:Class ;
    rdfs:label "Score" ;
    rdfs:comment "A full score or piano-vocal score of a work, either published or manuscript." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Written_Representation> .

<http://www.kanzaki.com/ns/music#Sketch> a owl:Class ;
    rdfs:label "Sketch" ;
    rdfs:comment "A sketch, or a brief prelimary composition of a work." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Written_Representation> .

<http://www.kanzaki.com/ns/music#Soprano> a owl:Class ;
    rdfs:label "Soprano" ;
    rdfs:comment "A Soprano singer" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Singer> .

<http://www.kanzaki.com/ns/music#SopranoClarinet> a owl:Class ;
    rdfs:label "Soprano Clarinet" ;
    rdfs:comment "A smaller member of the clarinet family, commonly in key E-flat." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Clarinet> .

<http://www.kanzaki.com/ns/music#StringQuartetEnsemble> a owl:Class ;
    rdfs:label "Qtring Quartet" ;
    rdfs:comment "A musical group of four string players. Note 'String_Quartette' is SQ as musical work in this vocabulary." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#MusicalGroup> .

<http://www.kanzaki.com/ns/music#String_Quartette> a owl:Class,
        owl:DeprecatedClass ;
    owl:equivalentClass <http://www.kanzaki.com/ns/music#String_Quartet> .

<http://www.kanzaki.com/ns/music#Suite> a owl:Class ;
    rdfs:label "Suite" ;
    rdfs:comment "A musical composition of several movements only loosely connected" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Oeuvre> .

<http://www.kanzaki.com/ns/music#Symphonic_Poem> a owl:Class ;
    rdfs:label "Symphonic Poem" ;
    rdfs:comment "An orchestral composition based on a thematic subject" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Orchestral_Work> .

