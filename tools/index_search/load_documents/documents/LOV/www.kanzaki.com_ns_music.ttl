<http://www.kanzaki.com/ns/music#composer> a owl:ObjectProperty ;
    rdfs:label "Composer" ;
    rdfs:comment "The subject musical work is composed by a person, a group, a software program etc." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Oeuvre> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf dc:creator,
        <http://www.kanzaki.com/ns/music#description> .

<http://www.kanzaki.com/ns/music#composition> a owl:ObjectProperty ;
    rdfs:label "Composition" ;
    rdfs:comment "Describes the composition process of the subject. Composition period or completion date, place, revision etc. can be described as properties of the object composition process." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#description> .

<http://www.kanzaki.com/ns/music#conductor> a owl:ObjectProperty ;
    rdfs:label "Conductor" ;
    rdfs:comment "The subject performance is coducted by the object (or the subject musical event has a conductor). See comment of #performer." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#performer> .

<http://www.kanzaki.com/ns/music#conductorName> a owl:DatatypeProperty ;
    rdfs:label "Conductor Name" ;
    rdfs:comment "The subject musical event has a conductor. Literal version of #conductor." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#performerName> .

<http://www.kanzaki.com/ns/music#d-moll> a <http://www.kanzaki.com/ns/music#Key> ;
