<http://www.kanzaki.com/ns/music#Ballet_Event> a owl:Class ;
    rdfs:label "Ballet Event" ;
    rdfs:comment "An event of ballet performance\\n  " ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Event> .

<http://www.kanzaki.com/ns/music#BassClarinet> a owl:Class ;
    rdfs:label "Bass Clarinet" ;
    rdfs:comment "A larger member of the clarinet family, usually in key B-flat." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Clarinet> .

<http://www.kanzaki.com/ns/music#Bassoonist> a owl:Class ;
    rdfs:label "Bassoonist" ;
    rdfs:comment "A Fagotto player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Bassoon> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#Celesta> a owl:Class ;
    rdfs:label "Celesta" ;
    rdfs:comment "A musical instrument with a keyboard and metal plates struck by hammers that produce bell-like tones." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Keyboard_Instrument> .

<http://www.kanzaki.com/ns/music#Cello> a owl:Class ;
    rdfs:label "Cello" ;
    rdfs:comment "A stringed instrument of the violin family, with bass to tenor tone. Usually played in sitting position." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#String_Instrument> .

<http://www.kanzaki.com/ns/music#Chamber_Music> a owl:Class ;
    rdfs:label "Chamber Music" ;
    rdfs:comment "A genre of music composed for performance by small ensemble" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Oeuvre> .

<http://www.kanzaki.com/ns/music#Clarinettist> a owl:Class ;
    rdfs:label "Clarinettist" ;
    rdfs:comment "A Clarinet player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Clarinet> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#Contrabass> a owl:Class ;
    rdfs:label "Contrabass" ;
    rdfs:comment "The largest member of string insrtument, usually with four or five strings." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#String_Instrument> .

<http://www.kanzaki.com/ns/music#Contrafagotto> a owl:Class ;
    rdfs:label "Contrafagotto" ;
    rdfs:comment "A larger mebmer of the basoon family, producing the lowest tone in the woodwind section." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Bassoon> .

<http://www.kanzaki.com/ns/music#EnglishHorn> a owl:Class ;
    rdfs:label "English Horn" ;
    rdfs:comment "A double-reed woodwind instrument, larger member of the oboe family." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Oboe> .

<http://www.kanzaki.com/ns/music#Flutist> a owl:Class ;
    rdfs:label "Flutist" ;
    rdfs:comment "A Flute player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Flute> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#Guitar> a owl:Class ;
    rdfs:label "Guitar" ;
    rdfs:comment "A musical instrument having a large flat-backed sound box, a long fretted neck, and usually six strings, played by strumming or plucking." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#String_Instrument> .

<http://www.kanzaki.com/ns/music#Harp> a owl:Class ;
    rdfs:label "Harp" ;
    rdfs:comment "An instrument with usually 46 or 47 strings that are played by plucking with the fingers." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#String_Instrument> .

<http://www.kanzaki.com/ns/music#Horn> a owl:Class ;
    rdfs:label "Horn" ;
    rdfs:comment "A brass instrument with a long narrow tube that is coiled in a circle before ending in a flaring bell, usually being equipped with valves. A French Horn." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Brass_Instrument> .

<http://www.kanzaki.com/ns/music#Oboist> a owl:Class ;
    rdfs:label "Oboist" ;
    rdfs:comment "An Oboe player" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://www.kanzaki.com/ns/music#plays> ;
            owl:someValuesFrom <http://www.kanzaki.com/ns/music#Oboe> ],
        <http://www.kanzaki.com/ns/music#Player> .

<http://www.kanzaki.com/ns/music#Opera_Event> a owl:Class ;
    rdfs:label "Opera Event" ;
    rdfs:comment "An event of opera performance (not an opera as a musical work, which is defined here as 'Opera')" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Event> .

<http://www.kanzaki.com/ns/music#Performance> a owl:Class ;
    rdfs:label "Peroformance" ;
    rdfs:comment "Representation of a musical work in the form of performace, e.g. playing instruments, singing etc. Note a concert is a Musical_Event where a Performance is presented." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Representation> .

<http://www.kanzaki.com/ns/music#Piano> a owl:Class ;
    rdfs:label "Pian" ;
    rdfs:comment "A musical instrument with a manual keyboard actuating hammers that strike wire strings. A pianoforte." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Keyboard_Instrument> .

<http://www.kanzaki.com/ns/music#Piccolo> a owl:Class ;
    rdfs:label "Piccolo" ;
    rdfs:comment "A piccolo flute, smaller member of the flute family." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Flute> .

<http://www.kanzaki.com/ns/music#String_Quartet> a owl:Class ;
    rdfs:label "String Quartet" ;
    rdfs:comment "A music composed for instrumental quartet with 2 violins and a viola and a cello. Note 'StringQuartetEnsemble' is SQ ensemble in this vocabulary." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Chamber_Music> .

<http://www.kanzaki.com/ns/music#Timpani> a owl:Class ;
    rdfs:label "Timpani" ;
    rdfs:comment "A set of large copper or brass hemispherical drums with a parchment head that can be tuned by adjusting the tension." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Percussion> .

<http://www.kanzaki.com/ns/music#Trombone> a owl:Class ;
    rdfs:label "Trombone" ;
    rdfs:comment "A brass instrument consisting of a long cylindrical tube, and having a movable U-shaped slide for producing different pitches." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Brass_Instrument> .

<http://www.kanzaki.com/ns/music#Trumpet> a owl:Class ;
    rdfs:label "Trumpet" ;
    rdfs:comment "A A soprano brass instrument consisting of a long metal tube looped once and ending in a flared bell, usually being equipped with valves or pistons." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Brass_Instrument> .

<http://www.kanzaki.com/ns/music#Tuba> a owl:Class ;
    rdfs:label "Tuba" ;
    rdfs:comment "A large, valved, brass instrument with a bass pitch." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Brass_Instrument> .

<http://www.kanzaki.com/ns/music#Venue> a owl:Class ;
    rdfs:label "Venue" ;
    rdfs:comment "A venue for musical performance, e.g. concert hall, opera house, recital hall, etc." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Viola> a owl:Class ;
    rdfs:label "Viola" ;
    rdfs:comment "A stringed instrument of the violin family, slightly larger than a violin, tuned a fifth lower, and having a deeper, more sonorous tone." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#String_Instrument> .

<http://www.kanzaki.com/ns/music#Violin> a owl:Class ;
    rdfs:label "Violin" ;
    rdfs:comment "A musical instrument played with a bow, having four strings. Usually plays the highest part of the string section." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#String_Instrument> .

<http://www.kanzaki.com/ns/music#performerName> a owl:DatatypeProperty ;
    rdfs:label "PerformerName" ;
    rdfs:comment "The subject musical event has a performer. Literal version of #performer." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Event> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://www.kanzaki.com/works/2007/misc/music-vocab-sample2.png> a foaf:Image ;
    rdfs:label "'circles and arrows' graphical representation of this example" .

<http://www.kanzaki.com/works/2007/misc/music-vocab-sample3.png> a foaf:Image ;
    rdfs:label "'circles and arrows' graphical representation of this example" .

<http://www.kanzaki.com/ns/music#Bassoon> a owl:Class ;
    rdfs:label "Bassoon" ;
    rdfs:comment "A low-pitched woodwind instrument with a double reed, having a long wooden body attached to a U-shaped lateral tube that leads to the mouthpiece. A Fagotto." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Woodwind_Instrument> .

<http://www.kanzaki.com/ns/music#Choral_Music> a owl:Class ;
    rdfs:label "Choral Music" ;
    rdfs:comment "A genre of music composed for performance by a chorus or choir" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Oeuvre> .

<http://www.kanzaki.com/ns/music#Flute> a owl:Class ;
    rdfs:label "Flute" ;
    rdfs:comment "A high-pitched woodwind instrument; a slender tube closed at one end with finger holes on one end and an opening near the closed end across which the breath is blown" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Woodwind_Instrument> .

<http://www.kanzaki.com/ns/music#Oboe> a owl:Class ;
    rdfs:label "Oboe" ;
    rdfs:comment "A woodwind instrument with a conical bore and a double-reed mouthpiece." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Woodwind_Instrument> .

<http://www.kanzaki.com/ns/music#Percussion> a owl:Class ;
    rdfs:label "Percussion" ;
    rdfs:comment "A musical instrument that produces sound by striking the body." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Instrument> .

<http://www.kanzaki.com/ns/music#artist_description> a owl:ObjectProperty ;
    rdfs:label "Artist Description" ;
    rdfs:comment "A description of the subject artist or agent. Super-property of #plays, #performs." ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing .

<http://www.kanzaki.com/ns/music#Director> a owl:Class ;
    rdfs:label "Director" ;
    rdfs:comment "An artist who directs a musical group" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Artist> .

<http://www.kanzaki.com/ns/music#Keyboard_Instrument> a owl:Class ;
    rdfs:label "Keyboard Instrument" ;
    rdfs:comment "A musical instrument that has a set of keys that consist of scale." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Instrument> .

<http://www.kanzaki.com/ns/music#event_description> a owl:ObjectProperty ;
    rdfs:label "Event Description" ;
    rdfs:comment "A description of the subject musical event. Super-property of #program, #presents, #venue." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Event> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing .

<http://www.kanzaki.com/ns/music#performer> a owl:ObjectProperty ;
    rdfs:label "Performer" ;
    ns1:example [ a ns1:Example ;
            ns1:code "\\n<!--Preferred description.-->\\n<m:Concert>\\n <m:presents>\\n  <m:Performance>\\n   <m:conductor foaf:name=\"Sir Roger Norrington\"/>\\n   <m:performer foaf:name=\"R.S.O. Stuttgart\"/>\\n   <m:represents>\\n    <m:Symphony>\\n     <m:composer foaf:name=\"Brahms\"/>\\n     <dc:title>Symphony No.2 D major</dc:title>\\n    </m:Symphony>\\n   </m:represents>\\n  </m:Performance>\\n </m:presents>\\n</m:Concert>\\n" ],
        [ a ns1:Example ;
            ns1:code "\\n<!--Possibly more intuitive description.-->\\n<m:Concert>\\n <m:conductor foaf:name=\"Sir Roger Norrington\"/>\\n <m:performer foaf:name=\"R.S.O. Stuttgart\"/>\\n <m:program>\\n  <m:Symphony>\\n   <m:composer foaf:name=\"Brahms\"/>\\n   <dc:title>Symphony No.2 D major</dc:title>\\n  </m:Symphony>\\n </m:program>\\n</m:Concert>\\n\\n<!-- An application may infer that:\\n{X a m:Concert; m:performer Y; m:program Z.} =>\\n{X m:presents [a m:Performance; m:performer Y; m:represents Z] .}\\n-->\\n" ] ;
    rdfs:comment "The subject has a performer (an artist, a group, a machine etc.). The preferred domain of this property is #Performance, so as to model that \"a concert presents a performance (of a musical work) that is realized by this performer\". However, in natural language, we often say that \"a concert has performers who play these musical works\", i.e. the domain of 'performer' is #Musical_Event in this case, and it would be more intuitive model. Hence, the domain is leave unrestricted here for a moment. " ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent .

<http://www.kanzaki.com/ns/music#Artist> a owl:Class ;
    rdfs:label "Artist" ;
    rdfs:comment "A person or group (or any agent) who creates or performs art works" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf foaf:Agent .

<http://www.kanzaki.com/ns/music#Brass_Instrument> a owl:Class ;
    rdfs:label "Brass Instrument" ;
    rdfs:comment "A wind musical instrument, that consists of a brass tube  blown by means of a cup-shaped or funnel-shaped mouthpiece." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Instrument> .

<http://www.kanzaki.com/ns/music#Clarinet> a owl:Class ;
    rdfs:label "Clarinet" ;
    rdfs:comment "A woodwind instrument having a straight cylindrical tube with a flaring bell and a single-reed mouthpiece." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Woodwind_Instrument> .

<http://www.kanzaki.com/ns/music#Musician> a owl:Class ;
    rdfs:label "Musician" ;
    rdfs:comment "An artist who performs, composes or conducts music" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Artist> .

<http://www.kanzaki.com/ns/music#Orchestral_Work> a owl:Class ;
    rdfs:label "Orchestral Work" ;
    rdfs:comment "A composition for orchestra (and a soloist or soloists, optionally with chorus)" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Oeuvre> .

<http://www.kanzaki.com/ns/music#Musical_Representation> a owl:Class ;
    rdfs:label "Musical Representation" ;
    rdfs:comment "Representation of a musical work, such as a score, sheet music, perfornamce, recoding, etc." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Woodwind_Instrument> a owl:Class ;
    rdfs:label "Woodwind Instrument" ;
    rdfs:comment "A wind musical instrument, in which sound is produced by the vibration of reeds in the mouthpiece, or by the passing of air across the mouthpiece." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Instrument> .

<http://www.kanzaki.com/ns/music#Written_Representation> a owl:Class ;
    rdfs:label "Written Representation" ;
    rdfs:comment "Representation of a musical work in the form of a written expression, e.g. score, parts, autograph, printed music, sketch, etc." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Representation> .

foaf:Agent a owl:Class .

dc:description a owl:DatatypeProperty .

<http://www.kanzaki.com/ns/music#MusicalGroup> a owl:Class ;
    rdfs:label "Musical Group" ;
    rdfs:comment "A group that performs art works" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Artist> .

<http://www.kanzaki.com/ns/music#Musical_Instrument> a owl:Class ;
    rdfs:label "Musical Instrument" ;
    rdfs:comment "An instrument to play music" ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Singer> a owl:Class ;
    rdfs:label "Singer" ;
    rdfs:comment "An artist who sings a song" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musician> .

<http://www.kanzaki.com/ns/music#String_Instrument> a owl:Class ;
    rdfs:label "String Instrument" ;
    rdfs:comment "A stringed musical instrument, in which sound is produced by plucking, striking, or bowing taut strings." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Instrument> .

<http://www.kanzaki.com/ns/music#description> a owl:ObjectProperty ;
    rdfs:label "Description" ;
    rdfs:comment "A description of the subject musical work. Super-property of some properties in this vocabulary, as well as description of a general descriptive resource such as time-line of composing process." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing .

<http://www.kanzaki.com/ns/music#Musical_Event> a owl:Class ;
    rdfs:label "Musical Event" ;
    rdfs:comment "An event of musical performance by players or singers, including theatrical staging. Typically the event has date and location. Note this is different from Performance, which is a 'representation' of a musical work realized at a musical event or recording, etc." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Musical_Work> a owl:Class ;
    rdfs:label "Musical Work" ;
    rdfs:comment "A musical work in any form, e.g. a composition, its movement, phrase, theme etc." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#Oeuvre> a owl:Class ;
    rdfs:label "Oeuvre" ;
    rdfs:comment "A (complete) musical work by a composer." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musical_Work> .

<http://www.kanzaki.com/ns/music#Player> a owl:Class ;
    rdfs:label "Player" ;
    rdfs:comment "An artist who performs a musical instrument" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://www.kanzaki.com/ns/music#Musician> .

<http://www.kanzaki.com/ns/music#plays> a owl:ObjectProperty ;
    rdfs:label "Plays" ;
    rdfs:comment "The subject artist (or group, machine, etc) plays an musical instrument. If :me :plays :Violin, then :me a :Violininst." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.kanzaki.com/ns/music#Musical_Instrument> ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#artist_description> .

<http://www.kanzaki.com/ns/music#Key> a owl:Class ;
    rdfs:label "Key" ;
    rdfs:comment "A key of a musical work (e.g. C-dur, b-moll)" ;
    rdfs:isDefinedBy onto: .

onto: a owl:Ontology ;
    rdfs:label "Music Vocabulary" ;
    ns2:created "2003-07-04" ;
    ns2:creator [ a foaf:Person ;
            rdfs:seeAlso <http://www.kanzaki.com/info/webwho.rdf> ;
            foaf:homepage <http://www.kanzaki.com/> ] ;
    ns2:modified "2007-10-31" ;
    rdfs:comment "A vocabulary, or music ontology, to describe classical music and performances. Classes (categories) for musical works, events, instruments and performers, as well as related properties are defined. Make sure to distinguish musical works (e.g. Opera) from performance events (Opera_Event), or works (String_Quartette) from performer (StringQuartetEnsemble in this vocab), whose natural language terms are used interchangeblly. The present version experiments more precise model to describe a musical work, its representations (performances, scores, etc) and a musical event to present a representation (a concert). Includes 30 keys as individuals." ;
    owl:imports <http://www.kanzaki.com/ns/dliser.rdf> ;
    owl:versionInfo "Version 0.9.6 - OWL DL version. Some stable, some experimental. Changed terms: Opera_Performance to Opera_Event, Ballet_Performance to Ballet_Event." .

[] a ns1:Example ;
    ns1:code "\\n<m:Concert>\\n <dc:title>Tokyo Green Symphony Orchestra 12th Concert</dc:title>\\n <dc:date>2003-11-02T14:00+09:00</dc:date>\\n <m:conductor foaf:name=\"Yuri Nitta\"/>\\n <m:performer>\\n  <m:Violinist>\\n   <foaf:name>Tomoko Kawada</foaf:name>\\n   <m:performs rdf:nodeID=\"p1\"/>\\n  </m:Violinist>\\n </m:performer>\\n <m:performer>\\n  <m:Orchestra foaf:name=\"Tokyo Green Symphony Orchestra\"/>\\n </m:performer>\\n <m:program>\\n  <m:Concerto rdf:nodeID=\"p1\">\\n   <m:composer foaf:name=\"Bruch\"/>\\n   <dc:title>Violin Concerto No.1 g minor</dc:title>\\n   <m:opus>op.26</m:opus>\\n  </m:Concerto>\\n </m:program>\\n <m:program>\\n  <m:Symphony>\\n   <m:composer foaf:name=\"Brahms\"/>\\n   <dc:title>Symphony No.2 D major</dc:title>\\n   <m:opus>op.73</m:opus>\\n  </m:Symphony>\\n </m:program>\\n <m:venue>\\n  <m:Venue geo:lat=\"35.69\" geo:long=\"139.81\">\\n   <dc:title>Sumida Triphony</dc:title>\\n  </m:Venue>\\n </m:venue>\\n</m:Concert>\\n " ;
    ns1:exampleOf onto: ;
    ns1:image <http://www.kanzaki.com/works/2007/misc/music-vocab-sample2.png> ;
    ns1:pfx "m:" ;
    rdfs:comment "Another description of a concert with its title, date, program and venue. See also examples in the definition of 'performer' for more erabolate model (the preferred domain of this property is m:Performance, not m:Concert)." .

[] a ns1:Example ;
    ns1:code "\\n<m:Concert>\\n <dc:date>2008-02-11</dc:date>\\n <m:conductor>\\n  <m:Conductor rdf:about=\"http://www.kanzaki.com/bass/conductor#長田雅人\">\\n   <foaf:name>Masato Osada</foaf:name>\\n  </m:Conductor>\\n </m:conductor>\\n <m:performer>\\n  <m:Orchestra rdf:about=\"http://www.kanzaki.com/bass/orch#オーケストラ・ダスビダーニャ\">\\n   <foaf:name>orchestra 'do svidanya'</foaf:name>\\n  </m:Orchestra>\\n </m:performer>\\n <m:program>\\n  <m:Symphony rdf:about=\"http://www.kanzaki.com/music/mcat/shostakovich/op.103#s\">\\n   <dc:title>Symphony No.11 g-minor</dc:title>\\n   <m:opus>op.103</m:opus>\\n   <m:composer>\\n    <m:Composer rdf:about=\"http://www.kanzaki.com/ns/psi/en/Dmitri_Shostakovich#s\"/>\\n   </m:composer>\\n  </m:Symphony>\\n </m:program>\\n</m:Concert>\\n " ;
    ns1:exampleOf onto: ;
    ns1:image <http://www.kanzaki.com/works/2007/misc/music-vocab-sample1.png> ;
    ns1:pfx "m:" ;
    rdfs:comment "A simple description of a concert." .

[] a ns1:Example ;
    ns1:code "\\n<m:Concert>\\n <dc:title>Tokyo Green Symphony Orchestra 12th Concert</dc:title>\\n <dc:date>2003-11-02T14:00+09:00</dc:date>\\n <m:conductorName>Yuri Nitta</m:conductorName>\\n <m:performerName>Violin: Tomoko Kawada</m:performerName>\\n <m:performerName>Orchestra: Tokyo Green Symphony Orchestra</m:performerName>\\n <m:programLine>Bruch: Violin Concerto No.1 g minor</m:programLine>\\n <m:programLine>Brahms: Symphony No.2 D major</m:programLine>\\n <cal:location>Sumida Triphony</cal:location>\\n</m:Concert>\\n " ;
    ns1:exampleOf onto: ;
    ns1:pfx "m:" ;
    rdfs:comment "A simplified description of a concert with its title, date, program and venue. All property values are literal string here." .

[] a ns1:Example ;
    ns1:code "\\n<m:Symphony>\\n <m:composer rdf:parseType=\"Resource\">\\n  <foaf:name>シューベルト</foaf:name>\\n  <foaf:homepage rdf:resource=\"http://www.kanzaki.com/music/mw/sym/schubert\"/>\\n </m:composer>\\n <dc:title>Symohony No.7 'Unfinished'</dc:title>\\n <m:opus>D.759</m:opus>\\n <m:key rdf:resource=\"http://www.kanzaki.com/ns/music#h-moll\"/>\\n <dcterms:created>1822-01</dcterms:created>\\n <m:premiere rdf:parseType=\"Resource\">\\n  <dc:date>1865-12-17</dc:date>\\n  <cal:location>Wien Musikfereinsall</cal:location>\\n </m:premiere>\\n <m:sections rdf:parseType=\"Collection\">\\n  <m:Movement>\\n   <m:marks>Allegro moderato</m:marks>\\n   <m:key rdf:resource=\"http://www.kanzaki.com/ns/music#h-moll\"/>\\n   <m:meter>3/4</m:meter>\\n  </m:Movement>\\n  <m:Movement>\\n   <m:marks>Andante con moto</m:marks>\\n   <m:key rdf:resource=\"http://www.kanzaki.com/ns/music#Es-dur\"/>\\n   <m:meter>3/8</m:meter>\\n  </m:Movement>\\n </m:sections>\\n</m:Symphony>\\n " ;
    ns1:exampleOf onto: ;
    ns1:image <http://www.kanzaki.com/works/2007/misc/music-vocab-sample3.png> ;
    ns1:pfx "m:" ;
    ns1:trial <http://purl.org/net/masterwork/schubert/D.759> ;
    rdfs:comment "A description of a symphony with its composition data and descriptions of movements. Note now key values are expressed as URIs." .

