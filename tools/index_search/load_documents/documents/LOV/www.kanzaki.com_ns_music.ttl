    dcterms:description <http://en.wikipedia.org/wiki/F_sharp_minor> ;
    rdfs:comment "Minor key based on F sharp, whose key signature has 3 sharps." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#form> a owl:DatatypeProperty ;
    rdfs:label "Form" ;
    rdfs:comment "The subject musical work or its movement has a form, such as sonata, minuet, etc. Would be better defined as ObjectProperty." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://www.kanzaki.com/ns/music#g-moll> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "g moll" ;
    dcterms:alternative "G minor" ;
    dcterms:description <http://en.wikipedia.org/wiki/G_minor> ;
    rdfs:comment "Minor key based on G, whose key signature has 2 flats." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#gis-moll> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "gis moll" ;
    dcterms:alternative "G-Sharp minor" ;
    dcterms:description <http://en.wikipedia.org/wiki/G_sharp_minor> ;
    rdfs:comment "Minor key based on G sharp, whose key signature has 5 sharps." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#h-moll> a <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:label "h moll" ;
    dcterms:alternative "B minor" ;
    dcterms:description <http://en.wikipedia.org/wiki/B_minor> ;
    rdfs:comment "Minor key based on B, whose key signature has 2 sharps." ;
    rdfs:isDefinedBy onto: .

<http://www.kanzaki.com/ns/music#key> a owl:ObjectProperty ;
    rdfs:label "Key" ;
    rdfs:comment "The subject musical work or its movement has a key, such as C major, d minor, etc." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.kanzaki.com/ns/music#Key> ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#description> .

<http://www.kanzaki.com/ns/music#keyName> a owl:DatatypeProperty ;
    rdfs:label "Key Name" ;
    rdfs:comment "The subject musical work or its movement has a key. Textual version of #key." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://www.kanzaki.com/ns/music#marks> a owl:DatatypeProperty ;
    rdfs:label "Marks" ;
    rdfs:comment "The subject musical work or its movement has instruction mark(s) of tempo and/or expression" ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://www.kanzaki.com/ns/music#meter> a owl:DatatypeProperty ;
    rdfs:label "Meter" ;
    rdfs:comment "The subject musical work or its movement has a time measure such as 3/4, 4/4, 6/8 etc" ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Work> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://www.kanzaki.com/ns/music#opus> a owl:DatatypeProperty ;
    rdfs:label "Opus" ;
    rdfs:comment "The subject musical composition has an identifier assigned by a composer (e.g. 'op.131') or other editor (e.g. 'KV.551')" ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Oeuvre> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier .

<http://www.kanzaki.com/ns/music#performs> a owl:ObjectProperty ;
    rdfs:label "Performs" ;
    rdfs:comment "The subject artist (or group, machine, etc) performs a musical work." ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#artist_description> ;
    owl:inverseOf <http://www.kanzaki.com/ns/music#performer> .

<http://www.kanzaki.com/ns/music#premiere> a owl:ObjectProperty ;
    rdfs:label "Premiere" ;
    ns1:example [ a ns1:Example ;
            ns1:code "\\n<m:Symphony>\\n <m:composer foaf:name=\"Shubert\"/>\\n <dc:title>Symohony No.7 'Unfinished'</dc:title>\\n <m:opus>D.759</m:opus>\\n <dcterms:created>1822-01</dcterms:created>\\n <m:premiere rdf:parseType=\"Resource\">\\n  <dc:date>1865-12-17</dc:date>\\n  <cal:location>Wien Musikfereinsall</cal:location>\\n </m:premiere>\\n</m:Symphony>\\n" ] ;
    rdfs:comment "The subject musical work was first performed at an concert" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.kanzaki.com/ns/music#Musical_Event> ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#description> .

<http://www.kanzaki.com/ns/music#presents> a owl:ObjectProperty ;
    rdfs:label "Presents" ;
    rdfs:comment "The subject musical event presents a performance of a musical work. An experiment to have better model to describe musical work, its representation and an event to present the representation." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.kanzaki.com/ns/music#Performance> ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#event_description> .

<http://www.kanzaki.com/ns/music#program> a owl:ObjectProperty ;
    rdfs:label "Program" ;
    rdfs:comment "The subject musical event presents a musical work as its program" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.kanzaki.com/ns/music#Oeuvre> ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#event_description> .

<http://www.kanzaki.com/ns/music#programLine> a owl:DatatypeProperty ;
    rdfs:label "Program Line" ;
    rdfs:comment "The subject musical event presents a musical work as its program. Literal version of #program." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Event> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:description .

<http://www.kanzaki.com/ns/music#published> a owl:ObjectProperty ;
    rdfs:label "published" ;
    ns1:example [ a ns1:Example ;
            ns1:code "\\n<m:Symphony>\\n <m:composer foaf:name=\"Beethoven\"/>\\n <dc:title>Symphony No.9</dc:title>\\n <m:opus>Op.125</m:opus>\\n <m:published>\\n  <m:Score>\\n   <dc:date>1826-08</dc:date>\\n   <dc:description>The first published edition</dc:description>\\n   <dc:publisher>Schott</dc:publisher>\\n  </m:Score>\\n </m:published>\\n</m:Symphony>\\n" ] ;
    rdfs:comment "The subject musical work is published as a score or sheet music (still not sure what kind of class is appropriate as the range)" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.kanzaki.com/ns/music#Written_Representation> ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#description> .

<http://www.kanzaki.com/ns/music#represents> a owl:ObjectProperty ;
    rdfs:label "Represents" ;
    rdfs:comment "The subject (performance, score, etc) is a representation of the object musical work. An experiment to have better model." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Musical_Representation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.kanzaki.com/ns/music#Musical_Work> .

<http://www.kanzaki.com/ns/music#sections> a owl:ObjectProperty ;
    rdfs:label "Sections" ;
    rdfs:comment "The subject musical work has subsections such as movements. Current model recommends RDF Collection as the object." ;
    rdfs:domain <http://www.kanzaki.com/ns/music#Oeuvre> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#description> .

<http://www.kanzaki.com/ns/music#soloist> a owl:ObjectProperty ;
    rdfs:label "Soloist" ;
    rdfs:comment "The subject performance is performed by this soloist (or the subject musical event has a soloist. See comment of #performer." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#performer> .

<http://www.kanzaki.com/ns/music#source> a owl:ObjectProperty ;
    rdfs:label "Source" ;
    rdfs:comment "The subject musical work has a historical source, such as sketch, autograph score or published score." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.kanzaki.com/ns/music#Written_Representation> ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#description> .

<http://www.kanzaki.com/ns/music#venue> a owl:ObjectProperty ;
    rdfs:label "Venue" ;
    rdfs:comment "The subject musical event is presented at the object venue." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://www.kanzaki.com/ns/music#Venue> ;
    rdfs:subPropertyOf <http://www.kanzaki.com/ns/music#event_description> .

