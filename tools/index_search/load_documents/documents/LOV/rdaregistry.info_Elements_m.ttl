<http://rdaregistry.info/Elements/m/P30001> a rdf:Property ;
    rdfs:label "has carrier type"@en ;
    ns1:hasUnconstrained <http://rdaregistry.info/Elements/u/P60048> ;
    ns1:lexicalAlias <http://rdaregistry.info/Elements/m/carrierType.en> ;
    ns1:name "carrierType"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    ns2:instructionNumber "3.3" ;
    ns2:toolkitDefinition "A categorization reflecting the format of the storage medium and housing of a carrier in combination with the type of intermediation device required to view, play, run, etc., the content of a resource."@en ;
    ns2:toolkitLabel "carrier type"@en ;
    rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
    rdfs:isDefinedBy <http://rdaregistry.info/Elements/m/> ;
    skos:definition "Relates a manifestation to a categorization reflecting the format of the storage medium and housing of a carrier in combination with the type of intermediation device required to view, play, run, etc., the content of a resource."@en .

<http://rdaregistry.info/Elements/m/P30002> a rdf:Property ;
    rdfs:label "has media type"@en ;
    ns1:hasUnconstrained <http://rdaregistry.info/Elements/u/P60050> ;
    ns1:lexicalAlias <http://rdaregistry.info/Elements/m/mediaType.en> ;
    ns1:name "mediaType"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    ns2:instructionNumber "3.2" ;
    ns2:toolkitDefinition "A categorization reflecting the general type of intermediation device required to view, play, run, etc., the content of a resource."@en ;
    ns2:toolkitLabel "media type"@en ;
    rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
    rdfs:isDefinedBy <http://rdaregistry.info/Elements/m/> ;
    skos:definition "Relates a manifestation to a categorization reflecting the general type of intermediation device required to view, play, run, etc., the content of a resource."@en .

<http://rdaregistry.info/Elements/m/P30003> a rdf:Property ;
    rdfs:label "has mode of issuance"@en ;
    ns1:hasUnconstrained <http://rdaregistry.info/Elements/u/P60051> ;
    ns1:lexicalAlias <http://rdaregistry.info/Elements/m/modeOfIssuance.en> ;
    ns1:name "modeOfIssuance"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    ns2:instructionNumber "2.13" ;
    ns2:toolkitDefinition "A categorization reflecting whether a resource is issued in one or more parts, the way it is updated, and its intended termination."@en ;
    ns2:toolkitLabel "mode of issuance"@en ;
    rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
    rdfs:isDefinedBy <http://rdaregistry.info/Elements/m/> ;
    skos:definition "Relates a manifestation to a categorization reflecting whether a resource is issued in one or more parts, the way it is updated, and its intended termination."@en .

<http://rdaregistry.info/Elements/m/P30005> a rdf:Property ;
    rdfs:label "has preferred citation"@en ;
    ns1:hasUnconstrained <http://rdaregistry.info/Elements/u/P60057> ;
    ns1:lexicalAlias <http://rdaregistry.info/Elements/m/preferredCitation.en> ;
    ns1:name "preferredCitation"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    ns2:instructionNumber "2.16" ;
    ns2:toolkitDefinition "A citation for a resource in the form preferred by a creator, publisher, custodian, indexing or abstracting service, etc."@en ;
    ns2:toolkitLabel "preferred citation"@en ;
    rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
    rdfs:isDefinedBy <http://rdaregistry.info/Elements/m/> ;
    skos:definition "Relates a manifestation to a citation for a resource in the form preferred by a creator, publisher, custodian, indexing or abstracting service, etc."@en .

<http://rdaregistry.info/Elements/m/P30007> a rdf:Property ;
    rdfs:label "has copyright date"@en ;
    ns1:hasUnconstrained <http://rdaregistry.info/Elements/u/P60069> ;
