@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://rdf.geospecies.org/methods/observationMethod.rdf> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:DatatypeProperty .

dcterms:identifier a owl:DatatypeProperty .

dcterms:modified a owl:DatatypeProperty .

dcterms:publisher a owl:DatatypeProperty .

dcterms:title a owl:DatatypeProperty .

<http://rdf.geospecies.org/methods/observationMethod#Above-Ground_Sticky_Trap> a owl:Class ;
    rdfs:comment "Collection method based using a sticky substance that traps insects and other arthropods, usually in the form of a card with a sticky glue-like substance on one side. Often colored yellow or blue."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#Aerial_Collection_Net> a owl:Class ;
    rdfs:comment "\"Butterfly\" Type Net"^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Manual_Collection_Method> .

<http://rdf.geospecies.org/methods/observationMethod#Aspirator> a owl:Class ;
    rdfs:comment "A handheld device operated by suction from the lungs of the collector or a vacuum fan, used to collect arthropods."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Manual_Collection_Method> .

<http://rdf.geospecies.org/methods/observationMethod#Barrier_Pitfall_Trap> a owl:Class ;
    rdfs:comment "A form of Pitfall Trap that uses a barrier wall that directs arthropods into one of two pitfall traps at either end."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Pitfall_Based_Trap> .

<http://rdf.geospecies.org/methods/observationMethod#Berlese_Sample> a owl:Class ;
    rdfs:comment "Method of arthropod collection for soil and litter samples"^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#CO2_Trap> a owl:Class ;
    rdfs:comment "Usually a suction-based trap that collects arthropods attracted to light and CO2 (carbon dioxide)"^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Hanging_Suction_Based_Attraction_Trap> .

<http://rdf.geospecies.org/methods/observationMethod#Cantharidin_Baited_Jar_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#Cantharidin_Baited_Lindgren_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Lindgren_Trap> .

<http://rdf.geospecies.org/methods/observationMethod#Chicken-Mash_Baited_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#Flight_Intercept_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#Ground-based_Sticky_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#Hand_Collected> a owl:Class ;
    rdfs:comment "Collection by hand, usually into a jar or container"^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Manual_Collection_Method> .

<http://rdf.geospecies.org/methods/observationMethod#Human_Bite_Collection> a owl:Class ;
    rdfs:comment "Manual collection of insects and other arthropods that bite humans using an aspirator. Usually used to collect mosquitoes or other blood feeding insects."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Manual_Collection_Method> .

<http://rdf.geospecies.org/methods/observationMethod#Human_Observation> a owl:Class .

<http://rdf.geospecies.org/methods/observationMethod#Light_and_CO2_Trap> a owl:Class ;
    rdfs:comment "Usually a suction-based trap that collects arthropods attracted to light and CO2."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Hanging_Suction_Based_Attraction_Trap> .

<http://rdf.geospecies.org/methods/observationMethod#Malaise_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#Photographed> a owl:Class .

<http://rdf.geospecies.org/methods/observationMethod#Pitfall_Trap> a owl:Class ;
    rdfs:comment "A cup-like trap, place in the ground that captures terrestrial wandering arthropods which fall in."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Pitfall_Based_Trap> .

<http://rdf.geospecies.org/methods/observationMethod#Sweep_Net> a owl:Class ;
    rdfs:comment "Similar to an Aerial net, but constructed of stronger fabric for sweeping through vegetation."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Manual_Collection_Method> .

<http://rdf.geospecies.org/methods/observationMethod#UV_Light_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Hanging_Suction_Based_Attraction_Trap> .

<http://rdf.geospecies.org/methods/observationMethod#Unbaited_Lindgren_Funnel_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Lindgren_Trap> .

<http://rdf.geospecies.org/methods/observationMethod#Vacuum_Collector> a owl:Class ;
    rdfs:comment "A large, often back-mounted vacuum device to collect arthropods from vegetation."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Manual_Collection_Method> .

<http://rdf.geospecies.org/methods/observationMethod#Visible_Light_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Hanging_Suction_Based_Attraction_Trap> .

<http://rdf.geospecies.org/methods/observationMethod#alpha-piniene_Baited_Lindgren_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Lindgren_Trap> .

<http://rdf.geospecies.org/methods/observationMethod#ipsdiend_Baited_Lindgren_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#Lindgren_Trap> .

onto: a owl:Ontology ;
    dcterms:created "2009-01-31" ;
    dcterms:identifier "http://rdf.geospecies.org/methods/observationMethod.rdf" ;
    dcterms:isPartOf <http://people.geospecies.org/projects/GeoSpecies_Knowledge_Base/> ;
    dcterms:modified "2009-02-15" ;
    dcterms:publisher "Peter J. DeVries"@en-us ;
    dcterms:title "Observation Methods"@en-us ;
    rdfs:comment "This is a taxonomy of some observation methods. It is incomplete." ;
    foaf:maker <http://people.geospecies.org/people/Peter_J_DeVries/> .

doap:Project a owl:ObjectProperty .

foaf:maker a owl:ObjectProperty .

<http://rdf.geospecies.org/methods/observationMethod#Pitfall_Based_Trap> a owl:Class ;
    rdfs:comment "Ground base traps that arthropods fall into."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#Hanging_Suction_Based_Attraction_Trap> a owl:Class ;
    rdfs:comment "Suction based traps, usually for flying insects. Often combined with an attractant."^^xsd:string ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#Lindgren_Trap> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#Manual_Collection_Method> a owl:Class ;
    rdfs:subClassOf <http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> .

<http://rdf.geospecies.org/methods/observationMethod#ArthropodCollectionMethods> a owl:Class .

