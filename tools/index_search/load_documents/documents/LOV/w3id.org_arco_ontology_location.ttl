@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/arco/ontology/catalogue/> .
@prefix ns2: <http://ontologydesignpatterns.org/opla/> .
@prefix onto: <https://w3id.org/arco/ontology/location> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:description a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

xsd:date a rdfs:Datatype .

ns1:iccdNormTag a owl:AnnotationProperty .

<https://w3id.org/arco/ontology/core/Situation> a owl:Class .

<https://w3id.org/arco/ontology/location/ArchivalLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Archival location"@en ;
    rdfs:comment "This individual represents a specific type of location, that is the archival location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/BuildingAndLandCadastre> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/CadastreType> .

<https://w3id.org/arco/ontology/location/BuildingCadastre> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/CadastreType> .

<https://w3id.org/arco/ontology/location/CadastralFolio> a owl:Class ;
    rdfs:label "Cadastral map folio"@en ;
    rdfs:comment "This class represents a folio of a cadastral map, which contains one or more cadastral parcels."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/italia/onto/TI/time> ],
        <https://w3id.org/arco/ontology/location/CadastralEntity> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CS/CTS/CTSF ; LS/CSS/CSSF. - Normativa RA v.2: RP/LGC/LGCM+LGCA" .

<https://w3id.org/arco/ontology/location/CadastralUnitCollection> a owl:Class ;
    rdfs:label "Cadastral unit collection"@en ;
    rdfs:comment "This class represents one or more cadastral parcels."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/context-description/LegalSituation> ;
            owl:onProperty <https://w3id.org/arco/ontology/context-description/hasLegalSituation> ],
        <https://w3id.org/arco/ontology/location/CadastralEntity> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Traversale 4.00: CS/CTS/CTSN; LS/CSS/CSSN. - Normativa RA v.2: RP/LGC/LGCR" .

<https://w3id.org/arco/ontology/location/ChiefTown> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/OldTownAdmistrativeType> ;
    rdfs:label "Chief town"@en ;
    rdfs:comment "This individual represents a specific type of administrative reference that characterizes an old town, that is the chief town."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/CollectingLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Collecting location"@en ;
    owl:versionInfo "unstable"@en .

<https://w3id.org/arco/ontology/location/CurrentPhysicalLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Current Physical Location"@en ;
    rdfs:comment "This individual represents a specific type of localization, that is the current physical location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/ExhibitionLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Exhibition Location"@en ;
    rdfs:comment "This individual represents a specific type of localization, that is the exhibition location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/ExtraurbanContext> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/TypeOfContext> ;
    rdfs:label "Extra-urban context"@en ;
    rdfs:comment "This individual represents a specific type of context, that is the extra-urban context where the cultural property is located."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "ustable"@en .

<https://w3id.org/arco/ontology/location/FindingLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Finding Location"@en ;
    rdfs:comment "This individual represents a specific type of localization, that is the finding location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/HistoricalLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Historical Location"@en ;
    rdfs:comment "This individual represents a specific type of localization, that is the historical location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/IncorporatedArea> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/OldTownAdmistrativeType> ;
    rdfs:label "Incorporated area"@en ;
    rdfs:comment "This individual represents a specific type of administrative reference that characterizes the old town, that is the denomination of 'incorporated area'."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/LandCadastre> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/CadastreType> .

<https://w3id.org/arco/ontology/location/LastLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Place of Origin / Last Location"@en ;
    rdfs:comment "Replaced by https://w3id.org/arco/ontology/location/PreviousLocation"@en,
        "This individual represents a specific type of location, that is the place of origin or last location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:deprecated true ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/Locality> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/OldTownAdmistrativeType> ;
    rdfs:label "Locality"@en ;
    rdfs:comment "This individual represents a specific type of administrative reference that characterizes the old town, that is the locality."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/NeighbouringCadastralEntity> a owl:Class ;
    rdfs:label "Neighbouring cadastral entity"@en ;
    rdfs:comment "This class represents spatial entities (i.e. roads, waterways, etc.) that border one or more cadastral parcels."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/location/CadastralEntity> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CS/CTE. - CS/CTS/CTSE. - LC/CSS/CSSE" .

<https://w3id.org/arco/ontology/location/ObservationLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Observation Location"@en ;
    rdfs:comment "This individual represents a specific type of location, that is the location of observation."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/PreviousLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Place of Origin / Previous Location"@en ;
    rdfs:comment "This individual represents a specific type of location, that is the place of origin or previous location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/ProductionRealizationLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Production or Realization Location"@en ;
    rdfs:comment "This individual represents a specific type of location, that is the production or realization location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/ShootingLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Shooting Location"@en ;
    rdfs:comment "This individual represents a specific type of localization, that is the shooting location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/StorageLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Storage Location"@en ;
    rdfs:comment "This individual represents a specific type of localization, that is the storage location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/SubjectLocation> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:label "Subject Location"@en ;
    rdfs:comment "This individual represents a specific type of localization, that is the subject location."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/SuburbanContext> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/TypeOfContext> ;
    rdfs:label "Suburban context"@en ;
    rdfs:comment "This individual represents a specific type of geographical context, that is a suburban context, which is located in the intermediate area between the urban and extraurban context."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/TerritorialContext> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/TypeOfContext> ;
    rdfs:label "Territorial context"@en ;
    rdfs:comment "This individual represents a specific type of context, i.e. the territorial context where the cultural property is located."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/TownFraction> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/OldTownAdmistrativeType> ;
    rdfs:label "Town fraction"@en ;
    rdfs:comment "This individual represents a specific type of administrative reference that characterizes the old town, i.e. the town fraction."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/UnderwaterContext> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/TypeOfContext> ;
    rdfs:label "Underwater context"@en ;
    rdfs:comment "This individual represents a specific type of context, that is the underwater context where the cultural property is located."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/UrbanContext> a owl:NamedIndividual,
        <https://w3id.org/arco/ontology/location/TypeOfContext> ;
    rdfs:label "Urban context"@en ;
    rdfs:comment "This individual represents a specific type of context, that is the urban context where the cultural asset is located."@en ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/administrativeOrderNumber> a owl:DatatypeProperty ;
    rdfs:label "Administrative order number"@en ;
    rdfs:comment "This property associates the order number that identifies a location intended as an administrative unit, i.e. an old town, an urban area and a sector."@en ;
    rdfs:domain <https://w3id.org/italia/onto/CLV/AdministrativeUnitComponent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/cadastreName> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "cadastre name"@en ;
    rdfs:comment "This property represents the designation of a historical cadastre."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/CadastralIdentity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/name> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: LS/CSS/CSSD" .

<https://w3id.org/arco/ontology/location/culturalInstituteOrSiteIdentifier> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "cultural institute or site identifier"@en ;
    rdfs:comment "This property allows to associate a legal container to its code assigned by the ICCD."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalInstituteOrSite> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/districtNumber> a owl:DatatypeProperty ;
    rdfs:label "District number"@en ;
    rdfs:comment "This property represents the progressive number that identifies the district where the cultural property is located."@en ;
    rdfs:domain <https://w3id.org/italia/onto/CLV/District> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasBaseMap> a owl:ObjectProperty ;
    rdfs:label "has base map"@en ;
    rdfs:comment "This property links an object georeferencing to the base map possibly used."@en ;
    rdfs:domain <https://w3id.org/italia/onto/CLV/Geometry> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/BaseMap> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isBaseMapOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasCadastralIdentity> a owl:ObjectProperty ;
    rdfs:label "has cadastral identity"@en ;
    rdfs:comment "This property links a cultural property to all its cadastral information related to one of its locations: i.e. historical location, current location, finding location, etc."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/CadastralIdentity> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isCadastralIdentityOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CS. - Normativa RA v.2: RP/LGC" .

<https://w3id.org/arco/ontology/location/hasClericalAdministrativeArea> a owl:ObjectProperty ;
    rdfs:label "has clerical administrative area"@en ;
    rdfs:comment "This property relates an address to a clerical administrative area (e.g. a diocese)."@en ;
    rdfs:domain <https://w3id.org/italia/onto/CLV/Address> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/ClericalAdministrativeArea> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/CLV/hasAddressComponent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isClericalAdministrativeAreaOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: LC/PVE; LA/PRE" .

<https://w3id.org/arco/ontology/location/hasContinent> a owl:ObjectProperty ;
    rdfs:label "has continent"@en ;
    rdfs:comment "This property links the location of an entity to the continent where it is located."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/Continent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isContinentOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasCulturalInstituteOrSite> a owl:ObjectProperty ;
    rdfs:label "has cultural institute or site"@en ;
    rdfs:comment "",
        "This property links a cultural property to the cultural institute or site"@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalInstituteOrSite> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isCulturalInstituteOrSiteOf> ;
    owl:versionInfo "unstable"@en .

<https://w3id.org/arco/ontology/location/hasCulturalInstituteOrSiteDefinition> a owl:ObjectProperty ;
    rdfs:label "has cultiral institute or site definition"@en ;
    rdfs:comment "This property links the type of a cultural institute or site to one of its components, that is to the definition of its type."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/CulturalInstituteOrSiteType> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/CulturalInstituteOrSiteDefinition> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isCulturalInstituteOrSiteDefinitionOf> ;
    owl:versionInfo "unstable"@en .

<https://w3id.org/arco/ontology/location/hasCulturalInstituteOrSiteSpecification> a owl:ObjectProperty ;
    rdfs:label "has cultural institute or site specification"@en ;
    rdfs:comment "This property links the type of a cultural institute or site to one of its components, that is to the specifications of its type."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/CulturalInstituteOrSiteType> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/CulturalInstituteOrSiteSpecification> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isCulturalInstituteOrSiteSpecificationOf> ;
    owl:versionInfo "unstable"@en .

<https://w3id.org/arco/ontology/location/hasCulturalInstituteOrSiteType> a owl:ObjectProperty ;
    rdfs:label "has cultural institute or site type"@en ;
    rdfs:comment "This property connects a Cultural institute or site to its type, to allow its correct and precise identification."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalInstituteOrSite> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/CulturalInstituteOrSiteType> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasType> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isCulturalInstituteOrSiteTypeof> ;
    owl:versionInfo "unstable"@en .

<https://w3id.org/arco/ontology/location/hasCulturalPropertyAddress> a owl:ObjectProperty ;
    rdfs:label "cultural property address"@en ;
    rdfs:comment "This property represents the relationship that links a cultural property to the address of its current physical location at the cataloging time. The report provides a simplified representation, with a reduced expressivity, of the current location of the cultural property, and it causes the loss of other information regarding its location (i.e. the continent, the possible physical container, the specific location in the physical container, etc.)."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/CLV/Address> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isCulturalPropertyAddressOf> ;
    owl:propertyChainAxiom ( <https://w3id.org/arco/ontology/location/hasTimeIndexedTypedLocation> <https://w3id.org/arco/ontology/location/atLocation> <https://w3id.org/italia/onto/CLV/hasAddress> ),
        ( <https://w3id.org/arco/ontology/location/hasTimeIndexedTypedLocation> <https://w3id.org/arco/ontology/location/atSite> <https://w3id.org/italia/onto/CLV/hasAddress> ) ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasGeometryMethod> a owl:ObjectProperty ;
    rdfs:label "has geometry method"@en ;
    rdfs:comment "This property links a georeferencing to the method used for the object positioning."@en ;
    rdfs:domain <https://w3id.org/italia/onto/CLV/Geometry> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/GeometryMethod> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isGeometryMethodOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasGeometryTechnique> a owl:ObjectProperty ;
    rdfs:label "has geometry technique"@en ;
    rdfs:comment "This property links a georeferencing to the georeferencing technique."@en ;
    rdfs:domain <https://w3id.org/italia/onto/CLV/Geometry> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/GeometryTechnique> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isGeometryTechniqueOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasGovernmentalAdministrativeArea> a owl:ObjectProperty ;
    rdfs:label "has governamental administrative area"@en ;
    rdfs:comment "This property links an address to a governmental administrative area."@en ;
    rdfs:domain <https://w3id.org/italia/onto/CLV/Address> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/GovernamentalAdministrativeArea> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/CLV/hasAddressComponent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isGovernmentalAdministrativeAreaOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: LS/LCS/LCSA; LA/PRT/PRTR" .

<https://w3id.org/arco/ontology/location/hasHistoricalArea> a owl:ObjectProperty ;
    rdfs:label "has historical area"@en ;
    rdfs:comment "This property links an address to a historical-geographical area."@en ;
    rdfs:domain <https://w3id.org/italia/onto/CLV/Address> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/CLV/AdministrativeUnitComponent> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/CLV/hasAddressComponent> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isHistoricalAreaOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasSiteType> a owl:ObjectProperty ;
    rdfs:label "has site type"@en ;
    rdfs:comment "This property connects a physical container (Site) to its type, to allow its correct and precise identification."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/Site> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/SiteType> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasType> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isSiteTypeOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasStratigraphicArea> a owl:ObjectProperty ;
    rdfs:label "has stratigraphic area"@en ;
    rdfs:comment "This property relates a stratigraphic record to the area in which it took place."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/l0/Location> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasLocation> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isStratigraphicAreaOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa SAS: OG/OGT/OGTX" .

