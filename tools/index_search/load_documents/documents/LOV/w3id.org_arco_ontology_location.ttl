<https://w3id.org/arco/ontology/location/BaseMap> a owl:Class ;
    rdfs:label "Base map"@en ;
    rdfs:comment "This class represents the base map possibly used for georeferencing activities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isBaseMapOf> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/CLV/Geometry> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/italia/onto/TI/date> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/Continent> a owl:Class ;
    rdfs:label "Continent"@en ;
    rdfs:comment "This class represents a Continent."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isContinentOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/italia/onto/CLV/AdministrativeUnitComponent> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/CulturalInstituteOrSiteDefinition> a owl:Class ;
    rdfs:label "Cultural Institute or Site Definition"@en ;
    rdfs:comment "This class represents the type definition of a cultural insititute or site."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "unstable"@en .

<https://w3id.org/arco/ontology/location/CulturalInstituteOrSiteSpecification> a owl:Class ;
    rdfs:label "Cultural Institute or Site Specification"@en ;
    rdfs:comment "This class represents the type specification of a cultural insititute or site."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "unstable"@en .

<https://w3id.org/arco/ontology/location/GeometryMethod> a owl:Class ;
    rdfs:label "Geometry method"@en ;
    rdfs:comment "This class represents the method used for the object positioning (i.e. exact, approximate, with a symbolic representation)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isGeometryMethodOf> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/CLV/Geometry> ],
        <https://w3id.org/arco/ontology/core/Method> ;
    owl:disjointWith <https://w3id.org/arco/ontology/location/GeometryTechnique> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/ToponymInTime> a owl:Class ;
    rdfs:label "Toponym in time"@en ;
    rdfs:comment "This class represents other place's designations changing over time."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/TI/TimeInterval> ;
            owl:onProperty <https://w3id.org/italia/onto/TI/atTime> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/onto/l0/name> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isToponymInTimeOf> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/CLV/Feature> ],
        <https://w3id.org/arco/ontology/core/TimeIndexedSituation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/atSite> a owl:ObjectProperty ;
    rdfs:label "at site"@en ;
    rdfs:comment "This property links a typified location over time to its physical container (Site)."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/Site> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/location/atLocation> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isSiteIn> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasCadastralEntity> a owl:ObjectProperty ;
    rdfs:label "has cadastral entity"@en ;
    rdfs:comment "This property links a cadastral identity of an entity to one of the cadastral entities, understood as spatial objects, that define it."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/CadastralIdentity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/CadastralEntity> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isCadastralEntityOf> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Traversale 4.00: CS/CTS, CS/CTS/CTSF, CTSN; LS/CSS. LG/LGC" .

<https://w3id.org/arco/ontology/location/hasLocationType> a owl:ObjectProperty ;
    rdfs:label "has referred location type"@en ;
    rdfs:comment "This property links an entity (e.g. a situation in which a place plays a certain role in relation to a cultural property in a time frame, or a georeferencing, or a cadastral identity) to the role of the localization referring to it (i.e current physical location, previous location, finding location, etc.)."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasType> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isLocationTypeOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/hasTimeIndexedTypedLocation> a owl:ObjectProperty ;
    rdfs:label "has time indexed typed location"@en ;
    rdfs:comment "This property links an entity to its typified location over time."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isTimeIndexedTypedLocationOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isAltitudeOf> a owl:ObjectProperty ;
    rdfs:label "is altitude of"@en ;
    rdfs:comment "This property links the georeferencing coordinates of the altitude to an object (Geometry)."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/Altitude> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/Coordinates> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isBaseMapOf> a owl:ObjectProperty ;
    rdfs:label "is base map of"@en ;
    rdfs:comment "This property links a base map to an object georeferencing."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/BaseMap> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/CLV/Geometry> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isCadastralIdentityOf> a owl:ObjectProperty ;
    rdfs:label "is cadastral identity of"@en ;
    rdfs:comment "This property links all the cadastral information related to one of its locations: i.e. historical location, current location, finding location, etc., to a cultural property."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/CadastralIdentity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/CulturalEntity> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isCadastreTypeOf> a owl:ObjectProperty ;
    rdfs:label "is cadastre type of"@en ;
    rdfs:comment "This property relates the type of cadastre (e.g. land cadastre, building cadastre, mixed cadastre) to a cadastral identity of an entity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/CadastreType> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/CadastralIdentity> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isTypeOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isClericalAdministrativeAreaOf> a owl:ObjectProperty ;
    rdfs:label "is clerical administrative area of"@en ;
    rdfs:comment "This property relates a clerical administrative area (e.g. a diocese) to its address."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/ClericalAdministrativeArea> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/CLV/Address> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/CLV/isAddressComponentOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isContinentOf> a owl:ObjectProperty ;
    rdfs:label "is continent of"@en ;
    rdfs:comment "This property links the continent to the location of an entity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/Continent> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isGeometryMethodOf> a owl:ObjectProperty ;
    rdfs:label "is geometry method of"@en ;
    rdfs:comment "This property links the method used for the object positioning to the georeferencing."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/GeometryMethod> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/CLV/Geometry> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isGeometryTechniqueOf> a owl:ObjectProperty ;
    rdfs:label "is geometry technique of"@en ;
    rdfs:comment "This property links the georeferencing technique to the georeferencing."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/GeometryTechnique> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/CLV/Geometry> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isGovernmentalAdministrativeAreaOf> a owl:ObjectProperty ;
    rdfs:label "is governmental administrative area of"@en ;
    rdfs:comment "This property links a governmental administrative area to its address."@en ;
    rdfs:domain <http://dati.beniculturali.it/cis/GovernamentalAdministrativeArea> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/CLV/Address> ;
    rdfs:subPropertyOf <https://w3id.org/italia/onto/CLV/isAddressComponentOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isLocationIn> a owl:ObjectProperty ;
    rdfs:label "is location in"@en ;
    rdfs:comment "This property relates a geographical feature to a time indexed typed location that refers to that feature."@en ;
    rdfs:domain <https://w3id.org/italia/onto/CLV/Feature> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isLocationTypeOf> a owl:ObjectProperty ;
    rdfs:label "is referred location type of"@en ;
    rdfs:comment "This property links the role of a localization (i.e current physical location, previous location, finding location, etc.) to an entity referring to it (e.g. a situation in which a place plays a certain role in relation to a cultural property in a time frame, or a georeferencing, or a cadastral identity)."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/LocationType> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isTypeOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isOldTownAdministrativeTypeOf> a owl:ObjectProperty ;
    rdfs:label "is old town administrative type of"@en ;
    rdfs:comment "This property connects the administrative type with the information related to its historical center."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/OldTownAdmistrativeType> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/OldTown> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isTypeOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isSiteDefinitionOf> a owl:ObjectProperty ;
    rdfs:label "is site definition of"@en ;
    rdfs:comment "This property links the definition of a physical container to of its type."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/SiteDefinition> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/SiteType> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isSiteSpecificationOf> a owl:ObjectProperty ;
    rdfs:label "is site specification of"@en ;
    rdfs:comment "This property links the specification of a physical container to one of its type."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/SiteSpecification> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/SiteType> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isSiteTypeOf> a owl:ObjectProperty ;
    rdfs:label "is site type of"@en ;
    rdfs:comment "This property connects the type of physical container to a physical container (Site), to allow its correct and precise identification."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/SiteType> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <http://dati.beniculturali.it/cis/Site> ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isTypeOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isTimeIndexedTypedLocationOf> a owl:ObjectProperty ;
    rdfs:label "is time indexed typed location of"@en ;
    rdfs:comment "This property links a typified location over time to an entity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isToponymInTimeOf> a owl:ObjectProperty ;
    rdfs:label "is toponym in time of"@en ;
    rdfs:comment "This property relates a toponym chianging over time to a geographical entity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/ToponymInTime> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/CLV/Feature> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isTypeOfContextOf> a owl:ObjectProperty ;
    rdfs:label "is type of geographical context of"@en ;
    rdfs:comment "This property relates the type of context (i.e. urban context, suburban context, extra-urban context, territorial context, underwater context) an entity where it is located."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/TypeOfContext> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isConceptOf> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/CLV/District> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasTypeOfContext> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/TypeOfContext> ],
        <https://w3id.org/italia/onto/CLV/AdministrativeUnitComponent> .

<https://w3id.org/italia/onto/CLV/hasAddress> a owl:ObjectProperty .

<https://w3id.org/italia/onto/TI/TimeInterval> a owl:Class .

<https://w3id.org/italia/onto/TI/atTime> a owl:ObjectProperty .

<https://w3id.org/italia/onto/TI/time> a owl:DatatypeProperty .

<https://w3id.org/italia/onto/l0/Object> a owl:Class .

<https://w3id.org/italia/onto/l0/name> a owl:DatatypeProperty .

<https://w3id.org/arco/ontology/core/hasLocation> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/isLocationOf> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/location/GeometryTechnique> a owl:Class ;
    rdfs:label "Geometry technique"@en ;
    rdfs:comment "This class represents the technique of georeferencing, used for the acquisition of coordinates (i.e. survey from cartography with or without inspection, survey from aerial photos with or without inspection, satellite survey, traditional survey, survey via GPS, etc.)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isGeometryTechniqueOf> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/CLV/Geometry> ],
        <https://w3id.org/arco/ontology/core/Method> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/SiteDefinition> a owl:Class ;
    rdfs:label "Site Definition"@en ;
    rdfs:comment "This class represents the type definition of a physical container."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isSiteDefinitionOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/SiteType> ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/SiteSpecification> a owl:Class ;
    rdfs:label "Site Specification"@en ;
    rdfs:comment "This class represents specifications about the physical container, i.e. the adjective or the phrase that with respect to the Site Definition specifies, integrates or characterizes the physical container from the point of view of the legal-administrative or functional condition."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isSiteSpecificationOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/SiteType> ],
        <https://w3id.org/italia/onto/l0/Description> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/UrbanArea> a owl:Class ;
    rdfs:label "Urban area"@en ;
    rdfs:comment "This class represents the informations on the denomination of the urban area that is part of the old town where the cultural property is located."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/italia/onto/CLV/AdministrativeUnitComponent> ;
    owl:disjointWith <https://w3id.org/italia/onto/CLV/District> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/atLocation> a owl:ObjectProperty ;
    rdfs:label "at location"@en ;
    rdfs:comment "This property links a typed location over time to its related geographical entity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/italia/onto/CLV/Feature> ;
    owl:inverseOf <https://w3id.org/arco/ontology/location/isLocationIn> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/isCadastralEntityOf> a owl:ObjectProperty ;
    rdfs:label "is cadastral entity of"@en ;
    rdfs:comment "This property links a cadastral entity, understood as spatial object, to its cadastral identity."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/CadastralEntity> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range <https://w3id.org/arco/ontology/location/CadastralIdentity> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/CLV/SpatialObject> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/l0/Location> .

<https://w3id.org/arco/ontology/location/alt> a owl:DatatypeProperty ;
    rdfs:label "altitude"@en ;
    rdfs:comment "This property represents the z coordinate of an object, which defines its altitude above sea level."@en ;
    rdfs:domain <https://w3id.org/arco/ontology/location/Altitude> ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/CLV/City> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/CLV/AdministrativeUnitComponent> .

<https://w3id.org/italia/onto/l0/Description> a owl:Class .

<https://w3id.org/italia/onto/l0/identifier> a owl:DatatypeProperty .

<http://dati.beniculturali.it/cis/CulturalInstituteOrSite> a owl:Class .

<https://w3id.org/arco/ontology/core/Type> a owl:Class .

<https://w3id.org/arco/ontology/core/hasType> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/core/isTypeOf> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/location/OldTown> a owl:Class ;
    rdfs:label "Old town"@en ;
    rdfs:comment "This class represents the information describing the old town where the cultural property is located."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/location/OldTownAdmistrativeType> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasOldTownAdministrativeType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/location/UrbanArea> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasUrbanArea> ],
        <https://w3id.org/italia/onto/CLV/City> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/CLV/hasAddressComponent> a owl:ObjectProperty .

<https://w3id.org/italia/onto/CLV/isAddressComponentOf> a owl:ObjectProperty .

<https://w3id.org/arco/ontology/location/CadastralEntity> a owl:Class ;
    rdfs:label "Cadastral Entity"@en ;
    rdfs:comment "This class represents a cadastral entity, which is intended as an object that can have a spatial representation related to the cadastral allocation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/location/CadastralIdentity> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isCadastralEntityOf> ],
        <https://w3id.org/italia/onto/CLV/SpatialObject> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/CadastreType> a owl:Class ;
    rdfs:label "Cadastre type"@en ;
    rdfs:comment "This class represents the type of cadastre (e.g. land cadastre, building cadastre, mixed cadastre)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isCadastreTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/CadastralIdentity> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CS/CTS/CTST" .

<https://w3id.org/arco/ontology/location/CulturalInstituteOrSiteType> a owl:Class ;
    rdfs:label "Cultural Institute or Site type"@en ;
    rdfs:comment "This class represents the type of a cultural insititute or site."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "unstable"@en .

<http://dati.beniculturali.it/cis/Site> a owl:Class .

<https://w3id.org/arco/ontology/location/Altitude> a owl:Class ;
    rdfs:label "Altitude"@en ;
    rdfs:comment "This class represents the altitude, that is the height of an object above the sea level, which can be specified as maximum, minimum and relative altitude."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/alt> ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isAltitudeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/Coordinates> ],
        <https://w3id.org/italia/onto/l0/Characteristic> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/Coordinates> a owl:Class ;
    rdfs:label "Coordinates"@en ;
    rdfs:comment "This class represents the set of coordinates, geographic or projected, which allows the georeferencing of an object. For the punctual georeferencing there is only a pair of coordinates. For the linear and areal georeferencing there are more pairs of coordinates identifying those points of the line or area representing the object."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/location/Altitude> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasAltitude> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/location/long> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/arco/ontology/location/lat> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/areCoordinatesOf> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/CLV/Geometry> ],
        <https://w3id.org/italia/onto/CLV/Geometry>,
        <https://w3id.org/italia/onto/l0/Collection> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/OldTownAdmistrativeType> a owl:Class ;
    rdfs:label "Old town administrative type"@en ;
    rdfs:comment "This class represents the information clarifying the administrative character of the old town, which may be: a chief town, a town fraction, an incorporated area or a locality."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isOldTownAdministrativeTypeOf> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/OldTown> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/TimeIndexedTypedLocation> a owl:Class ;
    rdfs:label "Time Indexed Typed Location"@en ;
    dc:description "An example of usage of the class 'Time Indexed Typed Location' is the following:\\nresource:TimeIndexedTypedLocation/0800055566-alternative-1\\n        a  a-loc:TimeIndexedTypedLocation ;\\n        rdfs:label \"Alternative location 1 of cultural property: 0800055566\"@en ;  a-loc:atSite  resource:Site/7761991208459c29ef5c7cee8ff29deb ;\\n        a-loc:hasLocationType a-loc:LastLocation ;\\n        tiapit:atTime resource:TimeInterval/2002 ."@en ;
    rdfs:comment "This class represents a localization of a cultural property, within a timeframe and qualified according to the role that the localization plays in relation to the cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/TI/TimeInterval> ;
            owl:onProperty <https://w3id.org/italia/onto/TI/atTime> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasLocationType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/LocationType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/italia/onto/CLV/Feature> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/atLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://dati.beniculturali.it/cis/Site> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/atSite> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isTimeIndexedTypedLocationOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/arco/ontology/core/TimeIndexedSituation> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/l0/Location> a owl:Class .

<https://w3id.org/arco/ontology/location/SiteType> a owl:Class ;
    rdfs:label "Site Type"@en ;
    rdfs:comment "This class represents the type of a physical container, i.e. it contains adjectives or phrases that specify, integrate or characterize the physical container from the point of view of the legal-administrative or functional condition."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/arco/ontology/location/SiteSpecification> ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasSiteSpecification> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isSiteTypeOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/Site> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasSiteDefinition> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/SiteDefinition> ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/arco/ontology/location/TypeOfContext> a owl:Class ;
    rdfs:label "Type of geographic context"@en ;
    rdfs:comment "This class represents the type of geographical context where the cultural property is located: i.e. urban, suburban, extra-urban, territorial, underwater."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isTypeOfContextOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/arco/ontology/core/Concept> ;
    owl:versionInfo "stable"@en .

<https://w3id.org/italia/onto/CLV/Feature> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/CLV/SpatialObject> .

<http://dati.beniculturali.it/cis/CulturalEntity> a owl:Class .

<https://w3id.org/arco/ontology/location/CadastralIdentity> a owl:Class ;
    rdfs:label "Cadastral identity"@en ;
    dc:description "An example of usage of the class 'Cadastral Identity' is the following:\\nresource:CadastralIdentity/1400055239-1\\n        a a-loc:CadastralIdentity ;\\n        rdfs:label  \"Cadastral identity 1 of cultural property: 1400055239\"@en ;\\n        a-cd:hasLegalSituation resource:LegalSituation/1400055239-cadastral-legal-situation-1 ;\\n        a-loc:hasCadastralCity resource:City/s-martino-in-pensilis ;\\n        a-loc:hasCadastralEntity resource:CadastralUnitCollection/1400055239-207 , resource:CadastralFolio/1400055239-8 ."@en ;
    rdfs:comment "This class represents the cadastral identity of an entity, which is intended as a set of location information concerning the property with reference to the national cadastral allocation. The cadastral identity can have a chronological reference indicating the dating of cadastral data."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasLocationType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/LocationType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasCadastralEntity> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/CadastralEntity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty <https://w3id.org/italia/onto/TI/time> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasCadastreType> ;
            owl:someValuesFrom <https://w3id.org/arco/ontology/location/CadastreType> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isCadastralIdentityOf> ;
            owl:someValuesFrom <http://dati.beniculturali.it/cis/CulturalEntity> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/hasCadastralCity> ;
            owl:someValuesFrom <https://w3id.org/italia/onto/CLV/City> ],
        <https://w3id.org/italia/onto/l0/Object> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale 4.00: CS. - Normativa RA v.2: RP/LGC" .

<https://w3id.org/italia/onto/CLV/AdministrativeUnitComponent> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/CLV/Feature> .

<https://w3id.org/italia/onto/CLV/Address> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/CLV/Feature> .

<https://w3id.org/italia/onto/CLV/Geometry> a owl:Class ;
    rdfs:subClassOf <https://w3id.org/italia/onto/CLV/SpatialObject> .

<https://w3id.org/arco/ontology/location/LocationType> a owl:Class ;
    rdfs:label "Location Type"@en ;
    rdfs:comment "This class represents the type of location of a cultural property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/arco/ontology/location/isLocationTypeOf> ;
            owl:someValuesFrom owl:Thing ],
        <https://w3id.org/arco/ontology/core/Type> ;
    owl:versionInfo "stable"@en ;
    ns1:iccdNormTag "ICCD Normativa Trasversale: LA/TLC; LA/TCL; LC (CurrentPhysicalLocation) - Normativa F: anche LR (ShotLocation). - CS/CTL. - GE/GEL; GP/GPL; GL/GLL; GA/GAL" .

onto: a owl:Ontology ;
    rdfs:label "Location Ontology (ArCo network)"@en ;
    ns2:reusesPatternAsTemplate <http://ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/classification.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl>,
        <http://www.ontologydesignpatterns.org/cp/owl/place.owl#>,
        <http://www.ontologydesignpatterns.org/cp/owl/situation.owl> ;
    dc:creator "Aldo Gangemi (ISTC-CNR, STLab)",
        "Andrea Nuzzolese (ISTC-CNR, STLab)",
        "Chiara Veninata (MiBAC, ICCD)",
        "Ludovica Marinucci (ISTC-CNR, STLab)",
        "Luigi Asprino (ISTC-CNR, STLab)",
        "Margherita Porena (ISTC-CNR, STLab)",
        "Marialetizia Mancinelli (MiBAC, ICCD)",
        "Valentina Carriero (ISTC-CNR, STLab)",
        "Valentina Presutti (ISTC-CNR, STLab)" ;
    dc:language <http://publications.europa.eu/resource/authority/language/ENG>,
        <http://publications.europa.eu/resource/authority/language/ITA> ;
    dc:title "Location Ontology (ArCo network)"@en ;
    dcterms:issued "2018-03-07" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/>,
        <https://w3id.org/italia/controlled-vocabulary/licences/A31_CCBYSA40> ;
    dcterms:modified "2020-03-27" ;
    rdfs:comment "The module Location models information related to the localization and georeferencing of a cultural property.\\nIn this module the following Ontology Design Patterns have been used:\\n- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/classification.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/place.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl\\n- http://www.ontologydesignpatterns.org/cp/owl/situation.owl"@en ;
    owl:imports <https://w3id.org/arco/ontology/core/1.2> ;
    owl:versionIRI <https://w3id.org/arco/ontology/location/1.2> ;
    owl:versionInfo "Version 1.2" .

