@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#> .
@prefix ns2: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#> .
@prefix ns3: <http://semanticscience.org/resource/> .
@prefix ns4: <http://creativecommons.org/ns#> .
@prefix ns5: <http://protege.stanford.edu/plugins/owl/protege#> .
