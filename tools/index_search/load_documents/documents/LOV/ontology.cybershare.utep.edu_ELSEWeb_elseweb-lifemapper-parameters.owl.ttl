@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ANN> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "ANN"^^xsd:string ;
    ns1:hasAlgorithmName "Artificial Neural Network"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ATT_MAXENT> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "ATT_MAXENT"^^xsd:string ;
    ns1:hasAlgorithmName "Maximum Entropy - ATT Implementation"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Artificial-Neural-Network_parameters> a owl:Class ;
    rdfs:label "artificial neuronal network parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Choice> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Epoch> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#HiddenLayerNeurons> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#LearningRate> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MinimumError> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Momentum> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#BIOCLIM> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "BIOCLIM"^^xsd:string ;
    ns1:hasAlgorithmName "Bioclim"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Bioclim_parameters> a owl:Class ;
    rdfs:label "bioclim parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#StandardDeviationCutoff> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#CSMBS> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "CSMBS"^^xsd:string ;
    ns1:hasAlgorithmName "Climate Space Model"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Climate-Space-Model_parameters> a owl:Class ;
    rdfs:label "climate space model parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MinComponents> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Randomisations> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#StandardDeviations> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#VerboseDebugging> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#DG_GARP> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "DG_GARP"^^xsd:string ;
    ns1:hasAlgorithmName "GARP - DesktopGARP implementation"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#DG_GARP_BS> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "DG_GARP_BS"^^xsd:string ;
    ns1:hasAlgorithmName "GARP with Best Subsets - DesktopGARP implementation"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ENVDIST> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "ENVDIST"^^xsd:string ;
    ns1:hasAlgorithmName "Environmental Distance"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Environmental-Distance_parameters> a owl:Class ;
    rdfs:label "environmental distance parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#DistanceType> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MaxDistance> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#NearestPoints> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#GARP> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "GARP"^^xsd:string ;
    ns1:hasAlgorithmName "GARP"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#GARP---DesktopGARP-implementation_parameters> a owl:Class ;
    rdfs:label "garp desktop garp implementation parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ConvergenceLimit> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MaxGenerations> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#PopulationSize> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Resamples> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#GARP-with-Best-Subsets---DesktopGARP-implementation_parameters> a owl:Class ;
    rdfs:label "garp with best subsets desktop garp implementation parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#CommissionSampleSize> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#CommissionThreshold> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ConvergenceLimit> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#HardOmissionThreshold> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MaxGenerations> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MaxThreads> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ModelsUnderOmissionThreshold> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#PopulationSize> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Resamples> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#TotalRuns> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#TrainingProportion> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#GARP-with-Best-Subsets_parameters> a owl:Class ;
    rdfs:label "garp with best subsets parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#CommissionSampleSize> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#CommissionThreshold> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ConvergenceLimit> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#HardOmissionThreshold> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MaxGenerations> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MaxThreads> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ModelsUnderOmissionThreshold> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#PopulationSize> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Resamples> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#TotalRuns> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#TrainingProportion> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#GARP_BS> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "GARP_BS"^^xsd:string ;
    ns1:hasAlgorithmName "GARP with Best Subsets"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#GARP_parameters> a owl:Class ;
    rdfs:label "garp parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ConvergenceLimit> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MaxGenerations> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#PopulationSize> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Resamples> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Maximum-Entropy---ATT-Implementation_parameters> a owl:Class ;
    rdfs:label "maximum entropy att implementation parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Maximum-Entropy---openModeller-Implementation_parameters> a owl:Class ;
    rdfs:label "maximum entropy openmodeller implementation parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#AutoFeatures> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#HingeFeatures> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#IncludePresencePointsInBackground> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MinSamplesForHinge> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MinSamplesForProductThreshold> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#MinSamplesForQuadratic> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#NumberOfBackgroundPoints> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#NumberOfIterations> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#OutputFormat> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ProductFeatures> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#QuadraticFeatures> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#TerminateTolerance> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ThresholdFeatures> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#UseAbsencesAsBackground> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#OM_MAXENT> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "OM_MAXENT"^^xsd:string ;
    ns1:hasAlgorithmName "Maximum Entropy - openModeller Implementation"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#SVM> a ns2:LifemapperAlgorithm,
        owl:NamedIndividual ;
    ns2:hasAlgorithmCode "SVM"^^xsd:string ;
    ns1:hasAlgorithmName "Support Vector Machines"^^xsd:string .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Support-Vector-Machines_parameters> a owl:Class ;
    rdfs:label "support vector machines parameters" ;
    rdfs:subClassOf ns2:LifemapperParameters ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#C> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Coef0> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Degree> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Gamma> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#KernelType> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#Nu> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#NumberOfPseudoAbsences> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#ProbabilisticOutput> ] [ a owl:Restriction ;
                        owl:onProperty ns1:hasParameterMember ;
                        owl:someValuesFrom <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#SvmType> ] ) ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#adjustsampleradius> a owl:Class ;
    rdfs:label "adjust sample radius" ;
    rdfs:subClassOf ns2:LifemapperParameter ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onDataRange [ a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ;
            owl:onProperty ns1:boundToValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:hasValue "adjustsampleradius"^^xsd:string ;
            owl:onProperty ns1:hasParameterName ],
        [ a owl:Restriction ;
            owl:hasValue 0 ;
            owl:onProperty ns2:hasDefaultValue ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#appendtoresultsfile> a owl:Class ;
    rdfs:label "append to results file" ;
    rdfs:subClassOf ns2:LifemapperParameter ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue "appendtoresultsfile"^^xsd:string ;
            owl:onProperty ns1:hasParameterName ],
        [ a owl:Restriction ;
            owl:hasValue 0 ;
            owl:onProperty ns2:hasDefaultValue ],
        [ a owl:Restriction ;
            owl:onDataRange [ a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 1 ] ) ] ;
            owl:onProperty ns1:boundToValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#autofeature> a owl:Class ;
    rdfs:label "autofeature" ;
    rdfs:subClassOf ns2:LifemapperParameter ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue "autofeature"^^xsd:string ;
            owl:onProperty ns1:hasParameterName ],
        [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty ns2:hasDefaultValue ],
        [ a owl:Restriction ;
            owl:onDataRange [ a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions ( [ xsd:minInclusive 0 ] [ xsd:maxInclusive 1 ] ) ] ;
            owl:onProperty ns1:boundToValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#beta_categorical> a owl:Class ;
    rdfs:label "beta categorical" ;
    rdfs:subClassOf ns2:LifemapperParameter ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue "-1.0"^^xsd:float ;
            owl:onProperty ns2:hasDefaultValue ],
        [ a owl:Restriction ;
            owl:hasValue "beta_categorical"^^xsd:string ;
            owl:onProperty ns1:hasParameterName ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#beta_hinge> a owl:Class ;
    rdfs:label "beta hinge" ;
    rdfs:subClassOf ns2:LifemapperParameter ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue "beta_hinge"^^xsd:string ;
            owl:onProperty ns1:hasParameterName ],
        [ a owl:Restriction ;
            owl:hasValue "-1.0"^^xsd:float ;
            owl:onProperty ns2:hasDefaultValue ] .

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#beta_lqp> a owl:Class ;
    rdfs:label "beta lqp" ;
    rdfs:subClassOf ns2:LifemapperParameter ;
