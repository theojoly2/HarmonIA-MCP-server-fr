ns2:LifemapperAlgorithm a owl:Class ;
    rdfs:label "lifemapper algorithm"^^xsd:string ;
    ns3:example "ANN"^^xsd:string ;
    rdfs:comment "A species distribution modelling algorithm implemented in a service offered by Lifemapper."^^xsd:string .

ns2:LifemapperParameters a owl:Class ;
    rdfs:label "lifemapper parameters"^^xsd:string ;
    ns3:comment "A set of parameters required as an input to a specific modelling algorithm offered as a Web service by Lifemapper."^^xsd:string ;
    ns3:example "The set of parameters needed by the ANN algorithm."^^xsd:string .

ns1:hasParameterMember a owl:ObjectProperty ;
    rdfs:label "has parameter member" .

ns1:boundToValue a owl:DatatypeProperty ;
    rdfs:label "bound to value" .

ns2:LifemapperParameter a owl:Class ;
    rdfs:label "lifemapper parameter"^^xsd:string ;
    ns3:comment "An input parameter required to run an algorithm provided by Lifemapper in a web service."^^xsd:string .

ns2:hasDefaultValue a owl:DatatypeProperty ;
    rdfs:label "has default value" .

ns1:hasParameterName a owl:DatatypeProperty ;
    rdfs:label "has parameter name" .

