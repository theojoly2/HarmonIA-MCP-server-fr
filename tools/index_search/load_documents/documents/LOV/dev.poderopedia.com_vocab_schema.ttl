@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix onto: <http://dev.poderopedia.com/vocab/schema> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://dev.poderopedia.com/vocab/WorkRole> a rdfs:Class,
        owl:Class ;
    rdfs:label "Work role"@en .

<http://dev.poderopedia.com/vocab/Acquaintance> rdfs:label "Acquaintance"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SocialConnection> .

<http://dev.poderopedia.com/vocab/AlumniEducationalConnection> a owl:Class ;
    rdfs:label "Alumni"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/EducationalConnection> .

<http://dev.poderopedia.com/vocab/CivilUnion> a owl:Class ;
    rdfs:label "Civil union"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SentimentalRelationshipConnection> .

<http://dev.poderopedia.com/vocab/Classmate> rdfs:label "Classmate"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SocialConnection> .

<http://dev.poderopedia.com/vocab/Dating> a owl:Class ;
    rdfs:label "Dating"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SentimentalRelationshipConnection> .

<http://dev.poderopedia.com/vocab/DomesticPartnership> a owl:Class ;
    rdfs:label "Domestic partnership"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SentimentalRelationshipConnection> .

<http://dev.poderopedia.com/vocab/FinancierAssociationConnection> rdfs:label "Financier"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/AssociationConnection> .

<http://dev.poderopedia.com/vocab/Friendship> rdfs:label "Friendship"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SocialConnection> .

<http://dev.poderopedia.com/vocab/GraduateEducationalConnection> a owl:Class ;
    rdfs:label "Graduate"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/EducationalConnection> .

<http://dev.poderopedia.com/vocab/InternationalOrganization> a owl:Class ;
    rdfs:label "International Organization"@en ;
    rdfs:comment "An international organization, like UN, UNESCO, etc."@en ;
    rdfs:subClassOf foaf:Organization .

<http://dev.poderopedia.com/vocab/Marriage> a owl:Class ;
    rdfs:label "Marriage"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SentimentalRelationshipConnection> .

<http://dev.poderopedia.com/vocab/MembershipAssociationConnection> rdfs:label "Member"@en ;
    rdfs:comment "Official member of an organization (social club, religious group, etc.)"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/AssociationConnection> .

<http://dev.poderopedia.com/vocab/OtherAssociationConnection> rdfs:label "Other"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/AssociationConnection> .

<http://dev.poderopedia.com/vocab/ProgrammaticOrganization> a owl:Class ;
    rdfs:label "Programmatic Organization"@en ;
    rdfs:comment "An programmatic organization, like think tanks."@en ;
    rdfs:subClassOf foaf:Organization .

<http://dev.poderopedia.com/vocab/ReligiousOrganization> a owl:Class ;
    rdfs:label "Religious Organization"@en ;
    rdfs:comment "An religious organization, like Opus Dei, Catholic church, etc."@en ;
    rdfs:subClassOf foaf:Organization .

<http://dev.poderopedia.com/vocab/RestrictedAccessOrganization> a owl:Class ;
    rdfs:label "Restricted access organization"@en ;
    rdfs:comment "A restricted access organization, like social clubs, golf clubs, etc."@en ;
    rdfs:subClassOf foaf:Organization .

<http://dev.poderopedia.com/vocab/StudentEducationalConnection> a owl:Class ;
    rdfs:label "Student"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/EducationalConnection> .

<http://dev.poderopedia.com/vocab/SympathizerAssociationConnection> rdfs:label "Sympathizer"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/AssociationConnection> .

<http://dev.poderopedia.com/vocab/academicParticipant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Academic organization participant"@en ;
    rdfs:comment "An academic organization (school, university) who is part of this connection"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/AcademicConnection> ;
    rdfs:range <http://dev.poderopedia.com/vocab/AcademicOrganization> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

<http://dev.poderopedia.com/vocab/alias> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Alias"@en ;
    rdfs:comment "An alias for a person"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf skos:altLabel,
        foaf:name .

<http://dev.poderopedia.com/vocab/buyerCompany> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Buyer"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/AcquisitionCompanyConnection> ;
    rdfs:range <http://dev.poderopedia.com/vocab/Company> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

<http://dev.poderopedia.com/vocab/ceo> a <http://dev.poderopedia.com/vocab/WorkRole> ;
    rdfs:label "CEO"@en .

<http://dev.poderopedia.com/vocab/commercialRepresentativesOf> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Commercial representatives of"@en ;
    rdfs:comment "Relation between companies where one is the subsidiary of the second"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/Company> ;
    rdfs:range <http://dev.poderopedia.com/vocab/Company> .

<http://dev.poderopedia.com/vocab/connectedVia> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Connected via"@en ;
    rdfs:comment "Entity from where two persons know each other (school, college, church, etc.)"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/SocialConnection> ;
    rdfs:range foaf:Agent .

<http://dev.poderopedia.com/vocab/connectionEndDate> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Connection end date"@en ;
    rdfs:comment "Date when connection between entities ended"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/Connection> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/concludingEvent> .

<http://dev.poderopedia.com/vocab/connectionStartDate> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Connection start date"@en ;
    rdfs:comment "Date when connection between entities started"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/Connection> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/initiatingEvent> .

<http://dev.poderopedia.com/vocab/countryOfResidence> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Country of residence"@en ;
    rdfs:comment "Country where the organization's headquarters are located"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://dev.poderopedia.com/vocab/Country> ;
    rdfs:subPropertyOf foaf:based_near .

<http://dev.poderopedia.com/vocab/cto> a <http://dev.poderopedia.com/vocab/WorkRole> ;
    rdfs:label "CTO"@en .

<http://dev.poderopedia.com/vocab/declarationOfInterests> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Declaration of interests"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/WorkConnection> ;
    rdfs:range foaf:Document .

<http://dev.poderopedia.com/vocab/declarationOfPatrimony> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Declaration of Patrimony"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/WorkConnection> ;
    rdfs:range foaf:Document .

<http://dev.poderopedia.com/vocab/depiction> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "depiction"@en ;
    rdfs:comment "A depiction of some organization or person."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range foaf:Document .

<http://dev.poderopedia.com/vocab/firstLastName> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "First last name"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf foaf:familyName .

<http://dev.poderopedia.com/vocab/hasAcademicOrganization> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Academic organization"@en ;
    rdfs:comment "Entity from where two persons know each other (school, college, church, etc.)"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/EducationalConnection> ;
    rdfs:range <http://dev.poderopedia.com/vocab/AcademicOrganization> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

<http://dev.poderopedia.com/vocab/hasAlternativeMainSector> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Has other main sector"@en ;
    rdfs:comment "Main sector not listed in hasMainSector"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range rdfs:Literal .

<http://dev.poderopedia.com/vocab/hasAlternativeOtherSector> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Has other main sector"@en ;
    rdfs:comment "Other sector not listed in hasOtherSector"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range rdfs:Literal .

<http://dev.poderopedia.com/vocab/hasAnotherPhilantropySector> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Has another Non Government Organization Sector"@en ;
    rdfs:comment "Sectors related to NGOs not lister previously"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/NonGovernmentalOrganization> ;
    rdfs:range rdfs:Literal .

<http://dev.poderopedia.com/vocab/hasCousin> a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Has cousin"@en ;
    rdfs:comment "Describes relation where a person (object) is the cousin (their parents are siblings) of this person"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

<http://dev.poderopedia.com/vocab/hasDocumentURL> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Document URL"@en ;
    rdfs:comment "URL where the document is located"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/Documentation> ;
    rdfs:range foaf:Document .

<http://dev.poderopedia.com/vocab/hasEconomicOrganizationParticipant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Organization/Company involved"@en ;
    rdfs:comment "Organization or company associated with this economic connection"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/WorkConnection> ;
    rdfs:range foaf:Organization .

<http://dev.poderopedia.com/vocab/hasFinancialInformationYear> a rdf:Property,
        rdfs:DatatypeProperty ;
    rdfs:label "Date of financial information"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/FinancialInformation> ;
    rdfs:range xsd:gYear .

<http://dev.poderopedia.com/vocab/hasGender> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Gender"@en ;
    rdfs:comment "Gender of this person"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range <http://dev.poderopedia.com/vocab/Gender> .

<http://dev.poderopedia.com/vocab/hasLegalConstitution> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Legal constitution"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/Company> ;
    rdfs:range foaf:Document .

<http://dev.poderopedia.com/vocab/hasLogo> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Logo"@en ;
    rdfs:comment "Logo of the organization"@en ;
    rdfs:domain foaf:Organization ;
    rdfs:range foaf:Image .

<http://dev.poderopedia.com/vocab/hasLongBiography> a rdfs:Predicate,
        owl:ObjectProperty ;
    rdfs:label "Long biography"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://dev.poderopedia.com/vocab/LongBiography> .

<http://dev.poderopedia.com/vocab/hasMainSector> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has main sector"@en ;
    rdfs:comment "Main sector related to the organization"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://dev.poderopedia.com/vocab/Sector> .

<http://dev.poderopedia.com/vocab/hasMap> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Map"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/Company> ;
    rdfs:range foaf:Document .

<http://dev.poderopedia.com/vocab/hasNumberEmployees> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Number of Employees"@en ;
    rdfs:subPropertyOf <http://dev.poderopedia.com/vocab/hasNumericDatum> .

<http://dev.poderopedia.com/vocab/hasOrganigramDocumentation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Organigram Documentation"@en ;
    rdfs:comment "Documents describing the organigram this agent"@en ;
    rdfs:subPropertyOf <http://dev.poderopedia.com/vocab/hasDocumentation> .

<http://dev.poderopedia.com/vocab/hasOtherDocumentation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Other documentation"@en ;
    rdfs:comment "Miscelaneous document related to this agent"@en ;
    rdfs:subPropertyOf <http://dev.poderopedia.com/vocab/hasDocumentation> .

<http://dev.poderopedia.com/vocab/hasOtherSector> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Secondary sector"@en ;
    rdfs:comment "Other sector related to the organization"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://dev.poderopedia.com/vocab/Sector> .

<http://dev.poderopedia.com/vocab/hasPhilantropySector> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Philantropy Sector"@en ;
    rdfs:comment "Sectors related to NGOs"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/NonGovernmentalOrganization> ;
    rdfs:range <http://dev.poderopedia.com/vocab/PhilantropySector> .

<http://dev.poderopedia.com/vocab/hasRelevantDate> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Relevant date"@en ;
    rdfs:comment "Date related to this data (e.g., release date, last modification, etc.)"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/RelatedData> ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dcterms:coverage .

<http://dev.poderopedia.com/vocab/hasSanctionDocumentation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Documents about sanctions"@en ;
    rdfs:comment "Documents describing legal sanctions related to this agent"@en ;
    rdfs:subPropertyOf <http://dev.poderopedia.com/vocab/hasDocumentation> .

<http://dev.poderopedia.com/vocab/hasShortBiography> a rdfs:Predicate,
        owl:ObjectProperty ;
    rdfs:label "Short biography"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://dev.poderopedia.com/vocab/ShortBiography> .

<http://dev.poderopedia.com/vocab/hasSibling> a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "Has sibling"@en ;
    rdfs:comment "Describes relation where a person (object) is the sibling (i.e., they have at least one parent in common) of this person"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person .

<http://dev.poderopedia.com/vocab/hasSocialReason> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Name"@en ;
    rdfs:comment "An alias for a person"@en ;
    rdfs:domain foaf:Organization ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:title .

<http://dev.poderopedia.com/vocab/hasSource> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Source"@en ;
    rdfs:comment "Source where the information about a connection was obtained"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/SourcedEntity> ;
    rdfs:range foaf:Document ;
    rdfs:subPropertyOf dcterms:source .

<http://dev.poderopedia.com/vocab/hasSpouse> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Spouse"@en ;
    rdfs:comment "Connection between two people that establishes a marriage, domestic partnership, civil union, sentimental relationship, etc."@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/SentimentalRelationshipConnection> ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

<http://dev.poderopedia.com/vocab/hasStudent> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Student"@en ;
    rdfs:comment "Person involved in an Education Connection"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/EducationalConnection> ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

<http://dev.poderopedia.com/vocab/hasTaxId> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Tax ID"@en ;
    rdfs:comment "ID that identifies an organization or person for tax purposes"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier .

<http://dev.poderopedia.com/vocab/hasTickerSymbol> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Ticker symbol"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/Company> ;
    rdfs:range rdfs:Literal .

<http://dev.poderopedia.com/vocab/hasUrl> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has URL"@en ;
    rdfs:comment "Any URL related to this organization or person (including social media, corporate sites, etc.)"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range foaf:Document ;
    rdfs:subClassOf foaf:page .

<http://dev.poderopedia.com/vocab/hasValue> a rdf:Property,
        rdfs:DatatypeProperty ;
    rdfs:label "Value in a financial information"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/FinancialInformation> ;
    rdfs:range rdfs:Literal .

<http://dev.poderopedia.com/vocab/hasWorkRole> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Work role"@en ;
    rdfs:comment "Position or role of the person in this economic connection"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/WorkConnection> ;
    rdfs:range <http://dev.poderopedia.com/vocab/WorkRole> .

<http://dev.poderopedia.com/vocab/mergeCompany> a rdf:Propertym,
        owl:ObjectProperty ;
    rdfs:label "Merge company"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/MergeCompanyConnection> ;
    rdfs:range <http://dev.poderopedia.com/vocab/Company> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

<http://dev.poderopedia.com/vocab/newsEventParticipant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "A news event participant in this connection"@en ;
    rdfs:comment "A news event which is part of this connection"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/NewsEventConnection> ;
    rdfs:range <http://dev.poderopedia.com/vocab/NewsEvent> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

<http://dev.poderopedia.com/vocab/otherLastName> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Other last name"@en ;
    rdfs:comment "Other last name, different from the first one"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf foaf:familyName .

<http://dev.poderopedia.com/vocab/personParticipant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Member person"@en ;
    rdfs:comment "A a member of an organization"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/AssociationConnection> ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

<http://dev.poderopedia.com/vocab/politicalParticipant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Political Organizacion participant"@en ;
    rdfs:comment "A political organization who is part of this connection"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/PoliticalConnection> ;
    rdfs:range <http://dev.poderopedia.com/vocab/PoliticalOrganization> ;
    rdfs:subPropertyOf <http://dev.poderopedia.com/vocab/organizationParticipant> .

onto: a owl:Ontology ;
    rdfs:label "PoderVocab: A vocabulary for Poderopedia"@en ;
    dcterms:abstract "This document describes a vocabulary to express information about people and their relations with Organizations, Companies, etc."@en ;
    dcterms:date "2012-05-17"^^xsd:date ;
    dcterms:title "PoderVocab: A vocabulary for Poderopedia"@en ;
    owl:versionInfo "0.8" .

<http://dev.poderopedia.com/vocab/subsidiaryCompanyOf> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Subsidiary company of"@en ;
    rdfs:comment "Relation between companies where one is the subsidiary of the second"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/Company> ;
    rdfs:range <http://dev.poderopedia.com/vocab/Company> .

<http://dev.poderopedia.com/vocab/targetCompany> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Target company"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/AcquisitionCompanyConnection> ;
    rdfs:range <http://dev.poderopedia.com/vocab/Company> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

<http://purl.org/vocab/bio/0.1/birth> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Birth Event"@en ;
    rdfs:comment "An birth event associated with a person, group or organization."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:range <http://purl.org/vocab/bio/0.1/Birth> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/event>,
        owl:differentFrom .

<http://purl.org/vocab/bio/0.1/date> a rdf:Property ;
    rdfs:label "Fecha",
        "Date"@en ;
    rdfs:comment "The date at which an event occurred."@en ;
    rdfs:domain <http://purl.org/vocab/bio/0.1/Event> ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:subPropertyOf dc:date .

<http://purl.org/vocab/bio/0.1/death> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Death Event"@en ;
    rdfs:comment "An death event associated with a person, group or organization."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:range <http://purl.org/vocab/bio/0.1/Death> ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/event>,
        owl:differentFrom .

<http://purl.org/vocab/bio/0.1/place> a rdf:Property ;
    rdfs:label "Lugar",
        "Place"@en ;
    rdfs:comment "The place at which an event occurred."@en ;
    rdfs:domain <http://purl.org/vocab/bio/0.1/Event> ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

rdfs:comment a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "comment" ;
    rdfs:comment "A description of the subject resource." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Literal .

foaf:firstName a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "firstName"@en ;
    rdfs:comment "The first name of a person."@en ;
    rdfs:domain foaf:Person ;
    rdfs:range rdfs:Literal .

foaf:givenName a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Given name"@en ;
    rdfs:comment "The given name of some person."@en ;
    rdfs:isDefinedBy foaf: .

<http://dev.poderopedia.com/vocab/AcademicConnection> a owl:Class ;
    rdfs:label "Academic Connection"@en ;
    rdfs:comment "The connection between a person and an Educational Organization (university, school, etc)"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Connection> .

<http://dev.poderopedia.com/vocab/Country> a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "A region legally defined as a distinct entity in political geography"@en ;
    rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

<http://dev.poderopedia.com/vocab/Gender> a owl:Class ;
    rdfs:label "Gender"@en ;
    rdfs:comment "Gender of a person"@en .

<http://dev.poderopedia.com/vocab/MergeCompanyConnection> a owl:Class ;
    rdfs:label "Economic Connection"@en ;
    rdfs:comment "The connection between an entity and an Educational Organization (university, school, etc)"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/CompanyConnection> .

<http://dev.poderopedia.com/vocab/NewsEvent> a owl:Class ;
    rdfs:label "News event"@en ;
    rdfs:comment "An event relevant from the point of view of journalism"@en ;
    rdfs:subClassOf <http://purl.org/vocab/bio/0.1/Event> .

<http://dev.poderopedia.com/vocab/NewsEventConnection> a owl:Class ;
    rdfs:label "News event connection"@en ;
    rdfs:comment "Describes the relation of a person with a news event during a specific period of time"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Connection> .

<http://dev.poderopedia.com/vocab/NumericDatum> a owl:Class ;
    rdfs:label "Numeric datum"@en ;
    rdfs:comment "Numeric datum for an organization for a certain year"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/RelatedData> .

<http://dev.poderopedia.com/vocab/PoliticalConnection> a owl:Class ;
    rdfs:label "Political connection"@en ;
    rdfs:comment "Connection between a political organization and other entities"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/AssociationConnection> .

<http://dev.poderopedia.com/vocab/PoliticalOrganization> a owl:Class ;
    rdfs:label "Political Organization"@en ;
    rdfs:comment "An Political organization, like parties."@en ;
    rdfs:subClassOf foaf:Organization .

<http://dev.poderopedia.com/vocab/hasAuntOrUncle> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Aunt or Uncle"@en ;
    rdfs:comment "Describes relation where a person (object) is the sibling of one of the parents of this person"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person ;
    owl:inverseOf <http://dev.poderopedia.com/vocab/hasNieceOrNephew> .

<http://dev.poderopedia.com/vocab/hasChild> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Parent"@en ;
    rdfs:comment "Describes relation where a person (object) is a parent of this person"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person ;
    owl:inverseOf <http://dev.poderopedia.com/vocab/hasParent> .

<http://dev.poderopedia.com/vocab/hasGrandChild> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has grandchild"@en ;
    rdfs:comment "Describes relation where a person (object) is the child of the person's child"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person ;
    owl:inverseOf <http://dev.poderopedia.com/vocab/hasGrandparent> .

<http://dev.poderopedia.com/vocab/hasGrandparent> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has grandparent"@en ;
    rdfs:comment "Describes relation where a person (object) is the parent of the person's parent"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person ;
    owl:inverseOf <http://dev.poderopedia.com/vocab/hasGrandChild> .

<http://dev.poderopedia.com/vocab/hasNieceOrNephew> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has niece or nephew"@en ;
    rdfs:comment "Describes relation where a person (object) is the child of one of the siblings of this person"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person ;
    owl:inverseOf <http://dev.poderopedia.com/vocab/hasAuntOrUncle> .

<http://dev.poderopedia.com/vocab/hasNumericDatum> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has numerical datum"@en ;
    rdfs:domain foaf:Organization ;
    rdfs:range <http://dev.poderopedia.com/vocab/NumericDatum> .

<http://dev.poderopedia.com/vocab/hasParent> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has Parent"@en ;
    rdfs:comment "Describes relation where a person (object) is a parent of this person"@en ;
    rdfs:domain foaf:Person ;
    rdfs:range foaf:Person ;
    owl:inverseOf <http://dev.poderopedia.com/vocab/hasChild> .

<http://dev.poderopedia.com/vocab/organizationParticipant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Participant organization"@en ;
    rdfs:comment "An academic organization (school, university) who is part of this connection"@en ;
    rdfs:domain <http://dev.poderopedia.com/vocab/AssociationConnection> ;
    rdfs:range foaf:Organization ;
    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant> .

dcterms:source a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Source"@en ;
    rdfs:comment "A related resource from which the described resource is derived."@en .

<http://purl.org/vocab/bio/0.1/Birth> a owl:Class ;
    rdfs:label "Birth"@en ;
    rdfs:comment "The event of a person entering into life."@en ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:subClassOf <http://purl.org/vocab/bio/0.1/IndividualEvent> .

<http://purl.org/vocab/bio/0.1/Death> a owl:Class ;
    rdfs:label "Death"@en ;
    rdfs:comment "The event of a person's life ending."@en ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:subClassOf <http://purl.org/vocab/bio/0.1/IndividualEvent> .

<http://purl.org/vocab/bio/0.1/concludingEvent> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Concluding Event"@en ;
    rdfs:comment "An event that marks the end of an interval and/or relationship. The event changes of the state of affairs that held during the interval. For example a period of study may be concluded by a Graduation event."@en ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:range <http://purl.org/vocab/bio/0.1/Event> .

<http://purl.org/vocab/bio/0.1/initiatingEvent> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Initiating Event"@en ;
    rdfs:comment "An event that marks the start of an interval and/or relationship. The event contributes to and/or causes of the state of affairs that hold during the interval. For example a period of study may be initiated by an Enrolment event."@en ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:range <http://purl.org/vocab/bio/0.1/Event> .

<http://purl.org/vocab/bio/0.1/relationship> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Relationship"@en ;
    rdfs:comment "A relationship that a person, group or organization participates in for some time."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:range <http://purl.org/vocab/bio/0.1/Relationship> ;
    owl:inverseOf <http://purl.org/vocab/bio/0.1/participant> .

foaf:based_near a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "based near" ;
    rdfs:comment "A location that something is based near, for some broadly human notion of near." ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:isDefinedBy foaf: ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> .

<http://dev.poderopedia.com/vocab/AcademicOrganization> a owl:Class ;
    rdfs:label "Academic Organization"@en ;
    rdfs:comment "An educational organization, such a school or university"@en ;
    rdfs:subClassOf foaf:Organization .

<http://dev.poderopedia.com/vocab/AcquisitionCompanyConnection> a owl:Class ;
    rdfs:label "Company acquisition"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/CompanyConnection> .

<http://dev.poderopedia.com/vocab/Biography> a owl:Class ;
    rdfs:label "Generic biography"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SourcedEntity> .

<http://dev.poderopedia.com/vocab/CompanyConnection> a owl:Class ;
    rdfs:label "Company Connection"@en ;
    rdfs:comment "The connection between two companies"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Connection> .

<http://dev.poderopedia.com/vocab/Documentation> a owl:Class ;
    rdfs:label "Documentation"@en ;
    rdfs:comment "Class that describes documents related to a person or organization, including its release date"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/RelatedData> .

<http://dev.poderopedia.com/vocab/FinancialInformation> a owl:Class ;
    rdfs:label "Financial Report"@en ;
    rdfs:comment "Any financial information related to an organization (e.g., anual profit)"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SourcedEntity> .

<http://dev.poderopedia.com/vocab/LongBiography> a owl:Class ;
    rdfs:label "Long biography"@en ;
    rdfs:comment "Long description of a person, organization, etc"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Biography> ;
    owl:disjointWith <http://dev.poderopedia.com/vocab/ShortBiography> .

<http://dev.poderopedia.com/vocab/NonGovernmentalOrganization> a owl:Class ;
    rdfs:label "Non Governmental Organization"@en ;
    rdfs:comment "An non-governmental organization (NGO)"@en ;
    rdfs:subClassOf foaf:Organization .

<http://dev.poderopedia.com/vocab/Sector> a owl:Class ;
    rdfs:label "Sector"@en ;
    rdfs:comment "Productive sector related to an agent"@en .

<http://dev.poderopedia.com/vocab/ShortBiography> a owl:Class ;
    rdfs:label "Short biography"@en ;
    rdfs:comment "Short description of a person, organization, etc"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Biography> ;
    owl:disjointWith <http://dev.poderopedia.com/vocab/LongBiography> .

<http://purl.org/vocab/bio/0.1/IndividualEvent> a owl:Class ;
    rdfs:label "Individual Event"@en ;
    rdfs:comment "A type of event that is principally about a single person, group or organization. Other agents may be involved but the event is most significant for the principal agent."@en ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://purl.org/vocab/bio/0.1/principal> ],
        <http://purl.org/vocab/bio/0.1/Event> .

<http://dev.poderopedia.com/vocab/RelatedData> a owl:Class ;
    rdfs:label "Related Data"@en ;
    rdfs:comment "Class that describes any type of data related to an organization including a relevant date"@en .

<http://dev.poderopedia.com/vocab/hasDocumentation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Has documentation"@en ;
    rdfs:comment "Associates an agent with related documentation"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range <http://dev.poderopedia.com/vocab/Documentation> .

<http://purl.org/vocab/bio/0.1/Relationship> a owl:Class ;
    rdfs:label "Agent Relationship"@en ;
    rdfs:comment "A particular type of connection existing between people, groups or organizations related to or having dealings with each other."@en ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> .

<http://dev.poderopedia.com/vocab/SocialConnection> a owl:Class ;
    rdfs:label "Social connection"@en ;
    rdfs:comment "Connection between a two people, like friendship, acquaintances, etc."@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Connection> .

<http://dev.poderopedia.com/vocab/WorkConnection> a owl:Class ;
    rdfs:label "Economic Connection"@en ;
    rdfs:comment "The connection between an entity and an Educational Organization (university, school, etc)"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Connection> .

<http://dev.poderopedia.com/vocab/EducationalConnection> a owl:Class ;
    rdfs:label "Educational connection"@en ;
    rdfs:comment "These connections reflects that a person studied (at least for some time) in an academic organization."@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Connection> .

<http://dev.poderopedia.com/vocab/SentimentalRelationshipConnection> a owl:Class ;
    rdfs:label "Marital Status"@en ;
    rdfs:comment "Class of possible marital status a person can be"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Connection> .

<http://dev.poderopedia.com/vocab/SourcedEntity> a owl:Class ;
    rdfs:label "Sourced Entity"@en ;
    rdfs:comment "Abstract class  of any entity that has a source where its information was taken from"@en .

<http://purl.org/vocab/bio/0.1/Event> a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "An event is an occurrence that brings about a change in the state of affairs for one or more people and/or other agents. Events are assumed to occur over a period of time and may not have precise start and end points."@en ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SourcedEntity> .

<http://dev.poderopedia.com/vocab/AssociationConnection> a owl:Class ;
    rdfs:label "Association Connection"@en ;
    rdfs:comment "The connection between an entity and a Organization (Opus Dei, a Think Tank) without been affiliated to it necessarily"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/Connection> .

<http://dev.poderopedia.com/vocab/Company> a owl:Class ;
    rdfs:label "Company"@en ;
    rdfs:comment "A for profit organization" ;
    rdfs:subClassOf foaf:Organization .

<http://dev.poderopedia.com/vocab/Connection> a owl:Class ;
    rdfs:label "Generic connection"@en ;
    rdfs:comment "A generic connection between two or more entities during a certain period of time"@en ;
    rdfs:subClassOf <http://dev.poderopedia.com/vocab/SourcedEntity>,
        <http://purl.org/vocab/bio/0.1/Relationship> .

<http://purl.org/vocab/bio/0.1/participant> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Participant"@en ;
    rdfs:comment "A person, group or organization that participates in a relationship for some time."@en ;
    rdfs:domain <http://purl.org/vocab/bio/0.1/Relationship> ;
    rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/> ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf owl:differentFrom ;
    owl:inverseOf <http://purl.org/vocab/bio/0.1/relationship> .

foaf:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:subClassOf foaf:Agent ;
    owl:equivalentClass org:Organization .

foaf:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "An agent (human or not)"@en .

foaf:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A person"@en ;
    rdfs:subClassOf foaf:Agent .

