@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns2: <http://web.resource.org/cc/> .
@prefix ns3: <http://open.vocab.org/terms/> .
@prefix ns4: <http://purl.org/net/vocab/2004/03/label#> .
@prefix onto: <http://purl.org/vocab/bio/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///var/www/vocab.org/www/htdocs/bio/> a ns2:Work ;
    dcterms:type dcmitype:Text ;
    ns2:license <http://creativecommons.org/licenses/by/1.0/> .

onto:Disbanding a owl:Class ;
    rdfs:label "Disbanding"@en ;
    dcterms:issued "2011-06-10" ;
    rdfs:comment "The event of a group or organization being disbanded."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Formation a owl:Class ;
    rdfs:label "Formation"@en ;
    dcterms:issued "2011-06-10" ;
    rdfs:comment "The event of a group or organization coming into being."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Performance a owl:Class ;
    rdfs:label "Performance"@en ;
    dcterms:issued "2011-06-12" ;
    rdfs:comment "The event of an individual or a group of performers performing. Examples include concerts, plays, recitals, recordings, busking etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:GroupEvent ;
    owl:equivalentClass <http://purl.org/ontology/mo/Performance> ;
    ns1:term_status "unstable" .

onto:concludingEvent a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Concluding Event"@en ;
    dcterms:issued "2010-05-06" ;
    ns4:plural "Concluding Event"@en ;
    rdfs:comment "An event that marks the end of an interval and/or relationship. The event changes of the state of affairs that held during the interval. For example a period of study may be concluded by a Graduation event."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Event ;
    rdfs:subPropertyOf owl:differentFrom .

onto:eventInterval a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Event Interval"@en ;
    dcterms:issued "2010-06-05" ;
    rdfs:comment "The interval during which the event occurs. This interval represents the exact interval of occurence for an event, it starts at the moment the event commences and finishes when the event concludes. In other words both the event and the interval start at the same instant of time and extend for the same duration."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Interval ;
    ns1:term_status "unstable" .

onto:initiatingEvent a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Initiating Event"@en ;
    dcterms:issued "2010-05-06" ;
    ns4:plural "Initiating Event"@en ;
    rdfs:comment "An event that marks the start of an interval and/or relationship. The event contributes to and/or causes of the state of affairs that hold during the interval. For example a period of study may be initiated by an Enrolment event."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Event ;
    rdfs:subPropertyOf owl:differentFrom .

onto:interval a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Relationship Interval"@en ;
    dcterms:issued "2010-06-05" ;
    rdfs:comment "The interval during which the relationship persists."@en ;
    rdfs:domain onto:Relationship ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Interval ;
    ns1:term_status "unstable" .

<http://vocab.org/bio/0.1/.rdf> a dcmitype:Text,
        foaf:Document ;
    dcterms:hasFormat <http://vocab.org/bio/0.1/.html>,
        <http://vocab.org/bio/0.1/.json>,
        <http://vocab.org/bio/0.1/.turtle> ;
    foaf:primaryTopic onto: ;
    foaf:topic onto: .

<http://creativecommons.org/licenses/by/1.0/> a ns2:License ;
    ns2:permits ns2:DerivativeWorks,
        ns2:Distribution,
        ns2:Reproduction ;
    ns2:requires ns2:Attribution,
        ns2:Notice .

<http://iandavis.com/id/me> a foaf:Person ;
    foaf:name "Ian Davis" .

<http://lists.foaf-project.org/mailman/listinfo/foaf-dev> rdfs:label "FOAF-DEV mailing list" .

onto:Accession a owl:Class ;
    rdfs:label "Accession"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person succeeding to the right to hold regal power. This event is often automatic on the death of the previous monarch and is usually followed by a coronation event."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Adoption a owl:Class ;
    rdfs:label "Adoption"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of creating of a legal parent/child relationship that does not exist biologically."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Annulment a owl:Class ;
    rdfs:label "Annulment"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of declaring a marriage void from the beginning as though it never existed."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:GroupEvent ;
    ns1:term_status "unstable" .

onto:Assassination a owl:Class ;
    rdfs:label "Assassination"@en ;
    dcterms:issued "2010-05-05" ;
    rdfs:comment "The event of a person being deliberately targeted and killed."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Murder ;
    ns1:term_status "unstable" .

onto:Baptism a owl:Class ;
    rdfs:label "Baptism"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The ceremonial event held to admit a person to membership of a Christian church."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-20" ;
            rdf:value "Revised comment, replacing 'the Christian church' with 'a Christian church' " ] .

onto:BarMitzvah a owl:Class ;
    rdfs:label "BarMitzvah"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The ceremonial event held when a Jewish boy reaches age 13."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:BasMitzvah a owl:Class ;
    rdfs:label "BasMitzvah"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The ceremonial event held when a Jewish girl reaching age 13, also known as \"Bat Mitzvah.\""@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Burial a owl:Class ;
    rdfs:label "Burial"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of interring the remains of a person's body into the ground."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Coronation a owl:Class ;
    rdfs:label "Coronation"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The ceremonial event of a person being invested with regal power to become a monarch."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Cremation a owl:Class ;
    rdfs:label "Cremation"@en ;
    dcterms:issued "2010-05-03" ;
    vann:example [ a ns3:SchemaExample ;
            rdfs:label "The cremation of Albert Einstein" ;
            rdfs:comment "\\n        <pre><code>_:e a bio:Cremation \\n    ; dc:date &quot;1955-04-18&quot;\\n    ; bio:principal &lt;http://dbpedia.org/resource/Albert_Einstein&gt;\\n    ; bio:place &lt;http://dbpedia.org/resource/Princeton,_New_Jersey&gt;\\n    .</code></pre>\\n"^^rdf:XMLLiteral ] ;
    rdfs:comment "The event of disposing of the remains of a person's body by fire."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Demotion a owl:Class ;
    rdfs:label "Demotion"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person changing the position they hold with an employer to one with less importance or responsibility."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:PositionChange ;
    ns1:term_status "unstable" .

onto:Dismissal a owl:Class ;
    rdfs:label "Dismissal"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person involuntarily giving up their office or position. Dismissal is often perceived to be the employee's fault and may be considered disgraceful."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Divorce a owl:Class ;
    rdfs:label "Divorce"@en ;
    dcterms:issued "2010-05-03" ;
    vann:example [ a ns3:SchemaExample ;
            rdfs:label "The divorce of Albert Einstein and Mileva Marić" ;
            rdfs:comment "\\n        <pre><code>_:e a bio:Divorce \\n    ; dc:date &quot;1919-02-14&quot;\\n    ; bio:partner &lt;http://dbpedia.org/resource/Albert_Einstein&gt;\\n    ; bio:partner &lt;http://dbpedia.org/resource/Mileva_Mari%C4%87&gt;\\n    ; bio:place &lt;http://dbpedia.org/resource/Zurich&gt;\\n    .</code></pre>\\n"^^rdf:XMLLiteral ] ;
    rdfs:comment "The event of legally dissolving a marriage."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:GroupEvent ;
    ns1:term_status "unstable" .

onto:Emigration a owl:Class ;
    rdfs:label "Emigration"@en ;
    dcterms:issued "2010-05-03" ;
    vann:example [ a ns3:SchemaExample ;
            rdfs:label "Albert Einstein emigrating to the United States" ;
            rdfs:comment "\\n        <pre><code>_:e a bio:Emigration \\n    ; dc:date &quot;1933&quot;^^xsd:gYear\\n    ; bio:principal &lt;http://dbpedia.org/resource/Albert_Einstein&gt;\\n    ; bio:state &lt;http://dbpedia.org/resource/United_States&gt;\\n    .</code></pre>\\n"^^rdf:XMLLiteral ] ;
    rdfs:comment "The event of a person leaving their homeland with the intent of residing elsewhere."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Employment a owl:Class ;
    rdfs:label "Employment"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person entering an occupational relationship with an employer."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Enrolment a owl:Class ;
    rdfs:label "Enrolment"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person initiating attendence to a school or other place of learning."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Execution a owl:Class ;
    rdfs:label "Execution"@en ;
    dcterms:issued "2010-05-05" ;
    rdfs:comment "The event of a person being deliberately killed as punishment."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Death ;
    ns1:term_status "unstable" .

onto:Funeral a owl:Class ;
    rdfs:label "Funeral"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of marking a person's death with a ceremony."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Graduation a owl:Class ;
    rdfs:label "Graduation"@en ;
    dcterms:issued "2010-05-03" ;
    vann:example [ a ns3:SchemaExample ;
            rdfs:label "Albert Einstein receiving his Doctorate from the University of Zurich" ;
            rdfs:comment "\\n        <pre><code>_:e a bio:Graduation \\n    ; dc:date &quot;1905&quot;^^xsd:gYear\\n    ; bio:principal &lt;http://dbpedia.org/resource/Albert_Einstein&gt;\\n    ; bio:organization &lt;http://dbpedia.org/resource/University_of_Zurich&gt;\\n    .</code></pre>\\n"^^rdf:XMLLiteral ] ;
    rdfs:comment "The event of a person being awarded educational diplomas or degrees."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Imprisonment a owl:Class ;
    rdfs:label "Imprisonment"@en ;
    dcterms:issued "2010-05-04" ;
    rdfs:comment "The event of a person being detained in a jail or prison."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Inauguration a owl:Class ;
    rdfs:label "Inauguration"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The ceremonial event marking the beginning of a person's term of office as a leader."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Investiture a owl:Class ;
    rdfs:label "Investiture"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The ceremonial event of a person taking a public office or honour."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Marriage a owl:Class ;
    rdfs:label "Marriage"@en ;
    vann:example [ a ns3:SchemaExample ;
            rdfs:label "The marriage of Albert Einstein and Mileva Marić" ;
            rdfs:comment "\\n        <pre><code>_:e a bio:Marriage \\n    ; dc:date &quot;1903&quot;\\n    ; bio:partner &lt;http://dbpedia.org/resource/Albert_Einstein&gt;\\n    ; bio:partner &lt;http://dbpedia.org/resource/Mileva_Mari%C4%87&gt;\\n    ; bio:place &lt;http://dbpedia.org/resource/Bern&gt;\\n    .</code></pre>\\n"^^rdf:XMLLiteral ] ;
    rdfs:comment "The event of creating uniting the participants into a new family unit, sometimes accompanied by a formal wedding ceremony. This is intended to cover a broad range of marriages including those given formal legal standing, common-law, or by convention. It is not restricted to marriages of two people of the opposite gender, but also includes polygamous and same-sex unions."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:GroupEvent ;
    owl:equivalentClass <http://sw.opencyc.org/2009/04/07/concept/en/WeddingEvent_Generic> ;
    ns1:term_status "stable" ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Marked as a stable term" ] ;
    skos:historyNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Made equivalent to cyc:WeddingEvent_Generic" ] .

onto:NameChange a owl:Class ;
    rdfs:label "Change of Name"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person changing their name."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Naturalization a owl:Class ;
    rdfs:label "Naturalization"@en ;
    dcterms:issued "2010-05-03" ;
    vann:example [ a ns3:SchemaExample ;
            rdfs:label "Albert Einstein becoming a citizen of the United States" ;
            rdfs:comment "\\n        <pre><code>_:e a bio:Emigration \\n    ; dc:date &quot;1940&quot;\\n    ; bio:principal &lt;http://dbpedia.org/resource/Albert_Einstein&gt;\\n    ; bio:state &lt;http://dbpedia.org/resource/United_States&gt;\\n    .</code></pre>\\n"^^rdf:XMLLiteral ] ;
    rdfs:comment "The event of a person obtaining citizenship. Note that the place the naturalization event occurs at may be different from the state the person is obtaining citizenship of. "@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Ordination a owl:Class ;
    rdfs:label "Ordination"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The ceremonial event held when a person receives authority to act in religious matters."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Promotion a owl:Class ;
    rdfs:label "Promotion"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person changing the position they hold with an employer to one with more importance or responsibility."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:PositionChange ;
    ns1:term_status "unstable" .

onto:Redundancy a owl:Class ;
    rdfs:label "Redundancy"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person involuntarily giving up an office or position that is no longer needed. Redundancy is usually perceived to be the employer's fault and is usually due to conditions outside of the employee's control."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Resignation a owl:Class ;
    rdfs:label "Resignation"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person voluntarily giving up or quitting their office or position."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Retirement a owl:Class ;
    rdfs:label "Retirement"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person exiting an occupational relationship with an employer after a qualifying time period. In many cultures retirement is expected and even required once the person reaches a particular age."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:biography a rdf:Property ;
    rdfs:label "Biography"@en ;
    dcterms:issued "2010-06-05" ;
    vann:usageNote "<p>It is expected that the value of this property is either a literal formatted with HTML markup or a pointer to an HTML document.</p>"^^rdf:XMLLiteral ;
    rdfs:comment "An extended description or account of someone's life."@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "unstable" .

onto:birth a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Birth Event"@en ;
    ns4:plural "Birth Events"@en ;
    rdfs:comment "An birth event associated with a person, group or organization."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Birth ;
    rdfs:subPropertyOf onto:event,
        owl:differentFrom ;
    skos:historyNote [ dcterms:creator "Alexandre Passant" ;
            dcterms:date "2011-07-12" ;
            rdf:value "Proposed addition of the property" ] .

onto:child a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Child"@en ;
    dcterms:issued "2010-05-03" ;
    ns4:plural "Children"@en ;
    vann:usageNote "Note that this is a strict definition of child that does not include adopted children, step-children or similar non-biological relationships. The <a href=\"http://purl.org/vocab/relationship\">Relationship</a> vocabulary may be more suitable for broader types of parent/child relation."^^rdf:XMLLiteral ;
    rdfs:comment "A biological child of a person. "@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf owl:differentFrom ;
    owl:equivalentProperty <http://purl.org/vocab/relationship/parentOf> ;
    ns1:term_status "unstable" ;
    skos:historyNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-06-06" ;
            rdf:value "Made equivalent to rel:parentOf on suggestion of Gautier Poupeau" ] .

onto:concurrentEvent a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Concurrent Event"@en ;
    dcterms:issued "2010-05-06" ;
    ns4:plural "Concurrent Events"@en ;
    rdfs:comment "An event that occurs while this event is occurring. The events need not start or conclude at the same times."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Event ;
    rdfs:subPropertyOf owl:differentFrom .

onto:date a rdf:Property ;
    rdfs:label "Date"@en ;
    ns4:plural "Dates"@en ;
    vann:usageNote "<p>The date should be formatted as specified in <a href=\"http://www.w3.org/TR/NOTE-datetime\">ISO8601</a>.\\n    For example: 2003-03-15 corresponds to the 15th March 2003, and 2003-03-15T13:21-05:00 corresponds to 15th March 2003, 8:21 am, US Eastern Standard Time.</p>"^^rdf:XMLLiteral ;
    rdfs:comment "The date at which an event occurred."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf dc:date ;
    ns1:term_status "stable" ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Marked as a stable term" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-03" ;
            rdf:value "Added a plural label" ] .

onto:death a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Death Event"@en ;
    ns4:plural "Death Events"@en ;
    rdfs:comment "An death event associated with a person, group or organization."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Death ;
    rdfs:subPropertyOf onto:event,
        owl:differentFrom ;
    skos:historyNote [ dcterms:creator "Alexandre Passant" ;
            dcterms:date "2011-07-12" ;
            rdf:value "Proposed addition of the property" ] .

onto:employer a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Employer"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Employers"@en ;
    rdfs:comment "An agent that is involved in an event as an employer."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf onto:agent .

onto:immediatelyFollowingEvent a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Immediately Following Event"@en ;
    dcterms:issued "2010-05-06" ;
    ns4:plural "Immediately Following Events"@en ;
    rdfs:comment "An event that starts immediately after this event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Event ;
    rdfs:subPropertyOf onto:followingEvent,
        owl:differentFrom .

onto:immediatelyPrecedingEvent a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Immediately Preceding Event"@en ;
    dcterms:issued "2010-05-06" ;
    ns4:plural "Immediately Preceding Events"@en ;
    rdfs:comment "An event that occurs and concludes immediately before this event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Event ;
    rdfs:subPropertyOf onto:precedingEvent,
        owl:differentFrom .

onto:keywords a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Key Words"@en ;
    dcterms:issued "2003-07-28" ;
    rdfs:comment "A comma delimited list of key words that describe a person."@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:subject ;
    ns1:term_status "stable" ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Marked as a stable term" ] ;
    skos:historyNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-03" ;
            rdf:value "Declared that this is a datatype property" ] .

onto:officiator a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Officiator"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Officiators"@en ;
    rdfs:comment "A person that officiates at a ceremonial event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf onto:agent .

onto:olb a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "One-line bio"@en ;
    rdfs:comment "A one-line biography of the person."@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "stable" ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Marked as a stable term" ] ;
    skos:historyNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-03" ;
            rdf:value "Declared that this is a datatype property" ] .

onto:organization a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Organization"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Organizations"@en ;
    rdfs:comment "An organization that plays a role in an event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf onto:agent .

onto:parent a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Parent"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Parents"@en ;
    rdfs:comment "A person that takes the parent role in an event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf onto:agent .

onto:participant a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Participant"@en ;
    dcterms:issued "2011-06-14" ;
    ns4:plural "Participants"@en ;
    rdfs:comment "A person, group or organization that participates in a relationship for some time."@en ;
    rdfs:domain onto:Relationship ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf owl:differentFrom ;
    owl:equivalentProperty <http://purl.org/vocab/relationship/participant> ;
    owl:inverseOf onto:relationship .

onto:place a rdf:Property ;
    rdfs:label "Place"@en ;
    ns4:plural "Places"@en ;
    rdfs:comment "The place at which an event occurred."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    ns1:term_status "stable" ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Marked as a stable term" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-03" ;
            rdf:value "Added a plural label" ] .

onto:position a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Position"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Positions"@en ;
    rdfs:comment "The employment position or public office involved in an event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf onto:agent ;
    ns1:term_status "unstable" .

onto:relationship a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Relationship"@en ;
    dcterms:issued "2011-06-14" ;
    ns4:plural "Relationships"@en ;
    rdfs:comment "A relationship that a person, group or organization participates in for some time."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Relationship ;
    rdfs:subPropertyOf owl:differentFrom ;
    owl:equivalentProperty <http://purl.org/vocab/relationship/participantIn> ;
    owl:inverseOf onto:participant .

onto:state a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "State"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "States"@en ;
    rdfs:comment "A country or independent territory that is involved in an event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf onto:agent .

onto:termgroup1 a rdf:Bag ;
    rdfs:label "Properties of a person"@en ;
    rdf:_1 onto:olb ;
    rdf:_2 onto:biography ;
    rdf:_3 onto:keywords ;
    rdf:_4 onto:father ;
    rdf:_5 onto:mother ;
    rdf:_6 onto:child ;
    rdf:_7 onto:event ;
    rdf:_8 onto:birth ;
    rdf:_9 onto:death .

onto:termgroup2 a rdf:Bag ;
    rdfs:label "Types of event"@en ;
    rdf:_1 onto:Event ;
    rdf:_10 onto:BasMitzvah ;
    rdf:_11 onto:Birth ;
    rdf:_12 onto:Burial ;
    rdf:_13 onto:PositionChange ;
    rdf:_14 onto:Coronation ;
    rdf:_15 onto:Cremation ;
    rdf:_16 onto:Death ;
    rdf:_17 onto:Demotion ;
    rdf:_18 onto:Dismissal ;
    rdf:_19 onto:Divorce ;
    rdf:_2 onto:IndividualEvent ;
    rdf:_20 onto:Emigration ;
    rdf:_21 onto:Employment ;
    rdf:_22 onto:Execution ;
    rdf:_23 onto:Enrolment ;
    rdf:_24 onto:Funeral ;
    rdf:_25 onto:Graduation ;
    rdf:_26 onto:Imprisonment ;
    rdf:_27 onto:Inauguration ;
    rdf:_28 onto:Investiture ;
    rdf:_29 onto:Marriage ;
    rdf:_3 onto:GroupEvent ;
    rdf:_30 onto:Murder ;
    rdf:_31 onto:NameChange ;
    rdf:_32 onto:Naturalization ;
    rdf:_33 onto:Ordination ;
    rdf:_34 onto:Promotion ;
    rdf:_35 onto:Redundancy ;
    rdf:_36 onto:Resignation ;
    rdf:_37 onto:Retirement ;
    rdf:_4 onto:Accession ;
    rdf:_5 onto:Adoption ;
    rdf:_6 onto:Annulment ;
    rdf:_7 onto:Assassination ;
    rdf:_8 onto:Baptism ;
    rdf:_9 onto:BarMitzvah .

onto:termgroup3 a rdf:Bag ;
    rdfs:label "Properties of an event"@en ;
    rdf:_1 onto:date ;
    rdf:_2 onto:place ;
    rdf:_3 onto:state ;
    rdf:_4 onto:position .

onto:termgroup4 a rdf:Bag ;
    rdfs:label "Properties that relate an event to an agent"@en ;
    rdf:_1 onto:agent ;
    rdf:_2 onto:parent ;
    rdf:_3 onto:employer ;
    rdf:_4 onto:officiator ;
    rdf:_5 onto:organization ;
    rdf:_6 onto:principal ;
    rdf:_7 onto:partner ;
    rdf:_8 onto:witness ;
    rdf:_9 onto:spectator .

onto:termgroup5 a rdf:Bag ;
    rdfs:label "Properties that relate an event to another event"@en ;
    rdf:_1 onto:concurrentEvent ;
    rdf:_2 onto:followingEvent ;
    rdf:_3 onto:precedingEvent ;
    rdf:_4 onto:immediatelyFollowingEvent ;
    rdf:_5 onto:immediatelyPrecedingEvent .

onto:witness a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Witness"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Witnesses"@en ;
    rdfs:comment "A person that witnesses and can bear testimony to the occurrence of an event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf onto:spectator .

<http://purl.org/vocab/bio/examples/1> a ns3:SchemaExample ;
    rdfs:label "A Biography of Henry VIII, King of England" ;
    rdfs:comment "<p>Based on information at <a href=\"http://en.wikipedia.org/wiki/Henry_VIII_of_England\">Wikipedia</a> and <a href=\"http://www3.dcs.hull.ac.uk/cgi-bin/gedlkup/n=royal?royal00828\">Hull University</a></p>\\n<pre><code>@prefix bio: &lt;http://purl.org/vocab/bio/0.1/&gt; .\\n@prefix foaf: &lt;http://xmlns.com/foaf/0.1/&gt; .\\n@prefix rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt; .\\n\\n_:henryviii\\n  a foaf:Person\\n  ; foaf:name &quot;Henry VIII, King of England&quot;\\n  ; bio:father _:henryvii\\n  ; bio:mother _:elizplantagenet\\n  ; bio:child _:child1, _:child2, _:child3, _:child4, _:child5, _:child6, _:child7, _:child8\\n  ; bio:birth _:birth\\n  ; bio:death _:death\\n  ; bio:event _:burial, _:accession, _:coronation, _:marriage1\\n            , _:marriage2, _:marriage3, _:marriage4, _:marriage5, _:marriage6\\n  .\\n\\n_:henryvii\\n  a foaf:Person\\n  ; foaf:name &quot;Henry VII Tudor, King of England&quot;\\n  ; bio:child _:henryviii\\n  .\\n\\n_:elizplantagenet\\n  a foaf:Person\\n  ; foaf:name &quot;Elizabeth of York&quot;\\n  ; bio:child _:henryviii\\n  .\\n  \\n_:birth\\n  a bio:Birth\\n  ; rdfs:label &quot;The birth of Henry VIII to Henry VII and Elizabeth Plantagenet on 28 June 1491&quot;\\n  ; bio:date &quot;1491-06-28&quot;\\n  ; bio:place &lt;http://dbpedia.org/resource/Palace_of_Placentia&gt;\\n  ; bio:parent _:henryvii, _:elizplantagenet\\n  ; bio:principal _:henryviii\\n  .\\n\\n_:death\\n  a bio:Death\\n  ; rdfs:label &quot;The death of Henry VIII on 28 January 1547&quot;\\n  ; bio:date &quot;1547-01-28&quot;\\n  ; bio:place &lt;http://dbpedia.org/resource/Palace_of_Whitehall&gt;\\n  ; bio:principal _:henryviii\\n  .\\n  \\n\\n_:accession\\n  a bio:Accession\\n  ; rdfs:label &quot;The accession of Henry VIII to the throne of England on 21 April 1509&quot;\\n  ; bio:date &quot;1509-06-24&quot;\\n  ; bio:principal _:henryviii\\n  ; bio:state &lt;http://dbpedia.org/resource/Kingdom_of_England&gt;\\n  ; bio:immediatelyPrecedingEvent [ a bio:Death\\n                                    ; rdfs:label &quot;The death of Henry VII on 9 May 1509&quot;\\n                                    ; bio:date &quot;1509-05-09&quot;\\n                                    ; bio:place &lt;http://dbpedia.org/resource/Richmond_Palace&gt;\\n                                    ; bio:principal _:henryvii\\n                                  ]\\n  .\\n\\n_:coronation\\n  a bio:Coronation\\n  ; rdfs:label &quot;The coronation of Henry VIII as King of England on 24 June 1509&quot;\\n  ; bio:date &quot;1509-06-24&quot;\\n  ; bio:place &lt;http://dbpedia.org/page/Westminster_Abbey&gt;\\n  ; bio:principal _:henryviii\\n  ; bio:precedingEvent _:accession\\n  .\\n\\n_:burial\\n  a bio:Burial\\n  ; rdfs:label &quot;The burial of Henry VII at St.George's Chapel, Windsor Castle,England&quot;\\n  ; bio:place &lt;http://dbpedia.org/resource/St_George%E2%80%99s_Chapel%2C_Windsor&gt;\\n  ; bio:principal _:henryviii\\n  ; bio:precedingEvent _:death\\n  .\\n\\n_:marriage1\\n  a bio:Marriage\\n  ; rdfs:label &quot;The marriage of Henry VIII and Catherine of Aragon&quot;\\n  ; bio:date &quot;1509-06-11&quot;\\n  ; bio:place &lt;http://dbpedia.org/resource/Palace_of_Placentia&gt;\\n  ; bio:partner _:henryvii, _:catharagon\\n  .\\n\\n_:annulment1\\n  a bio:Annulment\\n  ; rdfs:label &quot;The annulment of the marriage between Henry VIII and Catherine of Aragon&quot;\\n  ; bio:date &quot;1533-05-23&quot;\\n  ; bio:partner _:henryvii, _:catharagon \\n  ; bio:officiator &lt;http://dbpedia.org/resource/Thomas_Cranmer&gt;\\n  .\\n\\n_:catharagon\\n  a foaf:Person\\n  ; foaf:name &quot;Anne Boleyn&quot;\\n  ; bio:child _:child1, _:child2, _:child3, _:child4, _:child5\\n  ; bio:event _:marriage1, _:annulment1\\n  .\\n\\n_:child1\\n  a foaf:Person\\n  ; rdfs:label &quot;Unnamed daughter of Henry VIII and Catherine of Aragon&quot;\\n  ; bio:event [ a bio:Birth\\n                ; bio:date &quot;1510-01-31&quot;\\n                ; bio:principal _:child1\\n                ; bio:parent _:henryviii, _:catharagon\\n              ]\\n  ; bio:event [ a bio:Death\\n                ; bio:date &quot;1510-02-02&quot;\\n                ; bio:principal _:child1\\n              ]\\n  .\\n\\n_:child2\\n  a foaf:Person\\n  ; foaf:name &quot;Henry&quot;\\n  ; bio:event [ a bio:Birth\\n                ; bio:date &quot;1511-01-01&quot;\\n                ; bio:principal _:child2\\n                ; bio:parent _:henryviii, _:catharagon\\n              ]\\n  ; bio:event [ a bio:Death\\n                ; bio:date &quot;1511-02-22&quot;\\n                ; bio:principal _:child2\\n              ]\\n  .\\n  \\n_:child3\\n  a foaf:Person\\n  ; foaf:name &quot;Henry&quot;\\n  ; bio:event [ a bio:Birth\\n                ; bio:date &quot;1514-12&quot;\\n                ; bio:principal _:child3\\n                ; bio:parent _:henryviii, _:catharagon\\n              ]\\n  ; bio:event [ a bio:Death\\n                ; bio:principal _:child3\\n              ]\\n  .\\n\\n_:child4\\n  a foaf:Person\\n  ; foaf:name &quot;Mary&quot;\\n  ; bio:event [ a bio:Birth\\n                ; bio:date &quot;1516-02-18&quot;\\n                ; bio:principal _:child4\\n                ; bio:parent _:henryviii, _:catharagon\\n              ]\\n  ; bio:event [ a bio:Death\\n                ; bio:date &quot;1558-11-17&quot;\\n                ; bio:principal _:child4\\n              ]\\n  .\\n\\n\\n_:child5\\n  a foaf:Person\\n  ; rdfs:label &quot;Unnamed daughter of Henry VIII and Catherine of Aragon&quot;\\n  ; bio:event [ a bio:Birth\\n                ; bio:date &quot;1518-11&quot;\\n                ; bio:principal _:child5\\n                ; bio:parent _:henryviii, _:catharagon\\n              ]\\n  ; bio:event [ a bio:Death\\n                ; bio:principal _:child5\\n              ]\\n  .\\n  \\n\\n_:marriage2\\n  a bio:Marriage\\n  ; rdfs:label &quot;The marriage of Henry VIII and Anne Boleyn&quot;\\n  ; bio:date &quot;1533-01-25&quot;\\n  ; bio:partner _:henryvii, _:anneboleyn\\n  ; bio:place &lt;http://dbpedia.org/resource/Westminster_Abbey&gt;\\n  .\\n\\n_:anneboleyn\\n  a foaf:Person\\n  ; foaf:name &quot;Anne Boleyn&quot;\\n  ; bio:child _:child6\\n  ; bio:event _:marriage2, _:annulment2, _:anneboleyn-death\\n  .\\n\\n_:annulment2\\n  a bio:Annulment\\n  ; rdfs:label &quot;The annulment of the marriage between Henry VIII and Anne Boleyn&quot;\\n  ; bio:date &quot;1536-05-17&quot;\\n  ; bio:partner _:henryvii, _:anneboleyn \\n  .\\n  \\n_:anneboleyn-death\\n  a bio:Execution\\n  ; rdfs:label &quot;The beheading of Anne Boleyn&quot;\\n  ; bio:date &quot;1536-05-19&quot;\\n  ; bio:place &lt;http://dbpedia.org/resource/Tower_of_London&gt;\\n  ; bio:principal _:anneboleyn\\n  .\\n\\n_:child6\\n  a foaf:Person\\n  ; foaf:name &quot;Elizabeth&quot;\\n  ; bio:event [ a bio:Birth\\n                ; bio:date &quot;1533-09-07&quot;\\n                ; bio:principal _:child6\\n                ; bio:parent _:henryviii, _:anneboleyn\\n              ]\\n  ; bio:event [ a bio:Death\\n                ; bio:date &quot;1603-03-24&quot;\\n                ; bio:principal _:child6\\n              ]\\n  .\\n\\n_:marriage3\\n  a bio:Marriage\\n  ; bio:date &quot;1536-05-20&quot;\\n  ; bio:partner _:henryviii, _:janeseymour\\n  ; bio:place &lt;http://dbpedia.org/resource/York_Place&gt;\\n  .\\n\\n_:janeseymour\\n  a foaf:Person\\n  ; foaf:name &quot;Jane Seymour&quot;\\n  ; bio:event _:marriage3, _:janeseymour-death\\n  ; bio:child _:child7\\n  .\\n\\n_:janeseymour-death\\n  a bio:Death\\n  ; rdfs:label &quot;The death of Jane Seymour on 24 October 1537&quot;\\n  ; bio:date &quot;1537-10-24&quot;\\n  ; bio:principal _:janeseymour\\n  ; bio:place &lt;http://dbpedia.org/resource/Hampton_Court_Palace&gt;\\n  .\\n  \\n\\n_:child7\\n  a foaf:Person\\n  ; foaf:name &quot;Edward&quot;\\n  ; bio:event [ a bio:Birth\\n                ; bio:date &quot;1537-10-12&quot;\\n                ; bio:principal _:child7\\n                ; bio:parent _:henryviii, _:janeseymour\\n                ; bio:place &lt;http://dbpedia.org/resource/Hampton_Court_Palace&gt;\\n              ]\\n  ; bio:event [ a bio:Accession\\n                ; bio:immediatelyPrecedingEvent _:death\\n              ]\\n  ; bio:event [ a bio:Death\\n                ; bio:date &quot;1553-07-06&quot;\\n                ; bio:principal _:child7\\n                ; bio:place &lt;http://dbpedia.org/resource/Palace_of_Placentia&gt;\\n              ]\\n  .\\n\\n_:marriage4\\n  a bio:Marriage\\n  ; bio:date &quot;1540-01-06&quot;\\n  ; bio:partner _:henryvii, _:annecleves\\n  ; bio:place &lt;http://dbpedia.org/resource/Palace_of_Placentia&gt;\\n  ; bio:officiator &lt;http://dbpedia.org/resource/Thomas_Cranmer&gt;\\n  .\\n    \\n_:annulment3\\n  a bio:Annulment\\n  ; rdfs:label &quot;The annulment of the marriage between Henry VIII and Anne of Cleves&quot;\\n  ; bio:date &quot;1540-07-09&quot;\\n  ; bio:partner _:henryviii, _:annecleves\\n  .\\n\\n_:annecleves\\n  a foaf:Person\\n  ; foaf:name &quot;Anne of Cleves&quot;\\n  ; bio:event _:marriage4, _:annulment3\\n  .\\n\\n_:marriage5\\n  a bio:Marriage\\n  ; bio:date &quot;1540-07-28&quot;\\n  ; bio:partner _:henryviii, _:cathhoward\\n  ; bio:place &lt;http://dbpedia.org/resource/Oatlands_Palace&gt;\\n  .\\n  \\n_:cathhoward\\n  a foaf:Person\\n  ; foaf:name &quot;Catherine Howard&quot;\\n  ; bio:event _:marriage5, _:cathhoward-death\\n  .\\n  \\n_:cathhoward-death\\n  a bio:Execution\\n  ; rdfs:label &quot;The beheading of Catherine Howard&quot;\\n  ; bio:date &quot;1542-02-13&quot;\\n  ; bio:place &lt;http://dbpedia.org/resource/Tower_of_London&gt;\\n  ; bio:principal _:cathhoward\\n  .\\n\\n_:marriage6\\n  a bio:Marriage\\n  ; rdfs:label &quot;The marriage between Henry VIII and Catherine Parr&quot;\\n  ; bio:date &quot;1543-07-12&quot;\\n  ; bio:place &lt;http://dbpedia.org/resource/Hampton_Court_Palace&gt;\\n  ; bio:partner _:henryviii, _:cathparr\\n  .\\n  \\n_:cathparr\\n  a foaf:Person\\n  ; foaf:name &quot;Catherine Parr&quot;\\n  ; bio:event _:marriage6\\n  .\\n\\n\\n_:elizblount\\n  a foaf:Person\\n  ; foaf:name &quot;Elizabeth Blount&quot;\\n  ; bio:child _:child8\\n  .\\n  \\n_:child8\\n  a foaf:Person\\n  ; foaf:name &quot;Henry FitzRoy&quot;\\n  ; foaf:mother _:elizblount\\n  ; foaf:father _:henryviii\\n  ; bio:event [ a bio:Birth\\n                ; bio:principal _:child8\\n                ; bio:date &quot;1519-06-15&quot;\\n                ; bio:parent _:henryviii, _:elizblount\\n                ; bio:place &lt;http://dbpedia.org/resource/Blackmore&gt;\\n                ]\\n  .\\n\\n_:marriage1-interval\\n  a bio:Interval\\n  ; rdfs:label &quot;The period of time during which Henry VIII and Catherine of Aragon were married&quot;\\n  ; bio:initiatingEvent _:marriage1\\n  ; bio:concludingEvent _:annulment1\\n  .\\n\\n_:marriage2-interval\\n  a bio:Interval\\n  ; rdfs:label &quot;The period of time during which Henry VIII and Anne Boleyn were married&quot;\\n  ; bio:initiatingEvent _:marriage2\\n  ; bio:concludingEvent _:annulment2\\n  .\\n  \\n_:marriage3-interval\\n  a bio:Interval\\n  ; rdfs:label &quot;The period of time during which Henry VIII and Jane Seymour were married&quot;\\n  ; bio:initiatingEvent _:marriage3\\n  ; bio:concludingEvent _:janeseymour-death\\n  .\\n\\n_:marriage4-interval\\n  a bio:Interval\\n  ; rdfs:label &quot;The period of time during which Henry VIII and Anne of Cleves were married&quot;\\n  ; bio:initiatingEvent _:marriage4\\n  ; bio:concludingEvent _:annulment3\\n  .\\n\\n_:marriage5-interval\\n  a bio:Interval\\n  ; rdfs:label &quot;The period of time during which Henry VIII and Catherine Howard were married&quot;\\n  ; bio:initiatingEvent _:marriage5\\n  ; bio:terminatingEvent _:cathhoward-death\\n  .\\n\\n_:marriage6-interval\\n  a bio:Interval\\n  ; rdfs:label &quot;The period of time during which Henry VIII and Catherine Parr were married&quot;\\n  ; bio:initiatingEvent _:marriage6\\n  ; bio:terminatingEvent _:henryviii-death\\n  .\\n</code></pre>\\n"^^rdf:XMLLiteral .

<http://vocab.org/bio/0.1/.html> a dcmitype:Text,
        foaf:Document ;
    rdfs:label "HTML" ;
    dc:format "text/html" .

<http://vocab.org/bio/0.1/.json> a dcmitype:Text,
        foaf:Document ;
    rdfs:label "JSON" ;
    dc:format "application/json" .

<http://vocab.org/bio/0.1/.turtle> a dcmitype:Text,
        foaf:Document ;
    rdfs:label "Turtle" ;
    dc:format "text/plain" .

onto:Birth a owl:Class ;
    rdfs:label "Birth"@en ;
    vann:example [ a ns3:SchemaExample ;
            rdfs:label "The birth of Albert Einstein" ;
            rdfs:comment "\\n        <pre><code>_:e a bio:Birth \\n    ; dc:date &quot;1879-03-14&quot;\\n    ; bio:principal &lt;http://dbpedia.org/resource/Albert_Einstein&gt;\\n    ; bio:parent &lt;http://dbpedia.org/resource/Pauline_Koch&gt;\\n    ; bio:parent &lt;http://dbpedia.org/resource/Hermann_Einstein&gt;\\n    ; bio:place &lt;http://dbpedia.org/resource/Ulm&gt;\\n    .</code></pre>\\n"^^rdf:XMLLiteral ] ;
    rdfs:comment "The event of a person entering into life."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "testing" ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Marked as testing" ] .

onto:Interval a owl:Class ;
    rdfs:label "Interval"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "A extended interval of time related to a particular state of affairs, such as the lifespan of a person or a period of employment."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf time:ProperInterval ;
    ns1:term_status "unstable" .

onto:Murder a owl:Class ;
    rdfs:label "Murder"@en ;
    dcterms:issued "2010-05-05" ;
    rdfs:comment "The event of a person being killed unlawfully with intent by the killer."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:Death ;
    ns1:term_status "unstable" .

onto:father a rdf:Property,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Father"@en ;
    dcterms:issued "2010-05-03" ;
    vann:usageNote "Note that this is a strict definition of father that does not include non-biological relationships. The <a href=\"http://purl.org/vocab/relationship\">Relationship</a> vocabulary may be more suitable for broader types of parent/child relation."^^rdf:XMLLiteral ;
    rdfs:comment "The biological father of a person, also known as the genitor."@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf <http://purl.org/vocab/relationship/childOf>,
        owl:differentFrom ;
    ns1:term_status "unstable" ;
    skos:historyNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-06-06" ;
            rdf:value "Made subproperty of rel:childOf on suggestion of Gautier Poupeau" ] .

onto:followingEvent a rdf:Property,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Following Event"@en ;
    dcterms:issued "2010-05-06" ;
    ns4:plural "Following Events"@en ;
    rdfs:comment "An event that starts at some time after this event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Event ;
    rdfs:subPropertyOf owl:differentFrom .

onto:mother a rdf:Property,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Mother"@en ;
    dcterms:issued "2010-05-03" ;
    vann:usageNote "Note that this is a strict definition of mother that does not include non-biological relationships. The <a href=\"http://purl.org/vocab/relationship\">Relationship</a> vocabulary may be more suitable for broader types of parent/child relation."^^rdf:XMLLiteral ;
    rdfs:comment "The biological mother of a person, also known as the genetrix."@en ;
    rdfs:domain foaf:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf <http://purl.org/vocab/relationship/childOf>,
        owl:differentFrom ;
    ns1:term_status "unstable" ;
    skos:historyNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-06-06" ;
            rdf:value "Made subproperty of rel:childOf on suggestion of Gautier Poupeau" ] .

onto:partner a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Partner"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Partners"@en ;
    rdfs:comment "A person that is involved in a event as a partner in a relationship."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf onto:agent .

onto:precedingEvent a rdf:Property,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Preceding Event"@en ;
    dcterms:issued "2010-05-06" ;
    ns4:plural "Preceding Events"@en ;
    rdfs:comment "An event that occurs and concludes at some time before this event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Event ;
    rdfs:subPropertyOf owl:differentFrom .

onto:principal a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Principal"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Principals"@en ;
    rdfs:comment "A person that takes the primary and most important role in an event. For example the principal in a Birth event would be the child being born and the principal in a Burial event would be the deceased person."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf onto:agent .

onto:spectator a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Spectator"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Spectators"@en ;
    rdfs:comment "A person that is present at and observes the occurrence of at least part of an event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Person ;
    rdfs:subPropertyOf onto:agent .

onto:PositionChange a owl:Class ;
    rdfs:label "Change of Position"@en ;
    dcterms:issued "2010-05-03" ;
    rdfs:comment "The event of a person changing the position they hold with an employer."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "unstable" .

onto:Relationship a owl:Class ;
    rdfs:label "Agent Relationship"@en ;
    dcterms:issued "2011-06-14" ;
    rdfs:comment "A particular type of connection existing between people, groups or organizations related to or having dealings with each other."@en ;
    rdfs:isDefinedBy onto: ;
    owl:equivalentClass <http://purl.org/vocab/relationship/Relationship> ;
    ns1:term_status "unstable" .

onto:Death a owl:Class ;
    rdfs:label "Death"@en ;
    vann:example [ a ns3:SchemaExample ;
            rdfs:label "The death of Albert Einstein" ;
            rdfs:comment "\\n        <pre><code>_:e a bio:Death \\n    ; dc:date &quot;1955-04-18&quot;\\n    ; bio:principal &lt;http://dbpedia.org/resource/Albert_Einstein&gt;\\n    ; bio:place &lt;http://dbpedia.org/resource/Princeton,_New_Jersey&gt;\\n    .</code></pre>\\n"^^rdf:XMLLiteral ] ;
    rdfs:comment "The event of a person's life ending."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf onto:IndividualEvent ;
    ns1:term_status "stable" ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Marked as a stable term" ] .

onto:event a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Life Event"@en ;
    ns4:plural "Life Events"@en ;
    rdfs:comment "An event associated with a person, group or organization."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range onto:Event ;
    rdfs:subPropertyOf owl:differentFrom ;
    owl:inverseOf onto:agent ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-03" ;
            rdf:value "Added a plural label" ] ;
    skos:historyNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2011-06-14" ;
            rdf:value "Changed domain to foaf:Agent" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-03" ;
            rdf:value "Made a subproperty of owl:differentFrom" ] .

onto:GroupEvent a owl:Class ;
    rdfs:label "Group Event"@en ;
    rdfs:comment "A type of event that is principally about one or more agents and their partnership. Other agents may be involved but the event is most significant for the partner agent."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:partner ],
        onto:Event ;
    ns1:term_status "unstable" .

onto:agent a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Agent"@en ;
    dcterms:issued "2010-05-05" ;
    ns4:plural "Agents"@en ;
    rdfs:comment "A person, organization or group that plays a role in an event."@en ;
    rdfs:domain onto:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf owl:differentFrom ;
    owl:inverseOf onto:event .

foaf:Person a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:father ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty onto:mother ] ) ] .

onto:IndividualEvent a owl:Class ;
    rdfs:label "Individual Event"@en ;
    rdfs:comment "A type of event that is principally about a single person, group or organization. Other agents may be involved but the event is most significant for the principal agent."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty onto:principal ],
        onto:Event ;
    ns1:term_status "unstable" .

onto:Event a owl:Class ;
    rdfs:label "Event"@en ;
    vann:usageNote "This class is intended to describe biographical events, i.e. events in the life of a person."@en ;
    rdfs:comment "An event is an occurrence that brings about a change in the state of affairs for one or more people and/or other agents. Events are assumed to occur over a period of time and may not have precise start and end points."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://linkedevents.org/ontology/Event>,
        <http://purl.org/NET/c4dm/event.owl#Event>,
        dcmitype:Event,
        <http://sw.opencyc.org/2009/04/07/concept/en/Event> ;
    ns1:term_status "testing" ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-20" ;
            rdf:value "Marked as testing status" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Marked as a stable term" ] ;
    skos:historyNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-20" ;
            rdf:value "Removed subclass of owl-time ProperInteval" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-04" ;
            rdf:value "Made equivalent to cyc:Event" ] .

onto: a owl:Ontology ;
    ns3:discussionList <http://lists.foaf-project.org/mailman/listinfo/foaf-dev> ;
    dcterms:abstract "This document describes a vocabulary for describing biographical information about people, both living and dead. "@en ;
    dcterms:creator <http://iandavis.com/id/me>,
        "David Galbraith" ;
    dcterms:date "2010-05-10"^^xsd:date ;
    dcterms:description "<div>\\n        \\n        <p>The BIO vocabulary contains terms useful for finding out more about people and their backgrounds and has some cross-over into genealogical information. \\n        The approach taken is to describe a person's life as a series of interconnected key events, around which other information can be woven. \\n        This vocabulary defines the event framework and supplies a set of core event types that cover many use cases, but it is expected that it \\n        will be extended in other vocabularies to suit their needs. The intention of this vocabulary is to describe biographical events of people \\n        and this intention carries through to the definitions of the properties and classes which are person-centric rather than neutral. For example \\n        the Employment event puts the person being employed as the principal agent in the event rather than the employer.</p>\\n        <p>The BIO vocabulary defines a number of core classes and properties for describing biographical information: </p>\\n        <p><figure><img src=\"/bio/core-classes.png\"/><br/>Figure: Biography Vocabulary Core Classes (<a href=\"http://vocab.org/bio/core-classes.png\">PNG version</a>, <a href=\"http://vocab.org/bio/core-classes.svg\">SVG version</a>)</figure></p>\\n        <p>At its heart the BIO vocabulary is concerned with people, their relationships and the events in their lives. Together these can be\\n        used to build up a narrative of a person's life and their interactions with other people, organizations and the world around them. Events bound intervals\\n        of time that may be associated with particular relationships between people and groups or organisations. Many different types of life event are\\n        defined in this vocabulary including the obvious Birth, Marriage and Death but also Coronation, Performance and even Murder. These events are not intended\\n        to be fully comprehensive but are representative of the types of events associated with biographical material. Currently the relationship segment of the\\n        vocabulary is underspecified with only a generic Relationship class available. It is envisaged that many types of relationship such as families, employments\\n        and ownerships will be specified in the future.</p>\\n        <p>The sequence of events and intervals build a timeline of history against which people and their relationships can be placed. The aim is\\n        to enable simple forms of genealogical reasoning such as determining whether a child was born out of wedlock or the location of a family\\n        given the fact one of their children was attending a particular school. Events are ordered in time by relating them to one another and to abstract\\n        intervals of time:</p>\\n        <p><figure><img src=\"/bio/timelines.png\"/><br/>Figure: Biography Vocabulary Timelines(<a href=\"http://vocab.org/bio/timelines.png\">PNG version</a>, <a href=\"http://vocab.org/bio/timelines.svg\">SVG version</a>)</figure></p>\\n        <p>Please see <a href=\"https://github.com/iand/vocab-bio\">https://github.com/iand/vocab-bio</a> for the master version of this vocabulary.</p>\\n      </div>"^^rdf:XMLLiteral ;
    dcterms:identifier "http://purl.org/vocab/bio/0.1/schema" ;
    dcterms:issued "2003-03-07"^^xsd:date ;
    dcterms:rights "Copyright © 2002-2010 Ian Davis and David Galbraith" ;
    dcterms:title "BIO: A vocabulary for biographical information"@en ;
    vann:example <http://purl.org/vocab/bio/examples/1> ;
    vann:preferredNamespacePrefix "bio" ;
    vann:preferredNamespaceUri "http://purl.org/vocab/bio/0.1/" ;
    vann:termGroup onto:termgroup1,
        onto:termgroup2,
        onto:termgroup3,
        onto:termgroup4,
        onto:termgroup5 ;
    skos:changeNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-20" ;
            rdf:value "Batch of revisions based on community feedback" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2011-06-14" ;
            rdf:value "Expanded description and added diagrams" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2005-04-01" ;
            rdf:value "Added examples" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2009-05-19" ;
            rdf:value "Minor changes to improve publishing process" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2004-03-05" ;
            rdf:value "Added Creative Commons license" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-04-20" ;
            rdf:value "Added change history" ] ;
    skos:historyNote [ dcterms:creator "Ian Davis" ;
            dcterms:date "2011-06-10" ;
            rdf:value "Added bio:Formation and bio:Disbanding events" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2011-06-14" ;
            rdf:value "Added bio:Relationship class and properties" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-05-10" ;
            rdf:value "Major expansion of properties and classes" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-06-05" ;
            rdf:value "Added biography property" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2010-06-06" ;
            rdf:value "Added subproperty and equivalent property relations for bio:father, bio:mother and bio:child" ],
        [ dcterms:creator "Alexandre Passant" ;
            dcterms:date "2011-06-14" ;
            rdf:value "Added properties for Birth and Death Event types, motivated by JSON serialisations of RDF" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2003-07-28" ;
            rdf:value "Added keywords property" ],
        [ dcterms:creator "Ian Davis" ;
            dcterms:date "2011-06-10" ;
            rdf:value "Added bio:Performance event" ] .

