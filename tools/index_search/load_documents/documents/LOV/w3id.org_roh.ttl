<http://w3id.org/roh/mirror/oa#editing> a <http://w3id.org/roh/mirror/oa#Motivation>,
        owl:NamedIndividual ;
    rdfs:label "editing" ;
    rdfs:comment "The motivation for when the user intends to request a change or edit to the Target resource." ;
    rdfs:isDefinedBy <http://www.w3.org/ns/oa#> .

<http://w3id.org/roh/mirror/oa#hasBody> a owl:AnnotationProperty ;
