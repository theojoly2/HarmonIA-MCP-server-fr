    rdfs:comment "ROH will be populated with instance data of UNESCO skos concepts. A Person, Activity, Project and Organization can be qualified by a KnowledgeArea" ;
    rdfs:subClassOf ns1:ConceptScheme ;
    owl:disjointWith ns4:ProjectClassification,
        <http://w3id.org/roh/mirror/obo/bfo#BFO_0000015> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000071> a owl:Class ;
    rdfs:label "Software"@en ;
    ns2:IAO_0000111 "software" ;
    ns2:IAO_0000112 "Microsoft Word is commonly used word processing software." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A general term primarily used for digitally stored data such as computer programs and other kinds of information read and written by computers." ;
    ns2:IAO_0000117 "PERSON: Melissa Haendel" ;
    ns2:IAO_0000119 "http://en.wikipedia.org/wiki/Computer_software" ;
    rdfs:comment "IAO is a planned specification, in SWO is an Information artifact. In eagle-i, we have a need to collect material instances and is it thus currently classified as a material entity." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdf:Seq ;
            owl:onProperty ns4:seqOfAuthors ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateTimeValue ],
        [ a owl:Restriction ;
            owl:onProperty ns4:title ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:platform ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:Repository ;
            owl:onProperty ns4:partOfRepository ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns4:seqOfAuthors ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:License ;
            owl:onProperty ns4:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
