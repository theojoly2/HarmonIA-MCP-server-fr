ns4:utilizes a owl:ObjectProperty ;
    rdfs:label "utilizes"@en ;
    rdfs:domain ns4:ResearchContribution ;
    rdfs:range ns4:ResearchMaterial ;
    rdfs:subPropertyOf ns2:RO_0000057 .

ns10:EditedBook a owl:Class ;
    rdfs:label "Edited Book"@en ;
    rdfs:comment "An edited book."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf ns10:CollectedDocument ;
    owl:disjointWith ns10:Issue ;
    ns5:term_status "stable" .

ns10:Manual a owl:Class ;
    rdfs:label "Manual"@en ;
    ns1:altLabel "Handbook"@en ;
    ns1:prefLabel "Manual"@en ;
