<http://w3id.org/roh/mirror/obo/bfo#BFO_0000004> rdfs:label "independent continuant"@en .

<http://w3id.org/roh/mirror/obo/bfo#BFO_0000054> a owl:ObjectProperty ;
    rdfs:label "realized in"@en ;
    ns2:BFO_0000179 "realized-in" ;
    ns2:BFO_0000180 "realizedIn" ;
    ns2:IAO_0000600 "[copied from inverse property 'realizes'] to say that b realizes c at t is to assert that there is some material entity d & b is a process which has participant d at t & c is a disposition or role of which d is bearer_of at t& the type instantiated by b is correlated with the type instantiated by c. (axiom label in BFO2 Reference: [059-003])" ;
    ns2:IAO_0000601 "if a realizable entity b is realized in a process p, then p stands in the has_participant relation to the bearer of b. (axiom label in BFO2 Reference: [106-002])"@en ;
    ns2:IAO_0000602 "(forall (x y z t) (if (and (RealizableEntity x) (Process y) (realizesAt y x t) (bearerOfAt z x t)) (hasParticipantAt y z t))) // axiom label in BFO2 CLIF: [106-002]" ;
    rdfs:domain <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> ;
    rdfs:isDefinedBy ns2:bfo.owl ;
    rdfs:range <http://w3id.org/roh/mirror/obo/bfo#BFO_0000015> ;
    owl:inverseOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000055> .

<http://w3id.org/roh/mirror/obo/bfo#BFO_0000179> a owl:AnnotationProperty .

<http://w3id.org/roh/mirror/obo/bfo#BFO_0000180> a owl:AnnotationProperty .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000395> a owl:Class ;
    rdfs:label "Material Analysis Service"@en ;
    ns2:IAO_0000112 "Flow cytometry analysis of T cells." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "An analysis service offering that describes a service in which the consumer provides some input material and a service provider performs some analysis of this material to generate data that is returned to the service consumer." ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
    ns2:IAO_0000119 "http://neurolex.org/wiki/Category:Analysis_service_resource" ;
    rdfs:comment "Coordinate with NIF: NIF ID: nlx_res_20090420" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0001261> ;
    owl:disjointWith <http://w3id.org/roh/mirror/obo/ero#ERO_0001262> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000396> a owl:Class ;
    rdfs:label "Material Production Service"@en ;
    ns2:IAO_0000112 "Production of monoclonal antibodies from a hybridoma." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A material processing service offering that describes a service in which the provider makes physical changes to a specified input material that produce a new entity as specified output that is returned the service consumer.  The specified output of a material production service can be contained within, derived from, or synthesized from specified input materials, but it represents a material entity that is of a distinct type from any of the specified input materials." ;
    ns2:IAO_0000117 "PERSON: Matthew Brush" ;
    ns2:IAO_0000119 "http://neurolex.org/wiki/Category:Material_service_resource" ;
    rdfs:comment "Coordinate with NIF. NIF ID: nlx_res_20090418" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000394> ;
    owl:disjointWith <http://w3id.org/roh/mirror/obo/ero#ERO_0001263> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000785> a owl:Class ;
    rdfs:label "Graduate Student Role"@en ;
    ns2:IAO_0000112 "A PhD student at a university." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A student role inhering in a person that is realized when the bearer participates a course of study at a university or institution in pursuit of an graduate or professional degree." ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
    ns2:IAO_0000119 "http://www.thefreedictionary.com/student" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000783> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000786> a owl:Class ;
