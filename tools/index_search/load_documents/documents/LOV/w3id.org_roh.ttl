                    owl:unionOf ( ns4:Closed ns4:Open ) ] ;
            owl:onProperty ns4:repositoryStatus ],
        [ a owl:Restriction ;
            owl:onProperty ns4:title ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:License ;
            owl:onProperty ns4:hasLicense ],
        [ a owl:Restriction ;
            owl:onProperty ns4:seqOfAuthors ;
            owl:someValuesFrom rdf:Seq ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns10:Webpage ;
            owl:onProperty <http://w3id.org/roh/mirror/foaf#homepage> ],
