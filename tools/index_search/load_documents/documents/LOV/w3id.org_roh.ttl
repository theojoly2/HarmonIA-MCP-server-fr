    ns2:IAO_0000112 "A post-doctoral fellow." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A student role inhering in a person that is realized when the bearer participates in a post-graduate training program in pursuit of new or additional training in a particular field, such as a post-doctoral fellowship." ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
