    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A maintenance service offering that describes a service in which the provider actively maintains a material resource (e.g. a model organism colony) for the service consumer.  A material maintenance service may or may not include storage of the material input." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0001258> ;
    owl:disjointWith <http://w3id.org/roh/mirror/obo/ero#ERO_0001260> .

<http://w3id.org/roh/mirror/obo/iao#IAO_0000013> a owl:Class ;
    rdfs:label "Journal Article"@en ;
    ns2:IAO_0000111 "journal article"@en ;
    ns2:IAO_0000112 "Examples are articles published in the journals, Nature and Science. The content can often be cited by reference to a paper based encoding, e.g.  Authors, Title of article, Journal name, date or year of publication, volume and page number."@en ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "a report that is published in a journal"@en ;
    ns2:IAO_0000117 "person:Alan Ruttenberg"@en,
        "person:Chris Stoeckert"@en ;
    ns2:IAO_0000119 "OBI_0000159"@en,
        "group:OBI"@en ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/obo/iao#IAO.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:hasPublicationVenue ;
            owl:someValuesFrom ns10:Journal ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:PublicationMetric ;
            owl:onProperty ns4:hasMetric ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateIssued ],
        ns10:AcademicArticle .

