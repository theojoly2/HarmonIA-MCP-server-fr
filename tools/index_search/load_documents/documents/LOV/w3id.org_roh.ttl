    ns2:IAO_0000112 "Cryopreservation service." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A storage service offering that describes a service in which the consumer provides some material as input which a service provider stores and returns as output" ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
