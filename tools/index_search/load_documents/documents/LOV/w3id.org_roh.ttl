    rdfs:domain ns10:Patent ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Person> .

ns4:patentPrimaryExaminer a owl:ObjectProperty ;
    rdfs:label "patent primary examiner"@en ;
