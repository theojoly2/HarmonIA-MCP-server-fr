            owl:unionOf ( ns10:Document <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> ) ] .

ns4:reviews a owl:ObjectProperty ;
    rdfs:label "reviews"@en ;
    rdfs:comment "a proerty to link a person to a publication as a reviewer."@en ;
