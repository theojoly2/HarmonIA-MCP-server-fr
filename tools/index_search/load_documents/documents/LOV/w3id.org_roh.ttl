@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://w3id.org/roh/mirror/skos#> .
@prefix ns10: <http://w3id.org/roh/mirror/bibo#> .
@prefix ns2: <http://purl.obolibrary.org/obo/> .
@prefix ns3: <http://w3id.org/roh/mirror/vivo#> .
@prefix ns4: <http://w3id.org/roh#> .
@prefix ns5: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix ns6: <https://xmlns.com/foaf/0.1/> .
@prefix ns7: <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#> .
@prefix ns8: <https://w3id.org/roh/mirror/dc/terms/> .
@prefix ns9: <http://w3id.org/roh/mirror/obo/ro#> .
@prefix onto: <http://w3id.org/roh> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://prismstandard.org/namespaces/1.2/basic/endingPage> a owl:DatatypeProperty ;
    rdfs:label "ending page"@en ;
    rdfs:comment "Ending page number within a continuous page range."@en ;
    owl:equivalentProperty ns10:pageEnd .

<http://prismstandard.org/namespaces/1.2/basic/issue> a owl:DatatypeProperty ;
    rdfs:label "issue"@en ;
    rdfs:comment "A single copy of a newspaper or magazine."@en ;
    owl:equivalentProperty ns10:issue .

<http://prismstandard.org/namespaces/1.2/basic/startingPage> a owl:DatatypeProperty ;
    rdfs:label "starting page"@en ;
    rdfs:comment "Starting page number within a continuous page range."@en ;
    owl:equivalentProperty ns10:pageStart .

<http://prismstandard.org/namespaces/1.2/basic/volume> a owl:DatatypeProperty ;
    rdfs:label "volume"@en ;
    rdfs:comment "A volume number"@en ;
    owl:equivalentProperty ns10:volume .

ns2:BFO_0000179 a owl:AnnotationProperty .

ns2:BFO_0000180 a owl:AnnotationProperty .

ns2:IAO_0000111 a owl:AnnotationProperty .

ns2:IAO_0000112 a owl:AnnotationProperty .

ns2:IAO_0000114 a owl:AnnotationProperty .

ns2:IAO_0000116 a owl:AnnotationProperty .

ns2:IAO_0000117 a owl:AnnotationProperty .

ns2:IAO_0000118 a owl:AnnotationProperty .

ns2:IAO_0000119 a owl:AnnotationProperty .

ns2:IAO_0000412 a owl:AnnotationProperty .

ns2:IAO_0000600 a owl:AnnotationProperty .

ns2:IAO_0000601 a owl:AnnotationProperty .

ns2:IAO_0010000 a owl:AnnotationProperty .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

<http://purl.org/iso25964/skos-thes#microThesaurusOf> a owl:AnnotationProperty .

<http://purl.org/iso25964/skos-thes#subGroup> a owl:AnnotationProperty .

<http://purl.org/iso25964/skos-thes#superGroup> a owl:AnnotationProperty .

<http://purl.org/umu/uneskos#hasMainConcept> a owl:AnnotationProperty .

<http://purl.org/umu/uneskos#hasMicroThesaurus> a owl:AnnotationProperty .

<http://purl.org/umu/uneskos#mainConceptOf> a owl:AnnotationProperty .

<http://purl.org/umu/uneskos#memberOf> a owl:AnnotationProperty .

ns7:descriptionAnnot a owl:AnnotationProperty .

ns7:exampleAnnot a owl:AnnotationProperty .

ns4:Administrative a owl:Class ;
    rdfs:label "Administrative"@en ;
    rdfs:subClassOf ns3:AdministratorRole .

ns4:AdministrativeEntity a owl:Class ;
    rdfs:label "Administrative entities"@en,
        "Entités administratives"@fr ;
    ns1:prefLabel "Administrative entities"@en,
        "Entités administratives"@fr ;
    rdfs:comment "This vertical module in ASIO models all the relevant administrative bodies (\"Administración Autonómica\") of Spain's Autonomous Communities (conserjerías, departamentos, secretarías) that might have a role (funding, participating) within the development of a given project. It is modeled hierarchically through the relevant administrative levels thereof."@en ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:BachelorsDegreeSubject a owl:Class ;
    rdfs:label "Bachelor's degree subject"@en ;
    rdfs:subClassOf ns4:AcademicSubject .

ns4:CVOf a owl:ObjectProperty ;
    rdfs:label "CV of"@en ;
    rdfs:comment "An object property linking a CV to the person it belongs to."@en ;
    rdfs:domain ns4:CurriculumVitae ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Person> ;
    owl:inverseOf ns4:hasCV .

ns4:Cancelled a owl:Class ;
    rdfs:label "Cancelled"@en ;
    rdfs:subClassOf ns4:Status .

ns4:CaseStudy a owl:Class ;
    rdfs:label "Case study"@en ;
    rdfs:comment "A qualitative descriptive research study of individuals or a group."@en ;
    rdfs:subClassOf ns10:Document .

ns4:Catalog a owl:Class ;
    rdfs:label "Catalog"@en ;
    rdfs:comment "A list of items in a collection; an ordered compilation of item descriptions and sufficient information to afford access to them."@en ;
    rdfs:subClassOf ns10:Document .

ns4:Contest a owl:Class ;
    rdfs:label "Contest"@en ;
    rdfs:subClassOf ns4:Activity .

ns4:Database a owl:Class ;
    rdfs:label "Database"@en ;
    rdfs:subClassOf ns10:CollectedDocument .

ns4:DisseminationEvent a owl:Class ;
    rdfs:label "Dissemination Event"@en ;
    rdfs:subClassOf ns4:Activity .

ns4:EditedPublication a owl:Class ;
    rdfs:label "Edited publication"@en ;
    rdfs:subClassOf ns10:Document .

ns4:EthicalAudit a owl:Class ;
    rdfs:label "EthicalAudit"@en ;
    rdfs:subClassOf ns4:EthicalReport ;
    owl:disjointWith ns4:EthicalValidation .

ns4:EuropeanAgriculturalGuaranteeFund a ns4:FundingSource,
        owl:NamedIndividual ;
    rdfs:label "European Agricultural Guarantee Fund"@en ;
    rdfs:comment "A fund allocated by the European Union. It finances direct payments to farmers under the Common Agricultural Policy (CAP) and measures to regulate agricultural markets such as intervention and export refunds."@en .

ns4:EuropeanMaritimeAndFisheriesFund a ns4:FundingSource,
        owl:NamedIndividual ;
    rdfs:label "European Maritime and Fisheries Fund"@en ;
    rdfs:comment "The EMFF is the fund for the EU's maritime and fisheries policies for 2014-2020."@en .

ns4:EuropeanRegionalDevelopmentFund a ns4:FundingSource,
        owl:NamedIndividual ;
    rdfs:label "European Regional Development Fund"@en ;
    rdfs:comment "A fund allocated by the European Union. Its purpose is to transfer money from richer regions (not countries), and invest it in the infrastructure and services of underdeveloped regions. This will allow those regions to start attracting private sector investments, and create jobs on their own."@en .

ns4:EuropeanSocialFund a ns4:FundingSource,
        owl:NamedIndividual ;
    rdfs:label "European Social Fund"@en ;
    rdfs:comment "It is one of the European Structural and Investment Funds (ESIF), which are dedicated to improving social cohesion and economic well-being across the regions of the Union. The funds are redistributive financial instruments that support cohesion within Europe by concentrating spending on the less-developed regions."@en .

ns4:EventOrganiser a owl:Class ;
    rdfs:label "Event organiser"@en ;
    rdfs:comment "A role of organising cientific events, such as conferences, workshops, etc."@en ;
    rdfs:subClassOf ns3:OrganizerRole .

ns4:FacultyPositionEmeritus a owl:Class ;
    rdfs:label "Faculty Position Emeritus"@en ;
    rdfs:comment "A retired professor who has retained their rank, title and privileges."@en ;
    rdfs:subClassOf ns3:FacultyPosition .

ns4:Funded a owl:Class ;
    rdfs:label "Funded"@en ;
    rdfs:subClassOf ns4:Status .

ns4:LibrarianPositionEmeritus a owl:Class ;
    rdfs:label "Librarian Position Emeritus"@en ;
    rdfs:comment "A retired librarian who has retained their rank, title and privileges."@en ;
    rdfs:subClassOf ns3:LibrarianPosition .

ns4:ManagementUnit a owl:Class ;
    rdfs:label "ManagementUnit"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/foaf#Organization> .

ns4:MastersDegreeSubject a owl:Class ;
    rdfs:label "Master's degree subject"@en ;
    rdfs:comment "Matière de maîtrise"@fr-ca,
        "Matière de master"@fr-fr ;
    rdfs:subClassOf ns4:AcademicSubject .

ns4:MastersStudent a owl:Class ;
    rdfs:label "Master's Student"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000783> .

ns4:ORCID a owl:DatatypeProperty ;
    rdfs:label "ORCID"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:subPropertyOf ns3:identifier .

ns4:PanelTalk a owl:Class ;
    rdfs:label "Panel Talk"@en ;
    rdfs:comment "A group of people gathered to discuss a topic in front of an audience, typically at scientific, business, or academic conferences, fan conventions, and on television shows. Panels usually include a moderator who guides the discussion and sometimes elicits audience questions, with the goal of being informative and entertaining"@en ;
    rdfs:subClassOf ns3:Presentation ;
    owl:disjointWith ns3:InvitedTalk .

ns4:PhDThesisMetric a owl:Class ;
    rdfs:label "PhD Thesis Metric"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:mark ],
        [ a owl:Restriction ;
            owl:onProperty ns4:cumLaude ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty ns4:mark ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ns4:cumLaude ],
        ns4:ThesisMetric .

ns4:ProformaInvoice a owl:Class ;
    rdfs:label "Proforma invoice"@en ;
    rdfs:subClassOf ns4:Invoice .

ns4:Prototype a owl:Class ;
    rdfs:label "Prototype"@en ;
    rdfs:comment "A product prototype"@en ;
    rdfs:subClassOf ns4:Product .

ns4:RadioProgram a owl:Class ;
    rdfs:label "Radio Program"@en ;
    rdfs:subClassOf ns10:AudioVisualDocument ;
    owl:disjointWith ns4:TvProgram .

ns4:ResearchInstitute a owl:Class ;
    rdfs:label "Research institute"@en,
        "Centre de recherche"@fr ;
    ns1:prefLabel "Research institute"@en,
        "Centre de recherche"@fr ;
    rdfs:comment "An establishment founded for doing research."@en ;
    rdfs:subClassOf ns3:Institute .

ns4:Researching a owl:Class ;
    rdfs:label "Researching"@en ;
    rdfs:subClassOf ns3:ResearcherRole .

ns4:ReservableSoftware a owl:Class ;
    rdfs:label "Reservable Software"@en ;
    rdfs:comment "Software that is reservable."@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ;
    owl:disjointWith <http://w3id.org/roh/mirror/obo/iao#IAO_0000030> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns4:Reservable <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ) ] .

ns4:ReservationRelationship a owl:Class ;
    rdfs:label "Reservation Relationship"@en ;
    ns2:IAO_0000115 "A dual relationship of one organization offering a service to another organization, typically including start and end dates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns4:Reservable ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
            owl:onProperty ns4:hasKnowledgeArea ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns4:ReservableConsumerRole ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns4:ReservableProviderRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        ns3:Relationship .

ns4:RoundTable a owl:Class ;
    rdfs:label "Round Table"@en ;
    rdfs:subClassOf ns4:Activity .

ns4:SealOfQuality a owl:Class ;
    rdfs:label "Seal of quality"@en,
        "Label qualité"@fr ;
    ns1:prefLabel "Seal of quality"@en,
        "Label qualité"@fr ;
    rdfs:comment "A graphic mark indicating highest levels of quality in research, often measured in terms of relevant publications related to the researching activity."@en ;
    rdfs:subClassOf ns4:Accreditation .

ns4:ServiceContract a owl:Class ;
    rdfs:label "Service contract"@en,
        "Contrat de service"@fr ;
    ns1:prefLabel "Service contract"@en,
        "Contrat de service"@fr ;
    rdfs:subClassOf ns3:Contract .

ns4:Signed a owl:Class ;
    rdfs:label "Signed"@en ;
    rdfs:subClassOf ns4:Status .

ns4:Teaching a owl:Class ;
    rdfs:label "Teaching"@en ;
    rdfs:subClassOf ns3:TeacherRole .

ns4:TechnicalReport a owl:Class ;
    rdfs:label "Technical report"@en ;
    ns1:prefLabel "Technical report"@en ;
    rdfs:subClassOf ns10:Report .

ns4:TechnicalSupport a owl:Class ;
    rdfs:label "TechnicalSupport"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns4:Terminated a owl:Class ;
    rdfs:label "Terminated"@en ;
    rdfs:subClassOf ns4:Status .

ns4:TestAnotherGovernmentAgency a ns3:GovernmentAgency,
        owl:NamedIndividual ;
    rdfs:label "TestAnotherGovernmentAgency"@en ;
    ns4:promotes ns4:TestFundingSource .

ns4:TestChapterOne a ns10:Chapter,
        owl:NamedIndividual ;
    rdfs:label "TestChapterOne"@en ;
    ns10:authorList ns4:TestListofAuthors ;
    ns3:hasPublicationVenue ns4:TestBook .

ns4:TestChapterThree a ns10:Chapter,
        owl:NamedIndividual ;
    rdfs:label "TestChapterThree"@en ;
    ns3:hasPublicationVenue ns4:TestBook .

ns4:TestChapterTwo a ns10:Chapter,
        owl:NamedIndividual ;
    rdfs:label "TestChapterTwo"@en ;
    ns3:hasPublicationVenue ns4:TestBook .

ns4:TestCoSupervisorRole a ns4:SupervisorRole,
        owl:NamedIndividual ;
    rdfs:label "TestCoSupervisorRole"@en ;
    ns9:RO_0000052 ns4:TestPhdCoSupervisor ;
    ns3:relatedBy ns4:TestPhDSupervisingRelationship .

ns4:TestGovernmentAgency a ns3:GovernmentAgency,
        owl:NamedIndividual ;
    rdfs:label "TestGovernmentAgency"@en ;
    ns4:promotes ns4:TestFundingProgram .

ns4:TestNonResearchSoftware a ns4:Reservable,
        <http://w3id.org/roh/mirror/obo/ero#ERO_0000071>,
        owl:NamedIndividual ;
    rdfs:label "TestNonResearchSoftware"@en .

ns4:TestOrganization a <http://w3id.org/roh/mirror/foaf#Organization>,
        owl:NamedIndividual ;
    rdfs:label "TestOrganization"@en .

ns4:TestProject a ns3:Project,
        owl:NamedIndividual ;
    rdfs:label "TestProject"@en .

ns4:TestSuperviseeRole a ns4:SuperviseeRole,
        owl:NamedIndividual ;
    rdfs:label "TestSuperviseeRole"@en ;
    ns4:roleOf ns4:TestPhDStudent ;
    ns3:relatedBy ns4:TestPhDSupervisingRelationship .

ns4:TestSupervisorRole a ns4:SupervisorRole,
        owl:NamedIndividual ;
    rdfs:label "TestSupervisorRole"@en ;
    ns4:roleOf ns4:TestPhdSupervisor ;
    ns3:relatedBy ns4:TestPhDSupervisingRelationship .

ns4:UndergraduateStudent a owl:Class ;
    rdfs:label "UndergraduateStudent"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000784> .

ns4:Unfunded a owl:Class ;
    rdfs:label "Unfunded"@en ;
    rdfs:subClassOf ns4:Status .

ns4:UniversityDivision a owl:Class ;
    rdfs:label "University division"@en,
        "Division d'université"@fr ;
    rdfs:comment "A division within a university (school, faculty, etc.)"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/foaf#Organization> .

ns4:WorkshopPaper a owl:Class ;
    rdfs:label "Workshop Paper"@en ;
    rdfs:comment "A paper published on a conference workshop."@en ;
    rdfs:subClassOf ns3:ConferencePaper .

ns4:accreditationOf a owl:ObjectProperty ;
    rdfs:label "accreditation of"@en ;
    rdfs:comment "An object property linking an Accreditation to the Agent is associated with."@en ;
    rdfs:domain ns4:Accreditation ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Agent> ;
    owl:inverseOf ns4:hasAccreditation .

ns4:addresses a owl:ObjectProperty ;
    rdfs:label "addresses"@en ;
    rdfs:domain ns4:ResearchContribution ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:ResearchProblem ] ) ] .

ns4:advises a owl:ObjectProperty ;
    rdfs:label "advises"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:range ns10:Document ;
    owl:inverseOf ns4:isAdvisedBy .

ns4:associatedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "associated with"@en ;
    rdfs:comment "an organisation (i.e. university) is associated with another organsiation (i.e. research institute)."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Agent> ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Agent> .

ns4:authors a owl:ObjectProperty ;
    rdfs:label "authors"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Agent> ;
    rdfs:range ns10:Document ;
    owl:inverseOf ns4:isAuthoredBy .

ns4:awardedWith a owl:DatatypeProperty ;
    rdfs:label "awarded with"@en ;
    rdfs:domain ns10:Document ;
    rdfs:range xsd:string .

ns4:coadvisedBy a owl:ObjectProperty ;
    rdfs:label "co-advised by"@en ;
    rdfs:comment "An academic publication (bachelor's thesis, master's thesis or doctoral thesis) is co-advised by an advisor."@en ;
    rdfs:domain ns10:Document ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Person> .

ns4:coadvises a owl:ObjectProperty ;
    rdfs:label "co-advises"@en ;
    rdfs:comment "A person co-advises an academic publication (bachelor's thesis, master's thesis or doctoral thesis)."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:range ns10:Document .

ns4:codeOf a owl:ObjectProperty ;
    rdfs:label "code of"@en ;
    rdfs:comment "A code is assigned to a concept."@en ;
    rdfs:domain ns1:Concept ;
    rdfs:range ns1:Concept ;
    owl:inverseOf ns4:hasCode .

ns4:companyFounder a owl:ObjectProperty ;
    rdfs:label "company founder"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:range ns3:Company .

ns4:contactInfoOf a owl:ObjectProperty ;
    rdfs:label "contact info of"@en ;
    rdfs:comment "Specifies the contact info of type vcard:Kind for an Agent."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/vcard#Kind> ;
    owl:inverseOf ns4:hasContactInfo .

ns4:contractOf a owl:ObjectProperty ;
    rdfs:label "contract of"@en ;
    rdfs:comment "An object property linking a Contract to an Entity."@en ;
    rdfs:domain ns3:Contract ;
    owl:inverseOf ns4:hasContract .

ns4:contractSigningDate a owl:ObjectProperty ;
    rdfs:label "contract signing date"@en ;
    rdfs:comment "An object property linking a Contract with the date (DateTimeValue) when it was signed."@en ;
    rdfs:domain ns3:Contract ;
    rdfs:range ns3:DateTimeValue ;
    rdfs:subPropertyOf ns3:dateTimeValue ;
    owl:inverseOf ns4:contractSigningDateOf .

ns4:coordinatedBy a owl:ObjectProperty ;
    rdfs:label "coordinated by"@en ;
    rdfs:comment "inverse property of 'project coordinator'"@en ;
    rdfs:domain ns3:Project ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Agent> .

ns4:country a owl:ObjectProperty ;
    rdfs:label "country"@en ;
    rdfs:comment "This property indicates the nationality of a resource. The domain is not set so unpredicted resources within the ontology could be attached to countries."@en ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:Country ] ) ] .

ns4:employs a owl:ObjectProperty ;
    rdfs:label "employs"@en ;
    rdfs:domain ns4:ResearchContribution ;
    rdfs:range ns4:ResearchMethod ;
    rdfs:subPropertyOf ns2:RO_0000057 .

ns4:foundationDate a owl:ObjectProperty ;
    rdfs:label "foundation date"@en ;
    rdfs:comment "Date in which an Organization was created."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:range ns3:DateTimeValue ;
    rdfs:subPropertyOf ns3:dateTimeValue .

ns4:freeOrPaid a owl:DatatypeProperty ;
    rdfs:label "free or paid"@en .

ns4:grantedBy a owl:ObjectProperty ;
    rdfs:label "granted by"@en ;
    rdfs:comment "An object property linking an Organization with a FundingAmount."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:range ns4:FundingAmount ;
    owl:inverseOf ns4:grants .

ns4:hasPatent a owl:ObjectProperty ;
    rdfs:label "has patent"@en ;
    rdfs:domain ns4:Invention ;
    rdfs:range ns10:Patent .

ns4:hasResearchContribution a owl:ObjectProperty ;
    rdfs:label "has research contribution"@en .

ns4:hasScientificDomain a owl:ObjectProperty ;
    rdfs:label "has scientific domain"@en ;
    rdfs:range ns1:Concept .

ns4:hasSpinoff a owl:ObjectProperty ;
    rdfs:label "has spinoff"@en ;
    rdfs:comment "An Organization which has a spin off Company."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:range ns3:Company ;
    owl:inverseOf ns4:isSpinfoffOf .

ns4:hasTRL a owl:DatatypeProperty ;
    rdfs:label "has TRL"@en ;
    rdfs:comment "A prototype has a given technology readiness level"@en ;
    rdfs:domain ns4:Product ;
    rdfs:range xsd:integer .

ns4:isAwardedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is awarded by"@en ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Agent> ;
    rdfs:subPropertyOf ns3:assignedBy .

ns4:isCompetitive a owl:DatatypeProperty ;
    rdfs:label "is competitive"@en ;
    rdfs:domain ns3:Project ;
    rdfs:range xsd:boolean .

ns4:isGrantedWith a owl:ObjectProperty ;
    rdfs:label "is granted with"@en ;
    rdfs:comment "A person is granted with a stipend for researching."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:range ns4:Grant .

ns4:issuedBy a owl:ObjectProperty ;
    rdfs:label "issued by"@en ;
    rdfs:comment "An Accreditation issued by an Accreditation Issuer."@en ;
    rdfs:domain ns4:Accreditation ;
    rdfs:range ns4:AccreditationIssuer ;
    owl:inverseOf ns4:issues .

ns4:patentAssistantExaminer a owl:ObjectProperty ;
    rdfs:label "patent assistant examiner"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:range ns10:Patent .

ns4:patentCountry a owl:ObjectProperty ;
    rdfs:label "patent country"@en ;
    rdfs:domain ns10:Patent ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:Country ] ) ] .

ns4:patentInventor a owl:ObjectProperty ;
