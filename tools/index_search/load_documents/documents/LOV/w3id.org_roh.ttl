        [ a owl:Restriction ;
            owl:allValuesFrom ns4:ResearchResult ;
            owl:onProperty ns4:partOfResearchResult ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateTimeValue ],
        [ a owl:Restriction ;
            owl:onProperty ns4:repositoryStatus ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:Closed ns4:Open ) ] ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns4:seqOfAuthors ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns10:abstract ],
        [ a owl:Restriction ;
