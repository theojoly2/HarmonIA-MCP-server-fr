ns3:AcademicDepartment a owl:Class ;
    rdfs:label "Academic Department"@en ;
    ns2:IAO_0000112 "Endodontics (department within a College of Dentistry); English (department within a College of Liberal Arts)" ;
    ns2:IAO_0000115 "A distinct, usually specialized educational unit within an educational organization." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    rdfs:subClassOf ns3:Department .

ns3:CoPrincipalInvestigatorRole a owl:Class ;
    rdfs:label "Co-Principal Investigator Role"@en ;
    ns2:IAO_0000115 "Role of co-principal investigator of an Agreement (for example, a grant), who devotes a specified percentage of time and is considered key personnel." ;
    rdfs:subClassOf ns3:InvestigatorRole .

ns3:PeerReviewerRole a owl:Class ;
    rdfs:label "Peer Reviewer Role"@en ;
    ns2:IAO_0000112 "is a generic term for a process of self-regulation by a profession or a process of evaluation involving qualified individuals within the relevant field. Peer review methods are employed to maintain standards, improve performance and provide credibility. In academia  the term is often used to denote a prepublication review of academic papers; reviewing an academic paper is often called refereeing.\\nContents\\n[hide]" ;
    ns2:IAO_0000115 "A role of peer reviewing" ;
    rdfs:subClassOf ns3:ReviewerRole .

ns3:PostdocPosition a owl:Class ;
    rdfs:label "Postdoctoral Position"@en ;
    ns2:IAO_0000115 "A postdoctoral training appointment (job)" ;
    rdfs:subClassOf ns3:NonFacultyAcademicPosition .

ns3:PrincipalInvestigatorRole a owl:Class ;
    rdfs:label "Principal Investigator Role"@en ;
    ns2:IAO_0000115 "Role of a person to direct a project or activity being supported by an Agreement (for example, a grant), and who is accountable to the grantee for the proper conduct of the project or activity. Also known as Program Director or Project Director." ;
    rdfs:subClassOf ns3:InvestigatorRole .

ns3:affiliatedOrganization a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has affiliated organization"@en ;
    rdfs:comment "An organization which has a certain collaboration agreement with another one."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Organization> .

ns3:assignee a owl:ObjectProperty ;
    rdfs:label "patent assignee"@en ;
    rdfs:domain ns10:Patent ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Organization> .

ns3:assigns a owl:ObjectProperty ;
    rdfs:label "assigns"@en ;
    rdfs:comment "Relates an Agent to a Relationship."@en .

ns3:degreeCandidacy a owl:ObjectProperty ;
    rdfs:label "degree candidacy"@en ;
    rdfs:domain ns3:AdvisingRelationship ;
    rdfs:range ns3:AcademicDegree .

ns3:eRACommonsId a owl:DatatypeProperty ;
    rdfs:label "eRA Commons ID"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:subPropertyOf ns3:identifier .

ns3:geographicFocus a owl:ObjectProperty ;
    rdfs:label "geographic focus"@en ;
    rdfs:comment "A geographic region in which something takes place."@en .

ns3:hrJobTitle a owl:DatatypeProperty ;
    rdfs:label "HR job title"@en ;
    ns7:descriptionAnnot "Definition http://en.wikipedia.org/wiki/Job_title#Job_title." ;
    ns7:exampleAnnot "administrative secretary" ;
    rdfs:domain ns3:Position .

ns3:pmcid a owl:DatatypeProperty ;
    rdfs:label "has PubMed Central ID"@en ;
    rdfs:comment "A PMCID is a unique PubMed Central reference number, which is assigned to each full-text record made available A PMCID is a unique PubMed Central reference number, which is assigned to each full-text record made available in PubMed Central. The PMCID is issued shortly after the PI or author approves the PubMed Central formatted web version of the submission."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns3:identifier .

ns3:researcherId a owl:DatatypeProperty ;
    rdfs:label "ISI Researcher ID"@en ;
    ns2:IAO_0000112 "RearcherID is a Thomson Reuters project where researchers have a place to manage and share their professional information. It will allow them to solve author identity issues while simultaneously adding dynamic citation metrics and collaboration networks to your personal profile.\\nDefinition source: http://isiwebofknowledge.com/researcherid/" ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:subPropertyOf ns3:identifier .

ns3:scopusId a owl:DatatypeProperty ;
    rdfs:label "Scopus ID"@en ;
    ns2:IAO_0000112 "Home page for Scopus: http://www.scopus.com/home.url" ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:subPropertyOf ns3:identifier .

ns5:term_status a owl:AnnotationProperty .

schema:identifier a owl:AnnotationProperty .

ns8:conformsTo a owl:AnnotationProperty .

ns8:created a owl:AnnotationProperty .

ns8:creator a owl:AnnotationProperty .

ns8:description a owl:AnnotationProperty .

ns8:identifier a owl:AnnotationProperty .

ns8:issued a owl:AnnotationProperty .

ns8:language a owl:AnnotationProperty .

ns8:license a owl:AnnotationProperty .

ns8:publisher a owl:AnnotationProperty .

ns8:rights a owl:AnnotationProperty .

ns8:rightsHolder a owl:AnnotationProperty .

ns8:source a owl:AnnotationProperty .

ns8:title a owl:AnnotationProperty .

ns8:type a owl:AnnotationProperty .

ns6:primaryTopic a owl:AnnotationProperty .

ns2:IAO_0000115 a owl:AnnotationProperty .

ns2:IAO_0000602 a owl:AnnotationProperty .

<http://purl.org/spar/cito/isCitedAsDataSourceBy> a owl:ObjectProperty ;
    rdfs:label "is cited as data source by"@en ;
    rdfs:comment "The cited entity is cited as a data source by the citing entity."@en .

<http://purl.org/spar/cito/isCitedBy> a owl:ObjectProperty ;
    rdfs:label "is cited by"@en ;
    rdfs:comment "The cited entity (the subject of the RDF triple) is cited by the citing entity (the object of the triple)."@en .

ns4:AcademicAccreditation a owl:Class ;
    rdfs:label "Academic Accreditation"@en ;
    rdfs:comment "An attestation of qualification, competence, or authority issued to an individual by a third party with a relevant or  de facto authority or assumed competence to do so in the academic field."@en ;
    rdfs:subClassOf ns4:Accreditation .

ns4:AuditingRelationship a owl:Class ;
    rdfs:label "Auditing Relationship"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Agent> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:AuditeeRole ns4:AuditorRole <http://w3id.org/roh/mirror/foaf#Agent> ) ] ;
            owl:onProperty ns3:relates ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns4:AuditeeRole ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns4:AuditorRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateTimeValue ],
        ns3:Relationship .

ns4:Award a owl:Class ;
    rdfs:label "Award"@en ;
    rdfs:subClassOf ns3:Certificate .

ns4:BachelorsDegree a owl:Class ;
    rdfs:label "Bachelor's degree"@en ;
    ns1:prefLabel "Bachelor's degree"@en ;
    rdfs:comment "An undergraduate academic degree awarded by colleges and universities upon completion of a course of study lasting three to four years (depending on institution and academic discipline)."@en ;
    rdfs:subClassOf ns3:AcademicDegree .

ns4:BachelorsSupervisingRelationship a owl:Class ;
    rdfs:label "Bachelor's Supervising Relationship"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:BachelorsThesis ;
            owl:onProperty ns4:produces ],
        ns4:SupervisingRelationship .

ns4:BitBucketRepository a owl:Class ;
    rdfs:label "BitBucket Repository"@en ;
    rdfs:comment "This entity defines a BitBucket Repository (https://bitbucket.org)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:BitBucketRepository ;
            owl:onProperty ns4:hasPredecessor ],
        ns4:Repository .

ns4:BlogPost a owl:Class ;
    rdfs:label "Blog Post"@en ;
    rdfs:subClassOf ns10:Article .

ns4:CourseCertificate a owl:Class ;
    rdfs:label "Course Certificate"@en ;
    rdfs:subClassOf ns3:Certificate ;
    owl:disjointWith ns4:LanguageCertificate .

ns4:DegreeHomologation a owl:Class ;
    rdfs:label "Degree Homologation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:dateIssued ;
            owl:someValuesFrom ns3:DateTimeValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:AwardedDegree ;
            owl:onProperty ns3:relates ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns3:AwardedDegree ],
        ns4:Accreditation .

ns4:DoctoralDegree a owl:Class ;
    rdfs:label "Doctoral degree"@en,
        "Doctorat"@fr-be,
        "Doctorat"@fr-ca,
        "Doctorat"@fr-ch,
        "Doctorat"@fr-fr ;
    ns1:altLabel "Doctorate"@en ;
    ns1:prefLabel "Doctoral degree"@en,
        "Doctorat"@fr-be,
        "Doctorat"@fr-ca,
        "Doctorat"@fr-ch,
        "Doctorat"@fr-fr ;
    rdfs:subClassOf ns3:AcademicDegree .

ns4:EthicalValidation a owl:Class ;
    rdfs:label "EthicalValidation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:documentStatus ;
            owl:someValuesFrom ns4:Status ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:Status ;
            owl:onProperty ns4:documentStatus ],
        ns4:EthicalReport .

ns4:EthicsCommittee a owl:Class ;
    rdfs:label "Ethics Comitee"@en ;
    rdfs:comment "An ethics committee is a body responsible for ensuring that medical experimentation and human subject research are carried out in an ethical manner in accordance with national and international law."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:EthicalReport ;
            owl:onProperty ns4:produces ],
        <http://w3id.org/roh/mirror/foaf#Organization> .

ns4:ExperimentalProtocolResult a owl:Class ;
    rdfs:label "Experimental Protocol Result"@en ;
    rdfs:comment "Document that contains the result or execution of a Experimental Protocol."@en ;
    rdfs:subClassOf ns10:Document .

ns4:ExternalMemberRole a owl:Class ;
    rdfs:label "External Member Role"@en ;
    rdfs:comment "A member who works in a Project or participates in an Activity but do not belong to the main Organization."@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns4:GitHubRepository a owl:Class ;
    rdfs:label "GitHub Repository"@en ;
    rdfs:comment "It's a concrete Repository that is stored in https://github.com."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:GitHubRepository ;
            owl:onProperty ns4:hasPredecessor ],
        ns4:Repository .

ns4:LargeEnterprise a owl:Class ;
    rdfs:label "Large Enterprise"@en,
        "Large enterprise"@en ;
    rdfs:subClassOf ns3:Company .

ns4:Loan a owl:Class ;
    rdfs:label "Loan"@en ;
    rdfs:comment "An amount of money that is borrowed, often from a bank or a funding organization, and has to be paid back, usually together with an extra amount of money that you have to pay as a charge for borrowing."@en ;
    rdfs:subClassOf ns4:Funding .

ns4:MastersDegree a owl:Class ;
    rdfs:label "Master's degree"@en,
        "Maîtrise universitaire"@fr-be,
        "Maîtrise universitaire"@fr-ca,
        "Maîtrise universitaire"@fr-ch,
        "Maîtrise universitaire"@fr-fr ;
    ns1:prefLabel "Master's degree"@en,
        "Maîtrise universitaire"@fr-be,
        "Maîtrise universitaire"@fr-ca,
        "Maîtrise universitaire"@fr-ch,
        "Maîtrise universitaire"@fr-fr ;
    rdfs:subClassOf ns3:AcademicDegree .

ns4:MastersSupervisingRelationship a owl:Class ;
    rdfs:label "Master's Supervising Relationship"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:MastersThesis ;
            owl:onProperty ns4:produces ],
        ns4:SupervisingRelationship .

ns4:MediumEnterprise a owl:Class ;
    rdfs:label "Medium Enterprise"@en ;
    rdfs:comment "An enterprise which employ fewer than 250 persons and which have an annual turnover not exceeding EUR 50 million, and/or an annual balance sheet total not exceeding EUR 43 million."@en ;
    rdfs:subClassOf ns3:Company .

ns4:MicroEnterprise a owl:Class ;
    rdfs:label "Micro Enterprise"@en ;
    rdfs:comment "An enterprise which employs fewer than 10 persons and whose annual turnover and/or annual balance sheet total does not exceed EUR 2 million."@en ;
    rdfs:subClassOf ns3:Company .

ns4:Outsourcing a owl:Class ;
    rdfs:label "Outsourcing"@en ;
    rdfs:comment "The process of paying to have part of a company's work done by another company."@en ;
    rdfs:subClassOf ns4:Funding .

ns4:PatentContract a owl:Class ;
    rdfs:label "Patent Contract"@en ;
    rdfs:subClassOf ns3:Contract .

ns4:PressArticle a owl:Class ;
    rdfs:label "Press Article"@en ;
    rdfs:subClassOf ns10:Article .

ns4:RefundableAdvance a owl:Class ;
    rdfs:label "RefundableAdvance"@en ;
    rdfs:subClassOf ns4:Funding .

ns4:ResearchAccreditation a owl:Class ;
    rdfs:label "Research Accreditation"@en ;
    rdfs:comment "An attestation of qualification, competence, or authority issued to an individual by a third party with a relevant or  de facto authority or assumed competence to do so in the research field."@en ;
    rdfs:subClassOf ns4:Accreditation .

ns4:ResearchGroup a owl:Class ;
    rdfs:label "Research Group"@en,
        "Research group"@en,
        "Group de recherche"@fr ;
    ns1:prefLabel "Research group"@en,
        "Group de recherche"@fr ;
    rdfs:comment "A group of researchers often from the same centre, specialised on the same subject, working together on the issue or topic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ns4:excellenceLabel ],
        <http://w3id.org/roh/mirror/foaf#Organization> .

ns4:ResearchGroupMetric a owl:Class ;
    rdfs:label "Research Group Metric"@en ;
    rdfs:subClassOf ns4:Metric .

ns4:ResearchMaterial a owl:Class ;
    rdfs:label "Research material"@en ;
    ns1:prefLabel "Research material"@en ;
    rdfs:subClassOf ns2:BFO_0000040 .

ns4:ResearcherPosition a owl:Class ;
    rdfs:label "Researcher Position"@en ;
    rdfs:comment "A member of a university or research organization focused on research task further than other ones."@en ;
    rdfs:subClassOf ns3:Position .

ns4:SmallEnterprise a owl:Class ;
    rdfs:label "Small Enterprise"@en ;
    rdfs:comment "An enterprise which employs fewer than 50 persons and whose annual turnover and/or annual balance sheet total does not exceed EUR 10 million."@en ;
    rdfs:subClassOf ns3:Company .

ns4:TestDateTimeInterval a ns3:DateTimeInterval,
        owl:NamedIndividual ;
    rdfs:label "TestDateTimeInterval"@en ;
    ns3:end ns4:TestEndDateTimeValue ;
    ns3:start ns4:TestStartDateTimeValue .

ns4:TestEndDateTimeValue a ns3:DateTimeValue,
        owl:NamedIndividual ;
    rdfs:label "TestEndDateTimeValue"@en ;
    ns3:dateTime "2015-11-13T00:00:00"^^xsd:dateTime .

ns4:TestFundingSource a ns4:FundingSource,
        owl:NamedIndividual ;
    rdfs:label "TestFundingSource"@en ;
    ns4:funds ns4:TestFundingProgram .

ns4:TestListofAuthors a rdf:Seq,
        owl:NamedIndividual ;
    rdfs:label "TestListofAuthors"@en .

ns4:TestListofEditors a rdf:Seq,
        owl:NamedIndividual ;
    rdfs:label "TestListofEditors"@en .

ns4:TestStartDateTimeValue a ns3:DateTimeValue,
        owl:NamedIndividual ;
    rdfs:label "TestStartDateTimeValue"@en ;
    ns3:dateTime "2011-09-01T00:00:00"^^xsd:dateTime .

ns4:ThesisViva a owl:Class ;
    rdfs:label "Thesis Viva"@en ;
    rdfs:comment "An oral examination in which a PhD Student defends her/his doctoral thesis."@en ;
    rdfs:subClassOf ns4:Activity .

ns4:ThirdPartyContractorRole a owl:Class ;
    rdfs:label "Third Party Contractor Role"@en ;
    rdfs:comment "A role of contracting someone to perform a job."@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns4:TvProgram a owl:Class ;
    rdfs:label "Tv Program"@en ;
    rdfs:subClassOf ns10:AudioVisualDocument .

ns4:ZenodoRepository a owl:Class ;
    rdfs:label "Zenodo Repository"@en ;
    rdfs:comment "It`s a Zenodo Repository that we can find in https://zenodo.org."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ns3:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:ZenodoRepository ;
            owl:onProperty ns4:hasPredecessor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ns10:doi ],
        ns4:Repository .

ns4:attachment a owl:ObjectProperty ;
    rdfs:label "attachment"@en ;
    rdfs:comment "An object property describing a not machine-readable document attached to an entity offering more detailed information."@en ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns4:awards a owl:ObjectProperty ;
    rdfs:label "awards"@en ;
    rdfs:comment "An object property linking the University awarding a degree to the AwardedDegree."@en ;
    rdfs:domain ns3:University ;
    rdfs:range ns3:AwardedDegree .

ns4:birthdate a owl:ObjectProperty ;
    rdfs:label "birthdate"@en ;
    rdfs:comment "The birthdate of an Entity."@en ;
    rdfs:range ns3:DateTimeValue ;
    rdfs:subPropertyOf ns3:dateTimeValue .

ns4:contractSigningDateOf a owl:ObjectProperty ;
    rdfs:label "contract signing date of"@en ;
    rdfs:comment "An object property linking a signing date (DateTimeValue) with a Contract."@en ;
    rdfs:domain ns3:DateTimeValue ;
    rdfs:range ns3:Contract .

ns4:correspondingAuthorOf a owl:ObjectProperty ;
    rdfs:label "corresponding author of"@en ;
    rdfs:comment "An object property linking a Person with a Thing, such person is corresponding author for."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> .

ns4:correspondingOrganizationOf a owl:ObjectProperty ;
    rdfs:label "correspondingOrganizationOf"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization> .

ns4:courseHours a owl:DatatypeProperty ;
    rdfs:label "course hours"@en ;
    rdfs:comment "The number of hours a course lasts."@en .

ns4:dedication a owl:DatatypeProperty ;
    rdfs:label "dedication"@en ;
    rdfs:comment "The dedication which a Person dedicates to a Role."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "PARTIAL" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "TOTAL" ;
                            rdf:rest () ] ] ] .

ns4:dedicationPercentage a owl:DatatypeProperty ;
    rdfs:label "dedication percentage"@en ;
    rdfs:range xsd:double .

ns4:evaluationStatus a owl:ObjectProperty ;
    rdfs:label "evaluation status"@en ;
    rdfs:comment "The status in which a Evaluation Summary could be."@en ;
    rdfs:domain ns4:EvaluationSummary ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:Final ns4:Provisional ) ] .

ns4:excellenceLabel a owl:DatatypeProperty ;
    rdfs:label "excellence label"@en ;
    rdfs:comment "Represents if an Entity has an excellence label or some kind of mention."@en ;
    rdfs:range xsd:boolean .

ns4:expenseModality a owl:DatatypeProperty ;
    rdfs:label "expense modality"@en ;
    rdfs:comment "A free text property to represent the modality of an Expense."@en .

ns4:expirationDate a owl:ObjectProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:range ns3:DateTimeValue ;
    rdfs:subPropertyOf ns3:dateTimeValue .

ns4:foreseenJustificationDate a owl:ObjectProperty ;
    rdfs:label "foreseen justification date"@en ;
    rdfs:comment "The date in which a Justificacion has to be delivered."@en ;
    rdfs:domain ns3:Project ;
    rdfs:range ns3:DateTimeValue ;
    rdfs:subPropertyOf ns3:dateTimeValue .

ns4:h-index a owl:DatatypeProperty ;
    rdfs:label "h-index"@en ;
    rdfs:domain ns4:AuthorMetric ;
    rdfs:range xsd:integer .

ns4:hasCode a owl:ObjectProperty ;
    rdfs:label "has Code"@en ;
    rdfs:comment "A concept can be asigned a code."@en ;
    rdfs:domain ns1:Concept ;
    rdfs:range ns1:Concept .

ns4:hasCompanyClassification a owl:ObjectProperty ;
    rdfs:label "has company classification"@en ;
    rdfs:domain ns3:Company ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:CompanyClassification ] ) ] .

ns4:hasExpenseClassification a owl:ObjectProperty ;
    rdfs:label "has Expense Classification"@en ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:ExpenseClassification ] ) ] .

ns4:hasFundingProgramClassification a owl:ObjectProperty ;
    rdfs:label "has Funding Program Classification" ;
    rdfs:domain ns4:FundingProgram ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:FundingProgramClassification ] ) ] .

ns4:hasPosition a owl:ObjectProperty ;
    rdfs:label "has position"@en ;
    rdfs:comment "A Person has a Position in his/her Organization."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:range ns3:Position ;
    owl:inverseOf ns4:positionOf .

ns4:hasProjectClassification a owl:ObjectProperty ;
    rdfs:label "has project categorization"@en ;
    rdfs:comment "A Project is categorized by different Project Classifications."@en ;
    rdfs:domain ns3:Project ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:ProjectClassification ] ) ] ;
    owl:inverseOf ns4:projectClassificationOf .

ns4:hasPropertyClassification a owl:ObjectProperty ;
    rdfs:label "has property classification"@en ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:PropertyClassification ] ) ] .

ns4:hasReservable a owl:ObjectProperty ;
    rdfs:label "has reservable"@en ;
    rdfs:comment "An Agent who owns an infrastructure."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Agent> ;
    rdfs:range ns4:Reservable ;
    owl:inverseOf ns4:reservableOf .

ns4:hasRole a owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    rdfs:comment "An Agent has a Role in a Relation."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Agent> ;
    rdfs:range <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> ;
    owl:inverseOf ns4:roleOf .

ns4:hrClassificationOf a owl:ObjectProperty ;
    rdfs:label "HR classification of"@en ;
    rdfs:comment "The classification of the position of a Person."@en ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:HRClassification ] ) ] .

ns4:i10-index a owl:DatatypeProperty ;
    rdfs:label "i10-index"@en ;
    rdfs:comment "A property to express the i10-index of an author."@en ;
    rdfs:range xsd:integer .

ns4:isAdvisedBy a owl:ObjectProperty ;
    rdfs:label "is advised by"@en .

ns4:isAuthoredBy a owl:ObjectProperty ;
    rdfs:label "is authored by"@en .

ns4:isProvidedBy a owl:ObjectProperty ;
    rdfs:label "is provided by"@en ;
    rdfs:comment "A Service provided by an Organization."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Organization> ;
    owl:inverseOf ns4:provides .

ns4:isSpinfoffOf a owl:ObjectProperty ;
    rdfs:label "is spinoff of"@en,
        "spins of from"@en ;
    rdfs:comment "A Company which is an spinoff of an Organization."@en ;
    rdfs:domain ns3:Company ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Organization> .

ns4:isStartup a owl:DatatypeProperty ;
    rdfs:label "is startup"@en ;
    rdfs:comment "To specify that a company is in its early stage of life."@en ;
    rdfs:range xsd:boolean .

ns4:isbn a owl:DatatypeProperty ;
    rdfs:label "isbn"@en ;
    rdfs:comment "A numeric commercial book identifier which is intended to be unique."@en .

ns4:knowledgeAreaOf a owl:ObjectProperty ;
    rdfs:label "knowledge area of"@en ;
    rdfs:comment "A skos:Concept which is the knowledge area of some entity."@en ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:KnowledgeArea ] ) ] .

ns4:needsEthicalValidation a owl:DatatypeProperty ;
    rdfs:label "needs ethical validation"@en ;
    rdfs:comment "Represents if a Project needs to pass an ethical validation."@en ;
    rdfs:domain ns3:Project ;
    rdfs:range xsd:boolean .

ns4:ownerOrganizationOf a owl:ObjectProperty ;
    rdfs:label "owner organization of"@en ;
    rdfs:comment "An Organization owning a Patent."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:PatentApplication ns10:Patent ) ] .

ns4:patentStatus a owl:ObjectProperty ;
    rdfs:label "patent status"@en ;
    rdfs:domain ns4:PatentApplication ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:Accepted ns4:Rejected ns4:Submitted ) ] .

ns4:platform a owl:DatatypeProperty ;
    rdfs:domain <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ;
    rdfs:range xsd:string .

ns4:positionOf a owl:ObjectProperty ;
    rdfs:label "position of"@en ;
    rdfs:comment "The Position of a Person within an Organization."@en ;
    rdfs:domain ns3:Position ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Person> .

ns4:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by"@en ;
    rdfs:comment "Some entity producing some Thing."@en ;
    rdfs:range owl:Thing ;
    owl:inverseOf ns4:produces .

ns4:programmingLanguage a owl:DatatypeProperty ;
    rdfs:label "lenguaje de programación"@en,
        "programming language"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

ns4:projectClassificationOf a owl:ObjectProperty ;
    rdfs:label "project categorization of"@en ;
    rdfs:comment "A Project Classification which categorizes a Project."@en ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:ProjectClassification ] ) ] ;
    rdfs:range ns3:Project .

ns4:publicFunding a owl:DatatypeProperty ;
    rdfs:label "public funding"@en ;
    rdfs:comment "To tag something as public (true) or private (false)"@en ;
    rdfs:domain ns4:Funding ;
    rdfs:range xsd:boolean .

ns4:quartile a owl:DatatypeProperty ;
    rdfs:label "quartile"@en ;
    rdfs:comment "The quartile to which a Journal publication belongs."@en ;
    rdfs:domain ns4:JournalMetric ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "Q1" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Q2" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Q3" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "Q4" ;
                                            rdf:rest () ] ] ] ] ] .

ns4:ranking a owl:DatatypeProperty ;
    rdfs:label "ranking"@en ;
    rdfs:comment "The ranking of a scientific publication."@en ;
    rdfs:domain ns4:JournalMetric ;
    rdfs:range xsd:string .

ns4:researchLine a owl:DatatypeProperty ;
    rdfs:label "research line"@en ;
    rdfs:comment "A free-text property to define the research line in which an Organization or Researcher is working on."@en ;
    rdfs:range xsd:string .

ns4:softwareStatus a owl:ObjectProperty ;
    rdfs:label "software status"@en ;
    rdfs:comment "The status of a Software  (Final or Provisional)."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:Final ns4:Provisional ) ] .

ns4:spentBy a owl:ObjectProperty ;
    rdfs:label "spent by"@en ;
    rdfs:comment "An Expense spent by an Entity."@en ;
    rdfs:domain ns4:Expense .

ns4:summary a owl:DatatypeProperty ;
    rdfs:label "summary"@en ;
    rdfs:comment "A textual summary of the Curriculum Vitae"@en ;
    rdfs:domain ns4:CurriculumVitae .

ns4:supervisorOf a owl:ObjectProperty ;
    rdfs:label "supervisor of"@en ;
    rdfs:comment "A Person supervising a Thesis."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:range ns10:Thesis .

ns4:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    rdfs:comment "A Funding which supports a Person Contract or a Project."@en ;
    rdfs:domain ns4:Funding .

ns4:taxID a owl:DatatypeProperty ;
    rdfs:label "tax ID"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:subPropertyOf ns3:identifier .

ns4:teaches a owl:ObjectProperty ;
    rdfs:label "teaches"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:AcademicSubject ] ) ] .

ns10:BookSection a owl:Class ;
    rdfs:label "Book Section"@en ;
    ns2:IAO_0000112 "Short Definition from the bibo ontology" ;
    ns2:IAO_0000115 "A section of a book" ;
    rdfs:comment "A section of a book."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:pageStart ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:edition ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:pageEnd ],
        ns10:DocumentPart ;
    ns5:term_status "unstable" .

ns10:Hearing a owl:Class ;
    rdfs:label "Hearing"@en ;
    ns2:IAO_0000112 "Definiton from Bibo here: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html" ;
    ns2:IAO_0000115 "An instance or a session in which testimony and arguments are presented, esp. before an official, as a judge in a lawsuit." ;
    rdfs:comment "An instance or a session in which testimony and arguments are presented, esp. before an official, as a judge in a lawsuit."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf ns4:Activity ;
    ns5:term_status "stable" .

ns10:Interview a owl:Class ;
    rdfs:label "Interview"@en ;
    ns2:IAO_0000112 "radio or newspaper interview" ;
    ns2:IAO_0000115 "A conversation between two or more people where questions are asked by the interviewer to obtain information from the interviewee." ;
    rdfs:comment "A formalized discussion between two or more people."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf ns4:Activity ;
    ns5:term_status "stable" .

ns10:Magazine a owl:Class ;
    rdfs:label "Magazine"@en ;
    ns2:IAO_0000112 "Abstracts and bibliographies are usually not included in magazines.",
        "New Yorker" ;
    ns2:IAO_0000115 "Contains articles of current events or general interest, geared to the reading public as being informative or recreational" ;
    rdfs:comment "A periodical of magazine Articles. A magazine is a publication that is issued periodically, usually bound in a paper cover, and typically contains essays, stories, poems, etc., by many writers, and often photographs and drawings, frequently specializing in a particular subject or area, as hobbies, news, or sports."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf ns10:Periodical ;
    ns5:term_status "stable" .

ns10:Performance a owl:Class ;
    rdfs:label "Performance"@en ;
    ns2:IAO_0000115 "Something carried out, acted or rendered." ;
    rdfs:comment "A public performance."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf ns4:Activity ;
    ns5:term_status "unstable" .

ns10:Workshop a owl:Class ;
    rdfs:label "Workshop"@en ;
    ns2:IAO_0000115 "Bibo Definition: A seminar, discussion group, or the like, that emphasizes exchange of ideas and the demonstration and application of techniques, skills, etc." ;
    rdfs:comment "A seminar, discussion group, or the like, that emphasizes zxchange of ideas and the demonstration and application of techniques, skills, etc."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf ns4:Activity ;
    ns5:term_status "stable" .

ns10:distributor a owl:ObjectProperty ;
    rdfs:label "distributor"@en ;
    rdfs:comment "Distributor of a document or a collection of documents."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI .

ns10:eanucc13 a owl:DatatypeProperty ;
    rdfs:label "eanucc13"@en ;
    rdfs:comment "An identifier for trade items."@en .

ns10:eissn a owl:DatatypeProperty ;
    rdfs:label "eissn"@en ;
    rdfs:comment "An ISSN for an electronic media."@en .

ns10:issn a owl:DatatypeProperty ;
    rdfs:label "issn"@en ;
    rdfs:comment "An eight-digit serial number used to uniquely identify a serial publication, such as a magazine"@en .

ns10:issue a owl:DatatypeProperty ;
    rdfs:label "issue"@en ;
    ns2:IAO_0000112 "Bibo has the domain of bibo:issue as the class Issue, but an example on their site uses it with Article, referring to the issue number \"4\"" ;
    rdfs:comment "An issue number"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns10:Article ns10:Issue ) ] ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns10:locator ;
    ns5:term_status "stable" .

ns10:lccn a owl:DatatypeProperty ;
    rdfs:label "lccn"@en ;
    rdfs:comment "The Library of Congress Control Number (LCCN) is a serially based system of numbering cataloging records in the Library of Congress in the United States."@en .

ns10:oclcnum a owl:DatatypeProperty ;
    rdfs:label "oclcnum"@en ;
    rdfs:comment "The identification number of the OCLC."@en .

ns10:presentedAt a owl:ObjectProperty ;
    rdfs:label "presented at"@en ;
    rdfs:comment "Relates a document to an event; for example, a paper to a conference."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI .

ns10:presents a owl:ObjectProperty ;
    rdfs:label "presents"@en ;
    rdfs:comment "Relates an event to associated documents; for example, conference to a paper."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI .

ns10:volume a owl:DatatypeProperty ;
    rdfs:label "volume"@en ;
    rdfs:comment "A volume number"@en ;
    rdfs:domain ns10:Document ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns10:locator ;
    ns5:term_status "stable" .

<http://w3id.org/roh/mirror/foaf#depiction> a owl:ObjectProperty ;
    rdfs:label "depiction" ;
    rdfs:comment "A depiction of some thing." ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> .

<http://w3id.org/roh/mirror/foaf#firstName> a owl:DatatypeProperty ;
    rdfs:label "firstName" ;
    rdfs:comment "The first name of a person." ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    rdfs:range rdfs:Literal ;
    ns5:term_status "testing" .

<http://w3id.org/roh/mirror/foaf#gender> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "gender" ;
    rdfs:comment "The gender of this Agent (typically but not necessarily 'male' or 'female')." ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    rdfs:range rdfs:Literal ;
    ns5:term_status "testing" .

<http://w3id.org/roh/mirror/foaf#img> a owl:ObjectProperty ;
    rdfs:label "image" ;
    rdfs:comment "An image that can be used to represent some thing (ie. those depictions which are particularly representative of something, eg. one's photo on a homepage)." ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Image> ;
    rdfs:subPropertyOf <http://w3id.org/roh/mirror/foaf#depiction> ;
    ns5:term_status "testing" .

<http://w3id.org/roh/mirror/foaf#isPrimaryTopicOf> a owl:ObjectProperty ;
    rdfs:label "is primary topic of" ;
    rdfs:comment "A document that this thing is the primary topic of." ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> .

<http://w3id.org/roh/mirror/foaf#mbox> a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "personal mailbox" ;
    rdfs:comment "A  personal mailbox, ie. an Internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that  there is (across time and change) at most one individual that ever has any particular value for foaf:mbox." ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Agent> ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    rdfs:range <http://w3id.org/roh/mirror/obo/iao#IAO_0000030> ;
    ns5:term_status "stable" .

<http://w3id.org/roh/mirror/foaf#nick> a owl:DatatypeProperty ;
    rdfs:label "nickname" ;
    rdfs:comment "A short informal nickname characterising an agent (includes login identifiers, IRC and other chat nicknames)." ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    ns5:term_status "testing" .

<http://w3id.org/roh/mirror/foaf#page> a owl:ObjectProperty ;
    rdfs:label "page" ;
    rdfs:comment "A page or document about this thing." ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> .

<http://w3id.org/roh/mirror/foaf#surname> a owl:DatatypeProperty ;
    rdfs:label "surname"@en ;
    rdfs:comment "The surname of some person." ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    rdfs:range rdfs:Literal ;
    ns5:term_status "archaic" .

<http://w3id.org/roh/mirror/foaf#title> a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "Title (Mr, Mrs, Ms, Dr. etc)" ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    ns5:term_status "testing" .

<http://w3id.org/roh/mirror/oa#motivatedBy> a owl:ObjectProperty ;
    rdfs:label "motivatedBy" ;
    rdfs:comment "The relationship between an Annotation and a Motivation that describes the reason for the Annotation's creation." ;
    rdfs:domain <http://w3id.org/roh/mirror/oa#Annotation> ;
    rdfs:isDefinedBy <http://www.w3.org/ns/oa#> ;
    rdfs:range <http://w3id.org/roh/mirror/oa#Motivation> .

<http://w3id.org/roh/mirror/obo/bfo#BFO_0000038> a owl:Class ;
    rdfs:label "One-Dimensional Temporal Region"@en ;
    rdfs:comment "A one-dimensional temporal region is a temporal region that is extended."@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000008> ;
    owl:disjointWith <http://w3id.org/roh/mirror/obo/bfo#BFO_0000148> .

<http://w3id.org/roh/mirror/obo/bfo#BFO_0000055> a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    ns2:BFO_0000179 "realizes" ;
    ns2:BFO_0000180 "realizes" ;
    ns2:IAO_0000600 "to say that b realizes c at t is to assert that there is some material entity d & b is a process which has participant d at t & c is a disposition or role of which d is bearer_of at t& the type instantiated by b is correlated with the type instantiated by c. (axiom label in BFO2 Reference: [059-003])"@en ;
    ns2:IAO_0000602 "(forall (x y t) (if (realizesAt x y t) (and (Process x) (or (Disposition y) (Role y)) (exists (z) (and (MaterialEntity z) (hasParticipantAt x z t) (bearerOfAt z y t)))))) // axiom label in BFO2 CLIF: [059-003]" ;
    rdfs:domain <http://w3id.org/roh/mirror/obo/bfo#BFO_0000015> ;
    rdfs:isDefinedBy ns2:bfo.owl ;
    rdfs:range <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000224> a owl:Class ;
    rdfs:label "Funding Role"@en ;
    ns2:IAO_0000112 "The NIH is a funding agency." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A role inhering in a person or organization that is realized when the bearer participates in providing funding to a person or an organization for academic or business purposes." ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
    ns2:IAO_0000119 "PERSON: Nicole Vasilevsky" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000225> a owl:Class ;
    rdfs:label "Educator Role"@en ;
    ns2:IAO_0000112 "A teacher." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A role inhering in a person or organization that is realized when the bearer participates in providing education to a student or group of students." ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
    ns2:IAO_0000119 "PERSON: Nicole Vasilevsky" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000391> a owl:Class ;
    rdfs:label "Access Service"@en ;
    ns2:IAO_0000112 "Allowing access to a microscope in a core lab." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A service offering that describes a service in which the consumer receives the right to use a resource (instrument, database, software, etc) that is owned or managed by a service provider.  Ownership of the accessed resource remains with the service provider during and after provision of service." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:comment "Coordinate with NIF" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000393> a owl:Class ;
    rdfs:label "Training Service"@en ;
    ns2:IAO_0000112 "Training a researcher to use a microscope." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A service offering that describes a service in which the provider offers educational materials or events, such as courses, workshops or graduate programs, to the service consumer" ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:comment "Coordinate with NIF. NIF ID: nlx_res_20090444" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000784> a owl:Class ;
    rdfs:label "Undergraduate Student Role"@en ;
    ns2:IAO_0000112 "A college student." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A student role inhering in a person that is realized when the bearer participates in a course of study at a college, university, etc. in pursuit of an associate or bachelor's degree." ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
    ns2:IAO_0000119 "http://www.thefreedictionary.com/student" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000783> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0001254> a owl:Class ;
    rdfs:label "Transport Service"@en ;
    ns2:IAO_0000112 "Transport of a patient within a hospital." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A service offering that describes a service in which the provider facilitates the transport of some material entity to a specified destination for the service consumer." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0001255> a owl:Class ;
    rdfs:label "Support Service"@en ;
    ns2:IAO_0000112 "Technical support." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A service offering that describes a service in which the provider assists the consumer in activities directly or indirectly associated with the production and analysis or experimental research data." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0001257> a owl:Class ;
    rdfs:label "Data Storage Service"@en ;
    ns2:IAO_0000112 "Storing data on a server." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A storage service offering that describes a service in which the consumer provides data as input, which a service provider stores and returns as output in its original form." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000392> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0001260> a owl:Class ;
    rdfs:label "Data Maintenance Service"@en ;
    ns2:IAO_0000112 "Maintaining a database." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A maintenance service offering that describes a service in which the provider actively manages or maintains data or a database for the service consumer.  Maintenance of the data is performed to maintain its integrity or enhance its quality or utility for the consumer, but new data is not generated as a result of the maintenance." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0001258> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0001262> a owl:Class ;
    rdfs:label "Data Analysis Service"@en ;
    ns2:IAO_0000112 "Sequence data analysis." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "An analysis service offering that describes a service in which the consumer provides some input data and a service provider transforms, models, or interprets the input data and returns this generated data as output" ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000118 "data processing service",
        "data transformation service" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0001261> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0001263> a owl:Class ;
    rdfs:label "Material Modification Service"@en ;
    ns2:IAO_0000112 "Histology service." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A material processing service offering that describes a service in which the provider makes physical modifications to a specified input material, such that at least one of the specified outputs of this process is a modified version of a specified input material." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000394> .

<http://w3id.org/roh/mirror/obo/iao#IAO_0000109> a owl:Class ;
    rdfs:label "Measurement Datum"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/iao#IAO_0000027> .

ns9:RO_0000053 a owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    rdfs:comment "A relation between an independent continuant (the bearer) and a specifically dependent continuant (the dependent), in which the dependent specifically depends on the bearer for its existence"@en .

ns9:RO_0001025 a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:comment "A relation between two independent continuants, the target and the location, in which the target is entirely within the location"@en .

<http://w3id.org/roh/mirror/vcard#Group> a owl:Class ;
    rdfs:label "Group"@en ;
    rdfs:comment "Object representing a group of persons or entities.  A group object will usually contain hasMember properties to specify the members of the group."@en ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/vcard> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/vcard#Kind> .

<http://w3id.org/roh/mirror/vcard#Location> a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "An object representing a named geographical place"@en ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/vcard> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/vcard#Kind> .

<http://w3id.org/roh/mirror/vcard#hasAddress> a owl:ObjectProperty ;
    rdfs:label "has address"@en ;
    rdfs:comment "To specify the components of the delivery address for the object"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns> ;
    rdfs:range <http://w3id.org/roh/mirror/vcard#Address> .

<http://w3id.org/roh/mirror/vcard#hasEmail> a owl:ObjectProperty ;
    rdfs:label "has email"@en ;
    rdfs:comment "To specify the electronic mail address for communication with the object"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns> ;
    rdfs:range <http://w3id.org/roh/mirror/vcard#Email> .

<http://w3id.org/roh/mirror/vcard#n> a owl:ObjectProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "This object property has been mapped"@en .

ns3:AttendeeRole a owl:Class ;
    rdfs:label "Attendee Role"@en ;
    ns2:IAO_0000115 "A role of attending an Event or EventSeries" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:Center a owl:Class ;
    rdfs:label "Center"@en ;
    ns2:IAO_0000112 "Alchohol Education Center; Center for Arts and Public Policy; Hearing Research Center",
        "Short Definition take from http://www.thefreedictionary.com/center." ;
    ns2:IAO_0000115 "A place where a particular activity or service is concentrated.",
        "An organization where a specified activity is concentrated." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/foaf#Organization> .

ns3:Competition a owl:Class ;
    rdfs:label "Competition"@en ;
    ns2:IAO_0000112 "Intel Talent Search; poetry contest",
        "Not the same as an award or distinction." ;
    ns2:IAO_0000115 "An occasion on which a winner is selected from among two or more contestants." ;
    rdfs:subClassOf ns4:Activity .

ns3:ConferencePaper a owl:Class ;
    rdfs:label "Conference Paper"@en ;
    ns2:IAO_0000115 "A paper presented at a conference; optionally collected into a Proceedings or a special Journal issue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns10:Conference ;
            owl:onProperty ns10:presentedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns10:Proceedings ;
            owl:onProperty ns3:hasPublicationVenue ],
        ns10:AcademicArticle .

ns3:Consortium a owl:Class ;
    rdfs:label "Consortium"@en ;
    ns2:IAO_0000112 "Committee on Institutional Cooperation (CIC); The Five Colleges of Ohio" ;
    ns2:IAO_0000115 "A group  of independent organizations working together toward a common goal, under an expressed agreement." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/foaf#Organization> .

ns3:Course a owl:Class ;
    rdfs:label "Course"@en ;
    ns2:IAO_0000112 "A course as taught in one time period (such as a semester; although note that a course could consist of only one meeting (teaching session)) by one or more instructors, normally but not always for credit. Does not represent either each meeting of the course or the course offering such as Biology 101 taught every semester from 1980 to 2010" ;
    ns2:IAO_0000115 "A course as taught in one time period by one or more instructors, normally but not always for credit. Does not represent either each meeting of the course or the course offering such as Biology 101 taught every semester from 1980 to 2010" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:int ;
            owl:onProperty ns3:courseCredits ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:AcademicDegree ;
            owl:onProperty ns9:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:courseHours ],
        ns4:Activity .

ns3:EditorRole a owl:Class ;
    rdfs:label "Editor Role"@en ;
    ns2:IAO_0000112 "An ongoing editorial responsibility for a bibo:Collection, such as a Journal or Series" ;
    ns2:IAO_0000115 "An ongoing editorial responsibility for a bibo:Collection, such as a Journal or Series" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:Equipment a owl:Class ;
    rdfs:label "Equipment"@en,
        "équipements"@fr ;
    ns2:IAO_0000112 "A network server is one example. Medical schools and research laboratories can list professional equipment, such as microscopes.",
        "server; Bruker Vector-33 FT-IR" ;
    ns2:IAO_0000115 "A physical object provided for specific purpose, task or occupation." ;
    rdfs:comment "An Equipment belongs to an Organization and might be funded by a Funding.\\n\\nA vivo:Equipment, subclasss of roh:Infrastructure, belongs to a foaf:Organization and might be funded by a roh:Funding." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:freetextKeyword ],
        ns4:Reservable .

ns3:Exhibit a owl:Class ;
    rdfs:label "Exhibit"@en ;
    ns2:IAO_0000115 "The showing of an object or a collection of objects, in an organized manner." ;
    rdfs:subClassOf ns4:Activity .

ns3:FacultyAdministrativePosition a owl:Class ;
    rdfs:label "Faculty Administrative Position"@en ;
    ns2:IAO_0000112 "Associate Dean",
        "That is a position held by an academic faculty member who works for administration." ;
    ns2:IAO_0000115 "An academic administrative position (associate dean, etc.) as distinct from a professional administrative position (non-academic)" ;
    rdfs:subClassOf ns3:Position .

ns3:FacultyMentoringRelationship a owl:Class ;
    rdfs:label "Faculty Mentoring Relationship"@en ;
    ns2:IAO_0000115 "An advisory relationship in which one faculty member mentors another faculty member." ;
    rdfs:subClassOf ns3:AdvisingRelationship .

ns3:Foundation a owl:Class ;
    rdfs:label "Foundation"@en ;
    ns2:IAO_0000112 "Definition take from: http://dictionary.reference.com/browse/foundation.",
        "The Ford Foundation" ;
    ns2:IAO_0000115 "An institution founded with an endowment to support educational, research, artistic or other charitable activities." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/foaf#Organization> .

ns3:GraduateAdvisingRelationship a owl:Class ;
    rdfs:label "Graduate Advising Relationship"@en ;
    ns2:IAO_0000115 "An advisory relationship in which a professor advises a graduate student." ;
    rdfs:subClassOf ns3:AdvisingRelationship .

ns3:Internship a owl:Class ;
    rdfs:label "Internship"@en ;
    ns2:IAO_0000115 "Typically a student or a recent graduate undergoing supervised practical training." ;
    rdfs:comment "It is modelled within roh:Activity as subclass vivo:Internship. A foaf:Agent, being it either a foaf:Person or foaf:Organization roh:Participates in roh:Activity. Therefore, a person can describe in what university carried out this internship through this object property." ;
    rdfs:subClassOf ns4:Activity .

ns3:InvitedTalk a owl:Class ;
    rdfs:label "Invited Talk"@en ;
    rdfs:subClassOf ns3:Presentation .

ns3:LeaderRole a owl:Class ;
    rdfs:label "Leader Role"@en ;
    ns2:IAO_0000112 "A broad-ranging leader concept, from leading a small temporary committee to head of a large international organization." ;
    ns2:IAO_0000115 "A leadership role" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:Meeting a owl:Class ;
    rdfs:label "Meeting"@en ;
    ns2:IAO_0000115 "A gathering of people for a defined purpose, not necessarily public or announced" ;
    rdfs:subClassOf ns4:Activity .

ns3:MemberRole a owl:Class ;
    rdfs:label "Member Role"@en ;
    ns2:IAO_0000115 "A role of being a member in a Process or an Organization" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:NonAcademicPosition a owl:Class ;
    rdfs:label "Non-Academic Position"@en ;
    ns2:IAO_0000112 "Accounting & Research Services Assistant; Director of Information Technology",
        "Staff, support, and other non-academic positions." ;
    ns2:IAO_0000115 "A position classified as professional, staff, support, or any other non-academic role" ;
    rdfs:subClassOf ns3:Position .

ns3:PostdocOrFellowAdvisingRelationship a owl:Class ;
    rdfs:label "Postdoc or Fellow Advising Relationship"@en ;
    ns2:IAO_0000115 "An advisory relationship in which the advisee is a Postdoc or Fellow." ;
    rdfs:subClassOf ns3:AdvisingRelationship .

ns3:PresenterRole a owl:Class ;
    rdfs:label "Presenter Role"@en ;
    ns2:IAO_0000112 "Are we assuming that a PresenterRole is in a Presentation?  Or could you have a PresenterRole in, say, a committee?" ;
    ns2:IAO_0000115 "A role of presenting information" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:PrimaryPosition a owl:Class ;
    rdfs:label "Primary Position"@en ;
    ns2:IAO_0000112 "A position designated as primary by the organization or group where it is held. This designation may be applied to zero or more of an agent's positions and may be asserted in conjunction with other subclasses of position." ;
    ns2:IAO_0000115 "A position designated as primary by the organization where it is held." ;
    rdfs:subClassOf ns3:Position .

ns3:UndergraduateAdvisingRelationship a owl:Class ;
    rdfs:label "Undergraduate Advising Relationship"@en ;
    ns2:IAO_0000115 "An advisory relationship in which a professor advises an undergraduate student." ;
    rdfs:subClassOf ns3:AdvisingRelationship .

ns3:contactInformation a owl:DatatypeProperty ;
    rdfs:label "contact information"@en ;
    rdfs:comment "The contact information of an Entity."@en .

ns3:courseCredits a owl:DatatypeProperty ;
    rdfs:label "credits"@en ;
    rdfs:comment "The number of credits a course has."@en .

ns3:dateTime a owl:DatatypeProperty ;
    rdfs:label "date/time"@en ;
    rdfs:comment "A xsd:date/time value."@en ;
    rdfs:range xsd:dateTime .

ns3:eligibleFor a owl:ObjectProperty ;
    rdfs:label "credential eligibility attained"@en ;
    rdfs:comment "A property used when a Person is elegible to obtain an Accreditation."@en .

ns3:hasPredecessorOrganization a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "predecessor organization"@en ;
    rdfs:comment "The Organization from which the new Organization has created."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:subPropertyOf ns4:hasPredecessor ;
    owl:inverseOf ns3:hasSuccessorOrganization .

ns3:publicationVenueFor a owl:ObjectProperty ;
    rdfs:label "publication venue for"@en ;
    rdfs:comment "The collection of documents in which a publication is published."@en .

ns3:publisherOf a owl:ObjectProperty ;
    rdfs:label "publishes"@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Agent> ;
    rdfs:range ns10:Document .

ns3:rank a owl:DatatypeProperty ;
    rdfs:label "rank"@en ;
    rdfs:comment "this number indicates a position in a list"@en .

ns3:supportedInformationResource a owl:ObjectProperty ;
    rdfs:label "supported publications or other works"@en ;
    rdfs:comment "an information resource (typically a publication) supported by (typically via funding) an agreement (such as a grant)"@en .

ns2:RO_0000057 a owl:ObjectProperty .

onto: a owl:Ontology ;
    dc:contributor "Alejandro González Hevia",
        "Diego López de Ipiña",
        "Esteban Sota",
        "Iñigo Apellániz",
        "José Emilio Labra Gayo",
        "Álvaro Palacios" ;
    dc:creator "Emilio Rubiera Azcona",
        "Mikel Emaldi" ;
    dc:description "An ontology to address the Research Management of the CRUE's Spanish University System (Sistema Universitario Español) by applying an encompassing model not only capable of addressing the universities of the CRUE but also more belonging to the European Union." ;
    dc:title "The ASIO ontology" ;
    rdfs:comment "The University of Murcia signed on November 29, 2017, a Covenant with the Ministry of Economy, Industry and Competitiveness backing the “HÉRCULES: Semantic University Research Data” Project with a budget of FIVE MILLION FOUR HUNDRED AND SIXTY-TWO THOUSAND SIX HUNDRED euros with an 80% of co-financiering from the European Regional Development Fund program (ERDF) within the 2014-2020 period. \\n\\nThe project arose as a CRUE initiative, to create the basis for a new collaboration model between universities, to develop the information management systems and with the main objective of encouraging this type of collaboration.\\n\\nTherefore, the purpose of this agreement was to contribute to the improvement of public services and business innovation and research through the improvement of:\\n\\n    efficiency in public investment by decreasing the duplication of investment in R&D.\\n    efficiency of research in universities.\\n    scientific dissemination of research results.\\n    detection of synergies in R&D between universities.\\n    transfer of R&D results to companies.\\n    efficiency in the management of research. \\n\\nby creating a research management system with semantic capacities based on semantic open data and that will provide a global view of the research data contained in the Spanish University System."@en ;
    owl:versionIRI <http://w3id.org/roh/0.3> ;
    owl:versionInfo "0.3" ;
    schema:identifier onto: ;
    ns8:license <https://creativecommons.org/licenses/by-sa/4.0/>,
        <https://creativecommons.org/publicdomain/zero/1.0/> ;
    ns6:primaryTopic onto: .

ns4:AccreditationIssuer a owl:Class ;
    rdfs:label "Accreditation Issuer"@en ;
    rdfs:comment "An organization with a relevant or de facto authority or assumed competence to issue research or academic accreditations."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://w3id.org/roh/mirror/foaf#Organization> [ a owl:Restriction ;
                        owl:onProperty ns4:issues ;
                        owl:someValuesFrom ns4:Accreditation ] [ a owl:Restriction ;
                        owl:allValuesFrom ns4:Accreditation ;
                        owl:onProperty ns4:issues ] ) ] .

ns4:BachelorsThesis a owl:Class ;
    rdfs:label "Bachelor's Thesis"@en,
        "Degree Thesis"@en,
        "Mémoire de fin de licence"@fr ;
    ns1:altLabel "Honour's thesis"@en-ca,
        "Honour's thesis"@en-gb,
        "Honor's thesis"@en-us ;
    ns1:prefLabel "Bachelor's Thesis"@en,
        "Mémoire de fin de licence"@fr ;
    rdfs:comment "A document created to summarize research findings associated with the completion of an academic degree."@en,
        "A thesis reporting a research project undertaken as part of an undergraduate course of education to receive a bachelor's degree."@en ;
    rdfs:subClassOf ns10:Thesis ;
    owl:disjointWith ns4:MastersThesis,
        ns4:PhDThesis .

ns4:DegreeMetric a owl:Class ;
    rdfs:label "Degree Metric"@en ;
    rdfs:subClassOf ns4:Metric .

ns4:Grant a owl:Class ;
    rdfs:label "Grant"@en ;
    rdfs:comment "A financial award provided by a funding organisation for a particular project or purpose, usually awarded on the basis of a competitive application."@en,
        "An amount of money given especially by the government to a person or organization for a special purpose."@en ;
    rdfs:subClassOf ns4:Funding .

ns4:Invoice a owl:Class ;
    rdfs:label "Invoice"@en ;
    rdfs:subClassOf ns10:Document .

ns4:PatentExpense a owl:Class ;
    rdfs:label "Patent Expense"@en ;
    rdfs:subClassOf ns4:Expense .

ns4:PersonContract a owl:Class ;
    rdfs:label "Person Contract"@en,
        "Contrat de travail"@fr ;
    ns1:prefLabel "Employment contract"@en,
        "Contrat de travail"@fr ;
    rdfs:comment "An agreement between a person and an organization to work in a project for a specified duration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:hasHRClassification ;
            owl:someValuesFrom ns1:Concept ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Concept ;
            owl:onProperty ns4:hasHRClassification ],
        ns3:Contract ;
    owl:disjointWith ns4:ProjectContract .

ns4:PersonExpense a owl:Class ;
    rdfs:label "Person Expense"@en ;
    rdfs:comment "A ProjectExpense is carried out by a Researcher (by default the principal researcher) in charge of a Project, which indirectly links it to Funding, understood as a set of FundingAmounts. The types of expenses considered are: Personnel Expenses, Subcontracting, Travel, Equipment, Research Infrastructure and Other Goods and Services.\"^^rdfs:Literal"@en ;
    rdfs:subClassOf ns4:Expense ;
    owl:disjointWith ns4:ProjectExpense .

ns4:PhDSupervisingRelationship a owl:Class ;
    rdfs:label "PhD Supervising Relationship"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:PhDThesis ;
            owl:onProperty ns4:produces ],
        ns4:SupervisingRelationship .

ns4:ResearchMethod a owl:Class ;
    rdfs:label "Research method"@en ;
    ns1:prefLabel "Research method"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000015> .

ns4:ResearchObject a owl:Class ;
    rdfs:label "Research Object"@en ;
    rdfs:comment "A roh:ResearchObject is generated by one to several foaf:Person specified through property bibo:authorList. Usually a roh:ResearchObject results from the work in a vivo:Project (roh:produces). An elaborated taxonomy of research objects is provided, covering all types of publications, Patents, Software and Webpage. The main author of a research object is accessible through property roh:correspondingAuthor."@en ;
    rdfs:subClassOf ns4:ResearchResult ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty ns4:partOfResearchResult ;
                        owl:someValuesFrom ns4:ResearchResult ] [ a owl:Restriction ;
                        owl:allValuesFrom ns3:Project ;
                        owl:onProperty ns4:producedBy ] ) ] .

ns4:ResearchObjectExpense a owl:Class ;
    rdfs:label "Research Object Expense"@en ;
    rdfs:subClassOf ns4:Expense .

ns4:ResearchProblem a owl:Class ;
    rdfs:label "Research problem"@en ;
    ns1:prefLabel "Research problem"@en ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:ReservableConsumerRole a owl:Class ;
    rdfs:label "ReservableConsumerRole"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns4:ReservableProviderRole a owl:Class ;
    rdfs:label "ReservableProviderRole"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns4:Submitted a owl:Class ;
    rdfs:label "Submitted"@en ;
    rdfs:subClassOf ns4:Status .

ns4:TestFundingProgram a ns4:FundingProgram,
        owl:NamedIndividual ;
    rdfs:label "TestFundingProgram"@en .

ns4:TestPhDStudent a <http://w3id.org/roh/mirror/foaf#Person>,
        owl:NamedIndividual ;
    rdfs:label "TestPhDStudent"@en .

ns4:TestPhdCoSupervisor a <http://w3id.org/roh/mirror/foaf#Person>,
        owl:NamedIndividual ;
    rdfs:label "TestPhdCoSupervisor"@en .

ns4:TestPhdSupervisor a <http://w3id.org/roh/mirror/foaf#Person>,
        owl:NamedIndividual ;
    rdfs:label "TestPhdSupervisor"@en .

ns4:citationCount a owl:DatatypeProperty ;
    rdfs:label "citation count"@en ;
    rdfs:comment "the number of times a publication has been cited (when used in PublicationMetric) or the total number of citations for all of an author's works (when used in AuthorMetric)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns4:AuthorMetric ns4:PublicationMetric ) ] ;
    rdfs:range xsd:integer .

ns4:correspondingOrganization a owl:ObjectProperty ;
    rdfs:label "correspondingOrganization"@en ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Organization> ;
    owl:inverseOf ns4:correspondingOrganizationOf .

ns4:cumLaude a owl:DatatypeProperty ;
    rdfs:label "cum laude"@en ;
    rdfs:comment "Meaning \"with praise\", used to indicate the level of distinction with which an academic degree has been earned."@en ;
    rdfs:domain ns4:ThesisMetric ;
    rdfs:range xsd:boolean .

ns4:currency a owl:DatatypeProperty ;
    rdfs:label "currency"@en ;
    rdfs:comment "Data property used by roh:Funding and roh:FundingAmount" .

ns4:grants a owl:ObjectProperty ;
    rdfs:label "grants"@en ;
    rdfs:comment "An object property linking a FundingAmount with an Organization."@en ;
    rdfs:domain ns4:FundingAmount ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Organization> .

ns4:hasCV a owl:ObjectProperty ;
    rdfs:label "has CV"@en ;
    rdfs:comment "An object property linking a Person with her CV."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Person> ;
    rdfs:range ns4:CurriculumVitae .

ns4:hasReadme a owl:ObjectProperty ;
    rdfs:label "has readme"@en ;
    rdfs:comment "This object property is used to specify the README document of a given  Respository or Software."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns4:Repository <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ) ] ;
    rdfs:range ns4:README ;
    owl:inverseOf ns4:readmeOf .

ns4:impactFactor a owl:DatatypeProperty ;
    rdfs:label "impact factor"@en ;
    rdfs:comment "A scientometric index that reflects the yearly average number of citations that articles published in the last two years in a given journal received."@en ;
    rdfs:domain ns4:JournalMetric ;
    rdfs:range xsd:float .

ns4:impactFactorName a owl:DatatypeProperty ;
    rdfs:domain ns4:JournalMetric ;
    rdfs:range xsd:string .

ns4:isSupportedBy a owl:ObjectProperty ;
    rdfs:label "is supported by"@en ;
    rdfs:comment "A Project supported by a Funding."@en ;
    rdfs:range ns4:Funding ;
    owl:inverseOf ns4:supports .

ns4:languageOfTheCertificate a owl:DatatypeProperty ;
    rdfs:label "language of the certificate"@en ;
    rdfs:comment "The language to which refers the Language Certificate."@en ;
    rdfs:domain ns4:LanguageCertificate ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ns4:languageSkill .

ns4:listeningSkill a owl:DatatypeProperty ;
    rdfs:label "listening skill"@en ;
    rdfs:comment "The ability to understand spoken language."@en ;
    rdfs:domain ns4:LanguageCertificate ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "A1" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "A2" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "B1" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "B2" ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "C1" ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "C2" ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    rdfs:subPropertyOf ns4:languageSkill .

ns4:mark a owl:DatatypeProperty ;
    rdfs:label "mark"@en ;
    rdfs:comment "A judgment, expressed as a number or letter, about the quality of a work."@en ;
    rdfs:domain ns4:ThesisMetric ;
    rdfs:range xsd:string .

ns4:metricName a owl:DatatypeProperty ;
    rdfs:label "metric name"@en ;
    rdfs:comment "The name of a Metric."@en ;
    rdfs:domain ns4:Metric .

ns4:metricOf a owl:ObjectProperty ;
    rdfs:label "metric of"@en ;
    rdfs:comment "relates a Metric to the entity it describes"@en ;
    rdfs:domain ns4:Metric .

ns4:modality a owl:DatatypeProperty ;
    rdfs:label "modalidad"@en ;
    rdfs:comment "A free text property to represent the modality of a Project."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns10:Patent ns3:Project ) ] ;
    rdfs:range xsd:string .

ns4:ownerOrganization a owl:ObjectProperty ;
    rdfs:label "owner organization"@en ;
    rdfs:comment "A Patent has an Organization who owns it."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns4:PatentApplication ns10:Patent ) ] ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Organization> ;
    owl:inverseOf ns4:ownerOrganizationOf .

ns4:partOfRepository a owl:ObjectProperty ;
    rdfs:label "part of repository"@en ;
    rdfs:comment "A core relation that holds between a part and its hole, that in this case is a Repository."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns4:ExperimentalProtocol ns10:Document <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ) ] ;
    rdfs:range ns4:Repository ;
    rdfs:subPropertyOf ns9:BFO_0000050 ;
    owl:inverseOf ns4:repositoryHasPart .

ns4:participatedBy a owl:ObjectProperty ;
    rdfs:label "participated by"@en ;
    rdfs:comment "An Activity participated by an Entity."@en ;
    rdfs:domain ns4:Activity ;
    owl:inverseOf ns4:participates .

ns4:projectStatus a owl:ObjectProperty ;
    rdfs:label "project status"@en ;
    rdfs:comment "A project may be in a CLOSED, OPEN or in other future status that may be defined." ;
    rdfs:domain ns3:Project ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:Closed ns4:Open ns4:ProposalSubmitted ns4:Rejected ) ] .

ns4:promotedBy a owl:ObjectProperty ;
    rdfs:label "promoted by"@en ;
    rdfs:comment "A Funding Program or Funding Source promoted by a Funding Organization."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns4:FundingProgram ns4:FundingSource ) ] ;
    rdfs:range ns3:FundingOrganization ;
    owl:inverseOf ns4:promotes .

ns4:provides a owl:ObjectProperty ;
    rdfs:label "provides"@en ;
    rdfs:comment "An Organization which provides a Service."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:range <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> .

ns4:publicCompany a owl:DatatypeProperty ;
    rdfs:label "public company"@en ;
    rdfs:comment "To define if a Company is public or not."@en ;
    rdfs:domain ns3:Company ;
    rdfs:range xsd:boolean .

ns4:readingSkill a owl:DatatypeProperty ;
    rdfs:label "reading skill"@en ;
    rdfs:comment "The ability to understand written text."@en ;
    rdfs:domain ns4:LanguageCertificate ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "A1" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "A2" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "B1" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "B2" ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "C1" ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "C2" ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    rdfs:subPropertyOf ns4:languageSkill .

ns4:repositoryHasPart a owl:ObjectProperty ;
    rdfs:label "repository has part"@en ;
    rdfs:comment "A core relation that holds between a whole, that in this case is an Repository, and its part ."@en ;
    rdfs:domain ns4:Repository ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:ExperimentalProtocol ns10:Document <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ) ] ;
    rdfs:subPropertyOf ns9:BFO_0000051 .

ns4:repositoryStatus a owl:ObjectProperty ;
    rdfs:label "repository status"@en ;
    rdfs:domain ns4:Repository ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:Closed ns4:Open ) ] .

ns4:researchResultHasPart a owl:ObjectProperty ;
    rdfs:label "research result has part"@en ;
    rdfs:domain ns4:ResearchResult ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:ExperimentalProtocol ns10:Document <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ) ] ;
    rdfs:subPropertyOf ns9:BFO_0000051 .

ns4:reservableOf a owl:ObjectProperty ;
    rdfs:label "reservable of"@en ;
    rdfs:comment "An Infrastructure belonging to an Agent."@en ;
    rdfs:domain ns4:Reservable ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Agent> .

ns4:speakingSkill a owl:DatatypeProperty ;
    rdfs:label "speaking skill"@en ;
    rdfs:comment "The ability to speak a language."@en ;
    rdfs:domain ns4:LanguageCertificate ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "A1" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "A2" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "B1" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "B2" ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "C1" ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "C2" ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    rdfs:subPropertyOf ns4:languageSkill .

ns4:spokenInteractionSkill a owl:DatatypeProperty ;
    rdfs:label "spoken interaction skill"@en ;
    rdfs:comment "The ability to participate into a conversation."@en ;
    rdfs:domain ns4:LanguageCertificate ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "A1" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "A2" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "B1" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "B2" ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "C1" ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "C2" ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    rdfs:subPropertyOf ns4:languageSkill .

ns4:writingSkill a owl:DatatypeProperty ;
    rdfs:label "writing skill"@en ;
    rdfs:comment "The ability to write into a certain language."@en ;
    rdfs:domain ns4:LanguageCertificate ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "A1" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "A2" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "B1" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "B2" ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "C1" ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "C2" ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    rdfs:subPropertyOf ns4:languageSkill .

ns10:AudioVisualDocument a owl:Class ;
    rdfs:label "Audio-visual document"@en ;
    rdfs:comment "Audiovisual recording in any format"@en ;
    rdfs:subClassOf ns10:Document .

ns10:Conference a owl:Class ;
    rdfs:label "Conference"@en ;
    ns2:IAO_0000112 "2010 International Congress on Autoimmunity; American Libraries Association 2009",
        "core:Seminar and bibo:Conference are very similar." ;
    ns2:IAO_0000115 "A meeting for consultation or discussion." ;
    rdfs:comment "A meeting for consultation or discussion."@en,
        "A meeting for consultation or discussion. [Source: http://purl.org/ontology/bibo/Conference]"@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:abbreviation ],
        ns4:Activity ;
    ns5:term_status "stable" .

ns10:Issue a owl:Class ;
    rdfs:label "Issue"@en ;
    rdfs:comment "something that is printed or published and distributed, esp. a given number of a periodical"@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns9:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns10:Article ;
            owl:onProperty ns9:BFO_0000051 ],
        ns10:CollectedDocument ;
    ns5:term_status "stable" .

ns10:Journal a owl:Class ;
    rdfs:label "Journal"@en ;
    ns2:IAO_0000112 "Articles usually contain abstracts and bibliographies. Includes peer-reviewed, non-peer-reviewed, and open access journals. Journals are usually indexed in the major academic databases such as PubMed and Web of Science.",
        "Journal of Information Science; IEEE Intelligent System; Scientometrics" ;
    ns2:IAO_0000115 "Contains original scholarly research or review articles by experts in the field" ;
    rdfs:comment "A periodical of scholarly journal Articles."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:abbreviation ],
        [ a owl:Restriction ;
            owl:onProperty ns4:hasMetric ;
            owl:someValuesFrom ns4:JournalMetric ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:JournalMetric ;
            owl:onProperty ns4:hasMetric ],
        ns10:Periodical ;
    owl:disjointWith ns10:Magazine ;
    ns5:term_status "stable" .

ns10:Proceedings a owl:Class ;
    rdfs:label "Proceedings"@en ;
    ns2:IAO_0000112 "Short Definition copied from bibo ontology" ;
    ns2:IAO_0000115 "A compilation of documents published from an event, such as a conference" ;
    rdfs:comment "A book integrated by a compilation of documents published from an event, such as a conference."@en,
        "A compilation of documents published from an event, such as a conference."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf ns10:Book ;
    ns5:term_status "unstable" .

ns10:contributorList a owl:ObjectProperty ;
    rdfs:label "list of contributors"@en ;
    rdfs:comment "An ordered list of contributors. Normally, this list is seen as a priority list that order contributors by importance."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    ns5:term_status "stable" .

ns10:edition a owl:DatatypeProperty ;
    rdfs:label "edition"@en ;
    rdfs:comment "The different versions that a document could have."@en .

<http://w3id.org/roh/mirror/foaf#Image> a owl:Class ;
    rdfs:label "Image" ;
    rdfs:comment "An image." ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    rdfs:subClassOf ns10:Document ;
    ns5:term_status "stable" .

<http://w3id.org/roh/mirror/foaf#name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "A name for some thing." ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    rdfs:range rdfs:Literal ;
    ns5:term_status "testing" .

<http://w3id.org/roh/mirror/obo/bfo#BFO_0000148> a owl:Class ;
    rdfs:label "Zero-Dimensional Temporal Region"@en ;
    rdfs:comment "A zero-dimensional temporal region is a temporal region that is without extent."@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000008> .

<http://w3id.org/roh/mirror/obo/iao#IAO_0000027> a owl:Class ;
    rdfs:label "Data Item"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/iao#IAO_0000030> .

<http://w3id.org/roh/mirror/vcard#Individual> a owl:Class ;
    rdfs:label "Individual"@en ;
    rdfs:comment "An object representing a single person or entity"@en ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/vcard> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/vcard#Kind> .

<http://w3id.org/roh/mirror/vcard#Organization> a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "An object representing an organization.  An organization is a single entity, and might represent a business or government, a department or division within a business or government, a club, an association, or the like."@en ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/vcard> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/vcard#Kind> .

<http://w3id.org/roh/mirror/vcard#locality> a owl:DatatypeProperty ;
    rdfs:label "locality"@en ;
    rdfs:comment "The locality (e.g. city or town) associated with the address of the object"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns> ;
    rdfs:range xsd:string .

ns3:Abstract a owl:Class ;
    rdfs:label "Abstract"@en ;
    ns2:IAO_0000115 "An abstract that is published as a standalone document or in a journal of abstracts" ;
    rdfs:comment "An abstract that is published as a standalone document or in a journal of abstracts."@en ;
    rdfs:subClassOf ns10:Document .

ns3:AdministratorRole a owl:Class ;
    rdfs:label "Administrator Role"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:AdviseeRole a owl:Class ;
    rdfs:label "Advisee Role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:roleOf ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ;
            owl:onProperty ns4:roleOf ],
        <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:AdvisorRole a owl:Class ;
    rdfs:label "Advisor Role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:roleOf ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ;
            owl:onProperty ns4:roleOf ],
        <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:ConferencePoster a owl:Class ;
    rdfs:label "Conference Poster"@en ;
    ns2:IAO_0000115 "The digital file (or physical equivalent), if available after the conference, vs. the act of attending/presenting: use ConferencePresentation for information about date/time/location/name of the event where the poster was presented" ;
    rdfs:subClassOf ns10:Document .

ns3:Dataset a owl:Class ;
    rdfs:label "Dataset"@en ;
    ns2:IAO_0000112 "US Patent Data; US Job Data" ;
    ns2:IAO_0000115 "A named collection of data, usually containing only one type of data" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns10:Document ;
            owl:onProperty <http://purl.org/spar/cito/isCitedAsDataSourceBy> ],
        ns10:Document .

ns3:Department a owl:Class ;
    rdfs:label "Department"@en ;
    ns2:IAO_0000112 "Definition modified from the definition here: http://dictionary.reference.com/browse/department. It is difficult to tell the difference between and department and a division.",
        "Legal (department within a company); Use for any non-academic department" ;
    ns2:IAO_0000115 "A unit within a larger organization that addresses a specific subject or area of activity." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/foaf#Organization> .

ns3:EditorialArticle a owl:Class ;
    rdfs:label "Editorial Article"@en ;
    ns2:IAO_0000115 "An article of opinion, typically published in a newspaper. For academics, most commonly Op Ed pieces" ;
    rdfs:subClassOf ns10:Article .

ns3:Facility a owl:Class ;
    rdfs:label "Facility"@en,
        "établissement"@fr ;
    ns2:IAO_0000112 "Distinct from the organization that runs it; e.g., a laboratory may be an organization but may be run by another organization and only consist of facilities housing equipment or services. Can be a building or place that provides a particular service or is used for a particular activity. Use the specific Building or Room whenever possible. Short definition from http://dictionary.reference.com/browse/facility.",
        "Use subclasses of core:Facility subclasses instead of this class if possible" ;
    ns2:IAO_0000115 "Something designed, built, installed, etc., to serve a specific function or activity affording a convenience or service." ;
    rdfs:comment "A vivo:Facility belongs to an foaf:Organization and might be funded by a roh:Funding." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:Facility ;
            owl:onProperty ns9:BFO_0000051 ],
        ns4:Reservable .

ns3:FacultyPosition a owl:Class ;
    rdfs:label "Faculty Position"@en ;
    ns2:IAO_0000112 "Professor, associate professor and assistant professor are common positions for academic faculty.",
        "Professor; Associate Professor; Assistant Professor" ;
    ns2:IAO_0000115 "Academic position in a university or institution" ;
    rdfs:subClassOf ns3:Position .

ns3:Institute a owl:Class ;
    rdfs:label "Institute"@en ;
    ns2:IAO_0000112 "Institute for Fundamental Theory" ;
    ns2:IAO_0000115 "An Institute normally has a research focus but may also fulfill instructional or outreach roles",
        "An organization founded to pursue or promote certain research, educational or public policy interests or activities." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/foaf#Organization> .

ns3:InvestigatorRole a owl:Class ;
    rdfs:label "Investigator Role"@en ;
    ns2:IAO_0000115 "A role in an Agreement (for example, a grant) as a named investigator or key personnel." ;
    rdfs:subClassOf ns3:ResearcherRole .

ns3:LibrarianPosition a owl:Class ;
    rdfs:label "Librarian Position"@en ;
    ns2:IAO_0000112 "It is the common position in libraries.",
        "Librarian; Library Systems Analyst; Music Bibliographer" ;
    ns2:IAO_0000115 "A position held  by library and information science professionals, or academic or technical experts, in support of providing information services or materials" ;
    rdfs:subClassOf ns3:Position .

ns3:NonFacultyAcademicPosition a owl:Class ;
    rdfs:label "Non-Faculty Academic Position"@en ;
    ns2:IAO_0000112 "Researcher; Academic Extension Associate; Postdoctoral Associate",
        "Those positions are held by people who do academic work but do not have faculty positions in universities or institutes." ;
    ns2:IAO_0000115 "A position involving academic work but without faculty status" ;
    rdfs:subClassOf ns3:Position .

ns3:OrganizerRole a owl:Class ;
    rdfs:label "Organizer Role"@en ;
    ns2:IAO_0000115 "A role of organizing" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:ReviewerRole a owl:Class ;
    rdfs:label "Reviewer Role"@en ;
    ns2:IAO_0000112 "A role that encompasses both ongoing reviewer responsibility for a bibo:Collection, such as a Journal or Series, and also a review performed for a bibo:Document, such as a book, academic article or conference paper." ;
    ns2:IAO_0000115 "A role that encompasses both ongoing reviewer responsibility for a bibo:Collection, such as a Journal or Series, and also a review performed for a bibo:Document, such as a book, academic article or conference paper." ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:TeacherRole a owl:Class ;
    rdfs:label "Teacher Role"@en ;
    ns2:IAO_0000115 "A role of serving as an educator" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:assignedBy a owl:ObjectProperty ;
    rdfs:label "assigned by"@en ;
    rdfs:comment "Relates a Relationship (as a predicate or n-ary relation over one or more Thing) to an Agent that defined or instantiated the predicate instance."@en .

ns3:end a owl:ObjectProperty ;
    rdfs:label "end"@en ;
    rdfs:comment "The date/time value in which something ends."@en ;
    rdfs:domain ns3:DateTimeInterval ;
    rdfs:range ns3:DateTimeValue ;
    rdfs:subPropertyOf ns3:dateTimeValue .

ns3:hasGoverningAuthority a owl:ObjectProperty ;
    rdfs:label "governing authority"@en ;
    rdfs:comment "An authority which is in charge of managing something."@en .

ns3:hasSuccessorOrganization a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "successor organization"@en ;
    rdfs:comment "The Organization created from a previous Organization."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Organization> ;
    rdfs:subPropertyOf ns4:hasSucessor .

ns2:BFO_0000040 a owl:Class .

<http://purl.org/spar/cito/cites> a owl:ObjectProperty ;
    rdfs:label "cites"@en ;
    rdfs:comment "The citing entity cites the cited entity, either directly and explicitly (as in the reference list of a journal article), indirectly (e.g. by citing a more recent paper by the same group on the same topic), or implicitly (e.g. as in artistic quotations or parodies, or in cases of plagiarism)."@en ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf <http://purl.org/spar/cito/isCitedBy> .

ns4:AuditeeRole a owl:Class ;
    rdfs:label "Auditee Role"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns4:AuditorRole a owl:Class ;
    rdfs:label "Auditor Role"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns4:AuthorMetric a owl:Class ;
    rdfs:label "Author Metric"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ns4:h-index ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Agent> ;
            owl:onProperty ns4:metricOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ns4:citationCount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ns4:i10-index ],
        ns4:Metric .

ns4:CompanyClassification a owl:Class ;
    rdfs:label "Company Classification"@en ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:Country a owl:Class ;
    rdfs:label "Country"@en,
        "Pays"@fr ;
    ns1:prefLabel "Country"@en,
        "Pays"@fr ;
    rdfs:comment "A region legally identified as a distinct entity in political geography."@en ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:Dossier a owl:Class ;
    rdfs:label "Dossier"@en ;
    rdfs:comment "File is a collection in which all assets related to a Project are stored, including the Research Proposal, approval documents, viability plans and so on associated to a project are stored."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:FundingProgram ns4:ProjectContract ns10:Report ns3:Project ) ] ;
            owl:onProperty ns3:relates ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:identifier ],
        [ a owl:Restriction ;
            owl:onProperty ns3:description ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns3:identifier ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ns4:title ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        ns10:Collection ;
    owl:disjointWith ns10:Periodical .

ns4:EvaluationSummary a owl:Class ;
    rdfs:label "Evaluation Summary"@en ;
    rdfs:comment "An evaluation summary provided by a funding organization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:Final ns4:Provisional ) ] ;
            owl:onProperty ns4:evaluationStatus ],
        ns10:Report .

ns4:ExpenseClassification a owl:Class ;
    rdfs:label "Expense Classification"@en ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:FundingProgramClassification a owl:Class ;
    rdfs:label "Funding Program Classification"@en ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:MastersThesis a owl:Class ;
    rdfs:label "Master's Thesis"@en,
        "Mémoire de maîtrise"@fr-ca,
        "Mémoire de maîtrise"@fr-fr ;
    ns1:prefLabel "Master's thesis"@en,
        "Mémoire de maîtrise"@fr-ca,
        "Mémoire de maîtrise"@fr-fr ;
    rdfs:comment "A document created to summarize research findings associated with the completion of a master's degree."@en,
        "A thesis reporting a research project undertaken as part of a second-cycle course of education to receive a master's degree."@en ;
    rdfs:subClassOf ns10:Thesis ;
    owl:disjointWith ns4:PhDThesis .

ns4:ProjectExpense a owl:Class ;
    rdfs:label "Project Expense"@en ;
    rdfs:comment "A ProjectExpense is carried out by a Researcher (by default the principal researcher) in charge of a Project, which indirectly links it to Funding, understood as a set of FundingAmounts. The types of expenses considered are: Personnel Expenses, Subcontracting, Travel, Equipment, Research Infrastructure and Other Goods and Services."^^rdfs:Literal ;
    rdfs:subClassOf ns4:Expense .

ns4:PropertyClassification a owl:Class ;
    rdfs:label "Property Classification"@en ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:ProposalSubmitted a owl:Class ;
    rdfs:label "Proposal Submitted"@en ;
    rdfs:subClassOf ns4:Status .

ns4:TestBook a ns10:Book,
        owl:NamedIndividual ;
    rdfs:label "TestBook"@en ;
    ns10:editorList ns4:TestListofEditors .

ns4:TestPhDSupervisingRelationship a ns4:PhDSupervisingRelationship,
        owl:NamedIndividual ;
    rdfs:label "TestPhDSupervisingRelationship"@en ;
    ns3:dateTimeInterval ns4:TestDateTimeInterval ;
    ns3:relates ns4:TestPhDStudent,
        ns4:TestPhdCoSupervisor,
        ns4:TestPhdSupervisor .

ns4:ThesisMetric a owl:Class ;
    rdfs:label "Thesis Metric"@en ;
    rdfs:subClassOf ns4:DegreeMetric .

ns4:awardedBy a owl:ObjectProperty ;
    rdfs:label "awarded by"@en ;
    rdfs:comment "An object property linking an AwardedDegree to the University that awarded it."@en ;
    rdfs:domain ns3:AwardedDegree ;
    rdfs:range ns3:University ;
    owl:inverseOf ns4:awards .

ns4:documentStatus a owl:ObjectProperty ;
    rdfs:label "document status"@en ;
    rdfs:comment "The status of a Document (Accepted or Rejected)."@en ;
    rdfs:domain ns10:Document ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:Accepted ns4:Rejected ) ] .

ns4:fundedBy a owl:ObjectProperty ;
    rdfs:label "fundedBy"@en ;
    rdfs:comment "An object property linking a Thing when is funded by another Thing."@en ;
    owl:inverseOf ns4:funds .

ns4:funds a owl:ObjectProperty ;
    rdfs:label "funds"@en ;
    rdfs:comment "An object property linking a Thing when it funds another Thing."@en .

ns4:hasAccreditation a owl:ObjectProperty ;
    rdfs:label "has accreditation"@en ;
    rdfs:comment "An object property linking an Agent with an Accreditation it posseses."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/foaf#Agent> ;
    rdfs:range ns4:Accreditation .

ns4:hasHRClassification a owl:ObjectProperty ;
    rdfs:label "has HR classification"@en ;
    rdfs:comment "The position a person has inside its organization."@en ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:HRClassification ] ) ] ;
    owl:inverseOf ns4:hrClassificationOf .

ns4:hasLicense a owl:ObjectProperty ;
    rdfs:label "has license"@en ;
    rdfs:comment "Esta propiedad nos permite especificar la licencia (vivo:License) de una instancia."@en,
        "This object property is used to specify the licence (vivo:License) of a given instance."@en ;
    rdfs:range ns3:License .

ns4:hasSucessor a owl:ObjectProperty ;
    rdfs:label "has sucessor"@en .

ns4:issues a owl:ObjectProperty ;
    rdfs:label "issues"@en ;
    rdfs:comment "An Accreditation Issuer which issues an Accreditation."@en ;
    rdfs:domain ns4:AccreditationIssuer ;
    rdfs:range ns4:Accreditation .

ns4:monetaryAmount a owl:DatatypeProperty ;
    rdfs:label "monetary amount"@en ;
    rdfs:comment "Data property used by roh:Funding and roh:FundingAmount" ;
    rdfs:range xsd:decimal .

ns4:promotes a owl:ObjectProperty ;
    rdfs:label "promotes"@en ;
    rdfs:comment "A Funding Organization which promotes a Funding Program or a Funding Source."@en ;
    rdfs:domain ns3:FundingOrganization ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:FundingProgram ns4:FundingSource ) ] .

ns4:readmeOf a owl:ObjectProperty ;
    rdfs:label "readme of"@en ;
    rdfs:comment "This object property is used to specify the Repository or Software of a given README document."@en ;
    rdfs:domain ns4:README ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns4:Repository <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ) ] .

ns10:AcademicArticle a owl:Class ;
    rdfs:label "Academic Article"@en ;
    ns2:IAO_0000112 "A specific academic journal article" ;
    ns2:IAO_0000115 "Written by scholars for other scholars, typically published in an academic journal with an abstract and bibliography" ;
    rdfs:comment "A scholarly academic article, typically published in a journal."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns10:Journal ns10:Proceedings ) ] ;
            owl:onProperty ns3:hasPublicationVenue ],
        [ a owl:Restriction ;
            owl:onProperty ns4:correspondingAuthor ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:PublicationMetric ;
            owl:onProperty ns4:hasMetric ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:eanucc13 ],
        ns10:Article ;
    owl:disjointWith ns3:EditorialArticle ;
    ns5:term_status "stable" .

ns10:Chapter a owl:Class ;
    rdfs:label "Chapter"@en ;
    ns2:IAO_0000115 "A main division of a book" ;
    rdfs:comment "A chapter of a book."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf ns10:BookSection ;
    ns5:term_status "unstable" .

ns10:DocumentPart a owl:Class ;
    rdfs:label "Document Part"@en ;
    ns2:IAO_0000112 "Short Definition from the bibo ontology" ;
    ns2:IAO_0000115 "A distinct part of a larger document or collected document" ;
    rdfs:comment "a distinct part of a larger document or collected document."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns3:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:placeOfPublication ],
        ns10:Document ;
    ns5:term_status "unstable" .

ns10:Periodical a owl:Class ;
    rdfs:label "Periodical"@en ;
    rdfs:comment "A group of related documents issued at regular intervals."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns3:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:issn ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:eissn ],
        ns10:Collection ;
    ns5:term_status "stable" .

ns10:authorList a owl:ObjectProperty ;
    rdfs:label "list of authors"@en ;
    rdfs:comment "An ordered list of authors. Normally, this list is seen as a priority list that order authors by importance."@en ;
    rdfs:domain ns10:Document ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( rdf:List rdf:Seq ) ] ;
    rdfs:subPropertyOf ns10:contributorList ;
    ns5:term_status "stable" .

ns10:doi a owl:DatatypeProperty ;
    rdfs:label "doi"@en ;
    rdfs:comment "This data property can be used to qualify many entities in ROH, e.g. Projects. Notice that there derivatives of this data property to be used for researchers, e.g. ORCID or Scopus ID. There are other type of IDs, like DOI which have been imported from other ontologies such as bibo:doi" .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000392> a owl:Class ;
    rdfs:label "Storage Service"@en ;
    ns2:IAO_0000112 "A computer server." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A service offering that describes a service in which the consumer provides some material or data as input which a service provider stores and returns as output." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:comment "coordinate with NIF. NIF ID:nlx_res_20090419" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000394> a owl:Class ;
    rdfs:label "Material Processing Service"@en ;
    ns2:IAO_0000112 "Biopsy service." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A service offering that describes a service in which the provider makes physical changes to a specified input material entity with the objective of producing a new material entity form input materials, or modifying the input material entity, and returning this as output to the service consumer" ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
    ns2:IAO_0000119 "http://neurolex.org/wiki/Category:Production_service_resource" ;
    rdfs:comment "Coordinate with NIF: NIF ID: nlx_res_20090416" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000787> a owl:Class ;
    rdfs:label "Employee Role"@en ;
    ns2:IAO_0000112 "An employee at a university." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A role inhering in a person that is realized when the bearer participates in an occupation by which a person earns a living or spends their time." ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
    ns2:IAO_0000119 "http://dictionary.reference.com/browse/employment" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0001258> a owl:Class ;
    rdfs:label "Maintenance Service"@en ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000123> ;
    ns2:IAO_0000115 "A service offering that describes a service in which the provider actively maintains a material or data resource (e.g. a model organism colony or database) for the service consumer.  This may involved making physical alterations to the material or data with the goal of maintaining its integrity or features." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> .

<http://w3id.org/roh/mirror/obo/ero#ERO_0001261> a owl:Class ;
    rdfs:label "Analysis Service"@en ;
    ns2:IAO_0000112 "Flow cytometry analysis service." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A service offering that describes a service in which the consumer provides some input material or data and a service provider returns data about the input material or data." ;
    ns2:IAO_0000117 "PERSON: Matt Brush" ;
    ns2:IAO_0000119 "PERSON: Matthew Brush" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/ero#ERO_0000005> .

<http://w3id.org/roh/mirror/vcard#Address> a owl:Class .

<http://w3id.org/roh/mirror/vcard#Email> a owl:Class .

<http://w3id.org/roh/mirror/vcard#Name> a owl:Class .

ns3:GovernmentAgency a owl:Class ;
    rdfs:label "Government Agency"@en ;
    ns2:IAO_0000112 "Definition take from: http://en.wikipedia.org/wiki/Government_agency.",
        "United States Library of Congress" ;
    ns2:IAO_0000115 "A unit of government responsible for oversight and regulation of certain activities or the administration and provision of specific services." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/foaf#Organization> .

ns3:Presentation a owl:Class ;
    rdfs:label "Presentation"@en ;
    ns2:IAO_0000115 "Encompasses talk, speech, lecture, slide lecture, conference presentation" ;
    rdfs:subClassOf ns4:Activity .

ns3:ResearchProposal a owl:Class ;
    rdfs:label "Research Proposal"@en ;
    ns2:IAO_0000115 "A proposal for a research grant that has been submitted but not approved; does not represent an existing activity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:Justification ns4:ProjectContract ns3:Project ns3:ResearchProposal ) ] ;
            owl:onProperty ns3:relates ],
        ns10:Report .

ns3:ResearcherRole a owl:Class ;
    rdfs:label "Researcher Role"@en ;
    ns2:IAO_0000112 "Examples of research can be seen at: http://www.ufl.edu/research/products/index.html.  Note these may have been funded, but the research doesn't have to be funded.  Also, the research may be linked to an Agreement (for example, a Grant), but does not need to be." ;
    ns2:IAO_0000115 "A role of conducting funded or unfunded research,  sometimes linked to an Agreement." ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:placeOfPublication a owl:DatatypeProperty ;
    rdfs:label "place of publication"@en ;
    rdfs:comment "Place where a document was publicated."@en .

ns3:start a owl:ObjectProperty ;
    rdfs:label "start"@en ;
    rdfs:comment "The date/time value in which something starts."@en ;
    rdfs:domain ns3:DateTimeInterval ;
    rdfs:range ns3:DateTimeValue ;
    rdfs:subPropertyOf ns3:dateTimeValue .

ns4:AcademicSubject a owl:Class ;
    rdfs:label "Academic subject"@en ;
    rdfs:comment "Matière académique"@fr ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:Accepted a owl:Class ;
    rdfs:label "Accepted"@en ;
    rdfs:subClassOf ns4:Status .

ns4:CurriculumVitae a owl:Class ;
    rdfs:label "Curriculum Vitae"@en,
        "Currículum vitae"@en,
        "Curriculum vitae"@fr ;
    ns1:altLabel "CV"@en,
        "Resume"@en,
        "Résumé"@en,
        "CV"@fr,
        "Curriculum vitæ"@fr ;
    ns1:prefLabel "Curriculum vitae"@en,
        "Curriculum vitae"@fr ;
    rdfs:comment "roh:CurriculumVitae adds extra fields necessary to be able to complete the CV of a foaf:Person which cannot be extracted from the relationships with roh:ResearchObject and vivo:Project, among others, that a foaf:Person may have.",
        "A document used and created by a person to present their background, skills and accomplishments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:summary ],
        ns10:Document .

ns4:Final a owl:Class ;
    rdfs:label "Final"@en ;
    rdfs:subClassOf ns4:Status .

ns4:HRClassification a owl:Class ;
    rdfs:label "Human Resource Classification"@en ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:Invention a owl:Class ;
    rdfs:label "Invention"@en ;
    rdfs:comment "A new device, method, or process developed from study and experimentation in the framework of research."@en,
        "Invention"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:title ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/geonames#Feature> ;
            owl:onProperty <http://w3id.org/roh/mirror/geonames#locatedIn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:FundingProgram ;
            owl:onProperty ns4:fundedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:PropertyClassification ] ) ] ;
            owl:onProperty ns4:hasPropertyClassification ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
            owl:onProperty ns4:hasKnowledgeArea ],
        [ a owl:Restriction ;
            owl:onProperty ns3:identifier ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:Accepted ns4:Rejected ns4:Submitted ) ] ;
            owl:onProperty ns4:patentStatus ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:ResearchObject ;
            owl:onProperty ns4:produces ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:PatentApplication ;
            owl:onProperty ns9:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:Funding ;
            owl:onProperty ns4:isSupportedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:PatentExpense ;
            owl:onProperty ns4:spends ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:Dossier ;
            owl:onProperty ns3:relatedBy ],
        [ a owl:Restriction ;
            owl:onProperty ns3:freetextKeyword ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> ;
            owl:onProperty ns3:relates ] .

ns4:Justification a owl:Class ;
    rdfs:label "Justification"@en ;
    rdfs:comment "A Justification is a bibo:Report used to justify eithet technically, economically or both a project." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns3:Project ],
        ns10:Report .

ns4:PhDThesis a owl:Class ;
    rdfs:label "Doctoral thesis"@en,
        "PhD Thesis"@en,
        "Thèse doctorale"@fr ;
    ns1:prefLabel "Doctoral thesis"@en,
        "Thèse doctorale"@fr ;
    rdfs:comment "A document created to summarize research findings associated with the completion of a doctoral thesis."@en,
        "A thesis reporting a research project undertaken as part of an undergraduate course of education to receive a doctoral degree."@en ;
    rdfs:subClassOf ns10:Thesis .

ns4:Product a owl:Class ;
    rdfs:label "Product"@en ;
    rdfs:comment "A product as outcome of a project."@en .

ns4:Provisional a owl:Class ;
    rdfs:label "Provisional"@en ;
    rdfs:subClassOf ns4:Status .

ns4:PublicationMetric a owl:Class ;
    rdfs:label "Publication Metric"@en ;
    rdfs:comment "An article is cited roh:citationCount times in the roh:metricName network. Example: if an article is cited 5 times in the Web of Science, then the roh:metricName should be Web of Science and the roh:citationCount 5. Thus, a roh:metricName can be roh and the value of roh:citationCount the number of times that article has been cited in the knowledge graph of this ontology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:metricName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ns4:citationCount ],
        ns4:Metric .

ns4:README a owl:Class ;
    rdfs:label "README"@en ;
    rdfs:comment "The document named README that describe the content of a concret Repository."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:Repository <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ) ] ;
            owl:onProperty ns4:readmeOf ],
        [ a owl:Restriction ;
            owl:onProperty ns4:readmeOf ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:Repository <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ) ] ],
        ns10:Document .

ns4:ResearchContribution a owl:Class ;
    rdfs:label "Research contribution"@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000015> .

ns4:SuperviseeRole a owl:Class ;
    rdfs:label "Supervisee Role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ;
            owl:onProperty ns4:roleOf ],
        [ a owl:Restriction ;
            owl:onProperty ns4:roleOf ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ],
        <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns4:SupervisingRelationship a owl:Class ;
    rdfs:label "Supervising Relationship"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns4:SuperviseeRole ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns4:SupervisorRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:SuperviseeRole ns4:SupervisorRole <http://w3id.org/roh/mirror/foaf#Person> ) ] ;
            owl:onProperty ns3:relates ],
        [ a owl:Restriction ;
            owl:onProperty ns3:dateTimeInterval ;
            owl:someValuesFrom ns3:DateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns10:Thesis ;
            owl:onProperty ns4:produces ],
        ns3:Relationship .

ns4:hasContactInfo a owl:ObjectProperty ;
    rdfs:label "has contact info"@en ;
    rdfs:comment "An Agent has a contact info of type vcard:Kind."@en ;
    rdfs:range <http://w3id.org/roh/mirror/vcard#Kind> .

ns4:hasContract a owl:ObjectProperty ;
    rdfs:label "has contract"@en ;
    rdfs:comment "An object property linking an Entity to a Contract."@en ;
    rdfs:range ns3:Contract .

ns4:hasMetric a owl:ObjectProperty ;
    rdfs:label "has metric"@en ;
    rdfs:comment "A Metric which quantifies a Research Object."@en ;
    rdfs:range ns4:Metric ;
    owl:inverseOf ns4:metricOf .

ns4:language a owl:DatatypeProperty ;
    rdfs:label "language"@en ;
    rdfs:range xsd:string .

ns4:participates a owl:ObjectProperty ;
    rdfs:label "participates"@en ;
    rdfs:comment "An Entity participating in an Activity."@en ;
    rdfs:range ns4:Activity .

ns4:spends a owl:ObjectProperty ;
    rdfs:label "spends"@en ;
    rdfs:comment "An entity spending an Expense."@en ;
    rdfs:range ns4:Expense ;
    owl:inverseOf ns4:spentBy .

ns10:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    ns2:IAO_0000112 "Collection of information resources that have a unified identity. Archives, museums and libraries often acquire collections on specific subjects and from distinguished authors or researchers. Also includes collections of resources bundled into a license.",
        "Hill Ornithology Collection; Wiley Interscience Online Books Biochemisty Collection" ;
    ns2:IAO_0000115 "Collection of information resources that have a unified identity" ;
    rdfs:comment "ResearchObjects related to publication concept are based on types defined by BIBO ontology. Currently, the following set of publication-related entities are supported: bibo: bibo:Collection (Periodical, Journal, Magazine)\\n\\nThis is a type of roh:ResearchObjects related to publication concept. It is based on types defined by BIBO ontology. Currently, the following set of publication-related entities are supported: bibo: bibo:Collection (Periodical, Journal, Magazine) and bibo:Document (Article, ConferencePaper, EditorialArticle, Book, Proceedings, ConferencePaper, Chapter, Thesis) and obo:Software. bibo:Thesis has been refined into roh:BachelorsThesis, roh:MastersThesis and roh:PhDThesis. Notably a new subclass of bibo:Collection named roh:Dossier has been created. Under such collection can be included the reports usually associated to a project, e.g.  roh:EthicalReport, roh:EvaluationSummary, roh:Justification, vivo:ResearchProposal. A roh:Dossier is bound through object property vivo:relates with a vivo:Project",
        "A collection of Documents or Collections"@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:oclcnum ],
        <http://w3id.org/roh/mirror/obo/iao#IAO_0000030> ;
    ns5:term_status "stable" .

ns10:locator a owl:DatatypeProperty ;
    rdfs:label "locator"@en ;
    rdfs:comment "A description (often numeric) that locates an item within a containing document or collection."@en .

<http://w3id.org/roh/mirror/obo/bfo#BFO_0000008> a owl:Class ;
    rdfs:label "Temporal Region"@en ;
    rdfs:comment "A temporal region is an occurrent entity that is part of time as defined relative to some reference frame."@en ;
    owl:disjointWith <http://w3id.org/roh/mirror/obo/bfo#BFO_0000015> .

ns9:BFO_0000050 a owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    rdfs:comment "A core relation that holds between a part and its hole ."@en ;
    owl:inverseOf ns9:BFO_0000051 .

ns3:Certificate a owl:Class ;
    rdfs:label "Certificate"@en ;
    ns2:IAO_0000112 "A document confirming certain characteristics of a person or organization, usually provided by some form of external review, education, or assessment." ;
    ns2:IAO_0000115 "A document confirming certain characteristics of a person or organization, usually provided by some form of external review, education, or assessment." ;
    rdfs:subClassOf ns4:Accreditation .

ns3:hasPublicationVenue a owl:ObjectProperty ;
    rdfs:label "published in"@en ;
    rdfs:comment "A publication published in a collection of documents."@en ;
    owl:inverseOf ns3:publicationVenueFor .

ns4:EthicalReport a owl:Class ;
    rdfs:label "EthicalReport"@en ;
    rdfs:subClassOf ns10:Report .

ns4:FundingAmount a owl:Class ;
    rdfs:label "Funding Amount"@en ;
    rdfs:comment "A roh:FundingAmount is linked to a roh:Funding which is roh:fundedBy a roh:FundingProgram and finances a Project (through roh:supports relationship). Each FundingAmount is associated to an Organization participating in the Project (through roh:grants relationship) for each project specific annuity."^^rdfs:Literal ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:Funding ;
            owl:onProperty ns9:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty ns4:monetaryAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns4:grants ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:currency ] .

ns4:ProjectClassification a owl:Class ;
    rdfs:label "Project Classification"@en ;
    rdfs:subClassOf ns1:ConceptScheme .

ns4:ProjectContract a owl:Class ;
    rdfs:label "Project Contract"@en ;
    rdfs:comment "An agreement among different organizations to work in a project for a specified duration."@en ;
    rdfs:subClassOf ns3:Contract .

ns4:SupervisorRole a owl:Class ;
    rdfs:label "Supervisor Role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:roleOf ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ;
            owl:onProperty ns4:roleOf ],
        <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns4:partOfResearchResult a owl:ObjectProperty ;
    rdfs:label "part of research result"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns4:ExperimentalProtocol ns10:Document <http://w3id.org/roh/mirror/obo/ero#ERO_0000071> ) ] ;
    rdfs:range ns4:ResearchResult ;
    rdfs:subPropertyOf ns9:BFO_0000050 ;
    owl:inverseOf ns4:researchResultHasPart .

ns10:Book a owl:Class ;
    rdfs:label "Book"@en,
        "Livre"@fr ;
    ns2:IAO_0000112 "Short Definition copied from bibo ontology" ;
    ns2:IAO_0000115 "A written or printed work of fiction or nonfiction, usually on sheets of paper fastened or bound together within covers" ;
    ns1:prefLabel "Book"@en,
        "Livre"@fr ;
    rdfs:comment "A written or printed work of fiction or nonfiction, usually on sheets of paper fastened or bound together within covers."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:isbn ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns3:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:placeOfPublication ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:lccn ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:edition ],
        ns10:Document ;
    ns5:term_status "stable" .

ns10:CollectedDocument a owl:Class ;
    rdfs:label "Collected Document"@en,
        "Collected document"@en ;
    rdfs:comment "A document consisting of collections of previously published works."@en,
        "A document that simultaneously contains other documents."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns9:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns10:Document ;
            owl:onProperty ns9:BFO_0000051 ],
        ns10:Document ;
    ns5:term_status "stable" .

ns10:pageEnd a owl:DatatypeProperty ;
    rdfs:label "end page"@en,
        "page end"@en ;
    rdfs:comment "Ending page number within a continuous page range."@en ;
    rdfs:domain ns10:Document ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns10:locator ;
    ns5:term_status "stable" .

ns10:pageStart a owl:DatatypeProperty ;
    rdfs:label "page start"@en,
        "start page"@en ;
    rdfs:comment "Starting page number within a continuous page range."@en ;
    rdfs:domain ns10:Document ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns10:locator ;
    ns5:term_status "stable" .

<http://w3id.org/roh/mirror/oa#Annotation> a owl:Class ;
    rdfs:label "Annotation" ;
    rdfs:comment "The class for Web Annotations." ;
    rdfs:isDefinedBy <http://www.w3.org/ns/oa#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/oa#Motivation> ;
            owl:onProperty <http://w3id.org/roh/mirror/oa#motivatedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateTimeValue ],
        [ a owl:Restriction ;
            owl:onProperty ns4:correspondingAuthor ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ;
            owl:onProperty ns4:correspondingAuthor ] .

ns3:FundingOrganization a owl:Class ;
    rdfs:label "Funding Organization"@en ;
    ns2:IAO_0000112 "National Institute of Health (NIH)" ;
    ns2:IAO_0000115 "A defined class of organizations that fund Grants",
        "An organization that provides financial support to individuals or organizations to carry out specified activities." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    rdfs:comment "A vivo:FundingOrganization inherits from foaf:Organization, it promotes (roh:promotes) a  roh:FundingSource who roh:funds a roh:FundingProgram. A roh:FundingProgram roh:funds with a roh:Funding linked to vivo:Projects through relationship roh:supports and through the roh:FundingAmounts in which is divided a roh:Funding, through roh:grants to different foaf:Organizations." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://w3id.org/roh/mirror/foaf#Organization> [ a owl:Restriction ;
                        owl:onProperty ns4:promotes ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns4:FundingProgram ns4:FundingSource ) ] ] [ a owl:Restriction ;
                        owl:allValuesFrom ns4:Funding ;
                        owl:onProperty ns4:funds ] [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns4:FundingProgram ns4:FundingSource ) ] ;
                        owl:onProperty ns4:promotes ] ) ] .

ns3:License a owl:Class ;
    rdfs:label "License"@en ;
    ns2:IAO_0000112 "Licenses are usually issued in order to regulate some activity that is deemed to be dangerous or a threat to the person or the public or which involves a high level of specialized skill.  See also core:Licensure." ;
    ns2:IAO_0000115 "Official or legal permission to do something" ;
    rdfs:subClassOf ns4:Accreditation .

ns3:publisher a owl:ObjectProperty ;
    rdfs:label "published by"@en,
        "publisher"@en ;
    rdfs:comment "The Agent who publishes a publication."@en ;
    rdfs:domain ns10:Document ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Agent> ;
    owl:inverseOf ns3:publisherOf .

ns3:relatedBy a owl:ObjectProperty ;
    rdfs:label "related by"@en ;
    ns2:IAO_0000115 "Relates a Thing to a Relationship as a Thing that is somehow related to other Thing in the same Relationship instance. A Relationship instnace is a predicate over Thing and is created by an Agent."@en ;
    owl:inverseOf ns3:relates .

ns4:Closed a owl:Class ;
    rdfs:label "Closed"@en ;
    rdfs:subClassOf ns4:Status .

ns4:ExperimentalProtocol a owl:Class ;
    rdfs:label "Experimental Protocol"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ;
            owl:onProperty ns4:correspondingAuthor ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns4:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
            owl:onProperty ns4:hasKnowledgeArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns10:Webpage ;
            owl:onProperty <http://w3id.org/roh/mirror/foaf#homepage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:ExperimentalProtocol ;
            owl:onProperty ns4:hasPredecessor ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:Seq ;
            owl:onProperty ns4:seqOfAuthors ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:Repository ;
            owl:onProperty ns4:repositoryHasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty <http://purl.org/spar/cito/cites> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:ResearchResult ;
            owl:onProperty ns4:partOfResearchResult ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:ExperimentalProtocolResult ;
            owl:onProperty ns4:produces ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns4:seqOfAuthors ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns10:abstract ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:freetextKeyword ],
        [ a owl:Restriction ;
            owl:onProperty ns4:title ;
            owl:someValuesFrom xsd:string ],
        <http://w3id.org/roh/mirror/obo/bfo#BFO_0000015> .

ns4:JournalMetric a owl:Class ;
    rdfs:label "Journal Metric"@en ;
    rdfs:comment "This is the metric of a jorunal. When the journal metric is updated, a new journal metric must be created with the same impactFactorName but with the updated impactFactor, ranking and quartile values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:impactFactorName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:quartile ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ns4:impactFactor ],
        [ a owl:Restriction ;
            owl:onProperty ns3:dateIssued ;
            owl:someValuesFrom ns3:DateTimeValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:ranking ],
        [ a owl:Restriction ;
            owl:onProperty ns4:impactFactorName ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns4:impactFactor ;
            owl:someValuesFrom xsd:float ],
        ns4:Metric .

ns4:Open a owl:Class ;
    rdfs:label "Open"@en ;
    rdfs:subClassOf ns4:Status .

ns4:languageSkill a owl:DatatypeProperty ;
    rdfs:label "language skill"@en ;
    rdfs:comment "Different skills required by the Common European Framework of Reference for Languages: Learning, Teaching, Assessment."@en ;
    rdfs:domain ns4:LanguageCertificate ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "A1" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "A2" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "B1" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "B2" ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "C1" ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "C2" ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    rdfs:subPropertyOf owl:topDataProperty .

ns10:Webpage a owl:Class ;
    rdfs:label "Webpage"@en ;
    ns2:IAO_0000115 "One section of a website that appears at a unique address within the parent site's address or URL on the World Wide Web" ;
    rdfs:comment "A web page is an online document available (at least initially) on the world wide web. A web page is written first and foremost to appear on the web, as distinct from other online resources such as books, manuscripts or audio documents which use the web primarily as a distribution mechanism alongside other more traditional methods such as print."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf ns10:Document ;
    ns5:term_status "unstable" .

ns10:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract"@en ;
    rdfs:comment "A summary of the resource."@en .

<http://w3id.org/roh/mirror/foaf#homepage> a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "homepage" ;
    rdfs:comment "A homepage for some thing." ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/foaf#> ;
    rdfs:range ns10:Document ;
    rdfs:subPropertyOf <http://w3id.org/roh/mirror/foaf#isPrimaryTopicOf>,
        <http://w3id.org/roh/mirror/foaf#page> ;
    ns5:term_status "stable" .

<http://w3id.org/roh/mirror/geonames#locatedIn> a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:comment "Indicates that the subject resource is located in the object feature"@en ;
    rdfs:range <http://w3id.org/roh/mirror/geonames#Feature> .

ns3:AdvisingRelationship a owl:Class ;
    rdfs:label "Advising Relationship"@en ;
    ns2:IAO_0000115 "A dual relationship of one person being advised or mentored by another person, typically including start and end dates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
            owl:onProperty ns4:hasKnowledgeArea ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns3:AdvisorRole ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom ns3:AdviseeRole ],
        ns3:Relationship .

ns4:PatentApplication a owl:Class ;
    rdfs:label "Patent Application"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns4:ownerOrganization ],
        ns4:Invention .

ns4:Rejected a owl:Class ;
    rdfs:label "Rejected"@en ;
    rdfs:subClassOf ns4:Status .

ns4:hasPredecessor a owl:ObjectProperty ;
    rdfs:label "has predecessor"@en,
        "tiene predecesor"@en ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ns4:hasSucessor .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000783> a owl:Class ;
    rdfs:label "Student Role"@en ;
    ns2:IAO_0000112 "A college student." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A role inhering in a person that is realized when the bearer participates a course of study, as in a school, college, university, etc." ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
    ns2:IAO_0000119 "http://www.thefreedictionary.com/student" ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> .

ns3:AwardedDegree a owl:Class ;
    rdfs:label "Awarded Degree"@en,
        "Grade universitaire"@fr,
        "Grade universitaire"@fr-be,
        "Grade universitaire"@fr-ca,
        "Grade universitaire"@fr-ch,
        "Grade universitaire"@fr-fr ;
    ns2:IAO_0000115 "The awarding of a degree by an agent to another agent. It is mostly for academic degrees." ;
    ns1:prefLabel "Academic degree"@en,
        "Grade universitaire"@fr,
        "Grade universitaire"@fr-be,
        "Grade universitaire"@fr-ca,
        "Grade universitaire"@fr-ch,
        "Grade universitaire"@fr-fr ;
    rdfs:comment "A vivo:AwardedDegree is related to a foaf:Person and vivo:AcademicDegree through vivo:relates relationship, it is a qualification (degree) received by somebody.",
        "A qualification awarded to students upon successful completion of a course of study in higher education."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns3:University ;
            owl:onProperty ns4:awardedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateTimeValue ],
        [ a owl:Restriction ;
            owl:onProperty ns4:awardedBy ;
            owl:someValuesFrom ns3:University ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns3:DateTimeValue ;
            owl:onProperty ns3:dateTimeValue ],
        [ a owl:Restriction ;
            owl:onClass <http://w3id.org/roh/mirror/foaf#Person> ;
            owl:onProperty ns3:relates ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns3:dateTimeValue ;
            owl:someValuesFrom ns3:DateTimeValue ],
        [ a owl:Restriction ;
            owl:onClass ns3:AcademicDegree ;
            owl:onProperty ns3:relates ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:University ;
            owl:onProperty ns4:awardedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <http://w3id.org/roh/mirror/foaf#Person> ns3:AcademicDegree ) ] ;
            owl:onProperty ns3:relates ],
        ns3:Relationship .

ns3:University a owl:Class ;
    rdfs:label "University"@en,
        "Université"@fr ;
    ns2:IAO_0000112 "Definition taken from: http://en.wikipedia.org/wiki/University",
        "University of Florida; Washington University in St. Louis" ;
    ns2:IAO_0000115 "An institution of higher education and research, which grants academic degrees in a variety of subjects, and provides both undergraduate education and postgraduate education." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    ns1:prefLabel "University"@en,
        "Université"@fr ;
    rdfs:comment "A centre at which higher education and research is conducted."@en ;
    rdfs:subClassOf <http://w3id.org/roh/mirror/foaf#Organization> .

ns4:Reservable a owl:Class ;
    rdfs:label "Reservable"@en ;
    rdfs:comment "Some resources may available by an organization to be used by others."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns3:dateTimeInterval ;
            owl:someValuesFrom ns3:DateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns4:title ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:freetextKeyword ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Agent> ;
            owl:onProperty ns4:reservableOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ] .

ns4:correspondingAuthor a owl:ObjectProperty ;
    rdfs:label "corresponding author"@en ;
    rdfs:comment "An object property linking an Entity to a Person, considered the author of such Thing."@en ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Person> ;
    owl:inverseOf ns4:correspondingAuthorOf .

ns10:Article a owl:Class ;
    rdfs:label "Article"@en ;
    ns2:IAO_0000112 "A specific journal article",
        "Short Definition modified from the bibo ontology." ;
    ns2:IAO_0000115 "A written composition in prose, usually nonfiction, on a specific topic, forming an independent part of a periodical or book" ;
    ns1:prefLabel "Article"@en ;
    rdfs:comment "A written composition in prose, usually nonfiction, on a specific topic, forming an independent part of a book or other publication, as a newspaper or magazine."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:pageStart ],
        [ a owl:Restriction ;
            owl:onProperty ns4:correspondingOrganization ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:pageEnd ],
        [ a owl:Restriction ;
            owl:onProperty ns3:dateIssued ;
            owl:someValuesFrom ns3:DateTimeValue ],
        [ a owl:Restriction ;
            owl:onProperty ns4:seqOfAuthors ;
            owl:someValuesFrom rdf:Seq ],
        [ a owl:Restriction ;
            owl:onProperty ns10:doi ;
            owl:someValuesFrom xsd:string ],
        ns10:Document ;
    ns5:term_status "stable" .

ns10:Thesis a owl:Class ;
    rdfs:label "Thesis"@en,
        "Thèse"@fr ;
    ns2:IAO_0000112 "Short Definition from OCLC Input Standards, EntW" ;
    ns2:IAO_0000115 "Works created to satisfy the requirements for an academic certification or degree; also called dissertation" ;
    ns1:prefLabel "Thesis"@en,
        "Thèse"@fr ;
    rdfs:comment "A document created to summarize research findings associated with the completion of an academic degree."@en,
        "Any kind of thesis (bachelor's, master's, PhD) produced to receive some sort of university degree."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:placeOfPublication ],
        ns10:Document ;
    ns5:term_status "stable" .

ns3:AcademicDegree a owl:Class ;
    rdfs:label "Academic Degree"@en ;
    ns2:IAO_0000112 "B.A. Bachelor of Arts",
        "This list may have multiple abbreviations for some degrees." ;
    ns2:IAO_0000115 "An academic degree at any level, both as reported by individuals for employment and as offered by academic degree programs." ;
    rdfs:comment "A vivo:AcademicDegree describes the degrees offered by a vivo:University and obtained by different people (foaf:Person). The property vivo:relates correlates vivo:AcademicDegree con vivo:AwardedDegree and vivo:University with vivo:AcademicDegree." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:title ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:abbreviation ] .

ns3:abbreviation a owl:DatatypeProperty ;
    rdfs:label "abbreviation"@en ;
    rdfs:comment "A short form for an longer title or name."@en .

ns4:Expense a owl:Class ;
    rdfs:label "Expense"@en ;
    rdfs:comment "A roh:Expense is carried out in a vivo:Project or by foaf:Person and associated through relationship roh:spends. It timestamps each expense with a vivo:DateTimeValue and has attributes roh:monetaryAmount, roh:currency, roh:title and roh:description and expenseAmount . The types of expenses considered are: Personnel Expenses, Subcontracting, Travel, Equipment, Research Infrastructure and Other Goods and Services. Some of these classes still not defined." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:ExpenseClassification ] ) ] ;
            owl:onProperty ns4:hasExpenseClassification ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateIssued ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:currency ],
        [ a owl:Restriction ;
            owl:onProperty ns3:dateIssued ;
            owl:someValuesFrom ns3:DateTimeValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty ns4:monetaryAmount ],
        [ a owl:Restriction ;
            owl:onProperty ns4:monetaryAmount ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:expenseModality ] .

ns4:LanguageCertificate a owl:Class ;
    rdfs:label "Language Certificate"@en ;
    rdfs:comment "A language certificate from the Common European Framework of Reference for Languages: Learning, Teaching, Assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:speakingSkill ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:writingSkill ],
        [ a owl:Restriction ;
            owl:onProperty ns4:languageOfTheCertificate ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns4:writingSkill ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:languageOfTheCertificate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:listeningSkill ],
        [ a owl:Restriction ;
            owl:onProperty ns4:readingSkill ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty ns4:speakingSkill ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:spokenInteractionSkill ],
        [ a owl:Restriction ;
            owl:onProperty ns4:listeningSkill ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:readingSkill ],
        [ a owl:Restriction ;
            owl:onProperty ns4:spokenInteractionSkill ;
            owl:someValuesFrom xsd:string ],
        ns3:Certificate .

ns10:Report a owl:Class ;
    rdfs:label "Report"@en ;
    ns2:IAO_0000112 "Medical Subject Heading (MeSH) definition of Technical Report: Work consisting of a formal report giving details of the investigation and results of a medical or other scientific problem. When issued by a government agency or comparable official body, its contents may be classified, unclassified, or declassified with regard to security clearance. This publication type may also cover a scientific paper or article that records the current state or current position of scientific research and development. If so labeled by the editor or publisher, this publication type may be properly used for journal articles." ;
    ns2:IAO_0000115 "A document describing an account or statement describing in detail an event, situation, or the like, usually as the result of observation, inquiry, etc." ;
    rdfs:comment "A document describing an account or statement describing in detail an event, situation, or the like, usually as the result of observation, inquiry, etc."@en,
        "A document describing an account or statement describing in detail an event, situation, or the like, usually as the result of observation, inquiry, etc.."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns10:distributor ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns3:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateTimeValue ],
        ns10:Document ;
    ns5:term_status "stable" .

<http://w3id.org/roh/mirror/geonames#Feature> a owl:Class ;
    rdfs:label "Feature"@en ;
    ns1:historyNote "Modified in version 3.1 : The cardinality constraints on feature code, feature class are relaxed on this class, and put on the specific subclass Geonames Feature. This class and attached properties can therefore be used for features not necessarily identified in the Geoanmes data base"@en ;
    rdfs:comment "A geographical feature"@en .

<http://w3id.org/roh/mirror/obo/iao#IAO_0000030> a owl:Class ;
    rdfs:label "Information Content Entity"@en ;
    ns2:IAO_0000115 "A generically dependent continuant that is about some thing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns4:correspondingOrganization ] .

<http://w3id.org/roh/mirror/vcard#Kind> a owl:Class ;
    rdfs:label "Kind"@en ;
    rdfs:comment "The parent class for all objects"@en ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/vcard> .

ns4:Metric a owl:Class ;
    rdfs:label "Metric"@en ;
    rdfs:comment "An roh:Metric indicates qualifies a roh:ResearchObject according to common established quality measurement metrics, e.g. impact factor or mark in an PhD viva." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateIssued ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:metricName ] .

ns4:ResearchResult a owl:Class ;
    rdfs:label "Research Result"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:ResearchResult ;
            owl:onProperty ns4:researchResultHasPart ],
        [ a owl:Restriction ;
            owl:onProperty ns4:seqOfAuthors ;
            owl:someValuesFrom rdf:Seq ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:Seq ;
            owl:onProperty ns4:seqOfAuthors ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:License ;
            owl:onProperty ns4:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns10:abstract ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
            owl:onProperty ns4:hasKnowledgeArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:ResearchObjectExpense ;
            owl:onProperty ns4:spends ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns10:Webpage ;
            owl:onProperty <http://w3id.org/roh/mirror/foaf#homepage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty <http://purl.org/spar/cito/cites> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:freetextKeyword ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:Seq ;
            owl:onProperty ns10:authorList ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:ResearchResult ;
            owl:onProperty ns4:hasSucessor ],
        [ a owl:Restriction ;
            owl:onProperty ns4:correspondingAuthor ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ] .

ns4:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    rdfs:comment "Some Thing producing some entity."@en ;
    rdfs:domain owl:Thing .

ns3:Company a owl:Class ;
    rdfs:label "Company"@en,
        "Entreprise"@fr ;
    ns2:IAO_0000112 "from Wikipedia: \"A company is a form of business organization. It is an association or collection of individual real persons and/or other companies ... This collection, group or association of persons can be made to exist in law and then a company is itself considered a \"legal person\". The name company arose because, at least originally, it represented or was owned by more than one real or legal person.\"" ;
    ns2:IAO_0000115 "A legally-recognized business organization",
        "A legally-recognized business organization." ;
    ns2:IAO_0000412 <http://w3id.org/roh/mirror/vivo> ;
    ns1:prefLabel "Company"@en,
        "Entreprise"@fr ;
    rdfs:comment "A corporation or business organization which makes goods (in a broad sense) in an organized manner and sells them to the public for profit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns4:publicCompany ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ns4:publicCompany ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ns4:isStartup ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:CompanyClassification ] ) ] ;
            owl:onProperty ns4:hasCompanyClassification ],
        <http://w3id.org/roh/mirror/foaf#Organization> ;
    owl:disjointWith ns3:University .

ns3:Contract a owl:Class ;
    rdfs:label "Contract"@en ;
    ns2:IAO_0000115 "An agreement involving specific deliverables and payment" ;
    rdfs:comment "A roh:Contract is a legal document which gathers the conditions and obligations of a Person (foaf:Person) or the conditions and obligations of a Project (vivo:Project) and the different organizations which take part in it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/obo/iao#IAO_0000030> ;
            owl:onProperty ns3:supportedInformationResource ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
            owl:onProperty ns4:hasKnowledgeArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ns4:attachment ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:Funding ns4:PatentApplication <http://w3id.org/roh/mirror/foaf#Agent> <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns10:abstract ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:Funding ns4:PatentApplication <http://w3id.org/roh/mirror/foaf#Agent> <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> ) ] ;
            owl:onProperty ns3:relates ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns3:assignedBy ],
        ns3:Relationship .

ns3:Relationship a owl:Class ;
    rdfs:label "Relationship"@en ;
    ns2:IAO_0000112 "functions as an n-ary predicate" ;
    ns2:IAO_0000115 "a reified relationship" .

ns4:FundingSource a owl:Class ;
    rdfs:label "Funding Source"@en ;
    rdfs:comment "We have just considered a subset of the available funding sources, taking into account the sample datasets provided by University of Murcia\\n\\nA roh:FundingSource roh:feeds a roh:Funding with funds to sponsor some projects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:FundingProgram ;
            owl:onProperty ns4:funds ] .

ns4:roleOf a owl:ObjectProperty ;
    rdfs:label "role of"@en ;
    rdfs:comment "The Role held by an Agent in a Relationship."@en ;
    rdfs:domain <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> ;
    rdfs:range <http://w3id.org/roh/mirror/foaf#Agent> .

ns4:seqOfAuthors a owl:ObjectProperty ;
    rdfs:label "seq of authors"@en ;
    rdfs:comment "An unordered list of authors."@en ;
    rdfs:range rdf:Seq .

ns10:Patent a owl:Class ;
    rdfs:label "Patent"@en,
        "Patent"@fr ;
    ns2:IAO_0000112 "A patent is an exclusive right granted for an invention, which is a product or a process that provides, in general, a new way of doing something, or offers a new technical solution to a problem.  In order to be patentable, the invention must fulfill certain conditions. (http://www.wipo.int/patentscope/en/)" ;
    ns2:IAO_0000115 "(from BIBO) A document describing the exclusive right granted by a government to an inventor to manufacture, use, or sell an invention for a certain number of years" ;
    ns1:prefLabel "Patent"@en,
        "Patent"@fr ;
    rdfs:comment "A document describing the exclusive right granted by a government to an inventor to manufacture, use, or sell an invention for a certain number of years."@en,
        "A form of intellectual property that gives its owner the legal right to exclude others from making, using, selling and importing an invention for a limited period of years, in exchange for publishing an enabling public disclosure of the invention."@en ;
    rdfs:isDefinedBy "http://w3id.org/roh/mirror/bibo#"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateIssued ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:modality ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns3:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/geonames#Feature> ;
            owl:onProperty <http://w3id.org/roh/mirror/geonames#locatedIn> ],
        [ a owl:Restriction ;
            owl:onProperty ns3:identifier ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns4:ownerOrganization ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns4:expirationDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
            owl:onProperty ns4:hasKnowledgeArea ],
        ns10:Document ;
    ns5:term_status "stable" .

ns3:dateIssued a owl:ObjectProperty ;
    rdfs:label "date issued"@en ;
    rdfs:comment "The date of issue of an entity."@en ;
    rdfs:range ns3:DateTimeValue ;
    rdfs:subPropertyOf ns3:dateTimeValue .

ns1:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en .

ns3:Position a owl:Class ;
    rdfs:label "Position"@en ;
    ns2:IAO_0000112 "An employment activity, whether compensated or not. Short definition comes from http://en.wikipedia.org/wiki/Position, and has been modified.",
        "Director of Admissions and Placement; Associate University Librarian" ;
    ns2:IAO_0000115 "Particular position in an organization, commonly identified by job title, and normally associated with a job description that details the tasks and responsibilities that go with the position." ;
    rdfs:comment "vivo:Position is reused from VIVO ontology and is refined with the position subclasses previously identified by vivo:Position, e.g. vivo:LibrarianPosition. This entity is subject to refinement according to the country where it is applied. For instance, in ROHES extension to ROH ontology we encounter rohes:ProfesorTitularDeUniversidad, i.e. equivalent position to Associate Professor in Spain." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:int ;
            owl:onProperty ns3:rank ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty ns3:relates ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ],
        ns3:Relationship .

<http://w3id.org/roh/mirror/oa#Motivation> a owl:Class ;
    rdfs:label "Motivation" ;
    rdfs:comment "The Motivation class is used to record the user's intent or motivation for the creation of the Annotation, or the inclusion of the body or target, that it is associated with." ;
    rdfs:isDefinedBy <http://www.w3.org/ns/oa#> ;
    rdfs:subClassOf ns1:Concept .

<http://w3id.org/roh/mirror/obo/ero#ERO_0000005> a owl:Class ;
    rdfs:label "Service"@en ;
    ns2:IAO_0000111 "service" ;
    ns2:IAO_0000112 "A DNA sequencing service performed by a core lab." ;
    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "An information content entity that describes a service performed by a person or organization with the objective of performing a technique, providing training, providing storage of data or material entities, or providing access to resources for another person or organization" ;
    ns2:IAO_0000117 "PERSON: Melissa Haendel" ;
    ns2:IAO_0000119 "PERSON: Melissa Haendel" ;
    rdfs:comment "Coordinate with NIF. NIF ID: nlx_res_20090105" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns10:Report ;
            owl:onProperty ns4:produces ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns4:isProvidedBy ] .

ns9:BFO_0000051 a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "A core relation that holds between a whole and its part ."@en .

ns3:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "This data property may be associated to any roh entity which needs to include a description" .

ns4:FundingProgram a owl:Class ;
    rdfs:label "Funding Program"@en,
        "Funding programme"@en ;
    rdfs:comment "A roh:FundingProgram is promoted (roh:promotedBy) by a Funding Organization (vivo:FundingOrganization) and it is in place for a time interval (vivo:dateTimeInterval)",
        "A programme of related funded projects, typically established by a funding organization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:FundingProgram ;
            owl:onProperty ns9:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/geonames#Feature> ;
            owl:onProperty <http://w3id.org/roh/mirror/geonames#locatedIn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:FundingProgramClassification ] ) ] ;
            owl:onProperty ns4:hasFundingProgramClassification ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:FundingOrganization ;
            owl:onProperty ns4:promotedBy ],
        [ a owl:Restriction ;
            owl:onProperty ns4:promotedBy ;
            owl:someValuesFrom ns3:FundingOrganization ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns4:Dossier ;
            owl:onProperty ns3:relatedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty ns3:identifier ] .

<http://w3id.org/roh/mirror/obo/bfo#BFO_0000015> a owl:Class ;
    rdfs:label "process"@en ;
    ns2:BFO_0000179 "process" ;
    ns2:BFO_0000180 "Process" ;
    ns2:IAO_0000112 "a process of cell-division, \\\\ a beating of the heart"@en,
        "a process of meiosis"@en,
        "a process of sleeping"@en,
        "the course of a disease"@en,
        "the flight of a bird"@en,
        "the life of an organism"@en,
        "your process of aging."@en ;
    ns2:IAO_0000115 "p is a process = Def. p is an occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t. (axiom label in BFO2 Reference: [083-003])"@en ;
    ns2:IAO_0000116 "BFO 2 Reference: The realm of occurrents is less pervasively marked by the presence of natural units than is the case in the realm of independent continuants. Thus there is here no counterpart of ‘object’. In BFO 1.0 ‘process’ served as such a counterpart. In BFO 2.0 ‘process’ is, rather, the occurrent counterpart of ‘material entity’. Those natural – as contrasted with engineered, which here means: deliberately executed – units which do exist in the realm of occurrents are typically either parasitic on the existence of natural units on the continuant side, or they are fiat in nature. Thus we can count lives; we can count football games; we can count chemical reactions performed in experiments or in chemical manufacturing. We cannot count the processes taking place, for instance, in an episode of insect mating behavior.Even where natural units are identifiable, for example cycles in a cyclical process such as the beating of a heart or an organism’s sleep/wake cycle, the processes in question form a sequence with no discontinuities (temporal gaps) of the sort that we find for instance where billiard balls or zebrafish or planets are separated by clear spatial gaps. Lives of organisms are process units, but they too unfold in a continuous series from other, prior processes such as fertilization, and they unfold in turn in continuous series of post-life processes such as post-mortem decay. Clear examples of boundaries of processes are almost always of the fiat sort (midnight, a time of death as declared in an operating theater or on a death certificate, the initiation of a state of war)"@en ;
    ns2:IAO_0000602 "(iff (Process a) (and (Occurrent a) (exists (b) (properTemporalPartOf b a)) (exists (c t) (and (MaterialEntity c) (specificallyDependsOnAt a c t))))) // axiom label in BFO2 CLIF: [083-003] " ;
    rdfs:isDefinedBy <http://w3id.org/roh/mirror/obo/bfo#BFO.owl> .

ns3:freetextKeyword a owl:DatatypeProperty ;
    rdfs:label "keyword"@en ;
    ns2:IAO_0000112 "conservation\\n\\nuse one freetextKeyword assertion for each keyword or phrase.",
        "one keyword or phrase per freetextKeyword assertion" ;
    rdfs:comment "Any ROH entity may be qualified by several keywords" .

ns4:Funding a owl:Class ;
    rdfs:label "Funding"@en ;
    rdfs:comment "A roh:Funding is the funding associated to a vivo:Project whose funding is associated to a roh:FundingProgram, which in turn is associated to a vivo:FundingOrganization. A roh:Funding consists of several roh:FundingAmounts, associated to the different entities that participate in a project and to the annuities in which they do it.  Funding gathers information about the total funding received for a Project and its currency through properties roh:monetaryAmount and roh:currency. A roh:FundingSource funds a roh:FundingProgram. A roh:Funding supports a vivo:Project or a roh:PersonContract. A Funding can be tagged as public or private, by updating the data property roh:publicFunding." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns4:FundingAmount ;
            owl:onProperty ns9:BFO_0000051 ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns4:FundingProgram ns3:FundingOrganization ) ] ;
            owl:onProperty ns4:fundedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
            owl:onProperty ns4:hasKnowledgeArea ],
        [ a owl:Restriction ;
            owl:onProperty ns3:identifier ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty ns4:publicFunding ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:freetextKeyword ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:Contract ;
            owl:onProperty ns4:hasContract ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:identifier ] .

ns4:Status a owl:Class ;
    rdfs:label "Status"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeInterval ;
            owl:onProperty ns3:dateTimeInterval ] .

ns4:hasKnowledgeArea a owl:ObjectProperty ;
    rdfs:label "has knowledge area"@en ;
    rdfs:comment "Some entity related to any Concept."@en ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                        owl:onProperty ns1:inScheme ;
                        owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
    owl:inverseOf ns4:knowledgeAreaOf .

ns3:dateTimeValue a owl:ObjectProperty ;
    rdfs:label "date/time value"@en ;
    rdfs:comment "The temporal point in which something takes place."@en .

ns4:Accreditation a owl:Class ;
    rdfs:label "Accreditation"@en ;
    ns2:IAO_0000112 "An attestation of qualification, competence, or authority issued to an individual by a third party with a relevant or  de facto authority or assumed competence to do so." ;
    ns2:IAO_0000115 "An attestation of qualification, competence, or authority issued to an individual by a third party with a relevant or  de facto authority or assumed competence to do so." ;
    rdfs:comment "An Accreditation models research and academic position accreditations. Qualification goes beyond Accreditation because it also refers to degrees and other qualifications a person may have.  Accreditation has an important data property which is dateIssued which links Accreditation with vivo:DataTimeValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
            owl:onProperty ns4:hasKnowledgeArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ;
            owl:onProperty ns3:hasGoverningAuthority ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns4:title ],
        [ a owl:Restriction ;
            owl:onProperty ns4:title ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns3:DateTimeValue ;
            owl:onProperty ns3:dateIssued ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ns3:description ],
        [ a owl:Restriction ;
            owl:onProperty ns3:hasGoverningAuthority ;
            owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ] .

ns4:Repository a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:Concept [ a owl:Restriction ;
                                owl:onProperty ns1:inScheme ;
                                owl:someValuesFrom ns4:KnowledgeArea ] ) ] ;
