    ns2:IAO_0000114 <http://w3id.org/roh/mirror/obo/iao#IAO_0000120> ;
    ns2:IAO_0000115 "A student role inhering in a person that is realized when the bearer participates in a course of study at a secondary learning institution." ;
    ns2:IAO_0000117 "PERSON: Nicole Vasilevsky" ;
