@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/adms#> .
@prefix onto: <http://vocab.deri.ie/br> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://vocab.deri.ie/br#BrTopic> a rdfs:Class,
        owl:Class ;
    rdfs:label "BrTopic" .

<http://vocab.deri.ie/br#Brainstorm> a rdfs:Class,
        owl:Class ;
    rdfs:label "Brainstorm" .

<http://vocab.deri.ie/br#Idea> a rdfs:Class,
        owl:Class ;
    rdfs:label "Idea" .

<http://vocab.deri.ie/br#Label> a rdfs:Class,
        owl:Class ;
    rdfs:label "Label" .

<http://vocab.deri.ie/br#ObjDescription> a rdfs:Class,
        owl:Class ;
    rdfs:label "Objective Description" .

<http://vocab.deri.ie/br#ObjTitle> a rdfs:Class,
        owl:Class ;
    rdfs:label "Objective Title" .

<http://vocab.deri.ie/br#Objective> a rdfs:Class,
        owl:Class ;
    rdfs:label "Objective" .

<http://vocab.deri.ie/br#Participant> a rdfs:Class,
        owl:Class ;
    rdfs:label "Participant" .

<http://vocab.deri.ie/br#Site> a rdfs:Class,
        owl:Class ;
    rdfs:label "Site" .

<http://vocab.deri.ie/br#DERI%2C%20NUI%20Galway> a dcterms:Agent ;
    foaf:homepage <http://www.deri.ie/> ;
    foaf:member <http://vocab.deri.ie/br#lorlor> ;
    foaf:name "DERI, NUI Galway" .

<http://vocab.deri.ie/br#creator> a rdf:Property ;
    rdfs:label "dc:creator" ;
    rdfs:domain <http://vocab.deri.ie/br#Idea> ;
    rdfs:range <http://vocab.deri.ie/br#Participant> ;
    rdfs:subPropertyOf dc:creator .

<http://vocab.deri.ie/br#description> a rdf:Property ;
    rdfs:label "dc:description" ;
    rdfs:domain <http://vocab.deri.ie/br#Objective> ;
    rdfs:range <http://vocab.deri.ie/br#ObjDescription> ;
    rdfs:subPropertyOf dc:description .

<http://vocab.deri.ie/br#hasEvent> a rdf:Property ;
    rdfs:label "br:hasEvent" ;
    rdfs:domain <http://vocab.deri.ie/br#Brainstorm> .

<http://vocab.deri.ie/br#hasExpectation> a rdf:Property ;
    rdfs:label "br:hasExpectation" ;
    rdfs:domain <http://vocab.deri.ie/br#Brainstorm> ;
    rdfs:range <http://vocab.deri.ie/br#Objective> .

<http://vocab.deri.ie/br#hasIdea> a rdf:Property ;
    rdfs:label "br:hasIdea" ;
    rdfs:domain <http://vocab.deri.ie/br#Site> ;
    rdfs:range <http://vocab.deri.ie/br#Idea> .

<http://vocab.deri.ie/br#hasParticipant> a rdf:Property ;
    rdfs:label "br:hasParticipant" ;
    rdfs:domain <http://vocab.deri.ie/br#Brainstorm> ;
    rdfs:range <http://vocab.deri.ie/br#Participant> .

<http://vocab.deri.ie/br#hasReview> a rdf:Property ;
    rdfs:label "rev:hasReview" ;
    rdfs:domain <http://vocab.deri.ie/br#Idea> .

<http://vocab.deri.ie/br#hasSpace> a rdf:Property ;
    rdfs:label "sioc:has_space" ;
    rdfs:domain <http://vocab.deri.ie/br#Brainstorm> .

<http://vocab.deri.ie/br#hasTopic> a rdf:Property ;
    rdfs:label "br:hasTopic" ;
    rdfs:domain <http://vocab.deri.ie/br#Brainstorm> ;
    rdfs:range <http://vocab.deri.ie/br#BrTopic> .

<http://vocab.deri.ie/br#holdsAccount> a rdf:Property ;
    rdfs:label "foaf:holdsAccount" ;
    rdfs:domain foaf:Person ;
    rdfs:range <http://vocab.deri.ie/br#Participant> ;
    rdfs:subPropertyOf foaf:holdsAccount .

<http://vocab.deri.ie/br#member> a rdf:Property ;
    rdfs:label "skos:member" ;
    rdfs:domain <http://vocab.deri.ie/br#Brainstorm> ;
    rdfs:range <http://vocab.deri.ie/br#Idea> .

<http://vocab.deri.ie/br#prefLabel> a rdf:Property ;
    rdfs:label "skos:prefLabel" ;
    rdfs:range <http://vocab.deri.ie/br#Label> .

<http://vocab.deri.ie/br#rdf> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    ns1:accessURL "http://vocab.deri.ie/br.rdf" ;
    ns1:status <http://purl.org/adms/status/Completed> .

<http://vocab.deri.ie/br#semanticRelation> a rdf:Property ;
    rdfs:label "skos:semanticRelation" ;
    rdfs:domain <http://vocab.deri.ie/br#Idea> ;
    rdfs:range <http://vocab.deri.ie/br#Idea> .

<http://vocab.deri.ie/br#taggedBy> a rdf:Property ;
    rdfs:label "Tags_taggedBy" ;
    rdfs:range foaf:Person .

<http://vocab.deri.ie/br#title> a rdf:Property ;
    rdfs:label "dc:title" ;
    rdfs:domain <http://vocab.deri.ie/br#Objective> ;
    rdfs:range <http://vocab.deri.ie/br#ObjTitle> ;
    rdfs:subPropertyOf dc:title .

<http://vocab.deri.ie/br#ttl> a ns1:SemanticDistribution ;
    dcterms:FileFormat onto: ;
    ns1:accessURL "http://vocab.deri.ie/br.ttl" ;
    ns1:status <http://purl.org/adms/status/Completed> .

<http://vocab.deri.ie/br#type> a rdf:Property ;
    rdfs:label "rdf:type" ;
    rdfs:domain <http://vocab.deri.ie/br#Brainstorm> ;
    rdfs:subPropertyOf rdf:type .

<http://vocab.deri.ie/br#lorlor> a foaf:Person ;
    foaf:homepage onto: ;
    foaf:mbox <mailto:lorea.lorenzo@deri.org> ;
    foaf:name "Lorea Lorenzo Uribarren" .

onto: a owl:Ontology,
        ns1:SemanticAsset ;
    dc:creator <http://vocab.deri.ie/br#lorlor> ;
    dcterms:created "2011-03-25"^^xsd:date ;
    dcterms:description "A lightweight ontology to structure e- brainstorming sessions" ;
    dcterms:modified "2011-07-09"^^xsd:date ;
    dcterms:partOf <http://vocab.deri.ie> ;
    dcterms:publisher "http://vocab.deri.ie/br#DERI%2C%20NUI%20Galway" ;
    dcterms:status <http://purl.org/adms/status/UnderDevelopment> ;
    dcterms:title "Brainstorm Ontology" ;
    dcterms:type <http://purl.org/adms/assettype/Ontology> ;
    vann:preferredNamespacePrefix "br" ;
    vann:preferredNamespaceUri "http://vocab.deri.ie/br#" ;
    foaf:homepage onto:.html .

