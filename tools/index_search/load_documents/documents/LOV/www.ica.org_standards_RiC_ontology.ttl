ns1:hasOrHadStudent a owl:ObjectProperty ;
    rdfs:label "has or had student"@en ;
    rdfs:comment "Inverse of 'has or had teacher' object property."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:knows ;
    owl:inverseOf ns1:hasOrHadTeacher ;
    owl:propertyChainAxiom ( ns1:personIsSourceOfTeachingRelation ns1:teachingRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"hasStudent\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R053i ('has or had student'\\n            relation)"@en .

ns1:hasOrHadSubdivision a owl:ObjectProperty ;
    rdfs:label "has or had subdivision"@en ;
    rdfs:comment "Connects a Group to one of its present or past\\n            subdivisions."@en ;
    rdfs:domain ns1:Group ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Group ;
    rdfs:subPropertyOf ns1:hasOrHadPart,
