@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://www.ica.org/standards/RiC/ontology#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix onto: <https://www.ica.org/standards/RiC/ontology> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns2:license a owl:AnnotationProperty .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:publisher a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:abstract a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

rdf:value a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:changeNote a owl:AnnotationProperty ;
    rdfs:subPropertyOf skos:note .

skos:definition a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

skos:historyNote a owl:AnnotationProperty .

skos:inScheme a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

ns1:CarrierExtent a owl:Class ;
    rdfs:label "Carrier Extent"@en ;
    rdfs:comment "The extent of a Record Resource carrier"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Extent ;
    skos:changeNote [ dc:date "2020-11-21" ;
            rdf:value "Changed a bit the definition and added change\\n                    notes."@en ],
        [ dc:date "2020-10-28" ;
            rdf:value "Class added in order to handle an accurate description of a\\n                    carrier extent"@en ] ;
    skos:scopeNote "Countable characteristics of a record resource carrier\\n            expressed as a quantity."@en ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-A04 (Carrier Extent)\\n            attribute"@en .

ns1:DateRange a owl:Class ;
    rdfs:label "Date Range"@en ;
    rdfs:comment "Chronological information associated with an entity that\\n            contributes to its identification and contextualization, that implies or explicitly\\n            states a start date and end date."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SingleDate ;
            owl:onProperty ns1:hasEndDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:SingleDate ;
            owl:onProperty ns1:hasBeginningDate ],
        ns1:Date ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E20 (Date Range\\n            entity)"@en .

ns1:DateSet a owl:Class ;
    rdfs:label "Date Set"@en ;
    rdfs:comment "Non-contiguous single dates or date ranges."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Date ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Comment: updated. Objective: to make RiC-O compliant with\\n                    RiC-CM v0.2."@en ] ;
    skos:scopeNote "Primarily used in the description of Record Sets to describe\\n            dates of member Records"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E21 (Date Set\\n            entity)"@en .

ns1:InstantiationExtent a owl:Class ;
    rdfs:label "Instantiation Extent"@en ;
    rdfs:comment "The extent of an Instantiation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Extent ;
    skos:changeNote [ dc:date "2020-11-21" ;
            rdf:value "Changed a bit the definition and added change\\n                    notes."@en ],
        [ dc:date "2020-10-28" ;
            rdf:value "Class added in order to handle an accurate description of\\n                    an instantiation extent"@en ] ;
    skos:scopeNote "Countable characteristics of an Instantiation expressed as a\\n            quantity."@en ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-A23 (Instantiation\\n            Extent attribute)"@en .

ns1:RecordResourceExtent a owl:Class ;
    rdfs:label "Record Resource Extent"@en ;
    rdfs:comment "The extent of the content of a Record Resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Extent ;
    skos:changeNote [ dc:date "2020-11-21" ;
            rdf:value "Changed a bit the definition and added change\\n                    notes."@en ],
        [ dc:date "2020-10-28" ;
            rdf:value "Class added in order to handle an accurate description of a\\n                    record resource extent"@en ] ;
    skos:scopeNote "Countable characteristics of the content of the Record\\n            Resource expressed as a quantity."@en ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-A35 (Record Resource\\n            extent attribute)"@en .

ns1:RiCCMCorrespondingComponent a owl:AnnotationProperty ;
    rdfs:label "RiC-CM corresponding component"@en ;
    rdfs:comment "When it exists, specifies the identifier and name of RiC-CM\\n            component that corresponds to the annotated class or property."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:comment .

ns1:accrual a owl:DatatypeProperty ;
    rdfs:label "accrual"@en ;
    rdfs:comment "Information on the anticipated accession(s) to the Record\\n            Set."@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:scopeNote "See also accrualStatus"@en ;
    ns1:RiCCMCorrespondingComponent "corresponds to RiC-A01 (Accrual\\n            attribute)"@en .

ns1:accrualStatus a owl:DatatypeProperty ;
    rdfs:label "accrual status"@en ;
    rdfs:comment "Information on the status of an Accrual"@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "scope note : updated. Objective: to make RiC-O compliant\\n                    with RiC-CM v0.2."@en ] ;
    skos:scopeNote "A text statement or single words such as “Closed” to indicate\\n            that no additional Record Resource will (or is anticipated to) be added to the Record\\n            Set; “Open” to indicate that additional records or record sets will (or are expected to)\\n            be added to the Record Set; or “Unknown” to indicate that this information is not\\n            available, for example. See also accrual"@en ;
    ns1:RiCCMCorrespondingComponent "corresponds to RiC-A01 (Accrual\\n            attribute)"@en .

ns1:altimetricSystem a owl:DatatypeProperty ;
    rdfs:label "altimetric system"@en ;
    rdfs:comment "Reference system used for altitude"@en ;
    rdfs:domain ns1:Coordinates ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:referenceSystem .

ns1:altitude a owl:DatatypeProperty ;
    rdfs:label "altitude"@en ;
    rdfs:comment "The height of a Place above a reference level, especially above\\n            sea level."@en ;
    rdfs:domain ns1:Coordinates ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:measure ;
    skos:scopeNote "Property of the Coordinates class. If you don't use this\\n            class, use geographicalCoordinates property, a property of Place class."@en .

ns1:authenticityNote a owl:DatatypeProperty ;
    rdfs:label "authenticity note"@en ;
    rdfs:comment "Description of evidences that the Record Resource or\\n            Instantiation is what it purports to be, was created or sent by the said Agent, at the\\n            said time and has not been tampered or corrupted."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "examples added. Objective: to make RiC-O compliant with\\n                    RiC-CM v0.2."@en ] ;
    skos:example "The charter is missing the seal of the King."@en,
        "The electronic signature validity cannot by assessed, but the\\n            content was not modified from the moment of signing."@en,
        "The record bears no signature."@en,
        "The record bears signatures and it was preserved."@en,
        "The record is digitally signed by the Notary."@en,
        "The timestamp exists but cannot be verified."@en,
        "The whole collection consists of copies of the charters issued\\n            by Vlad the Impaler."@en ;
    skos:scopeNote "For electronic records, it may include results from automated\\n            means of checking the validity of signatures and timestamp."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A03 (Authenticity Note\\n            attribute)"@en .

ns1:authorizingMandate a owl:DatatypeProperty ;
    rdfs:label "authorizing mandate"@en ;
    rdfs:comment "Information on a Mandate that authorizes an Agent to perform an\\n            Activity."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:ruleFollowed ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use the Mandate class for handling\\n            mandates."@en .

ns1:birthDate a owl:DatatypeProperty ;
    rdfs:label "birth date"@en ;
    rdfs:comment "Date at which a Person was born."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:beginningDate ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:calendar a owl:DatatypeProperty ;
    rdfs:label "calendar"@en ;
    rdfs:comment "Used system of reckoning time in which the beginning, length,\\n            and divisions of a year are defined, sometimes along with multiyear\\n            cycles."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:dateStandard ;
    ns1:RiCCMCorrespondingComponent "Specialization of RiC-A14 (Date Standard\\n            attribute)"@en .

ns1:carrierExtent a owl:DatatypeProperty ;
    rdfs:label "carrier extent"@en ;
    rdfs:comment "Number of physical units and/or physical dimensions of the\\n            carrier of a record resource instantiation. Various carriers, depending on specific\\n            needs, may have more than one relevant dimension. In some cases, indicating the number\\n            of physical units may be sufficient, while in other case, relevant dimensions should be\\n            used in order to characterize the carrier."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:physicalOrLogicalExtent ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition and scope note updated. Examples added.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "1 page"@en,
        "17 x 34.5 cm"@en,
        "2 pieces of parchment, 30 x 50 cm and 32,5 x 49\\n            cm"@en,
        "3GB USB key"@en ;
    skos:scopeNote "For electronic resources, it indicates the size of storage\\n            capacity (disk, tape, film etc.). Carrier Extent should not be confused with Record\\n            Resource Extent or Instantiation Extent. For a given Record Resource, the Instantiation\\n            Extent may vary, based on format, density of information on the carrier, etc. For\\n            example, 1500 words (Record Resource Extent) may have Instantiation Extent 3kb as a Word\\n            document and 5kb as a PDF file, and instantiations may be represented on a CD of 700mb\\n            (Carrier Extent). Use if you don't use CarrierExtent class and its properties for\\n            handling such information."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A04 (Carrier Extent\\n            attribute)"@en .

ns1:certainty a owl:DatatypeProperty ;
    rdfs:label "certainty"@en ;
    rdfs:comment "Qualifies the level of certitude of the accuracy of a Date, an\\n            Event or a Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Date ns1:Event ns1:Relation ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition updated. Objective: to make RiC-O compliant\\n                    with RiC-CM v0.2."@en ] ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A06 (Certainty\\n            attribute)"@en .

ns1:classification a owl:DatatypeProperty ;
    rdfs:label "classification"@en ;
    rdfs:comment "A term, number or alphanumeric string that is usually taken from\\n            an external classification vocabulary or scheme that qualifies the Record\\n            Resource."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition and scope note updated. Examples added.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "BUD-01-F002 [example of a classification number from a corporate\\n            file plan]"@en,
        "digitized items"@en,
        "financial affairs"@en,
        "human resource management"@en,
        "student registration"@en ;
    skos:scopeNote "No further statement is made here about the nature of the\\n            qualifier, nor about the relation it has with the Record Resource or with the management\\n            of the Record Resource. The value of this property may in turn be used as a criterion\\n            for identifying the qualified Record Resource as a member of a Record\\n            Set."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A07 (Classification\\n            attribute)"@en .

ns1:closeTo a owl:AnnotationProperty ;
    rdfs:label "close to"@en ;
    rdfs:comment "An annotation property for recording a possible mapping to a\\n            component in another model or ontology"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:comment .

ns1:conditionsOfAccess a owl:DatatypeProperty ;
    rdfs:label "conditions of access"@en ;
    rdfs:comment "Terms and circumstances affecting the availability of a Record\\n            Resource for consultation. Such conditions may originate in laws, regulations and\\n            policies, including those pertaining to privacy and security concerns or restrictions;\\n            they may concern a specific Instantiation of a Record Resource, for example, conditions\\n            that require preservation treatment; or they may specify the software or hardware\\n            necessary to access the Instantiation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition and scope note updated. Examples added.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "Recognita software, min. version 3.0, is needed in order to open\\n            the file."@en,
        "closed as awaiting conservation treatment"@en,
        "closed under data protection legislation"@en,
        "open"@en,
        "the Archives cannot provide VHS reader to access the content of\\n            the tape."@en ;
    skos:scopeNote "This property provides information about the accessibility of\\n            a Record Resource, as well as the physical, technical or legal limitations that exist\\n            for providing access to it."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A08 (Conditions of Access\\n            attribute)"@en .

ns1:conditionsOfUse a owl:DatatypeProperty ;
    rdfs:label "conditions of use"@en ;
    rdfs:comment "Terms and circumstances affecting the use of a Record Resource\\n            after access has been provided. Includes conditions governing reproduction of the Record\\n            Resource under applicable copyright (intellectual property) and/or property legislation,\\n            and of the Instantiation, due to conservation status."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition updated. Examples added. Objective: to make\\n                    RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "Freely usable without restrictions"@en,
        "The permission of the owner of the Record must be obtained\\n            before use."@en,
        "The record cannot be copied using warm light copying machines or\\n            photographed using flashlight."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A09 (Conditions of Use\\n            attribute)"@en .

ns1:creationDate a owl:DatatypeProperty ;
    rdfs:label "creation date"@en ;
    rdfs:comment "Date at which an entity was created."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:beginningDate ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:dateQualifier a owl:DatatypeProperty ;
    rdfs:label "date qualifier"@en ;
    rdfs:comment "Indicates the precision of a date. It specifies if, and to what\\n            extent, the value is an estimation."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "examples added. Objective: to make RiC-O compliant with\\n                    RiC-CM v0.2."@en ] ;
    skos:example "circa"@en,
        "during"@en,
        "exact"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A13 (Date Qualifier\\n            attribute)"@en .

ns1:deathDate a owl:DatatypeProperty ;
    rdfs:label "death date"@en ;
    rdfs:comment "Date at which a Person died."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:endDate ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:deletionDate a owl:DatatypeProperty ;
    rdfs:label "deletion date"@en ;
    rdfs:comment "Date at which an entity was deleted."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:endDate ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:descriptiveNote a owl:DatatypeProperty ;
    rdfs:label "descriptive note"@en ;
    rdfs:comment "Descriptive information about an entity that is not otherwise\\n            addressed."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A16 (Descriptive Note\\n            attribute)"@en .

ns1:expressedDate a owl:DatatypeProperty ;
    rdfs:label "expressed date"@en ;
    rdfs:comment "Natural language expression of a Date."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:textualValue ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "examples added. Objective: to make RiC-O compliant with\\n                    RiC-CM v0.2."@en ] ;
    skos:example "1925-1966"@en,
        "October 24th, 1999"@en,
        "The Sunday before Christmas"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A19 (Expressed Date\\n            attribute)"@en .

ns1:geodesicSystem a owl:DatatypeProperty ;
    rdfs:label "geodesic system"@en ;
    rdfs:comment "Reference system used for geographical\\n            coordinates."@en ;
    rdfs:domain ns1:Coordinates ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:referenceSystem .

ns1:geographicalCoordinates a owl:DatatypeProperty ;
    rdfs:label "geographical coordinates"@en ;
    rdfs:comment "Longitudinal and latitudinal information of a\\n            Place."@en ;
    rdfs:domain ns1:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition and scope note updated. Examples added.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "Latitude 35.89421911, Longitude 139.94637467"@en,
        "Latitude 50°40′46,461″N, Longitude 95°48′26,533″W, Height\\n            123,45m"@en ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use PhysicalLocation and Coordinates classes with Place.\\n            Coordinates may be based on ISO 6709 Standard representation of geographic point\\n            location by coordinates."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A11 (Coordinates\\n            attribute)"@en .

ns1:hasOrHadCorrespondent a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has or had correspondent"@en ;
    rdfs:comment "Connects two Persons that correspond or have corresponded with\\n            each other. This relation is symmetric."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:knows ;
    owl:propertyChainAxiom ( ns1:personHasCorrespondenceRelation ns1:correspondenceRelationConnects ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, textual definition (changed made in\\n                    order to make RiC-O compliant with RiC-CM 0.2; the name of this property in\\n                    RiC-O 0.1 was \"hasCorrespondent\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R052 ('has or had correspondent'\\n            relation)"@en .

ns1:hasOrHadSpouse a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has or had spouse"@en ;
    rdfs:comment "Connects two Persons that are or were married. This relation is\\n            symmetric."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:hasFamilyAssociationWith ;
    owl:propertyChainAxiom ( ns1:personHasSpouseRelation ns1:spouseRelationConnects ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, super property IRI (changed made in order to make RiC-O compliant\\n                    with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"hasSpouse\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R049 ('has or had spouse'\\n            relation)"@en .

ns1:hasOrHadWorkRelationWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has or had work relation with"@en ;
    rdfs:comment "Connects two Agents that have or had some type of work relation\\n            in the course of their activities. This relation is symmetric."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, text definition (changed made in\\n                    order to make RiC-O compliant with RiC-CM 0.2; the name of this property in\\n                    RiC-O 0.1 was \"hasWorkRelationWith\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R046 ('has or had work relation with'\\n            relation)"@en .

ns1:hasSibling a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has sibling"@en ;
    rdfs:comment "Connects two Persons that are siblings. This relation is\\n            symmetric."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:hasFamilyAssociationWith ;
    owl:propertyChainAxiom ( ns1:personHasSiblingRelation ns1:siblingRelationConnects ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the super property IRI."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R048 ('has sibling'\\n            relation)"@en .

ns1:height a owl:DatatypeProperty ;
    rdfs:label "height"@en ;
    rdfs:comment "Vertical dimension of an entity."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:measure .

ns1:history a owl:DatatypeProperty ;
    rdfs:label "history"@en ;
    rdfs:comment "Summary of the development of an entity, since its origin until\\n            present time."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Activity ns1:Agent ns1:Event ns1:Instantiation ns1:Place ns1:RecordResource ns1:Rule ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Domains updated. Examples added. Objective: to make RiC-O\\n                    compliant with RiC-CM v0.2."@en ] ;
    skos:example "The manuscripts are part of the collections of Robert Harley (d\\n            1724) and Edward Harley (d 1741), 1st and 2nd Earls of Oxford, that were brought by\\n            Parliament and transferred to the British Museum in 1753. Those materials were then\\n            separated into this collection and those for Harley Charters and Harley Rolls and became\\n            part of the collections of the British Library in 1972. (Record Set)"@en ;
    skos:scopeNote "History can alternatively be represented by a series of\\n            related Events."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A21 (History\\n            attribute)"@en .

ns1:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    rdfs:comment "A word, number, letter, symbol, or any combination of these used\\n            to uniquely identify or reference an individual instance of an entity within a specific\\n            information domain. Includes Global Persistent Identifiers (globally unique and\\n            persistently resolvable identifier for the entity) and/or Local\\n            Identifiers."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition and scope note updated. Examples added.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "Ark ID: w6tz44ht"@en,
        "BUD-01-F002 [example of a classification number from a corporate\\n            file plan]"@en,
        "F 1204 [example of a local identifier for a Record Set assigned\\n            by a repository]"@en,
        "ISNI : 0000000073572182"@en,
        "NAS1/A/1.1 [example of local identifier for a\\n            Record]"@en,
        "SNAC ID: 83847206"@en ;
    skos:scopeNote "Use only if you don't use Identifier class for handling\\n            identifiers. Within a given domain (a closed system), identifiers are used to uniquely\\n            reference instances of an entity. Identifiers are instruments of control that facilitate\\n            management of the entities within the domain. The formulation of identifiers commonly is\\n            based on rules."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A22 (Identifier\\n            attribute)"@en .

ns1:instantiationExtent a owl:DatatypeProperty ;
    rdfs:label "Instantiation extent"@en ;
    rdfs:comment "Countable characteristics of the Instantiation expressed as a\\n            quantity."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:physicalOrLogicalExtent ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Scope note updated. Examples added. Objective: to make\\n                    RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "Size of PDF-file: 1.5 MB"@en,
        "The book register has 345 written leaves."@en ;
    skos:scopeNote "For a given Record Resource, the Instantiation Extent may\\n            vary, based on format, density of information on the carrier, etc. For example, a file\\n            of 1500 words (Record Resource Extent) may have Instantiation Extent 3kb as a Word\\n            document and 5kb as a PDF file, and instantiations may be represented on a CD of 700mb\\n            (Carrier Extent). Use if you don't use InstantiationExtent class and its properties for\\n            handling such information."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A23 (Instantiation Extent\\n            attribute)"@en .

ns1:instantiationStructure a owl:DatatypeProperty ;
    rdfs:label "Instantiation structure"@en ;
    rdfs:comment "Information about the physical arrangement and composition of an\\n            Instantiation."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:structure ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition fixed. Objective: to make RiC-O compliant\\n                    with RiC-CM v0.2."@en ] ;
    ns1:RiCCMCorrespondingComponent "Specialization of RiC-A40 (Structure\\n            attribute)"@en .

ns1:integrity a owl:DatatypeProperty ;
    rdfs:label "integrity"@en ;
    rdfs:comment "Information about the completeness of a Record Resource or\\n            Instantiation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Scope note and examples added. Objective: to make RiC-O\\n                    compliant with RiC-CM v0.2."@en ] ;
    skos:example "The book register’s last pages are missing, which affects the\\n            completeness of the record."@en,
        "The charter is missing the seal."@en,
        "The database (DBF) file has the checksum SHA-1:\\n            99f9d780e441785016dea545b72dad700305535a."@en ;
    skos:scopeNote "The information about integrity may be generated manually or\\n            automatically."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A24 (Integrity\\n            attribute)"@en .

ns1:isFunctionallyEquivalentTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is functionally equivalent to"@en ;
    rdfs:comment "Connects two Instantiations which may be considered as\\n            equivalent. This relation is symmetric."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:isEquivalentTo,
        ns1:isInstantiationAssociatedWithInstantiation ;
    owl:propertyChainAxiom ( ns1:instantiationIsConnectedToFunctionalEquivalenceRelation ns1:functionalEquivalenceRelationConnects ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the scope note."@en ] ;
    skos:scopeNote "Two Instantiations, from some point of view, may be considered\\n            as equivalent. This equivalence is usually based upon the fact that the Instantiations\\n            have at least the same intellectual content (they instantiate the same Record\\n            Resource)."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R035 ('is functionally equivalent to'\\n            relation)"@en .

ns1:isOrWasAdjacentTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is or was adjacent to"@en ;
    rdfs:comment "Connects two Places that are or were geographically adjacent.\\n            This is a symmetric object property."@en ;
    rdfs:domain ns1:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Place ;
    rdfs:subPropertyOf ns1:isAssociatedWithPlace,
        ns1:isPlaceAssociatedWith ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, textual definition (changed made in\\n                    order to make RiC-O compliant with RiC-CM 0.2; the name of this property in\\n                    RiC-O 0.1 was \"isAdjacentTo\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R077 ('is or was adjacent to'\\n            relation)"@en .

ns1:lastModificationDate a owl:DatatypeProperty ;
    rdfs:label "last modification date"@en ;
    rdfs:comment "Date at which an entity was last updated."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:modificationDate ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Distance in degrees north or south of the\\n            equator."@en ;
    rdfs:domain ns1:Coordinates ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:measure ;
    skos:scopeNote "Property of the Coordinates class. If you don't use this\\n            class, use geographicalCoordinates property, a property of Place class."@en .

ns1:location a owl:DatatypeProperty ;
    rdfs:label "location"@en ;
    rdfs:comment "A delimitation of the physical territory of a place. This\\n            datatype property is used to describe basic human-readable text such as an address, a\\n            cadastral reference, or less precise information found in a record."@en ;
    rdfs:domain ns1:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition and scope note updated. Examples added.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "near the church"@en,
        "« Montreal »"@en,
        "25 rue Saint-Denis à Paris"@fr ;
    skos:scopeNote "Use only if you don't use PhysicalLocation class with Place.\\n            Use the geographicalCoordinates property, or the Coordinates class, record the\\n            geographical coordinates of the Place.s"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A27 (Location\\n            attribute)"@en .

ns1:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Distance in degrees east or west of a prime\\n            meridian."@en ;
    rdfs:domain ns1:Coordinates ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:measure ;
    skos:scopeNote "Property of the Coordinates class. If you don't use this\\n            class, use geographicalCoordinates property, a property of Place class."@en .

ns1:normalizedDateValue a owl:DatatypeProperty ;
    rdfs:label "normalized date value"@en ;
    rdfs:comment "Date representation based on a standard, preferably\\n            machine-readable."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:normalizedValue ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Examples added. Objective: to make RiC-O compliant with\\n                    RiC-CM v0.2."@en ] ;
    skos:example "1789/1815",
        "1948-03-03" ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A29 (Normalized Date\\n            attribute)"@en .

ns1:overlapsOrOverlapped a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "overlaps or overlapped"@en ;
    rdfs:comment "Connects two Places that geographically overlap or overlapped.\\n            This object property is symmetric."@en ;
    rdfs:domain ns1:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Place ;
    rdfs:subPropertyOf ns1:isAssociatedWithPlace,
        ns1:isPlaceAssociatedWith ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, text definition (changed made in\\n                    order to make RiC-O compliant with RiC-CM 0.2; the name of this property in\\n                    RiC-O 0.1 was \"overlaps\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R078 ('overlaps or overlapped'\\n            relation)"@en .

ns1:physicalCharacteristics a owl:DatatypeProperty ;
    rdfs:label "physical characteristics"@en ;
    rdfs:comment "Information about the physical features of the Instantiation.\\n            Includes information about the physical nature and condition such as conservation\\n            status."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition updated. Examples added. Objective: to make\\n                    RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "British Library binding"@en,
        "carrier heavily foxed"@en,
        "emulsion flaking"@en,
        "watermarked"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A31 (Physical Characteristics\\n            attribute)"@en .

ns1:productionTechnique a owl:DatatypeProperty ;
    rdfs:label "production technique"@en ;
    rdfs:comment "Method used in the representation of information on the\\n            Instantiation."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Examples added. Objective: to make RiC-O compliant with\\n                    RiC-CM v0.2."@en ] ;
    skos:example "engraving"@en,
        "handwriting"@en,
        "magnetic recording"@en,
        "optical recording"@en ;
    skos:scopeNote "Use only if you have free text or don't have a controlled\\n            vocabulary for production techniques (in this case, use the ProductionTechniqueType\\n            class)"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A33 (Production Technique\\n            attribute)"@en .

ns1:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publication date"@en ;
    rdfs:comment "Date of the publication of a Record Resource."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:date ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:qualityOfRepresentation a owl:DatatypeProperty ;
    rdfs:label "quality of representation"@en ;
    rdfs:comment "Conditions of an Instantiation that impact the legibility or\\n            completeness of Record Resource, and thus the viability of its use. Conditions may be\\n            associated with deficiencies in the processes of Record (re)creation or capture, or the\\n            deterioration of the Instantiation (e.g. its carrier) causing loss of information of the\\n            record over time"@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition updated. Examples added. Objective: to make\\n                    RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "Black and white digitization may have led to loss of some\\n            information."@en,
        "some loss of information due to poor quality of image\\n            capture"@en,
        "some loss of text due to rodent damage"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A34 (Quality of Representation\\n            attribute)"@en .

ns1:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity"@en ;
    rdfs:comment "Machine-readable quantity." ;
    rdfs:domain ns1:Extent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ns1:textualValue ;
    skos:changeNote [ dc:date "2020-10-28" ;
            rdf:value "Datatype property created along with unitOfMeasurement,\\n                    Extent and UnitOfMeasurement classes, in order to provide methods for handling\\n                    extent accurately."@en ],
        [ dc:date "2020-11-21" ;
            rdf:value "Added a scope note."@en ] ;
    skos:scopeNote "Use if you use the Extent class and its properties for\\n            handling an accurate description of the extent of a resource.."@en .

ns1:recordResourceExtent a owl:DatatypeProperty ;
    rdfs:label "Record Resource extent"@en ;
    rdfs:comment "The quantity of information content as human experienced\\n            represented in the Record Resource. The method and precision of expressing the quantity\\n            of information represented in a Record Resource will vary by the kind of Record Resource\\n            being described as well as by processing economy constraints. For record sets, quantity\\n            may be expressed as number of records, or, for analogue records in particular, by the\\n            physical storage dimensions of the Record members. For individual records or record\\n            parts, quantity may be expressed in more precise terms. Use if you don't use\\n            RecordResourceExtent class and its properties for handling such\\n            information."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:physicalOrLogicalExtent ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition and scope note updated. Examples added.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ],
        [ dc:date "2020-11-21" ;
            rdf:value "Updated the scope note, as a RecordResourceExtent class has\\n                    been created."@en ] ;
    skos:example "1,500 words"@en,
        "2 films"@en,
        "2.065.735 characters"@en,
        "3 minutes and 24 seconds"@en,
        "34 poems"@en,
        "6 maps"@en,
        "6 photographs"@en ;
    skos:scopeNote "The number, size or duration of the information content\\n            unit(s) remains the same even if the information is instantiated in various carriers.\\n            For example, a file of 1500 words (Record Resource Extent) may have Instantiation Extent\\n            3kb as a Word document and 5kb as a PDF file, and instantiations may be represented on a\\n            CD of 700mb (Carrier Extent). Use if you don't use RecordResourceExtent class and its\\n            properties for handling such information."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A35 (Record Resource extent\\n            attribute)"@en .

ns1:recordResourceStructure a owl:DatatypeProperty ;
    rdfs:label "Record Resource structure"@en ;
    rdfs:comment "Information about the intellectual arrangement and composition\\n            of a Record Resource. For Record and Record Part, it encompasses information about the\\n            intellectual composition of the record, the presence of record parts and their\\n            functions. For Record Set, it encompasses information about the methodology or criteria\\n            used for arranging the Record Set members or Record members within the containing Record\\n            Set"@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:structure ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition updated. Examples added. Objective: to make\\n                    RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "Inside each file, the records are arranged\\n            chronologically."@en,
        "The database has 3 related tables: names, addresses, and\\n            passport numbers."@en,
        "The record has 2 appendixes, comprising a full account of the\\n            income from car taxes and real estate taxes."@en,
        "The series have the files arranged according to the alphabetical\\n            order of the places concerned."@en ;
    ns1:RiCCMCorrespondingComponent "Specialization of RiC-A40 (Structure\\n            attribute)"@en .

ns1:relationState a owl:DatatypeProperty ;
    rdfs:label "Relation state"@en ;
    rdfs:comment "Used to qualify the state of a Relation (e. g. present, past,\\n            ongoing, unknown)."@en ;
    rdfs:domain ns1:Relation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

ns1:scopeAndContent a owl:DatatypeProperty ;
    rdfs:label "scope and content"@en ;
    rdfs:comment "Summary of the scope (such as time periods, geography) and\\n            content (such as subject matter, administrative processes) of the Record Resource. It\\n            should highlight the information conveyed in the Record Resource, why it was created,\\n            received, and/or maintained, and the Agents connected to it. Scope and Content provides\\n            a more complete summary of the informational content of the Record Resource. It may\\n            include description of relations with agents, activities, dates and places, or with\\n            other record resources. It is not to be confused with the History attribute which\\n            focuses on the origination and subsequence changes to a Record Resource."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition updated. Examples added. Objective: to make\\n                    RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "Among the witnesses, the duke of Normandy."@en,
        "Includes a detailed list of the lands and villages given by the\\n            King to the Abbey."@en,
        "Letter from Vlad the Impaler (Dracula) to the Council of\\n            Kronstadt asking them to send military support against the Ottomans, within the\\n            framework of their alliance treaty."@en,
        "The author explains why he does not agree with the decision made\\n            and adds that it cannot be applied."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A38 (Scope and Content\\n            attribute)"@en .

ns1:source a owl:DatatypeProperty ;
    rdfs:label "source"@en ;
    rdfs:comment "Information about a source used to identify or describe an\\n            entity."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:RecordResource ns1:Relation ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:scopeNote "Can be used, in particular, for Records having documentary\\n            form type Finding Aid or Authority Record, or for Relations. Use only if you don't use\\n            the hasSource object property."@en .

ns1:technicalCharacteristics a owl:DatatypeProperty ;
    rdfs:label "technical characteristics"@en ;
    rdfs:comment "Describes any relevant physical or software feature of any\\n            device involved in the creation or management of a Record Resource."@en ;
    rdfs:domain ns1:Mechanism ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Scope note and examples added. Objective: to make RiC-O\\n                    compliant with RiC-CM v0.2."@en ] ;
    skos:example "Hubble Space Telescope had until 2002 a flawed mirror that\\n            introduced severe spherical aberration for the images."@en ;
    skos:scopeNote "Does not include references to the workflow that the Mechanism\\n            is involved in which is described under the Activity entity. It emphasizes those\\n            features that provide a better understanding of the impact of the Mechanism on the\\n            records."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A41 (Technical Characteristics\\n            attribute)"@en .

ns1:title a owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    rdfs:comment "An identifying name of a Record Resource, Instantiation or\\n            Rule."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ns1:Rule ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:name ;
    skos:scopeNote "Use only if you don't use Title class for handling\\n            titles."@en ;
    ns1:RiCCMCorrespondingComponent "Specialization of RiC-A28 (Name\\n            attribute)"@en .

ns1:type a owl:DatatypeProperty ;
    rdfs:label "type"@en ;
    rdfs:comment "A term used to characterize an entity."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Type subclasses for handling\\n            categories."@en .

ns1:unitOfMeasurement a owl:DatatypeProperty ;
    rdfs:label "unit of measurement"@en ;
    rdfs:comment "A definite magnitude of a quantity, defined and adopted by convention or by\\n            law, that is used as a standard for measurement of the same kind of quantity. Can be\\n            spacial units (cm, m), weight (g, kg), time (s, h), storage (MB, TB) or more informal\\n            units used in the archival context like number of boxes, pages or words." ;
    rdfs:domain ns1:Extent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-21" ;
            rdf:value "Added a scope note."@en ],
        [ dc:date "2020-10-28" ;
            rdf:value "Datatype property created along with quantity, Extent and\\n                    UnitOfMeasurement classes, in order to provide methods for handling extent\\n                    accurately."@en ] ;
    skos:scopeNote "Use if you do not use the UnitOfMeasurement class for handling\\n            units of measurement along with Extent."@en .

ns1:usedFromDate a owl:DatatypeProperty ;
    rdfs:label "used from date"@en ;
    rdfs:comment "Date at which an Appellation was first used."@en ;
    rdfs:domain ns1:Appellation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:date ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:usedToDate a owl:DatatypeProperty ;
    rdfs:label "used to date"@en ;
    rdfs:comment "Date until an Appellation was used."@en ;
    rdfs:domain ns1:Appellation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:date ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:width a owl:DatatypeProperty ;
    rdfs:label "width"@en ;
    rdfs:comment "Horizontal dimension of an entity."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:measure .

<https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#AuthorityRecord> a owl:NamedIndividual,
        skos:Concept,
        ns1:DocumentaryFormType ;
    rdfs:label "Authority record"@en ;
    skos:definition "This category can be used for records that describe an\\n            entity."@en ;
    skos:inScheme <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes> ;
    skos:prefLabel "Authority record"@en .

<https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#FindingAid> a owl:NamedIndividual,
        skos:Concept,
        ns1:DocumentaryFormType ;
    rdfs:label "Finding aid"@en ;
    skos:definition "This documentary form type can be used for records that\\n            aggregate and organizes metadata on some record(s) or record set(s)."@en ;
    skos:inScheme <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes> .

<https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#Collection> a owl:NamedIndividual,
        skos:Concept,
        ns1:RecordSetType ;
    rdfs:label "collection"@en ;
    skos:definition "An artificial assemblage of documents accumulated on the\\n            basis of some common characteristic without regard to the provenance of those documents.\\n            Not to be confused with an archival fonds. (From ICA ISAD(G))"@en ;
    skos:inScheme <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes> ;
    skos:prefLabel "collection"@en .

<https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#File> a owl:NamedIndividual,
        skos:Concept,
        ns1:RecordSetType ;
    rdfs:label "file"@en ;
    skos:definition "An organized unit of documents grouped together either for\\n            current use by the creator or in the process of archival arrangement, because they\\n            relate to the same subject, activity, or transaction. A file is usually the basic unit\\n            within a record series. (From ICA ISAD(G))"@en ;
    skos:inScheme <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes> ;
    skos:prefLabel "file"@en .

<https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#Fonds> a owl:NamedIndividual,
        skos:Concept,
        ns1:RecordSetType ;
    rdfs:label "fonds"@en ;
    skos:definition "The whole of the records, regardless of form or medium,\\n            organically created and/or accumulated and used by a particular person, family, or\\n            corporate body in the course of that creator's activities and functions. (From ICA\\n            ISAD(G))"@en ;
    skos:inScheme <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes> ;
    skos:prefLabel "fonds"@en .

<https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#Series> a owl:NamedIndividual,
        skos:Concept,
        ns1:RecordSetType ;
    rdfs:label "series"@en ;
    skos:definition "Documents arranged in accordance with a filing system or\\n            maintained as a unit because they result from the same accumulation or filing process,\\n            or the same activity; have a particular form; or because of some other relationship\\n            arising out of their creation, receipt, or use. A series is also known as a records\\n            series. (From ICA ISAD(G))"@en ;
    skos:inScheme <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes> ;
    skos:prefLabel "series"@en .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

skos:note a owl:AnnotationProperty .

ns1:activityIsContextOfRelation a owl:ObjectProperty ;
    rdfs:label "activity is context of relation "@en ;
    rdfs:comment "Connects an Activity to an Agent Temporal Relation (when the\\n            Activity is transferred from an Agent to another one) or a Mandate Relation (the Mandate\\n            assigns the Activity to the Agent or defines it)."@en ;
    rdfs:domain ns1:Activity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:AgentTemporalRelation ns1:MandateRelation ) ] ;
    rdfs:subPropertyOf ns1:thingIsContextOfRelation ;
    owl:inverseOf ns1:asConcernsActivity .

ns1:activityIsTargetOfActivityDocumentationRelation a owl:ObjectProperty ;
    rdfs:label "activity is target of activity documentation relation\\n        "@en ;
    rdfs:comment "Connects an Activity to an Activity Documentation\\n            Relation"@en ;
    rdfs:domain ns1:Activity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ActivityDocumentationRelation ;
    rdfs:subPropertyOf ns1:agentOrActivityIsTargetOfProvenanceRelation ;
    owl:inverseOf ns1:activityDocumentationRelationHasTarget .

ns1:affectsOrAffected a owl:ObjectProperty ;
    rdfs:label "affects or affected"@en ;
    rdfs:comment "Connects an Event to a Thing on which the Event has or had some\\n            significant impact."@en ;
    rdfs:domain ns1:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:hasOrHadParticipant ;
    owl:inverseOf ns1:isOrWasAffectedBy ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition and corresponding CM component (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"affects\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R059 ('affects or affected'\\n            relation)"@en .

ns1:agentHasWorkRelation a owl:ObjectProperty ;
    rdfs:label "agent has work relation "@en ;
    rdfs:comment "Connects an Agent to a Work Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:WorkRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation ;
    owl:inverseOf ns1:workRelationConnects .

ns1:appellationIsSourceOfAppellationRelation a owl:ObjectProperty ;
    rdfs:label "appellation is source of appellation relation "@en ;
    rdfs:comment "Connects an Appellation to an Appellation\\n            Relation"@en ;
    rdfs:domain ns1:Appellation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AppellationRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:appellationRelationHasSource .

ns1:authorizedBy a owl:ObjectProperty ;
    rdfs:label "authorized by "@en ;
    rdfs:comment "Inverse of 'authorizes' object property"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Mandate ;
    rdfs:subPropertyOf ns1:isAssociatedWithRule ;
    owl:inverseOf ns1:authorizes ;
    owl:propertyChainAxiom ( ns1:agentIsTargetOfMandateRelation ns1:mandateRelationHasSource ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R067i ('authorizedBy'\\n            relation)"@en .

ns1:containsOrContained a owl:ObjectProperty ;
    rdfs:label "contains or contained"@en ;
    rdfs:comment "Connects a Place to a region that is or was within\\n            it."@en ;
    rdfs:domain ns1:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Place ;
    rdfs:subPropertyOf ns1:hasOrHadPart,
        ns1:isAssociatedWithPlace,
        ns1:isPlaceAssociatedWith ;
    owl:inverseOf ns1:isOrWasContainedBy ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name ; added a scope note (changed made\\n                    in order to make RiC-O compliant with RiC-CM 0.2; the name of this property in\\n                    RiC-O 0.1 was \"contains\")."@en ] ;
    skos:scopeNote "Use for connecting two geographical or administrative\\n            regions."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R007 ('contains or contained'\\n            relation)"@en .

ns1:dateStandard a owl:DatatypeProperty ;
    rdfs:label "date standard"@en ;
    rdfs:comment "Identifier of the standard of the Normalized\\n            date."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:referenceSystem ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "examples added. Objective: to make RiC-O compliant with\\n                    RiC-CM v0.2."@en ] ;
    skos:example "IETF"@en,
        "ISO8601"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A14 (Date Standard\\n            attribute)"@en .

ns1:describesOrDescribed a owl:ObjectProperty ;
    rdfs:label "describes or described"@en ;
    rdfs:comment "Connects a Record Resource to a Thing that it\\n            describes."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:hasOrHadSubject ;
    owl:inverseOf ns1:isOrWasDescribedBy ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"describes\")."@en ] ;
    skos:scopeNote "Can be used, among other situations, for specifying that some\\n            finding aid (a Record that has Documentary Form Type Finding Aid) describes some Record\\n            Set."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R021 (describes or\\n            described)"@en .

ns1:documentedBy a owl:ObjectProperty ;
    rdfs:label "documented by"@en ;
    rdfs:comment "Inverse of 'documents' object property."@en ;
    rdfs:domain ns1:Activity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:resultsOrResultedIn ;
    owl:inverseOf ns1:documents ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the inverse property IRI, the superproperty IRI and\\n                    the corresponding CML component name"@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R033i ('documented by'\\n            relation)"@en .

ns1:documents a owl:ObjectProperty ;
    rdfs:label "documents"@en ;
    rdfs:comment "Connects a Record Resource or an Instantiation to the Activity\\n            that generates the Record Resource or Instantiation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Activity ;
    rdfs:subPropertyOf ns1:resultsOrResultedFrom ;
    owl:inverseOf ns1:documentedBy ;
    owl:propertyChainAxiom ( ns1:recordResourceOrInstantiationIsSourceOfActivityDocumentationRelation ns1:activityDocumentationRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, superproperty IRI, corresponding CM\\n                    component name (changed made in order to make RiC-O compliant with RiC-CM 0.2;\\n                    the name of this property in RiC-O 0.1 was \"isDocumentationOf\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R033 ('documents'\\n            relation)"@en .

ns1:existsOrExistedIn a owl:ObjectProperty ;
    rdfs:label "exists or existed in"@en ;
    rdfs:comment "Connects a Position to a Group in which that Position exists or\\n            existed, or that is defined by that Group�s organizational structure."@en ;
    rdfs:domain ns1:Position ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Group ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent ;
    owl:inverseOf ns1:hasOrHadPosition ;
    owl:propertyChainAxiom ( ns1:positionIsSourceOfPositionToGroupRelation ns1:positionToGroupRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"existsIn\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R056 ('exists or existed in'\\n            relation)"@en .

ns1:expressesOrExpressed a owl:ObjectProperty ;
    rdfs:label "expresses or expressed"@en ;
    rdfs:comment "Inverse of 'is or was expressed by' object\\n            property."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Rule ;
    rdfs:subPropertyOf ns1:isAssociatedWithRule ;
    owl:inverseOf ns1:isOrWasExpressedBy ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"expresses\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R064i ('expresses or expressed'\\n            relation)"@en .

ns1:groupIsTargetOfPositionToGroupRelation a owl:ObjectProperty ;
    rdfs:label "group is target of position to group relation "@en ;
    rdfs:comment "Connects the Group (in which a Position exists) to a Position To\\n            Group Relation"@en ;
    rdfs:domain ns1:Group ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PositionToGroupRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:positionToGroupRelationHasTarget .

ns1:hasAddressee a owl:ObjectProperty ;
    rdfs:label "has addressee"@en ;
    rdfs:comment "Connects a Record Resource or an Instantiation to the Agent that\\n            it is addressed to."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:hasProvenance ;
    owl:inverseOf ns1:isAddresseeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "added a scope note"@en ] ;
    skos:scopeNote "The identity of the addressee is (usually) evidenced by the\\n            Record Resource or Instantiation itself."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R032 ('has addressee'\\n            relation)"@en .

ns1:hasAuthor a owl:ObjectProperty ;
    rdfs:label "has author"@en ;
    rdfs:comment "Connects a Record to the Group, Person or Position that is\\n            responsible for conceiving and formulating the information contained in the\\n            Record."@en ;
    rdfs:domain ns1:Record ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
    rdfs:subPropertyOf ns1:hasCreator ;
    owl:inverseOf ns1:isAuthorOf ;
    owl:propertyChainAxiom ( ns1:recordIsSourceOfAuthorshipRelation ns1:authorshipRelationHasTarget ) ;
    skos:changeNote [ dc:date "2020-12-29" ;
            rdf:value "Created following the addition of RiC-R079 relation in\\n                    RiC-CM 0.2"@en ] ;
    skos:scopeNote "To be used for any contribution to the content of a Record.\\n            Includes (of course) the Person, Group or Position in whose name or by whose command the\\n            content may have been formulated and first instantiated (e.g. the person who signed\\n            it)."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R079 ('has author'\\n            relation)"@en .

ns1:hasBirthDate a owl:ObjectProperty ;
    rdfs:label "has birth date "@en ;
    rdfs:comment "Inverse of 'is birth date of' object property"@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Date ;
    rdfs:subPropertyOf ns1:hasBeginningDate ;
    owl:inverseOf ns1:isBirthDateOf ;
    ns1:RiCCMCorrespondingComponent "RiC-R070i ('has birth date'\\n            relation)"@en .

ns1:hasChild a owl:ObjectProperty ;
    rdfs:label "has child"@en ;
    rdfs:comment "Connects a Person to one of their children."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:hasDescendant ;
    owl:inverseOf ns1:isChildOf ;
    owl:propertyChainAxiom ( ns1:personIsSourceOfChildRelation ns1:childRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the inverse property IRI."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R018 ('has child'\\n            relation)"@en .

ns1:hasCollector a owl:ObjectProperty ;
    rdfs:label "has collector"@en ;
    rdfs:comment "Connects a Record Resource or an Instantiation to the Agent that\\n            collects it intentionally (is a collector)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:hasAccumulator ;
    owl:inverseOf ns1:isCollectorOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property and super property\\n                    IRI, text definition, domain (changed made in order to make RiC-O compliant with\\n                    RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"collectedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R030 ('has collector'\\n            relation)"@en .

ns1:hasContentOfType a owl:ObjectProperty ;
    rdfs:label "has content of type"@en ;
    rdfs:comment "Connects a Record or a Record Part to a Content Type which\\n            categorizes its content."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ContentType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isContentTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the text definition and superproperty\\n                    IRI."@en ] .

ns1:hasCopy a owl:ObjectProperty ;
    rdfs:label "has copy "@en ;
    rdfs:comment "Connects a Record Resource to a copy of that Record\\n            Resource."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:hasGeneticLinkToRecordResource,
        ns1:precedesInTime ;
    owl:inverseOf ns1:isCopyOf ;
    ns1:RiCCMCorrespondingComponent "RiC-R012 ('has copy'\\n            relation)"@en .

ns1:hasDeathDate a owl:ObjectProperty ;
    rdfs:label "has death date "@en ;
    rdfs:comment "Inverse of 'is death date of' object property"@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Date ;
    rdfs:subPropertyOf ns1:hasEndDate ;
    owl:inverseOf ns1:isDeathDateOf ;
    ns1:RiCCMCorrespondingComponent "RiC-R072i ('has death date'\\n            relation)"@en .

ns1:hasDocumentaryFormType a owl:ObjectProperty ;
    rdfs:label "has documentary form type"@en ;
    rdfs:comment "Connects a Record or Record Part to its Documentary Form\\n            Type."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:DocumentaryFormType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isDocumentaryFormTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ] .

ns1:hasDraft a owl:ObjectProperty ;
    rdfs:label "has draft "@en ;
    rdfs:comment "Inverse of 'is draft of' object property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
    rdfs:subPropertyOf ns1:followsInTime,
        ns1:hasGeneticLinkToRecordResource ;
    owl:inverseOf ns1:isDraftOf ;
    ns1:RiCCMCorrespondingComponent "RiC-011i ('has draft'\\n            relation)"@en .

ns1:hasExtent a owl:ObjectProperty ;
    rdfs:label "has extent"@en ;
    rdfs:comment "Connects a Record Resource or Instantiation to an Extent" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Extent ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isExtentOf ;
    skos:changeNote [ dc:date "2020-10-28" ;
            rdf:value "Object property created along with the Extent class and its\\n                    subclasses, in order to provide methods for handling extent\\n                    accurately."@en ] .

ns1:hasExtentType a owl:ObjectProperty ;
    rdfs:label "has extent type"@en ;
    rdfs:comment "Connects an Extent to an Extent Type that categorizes what is being\\n            measured." ;
    rdfs:domain ns1:Extent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ExtentType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isExtentTypeOf ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Object property added along with the Extent Type\\n                    class."@en ] .

ns1:hasFamilyType a owl:ObjectProperty ;
    rdfs:label "has family type"@en ;
    rdfs:comment "Connects a Family to a Family Type that categorizes\\n            it."@en ;
    rdfs:domain ns1:Family ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:FamilyType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isFamilyTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ] .

ns1:hasOrHadAgentName a owl:ObjectProperty ;
    rdfs:label "has or had agent name"@en ;
    rdfs:comment "Connects an Agent and (one of) its present or past Agent\\n            Name."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentName ;
    rdfs:subPropertyOf ns1:hasOrHadName ;
    owl:inverseOf ns1:isOrWasAgentNameOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"hasAgentName\")."@en ] .

ns1:hasOrHadAllMembersWithContentType a owl:ObjectProperty ;
    rdfs:label "has of had all members with content type"@en ;
    rdfs:comment "Connects a Record Set and a Content Type that categorizes all\\n            the Records or Record Parts that are or were included in the Record Set."@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ContentType ;
    rdfs:subPropertyOf ns1:hasOrHadAllMembersWithCategory ;
    owl:inverseOf ns1:isOrWasContentTypeOfAllMembersOf ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:hasOrHadAllMembersWithDocumentaryFormType a owl:ObjectProperty ;
    rdfs:label "has of had all members with documentary form type"@en ;
    rdfs:comment "Connects a Record Set and a Documentary Form Type that\\n            categorizes all the Records or Record Parts that are or were included in the Record\\n            Set."@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:DocumentaryFormType ;
    rdfs:subPropertyOf ns1:hasOrHadAllMembersWithCategory ;
    owl:inverseOf ns1:isOrWasDocumentaryFormTypeOfAllMembersOf ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:hasOrHadAllMembersWithLanguage a owl:ObjectProperty ;
    rdfs:label "has of had all members with language"@en ;
    rdfs:comment "Connects a Record Set and a Language used by all the Records or\\n            Record Parts that are or were included in the Record Set."@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Language ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isOrWasLanguageOfAllMembersOf ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:hasOrHadAllMembersWithLegalStatus a owl:ObjectProperty ;
    rdfs:label "has of had all members with legal status"@en ;
    rdfs:comment "Connects a Record Set and a Legal Status that categorizes all\\n            the Records or Record Parts that are or were included in the Record Set."@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:LegalStatus ;
