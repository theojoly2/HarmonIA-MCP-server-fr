    skos:scopeNote "Since an Activity is a kind of Event, this Relation can also\\n            be used for Activity."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R006 ('has or had subevent'\\n            relation)"@en .

ns1:hasOrHadTeacher a owl:ObjectProperty ;
