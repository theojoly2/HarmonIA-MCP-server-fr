    owl:inverseOf ns1:isPublisherOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI (the name of\\n                    this property in RiC-O 0.1 was \"publishedBy\")."@en ] .

ns1:hasReceiver a owl:ObjectProperty ;
    rdfs:label "has receiver"@en ;
    rdfs:comment "Connects a Record Resource or an Instantiation to the Agent that\\n            receives it in the course of its activities."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:hasAccumulator ;
    owl:inverseOf ns1:isReceiverOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, super\\n                    property IRI (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"receivedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R029 ('has receiver'\\n            relation)"@en .

ns1:hasRecordState a owl:ObjectProperty ;
    rdfs:label "has record state"@en ;
    rdfs:comment "Connects a Record or Record Part to a Record State that\\n            categorizes its state."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordState ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isRecordStateOf ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Changed the IRI (hasRecordResourceState changed to\\n                    hasRecordState), label, textual definition and domain (RecordResource replaced\\n                    by Record or Record Part)."@en ] .

ns1:hasReply a owl:ObjectProperty ;
    rdfs:label "has reply"@en ;
    rdfs:comment "Connects a Record Resource to a reply, usually in the form of\\n            correspondence."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:isRecordResourceAssociatedWithRecordResource,
        ns1:precedesInTime ;
    owl:inverseOf ns1:isReplyTo ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"isRepliedToBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R013 ('has reply'\\n            relation)"@en .

ns1:hasSender a owl:ObjectProperty ;
    rdfs:label "has sender "@en ;
    rdfs:comment "Connects a Record Resource or an Instantiation to the Agent that\\n            sends it"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:hasProvenance ;
    owl:inverseOf ns1:isSenderOf ;
    ns1:RiCCMCorrespondingComponent "RiC-R031 ('has sender'\\n            relation)"@en .

ns1:hasSource a owl:ObjectProperty ;
    rdfs:label "has source "@en ;
    rdfs:comment "Connects a Record Resource or Relation to a Record Resource or\\n            Agent that is used as a source of information for identifying or describing\\n            it."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:RecordResource ns1:Relation ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Agent ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isSourceOf .

ns1:hasUnitOfMeasurement a owl:ObjectProperty ;
    rdfs:label "has unit of measurement"@en ;
    rdfs:comment "Connects an Extent to a Unit Of Measurement" ;
    rdfs:domain ns1:Extent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:UnitOfMeasurement ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isUnitOfMeasurementOf ;
    skos:changeNote [ dc:date "2020-10-28" ;
            rdf:value "Object property created along with Extent and\\n                    UnitOfMeasurement classes, in order to provide methods for handling extent\\n                    accurately."@en ] .

ns1:includesOrIncluded a owl:ObjectProperty ;
    rdfs:label "includes or included"@en ;
    rdfs:comment "Connects a Record Set to a Record or Record Set it aggregates,\\n            or aggregated in the past."@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordSet ) ] ;
    rdfs:subPropertyOf ns1:isRecordResourceAssociatedWithRecordResource ;
    owl:inverseOf ns1:isOrWasIncludedIn ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"includes\")."@en ] ;
    skos:scopeNote "A Record or Record Set can be aggregated in one or many Record\\n            Sets simultaneously or through time"@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R024 ('includes or included'\\n            relation)"@en .

ns1:isAddresseeOf a owl:ObjectProperty ;
    rdfs:label "is addressee of "@en ;
    rdfs:comment "Inverse of 'has addressee' object property."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:isProvenanceOf ;
    owl:inverseOf ns1:hasAddressee ;
    ns1:RiCCMCorrespondingComponent "RiC-032i ('is addressee of'\\n            relation)"@en .

ns1:isAuthorOf a owl:ObjectProperty ;
    rdfs:label "is author of"@en ;
    rdfs:comment "Inverse of 'has author' object property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Record ;
    rdfs:subPropertyOf ns1:isCreatorOf ;
    owl:inverseOf ns1:hasAuthor ;
    owl:propertyChainAxiom ( ns1:agentIsTargetOfAuthorshipRelation ns1:authorshipRelationHasSource ) ;
    skos:changeNote [ dc:date "2020-12-29" ;
            rdf:value "Created following the addition of RiC-R079 relation in\\n                    RiC-CM 0.2"@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R079i ('is author of'\\n            relation)"@en .

ns1:isAuthorizingAgentInMandateRelation a owl:ObjectProperty ;
    rdfs:label "is authorizing agent in mandate relation "@en ;
    rdfs:comment "Connects an Agent that assigns the Mandate, to a Mandate\\n            Relation."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:MandateRelation ;
    rdfs:subPropertyOf ns1:thingIsContextOfRelation ;
    owl:inverseOf ns1:authorizingAgent .

ns1:isBirthDateOf a owl:ObjectProperty ;
    rdfs:label "is birth date of "@en ;
    rdfs:comment "Connects a Date to a Person that was born on that\\n            Date."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:isBeginningDateOf ;
    owl:inverseOf ns1:hasBirthDate ;
    ns1:RiCCMCorrespondingComponent "RiC-R070 ('is birth date of'\\n            relation)"@en .

ns1:isChildOf a owl:ObjectProperty ;
    rdfs:label "is child of"@en ;
    rdfs:comment "Inverse of 'has child' object property."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:hasAncestor ;
    owl:inverseOf ns1:hasChild ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI and label (changed made in order to make\\n                    RiC-O compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"hasParent\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R018i ('is child of'\\n            relation)"@en .

ns1:isCollectorOf a owl:ObjectProperty ;
    rdfs:label "is collector of"@en ;
    rdfs:comment "Inverse of 'has collector' object property."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:isAccumulatorOf ;
    owl:inverseOf ns1:hasCollector ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property and super property\\n                    IRI, text definition, domain (changed made in order to make RiC-O compliant with\\n                    RiC-CM 0.2; the name of this property in RiC-O 0.1 was \"collects\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R030i ('is collector of'\\n            relation)"@en .

ns1:isCopyOf a owl:ObjectProperty ;
    rdfs:label "is copy of"@en ;
    rdfs:comment "Inverse of 'has copy' object property."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:followsInTime,
        ns1:hasGeneticLinkToRecordResource ;
    owl:inverseOf ns1:hasCopy ;
    ns1:RiCCMCorrespondingComponent "RiC-R012i ('is copy of'\\n            relation)"@en .

ns1:isDeathDateOf a owl:ObjectProperty ;
    rdfs:label "is death date of "@en ;
    rdfs:comment "Connects a Date to a Person who died on that\\n            Date."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:isEndDateOf ;
    owl:inverseOf ns1:hasDeathDate ;
    ns1:RiCCMCorrespondingComponent "RiC-R072 ('is death date of'\\n            relation)"@en .

ns1:isDraftOf a owl:ObjectProperty ;
    rdfs:label "is draft of "@en ;
    rdfs:comment "Connects a draft to the final version of a\\n            Record."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
    rdfs:subPropertyOf ns1:hasGeneticLinkToRecordResource,
        ns1:precedesInTime ;
    owl:inverseOf ns1:hasDraft ;
    ns1:RiCCMCorrespondingComponent "RiC-R011 (is draft of\\n            relation)"@en .

ns1:isEquivalentTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is equivalent to "@en ;
    rdfs:comment "Connects two Things that are considered\\n            equivalent."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo .

ns1:isExtentOf a owl:ObjectProperty ;
    rdfs:label "is extent of"@en ;
    rdfs:comment "Connects an Extent to a Record Resource or Instantiation" ;
    rdfs:domain ns1:Extent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasExtent ;
    skos:changeNote [ dc:date "2020-10-28" ;
            rdf:value "Object property created along with the Extent class and its\\n                    subclasses, in order to provide methods for handling extent\\n                    accurately."@en ] .

ns1:isExtentTypeOf a owl:ObjectProperty ;
    rdfs:label "is extent type of"@en ;
    rdfs:comment "Connects an Extent Type to an Extent that it\\n            categorizes."@en ;
    rdfs:domain ns1:ExtentType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Extent ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasExtentType ;
    skos:changeNote [ dc:date "2020-11-21" ;
            rdf:value "Added a rdfs:comment."@en ],
        [ dc:date "2020-11-01" ;
            rdf:value "Object property added along with the Extent Type\\n                    class."@en ] .

ns1:isFromUseDateOf a owl:ObjectProperty ;
    rdfs:label "is from use date of "@en ;
    rdfs:comment "Connects a Date to an Appellation, when it is the date at which\\n            the Appellation was first used."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Appellation ;
    rdfs:subPropertyOf ns1:isDateAssociatedWith ;
    owl:inverseOf ns1:wasUsedFromDate .

ns1:isInstantiationOf a owl:ObjectProperty ;
    rdfs:label "is instantiation of"@en ;
    rdfs:comment "Inverse of 'has instantiation' object property."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasInstantiation ;
    owl:propertyChainAxiom ( ns1:instantiationIsTargetOfRecordResourceToInstantiationRelation ns1:recordResourceToInstantiationRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI and label (changed made in order to make\\n                    RiC-O compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"instantiates\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R025i ('is instantiation of'\\n            relation)"@en .

ns1:isLastUpdateDateOf a owl:ObjectProperty ;
    rdfs:label "is last update date of "@en ;
    rdfs:comment "Connects a Date and a Thing that was last modified at this\\n            Date."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isModificationDateOf ;
    owl:inverseOf ns1:wasLastUpdatedAtDate .

ns1:isOrWasAffectedBy a owl:ObjectProperty ;
    rdfs:label "is or was affected by"@en ;
    rdfs:comment "Inverse of 'affects or affected' object property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Event ;
    rdfs:subPropertyOf ns1:isOrWasParticipantIn ;
    owl:inverseOf ns1:affectsOrAffected ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition and corresponding CM component (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"affectedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R059i ('is or was affected by'\\n            relation)"@en .

ns1:isOrWasAgentNameOf a owl:ObjectProperty ;
    rdfs:label "is or was agent name of"@en ;
    rdfs:comment "Connects an Agent Name to an Agent it designates or\\n            designated."@en ;
    rdfs:domain ns1:AgentName ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isOrWasNameOf ;
    owl:inverseOf ns1:hasOrHadAgentName ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"isAgentNameOf\")."@en ] .

ns1:isOrWasComponentOf a owl:ObjectProperty ;
    rdfs:label "is or was component of"@en ;
    rdfs:comment "Inverse of 'has or had component' object\\n            property."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:isInstantiationAssociatedWithInstantiation,
        ns1:isOrWasPartOf ;
    owl:inverseOf ns1:hasOrHadComponent ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"isComponentOf\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R004i ('is or was component of'\\n            relation)"@en .

ns1:isOrWasConstituentOf a owl:ObjectProperty ;
    rdfs:label "is or was constituent of"@en ;
    rdfs:comment "Inverse of 'has or had constituent' object\\n            property."@en ;
    rdfs:domain ns1:RecordPart ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Record ;
    rdfs:subPropertyOf ns1:isOrWasPartOf,
        ns1:isRecordResourceAssociatedWithRecordResource ;
    owl:inverseOf ns1:hasOrHadConstituent ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"isConstituentOf\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R003i ('is or was constituent of'\\n            relation)"@en .

ns1:isOrWasContainedBy a owl:ObjectProperty ;
    rdfs:label "is or was contained by"@en ;
    rdfs:comment "Inverse of 'contains or contained' object\\n            property."@en ;
    rdfs:domain ns1:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Place ;
    rdfs:subPropertyOf ns1:isAssociatedWithPlace,
        ns1:isOrWasPartOf,
        ns1:isPlaceAssociatedWith ;
    owl:inverseOf ns1:containsOrContained ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"containedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R007i ('is or was contained by'\\n            relation)"@en .

ns1:isOrWasContentTypeOfAllMembersOf a owl:ObjectProperty ;
    rdfs:label "is or was content type of all members of"@en ;
    rdfs:comment "Connects a Content Type and a Record Set whose all past or\\n            present Record or Record Part members have that Content Type."@en ;
    rdfs:domain ns1:ContentType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordSet ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOfAllMembersOf ;
    owl:inverseOf ns1:hasOrHadAllMembersWithContentType ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:isOrWasContentTypeOfSomeMembersOf a owl:ObjectProperty ;
    rdfs:label "is or was content type of some members of"@en ;
    rdfs:comment "Connects a Content Type and a Record Set whose some past or\\n            present Record or Record Part members have that Content Type."@en ;
    rdfs:domain ns1:ContentType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordSet ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOfSomeMembersOf ;
    owl:inverseOf ns1:hasOrHadSomeMembersWithContentType ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:isOrWasDescribedBy a owl:ObjectProperty ;
    rdfs:label "is or was described by"@en ;
    rdfs:comment "Inverse of 'describes or described' object\\n            property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:isOrWasSubjectOf ;
    owl:inverseOf ns1:describesOrDescribed ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"describedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R021i ('is or was described by'\\n            relation)"@en .

ns1:isOrWasDocumentaryFormTypeOfAllMembersOf a owl:ObjectProperty ;
    rdfs:label "is or was documentary form type of all members of"@en ;
    rdfs:comment "Connects a Documentary Form Type and a Record Set whose all past\\n            or present Record or Record Part members have that Documentary Form Type."@en ;
    rdfs:domain ns1:DocumentaryFormType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordSet ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOfAllMembersOf ;
    owl:inverseOf ns1:hasOrHadAllMembersWithDocumentaryFormType ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:isOrWasDocumentaryFormTypeOfSomeMembersOf a owl:ObjectProperty ;
    rdfs:label "is or was documentary form type of some members of"@en ;
    rdfs:comment "Connects a Documentary Form Type and a Record Set whose some\\n            past or present Record or Record Part members have that Documentary Form\\n            Type."@en ;
    rdfs:domain ns1:DocumentaryFormType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordSet ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOfSomeMembersOf ;
    owl:inverseOf ns1:hasOrHadSomeMemberswithDocumentaryFormType ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:isOrWasEnforcedBy a owl:ObjectProperty ;
    rdfs:label "is or was enforced by"@en ;
    rdfs:comment "Connects a Rule to an Agent that enforces or enforced the\\n            Rule."@en ;
    rdfs:domain ns1:Rule ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isRuleAssociatedWith ;
    owl:inverseOf ns1:isOrWasResponsibleForEnforcing ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"enforcedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R066 ('is or was enforced by'\\n            relation)"@en .

ns1:isOrWasExpressedBy a owl:ObjectProperty ;
    rdfs:label "is or was expressed by"@en ;
    rdfs:comment "Connects a Rule to a Record Resource that expresses or expressed\\n            the Rule."@en ;
    rdfs:domain ns1:Rule ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:isRuleAssociatedWith ;
    owl:inverseOf ns1:expressesOrExpressed ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"expressedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R064 ('is or was expressed by'\\n            relation)"@en .

ns1:isOrWasHolderOf a owl:ObjectProperty ;
    rdfs:label "is or was holder of"@en ;
    rdfs:comment "Connects an Agent to a Record Resource or Instantiation that the\\n            Agent holds or held."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:isOrWasManagerOf ;
    owl:inverseOf ns1:hasOrHadHolder ;
    owl:propertyChainAxiom ( ns1:agentIsSourceOfRecordResourceHoldingRelation ns1:recordResourceHoldingRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, super\\n                    property IRI and text definition (changed made in order to make RiC-O compliant\\n                    with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"isHolderOf\")."@en ] ;
