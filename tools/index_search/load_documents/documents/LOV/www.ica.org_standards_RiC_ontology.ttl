    rdfs:subPropertyOf ns1:isProvenanceOf ;
    owl:inverseOf ns1:hasSender ;
    ns1:RiCCMCorrespondingComponent "RiC-R031i ('is sender of'\\n            relation)"@en .

ns1:isSourceOf a owl:ObjectProperty ;
    rdfs:label "is source of "@en ;
    rdfs:comment "Connects a Record Resource or an Agent to a Record Resource or\\n            Relation, when the first is used as a source of information for identifying or\\n            describing the second one."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Agent ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:RecordResource ns1:Relation ) ] ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasSource .

ns1:isToUseDateOf a owl:ObjectProperty ;
    rdfs:label "is to use date of "@en ;
    rdfs:comment "Connects a Date to an Appellation, when it is the date till\\n            which the Appellation was used."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Appellation ;
    rdfs:subPropertyOf ns1:isDateAssociatedWith ;
    owl:inverseOf ns1:wasUsedToDate .

ns1:isUnitOfMeasurementOf a owl:ObjectProperty ;
    rdfs:label "is unit of measurement of"@en ;
    rdfs:comment "Inverse of 'has unit of measurement' object property" ;
    rdfs:domain ns1:UnitOfMeasurement ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Extent ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasUnitOfMeasurement ;
    skos:changeNote [ dc:date "2020-10-28" ;
            rdf:value "Object property created along with Extent and\\n                    UnitOfMeasurement classes, in order to provide methods for handling extent\\n                    accurately."@en ] .

ns1:issuedBy a owl:ObjectProperty ;
    rdfs:label "issued by "@en ;
    rdfs:comment "Connects a Rule to the Agent that issued or published the\\n            Rule."@en ;
    rdfs:domain ns1:Rule ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isRuleAssociatedWith ;
    owl:inverseOf ns1:isResponsibleForIssuing ;
    ns1:RiCCMCorrespondingComponent "RiC-R065 ('issued by'\\n            relation)"@en .

ns1:knownBy a owl:ObjectProperty ;
    rdfs:label "known by "@en ;
    rdfs:comment "Inverse of 'knows of' object property."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent ;
    owl:inverseOf ns1:knowsOf ;
    owl:propertyChainAxiom ( ns1:personIsTargetOfKnowingOfRelation ns1:knowingOfRelationHasSource ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R050i ('known by'\\n            relation)"@en .

ns1:knowsOf a owl:ObjectProperty ;
    rdfs:label "knows of "@en ;
    rdfs:comment "Connects a Person to another Person they have some knowledge of\\n            through time or space."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent ;
    owl:inverseOf ns1:knownBy ;
    owl:propertyChainAxiom ( ns1:personIsSourceOfKnowingOfRelation ns1:knowingOfRelationHasTarget ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R050 ('knows of'\\n            relation)"@en .

ns1:migratedFrom a owl:ObjectProperty ;
    rdfs:label "migrated from"@en ;
    rdfs:comment "Inverse of 'migrated into' object property."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:isDerivedFromInstantiation ;
    owl:inverseOf ns1:migratedInto ;
    owl:propertyChainAxiom ( ns1:instantiationIsTargetOfMigrationRelation ns1:migrationRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"createdByMigrationFromInstantiation\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R015i ('migrated from'\\n            relation)"@en .

ns1:migratedInto a owl:ObjectProperty ;
    rdfs:label "migrated into"@en ;
    rdfs:comment "Connects an Instantiation to a version it has been migrated\\n            to."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:hasDerivedInstantiation ;
    owl:inverseOf ns1:migratedFrom ;
    owl:propertyChainAxiom ( ns1:instantiationIsSourceOfMigrationRelation ns1:migrationRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label and inverse property IRI (changed\\n                    made in order to make RiC-O compliant with RiC-CM 0.2; the name of this property\\n                    in RiC-O 0.1 was \"isMigratedIntoInstantiation\")."@en ] ;
    skos:scopeNote "Use for digital instantiations."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R015 ('migrated into'\\n            relation)"@en .

ns1:modificationDate a owl:DatatypeProperty ;
    rdfs:label "modification date"@en ;
    rdfs:comment "Date of the modification of an entity."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:date ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "A label, title or term designating the entity in order to make\\n            it distinguishable from other similar entities. For Record Resource or Instantiation,\\n            the Name is generally assigned by an Agent as most do not have a Name given when\\n            created."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition updated. Examples added. Objective: to make\\n                    RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:example "4 March 1842"@en,
        "Digital copy of the Pomarius archival inventory from\\n            1575"@en,
        "Nelson Mandela"@en,
        "Papers of the Earls of Liverpool"@en,
        "Sketch Map of the Qatar Peninsula"@en,
        "The Letter of Neacsu from Campulung to the Mayor of\\n            Brasov"@en,
        "fundraising, University of Glasgow"@en,
        "hearing services"@en ;
    skos:scopeNote "Use only if you don't use Name class for handling\\n            names."@en ;
    ns1:RiCCMCorrespondingComponent "Corrresponds to RiC-A28 (Name\\n            attribute)"@en .

ns1:normalizedValue a owl:DatatypeProperty ;
    rdfs:label "normalized value"@en ;
    rdfs:comment "Value representation based on a standard, preferably\\n            machine-readable."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Appellation ns1:Date ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:textualValue .

ns1:occupiesOrOccupied a owl:ObjectProperty ;
    rdfs:label "occupies or occupied"@en ;
    rdfs:comment "Connects a Person to a Position they occupy or\\n            occupied."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Position ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent ;
    owl:inverseOf ns1:isOrWasOccupiedBy ;
    owl:propertyChainAxiom ( ns1:personIsSourceOfPositionHoldingRelation ns1:positionHoldingRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"occupies\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R054 ('occupies or occupied'\\n            relation)"@en .

ns1:performsOrPerformed a owl:ObjectProperty ;
    rdfs:label "performs or performed"@en ;
    rdfs:comment "Inverse of 'is or was performed by' object\\n            property."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Activity ;
    rdfs:subPropertyOf ns1:isOrWasParticipantIn ;
    owl:inverseOf ns1:isOrWasPerformedBy ;
    owl:propertyChainAxiom ( ns1:agentIsTargetOfPerformanceRelation ns1:performanceRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, super property IRI (changed made in order to make RiC-O compliant\\n                    with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"performs\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R060i ('performs or performed'\\n            relation)"@en .

ns1:personIsTargetOfChildRelation a owl:ObjectProperty ;
    rdfs:label "person is target of child relation "@en ;
    rdfs:comment "Connects a Person (as a child) to a Child\\n            Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ChildRelation ;
    rdfs:subPropertyOf ns1:personIsTargetOfDescendanceRelation ;
    owl:inverseOf ns1:childRelationHasTarget .

ns1:positionIsContextOfLeadershipRelation a owl:ObjectProperty ;
    rdfs:label "position is context of leadership relation "@en ;
    rdfs:comment "Connects a Position to a Leadership Relation (the leading Person\\n            occupies that Position)."@en ;
    rdfs:domain ns1:Position ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:LeadershipRelation ;
    rdfs:subPropertyOf ns1:thingIsContextOfRelation ;
    owl:inverseOf ns1:leadershipWithPosition .

ns1:positionIsContextOfMembershipRelation a owl:ObjectProperty ;
    rdfs:label "position is context of membership relation "@en ;
    rdfs:comment "Connects a Position to a Membership Relation (the member Person\\n            occupies that Position)."@en ;
    rdfs:domain ns1:Position ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:MembershipRelation ;
    rdfs:subPropertyOf ns1:thingIsContextOfRelation ;
    owl:inverseOf ns1:membershipWithPosition .

ns1:proxyFor a owl:ObjectProperty ;
    rdfs:label "proxy for "@en ;
    rdfs:comment "Connects a Proxy to the Record Resource it stands for in the\\n            specific context of a Record Set."@en ;
    rdfs:domain ns1:Proxy ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:isRelatedTo .

ns1:proxyIn a owl:ObjectProperty ;
    rdfs:label "proxy in "@en ;
    rdfs:comment "Connects a Proxy to the Record Set in which it stands for\\n            (represents) another Record Resource."@en ;
    rdfs:domain ns1:Proxy ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordSet ;
    rdfs:subPropertyOf ns1:isRelatedTo .

ns1:recordResourceIsConnectedToRecordResourceGeneticRelation a owl:ObjectProperty ;
    rdfs:label "record resource is connected to record resource genetic relation\\n        "@en ;
    rdfs:comment "Connects a Record Resource to a Record Resource Genetic\\n            Relation."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResourceGeneticRelation ;
    rdfs:subPropertyOf ns1:recordResourceIsConnectedToRecordResourceRelation ;
    owl:inverseOf ns1:recordResourceGeneticRelationConnects .

ns1:regulatesOrRegulated a owl:ObjectProperty ;
    rdfs:label "regulates or regulated"@en ;
    rdfs:comment "Connects a Rule to a Thing that it regulates or\\n            regulated."@en ;
    rdfs:domain ns1:Rule ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRuleAssociatedWith ;
    owl:inverseOf ns1:isOrWasRegulatedBy ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI (changed made\\n                    in order to make RiC-O compliant with RiC-CM 0.2; the name of this property in\\n                    RiC-O 0.1 was \"regulates\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R063 ('regulates or regulated'\\n            relation)"@en .

ns1:roleIsContextOfCreationRelation a owl:ObjectProperty ;
    rdfs:label "role is context of creation relation "@en ;
    rdfs:comment "Connects a Role Type to a Creation Relation (this Role Type\\n            being the specific role played by the creating Person in the context of this\\n            Relation)."@en ;
    rdfs:domain ns1:RoleType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CreationRelation ;
    rdfs:subPropertyOf ns1:thingIsContextOfRelation ;
    owl:inverseOf ns1:creationWithRole .

ns1:ruleFollowed a owl:DatatypeProperty ;
    rdfs:label "rule followed"@en ;
    rdfs:comment "The rule or conditions that govern the existence or lifecycle of\\n            a Thing."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use the Rule class for handling rules."@en .

ns1:wasLastUpdatedAtDate a owl:ObjectProperty ;
    rdfs:label "was last updated at date "@en ;
    rdfs:comment "Connects a Thing to the Date when it was last\\n            modified."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Date ;
    rdfs:subPropertyOf ns1:hasModificationDate ;
    owl:inverseOf ns1:isLastUpdateDateOf .

ns1:wasUsedFromDate a owl:ObjectProperty ;
    rdfs:label "was used from date "@en ;
    rdfs:comment "Connects an Appellation to the Date from which it was\\n            used."@en ;
    rdfs:domain ns1:Appellation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Date ;
    rdfs:subPropertyOf ns1:isAssociatedWithDate ;
    owl:inverseOf ns1:isFromUseDateOf .

ns1:wasUsedToDate a owl:ObjectProperty ;
    rdfs:label "was used to date "@en ;
    rdfs:comment "Connects an Appellation to the Date till when it was\\n            used."@en ;
    rdfs:domain ns1:Appellation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Date ;
    rdfs:subPropertyOf ns1:isAssociatedWithDate ;
    owl:inverseOf ns1:isToUseDateOf .

skos:ConceptScheme a owl:Class .

ns1:AgentName a owl:Class ;
    rdfs:label "Agent Name"@en ;
    rdfs:comment "A label, title or term designating an Agent in order to make it\\n            distinguishable from other similar entities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Name ;
    ns1:RiCCMCorrespondingComponent "Class implementation of a specialization of\\n            RiC-A28 (Name attribute)"@en .

ns1:CorporateBodyType a owl:Class ;
    rdfs:label "Corporate Body Type"@en ;
    rdfs:comment "Categorization of a Corporate Body."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:CorporateBody ;
            owl:onProperty ns1:isOrWasCorporateBodyTypeOf ],
        ns1:Type ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A12 (Corporate Body Type\\n            attribute)"@en .

ns1:CorrespondenceRelation a owl:Class ;
    rdfs:label "Correspondence Relation"@en ;
    rdfs:comment "Connects at least two Persons, when they correspond to each\\n            other."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:correspondenceRelationConnects ],
        ns1:KnowingRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R052 and Ri052i\\n            relations"@en .

ns1:ExtentType a owl:Class ;
    rdfs:label "Extent Type"@en ;
    rdfs:comment "Categorization of the extent that is being measured" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Type ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Added to specify the dimension that is being\\n                    measured"@en ] .

ns1:FamilyType a owl:Class ;
    rdfs:label "Family Type"@en ;
    rdfs:comment "Categorization of a Family."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Family ;
            owl:onProperty ns1:isFamilyTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Comment: slighty changed."@en ] ;
    skos:scopeNote "Family Type encompasses a wide variety of familial groups\\n            related by consanguinity, affinity, cohabitation or other social conventions. "@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A20 (Family Type\\n            attribute)"@en .

ns1:FunctionalEquivalenceRelation a owl:Class ;
    rdfs:label "Functional Equivalence Relation"@en ;
    rdfs:comment "Connects at least two Instantiations which may be considered as\\n            equivalent."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Instantiation ;
            owl:onProperty ns1:functionalEquivalenceRelationConnects ],
        ns1:InstantiationToInstantiationRelation ;
    skos:scopeNote "Use for Instantiations which, from some point of view, in some\\n            context and for some users at least, may be considered as equivalent. This equivalence\\n            is usually based upon the fact that the Instantiations have at least the same\\n            intellectual content (they instantiate the same Record Resource)."@en ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R035 and RiC-R035i\\n            relations"@en .

ns1:Mechanism a owl:Class ;
    rdfs:label "Mechanism"@en ;
    rdfs:comment "A process or system created by a Person or Group that performs\\n            an Activity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Agent ;
    owl:disjointWith ns1:Person,
        ns1:Position ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "scope note: made separate paragraphs. Disjoint with:\\n                    enriched."@en ] ;
    skos:scopeNote "Mechanism is a kind of Agent. A Mechanism may have both\\n            mechanical and software components, or may be exclusively software. A Mechanism acts in\\n            the world producing physical or social effects, and frequently generates or modifies\\n            Records."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E13 (Mechanism\\n            entity)"@en .

ns1:PlaceName a owl:Class ;
    rdfs:label "Place Name"@en ;
    rdfs:comment "A label, title or term designating a Place in order to make it\\n            distinguishable from other similar entities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Name ;
    ns1:RiCCMCorrespondingComponent "Class implementation of a specialization of\\n            RiC-A28 (Name attribute)"@en .

ns1:PlaceType a owl:Class ;
    rdfs:label "Place Type"@en ;
    rdfs:comment "Categorization of a Place."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Place ;
            owl:onProperty ns1:isOrWasPlaceTypeOf ],
        ns1:Type ;
    skos:scopeNote "Broadly, a Place may be a member of three broad categories:\\n            jurisdiction, manmade structure, or a natural feature. Each of these three categories\\n            can subdivided into narrower categories."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A32 (Place Type\\n            attribute)"@en .

ns1:Proxy a owl:Class ;
    rdfs:label "Proxy"@en ;
    rdfs:comment "A Proxy represents (stands for) a Record Resource as it exists\\n            in a specific Record Set."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:RecordSet ;
            owl:onProperty ns1:proxyIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns1:RecordResource ;
            owl:onProperty ns1:proxyFor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:Concept ;
    skos:scopeNote "Useful for handling in RDF the sequencing of records or\\n            records sets in the context of a Record set. A Record Resource has only one Proxy in the\\n            context of one specific Record Set. It may have many Proxies simultaneously or through\\n            time."@en ;
    ns1:closeTo "ORE Proxy (http://www.openarchives.org/ore/terms/Proxy)"@en .

ns1:RecordResourceGeneticRelation a owl:Class ;
    rdfs:label "Record Resource Genetic Relation"@en ;
    rdfs:comment "Connects two to more Record Resources when there is a genetic\\n            relation between them. Genetic in this sense is as defined by diplomatics, i.e. the\\n            process by which a Record Resource is developed."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:RecordResource ;
            owl:onProperty ns1:recordResourceGeneticRelationConnects ],
        ns1:RecordResourceToRecordResourceRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R023 and RiC-023i\\n            relations"@en .

ns1:SiblingRelation a owl:Class ;
    rdfs:label "Sibling Relation"@en ;
    rdfs:comment "Connects at least two Persons, when they are\\n            siblings."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:siblingRelationConnects ],
        ns1:FamilyRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R048 and048i\\n            relations RiC-"@en .

ns1:SingleDate a owl:Class ;
    rdfs:label "Single Date"@en ;
    rdfs:comment "Chronological information associated with an entity that\\n            contributes to its identification and contextualization, related to a single point in\\n            time."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Date ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E19 (SingleDate\\n            entity)"@en .

ns1:SpouseRelation a owl:Class ;
    rdfs:label "Spouse Relation"@en ;
    rdfs:comment "Connects at least two Persons, when they are\\n            spouses."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:spouseRelationConnects ],
        ns1:FamilyRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R049 and RiC-R049i\\n            relations"@en .

ns1:Title a owl:Class ;
    rdfs:label "Title"@en ;
    rdfs:comment "A name that is used for a Record Resource or a\\n            Rule"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Name ;
    ns1:RiCCMCorrespondingComponent "Class implementation of a specialization of\\n            RiC-A28 (Name attribute)"@en .

ns1:UnitOfMeasurement a owl:Class ;
    rdfs:label "Unit Of Measurement"@en ;
    rdfs:comment "A definite magnitude of a quantity, defined and adopted by convention or by\\n            law, that is used as a standard for measurement of the same kind of quantity. Can be\\n            spacial units (cm, m), weigt (g, kg), time (s, h), storage (MB, TB) or more informal\\n            units used in the archival context like number of boxes, pages or words." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Concept ;
    skos:changeNote [ dc:date "2020-10-28" ;
            rdf:value "Class added in order to be able to handle units of\\n                    measurement as full entities."@en ] .

ns1:WorkRelation a owl:Class ;
    rdfs:label "Work Relation"@en ;
    rdfs:comment "Connects at least two Agents that have some type of work\\n            relation in the course of their activities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:workRelationConnects ],
        ns1:AgentToAgentRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R046 and RiR046i\\n            relations-"@en .

ns1:activityDocumentationRelationHasSource a owl:ObjectProperty ;
    rdfs:label "activity documentation relation has source "@en ;
    rdfs:comment "Connects an Activity Documentation Relation to one of the\\n            resulting Record Resources or Instantiations"@en ;
    rdfs:domain ns1:ActivityDocumentationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:provenanceRelationHasSource ;
    owl:inverseOf ns1:recordResourceOrInstantiationIsSourceOfActivityDocumentationRelation .

ns1:activityIsSourceOfPerformanceRelation a owl:ObjectProperty ;
    rdfs:label "activity is source of performance relation "@en ;
    rdfs:comment "Connects an Activity that is performed to a Performance\\n            Relation"@en ;
    rdfs:domain ns1:Activity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PerformanceRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:performanceRelationHasSource .

ns1:agentIsSourceOfIntellectualPropertyRightsRelation a owl:ObjectProperty ;
    rdfs:label "agent is source of intellectual property rights relation\\n        "@en ;
    rdfs:comment "Connects an Agent having the intellectual property rights, to an\\n            Intellectual Property Rights Relation"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:IntellectualPropertyRightsRelation ;
    rdfs:subPropertyOf ns1:agentIsSourceOfAuthorityRelation ;
    owl:inverseOf ns1:intellectualPropertyRightsRelationHasSource .

ns1:agentIsSourceOfOwnershipRelation a owl:ObjectProperty ;
    rdfs:label "agent is source of ownership relation "@en ;
    rdfs:comment "Connects an owner Agent to an Ownership Relation"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:OwnershipRelation ;
    rdfs:subPropertyOf ns1:agentIsSourceOfAuthorityRelation ;
    owl:inverseOf ns1:ownershipRelationHasSource .

ns1:agentIsSourceOfRecordResourceHoldingRelation a owl:ObjectProperty ;
    rdfs:label "agent is source of record resource holding relation "@en ;
    rdfs:comment "Connects an Agent that holds a Record Resource or Instantiation,\\n            to a Record Resource Holding Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResourceHoldingRelation ;
    rdfs:subPropertyOf ns1:agentIsSourceOfManagementRelation ;
    owl:inverseOf ns1:recordResourceHoldingRelationHasSource .

ns1:agentIsTargetOfAccumulationRelation a owl:ObjectProperty ;
    rdfs:label "agent is target of accumulation relation "@en ;
    rdfs:comment "Connects one of the accumulating Agents to an Accumulation\\n            Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AccumulationRelation ;
    rdfs:subPropertyOf ns1:agentIsTargetOfAgentOriginationRelation ;
    owl:inverseOf ns1:accumulationRelationHasTarget .

ns1:agentIsTargetOfAuthorshipRelation a owl:ObjectProperty ;
    rdfs:label "agent is target of authorship relation"@en ;
    rdfs:comment "Connects a Person, Group or Position to an Authorship\\n            Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AuthorshipRelation ;
    rdfs:subPropertyOf ns1:agentIsTargetOfCreationRelation ;
    owl:inverseOf ns1:authorshipRelationHasTarget ;
    skos:changeNote [ dc:date "2020-12-29" ;
            rdf:value "Created following the addition of RiC-R079 relation in\\n                    RiC-CM 0.2"@en ] .

ns1:agentIsTargetOfMandateRelation a owl:ObjectProperty ;
    rdfs:label "agent is target of mandate relation "@en ;
    rdfs:comment "Connects a mandated Agent to a Mandate Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:MandateRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRuleRelation ;
    owl:inverseOf ns1:mandateRelationHasTarget .

ns1:agentIsTargetOfPerformanceRelation a owl:ObjectProperty ;
    rdfs:label "agent is target of performance relation "@en ;
    rdfs:comment "Connects an Agent to a Performance Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PerformanceRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:performanceRelationHasTarget .

ns1:appellationRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "appellation relation has target "@en ;
    rdfs:comment "Connects an Appellation Relation to one of the designated\\n            Things"@en ;
    rdfs:domain ns1:AppellationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfAppellationRelation .

ns1:authorizes a owl:ObjectProperty ;
    rdfs:label "authorizes"@en ;
    rdfs:comment "Connects a Mandate to the Agent that the Mandate gives the\\n            authority or competencies to act."@en ;
    rdfs:domain ns1:Mandate ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isRuleAssociatedWith ;
    owl:inverseOf ns1:authorizedBy ;
    owl:propertyChainAxiom ( ns1:mandateIsSourceOfMandateRelation ns1:mandateRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "fixed the CM corresponding component name."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R067 ('authorizes'\\n            relation)"@en .

ns1:authorizingAgent a owl:ObjectProperty ;
    rdfs:label "authorizing agent "@en ;
    rdfs:comment "Connects a Mandate Relation to an Agent that assigns the\\n            Mandate."@en ;
    rdfs:domain ns1:MandateRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:relationHasContext ;
    owl:inverseOf ns1:isAuthorizingAgentInMandateRelation .

ns1:beginningDate a owl:DatatypeProperty ;
    rdfs:label "beginning date"@en ;
    rdfs:comment "Date at which something began."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:date ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:childRelationHasSource a owl:ObjectProperty ;
    rdfs:label "child relation has source "@en ;
    rdfs:comment "Connects a Child Relation to a parent Person"@en ;
    rdfs:domain ns1:ChildRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:descendanceRelationHasSource ;
    owl:inverseOf ns1:personIsSourceOfChildRelation .

ns1:creationWithRole a owl:ObjectProperty ;
    rdfs:label "creation with role "@en ;
    rdfs:comment "Connects a Creation Relation to the Role Type that the creator\\n            Agent(s) has in the creation process"@en ;
    rdfs:domain ns1:CreationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RoleType ;
    rdfs:subPropertyOf ns1:relationHasContext ;
    owl:inverseOf ns1:roleIsContextOfCreationRelation .

ns1:endDate a owl:DatatypeProperty ;
    rdfs:label "end date"@en ;
    rdfs:comment "Date at which something ended."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ns1:date ;
    skos:scopeNote "Provided for usability reasons. May be deprecated and removed\\n            later on. Use only if you don't use Date classes for handling dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property specialized implementation of\\n            RiC-E18 (Date entity)"@en .

ns1:eventIsSourceOfEventRelation a owl:ObjectProperty ;
    rdfs:label "event is source of event relation "@en ;
    rdfs:comment "Connects an Event to an Event Relation"@en ;
    rdfs:domain ns1:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:EventRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:eventRelationHasSource .

ns1:followsOrFollowed a owl:ObjectProperty ;
    rdfs:label "follows or followed"@en ;
    rdfs:comment "Inverse of 'precedesOrPreceded' object property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:precedesOrPreceded ;
    owl:propertyChainAxiom ( ns1:thingIsTargetOfSequentialRelation ns1:sequentialRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"follows\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R008i ('follows or followed'\\n            relation)"@en .

ns1:groupIsSourceOfGroupSubdivisionRelation a owl:ObjectProperty ;
    rdfs:label "group is source of group subdivision relation "@en ;
    rdfs:comment "Connects the Group that has at least a subdivision, to a Group\\n            Subdivision Relation"@en ;
    rdfs:domain ns1:Group ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:GroupSubdivisionRelation ;
    rdfs:subPropertyOf ns1:agentIsSourceOfAgentHierarchicalRelation,
        ns1:thingIsSourceOfWholePartRelation ;
    owl:inverseOf ns1:groupSubdivisionRelationHasSource .

ns1:groupIsSourceOfMembershipRelation a owl:ObjectProperty ;
    rdfs:label "group is source of membership relation "@en ;
    rdfs:comment "Connects the Group (that has one to many members) to a\\n            Membership Relation"@en ;
    rdfs:domain ns1:Group ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:MembershipRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:membershipRelationHasSource .

ns1:groupIsTargetOfGroupSubdivisionRelation a owl:ObjectProperty ;
    rdfs:label "group is target of group subdivision relation "@en ;
    rdfs:comment "Connects a Group that is a subdivision, to a Group Subdivision\\n            Relation"@en ;
    rdfs:domain ns1:Group ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:GroupSubdivisionRelation ;
    rdfs:subPropertyOf ns1:agentIsTargetOfAgentHierarchicalRelation,
        ns1:thingIsTargetOfWholePartRelation ;
    owl:inverseOf ns1:groupSubdivisionRelationHasTarget .

ns1:groupIsTargetOfLeadershipRelation a owl:ObjectProperty ;
    rdfs:label "group is target of leadership relation "@en ;
    rdfs:comment "Connects a Group (which has a leader) to a Leadership\\n            Relation"@en ;
    rdfs:domain ns1:Group ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:LeadershipRelation ;
    rdfs:subPropertyOf ns1:agentIsTargetOfAgentControlRelation ;
    owl:inverseOf ns1:leadershipRelationHasTarget .

ns1:hasActivityType a owl:ObjectProperty ;
    rdfs:label "has activity type"@en ;
    rdfs:comment "Connects an Activity to an Activity Type that categorizes\\n            it."@en ;
    rdfs:domain ns1:Activity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ActivityType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isActivityTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ] .

ns1:hasAncestor a owl:ObjectProperty ;
    rdfs:label "has ancestor"@en ;
    rdfs:comment "Inverse of 'has descendant' object property."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:hasFamilyAssociationWith,
        ns1:isSuccessorOf ;
    owl:inverseOf ns1:hasDescendant ;
    owl:propertyChainAxiom ( ns1:personIsTargetOfDescendanceRelation ns1:descendanceRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRIs."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R017i (has ancestor\\n            relation)"@en .

ns1:hasCarrierType a owl:ObjectProperty ;
    rdfs:label "has carrier type"@en ;
    rdfs:comment "Connects an Instantiation to a Carrier Type which categorizes\\n            its carrier."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CarrierType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isCarrierTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ] .

ns1:hasCreator a owl:ObjectProperty ;
    rdfs:label "has creator"@en ;
    rdfs:comment "Connects a Record Resource or an Instantiation to an Agent that\\n            is either responsible for all or some of the content of the Record Resource or is a\\n            contributor to the genesis or production of an Instantiation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:hasProvenance ;
    owl:inverseOf ns1:isCreatorOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI and label (changed made in order to make\\n                    RiC-O compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"createdBy\")."@en ] ;
    skos:scopeNote "Covers the definition of author in diplomatics, and any\\n            contribution to the intellectual content of a Record Resource."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R027 ('has creator'\\n            relation)"@en .

ns1:hasDerivedInstantiation a owl:ObjectProperty ;
    rdfs:label "has derived instantiation "@en ;
    rdfs:comment "Connects an Instantiation to an Instantiation that is derived\\n            from it."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:isInstantiationAssociatedWithInstantiation,
        ns1:precedesInTime ;
    owl:inverseOf ns1:isDerivedFromInstantiation ;
    owl:propertyChainAxiom ( ns1:instantiationIsSourceOfDerivationRelation ns1:derivationRelationHasTarget ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R014 ('has derived instantiation'\\n            relation)"@en .

ns1:hasDescendant a owl:ObjectProperty ;
    rdfs:label "has descendant"@en ;
    rdfs:comment "Connects a Person to one of their descendants."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:hasFamilyAssociationWith,
        ns1:hasSuccessor ;
    owl:inverseOf ns1:hasAncestor ;
    owl:propertyChainAxiom ( ns1:personIsSourceOfDescendanceRelation ns1:descendanceRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperties IRIs."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R017 ('has descendant'\\n            relation)"@en .

ns1:hasEventType a owl:ObjectProperty ;
    rdfs:label "has event type"@en ;
    rdfs:comment "Connects an Event to an Event Type which categorizes\\n            it."@en ;
    rdfs:domain ns1:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:EventType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isEventTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ] .

ns1:hasIdentifierType a owl:ObjectProperty ;
    rdfs:label "has identifier type"@en ;
    rdfs:comment "Connects an Identifier and an Identifier Type that categorizes\\n            it."@en ;
    rdfs:domain ns1:Identifier ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:IdentifierType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isIdentifierTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ],
        [ dc:date "2020-10-19" ;
            rdf:value "Object property added along with IdentifierType class and\\n                    isIdentifierTypeOf object property. "@en ] .

ns1:hasInstantiation a owl:ObjectProperty ;
    rdfs:label "has instantiation"@en ;
    rdfs:comment "Connects a Record Resource to one of its\\n            Instantiations."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isInstantiationOf ;
    owl:propertyChainAxiom ( ns1:recordResourceIsSourceOfRecordResourceToInstantiationRelation ns1:recordResourceToInstantiationRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the inverse property IRI."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R025 ('has instantiation'\\n            relation)"@en .

ns1:hasModificationDate a owl:ObjectProperty ;
    rdfs:label "has modification date "@en ;
    rdfs:comment "Inverse of 'is modification date of' object\\n            property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Date ;
    rdfs:subPropertyOf ns1:isAssociatedWithDate ;
    owl:inverseOf ns1:isModificationDateOf ;
    ns1:RiCCMCorrespondingComponent "RiC-R073i ('has modification date'\\n            relation)"@en .

ns1:hasOrHadController a owl:ObjectProperty ;
    rdfs:label "has or had controller"@en ;
    rdfs:comment "Inverse of 'is or was controller of' object\\n            property."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isOrWasSubordinateTo,
        ns1:isOrWasUnderAuthorityOf ;
    owl:inverseOf ns1:isOrWasControllerOf ;
    owl:propertyChainAxiom ( ns1:agentIsTargetOfAgentControlRelation ns1:agentControlRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"controlledBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R041i ('has or had controller'\\n            relation)"@en .

ns1:hasOrHadCoordinates a owl:ObjectProperty ;
    rdfs:label "has coordinates"@en ;
    rdfs:comment "Connects a Physical Location to its past or present coordinates\\n            in a reference system."@en ;
    rdfs:domain ns1:PhysicalLocation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Coordinates ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isOrWasCoordinatesOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"hasCoordinates\")."@en ] .

ns1:hasOrHadDemographicGroup a owl:ObjectProperty ;
    rdfs:label "has or had demographic group"@en ;
    rdfs:comment "Connects a Person or a Group to a Demographic Group to which it\\n            belongs or belonged."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:DemographicGroup ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isOrWasDemographicGroupOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, domain (the name of this property in RiC-O 0.1 was\\n                    \"belongsToDemographicGroup\")."@en ] .

ns1:hasOrHadManager a owl:ObjectProperty ;
    rdfs:label "has or had manager"@en ;
    rdfs:comment "Inverse of 'is or was manager of' object\\n            property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isOrWasUnderAuthorityOf ;
    owl:inverseOf ns1:isOrWasManagerOf ;
    owl:propertyChainAxiom ( ns1:recordResourceOrInstantiationIsTargetOfManagementRelation ns1:managementRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, super property IRI (changed made in order to make RiC-O compliant\\n                    with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"managedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R038i ('is or was managed by'\\n            relation)"@en .

ns1:hasOrHadOccupationOfType a owl:ObjectProperty ;
    rdfs:label "has or had occupation of type"@en ;
    rdfs:comment "Connects a Person to an Occupation Type that categorized or\\n            categorizes his/her occupation (profession, trade or craft)."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:OccupationType ;
    rdfs:subPropertyOf ns1:hasOrHadDemographicGroup ;
    owl:inverseOf ns1:isOrWasOccupationTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition, super property IRI (the name of this property in RiC-O 0.1 was\\n                    \"hasOccupationOfType\")."@en ] .

ns1:hasOrHadPhysicalLocation a owl:ObjectProperty ;
    rdfs:label "has or had physical location"@en ;
    rdfs:comment "Connects a Place to one of its past or present Physical\\n            Location."@en ;
    rdfs:domain ns1:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PhysicalLocation ;
    rdfs:subPropertyOf ns1:isPlaceAssociatedWith ;
    owl:inverseOf ns1:isOrWasPhysicalLocationOf ;
    skos:changeNote [ dc:date "2021-02-01" ;
            rdf:value "Property made a subproperty of\\n                    'isPlaceAssociatedWith\"."@en ],
        [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"hasPhysicalLocation\")."@en ] .

ns1:hasOrHadRuleType a owl:ObjectProperty ;
    rdfs:label "has or had rule type"@en ;
    rdfs:comment "Connects a Rule to a Rule Type that categorized or categorizes\\n            it."@en ;
    rdfs:domain ns1:Rule ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RuleType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isOrWasRuleTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, super property IRI (the name of this property in RiC-O 0.1 was\\n                    \"hasRuleType\")."@en ],
        [ dc:date "2020-10-19" ;
            rdf:value "Object property added along with RuleType class and\\n                    isRuleTypeOf object property. "@en ] .

ns1:hasProductionTechniqueType a owl:ObjectProperty ;
    rdfs:label "has production technique type"@en ;
    rdfs:comment "Connects an Instantiation to a Production Technique Type that\\n            categorizes its production technique."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ProductionTechniqueType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isProductionTechniqueTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the super property IRI."@en ] .

ns1:hasRecordSetType a owl:ObjectProperty ;
    rdfs:label "has record set type"@en ;
    rdfs:comment "Connects a Record Set to a Record Set Type that categorizes\\n            it."@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordSetType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isRecordSetTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the super property IRI."@en ] .

ns1:hasRepresentationType a owl:ObjectProperty ;
    rdfs:label "has representation type"@en ;
    rdfs:comment "Connects an Instantiation to a Representation Type that\\n            categorizes its representation type."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RepresentationType ;
    rdfs:subPropertyOf ns1:hasOrHadCategory ;
    owl:inverseOf ns1:isRepresentationTypeOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the super property IRI."@en ] .

ns1:hasSuccessor a owl:ObjectProperty ;
    rdfs:label "has successor"@en ;
    rdfs:comment "Connects an Agent to another Agent that succeeds it\\n            chronologically."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent,
        ns1:precedesInTime ;
    owl:inverseOf ns1:isSuccessorOf ;
    owl:propertyChainAxiom ( ns1:agentIsSourceOfAgentTemporalRelation ns1:agentTemporalRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI and label (changed made in order to make\\n                    RiC-O compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"isAntecedentOf\")."@en ] ;
    skos:scopeNote "There may be zero to many intermediate Agents , ignored or\\n            unknown, between the two connected Agents. Can be used when there is a transfer of\\n            function from the first Agent to the second Agent."@en ;
    ns1:RiCCMCorrespondingComponent "RIC-R016 ('has successor'\\n            relation)"@en .

ns1:instantiationIsConnectedToFunctionalEquivalenceRelation a owl:ObjectProperty ;
    rdfs:label "instantiation is connected to functional equivalence relation\\n        "@en ;
    rdfs:comment "Connects an Instantiation to a Functional Equivalence\\n            Relation"@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:FunctionalEquivalenceRelation ;
    rdfs:subPropertyOf ns1:instantiationIsConnectedToInstantiationRelation ;
    owl:inverseOf ns1:functionalEquivalenceRelationConnects .

ns1:instantiationIsSourceOfMigrationRelation a owl:ObjectProperty ;
    rdfs:label "instantiation is source of migration relation "@en ;
    rdfs:comment "Connects an Instantiation (from which at least one Instantiation\\n            is migrated) to a Migration Relation."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:MigrationRelation ;
    rdfs:subPropertyOf ns1:instantiationIsSourceOfDerivationRelation ;
    owl:inverseOf ns1:migrationRelationHasSource .

ns1:instantiationIsTargetOfDerivationRelation a owl:ObjectProperty ;
    rdfs:label "instantiation is target of derivation relation "@en ;
    rdfs:comment "Connects a derived Instantiation to a Derivation\\n            Relation."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:DerivationRelation ;
    rdfs:subPropertyOf ns1:instantiationIsConnectedToInstantiationRelation,
        ns1:thingIsTargetOfRelation,
        ns1:thingIsTargetOfTemporalRelation ;
    owl:inverseOf ns1:derivationRelationHasTarget .

ns1:instantiationIsTargetOfMigrationRelation a owl:ObjectProperty ;
    rdfs:label "instantiation is target of migration relation "@en ;
    rdfs:comment "Connects an Instantiation which results from a migration, to a\\n            Migration Relation."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:MigrationRelation ;
    rdfs:subPropertyOf ns1:instantiationIsTargetOfDerivationRelation ;
    owl:inverseOf ns1:migrationRelationHasTarget .

ns1:instantiationIsTargetOfRecordResourceToInstantiationRelation a owl:ObjectProperty ;
    rdfs:label "instantiation is target of record resource to instantiation\\n            relation "@en ;
    rdfs:comment "Connects an Instantiation of a Record Resource to the Record\\n            Resource to Instantiation Relation."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResourceToInstantiationRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:recordResourceToInstantiationRelationHasTarget .

ns1:isActivityTypeOf a owl:ObjectProperty ;
    rdfs:label "is activity type of"@en ;
    rdfs:comment "Connects an Activity Type to an Activity that it\\n            categorizes."@en ;
    rdfs:domain ns1:ActivityType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Activity ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasActivityType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the super property IRI."@en ] .

ns1:isBeginningDateOf a owl:ObjectProperty ;
    rdfs:label "is beginning date of "@en ;
    rdfs:comment "Connects a Date to a Thing that came into existence on that\\n            Date."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isDateAssociatedWith ;
    owl:inverseOf ns1:hasBeginningDate ;
    ns1:RiCCMCorrespondingComponent "RiC-R069 ('is beginning date of'\\n            relation)"@en .

ns1:isCarrierTypeOf a owl:ObjectProperty ;
    rdfs:label "is carrier type of"@en ;
    rdfs:comment "Connects a Carrier Type to an Instantiation whose carrier it\\n            categorizes."@en ;
    rdfs:domain ns1:CarrierType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasCarrierType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "Changed the super property IRI."@en ] .

ns1:isContentTypeOf a owl:ObjectProperty ;
    rdfs:label "is content type of"@en ;
    rdfs:comment "Connects a Content Type to a Record or Record Part whose content\\n            it categorizes."@en ;
    rdfs:domain ns1:ContentType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasContentOfType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the text definition and super property\\n                    IRI."@en ] .

ns1:isCreatorOf a owl:ObjectProperty ;
    rdfs:label "is creator of"@en ;
    rdfs:comment "Inverse of 'has creator' object property."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:isProvenanceOf ;
    owl:inverseOf ns1:hasCreator ;
    owl:propertyChainAxiom ( ns1:agentIsTargetOfCreationRelation ns1:creationRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "change the inverse property IRI."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R027i ('is creator of\\n            'relation')"@en .

ns1:isDerivedFromInstantiation a owl:ObjectProperty ;
    rdfs:label "is derived from instantiation "@en ;
    rdfs:comment "Inverse of 'has derived instantiation' object\\n            property."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:followsInTime,
        ns1:isInstantiationAssociatedWithInstantiation ;
    owl:inverseOf ns1:hasDerivedInstantiation ;
    ns1:RiCCMCorrespondingComponent "RiC-R014i ('is derived from instantiation'\\n            relation)"@en .

ns1:isDocumentaryFormTypeOf a owl:ObjectProperty ;
    rdfs:label "is documentary form type of"@en ;
    rdfs:comment "Connects a Documentary Form Type to a Record or Record Part that\\n            it categorizes."@en ;
    rdfs:domain ns1:DocumentaryFormType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasDocumentaryFormType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ] .

ns1:isEndDateOf a owl:ObjectProperty ;
    rdfs:label "is end date of "@en ;
    rdfs:comment "Connects a Date to a Thing whose existence ended on that\\n            Date."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isDateAssociatedWith ;
    owl:inverseOf ns1:hasEndDate ;
    ns1:RiCCMCorrespondingComponent "RiC-R071 ('is end date\\n            of')"@en .

ns1:isEventTypeOf a owl:ObjectProperty ;
    rdfs:label "is event type of"@en ;
    rdfs:comment "Connects an Event Type to an Event that is\\n            categorizes."@en ;
    rdfs:domain ns1:EventType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Event ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasEventType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ] .

ns1:isFamilyTypeOf a owl:ObjectProperty ;
    rdfs:label "is family type of"@en ;
    rdfs:comment "Connects a Family Type to a Family that is\\n            categorizes."@en ;
    rdfs:domain ns1:FamilyType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Family ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasFamilyType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ] .

ns1:isIdentifierTypeOf a owl:ObjectProperty ;
    rdfs:label "is identifier type of"@en ;
    rdfs:comment "Connects an Identifier Type and an Identifier that it\\n            categorizes."@en ;
    rdfs:domain ns1:IdentifierType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Identifier ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasIdentifierType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ],
        [ dc:date "2020-10-19" ;
            rdf:value "Object property added along with IdentifierType class and\\n                    hasIdentifierType object property. "@en ] .

ns1:isModificationDateOf a owl:ObjectProperty ;
    rdfs:label "is modification date of "@en ;
    rdfs:comment "Connects a Date to a Thing that was modified on that\\n            Date."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isDateAssociatedWith ;
    owl:inverseOf ns1:hasModificationDate ;
    ns1:RiCCMCorrespondingComponent "RiC-R073 ('is modification date of'\\n            relation)"@en .

ns1:isOrWasControllerOf a owl:ObjectProperty ;
    rdfs:label "is or was controller of"@en ;
    rdfs:comment "Connects an Agent to another Agent it controls or controlled via\\n            Activities, i.e. controls by function."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:hasOrHadAuthorityOver,
        ns1:hasOrHadSubordinate ;
    owl:inverseOf ns1:hasOrHadController ;
    owl:propertyChainAxiom ( ns1:agentIsSourceOfAgentControlRelation ns1:agentControlRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"controls\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R041 ('is or was controller of'\\n            relation)"@en .

ns1:isOrWasCoordinatesOf a owl:ObjectProperty ;
    rdfs:label "is or was coordinates of"@en ;
    rdfs:comment "Connects an instance of Coordinates to a Physical Location it\\n            locates or located on earth, according to some reference system."@en ;
    rdfs:domain ns1:Coordinates ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PhysicalLocation ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasOrHadCoordinates ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"isCoordinatesOf\")."@en ] .

ns1:isOrWasCorporateBodyTypeOf a owl:ObjectProperty ;
    rdfs:label "is or was corporate body type of"@en ;
    rdfs:comment "Connects a Corporate Body Type to a Corporate Body that it\\n            categorizes or categorized."@en ;
    rdfs:domain ns1:CorporateBodyType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CorporateBody ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasOrHadCorporateBodyType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"isCorporateBodyTypeOf\")."@en ] .

ns1:isOrWasDemographicGroupOf a owl:ObjectProperty ;
    rdfs:label "is or was demographic group of"@en ;
    rdfs:comment "Connects a Demographic Group to a Person or Group which belongs\\n            or belonged to it."@en ;
    rdfs:domain ns1:DemographicGroup ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ) ] ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasOrHadDemographicGroup ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, range (the name of this property in RiC-O 0.1 was\\n                    \"isDemographicGroupOf\")."@en ] .

ns1:isOrWasManagerOf a owl:ObjectProperty ;
    rdfs:label "is or was manager of"@en ;
    rdfs:comment "Connects an Agent to a Record Resource or Instantiation that the\\n            Agent managed or manages."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:hasOrHadAuthorityOver ;
    owl:inverseOf ns1:hasOrHadManager ;
    owl:propertyChainAxiom ( ns1:agentIsSourceOfManagementRelation ns1:managementRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, super\\n                    property IRI, textual definition (changed made in order to make RiC-O compliant\\n                    with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"isManagerOf\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R038 ('is or was manager of'\\n            relation)"@en .

ns1:isOrWasOccupationTypeOf a owl:ObjectProperty ;
    rdfs:label "is or was occupation type of"@en ;
    rdfs:comment "Connects an Occupation Type to a Person whose occupation is or\\n            was categorized by it."@en ;
    rdfs:domain ns1:OccupationType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:isOrWasDemographicGroupOf ;
    owl:inverseOf ns1:hasOrHadOccupationOfType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition, super property IRI (the name of this property in RiC-O 0.1 was\\n                    \"isOccupationTypeOf\")."@en ] .

ns1:isOrWasPerformedBy a owl:ObjectProperty ;
    rdfs:label "is or was performed by"@en ;
    rdfs:comment "Connects an Activity to an Agent that performed or performs the\\n            Activity."@en ;
    rdfs:domain ns1:Activity ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:hasOrHadParticipant ;
    owl:inverseOf ns1:performsOrPerformed ;
    owl:propertyChainAxiom ( ns1:activityIsSourceOfPerformanceRelation ns1:performanceRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, super property IRI (changed made in order to make RiC-O compliant\\n                    with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"performedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R060 ('is or was performed by'\\n            relation)"@en .

ns1:isOrWasPhysicalLocationOf a owl:ObjectProperty ;
    rdfs:label "is or was physical location of"@en ;
    rdfs:comment "Connects a Physical Location to a Place, when it is or was its\\n            location."@en ;
    rdfs:domain ns1:PhysicalLocation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Place ;
    rdfs:subPropertyOf ns1:isAssociatedWithPlace ;
    owl:inverseOf ns1:hasOrHadPhysicalLocation ;
    skos:changeNote [ dc:date "2021-02-01" ;
            rdf:value "Property made a subproperty of\\n                    'isAssociatedWithPlace\"."@en ],
        [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"isPhysicalLocationOf\")."@en ] .

ns1:isOrWasPlaceTypeOf a owl:ObjectProperty ;
    rdfs:label "is or was place type of"@en ;
    rdfs:comment "Connects a Place Type to a Place that is or was categorized by\\n            it."@en ;
    rdfs:domain ns1:PlaceType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Place ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasOrHadPlaceType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, super property IRI (the name of this property in RiC-O 0.1 was\\n                    \"isPlaceTypeOf\")."@en ] .

ns1:isOrWasRuleTypeOf a owl:ObjectProperty ;
    rdfs:label "is or was rule type of"@en ;
    rdfs:comment "connects a Rule Type to a Rule that it categorized or\\n            categorizes."@en ;
    rdfs:domain ns1:RuleType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Rule ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasOrHadRuleType ;
    skos:changeNote [ dc:date "2020-10-19" ;
            rdf:value "Object property added along with RuleType class and\\n                    hasRuleType object property. "@en ],
        [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, super property URI (the name of this property in RiC-O 0.1 was\\n                    \"isRuleTypeOf\")."@en ] .

ns1:isProductionTechniqueTypeOf a owl:ObjectProperty ;
    rdfs:label "is production technique type of"@en ;
    rdfs:comment "Connects a Production Technique Type to an Instantiation whose\\n            production technique is categorized by it."@en ;
    rdfs:domain ns1:ProductionTechniqueType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasProductionTechniqueType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the super property IRI."@en ] .

ns1:isRecordSetTypeOf a owl:ObjectProperty ;
    rdfs:label "is record set type of"@en ;
    rdfs:comment "Connects a Record Set Type to a Record Set that it\\n            categorizes."@en ;
    rdfs:domain ns1:RecordSetType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordSet ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasRecordSetType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the super property IRI."@en ] .

ns1:isRepresentationTypeOf a owl:ObjectProperty ;
    rdfs:label "is representation type of"@en ;
    rdfs:comment "Connects a Representation Type to an Instantiation that it\\n            categorizes."@en ;
    rdfs:domain ns1:RepresentationType ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:isOrWasCategoryOf ;
    owl:inverseOf ns1:hasRepresentationType ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the super property IRI."@en ] .

ns1:isSuccessorOf a owl:ObjectProperty ;
    rdfs:label "is successor of"@en ;
    rdfs:comment "Inverse of 'has successor' object property."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:followsInTime,
        ns1:isAgentAssociatedWithAgent ;
    owl:inverseOf ns1:hasSuccessor ;
    owl:propertyChainAxiom ( ns1:agentIsTargetOfAgentTemporalRelation ns1:agentTemporalRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the inverse property IRI and the text\\n                    definition."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R016i (is successor\\n            of)"@en .

ns1:leadershipWithPosition a owl:ObjectProperty ;
    rdfs:label "leadership with position "@en ;
    rdfs:comment "Connects a Leadership Relation to the Position occupied by the\\n            leading Person."@en ;
    rdfs:domain ns1:LeadershipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Position ;
    rdfs:subPropertyOf ns1:relationHasContext ;
    owl:inverseOf ns1:positionIsContextOfLeadershipRelation .

ns1:mandateIsSourceOfMandateRelation a owl:ObjectProperty ;
    rdfs:label "mandate is source of mandate relation "@en ;
    rdfs:comment "Connects a Mandate to a Mandate Relation."@en ;
    rdfs:domain ns1:Mandate ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:MandateRelation ;
    rdfs:subPropertyOf ns1:ruleIsSourceOfRuleRelation ;
    owl:inverseOf ns1:mandateRelationHasSource .

ns1:membershipWithPosition a owl:ObjectProperty ;
    rdfs:label "membership with position "@en ;
    rdfs:comment "Connects a Membership Relation to the Position occupied by the\\n            member Person(s)."@en ;
    rdfs:domain ns1:MembershipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Position ;
    rdfs:subPropertyOf ns1:relationHasContext ;
    owl:inverseOf ns1:positionIsContextOfMembershipRelation .

ns1:personHasCorrespondenceRelation a owl:ObjectProperty ;
    rdfs:label "person has correspondence relation "@en ;
    rdfs:comment "Connects a Person to a Correspondence Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CorrespondenceRelation ;
    rdfs:subPropertyOf ns1:personHasKnowingRelation ;
    owl:inverseOf ns1:correspondenceRelationConnects .

ns1:personHasSiblingRelation a owl:ObjectProperty ;
    rdfs:label "person has sibling relation "@en ;
    rdfs:comment "Connects a Person to a Sibling Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:SiblingRelation ;
    rdfs:subPropertyOf ns1:personHasFamilyRelation ;
    owl:inverseOf ns1:siblingRelationConnects .

ns1:personHasSpouseRelation a owl:ObjectProperty ;
    rdfs:label "person has spouse relation "@en ;
    rdfs:comment "Connects a Person to a Spouse Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:SpouseRelation ;
    rdfs:subPropertyOf ns1:personHasFamilyRelation ;
    owl:inverseOf ns1:spouseRelationConnects .

ns1:personIsSourceOfChildRelation a owl:ObjectProperty ;
    rdfs:label "person is source of child relation "@en ;
    rdfs:comment "Connects a Person (as a parent) to a Child\\n            Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ChildRelation ;
    rdfs:subPropertyOf ns1:personIsSourceOfDescendanceRelation ;
    owl:inverseOf ns1:childRelationHasSource .

ns1:personIsSourceOfKnowingOfRelation a owl:ObjectProperty ;
    rdfs:label "person is source of knowing of relation "@en ;
    rdfs:comment "Connects a Person (who has some knowledge of another one) to a\\n            Knowing Of Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:KnowingOfRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:knowingOfRelationHasSource .

ns1:personIsSourceOfLeadershipRelation a owl:ObjectProperty ;
    rdfs:label "person is source of leadership relation "@en ;
    rdfs:comment "Connects a Person (as a leader) to a Leadership\\n            Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:LeadershipRelation ;
    rdfs:subPropertyOf ns1:agentIsSourceOfAgentControlRelation ;
    owl:inverseOf ns1:leadershipRelationHasSource .

ns1:personIsSourceOfPositionHoldingRelation a owl:ObjectProperty ;
    rdfs:label "person is source of position holding relation "@en ;
    rdfs:comment "Connects a Person (who occupies a Position) to a Position\\n            Holding Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PositionHoldingRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:positionHoldingRelationHasSource .

ns1:personIsSourceOfTeachingRelation a owl:ObjectProperty ;
    rdfs:label "person is source of teaching relation "@en ;
    rdfs:comment "Connects a Person (as a teacher) to a Teaching\\n            Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:TeachingRelation ;
    rdfs:subPropertyOf ns1:personHasKnowingRelation,
        ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:teachingRelationHasSource .

ns1:personIsTargetOfKnowingOfRelation a owl:ObjectProperty ;
    rdfs:label "person is target of knowing of relation "@en ;
    rdfs:comment "Connects a Person (of which another Person has some knowledge)\\n            to a Knowing Of Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:KnowingOfRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:knowingOfRelationHasTarget .

ns1:personIsTargetOfMembershipRelation a owl:ObjectProperty ;
    rdfs:label "person is target of membership relation "@en ;
    rdfs:comment "Connects a Person (as a member of a Group) to a Membership\\n            Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:MembershipRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:membershipRelationHasTarget .

ns1:personIsTargetOfTeachingRelation a owl:ObjectProperty ;
    rdfs:label "person is target of teaching relation "@en ;
    rdfs:comment "Connects a Person (as a student) to a Teaching\\n            Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:TeachingRelation ;
    rdfs:subPropertyOf ns1:personHasKnowingRelation,
        ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:teachingRelationHasTarget .

ns1:placeIsSourceOfPlaceRelation a owl:ObjectProperty ;
    rdfs:label "place is source of place relation "@en ;
    rdfs:comment "Connects a Place (as associated to a Thing) to a Place\\n            Relation."@en ;
    rdfs:domain ns1:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PlaceRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:placeRelationHasSource .

ns1:positionIsSourceOfPositionToGroupRelation a owl:ObjectProperty ;
    rdfs:label "position is source of position to group relation "@en ;
    rdfs:comment "Connects a Position (that exists within a Group) to a Position\\n            to Group Relation."@en ;
    rdfs:domain ns1:Position ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PositionToGroupRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:positionToGroupRelationHasSource .

ns1:positionIsTargetOfPositionHoldingRelation a owl:ObjectProperty ;
    rdfs:label "position is target of position holding relation "@en ;
    rdfs:comment "Connects a Position (that is occupied by a Person) to a Position\\n            Holding Relation."@en ;
    rdfs:domain ns1:Position ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PositionHoldingRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:positionHoldingRelationHasTarget .

ns1:positionToGroupRelationHasSource a owl:ObjectProperty ;
    rdfs:label "position to group relation has source "@en ;
    rdfs:comment "Connects a Position to Group Relation to a Position (that exists\\n            in a Group)."@en ;
    rdfs:domain ns1:PositionToGroupRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Position ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasSource ;
    owl:inverseOf ns1:positionIsSourceOfPositionToGroupRelation .

ns1:precedesOrPreceded a owl:ObjectProperty ;
    rdfs:label "precedes or preceded"@en ;
    rdfs:comment "Connects a Thing to a Thing that follows or followed it in some\\n            sequence."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:followsOrFollowed ;
    owl:propertyChainAxiom ( ns1:thingIsSourceOfSequentialRelation ns1:sequentialRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition, corresponding CM component name (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"precedes\")."@en ] ;
    skos:scopeNote "The relation does not specify by itself what criteria are used\\n            for ordering the sequence. There may actually be zero to many intermediate Entities,\\n            ignored or unkown, in the sequence between the two connected Things. Can be used, for\\n            example, for specifying that some Record 'precedes' (has next) some Record within a\\n            Record Set."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R008 ('precedes or preceded'\\n            relation)"@en .

ns1:recordIsSourceOfAuthorshipRelation a owl:ObjectProperty ;
    rdfs:label "record is source of authorship relation"@en ;
    rdfs:comment "Connects a Record and an Authorship Relation."@en ;
    rdfs:domain ns1:Record ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AuthorshipRelation ;
    rdfs:subPropertyOf ns1:recordResourceOrInstantiationIsSourceOfCreationRelation ;
    owl:inverseOf ns1:authorshipRelationHasSource ;
    skos:changeNote [ dc:date "2020-12-29" ;
            rdf:value "Created following the addition of RiC-R079 relation in\\n                    RiC-CM 0.2"@en ] .

ns1:recordResourceGeneticRelationConnects a owl:ObjectProperty ;
    rdfs:label "record resource genetic relation connects "@en ;
    rdfs:comment "Connects a Record Resource Genetic Relation to one of the\\n            associated Record Resources."@en ;
    rdfs:domain ns1:RecordResourceGeneticRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:recordResourceRelationConnects ;
    owl:inverseOf ns1:recordResourceIsConnectedToRecordResourceGeneticRelation .

ns1:recordResourceIsSourceOfRecordResourceToInstantiationRelation a owl:ObjectProperty ;
    rdfs:label "record resource is source of record resource to instantiation\\n            relation "@en ;
    rdfs:comment "Connects a Record Resource (that was instantiated) to a Record\\n            Resource To Instantiation Relation"@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResourceToInstantiationRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:recordResourceToInstantiationRelationHasSource .

ns1:recordResourceOrInstantiationIsSourceOfAccumulationRelation a owl:ObjectProperty ;
    rdfs:label "record resource or instantiation is source of accumulation\\n            relation "@en ;
    rdfs:comment "Connects a Record Resource or Instantiation (that is\\n            accumulated) to an Accumulation Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AccumulationRelation ;
    rdfs:subPropertyOf ns1:recordResourceOrInstantiationIsSourceOfAgentOriginationRelation ;
    owl:inverseOf ns1:accumulationRelationHasSource .

ns1:recordResourceOrInstantiationIsSourceOfActivityDocumentationRelation a owl:ObjectProperty ;
    rdfs:label "record resource or instantiation is source of activity\\n            documentation relation "@en ;
    rdfs:comment "Connects a Record Resource or Instantiation (that documents an\\n            Activity) to an Activity Documentation Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ActivityDocumentationRelation ;
    rdfs:subPropertyOf ns1:recordResourceOrInstantiationIsSourceOfProvenanceRelation ;
    owl:inverseOf ns1:activityDocumentationRelationHasSource .

ns1:recordResourceOrInstantiationIsSourceOfCreationRelation a owl:ObjectProperty ;
    rdfs:label "record resource or instantiation is source of creation relation\\n        "@en ;
    rdfs:comment "Connects a Record Resource or Instantiation (that is created) to\\n            a Creation Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CreationRelation ;
    rdfs:subPropertyOf ns1:recordResourceOrInstantiationIsSourceOfAgentOriginationRelation ;
    owl:inverseOf ns1:creationRelationHasSource .

ns1:recordResourceOrInstantiationIsTargetOfIntellectualPropertyRightsRelation a owl:ObjectProperty ;
    rdfs:label "record resource or instantiation is target of intellectual\\n            property rights relation "@en ;
    rdfs:comment "Connects a Record Resource or Instantiation (on which some\\n            intellectual property rights are held) to an Intellectual Property Rights\\n            Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:IntellectualPropertyRightsRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfAuthorityRelation ;
    owl:inverseOf ns1:intellectualPropertyRightsRelationHasTarget .

ns1:recordResourceOrInstantiationIsTargetOfRecordResourceHoldingRelation a owl:ObjectProperty ;
    rdfs:label "record resource or instantiation is target of record resource\\n            holding relation "@en ;
    rdfs:comment "Connects a Record Resource or Instantiation (that is held by an\\n            Agent) to a Record Resource Holding Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResourceHoldingRelation ;
    rdfs:subPropertyOf ns1:recordResourceOrInstantiationIsTargetOfManagementRelation ;
    owl:inverseOf ns1:recordResourceHoldingRelationHasTarget .

ns1:resultsOrResultedFrom a owl:ObjectProperty ;
    rdfs:label "results or resulted from"@en ;
    rdfs:comment "Inverse of 'results or resulted in' object\\n            property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Event ;
    rdfs:subPropertyOf ns1:isAssociatedWithEvent ;
    owl:inverseOf ns1:resultsOrResultedIn ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"resultsFrom\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R061i ('results or resulted from'\\n            relation)"@en .

ns1:resultsOrResultedIn a owl:ObjectProperty ;
    rdfs:label "results or resulted in"@en ;
    rdfs:comment "Connects an Event to a Thing that results or resulted from the\\n            Event."@en ;
    rdfs:domain ns1:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isEventAssociatedWith ;
    owl:inverseOf ns1:resultsOrResultedFrom ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"resultsIn\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R061 ('results or resulted in'\\n            relation)"@en .

ns1:structure a owl:DatatypeProperty ;
    rdfs:label "structure"@en ;
    rdfs:comment "Information about the intellectual arrangement and composition\\n            of a Record Resource or the physical arrangement and composition of an Instantiation.\\n            For Record and Record Part, it encompasses information about the intellectual\\n            composition of the record, the presence of record parts and their functions. For Record\\n            Set, it encompasses information about the methodology or criteria used for arranging the\\n            Record Set members or Record members within the containing Record Set. For\\n            Instantiation, it may comprise information about the composition of the physical\\n            elements of the instantiation"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:changeNote [ dc:date "2020-11-01" ;
            rdf:value "Text definition updated. Objective: to make RiC-O compliant\\n                    with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Use only if you cannot use the subproperties (particularly if\\n            the same free text is being used in your current metadata for describing the record\\n            resource and the instantiation structure)."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A40 (Structure\\n            attribute)"@en .

ns1:thingIsTargetOfAppellationRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of appellation relation "@en ;
    rdfs:comment "Connects a Thing (that is designated by an Appellation) to an\\n            Appellation Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AppellationRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:appellationRelationHasTarget .

ns1:thingIsTargetOfEventRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of event relation "@en ;
    rdfs:comment "Connects a Thing (that is associated with an Event) to an Event\\n            Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:EventRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:eventRelationHasTarget .

ns1:thingIsTargetOfOwnershipRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of ownership relation "@en ;
    rdfs:comment "Connects a Thing (that is owned by a Group, a Person or a\\n            Position) to an Ownership Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:OwnershipRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfAuthorityRelation ;
    owl:inverseOf ns1:ownershipRelationHasTarget .

ns1:thingIsTargetOfPlaceRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of place relation "@en ;
    rdfs:comment "Connects a Thing (that is associated with a Place) to a Place\\n            Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:PlaceRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:placeRelationHasTarget .

ns1:thingIsTargetOfTypeRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of type relation "@en ;
    rdfs:comment "Connects a Thing (that is categorized by a Type) to a Type\\n            Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:TypeRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:typeRelationHasTarget .

ns1:typeIsSourceOfTypeRelation a owl:ObjectProperty ;
    rdfs:label "type is source of type relation "@en ;
    rdfs:comment "Connects a Type (a category) to a Type Relation."@en ;
    rdfs:domain ns1:Type ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:TypeRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:typeRelationHasSource .

ns1:workRelationConnects a owl:ObjectProperty ;
    rdfs:label "work relation connects "@en ;
    rdfs:comment "Connects a Work Relation to an Agent."@en ;
    rdfs:domain ns1:WorkRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:agentRelationConnects ;
    owl:inverseOf ns1:agentHasWorkRelation .

<https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Documentary Form Types"@en ;
    dc:creator "International Coucil on Archives Expert Group on Archival\\n            Description (ICA EGAD)"@en ;
    dc:title "International Council on Archives Records in Contexts Vocabulary for\\n            Documentary Form Types"@en ;
    skos:definition "A vocabulary that includes documentary form\\n            types"@en .

ns1:CarrierType a owl:Class ;
    rdfs:label "Carrier Type"@en ;
    rdfs:comment "Categorization of physical material in or on which information\\n            is represented."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Instantiation ;
            owl:onProperty ns1:isCarrierTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: updated (quite the same as RiC-CM definition).\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Carrier Type information is essential for assessing\\n            authenticity, conservation needs and the availability, access and use of Record\\n            Resources. Carrier Type determines the environmental conditions of storage and the\\n            prerequisites and possible ways to access and use of the records. Should not be confused\\n            with Content Type, that categorizes a Record Resource, nor with Representation Type that\\n            categorizes an Instantiation. The Carrier Type depends on the media type that is\\n            required to access the records and is independent of its content"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A05 (Carrier Type\\n            attribute)"@en .

ns1:CorporateBody a owl:Class ;
    rdfs:label "Corporate Body"@en ;
    rdfs:comment "An organized group of persons that act together as an Agent, and\\n            that has a recognized legal or social status."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Group ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "scope note: updated. Objective: to make RiC-O compliant\\n                    with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Corporate Body is a kind of Group."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E11 (Corporate Body\\n            entity)"@en .

ns1:DemographicGroup a owl:Class ;
    rdfs:label "Demographic Group"@en ;
    rdfs:comment "Categorization of a person according to characteristics such as\\n            age, gender, education, place of origin, ethnic/cultural identification, religion,\\n            etc."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Type ;
    skos:changeNote [ dc:date "2021-02-08"@en ;
            rdf:value "Removed the Restriction."@en ],
        [ dc:date "2020-10-23" ;
            rdf:value "Comment: updated. Scope note: updated and made several\\n                    paragraphs. Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Can be extended with any number of subclasses, e.g. Age or\\n            Religion. A demographic group may be defined as a subset of the general population.\\n            Individuals may belong to several demographic groups"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A15 (Demographic Group\\n            attribute)"@en .

ns1:EventType a owl:Class ;
    rdfs:label "Event Type"@en ;
    rdfs:comment "Categorization of an Event."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Event ;
            owl:onProperty ns1:isEventTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: updated and made several paragraphs. Objective:\\n                    to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Events of all kinds can be categorized. Curation event types\\n            include creation; acquisition; transfer; arrangement; description; digitization, etc.\\n            Biographical event types include birth, marriage, death, etc."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A18 (Event Type\\n            attribute)"@en .

ns1:Family a owl:Class ;
    rdfs:label "Family"@en ;
    rdfs:comment "Two or more persons related by birth, or through marriage,\\n            adoption, civil union, or other social conventions that bind them together as a socially\\n            recognized familial group."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Group ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs and some\\n                    changes."@en ] ;
    skos:scopeNote "Family is a kind of Group. “Family” is used here as a general\\n            term that encompasses a wide variety of familial groups. Other types of familial groups\\n            include Dynasty, Clan, House, Tribe and others. Though family may be a recognized legal\\n            group in specific contexts, the term may also be used for groups that are socially\\n            recognized as families. A family may be a group of persons related either by\\n            consanguinity or affinity or cohabitation or other social conventions. In some context,\\n            a Family may be legally recognized as Corporate Body. For example, certain North\\n            American peoples (tribes) retain self-government rights and have jurisdiction over\\n            defined tribal lands."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E10 (Family\\n            entity)"@en .

ns1:IdentifierType a owl:Class ;
    rdfs:label "Identifier Type"@en ;
    rdfs:comment "Categorization of an Identifier."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Identifier ;
            owl:onProperty ns1:isIdentifierTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-19" ;
            rdf:value "Class added along with hasIdentifierType and\\n                    isIdentifierTypeOf object properties."@en ] ;
    skos:scopeNote "For example, 'old identifier' ; 'ISNI' (for a person or\\n            corporate body), etc."@en .

ns1:OccupationType a owl:Class ;
    rdfs:label "Occupation Type"@en ;
    rdfs:comment "Categorization of a profession, trade, or craft pursued by a\\n            person in fulfilment of an Activity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Person ;
            owl:onProperty ns1:isOrWasOccupationTypeOf ],
        ns1:ActivityType,
        ns1:DemographicGroup ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "scope note: added."@en ] ;
    skos:scopeNote "Occupation Type should not be confused with Position where,\\n            for example, an Agent with the Occupation Type “lawyer” holds the Position of “legal\\n            counsel” in an agency. Occupation Type is related to, but should not be confused with\\n            the domain or field of Activity (Actvitity Type), such as an archivist who works in the\\n            domain of archival science. Occupation Type is a kind of Demographic\\n            Group."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A30 (Occupation Type\\n            attribute)"@en .

ns1:ProductionTechniqueType a owl:Class ;
    rdfs:label "Production Technique Type"@en ;
    rdfs:comment "Categorization of the method used in the representation of\\n            information on the Instantiation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Instantiation ;
            owl:onProperty ns1:isProductionTechniqueTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Comment: updated. Objective: to make RiC-O compliant with\\n                    RiC-CM v0.2."@en ] ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-A33 (Production\\n            Technique attribute)"@en .

ns1:RecordResourceToRecordResourceRelation a owl:Class ;
    rdfs:label "Record Resource to Record Resource Relation"@en ;
    rdfs:comment "Connects at least two Record Resources."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:RecordResource ;
            owl:onProperty ns1:recordResourceRelationConnects ],
        ns1:Relation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R022 and RiC-022i\\n            relations"@en .

ns1:RepresentationType a owl:Class ;
    rdfs:label "Representation Type"@en ;
    rdfs:comment "Categorization of the method of recording the content type of a\\n            Record Resource."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Instantiation ;
            owl:onProperty ns1:isRepresentationTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Comment and scope note: updated. Objective: to make RiC-O\\n                    compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Representation Type can be unmediated (which allows humans to\\n            receive the message communicated without an intermediation of a device) and mediated\\n            (which needs a device to decode the message). A lot of contemporary mediated types are\\n            digital. Each Representation Type may present specific features: bit rate for audio,\\n            resolution for digital images, encoding format for video etc. Depending of the type,\\n            properties may thus be needed to describe their characteristics. Not be confused with\\n            Content Type or Carrier Type since the form of representation can be independent of the\\n            communication or carrier."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A37 (Representation Type\\n            attribute)"@en .

ns1:RoleType a owl:Class ;
    rdfs:label "Role Type"@en ;
    rdfs:comment "The role an agent plays in some context (usually in some\\n            creation relation). Not to be confused with a position (position of an agent in some\\n            group). For example, a person who is the head of some corporate body may play the role\\n            of annotator (of a record) in a creation relation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Type .

ns1:RuleType a owl:Class ;
    rdfs:label "Rule Type"@en ;
    rdfs:comment "Categorization of a Rule."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Rule ;
            owl:onProperty ns1:isOrWasRuleTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-19" ;
            rdf:value "Class added along with hasRuleType and isRuleTypeOf object\\n                    properties."@en ] ;
    skos:scopeNote "For example, for rules that can be applied to record resources\\n            : access rule, use rule, etc."@en .

ns1:accumulationRelationHasSource a owl:ObjectProperty ;
    rdfs:label "accumulation relation has source "@en ;
    rdfs:comment "Connects an Accumulation Relation to one of the accumulated\\n            Record Resources or Instantiations"@en ;
    rdfs:domain ns1:AccumulationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:agentOriginationRelationHasSource ;
    owl:inverseOf ns1:recordResourceOrInstantiationIsSourceOfAccumulationRelation .

ns1:accumulationRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "accumulation relation has target "@en ;
    rdfs:comment "Connects an Accumulation Relation to one of the accumulating\\n            Agents"@en ;
    rdfs:domain ns1:AccumulationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:agentOriginationRelationHasTarget ;
    owl:inverseOf ns1:agentIsTargetOfAccumulationRelation .

ns1:activityDocumentationRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "activity documentation relation has target "@en ;
    rdfs:comment "Connects an Activity Documentation Relation to one of the\\n            documented Activities"@en ;
    rdfs:domain ns1:ActivityDocumentationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Activity ;
    rdfs:subPropertyOf ns1:provenanceRelationHasTarget ;
    owl:inverseOf ns1:activityIsTargetOfActivityDocumentationRelation .

ns1:agentIsSourceOfAgentControlRelation a owl:ObjectProperty ;
    rdfs:label "agent is source of agent control relation "@en ;
    rdfs:comment "Connects a controlling Agent to an Agent Control\\n            Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentControlRelation ;
    rdfs:subPropertyOf ns1:agentIsSourceOfAgentHierarchicalRelation ;
    owl:inverseOf ns1:agentControlRelationHasSource .

ns1:agentIsSourceOfAgentTemporalRelation a owl:ObjectProperty ;
    rdfs:label "agent is source of agent temporal relation "@en ;
    rdfs:comment "Connects a predecessor Agent to an Agent Temporal\\n            Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentTemporalRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsSourceOfTemporalRelation ;
    owl:inverseOf ns1:agentTemporalRelationHasSource .

ns1:agentIsSourceOfManagementRelation a owl:ObjectProperty ;
    rdfs:label "agent is source of management relation "@en ;
    rdfs:comment "Connects a manager Agent to a Management Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ManagementRelation ;
    rdfs:subPropertyOf ns1:agentIsSourceOfAuthorityRelation ;
    owl:inverseOf ns1:managementRelationHasSource .

ns1:agentIsTargetOfAgentControlRelation a owl:ObjectProperty ;
    rdfs:label "agent is target of agent control relation "@en ;
    rdfs:comment "Connects one of the controlled Agents to an Agent Control\\n            Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentControlRelation ;
    rdfs:subPropertyOf ns1:agentIsTargetOfAgentHierarchicalRelation,
        ns1:thingIsTargetOfAuthorityRelation ;
    owl:inverseOf ns1:agentControlRelationHasTarget .

ns1:agentIsTargetOfAgentTemporalRelation a owl:ObjectProperty ;
    rdfs:label "agent is target of agent temporal relation "@en ;
    rdfs:comment "Connects a successor Agent to an Agent Temporal\\n            Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentTemporalRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsTargetOfTemporalRelation ;
    owl:inverseOf ns1:agentTemporalRelationHasTarget .

ns1:agentIsTargetOfCreationRelation a owl:ObjectProperty ;
    rdfs:label "agent is target of creation relation "@en ;
    rdfs:comment "Connects a creator Agent to a Creation Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:CreationRelation ;
    rdfs:subPropertyOf ns1:agentIsTargetOfAgentOriginationRelation ;
    owl:inverseOf ns1:creationRelationHasTarget .

ns1:agentOrActivityIsTargetOfProvenanceRelation a owl:ObjectProperty ;
    rdfs:label "agent or activity is target of provenance relation "@en ;
    rdfs:comment "Connects an Agent or Activity that is the provenance of a Record\\n            resource or Instantiation, to a Provenance Relation"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Activity ns1:Agent ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ProvenanceRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:provenanceRelationHasTarget .

ns1:appellationRelationHasSource a owl:ObjectProperty ;
    rdfs:label "appellation relation has source "@en ;
    rdfs:comment "Connects an Appellation Relation to the concerned\\n            Appellation"@en ;
    rdfs:domain ns1:AppellationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Appellation ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:appellationIsSourceOfAppellationRelation .

ns1:asConcernsActivity a owl:ObjectProperty ;
    rdfs:label "as concerns activity "@en ;
    rdfs:comment "Connects an Agent Temporal Relation or Mandate Relation, to an\\n            Activity that is, either transferred from an Agent to another one, or assigned by a\\n            Mandate to an Agent."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:AgentTemporalRelation ns1:MandateRelation ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Activity ;
    rdfs:subPropertyOf ns1:relationHasContext ;
    owl:inverseOf ns1:activityIsContextOfRelation .

ns1:authorshipRelationHasSource a owl:ObjectProperty ;
    rdfs:label "authorship relation has source"@en ;
    rdfs:comment "Connects an Authorship Relation to one of the Records involved\\n            in the relation."@en ;
    rdfs:domain ns1:AuthorshipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Record ;
    rdfs:subPropertyOf ns1:creationRelationHasSource ;
    owl:inverseOf ns1:recordIsSourceOfAuthorshipRelation ;
    skos:changeNote [ dc:date "2020-12-29" ;
            rdf:value "Created following the addition of RiC-R079 relation in\\n                    RiC-CM 0.2"@en ] .

ns1:authorshipRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "authorship relation has target"@en ;
    rdfs:comment "Connects an Authorship Relation to one of the author Person,\\n            Group or Position."@en ;
    rdfs:domain ns1:AuthorshipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
    rdfs:subPropertyOf ns1:creationRelationHasTarget ;
    owl:inverseOf ns1:agentIsTargetOfAuthorshipRelation ;
    skos:changeNote [ dc:date "2020-12-29" ;
            rdf:value "Created following the addition of RiC-R079 relation in\\n                    RiC-CM 0.2"@en ] .

ns1:childRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "child relation has target "@en ;
    rdfs:comment "Connects a Child Relation to a child Person"@en ;
    rdfs:domain ns1:ChildRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:descendanceRelationHasTarget ;
    owl:inverseOf ns1:personIsTargetOfChildRelation .

ns1:correspondenceRelationConnects a owl:ObjectProperty ;
    rdfs:label "correspondence relation connects "@en ;
    rdfs:comment "Connects a Correspondence Relation to one of the Persons\\n            involved"@en ;
    rdfs:domain ns1:CorrespondenceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:knowingRelationConnects ;
    owl:inverseOf ns1:personHasCorrespondenceRelation .

ns1:creationRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "creation relation has target "@en ;
    rdfs:comment "Connects a Creation Relation to one of the creator\\n            Agents"@en ;
    rdfs:domain ns1:CreationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:agentOriginationRelationHasTarget ;
    owl:inverseOf ns1:agentIsTargetOfCreationRelation .

ns1:derivationRelationHasSource a owl:ObjectProperty ;
    rdfs:label "derivation relation has source "@en ;
    rdfs:comment "Connects a Derivation Relation to the Instantiation from which\\n            one or more Instantiations is derived."@en ;
    rdfs:domain ns1:DerivationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:instantiationToInstantiationRelationConnects,
        ns1:temporalRelationHasSource ;
    owl:inverseOf ns1:instantiationIsSourceOfDerivationRelation .

ns1:eventRelationHasSource a owl:ObjectProperty ;
    rdfs:label "event relation has source "@en ;
    rdfs:comment "Connects an Event Relation to an Event"@en ;
    rdfs:domain ns1:EventRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Event ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:eventIsSourceOfEventRelation .

ns1:eventRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "event relation has target "@en ;
    rdfs:comment "Connects an Event Relation to an associated Thing"@en ;
    rdfs:domain ns1:EventRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfEventRelation .

ns1:functionalEquivalenceRelationConnects a owl:ObjectProperty ;
    rdfs:label "functional equivalence relation connects "@en ;
    rdfs:comment "Connects a Functional Equivalence Relation to one of the\\n            functionally equivalent Instantiations."@en ;
    rdfs:domain ns1:FunctionalEquivalenceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:instantiationToInstantiationRelationConnects ;
    owl:inverseOf ns1:instantiationIsConnectedToFunctionalEquivalenceRelation .

ns1:groupSubdivisionRelationHasSource a owl:ObjectProperty ;
    rdfs:label "group subdivision relation has source "@en ;
    rdfs:comment "Connects a Group Subdivision Relation to the Group that has\\n            subdivisions"@en ;
    rdfs:domain ns1:GroupSubdivisionRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Group ;
    rdfs:subPropertyOf ns1:agentHierarchicalRelationHasSource,
        ns1:wholePartRelationHasSource ;
    owl:inverseOf ns1:groupIsSourceOfGroupSubdivisionRelation .

ns1:groupSubdivisionRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "group subdivision relation has target "@en ;
    rdfs:comment "Connects a Group Subdivision Relation to one of the Groups that\\n            is a subdivision"@en ;
    rdfs:domain ns1:GroupSubdivisionRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Group ;
    rdfs:subPropertyOf ns1:agentHierarchicalRelationHasTarget,
        ns1:wholePartRelationHasTarget ;
    owl:inverseOf ns1:groupIsTargetOfGroupSubdivisionRelation .

ns1:hasAccumulator a owl:ObjectProperty ;
    rdfs:label "has accumulator"@en ;
    rdfs:comment "Connects a Record Resource or an Instantiation to the Agent that\\n            accumulates it, be it intentionally (collecting) or not (receiving in the course of its\\n            activities)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:hasProvenance ;
    owl:inverseOf ns1:isAccumulatorOf ;
    owl:propertyChainAxiom ( ns1:recordResourceOrInstantiationIsSourceOfAccumulationRelation ns1:accumulationRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition and corresponding CM component (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"accumulatedBy\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R028 ('has accumulator'\\n            relation)"@en .

ns1:hasBeginningDate a owl:ObjectProperty ;
    rdfs:label "has beginning date "@en ;
    rdfs:comment "Inverse of 'is beginning date of' object property"@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Date ;
    rdfs:subPropertyOf ns1:isAssociatedWithDate ;
    owl:inverseOf ns1:isBeginningDateOf ;
    ns1:RiCCMCorrespondingComponent "RiC-R069i ('has beginning date'\\n            relation)"@en .

ns1:hasEndDate a owl:ObjectProperty ;
    rdfs:label "has end date "@en ;
    rdfs:comment "Inverse of 'is end date of' object property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Date ;
    rdfs:subPropertyOf ns1:isAssociatedWithDate ;
    owl:inverseOf ns1:isEndDateOf ;
    ns1:RiCCMCorrespondingComponent "RiC-R071i ('has end date'\\n            relation)"@en .

ns1:hasOrHadAppellation a owl:ObjectProperty ;
    rdfs:label "has or had appellation"@en ;
    rdfs:comment "Connects a Thing to an Appellation that is or was used for\\n            designating it."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Appellation ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isOrWasAppellationOf ;
    owl:propertyChainAxiom ( ns1:thingIsTargetOfAppellationRelation ns1:appellationRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"hasAppellation\")."@en ] .

ns1:hasOrHadParticipant a owl:ObjectProperty ;
    rdfs:label "has or had participant"@en ;
    rdfs:comment "Connects an Event to a Thing that is or was actively or\\n            passively involved in it."@en ;
    rdfs:domain ns1:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isEventAssociatedWith ;
    owl:inverseOf ns1:isOrWasParticipantIn ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"involves\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R058 ('has or had participant'\\n            relation)"@en .

ns1:hasOrHadSubject a owl:ObjectProperty ;
    rdfs:label "has or had subject"@en ;
    rdfs:comment "Connects a Record Resource to a Thing that is or was its\\n            subject."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isOrWasSubjectOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"hasSubject\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R019 ('has or had subject'\\n            relation)"@en .

ns1:hasOrHadSubordinate a owl:ObjectProperty ;
    rdfs:label "has or had subordinate"@en ;
    rdfs:comment "Connects an Agent to an Agent that is hierarchically\\n            inferior."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent ;
    owl:inverseOf ns1:isOrWasSubordinateTo ;
    owl:propertyChainAxiom ( ns1:agentIsSourceOfAgentHierarchicalRelation ns1:agentHierarchicalRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI (changed made\\n                    in order to make RiC-O compliant with RiC-CM 0.2; the name of this property in\\n                    RiC-O 0.1 was \"isHierarchicallySuperiorTo\")."@en ] ;
    skos:scopeNote "The hierarchical relation can be an authority relation, or a\\n            whole/part relation between two Groups"@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R045 ('has or had subordinate '\\n            relation)"@en .

ns1:instantiationIsSourceOfDerivationRelation a owl:ObjectProperty ;
    rdfs:label "instantiation is source of derivation relation "@en ;
    rdfs:comment "Connects an Instantiation (from which at least one Instantiation\\n            is derived) to a Derivation Relation."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:DerivationRelation ;
    rdfs:subPropertyOf ns1:instantiationIsConnectedToInstantiationRelation,
        ns1:thingIsSourceOfRelation,
        ns1:thingIsSourceOfTemporalRelation ;
    owl:inverseOf ns1:derivationRelationHasSource .

ns1:intellectualPropertyRightsRelationHasSource a owl:ObjectProperty ;
    rdfs:label "intellectual property rights relation has source "@en ;
    rdfs:comment "Connects an IntellectualPropertyRightsRelation to one of the\\n            Group, Person or Position that holds the rights."@en ;
    rdfs:domain ns1:IntellectualPropertyRightsRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
    rdfs:subPropertyOf ns1:authorityRelationHasSource ;
    owl:inverseOf ns1:agentIsSourceOfIntellectualPropertyRightsRelation .

ns1:intellectualPropertyRightsRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "intellectual property rights relation has target "@en ;
    rdfs:comment "Connects an IintellectualPropertyRightsRelation to one of the\\n            Record Resource or Instantiation on which the rights are held."@en ;
    rdfs:domain ns1:IntellectualPropertyRightsRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:authorityRelationHasTarget ;
    owl:inverseOf ns1:recordResourceOrInstantiationIsTargetOfIntellectualPropertyRightsRelation .

ns1:isAccumulatorOf a owl:ObjectProperty ;
    rdfs:label "is accumulator of"@en ;
    rdfs:comment "Inverse of 'has accumulator' object property."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:isProvenanceOf ;
    owl:inverseOf ns1:hasAccumulator ;
    owl:propertyChainAxiom ( ns1:agentIsTargetOfAccumulationRelation ns1:accumulationRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition and corresponding CM component (changed made in order to make RiC-O\\n                    compliant with RiC-CM 0.2; the name of this property in RiC-O 0.1 was\\n                    \"accumulates\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R028i ('is accumulator of'\\n            relation)"@en .

ns1:isOrWasAppellationOf a owl:ObjectProperty ;
    rdfs:label "is or was appellation of"@en ;
    rdfs:comment "Connects an Appellation to a Thing that it designates or\\n            designated."@en ;
    rdfs:domain ns1:Appellation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasOrHadAppellation ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"isAppellationOf\")."@en ] .

ns1:isOrWasParticipantIn a owl:ObjectProperty ;
    rdfs:label "is or was participant in"@en ;
    rdfs:comment "Inverse of 'has or had participant' object\\n            property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Event ;
    rdfs:subPropertyOf ns1:isAssociatedWithEvent ;
    owl:inverseOf ns1:hasOrHadParticipant ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"involvedIn\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R058i ('is or was participant in'\\n            relation)"@en .

ns1:isOrWasSubjectOf a owl:ObjectProperty ;
    rdfs:label "is or was subject of"@en ;
    rdfs:comment "Inverse of 'has or had subject' object property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasOrHadSubject ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"isSubjectOf\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RIc-R019i ('is or was subject of'\\n            relation)"@en .

ns1:isOrWasSubordinateTo a owl:ObjectProperty ;
    rdfs:label "is or was subordinate to"@en ;
    rdfs:comment "Inverse of 'has or had subordinate' object\\n            property."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent ;
    owl:inverseOf ns1:hasOrHadSubordinate ;
    owl:propertyChainAxiom ( ns1:agentIsTargetOfAgentHierarchicalRelation ns1:agentHierarchicalRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI (changed made\\n                    in order to make RiC-O compliant with RiC-CM 0.2; the name of this property in\\n                    RiC-O 0.1 was \"isHierarchicallyInferiorTo\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R045i ('is or was subordinate to'\\n            relation)"@en .

ns1:knowingOfRelationHasSource a owl:ObjectProperty ;
    rdfs:label "knowing of relation has source "@en ;
    rdfs:comment "Connects a Knowing Of Relation to a 'knowing of' Person (a\\n            Person who has some knowledge of another one.)"@en ;
    rdfs:domain ns1:KnowingOfRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasSource ;
    owl:inverseOf ns1:personIsSourceOfKnowingOfRelation .

ns1:knowingOfRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "knowing of relation has target "@en ;
    rdfs:comment "Connects a Knowing Of Relation to a 'known by' Person (a Person\\n            on which another one has some has some knowledge.)"@en ;
    rdfs:domain ns1:KnowingOfRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasTarget ;
    owl:inverseOf ns1:personIsTargetOfKnowingOfRelation .

ns1:knows a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "knows "@en ;
    rdfs:comment "Connects two Persons that directly know each other during their\\n            existence. This object property is symmetric."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent ;
    owl:propertyChainAxiom ( ns1:personHasKnowingRelation ns1:knowingRelationConnects ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R051 ('knows'\\n            relation)"@en .

ns1:leadershipRelationHasSource a owl:ObjectProperty ;
    rdfs:label "leadership relation has source "@en ;
    rdfs:comment "Connects a Leadership Relation to a Person who is involved as a\\n            leader."@en ;
    rdfs:domain ns1:LeadershipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:agentControlRelationHasSource ;
    owl:inverseOf ns1:personIsSourceOfLeadershipRelation .

ns1:leadershipRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "leadership relation has target "@en ;
    rdfs:comment "Connects a Leadership Relation to a lead Group."@en ;
    rdfs:domain ns1:LeadershipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Group ;
    rdfs:subPropertyOf ns1:agentControlRelationHasTarget ;
    owl:inverseOf ns1:groupIsTargetOfLeadershipRelation .

ns1:mandateRelationHasSource a owl:ObjectProperty ;
    rdfs:label "mandate relation has source "@en ;
    rdfs:comment "Connects a Mandate Relation to a Mandate."@en ;
    rdfs:domain ns1:MandateRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Mandate ;
    rdfs:subPropertyOf ns1:ruleRelationHasSource ;
    owl:inverseOf ns1:mandateIsSourceOfMandateRelation .

ns1:mandateRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "mandate relation has target "@en ;
    rdfs:comment "Connects a Mandate Relation to an Agent who is given the\\n            authority or competencies to act."@en ;
    rdfs:domain ns1:MandateRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:ruleRelationHasTarget ;
    owl:inverseOf ns1:agentIsTargetOfMandateRelation .

ns1:membershipRelationHasSource a owl:ObjectProperty ;
    rdfs:label "membership relation has source "@en ;
    rdfs:comment "Connects a Membership Relation to the Group that has\\n            member(s)."@en ;
    rdfs:domain ns1:MembershipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Group ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasSource ;
    owl:inverseOf ns1:groupIsSourceOfMembershipRelation .

ns1:membershipRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "membership relation has target "@en ;
    rdfs:comment "Connects a Membership Relation to a Person who is involved as a\\n            member."@en ;
    rdfs:domain ns1:MembershipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasTarget ;
    owl:inverseOf ns1:personIsTargetOfMembershipRelation .

ns1:migrationRelationHasSource a owl:ObjectProperty ;
    rdfs:label "migration relation has source "@en ;
    rdfs:comment "Connects a Migration Relation to the migrated\\n            Instantiation."@en ;
    rdfs:domain ns1:MigrationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:derivationRelationHasSource ;
    owl:inverseOf ns1:instantiationIsSourceOfMigrationRelation .

ns1:migrationRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "migration relation has target "@en ;
    rdfs:comment "Connects a Migration Relation to a resulting\\n            Instantiation."@en ;
    rdfs:domain ns1:MigrationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:derivationRelationHasTarget ;
    owl:inverseOf ns1:instantiationIsTargetOfMigrationRelation .

ns1:ownershipRelationHasSource a owl:ObjectProperty ;
    rdfs:label "ownership relation has source "@en ;
    rdfs:comment "Connects an Ownership Relation to a Person, Group or Position\\n            that is involved as an owner."@en ;
    rdfs:domain ns1:OwnershipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
    rdfs:subPropertyOf ns1:authorityRelationHasSource ;
    owl:inverseOf ns1:agentIsSourceOfOwnershipRelation .

ns1:ownershipRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "owner ship relation has target "@en ;
    rdfs:comment "Connects an Ownership Relation to a Thing that is\\n            owned."@en ;
    rdfs:domain ns1:OwnershipRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:authorityRelationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfOwnershipRelation .

ns1:performanceRelationHasSource a owl:ObjectProperty ;
    rdfs:label "performance relation has source "@en ;
    rdfs:comment "Connects a Performance Relation to a performed\\n            Activity."@en ;
    rdfs:domain ns1:PerformanceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Activity ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:activityIsSourceOfPerformanceRelation .

ns1:performanceRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "performance relation has target "@en ;
    rdfs:comment "Connects a Performance Relation to a performing\\n            Agent."@en ;
    rdfs:domain ns1:PerformanceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:agentIsTargetOfPerformanceRelation .

ns1:personIsSourceOfDescendanceRelation a owl:ObjectProperty ;
    rdfs:label "person is source of descendance relation "@en ;
    rdfs:comment "Connects a Person (as an ancestor) to a Descendance\\n            Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:DescendanceRelation ;
    rdfs:subPropertyOf ns1:agentIsSourceOfAgentTemporalRelation,
        ns1:personHasFamilyRelation ;
    owl:inverseOf ns1:descendanceRelationHasSource .

ns1:personIsTargetOfDescendanceRelation a owl:ObjectProperty ;
    rdfs:label "person is target of descendance relation "@en ;
    rdfs:comment "Connects a Person (as a descendant) to a Descendance\\n            Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:DescendanceRelation ;
    rdfs:subPropertyOf ns1:agentIsTargetOfAgentTemporalRelation,
        ns1:personHasFamilyRelation ;
    owl:inverseOf ns1:descendanceRelationHasTarget .

ns1:physicalOrLogicalExtent a owl:DatatypeProperty ;
    rdfs:label "physical or logical extent"@en ;
    rdfs:comment "Countable characteristics of the content of an entity expressed\\n            as a quantity."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:scopeNote "Provided for usability reasons. Use only if you cannot use the\\n            subproperties (particularly if the same free text is being used in your current metadata\\n            for describing the record resource, carrier and instantiation extent)."@en .

ns1:placeRelationHasSource a owl:ObjectProperty ;
    rdfs:label "place relation has source "@en ;
    rdfs:comment "Connects a Place Relation to the Place concerned."@en ;
    rdfs:domain ns1:PlaceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Place ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:placeIsSourceOfPlaceRelation .

ns1:placeRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "place relation has target "@en ;
    rdfs:comment "Connects a Place Relation to a Thing that is associated to the\\n            Place."@en ;
    rdfs:domain ns1:PlaceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfPlaceRelation .

ns1:positionHoldingRelationHasSource a owl:ObjectProperty ;
    rdfs:label "position holding relation has source "@en ;
    rdfs:comment "Connects a Position Holding Relation to a Person (who occupies a\\n            Position)."@en ;
    rdfs:domain ns1:PositionHoldingRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasSource ;
    owl:inverseOf ns1:personIsSourceOfPositionHoldingRelation .

ns1:positionHoldingRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "position holding relation has target "@en ;
    rdfs:comment "Connects a Position Holding Relation to a Position (that is\\n            occupied)."@en ;
    rdfs:domain ns1:PositionHoldingRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Position ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasTarget ;
    owl:inverseOf ns1:positionIsTargetOfPositionHoldingRelation .

ns1:positionToGroupRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "position to group relation has target "@en ;
    rdfs:comment "Connects a Position to Group Relation to a Group (in which a\\n            Position exists)."@en ;
    rdfs:domain ns1:PositionToGroupRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Group ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasTarget ;
    owl:inverseOf ns1:groupIsTargetOfPositionToGroupRelation .

ns1:recordResourceHoldingRelationHasSource a owl:ObjectProperty ;
    rdfs:label "record resource holding relation has source "@en ;
    rdfs:comment "Connects a Record Resource Holding Relation to an Agent (as the\\n            holder of a Record Resource or Instantiation)."@en ;
    rdfs:domain ns1:RecordResourceHoldingRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:managementRelationHasSource ;
    owl:inverseOf ns1:agentIsSourceOfRecordResourceHoldingRelation .

ns1:recordResourceHoldingRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "record resource holding relation has target "@en ;
    rdfs:comment "Connects a Record Resource Holding Relation to a Record Resource\\n            or Instantiation (that is held by an Agent)."@en ;
    rdfs:domain ns1:RecordResourceHoldingRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:managementRelationHasTarget ;
    owl:inverseOf ns1:recordResourceOrInstantiationIsTargetOfRecordResourceHoldingRelation .

ns1:recordResourceIsConnectedToRecordResourceRelation a owl:ObjectProperty ;
    rdfs:label "record resource is connected to record resource relation\\n        "@en ;
    rdfs:comment "Connects a Record Resource to a Record Resource\\n            Relation."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResourceToRecordResourceRelation ;
    rdfs:subPropertyOf ns1:thingIsConnectedToRelation ;
    owl:inverseOf ns1:recordResourceRelationConnects .

ns1:recordResourceOrInstantiationIsSourceOfProvenanceRelation a owl:ObjectProperty ;
    rdfs:label "record resource or instantiation is source of provenance relation\\n        "@en ;
    rdfs:comment "Connects a Record Resource or Instantiation (that is created or\\n            accumulated by an Agent, or documents an Activity) to a Provenance\\n            Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ProvenanceRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:provenanceRelationHasSource .

ns1:recordResourceOrInstantiationIsTargetOfManagementRelation a owl:ObjectProperty ;
    rdfs:label "record resource or instantiation is target of management relation\\n        "@en ;
    rdfs:comment "Connects a Record Resource or Instantiation (that is managed by\\n            an Agent) to a Management Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:ManagementRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfAuthorityRelation ;
    owl:inverseOf ns1:managementRelationHasTarget .

ns1:recordResourceToInstantiationRelationHasSource a owl:ObjectProperty ;
    rdfs:label "record resource to instantiation relation has source "@en ;
    rdfs:comment "Connects a Record Resource To Instantiation Relation to the\\n            Record Resource (that was instantiated). "@en ;
    rdfs:domain ns1:RecordResourceToInstantiationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:recordResourceIsSourceOfRecordResourceToInstantiationRelation .

ns1:recordResourceToInstantiationRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "record resource to instantiation relation has target "@en ;
    rdfs:comment "Connects a Record Resource To Instantiation Relation to an\\n            Instantiation of the involved Record Resource. "@en ;
    rdfs:domain ns1:RecordResourceToInstantiationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:instantiationIsTargetOfRecordResourceToInstantiationRelation .

ns1:referenceSystem a owl:DatatypeProperty ;
    rdfs:label "reference system"@en ;
    rdfs:comment "Framework or standard used to represent an\\n            information."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

ns1:ruleIsSourceOfRuleRelation a owl:ObjectProperty ;
    rdfs:label "rule is source of rule relation "@en ;
    rdfs:comment "Connects a Rule to a Rule Relation."@en ;
    rdfs:domain ns1:Rule ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RuleRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:ruleRelationHasSource .

ns1:siblingRelationConnects a owl:ObjectProperty ;
    rdfs:label "sibling relation connects "@en ;
    rdfs:comment "Connects a Sibling Relation to one of the siblings\\n            involved."@en ;
    rdfs:domain ns1:SiblingRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:familyRelationConnects ;
    owl:inverseOf ns1:personHasSiblingRelation .

ns1:spouseRelationConnects a owl:ObjectProperty ;
    rdfs:label "spouse relation connects "@en ;
    rdfs:comment "Connects a Sibling Relation to one of the spouses\\n            involved."@en ;
    rdfs:domain ns1:SpouseRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:familyRelationConnects ;
    owl:inverseOf ns1:personHasSpouseRelation .

ns1:teachingRelationHasSource a owl:ObjectProperty ;
    rdfs:label "teaching relation has source "@en ;
    rdfs:comment "Connects a Teaching Relation to a Person (who is a\\n            teacher)."@en ;
    rdfs:domain ns1:TeachingRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:knowingRelationConnects,
        ns1:relationHasSource ;
    owl:inverseOf ns1:personIsSourceOfTeachingRelation .

ns1:teachingRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "teaching relation has target "@en ;
    rdfs:comment "Connects a Teaching Relation to a Person (who is a\\n            student)."@en ;
    rdfs:domain ns1:TeachingRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:knowingRelationConnects,
        ns1:relationHasTarget ;
    owl:inverseOf ns1:personIsTargetOfTeachingRelation .

ns1:textualValue a owl:DatatypeProperty ;
    rdfs:label "textual value"@en ;
    rdfs:comment "A textual expression of an Appellation or Date."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Appellation ns1:Date ns1:Extent ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

ns1:thingIsSourceOfSequentialRelation a owl:ObjectProperty ;
    rdfs:label "thing is source of sequential relation "@en ;
    rdfs:comment "Connects a Thing to a Sequential Relation, when this Thing\\n            precedes other Thing(s) in the sequence."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:SequentialRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:sequentialRelationHasSource .

ns1:thingIsSourceOfWholePartRelation a owl:ObjectProperty ;
    rdfs:label "thing is source of whole part relation "@en ;
    rdfs:comment "Connects a Thing to a Whole Part Relation, when this Thing has\\n            Part other Thing(s)."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:WholePartRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:wholePartRelationHasSource .

ns1:thingIsTargetOfRuleRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of rule relation "@en ;
    rdfs:comment "Connects a Thing (that is associated with a Rule) to a Rule\\n            Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RuleRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:ruleRelationHasTarget .

ns1:thingIsTargetOfSequentialRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of sequential relation "@en ;
    rdfs:comment "Connects a Thing (that follows other Thing(s) in a sequence) to\\n            a Sequential Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:SequentialRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:sequentialRelationHasTarget .

ns1:thingIsTargetOfWholePartRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of whole part relation "@en ;
    rdfs:comment "Connects a Thing to a Whole Part Relation, when this Thing is\\n            Part of another Thing."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:WholePartRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:wholePartRelationHasTarget .

ns1:typeRelationHasSource a owl:ObjectProperty ;
    rdfs:label "type relation has source "@en ;
    rdfs:comment "Connects a Type Relation to the Type (that categorizes the\\n            involved Thing(s))."@en ;
    rdfs:domain ns1:TypeRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Type ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:typeIsSourceOfTypeRelation .

ns1:typeRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "type relation has target "@en ;
    rdfs:comment "Connects a Type Relation to a Thing (that is categorized by the\\n            involved Type)."@en ;
    rdfs:domain ns1:TypeRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfTypeRelation .

ns1:AccumulationRelation a owl:Class ;
    rdfs:label "Accumulation Relation"@en ;
    rdfs:comment "Connects at least one Record Resource or Instantiation to at\\n            least one Agent, when the Agent accumulates it, be it intentionally (collecting it) or\\n            not (receiving it in the course of its activities)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:accumulationRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
            owl:onProperty ns1:accumulationRelationHasSource ],
        ns1:AgentOriginationRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R028 and RiC-R028i\\n            relations"@en .

ns1:ActivityDocumentationRelation a owl:Class ;
    rdfs:label "Activity Documentation Relation"@en ;
    rdfs:comment "Connects at least one Record Resource or Instantiation to at\\n            least one Activity, when the Record Resource or Instantiation results from the\\n            activity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
            owl:onProperty ns1:activityDocumentationRelationHasSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Activity ;
            owl:onProperty ns1:activityDocumentationRelationHasTarget ],
        ns1:ProvenanceRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R033 and RiC-R033\\n            relations"@en .

ns1:ActivityType a owl:Class ;
    rdfs:label "Activity Type"@en ;
    rdfs:comment "Categorization of an Activity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Activity ;
            owl:onProperty ns1:isActivityTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: updated (different from RiC-CM scope note).\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Can be extended with any number of subclasses, e.g.\\n            “function/action” and “activity domain”. This allows for a faceted approach that enables\\n            an Activity to be categorized using a combination of components, general or more\\n            specific. For example, “monitoring” can be used in combination with “election polls” or\\n            “water resources”."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A02 (Activity Type\\n            attribute)"@en .

ns1:AppellationRelation a owl:Class ;
    rdfs:label "Appellation Relation"@en ;
    rdfs:comment "The relation between an Appellation and at least one Thing that\\n            the Appellation designates."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:Appellation ;
            owl:onProperty ns1:appellationRelationHasSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:appellationRelationHasTarget ],
        ns1:Relation .

ns1:AuthorshipRelation a owl:Class ;
    rdfs:label "Authorship Relation"@en ;
    rdfs:comment "Connects at least one Record to at least one Person, Group or\\n            Position that is responsible for conceiving and formulating the information contained in\\n            the Record."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Record ;
            owl:onProperty ns1:authorshipRelationHasSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
            owl:onProperty ns1:authorshipRelationHasTarget ],
        ns1:CreationRelation ;
    skos:changeNote [ dc:date "2020-12-29" ;
            rdf:value "Created following the addition of RiC-R079 relation in\\n                    RiC-CM 0.2"@en ] ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R079 and RiC-R079i\\n            relations"@en .

ns1:ChildRelation a owl:Class ;
    rdfs:label "Child Relation"@en ;
    rdfs:comment "Connects at lest one Person, to at least another Person, when\\n            the first has child the second one."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:childRelationHasSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:childRelationHasTarget ],
        ns1:DescendanceRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R018 and RiC-R018i\\n            relations"@en .

ns1:GroupSubdivisionRelation a owl:Class ;
    rdfs:label "Group Subdivision Relation"@en ;
    rdfs:comment "Connects a Group and at least another Group, when the first one\\n            as the second one(s) among its subdivisions."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:Group ;
            owl:onProperty ns1:groupSubdivisionRelationHasSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Group ;
            owl:onProperty ns1:groupSubdivisionRelationHasTarget ],
        ns1:AgentHierarchicalRelation,
        ns1:WholePartRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R005 and RiC-R005i\\n            relations"@en .

ns1:InstantiationToInstantiationRelation a owl:Class ;
    rdfs:label "Instantiation to Instantiation Relation"@en ;
    rdfs:comment "Connects at least two instantiations"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Instantiation ;
            owl:onProperty ns1:instantiationToInstantiationRelationConnects ],
        ns1:Relation .

ns1:IntellectualPropertyRightsRelation a owl:Class ;
    rdfs:label "Intellectual Property Rights Relation"@en ;
    rdfs:comment "Connects at least one Agent and one Record Resource or\\n            Instantiation on which the Agent has some intellectual property rights."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
            owl:onProperty ns1:intellectualPropertyRightsRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
            owl:onProperty ns1:intellectualPropertyRightsRelationHasSource ],
        ns1:AuthorityRelation ;
    skos:scopeNote "Can be used, when the record resource is a work, for\\n            specifying the connection between the record resource and its\\n            author(s)."@en ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R040 and RiC-R040i\\n            relations"@en .

ns1:KnowingOfRelation a owl:Class ;
    rdfs:label "Knowing Of Relation"@en ;
    rdfs:comment "Connects at least one Person to at least another one, when the\\n            first one has some knowledge of the second one through time or space."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:knowingOfRelationHasSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:knowingOfRelationHasTarget ],
        ns1:AgentToAgentRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R050 and RiC-R050i\\n            relationsi"@en .

ns1:KnowingRelation a owl:Class ;
    rdfs:label "Knowing Relation"@en ;
    rdfs:comment "Connects at least two Persons that directly know each other\\n            during their existence. This relation is symmetric."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:knowingRelationConnects ],
        ns1:AgentToAgentRelation ;
    ns1:RiCCMCorrespondingComponent "Cass implementation of RiC-R051 and RiC—R051i\\n            relations"@en .

ns1:MigrationRelation a owl:Class ;
    rdfs:label "Migration Relation"@en ;
    rdfs:comment "Connects an Instantiation and at least another Instantiation,\\n            when the first is migrated into the second one(s)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:Instantiation ;
            owl:onProperty ns1:migrationRelationHasSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Instantiation ;
            owl:onProperty ns1:migrationRelationHasTarget ],
        ns1:DerivationRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R015 and RiC-R015i\\n            relations"@en .

ns1:OwnershipRelation a owl:Class ;
    rdfs:label "Ownership Relation"@en ;
    rdfs:comment "Connects at least one Group, Person or Position, and at least a\\n            Thing that these Agent(s) own(s)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:ownershipRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Group ns1:Person ns1:Position ) ] ;
            owl:onProperty ns1:ownershipRelationHasSource ],
        ns1:AuthorityRelation ;
    skos:scopeNote "Among other probably more rare use cases for archival\\n            description, can be used between agents (a person owns a corporate body, a corporate\\n            body owns a mechanism), or between agents and record resources"@en ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R037 and RiC-R037i\\n            relations"@en .

ns1:PerformanceRelation a owl:Class ;
    rdfs:label "Performance Relation"@en ;
    rdfs:comment "Connects at least one Activity to at least one Agent, when the\\n            first is performed by the second one(s)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Activity ;
            owl:onProperty ns1:performanceRelationHasSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:performanceRelationHasTarget ],
        ns1:EventRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R060 and RiC-R060i\\n            relations"@en .

ns1:PlaceRelation a owl:Class ;
    rdfs:label "Place Relation"@en ;
    rdfs:comment "Connects a Place and at least one Thing, when the first is\\n            associated with the existence and lifecycle of the second one."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:placeRelationHasTarget ],
        [ a owl:Restriction ;
            owl:onClass ns1:Place ;
            owl:onProperty ns1:placeRelationHasSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:Relation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R074 and RiC-R074i\\n            relations"@en .

ns1:PositionHoldingRelation a owl:Class ;
    rdfs:label "Position Holding Relation"@en ;
    rdfs:comment "Connects at least one Person, and at least one Position that the\\n            Person occupies."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Position ;
            owl:onProperty ns1:positionHoldingRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:positionHoldingRelationHasSource ],
        ns1:AgentToAgentRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R054 and RiC-R054i\\n            relations"@en .

ns1:PositionToGroupRelation a owl:Class ;
    rdfs:label "Position to Group Relation"@en ;
    rdfs:comment "Connects at least one Position, and a Group, when the first\\n            one(s) exist(s) in/is defined within the second one."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Position ;
            owl:onProperty ns1:positionToGroupRelationHasSource ],
        [ a owl:Restriction ;
            owl:onClass ns1:Group ;
            owl:onProperty ns1:positionToGroupRelationHasTarget ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:AgentToAgentRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R056 and RiC-R056i\\n            relations"@en .

ns1:RecordResourceHoldingRelation a owl:Class ;
    rdfs:label "Record Resource Holding Relation"@en ;
    rdfs:comment "Connects at least one Agent, and one or more Record Resource or\\n            Instantiation that the Agent holds."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
            owl:onProperty ns1:recordResourceHoldingRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:recordResourceHoldingRelationHasSource ],
        ns1:ManagementRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R039 and RiC-039i\\n            relations"@en .

ns1:RecordResourceToInstantiationRelation a owl:Class ;
    rdfs:label "Record Resource to Instantiation Relation"@en ;
    rdfs:comment "Connects a Record Resource to one or more Instantiations that\\n            instantiate it."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:RecordResource ;
            owl:onProperty ns1:recordResourceToInstantiationRelationHasSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Instantiation ;
            owl:onProperty ns1:recordResourceToInstantiationRelationHasTarget ],
        ns1:Relation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R025 and RiC-R025i\\n            relations"@en .

ns1:TeachingRelation a owl:Class ;
    rdfs:label "Teaching Relation"@en ;
    rdfs:comment "Connects at least one Person to at least another Person, who is\\n            their student."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:teachingRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:teachingRelationHasSource ],
        ns1:KnowingRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R053 and RiC-R053i\\n            relation"@en .

ns1:TypeRelation a owl:Class ;
    rdfs:label "Type Relation"@en ;
    rdfs:comment "Connects a category (a Type) and at least one Thing that belongs\\n            to this category."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:Type ;
            owl:onProperty ns1:typeRelationHasSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:typeRelationHasTarget ],
        ns1:Relation ;
    skos:scopeNote "may be useful at least for some types (e.g. demographic\\n            group)"@en .

ns1:agentControlRelationHasSource a owl:ObjectProperty ;
    rdfs:label "agent control relation has source "@en ;
    rdfs:comment "Connects an Agent Control Relation to one of the controlling\\n            Agents"@en ;
    rdfs:domain ns1:AgentControlRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:agentHierarchicalRelationHasSource,
        ns1:authorityRelationHasSource ;
    owl:inverseOf ns1:agentIsSourceOfAgentControlRelation .

ns1:agentControlRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "agent control relation has target "@en ;
    rdfs:comment "Connects an Agent Control Relation to one of the controlled\\n            Agents"@en ;
    rdfs:domain ns1:AgentControlRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:agentHierarchicalRelationHasTarget,
        ns1:authorityRelationHasTarget ;
    owl:inverseOf ns1:agentIsTargetOfAgentControlRelation ;
    ns1:RiCCMCorrespondingComponent "s"@en .

ns1:agentIsSourceOfAgentHierarchicalRelation a owl:ObjectProperty ;
    rdfs:label "agent is source of agent hierarchical relation "@en ;
    rdfs:comment "Connects a hierarchically superior Agent to an Agent\\n            Hierarchical Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentHierarchicalRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:agentHierarchicalRelationHasSource .

ns1:agentIsTargetOfAgentHierarchicalRelation a owl:ObjectProperty ;
    rdfs:label "agent is target of agent hierarchical relation "@en ;
    rdfs:comment "Connects one of the hierarchically inferior Agents to an Agent\\n            Hierarchical Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentHierarchicalRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation,
        ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:agentHierarchicalRelationHasTarget .

ns1:agentIsTargetOfAgentOriginationRelation a owl:ObjectProperty ;
    rdfs:label "agent is target of agent origination relation "@en ;
    rdfs:comment "Connects one of the Agents that created or accumulated the\\n            Record resource or Instantiation, to an Agent Origination Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentOriginationRelation ;
    rdfs:subPropertyOf ns1:agentOrActivityIsTargetOfProvenanceRelation ;
    owl:inverseOf ns1:agentOriginationRelationHasTarget .

ns1:agentTemporalRelationHasSource a owl:ObjectProperty ;
    rdfs:label "agent temporal relation has source "@en ;
    rdfs:comment "Connects an Agent Temporal Relation to one of the predecessor\\n            Agents"@en ;
    rdfs:domain ns1:AgentTemporalRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:temporalRelationHasSource ;
    owl:inverseOf ns1:agentIsSourceOfAgentTemporalRelation .

ns1:agentTemporalRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "agent temporal relation has target "@en ;
    rdfs:comment "Connects an Agent Temporal Relation to one of the successor\\n            Agents"@en ;
    rdfs:domain ns1:AgentTemporalRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:temporalRelationHasTarget ;
    owl:inverseOf ns1:agentIsTargetOfAgentTemporalRelation .

ns1:creationRelationHasSource a owl:ObjectProperty ;
    rdfs:label "creation relation has source "@en ;
    rdfs:comment "Connects a Creation Relation to one of the created Record\\n            Resources or Instantiations"@en ;
    rdfs:domain ns1:CreationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:agentOriginationRelationHasSource ;
    owl:inverseOf ns1:recordResourceOrInstantiationIsSourceOfCreationRelation .

ns1:derivationRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "derivation relation has target "@en ;
    rdfs:comment "Connects a Derivation Relation to one of the derived\\n            Instantiations"@en ;
    rdfs:domain ns1:DerivationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:instantiationToInstantiationRelationConnects,
        ns1:temporalRelationHasTarget ;
    owl:inverseOf ns1:instantiationIsTargetOfDerivationRelation .

ns1:descendanceRelationHasSource a owl:ObjectProperty ;
    rdfs:label "descendance relation has source "@en ;
    rdfs:comment "Connects a Descendance Relation to one of the ancestor\\n            Persons"@en ;
    rdfs:domain ns1:DescendanceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:agentTemporalRelationHasSource,
        ns1:familyRelationConnects ;
    owl:inverseOf ns1:personIsSourceOfDescendanceRelation .

ns1:descendanceRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "descendance relation has target "@en ;
    rdfs:comment "Connects a Descendance Relation to one of the descendant\\n            Persons"@en ;
    rdfs:domain ns1:DescendanceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:agentTemporalRelationHasTarget,
        ns1:familyRelationConnects ;
    owl:inverseOf ns1:personIsTargetOfDescendanceRelation .

ns1:hasFamilyAssociationWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has family association with"@en ;
    rdfs:comment "Connects two Persons that have some type of family link, i.e.\\n            belong to the same family. This relation is symmetric."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:isAgentAssociatedWithAgent ;
    owl:propertyChainAxiom ( ns1:personHasFamilyRelation ns1:familyRelationConnects ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, textual definition (changed made in\\n                    order to make RiC-O compliant with RiC-CM 0.2; the name of this property in\\n                    RiC-O 0.1 was \"hasFamilyLinkWith\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R047 ('has family association with'\\n            relation)"@en .

ns1:hasOrHadName a owl:ObjectProperty ;
    rdfs:label "has or had name"@en ;
    rdfs:comment "Connects a Thing to one of its past or present\\n            Names."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Name ;
    rdfs:subPropertyOf ns1:hasOrHadAppellation ;
    owl:inverseOf ns1:isOrWasNameOf ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition, super property IRI (the name of this property in RiC-O 0.1 was\\n                    \"hasName\")."@en ] .

ns1:isOrWasNameOf a owl:ObjectProperty ;
    rdfs:label "is or was name of"@en ;
    rdfs:comment "Connects a Name to a Thing that it designated or\\n            designates."@en ;
    rdfs:domain ns1:Name ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isOrWasAppellationOf ;
    owl:inverseOf ns1:hasOrHadName ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition, super property IRI (the name of this property in RiC-O 0.1 was\\n                    \"isNameOf\")."@en ] .

ns1:managementRelationHasSource a owl:ObjectProperty ;
    rdfs:label "management relation has source "@en ;
    rdfs:comment "Connects a Management Relation to an Agent who is involved as a\\n            manager."@en ;
    rdfs:domain ns1:ManagementRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:authorityRelationHasSource ;
    owl:inverseOf ns1:agentIsSourceOfManagementRelation .

ns1:managementRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "management relation has target "@en ;
    rdfs:comment "Connects a Management Relation to a Record Resource or\\n            Instantiation that is involved as a managed thing."@en ;
    rdfs:domain ns1:ManagementRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:authorityRelationHasTarget ;
    owl:inverseOf ns1:recordResourceOrInstantiationIsTargetOfManagementRelation .

ns1:provenanceRelationHasSource a owl:ObjectProperty ;
    rdfs:label "provenance relation has source "@en ;
    rdfs:comment "Connects a Provenance Relation to a Record Resource or\\n            Instantiation."@en ;
    rdfs:domain ns1:ProvenanceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:recordResourceOrInstantiationIsSourceOfProvenanceRelation .

ns1:provenanceRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "provenance relation has target "@en ;
    rdfs:comment "Connects a Provenance Relation to an Agent or\\n            Activity."@en ;
    rdfs:domain ns1:ProvenanceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Activity ns1:Agent ) ] ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:agentOrActivityIsTargetOfProvenanceRelation .

ns1:recordResourceOrInstantiationIsSourceOfAgentOriginationRelation a owl:ObjectProperty ;
    rdfs:label "record resource or instantiation is source of agent origination\\n            relation "@en ;
    rdfs:comment "Connects a Record Resource or Instantiation (that is created,\\n            sent or accumulated) to an Agent Origination Relation."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentOriginationRelation ;
    rdfs:subPropertyOf ns1:recordResourceOrInstantiationIsSourceOfProvenanceRelation ;
    owl:inverseOf ns1:agentOriginationRelationHasSource .

ns1:recordResourceRelationConnects a owl:ObjectProperty ;
    rdfs:label "record resource relation connects "@en ;
    rdfs:comment "Connects a Record Resource relation to one of the related Record\\n            Resources."@en ;
    rdfs:domain ns1:RecordResourceToRecordResourceRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:relationConnects ;
    owl:inverseOf ns1:recordResourceIsConnectedToRecordResourceRelation .

ns1:ruleRelationHasSource a owl:ObjectProperty ;
    rdfs:label "rule relation has source "@en ;
    rdfs:comment "Connects a Rule Relation to a Rule."@en ;
    rdfs:domain ns1:RuleRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Rule ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:ruleIsSourceOfRuleRelation .

ns1:ruleRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "rule relation has target "@en ;
    rdfs:comment "Connects a Rule Relation to a Thing (that is associated to a\\n            Rule)."@en ;
    rdfs:domain ns1:RuleRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfRuleRelation .

ns1:sequentialRelationHasSource a owl:ObjectProperty ;
    rdfs:label "sequential relation has source "@en ;
    rdfs:comment "Connects a Sequential Relation to a Thing that precedes other\\n            Thing(s) in the sequence."@en ;
    rdfs:domain ns1:SequentialRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:thingIsSourceOfSequentialRelation .

ns1:sequentialRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "sequential relation has target "@en ;
    rdfs:comment "Connects a Sequential Relation to a Thing that follows other\\n            Thing(s) in the sequence."@en ;
    rdfs:domain ns1:SequentialRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfSequentialRelation .

ns1:thingIsSourceOfTemporalRelation a owl:ObjectProperty ;
    rdfs:label "thing is source of temporal relation "@en ;
    rdfs:comment "Connects a Thing to a Temporal Relation, when this Thing\\n            precedes other Thing(s) in time."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:TemporalRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfSequentialRelation ;
    owl:inverseOf ns1:temporalRelationHasSource .

ns1:thingIsTargetOfTemporalRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of temporal relation "@en ;
    rdfs:comment "Connects a Thing (that follows other Thing(s) in time) to a\\n            Temporal Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:TemporalRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfSequentialRelation ;
    owl:inverseOf ns1:temporalRelationHasTarget .

ns1:wholePartRelationHasSource a owl:ObjectProperty ;
    rdfs:label "whole part relation has source "@en ;
    rdfs:comment "Connects a Whole Part Relation to the Thing that has some\\n            parts."@en ;
    rdfs:domain ns1:WholePartRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:thingIsSourceOfWholePartRelation .

ns1:wholePartRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "whole part relation has target "@en ;
    rdfs:comment "Connects a Whole Part Relation to a Thing that is a\\n            part."@en ;
    rdfs:domain ns1:WholePartRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfWholePartRelation .

<https://www.ica.org/standards/RiC/vocabularies/recordSetTypes> a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Record Set Types"@en ;
    dc:creator "International Coucil on Archives Expert Group on Archival\\n            Description (ICA EGAD)"@en ;
    dc:title "International Council on Archives Records in Contexts Vocabulary for\\n            Record Set Types"@en ;
    skos:definition "A vocabulary on Record Set types"@en .

ns1:AgentControlRelation a owl:Class ;
    rdfs:label "Agent Control Relation"@en ;
    rdfs:comment "Connects at least one Agent, to at least another Agent, when the\\n            first one(s) control(s) in a way the activities of the second one(s)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:agentControlRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:agentControlRelationHasSource ],
        ns1:AgentHierarchicalRelation,
        ns1:AuthorityRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R041 and RiC-R041i\\n            relations"@en .

ns1:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea, unit of thought, abstract cultural object or\\n            category"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Thing .

ns1:DerivationRelation a owl:Class ;
    rdfs:label "Derivation Relation"@en ;
    rdfs:comment "Connects an Instantiation to at least one Instantiation that is\\n            derived from it."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:Instantiation ;
            owl:onProperty ns1:derivationRelationHasSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Instantiation ;
            owl:onProperty ns1:derivationRelationHasTarget ],
        ns1:InstantiationToInstantiationRelation,
        ns1:TemporalRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R014 and RiR014i\\n            relations"@en .

ns1:DescendanceRelation a owl:Class ;
    rdfs:label "Descendance Relation"@en ;
    rdfs:comment "Connects at least one Person to at least another Person, when\\n            the first has/have descendant the second one(s)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:descendanceRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:descendanceRelationHasSource ],
        ns1:AgentTemporalRelation,
        ns1:FamilyRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R017 and RiC-R017i\\n            relations"@en .

ns1:EventRelation a owl:Class ;
    rdfs:label "Event Relation"@en ;
    rdfs:comment "Connects at least one Event to at least one Thing, when the\\n            first is associated with the existence and lifecycle of the second one."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:eventRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Event ;
            owl:onProperty ns1:eventRelationHasSource ],
        ns1:Relation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R057 and RiC-R057i\\n            relations"@en .

ns1:FamilyRelation a owl:Class ;
    rdfs:label "Family Relation"@en ;
    rdfs:comment "Connects at least two Persons, when they have some family link,\\n            i.e. belong to the same family."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:familyRelationConnects ],
        ns1:AgentToAgentRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R047 and RiC-R047i\\n            relations"@en .

ns1:Identifier a owl:Class ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "A word, number, letter, symbol, or any combination of these used\\n            to uniquely identify or reference an individual instance of an entity within a specific\\n            information domain."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:IdentifierType ;
            owl:onProperty ns1:hasIdentifierType ],
        ns1:Appellation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-A22 (Identifier\\n            attribute) (see also the identifier data property)"@en .

ns1:ManagementRelation a owl:Class ;
    rdfs:label "Management Relation"@en ;
    rdfs:comment "Connects at least one Agent, and at least one Record Resource or\\n            Instantiation that the Agent manages."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:managementRelationHasSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
            owl:onProperty ns1:managementRelationHasTarget ],
        ns1:AuthorityRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R038 and RiC-R038i\\n            relations"@en .

ns1:Mandate a owl:Class ;
    rdfs:label "Mandate"@en ;
    rdfs:comment "Delegation of authority by an Agent to another Agent to perform\\n            an Activity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Agent ;
            owl:onProperty ns1:authorizes ],
        ns1:Rule ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs and updated.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Mandate is a kind of Rule. A Mandate confers the authority or\\n            competencies of Agents to perform a specified Activity. In addition to assigning an\\n            Activity and delegating authority to perform the Activity to an Agent, a Mandate\\n            commonly limits the Place (jurisdiction) and Date (time period) within which an Agent\\n            may perform the Activity (where and when). Mandates exist in a specific social and\\n            cultural context, and within that context are subject to change over time. While a\\n            Mandate may be tacit, in whole or part, it may be explicitly expressed in a variety of\\n            documentary sources (for example, constitutions, legislation, (legal) acts, statutes,\\n            legal codes, ordinances, charges, charters, or mission statements). The evidence for\\n            identifying a Mandate may be found in its entirety in one documentary source (for\\n            example, a law or regulation), or may be found in two or more sources. A Mandate should\\n            not be confused with the one or more documentary sources that serve as evidence of its\\n            identity. A documentary source is a Record."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E17 (Mandate\\n            entity)"@en .

ns1:Name a owl:Class ;
    rdfs:label "Name"@en ;
    rdfs:comment "A label, title or term designating the entity in order to make\\n            it distinguishable from other similar entities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Appellation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-A28 (Name attribute)\\n            (see also the name data property)"@en .

ns1:RuleRelation a owl:Class ;
    rdfs:label "Rule Relation"@en ;
    rdfs:comment "Connects at least one Rule to at least one Thing, when it is\\n            associated with existence and lifecycle of the Thing."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:ruleRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Rule ;
            owl:onProperty ns1:ruleRelationHasSource ],
        ns1:Relation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R062 and RiC-R062i\\n            relations"@en .

ns1:SequentialRelation a owl:Class ;
    rdfs:label "Sequential Relation"@en ;
    rdfs:comment "Connects at least one Thing to at least one Thing that follows\\n            it in some sequence."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:sequentialRelationHasSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:sequentialRelationHasTarget ],
        ns1:Relation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R008 and RiC-R008i\\n            relations"@en .

ns1:WholePartRelation a owl:Class ;
    rdfs:label "Whole Part Relation"@en ;
    rdfs:comment "Connects a Thing to at least one constitutive or component part\\n            of that Thing."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:wholePartRelationHasTarget ],
        [ a owl:Restriction ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:wholePartRelationHasSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:Relation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R002 and RiC-R002i\\n            relations"@en .

ns1:agentHierarchicalRelationHasSource a owl:ObjectProperty ;
    rdfs:label "agent hierarchical relation has source "@en ;
    rdfs:comment "Connects an Agent Hierarchical Relation to one of the\\n            hierarchically superior Agents"@en ;
    rdfs:domain ns1:AgentHierarchicalRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasSource ;
    owl:inverseOf ns1:agentIsSourceOfAgentHierarchicalRelation .

ns1:agentHierarchicalRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "agent hierarchical relation has target "@en ;
    rdfs:comment "Connects an Agent Hierarchical Relation to one of the\\n            hierarchically inferior Agents"@en ;
    rdfs:domain ns1:AgentHierarchicalRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:agentRelationConnects,
        ns1:relationHasTarget ;
    owl:inverseOf ns1:agentIsTargetOfAgentHierarchicalRelation .

ns1:agentIsSourceOfAuthorityRelation a owl:ObjectProperty ;
    rdfs:label "agent is source of authority relation "@en ;
    rdfs:comment "Connects an Agent thas has the authority, to an Authority\\n            Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AuthorityRelation ;
    rdfs:subPropertyOf ns1:thingIsSourceOfRelation ;
    owl:inverseOf ns1:authorityRelationHasSource .

ns1:agentOriginationRelationHasSource a owl:ObjectProperty ;
    rdfs:label "agent origination relation has source "@en ;
    rdfs:comment "Connects an Agent Origination Relation to one of the resulting\\n            Record Resource or Instantiation"@en ;
    rdfs:domain ns1:AgentOriginationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:provenanceRelationHasSource ;
    owl:inverseOf ns1:recordResourceOrInstantiationIsSourceOfAgentOriginationRelation .

ns1:agentOriginationRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "agent origination relation has target "@en ;
    rdfs:comment "Connects an Agent Origination Relation to one of the creating or\\n            accumulating Agents"@en ;
    rdfs:domain ns1:AgentOriginationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:provenanceRelationHasTarget ;
    owl:inverseOf ns1:agentIsTargetOfAgentOriginationRelation .

ns1:hasOrHadAllMembersWithCategory a owl:ObjectProperty ;
    rdfs:label "has or had all members with category"@en ;
    rdfs:comment "Connects a Record Set and a Category (Type) to which all the\\n            Records or Record Parts that are or were included in the Record Set\\n            belong."@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Type ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isOrWasCategoryOfAllMembersOf ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:hasOrHadAuthorityOver a owl:ObjectProperty ;
    rdfs:label "has or had authority over"@en ;
    rdfs:comment "Connects an Agent to a Thing the Agent has or had authority\\n            over."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isOrWasUnderAuthorityOf ;
    owl:propertyChainAxiom ( ns1:agentIsSourceOfAuthorityRelation ns1:authorityRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"hasAuthorityOver\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R036 ('has or had authority over'\\n            relation)"@en .

ns1:hasOrHadSomeMembersWithCategory a owl:ObjectProperty ;
    rdfs:label "has or had some members with category"@en ;
    rdfs:comment "Connects a Record Set and a Category (Type) to which some of the\\n            Records or Record Parts that are or were included in the Record Set\\n            belong."@en ;
    rdfs:domain ns1:RecordSet ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Type ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isOrWasCategoryOfSomeMembersOf ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:hasProvenance a owl:ObjectProperty ;
    rdfs:label "has provenance "@en ;
    rdfs:comment "Connects a Record Resource or an Instantiation to an Agent that\\n            creates or accumulates the Record Resource, receives it, or sends it."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isProvenanceOf ;
    owl:propertyChainAxiom ( ns1:recordResourceOrInstantiationIsSourceOfAgentOriginationRelation ns1:agentOriginationRelationHasTarget ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R026 ('has provenance'\\n            relation)"@en .

ns1:instantiationIsConnectedToInstantiationRelation a owl:ObjectProperty ;
    rdfs:label "instantiation is connected to instantiation relation "@en ;
    rdfs:comment "Connects an Instantiation to an Instantiation to Instantiation\\n            Relation."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:InstantiationToInstantiationRelation ;
    rdfs:subPropertyOf ns1:thingIsConnectedToRelation ;
    owl:inverseOf ns1:instantiationToInstantiationRelationConnects .

ns1:isAssociatedWithEvent a owl:ObjectProperty ;
    rdfs:label "is associated with event "@en ;
    rdfs:comment "Inverse of 'is event associated with' object\\n            property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Event ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isEventAssociatedWith ;
    owl:propertyChainAxiom ( ns1:thingIsTargetOfEventRelation ns1:eventRelationHasSource ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R057i ('is associated with event'\\n            relation)"@en .

ns1:isEventAssociatedWith a owl:ObjectProperty ;
    rdfs:label "is event associated with "@en ;
    rdfs:comment "Connects an Event to a Thing that is associated with the\\n            existence and lifecycle of the Event."@en ;
    rdfs:domain ns1:Event ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isAssociatedWithEvent ;
    owl:propertyChainAxiom ( ns1:eventIsSourceOfEventRelation ns1:eventRelationHasTarget ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R057 ('is event associated with'\\n            relation)"@en .

ns1:isInstantiationAssociatedWithInstantiation a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is instantiation associated with instantiation "@en ;
    rdfs:comment "Connects two Instantiations. This object property is\\n            symmetric."@en ;
    rdfs:domain ns1:Instantiation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:propertyChainAxiom ( ns1:instantiationIsConnectedToInstantiationRelation ns1:instantiationToInstantiationRelationConnects ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R034 ('is instantiation associated with\\n            instantiation' relation)"@en .

ns1:isOrWasCategoryOfAllMembersOf a owl:ObjectProperty ;
    rdfs:label "is or was category of all members of"@en ;
    rdfs:comment "Connects a Category (Type) and a Record Set whose all present or\\n            past Record or Record Part members belong to that Category."@en ;
    rdfs:domain ns1:Type ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordSet ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasOrHadAllMembersWithCategory ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:isOrWasCategoryOfSomeMembersOf a owl:ObjectProperty ;
    rdfs:label "is or was category of some members of"@en ;
    rdfs:comment "Connects a Category (Type) and a Record Set whose some present\\n            or past Record or Record Part members belong to that Category."@en ;
    rdfs:domain ns1:Type ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordSet ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasOrHadSomeMembersWithCategory ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Object property added for handling the case where a Record\\n                    Set is described as having all or some members that belong to some category (see\\n                    RiC-CM 0.2 attributes section, #4.4 on Record Set, Record and Record Part\\n                    attributes)."@en ] .

ns1:isOrWasUnderAuthorityOf a owl:ObjectProperty ;
    rdfs:label "is or was under authority of"@en ;
    rdfs:comment "Inverse of 'has or had authority over' object\\n            property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasOrHadAuthorityOver ;
    owl:propertyChainAxiom ( ns1:thingIsTargetOfAuthorityRelation ns1:authorityRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"isUnderAuthorityOf\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R036i ('is or was under authority of'\\n            relation)"@en .

ns1:isProvenanceOf a owl:ObjectProperty ;
    rdfs:label "is provenance of "@en ;
    rdfs:comment "inverse of 'has provenance' object property."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasProvenance ;
    owl:propertyChainAxiom ( ns1:agentIsTargetOfAgentOriginationRelation ns1:agentOriginationRelationHasSource ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R026i ('is provenance of'\\n            relation)"@en .

ns1:measure a owl:DatatypeProperty ;
    rdfs:label "measure"@en ;
    rdfs:comment "The extent, quantity, amount, or degree of an entity, as\\n            determined by measurement or calculation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal .

ns1:personHasKnowingRelation a owl:ObjectProperty ;
    rdfs:label "person has knowing relation "@en ;
    rdfs:comment "Connects a Person to a Knowing Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:KnowingRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation ;
    owl:inverseOf ns1:knowingRelationConnects .

ns1:temporalRelationHasSource a owl:ObjectProperty ;
    rdfs:label "temporal relation has source "@en ;
    rdfs:comment "Connects a Temporal Relation to a Thing that precedes other\\n            Thing(s) in time."@en ;
    rdfs:domain ns1:TemporalRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:sequentialRelationHasSource ;
    owl:inverseOf ns1:thingIsSourceOfTemporalRelation .

ns1:temporalRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "temporal relation has target "@en ;
    rdfs:comment "Connects a Temporal Relation to a Thing that follows other\\n            Thing(s) in time."@en ;
    rdfs:domain ns1:TemporalRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:sequentialRelationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfTemporalRelation .

skos:Concept a owl:Class .

ns1:AgentHierarchicalRelation a owl:Class ;
    rdfs:label "Agent Hierarchical Relation"@en ;
    rdfs:comment "Connects at least one Agent to at least another Agent, when the\\n            first one is hierarchically superior to the second one."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:agentHierarchicalRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:agentHierarchicalRelationHasSource ],
        ns1:AgentToAgentRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R045 and RiC-R045i\\n            relations"@en .

ns1:AgentOriginationRelation a owl:Class ;
    rdfs:label "Agent Origination Relation"@en ;
    rdfs:comment "Connects at least one Record Resource or an Instantiation to at\\n            least one Agent that creates or accumulates the Record Resource, receives it, or sends\\n            it."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:agentOriginationRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
            owl:onProperty ns1:agentOriginationRelationHasSource ],
        ns1:ProvenanceRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R026 and RiC-R026i\\n            relations"@en .

ns1:ContentType a owl:Class ;
    rdfs:label "Content Type"@en ;
    rdfs:comment "The fundamental form of communication in which a Record is\\n            expressed and the human sense through which it is intended to be\\n            perceived."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:RecordResource ;
            owl:onProperty ns1:isContentTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: added (quite the same as RiC-CM\\n                    definition)."@en ] ;
    skos:scopeNote "Should not be confused with Representation Type or Carrier\\n            Type of a related Instantiation since the form of communication can be independent of\\n            the representation or carrier, for example, a map (Content Type: cartographic image) can\\n            be represented as a sketch (Representation Type: graphic) or as a GIS-coded elements\\n            (Representation Type: computer)."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A10 (Content Type\\n            attribute)"@en .

ns1:Language a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:comment "A spoken or written human language represented in the Record or\\n            Record Part, or used by the Agent."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Concept ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "Changed the definition (skos:comment annotation); so that\\n                    it conforms to the RiC-CM one."@en ],
        [ dc:date "2020-10-23" ;
            rdf:value "Scope note from RiC-CM : deleted."@en ] ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A25 (Language\\n            attribute)"@en .

ns1:LeadershipRelation a owl:Class ;
    rdfs:label "Leadership Relation"@en ;
    rdfs:comment "Connects at least one Person and at least one Group, when the\\n            first one leads the second one."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:leadershipRelationHasSource ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Position ;
            owl:onProperty ns1:leadershipWithPosition ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Group ;
            owl:onProperty ns1:leadershipRelationHasTarget ],
        ns1:AgentControlRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R042 and RiC-R042i\\n            relations"@en .

ns1:LegalStatus a owl:Class ;
    rdfs:label "Legal Status"@en ;
    rdfs:comment "A status defined by law."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Type ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A26 (Legal Status\\n            attribute)"@en .

ns1:MembershipRelation a owl:Class ;
    rdfs:label "Membership Relation"@en ;
    rdfs:comment "Connects a Group and at least one Person, when the first one has\\n            the second one(s) among its members."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Position ;
            owl:onProperty ns1:membershipWithPosition ],
        [ a owl:Restriction ;
            owl:onClass ns1:Group ;
            owl:onProperty ns1:membershipRelationHasSource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Person ;
            owl:onProperty ns1:membershipRelationHasTarget ],
        ns1:AgentToAgentRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R055 and RiC-R055i\\n            relations"@en .

ns1:PhysicalLocation a owl:Class ;
    rdfs:label "Physical Location"@en ;
    rdfs:comment "A delimitation of the physical territory of a\\n            Place."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Coordinates ;
            owl:onProperty ns1:hasOrHadCoordinates ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Place ;
            owl:onProperty ns1:isOrWasPhysicalLocationOf ],
        ns1:Thing ;
    skos:scopeNote "Usually associated to one to many Places, and known during\\n            some time. A location may be linked to one to many Coordinates."@en ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-A27 (Location\\n            attribute)"@en .

ns1:ProvenanceRelation a owl:Class ;
    rdfs:label "Provenance Relation"@en ;
    rdfs:comment "Specifies the provenance or origin of at least one Record\\n            Resource or Instantiation, for example the relation between a Record Resource and the\\n            Agent which created it or the Activity from which it resulted."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
            owl:onProperty ns1:provenanceRelationHasSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Activity ns1:Agent ) ] ;
            owl:onProperty ns1:provenanceRelationHasTarget ],
        ns1:Relation ;
    skos:scopeNote "This relation stands for organic and for functional\\n            provenance."@en .

ns1:RecordState a owl:Class ;
    rdfs:label "Record State"@en ;
    rdfs:comment "Categorization of the production or reproduction status of a\\n            Record or Record Part."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Type ;
    skos:changeNote [ dc:date "2020-12-28" ;
            rdf:value "IRI and label changed (RecordResourceState to RecordState),\\n                    as well as textual definition."@en ],
        [ dc:date "2020-10-23" ;
            rdf:value "scope note: updated. Objective: to make RiC-O compliant\\n                    with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Can in particular refer to a record state of development or\\n            its status of transmission once finished (draft, original, copy...). Specifying that a\\n            record resource has state copy usually implies that another record resource existed or\\n            exists, of which the one described is the copy. In such a case you can also use 'is copy\\n            of' object property."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A39 (State\\n            attribute)"@en .

ns1:TemporalRelation a owl:Class ;
    rdfs:label "Temporal Relation"@en ;
    rdfs:comment "Connects at least one Thing to at least one Thing that follows\\n            it in chronological order."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:temporalRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:temporalRelationHasSource ],
        ns1:SequentialRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R009 and RiC-R009i\\n            relations"@en .

ns1:date a owl:DatatypeProperty ;
    rdfs:label "date"@en ;
    rdfs:comment "Chronological information associated with an entity that\\n            contributes to its identification and contextualization."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range rdfs:Literal ;
    skos:scopeNote "Provided for usability reasons, like its subproperties. May be\\n            deprecated and removed later on. Use only if you don't use Date classes for handling\\n            dates."@en ;
    ns1:RiCCMCorrespondingComponent "Data property implementation of RiC-E18 (Date\\n            entity)"@en .

ns1:hasGeneticLinkToRecordResource a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has genetic link to record resource "@en ;
    rdfs:comment "Connects two Record Resources when there is a genetic link\\n            between them. Genetic in this sense is as defined by diplomatics, i.e. the process by\\n            which a Record Resource is developed. This relation is symmetric."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:isRecordResourceAssociatedWithRecordResource ;
    skos:scopeNote "Use to connect two Record Resources only if it is not possible\\n            to be more accurate and specify a narrower, asymmetric relation, e.g. ‘is original\\n            of’."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R023 ('has genetic link to record resource'\\n            relation)"@en .

ns1:hasOrHadPart a owl:ObjectProperty ;
    rdfs:label "has or had part"@en ;
    rdfs:comment "Connects a Thing to a constitutive or component part of that\\n            Thing."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isOrWasPartOf ;
    owl:propertyChainAxiom ( ns1:thingIsSourceOfWholePartRelation ns1:wholePartRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"hasPart\")."@en ] ;
    skos:scopeNote "The end of existence of a whole/part relation may affect the\\n            integrity or nature of the domain entity"@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R002 (has or had part\\n            relation)"@en .

ns1:instantiationToInstantiationRelationConnects a owl:ObjectProperty ;
    rdfs:label "instantiation to instantiation relation connects "@en ;
    rdfs:comment "Connects an Instantiation to Instantiation Relation to one of\\n            the related Instantiations."@en ;
    rdfs:domain ns1:InstantiationToInstantiationRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Instantiation ;
    rdfs:subPropertyOf ns1:relationConnects ;
    owl:inverseOf ns1:instantiationIsConnectedToInstantiationRelation .

ns1:isAssociatedWithDate a owl:ObjectProperty ;
    rdfs:label "is associated with date "@en ;
    rdfs:comment "Inverse of 'is date associated with' object\\n            property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Date ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isDateAssociatedWith ;
    ns1:RiCCMCorrespondingComponent "RiC-R068i ('is associated with date'\\n            relation)"@en .

ns1:isAssociatedWithRule a owl:ObjectProperty ;
    rdfs:label "is associated with rule "@en ;
    rdfs:comment "Inverse of 'is rule associated with' object\\n            property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Rule ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isRuleAssociatedWith ;
    owl:propertyChainAxiom ( ns1:thingIsTargetOfRuleRelation ns1:ruleRelationHasSource ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R062i ('is associated with rule'\\n            relation)"@en .

ns1:isDateAssociatedWith a owl:ObjectProperty ;
    rdfs:label "is date associated with "@en ;
    rdfs:comment "Connects a Date to a Thing that the Date is associated with the\\n            existence and lifecycle of."@en ;
    rdfs:domain ns1:Date ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isAssociatedWithDate ;
    ns1:RiCCMCorrespondingComponent "RiC-R068 ('is date associated with'\\n            relation)"@en .

ns1:isOrWasPartOf a owl:ObjectProperty ;
    rdfs:label "is or was part of"@en ;
    rdfs:comment "Inverse of 'has or had part' relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasOrHadPart ;
    owl:propertyChainAxiom ( ns1:thingIsTargetOfWholePartRelation ns1:wholePartRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, textual\\n                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the\\n                    name of this property in RiC-O 0.1 was \"isPartOf\")."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R002i (is or was part of\\n            relation)"@en .

ns1:isRuleAssociatedWith a owl:ObjectProperty ;
    rdfs:label "is rule associated with "@en ;
    rdfs:comment "Connects a Rule to a Thing that is associated with the existence\\n            and lifecycle of the Rule."@en ;
    rdfs:domain ns1:Rule ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isAssociatedWithRule ;
    owl:propertyChainAxiom ( ns1:ruleIsSourceOfRuleRelation ns1:ruleRelationHasTarget ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R062 ('is rule associated with'\\n            relation)"@en .

ns1:knowingRelationConnects a owl:ObjectProperty ;
    rdfs:label "knowing relation connects "@en ;
    rdfs:comment "Connects Knowing Relation to any known Person\\n            involved."@en ;
    rdfs:domain ns1:KnowingRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:agentRelationConnects ;
    owl:inverseOf ns1:personHasKnowingRelation .

ns1:personHasFamilyRelation a owl:ObjectProperty ;
    rdfs:label "person has family relation "@en ;
    rdfs:comment "Connects a Person to a Family Relation."@en ;
    rdfs:domain ns1:Person ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:FamilyRelation ;
    rdfs:subPropertyOf ns1:agentIsConnectedToAgentRelation ;
    owl:inverseOf ns1:familyRelationConnects .

ns1:relationHasContext a owl:ObjectProperty ;
    rdfs:label "relation has context "@en ;
    rdfs:comment "Connects an n-ary Relation to a Thing that is a secondary,\\n            contextual entity during the existence of the Relation."@en ;
    rdfs:domain ns1:Relation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationConnects ;
    owl:inverseOf ns1:thingIsContextOfRelation ;
    skos:scopeNote "The secondary entity may be, for instance, a Position or a\\n            Role Type."@en .

ns1:thingIsContextOfRelation a owl:ObjectProperty ;
    rdfs:label "thing is context of relation "@en ;
    rdfs:comment "Connects a Thing (that is a secondary, contextual entity during\\n            the existence of the Relation) to a n-ary Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Relation ;
    rdfs:subPropertyOf ns1:thingIsConnectedToRelation ;
    owl:inverseOf ns1:relationHasContext .

ns1:thingIsTargetOfAuthorityRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of authority relation "@en ;
    rdfs:comment "Connects a Thing (that is under authority of an Agent) to an\\n            Authority Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AuthorityRelation ;
    rdfs:subPropertyOf ns1:thingIsTargetOfRelation ;
    owl:inverseOf ns1:authorityRelationHasTarget .

ns1:AgentTemporalRelation a owl:Class ;
    rdfs:label "Agent Temporal Relation"@en ;
    rdfs:comment "Connects at least one Agent, to at least another Agent, that\\n            succeeds it chronologically for, for instance, fullfilling some functions or performing\\n            some activities."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:agentTemporalRelationHasSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Activity ;
            owl:onProperty ns1:asConcernsActivity ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:agentTemporalRelationHasTarget ],
        ns1:AgentToAgentRelation,
        ns1:TemporalRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R016 and RiC-016i\\n            relations"@en .

ns1:CreationRelation a owl:Class ;
    rdfs:label "Creation Relation"@en ;
    rdfs:comment "Connects at least one Record Resource or Instantiation to at\\n            least one Agent, when the Agent is either responsible for all or some of the content of\\n            the Record Resource, or is a contributor to the genesis or production of the\\n            Instantiation."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:creationRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns1:Instantiation ns1:RecordResource ) ] ;
            owl:onProperty ns1:creationRelationHasSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:RoleType ;
            owl:onProperty ns1:creationWithRole ],
        ns1:AgentOriginationRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R027 and RiC-R027i\\n            relations"@en .

ns1:RecordSetType a owl:Class ;
    rdfs:label "Record Set Type"@en ;
    rdfs:comment "A broad categorization of the type of Record Set."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:RecordSet ;
            owl:onProperty ns1:isRecordSetTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "scope note: updated. Objective: to make RiC-O compliant\\n                    with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Four instances of Record Set Type are included for now in\\n            RiC-O; they also are instances of skos:Concept and, as such, part of a SKOS vocabulary.\\n            Record Set Type may also be used to categorize types of Record Set that have not\\n            traditionally been considered archival, e.g. search result list."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A36 (Record Set Type\\n            attribute)"@en .

ns1:authorityRelationHasSource a owl:ObjectProperty ;
    rdfs:label "authority relation has source "@en ;
    rdfs:comment "Connects an Authority Relation to an Agent that has the\\n            authority"@en ;
    rdfs:domain ns1:AuthorityRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:relationHasSource ;
    owl:inverseOf ns1:agentIsSourceOfAuthorityRelation .

ns1:authorityRelationHasTarget a owl:ObjectProperty ;
    rdfs:label "authority relation has target "@en ;
    rdfs:comment "Connects an Authority Relation to a Thing over which the\\n            Authority is performed"@en ;
    rdfs:domain ns1:AuthorityRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationHasTarget ;
    owl:inverseOf ns1:thingIsTargetOfAuthorityRelation .

ns1:familyRelationConnects a owl:ObjectProperty ;
    rdfs:label "family relation connects "@en ;
    rdfs:comment "Connects a Family Relation to a Person."@en ;
    rdfs:domain ns1:FamilyRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Person ;
    rdfs:subPropertyOf ns1:agentRelationConnects ;
    owl:inverseOf ns1:personHasFamilyRelation .

ns1:followsInTime a owl:ObjectProperty ;
    rdfs:label "follows in time"@en ;
    rdfs:comment "Inverse of 'precedes in time' object property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:followsOrFollowed ;
    owl:inverseOf ns1:precedesInTime ;
    owl:propertyChainAxiom ( ns1:thingIsTargetOfTemporalRelation ns1:temporalRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI."@en ] ;
    ns1:RiCCMCorrespondingComponent "RiC-R009i ('follows in time'\\n            relation)"@en .

ns1:isRecordResourceAssociatedWithRecordResource a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is record resource associated with record resource "@en ;
    rdfs:comment "Connects two Record Resources. This object property is\\n            symmetric."@en ;
    rdfs:domain ns1:RecordResource ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:RecordResource ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:propertyChainAxiom ( ns1:recordResourceIsConnectedToRecordResourceRelation ns1:recordResourceRelationConnects ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R022 ('is record resource associated with\\n            record resource' relation)"@en .

ns1:precedesInTime a owl:ObjectProperty ;
    rdfs:label "precedes in time"@en ;
    rdfs:comment "Connects a Thing to a Thing that follows it in chronological\\n            order."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:precedesOrPreceded ;
    owl:inverseOf ns1:followsInTime ;
    owl:propertyChainAxiom ( ns1:thingIsSourceOfTemporalRelation ns1:temporalRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the superproperty IRI"@en ] ;
    skos:scopeNote "There may actually be zero to many intermediate Entities,\\n            ignored or unknown, in the chronological sequence between the two connected\\n            Entities."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R009 ('precedes in time'\\n            relation)"@en .

ns1:relationConnects a owl:ObjectProperty ;
    rdfs:label "relation connects "@en ;
    rdfs:comment "Connects an n-ary Relation to any of the Things\\n            involved."@en ;
    rdfs:domain ns1:Relation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:thingIsConnectedToRelation .

ns1:thingIsConnectedToRelation a owl:ObjectProperty ;
    rdfs:label "thing is connected to relation "@en ;
    rdfs:comment "Connects a Thing to a n-ary Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Relation ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:relationConnects .

ns1:AuthorityRelation a owl:Class ;
    rdfs:label "Authority Relation"@en ;
    rdfs:comment "Connects at least one Agent, and at least one Thing over which\\n            the Agent has some authority."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Thing ;
            owl:onProperty ns1:authorityRelationHasTarget ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:authorityRelationHasSource ],
        ns1:Relation ;
    skos:scopeNote "Would probably rarely be used as such (use its\\n            sub-categories)"@en ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R036 and RiC-R036i\\n            relations"@en .

ns1:Coordinates a owl:Class ;
    rdfs:label "Coordinates"@en ;
    rdfs:comment "Longitudinal and latitudinal information of a\\n            Place."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalLocation ;
            owl:onProperty ns1:isOrWasCoordinatesOf ],
        ns1:Thing ;
    skos:changeNote [ dc:date "2021-02-08"@en ;
            rdf:value "Removed the cardinality Restrictions when the range is a\\n                    datatype property"@en ] ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-A11 (Coordinates\\n            attribute)"@en .

ns1:DocumentaryFormType a owl:Class ;
    rdfs:label "Documentary Form Type"@en ;
    rdfs:comment "Categorization of the document with respect to its extrinsic and\\n            intrinsic elements that together communicate its content, administrative and documentary\\n            context, and authority"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:Record ns1:RecordPart ) ] ;
            owl:onProperty ns1:isDocumentaryFormTypeOf ],
        ns1:Type ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Comment: updated. Scope note: made several paragraphs.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Documentary Form Type plays an important role in determining\\n            the type of information a Record may comprise, its status of perfection, and its\\n            authenticity and reliability. Documentary form types exist in a specific social and\\n            cultural context, and within that context, are subject to change over\\n            time"@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-A17 (Documentary Form Type\\n            attribute)"@en .

ns1:MandateRelation a owl:Class ;
    rdfs:label "Mandate Relation"@en ;
    rdfs:comment "Connects at least one Mandate, and at least one Agent, when the\\n            first gives the second one the authority or competencies to act. May also involve one to\\n            many Activities that the Mandate(s) assign(s) to the Agent(s)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Activity ;
            owl:onProperty ns1:asConcernsActivity ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Mandate ;
            owl:onProperty ns1:mandateRelationHasSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:Agent ;
            owl:onProperty ns1:authorizingAgent ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:mandateRelationHasTarget ],
        ns1:RuleRelation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R067 and RiC-R067i\\n            relations"@en .

ns1:isAssociatedWithPlace a owl:ObjectProperty ;
    rdfs:label "is associated with place "@en ;
    rdfs:comment "Inverse of 'is place associated with' object\\n            property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Place ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isPlaceAssociatedWith ;
    owl:propertyChainAxiom ( ns1:thingIsTargetOfPlaceRelation ns1:placeRelationHasSource ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R074i ('is associated with place'\\n            relation)"@en .

ns1:isPlaceAssociatedWith a owl:ObjectProperty ;
    rdfs:label "is place associated with "@en ;
    rdfs:comment "Connects a Place to a Thing that Place is associated with the\\n            existence and lifecycle of."@en ;
    rdfs:domain ns1:Place ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isAssociatedWithPlace ;
    owl:propertyChainAxiom ( ns1:placeIsSourceOfPlaceRelation ns1:placeRelationHasTarget ) ;
    ns1:RiCCMCorrespondingComponent "RiC-R074 ('is place associated with'\\n            relation)"@en .

ns1:AgentToAgentRelation a owl:Class ;
    rdfs:label "Agent Relation"@en ;
    rdfs:comment "Connects at least two Agents."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Agent ;
            owl:onProperty ns1:agentRelationConnects ],
        ns1:Relation ;
    ns1:RiCCMCorrespondingComponent "Class implementation of RiC-R044 and RiC-044i\\n            relations"@en .

ns1:Extent a owl:Class ;
    rdfs:label "Extent"@en ;
    rdfs:comment "Countable characteristics of the content of an entity expressed\\n            as a quantity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Thing ;
    skos:changeNote [ dc:date "2020-10-28" ;
            rdf:value "Class added together with three subclasses and hasExtent\\n                    and isExtentOf Object properties"@en ] ;
    skos:scopeNote "Physical or logical extent of a resource"@en .

ns1:Appellation a owl:Class ;
    rdfs:label "Appellation"@en ;
    rdfs:comment "A concept of any kind that is used for designating an Entity and\\n            referring to it."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Concept .

ns1:isAgentAssociatedWithAgent a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is agent associated with agent "@en ;
    rdfs:comment "Connects two Agents. This object property is\\n            symmetric."@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:propertyChainAxiom ( ns1:agentIsConnectedToAgentRelation ns1:agentRelationConnects ) ;
    skos:scopeNote "Use to connect two Agents only if it is not possible to be\\n            more accurate and use a narrower Agent to Agent relation, e.g. ‘has work relation\\n            with’."@en ;
    ns1:RiCCMCorrespondingComponent "RiC-R044 ('is agent associated with agent'\\n            relation)"@en .

ns1:agentIsConnectedToAgentRelation a owl:ObjectProperty ;
    rdfs:label "agent is connected to agent relation "@en ;
    rdfs:comment "Connects an Agent to an Agent Relation"@en ;
    rdfs:domain ns1:Agent ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:AgentToAgentRelation ;
    rdfs:subPropertyOf ns1:thingIsConnectedToRelation ;
    owl:inverseOf ns1:agentRelationConnects .

ns1:agentRelationConnects a owl:ObjectProperty ;
    rdfs:label "agent relation connects "@en ;
    rdfs:comment "Connects an Agent Relation to one of the involved\\n            Agents"@en ;
    rdfs:domain ns1:AgentToAgentRelation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Agent ;
    rdfs:subPropertyOf ns1:relationConnects ;
    owl:inverseOf ns1:agentIsConnectedToAgentRelation .

ns1:hasOrHadCategory a owl:ObjectProperty ;
    rdfs:label "has or had category"@en ;
    rdfs:comment "Connects a Thing to a Type that categorizes or categorized\\n            it."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Type ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:isOrWasCategoryOf ;
    owl:propertyChainAxiom ( ns1:thingIsTargetOfTypeRelation ns1:typeRelationHasSource ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"belongsToCategory\")."@en ] .

ns1:isOrWasCategoryOf a owl:ObjectProperty ;
    rdfs:label "is or was category of"@en ;
    rdfs:comment "Connects a Type (a category) to a Thing that it categorizes or\\n            categorized."@en ;
    rdfs:domain ns1:Type ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:isRelatedTo ;
    owl:inverseOf ns1:hasOrHadCategory ;
    owl:propertyChainAxiom ( ns1:typeIsSourceOfTypeRelation ns1:typeRelationHasTarget ) ;
    skos:changeNote [ dc:date "2021-01-22" ;
            rdf:value "changed the IRI, label, inverse property IRI, text\\n                    definition (the name of this property in RiC-O 0.1 was\\n                    \"isCategoryOf\")."@en ] .

ns1:relationHasSource a owl:ObjectProperty ;
    rdfs:label "relation has source "@en ;
    rdfs:comment "Connects an n-ary Relation to a Thing that is its\\n            source."@en ;
    rdfs:domain ns1:Relation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationConnects ;
    owl:inverseOf ns1:thingIsSourceOfRelation .

ns1:relationHasTarget a owl:ObjectProperty ;
    rdfs:label "relation has target "@en ;
    rdfs:comment "Connects an n-ary Relation to a Thing that is its\\n            target."@en ;
    rdfs:domain ns1:Relation ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    rdfs:subPropertyOf ns1:relationConnects ;
    owl:inverseOf ns1:thingIsTargetOfRelation .

ns1:thingIsSourceOfRelation a owl:ObjectProperty ;
    rdfs:label "thing is source of relation "@en ;
    rdfs:comment "Connects a Thing (that is the source of a Relation) to a\\n            Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Relation ;
    rdfs:subPropertyOf ns1:thingIsConnectedToRelation ;
    owl:inverseOf ns1:relationHasSource .

ns1:thingIsTargetOfRelation a owl:ObjectProperty ;
    rdfs:label "thing is target of relation "@en ;
    rdfs:comment "Connects a Thing to a n-ary Relation."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Relation ;
    rdfs:subPropertyOf ns1:thingIsConnectedToRelation ;
    owl:inverseOf ns1:relationHasTarget .

ns1:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "The doing of something for some human purpose."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Agent ;
            owl:onProperty ns1:isOrWasPerformedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:ActivityType ;
            owl:onProperty ns1:hasActivityType ],
        ns1:Event ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs and updated.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Activity is a kind of Event. Activity is specifically used to\\n            designate purposeful human activity. Activity may be understood from two perspectives.\\n            First it can be understood as leading to an end. The end is the purpose of the Activity,\\n            or why the Activity is performed. Second, it can be understood in terms of the processes\\n            that lead to achieving the end, how the end is realized through coordinated actions.\\n            Purpose and process are complementary understandings of Activity. Together the two\\n            perspectives address why the Activity is performed, the expected ends or outcomes; and\\n            how the Activity fulfills the purpose. While activity has an intended end, it also has\\n            unintended consequences and results, or side-effects. By and large, these may not be the\\n            focus of the description, but they are, unquestionably, context. |In a corporate or\\n            government context an Activity may also be called a 'function'. An Activity exists in a\\n            specific social and cultural context, and within that context is subject to change over\\n            time. An Activity may be composed of other Activities."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E15 (Activity\\n            entity)"@en .

ns1:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "Something that happens in time and space."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:EventType ;
            owl:onProperty ns1:hasEventType ],
        ns1:Thing ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs and some\\n                    changes."@en ] ;
    skos:scopeNote "An event may be natural, human, or a combination of natural\\n            and human. Events have temporal and spatial boundaries. An event may actively involve\\n            some agent(s) and affect any entity. An event may be discrete, happening at a specific\\n            moment in time, or may occur over an extended period of time. Events may have events as\\n            parts, and events may precede or follow one another. Multiple agents may participate in\\n            the same event, and in different roles. "@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E14 (Event\\n            entity)"@en ;
    ns1:closeTo "LODE Event class\\n            (http://linkedevents.org/ontology/#term-Event)"@en .

ns1:RecordPart a owl:Class ;
    rdfs:label "Record Part"@en ;
    rdfs:comment "Part of a Record with discrete information content that\\n            contributes to the Record's physical or intellectual completeness."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:RecordResource ;
    skos:changeNote [ dc:date "2021-02-08" ;
            rdf:value "Removed the Restriction."@en ],
        [ dc:date "2020-10-23" ;
            rdf:value "comment: updated. Scope note: made several paragraphs.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Record Part is a kind of Record Resource. A Record Part may\\n            itself have Record Parts."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E05 (Record Part\\n            entity)"@en .

ns1:Rule a owl:Class ;
    rdfs:label "Rule"@en ;
    rdfs:comment "Conditions that govern the existence or authority of an Agent or the performance of an Activity, or that contribute to the distinct characteristics of things created or managed by an Agent."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:RuleType ;
            owl:onProperty ns1:hasOrHadRuleType ],
        ns1:Thing ;
    skos:changeNote [ dc:date "2021-02-11" ;
            rdf:value "Updated the definition (rdfs:comment) and scope note, as they were recently changed in RiC-CM 0.2 full draft."@en ],
        [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs and updated.\\n                    Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Rule can be related directly to Agent, Activity, or anything created or managed by agents, such as a Record Resource or Instantiation.\\n            A Rule may be unwritten or written or otherwise documented. Unwritten rules may include though are not limited to the following:  social mores, customs, or community expectations. Written rules may include though are not limited to the following: constitutions, legislation, acts (legal), statutes, legal codes, ordinances, charters, mission statements, regulations, policies, procedures, instructions, codes of conduct or ethics, professional standards, work assignments or work plans.\\n            The source or sources of some Rules are external to the Agent (for example, expressed in elections, social mores, customs, community expectations, laws, regulations, standards and best practice codes), while others are expressed within the Agent’s immediate context (for example, policies, or written or verbal instructions).\\n            The evidence for identifying Rules may be found in their entirety in one documentary source (for example, a law or regulation) or may be found in two or more sources.\\n            Rule should not be confused with the one or more documentary sources that serve as evidence of its identity. A documentary source is a Record.\\n           "@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E16 (Rule\\n            entity)"@en .

ns1:Relation a owl:Class ;
    rdfs:label "Relation"@en ;
    rdfs:comment "The top level relation class. It connects at least two Things.\\n            An instance of a Relation may have some datatype and object properties : a descriptive\\n            note (datatype property) like any Thing ; certainty (for 'certain', 'quite probable',\\n            'uncertain','unknown'); a date (use either the date datatype property or the Date class\\n            and isAssociatedWithDate object property ; a state (relationState) ; a location (use\\n            Place class and isAssociatedWithPlace object property) ; a source of information that\\n            can be used as an evidence for it (use either source datatype property or hasSource\\n            object property)."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Thing ;
    skos:changeNote [ dc:date "2021-02-08" ;
            rdf:value "Removed the restrictions; completed the definition and\\n                    scope note."@en ] ;
    skos:scopeNote "Use when direct, binary object properties are not enough, e.g.\\n            when you need to record a date, a location or any other descriptive element for a\\n            relation (till RDF-Star becomes a W3C recommendation and provides a lighter method for\\n            doing so); or when the relation invloves more than two entities (n-ary relation). It is\\n            recommended to use the subclasses of the Relation class."@en .

ns1:Type a owl:Class ;
    rdfs:label "Type"@en ;
    rdfs:comment "A superclass for any category of some thing. A type\\n            characterizes an entity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Concept .

ns1:Place a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "Bounded, named geographic area or region."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:PhysicalLocation ;
            owl:onProperty ns1:hasOrHadPhysicalLocation ],
        ns1:Thing ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Comment: updated. Scope note: updated and made several\\n                    paragraphs. Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "A Place may be a jurisdiction, a manmade structure, or a\\n            natural feature. A manmade structure or natural feature may also be a jurisdiction. A\\n            Place may be referenced to a Physical Location on the earth, or (if you don't want to\\n            use the PhysicalLocation class) directly to geographic coordinates. Both jurisdictions\\n            and natural features are historical entities. A Place thus may have begin and end dates,\\n            and changing boundaries that result from human or natural events. A Jurisdiction is the\\n            bounded geographic area within which an Agent has the authority to perform specified\\n            activities constrained by rules."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E22 (Place\\n            entity)"@en .

ns1:Record a owl:Class ;
    rdfs:label "Record"@en ;
    rdfs:comment "Information inscribed at least once by any method on any\\n            physical carrier in any persistent, recoverable form by an Agent in the course of life\\n            or work Activity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:RecordResource ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: updated and made several paragraphs. Objective:\\n                    to make RiC-O compliant with RiC-CM v0.2."@en ],
        [ dc:date "2021-02-08" ;
            rdf:value "Removed the Restriction."@en ] ;
    skos:scopeNote "Record is a kind of Record Resource. A Record must have or\\n            have had at least one Instantiation. A Record may have more than one Instantiation. A\\n            re-instantiation of the record may be considered the same record or a new record,\\n            depending on the context and of the functions that record serves. Such information may\\n            serve a variety of purposes, though it always documents or is evidence of\\n            Activity."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E04 (Record\\n            entity)"@en .

ns1:Date a owl:Class ;
    rdfs:label "Date"@en ;
    rdfs:comment "Chronological information associated with an entity that\\n            contributes to its identification and contextualization."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Thing ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs."@en ] ;
    skos:scopeNote "Date includes both single dates, a date range, or a set of\\n            non-contiguous single dates or date ranges. A date may be represented in natural\\n            language, based on a digital standard, or both. Digital standard dates will typically be\\n            based on ISO 8601, or Extended Date-Time Format (EDTF)."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E18 (Date\\n            entity)"@en .

ns1:Position a owl:Class ;
    rdfs:label "Position"@en ;
    rdfs:comment "The functional role of a Person within a Group."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Agent ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs and updated. Disjoint\\n                    with: enriched. Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Position is a kind of Agent. Position is the intersection of a\\n            Person and a Group. Position exists independently of the Person that holds the Position\\n            within a Group. More than one Person may hold a Position. Position is commonly defined\\n            in a Mandate, often called a position description or job description. The Mandate may\\n            specify the work to be performed (Activity) as well as the competencies for performing\\n            the Activity. A Position is often given a Name. A Position may be tied to a project or\\n            to a set of tasks and thus have a defined duration. A Position may change over time, as\\n            the Group that establishes it changes over time. Position is not to be confused with\\n            Occupation or Activity. Within the records created by a Corporate Body, a Position may\\n            be used to identify the record sets resulting from activities performed by one or more\\n            persons holding the Position over time, without necessarily identifying or describing\\n            the Person or persons, or identifying which records were created by each\\n            Person."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E12 (Position\\n            entity)"@en .

ns1:RecordSet a owl:Class ;
    rdfs:label "Record Set"@en ;
    rdfs:comment "One or more records that are associated by categorization and/or\\n            physical aggregation by the creator or other Agent."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:RecordSetType ;
            owl:onProperty ns1:hasRecordSetType ],
        ns1:RecordResource ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "comment: updated. Scope note: updated and made several\\n                    paragraphs. Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "Record Set is a kind of Record Resource. The Record members in\\n            a Record Set may physically reside together, though physical proximity is not essential.\\n            In a particular context, an Agent (e.g. administrator, records manager, archivist,\\n            end-user, etc.) may select the Record members of a Record Set based on a shared\\n            attribute or attributes, or a shared Relation or Relations. The grouping of the Records\\n            serves a purpose or purposes specific to the context of the Agent. All Record members of\\n            a Record Set may share the attribute of having been accumulated by the same Agent, or\\n            all share the same Documentary Form Type and are created over time by the same Activity.\\n            A Record Set may represent the act of classifying the Records in accordance with a\\n            formal classification scheme that may be based on Activity, subject, organizational\\n            structure, or other criteria; an act of archival arrangement (e.g. based on common\\n            provenance); or some other selection and grouping that fulfils a particular purpose or\\n            purposes (e.g. a classification that reflects or supports the purposes of a researcher).\\n            By exception, some Records are brought together based on their not belonging in the\\n            context of selection to other designated groups: a ‘Miscellaneous’ series, for example.\\n            A Record Set accumulated by an Agent in the course of life or work Activity should be\\n            kept in a manner that preserves context and evidential value. Records Sets may also\\n            contain other Records Sets. Both a Record Set and a Record may simultaneously be a\\n            member of more than one Record Set, and over the course of its existence, a Record Set\\n            or Record may be a member of an indeterminate number of Record Sets in an indeterminate\\n            number of contexts. Record Sets and Records contained within a Record Set may be ordered\\n            into a sequence based on a common property or relation, or common properties or\\n            relations (e.g. alphabetical by Agent or related Place name; chronological order by an\\n            allocated Date); or some other criterion (e.g. an imposed order by\\n            relevance)."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E03 (Record Set\\n            entity)"@en .

ns1:Group a owl:Class ;
    rdfs:label "Group"@en ;
    rdfs:comment "Two or more Agents that act together as an Agent."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Agent ;
    owl:disjointWith ns1:Mechanism,
        ns1:Person,
        ns1:Position ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs plus very few changes.\\n                    Disjoint with: enriched."@en ] ;
    skos:scopeNote "Group is a kind of Agent. A Group has a socially recognized\\n            identity. Each member of the Group plays a particular role or roles (that is has a\\n            particular Position) in the coordinated activity of the Group. Corporate bodies and\\n            families are kinds of groups, though other kinds of groups are possible. For example,\\n            the “electorate” -- all of the voters in a given election. Complex, large groups may be\\n            subdivided into other groups."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E09 (Group\\n            Entity)"@en .

ns1:isRelatedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is related to "@en ;
    rdfs:comment "The most generic object property. Connects an Thing to any other\\n            Thing This is a symmetric object property."@en ;
    rdfs:domain ns1:Thing ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns1:Thing ;
    ns1:RiCCMCorrespondingComponent "RiC-R001 (is related to\\n            relation)"@en .

ns1:RecordResource a owl:Class ;
    rdfs:label "Record Resource"@en ;
    rdfs:comment "A Record, Record Set, or Record Part produced or acquired and\\n            retained by an Agent in the course of Activity."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Instantiation ;
            owl:onProperty ns1:hasInstantiation ],
        ns1:Thing ;
    skos:changeNote [ dc:date "2021-02-08" ;
            rdf:value "Removed one Restriction."@en ],
        [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs plus very few\\n                    changes."@en ] ;
    skos:scopeNote "Producing a record resource may imply either its newly\\n            creation or a reuse of previous existing information by combination, rearrangement,\\n            selecting, reformatting etc. Records, Record Sets, and Record Parts are all evidence of\\n            the activities of an Agent. More than one Agent may be involved in the creation of a\\n            Record Resource. The role of the Agent in creating the Record Resource may take\\n            different forms, for example, authoring of an individual record, accumulating a set of\\n            records, or forming a set of records. Though a Record, Record Set, and Record Part,\\n            under most circumstances, may be easily distinguished from one another, frequently\\n            identifying the boundary of each and how the “bounded information regions” interrelate,\\n            may present particular challenges. Documentary Forms provide the rules governing many\\n            Records, providing criteria for identifying its boundary, and identifying its essential\\n            Record Parts. Many Records, though, do not have well-established documentary forms,\\n            particularly electronic records, where it may be difficult to determine whether\\n            individual elements represented in separate bitstreams are record parts, records, or\\n            record sets. For example, is a photograph represented independently in a bitstream\\n            embedded in a text document a Record, or a Record Part ? Or is the same photograph\\n            attached to an email, maintaining its independent representation, a Record or a Record\\n            Part? When information is grouped for some purpose, for example, zip or tar “file\\n            compression” for saving storage space, presents a further challenge. One file comprises\\n            multiple bitstreams subjected to techniques that remove bits that can be losslessly\\n            recovered when decompressed. Under what circumstances is such a compressed bitstream a\\n            Record or a Record Set? Determining when an information object is a Record, Record Part,\\n            or Record Set is based on perspective and judgement exercised in a particular context.\\n            In one context, the Agent describing an information object may designate it a Record,\\n            while another Agent in a different context may designate it a Record Part. Both\\n            designations are supported by RiC, and the significance of the difference for users of\\n            the records is ameliorated by the fact that attributes and relations employed in\\n            describing each of the record entities are shared."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E02 (Record Resource\\n            entity)"@en .

ns1:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A human being with a social identity or persona."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:OccupationType ;
            owl:onProperty ns1:hasOrHadOccupationOfType ],
        ns1:Agent ;
    owl:disjointWith ns1:Position ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Scope note: made separate paragraphs and updated. Disjoint\\n                    with: enriched. Objective: to make RiC-O compliant with RiC-CM v0.2."@en ],
        [ dc:date "2021-02-08" ;
            rdf:value "Removed one Restriction."@en ] ;
    skos:scopeNote "Person is a kind of Agent. Most commonly, a human being\\n            (biological person) has a single coeval social identity or persona. In everyday\\n            discourse, this is the “real person.” Less common though not rare, over the course of a\\n            lifetime, personae in addition to the coeval (or “original”) persona may be associated\\n            with the human being. Such “alternative personae” are most often created by the original\\n            person for specific purposes. Under some circumstances, an alternative persona might\\n            eclipse or replace the original person (Mark Twain eclipsing Samuel Clemens; John Wayne\\n            eclipsing Marion Mitchell Morrison), that is, the social (shared) alternative identity\\n            becomes the predominate identity. Less common is whentwo or more persons collaborate to\\n            create a shared persona. Persona shared by two or more Persons constitute a kind of\\n            Group. Within the archival context, the original Person generally will be the focus of\\n            the description, with alternative personae noted. Exceptionally, an alternative persona\\n            may displace the coeval persona.s."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E08 (Person\\n            entity)"@en .

ns1:Instantiation a owl:Class ;
    rdfs:label "Instantiation"@en ;
    rdfs:comment "The inscription of information made by an Agent on a physical\\n            carrier in any persistent, recoverable form as a means of communicating information\\n            through time and space."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:RepresentationType ;
            owl:onProperty ns1:hasRepresentationType ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:ProductionTechniqueType ;
            owl:onProperty ns1:hasProductionTechniqueType ],
        [ a owl:Restriction ;
            owl:allValuesFrom ns1:CarrierType ;
            owl:onProperty ns1:hasCarrierType ],
        ns1:Thing ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "Comment: updated. Scope note: updated and made several\\n                    paragraphs. Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "A Record or Record Part must have been instantiated at least\\n            once, though this instantiation may no longer exist at the moment of description. An\\n            instantiation might also exist at the moment of description, but be destroyed at a later\\n            moment in time, when, for example, a derived instantiation might become the only\\n            remaining instantiation. A Record Set may have an instantiation, which is to say that it\\n            is not a necessary condition. An Instantiation may be derived from another\\n            Instantiation. A Record Resource may have many Instantiations simultaneously (for\\n            instance, a record printed and saved in the same time as DOCX and PDF/A would have 3\\n            concurrent instantiations) or through time (for example, copy of a record). Depending on\\n            the context, a new instantiation may be seen as a new or as the same record resource.\\n            During in the process of re-instantiation something is lost and something is preserved,\\n            but it is up to the context and the Agent that produces or uses that Instantiation to\\n            assess whether the two instantiations are functionally equivalent or not. For instance,\\n            a postcard representing a town map from 1874 (Instantiation 1) is digitized and kept as\\n            a JPEG file (Instantiation 2). The digital copy may be considered as instantiating the\\n            \"same\" Record by an Agent considering the information transmitted by the Record (e.g.,\\n            the urban landscape displayed), but as a\" different\" Record by an antiquarian more\\n            focused on the materiality of the carrier. Successive instantiations may change the\\n            perceivable boundaries of a Record Resource. For instance, a case file comprising many\\n            records may be digitized and saved as one single PDF file, which, from management\\n            perspective, may be treated as one Record. Similarly, a large Record Set (a fonds or a\\n            series) may be maintained as one database. On the other hand, one record (main document\\n            and its annexes) may be digitized in separate files and each one may be managed as a\\n            discrete “physical” item. Instantiations may require mediation to communicate the\\n            information in the Record Resource. While a traditional Record on paper can simply be\\n            read by an Agent in order to understand the information, a vinyl recording, a video\\n            cassette or a digital file needs a device (mediator) to codify or decodify the\\n            information conveyed. This mediator may imply simple physical components (a turntable\\n            needle, for example), or a complex gallery of software and hardware elements.\\n            Instantiations are more than the mere informational content of Record Resource and may\\n            be the focus of preservation and physical management of records. The use of particular\\n            document types for records, such as a medieval charter, may have implications for the\\n            authenticity of the records. Hence, the way a Record Resource is instantiated\\n            contributes to the contextualizing of the content.record resource is instantiated\\n            contributes to the contextualizing the content. Distinguishing the message conveyed\\n            (Record Resource) and its physical representations (Instantiation) allows for the\\n            efficient management of their descriptions, and preserve information about a Record\\n            Resource even when no physical representation of it exists or is known to exist anymore.\\n            The relations between distinct instantiations can then be expressed wherever they\\n            coexist, and they can be related to the Record Resource they\\n            instantiate."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E06 (Instantiation\\n            entity)"@en ;
    ns1:closeTo "PREMIS Representation"@en .

ns1:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "A Person, or Group, or an entity created by a Person or Group\\n            (Mechanism), or a Position, that acts in the world."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns1:Thing ;
    skos:changeNote [ dc:date "2021-02-08" ;
            rdf:value "removed the Restrictions"@en ],
        [ dc:date "2020-10-23" ;
            rdf:value "Comment: updated. Scope note: updated and made several\\n                    paragraphs. Objective: to make RiC-O compliant with RiC-CM v0.2."@en ] ;
    skos:scopeNote "An Agent may have one or more identities; an identity is a\\n            constellation of properties or relations that together “identify” the Agent. A Person or\\n            Group commonly has one identity, though each also may have one or more alternative\\n            identities. Such alternative identities may be shared by more than one Person or Group.\\n            Alternative identities include but are not limited to pseudonyms, heteronyms, DBA (Doing\\n            Business As), and trade identities. An alternative identity should not be confused with\\n            a Position in a Group, for example, presidents, prime ministers, governors, popes,\\n            royalty, or bishops. Nor should an alternative identity be confused with a variant name\\n            or identifier of the same identity. Agent also includes entities created by a Person or\\n            Group that act on behalf of the creating Agent in an autonomous or semi-autonomous\\n            manner. Examples of a Mechanism include software agents, robots, and space and\\n            underwater probes that generate data (records) in the course of Activity assigned to and\\n            in conformance with the instructions given to them by the creating Person or\\n            Group."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E07 (Agent\\n            entity)"@en .

ns1:Thing a owl:Class ;
    rdfs:label "Thing"@en ;
    rdfs:comment "Any idea, material thing, or event within the realm of human\\n            experience."@en ;
    rdfs:isDefinedBy onto: ;
    skos:changeNote [ dc:date "2020-10-23" ;
            rdf:value "made separate paragraphs in the scope note."@en ] ;
    skos:scopeNote "Includes all RiC entities as well as any concept, material\\n            thing, or event that may be the subject of a Record Resource or associated with an\\n            Activity. Examples of entities not explicitly addressed in RiC includes but is not\\n            limited to the following: abstract concepts; cultural movements, named periods and\\n            events; named things, objects and works; legendary, mythical or fictitious figures,\\n            characters or beings."@en ;
    ns1:RiCCMCorrespondingComponent "Corresponds to RiC-E01 (Thing\\n            entity)"@en .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual,
        owl:Ontology ;
    rdfs:label "International Council on Archives Records in Contexts Ontology\\n            (ICA RiC-O) version 0.2"@en ;
    ns2:license <https://creativecommons.org/licenses/by/4.0/> ;
    dc:contributor "Aaron Rubinstein (University of Massachusetts Amherst, USA),\\n            member of EGAD"@en,
        "Daniel Pitti (University of Virginia, USA), chair of\\n            EGAD"@en,
        "Miia Herrala (National Archives of Finland), member of\\n            EGAD"@en,
        "Tobias Wildi (Docuteam GmbH, Switzerland), member of\\n            EGAD"@en ;
    dc:creator "Florence Clavaud (Archives nationales de France), member of EGAD,\\n            lead of EGAD RiC-O team"@en,
        "International Council on Archives Expert Group on Archival\\n            Description (ICA EGAD)"@en ;
    dc:publisher "International Council on Archives"@en ;
    dc:rights "Copyright 2019-...., International Council on Archives\\n            (ICA)"@en ;
    dcterms:abstract "\\n            <html:div xmlns:html=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\">\\n                <html:p>RiC-O (Records in Contexts-Ontology) is an OWL ontology for describing\\n                    archival record resources. As the second part of Records in Contexts standard,\\n                    it is a formal representation of Records in Contexts Conceptual Model (RiC-CM). </html:p>\\n                <html:p>The current official version is <html:strong>v0.2</html:strong>; it is\\n                    compliant with RiC-CM v0.2 full draft, that will be published in February or\\n                    March 2021, and that is slightly different from <html:a href=\"https://www.ica.org/sites/default/files/ric-cm-0.2_preview.pdf\">RiC-CM\\n                        v0.2 preview</html:a>, that was published in December 2019.</html:p>\\n                <html:p>RiC-O provides a generic vocabulary and formal rules for creating RDF\\n                    datasets (or generating them from existing archival metadata) that describe in a\\n                    consistent way any kind of archival record resource. It can support publishing\\n                    RDF datasets as Linked Data, querying them using SPARQL, and making inferences\\n                    using the logic of the ontology.</html:p>\\n            </html:div>\\n        "^^rdf:XMLLiteral ;
    dcterms:contributor <http://www.isni.org/0000000039584825> ;
    dcterms:creator <https://data.bnf.fr/ark:/12148/cb169702205#about> ;
    dcterms:description "\\n            <html:div xmlns:html=\"http://www.w3.org/1999/xhtml\" id=\"introduction\" xml:lang=\"en\">\\n                <html:h3>Introduction</html:h3>\\n                <html:p>RiC-O (Records in Contexts-Ontology) is an OWL ontology for describing\\n                    archival record resources. As the second part of Records in Contexts standard,\\n                    it is a formal representation of Records in Contexts Conceptual Model (RiC-CM).\\n                    This version, which is v0.2, is the current official release. It is compliant\\n                    with RiC-CM v0.2, that will be published soon after the release of RiC-O\\n                    v0.2.</html:p>\\n                <html:p>The following diagram shows the main RiC-CM v0.2 entities and a few\\n                    relations between them: <html:img alt=\"A partial overview of RiC-CM v0.2 main entities\" class=\"diagram\" src=\"https://raw.githubusercontent.com/ICA-EGAD/RiC-O/master/diagrams/diagrams_v0-2/RiC-CM-overview/diagram_RiC-CM-overview-RiC-v0-2.jpg\"/>\\n                </html:p>\\n                <html:div id=\"design-principles\">\\n                    <html:h4>RiC-O design principles</html:h4>\\n                    <html:p>The following design principles were followed when developing\\n                        RiC-O.</html:p>\\n                    <html:p>\\n                        <html:strong>RiC-O is a domain or reference ontology</html:strong>.</html:p>\\n                    <html:p>It provides a generic vocabulary and formal rules for creating RDF\\n                        datasets (or generating them from existing archival metadata) that describe\\n                        in a consistent way any kind of archival record resource. It can support\\n                        publishing RDF datasets as Linked Data, querying them using SPARQL, and\\n                        making inferences using the logic of the ontology.</html:p>\\n                    <html:p>While some projects have built some specific ontologies for describing\\n                        archives, at this time no generic domain ontology exists for the specific\\n                        needs of the archival community. This is why EGAD decided to develop RiC-O\\n                        as the second part of RiC standard.</html:p>\\n                    <html:p>Apart this first, main target, RiC-O also can help archival institutions\\n                        and engineers to design and develop other technical implementations of\\n                        RiC-CM that represent record resources and their layers of contexts as\\n                        oriented, interconnected graphs. Of course, other technical implementations\\n                        may be developed later on, including XML models, or (hopefully) new versions\\n                        of EAD and EAC-CPF XML models.</html:p>\\n                    <html:p>As RiC-O is a generic, domain ontology, it does not address by itself\\n                        every specific need or expectation that may occur in every archival\\n                        institution or project. It is rather a high level framework and a project\\n                        can either limit itself to the use of a selection of components, or can add\\n                        more subcomponents where needed.</html:p>\\n                    <html:p>As a domain ontology, RiC-O, at this stage at least, does not borrow any\\n                        component from other existing ontologies (such as the cultural heritage\\n                        models – IFLA-LRM and CIDOC-CRM, PREMIS, or PROV-O). It should therefore be\\n                        easier, for an archival institution or archival project, to understand,\\n                        implement and maintain RiC-O within its system.</html:p>\\n                    <html:p>Later on, RiC-O will be aligned with these existing models. This is of\\n                        course essential for interconnecting RDF datasets conforming to RiC-O with\\n                        other datasets, or for using parts of RiC-O in other contexts than the\\n                        archival or records management realm.</html:p>\\n                    <html:p>\\n                        <html:strong>RiC-O must be immediately usable.</html:strong>\\n                    </html:p>\\n                    <html:p>This is a key feature for a new model. In particular, it is very\\n                        important that existing archival metadata, that are created or generated in\\n                        current information systems, can be converted to RDF conforming to RiC-O,\\n                        without losing any data, structural or partially implicit information. What\\n                        is at stake here is that metadata conforming to the previous existing ICA\\n                        standards can be processed successfully.</html:p>\\n                    <html:p>During the ongoing development process, a lot of successful testing has\\n                        been made, using XML/EAD finding aids and XML/EAC-CPF authority records,\\n                        that have been converted to RDF datasets, either by hand or using scripts. A\\n                        conversion software is being developed and will soon be available.</html:p>\\n                    <html:p>While some existing metadata sets may have a very fine level of\\n                        granularity and accuracy, already using, for example, controlled\\n                        vocabularies, or describing curation events separately, often these metadata\\n                        don’t have the very precise structure that RiC-CM recommends. Even then,\\n                        such a conversion process should remain possible. In order to allow this,\\n                        RiC-O sometimes provides several methods for representing information (as\\n                        described below). From this point of view, the current official version of\\n                        RiC-O may be considered a transitional ontology, in which some components\\n                        may be deprecated later on.</html:p>\\n                    <html:p> The usability of a model also depends on its documentation. That’s why\\n                        the current official release has been fully documented (this documentation\\n                        will be continously improved).</html:p>\\n                    <html:p>RiC-O will also soon be acompanied with examples (RDF datasets). Some\\n                        tutorials should also be written, and EGAD will organize practical\\n                        workshops.</html:p>\\n                    <html:p>\\n                        <html:strong>RiC-O has to provide a flexible\\n                        framework</html:strong>.</html:p>\\n                    <html:p>This is a very important principle too. It is related with the usability\\n                        principle quoted above. Moreover, archival description is flexible by\\n                        essence. It is quite commonly noted that the level of granularity of\\n                        information varies from one finding aid to another (or from one authority\\n                        record to another), or even within the same finding aid. Some series or\\n                        agents are described summarily because little is known about them and there\\n                        is little time for extensive research, while other series, even records, or\\n                        agents are described in detail; some relations (e.g. that relating to\\n                        provenance) may be described without any detail while others may be\\n                        thoroughly documented, as ISAAR(CPF) and EAC-CPF allow it.</html:p>\\n                    <html:p>Being generally flexible, for an OWL ontology, depends first on the\\n                        polyhierarchical systems of classes and properties it provides. A\\n                        superproperty or superclass, more general or generic than its subproperties\\n                        or subclasses, must exist and be available for handling information, while\\n                        at the same time more accurate subcomponents must be there for handling more\\n                        accurate description. Also, RiC-O should provide several methods for\\n                        expressing whether relations are well attested and certain, or are more vague,\\n                        as well as direct and short paths between entities alongside more complex\\n                        ones.</html:p>\\n                    <html:p>\\n                        <html:strong>RiC-O opens new potential for archival\\n                            description.</html:strong>\\n                    </html:p>\\n                    <html:p>This means that Linked Data tools and interfaces should enable end users\\n                        to go through RDF/RiC-O graphs, to query them using SPARQL in an efficient\\n                        way and to consult archival metadata and their contexts in new ways. As an example,\\n                        an end user should be able to ask « What are (according to your dataset) the\\n                        corporate bodies that succeeded to this given entity from its end of\\n                        existence, by 1840, to nowadays (as concerns this given activity) ?» or «\\n                        tell me what instantiations of this photograph exist? » « what are the\\n                        existing copies of this original charter?», and get a list of these\\n                        entities. In other words, institutions or projects that make the effort to\\n                        implement RiC-O will get new insight into the content and context of their\\n                        archives that wasn't visible with the existing ICA-standards. It should be\\n                        even more interesting if you can infer new assertions from the RDF datasets\\n                        you built, and of course link your datasets to other ressources outside of\\n                        your institution.</html:p>\\n                    <html:p>\\n                        <html:strong>RiC-O should be extensible</html:strong>.</html:p>\\n                    <html:p>Institutions are free to extend the ontology by adding new subclasses or\\n                        subproperties if needed. RiC-O has also the potential to be useable in other\\n                        contexts than purely archival ones. This implies that hierarchies of classes\\n                        and properties are defined and that mappings are developed with other\\n                        ontologies as mentioned above. It may also imply that RiC-O should provide\\n                        “hooks” enabling connections with, for example, existing SKOS\\n                        vocabularies.</html:p>\\n                </html:div>\\n                <html:div id=\"understanding-RiCO\">\\n                    <html:h4>Understanding RiC-O: a quick overview of some features</html:h4>\\n                    <html:div id=\"fromRiCCM-to-RiCO\">\\n                        <html:h5>From RiC-CM to RiC-O</html:h5>\\n                        <html:p>In the <html:strong>system of classes of RiC-O,</html:strong> for\\n                            each RiC-CM entity, you can find a corresponding class. These classes\\n                            are organized according to the same hierarchy as in RiC-CM. In some\\n                            projects, you may need very few of them (e.g. Agent, Record Resource and\\n                            Activity only), while in other ones, you may need more (e.g. Corporate\\n                            Body and Person; Record; Place; Provenance Relation).</html:p>\\n                        <html:p>Certain classes only exist in RiC-O and not in RiC-CM. These\\n                            additional classes address special needs:</html:p>\\n                        <html:ul>\\n                            <html:li>some correspond to RiC-CM attributes, when it may be considered\\n                                necessary to handle them as full entities. This is the case for\\n                                    <html:a href=\"#rico:Type\">Type</html:a> and its subclasses, that\\n                                correspond to RiC-CM attributes that contain controlled values, and\\n                                that can help to articulate RiC-O with external RDF resources like\\n                                SKOS vocabularies; and also for <html:a href=\"#rico:Language\">Language</html:a>, <html:a href=\"#rico:Name\">Name</html:a> and\\n                                    <html:a href=\"#rico:Identifier\">Identifier</html:a>, that can be\\n                                considered as full entities and as key linking nodes in a RDF graph.\\n                                All these classes have been grouped under a <html:a href=\"#rico:Concept\">Concept</html:a> class. </html:li>\\n                            <html:li>some classes have been added in order to provide a more\\n                                accurate definition and model for some entities. <html:a href=\"#rico:Place\">Place</html:a> thus comes along with a\\n                                    <html:a href=\"#rico:PhysicalLocation\">Physical Location\\n                                    class</html:a>, and with a <html:a href=\"#rico:Coordinates\">Coordinates class</html:a>. A Place is considered both a \\n                                geographical and historical entity. As a historical entity, among\\n                                other features, it has a history, and may be preceded or succeeded\\n                                by other Places. A Place also may have zero to many Physical\\n                                Location through time (for instance, its boundaries, if it is an\\n                                administrative area or a country, may change). Each Physical\\n                                Location may be connected to zero to many Coordinates. This model is\\n                                quite close to the Linked Places Format (<html:a href=\"https://github.com/LinkedPasts/linked-places\">https://github.com/LinkedPasts/linked-places</html:a>). Another\\n                                example of such an addition is the <html:a href=\"#rico:Proxy\">Proxy\\n                                    class</html:a>, that represents (stands for) a Record Resource\\n                                as it exists in a specific Record Set.</html:li>\\n                            <html:li>finally, a system of classes helps to implement the Relations\\n                                section of RiC-CM.<html:br/> While these relations also are\\n                                represented as simple, binary object properties (e.g. <html:a href=\"#rico:hasProvenance\">‘hasProvenance’</html:a> that\\n                                corresponds to RiC-R026 relation), you may need to assign different\\n                                attributes to a relation, e.g. a date, certainty or description, as\\n                                it is already possible, and quite often done, in a XML/EAC-CPF file.\\n                                One of the standard available methods for representing such a\\n                                documented relation in RDF for now is to use a class. RDF* and\\n                                SPARQL* specification, which is being developed by the W3C RDF-DEV\\n                                Community Group, provides a far simpler method (allowing to consider\\n                                a triple as the subject or object of another triple; see <html:a href=\"https://w3c.github.io/rdf-star/\">https://w3c.github.io/rdf-star/</html:a>) and is already being\\n                                used by some tools; however it is not yet a W3C standard. Thus, for\\n                                example, in RiC-O an <html:a href=\"#rico:AgentOriginationRelation\">AgentOriginationRelation class</html:a> exists. This class may\\n                                connect one to many Agents to one to many created or accumulated\\n                                Record Resources or Instantiations, and has some specific object\\n                                properties (certainty, date, description, source). Back to the\\n                                ‘hasProvenance’ object property, let us add that it is formally\\n                                defined in RiC-O, using OWL 2 property chain axiom (see <html:a href=\"https://www.w3.org/TR/owl2-new-features/\">https://www.w3.org/TR/owl2-new-features/</html:a>, as a\\n                                ‘shortcut’ for the longer path\\n                                ‘recordResourceOrInstantiationIsSourceOfAgentOriginationRelation/agentOriginationRelationHasTarget’,\\n                                where the intermediate node is an instance of Agent Origination Relation:<html:br/>\\n                                <html:code> &lt;owl:propertyChainAxiom\\n                                    rdf:parseType=&quot;Collection&quot;&gt; <html:br/> &lt;rdf:Description\\n                                    rdf:about=&quot;https://www.ica.org/standards/RiC/ontology#recordResourceOrInstantiationIsSourceOfAgentOriginationRelation&quot;/&gt;\\n                                    <html:br/> &lt;rdf:Description\\n                                    rdf:about=&quot;https://www.ica.org/standards/RiC/ontology#agentOriginationRelationHasTarget&quot;/&gt;\\n                                    <html:br/> &lt;/owl:propertyChainAxiom&gt; </html:code>\\n                                <html:br/>A triplestore, with the appropriate configuration, may\\n                                thus infer the direct ‘hasProvenance’ assertion from this long\\n                                path.</html:li>\\n                        </html:ul>\\n                        <html:p>Most of the <html:strong>datatype properties in RiC-O\\n                            </html:strong>correspond to RiC-CM attributes that contain free, plain\\n                            text. See for example <html:a href=\"#rico:descriptiveNote\">rico:descriptiveNote</html:a>, <html:a href=\"#rico:history\">rico:history</html:a> and <html:a href=\"#scopeAndContent\">rico:scopeAndContent</html:a>.</html:p>\\n                        <html:p>In addition to these datatype properties, the Name and Identifier\\n                            RiC-CM attributes also have corresponding classes (subclasses of <html:a href=\"#rico:Appellation\">rico:Appellation</html:a>). A resource may\\n                            have several Identifiers and each comes with different attributes (e.g.\\n                            archival reference code, system number, digital object identifier), in\\n                            this case the identifiers will be modelled in a class. In many simpler\\n                            usecases it's sufficent to just use the <html:a href=\"#rico:identifier\">identifier datatype property</html:a>, typically for the archival\\n                            reference code.</html:p>\\n                        <html:p>The Location RiC-CM attribute also has a <html:a href=\"#rico:PhysicalLocation\">rico:Physical Location corresponding\\n                                class</html:a> (for users who want to use Place, Physical Location\\n                            and Coordinates for handling places).</html:p>\\n                        <html:p>As already said too, every RiC-CM attribute that has ‘controlled\\n                            value’ or ‘rule-based’ as a schema value, has a class as corresponding\\n                            component in RiC-O. For these CM attributes that correspond to a RiC-O\\n                            class, as it is necessary to provide an immediately usable ontology, two\\n                            supplementary datatype properties exist that allow not to use the\\n                            classes, at least for a while, if you want to implement RiC-O and create\\n                            RiC-O/RDF datasets from existing archival metadata without being able to\\n                            handle URIs for the information you have.</html:p>\\n                        <html:p>For example, you may not be able to handle and maintain URIs for\\n                            some controlled values you use in EAD finding aids for carrier types:\\n                            maybe your information system does not use a vocabulary for this, and\\n                            you cannot for a while consider these carrier types as full entities.\\n                            Nevertheless you want to produce RiC-O datasets where every piece of\\n                            information is kept, and you want to avoid blank nodes. If RiC-O would\\n                            only provide the Carrier Type class, it would be an issue for you. So\\n                            RiC-O provides a <html:a href=\"#rico:type\">rico:type datatype\\n                                property</html:a>, with range rdfs:literal, which allows you to move\\n                            forward.</html:p>\\n                        <html:p>Therefore, for the RiC-CM *Type attributes, you have a corresponding\\n                                <html:a href=\"#rico:type\">rico:type datatype property</html:a>. For\\n                            RiC-CM Coordinates attribute, you also have <html:a href=\"#rico:geographicalCoordinates\">rico:geographicalCoordinates\\n                                datatype property</html:a>.</html:p>\\n                        <html:p>These datatype properties have a skos:scopeNote which says (for\\n                            example) &quot;Provided for usability reasons. May be made deprecated or\\n                            removed later on. Use only if you don't use Physical Location and\\n                            Coordinates classes with Place.&quot;</html:p>\\n                        <html:p>The same key design principle (RiC-O must be immediately usable) led\\n                            us to define some datatype properties that would enable users to use\\n                            RiC-O in simple usecases where they do not want to consider dates and\\n                            rules as full entities. Thus, there of course is Date and Rule classes\\n                            in RiC-O (since there are Date and Rule entities in RiC-CM). And you\\n                            also have 'date' datatype properties; plus a <html:a href=\"#rico:ruleFollowed\">rico:ruleFollowed datatype\\n                                property</html:a>. The same analysis led us to keep the <html:a href=\"#rico:history\">rico:history</html:a> datatype property in\\n                            RiC-O (same as RiC-CM history attribute), while RiC-CM and RiC-O also\\n                            provide the <html:a href=\"#rico:Event\">Event class</html:a>, and using a\\n                            series of Events may of course be a better method, easier to query, link\\n                            and display, than simply using a history prose discourse. The two\\n                            methods may be used in parallel within the same dataset by an\\n                            institution that, for example, would decide to emphasize only the\\n                            accession, appraisal and description events among the whole history of\\n                            Record resources.</html:p>\\n                        <html:p>These datatype properties have the same kind of skos:scopeNote as\\n                            above.</html:p>\\n                        <html:p>Finally, we have introduced a few datatype properties that do not\\n                            correspond to any RiC-CM attribute.</html:p>\\n                        <html:p>Some are superproperties, and thus group datatype properties\\n                                (<html:a href=\"#rico:physicalOrLogicalExtent\">rico:physicalOrLogicalExtent</html:a>, with rico:carrierExtent,\\n                            rico:instantiationExtent and rico:recordResourceExtent as subproperties\\n                            ; <html:a href=\"#rico:textualValue\">rico:textualValue</html:a>, with\\n                            rico:expressedDate and rico:normalizedValue as subproperties; <html:a href=\"#rico:measure\">rico:measure</html:a> (and its subproperties);\\n                                <html:a href=\"#rico:referenceSystem\">rico:referenceSystem</html:a>,\\n                            superproperty of rico:dateStandard (and of other datatype properties\\n                            that do not exist in RiC-CM.)</html:p>\\n                        <html:p>Some are simply more specific properties : <html:a href=\"#rico:accrualStatus\">rico:accrualStatus</html:a> ; <html:a href=\"#rico:recordResourceStructure\">rico:recordResourceStructure</html:a> and <html:a href=\"#rico:instantiationStructure\">rico:instantiationStructure</html:a>, subproperties of\\n                            rico:structure ; <html:a href=\"#rico:title\">rico:title</html:a>\\n                            (subproperty of rico:name) ; rico:altitude, rico:latitude,\\n                            rico:longitude (subproperties of rico:measure), rico:geodesicSystem and\\n                            rico:altimetricSystem (subproperties of rico:referenceSystem).</html:p>\\n                        <html:p>In order to connect all the classes created, <html:strong>a\\n                                significant number of object properties have been\\n                                defined</html:strong>. While their 'flat' list is a long one, they\\n                            are grouped hierarchically, so that one can use the upper to\\n                            intermediate level ones for simplicity sake, or choose the most accurate\\n                            and expressive ones, or extend the system adding a subproperty easily.\\n                            It is expected that, in most use cases, a subset of these properties\\n                            only will be needed. As already said above, some of the object\\n                            properties are also formally defined as shortcuts.</html:p>\\n                        <html:p>Finally, let us mention that we added to RiC-O six individuals,\\n                            considering that they would address current and frequent needs:</html:p>\\n                        <html:ul>\\n                            <html:li>Two (<html:a href=\"#FindingAid\">FindingAid</html:a> and <html:a href=\"#AuthorityRecord\">AuthorityRecord</html:a>) are \\n                                instances of both RiC-O Documentary Form Type and SKOS Concept.\\n                                They can be used for categorizing Records, finding aids and\\n                                authority records being considered as Records. A Record that would\\n                                have ‘Finding Aid’ as a Documentary Form Type, can be connected to\\n                                one to many Record Resources using 'rico:describes’ object\\n                                property.</html:li>\\n                            <html:li>Four (<html:a href=\"#Fonds\">Fonds</html:a>, <html:a href=\"#Series\">Series</html:a>, <html:a href=\"#File\">File</html:a>, and <html:a href=\"#Collection\">Collection</html:a>) are both instances of the Record Set Type\\n                                class, and of skos:Concept. Their definition is taken from the\\n                                ISAD(G) glossary. They can be used for categorizing Record\\n                                Sets.</html:li>\\n                        </html:ul>\\n                        <html:p>In the future, we can imagine that many other categories of the kind\\n                            will be defined by the archival community, forming at least rich SKOS\\n                            (hopefully multilingual) vocabularies. Considering the concepts thus\\n                            defined as being also instances of some RiC-O classes may be of great\\n                            interest for producing a richer description (for example, an instance of\\n                            the <html:a href=\"#rico:DocumentaryFormType\">Documentary Form Type\\n                                class</html:a> may have a history and some temporal relations to\\n                            other documentary form types).</html:p>\\n                    </html:div>\\n                    <html:div id=\"RiCO-documentation\">\\n                        <html:h5>RiC-O documentation and annotation properties</html:h5>\\n                        <html:p>Each class or property has at least an English label (rdfs:label)\\n                            and description (rdfs:comment). Some have a skos:scopeNote or a\\n                            skos:example.</html:p>\\n                        <html:p>When a RiC-O class or property corresponds in a way to a RiC-CM\\n                            component, its description and scope note are, either the same as, or\\n                            derived from, their definition and scope note in RiC-CM.</html:p>\\n                        <html:p>We have created two annotation properties, subproperties of\\n                            rdfs:comment, for handling:</html:p>\\n                        <html:ul>\\n                            <html:li>Information about the corresponding RiC-CM component when\\n                                appliable (<html:a href=\"#rico:RiCCMCorrespondingComponent\">rico:RiCCMCorrespondingComponent</html:a>). Various phrasings\\n                                are used in this property depending on the rule applied for defining\\n                                the RiC-CM component.</html:li>\\n                            <html:li>Information, most often in prose text for now, about possible\\n                                mappings with other models or ontologies (<html:a href=\"#rico:closeTo\">rico:closeTo</html:a>, rarely used in this\\n                                0.1 version)).</html:li>\\n                        </html:ul>\\n                        <html:p>Finally, in this official 0.2 release, any change in the definition\\n                            of a class or property, since December 2019, is documented using a\\n                            skos:changeNote.</html:p>\\n                    </html:div>\\n                </html:div>\\n                <html:div id=\"next-steps\">\\n                    <html:h4>Next steps</html:h4>\\n                    <html:p>The following is a non exhaustive list of known issues, topics or tasks\\n                        on which EGAD has begun to work and will continue to work in the next\\n                        months:</html:p>\\n                    <html:ul>\\n                        <html:li>providing more examples of known implementations of RiC-O in\\n                            different institutions and contexts. The goal is to show different\\n                            practices on how RiC-O is being implemented. We have begun to release\\n                            such examples in the <html:a href=\"https://github.com/ICA-EGAD/RiC-O\">public RiC-O repository on GitHub</html:a>. One can also have a\\n                            look at the <html:a href=\"https://ica-egad.github.io/RiC-O/projects-and-tools.html\">Projects and tools page on RiC-O website</html:a>.</html:li>\\n                        <html:li>finishing the system of relations (where some subclasses are still\\n                            missing)</html:li>\\n                        <html:li>assessing, and changing in some cases, the tense of the verbs in\\n                            some object properties (e.g. for the properties that correspond to some\\n                            RiC-CM relations). This has been done, following RiC-CM v0.2 updates,\\n                            where many relations have changed name so that they can be used for\\n                            recording both past and present situations.</html:li>\\n                        <html:li>articulating the Event and Activity classes, and the Relation\\n                            system of classes</html:li>\\n                        <html:li>improving the names of object properties. This has been done,\\n                            following RiC-CM v0.2 updates and applying a few naming rules, so that,\\n                            for example, the same verb is used for naming a relation and the inverse\\n                            relation when it exists.</html:li>\\n                        <html:li>adding suggestions of mappings (in rico:closeTo) and OWL\\n                            equivalences between some classes or properties and components in other\\n                            models (among which - this is not an exhaustive list- CIDOC-CRM,\\n                            IFLA-LRM, PREMIS, PROV-O, Wikidata and Schema.org)</html:li>\\n                        <html:li>documenting RiC-O in French and Spanish</html:li>\\n                        <html:li>providing users with some SPARQL constructs for\\n                            inferring.</html:li>\\n                    </html:ul>\\n                </html:div>\\n            </html:div>\\n        "^^rdf:XMLLiteral ;
    dcterms:publisher <http://www.wikidata.org/entity/Q1421986> ;
    dcterms:title "International Council on Archives Records in Contexts Ontology\\n            (ICA RiC-O) version 0.2"@en ;
    vann:preferredNamespacePrefix "rico" ;
    vann:preferredNamespaceUri "https://www.ica.org/standards/RiC/ontology#" ;
    owl:priorVersion <https://www.ica.org/standards/RiC/RiC-O_v0-1.rdf> ;
    owl:versionInfo "Version 0.2 - 2021-02-12."@en ;

