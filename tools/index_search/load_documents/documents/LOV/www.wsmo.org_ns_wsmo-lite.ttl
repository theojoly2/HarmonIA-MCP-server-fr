@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://www.wsmo.org/ns/wsmo-lite#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:Condition a rdfs:Class ;
    rdfs:label "Condition"@en ;
    rdfs:description "preconditions of services and operations"@en ;
    rdfs:isDefinedBy onto: .

onto:Effect a rdfs:Class ;
    rdfs:label "Effect"@en ;
    rdfs:description "effects (postconditions) of services and operations"@en ;
    rdfs:isDefinedBy onto: .

onto:NonfunctionalParameter a rdfs:Class ;
    rdfs:label "Nonfunctional Parameter"@en ;
    rdfs:description "instances of this class are concrete nonfunctional properties of services"@en ;
    rdfs:isDefinedBy onto: .

onto:Ontology a rdfs:Class ;
    rdfs:label "Ontology"@en ;
    rdfs:description "information model ontology (deprecated)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf owl:Ontology ;
    owl:deprecated true .

<http://www.w3.org/ns/sawsdl#liftingSchemaMapping> a rdf:Property .

<http://www.w3.org/ns/sawsdl#loweringSchemaMapping> a rdf:Property .

<http://www.w3.org/ns/sawsdl#modelReference> a rdf:Property .

onto:FunctionalClassificationRoot rdfs:label "Functional Classification Root"@en ;
    rdfs:description "instances of this class are roots of functionality classification hierarchies"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf rdfs:Class .

onto:usesOntology a rdfs:Property ;
    rdfs:label "uses Ontology"@en ;
    rdfs:description "pointer from a semantic description to an ontology that it uses (deprecated)"@en ;
    rdfs:domain onto:Service ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    owl:deprecated true .

onto: a owl:Ontology ;
    rdfs:label "WSMO-Lite"@en ;
    dcterms:created "2009-04-22"^^xsd:date ;
    dcterms:creator <http://jacek.cz/#me>,
        <http://vitvar.com/> ;
    dcterms:description "This is a lightweight ontology for semantic annotations of services, intended for use with SAWSDL and the Minimal Service Model."@en ;
    dcterms:issued "2009-04-22"^^xsd:date ;
    dcterms:modified "2013-05-30"^^xsd:date ;
    owl:imports <http://iserve.kmi.open.ac.uk/ns/msm>,
        <http://www.w3.org/ns/sawsdl#> ;
    owl:versionInfo "2013-05-30" .

