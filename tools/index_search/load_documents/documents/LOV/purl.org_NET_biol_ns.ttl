onto:authority a rdf:Property ;
    rdfs:label "authority"@en ;
    dcterms:description "The authority who classified this form of life. For example \"Linnaeus, 1758\"."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_authority> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_authority> ;
    rdfs:range rdfs:Literal .

onto:class a rdf:Property ;
    rdfs:label "class"@en ;
    dcterms:description "The third highest level of classification. For example <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Mammalia</i>."^^rdf:XMLLiteral ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_class> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_class> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:rank .

onto:commonName a rdf:Property ;
    rdfs:label "common name"@en ;
    dcterms:description "A non-scientific name. For example, \"Human\"."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_commonName> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_commonName> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf rdfs:label .

onto:division a rdf:Property ;
    rdfs:label "division"@en ;
    dcterms:description "The second highest level of classification, as used by botanists. Note that\\ndivision may be used to describe any form of life — the use of division is\\nnot meant to imply that the entity being described is a plant, merely that\\nbotanical names of ranks are being used. Zoologists use the term \"division\"\\nto describe a rank between an \"infraclass\" and a \"cohort\". biol:division\\nshould not be used for this purpose — use biol:rank instead."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_division> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_division> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:secondLevelClassification .

onto:family a rdf:Property ;
    rdfs:label "family"@en ;
    dcterms:description "The fifth highest level of classification. For example <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Hominidae</i>."^^rdf:XMLLiteral ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_family> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_family> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:rank .

onto:genus a rdf:Property ;
    rdfs:label "genus"@en ;
    dcterms:description "The sixth highest level of classification. For example <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Homo</i>."^^rdf:XMLLiteral ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_genus> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_genus> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:rank .

onto:hasTaxonomy a rdf:Property ;
    rdfs:label "taxonomy"@en ;
    dcterms:description "This property provides a relationship between an entity (such as a <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://xmlns.com/foaf/spec/#term_Person\">foaf:Person</a>) and a taxonomy. Because biologists don't always agree on how to classify life, a single entity may have multiple taxonomies, each of which may be differentiated between using <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"#term_authority\">biol:authority</a> or dc:date."^^rdf:XMLLiteral ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_hasTaxonomy> ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_hasTaxonomy> ;
    rdfs:range onto:Taxonomy ;
    rdfs:subPropertyOf rdf:type .

onto:kingdom a rdf:Property ;
    rdfs:label "kingdom"@en ;
    dcterms:description "The highest-level and least specific level of classification. Example kingdoms are <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Animalia</i> and <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Plantae</i>."^^rdf:XMLLiteral ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_kingdom> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_kingdom> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:rank .

onto:morePrecise a rdf:Property ;
    rdfs:label "more precise"@en ;
    dcterms:description "Connects a taxonomy to a more precise taxonomy. For example, the taxonomy\\n\"Mammal\" might have a \"more precise\" property linking to \"Primate\"."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_morePrecise> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_morePrecise> ;
    rdfs:range onto:Taxonomy ;
    rdfs:subPropertyOf [ owl:inverseOf rdfs:subClassOf ],
        [ owl:inverseOf rdfs:subClassOf ] .

onto:name a rdf:Property ;
    rdfs:label "name"@en ;
    dcterms:description "A scientific name; a binomial or trinomial. For example, <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Homo sapiens</i>."^^rdf:XMLLiteral ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_name> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_name> ;
    rdfs:range rdfs:Literal .

onto:order a rdf:Property ;
    rdfs:label "order"@en ;
    dcterms:description "The fourth highest level of classification. For example \"Primates\"."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_order> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_order> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:rank .

onto:phylum a rdf:Property ;
    rdfs:label "phylum"@en ;
    dcterms:description "The second highest level of classification, as used by zoologists. Note that\\nphylum may be used to describe any form of life — the use of phylum is not\\nmeant to imply that the entity being described is an animal, merely that\\nzoological names of ranks are being used."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_phylum> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_phylum> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:secondLevelClassification .

onto:seeAlso a rdf:Property ;
    rdfs:label "see also"@en ;
    dcterms:description "A link to another resource further describing this form of life."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_seeAlso> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_seeAlso> ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf rdfs:seeAlso .

onto:species a rdf:Property ;
    rdfs:label "species"@en ;
    dcterms:description "The lowest level of classification supported by this vocabulary. For example <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Sapiens</i>. To include information more specific than species, use <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"#term_rank\">biol:rank</a> or <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"#section_Abstract\">a more specialist vocabulary</a>."^^rdf:XMLLiteral ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_species> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_species> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:rank .

<http://en.wikipedia.org/wiki/Taxonomic_rank> dcterms:publisher "Wikipedia"@en ;
    dcterms:title "Taxonomic rank"@en .

<http://microformats.org/wiki/species> dcterms:publisher "microformats.org"@en ;
    dcterms:title "species"@en .

rdf:type rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_type> .

rdfs:Resource rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_resource> .

rdfs:label rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_label> .

rdfs:seeAlso rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_seealso> .

<http://creativecommons.org/licenses/by-sa/2.0/uk/> a <http://creativecommons.org/ns#License> ;
    dcterms:title "Creative Commons Attribution-Share Alike 2.0 (UK: England & Wales) Licence" .

onto:secondLevelClassification a rdf:Property ;
    rdfs:label "second level classification"@en ;
    dcterms:description "The second highest level of classification. Zoologists call these <i xmlns=\"http://www.w3.org/1999/xhtml\">phyla</i> and botanists call them &quot;divisions&quot;. In general, you should pick one of those terms and use it instead."^^rdf:XMLLiteral ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_secondLevelClassification> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_secondLevelClassification> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:rank .

rdfs:subClassOf rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_subclassof> .

rdfs:Class rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_class> .

onto:rank a rdf:Property ;
    rdfs:label "rank"@en ;
    dcterms:description "An unspecified classification. This should not normally be used."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_rank> ;
    rdfs:domain onto:Taxonomy ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_rank> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <urn:lsid:ubio.org:predicates:taxonomicGroup> .

rdfs:Literal rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_literal> .

