@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/1999/xhtml/vocab#> .
@prefix onto: <http://purl.org/NET/biol/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

onto:BotTaxonomy a rdfs:Class ;
    rdfs:label "Botanical Taxonomy"@en ;
    dcterms:description "A BotTaxonomy is a subclass of Taxonomy. It is not necessarily used to\\ndescribe a plant. Most of the time, it is more appropriate to use Taxonomy\\ninstead."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_BotTaxonomy> ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_BotTaxonomy> ;
    rdfs:subClassOf onto:Taxonomy .

onto:Taxonomy a rdfs:Class ;
    rdfs:label "Taxonomy"@en ;
    dcterms:description "A taxonomy is a classification for something. An animal or plant <em xmlns=\"http://www.w3.org/1999/xhtml\">has</em> a taxonomy; an animal or plant <em xmlns=\"http://www.w3.org/1999/xhtml\">is not</em> a taxonomy. For those familiar with object-oriented programming, think of a taxonomy as being analogous to a class, not an object."^^rdf:XMLLiteral ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_Taxonomy> ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_Taxonomy> ;
    rdfs:subClassOf rdfs:Class .

onto:ZooTaxonomy a rdfs:Class ;
    rdfs:label "Zoological Taxonomy"@en ;
    dcterms:description "A ZooTaxonomy is a subclass of Taxonomy. It is not necessarily used to\\ndescribe an animal, but it indicates that certain ambiguous terms, such as\\n\"division\" should be interpreted the way zoologists use them. Most of the\\ntime, it is more appropriate to use Taxonomy instead."@en ;
    ns1:bookmark <http://purl.org/NET/biol/ns.html#term_ZooTaxonomy> ;
    rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_ZooTaxonomy> ;
    rdfs:subClassOf onto:Taxonomy .

onto: a owl:Ontology ;
    dcterms:bibliographicCitation <http://en.wikipedia.org/wiki/Taxonomic_rank>,
        <http://microformats.org/wiki/species> ;
    dcterms:conformsTo <http://www.w3.org/TR/rdfa-syntax> ;
    dcterms:creator [ a foaf:Person ;
            onto:hasTaxonomy [ onto:authority "Linnaeus, 1758"@en ;
                    onto:class "Mammalia"@en ;
                    onto:family "Hominidae"@en ;
                    onto:genus "Homo"@en ;
                    onto:kingdom "Animalia"@en ;
                    onto:name "Homo sapiens"@en ;
                    onto:order "Primates"@en ;
                    onto:phylum "Chordata"@en ;
                    onto:seeAlso <http://species.wikimedia.org/wiki/Homo_sapiens> ;
                    onto:species "Sapiens"@en ;
                    dcterms:date "2008-05-08"@en ] ;
            foaf:name "Toby Inkster"@en ;
            foaf:page <http://tobyinkster.co.uk/> ],
        [ a foaf:Person ;
            onto:hasTaxonomy [ onto:authority "Linnaeus, 1758"@en ;
                    onto:class "Mammalia"@en ;
                    onto:family "Hominidae"@en ;
                    onto:genus "Homo"@en ;
                    onto:kingdom "Animalia"@en ;
                    onto:name "Homo sapiens"@en ;
                    onto:order "Primates"@en ;
                    onto:phylum "Chordata"@en ;
                    onto:seeAlso <http://species.wikimedia.org/wiki/Homo_sapiens> ;
                    onto:species "Sapiens"@en ;
                    dcterms:date "2008-05-08"@en ] ;
            foaf:name "Toby Inkster"@en ;
            foaf:page <http://tobyinkster.co.uk/> ] ;
    dcterms:license <http://creativecommons.org/licenses/by-sa/2.0/uk/> ;
    dcterms:modified "2008-10-06"@en ;
    dcterms:title "Biological Taxonomy Vocabulary 0.2 (Core)"@en ;
    ns1:alternate <http://purl.org/NET/biol/ns-20081006.rdf> ;
    ns1:appendix <http://purl.org/NET/biol/ns.html#section_Acknowledgments>,
        <http://purl.org/NET/biol/ns.html#section_Changes>,
        <http://purl.org/NET/biol/ns.html#section_References> ;
