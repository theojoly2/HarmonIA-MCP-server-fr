    ns1:lexicalAlias <http://rdaregistry.info/Elements/i/identifierForTheItem.en> ;
    ns1:name "identifierForTheItem"@en ;
    ns1:status <http://metadataregistry.org/uri/RegStatus/1001> ;
    ns2:instructionNumber "2.2" ;
    ns2:toolkitDefinition "A character string associated with an item that serves to differentiate that item from other items."@en ;
    ns2:toolkitLabel "identifier for the item"@en ;
    rdfs:domain <http://rdaregistry.info/Elements/c/C10003> ;
    rdfs:isDefinedBy <http://rdaregistry.info/Elements/i/> ;
