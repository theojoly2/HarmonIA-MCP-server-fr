@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/2006/vcard/ns#> .
@prefix ns2: <http://creativecommons.org/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#> a owl:Ontology ;
    ns2:license <http://creativecommons.org/licenses/by/3.0/> ;
    dc:description "An ontology and vocabulary used for exposing IEEE LOM, a metadata standard for educational contents, as Linked Data. \\n\\t\\tIt is intended as a bridge for linkage of educational metadata into Linked Open Data (LOD). \\n\\t\\tIn this ontology, we designed a mapping of IEEE LOM elements to RDF based on Linked Data principles. "@en ;
    dc:issued "2014-05-20"^^xsd:date ;
    dc:modified "2015-03-30"^^xsd:date ;
    dc:publisher "\\nUniversity of Alcala (www.uah.es) " ;
    dc:rights "Copyright © 2015 University of Alcala, Information Engineering (IE) research unit (http://www.ieru.org/) " ;
    dc:title "A vocabulary for exposing IEEE LOM metadata as Linked Open Data"@en ;
    rdfs:comment "-Version 1.0: covers a complete mapping of IEEE LOM to Linked Open Data"@en ;
    owl:versionInfo 1.0 .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#annotationDate> a owl:ObjectProperty ;
    rdfs:comment "Date that this annotation was created. IEEE LOM element 8.2."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Annotation> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#DateTime> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#contributionDateTime> a owl:ObjectProperty ;
    rdfs:comment "The date of the contribution. IEEE LOM element 3.2.3."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Contribution> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#DateTime> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#contributionEntity> a owl:ObjectProperty ;
    rdfs:comment "The identification of and information about entities (i.e., people, organizations) contributing to this learning object. The entities shall be ordered as most relevant first. IEEE LOM element 3.2.2."^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Contribution> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#VCard> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#copyrightDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#duration> a owl:ObjectProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Duration> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#email> a owl:DatatypeProperty ;
    rdfs:comment "Email as it appears in the vCard"^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#VCard> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#hasRelatedResource> a owl:ObjectProperty ;
    rdfs:comment "The target learning object that a relationship references. IEEE LOM element 7.2."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Relation> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Identifier> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#hasResourceIdentifier> a owl:ObjectProperty ;
    rdfs:comment "A globally unique label that identifies the target  learning object. IEEE LOM element 7.2.1."@en ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Identifier> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#hasTechnicalFormat> a owl:DatatypeProperty ;
    rdfs:comment "Technical datatype(s) of (all the components of) this learning object. This information is used to identify the software needed to access the learning object. IEEE LOM element 4.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#identifierEntry> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "This predicate relates a lomIdentifier to the value of the identifier within the identification or cataloging scheme that designates or identifies a learning object or a learning object metadata record (a namespace specific string).  IEEE LOM element 1.1, 3.1, 7.2.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Identifier> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#includesSingleLangString> a owl:ObjectProperty ;
    rdfs:comment "LangString values may include multiple semantically equivalent character strings, such as translations or alternative descriptions. Each of these is represented by a singleLangString."@en ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LangString> .

dc:publisher a owl:AnnotationProperty .

dcterms:coverage a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:format a owl:AnnotationProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:language a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

dcterms:type a owl:AnnotationProperty .

rdf:value a owl:AnnotationProperty .

ns1:FN a owl:AnnotationProperty .

ns1:N a owl:AnnotationProperty .

ns1:ORG a owl:AnnotationProperty .

ns1:email a owl:AnnotationProperty .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#aggregationLevel> a owl:DatatypeProperty ;
    rdfs:comment "The functional granularity of this learning object. IEEE LOM element 1.8."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "1"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "2"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "3"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "4"^^xsd:string ;
                                            rdf:rest () ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#annotation> a owl:ObjectProperty ;
    rdfs:comment "Comments on the educational use of a learning object, containing information on when and by whom the comments were created. This category enables educators to share their assessments of learning objects, suggestions for use, etc. IEEE LOM element 8."@en ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Annotation> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#annotationDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Annotation> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#annotationEntity> a owl:DatatypeProperty,
        owl:NamedIndividual,
        owl:ObjectProperty,
        owl:Thing ;
    rdfs:comment "Entity (i.e., people, organization) that created this annotation. IEEE LOM element 8.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Annotation> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#classification> a owl:ObjectProperty ;
    rdfs:comment "Description of where a learning object falls within a particular classification system. IEEE LOM element 9."@en ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Classification> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#classificationDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Classification> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#classificationKeyword> a owl:ObjectProperty ;
    rdfs:comment "Keywords and phrases descriptive of the learning object relative to the stated 9.1:Classification.Purpose of this specific classification, such as accessibility, security level, etc., most relevant first. IEEE LOM element 9.4"^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Classification> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#classificationPurpose> a owl:DatatypeProperty ;
    rdfs:comment "The purpose of classifying a learning object. IEEE LOM element 9.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Classification> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "accessibility"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "competency"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "discipline"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "educational level"^^xsd:string ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "educational objective"^^xsd:string ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "idea"^^xsd:string ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first "prerequisite"^^xsd:string ;
                                                                    rdf:rest [ a rdf:List ;
                                                                            rdf:first "restrictions"^^xsd:string ;
                                                                            rdf:rest [ a rdf:List ;
                                                                                    rdf:first "security level"^^xsd:string ;
                                                                                    rdf:rest [ a rdf:List ;
                                                                                            rdf:first "skill level"^^xsd:string ;
                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#classificationTaxon> a owl:ObjectProperty ;
    rdfs:comment "A particular term within a taxonomy which serves to classify a learning object. IEEE LOM element 9.2.2."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#TaxonPath> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Taxon> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#copyrightAndOtherRestrictions> a owl:DatatypeProperty ;
    rdfs:comment "Whether copyright or other restrictions apply to the use of this learning object. IEEE LOM element 6.2."@en ;
    rdfs:range xsd:boolean .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#cost> a owl:DatatypeProperty ;
    rdfs:comment "Whether use of the learning object requires payment. IEEE LOM element 6.1."@en ;
    rdfs:range xsd:boolean .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#coverage> a owl:ObjectProperty ;
    dcterms:coverage ""^^rdfs:Literal ;
    rdfs:comment "The time, culture, geography or region to which this learning object applies.\\nThe extent or scope of the content of the learning object. Coverage will typically include spatial location (a place name or geographic coordinates), temporal period (a period label, date, or date range) or jurisdiction (such as a named administrative entity). Recommended best practice is to select a value from a controlled vocabulary (for example, the Thesaurus of Geographic Names [TGN]) and that, where appropriate, named places or time periods be used in preference to numeric identifiers such as sets of coordinates or date ranges. IEEE LOM element 1.6."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#durationDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Duration> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#durationValue> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Duration> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educational> a owl:ObjectProperty ;
    rdfs:comment "This category describes the key educational or pedagogic characteristics of this learning object. IEEE LOM element 5."^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalContext> a owl:DatatypeProperty ;
    rdfs:comment "The principal environment within which the learning and use of this learning object is intended to take place. IEEE LOM element 5.6."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "higher education"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "other"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "school"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "training"^^xsd:string ;
                                            rdf:rest () ] ] ] ] ],
        rdfs:Literal,
        xsd:short .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalDifficulty> a owl:DatatypeProperty ;
    rdfs:comment "How hard it is to work with or through this learning object for the typical intended target audience. IEEE LOM element 5.8"@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "difficult"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "easy"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "medium"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "very difficult"^^xsd:string ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "very easy"^^xsd:string ;
                                                    rdf:rest () ] ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalIntendedUserRole> a owl:DatatypeProperty ;
    rdfs:comment "Principal user(s) for which this learning object was designed, most dominant first. IEEE LOM element 5.5."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "author"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "learner"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "manager"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "teacher"^^xsd:string ;
                                            rdf:rest () ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalInteractivityLevel> a owl:DatatypeProperty ;
    rdfs:comment "The degree of interactivity characterizing this learning object. Interactivity in this context refers to the degree to which the learner can influence the aspect or behavior of the learning object. IEEE LOM element 5.3."^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "high"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "low"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "medium"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "very high"^^xsd:string ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "very low"^^xsd:string ;
                                                    rdf:rest () ] ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalInteractivityType> a owl:DatatypeProperty ;
    rdfs:comment "Predominant mode of learning supported by this learning object. IEEE LOM element 5.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "active"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "expositive"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "mised"^^xsd:string ;
                                    rdf:rest () ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalLanguage> a owl:DatatypeProperty ;
    rdfs:comment "The primary human language or languages used within this learning object to communicate to the intended user. If the learning object had no lingual content (as in the case of a picture of the Mona Lisa, for example), then the appropriate value for this data element would be \"none\". IEEE LOM element 1.3."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "ba"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "ca"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "es"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "ga"^^xsd:string ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "none"^^xsd:string ;
                                                    rdf:rest () ] ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalSemanticDensity> a owl:DatatypeProperty ;
    rdfs:comment "The degree of conciseness of a learning object. The semantic density of a learning object may be estimated in terms of its size, span, or --in the case of self-timed resources such as audio or video-- duration. IEEE LOM element 5.4."^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "high"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "low"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "medium"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "very high"^^xsd:string ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "very low"^^xsd:string ;
                                                    rdf:rest () ] ] ] ] ] ],
        [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "higherEducation"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "other"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "school"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "training"^^xsd:string ;
                                            rdf:rest () ] ] ] ] ],
        xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalTypicalAgeRange> a owl:ObjectProperty ;
    rdf:value ""^^rdfs:Literal ;
    rdfs:comment "Age of the typical intended user. IEEE LOM element 5.7."^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalTypicalLearningTime> a owl:ObjectProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Duration> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#hasValue> a owl:DatatypeProperty ;
    rdfs:comment "This predicate relates a singleLangString to the character string containing its textual description."@en ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#identifierCatalog> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "This predicate relates a lomIdentifier to the name or designator of the identification or cataloging scheme used for its identification. It is usually a namespace scheme. IEEE LOM element 1.1, 3.1, 7.2.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Identifier> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#isCompositeOf> a owl:ObjectProperty ;
    rdfs:comment "When grouping multiple requirements, the composite requirement is satisfied when one of the component requirements is satisfied, i.e., the logical connector is OR. IEEE LOM element 4.4.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#TechnicalRequirement> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#SingleTechnicalRequirement> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#keyword> a owl:ObjectProperty ;
    rdf:value ""^^rdfs:Literal ;
    rdfs:comment "A keyword or phrase describing the topic of this learning object. This data element should not be used for characteristics that can be described by other data elements. IEEE LOM element 1.5."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#lifeCycleContribution> a owl:ObjectProperty .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#lifeCycleContributionRole> a owl:DatatypeProperty ;
    rdfs:comment "Kind of contribution. IEEE LOM element 2.3.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LifeCycleContribution> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "author"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "content provider"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "editor"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "educational validator"^^xsd:string ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "graphical designer"^^xsd:string ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "initiator"^^xsd:string ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first "instructional designer"^^xsd:string ;
                                                                    rdf:rest [ a rdf:List ;
                                                                            rdf:first "publisher"^^xsd:string ;
                                                                            rdf:rest [ a rdf:List ;
                                                                                    rdf:first "script writer"^^xsd:string ;
                                                                                    rdf:rest [ a rdf:List ;
                                                                                            rdf:first "subject matter expert"^^xsd:string ;
                                                                                            rdf:rest [ a rdf:List ;
                                                                                                    rdf:first "technical implementer"^^xsd:string ;
                                                                                                    rdf:rest [ a rdf:List ;
                                                                                                            rdf:first "technical validator"^^xsd:string ;
                                                                                                            rdf:rest [ a rdf:List ;
                                                                                                                    rdf:first "terminator"^^xsd:string ;
                                                                                                                    rdf:rest [ a rdf:List ;
                                                                                                                            rdf:first "unknown"^^xsd:string ;
                                                                                                                            rdf:rest [ a rdf:List ;
                                                                                                                                    rdf:first "validator"^^xsd:string ;
                                                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#lifeCycleStatus> a owl:DatatypeProperty ;
    rdfs:comment "The completion status or condition of this learning object. IEEE LOM element 2.2"^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "draft"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "final"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "revised"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "unavalaible"^^xsd:string ;
                                            rdf:rest () ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#lifeCycleVersion> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#metaMetadataContribution> a owl:ObjectProperty ;
    rdfs:comment "Those entities (i.e., people, organizations) that have contributed to the state of this learning object during its life cycle (e.g.,creation, edits, publication)."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LifeCycleContribution> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#metaMetadataContributionRole> a owl:DatatypeProperty ;
    rdfs:comment "Kind of contribution. IEEE LOM element 3.2.1."^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#MetaMetadataContribution> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#metaMetadataIdentifier> a owl:ObjectProperty ;
    rdfs:comment "A globally unique label that identifies this metadata record. IEEE LOM element 3.1."^^xsd:string ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Identifier> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#metaMetadataLanguage> a owl:DatatypeProperty ;
    rdfs:comment "Language of this metadata instance. This is the default language for all LangString values in this metadata instance. If a value for this data element is not present in a metadata instance, then there is no default language for LangString values. IEEE LOM element 3.4."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "ba"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "ca"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "es"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "ga"^^xsd:string ;
                                            rdf:rest () ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#metadataSchema> a owl:DatatypeProperty ;
    rdfs:comment "The name and version of the authoritative specification used to create this metadata instance. IEEE LOM element 3.3."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#orCompositeMaximumVersion> a owl:DatatypeProperty ;
    rdfs:comment "Highest possible version of the required technology to use the learning object. IEEE LOM element 4.4.1.4."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#SingleTechnicalRequirement> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#orCompositeMinimumVersion> a owl:DatatypeProperty ;
    rdfs:comment "Lowest possible version of the required technology to use the learning object. IEEE LOM element 4.4.1.3."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#SingleTechnicalRequirement> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#orCompositeName> a owl:DatatypeProperty ;
    rdfs:comment "Name of the required technology to use a learning object. IEEE LOM element 4.4.1.2."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#SingleTechnicalRequirement> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#orCompositeType> a owl:DatatypeProperty ;
    rdfs:comment "The technology required to use this learning object, e.g., hardware, software, network, etc. IEEE LOM element 4.4.1.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#SingleTechnicalRequirement> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "browser"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "operating system"^^xsd:string ;
                            rdf:rest () ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#otherPlatformRequirements> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#relatedResourceDescription> a owl:ObjectProperty ;
    dcterms:description ""^^rdfs:Literal ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Relation> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LangString> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#relation> a owl:ObjectProperty ;
    rdfs:comment "Relationship between a learning object and other learning objects, if any."@en ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Relation> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#relationKind> a owl:DatatypeProperty ;
    rdfs:comment "Nature of the relationship between a learning object and the target learning object, identified by 7.2:Relation.Resource. IEEE LOM element 7.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Relation> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "hasFormat"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "hasPart"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "hasVersion"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "isBasedOn"^^xsd:string ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "isBasisFor"^^xsd:string ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "isFormatOf"^^xsd:string ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first "isPartOf"^^xsd:string ;
                                                                    rdf:rest [ a rdf:List ;
                                                                            rdf:first "isReferencedBy"^^xsd:string ;
                                                                            rdf:rest [ a rdf:List ;
                                                                                    rdf:first "isRequiredBy"^^xsd:string ;
                                                                                    rdf:rest [ a rdf:List ;
                                                                                            rdf:first "isVersionOf"^^xsd:string ;
                                                                                            rdf:rest [ a rdf:List ;
                                                                                                    rdf:first "references"^^xsd:string ;
                                                                                                    rdf:rest [ a rdf:List ;
                                                                                                            rdf:first "requires"^^xsd:string ;
                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#structure> a owl:DatatypeProperty ;
    rdfs:comment "Underlying organizational structure of this learning object. IEEE LOM element 1.7."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "atomic"^^xsd:string ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "collection"^^xsd:string ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "hierarchical"^^xsd:string ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "linear"^^xsd:string ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "networked"^^xsd:string ;
                                                    rdf:rest () ] ] ] ] ] ] .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#taxonEntry> a owl:DatatypeProperty ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#taxonId> a owl:DatatypeProperty ;
    rdfs:comment "The identifier of the taxon, such as a number or letter combination provided by the source of the taxonomy. IEEE LOM element 9.2.2.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Taxon> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#taxonPath> a owl:ObjectProperty ;
    rdfs:comment "A taxonomic path in a specific classification system according to which a learning object is classified. IEEE LOM element 9.2."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Classification> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#TaxonPath> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#taxonpathSource> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#TaxonPath> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#technicalDuration> a owl:ObjectProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Duration> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#technicalInstallationRemarks> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#technicalLocation> a owl:DatatypeProperty ;
    rdfs:comment "A string that is used to access this learning object. It may be a location  (e.g., Universal Resource Locator), or a method that resolves to a location (e.g., Universal Resource Identifier). The first element of this list shall be the preferable location. IEEE LOM element 4.3."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#technicalRequirements> a owl:ObjectProperty ;
    rdfs:comment "A technical capability necessary for using a learning object. IEEE LOM Element \"4.4. Requirement\"."@en ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#TechnicalRequirement> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#technicalSize> a owl:DatatypeProperty ;
    rdfs:comment "The size of the digital learning object in bytes (not Mbytes, GB, etc.). The size is represented as a decimal value. This data element shall refer to the actual size of this learning object. If the learning object is compressed, then this data element shall refer to the uncompressed size. IEEE LOM element 4.2."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range xsd:string .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#MetaMetadataContribution> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#metaMetadataContributionRole> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#dateTimeValue> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#dateTimeDescription> ],
        <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Contribution> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#description> a owl:ObjectProperty ;
    dcterms:description ""^^rdfs:Literal ;
    rdfs:comment "Comments on how this learning object is to be used. IEEE LOM element 5.10"^^xsd:string,
        "A textual description of the content of this learning object. IEEE LOM element 1.4."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#identifier> a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "This predicate represents the fact that a learning object has a label that identifies it. IEEE LOM element 1.1."@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LearningObject> ;
    rdfs:range <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Identifier> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#DateTime> a owl:Class ;
    rdfs:comment "A point in time with accuracy at least as small as one second, as described by IEEE LOM in clause 8 (IEEE 1484.12.1-2002)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#dateTimeValue> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LifeCycleContribution> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#lifeCycleContributionRole> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#dateTimeDescription> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#dateTimeValue> ],
        <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Contribution> .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Taxon> a owl:Class ;
    rdfs:comment "A particular term within a taxonomy. A taxon is a node that has a defined label or\\nterm. A taxon may also have an alphanumeric designation or identifier for standardized reference. Either or both the label and the entry may be used to designate a particular taxon. An ordered list of taxons creates a taxonomic path, i.e., \"taxonomic stairway\": this is a path from a more general to more specific entry in a classification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#taxonId> ],
        [ a owl:Restriction ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#taxonEntry> ;
            owl:someValuesFrom rdfs:Literal ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#TechnicalRequirement> a owl:Class ;
    rdfs:comment "The technical capabilities necessary for using a learning object. There can be multiple requirements, in which case all are required, i.e., the logical connector is AND."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "40"^^xsd:nonNegativeInteger ;
            owl:onClass <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#SingleTechnicalRequirement> ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#isCompositeOf> ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#VCard> a owl:Class ;
    rdfs:comment "A vCard is a collection of one or more properties. A property is a uniquely named value. A set of properties can be grouped within a vCard. For example, the properties for a telephone number and comment can be grouped in order to preserve the coupling of the annotation with the telephone number. In addition to property groupings, a vC. versit  is developing a comprehensive family of PDI technologies based on open specifications and interoperability agreements to help meet this technology need."^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    ns1:FN ""^^rdfs:Literal ;
    ns1:N ""^^rdfs:Literal ;
    ns1:ORG ""^^rdfs:Literal ;
    ns1:email ""^^rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#dateTimeDescription> a owl:DatatypeProperty ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Contribution> ;
    rdfs:range rdfs:Literal .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#TaxonPath> a owl:Class ;
    rdfs:comment "A taxonomic path in a specific classification system. Each succeeding level is a refinement in the definition of the preceding level. There may be different paths, in the same or different classifications, which describe the same characteristic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "15"^^xsd:nonNegativeInteger ;
            owl:onClass <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Taxon> ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#classificationTaxon> ],
        [ a owl:Restriction ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#taxonpathSource> ;
            owl:someValuesFrom rdfs:Literal ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#dateTimeValue> a owl:DatatypeProperty ;
    rdfs:comment "Date time value in format: YYYY[-MM[-DD[Thh[:mm[:ss[.s[TZD]]]]]]]"@en ;
    rdfs:domain <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#DateTime> ;
    rdfs:range xsd:dateTime .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Annotation> a owl:Class ;
    rdfs:comment "Comments on the educational use of a learning object, including information on when and by whom the comments were created."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#annotationDescription> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#dateTimeDescription> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#dateTimeValue> ],
        [ a owl:Restriction ;
            owl:onClass <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#VCard> ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#annotationEntity> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Contribution> a owl:Class ;
    rdfs:comment "Those entities (i.e., people, organizations) that have contributed to the state of this learning object during its life cycle (e.g., creation, edits, publication)."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Relation> a owl:Class ;
    rdfs:comment "A concept which defines the relationship between a learning object and other learning objects, if any."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
            owl:onClass <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Identifier> ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#identifier> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#relationKind> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
            owl:onClass <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LangString> ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#relatedResourceDescription> ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Classification> a owl:Class ;
    rdfs:comment "Description of where a learning object falls within a particular classification system. To define multiple classifications, there may be multiple instances of this category for a learning object."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#classificationPurpose> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "40"^^xsd:nonNegativeInteger ;
            owl:onClass <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LangString> ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#classificationKeyword> ],
        [ a owl:Restriction ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#classificationDescription> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "15"^^xsd:nonNegativeInteger ;
            owl:onClass <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#TaxonPath> ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#taxonPath> ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#SingleTechnicalRequirement> a owl:Class ;
    rdfs:comment "A technical capability necessary for using a learning object."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#orCompositeMinimumVersion> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#orCompositeMaximumVersion> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#orCompositeType> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#orCompositeName> ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Duration> a owl:Class ;
    rdfs:comment "An interval in time with accuracy at least as small as one second."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange rdf:XMLLiteral ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#durationDescription> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange rdf:XMLLiteral ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#durationValue> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Identifier> a owl:Class ;
    dcterms:identifier ""^^rdfs:Literal ;
    rdfs:comment "A globally unique label that identifies either a learning object or a learning object metadata record."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#identifierCatalog> ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LangString> a owl:Class ;
    rdfs:comment "Each of the possible semantically equivalent character strings of a langString."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#hasValue> ;
            owl:someValuesFrom rdfs:Literal ],
        owl:Thing .

<http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#Educational> a owl:Class ;
    dcterms:type ""^^rdfs:Literal ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalDifficulty> ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
            owl:onClass <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#LangString> ;
            owl:onProperty <http://data.opendiscoveryspace.eu/lom_ontology_ods.owl#educationalTypicalAgeRange> ],
        [ a owl:Restriction ;
