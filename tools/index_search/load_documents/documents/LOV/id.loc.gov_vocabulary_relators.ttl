    rdfs:comment "\\n\\t\\t\\n<xhtml:div class=\"relatorsAbout\" title=\"About the Relator Codes:\" datatype=\"rdf:XMLLiteral\" property=\"rdfs:comment\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" xmlns:madsrdf=\"http://www.loc.gov/mads/rdf/v1#\" xmlns:xhtml=\"http://www.w3.org/1999/xhtml\" xmlns:rdfs=\"http://www.w3.org/2000/01/rdf-schema#\">\\n\\t\\t\\t<xhtml:p>\\n\\t\\t\\t\\tRelator terms and their associated codes designate the relationship between a name and a \\n                bibliographic resource. The relator codes are three-character lowercase alphabetic strings \\n                that serve as identifiers. Either the term or the code may be used as controlled values.\\n\\t\\t\\t</xhtml:p>\\n\\t\\t</xhtml:div>\\n\\n\\t"^^rdfs:Literal ;
