@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://schema.org/> .
@prefix onto: <https://w3id.org/vocab/sdm> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/vocab/sdm#EndPointFeatureExtension> a rdfs:Class,
        owl:Class ;
    rdfs:label "EndPoint feature extension"@fr ;
    rdfs:comment "Principal class extending the sd:Feature for providing more metadata on an endpoint service. "@en ;
    rdfs:subClassOf <http://www.w3.org/ns/sparql-service-description#Feature> .

<https://w3id.org/vocab/sdm#SPARQLRequest> a rdfs:Class,
        owl:Class ;
    rdfs:label "SPARQL request"@en ;
    rdfs:subClassOf <http://www.w3.org/2011/http#Request> .

<https://w3id.org/vocab/sdm#TripleStore> a rdfs:Class,
        owl:Class ;
    rdfs:label "Triple store"@en ;
    rdfs:subClassOf dcmitype:Software .

onto: a <http://purl.org/vocommons/voaf#vocabulary>,
        owl:Ontology ;
    dcterms:contributor [ ns1:affiliation [ foaf:homepage <http://www.openlinksw.com> ;
                    foaf:name "OpenLink Software" ] ;
            foaf:name "Kingsley Idehen" ] ;
    dcterms:creator [ rdfs:seeAlso <http://www.eurecom.fr/~atemezin/gatemezing-foaf.rdf> ;
            foaf:homepage <http://www.atemezing.org> ;
            foaf:name "Ghislain Auguste Atemezing" ] ;
    dcterms:description "A small vocabulary for representing SPARQL endpoint metadata on the web"@en ;
    dcterms:issued "2013-10-14"^^xsd:date ;
    dcterms:license <http://www.opendatacommons.org/licenses/pddl/1.0/> ;
    dcterms:modified "2013-10-15"^^xsd:date,
        "2016-03-16"^^xsd:date ;
    dcterms:title "SPARQL endpoint metadata"@en ;
    rdfs:comment "A vocabulary to represent SPARQL endpoint metadata."@en ;
    owl:versionInfo "v0.1" .

<https://w3id.org/vocab/sdm#developer> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "developer"@en ;
    rdfs:comment "Developer of the triple store"@en ;
    rdfs:domain <https://w3id.org/vocab/sdm#TripleStore> ;
    rdfs:range org:Organization .

<https://w3id.org/vocab/sdm#httpMessage> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "http message"@en ;
    rdfs:comment "Links to the message of an http connection, and helps to connect with http:httpVersion which is a rdfs:Literal"@en ;
    rdfs:domain <https://w3id.org/vocab/sdm#EndPointFeatureExtension> ;
    rdfs:range <http://www.w3.org/2011/http#Message> .

<https://w3id.org/vocab/sdm#maxResultPerRequest> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Max results per request"@en ;
    rdfs:comment "The limit of the maximum results for the endpoint service"@en ;
    rdfs:domain <https://w3id.org/vocab/sdm#EndPointFeatureExtension> ;
    rdfs:range xsd:integer .

<https://w3id.org/vocab/sdm#mirror> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "mirror"@en ;
    rdfs:comment "URI of a mirror of the endpoint service"@en ;
    rdfs:domain <https://w3id.org/vocab/sdm#EndPointFeatureExtension> ;
    rdfs:range xsd:anyURI .

<https://w3id.org/vocab/sdm#queryTimeOut> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "query time out"@en ;
    rdfs:comment "The timeout of a query in milliseconds"@en ;
    rdfs:domain <https://w3id.org/vocab/sdm#EndPointFeatureExtension> ;
    rdfs:range xsd:integer .

<https://w3id.org/vocab/sdm#remainingPerRequest> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Remaining per request"@en ;
    rdfs:comment "The remaining results for a given request"@en ;
    rdfs:domain <https://w3id.org/vocab/sdm#EndPointFeatureExtension> ;
    rdfs:range xsd:integer .

<https://w3id.org/vocab/sdm#request> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "requests"@en ;
    rdfs:comment "Links to a SPARQL request"@en ;
    rdfs:domain <https://w3id.org/vocab/sdm#EndPointFeatureExtension> ;
    rdfs:range <https://w3id.org/vocab/sdm#SPARQLRequest> .

<https://w3id.org/vocab/sdm#scheduledDowntime> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "scheduled downtime"@en ;
    rdfs:comment "Links to an interval period time"@en ;
    rdfs:domain <https://w3id.org/vocab/sdm#EndPointFeatureExtension> ;
    rdfs:range <http://reference.data.gov.uk/def/intervals/CalendarInterval> .

<https://w3id.org/vocab/sdm#tripleStore> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "tripleStore"@en ;
    rdfs:comment "Links to a given software acting as a triple store"@en ;
    rdfs:domain <https://w3id.org/vocab/sdm#EndPointFeatureExtension> ;
    rdfs:range <https://w3id.org/vocab/sdm#TripleStore> .

