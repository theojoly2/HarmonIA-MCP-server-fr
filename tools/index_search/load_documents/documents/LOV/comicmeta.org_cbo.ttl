@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix onto: <http://comicmeta.org/cbo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto:Building a owl:Class ;
    rdfs:label "Building"@en ;
    rdfs:comment "A building in a comic universe."@en ;
    rdfs:subClassOf onto:Object ;
    ns1:term_status "unstable"@en .

onto:Costume a owl:Class ;
    rdfs:label "Costume"@en ;
    rdfs:comment "A comic character's costume."@en ;
    rdfs:subClassOf onto:Object ;
    ns1:term_status "unstable" .

onto:Library a owl:Class ;
    rdfs:label "Library" ;
    rdfs:comment "A physical or digital library containing a collection of comic resources."@en ;
    rdfs:subClassOf <http://schema.org/Organization> ;
    ns1:term_status "unstable" .

onto:Museum a owl:Class ;
    rdfs:label "Museum"@en ;
    rdfs:comment "A physical or digital museum exhibiting a collection of comic resources."@en ;
    rdfs:subClassOf <http://schema.org/Organization> ;
    ns1:term_status "unstable" .

onto:Pedigree a owl:Class ;
    rdfs:label "Pedigree"@en ;
    rdfs:comment "An exceptional original owner collection of high quality, vintage comic books often containing copies that are considered exemplars of key issues."@en ;
    rdfs:subClassOf onto:Collection ;
    ns1:term_status "unstable" .

onto:Planet a owl:Class ;
    rdfs:label "Planet"@en ;
    rdfs:comment "A planetary body in a comic universe."@en ;
    rdfs:subClassOf onto:Location ;
    ns1:term_status "unstable" .

onto:Vehicle a owl:Class ;
    rdfs:label "Vehicle" ;
    rdfs:comment "A vehicle in a comic universe." ;
    rdfs:subClassOf onto:Object ;
    ns1:term_status "unstable" .

onto:adaptation a owl:ObjectProperty ;
    rdfs:label "adaptation"@en ;
    rdfs:comment "Links a comic to an adaptation."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range <http://schema.org/CreativeWork> ;
    rdfs:subPropertyOf dcterms:hasVersion ;
    owl:inverseOf onto:adaptationOf ;
    ns1:term_status "unstable" .

onto:alternativeTitle a owl:DatatypeProperty ;
    rdfs:label "alternative title"@en ;
    rdfs:comment "An alternative title for any comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:alternative ;
    ns1:term_status "unstable" .

onto:artworkOf a owl:ObjectProperty ;
    rdfs:label "artwork of"@en ;
    rdfs:comment "Links orginal comic artwork to a page."@en ;
    rdfs:domain onto:Artwork ;
    rdfs:range onto:Page ;
    owl:inverseOf onto:artwork ;
    ns1:term_status "unstable" .

onto:artworkType a owl:ObjectProperty ;
    rdfs:label "artwork type"@en ;
    rdfs:comment "Describes the artwork type of one or more pages of comic art."@en ;
    ns1:term_status "unstable" .

onto:bagged a owl:ObjectProperty ;
    rdfs:label "bagged"@en ;
    dc:description "Having this property implies that the comic is bagged."@en ;
    rdfs:comment "Describes the bag in which a comic is contained."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range onto:Material ;
    rdfs:subPropertyOf onto:attribute ;
    ns1:term_status "unstable" .

onto:balloon a owl:ObjectProperty ;
    rdfs:label "balloon"@en ;
    rdfs:comment "Links a panel to a word balloon."@en ;
    rdfs:domain onto:Panel ;
    rdfs:range onto:Balloon ;
    rdfs:subPropertyOf onto:sequence .

onto:binding a owl:ObjectProperty ;
    rdfs:label "binding"@en ;
    rdfs:comment "Describes the binding of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Binding ;
    rdfs:subPropertyOf onto:material ;
    ns1:term_status "unstable" .

onto:boarded a owl:ObjectProperty ;
    rdfs:label "boarded"@en ;
    dc:description "Having this property implies that the comic is boarded."@en ;
    rdfs:comment "Describes the backing board of a comic."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range onto:Material ;
    rdfs:subPropertyOf onto:attribute ;
    ns1:term_status "unstable" .

onto:box a owl:ObjectProperty ;
    rdfs:label "box"@en ;
    rdfs:comment "Associates a box with a comic book collection."@en ;
    rdfs:domain onto:Collection ;
    rdfs:range onto:Box ;
    rdfs:subPropertyOf dcterms:hasPart ;
    ns1:term_status "unstable" .

onto:cameo a owl:ObjectProperty ;
    rdfs:label "cameo"@en ;
    rdfs:comment "Describes a cameo appearance by a comic character in a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Character ;
    rdfs:subPropertyOf onto:character ;
    ns1:term_status "unstable" .

onto:caption a owl:ObjectProperty ;
    rdfs:label "caption"@en ;
    rdfs:comment "Links a panel to a caption."@en ;
    rdfs:domain onto:Panel ;
    rdfs:range onto:Caption ;
    rdfs:subPropertyOf onto:sequence ;
    ns1:term_status "unstable" .

onto:category a owl:AnnotationProperty .

onto:cca a owl:DatatypeProperty ;
    rdfs:label "CCA" ;
    rdfs:comment "Comics Code Authority (CCA) approved."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range xsd:boolean ;
    ns1:term_status "unstable" .

onto:certNumber a owl:DatatypeProperty ;
    rdfs:label "certificate number"@en ;
    rdfs:comment "The certificate number assigned to a graded copy of a comic by a guarantor."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "unstable" .

onto:collectedIn a owl:ObjectProperty ;
    rdfs:label "collected in"@en ;
    rdfs:comment "Links a comic work to another work that reprints it as part of a comprehensive collection of reprinted material."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Issue ;
    rdfs:subPropertyOf onto:reprintedIn ;
    owl:inverseOf onto:collects ;
    ns1:term_status "unstable" .

onto:collection a owl:ObjectProperty ;
    rdfs:label "collection"@en ;
    rdfs:comment "Links a collector to a collection."@en ;
    rdfs:domain onto:Collector ;
    rdfs:range onto:Collection ;
    ns1:term_status "unstable" .

onto:colorist a owl:ObjectProperty ;
    rdfs:label "colorist"@en ;
    rdfs:comment "Associates a colorist with a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Contributor ;
    rdfs:subPropertyOf onto:contributor ;
    ns1:term_status "unstable" .

onto:comicAge a owl:ObjectProperty ;
    rdfs:label "comic age"@en ;
    rdfs:comment "Associates a comic with an era of comic book history."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:ComicAge ;
    ns1:term_status "unstable"@en .

onto:condition a owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:comment "Describes the physical condition of a comic item."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range onto:Condition ;
    ns1:term_status "unstable" .

onto:copy a owl:ObjectProperty ;
    rdfs:label "copy"@en ;
    rdfs:comment "Links a comic issue to a specific copy."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Copy ;
    owl:inverseOf onto:copyOf ;
    ns1:term_status "unstable" .

onto:copyState a owl:ObjectProperty ;
    rdfs:label "copy state"@en ;
    rdfs:comment "Describes the physical state of a copy of a comic issue."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range onto:State ;
    ns1:term_status "unstable" .

onto:copyrightDate a owl:DatatypeProperty ;
    rdfs:label "copyright date"@en ;
    rdfs:comment "The copyright date of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "unstable" .

onto:country a owl:ObjectProperty ;
    rdfs:label "country"@en ;
    rdfs:comment "Links a comic series to its country of origin."@en ;
    rdfs:domain onto:Series ;
    rdfs:range owl:Thing ;
    ns1:term_status "unstable" .

onto:coverArt a owl:ObjectProperty ;
    rdfs:label "cover art"@en ;
    rdfs:comment "Describes the cover art of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Page ;
    ns1:term_status "unstable" .

onto:coverArtist a owl:ObjectProperty ;
    rdfs:label "cover artist"@en ;
    rdfs:comment "Associates an artist with cover artwork for a comic."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Contributor ;
    rdfs:subPropertyOf onto:artist ;
    ns1:term_status "unstable"@en .

onto:coverDate a owl:DatatypeProperty ;
    rdfs:label "cover date"@en ;
    rdfs:comment "The cover date of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "testing" .

onto:coverPrice a owl:DatatypeProperty ;
    rdfs:label "coverPrice"@en ;
    rdfs:comment "The cover price of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:price ;
    ns1:term_status "unstable" .

onto:creator a owl:ObjectProperty ;
    rdfs:label "creator"@en ;
    rdfs:comment "Associates a creator with a comic work."@en ;
    rdfs:domain onto:Comic,
        onto:ComicUniverse ;
    rdfs:range onto:Creator ;
    rdfs:subPropertyOf <http://schema.org/creator> ;
    ns1:term_status "unstable" .

onto:diamondCode a owl:DatatypeProperty ;
    rdfs:label "Diamond code"@en ;
    rdfs:comment "A Diamond Comic Distributors code."@en ;
    rdfs:domain onto:Publication ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:distributorCode ;
    ns1:term_status "unstable" .

onto:distributedBy a owl:ObjectProperty ;
    rdfs:label "distributed by"@en ;
    rdfs:comment "Links a comic series to a distributor."@en ;
    rdfs:domain onto:Publication ;
    rdfs:range onto:Distributor ;
    ns1:term_status "unstable" .

onto:edition a owl:ObjectProperty ;
    rdfs:label "edition"@en ;
    rdfs:comment "Describes the edition of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Edition ;
    ns1:term_status "unstable" .

onto:editor a owl:ObjectProperty ;
    rdfs:label "editor"@en ;
    rdfs:comment "Associates an editor with a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Contributor ;
    rdfs:subPropertyOf onto:contributor ;
    ns1:term_status "unstable" .

onto:encased a owl:ObjectProperty ;
    rdfs:label "encased"@en ;
    dc:description "Having this property implies that the comic is encapsulated."@en ;
    rdfs:comment "Describes the case in which a comic is encapsulated."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range onto:Material ;
    rdfs:subPropertyOf onto:attribute ;
    ns1:term_status "unstable"@en .

onto:endDate a owl:DatatypeProperty ;
    rdfs:label "end year"@en ;
    rdfs:comment "The date a comic ended publication."@en ;
    rdfs:domain onto:Publication ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "unstable" .

onto:event a owl:ObjectProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Describes a comic universe event depicted in a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Event ;
    ns1:term_status "unstable" .

onto:feature a owl:DatatypeProperty ;
    rdfs:label "feature"@en ;
    rdfs:comment "Describes the feature or primary focus of a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "unstable"@en .

onto:format a owl:ObjectProperty ;
    rdfs:label "format"@en ;
    rdfs:comment "Describes the format of a comic work."@en ;
    rdfs:domain onto:Publication ;
    rdfs:range onto:Format ;
    ns1:term_status "unstable" .

onto:genre a owl:ObjectProperty ;
    rdfs:label "genre"@en ;
    rdfs:comment "Describes the genre of a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Genre ;
    ns1:term_status "unstable" .

onto:grade a owl:ObjectProperty ;
    rdfs:label "grade"@en ;
    rdfs:comment "Describes the grade assigned to a comic item by a guarantor."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range onto:Grade ;
    ns1:term_status "unstable" .

onto:guaranteedBy a owl:ObjectProperty ;
    rdfs:label "guaranteed by"@en ;
    rdfs:comment "Links a graded copy of a comic issue to a guarantor."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range onto:Guarantor ;
    ns1:term_status "unstable" .

onto:imprint a owl:ObjectProperty ;
    rdfs:label "imprint"@en ;
    rdfs:comment "Associates a comic publisher with an imprint."@en ;
    rdfs:domain onto:Publisher ;
    rdfs:range onto:Imprint ;
    owl:inverseOf onto:imprintOf ;
    ns1:term_status "unstable" .

onto:imprintName a owl:DatatypeProperty ;
    rdfs:label "imprint name"@en ;
    rdfs:comment "The name of a comic imprint."@en ;
    rdfs:domain onto:Imprint ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://schema.org/name> ;
    ns1:term_status "unstable" .

onto:inBox a owl:ObjectProperty ;
    rdfs:label "in box"@en ;
    rdfs:comment "Links a comic item to a box."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range onto:Box ;
    owl:inverseOf onto:contains ;
    ns1:term_status "unstable" .

onto:indiciaFrequency a owl:DatatypeProperty ;
    rdfs:label "indicia frequency"@en ;
    rdfs:comment "The publication frequency of a comic as printed in the indicia of an issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "unstable" .

onto:indiciaPublisher a owl:DatatypeProperty ;
    rdfs:label "indicia publisher"@en ;
    rdfs:comment "The publisher name as printed in the indicia of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "unstable" .

onto:inker a owl:ObjectProperty ;
    rdfs:label "inker"@en ;
    rdfs:comment "Associates an inker with a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Contributor ;
    rdfs:subPropertyOf onto:contributor ;
    ns1:term_status "unstable" .

onto:isbn a owl:DatatypeProperty ;
    rdfs:label "ISBN" ;
    rdfs:comment "The ISBN of a comic publication."@en ;
    rdfs:subPropertyOf <http://schema.org/isbn> ;
    ns1:term_status "unstable" .

onto:issueCount a owl:DatatypeProperty ;
    rdfs:label "issue count"@en ;
    rdfs:comment "The total number of issues in a volume of comics."@en ;
    rdfs:domain onto:Volume ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

onto:issueNumber a owl:DatatypeProperty ;
    rdfs:label "issueNumber"@en ;
    rdfs:comment "The number of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "testing" .

onto:item a owl:ObjectProperty ;
    rdfs:label "item"@en ;
    rdfs:comment "Links a comic book collection to an item."@en ;
    rdfs:domain onto:Collection ;
    rdfs:range onto:Item ;
    rdfs:subPropertyOf dcterms:hasPart ;
    owl:inverseOf onto:itemOf ;
    ns1:term_status "unstable" .

onto:itemNumber a owl:DatatypeProperty ;
    rdfs:label "item number"@en ;
    rdfs:comment "An unique identifier assigned to a comic item."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "unstable"@en .

onto:language a owl:ObjectProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "Decribes the language of a comic series."@en ;
    rdfs:domain onto:Series ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf dcterms:language ;
    ns1:term_status "unstable" .

onto:letterer a owl:ObjectProperty ;
    rdfs:label "letterer"@en ;
    rdfs:comment "Associates a letterer with a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Contributor ;
    rdfs:subPropertyOf onto:contributor ;
    ns1:term_status "unstable" .

onto:level a owl:AnnotationProperty ;
    rdfs:label "level"@en ;
    rdfs:comment "The level of description associated with a term."@en .

onto:note a owl:DatatypeProperty ;
    rdfs:label "note" ;
    rdfs:comment "A note."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "unstable" .

onto:object a owl:ObjectProperty ;
    rdfs:label "object"@en ;
    rdfs:comment "Describes the appearance of a comic object in a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Object ;
    rdfs:subPropertyOf onto:appearance ;
    ns1:term_status "unstable" .

onto:onSaleDate a owl:DatatypeProperty ;
    rdfs:label "on-sale date"@en ;
    rdfs:comment "The date of availability of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "testing" .

onto:owner a owl:ObjectProperty ;
    rdfs:label "owner"@en ;
    rdfs:comment "Links an item or collection to the agent that owns it."@en ;
    rdfs:domain onto:Collection,
        onto:Item ;
    rdfs:range foaf:Agent ;
    ns1:term_status "unstable" .

onto:ownerOf a owl:ObjectProperty ;
    rdfs:label "owner of"@en ;
    rdfs:comment "Links an agent to an owned item or collection."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range onto:Collection,
        onto:Item ;
    ns1:term_status "unstable" .

onto:page a owl:ObjectProperty ;
    rdfs:label "page"@en ;
    rdfs:comment "Links a comic page to a document."@en ;
    rdfs:domain onto:Document ;
    rdfs:range onto:Page ;
    ns1:term_status "unstable" .

onto:pageCount a owl:DatatypeProperty ;
    rdfs:label "page count"@en ;
    rdfs:comment "The number of pages in a comic issue."@en ;
    rdfs:domain onto:Document,
        onto:Story ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf owl:topDataProperty ;
    ns1:term_status "unstable" .

onto:pageNumber a owl:DatatypeProperty ;
    rdfs:label "page count"@en ;
    rdfs:comment "The page number of a comic."@en ;
    rdfs:domain onto:Page ;
    rdfs:range rdfs:Literal .

onto:pageType a owl:ObjectProperty ;
    rdfs:label "page type"@en ;
    rdfs:comment "Describes the type of one or more comic pages."@en ;
    rdfs:domain onto:Page ;
    rdfs:range onto:PageType ;
    ns1:term_status "unstable" .

onto:panel a owl:ObjectProperty ;
    rdfs:label "panel"@en ;
    rdfs:comment "Links a sequence to a comic panel."@en ;
    rdfs:domain onto:Sequence ;
    rdfs:range onto:Panel ;
    rdfs:subPropertyOf onto:sequence ;
    ns1:term_status "unstable" .

onto:paper a owl:ObjectProperty ;
    rdfs:label "paper"@en ;
    rdfs:comment "Describes the paper stock of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Paper ;
    rdfs:subPropertyOf onto:material ;
    ns1:term_status "unstable" .

onto:penciller a owl:ObjectProperty ;
    rdfs:label "penciller"@en ;
    rdfs:comment "Associates a penciller with a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Contributor ;
    rdfs:subPropertyOf onto:contributor ;
    ns1:term_status "unstable" .

onto:plotter a owl:ObjectProperty ;
    rdfs:label "plotter"@en ;
    rdfs:comment "Associates a plotter with a comic work."@en ;
    rdfs:subPropertyOf onto:contributor ;
    ns1:term_status "unstable" .

onto:preview a owl:ObjectProperty ;
    rdfs:label "preview"@en ;
    rdfs:comment "Links a comic issue to a preview or sample of that work."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Issue ;
    ns1:term_status "unstable" .

onto:printing a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "printing"@en ;
    rdfs:comment "The numerical print run of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "unstable" .

onto:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publication date"@en ;
    rdfs:comment "The date a comic issue was published."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "testing" .

onto:publicationFrequency a owl:ObjectProperty ;
    rdfs:label "publication frequency"@en ;
    rdfs:comment "The publication frequency of a comic."@en ;
    rdfs:domain onto:Volume ;
    rdfs:range onto:Frequency ;
    ns1:term_status "unstable" .

onto:publisher a owl:ObjectProperty ;
    rdfs:label "publisher"@en ;
    rdfs:comment "Links a publisher to a comic publication."@en ;
    rdfs:domain onto:Series ;
    rdfs:range onto:Publisher ;
    rdfs:subPropertyOf <http://schema.org/publisher> ;
    ns1:term_status "unstable" .

onto:publisherName a owl:DatatypeProperty ;
    rdfs:label "publisher name"@en ;
    rdfs:comment "The name of a comic publisher."@en ;
    rdfs:domain onto:Publisher ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://schema.org/name> ;
    ns1:term_status "testing" .

onto:purchasePrice a owl:DatatypeProperty ;
    rdfs:label "purchase price"@en ;
    rdfs:comment "The purchase price of a comic item."@en ;
    rdfs:domain onto:Item ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:price ;
    ns1:term_status "unstable" .

onto:qlabel a owl:AnnotationProperty ;
    rdfs:subPropertyOf rdfs:label .

onto:quality a owl:ObjectProperty ;
    rdfs:label "quality"@en ;
    rdfs:comment "Describes a distinctive quality of an object."@en ;
    rdfs:domain dcmitype:PhysicalObject ;
    rdfs:range onto:Quality ;
    ns1:term_status "unstable" .

onto:rating a owl:ObjectProperty ;
    rdfs:label "rating"@en ;
    rdfs:comment "The rating of a comics publication."@en ;
    rdfs:domain onto:Publication ;
    rdfs:range owl:Thing ;
    ns1:term_status "unstable" .

onto:related a owl:ObjectProperty ;
    rdfs:label "related" ;
    rdfs:comment "Links a comic to a related object."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range owl:Thing ;
    ns1:term_status "unstable" .

onto:role a owl:ObjectProperty ;
    rdfs:label "role"@en ;
    rdfs:comment "Describes the role of a contributor in the creation of a comic work."@en ;
    rdfs:domain onto:Contributor ;
    rdfs:range onto:Role ;
    ns1:term_status "unstable" .

onto:salePrice a owl:DatatypeProperty ;
    rdfs:label "sale price"@en ;
    rdfs:comment "The sale price of a comic item."@en ;
    rdfs:domain onto:Item ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:price ;
    ns1:term_status "unstable" .

onto:seriesOf a owl:ObjectProperty ;
    rdfs:label "series of"@en ;
    rdfs:comment "Links a series to a comic work."@en ;
    rdfs:domain onto:Series ;
    rdfs:range onto:Publication ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    owl:inverseOf onto:series ;
    ns1:term_status "unstable" .

onto:seriesTitle a owl:DatatypeProperty ;
    rdfs:label "series title"@en ;
    rdfs:comment "The title of a comic series."@en ;
    rdfs:domain onto:Series ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:title ;
    ns1:term_status "testing" .

onto:seriesYear a owl:DatatypeProperty ;
    rdfs:label "series year" ;
    rdfs:comment "The year a comic series began publication."@en ;
    rdfs:domain onto:Series ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf onto:startDate ;
    ns1:term_status "unstable" .

onto:standard a owl:AnnotationProperty ;
    rdfs:label "standard"@en ;
    rdfs:comment "A recommended encoding standard or guidelines."@en .

onto:state a owl:ObjectProperty ;
    rdfs:label "state"@en ;
    rdfs:comment "Describes the physical state of a comic item."@en ;
    rdfs:domain onto:Copy,
        dcmitype:PhysicalObject ;
    rdfs:range onto:State ;
    ns1:term_status "unstable" .

onto:story a owl:ObjectProperty ;
    rdfs:label "story"@en ;
    rdfs:comment "Links a comic issue to a story."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Story ;
    rdfs:subPropertyOf dcterms:hasPart ;
    ns1:term_status "unstable" .

onto:storyOf a owl:ObjectProperty ;
    rdfs:label "has story"@en ;
    rdfs:comment "Connects an individual story to the story arc it is a part of."@en ;
    rdfs:domain onto:Story ;
    rdfs:range onto:Story ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    owl:inverseOf onto:storyArc ;
    ns1:term_status "unstable"@en .

onto:storyTitle a owl:DatatypeProperty ;
    rdfs:label "story title"@en ;
    rdfs:comment "The title of a comic story."@en ;
    rdfs:domain onto:Story ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:title ;
    ns1:term_status "unstable" .

onto:subject a owl:ObjectProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "The subject of a comic story."@en ;
    rdfs:domain onto:Story ;
    rdfs:range owl:Thing ;
    ns1:term_status "unstable" .

onto:synopsis a owl:DatatypeProperty ;
    rdfs:label "synopsis"@en ;
    rdfs:comment "The synopsis of a comic story."@en ;
    rdfs:domain onto:Story ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "unstable"@en .

onto:team a owl:ObjectProperty ;
    rdfs:label "team"@en ;
    rdfs:comment "Describes the appearance of a team of comic characters in a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Team ;
    rdfs:subPropertyOf onto:appearance ;
    ns1:term_status "unstable" .

onto:tracking a owl:DatatypeProperty ;
    rdfs:label "tracking"@en ;
    rdfs:comment "Describes the tracking or numbering between comic series."@en ;
    rdfs:domain onto:Series ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "unstable" .

onto:translation a owl:ObjectProperty ;
    rdfs:label "translation"@en ;
    rdfs:comment "Links a comic issue to a translation."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Issue ;
    rdfs:subPropertyOf dcterms:hasVersion ;
    owl:inverseOf onto:translationOf ;
    ns1:term_status "unstable" .

onto:universe a owl:ObjectProperty ;
    rdfs:label "universe"@en ;
    rdfs:comment "Links a thing to a comic universe."@en ;
    rdfs:domain onto:Thing ;
    rdfs:range onto:ComicUniverse ;
    ns1:term_status "unstable" .

onto:universeOf a owl:ObjectProperty ;
    rdfs:label "universe of"@en ;
    rdfs:comment "Links a comic universe to the universe from which it originates."@en ;
    rdfs:domain onto:ComicUniverse ;
    rdfs:range onto:ComicUniverse ;
    ns1:term_status "unstable"@en .

onto:upc a owl:DatatypeProperty ;
    rdfs:label "UPC"@en ;
    rdfs:comment "The UPC of a comic publication."@en ;
    rdfs:domain onto:Publication ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "unstable" .

onto:value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "The estimated value of a comic item."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "unstable" .

onto:variance a owl:DatatypeProperty ;
    rdfs:label "variance"@en ;
    rdfs:comment "Any variance to the regular manifestation of a comic issue."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range rdfs:Literal ;
    ns1:term_status "unstable" .

onto:variant a owl:ObjectProperty ;
    rdfs:label "variant"@en ;
    rdfs:comment "Links a comic issue to a variant."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Issue ;
    rdfs:subPropertyOf dcterms:hasVersion ;
    owl:inverseOf onto:variantOf ;
    ns1:term_status "unstable"@en .

onto:volumeNumber a owl:DatatypeProperty ;
    rdfs:label "volumeNumber"@en ;
    rdfs:comment "The unique identifier of a comic volume."@en ;
    rdfs:domain onto:Volume ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "testing" .

onto:volumeOf a owl:ObjectProperty ;
    rdfs:label "volume of"@en ;
    rdfs:comment "Links a volume to a comic series."@en ;
    rdfs:domain onto:Volume ;
    rdfs:range onto:Series ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    owl:inverseOf onto:volume ;
    ns1:term_status "unstable" .

onto:writer a owl:ObjectProperty ;
    rdfs:label "writer"@en ;
    rdfs:comment "Associates a writer with a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Contributor ;
    rdfs:subPropertyOf onto:contributor ;
    ns1:term_status "unstable" .

<http://comicmeta.org/issueOf> a owl:ObjectProperty ;
