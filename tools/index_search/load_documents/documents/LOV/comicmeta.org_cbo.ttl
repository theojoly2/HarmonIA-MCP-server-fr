dc:creator a owl:AnnotationProperty .

dc:description a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty ;
    rdfs:label "dcterms:created" .

dcterms:description a owl:DatatypeProperty ;
    dc:description "Used to provide a description for any resource."@en ;
    rdfs:comment "A description."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" ;
    rdfs:range rdfs:Literal .

dcterms:issued a owl:AnnotationProperty ;
    rdfs:label "dcterms:issued" .

vann:preferredNamespacePrefix a owl:AnnotationProperty ;
    onto:qlabel "vann:preferredNamespacePrefix" ;
    vann:preferredNamespacePrefix "The preferred namespace prefix to use when using terms from this vocabulary in an XML document."@en ;
    rdfs:isDefinedBy "http://purl.org/vocab/vann" .

vann:preferredNamespaceUri a owl:AnnotationProperty ;
    onto:qlabel "vann:preferredNamespaceUri"@en ;
    rdfs:comment "The preferred namespace URI to use when using terms from this vocabulary in an XML document."@en ;
    rdfs:isDefinedBy "http://purl.org/vocab/vann" .

<http://schema.org/issn> a owl:DatatypeProperty ;
    rdfs:domain <http://schema.org/Periodical> ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:range rdfs:Literal .

<http://schema.org/sku> a owl:DatatypeProperty ;
    rdfs:label "SKU"@en ;
    dc:description "The SKU of a comics product."@en ;
    rdfs:domain <http://schema.org/Product> ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:range rdfs:Literal .

<http://schema.org/url> a owl:DatatypeProperty ;
    dc:description "Used to indicate web content related to a resource."@en ;
    rdfs:comment "A URL."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy "http://schema.org"@en ;
    rdfs:range rdfs:Literal .

ns1:term_status a owl:AnnotationProperty ;
    onto:qlabel "vs:term_status"@en ;
    rdfs:comment "The status of a vocabulary term, expressed as a short symbolic string; known values include 'unstable','testing', 'stable' and 'archaic'."@en ;
    rdfs:isDefinedBy "http://www.w3.org/2003/06/sw-vocab-status/ns" .

skos:definition a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

skos:note a owl:AnnotationProperty .

onto: a owl:Ontology ;
    dc:creator <https://sean.petiya.com/#me> ;
    dc:description "A metadata vocabulary for describing comic books and comic book collections."^^xsd:string ;
    dc:modified "2015-12-05"@en ;
    dc:rights "Copyright © PD&C, LLC"@en ;
    dc:title "Comic Book Ontology"@en ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0> ;
    vann:preferredNamespacePrefix "cbo" ;
    vann:preferredNamespaceUri "http://comicmeta.org/cbo"^^xsd:string,
        "http://comicmeta.org/cbo/" ;
    owl:versionIRI onto: ;
    owl:versionInfo "0.14.1"^^xsd:string .

onto:Balloon a owl:Class ;
    rdfs:label "Balloon"@en ;
    rdfs:comment "A word balloon containing dialogue or thought."@en ;
    rdfs:seeAlso "http://dcl.slis.indiana.edu/cbml/schema/cbml.html#TEI.balloon" ;
    rdfs:subClassOf onto:Sequence ;
    ns1:term_status "unstable" .

onto:Caption a owl:Class ;
    rdfs:label "Caption"@en ;
    rdfs:comment "A caption containing narration."@en ;
    rdfs:seeAlso "http://dcl.slis.indiana.edu/cbml/schema/cbml.html#TEI.caption" ;
    rdfs:subClassOf onto:Sequence ;
    ns1:term_status "unstable" .

onto:Collector a owl:Class ;
    rdfs:label "Collector"@en ;
    rdfs:comment "A comic book collector."@en ;
    rdfs:subClassOf <http://schema.org/Person> ;
    ns1:term_status "unstable" .

onto:Creator a owl:Class ;
    rdfs:label "Creator"@en ;
    rdfs:comment "An agent primarily responsible for the creation of a comic work."@en ;
    rdfs:subClassOf <http://schema.org/Person> ;
    ns1:term_status "unstable" .

onto:Distributor a owl:Class ;
    rdfs:label "Distributor" ;
    rdfs:comment "An agent responsible for the distribution of a comic publication."@en ;
    rdfs:subClassOf <http://schema.org/Organization> ;
    ns1:term_status "unstable" .

onto:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "An event in a comic universe."@en ;
    rdfs:subClassOf onto:Thing ;
    ns1:term_status "unstable" .

onto:Guarantor a owl:Class ;
    rdfs:label "Guarantor"@en ;
    rdfs:comment "An organization that guarantees the stated condition of a comic book."@en ;
    rdfs:subClassOf <http://schema.org/Organization> ;
    ns1:term_status "unstable" .

onto:Location a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "A location in a comic universe."@en ;
    rdfs:subClassOf onto:Thing ;
    ns1:term_status "unstable" .

onto:Team a owl:Class ;
    rdfs:label "Team" ;
    rdfs:comment "A group of comic characters."@en ;
    rdfs:subClassOf onto:Agent ;
    ns1:term_status "unstable" .

onto:adaptationOf a owl:ObjectProperty ;
    rdfs:label "adaptation of"@en ;
    rdfs:comment "Links a work to the comic work it is an adaptation of."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Comic ;
    rdfs:subPropertyOf dcterms:isVersionOf ;
    ns1:term_status "unstable" .

onto:artist a owl:ObjectProperty ;
    rdfs:label "artist"@en ;
    rdfs:comment "Associates an artist with a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Contributor ;
    rdfs:subPropertyOf onto:contributor ;
    ns1:term_status "unstable" .

onto:artwork a owl:ObjectProperty ;
    rdfs:label "artwork"@en ;
    rdfs:comment "Links a comic page to its original artwork."@en ;
    rdfs:domain onto:Page ;
    rdfs:range onto:Artwork ;
    ns1:term_status "unstable" .

onto:character a owl:ObjectProperty ;
    rdfs:label "character"@en ;
    rdfs:comment "Describes the appearance of a comic character in a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Character ;
    rdfs:subPropertyOf onto:appearance ;
    ns1:term_status "unstable" .

onto:collects a owl:ObjectProperty ;
    rdfs:label "collects" ;
    rdfs:comment "Links a comic issue to another work that reprints it as part of a comprehensive collection of reprinted material."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Issue ;
    rdfs:subPropertyOf onto:reprints,
        dcterms:hasPart ;
    ns1:term_status "unstable" .

onto:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    rdfs:comment "Describes the contents of a box of comics."@en ;
    rdfs:domain onto:Container ;
    rdfs:range onto:Copy ;
    ns1:term_status "unstable" .

onto:copyOf a owl:ObjectProperty ;
    rdfs:label "copy of"@en ;
    rdfs:comment "Links a specific copy to a comic issue."@en ;
    rdfs:domain onto:Copy ;
    rdfs:range onto:Issue ;
    ns1:term_status "unstable" .

onto:distributorCode a owl:DatatypeProperty ;
    rdfs:label "distributor code" ;
    rdfs:comment "The distributor code associated with a comics publication."@en ;
    rdfs:domain onto:Publication ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:identifier ;
    ns1:term_status "unstable" .

onto:imprintOf a owl:ObjectProperty ;
    rdfs:label "imprint of"@en ;
    rdfs:comment "Associates an imprint with a comic publisher."@en ;
    rdfs:domain onto:Imprint ;
    rdfs:range onto:Publisher ;
    ns1:term_status "unstable" .

onto:issue a owl:ObjectProperty ;
    rdfs:label "issue"@en ;
    rdfs:comment "Links a volume of comics to an issue."@en ;
    rdfs:domain onto:Volume ;
    rdfs:range onto:Issue ;
    rdfs:subPropertyOf dcterms:hasPart ;
    ns1:term_status "unstable" .

onto:itemOf a owl:ObjectProperty ;
    rdfs:label "item of"@en ;
    rdfs:comment "Links an item to a comic book collection."@en ;
    rdfs:domain onto:Item ;
    rdfs:range onto:Collection ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    ns1:term_status "unstable" .

onto:reprintedIn a owl:ObjectProperty ;
    rdfs:label "reprinted in"@en ;
    rdfs:comment "Links a comic issue to a work that reprints it."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Issue ;
    rdfs:subPropertyOf dcterms:hasVersion ;
    owl:inverseOf onto:reprints ;
    ns1:term_status "unstable" .

onto:series a owl:ObjectProperty ;
    rdfs:label "series"@en ;
    rdfs:comment "Links a comic to a series."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Series ;
    rdfs:subPropertyOf dcterms:hasPart ;
    ns1:term_status "unstable" .

onto:startDate a owl:DatatypeProperty ;
    rdfs:label "start year"@en ;
    rdfs:comment "The date a comic began publication."@en ;
    rdfs:domain onto:Publication ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date ;
    ns1:term_status "unstable" .

onto:storyArc a owl:ObjectProperty ;
    rdfs:label "story arc" ;
    rdfs:comment "Links a comic story to a story arc."@en ;
    rdfs:domain onto:Story ;
    rdfs:range onto:Story ;
    rdfs:subPropertyOf dcterms:hasPart ;
    ns1:term_status "unstable" .

onto:translationOf a owl:ObjectProperty ;
    rdfs:label "translation of"@en ;
    rdfs:comment "Links a comic issue to the issue it is a translation of."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Issue ;
    rdfs:subPropertyOf dcterms:isVersionOf ;
    ns1:term_status "unstable" .

onto:variantOf a owl:ObjectProperty ;
    rdfs:label "variant of"@en ;
    rdfs:comment "Links a comic issue to the issue it is a variant of."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Issue ;
    rdfs:subPropertyOf dcterms:isVersionOf ;
    ns1:term_status "unstable" .

onto:volume a owl:ObjectProperty ;
    rdfs:label "volume"@en ;
    rdfs:comment "Links a series to a comic volume."@en ;
    rdfs:domain onto:Series ;
    rdfs:range onto:Volume ;
    rdfs:subPropertyOf dcterms:hasPart ;
    ns1:term_status "unstable" .

dcmitype:Collection a owl:Class ;
    onto:qlabel "dctype:Collection" ;
    rdfs:isDefinedBy "http://purl.org/dc/dcmitype" .

dcterms:alternative a owl:DatatypeProperty ;
    dc:description "Used to indicate an alternative title for a resource."@en ;
    rdfs:comment "An alternative title."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" ;
    rdfs:range rdfs:Literal .

dcterms:language a owl:ObjectProperty ;
    rdfs:domain onto:Series ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" ;
    rdfs:range owl:Thing .

<http://schema.org/PublicationIssue> a owl:Class ;
    onto:qlabel "schema:PublicationIssue" ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:subClassOf <http://schema.org/CreativeWork> .

<http://schema.org/PublicationVolume> a owl:Class ;
    onto:qlabel "schema:PublicationVolume" ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:subClassOf <http://schema.org/CreativeWork> .

<http://schema.org/contributor> a owl:ObjectProperty ;
    dc:description "Used to associate a contributor with any creative work."@en ;
    rdfs:isDefinedBy "http://schema.org" .

<http://schema.org/creator> a owl:ObjectProperty ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" .

<http://schema.org/isbn> a owl:DatatypeProperty ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:range rdfs:Literal .

<http://schema.org/publisher> a owl:ObjectProperty ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" .

rdfs:label onto:qlabel "rdfs:label" .

<https://sean.petiya.com/#me> a owl:NamedIndividual ;
    rdfs:label "Sean Petiya" .

onto:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "A person, organization, or intelligence in a comic universe."@en ;
    rdfs:subClassOf onto:Thing ;
    ns1:term_status "unstable" .

onto:Artwork a owl:Class ;
    rdfs:label "Artwork"@en ;
    rdfs:comment "Original comic artwork."@en ;
    rdfs:subClassOf onto:Item,
        <http://schema.org/IndividualProduct> ;
    ns1:term_status "unstable" .

onto:Box a owl:Class ;
    rdfs:label "Box"@en ;
    rdfs:comment "A box that contains comic books."@en ;
    rdfs:subClassOf onto:Container ;
    ns1:term_status "unstable" .

onto:Character a owl:Class ;
    rdfs:label "Character"@en ;
    rdfs:comment "A comic character."@en ;
    rdfs:subClassOf onto:Agent ;
    ns1:term_status "unstable" .

onto:Container a owl:Class ;
    rdfs:label "Container"@en ;
    rdfs:comment "An object containing comic books."@en ;
    rdfs:subClassOf dcmitype:PhysicalObject ;
    ns1:term_status "unstable" .

onto:material a owl:ObjectProperty ;
    rdfs:label "material"@en ;
    rdfs:comment "Describes the material of which a physical item is composed."@en ;
    rdfs:domain dcmitype:PhysicalObject ;
    rdfs:range onto:Material ;
    ns1:term_status "unstable" .

onto:reprints a owl:ObjectProperty ;
    rdfs:label "reprints"@en ;
    rdfs:comment "Links a comic to the original work it reprints."@en ;
    rdfs:domain onto:Issue ;
    rdfs:range onto:Issue ;
    rdfs:subPropertyOf dcterms:isVersionOf ;
    ns1:term_status "unstable" .

dcterms:title a owl:DatatypeProperty ;
    rdfs:comment "A title."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy "http://purl.org/dc/terms"^^xsd:anyURI ;
    rdfs:range rdfs:Literal .

<http://schema.org/IndividualProduct> a owl:Class ;
    onto:qlabel "schema:IndividualProduct" ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:subClassOf <http://schema.org/Product> .

<http://schema.org/Periodical> a owl:Class ;
    onto:qlabel "schema:Periodical" ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:subClassOf <http://schema.org/CreativeWork> .

<http://schema.org/name> a owl:DatatypeProperty ;
    dc:description "Used to describe the name of an agent."@en ;
    rdfs:comment "A name."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:range rdfs:Literal .

onto:Document a owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:comment "A document composed of the pages in a comic publication."@en ;
    rdfs:subClassOf onto:Comic ;
    ns1:term_status "unstable" .

onto:Imprint a owl:Class ;
    rdfs:label "Imprint"@en ;
    rdfs:comment "An imprint or tradename of a comic publisher."@en ;
    rdfs:subClassOf onto:Publisher ;
    ns1:term_status "unstable" .

onto:Panel a owl:Class ;
    rdfs:label "Panel"@en ;
    rdfs:comment "A visual frame containing part of a sequence."@en ;
    rdfs:seeAlso "http://dcl.slis.indiana.edu/cbml/schema/cbml.html#TEI.panel" ;
    rdfs:subClassOf onto:Sequence ;
    ns1:term_status "unstable" .

onto:Paper a owl:Class ;
    rdfs:label "Paper"@en ;
    rdfs:comment "A paper stock on which a comic is printed."@en ;
    rdfs:subClassOf onto:Material ;
    ns1:term_status "unstable" .

onto:appearance a owl:ObjectProperty ;
    rdfs:label "appearance"@en ;
    rdfs:comment "Describes the appearance of a comic universe element within a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Thing ;
    ns1:term_status "unstable" .

onto:attribute a owl:ObjectProperty ;
    rdfs:label "attribute"@en ;
    rdfs:comment "Describes a physical attribute of a comic item."@en ;
    rdfs:domain dcmitype:PhysicalObject ;
    rdfs:range onto:PhysicalAttribute ;
    ns1:term_status "unstable" .

onto:price a owl:DatatypeProperty ;
    rdfs:label "price"@en ;
    rdfs:comment "A general price."@en ;
    ns1:term_status "unstable" .

onto:sequence a owl:ObjectProperty ;
    rdfs:label "sequence"@en ;
    rdfs:comment "Links a sequence to a page."@en ;
    rdfs:domain onto:Page ;
    rdfs:range onto:Sequence ;
    ns1:term_status "unstable" .

<http://schema.org/Person> a owl:Class ;
    onto:qlabel "schema:Person" ;
    rdfs:comment "A person."@en ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:subClassOf foaf:Agent .

<http://schema.org/Product> a owl:Class ;
    onto:qlabel "schema:Product" ;
    rdfs:isDefinedBy "http://schema.org" .

onto:Object a owl:Class ;
    rdfs:label "Object"@en ;
    rdfs:comment "An object in a comic universe."@en ;
    rdfs:subClassOf onto:Thing ;
    ns1:term_status "unstable" .

onto:Plastic a owl:Class ;
    rdfs:label "Plastic"@en ;
    rdfs:comment "A plastic of which a supply item is composed."@en ;
    rdfs:subClassOf onto:Material ;
    ns1:term_status "unstable" .

onto:Quality a owl:Class ;
    rdfs:label "Quality" ;
    rdfs:comment "A distinctive quality belonging to an object."@en ;
    rdfs:subClassOf onto:PhysicalAttribute ;
    ns1:term_status "unstable" .

dcterms:hasVersion a owl:ObjectProperty ;
    rdfs:isDefinedBy "http://purl.org/dc/terms"@en .

dcterms:isVersionOf a owl:ObjectProperty ;
    rdfs:isDefinedBy "http://purl.org/dc/terms"@en .

onto:ComicAge a owl:Class ;
    rdfs:label "Comic Age"@en ;
    rdfs:comment "A period of comic book history."@en ;
    rdfs:subClassOf <http://schema.org/Intangible> ;
    ns1:term_status "unstable" .

onto:ComicUniverse a owl:Class ;
    rdfs:label "Comic Universe"@en ;
    rdfs:comment "A comic universe."@en ;
    rdfs:subClassOf <http://schema.org/CreativeWork> ;
    ns1:term_status "unstable" .

onto:Edition a owl:Class ;
    rdfs:label "Edition"@en ;
    rdfs:comment "An edition of a comic issue."@en ;
    rdfs:subClassOf <http://schema.org/Intangible> ;
    ns1:term_status "unstable" .

onto:PageType a owl:Class ;
    rdfs:label "Page Type"@en ;
    rdfs:comment "A type of page appearing in a comic document."@en ;
    rdfs:subClassOf <http://schema.org/Intangible> ;
    ns1:term_status "unstable" .

onto:PhysicalAttribute a owl:Class ;
    rdfs:label "Attribute"@en ;
    rdfs:comment "An physical attribute or property of an item."@en ;
    ns1:term_status "unstable" .

onto:Publisher a owl:Class ;
    rdfs:label "Publisher"@en ;
    rdfs:comment "An agent responsible for the publication of a comic."@en ;
    rdfs:subClassOf <http://schema.org/Organization> ;
    ns1:term_status "unstable" .

onto:Sequence a owl:Class ;
    rdfs:label "Sequence"@en ;
    rdfs:comment "A visual sequence of juxtaposed panels and pictorial elements."@en ;
    rdfs:subClassOf onto:Comic ;
    ns1:term_status "unstable" .

dcmitype:PhysicalObject a owl:Class ;
    onto:qlabel "dctype:PhysicalObject" ;
    rdfs:isDefinedBy "http://purl.org/dc/dcmitype" .

dcterms:isPartOf a owl:ObjectProperty ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" ;
    owl:inverseOf dcterms:hasPart .

<http://schema.org/Organization> a owl:Class ;
    onto:qlabel "schema:Organization" ;
    rdfs:comment "An organization."@en ;
    rdfs:isDefinedBy "http://schema.org" ;
    rdfs:subClassOf foaf:Agent .

foaf:Agent a owl:Class ;
    onto:qlabel "foaf:Agent" ;
    rdfs:comment "An agent."@en ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" .

onto:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:comment "A thing in a comic universe."@en ;
    rdfs:subClassOf onto:ComicUniverse ;
    ns1:term_status "unstable" .

dcterms:date a owl:DatatypeProperty ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" .

dcterms:identifier a owl:DatatypeProperty ;
    dc:description "Any unique identifier of a comic resource."@en ;
    rdfs:comment "An identifier."@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy "http://purl.org/dc/terms"^^xsd:anyURI ;
    rdfs:range rdfs:Literal .

<http://schema.org/CreativeWork> a owl:Class ;
    onto:qlabel "schema:CreativeWork" ;
    rdfs:isDefinedBy "http://schema.org" .

onto:Binding a owl:Class ;
    rdfs:label "Binding"@en ;
    rdfs:comment "A binding method or material used to bind the pages of a comic."@en ;
    rdfs:subClassOf onto:Material ;
    ns1:term_status "unstable" .

onto:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:comment "A collection of comic books and related resources."@en ;
    rdfs:subClassOf dcmitype:Collection ;
    ns1:term_status "unstable" .

onto:Material a owl:Class ;
    rdfs:label "Material" ;
    rdfs:comment "A material or medium of which an object is composed."@en ;
    rdfs:subClassOf onto:PhysicalAttribute ;
    ns1:term_status "unstable" .

onto:Page a owl:Class ;
    rdfs:label "Page"@en ;
    rdfs:comment "One or more pages in a comic document."@en ;
    rdfs:subClassOf onto:Document ;
    ns1:term_status "unstable" .

onto:Volume a owl:Class ;
    rdfs:label "Volume"@en ;
    rdfs:comment "A single issue or group of issues published in a comic series."@en ;
    rdfs:subClassOf onto:Publication,
        <http://schema.org/PublicationVolume> ;
    ns1:term_status "unstable" .

onto:Frequency a owl:Class ;
    rdfs:label "Frequency"@en ;
    rdfs:comment "A frequency with which a comic is published."@en ;
    rdfs:subClassOf <http://schema.org/Intangible> ;
    ns1:term_status "unstable" .

onto:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A physical or digital item."@en ;
    ns1:term_status "unstable" .

onto:contributor a owl:ObjectProperty ;
    rdfs:label "contributor"@en ;
    rdfs:comment "Associates a contributor with a comic work."@en ;
    rdfs:domain onto:Comic ;
    rdfs:range onto:Contributor ;
    rdfs:subPropertyOf <http://schema.org/contributor> ;
    ns1:term_status "unstable" .

<http://schema.org/Intangible> a owl:Class ;
    onto:qlabel "schema:Intangible" ;
    rdfs:isDefinedBy "http://schema.org" .

onto:Story a owl:Class ;
    rdfs:label "Story"@en ;
    rdfs:comment "A comic story."@en ;
    rdfs:subClassOf onto:Comic ;
    ns1:term_status "unstable" .

dcterms:hasPart a owl:ObjectProperty ;
    rdfs:isDefinedBy "http://purl.org/dc/terms" .

onto:Contributor a owl:Class ;
    rdfs:label "Contributor"@en ;
    rdfs:comment "An agent contributing to the creation of a comic work."@en ;
    rdfs:subClassOf <http://schema.org/Person> ;
    ns1:term_status "unstable" .

onto:State a owl:Class ;
    rdfs:label "State"@en ;
    rdfs:comment "A physical state describing an object."@en ;
    rdfs:subClassOf onto:PhysicalAttribute ;
    ns1:term_status "unstable" .

onto:Genre a owl:Class ;
    rdfs:label "Genre"@en ;
    rdfs:comment "A comics genre."@en ;
    rdfs:subClassOf <http://schema.org/Intangible> ;
    ns1:term_status "unstable" .

onto:Series a owl:Class ;
    rdfs:label "Series"@en ;
    rdfs:comment "A comic publication containing one or more volumes and issues."@en ;
    rdfs:subClassOf onto:Publication,
        <http://schema.org/Periodical> ;
    ns1:term_status "unstable" .

onto:Publication a owl:Class ;
    rdfs:label "Publication"@en ;
    rdfs:comment "A comics publication."@en ;
    rdfs:subClassOf onto:Comic ;
    ns1:term_status "unstable" .

owl:Thing rdfs:label "Thing"@en .

onto:Copy a owl:Class ;
    rdfs:label "Copy"@en ;
    rdfs:comment "A copy of a comic issue."@en ;
    rdfs:subClassOf onto:Issue,
        onto:Item,
        <http://schema.org/IndividualProduct> ;
    ns1:term_status "unstable" .

onto:Role a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:comment "A creative role in the production of a comic work."@en ;
    rdfs:subClassOf <http://schema.org/Intangible> ;
    ns1:term_status "unstable" .

onto:Format a owl:Class ;
    rdfs:label "Format"@en ;
    rdfs:comment "A format in which a comic is embodied."@en ;
    rdfs:subClassOf <http://schema.org/Intangible> ;
    ns1:term_status "unstable" .

onto:Grade a owl:Class ;
    rdfs:label "Grade"@en ;
    rdfs:comment "A grade assigned to a comic item that represents a summary of its condition."@en ;
    rdfs:subClassOf <http://schema.org/Intangible> ;
    ns1:term_status "unstable" .

onto:Comic a owl:Class ;
    rdfs:label "Comic"@en ;
    rdfs:comment "A visual and literary work of sequential art."@en ;
    rdfs:subClassOf <http://schema.org/CreativeWork> ;
    ns1:term_status "testing" .

onto:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "A physical condition describing an object."@en ;
    rdfs:subClassOf onto:PhysicalAttribute ;
    ns1:term_status "unstable" .

onto:Issue a owl:Class ;
    rdfs:label "Issue"@en ;
    rdfs:comment "An issue of a comic publication."@en ;
    rdfs:subClassOf onto:Publication,
        <http://schema.org/Product>,
        <http://schema.org/PublicationIssue> ;
    ns1:term_status "unstable" .

