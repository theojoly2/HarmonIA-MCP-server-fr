<https://w3id.org/lso/intro/beta202408#R40_hasBibliographicalData> a owl:DatatypeProperty ;
    rdfs:label "R40 has bibliographical data"@en ;
    rdfs:comment "Links a text or image (work, expression, ...) to its bibliographical data, represented as a data string. (A shortcut for the actual modelling of bibliographical data.)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> ) ] ;
    rdfs:range xsd:string .

<https://w3id.org/lso/intro/beta202408#R41_hasLocation> a owl:DatatypeProperty ;
    rdfs:label "R41 has location"@en ;
    rdfs:comment "Defines the location of an INT16 Segment in e.g. a F3 Manifestation, e.g. by giving page or paragraph numbers. Can be replaced by oa:hasSelector to specify the location utilizing the multiple options provided by the Web Annotation Ontology\\n\\t\\t\\t(https://www.w3.org/TR/annotation-vocab/#web-annotation-ontology)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/lso/intro/beta202408#INT16_Segment> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] ;
    rdfs:range xsd:string ;
    skos:broadMatch <http://www.w3.org/ns/oa#hasSelector> .

<https://w3id.org/lso/intro/beta202408#R42_hasParaphraseOrDefinition> a owl:DatatypeProperty ;
    rdfs:label "R42 has paraphrase or definition"@en ;
    rdfs:comment "Links pretty much everything to a data string providing a definition for it. (A shortcut for modelling the definition as an INT2 Actualization of Feature.)"@en ;
    rdfs:range xsd:string .

<https://w3id.org/lso/intro/beta202408#R43_hasSpecification> a owl:DatatypeProperty ;
    rdfs:label "R43 has specification"@en ;
    rdfs:comment "Links a feature to a data string defining or describing it more closely."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT4_Feature> ;
    rdfs:range xsd:string .

<https://w3id.org/lso/intro/beta202408#R44_hasWording> a owl:DatatypeProperty ;
    rdfs:label "R44 has wording"@en ;
    rdfs:comment "Links an INT21 Text Passage or an INT16 Segment to a data string providing its exact wording."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/lso/intro/beta202408#INT16_Segment> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] .

<http://www.cidoc-crm.org/cidoc-crm/E55_Type> a owl:Class .

<http://www.cidoc-crm.org/cidoc-crm/P2_has_type> a owl:ObjectProperty .

<http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> a owl:ObjectProperty .

foaf:Person a owl:Class .

<https://d-nb.info/gnd/1036708799> a owl:NamedIndividual,
        foaf:Person .

<https://w3id.org/lso/intro/beta202408#R12_hasReferredToEntity> a owl:ObjectProperty ;
    rdfs:label "R12 has referred to entity"@en ;
    rdfs:comment "Links an INT3 Interrelation to the entity referred to in the relationship (a text or image on any ontological level or a feature actualized in the text resp. image in question)."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:subPropertyOf <https://w3id.org/lso/intro/beta202408#R24_hasRelatedEntity> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R12i_isReferredToEntity> .

<https://w3id.org/lso/intro/beta202408#R12i_isReferredToEntity> a owl:ObjectProperty ;
    rdfs:label "R12i is referred to entity"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    rdfs:subPropertyOf <https://w3id.org/lso/intro/beta202408#R24i_isRelatedEntity> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R12_hasReferredToEntity> .

<https://w3id.org/lso/intro/beta202408#R13_hasReferringEntity> a owl:ObjectProperty ;
    rdfs:label "R13 has referring entity"@en ;
    rdfs:comment "Links an INT3 Interrelation to a referring entity (a text or image on any ontological level or a feature actualized in the text resp. image in question)."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:subPropertyOf <https://w3id.org/lso/intro/beta202408#R24_hasRelatedEntity> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R13i_isReferringEntity> .

<https://w3id.org/lso/intro/beta202408#R13i_isReferringEntity> a owl:ObjectProperty ;
    rdfs:label "R13i is referring entity"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    rdfs:subPropertyOf <https://w3id.org/lso/intro/beta202408#R24i_isRelatedEntity> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R13_hasReferringEntity> .

<https://w3id.org/lso/intro/beta202408#R16_incorporates> a owl:ObjectProperty ;
    rdfs:label "R16 incorporates"@en ;
    rdfs:comment "Links an INT16 Segment to the text or image on any ontological level (passage, expression, work) it incorporates."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT16_Segment> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R16i_isIncorporatedIn> .

<https://w3id.org/lso/intro/beta202408#R16i_isIncorporatedIn> a owl:ObjectProperty ;
    rdfs:label "R16i is incorporated in"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT16_Segment> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R16_incorporates> .

<https://w3id.org/lso/intro/beta202408#R17_actualizesFeature> a owl:ObjectProperty ;
    rdfs:label "R17 actualizes feature"@en ;
    rdfs:comment "Links the specific INT2 Actualization of Feature to the (abstract concept of the) feature it actualizes, an INT4 Feature."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT4_Feature> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R17i_featureActualizedIn> .

<https://w3id.org/lso/intro/beta202408#R17i_featureActualizedIn> a owl:ObjectProperty ;
    rdfs:label "R17i feature actualized in"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT4_Feature> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R17_actualizesFeature> .

<https://w3id.org/lso/intro/beta202408#R18_showsActualization> a owl:ObjectProperty ;
    rdfs:label "R18 shows actualization"@en ;
    rdfs:comment "Links a text or an image (on any ontological level) or an INT2 Actualization of Feature to an INT2 Actualization of Feature found on it. (Actualizations found on actualizations - this occurs in cases where, e.g., the actualization of the feature INT Individual Character can be read as the actualization of the feature INT Character Type or INT18 Reference.)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R18i_actualizationFoundOn> .

<https://w3id.org/lso/intro/beta202408#R18i_actualizationFoundOn> a owl:ObjectProperty ;
    rdfs:label "R18i actualization found on"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R18_showsActualization> .

<https://w3id.org/lso/intro/beta202408#R19_hasType> a owl:ObjectProperty ;
    rdfs:label "R19 has type"@en ;
    rdfs:comment "Links an INT3 Interrelation to its INT11 Type of Interrelation."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT11_TypeOfInterrelation> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R19i_isTypeOf> .

<https://w3id.org/lso/intro/beta202408#R19i_isTypeOf> a owl:ObjectProperty ;
    rdfs:label "R19i is type of"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT11_TypeOfInterrelation> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R19_hasType> .

<https://w3id.org/lso/intro/beta202408#R20_discusses> a owl:ObjectProperty ;
    rdfs:label "R20 discusses"@en ;
    rdfs:comment "Links an INT Interpretation to the instance of text or image (on any ontological level) it discusses."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT_Interpretation> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67_refers_to> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R20i_isDiscussedIn> .

<https://w3id.org/lso/intro/beta202408#R20i_isDiscussedIn> a owl:ObjectProperty ;
    rdfs:label "R20i is discussed in"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT_Interpretation> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R20_discusses> .

<https://w3id.org/lso/intro/beta202408#R21_identifies> a owl:ObjectProperty ;
    rdfs:label "R21 identifies"@en ;
    rdfs:comment "Links an INT Identification or INT Interpretation to the INT3 Interrelation or the INT2 Actualization of Feature it identifies."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT_Interpretation> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ) ] ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67_refers_to> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R21i_isIdentifiedBy> .

<https://w3id.org/lso/intro/beta202408#R21i_isIdentifiedBy> a owl:ObjectProperty ;
    rdfs:label "R21i is identified by"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT_Interpretation> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R21_identifies> .

<https://w3id.org/lso/intro/beta202408#R22_providesSimilarityForRelation> a owl:ObjectProperty ;
    rdfs:label "R22 provides similarity for relation"@en ;
    rdfs:comment "Links an INT4 Feature to an INT3 Interrelation it provides the similarity for, the similarity being necessary for the detection of the INT3 Interrelation. States that an INT3 Interrelation is based on a similarity, i.e. the actualization of the same INT4 Feature in two different texts/images."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT4_Feature> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R22i_relationIsBasedOnSimilarity> .

<https://w3id.org/lso/intro/beta202408#R22i_relationIsBasedOnSimilarity> a owl:ObjectProperty ;
    rdfs:label "R22i relation is based on similarity"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT4_Feature> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R22_providesSimilarityForRelation> .

<https://w3id.org/lso/intro/beta202408#R23_providesSupportFor> a owl:ObjectProperty ;
    rdfs:label "R23 provides support for"@en ;
    rdfs:comment "Relates a source (a text on any ontological level or an actualization of a feature on said source) to the outcome of a receptional or interpretative act (an INT2 Actualization of Feature, an INT4 Feature like an INT Interpretation, an INT3 Interrelation) to support it."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> <https://w3id.org/lso/intro/beta202408#INT4_Feature> ) ] ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R23i_supportProvidedBy> .

<https://w3id.org/lso/intro/beta202408#R23i_supportProvidedBy> a owl:ObjectProperty ;
    rdfs:label "R23i support provided by"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> <https://w3id.org/lso/intro/beta202408#INT4_Feature> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R23_providesSupportFor> .

<https://w3id.org/lso/intro/beta202408#R25_hasSegment> a owl:ObjectProperty ;
    rdfs:label "R25 has segment"@en ;
    rdfs:comment "Links a F3 Manifestation to an INT16 Segment it contains (the segment in turn R16 incorporates an INT1 Passage or an F2 Expression)."@en ;
    rdfs:domain ns1:F3_Manifestation ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT16_Segment> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R25i_isSegmentOf> .

<https://w3id.org/lso/intro/beta202408#R25i_isSegmentOf> a owl:ObjectProperty ;
    rdfs:label "R25i is segment of"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT16_Segment> ;
    rdfs:range ns1:F3_Manifestation ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R25_hasSegment> .

<https://w3id.org/lso/intro/beta202408#R30_hasTextPassage> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "R30 has text passage"@en ;
    rdfs:comment "Links (usually, exceptions are easily conceivable) a text, like a work or an expression, to an INT21 Text Passage from that text, e.g. a book to a passage on page three of this book."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT21_TextPassage> ;
    rdfs:subPropertyOf <https://w3id.org/lso/intro/beta202408#R10_hasPassage> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R30i_isTextPassageOf> .

<https://w3id.org/lso/intro/beta202408#R30i_isTextPassageOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "R30i is text passage of"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT21_TextPassage> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] ;
    rdfs:subPropertyOf <https://w3id.org/lso/intro/beta202408#R10i_isPassageOf> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R30_hasTextPassage> .

<https://w3id.org/lso/intro/beta202408#R31_hasImageArea> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "R31 has image area"@en ;
    rdfs:comment "Links (usually, eceptions are easily conceivable) an image, like a work or an expression, to an INT22 Image Area from that image, e.g. a painting to an area on this paining."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT22_ImageArea> ;
    rdfs:subPropertyOf <https://w3id.org/lso/intro/beta202408#R10_hasPassage> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R31i_isImageAreaOf> .

<https://w3id.org/lso/intro/beta202408#R31i_isImageAreaOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "R31i is image area of"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT22_ImageArea> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] ;
    rdfs:subPropertyOf <https://w3id.org/lso/intro/beta202408#R10i_isPassageOf> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R31_hasImageArea> .

<https://w3id.org/lso/intro/beta202408#R3_constellates> a owl:ObjectProperty ;
    rdfs:label "R3 constellates"@en ;
    rdfs:comment "Links an INT Constellation to the elements (INT2 Actualizations of Feature) that together form that INT Constellation."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT_Constellation> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R3i_isConstellatedBy> .

<https://w3id.org/lso/intro/beta202408#R3i_isConstellatedBy> a owl:ObjectProperty ;
    rdfs:label "R3i is constellated by"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT_Constellation> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R3_constellates> .

<https://w3id.org/lso/intro/beta202408#R4_defines> a owl:ObjectProperty ;
    rdfs:label "R4 defines"@en ;
    rdfs:comment "Relates an actualization (usually: of the semantic feature 'INT Definition') to an INT11 Type of Interrelation, to INT4 Features, or to INT6 Architexts and thereby links e.g. a feature of text passage – e.g. a definition in Foucault's writings – to a concept - e.g. 'discourse'."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/lso/intro/beta202408#INT11_TypeOfInterrelation> <https://w3id.org/lso/intro/beta202408#INT4_Feature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R4i_isDefinedIn> .

<https://w3id.org/lso/intro/beta202408#R4i_isDefinedIn> a owl:ObjectProperty ;
    rdfs:label "R4i is defined in"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://w3id.org/lso/intro/beta202408#INT11_TypeOfInterrelation> <https://w3id.org/lso/intro/beta202408#INT4_Feature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R4_defines> .

<https://w3id.org/lso/intro/beta202408#R8_hasOpinionObject> a owl:ObjectProperty ;
    rdfs:label "R8 has opinion object"@en ;
    rdfs:comment "Links an INT Opinion to its object - for example an opinion with the theme fashion (to make it an opinion about fashion)."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT_Opinion> ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67_refers_to> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R8i_isOpinionObjectOf> .

<https://w3id.org/lso/intro/beta202408#R8i_isOpinionObjectOf> a owl:ObjectProperty ;
    rdfs:label "R8i is opinion object of"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT_Opinion> ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R8_hasOpinionObject> .

<https://w3id.org/lso/intro/beta202408#R9_hasSubsequentActualization> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "R9 has subsequent actualization"@en ;
    rdfs:comment "Links an INT2 Actualization of Feature to another INT4 following it (logically or chronologically); this object property was mostly designed for the representation of the structure of research papers, where one definition, interpretation, etc., follows another."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R9i_hasPrecedingActualization> .

<https://w3id.org/lso/intro/beta202408#R9i_hasPrecedingActualization> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "R9i has preceding actualization"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R9_hasSubsequentActualization> .

ns1:F3_Manifestation a owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> .

<http://www.cidoc-crm.org/cidoc-crm/E89_Propositional_Object> a owl:Class .

<http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object> a owl:Class .

<https://w3id.org/lso/intro/beta202001> a ns1:F2_Expression,
        owl:NamedIndividual ;
    rdfs:label "INTRO beta202001"@en ;
    dc:date "2020-01-01"^^xsd:date ;
    rdfs:comment "Changes from version beta201901 to version beta202001: Some classes and relations could be resolved into types of intertextual relations; this concerned in particular the class INT5 Characteristic and adherent object relations. \\n\\t\\t\\t- Deleted class INT5 Characteristic, accordingly: deleted relations R1, R2, R14-16; changes on relations: R21, R23, R24 - Deleted relations R5, R6, R7 \\n\\t\\t\\t- Added class INT17 Functional Relation as a subclass of INT11 Type of Intertextual Relation. (2020-01) "@en ;
    owl:versionInfo "beta202001" .

<https://w3id.org/lso/intro/beta202210> a ns1:F2_Expression,
        owl:NamedIndividual ;
    rdfs:label "INTRO beta202210"@en ;
    ns1:R76_is_derivative_of <https://w3id.org/lso/intro/beta202001> ;
    dc:date "2022-10-01"^^xsd:date ;
    rdfs:comment "Changes from version beta202001 to version beta202210: \\n\\t\\t\\t- A necessary modification was made on INT16: It was renamed \"Segment\" and its description was altered: The now more flexible INT16 can incorporate portions of e.g. F22 Self-contained Expressions of any size, meaning not only whole texts, but also INT1 Text Passages. \\n\\t\\t\\t- The INT16 is now also a direct subclass of E90 Symbolic Object. \\n\\t\\t\\t- Properties indicating position inside a document, that before related to INT1 Text Passage now also relate to INT16 Segment - since a Text Passage as taken from a F22 Self-contained Expression does not yet have the form of a published work and because of that can not be identified via e.g. page numbers (but only by indication of verse, act, chapter etc.). A INT16 as a part of a published text can. \\n\\t\\t\\t- After close examination it became clear that \"r10 has text passage\" (as well as the inversion) cannot be meaningfully related to \"F1 Work\", since \"Work\" cannot have text passages. As a result, \"Work\" was deleted from the domain of \"r10 has text passage\". \\n\\t\\t\\t- \"r10\" is now also no longer related to \"F2 Expression\", but to the parent class \"E73 Information Object\". This allows the modeling of text passages assigned to entities outside the narrow definition of the class \"Expression\" - since \" Expression\" by no means covers all written documents. \\n\\t\\t\\t- In domains/ranges throughout the model, \"F2 Expression\" was replaced with \"E73 Information Object\". \\n\\t\\t\\t- Erlangen-CRM and the related serialization of FRBRoo were replaced. \\n\\t\\t\\t- \"INT0\" in labels was replaced with \"INT\". \\n\\t\\t\\t- owl:import was deleted. \\n\\t\\t\\t- All named individuals were deleted. (2022-10) "@en ;
    owl:priorVersion <https://w3id.org/lso/intro/beta202001> ;
    owl:versionInfo "beta202210" .

<https://w3id.org/lso/intro/beta202304> a ns1:F2_Expression,
        owl:NamedIndividual ;
    rdfs:label "INTRO beta202304"@en ;
    ns1:R76_is_derivative_of <https://w3id.org/lso/intro/beta202210> ;
    dc:date "2023-04-01"^^xsd:date ;
    rdfs:comment "Changes from version beta202210 to version beta202304: \\n\\t\\t\\t- A new property R16_incorporates and its inverse have been added to link the INT16_Segment - an E90_Symbolic_Object - to an E73_Information_Object it incorporates; a similar property already exists in CIDOC - P165_incorporates - but is limited to E73_Information_Object as a domain. A INT16_Segment can't be clearly classified as an E73_Information_Object. (2023-01) \\n\\t\\t\\t- A new subclass of INT9 Semantic Feature has been created: INT18 Reference. \\n\\t\\t\\t- \"INT_Event\" and \"INT_State\" are no longer subclasses of \"INT_Plot\" but sibling classes (and subclasses of \"INT9_SemanticFeature\") - since they are actually not a kind of plot, but rather an element in a plot. (2022-11) "@en ;
    owl:priorVersion <https://w3id.org/lso/intro/beta202210> ;
    owl:versionInfo "beta202304" .

<https://w3id.org/lso/intro/beta202408#INT10_FormalFeature> a owl:Class ;
    rdfs:label "INT10 Formal Feature"@en ;
    rdfs:comment "This class comprises subclasses for every formal aspect of a text or image. It is divided into the subclasses INT Part and INT Composition, the former containing elements possibly structured according to the latter. Instances or subclasses of these two classes are likely also instances / subclasses of other subclasses of INT4 Feature: An INT Part can at the same time be an INT Object (formal and semantic) or an INT Dramatic Entity (formal and rhetorical); questions of perspective and vanishing point can be considered in a formal as well as a rhetorical respect. As a consequence of the ontology's origin, INT Part is currently dominated by literary terms which makes the addition of custom subclasses for pictorial features necessary."@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT4_Feature> .

<https://w3id.org/lso/intro/beta202408#INT21_TextPassage> a owl:Class ;
    rdfs:label "INT21 Text Passage"@en ;
    rdfs:comment "The INT21 TextPassage is a means of modelling an identifiable part of an E73 Information Object or its subclasses – without that part being removed from its source Information Object. \\n\\t\\t\\tExamples: \\n\\t\\t\\t- The words 'Abandon all hope ye who enter here' from Canto III of Dante's Inferno. \\n\\t\\t\\t- The first four lines of Rilke's poem \"Archaischer Torso Apollos\" \\n\\t\\t\\t- The last item on a shopping list. \\n\\t\\t\\tThe skos:broadMatch states that the INT21 TextPassage can be regarded as an oa:SpecificResource in the sense that it is a section of a resource.\\n\\t\\t\\tThe skos:broadMatch between R41 hasLocation and oa:hasSelector indicates that by replacing R41 hasLocation with oa:hasSelector, multiple selector options from the Web Annotation Ontology can be utilized to specify the INT21 TextPassage's location."@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT1_Passage> ;
    skos:broadMatch <http://www.w3.org/ns/oa#SpecificResource> .

<https://w3id.org/lso/intro/beta202408#INT22_ImageArea> a owl:Class ;
    rdfs:label "INT22 Image Area"@en ;
    rdfs:comment "The INT22 ImageArea is a means of modelling an identifiable part of an image (itself modelled as an E73 Information Object or one of its subclasses) – without that part being removed from its source Information Object.\\n\\t\\t\\tExamples: \\n\\t\\t\\t- The part of Leonardo's Mona Lisa showing Mona Lisa's smile. \\n\\t\\t\\t- The bottom 3/5 of Rothko's Painting \"Orange And Yellow\" (1956), dominated by the fuzzy orange rectangle. \\n\\t\\t\\t- The part of the \"Smiley Face\" originally invented by Harvey Ball that shows the Smiley's left eye. \\n\\t\\t\\t- The part of Piranesi's The Drawbridge, 2nd version, showing a drawbridge.\\n\\t\\t\\t\\t\\t\\t\\n\\t\\t\\tThe skos:broadMatch states that the INT22 ImageArea can be regarded as an oa:SpecificResource in the sense that it is a section of a resource. \\n\\t\\t\\tThe skos:broadMatch between R41 hasLocation and oa:hasSelector indicates that by replacing R41 hasLocation with oa:hasSelector, multiple selector options from the Web Annotation Ontology can be utilized to specify the INT22 ImageArea's location."@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT1_Passage> ;
    skos:broadMatch <http://www.w3.org/ns/oa#SpecificResource> .

<https://w3id.org/lso/intro/beta202408#INT_Character> a owl:Class ;
    rdfs:label "INT Character"@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT9_SemanticFeature> .

<https://w3id.org/lso/intro/beta202408#INT_Constellation> a owl:Class ;
    rdfs:label "INT Constellation"@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT9_SemanticFeature> .

<https://w3id.org/lso/intro/beta202408#INT_GenreSpecifics> a owl:Class ;
    rdfs:label "INT Genre Specifics"@en ;
    rdfs:comment "INT Genre Specifics comprises all features that are used to assign a certain genre - whether textual or visual -, are typical of such a genre, or occur frequently in it. Instances might often be also instances of the other subclasses of INT4 Feature. INT Genre Specifics' two subclasses – INT Visual Genre Specifics and INT Textual Genre Specifics – do not imply that each feature must be either–or, in some cases features will be assignable to both classes."@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT8_RhetoricalFeature> .

<https://w3id.org/lso/intro/beta202408#INT_Object> a owl:Class ;
    rdfs:label "INT Object"@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT9_SemanticFeature> .

<https://w3id.org/lso/intro/beta202408#INT_Opinion> a owl:Class ;
    rdfs:label "INT Opinion"@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT9_SemanticFeature> .

<https://w3id.org/lso/intro/beta202408#INT_Place> a owl:Class ;
    rdfs:label "INT Place"@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT9_SemanticFeature> .

<http://www.cidoc-crm.org/cidoc-crm/P67_refers_to> a owl:ObjectProperty .

<http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by> a owl:ObjectProperty .

<https://w3id.org/lso/intro/beta202408#INT8_RhetoricalFeature> a owl:Class ;
    rdfs:label "INT8 Rhetorical Feature"@en ;
    rdfs:comment "This class comprises every aspect of a text or an image that can be described in terms of rhetorics - ranging from the occurrence of rhetorical tropes to parts of an e.g. research paper like 'introduction' or 'quotation' (pragmatic entities) to aspects of the narrative act such as 'voice' or 'narrating time' (narratological entities). Questions of composition in visual arts can often also be classified as a rhetorical feature."@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT4_Feature> .

<https://w3id.org/lso/intro/beta202408#INT_TextualGenreSpecifics> a owl:Class ;
    rdfs:label "INT Textual Genre Specifics"@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT_GenreSpecifics> .

<https://w3id.org/lso/intro/beta202408#R10_hasPassage> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "R10 has passage"@en ;
    rdfs:comment "Links a text or an image – usually: a work or an expression – to an INT1 Passage from that text or image, e.g. a book to a passage on page three of this book, or a painting to an area on this paining."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT1_Passage> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R10i_isPassageOf> .

<https://w3id.org/lso/intro/beta202408#R10i_isPassageOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "R10i is passage of"@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT1_Passage> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> ) ] ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R10_hasPassage> .

<https://w3id.org/lso/intro/beta202408#R24_hasRelatedEntity> a owl:ObjectProperty ;
    rdfs:label "R24 has related entity"@en ;
    rdfs:comment "Links any INT3 Interrelation to a text or image (on any ontological level) or INT2 Actualization of Feature that is part of the INT3 Interrelation. The skos:broadMatch states that this property is a more specific version of oa:hasTarget in the sense that the INT3 Interrelation can be seen as an annotation, the texts/images linked by this relationship as their targets."@en ;
    rdfs:domain <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R24i_isRelatedEntity> ;
    skos:broadMatch <http://www.w3.org/ns/oa#hasTarget> .

<https://w3id.org/lso/intro/beta202408#R24i_isRelatedEntity> a owl:ObjectProperty ;
    rdfs:label "R24i is related entity"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:F1_Work <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> <https://w3id.org/lso/intro/beta202408#INT1_Passage> <https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> <https://w3id.org/lso/intro/beta202408#INT6_Architext> ) ] ;
    rdfs:range <https://w3id.org/lso/intro/beta202408#INT3_Interrelation> ;
    owl:inverseOf <https://w3id.org/lso/intro/beta202408#R24_hasRelatedEntity> .

ns1:F2_Expression a owl:Class ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> .

<http://www.cidoc-crm.org/cidoc-crm/E28_Conceptual_Object> a owl:Class .

<https://w3id.org/lso/intro/beta202408#INT23_VisualFeature> a owl:Class ;
    rdfs:label "INT23 Visual Feature"@en ;
    rdfs:comment "This class contains visual features of images - but possibly also of texts. Its subclasses are rudimentary, it is very likely that instances of other INT4 Feature subclasses can be classified as visual features at the same time. This might be the case for, e.g., INT Composition (although for these instances classification as an INT26 Shape should also be considered)."@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT4_Feature> .

<https://w3id.org/lso/intro/beta202408#INT_Interpretation> a owl:Class ;
    rdfs:label "INT Interpretation"@en ;
    rdfs:comment "The result of a interpretative act, possibly: as perceived in research literature. An interpretation can identify references or actualizations or the like. A number of interpretations can together recreate the structure of, e.g., a research paper. Accordingly, apart from linking INT Interpretations to the subjects of the interpretation, like intertextual relations or textual features, they can be linked to each other via R9 has subsequent feature resp. R9i has preceding feature. \\n\\t\\t\\tExamples: \\n\\t\\t\\t- the statement that Umberto Eco's 'The Name of the Rose' features a detective character. \\n\\t\\t\\t- the statement that Umberto Eco's 'The Name of the Rose' contains references to Arthur Conan Doyle's 'Sherlock Holmes'. \\n\\t\\t\\t- the statement that Umberto Eco's 'The Name of the Rose' is set in the 14th century. \\n\\t\\t\\t- the conclusion that Umberto Eco's 'The Name of the Rose' belongs to the genre 'postmodern crime novel'."@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E89_Propositional_Object>,
        <https://w3id.org/lso/intro/beta202408#INT9_SemanticFeature>,
        <https://w3id.org/lso/intro/beta202408#INT_PragmaticFeature> .

<https://w3id.org/lso/intro/beta202408#INT_PragmaticFeature> a owl:Class ;
    rdfs:label "INT Pragmatic Feature"@en ;
    rdfs:comment "The class includes all features that can be attributed to a text or image with regard to the role that these works play in a plot, for example in a social, political or religious context. These characteristics take account of the fact that the works in question pursue a specific purpose that goes beyond content and form and that is apparent 'on the surface‘ or by application of certain conventions or handed-down standards. While INTRO-subclasses of this class are limited to those close to the functionality of INTRO and which are to be applied to the relation between primary and secondary (textual) sources, subclasses can of course also include concepts from visual art. A pragmatic feature of a painting might be a donor portrait expressing gratitude, the portrait of a ruler serving propaganda purposes, a bible scene serving as guide for pious action. Pragmatic features of texts include bibliographic references, acknowledgments, and the like."@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT8_RhetoricalFeature> .

<https://w3id.org/lso/intro/beta202408#INT16_Segment> a owl:Class ;
    rdfs:label "INT16 Segment"@en ;
    rdfs:comment "This class comprises expressions (e.g. texts represented as F2 Expressions) or parts thereof as they are represented in F3 Manifestations. INT16 Segments can be located inside the F3 Manifestation by means of page numbers etc. and are thus identifiable (and citable). They are not identical to/subclasses of F3 Manifestations, since they only make a part of it; they are not identical to F2 Expressions, since they have distinct metadata linking them to, e. g., a certain edition of a work. The INT16 Segment can be linked to an F2 Expression (resp. a E36 Visual Item) or an INT1 Passage through R16 incorporates. It can be linked to a physical carrier (like LRMs \"F5_Item\") through P128 is carried by."@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object> ;
    skos:broadMatch <http://www.w3.org/ns/oa#SpecificResource> .

<https://w3id.org/lso/intro/beta202408#INT_Part> a owl:Class ;
    rdfs:label "INT Part"@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT10_FormalFeature> .

<https://w3id.org/lso/intro/beta202408#INT24_TextualFeature> a owl:Class ;
    rdfs:label "INT24 Textual Feature"@en ;
    rdfs:comment "This class contains textual features, usually found on texts - but possibly also on images. It is very likely that instances of other INT4 Feature subclasses can be classified as textual features at the same time."@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT4_Feature> .

<https://w3id.org/lso/intro/beta202408#INT11_TypeOfInterrelation> a owl:Class ;
    rdfs:label "INT11 Type of Interrelation"@en ;
    rdfs:comment "This class comprises (as subclasses) the many classifications of interrelations between instances of texts of images (on any ontological level) that are identified, for example, in research literature, but also in greek rhetoric, in genre theory and so on."@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> .

ns1:F1_Work a owl:Class .

<https://w3id.org/lso/intro/beta202408#INT4_Feature> a owl:Class ;
    rdfs:label "INT4 Feature"@en ;
    rdfs:comment "This class comprises features that 'are in' or 'can be found in' or 'can be read out of' a text or an image. INT2 Actualizations of these features are the results of a receptive process that identifies the specific form the INT4 Feature – a distinct abstract concept, itself separate from the text or image – takes in the text or image. This class therefore has a wide scope. Its domain could be divided into subclasses following any number of different ratios; to avoid the resulting restrictions and/or complex hierarchies, the actual subclasses of the INT4 Feature represent diverse approaches to its subject matter, covering medial aspects as well as aspect of form and semantics. They can be populated resp. extended with custom subclasses based e.g. on relevant reference works: The class INT8 Rhetorical Feature could contain concepts based on classical rhetoric like allegory or personification, but would of course also include the pictorial pendants of these tropes. Lemmata from handbooks of poetic terms as well as concepts of pictorial composition could populate the INT10 Formal Feature resp. its (sub-)subclasses. Subclasses of INT9 Semantic Feature could be extended using art thesauri as well as handbooks on literary motives.\\n\\t\\t\\tFor external thesauri and vocabularies see, e. g., ICONCLASS, the Getty Art and Architecture Thesaurus, the Getty Cultural Objects Name Authority, the Getty Union List of Artist Names, the Literary Theme Ontology (LTO), the Document Components Ontology, the OntoPoetry Ontology, the Taxonomy of Themes and Motifs (TTM2) ..."@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E28_Conceptual_Object> .

<https://w3id.org/lso/intro/beta202408#INT3_Interrelation> a owl:Class ;
    rdfs:label "INT3 Interrelation"@en ;
    rdfs:comment "This class comprises the abstract notion of a relationship between texts and/or images resp. their parts as it is identified by a recipient (which is not the same as the rhetorical entity 'quotation'). Every INT3 Interrelation has at least 2 related entities, which are texts/images (on any ontological level) or INT2 Actualizations of Features. An INT3 Interrelation is possibly identified in an INT Interpretation and further defined by an INT11 TypeOfInterrelation. \\n\\t\\t\\tThe skos:broadMatch to oa:Annotation indicates that stating the existence of an intertextual relation can be seen as a kind of annotation made to resources, in this case: at least two, the related entities (texts and/or images)."@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E28_Conceptual_Object> ;
    skos:broadMatch <http://www.w3.org/ns/oa#Annotation> .

<http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object> a owl:Class .

<https://w3id.org/lso/intro/beta202408#INT1_Passage> a owl:Class ;
    rdfs:label "INT1 Passage"@en ;
    rdfs:comment "The INT1 Passage is a means of modelling an identifiable part of an E73 Information Object or its subclasses – without that part being removed from its source Information Object. \\n\\t\\t\\tFor examples, see subclass comments. \\n\\t\\t\\tThe skos:broadMatch states that the INT1 Passage can be regarded as an oa:SpecificResource in the sense that it is a section of a resource. \\n\\t\\t\\tThe skos:broadMatch between R41 hasLocation and oa:hasSelector indicates that by replacing R41 hasLocation with oa:hasSelector, multiple selector options from the Web Annotation Ontology can be utilized to specify the INT1 Passage's location."@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object> ;
    skos:broadMatch <http://www.w3.org/ns/oa#SpecificResource> .

<https://w3id.org/lso/intro/beta202408#INT6_Architext> a owl:Class ;
    rdfs:label "INT6 Architext"@en ;
    rdfs:comment "An INT6 Architextual Entity consists in a number of texts/images which in some way give reason to see them as connected, related, sharing a common feature. \\n\\t\\t\\tExamples for INT6 Architextual Entities can be \\n\\t\\t\\t- discourses (members sharing a discoursive element, a topic etc.) \\n\\t\\t\\t- genres (members sharing genre conventions) \\n\\t\\t\\t- a discipline (members deriving from the same disciplinary background) \\n\\t\\t\\t- an oeuvre (members created by the same person) \\n\\t\\t\\t- national literatures/arts (members whose creators share a nationality) etc."@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E28_Conceptual_Object> .

<https://w3id.org/lso/intro/beta202408#INT9_SemanticFeature> a owl:Class ;
    rdfs:label "INT9 Semantic Feature"@en ;
    rdfs:comment "This class comprises every semantic aspect of a text or image, like the common notions of 'plot', 'sujet', or 'character'. While most subclasses are still object to refinement and addition – to indicate their provisional status they are not yet numbered in this version of INTRO –, INT18 Reference has been numbered to indicate its consolidated status."@en ;
    rdfs:subClassOf <https://w3id.org/lso/intro/beta202408#INT4_Feature> .

<https://w3id.org/lso/intro/beta202408#INT2_ActualizationOfFeature> a owl:Class ;
    rdfs:label "INT2 Actualization of Feature"@en ;
    rdfs:comment "The fact that a text or an image shows - in its own specific way - a certain feature (which itself is an abstract concept and takes form in many texts/images), e.g. a motif, an atmosphere, a theme, a figure of speech. \\n\\t\\t\\tExamples: \\n\\t\\t\\t- the specific actualization of the motif of patricide in Sophokles' 'Ödipus Rex'. \\n\\t\\t\\t- the specific actualization of the Faust-subject in Goethe's 'Faust'. \\n\\t\\t\\t- the specific actualization of the iambic pentameter in Rilke's 'Archaischer Torso Apollos\".\\n\\t\\t\\t- the specific actualization of the Ophelia-character in John Everett Millais' painting \"Ophelia\" (1852).\\t\\n\\t\\t"@en ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E28_Conceptual_Object> .

