@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix onto: <http://purl.org/dqm-vocabulary/v1/dqm> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:subject a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

onto: a owl:Ontology ;
    rdfs:label "The Data Quality Management Vocabulary - An Ontology for Data Requirements Management, Data Quality Monitoring, Data Quality Assessment, and Data Cleansing"@en ;
    dc:creator "Christian Fürber and Martin Hepp"^^xsd:string ;
    dc:rights "The Data Quality Management Vocabulary is available under the Creative Commons Attribution - Non Commercial - Share Alike 3.0 Unported license; see http://creativecommons.org/licenses/by-nc-sa/3.0/. In a nutshell, you are free to copy, distribute and transmit the work and to remix/adapt the work (e.g. to import the ontology and create specializations of its elements) for non commercial purposes, as long as you attribute the work in the manner specified by the author or licensor (but not in any way that suggests that they endorse you or your use of the work). Proper Attribution: Simply include the statement \"This work is based on the Data Quality Management Vocabulary, developed by Christian Fürber and Martin Hepp\" and link back to http://purl.org/dqm-vocabulary ."^^xsd:string ;
    dc:subject "Data Quality Management, Data Quality Assessment, Data Quality Monitoring, Data Profiling, Data Cleansing, Data Requirements Management"^^xsd:string ;
    dc:title "The Data Quality Management Vocabulary"^^xsd:string ;
    dcterms:license "http://creativecommons.org/licenses/by-nc-sa/3.0/"^^xsd:string ;
    rdfs:comment "The Data Quality Management Vocabulary provides an ontology for the structured representation of data requirements, data quality assessment results, data cleansing rules, and data requirement violations connected to their origin. It, therefore, supports data quality monitoring, data quality assessment, and data cleansing in Semantic Web architectures."@en ;
    owl:versionInfo "V 1.00, Release 09-10-2011"^^xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#DuplicateInstance> a owl:Class ;
    rdfs:label "Duplicate Instance"@en ;
    rdfs:comment "Two or more instances are duplicates when they represent the same real world entity."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> .

<http://purl.org/dqm-vocabulary/v1/dqm#DuplicateInstanceRule> a owl:Class ;
    rdfs:label "Duplicate Instance Rule"@en ;
    rdfs:comment "A duplicate instance rule is a multi property requirement which specifies the properties that (when seen together) uniquely identify an entity. I.e. if the properties of two or more different instances represent the same state, then the instances represent the same entity. Thus, the instances are considered to be duplicates."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#MatchingValueRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#ExpiryRule> a owl:Class ;
    rdfs:label "Expiry Rule"@en ;
    rdfs:comment "An expiry rule is an outdated instance rule that specifies the expiration date of an instance that must not exceed the current date and time. Therefore, expiry rules require date information about the validity period of an instance."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#OutdatedInstanceRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#FunctionalDependencyViolation> a owl:Class ;
    rdfs:label "Functional Dependency Violation"@en ;
    rdfs:comment "A functional dependency violation is a combination of different property values within the same instance that must not occur together. E.g. an instance describing the man “Peter Miller” has the value “Mr.” as salutation property, but the value “female” as sex."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> .

<http://purl.org/dqm-vocabulary/v1/dqm#IllegalValue> a owl:Class ;
    rdfs:label "Illegal Value"@en ;
    rdfs:comment "An illegal value is a data value that must not be used for a property."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> .

<http://purl.org/dqm-vocabulary/v1/dqm#MissingProperty> a owl:Class ;
    rdfs:label "Missing Property"@en ;
    rdfs:comment "A property is missing when an instances does not contain a specific property that is required."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#MissingElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#MissingPropertyAndValue> a owl:Class ;
    rdfs:label "Missing Property and Value"@en ;
    rdfs:comment "Class for instances that miss both a property and its value."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#MissingElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#MissingValue> a owl:Class ;
    rdfs:label "Missing Value"@en ;
    rdfs:comment "A missing value occurs when a property of an instance does not hold a value."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#MissingElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#OutOfRangeValue> a owl:Class ;
    rdfs:label "Out of Range Value"^^xsd:string ;
    rdfs:comment "A value is out of range when it is not part of the legal value range or when it is part of the illegal value range."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> .

<http://purl.org/dqm-vocabulary/v1/dqm#OutdatedInstance> a owl:Class ;
    rdfs:label "Outdated Instance"@en ;
    rdfs:comment "An instance is outdated when it represents an outdated state of its corresponding real-world entity."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> .

<http://purl.org/dqm-vocabulary/v1/dqm#PopulationCompleteness> a owl:Class ;
    rdfs:label "Population Completeness"@en ;
    rdfs:comment "Population completeness is the degree to which all objects of a certain reference are represented in a specific class."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#Completeness> .

<http://purl.org/dqm-vocabulary/v1/dqm#PopulationUniqueness> a owl:Class ;
    rdfs:label "Population Uniqueness"@en ;
    rdfs:comment "Entity uniqueness is the degree to which entities (that must be uniquely represented within a certain class) are unique."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#Uniqueness> .

<http://purl.org/dqm-vocabulary/v1/dqm#PropertyCompleteness> a owl:Class ;
    rdfs:label "Property Completeness"@en ;
    rdfs:comment "Property completeness is the degree to which values for a specific property are missing in entities of a specific class."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#Completeness> .

<http://purl.org/dqm-vocabulary/v1/dqm#PropertyUniqueness> a owl:Class ;
    rdfs:label "Property Uniqueness"@en ;
    rdfs:comment "Property uniqueness is the degree to which the values of a property (that must only contain unique values within instances of a certain class) are unique."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#Uniqueness> .

<http://purl.org/dqm-vocabulary/v1/dqm#SemanticAccuracy> a owl:Class ;
    rdfs:label "Semantic Accuracy"@en ;
    rdfs:comment "Semantic accuracy is the degree to which the data values of an instance represent the correct state of an entity’s property."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#Accuracy> .

<http://purl.org/dqm-vocabulary/v1/dqm#StrictValueCombination> a owl:Class ;
    rdfs:label "Strict Value Combination Rule"@en ;
    rdfs:comment "A strict value combination is a combination of two values of different properties that may only be assigned to each other, but not to other values."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyCleansingRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#SyntacticAccuracy> a owl:Class ;
    rdfs:label "Syntactic Accuracy"@en ;
    rdfs:comment "Syntactic accuracy is the degree to which data values of a property represent legal values and are free from syntax violations."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#Accuracy> .

<http://purl.org/dqm-vocabulary/v1/dqm#SyntaxViolation> a owl:Class ;
    rdfs:label "Syntax Violation"@en ;
    rdfs:comment "A syntax violation is a data requirement violation that occurs when a data value contains disallowed characters or does not match a predefined pattern."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> .

<http://purl.org/dqm-vocabulary/v1/dqm#Timeliness> a owl:Class ;
    rdfs:label "Timeliness"@en ;
    rdfs:comment "Timeliness is the degree to which instances of a specific class (1) are updated within an expected time or (2) have not exceeded their expiration date."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> .

<http://purl.org/dqm-vocabulary/v1/dqm#UniqueValueRule> a owl:Class ;
    rdfs:label "Unique Value Rule"@en ;
    rdfs:comment "A unique value rule is a property requirement that specifies that each value of a certain property must be unique in instances of a certain class."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#PropertyRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#UniquenessViolation> a owl:Class ;
    rdfs:label "Uniqueness Violation"@en ;
    rdfs:comment "A uniqueness violation occurs when two or more identical values are assigned to a property that requires unique values."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> .

<http://purl.org/dqm-vocabulary/v1/dqm#WhitespaceRemoval> a owl:Class ;
    rdfs:label "White Space Removal Rule"@en ;
    rdfs:comment "A white space removal rule states that whitespaces at the beginning of a string and at the end of a string shall be removed for the specified property."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#LiteralCleansingRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#addProperty> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Add Property"@en ;
    rdfs:comment "A property that shall be added to an instance."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#PropertyCompletion> ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#cleansingProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#addValue> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Add Value"@en ;
    rdfs:comment "A value that shall be added to a property of an instance."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#PropertyCompletion> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#cleansingProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#affectedClass> a owl:ObjectProperty ;
    rdfs:label "Affected Class"@en ;
    rdfs:comment "An affected class holds one or more instances with one or more data requirement violations."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#AffectedClass> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#affectedInstance> a owl:ObjectProperty ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#AffectedInstance> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#affectedProperty> a owl:ObjectProperty ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#AffectedProperty> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#appliesFor> a owl:ObjectProperty ;
    rdfs:label "Applies For"@en ;
    rdfs:comment "Connects data requirements with the tasks in which the requirement applies."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#Task> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataRequirementsRelationship> ;
    owl:inverseOf <http://purl.org/dqm-vocabulary/v1/dqm#hasRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#assessedClass> a owl:ObjectProperty ;
    rdfs:label "Assessed Class"@en ;
    rdfs:comment "The assessed class is the class that holds the instances that have been analyzed to compute the assessment score."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#TestedClass> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#assessedProperty> a owl:ObjectProperty ;
    rdfs:label "Assessed Property"@en ;
    rdfs:comment "The assessed property represents all properties that have been tested for rule violations during the computation of the assessment score."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#TestedProperty> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#assessment> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The assessment property indicates whether the rule shall be used for data quality assessment."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#basedOn> a owl:ObjectProperty ;
    rdfs:label "Based On"@en ;
    rdfs:comment "Connects a data quality score with the data requirements that were used to calculate the score."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataRequirementsRelationship> ;
    owl:inverseOf <http://purl.org/dqm-vocabulary/v1/dqm#hasScore> .

<http://purl.org/dqm-vocabulary/v1/dqm#blacklistClass> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Blacklist Class"@en ;
    rdfs:comment "A blacklist class holds instances with values that are disallowed for a certain data set."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#IllegalValueRule> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#BlacklistClass> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#blacklistProperty> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Blacklist Property"@en ;
    rdfs:comment "A blacklist property holds the values that are disallowed for a certain data set."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#IllegalValueRule> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#BlacklistProperty> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#cleansesClass> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Cleanses Class"@en ;
    rdfs:comment "This property identifies classes that contain instances that shall be cleansed via a data cleansing rule."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataCleansingRule> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#TestedClass> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataCleansingRuleRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#cleansesProperty1> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Cleanses Property 1"@en ;
    rdfs:comment "This property identifies a property that holds values that shall be cleansed."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataCleansingRule> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#TestedProperty> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataCleansingRuleRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#cleansing> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Cleansing"@en ;
    rdfs:comment "The data cleansing property specifies whether the rule shall be applied to cleanse the data in a data source."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#commonCode> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "UN/CEFACT common code"@en ;
    rdfs:comment "UN/CEFACT common code of a unit of measurement."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Unit> ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#conditionalProperty> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Conditional Property"@en ;
    rdfs:comment "The conditional property property indicates the URI of a property that holds values that can be used to filter the relevant subset of data for which a rule applies."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Condition> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#TestedProperty> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#confidence> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Confidence"@en ;
    rdfs:comment "The confidence property indicates how confident a rule creators is regarding the correctness of the rule."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#contains> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Contains"@en ;
    rdfs:comment "Holds one or more consecutive characters that are supposed to be found in strings of another property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#Condition> <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepValueRule> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#operatedValue> .

<http://purl.org/dqm-vocabulary/v1/dqm#currentValue> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Current Value"@en ;
    rdfs:comment "The current value propertiy specifies the value to be removed."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#ValueSubstitution> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#cleansingProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#endsWith> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Ends With"@en ;
    rdfs:comment "Holds one or more consecutive characters that are supposed to be found at the end of strings of another property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#Condition> <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepValueRule> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#operatedValue> .

<http://purl.org/dqm-vocabulary/v1/dqm#equals> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Equals"@en ;
    rdfs:comment "Holds one or more consecutive characters that are supposed to be found in the same order in strings of another property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#Condition> <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepValueRule> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#operatedValue> .

<http://purl.org/dqm-vocabulary/v1/dqm#expectedUpdateInterval> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Expected Update Interval"@en ;
    rdfs:comment "The expected update interval specifies the time interval in which instances of a specific class must be updated in order to be current."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#UpdateRule> ;
    rdfs:range xsd:duration .

<http://purl.org/dqm-vocabulary/v1/dqm#filtering> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Filtering"@en ;
    rdfs:comment "The filtering property indicates whether the rule shall be used for information filtering, i.e. only high quality data is retrieved."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#greaterThan> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Greater Than"@en ;
    rdfs:comment "Holds a numeric value that is used to identify values of a property that are greater than the value of this property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#Condition> <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepValueRule> ) ] ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#operatedValue> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasCondition1> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Has Condition 1"@en ;
    rdfs:comment "Connects a conditional rule with a certain condition."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalRule> <http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyCleansingRule> ) ] ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#hasCondition> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasCondition2> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Has Condition 2"@en ;
    rdfs:comment "Connects a conditional rule with a certain condition."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalRule> <http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyCleansingRule> ) ] ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#hasCondition> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasCondition3> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Has Condition 3"@en ;
    rdfs:comment "Connects a conditional rule with a certain condition."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalRule> <http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyCleansingRule> ) ] ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#hasCondition> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasCondition4> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Has Condition 4"@en ;
    rdfs:comment "Connects a conditional rule with a certain condition."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalRule> <http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyCleansingRule> ) ] ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#hasCondition> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasCondition5> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Has Condition 5"@en ;
    rdfs:comment "Connects a conditional rule with a certain condition."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalRule> <http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyCleansingRule> ) ] ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#hasCondition> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasProperties> a owl:ObjectProperty ;
    rdfs:label "Has Properties"@en ;
    rdfs:comment "Reconnects mapped classes and properties with each other."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#AffectedClass> <http://purl.org/dqm-vocabulary/v1/dqm#BlacklistClass> <http://purl.org/dqm-vocabulary/v1/dqm#TestedClass> <http://purl.org/dqm-vocabulary/v1/dqm#TrustedClass> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#AffectedProperty> <http://purl.org/dqm-vocabulary/v1/dqm#BlacklistProperty> <http://purl.org/dqm-vocabulary/v1/dqm#TestedProperty> <http://purl.org/dqm-vocabulary/v1/dqm#TrustedProperty> ) ] ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasURI> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Has URI"@en ;
    rdfs:comment "The hasURI property is used to map properties to instances of a class."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> ;
    rdfs:range xsd:anyURI .

<http://purl.org/dqm-vocabulary/v1/dqm#importance> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Importance"@en ;
    rdfs:comment "Specifies the importance of a task, a data quality rule, or a data element."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> <http://purl.org/dqm-vocabulary/v1/dqm#Task> ) ] ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#lastModified> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Last Modified"@en ;
    rdfs:comment "The property lastModified indicates the date and time when the rule was last modified."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#lessThan> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Less Than"@en ;
    rdfs:comment "Holds a numeric value that is used to identify values of a property that are less than the value of this property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#Condition> <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepValueRule> ) ] ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#operatedValue> .

<http://purl.org/dqm-vocabulary/v1/dqm#lowerLimit> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Lower Limit"@en ;
    rdfs:comment "Specifies the lower limit a numeric property value shall obtain."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#IllegalValueRangeRule> <http://purl.org/dqm-vocabulary/v1/dqm#LegalValueRangeRule> <http://purl.org/dqm-vocabulary/v1/dqm#Unit> ) ] ;
    rdfs:range xsd:float .

<http://purl.org/dqm-vocabulary/v1/dqm#newValue> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "New Value"@en ;
    rdfs:comment "The new value property specifies the new value which shall substitute the current value."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#ValueSubstitution> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#cleansingProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#next> a owl:ObjectProperty ;
    rdfs:comment "Links an instances to the next instance in an ordinal scale."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#ScaleValue> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#ScaleValue> .

<http://purl.org/dqm-vocabulary/v1/dqm#notEqualTo> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Not Equal To"@en ;
    rdfs:comment "Holds one or more consecutive characters that are used to identify values of another property that do not match with the value of this property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#Condition> <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepValueRule> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#operatedValue> .

<http://purl.org/dqm-vocabulary/v1/dqm#officialName> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Official Name"@en ;
    rdfs:comment "Official name of a value."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#ScaleValue> ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#pattern> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Pattern"@en ;
    rdfs:comment "The pattern property can be used to express value patterns based on a simple syntax without the need for knowing regular expressions. E.g. the pattern \"AaaaaNN\" where \"A\" stands for capital letters, \"a\" for small letters, and \"N\" for numbers."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalSyntaxRule> <http://purl.org/dqm-vocabulary/v1/dqm#SyntaxRule> ) ] ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#plainScore> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Plain Score"@en ;
    rdfs:comment "The plain score represents a data quality dimension score that was assessed by using a certain formula that accounts for the violations of data quality rules related to the size of the relevant data set."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> ;
    rdfs:range rdfs:Literal .

<http://purl.org/dqm-vocabulary/v1/dqm#rank> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Rank"@en ;
    rdfs:comment "Position of a value in an ordinal scale."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#ScaleValue> ;
    rdfs:range xsd:int .

<http://purl.org/dqm-vocabulary/v1/dqm#referenceClass> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Reference Class"@en ;
    rdfs:comment "The reference class property points to the URI of a class that contains trusted instances, i.e. instances of high quality."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepReferenceRule> <http://purl.org/dqm-vocabulary/v1/dqm#LegalValueRule> ) ] ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#TrustedClass> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty1> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Reference Property 1"@en ;
    rdfs:comment "The reference property points to the URI of a property that holds trusted values, i.e. values of high quality"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepReferenceRule> <http://purl.org/dqm-vocabulary/v1/dqm#LegalValueRule> ) ] ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty2> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Reference Property 2"@en ;
    rdfs:comment "The reference property points to the URI of a property that holds trusted values, i.e. values of high quality"@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepReferenceRule> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty3> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Reference Property 3"@en ;
    rdfs:comment "The reference property points to the URI of a property that holds trusted values, i.e. values of high quality"@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepReferenceRule> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty4> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Reference Property 4"@en ;
    rdfs:comment "The reference property points to the URI of a property that holds trusted values, i.e. values of high quality"@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepReferenceRule> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty5> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Reference Property 5"@en ;
    rdfs:comment "The reference property points to the URI of a property that holds trusted values, i.e. values of high quality"@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepReferenceRule> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#regex> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Regular Expression"@en ;
    rdfs:comment "The regular expressions property can be used to express legal character ranges and data patterns for values of a certain property via regular expressions."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalSyntaxRule> <http://purl.org/dqm-vocabulary/v1/dqm#SyntaxRule> ) ] ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#reqDescription> a owl:DatatypeProperty ;
    rdfs:label "Requirement Description"@en ;
    rdfs:comment "Describes a data requirement in natural language."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#reqName> a owl:DatatypeProperty ;
    rdfs:label "Requirement Name"@en ;
    rdfs:comment "Specifies the name of a data requirement in natural language."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#DataCleansingRule> <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#reqSource> a owl:DatatypeProperty ;
    rdfs:label "Requirement Source"@en ;
    rdfs:comment "Specifies the source of a data requirement."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#DataCleansingRule> <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#requiredProperty> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Required Property"@en ;
    rdfs:comment "Specifies whether a property must exist."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalPropertyCompletenessRule> <http://purl.org/dqm-vocabulary/v1/dqm#PropertyCompletenessRule> ) ] ;
    rdfs:range xsd:boolean .

<http://purl.org/dqm-vocabulary/v1/dqm#requiredValue> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Required Value"@en ;
    rdfs:comment "Specifies whether a value for a property must exist."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalPropertyCompletenessRule> <http://purl.org/dqm-vocabulary/v1/dqm#PropertyCompletenessRule> ) ] ;
    rdfs:range xsd:boolean .

<http://purl.org/dqm-vocabulary/v1/dqm#ruleViolation> a owl:ObjectProperty ;
    rdfs:label "Rule Violation"@en ;
    rdfs:comment "Connects data requirements with data quality problems that have been identified using the requirement."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataRequirementsRelationship> ;
    owl:inverseOf <http://purl.org/dqm-vocabulary/v1/dqm#ruleOfIdentification> .

<http://purl.org/dqm-vocabulary/v1/dqm#scaleType> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Scale Type"@en ;
    rdfs:comment "Type of statistical scale."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Unit> ;
    rdfs:range [ a owl:DataRange ;
            owl:oneOf ( "interval"^^xsd:string "nominal"^^xsd:string "ordinal"^^xsd:string "ratio"^^xsd:string ) ] .

<http://purl.org/dqm-vocabulary/v1/dqm#scaleValues> a owl:ObjectProperty ;
    rdfs:label "Scale Values"@en ;
    rdfs:comment "Links to values of a certain ordinal or nominal scale."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Unit> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#ScaleValue> .

<http://purl.org/dqm-vocabulary/v1/dqm#sparqlrule> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "SPARQL rule"@en ;
    rdfs:comment "This property can store custom data requirements that are expressed via SPARQL queries."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#CustomRequirement> ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#startsWith> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Starts With"@en ;
    rdfs:comment "Holds one or more consecutive characters that are supposed to be found at the beginning of strings of another property."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#Condition> <http://purl.org/dqm-vocabulary/v1/dqm#FuncDepValueRule> ) ] ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#operatedValue> .

<http://purl.org/dqm-vocabulary/v1/dqm#subTaskOf> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Sub Task Of"@en ;
    rdfs:comment "Property that can be used to represent hierachies of between tasks."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Task> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#Task> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataRequirementsRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#taskDependent> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Task Dependent"@en ;
    rdfs:comment "Specifies whether the data quality rule is task dependent."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#taskDescription> a owl:DatatypeProperty ;
    rdfs:label "Task Description"@en ;
    rdfs:comment "Describes the task in natural language."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Task> ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#taskName> a owl:DatatypeProperty ;
    rdfs:label "Task Name"@en ;
    rdfs:comment "Specifies the name of the task."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Task> ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#technicalName> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Technical Name"@en ;
    rdfs:comment "Technical name of a value."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#ScaleValue> ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#testedClass> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Tested Class"@en ;
    rdfs:comment "The tested class property specifies the class that holds the instances that shall be tested for data quality problems."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#TestedClass> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#testedProperty1> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Tested Property 1"@en ;
    rdfs:comment "The property with the values that shall be tested for data quality problems."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#testedProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#testedProperty2> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Tested Property 2"@en ;
    rdfs:comment "The property with the values that shall be tested for data quality problems."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#MatchingValueRule> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#testedProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#testedProperty3> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Tested Property 3"@en ;
    rdfs:comment "The property with the values that shall be tested for data quality problems."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#MatchingValueRule> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#testedProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#testedProperty4> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Tested Property 4"@en ;
    rdfs:comment "The property with the values that shall be tested for data quality problems."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#MatchingValueRule> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#testedProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#testedProperty5> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Tested Property 5"@en ;
    rdfs:comment "The property with the values that shall be tested for data quality problems."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#MatchingValueRule> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#testedProperty> .

<http://purl.org/dqm-vocabulary/v1/dqm#timeOfAssessment> a owl:DatatypeProperty ;
    rdfs:label "Time Of Assessment"@en ;
    rdfs:comment "The time of assessment represents the data and time when the data quality score was computed."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> ;
    rdfs:range xsd:dateTime .

<http://purl.org/dqm-vocabulary/v1/dqm#timeOfIdentification> a owl:DatatypeProperty ;
    rdfs:label "Time Of Identification"@en ;
    rdfs:comment "The time of identification property specifies the date and time in which the data quality problem was detected"@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> ;
    rdfs:range xsd:dateTime .

<http://purl.org/dqm-vocabulary/v1/dqm#unitDescription> a owl:DatatypeProperty ;
    rdfs:label "Unit Description"@en ;
    rdfs:comment "Description of a unit of measurement."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Unit> ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#unitName> a owl:DatatypeProperty ;
    rdfs:label "Unit Name"@en ;
    rdfs:comment "Name of a unit of measurement."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Unit> ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#unitOfConfidence> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Unit of Confidence"@en ;
    rdfs:comment "The unit in which confidence is expressed."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#Unit> .

<http://purl.org/dqm-vocabulary/v1/dqm#unitOfImportance> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Unit of Importance"@en ;
    rdfs:comment "The unit in which importance is expressed."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> <http://purl.org/dqm-vocabulary/v1/dqm#Task> ) ] ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#Unit> .

<http://purl.org/dqm-vocabulary/v1/dqm#unitOfMeasurement> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Unit of Measurement"@en ;
    rdfs:comment "Indicates the unit of measurement, e.g. of data quality scores. It is recommended to use UN/CEFACT common codes to specify the unit of measurement, e.g. \"P1\" stands for percent."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#Unit> .

<http://purl.org/dqm-vocabulary/v1/dqm#upperLimit> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Upper Limit"@en ;
    rdfs:comment "Specifies the upper limit a numeric property value shall obtain."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#IllegalValueRangeRule> <http://purl.org/dqm-vocabulary/v1/dqm#LegalValueRangeRule> <http://purl.org/dqm-vocabulary/v1/dqm#Unit> ) ] ;
    rdfs:range xsd:float .

<http://purl.org/dqm-vocabulary/v1/dqm#validFrom> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Valid From"@en ;
    rdfs:comment "Specifies the date and time from which a rule is valid."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#DataCleansingRule> <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ) ] ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#validUntil> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Valid Until"@en ;
    rdfs:comment "Specifies the date and time until a rule stays valid."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <http://purl.org/dqm-vocabulary/v1/dqm#DataCleansingRule> <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ) ] ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> .

<http://purl.org/dqm-vocabulary/v1/dqm#validation> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Validation"@en ;
    rdfs:comment "Validation indicates whether a data quality rule shall be used for validation during data entry."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range xsd:boolean .

<http://purl.org/dqm-vocabulary/v1/dqm#valueMeaning> a owl:DatatypeProperty ;
    rdfs:label "Value Meaning"@en ;
    rdfs:comment "Meaning of a value."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#ScaleValue> ;
    rdfs:range xsd:string .

<http://purl.org/dqm-vocabulary/v1/dqm#weightedScore> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Weighted Score"@en ;
    rdfs:comment "A weighted score is a data quality dimension score that is computed by integration of importance values of data requirements, tasks, or data elements."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> ;
    rdfs:range rdfs:Literal .

<http://purl.org/dqm-vocabulary/v1/dqm#AffectedInstance> a owl:Class ;
    rdfs:label "Affected Instance"@en ;
    rdfs:comment "An affected instance is a data instance that contains one or more data quality problems."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#ClassRequirement> a owl:Class ;
    rdfs:label "Class Requirement"@en ;
    rdfs:comment "A class requirement is a data requirement that refers to the instances of a class as a whole."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#CustomRequirement> a owl:Class ;
    rdfs:label "Custom Requirement"@en ;
    rdfs:comment "A custom requirement is a data requirement that is expressed via a SPARQL query."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#UpdateRule> a owl:Class ;
    rdfs:label "Update Rule"@en ;
    rdfs:comment "An update rule is an outdated instance rule that specifies the maximum duration tolerated without any updates. Update rules require timestamps about the last update of an instance."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#OutdatedInstanceRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasRequirement> a owl:ObjectProperty ;
    rdfs:label "Has Requirement"@en ;
    rdfs:comment "Specifies the data requirements that have to be fulfilled to perform the task."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#Task> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataRequirementsRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasScore> a owl:ObjectProperty ;
    rdfs:label "Has Score"@en ;
    rdfs:comment "Connects data requirements with the data quality score which was calculated based on the requirement."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataRequirementsRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#ruleOfIdentification> a owl:ObjectProperty ;
    rdfs:label "Rule Of Identification"@en ;
    rdfs:comment "The rule of identification property connects the data quality problem instances with the instance of the data requirement that has detected the problem."@en ;
    rdfs:domain <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataRequirementsRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#Accuracy> a owl:Class ;
    rdfs:label "Accuracy"@en ;
    rdfs:comment "Accuracy is the degree to which a data value represents the desired state regarding its syntax and semantics."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> .

<http://purl.org/dqm-vocabulary/v1/dqm#AffectedClass> a owl:Class ;
    rdfs:label "Affected Class"^^xsd:string ;
    rdfs:comment "An affected class holds one or more affected instances"@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#AffectedProperty> a owl:Class ;
    rdfs:label "Affected Property"^^xsd:string ;
    rdfs:comment "An affected property specifies the property of a data instance that contains one or more data quality problems."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#BlacklistClass> a owl:Class ;
    rdfs:label "Blacklist Class"@en ;
    rdfs:comment "A blacklist class holds instances with values that are disallowed for a certain data set. Thus, illegal value rules refer to such classes over the blacklist class property."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#BlacklistProperty> a owl:Class ;
    rdfs:label "Blacklist Property"@en ;
    rdfs:comment "A blacklist property holds the values that are disallowed for a certain data set."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#Completeness> a owl:Class ;
    rdfs:label "Completeness"@en ;
    rdfs:comment "Completeness is the extent to which data are of sufficient breadth, depth, and scope for the task at hand."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> .

<http://purl.org/dqm-vocabulary/v1/dqm#ConditionalPropertyCompletenessRule> a owl:Class ;
    rdfs:label "Conditional Data Competeness Rule"@en ;
    rdfs:comment "Conditional property completeness rules specify that a tested property and/or its literal values must exist when the value of another property obtains a certain state. E.g. the property foo:state must exist and have a value when the property foo:country obtains the value \"USA\"."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#ConditionalSyntaxRule> a owl:Class ;
    rdfs:label "Conditional Syntax Rule"@en ;
    rdfs:comment "Conditional syntax rules define that the literal values of a tested property must follow a certain syntax when the value of another property obtains a certain state. E.g. the property foo:state must have a value with two capital letters when the property foo:country obtains the value \"USA\"."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#IllegalValueRangeRule> a owl:Class ;
    rdfs:label "Illegal Value Range Rule"@en ;
    rdfs:comment "An illegal value range rule is a property requirement that specifies the upper and/or lower boundary of numeric values that a certain property must not obtain."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#PropertyRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#IllegalValueRule> a owl:Class ;
    rdfs:label "Illegal Value Rule"@en ;
    rdfs:comment "An illegal value rule is a property requirement that specifies the values that a certain property must not obtain. Illegal value rules, therefore, refer to reference properties that hold all disallowed values."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#PropertyRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#LegalValueRangeRule> a owl:Class ;
    rdfs:label "Legal Value Range Rule"@en ;
    rdfs:comment "A legal value range rule is a property requirement that specifies the upper and/or lower boundary of numeric values that a certain property is allowed to obtain."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#PropertyRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#LegalValueRule> a owl:Class ;
    rdfs:label "Legal Value Rule"@en ;
    rdfs:comment "A legal value rule is a property requirement that specifies all values that a certain property is allowed to obtain. Legal value rules, therefore, refer to reference properties of classes that hold instances with all allowed values."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#PropertyRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#LiteralCleansingRule> a owl:Class ;
    rdfs:label "Literal Cleansing Rule"@en ;
    rdfs:comment "Literal cleansing rules can be used to cleanse the literal values of a certain property."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataCleansingRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyRequirement> a owl:Class ;
    rdfs:label "Multi Property Requirement"@en ;
    rdfs:comment "Multi property requirements are data requirements that consider values from two or more properties."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#OutdatedInstanceRule> a owl:Class ;
    rdfs:label "Outdated Instance Rule"@en ;
    rdfs:comment "An outdated instance rule is a data requirement that specifies the point in time when an instance is not current anymore."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#ClassRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#PropertyCompletenessRule> a owl:Class ;
    rdfs:label "Property Completeness Rule"@en ;
    rdfs:comment "A property completeness rule is a data requirement that specifies that a certain property and/or its value must exist in all instances of a certain class."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#PropertyRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#PropertyCompletion> a owl:Class ;
    rdfs:label "Property Completion Rule"@en ;
    rdfs:comment "A property completion rule specifies a property and value that shall be added to certain instances."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyCleansingRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#SyntaxRule> a owl:Class ;
    rdfs:label "Syntax Rule"@en ;
    rdfs:comment "A syntax rule is a property requirement that specifies the allowed characters and/or character pattern to be used in values for a certain property in instances of a certain class."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#PropertyRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#TrustedClass> a owl:Class ;
    rdfs:label "Trusted Class"@en ;
    rdfs:comment "Legal value rules and functional dependency reference rules require the specification of a trusted class as a reference that holds instances with legal values / legal value combinations."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#TrustedProperty> a owl:Class ;
    rdfs:label "Trusted Property"@en ;
    rdfs:comment "A trusted property holds the values that serve as a trusted reference in legal value rules / functional dependency reference rules, e.g. to define legal values for a tested property."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#Uniqueness> a owl:Class ;
    rdfs:label "Uniqueness"@en ;
    rdfs:comment "Uniqueness is the degree to which properties and classes are free of duplicate values and instances."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> .

<http://purl.org/dqm-vocabulary/v1/dqm#ValueSubstitution> a owl:Class ;
    rdfs:label "Value Substitution Rule"@en ;
    rdfs:comment "A value substitution rule specifies a value to be removed and a new value that shall substitute the removed value."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#LiteralCleansingRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#dataCleansingRuleRelationship> a owl:ObjectProperty ;
    rdfs:label "Data Cleansing Rule Relationship"@en ;
    rdfs:comment "Data cleansing rule relationships are object properties of the data cleansing rules."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#MissingElement> a owl:Class ;
    rdfs:label "Missing Element"@en ;
    rdfs:comment "A missing element is a data requirement violation that occurs when schema elements, instances, or data values are missing, but required."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> .

<http://purl.org/dqm-vocabulary/v1/dqm#TestedClass> a owl:Class ;
    rdfs:label "Tested Class"@en ;
    rdfs:comment "A tested class is a class that holds the instances that shall be analyzed for data quality problems."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#cleansingProperty> a owl:DatatypeProperty ;
    rdfs:label "Cleansing Property"@en ;
    rdfs:comment "Cleansing properties are properties of data cleansing rules."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#TestedProperty> a owl:Class ;
    rdfs:label "Tested Property"@en ;
    rdfs:comment "A tested property holds the values to be analyzed for data quality problems."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataElement> .

<http://purl.org/dqm-vocabulary/v1/dqm#hasCondition> a owl:ObjectProperty ;
    rdfs:label "Condition"@en ;
    rdfs:comment "Connects a conditional rule with a certain condition"@en ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#Condition> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#referenceProperty> a owl:ObjectProperty ;
    rdfs:label "Reference Property"@en ;
    rdfs:comment "The reference property points to the URI of a property that holds trusted values, i.e. values of high quality"@en ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#TrustedProperty> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#testedProperty> a owl:ObjectProperty ;
    rdfs:label "Tested Property"@en ;
    rdfs:comment "The property with the values that shall be tested for data quality problems."@en ;
    rdfs:range <http://purl.org/dqm-vocabulary/v1/dqm#TestedProperty> ;
    rdfs:subPropertyOf <http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> .

<http://purl.org/dqm-vocabulary/v1/dqm#FuncDepReferenceRule> a owl:Class ;
    rdfs:label "Functional Dependency Reference Rule"@en ;
    rdfs:comment "A functional dependency reference rule is a multi property requirement that specifies legal value combinations for two or more properties that are allowed to occur within the same instance. Functional dependency reference rules refer to reference properties of classes that hold instances with all allowed value combinations."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#MatchingValueRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#MatchingValueRule> a owl:Class ;
    rdfs:label "Matching Value Rule"@en ;
    rdfs:comment "Matching value rules are multi property requirements in which the property values of other instances are used to identify data requirements violations in an instance."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#FuncDepValueRule> a owl:Class ;
    rdfs:label "Functionally Dependent Value Rule"@en ;
    rdfs:comment "A functionally dependent value rule defines that the value of a tested property must have a certain value when the values of other properties obtain certain states (conditions). E.g. the property foo:inStock must have value \"true\" when the property foo:availableAmount is greater than zero."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#ConditionalRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyCleansingRule> a owl:Class ;
    rdfs:label "Multi Property Cleansing Rule"@en ;
    rdfs:comment "Multi property cleansing rules can be used to cleanse the literal values of two or more dependent properties."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataCleansingRule> .

<http://purl.org/dqm-vocabulary/v1/dqm#PropertyRequirement> a owl:Class ;
    rdfs:label "Property Requirement"@en ;
    rdfs:comment "Property requirements are data requirements that are related to values of a single property."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#ScaleValue> a owl:Class ;
    rdfs:label "Scale Value"@en ;
    rdfs:comment "A scale value is a value of a nominal or ordinal scale."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#dataRequirementsRelationship> a owl:ObjectProperty ;
    rdfs:label "Data Requirements Relationship"@en ;
    rdfs:comment "The data requirements relationship property is an abstract property that holds object properties that are used to define internal and external relationships of data requirements."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#operatedValue> a owl:DatatypeProperty ;
    rdfs:label "Operated Value"@en ;
    rdfs:comment "The operated value property is an abstract property for datatype properties that are used to express string filtering criteria."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#ConditionalRule> a owl:Class ;
    rdfs:label "Conditional Rule"@en ;
    rdfs:comment "A conditional rule is a multi property requirement that can be used to specify that values of a tested property A must always obtain a certain state under the condition that values of another property B obtain a certain state (condition)."@en ;
    rdfs:subClassOf <http://purl.org/dqm-vocabulary/v1/dqm#MultiPropertyRequirement> .

<http://purl.org/dqm-vocabulary/v1/dqm#DataCleansingRule> a owl:Class ;
    rdfs:label "Data Cleansing Rule"@en ;
    rdfs:comment "A data cleansing rule is an unambiguous rule that precisely specifies the required state of a data value."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#Task> a owl:Class ;
    rdfs:label "Task"@en ;
    rdfs:comment "Classifies the tasks for which the data quality rule shall apply for."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#Condition> a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "A condition constrains instances of a class to a certain subset for which certain data quality rules apply."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#Unit> a owl:Class ;
    rdfs:label "Unit"@en ;
    rdfs:comment "Class for units of numerical values that are used to express certain property states."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#DataElement> a owl:Class ;
    rdfs:label "Data Element"@en ;
    rdfs:comment "A data element is a class, a property, an instance, or a literal value."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#DataQualityScore> a owl:Class ;
    rdfs:label "Data Quality Assessment"@en ;
    rdfs:comment "Data quality score is an abstract class that can be used to structure data quality dimension scores that indicate the quality state of classes and/or properties."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#reqMetadata> a owl:DatatypeProperty ;
    rdfs:label "Requirement Metadata"@en ;
    rdfs:comment "An abstract property that holds generic datatype properties that describe a data requirement."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#DataRequirementViolation> a owl:Class ;
    rdfs:label "Data Requirement Violation"@en ;
    rdfs:comment "A data requirement violation occurs when a data value or a data instance does not meet its requirements."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#dataElementRelationship> a owl:ObjectProperty ;
    rdfs:label "Data Element Relationship"@en ;
    rdfs:comment "The data element relationship property is an abstract property that holds object properties that are used to define internal and external relationships of data elements."@en .

<http://purl.org/dqm-vocabulary/v1/dqm#DataRequirement> a owl:Class ;
    rdfs:label "Data Requirement"@en ;
    rdfs:comment "A data requirement is a prescribed directive or consensual agreement that defines the content and/or structure that constitute high quality data instances and values."@en .

