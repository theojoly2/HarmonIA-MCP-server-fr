<http://ns.cerise-project.nl/energy/def/cim-smartgrid#Reading> a owl:Class ;
    rdfs:label "Reading" ;
    rdfs:comment "Specific value measured by a meter or other asset, or calculated by a system. Each Reading is associated with a specific ReadingType." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Metering> ;
    rdfs:subClassOf [ a owl:Restriction ;
