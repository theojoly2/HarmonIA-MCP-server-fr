@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://langdale.com.au/2005/UML#> .
@prefix onto: <http://ns.cerise-project.nl/energy/def/cim-smartgrid> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

onto: a owl:Ontology ;
    rdfs:label "A CIM Profile for Smart Grids"^^xsd:string ;
    dc:creator "Maarten Steen (TNO)" ;
    dc:publisher <http://www.cerise-project.nl/> ;
    rdfs:comment "A Profile of the IEC Common Information Model for Smart Grids, developed by the Cerise-SG project."^^xsd:string ;
    rdfs:seeAlso <http://www.iec.ch/smartgrid/standards/> ;
    owl:versionInfo "22/5/2014"^^xsd:string .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind.amiCapable> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind> ;
    rdfs:label "amiCapable" ;
    rdfs:comment "Usage point is equipped with an AMI capable meter that is not yet currently equipped with a communications module." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind.amiDisabled> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind> ;
    rdfs:label "amiDisabled" ;
    rdfs:comment "Usage point is equipped with an AMI capable meter; however, the AMI functionality has been disabled or is not being used." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind.billingApproved> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind> ;
    rdfs:label "billingApproved" ;
    rdfs:comment "Usage point is equipped with an operating AMI capable meter and accuracy has been certified for billing purposes." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind.enabled> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind> ;
    rdfs:label "enabled" ;
    rdfs:comment "Usage point is equipped with an AMI capable meter having communications capability." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind.nonAmi> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind> ;
    rdfs:label "nonAmi" ;
    rdfs:comment "Usage point is equipped with a non AMI capable meter." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind.nonMetered> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind> ;
    rdfs:label "nonMetered" ;
    rdfs:comment "Usage point is not currently equipped with a meter." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind.operable> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#AmiBillingReadyKind> ;
    rdfs:label "operable" ;
    rdfs:comment "Usage point is equipped with an AMI capable meter that is functioning and communicating with the AMI network." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.commercialIndustrial> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "commercialIndustrial" ;
    rdfs:comment "Commercial industrial customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.energyServiceScheduler> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "energyServiceScheduler" ;
    rdfs:comment "Customer as energy service scheduler." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.energyServiceSupplier> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "energyServiceSupplier" ;
    rdfs:comment "Customer as energy service supplier." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.internalUse> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "internalUse" ;
    rdfs:comment "Internal use customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.other> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "other" ;
    rdfs:comment "Other kind of customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.pumpingLoad> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "pumpingLoad" ;
    rdfs:comment "Pumping load customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.residential> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "residential" ;
    rdfs:comment "Residential customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.residentialAndCommercial> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "residentialAndCommercial" ;
    rdfs:comment "Residential and commercial customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.residentialAndStreetlight> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "residentialAndStreetlight" ;
    rdfs:comment "Residential and streetlight customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.residentialFarmService> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "residentialFarmService" ;
    rdfs:comment "Residential farm service customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.residentialStreetlightOthers> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "residentialStreetlightOthers" ;
    rdfs:comment "Residential streetlight or other related customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind.windMachine> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
    rdfs:label "windMachine" ;
    rdfs:comment "Wind machine customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.autonomousDst> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "autonomousDst" ;
    rdfs:comment "Autonomous application of daylight savings time (DST)." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.demandResponse> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "demandResponse" ;
    rdfs:comment "Demand response functions." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.electricMetering> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "electricMetering" ;
    rdfs:comment "Electricity metering." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.gasMetering> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "gasMetering" ;
    rdfs:comment "Gas metering." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.metrology> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "metrology" ;
    rdfs:comment "Presentation of metered values to a user or another system (always a function of a meter, but might not be supported by a load control unit)." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.onRequestRead> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "onRequestRead" ;
    rdfs:comment "On-request reads." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.outageHistory> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "outageHistory" ;
    rdfs:comment "Reporting historical power interruption data." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.relaysProgramming> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "relaysProgramming" ;
    rdfs:comment "Support for one or more relays that may be programmable in the meter (and tied to TOU, time pulse, load control or other functions)." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.reverseFlow> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "reverseFlow" ;
    rdfs:comment "Detection and monitoring of reverse flow." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind.waterMetering> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
    rdfs:label "waterMetering" ;
    rdfs:comment "Water metering." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind.ctRatio> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind> ;
    rdfs:label "ctRatio" ;
    rdfs:comment "Current transformer ratio used to convert associated quantities to real measurements." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind.kE> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind> ;
    rdfs:label "kE" ;
    rdfs:comment "Test constant." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind.kH> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind> ;
    rdfs:label "kH" ;
    rdfs:comment "Meter kh (watthour) constant. The number of watthours that must be applied to the meter to cause one disk revolution for an electromechanical meter or the number of watthours represented by one increment pulse for an electronic meter." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind.kR> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind> ;
    rdfs:label "kR" ;
    rdfs:comment "Register multiplier. The number to multiply the register reading by in order to get kWh." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind.ptRatio> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind> ;
    rdfs:label "ptRatio" ;
    rdfs:comment "Potential transformer ratio used to convert associated quantities to real measurements." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind.transformerRatio> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplierKind> ;
    rdfs:label "transformerRatio" ;
    rdfs:comment "Product of the CT ratio and PT ratio." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.electricity> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "electricity" ;
    rdfs:comment "Electricity service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.gas> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "gas" ;
    rdfs:comment "Gas service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.heat> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "heat" ;
    rdfs:comment "Heat service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.internet> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "internet" ;
    rdfs:comment "Internet service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.other> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "other" ;
    rdfs:comment "Other kind of service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.rates> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "rates" ;
    rdfs:comment "Rates (e.g. tax, charge, toll, duty, tariff, etc.) service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.refuse> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "refuse" ;
    rdfs:comment "Refuse (waster) service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.sewerage> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "sewerage" ;
    rdfs:comment "Sewerage service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.time> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "time" ;
    rdfs:comment "Time service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.tvLicence> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "tvLicence" ;
    rdfs:comment "TV license service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind.water> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceKind> ;
    rdfs:label "water" ;
    rdfs:comment "Water service." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#SimpleEndDeviceFunction> a owl:Class ;
    rdfs:label "SimpleEndDeviceFunction" ;
    rdfs:comment "Simple end device function distinguished by 'kind'. Use this class for instances that cannot be represented by another end device function specialisations." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Metering> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#SimpleEndDeviceFunction.kind> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#SimpleEndDeviceFunction.kind> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#SimpleEndDeviceFunction.kind> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunctionKind> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#SimpleEndDeviceFunction.kind> ],
        <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunction> .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#SupplierKind.other> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#SupplierKind> ;
    rdfs:label "other" ;
    rdfs:comment "Other kind of supplier." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#SupplierKind.retailer> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#SupplierKind> ;
    rdfs:label "retailer" ;
    rdfs:comment "Entity that sells the service, but does not deliver to the customer; applies to the deregulated markets." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#SupplierKind.utility> a <http://ns.cerise-project.nl/energy/def/cim-smartgrid#SupplierKind> ;
    rdfs:label "utility" ;
    rdfs:comment "Entity that delivers the service to the customer." .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Core> a ns1:Package ;
    rdfs:label "Core" ;
    rdfs:comment "Contains the core PowerSystemResource and ConductingEquipment entities shared by all applications plus common collections of those entities. Not all applications require all the Core entities.  This package does not depend on any other package except the Domain package, but most of the other packages have associations and generalizations that depend on it." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Base> .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Domain> a ns1:Package ;
    rdfs:label "Domain" ;
    rdfs:comment "The domain package define primitive datatypes that are used by classes in other packages. Stereotypes are used to describe the datatypes. The following stereotypes are defined:\\r\\n&lt;&lt;enumeration&gt;&gt; A list of permissible constant values.\\r\\n&lt;&lt;Primitive&gt;&gt; The most basic data types used to compose all other data types.\\r\\n&lt;&lt;CIMDatatype&gt;&gt; A datatype that contains a value attribute, an optional unit of measure and a unit multiplier. The unit and multiplier may be specified as a static variable initialized to the allowed value.\\r\\n&lt;&lt;Compound&gt;&gt; A composite of Primitive, enumeration, CIMDatatype or othe Compound classes, as long as the Compound classes do not recurse." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Base> .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_IEC61970> a ns1:Package ;
    rdfs:label "IEC61970" ;
    rdfs:comment "Top package for IEC 61970." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_TC57CIM> .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#global_package> a ns1:Package ;
    rdfs:label "Global" .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading> a owl:Class ;
    rdfs:label "BaseReading" ;
    rdfs:comment "Common representation for reading values. Note that a reading value may have multiple qualities, as produced by various systems ('ReadingQuality.source')." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Metering> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.source> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.value> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.source> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.source> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#DateTimeInterval> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.timePeriod> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.value> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.timePeriod> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#DateTimeInterval> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.timePeriod> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.value> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.timePeriod> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading.source> ],
        <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IdentifiedObject> .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#CoordinateSystem> a owl:Class ;
    rdfs:label "CoordinateSystem" ;
    rdfs:comment "Coordinate reference system." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Common> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CoordinateSystem.crsUrn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CoordinateSystem.crsUrn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CoordinateSystem.crsUrn> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CoordinateSystem.crsUrn> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CoordinateSystem.Location> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Location> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CoordinateSystem.Location> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Location> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CoordinateSystem.Location> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CoordinateSystem.Location> ],
        <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IdentifiedObject> .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#Customer> a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "Organisation receiving services from service supplier." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Customers> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Customer.kind> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Customer.kind> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerKind> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Customer.kind> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Customer.kind> ],
        <http://ns.cerise-project.nl/energy/def/cim-smartgrid#OrganisationRole> .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#ElectronicAddress> a owl:Class ;
    rdfs:label "ElectronicAddress" ;
    ns1:hasStereotype ns1:compound ;
    rdfs:comment "Electronic address information." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Common> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ElectronicAddress.web> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ElectronicAddress.password> ],
        [ a owl:Restriction ;
