<http://ns.cerise-project.nl/energy/def/cim-smartgrid#DateTimeInterval> a owl:Class ;
    rdfs:label "DateTimeInterval" ;
    ns1:hasStereotype ns1:compound ;
    rdfs:comment "Interval between two date and time points." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Domain> ;
