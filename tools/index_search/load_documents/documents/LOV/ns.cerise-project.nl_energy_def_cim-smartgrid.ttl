        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDevice> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#EndDeviceFunction.EndDevice> ],
        [ a owl:Restriction ;
