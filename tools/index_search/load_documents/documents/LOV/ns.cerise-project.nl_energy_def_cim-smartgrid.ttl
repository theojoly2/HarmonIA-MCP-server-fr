            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerAgreement.ServiceSupplier> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerAgreement.ServiceCategory> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerAgreement.ServiceSupplier> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerAgreement.ServiceSupplier> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerAgreement.ServiceCategory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Customer> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerAgreement.Customer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceCategory> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerAgreement.ServiceCategory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#ServiceSupplier> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#CustomerAgreement.ServiceSupplier> ],
        [ a owl:Restriction ;
