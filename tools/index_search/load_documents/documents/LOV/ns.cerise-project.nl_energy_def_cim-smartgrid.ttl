            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IntervalBlock.ReadingType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterReading> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IntervalBlock.MeterReading> ] .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#IntervalReading> a owl:Class ;
    rdfs:label "IntervalReading" ;
    rdfs:comment "Data captured at regular intervals of time. Interval data could be captured as incremental data, absolute data, or relative data. The source for the data is usually a tariff quantity or an engineering quantity. Data is typically captured in time-tagged, uniform, fixed-length intervals of 5 min, 10 min, 15 min, 30 min, or 60 min.\\r\\nNote: Interval Data is sometimes also called \"Interval Data Readings\" (IDR)." ;
    rdfs:isDefinedBy <http://ns.cerise-project.nl/energy/def/cim-smartgrid#Package_Metering> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IntervalReading.IntervalBlocks> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IntervalBlock> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IntervalReading.IntervalBlocks> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:int ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IntervalReading.IntervalBlocks> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IntervalBlock> ;
            owl:onProperty <http://ns.cerise-project.nl/energy/def/cim-smartgrid#IntervalReading.IntervalBlocks> ],
        <http://ns.cerise-project.nl/energy/def/cim-smartgrid#BaseReading> .

<http://ns.cerise-project.nl/energy/def/cim-smartgrid#MeterMultiplier> a owl:Class ;
