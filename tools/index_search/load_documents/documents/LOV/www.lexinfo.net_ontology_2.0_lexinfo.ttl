    rdfs:label "archaic form" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-504> ;
    rdfs:comment "A term or lexeme no longer in ordinary use, though retained for special purposes." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:article a ns3:ArticlePOS,
        ns3:DeterminerPOS,
        ns3:PartOfSpeech,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "article" ;
    ns2:creator "Francopoulo, Gil",
