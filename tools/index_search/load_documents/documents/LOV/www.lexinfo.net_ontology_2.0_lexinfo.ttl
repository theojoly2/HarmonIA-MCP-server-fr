    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-130> ;
    rdfs:comment "A linking element used to identify a relation between a clipped term and its full or expanded form." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:derivedForm ;
    owl:versionInfo "1:0" .

ns3:cliticness a owl:ObjectProperty ;
    rdfs:label "cliticness" ;
    ns2:creator "Francopoulo, Gil" ;
