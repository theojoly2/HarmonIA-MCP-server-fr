    rdfs:label "superlative" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1422> ;
    rdfs:comment "Value used in a comparison between more than two entities." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:superlativeDegreeForm a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:formDegreeVariant .

ns3:superlativeParticle a ns3:PartOfSpeech,
        ns3:ParticlePOS,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "superlative particle" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1923> ;
    rdfs:comment "Particle expressing superlative degree. Superlative is the comparison between more than two entities and contrasts with comparative where only two entities are involved and positive where no comparison is implied." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:supersededTerm a ns3:NormativeAuthorization,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "superseded term" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-379> ;
    rdfs:comment "A term that is no longer preferred or admitted." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:suspensionPoints a ns3:PartOfSpeech,
        ns3:SymbolPOS,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "suspension points" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1447> ;
    rdfs:comment "Sequence of three dots having the same meaning as &quot;et cetera&quot; (full form) or &quot;etc&quot; (abbreviated form)." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:syllable a ns3:TermElement,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "syllable" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-297> ;
    rdfs:comment "A unit of spoken language that is next bigger than a speech sound and consists of one or more vowel sounds alone or of a syllabic consonant alone or of either with one or more consonant sounds preceding or following." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:symbol a ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:isDefinedBy onto: .

ns3:synonym a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#equivalent> .

ns3:tabooRegister a ns3:Register,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:isDefinedBy onto: .

ns3:technicalRegister a ns3:Register,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "technical register" ;
    ns2:creator "Francopoulo, Gil",
        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1997>,
        <http://www.isocat.org/datcat/DC-425> ;
    rdfs:comment "The register appropriate to scientific texts or special languages." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:temporalQualifier a owl:ObjectProperty ;
    rdfs:label "temporal qualifier" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-503> ;
    rdfs:comment "An attribution of a term or lexeme with respect to its use over time." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:TemporalQualifier ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#context> ;
    owl:versionInfo "1:0" .

ns3:tense a owl:ObjectProperty ;
    rdfs:label "tense" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1286> ;
    rdfs:comment "Property referring to the way the grammar marks the time at which the action denoted by the verb took place." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Tense ;
    rdfs:subPropertyOf ns3:morphosyntacticProperty ;
    owl:versionInfo "1:0" .

ns3:termType a owl:ObjectProperty ;
    rdfs:label "lexTermType" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-315> ;
    rdfs:comment "An attribute assigned to a lexeme or a term." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:TermType ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#property> ;
    owl:versionInfo "1:0" .

ns3:terminativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "terminative case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1401> ;
    rdfs:comment "Case that indicates to what or where something ends." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:thirdPerson a ns3:Person,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "third person" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1402> ;
    rdfs:comment "Third person deixis is deictic reference to a referent(s) not identified as the speaker or addressee." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:thirdPersonForm a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:formPersonVariant .

ns3:transcribedForm a ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "transcribed form" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-322> ;
    rdfs:comment "A form of a term or lexeme resulting from an operation whereby the characters of one writing system are represented by characters from another writing system, taking into account the pronunciation of the characters converted." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:translation a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#senseRelation> .

ns3:translationConfidence a owl:DatatypeProperty ;
    rdfs:label "Translation confidence"@en ;
    rdfs:comment "The confidence in a given translation."@en ;
    rdfs:subPropertyOf ns3:confidence .

ns3:translativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "translative case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1406> ;
    rdfs:comment "Case indicating that the referent of the noun, or the quality of the adjective, that it marks is the result of a process of change." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:transliteration a owl:DatatypeProperty ;
    rdfs:label "transliteration" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1848> ;
    rdfs:comment "Form resulting from the conversion of one writing system into another" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#representation> ;
    owl:versionInfo "1:0" .

ns3:trial a ns3:Number,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "trial" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1407> ;
    rdfs:comment "Grammatical number referring to 'three things', as opposed to 'singular' and 'plural'." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:unaccomplished a ns3:Aspect,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "unaccomplished" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-2217> ;
    rdfs:comment "aspect that expresses an event or state that is not finished." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:unclassifiedParticle a ns3:PartOfSpeech,
        ns3:ParticlePOS,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "unclassified particle" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1897> ;
    rdfs:comment "Particle that is not covered by other sorts of particle definitions." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:usageNote a owl:ObjectProperty ;
    rdfs:label "usage note" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-526> ;
    rdfs:comment "A note containing information on the usage of the associated word or term." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#definition> ;
    owl:versionInfo "1:0" .

ns3:verb a ns3:PartOfSpeech,
        ns3:VerbPOS,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "verb" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1424> ;
    rdfs:comment "Element which, singly or in combination with other verbs is used as the minimal predicate of a sentence, co-occurring with a subject. If the predicate contains other elements (e.g. object, complement), then it is the verb which more than any other is the unit which influences the choice and extent of these elements." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:verbFormMood a owl:ObjectProperty ;
    rdfs:label "verb form mood" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1427> ;
    rdfs:comment "One of a set of distinctive forms that are used to signal modality. Modality is a facet of illocutionary point or general intent of a speaker, or a speaker's degree of commitment to the expressed proposition's believability, obligatoriness, desirability or reality." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:VerbFormMood ;
    rdfs:subPropertyOf ns3:morphosyntacticProperty ;
    owl:versionInfo "1:0" .

ns3:vocativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "vocative  case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1412> ;
    rdfs:comment "Case used to indicate direct address." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:voice a owl:ObjectProperty ;
    rdfs:label "voice" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1413> ;
    rdfs:comment "Way sentences may alter the relationship between the subject and object of a verb, without changing the meaning of the sentence." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Voice ;
    rdfs:subPropertyOf ns3:morphosyntacticProperty ;
    owl:versionInfo "1:0" .

ns3:vulgarRegister a ns3:Register,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "vulgar register" ;
    ns2:creator "Francopoulo, Gil",
        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1998>,
        <http://www.isocat.org/datcat/DC-429> ;
    rdfs:comment "Register of a term or text type that can be characterized as profane or socially unacceptable.",
        "The register of a term or text type that can be characterized as profane or socially unacceptable." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:weakPersonalPronoun a ns3:PartOfSpeech,
        ns3:PronounPOS,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "weak personal pronoun" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1414> ;
    rdfs:comment "Personal pronoun that cannot occupy the position after a preposition and/or reinforce a strong personal pronoun." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:wordElement a ns3:TermElement,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "wordElement" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-298> ;
    rdfs:comment "Any lexeme element in a compound lexical unit that is itself a word." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:yes a ns3:Cliticness,
        ns3:Negative,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "yes" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1904> ;
    rdfs:comment "Positive value" ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

<http://lemon-model.net/lemon#Part> a owl:Class .

<http://lemon-model.net/lemon#RaisableArgument> a owl:Class ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Argument> .

<http://lemon-model.net/lemon#broader> a owl:ObjectProperty .

<http://lemon-model.net/lemon#incompatible> a owl:ObjectProperty .

<http://lemon-model.net/lemon#narrower> a owl:ObjectProperty .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

ns3:AccusativePostPositiveArgument a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PostPositiveArgument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:PostPositiveArgument [ a owl:Restriction ;
                        owl:hasValue ns3:accusativeCase ;
                        owl:onProperty <http://lemon-model.net/lemon#marker> ] ) ] .

ns3:AdjectivalComplementFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:predicativeAdjective ] ) ] .

ns3:Adjective a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:AdjectiveFrame ;
            owl:onProperty <http://lemon-model.net/lemon#synBehavior> ],
        <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:AdjectivePOS ] .

ns3:AdjectiveAttributiveFrame a owl:Class ;
    ns3:example "the RED ball"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectiveFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:attributiveArg ] ) ] .

ns3:AdverbialComplementFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:predicativeAdverb ] ) ] .

ns3:AttributiveArgument a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Argument> .

ns3:ComparativeAdjunct a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Adjunct .

ns3:DativePostPositiveArgument a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PostPositiveArgument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:PostPositiveArgument [ a owl:Restriction ;
                        owl:hasValue ns3:dativeCase ;
                        owl:onProperty <http://lemon-model.net/lemon#marker> ] ) ] .

ns3:DativeTransitiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:directObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:indirectObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:Determiner a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:DeterminerPOS ] .

ns3:DirectObject a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Object .

ns3:GenitiveObject a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Object ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue ns3:genitiveCase ;
            owl:onProperty <http://lemon-model.net/lemon#marker> ] .

ns3:GenitivePostPositiveArgument a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PostPositiveArgument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:PostPositiveArgument [ a owl:Restriction ;
                        owl:hasValue ns3:genitiveCase ;
                        owl:onProperty <http://lemon-model.net/lemon#marker> ] ) ] .

ns3:Gerund a owl:Class ;
    rdfs:comment "A clause, whose head is a non-finite verb form, which is used in place of an argument. In English these use the \"-ing\" suffix"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ClausalArgument .

ns3:ImpersonalIntransitiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ImpersonalFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:ImpersonalFrame [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:object ] ) ] .

ns3:ImpersonalTransitiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ImpersonalFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:ImpersonalFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:directObject ] ) ] .

ns3:IndirectObject a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Object .

ns3:Infix a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Affix ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:termElement ;
            owl:someValuesFrom ns3:Infix ] .

ns3:IntransitivePPFrame a owl:Class ;
    ns3:example "he TOOK CARE OF her"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:IntransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:IntransitiveFrame ns3:PPFrame ) ] .

ns3:NominalComplementFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:predicativeNominative ] ) ] .

ns3:NounPredicateFrame a owl:Class ;
    ns3:example "he is a MAN"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:NounFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:NounFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:copulativeArg ] ) ] .

ns3:ObjectComplement a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Complement .

ns3:PredicativeAdjective a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Complement .

ns3:PredicativeAdverb a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Complement .

ns3:PredicativeNominative a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Complement .

ns3:PrepositionalObject a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdpositionalObject ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdpositionalObject [ a owl:Restriction ;
                        owl:onProperty <http://lemon-model.net/lemon#marker> ;
                        owl:someValuesFrom ns3:Preposition ] ) ] .

ns3:RaisableSubject a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Subject ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://lemon-model.net/lemon#RaisableArgument> ns3:Subject ) ] .

ns3:RaisingSubject a owl:Class ;
    rdfs:comment "Indicates the syntactic subject of the main clause is in fact the subject of the subclause. The main clause should then be interpreted as being impersonal."@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Control ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:subject ;
            owl:someValuesFrom ns3:RaisableSubject ] .

ns3:ReciprocalFrame a owl:Class ;
    ns3:example "mary and john MET"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:SuperlativeAdjunct a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Adjunct .

ns3:TransitivePPFrame a owl:Class ;
    ns3:example "she ADDED salt TO the stew"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:TransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:PPFrame ns3:TransitiveFrame ) ] .

ns3:Verb a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:VerbFrame ;
            owl:onProperty <http://lemon-model.net/lemon#synBehavior> ],
        <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:VerbPOS ] .

ns3:accusativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "accusative case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1226> ;
    rdfs:comment "Case used to indicate direct object." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:adpositionalObject a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:AdpositionalObject ;
    rdfs:subPropertyOf ns3:object .

ns3:adverbialComplement a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:complement .

ns3:affix a ns3:TermElement,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:isDefinedBy onto: .

ns3:attributiveArg a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:AttributiveArgument ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#synArg> .

ns3:commonNoun a ns3:NounPOS,
        ns3:PartOfSpeech,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "common noun",
        "commonNoun" ;
    ns2:creator "Francopoulo, Gil",
        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1256>,
        <http://www.isocat.org/datcat/DC-385> ;
    rdfs:comment "A noun or adjective denoting a class of objects.",
        "Noun that signifies a non-specific member of a group." ;
    rdfs:isDefinedBy onto: ;
