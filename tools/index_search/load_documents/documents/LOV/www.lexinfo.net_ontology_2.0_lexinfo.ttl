ns3:comparativeAdjunct a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:ComparativeAdjunct ;
    rdfs:subPropertyOf ns3:predicativeAdjunct .

ns3:confidence a owl:DatatypeProperty ;
    rdfs:label "Confidence"@en ;
    ns2:creator <http://john.mccr.ae> ;
    rdfs:comment "The confidence in a given relationship."@en .

ns3:dativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "dative case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1265> ;
    rdfs:comment "Case that expresses an indirect object relationship or a range of meaning similar to that covered by 'to' or 'for' in English; but there is a great deal of variation between languages in the way this case is used." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:declarativeClause a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:clausalArg .

ns3:infinitiveClause a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:clausalArg .

ns3:interjection a ns3:PartOfSpeech,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "interjection" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1318> ;
    rdfs:comment "Word or sound that expresses an emotion." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:interrogativeClause a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:clausalArg .

ns3:interrogativeInfinitiveClause a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:clausalArg .

ns3:possessiveAdjunct a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:PossessiveAdjunct ;
    rdfs:subPropertyOf ns3:adjunct .

ns3:postposition a ns3:AdpositionPOS,
        ns3:PartOfSpeech,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "postposition" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1360> ;
    rdfs:comment "Adposition that appears at the end of the noun phrase." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:prefix a ns3:TermElement,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:isDefinedBy onto: .

ns3:preposition a ns3:AdpositionPOS,
        ns3:PartOfSpeech,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "preposition" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1366> ;
    rdfs:comment "Adposition placed at the beginning of a noun phrase." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:prepositionalAdjunct a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:PrepositionalAdjunct ;
    rdfs:subPropertyOf ns3:adjunct .

ns3:prepositionalInterrogativeClause a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:clausalArg .

ns3:properNoun a ns3:NounPOS,
        ns3:PartOfSpeech,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "proper noun",
        "properNoun" ;
    ns2:creator "Francopoulo, Gil",
        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1371>,
        <http://www.isocat.org/datcat/DC-384> ;
    rdfs:comment "A noun or adjective denoting a single object.",
        "Noun that is the name of a specific individual, place, or object." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:sententialClause a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:clausalArg .

ns3:suffix a ns3:TermElement,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:isDefinedBy onto: .

ns3:superlativeAdjunct a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:SuperlativeAdjunct ;
    rdfs:subPropertyOf ns3:predicativeAdjunct .

<http://lemon-model.net/lemon#equivalent> a owl:ObjectProperty .

ns3:AdjectivePredicativeFrame a owl:Class ;
    ns3:example "he is HAPPY"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectiveFrame [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:copulativeSubject ] ) ] .

ns3:ObjectControl a owl:Class ;
    rdfs:comment "Indicates the object of the main clause is also the (omitted) object of the subclause"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Control .

ns3:PossessiveAdjunct a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Adjunct .

ns3:PrepositionFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Frame> .

ns3:PrepositionalAdjunct a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://lemon-model.net/lemon#marker> ;
            owl:someValuesFrom ns3:Preposition ],
        ns3:Adjunct .

ns3:ReflexiveObject a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Object .

ns3:SubjectlessIntransitiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:SubjectlessFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:SubjectlessFrame [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:indirectObject ] ) ] .

ns3:SubjectlessTransitiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:SubjectlessFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:SubjectlessFrame [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:directObject ] ) ] .

ns3:formPositivityVariant a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#formVariant> .

ns3:genitiveCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "genitive case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1293> ;
    rdfs:comment "Case which expresses a possessive relationship (e.g. the boy's book) or some other similarly close connection (e.g. a summer's day)." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:genitiveObject a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:GenitiveObject ;
    rdfs:subPropertyOf ns3:object .

ns3:partitiveRelation a owl:ObjectProperty ;
    rdfs:label "partitive relation" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-397> ;
    rdfs:comment "A relation between two concepts where one of the concepts constitutes the whole and the other concept a part of that whole." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#senseRelation> ;
    owl:versionInfo "1:0" .

ns3:predicativeAdjective a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:PredicativeAdjective ;
    rdfs:subPropertyOf ns3:complement .

ns3:predicativeAdjunct a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Adjunct ;
    rdfs:subPropertyOf ns3:adjunct .

ns3:predicativeAdverb a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:PredicativeAdverb ;
    rdfs:subPropertyOf ns3:complement .

ns3:predicativeNominative a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:PredicativeNominative ;
    rdfs:subPropertyOf ns3:complement .

ns3:relatedTerm a owl:ObjectProperty ;
    rdfs:label "relatedTerm" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-438> ;
    rdfs:comment "A term connected to another term by a coordinate or associative relation." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#senseRelation> ;
    owl:versionInfo "1:0" .

<http://lemon-model.net/lemon#context> a owl:ObjectProperty .

<http://lemon-model.net/lemon#optional> a owl:DatatypeProperty .

<http://lemon-model.net/lemon#synBehavior> a owl:ObjectProperty .

ns3:AdpositionalObject a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://lemon-model.net/lemon#marker> ;
            owl:someValuesFrom ns3:Adposition ],
        ns3:Object ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:Object [ a owl:Restriction ;
                        owl:onProperty <http://lemon-model.net/lemon#marker> ;
                        owl:someValuesFrom ns3:Adposition ] ) ] .

ns3:Affix a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Part> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue ns3:affix ;
            owl:onProperty ns3:termElement ] .

ns3:ArbitraryControl a owl:Class ;
    rdfs:comment "Indicates either the subject or object of the main clause may be the omitted argument of the subclause"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Control .

ns3:Dating a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#PropertyValue> .

ns3:DitransitiveFrame a owl:Class ;
    ns3:example "i GAVE him it"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:directObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:indirectObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:Finiteness a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:InterrogativeInfinitiveFrame a owl:Class ;
    rdfs:comment "Indicates the frame has an argument that is a clause with both an interrogative and the clause is in the infinitive form"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:interrogativeInfinitiveClause ] ) ] .

ns3:Negative a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:Noun a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns3:NounFrame ;
            owl:onProperty <http://lemon-model.net/lemon#synBehavior> ],
        <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:NounPOS ] .

ns3:Preposition a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Adposition ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue ns3:preposition ;
            owl:onProperty ns3:partOfSpeech ] .

ns3:ReferentType a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:Subject a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty <http://lemon-model.net/lemon#optional> ],
        <http://lemon-model.net/lemon#Argument> .

ns3:SubjectControl a owl:Class ;
    rdfs:comment "Indicates the subject of the main clause is the (omitted) subject of the subclause"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Control .

ns3:adjunct a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Adjunct ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#synArg> .

ns3:derivedForm a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#lexicalVariant> .

ns3:formDegreeVariant a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#formVariant> .

ns3:formMoodVariant a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#formVariant> .

ns3:formNumberVariant a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#formVariant> .

ns3:formPersonVariant a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#formVariant> .

ns3:holonymTerm a owl:ObjectProperty ;
    rdfs:label "holonym"@en ;
    rdfs:comment "Indicates that the referenced element is a part of this object"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:partitiveRelation ;
    owl:inverseOf ns3:meronymTerm .

ns3:indirectObject a owl:ObjectProperty ;
    rdfs:label "indirect object" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1310> ;
    rdfs:comment "An indirect object is a grammatical relation that is one means of expressing the semantic role of goal and other similar roles. It is proposed for languages in which the role is distinct from the direct object and the oblique object on the basis of multiple independent syntactic or morphological criteria, such as the following: - Having a particular case marking, commonly dative - Governing an agreement affix on the verb, such as person or number - Being distinct from oblique relations in that it may be relativized" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:IndirectObject ;
    rdfs:subPropertyOf ns3:object .

<http://lemon-model.net/lemon#PropertyValue> a owl:Class .

<http://lemon-model.net/lemon#SenseContext> a owl:Class .

<http://lemon-model.net/lemon#representation> a owl:DatatypeProperty .

ns3:Adposition a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:AdpositionPOS ] .

ns3:Animacy a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:ArticlePOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:DeterminerPOS .

ns3:Cliticness a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:ConjunctionPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:Control a owl:Class ;
    rdfs:comment "Control indicates how a an argument from a main clause will be utilized in a subclause. This class includes both control structures and raising structures"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Frame> .

ns3:Degree a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:Frequency a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#SenseContext> .

ns3:FusedPrepositionPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:ImpersonalFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:InterrogativeFrame a owl:Class ;
    rdfs:comment "Indicates the frame has a subframe indicated with the appropriate interrogative (e.g., \"who\", \"where\", \"how\")"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:interrogativeClause ] ) ] .

ns3:ModificationType a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:Mood a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:Person a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:SententialFrame a owl:Class ;
    rdfs:comment "Sentential frames take a clause as argument, no conjunction is used and the syntax of the clause is the same as a main clause"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:sententialClause ] ) ] .

ns3:SubjectlessFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:TemporalQualifier a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#SenseContext> .

ns3:Voice a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:contractionFor a owl:ObjectProperty ;
    rdfs:label "contractionFor" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-157> ;
    rdfs:comment "The full form that corresponds to a contracted form." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:derivedForm ;
    owl:versionInfo "1:0" .

ns3:copulativeArg a owl:ObjectProperty ;
    rdfs:comment "Used with copula constructions. This represents the subject/object in a copula construction. As such constructions are reversible this property is used instead of the usual verb subject/object. E,g.,\\n\\nBarack Obama is the president/The president is Barack Obama"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#synArg> .

ns3:formCaseVariant a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#formVariant> .

ns3:formTenseVariant a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#formVariant> .

ns3:head a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#lexicalVariant> .

ns3:meronymTerm a owl:ObjectProperty ;
    rdfs:label "meronym"@en ;
    rdfs:comment "Indicates this is a part of another concept"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:partitiveRelation .

ns3:postPositiveArg a owl:ObjectProperty ;
    rdfs:comment "Indicates an argument of an adjective indicated by post-positive modification. An example in english would be that \"that is something interesting\", where the adjective interesting post-postively modifies something"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:PostPositiveArgument ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#synArg> .

ns3:termElement a owl:ObjectProperty ;
    rdfs:label "lexTermElement" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-289> ;
    rdfs:comment "Any logically significant portion of a larger term or lexeme." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:TermElement ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#property> ;
    owl:versionInfo "1:0" .

<http://lemon-model.net/lemon#property> a owl:ObjectProperty .

ns3:AdverbPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:Complement a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Argument> .

ns3:Definiteness a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:PPFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:PrepositionalFrame ns3:VerbFrame ) ] .

ns3:PrepositionalFrame a owl:Class ;
    rdfs:comment "Abstract frame for words that take a prepositional phrase as an argument"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Frame> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns3:prepositionalAdjunct ] .

<http://lemon-model.net/lemon#Frame> a owl:Class .

ns3:AbbreviatedForm a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:TermType .

ns3:AdjectivePostPositiveFrame a owl:Class ;
    ns3:example "that is something INTERESTING"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectiveFrame [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:copulativeArg ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:postPositiveArg ] ) ] .

ns3:Adjunct a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty <http://lemon-model.net/lemon#optional> ],
        <http://lemon-model.net/lemon#Argument> .

ns3:AdpositionPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:Aspect a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:ClausalArgument a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Argument> .

ns3:DeclarativeFrame a owl:Class ;
    rdfs:comment "Declarative frames take a clause as an argument, this argument is marker with the declarative conjunction (\"that\" in English)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:declarativeClause ] ) ] .

ns3:Gender a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:GerundFrame a owl:Class ;
    rdfs:comment "Indicates one of the arguments is a gerund clause"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:onProperty <http://lemon-model.net/lemon#synArg> ;
                        owl:someValuesFrom ns3:Gerund ] ) ] .

ns3:NounFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Frame> .

ns3:NounPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:Tense a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:complement a owl:ObjectProperty ;
    rdfs:label "complement" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1257> ;
    rdfs:comment "A noun phrase that follows a copula or similar verb, as for example an idiot in the sentence He is an idiot. - A clause that serves as the subject or direct object of a verb or the direct object of a preposition, as for example that he would be early in the sentence I hoped that he would be early" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Complement ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#synArg> .

ns3:copulativeSubject a owl:ObjectProperty ;
    rdfs:comment "Indicates the subject of a copula construction. It is assumed that by using this the copula construction is not reversible e.g.,\\n\\nHe is happy/*happy is him"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:copulativeArg,
        ns3:subject .

<http://lemon-model.net/lemon#definition> a owl:ObjectProperty .

<http://lemon-model.net/lemon#formVariant> a owl:ObjectProperty .

ns3:Object a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue false ;
            owl:onProperty <http://lemon-model.net/lemon#optional> ],
        <http://lemon-model.net/lemon#Argument> .

ns3:PostPositiveArgument a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Argument> .

ns3:object a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Object ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#synArg> .

<http://lemon-model.net/lemon#Argument> a owl:Class .

<http://lemon-model.net/lemon#Phrase> a owl:Class .

<http://lemon-model.net/lemon#marker> a owl:ObjectProperty .

ns3:NormativeAuthorization a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#SenseContext> .

ns3:VerbFormMood a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:VerbPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

<http://lemon-model.net/lemon#lexicalVariant> a owl:ObjectProperty .

<http://lemon-model.net/lemon#senseRelation> a owl:ObjectProperty .

<http://lemon-model.net/lemon#synArg> a owl:ObjectProperty .

ns3:directObject a owl:ObjectProperty ;
    rdfs:label "direct object" ;
    ns1:datcat <http://www.isocat.org/datacat/DC-2263> ;
    rdfs:comment "relation between a phrase and a verb, in which the relation is central to the verb" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:DirectObject ;
    rdfs:subPropertyOf ns3:object .

ns3:AdjectivePOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:Number a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:ReflexiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:onProperty ns3:object ;
                        owl:someValuesFrom ns3:ReflexiveObject ] ) ] .

ns3:clausalArg a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:ClausalArgument ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#synArg> .

ns3:InfinitiveFrame a owl:Class ;
    rdfs:comment "Infinitive frames take an infinitive clause as an argument"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:infinitiveClause ] ) ] .

ns3:NumeralPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:Register a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#SenseContext> .

ns3:TermElement a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#PropertyValue> .

ns3:subject a owl:ObjectProperty ;
    rdfs:label "subject" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-2261> ;
    rdfs:comment "relation between a phrase and a verb, that represents the person or thing that performs the action or about which something is stated" ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Subject ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#synArg> .

<http://lemon-model.net/lemon#Word> a owl:Class .

ns3:DeterminerPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:IntransitiveFrame a owl:Class ;
    ns3:example "he LEFT"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:directObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:ParticlePOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:SymbolPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:TransitiveFrame a owl:Class ;
    ns3:example "the dog BIT the man"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:directObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:AdjectiveFrame a owl:Class ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Frame> .

ns3:morphosyntacticProperty a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:MorphosyntacticProperty ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#property> .

ns3:partOfSpeech a owl:ObjectProperty ;
    rdfs:label "part of speech" ;
    ns2:creator "Francopoulo, Gil",
        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1345>,
        <http://www.isocat.org/datcat/DC-396> ;
    rdfs:comment "A category assigned to a word based on its grammatical and semantic properties.",
        "Term used to describe how a particular word is used in a sentence." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:PartOfSpeech ;
    rdfs:subPropertyOf ns3:morphosyntacticProperty ;
    owl:versionInfo "1:0" .

ns3:MorphosyntacticProperty a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#PropertyValue> .

ns3:PronounPOS a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PartOfSpeech .

ns3:Case a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

ns3:TermType a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#PropertyValue> .

ns3:VerbFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Frame> .

ns3:PartOfSpeech a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:MorphosyntacticProperty .

owl:Thing a owl:Class .

onto: a <http://purl.org/vocommons/voaf#Vocabulary>,
        owl:NamedIndividual,
        owl:Ontology ;
    rdfs:label "LexInfo"@en ;
    ns4:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:contributor <http://john.mccr.ae/>,
        <http://www.cimiano.de/philipp>,
        <http://www.paulbuitelaar.net/> ;
    dcterms:creator <http://john.mccr.ae/> ;
    dcterms:description "An ontology of types, values and properties to be used with the lemon model, partially derived from ISOcat."@en ;
    dcterms:issued "2010-11-22"^^xsd:date ;
    dcterms:modified "2016-07-13"^^xsd:date ;
    dcterms:publisher <http://john.mccr.ae/> ;
    dcterms:rights <https://creativecommons.org/licenses/by/4.0/>,
        "Copyright 2010 Monnet Project"@en ;
    dcterms:title "LexInfo"@en ;
    vann:preferredNamespacePrefix "lexinfo" ;
    vann:preferredNamespaceUri "http://www.lexinfo.net/ontology/2.0/lexinfo#"^^xsd:anyURI ;
    rdfs:comment "An ontology of types, values and properties to be used with the lemon model, partially derived from ISOcat."@en ;
    owl:imports <http://lemon-model.net/lemon> ;
    owl:versionInfo "2.0"@en .

