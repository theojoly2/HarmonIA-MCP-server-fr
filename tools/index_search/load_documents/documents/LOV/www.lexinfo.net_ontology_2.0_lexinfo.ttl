        "Term used in the grammatical classification of words referring to a subclass of determiners which displays a primary role in differentiating the uses of nouns." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:aspect a owl:ObjectProperty ;
    rdfs:label "aspect" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1242> ;
