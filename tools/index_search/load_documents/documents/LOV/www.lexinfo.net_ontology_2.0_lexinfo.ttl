ns3:stringCategory a ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "stringCategory" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-345> ;
    rdfs:comment "A type value assigned to a string." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:strongPersonalPronoun a ns3:PartOfSpeech,
        ns3:PronounPOS,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "strong personal pronoun" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1390> ;
    rdfs:comment "Personal pronoun that can occupy the position after a preposition and/or reinforce a weak personal pronoun." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:subjunctive a ns3:Mood,
        ns3:VerbFormMood,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "subjunctive" ;
    ns2:creator "Francopoulo, Gil",
        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1843>,
        <http://www.isocat.org/datcat/DC-368> ;
    rdfs:comment "...",
        "Mood often used to express uncertainty, whishes or desires." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:subjunctiveClause a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:clausalArg .

ns3:subjunctiveMoodForm a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:formMoodVariant .

ns3:sublativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "sublative case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1392> ;
    rdfs:comment "Case for a move of something to the surface of another object." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:subordinatingConjunction a ns3:ConjunctionPOS,
        ns3:PartOfSpeech,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "subordinating conjunction" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1393> ;
    rdfs:comment "Conjunction that links constructions by making one of them a constituent of another. The subordinating conjunction typically marks the incorporated constituent." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:substanceHolonym a owl:ObjectProperty ;
    rdfs:label "substance holonym"@en ;
    rdfs:comment "Indicates what this is composed of"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:holonymTerm .

ns3:substanceMeronym a owl:ObjectProperty ;
    rdfs:label "substance meronym"@en ;
    rdfs:comment "Indicates this is a substance that composes the other"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:meronymTerm .

ns3:superessiveCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "superessive case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1396> ;
    rdfs:comment "Case indicating location on top of something or on the surface of something." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:superlative a ns3:Degree,
        owl:NamedIndividual,
