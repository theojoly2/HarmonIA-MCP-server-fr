ns3:animacy a owl:ObjectProperty ;
    rdfs:label "animacy" ;
    ns2:creator "Francopoulo, Gil",
        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1902>,
        <http://www.isocat.org/datcat/DC-78> ;
    rdfs:comment "The characteristic of a word indicating that in a given discourse community, its referent is considered to be alive or to possess a quality of volition or consciousness." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Animacy ;
    rdfs:subPropertyOf ns3:morphosyntacticProperty ;
    owl:versionInfo "1:0" .

ns3:animate a ns3:Animacy,
        owl:NamedIndividual,
        owl:Thing ;
