    owl:versionInfo "1:0" .

ns3:singular a ns3:Number,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "singular" ;
    ns2:creator "Francopoulo, Gil",
        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1387>,
        <http://www.isocat.org/datcat/DC-252> ;
    rdfs:comment "The form of a term or word (usually of a noun) used to designate one object.",
        "Value that expresses one element." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:singularNumberForm a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:formNumberVariant .

ns3:sku a ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "sku" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-337> ;
    rdfs:comment "An inventory item identified by a unique alphanumeric designation assigned to an object in an inventory control system." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:slangRegister a ns3:Register,
