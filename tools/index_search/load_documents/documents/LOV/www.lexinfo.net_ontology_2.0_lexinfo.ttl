    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-468> ;
    rdfs:comment "A linking element used to identify a relation between a short form and its full or expanded form." ;
    rdfs:isDefinedBy onto: ;
