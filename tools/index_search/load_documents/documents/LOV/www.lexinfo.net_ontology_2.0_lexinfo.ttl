ns3:baseElement a ns3:TermElement,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "baseElement" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-290> ;
    rdfs:comment "The root form of a word or term that is used as the formal dictionary entry for the term." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:benchLevelRegister a ns3:Register,
        owl:NamedIndividual,
        owl:Thing ;
