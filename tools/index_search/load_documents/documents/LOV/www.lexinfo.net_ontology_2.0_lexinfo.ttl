    owl:versionInfo "1:0" .

ns3:circumposition a ns3:AdpositionPOS,
        ns3:PartOfSpeech,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "circumposition" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1906> ;
    rdfs:comment "Adposition which consists of two parts which are positioned ahead and after the adpositional foci." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:clippedTerm a ns3:AbbreviatedForm,
        ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "clipped term" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-335> ;
