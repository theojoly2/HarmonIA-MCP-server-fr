        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1911>,
        <http://www.isocat.org/datcat/DC-79> ;
    rdfs:comment "Perceived as alive." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:antonym a owl:ObjectProperty ;
    rdfs:label "antonym term" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-83> ;
    rdfs:comment "A term or lexeme whose concept or sense constitutes the opposite of the concept represented by a second term or lexeme." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#incompatible> ;
    owl:versionInfo "1:0" .

ns3:appellation a ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "appellation" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-347> ;
