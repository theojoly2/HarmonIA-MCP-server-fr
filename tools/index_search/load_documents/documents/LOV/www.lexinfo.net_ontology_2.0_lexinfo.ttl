        <http://www.isocat.org/datcat/DC-427> ;
    rdfs:comment "Register of terms used in applications-oriented as opposed to theoretical or academic levels of language.",
        "The register of terms used in applications-oriented as opposed to theoretical or academic levels of language." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:benefactiveCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "benefactive case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1247> ;
    rdfs:comment "Case that expresses that the referent of the noun it marks receives the benefit of the situation expressed by the clause." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:bound a ns3:Cliticness,
