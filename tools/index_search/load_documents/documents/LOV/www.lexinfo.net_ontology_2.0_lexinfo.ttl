    owl:versionInfo "1:0" .

ns3:approximate a owl:ObjectProperty ;
    rdfs:label "approximate" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-2206> ;
