    ns1:datcat <http://www.isocat.org/datcat/DC-1437> ;
    rdfs:comment "The punctuation sign /" ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:sociativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "sociative case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1388> ;
    rdfs:comment "Case related to the person in whose company the action is carried out, or to any belongings of people which take part in the action." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:standardText a ns3:TermType,
