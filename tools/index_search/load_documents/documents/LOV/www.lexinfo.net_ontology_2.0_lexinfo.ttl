    ns2:creator "Francopoulo, Gil",
        "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1995>,
        <http://www.isocat.org/datcat/DC-428> ;
    rdfs:comment "An extremely informal register of a word, term, or text that is used in spoken and everyday language and less commonly in documents." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:slash a ns3:PartOfSpeech,
        ns3:SymbolPOS,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "slash" ;
