ns3:colon a ns3:PartOfSpeech,
        ns3:SymbolPOS,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "colon" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1439> ;
    rdfs:comment "Sign with two vertical points that is used in writing and printing to introduce an explanation, example or quotation." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:comitativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
