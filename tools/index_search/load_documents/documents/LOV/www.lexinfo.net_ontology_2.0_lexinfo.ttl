    owl:versionInfo "1:0" .

ns3:approximateSynonym a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#senseRelation> .

ns3:archaicForm a ns3:TemporalQualifier,
