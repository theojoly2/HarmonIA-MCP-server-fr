ns3:admittedTerm a ns3:NormativeAuthorization,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "admitted term" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-377> ;
    rdfs:comment "A term rated according to the scale of a term acceptability rating as a synonym for a preferred term." ;
    rdfs:isDefinedBy onto: ;
