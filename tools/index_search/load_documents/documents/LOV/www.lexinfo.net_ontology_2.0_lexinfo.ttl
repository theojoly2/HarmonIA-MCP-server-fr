ns3:case a owl:ObjectProperty ;
    rdfs:label "case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1840> ;
    rdfs:comment "In a given sentence, the way in which the form of a word changes in order to express a relationship with one or several words of the sentence. The morphological modification may apply to nouns, pronouns noun phrase constituents, such as adjectives or numerals." ;
    rdfs:isDefinedBy onto: ;
    rdfs:range ns3:Case ;
    rdfs:subPropertyOf ns3:morphosyntacticProperty ;
    owl:versionInfo "1:0" .

ns3:causallyRelatedConcept a owl:ObjectProperty ;
    rdfs:label "causallyRelatedConcept" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-123> ;
    rdfs:comment "A concept that is related to another concept by virtue of the fact that it plays a causative role with respect to that concept." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf <http://lemon-model.net/lemon#senseRelation> ;
    owl:versionInfo "1:0" .

ns3:causativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "causative case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1253> ;
    rdfs:comment "Case which expresses that the referent of the noun it marks is the cause of the situation expressed by the clause." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:cessative a ns3:Aspect,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "cessative" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-2001> ;
