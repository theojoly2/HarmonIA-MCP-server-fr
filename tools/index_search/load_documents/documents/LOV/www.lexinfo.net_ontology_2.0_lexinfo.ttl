    rdfs:label "bound" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1933> ;
    rdfs:comment "Linked to a particular element." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:bullet a ns3:PartOfSpeech,
