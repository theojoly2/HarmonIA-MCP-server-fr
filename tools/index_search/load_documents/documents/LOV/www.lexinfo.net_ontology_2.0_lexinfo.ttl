@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.isocat.org/ns/dcr.rdf#> .
@prefix ns2: <http://purl.org/dc/elements/1.1/#> .
@prefix ns3: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix ns4: <http://creativecommons.org/ns#> .
@prefix onto: <http://www.lexinfo.net/ontology/2.0/lexinfo> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns4:license a owl:AnnotationProperty .

<http://lemon-model.net/lemon#separator> a owl:DatatypeProperty ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1863> ;
    rdfs:isDefinedBy onto: .

ns2:creator a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

ns1:datcat a owl:AnnotationProperty .

ns3:AdjectiveAccusativePostPositiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectivePostPositiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectivePostPositiveFrame [ a owl:Restriction ;
                        owl:onProperty ns3:postPositiveArg ;
                        owl:someValuesFrom ns3:AccusativePostPositiveArgument ] ) ] .

ns3:AdjectiveComparativeFrame a owl:Class ;
    ns3:example "new york is BIGGER THAN berlin"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectiveFrame [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:comparativeAdjunct ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:copulativeSubject ] ) ] .

ns3:AdjectiveDativePostPositiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectivePostPositiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectivePostPositiveFrame [ a owl:Restriction ;
                        owl:onProperty ns3:postPositiveArg ;
                        owl:someValuesFrom ns3:DativePostPositiveArgument ] ) ] .

ns3:AdjectiveGenitivePostPositiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectivePostPositiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectivePostPositiveFrame [ a owl:Restriction ;
                        owl:onProperty ns3:postPositiveArg ;
                        owl:someValuesFrom ns3:GenitivePostPositiveArgument ] ) ] .

ns3:AdjectiveImpersonalFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectiveFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:object ] [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:copulativeSubject ] ) ] .

ns3:AdjectivePPFrame a owl:Class ;
    ns3:example "he is RELATED TO her"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectivePredicativeFrame ns3:PrepositionalFrame ) ] .

ns3:AdjectivePhrase a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Phrase> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://lemon-model.net/lemon#Phrase> [ a owl:Restriction ;
                        owl:onProperty ns3:head ;
                        owl:someValuesFrom ns3:Adjective ] ) ] .

ns3:AdjectivePredicateFrame a owl:Class ;
    rdfs:comment "Note this frame should be used when both attributive and predicative use of the adjective is allowed"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectiveAttributiveFrame ns3:AdjectivePredicativeFrame ) ] .

ns3:AdjectiveScaleFrame a owl:Class ;
    ns3:example "Everest is 8,848m HIGH"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:adverbialComplement ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:copulativeSubject ] ) ] .

ns3:AdjectiveSuperlativeFrame a owl:Class ;
    ns3:example "tokyo is the BIGGEST of all metropoles"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:AdjectiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectiveFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:superlativeAdjunct ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:copulativeSubject ] ) ] .

ns3:Adverb a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:AdverbPOS ] .

ns3:Article a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Determiner ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:ArticlePOS ] .

ns3:CJK_compound a ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "compound(cjkv)" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-356> ;
    rdfs:comment "A lexical unit in a CJKV language that is represented by at least two CJKV characters." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:CommonNoun a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Noun ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue ns3:commonNoun ;
            owl:onProperty ns3:partOfSpeech ] .

ns3:Conjunction a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:ConjunctionPOS ] .

ns3:DeclarativeClause a owl:Class ;
    rdfs:comment "A clause beginning with the declarative conjunction (\"that\" in English)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ClausalArgument .

ns3:DitransitiveDoubleAccusativeFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:cardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:directObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:DitransitiveFrame_For a owl:Class ;
    ns3:example "she BOUGHT him it\\nshe BOUGHT it FOR him"@en ;
    ns3:languageSpecific "en" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:DitransitiveFrame .

ns3:DitransitiveFrame_To a owl:Class ;
    ns3:example "he GAVE his mother a present\\nhe GAVE a present TO his mother"@en ;
    ns3:languageSpecific "en" ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:DitransitiveFrame .

ns3:FusedPreposition a owl:Class ;
    rdfs:comment "A word that is a fusion of a preposition and some other word... examples include the German words \"zum\" and \"daran\""@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:FusedPrepositionPOS ] .

ns3:GenitiveDitransitiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:directObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:genitiveObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:GenitiveTransitiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:genitiveObject ] [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:subject ] ) ] .

ns3:GerundACFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:GerundFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:ArbitraryControl ns3:GerundFrame ) ] .

ns3:GerundOCFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:GerundFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:GerundFrame ns3:ObjectControl ) ] .

ns3:GerundSCFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:GerundFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:GerundFrame ns3:SubjectControl ) ] .

ns3:ImpersonalIntransitivePPFrame a owl:Class ;
    ns3:example "it REEKS OF tar"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ImpersonalTransitiveFrame,
        ns3:PrepositionalFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:ImpersonalIntransitiveFrame ns3:PrepositionalFrame ) ] .

ns3:InfinitiveClause a owl:Class ;
    rdfs:comment "A clause whose main verb is infinitive"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ClausalArgument .

ns3:Interjection a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue ns3:interjection ;
            owl:onProperty ns3:partOfSpeech ] .

ns3:InterrogativeClause a owl:Class ;
    rdfs:comment "A subclause that begins interrogative construction (\"wh\"-word in English)"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ClausalArgument .

ns3:IntransitiveAdjectivalComplementFrame a owl:Class ;
    ns3:example "his reputation SANK low"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:IntransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:IntransitiveFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:predicativeAdjective ] ) ] .

ns3:IntransitiveAdverbialComplementFrame a owl:Class ;
    ns3:example "he SEEMED well"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:IntransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:IntransitiveFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:predicativeAdverb ] ) ] .

ns3:IntransitiveDeclarativeFrame a owl:Class ;
    ns3:example "i KNOW [that is a bad idea]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:DeclarativeFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:DeclarativeFrame ns3:IntransitiveFrame ) ] .

ns3:IntransitiveInfinitiveACFrame a owl:Class ;
    ns3:example "I HELPED [to save the child]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InfinitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:ArbitraryControl ns3:InfinitiveFrame ns3:IntransitiveFrame ) ] .

ns3:IntransitiveInfinitiveRSFrame a owl:Class ;
    ns3:example "he SEEMED [to be happy]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InfinitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:InfinitiveFrame ns3:IntransitiveFrame ns3:RaisingSubject ) ] .

ns3:IntransitiveInfinitiveSCFrame a owl:Class ;
    ns3:example "I WANTED [to come]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InfinitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:InfinitiveFrame ns3:IntransitiveFrame ns3:SubjectControl ) ] .

ns3:IntransitiveInterrogativeFrame a owl:Class ;
    rdfs:comment "he ASKED [what he should do]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InterrogativeFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:InterrogativeFrame ns3:IntransitiveFrame ) ] .

ns3:IntransitiveInterrogativeInfinitiveFrame a owl:Class ;
    ns3:example "he ASKED [what to do]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InterrogativeInfinitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:InterrogativeInfinitiveFrame ns3:IntransitiveFrame ) ] .

ns3:IntransitiveNominalComplementFrame a owl:Class ;
    ns3:example "he SEEMED a fool"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:IntransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:IntransitiveFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:predicativeNominative ] ) ] .

ns3:IntransitivePPDeclarativeFrame a owl:Class ;
    ns3:example "the SUGGESTED to him [that he should go]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:DeclarativeFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:DeclarativeFrame ns3:IntransitivePPFrame ) ] .

ns3:IntransitiveSententialFrame a owl:Class ;
    ns3:example "they THOUGHT he was always late"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:SententialFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:IntransitiveFrame ns3:SententialFrame ) ] .

ns3:NounPPFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:NounFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:NounPredicateFrame ns3:PrepositionalFrame ) ] .

ns3:NounPhrase a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Phrase> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://lemon-model.net/lemon#Phrase> [ a owl:Restriction ;
                        owl:onProperty ns3:head ;
                        owl:someValuesFrom ns3:Noun ] ) ] .

ns3:NounPossessiveFrame a owl:Class ;
    ns3:example "the CAPITAL OF france is paris"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:NounFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:NounFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:copulativeArg ] [ a owl:Restriction ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass ns3:PossessiveAdjunct ;
                        owl:onProperty ns3:possessiveAdjunct ] ) ] .

ns3:Numeral a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:NumeralPOS ] .

ns3:Particle a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:ParticlePOS ] .

ns3:Postposition a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Adposition ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue ns3:postposition ;
            owl:onProperty ns3:partOfSpeech ] .

ns3:Prefix a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Affix ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue ns3:prefix ;
            owl:onProperty ns3:termElement ] .

ns3:PrepositionPhrase a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Phrase> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://lemon-model.net/lemon#Phrase> [ a owl:Restriction ;
                        owl:onProperty ns3:head ;
                        owl:someValuesFrom ns3:Preposition ] ) ] .

ns3:PrepositionalInterrogativeFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:VerbFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:VerbFrame [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:prepositionalInterrogativeClause ] ) ] .

ns3:PrepositionalPhraseFrame a owl:Class ;
    ns3:example "he is IN london"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PrepositionFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:PrepositionFrame [ a owl:Restriction ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass ns3:PrepositionalAdjunct ;
                        owl:onProperty ns3:complement ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ns3:copulativeSubject ] ) ] .

ns3:Pronoun a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:PronounPOS ] .

ns3:ProperNoun a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Noun ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue ns3:properNoun ;
            owl:onProperty ns3:partOfSpeech ] .

ns3:ReflexiveDativeTransitiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ReflexiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:DativeTransitiveFrame ns3:ReflexiveFrame ) ] .

ns3:ReflexiveDitransitiveFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ReflexiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:DitransitiveFrame ns3:ReflexiveFrame [ a owl:Restriction ;
                        owl:onProperty ns3:directObject ;
                        owl:someValuesFrom ns3:ReflexiveObject ] ) ] .

ns3:ReflexiveReciprocalFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ReflexiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:ReciprocalFrame ns3:ReflexiveFrame ) ] .

ns3:ReflexiveTransitiveFrame a owl:Class ;
    ns3:example "elle se COUCHE"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ReflexiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:ReflexiveFrame ns3:TransitiveFrame ) ] .

ns3:ReflexiveTransitivePPFrame a owl:Class ;
    ns3:example "elle se APPROCHE DE la gare"@fr ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ReflexiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:ReflexiveFrame ns3:TransitivePPFrame ) ] .

ns3:SubjectlessIntransitivePPFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:SubjectlessIntransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:PPFrame ns3:SubjectlessIntransitiveFrame ) ] .

ns3:SubjectlessTransitivePPFrame a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:PPFrame,
        ns3:SubjectlessTransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:PPFrame ns3:SubjectlessTransitiveFrame ) ] .

ns3:SubjunctiveClause a owl:Class ;
    rdfs:comment "A subclause that is in the subjunctive mood"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:ClausalArgument .

ns3:Suffix a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:Affix ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue ns3:suffix ;
            owl:onProperty ns3:termElement ] .

ns3:Symbol a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Word> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns3:partOfSpeech ;
            owl:someValuesFrom ns3:SymbolPOS ] .

ns3:TransitiveAdjectivalComplementFrame a owl:Class ;
    ns3:example "they PAINTED it red"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:TransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdjectivalComplementFrame ns3:TransitiveFrame ) ] .

ns3:TransitiveAdverbialComplementFrame a owl:Class ;
    ns3:example "she PUT the cheese back"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:TransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:AdverbialComplementFrame ns3:TransitiveFrame ) ] .

ns3:TransitiveDeclarativeFrame a owl:Class ;
    ns3:example "he CONVINCED her [that she should go]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:DeclarativeFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:DeclarativeFrame ns3:TransitiveFrame ) ] .

ns3:TransitiveInfinitiveACFrame a owl:Class ;
    ns3:example "they CONVINCED him [to go]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InfinitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:ArbitraryControl ns3:InfinitiveFrame ns3:TransitiveFrame ) ] .

ns3:TransitiveInfinitiveOCFrame a owl:Class ;
    ns3:example "i WANT john [to go]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InfinitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:InfinitiveFrame ns3:ObjectControl ns3:TransitiveFrame ) ] .

ns3:TransitiveInfinitiveSCFrame a owl:Class ;
    ns3:example "john PROMISED mary [to resign]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InfinitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:InfinitiveFrame ns3:SubjectControl ns3:TransitiveFrame ) ] .

ns3:TransitiveInterrogativeFrame a owl:Class ;
    ns3:example "he ASKED her [what he should do]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InterrogativeFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:InterrogativeFrame ns3:TransitiveFrame ) ] .

ns3:TransitiveInterrogativeInfinitiveFrame a owl:Class ;
    ns3:example "he ASKED her [what to do]"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:InterrogativeInfinitiveFrame .

ns3:TransitiveNominalComplementFrame a owl:Class ;
    ns3:example "they ELECTED him president"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:TransitiveFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:NominalComplementFrame ns3:TransitiveFrame ) ] .

ns3:TransitiveSententialFrame a owl:Class ;
    ns3:example "he TOLD the audience he was leaving"@en ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf ns3:SententialFrame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns3:SententialFrame ns3:TransitiveFrame ) ] .

ns3:VerbPhrase a owl:Class ;
    rdfs:isDefinedBy onto: ;
    rdfs:subClassOf <http://lemon-model.net/lemon#Phrase> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://lemon-model.net/lemon#Phrase> [ a owl:Restriction ;
                        owl:onProperty ns3:head ;
                        owl:someValuesFrom ns3:Verb ] ) ] .

ns3:abbreviatedForm a ns3:AbbreviatedForm,
        ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "abbreviated form" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-329> ;
    rdfs:comment "A term or lexeme resulting from the omission of any part of the full term or lexeme while designating the same concept." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:abbreviation a ns3:AbbreviatedForm,
        ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:isDefinedBy onto: .

ns3:abbreviationFor a owl:ObjectProperty ;
    rdfs:label "abbreviationFor" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-65> ;
    rdfs:comment "A linking element used to identify a relation between an abbreviation and its full or expanded form." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:contractionFor ;
    owl:versionInfo "1:0" .

ns3:abessiveCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "abessive case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1223> ;
    rdfs:comment "Case that expresses the lack or absence of the referent of the noun it marks." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:ablativeCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "ablative case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1224> ;
    rdfs:comment "Case used to typically indicate locative or instrumental function." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:absolutiveCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "absolutive case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1225> ;
    rdfs:comment "Case for nouns in ergative-absolute languages that would generally be the subjects of intransitive verbs or the objects of transitive verbs in the translational equivalents of nominative-accusative languages such as English." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:accusativeCaseForm a owl:ObjectProperty ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:formCaseVariant .

ns3:acronym a ns3:AbbreviatedForm,
        ns3:TermType,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "acronym" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-334> ;
    rdfs:comment "An abbreviation made up of the initial letters of the components of the full form of the designation or from syllables of the full form and pronounced syllabically." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:acronymFor a owl:ObjectProperty ;
    rdfs:label "acronymFor" ;
    ns2:creator "Wright, Sue Ellen" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-66> ;
    rdfs:comment "A linking element used to identify a relation between an acronym and its full or expanded form." ;
    rdfs:isDefinedBy onto: ;
    rdfs:subPropertyOf ns3:contractionFor ;
    owl:versionInfo "1:0" .

ns3:activeVoice a ns3:Voice,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "active voice" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1227> ;
    rdfs:comment "Value that expresses the situation where the grammatical subject is also the semantic actor of the verb." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:adessiveCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "adessive case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1228> ;
    rdfs:comment "Case which expresses the meaning of presence 'at' or 'near' a place." ;
    rdfs:isDefinedBy onto: ;
    owl:versionInfo "1:0" .

ns3:aditiveCase a ns3:Case,
        owl:NamedIndividual,
        owl:Thing ;
    rdfs:label "aditive case" ;
    ns2:creator "Francopoulo, Gil" ;
    ns1:datcat <http://www.isocat.org/datcat/DC-1229> ;
