onto:LowFatDiet a onto:RestrictedDiet ;
    rdfs:label "LowFatDiet" ;
    rdfs:comment "A diet focused on reduced fat and cholesterol intake." .

onto:LowLactoseDiet a onto:RestrictedDiet ;
    rdfs:label "LowLactoseDiet" ;
