    rdfs:comment "A diet conforming to Jewish dietary practices." .

onto:LaserDiscFormat a onto:MusicReleaseFormatType ;
    rdfs:label "LaserDiscFormat" ;
    dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#MBZ> ;
