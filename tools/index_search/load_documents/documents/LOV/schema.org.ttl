onto:Male a onto:GenderType ;
    rdfs:label "Male" ;
    rdfs:comment "The male gender." .

onto:MixtapeAlbum a onto:MusicAlbumProductionType ;
    rdfs:label "MixtapeAlbum" ;
    dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#MBZ> ;
