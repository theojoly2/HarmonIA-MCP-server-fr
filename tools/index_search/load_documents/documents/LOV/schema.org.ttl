onto:SpokenWordAlbum a onto:MusicAlbumProductionType ;
    rdfs:label "SpokenWordAlbum" ;
    dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#MBZ> ;
