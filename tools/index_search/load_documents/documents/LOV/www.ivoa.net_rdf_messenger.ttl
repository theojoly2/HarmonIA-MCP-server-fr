@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.ivoa.net/rdf/ivoasem#> .
@prefix onto: <http://www.ivoa.net/rdf/messenger> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.ivoa.net/rdf/messenger#EUV> a rdfs:Class ;
    rdfs:label "Extreme UV" ;
    rdfs:comment "      Photon with an energy between 12 eV and 120 eV" ;
    rdfs:subClassOf <http://www.ivoa.net/rdf/messenger#UV> .

<http://www.ivoa.net/rdf/messenger#Gamma-ray> a rdfs:Class ;
    rdfs:label "Gamma Ray" ;
    rdfs:comment "       Photon with an energy above 120 keV" ;
    rdfs:subClassOf <http://www.ivoa.net/rdf/messenger#Photon> .

<http://www.ivoa.net/rdf/messenger#Infrared> a rdfs:Class ;
    rdfs:label "Infrared" ;
    rdfs:comment "        Photon with a wavelength between 1 µm and 100 µm" ;
    rdfs:subClassOf <http://www.ivoa.net/rdf/messenger#Photon> .

<http://www.ivoa.net/rdf/messenger#Millimeter> a rdfs:Class ;
    rdfs:label "Millimeter" ;
    rdfs:comment "      Photon with a wavelength between 0.1 mm and 10 mm (or 30 GHz<=ν<300 GHz)" ;
    rdfs:subClassOf <http://www.ivoa.net/rdf/messenger#Photon> .

<http://www.ivoa.net/rdf/messenger#Neutrino> a rdfs:Class ;
    rdfs:label "Neutrino" ;
    rdfs:comment "        This term comprises all generations of neutrinos (electron, µ, τ), and particles as well as antiparticles." .

<http://www.ivoa.net/rdf/messenger#Optical> a rdfs:Class ;
    rdfs:label "Optical" ;
    rdfs:comment "         Photon with a wavelength between 300 nm and 1000 nm" ;
    rdfs:subClassOf <http://www.ivoa.net/rdf/messenger#Photon> .

<http://www.ivoa.net/rdf/messenger#Photon> a rdfs:Class ;
    rdfs:label "Photon" ;
    rdfs:comment "          Carrier particles of the electromagnetic interaction" .

<http://www.ivoa.net/rdf/messenger#Radio> a rdfs:Class ;
    rdfs:label "Radio" ;
    rdfs:comment "           Photon with a wavelength longer than 10 mm (or ν<30 GHz)" ;
    rdfs:subClassOf <http://www.ivoa.net/rdf/messenger#Photon> .

<http://www.ivoa.net/rdf/messenger#UV> a rdfs:Class ;
    rdfs:label "Ultraviolet" ;
    rdfs:comment "     Photon with a wavelength between 100 nm and 300 nm" ;
    rdfs:subClassOf <http://www.ivoa.net/rdf/messenger#Photon> .

<http://www.ivoa.net/rdf/messenger#X-ray> a rdfs:Class ;
    rdfs:label "X-Ray" ;
    rdfs:comment "           Photon with an energy between 120 eV and 120 keV" ;
    rdfs:subClassOf <http://www.ivoa.net/rdf/messenger#Photon> .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

onto: a owl:Ontology ;
    rdfs:label "Messengers"@en ;
    dcterms:created "2020-08-26" ;
    dcterms:creator [ foaf:name "Demleitner, M." ],
        [ foaf:name "Plante, R." ] ;
    dcterms:description "A vocabulary of particles used for observations in astronomy.\\nThis list started its existence as the controlled vocabulary for\\nVODataService's vs:Waveband type; the machine-readable identifiers are in\\nupper case for backwards compatibility." ;
    dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "Messengers"@en ;
    ns1:vocflavour "RDF Class" .

