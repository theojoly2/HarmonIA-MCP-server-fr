dcterms:PhysicalResource a owl:Class ;
    rdfs:label "Physical Resource"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#PhysicalResource-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A material thing."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:Policy a owl:Class ;
    rdfs:label "Policy"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Policy-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A plan or course of action by an authority, intended to influence and determine decisions, actions, and other matters."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:ProvenanceStatement a owl:Class ;
    rdfs:label "Provenance Statement"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#ProvenanceStatement-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A statement of any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:SizeOrDuration a owl:Class ;
    rdfs:label "Size or Duration"@en ;
    dcterms:description "Examples include a number of pages, a specification of length, width, and breadth, or a period in hours, minutes, and seconds."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#SizeOrDuration-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A dimension or extent, or a time taken to play or execute."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:subClassOf dcterms:MediaTypeOrExtent .

dcterms:Standard a owl:Class ;
    rdfs:label "Standard"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Standard-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A basis for comparison; a reference point against which other things can be evaluated."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:contributor a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Contributor"@en ;
    dcterms:description "Examples of a Contributor include a person, an organization, or a service."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#contributorT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "An entity responsible for making contributions to the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range dcterms:Agent ;
    rdfs:subPropertyOf dc:contributor .

dcterms:identifier a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "Identifier"@en ;
    dcterms:description "Recommended best practice is to identify the resource by means of a string conforming to a formal identification system."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#identifierT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "An unambiguous reference to the resource within a given context."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier .

dcterms:title a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "Title"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#titleT-002> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2010-10-11"^^xsd:date ;
    rdfs:comment "A name given to the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:title .

ns1:DirectedDiscussionTask a owl:Class ;
    rdfs:subClassOf ns1:DiscussionTask .

ns1:DiscussionWithClinicianStep a owl:Class ;
    rdfs:comment "This ProtocolStep involves two Tasks. The first task (DirectedExpressionTask) is a directed discussion during which the clinician assesses the episodic memory of participant through questions related to events and activities of SemiDirectedActivitiesStep. The second task (PictureDescriptionTask) assesses the verbal fluency and mood of participant using a picture that the participant has to describe (with the picture in the eyes) and then to involve a discussion about their interests for the activity represented. This part is done with two different pictures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:DirectedExpressionTask ns1:PictureDescriptionTask ns1:PictureDiscussionTask ) ] ;
            owl:onProperty ns1:involvesTask ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:DirectedExpressionTask ns1:PictureDescriptionTask ns1:PictureDiscussionTask ) ] ;
            owl:onProperty ns1:involvesTask ],
        ns1:ProtocolStep .

ns1:HealthyControlParticipant a owl:Class ;
    rdfs:comment "A Healthy Control Participant is defined as the participant whose clinical record contains a healthy clinical diagnosis"@en ;
    rdfs:seeAlso ns1:ClinicalRecord,
        ns1:DiagnosisAssessment,
        ns1:DiagnosisType,
        ns1:healthy ;
    rdfs:subClassOf ns1:Participant ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:hasClinicalRecord ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:ClinicalRecord [ a owl:Restriction ;
                                owl:onProperty ns1:containsAssessment ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:DiagnosisAssessment [ a owl:Restriction ;
                                                    owl:onProperty ns1:hasClinicalDiagnosis ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:oneOf ( ns1:healthy ) ] ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasClinicalRecord ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:ClinicalRecord [ a owl:Restriction ;
                                owl:onProperty ns1:containsAssessment ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:DiagnosisAssessment [ a owl:Restriction ;
                                                    owl:onProperty ns1:hasClinicalDiagnosis ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:oneOf ( ns1:healthy ) ] ] ) ] ] ) ] ] .

ns1:PersonWithDementia a owl:Class ;
    rdfs:comment "A Person with Dementia is defined as the participant whose clinical record contains a dementia clinical diagnosis"@en ;
    rdfs:seeAlso ns1:ClinicalRecord,
        ns1:DiagnosisAssessment,
        ns1:DiagnosisType,
        ns1:dementia ;
    rdfs:subClassOf ns1:Participant ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:hasClinicalRecord ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:ClinicalRecord [ a owl:Restriction ;
                                owl:onProperty ns1:containsAssessment ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:DiagnosisAssessment [ a owl:Restriction ;
                                                    owl:onProperty ns1:hasClinicalDiagnosis ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:oneOf ( ns1:dementia ) ] ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasClinicalRecord ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:ClinicalRecord [ a owl:Restriction ;
                                owl:onProperty ns1:containsAssessment ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:DiagnosisAssessment [ a owl:Restriction ;
                                                    owl:onProperty ns1:hasClinicalDiagnosis ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:oneOf ( ns1:dementia ) ] ] ) ] ] ) ] ] .

ns1:PersonWithPredementia a owl:Class ;
    rdfs:comment "A Person with Predementia is defined as the participant whose clinical record contains a predementia clinical diagnosis"@en ;
    rdfs:seeAlso ns1:ClinicalRecord,
        ns1:DiagnosisAssessment,
        ns1:DiagnosisType,
        ns1:predementia ;
    rdfs:subClassOf ns1:Participant ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:hasClinicalRecord ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:ClinicalRecord [ a owl:Restriction ;
                                owl:onProperty ns1:containsAssessment ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:DiagnosisAssessment [ a owl:Restriction ;
                                                    owl:onProperty ns1:hasClinicalDiagnosis ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:oneOf ( ns1:predementia ) ] ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasClinicalRecord ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:ClinicalRecord [ a owl:Restriction ;
                                owl:onProperty ns1:containsAssessment ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( ns1:DiagnosisAssessment [ a owl:Restriction ;
                                                    owl:onProperty ns1:hasClinicalDiagnosis ;
                                                    owl:someValuesFrom [ a owl:Class ;
                                                            owl:oneOf ( ns1:predementia ) ] ] ) ] ] ) ] ] .

dc:identifier a owl:AnnotationProperty .

dcterms:MediaType a owl:Class ;
    rdfs:label "Media Type"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#MediaType-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A file format or physical medium."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:subClassOf dcterms:MediaTypeOrExtent .

dcterms:audience a owl:ObjectProperty ;
    rdfs:label "Audience"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#audience-003> ;
    dcterms:issued "2001-05-21"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A class of entity for whom the resource is intended or useful."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range dcterms:AgentClass .

dcterms:coverage a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Coverage"@en ;
    dcterms:description "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended best practice is to use a controlled vocabulary such as the Thesaurus of Geographic Names [TGN]. Where appropriate, named places or time periods can be used in preference to numeric identifiers such as sets of coordinates or date ranges."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#coverageT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The spatial or temporal topic of the resource, the spatial applicability of the resource, or the jurisdiction under which the resource is relevant."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range dcterms:LocationPeriodOrJurisdiction ;
    rdfs:subPropertyOf dc:coverage .

dcterms:description a owl:AnnotationProperty ;
    rdfs:label "Description"@en ;
    dcterms:description "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#descriptionT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "An account of the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:subPropertyOf dc:description .

dcterms:format a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Format"@en ;
    dcterms:description "Examples of dimensions include size and duration. Recommended best practice is to use a controlled vocabulary such as the list of Internet Media Types [MIME]."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#formatT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The file format, physical medium, or dimensions of the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range dcterms:MediaTypeOrExtent ;
    rdfs:subPropertyOf dc:format .

dcterms:rights a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "Rights"@en ;
    dcterms:description "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#rightsT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "Information about rights held in and over the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range dcterms:RightsStatement ;
    rdfs:subPropertyOf dc:rights .

ns1:AnswerPhoneTask a owl:Class ;
    rdfs:comment "- The phone is scheduled to ring 10 minutes after the entering of the participant inside the room. \\n- During this task, the clinician explains that there is a mistake on the phone bill: the amount was wrong. Consequently, it is expected that the participant corrects his/her phone check and corrects the account balance (tasks normally established before the phone call according to the constraint)."@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:CallPsychologistTask a owl:Class ;
    rdfs:comment "- The participant has to call the psychologist. Two phone numbers are proposed to the participant (1 visit card of the hair dressing,+ 1 visit card of the CHUN with phone number of a psychologist). \\n- According the constraint, the participant has to call the psychologist within the 5 first minutes."@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:DirectedActivitiesStep a owl:Class ;
    rdfs:comment "This ProtocolStep is conducted by a clinician, who details step by step the different activities to do by the participant. This step involves five Tasks. The tasks Walking, CountingBackwards and WalkingAndCountingBackwards are used for characterizing participants’ gait in mono and dual tasks, and the impact of cognitive activity on gait (e.g., walking speed, step length, stops during the walking exercise done in dual task). The tasks SentenceRepeating and ArticulationControl are vocally-directed tasks: one task consists of repeating a sentence after the clinician (this task is repeated with three sentences), and the other is an articulation control exercise done to evaluate the neuromuscular mechanism of speech production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:ArticulationControlTask ns1:CountingBackwardsTask ns1:SentenceRepeatingTask ns1:Task ns1:WalkingCountingBackwardsTask ns1:WalkingTask ) ] ;
            owl:onProperty ns1:involvesTask ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:ArticulationControlTask ns1:CountingBackwardsTask ns1:SentenceRepeatingTask ns1:Task ns1:WalkingCountingBackwardsTask ns1:WalkingTask ) ] ;
            owl:onProperty ns1:involvesTask ],
        ns1:ProtocolStep .

ns1:DirectedExpressionTask a owl:Class ;
    rdfs:comment "The clinician asks the same questions than the ones asked on the read article, e.g. What is the topic of the article?"@en ;
    rdfs:subClassOf ns1:DirectedDiscussionTask .

ns1:DiscussionInvolvementData a owl:Class ;
    rdfs:comment "- Assessment of the impact of cognitive load imposed by the picture description task on speech fluency\\n- Memory and self-appraisal assessment\\n- Verbal fluency and mood (Apathy) assessment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:verbalReactionSpontaneity ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:verbalReactionSpontaneity ],
        ns1:MeasuredData .

ns1:DiscussionTask a owl:Class ;
    rdfs:comment "Root concept for grouping the Tasks relevant to the DiscussionWithClinicianStep\\n\\nThe relevant tasks are used for assessing:\\n- Stress level\\n- Voice: e.g. speech rate, pause rate etc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        ns1:Task .

ns1:EstablishAccountBalanceTask a owl:Class ;
    rdfs:comment "- Three bills (Electricity/Gaz/Phone) are proposed. The account balance is given. \\n- The participant has to establish the amount balance after having taken into account the three bills."@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:FindBusLineOnMapTask a owl:Class ;
    rdfs:comment "- A real bus map is showed to the participant with the indication of the current location of the participant. \\n- The participant has to write on a sheet of paper located next to the bus map the bus lines to take for the itinerary (From Hospital to Station train). Two itineraries are accepted."@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:FreeDiscussionTask a owl:Class ;
    rdfs:subClassOf ns1:DiscussionTask .

ns1:LeaveRoomTask a owl:Class ;
    rdfs:comment "The participant has to leave the room when he/she feels that all activities are performed and achieved"@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:PayBillTask a owl:Class ;
    rdfs:comment "- Three bills (Electricity/Gaz/Phone) are proposed. The participant has to pay the phone bill by check. \\n- The check is well completed if the amount, order (i.e. Phone Company), date and signature are right."@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:PictureDescriptionTask a owl:Class ;
    rdfs:comment "The clinician shows to the participant one picture representing daily activity and asks the participants to give a verbal description of the picture in a few sentences"@en ;
    rdfs:subClassOf ns1:FreeDiscussionTask .

ns1:PictureDiscussionTask a owl:Class ;
    rdfs:comment "The clinician asks if the participant likes doing this activity and why"@en ;
    rdfs:subClassOf ns1:FreeDiscussionTask .

ns1:PrepareDrugBoxTask a owl:Class ;
    rdfs:comment "- 4 types of drugs are proposed to the participant. \\n- The participant has to respect the posology prescribed (2 types of drugs at different moment of the day) and the date (day and moment of the day)."@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:PrepareHotTeaTask a owl:Class ;
    rdfs:comment "- The participant has to switch on the electric kettle. \\n- The participant has to pour the hot water on the glass containing the tea bag."@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:SemiDirectedActivitiesStep a owl:Class ;
    rdfs:comment "This ProtocolStep consists of assessing the autonomy of the participant. The participant has to organize himself/herself and correctly perform a list of Instrumental Activities of Daily Living (e.g., managing finance, using phone, preparing tea) within a timeframe of 15minutes. For this step, the participant is alone in the experimental setting and can refer to the instruction sheet of paper with the IADLs to perform at any time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:AnswerPhoneTask ns1:CallPsychologistTask ns1:EstablishAccountBalanceTask ns1:FindBusLineOnMapTask ns1:LeaveRoomTask ns1:PayBillTask ns1:PrepareDrugBoxTask ns1:PrepareHotTeaTask ns1:Task ns1:TurnOnTVTask ns1:WaterPlantTask ) ] ;
            owl:onProperty ns1:involvesTask ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:AnswerPhoneTask ns1:CallPsychologistTask ns1:EstablishAccountBalanceTask ns1:FindBusLineOnMapTask ns1:LeaveRoomTask ns1:PayBillTask ns1:PrepareDrugBoxTask ns1:PrepareHotTeaTask ns1:Task ns1:TurnOnTVTask ns1:WaterPlantTask ) ] ;
            owl:onProperty ns1:involvesTask ],
        ns1:ProtocolStep .

ns1:TurnOnTVTask a owl:Class ;
    rdfs:comment "The TV is turn off. The participant has to take the remote control and turns on the TV"@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:WalkingTask a owl:Class ;
    rdfs:comment "(MonoTask) The clinician asks the participant to walk 4 meters across the room, to turn and then to come back (total walking distance: 8m).\\n\\nThis task is used for assessing:\\n- Gait: walking speed, step length, etc.\\n- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task\\n- Stress level"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:measuredData ;
            owl:someValuesFrom ns1:LatencyData ],
        [ a owl:Restriction ;
            owl:onProperty ns1:measuredData ;
            owl:someValuesFrom ns1:GaitData ],
        [ a owl:Restriction ;
            owl:onProperty ns1:measuredData ;
            owl:someValuesFrom ns1:LatencyData ],
        [ a owl:Restriction ;
            owl:onProperty ns1:measuredData ;
            owl:someValuesFrom ns1:GaitData ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:GaitData ns1:LatencyData ns1:StressData ) ] ;
            owl:onProperty ns1:measuredData ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:GaitData ns1:LatencyData ns1:StressData ) ] ;
            owl:onProperty ns1:measuredData ],
        ns1:DirectedTask .

ns1:WaterPlantTask a owl:Class ;
    rdfs:comment "The participant has to take the water can, and water the plant nearby."@en ;
    rdfs:subClassOf ns1:SemiDirectedTask .

ns1:activityStatus a owl:ObjectProperty ;
    rdfs:comment "The status of a semi-directed activity" ;
    rdfs:domain ns1:CognitiveAbilitiesData ;
    rdfs:range ns1:ActivityStatusType ;
    rdfs:seeAlso ns1:ActivityStatusType,
        ns1:CognitiveAbilitiesData .

ns1:areasOfInterestExplored a owl:ObjectProperty ;
    rdfs:comment "Zones of no interest"@en ;
    rdfs:domain ns1:OrganisationEfficiencyData ;
    rdfs:range ns1:Zone ;
    rdfs:seeAlso ns1:OrganisationEfficiencyData .

ns1:areasOfNoInterestExplored a owl:ObjectProperty ;
    rdfs:comment "Zones of interest"@en ;
    rdfs:domain ns1:OrganisationEfficiencyData ;
    rdfs:range ns1:Zone ;
    rdfs:seeAlso ns1:OrganisationEfficiencyData .

ns1:articulation a owl:DatatypeProperty ;
    rdfs:comment "Measures the articulation control of the participant"@en ;
    rdfs:domain ns1:VoiceData .

ns1:completed a ns1:ActivityStatusType,
        owl:NamedIndividual .

ns1:compliantInstructionsOrder a owl:DatatypeProperty ;
    rdfs:comment "Whether the participant followed the activity order suggested by the instructions sheet"@en ;
    rdfs:domain ns1:CognitiveAbilitiesData ;
    rdfs:seeAlso ns1:CognitiveAbilitiesData .

ns1:distanceWalked a owl:DatatypeProperty ;
    rdfs:comment "Total distance walked"@en ;
    rdfs:domain ns1:OrganisationEfficiencyData ;
    rdfs:seeAlso ns1:OrganisationEfficiencyData .

ns1:dynamicBalance a owl:DatatypeProperty ;
    rdfs:comment "Dynamical balance during the walking (e.g., people trajectory study)"@en ;
    rdfs:domain ns1:GaitData ;
    rdfs:seeAlso ns1:GaitData .

ns1:handTrajectory a owl:ObjectProperty ;
    rdfs:comment "Associates an instance of FunctionalAbilitiesData with a hand trajectory type"@en ;
    rdfs:domain ns1:FunctionalAbilitiesData ;
    rdfs:range ns1:HandTrajectoryType ;
    rdfs:seeAlso ns1:FunctionalAbilitiesData,
        ns1:HandTrajectoryType .

ns1:hasProtocolStep a owl:ObjectProperty ;
    rdfs:comment "Each Protocol consists of one or more ProtocolSteps"@en ;
    rdfs:domain ns1:Protocol ;
    rdfs:range ns1:ProtocolStep ;
    rdfs:seeAlso ns1:Protocol,
        ns1:ProtocolStep .

ns1:incomplete a ns1:ActivityStatusType,
        owl:NamedIndividual .

ns1:isClinicalRecordOf a owl:ObjectProperty ;
    owl:inverseOf ns1:hasClinicalRecord .

ns1:latency a owl:DatatypeProperty ;
    rdfs:comment "Time of latency between the end of instructions (stimulation) and the beginning of the task"@en ;
    rdfs:domain ns1:LatencyData ;
    rdfs:seeAlso ns1:LatencyData .

ns1:omitted a ns1:ActivityStatusType,
        owl:NamedIndividual .

ns1:participates a owl:ObjectProperty ;
    rdfs:seeAlso ns1:hasParticipant ;
    owl:inverseOf ns1:hasParticipant .

ns1:pauseRate a owl:DatatypeProperty ;
    rdfs:comment "Pause rate during sentence repetition and mono/dual tasks"@en ;
    rdfs:domain ns1:VoiceData ;
    rdfs:seeAlso ns1:ArticulationControlTask,
        ns1:CountingBackwardsTask,
        ns1:SentenceRepeatingTask,
        ns1:VoiceData,
        ns1:WalkingCountingBackwardsTask .

ns1:repetitions a owl:DatatypeProperty ;
    rdfs:comment "Number of repetitions during semi-directed activities"@en ;
    rdfs:domain ns1:CognitiveAbilitiesData ;
    rdfs:seeAlso ns1:SemiDirectedTask .

ns1:speechFluency a owl:DatatypeProperty ;
    rdfs:comment "Speech fluency during sentence repetition and picture description tasks"@en ;
    rdfs:domain ns1:VoiceData ;
    rdfs:seeAlso ns1:VoiceData .

ns1:speechRate a owl:DatatypeProperty ;
    rdfs:comment "Speech fluency during sentence repetition and picture description tasks"@en ;
    rdfs:domain ns1:VoiceData ;
    rdfs:seeAlso ns1:VoiceData .

ns1:stepLength a owl:DatatypeProperty ;
    rdfs:comment "Step length"@en ;
    rdfs:domain ns1:GaitData ;
    rdfs:seeAlso ns1:GaitData .

ns1:stoppingDisplacement a owl:DatatypeProperty ;
    rdfs:comment "Stopping displacement during walking"@en ;
    rdfs:domain ns1:GaitData ;
    rdfs:seeAlso ns1:GaitData .

ns1:stressLevel a owl:DatatypeProperty ;
    rdfs:domain ns1:StressData ;
    rdfs:seeAlso ns1:StressData,
        "Stress level"@en .

ns1:verbalReactionSpontaneity a owl:DatatypeProperty ;
    rdfs:comment "Time between the end of assessor’s speech and the beginning of participant’s speech (Discussion Task)"@en ;
    rdfs:domain ns1:DiscussionInvolvementData ;
    rdfs:seeAlso ns1:DiscussionInvolvementData .

ns1:verbalReactionTime a owl:DatatypeProperty ;
    rdfs:comment "Time interval between the end of assessor’s speech and the beginning of participant’s speech (Sentence Repetition Task)"@en ;
    rdfs:domain ns1:VoiceData ;
    rdfs:seeAlso ns1:VoiceData .

ns1:vowelDuration a owl:DatatypeProperty ;
    rdfs:comment ns1:VoiceData ;
    rdfs:domain ns1:VoiceData ;
    rdfs:seeAlso "Vowel duration"@en ;
    rdfs:subPropertyOf owl:topDataProperty .

ns1:walkingSpeed a owl:DatatypeProperty ;
    rdfs:comment "Walking speed"@en ;
    rdfs:domain ns1:GaitData ;
    rdfs:seeAlso ns1:GaitData .

ns1:walkingSpeedInstantaneous a owl:DatatypeProperty ;
    rdfs:comment "Walking speed instantaneous (mono task walking activity/dual task)"@en ;
    rdfs:domain ns1:GaitData ;
    rdfs:seeAlso ns1:GaitData .

dc:coverage a owl:AnnotationProperty .

dc:format a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dcterms:MediaTypeOrExtent a owl:Class ;
    rdfs:label "Media Type or Extent"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#MediaTypeOrExtent-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A media type or extent."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:RightsStatement a owl:Class ;
    rdfs:label "Rights Statement"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#RightsStatement-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A statement about the intellectual property rights (IPR) held in or over a Resource, a legal document giving official permission to do something with a resource, or a statement about access rights."@en ;
    rdfs:isDefinedBy dcterms: .

ns1:ArticulationControlTask a owl:Class ;
    rdfs:comment "The participant is asked to pronounce repeatedly a predefined diadochokinetic “Pataka” token as rapid as possible stopping this action upon a sign by the clinician. The clinician will stop the action in 10 sec.\\n\\nThis task is used for assessing:\\n- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task\\n- Stress level\\n- Voice: e.g. speech rate, pause rate etc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:LatencyData ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:LatencyData ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        ns1:DirectedTask .

ns1:CountingBackwardsTask a owl:Class ;
    rdfs:comment "(MonoTask) The participant is standing and the clinician asks him/her to count aloud backwards: \\n- From 305 to 285 (to change tens and hundreds) one by one; or \\n- From 20 to 0 if they make counting mistakes after 2 attempts of the previous backwards counting\\n\\nThis task is used for assessing:\\n- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task\\n- Stress level\\n- Voice: e.g. speech fluency and articulation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:LatencyData ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:LatencyData ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        ns1:DirectedTask .

ns1:SentenceRepeatingTask a owl:Class ;
    rdfs:comment "- The participant is asked to repeat a short sentence after the assessor. \\n- The assessor reads aloud a sentence. The participant repeats the sentence. The action is done once by sentence. Three sentences must be repeated.\\n\\nThis task is used for assessing:\\n- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task\\n- Stress level\\n- Voice: e.g. verbal reaction time"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:LatencyData ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:LatencyData ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        ns1:DirectedTask .

ns1:WalkingCountingBackwardsTask a owl:Class ;
    rdfs:comment "(DualTask) The clinician asks the participant to walk and count aloud backwards simultaneously: \\n- From 305 until the end of the walking tasks; or \\n- From 20 to 0 for participants who don’t manage to count backwards from 305 to 285 during the CountingBackwardsTask\\n\\nThis task is used for assessing:\\n- Gait: walking speed, step length, etc.\\n- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task\\n- Stress level\\n- Voice: e.g. speech fluency and articulation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:GaitData ns1:LatencyData ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:GaitData ns1:LatencyData ns1:StressData ns1:VoiceData ) ] ;
            owl:onProperty ns1:measuredData ],
        ns1:DirectedTask .

ns1:apathyInventory a owl:DatatypeProperty ;
    rdfs:comment "Apathy Inventory (AI) and diagnostic criteria for apathy"@en ;
    rdfs:domain ns1:NeuropsychiatricAndMoodAssessment ;
    rdfs:seeAlso ns1:NeuropsychiatricAndMoodAssessment .

ns1:dsm_ivDepressionCriteria a owl:DatatypeProperty ;
    rdfs:comment "DSM-IV Criteria for depression"@en ;
    rdfs:domain ns1:NeuropsychiatricAndMoodAssessment ;
    rdfs:seeAlso "http://en.wikipedia.org/wiki/Diagnostic_and_Statistical_Manual_of_Mental_Disorders"@en .

ns1:fabScore a owl:DatatypeProperty ;
    rdfs:comment "Frontal Assessment Battery score"@en ;
    rdfs:domain ns1:CognitiveAbilitiesAssessment ;
    rdfs:seeAlso ns1:CognitiveAbilitiesAssessment .

ns1:freeAndCuedRemindingAssessment a owl:DatatypeProperty ;
    rdfs:comment "The Free and Cued Selective Reminding Test"@en ;
    rdfs:domain ns1:CognitiveAbilitiesAssessment ;
    rdfs:seeAlso ns1:CognitiveAbilitiesAssessment .

ns1:hasMMSEScore a owl:DatatypeProperty ;
    rdfs:comment "Mini-Mental State Exam score"@en ;
    rdfs:domain ns1:CognitiveAbilitiesAssessment ;
    rdfs:seeAlso ns1:CognitiveAbilitiesAssessment .

ns1:hasUPDRSScore a owl:DatatypeProperty ;
    rdfs:comment "Part III of the Unified Parkinson’s Disease Rating Scale"@en ;
    rdfs:domain ns1:MotricityAbilitiesAssessment ;
    rdfs:seeAlso ns1:MotricityAbilitiesAssessment .

ns1:iadl_e a owl:DatatypeProperty ;
    rdfs:comment "Allows the quantification of autonomy"@en ;
    rdfs:domain ns1:AutonomyAssessment ;
    rdfs:seeAlso ns1:AutonomyAssessment .

ns1:npi a owl:DatatypeProperty ;
    rdfs:comment "Neuropsychiatric Inventory"@en ;
    rdfs:domain ns1:NeuropsychiatricAndMoodAssessment ;
    rdfs:seeAlso ns1:NeuropsychiatricAndMoodAssessment .

ns1:shortCognitiveBatteryAssessment a owl:DatatypeProperty ;
    rdfs:comment "Short Cognitive Battery"@en ;
    rdfs:domain ns1:CognitiveAbilitiesAssessment ;
    rdfs:seeAlso ns1:CognitiveAbilitiesAssessment .

ns1:trailMakingTest a owl:DatatypeProperty ;
    rdfs:comment "Trail making test A and B"@en ;
    rdfs:domain ns1:CognitiveAbilitiesAssessment ;
    rdfs:seeAlso ns1:CognitiveAbilitiesAssessment .

dcterms:Agent a dcterms:AgentClass,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Agent"@en ;
    dcterms:description "Examples of Agent include person, organization, and software agent."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Agent-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A resource that acts or has the power to act."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:AgentClass a owl:Class ;
    rdfs:label "Agent Class"@en ;
    dcterms:description "Examples of Agent Class include groups seen as classes, such as students, women, charities, lecturers."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#AgentClass-003> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2012-06-14"^^xsd:date ;
    rdfs:comment "A group of agents."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:subClassOf rdfs:Class .

dcterms:LocationPeriodOrJurisdiction a owl:Class ;
    rdfs:label "Location, Period, or Jurisdiction"@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#LocationPeriodOrJurisdiction-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A location, period of time, or jurisdiction."@en ;
    rdfs:isDefinedBy dcterms: .

ns1:FunctionalAbilitiesData a owl:Class ;
    rdfs:comment "Explore functional abilities for the completion of specific activities"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:HandTrajectoryType ;
            owl:onProperty ns1:handTrajectory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns1:HandTrajectoryType ;
            owl:onProperty ns1:handTrajectory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:MeasuredData .

ns1:HandTrajectoryType a owl:Class .

ns1:hasParticipant a owl:ObjectProperty ;
    rdfs:comment "The participant of the protocol"@en ;
    rdfs:domain ns1:Protocol ;
    rdfs:range ns1:Participant ;
    rdfs:seeAlso ns1:Person,
        ns1:Protocol .

ns1:AutonomyAssessment a owl:Class ;
    rdfs:comment "Autonomy is assessed based on the performance of the participant during the SemiDirectedActivitiesStep. The property iadl_e (Instrumental Activities of Daily Living for Elderly) can be used to quantify autonomy"@en ;
    rdfs:seeAlso ns1:SemiDirectedActivitiesStep,
        ns1:iadl_e ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:iadl_e ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:iadl_e ],
        ns1:ClinicalAssessment .

ns1:DirectedTask a owl:Class ;
    rdfs:comment "Root concept for grouping the Tasks relevant to the DirectedActivitiesStep"@en ;
    rdfs:seeAlso ns1:DirectedActivitiesStep,
        ns1:Task ;
    rdfs:subClassOf ns1:Task .

ns1:MotricityAbilitiesAssessment a owl:Class ;
    rdfs:comment "Motricity abilities assessment:\\n- Part III of the Unified Parkinson’s Disease Rating Scale (UPDRS) ."@en ;
    rdfs:seeAlso ns1:hasUPDRSScore ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty ns1:hasUPDRSScore ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty ns1:hasUPDRSScore ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:ClinicalAssessment .

ns1:healthy a ns1:DiagnosisType,
        owl:NamedIndividual ;
    ns1:hasClinicalDiagnosis ns1:dementia .

ns1:predementia a ns1:DiagnosisType,
        owl:NamedIndividual .

ns1:OrganisationEfficiencyData a owl:Class ;
    rdfs:comment "Explore ability to organize with efficiency the different activities"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:areasOfInterestExplored ;
            owl:someValuesFrom ns1:Zone ],
        [ a owl:Restriction ;
            owl:onProperty ns1:areasOfInterestExplored ;
            owl:someValuesFrom ns1:Zone ],
        [ a owl:Restriction ;
            owl:onProperty ns1:areasOfNoInterestExplored ;
            owl:someValuesFrom ns1:Zone ],
        [ a owl:Restriction ;
            owl:onProperty ns1:areasOfNoInterestExplored ;
            owl:someValuesFrom ns1:Zone ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:distanceWalked ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:distanceWalked ],
        ns1:MeasuredData .

ns1:Protocol a owl:Class ;
    rdfs:comment "A Protocol instance contains information regarding the participant and the duration of the protocol session. It can be also associated with one or more ProtocolSteps that define the Tasks and the corresponding MeasuredData."@en ;
    rdfs:seeAlso ns1:MeasuredData,
        ns1:ProtocolStep,
        ns1:Task ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasBeginning ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass foaf:Person ;
            owl:onProperty ns1:hasParticipant ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasProtocolStep ;
            owl:someValuesFrom ns1:ProtocolStep ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns1:hasProtocolStep ;
            owl:someValuesFrom ns1:ProtocolStep ],
        [ a owl:Restriction ;
            owl:onClass foaf:Person ;
            owl:onProperty ns1:hasParticipant ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasBeginning ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ns1:Zone a owl:Class ;
    rdfs:comment "Allows the definition of zones (areas) of interest, e.g. phone zone"@en .

ns1:dementia a ns1:DiagnosisType,
        owl:NamedIndividual .

ns1:ActivityStatusType a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:completed ns1:incomplete ns1:omitted ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:completed ns1:incomplete ns1:omitted ) ] .

ns1:CognitiveAbilitiesData a owl:Class ;
    rdfs:comment "Explore functional abilities for the completion of specific activities"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty ns1:compliantInstructionsOrder ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns1:ActivityStatusType ;
            owl:onProperty ns1:activityStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty ns1:compliantInstructionsOrder ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:repetitions ],
        [ a owl:Restriction ;
            owl:onClass ns1:ActivityStatusType ;
            owl:onProperty ns1:activityStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:repetitions ],
        ns1:MeasuredData .

ns1:Participant a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:participates ;
            owl:someValuesFrom ns1:Protocol ],
        [ a owl:Restriction ;
            owl:onProperty ns1:participates ;
            owl:someValuesFrom ns1:Protocol ],
        [ a owl:Restriction ;
            owl:onClass ns1:ClinicalRecord ;
            owl:onProperty ns1:hasClinicalRecord ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns1:ClinicalRecord ;
            owl:onProperty ns1:hasClinicalRecord ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        foaf:Person .

dcterms:date a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "Date"@en ;
    dcterms:description "Date may be used to express temporal information at any level of granularity.  Recommended best practice is to use an encoding scheme, such as the W3CDTF profile of ISO 8601 [W3CDTF]."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#dateT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date .

ns1:ClinicalAssessment a owl:Class ;
    rdfs:comment "Root concept for the five types of clinical assessment"@en ;
    rdfs:seeAlso ns1:AutonomyAssessment,
        ns1:CognitiveAbilitiesAssessment,
        ns1:DiagnosisAssessment,
        ns1:MotricityAbilitiesAssessment,
        ns1:NeuropsychiatricAndMoodAssessment .

ns1:NeuropsychiatricAndMoodAssessment a owl:Class ;
    rdfs:comment "Neuropsychiatric/Mood assessments:\\n- NPI \\n- DSM-IV Criteria for depression \\n- Apathy Inventory (AI) and diagnostic criteria for apathy."@en ;
    rdfs:seeAlso ns1:apathyInventory,
        ns1:dsm_ivDepressionCriteria,
        ns1:npi ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:npi ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:dsm_ivDepressionCriteria ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:npi ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:apathyInventory ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:dsm_ivDepressionCriteria ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:apathyInventory ],
        ns1:ClinicalAssessment .

ns1:involvesTask a owl:ObjectProperty ;
    rdfs:comment "Each ProtocolStep involves one or more Tasks"@en ;
    rdfs:domain ns1:ProtocolStep ;
    rdfs:range ns1:Task ;
    rdfs:seeAlso ns1:ProtocolStep,
        ns1:Task .

dcam:VocabularyEncodingScheme a owl:Class .

ns1:containsAssessment a owl:ObjectProperty ;
    rdfs:comment "A ClinicalRecord contains a ClinicalAssessment" ;
    rdfs:domain ns1:ClinicalRecord ;
    rdfs:range ns1:ClinicalAssessment ;
    rdfs:seeAlso ns1:ClinicalAssessment,
        ns1:ClinicalRecord .

ns1:hasClinicalDiagnosis a owl:ObjectProperty ;
    rdfs:comment "The value of the DiagnosisAssessment"@en ;
    rdfs:domain ns1:DiagnosisAssessment ;
    rdfs:range ns1:DiagnosisType ;
    rdfs:seeAlso ns1:DiagnosisAssessment,
        ns1:DiagnosisType ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns1:hasClinicalRecord a owl:ObjectProperty ;
    rdfs:comment "Each participant is associated with a clinical record"@en ;
    rdfs:domain ns1:Participant ;
    rdfs:range ns1:ClinicalRecord ;
    rdfs:seeAlso ns1:ClinicalRecord .

ns1:ProtocolStep a owl:Class ;
    rdfs:comment "A ProtocolStep defines the Tasks of interest. Three ProtocolStep types are currently defined in Dem@Care: DirectedActivities, SemiDirectedActivities and DiscussionWithTheClinician"@en ;
    rdfs:seeAlso ns1:DirectedActivitiesStep,
        ns1:DiscussionWithClinicianStep,
        ns1:SemiDirectedActivitiesStep,
        ns1:Task ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns1:involvesTask ;
            owl:someValuesFrom ns1:Task ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasBeginning ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns1:involvesTask ;
            owl:someValuesFrom ns1:Task ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasBeginning ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ns1:DiagnosisType a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:healthy ns1:dementia ns1:predementia ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:healthy ns1:dementia ns1:predementia ) ] .

ns1:SemiDirectedTask a owl:Class ;
    rdfs:comment "In this Task the participant has to organize himself/herself and correctly perform a list of Instrumental Activities of Daily Living (e.g., managing finance, using phone, preparing tea) within a timeframe of 15minutes.\\n\\nThe relevant tasks are used for assessing:\\n- Cognitive abilities through activity repetitions, missed activities, order of activities\\n- Functional abilities for the completion of specific activities: e.g. hand trajectories\\n- Stress level"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:CognitiveAbilitiesData ns1:FunctionalAbilitiesData ns1:StressData ) ] ;
            owl:onProperty ns1:measuredData ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:CognitiveAbilitiesData ns1:FunctionalAbilitiesData ns1:StressData ) ] ;
            owl:onProperty ns1:measuredData ],
        ns1:Task .

ns1:CognitiveAbilitiesAssessment a owl:Class ;
    rdfs:comment "The Cognitive abilities assessment is performed in terms of five scores:\\n- Mini-Mental State Exam (MMSE). \\n- Frontal Assessment Battery (FAB). \\n- Trail making test A and B. \\n- Short Cognitive Battery. \\n- The Free and Cued Selective Reminding Test"@en ;
    rdfs:seeAlso ns1:fabScore,
        ns1:freeAndCuedRemindingAssessment,
        ns1:hasMMSEScore,
        ns1:shortCognitiveBatteryAssessment,
        ns1:trailMakingTest ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasMMSEScore ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:shortCognitiveBatteryAssessment ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:trailMakingTest ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:freeAndCuedRemindingAssessment ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:hasMMSEScore ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:freeAndCuedRemindingAssessment ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:fabScore ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:shortCognitiveBatteryAssessment ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:fabScore ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:trailMakingTest ],
        ns1:ClinicalAssessment .

ns1:MeasuredData a owl:Class ;
    rdfs:comment "MeasuredData is the root concept that groups the measurement types that are collected during the Tasks." .

dc:relation a owl:AnnotationProperty .

dcterms:relation a owl:AnnotationProperty ;
    rdfs:label "Relation"@en ;
    dcterms:description "Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system."@en ;
    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#relationT-001> ;
    dcterms:issued "2008-01-14"^^xsd:date ;
    dcterms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "A related resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:subPropertyOf dc:relation ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

ns1:DiagnosisAssessment a owl:Class ;
    rdfs:comment "Diagnosis established the day of the recording session. Participant is assigned to one of this 3 categories: Healthy Control participants, Alzheimer’s disease at pre-dementia stage, Alzheimer ’s disease at dementia stage"@en ;
    rdfs:seeAlso ns1:DiagnosisType,
        ns1:HealthyControlParticipant,
        ns1:PersonWithDementia,
        ns1:PersonWithPredementia,
        ns1:hasClinicalDiagnosis ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns1:DiagnosisType ;
            owl:onProperty ns1:hasClinicalDiagnosis ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns1:DiagnosisType ;
            owl:onProperty ns1:hasClinicalDiagnosis ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:ClinicalAssessment .

ns1:LatencyData a owl:Class ;
    rdfs:comment "Explore the time of latency [stimulation, response] during the DirectedActivitiesTask (Explore sensitivity of this measure for assessing the apathy)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:latency ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:latency ],
        ns1:MeasuredData .

ns1:ClinicalRecord a owl:Class ;
    rdfs:comment "A ClinicalRecord contains information about the five types of clinical assessment"@en ;
    rdfs:seeAlso ns1:ClinicalAssessment,
        ns1:containsAssessment ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:AutonomyAssessment ns1:CognitiveAbilitiesAssessment ns1:DiagnosisAssessment ns1:MotricityAbilitiesAssessment ns1:NeuropsychiatricAndMoodAssessment ) ] ;
            owl:onProperty ns1:containsAssessment ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:AutonomyAssessment ns1:CognitiveAbilitiesAssessment ns1:DiagnosisAssessment ns1:MotricityAbilitiesAssessment ns1:NeuropsychiatricAndMoodAssessment ) ] ;
            owl:onProperty ns1:containsAssessment ],
        [ a owl:Restriction ;
            owl:onClass ns1:Participant ;
            owl:onProperty ns1:isClinicalRecordOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns1:Participant ;
            owl:onProperty ns1:isClinicalRecordOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ns1:GaitData a owl:Class ;
    rdfs:comment "Gait assessment and impact of a cognitive activity on gait performance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty ns1:stoppingDisplacement ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:walkingSpeedInstantaneous ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:dynamicBalance ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:walkingSpeed ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:stepLength ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty ns1:stoppingDisplacement ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:walkingSpeed ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:stepLength ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:walkingSpeedInstantaneous ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:dynamicBalance ],
        ns1:MeasuredData .

ns1:StressData a owl:Class ;
    rdfs:comment "Explore stress level"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:stressLevel ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:stressLevel ],
        ns1:MeasuredData .

ns1:Task a owl:Class ;
    rdfs:comment "",
        "Each Task involves the collection of one or more measurements (MeasuredData instances)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:measuredData ;
            owl:someValuesFrom ns1:MeasuredData ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasBeginning ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns1:measuredData ;
            owl:someValuesFrom ns1:MeasuredData ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasBeginning ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass time:Instant ;
            owl:onProperty time:hasEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ns1:measuredData a owl:ObjectProperty ;
    rdfs:domain ns1:Task ;
    rdfs:range ns1:MeasuredData ;
    rdfs:seeAlso ns1:MeasuredData,
        ns1:Task,
        "Associates a Task with a MeasuredData instance"@en .

ns1:VoiceData a owl:Class ;
    rdfs:comment "- Vocal biomarkers extraction for cognitive load assessment\\n- Assessment of mutual influence of cognitive activities an motor activities\\n- Assessment of the verbal reaction time and the impact of cognitive load imposed by the sentence recall task on speech fluency\\n- Assessment of the level of the participants’ control over the neuromuscular mechanism of speech production"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:articulation ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:speechFluency ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:pauseRate ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:pauseRate ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:verbalReactionTime ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:vowelDuration ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:speechRate ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:vowelDuration ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:speechFluency ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:articulation ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:speechRate ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ns1:verbalReactionTime ],
        ns1:MeasuredData .

dcterms: dcterms:modified "2012-06-14"^^xsd:date ;
    dcterms:publisher <http://purl.org/dc/aboutdcmi#DCMI> ;
    dcterms:title "DCMI Metadata Terms - other"@en .

