@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://purl.org/ontology/bibo/> .
@prefix onto: <https://glaciation-project.eu/MetadataReferenceModel> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:contributor a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:issued a owl:AnnotationProperty .

dcterms:abstract a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

ns1:status a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

vann:prefferedNamespacePrefix a owl:AnnotationProperty .

<https://glaciation-project.eu/MetadataReferenceModel#EnergyPowerGenerationResource> a owl:Class ;
    rdfs:label "Energy Power Generation Resource" ;
    rdfs:comment "It represents an energy resource that generates power" ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#EnergyResource> .

<https://glaciation-project.eu/MetadataReferenceModel#HardConstraint> a owl:Class ;
    rdfs:label "HardConstraint" ;
    rdfs:comment "For representing the HardConstraints of a Task." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Constraint> .

<https://glaciation-project.eu/MetadataReferenceModel#NonWorkProducingResource> a owl:Class ;
    rdfs:label "NonWorkProducingResource" ;
    rdfs:comment "It represents any NonWorkProducingResource (e.g., dataset)." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Resource> .

<https://glaciation-project.eu/MetadataReferenceModel#assigns> a owl:ObjectProperty ;
    rdfs:label "assigns" ;
    rdfs:comment "A relationship between a Scheduler and an AssignedTask." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Scheduler> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#AssignedTask> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#composedBy> a owl:ObjectProperty ;
    rdfs:label "composedBy" ;
    rdfs:comment "For keeping information about the SoftConstraints that are included in a Composition." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#SoftConstraintComposition> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#SoftConstraint> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#consumes> a owl:ObjectProperty ;
    rdfs:label "consumes" ;
    rdfs:comment "A property for recording the Resource(s) of each AssignedTask." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#AssignedTask> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Resource> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#consumesEnergyFrom> a owl:ObjectProperty ;
    rdfs:label "consumesEnergyFrom" ;
    rdfs:comment "The grid where a work producing resource consumes energy from" ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#WorkProducingResource> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#ElectricalGrid> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#endTime> a owl:DatatypeProperty ;
    rdfs:label "endTime" ;
    rdfs:comment "The end time of a Status of any Class." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Status> ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#endingInterval> a owl:DatatypeProperty ;
    rdfs:label "endingInterval" ;
    rdfs:comment "The ending interval time of an AggregatedMeasurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#AggregatedMeasurement> ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasAggregatedFuntion> a owl:DatatypeProperty ;
    rdfs:label "hasAggregatedFuntion" ;
    rdfs:comment "The AggregatedFunction of an AggregatedMeasurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#AggregatedMeasurement> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasAspect> a owl:ObjectProperty ;
    rdfs:label "hasAspect" ;
    rdfs:comment "For keeping information about the Aspect of each Constraint, e.g., time, power consumption." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Constraint> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Aspect> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasComposition> a owl:ObjectProperty ;
    rdfs:label "hasComposition" ;
    rdfs:comment "For keeping information about the Composition of the SoftConstraints of a Task." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Task> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#SoftConstraintComposition> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasConfiguration> a owl:DatatypeProperty ;
    rdfs:label "hasConfiguration" ;
    rdfs:comment "The Configuration of any instance of a Class, e.g., Task, Resource, etc." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Class> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasConstraint> a owl:ObjectProperty ;
    rdfs:label "hasConstraint" ;
    rdfs:comment "A relationship for recording all the Constraints of a Task." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Task> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Constraint> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasDescription> a owl:DatatypeProperty ;
    rdfs:label "hasDescription" ;
    rdfs:comment "The Description of any entity." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Class> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasID> a owl:DatatypeProperty ;
    rdfs:label "hasID" ;
    rdfs:comment "The ID of any entity." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Class> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasResourceMeasurement> a owl:ObjectProperty ;
    rdfs:label "hasResourceMeasurement" ;
    rdfs:comment "A relationship between a Resource and a Measurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Resource> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasStatus> a owl:ObjectProperty ;
    rdfs:label "hasStatus" ;
    rdfs:comment "A relationship between any Class and its Status." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Class> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Status> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasSubResource> a owl:ObjectProperty ;
    rdfs:label "hasSubResource" ;
    rdfs:comment "Relationships for recording the SubResource(s) of each Resource (e.g, the hardware of a node)." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Resource> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Resource> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasTaskPredictedMeasurement> a owl:ObjectProperty ;
    rdfs:label "hasTaskPredictedMeasurement" ;
    rdfs:comment "A relationship for recording the PredictedMeasurements of a Task." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Task> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:subPropertyOf <https://glaciation-project.eu/MetadataReferenceModel#hasTaskMeasurement> .

<https://glaciation-project.eu/MetadataReferenceModel#hasTaskRealizedMeasurement> a owl:ObjectProperty ;
    rdfs:label "hasTaskRealizedMeasurement" ;
    rdfs:comment "A relationship for recording the RealizedMeasurements (actual measurements) of a Task." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Task> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:subPropertyOf <https://glaciation-project.eu/MetadataReferenceModel#hasTaskMeasurement> .

<https://glaciation-project.eu/MetadataReferenceModel#hasTimestamp> a owl:DatatypeProperty ;
    rdfs:label "hasTimestamp" ;
    rdfs:comment "The date and time of a Measurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#hasValue> a owl:DatatypeProperty ;
    rdfs:label "hasValue" ;
    rdfs:comment "The Value of a Measurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#isLocatedIn> a owl:ObjectProperty ;
    rdfs:label "isLocatedIn" ;
    rdfs:comment "The location of a Work Producing Resource" ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#WorkProducingResource> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Site> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#makesMeasurement> a owl:ObjectProperty ;
    rdfs:label "makesMeasurement" ;
    rdfs:comment "A relationship between a MeasuringResource and a Measurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#MeasuringResource> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#manages> a owl:ObjectProperty ;
    rdfs:label "manages" ;
    rdfs:comment "A relationship between a Scheduler and a Resource." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Scheduler> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Resource> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#measuredIn> a owl:ObjectProperty ;
    rdfs:label "measuredIn" ;
    rdfs:comment "For recording the MeasurimentUnit of each Measurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#MeasurementUnit> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#monitors> a owl:ObjectProperty ;
    rdfs:label "monitors" ;
    rdfs:comment "For recording which Monitor tracks an AssignedTask." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Monitor> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#AssignedTask> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#produces> a owl:ObjectProperty ;
    rdfs:label "produces" ;
    rdfs:comment "For keeping information about the production Resource, e.g., the output, of an AssignedTask." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#AssignedTask> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Resource> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#relatesToConstraint> a owl:ObjectProperty ;
    rdfs:label "relatesToConstraint" ;
    rdfs:comment "For keeping information about the Constraint that each Measurement relates to." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Constraint> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#relatesToMeasurementProperty> a owl:ObjectProperty ;
    rdfs:label "relatesToMeasurementProperty" ;
    rdfs:comment "For recording the MeasurementProperty of each Measurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#MeasurementProperty> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#reschedules> a owl:ObjectProperty ;
    rdfs:label "reschedules" ;
    rdfs:comment "A relationship between a Scheduler and an AssignedTask that concerns rescheduling." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Scheduler> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#AssignedTask> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#scheduledBy> a owl:ObjectProperty ;
    rdfs:label "scheduledBy" ;
    rdfs:comment "A relationship between a SubmittedTask and a Scheduler." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#SubmittedTask> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Scheduler> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#startTime> a owl:DatatypeProperty ;
    rdfs:label "startTime" ;
    rdfs:comment "The date and time of a Status." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Status> ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#startingInterval> a owl:DatatypeProperty ;
    rdfs:label "startingInterval" ;
    rdfs:comment "The starting interval time of an AggregatedMeasurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#AggregatedMeasurement> ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#statusCode> a owl:DatatypeProperty ;
    rdfs:label "statusCode" ;
    rdfs:comment "The status code of a Status." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Status> ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#timeStepResolution> a owl:DatatypeProperty ;
    rdfs:label "timeStepResolution" ;
    rdfs:comment "The time step resolution of an AggregatedMeasurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#AggregatedMeasurement> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<https://glaciation-project.eu/MetadataReferenceModel#triggersReschedule> a owl:ObjectProperty ;
    rdfs:label "triggersReschedule" ;
    rdfs:comment "A triggered event relationship about Rescheduling from a Monitor." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Monitor> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Scheduler> ;
    rdfs:subPropertyOf owl:topObjectProperty .

onto: a owl:Ontology ;
    rdfs:label "GLACIATION Metadata Reference Model"@en ;
    dc:contributor "\"Konstantin Tatarnikov\", \"Guangyuan Piao\", \"Alessio Chellini\", \"Paolo Tartara\", \"Péter Forgács\", \" Jonas Böhler\""@en ;
    dc:creator "\"Michalis Mountantonakis\", \"Panagiotis Papadakos\", \"Rigo Wenning\""@en ;
    dc:issued "\"2024-10-30\"" ;
    dcterms:abstract "The Glaciation Reference Metadata Model (GLC-MRM) provides a conceptual model that allows making data ingestion and data processing interoperable for all the use cases of the Glaciation project. The model can be considered as a general conceptualization of a tasks scheduling problem that considers various measuring indicators over the deployed resources."@en ;
    dcterms:created "\"2024-07-20\"" ;
    dcterms:description "The GLACIATION platform develops a novel Distributed Knowledge Graph (DKG) that stretches across the edge-core-cloud architecture to reduce energy consumption, improving data processing and optimizing data movement operations. Towards this aim, the platform needs to consume the data and metadata that are fed into the DKG. The metadata can affect and inform the decision-making processes in the GLACIATION architecture and introduces the GLACIATION Metadata Reference Model that will be used for modelling the metadata in the DKG.\\n\\nThe GLACIATION Reference Metadata Model makes data ingestion and processing interoperable inside the GLACIATION platform. Linked Data allows for a high level of flexibility and to tackle the variety and merging issues that emerge in heterogenous environments, especially due to the wide range of sensors and other data sources that the platform may integrate. The GLACIATION Reference Metadata Model is tailored to fit the specific purposes of the GLACIATION platform, while the GLACIATION use cases define the scope of the model for better interoperability.\\n\\nThere are common metadata challenges for all use cases. This stems from the use of the Kubernetes orchestration system as a basis for the GLACIATION platform. In addition, common to the platform is the ingestion of data from other sources into the DKG that can then be used to affect processing decisions. There are direct data flows from sensors within the system, but also data and metadata from sources external to the system. This allows the system to react e.g. to environmental situations like weather or temperature, but also to requirements concerning security or privacy. Exemplary uses and specializations of the reference model to the GLACIATION use cases are also provided.\\n\\nThe GLACIATION Metadata Reference Model can be used for scheduling and performing tasks. The model can be considered as a general conceptualization of a tasks scheduling problem that considers various measuring indicators over the deployed resources. It captures the assignment of time-constrained tasks to time constrained and energy consuming resources, that can satisfy various hard and soft constraints, even compositions of such constraints. The tasks can be monitored through various measuring resources using a variety of single or aggregated, predicted or real measurements.\\n\\nThe model is generic, by being both domain and application independent, describing the scheduling tasks, without providing specific solutions on how they can be solved. It can be easily adjusted to each of the current three GLACIATION use cases, covering also the Kubernetes orchestration and its Telemetry System deployed by the project. The proposed model makes it feasible to answer the competency queries defined by each of the Glaciation's use case."@en ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:title "The Metadata Reference Model for the EU GLACIATION Project"@en ;
    ns1:status <http://purl.org/ontology/bibo/status/peerReviewed> ;
    vann:preferredNamespaceUri onto: ;
    vann:prefferedNamespacePrefix "glc" ;
    owl:versionIRI <https://glaciation-project.eu/MetadataReferenceModel/1.1.0/> ;
    owl:versionInfo "1.1.0" .

<https://glaciation-project.eu/MetadataReferenceModel#Aspect> a owl:Class ;
    rdfs:label "Aspect" ;
    rdfs:comment "It describes the Aspect of a Contstraint, e.g., time, power consumption." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#ElectricalGrid> a owl:Class ;
    rdfs:label "Electrical Grid" ;
    rdfs:comment "It represents an electrical grid" ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#EnergyResource> .

<https://glaciation-project.eu/MetadataReferenceModel#MeasurementProperty> a owl:Class ;
    rdfs:label "MeasurementProperty" ;
    rdfs:comment "Represents a MeasurementProperty, e.g., allocated CPU, energy, etc." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#MeasurementUnit> a owl:Class ;
    rdfs:label "MeasurementUnit" ;
    rdfs:comment "Represents a MeasurementUnit, e.g., Kwh." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#MeasuringResource> a owl:Class ;
    rdfs:label "MeasuringResource" ;
    rdfs:comment "It represents any WorkProducingResource that can perform Measurements." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class>,
        <https://glaciation-project.eu/MetadataReferenceModel#WorkProducingResource> .

<https://glaciation-project.eu/MetadataReferenceModel#Site> a owl:Class ;
    rdfs:label "Site" ;
    rdfs:comment "It represents any Site, e.g., a location, an island, etc." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#SoftConstraint> a owl:Class ;
    rdfs:label "SoftConstraint" ;
    rdfs:comment "For representing the SoftConstraints of a Task." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Constraint> .

<https://glaciation-project.eu/MetadataReferenceModel#SubmittedTask> a owl:Class ;
    rdfs:label "SubmittedTask" ;
    rdfs:comment "A Submitted Task that will be processed by a Scheduler." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Task> .

<https://glaciation-project.eu/MetadataReferenceModel#EnergyResource> a owl:Class ;
    rdfs:label "Energy Resource" ;
    rdfs:comment "It represents an energy resource" ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#WorkProducingResource> .

<https://glaciation-project.eu/MetadataReferenceModel#Monitor> a owl:Class ;
    rdfs:label "Monitor" ;
    rdfs:comment "Represents an entity that monitors an AssignedTask." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#SoftConstraintComposition> a owl:Class ;
    rdfs:label "SoftConstraintComposition" ;
    rdfs:comment "It describes the composition of SoftConstraints, e.g., the order of soft constraings according to a given preference priority, Pareto, Pareto optimal, etc." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#hasTaskMeasurement> a owl:ObjectProperty ;
    rdfs:label "hasTaskMeasurement" ;
    rdfs:comment "A relationship between a Task and a Measurement." ;
    rdfs:domain <https://glaciation-project.eu/MetadataReferenceModel#Task> ;
    rdfs:range <https://glaciation-project.eu/MetadataReferenceModel#Measurement> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://glaciation-project.eu/MetadataReferenceModel#AggregatedMeasurement> a owl:Class ;
    rdfs:label "AggregatedMeasurement" ;
    rdfs:comment "Represents any AggregatedMeasurement, by using an AggregatedFunction, a time interval and time step resolution." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Measurement> .

<https://glaciation-project.eu/MetadataReferenceModel#Status> a owl:Class ;
    rdfs:label "Status" ;
    rdfs:comment "Represents information about a specific Status over a given time interval." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#WorkProducingResource> a owl:Class ;
    rdfs:label "WorkProducingResource" ;
    rdfs:comment "It represents any WorkProducingResource, e.g., a node, a CPU, etc." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Resource> .

<https://glaciation-project.eu/MetadataReferenceModel#AssignedTask> a owl:Class ;
    rdfs:label "AssignedTask" ;
    rdfs:comment "An AssignedTask that will be performed by using some Resources and will be based on some Constraints." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Task> .

<https://glaciation-project.eu/MetadataReferenceModel#Constraint> a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "For representing the Constraint(s) of a Task." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#Scheduler> a owl:Class ;
    rdfs:label "Scheduler" ;
    rdfs:comment "Responsible for Scheduling a SubmittedTask and for managing the Resources." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#Resource> a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "It represents any Resource." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> ;
    owl:disjointWith <https://glaciation-project.eu/MetadataReferenceModel#Task> .

<https://glaciation-project.eu/MetadataReferenceModel#Task> a owl:Class ;
    rdfs:label "Task" ;
    rdfs:comment "It describes any Task that has Constraints and a Status." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#Measurement> a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "Represents any Measurement, e.g., for energy." ;
    rdfs:subClassOf <https://glaciation-project.eu/MetadataReferenceModel#Class> .

<https://glaciation-project.eu/MetadataReferenceModel#Class> a owl:Class ;
    rdfs:label "Class" ;
    rdfs:comment "A generic Class for the GLACIATION project" .

